    buf_str(out, c"    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {\n        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    #[effects(panic, diverge)]\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std2: changed: a &str, a view of the entry (Rust's: a PathBuf; MVS:\n    // a PathBuf on an allocator; path_in could make one on an allocator)\n    #[effects(panic, diverge)]\n    pub fn path(&self) -> &str {\n        self.text(0)\n    }\n\n    // Its name.\n    // std2: changed: a &str, a view of the entry, until std::ffi (Rust's:\n    // an OsString; a name that is not UTF-8 is read_dir's InvalidData)\n    #[effects(panic, diverge)]\n    pub fn file_name(&self) -> &str {\n        self.text(self.name_at)\n    }\n\n    // What lstat says of it.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        stat_at(self.path(), false)\n    }\n\n    // Its kind as the directory says it (lstat's when the file system does\n    // not say).\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n");
    buf_str(out, c"    pub fn file_type(&self) -> Result<FileType> {\n        if self.kind == DT_DIR {\n            crate::result::Result::Ok(FileType { fmt: S_IFDIR })\n        } else if self.kind == DT_REG {\n            crate::result::Result::Ok(FileType { fmt: S_IFREG })\n        } else if self.kind == DT_LNK {\n            crate::result::Result::Ok(FileType { fmt: S_IFLNK })\n        } else {\n            crate::result::Result::Ok(self.metadata()?.file_type())\n        }\n    }\n}\n// ---- end mod std::fs ----\n}\n// ---- mod std::path ----\npub mod path {\n// EDITION: rust\n// std::path (0.28.0): Path and PathBuf, Rust's names and meanings over\n// UTF-8 text ('/' between the components, as on Unix).\n//\n// A named divergence from Rust: Rust's `Path` is an unsized newtype over\n// OsStr, reached as `&Path`; the rust edition has no unsized newtypes\n// yet (rust-surface-plan.md, later: \"an unsized newtype\"), so `Path<'a>`\n// is a sized, copyable view of a `&'a str`, written `Path<'_>` (or `Path`\n// with its lifetime elided) where Rust writes `&Path`, and a component is\n// a `&str` where Rust's is an `&OsStr`. `PathBuf<A>` owns its text in a\n// String<A>; it derefs to str, so `fs::metadata(&p)` takes it, and it has\n// Path's methods itself. A path taken as an argument is `P: AsRef<str>`\n// (Rust's `AsRef<Path>`): a &str, a String, a Path or a PathBuf. When the\n// front has unsized newtypes, `Path<'a>` becomes `&'a Path`.\n// mvs: std::path\n\nuse crate::alloc::Allocator;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::{DoubleEndedIterator, Iterator};\nuse crate::ops::Deref;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\n\n// ---- Components ----\n\n// One component of a path: the root, a leading \".\", \"..\", or a name.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Component<'a> {\n    RootDir,\n    CurDir,\n    ParentDir,\n    Normal(&'a str),\n");
    buf_str(out, c"}\n\nimpl<'a> Component<'a> {\n    // Its text: \"/\", \".\", \"..\" or the name.\n    // std2: changed: a &str (Rust: as_os_str, an &OsStr)\n    #[effects()]\n    pub fn as_str(self) -> &'a str {\n        match self {\n            Component::RootDir => \"/\",\n            Component::CurDir => \".\",\n            Component::ParentDir => \"..\",\n            Component::Normal(s) => s,\n        }\n    }\n}\n\nimpl<'a> AsRef<str> for Component<'a> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\n// The length of s's prefix component: 1 for the root ('/') or for a\n// leading \".\" (\".\", \"./...\"), else 0.\nfn prefix_len(s: &str) -> usize {\n    let b = s.as_bytes();\n    if b.len() > 0 && b[0] == b'/' {\n        return 1;\n    }\n    if b.len() > 0 && b[0] == b'.' && (b.len() == 1 || b[1] == b'/') {\n        return 1;\n    }\n    0\n}\n\n// `p.components()`: the root or a leading \".\" first, then the names and\n// \"..\"s; empty components and \".\" past the first are left out, as Rust's.\n// Both ends: `next_back` gives the last component.\n#[derive(Clone, Copy)]\npub struct Components<'a> {\n    s: &'a str,\n    // the prefix component (RootDir or CurDir) not yet given\n    pre: bool,\n    // the body not yet given: s[front..back]\n    front: usize,\n    back: usize,\n}\n\nimpl<'a> Components<'a> {\n    fn of(s: &'a str) -> Components<'a> {\n        let n = prefix_len(s);\n        Components { s: s, pre: n > 0, front: n, back: s.len() }\n    }\n\n    fn prefix(&self) -> Component<'a> {\n        if self.s.as_bytes()[0] == b'/' { Component::RootDir } else { Component::CurDir }\n    }\n\n    fn body(c: &'a str) -> Option<Component<'a>> {\n        if c.len() == 0 || c == \".\" {\n            Option::None\n        } else if c == \"..\" {\n            Option::Some(Component::ParentDir)\n        } else {\n            Option::Some(Component::Normal(c))\n        }\n    }\n\n    // What is left, as a path: \"\" when nothing is.\n");
    buf_str(out, c"    #[effects(panic, diverge)]\n    pub fn as_path(&self) -> Path<'a> {\n        let b = self.s.as_bytes();\n        let mut lo = self.front;\n        let mut hi = self.back;\n        // trailing '/'s and \".\" components\n        loop {\n            if hi > lo && b[hi - 1] == b'/' {\n                hi -= 1;\n            } else if hi > lo && b[hi - 1] == b'.' && (hi - 1 == lo || b[hi - 2] == b'/') {\n                hi -= 1;\n            } else {\n                break;\n            }\n        }\n        if self.pre {\n            let n = prefix_len(self.s);\n            return Path { s: &self.s[0..if hi > n { hi } else { n }] };\n        }\n        // leading '/'s and \".\" components\n        loop {\n            if lo < hi && b[lo] == b'/' {\n                lo += 1;\n            } else if lo < hi && b[lo] == b'.' && (lo + 1 == hi || b[lo + 1] == b'/') {\n                lo += 1;\n            } else {\n                break;\n            }\n        }\n        Path { s: &self.s[lo..hi] }\n    }\n}\n\nimpl<'a> Iterator for Components<'a> {\n    type Item = Component<'a>;\n\n    fn next(&mut self) -> Option<Component<'a>> {\n        if self.pre {\n            self.pre = false;\n            return Option::Some(self.prefix());\n        }\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n            let start = self.front;\n            let mut end = start;\n            while end < self.back && b[end] != b'/' {\n                end += 1;\n            }\n            self.front = if end < self.back { end + 1 } else { end };\n            match Components::body(&self.s[start..end]) {\n                Option::Some(c) => return Option::Some(c),\n                Option::None => {}\n            }\n        }\n        Option::None\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Components<'a> {\n    fn next_back(&mut self) -> Option<Component<'a>> {\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n");
    buf_str(out, c"            let end = self.back;\n            let mut start = end;\n            while start > self.front && b[start - 1] != b'/' {\n                start -= 1;\n            }\n            self.back = if start > self.front { start - 1 } else { start };\n            match Components::body(&self.s[start..end]) {\n                Option::Some(c) => return Option::Some(c),\n                Option::None => {}\n            }\n        }\n        if self.pre {\n            self.pre = false;\n            return Option::Some(self.prefix());\n        }\n        Option::None\n    }\n}\n\n// `p.iter()`: the components' texts.\n#[derive(Clone, Copy)]\npub struct Iter<'a> {\n    inner: Components<'a>,\n}\n\nimpl<'a> Iter<'a> {\n    // What is left, as a path.\n    #[effects(panic, diverge)]\n    pub fn as_path(&self) -> Path<'a> {\n        self.inner.as_path()\n    }\n}\n\nimpl<'a> Iterator for Iter<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.inner.next() {\n            Option::Some(c) => Option::Some(c.as_str()),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Iter<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        match self.inner.next_back() {\n            Option::Some(c) => Option::Some(c.as_str()),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// `p.ancestors()`: p, its parent, the parent's parent, ...\n#[derive(Clone, Copy)]\npub struct Ancestors<'a> {\n    next: Option<Path<'a>>,\n}\n\nimpl<'a> Iterator for Ancestors<'a> {\n    type Item = Path<'a>;\n\n    fn next(&mut self) -> Option<Path<'a>> {\n        let cur = self.next;\n        match cur {\n            Option::Some(p) => self.next = p.parent(),\n            Option::None => {}\n        }\n        cur\n    }\n}\n\n// ---- Path ----\n\n// A path: a view of its text.\n// std2: changed: a sized view `Path<'a>`, Rust's `&'a Path` (no unsized\n// newtypes yet); MVS: a distinct [u8]\n");
    buf_str(out, c"#[derive(Clone, Copy)]\npub struct Path<'a> {\n    s: &'a str,\n}\n\n// What `strip_prefix` fails with: the base is not a prefix.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct StripPrefixError {}\n\nimpl Display for StripPrefixError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"prefix not found\")\n    }\n}\n\n// The byte range of the file name in s (its last Normal component): it\n// ends where the trailing '/'s and \".\" components start.\nfn file_name_range(s: &str) -> Option<(usize, usize)> {\n    let n = match Path::new(s).file_name() {\n        Option::Some(n) => n.len(),\n        Option::None => return Option::None,\n    };\n    let b = s.as_bytes();\n    let mut hi = b.len();\n    loop {\n        if hi > 0 && b[hi - 1] == b'/' {\n            hi -= 1;\n        } else if hi > 0 && b[hi - 1] == b'.' && (hi == 1 || b[hi - 2] == b'/') {\n            hi -= 1;\n        } else {\n            break;\n        }\n    }\n    Option::Some((hi - n, hi))\n}\n\n// A file name split at its last '.': (stem, extension); \"..\" and a name\n// whose only '.' leads (\".bashrc\") have no extension.\nfn split_dot(name: &str) -> (&str, Option<&str>) {\n    if name == \"..\" {\n        return (name, Option::None);\n    }\n    match name.rfind('.') {\n        Option::Some(0) => (name, Option::None),\n        Option::Some(k) => (&name[0..k], Option::Some(&name[k + 1..])),\n        Option::None => (name, Option::None),\n    }\n}\n\nimpl<'a> Path<'a> {\n    // The path of the text s: `Path::new(\"a/b.txt\")`.\n    // std2: changed: a Path<'a> of a &'a str (Rust: &Path of an AsRef<OsStr>)\n    #[effects()]\n    pub fn new(s: &'a str) -> Path<'a> {\n        Path { s: s }\n    }\n\n    // Its text.\n    // std2: changed: Rust's as_os_str, a &str\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.s\n    }\n\n    // Its text: always Some, a path being UTF-8 here.\n    #[effects()]\n");
