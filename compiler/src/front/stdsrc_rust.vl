    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: changes the environment (C's setenv), which another thread's\n// getenv may be reading.\n// SAFETY: (the caller's) no other thread reads or writes the environment\n// meanwhile, and no value read from it before (a getenv view) is used\n// after.\n// std2: changed: key and value are &str\npub unsafe fn set_var(key: &str, value: &str) {\n    let mut nb = [0u8; 1024];\n    let mut vb = [0u8; 65536];\n    if !c_string(key, &mut nb[..], true) || !c_string(value, &mut vb[..], false) {\n        crate::panic::panic(\"env::set_var: a key or value that C's environment cannot hold\");\n    }\n    // UNSAFE: C's setenv. SAFETY: two NUL-ended strings; the caller's\n    // promise above.\n    let _ = unsafe { env_c_setenv(&nb[0] as *const u8, &vb[0] as *const u8, 1) };\n}\n\n// Removes variable key (Rust 2024's `unsafe fn`).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: as set_var: C's unsetenv.\n// SAFETY: (the caller's) as set_var.\n// std2: changed: the key is a &str\npub unsafe fn remove_var(key: &str) {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        crate::panic::panic(\"env::remove_var: a key that C's environment cannot hold\");\n    }\n    // UNSAFE: C's unsetenv. SAFETY: a NUL-ended string; the caller's\n    // promise above.\n    let _ = unsafe { env_c_unsetenv(&nb[0] as *const u8) };\n}\n\n// Every variable, (name, value), each copied into a String on allocator a\n// as the iterator reaches it (Rust's env::vars). A name or value that is\n// not UTF-8 stops the program, as Rust's; an entry without `=` is left\n// out.\n// std2: changed: takes an allocator\n#[effects()]\npub fn vars_in<A: Allocator + Clone>(a: A) -> Vars<A> {\n    Vars { at: 0, a: a }\n}\n\n");
    buf_str(out, c"// env::vars_in's iterator: environ's entries from index at. set_var and\n// remove_var, which change environ, are unsafe: their callers promise no\n// iterator meanwhile.\npub struct Vars<A: Allocator> {\n    at: usize,\n    a: A,\n}\n\nimpl<A: Allocator + Clone> Iterator for Vars<A> {\n    type Item = (String<A>, String<A>);\n\n    fn next(&mut self) -> Option<(String<A>, String<A>)> {\n        loop {\n            let kv = match env_entry(self.at) {\n                Option::Some(kv) => kv,\n                Option::None => return Option::None,\n            };\n            self.at += 1;\n            // (from index 1: a name may start with `=`, as Rust's parse)\n            let mut eq: usize = 1;\n            while eq < kv.len() && kv[eq] != 61 {\n                eq += 1;\n            }\n            if eq >= kv.len() {\n                continue;\n            }\n            let (k, v) = match (crate::str::from_utf8(&kv[..eq]),\n                crate::str::from_utf8(&kv[eq + 1..])) {\n                (Result::Ok(k), Result::Ok(v)) => (k, v),\n                _ => crate::panic::panic(\"env::vars_in: a variable is not valid unicode\"),\n            };\n            return Option::Some((String::from_in(k, self.a.clone()),\n                String::from_in(v, self.a.clone())));\n        }\n    }\n}\n\n// The i-th entry of C's environment, `NAME=value`, as its bytes; None\n// past the last.\nfn env_entry(i: usize) -> Option<&'static [u8]> {\n    let env = crate::__sys::environ();\n    // UNSAFE: reads environ[0..=i] and the NUL-ended C string at i.\n    // SAFETY: environ is a null-ended array of NUL-ended strings; the\n    // entries before i were read non-null (the loop stops at the null),\n    // and nothing changes it meanwhile (set_var and remove_var are unsafe:\n    // their callers' promise).\n    unsafe {\n        let mut k: usize = 0;\n        while k < i {\n            if (*env.add(k)).is_null() {\n                return Option::None;\n            }\n");
    buf_str(out, c"            k += 1;\n        }\n        let p = *env.add(i);\n        if p.is_null() {\n            return Option::None;\n        }\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The current working directory, copied into a new String on allocator a\n// (Rust's env::current_dir). Up to 4 KB.\n// std2: changed: a String<A> on an allocator (Rust: a PathBuf)\n// mvs: current_dir_in\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, A)]\npub fn current_dir_in<A: Allocator>(a: A) -> crate::io::Result<String<A>> {\n    let mut buf = [0u8; 4096];\n    // UNSAFE: C's getcwd into buf. SAFETY: buf holds 4096 bytes, the size\n    // given; getcwd writes a NUL-ended path within them or fails (null).\n    let p = unsafe { env_c_getcwd(&mut buf[0] as *mut u8, 4096) };\n    if p.is_null() {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    let mut n: usize = 0;\n    while n < buf.len() && buf[n] != 0 {\n        n += 1;\n    }\n    match crate::str::from_utf8(&buf[..n]) {\n        Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n        Result::Err(_) => Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidData,\n            \"the current directory is not UTF-8\")),\n    }\n}\n\n// Makes path the working directory (Rust's env::set_current_dir).\n// std2: changed: the path is a &str (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn set_current_dir(path: &str) -> crate::io::Result<()> {\n    let mut pb = [0u8; 4096];\n    if !c_string(path, &mut pb[..], false) {\n        return Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidInput,\n            \"a path that C cannot hold\"));\n    }\n    // UNSAFE: C's chdir. SAFETY: pb holds a NUL-ended path.\n    if unsafe { env_c_chdir(&pb[0] as *const u8) } != 0 {\n");
    buf_str(out, c"        return Result::Err(crate::io::Error::last_os_error());\n    }\n    Result::Ok(())\n}\n// ---- end mod std::env ----\n}\n// ---- mod std::thread ----\npub mod thread {\n// EDITION: rust\n// std::thread: scoped threads, spawned threads, and the thread's own\n// queries. `thread::scope` is the safe way to share a borrow with\n// threads: every thread spawned in the scope is joined before it returns,\n// so they may borrow what outlives the scope ('env). It takes no\n// allocator: its threads' records come from C's heap, as Rust's from the\n// global one. `spawn_in(f, a)` runs a 'static closure on a thread\n// of its own, its closure and result kept on a (plan §2: MVS's spawn\n// allocated through C, unnamed). A panic in any thread ends the process\n// with 101 (decision 18), so `join` never returns an Err; it returns a\n// Result anyway, so that `.join().unwrap()` reads as in Rust.\n\nuse crate::alloc::{AllocError, Allocator, Layout};\nuse crate::cell::Cell;\nuse crate::fmt::{Debug, Formatter};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::ptr::NonNull;\n\n// UNSAFE: C's heap and POSIX threads, which take raw pointers.\n// SAFETY: the prototypes are stdlib.h's, pthread.h's, sched.h's and\n// unistd.h's (pthread_t as u64, as on macOS and Linux), as MVS's thread.\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn thread_c_malloc(n: usize) -> *mut u8;\n    #[link_name = \"free\"]\n    fn thread_c_free(p: *mut u8);\n    #[link_name = \"pthread_create\"]\n    fn thread_c_create(t: *mut u64, attr: *const u8, f: extern \"C\" fn(*mut u8) -> *mut u8,\n        arg: *mut u8) -> i32;\n    #[link_name = \"pthread_join\"]\n    fn thread_c_join(t: u64, ret: *mut u64) -> i32;\n    #[link_name = \"pthread_detach\"]\n    fn thread_c_detach(t: u64) -> i32;\n    #[link_name = \"pthread_attr_init\"]\n    fn thread_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"pthread_attr_setstacksize\"]\n");
    buf_str(out, c"    fn thread_c_attr_setstacksize(a: *mut u8, size: usize) -> i32;\n    #[link_name = \"pthread_attr_destroy\"]\n    fn thread_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"sched_yield\"]\n    fn thread_c_yield() -> i32;\n    #[link_name = \"sysconf\"]\n    fn thread_c_sysconf(name: i32) -> i64;\n}\n\n// Built in: the compiler lowers a std function named atomic_* to the\n// instruction, as MVS's std::sync::atomic (order: 1 Acquire, 2 Release,\n// 3 AcqRel); the bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid, aligned, shared only through\n// atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\nconst ACQUIRE: i64 = 1;\nconst RELEASE: i64 = 2;\nconst ACQ_REL: i64 = 3;\n\n// _SC_NPROCESSORS_ONLN (macOS's number; 84 on Linux).\nconst SC_NPROCESSORS_ONLN: i32 = 58;\n\n// The stack of a new thread: 8 MiB (macOS's default past the first\n// thread is 512 KiB), as MVS's.\nconst THREAD_STACK: usize = 8388608;\n\n// C's heap, for a scope's records: a scope takes no allocator (Rust's\n// takes its records from the global heap the same way).\n#[derive(Clone, Copy)]\nstruct CHeap {\n    sealed: (),\n}\n\n// UNSAFE: an Allocator impl over C's heap.\n// SAFETY: blocks come from malloc (16-aligned: enough for the records of\n// words, an Option and a closure it holds) and go back to free.\nunsafe impl Allocator for CHeap {\n    fn allocate(&self, layout: Layout) -> crate::result::Result<NonNull<u8>, AllocError> {\n        if layout.align() > 16 {\n            return crate::result::Result::Err(AllocError {});\n        }\n");
    buf_str(out, c"        // UNSAFE: C's malloc.\n        // SAFETY: it takes a size and returns a block or null.\n        let p = unsafe { thread_c_malloc(layout.size()) };\n        match NonNull::new(p) {\n            Option::Some(q) => crate::result::Result::Ok(q),\n            Option::None => crate::result::Result::Err(AllocError {}),\n        }\n    }\n\n    // UNSAFE: gives a block back to C's free.\n    // SAFETY: a contract on the caller (Allocator's): p is a block this\n    // allocator gave, so malloc's.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        thread_c_free(p.as_ptr());\n    }\n}\n\n// What a thread shares with its handle: its result once done (done is\n// 1 then), and refs, the thread's and the handle's: the last of the two\n// frees it into alloc.\nstruct Out<T, A: Allocator> {\n    result: Option<T>,\n    done: u32,\n    refs: u32,\n    alloc: A,\n}\n\n// The closure, moved to the thread, and where its result goes.\nstruct Packet<F, T, A: Allocator> {\n    f: F,\n    out: *mut Out<T, A>,\n}\n\n// What the thread starts from (C's heap): run(data, this record).\nstruct Start {\n    run: fn(*mut u8, *mut u8),\n    data: *mut u8,\n}\n\n// The thread's first frame (C's convention, what pthread_create takes).\nextern \"C\" fn thread_start(arg: *mut u8) -> *mut u8 {\n    // UNSAFE: the start record through its raw pointer.\n    // SAFETY: arg is the Start start_thread wrote for this thread only;\n    // it is read here and freed by run.\n    unsafe {\n        let s = arg as *mut Start;\n        let run = (*s).run;\n        let data = (*s).data;\n        run(data, arg);\n    }\n    crate::ptr::null_mut::<u8>()\n}\n\n// A record of T's layout from a; out of memory panics.\nfn new_record<T, A: Allocator>(a: &A, x: T) -> *mut T {\n    let p = match a.allocate(Layout::new::<T>()) {\n        crate::result::Result::Ok(p) => p.as_ptr() as *mut T,\n        crate::result::Result::Err(_) => {\n            let msg: &str = \"memory allocation failed\";\n");
    buf_str(out, c"            crate::panic::panic(msg)\n        }\n    };\n    // UNSAFE: x moved into the fresh block.\n    // SAFETY: p is a block of T's layout from a; the write drops nothing.\n    unsafe { crate::ptr::write(p, x) };\n    p\n}\n\n// Gives a record of T's layout back to a (its value moved out already).\n// UNSAFE: deallocates through the allocator.\n// SAFETY: a contract on the caller: p is new_record's block from a.\nunsafe fn free_record<T, A: Allocator>(a: &A, p: *mut T) {\n    match NonNull::new(p as *mut u8) {\n        Option::Some(q) => a.deallocate(q, Layout::new::<T>()),\n        Option::None => {}\n    }\n}\n\n// Drops the result (if any) and frees out into its own allocator.\n// UNSAFE: moves the record out through its raw pointer.\n// SAFETY: a contract on the caller: out is live and nobody uses it after.\nunsafe fn release_out<T, A: Allocator>(out: *mut Out<T, A>) {\n    let o = crate::ptr::read(out as *const Out<T, A>);\n    free_record(&o.alloc, out);\n    crate::mem::drop(o);\n}\n\n// The thread's work: the packet taken and freed, the closure called, its\n// result published, the thread's ref given up.\nfn thread_run<F: FnOnce() -> T, T, A: Allocator>(data: *mut u8, start: *mut u8) {\n    // UNSAFE: the packet, the start record and the result's place through\n    // raw pointers.\n    // SAFETY: data is the Packet start_thread wrote for this thread only:\n    // moved out and freed once; start is freed once into C's heap; out is\n    // live while refs > 0, and this thread holds one ref until its\n    // atomic_sub (AcqRel: the handle's side is ordered before the free).\n    unsafe {\n        let q = data as *mut Packet<F, T, A>;\n        let p = crate::ptr::read(q as *const Packet<F, T, A>);\n        let out = p.out;\n        free_record(&*(&(*out).alloc), q);\n        thread_c_free(start);\n        let r = (p.f)();\n        (*out).result = Option::Some(r);\n        atomic_store(&mut (*out).done as *mut u32, 1, RELEASE);\n");
    buf_str(out, c"        if atomic_sub(&mut (*out).refs as *mut u32, 1, ACQ_REL) == 1 {\n            release_out(out);\n        }\n    }\n}\n\n// Starts a thread running f, its records on a: its pthread_t and its\n// result's place.\nfn start_thread<F: FnOnce() -> T, T, A: Allocator>(f: F, a: A) -> (u64, *mut Out<T, A>) {\n    let out = new_record(&a, Out::<T, A> { result: Option::<T>::None, done: 0, refs: 2, alloc: a });\n    // UNSAFE: the records reached through raw pointers, and pthread_create.\n    // SAFETY: out is live (refs 2); the Packet and the Start go to the new\n    // thread only; attr is 128 bytes, more than a pthread_attr_t.\n    unsafe {\n        let q = new_record(&*(&(*out).alloc), Packet { f: f, out: out });\n        let s = thread_c_malloc(Layout::new::<Start>().size()) as *mut Start;\n        if s.is_null() {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg);\n        }\n        crate::ptr::write(s, Start { run: thread_run::<F, T, A>, data: q as *mut u8 });\n        let mut attr: [u64; 16] = [0; 16];\n        let ap = &mut attr[0] as *mut u64 as *mut u8;\n        thread_c_attr_init(ap);\n        thread_c_attr_setstacksize(ap, THREAD_STACK);\n        let mut t: u64 = 0;\n        let rc = thread_c_create(&mut t as *mut u64, ap as *const u8, thread_start, s as *mut u8);\n        thread_c_attr_destroy(ap);\n        if rc != 0 {\n            let msg: &str = \"failed to spawn thread\";\n            crate::panic::panic(msg);\n        }\n        (t, out)\n    }\n}\n\n// Waits for thread t and takes its result, freeing its place.\n// UNSAFE: pthread_join and the result's place through its raw pointer.\n// SAFETY: a contract on the caller: t is out's thread, not joined or\n// detached yet, and out is not used after.\nunsafe fn join_thread<T, A: Allocator>(t: u64, out: *mut Out<T, A>) -> T {\n    thread_c_join(t, crate::ptr::null_mut::<u64>());\n    let r = crate::mem::replace(&mut *(&mut (*out).result), Option::None);\n");
    buf_str(out, c"    release_out(out);\n    match r {\n        Option::Some(x) => x,\n        Option::None => crate::panic::unreachable(),\n    }\n}\n\n// Whether out's thread has published its result.\n// UNSAFE: an atomic read through the raw pointer.\n// SAFETY: a contract on the caller: out is live.\nunsafe fn finished<T, A: Allocator>(out: *mut Out<T, A>) -> bool {\n    atomic_load(&(*out).done as *const u32, ACQUIRE) == 1\n}\n\n// A thread of a scope, in its list: joined when the scope ends unless its\n// handle joined it.\nstruct ScopeNode {\n    native: u64,\n    joined: bool,\n    out: *mut u8,\n    join: fn(u64, *mut u8),\n    next: *mut ScopeNode,\n}\n\n// A scope node's join, erased: the thread joined and its result dropped.\n// Private, and called only by scope's end with its own node's pair.\nfn scope_join<T>(t: u64, out: *mut u8) {\n    // UNSAFE: the result's place through an erased pointer.\n    // SAFETY: the pair is one node's: out is the Out<T, CHeap> of thread\n    // t, not joined yet (the node is not marked joined).\n    crate::mem::drop(unsafe { join_thread(t, out as *mut Out<T, CHeap>) });\n}\n\n// join's result: never an Err in vole (a panic exits the process).\npub type Result<T> = crate::result::Result<T, JoinError>;\n\n// A thread's panic, as join would report it: no value is ever made.\npub struct JoinError {\n    never: crate::convert::Infallible,\n}\n\nimpl Debug for JoinError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.never {}\n    }\n}\n\n// Runs f with a Scope, joins every thread spawned in it, and returns f's\n// value. Each region in f's argument is elided, so it is late-bound (no\n// `for<'a>`, cut to 0.29): the scope's region 'scope cannot be named\n// outside f, and Scope is invariant in it, so a thread cannot borrow a\n// local of f's body (plan §4, threads).\n// std2: changed: FnOnce(&Scope<'_, 'env>) (MVS: FnMut(inout Scope))\n#[effects(alloc(CHeap), diverge, unsafe, F)]\n");
    buf_str(out, c"pub fn scope<'env, F, T>(f: F) -> T\n    where\n        F: FnOnce(&Scope<'_, 'env>) -> T,\n{\n    let s = Scope {\n        first: Cell::new(crate::ptr::null_mut::<ScopeNode>()),\n        scope: PhantomData {},\n        env: PhantomData {},\n    };\n    let r = f(&s);\n    // UNSAFE: walks the scope's list through raw pointers.\n    // SAFETY: every node is one Scope::spawn made for s and freed here\n    // only, once; a node its handle joined is skipped.\n    unsafe {\n        let mut n = s.first.get();\n        while !n.is_null() {\n            let next = (*n).next;\n            if !(*n).joined {\n                ((*n).join)((*n).native, (*n).out);\n            }\n            free_record(&CHeap { sealed: () }, n);\n            n = next;\n        }\n    }\n    r\n}\n\n// The scope threads are spawned in. 'scope is the scope's own region\n// ('env outlives it); invariant in both, as Rust's.\n// std2: changed: two regions, invariant\npub struct Scope<'scope, 'env: 'scope> {\n    first: Cell<*mut ScopeNode>,\n    scope: PhantomData<&'scope mut &'scope ()>,\n    env: PhantomData<&'env mut &'env ()>,\n}\n\nimpl<'scope, 'env> Scope<'scope, 'env> {\n    // Runs f on a new thread, joined at the latest when the scope ends;\n    // f may borrow anything that outlives 'scope. `&self`, not Rust's\n    // `&'scope self`: scope's argument elides its two regions separately,\n    // so the reference may be shorter than 'scope; the bound F: 'scope,\n    // with Scope invariant in 'scope, is what keeps f's borrows alive.\n    // std2: changed: &self, FnOnce, Send, a 'scope bound (MVS: inout self, FnMut)\n    // later: auto_trait\n    #[effects(alloc(CHeap), io, panic, diverge, F, T)]\n    pub fn spawn<F, T>(&self, f: F) -> ScopedJoinHandle<'scope, T>\n        where\n            F: FnOnce() -> T + Send + 'scope,\n            T: Send + 'scope,\n    {\n        let (t, out) = start_thread(f, CHeap { sealed: () });\n        let node = new_record(&CHeap { sealed: () }, ScopeNode {\n");
    buf_str(out, c"            native: t,\n            joined: false,\n            out: out as *mut u8,\n            join: scope_join::<T>,\n            next: self.first.get(),\n        });\n        self.first.set(node);\n        ScopedJoinHandle { native: t, out: out, node: node, scope: PhantomData {} }\n    }\n}\n\n// A scoped thread: join waits for its value.\n// std2: changed: a region 'scope\npub struct ScopedJoinHandle<'scope, T> {\n    native: u64,\n    out: *mut Out<T, CHeap>,\n    node: *mut ScopeNode,\n    scope: PhantomData<&'scope ()>,\n}\n\n// UNSAFE: the handle reaches its result and its scope node through raw\n// pointers: stated, as Rust's (Send and Sync for every T).\n// SAFETY: as JoinHandle's; Scope::spawn asks T: Send, and the scope's node\n// is written only by join, which takes the handle.\nunsafe impl<'scope, T> Send for ScopedJoinHandle<'scope, T> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&ScopedJoinHandle` only reads the done flag, atomically.\nunsafe impl<'scope, T> Sync for ScopedJoinHandle<'scope, T> {}\n\nimpl<'scope, T> ScopedJoinHandle<'scope, T> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(unsafe, T)]\n    pub fn join(self) -> Result<T> {\n        // UNSAFE: the scope's node and the thread's result through raw\n        // pointers.\n        // SAFETY: the node lives until the scope ends, which 'scope\n        // outlives; marked joined, the scope's end skips the thread, so it\n        // is joined once.\n        unsafe {\n            (*self.node).joined = true;\n            crate::result::Result::Ok(join_thread(self.native, self.out))\n        }\n    }\n\n    // Whether the thread has finished (join would not wait).\n    #[effects(unsafe, T)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: out lives until the thread is joined, by this handle's\n");
    buf_str(out, c"        // join (which takes it) or the scope's end ('scope outlives self).\n        unsafe { finished(self.out) }\n    }\n}\n\n// Runs f on a new thread of its own; its closure and its result live on\n// a until join (or the handle's drop, which detaches it).\n// mvs: spawn\n// std2: changed: an allocator, FnOnce, Send and 'static (MVS: spawn(f), through C)\n// later: auto_trait\n#[effects(F, T, A)]\npub fn spawn_in<F, T, A>(f: F, a: A) -> JoinHandle<T, A>\n    where\n        F: FnOnce() -> T + Send + 'static,\n        T: Send + 'static,\n        A: Allocator + Send + 'static,\n{\n    let (t, out) = start_thread(f, a);\n    JoinHandle { native: t, out: out }\n}\n\n// A spawned thread.\n// std2: changed: an allocator parameter\npub struct JoinHandle<T, A: Allocator> {\n    native: u64,\n    out: *mut Out<T, A>,\n}\n\n// UNSAFE: the handle reaches the thread's result through a raw pointer:\n// stated, as Rust's (Send and Sync for every T).\n// SAFETY: the result's place is shared with the thread by its refs count,\n// atomically (AcqRel), and read only by join, which takes the handle;\n// spawn_in asks T: Send and A: Send.\nunsafe impl<T, A: Allocator> Send for JoinHandle<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&JoinHandle` only reads the done flag, atomically (is_finished).\nunsafe impl<T, A: Allocator> Sync for JoinHandle<T, A> {}\n\nimpl<T, A: Allocator> JoinHandle<T, A> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(alloc(A, extern), unsafe, T, A)]\n    pub fn join(self) -> Result<T> {\n        let t = self.native;\n        let out = self.out;\n        crate::mem::forget(self);\n        // UNSAFE: pthread_join and the result's place.\n        // SAFETY: the handle held a ref, so out is live; it is forgotten, so\n        // its drop does not detach or free; the thread is joined once.\n        crate::result::Result::Ok(unsafe { join_thread(t, out) })\n    }\n\n");
    buf_str(out, c"    #[effects(unsafe, T, A)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: the handle holds a ref, so out is live.\n        unsafe { finished(self.out) }\n    }\n}\n\n// Detaches the thread: it runs on, its result dropped when it ends.\nimpl<T, A: Allocator> crate::ops::Drop for JoinHandle<T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: pthread_detach and the result's place.\n        // SAFETY: out is live (the handle's ref); the last of the thread and\n        // the handle (refs, AcqRel) frees it, once.\n        unsafe {\n            thread_c_detach(self.native);\n            if atomic_sub(&mut (*self.out).refs as *mut u32, 1, ACQ_REL) == 1 {\n                release_out(self.out);\n            }\n        }\n    }\n}\n\n// Lets the OS run another thread.\n#[effects(sync, unsafe)]\npub fn yield_now() {\n    // UNSAFE: C's sched_yield.\n    // SAFETY: it takes nothing.\n    unsafe { thread_c_yield() };\n}\n\n// How many threads can run at once (the CPUs online); 1 when unknown.\n// (Rust's returns io::Result<NonZero<usize>>; vole's, a usize.)\n// std2: changed: usize\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn available_parallelism() -> usize {\n    // UNSAFE: C's sysconf.\n    // SAFETY: it takes an int.\n    let n = unsafe { thread_c_sysconf(SC_NPROCESSORS_ONLN) };\n    if n < 1 { 1 } else { n as usize }\n}\n\n// UNSAFE: C's nanosleep. SAFETY: time.h's prototype (struct timespec, two\n// 64-bit fields on the 64-bit targets, an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"nanosleep\"]\n    fn thread_c_nanosleep(req: *const i64, rem: *mut i64) -> i32;\n}\n\n// Sleeps for d at least: sleeps again for the rest when a signal wakes it.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sleep(d: crate::time::Duration) {\n    let max_secs = 9223372036854775807u64;\n    let secs = d.as_secs();\n");
    buf_str(out, c"    let mut req = [if secs > max_secs { max_secs as i64 } else { secs as i64 },\n        d.subsec_nanos() as i64];\n    // (each round sleeps or ends, a signal per round at most: counted)\n    for _ in 0..1000000 {\n        let mut rem = [0i64; 2];\n        // UNSAFE: C's nanosleep.\n        // SAFETY: req and rem are timespecs (two i64s), rem writable; req's\n        // nanoseconds are under a second (a Duration's).\n        let r = unsafe { thread_c_nanosleep(&req[0] as *const i64, &mut rem[0] as *mut i64) };\n        if r == 0 || rem[0] == 0 && rem[1] == 0 {\n            return;\n        }\n        req = rem;\n    }\n}\n// ---- end mod std::thread ----\n}\n// ---- mod std::time ----\npub mod time {\n// EDITION: rust\n// std::time: Duration, Instant and SystemTime, Rust's shape (0.27.5). A\n// Duration is whole seconds and the nanoseconds under one second; its\n// arithmetic is checked (`checked_*` give None, `saturating_*` stop at\n// zero and the largest Duration, the operators panic, as Rust's do).\n// Instant reads the monotonic clock, SystemTime the wall clock, both\n// through C's clock_gettime (the clock's id is the target's: std::__sys).\n// mvs: std::time\n\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::ops::{Add, AddAssign, Div, DivAssign, Mul, MulAssign, Sub, SubAssign};\nuse crate::option::Option;\nuse crate::result::Result;\n\nconst NANOS_PER_SEC: u32 = 1000000000;\nconst NANOS_PER_MILLI: u32 = 1000000;\nconst NANOS_PER_MICRO: u32 = 1000;\n\n// A span of time, Rust's std::time::Duration.\n// std2: changed: no ZERO, MAX, SECOND.. constants (a constant of a struct\n// type waits for const evaluation): `Duration::from_secs(0)`, `new(..)`\n// mvs: Duration\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct Duration {\n    secs: u64,\n    nanos: u32,\n}\n\nimpl Duration {\n    // secs seconds and nanos nanoseconds; nanos past a second carry into\n    // the seconds (panics when the seconds overflow).\n");
    buf_str(out, c"    #[effects(panic, diverge)]\n    pub fn new(secs: u64, nanos: u32) -> Duration {\n        if nanos < NANOS_PER_SEC {\n            return Duration { secs: secs, nanos: nanos };\n        }\n        let extra = (nanos / NANOS_PER_SEC) as u64;\n        match secs.checked_add(extra) {\n            Option::Some(s) => Duration { secs: s, nanos: nanos % NANOS_PER_SEC },\n            Option::None => crate::panic::panic(\"overflow in Duration::new\"),\n        }\n    }\n\n    #[effects()]\n    pub fn from_secs(secs: u64) -> Duration {\n        Duration { secs: secs, nanos: 0 }\n    }\n\n    #[effects()]\n    pub fn from_millis(millis: u64) -> Duration {\n        Duration { secs: millis / 1000, nanos: ((millis % 1000) as u32) * NANOS_PER_MILLI }\n    }\n\n    #[effects()]\n    pub fn from_micros(micros: u64) -> Duration {\n        Duration { secs: micros / 1000000, nanos: ((micros % 1000000) as u32) * NANOS_PER_MICRO }\n    }\n\n    #[effects()]\n    pub fn from_nanos(nanos: u64) -> Duration {\n        Duration { secs: nanos / 1000000000, nanos: (nanos % 1000000000) as u32 }\n    }\n\n    // secs seconds, a float: panics when it is negative, not finite or too\n    // large, as Rust's does; rounded to the nearest nanosecond.\n    #[effects(panic, diverge)]\n    pub fn from_secs_f64(secs: f64) -> Duration {\n        match Duration::try_from_secs_f64(secs) {\n            Result::Ok(d) => d,\n            Result::Err(_) => crate::panic::panic(\n                \"cannot convert float seconds to Duration: value is negative, not finite or overflowing\"),\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn from_secs_f32(secs: f32) -> Duration {\n        Duration::from_secs_f64(secs as f64)\n    }\n\n    // from_secs_f64's value, or the error where it panics.\n    #[effects()]\n    pub fn try_from_secs_f64(secs: f64) -> Result<Duration, TryFromFloatSecsError> {\n        if !(secs >= 0.0) || secs >= 18446744073709551616.0 {\n");
    buf_str(out, c"            return Result::Err(TryFromFloatSecsError { negative: secs < 0.0 });\n        }\n        let whole = secs as u64;\n        let frac = secs - whole as f64;\n        let mut nanos = (frac * 1000000000.0 + 0.5) as u64;\n        let mut s = whole;\n        if nanos >= 1000000000 {\n            nanos -= 1000000000;\n            match s.checked_add(1) {\n                Option::Some(t) => s = t,\n                Option::None => return Result::Err(TryFromFloatSecsError { negative: false }),\n            }\n        }\n        Result::Ok(Duration { secs: s, nanos: nanos as u32 })\n    }\n\n    #[effects()]\n    pub fn try_from_secs_f32(secs: f32) -> Result<Duration, TryFromFloatSecsError> {\n        Duration::try_from_secs_f64(secs as f64)\n    }\n\n    #[effects()]\n    pub fn is_zero(&self) -> bool {\n        self.secs == 0 && self.nanos == 0\n    }\n\n    #[effects()]\n    pub fn as_secs(&self) -> u64 {\n        self.secs\n    }\n\n    #[effects()]\n    pub fn subsec_millis(&self) -> u32 {\n        self.nanos / NANOS_PER_MILLI\n    }\n\n    #[effects()]\n    pub fn subsec_micros(&self) -> u32 {\n        self.nanos / NANOS_PER_MICRO\n    }\n\n    #[effects()]\n    pub fn subsec_nanos(&self) -> u32 {\n        self.nanos\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_millis(&self) -> u64 {\n        self.secs.saturating_mul(1000).saturating_add((self.nanos / NANOS_PER_MILLI) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_micros(&self) -> u64 {\n        self.secs.saturating_mul(1000000).saturating_add((self.nanos / NANOS_PER_MICRO) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_nanos(&self) -> u64 {\n        self.secs.saturating_mul(1000000000).saturating_add(self.nanos as u64)\n    }\n\n    #[effects()]\n    pub fn as_secs_f64(&self) -> f64 {\n");
    buf_str(out, c"        self.secs as f64 + self.nanos as f64 / 1000000000.0\n    }\n\n    #[effects()]\n    pub fn as_secs_f32(&self) -> f32 {\n        self.as_secs_f64() as f32\n    }\n\n    #[effects()]\n    pub fn as_millis_f64(&self) -> f64 {\n        self.secs as f64 * 1000.0 + self.nanos as f64 / 1000000.0\n    }\n\n    #[effects()]\n    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_add(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let mut nanos = self.nanos + rhs.nanos;\n        if nanos >= NANOS_PER_SEC {\n            nanos -= NANOS_PER_SEC;\n            secs = match secs.checked_add(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n        }\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_sub(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let nanos = if self.nanos >= rhs.nanos {\n            self.nanos - rhs.nanos\n        } else {\n            secs = match secs.checked_sub(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n            self.nanos + NANOS_PER_SEC - rhs.nanos\n        };\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {\n        let total = self.nanos as u64 * rhs as u64;\n        let extra = total / NANOS_PER_SEC as u64;\n        let nanos = (total % NANOS_PER_SEC as u64) as u32;\n        match self.secs.checked_mul(rhs as u64) {\n            Option::Some(s) => match s.checked_add(extra) {\n");
    buf_str(out, c"                Option::Some(secs) => Option::Some(Duration { secs: secs, nanos: nanos }),\n                Option::None => Option::None,\n            },\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_div(self, rhs: u32) -> Option<Duration> {\n        if rhs == 0 {\n            return Option::None;\n        }\n        let secs = self.secs / rhs as u64;\n        let carry = self.secs - secs * rhs as u64;\n        let extra = carry * NANOS_PER_SEC as u64 / rhs as u64;\n        let nanos = self.nanos / rhs + extra as u32;\n        Option::Some(Duration::new(secs, nanos))\n    }\n\n    #[effects()]\n    pub fn saturating_add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: 0, nanos: 0 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn abs_diff(self, other: Duration) -> Duration {\n        if self >= other {\n            self.saturating_sub(other)\n        } else {\n            other.saturating_sub(self)\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn mul_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(rhs * self.as_secs_f64())\n    }\n\n    #[effects(panic, diverge)]\n    pub fn div_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(self.as_secs_f64() / rhs)\n    }\n\n    #[effects()]\n    pub fn div_duration_f64(self, rhs: Duration) -> f64 {\n");
    buf_str(out, c"        self.as_secs_f64() / rhs.as_secs_f64()\n    }\n}\n\nimpl Add for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when adding durations\"),\n        }\n    }\n}\n\nimpl AddAssign for Duration {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, rhs: Duration) {\n        *self = *self + rhs;\n    }\n}\n\nimpl Sub for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when subtracting durations\"),\n        }\n    }\n}\n\nimpl SubAssign for Duration {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, rhs: Duration) {\n        *self = *self - rhs;\n    }\n}\n\n// mvs: Duration::mul_u32\nimpl Mul<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when multiplying duration by scalar\"),\n        }\n    }\n}\n\nimpl MulAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn mul_assign(&mut self, rhs: u32) {\n        *self = *self * rhs;\n    }\n}\n\n// mvs: Duration::div_u32\nimpl Div<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn div(self, rhs: u32) -> Duration {\n        match self.checked_div(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\n                \"divide by zero error when dividing duration by scalar\"),\n        }\n    }\n}\n\nimpl DivAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n");
    buf_str(out, c"    fn div_assign(&mut self, rhs: u32) {\n        *self = *self / rhs;\n    }\n}\n\n// Rust's form: `1.5s`, `100ms`, `2.000001ms`, `7µs`, `9ns`, the\n// fraction's trailing zeros dropped (or `{:.N?}` digits, rounded half\n// up), padded to the width.\nimpl Debug for Duration {\n    #[effects(unsafe)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.secs > 0 {\n            fmt_decimal(f, self.secs, self.nanos, NANOS_PER_SEC / 10, \"s\")\n        } else if self.nanos >= NANOS_PER_MILLI {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MILLI) as u64, self.nanos % NANOS_PER_MILLI,\n                NANOS_PER_MILLI / 10, \"ms\")\n        } else if self.nanos >= NANOS_PER_MICRO {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MICRO) as u64, self.nanos % NANOS_PER_MICRO,\n                NANOS_PER_MICRO / 10, \"µs\")\n        } else {\n            fmt_decimal(f, self.nanos as u64, 0, 1, \"ns\")\n        }\n    }\n}\n\n// integer.fraction then suffix: fraction's digits from divisor down, at\n// most the precision's (9 without one, its trailing zeros dropped).\n#[effects(unsafe)]\nfn fmt_decimal(f: &mut Formatter<'_>, integer: u64, fraction: u32, divisor: u32, suffix: &str)\n    -> crate::fmt::Result {\n    let mut digits = [b'0'; 9];\n    let wanted = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => 9,\n    };\n    let mut frac = fraction;\n    let mut div = divisor;\n    let mut pos: usize = 0;\n    while frac > 0 && pos < wanted && div > 0 {\n        digits[pos] = b'0' + (frac / div) as u8;\n        frac = frac % div;\n        div = div / 10;\n        pos += 1;\n    }\n    let mut int_part = integer;\n    // (rounding half up what is left)\n    if frac > 0 && div > 0 && frac >= div * 5 {\n        let mut carry = true;\n        let mut k = pos;\n        while carry && k > 0 {\n            k -= 1;\n            if digits[k] == b'9' {\n                digits[k] = b'0';\n");
    buf_str(out, c"            } else {\n                digits[k] += 1;\n                carry = false;\n            }\n        }\n        if carry {\n            int_part = int_part.saturating_add(1);\n        }\n    }\n    let shown = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => pos,\n    };\n    let mut out = [0u8; 48];\n    let mut n: usize = 0;\n    let mut int_digits = [0u8; 20];\n    let mut m: usize = 0;\n    let mut v = int_part;\n    if v == 0 {\n        int_digits[0] = b'0';\n        m = 1;\n    }\n    while v > 0 {\n        int_digits[m] = b'0' + (v % 10) as u8;\n        v = v / 10;\n        m += 1;\n    }\n    while m > 0 {\n        m -= 1;\n        out[n] = int_digits[m];\n        n += 1;\n    }\n    if shown > 0 {\n        out[n] = b'.';\n        n += 1;\n        for k in 0..shown {\n            out[n] = digits[k];\n            n += 1;\n        }\n    }\n    for b in suffix.as_bytes() {\n        out[n] = *b;\n        n += 1;\n    }\n    // UNSAFE: the bytes written above are ASCII digits, '.', and suffix's\n    // UTF-8 bytes copied whole.\n    // SAFETY: each is a whole UTF-8 sequence, so out[..n] is UTF-8.\n    let text = unsafe { crate::str::from_utf8_unchecked(&out[..n]) };\n    // (the width pads it, left-aligned by default, as Rust's; the\n    // precision was the fraction's, so not Formatter::pad, which would cut\n    // the text to it)\n    let chars = text.chars().count();\n    let w = match f.width() {\n        Option::Some(w) => w,\n        Option::None => 0,\n    };\n    if w <= chars {\n        return f.write_str(text);\n    }\n    let gap = w - chars;\n    let (before, after): (usize, usize) = match f.align() {\n        Option::Some(crate::fmt::Alignment::Right) => (gap, 0),\n        Option::Some(crate::fmt::Alignment::Center) => (gap / 2, gap - gap / 2),\n        _ => (0, gap),\n    };\n    let fill = f.fill();\n    for _ in 0..before {\n        f.write_char(fill)?;\n    }\n    f.write_str(text)?;\n");
    buf_str(out, c"    for _ in 0..after {\n        f.write_char(fill)?;\n    }\n    crate::fmt::Result::Ok(())\n}\n\n// Duration::try_from_secs_f64's error: the float was negative, not finite\n// or too large.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct TryFromFloatSecsError {\n    negative: bool,\n}\n\nimpl Display for TryFromFloatSecsError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.negative {\n            f.write_str(\"cannot convert float seconds to Duration: value is negative\")\n        } else {\n            f.write_str(\"cannot convert float seconds to Duration: value is either too big or NaN\")\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: time.h's prototype (struct timespec, two 64-bit\n// fields on the 64-bit targets, is an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    fn c_clock_gettime(clock: i32, tp: *mut i64) -> i32;\n}\n\n// Clock clock's now, a Duration since its start.\n#[effects(io, static, unsafe)]\nfn clock_now(clock: i32) -> Duration {\n    let mut ts = [0i64; 2];\n    // UNSAFE: C's clock_gettime.\n    // SAFETY: ts is a writable timespec (two i64s); clock is a valid id\n    // (the target's, std::__sys), so the call cannot fail.\n    unsafe {\n        c_clock_gettime(clock, &mut ts[0] as *mut i64);\n    }\n    Duration { secs: ts[0] as u64, nanos: ts[1] as u32 }\n}\n\n// A reading of the monotonic clock, Rust's std::time::Instant: only its\n// differences mean anything.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct Instant {\n    t: Duration,\n}\n\nimpl Instant {\n    // mvs: monotonic_now\n    #[effects(io, static, unsafe)]\n    pub fn now() -> Instant {\n        Instant { t: clock_now(crate::__sys::CLOCK_MONOTONIC) }\n    }\n\n    // The time since earlier (zero when earlier is later, as Rust's).\n    #[effects()]\n    pub fn duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n");
    buf_str(out, c"    #[effects()]\n    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {\n        self.t.checked_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn elapsed(&self) -> Duration {\n        Instant::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> Instant {\n        Instant { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> Instant {\n        Instant { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Sub<Instant> for Instant {\n    type Output = Duration;\n    #[effects()]\n    fn sub(self, earlier: Instant) -> Duration {\n        self.duration_since(earlier)\n    }\n}\n\nimpl Debug for Instant {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n");
    buf_str(out, c"        f.debug_struct(\"Instant\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// A reading of the wall clock, Rust's std::time::SystemTime: the time\n// since UNIX_EPOCH (not before it here).\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct SystemTime {\n    t: Duration,\n}\n\n// 1970-01-01 00:00:00 UTC.\n// std2: changed: a static (Rust's is a constant: a constant of a struct\n// type waits for const evaluation)\npub static UNIX_EPOCH: SystemTime = SystemTime { t: Duration { secs: 0, nanos: 0 } };\n\nimpl SystemTime {\n    // mvs: clock_now\n    #[effects(io, static, unsafe)]\n    pub fn now() -> SystemTime {\n        SystemTime { t: clock_now(0) }\n    }\n\n    // The time since earlier, or how much later earlier is.\n    #[effects()]\n    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {\n        match self.t.checked_sub(earlier.t) {\n            Option::Some(d) => Result::Ok(d),\n            Option::None => Result::Err(SystemTimeError(earlier.t - self.t)),\n        }\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {\n        SystemTime::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t + d }\n    }\n}\n\n");
    buf_str(out, c"impl AddAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Debug for SystemTime {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"SystemTime\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// SystemTime::duration_since's error: how much later the other time is.\n#[derive(Clone, Copy, Debug)]\npub struct SystemTimeError(Duration);\n\nimpl SystemTimeError {\n    #[effects()]\n    pub fn duration(&self) -> Duration {\n        self.0\n    }\n}\n\nimpl Display for SystemTimeError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"second time provided was later than self\")\n    }\n}\n// ---- end mod std::time ----\n}\n// ---- mod std::sync ----\npub mod sync {\n// EDITION: rust\n// std::sync: what threads share. Its first part (0.27.3): the atomics.\n// Mutex, RwLock, Arc and the channels come later.\n// mvs: std::sync\n\npub mod atomic;\n// ---- mod std::sync::atomic ----\npub mod atomic {\n// EDITION: rust\n// std::sync::atomic: values that threads read and write at once without a\n// data race, and the memory orderings (Rust's; C++20's model). AtomicI64\n// and the others are Atomic<T> for their T, an integer, bool or a raw\n// pointer: one access of 1 to 8 bytes (the compiler implements the sealed\n// AtomicValue, AtomicBitwise and AtomicInteger for exactly those types,\n// front/traits.vl: atomic_bound). Integers wrap.\n//\n");
    buf_str(out, c"//     static HITS: AtomicUsize = AtomicUsize::new(0);\n//     HITS.fetch_add(1, Ordering::Relaxed);\n// mvs: std::sync::atomic\n\nuse crate::cell::UnsafeCell;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::result::Result;\n\n// The ordering of an atomic operation (Rust's, without Consume).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum Ordering {\n    Relaxed,\n    Release,\n    Acquire,\n    AcqRel,\n    SeqCst,\n}\n\n// The intrinsics the compiler lowers by name to its atomic instructions\n// (middle/lower/atomic.vl, as MVS's std::sync::atomic): `order` is 0\n// Relaxed, 1 Acquire, 2 Release, 3 AcqRel, 4 SeqCst, a literal after\n// inlining (else SeqCst); their bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid and aligned for T, T one the\n// AtomicValue bound admits, and *p reached only through atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_swap<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The old value; *p becomes `new` when it was `expected`.\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_add<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_and<T>(p: *mut T, v: T, order: i64) -> T {\n");
    buf_str(out, c"    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_nand<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_or<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_xor<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (signed or unsigned as T is)\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_max<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_min<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (no pointer, no memory touched)\nfn atomic_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\nfn atomic_compiler_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\n// The one ordering of a compare-exchange, at least as strong as both.\nfn cas_order(success: Ordering, failure: Ordering) -> i64 {\n    if failure == Ordering::Release || failure == Ordering::AcqRel {\n        crate::panic::panic(\"there is no such thing as a release failure ordering\");\n    }\n    let s: i64 = match success {\n        Ordering::Relaxed => 0,\n        Ordering::Acquire => 1,\n        Ordering::Release => 2,\n        Ordering::AcqRel => 3,\n        Ordering::SeqCst => 4,\n    };\n    if s == 4 || failure == Ordering::SeqCst {\n        return 4;\n    }\n    if failure == Ordering::Acquire && (s == 0 || s == 2) {\n        return if s == 0 { 1 } else { 3 };\n    }\n    s\n}\n\n// What an Atomic holds: the integers, bool and the raw pointers (the\n// compiler's, sealed: Sealed is private).\npub trait AtomicValue: Copy + PartialEq {\n    fn sealed_value(self) -> Sealed;\n}\n\n// The integers and bool: fetch_and, fetch_or, fetch_xor, fetch_nand.\n");
    buf_str(out, c"pub trait AtomicBitwise {\n    fn sealed_bitwise(self) -> Sealed;\n}\n\n// The integers: fetch_add, fetch_sub, fetch_max, fetch_min.\npub trait AtomicInteger {\n    fn sealed_integer(self) -> Sealed;\n}\n\npub struct Sealed {}\n\n// A T that threads share: read and written only through its methods.\n// std2: new: Rust's AtomicI64, AtomicBool, .. are its aliases\npub struct Atomic<T: AtomicValue> {\n    v: UnsafeCell<T>,\n}\n\npub type AtomicI8 = Atomic<i8>;\npub type AtomicI16 = Atomic<i16>;\npub type AtomicI32 = Atomic<i32>;\npub type AtomicI64 = Atomic<i64>;\npub type AtomicIsize = Atomic<isize>;\npub type AtomicU8 = Atomic<u8>;\npub type AtomicU16 = Atomic<u16>;\npub type AtomicU32 = Atomic<u32>;\npub type AtomicU64 = Atomic<u64>;\npub type AtomicUsize = Atomic<usize>;\npub type AtomicBool = Atomic<bool>;\npub type AtomicPtr<T> = Atomic<*mut T>;\n\n// UNSAFE: an Atomic holds an UnsafeCell, which is not Sync: stated, as\n// Rust's atomics state it.\n// SAFETY: every access of v is atomic (its methods), so sharing an Atomic\n// between threads races on nothing; T is Copy, with no drop.\nunsafe impl<T: AtomicValue> Sync for Atomic<T> {}\n// UNSAFE: stated with Sync, as Rust's.\n// SAFETY: T is an integer, bool or a raw pointer, moved as its bits.\nunsafe impl<T: AtomicValue> Send for Atomic<T> {}\n\n// Each `unsafe` below: an intrinsic on self.v.get(), valid and aligned for\n// T, which is reached only through them (an Atomic is not Copy).\nimpl<T: AtomicValue> Atomic<T> {\n    #[effects(T)]\n    pub fn new(v: T) -> Atomic<T> {\n        Atomic { v: UnsafeCell::new(v) }\n    }\n\n    // The value, when nothing else can reach the atomic.\n    #[effects(unsafe, T)]\n    pub fn into_inner(self) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe { atomic_load(self.v.get() as *const T, 0) }\n    }\n\n    // The value, through the unique borrow (no atomic needed).\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> &mut T {\n");
    buf_str(out, c"        self.v.get_mut()\n    }\n\n    // The value's address (an access through it must not race with the\n    // atomic ones).\n    #[effects()]\n    pub fn as_ptr(&self) -> *mut T {\n        self.v.get()\n    }\n\n    // Panics on Release and AcqRel, as Rust's.\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn load(&self, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_load(self.v.get() as *const T, 0),\n                Ordering::Acquire => atomic_load(self.v.get() as *const T, 1),\n                Ordering::SeqCst => atomic_load(self.v.get() as *const T, 4),\n                Ordering::Release => crate::panic::panic(\n                    \"there is no such thing as a release load\"),\n                Ordering::AcqRel => crate::panic::panic(\n                    \"there is no such thing as an acquire-release load\"),\n            }\n        }\n    }\n\n    // Panics on Acquire and AcqRel, as Rust's.\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn store(&self, v: T, order: Ordering) {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_store(self.v.get(), v, 0),\n                Ordering::Release => atomic_store(self.v.get(), v, 2),\n                Ordering::SeqCst => atomic_store(self.v.get(), v, 4),\n                Ordering::Acquire => crate::panic::panic(\n                    \"there is no such thing as an acquire store\"),\n                Ordering::AcqRel => crate::panic::panic(\n                    \"there is no such thing as an acquire-release store\"),\n            }\n        }\n    }\n\n    // Stores v; the old value.\n    #[effects(unsafe, T)]\n    pub fn swap(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n");
    buf_str(out, c"        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_swap(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_swap(self.v.get(), v, 1),\n                Ordering::Release => atomic_swap(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_swap(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_swap(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Ok(the old value) when it was `current` (and is now `new`), else\n    // Err(the value found).\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn compare_exchange(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        let order = cas_order(success, failure);\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        let old = unsafe {\n            if order == 0 {\n                atomic_cas(self.v.get(), current, new, 0)\n            } else if order == 1 {\n                atomic_cas(self.v.get(), current, new, 1)\n            } else if order == 2 {\n                atomic_cas(self.v.get(), current, new, 2)\n            } else if order == 3 {\n                atomic_cas(self.v.get(), current, new, 3)\n            } else {\n                atomic_cas(self.v.get(), current, new, 4)\n            }\n        };\n        if old == current { Result::Ok(old) } else { Result::Err(old) }\n    }\n\n    // compare_exchange (it never fails spuriously here).\n    #[effects(T)]\n    pub fn compare_exchange_weak(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        self.compare_exchange(current, new, success, failure)\n    }\n}\n\n// The arithmetic: the integers only (it wraps).\nimpl<T: AtomicValue + AtomicInteger> Atomic<T> {\n    // Adds v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_add(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n");
    buf_str(out, c"        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_add(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_add(self.v.get(), v, 1),\n                Ordering::Release => atomic_add(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_add(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_add(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Subtracts v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_sub(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_sub(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_sub(self.v.get(), v, 1),\n                Ordering::Release => atomic_sub(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_sub(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_sub(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The larger of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_max(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_max(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_max(self.v.get(), v, 1),\n                Ordering::Release => atomic_max(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_max(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_max(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The smaller of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_min(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n");
    buf_str(out, c"                Ordering::Relaxed => atomic_min(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_min(self.v.get(), v, 1),\n                Ordering::Release => atomic_min(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_min(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_min(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\n// The bitwise operations: the integers and bool.\nimpl<T: AtomicValue + AtomicBitwise> Atomic<T> {\n    // The value & v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_and(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_and(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_and(self.v.get(), v, 1),\n                Ordering::Release => atomic_and(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_and(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_and(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // !(the value & v); the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_nand(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_nand(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_nand(self.v.get(), v, 1),\n                Ordering::Release => atomic_nand(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_nand(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_nand(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value | v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_or(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n");
    buf_str(out, c"                Ordering::Relaxed => atomic_or(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_or(self.v.get(), v, 1),\n                Ordering::Release => atomic_or(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_or(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_or(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value ^ v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_xor(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_xor(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_xor(self.v.get(), v, 1),\n                Ordering::Release => atomic_xor(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_xor(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_xor(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\nimpl<T: AtomicValue + Default> Default for Atomic<T> {\n    fn default() -> Atomic<T> {\n        Atomic::new(T::default())\n    }\n}\n\n// The value, read Relaxed (as Rust's).\nimpl<T: AtomicValue + Debug> Debug for Atomic<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.load(Ordering::Relaxed), f)\n    }\n}\n\n// A memory fence: Acquire, Release, AcqRel or SeqCst; panics on Relaxed,\n// as Rust's.\n#[effects(io, sync, panic, diverge)]\npub fn fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_fence(1),\n        Ordering::Release => atomic_fence(2),\n        Ordering::AcqRel => atomic_fence(3),\n        Ordering::SeqCst => atomic_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\"there is no such thing as a relaxed fence\"),\n    }\n}\n\n// A fence for the compiler only (no instruction): memory accesses are not\n// moved across it. Panics on Relaxed, as Rust's.\n");
    buf_str(out, c"#[effects(io, sync, panic, diverge)]\npub fn compiler_fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_compiler_fence(1),\n        Ordering::Release => atomic_compiler_fence(2),\n        Ordering::AcqRel => atomic_compiler_fence(3),\n        Ordering::SeqCst => atomic_compiler_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\n            \"there is no such thing as a relaxed compiler fence\"),\n    }\n}\n// ---- end mod std::sync::atomic ----\n}\n// ---- end mod std::sync ----\n}\n");
}

