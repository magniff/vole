t holds it.\n");
    buf_str(out, c"        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_8()), self) }\n    }\n}\n\n/// The Objective-C class NSException.\npub struct NSException {}\n\npub trait NSExceptionMethods<'a> {\n    // name\n    fn name(self) -> Ref<'a, NSString>;\n    // reason\n    fn reason(self) -> Option<Ref<'a, NSString>>;\n}\n\nimpl<'a> NSExceptionMethods<'a> for Ref<'a, NSException> {\n    fn name(self) -> Ref<'a, NSString> {\n        // UNSAFE: -name is sent by objc_msgSend, a C call whose types the compiler cannot see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSException (Ref's invariant), and a\n        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_9()), self) }\n    }\n\n    fn reason(self) -> Option<Ref<'a, NSString>> {\n        // UNSAFE: -reason is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSException (Ref's invariant), and a\n        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<NSString>::from_raw_opt(msg_p(self.ptr, sel_10()), self) }\n    }\n}\n\n/// The Objective-C class NSArray.\npub struct NSArray {}\n\npub trait NSArrayMethods<'a> {\n    // count\n    fn count(self) -> u64;\n    // objectAtIndex:\n    fn object_at_index(self, index: u64) -> Ref<'a, Object>;\n}\n\nimpl<'a> NSArrayMethods<'a> for Ref<'a, NSArray> {\n    fn count(self) -> u64 {\n        // UNSAFE: -count is sent by objc_msgSend, a C call whose types the compiler cannot see.\n");
