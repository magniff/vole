    buf_str(out, c"pub use adapters::{\n    Chain, Cloned, Copied, Cycle, Enumerate, Filter, FilterMap, FlatMap, Flatten, Fuse, Inspect,\n    Map, MapWhile, Peekable, Rev, Scan, Skip, SkipWhile, StepBy, Take, TakeWhile, Zip,\n};\npub use sources::{\n    Empty, FromFn, Once, Repeat, RepeatN, Successors, empty, from_fn, once, repeat, repeat_n,\n    successors, zip,\n};\n\n// A sequence of Items, one per `next` until None.\npub trait Iterator {\n    type Item;\n\n    fn next(&mut self) -> Option<Self::Item>;\n\n    // (at least, at most) items left; (0, None) when it cannot say.\n    // mvs: Iterator::exact_len\n    // std2: changed: Rust's size_hint (MVS: an exact length or -1)\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, Option::None)\n    }\n\n    // The items left, counted by consuming them.\n    fn count(self) -> usize\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut n: usize = 0;\n        while let Option::Some(_) = it.next() {\n            n += 1;\n        }\n        n\n    }\n\n    fn last(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        self.fold(Option::None, |_, x| Option::Some(x))\n    }\n\n    // Item n (from 0), the ones before it consumed.\n    // mvs: Iterator::at\n    // std2: changed: Rust's nth, an Option (MVS: at(k), the item or a panic)\n    fn nth(&mut self, n: usize) -> Option<Self::Item> {\n        let mut n = n;\n        while n > 0 {\n            self.next()?;\n            n -= 1;\n        }\n        self.next()\n    }\n\n    // Every step-th item, the first included; step > 0.\n    fn step_by(self, step: usize) -> StepBy<Self>\n        where\n            Self: Sized,\n    {\n        StepBy::new(self, step)\n    }\n\n    // Its items, then other's.\n    fn chain<U: IntoIterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U::IntoIter>\n        where\n            Self: Sized,\n    {\n        Chain::new(self, other.into_iter())\n    }\n\n");
    buf_str(out, c"    // Pairs of its items and other's, until either ends.\n    // std2: changed: takes any IntoIterator (MVS: an Iterator)\n    fn zip<U: IntoIterator>(self, other: U) -> Zip<Self, U::IntoIter>\n        where\n            Self: Sized,\n    {\n        Zip::new(self, other.into_iter())\n    }\n\n    // f of each item.\n    // std2: changed: Rust's FnMut(Self::Item) (MVS: a sink Item)\n    fn map<B, F: FnMut(Self::Item) -> B>(self, f: F) -> Map<Self, F>\n        where\n            Self: Sized,\n    {\n        Map::new(self, f)\n    }\n\n    // Calls f on each item, in order.\n    fn for_each<F: FnMut(Self::Item)>(self, f: F)\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.fold((), |_, x| f(x));\n    }\n\n    // The items predicate says true of.\n    // std2: changed: the predicate takes &Self::Item\n    fn filter<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> Filter<Self, P>\n        where\n            Self: Sized,\n    {\n        Filter::new(self, predicate)\n    }\n\n    // The Some values f gives.\n    fn filter_map<B, F: FnMut(Self::Item) -> Option<B>>(self, f: F) -> FilterMap<Self, F>\n        where\n            Self: Sized,\n    {\n        FilterMap::new(self, f)\n    }\n\n    // (index, item) pairs, from 0.\n    fn enumerate(self) -> Enumerate<Self>\n        where\n            Self: Sized,\n    {\n        Enumerate::new(self)\n    }\n\n    // An iterator that can look at its next item without taking it.\n    fn peekable(self) -> Peekable<Self>\n        where\n            Self: Sized,\n    {\n        Peekable::new(self)\n    }\n\n    fn skip_while<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> SkipWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        SkipWhile::new(self, predicate)\n    }\n\n    fn take_while<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> TakeWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        TakeWhile::new(self, predicate)\n    }\n\n");
    buf_str(out, c"    // f's values until it gives None.\n    fn map_while<B, P: FnMut(Self::Item) -> Option<B>>(self, predicate: P) -> MapWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        MapWhile::new(self, predicate)\n    }\n\n    fn skip(self, n: usize) -> Skip<Self>\n        where\n            Self: Sized,\n    {\n        Skip::new(self, n)\n    }\n\n    // The first n items.\n    fn take(self, n: usize) -> Take<Self>\n        where\n            Self: Sized,\n    {\n        Take::new(self, n)\n    }\n\n    // f's values, f keeping a state across items; None from f ends it.\n    fn scan<St, B,\n        F: FnMut(&mut St, Self::Item) -> Option<B>>(self, initial_state: St, f: F) -> Scan<Self, St,\n        F>\n        where\n            Self: Sized,\n    {\n        Scan::new(self, initial_state, f)\n    }\n\n    // The items of each f(item), in order.\n    fn flat_map<U: IntoIterator, F: FnMut(Self::Item) -> U>(self, f: F) -> FlatMap<Self, U, F>\n        where\n            Self: Sized,\n    {\n        FlatMap::new(self, f)\n    }\n\n    // The items of each item (an iterator of iterators, of Options, of Vecs).\n    fn flatten(self) -> Flatten<Self>\n        where\n            Self: Sized,\n            Self::Item: IntoIterator,\n    {\n        Flatten::new(self)\n    }\n\n    // None for ever once it has given None.\n    fn fuse(self) -> Fuse<Self>\n        where\n            Self: Sized,\n    {\n        Fuse::new(self)\n    }\n\n    // Calls f on a reference to each item as it passes.\n    fn inspect<F: FnMut(&Self::Item)>(self, f: F) -> Inspect<Self, F>\n        where\n            Self: Sized,\n    {\n        Inspect::new(self, f)\n    }\n\n    // The iterator borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n\n    // The items, collected into a B on a (`collect_in::<Vec<_, _>>(gpa)`,\n    // or the result's type from the context).\n");
    buf_str(out, c"    // std2: changed: generic in its result B (MVS: always a Vec)\n    // later: return_inference\n    fn collect_in<B: FromIteratorIn<Self::Item, A>, A: Allocator>(self, a: A) -> B\n        where\n            Self: Sized,\n    {\n        B::from_iter_in(self, a)\n    }\n\n    // (the items f says true of, the others), each a B on a clone of a.\n    // later: return_inference\n    fn partition_in<B, F: FnMut(&Self::Item) -> bool, A: Allocator + Clone>(self, f: F, a: A) -> (B,\n        B)\n        where\n            Self: Sized,\n            B: DefaultIn<A> + Extend<Self::Item>,\n    {\n        let mut f = f;\n        let mut yes: B = B::default_in(a.clone());\n        let mut no: B = B::default_in(a);\n        let mut it = self;\n        while let Option::Some(x) = it.next() {\n            if f(&x) {\n                yes.extend(Option::Some(x));\n            } else {\n                no.extend(Option::Some(x));\n            }\n        }\n        (yes, no)\n    }\n\n    // The items' pairs split into two collections on a clone of a.\n    // later: return_inference\n    fn unzip_in<X, Y, FromX, FromY, A: Allocator + Clone>(self, a: A) -> (FromX, FromY)\n        where\n            FromX: DefaultIn<A> + Extend<X>,\n            FromY: DefaultIn<A> + Extend<Y>,\n            Self: Sized + Iterator<Item = (X, Y)>,\n    {\n        let mut xs: FromX = FromX::default_in(a.clone());\n        let mut ys: FromY = FromY::default_in(a);\n        let mut it = self;\n        while let Option::Some((x, y)) = it.next() {\n            xs.extend(Option::Some(x));\n            ys.extend(Option::Some(y));\n        }\n        (xs, ys)\n    }\n\n    // f(f(f(init, a), b), c), for items a, b, c.\n    fn fold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut f = f;\n        let mut acc = init;\n        while let Option::Some(x) = it.next() {\n            acc = f(acc, x);\n        }\n");
    buf_str(out, c"        acc\n    }\n\n    // fold, starting from the first item; None when there is none.\n    fn reduce<F: FnMut(Self::Item, Self::Item) -> Self::Item>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let first = it.next()?;\n        Option::Some(it.fold(first, f))\n    }\n\n    // Whether f is true of every item (true when there is none); stops at\n    // the first false.\n    fn all<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if !f(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // Whether f is true of an item; stops at the first true.\n    fn any<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if f(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // The first item predicate says true of.\n    // std2: changed: the predicate takes &Self::Item\n    fn find<P: FnMut(&Self::Item) -> bool>(&mut self, predicate: P) -> Option<Self::Item> {\n        let mut p = predicate;\n        while let Option::Some(x) = self.next() {\n            if p(&x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n\n    // The first Some that f gives.\n    fn find_map<B, F: FnMut(Self::Item) -> Option<B>>(&mut self, f: F) -> Option<B> {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if let Option::Some(y) = f(x) {\n                return Option::Some(y);\n            }\n        }\n        Option::None\n    }\n\n    // The index of the first item predicate says true of.\n    fn position<P: FnMut(Self::Item) -> bool>(&mut self, predicate: P) -> Option<usize> {\n        let mut p = predicate;\n        let mut i: usize = 0;\n");
    buf_str(out, c"        while let Option::Some(x) = self.next() {\n            if p(x) {\n                return Option::Some(i);\n            }\n            i += 1;\n        }\n        Option::None\n    }\n\n    // The index of the last item predicate says true of, from the end.\n    fn rposition<P: FnMut(Self::Item) -> bool>(&mut self, predicate: P) -> Option<usize>\n        where\n            Self: Sized + ExactSizeIterator + DoubleEndedIterator,\n    {\n        let mut p = predicate;\n        let mut i: usize = self.len();\n        while let Option::Some(x) = self.next_back() {\n            i -= 1;\n            if p(x) {\n                return Option::Some(i);\n            }\n        }\n        Option::None\n    }\n\n    // The largest item; the last of equal ones.\n    // std2: changed: Item: Ord, Rust's\n    fn max(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n            Self::Item: Ord,\n    {\n        self.max_by(|a, b| a.cmp(b))\n    }\n\n    // The smallest item; the first of equal ones.\n    // std2: changed: Item: Ord, Rust's\n    fn min(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n            Self::Item: Ord,\n    {\n        self.min_by(|a, b| a.cmp(b))\n    }\n\n    fn max_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.max_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    fn max_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, compare: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut c = compare;\n        self.reduce(|a, b| if c(&a, &b).is_gt() { a } else { b })\n    }\n\n    fn min_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.min_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n");
    buf_str(out, c"    fn min_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, compare: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut c = compare;\n        self.reduce(|a, b| if c(&b, &a).is_lt() { b } else { a })\n    }\n\n    // Its items from the end.\n    fn rev(self) -> Rev<Self>\n        where\n            Self: Sized + DoubleEndedIterator,\n    {\n        Rev::new(self)\n    }\n\n    // Copies of the items of an iterator of &U (`v.iter().copied()`).\n    // (U and 'b, not Rust's T and 'a: the impl's own parameters, `impl<'a,\n    // T> Iterator for Iter<'a, T>`, are in scope in the default body's\n    // copy, and a name of both would bind the impl's.)\n    fn copied<'b, U: Copy + 'b>(self) -> Copied<Self>\n        where\n            Self: Sized + Iterator<Item = &'b U>,\n    {\n        Copied::new(self)\n    }\n\n    fn cloned<'b, U: Clone + 'b>(self) -> Cloned<Self>\n        where\n            Self: Sized + Iterator<Item = &'b U>,\n    {\n        Cloned::new(self)\n    }\n\n    // Its items again and again (it must be Clone).\n    fn cycle(self) -> Cycle<Self>\n        where\n            Self: Sized + Clone,\n    {\n        Cycle::new(self)\n    }\n\n    // The items' sum (`let s: i64 = v.iter().sum();`).\n    // std2: changed: S: Sum<Self::Item> (MVS: the Item itself)\n    // later: return_inference\n    fn sum<S: Sum<Self::Item>>(self) -> S\n        where\n            Self: Sized,\n    {\n        S::sum(self)\n    }\n\n    // later: return_inference\n    fn product<P: Product<Self::Item>>(self) -> P\n        where\n            Self: Sized,\n    {\n        P::product(self)\n    }\n\n    // Lexicographic, item by item.\n    fn cmp<I: IntoIterator<Item = Self::Item>>(self, other: I) -> Ordering\n        where\n            Self::Item: Ord,\n            Self: Sized,\n    {\n        let mut me = self;\n        let mut other = other.into_iter();\n        loop {\n            match (me.next(), other.next()) {\n");
    buf_str(out, c"                (Option::None, Option::None) => return Ordering::Equal,\n                (Option::None, Option::Some(_)) => return Ordering::Less,\n                (Option::Some(_), Option::None) => return Ordering::Greater,\n                (Option::Some(x), Option::Some(y)) => match x.cmp(&y) {\n                    Ordering::Equal => {}\n                    o => return o,\n                },\n            }\n        }\n    }\n\n    fn partial_cmp<I: IntoIterator>(self, other: I) -> Option<Ordering>\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        let mut me = self;\n        let mut other = other.into_iter();\n        loop {\n            match (me.next(), other.next()) {\n                (Option::None, Option::None) => return Option::Some(Ordering::Equal),\n                (Option::None, Option::Some(_)) => return Option::Some(Ordering::Less),\n                (Option::Some(_), Option::None) => return Option::Some(Ordering::Greater),\n                (Option::Some(x), Option::Some(y)) => match x.partial_cmp(&y) {\n                    Option::Some(Ordering::Equal) => {}\n                    o => return o,\n                },\n            }\n        }\n    }\n\n    // Whether the two have equal items, in order.\n    fn eq<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialEq<I::Item>,\n            Self: Sized,\n    {\n        let mut me = self;\n        let mut other = other.into_iter();\n        loop {\n            match (me.next(), other.next()) {\n                (Option::None, Option::None) => return true,\n                (Option::Some(x), Option::Some(y)) => {\n                    if x != y {\n                        return false;\n                    }\n                }\n                _ => return false,\n            }\n        }\n    }\n\n    fn ne<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialEq<I::Item>,\n");
    buf_str(out, c"            Self: Sized,\n    {\n        !self.eq(other)\n    }\n\n    fn lt<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        self.partial_cmp(other) == Option::Some(Ordering::Less)\n    }\n\n    fn le<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    fn gt<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        self.partial_cmp(other) == Option::Some(Ordering::Greater)\n    }\n\n    fn ge<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    // Whether each item is <= the next.\n    fn is_sorted(self) -> bool\n        where\n            Self: Sized,\n            Self::Item: PartialOrd,\n    {\n        let mut it = self;\n        let mut last = match it.next() {\n            Option::Some(x) => x,\n            Option::None => return true,\n        };\n        while let Option::Some(x) = it.next() {\n            if !(last <= x) {\n                return false;\n            }\n            last = x;\n        }\n        true\n    }\n}\n\n// A mutable borrow of an iterator is one (`it.by_ref().take(3)`).\nimpl<I: Iterator + ?Sized> Iterator for &mut I {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        (**self).next()\n    }\n}\n\n// An iterator that can also give its items from the end.\npub trait DoubleEndedIterator: Iterator {\n");
    buf_str(out, c"    fn next_back(&mut self) -> Option<Self::Item>;\n\n    // Item n from the end.\n    fn nth_back(&mut self, n: usize) -> Option<Self::Item> {\n        let mut n = n;\n        while n > 0 {\n            self.next_back()?;\n            n -= 1;\n        }\n        self.next_back()\n    }\n\n    // fold, from the end.\n    fn rfold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut f = f;\n        let mut acc = init;\n        while let Option::Some(x) = it.next_back() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    // find, from the end.\n    fn rfind<P: FnMut(&Self::Item) -> bool>(&mut self, predicate: P) -> Option<Self::Item> {\n        let mut p = predicate;\n        while let Option::Some(x) = self.next_back() {\n            if p(&x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// An iterator that knows how many items are left: size_hint is exact.\npub trait ExactSizeIterator: Iterator {\n    fn len(&self) -> usize {\n        self.size_hint().0\n    }\n\n    fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n}\n\n// An iterator that gives None for ever after its first None.\npub trait FusedIterator: Iterator {}\n\n// What a `for` loop iterates: an iterator itself, a collection by value\n// (its items), by & (references) or by &mut.\npub trait IntoIterator {\n    type Item;\n    type IntoIter: Iterator<Item = Self::Item>;\n\n    fn into_iter(self) -> Self::IntoIter;\n}\n\n// Every iterator is one.\n// later: blanket_impl\nimpl<I: Iterator> IntoIterator for I {\n    type Item = I::Item;\n    type IntoIter = I;\n\n    fn into_iter(self) -> I {\n        self\n    }\n}\n\n// Rust's FromIterator, with the allocator named: what `collect_in(a)`\n// makes (Vec, String, HashMap, HashSet).\n// mvs: Iterator::collect_in\npub trait FromIteratorIn<T, A>: Sized {\n");
    buf_str(out, c"    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Self;\n}\n\n// A collection that items can be added to (`v.extend(it)`); it grows\n// from its own allocator.\npub trait Extend<T> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I);\n}\n\n// What `sum` adds up to: numbers from numbers or from references to them.\n// Built in, for each type P listed: `Sum for P` and `Sum<&'a P> for P`\n// (`iter.fold(0, |a, b| a + b)`, of references `a + *b`).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Sum<A = Self>: Sized {\n    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// What `product` multiplies up to. Built in as Sum is, with 1 and `*`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Product<A = Self>: Sized {\n    fn product<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// What ranges iterate over: the integers and char. Sealed: std's impls\n// only (built in for each integer type; char's waits for char).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Step: Clone + PartialOrd + Sized {\n    // How many steps from start to end; None when end < start or too many.\n    fn steps_between(start: &Self, end: &Self) -> (usize, Option<usize>);\n    // start + count, None on overflow.\n    fn forward_checked(start: Self, count: usize) -> Option<Self>;\n    // start - count, None on overflow.\n    fn backward_checked(start: Self, count: usize) -> Option<Self>;\n}\n\n// `for i in 0..n`.\n// mvs: Range::impl Iterator\nimpl<A: Step> Iterator for Range<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.start < self.end {\n            let n = Step::forward_checked(self.start.clone(), 1)?;\n            Option::Some(crate::mem::replace(&mut self.start, n))\n        } else {\n            Option::None\n        }\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n");
    buf_str(out, c"        // (`A::`: the front reads `Step::steps_between(..)` here as the\n        // return type's)\n        A::steps_between(&self.start, &self.end)\n    }\n}\n\n// `(0..n).rev()`.\nimpl<A: Step> DoubleEndedIterator for Range<A> {\n    fn next_back(&mut self) -> Option<A> {\n        if self.start < self.end {\n            self.end = Step::backward_checked(self.end.clone(), 1)?;\n            Option::Some(self.end.clone())\n        } else {\n            Option::None\n        }\n    }\n}\n\nimpl<A: Step> ExactSizeIterator for Range<A> {}\n\n// `for i in 0..=n`, `(0..=n).rev()`.\n// mvs: RangeInclusive::impl Iterator\nimpl<A: Step> Iterator for RangeInclusive<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        // RangeInclusive's fields are ops's (Rust's are pub(crate)): the\n        // range is remade through its constructor, empty once spent.\n        if self.is_empty() {\n            return Option::None;\n        }\n        let start = self.start().clone();\n        let end = self.end().clone();\n        if start < end {\n            let n = Step::forward_checked(start.clone(), 1)?;\n            *self = RangeInclusive::new(n, end);\n        } else {\n            *self = spent(end);\n        }\n        Option::Some(start)\n    }\n}\n\nimpl<A: Step> DoubleEndedIterator for RangeInclusive<A> {\n    fn next_back(&mut self) -> Option<A> {\n        if self.is_empty() {\n            return Option::None;\n        }\n        let start = self.start().clone();\n        let end = self.end().clone();\n        if start < end {\n            let p = Step::backward_checked(end.clone(), 1)?;\n            *self = RangeInclusive::new(start, p);\n        } else {\n            *self = spent(start);\n        }\n        Option::Some(end)\n    }\n}\n\n// An empty range next to at: what a RangeInclusive becomes when its last\n// item is taken.\nfn spent<A: Step>(at: A) -> RangeInclusive<A> {\n    match Step::forward_checked(at.clone(), 1) {\n");
    buf_str(out, c"        Option::Some(n) => RangeInclusive::new(n, at),\n        Option::None => match Step::backward_checked(at.clone(), 1) {\n            Option::Some(p) => RangeInclusive::new(at, p),\n            // a type of one value: no empty range of it can be made\n            Option::None => RangeInclusive::new(at.clone(), at),\n        },\n    }\n}\n\n// `for i in 0..`: for ever (overflow panics in a debug build).\nimpl<A: Step> Iterator for RangeFrom<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        let n = Step::forward_checked(self.start.clone(), 1).expect(\"RangeFrom overflowed\");\n        Option::Some(crate::mem::replace(&mut self.start, n))\n    }\n}\n// ---- mod std::iter::adapters ----\nmod adapters {\n// EDITION: rust\n// The iterator adapters: each a named struct that Iterator's method of\n// the same name returns (no impl Trait in return position: plan §6), its\n// fields private, its constructor std's own.\n\nuse crate::clone::Clone;\nuse crate::cmp::PartialEq;\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, FusedIterator, IntoIterator, Iterator};\nuse crate::option::Option;\n\n// Iterator::map's: f of each item.\n// mvs: Map\n#[derive(Clone)]\npub struct Map<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> Map<I, F> {\n    pub(crate) fn new(iter: I, f: F) -> Map<I, F> {\n        Map { iter: iter, f: f }\n    }\n}\n\n// mvs: Map::impl Iterator\nimpl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for Map<I, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        self.iter.next().map(&mut self.f)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> B> DoubleEndedIterator for Map<I, F> {\n    fn next_back(&mut self) -> Option<B> {\n        self.iter.next_back().map(&mut self.f)\n    }\n}\n\nimpl<B, I: ExactSizeIterator, F: FnMut(I::Item) -> B> ExactSizeIterator for Map<I, F> {}\n\n");
    buf_str(out, c"// Iterator::filter's: the items the predicate says true of.\n// mvs: Filter\n#[derive(Clone)]\npub struct Filter<I, P> {\n    iter: I,\n    predicate: P,\n}\n\nimpl<I, P> Filter<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> Filter<I, P> {\n        Filter { iter: iter, predicate: predicate }\n    }\n}\n\n// mvs: Filter::impl Iterator\n// std2: changed: the predicate takes &I::Item\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for Filter<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.find(&mut self.predicate)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, self.iter.size_hint().1)\n    }\n}\n\nimpl<I: DoubleEndedIterator, P: FnMut(&I::Item) -> bool> DoubleEndedIterator for Filter<I, P> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        self.iter.rfind(&mut self.predicate)\n    }\n}\n\n// Iterator::filter_map's.\n#[derive(Clone)]\npub struct FilterMap<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> FilterMap<I, F> {\n    pub(crate) fn new(iter: I, f: F) -> FilterMap<I, F> {\n        FilterMap { iter: iter, f: f }\n    }\n}\n\nimpl<B, I: Iterator, F: FnMut(I::Item) -> Option<B>> Iterator for FilterMap<I, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        self.iter.find_map(&mut self.f)\n    }\n}\n\nimpl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> Option<B>> DoubleEndedIterator for FilterMap<I,\n    F> {\n    fn next_back(&mut self) -> Option<B> {\n        while let Option::Some(x) = self.iter.next_back() {\n            if let Option::Some(y) = (self.f)(x) {\n                return Option::Some(y);\n            }\n        }\n        Option::None\n    }\n}\n\n// Iterator::enumerate's: (index, item).\n// mvs: Enumerate\n#[derive(Clone)]\npub struct Enumerate<I> {\n    iter: I,\n    count: usize,\n}\n\nimpl<I> Enumerate<I> {\n    pub(crate) fn new(iter: I) -> Enumerate<I> {\n        Enumerate { iter: iter, count: 0 }\n    }\n}\n\n");
    buf_str(out, c"// mvs: Enumerate::impl Iterator\n// std2: changed: the index is usize\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (usize, I::Item);\n\n    fn next(&mut self) -> Option<(usize, I::Item)> {\n        let x = self.iter.next()?;\n        let i = self.count;\n        self.count += 1;\n        Option::Some((i, x))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<I: ExactSizeIterator + DoubleEndedIterator> DoubleEndedIterator for Enumerate<I> {\n    fn next_back(&mut self) -> Option<(usize, I::Item)> {\n        let x = self.iter.next_back()?;\n        Option::Some((self.count + self.iter.len(), x))\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {}\n\n// Iterator::zip's: pairs, until either ends.\n// mvs: Zip\n#[derive(Clone)]\npub struct Zip<A, B> {\n    a: A,\n    b: B,\n}\n\nimpl<A, B> Zip<A, B> {\n    pub(crate) fn new(a: A, b: B) -> Zip<A, B> {\n        Zip { a: a, b: b }\n    }\n}\n\n// mvs: Zip::impl Iterator\nimpl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {\n    type Item = (A::Item, B::Item);\n\n    fn next(&mut self) -> Option<(A::Item, B::Item)> {\n        let x = self.a.next()?;\n        let y = self.b.next()?;\n        Option::Some((x, y))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let (alo, ahi) = self.a.size_hint();\n        let (blo, bhi) = self.b.size_hint();\n        let hi = match (ahi, bhi) {\n            (Option::Some(x), Option::Some(y)) => Option::Some(crate::cmp::min(x, y)),\n            (Option::Some(x), Option::None) => Option::Some(x),\n            (Option::None, Option::Some(y)) => Option::Some(y),\n            (Option::None, Option::None) => Option::None,\n        };\n        (crate::cmp::min(alo, blo), hi)\n    }\n}\n\nimpl<A: ExactSizeIterator, B: ExactSizeIterator> ExactSizeIterator for Zip<A, B> {}\n\n// Iterator::chain's: one, then the other.\n#[derive(Clone)]\npub struct Chain<A, B> {\n");
    buf_str(out, c"    a: Option<A>,\n    b: Option<B>,\n}\n\nimpl<A, B> Chain<A, B> {\n    pub(crate) fn new(a: A, b: B) -> Chain<A, B> {\n        Chain { a: Option::Some(a), b: Option::Some(b) }\n    }\n}\n\nimpl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {\n    type Item = A::Item;\n\n    fn next(&mut self) -> Option<A::Item> {\n        if let Option::Some(a) = &mut self.a {\n            match a.next() {\n                Option::Some(x) => return Option::Some(x),\n                Option::None => self.a = Option::None,\n            }\n        }\n        match &mut self.b {\n            Option::Some(b) => b.next(),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<A: DoubleEndedIterator,\n    B: DoubleEndedIterator<Item = A::Item>> DoubleEndedIterator for Chain<A, B> {\n    fn next_back(&mut self) -> Option<A::Item> {\n        if let Option::Some(b) = &mut self.b {\n            match b.next_back() {\n                Option::Some(x) => return Option::Some(x),\n                Option::None => self.b = Option::None,\n            }\n        }\n        match &mut self.a {\n            Option::Some(a) => a.next_back(),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// Iterator::take's: the first n items.\n// mvs: Take\n#[derive(Clone)]\npub struct Take<I> {\n    iter: I,\n    n: usize,\n}\n\nimpl<I> Take<I> {\n    pub(crate) fn new(iter: I, n: usize) -> Take<I> {\n        Take { iter: iter, n: n }\n    }\n}\n\n// mvs: Take::impl Iterator\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n == 0 {\n            return Option::None;\n        }\n        self.n -= 1;\n        self.iter.next()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        if self.n == 0 {\n            return (0, Option::Some(0));\n        }\n        let (lo, hi) = self.iter.size_hint();\n        let hi = match hi {\n");
    buf_str(out, c"            Option::Some(x) => crate::cmp::min(x, self.n),\n            Option::None => self.n,\n        };\n        (crate::cmp::min(lo, self.n), Option::Some(hi))\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {}\n\n// Iterator::skip's: all but the first n.\n#[derive(Clone)]\npub struct Skip<I> {\n    iter: I,\n    n: usize,\n}\n\nimpl<I> Skip<I> {\n    pub(crate) fn new(iter: I, n: usize) -> Skip<I> {\n        Skip { iter: iter, n: n }\n    }\n}\n\nimpl<I: Iterator> Iterator for Skip<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n > 0 {\n            let n = self.n;\n            self.n = 0;\n            return self.iter.nth(n);\n        }\n        self.iter.next()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let (lo, hi) = self.iter.size_hint();\n        let lo = lo.saturating_sub(self.n);\n        let hi = match hi {\n            Option::Some(x) => Option::Some(x.saturating_sub(self.n)),\n            Option::None => Option::None,\n        };\n        (lo, hi)\n    }\n}\n\nimpl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        // the first n are skipped, so the back ends where they begin\n        if self.len() > 0 { self.iter.next_back() } else { Option::None }\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {}\n\n// Iterator::take_while's.\n#[derive(Clone)]\npub struct TakeWhile<I, P> {\n    iter: I,\n    flag: bool,\n    predicate: P,\n}\n\nimpl<I, P> TakeWhile<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> TakeWhile<I, P> {\n        TakeWhile { iter: iter, flag: false, predicate: predicate }\n    }\n}\n\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for TakeWhile<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.flag {\n            return Option::None;\n        }\n");
    buf_str(out, c"        let x = self.iter.next()?;\n        if (self.predicate)(&x) {\n            Option::Some(x)\n        } else {\n            self.flag = true;\n            Option::None\n        }\n    }\n}\n\n// Iterator::skip_while's.\n#[derive(Clone)]\npub struct SkipWhile<I, P> {\n    iter: I,\n    flag: bool,\n    predicate: P,\n}\n\nimpl<I, P> SkipWhile<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> SkipWhile<I, P> {\n        SkipWhile { iter: iter, flag: false, predicate: predicate }\n    }\n}\n\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for SkipWhile<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        loop {\n            let x = self.iter.next()?;\n            if self.flag || !(self.predicate)(&x) {\n                self.flag = true;\n                return Option::Some(x);\n            }\n        }\n    }\n}\n\n// Iterator::map_while's.\n#[derive(Clone)]\npub struct MapWhile<I, P> {\n    iter: I,\n    predicate: P,\n}\n\nimpl<I, P> MapWhile<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> MapWhile<I, P> {\n        MapWhile { iter: iter, predicate: predicate }\n    }\n}\n\nimpl<B, I: Iterator, P: FnMut(I::Item) -> Option<B>> Iterator for MapWhile<I, P> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        let x = self.iter.next()?;\n        (self.predicate)(x)\n    }\n}\n\n// Iterator::step_by's.\n#[derive(Clone)]\npub struct StepBy<I> {\n    iter: I,\n    step: usize,\n    first_take: bool,\n}\n\nimpl<I> StepBy<I> {\n    pub(crate) fn new(iter: I, step: usize) -> StepBy<I> {\n        if step == 0 {\n            crate::panic::panic(\"step_by: step is 0\");\n        }\n        StepBy { iter: iter, step: step - 1, first_take: true }\n    }\n}\n\nimpl<I: Iterator> Iterator for StepBy<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.first_take {\n            self.first_take = false;\n            self.iter.next()\n        } else {\n");
    buf_str(out, c"            self.iter.nth(self.step)\n        }\n    }\n}\n\n// Iterator::peekable's: peek at the next item without taking it.\npub struct Peekable<I: Iterator> {\n    iter: I,\n    peeked: Option<Option<I::Item>>,\n}\n\nimpl<I: Iterator> Peekable<I> {\n    pub(crate) fn new(iter: I) -> Peekable<I> {\n        Peekable { iter: iter, peeked: Option::None }\n    }\n\n    // The next item, still to come.\n    #[effects(panic, diverge)]\n    pub fn peek(&mut self) -> Option<&I::Item> {\n        let iter = &mut self.iter;\n        self.peeked.get_or_insert_with(|| iter.next()).as_ref()\n    }\n\n    #[effects(panic, diverge)]\n    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {\n        let iter = &mut self.iter;\n        self.peeked.get_or_insert_with(|| iter.next()).as_mut()\n    }\n\n    // The next item, when func says true of it.\n    #[effects(I, F)]\n    pub fn next_if<F: FnOnce(&I::Item) -> bool>(&mut self, func: F) -> Option<I::Item> {\n        let next = match self.peeked.take() {\n            Option::Some(v) => v,\n            Option::None => self.iter.next(),\n        };\n        match next {\n            Option::Some(x) => {\n                if func(&x) {\n                    return Option::Some(x);\n                }\n                // not taken: it stays the next one\n                self.peeked = Option::Some(Option::Some(x));\n                Option::None\n            }\n            Option::None => {\n                self.peeked = Option::Some(Option::None);\n                Option::None\n            }\n        }\n    }\n\n    // The next item, when it equals expected.\n    #[effects(I, T)]\n    pub fn next_if_eq<T: ?Sized>(&mut self, expected: &T) -> Option<I::Item>\n        where\n            I::Item: PartialEq<T>,\n    {\n        self.next_if(|x| *x == *expected)\n    }\n}\n\nimpl<I: Iterator> Iterator for Peekable<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match self.peeked.take() {\n");
    buf_str(out, c"            Option::Some(v) => v,\n            Option::None => self.iter.next(),\n        }\n    }\n}\n\n// Iterator::rev's: from the end.\n#[derive(Clone)]\npub struct Rev<I> {\n    iter: I,\n}\n\nimpl<I> Rev<I> {\n    pub(crate) fn new(iter: I) -> Rev<I> {\n        Rev { iter: iter }\n    }\n}\n\nimpl<I: DoubleEndedIterator> Iterator for Rev<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.next_back()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        self.iter.next()\n    }\n}\n\nimpl<I: DoubleEndedIterator + ExactSizeIterator> ExactSizeIterator for Rev<I> {}\n\n// Iterator::copied's: copies of the &T items.\n#[derive(Clone)]\npub struct Copied<I> {\n    iter: I,\n}\n\nimpl<I> Copied<I> {\n    pub(crate) fn new(iter: I) -> Copied<I> {\n        Copied { iter: iter }\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: Iterator<Item = &'a T>> Iterator for Copied<I> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.iter.next().copied()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Copied<I> {\n    fn next_back(&mut self) -> Option<T> {\n        self.iter.next_back().copied()\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: ExactSizeIterator<Item = &'a T>> ExactSizeIterator for Copied<I> {}\n\n// Iterator::cloned's: clones of the &T items.\n#[derive(Clone)]\npub struct Cloned<I> {\n    iter: I,\n}\n\nimpl<I> Cloned<I> {\n    pub(crate) fn new(iter: I) -> Cloned<I> {\n        Cloned { iter: iter }\n    }\n}\n\nimpl<'a, T: Clone + 'a, I: Iterator<Item = &'a T>> Iterator for Cloned<I> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.iter.next().cloned()\n    }\n}\n\n");
    buf_str(out, c"impl<'a, T: Clone + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Cloned<I> {\n    fn next_back(&mut self) -> Option<T> {\n        self.iter.next_back().cloned()\n    }\n}\n\n// Iterator::flatten's: the items of each item.\npub struct Flatten<I: Iterator>\n    where\n        I::Item: IntoIterator,\n{\n    iter: Fuse<I>,\n    front: Option<<I::Item as IntoIterator>::IntoIter>,\n    back: Option<<I::Item as IntoIterator>::IntoIter>,\n}\n\nimpl<I: Iterator> Flatten<I>\n    where\n        I::Item: IntoIterator,\n{\n    pub(crate) fn new(iter: I) -> Flatten<I> {\n        Flatten { iter: Fuse::new(iter), front: Option::None, back: Option::None }\n    }\n}\n\nimpl<I: Iterator> Iterator for Flatten<I>\n    where\n        I::Item: IntoIterator,\n{\n    type Item = <I::Item as IntoIterator>::Item;\n\n    fn next(&mut self) -> Option<<I::Item as IntoIterator>::Item> {\n        loop {\n            if let Option::Some(inner) = &mut self.front {\n                if let Option::Some(x) = inner.next() {\n                    return Option::Some(x);\n                }\n                self.front = Option::None;\n            }\n            match self.iter.next() {\n                Option::Some(inner) => self.front = Option::Some(inner.into_iter()),\n                Option::None => {\n                    return match &mut self.back {\n                        Option::Some(b) => b.next(),\n                        Option::None => Option::None,\n                    };\n                }\n            }\n        }\n    }\n}\n\n// Iterator::flat_map's: the items of each f(item).\npub struct FlatMap<I, U: IntoIterator, F> {\n    iter: Map<I, F>,\n    front: Option<U::IntoIter>,\n    back: Option<U::IntoIter>,\n}\n\nimpl<I, U: IntoIterator, F> FlatMap<I, U, F> {\n    pub(crate) fn new(iter: I, f: F) -> FlatMap<I, U, F> {\n        FlatMap { iter: Map::new(iter, f), front: Option::None, back: Option::None }\n    }\n}\n\n");
    buf_str(out, c"impl<I: Iterator, U: IntoIterator, F: FnMut(I::Item) -> U> Iterator for FlatMap<I, U, F> {\n    type Item = U::Item;\n\n    fn next(&mut self) -> Option<U::Item> {\n        loop {\n            if let Option::Some(inner) = &mut self.front {\n                if let Option::Some(x) = inner.next() {\n                    return Option::Some(x);\n                }\n                self.front = Option::None;\n            }\n            match self.iter.next() {\n                Option::Some(u) => self.front = Option::Some(u.into_iter()),\n                Option::None => {\n                    return match &mut self.back {\n                        Option::Some(b) => b.next(),\n                        Option::None => Option::None,\n                    };\n                }\n            }\n        }\n    }\n}\n\n// Iterator::fuse's: None for ever after the first None.\n#[derive(Clone)]\npub struct Fuse<I> {\n    iter: Option<I>,\n}\n\nimpl<I> Fuse<I> {\n    pub(crate) fn new(iter: I) -> Fuse<I> {\n        Fuse { iter: Option::Some(iter) }\n    }\n}\n\nimpl<I: Iterator> Iterator for Fuse<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match &mut self.iter {\n            Option::Some(it) => match it.next() {\n                Option::Some(x) => Option::Some(x),\n                Option::None => {\n                    self.iter = Option::None;\n                    Option::None\n                }\n            },\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<I: Iterator> FusedIterator for Fuse<I> {}\n\n// Iterator::inspect's.\n#[derive(Clone)]\npub struct Inspect<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> Inspect<I, F> {\n    pub(crate) fn new(iter: I, f: F) -> Inspect<I, F> {\n        Inspect { iter: iter, f: f }\n    }\n}\n\nimpl<I: Iterator, F: FnMut(&I::Item)> Iterator for Inspect<I, F> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        let x = self.iter.next()?;\n");
    buf_str(out, c"        (self.f)(&x);\n        Option::Some(x)\n    }\n}\n\n// Iterator::scan's.\n#[derive(Clone)]\npub struct Scan<I, St, F> {\n    iter: I,\n    f: F,\n    state: St,\n}\n\nimpl<I, St, F> Scan<I, St, F> {\n    pub(crate) fn new(iter: I, state: St, f: F) -> Scan<I, St, F> {\n        Scan { iter: iter, f: f, state: state }\n    }\n}\n\nimpl<B, I: Iterator, St, F: FnMut(&mut St, I::Item) -> Option<B>> Iterator for Scan<I, St, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        let x = self.iter.next()?;\n        (self.f)(&mut self.state, x)\n    }\n}\n\n// Iterator::cycle's: again and again.\n#[derive(Clone)]\npub struct Cycle<I> {\n    orig: I,\n    iter: I,\n}\n\nimpl<I: Clone> Cycle<I> {\n    pub(crate) fn new(iter: I) -> Cycle<I> {\n        Cycle { orig: iter.clone(), iter: iter }\n    }\n}\n\nimpl<I: Clone + Iterator> Iterator for Cycle<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match self.iter.next() {\n            Option::None => {\n                self.iter = self.orig.clone();\n                self.iter.next()\n            }\n            y => y,\n        }\n    }\n\n    // Empty, or without end (Rust's).\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        match self.orig.size_hint() {\n            (0, Option::Some(0)) => (0, Option::Some(0)),\n            (0, _) => (0, Option::None),\n            _ => (usize::MAX, Option::None),\n        }\n    }\n}\n// ---- end mod std::iter::adapters ----\n}\n// ---- mod std::iter::sources ----\nmod sources {\n// EDITION: rust\n// The iterator sources: iterators made from nothing, one value, a value\n// again and again, or a closure.\n\nuse crate::clone::Clone;\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator, Zip};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\n\n// No items.\n#[effects()]\npub fn empty<T>() -> Empty<T> {\n    Empty { marker: PhantomData }\n}\n\npub struct Empty<T> {\n");
    buf_str(out, c"    marker: PhantomData<T>,\n}\n\nimpl<T> Iterator for Empty<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        Option::None\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, Option::Some(0))\n    }\n}\n\nimpl<T> DoubleEndedIterator for Empty<T> {\n    fn next_back(&mut self) -> Option<T> {\n        Option::None\n    }\n}\n\n// One item.\n#[effects()]\npub fn once<T>(value: T) -> Once<T> {\n    Once { value: Option::Some(value) }\n}\n\npub struct Once<T> {\n    value: Option<T>,\n}\n\nimpl<T> Iterator for Once<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.value.take()\n    }\n}\n\nimpl<T> DoubleEndedIterator for Once<T> {\n    fn next_back(&mut self) -> Option<T> {\n        self.value.take()\n    }\n}\n\n// Clones of value, for ever (`.take(n)`).\n#[effects()]\npub fn repeat<T: Clone>(value: T) -> Repeat<T> {\n    Repeat { value: value }\n}\n\n#[derive(Clone)]\npub struct Repeat<T> {\n    value: T,\n}\n\nimpl<T: Clone> Iterator for Repeat<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        Option::Some(self.value.clone())\n    }\n}\n\n// n clones of value (the last one the value itself).\n#[effects()]\npub fn repeat_n<T: Clone>(value: T, n: usize) -> RepeatN<T> {\n    RepeatN { value: if n == 0 { Option::None } else { Option::Some(value) }, left: n }\n}\n\n#[derive(Clone)]\npub struct RepeatN<T> {\n    value: Option<T>,\n    left: usize,\n}\n\nimpl<T: Clone> Iterator for RepeatN<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.left == 0 {\n            return Option::None;\n        }\n        self.left -= 1;\n        if self.left == 0 { self.value.take() } else { self.value.clone() }\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.left, Option::Some(self.left))\n    }\n}\n\nimpl<T: Clone> ExactSizeIterator for RepeatN<T> {}\n\n// f's values until it gives None.\n#[effects()]\n");
    buf_str(out, c"pub fn from_fn<T, F: FnMut() -> Option<T>>(f: F) -> FromFn<F> {\n    FromFn { f: f }\n}\n\n#[derive(Clone)]\npub struct FromFn<F> {\n    f: F,\n}\n\nimpl<T, F: FnMut() -> Option<T>> Iterator for FromFn<F> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        (self.f)()\n    }\n}\n\n// first, then succ of each item, until succ gives None.\n#[effects()]\npub fn successors<T, F: FnMut(&T) -> Option<T>>(first: Option<T>, succ: F) -> Successors<T, F> {\n    Successors { next: first, succ: succ }\n}\n\n#[derive(Clone)]\npub struct Successors<T, F> {\n    next: Option<T>,\n    succ: F,\n}\n\nimpl<T, F: FnMut(&T) -> Option<T>> Iterator for Successors<T, F> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let item = self.next.take()?;\n        self.next = (self.succ)(&item);\n        Option::Some(item)\n    }\n}\n\n// The pairs of a's and b's items (`zip(&xs, &ys)`).\n#[effects(A, B)]\npub fn zip<A: IntoIterator, B: IntoIterator>(a: A, b: B) -> Zip<A::IntoIter, B::IntoIter> {\n    a.into_iter().zip(b)\n}\n// ---- end mod std::iter::sources ----\n}\n// ---- end mod std::iter ----\n}\n// ---- mod std::fmt ----\npub mod fmt {\n// EDITION: rust\n// std::fmt: Display, Debug, Formatter<'a>, fmt::Write, and the print\n// functions. Rust's shape (`fn fmt(&self, f: &mut Formatter<'_>) ->\n// fmt::Result`), with two differences that come from having no `dyn`\n// (plan §3): a Formatter is one concrete type over an erased sink (a data\n// pointer and a write function, as AnyAlloc erases an allocator), not a\n// `&mut dyn Write`, so a Debug impl is compiled once, not once per sink;\n// and the builders' `field` and `entry` are generic over the value's type\n// instead of taking a `&dyn Debug`. There are no macros: a format literal\n// at a `T: Display` parameter (`println(\"{x} {y:>5}\")`, `format_in(\"{n}\",\n// a)`) is checked by the compiler and made a value that displays it\n");
    buf_str(out, c"// (`edition.later: format_fns`); `write(w, \"..\")` and `writeln` are the\n// compiler's for `w.write_fmt(\"..\")`, fmt::Write's or io::Write's.\n\nuse crate::alloc::Allocator;\nuse crate::iter::IntoIterator;\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::string::String;\n\n// What fmt returns: Err when the sink failed (a closed pipe), not when\n// the value cannot be shown.\npub type Result = crate::result::Result<(), Error>;\n\n// A sink's failure. It carries nothing: the sink knows why.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]\npub struct Error;\n\n// How a value shows to a user: `{x}`.\n// std2: changed: fmt(&self, &mut Formatter) -> Result (MVS: fmt(self, inout Fmt))\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Display {\n    // std2: changed: takes &self and a Formatter, returns a Result\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// How a value shows to a programmer: `{x:?}`, `{x:#?}` (pretty).\n// std2: changed: fmt(&self, &mut Formatter) -> Result (MVS: fmt_debug(self, inout Fmt))\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Debug {\n    // mvs: Debug::fmt_debug\n    // std2: renamed\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:x}`: lower-case hexadecimal (integers' impls built in, as each of\n// these traits'; bodies in 0.27.2).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait LowerHex {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:X}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait UpperHex {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:o}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Octal {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:b}`.\n");
    buf_str(out, c"#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Binary {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:e}`: floats in scientific notation.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait LowerExp {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:E}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait UpperExp {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{p:p}`: a pointer's address.\npub trait Pointer {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// A sink of text: what `write(w, \"..\")` writes into when w is a String\n// (or any type that implements it). Never fails for a String.\npub trait Write {\n    fn write_str(&mut self, s: &str) -> Result;\n\n    fn write_char(&mut self, c: char) -> Result {\n        self.write_str(c.encode_utf8(&mut [0u8; 4]))\n    }\n\n    // x written as its Display shows it (a format literal: the compiler's\n    // `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result {\n        let mut f = Formatter::new(self);\n        crate::fmt::Display::fmt(&x, &mut f)\n    }\n}\n\n// A Formatter is a sink of text too (Rust's `impl Write for Formatter`):\n// `write(f, \"..\")` in a Display impl writes through it.\nimpl<'a> Write for Formatter<'a> {\n    fn write_str(&mut self, s: &str) -> Result {\n        Formatter::write_str(self, s)\n    }\n}\n\n// A reference displays and debugs as what it refers to.\nimpl<T: Display + ?Sized> Display for &T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Display::fmt(&**self, f)\n    }\n}\n\nimpl<T: Debug + ?Sized> Debug for &T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Debug::fmt(&**self, f)\n    }\n}\n\nimpl<T: Display + ?Sized> Display for &mut T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Display::fmt(&**self, f)\n    }\n}\n\n");
    buf_str(out, c"impl<T: Debug + ?Sized> Debug for &mut T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Debug::fmt(&**self, f)\n    }\n}\n\nimpl Debug for () {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        f.pad(\"()\")\n    }\n}\n\n// Tuples debug as Rust's do: `(1, \"a\")`, a one-tuple `(1,)` (core's\n// tuple impls, up to 12 elements).\n// std2: new\nimpl<A: Debug> Debug for (A,) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug> Debug for (A, B) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug> Debug for (A, B, C) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug> Debug for (A, B, C, D) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug> Debug for (A, B, C, D, E) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug> Debug for (A, B, C, D, E, F) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n");
    buf_str(out, c"        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug> Debug for (A, B, C, D, E,\n    F, G) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug> Debug for (A,\n    B, C, D, E, F, G, H) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug,\n    I: Debug> Debug for (A, B, C, D, E, F, G, H, I) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug, I: Debug,\n    J: Debug> Debug for (A, B, C, D, E, F, G, H, I, J) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n");
    buf_str(out, c"        t.field(&self.8);\n        t.field(&self.9);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug, I: Debug,\n    J: Debug, K: Debug> Debug for (A, B, C, D, E, F, G, H, I, J, K) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.field(&self.9);\n        t.field(&self.10);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug, I: Debug,\n    J: Debug, K: Debug, L: Debug> Debug for (A, B, C, D, E, F, G, H, I, J, K, L) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.field(&self.9);\n        t.field(&self.10);\n        t.field(&self.11);\n        t.finish()\n    }\n}\n\n// Where a padded value sits in its width.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Alignment {\n    Left,\n    Right,\n    Center,\n}\n\n// What a value is written into, with its hole's spec ({:>8.3}): the sink\n// erased (no dyn), the width, precision, fill, alignment and flags.\n// Its fill is a char (`edition.later: char`).\n// mvs: Fmt\n// std2: renamed\n// later: char\npub struct Formatter<'a> {\n    out: *mut u8,\n    write: fn(*mut u8, &str) -> Result,\n    width: Option<usize>,\n    precision: Option<usize>,\n    fill: char,\n    align: Option<Alignment>,\n    flags: u32,\n    // a write failed: every later one fails too, so the last write of a\n");
    buf_str(out, c"    // format literal (`write(w, ..)`'s value) reports an earlier error,\n    // as Rust's write! stops at the first\n    failed: bool,\n    marker: PhantomData<&'a mut ()>,\n}\n\nimpl<'a> Formatter<'a> {\n    // A Formatter over any fmt::Write, with an empty spec (what\n    // `write(w, ..)` makes).\n    // What a Formatter writes is its maker's effect (E4.3a): W's write_str.\n    #[effects(W)]\n    pub fn new<W: Write>(w: &'a mut W) -> Formatter<'a> {\n        Formatter {\n            out: w as *mut W as *mut u8,\n            write: write_erased::<W>,\n            width: Option::None,\n            precision: Option::None,\n            fill: ' ',\n            align: Option::None,\n            flags: 0,\n            failed: false,\n            marker: PhantomData {},\n        }\n    }\n\n    // s, as it is (no padding).\n    // mvs: Fmt::str\n    // std2: renamed\n    #[effects()]\n    pub fn write_str(&mut self, s: &str) -> Result {\n        if self.failed {\n            return crate::result::Result::Err(Error);\n        }\n        let r = (self.write)(self.out, s);\n        if r.is_err() {\n            self.failed = true;\n        }\n        r\n    }\n\n    // mvs: Fmt::byte\n    // std2: renamed\n    #[effects(panic)]\n    pub fn write_char(&mut self, c: char) -> Result {\n        self.write_str(c.encode_utf8(&mut [0u8; 4]))\n    }\n\n    // x as its Display shows it (a format literal inside a Display impl:\n    // `write(f, \"({x}, {y})\")`).\n    // mvs: Fmt::write, Fmt::display, Fmt::debug\n    // std2: renamed\n    #[effects(T)]\n    pub fn write_fmt<T: Display>(&mut self, x: T) -> Result {\n        crate::fmt::Display::fmt(&x, self)\n    }\n\n    // s padded to the width with the fill, as the alignment says (Left by\n    // default), and cut to the precision: what str's Display does.\n    #[effects(panic, diverge)]\n    pub fn pad(&mut self, s: &str) -> Result {\n        // (0.28.0: a hole with no width and no precision, the most, writes\n");
    buf_str(out, c"        // s as it is; the rest out of line, so that a format literal's\n        // closure holds a write per hole and not pad's every case)\n        if self.width.is_none() && self.precision.is_none() {\n            return self.write_str(s);\n        }\n        self.pad_spec(s)\n    }\n\n    #[inline(never)]\n    fn pad_spec(&mut self, s: &str) -> Result {\n        let s = match self.precision {\n            Option::Some(p) => match s.char_indices().nth(p) {\n                Option::Some((i, _)) => &s[..i],\n                Option::None => s,\n            },\n            Option::None => s,\n        };\n        match self.width {\n            Option::Some(w) => {\n                let n = s.chars().count();\n                if n >= w {\n                    return self.write_str(s);\n                }\n                let (pre, post) = self.padding(w - n, Alignment::Left);\n                self.write_fill(pre)?;\n                self.write_str(s)?;\n                self.write_fill(post)\n            }\n            Option::None => self.write_str(s),\n        }\n    }\n\n    // An integer's digits, padded: the sign, `#`'s prefix, `0`'s zeros.\n    #[effects(panic, diverge)]\n    pub fn pad_integral(&mut self, is_nonnegative: bool, prefix: &str, digits: &str) -> Result {\n        let mut width = digits.len();\n        let sign: &str = if !is_nonnegative {\n            \"-\"\n        } else if self.sign_plus() {\n            \"+\"\n        } else {\n            \"\"\n        };\n        width += sign.len();\n        let prefix: &str = if self.alternate() { prefix } else { \"\" };\n        width += prefix.chars().count();\n        let min = match self.width {\n            Option::Some(min) => min,\n            Option::None => 0,\n        };\n        if width >= min {\n            self.write_str(sign)?;\n            self.write_str(prefix)?;\n            return self.write_str(digits);\n        }\n        if self.sign_aware_zero_pad() {\n");
    buf_str(out, c"            // `0`: the zeros go after the sign and the prefix, whatever\n            // the fill and the alignment.\n            self.write_str(sign)?;\n            self.write_str(prefix)?;\n            for _ in 0..min - width {\n                self.write_str(\"0\")?;\n            }\n            return self.write_str(digits);\n        }\n        let (pre, post) = self.padding(min - width, Alignment::Right);\n        self.write_fill(pre)?;\n        self.write_str(sign)?;\n        self.write_str(prefix)?;\n        self.write_str(digits)?;\n        self.write_fill(post)\n    }\n\n    // The hole's spec, which the compiler's lowering of a format literal\n    // sets before the value's fmt and clears after (`{:>8.3}`, `{:#?}`,\n    // `{:+}`, `{:*^9}`): a width and a precision (< 0: none), the fill (a\n    // code point), the alignment (0: none, 1: left, 2: right, 3: center)\n    // and the flags (1 `+`, 4 `#`, 8 `0`). Not Rust's: its macros set\n    // them through format_args's private Arguments.\n    #[effects()]\n    pub fn __spec(&mut self, width: i64, precision: i64, fill: u32, align: i64, flags: u32) {\n        self.width = if width < 0 { Option::None } else { Option::Some(width as usize) };\n        self.precision = if precision < 0 { Option::None }\n            else { Option::Some(precision as usize) };\n        self.fill = match char::from_u32(fill) {\n            Option::Some(c) => c,\n            Option::None => ' ',\n        };\n        self.align = if align == 1 { Option::Some(Alignment::Left) }\n            else if align == 2 { Option::Some(Alignment::Right) }\n            else if align == 3 { Option::Some(Alignment::Center) }\n            else { Option::None };\n        self.flags = flags;\n    }\n\n    // The hole's width ({:8}), its precision ({:.3}), its fill ({:*^8}),\n    // its alignment, its flags.\n    #[effects()]\n    pub fn width(&self) -> Option<usize> {\n        self.width\n    }\n\n    #[effects()]\n");
    buf_str(out, c"    pub fn precision(&self) -> Option<usize> {\n        self.precision\n    }\n\n    #[effects()]\n    pub fn fill(&self) -> char {\n        self.fill\n    }\n\n    #[effects()]\n    pub fn align(&self) -> Option<Alignment> {\n        self.align\n    }\n\n    // `#`: Debug's pretty form, `0x` for hex.\n    #[effects()]\n    pub fn alternate(&self) -> bool {\n        self.flags & 4 != 0\n    }\n\n    // `+`.\n    #[effects()]\n    pub fn sign_plus(&self) -> bool {\n        self.flags & 1 != 0\n    }\n\n    // `-`.\n    #[effects()]\n    pub fn sign_minus(&self) -> bool {\n        self.flags & 2 != 0\n    }\n\n    // `0`.\n    #[effects()]\n    pub fn sign_aware_zero_pad(&self) -> bool {\n        self.flags & 8 != 0\n    }\n\n    // pad's fill: the pad fills before and after a value for this\n    // alignment (default when the hole gives none).\n    fn padding(&self, pad: usize, default: Alignment) -> (usize, usize) {\n        let align = match self.align {\n            Option::Some(a) => a,\n            Option::None => default,\n        };\n        match align {\n            Alignment::Left => (0, pad),\n            Alignment::Right => (pad, 0),\n            Alignment::Center => (pad / 2, (pad + 1) / 2),\n        }\n    }\n\n    // n fill chars.\n    fn write_fill(&mut self, n: usize) -> Result {\n        for _ in 0..n {\n            self.write_char(self.fill)?;\n        }\n        Result::Ok(())\n    }\n\n    // The hole's spec, to give a Formatter over another sink (the pretty\n    // builders' PadAdapter), and taking it.\n    fn spec(&self) -> (Option<usize>, Option<usize>, char, Option<Alignment>, u32) {\n        (self.width, self.precision, self.fill, self.align, self.flags)\n    }\n\n    fn set_spec(&mut self, spec: (Option<usize>, Option<usize>, char, Option<Alignment>, u32)) {\n        let (width, precision, fill, align, flags) = spec;\n        self.width = width;\n        self.precision = precision;\n        self.fill = fill;\n        self.align = align;\n");
    buf_str(out, c"        self.flags = flags;\n    }\n\n    // `Name { a: 1, b: 2 }`, field by field.\n    #[effects()]\n    pub fn debug_struct<'b>(&'b mut self, name: &str) -> DebugStruct<'b, 'a> {\n        let result = self.write_str(name);\n        DebugStruct { fmt: self, result: result, has_fields: false }\n    }\n\n    // `Name(1, 2)`.\n    #[effects()]\n    pub fn debug_tuple<'b>(&'b mut self, name: &str) -> DebugTuple<'b, 'a> {\n        let result = self.write_str(name);\n        DebugTuple { fmt: self, result: result, fields: 0, empty_name: name.is_empty() }\n    }\n\n    // `[1, 2]`.\n    // mvs: debug_list, Fmt::debug_slice\n    // std2: changed: a builder (MVS: debug_list(f, s) of a slice)\n    #[effects()]\n    pub fn debug_list<'b>(&'b mut self) -> DebugList<'b, 'a> {\n        let result = self.write_str(\"[\");\n        DebugList { fmt: self, result: result, has_entries: false }\n    }\n\n    // `{1, 2}`.\n    #[effects()]\n    pub fn debug_set<'b>(&'b mut self) -> DebugSet<'b, 'a> {\n        let result = self.write_str(\"{\");\n        DebugSet { fmt: self, result: result, has_entries: false }\n    }\n\n    // `{k: v, ...}`.\n    #[effects()]\n    pub fn debug_map<'b>(&'b mut self) -> DebugMap<'b, 'a> {\n        let result = self.write_str(\"{\");\n        DebugMap { fmt: self, result: result, has_entries: false, has_key: false }\n    }\n}\n\n// Formatter::debug_struct's builder.\npub struct DebugStruct<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_fields: bool,\n}\n\nimpl<'a, 'b> DebugStruct<'a, 'b> {\n    #[effects(T)]\n    pub fn field<T: Debug + ?Sized>(&mut self, name: &str, value: &T) -> &mut DebugStruct<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = if self.fmt.alternate() {\n                write_pretty(self.fmt, if self.has_fields { \"\" } else { \" {\\n\" },\n                    Option::Some(name), value)\n            } else {\n");
    buf_str(out, c"                write_plain(self.fmt, if self.has_fields { \", \" } else { \" { \" },\n                    Option::Some(name), value)\n            };\n        }\n        self.has_fields = true;\n        self\n    }\n\n    // `Name { a: 1, .. }`.\n    #[effects()]\n    pub fn finish_non_exhaustive(&mut self) -> Result {\n        if self.result.is_ok() {\n            self.result = if !self.has_fields {\n                self.fmt.write_str(\" { .. }\")\n            } else if self.fmt.alternate() {\n                self.fmt.write_str(\"    ..\\n}\")\n            } else {\n                self.fmt.write_str(\", .. }\")\n            };\n        }\n        self.result\n    }\n\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() && self.has_fields {\n            self.result = self.fmt.write_str(if self.fmt.alternate() { \"}\" } else { \" }\" });\n        }\n        self.result\n    }\n}\n\n// Formatter::debug_tuple's builder.\npub struct DebugTuple<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    fields: usize,\n    empty_name: bool,\n}\n\nimpl<'a, 'b> DebugTuple<'a, 'b> {\n    #[effects(T)]\n    pub fn field<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugTuple<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = if self.fmt.alternate() {\n                write_pretty(self.fmt, if self.fields > 0 { \"\" } else { \"(\\n\" }, Option::None,\n                    value)\n            } else {\n                write_plain(self.fmt, if self.fields > 0 { \", \" } else { \"(\" }, Option::None, value)\n            };\n        }\n        self.fields += 1;\n        self\n    }\n\n    // `(x,)` for a one-field tuple with no name, as Rust's.\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() && self.fields > 0 {\n            if self.fields == 1 && self.empty_name && !self.fmt.alternate() {\n                self.result = self.fmt.write_str(\",\");\n            }\n");
    buf_str(out, c"            if self.result.is_ok() {\n                self.result = self.fmt.write_str(\")\");\n            }\n        }\n        self.result\n    }\n}\n\n// The entries of a list or a set: `[a, b]`, `{a, b}`; pretty, one a line.\nfn write_entry<T: Debug + ?Sized>(f: &mut Formatter<'_>, has_entries: bool, value: &T) -> Result {\n    if f.alternate() {\n        write_pretty(f, if has_entries { \"\" } else { \"\\n\" }, Option::None, value)\n    } else {\n        write_plain(f, if has_entries { \", \" } else { \"\" }, Option::None, value)\n    }\n}\n\n// Formatter::debug_list's builder.\npub struct DebugList<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugList<'a, 'b> {\n    #[effects(T)]\n    pub fn entry<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugList<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = write_entry(self.fmt, self.has_entries, value);\n        }\n        self.has_entries = true;\n        self\n    }\n\n    #[effects(D, I)]\n    pub fn entries<D: Debug, I: IntoIterator<Item = D>>(&mut self, entries: I) -> &mut DebugList<'a,\n        'b> {\n        for e in entries {\n            self.entry(&e);\n        }\n        self\n    }\n\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() {\n            self.result = self.fmt.write_str(\"]\");\n        }\n        self.result\n    }\n}\n\n// Formatter::debug_set's builder.\npub struct DebugSet<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugSet<'a, 'b> {\n    #[effects(T)]\n    pub fn entry<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugSet<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = write_entry(self.fmt, self.has_entries, value);\n        }\n        self.has_entries = true;\n        self\n    }\n\n    #[effects(diverge, D, I)]\n");
    buf_str(out, c"    pub fn entries<D: Debug, I: IntoIterator<Item = D>>(&mut self, entries: I) -> &mut DebugSet<'a,\n        'b> {\n        for e in entries {\n            self.entry(&e);\n        }\n        self\n    }\n\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() {\n            self.result = self.fmt.write_str(\"}\");\n        }\n        self.result\n    }\n}\n\n// Formatter::debug_map's builder.\npub struct DebugMap<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n    has_key: bool,\n}\n\nimpl<'a, 'b> DebugMap<'a, 'b> {\n    #[effects(K, V)]\n    pub fn entry<K: Debug + ?Sized,\n        V: Debug + ?Sized>(&mut self, key: &K, value: &V) -> &mut DebugMap<'a, 'b> {\n        self.key(key).value(value)\n    }\n\n    // The key of an entry whose value comes next (`value`); panics when a\n    // key is waiting for its value.\n    #[effects(panic, K)]\n    pub fn key<K: Debug + ?Sized>(&mut self, key: &K) -> &mut DebugMap<'a, 'b> {\n        if self.has_key {\n            let msg: &str = \"attempted to begin a new map entry without completing the previous one\";\n            crate::panic::panic(msg);\n        }\n        if self.result.is_ok() {\n            self.result = write_key(self.fmt, self.has_entries, key);\n        }\n        self.has_key = true;\n        self\n    }\n\n    // The value of the entry `key` began; panics when there is no key.\n    #[effects(panic, V)]\n    pub fn value<V: Debug + ?Sized>(&mut self, value: &V) -> &mut DebugMap<'a, 'b> {\n        if !self.has_key {\n            let msg: &str = \"attempted to format a map value before its key\";\n            crate::panic::panic(msg);\n        }\n        if self.result.is_ok() {\n            self.result = write_value(self.fmt, value);\n        }\n        self.has_key = false;\n        self.has_entries = true;\n        self\n    }\n\n    #[effects(diverge, K, V, I)]\n    pub fn entries<K: Debug, V: Debug,\n");
    buf_str(out, c"        I: IntoIterator<Item = (K, V)>>(&mut self, entries: I) -> &mut DebugMap<'a, 'b> {\n        for (k, v) in entries {\n            self.entry(&k, &v);\n        }\n        self\n    }\n\n    // Panics when a key is waiting for its value.\n    #[effects(panic)]\n    pub fn finish(&mut self) -> Result {\n        if self.has_key {\n            let msg: &str = \"attempted to finish a map with a partial entry\";\n            crate::panic::panic(msg);\n        }\n        if self.result.is_ok() {\n            self.result = self.fmt.write_str(\"}\");\n        }\n        self.result\n    }\n}\n\n// A map's key: `k: `, after a comma or (pretty) on a line of its own.\nfn write_key<K: Debug + ?Sized>(f: &mut Formatter<'_>, has_entries: bool, key: &K) -> Result {\n    if f.alternate() {\n        if !has_entries {\n            f.write_str(\"\\n\")?;\n        }\n        write_padded(f, true, key)?;\n    } else {\n        write_plain(f, if has_entries { \", \" } else { \"\" }, Option::None, key)?;\n    }\n    f.write_str(\": \")\n}\n\n// A map's value, after its key (pretty: ending the line).\nfn write_value<V: Debug + ?Sized>(f: &mut Formatter<'_>, value: &V) -> Result {\n    if f.alternate() {\n        write_padded(f, false, value)?;\n        f.write_str(\",\\n\")\n    } else {\n        crate::fmt::Debug::fmt(value, f)\n    }\n}\n\n// The builders' plain form: prefix, `name: ` when there is a name, and\n// the value's Debug.\nfn write_plain<T: Debug + ?Sized>(f: &mut Formatter<'_>, prefix: &str, name: Option<&str>,\n    value: &T) -> Result {\n    f.write_str(prefix)?;\n    if let Option::Some(n) = name {\n        f.write_str(n)?;\n        f.write_str(\": \")?;\n    }\n    crate::fmt::Debug::fmt(value, f)\n}\n\n// The builders' pretty form (`{:#?}`): open (the first entry's bracket),\n// then `name: value,` on a line of its own, indented one level more than f's.\nfn write_pretty<T: Debug + ?Sized>(f: &mut Formatter<'_>, open: &str, name: Option<&str>, value: &T) -> Result {\n");
    buf_str(out, c"    f.write_str(open)?;\n    let spec = f.spec();\n    let mut pad = PadAdapter { fmt: f, on_newline: true };\n    let mut inner = Formatter::new(&mut pad);\n    inner.set_spec(spec);\n    if let Option::Some(n) = name {\n        inner.write_str(n)?;\n        inner.write_str(\": \")?;\n    }\n    crate::fmt::Debug::fmt(value, &mut inner)?;\n    inner.write_str(\",\\n\")\n}\n\n// value's Debug indented one level more than f's (a map's key, then its\n// value: on_newline is true at a line's start only).\nfn write_padded<T: Debug + ?Sized>(f: &mut Formatter<'_>, on_newline: bool, value: &T) -> Result {\n    let spec = f.spec();\n    let mut pad = PadAdapter { fmt: f, on_newline: on_newline };\n    let mut inner = Formatter::new(&mut pad);\n    inner.set_spec(spec);\n    crate::fmt::Debug::fmt(value, &mut inner)\n}\n\n// A sink that indents every line written through it by four spaces: what\n// the pretty builders write a nested value into.\nstruct PadAdapter<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    on_newline: bool,\n}\n\nimpl<'a, 'b> Write for PadAdapter<'a, 'b> {\n    fn write_str(&mut self, s: &str) -> Result {\n        let mut rest = s;\n        while !rest.is_empty() {\n            if self.on_newline {\n                self.fmt.write_str(\"    \")?;\n            }\n            let nl: &str = \"\\n\";\n            let n = match rest.find(nl) {\n                Option::Some(i) => i + 1,\n                Option::None => rest.len(),\n            };\n            let (line, tail) = rest.split_at(n);\n            self.on_newline = line.ends_with(nl);\n            self.fmt.write_str(line)?;\n            rest = tail;\n        }\n        Result::Ok(())\n    }\n}\n\n// Formatter::new's write function for a W: out is the &mut W it erased.\nfn write_erased<W: Write>(out: *mut u8, s: &str) -> Result {\n    // UNSAFE: the sink is erased to a data pointer (no dyn: plan §3), so\n    // it is read back through a raw pointer.\n");
    buf_str(out, c"    // SAFETY: out is the `&'a mut W` Formatter::new took, cast; the\n    // Formatter<'a> holding it keeps that borrow alive and is its only\n    // user, so the &mut is valid and unaliased for this call.\n    let w = unsafe { &mut *(out as *mut W) };\n    w.write_str(s)\n}\n\n// ---- The print functions (Rust's macros) ----\n\n// x on stdout (`print(\"{x}\")`); stdout is line-buffered when a terminal.\n// later: format_fns\n#[effects(panic, T)]\npub fn print<T: Display>(x: T) {\n    let mut out = crate::io::stdout();\n    if crate::io::Write::write_fmt(&mut out, x).is_err() {\n        let msg: &str = \"failed printing to stdout\";\n        crate::panic::panic(msg);\n    }\n}\n\n// x and a newline on stdout.\n// later: format_fns\n#[effects(io, static, panic, diverge, T)]\npub fn println<T: Display>(x: T) {\n    let mut out = crate::io::stdout();\n    if crate::io::Write::write_fmt(&mut out, x).is_err()\n        || crate::io::Write::write_all(&mut out, \"\\n\".as_bytes()).is_err()\n        {\n        let msg: &str = \"failed printing to stdout\";\n        crate::panic::panic(msg);\n    }\n}\n\n// x on stderr.\n// later: format_fns\n#[effects(panic, T)]\npub fn eprint<T: Display>(x: T) {\n    let mut out = crate::io::stderr();\n    if crate::io::Write::write_fmt(&mut out, x).is_err() {\n        let msg: &str = \"failed printing to stderr\";\n        crate::panic::panic(msg);\n    }\n}\n\n// later: format_fns\n#[effects(io, static, panic, diverge, T)]\npub fn eprintln<T: Display>(x: T) {\n    let mut out = crate::io::stderr();\n    if crate::io::Write::write_fmt(&mut out, x).is_err()\n        || crate::io::Write::write_all(&mut out, \"\\n\".as_bytes()).is_err()\n        {\n        let msg: &str = \"failed printing to stderr\";\n        crate::panic::panic(msg);\n    }\n}\n\n// x as a String on a (Rust's `format!`, allocator last: plan §2).\n// std2: changed: takes x by value and the allocator\n// later: format_fns\n#[effects(T, A)]\n");
    buf_str(out, c"pub fn format_in<T: Display, A: Allocator>(x: T, a: A) -> String<A> {\n    let mut s = String::new_in(a);\n    let _ = s.write_fmt(x);\n    s\n}\n\n// x written into w (Rust's `write!(w, ..)`: `write(f, \"({}, {})\", a, b)`\n// in a Display impl, `write(s, \"{x}\")` into a String): the compiler makes\n// the format literal x's Display value, as print's (F16.1). An io::Write\n// writer comes in 0.27.3 (its write_fmt).\n// later: format_fns\n#[effects(W, T)]\npub fn write<W: Write + ?Sized, T: Display>(w: &mut W, x: T) -> Result {\n    w.write_fmt(x)\n}\n\n// x and a newline written into w (Rust's `writeln!`).\n// later: format_fns\n#[effects(W, T)]\npub fn writeln<W: Write + ?Sized, T: Display>(w: &mut W, x: T) -> Result {\n    match w.write_fmt(x) {\n        Result::Ok(()) => w.write_str(\"\\n\"),\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\n// A format literal as a value (`format_args(\"{a}-{b}\").to_string_in(gpa)`):\n// the literal's Display value, passed through.\n// later: format_fns\n#[effects()]\npub fn format_args<T: Display>(x: T) -> T {\n    x\n}\n// ---- end mod std::fmt ----\n}\n// ---- mod std::flt ----\nmod flt {\n// EDITION: rust\n// std2: new: the floats' digits, for their Display, Debug, LowerExp and\n// UpperExp and their FromStr (front-rust.md F15.5; the compiler's builtin\n// impls call these). Exact: a float's value is m * 2^e, and its digits\n// are found with big integers (Steele and White's free format and an exact\n// division, as Rust's flt2dec Dragon fallback), so `{}` gives the shortest\n// digits that read back as the same float, `{:.N}` and `{:.Ne}` round the\n// exact value half to even, and parsing rounds to the nearest float.\n// Not Rust's: no Grisu fast path (a few big-integer steps per digit).\n\nuse crate::fmt::{Alignment, Formatter, Result};\n\n// A big unsigned integer: base 2^32 limbs, least significant first.\n// 160 limbs hold 5120 bits: an f64's exact value scaled by 10^k, and a\n");
    buf_str(out, c"// parse's 781 digits by its power of ten, are less than 4000.\nstruct Big {\n    d: [u32; 160],\n    n: usize,\n}\n\nimpl Big {\n    fn from_u64(v: u64) -> Big {\n        let mut b = Big { d: [0u32; 160], n: 0 };\n        b.d[0] = v as u32;\n        b.d[1] = (v >> 32) as u32;\n        b.n = 2;\n        b.trim();\n        b\n    }\n\n    fn copy(&self) -> Big {\n        let mut b = Big { d: [0u32; 160], n: self.n };\n        let mut i: usize = 0;\n        while i < self.n {\n            b.d[i] = self.d[i];\n            i += 1;\n        }\n        b\n    }\n\n    fn trim(&mut self) {\n        while self.n > 0 && self.d[self.n - 1] == 0 {\n            self.n -= 1;\n        }\n    }\n\n    fn is_zero(&self) -> bool {\n        self.n == 0\n    }\n\n    fn bits(&self) -> usize {\n        if self.n == 0 {\n            return 0;\n        }\n        let mut top = self.d[self.n - 1];\n        let mut b: usize = (self.n - 1) * 32;\n        while top != 0 {\n            b += 1;\n            top = top >> 1;\n        }\n        b\n    }\n\n    fn mul_small(&mut self, m: u32) {\n        let mut carry: u64 = 0;\n        let mut i: usize = 0;\n        while i < self.n {\n            let t = (self.d[i] as u64) * (m as u64) + carry;\n            self.d[i] = t as u32;\n            carry = t >> 32;\n            i += 1;\n        }\n        if carry != 0 {\n            self.d[self.n] = carry as u32;\n            self.n += 1;\n        }\n    }\n\n    fn add_small(&mut self, a: u32) {\n        let mut carry: u64 = a as u64;\n        let mut i: usize = 0;\n        while carry != 0 {\n            if i == self.n {\n                self.d[i] = 0;\n                self.n += 1;\n            }\n            let t = (self.d[i] as u64) + carry;\n            self.d[i] = t as u32;\n            carry = t >> 32;\n            i += 1;\n        }\n    }\n\n    fn mul_pow10(&mut self, k: usize) {\n        let mut k = k;\n        while k >= 9 {\n            self.mul_small(1000000000);\n            k -= 9;\n");
    buf_str(out, c"        }\n        let mut m: u32 = 1;\n        while k > 0 {\n            m = m * 10;\n            k -= 1;\n        }\n        if m != 1 {\n            self.mul_small(m);\n        }\n    }\n\n    fn shl(&mut self, s: usize) {\n        if self.n == 0 || s == 0 {\n            return;\n        }\n        let words = s / 32;\n        let bits = s % 32;\n        let mut i = self.n;\n        // the top limb's spill, then each limb from the top down\n        self.d[self.n + words] = 0;\n        while i > 0 {\n            i -= 1;\n            let v = self.d[i] as u64;\n            let hi = ((v << bits) >> 32) as u32;\n            self.d[i + words + 1] = self.d[i + words + 1] | hi;\n            self.d[i + words] = (v << bits) as u32;\n        }\n        let mut j: usize = 0;\n        while j < words {\n            self.d[j] = 0;\n            j += 1;\n        }\n        self.n = self.n + words + 1;\n        self.trim();\n    }\n\n    fn shr1(&mut self) {\n        let mut i: usize = 0;\n        while i < self.n {\n            let hi: u32 = if i + 1 < self.n { self.d[i + 1] << 31 } else { 0 };\n            self.d[i] = (self.d[i] >> 1) | hi;\n            i += 1;\n        }\n        self.trim();\n    }\n\n    // -1, 0 or 1 as self is less than, equal to or greater than o.\n    fn cmp(&self, o: &Big) -> i32 {\n        if self.n != o.n {\n            return if self.n < o.n { -1 } else { 1 };\n        }\n        let mut i = self.n;\n        while i > 0 {\n            i -= 1;\n            if self.d[i] != o.d[i] {\n                return if self.d[i] < o.d[i] { -1 } else { 1 };\n            }\n        }\n        0\n    }\n\n    fn add(&mut self, o: &Big) {\n        let n = if self.n > o.n { self.n } else { o.n };\n        let mut carry: u64 = 0;\n        let mut i: usize = 0;\n        while i < n {\n            let a: u64 = if i < self.n { self.d[i] as u64 } else { 0 };\n            let b: u64 = if i < o.n { o.d[i] as u64 } else { 0 };\n            let t = a + b + carry;\n");
    buf_str(out, c"            self.d[i] = t as u32;\n            carry = t >> 32;\n            i += 1;\n        }\n        self.n = n;\n        if carry != 0 {\n            self.d[n] = carry as u32;\n            self.n += 1;\n        }\n    }\n\n    // self - o, o not greater than self.\n    fn sub(&mut self, o: &Big) {\n        let mut borrow: u64 = 0;\n        let mut i: usize = 0;\n        while i < self.n {\n            let a = self.d[i] as u64;\n            let b: u64 = (if i < o.n { o.d[i] as u64 } else { 0 }) + borrow;\n            if a >= b {\n                self.d[i] = (a - b) as u32;\n                borrow = 0;\n            } else {\n                self.d[i] = (a + 4294967296 - b) as u32;\n                borrow = 1;\n            }\n            i += 1;\n        }\n        self.trim();\n    }\n\n    // The next digit of r / s, r < 10 s: the quotient, r left the remainder.\n    fn digit(r: &mut Big, s: &Big) -> u8 {\n        let mut d: u8 = 0;\n        while r.cmp(s) >= 0 {\n            r.sub(s);\n            d += 1;\n        }\n        d\n    }\n}\n\n// -1, 0 or 1 as a + b is less than, equal to or greater than c.\nfn cmp_sum(a: &Big, b: &Big, c: &Big) -> i32 {\n    let mut t = a.copy();\n    t.add(b);\n    t.cmp(c)\n}\n\n// A finite, nonzero v's m and e (v = m * 2^e), for an f64 (53 bits, e at\n// least -1074) or an f32 (24 bits, e at least -149), without its bits:\n// scaling by a power of two is exact for a float of this range.\nfn decompose(v: f64, is32: bool) -> (u64, i32) {\n    let two32: f64 = 4294967296.0;\n    let mut x = v;\n    let mut e: i32 = 0;\n    while x >= 9007199254740992.0 * two32 {\n        x = x / two32;\n        e += 32;\n    }\n    while x >= 9007199254740992.0 {\n        x = x / 2.0;\n        e += 1;\n    }\n    while x < 4503599627370496.0 / two32 {\n        x = x * two32;\n        e -= 32;\n    }\n    while x < 4503599627370496.0 {\n        x = x * 2.0;\n        e -= 1;\n    }\n    let mut m = x as u64;\n");
    buf_str(out, c"    // A subnormal's m has the low bits zero that its exponent cannot show.\n    let (bits_down, min_e): (i32, i32) = if is32 { (29, -149) } else { (0, -1074) };\n    let mut te = e + bits_down;\n    if te < min_e {\n        te = min_e;\n    }\n    m = m >> ((te - e) as u64);\n    (m, te)\n}\n\n// A float as digits: d[..n], the value 0.d1d2.. * 10^k.\nstruct Digits {\n    d: [u8; 1200],\n    n: usize,\n    k: i32,\n}\n\n// The bits a float's mantissa has, and its least exponent.\nfn format_params(is32: bool) -> (u64, i32) {\n    if is32 { (24, -149) } else { (53, -1074) }\n}\n\n// r / s scaled into [1/10, 1): the k with value = r / s * 10^k.\nfn scale(r: &mut Big, s: &mut Big, mp: &mut Big, mm: &mut Big, m: u64, e: i32) -> i32 {\n    // an estimate of ceil(log10(value)), then exact fixups\n    let bitlen: i32 = 64 - (m.leading_zeros() as i32) + e;\n    let mut k: i32 = ((bitlen as i64) * 30103 / 100000) as i32;\n    if k > 0 {\n        s.mul_pow10(k as usize);\n    } else if k < 0 {\n        r.mul_pow10((-k) as usize);\n        mp.mul_pow10((-k) as usize);\n        mm.mul_pow10((-k) as usize);\n    }\n    while r.cmp(s) >= 0 {\n        s.mul_small(10);\n        k += 1;\n    }\n    loop {\n        let mut t = r.copy();\n        t.mul_small(10);\n        if t.cmp(s) >= 0 {\n            break;\n        }\n        r.mul_small(10);\n        mp.mul_small(10);\n        mm.mul_small(10);\n        k -= 1;\n    }\n    k\n}\n\n// The shortest digits that read back as m * 2^e (Steele and White's free\n// format, Burger and Dybvig's fixup): a reader rounds half to even, so the\n// interval's ends count when m is even.\nfn shortest(m: u64, e: i32, is32: bool) -> Digits {\n    let (mbits, min_e) = format_params(is32);\n    let hidden: u64 = 1 << (mbits - 1);\n    let lower_close = m == hidden && e > min_e;\n    let mut r = Big::from_u64(m);\n    let mut s = Big::from_u64(1);\n    let mut mp = Big::from_u64(1);\n    let mut mm = Big::from_u64(1);\n    if e >= 0 {\n");
    buf_str(out, c"        r.shl(e as usize);\n        mp.shl(e as usize);\n        mm.shl(e as usize);\n    } else {\n        s.shl((-e) as usize);\n    }\n    // doubled, so the half gaps are whole: r = 2v, the gaps mp and mm\n    r.shl(1);\n    s.shl(1);\n    if lower_close {\n        // the gap below is half the gap above\n        r.shl(1);\n        s.shl(1);\n        mp.shl(1);\n    }\n    let even = m % 2 == 0;\n    let mut out = Digits { d: [0u8; 1200], n: 0, k: 0 };\n    // k: the least with v + gap below 10^k (counted as the reader would)\n    let bitlen: i32 = 64 - (m.leading_zeros() as i32) + e;\n    let est: i32 = ((bitlen as i64) * 30103 / 100000) as i32;\n    if est > 0 {\n        s.mul_pow10(est as usize);\n    } else if est < 0 {\n        r.mul_pow10((-est) as usize);\n        mp.mul_pow10((-est) as usize);\n        mm.mul_pow10((-est) as usize);\n    }\n    let mut k = est;\n    loop {\n        let c = cmp_sum(&r, &mp, &s);\n        if c > 0 || (c == 0 && even) {\n            s.mul_small(10);\n            k += 1;\n        } else {\n            break;\n        }\n    }\n    loop {\n        let mut t = r.copy();\n        t.add(&mp);\n        t.mul_small(10);\n        let c = t.cmp(&s);\n        if c < 0 || (c == 0 && !even) {\n            r.mul_small(10);\n            mp.mul_small(10);\n            mm.mul_small(10);\n            k -= 1;\n        } else {\n            break;\n        }\n    }\n    out.k = k;\n    loop {\n        r.mul_small(10);\n        mp.mul_small(10);\n        mm.mul_small(10);\n        let mut d = Big::digit(&mut r, &s);\n        let c1 = r.cmp(&mm);\n        let low = c1 < 0 || (c1 == 0 && even);\n        let c2 = cmp_sum(&r, &mp, &s);\n        let high = c2 > 0 || (c2 == 0 && even);\n        if low || high {\n            if high && !low {\n                d += 1;\n            } else if low && high {\n                // both ends reach: the nearer digit, the upper one at a tie\n");
    buf_str(out, c"                // (as Rust's flt2dec: `-235497785839029.625` is `..029.63`)\n                let mut t = r.copy();\n                t.shl(1);\n                if t.cmp(&s) >= 0 {\n                    d += 1;\n                }\n            }\n            out.d[out.n] = d;\n            out.n += 1;\n            return out;\n        }\n        out.d[out.n] = d;\n        out.n += 1;\n    }\n}\n\n// The exact digits of m * 2^e, rounded half to even at a place: with\n// `sig`, to `count` significant digits; else to `count` digits after the\n// point. n may be less (the rest are zeros); a rounding up that carries\n// out of the first digit raises k.\nfn exact(m: u64, e: i32, sig: bool, count: i64) -> Digits {\n    let mut r = Big::from_u64(m);\n    let mut s = Big::from_u64(1);\n    if e >= 0 {\n        r.shl(e as usize);\n    } else {\n        s.shl((-e) as usize);\n    }\n    let mut mp = Big::from_u64(0);\n    let mut mm = Big::from_u64(0);\n    let k = scale(&mut r, &mut s, &mut mp, &mut mm, m, e);\n    let mut out = Digits { d: [0u8; 1200], n: 0, k: k };\n    // the digits wanted: value = 0.d1d2.. * 10^k, so the place 10^-count\n    // is digit k + count\n    let want: i64 = if sig { count } else { (k as i64) + count };\n    if want < 0 {\n        // below half of the last place: zero\n        return out;\n    }\n    let mut i: i64 = 0;\n    while i < want && !r.is_zero() && out.n < 1200 {\n        r.mul_small(10);\n        let d = Big::digit(&mut r, &s);\n        out.d[out.n] = d;\n        out.n += 1;\n        i += 1;\n    }\n    if r.is_zero() || i < want {\n        // exact: nothing left to round (or more digits than the value has)\n        return out;\n    }\n    // round on what is left: r / s against a half\n    r.shl(1);\n    let c = r.cmp(&s);\n    let last_odd = out.n > 0 && out.d[out.n - 1] % 2 == 1;\n    if c > 0 || (c == 0 && last_odd) {\n        // up, carrying\n        let mut j = out.n;\n        loop {\n            if j == 0 {\n");
    buf_str(out, c"                // 9.99 up to 10.0: one digit, a place higher\n                out.d[0] = 1;\n                out.n = 1;\n                out.k += 1;\n                break;\n            }\n            j -= 1;\n            if out.d[j] == 9 {\n                out.d[j] = 0;\n                out.n = j;\n            } else {\n                out.d[j] += 1;\n                break;\n            }\n        }\n    }\n    out\n}\n\n// The text of a float: [sign] head zeros tail, padded as the hole says.\nstruct Text {\n    head: [u8; 1400],\n    hn: usize,\n    zeros: usize,\n    tail: [u8; 8],\n    tn: usize,\n}\n\nimpl Text {\n    fn new() -> Text {\n        Text { head: [0u8; 1400], hn: 0, zeros: 0, tail: [0u8; 8], tn: 0 }\n    }\n\n    fn push(&mut self, b: u8) {\n        if self.zeros > 0 {\n            // a digit after counted zeros: write them out first\n            while self.zeros > 0 && self.hn < 1400 {\n                self.head[self.hn] = 48;\n                self.hn += 1;\n                self.zeros -= 1;\n            }\n        }\n        if self.hn < 1400 {\n            self.head[self.hn] = b;\n            self.hn += 1;\n        }\n    }\n\n    fn push_str(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            self.push(b[i]);\n            i += 1;\n        }\n    }\n\n    fn exponent(&mut self, upper: bool, x: i32) {\n        self.tail[0] = if upper { 69 } else { 101 };\n        self.tn = 1;\n        let mut v = x;\n        if v < 0 {\n            self.tail[1] = 45;\n            self.tn = 2;\n            v = -v;\n        }\n        let mut buf = [0u8; 4];\n        let mut i: usize = 4;\n        loop {\n            i -= 1;\n            buf[i] = 48 + (v % 10) as u8;\n            v = v / 10;\n            if v == 0 {\n                break;\n            }\n        }\n        while i < 4 {\n            self.tail[self.tn] = buf[i];\n            self.tn += 1;\n            i += 1;\n        }\n    }\n");
    buf_str(out, c"\n    fn len(&self) -> usize {\n        self.hn + self.zeros + self.tn\n    }\n}\n\nfn write_bytes(f: &mut Formatter<'_>, b: &[u8]) -> Result {\n    match crate::str::from_utf8(b) {\n        crate::result::Result::Ok(s) => f.write_str(s),\n        crate::result::Result::Err(_) => crate::result::Result::Ok(()),\n    }\n}\n\nfn write_fill(f: &mut Formatter<'_>, c: char, n: usize) -> Result {\n    let mut i: usize = 0;\n    while i < n {\n        f.write_char(c)?;\n        i += 1;\n    }\n    crate::result::Result::Ok(())\n}\n\n// sign and t padded to the width: `0` puts zeros after the sign, else the\n// fill goes where the alignment says (right by default), as Rust's\n// pad_formatted_parts.\nfn pad(f: &mut Formatter<'_>, sign: &str, t: &Text) -> Result {\n    let len = sign.len() + t.len();\n    let width = match f.width() {\n        crate::option::Option::Some(w) => w,\n        crate::option::Option::None => 0,\n    };\n    if len < width && f.sign_aware_zero_pad() {\n        f.write_str(sign)?;\n        write_fill(f, '0', width - len)?;\n        return write_text(f, t);\n    }\n    let p: usize = if len >= width { 0 } else { width - len };\n    let fill = f.fill();\n    let (pre, post): (usize, usize) = match f.align() {\n        crate::option::Option::Some(Alignment::Left) => (0, p),\n        crate::option::Option::Some(Alignment::Center) => (p / 2, p - p / 2),\n        _ => (p, 0),\n    };\n    write_fill(f, fill, pre)?;\n    f.write_str(sign)?;\n    write_text(f, t)?;\n    write_fill(f, fill, post)\n}\n\nfn write_text(f: &mut Formatter<'_>, t: &Text) -> Result {\n    write_bytes(f, &t.head[..t.hn])?;\n    write_fill(f, '0', t.zeros)?;\n    write_bytes(f, &t.tail[..t.tn])\n}\n\n// digits as a fixed-point number: at least `frac` digits after the point\n// (and exactly `frac` when `exactly`).\nfn fixed(t: &mut Text, d: &Digits, frac: usize, exactly: bool) {\n    let k = d.k as i64;\n    let n = d.n as i64;\n    // the integer part\n    if k <= 0 {\n");
    buf_str(out, c"        t.push(48);\n    } else {\n        let mut i: i64 = 0;\n        while i < k {\n            t.push(if i < n { 48 + d.d[i as usize] } else { 48 });\n            i += 1;\n        }\n    }\n    // the fraction: the digits after the point, then zeros to frac\n    let have: i64 = if n > k { n - k } else { 0 };\n    let shown: i64 = if exactly { frac as i64 } else if have > frac as i64 { have }\n        else { frac as i64 };\n    if shown == 0 {\n        return;\n    }\n    t.push(46);\n    let mut j: i64 = 0;\n    while j < shown {\n        // place j after the point is digit k + j\n        let at = k + j;\n        if at >= n {\n            t.zeros += (shown - j) as usize;\n            return;\n        }\n        t.push(if at < 0 { 48 } else { 48 + d.d[at as usize] });\n        j += 1;\n    }\n}\n\n// digits as d.ddd e x: `frac` digits after the point at least.\nfn scientific(t: &mut Text, d: &Digits, frac: usize, upper: bool) {\n    let n = d.n;\n    t.push(48 + if n > 0 { d.d[0] } else { 0 });\n    let have = if n > 1 { n - 1 } else { 0 };\n    let shown = if have > frac { have } else { frac };\n    if shown > 0 {\n        t.push(46);\n        let mut j: usize = 1;\n        while j < n {\n            t.push(48 + d.d[j]);\n            j += 1;\n        }\n        t.zeros += shown - have;\n    }\n    t.exponent(upper, if n > 0 { d.k - 1 } else { 0 });\n}\n\n// A float as its Display (kind 0), Debug (1), LowerExp (2) or UpperExp (3)\n// writes it; an f32's value comes as the f64 it converts to, exactly.\n#[effects(panic, diverge)]\npub(crate) fn fmt_float(v: f64, is32: bool, kind: u8, f: &mut Formatter<'_>) -> Result {\n    let mut t = Text::new();\n    if v != v {\n        // NaN: no sign, even with `+`\n        t.push_str(\"NaN\");\n        return pad(f, \"\", &t);\n    }\n    let neg = v < 0.0 || (v == 0.0 && 1.0 / v < 0.0);\n    let sign: &str = if neg { \"-\" } else if f.sign_plus() { \"+\" } else { \"\" };\n    let a = if neg { -v } else { v };\n");
    buf_str(out, c"    let upper = kind == 3;\n    if a == 1.0 / 0.0 {\n        t.push_str(\"inf\");\n        return pad(f, sign, &t);\n    }\n    let prec = f.precision();\n    let exp_form = kind >= 2\n        || (kind == 1 && prec.is_none() && a != 0.0 && (a < 0.0001 || a >= 10000000000000000.0));\n    if a == 0.0 {\n        let p = match prec {\n            crate::option::Option::Some(p) => p,\n            crate::option::Option::None => if kind == 1 && !exp_form { 1 } else { 0 },\n        };\n        let zero = Digits { d: [0u8; 1200], n: 0, k: 1 };\n        if exp_form {\n            scientific(&mut t, &zero, p, upper);\n        } else {\n            fixed(&mut t, &zero, p, true);\n        }\n        return pad(f, sign, &t);\n    }\n    let (m, e) = decompose(a, is32);\n    match prec {\n        crate::option::Option::Some(p) => {\n            if exp_form {\n                let d = exact(m, e, true, (p as i64) + 1);\n                scientific(&mut t, &d, p, upper);\n            } else {\n                let d = exact(m, e, false, p as i64);\n                fixed(&mut t, &d, p, true);\n            }\n        }\n        crate::option::Option::None => {\n            let d = shortest(m, e, is32);\n            if exp_form {\n                scientific(&mut t, &d, 0, upper);\n            } else {\n                fixed(&mut t, &d, if kind == 1 { 1 } else { 0 }, false);\n            }\n        }\n    }\n    pad(f, sign, &t)\n}\n\n// s as a float, rounded to the nearest (half to even): Rust's grammar, a\n// sign, then `inf`, `infinity` or `nan` in any case, or digits with a\n// point and an exponent (`1.5`, `.5`, `5.`, `1e-3`, `+3.5E+2`). Err(true)\n// when s is empty, Err(false) when it is not a float. An f32's comes as\n// the f64 of its value, exactly.\n#[effects(panic, diverge)]\npub(crate) fn parse_float(s: &str, is32: bool) -> crate::result::Result<f64, bool> {\n    let b = s.as_bytes();\n    let n = b.len();\n    if n == 0 {\n        return crate::result::Result::Err(true);\n");
    buf_str(out, c"    }\n    let mut i: usize = 0;\n    let mut neg = false;\n    if b[0] == 43 || b[0] == 45 {\n        neg = b[0] == 45;\n        i = 1;\n    }\n    let sign: f64 = if neg { -1.0 } else { 1.0 };\n    let rest = &b[i..];\n    if eq_lower(rest, \"inf\") || eq_lower(rest, \"infinity\") {\n        return crate::result::Result::Ok(sign / 0.0);\n    }\n    if eq_lower(rest, \"nan\") {\n        let z: f64 = 0.0;\n        return crate::result::Result::Ok(z / z);\n    }\n    // the digits: at most 780 kept, a dropped nonzero one kept as a 1\n    let mut big = Big::from_u64(0);\n    let mut kept: usize = 0;\n    let mut dropped = false;\n    let mut exp10: i64 = 0;\n    let mut any = false;\n    let mut point = false;\n    while i < n {\n        let c = b[i];\n        if c >= 48 && c <= 57 {\n            any = true;\n            if kept == 0 && c == 48 {\n                // a leading zero: only the place moves\n                if point {\n                    exp10 -= 1;\n                }\n            } else if kept < 780 {\n                big.mul_small(10);\n                big.add_small((c - 48) as u32);\n                kept += 1;\n                if point {\n                    exp10 -= 1;\n                }\n            } else {\n                if c != 48 {\n                    dropped = true;\n                }\n                if !point {\n                    exp10 += 1;\n                }\n            }\n        } else if c == 46 && !point {\n            point = true;\n        } else {\n            break;\n        }\n        i += 1;\n    }\n    if !any {\n        return crate::result::Result::Err(false);\n    }\n    if i < n {\n        if b[i] != 101 && b[i] != 69 {\n            return crate::result::Result::Err(false);\n        }\n        i += 1;\n        let mut eneg = false;\n        if i < n && (b[i] == 43 || b[i] == 45) {\n            eneg = b[i] == 45;\n            i += 1;\n        }\n        if i == n {\n            return crate::result::Result::Err(false);\n");
    buf_str(out, c"        }\n        let mut x: i64 = 0;\n        while i < n {\n            let c = b[i];\n            if c < 48 || c > 57 {\n                return crate::result::Result::Err(false);\n            }\n            if x < 100000000 {\n                x = x * 10 + ((c - 48) as i64);\n            }\n            i += 1;\n        }\n        exp10 += if eneg { -x } else { x };\n    }\n    if dropped {\n        big.mul_small(10);\n        big.add_small(1);\n        kept += 1;\n        exp10 -= 1;\n    }\n    if big.is_zero() {\n        return crate::result::Result::Ok(sign * 0.0);\n    }\n    // the decimal exponent of the first digit: past the ranges, inf or 0\n    let top = exp10 + (kept as i64);\n    if top > 310 {\n        return crate::result::Result::Ok(sign / 0.0);\n    }\n    if top < -326 {\n        return crate::result::Result::Ok(sign * 0.0);\n    }\n    let (mbits, min_e) = format_params(is32);\n    let mbits = mbits as i64;\n    let min_e = min_e as i64;\n    let max_biased: i64 = if is32 { 255 } else { 2047 };\n    let bias: i64 = if is32 { 127 } else { 1023 };\n    // value = num / den\n    let mut num = big;\n    let mut den = Big::from_u64(1);\n    if exp10 >= 0 {\n        num.mul_pow10(exp10 as usize);\n    } else {\n        den.mul_pow10((-exp10) as usize);\n    }\n    // q = floor(value / 2^b), mbits + 2 bits at most\n    let mut b2: i64 = (num.bits() as i64) - (den.bits() as i64) - mbits - 2;\n    if b2 < min_e - 1 {\n        b2 = min_e - 1;\n    }\n    if b2 < 0 {\n        num.shl((-b2) as usize);\n    } else {\n        den.shl(b2 as usize);\n    }\n    let mut q: u64 = 0;\n    let mut t = den.copy();\n    t.shl(57);\n    let mut bit: i64 = 57;\n    while bit >= 0 {\n        if num.cmp(&t) >= 0 {\n            num.sub(&t);\n            q = q | (1u64 << (bit as u64));\n        }\n        t.shr1();\n        bit -= 1;\n    }\n    let mut sticky = !num.is_zero();\n    let limit: u64 = 1u64 << ((mbits + 1) as u64);\n    while q >= limit {\n");
    buf_str(out, c"        sticky = sticky || q % 2 == 1;\n        q = q >> 1;\n        b2 += 1;\n    }\n    let round = q % 2 == 1;\n    let mut m = q >> 1;\n    let mut e = b2 + 1;\n    if round && (sticky || m % 2 == 1) {\n        m += 1;\n        if m == (1u64 << (mbits as u64)) {\n            m = m >> 1;\n            e += 1;\n        }\n    }\n    let hidden: u64 = 1u64 << ((mbits - 1) as u64);\n    if m >= hidden && e + bias + mbits - 1 >= max_biased {\n        return crate::result::Result::Ok(sign / 0.0);\n    }\n    crate::result::Result::Ok(sign * scale2(m as f64, e))\n}\n\n// x * 2^e, exactly: each step's value is m * 2^j between the two, which\n// the float holds.\nfn scale2(x: f64, e: i64) -> f64 {\n    let two32: f64 = 4294967296.0;\n    let mut v = x;\n    let mut e = e;\n    while e >= 32 {\n        v = v * two32;\n        e -= 32;\n    }\n    while e > 0 {\n        v = v * 2.0;\n        e -= 1;\n    }\n    while e <= -32 {\n        v = v / two32;\n        e += 32;\n    }\n    while e < 0 {\n        v = v / 2.0;\n        e += 1;\n    }\n    v\n}\n\n// b equal to the ASCII word w, in any case.\nfn eq_lower(b: &[u8], w: &str) -> bool {\n    let wb = w.as_bytes();\n    if b.len() != wb.len() {\n        return false;\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        let c = b[i];\n        let lc = if c >= 65 && c <= 90 { c + 32 } else { c };\n        if lc != wb[i] {\n            return false;\n        }\n        i += 1;\n    }\n    true\n}\n\n// \"true\" or \"false\", as bool's FromStr reads them.\n#[effects(panic)]\npub(crate) fn parse_bool(s: &str) -> crate::option::Option<bool> {\n    let b = s.as_bytes();\n    if b == \"true\".as_bytes() {\n        crate::option::Option::Some(true)\n    } else if b == \"false\".as_bytes() {\n        crate::option::Option::Some(false)\n    } else {\n        crate::option::Option::None\n    }\n}\n\n// An integer's LowerExp or UpperExp (`{:e}` of 1234 is 1.234e3): its exact\n");
    buf_str(out, c"// digits, rounded half to even to the precision.\n#[effects(panic, diverge)]\npub(crate) fn fmt_int_exp(neg: bool, v: u64, upper: bool, f: &mut Formatter<'_>) -> Result {\n    let mut t = Text::new();\n    let sign: &str = if neg { \"-\" } else if f.sign_plus() { \"+\" } else { \"\" };\n    let p = match f.precision() {\n        crate::option::Option::Some(p) => p,\n        crate::option::Option::None => 0,\n    };\n    if v == 0 {\n        let zero = Digits { d: [0u8; 1200], n: 0, k: 1 };\n        scientific(&mut t, &zero, p, upper);\n        return pad(f, sign, &t);\n    }\n    let count: i64 = match f.precision() {\n        crate::option::Option::Some(p) => (p as i64) + 1,\n        crate::option::Option::None => 40,\n    };\n    let d = exact(v, 0, true, count);\n    scientific(&mut t, &d, p, upper);\n    pad(f, sign, &t)\n}\n// ---- end mod std::flt ----\n}\n// ---- mod std::fmath ----\nmod fmath {\n// EDITION: rust\n// std2's float math (private): the algorithms of MVS's std::math, read by\n// f64's and f32's inherent methods (num.vl): `x.sqrt()`, `x.floor()`,\n// `y.atan2(x)`, Rust's names and semantics. No C and no libm: the same\n// results on every target.\n// mvs: std::math\n\n// v's IEEE 754 bits (f64::to_bits).\n#[effects(unsafe)]\npub(crate) fn f64_to_bits(v: f64) -> u64 {\n    // UNSAFE: an f64's bits read as a u64 (Rust's transmute).\n    // SAFETY: both are 8 bytes with the same alignment, and any bits are\n    // a valid u64; v is a live local.\n    unsafe { *(&v as *const f64 as *const u64) }\n}\n\n// The f64 with these bits (f64::from_bits).\n#[effects(unsafe)]\npub(crate) fn f64_from_bits(u: u64) -> f64 {\n    // UNSAFE: a u64's bits read as an f64 (Rust's transmute).\n    // SAFETY: both are 8 bytes with the same alignment, and any bits are\n    // a valid f64; u is a live local.\n    unsafe { *(&u as *const u64 as *const f64) }\n}\n\n// v's IEEE 754 bits (f32::to_bits).\n#[effects(unsafe)]\npub(crate) fn f32_to_bits(v: f32) -> u32 {\n");
    buf_str(out, c"    // UNSAFE: an f32's bits read as a u32 (Rust's transmute).\n    // SAFETY: both are 4 bytes with the same alignment, and any bits are\n    // a valid u32; v is a live local.\n    unsafe { *(&v as *const f32 as *const u32) }\n}\n\n// The f32 with these bits (f32::from_bits).\n#[effects(unsafe)]\npub(crate) fn f32_from_bits(u: u32) -> f32 {\n    // UNSAFE: a u32's bits read as an f32 (Rust's transmute).\n    // SAFETY: both are 4 bytes with the same alignment, and any bits are\n    // a valid f32; u is a live local.\n    unsafe { *(&u as *const u32 as *const f32) }\n}\n\n// x's neighbour above (up) or below, as Rust's next_up and next_down: by\n// its bits, which order the numbers of one sign (0.25.5).\nfn next64(x: f64, up: bool) -> f64 {\n    let bits = f64_to_bits(x);\n    let abs = bits & 0x7fffffffffffffff;\n    // (NaN, and the infinity in the direction of the step, stay)\n    if abs > 0x7ff0000000000000\n        || bits == (if up { 0x7ff0000000000000u64 } else { 0xfff0000000000000u64 }) {\n        return x;\n    }\n    if abs == 0 {\n        return f64_from_bits(if up { 1u64 } else { 0x8000000000000001u64 });\n    }\n    // (away from zero when the step goes x's way)\n    let away = (bits == abs) == up;\n    f64_from_bits(if away { bits + 1 } else { bits - 1 })\n}\n\nfn next32(x: f32, up: bool) -> f32 {\n    let bits = f32_to_bits(x);\n    let abs = bits & 0x7fffffff;\n    if abs > 0x7f800000 || bits == (if up { 0x7f800000u32 } else { 0xff800000u32 }) {\n        return x;\n    }\n    if abs == 0 {\n        return f32_from_bits(if up { 1u32 } else { 0x80000001u32 });\n    }\n    let away = (bits == abs) == up;\n    f32_from_bits(if away { bits + 1 } else { bits - 1 })\n}\n\n// ---- Math: bits, rounding, min and max (0.25.2.1) ----\n\n// The methods of f32 and f64 (`x.sqrt()`, `y.atan2(x)`), Rust's names and\n// semantics, are the trait Float's; `math::sqrt(x)` and the others are\n// functions over it. The constants are the compiler's (`f64::EPSILON`,\n");
    buf_str(out, c"// `f64::consts::PI`, as `i64::MAX`).\n//\n// The f64 algorithms are FreeBSD msun's and musl's (fdlibm), as the Rust\n// libm crate has them; their notice:\n//\n//   Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.\n//   Developed at SunSoft, a Sun Microsystems, Inc. business.\n//   Permission to use, copy, modify, and distribute this software is\n//   freely granted, provided that this notice is preserved.\n//\n// f32's are f64's, rounded once. sqrt is correctly rounded (exact\n// integer check); the others are within a few ulp of the true value\n// (tests/run/math_vs_libm measures them against the system's libm).\n\n// The high and low 32 bits of x (fdlibm's GET_HIGH_WORD, GET_LOW_WORD).\n#[inline]\nfn hi_word(x: f64) -> u32 { (f64_to_bits(x) >> 32) as u32 }\n\n#[inline]\nfn lo_word(x: f64) -> u32 { f64_to_bits(x) as u32 }\n\n// x with its low 32 bits l (SET_LOW_WORD).\n#[inline]\nfn with_lo_word(x: f64, l: u32) -> f64 {\n    f64_from_bits(f64_to_bits(x) & 0xffffffff00000000 | l as u64)\n}\n\n// The f64 of the words h, l (INSERT_WORDS).\n#[inline]\nfn from_words(h: u32, l: u32) -> f64 { f64_from_bits((h as u64) << 32 | l as u64) }\n\n// 2^k for a normal exponent, -1022 <= k <= 1023.\n#[inline]\nfn pow2(k: i64) -> f64 { f64_from_bits(((k + 1023) as u64) << 52) }\n\n#[inline]\nfn copysign64(x: f64, s: f64) -> f64 {\n    f64_from_bits(f64_to_bits(x) & 0x7fffffffffffffff | f64_to_bits(s) & 0x8000000000000000)\n}\n\n// x * 2^n, rounded once (musl's scalbn: the subnormal range is reached\n// in one last multiplication).\nfn scalbn(x: f64, n0: i32) -> f64 {\n    let mut n = n0;\n    let mut y = x;\n    if n > 1023 {\n        y *= pow2(1023);\n        n -= 1023;\n        if n > 1023 {\n            y *= pow2(1023);\n            n -= 1023;\n            if n > 1023 {\n                n = 1023;\n            }\n        }\n    } else if n < -1022 {\n        // (x * 2^-969 first: the last product's n then < -53, so that\n");
    buf_str(out, c"        // it rounds once into the subnormals)\n        y *= pow2(-1022) * pow2(53);\n        n += 1022 - 53;\n        if n < -1022 {\n            y *= pow2(-1022) * pow2(53);\n            n += 1022 - 53;\n            if n < -1022 {\n                n = -1022;\n            }\n        }\n    }\n    y * pow2(n as i64)\n}\n\n// x rounded toward zero: its fraction bits cleared.\nfn trunc64(x: f64) -> f64 {\n    let u = f64_to_bits(x);\n    let e = ((u >> 52) & 0x7ff) as i64 - 1023;\n    if e >= 52 {\n        // (an integer, an infinity or NaN)\n        return x;\n    }\n    if e < 0 {\n        return f64_from_bits(u & 0x8000000000000000);\n    }\n    let m: u64 = 0x000fffffffffffff >> e as u64;\n    f64_from_bits(u & !m)\n}\n\nfn floor64(x: f64) -> f64 {\n    let t = trunc64(x);\n    // (exact: below 2^52 an integer minus 1 is one)\n    if x < t { t - 1.0 } else { t }\n}\n\nfn ceil64(x: f64) -> f64 {\n    let t = trunc64(x);\n    if x > t { t + 1.0 } else { t }\n}\n\n// Half-way cases away from zero; x - trunc(x) is exact.\nfn round64(x: f64) -> f64 {\n    let t = trunc64(x);\n    let d = x - t;\n    if d >= 0.5 { t + 1.0 } else if d <= -0.5 { t - 1.0 } else { t }\n}\n\nfn round_even64(x: f64) -> f64 {\n    let t = trunc64(x);\n    let d = x - t;\n    // (t odd: t / 2 has a fraction; exact)\n    let odd = t * 0.5 != trunc64(t * 0.5);\n    if d > 0.5 || d == 0.5 && odd {\n        t + 1.0\n    } else if d < -0.5 || d == -0.5 && odd {\n        t - 1.0\n    } else {\n        t\n    }\n}\n\n// musl's fmin and fmax: NaN loses; -0.0 < +0.0.\nfn min64(x: f64, y: f64) -> f64 {\n    if x != x {\n        return y;\n    }\n    if y != y {\n        return x;\n    }\n    if f64_to_bits(x) >> 63 != f64_to_bits(y) >> 63 {\n        return if f64_to_bits(x) >> 63 != 0 { x } else { y };\n    }\n    if x < y { x } else { y }\n}\n\nfn max64(x: f64, y: f64) -> f64 {\n    if x != x {\n        return y;\n    }\n    if y != y {\n        return x;\n    }\n");
    buf_str(out, c"    if f64_to_bits(x) >> 63 != f64_to_bits(y) >> 63 {\n        return if f64_to_bits(x) >> 63 != 0 { y } else { x };\n    }\n    if x < y { y } else { x }\n}\n\nfn clamp64(x: f64, lo: f64, hi: f64) -> f64 {\n    let mut r = x;\n    if r < lo {\n        r = lo;\n    }\n    if r > hi {\n        r = hi;\n    }\n    r\n}\n\n// x^n by squaring (compiler-rt's __powidf2, Rust's powi).\nfn powi64(x: f64, n: i32) -> f64 {\n    let mut a = x;\n    let mut b = n as i64;\n    let recip = b < 0;\n    let mut r = 1.0;\n    loop {\n        if b & 1 != 0 {\n            r *= a;\n        }\n        b /= 2;\n        if b == 0 {\n            break;\n        }\n        a *= a;\n    }\n    if recip { 1.0 / r } else { r }\n}\n\n// ---- Math: roots (0.25.2.1) ----\n\n// The square root, correctly rounded. x = t * 2^(e - p) with t in\n// [1, 4) and e - p even; sqrt(x) = sqrt(t) * 2^((e - p) / 2), and\n// sqrt(t) * 2^52 rounded is the integer s with (s - 1/2)^2 < M < (s +\n// 1/2)^2, M = t * 2^104 (an integer: the significand shifted). The\n// estimate of s is f64's Newton iteration for 1/sqrt(t) (no division)\n// times t; the exact integer check moves it to the nearest, so the\n// rounding is exact whatever the estimate's last bits.\nfn sqrt64(x: f64) -> f64 {\n    let mut u = f64_to_bits(x);\n    if u >= 0x7ff0000000000000 {\n        // +inf, NaN, or negative\n        if u == 0x7ff0000000000000 || u == 0x8000000000000000 || x != x {\n            return x;\n        }\n        return f64::NAN;\n    }\n    if u == 0 {\n        return x;\n    }\n    let mut scale: i64 = 0;\n    if u < 0x0010000000000000 {\n        // a subnormal: times 2^108 (exact), the root times 2^-54\n        u = f64_to_bits(x * pow2(108));\n        scale = -54;\n    }\n    let e = (u >> 52) as i64 - 1023;\n    let mant = u & 0x000fffffffffffff | 0x0010000000000000;\n    let p = e & 1;\n    let t = f64_from_bits(u & 0x000fffffffffffff | ((1023 + p) as u64) << 52);\n");
    buf_str(out, c"    // 1/sqrt(t): the bit estimate (3.4% off), then four Newton steps\n    // (y * (1.5 - t/2 * y^2): 2e-3, 5e-6, 3e-11, then f64's rounding)\n    let mut y = f64_from_bits(0x5fe6eb50c7b537a9 - (f64_to_bits(t) >> 1));\n    let half = 0.5 * t;\n    y = y * (1.5 - half * y * y);\n    y = y * (1.5 - half * y * y);\n    y = y * (1.5 - half * y * y);\n    y = y * (1.5 - half * y * y);\n    let mut s = (t * y * pow2(52)) as u64;\n    // R = M - s^2, exact in 64 bits (|R| < 2^60: s is within a few units\n    // of sqrt(M), M < 2^106); s is the nearest iff -s < R <= s\n    let mut r = ((mant << (52 + p) as u64) as i64).wrapping_sub(s.wrapping_mul(s) as i64);\n    while r > s as i64 {\n        r -= 2 * s as i64 + 1;\n        s += 1;\n    }\n    while r <= -(s as i64) {\n        r += 2 * s as i64 - 1;\n        s -= 1;\n    }\n    let k = ((e - p) >> 1) + scale;\n    f64_from_bits(((k + 1023) as u64) << 52 | s - 0x0010000000000000)\n}\n\n// The cube root (fdlibm's s_cbrt, musl's cbrt before 2023): an estimate\n// from the exponent / 3, a polynomial to 23 bits, rounded to 21 bits,\n// then one step of Newton's method to 53 (error < 0.667 ulp).\nconst CBRT_B1: u32 = 715094163; // (1023 - 1023/3 - 0.03306235651) * 2^20\nconst CBRT_B2: u32 = 696219795; // (1023 - 1023/3 - 54/3 - 0.03306235651) * 2^20\nconst CBRT_P0: f64 = 1.87595182427177009643; // 0x3ffe03e6, 0x0f61e692\nconst CBRT_P1: f64 = -1.88497979543377169875; // 0xbffe28e0, 0x92f02420\nconst CBRT_P2: f64 = 1.621429720105354466140; // 0x3ff9f160, 0x4a49d6c2\nconst CBRT_P3: f64 = -0.758397934778766047437; // 0xbfe844cb, 0xbee751d9\nconst CBRT_P4: f64 = 0.145996192886612446982; // 0x3fc2b000, 0xd4e4edd7\n\nfn cbrt64(x: f64) -> f64 {\n    let mut u = f64_to_bits(x);\n    let mut hx = (u >> 32) as u32 & 0x7fffffff;\n    if hx >= 0x7ff00000 {\n        // NaN, inf\n        return x + x;\n    }\n    if hx < 0x00100000 {\n        // zero or subnormal\n        u = f64_to_bits(x * pow2(54));\n");
    buf_str(out, c"        hx = (u >> 32) as u32 & 0x7fffffff;\n        if hx == 0 {\n            return x;\n        }\n        hx = hx / 3 + CBRT_B2;\n    } else {\n        hx = hx / 3 + CBRT_B1;\n    }\n    u &= 0x8000000000000000;\n    u |= (hx as u64) << 32;\n    let mut t = f64_from_bits(u);\n    // 1/cbrt(x) to 23 bits: |1/cbrt(x) - p(x)| < 2^-23.5\n    let mut r = t * t * (t / x);\n    t = t * (CBRT_P0 + r * (CBRT_P1 + r * CBRT_P2) + r * r * r * (CBRT_P3 + r * CBRT_P4));\n    // t rounded away from zero to 21 bits: t*t exact below\n    u = f64_to_bits(t);\n    u = u + 0x80000000 & 0xffffffffc0000000;\n    t = f64_from_bits(u);\n    let s = t * t;\n    r = x / s;\n    let w = t + t;\n    r = (r - t) / (w + r);\n    t + t * r\n}\n\n// sqrt(x^2 + y^2) (musl's hypot): the squares exact as hi + lo\n// (Dekker's split, no fma), scaled by 2^+-700 out of overflow and\n// underflow.\nfn hypot_sq(x: f64) -> (f64, f64) {\n    // 2^27 + 1\n    let xc = x * 134217729.0;\n    let xh = x - xc + xc;\n    let xl = x - xh;\n    let hi = x * x;\n    let lo = xh * xh - hi + 2.0 * xh * xl + xl * xl;\n    (hi, lo)\n}\n\nfn hypot64(x0: f64, y0: f64) -> f64 {\n    let mut ux = f64_to_bits(x0) & 0x7fffffffffffffff;\n    let mut uy = f64_to_bits(y0) & 0x7fffffffffffffff;\n    if ux < uy {\n        let ut = ux;\n        ux = uy;\n        uy = ut;\n    }\n    let ex = (ux >> 52) as i64;\n    let ey = (uy >> 52) as i64;\n    let mut x = f64_from_bits(ux);\n    let mut y = f64_from_bits(uy);\n    // (hypot(inf, NaN) is inf)\n    if ey == 0x7ff {\n        return y;\n    }\n    if ex == 0x7ff || uy == 0 {\n        return x;\n    }\n    if ex - ey > 64 {\n        return x + y;\n    }\n    let mut z = 1.0;\n    if ex > 0x3ff + 510 {\n        z = pow2(700);\n        x *= pow2(-700);\n        y *= pow2(-700);\n    } else if ey < 0x3ff - 450 {\n        z = pow2(-700);\n        x *= pow2(700);\n        y *= pow2(700);\n    }\n    let (hx, lx) = hypot_sq(x);\n    let (hy, ly) = hypot_sq(y);\n");
    buf_str(out, c"    z * sqrt64(ly + lx + hy + hx)\n}\n\n// ---- Math: trigonometric kernels (0.25.2.1) ----\n\n// fdlibm's __kernel_sin, __kernel_cos, __kernel_tan on [-pi/4, pi/4],\n// x + y the reduced argument (y the tail).\nconst S1: f64 = -1.66666666666666324348e-01; // 0xBFC55555, 0x55555549\nconst S2: f64 = 8.33333333332248946124e-03; // 0x3F811111, 0x1110F8A6\nconst S3: f64 = -1.98412698298579493134e-04; // 0xBF2A01A0, 0x19C161D5\nconst S4: f64 = 2.75573137070700676789e-06; // 0x3EC71DE3, 0x57B1FE7D\nconst S5: f64 = -2.50507602534068634195e-08; // 0xBE5AE5E6, 0x8A2B9CEB\nconst S6: f64 = 1.58969099521155010221e-10; // 0x3DE5D93A, 0x5ACFD57C\n\nfn k_sin(x: f64, y: f64, iy: i32) -> f64 {\n    let z = x * x;\n    let w = z * z;\n    let r = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6);\n    let v = z * x;\n    if iy == 0 { x + v * (S1 + z * r) } else { x - (z * (0.5 * y - v * r) - y - v * S1) }\n}\n\nconst C1: f64 = 4.16666666666666019037e-02; // 0x3FA55555, 0x5555554C\nconst C2: f64 = -1.38888888888741095749e-03; // 0xBF56C16C, 0x16C15177\nconst C3: f64 = 2.48015872894767294178e-05; // 0x3EFA01A0, 0x19CB1590\nconst C4: f64 = -2.75573143513906633035e-07; // 0xBE927E4F, 0x809C52AD\nconst C5: f64 = 2.08757232129817482790e-09; // 0x3E21EE9E, 0xBDB4B1C4\nconst C6: f64 = -1.13596475577881948265e-11; // 0xBDA8FAE9, 0xBE8838D4\n\nfn k_cos(x: f64, y: f64) -> f64 {\n    let z = x * x;\n    let w = z * z;\n    let r = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6));\n    let hz = 0.5 * z;\n    let w1 = 1.0 - hz;\n    w1 + (1.0 - w1 - hz + (z * r - x * y))\n}\n\nstatic TAN_T: [f64; 13] = [\n    3.33333333333334091986e-01, // 3FD55555, 55555563\n    1.33333333333201242699e-01, // 3FC11111, 1110FE7A\n    5.39682539762260521377e-02, // 3FABA1BA, 1BB341FE\n    2.18694882948595424599e-02, // 3F9664F4, 8406D637\n    8.86323982359930005737e-03, // 3F8226E3, E96E8493\n    3.59207910759131235356e-03, // 3F6D6D22, C9560328\n    1.45620945432529025516e-03, // 3F57DBC8, FEE08315\n");
    buf_str(out, c"    5.88041240820264096874e-04, // 3F4344D8, F2F26501\n    2.46463134818469906812e-04, // 3F3026F7, 1A8D1068\n    7.81794442939557092300e-05, // 3F147E88, A03792A6\n    7.14072491382608190305e-05, // 3F12B80F, 32F0A7E9\n    -1.85586374855275456654e-05, // BEF375CB, DB605373\n    2.59073051863633712884e-05, // 3EFB2A70, 74BF7AD4\n];\nconst PIO4: f64 = 7.85398163397448278999e-01; // 3FE921FB, 54442D18\nconst PIO4_LO: f64 = 3.06161699786838301793e-17; // 3C81A626, 33145C07\n\n// tan(x + y), or -1/tan(x + y) when odd is 1.\nfn k_tan(x0: f64, y0: f64, odd: i32) -> f64 {\n    let mut x = x0;\n    let mut y = y0;\n    let hx = hi_word(x);\n    // |x| >= 0.6744: tan(pi/4 - x) instead\n    let big = hx & 0x7fffffff >= 0x3FE59428;\n    if big {\n        if hx >> 31 != 0 {\n            x = -x;\n            y = -y;\n        }\n        x = PIO4 - x + (PIO4_LO - y);\n        y = 0.0;\n    }\n    let z = x * x;\n    let w = z * z;\n    let t = TAN_T;\n    let mut r = t[1] + w * (t[3] + w * (t[5] + w * (t[7] + w * (t[9] + w * t[11]))));\n    let v = z * (t[2] + w * (t[4] + w * (t[6] + w * (t[8] + w * (t[10] + w * t[12])))));\n    let s = z * x;\n    r = y + z * (s * (r + v) + y) + s * t[0];\n    let w1 = x + r;\n    if big {\n        let sg = 1.0 - 2.0 * odd as f64;\n        let v1 = sg - 2.0 * (x + (r - w1 * w1 / (w1 + sg)));\n        return if hx >> 31 != 0 { -v1 } else { v1 };\n    }\n    if odd == 0 {\n        return w1;\n    }\n    // -1/(x + r), accurately: w0 + v = r + x, a0 = -1/w to 20 bits\n    let w0 = with_lo_word(w1, 0);\n    let v2 = r - (w0 - x);\n    let a = -1.0 / w1;\n    let a0 = with_lo_word(a, 0);\n    a0 + a * (1.0 + a0 * w0 + a0 * v2)\n}\n\n// ---- Math: argument reduction (0.25.2.1) ----\n\n// x - n * pi/2 as y0 + y1 with |y0 + y1| <= pi/4 (fdlibm's\n// __ieee754_rem_pio2, musl's version): Cody-Waite with pi/2 in three\n// pieces of 33 bits (each product exact) for |x| < 2^20 * pi/2, else\n// Payne-Hanek (rem_pio2_large). Returns (n, y0, y1).\n");
    buf_str(out, c"const TO_INT: f64 = 6755399441055744.0; // 1.5 / EPSILON\nconst INV_PIO2: f64 = 6.36619772367581382433e-01; // 0x3FE45F30, 0x6DC9C883\nconst PIO2_1: f64 = 1.57079632673412561417e+00; // 0x3FF921FB, 0x54400000\nconst PIO2_1T: f64 = 6.07710050650619224932e-11; // 0x3DD0B461, 0x1A626331\nconst PIO2_2: f64 = 6.07710050630396597660e-11; // 0x3DD0B461, 0x1A600000\nconst PIO2_2T: f64 = 2.02226624879595063154e-21; // 0x3BA3198A, 0x2E037073\nconst PIO2_3: f64 = 2.02226624871116645580e-21; // 0x3BA3198A, 0x2E000000\nconst PIO2_3T: f64 = 8.47842766036889956997e-32; // 0x397B839A, 0x252049C1\n\nfn rem_pio2_medium(x: f64, ix: u32) -> (i32, f64, f64) {\n    // rint(x / (pi/2)), round to nearest\n    let f_n = x * INV_PIO2 + TO_INT - TO_INT;\n    let n = f_n as i32;\n    let mut r = x - f_n * PIO2_1;\n    // first round, good to 85 bits\n    let mut w = f_n * PIO2_1T;\n    let mut y0 = r - w;\n    let ex = (ix >> 20) as i32;\n    let mut ey = (hi_word(y0) >> 20) as i32 & 0x7ff;\n    if ex - ey > 16 {\n        // second round, good to 118 bits\n        let mut t = r;\n        w = f_n * PIO2_2;\n        r = t - w;\n        w = f_n * PIO2_2T - (t - r - w);\n        y0 = r - w;\n        ey = (hi_word(y0) >> 20) as i32 & 0x7ff;\n        if ex - ey > 49 {\n            // third round, good to 151 bits: every case\n            t = r;\n            w = f_n * PIO2_3;\n            r = t - w;\n            w = f_n * PIO2_3T - (t - r - w);\n            y0 = r - w;\n        }\n    }\n    let y1 = r - y0 - w;\n    (n, y0, y1)\n}\n\n// x - k * pi/2 for k = 1..4 and |x| near k * pi/2's interval (one\n// round, good to 85 bits).\nfn rem_pio2_k(x: f64, k: i32, neg: bool) -> (i32, f64, f64) {\n    let kf = k as f64;\n    if !neg {\n        let z = x - kf * PIO2_1;\n        let y0 = z - kf * PIO2_1T;\n        (k, y0, z - y0 - kf * PIO2_1T)\n    } else {\n        let z = x + kf * PIO2_1;\n        let y0 = z + kf * PIO2_1T;\n        (-k, y0, z - y0 + kf * PIO2_1T)\n    }\n}\n\n");
    buf_str(out, c"fn rem_pio2(x: f64) -> (i32, f64, f64) {\n    let neg = f64_to_bits(x) >> 63 != 0;\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x400f6a7a {\n        // |x| !<= 5pi/4\n        if ix & 0xfffff == 0x921fb {\n            // |x| != pi/2 or 2pi/2: cancellation, the medium case\n            return rem_pio2_medium(x, ix);\n        }\n        // |x| !<= 3pi/4: 1, else 2\n        return rem_pio2_k(x, if ix <= 0x4002d97c { 1 } else { 2 }, neg);\n    }\n    if ix <= 0x401c463b {\n        // |x| !<= 9pi/4\n        if ix <= 0x4015fdbc {\n            // |x| !<= 7pi/4\n            if ix == 0x4012d97c {\n                // |x| != 3pi/2\n                return rem_pio2_medium(x, ix);\n            }\n            return rem_pio2_k(x, 3, neg);\n        }\n        if ix == 0x401921fb {\n            // |x| != 4pi/2\n            return rem_pio2_medium(x, ix);\n        }\n        return rem_pio2_k(x, 4, neg);\n    }\n    if ix < 0x413921fb {\n        // |x| !< 2^20 * pi/2\n        return rem_pio2_medium(x, ix);\n    }\n    if ix >= 0x7ff00000 {\n        // inf or NaN\n        let y = x - x;\n        return (0, y, y);\n    }\n    // z = |x| scaled to [2^23, 2^24), cut into three 24-bit pieces\n    let mut u = f64_to_bits(x) & 0x000fffffffffffff;\n    u |= (0x3ff + 23) << 52;\n    let mut z = f64_from_bits(u);\n    let mut tx: [f64; 3] = [0.0; 3];\n    tx[0] = (z as i32) as f64;\n    z = (z - tx[0]) * 16777216.0;\n    tx[1] = (z as i32) as f64;\n    z = (z - tx[1]) * 16777216.0;\n    tx[2] = z;\n    // (the zero pieces at the end left out; the first is not zero)\n    let mut nx: i64 = 3;\n    while nx > 1 && tx[nx - 1] == 0.0 {\n        nx -= 1;\n    }\n    let (n, y0, y1) = rem_pio2_large(tx, nx, (ix >> 20) as i32 - (0x3ff + 23));\n    if neg { (-n, -y0, -y1) } else { (n, y0, y1) }\n}\n\n// 2/pi's bits, 24 to an entry (fdlibm's ipio2, enough for every f64).\nstatic IPIO2: [i32; 66] = [\n    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163,\n");
    buf_str(out, c"    0xABDEBB, 0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,\n    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C,\n    0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,\n    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292,\n    0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,\n    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA,\n    0x73A8C9, 0x60E27B, 0xC08C6B,\n];\n\n// pi/2 in pieces of 24 bits.\nstatic PIO2_PIECES: [f64; 8] = [\n    1.57079625129699707031e+00, // 0x3FF921FB, 0x40000000\n    7.54978941586159635335e-08, // 0x3E74442D, 0x00000000\n    5.39030252995776476554e-15, // 0x3CF84698, 0x80000000\n    3.28200341580791294123e-22, // 0x3B78CC51, 0x60000000\n    1.27065575308067607349e-29, // 0x39F01B83, 0x80000000\n    1.22933308981111328932e-36, // 0x387A2520, 0x40000000\n    2.73370053816464559624e-44, // 0x36E38222, 0x80000000\n    2.16741683877804819444e-51, // 0x3569F31D, 0x00000000\n];\n\n// fdlibm's __kernel_rem_pio2 for f64 (prec 1: the result as y0 + y1):\n// x = (tx[0] + tx[1] 2^-24 + tx[2] 2^-48) * 2^e0, the product with 2/pi's\n// bits from where they matter, in 24-bit pieces, the integer part mod 8\n// and the fraction times pi/2. Returns (n mod 8, y0, y1).\nfn rem_pio2_large(tx: [f64; 3], nx: i64, e0: i32) -> (i32, f64, f64) {\n    let two24 = 16777216.0;\n    let twon24 = 5.9604644775390625e-08;\n    let ipio2 = IPIO2;\n    let pio2 = PIO2_PIECES;\n    // jk + 1 terms of the product (prec 1: 4)\n    let jk: i64 = 4;\n    let jp: i64 = 4;\n    let jx = nx - 1;\n    let mut jv = ((e0 - 3) / 24) as i64;\n    if jv < 0 {\n        jv = 0;\n    }\n    let mut q0: i32 = e0 - 24 * (jv as i32 + 1);\n    let mut f: [f64; 20] = [0.0; 20];\n    let mut fq: [f64; 20] = [0.0; 20];\n    let mut q: [f64; 20] = [0.0; 20];\n");
    buf_str(out, c"    let mut iq: [i32; 20] = [0; 20];\n    // f[0..=jx + jk]: ipio2[jv - jx..]\n    let mut j = jv - jx;\n    for i in 0..jx + jk + 1 {\n        f[i] = if j < 0 { 0.0 } else { ipio2[j] as f64 };\n        j += 1;\n    }\n    // q[0..=jk]\n    for i in 0..jk + 1 {\n        let mut fw = 0.0;\n        for k in 0..jx + 1 {\n            fw += tx[k] * f[jx + i - k];\n        }\n        q[i] = fw;\n    }\n    let mut jz = jk;\n    let mut z = 0.0;\n    let mut n: i32 = 0;\n    let mut ih: i32 = 0;\n    loop {\n        // q[] into 24-bit pieces iq[], lowest first\n        z = q[jz];\n        let mut i: i64 = 0;\n        let mut k = jz;\n        while k > 0 {\n            let fw = ((twon24 * z) as i32) as f64;\n            iq[i] = (z - two24 * fw) as i32;\n            z = q[k - 1] + fw;\n            i += 1;\n            k -= 1;\n        }\n        // n: the integer part mod 8\n        z = scalbn(z, q0);\n        z -= 8.0 * floor64(z * 0.125);\n        n = z as i32;\n        z -= n as f64;\n        ih = 0;\n        if q0 > 0 {\n            // iq[jz - 1] holds n's last bits\n            let b = iq[jz - 1] >> (24 - q0);\n            n += b;\n            iq[jz - 1] -= b << (24 - q0);\n            ih = iq[jz - 1] >> (23 - q0);\n        } else if q0 == 0 {\n            ih = iq[jz - 1] >> 23;\n        } else if z >= 0.5 {\n            ih = 2;\n        }\n        if ih > 0 {\n            // the fraction > 0.5: 1 - it, n + 1\n            n += 1;\n            let mut carry: i32 = 0;\n            for m in 0..jz {\n                let v = iq[m];\n                if carry == 0 {\n                    if v != 0 {\n                        carry = 1;\n                        iq[m] = 0x1000000 - v;\n                    }\n                } else {\n                    iq[m] = 0xffffff - v;\n                }\n            }\n            if q0 == 1 {\n                iq[jz - 1] &= 0x7fffff;\n            } else if q0 == 2 {\n                iq[jz - 1] &= 0x3fffff;\n            }\n");
    buf_str(out, c"            if ih == 2 {\n                z = 1.0 - z;\n                if carry != 0 {\n                    z -= scalbn(1.0, q0);\n                }\n            }\n        }\n        // all zero: more of 2/pi's bits needed\n        if z == 0.0 {\n            let mut all: i32 = 0;\n            let mut m = jz - 1;\n            while m >= jk {\n                all |= iq[m];\n                m -= 1;\n            }\n            if all == 0 {\n                let mut more: i64 = 1;\n                while iq[jk - more] == 0 {\n                    more += 1;\n                }\n                for ii in jz + 1..jz + more + 1 {\n                    f[jx + ii] = ipio2[jv + ii] as f64;\n                    let mut fw = 0.0;\n                    for kk in 0..jx + 1 {\n                        fw += tx[kk] * f[jx + ii - kk];\n                    }\n                    q[ii] = fw;\n                }\n                jz += more;\n                continue;\n            }\n        }\n        break;\n    }\n    // the zero pieces at the end left out\n    if z == 0.0 {\n        jz -= 1;\n        q0 -= 24;\n        while iq[jz] == 0 {\n            jz -= 1;\n            q0 -= 24;\n        }\n    } else {\n        // z cut into 24-bit pieces if needed\n        z = scalbn(z, -q0);\n        if z >= two24 {\n            let fw = ((twon24 * z) as i32) as f64;\n            iq[jz] = (z - two24 * fw) as i32;\n            jz += 1;\n            q0 += 24;\n            iq[jz] = fw as i32;\n        } else {\n            iq[jz] = z as i32;\n        }\n    }\n    // the pieces as f64s\n    let mut fw = scalbn(1.0, q0);\n    let mut i = jz;\n    while i >= 0 {\n        q[i] = fw * (iq[i] as f64);\n        fw *= twon24;\n        i -= 1;\n    }\n    // fq = pio2[0..=jp] * q[jz..=0]\n    i = jz;\n    while i >= 0 {\n        let mut s = 0.0;\n        let mut k: i64 = 0;\n        while k <= jp && k <= jz - i {\n            s += pio2[k] * q[i + k];\n            k += 1;\n        }\n        fq[jz - i] = s;\n");
    buf_str(out, c"        i -= 1;\n    }\n    // fq summed into y0 + y1\n    let mut s = 0.0;\n    i = jz;\n    while i >= 0 {\n        s += fq[i];\n        i -= 1;\n    }\n    let y0 = if ih == 0 { s } else { -s };\n    s = fq[0] - s;\n    for m in 1..jz + 1 {\n        s += fq[m];\n    }\n    let y1 = if ih == 0 { s } else { -s };\n    (n & 7, y0, y1)\n}\n\n// ---- Math: sin, cos, tan (0.25.2.1) ----\n\n// fdlibm's s_sin, s_cos, s_tan, musl's sincos: the kernels on the\n// argument reduced by rem_pio2, by its quadrant.\nfn sin64(x: f64) -> f64 {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        // |x| !< pi/4\n        if ix < 0x3e500000 {\n            // |x| < 2^-26: sin(x) is x\n            return x;\n        }\n        return k_sin(x, 0.0, 0);\n    }\n    if ix >= 0x7ff00000 {\n        // inf or NaN\n        return x - x;\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    match n & 3 {\n        0 => k_sin(y0, y1, 1),\n        1 => k_cos(y0, y1),\n        2 => -k_sin(y0, y1, 1),\n        _ => -k_cos(y0, y1),\n    }\n}\n\nfn cos64(x: f64) -> f64 {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        if ix < 0x3e46a09e {\n            // |x| < 2^-27 * sqrt(2): cos(x) is 1\n            return 1.0;\n        }\n        return k_cos(x, 0.0);\n    }\n    if ix >= 0x7ff00000 {\n        return x - x;\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    match n & 3 {\n        0 => k_cos(y0, y1),\n        1 => -k_sin(y0, y1, 1),\n        2 => -k_cos(y0, y1),\n        _ => k_sin(y0, y1, 1),\n    }\n}\n\nfn tan64(x: f64) -> f64 {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        if ix < 0x3e400000 {\n            // |x| < 2^-27\n            return x;\n        }\n        return k_tan(x, 0.0, 0);\n    }\n    if ix >= 0x7ff00000 {\n        return x - x;\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    k_tan(y0, y1, n & 1)\n}\n\nfn sin_cos64(x: f64) -> (f64, f64) {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n");
    buf_str(out, c"        if ix < 0x3e46a09e {\n            return (x, 1.0);\n        }\n        return (k_sin(x, 0.0, 0), k_cos(x, 0.0));\n    }\n    if ix >= 0x7ff00000 {\n        let y = x - x;\n        return (y, y);\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    let s = k_sin(y0, y1, 1);\n    let c = k_cos(y0, y1);\n    match n & 3 {\n        0 => (s, c),\n        1 => (c, -s),\n        2 => (-s, -c),\n        _ => (-c, s),\n    }\n}\n\n// ---- Math: inverse trigonometric functions (0.25.2.1) ----\n\n// fdlibm's e_asin, e_acos: a rational approximation R(x^2) of\n// (asin(x) - x) / x^3 on [0, 0.5], and asin(x) = pi/2 - 2 asin(sqrt((1 -\n// x) / 2)) above.\nconst PIO2_HI: f64 = 1.57079632679489655800e+00; // 0x3FF921FB, 0x54442D18\nconst PIO2_LO: f64 = 6.12323399573676603587e-17; // 0x3C91A626, 0x33145C07\nconst P_S0: f64 = 1.66666666666666657415e-01; // 0x3FC55555, 0x55555555\nconst P_S1: f64 = -3.25565818622400915405e-01; // 0xBFD4D612, 0x03EB6F7D\nconst P_S2: f64 = 2.01212532134862925881e-01; // 0x3FC9C155, 0x0E884455\nconst P_S3: f64 = -4.00555345006794114027e-02; // 0xBFA48228, 0xB5688F3B\nconst P_S4: f64 = 7.91534994289814532176e-04; // 0x3F49EFE0, 0x7501B288\nconst P_S5: f64 = 3.47933107596021167570e-05; // 0x3F023DE1, 0x0DFDF709\nconst Q_S1: f64 = -2.40339491173441421878e+00; // 0xC0033A27, 0x1C8A2D4B\nconst Q_S2: f64 = 2.02094576023350569471e+00; // 0x40002AE5, 0x9C598AC8\nconst Q_S3: f64 = -6.88283971605453293030e-01; // 0xBFE6066C, 0x1B8D0159\nconst Q_S4: f64 = 7.70381505559019352791e-02; // 0x3FB3B8C5, 0xB12E9282\n\nfn asin_r(z: f64) -> f64 {\n    let p = z * (P_S0 + z * (P_S1 + z * (P_S2 + z * (P_S3 + z * (P_S4 + z * P_S5)))));\n    let q = 1.0 + z * (Q_S1 + z * (Q_S2 + z * (Q_S3 + z * Q_S4)));\n    p / q\n}\n\nfn asin64(x: f64) -> f64 {\n    let hx = hi_word(x);\n    let ix = hx & 0x7fffffff;\n    if ix >= 0x3ff00000 {\n        // |x| >= 1 or NaN\n        if ix - 0x3ff00000 | lo_word(x) == 0 {\n            // asin(+-1) = +-pi/2\n");
    buf_str(out, c"            return x * PIO2_HI + pow2(-120);\n        }\n        if x != x {\n            return x;\n        }\n        return f64::NAN;\n    }\n    if ix < 0x3fe00000 {\n        // |x| < 0.5\n        if ix < 0x3e500000 && ix >= 0x00100000 {\n            // |x| < 2^-26\n            return x;\n        }\n        return x + x * asin_r(x * x);\n    }\n    // 1 > |x| >= 0.5\n    let z = (1.0 - x.abs()) * 0.5;\n    let s = sqrt64(z);\n    let r = asin_r(z);\n    let mut y = 0.0;\n    if ix >= 0x3fef3333 {\n        // |x| > 0.975\n        y = PIO2_HI - (2.0 * (s + s * r) - PIO2_LO);\n    } else {\n        // f + c = sqrt(z)\n        let f = with_lo_word(s, 0);\n        let c = (z - f * f) / (s + f);\n        y = 0.5 * PIO2_HI - (2.0 * s * r - (PIO2_LO - 2.0 * c) - (0.5 * PIO2_HI - 2.0 * f));\n    }\n    if hx >> 31 != 0 { -y } else { y }\n}\n\nfn acos64(x: f64) -> f64 {\n    let hx = hi_word(x);\n    let ix = hx & 0x7fffffff;\n    if ix >= 0x3ff00000 {\n        if ix - 0x3ff00000 | lo_word(x) == 0 {\n            // acos(1) = 0, acos(-1) = pi\n            if hx >> 31 != 0 {\n                return 2.0 * PIO2_HI + pow2(-120);\n            }\n            return 0.0;\n        }\n        if x != x {\n            return x;\n        }\n        return f64::NAN;\n    }\n    if ix < 0x3fe00000 {\n        // |x| < 0.5\n        if ix <= 0x3c600000 {\n            // |x| < 2^-57\n            return PIO2_HI + pow2(-120);\n        }\n        return PIO2_HI - (x - (PIO2_LO - x * asin_r(x * x)));\n    }\n    if hx >> 31 != 0 {\n        // x < -0.5\n        let z = (1.0 + x) * 0.5;\n        let s = sqrt64(z);\n        let w = asin_r(z) * s - PIO2_LO;\n        return 2.0 * (PIO2_HI - (s + w));\n    }\n    // x > 0.5\n    let z = (1.0 - x) * 0.5;\n    let s = sqrt64(z);\n    let df = with_lo_word(s, 0);\n    let c = (z - df * df) / (s + df);\n    let w = asin_r(z) * s + c;\n    2.0 * (df + w)\n}\n\n// fdlibm's s_atan: x reduced to [0, 7/16] around atan(0.5), atan(1),\n");
    buf_str(out, c"// atan(1.5) or atan(inf), then a polynomial of 11 terms.\nstatic ATAN_HI: [f64; 4] = [\n    4.63647609000806093515e-01, // atan(0.5)hi 0x3FDDAC67, 0x0561BB4F\n    7.85398163397448278999e-01, // atan(1.0)hi 0x3FE921FB, 0x54442D18\n    9.82793723247329054082e-01, // atan(1.5)hi 0x3FEF730B, 0xD281F69B\n    1.57079632679489655800e+00, // atan(inf)hi 0x3FF921FB, 0x54442D18\n];\nstatic ATAN_LO: [f64; 4] = [\n    2.26987774529616870924e-17, // atan(0.5)lo 0x3C7A2B7F, 0x222F65E2\n    3.06161699786838301793e-17, // atan(1.0)lo 0x3C81A626, 0x33145C07\n    1.39033110312309984516e-17, // atan(1.5)lo 0x3C700788, 0x7AF0CBBD\n    6.12323399573676603587e-17, // atan(inf)lo 0x3C91A626, 0x33145C07\n];\nstatic ATAN_T: [f64; 11] = [\n    3.33333333333329318027e-01, // 0x3FD55555, 0x5555550D\n    -1.99999999998764832476e-01, // 0xBFC99999, 0x9998EBC4\n    1.42857142725034663711e-01, // 0x3FC24924, 0x920083FF\n    -1.11111104054623557880e-01, // 0xBFBC71C6, 0xFE231671\n    9.09088713343650656196e-02, // 0x3FB745CD, 0xC54C206E\n    -7.69187620504482999495e-02, // 0xBFB3B0F2, 0xAF749A6D\n    6.66107313738753120669e-02, // 0x3FB10D66, 0xA0D03D51\n    -5.83357013379057348645e-02, // 0xBFADDE2D, 0x52DEFD9A\n    4.97687799461593236017e-02, // 0x3FA97B4B, 0x24760DEB\n    -3.65315727442169155270e-02, // 0xBFA2B444, 0x2C6A6C2F\n    1.62858201153657823623e-02, // 0x3F90AD3A, 0xE322DA11\n];\n\nfn atan64(x0: f64) -> f64 {\n    let mut x = x0;\n    let hx = hi_word(x);\n    let neg = hx >> 31 != 0;\n    let ix = hx & 0x7fffffff;\n    if ix >= 0x44100000 {\n        // |x| >= 2^66, or NaN\n        if x != x {\n            return x;\n        }\n        let z = ATAN_HI[3] + pow2(-120);\n        return if neg { -z } else { z };\n    }\n    let mut id: i64 = -1;\n    if ix < 0x3fdc0000 {\n        // |x| < 0.4375\n        if ix < 0x3e400000 {\n            // |x| < 2^-27\n            return x;\n        }\n    } else {\n        x = x.abs();\n        if ix < 0x3ff30000 {\n            // |x| < 1.1875\n");
    buf_str(out, c"            if ix < 0x3fe60000 {\n                // 7/16 <= |x| < 11/16\n                id = 0;\n                x = (2.0 * x - 1.0) / (2.0 + x);\n            } else {\n                // 11/16 <= |x| < 19/16\n                id = 1;\n                x = (x - 1.0) / (x + 1.0);\n            }\n        } else if ix < 0x40038000 {\n            // |x| < 2.4375\n            id = 2;\n            x = (x - 1.5) / (1.0 + 1.5 * x);\n        } else {\n            // 2.4375 <= |x| < 2^66\n            id = 3;\n            x = -1.0 / x;\n        }\n    }\n    let at = ATAN_T;\n    let z = x * x;\n    let w = z * z;\n    // the odd and the even terms\n    let s1 = z * (at[0] + w * (at[2] + w * (at[4] + w * (at[6] + w * (at[8] + w * at[10])))));\n    let s2 = w * (at[1] + w * (at[3] + w * (at[5] + w * (at[7] + w * at[9]))));\n    if id < 0 {\n        return x - x * (s1 + s2);\n    }\n    let r = ATAN_HI[id] - (x * (s1 + s2) - ATAN_LO[id] - x);\n    if neg { -r } else { r }\n}\n\nconst PI_LO: f64 = 1.2246467991473531772e-16; // 0x3CA1A626, 0x33145C07\n\n// fdlibm's e_atan2: atan(|y/x|), placed in its quadrant; the special\n// values of C99's Annex F.\nfn atan2_64(y: f64, x: f64) -> f64 {\n    let pi = f64::consts::PI;\n    if x != x || y != y {\n        return x + y;\n    }\n    let mut ix = hi_word(x);\n    let lx = lo_word(x);\n    let mut iy = hi_word(y);\n    let ly = lo_word(y);\n    if ix.wrapping_sub(0x3ff00000) | lx == 0 {\n        // x = 1.0\n        return atan64(y);\n    }\n    // 2 * sign(x) + sign(y)\n    let m = iy >> 31 & 1 | ix >> 30 & 2;\n    ix &= 0x7fffffff;\n    iy &= 0x7fffffff;\n    if iy | ly == 0 {\n        // y = +-0\n        return if m <= 1 { y } else if m == 2 { pi } else { -pi };\n    }\n    if ix | lx == 0 {\n        // x = +-0\n        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 };\n    }\n    if ix == 0x7ff00000 {\n        // x = +-inf\n        if iy == 0x7ff00000 {\n            return if m == 0 {\n                pi / 4.0\n");
    buf_str(out, c"            } else if m == 1 {\n                -pi / 4.0\n            } else if m == 2 {\n                3.0 * pi / 4.0\n            } else {\n                -3.0 * pi / 4.0\n            };\n        }\n        return if m == 0 { 0.0 } else if m == 1 { -0.0 } else if m == 2 { pi } else { -pi };\n    }\n    if ix + (64 << 20) < iy || iy == 0x7ff00000 {\n        // |y/x| > 2^64\n        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 };\n    }\n    // atan(|y/x|) without a spurious underflow\n    let z = if m & 2 != 0 && iy + (64 << 20) < ix { 0.0 } else { atan64((y / x).abs()) };\n    if m == 0 {\n        z\n    } else if m == 1 {\n        -z\n    } else if m == 2 {\n        pi - (z - PI_LO)\n    } else {\n        z - PI_LO - pi\n    }\n}\n\n// ---- Math: exp and log (0.25.2.1) ----\n\n// fdlibm's e_exp: x = k ln2 + r, |r| <= ln2 / 2 (ln2 in two pieces, k *\n// ln2hi exact), e^r from a Remez polynomial of r^2, times 2^k.\nconst LN2_HI: f64 = 6.93147180369123816490e-01; // 0x3fe62e42, 0xfee00000\nconst LN2_LO: f64 = 1.90821492927058770002e-10; // 0x3dea39ef, 0x35793c76\nconst INV_LN2: f64 = 1.44269504088896338700e+00; // 0x3ff71547, 0x652b82fe\nconst EXP_P1: f64 = 1.66666666666666019037e-01; // 0x3FC55555, 0x5555553E\nconst EXP_P2: f64 = -2.77777777770155933842e-03; // 0xBF66C16C, 0x16BEBD93\nconst EXP_P3: f64 = 6.61375632143793436117e-05; // 0x3F11566A, 0xAF25DE2C\nconst EXP_P4: f64 = -1.65339022054652515390e-06; // 0xBEBBBD41, 0xC5D26BF1\nconst EXP_P5: f64 = 4.13813679705723846039e-08; // 0x3E663769, 0x72BEA4D0\n\nfn exp64(x0: f64) -> f64 {\n    let mut x = x0;\n    let mut hx = hi_word(x);\n    let sign = (hx >> 31) as i32;\n    hx &= 0x7fffffff;\n    if hx >= 0x4086232b {\n        // |x| >= 708.39, or NaN\n        if x != x {\n            return x;\n        }\n        if x > 709.782712893383973096 {\n            // overflow\n            return x * pow2(1023);\n        }\n        if x < -745.13321910194110842 {\n            // underflow\n");
    buf_str(out, c"            return 0.0;\n        }\n    }\n    let mut k: i32 = 0;\n    let mut hi = 0.0;\n    let mut lo = 0.0;\n    if hx > 0x3fd62e42 {\n        // |x| > ln2 / 2\n        if hx >= 0x3ff0a2b2 {\n            // |x| >= 1.5 ln2\n            k = (INV_LN2 * x + if sign != 0 { -0.5 } else { 0.5 }) as i32;\n        } else {\n            k = 1 - sign - sign;\n        }\n        hi = x - k as f64 * LN2_HI;\n        lo = k as f64 * LN2_LO;\n        x = hi - lo;\n    } else if hx > 0x3e300000 {\n        // |x| > 2^-28\n        hi = x;\n    } else {\n        return 1.0 + x;\n    }\n    let xx = x * x;\n    let c = x - xx * (EXP_P1 + xx * (EXP_P2 + xx * (EXP_P3 + xx * (EXP_P4 + xx * EXP_P5))));\n    let y = 1.0 + (x * c / (2.0 - c) - lo + hi);\n    if k == 0 { y } else { scalbn(y, k) }\n}\n\n// 2^x = 2^k * e^(r ln2), k the nearest integer, r = x - k (exact).\nfn exp2_64(x: f64) -> f64 {\n    if x != x {\n        return x;\n    }\n    if x >= 1024.0 {\n        return f64::INFINITY;\n    }\n    if x < -1080.0 {\n        return 0.0;\n    }\n    let k = round64(x);\n    let r = x - k;\n    if r == 0.0 {\n        return scalbn(1.0, k as i32);\n    }\n    scalbn(exp64(r * f64::consts::LN_2), k as i32)\n}\n\n// fdlibm's e_log: x = 2^k (1 + f), sqrt(2)/2 < 1 + f < sqrt(2); log(1 +\n// f) = f - f^2/2 + s(f^2/2 + R(s^2)), s = f / (2 + f), R a Remez\n// polynomial; plus k ln2 in two pieces.\nconst LG1: f64 = 6.666666666666735130e-01; // 3FE55555 55555593\nconst LG2: f64 = 3.999999999940941908e-01; // 3FD99999 9997FA04\nconst LG3: f64 = 2.857142874366239149e-01; // 3FD24924 94229359\nconst LG4: f64 = 2.222219843214978396e-01; // 3FCC71C5 1D8E78AF\nconst LG5: f64 = 1.818357216161805012e-01; // 3FC74664 96CB03DE\nconst LG6: f64 = 1.531383769920937332e-01; // 3FC39A09 D078C69F\nconst LG7: f64 = 1.479819860511658591e-01; // 3FC2F112 DF3E5244\n\n// The reduction of log, log2 and log10: (k, f, hfsq, s, R), or\n// (special, the result) for 0, negatives, inf, NaN and 1. x = 2^k (1 +\n// f).\n");
    buf_str(out, c"fn log_reduce(x0: f64) -> (bool, f64, i32, f64, f64, f64) {\n    let mut x = x0;\n    let mut ui = f64_to_bits(x);\n    let mut hx = (ui >> 32) as u32;\n    let mut k: i32 = 0;\n    if hx < 0x00100000 || hx >> 31 != 0 {\n        if ui << 1 == 0 {\n            // log(+-0) = -inf\n            return (true, f64::NEG_INFINITY, 0, 0.0, 0.0, 0.0);\n        }\n        if hx >> 31 != 0 {\n            // log(-x) = NaN\n            return (true, if x != x { x } else { f64::NAN }, 0, 0.0, 0.0, 0.0);\n        }\n        // a subnormal: scaled up\n        k -= 54;\n        x *= pow2(54);\n        ui = f64_to_bits(x);\n        hx = (ui >> 32) as u32;\n    } else if hx >= 0x7ff00000 {\n        return (true, x, 0, 0.0, 0.0, 0.0);\n    } else if hx == 0x3ff00000 && ui << 32 == 0 {\n        return (true, 0.0, 0, 0.0, 0.0, 0.0);\n    }\n    // x into [sqrt(2)/2, sqrt(2)]\n    hx += 0x3ff00000 - 0x3fe6a09e;\n    k += (hx >> 20) as i32 - 0x3ff;\n    hx = (hx & 0x000fffff) + 0x3fe6a09e;\n    ui = (hx as u64) << 32 | ui & 0xffffffff;\n    x = f64_from_bits(ui);\n    let f = x - 1.0;\n    let hfsq = 0.5 * f * f;\n    let s = f / (2.0 + f);\n    let z = s * s;\n    let w = z * z;\n    let t1 = w * (LG2 + w * (LG4 + w * LG6));\n    let t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)));\n    (false, f, k, hfsq, s, t2 + t1)\n}\n\nfn ln64(x: f64) -> f64 {\n    let (special, f, k, hfsq, s, r) = log_reduce(x);\n    if special {\n        return f;\n    }\n    let dk = k as f64;\n    s * (hfsq + r) + dk * LN2_LO - hfsq + f + dk * LN2_HI\n}\n\n// e_log2 (FreeBSD): log(1 + f) as hi + lo, hi with 32 bits, times\n// 1/ln2 in two pieces, plus k.\nconst IVLN2HI: f64 = 1.44269504072144627571e+00; // 0x3ff71547, 0x65200000\nconst IVLN2LO: f64 = 1.67517131648865118353e-10; // 0x3de705fc, 0x2eefa200\n\nfn log2_64(x: f64) -> f64 {\n    let (special, f, k, hfsq, s, r) = log_reduce(x);\n    if special {\n        return f;\n    }\n    let hi = f64_from_bits(f64_to_bits(f - hfsq) & 0xffffffff00000000);\n");
    buf_str(out, c"    let lo = f - hi - hfsq + s * (hfsq + r);\n    let mut val_hi = hi * IVLN2HI;\n    let mut val_lo = (lo + hi) * IVLN2LO + lo * IVLN2HI;\n    let y = k as f64;\n    let w = y + val_hi;\n    val_lo += y - w + val_hi;\n    val_hi = w;\n    val_lo + val_hi\n}\n\n// e_log10 (FreeBSD): as log2, times 1/ln10, plus k log10(2) in two\n// pieces.\nconst IVLN10HI: f64 = 4.34294481878168880939e-01; // 0x3fdbcb7b, 0x15200000\nconst IVLN10LO: f64 = 2.50829467116452752298e-11; // 0x3dbb9438, 0xca9aadd5\nconst LOG10_2HI: f64 = 3.01029995663611771306e-01; // 0x3FD34413, 0x509F6000\nconst LOG10_2LO: f64 = 3.69423907715893078616e-13; // 0x3D59FEF3, 0x11F12B36\n\nfn log10_64(x: f64) -> f64 {\n    let (special, f, k, hfsq, s, r) = log_reduce(x);\n    if special {\n        return f;\n    }\n    let hi = f64_from_bits(f64_to_bits(f - hfsq) & 0xffffffff00000000);\n    let lo = f - hi - hfsq + s * (hfsq + r);\n    let mut val_hi = hi * IVLN10HI;\n    let dk = k as f64;\n    let y = dk * LOG10_2HI;\n    let mut val_lo = dk * LOG10_2LO + (lo + hi) * IVLN10LO + lo * IVLN10HI;\n    let w = y + val_hi;\n    val_lo += y - w + val_hi;\n    val_hi = w;\n    val_lo + val_hi\n}\n\n// ---- Math: pow (0.25.2.1) ----\n\n// fdlibm's e_pow: log2(x) as t1 + t2 to about 64 bits, times y as y1 +\n// y2, then 2^(the product) as 2^n * e^(r ln2); the special values of\n// C99's Annex F (pow(x, 0) = 1 even for NaN, pow(1, y) = 1, (-x)^odd).\nconst POW_BP: [f64; 2] = [1.0, 1.5];\nconst POW_DP_H: [f64; 2] = [0.0, 5.84962487220764160156e-01]; // 0x3fe2b803_40000000\nconst POW_DP_L: [f64; 2] = [0.0, 1.35003920212974897128e-08]; // 0x3E4CFDEB, 0x43CFD006\nconst TWO53: f64 = 9007199254740992.0;\nconst HUGE: f64 = 1.0e300;\nconst TINY: f64 = 1.0e-300;\nconst POW_L1: f64 = 5.99999999999994648725e-01; // 0x3fe33333_33333303\nconst POW_L2: f64 = 4.28571428578550184252e-01; // 0x3fdb6db6_db6fabff\nconst POW_L3: f64 = 3.33333329818377432918e-01; // 0x3fd55555_518f264d\n");
    buf_str(out, c"const POW_L4: f64 = 2.72728123808534006489e-01; // 0x3fd17460_a91d4101\nconst POW_L5: f64 = 2.30660745775561754067e-01; // 0x3fcd864a_93c9db65\nconst POW_L6: f64 = 2.06975017800338417784e-01; // 0x3fca7e28_4a454eef\nconst POW_LG2: f64 = 6.93147180559945286227e-01; // 0x3fe62e42_fefa39ef\nconst POW_LG2_H: f64 = 6.93147182464599609375e-01; // 0x3fe62e43_00000000\nconst POW_LG2_L: f64 = -1.90465429995776804525e-09; // 0xbe205c61_0ca86c39\nconst POW_OVT: f64 = 8.0085662595372944372e-017; // -(1024 - log2(ovfl + .5ulp))\nconst POW_CP: f64 = 9.61796693925975554329e-01; // 0x3feec709_dc3a03fd = 2/(3ln2)\nconst POW_CP_H: f64 = 9.61796700954437255859e-01; // 0x3feec709_e0000000 = (float)cp\nconst POW_CP_L: f64 = -7.02846165095275826516e-09; // 0xbe3e2fe0_145b01f5 = tail of cp_h\nconst POW_IVLN2: f64 = 1.44269504088896338700e+00; // 0x3ff71547_652b82fe = 1/ln2\nconst POW_IVLN2_H: f64 = 1.44269502162933349609e+00; // 0x3ff71547_60000000 = 24b 1/ln2\nconst POW_IVLN2_L: f64 = 1.92596299112661746887e-08; // 0x3e54ae0b_f85ddf44 = 1/ln2 tail\n\nfn pow64(x: f64, y: f64) -> f64 {\n    let hx = hi_word(x) as i32;\n    let lx = lo_word(x);\n    let hy = hi_word(y) as i32;\n    let ly = lo_word(y);\n    let mut ix = hx & 0x7fffffff;\n    let iy = hy & 0x7fffffff;\n    // x^0 = 1, even for NaN\n    if iy as u32 | ly == 0 {\n        return 1.0;\n    }\n    // 1^y = 1, even for NaN\n    if hx == 0x3ff00000 && lx == 0 {\n        return 1.0;\n    }\n    // NaN if either is\n    if ix > 0x7ff00000 || ix == 0x7ff00000 && lx != 0 || iy > 0x7ff00000\n        || iy == 0x7ff00000 && ly != 0 {\n        return x + y;\n    }\n    // for x < 0: 0 when y is not an integer, 1 when an odd one, 2 when\n    // an even one\n    let mut yisint: i32 = 0;\n    if hx < 0 {\n        if iy >= 0x43400000 {\n            yisint = 2;\n        } else if iy >= 0x3ff00000 {\n            let k = (iy >> 20) - 0x3ff;\n            if k > 20 {\n                let j = (ly >> (52 - k) as u32) as i32;\n");
    buf_str(out, c"                if j << (52 - k) == ly as i32 {\n                    yisint = 2 - (j & 1);\n                }\n            } else if ly == 0 {\n                let j = iy >> (20 - k);\n                if j << (20 - k) == iy {\n                    yisint = 2 - (j & 1);\n                }\n            }\n        }\n    }\n    if ly == 0 {\n        // y is +-inf, +-1, 2, 0.5\n        if iy == 0x7ff00000 {\n            return if ix - 0x3ff00000 | lx as i32 == 0 {\n                // (-1)^+-inf = 1\n                1.0\n            } else if ix >= 0x3ff00000 {\n                // (|x| > 1)^+-inf = inf, 0\n                if hy >= 0 { y } else { 0.0 }\n            } else if hy >= 0 {\n                // (|x| < 1)^+-inf = 0, inf\n                0.0\n            } else {\n                -y\n            };\n        }\n        if iy == 0x3ff00000 {\n            return if hy >= 0 { x } else { 1.0 / x };\n        }\n        if hy == 0x40000000 {\n            return x * x;\n        }\n        if hy == 0x3fe00000 && hx >= 0 {\n            // x^0.5 for x >= +0\n            return sqrt64(x);\n        }\n    }\n    let mut ax = x.abs();\n    if lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000) {\n        // x is +-0, +-inf, +-1\n        let mut z = ax;\n        if hy < 0 {\n            z = 1.0 / z;\n        }\n        if hx < 0 {\n            if ix - 0x3ff00000 | yisint == 0 {\n                // (-1)^non-integer\n                z = f64::NAN;\n            } else if yisint == 1 {\n                z = -z;\n            }\n        }\n        return z;\n    }\n    let mut sn = 1.0;\n    if hx < 0 {\n        if yisint == 0 {\n            // (x < 0)^non-integer\n            return f64::NAN;\n        }\n        if yisint == 1 {\n            sn = -1.0;\n        }\n    }\n    let mut t1 = 0.0;\n    let mut t2 = 0.0;\n    if iy > 0x41e00000 {\n        // |y| > 2^31\n        if iy > 0x43f00000 {\n            // |y| > 2^64: overflow or underflow\n            if ix <= 0x3fefffff {\n");
    buf_str(out, c"                return if hy < 0 { HUGE * HUGE } else { TINY * TINY };\n            }\n            if ix >= 0x3ff00000 {\n                return if hy > 0 { HUGE * HUGE } else { TINY * TINY };\n            }\n        }\n        // over/underflow when x is not near 1\n        if ix < 0x3fefffff {\n            return if hy < 0 { sn * HUGE * HUGE } else { sn * TINY * TINY };\n        }\n        if ix > 0x3ff00000 {\n            return if hy > 0 { sn * HUGE * HUGE } else { sn * TINY * TINY };\n        }\n        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4\n        let t = ax - 1.0;\n        let w = t * t * (0.5 - t * (0.3333333333333333333333 - t * 0.25));\n        let u = POW_IVLN2_H * t;\n        let v = t * POW_IVLN2_L - w * POW_IVLN2;\n        t1 = with_lo_word(u + v, 0);\n        t2 = v - (t1 - u);\n    } else {\n        let mut n: i32 = 0;\n        if ix < 0x00100000 {\n            // a subnormal\n            ax *= TWO53;\n            n -= 53;\n            ix = hi_word(ax) as i32;\n        }\n        n += (ix >> 20) - 0x3ff;\n        let j = ix & 0x000fffff;\n        // the interval\n        ix = j | 0x3ff00000;\n        let mut k: i64 = 0;\n        if j <= 0x3988E {\n            // |x| < sqrt(3/2)\n            k = 0;\n        } else if j < 0xBB67A {\n            // |x| < sqrt(3)\n            k = 1;\n        } else {\n            k = 0;\n            n += 1;\n            ix -= 0x00100000;\n        }\n        ax = from_words(ix as u32, lo_word(ax));\n        // ss = s_h + s_l = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)\n        let bp = POW_BP[k];\n        let u = ax - bp;\n        let v = 1.0 / (ax + bp);\n        let ss = u * v;\n        let s_h = with_lo_word(ss, 0);\n        // t_h = ax + bp[k], high\n        let t_h = from_words((ix as u32 >> 1 | 0x20000000) + 0x00080000 + ((k as u32) << 18), 0);\n        let t_l = ax - (t_h - bp);\n        let s_l = v * (u - s_h * t_h - s_h * t_l);\n        // log(ax)\n        let s2 = ss * ss;\n");
    buf_str(out, c"        let mut r = s2 * s2 * (POW_L1 + s2 * (POW_L2 + s2 * (POW_L3 + s2 * (POW_L4 + s2 * (POW_L5\n            + s2 * POW_L6)))));\n        r += s_l * (s_h + ss);\n        let s2h = s_h * s_h;\n        let t_h2 = with_lo_word(3.0 + s2h + r, 0);\n        let t_l2 = r - (t_h2 - 3.0 - s2h);\n        // u + v = ss * (1 + ...)\n        let u2 = s_h * t_h2;\n        let v2 = s_l * t_h2 + t_l2 * ss;\n        // 2/(3 log2) * (ss + ...)\n        let p_h = with_lo_word(u2 + v2, 0);\n        let p_l = v2 - (p_h - u2);\n        let z_h = POW_CP_H * p_h;\n        let z_l = POW_CP_L * p_h + p_l * POW_CP + POW_DP_L[k];\n        // log2(ax) = (ss + ..) * 2/(3 log2) = n + dp_h + z_h + z_l\n        let t = n as f64;\n        t1 = with_lo_word(z_h + z_l + POW_DP_H[k] + t, 0);\n        t2 = z_l - (t1 - t - POW_DP_H[k] - z_h);\n    }\n    // (y1 + y2) * (t1 + t2), y split\n    let y1 = with_lo_word(y, 0);\n    let p_l = (y - y1) * t1 + y * t2;\n    let mut p_h = y1 * t1;\n    let z = p_l + p_h;\n    let mut j = hi_word(z) as i32;\n    let i = lo_word(z) as i32;\n    if j >= 0x40900000 {\n        // z >= 1024\n        if j - 0x40900000 | i != 0 {\n            return sn * HUGE * HUGE;\n        }\n        if p_l + POW_OVT > z - p_h {\n            return sn * HUGE * HUGE;\n        }\n    } else if j & 0x7fffffff >= 0x4090cc00 {\n        // z <= -1075\n        if (j as u32 - 0xc090cc00) | i as u32 != 0 {\n            return sn * TINY * TINY;\n        }\n        if p_l <= z - p_h {\n            return sn * TINY * TINY;\n        }\n    }\n    // 2^(p_h + p_l)\n    let ia = j & 0x7fffffff;\n    let mut k = (ia >> 20) - 0x3ff;\n    let mut n: i32 = 0;\n    if ia > 0x3fe00000 {\n        // |z| > 0.5: n = [z + 0.5]\n        n = j + (0x00100000 >> (k + 1));\n        k = ((n & 0x7fffffff) >> 20) - 0x3ff;\n        let t = from_words((n & !(0x000fffff >> k)) as u32, 0);\n        n = (n & 0x000fffff | 0x00100000) >> (20 - k);\n        if j < 0 {\n            n = -n;\n        }\n        p_h -= t;\n    }\n");
    buf_str(out, c"    let t = with_lo_word(p_l + p_h, 0);\n    let u = t * POW_LG2_H;\n    let v = (p_l - (t - p_h)) * POW_LG2 + t * POW_LG2_L;\n    let mut zz = u + v;\n    let w = v - (zz - u);\n    let tt = zz * zz;\n    let tt1 = zz - tt * (EXP_P1 + tt * (EXP_P2 + tt * (EXP_P3 + tt * (EXP_P4 + tt * EXP_P5))));\n    let r = zz * tt1 / (tt1 - 2.0) - (w + zz * w);\n    zz = 1.0 - (r - zz);\n    j = hi_word(zz) as i32;\n    j += n << 20;\n    if j >> 20 <= 0 {\n        // a subnormal result\n        zz = scalbn(zz, n);\n    } else {\n        zz = from_words(j as u32, lo_word(zz));\n    }\n    sn * zz\n}\n\n// f64's inherent methods (Rust's): the bits, the classification, rounding,\n// min and max, and the functions above.\nimpl f64 {\n    // The IEEE 754 bits.\n    #[effects()]\n    pub fn to_bits(self) -> u64 { f64_to_bits(self) }\n    // The f64 with these IEEE 754 bits.\n    #[effects()]\n    pub fn from_bits(v: u64) -> f64 { f64_from_bits(v) }\n    // |self|.\n    #[effects()]\n    pub fn abs(self) -> f64 { f64_from_bits(f64_to_bits(self) & 0x7fffffffffffffff) }\n    // 1.0 for +0.0 and positive numbers, -1.0 for -0.0 and negative ones,\n    // NaN for NaN.\n    #[effects()]\n    pub fn signum(self) -> f64 { if self != self { self } else { copysign64(1.0, self) } }\n    // |self| with the sign of `sign`.\n    #[effects()]\n    pub fn copysign(self, sign: f64) -> f64 { copysign64(self, sign) }\n    #[effects()]\n    pub fn is_nan(self) -> bool { self != self }\n    // Neither infinite nor NaN.\n    #[effects()]\n    pub fn is_finite(self) -> bool { f64_to_bits(self) & 0x7fffffffffffffff < 0x7ff0000000000000 }\n    #[effects()]\n    pub fn is_infinite(self) -> bool {\n        f64_to_bits(self) & 0x7fffffffffffffff == 0x7ff0000000000000\n    }\n    // Neither zero, infinite, subnormal nor NaN.\n    #[effects()]\n    pub fn is_normal(self) -> bool {\n        let e = (f64_to_bits(self) >> 52) & 0x7ff;\n        e != 0 && e != 0x7ff\n    }\n    #[effects()]\n");
    buf_str(out, c"    pub fn is_subnormal(self) -> bool {\n        let b = f64_to_bits(self) & 0x7fffffffffffffff;\n        b != 0 && b < 0x0010000000000000\n    }\n    // The sign bit is clear (+0.0, +inf and positive NaNs too).\n    #[effects()]\n    pub fn is_sign_positive(self) -> bool { f64_to_bits(self) >> 63 == 0 }\n    #[effects()]\n    pub fn is_sign_negative(self) -> bool { f64_to_bits(self) >> 63 != 0 }\n    // The largest integer <= self.\n    #[effects()]\n    pub fn floor(self) -> f64 { floor64(self) }\n    // The smallest integer >= self.\n    #[effects()]\n    pub fn ceil(self) -> f64 { ceil64(self) }\n    // The nearest integer, half-way cases away from zero.\n    #[effects()]\n    pub fn round(self) -> f64 { round64(self) }\n    // The nearest integer, half-way cases to the even one.\n    #[effects()]\n    pub fn round_ties_even(self) -> f64 { round_even64(self) }\n    // The integer part: rounded toward zero.\n    #[effects()]\n    pub fn trunc(self) -> f64 { trunc64(self) }\n    // self - self.trunc().\n    #[effects()]\n    pub fn fract(self) -> f64 { self - trunc64(self) }\n    // The smaller; the other one when one is NaN.\n    #[effects()]\n    pub fn min(self, other: f64) -> f64 { min64(self, other) }\n    // The larger; the other one when one is NaN.\n    #[effects()]\n    pub fn max(self, other: f64) -> f64 { max64(self, other) }\n    // self restricted to min..=max (NaN stays NaN); panics when min > max\n    // or either is NaN, as Rust's.\n    #[effects(panic)]\n    pub fn clamp(self, min: f64, max: f64) -> f64 {\n        if !(min <= max) {\n            crate::panic::panic(\"min > max, or either was NaN\");\n        }\n        let mut r = self;\n        if r < min {\n            r = min;\n        }\n        if r > max {\n            r = max;\n        }\n        r\n    }\n    // 1 / self.\n    #[effects()]\n    pub fn recip(self) -> f64 { 1.0 / self }\n    // Degrees to radians.\n    #[effects()]\n");
    buf_str(out, c"    pub fn to_radians(self) -> f64 { self * (PI64 / 180.0) }\n    // Radians to degrees.\n    #[effects()]\n    pub fn to_degrees(self) -> f64 { self * (180.0 / PI64) }\n    // The square root, correctly rounded; NaN below -0.0.\n    #[effects(diverge)]\n    pub fn sqrt(self) -> f64 { sqrt64(self) }\n    // The cube root.\n    #[effects()]\n    pub fn cbrt(self) -> f64 { cbrt64(self) }\n    // sqrt(self^2 + other^2) without overflow or underflow on the way.\n    #[effects(diverge)]\n    pub fn hypot(self, other: f64) -> f64 { hypot64(self, other) }\n    // The sine (radians).\n    #[effects(panic, diverge)]\n    pub fn sin(self) -> f64 { sin64(self) }\n    // The cosine (radians).\n    #[effects(panic, diverge)]\n    pub fn cos(self) -> f64 { cos64(self) }\n    // The tangent (radians).\n    #[effects(panic, diverge)]\n    pub fn tan(self) -> f64 { tan64(self) }\n    // (sin, cos), with one argument reduction.\n    #[effects(panic, diverge)]\n    pub fn sin_cos(self) -> (f64, f64) { sin_cos64(self) }\n    // The arcsine, in [-pi/2, pi/2]; NaN outside [-1, 1].\n    #[effects(diverge)]\n    pub fn asin(self) -> f64 { asin64(self) }\n    // The arccosine, in [0, pi]; NaN outside [-1, 1].\n    #[effects(diverge)]\n    pub fn acos(self) -> f64 { acos64(self) }\n    // The arctangent, in [-pi/2, pi/2].\n    #[effects(panic)]\n    pub fn atan(self) -> f64 { atan64(self) }\n    // The angle of the point (other, self): self is y, other is x, the\n    // result in [-pi, pi].\n    #[effects(panic)]\n    pub fn atan2(self, other: f64) -> f64 { atan2_64(self, other) }\n    // e^self.\n    #[effects()]\n    pub fn exp(self) -> f64 { exp64(self) }\n    // 2^self.\n    #[effects()]\n    pub fn exp2(self) -> f64 { exp2_64(self) }\n    // The natural logarithm; -inf at 0, NaN below 0.\n    #[effects()]\n    pub fn ln(self) -> f64 { ln64(self) }\n    #[effects()]\n    pub fn log2(self) -> f64 { log2_64(self) }\n    #[effects()]\n    pub fn log10(self) -> f64 { log10_64(self) }\n");
    buf_str(out, c"    // The logarithm to the base `base`: self.ln() / base.ln().\n    #[effects()]\n    pub fn log(self, base: f64) -> f64 { ln64(self) / ln64(base) }\n    // self^n, C's pow (exact for exact cases: 2^10, 9^0.5).\n    #[effects(panic, diverge)]\n    pub fn powf(self, n: f64) -> f64 { pow64(self, n) }\n    // self^n by repeated squaring (a negative n is 1 / self^-n).\n    #[effects(diverge)]\n    pub fn powi(self, n: i32) -> f64 { powi64(self, n) }\n    // The least number greater than self: the smallest positive\n    // subnormal after either zero, +inf after MAX, +inf and NaN unchanged.\n    #[effects()]\n    pub fn next_up(self) -> f64 { next64(self, true) }\n    // The greatest number less than self.\n    #[effects()]\n    pub fn next_down(self) -> f64 { next64(self, false) }\n    // The quotient rounded so that self - rhs * q is the rem_euclid.\n    #[effects()]\n    pub fn div_euclid(self, rhs: f64) -> f64 {\n        let q = trunc64(self / rhs);\n        if self % rhs < 0.0 {\n            return if rhs > 0.0 { q - 1.0 } else { q + 1.0 };\n        }\n        q\n    }\n    // The least nonnegative remainder of self / rhs.\n    #[effects()]\n    pub fn rem_euclid(self, rhs: f64) -> f64 {\n        let r = self % rhs;\n        if r < 0.0 { r + rhs.abs() } else { r }\n    }\n    // IEEE 754's totalOrder: -NaN < -inf < .. < -0.0 < +0.0 < .. < +inf <\n    // +NaN (for `v.sort_by(|a, b| a.total_cmp(b))`).\n    #[effects()]\n    pub fn total_cmp(&self, other: &f64) -> crate::cmp::Ordering {\n        let mut l = f64_to_bits(*self) as i64;\n        let mut r = f64_to_bits(*other) as i64;\n        l ^= (((l >> 63) as u64) >> 1) as i64;\n        r ^= (((r >> 63) as u64) >> 1) as i64;\n        l.cmp(&r)\n    }\n}\n\n// f32's inherent methods (Rust's): as f64's; most are f64's, rounded once\n// (exact in f64 where the result is an integer).\nimpl f32 {\n    // The IEEE 754 bits.\n    #[effects()]\n    pub fn to_bits(self) -> u32 { f32_to_bits(self) }\n");
    buf_str(out, c"    // The f32 with these IEEE 754 bits.\n    #[effects()]\n    pub fn from_bits(v: u32) -> f32 { f32_from_bits(v) }\n    #[effects()]\n    pub fn abs(self) -> f32 { f32_from_bits(f32_to_bits(self) & 0x7fffffff) }\n    #[effects()]\n    pub fn signum(self) -> f32 {\n        if self != self { self } else { f32_from_bits(f32_to_bits(self) & 0x80000000 | 0x3f800000) }\n    }\n    #[effects()]\n    pub fn copysign(self, sign: f32) -> f32 {\n        f32_from_bits(f32_to_bits(self) & 0x7fffffff | f32_to_bits(sign) & 0x80000000)\n    }\n    #[effects()]\n    pub fn is_nan(self) -> bool { self != self }\n    #[effects()]\n    pub fn is_finite(self) -> bool { f32_to_bits(self) & 0x7fffffff < 0x7f800000 }\n    #[effects()]\n    pub fn is_infinite(self) -> bool { f32_to_bits(self) & 0x7fffffff == 0x7f800000 }\n    #[effects()]\n    pub fn is_normal(self) -> bool {\n        let e = (f32_to_bits(self) >> 23) & 0xff;\n        e != 0 && e != 0xff\n    }\n    #[effects()]\n    pub fn is_subnormal(self) -> bool {\n        let b = f32_to_bits(self) & 0x7fffffff;\n        b != 0 && b < 0x00800000\n    }\n    #[effects()]\n    pub fn is_sign_positive(self) -> bool { f32_to_bits(self) >> 31 == 0 }\n    #[effects()]\n    pub fn is_sign_negative(self) -> bool { f32_to_bits(self) >> 31 != 0 }\n    #[effects()]\n    pub fn floor(self) -> f32 { floor64(self as f64) as f32 }\n    #[effects()]\n    pub fn ceil(self) -> f32 { ceil64(self as f64) as f32 }\n    #[effects()]\n    pub fn round(self) -> f32 { round64(self as f64) as f32 }\n    #[effects()]\n    pub fn round_ties_even(self) -> f32 { round_even64(self as f64) as f32 }\n    #[effects()]\n    pub fn trunc(self) -> f32 { trunc64(self as f64) as f32 }\n    #[effects()]\n    pub fn fract(self) -> f32 { self - trunc64(self as f64) as f32 }\n    #[effects()]\n    pub fn min(self, other: f32) -> f32 { min64(self as f64, other as f64) as f32 }\n    #[effects()]\n");
    buf_str(out, c"    pub fn max(self, other: f32) -> f32 { max64(self as f64, other as f64) as f32 }\n    // self restricted to min..=max; panics when min > max or either is\n    // NaN, as Rust's.\n    #[effects(panic)]\n    pub fn clamp(self, min: f32, max: f32) -> f32 {\n        if !(min <= max) {\n            crate::panic::panic(\"min > max, or either was NaN\");\n        }\n        let mut r = self;\n        if r < min {\n            r = min;\n        }\n        if r > max {\n            r = max;\n        }\n        r\n    }\n    #[effects()]\n    pub fn recip(self) -> f32 { 1.0 / self }\n    // (Rust's constants: pi / 180 and 180 / pi rounded once to f32)\n    #[effects()]\n    pub fn to_radians(self) -> f32 { self * 0.017453292519943295769236907684886127 }\n    #[effects()]\n    pub fn to_degrees(self) -> f32 { self * 57.2957795130823208767981548141051703 }\n    // (f64's sqrt rounded to f32 is f32's correctly rounded sqrt: 53 >= 2 * 24 + 2)\n    #[effects(diverge)]\n    pub fn sqrt(self) -> f32 { sqrt64(self as f64) as f32 }\n    #[effects()]\n    pub fn cbrt(self) -> f32 { cbrt64(self as f64) as f32 }\n    // (in f64: the squares exact, no overflow)\n    #[effects(diverge)]\n    pub fn hypot(self, other: f32) -> f32 {\n        let a = self as f64;\n        let b = other as f64;\n        if a.is_infinite() || b.is_infinite() {\n            return f32::INFINITY;\n        }\n        sqrt64(a * a + b * b) as f32\n    }\n    #[effects(panic, diverge)]\n    pub fn sin(self) -> f32 { sin64(self as f64) as f32 }\n    #[effects(panic, diverge)]\n    pub fn cos(self) -> f32 { cos64(self as f64) as f32 }\n    #[effects(panic, diverge)]\n    pub fn tan(self) -> f32 { tan64(self as f64) as f32 }\n    #[effects(panic, diverge)]\n    pub fn sin_cos(self) -> (f32, f32) {\n        let (s, c) = sin_cos64(self as f64);\n        (s as f32, c as f32)\n    }\n    #[effects(diverge)]\n    pub fn asin(self) -> f32 { asin64(self as f64) as f32 }\n    #[effects(diverge)]\n");
    buf_str(out, c"    pub fn acos(self) -> f32 { acos64(self as f64) as f32 }\n    #[effects(panic)]\n    pub fn atan(self) -> f32 { atan64(self as f64) as f32 }\n    #[effects(panic)]\n    pub fn atan2(self, other: f32) -> f32 { atan2_64(self as f64, other as f64) as f32 }\n    #[effects()]\n    pub fn exp(self) -> f32 { exp64(self as f64) as f32 }\n    #[effects()]\n    pub fn exp2(self) -> f32 { exp2_64(self as f64) as f32 }\n    #[effects()]\n    pub fn ln(self) -> f32 { ln64(self as f64) as f32 }\n    #[effects()]\n    pub fn log2(self) -> f32 { log2_64(self as f64) as f32 }\n    #[effects()]\n    pub fn log10(self) -> f32 { log10_64(self as f64) as f32 }\n    #[effects()]\n    pub fn log(self, base: f32) -> f32 { (ln64(self as f64) / ln64(base as f64)) as f32 }\n    #[effects(panic, diverge)]\n    pub fn powf(self, n: f32) -> f32 { pow64(self as f64, n as f64) as f32 }\n    #[effects(diverge)]\n    pub fn powi(self, n: i32) -> f32 { powi64(self as f64, n) as f32 }\n    #[effects()]\n    pub fn next_up(self) -> f32 { next32(self, true) }\n    #[effects()]\n    pub fn next_down(self) -> f32 { next32(self, false) }\n    #[effects()]\n    pub fn div_euclid(self, rhs: f32) -> f32 {\n        let q = trunc64((self / rhs) as f64) as f32;\n        if self % rhs < 0.0 {\n            return if rhs > 0.0 { q - 1.0 } else { q + 1.0 };\n        }\n        q\n    }\n    #[effects()]\n    pub fn rem_euclid(self, rhs: f32) -> f32 {\n        let r = self % rhs;\n        if r < 0.0 { r + rhs.abs() } else { r }\n    }\n    #[effects()]\n    pub fn total_cmp(&self, other: &f32) -> crate::cmp::Ordering {\n        let mut l = f32_to_bits(*self) as i32;\n        let mut r = f32_to_bits(*other) as i32;\n        l ^= (((l >> 31) as u32) >> 1) as i32;\n        r ^= (((r >> 31) as u32) >> 1) as i32;\n        l.cmp(&r)\n    }\n}\n\n// pi, for the conversions above.\nconst PI64: f64 = 3.14159265358979323846264338327950288;\n// ---- end mod std::fmath ----\n}\n// ---- mod std::unicode ----\npub mod unicode {\n");
    buf_str(out, c"// EDITION: rust\n// std::unicode (0.20; std2 0.28.0). Two parts. Private, for char and str:\n// char's classification (is_alphabetic,\n// is_numeric, is_whitespace, is_lowercase, is_uppercase) and case\n// (to_lowercase, to_uppercase), Unicode 18.0.0's, as MVS's std::unicode\n// has them. The tables are MVS's std/unicode/tables.vl's, generated from\n// the Unicode Character Database (v0.26.2's tools/unicode/gen.vl): do not\n// edit them by hand. Public, vole's own (Rust's std has neither): the\n// properties of a code point, grapheme clusters and display width, below\n// the case tables, for a terminal or an editor (GraphemeState,\n// ClusterWidth, graphemes, str_width, ..).\n// mvs: std::unicode\n\nuse crate::iter::Iterator;\nuse crate::option::Option;\n\n// Every byte of the tables below is written plus TABLE_BIAS (wrapping),\n// so that small numbers are one printable character each: table_byte\n// subtracts it. A table is a string literal read only as its bytes\n// (`as_bytes`), with `\\xHH` escapes above 0x7F (vole's literal is its\n// bytes): the front has no byte-string literal yet.\nconst TABLE_BIAS: u8 = 33;\n\n// Byte i of a table.\nfn table_byte(t: &str, i: usize) -> usize {\n    t.as_bytes()[i].wrapping_sub(TABLE_BIAS) as usize\n}\n\nconst CLASS_ALPHABETIC: u8 = 1;\nconst CLASS_NUMERIC: u8 = 2;\nconst CLASS_WHITE_SPACE: u8 = 4;\nconst CLASS_LOWERCASE: u8 = 8;\nconst CLASS_UPPERCASE: u8 = 16;\n\n// The class bits of code point cp (CLASS_*): a trie of three levels.\nfn classes(cp: u32) -> u8 {\n    let c: usize = if cp > 0x10ffff { 0x10ffff } else { cp as usize };\n    let i1 = c >> CLASSES_SHIFT1;\n    let mid = if CLASSES_WIDE1 {\n        table_byte(CLASSES_S1, 2 * i1) | (table_byte(CLASSES_S1, 2 * i1 + 1) << 8)\n    } else {\n        table_byte(CLASSES_S1, i1)\n    };\n    let i2 = (mid << (CLASSES_SHIFT1 - CLASSES_SHIFT2)) | ((c >> CLASSES_SHIFT2) & CLASSES_MASK2);\n    let leaf = if CLASSES_WIDE2 {\n");
    buf_str(out, c"        table_byte(CLASSES_S2, 2 * i2) | (table_byte(CLASSES_S2, 2 * i2 + 1) << 8)\n    } else {\n        table_byte(CLASSES_S2, i2)\n    };\n    table_byte(CLASSES_LEAVES, (leaf << CLASSES_SHIFT2) | (c & CLASSES_MASK3)) as u8\n}\n\n// Unicode's Alphabetic (char::is_alphabetic).\n#[effects(panic)]\npub(crate) fn is_alphabetic(cp: u32) -> bool {\n    (classes(cp) & CLASS_ALPHABETIC) != 0\n}\n\n// General_Category Nd, Nl or No (char::is_numeric).\n#[effects(panic)]\npub(crate) fn is_numeric(cp: u32) -> bool {\n    (classes(cp) & CLASS_NUMERIC) != 0\n}\n\n// Unicode's White_Space (char::is_whitespace).\n#[effects(panic)]\npub(crate) fn is_whitespace(cp: u32) -> bool {\n    (classes(cp) & CLASS_WHITE_SPACE) != 0\n}\n\n// Unicode's Lowercase (char::is_lowercase).\n#[effects(panic)]\npub(crate) fn is_lowercase(cp: u32) -> bool {\n    (classes(cp) & CLASS_LOWERCASE) != 0\n}\n\n// Unicode's Uppercase (char::is_uppercase).\n#[effects(panic)]\npub(crate) fn is_uppercase(cp: u32) -> bool {\n    (classes(cp) & CLASS_UPPERCASE) != 0\n}\n\n// The 3-byte little-endian number at t[i].\nfn case_u24(t: &str, i: usize) -> u32 {\n    (table_byte(t, i) | (table_byte(t, i + 1) << 8) | (table_byte(t, i + 2) << 16)) as u32\n}\n\n// cp's mapping in a case table of n sorted (cp, mapping) entries, searched\n// by halves: up to 3 code points, the rest 0; cp itself when the table\n// has none.\nfn case_map(table: &str, multi: &str, n: usize, cp: u32) -> [u32; 3] {\n    let mut lo: usize = 0;\n    let mut hi = n;\n    while lo < hi {\n        let mid = (lo + hi) / 2;\n        let k = case_u24(table, mid * 6);\n        if k < cp {\n            lo = mid + 1;\n        } else if k > cp {\n            hi = mid;\n        } else {\n            let m = case_u24(table, mid * 6 + 3);\n            if (m & 0x800000) != 0 {\n                let j = ((m & 0x7fffff) * 9) as usize;\n                return [case_u24(multi, j), case_u24(multi, j + 3), case_u24(multi, j + 6)];\n            }\n");
    buf_str(out, c"            return [m, 0, 0];\n        }\n    }\n    [cp, 0, 0]\n}\n\n// The lowercase of cp, not ASCII: one to three code points, the rest 0\n// (unconditional: `İ` is `i` and U+0307).\n#[effects(panic, diverge)]\npub(crate) fn to_lower(cp: u32) -> [u32; 3] {\n    case_map(LOWER_TABLE, LOWER_MULTI, LOWER_COUNT, cp)\n}\n\n// The uppercase of cp, not ASCII: one to three code points, the rest 0\n// (`ß` is `SS`).\n#[effects(panic, diverge)]\npub(crate) fn to_upper(cp: u32) -> [u32; 3] {\n    case_map(UPPER_TABLE, UPPER_MULTI, UPPER_COUNT, cp)\n}\n\n// ---- The tables ----\n\nconst CLASSES_SHIFT2: usize = 4;\nconst CLASSES_SHIFT1: usize = 9;\nconst CLASSES_MASK2: usize = 31;\nconst CLASSES_MASK3: usize = 15;\nconst CLASSES_WIDE1: bool = false;\nconst CLASSES_WIDE2: bool = true;\nconst CLASSES_S1: &str = \"!\\x22#$%&'()*+,-./01234225678999999\\\n    999999:9999999999999999999999999\\\n    999999999999999999;<=>9999999999\\\n    99999999999?2222222222222222@\\x41\\x42\\x43\\\n    \\x44\\x45\\x46\\x47\\x48\\x49\\x4a\\x4b\\x4c\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x539\\x54\\x55\\x56222\\x5799\\x5899999\\\n    9\\x599\\x5a222222222222\\x5b2229\\x5c\\x5d\\x5e99999999\\\n    999999\\x5f9\\x6022222222222222\\x61\\x62\\x632222\\x642\\\n    222222\\x6522\\x66\\x67\\x68222\\x69\\x6a\\x6b\\x6c\\x6d\\x6e2\\x6f\\x70\\x712222\\x7222\\\n    99999999999999999999999999999999\\\n    99999999999999999999999999999999\\\n    9999999999999999999\\x7399999999\\x74999\\\n    9999999\\x759999999999999\\x769\\x7722229\\x7822\\\n    999999999\\x799999999999999999\\x7a22222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    222222229999999999999999999999\\x7b2\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n");
