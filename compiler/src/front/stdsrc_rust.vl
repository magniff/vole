    buf_str(out, c"// One step of splitmix64 on state: the next output.\n#[effects()]\npub fn splitmix64_next(state: &mut u64) -> u64 {\n    *state = state.wrapping_add(0x9e3779b97f4a7c15);\n    let mut z = *state;\n    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n    z ^ (z >> 31)\n}\n\nimpl Xoshiro256pp {\n    // The generator seeded from n through splitmix64 (rand_xoshiro's\n    // seed_from_u64): pure, the same everywhere.\n    #[effects()]\n    pub fn seed_from_u64(n: u64) -> Xoshiro256pp {\n        let mut st = n;\n        let a = splitmix64_next(&mut st);\n        let b = splitmix64_next(&mut st);\n        let c = splitmix64_next(&mut st);\n        let d = splitmix64_next(&mut st);\n        Xoshiro256pp { s0: a, s1: b, s2: c, s3: d }\n    }\n\n    // The generator with this state (not all zero: an all-zero state is\n    // replaced by seed_from_u64(0)'s, as rand_xoshiro does).\n    #[effects()]\n    pub fn from_state(s: [u64; 4]) -> Xoshiro256pp {\n        if s[0] == 0 && s[1] == 0 && s[2] == 0 && s[3] == 0 {\n            return Xoshiro256pp::seed_from_u64(0);\n        }\n        Xoshiro256pp { s0: s[0], s1: s[1], s2: s[2], s3: s[3] }\n    }\n\n    // Its state, for from_state.\n    #[effects()]\n    pub fn state(&self) -> [u64; 4] {\n        [self.s0, self.s1, self.s2, self.s3]\n    }\n\n    // The generator seeded from the system's entropy (getentropy); panics\n    // when the system has none to give.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn from_entropy() -> Xoshiro256pp {\n        let mut b: [u8; 32] = [0; 32];\n        let mut s: [u64; 4] = [0, 0, 0, 0];\n        if !fill_bytes_os(&mut b) {\n            crate::panic::panic(\"from_entropy: the system gave no entropy\");\n        }\n        for i in 0..32 {\n            s[i / 8] |= (b[i] as u64) << ((i % 8) * 8) as u64;\n        }\n        Xoshiro256pp::from_state(s)\n    }\n\n    // The next 64 random bits.\n    #[inline]\n");
    buf_str(out, c"    #[effects()]\n    pub fn next_u64(&mut self) -> u64 {\n        let s0 = self.s0;\n        let s3 = self.s3;\n        let sum = s0.wrapping_add(s3);\n        let result = ((sum << 23) | (sum >> 41)).wrapping_add(s0);\n        let t = self.s1 << 17;\n        let s2 = self.s2 ^ s0;\n        let s3b = s3 ^ self.s1;\n        let s1 = self.s1 ^ s2;\n        let s0b = s0 ^ s3b;\n        self.s0 = s0b;\n        self.s1 = s1;\n        self.s2 = s2 ^ t;\n        self.s3 = (s3b << 45) | (s3b >> 19);\n        result\n    }\n\n    // The next 32 random bits (the high half of next_u64, as rand_xoshiro).\n    #[effects()]\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n    // A uniform u64 in [lo, hi); panics when the range is empty.\n    #[effects(panic)]\n    pub fn random_range_u64(&mut self, lo: u64, hi: u64) -> u64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64(hi - lo)\n    }\n\n    // A uniform i64 in [lo, hi); panics when the range is empty.\n    #[effects(panic)]\n    pub fn random_range_i64(&mut self, lo: i64, hi: i64) -> i64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        let n = (hi as u64).wrapping_sub(lo as u64);\n        (lo as u64).wrapping_add(self.below_u64(n)) as i64\n    }\n\n    // A uniform usize in [lo, hi), for indices; panics when the range is\n    // empty.\n    #[effects(panic)]\n    pub fn random_range_usize(&mut self, lo: usize, hi: usize) -> usize {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64((hi - lo) as u64) as usize\n    }\n\n    // A uniform u64 in [0, n), n > 0: Lemire's method. A draw is rejected\n    // with probability under n / 2^64; after 128 rejections in a row (less\n    // likely than 2^-128) the last one is taken.\n    #[inline]\n    #[effects()]\n");
    buf_str(out, c"    pub fn below_u64(&mut self, n: u64) -> u64 {\n        let mut x = self.next_u64();\n        let mut lo = x.wrapping_mul(n);\n        if lo < n {\n            let t = n.wrapping_neg() % n;\n            for _ in 0..128 {\n                if lo >= t {\n                    break;\n                }\n                x = self.next_u64();\n                lo = x.wrapping_mul(n);\n            }\n        }\n        mul_hi(x, n)\n    }\n\n    // A uniform f64 in [0, 1): 53 random bits.\n    #[effects()]\n    pub fn unit_f64(&mut self) -> f64 {\n        (self.next_u64() >> 11) as f64 * 0.00000000000000011102230246251565\n    }\n\n    // true with probability p (0 <= p <= 1; panics otherwise).\n    #[effects(panic)]\n    pub fn random_bool(&mut self, p: f64) -> bool {\n        if !(p >= 0.0 && p <= 1.0) {\n            crate::panic::panic(\"random_bool: p is not in [0, 1]\");\n        }\n        if p == 1.0 {\n            return true;\n        }\n        // (p * 2^64 < 2^64)\n        let cut = (p * 18446744073709551616.0) as u64;\n        self.next_u64() < cut\n    }\n\n    // Fills buf with random bytes: each next_u64's bytes, least\n    // significant first.\n    // std2: changed: buf a &mut [u8]\n    #[effects(panic, diverge)]\n    pub fn fill_bytes(&mut self, buf: &mut [u8]) {\n        let mut i: usize = 0;\n        while i < buf.len() {\n            let mut x = self.next_u64();\n            let mut k = 0;\n            while k < 8 && i < buf.len() {\n                buf[i] = x as u8;\n                x >>= 8;\n                i += 1;\n                k += 1;\n            }\n        }\n    }\n\n    // Moves the generator 2^128 steps ahead (xoshiro's jump): for 2^128\n    // non-overlapping sequences.\n    #[effects()]\n    pub fn jump(&mut self) {\n        let jump: [u64; 4] = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa,\n            0x39abdc4529b1661c];\n        let mut a: u64 = 0;\n        let mut b: u64 = 0;\n        let mut c: u64 = 0;\n");
    buf_str(out, c"        let mut d: u64 = 0;\n        for i in 0..4 {\n            for bit in 0..64 {\n                if (jump[i] & (1u64 << bit as u64)) != 0 {\n                    a ^= self.s0;\n                    b ^= self.s1;\n                    c ^= self.s2;\n                    d ^= self.s3;\n                }\n                self.next_u64();\n            }\n        }\n        self.s0 = a;\n        self.s1 = b;\n        self.s2 = c;\n        self.s3 = d;\n    }\n}\n\n// Shuffles s uniformly (Fisher-Yates, from the end, as rand's shuffle).\n// std2: changed: s a &mut [T], rng a &mut Xoshiro256pp\n#[effects(diverge, T)]\npub fn shuffle<T>(s: &mut [T], rng: &mut Xoshiro256pp) {\n    let n = s.len();\n    let mut i = n;\n    while i > 1 {\n        i -= 1;\n        let j = rng.below_u64((i + 1) as u64) as usize;\n        s.swap(i, j);\n    }\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 bytes a\n// call); false when the system fails. Rust's getrandom.\n// std2: changed: buf a &mut [u8]\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn fill_bytes_os(buf: &mut [u8]) -> bool {\n    let mut at: usize = 0;\n    while at < buf.len() {\n        let n = if buf.len() - at < 256 { buf.len() - at } else { 256 };\n        let rest = &mut buf[at..at + n];\n        // UNSAFE: the OS writes through a raw pointer.\n        // SAFETY: rest is a live &mut [u8] of n <= 256 bytes, borrowed for\n        // the call; getentropy writes at most n bytes there.\n        if unsafe { c_getentropy(rest.as_mut_ptr(), n) } != 0 {\n            return false;\n        }\n        at += n;\n    }\n    true\n}\n// ---- end mod std::random ----\n}\n// ---- mod std::sys ----\npub mod sys {\n// EDITION: rust\n// std::sys (0.20; std2 0.28.0): the OS layer, thin bindings of the C\n// library, MVS's std::sys in the rust edition. vole's own: Rust's std::sys\n// is private, and this is the libc crate's level, with the `sys_` names\n");
    buf_str(out, c"// and `Result<T, i32>` errnos MVS's had. std::fs, std::process and\n// std::env are Rust's API over the OS; this is for what they do not\n// cover (terminals, pseudo-terminals, poll, descriptors, signals).\n// mvs: std::sys\n\nuse crate::convert::AsRef;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// The target's numbers (std2/rt/sys_macos.vl, sys_linux.vl, which the\n// compiler puts in std::__sys).\npub const SYS_CLOCK_MONOTONIC: i32 = crate::__sys::CLOCK_MONOTONIC;\npub const SYS_EAGAIN: i32 = crate::__sys::EAGAIN;\npub const SYS_ELOOP: i32 = crate::__sys::ELOOP;\npub const SYS_ENAMETOOLONG: i32 = crate::__sys::ENAMETOOLONG;\npub const SYS_ENOSYS: i32 = crate::__sys::ENOSYS;\npub const SYS_ENOTEMPTY: i32 = crate::__sys::ENOTEMPTY;\npub const SYS_ENOTSUP: i32 = crate::__sys::ENOTSUP;\npub const SYS_ETIMEDOUT: i32 = crate::__sys::ETIMEDOUT;\npub const SYS_O_APPEND: i32 = crate::__sys::O_APPEND;\npub const SYS_O_CLOEXEC: i32 = crate::__sys::O_CLOEXEC;\npub const SYS_O_CREAT: i32 = crate::__sys::O_CREAT;\npub const SYS_O_DIRECTORY: i32 = crate::__sys::O_DIRECTORY;\npub const SYS_O_EXCL: i32 = crate::__sys::O_EXCL;\npub const SYS_O_NOCTTY: i32 = crate::__sys::O_NOCTTY;\npub const SYS_O_NONBLOCK: i32 = crate::__sys::O_NONBLOCK;\npub const SYS_O_TRUNC: i32 = crate::__sys::O_TRUNC;\npub const SYS_SIGCHLD: i32 = crate::__sys::SIGCHLD;\npub const SYS_TIOCGWINSZ: u64 = crate::__sys::TIOCGWINSZ;\npub const SYS_TIOCSCTTY: u64 = crate::__sys::TIOCSCTTY;\npub const SYS_TIOCSWINSZ: u64 = crate::__sys::TIOCSWINSZ;\npub const TARGET_OS: i64 = crate::__sys::TARGET_OS;\npub const SYS_PATH_MAX: i64 = crate::__sys::PATH_MAX as i64;\n\n// ---- Sys: errors (0.20) ----\n\n// The OS layer (0.20, docs/design/collections-text-io.md §2.6.1, task A7):\n// thin bindings of the C library, the same on macOS and Linux; what differs\n// between them (flag and errno values, errno's address) is in the target's\n");
    buf_str(out, c"// std::__sys (std2/rt/sys_macos.vl, sys_linux.vl), and a struct whose layout differs\n// is declared once per system (`StatMacos`, `StatLinux`) and chosen by\n// `TARGET_OS`, a constant. Every call's result is a `Result<T, i32>`: the\n// value, or the errno it failed with (`sys_errno_kind` names it). Nothing\n// here retries on EINTR or allocates; paths reach C through a NUL-ended copy\n// in a stack buffer (`sys_cpath`): a path with a NUL in it, or longer than\n// the system's PATH_MAX, fails with EINVAL or ENAMETOOLONG before any call.\n// Every descriptor std opens (`sys_open`, `sys_pipe`, `sys_openpty`) is\n// close-on-exec, so that a spawned program gets only what it is given.\n// Unsafe code: each binding passes C a pointer and a length from a slice it\n// was given, or a pointer to a local or a borrowed struct of the size C\n// writes (the layouts are checked against the headers by tests/run/\n// sys_layout.vl); a slice made from a C string (`sys_cstr_view`) is valid\n// while that string is.\n\n// UNSAFE: C's strlen reads memory up to a NUL through a raw pointer.\n// SAFETY: its prototype is C's (string.h); sys_cstr_view, its one caller,\n// passes a non-null pointer its own caller promises is a NUL-ended string.\nextern \"C\" {\n    #[link_name = \"strlen\"]\n    #[effects()]\n    fn sys_c_strlen(s: *const u8) -> u64;\n}\n\npub const SYS_EPERM: i32 = 1;\npub const SYS_ENOENT: i32 = 2;\npub const SYS_ESRCH: i32 = 3;\npub const SYS_EINTR: i32 = 4;\npub const SYS_EIO: i32 = 5;\npub const SYS_EBADF: i32 = 9;\npub const SYS_ECHILD: i32 = 10;\npub const SYS_ENOMEM: i32 = 12;\npub const SYS_EACCES: i32 = 13;\npub const SYS_EEXIST: i32 = 17;\npub const SYS_EXDEV: i32 = 18;\npub const SYS_ENOTDIR: i32 = 20;\npub const SYS_EISDIR: i32 = 21;\npub const SYS_EINVAL: i32 = 22;\npub const SYS_ENOSPC: i32 = 28;\npub const SYS_EROFS: i32 = 30;\npub const SYS_EPIPE: i32 = 32;\n\n// The kinds of io::Error (§2.6.2) an errno falls into (0.20's\n");
    buf_str(out, c"// io::ErrorKind takes these variants).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum SysErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\n// The errno of the last C call that failed (C's `errno`).\n#[effects(static, unsafe)]\npub fn sys_errno() -> i32 {\n    // UNSAFE: errno is C's thread-local int, reached only through the C\n    // library's pointer to it.\n    // SAFETY: sys_errno_location (__error, __errno_location) returns this\n    // thread's errno, an aligned int valid for the thread's life.\n    unsafe { *crate::__sys::errno_location() }\n}\n\n// Sets errno (to 0 before a call whose only failure report is errno).\n#[effects(static, unsafe)]\npub fn sys_set_errno(e: i32) {\n    // UNSAFE: as sys_errno.\n    // SAFETY: as sys_errno: this thread's errno, which only it writes.\n    unsafe {\n        *crate::__sys::errno_location() = e;\n    }\n}\n\n// The kind of error errno e is, as Rust's std decodes it.\n#[effects()]\npub fn sys_errno_kind(e: i32) -> SysErrorKind {\n    if e == SYS_ENOENT {\n        SysErrorKind::NotFound\n    } else if e == SYS_EPERM || e == SYS_EACCES {\n        SysErrorKind::PermissionDenied\n    } else if e == SYS_EEXIST {\n        SysErrorKind::AlreadyExists\n    } else if e == SYS_EAGAIN {\n        SysErrorKind::WouldBlock\n    } else if e == SYS_EINVAL || e == SYS_ENAMETOOLONG {\n        SysErrorKind::InvalidInput\n    } else if e == SYS_ETIMEDOUT {\n        SysErrorKind::TimedOut\n    } else if e == SYS_EINTR {\n        SysErrorKind::Interrupted\n    } else if e == SYS_EPIPE {\n        SysErrorKind::BrokenPipe\n    } else if e == SYS_ENOTDIR {\n        SysErrorKind::NotADirectory\n    } else if e == SYS_EISDIR {\n        SysErrorKind::IsADirectory\n");
    buf_str(out, c"    } else if e == SYS_ENOTEMPTY {\n        SysErrorKind::DirectoryNotEmpty\n    } else if e == SYS_ENOSYS || e == SYS_ENOTSUP {\n        SysErrorKind::Unsupported\n    } else if e == SYS_ENOMEM {\n        SysErrorKind::OutOfMemory\n    } else {\n        SysErrorKind::Other\n    }\n}\n\n// C's message for errno e (`strerror`) copied into out, cut to its length:\n// the bytes written.\n#[effects(panic, diverge, unsafe)]\npub fn sys_strerror_into(e: i32, out: &mut [u8]) -> i64 {\n    // (0.25.4) strerror_r, not strerror: strerror may keep the message in\n    // one buffer for every thread.\n    let mut buf = [0u8; 256];\n    // UNSAFE: C's strerror_r writes the message through a raw pointer.\n    // SAFETY: buf is a local of 256 bytes and strerror_r is given 255, so\n    // the message and its NUL stay in buf and buf[255] stays 0 (a message\n    // cut short ends with a NUL too; an unknown errno gets C's \"Unknown\n    // error\" text).\n    let _ = unsafe { crate::__sys::strerror_r(e, buf.as_mut_ptr(), 255) };\n    let mut n: i64 = 0;\n    while n < out.len() as i64 && buf[n as usize] != 0 {\n        out[n as usize] = buf[n as usize];\n        n += 1;\n    }\n    n\n}\n\n// The bytes of the NUL-ended C string at p, without the NUL; empty for a\n// null p. The caller promises that p is null or a NUL-ended string, valid\n// while the slice is used.\n#[effects(unsafe)]\n// UNSAFE: makes a slice from a raw C pointer, whose extent only its NUL\n// tells.\n// SAFETY: (the caller's obligation, above) p is null, or a NUL-ended\n// string that outlives the slice; strlen stops at that NUL, so the slice\n// covers readable bytes only.\npub unsafe fn sys_cstr_view<'a>(p: *const u8) -> &'a [u8] {\n    if p.is_null() {\n        return &EMPTY;\n    }\n    crate::slice::from_raw_parts(p, sys_c_strlen(p) as usize)\n}\n\nstatic EMPTY: [u8; 0] = [];\n\n// The result of a C call returning -1 on failure, as a Result.\nfn sys_check(r: i64) -> Result<i64, i32> {\n    if r == -1 {\n");
    buf_str(out, c"        Err(sys_errno())\n    } else {\n        Ok(r)\n    }\n}\n\nfn sys_check_unit(r: i32) -> Result<(), i32> {\n    if r == -1 {\n        Err(sys_errno())\n    } else {\n        Ok(())\n    }\n}\n\n// ---- Sys: paths (0.20) ----\n\n// A path for C: the bytes and a NUL, in a buffer on the caller's stack.\n#[derive(Clone, Copy)] pub struct SysPath {\n    buf: [u8; 4096],\n}\n\n// A SysPath holding path and its NUL: ENAMETOOLONG when path does not fit\n// the system's PATH_MAX (1024 bytes on macOS, 4096 on Linux, the NUL\n// included), EINVAL when it has a NUL in it. Pass `&p.buf as *u8` of the\n// local holding it (`p.buf.as_ptr()`: a method taking self by value would see a copy).\n#[effects(panic)]\npub fn sys_cpath<P: AsRef<[u8]>>(path: P) -> Result<SysPath, i32> {\n    let path = path.as_ref();\n    if path.len() as i64 >= SYS_PATH_MAX {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    let mut p = SysPath { buf: [0u8; 4096] };\n    for i in 0..path.len() as i64 {\n        let b = path[i as usize];\n        if b == 0 {\n            return Err(SYS_EINVAL);\n        }\n        p.buf[i as usize] = b;\n    }\n    Ok(p)\n}\n\nimpl SysPath {\n}\n\n// ---- Sys: files (0.20) ----\n\n// UNSAFE: the C library's file calls (POSIX), which take raw pointers.\n// SAFETY: each prototype is POSIX's (fcntl.h, unistd.h, sys/stat.h,\n// stdio.h's rename); open and fcntl are variadic in C and declared so; the\n// wrappers below pass pointers into buffers they own or borrow, with their\n// true lengths.\nextern \"C\" {\n    #[link_name = \"open\"]\n    #[effects(io)]\n    fn sys_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    #[effects(io)]\n    fn sys_c_close(fd: i32) -> i32;\n    #[link_name = \"read\"]\n    #[effects(io)]\n    fn sys_c_read(fd: i32, buf: *mut u8, n: u64) -> i64;\n    #[link_name = \"write\"]\n    #[effects(io)]\n    fn sys_c_write(fd: i32, buf: *const u8, n: u64) -> i64;\n    #[link_name = \"pread\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn sys_c_pread(fd: i32, buf: *mut u8, n: u64, off: i64) -> i64;\n    #[link_name = \"pwrite\"]\n    #[effects(io)]\n    fn sys_c_pwrite(fd: i32, buf: *const u8, n: u64, off: i64) -> i64;\n    #[link_name = \"lseek\"]\n    #[effects(io)]\n    fn sys_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn sys_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    #[effects(io)]\n    fn sys_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fstat\"]\n    #[effects(io)]\n    fn sys_c_fstat(fd: i32, st: *mut u8) -> i32;\n    #[link_name = \"stat\"]\n    #[effects(io)]\n    fn sys_c_stat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"lstat\"]\n    #[effects(io)]\n    fn sys_c_lstat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"mkdir\"]\n    #[effects(io)]\n    fn sys_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    #[effects(io)]\n    fn sys_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    #[effects(io)]\n    fn sys_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    #[effects(io)]\n    fn sys_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"dup\"]\n    #[effects(io)]\n    fn sys_c_dup(fd: i32) -> i32;\n    #[link_name = \"dup2\"]\n    #[effects(io)]\n    fn sys_c_dup2(fd: i32, to: i32) -> i32;\n    #[link_name = \"pipe\"]\n    #[effects(io)]\n    fn sys_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    #[effects(io)]\n    fn sys_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"isatty\"]\n    #[effects(io)]\n    fn sys_c_isatty(fd: i32) -> i32;\n}\n\npub const SYS_O_RDONLY: i32 = 0;\npub const SYS_O_WRONLY: i32 = 1;\npub const SYS_O_RDWR: i32 = 2;\npub const SYS_SEEK_SET: i32 = 0;\npub const SYS_SEEK_CUR: i32 = 1;\npub const SYS_SEEK_END: i32 = 2;\nconst SYS_F_GETFD: i32 = 1;\nconst SYS_F_SETFD: i32 = 2;\nconst SYS_F_GETFL: i32 = 3;\nconst SYS_F_SETFL: i32 = 4;\n");
    buf_str(out, c"const SYS_FD_CLOEXEC: i32 = 1;\n\n// Opens path with flags (SYS_O_RDONLY, ..., | SYS_O_CREAT, ...) and, when it\n// creates the file, the permission bits mode (0x1a4: 0644): the descriptor,\n// close-on-exec (SYS_O_CLOEXEC is added).\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_open<P: AsRef<[u8]>>(path: P, flags: i32, mode: i32) -> Result<i32, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's open takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call;\n    // open's third argument is variadic, an int.\n    let r = unsafe { sys_c_open(p.buf.as_ptr(), flags | SYS_O_CLOEXEC, mode) };\n    Ok(sys_check(r as i64)? as i32)\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_close(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (close).\n    // SAFETY: close takes an int and touches no memory of ours (a bad\n    // descriptor is EBADF).\n    sys_check_unit(unsafe { sys_c_close(fd) })\n}\n\n// Reads up to buf.len() bytes into buf: how many (0 at the end).\n#[effects(io, static, unsafe)]\npub fn sys_read(fd: i32, buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's read writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: read writes at most buf.len()\n    // bytes at buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_read(fd, buf.as_mut_ptr(), buf.len() as u64) })\n}\n\n// Writes some of buf: how many bytes.\n#[effects(io, static, unsafe)]\npub fn sys_write<B: AsRef<[u8]>>(fd: i32, buf: B) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: C's write reads through a raw pointer.\n    // SAFETY: buf is a borrowed slice: write reads at most buf.len() bytes at\n    // buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_write(fd, buf.as_ptr(), buf.len() as u64) })\n}\n\n// Reads into buf from offset off, not moving the file's position.\n#[effects(io, static, unsafe)]\n");
    buf_str(out, c"pub fn sys_pread(fd: i32, buf: &mut [u8], off: i64) -> Result<i64, i32> {\n    // UNSAFE: as sys_read.\n    // SAFETY: as sys_read: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pread(fd, buf.as_mut_ptr(), buf.len() as u64, off) })\n}\n\n// Writes buf at offset off, not moving the file's position.\n#[effects(io, static, unsafe)]\npub fn sys_pwrite<B: AsRef<[u8]>>(fd: i32, buf: B, off: i64) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: as sys_write.\n    // SAFETY: as sys_write: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pwrite(fd, buf.as_ptr(), buf.len() as u64, off) })\n}\n\n// Moves the position to off from SYS_SEEK_SET, _CUR or _END: the new one.\n#[effects(io, static, unsafe)]\npub fn sys_lseek(fd: i32, off: i64, whence: i32) -> Result<i64, i32> {\n    // UNSAFE: a C library call (lseek).\n    // SAFETY: lseek takes integers only and touches no memory of ours.\n    sys_check(unsafe { sys_c_lseek(fd, off, whence) })\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_ftruncate(fd: i32, len: i64) -> Result<(), i32> {\n    // UNSAFE: a C library call (ftruncate).\n    // SAFETY: ftruncate takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_ftruncate(fd, len) })\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_fsync(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (fsync).\n    // SAFETY: fsync takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_fsync(fd) })\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_mkdir<P: AsRef<[u8]>>(path: P, mode: i32) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's mkdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_mkdir(p.buf.as_ptr(), mode as u32) })\n}\n\n#[effects(io, static, panic, unsafe, P)]\n");
    buf_str(out, c"pub fn sys_rmdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's rmdir takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_rmdir(p.buf.as_ptr()) })\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_unlink<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's unlink takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_unlink(p.buf.as_ptr()) })\n}\n\n#[effects(io, static, panic, unsafe, P, Q)]\npub fn sys_rename<P: AsRef<[u8]>, Q: AsRef<[u8]>>(from: P, to: Q) -> Result<(), i32> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = sys_cpath(from)?;\n    let b = sys_cpath(to)?;\n    // UNSAFE: C's rename takes the paths as raw pointers.\n    // SAFETY: a and b hold NUL-ended paths (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_rename(a.buf.as_ptr(), b.buf.as_ptr()) })\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_dup(fd: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup).\n    // SAFETY: dup takes an int and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup(fd) } as i64)? as i32)\n}\n\n// Makes `to` a copy of fd (closing what `to` was); `to` is not\n// close-on-exec.\n#[effects(io, static, unsafe)]\npub fn sys_dup2(fd: i32, to: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup2).\n    // SAFETY: dup2 takes integers only and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup2(fd, to) } as i64)? as i32)\n}\n\n// A pipe: (read end, write end), both close-on-exec.\n#[effects(io, static, unsafe)]\npub fn sys_pipe() -> Result<(i32, i32), i32> {\n    let mut fds: [i32; 2] = [0, 0];\n    // UNSAFE: C's pipe writes through a raw pointer.\n    // SAFETY: fds is a local [i32; 2]: pipe writes two ints there.\n");
    buf_str(out, c"    sys_check_unit(unsafe { sys_c_pipe(fds.as_mut_ptr() as *mut i32) })?;\n    sys_set_cloexec(fds[0], true)?;\n    sys_set_cloexec(fds[1], true)?;\n    Ok((fds[0], fds[1]))\n}\n\n// Sets or clears O_NONBLOCK on fd.\n#[effects(io, static, unsafe)]\npub fn sys_set_nonblocking(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFL takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFL) } as i64)? as i32;\n    let want = if on { fl | SYS_O_NONBLOCK } else { fl & ~SYS_O_NONBLOCK };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFL takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFL, want) })?;\n    }\n    Ok(())\n}\n\n// Sets or clears FD_CLOEXEC on fd.\n#[effects(io, static, unsafe)]\npub fn sys_set_cloexec(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFD takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFD) } as i64)? as i32;\n    let want = if on { fl | SYS_FD_CLOEXEC } else { fl & ~SYS_FD_CLOEXEC };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFD takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFD, want) })?;\n    }\n    Ok(())\n}\n\n// Whether fd is a terminal.\n#[effects(io, unsafe)]\npub fn sys_isatty(fd: i32) -> bool {\n    // UNSAFE: a C library call (isatty).\n    // SAFETY: isatty takes an int and touches no memory of ours.\n    unsafe { sys_c_isatty(fd) == 1 }\n}\n\n// ---- Sys: file status (0.20) ----\n\n// What stat tells of a file, the same on every system.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct FileStat {\n    dev: u64,\n    ino: u64,\n    mode: u32,\n    nlink: u64,\n");
    buf_str(out, c"    uid: u32,\n    gid: u32,\n    rdev: u64,\n    pub size: i64,\n    blocks: i64,\n    blksize: i64,\n    atime_sec: i64,\n    atime_nsec: i64,\n    pub mtime_sec: i64,\n    pub mtime_nsec: i64,\n    ctime_sec: i64,\n    ctime_nsec: i64,\n}\n\npub const SYS_S_IFMT: u32 = 0xf000;\npub const SYS_S_IFDIR: u32 = 0x4000;\npub const SYS_S_IFREG: u32 = 0x8000;\npub const SYS_S_IFLNK: u32 = 0xa000;\n\nimpl FileStat {\n    #[effects()]\n    pub fn is_dir(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFLNK\n    }\n\n    // The permission bits (the low 12 bits of mode).\n    #[effects()]\n    pub fn permissions(self) -> u32 {\n        self.mode & 0xfff\n    }\n}\n\n// struct stat on macOS (arm64, 64-bit inodes): 144 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatMacos {\n    pub st_dev: i32,\n    pub st_mode: u16,\n    pub st_nlink: u16,\n    pub st_ino: u64,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: i32,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_birthtime: i64,\n    st_birthtime_nsec: i64,\n    pub st_size: i64,\n    pub st_blocks: i64,\n    pub st_blksize: i32,\n    st_flags: u32,\n    st_gen: u32,\n    st_lspare: i32,\n    st_qspare: [i64; 2],\n}\n\n// struct stat on Linux (aarch64, glibc): 128 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatLinux {\n    pub st_dev: u64,\n    pub st_ino: u64,\n    pub st_mode: u32,\n    pub st_nlink: u32,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: u64,\n    st_pad1: u64,\n    pub st_size: i64,\n    pub st_blksize: i32,\n    st_pad2: i32,\n    pub st_blocks: i64,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n");
    buf_str(out, c"    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_unused: [i32; 2],\n}\n\n// Room for either system's struct stat.\n#[derive(Clone, Copy)] struct SysStatBuf {\n    words: [u64; 20],\n}\n\n// The FileStat in b, filled by a stat call of this system.\nfn sys_stat_decode(b: SysStatBuf) -> FileStat {\n    if TARGET_OS == 1 {\n        // UNSAFE: reads C's struct stat out of b's words, a reinterpretation.\n        // SAFETY: b holds the struct stat of Linux that stat wrote, 128 of\n        // its 160 bytes (the layout is checked against the headers by\n        // tests/run/sys_layout.vl); the words are 8-aligned, as StatLinux\n        // is; StatLinux is integers only, so any bits are a valid one.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatLinux) };\n        FileStat {\n            dev: s.st_dev,\n            ino: s.st_ino,\n            mode: s.st_mode,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    } else {\n        // UNSAFE: as for Linux, above.\n        // SAFETY: as for Linux: macOS's struct stat, 144 of the 160 bytes,\n        // StatMacos integers only.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatMacos) };\n        FileStat {\n            dev: s.st_dev as u32 as u64,\n            ino: s.st_ino,\n            mode: s.st_mode as u32,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev as u32 as u64,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n");
    buf_str(out, c"            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    }\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_fstat(fd: i32) -> Result<FileStat, i32> {\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's fstat writes a struct stat through a raw pointer.\n    // SAFETY: b.words is a local of 160 bytes, more than either system's\n    // struct stat (144 on macOS, 128 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_fstat(fd, b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, following symbolic links.\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_stat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat takes the path and writes a struct stat, through\n    // raw pointers.\n    // SAFETY: p holds a NUL-ended path (sys_cpath); b as in sys_fstat.\n    sys_check_unit(unsafe { sys_c_stat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, of a symbolic link itself.\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_lstat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: as sys_stat (lstat).\n    // SAFETY: as sys_stat.\n    sys_check_unit(unsafe { sys_c_lstat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// ---- Sys: directories (0.20) ----\n\n// UNSAFE: the C library's directory calls, which take and return raw\n// pointers.\n// SAFETY: each prototype is POSIX's (dirent.h, unistd.h); a DIR * is kept\n");
    buf_str(out, c"// opaque in SysDir, and getcwd is given a slice's pointer and length.\nextern \"C\" {\n    #[link_name = \"opendir\"]\n    #[effects(io)]\n    fn sys_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    #[effects(io)]\n    fn sys_c_readdir(dir: *mut u8) -> *mut u8;\n    #[link_name = \"closedir\"]\n    #[effects(io)]\n    fn sys_c_closedir(dir: *mut u8) -> i32;\n    #[link_name = \"getcwd\"]\n    #[effects(io)]\n    fn sys_c_getcwd(buf: *mut u8, n: u64) -> *mut u8;\n    #[link_name = \"chdir\"]\n    #[effects(io)]\n    fn sys_c_chdir(path: *const u8) -> i32;\n}\n\n// struct dirent on macOS: d_name at 21, d_type at 20.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentMacos {\n    pub d_ino: u64,\n    d_seekoff: u64,\n    d_reclen: u16,\n    d_namlen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 1024],\n}\n\n// struct dirent on Linux (glibc): d_name at 19, d_type at 18.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentLinux {\n    pub d_ino: u64,\n    d_off: i64,\n    d_reclen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 256],\n}\n\n// An open directory (C's DIR *); sys_closedir frees it, and (0.25.4) so\n// does dropping it: a SysDir moves, it is not copied (two copies could\n// close one DIR twice, or read one closed).\npub struct SysDir {\n    handle: *mut u8,\n}\n\nimpl Drop for SysDir {\n    fn drop(&mut self) {\n        if !self.handle.is_null() {\n            let _ = sys_closedir(self);\n        }\n    }\n}\n\n// An entry read by sys_readdir_into: its name's length (the name is in the\n// caller's buffer), its kind (SYS_DT_DIR, ...; SYS_DT_UNKNOWN when the file\n// system does not say) and its inode.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysDirEntry {\n    pub name_len: i64,\n    pub kind: u8,\n    ino: u64,\n}\n\npub const SYS_DT_UNKNOWN: u8 = 0;\npub const SYS_DT_FIFO: u8 = 1;\npub const SYS_DT_CHR: u8 = 2;\npub const SYS_DT_DIR: u8 = 4;\npub const SYS_DT_BLK: u8 = 6;\npub const SYS_DT_REG: u8 = 8;\n");
    buf_str(out, c"pub const SYS_DT_LNK: u8 = 10;\npub const SYS_DT_SOCK: u8 = 12;\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_opendir<P: AsRef<[u8]>>(path: P) -> Result<SysDir, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's opendir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    let d = unsafe { sys_c_opendir(p.buf.as_ptr()) };\n    if d.is_null() {\n        return Err(sys_errno());\n    }\n    Ok(SysDir { handle: d })\n}\n\n// The next entry of dir, its name copied into name (`.` and `..` included,\n// in the order the file system gives them): None at the end.\n#[effects(io, static, panic, unsafe)]\npub fn sys_readdir_into(dir: &mut SysDir, name: &mut [u8; 256]) -> Result<Option<SysDirEntry>,\n    i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    sys_set_errno(0);\n    // UNSAFE: C's readdir on the raw DIR *.\n    // SAFETY: handle is the DIR * opendir returned, non-null (checked)\n    // until sys_closedir clears it; a SysDir is never copied (its Drop), so\n    // no other value closes it under this one.\n    let e = unsafe { sys_c_readdir(dir.handle) };\n    if e.is_null() {\n        let err = sys_errno();\n        return if err == 0 { Ok(None) } else { Err(err) };\n    }\n    let mut kind = 0u8;\n    let mut ino = 0u64;\n    let mut nm: &[u8] = &[];\n    // UNSAFE: reads the struct dirent readdir returned, through its raw\n    // pointer, and views its name.\n    // SAFETY: e is non-null (checked): a struct dirent of this system (the\n    // layouts checked by tests/run/sys_layout.vl), valid until the next\n    // readdir of this DIR; d_name is NUL-ended within it, and nm is copied\n    // into name before this returns.\n    unsafe {\n        if TARGET_OS == 1 {\n            let d = e as *const DirentLinux;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n");
    buf_str(out, c"        } else {\n            let d = e as *const DirentMacos;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        }\n    }\n    if nm.len() as i64 > 256 {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    for i in 0..nm.len() as i64 {\n        name[i as usize] = nm[i as usize];\n    }\n    Ok(Some(SysDirEntry { name_len: nm.len() as i64, kind: kind, ino: ino }))\n}\n\n// Closes dir (once: its handle is cleared).\n#[effects(io, static, unsafe)]\npub fn sys_closedir(dir: &mut SysDir) -> Result<(), i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    // UNSAFE: C's closedir on the raw DIR *.\n    // SAFETY: the open DIR * (non-null, checked), closed once: handle is\n    // cleared right after.\n    let r = unsafe { sys_c_closedir(dir.handle) };\n    dir.handle = 0 as *mut u8;\n    sys_check_unit(r)\n}\n\n// The working directory's path, into buf: its length (ERANGE when buf is\n// too short).\n#[effects(io, static, panic, unsafe)]\npub fn sys_getcwd_into(buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's getcwd writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: getcwd writes at most buf.len()\n    // bytes, its NUL included.\n    let r = unsafe { sys_c_getcwd(buf.as_mut_ptr(), buf.len() as u64) };\n    if r.is_null() {\n        return Err(sys_errno());\n    }\n    let mut n: i64 = 0;\n    for i in 0..buf.len() as i64 {\n        if buf[i as usize] == 0 {\n            break;\n        }\n        n += 1;\n    }\n    Ok(n)\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_chdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's chdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_chdir(p.buf.as_ptr()) })\n}\n\n// ---- Sys: the environment (0.20) ----\n\n");
    buf_str(out, c"// UNSAFE: C's environment: the environ array, and getenv, setenv and\n// unsetenv, which take raw pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, unistd.h); environ is std::__sys's.\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    #[effects(global)]\n    fn sys_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    #[effects(global)]\n    fn sys_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    #[effects(global)]\n    fn sys_c_unsetenv(name: *const u8) -> i32;\n}\n\n// C's `environ`: the NUL-ended strings NAME=VALUE, then a null pointer.\n#[effects(static)]\npub fn sys_environ() -> *const *const u8 {\n    crate::__sys::environ()\n}\n\n// The number of the environment's variables.\n#[effects(static, unsafe)]\npub fn sys_env_count() -> i64 {\n    let e = sys_environ();\n    let mut n: i64 = 0;\n    for i in 0..2147483647 {\n        // UNSAFE: indexes C's environ through its raw pointer.\n        // SAFETY: environ is an array of pointers ended by a null one; the\n        // walk stops at that null (2^31 bounds it), so each e[i] read is in\n        // the array.\n        if unsafe { (*e.add(i as usize)).is_null() } {\n            break;\n        }\n        n += 1;\n    }\n    n\n}\n\n// The environment's i-th variable, `NAME=VALUE` (i < sys_env_count()): a\n// view valid until the environment changes (sys_setenv, sys_unsetenv).\n#[effects(static, panic, unsafe)]\npub fn sys_env_at(i: i64) -> &'static [u8] {\n    if i < 0 || i >= sys_env_count() {\n        panic(\"sys_env_at: index out of bounds\");\n    }\n    // UNSAFE: indexes environ and views a C string, through raw pointers.\n    // SAFETY: 0 <= i < sys_env_count() (checked): environ[i] is a NUL-ended\n    // string, valid until the environment changes, which only the unsafe\n    // sys_setenv and sys_unsetenv do.\n    unsafe { sys_cstr_view((*sys_environ().add(i as usize))) }\n}\n\n");
    buf_str(out, c"// The value of the variable name, a view valid until the environment\n// changes; None when it is not set (or name is not a valid C string).\n#[effects(static, panic, unsafe, P)]\npub fn sys_getenv<P: AsRef<[u8]>>(name: P) -> Option<&'static [u8]> {\n    let name = name.as_ref();\n    let p = match sys_cpath(name) {\n        Ok(p) => p,\n        Err(_) => return None,\n    };\n    // UNSAFE: C's getenv takes the name and returns the value, as raw\n    // pointers.\n    // SAFETY: p holds a NUL-ended name (sys_cpath).\n    let v = unsafe { sys_c_getenv(p.buf.as_ptr()) };\n    if v.is_null() {\n        return None;\n    }\n    // UNSAFE: a view of the C string getenv returned.\n    // SAFETY: v is non-null (checked): a NUL-ended string in the\n    // environment, valid until it changes (only the unsafe sys_setenv and\n    // sys_unsetenv change it).\n    Some(unsafe { sys_cstr_view(v) })\n}\n\n// Sets the variable name to value. Unsafe as in Rust 2024: views of the\n// environment (sys_env_at, sys_getenv) may dangle afterwards, and other\n// threads may be reading it.\n// UNSAFE: changes C's environment, which other code reads through raw\n// pointers.\n// SAFETY: (the caller's obligation) no view of the environment\n// (sys_env_at, sys_getenv) is used after the call, and no other thread\n// reads or changes the environment during it.\n#[effects(static, panic, unsafe, P, Q)]\npub unsafe fn sys_setenv<P: AsRef<[u8]>, Q: AsRef<[u8]>>(name: P, value: Q) -> Result<(), i32> {\n    let name = name.as_ref();\n    let value = value.as_ref();\n    let n = sys_cpath(name)?;\n    let v = sys_cpath(value)?;\n    sys_check_unit(sys_c_setenv(n.buf.as_ptr(), v.buf.as_ptr(), 1))\n}\n\n// Removes the variable name (unsafe as sys_setenv).\n// UNSAFE: as sys_setenv.\n// SAFETY: (the caller's obligation) as sys_setenv.\n#[effects(static, panic, unsafe, P)]\npub unsafe fn sys_unsetenv<P: AsRef<[u8]>>(name: P) -> Result<(), i32> {\n    let name = name.as_ref();\n");
    buf_str(out, c"    let n = sys_cpath(name)?;\n    sys_check_unit(sys_c_unsetenv(n.buf.as_ptr()))\n}\n\n// ---- Sys: processes (0.20) ----\n\n// UNSAFE: posix_spawn and the C library's process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (spawn.h, sys/wait.h, signal.h,\n// unistd.h); the file actions live in SysSpawnActions' words, larger than\n// either system's posix_spawn_file_actions_t.\nextern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    #[effects(io)]\n    fn sys_c_posix_spawnp(pid: *mut i32, file: *const u8, actions: *const u8, attr: *const u8,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n    #[effects(io)]\n    fn sys_c_actions_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    #[effects(io)]\n    fn sys_c_actions_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    #[effects(io)]\n    fn sys_c_actions_adddup2(a: *mut u8, fd: i32, to: i32) -> i32;\n    #[link_name = \"posix_spawn_file_actions_addclose\"]\n    #[effects(io)]\n    fn sys_c_actions_addclose(a: *mut u8, fd: i32) -> i32;\n    #[link_name = \"waitpid\"]\n    #[effects(io)]\n    fn sys_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"kill\"]\n    #[effects(io)]\n    fn sys_c_kill(pid: i32, sig: i32) -> i32;\n    #[link_name = \"getpid\"]\n    #[effects(io)]\n    fn sys_c_getpid() -> i32;\n    // (0.25.5) Spawn attributes and signal dispositions (std::process's\n    // Command::foreground).\n    #[link_name = \"posix_spawnattr_init\"]\n    #[effects(io)]\n    fn sys_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawnattr_destroy\"]\n    #[effects(io)]\n    fn sys_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawnattr_setflags\"]\n    #[effects(io)]\n    fn sys_c_attr_setflags(a: *mut u8, flags: i16) -> i32;\n    #[link_name = \"posix_spawnattr_setsigdefault\"]\n");
    buf_str(out, c"    #[effects(io)]\n    fn sys_c_attr_setsigdefault(a: *mut u8, set: *const u8) -> i32;\n    #[link_name = \"sigemptyset\"]\n    #[effects(io)]\n    fn sys_c_sigemptyset(set: *mut u8) -> i32;\n    #[link_name = \"sigaddset\"]\n    #[effects(io)]\n    fn sys_c_sigaddset(set: *mut u8, sig: i32) -> i32;\n    #[link_name = \"signal\"]\n    #[effects(io)]\n    fn sys_c_signal(sig: i32, handler: *const u8) -> *const u8;\n}\n\npub const SYS_SIGHUP: i32 = 1;\npub const SYS_SIGINT: i32 = 2;\npub const SYS_SIGQUIT: i32 = 3;\npub const SYS_SIGKILL: i32 = 9;\npub const SYS_SIGTERM: i32 = 15;\nconst SYS_WNOHANG: i32 = 1;\n\n// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes\n// on macOS, 80 on Linux). (0.25.4) Dropping it frees it, so it moves and\n// is never copied: two copies could destroy the actions twice.\npub struct SysSpawnActions {\n    words: [u64; 16],\n    live: bool,\n}\n\nimpl Drop for SysSpawnActions {\n    fn drop(&mut self) {\n        self.free();\n    }\n}\n\n// Empty file actions; sys_spawn_actions_free frees them.\n#[effects(io, unsafe)]\npub fn sys_spawn_actions() -> Result<SysSpawnActions, i32> {\n    let mut a = SysSpawnActions { words: [0u64; 16], live: false };\n    // UNSAFE: C initializes the file actions through a raw pointer.\n    // SAFETY: a.words is 128 bytes, more than either system's\n    // posix_spawn_file_actions_t (8 on macOS, 80 on Linux), 8-aligned; the\n    // actions hold no pointer into themselves, so moving them is fine.\n    let r = unsafe { sys_c_actions_init(a.words.as_mut_ptr() as *mut u8) };\n    if r != 0 {\n        return Err(r);\n    }\n    a.live = true;\n    Ok(a)\n}\n\nimpl SysSpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    #[effects(io, unsafe)]\n    pub fn dup2(&mut self, fd: i32, to: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: C adds to the file actions through a raw pointer.\n");
    buf_str(out, c"        // SAFETY: live: initialized by sys_spawn_actions and not destroyed\n        // (a SysSpawnActions is never copied, see its Drop).\n        let r = unsafe { sys_c_actions_adddup2(self.words.as_mut_ptr() as *mut u8, fd, to) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    // In the child: fd is closed.\n    #[effects(io, unsafe)]\n    pub fn close(&mut self, fd: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: as dup2.\n        // SAFETY: as dup2.\n        let r = unsafe { sys_c_actions_addclose(self.words.as_mut_ptr() as *mut u8, fd) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    #[effects(io, unsafe)]\n    pub fn free(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the file actions through a raw pointer.\n            // SAFETY: live (checked): destroyed once, live cleared right\n            // after.\n            unsafe { sys_c_actions_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n// Runs prog (a path, or a name looked up in PATH) with argv (C strings\n// ending with a null pointer; argv[0] is the program's name) and envp\n// (likewise; empty: this process's environment), after the file actions\n// (null: none): the child's pid. EINVAL when argv or a non-empty envp does\n// not end with a null pointer.\n// Unsafe: prog and every pointer before argv's and envp's null must be\n// NUL-ended strings.\n#[effects(io, static, panic, unsafe)]\n// UNSAFE: posix_spawnp reads the program's name, arguments and environment\n// through raw pointers.\n// SAFETY: (the caller's obligation) prog and every pointer before argv's\n// and envp's nulls are NUL-ended strings, and actions is null or points to\n// a SysSpawnActions; the nulls that end argv and envp are checked here.\npub unsafe fn sys_spawn(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n");
    buf_str(out, c"    actions: *const SysSpawnActions) -> Result<i32, i32> {\n    sys_spawn_attr(prog, argv, envp, actions, 0 as *const SysSpawnAttr)\n}\n\n// (0.25.5) sys_spawn with spawn attributes (null: none).\n#[effects(io, static, panic, unsafe)]\n// UNSAFE: as sys_spawn.\n// SAFETY: (the caller's obligation) as sys_spawn's, and attr is null or\n// points to a SysSpawnAttr.\npub unsafe fn sys_spawn_attr(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions, attr: *const SysSpawnAttr) -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() > 0 && !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    let env = if envp.len() == 0 { sys_environ() } else { envp.as_ptr() };\n    let acts = if actions.is_null() || !(*actions).live {\n        0 as *const u8\n    } else {\n        (*actions).words.as_ptr() as *const u8\n    };\n    let at = if attr.is_null() || !(*attr).live {\n        0 as *const u8\n    } else {\n        (*attr).words.as_ptr() as *const u8\n    };\n    let mut pid = 0i32;\n    let r = sys_c_posix_spawnp(&mut pid, prog, acts, at, argv.as_ptr(), env);\n    if r != 0 {\n        return Err(r);\n    }\n    Ok(pid)\n}\n\n// (0.25.5) posix_spawnattr_t, opaque: room for either system's (8 bytes on\n// macOS, 336 on Linux). Dropping it frees it, so it moves and is never\n// copied, as SysSpawnActions.\npub struct SysSpawnAttr {\n    words: [u64; 48],\n    live: bool,\n}\n\nimpl Drop for SysSpawnAttr {\n    fn drop(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the attributes through a raw pointer.\n            // SAFETY: live (checked): initialized by sys_spawn_sigdefault,\n            // destroyed once, live cleared right after.\n            unsafe { sys_c_attr_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n");
    buf_str(out, c"// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SYS_SPAWN_SETSIGDEF: i16 = 4;\n\n// (0.25.5) Spawn attributes under which the child starts with the default\n// action of each of sigs, whatever this process's are (a signal it\n// ignores, the child does not).\n#[effects(io, unsafe)]\npub fn sys_spawn_sigdefault(sigs: &[i32]) -> Result<SysSpawnAttr, i32> {\n    let mut a = SysSpawnAttr { words: [0u64; 48], live: false };\n    // sigset_t: 4 bytes on macOS, 128 on Linux\n    let mut set: [u64; 16] = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the signal set through raw\n    // pointers. SAFETY: a.words (384 bytes) and set (128) are larger than\n    // either system's posix_spawnattr_t and sigset_t, 8-aligned; the\n    // attributes hold no pointer into themselves, so moving them is fine.\n    unsafe {\n        let r = sys_c_attr_init(a.words.as_mut_ptr() as *mut u8);\n        if r != 0 {\n            return Err(r);\n        }\n        a.live = true;\n        sys_c_sigemptyset(set.as_mut_ptr() as *mut u8);\n        for &sig in sigs {\n            sys_c_sigaddset(set.as_mut_ptr() as *mut u8, sig);\n        }\n        let r2 = sys_c_attr_setsigdefault(a.words.as_mut_ptr() as *mut u8,\n            set.as_mut_ptr() as *mut u8);\n        if r2 != 0 {\n            return Err(r2);\n        }\n        let r3 = sys_c_attr_setflags(a.words.as_mut_ptr() as *mut u8, SYS_SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return Err(r3);\n        }\n    }\n    Ok(a)\n}\n\n// (0.25.5) A signal's disposition before sys_signal_ignore changed it: only\n// sys_signal_ignore makes one, so sys_signal_restore sets back what C gave.\n#[derive(Clone, Copy)]\npub struct SysSignalWas {\n    sig: i32,\n    handler: *const u8,\n}\n\n// This process ignores sig (SIG_IGN) from now on: what it did before.\n#[effects(io, unsafe)]\npub fn sys_signal_ignore(sig: i32) -> SysSignalWas {\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n");
    buf_str(out, c"    // SAFETY: SIG_IGN (1 on macOS and Linux) is a disposition, not code; sig\n    // is an int (an invalid one gives SIG_ERR, restored as nothing below).\n    let was = unsafe { sys_c_signal(sig, 1 as *mut u8) };\n    SysSignalWas { sig: sig, handler: was }\n}\n\n// The disposition sys_signal_ignore replaced, set back.\n#[effects(io, unsafe)]\npub fn sys_signal_restore(was: SysSignalWas) {\n    // (SIG_ERR, -1: signal failed, nothing was changed)\n    if was.handler as i64 == -1 {\n        return;\n    }\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: was.handler is what signal returned for was.sig (SysSignalWas\n    // is sealed: only sys_signal_ignore makes one): SIG_DFL, SIG_IGN, or a\n    // handler of this process, still loaded.\n    unsafe { sys_c_signal(was.sig, was.handler); }\n}\n\n// Waits for the child pid (-1: any child) to end, or with nohang only\n// looks: (its pid, its status; sys_exit_code and sys_exit_signal read it),\n// or (0, 0) when nohang and it is still running.\n#[effects(io, static, unsafe)]\npub fn sys_waitpid(pid: i32, nohang: bool) -> Result<(i32, i32), i32> {\n    let mut status = 0i32;\n    // UNSAFE: C's waitpid writes the status through a raw pointer.\n    // SAFETY: status is a local i32.\n    let r = unsafe { sys_c_waitpid(pid, &mut status, if nohang { SYS_WNOHANG } else { 0 }) };\n    if r == -1 {\n        return Err(sys_errno());\n    }\n    Ok((r, status))\n}\n\n// The exit code of a wait status, when the process exited.\n#[effects()]\npub fn sys_exit_code(status: i32) -> Option<i32> {\n    if (status & 0x7f) == 0 { Some((status >> 8) & 0xff) } else { None }\n}\n\n// The signal that ended the process, when one did.\n#[effects()]\npub fn sys_exit_signal(status: i32) -> Option<i32> {\n    let s = status & 0x7f;\n    if s != 0 && s != 0x7f { Some(s) } else { None }\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_kill(pid: i32, sig: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (kill).\n");
    buf_str(out, c"    // SAFETY: kill takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_kill(pid, sig) })\n}\n\n#[effects(io, unsafe)]\npub fn sys_getpid() -> i32 {\n    // UNSAFE: a C library call (getpid).\n    // SAFETY: getpid takes nothing and touches no memory of ours.\n    unsafe { sys_c_getpid() }\n}\n\n// ---- Sys: terminals (0.20) ----\n\n// UNSAFE: the C library's terminal and process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, sys/ioctl.h, termios.h,\n// unistd.h, poll.h); ioctl is variadic in C and declared so; a struct\n// termios is kept in SysTermios' words, larger than either system's.\nextern \"C\" {\n    #[link_name = \"posix_openpt\"]\n    #[effects(io)]\n    fn sys_c_posix_openpt(flags: i32) -> i32;\n    #[link_name = \"grantpt\"]\n    #[effects(io)]\n    fn sys_c_grantpt(fd: i32) -> i32;\n    #[link_name = \"unlockpt\"]\n    #[effects(io)]\n    fn sys_c_unlockpt(fd: i32) -> i32;\n    #[link_name = \"ptsname_r\"]\n    #[effects(io)]\n    fn sys_c_ptsname_r(fd: i32, buf: *mut u8, n: u64) -> i32;\n    #[link_name = \"ioctl\"]\n    #[effects(io)]\n    fn sys_c_ioctl(fd: i32, req: u64, ...) -> i32;\n    #[link_name = \"tcgetattr\"]\n    #[effects(io)]\n    fn sys_c_tcgetattr(fd: i32, t: *mut u8) -> i32;\n    #[link_name = \"tcsetattr\"]\n    #[effects(io)]\n    fn sys_c_tcsetattr(fd: i32, when: i32, t: *const u8) -> i32;\n    #[link_name = \"cfmakeraw\"]\n    #[effects()]\n    fn sys_c_cfmakeraw(t: *mut u8);\n    #[link_name = \"fork\"]\n    #[effects(io)]\n    fn sys_c_fork() -> i32;\n    #[link_name = \"setsid\"]\n    #[effects(io)]\n    fn sys_c_setsid() -> i32;\n    #[link_name = \"execve\"]\n    #[effects(io)]\n    fn sys_c_execve(path: *const u8, argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"_exit\"]\n    #[effects(io, diverge)]\n    fn sys_c_exit_now(code: i32) -> !;\n    #[link_name = \"poll\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn sys_c_poll(fds: *mut SysPollFd, n: u64, timeout: i32) -> i32;\n}\n\n// A terminal's size (struct winsize, the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysWinsize {\n    pub ws_row: u16,\n    pub ws_col: u16,\n    pub ws_xpixel: u16,\n    pub ws_ypixel: u16,\n}\n\n// struct termios, opaque: room for either system's (72 bytes on macOS, 60\n// on Linux); sys_make_raw is the one change std makes to it.\n#[derive(Clone, Copy)] pub struct SysTermios {\n    words: [u64; 16],\n}\n\n// struct pollfd (the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysPollFd {\n    pub fd: i32,\n    pub events: i16,\n    pub revents: i16,\n}\n\npub const SYS_POLLIN: i16 = 1;\npub const SYS_POLLPRI: i16 = 2;\npub const SYS_POLLOUT: i16 = 4;\npub const SYS_POLLERR: i16 = 8;\npub const SYS_POLLHUP: i16 = 16;\npub const SYS_POLLNVAL: i16 = 32;\n\n// A new pseudo-terminal of the given size: (its controller, the terminal),\n// both close-on-exec. The controller is the program's end (what it reads\n// is the child's output); the terminal becomes the child's stdin, stdout\n// and stderr (sys_fork_exec_pty), and the caller closes its copy then.\n#[effects(io, static, panic, diverge, unsafe)]\npub fn sys_openpty(size: SysWinsize) -> Result<(i32, i32), i32> {\n    // UNSAFE: a C library call (posix_openpt).\n    // SAFETY: posix_openpt takes an int and touches no memory of ours.\n    let m = sys_check(unsafe { sys_c_posix_openpt(SYS_O_RDWR | SYS_O_NOCTTY) } as i64)? as i32;\n    match sys_openpty_side(m, size) {\n        Ok(s) => Ok((m, s)),\n        Err(e) => {\n            // UNSAFE: a C library call (close).\n            // SAFETY: close takes an int: the controller opened above.\n            unsafe { sys_c_close(m); }\n            Err(e)\n        }\n    }\n}\n\nfn sys_openpty_side(m: i32, size: SysWinsize) -> Result<i32, i32> {\n    sys_set_cloexec(m, true)?;\n");
    buf_str(out, c"    // UNSAFE: a C library call (grantpt).\n    // SAFETY: grantpt takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_grantpt(m) })?;\n    // UNSAFE: a C library call (unlockpt).\n    // SAFETY: unlockpt takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_unlockpt(m) })?;\n    // (0.25.4) ptsname_r, not ptsname: ptsname keeps the path in one\n    // buffer for every thread.\n    let mut nb = [0u8; 1024];\n    // UNSAFE: C's ptsname_r writes the terminal's path through a raw\n    // pointer.\n    // SAFETY: nb is a local of 1024 bytes and ptsname_r is given 1023, so\n    // the path and its NUL stay in nb and nb[1023] stays 0.\n    let r = unsafe { sys_c_ptsname_r(m, nb.as_mut_ptr() as *mut u8, 1023) };\n    let mut n: i64 = 0;\n    while r == 0 && nb[n as usize] != 0 {\n        n += 1;\n    }\n    if n == 0 {\n        return Err(sys_errno());\n    }\n    let s = sys_open(&nb[0..n as usize], SYS_O_RDWR | SYS_O_NOCTTY, 0)?;\n    match sys_set_winsize(m, size) {\n        Ok(()) => Ok(s),\n        Err(e) => {\n            // UNSAFE: a C library call (close).\n            // SAFETY: close takes an int: the terminal opened above.\n            unsafe { sys_c_close(s); }\n            Err(e)\n        }\n    }\n}\n\n// Starts path (a full path: no PATH lookup) with argv and envp (C strings\n// ending with a null pointer, built before the call) in a new session\n// whose controlling terminal is tty, the terminal end of sys_openpty, as\n// its stdin, stdout and stderr: the child's pid. Between fork and execve\n// the child calls only async-signal-safe functions (setsid, ioctl, dup2,\n// close, execve, _exit) and allocates nothing; when execve fails it exits\n// with 127.\n// Unsafe: path and every pointer before argv's and envp's nulls must be\n// NUL-ended strings.\n#[effects(io, static, panic, diverge, unsafe)]\n// UNSAFE: fork and execve, given raw pointers to the program's path,\n// arguments and environment.\n");
    buf_str(out, c"// SAFETY: (the caller's obligation) path and every pointer before argv's\n// and envp's nulls are NUL-ended strings (the nulls are checked here);\n// between fork and execve the child calls only async-signal-safe\n// functions, on integers and those pointers, and allocates nothing.\npub unsafe fn sys_fork_exec_pty(tty: i32, path: *const u8, argv: &[*const u8], envp: &[*const u8])\n    -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() == 0 || !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    let av = argv.as_ptr();\n    let ev = envp.as_ptr();\n    let pid = sys_c_fork();\n    if pid == -1 {\n        return Err(sys_errno());\n    }\n    if pid == 0 {\n        // The child.\n        sys_c_setsid();\n        sys_c_ioctl(tty, SYS_TIOCSCTTY, 0);\n        sys_c_dup2(tty, 0);\n        sys_c_dup2(tty, 1);\n        sys_c_dup2(tty, 2);\n        if tty > 2 {\n            sys_c_close(tty);\n        }\n        sys_c_execve(path, av, ev);\n        sys_c_exit_now(127);\n    }\n    Ok(pid)\n}\n\n// Sets the size of the terminal fd (TIOCSWINSZ; on a controller, the\n// child gets SIGWINCH).\n#[effects(io, static, unsafe)]\npub fn sys_set_winsize(fd: i32, size: SysWinsize) -> Result<(), i32> {\n    let ws = size;\n    // UNSAFE: C's ioctl (variadic) reads a struct winsize through a raw\n    // pointer.\n    // SAFETY: ws is a local SysWinsize, C's struct winsize (#[repr(C)]).\n    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCSWINSZ, &raw const ws as *mut u8) })\n}\n\n// The size of the terminal fd (TIOCGWINSZ).\n#[effects(io, static, unsafe)]\npub fn sys_get_winsize(fd: i32) -> Result<SysWinsize, i32> {\n    let mut ws = SysWinsize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 };\n    // UNSAFE: C's ioctl (variadic) writes a struct winsize through a raw\n    // pointer.\n    // SAFETY: ws is a local SysWinsize, C's struct winsize (#[repr(C)]).\n");
    buf_str(out, c"    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCGWINSZ, &raw mut ws as *mut u8) })?;\n    Ok(ws)\n}\n\n// The terminal fd's settings.\n#[effects(io, static, unsafe)]\npub fn sys_tcgetattr(fd: i32) -> Result<SysTermios, i32> {\n    let mut t = SysTermios { words: [0u64; 16] };\n    // UNSAFE: C's tcgetattr writes a struct termios through a raw pointer.\n    // SAFETY: t.words is a local of 128 bytes, more than either system's\n    // struct termios (72 on macOS, 60 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_tcgetattr(fd, t.words.as_mut_ptr() as *mut u8) })?;\n    Ok(t)\n}\n\n// Sets the terminal fd's settings, now (TCSANOW).\n#[effects(io, static, unsafe)]\npub fn sys_tcsetattr(fd: i32, t: SysTermios) -> Result<(), i32> {\n    // UNSAFE: C's tcsetattr reads a struct termios through a raw pointer.\n    // SAFETY: t.words, 128 bytes, holds the struct termios tcgetattr wrote\n    // (perhaps changed by sys_make_raw); tcsetattr only reads it.\n    sys_check_unit(unsafe { sys_c_tcsetattr(fd, 0, t.words.as_mut_ptr() as *mut u8) })\n}\n\n// Raw mode (cfmakeraw): no echo, no line editing, no signals from keys, no\n// output processing, 8-bit characters.\n#[effects(unsafe)]\npub fn sys_make_raw(t: &mut SysTermios) {\n    // UNSAFE: C's cfmakeraw changes a struct termios through a raw pointer.\n    // SAFETY: t is the caller's &mut SysTermios: its 128 bytes of words\n    // hold the struct termios, more than either system's.\n    unsafe { sys_c_cfmakeraw(t.words.as_mut_ptr() as *mut u8); }\n}\n\n// Waits until one of fds is ready or timeout_ms passes (-1: no limit):\n// how many have revents set. (0.25.4) fds is &mut: poll writes their\n// revents.\n#[effects(io, static, unsafe)]\npub fn sys_poll(fds: &mut [SysPollFd], timeout_ms: i32) -> Result<i64, i32> {\n    // UNSAFE: C's poll reads and writes the pollfds through a raw pointer.\n    // SAFETY: fds is the caller's &mut slice of SysPollFd (C's struct\n");
    buf_str(out, c"    // pollfd, #[repr(C)]): poll touches fds.len() of them at fds.as_ptr().\n    sys_check(unsafe { sys_c_poll(fds.as_mut_ptr(), fds.len() as u64, timeout_ms) } as i64)\n}\n\n// ---- Sys: clocks and entropy (0.20) ----\n\n// UNSAFE: the C library's clock and entropy calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's and the systems' (time.h; getentropy:\n// unistd.h on Linux, sys/random.h on macOS); a struct timespec is\n// SysTimespec, #[repr(C)].\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    #[effects(io)]\n    fn sys_c_clock_gettime(clock: i32, ts: *mut SysTimespec) -> i32;\n    #[link_name = \"nanosleep\"]\n    #[effects(io)]\n    fn sys_c_nanosleep(req: *const SysTimespec, rem: *mut SysTimespec) -> i32;\n    #[link_name = \"getentropy\"]\n    #[effects(io)]\n    fn sys_c_getentropy(buf: *mut u8, n: u64) -> i32;\n}\n\n// struct timespec (the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysTimespec {\n    pub tv_sec: i64,\n    pub tv_nsec: i64,\n}\n\npub const SYS_CLOCK_REALTIME: i32 = 0;\n\n// The time of clock (SYS_CLOCK_REALTIME, SYS_CLOCK_MONOTONIC): (seconds,\n// nanoseconds).\n#[effects(io, unsafe)]\npub fn sys_clock_gettime(clock: i32) -> (i64, i64) {\n    let mut ts = SysTimespec { tv_sec: 0, tv_nsec: 0 };\n    // UNSAFE: C's clock_gettime writes a struct timespec through a raw\n    // pointer.\n    // SAFETY: ts is a local SysTimespec; it fails only for a clock the\n    // system does not have, which reads as 0.\n    unsafe { sys_c_clock_gettime(clock, &mut ts); }\n    (ts.tv_sec, ts.tv_nsec)\n}\n\n// Sleeps for secs seconds and nanos nanoseconds (nanos < 10^9); when a\n// signal interrupts it, Err(EINTR) with the time left in *left.\n#[effects(io, static, unsafe)]\npub fn sys_nanosleep(secs: i64, nanos: i64, left: &mut SysTimespec) -> Result<(), i32> {\n    let req = SysTimespec { tv_sec: secs, tv_nsec: nanos };\n");
    buf_str(out, c"    // UNSAFE: C's nanosleep reads and writes struct timespecs through raw\n    // pointers.\n    // SAFETY: req is a local, left the caller's &mut SysTimespec.\n    sys_check_unit(unsafe { sys_c_nanosleep(&req, left) })\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 at a time).\n#[effects(io, static, panic, unsafe)]\npub fn sys_getentropy(buf: &mut [u8]) -> Result<(), i32> {\n    let mut at: i64 = 0;\n    for _ in 0..(buf.len() as i64 + 255) / 256 {\n        let n: i64 = if buf.len() as i64 - at < 256 { buf.len() as i64 - at } else { 256 };\n        // UNSAFE: C's getentropy writes through a raw pointer.\n        // SAFETY: n <= 256 bytes at buf[at..at + n].as_mut_ptr(), a subslice of buf\n        // (bounds-checked).\n        let r = unsafe {\n            sys_c_getentropy(buf[at as usize..(at + n) as usize].as_mut_ptr(), n as u64)\n        };\n        if r != 0 {\n            return Err(sys_errno());\n        }\n        at += n;\n    }\n    Ok(())\n}\n// ---- end mod std::sys ----\n}\n// ---- mod std::capture ----\npub mod capture {\n// EDITION: rust\n// std::capture (0.25.4; std2 0.28.0): a request to write the next frame\n// presented to a file, which std::window's scripted event loop makes (its\n// `shot FILE` command) and std::gpu serves (Frame::present). It is a\n// module of its own so that neither of those needs the other. A program\n// reaches it as std::gpu::capture_next_frame. vole's own: Rust's std has\n// no windows.\n//\n// The request is a static, so any thread may make or serve one: a spin\n// lock (an AtomicBool) guards the path's bytes and length, which are only\n// read or written while it is held.\n// mvs: std::capture\n\nuse crate::alloc::Allocator;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::sync::atomic::{AtomicBool, Ordering};\n\n// The longest path a request takes, in bytes.\npub const MAX_PATH: usize = 1024;\n\n// Held while PATH and LEN are read or written.\n");
    buf_str(out, c"static LOCK: AtomicBool = AtomicBool::new(false);\n// The file the next presented frame goes to (LEN < 0: none asked for).\nstatic mut PATH: [u8; 1024] = [0; 1024];\nstatic mut LEN: i64 = -1;\n\nfn lock() {\n    while LOCK.compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {}\n}\n\nfn unlock() {\n    LOCK.store(false, Ordering::Release);\n}\n\n// The next frame presented (std::gpu's `Frame::present`) is also written\n// to path, a binary PPM. A new request replaces one not yet served; false\n// (and nothing is asked) when path is longer than MAX_PATH bytes.\n// std2: changed: path a &str (MVS: [u8])\n#[effects(static, sync, panic, diverge)]\npub fn capture_next_frame(path: &str) -> bool {\n    let b = path.as_bytes();\n    if b.len() > MAX_PATH {\n        return false;\n    }\n    lock();\n    // UNSAFE: writes the static mut request.\n    // SAFETY: the lock is held, so no other thread reads or writes PATH or\n    // LEN; i < b.len() <= 1024, PATH's length; no reference to either is\n    // made (place writes only).\n    unsafe {\n        for i in 0..b.len() {\n            PATH[i] = b[i];\n        }\n        LEN = b.len() as i64;\n    }\n    unlock();\n    true\n}\n\n// A capture is asked for, and no frame was presented since.\n#[effects(static, sync, panic, diverge)]\npub fn capture_pending() -> bool {\n    lock();\n    // UNSAFE: reads the static mut LEN.\n    // SAFETY: the lock is held: no thread writes LEN meanwhile; a copy of\n    // the value, no reference.\n    let pending = unsafe { LEN >= 0 };\n    unlock();\n    pending\n}\n\n// Forgets the capture asked for, if any.\n#[effects(static, sync, panic, diverge)]\npub fn capture_cancel() {\n    lock();\n    // UNSAFE: writes the static mut LEN.\n    // SAFETY: the lock is held: no other thread reads or writes it.\n    unsafe {\n        LEN = -1;\n    }\n    unlock();\n}\n\n// The file asked for, appended to out, and the request forgotten; false\n");
    buf_str(out, c"// (out unchanged) when none was asked for.\n// std2: changed: out a &mut String<A>\n#[effects(static, sync, panic, diverge, A)]\npub fn take_capture<A: Allocator>(out: &mut String<A>) -> bool {\n    lock();\n    // UNSAFE: reads and clears the static mut request.\n    // SAFETY: the lock is held: no other thread reads or writes PATH or\n    // LEN; both are copied out by value (no reference to a static mut).\n    let (bytes, len) = unsafe {\n        let r = (PATH, LEN);\n        LEN = -1;\n        r\n    };\n    unlock();\n    if len < 0 {\n        return false;\n    }\n    // (the bytes were a &str's: capture_next_frame's argument)\n    match crate::str::from_utf8(&bytes[0..len as usize]) {\n        Result::Ok(s) => out.push_str(s),\n        Result::Err(_) => crate::panic::unreachable(),\n    }\n    true\n}\n// ---- end mod std::capture ----\n}\n// ---- mod std::env ----\npub mod env {\n// EDITION: rust\n// std::env: the program's arguments and environment, Rust's names. The\n// arguments are views of argv, valid for the whole program (no\n// allocation); a variable's value is copied onto an allocator (`var_in`),\n// since the environment can change under a view. argv comes from the\n// target's system, std::__sys (std2/rt/sys_macos.vl, sys_linux.vl).\n// mvs: std::env\n\nuse crate::alloc::Allocator;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, Iterator};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// The i-th of n C strings at argv, its bytes (without the NUL).\nfn arg_bytes(argv: *const *const u8, n: usize, i: usize) -> &'static [u8] {\n    if i >= n {\n        crate::panic::panic(\"env: argument index out of bounds\");\n    }\n    // UNSAFE: reads argv[i] and the NUL-ended C string it points to.\n    // SAFETY: i < n = argc (checked); argv[0..argc] are crt's (or the\n    // /proc copy's) NUL-ended strings, kept for the whole program and\n");
    buf_str(out, c"    // never written after main starts.\n    unsafe {\n        let p = *argv.add(i);\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        crate::ptr::slice_parts(p, len)\n    }\n}\n\n// The arguments, the program's name first: `for a in env::args()`,\n// `env::args().skip(1)`. One that is not UTF-8 stops the program (as\n// Rust's); `args_os()` yields bytes.\n// std2: changed: yields &'static str views, not Strings (no allocator)\n// (Linux reads /proc/self/cmdline on the first call: io there)\n#[effects(io, static, panic, diverge)]\npub fn args() -> Args {\n    let (n, argv) = crate::__sys::args();\n    Args { front: 0, back: n, n: n, argv: argv }\n}\n\n// The arguments as bytes.\n// std2: changed: yields &'static [u8] (Rust: OsString)\n// (Linux reads /proc/self/cmdline on the first call: io there)\n#[effects(io, static, panic, diverge)]\npub fn args_os() -> ArgsOs {\n    let (n, argv) = crate::__sys::args();\n    ArgsOs { front: 0, back: n, n: n, argv: argv }\n}\n\n// env::args's iterator.\npub struct Args {\n    front: usize,\n    back: usize,\n    n: usize,\n    argv: *const *const u8,\n}\n\nfn arg_str(b: &'static [u8]) -> &'static str {\n    match crate::str::from_utf8(b) {\n        Result::Ok(s) => s,\n        Result::Err(_) => crate::panic::panic(\n            \"env::args: an argument is not UTF-8 (env::args_os yields bytes)\"),\n    }\n}\n\nimpl Iterator for Args {\n    type Item = &'static str;\n\n    fn next(&mut self) -> Option<&'static str> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.front);\n        self.front += 1;\n        Option::Some(arg_str(b))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let k = self.back - self.front;\n        (k, Option::Some(k))\n    }\n}\n\nimpl DoubleEndedIterator for Args {\n    fn next_back(&mut self) -> Option<&'static str> {\n");
    buf_str(out, c"        if self.front >= self.back {\n            return Option::None;\n        }\n        self.back -= 1;\n        Option::Some(arg_str(arg_bytes(self.argv, self.n, self.back)))\n    }\n}\n\nimpl ExactSizeIterator for Args {}\n\nimpl Debug for Args {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let mut l = f.debug_list();\n        let mut i = self.front;\n        while i < self.back {\n            l.entry(&arg_str(arg_bytes(self.argv, self.n, i)));\n            i += 1;\n        }\n        l.finish()\n    }\n}\n\n// env::args_os's iterator.\npub struct ArgsOs {\n    front: usize,\n    back: usize,\n    n: usize,\n    argv: *const *const u8,\n}\n\nimpl Iterator for ArgsOs {\n    type Item = &'static [u8];\n\n    fn next(&mut self) -> Option<&'static [u8]> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.front);\n        self.front += 1;\n        Option::Some(b)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let k = self.back - self.front;\n        (k, Option::Some(k))\n    }\n}\n\nimpl DoubleEndedIterator for ArgsOs {\n    fn next_back(&mut self) -> Option<&'static [u8]> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        self.back -= 1;\n        Option::Some(arg_bytes(self.argv, self.n, self.back))\n    }\n}\n\nimpl ExactSizeIterator for ArgsOs {}\n\n// Why env::var_in failed: the variable is not set, or its value is not\n// UTF-8.\n// std2: changed: NotUnicode has no payload (Rust: the OsString)\n#[derive(Clone, PartialEq, Eq, Debug)]\npub enum VarError {\n    NotPresent,\n    NotUnicode,\n}\n\nimpl Display for VarError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self {\n            VarError::NotPresent => f.write_str(\"environment variable not found\"),\n");
    buf_str(out, c"            VarError::NotUnicode => f.write_str(\"environment variable was not valid unicode\"),\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: POSIX's prototypes (stdlib.h).\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    fn env_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    #[effects(global)]\n    fn env_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    #[effects(global)]\n    fn env_c_unsetenv(name: *const u8) -> i32;\n    #[link_name = \"getcwd\"]\n    #[effects(io)]\n    fn env_c_getcwd(buf: *mut u8, size: usize) -> *mut u8;\n    #[link_name = \"chdir\"]\n    #[effects(io)]\n    fn env_c_chdir(path: *const u8) -> i32;\n}\n\n// s and a NUL in buf; false when it does not fit or holds a NUL (or, for\n// a name, is empty or holds `=`: no variable has such a name).\nfn c_string(s: &str, buf: &mut [u8], name: bool) -> bool {\n    let b = s.as_bytes();\n    if b.len() >= buf.len() || (name && b.len() == 0) {\n        return false;\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 || (name && b[i] == 61) {\n            return false;\n        }\n        buf[i] = b[i];\n        i += 1;\n    }\n    buf[b.len()] = 0;\n    true\n}\n\n// The value of variable key, as the bytes C's environment holds now.\nfn get_bytes(key: &str) -> Option<&'static [u8]> {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        return Option::None;\n    }\n    // UNSAFE: C's getenv, then a view of the C string it returns.\n    // SAFETY: nb holds a NUL-ended name; getenv's result is null or a\n    // NUL-ended string of the environment, read here before the caller\n    // copies it (set_var and remove_var, which may free it, are unsafe\n    // and their callers promise no reader meanwhile).\n    unsafe {\n        let p = env_c_getenv(&nb[0] as *const u8);\n        if p.is_null() {\n            return Option::None;\n        }\n");
    buf_str(out, c"        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The value of variable key, copied into a new String on allocator a\n// (Rust's env::var).\n// mvs: get_in\n// std2: changed: the key is a &str\n#[effects(static, panic, diverge, A)]\npub fn var_in<A: Allocator>(key: &str, a: A) -> Result<String<A>, VarError> {\n    match get_bytes(key) {\n        Option::Some(v) => match crate::str::from_utf8(v) {\n            Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n            Result::Err(_) => Result::Err(VarError::NotUnicode),\n        },\n        Option::None => Result::Err(VarError::NotPresent),\n    }\n}\n\n// The value of variable key, its bytes copied into a new Vec on a.\n// std2: changed: the key is a &str, the value a Vec<u8, A> (Rust: OsString)\n#[effects(static, panic, diverge, A)]\npub fn var_os_in<A: Allocator>(key: &str, a: A) -> Option<Vec<u8, A>> {\n    match get_bytes(key) {\n        Option::Some(v) => {\n            let mut out: Vec<u8, A> = Vec::with_capacity_in(v.len(), a);\n            out.extend_from_slice(v);\n            Option::Some(out)\n        }\n        Option::None => Option::None,\n    }\n}\n\n// Sets variable key to value (Rust 2024's `unsafe fn`). Panics on a key\n// that is empty or holds `=` or a NUL, or a value with a NUL (as Rust's),\n// and on a key over 1 KB or a value over 64 KB.\n#[effects(static, panic, diverge, unsafe)]\n// UNSAFE: changes the environment (C's setenv), which another thread's\n// getenv may be reading.\n// SAFETY: (the caller's) no other thread reads or writes the environment\n// meanwhile, and no value read from it before (a getenv view) is used\n// after.\n// std2: changed: key and value are &str\npub unsafe fn set_var(key: &str, value: &str) {\n    let mut nb = [0u8; 1024];\n    let mut vb = [0u8; 65536];\n    if !c_string(key, &mut nb[..], true) || !c_string(value, &mut vb[..], false) {\n");
    buf_str(out, c"        crate::panic::panic(\"env::set_var: a key or value that C's environment cannot hold\");\n    }\n    // UNSAFE: C's setenv. SAFETY: two NUL-ended strings; the caller's\n    // promise above.\n    let _ = unsafe { env_c_setenv(&nb[0] as *const u8, &vb[0] as *const u8, 1) };\n}\n\n// Removes variable key (Rust 2024's `unsafe fn`).\n#[effects(static, panic, diverge, unsafe)]\n// UNSAFE: as set_var: C's unsetenv.\n// SAFETY: (the caller's) as set_var.\n// std2: changed: the key is a &str\npub unsafe fn remove_var(key: &str) {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        crate::panic::panic(\"env::remove_var: a key that C's environment cannot hold\");\n    }\n    // UNSAFE: C's unsetenv. SAFETY: a NUL-ended string; the caller's\n    // promise above.\n    let _ = unsafe { env_c_unsetenv(&nb[0] as *const u8) };\n}\n\n// Every variable, (name, value), each copied into a String on allocator a\n// as the iterator reaches it (Rust's env::vars). A name or value that is\n// not UTF-8 stops the program, as Rust's; an entry without `=` is left\n// out.\n// std2: changed: takes an allocator\n#[effects()]\npub fn vars_in<A: Allocator + Clone>(a: A) -> Vars<A> {\n    Vars { at: 0, a: a }\n}\n\n// env::vars_in's iterator: environ's entries from index at. set_var and\n// remove_var, which change environ, are unsafe: their callers promise no\n// iterator meanwhile.\npub struct Vars<A: Allocator> {\n    at: usize,\n    a: A,\n}\n\nimpl<A: Allocator + Clone> Iterator for Vars<A> {\n    type Item = (String<A>, String<A>);\n\n    fn next(&mut self) -> Option<(String<A>, String<A>)> {\n        loop {\n            let kv = match env_entry(self.at) {\n                Option::Some(kv) => kv,\n                Option::None => return Option::None,\n            };\n            self.at += 1;\n            // (from index 1: a name may start with `=`, as Rust's parse)\n            let mut eq: usize = 1;\n            while eq < kv.len() && kv[eq] != 61 {\n");
    buf_str(out, c"                eq += 1;\n            }\n            if eq >= kv.len() {\n                continue;\n            }\n            let (k, v) = match (crate::str::from_utf8(&kv[..eq]),\n                crate::str::from_utf8(&kv[eq + 1..])) {\n                (Result::Ok(k), Result::Ok(v)) => (k, v),\n                _ => crate::panic::panic(\"env::vars_in: a variable is not valid unicode\"),\n            };\n            return Option::Some((String::from_in(k, self.a.clone()),\n                String::from_in(v, self.a.clone())));\n        }\n    }\n}\n\n// The i-th entry of C's environment, `NAME=value`, as its bytes; None\n// past the last.\nfn env_entry(i: usize) -> Option<&'static [u8]> {\n    let env = crate::__sys::environ();\n    // UNSAFE: reads environ[0..=i] and the NUL-ended C string at i.\n    // SAFETY: environ is a null-ended array of NUL-ended strings; the\n    // entries before i were read non-null (the loop stops at the null),\n    // and nothing changes it meanwhile (set_var and remove_var are unsafe:\n    // their callers' promise).\n    unsafe {\n        let mut k: usize = 0;\n        while k < i {\n            if (*env.add(k)).is_null() {\n                return Option::None;\n            }\n            k += 1;\n        }\n        let p = *env.add(i);\n        if p.is_null() {\n            return Option::None;\n        }\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The current working directory, copied into a new String on allocator a\n// (Rust's env::current_dir). Up to 4 KB.\n// std2: changed: a String<A> on an allocator (Rust: a PathBuf)\n// mvs: current_dir_in\n#[effects(io, static, panic, diverge, unsafe, A)]\npub fn current_dir_in<A: Allocator>(a: A) -> crate::io::Result<String<A>> {\n    let mut buf = [0u8; 4096];\n    // UNSAFE: C's getcwd into buf. SAFETY: buf holds 4096 bytes, the size\n");
    buf_str(out, c"    // given; getcwd writes a NUL-ended path within them or fails (null).\n    let p = unsafe { env_c_getcwd(&mut buf[0] as *mut u8, 4096) };\n    if p.is_null() {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    let mut n: usize = 0;\n    while n < buf.len() && buf[n] != 0 {\n        n += 1;\n    }\n    match crate::str::from_utf8(&buf[..n]) {\n        Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n        Result::Err(_) => Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidData,\n            \"the current directory is not UTF-8\")),\n    }\n}\n\n// Makes path the working directory (Rust's env::set_current_dir).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn set_current_dir<P: crate::convert::AsRef<str>>(path: P) -> crate::io::Result<()> {\n    let path = path.as_ref();\n    let mut pb = [0u8; 4096];\n    if !c_string(path, &mut pb[..], false) {\n        return Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidInput,\n            \"a path that C cannot hold\"));\n    }\n    // UNSAFE: C's chdir. SAFETY: pb holds a NUL-ended path.\n    if unsafe { env_c_chdir(&pb[0] as *const u8) } != 0 {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    Result::Ok(())\n}\n// ---- end mod std::env ----\n}\n// ---- mod std::cli ----\npub mod cli {\n// EDITION: rust\n// std::cli (0.24, docs/design/cli.md, guide cli): a command-line parser,\n// clap's builder without derive (the overview: below the first banner).\n// The rust edition's (0.27.5): names, help and the words parsed are\n// `&'a str` views, so Arg, Command, Matches and CliError carry the\n// lifetime of the text they were given; counts and widths are usize and\n// a short form is a char, as clap's (indices_of's are i64s, as MVS's).\n// mvs: std::cli\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::fmt::{Debug, Display, Formatter};\n");
    buf_str(out, c"use crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::str::FromStr;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// ---- Arguments and commands (0.24) ----\n\n// A Command lists its arguments (flags, options with a value,\n// positionals) and subcommands; `cmd.parse(args)`\n// gives the Matches, or a CliError that `cmd.exit(e)` prints with the\n// usage line (exit code 2; 0 for --help and --version).\n//\n//     let cmd = Command::new_in(\"grep\", gpa).version(\"1.0\")\n//         .arg(Arg::flag(\"count\").short('c').help(\"count the matches\"))\n//         .arg(Arg::option(\"max\").short('m').value_name(\"N\").default(\"0\"))\n//         .arg(Arg::positional(\"pattern\").required())\n//         .arg(Arg::positional(\"file\").multiple());\n//     let m = cmd.parse_or_exit(env::args());\n//     let n = m.get_as::<i64>(\"max\").unwrap_or(0);\n//\n// Accepted: `-v`, `-vvv` (m.count), `-abc` (a cluster of short flags;\n// an option in it takes the rest, `-ofile`), `-o FILE`, `--out FILE`,\n// `--out=FILE`, `--` (everything after it is positional), `-` (a\n// positional). An option takes the next argument as its value even when\n// it starts with '-' (`--n -5`). An option given twice keeps both values\n// (m.values; m.get: the last). A positional takes one value, or every one\n// left with `.multiple()`. A subcommand's name ends its parent's\n// arguments; its own follow.\n//\n// (0.25.2) Clap's too: `.global()` (an argument the subcommands accept),\n// `.alias(s)` and `.hide()` (of an Arg and of a Command), `.num_values(n)`\n// (`--overlay PATH COPY`), `.default_missing(s)` (`--stats`,\n// `--stats=x`), `.allow_hyphen_values()` (a positional `-> bool`),\n// `.last()` (the words after `--`), `.conflicts_with(name)` and\n// `Command::subcommand_required()`.\n//\n// Parsing is pure but for its allocation: the definition is on the Gpa\n// given to Command::new_in, the Matches on the Gpa or on the allocator\n");
    buf_str(out, c"// given to parse_in (an arena: `arena_scope(gpa, |a| { let m =\n// cmd.parse_in(args, a)?; .. })`). Help and error text are built in a\n// scoped arena when cmd.exit prints them. Only exit and parse_or_exit do\n// io.\n\nconst FLAG: i64 = 0;\nconst OPTION: i64 = 1;\nconst POSITIONAL: i64 = 2;\n\n// One argument of a command: a flag (`-v`, `--verbose`), an option with a\n// value (`-o FILE`, `--out FILE`, `--out=FILE`) or a positional, made by\n// Arg::flag, Arg::option or Arg::positional; each method returns the\n// changed Arg. Its name is what Matches asks for (`m.flag(\"verbose\")`);\n// a flag's or option's long form is its name unless `.long(..)`.\n#[derive(Clone, Copy)]\npub struct Arg<'a> {\n    name: &'a str,\n    kind: i64,\n    short: char,\n    long: &'a str,\n    help: &'a str,\n    value_name: &'a str,\n    default: &'a str,\n    has_default: bool,\n    required: bool,\n    multiple: bool,\n    // (0.25) the values it takes, `fast|slow` (\"\": any)\n    choices: &'a str,\n    cmd: i64,\n    // (0.25.2) accepted by the subcommands too; its other long names; not\n    // in the help; how many values an option takes; the value of an\n    // option given without one; values starting with '-'; a positional\n    // after `--`; the arguments it cannot be given with\n    global: bool,\n    aliases: Names<'a>,\n    hidden: bool,\n    num_values: i64,\n    missing: &'a str,\n    has_missing: bool,\n    hyphen: bool,\n    last: bool,\n    conflicts: Names<'a>,\n}\n\n// (0.25.2) Up to 4 names (aliases, conflicts), each one or several\n// separated by '|': a plain value of views, no allocation.\n#[derive(Clone, Copy)]\nstruct Names<'a> {\n    a: &'a str,\n    b: &'a str,\n    c: &'a str,\n    d: &'a str,\n    n: i64,\n}\n\nimpl<'a> Names<'a> {\n    fn none() -> Names<'a> {\n        Names { a: \"\", b: \"\", c: \"\", d: \"\", n: 0 }\n    }\n\n    fn put(&mut self, s: &'a str) {\n        if self.n == 0 {\n            self.a = s;\n        } else if self.n == 1 {\n");
    buf_str(out, c"            self.b = s;\n        } else if self.n == 2 {\n            self.c = s;\n        } else if self.n == 3 {\n            self.d = s;\n        } else {\n            crate::panic::panic(\"std::cli: at most 4 alias or conflicts_with calls per Arg or Command (one may list several: \\\"a|b\\\")\");\n        }\n        self.n += 1;\n    }\n\n    fn name_at(self, i: i64) -> &'a str {\n        if i == 0 { self.a } else if i == 1 { self.b } else if i == 2 { self.c } else { self.d }\n    }\n\n    // Whether word is one of them.\n    fn has(self, word: &str) -> bool {\n        for i in 0..self.n {\n            for w in self.name_at(i).split('|') {\n                if w == word {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The distance from word to the nearest of them (64: none).\n    fn nearest(self, word: &str) -> i64 {\n        let mut bd: i64 = 64;\n        for i in 0..self.n {\n            for w in self.name_at(i).split('|') {\n                let d = distance(word, w);\n                if d < bd {\n                    bd = d;\n                }\n            }\n        }\n        bd\n    }\n}\n\nimpl<'a> Arg<'a> {\n    fn make(name: &'a str, kind: i64) -> Arg<'a> {\n        let mut long: &'a str = name;\n        if kind == POSITIONAL {\n            long = \"\";\n        }\n        Arg {\n            name: name, kind: kind, short: '\\0', long: long, help: \"\", value_name: \"\",\n            default: \"\", has_default: false, required: false, multiple: false, choices: \"\",\n            cmd: 0, global: false, aliases: Names::none(), hidden: false, num_values: 1,\n            missing: \"\", has_missing: false, hyphen: false, last: false,\n            conflicts: Names::none(),\n        }\n    }\n\n    // A flag, `--NAME` (and `.short('x')`): m.flag(name), m.count(name).\n    #[effects()]\n    pub fn flag(name: &'a str) -> Arg<'a> {\n        Arg::make(name, FLAG)\n    }\n\n");
    buf_str(out, c"    // An option with a value, `--NAME VALUE` or `--NAME=VALUE`: m.get(name).\n    #[effects()]\n    pub fn option(name: &'a str) -> Arg<'a> {\n        Arg::make(name, OPTION)\n    }\n\n    // A positional argument, in the order of the command's `.arg` calls.\n    #[effects()]\n    pub fn positional(name: &'a str) -> Arg<'a> {\n        Arg::make(name, POSITIONAL)\n    }\n\n    // Its one-letter form, `-c`.\n    // std2: changed: a char, as clap's (MVS: a byte)\n    #[effects()]\n    pub fn short(mut self, c: char) -> Arg<'a> {\n        self.short = c;\n        self\n    }\n\n    // Its long form, `--s`, instead of its name (`\"\"`: none).\n    #[effects()]\n    pub fn long(mut self, s: &'a str) -> Arg<'a> {\n        self.long = s;\n        self\n    }\n\n    // Its line in the help.\n    #[effects()]\n    pub fn help(mut self, s: &'a str) -> Arg<'a> {\n        self.help = s;\n        self\n    }\n\n    // The name of an option's value in the help, `--out <FILE>` (the name\n    // in capitals by default).\n    #[effects()]\n    pub fn value_name(mut self, s: &'a str) -> Arg<'a> {\n        self.value_name = s;\n        self\n    }\n\n    // The value when it is not given (m.get gives it; m.flag stays false).\n    #[effects()]\n    pub fn default(mut self, s: &'a str) -> Arg<'a> {\n        self.default = s;\n        self.has_default = true;\n        self\n    }\n\n    // An error when it is not given.\n    #[effects()]\n    pub fn required(mut self) -> Arg<'a> {\n        self.required = true;\n        self\n    }\n\n    // A positional that takes every value left (m.values).\n    #[effects()]\n    pub fn multiple(mut self) -> Arg<'a> {\n        self.multiple = true;\n        self\n    }\n\n    // (0.25) The values it takes, `\"fast|slow\"`: another is an InvalidValue\n    // error (`try: --mode <fast|slow>`); the help shows them.\n    #[effects()]\n    pub fn choices(mut self, s: &'a str) -> Arg<'a> {\n        self.choices = s;\n        self\n    }\n\n");
    buf_str(out, c"    // (0.25.2) A flag or option of a command that its subcommands accept\n    // too, at any depth, before or after their names (`prog --root D sub`,\n    // `prog sub --root D`); every level's Matches reads it.\n    #[effects()]\n    pub fn global(mut self) -> Arg<'a> {\n        self.global = true;\n        self\n    }\n\n    // (0.25.2) Another long name, `--s` (called again: more; `\"a|b\"`: two);\n    // not in the help; the did-you-mean suggests the Arg's own.\n    #[effects(panic)]\n    pub fn alias(mut self, s: &'a str) -> Arg<'a> {\n        self.aliases.put(s);\n        self\n    }\n\n    // (0.25.2) Accepted, but not in the help (a deprecated spelling).\n    #[effects()]\n    pub fn hide(mut self) -> Arg<'a> {\n        self.hidden = true;\n        self\n    }\n\n    // (0.25.2) An option taking n values, `--overlay PATH COPY`: m.values\n    // gives them in order, n more each time it is given; fewer is a\n    // MissingValue error. Their names in the help: `.value_name(\"PATH\n    // COPY\")`.\n    // std2: changed: a usize (MVS: i64)\n    #[effects()]\n    pub fn num_values(mut self, n: usize) -> Arg<'a> {\n        self.num_values = if n < 1 { 1 } else { n as i64 };\n        self\n    }\n\n    // (0.25.2) An option whose value is optional: `--stats` alone gives s,\n    // `--stats=x` (or `-s=x`) gives x; only the `=` form gives it one.\n    #[effects()]\n    pub fn default_missing(mut self, s: &'a str) -> Arg<'a> {\n        self.missing = s;\n        self.has_missing = true;\n        self\n    }\n\n    // (0.25.2) Its values may start with '-': a positional so marked takes\n    // a word starting with '-' that is no option of the command (`grep\n    // '-> bool'`). (An option takes its next argument as its value\n    // anyway.)\n    #[effects()]\n    pub fn allow_hyphen_values(mut self) -> Arg<'a> {\n        self.hyphen = true;\n        self\n    }\n\n    // (0.25.2) A positional that takes only the words after `--`: `probe\n");
    buf_str(out, c"    // FILE:LINE EXPR... -- ARGS...` (EXPR multiple, ARGS multiple and\n    // last).\n    #[effects()]\n    pub fn last(mut self) -> Arg<'a> {\n        self.last = true;\n        self\n    }\n\n    // (0.25.2) Given together with the argument named name (either way\n    // round) is an ArgumentConflict error. Called again: more names.\n    #[effects(panic)]\n    pub fn conflicts_with(mut self, name: &'a str) -> Arg<'a> {\n        self.conflicts.put(name);\n        self\n    }\n\n    // Whether it is called word on the command line (`--word`).\n    fn long_is(self, word: &str) -> bool {\n        self.kind != POSITIONAL && (self.long.len() as i64 > 0 && self.long == word\n            || self.aliases.has(word))\n    }\n}\n\n// Whether v is one of choices (`fast|slow`; \"\": any).\nfn chosen(v: &str, choices: &str) -> bool {\n    if choices.len() as i64 == 0 {\n        return true;\n    }\n    for c in choices.split('|') {\n        if c == v {\n            return true;\n        }\n    }\n    false\n}\n\n// A command of the tree: its subcommands are those whose parent it is.\n#[derive(Clone, Copy)]\nstruct Cmd<'a> {\n    name: &'a str,\n    about: &'a str,\n    version: &'a str,\n    parent: i64,\n    // (0.25.2) its other names; not in the help; no subcommand an error\n    aliases: Names<'a>,\n    hidden: bool,\n    sub_required: bool,\n}\n\n// A program's command line: its name, arguments and subcommands. The\n// tree is kept flat, every command in `cmds` (the first is this one) and\n// every argument in `args` with its command's index.\npub struct Command<'a, CA: Allocator> {\n    cmds: Vec<Cmd<'a>, CA>,\n    args: Vec<Arg<'a>, CA>,\n    width: i64,\n    // (0.25: any allocator, an arena too; before, the Gpa)\n    alloc: CA,\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // A command named name, its definition on allocator a (the Gpa, or an\n    // arena: 0.25).\n    #[effects(CA)]\n    pub fn new_in(name: &'a str, a: CA) -> Command<'a, CA> {\n");
    buf_str(out, c"        let mut cmds: Vec<Cmd<'a>, CA> = Vec::new_in(a.clone());\n        cmds.push(Cmd {\n            name: name, about: \"\", version: \"\", parent: -1, aliases: Names::none(),\n            hidden: false, sub_required: false,\n        });\n        Command { cmds: cmds, args: Vec::new_in(a.clone()), width: 80, alloc: a }\n    }\n\n    // The help's line under the name.\n    #[effects(panic, CA)]\n    pub fn about(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].about = s;\n        self\n    }\n\n    // Its version: `--version` (and `-V`) print `NAME VERSION`.\n    #[effects(panic, CA)]\n    pub fn version(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].version = s;\n        self\n    }\n\n    // The help's width in columns (80).\n    // std2: changed: a usize (MVS: i64)\n    #[effects()]\n    pub fn width(mut self, n: usize) -> Command<'a, CA> {\n        self.width = n as i64;\n        self\n    }\n\n    // (0.25.2) Another name of this subcommand (called again: more;\n    // `\"a|b\"`: two); m.subcommand() gives its own name.\n    #[effects(panic, CA)]\n    pub fn alias(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].aliases.put(s);\n        self\n    }\n\n    // (0.25.2) A subcommand accepted, but not in its parent's help.\n    #[effects(panic, CA)]\n    pub fn hide(mut self) -> Command<'a, CA> {\n        self.cmds[0].hidden = true;\n        self\n    }\n\n    // (0.25.2) No subcommand given is a MissingSubcommand error (its try:\n    // line names them).\n    #[effects(panic, CA)]\n    pub fn subcommand_required(mut self) -> Command<'a, CA> {\n        self.cmds[0].sub_required = true;\n        self\n    }\n\n    // Adds an argument.\n    #[effects(CA)]\n    pub fn arg(mut self, a: Arg<'a>) -> Command<'a, CA> {\n        let mut x = a;\n        x.cmd = 0;\n        self.args.push(x);\n        self\n    }\n\n    // Adds a subcommand: `prog NAME ...`, m.subcommand().\n    #[effects(panic, CA)]\n");
    buf_str(out, c"    pub fn subcommand(mut self, sub: Command<'a, CA>) -> Command<'a, CA> {\n        let base = self.cmds.len() as i64;\n        for i in 0..sub.cmds.len() as i64 {\n            let mut c = sub.cmds[i as usize];\n            c.parent = if c.parent < 0 { 0 } else { c.parent + base };\n            self.cmds.push(c);\n        }\n        for i in 0..sub.args.len() as i64 {\n            let mut a = sub.args[i as usize];\n            a.cmd = a.cmd + base;\n            self.args.push(a);\n        }\n        self\n    }\n\n    // The subcommand of c named name, or -1.\n    fn sub_named(&self, c: i64, name: &str) -> i64 {\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c\n                && (self.cmds[i as usize].name == name || self.cmds[i as usize].aliases.has(name)) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Whether argument a is one of command c's: its own, or a\n    // global one of c's parent, grandparent...\n    fn of_cmd(&self, a: Arg<'a>, c: i64) -> bool {\n        if a.cmd == c {\n            return true;\n        }\n        if !a.global || a.kind == POSITIONAL {\n            return false;\n        }\n        let mut p = self.cmds[c as usize].parent;\n        while p >= 0 {\n            if p == a.cmd {\n                return true;\n            }\n            p = self.cmds[p as usize].parent;\n        }\n        false\n    }\n\n    // The command of Matches level `level`.\n    fn cmds_of<A: Allocator + Clone>(&self, level: i64, m: &Matches<'a, A>) -> i64 {\n        m.cmds[level as usize]\n    }\n\n    fn has_subs(&self, c: i64) -> bool {\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c {\n                return true;\n            }\n        }\n        false\n    }\n}\n\n// ---- Parsing (0.24) ----\n\n// What went wrong, or what was asked instead of a run: --help and\n// --version are CliErrors too, whose exit code is 0.\n");
    buf_str(out, c"#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum CliErrorKind {\n    Help,\n    Version,\n    UnknownOption,\n    UnknownCommand,\n    UnexpectedArgument,\n    MissingValue,\n    FlagValue,\n    MissingRequired,\n    InvalidValue,\n    // (0.25) a program's own: CliError::custom\n    Custom,\n    // (0.25.2) no subcommand given to a Command::subcommand_required\n    MissingSubcommand,\n    // (0.25.2) two arguments given that Arg::conflicts_with keeps apart\n    ArgumentConflict,\n}\n\n// An error of parse (or Matches::get_as): Display gives its two lines,\n// `error: ...` and `try: ...`; cmd.exit(e) prints them with the usage line\n// (or the help, the version) and exits with e.exit_code().\n#[derive(Clone, Copy)]\npub struct CliError<'a> {\n    pub kind: CliErrorKind,\n    // the argument as given ('--outt', '-vx', the bad value)\n    pub text: &'a str,\n    // the command it is about (cmd.render_in prints its usage)\n    cmd: i64,\n    // an unknown short option inside a cluster (`-x` of `-vx`)\n    short: char,\n    // the argument it is about\n    arg: Arg<'a>,\n    // did you mean: a long option (`--` before it) or a command\n    hint: &'a str,\n    hint_long: bool,\n    // (0.25.2) ArgumentConflict: the other argument as given (`other_short`:\n    // a letter of a cluster)\n    other: &'a str,\n    other_short: char,\n}\n\nimpl<'a> CliError<'a> {\n    fn new(kind: CliErrorKind, cmd: i64, text: &'a str) -> CliError<'a> {\n        CliError {\n            kind: kind, text: text, cmd: cmd, short: '\\0', arg: Arg::make(\"\", FLAG), hint: \"\",\n            hint_long: false, other: \"\", other_short: '\\0',\n        }\n    }\n\n    fn of(kind: CliErrorKind, cmd: i64, text: &'a str, a: Arg<'a>) -> CliError<'a> {\n        let mut e = CliError::new(kind, cmd, text);\n        e.arg = a;\n        e\n    }\n\n    // (0.25) A program's own error, in std::cli's form: `error: MESSAGE`,\n    // `try: TRY` (none when \"\"), then the usage line (cmd.exit(e), exit\n");
    buf_str(out, c"    // code 2): `CliError::custom(\"-b and -t together\", \"-b FILE\")`.\n    #[effects()]\n    pub fn custom(message: &'a str, try_line: &'a str) -> CliError<'a> {\n        let mut e = CliError::new(CliErrorKind::Custom, 0, message);\n        e.hint = try_line;\n        e\n    }\n\n    // (0.25) The unknown letter of a cluster (`x` of `-vx`), else 0.\n    // std2: changed: a char ('\\0': none; MVS: a byte, 0)\n    #[effects()]\n    pub fn letter(self) -> char {\n        self.short\n    }\n\n    // 0 for --help and --version, else 2 (a usage error, as clap's).\n    #[effects()]\n    pub fn exit_code(self) -> i32 {\n        match self.kind {\n            CliErrorKind::Help => 0,\n            CliErrorKind::Version => 0,\n            _ => 2,\n        }\n    }\n}\n\n// How an argument is written: `--out <FILE>`, `-o <FILE>`, `--verbose`,\n// `<input>`, `<file>...`.\n#[derive(Clone, Copy)]\nstruct Spell<'a> {\n    a: Arg<'a>,\n}\n\nimpl Display for Spell<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let a = self.a;\n        if a.kind == POSITIONAL {\n            f.write_char('<')?;\n            // (0.25: its value_name, when it has one)\n            f.write_str((if a.value_name.len() as i64 > 0 { a.value_name } else { a.name }))?;\n            f.write_char('>')?;\n            if a.multiple {\n                f.write_str(\"...\")?;\n            }\n            return Ok(());\n        }\n        if a.long.len() as i64 > 0 {\n            f.write_str(\"--\")?;\n            f.write_str(a.long)?;\n        } else {\n            f.write_char('-')?;\n            f.write_char(a.short as char)?;\n        }\n        if a.kind == OPTION {\n            // (0.25.2) an optional value: `--stats[=<STATS>]`\n            f.write_str((if a.has_missing { \"[=\" } else { \" \" }))?;\n            write(f, \"{}\", (ValueName { a: a }))?;\n            if a.has_missing {\n                f.write_char(']')?;\n            }\n        }\n        Ok(())\n    }\n}\n\n");
    buf_str(out, c"// `<FILE>`: an option's value name, or its name in capitals.\n#[derive(Clone, Copy)]\nstruct ValueName<'a> {\n    a: Arg<'a>,\n}\n\nimpl Display for ValueName<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.a.num_values > 1 {\n            // (0.25.2) `<PATH> <COPY>`: value_name's words (the last\n            // repeated), else the name n times\n            let mut k: i64 = 0;\n            let mut last: &str = \"\";\n            for w in self.a.value_name.split(' ') {\n                if w.len() as i64 > 0 && k < self.a.num_values {\n                    if k > 0 {\n                        f.write_char(' ')?;\n                    }\n                    f.write_char('<')?;\n                    f.write_str(w)?;\n                    f.write_char('>')?;\n                    last = w;\n                    k += 1;\n                }\n            }\n            while k < self.a.num_values {\n                if k > 0 {\n                    f.write_char(' ')?;\n                }\n                if last.len() as i64 > 0 {\n                    f.write_char('<')?;\n                    f.write_str(last)?;\n                    f.write_char('>')?;\n                } else {\n                    let mut one = self.a;\n                    one.num_values = 1;\n                    write(f, \"{}\", (ValueName { a: one }))?;\n                }\n                k += 1;\n            }\n            return Ok(());\n        }\n        f.write_char('<')?;\n        if self.a.value_name.len() as i64 > 0 {\n            f.write_str(self.a.value_name)?;\n        } else if self.a.choices.len() as i64 > 0 {\n            f.write_str(self.a.choices)?;\n        } else {\n            for c in self.a.name.bytes() {\n                f.write_char((if c >= b'a' && c <= b'z' { c - 32 } else if c == b'-' { b'_' }\n                    else { c }) as char)?;\n            }\n        }\n        f.write_char('>')?;\n        Ok(())\n    }\n}\n\n");
    buf_str(out, c"// std2: changed: Debug, which `unwrap` needs (MVS's Result had no bound):\n// the kind and the argument as given, `CliError { kind: UnknownOption,\n// text: \"--outt\" }`.\nimpl Debug for CliError<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"CliError { kind: \")?;\n        Debug::fmt(&self.kind, f)?;\n        f.write_str(\", text: \")?;\n        Debug::fmt(self.text, f)?;\n        f.write_str(\" }\")\n    }\n}\n\nimpl Display for CliError<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let sp = Spell { a: self.arg };\n        match self.kind {\n            CliErrorKind::Help => f.write_str(\"help requested: cmd.exit(e) prints it\")?,\n            CliErrorKind::Version => f.write_str(\"version requested: cmd.exit(e) prints it\")?,\n            CliErrorKind::UnknownOption => {\n                f.write_str(\"error: unknown option '\")?;\n                if self.short != '\\0' {\n                    f.write_char('-')?;\n                    f.write_char(self.short)?;\n                    if self.text.len() as i64 > 2 {\n                        f.write_str(\"' in '\")?;\n                        f.write_str(self.text)?;\n                    }\n                } else {\n                    f.write_str(self.text)?;\n                }\n                f.write_str(\"'\\ntry: \")?;\n                if self.hint.len() as i64 > 0 {\n                    if self.hint_long {\n                        f.write_str(\"--\")?;\n                    }\n                    f.write_str(self.hint)?;\n                } else {\n                    f.write_str(\"--help\")?;\n                }\n            }\n            CliErrorKind::UnknownCommand => {\n                f.write_str(\"error: unknown command '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: \")?;\n                f.write_str((if self.hint.len() as i64 > 0 { self.hint } else { \"--help\" }))?;\n            }\n");
    buf_str(out, c"            CliErrorKind::UnexpectedArgument => {\n                f.write_str(\"error: unexpected argument '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: --help\")?;\n            }\n            CliErrorKind::MissingValue => {\n                f.write_str(\"error: option '\")?;\n                if self.short != '\\0' {\n                    f.write_char('-')?;\n                    f.write_char(self.short)?;\n                } else {\n                    f.write_str(self.text)?;\n                }\n                f.write_str(\"' needs a value\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::FlagValue => {\n                f.write_str(\"error: flag '\")?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"' takes no value\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::MissingRequired => {\n                f.write_str((if self.arg.kind == POSITIONAL { \"error: missing argument '\" }\n                    else { \"error: missing option '\" }))?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"'\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::MissingSubcommand => {\n                // (cmd.render_in names the subcommands)\n                f.write_str(\"error: missing command for '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: --help\")?;\n            }\n            CliErrorKind::ArgumentConflict => {\n                f.write_str(\"error: '\")?;\n                written(f, self.text, self.short)?;\n                f.write_str(\"' cannot be used with '\")?;\n                written(f, self.other, self.other_short)?;\n                f.write_str(\"'\\ntry: drop '\")?;\n                written(f, self.text, self.short)?;\n                f.write_str(\"' (or '\")?;\n");
    buf_str(out, c"                written(f, self.other, self.other_short)?;\n                f.write_str(\"')\")?;\n            }\n            CliErrorKind::Custom => {\n                f.write_str(\"error: \")?;\n                f.write_str(self.text)?;\n                if self.hint.len() as i64 > 0 {\n                    f.write_str(\"\\ntry: \")?;\n                    f.write_str(self.hint)?;\n                }\n            }\n            CliErrorKind::InvalidValue => {\n                f.write_str(\"error: invalid value '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"' for '\")?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"'\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n        }\n        Ok(())\n    }\n}\n\n// An argument as given: `-c` (short, a letter of a cluster), else text.\nfn written(f: &mut Formatter<'_>, text: &str, short: char) -> crate::fmt::Result {\n    if short != '\\0' {\n        f.write_char('-')?;\n        f.write_char(short)\n    } else {\n        f.write_str(text)\n    }\n}\n\n// The edit distance of a and b: insertions, deletions, substitutions and\n// swaps of two neighbours (`--nmae` is 1 from `--name`); 64 beyond 63\n// bytes.\nfn distance(a: &str, b: &str) -> i64 {\n    let a = a.as_bytes();\n    let b = b.as_bytes();\n    if a.len() as i64 > 63 || b.len() as i64 > 63 {\n        return 64;\n    }\n    let mut prev2: [i64; 64] = [0i64; 64];\n    let mut prev: [i64; 64] = [0i64; 64];\n    let mut cur: [i64; 64] = [0i64; 64];\n    for j in 0..b.len() as i64 + 1 {\n        prev[j as usize] = j;\n    }\n    for i in 1..a.len() as i64 + 1 {\n        cur[0] = i;\n        for j in 1..b.len() as i64 + 1 {\n            let mut best = prev[(j - 1) as usize] + if a[(i - 1) as usize]\n                == b[(j - 1) as usize] { 0 } else { 1 };\n            if prev[j as usize] + 1 < best {\n                best = prev[j as usize] + 1;\n            }\n");
    buf_str(out, c"            if cur[(j - 1) as usize] + 1 < best {\n                best = cur[(j - 1) as usize] + 1;\n            }\n            if i > 1 && j > 1 && a[(i - 1) as usize] == b[(j - 2) as usize]\n                && a[(i - 2) as usize] == b[(j - 1) as usize]\n                && prev2[(j - 2) as usize] + 1 < best {\n                best = prev2[(j - 2) as usize] + 1;\n            }\n            cur[j as usize] = best;\n        }\n        for j in 0..b.len() as i64 + 1 {\n            prev2[j as usize] = prev[j as usize];\n            prev[j as usize] = cur[j as usize];\n        }\n    }\n    prev[b.len() as i64 as usize]\n}\n\n// Whether a candidate at distance d from word is worth suggesting.\nfn near(d: i64, word: &str) -> bool {\n    let most: i64 = if word.len() as i64 / 3 > 1 { word.len() as i64 / 3 } else { 1 };\n    d <= most\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // The long option of c nearest to word (its own name, when an alias\n    // is the nearest), or \"\".\n    fn near_long(&self, c: i64, word: &str) -> &'a str {\n        let mut best: &'a str = \"\";\n        let mut bd: i64 = 64;\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if self.of_cmd(a, c) && a.kind != POSITIONAL && !a.hidden && a.long.len() as i64 > 0 {\n                let mut d = distance(word, a.long);\n                let da = a.aliases.nearest(word);\n                if da < d {\n                    d = da;\n                }\n                if d < bd {\n                    bd = d;\n                    best = a.long;\n                }\n            }\n        }\n        let builtin: [&str; 2] = [\"help\", \"version\"];\n        for k in 0..2 {\n            if k == 1 && self.cmds[c as usize].version.len() as i64 == 0 {\n                continue;\n            }\n            let d = distance(word, builtin[k as usize]);\n            if d < bd {\n                bd = d;\n                best = builtin[k as usize];\n");
    buf_str(out, c"            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The subcommand of c nearest to word (by its name or an alias): its\n    // name, or \"\".\n    fn near_sub(&self, c: i64, word: &str) -> &'a str {\n        let mut best: &'a str = \"\";\n        let mut bd: i64 = 64;\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden {\n                let mut d = distance(word, self.cmds[i as usize].name);\n                let da = self.cmds[i as usize].aliases.nearest(word);\n                if da < d {\n                    d = da;\n                }\n                if d < bd {\n                    bd = d;\n                    best = self.cmds[i as usize].name;\n                }\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The argument of c with long form (or alias) name, or -1: c's own\n    // first, then the global ones of the commands above it.\n    fn find_long(&self, c: i64, name: &str) -> i64 {\n        for i in 0..self.args.len() as i64 {\n            if self.args[i as usize].cmd == c && self.args[i as usize].long_is(name) {\n                return i;\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd != c && a.long_is(name) && self.of_cmd(a, c) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // The argument of c with short form ch, or -1 (as find_long).\n    fn find_short(&self, c: i64, ch: char) -> i64 {\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd == c && a.kind != POSITIONAL && a.short != '\\0' && a.short == ch {\n                return i;\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n");
    buf_str(out, c"            if a.cmd != c && a.kind != POSITIONAL && a.short != '\\0' && a.short == ch\n                && self.of_cmd(a, c) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Whether tok, starting with '-', is an option of c: `--name`\n    // (`--name=v`) or `-x...` whose first letter is one (`-h`, `--help`,\n    // `-V`, `--version` too).\n    fn known(&self, c: i64, tok: &str) -> bool {\n        let b = tok.as_bytes();\n        let versioned = self.cmds[c as usize].version.len() as i64 > 0;\n        if b[1] == b'-' {\n            let body = tok.strip_prefix(\"--\").unwrap();\n            let name = match body.split_once('=') {\n                Option::Some((n, _)) => n,\n                Option::None => body,\n            };\n            return self.find_long(c, name) >= 0 || name == \"help\"\n                || (name == \"version\" && versioned);\n        }\n        self.find_short(c, b[1] as char) >= 0 || tok == \"-h\" || (tok == \"-V\" && versioned)\n    }\n\n    // Parses args (the program's name first, as env::args() gives them),\n    // the Matches on the command's allocator.\n    #[effects(CA, I)]\n    pub fn parse<I: Iterator<Item = &'a str>>(&self, args: I) -> Result<Matches<'a, CA>,\n        CliError<'a>> {\n        self.parse_in(args, self.alloc.clone())\n    }\n\n    // Parses args, the Matches on allocator a.\n    #[effects(panic, diverge, CA, I, A)]\n    pub fn parse_in<I: Iterator<Item = &'a str>, A: Allocator + Clone>(&self, args: I, a: A)\n        -> Result<Matches<'a, A>, CliError<'a>> {\n        let mut it = args;\n        let _ = it.next();\n        let mut m: Matches<'a, A> = Matches {\n            slots: Vec::new_in(a.clone()), marks: Vec::new_in(a.clone()),\n            texts: Vec::new_in(a.clone()), names: Vec::new_in(a.clone()),\n            cmds: Vec::new_in(a.clone()), indices: Vec::new_in(a), level: 0,\n        };\n        // the index of tok among the arguments (the program's name: 0)\n");
    buf_str(out, c"        let mut at: i64 = 0;\n        let mut cur: i64 = 0;\n        m.enter(self, 0i64);\n        let mut npos: i64 = 0;\n        let mut dashdash = false;\n        // the slot an option waits for values in, how many more (0.25.2:\n        // num_values), and how it was written\n        let mut pending: i64 = -1;\n        let mut pending_left: i64 = 0;\n        let mut pending_text: &'a str = \"\";\n        let mut pending_short: char = '\\0';\n        // a required argument missing: reported at the end, so that a\n        // later --help still prints the help\n        let mut late = CliError::new(CliErrorKind::Help, 0, \"\");\n        let mut has_late = false;\n        loop {\n            let tok = match it.next() {\n                Option::Some(t) => t,\n                Option::None => break,\n            };\n            at += 1;\n            if pending >= 0 {\n                m.push(pending, tok, at);\n                pending_left -= 1;\n                if pending_left == 0 {\n                    pending = -1;\n                }\n                continue;\n            }\n            let b = tok.as_bytes();\n            let mut word = dashdash || b.len() as i64 < 2 || b[0] != b'-';\n            if !word && tok != \"--\" {\n                // (0.25.2) a positional that takes values starting with '-'\n                let s = m.positional(npos);\n                word = s >= 0 && m.slots[s as usize].arg.hyphen && !self.known(cur, tok);\n            }\n            if word {\n                // a positional, or a subcommand's name\n                if !dashdash {\n                    let sub = self.sub_named(cur, tok);\n                    if sub >= 0 {\n                        match m.finish(cur) {\n                            Err(e) => if !has_late {\n                                late = e;\n                                has_late = true;\n                            },\n                            Ok(_) => {}\n                        }\n");
    buf_str(out, c"                        cur = sub;\n                        m.enter(self, sub);\n                        npos = 0;\n                        continue;\n                    }\n                }\n                let mut s = m.positional(npos);\n                if dashdash {\n                    // (0.25.2) the words after `--` go to a `last` positional\n                    let l = m.last_positional();\n                    if l >= 0 {\n                        s = if m.slots[l as usize].arg.multiple\n                            || m.slots[l as usize].count == 0 { l } else { -1 };\n                    }\n                }\n                if s >= 0 {\n                    m.given(s, tok, '\\0', at);\n                    m.push(s, tok, at);\n                    if !m.slots[s as usize].arg.multiple {\n                        npos += 1;\n                    }\n                    continue;\n                }\n                if self.has_subs(cur) {\n                    let mut e = CliError::new(CliErrorKind::UnknownCommand, cur, tok);\n                    e.hint = self.near_sub(cur, tok);\n                    return Err(e);\n                }\n                return Err(CliError::new(CliErrorKind::UnexpectedArgument, cur, tok));\n            }\n            if tok == \"--\" {\n                dashdash = true;\n                continue;\n            }\n            if b[1] == b'-' {\n                // --name, --name=value\n                let body = tok.strip_prefix(\"--\").unwrap();\n                let mut name = body;\n                let mut value: &str = \"\";\n                let mut has_value = false;\n                match body.split_once('=') {\n                    Option::Some((n, v)) => {\n                        name = n;\n                        value = v;\n                        has_value = true;\n                    }\n                    Option::None => {}\n                }\n");
    buf_str(out, c"                let shown = if has_value { tok.split_once('=').unwrap().0 } else { tok };\n                let i = self.find_long(cur, name);\n                if i < 0 {\n                    if name == \"help\" {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if name == \"version\" && self.cmds[cur as usize].version.len() as i64 > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, shown);\n                    e.hint = self.near_long(cur, name);\n                    e.hint_long = true;\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                let x = self.args[i as usize];\n                m.given(s, shown, '\\0', at);\n                if x.kind == FLAG {\n                    if has_value {\n                        return Err(CliError::of(CliErrorKind::FlagValue, cur, tok, x));\n                    }\n                    m.flag_at(s, at);\n                } else if has_value {\n                    m.push(s, value, at);\n                    if x.num_values > 1 {\n                        pending = s;\n                        pending_left = x.num_values - 1;\n                        pending_text = shown;\n                        pending_short = '\\0';\n                    }\n                } else if x.has_missing {\n                    m.push(s, x.missing, at);\n                } else {\n                    pending = s;\n                    pending_left = x.num_values;\n                    pending_text = tok;\n                    pending_short = '\\0';\n                }\n                continue;\n            }\n            // -abc: short flags, the last may be an option (-ofile, -o file)\n            let mut j: i64 = 1;\n            while j < b.len() as i64 {\n");
    buf_str(out, c"                let ch = b[j as usize] as char;\n                let i = self.find_short(cur, ch);\n                if i < 0 {\n                    if ch == 'h' {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if ch == 'V' && self.cmds[cur as usize].version.len() as i64 > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, tok);\n                    e.short = ch;\n                    // `-verbose` for `--verbose`\n                    if b.len() as i64 > 2 {\n                        let word = tok.strip_prefix(\"-\").unwrap();\n                        if self.find_long(cur, word) >= 0 {\n                            e.hint = self.args[self.find_long(cur, word) as usize].long;\n                        } else {\n                            e.hint = self.near_long(cur, word);\n                        }\n                        e.hint_long = e.hint.len() as i64 > 0;\n                    }\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                let x = self.args[i as usize];\n                m.given(s, tok, ch, at);\n                if x.kind == FLAG {\n                    m.flag_at(s, at);\n                    j += 1;\n                    continue;\n                }\n                // (after an ASCII byte: UTF-8)\n                let mut rest = crate::str::from_utf8(&b[(j + 1) as usize..]).unwrap_or(\"\");\n                let mut eq = false;\n                match rest.strip_prefix(\"=\") {\n                    Option::Some(r) => {\n                        rest = r;\n                        eq = true;\n                    }\n                    Option::None => {}\n                }\n                if x.has_missing && !eq {\n                    // (0.25.2) an optional value: only `-s=x` gives one\n");
    buf_str(out, c"                    m.push(s, x.missing, at);\n                    j += 1;\n                    continue;\n                }\n                if rest.len() as i64 > 0 || eq {\n                    m.push(s, rest, at);\n                    if x.num_values > 1 {\n                        pending = s;\n                        pending_left = x.num_values - 1;\n                        pending_text = tok;\n                        pending_short = ch;\n                    }\n                } else {\n                    pending = s;\n                    pending_left = x.num_values;\n                    pending_text = tok;\n                    pending_short = ch;\n                }\n                break;\n            }\n        }\n        if pending >= 0 {\n            let mut e = CliError::of(CliErrorKind::MissingValue, cur, pending_text,\n                m.slots[pending as usize].arg);\n            e.short = pending_short;\n            return Err(e);\n        }\n        if has_late {\n            return Err(late);\n        }\n        if self.cmds[cur as usize].sub_required {\n            return Err(CliError::new(CliErrorKind::MissingSubcommand, cur,\n                self.cmds[cur as usize].name));\n        }\n        m.finish(cur)?;\n        m.finish_globals(cur)?;\n        m.conflicts()?;\n        m.group();\n        // (0.25) the values of arguments with choices\n        for s in 0..m.slots.len() as i64 {\n            let sl = m.slots[s as usize];\n            for k in sl.start..sl.start + sl.len {\n                if !chosen(m.texts[k as usize], sl.arg.choices) {\n                    return Err(CliError::of(CliErrorKind::InvalidValue, self.cmds_of(sl.level, &m),\n                        m.texts[k as usize], sl.arg));\n                }\n            }\n        }\n        Ok(m)\n    }\n}\n\n// ---- Matches (0.24) ----\n\n// An argument of a matched command: how many times it was given, and\n// (after parse) where its values are in Matches.texts.\n#[derive(Clone, Copy)]\n");
    buf_str(out, c"struct Slot<'a> {\n    level: i64,\n    index: i64,\n    arg: Arg<'a>,\n    count: i64,\n    start: i64,\n    len: i64,\n    // (0.25) where its occurrences are in Matches.marks, after parse\n    pstart: i64,\n    plen: i64,\n    // (0.25.2) how it was last given (`--text`, or the letter of `-bt`) and\n    // where: for an ArgumentConflict\n    wtext: &'a str,\n    wshort: char,\n    wat: i64,\n}\n\n// A global argument, of its command and the subcommands below.\nfn is_global(a: Arg<'_>) -> bool {\n    a.global && a.kind != POSITIONAL\n}\n\n// What parse found: for the command and each subcommand on the line (a\n// level each), every argument's count and values. `m.subcommand()` gives\n// the next level's Matches.\npub struct Matches<'a, A: Allocator> {\n    slots: Vec<Slot<'a>, A>,\n    // (0.25) while parsing, a pair for each value or flag given: its slot\n    // (-1 - slot: a flag, no value) and its index among the arguments (-1:\n    // a default); after, those indices by slot (Slot.pstart)\n    marks: Vec<i64, A>,\n    // the values (after parse: by slot, Slot.start)\n    texts: Vec<&'a str, A>,\n    // each level's command: its name and index\n    names: Vec<&'a str, A>,\n    cmds: Vec<i64, A>,\n    // (after parse) each slot's indices among the arguments (Slot.pstart)\n    indices: Vec<i64, A>,\n    level: i64,\n}\n\nimpl<'a, A: Allocator + Clone> Matches<'a, A> {\n    // A new level for command c: a slot for each of its arguments.\n    fn enter<CA: Allocator + Clone>(&mut self, cmd: &Command<'a, CA>, c: i64) {\n        self.level = self.names.len() as i64;\n        self.names.push(cmd.cmds[c as usize].name);\n        self.cmds.push(c);\n        for i in 0..cmd.args.len() as i64 {\n            if cmd.args[i as usize].cmd == c {\n                self.slots.push(Slot {\n                    level: self.level, index: i, arg: cmd.args[i as usize], count: 0, start: 0,\n                    len: 0,\n");
    buf_str(out, c"                    pstart: 0, plen: 0, wtext: \"\", wshort: '\\0', wat: 0,\n                });\n            }\n        }\n    }\n\n    // The slot of argument i (on its command's level: a global argument's\n    // is above the last).\n    fn slot_of(&self, i: i64) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            if self.slots[s as usize].index == i {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // The slot of the k-th positional of the last level (not counting a\n    // `last` one), or -1.\n    fn positional(&self, k: i64) -> i64 {\n        let mut n: i64 = 0;\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level == self.level && sl.arg.kind == POSITIONAL && !sl.arg.last {\n                if n == k {\n                    return s;\n                }\n                n += 1;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) The slot of the last level's `last` positional, or -1.\n    fn last_positional(&self) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level == self.level && sl.arg.kind == POSITIONAL && sl.arg.last {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Slot s given as text (short: the letter of a cluster) at\n    // argument index at.\n    fn given(&mut self, s: i64, text: &'a str, short: char, at: i64) {\n        self.slots[s as usize].wtext = text;\n        self.slots[s as usize].wshort = short;\n        self.slots[s as usize].wat = at;\n    }\n\n    // A value of slot s, at argument index at.\n    fn push(&mut self, s: i64, text: &'a str, at: i64) {\n        self.slots[s as usize].count += 1;\n        self.marks.push(s);\n        self.marks.push(at);\n        self.texts.push(text);\n    }\n\n    // A flag of slot s given, at argument index at.\n    fn flag_at(&mut self, s: i64, at: i64) {\n");
    buf_str(out, c"        self.slots[s as usize].count += 1;\n        self.marks.push(-1 - s);\n        self.marks.push(at);\n    }\n\n    // Slot s not given: its default, or an error when it is required.\n    fn absent(&mut self, s: i64, c: i64) -> Result<(), CliError<'a>> {\n        let sl = self.slots[s as usize];\n        if sl.arg.has_default {\n            self.marks.push(s);\n            self.marks.push(-1);\n            self.texts.push(sl.arg.default);\n        } else if sl.arg.required {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        Ok(())\n    }\n\n    // The end of command c's arguments: the defaults, the required ones\n    // (a global argument's at the end, finish_globals).\n    fn finish(&mut self, c: i64) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level != self.level || sl.count > 0 || is_global(sl.arg) {\n                continue;\n            }\n            self.absent(s, c)?;\n        }\n        Ok(())\n    }\n\n    // (0.25.2) The global arguments not given, on any level (an error is\n    // about c, the last command).\n    fn finish_globals(&mut self, c: i64) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.count == 0 && is_global(sl.arg) {\n                self.absent(s, c)?;\n            }\n        }\n        Ok(())\n    }\n\n    // (0.25.2) Two arguments given that conflicts_with keeps apart: an\n    // error naming both as given, the later first.\n    fn conflicts(&self) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.count == 0 {\n                continue;\n            }\n            for k in 0..sl.arg.conflicts.n {\n                for name in sl.arg.conflicts.name_at(k).split('|') {\n");
    buf_str(out, c"                    let o = self.find_at(sl.level, name);\n                    if o < 0 {\n                        crate::panic::panic(\n                            \"std::cli: conflicts_with: no argument by that name in this command\");\n                    }\n                    if self.slots[o as usize].count == 0 || o == s {\n                        continue;\n                    }\n                    let mut p = s;\n                    let mut q = o;\n                    if self.slots[o as usize].wat > sl.wat {\n                        p = o;\n                        q = s;\n                    }\n                    let mut e = CliError::of(CliErrorKind::ArgumentConflict,\n                        self.cmds[sl.level as usize], self.slots[p as usize].wtext,\n                        self.slots[p as usize].arg);\n                    e.short = self.slots[p as usize].wshort;\n                    e.other = self.slots[q as usize].wtext;\n                    e.other_short = self.slots[q as usize].wshort;\n                    return Err(e);\n                }\n            }\n        }\n        Ok(())\n    }\n\n    // Each slot's values together, in the order given, and their indices\n    // among the arguments; the first level current.\n    fn group(&mut self) {\n        let n = self.marks.len() as i64 / 2;\n        let mut out: Vec<&'a str, A> = Vec::with_capacity_in(self.texts.len(),\n            self.texts.allocator().clone());\n        for s in 0..self.slots.len() as i64 {\n            self.slots[s as usize].start = out.len() as i64;\n            let mut t: i64 = 0;\n            for k in 0..n {\n                let o = self.marks[(2 * k) as usize];\n                if o >= 0 {\n                    if o == s {\n                        out.push(self.texts[t as usize]);\n                    }\n                    t += 1;\n                }\n            }\n            self.slots[s as usize].len = out.len() as i64 - self.slots[s as usize].start;\n        }\n");
    buf_str(out, c"        self.texts = out;\n        // the indices by slot\n        for s in 0..self.slots.len() as i64 {\n            self.slots[s as usize].pstart = self.indices.len() as i64;\n            for k in 0..n {\n                let o = self.marks[(2 * k) as usize];\n                let at = self.marks[(2 * k + 1) as usize];\n                if at >= 0 && (o == s || o == -1 - s) {\n                    self.indices.push(at);\n                }\n            }\n            self.slots[s as usize].plen = self.indices.len() as i64 - self.slots[s as usize].pstart;\n        }\n        self.level = 0;\n    }\n\n    // The slot of the argument named name on level level (or a global one\n    // of a level above), or -1.\n    fn find_at(&self, level: i64, name: &str) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            if self.slots[s as usize].level == level && self.slots[s as usize].arg.name == name {\n                return s;\n            }\n        }\n        let mut l = level - 1;\n        while l >= 0 {\n            for s in 0..self.slots.len() as i64 {\n                let sl = self.slots[s as usize];\n                if sl.level == l && is_global(sl.arg) && sl.arg.name == name {\n                    return s;\n                }\n            }\n            l -= 1;\n        }\n        -1\n    }\n\n    // The slot of the argument named name on this level (or a global one\n    // of a command above, 0.25.2).\n    fn find(&self, name: &str) -> i64 {\n        let s = self.find_at(self.level, name);\n        if s >= 0 {\n            return s;\n        }\n        crate::panic::panic(\"std::cli: Matches: no argument by that name in this command (an Arg's name, not its long or short form)\");\n    }\n\n    // (0.25.3) Whether the argument named name is a flag (no value: get,\n    // get_as and values refuse it, cli.kind); an unknown name is not\n    // (find reports it).\n    fn is_flag(&self, name: &str) -> bool {\n        let s = self.find_at(self.level, name);\n");
    buf_str(out, c"        s >= 0 && self.slots[s as usize].arg.kind == FLAG\n    }\n\n    // Whether the argument was given (a default does not count).\n    #[effects(panic, A)]\n    pub fn flag(&self, name: &str) -> bool {\n        self.slots[self.find(name) as usize].count > 0\n    }\n\n    // How many times it was given: `-vvv` is 3.\n    // std2: changed: a usize (MVS: i64)\n    #[effects(panic, A)]\n    pub fn count(&self, name: &str) -> usize {\n        self.slots[self.find(name) as usize].count as usize\n    }\n\n    // Its value (the last one given), else its default.\n    #[effects(panic, A)]\n    pub fn get(&self, name: &str) -> Option<&'a str>\n        requires !self.is_flag(name)\n        else \"cli.kind: m.get(NAME) of a flag, which has no value (it would always be None): read a flag with m.flag(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        if sl.len == 0 {\n            return Option::None;\n        }\n        Option::Some(self.texts[(sl.start + sl.len - 1) as usize])\n    }\n\n    // Every value given, in order (or its default).\n    #[effects(panic, A)]\n    pub fn values(&self, name: &str) -> &[&'a str]\n        requires !self.is_flag(name)\n        else \"cli.kind: m.values(NAME) of a flag, which has no value (it would always be empty): read a flag with m.flag(NAME), m.count(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        &self.texts.as_slice()[sl.start as usize..(sl.start + sl.len) as usize]\n    }\n\n    // (0.25) Where it was given: the index among the arguments (the\n    // program's name is 0) of each value, in order, or of each time a flag\n    // was given; a default has none. Clap's `indices_of`: the order of\n    // different arguments' values (`-l m x.o -l z`), which `values` does\n    // not keep. (0.27.5) i64s, as MVS's: a program compares them with\n    // its own word indices, and a translation row cannot convert a\n    // slice's elements.\n    #[effects(panic, A)]\n");
    buf_str(out, c"    pub fn indices_of(&self, name: &str) -> &[i64] {\n        let sl = self.slots[self.find(name) as usize];\n        &self.indices.as_slice()[sl.pstart as usize..(sl.pstart + sl.plen) as usize]\n    }\n\n    // Its value parsed as a T (`m.get_as::<i64>(\"n\")`): an InvalidValue\n    // error naming the argument when it does not parse, MissingRequired\n    // when it has no value (give it a default, or make it required).\n    #[effects(panic, A, T)]\n    pub fn get_as<T: FromStr>(&self, name: &str) -> Result<T, CliError<'a>>\n        requires !self.is_flag(name)\n        else \"cli.kind: m.get_as(NAME) of a flag, which has no value: read a flag with m.flag(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        let c = self.cmds[self.level as usize];\n        if sl.len == 0 {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        let text = self.texts[(sl.start + sl.len - 1) as usize];\n        match T::from_str(text) {\n            Ok(v) => Ok(v),\n            Err(_) => Err(CliError::of(CliErrorKind::InvalidValue, c, text, sl.arg)),\n        }\n    }\n\n    // The subcommand given, its name, or None.\n    #[effects(panic, A)]\n    pub fn subcommand_name(&self) -> Option<&'a str> {\n        if self.level + 1 < self.names.len() as i64 {\n            return Option::Some(self.names[(self.level + 1) as usize]);\n        }\n        Option::None\n    }\n\n    // The subcommand given: its name and its Matches (a copy), or None.\n    #[effects(panic, A)]\n    pub fn subcommand(&self) -> Option<(&'a str, Matches<'a, A>)> {\n        if self.level + 1 >= self.names.len() as i64 {\n            return Option::None;\n        }\n        let sub = Matches {\n            slots: self.slots.clone(), marks: self.marks.clone(), texts: self.texts.clone(),\n            names: self.names.clone(), cmds: self.cmds.clone(), indices: self.indices.clone(),\n            level: self.level + 1,\n        };\n");
    buf_str(out, c"        Option::Some((self.names[(self.level + 1) as usize], sub))\n    }\n}\n\n// ---- Help and errors (0.24) ----\n\n// Writes text from column col (already there) to width, breaking at\n// spaces; later lines start at column indent.\nfn wrap<A: Allocator>(out: &mut String<A>, text: &str, col: i64, indent: i64, width: i64) {\n    let mut at = col;\n    let mut first = true;\n    for w in text.split(' ') {\n        if w.len() as i64 == 0 {\n            continue;\n        }\n        if !first {\n            if at + 1 + w.len() as i64 > width && at > indent {\n                out.push('\\n');\n                for _ in 0..indent {\n                    out.push(' ');\n                }\n                at = indent;\n            } else {\n                out.push(' ');\n                at += 1;\n            }\n        }\n        out.push_str(w);\n        at += w.len() as i64;\n        first = false;\n    }\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // `git remote add`: the names from the root to c.\n    fn path_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        let p = self.cmds[c as usize].parent;\n        if p >= 0 {\n            self.path_into(p, out);\n            out.push(' ');\n        }\n        out.push_str(self.cmds[c as usize].name);\n    }\n\n    // `usage: prog [options] --out <FILE> <input> [file]... [command]`\n    fn usage_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        out.push_str(\"usage: \");\n        self.path_into(c, out);\n        out.push_str(\" [options]\");\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if self.of_cmd(a, c) && a.kind == OPTION && a.required && !a.hidden {\n                out.push(' ');\n                write(out, \"{}\", Spell { a: a }).unwrap();\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n");
    buf_str(out, c"            if a.cmd == c && a.kind == POSITIONAL && !a.hidden {\n                out.push(' ');\n                if a.last {\n                    // (0.25.2) `[-- args]...`, `-- <args>...`\n                    if !a.required {\n                        out.push('[');\n                    }\n                    out.push_str(\"-- \");\n                    if a.required {\n                        write(out, \"{}\", Spell { a: a }).unwrap();\n                    } else {\n                        out.push_str(if a.value_name.len() as i64 > 0 { a.value_name }\n                            else { a.name });\n                        out.push(']');\n                        if a.multiple {\n                            out.push_str(\"...\");\n                        }\n                    }\n                } else if a.required {\n                    write(out, \"{}\", Spell { a: a }).unwrap();\n                } else {\n                    out.push('[');\n                    out.push_str(if a.value_name.len() as i64 > 0 { a.value_name } else { a.name });\n                    out.push(']');\n                    if a.multiple {\n                        out.push_str(\"...\");\n                    }\n                }\n            }\n        }\n        if self.has_subs(c) {\n            out.push_str(if self.cmds[c as usize].sub_required { \" <command>\" }\n                else { \" [command]\" });\n        }\n    }\n\n    // (0.25.2) A visible subcommand of c.\n    fn shown_sub(&self, i: i64, c: i64) -> bool {\n        self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden\n    }\n\n    fn has_shown_subs(&self, c: i64) -> bool {\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // (0.25.2) A MissingSubcommand's try: line, `prog remote <add|rm>`\n    // (one: `prog remote add`; many: `prog remote --help`).\n");
    buf_str(out, c"    fn try_sub_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        self.path_into(c, out);\n        out.push(' ');\n        let mut n: i64 = 0;\n        let mut len: i64 = 0;\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                n += 1;\n                len += self.cmds[i as usize].name.len() as i64 + 1;\n            }\n        }\n        if n == 0 || len > 48 {\n            out.push_str(\"--help\");\n            return;\n        }\n        if n > 1 {\n            out.push('<');\n        }\n        let mut first = true;\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                if !first {\n                    out.push('|');\n                }\n                out.push_str(self.cmds[i as usize].name);\n                first = false;\n            }\n        }\n        if n > 1 {\n            out.push('>');\n        }\n    }\n\n    // An argument's left column: `-o, --out <FILE>`, `    --tag`, `<input>`.\n    fn left_into<A: Allocator>(&self, a: Arg<'a>, out: &mut String<A>) {\n        if a.kind == POSITIONAL {\n            write(out, \"{}\", Spell { a: a }).unwrap();\n            return;\n        }\n        if a.short != '\\0' {\n            out.push('-');\n            out.push(a.short);\n            if a.long.len() as i64 > 0 {\n                out.push_str(\", \");\n            }\n        } else {\n            out.push_str(\"    \");\n        }\n        if a.long.len() as i64 > 0 {\n            out.push_str(\"--\");\n            out.push_str(a.long);\n        }\n        if a.kind == OPTION {\n            out.push_str(if a.has_missing { \"[=\" } else { \" \" });\n            write(out, \"{}\", ValueName { a: a }).unwrap();\n            if a.has_missing {\n                out.push(']');\n            }\n        }\n    }\n\n    // The rest of a table's line begun at out[start..] (its left column\n    // written): its help at column col.\n");
    buf_str(out, c"    fn row_end<A: Allocator>(&self, out: &mut String<A>, start: i64, help: &str, default: &str,\n        has_default: bool, col: i64) {\n        let mut at = out.len() as i64 - start;\n        if help.len() as i64 > 0 || has_default {\n            if at + 2 > col {\n                out.push('\\n');\n                at = 0;\n            }\n            while at < col {\n                out.push(' ');\n                at += 1;\n            }\n            wrap(out, help, col, col, self.width);\n            if has_default {\n                if help.len() as i64 > 0 {\n                    out.push(' ');\n                }\n                out.push_str(\"[default: \");\n                out.push_str(default);\n                out.push(']');\n            }\n        }\n        out.push('\\n');\n    }\n\n    // A table's line: name, then its help at column col.\n    fn row<A: Allocator>(&self, out: &mut String<A>, name: &str, help: &str, col: i64) {\n        let start = out.len() as i64;\n        out.push_str(\"  \");\n        out.push_str(name);\n        self.row_end(out, start, help, \"\", false, col);\n    }\n\n    // An argument's line of a table.\n    fn arg_row<A: Allocator>(&self, out: &mut String<A>, x: Arg<'a>, col: i64) {\n        let start = out.len() as i64;\n        out.push_str(\"  \");\n        self.left_into(x, out);\n        self.row_end(out, start, x.help, x.default, x.has_default, col);\n    }\n\n    // The help of command c.\n    fn help_into<A: Allocator + Clone>(&self, c: i64, out: &mut String<A>, a: A) {\n        let cmd = self.cmds[c as usize];\n        self.path_into(c, out);\n        if cmd.version.len() as i64 > 0 {\n            out.push(' ');\n            out.push_str(cmd.version);\n        }\n        out.push('\\n');\n        if cmd.about.len() as i64 > 0 {\n            wrap(out, cmd.about, 0i64, 0i64, self.width);\n            out.push('\\n');\n        }\n        out.push('\\n');\n        self.usage_into(c, out);\n        out.push('\\n');\n");
    buf_str(out, c"        // the left column's width: the widest entry, at most 24\n        let mut left = String::new_in(a);\n        let mut widest: i64 = 13;\n        for i in 0..self.args.len() as i64 {\n            if self.of_cmd(self.args[i as usize], c) && !self.args[i as usize].hidden {\n                left.clear();\n                self.left_into(self.args[i as usize], &mut left);\n                if left.len() as i64 > widest && left.len() as i64 <= 24 {\n                    widest = left.len() as i64;\n                }\n            }\n        }\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) && self.cmds[i as usize].name.len() as i64 > widest\n                && self.cmds[i as usize].name.len() as i64 <= 24 {\n                widest = self.cmds[i as usize].name.len() as i64;\n            }\n        }\n        let col = 2 + widest + 2;\n        let mut any = false;\n        for i in 0..self.args.len() as i64 {\n            let x = self.args[i as usize];\n            if x.cmd == c && x.kind == POSITIONAL && !x.hidden {\n                if !any {\n                    out.push_str(\"\\narguments:\\n\");\n                    any = true;\n                }\n                self.arg_row(out, x, col);\n            }\n        }\n        out.push_str(\"\\noptions:\\n\");\n        let mut own_help = false;\n        let mut own_version = false;\n        for i in 0..self.args.len() as i64 {\n            let x = self.args[i as usize];\n            if self.of_cmd(x, c) && x.kind != POSITIONAL && !x.hidden {\n                self.arg_row(out, x, col);\n                if x.long == \"help\" || x.short == 'h' {\n                    own_help = true;\n                }\n                if x.long == \"version\" || x.short == 'V' {\n                    own_version = true;\n                }\n            }\n        }\n        if !own_help {\n            self.row(out, \"-h, --help\", \"print this help\", col);\n        }\n");
    buf_str(out, c"        if !own_version && cmd.version.len() as i64 > 0 {\n            self.row(out, \"-V, --version\", \"print the version\", col);\n        }\n        if self.has_shown_subs(c) {\n            out.push_str(\"\\ncommands:\\n\");\n            for i in 1..self.cmds.len() as i64 {\n                if self.shown_sub(i, c) {\n                    self.row(out, self.cmds[i as usize].name, self.cmds[i as usize].about, col);\n                }\n            }\n        }\n    }\n\n    // The help, on allocator a.\n    #[effects(CA, A)]\n    pub fn help_in<A: Allocator + Clone>(&self, a: A) -> String<A> {\n        let mut out = String::new_in(a.clone());\n        self.help_into(0i64, &mut out, a);\n        out\n    }\n\n    // What cmd.exit(e) prints, on allocator a: the help or the version\n    // line, or e's two lines and the usage line.\n    #[effects(panic, diverge, CA, A)]\n    pub fn render_in<A: Allocator + Clone>(&self, e: CliError<'a>, a: A) -> String<A> {\n        let mut out = String::new_in(a.clone());\n        match e.kind {\n            CliErrorKind::Help => self.help_into(e.cmd, &mut out, a),\n            CliErrorKind::Version => {\n                self.path_into(e.cmd, &mut out);\n                out.push(' ');\n                out.push_str(self.cmds[e.cmd as usize].version);\n                out.push('\\n');\n            }\n            CliErrorKind::MissingSubcommand => {\n                out.push_str(\"error: missing command for '\");\n                self.path_into(e.cmd, &mut out);\n                out.push_str(\"'\\ntry: \");\n                self.try_sub_into(e.cmd, &mut out);\n                out.push('\\n');\n                self.usage_into(e.cmd, &mut out);\n                out.push('\\n');\n            }\n            _ => {\n                write(&mut out, \"{}\", e).unwrap();\n                out.push('\\n');\n                self.usage_into(e.cmd, &mut out);\n                out.push('\\n');\n            }\n        }\n        out\n    }\n\n");
    buf_str(out, c"    // Prints what e asks (the help and the version to stdout, an error\n    // to stderr) and ends the program with e.exit_code().\n    #[effects(io, static, panic, diverge, CA)]\n    pub fn exit(&self, e: CliError<'a>) -> ! {\n        let code = e.exit_code();\n        let text = self.render_in(e, self.alloc.clone());\n        if code == 0 {\n            crate::fmt::print(text.as_str());\n        } else {\n            crate::fmt::eprint(text.as_str());\n        }\n        crate::process::exit(code)\n    }\n\n    // parse, and on an error (or --help, --version) cmd.exit(e).\n    #[effects(CA, I)]\n    pub fn parse_or_exit<I: Iterator<Item = &'a str>>(&self, args: I) -> Matches<'a, CA> {\n        match self.parse(args) {\n            Ok(m) => m,\n            Err(e) => self.exit(e),\n        }\n    }\n}\n// ---- end mod std::cli ----\n}\n// ---- mod std::process ----\npub mod process {\n// EDITION: rust\n// std::process: running programs, Rust's, through posix_spawnp. A\n// Command keeps its program, its arguments and the variables env_remove\n// names as NUL-ended copies in Vecs on the allocator it was made with\n// (`Command::new_in(p, a)`, Rust's Command::new); argv and envp are built\n// on a clone of it when it runs. `output()`'s bytes go in Vecs on clones\n// of it too.\n// mvs: std::process\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::io::{Error, Read, Result, Write};\nuse crate::iter::{IntoIterator, Iterator};\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::vec::Vec;\n\n// UNSAFE: posix_spawn and the C library's process, pipe and signal calls,\n// which take raw pointers.\n// SAFETY: POSIX's prototypes (spawn.h, sys/wait.h, signal.h, unistd.h,\n// fcntl.h, poll.h; fcntl and open variadic, as declared); the file\n// actions, the attributes and the signal set live in words larger than\n// either system's types (SpawnActions, SpawnAttr below).\n");
    buf_str(out, c"extern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    #[effects(io)]\n    fn pr_c_spawnp(pid: *mut i32, file: *const u8, actions: *const u64, attr: *const u64,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n    #[effects(io)]\n    fn pr_c_actions_init(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    #[effects(io)]\n    fn pr_c_actions_destroy(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    #[effects(io)]\n    fn pr_c_actions_adddup2(a: *mut u64, fd: i32, to: i32) -> i32;\n    #[link_name = \"posix_spawnattr_init\"]\n    #[effects(io)]\n    fn pr_c_attr_init(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawnattr_destroy\"]\n    #[effects(io)]\n    fn pr_c_attr_destroy(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawnattr_setflags\"]\n    #[effects(io)]\n    fn pr_c_attr_setflags(a: *mut u64, flags: i16) -> i32;\n    #[link_name = \"posix_spawnattr_setsigdefault\"]\n    #[effects(io)]\n    fn pr_c_attr_setsigdefault(a: *mut u64, set: *const u64) -> i32;\n    #[link_name = \"sigemptyset\"]\n    #[effects()]\n    fn pr_c_sigemptyset(set: *mut u64) -> i32;\n    #[link_name = \"sigaddset\"]\n    #[effects()]\n    fn pr_c_sigaddset(set: *mut u64, sig: i32) -> i32;\n    #[link_name = \"signal\"]\n    fn pr_c_signal(sig: i32, handler: usize) -> usize;\n    #[link_name = \"waitpid\"]\n    #[effects(io)]\n    fn pr_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"kill\"]\n    #[effects(io)]\n    fn pr_c_kill(pid: i32, sig: i32) -> i32;\n    #[link_name = \"getpid\"]\n    #[effects(io)]\n    fn pr_c_getpid() -> i32;\n    #[link_name = \"pipe\"]\n    fn pr_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    #[effects(io)]\n    fn pr_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"open\"]\n    fn pr_c_open(path: *const u8, flags: i32, ...) -> i32;\n");
    buf_str(out, c"    #[link_name = \"close\"]\n    fn pr_c_close(fd: i32) -> i32;\n    #[link_name = \"poll\"]\n    #[effects(io)]\n    fn pr_c_poll(fds: *mut PollFd, n: u32, timeout: i32) -> i32;\n    #[link_name = \"exit\"]\n    fn pr_c_exit(code: i32) -> !;\n    #[link_name = \"abort\"]\n    fn pr_c_abort() -> !;\n}\n\nconst SIGINT: i32 = 2;\nconst SIGQUIT: i32 = 3;\nconst SIGKILL: i32 = 9;\nconst SIG_IGN: usize = 1;\nconst SIG_ERR: usize = usize::MAX;\nconst WNOHANG: i32 = 1;\nconst EINTR: i32 = 4;\nconst F_SETFD: i32 = 2;\nconst FD_CLOEXEC: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst POLLIN: i16 = 1;\n// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SPAWN_SETSIGDEF: i16 = 4;\n\n// struct pollfd, the same on both systems.\n#[repr(C)]\nstruct PollFd {\n    fd: i32,\n    events: i16,\n    revents: i16,\n}\n\n// Closes fd, when it is one (-1: none).\nfn close_fd(fd: i32) {\n    if fd >= 0 {\n        // UNSAFE: C's close. SAFETY: an int; each caller closes its own\n        // descriptor once.\n        let _ = unsafe { pr_c_close(fd) };\n    }\n}\n\n// A pipe, (read end, write end), both close-on-exec.\nfn pipe() -> Result<(i32, i32)> {\n    let mut fds = [0i32; 2];\n    // UNSAFE: C's pipe and fcntl. SAFETY: fds is a local [i32; 2], which\n    // pipe fills; F_SETFD takes an int.\n    unsafe {\n        if pr_c_pipe(&mut fds[0] as *mut i32) != 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        pr_c_fcntl(fds[0], F_SETFD, FD_CLOEXEC);\n        pr_c_fcntl(fds[1], F_SETFD, FD_CLOEXEC);\n    }\n    crate::result::Result::Ok((fds[0], fds[1]))\n}\n\n// ---- Stdio ----\n\n// What a child's stdin, stdout or stderr is: this process's (inherit),\n// /dev/null (null), or a pipe to this process (piped).\npub struct Stdio {\n    kind: u8,\n}\n\nconst INHERIT: u8 = 0;\nconst NULL: u8 = 1;\nconst PIPED: u8 = 2;\n// (not set: spawn and status inherit, output pipes stdout and stderr and\n// gives stdin /dev/null, as Rust's)\nconst DEFAULT: u8 = 3;\n");
    buf_str(out, c"\nimpl Stdio {\n    #[effects()]\n    pub fn inherit() -> Stdio {\n        Stdio { kind: INHERIT }\n    }\n\n    #[effects()]\n    pub fn null() -> Stdio {\n        Stdio { kind: NULL }\n    }\n\n    #[effects()]\n    pub fn piped() -> Stdio {\n        Stdio { kind: PIPED }\n    }\n}\n\n// ---- ExitStatus ----\n\n// How a child ended: its exit code, or the signal that ended it (the\n// status waitpid gives).\n#[derive(Clone, Copy, PartialEq, Eq)]\npub struct ExitStatus {\n    status: i32,\n}\n\nimpl ExitStatus {\n    // Whether it exited with 0.\n    #[effects()]\n    pub fn success(&self) -> bool {\n        self.status & 0xffff == 0\n    }\n\n    // Its exit code; None when a signal ended it.\n    #[effects()]\n    pub fn code(&self) -> Option<i32> {\n        if self.status & 0x7f == 0 { Option::Some((self.status >> 8) & 0xff) } else { Option::None }\n    }\n\n    // The signal that ended it.\n    // std2: changed: ExitStatus' own (Rust's: std::os::unix::process::\n    // ExitStatusExt)\n    #[effects()]\n    pub fn signal(&self) -> Option<i32> {\n        let s = self.status & 0x7f;\n        if s != 0 && s != 0x7f { Option::Some(s) } else { Option::None }\n    }\n}\n\n// `exit status: 3`, `signal: 9 (SIGKILL)`, as Rust's.\nimpl Display for ExitStatus {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.code() {\n            Option::Some(c) => {\n                f.write_str(\"exit status: \")?;\n                Display::fmt(&c, f)\n            }\n            Option::None => match self.signal() {\n                Option::Some(s) => {\n                    f.write_str(\"signal: \")?;\n                    Display::fmt(&s, f)?;\n                    let name = crate::__sys::signal_name(s);\n                    if !name.is_empty() {\n                        f.write_str(\" (\")?;\n                        f.write_str(name)?;\n                        f.write_str(\")\")?;\n                    }\n");
    buf_str(out, c"                    if self.status & 0x80 != 0 {\n                        f.write_str(\" (core dumped)\")?;\n                    }\n                    crate::result::Result::Ok(())\n                }\n                Option::None => {\n                    f.write_str(\"unrecognized wait status: \")?;\n                    Display::fmt(&self.status, f)\n                }\n            },\n        }\n    }\n}\n\n// `ExitStatus(unix_wait_status(256))`, as Rust's.\nimpl Debug for ExitStatus {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"ExitStatus(unix_wait_status(\")?;\n        Display::fmt(&self.status, f)?;\n        f.write_str(\"))\")\n    }\n}\n\n// What output() gives: how the child ended, and what it wrote.\npub struct Output<A: Allocator> {\n    pub status: ExitStatus,\n    pub stdout: Vec<u8, A>,\n    pub stderr: Vec<u8, A>,\n}\n\n// ---- Child ----\n\n// The child's stdin, when it was piped: a writer; dropping it closes it.\npub struct ChildStdin {\n    fd: i32,\n}\n\n// The child's stdout, when it was piped: a reader.\npub struct ChildStdout {\n    fd: i32,\n}\n\n// The child's stderr, when it was piped: a reader.\npub struct ChildStderr {\n    fd: i32,\n}\n\nimpl Drop for ChildStdin {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Drop for ChildStdout {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Drop for ChildStderr {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Write for ChildStdin {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl Read for ChildStdout {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Read for ChildStderr {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n");
    buf_str(out, c"        crate::io::sys_read(self.fd, buf)\n    }\n}\n\n// A running child, and its piped streams. Dropping it neither waits for\n// it nor ends it, as Rust's.\npub struct Child {\n    pid: i32,\n    status: Option<ExitStatus>,\n    pub stdin: Option<ChildStdin>,\n    pub stdout: Option<ChildStdout>,\n    pub stderr: Option<ChildStderr>,\n}\n\n// Waits for pid (again when a signal interrupts): its status.\nfn wait_pid(pid: i32) -> Result<i32> {\n    loop {\n        let mut st: i32 = 0;\n        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.\n        let r = unsafe { pr_c_waitpid(pid, &mut st as *mut i32, 0) };\n        if r >= 0 {\n            return crate::result::Result::Ok(st);\n        }\n        let e = Error::last_os_error();\n        if e.raw_os_error() != Option::Some(EINTR) {\n            return crate::result::Result::Err(e);\n        }\n    }\n}\n\nimpl Child {\n    // Its process id.\n    // mvs: Child::id\n    // std2: changed: a u32, as Rust's (MVS: i32)\n    #[effects()]\n    pub fn id(&self) -> u32 {\n        self.pid as u32\n    }\n\n    // Waits for it to end (its stdin closed first, as Rust's).\n    #[effects(io, static, diverge)]\n    pub fn wait(&mut self) -> Result<ExitStatus> {\n        self.stdin = Option::None;\n        if let Option::Some(s) = self.status {\n            return crate::result::Result::Ok(s);\n        }\n        let st = ExitStatus { status: wait_pid(self.pid)? };\n        self.status = Option::Some(st);\n        crate::result::Result::Ok(st)\n    }\n\n    // How it ended, when it has: None while it runs.\n    #[effects(io, static, unsafe)]\n    pub fn try_wait(&mut self) -> Result<Option<ExitStatus>> {\n        if let Option::Some(s) = self.status {\n            return crate::result::Result::Ok(Option::Some(s));\n        }\n        let mut st: i32 = 0;\n        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.\n        let r = unsafe { pr_c_waitpid(self.pid, &mut st as *mut i32, WNOHANG) };\n");
    buf_str(out, c"        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        if r == 0 {\n            return crate::result::Result::Ok(Option::None);\n        }\n        let s = ExitStatus { status: st };\n        self.status = Option::Some(s);\n        crate::result::Result::Ok(Option::Some(s))\n    }\n\n    // Sends it SIGKILL (Ok when it has been waited for already, as Rust's).\n    #[effects(io, static, unsafe)]\n    pub fn kill(&mut self) -> Result<()> {\n        if self.status.is_some() {\n            return crate::result::Result::Ok(());\n        }\n        // UNSAFE: C's kill. SAFETY: integers only.\n        if unsafe { pr_c_kill(self.pid, SIGKILL) } != 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(())\n    }\n}\n\n// ---- Command ----\n\n// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes\n// on macOS, 80 on Linux); dropping it destroys it.\nstruct SpawnActions {\n    words: [u64; 16],\n}\n\nimpl Drop for SpawnActions {\n    fn drop(&mut self) {\n        // UNSAFE: C's destroy. SAFETY: initialized by spawn_actions (the\n        // only maker), destroyed once (here).\n        let _ = unsafe { pr_c_actions_destroy(&mut self.words[0] as *mut u64) };\n    }\n}\n\nfn spawn_actions() -> Result<SpawnActions> {\n    let mut words = [0u64; 16];\n    // UNSAFE: C's init. SAFETY: words is 128 bytes, more than either\n    // system's type, 8-aligned; it holds no pointer into itself, so it\n    // may move.\n    let r = unsafe { pr_c_actions_init(&mut words[0] as *mut u64) };\n    if r != 0 {\n        return crate::result::Result::Err(Error::from_raw_os_error(r));\n    }\n    crate::result::Result::Ok(SpawnActions { words: words })\n}\n\nimpl SpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    fn dup2(&mut self, fd: i32, to: i32) -> Result<()> {\n        // UNSAFE: C adds an action. SAFETY: the actions are initialized.\n");
    buf_str(out, c"        let r = unsafe { pr_c_actions_adddup2(&mut self.words[0] as *mut u64, fd, to) };\n        if r != 0 { crate::result::Result::Err(Error::from_raw_os_error(r)) }\n        else { crate::result::Result::Ok(()) }\n    }\n}\n\n// posix_spawnattr_t, opaque: room for either system's (8 bytes on macOS,\n// 336 on Linux); dropping it destroys it.\nstruct SpawnAttr {\n    words: [u64; 48],\n}\n\nimpl Drop for SpawnAttr {\n    fn drop(&mut self) {\n        // UNSAFE: C's destroy. SAFETY: initialized by sigdefault_attr (the\n        // only maker), destroyed once (here).\n        let _ = unsafe { pr_c_attr_destroy(&mut self.words[0] as *mut u64) };\n    }\n}\n\n// Attributes under which the child starts with SIGINT's and SIGQUIT's\n// default actions, whatever this process's are.\nfn sigdefault_attr() -> Result<SpawnAttr> {\n    let mut words = [0u64; 48];\n    // sigset_t: 4 bytes on macOS, 128 on Linux\n    let mut set = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the set. SAFETY: words\n    // (384 bytes) and set (128) are larger than either system's types,\n    // 8-aligned, and hold no pointer into themselves.\n    unsafe {\n        let r = pr_c_attr_init(&mut words[0] as *mut u64);\n        if r != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r));\n        }\n        pr_c_sigemptyset(&mut set[0] as *mut u64);\n        pr_c_sigaddset(&mut set[0] as *mut u64, SIGINT);\n        pr_c_sigaddset(&mut set[0] as *mut u64, SIGQUIT);\n        let mut a = SpawnAttr { words: words };\n        let r2 = pr_c_attr_setsigdefault(&mut a.words[0] as *mut u64, &set[0] as *const u64);\n        if r2 != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r2));\n        }\n        let r3 = pr_c_attr_setflags(&mut a.words[0] as *mut u64, SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r3));\n        }\n        crate::result::Result::Ok(a)\n    }\n}\n\n");
    buf_str(out, c"// The parent's ends of a spawn's pipes (-1: none), closed on drop.\nstruct Ends {\n    fds: [i32; 7],\n}\n\nimpl Drop for Ends {\n    fn drop(&mut self) {\n        let mut i: usize = 0;\n        while i < 7 {\n            close_fd(self.fds[i]);\n            i += 1;\n        }\n    }\n}\n\nimpl Ends {\n    // fds[i], no longer this one's to close.\n    fn take(&mut self, i: usize) -> i32 {\n        let fd = self.fds[i];\n        self.fds[i] = -1;\n        fd\n    }\n}\n\n// A program to run: its arguments, the variables it does not get, its\n// streams. Each method changes it in place and returns it, as Rust's\n// (`Command::new_in(\"ls\", a).arg(\"-l\").status()?`).\npub struct Command<A: Allocator> {\n    // the program, then each argument, each NUL-ended\n    text: Vec<u8, A>,\n    argc: usize,\n    // env_remove's names, each NUL-ended\n    removed: Vec<u8, A>,\n    stdin: u8,\n    stdout: u8,\n    stderr: u8,\n    foreground: bool,\n    // an argument that held a NUL: spawn's InvalidInput\n    bad: bool,\n}\n\nimpl<A: Allocator + Clone> Command<A> {\n    // Runs program: a path, or a name looked up in PATH.\n    // mvs: Command::new\n    // std2: changed: allocator named (Rust's Command::new)\n    #[effects(A)]\n    pub fn new_in(program: &str, a: A) -> Command<A> {\n        let mut c = Command { text: Vec::new_in(a.clone()), argc: 0, removed: Vec::new_in(a),\n            stdin: DEFAULT, stdout: DEFAULT, stderr: DEFAULT, foreground: false, bad: false };\n        c.push_text(program);\n        c\n    }\n\n    fn push_text(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            if b[i] == 0 {\n                self.bad = true;\n            }\n            i += 1;\n        }\n        self.text.extend_from_slice(b);\n        self.text.push(0);\n        self.argc += 1;\n    }\n\n    // Adds an argument.\n    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>; MVS: inout)\n    #[effects(A)]\n");
    buf_str(out, c"    pub fn arg(&mut self, arg: &str) -> &mut Command<A> {\n        self.push_text(arg);\n        self\n    }\n\n    // Adds each of args.\n    // std2: changed: &mut self, AsRef<str> (Rust's: AsRef<OsStr>; MVS: a\n    // slice)\n    #[effects(A, I, S)]\n    pub fn args<I: IntoIterator<Item = S>, S: AsRef<str>>(&mut self, args: I) -> &mut Command<A> {\n        for s in args {\n            // (the path call: AsRef for &T's method call where a &str is\n            // expected is 0.27.5's front gap)\n            self.push_text(AsRef::<str>::as_ref(&s));\n        }\n        self\n    }\n\n    // The child's environment is this process's without key; each call\n    // removes one more.\n    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>)\n    #[effects(panic, A)]\n    pub fn env_remove(&mut self, key: &str) -> &mut Command<A> {\n        let b = key.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            if b[i] == 0 {\n                self.bad = true;\n            }\n            i += 1;\n        }\n        self.removed.extend_from_slice(b);\n        self.removed.push(0);\n        self\n    }\n\n    // Runs it as a shell runs a command in the foreground: while status()\n    // or output() waits for it, this process ignores SIGINT and SIGQUIT\n    // (^C and ^\\ at a terminal, which reach both), and the child starts\n    // with their default actions (`volec run`).\n    // std2: changed: vole's own (MVS's), not Rust's\n    #[effects()]\n    pub fn foreground(&mut self, on: bool) -> &mut Command<A> {\n        self.foreground = on;\n        self\n    }\n\n    #[effects()]\n    pub fn stdin(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stdin = cfg.kind;\n        self\n    }\n\n    #[effects()]\n    pub fn stdout(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stdout = cfg.kind;\n        self\n    }\n\n    #[effects()]\n    pub fn stderr(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stderr = cfg.kind;\n");
    buf_str(out, c"        self\n    }\n\n    // Starts it, its streams as set (this process's when not).\n    // std2: changed: &mut self, as Rust's (MVS: self)\n    #[effects(A)]\n    pub fn spawn(&mut self) -> Result<Child> {\n        self.spawn_with(INHERIT, INHERIT, false)\n    }\n\n    // Runs it and waits for it: how it ended.\n    // std2: changed: &mut self, as Rust's (MVS: self)\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn status(&mut self) -> Result<ExitStatus> {\n        let fg = self.foreground;\n        let mut c = self.spawn_with(INHERIT, INHERIT, fg)?;\n        let r = c.wait();\n        if fg {\n            restore_signals(c.pid);\n        }\n        r\n    }\n\n    // Runs it with stdout and stderr piped to this process and stdin\n    // /dev/null (each unless set), and waits: how it ended and what it\n    // wrote, in Vecs on clones of the Command's allocator.\n    // mvs: Command::output_in\n    // std2: changed: on the Command's allocator (Rust's output; MVS: an\n    // allocator given)\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn output(&mut self) -> Result<Output<A>> {\n        let fg = self.foreground;\n        let mut c = self.spawn_with(NULL, PIPED, fg)?;\n        let mut out: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());\n        let mut err: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());\n        c.stdin = Option::None;\n        let a = match c.stdout.take() {\n            Option::Some(s) => s.fd_take(),\n            Option::None => -1,\n        };\n        let b = match c.stderr.take() {\n            Option::Some(s) => s.fd_take(),\n            Option::None => -1,\n        };\n        let got = drain_two(a, b, &mut out, &mut err);\n        close_fd(a);\n        close_fd(b);\n        let st = c.wait();\n        if fg {\n            restore_signals(c.pid);\n        }\n        got?;\n        crate::result::Result::Ok(Output { status: st?, stdout: out, stderr: err })\n    }\n\n");
    buf_str(out, c"    // Starts it: a stream not set is dflt_in (stdin) or dflt_out (stdout\n    // and stderr).\n    fn spawn_with(&mut self, dflt_in: u8, dflt_out: u8, fg: bool) -> Result<Child> {\n        if self.bad {\n            return crate::result::Result::Err(Error::new(crate::io::ErrorKind::InvalidInput,\n                \"nul byte found in provided data\"));\n        }\n        let kinds = [\n            if self.stdin == DEFAULT { dflt_in } else { self.stdin },\n            if self.stdout == DEFAULT { dflt_out } else { self.stdout },\n            if self.stderr == DEFAULT { dflt_out } else { self.stderr },\n        ];\n        // ends.fds: [0..3) the parent's ends, [3..6) the child's, [6] /dev/null\n        let mut ends = Ends { fds: [-1; 7] };\n        let mut acts = spawn_actions()?;\n        let mut k: usize = 0;\n        while k < 3 {\n            if kinds[k] == PIPED {\n                let (r, w) = pipe()?;\n                if k == 0 {\n                    ends.fds[0] = w;\n                    ends.fds[3] = r;\n                } else {\n                    ends.fds[k] = r;\n                    ends.fds[3 + k] = w;\n                }\n                acts.dup2(ends.fds[3 + k], k as i32)?;\n            } else if kinds[k] == NULL {\n                if ends.fds[6] < 0 {\n                    // UNSAFE: C's open. SAFETY: a NUL-ended literal.\n                    let fd = unsafe { pr_c_open(b\"/dev/null\\0\".as_ptr(), O_RDWR) };\n                    if fd < 0 {\n                        return crate::result::Result::Err(Error::last_os_error());\n                    }\n                    // UNSAFE: C's fcntl. SAFETY: an int.\n                    unsafe { pr_c_fcntl(fd, F_SETFD, FD_CLOEXEC) };\n                    ends.fds[6] = fd;\n                }\n                acts.dup2(ends.fds[6], k as i32)?;\n            }\n            k += 1;\n        }\n        let attr = if fg { Option::Some(sigdefault_attr()?) } else { Option::None };\n");
    buf_str(out, c"        let a = self.text.allocator().clone();\n        // argv: a pointer to each NUL-ended string of text, then null\n        let mut argv: Vec<*const u8, A> = Vec::with_capacity_in(self.argc + 1, a.clone());\n        let base = self.text.as_ptr();\n        let mut at: usize = 0;\n        while at < self.text.len() {\n            // UNSAFE: a pointer into text. SAFETY: at < text.len(): in\n            // bounds; text is not changed while argv is used.\n            argv.push(unsafe { base.add(at) });\n            while self.text[at] != 0 {\n                at += 1;\n            }\n            at += 1;\n        }\n        argv.push(crate::ptr::null());\n        let envp = self.envp(a);\n        if fg {\n            ignore_signals();\n        }\n        let mut pid: i32 = 0;\n        let attr_p: *const u64 = match &attr {\n            Option::Some(t) => &t.words[0] as *const u64,\n            Option::None => crate::ptr::null(),\n        };\n        // UNSAFE: C's posix_spawnp.\n        // SAFETY: argv's pointers are text's NUL-ended strings, then null;\n        // envp is null (this process's environ) or environ's strings, then\n        // null; acts is initialized, attr_p null or an initialized attr;\n        // all live past the call.\n        let r = unsafe {\n            pr_c_spawnp(&mut pid as *mut i32, argv[0], &acts.words[0] as *const u64, attr_p,\n                argv.as_ptr(),\n                if envp.is_empty() { crate::__sys::environ() } else { envp.as_ptr() })\n        };\n        if r != 0 {\n            if fg {\n                restore_signals(0);\n            }\n            return crate::result::Result::Err(Error::from_raw_os_error(r));\n        }\n        let stdin = if ends.fds[0] >= 0 { Option::Some(ChildStdin { fd: ends.take(0) }) }\n            else { Option::None };\n        let stdout = if ends.fds[1] >= 0 { Option::Some(ChildStdout { fd: ends.take(1) }) }\n            else { Option::None };\n");
    buf_str(out, c"        let stderr = if ends.fds[2] >= 0 { Option::Some(ChildStderr { fd: ends.take(2) }) }\n            else { Option::None };\n        crate::result::Result::Ok(Child { pid: pid, status: Option::None, stdin: stdin,\n            stdout: stdout, stderr: stderr })\n    }\n\n    // The child's environment when env_remove named a variable: environ's\n    // strings but those, then null; empty (environ itself) when it named\n    // none.\n    fn envp(&self, a: A) -> Vec<*const u8, A> {\n        let mut out: Vec<*const u8, A> = Vec::new_in(a);\n        if self.removed.is_empty() {\n            return out;\n        }\n        let env = crate::__sys::environ();\n        let mut i: usize = 0;\n        loop {\n            // UNSAFE: environ's i-th pointer and its string.\n            // SAFETY: environ is null-ended; i stops at its null; each\n            // string is NUL-ended and is not changed while this runs\n            // (std2's set_var is unsafe for that reason).\n            let e = unsafe { *env.add(i) };\n            if e.is_null() {\n                break;\n            }\n            let mut keep = true;\n            let mut s: usize = 0;\n            while s < self.removed.len() {\n                let mut n: usize = 0;\n                while self.removed[s + n] != 0 {\n                    n += 1;\n                }\n                // UNSAFE: e's bytes, each read before its NUL.\n                // SAFETY: the loop stops at e's NUL or at the name's end.\n                let same = unsafe {\n                    let mut j: usize = 0;\n                    while j < n && *e.add(j) != 0 && *e.add(j) == self.removed[s + j] {\n                        j += 1;\n                    }\n                    j == n && *e.add(n) == 61\n                };\n                if same {\n                    keep = false;\n                }\n                s += n + 1;\n            }\n            if keep {\n                out.push(e);\n            }\n            i += 1;\n        }\n");
    buf_str(out, c"        out.push(crate::ptr::null());\n        out\n    }\n}\n\nimpl ChildStdout {\n    fn fd_take(self) -> i32 {\n        let fd = self.fd;\n        crate::mem::forget(self);\n        fd\n    }\n}\n\nimpl ChildStderr {\n    fn fd_take(self) -> i32 {\n        let fd = self.fd;\n        crate::mem::forget(self);\n        fd\n    }\n}\n\n// SIGINT's and SIGQUIT's dispositions while a foreground child runs.\nstatic mut SIG_WAS: [usize; 2] = [0, 0];\n\nfn ignore_signals() {\n    // UNSAFE: C's signal, and the static the old dispositions go in.\n    // SAFETY: SIG_IGN is a disposition, not code; SIG_WAS is written here\n    // and read by restore_signals, on the thread that runs the Command\n    // (a foreground Command is run by one thread at a time: volec run).\n    unsafe {\n        SIG_WAS[0] = pr_c_signal(SIGINT, SIG_IGN);\n        SIG_WAS[1] = pr_c_signal(SIGQUIT, SIG_IGN);\n    }\n}\n\nfn restore_signals(_pid: i32) {\n    // UNSAFE: C's signal with the dispositions ignore_signals saved.\n    // SAFETY: each is what signal returned (SIG_DFL, SIG_IGN or a handler\n    // of this process, still loaded); SIG_ERR means nothing was changed.\n    unsafe {\n        if SIG_WAS[0] != SIG_ERR {\n            pr_c_signal(SIGINT, SIG_WAS[0]);\n        }\n        if SIG_WAS[1] != SIG_ERR {\n            pr_c_signal(SIGQUIT, SIG_WAS[1]);\n        }\n    }\n}\n\n// Reads the pipes a and b (-1: none) to their ends, into va and vb (poll:\n// neither child stream blocks the other).\nfn drain_two<A: Allocator>(a: i32, b: i32, va: &mut Vec<u8, A>, vb: &mut Vec<u8, A>) -> Result<()> {\n    let mut open_a = a >= 0;\n    let mut open_b = b >= 0;\n    let mut buf = [0u8; 8192];\n    while open_a || open_b {\n        let mut fds = [\n            PollFd { fd: if open_a { a } else { -1 }, events: POLLIN, revents: 0 },\n            PollFd { fd: if open_b { b } else { -1 }, events: POLLIN, revents: 0 },\n        ];\n        // UNSAFE: C's poll. SAFETY: fds is a local array of 2 pollfds.\n");
    buf_str(out, c"        if unsafe { pr_c_poll(&mut fds[0] as *mut PollFd, 2, -1) } < 0 {\n            let e = Error::last_os_error();\n            if e.raw_os_error() == Option::Some(EINTR) {\n                continue;\n            }\n            return crate::result::Result::Err(e);\n        }\n        if open_a && fds[0].revents != 0 {\n            let n = crate::io::sys_read(a, &mut buf)?;\n            va.extend_from_slice(&buf[..n]);\n            open_a = n > 0;\n        }\n        if open_b && fds[1].revents != 0 {\n            let n = crate::io::sys_read(b, &mut buf)?;\n            vb.extend_from_slice(&buf[..n]);\n            open_b = n > 0;\n        }\n    }\n    crate::result::Result::Ok(())\n}\n\n// Ends this process with code (Rust's: no destructors run).\n#[effects(io, diverge, unsafe)]\npub fn exit(code: i32) -> ! {\n    // UNSAFE: C's exit. SAFETY: an int; it does not return.\n    unsafe { pr_c_exit(code) }\n}\n\n// Ends this process abnormally (SIGABRT).\n#[effects(io, diverge, unsafe)]\npub fn abort() -> ! {\n    // UNSAFE: C's abort. SAFETY: no arguments; it does not return.\n    unsafe { pr_c_abort() }\n}\n\n// This process's id.\n// std2: changed: a u32, as Rust's (MVS: i32)\n#[effects(io, unsafe)]\npub fn id() -> u32 {\n    // UNSAFE: C's getpid. SAFETY: no arguments.\n    unsafe { pr_c_getpid() as u32 }\n}\n// ---- end mod std::process ----\n}\n// ---- mod std::thread ----\npub mod thread {\n// EDITION: rust\n// std::thread: scoped threads, spawned threads, and the thread's own\n// queries. `thread::scope` is the safe way to share a borrow with\n// threads: every thread spawned in the scope is joined before it returns,\n// so they may borrow what outlives the scope ('env). It takes no\n// allocator: its threads' records come from C's heap, as Rust's from the\n// global one. `spawn_in(f, a)` runs a 'static closure on a thread\n// of its own, its closure and result kept on a (plan §2: MVS's spawn\n");
    buf_str(out, c"// allocated through C, unnamed). A panic in any thread ends the process\n// with 101 (decision 18), so `join` never returns an Err; it returns a\n// Result anyway, so that `.join().unwrap()` reads as in Rust.\n\nuse crate::alloc::{AllocError, Allocator, Layout};\nuse crate::cell::Cell;\nuse crate::fmt::{Debug, Formatter};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::ptr::NonNull;\n\n// UNSAFE: C's heap and POSIX threads, which take raw pointers.\n// SAFETY: the prototypes are stdlib.h's, pthread.h's, sched.h's and\n// unistd.h's (pthread_t as u64, as on macOS and Linux), as MVS's thread.\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn thread_c_malloc(n: usize) -> *mut u8;\n    #[link_name = \"free\"]\n    fn thread_c_free(p: *mut u8);\n    #[link_name = \"pthread_create\"]\n    fn thread_c_create(t: *mut u64, attr: *const u8, f: extern \"C\" fn(*mut u8) -> *mut u8,\n        arg: *mut u8) -> i32;\n    #[link_name = \"pthread_join\"]\n    fn thread_c_join(t: u64, ret: *mut u64) -> i32;\n    #[link_name = \"pthread_detach\"]\n    fn thread_c_detach(t: u64) -> i32;\n    #[link_name = \"pthread_attr_init\"]\n    #[effects()]\n    fn thread_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"pthread_attr_setstacksize\"]\n    #[effects()]\n    fn thread_c_attr_setstacksize(a: *mut u8, size: usize) -> i32;\n    #[link_name = \"pthread_attr_destroy\"]\n    #[effects()]\n    fn thread_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"sched_yield\"]\n    fn thread_c_yield() -> i32;\n    #[link_name = \"sysconf\"]\n    #[effects(io)]\n    fn thread_c_sysconf(name: i32) -> i64;\n}\n\n// Built in: the compiler lowers a std function named atomic_* to the\n// instruction, as MVS's std::sync::atomic (order: 1 Acquire, 2 Release,\n// 3 AcqRel); the bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid, aligned, shared only through\n// atomics.\n");
    buf_str(out, c"unsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\nconst ACQUIRE: i64 = 1;\nconst RELEASE: i64 = 2;\nconst ACQ_REL: i64 = 3;\n\n// _SC_NPROCESSORS_ONLN (macOS's number; 84 on Linux).\nconst SC_NPROCESSORS_ONLN: i32 = 58;\n\n// The stack of a new thread: 8 MiB (macOS's default past the first\n// thread is 512 KiB), as MVS's.\nconst THREAD_STACK: usize = 8388608;\n\n// C's heap, for a scope's records: a scope takes no allocator (Rust's\n// takes its records from the global heap the same way).\n#[derive(Clone, Copy)]\nstruct CHeap {\n    sealed: (),\n}\n\n// UNSAFE: an Allocator impl over C's heap.\n// SAFETY: blocks come from malloc (16-aligned: enough for the records of\n// words, an Option and a closure it holds) and go back to free.\nunsafe impl Allocator for CHeap {\n    fn allocate(&self, layout: Layout) -> crate::result::Result<NonNull<u8>, AllocError> {\n        if layout.align() > 16 {\n            return crate::result::Result::Err(AllocError {});\n        }\n        // UNSAFE: C's malloc.\n        // SAFETY: it takes a size and returns a block or null.\n        let p = unsafe { thread_c_malloc(layout.size()) };\n        match NonNull::new(p) {\n            Option::Some(q) => crate::result::Result::Ok(q),\n            Option::None => crate::result::Result::Err(AllocError {}),\n        }\n    }\n\n    // UNSAFE: gives a block back to C's free.\n    // SAFETY: a contract on the caller (Allocator's): p is a block this\n    // allocator gave, so malloc's.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        thread_c_free(p.as_ptr());\n    }\n}\n\n");
    buf_str(out, c"// What a thread shares with its handle: its result once done (done is\n// 1 then), and refs, the thread's and the handle's: the last of the two\n// frees it into alloc.\nstruct Out<T, A: Allocator> {\n    result: Option<T>,\n    done: u32,\n    refs: u32,\n    alloc: A,\n}\n\n// The closure, moved to the thread, and where its result goes.\nstruct Packet<F, T, A: Allocator> {\n    f: F,\n    out: *mut Out<T, A>,\n}\n\n// What the thread starts from (C's heap): run(data, this record).\nstruct Start {\n    run: fn(*mut u8, *mut u8),\n    data: *mut u8,\n}\n\n// The thread's first frame (C's convention, what pthread_create takes).\nextern \"C\" fn thread_start(arg: *mut u8) -> *mut u8 {\n    // UNSAFE: the start record through its raw pointer.\n    // SAFETY: arg is the Start start_thread wrote for this thread only;\n    // it is read here and freed by run.\n    unsafe {\n        let s = arg as *mut Start;\n        let run = (*s).run;\n        let data = (*s).data;\n        run(data, arg);\n    }\n    crate::ptr::null_mut::<u8>()\n}\n\n// A record of T's layout from a; out of memory panics.\nfn new_record<T, A: Allocator>(a: &A, x: T) -> *mut T {\n    let p = match a.allocate(Layout::new::<T>()) {\n        crate::result::Result::Ok(p) => p.as_ptr() as *mut T,\n        crate::result::Result::Err(_) => {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg)\n        }\n    };\n    // UNSAFE: x moved into the fresh block.\n    // SAFETY: p is a block of T's layout from a; the write drops nothing.\n    unsafe { crate::ptr::write(p, x) };\n    p\n}\n\n// Gives a record of T's layout back to a (its value moved out already).\n// UNSAFE: deallocates through the allocator.\n// SAFETY: a contract on the caller: p is new_record's block from a.\nunsafe fn free_record<T, A: Allocator>(a: &A, p: *mut T) {\n    match NonNull::new(p as *mut u8) {\n        Option::Some(q) => a.deallocate(q, Layout::new::<T>()),\n        Option::None => {}\n");
    buf_str(out, c"    }\n}\n\n// Drops the result (if any) and frees out into its own allocator.\n// UNSAFE: moves the record out through its raw pointer.\n// SAFETY: a contract on the caller: out is live and nobody uses it after.\nunsafe fn release_out<T, A: Allocator>(out: *mut Out<T, A>) {\n    let o = crate::ptr::read(out as *const Out<T, A>);\n    free_record(&o.alloc, out);\n    crate::mem::drop(o);\n}\n\n// The thread's work: the packet taken and freed, the closure called, its\n// result published, the thread's ref given up.\nfn thread_run<F: FnOnce() -> T, T, A: Allocator>(data: *mut u8, start: *mut u8) {\n    // UNSAFE: the packet, the start record and the result's place through\n    // raw pointers.\n    // SAFETY: data is the Packet start_thread wrote for this thread only:\n    // moved out and freed once; start is freed once into C's heap; out is\n    // live while refs > 0, and this thread holds one ref until its\n    // atomic_sub (AcqRel: the handle's side is ordered before the free).\n    unsafe {\n        let q = data as *mut Packet<F, T, A>;\n        let p = crate::ptr::read(q as *const Packet<F, T, A>);\n        let out = p.out;\n        free_record(&*(&(*out).alloc), q);\n        thread_c_free(start);\n        let r = (p.f)();\n        (*out).result = Option::Some(r);\n        atomic_store(&mut (*out).done as *mut u32, 1, RELEASE);\n        if atomic_sub(&mut (*out).refs as *mut u32, 1, ACQ_REL) == 1 {\n            release_out(out);\n        }\n    }\n}\n\n// Starts a thread running f, its records on a: its pthread_t and its\n// result's place.\nfn start_thread<F: FnOnce() -> T, T, A: Allocator>(f: F, a: A) -> (u64, *mut Out<T, A>) {\n    let out = new_record(&a, Out::<T, A> { result: Option::<T>::None, done: 0, refs: 2, alloc: a });\n    // UNSAFE: the records reached through raw pointers, and pthread_create.\n    // SAFETY: out is live (refs 2); the Packet and the Start go to the new\n    // thread only; attr is 128 bytes, more than a pthread_attr_t.\n");
    buf_str(out, c"    unsafe {\n        let q = new_record(&*(&(*out).alloc), Packet { f: f, out: out });\n        let s = thread_c_malloc(Layout::new::<Start>().size()) as *mut Start;\n        if s.is_null() {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg);\n        }\n        crate::ptr::write(s, Start { run: thread_run::<F, T, A>, data: q as *mut u8 });\n        let mut attr: [u64; 16] = [0; 16];\n        let ap = &mut attr[0] as *mut u64 as *mut u8;\n        thread_c_attr_init(ap);\n        thread_c_attr_setstacksize(ap, THREAD_STACK);\n        let mut t: u64 = 0;\n        let rc = thread_c_create(&mut t as *mut u64, ap as *const u8, thread_start, s as *mut u8);\n        thread_c_attr_destroy(ap);\n        if rc != 0 {\n            let msg: &str = \"failed to spawn thread\";\n            crate::panic::panic(msg);\n        }\n        (t, out)\n    }\n}\n\n// Waits for thread t and takes its result, freeing its place.\n// UNSAFE: pthread_join and the result's place through its raw pointer.\n// SAFETY: a contract on the caller: t is out's thread, not joined or\n// detached yet, and out is not used after.\nunsafe fn join_thread<T, A: Allocator>(t: u64, out: *mut Out<T, A>) -> T {\n    thread_c_join(t, crate::ptr::null_mut::<u64>());\n    let r = crate::mem::replace(&mut *(&mut (*out).result), Option::None);\n    release_out(out);\n    match r {\n        Option::Some(x) => x,\n        Option::None => crate::panic::unreachable(),\n    }\n}\n\n// Whether out's thread has published its result.\n// UNSAFE: an atomic read through the raw pointer.\n// SAFETY: a contract on the caller: out is live.\nunsafe fn finished<T, A: Allocator>(out: *mut Out<T, A>) -> bool {\n    atomic_load(&(*out).done as *const u32, ACQUIRE) == 1\n}\n\n// A thread of a scope, in its list: joined when the scope ends unless its\n// handle joined it.\nstruct ScopeNode {\n    native: u64,\n    joined: bool,\n    out: *mut u8,\n    join: fn(u64, *mut u8),\n");
    buf_str(out, c"    next: *mut ScopeNode,\n}\n\n// A scope node's join, erased: the thread joined and its result dropped.\n// Private, and called only by scope's end with its own node's pair.\nfn scope_join<T>(t: u64, out: *mut u8) {\n    // UNSAFE: the result's place through an erased pointer.\n    // SAFETY: the pair is one node's: out is the Out<T, CHeap> of thread\n    // t, not joined yet (the node is not marked joined).\n    crate::mem::drop(unsafe { join_thread(t, out as *mut Out<T, CHeap>) });\n}\n\n// join's result: never an Err in vole (a panic exits the process).\npub type Result<T> = crate::result::Result<T, JoinError>;\n\n// A thread's panic, as join would report it: no value is ever made.\npub struct JoinError {\n    never: crate::convert::Infallible,\n}\n\nimpl Debug for JoinError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.never {}\n    }\n}\n\n// Runs f with a Scope, joins every thread spawned in it, and returns f's\n// value. Each region in f's argument is elided, so it is late-bound (no\n// `for<'a>`, cut to 0.29): the scope's region 'scope cannot be named\n// outside f, and Scope is invariant in it, so a thread cannot borrow a\n// local of f's body (plan §4, threads).\n// std2: changed: FnOnce(&Scope<'_, 'env>) (MVS: FnMut(inout Scope))\n#[effects(alloc(CHeap), diverge, unsafe, F)]\npub fn scope<'env, F, T>(f: F) -> T\n    where\n        F: FnOnce(&Scope<'_, 'env>) -> T,\n{\n    let s = Scope {\n        first: Cell::new(crate::ptr::null_mut::<ScopeNode>()),\n        scope: PhantomData {},\n        env: PhantomData {},\n    };\n    let r = f(&s);\n    // UNSAFE: walks the scope's list through raw pointers.\n    // SAFETY: every node is one Scope::spawn made for s and freed here\n    // only, once; a node its handle joined is skipped.\n    unsafe {\n        let mut n = s.first.get();\n        while !n.is_null() {\n            let next = (*n).next;\n            if !(*n).joined {\n");
    buf_str(out, c"                ((*n).join)((*n).native, (*n).out);\n            }\n            free_record(&CHeap { sealed: () }, n);\n            n = next;\n        }\n    }\n    r\n}\n\n// The scope threads are spawned in. 'scope is the scope's own region\n// ('env outlives it); invariant in both, as Rust's.\n// std2: changed: two regions, invariant\npub struct Scope<'scope, 'env: 'scope> {\n    first: Cell<*mut ScopeNode>,\n    scope: PhantomData<&'scope mut &'scope ()>,\n    env: PhantomData<&'env mut &'env ()>,\n}\n\nimpl<'scope, 'env> Scope<'scope, 'env> {\n    // Runs f on a new thread, joined at the latest when the scope ends;\n    // f may borrow anything that outlives 'scope. `&self`, not Rust's\n    // `&'scope self`: scope's argument elides its two regions separately,\n    // so the reference may be shorter than 'scope; the bound F: 'scope,\n    // with Scope invariant in 'scope, is what keeps f's borrows alive.\n    // std2: changed: &self, FnOnce, Send, a 'scope bound (MVS: inout self, FnMut)\n    // later: auto_trait\n    #[effects(alloc(CHeap), panic, diverge, F, T)]\n    pub fn spawn<F, T>(&self, f: F) -> ScopedJoinHandle<'scope, T>\n        where\n            F: FnOnce() -> T + Send + 'scope,\n            T: Send + 'scope,\n    {\n        let (t, out) = start_thread(f, CHeap { sealed: () });\n        let node = new_record(&CHeap { sealed: () }, ScopeNode {\n            native: t,\n            joined: false,\n            out: out as *mut u8,\n            join: scope_join::<T>,\n            next: self.first.get(),\n        });\n        self.first.set(node);\n        ScopedJoinHandle { native: t, out: out, node: node, scope: PhantomData {} }\n    }\n}\n\n// A scoped thread: join waits for its value.\n// std2: changed: a region 'scope\npub struct ScopedJoinHandle<'scope, T> {\n    native: u64,\n    out: *mut Out<T, CHeap>,\n    node: *mut ScopeNode,\n    scope: PhantomData<&'scope ()>,\n}\n\n// UNSAFE: the handle reaches its result and its scope node through raw\n");
    buf_str(out, c"// pointers: stated, as Rust's (Send and Sync for every T).\n// SAFETY: as JoinHandle's; Scope::spawn asks T: Send, and the scope's node\n// is written only by join, which takes the handle.\nunsafe impl<'scope, T> Send for ScopedJoinHandle<'scope, T> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&ScopedJoinHandle` only reads the done flag, atomically.\nunsafe impl<'scope, T> Sync for ScopedJoinHandle<'scope, T> {}\n\nimpl<'scope, T> ScopedJoinHandle<'scope, T> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(unsafe, T)]\n    pub fn join(self) -> Result<T> {\n        // UNSAFE: the scope's node and the thread's result through raw\n        // pointers.\n        // SAFETY: the node lives until the scope ends, which 'scope\n        // outlives; marked joined, the scope's end skips the thread, so it\n        // is joined once.\n        unsafe {\n            (*self.node).joined = true;\n            crate::result::Result::Ok(join_thread(self.native, self.out))\n        }\n    }\n\n    // Whether the thread has finished (join would not wait).\n    #[effects(unsafe, T)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: out lives until the thread is joined, by this handle's\n        // join (which takes it) or the scope's end ('scope outlives self).\n        unsafe { finished(self.out) }\n    }\n}\n\n// Runs f on a new thread of its own; its closure and its result live on\n// a until join (or the handle's drop, which detaches it).\n// mvs: spawn\n// std2: changed: an allocator, FnOnce, Send and 'static (MVS: spawn(f), through C)\n// later: auto_trait\n#[effects(F, T, A)]\npub fn spawn_in<F, T, A>(f: F, a: A) -> JoinHandle<T, A>\n    where\n        F: FnOnce() -> T + Send + 'static,\n        T: Send + 'static,\n        A: Allocator + Send + 'static,\n{\n    let (t, out) = start_thread(f, a);\n    JoinHandle { native: t, out: out }\n}\n\n");
    buf_str(out, c"// A spawned thread.\n// std2: changed: an allocator parameter\npub struct JoinHandle<T, A: Allocator> {\n    native: u64,\n    out: *mut Out<T, A>,\n}\n\n// UNSAFE: the handle reaches the thread's result through a raw pointer:\n// stated, as Rust's (Send and Sync for every T).\n// SAFETY: the result's place is shared with the thread by its refs count,\n// atomically (AcqRel), and read only by join, which takes the handle;\n// spawn_in asks T: Send and A: Send.\nunsafe impl<T, A: Allocator> Send for JoinHandle<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&JoinHandle` only reads the done flag, atomically (is_finished).\nunsafe impl<T, A: Allocator> Sync for JoinHandle<T, A> {}\n\nimpl<T, A: Allocator> JoinHandle<T, A> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(alloc(A, extern), io, static, sync, panic, diverge, unsafe, T, A)]\n    pub fn join(self) -> Result<T> {\n        let t = self.native;\n        let out = self.out;\n        crate::mem::forget(self);\n        // UNSAFE: pthread_join and the result's place.\n        // SAFETY: the handle held a ref, so out is live; it is forgotten, so\n        // its drop does not detach or free; the thread is joined once.\n        crate::result::Result::Ok(unsafe { join_thread(t, out) })\n    }\n\n    #[effects(unsafe, T, A)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: the handle holds a ref, so out is live.\n        unsafe { finished(self.out) }\n    }\n}\n\n// Detaches the thread: it runs on, its result dropped when it ends.\nimpl<T, A: Allocator> crate::ops::Drop for JoinHandle<T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: pthread_detach and the result's place.\n        // SAFETY: out is live (the handle's ref); the last of the thread and\n        // the handle (refs, AcqRel) frees it, once.\n        unsafe {\n            thread_c_detach(self.native);\n");
    buf_str(out, c"            if atomic_sub(&mut (*self.out).refs as *mut u32, 1, ACQ_REL) == 1 {\n                release_out(self.out);\n            }\n        }\n    }\n}\n\n// Lets the OS run another thread.\n#[effects(sync, unsafe)]\npub fn yield_now() {\n    // UNSAFE: C's sched_yield.\n    // SAFETY: it takes nothing.\n    unsafe { thread_c_yield() };\n}\n\n// How many threads can run at once (the CPUs online); 1 when unknown.\n// (Rust's returns io::Result<NonZero<usize>>; vole's, a usize.)\n// std2: changed: usize\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\npub fn available_parallelism() -> usize {\n    // UNSAFE: C's sysconf.\n    // SAFETY: it takes an int.\n    let n = unsafe { thread_c_sysconf(SC_NPROCESSORS_ONLN) };\n    if n < 1 { 1 } else { n as usize }\n}\n\n// UNSAFE: C's nanosleep. SAFETY: time.h's prototype (struct timespec, two\n// 64-bit fields on the 64-bit targets, an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"nanosleep\"]\n    #[effects(io)]\n    fn thread_c_nanosleep(req: *const i64, rem: *mut i64) -> i32;\n}\n\n// Sleeps for d at least: sleeps again for the rest when a signal wakes it.\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\npub fn sleep(d: crate::time::Duration) {\n    let max_secs = 9223372036854775807u64;\n    let secs = d.as_secs();\n    let mut req = [if secs > max_secs { max_secs as i64 } else { secs as i64 },\n        d.subsec_nanos() as i64];\n    // (each round sleeps or ends, a signal per round at most: counted)\n    for _ in 0..1000000 {\n        let mut rem = [0i64; 2];\n        // UNSAFE: C's nanosleep.\n        // SAFETY: req and rem are timespecs (two i64s), rem writable; req's\n        // nanoseconds are under a second (a Duration's).\n        let r = unsafe { thread_c_nanosleep(&req[0] as *const i64, &mut rem[0] as *mut i64) };\n        if r == 0 || rem[0] == 0 && rem[1] == 0 {\n            return;\n        }\n        req = rem;\n    }\n}\n\n// ---- Thread-local