    buf_str(out, c"    &///,,,,&&,,////,&&&/&&&&&&&&&&&\\\n    0,,,,,,,,,,00000000,,,,,,/7,,,,&\\\n    &&&&&&&1&&&&&&&&0,,,,,,//,,,0000\\\n    0000......,,,,,,,,,,,,,/,1&&&&&&\\\n    &&&&&&&&&&0&&&&&,/,,,/,/&&&&&&&&\\\n    &&&&&&&&&&&&&&&/,,,,,,,&,,,,,,/,\\\n    &&,,,,,,,,,,,,,,,,,,,,,,&/,,,,,,\\\n    ,/,,/,,&&&&&&&&&&,,,,,,&&&,&,,&,\\\n    ,,,,,,.,&&&&&&&&&&&&&&&&&&/////&\\\n    ,,&//,/,&&&&&&&&,0&&&&&&&&&&&&&&\\\n    &&&,,//&&&&&&&&&,,./000000000000\\\n    0&000000000000000000//,,,,,&&&//\\\n    ,,1&&&&&&&&&&&&&&&&&&&&&&&,&&&&&\\\n    \\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43\\x43,&&&&&&,,,,,,,,,\\\n    ,,,,,,&&&&&&&&&&,,,,,,,,,,///,,,\\\n    &&&\\x44&&&\\x44\\x44\\x44\\x44&&&&&&///////////////\\\n    ////////////////////////&&&&&&&,\\\n    ,,,&&&&&&&&&&&&&<<<<,&&&&&&&&&&&\\\n    ,,<<<<<&&&&&&&&&<<<<<<<<<<<&&&&&\\\n    &&&&&&&&&&&&&&&<<<<&&&&&&&&&&&&&\\\n    <<&&&&&&&&&&&&&&<<<<&<<<<<<<&<<&\\\n    <<<<<<<<<&&&&&&&&&<&&&&&&&&&&&&&\\\n    <<<&&<&&&&&&&&&&&&&&<<<<<&&&&&&&\\\n    <<<<<<<<<<<<&&&&&&&&&&&&&&&&&,,&\\\n    ****&&&&&&&&&&&&,,,,,,,,,,,,,,&&\\\n    &&&&&&&,,&&&&&&&&&&&&,,,,,&&&,,,\\\n    ,,,********,,,,,,,,&&,,,,,,,&&&&\\\n    &&&&&&&&&&,,,,&&,,,&&&&&&&&,,&&,\\\n    ,,,,,,,&&&&,,,,,&&&&&,&&&&&&&&&&\\\n    &&&&,&&&&&&&&&&&,,,,,,,&,,,,,,,,\\\n    ,,,,,,,,,&&,,,,,,,&,,&,,,,,&&&&&\\\n    &&&&&&&&&&&&,,,,&&&,&&,&&&&&&&,,\\\n    &&&&,,,,,,,&&&&&&&&&;&&&&&&&&&&&\\\n    &&&&&&&&&&&&\\x45\\x45\\x45\\x45&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&&&&&&&\\x45\\x45&&&&&&&&&&&&&&&\\\n    \\x45&&&&&&&&&&&&&&;&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    (((((((((((((&&&((((((((((((((&&\\\n    ++((((((((((((++((((((((((((((;(\\\n    (;;;;;;;;;;((((((((((((((((((&<\\x45\\\n    \\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\\n");
    buf_str(out, c"    \\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46\\x46<;?\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    <<<<<<<<<<;<<<<<<<<<<<<<<<<<<<<;\\\n    <<;;;;;?;;;<\\x45\\x45\\x45\\x45<<<<<<<<<\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    ;;\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45<<<<<<\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    ;;;;;;;;;;;;;;;;;)&&)))))))));;;\\\n    ;;;;;;);;;;;;;;;;;;;;;;;;;;;;);;\\\n    ;;;;&&))&)))&&));;;;;;;;;;;))));\\\n    ;;;;))))))))))));&&);)&);;;\\x47\\x47\\x47\\x47\\x47\\\n    ;;;;;;;;;;;;;;;););;;;;;;;;;;;;;\\\n    ;;;;;;;;;;;;;)&;;;;;;;;;;;;;;;&&\\\n    &&&&&&&&&));;;;&;;;;;;;;&&&&&&&)\\\n    )&&)))))));&&&&&&&&&&&&)&&))))&&\\\n    )&&&&;;&&&&&&&&&&&&&;)&&)&&&&&&&\\\n    &))&&&&&&&&&)&&&&&)))&&&&&&&&&&&\\\n    &)))&&&&&&&&)))&&)&)&&&&)&&&&&&)\\\n    &&&)&&&&&&);;;;;;;;;;;&&&&&);)))\\\n    ;;;&&;;;;;\\x45\\x45;;;;))))))&&&)&;;\\x45\\x45\\x45\\\n    )&&);;;;;;;;;\\x45\\x45\\x45&&&&&&&&&&<&\\x45\\x45\\x45\\x45\\\n    ;;;;;;;;;;;;\\x45\\x45\\x45\\x45;&&&&&&&&&&&&&&&\\\n    &&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&&&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&&&&&&\\x45\\x45&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&&&&&&&&&&&;;;;\\\n    ;;;;;;;;;;;&;;;;;;;;;;&;;;;;;;;;\\\n    ;;;;;;;;;;;;;\\x45\\x45\\x45;;;;;;;\\x45;\\x45\\x45\\x45;;;;\\\n    ;;;;;;;;;;;;;;\\x45;;;;;;;;;;;;;\\x45\\x45\\x45;\\\n    ;;;;;;;;;;;\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&\\\n    <<<<<<<<<<<<<<&&\";\n// ---- end mod std::unicode ----\n}\n// ---- mod std::io ----\npub mod io {\n// std::io: Read, Write and BufRead, the buffered types, the standard\n// streams, Error. Rust's shape: counts are usize, `read_line` is\n// Stdin's (and BufRead's) and returns the bytes read (0 at the end), and\n");
    buf_str(out, c"// what reads into a growing buffer takes the buffer (`read_to_end(&mut\n// v)`, which grows from v's allocator) or an allocator (`lines_in(a)`,\n// `read_to_string_in(r, a)`). The buffered types hold a fixed buffer\n// inline, so making one allocates nothing. Seek and SeekFrom are here, as\n// Rust's; the file types are std::fs's.\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// io's Result: an io::Error on failure.\n// mvs: Result\npub type Result<T> = crate::result::Result<T, Error>;\n\n// What failed: a kind, and the OS's error number when it came from one.\n// mvs: Error, IoError\n// std2: changed: Rust's io::Error (MVS's root IoError is gone into it)\npub struct Error {\n    kind: ErrorKind,\n    code: i32,\n    msg: &'static str,\n}\n\nimpl Error {\n    // An error of kind k, with a message (Rust's takes any error; vole's a\n    // static text: no allocation, no dyn).\n    // std2: changed: a message, &'static str\n    #[effects()]\n    pub fn new(k: ErrorKind, msg: &'static str) -> Error {\n        Error { kind: k, code: 0, msg: msg }\n    }\n\n    // An error of kind Other, with a message.\n    #[effects()]\n    pub fn other(msg: &'static str) -> Error {\n        Error::new(ErrorKind::Other, msg)\n    }\n\n    // The error errno says.\n    #[effects()]\n    pub fn from_raw_os_error(code: i32) -> Error {\n        Error { kind: kind_of_errno(code), code: code, msg: \"\" }\n    }\n\n    // The error of the last failed OS call (errno).\n    #[effects(static, unsafe)]\n    pub fn last_os_error() -> Error {\n        // UNSAFE: errno, read through libc's pointer to this thread's copy.\n        // SAFETY: __error returns a valid pointer to the calling thread's\n        // errno, an i32.\n        let code = unsafe { *__error() };\n        Error::from_raw_os_error(code)\n    }\n");
    buf_str(out, c"\n    #[effects()]\n    pub fn kind(&self) -> ErrorKind {\n        self.kind\n    }\n\n    #[effects()]\n    pub fn raw_os_error(&self) -> Option<i32> {\n        if self.code == 0 { Option::None } else { Option::Some(self.code) }\n    }\n}\n\n// mvs: Error::impl Display, IoError::impl Display\nimpl Display for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.write_str(os_message(self.code))?;\n            f.write_str(\" (os error \")?;\n            f.write_fmt(self.code)?;\n            f.write_str(\")\")\n        } else if !self.msg.is_empty() {\n            f.write_str(self.msg)\n        } else {\n            crate::fmt::Display::fmt(&self.kind, f)\n        }\n    }\n}\n\n// mvs: Error::impl Debug, IoError::impl Debug\nimpl Debug for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.debug_struct(\"Os\")\n                .field(\"code\", &self.code)\n                .field(\"kind\", &self.kind)\n                .field(\"message\", &os_message(self.code))\n                .finish()\n        } else if !self.msg.is_empty() {\n            f.debug_struct(\"Custom\").field(\"kind\", &self.kind).field(\"error\", &self.msg).finish()\n        } else {\n            f.debug_tuple(\"Kind\").field(&self.kind).finish()\n        }\n    }\n}\n\nimpl From<ErrorKind> for Error {\n    fn from(k: ErrorKind) -> Error {\n        Error::new(k, \"\")\n    }\n}\n\n// The ErrorKind of an errno (macOS's numbers; Linux's differ above 34 and\n// come with the sys tail).\nfn kind_of_errno(code: i32) -> ErrorKind {\n    match code {\n        1 | 13 => ErrorKind::PermissionDenied,\n        2 => ErrorKind::NotFound,\n        4 => ErrorKind::Interrupted,\n        12 => ErrorKind::OutOfMemory,\n        17 => ErrorKind::AlreadyExists,\n        20 => ErrorKind::NotADirectory,\n        21 => ErrorKind::IsADirectory,\n        22 => ErrorKind::InvalidInput,\n");
    buf_str(out, c"        32 => ErrorKind::BrokenPipe,\n        35 => ErrorKind::WouldBlock,\n        45 | 78 => ErrorKind::Unsupported,\n        60 => ErrorKind::TimedOut,\n        63 => ErrorKind::InvalidFilename,\n        66 => ErrorKind::DirectoryNotEmpty,\n        _ => ErrorKind::Other,\n    }\n}\n\n// The OS's text for an errno (C's strerror), or \"\" when it is not UTF-8.\nfn os_message(code: i32) -> &'static str {\n    // UNSAFE: strerror's C string, read through its raw pointer.\n    // SAFETY: strerror returns a NUL-terminated string that lives as long\n    // as the process (macOS's table; the bytes up to the NUL are read, no\n    // further).\n    unsafe {\n        let p = strerror(code);\n        let mut n: usize = 0;\n        while *p.add(n) != 0 {\n            n += 1;\n        }\n        match crate::str::from_utf8(crate::slice::from_raw_parts(p, n)) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n}\n\n// What a read appended to v from start: kept when it is UTF-8, cut off\n// with InvalidData when not (read_to_string's and read_line's check).\nfn append_utf8<A: Allocator>(v: &mut Vec<u8, A>, start: usize, r: Result<usize>) -> Result<usize> {\n    if crate::str::from_utf8(&v.as_slice()[start..]).is_err() {\n        v.truncate(start);\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidData,\n            \"stream did not contain valid UTF-8\"));\n    }\n    r\n}\n\n// Write::write_fmt's sink: a fmt::Write over an io::Write that keeps the\n// io::Error a write gave (fmt::Error carries nothing).\nstruct Adapter<'a, W: ?Sized> {\n    inner: &'a mut W,\n    error: Result<()>,\n}\n\nimpl<'a, W: Write + ?Sized> crate::fmt::Write for Adapter<'a, W> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        match self.inner.write_all(s.as_bytes()) {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(e) => {\n");
    buf_str(out, c"                self.error = crate::result::Result::Err(e);\n                crate::result::Result::Err(crate::fmt::Error {})\n            }\n        }\n    }\n}\n\n// UNSAFE: the OS's calls under the standard streams and io::Error.\n// SAFETY: read and write take a buffer of n bytes they may read or fill;\n// __error returns this thread's errno; strerror a static C string. The\n// callers below pass slices' pointers and lengths.\nextern \"C\" {\n    #[link_name = \"read\"]\n    fn c_read(fd: i32, buf: *mut u8, n: usize) -> isize;\n    #[link_name = \"write\"]\n    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;\n    fn __error() -> *mut i32;\n    fn strerror(code: i32) -> *const u8;\n}\n\n// Up to buf.len() bytes from fd.\n#[effects(io, static, unsafe)]\npub(crate) fn sys_read(fd: i32, buf: &mut [u8]) -> Result<usize> {\n    // UNSAFE: the OS's read.\n    // SAFETY: buf's pointer and length are a writable region of buf.len()\n    // bytes, borrowed for the call.\n    let n = unsafe { c_read(fd, buf.as_mut_ptr(), buf.len()) };\n    if n < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(n as usize)\n    }\n}\n\n// Some of buf to fd.\n#[effects(io, static, unsafe)]\npub(crate) fn sys_write(fd: i32, buf: &[u8]) -> Result<usize> {\n    // UNSAFE: the OS's write.\n    // SAFETY: buf's pointer and length are a readable region of buf.len()\n    // bytes, borrowed for the call.\n    let n = unsafe { c_write(fd, buf.as_ptr(), buf.len()) };\n    if n < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(n as usize)\n    }\n}\n\n// All of buf to fd, a standard stream's (Stdout's and Stderr's write_all:\n// Write's default, on the descriptor).\n// terminates: every pass writes at least one byte of buf or returns, but\n// for a write a signal interrupted, which is made again; signals are the\n// OS's, and no program is sent them without end.\n");
    buf_str(out, c"#[terminates]\nfn fd_write_all(fd: i32, buf: &[u8]) -> Result<()> {\n    let mut buf = buf;\n    while !buf.is_empty() {\n        match sys_write(fd, buf) {\n            crate::result::Result::Ok(0) => {\n                return crate::result::Result::Err(Error::new(ErrorKind::WriteZero,\n                    \"failed to write whole buffer\"));\n            }\n            crate::result::Result::Ok(n) => buf = &buf[n..],\n            crate::result::Result::Err(e) => {\n                if e.kind() != ErrorKind::Interrupted {\n                    return crate::result::Result::Err(e);\n                }\n            }\n        }\n    }\n    crate::result::Result::Ok(())\n}\n\n// What kind of failure, as Rust's (the ones vole's OS calls give).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum ErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    InvalidFilename,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\nimpl Display for ErrorKind {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(match *self {\n            ErrorKind::NotFound => \"entity not found\",\n            ErrorKind::PermissionDenied => \"permission denied\",\n            ErrorKind::AlreadyExists => \"entity already exists\",\n            ErrorKind::WouldBlock => \"operation would block\",\n            ErrorKind::InvalidInput => \"invalid input parameter\",\n            ErrorKind::InvalidData => \"invalid data\",\n            ErrorKind::TimedOut => \"timed out\",\n            ErrorKind::WriteZero => \"write zero\",\n            ErrorKind::Interrupted => \"operation interrupted\",\n            ErrorKind::UnexpectedEof => \"unexpected end of file\",\n            ErrorKind::BrokenPipe => \"broken pipe\",\n");
    buf_str(out, c"            ErrorKind::NotADirectory => \"not a directory\",\n            ErrorKind::IsADirectory => \"is a directory\",\n            ErrorKind::DirectoryNotEmpty => \"directory not empty\",\n            ErrorKind::InvalidFilename => \"invalid filename\",\n            ErrorKind::Unsupported => \"unsupported\",\n            ErrorKind::OutOfMemory => \"out of memory\",\n            ErrorKind::Other => \"other error\",\n        })\n    }\n}\n\n// Where Seek::seek moves to: an offset from the start, the end or the\n// position now.\n// std2: changed: std::io's, as Rust's (MVS: std::fs's); Start is a u64\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum SeekFrom {\n    Start(u64),\n    End(i64),\n    Current(i64),\n}\n\n// A stream with a position that can move (a File).\npub trait Seek {\n    // Moves the position; the new one, from the start.\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64>;\n\n    // Back to the start.\n    fn rewind(&mut self) -> Result<()> {\n        self.seek(SeekFrom::Start(0))?;\n        crate::result::Result::Ok(())\n    }\n\n    // The position, from the start.\n    fn stream_position(&mut self) -> Result<u64> {\n        self.seek(SeekFrom::Current(0))\n    }\n}\n\n// A source of bytes.\npub trait Read {\n    // Up to buf.len() bytes into buf; how many (0 at the end).\n    // std2: changed: &mut [u8], a usize\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize>;\n\n    // Exactly buf.len() bytes, or UnexpectedEof.\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        let mut buf = buf;\n        while !buf.is_empty() {\n            match self.read(buf) {\n                crate::result::Result::Ok(0) => {\n                    return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                        \"failed to fill whole buffer\"));\n                }\n                crate::result::Result::Ok(n) => {\n                    let rest = buf;\n                    buf = &mut rest[n..];\n");
    buf_str(out, c"                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(())\n    }\n\n    // Everything left, appended to buf (grown from buf's allocator).\n    // std2: changed: a usize\n    fn read_to_end<A: Allocator>(&mut self, buf: &mut Vec<u8, A>) -> Result<usize> {\n        let start = buf.len();\n        let mut chunk = [0u8; 4096];\n        loop {\n            match self.read(&mut chunk) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(n) => buf.extend_from_slice(&chunk[..n]),\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(buf.len() - start)\n    }\n\n    // Everything left, appended to buf; InvalidData when it is not UTF-8.\n    // std2: changed: a usize\n    fn read_to_string<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8, so the String is UTF-8 whenever it is used.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let r = self.read_to_end(v);\n        append_utf8(v, start, r)\n    }\n\n    // The reader borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A sink of bytes.\npub trait Write {\n    // Some of buf; how much was written.\n    // std2: changed: &[u8], a usize\n");
    buf_str(out, c"    fn write(&mut self, buf: &[u8]) -> Result<usize>;\n\n    // Whatever is buffered, out to its destination.\n    fn flush(&mut self) -> Result<()>;\n\n    // All of buf (write until it is written, or an error).\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        let mut buf = buf;\n        while !buf.is_empty() {\n            match self.write(buf) {\n                crate::result::Result::Ok(0) => {\n                    return crate::result::Result::Err(Error::new(ErrorKind::WriteZero,\n                        \"failed to write whole buffer\"));\n                }\n                crate::result::Result::Ok(n) => buf = &buf[n..],\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(())\n    }\n\n    // x as its Display shows it (the compiler's `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result<()> {\n        let mut out = Adapter { inner: self, error: crate::result::Result::Ok(()) };\n        let r = {\n            let mut f = Formatter::new(&mut out);\n            crate::fmt::Display::fmt(&x, &mut f)\n        };\n        match r {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(_) => match out.error {\n                crate::result::Result::Err(e) => crate::result::Result::Err(e),\n                crate::result::Result::Ok(()) => {\n                    crate::result::Result::Err(Error::new(ErrorKind::Other, \"formatter error\"))\n                }\n            },\n        }\n    }\n\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A reader with a buffer: lines and delimited reads.\npub trait BufRead: Read {\n");
    buf_str(out, c"    // The buffered bytes, refilled when empty (empty at the end).\n    // std2: changed: returns &[u8]\n    fn fill_buf(&mut self) -> Result<&[u8]>;\n\n    // Marks n buffered bytes as read.\n    // std2: changed: n is usize\n    fn consume(&mut self, n: usize);\n\n    // The bytes up to and including delim (or the end), appended to buf.\n    // mvs: BufReader::read_until\n    fn read_until<A: Allocator>(&mut self, delim: u8, buf: &mut Vec<u8, A>) -> Result<usize> {\n        let mut read: usize = 0;\n        loop {\n            let (done, used) = {\n                let available = match self.fill_buf() {\n                    crate::result::Result::Ok(b) => b,\n                    crate::result::Result::Err(e) => {\n                        if e.kind() == ErrorKind::Interrupted {\n                            continue;\n                        }\n                        return crate::result::Result::Err(e);\n                    }\n                };\n                // (0.29: the delimiter found by the bytes' block search)\n                let i = match available.find_byte(delim) {\n                    crate::option::Option::Some(i) => i,\n                    crate::option::Option::None => available.len(),\n                };\n                if i < available.len() {\n                    buf.extend_from_slice(&available[..i + 1]);\n                    (true, i + 1)\n                } else {\n                    buf.extend_from_slice(available);\n                    (false, available.len())\n                }\n            };\n            self.consume(used);\n            read += used;\n            if done || used == 0 {\n                return crate::result::Result::Ok(read);\n            }\n        }\n    }\n\n    // A line, its \"\\n\" included, appended to buf; 0 at the end.\n    // mvs: BufReader::read_line, read_line\n    // std2: changed: BufRead's, a usize (MVS: a free function's bool, BufReader's i64)\n");
    buf_str(out, c"    fn read_line<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let r = self.read_until(10, v);\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a, without its \"\\n\".\n    // mvs: BufReader::lines_in\n    fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<Self, A>\n        where\n            Self: Sized,\n    {\n        Lines { buf: self, alloc: a }\n    }\n}\n\n// BufRead::lines_in's iterator: each line a String<A>, or an error.\n// mvs: Lines\npub struct Lines<B, A: Allocator> {\n    buf: B,\n    alloc: A,\n}\n\n// mvs: Lines::impl Iterator\nimpl<B: BufRead, A: Allocator + Clone> Iterator for Lines<B, A> {\n    type Item = Result<String<A>>;\n\n    fn next(&mut self) -> Option<Result<String<A>>> {\n        let mut s = String::new_in(self.alloc.clone());\n        match self.buf.read_line(&mut s) {\n            crate::result::Result::Ok(0) => Option::None,\n            crate::result::Result::Ok(_) => {\n                let nl: &str = \"\\n\";\n                let cr: &str = \"\\r\";\n                if s.ends_with(nl) {\n                    s.pop();\n                    if s.ends_with(cr) {\n                        s.pop();\n                    }\n                }\n                Option::Some(crate::result::Result::Ok(s))\n            }\n            crate::result::Result::Err(e) => Option::Some(crate::result::Result::Err(e)),\n        }\n    }\n}\n\n// A Read with a buffer of its own (8 KiB, inline: no allocation).\npub struct BufReader<R> {\n    inner: R,\n    buf: [u8; 8192],\n    pos: usize,\n    filled: usize,\n}\n\nimpl<R: Read> BufReader<R> {\n    #[effects()]\n    pub fn new(inner: R) -> BufReader<R> {\n");
    buf_str(out, c"        BufReader { inner: inner, buf: [0; 8192], pos: 0, filled: 0 }\n    }\n}\n\nimpl<R> BufReader<R> {\n    #[effects()]\n    pub fn get_ref(&self) -> &R {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut R {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not read yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[self.pos..self.filled]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The reader, the buffered bytes dropped.\n    #[effects()]\n    pub fn into_inner(self) -> R {\n        self.inner\n    }\n}\n\nimpl<R: Read> Read for BufReader<R> {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        // A read as large as the buffer, with nothing buffered, skips it.\n        if self.pos == self.filled && buf.len() >= 8192 {\n            return self.inner.read(buf);\n        }\n        let n = {\n            let rem = self.fill_buf()?;\n            let n = crate::cmp::min(rem.len(), buf.len());\n            buf[..n].copy_from_slice(&rem[..n]);\n            n\n        };\n        self.consume(n);\n        crate::result::Result::Ok(n)\n    }\n}\n\nimpl<R: Read> BufRead for BufReader<R> {\n    fn fill_buf(&mut self) -> Result<&[u8]> {\n        if self.pos >= self.filled {\n            let n = self.inner.read(&mut self.buf)?;\n            self.filled = n;\n            self.pos = 0;\n        }\n        crate::result::Result::Ok(&self.buf[self.pos..self.filled])\n    }\n\n    fn consume(&mut self, n: usize) {\n        self.pos = crate::cmp::min(self.pos + n, self.filled);\n    }\n}\n\n// A Write with a buffer of its own (8 KiB, inline), flushed when full,\n// on flush and when dropped.\npub struct BufWriter<W: Write> {\n    inner: W,\n    buf: [u8; 8192],\n    len: usize,\n}\n\nimpl<W: Write> BufWriter<W> {\n    #[effects()]\n    pub fn new(inner: W) -> BufWriter<W> {\n");
    buf_str(out, c"        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n    }\n\n    #[effects()]\n    pub fn get_ref(&self) -> &W {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut W {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not written yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The writer, after a flush; the error and the BufWriter if it failed.\n    // std2: changed: a Result (Rust's)\n    #[effects(unsafe, W)]\n    pub fn into_inner(self) -> crate::result::Result<W, IntoInnerError<BufWriter<W>>> {\n        let mut me = self;\n        match me.flush_buf() {\n            crate::result::Result::Err(e) => {\n                crate::result::Result::Err(IntoInnerError { writer: me, error: e })\n            }\n            crate::result::Result::Ok(()) => {\n                // UNSAFE: the writer is moved out of a type with a Drop,\n                // which is then forgotten (Rust's into_inner does the same).\n                // SAFETY: me is forgotten right after, so its inner is not\n                // dropped twice, and its buffer is empty (flushed): its drop\n                // would only flush nothing.\n                let inner = unsafe { crate::ptr::read(&me.inner) };\n                crate::mem::forget(me);\n                crate::result::Result::Ok(inner)\n            }\n        }\n    }\n}\n\nimpl<W: Write> BufWriter<W> {\n    // The buffer written out to the inner writer, then emptied.\n    fn flush_buf(&mut self) -> Result<()> {\n        let n = self.len;\n        self.inner.write_all(&self.buf[..n])?;\n        self.len = 0;\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl<W: Write> Write for BufWriter<W> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        if self.len + buf.len() > 8192 {\n            self.flush_buf()?;\n        }\n");
    buf_str(out, c"        if buf.len() >= 8192 {\n            return self.inner.write(buf);\n        }\n        let n = buf.len();\n        self.buf[self.len..self.len + n].copy_from_slice(buf);\n        self.len += n;\n        crate::result::Result::Ok(n)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        self.flush_buf()?;\n        self.inner.flush()\n    }\n}\n\nimpl<W: Write> crate::ops::Drop for BufWriter<W> {\n    fn drop(&mut self) {\n        let _ = self.flush();\n    }\n}\n\n// `BufWriter { writer: .., buffer: 3/8192 }`, as Rust's.\nimpl<W: Write + Debug> Debug for BufWriter<W> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"BufWriter\")\n            .field(\"writer\", &self.inner)\n            .field(\"buffer\", &Filled { len: self.len, cap: 8192 })\n            .finish()\n    }\n}\n\n// A buffer's fill as `len/cap`.\nstruct Filled {\n    len: usize,\n    cap: usize,\n}\n\nimpl Debug for Filled {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.len, f)?;\n        f.write_str(\"/\")?;\n        Debug::fmt(&self.cap, f)\n    }\n}\n\n// BufWriter::into_inner's error: the flush's error and the writer.\n#[derive(Debug)]\npub struct IntoInnerError<W> {\n    writer: W,\n    error: Error,\n}\n\nimpl<W> IntoInnerError<W> {\n    #[effects()]\n    pub fn error(&self) -> &Error {\n        &self.error\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> W {\n        self.writer\n    }\n}\n\n// The process's standard input (fd 0), buffered.\npub struct Stdin {\n    fd: i32,\n}\n\n// The process's stdin.\n#[effects()]\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\nimpl Stdin {\n    // A line, its \"\\n\" included, appended to buf; 0 at the end of input.\n    // mvs: read_line\n    // std2: changed: Stdin's, returns the bytes read (MVS: a free function, a bool)\n    #[effects(io, static, diverge, unsafe, A)]\n");
    buf_str(out, c"    pub fn read_line<A: Allocator>(&self, buf: &mut String<A>) -> Result<usize> {\n        // A byte at a time up to \"\\n\": Stdin keeps no buffer, so nothing\n        // after the line is taken from fd 0.\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let mut b = [0u8; 1];\n        let mut r: Result<usize> = crate::result::Result::Ok(0);\n        loop {\n            match sys_read(self.fd, &mut b) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(_) => {\n                    v.push(b[0]);\n                    if b[0] == 10 {\n                        break;\n                    }\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        r = crate::result::Result::Err(e);\n                        break;\n                    }\n                }\n            }\n        }\n        // (annotated: an arm's Ok gives no E, FL1)\n        let r: Result<usize> = match r {\n            crate::result::Result::Ok(_) => crate::result::Result::Ok(v.len() - start),\n            crate::result::Result::Err(e) => crate::result::Result::Err(e),\n        };\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a.\n    #[effects(A)]\n    pub fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<BufReader<Stdin>, A> {\n        BufReader::new(self).lines_in(a)\n    }\n}\n\nimpl Read for Stdin {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        sys_read(self.fd, buf)\n    }\n}\n\n// The process's standard output (fd 1): line-buffered on a terminal,\n// block-buffered otherwise, flushed at exit.\npub struct Stdout {\n    fd: i32,\n}\n\n#[effects()]\npub fn stdout() -> Stdout {\n");
    buf_str(out, c"    Stdout { fd: 1 }\n}\n\nimpl Write for Stdout {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        // Written through (no buffer yet: the sys tail's line buffering\n        // comes with the embedded std, 0.27.2's M3).\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        fd_write_all(self.fd, buf)\n    }\n}\n\n// The process's standard error (fd 2), unbuffered.\npub struct Stderr {\n    fd: i32,\n}\n\n#[effects()]\npub fn stderr() -> Stderr {\n    Stderr { fd: 2 }\n}\n\nimpl Write for Stderr {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        fd_write_all(self.fd, buf)\n    }\n}\n\n// Everything r has left, as a String on a (Rust's io::read_to_string).\n// mvs: read_stdin_in\n// std2: changed: any reader, a String (MVS: stdin's bytes as a Vec)\n#[effects(R, A)]\npub fn read_to_string_in<R: Read, A: Allocator>(r: R, a: A) -> Result<String<A>> {\n    let mut r = r;\n    let mut s = String::new_in(a);\n    r.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// Everything from r, written to w; how many bytes.\n#[effects(panic, diverge, R, W)]\npub fn copy<R: Read + ?Sized, W: Write + ?Sized>(r: &mut R, w: &mut W) -> Result<u64> {\n    let mut buf = [0u8; 8192];\n    let mut total: u64 = 0;\n    loop {\n        let n = match r.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n");
    buf_str(out, c"        };\n        w.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// A reader with nothing in it.\n#[effects()]\npub fn empty() -> Empty {\n    Empty {}\n}\n\npub struct Empty {}\n\nimpl Read for Empty {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::result::Result::Ok(0)\n    }\n}\n\n// A writer that drops what it is given.\n#[effects()]\npub fn sink() -> Sink {\n    Sink {}\n}\n\npub struct Sink {}\n\nimpl Write for Sink {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A &mut of a reader or writer is one.\nimpl<R: Read + ?Sized> Read for &mut R {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        (**self).read(buf)\n    }\n}\n\nimpl<W: Write + ?Sized> Write for &mut W {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        (**self).write(buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        (**self).flush()\n    }\n}\n\n// Bytes in memory as a reader (`Read for &[u8]`).\nimpl Read for &[u8] {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        let n = crate::cmp::min(buf.len(), self.len());\n        let (a, b) = self.split_at(n);\n        buf[..n].copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(n)\n    }\n\n    // All of buf, or UnexpectedEof with buf untouched and the slice used up\n    // (Rust's).\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        if buf.len() > self.len() {\n            *self = &self[self.len()..];\n            return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                \"failed to fill whole buffer\"));\n        }\n        let (a, b) = self.split_at(buf.len());\n        buf.copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(())\n    }\n}\n\n");
    buf_str(out, c"// A Vec<u8, A> as a writer: write grows it from A.\nimpl<A: Allocator> Write for Vec<u8, A> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        self.extend_from_slice(buf);\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n// ---- end mod std::io ----\n}\n// ---- mod std::fs ----\npub mod fs {\n// std::fs: files and directories, Rust's. A path is a `P: AsRef<str>`\n// (Rust's `AsRef<Path>`: a &str, a &String, a std::path::Path or a\n// &PathBuf; 0.28.0, std::path's named divergence); it reaches C as a NUL-ended copy on the stack, so nothing here allocates\n// but what returns a Vec or a String, on the allocator given. A path that\n// holds a NUL is InvalidInput, one longer than the system's PATH_MAX the\n// OS's ENAMETOOLONG (Rust passes it to the OS, which says the same).\n// mvs: std::fs\n\nuse crate::alloc::Allocator;\nuse crate::convert::AsRef;\nuse crate::io::{Error, ErrorKind, Read, Result, Seek, SeekFrom, Write};\nuse crate::iter::Iterator;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::time::SystemTime;\nuse crate::vec::Vec;\n\n// UNSAFE: the OS's file and directory calls, which take NUL-ended paths\n// and buffers as raw pointers.\n// SAFETY: POSIX's prototypes (fcntl.h, unistd.h, sys/stat.h, dirent.h,\n// stdio.h); open's mode is variadic, as declared. The callers pass a\n// CPath's buffer (NUL-ended), a StatBuf's words (larger than either\n// system's struct stat) and a DIR * that opendir returned.\nextern \"C\" {\n    #[link_name = \"open\"]\n    fn fs_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn fs_c_close(fd: i32) -> i32;\n    #[link_name = \"lseek\"]\n    fn fs_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn fs_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n");
