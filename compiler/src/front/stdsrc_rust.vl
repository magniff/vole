    buf_str(out, c"    pub fn is_control(self) -> bool {\n        // general category Cc\n        let c = self as u32;\n        c < 0x20 || (c >= 0x7F && c <= 0x9F)\n    }\n\n    #[effects()]\n    pub fn is_ascii(&self) -> bool {\n        (*self as u32) < 0x80\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphabetic(&self) -> bool {\n        self.is_ascii_uppercase() || self.is_ascii_lowercase()\n    }\n\n    #[effects()]\n    pub fn is_ascii_uppercase(&self) -> bool {\n        *self >= 'A' && *self <= 'Z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_lowercase(&self) -> bool {\n        *self >= 'a' && *self <= 'z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_digit(&self) -> bool {\n        *self >= '0' && *self <= '9'\n    }\n\n    #[effects()]\n    pub fn is_ascii_hexdigit(&self) -> bool {\n        self.is_ascii_digit() || (*self >= 'a' && *self <= 'f') || (*self >= 'A' && *self <= 'F')\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphanumeric(&self) -> bool {\n        self.is_ascii_alphabetic() || self.is_ascii_digit()\n    }\n\n    #[effects()]\n    pub fn is_ascii_whitespace(&self) -> bool {\n        *self == ' ' || *self == '\\t' || *self == '\\n' || *self == '\\r' || *self == '\\x0C'\n    }\n\n    #[effects()]\n    pub fn is_ascii_punctuation(&self) -> bool {\n        (*self >= '!' && *self <= '/') || (*self >= ':' && *self <= '@')\n            || (*self >= '[' && *self <= '`') || (*self >= '{' && *self <= '~')\n    }\n\n    #[effects()]\n    pub fn to_ascii_uppercase(&self) -> char {\n        if self.is_ascii_lowercase() { ((*self as u8) - 32) as char } else { *self }\n    }\n\n    #[effects()]\n    pub fn to_ascii_lowercase(&self) -> char {\n        if self.is_ascii_uppercase() { ((*self as u8) + 32) as char } else { *self }\n    }\n\n    #[effects()]\n    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {\n        self.to_ascii_lowercase() == other.to_ascii_lowercase()\n    }\n\n    // Its upper case: one char or more ('ß' gives \"SS\").\