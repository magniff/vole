    buf_str(out, c"    let len: usize = if m[1] == 0 { 1 } else if m[2] == 0 { 2 } else { 3 };\n    ([from_u32_unchecked(m[0]), from_u32_unchecked(m[1]), from_u32_unchecked(m[2])], len)\n}\n\n// The combining marks and the format chars: no column of their own.\nfn is_zero_width(c: u32) -> bool {\n    (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5BD)\n        || (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F)\n        || (c >= 0x900 && c <= 0x902) || c == 0x93C || (c >= 0x941 && c <= 0x948) || c == 0x94D\n        || (c >= 0x1AB0 && c <= 0x1AFF) || (c >= 0x1DC0 && c <= 0x1DFF)\n        || (c >= 0x200B && c <= 0x200F) || (c >= 0x202A && c <= 0x202E)\n        || (c >= 0x2060 && c <= 0x2064) || (c >= 0x20D0 && c <= 0x20FF)\n        || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || c == 0xFEFF\n        || (c >= 0xE0000 && c <= 0xE0FFF)\n}\n\n// East Asian Wide and Fullwidth, and the emoji blocks.\nfn is_wide(c: u32) -> bool {\n    (c >= 0x1100 && c <= 0x115F) || (c >= 0x231A && c <= 0x231B) || (c >= 0x2E80 && c <= 0x303E)\n        || (c >= 0x3041 && c <= 0x33FF) || (c >= 0x3400 && c <= 0x4DBF)\n        || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xA000 && c <= 0xA4CF)\n        || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF)\n        || (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFF60)\n        || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F)\n        || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD)\n}\n// ---- end mod std::char ----\n}\n// ---- mod std::num ----\npub mod num {\n// std2: new: Rust's integer methods' home (std::num).\n\n// The integers' inherent methods (front-rust.md F15.4): `x.wrapping_add(y)`,\n// `x.checked_mul(y)` (an Option), `x.overflowing_sub(y)` (the wrapped\n// value and whether it overflowed), `x.saturating_sub(y)`, the bit counts\n// and the rotations, for i8 .. usize, with no `use`. The compiler makes\n");
    buf_str(out, c"// `impl i8 { .. }` .. `impl usize { .. }` from its list (front/builtin_impls)\n// as this module's items, at the attribute below; this module's\n// arithmetic never checks overflow, whatever --overflow-checks says\n// (front/modules: std_wraps), so `self + rhs` in them is Rust's\n// wrapping_add. `/` and `%` by zero panic here too, as Rust's\n// wrapping_div does.\npub mod wrapping {\n    // The high 64 bits of the 128-bit product a * b (vole has no u128):\n    // four 32-bit products, none of which overflows. The overflowing_mul\n    // of the 64-bit integers reads it.\n    #[builtin_methods(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\n    #[effects()]\n    pub fn mul_hi(a: u64, b: u64) -> u64 {\n        let m: u64 = 0xffffffff;\n        let (a0, a1) = (a & m, a >> 32);\n        let (b0, b1) = (b & m, b >> 32);\n        let p00 = a0 * b0;\n        let p01 = a0 * b1;\n        let p10 = a1 * b0;\n        let p11 = a1 * b1;\n        let mid = (p00 >> 32) + (p01 & m) + (p10 & m);\n        p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n    }\n}\n// ---- end mod std::num ----\n}\n// ---- mod std::string ----\npub mod string {\n// EDITION: rust\n// std::string: String<A>, owned UTF-8 text on A's heap, and ToStringIn.\n// `String::new_in(a)`, `String::from_in(\"x\", a)`, `\"x\".to_string_in(a)`;\n// no `String::from(s)` and no `From<&str>` (it would allocate with no\n// allocator in the call: plan §2). A String has str's methods through\n// Deref; its own are the ones that change it, and they allocate from its\n// A only. MVS's Buf<A> (a byte buffer) is gone: a Vec<u8, A>, or a String.\n// `write(&mut s, \"{x}\")` (fmt::Write) is MVS's `s.push_fmt(\"{x}\")`.\n\nuse crate::alloc::{Allocator, TryReserveError};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::default::DefaultIn;\nuse crate::fmt::{Debug, Display, Formatter, Write};\n");
    buf_str(out, c"use crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::ops::{Add, AddAssign, Bound, Deref, DerefMut, Index, IndexMut, RangeBounds};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::slice::SliceIndex;\nuse crate::str::{Chars, Utf8Error};\nuse crate::vec::Vec;\n\n// UTF-8 text that owns its bytes, on A.\npub struct String<A: Allocator> {\n    vec: Vec<u8, A>,\n}\n\nimpl<A: Allocator> String<A> {\n    // An empty String on a; it allocates at its first push.\n    #[effects(A)]\n    pub fn new_in(a: A) -> String<A> {\n        String { vec: Vec::new_in(a) }\n    }\n\n    #[effects(A)]\n    pub fn with_capacity_in(cap: usize, a: A) -> String<A> {\n        String { vec: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A copy of s on a.\n    // std2: changed: takes &str\n    #[effects(A)]\n    pub fn from_in(s: &str, a: A) -> String<A> {\n        let mut out = String::with_capacity_in(s.len(), a);\n        out.push_str(s);\n        out\n    }\n\n    // v as a String when it is UTF-8; the error gives v back.\n    // std2: changed: the error is FromUtf8Error<A>, which holds v (MVS: Utf8Error)\n    #[effects(panic, diverge, A)]\n    pub fn from_utf8(v: Vec<u8, A>) -> Result<String<A>, FromUtf8Error<A>> {\n        match crate::str::from_utf8(v.as_slice()) {\n            Result::Ok(_) => Result::Ok(String { vec: v }),\n            Result::Err(e) => Result::Err(FromUtf8Error { bytes: v, error: e }),\n        }\n    }\n\n    #[effects(unsafe)]\n    // UNSAFE: bytes that are not UTF-8 make a String whose str methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: Vec<u8, A>) -> String<A> {\n        String { vec: v }\n    }\n\n    // v as text on a, each bad sequence U+FFFD (Rust's from_utf8_lossy,\n    // which returns a Cow).\n    // std2: changed: takes &[u8]\n    #[effects(panic, diverge, unsafe, A)]\n");
    buf_str(out, c"    pub fn from_utf8_lossy_in(v: &[u8], a: A) -> String<A> {\n        let mut out = String::with_capacity_in(v.len(), a);\n        let mut rest = v;\n        loop {\n            match crate::str::from_utf8(rest) {\n                Result::Ok(s) => {\n                    out.push_str(s);\n                    return out;\n                }\n                Result::Err(e) => {\n                    let good = e.valid_up_to();\n                    // UNSAFE: from_utf8 checked these bytes already; the\n                    // checked conversion would check them again.\n                    // SAFETY: valid_up_to says the first good bytes of rest\n                    // are UTF-8.\n                    out.push_str(unsafe { crate::str::from_utf8_unchecked(&rest[..good]) });\n                    out.push_str(\"\\u{FFFD}\");\n                    let bad = match e.error_len() {\n                        Option::Some(n) => n,\n                        Option::None => rest.len() - good,\n                    };\n                    rest = &rest[good + bad..];\n                }\n            }\n        }\n    }\n\n    // Its length in bytes.\n    #[effects(A)]\n    pub fn len(&self) -> usize {\n        self.vec.len()\n    }\n\n    #[effects(A)]\n    pub fn is_empty(&self) -> bool {\n        self.vec.is_empty()\n    }\n\n    #[effects(A)]\n    pub fn capacity(&self) -> usize {\n        self.vec.capacity()\n    }\n\n    // std2: changed: returns &A (MVS: a copy of A)\n    #[effects(A)]\n    pub fn allocator(&self) -> &A {\n        self.vec.allocator()\n    }\n\n    #[effects(A)]\n    pub fn reserve(&mut self, extra: usize) {\n        self.vec.reserve(extra)\n    }\n\n    #[effects(A)]\n    pub fn reserve_exact(&mut self, extra: usize) {\n        self.vec.reserve_exact(extra)\n    }\n\n    #[effects(A)]\n    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {\n        self.vec.try_reserve(extra)\n    }\n\n    #[effects(A)]\n    pub fn shrink_to