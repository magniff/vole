    buf_str(out, c"            self.live = false;\n        }\n    }\n}\n\n// Runs prog (a path, or a name looked up in PATH) with argv (C strings\n// ending with a null pointer; argv[0] is the program's name) and envp\n// (likewise; empty: this process's environment), after the file actions\n// (null: none): the child's pid. EINVAL when argv or a non-empty envp does\n// not end with a null pointer.\n// Unsafe: prog and every pointer before argv's and envp's null must be\n// NUL-ended strings.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: posix_spawnp reads the program's name, arguments and environment\n// through raw pointers.\n// SAFETY: (the caller's obligation) prog and every pointer before argv's\n// and envp's nulls are NUL-ended strings, and actions is null or points to\n// a SysSpawnActions; the nulls that end argv and envp are checked here.\npub unsafe fn sys_spawn(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions) -> Result<i32, i32> {\n    sys_spawn_attr(prog, argv, envp, actions, 0 as *const SysSpawnAttr)\n}\n\n// (0.25.5) sys_spawn with spawn attributes (null: none).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: as sys_spawn.\n// SAFETY: (the caller's obligation) as sys_spawn's, and attr is null or\n// points to a SysSpawnAttr.\npub unsafe fn sys_spawn_attr(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions, attr: *const SysSpawnAttr) -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() > 0 && !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    let env = if envp.len() == 0 { sys_environ() } else { envp.as_ptr() };\n    let acts = if actions.is_null() || !(*actions).live {\n        0 as *const u8\n    } else {\n        (*actions).words.as_ptr() as *const u8\n    };\n    let at = if attr.is_null() || !(*attr).live {\n");
    buf_str(out, c"        0 as *const u8\n    } else {\n        (*attr).words.as_ptr() as *const u8\n    };\n    let mut pid = 0i32;\n    let r = sys_c_posix_spawnp(&mut pid, prog, acts, at, argv.as_ptr(), env);\n    if r != 0 {\n        return Err(r);\n    }\n    Ok(pid)\n}\n\n// (0.25.5) posix_spawnattr_t, opaque: room for either system's (8 bytes on\n// macOS, 336 on Linux). Dropping it frees it, so it moves and is never\n// copied, as SysSpawnActions.\npub struct SysSpawnAttr {\n    words: [u64; 48],\n    live: bool,\n}\n\nimpl Drop for SysSpawnAttr {\n    fn drop(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the attributes through a raw pointer.\n            // SAFETY: live (checked): initialized by sys_spawn_sigdefault,\n            // destroyed once, live cleared right after.\n            unsafe { sys_c_attr_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SYS_SPAWN_SETSIGDEF: i16 = 4;\n\n// (0.25.5) Spawn attributes under which the child starts with the default\n// action of each of sigs, whatever this process's are (a signal it\n// ignores, the child does not).\n#[effects(io, panic, diverge, unsafe)]\npub fn sys_spawn_sigdefault(sigs: &[i32]) -> Result<SysSpawnAttr, i32> {\n    let mut a = SysSpawnAttr { words: [0u64; 48], live: false };\n    // sigset_t: 4 bytes on macOS, 128 on Linux\n    let mut set: [u64; 16] = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the signal set through raw\n    // pointers. SAFETY: a.words (384 bytes) and set (128) are larger than\n    // either system's posix_spawnattr_t and sigset_t, 8-aligned; the\n    // attributes hold no pointer into themselves, so moving them is fine.\n    unsafe {\n        let r = sys_c_attr_init(a.words.as_mut_ptr() as *mut u8);\n        if r != 0 {\n            return Err(r);\n        }\n        a.live = true;\n");
    buf_str(out, c"        sys_c_sigemptyset(set.as_mut_ptr() as *mut u8);\n        for &sig in sigs {\n            sys_c_sigaddset(set.as_mut_ptr() as *mut u8, sig);\n        }\n        let r2 = sys_c_attr_setsigdefault(a.words.as_mut_ptr() as *mut u8,\n            set.as_mut_ptr() as *mut u8);\n        if r2 != 0 {\n            return Err(r2);\n        }\n        let r3 = sys_c_attr_setflags(a.words.as_mut_ptr() as *mut u8, SYS_SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return Err(r3);\n        }\n    }\n    Ok(a)\n}\n\n// (0.25.5) A signal's disposition before sys_signal_ignore changed it: only\n// sys_signal_ignore makes one, so sys_signal_restore sets back what C gave.\n#[derive(Clone, Copy)]\npub struct SysSignalWas {\n    sig: i32,\n    handler: *const u8,\n}\n\n// This process ignores sig (SIG_IGN) from now on: what it did before.\n#[effects(io, unsafe)]\npub fn sys_signal_ignore(sig: i32) -> SysSignalWas {\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: SIG_IGN (1 on macOS and Linux) is a disposition, not code; sig\n    // is an int (an invalid one gives SIG_ERR, restored as nothing below).\n    let was = unsafe { sys_c_signal(sig, 1 as *mut u8) };\n    SysSignalWas { sig: sig, handler: was }\n}\n\n// The disposition sys_signal_ignore replaced, set back.\n#[effects(io, unsafe)]\npub fn sys_signal_restore(was: SysSignalWas) {\n    // (SIG_ERR, -1: signal failed, nothing was changed)\n    if was.handler as i64 == -1 {\n        return;\n    }\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: was.handler is what signal returned for was.sig (SysSignalWas\n    // is sealed: only sys_signal_ignore makes one): SIG_DFL, SIG_IGN, or a\n    // handler of this process, still loaded.\n    unsafe { sys_c_signal(was.sig, was.handler); }\n}\n\n// Waits for the child pid (-1: any child) to end, or with nohang only\n// looks: (its pid, its status; sys_exit_code and sys_exit_signal read it),\n");
    buf_str(out, c"// or (0, 0) when nohang and it is still running.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_waitpid(pid: i32, nohang: bool) -> Result<(i32, i32), i32> {\n    let mut status = 0i32;\n    // UNSAFE: C's waitpid writes the status through a raw pointer.\n    // SAFETY: status is a local i32.\n    let r = unsafe { sys_c_waitpid(pid, &mut status, if nohang { SYS_WNOHANG } else { 0 }) };\n    if r == -1 {\n        return Err(sys_errno());\n    }\n    Ok((r, status))\n}\n\n// The exit code of a wait status, when the process exited.\n#[effects()]\npub fn sys_exit_code(status: i32) -> Option<i32> {\n    if (status & 0x7f) == 0 { Some((status >> 8) & 0xff) } else { None }\n}\n\n// The signal that ended the process, when one did.\n#[effects()]\npub fn sys_exit_signal(status: i32) -> Option<i32> {\n    let s = status & 0x7f;\n    if s != 0 && s != 0x7f { Some(s) } else { None }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_kill(pid: i32, sig: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (kill).\n    // SAFETY: kill takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_kill(pid, sig) })\n}\n\n#[effects(io, unsafe)]\npub fn sys_getpid() -> i32 {\n    // UNSAFE: a C library call (getpid).\n    // SAFETY: getpid takes nothing and touches no memory of ours.\n    unsafe { sys_c_getpid() }\n}\n\n// ---- Sys: terminals (0.20) ----\n\n// UNSAFE: the C library's terminal and process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, sys/ioctl.h, termios.h,\n// unistd.h, poll.h); ioctl is variadic in C and declared so; a struct\n// termios is kept in SysTermios' words, larger than either system's.\nextern \"C\" {\n    #[link_name = \"posix_openpt\"]\n    #[effects(io)]\n    fn sys_c_posix_openpt(flags: i32) -> i32;\n    #[link_name = \"grantpt\"]\n    #[effects(io)]\n    fn sys_c_grantpt(fd: i32) -> i32;\n    #[link_name = \"unlockpt\"]\n");
    buf_str(out, c"    #[effects(io)]\n    fn sys_c_unlockpt(fd: i32) -> i32;\n    #[link_name = \"ptsname_r\"]\n    #[effects(io)]\n    fn sys_c_ptsname_r(fd: i32, buf: *mut u8, n: u64) -> i32;\n    #[link_name = \"ioctl\"]\n    #[effects(io)]\n    fn sys_c_ioctl(fd: i32, req: u64, ...) -> i32;\n    #[link_name = \"tcgetattr\"]\n    #[effects(io)]\n    fn sys_c_tcgetattr(fd: i32, t: *mut u8) -> i32;\n    #[link_name = \"tcsetattr\"]\n    #[effects(io)]\n    fn sys_c_tcsetattr(fd: i32, when: i32, t: *const u8) -> i32;\n    #[link_name = \"cfmakeraw\"]\n    #[effects()]\n    fn sys_c_cfmakeraw(t: *mut u8);\n    #[link_name = \"fork\"]\n    #[effects(io)]\n    fn sys_c_fork() -> i32;\n    #[link_name = \"setsid\"]\n    #[effects(io)]\n    fn sys_c_setsid() -> i32;\n    #[link_name = \"execve\"]\n    #[effects(io)]\n    fn sys_c_execve(path: *const u8, argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"_exit\"]\n    #[effects(io, diverge)]\n    fn sys_c_exit_now(code: i32) -> !;\n    #[link_name = \"poll\"]\n    #[effects(io)]\n    fn sys_c_poll(fds: *mut SysPollFd, n: u64, timeout: i32) -> i32;\n}\n\n// A terminal's size (struct winsize, the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysWinsize {\n    pub ws_row: u16,\n    pub ws_col: u16,\n    pub ws_xpixel: u16,\n    pub ws_ypixel: u16,\n}\n\n// struct termios, opaque: room for either system's (72 bytes on macOS, 60\n// on Linux); sys_make_raw is the one change std makes to it.\n#[derive(Clone, Copy)] pub struct SysTermios {\n    words: [u64; 16],\n}\n\n// struct pollfd (the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysPollFd {\n    pub fd: i32,\n    pub events: i16,\n    pub revents: i16,\n}\n\npub const SYS_POLLIN: i16 = 1;\npub const SYS_POLLPRI: i16 = 2;\npub const SYS_POLLOUT: i16 = 4;\npub const SYS_POLLERR: i16 = 8;\npub const SYS_POLLHUP: i16 = 16;\npub const SYS_POLLNVAL: i16 = 32;\n\n");
    buf_str(out, c"// A new pseudo-terminal of the given size: (its controller, the terminal),\n// both close-on-exec. The controller is the program's end (what it reads\n// is the child's output); the terminal becomes the child's stdin, stdout\n// and stderr (sys_fork_exec_pty), and the caller closes its copy then.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_openpty(size: SysWinsize) -> Result<(i32, i32), i32> {\n    // UNSAFE: a C library call (posix_openpt).\n    // SAFETY: posix_openpt takes an int and touches no memory of ours.\n    let m = sys_check(unsafe { sys_c_posix_openpt(SYS_O_RDWR | SYS_O_NOCTTY) } as i64)? as i32;\n    match sys_openpty_side(m, size) {\n        Ok(s) => Ok((m, s)),\n        Err(e) => {\n            // UNSAFE: a C library call (close).\n            // SAFETY: close takes an int: the controller opened above.\n            unsafe { sys_c_close(m); }\n            Err(e)\n        }\n    }\n}\n\nfn sys_openpty_side(m: i32, size: SysWinsize) -> Result<i32, i32> {\n    sys_set_cloexec(m, true)?;\n    // UNSAFE: a C library call (grantpt).\n    // SAFETY: grantpt takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_grantpt(m) })?;\n    // UNSAFE: a C library call (unlockpt).\n    // SAFETY: unlockpt takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_unlockpt(m) })?;\n    // (0.25.4) ptsname_r, not ptsname: ptsname keeps the path in one\n    // buffer for every thread.\n    let mut nb = [0u8; 1024];\n    // UNSAFE: C's ptsname_r writes the terminal's path through a raw\n    // pointer.\n    // SAFETY: nb is a local of 1024 bytes and ptsname_r is given 1023, so\n    // the path and its NUL stay in nb and nb[1023] stays 0.\n    let r = unsafe { sys_c_ptsname_r(m, nb.as_mut_ptr() as *mut u8, 1023) };\n    let mut n: i64 = 0;\n    while r == 0 && nb[n as usize] != 0 {\n        n += 1;\n    }\n    if n == 0 {\n        return Err(sys_errno());\n    }\n");
    buf_str(out, c"    let s = sys_open(&nb[0..n as usize], SYS_O_RDWR | SYS_O_NOCTTY, 0)?;\n    match sys_set_winsize(m, size) {\n        Ok(()) => Ok(s),\n        Err(e) => {\n            // UNSAFE: a C library call (close).\n            // SAFETY: close takes an int: the terminal opened above.\n            unsafe { sys_c_close(s); }\n            Err(e)\n        }\n    }\n}\n\n// Starts path (a full path: no PATH lookup) with argv and envp (C strings\n// ending with a null pointer, built before the call) in a new session\n// whose controlling terminal is tty, the terminal end of sys_openpty, as\n// its stdin, stdout and stderr: the child's pid. Between fork and execve\n// the child calls only async-signal-safe functions (setsid, ioctl, dup2,\n// close, execve, _exit) and allocates nothing; when execve fails it exits\n// with 127.\n// Unsafe: path and every pointer before argv's and envp's nulls must be\n// NUL-ended strings.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: fork and execve, given raw pointers to the program's path,\n// arguments and environment.\n// SAFETY: (the caller's obligation) path and every pointer before argv's\n// and envp's nulls are NUL-ended strings (the nulls are checked here);\n// between fork and execve the child calls only async-signal-safe\n// functions, on integers and those pointers, and allocates nothing.\npub unsafe fn sys_fork_exec_pty(tty: i32, path: *const u8, argv: &[*const u8], envp: &[*const u8])\n    -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() == 0 || !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    let av = argv.as_ptr();\n    let ev = envp.as_ptr();\n    let pid = sys_c_fork();\n    if pid == -1 {\n        return Err(sys_errno());\n    }\n    if pid == 0 {\n        // The child.\n        sys_c_setsid();\n        sys_c_ioctl(tty, SYS_TIOCSCTTY, 0);\n        sys_c_dup2(tty, 0);\n");
    buf_str(out, c"        sys_c_dup2(tty, 1);\n        sys_c_dup2(tty, 2);\n        if tty > 2 {\n            sys_c_close(tty);\n        }\n        sys_c_execve(path, av, ev);\n        sys_c_exit_now(127);\n    }\n    Ok(pid)\n}\n\n// Sets the size of the terminal fd (TIOCSWINSZ; on a controller, the\n// child gets SIGWINCH).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_winsize(fd: i32, size: SysWinsize) -> Result<(), i32> {\n    let ws = size;\n    // UNSAFE: C's ioctl (variadic) reads a struct winsize through a raw\n    // pointer.\n    // SAFETY: ws is a local SysWinsize, C's struct winsize (#[repr(C)]).\n    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCSWINSZ, &raw const ws as *mut u8) })\n}\n\n// The size of the terminal fd (TIOCGWINSZ).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_get_winsize(fd: i32) -> Result<SysWinsize, i32> {\n    let mut ws = SysWinsize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 };\n    // UNSAFE: C's ioctl (variadic) writes a struct winsize through a raw\n    // pointer.\n    // SAFETY: ws is a local SysWinsize, C's struct winsize (#[repr(C)]).\n    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCGWINSZ, &raw mut ws as *mut u8) })?;\n    Ok(ws)\n}\n\n// The terminal fd's settings.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_tcgetattr(fd: i32) -> Result<SysTermios, i32> {\n    let mut t = SysTermios { words: [0u64; 16] };\n    // UNSAFE: C's tcgetattr writes a struct termios through a raw pointer.\n    // SAFETY: t.words is a local of 128 bytes, more than either system's\n    // struct termios (72 on macOS, 60 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_tcgetattr(fd, t.words.as_mut_ptr() as *mut u8) })?;\n    Ok(t)\n}\n\n// Sets the terminal fd's settings, now (TCSANOW).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_tcsetattr(fd: i32, t: SysTermios) -> Result<(), i32> {\n");
    buf_str(out, c"    // UNSAFE: C's tcsetattr reads a struct termios through a raw pointer.\n    // SAFETY: t.words, 128 bytes, holds the struct termios tcgetattr wrote\n    // (perhaps changed by sys_make_raw); tcsetattr only reads it.\n    sys_check_unit(unsafe { sys_c_tcsetattr(fd, 0, t.words.as_mut_ptr() as *mut u8) })\n}\n\n// Raw mode (cfmakeraw): no echo, no line editing, no signals from keys, no\n// output processing, 8-bit characters.\n#[effects(unsafe)]\npub fn sys_make_raw(t: &mut SysTermios) {\n    // UNSAFE: C's cfmakeraw changes a struct termios through a raw pointer.\n    // SAFETY: t is the caller's &mut SysTermios: its 128 bytes of words\n    // hold the struct termios, more than either system's.\n    unsafe { sys_c_cfmakeraw(t.words.as_mut_ptr() as *mut u8); }\n}\n\n// Waits until one of fds is ready or timeout_ms passes (-1: no limit):\n// how many have revents set. (0.25.4) fds is &mut: poll writes their\n// revents.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_poll(fds: &mut [SysPollFd], timeout_ms: i32) -> Result<i64, i32> {\n    // UNSAFE: C's poll reads and writes the pollfds through a raw pointer.\n    // SAFETY: fds is the caller's &mut slice of SysPollFd (C's struct\n    // pollfd, #[repr(C)]): poll touches fds.len() of them at fds.as_ptr().\n    sys_check(unsafe { sys_c_poll(fds.as_mut_ptr(), fds.len() as u64, timeout_ms) } as i64)\n}\n\n// ---- Sys: clocks and entropy (0.20) ----\n\n// UNSAFE: the C library's clock and entropy calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's and the systems' (time.h; getentropy:\n// unistd.h on Linux, sys/random.h on macOS); a struct timespec is\n// SysTimespec, #[repr(C)].\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    #[effects(io)]\n    fn sys_c_clock_gettime(clock: i32, ts: *mut SysTimespec) -> i32;\n    #[link_name = \"nanosleep\"]\n    #[effects(io)]\n    fn sys_c_nanosleep(req: *const SysTimespec, rem: *mut SysTimespec) -> i32;\n");
    buf_str(out, c"    #[link_name = \"getentropy\"]\n    #[effects(io)]\n    fn sys_c_getentropy(buf: *mut u8, n: u64) -> i32;\n}\n\n// struct timespec (the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysTimespec {\n    pub tv_sec: i64,\n    pub tv_nsec: i64,\n}\n\npub const SYS_CLOCK_REALTIME: i32 = 0;\n\n// The time of clock (SYS_CLOCK_REALTIME, SYS_CLOCK_MONOTONIC): (seconds,\n// nanoseconds).\n#[effects(io, unsafe)]\npub fn sys_clock_gettime(clock: i32) -> (i64, i64) {\n    let mut ts = SysTimespec { tv_sec: 0, tv_nsec: 0 };\n    // UNSAFE: C's clock_gettime writes a struct timespec through a raw\n    // pointer.\n    // SAFETY: ts is a local SysTimespec; it fails only for a clock the\n    // system does not have, which reads as 0.\n    unsafe { sys_c_clock_gettime(clock, &mut ts); }\n    (ts.tv_sec, ts.tv_nsec)\n}\n\n// Sleeps for secs seconds and nanos nanoseconds (nanos < 10^9); when a\n// signal interrupts it, Err(EINTR) with the time left in *left.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_nanosleep(secs: i64, nanos: i64, left: &mut SysTimespec) -> Result<(), i32> {\n    let req = SysTimespec { tv_sec: secs, tv_nsec: nanos };\n    // UNSAFE: C's nanosleep reads and writes struct timespecs through raw\n    // pointers.\n    // SAFETY: req is a local, left the caller's &mut SysTimespec.\n    sys_check_unit(unsafe { sys_c_nanosleep(&req, left) })\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 at a time).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_getentropy(buf: &mut [u8]) -> Result<(), i32> {\n    let mut at: i64 = 0;\n    for _ in 0..(buf.len() as i64 + 255) / 256 {\n        let n: i64 = if buf.len() as i64 - at < 256 { buf.len() as i64 - at } else { 256 };\n        // UNSAFE: C's getentropy writes through a raw pointer.\n        // SAFETY: n <= 256 bytes at buf[at..at + n].as_mut_ptr(), a subslice of buf\n        // (boun