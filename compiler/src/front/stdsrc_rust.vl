    buf_str(out, c"            (*self.start()..*self.end() + 1).get_mut(s)\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index(s)\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index_mut(s)\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeFrom<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (self.start..s.len()).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        let n = s.len();\n        (self.start..n).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (self.start..s.len()).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        let n = s.len();\n        (self.start..n).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeTo<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (0..self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeToInclusive<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (0..=self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..=self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..=self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..=self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeFull {\n");
    buf_str(out, c"    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        Option::Some(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        Option::Some(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        s\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        s\n    }\n}\n\nimpl<I: SliceIndex<str>> Index<I> for str {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\n// Byte for byte.\nimpl PartialEq for str {\n    fn eq(&self, other: &str) -> bool {\n        self.as_bytes() == other.as_bytes()\n    }\n}\n\nimpl Eq for str {}\n\n// By bytes, which is by code points.\nimpl PartialOrd for str {\n    fn partial_cmp(&self, other: &str) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\nimpl Ord for str {\n    fn cmp(&self, other: &str) -> Ordering {\n        self.as_bytes().cmp(other.as_bytes())\n    }\n}\n\n// Its bytes and a 0xff, as Rust's (so (\"ab\", \"c\") and (\"a\", \"bc\") differ).\nimpl Hash for str {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write(self.as_bytes());\n        state.write_u8(0xff);\n    }\n}\n\nimpl Display for str {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.pad(self)\n    }\n}\n\n// Quoted, with escapes: \"a\\\"b\".\nimpl Debug for str {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"\\\"\")?;\n        let mut from: usize = 0;\n        let mut it = self.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    let esc = match c {\n                        '\"' => \"\\\\\\\"\",\n                        '\\\\' => \"\\\\\\\\\",\n                        '\\n' => \"\\\\n\",\n                        '\\r' => \"\\\\r\",\n                        '\\t' => \"\\\\t\",\n                        '\\0' => \"\\\\0\",\n                        _ => \"\",\n");
    buf_str(out, c"                    };\n                    // controls, white space but ' ' and (as Rust's) grapheme extenders\n                    // are escaped\n                    let control = c.is_control() || is_extend(c)\n                        || (c.is_whitespace() && c != ' ');\n                    if esc.len() > 0 || control {\n                        f.write_str(&self[from..i])?;\n                        if esc.len() > 0 {\n                            f.write_str(esc)?;\n                        } else {\n                            write_unicode_escape(f, c as u32)?;\n                        }\n                        from = i + c.len_utf8();\n                    }\n                }\n                None => break,\n            }\n        }\n        f.write_str(&self[from..])?;\n        f.write_str(\"\\\"\")\n    }\n}\n\n// `s.to_owned_in(a)`: a String<A>.\nimpl<A: Allocator> ToOwnedIn<A> for str {\n    type Owned = String<A>;\n\n    fn to_owned_in(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n}\n\nimpl AsRef<str> for str {\n    fn as_ref(&self) -> &str {\n        self\n    }\n}\n\nimpl AsRef<[u8]> for str {\n    fn as_ref(&self) -> &[u8] {\n        self.as_bytes()\n    }\n}\n\n// later: impl_for_ref\nimpl<'a> Default for &'a str {\n    fn default() -> &'a str {\n        \"\"\n    }\n}\n\n// ---- The iterators ----\n\n// str::chars's iterator; `.rev()` from the end.\n// mvs: Chars, RevChars, CodePoints\n#[derive(Clone)]\npub struct Chars<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Chars<'a> {\n    // What is left.\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.rest\n    }\n}\n\nimpl<'a> Iterator for Chars<'a> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_first(self.rest.as_bytes());\n        self.rest = &self.rest[n..];\n        Some(c)\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Chars<'a> {\n");
    buf_str(out, c"    fn next_back(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_last(self.rest.as_bytes());\n        self.rest = &self.rest[..self.rest.len() - n];\n        Some(c)\n    }\n}\n\n// str::char_indices's iterator.\n#[derive(Clone)]\npub struct CharIndices<'a> {\n    front: usize,\n    chars: Chars<'a>,\n}\n\nimpl<'a> CharIndices<'a> {\n    // The byte offset of the next char (the length at the end).\n    #[effects()]\n    pub fn offset(&self) -> usize {\n        self.front\n    }\n}\n\nimpl<'a> Iterator for CharIndices<'a> {\n    type Item = (usize, char);\n\n    fn next(&mut self) -> Option<(usize, char)> {\n        let before = self.chars.rest.len();\n        match self.chars.next() {\n            Some(c) => {\n                let i = self.front;\n                self.front += before - self.chars.rest.len();\n                Some((i, c))\n            }\n            None => None,\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for CharIndices<'a> {\n    fn next_back(&mut self) -> Option<(usize, char)> {\n        match self.chars.next_back() {\n            Some(c) => Some((self.front + self.chars.rest.len(), c)),\n            None => None,\n        }\n    }\n}\n\n// str::bytes's iterator.\n#[derive(Clone)]\npub struct Bytes<'a> {\n    inner: crate::slice::Iter<'a, u8>,\n}\n\nimpl<'a> Iterator for Bytes<'a> {\n    type Item = u8;\n\n    fn next(&mut self) -> Option<u8> {\n        self.inner.next().copied()\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Bytes<'a> {\n    fn next_back(&mut self) -> Option<u8> {\n        self.inner.next_back().copied()\n    }\n}\n\n// str::lines's iterator.\n#[derive(Clone)]\npub struct Lines<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for Lines<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n");
    buf_str(out, c"        let line = match find_byte(s.as_bytes(), 0x0A) {\n            Some(i) => {\n                self.rest = &s[i + 1..];\n                &s[..i]\n            }\n            None => {\n                self.rest = \"\";\n                s\n            }\n        };\n        Some(strip_cr(line))\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Lines<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        // the last line's own \"\\n\" is not a line break before an empty line\n        let b = s.as_bytes();\n        let cut = if b[b.len() - 1] == 0x0A { s.len() - 1 } else { s.len() };\n        let body: &str = &s[..cut];\n        let line = match rfind_byte(body.as_bytes(), 0x0A) {\n            Some(i) => {\n                self.rest = &s[..i + 1];\n                &body[i + 1..]\n            }\n            None => {\n                self.rest = \"\";\n                body\n            }\n        };\n        Some(strip_cr(line))\n    }\n}\n\n// str::split's iterator: the pieces of hay[start..end] between the\n// matches; front and back are where the next search from either end\n// starts (None: no more matches that way).\npub struct Split<'a, P> {\n    hay: &'a str,\n    start: usize,\n    end: usize,\n    front: Option<usize>,\n    back: Option<usize>,\n    pat: P,\n    trailing: bool,\n    done: bool,\n}\n\nimpl<'a, P: Pattern> Split<'a, P> {\n    fn new(hay: &'a str, pat: P, trailing: bool) -> Split<'a, P> {\n        Split {\n            hay: hay,\n            start: 0,\n            end: hay.len(),\n            front: Some(0),\n            back: Some(hay.len()),\n            pat: pat,\n            trailing: trailing,\n            done: false,\n        }\n    }\n\n    // The last piece, once (none when it is empty and trailing is false).\n    fn get_end(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n");
    buf_str(out, c"        self.done = true;\n        if self.trailing || self.end > self.start {\n            Some(&self.hay[self.start..self.end])\n        } else {\n            None\n        }\n    }\n}\n\nimpl<'a, P: Pattern> Iterator for Split<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        let m = match self.front {\n            Some(at) => self.pat.next_match(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if b <= self.end => {\n                let piece = &self.hay[self.start..a];\n                self.start = b;\n                self.front = after_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => self.get_end(),\n        }\n    }\n}\n\nimpl<'a, P: Pattern> DoubleEndedIterator for Split<'a, P> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        if !self.trailing {\n            // split_terminator: an empty last piece is not one\n            self.trailing = true;\n            match self.next_back() {\n                Some(piece) if !piece.is_empty() => return Some(piece),\n                _ => {\n                    if self.done {\n                        return None;\n                    }\n                }\n            }\n        }\n        let m = match self.back {\n            Some(at) => self.pat.next_match_back(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if a >= self.start => {\n                let piece = &self.hay[b..self.end];\n                self.end = a;\n                self.back = before_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => {\n                self.done = true;\n                Some(&self.hay[self.start..self.end])\n            }\n        }\n    }\n}\n\n// str::rsplit's iterator.\npub struct RSplit<'a, P> {\n");
    buf_str(out, c"    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplit<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next_back()\n    }\n}\n\n// str::splitn's iterator.\npub struct SplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next()\n            }\n        }\n    }\n}\n\n// str::rsplitn's iterator.\npub struct RSplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next_back()\n            }\n        }\n    }\n}\n\n// str::split_terminator's iterator.\npub struct SplitTerminator<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitTerminator<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next()\n    }\n}\n\n// str::split_inclusive's iterator.\npub struct SplitInclusive<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitInclusive<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.inner.done {\n            return None;\n        }\n        let m = match self.inner.front {\n            Some(at) => self.inner.pat.next_match(self.inner.hay, at),\n            None => None,\n        };\n        match m {\n");
    buf_str(out, c"            Some((a, b)) if b <= self.inner.end => {\n                let piece = &self.inner.hay[self.inner.start..b];\n                self.inner.start = b;\n                self.inner.front = after_match(self.inner.hay, a, b);\n                Some(piece)\n            }\n            _ => self.inner.get_end(),\n        }\n    }\n}\n\n// str::split_whitespace's iterator.\n#[derive(Clone)]\npub struct SplitWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_start();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        self.rest = &s[i..];\n                        return Some(&s[..i]);\n                    }\n                }\n                None => {\n                    self.rest = \"\";\n                    return Some(s);\n                }\n            }\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for SplitWhitespace<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_end();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        let j = i + c.len_utf8();\n                        self.rest = &s[..i];\n                        return Some(&s[j..]);\n                    }\n                }\n                None => {\n                    self.rest = \"\";\n                    return Some(s);\n                }\n            }\n        }\n    }\n}\n\n// str::split_ascii_whitespace's iterator.\n#[derive(Clone)]\n");
    buf_str(out, c"pub struct SplitAsciiWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitAsciiWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let b = self.rest.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() && is_ascii_space(b[i]) {\n            i += 1;\n        }\n        if i == b.len() {\n            self.rest = \"\";\n            return None;\n        }\n        let mut j = i;\n        while j < b.len() && !is_ascii_space(b[j]) {\n            j += 1;\n        }\n        let s = self.rest;\n        self.rest = &s[j..];\n        Some(&s[i..j])\n    }\n}\n\n// str::matches's iterator (at: where the next search starts; past the\n// end when done).\npub struct Matches<'a, P> {\n    hay: &'a str,\n    at: usize,\n    pat: P,\n}\n\nimpl<'a, P: Pattern> Iterator for Matches<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.at > self.hay.len() {\n            return None;\n        }\n        match self.pat.next_match(self.hay, self.at) {\n            Some((a, b)) => {\n                self.at = match after_match(self.hay, a, b) {\n                    Some(n) => n,\n                    None => self.hay.len() + 1,\n                };\n                Some(&self.hay[a..b])\n            }\n            None => {\n                self.at = self.hay.len() + 1;\n                None\n            }\n        }\n    }\n}\n\n// str::match_indices's iterator.\npub struct MatchIndices<'a, P> {\n    hay: &'a str,\n    at: usize,\n    pat: P,\n}\n\nimpl<'a, P: Pattern> Iterator for MatchIndices<'a, P> {\n    type Item = (usize, &'a str);\n\n    fn next(&mut self) -> Option<(usize, &'a str)> {\n        if self.at > self.hay.len() {\n            return None;\n        }\n        match self.pat.next_match(self.hay, self.at) {\n            Some((a, b)) => {\n                self.at = match after_match(self.hay, a, b) {\n                    Some(n) => n,\n");
    buf_str(out, c"                    None => self.hay.len() + 1,\n                };\n                Some((a, &self.hay[a..b]))\n            }\n            None => {\n                self.at = self.hay.len() + 1;\n                None\n            }\n        }\n    }\n}\n\n// str::graphemes's iterator: vole's.\n// mvs: StrGraphemes\n// std2: renamed\npub struct Graphemes<'a> {\n    rest: &'a str,\n    extended: bool,\n}\n\n// ---- The helpers ----\n\n// The first code point of b (UTF-8, not empty) and its length.\nfn decode_first(b: &[u8]) -> (char, usize) {\n    let x = b[0] as u32;\n    let (n, init): (usize, u32) = if x < 0x80 {\n        (1, x)\n    } else if x < 0xE0 {\n        (2, x & 0x1F)\n    } else if x < 0xF0 {\n        (3, x & 0x0F)\n    } else {\n        (4, x & 0x07)\n    };\n    let mut cp = init;\n    let mut k: usize = 1;\n    while k < n {\n        cp = (cp << 6) | (b[k] as u32 & 0x3F);\n        k += 1;\n    }\n    (to_char(cp), n)\n}\n\n// The last code point of b (UTF-8, not empty) and its length.\nfn decode_last(b: &[u8]) -> (char, usize) {\n    let mut i = b.len() - 1;\n    while i > 0 && b[i] & 0xC0 == 0x80 {\n        i -= 1;\n    }\n    let (c, _) = decode_first(&b[i..]);\n    (c, b.len() - i)\n}\n\nfn to_char(cp: u32) -> char {\n    match char::from_u32(cp) {\n        Some(c) => c,\n        None => '\\u{FFFD}',\n    }\n}\n\n// Where the search after the match a..b starts: b, or past the next char\n// for an empty match (so it is not found again); None past the end.\nfn after_match(hay: &str, a: usize, b: usize) -> Option<usize> {\n    if a < b {\n        Some(b)\n    } else if b < hay.len() {\n        let (_, n) = decode_first(&hay.as_bytes()[b..]);\n        Some(b + n)\n    } else {\n        None\n    }\n}\n\n// The same, searching backwards: a, or before the previous char.\nfn before_match(hay: &str, a: usize, b: usize) -> Option<usize> {\n    if a < b {\n        Some(a)\n    } else if a > 0 {\n        let (_, n) = decode_last(&hay.as_bytes()[..a]);\n");
    buf_str(out, c"        Some(a - n)\n    } else {\n        None\n    }\n}\n\n// Where x first (last) is in b: a line's end.\nfn find_byte(b: &[u8], x: u8) -> Option<usize> {\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == x {\n            return Some(i);\n        }\n        i += 1;\n    }\n    None\n}\n\nfn rfind_byte(b: &[u8], x: u8) -> Option<usize> {\n    let mut i = b.len();\n    while i > 0 {\n        i -= 1;\n        if b[i] == x {\n            return Some(i);\n        }\n    }\n    None\n}\n\n// A line without its \"\\r\" (of a \"\\r\\n\").\nfn strip_cr(line: &str) -> &str {\n    let n = line.len();\n    let cut = if n > 0 && line.as_bytes()[n - 1] == 0x0D { n - 1 } else { n };\n    &line[..cut]\n}\n\n// Rust's u8::is_ascii_whitespace: space, \\t, \\n, \\x0C, \\r.\nfn is_ascii_space(b: u8) -> bool {\n    b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0C || b == 0x0D\n}\n\nfn ascii_lower(b: u8) -> u8 {\n    if b >= 0x41 && b <= 0x5A { b + 32 } else { b }\n}\n\nfn ascii_upper(b: u8) -> u8 {\n    if b >= 0x61 && b <= 0x7A { b - 32 } else { b }\n}\n\n// A &mut str's bytes (Rust's str::as_bytes_mut).\n// UNSAFE: the bytes can be written with what is not UTF-8.\n// SAFETY: a contract on the caller: what it writes keeps s UTF-8.\nunsafe fn bytes_mut(s: &mut str) -> &mut [u8] {\n    // UNSAFE: the str's bytes through its fat pointer, as Rust's core.\n    // SAFETY: the pointer and length are s's own, and s is borrowed mutably\n    // for the result's life, so nothing else reaches the bytes.\n    unsafe { &mut *(s as *mut str as *mut [u8]) }\n}\n\n// UTF-8 bytes as a &mut str (Rust's str::from_utf8_unchecked_mut).\n// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n// SAFETY: a contract on the caller: b is UTF-8.\nunsafe fn str_mut(b: &mut [u8]) -> &mut str {\n    // UNSAFE: a pointer cast between [u8] and str.\n    // SAFETY: the same layout; the caller promises UTF-8.\n    unsafe { &mut *(b as *mut [u8] as *mut str) }\n}\n\n");
    buf_str(out, c"// `&s[a..b]` out of bounds or off a char boundary: Rust's messages, without\n// the text (str's Display in a panic's format waits for format_fns).\nfn slice_error_fail(s: &str, a: usize, b: usize) -> ! {\n    if a > s.len() {\n        crate::panic::panic(\"byte index {} is out of bounds of a str of {} bytes\", a, s.len())\n    } else if b > s.len() {\n        crate::panic::panic(\"byte index {} is out of bounds of a str of {} bytes\", b, s.len())\n    } else if a > b {\n        crate::panic::panic(\"begin <= end ({} <= {}) when slicing a str\", a, b)\n    } else if !s.is_char_boundary(a) {\n        crate::panic::panic(\"byte index {} is not a char boundary\", a)\n    } else {\n        crate::panic::panic(\"byte index {} is not a char boundary\", b)\n    }\n}\n\n// `\\u{1b}`: Debug's escape of a control char, in lower-case hex.\nfn write_unicode_escape(f: &mut Formatter<'_>, cp: u32) -> crate::fmt::Result {\n    // `\\u{`, the hex digits, `}`, written from the end back\n    let mut buf = [0u8; 11];\n    let mut n: usize = 11;\n    n -= 1;\n    buf[n] = 0x7D;\n    let mut x = cp;\n    loop {\n        let d = (x & 0xF) as u8;\n        n -= 1;\n        buf[n] = if d < 10 { 0x30 + d } else { 0x57 + d };\n        x = x >> 4;\n        if x == 0 {\n            break;\n        }\n    }\n    n -= 3;\n    buf[n] = 0x5C;\n    buf[n + 1] = 0x75;\n    buf[n + 2] = 0x7B;\n    match from_utf8(&buf[n..]) {\n        Ok(s) => f.write_str(s),\n        Err(_) => Ok(()),\n    }\n}\n\n// The grapheme properties the clusters need (UAX #29), from the code\n// point ranges std2 has without the Unicode tables (MVS's std::unicode).\nfn is_control(cp: u32) -> bool {\n    cp < 0x20 || (cp >= 0x7F && cp < 0xA0) || cp == 0x2028 || cp == 0x2029\n}\n\nfn is_regional(cp: u32) -> bool {\n    cp >= 0x1F1E6 && cp <= 0x1F1FF\n}\n\nfn is_extend(c: char) -> bool {\n    let cp = c as u32;\n    (cp >= 0x300 && cp <= 0x36F)\n        || (cp >= 0x1AB0 && cp <= 0x1AFF)\n        || (cp >= 0x1DC0 && cp <= 0x1DFF)\n");
    buf_str(out, c"        || (cp >= 0x20D0 && cp <= 0x20FF)\n        || (cp >= 0xFE00 && cp <= 0xFE0F)\n        || (cp >= 0xFE20 && cp <= 0xFE2F)\n        || (cp >= 0x1F3FB && cp <= 0x1F3FF)\n        || (cp >= 0xE0020 && cp <= 0xE007F)\n        || (cp >= 0x300 && !is_control(cp) && c.width() == 0 && cp != 0x200D)\n}\n\n// SpacingMark: the common Indic vowel signs.\nfn is_spacing_mark(cp: u32) -> bool {\n    cp == 0x903 || cp == 0x93B || (cp >= 0x93E && cp <= 0x940) || (cp >= 0x949 && cp <= 0x94C)\n        || cp == 0x94E || cp == 0x94F || cp == 0x982 || cp == 0x983\n        || (cp >= 0x9BF && cp <= 0x9C0) || (cp >= 0xBBF && cp <= 0xBC0)\n}\n\n// East Asian Ambiguous: the main blocks (Latin-1's symbols, Greek,\n// Cyrillic, box drawing, the circled and geometric forms, private use).\nfn is_ambiguous(cp: u32) -> bool {\n    cp == 0xA1 || cp == 0xA4 || cp == 0xA7 || cp == 0xA8 || cp == 0xAA || cp == 0xAD || cp == 0xAE\n        || (cp >= 0xB0 && cp <= 0xB4) || (cp >= 0xB6 && cp <= 0xBA) || (cp >= 0xBC && cp <= 0xBF)\n        || cp == 0xC6 || cp == 0xD0 || cp == 0xD7 || cp == 0xD8 || (cp >= 0xDE && cp <= 0xE1)\n        || cp == 0xE6 || (cp >= 0xE8 && cp <= 0xEA) || cp == 0xEC || cp == 0xED || cp == 0xF0\n        || cp == 0xF2 || cp == 0xF3 || (cp >= 0xF7 && cp <= 0xFA) || cp == 0xFC || cp == 0xFE\n        || (cp >= 0x391 && cp <= 0x3A9) || (cp >= 0x3B1 && cp <= 0x3C9) || cp == 0x401\n        || (cp >= 0x410 && cp <= 0x44F) || cp == 0x451 || (cp >= 0x2010 && cp <= 0x2027)\n        || (cp >= 0x2460 && cp <= 0x24FF) || (cp >= 0x2500 && cp <= 0x257F)\n        || (cp >= 0x25A0 && cp <= 0x25FF) || (cp >= 0xE000 && cp <= 0xF8FF) || cp == 0xFFFD\n}\n\n// A cluster's columns: its first char's, 2 with an emoji presentation\n// selector (U+FE0F), or with cjk an ambiguous one.\nfn cluster_width(g: &str, cjk: bool) -> usize {\n    let (c, _) = decode_first(g.as_bytes());\n    let w = c.width();\n    // U+FE0F is EF B8 8F in UTF-8\n    let b = g.as_bytes();\n    let mut vs16 = false;\n");
    buf_str(out, c"    let mut i: usize = 0;\n    while i + 2 < b.len() {\n        if b[i] == 0xEF && b[i + 1] == 0xB8 && b[i + 2] == 0x8F {\n            vs16 = true;\n        }\n        i += 1;\n    }\n    if w == 1 && (vs16 || (cjk && is_ambiguous(c as u32))) {\n        2\n    } else {\n        w\n    }\n}\n\nimpl<'a> Iterator for Graphemes<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        let b = s.as_bytes();\n        let (first, n0) = decode_first(b);\n        let mut prev = first as u32;\n        let mut end = n0;\n        // regional indicators pair up (GB12, GB13)\n        let mut ri: usize = if is_regional(prev) { 1 } else { 0 };\n        while end < b.len() {\n            let (c, n) = decode_first(&b[end..]);\n            let cp = c as u32;\n            // GB3: CR LF stays together; GB4, GB5: a control breaks\n            let join = if prev == 0x0D && cp == 0x0A {\n                true\n            } else if is_control(prev) || is_control(cp) {\n                false\n            } else if is_extend(c) || cp == 0x200D {\n                // GB9: Extend and ZWJ\n                true\n            } else if self.extended && is_spacing_mark(cp) {\n                // GB9a\n                true\n            } else if prev == 0x200D && c.width() == 2 {\n                // GB11: ZWJ then a pictograph (wide as an approximation)\n                true\n            } else if is_regional(cp) && ri % 2 == 1 {\n                true\n            } else {\n                false\n            };\n            if !join {\n                break;\n            }\n            if is_regional(cp) {\n                ri += 1;\n            }\n            prev = cp;\n            end += n;\n        }\n        self.rest = &s[end..];\n        Some(&s[..end])\n    }\n}\n\n// Unicode's Cased, approximately: Lowercase or Uppercase (the titlecase\n// letters,