> {\n");
    buf_str(out, c"    char::from_u32(i)\n}\n\n// The digit d in radix as a char (char::from_digit).\n#[effects(panic)]\npub fn from_digit(d: u32, radix: u32) -> Option<char>\n    requires radix <= 36\n{\n    char::from_digit(d, radix)\n}\n\n// Why a u32 is not a char.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct CharTryFromError(());\n\nimpl Display for CharTryFromError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"converted integer out of range for `char`\")\n    }\n}\n\n// The comparisons of chars: their scalar values' (char is no\n// `#[builtin_impls]` primitive: written, as Clone and Copy are).\nimpl PartialEq for char {\n    fn eq(&self, other: &char) -> bool {\n        (*self as u32) == (*other as u32)\n    }\n}\n\nimpl Eq for char {}\n\nimpl PartialOrd for char {\n    fn partial_cmp(&self, other: &char) -> Option<Ordering> {\n        Option::Some((*self as u32).cmp(&(*other as u32)))\n    }\n}\n\nimpl Ord for char {\n    fn cmp(&self, other: &char) -> Ordering {\n        (*self as u32).cmp(&(*other as u32))\n    }\n}\n\n// As its scalar value, a u32 (Rust's).\nimpl Hash for char {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_u32(*self as u32)\n    }\n}\n\n// '\\0'.\nimpl Default for char {\n    fn default() -> char {\n        '\\0'\n    }\n}\n\n// `{c}`: the char itself, padded as a str.\nimpl Display for char {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let mut b = [0u8; 4];\n        f.pad(self.encode_utf8(&mut b))\n    }\n}\n\n// `{c:?}`: the char quoted, with Rust's escapes for the quote, the\n// backslash and the control characters.\nimpl Debug for char {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"'\")?;\n        let c = *self;\n        if c == '\\'' {\n            f.write_str(\"\\\\'\")?;\n        } else if c == '\\\\' {\n            f.write_str(\"\\\\\\\\\")?;\n        } else if c == '\\n' {\n");
    buf_str(out, c"            f.write_str(\"\\\\n\")?;\n        } else if c == '\\r' {\n            f.write_str(\"\\\\r\")?;\n        } else if c == '\\t' {\n            f.write_str(\"\\\\t\")?;\n        } else if c == '\\0' {\n            f.write_str(\"\\\\0\")?;\n        } else if c.is_control() || is_zero_width(c as u32) || (c.is_whitespace() && c != ' ') {\n            // (a control, a combining mark, a format char or white space but\n            // ' ' as Rust's escape_debug shows it: a grapheme extender and\n            // the unprintable)\n            f.write_str(\"\\\\u{\")?;\n            crate::fmt::LowerHex::fmt(&(c as u32), f)?;\n            f.write_str(\"}\")?;\n        } else {\n            f.write_char(c)?;\n        }\n        f.write_str(\"'\")\n    }\n}\n\n// `char::try_from(i)`: from_u32, with an error for what is no char.\nimpl TryFrom<u32> for char {\n    type Error = CharTryFromError;\n\n    fn try_from(i: u32) -> Result<char, CharTryFromError> {\n        match char::from_u32(i) {\n            Option::Some(c) => Result::Ok(c),\n            Option::None => Result::Err(CharTryFromError(())),\n        }\n    }\n}\n\n// i as a char, i a scalar value (Rust's char::from_u32_unchecked).\nfn from_u32_unchecked(i: u32) -> char {\n    // UNSAFE: a u32's bits read as a char (Rust's transmute).\n    // SAFETY: every caller passes a scalar value (from_u32 checks it; the\n    // case maps give one), and a char is laid out as a u32.\n    unsafe { *(&i as *const u32 as *const char) }\n}\n\n// A case table's mapping (1 to 3 code points, the rest 0) as chars and\n// their count.\nfn case_chars(m: [u32; 3]) -> ([char; 3], usize) {\n    let len: usize = if m[1] == 0 { 1 } else if m[2] == 0 { 2 } else { 3 };\n    ([from_u32_unchecked(m[0]), from_u32_unchecked(m[1]), from_u32_unchecked(m[2])], len)\n}\n\n// The combining marks and the format chars: no column of their own.\nfn is_zero_width(c: u32) -> bool {\n");
    buf_str(out, c"    (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5BD)\n        || (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F)\n        || (c >= 0x900 && c <= 0x902) || c == 0x93C || (c >= 0x941 && c <= 0x948) || c == 0x94D\n        || (c >= 0x1AB0 && c <= 0x1AFF) || (c >= 0x1DC0 && c <= 0x1DFF)\n        || (c >= 0x200B && c <= 0x200F) || (c >= 0x202A && c <= 0x202E)\n        || (c >= 0x2060 && c <= 0x2064) || (c >= 0x20D0 && c <= 0x20FF)\n        || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || c == 0xFEFF\n        || (c >= 0xE0000 && c <= 0xE0FFF)\n}\n\n// East Asian Wide and Fullwidth, and the emoji blocks.\nfn is_wide(c: u32) -> bool {\n    (c >= 0x1100 && c <= 0x115F) || (c >= 0x231A && c <= 0x231B) || (c >= 0x2E80 && c <= 0x303E)\n        || (c >= 0x3041 && c <= 0x33FF) || (c >= 0x3400 && c <= 0x4DBF)\n        || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xA000 && c <= 0xA4CF)\n        || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF)\n        || (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFF60)\n        || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F)\n        || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD)\n}\n// ---- end mod std::char ----\n}\n// ---- mod std::num ----\npub mod num {\n// std2: new: Rust's integer methods' home (std::num).\n\n// The integers' inherent methods (front-rust.md F15.4): `x.wrapping_add(y)`,\n// `x.checked_mul(y)` (an Option), `x.overflowing_sub(y)` (the wrapped\n// value and whether it overflowed), `x.saturating_sub(y)`, the bit counts\n// and the rotations, for i8 .. usize, with no `use`. The compiler makes\n// `impl i8 { .. }` .. `impl usize { .. }` from its list (front/builtin_impls)\n// as this module's items, at the attribute below; this module's\n// arithmetic never checks overflow, whatever --overflow-checks says\n// (front/modules: std_wraps), so `self + rhs` in them is Rust's\n");
    buf_str(out, c"// wrapping_add. `/` and `%` by zero panic here too, as Rust's\n// wrapping_div does.\npub mod wrapping {\n    // The high 64 bits of the 128-bit product a * b (vole has no u128):\n    // four 32-bit products, none of which overflows. The overflowing_mul\n    // of the 64-bit integers reads it.\n    #[builtin_methods(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\n    #[effects()]\n    pub fn mul_hi(a: u64, b: u64) -> u64 {\n        let m: u64 = 0xffffffff;\n        let (a0, a1) = (a & m, a >> 32);\n        let (b0, b1) = (b & m, b >> 32);\n        let p00 = a0 * b0;\n        let p01 = a0 * b1;\n        let p10 = a1 * b0;\n        let p11 = a1 * b1;\n        let mid = (p00 >> 32) + (p01 & m) + (p10 & m);\n        p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n    }\n}\n\n// The errors of parsing and converting numbers, at Rust's paths\n// (std::num::ParseIntError, IntErrorKind, ParseFloatError,\n// TryFromIntError): they are defined beside the code that makes them.\npub use crate::convert::TryFromIntError;\npub use crate::str::{IntErrorKind, ParseFloatError, ParseIntError};\n// ---- end mod std::num ----\n}\n// ---- mod std::intconv ----\nmod intconv {\n// EDITION: rust\n// Generated by tools/std2-intconv.py (do not edit): the integers' TryFrom\n// impls and from_str_radix, which Rust's std writes with macros.\n//\n// `T::try_from(x)` of an integer x: Ok when x is one of T's values, else\n// Err(TryFromIntError), as Rust's. A conversion that cannot fail (Rust has\n// `From` for it, and Infallible for its TryFrom's error) has the error\n// type TryFromIntError here too, and is always Ok: `{:?}` of a\n// Result<T, Infallible> does not compile yet (its Err arm is refused as\n// unreachable). usize and isize are 64 bits. One generic impl over a\n// private trait of the ten types does it.\n//\n// `T::from_str_radix(s, radix)`: s as a T in radix (2 to 36, else a panic):\n// an optional `+` (or `-`, for a signed type), then digits (`a`-`z` and\n");
    buf_str(out, c"// `A`-`Z` are 10 to 35), nothing else; the errors are `s.parse::<T>()`'s.\n\nuse crate::convert::{TryFrom, TryFromIntError};\nuse crate::result::Result;\nuse crate::str::{IntErrorKind, ParseIntError};\n\n// The value of s in radix, as its 64 bits (two's complement for a negative\n// one): at most `pos` when positive, and, for a signed type, at most `neg`\n// in magnitude when negative.\nfn parse_radix(s: &str, radix: u32, signed: bool, pos: u64, neg: u64) -> Result<u64,\n    ParseIntError> {\n    if radix < 2 || radix > 36 {\n        crate::panic::panic(\"from_str_radix: the radix must lie in the range `[2, 36]`\");\n    }\n    let b = s.as_bytes();\n    if b.len() == 0 {\n        return Result::Err(crate::str::int_error(IntErrorKind::Empty));\n    }\n    let mut i: usize = 0;\n    let mut negative = false;\n    if b[0] == b'+' {\n        i = 1;\n    } else if b[0] == b'-' && signed {\n        negative = true;\n        i = 1;\n    }\n    if i == b.len() {\n        return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));\n    }\n    let limit = if negative { neg } else { pos };\n    let r = radix as u64;\n    let mut acc: u64 = 0;\n    while i < b.len() {\n        let c = b[i];\n        let d: u64 = if c >= b'0' && c <= b'9' {\n            (c - b'0') as u64\n        } else if c >= b'a' && c <= b'z' {\n            (c - b'a') as u64 + 10\n        } else if c >= b'A' && c <= b'Z' {\n            (c - b'A') as u64 + 10\n        } else {\n            36\n        };\n        if d >= r {\n            return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));\n        }\n        // (acc * r + d <= limit, without overflow: d < r <= 36 <= limit)\n        if acc > (limit - d) / r {\n            return Result::Err(crate::str::int_error(if negative { IntErrorKind::NegOverflow }\n                else { IntErrorKind::PosOverflow }));\n        }\n        acc = acc * r + d;\n        i += 1;\n    }\n");
    buf_str(out, c"    Result::Ok(if negative { (!acc).wrapping_add(1) } else { acc })\n}\n\nimpl i8 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i8, ParseIntError> {\n        match parse_radix(src, radix, true, 127, 128) {\n            Result::Ok(v) => Result::Ok(v as i8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i16 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i16, ParseIntError> {\n        match parse_radix(src, radix, true, 32767, 32768) {\n            Result::Ok(v) => Result::Ok(v as i16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i32 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i32, ParseIntError> {\n        match parse_radix(src, radix, true, 2147483647, 2147483648) {\n            Result::Ok(v) => Result::Ok(v as i32),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i64 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i64, ParseIntError> {\n        match parse_radix(src, radix, true, 9223372036854775807, 9223372036854775808) {\n            Result::Ok(v) => Result::Ok(v as i64),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl isize {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<isize, ParseIntError> {\n        match parse_radix(src, radix, true, 9223372036854775807, 9223372036854775808) {\n            Result::Ok(v) => Result::Ok(v as isize),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u8 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u8, ParseIntError> {\n        match parse_radix(src, radix, false, 255, 0) {\n            Result::Ok(v) => Result::Ok(v as u8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u16 {\n    #[effects(panic)]\n");
    buf_str(out, c"    pub fn from_str_radix(src: &str, radix: u32) -> Result<u16, ParseIntError> {\n        match parse_radix(src, radix, false, 65535, 0) {\n            Result::Ok(v) => Result::Ok(v as u16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u32 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u32, ParseIntError> {\n        match parse_radix(src, radix, false, 4294967295, 0) {\n            Result::Ok(v) => Result::Ok(v as u32),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u64 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u64, ParseIntError> {\n        match parse_radix(src, radix, false, 18446744073709551615, 0) {\n            Result::Ok(v) => Result::Ok(v as u64),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl usize {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<usize, ParseIntError> {\n        match parse_radix(src, radix, false, 18446744073709551615, 0) {\n            Result::Ok(v) => Result::Ok(v as usize),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\n// What the one TryFrom impl below reads of an integer type: std's own.\n// (Two one-line methods a type: the lazy std keeps these impls in every\n// program. The type's range comes from its size and whether it is signed.)\npub trait IntBits: Sized {\n    // The value as 64 bits, sign-extended, and whether the type is signed.\n    fn int_bits(self) -> (u64, bool);\n    // The value of its width's low bits of v.\n    fn int_from(v: u64) -> Self;\n}\n\nimpl IntBits for i8 {\n    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn int_from(v: u64) -> i8 { v as i8 }\n}\n\nimpl IntBits for i16 {\n    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn int_from(v: u64) -> i16 { v as i16 }\n}\n\nimpl IntBits for i32 {\n");
    buf_str(out, c"    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn int_from(v: u64) -> i32 { v as i32 }\n}\n\nimpl IntBits for i64 {\n    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn int_from(v: u64) -> i64 { v as i64 }\n}\n\nimpl IntBits for isize {\n    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn int_from(v: u64) -> isize { v as isize }\n}\n\nimpl IntBits for u8 {\n    fn int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn int_from(v: u64) -> u8 { v as u8 }\n}\n\nimpl IntBits for u16 {\n    fn int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn int_from(v: u64) -> u16 { v as u16 }\n}\n\nimpl IntBits for u32 {\n    fn int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn int_from(v: u64) -> u32 { v as u32 }\n}\n\nimpl IntBits for u64 {\n    fn int_bits(self) -> (u64, bool) { (self, false) }\n    fn int_from(v: u64) -> u64 { v }\n}\n\nimpl IntBits for usize {\n    fn int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn int_from(v: u64) -> usize { v as usize }\n}\n\n// Every pair of integer types (one impl, not a hundred: the lazy std keeps\n// an impl of a trait for a primitive type in every program).\nimpl<S: IntBits, T: IntBits> TryFrom<S> for T {\n    type Error = TryFromIntError;\n\n    fn try_from(x: S) -> Result<T, TryFromIntError> {\n        let (v, negative_kind) = x.int_bits();\n        // (T's range: is it signed? its -1 has the top bit of 64 set)\n        let (_, signed) = T::int_from(0).int_bits();\n        let width = 8 * crate::mem::size_of::<T>() as u64;\n        // (its largest value: width - 1 ones when signed, width ones when not)\n        let max: u64 = if signed { (1u64 << (width - 1)) - 1 }\n            else if width == 64 { 0xffffffffffffffff }\n            else { (1u64 << width) - 1 };\n        if negative_kind && (v as i64) < 0 {\n            // (its smallest: -(max + 1) when signed, 0 when not)\n");
    buf_str(out, c"            if !signed || (v as i64) < -(max as i64) - 1 {\n                return Result::Err(crate::convert::int_range_error(true));\n            }\n        } else if v > max {\n            return Result::Err(crate::convert::int_range_error(false));\n        }\n        Result::Ok(T::int_from(v))\n    }\n}\n// ---- end mod std::intconv ----\n}\n// ---- mod std::string ----\npub mod string {\n// EDITION: rust\n// std::string: String<A>, owned UTF-8 text on A's heap, and ToStringIn.\n// `String::new_in(a)`, `String::from_in(\"x\", a)`, `\"x\".to_string_in(a)`;\n// no `String::from(s)` and no `From<&str>` (it would allocate with no\n// allocator in the call: plan §2). A String has str's methods through\n// Deref; its own are the ones that change it, and they allocate from its\n// A only. MVS's Buf<A> (a byte buffer) is gone: a Vec<u8, A>, or a String.\n// `write(&mut s, \"{x}\")` (fmt::Write) is MVS's `s.push_fmt(\"{x}\")`.\n\nuse crate::alloc::{Allocator, TryReserveError};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::default::DefaultIn;\nuse crate::fmt::{Debug, Display, Formatter, Write};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::ops::{Add, AddAssign, Bound, Deref, DerefMut, Index, IndexMut, RangeBounds};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::slice::SliceIndex;\nuse crate::str::{Chars, Utf8Error};\nuse crate::vec::Vec;\n\n// UTF-8 text that owns its bytes, on A.\npub struct String<A: Allocator> {\n    vec: Vec<u8, A>,\n}\n\nimpl<A: Allocator> String<A> {\n    // An empty String on a; it allocates at its first push.\n    #[effects(A)]\n    pub fn new_in(a: A) -> String<A> {\n        String { vec: Vec::new_in(a) }\n    }\n\n    #[effects(A)]\n    pub fn with_capacity_in(cap: usize, a: A) -> String<A> {\n");
    buf_str(out, c"        String { vec: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A copy of s on a.\n    // std2: changed: takes &str\n    #[effects(A)]\n    pub fn from_in(s: &str, a: A) -> String<A> {\n        let mut out = String::with_capacity_in(s.len(), a);\n        out.push_str(s);\n        out\n    }\n\n    // v as a String when it is UTF-8; the error gives v back.\n    // std2: changed: the error is FromUtf8Error<A>, which holds v (MVS: Utf8Error)\n    #[effects(panic, diverge, A)]\n    pub fn from_utf8(v: Vec<u8, A>) -> Result<String<A>, FromUtf8Error<A>> {\n        match crate::str::from_utf8(v.as_slice()) {\n            Result::Ok(_) => Result::Ok(String { vec: v }),\n            Result::Err(e) => Result::Err(FromUtf8Error { bytes: v, error: e }),\n        }\n    }\n\n    #[effects(unsafe)]\n    // UNSAFE: bytes that are not UTF-8 make a String whose str methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: Vec<u8, A>) -> String<A> {\n        String { vec: v }\n    }\n\n    // v as text on a, each bad sequence U+FFFD (Rust's from_utf8_lossy,\n    // which returns a Cow).\n    // std2: changed: takes &[u8]\n    #[effects(panic, diverge, unsafe, A)]\n    pub fn from_utf8_lossy_in(v: &[u8], a: A) -> String<A> {\n        let mut out = String::with_capacity_in(v.len(), a);\n        let mut rest = v;\n        loop {\n            match crate::str::from_utf8(rest) {\n                Result::Ok(s) => {\n                    out.push_str(s);\n                    return out;\n                }\n                Result::Err(e) => {\n                    let good = e.valid_up_to();\n                    // UNSAFE: from_utf8 checked these bytes already; the\n                    // checked conversion would check them again.\n                    // SAFETY: valid_up_to says the first good bytes of rest\n                    // are UTF-8.\n");
    buf_str(out, c"                    out.push_str(unsafe { crate::str::from_utf8_unchecked(&rest[..good]) });\n                    out.push_str(\"\\u{FFFD}\");\n                    let bad = match e.error_len() {\n                        Option::Some(n) => n,\n                        Option::None => rest.len() - good,\n                    };\n                    rest = &rest[good + bad..];\n                }\n            }\n        }\n    }\n\n    // Its length in bytes.\n    #[effects(A)]\n    pub fn len(&self) -> usize {\n        self.vec.len()\n    }\n\n    #[effects(A)]\n    pub fn is_empty(&self) -> bool {\n        self.vec.is_empty()\n    }\n\n    #[effects(A)]\n    pub fn capacity(&self) -> usize {\n        self.vec.capacity()\n    }\n\n    // std2: changed: returns &A (MVS: a copy of A)\n    #[effects(A)]\n    pub fn allocator(&self) -> &A {\n        self.vec.allocator()\n    }\n\n    #[effects(A)]\n    pub fn reserve(&mut self, extra: usize) {\n        self.vec.reserve(extra)\n    }\n\n    #[effects(A)]\n    pub fn reserve_exact(&mut self, extra: usize) {\n        self.vec.reserve_exact(extra)\n    }\n\n    #[effects(A)]\n    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {\n        self.vec.try_reserve(extra)\n    }\n\n    #[effects(A)]\n    pub fn shrink_to_fit(&mut self) {\n        self.vec.shrink_to_fit()\n    }\n\n    // Empties it; the capacity stays.\n    #[effects(panic, A)]\n    pub fn clear(&mut self)\n        ensures self.len() == 0\n    {\n        self.vec.clear()\n    }\n\n    #[effects(unsafe, A)]\n    pub fn as_str(&self) -> &str {\n        // UNSAFE: the bytes are not checked again.\n        // SAFETY: a String's bytes are UTF-8 (every method that writes them\n        // keeps them so; as_mut_vec's caller promises it).\n        unsafe { crate::str::from_utf8_unchecked(self.vec.as_slice()) }\n    }\n\n    #[effects(A)]\n    pub fn as_mut_str(&mut self) -> &mut str {\n        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's\n");
    buf_str(out, c"        // str::from_utf8_unchecked_mut).\n        // SAFETY: a String's bytes are UTF-8, and a str is laid out as a\n        // [u8]; the &mut str's writes keep them UTF-8 (str's contract).\n        unsafe { &mut *(self.vec.as_mut_slice() as *mut [u8] as *mut str) }\n    }\n\n    // mvs: String::as_bytes, String::as_slice\n    #[effects(A)]\n    pub fn as_bytes(&self) -> &[u8] {\n        self.vec.as_slice()\n    }\n\n    // Its bytes as a &mut Vec.\n    #[effects(unsafe)]\n    // UNSAFE: writing bytes that are not UTF-8 breaks the String.\n    // SAFETY: a contract on the caller: the bytes stay UTF-8.\n    pub unsafe fn as_mut_vec(&mut self) -> &mut Vec<u8, A> {\n        &mut self.vec\n    }\n\n    // Its bytes, the String consumed.\n    #[effects()]\n    pub fn into_bytes(self) -> Vec<u8, A> {\n        self.vec\n    }\n\n    // Appends c's UTF-8.\n    // std2: changed: takes a char (MVS: a u32 code point)\n    #[effects(panic, A)]\n    pub fn push(&mut self, c: char)\n        ensures self.len() > old(self.len())\n    {\n        if c.len_utf8() == 1 {\n            self.vec.push(c as u8);\n        } else {\n            let mut buf = [0u8; 4];\n            self.push_str(c.encode_utf8(&mut buf));\n        }\n    }\n\n    #[effects(A)]\n    pub fn push_str(&mut self, s: &str) {\n        self.vec.extend_from_slice(s.as_bytes())\n    }\n\n    // The last char, removed.\n    // std2: changed: Option<char> (MVS: Option<u32>)\n    #[effects(panic, diverge, A)]\n    pub fn pop(&mut self) -> Option<char> {\n        let c = self.as_str().chars().next_back()?;\n        let n = self.len() - c.len_utf8();\n        self.vec.truncate(n);\n        Option::Some(c)\n    }\n\n    // Keeps the first n bytes; panics when n is not a char boundary.\n    #[effects(panic, A)]\n    pub fn truncate(&mut self, n: usize)\n        requires n >= self.len() || self.as_str().is_char_boundary(n)\n    {\n        if n <= self.len() {\n");
    buf_str(out, c"            crate::panic::assert(self.is_char_boundary(n), \"String::truncate: not a char boundary\");\n            self.vec.truncate(n);\n        }\n    }\n\n    // Inserts c at byte i (a char boundary).\n    // std2: changed: takes a char\n    #[effects(panic, A)]\n    pub fn insert(&mut self, i: usize, c: char)\n        requires self.as_str().is_char_boundary(i)\n    {\n        crate::panic::assert(self.is_char_boundary(i), \"String::insert: not a char boundary\");\n        let mut buf = [0u8; 4];\n        let s = c.encode_utf8(&mut buf);\n        self.insert_bytes(i, s.as_bytes());\n    }\n\n    #[effects(panic, A)]\n    pub fn insert_str(&mut self, i: usize, s: &str)\n        requires self.as_str().is_char_boundary(i)\n    {\n        crate::panic::assert(self.is_char_boundary(i), \"String::insert_str: not a char boundary\");\n        self.insert_bytes(i, s.as_bytes());\n    }\n\n    // Removes the char at byte i.\n    // std2: changed: returns a char\n    #[effects(panic, A)]\n    pub fn remove(&mut self, i: usize) -> char {\n        let c = match self.as_str()[i..].chars().next() {\n            Option::Some(c) => c,\n            Option::None => {\n                let msg: &str = \"cannot remove a char from the end of a string\";\n                crate::panic::panic(msg)\n            }\n        };\n        self.vec.drain(i..i + c.len_utf8());\n        c\n    }\n\n    // Keeps the chars f says true of.\n    // std2: changed: FnMut(char) (MVS: FnMut(u32))\n    #[effects(panic, diverge, unsafe, A, F)]\n    pub fn retain<F: FnMut(char) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        let len = self.len();\n        let mut r: usize = 0;\n        let mut w: usize = 0;\n        while r < len {\n            // UNSAFE: the bytes from r on are read as text while the ones\n            // before are being moved down.\n            // SAFETY: w <= r, so the bytes from r on are untouched: the\n            // String's own, UTF-8, and r is a char boundary in them.\n");
    buf_str(out, c"            let rest = unsafe { crate::str::from_utf8_unchecked(&self.vec.as_slice()[r..]) };\n            let c = match rest.chars().next() {\n                Option::Some(c) => c,\n                Option::None => break,\n            };\n            let n = c.len_utf8();\n            if f(c) {\n                self.vec.copy_within(r..r + n, w);\n                w += n;\n            }\n            r += n;\n        }\n        self.vec.truncate(w);\n    }\n\n    // The chars in range, removed and yielded by the iterator.\n    #[effects(panic, unsafe, A, R)]\n    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, A> {\n        let (start, end) = range_of(&range, self.len());\n        crate::panic::assert(self.is_char_boundary(start),\n            \"String::drain: start is not a char boundary\");\n        crate::panic::assert(self.is_char_boundary(end),\n            \"String::drain: end is not a char boundary\");\n        let p = self.vec.as_ptr();\n        // UNSAFE: the iterator reads the drained text while the Drain holds\n        // the String (removed at its drop), as Rust's Drain.\n        // SAFETY: start..end is within the String and on char boundaries,\n        // so the bytes are UTF-8; the Drain borrows the String mutably for\n        // '_, so nothing else changes them before its drop.\n        let text = unsafe { crate::str::from_utf8_unchecked(\n            crate::slice::from_raw_parts(p.add(start), end - start)) };\n        Drain { string: self as *mut String<A>, start: start, end: end, iter: text.chars() }\n    }\n\n    // The text from byte at on, as a new String on a clone of A.\n    #[effects(panic, A)]\n    pub fn split_off(&mut self, at: usize) -> String<A>\n        where\n            A: Clone,\n            requires self.as_str().is_char_boundary(at)\n    {\n        crate::panic::assert(self.is_char_boundary(at), \"String::split_off: not a char boundary\");\n        String { vec: self.vec.split_off(at) }\n    }\n\n");
    buf_str(out, c"    // Replaces the bytes in range with s.\n    #[effects(panic, A, R)]\n    pub fn replace_range<R: RangeBounds<usize>>(&mut self, range: R, s: &str) {\n        let (start, end) = range_of(&range, self.len());\n        crate::panic::assert(self.is_char_boundary(start),\n            \"String::replace_range: start is not a char boundary\");\n        crate::panic::assert(self.is_char_boundary(end),\n            \"String::replace_range: end is not a char boundary\");\n        self.vec.drain(start..end);\n        self.insert_bytes(start, s.as_bytes());\n    }\n\n    // Appends a copy of its own bytes in src.\n    #[effects(A, R)]\n    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {\n        self.vec.extend_from_within(src)\n    }\n\n    // bytes put in at byte i, the ones after it moved up (insert's and\n    // replace_range's; the caller checks that i is a char boundary).\n    fn insert_bytes(&mut self, i: usize, bytes: &[u8]) {\n        let n = bytes.len();\n        self.vec.extend_from_slice(bytes);\n        self.vec.as_mut_slice()[i..].rotate_right(n);\n    }\n\n    // A copy on another allocator.\n    #[effects(A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> String<B> {\n        String::from_in(self.as_str(), b)\n    }\n\n    // The text, never freed.\n    #[effects(A)]\n    pub fn leak<'a>(self) -> &'a mut str\n        where\n            A: 'a,\n    {\n        let bytes = self.vec.leak();\n        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's\n        // str::from_utf8_unchecked_mut).\n        // SAFETY: a String's bytes are UTF-8, and a str is laid out as a [u8].\n        unsafe { &mut *(bytes as *mut [u8] as *mut str) }\n    }\n\n    // Moves the String out, leaving an empty one on a clone of its allocator.\n    #[effects(A)]\n    pub fn take(&mut self) -> String<A>\n        where\n            A: Clone,\n    {\n        String { vec: self.vec.take() }\n    }\n}\n\nimpl<A: Allocator> Deref for String<A> {\n    type Target = str;\n");
    buf_str(out, c"\n    fn deref(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> DerefMut for String<A> {\n    fn deref_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\nimpl<I: SliceIndex<str>, A: Allocator> Index<I> for String<A> {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self.as_str())\n    }\n}\n\nimpl<I: SliceIndex<str>, A: Allocator> IndexMut<I> for String<A> {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self.as_mut_str())\n    }\n}\n\n// A copy on the same allocator (a clone of it).\n// std2: changed: needs A: Clone\nimpl<A: Allocator + Clone> Clone for String<A> {\n    fn clone(&self) -> String<A> {\n        String { vec: self.vec.clone() }\n    }\n}\n\n// mvs: String::impl Eq\n// std2: changed: PartialEq with any String<B>, str and &str\nimpl<A: Allocator, B: Allocator> PartialEq<String<B>> for String<A> {\n    fn eq(&self, other: &String<B>) -> bool {\n        self.as_str() == other.as_str()\n    }\n}\n\nimpl<A: Allocator> PartialEq<str> for String<A> {\n    fn eq(&self, other: &str) -> bool {\n        self.as_str() == other\n    }\n}\n\nimpl<'a, A: Allocator> PartialEq<&'a str> for String<A> {\n    fn eq(&self, other: &&'a str) -> bool {\n        self.as_str() == *other\n    }\n}\n\nimpl<A: Allocator> Eq for String<A> {}\n\nimpl<A: Allocator> PartialOrd for String<A> {\n    fn partial_cmp(&self, other: &String<A>) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\n// mvs: String::impl Ord\nimpl<A: Allocator> Ord for String<A> {\n    fn cmp(&self, other: &String<A>) -> Ordering {\n        self.as_str().cmp(other.as_str())\n    }\n}\n\n// As its str: the same for any A, so a HashMap<String<A>, V, A2> is\n// looked up by a &str (Borrow<str>).\n// mvs: String::impl Hash\nimpl<A: Allocator> Hash for String<A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.as_str().hash(state)\n    }\n}\n\n");
    buf_str(out, c"// mvs: String::impl Display\nimpl<A: Allocator> Display for String<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.as_str(), f)\n    }\n}\n\n// mvs: String::impl Debug\nimpl<A: Allocator> Debug for String<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.as_str(), f)\n    }\n}\n\n// `write(&mut s, \"{x}\")`: never fails (it grows from A).\n// mvs: String::push_fmt, Buf::push_fmt\nimpl<A: Allocator> Write for String<A> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.push_str(s);\n        Result::Ok(())\n    }\n}\n\nimpl<A: Allocator> Borrow<str> for String<A> {\n    fn borrow(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> BorrowMut<str> for String<A> {\n    fn borrow_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<str> for String<A> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<[u8]> for String<A> {\n    fn as_ref(&self) -> &[u8] {\n        self.as_bytes()\n    }\n}\n\nimpl<A: Allocator> AsMut<str> for String<A> {\n    fn as_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\n// `s + \"x\"`: s, grown from its own A.\nimpl<'b, A: Allocator> Add<&'b str> for String<A> {\n    type Output = String<A>;\n\n    fn add(self, other: &'b str) -> String<A> {\n        let mut s = self;\n        s.push_str(other);\n        s\n    }\n}\n\n// `s += \"x\"`.\nimpl<'b, A: Allocator> AddAssign<&'b str> for String<A> {\n    fn add_assign(&mut self, other: &'b str) {\n        self.push_str(other)\n    }\n}\n\nimpl<A: Allocator> Extend<char> for String<A> {\n    fn extend<I: IntoIterator<Item = char>>(&mut self, iter: I) {\n        for c in iter {\n            self.push(c);\n        }\n    }\n}\n\nimpl<'b, A: Allocator> Extend<&'b str> for String<A> {\n    fn extend<I: IntoIterator<Item = &'b str>>(&mut self, iter: I) {\n");
    buf_str(out, c"        for s in iter {\n            self.push_str(s);\n        }\n    }\n}\n\n// `chars.collect_in(a)` into a String.\nimpl<A: Allocator> FromIteratorIn<char, A> for String<A> {\n    fn from_iter_in<I: IntoIterator<Item = char>>(iter: I, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<'b, A: Allocator> FromIteratorIn<&'b str, A> for String<A> {\n    fn from_iter_in<I: IntoIterator<Item = &'b str>>(iter: I, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<A: Allocator> DefaultIn<A> for String<A> {\n    fn default_in(a: A) -> String<A> {\n        String::new_in(a)\n    }\n}\n\n// Why bytes are not a String: the error, and the bytes back.\n#[derive(Debug)]\npub struct FromUtf8Error<A: Allocator> {\n    bytes: Vec<u8, A>,\n    error: Utf8Error,\n}\n\nimpl<A: Allocator> FromUtf8Error<A> {\n    #[effects(A)]\n    pub fn as_bytes(&self) -> &[u8] {\n        self.bytes.as_slice()\n    }\n\n    #[effects()]\n    pub fn into_bytes(self) -> Vec<u8, A> {\n        self.bytes\n    }\n\n    #[effects()]\n    pub fn utf8_error(&self) -> Utf8Error {\n        self.error\n    }\n}\n\n// The start and end a range names in 0..len; panics when it is not in\n// it or ends before it starts.\nfn range_of<R: RangeBounds<usize>>(range: &R, len: usize) -> (usize, usize) {\n    let start = match range.start_bound() {\n        Bound::Included(s) => *s,\n        Bound::Excluded(s) => *s + 1,\n        Bound::Unbounded => 0,\n    };\n    let end = match range.end_bound() {\n        Bound::Included(e) => *e + 1,\n        Bound::Excluded(e) => *e,\n        Bound::Unbounded => len,\n    };\n    crate::panic::assert(start <= end && end <= len, \"String: range out of bounds\");\n    (start, end)\n}\n\n// String::drain's iterator: the removed chars.\npub struct Drain<'a, A: Allocator> {\n    string: *mut String<A>,\n    start: usize,\n    end: usize,\n    iter: Chars<'a>,\n");
    buf_str(out, c"}\n\n// UNSAFE: Drain reaches its String through a raw pointer: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the String for 'a; its bytes are\n// plain data, so it is Send and Sync as `&'a mut String<A>` is.\nunsafe impl<'a, A: Allocator + Send> Send for Drain<'a, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Drain` reads only the drained bytes.\nunsafe impl<'a, A: Allocator + Sync> Sync for Drain<'a, A> {}\n\nimpl<'a, A: Allocator> Iterator for Drain<'a, A> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        self.iter.next()\n    }\n}\n\nimpl<'a, A: Allocator> DoubleEndedIterator for Drain<'a, A> {\n    fn next_back(&mut self) -> Option<char> {\n        self.iter.next_back()\n    }\n}\n\nimpl<'a, A: Allocator> crate::ops::Drop for Drain<'a, A> {\n    fn drop(&mut self) {\n        // UNSAFE: the String is reached through the pointer drain took.\n        // SAFETY: the Drain borrowed the String mutably for its life, so the\n        // pointer is valid and nothing else uses the String; start..end was\n        // checked against its length and char boundaries at drain.\n        unsafe {\n            (*self.string).vec.drain(self.start..self.end);\n        }\n    }\n}\n\n// What can be written as text, written into a new String on a: Rust's\n// ToString with the allocator named. Every Display type has it\n// (`x.to_string_in(gpa)`, `format_args(\"{a}-{b}\").to_string_in(gpa)`).\npub trait ToStringIn<A: Allocator> {\n    fn to_string_in(&self, a: A) -> String<A>;\n}\n\n// later: blanket_impl\nimpl<T: Display + ?Sized, A: Allocator> ToStringIn<A> for T {\n    fn to_string_in(&self, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        let _ = s.write_fmt(self);\n        s\n    }\n}\n// ---- end mod std::string ----\n}\n// ---- mod std::hash ----\npub mod hash {\n// EDITION: rust\n// std::hash: Hash, Hasher, BuildHasher, and the hashers. Rust's shape:\n");
    buf_str(out, c"// a type feeds its parts to a Hasher (`x.hash(&mut h)`), and a map's\n// BuildHasher makes the Hasher. MVS's Hash (`hash(self) -> u64`, one\n// fixed function) is gone into it. The default, FixedState, is foldhash\n// with fixed seeds, so a map iterates in the same order in every run and\n// on every target (decision 2); a seeded one goes through\n// `HashMap::with_hasher_in(FixedState::with_seed(s), a)`, and\n// RandomState seeds from the OS: HashDoS is the guide's topic. The\n// numbers', bool's, char's and str's impls are built in or in their\n// modules; `#[derive(Hash)]` makes the others (`edition.later:\n// rust_derives`).\n\nuse crate::default::Default;\nuse crate::marker::PhantomData;\n\n// A value that can be hashed: equal values (Eq) feed equal input.\n// std2: changed: Rust's shape, hash<H: Hasher>(&self, &mut H) (MVS: hash(self) -> u64)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Hash {\n    // std2: changed: feeds a Hasher (MVS: returned a u64)\n    fn hash<H: Hasher>(&self, state: &mut H);\n\n    // Each element of data, in order.\n    fn hash_slice<H: Hasher>(data: &[Self], state: &mut H)\n        where\n            Self: Sized,\n    {\n        for x in data {\n            x.hash(state);\n        }\n    }\n}\n\n// What a Hash feeds; finish gives the hash.\npub trait Hasher {\n    fn finish(&self) -> u64;\n    fn write(&mut self, bytes: &[u8]);\n\n    fn write_u8(&mut self, i: u8) {\n        let b: [u8; 1] = [i];\n        self.write(&b[..])\n    }\n\n    // Its 2 bytes, little-endian (Rust's: native-endian, the same on\n    // every target of vole).\n    fn write_u16(&mut self, i: u16) {\n        let b: [u8; 2] = [i as u8, (i >> 8) as u8];\n        self.write(&b[..])\n    }\n\n    // Its 4 bytes, little-endian.\n    fn write_u32(&mut self, i: u32) {\n        let b: [u8; 4] = [i as u8, (i >> 8) as u8, (i >> 16) as u8, (i >> 24) as u8];\n        self.write(&b[..])\n    }\n\n    // Its 8 bytes, little-endian.\n");
    buf_str(out, c"    fn write_u64(&mut self, i: u64) {\n        let b = le_bytes(i);\n        self.write(&b[..])\n    }\n\n    fn write_usize(&mut self, i: usize) {\n        self.write_u64(i as u64)\n    }\n\n    fn write_i8(&mut self, i: i8) {\n        self.write_u8(i as u8)\n    }\n\n    fn write_i16(&mut self, i: i16) {\n        self.write_u16(i as u16)\n    }\n\n    fn write_i32(&mut self, i: i32) {\n        self.write_u32(i as u32)\n    }\n\n    fn write_i64(&mut self, i: i64) {\n        self.write_u64(i as u64)\n    }\n\n    fn write_isize(&mut self, i: isize) {\n        self.write_usize(i as usize)\n    }\n\n    // A slice's or a str's length, before its elements.\n    fn write_length_prefix(&mut self, len: usize) {\n        self.write_usize(len)\n    }\n}\n\n// What makes a map's Hashers: each one starts from the same state, so\n// equal keys hash equal.\npub trait BuildHasher {\n    type Hasher: Hasher;\n\n    fn build_hasher(&self) -> Self::Hasher;\n\n    // The hash of x with a new Hasher.\n    fn hash_one<T: Hash>(&self, x: T) -> u64 {\n        let mut h = self.build_hasher();\n        x.hash(&mut h);\n        h.finish()\n    }\n}\n\n// A BuildHasher for a Default Hasher type.\npub struct BuildHasherDefault<H> {\n    marker: PhantomData<fn() -> H>,\n}\n\nimpl<H: Default + Hasher> BuildHasher for BuildHasherDefault<H> {\n    type Hasher = H;\n\n    fn build_hasher(&self) -> H {\n        H::default()\n    }\n}\n\nimpl<H> Default for BuildHasherDefault<H> {\n    fn default() -> BuildHasherDefault<H> {\n        BuildHasherDefault { marker: PhantomData {} }\n    }\n}\n\n// x's 8 bytes, little-endian.\nfn le_bytes(x: u64) -> [u8; 8] {\n    [\n        x as u8,\n        (x >> 8) as u8,\n        (x >> 16) as u8,\n        (x >> 24) as u8,\n        (x >> 32) as u8,\n        (x >> 40) as u8,\n        (x >> 48) as u8,\n        (x >> 56) as u8,\n    ]\n}\n\n// The n bytes at b[i..i + n] (n <= 8) as a u64, little-endian.\nfn read_le(b: &[u8], i: usize, n: usize) -> u64 {\n");
    buf_str(out, c"    let mut x: u64 = 0;\n    let mut k: usize = 0;\n    while k < n {\n        x |= (b[i + k] as u64) << (8 * k) as u64;\n        k += 1;\n    }\n    x\n}\n\n// The high 64 bits of the 128-bit product a * b (vole has no u128): four\n// 32-bit products, none of which overflows.\nfn mul_hi(a: u64, b: u64) -> u64 {\n    let m: u64 = 0xffffffff;\n    let (a0, a1) = (a & m, a >> 32);\n    let (b0, b1) = (b & m, b >> 32);\n    let p00 = a0 * b0;\n    let p01 = a0 * b1;\n    let p10 = a1 * b0;\n    let p11 = a1 * b1;\n    let mid = (p00 >> 32) + (p01 & m) + (p10 & m);\n    p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n}\n\n// foldhash's folded multiply: the low and high halves of a * b, xor'ed.\nfn fold_mul(a: u64, b: u64) -> u64 {\n    a.wrapping_mul(b) ^ mul_hi(a, b)\n}\n\nfn rotate_right(x: u64, r: usize) -> u64 {\n    let k = (r & 63) as u64;\n    (x >> k) | (x << ((64 - k) & 63))\n}\n\nfn rotate_left(x: u64, r: u64) -> u64 {\n    (x << r) | (x >> (64 - r))\n}\n\n// foldhash's constants (hexadecimal digits of pi).\nconst FOLD_ARBITRARY3: u64 = 0x082efa98ec4e6c89;\nconst FOLD_ARBITRARY5: u64 = 0xbe5466cf34e90c6c;\n\n// foldhash with fixed seeds: HashMap's and HashSet's default S. The same\n// order in every run and on every target. Bit for bit the foldhash\n// crate's (0.2) fast FixedState.\n#[derive(Clone, Copy, Debug)]\npub struct FixedState {\n    seed: u64,\n}\n\nimpl FixedState {\n    // The fixed seed: foldhash's FixedState::default().\n    #[effects()]\n    pub fn new() -> FixedState {\n        FixedState { seed: FOLD_ARBITRARY3 }\n    }\n\n    // A seed of the program's choosing (a per-process secret against\n    // HashDoS, or a test's): foldhash's FixedState::with_seed.\n    #[effects()]\n    pub fn with_seed(seed: u64) -> FixedState {\n        FixedState { seed: seed ^ FOLD_ARBITRARY3 }\n    }\n}\n\n// mvs: FixedState::build_hasher\nimpl BuildHasher for FixedState {\n    type Hasher = FoldHasher;\n\n    fn build_hasher(&self) -> FoldHasher {\n");
    buf_str(out, c"        FoldHasher::with_seeds(self.seed, FoldSeeds::fixed())\n    }\n}\n\nimpl Default for FixedState {\n    fn default() -> FixedState {\n        FixedState::new()\n    }\n}\n\n// UNSAFE: the OS's random bytes, for RandomState's seeds.\n// SAFETY: getentropy fills the len (at most 256) bytes at buf, and returns\n// 0, or -1 with nothing promised of them. Its one caller passes an\n// array's pointer and length.\nextern \"C\" {\n    #[link_name = \"getentropy\"]\n    #[effects(io)]\n    fn c_getentropy(buf: *mut u8, len: usize) -> i32;\n}\n\n// 8 random bytes from the OS, as a u64.\nfn entropy() -> u64 {\n    let mut b: [u8; 8] = [0; 8];\n    // UNSAFE: the OS's getentropy.\n    // SAFETY: b is a local array of 8 writable bytes, borrowed for the\n    // call; 8 is within getentropy's 256.\n    let r = unsafe { c_getentropy(b.as_mut_ptr(), 8) };\n    if r != 0 {\n        let msg: &str = \"hash: the system gives no random bytes\";\n        crate::panic::panic(msg);\n    }\n    read_le(&b[..], 0, 8)\n}\n\n// foldhash seeded from the OS when it is made: not deterministic, so\n// never a default (decision 2).\n#[derive(Clone, Copy, Debug)]\npub struct RandomState {\n    seed: u64,\n    seeds: FoldSeeds,\n}\n\nimpl RandomState {\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn new() -> RandomState {\n        let seed = entropy();\n        RandomState { seed: seed, seeds: FoldSeeds::from_u64(entropy()) }\n    }\n}\n\n// mvs: RandomState::build_hasher\nimpl BuildHasher for RandomState {\n    type Hasher = FoldHasher;\n\n    fn build_hasher(&self) -> FoldHasher {\n        FoldHasher::with_seeds(self.seed, self.seeds)\n    }\n}\n\n// SipHash-1-3 with fixed keys (Rust's DefaultHasher's function, which is\n// SipHashState::with_keys(0, 0)), for tables that take untrusted keys\n// and want a keyed hash.\n#[derive(Clone, Copy, Debug)]\npub struct SipHashState {\n    k0: u64,\n    k1: u64,\n}\n\nimpl SipHashState {\n    #[effects()]\n");
    buf_str(out, c"    pub fn new() -> SipHashState {\n        SipHashState { k0: 0, k1: 0 }\n    }\n\n    #[effects()]\n    pub fn with_keys(k0: u64, k1: u64) -> SipHashState {\n        SipHashState { k0: k0, k1: k1 }\n    }\n}\n\n// mvs: SipHashState::build_hasher\nimpl BuildHasher for SipHashState {\n    type Hasher = SipHasher13;\n\n    fn build_hasher(&self) -> SipHasher13 {\n        SipHasher13::new_with_keys(self.k0, self.k1)\n    }\n}\n\n// foldhash (Orson Peters'), the default hasher's function: the foldhash\n// crate's (0.2) fast FoldHasher, bit for bit. An integer costs one\n// multiply at finish; integers written in a row share it, 128 bits at a\n// time (the sponge). Bytes are read 8 at a time, 16 to a multiply, with\n// overlapping reads at the ends, after a rotation of the state by their\n// length.\n#[derive(Clone, Debug)]\npub struct FoldHasher {\n    accumulator: u64,\n    // foldhash's 128-bit sponge, as two halves (vole has no u128).\n    sponge_lo: u64,\n    sponge_hi: u64,\n    sponge_len: u8,\n    seeds: FoldSeeds,\n}\n\n// The six seeds foldhash mixes with (its SharedSeed).\n#[derive(Clone, Copy, Debug)]\npub struct FoldSeeds {\n    s0: u64,\n    s1: u64,\n    s2: u64,\n    s3: u64,\n    s4: u64,\n    s5: u64,\n}\n\nimpl FoldSeeds {\n    // foldhash's fixed seeds.\n    #[effects()]\n    pub fn fixed() -> FoldSeeds {\n        FoldSeeds {\n            s0: 0xc0ac29b7c97c50dd,\n            s1: 0x3f84d5b5b5470917,\n            s2: 0x9216d5d98979fb1b,\n            s3: 0xd1310ba698dfb5ac,\n            s4: 0x2ffd72dbd01adfb7,\n            s5: 0xb8e1afed6a267e96,\n        }\n    }\n\n    // The seeds made from one u64 (foldhash's SharedSeed::from_u64).\n    #[effects()]\n    pub fn from_u64(seed: u64) -> FoldSeeds {\n        let a = fold_mix3(seed);\n        let b = fold_mix3(a);\n        let c = fold_mix3(b);\n        let d = fold_mix3(c);\n        let e = fold_mix3(d);\n        let f = fold_mix3(e);\n        // zeros are the multiply's weak point: some bits forced on\n");
    buf_str(out, c"        let ones: u64 = 0x8000000080000001;\n        FoldSeeds {\n            s0: a | ones,\n            s1: b | ones,\n            s2: c | ones,\n            s3: d | ones,\n            s4: e | ones,\n            s5: f | ones,\n        }\n    }\n}\n\nfn fold_mix3(x: u64) -> u64 {\n    fold_mul(fold_mul(fold_mul(x, FOLD_ARBITRARY5), FOLD_ARBITRARY5), FOLD_ARBITRARY5)\n}\n\n// foldhash's hash of 0 to 16 bytes into the accumulator.\nfn fold_bytes_short(b: &[u8], acc: u64, s1: u64) -> u64 {\n    let n = b.len();\n    let mut x = acc;\n    let mut y = s1;\n    if n >= 8 {\n        x ^= read_le(b, 0, 8);\n        y ^= read_le(b, n - 8, 8);\n    } else if n >= 4 {\n        x ^= read_le(b, 0, 4);\n        y ^= read_le(b, n - 4, 4);\n    } else if n > 0 {\n        x ^= b[0] as u64;\n        y ^= ((b[n - 1] as u64) << 8) | b[n / 2] as u64;\n    }\n    fold_mul(x, y)\n}\n\n// foldhash's hash of more than 16 bytes into the accumulator.\nfn fold_bytes_long(bytes: &[u8], acc: u64, seeds: FoldSeeds) -> u64 {\n    let k = seeds.s0;\n    // what is left is bytes[at..]: n bytes from at (a reslice `v = &v[96..]`\n    // would do, once the borrow checker takes it)\n    let mut at: usize = 0;\n    let mut n = bytes.len();\n    let v = bytes;\n    let mut s0 = acc;\n    let mut s1 = acc.wrapping_add(seeds.s1);\n    if n > 128 {\n        let mut s2 = acc.wrapping_add(seeds.s2);\n        let mut s3 = acc.wrapping_add(seeds.s3);\n        if n > 256 {\n            let mut s4 = acc.wrapping_add(seeds.s4);\n            let mut s5 = acc.wrapping_add(seeds.s5);\n            loop {\n                s0 = fold_mul(read_le(v, at, 8) ^ s0, read_le(v, at + 48, 8) ^ k);\n                s1 = fold_mul(read_le(v, at + 8, 8) ^ s1, read_le(v, at + 56, 8) ^ k);\n                s2 = fold_mul(read_le(v, at + 16, 8) ^ s2, read_le(v, at + 64, 8) ^ k);\n                s3 = fold_mul(read_le(v, at + 24, 8) ^ s3, read_le(v, at + 72, 8) ^ k);\n");
    buf_str(out, c"                s4 = fold_mul(read_le(v, at + 32, 8) ^ s4, read_le(v, at + 80, 8) ^ k);\n                s5 = fold_mul(read_le(v, at + 40, 8) ^ s5, read_le(v, at + 88, 8) ^ k);\n                at += 96;\n                n -= 96;\n                if n <= 256 {\n                    break;\n                }\n            }\n            s0 ^= s4;\n            s1 ^= s5;\n        }\n        loop {\n            s0 = fold_mul(read_le(v, at, 8) ^ s0, read_le(v, at + 32, 8) ^ k);\n            s1 = fold_mul(read_le(v, at + 8, 8) ^ s1, read_le(v, at + 40, 8) ^ k);\n            s2 = fold_mul(read_le(v, at + 16, 8) ^ s2, read_le(v, at + 48, 8) ^ k);\n            s3 = fold_mul(read_le(v, at + 24, 8) ^ s3, read_le(v, at + 56, 8) ^ k);\n            at += 64;\n            n -= 64;\n            if n <= 128 {\n                break;\n            }\n        }\n        s0 ^= s2;\n        s1 ^= s3;\n    }\n    let e = at + n;\n    s0 = fold_mul(read_le(v, at, 8) ^ s0, read_le(v, e - 16, 8) ^ k);\n    s1 = fold_mul(read_le(v, at + 8, 8) ^ s1, read_le(v, e - 8, 8) ^ k);\n    if n >= 32 {\n        s0 = fold_mul(read_le(v, at + 16, 8) ^ s0, read_le(v, e - 32, 8) ^ k);\n        s1 = fold_mul(read_le(v, at + 24, 8) ^ s1, read_le(v, e - 24, 8) ^ k);\n        if n >= 64 {\n            s0 = fold_mul(read_le(v, at + 32, 8) ^ s0, read_le(v, e - 48, 8) ^ k);\n            s1 = fold_mul(read_le(v, at + 40, 8) ^ s1, read_le(v, e - 40, 8) ^ k);\n            if n >= 96 {\n                s0 = fold_mul(read_le(v, at + 48, 8) ^ s0, read_le(v, e - 64, 8) ^ k);\n                s1 = fold_mul(read_le(v, at + 56, 8) ^ s1, read_le(v, e - 56, 8) ^ k);\n            }\n        }\n    }\n    s0 ^ s1\n}\n\nimpl FoldHasher {\n    // A hasher with the per-hasher seed and the shared seeds.\n    #[effects()]\n    pub fn with_seeds(seed: u64, seeds: FoldSeeds) -> FoldHasher {\n        FoldHasher { accumulator: seed, sponge_lo: 0, sponge_hi: 0, sponge_len: 0, seeds: seeds }\n    }\n\n");
    buf_str(out, c"    // bits bits of x into the sponge, multiplied in when it is full.\n    fn write_num(&mut self, x: u64, bits: usize) {\n        let len = self.sponge_len as usize;\n        if len + bits > 128 {\n            self.accumulator =\n                fold_mul(self.sponge_lo ^ self.accumulator, self.sponge_hi ^ self.seeds.s0);\n            self.sponge_lo = x;\n            self.sponge_hi = 0;\n            self.sponge_len = bits as u8;\n        } else {\n            if len < 64 {\n                self.sponge_lo |= x << len as u64;\n                if len > 0 && len + bits > 64 {\n                    self.sponge_hi |= x >> (64 - len) as u64;\n                }\n            } else {\n                self.sponge_hi |= x << (len - 64) as u64;\n            }\n            self.sponge_len = (len + bits) as u8;\n        }\n    }\n}\n\n// mvs: FoldHasher::write, FoldHasher::finish, FoldHasher::write_u8, FoldHasher::write_u16, FoldHasher::write_u32, FoldHasher::write_u64, FoldHasher::write_i64\n// std2: changed: the Hasher trait's methods (MVS: inherent)\nimpl Hasher for FoldHasher {\n    fn finish(&self) -> u64 {\n        if self.sponge_len > 0 {\n            fold_mul(self.sponge_lo ^ self.accumulator, self.sponge_hi ^ self.seeds.s0)\n        } else {\n            self.accumulator\n        }\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        let acc = rotate_right(self.accumulator, bytes.len());\n        if bytes.len() <= 16 {\n            self.accumulator = fold_bytes_short(bytes, acc, self.seeds.s1);\n        } else {\n            self.accumulator = fold_bytes_long(bytes, acc, self.seeds);\n        }\n    }\n\n    fn write_u8(&mut self, i: u8) {\n        self.write_num(i as u64, 8);\n    }\n\n    fn write_u16(&mut self, i: u16) {\n        self.write_num(i as u64, 16);\n    }\n\n    fn write_u32(&mut self, i: u32) {\n        self.write_num(i as u64, 32);\n    }\n\n    fn write_u64(&mut self, i: u64) {\n        self.write_num(i, 64);\n    }\n\n");
    buf_str(out, c"    fn write_usize(&mut self, i: usize) {\n        self.write_num(i as u64, 64);\n    }\n}\n\n// Rust's std::hash::DefaultHasher: SipHash-1-3 with the keys 0 and 0,\n// the same hash in every run.\n#[derive(Clone, Debug)]\npub struct DefaultHasher(SipHasher13);\n\nimpl DefaultHasher {\n    #[effects()]\n    pub fn new() -> DefaultHasher {\n        DefaultHasher(SipHasher13::new_with_keys(0, 0))\n    }\n}\n\nimpl Default for DefaultHasher {\n    fn default() -> DefaultHasher {\n        DefaultHasher::new()\n    }\n}\n\nimpl Hasher for DefaultHasher {\n    fn finish(&self) -> u64 {\n        self.0.finish()\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        self.0.write(bytes)\n    }\n}\n\n// SipHash-1-3 (Aumasson and Bernstein): Rust's DefaultHasher's function,\n// bit for bit. Bytes and integers are one stream: writing a u64 is\n// writing its 8 bytes, little-endian (the Hasher defaults).\n#[derive(Clone, Debug)]\npub struct SipHasher13 {\n    v0: u64,\n    v1: u64,\n    v2: u64,\n    v3: u64,\n    // the bytes after the last full 8, little-endian, and their count\n    tail: u64,\n    ntail: usize,\n    // all the bytes written\n    length: usize,\n}\n\nimpl SipHasher13 {\n    #[effects()]\n    pub fn new_with_keys(k0: u64, k1: u64) -> SipHasher13 {\n        SipHasher13 {\n            v0: k0 ^ 0x736f6d6570736575,\n            v1: k1 ^ 0x646f72616e646f6d,\n            v2: k0 ^ 0x6c7967656e657261,\n            v3: k1 ^ 0x7465646279746573,\n            tail: 0,\n            ntail: 0,\n            length: 0,\n        }\n    }\n\n    // One SipRound.\n    fn round(&mut self) {\n        self.v0 = self.v0.wrapping_add(self.v1);\n        self.v1 = rotate_left(self.v1, 13);\n        self.v1 ^= self.v0;\n        self.v0 = rotate_left(self.v0, 32);\n        self.v2 = self.v2.wrapping_add(self.v3);\n        self.v3 = rotate_left(self.v3, 16);\n        self.v3 ^= self.v2;\n        self.v0 = self.v0.wrapping_add(self.v3);\n        self.v3 = rotate_left(self.v3, 21);\n");
    buf_str(out, c"        self.v3 ^= self.v0;\n        self.v2 = self.v2.wrapping_add(self.v1);\n        self.v1 = rotate_left(self.v1, 17);\n        self.v1 ^= self.v2;\n        self.v2 = rotate_left(self.v2, 32);\n    }\n\n    // The message word m, compressed in (one round: SipHash-1-3).\n    fn compress(&mut self, m: u64) {\n        self.v3 ^= m;\n        self.round();\n        self.v0 ^= m;\n    }\n}\n\n// mvs: SipHasher13::write, SipHasher13::finish, SipHasher13::write_u8, SipHasher13::write_u16, SipHasher13::write_u32, SipHasher13::write_u64, SipHasher13::write_i64\n// std2: changed: the Hasher trait's methods (MVS: inherent)\nimpl Hasher for SipHasher13 {\n    // The hash of what was written (the hasher is unchanged).\n    fn finish(&self) -> u64 {\n        let mut s = self.clone();\n        let b = (((self.length as u64) & 0xff) << 56) | self.tail;\n        s.compress(b);\n        s.v2 ^= 0xff;\n        s.round();\n        s.round();\n        s.round();\n        s.v0 ^ s.v1 ^ s.v2 ^ s.v3\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        let n = bytes.len();\n        self.length += n;\n        let mut i: usize = 0;\n        if self.ntail != 0 {\n            let needed = 8 - self.ntail;\n            let take = if n < needed { n } else { needed };\n            self.tail |= read_le(bytes, 0, take) << (8 * self.ntail) as u64;\n            if n < needed {\n                self.ntail += n;\n                return;\n            }\n            let t = self.tail;\n            self.compress(t);\n            self.ntail = 0;\n            i = needed;\n        }\n        while n - i >= 8 {\n            self.compress(read_le(bytes, i, 8));\n            i += 8;\n        }\n        self.tail = read_le(bytes, i, n - i);\n        self.ntail = n - i;\n    }\n}\n\n// A reference hashes as what it refers to.\nimpl<T: Hash + ?Sized> Hash for &T {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (**self).hash(state)\n    }\n}\n\nimpl<T: Hash + ?Sized> Hash for &mut T {\n");
    buf_str(out, c"    fn hash<H: Hasher>(&self, state: &mut H) {\n        (**self).hash(state)\n    }\n}\n\nimpl Hash for () {\n    fn hash<H: Hasher>(&self, state: &mut H) {}\n}\n\n// A tuple hashes its fields in order, as Rust's.\nimpl<A: Hash> Hash for (A,) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash> Hash for (A, B) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash> Hash for (A, B, C) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash, D: Hash> Hash for (A, B, C, D) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n        self.3.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash> Hash for (A, B, C, D, E) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n        self.3.hash(state);\n        self.4.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash> Hash for (A, B, C, D, E, F) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n        self.3.hash(state);\n        self.4.hash(state);\n        self.5.hash(state);\n    }\n}\n// ---- end mod std::hash ----\n}\n// ---- mod std::collections ----\npub mod collections {\n// EDITION: rust\n// std::collections: HashMap, HashSet, BTreeMap, BTreeSet, BinaryHeap and\n// MinHeap.\n\npub mod binary_heap;\npub mod btree_map;\npub mod hash_map;\npub mod hash_set;\n\npub use binary_heap::{BinaryHeap, MinHeap};\npub use btree_map::{BTreeMap, BTreeSet};\npub use hash_map::HashMap;\npub use hash_set::HashSet;\n\n");
    buf_str(out, c"// Why try_reserve failed: the capacity overflowed, or the allocator.\n#[derive(Clone, PartialEq, Eq, Debug)]\npub enum TryReserveError {\n    CapacityOverflow,\n    AllocError { layout: crate::alloc::Layout },\n}\n// ---- mod std::collections::binary_heap ----\npub mod binary_heap {\n// EDITION: rust\n// std::collections::binary_heap (0.18.1; std2 0.28.0): priority queues in\n// a Vec. `BinaryHeap` is Rust's, a max-heap: `pop` takes the largest\n// element first. `MinHeap`, vole's own, has the same API and takes the\n// smallest first (Rust spells it `BinaryHeap<Reverse<T>>`, which works\n// too). `push` and `pop` are O(log n), building one from a Vec O(n).\n// mvs: std::BinaryHeap, std::MinHeap\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::cmp::Ord;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Formatter};\nuse crate::iter::{Extend, IntoIterator, Iterator};\nuse crate::option::Option;\nuse crate::slice::Iter;\nuse crate::vec::Vec;\n\n// (The helpers are named heap_*: the lazy std reads items by name, and a\n// free `push` or `sort` here would be read by every program.)\n\n// Which of two elements a heap keeps nearer the root.\ntrait HeapOrder {\n    fn above<T: Ord>(a: &T, b: &T) -> bool;\n}\n\nstruct HeapMax {}\n\nstruct HeapMin {}\n\nimpl HeapOrder for HeapMax {\n    #[inline]\n    fn above<T: Ord>(a: &T, b: &T) -> bool {\n        *a > *b\n    }\n}\n\nimpl HeapOrder for HeapMin {\n    #[inline]\n    fn above<T: Ord>(a: &T, b: &T) -> bool {\n        *a < *b\n    }\n}\n\n// Moves v[i] towards the root while it is above its parent.\nfn sift_up<T: Ord, O: HeapOrder>(v: &mut [T], i: usize) {\n    let mut i = i;\n    while i > 0 {\n        let parent = (i - 1) / 2;\n        if !O::above(&v[i], &v[parent]) {\n            break;\n        }\n        v.swap(i, parent);\n        i = parent;\n    }\n}\n\n// Moves v[i] down while a child of it in v[..end] is above it.\nfn sift_down<T: Ord, O: HeapOrder>(v: &mut [T], i: usize, end: usize) {\n");
    buf_str(out, c"    let mut i = i;\n    loop {\n        let mut child = 2 * i + 1;\n        if child >= end {\n            break;\n        }\n        if child + 1 < end && O::above(&v[child + 1], &v[child]) {\n            child += 1;\n        }\n        if !O::above(&v[child], &v[i]) {\n            break;\n        }\n        v.swap(i, child);\n        i = child;\n    }\n}\n\n// Makes v a heap, in O(n).\nfn heap_build<T: Ord, O: HeapOrder>(v: &mut [T]) {\n    let n = v.len();\n    let mut k = n / 2;\n    while k > 0 {\n        k -= 1;\n        sift_down::<T, O>(v, k, n);\n    }\n}\n\nfn heap_push<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>, x: T) {\n    v.push(x);\n    let n = v.len();\n    sift_up::<T, O>(v.as_mut_slice(), n - 1);\n}\n\nfn heap_pop<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>) -> Option<T> {\n    let n = v.len();\n    if n == 0 {\n        return Option::None;\n    }\n    v.as_mut_slice().swap(0, n - 1);\n    let top = v.pop();\n    sift_down::<T, O>(v.as_mut_slice(), 0, n - 1);\n    top\n}\n\n// The heap in v sorted in place: the root's end of the order last.\nfn heap_sort<T: Ord, O: HeapOrder>(v: &mut [T]) {\n    let mut end = v.len();\n    while end > 1 {\n        end -= 1;\n        v.swap(0, end);\n        sift_down::<T, O>(v, 0, end);\n    }\n}\n\n// A max-heap on allocator A.\npub struct BinaryHeap<T: Ord, A: Allocator> {\n    data: Vec<T, A>,\n}\n\n// A min-heap on allocator A, BinaryHeap's API with the order reversed.\n// std2: kept: vole's own (Rust: BinaryHeap<Reverse<T>>)\npub struct MinHeap<T: Ord, A: Allocator> {\n    data: Vec<T, A>,\n}\n\nimpl<T: Ord, A: Allocator> BinaryHeap<T, A> {\n    // An empty heap.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::new_in(a) }\n    }\n\n    // An empty heap with room for cap elements.\n    #[effects(T, A)]\n    pub fn with_capacity_in(cap: usize, a: A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::with_capacity_in(cap, a) }\n    }\n\n");
    buf_str(out, c"    // A heap of v's elements, in O(n), on v's memory (Rust's\n    // `BinaryHeap::from(v)`).\n    #[effects(T, A)]\n    pub fn from_vec(v: Vec<T, A>) -> BinaryHeap<T, A> {\n        let mut data = v;\n        heap_build::<T, HeapMax>(data.as_mut_slice());\n        BinaryHeap { data: data }\n    }\n\n    #[effects(T, A)]\n    pub fn len(&self) -> usize {\n        self.data.len()\n    }\n\n    #[effects(T, A)]\n    pub fn is_empty(&self) -> bool {\n        self.data.len() == 0\n    }\n\n    // Adds x, in O(log n).\n    #[effects(T, A)]\n    pub fn push(&mut self, x: T) {\n        heap_push::<T, HeapMax, A>(&mut self.data, x);\n    }\n\n    // Takes the largest element out (None when empty), in O(log n).\n    #[effects(T, A)]\n    pub fn pop(&mut self) -> Option<T> {\n        heap_pop::<T, HeapMax, A>(&mut self.data)\n    }\n\n    // The largest element, which stays.\n    // std2: changed: Option<&T> (MVS: a copy)\n    #[effects(T, A)]\n    pub fn peek(&self) -> Option<&T> {\n        self.data.first()\n    }\n\n    // Drops the elements; the room stays.\n    #[effects(T, A)]\n    pub fn clear(&mut self) {\n        self.data.clear();\n    }\n\n    #[effects(T, A)]\n    pub fn capacity(&self) -> usize {\n        self.data.capacity()\n    }\n\n    // Room for extra more elements.\n    pub fn reserve(&mut self, extra: usize) {\n        self.data.reserve(extra);\n    }\n\n    // Its allocator.\n    // std2: changed: a &A (MVS: a copy)\n    pub fn allocator(&self) -> &A {\n        self.data.allocator()\n    }\n\n    // Its elements in heap order (the largest first, the rest in no useful\n    // order).\n    pub fn as_slice(&self) -> &[T] {\n        self.data.as_slice()\n    }\n\n    // Its elements, in heap order.\n    #[effects(T, A)]\n    pub fn iter(&self) -> Iter<'_, T> {\n        self.data.iter()\n    }\n\n    // Its elements in a Vec, in heap order, on the same memory.\n    pub fn into_vec(self) -> Vec<T, A> {\n        self.data\n    }\n\n");
    buf_str(out, c"    // Its elements in a Vec, smallest first, on the same memory: a\n    // heapsort, in O(n log n).\n    #[effects(T, A)]\n    pub fn into_sorted_vec(self) -> Vec<T, A> {\n        let mut v = self.data;\n        heap_sort::<T, HeapMax>(v.as_mut_slice());\n        v\n    }\n\n    // Moves other's elements into it, leaving other empty.\n    #[effects(diverge, T, A)]\n    pub fn append(&mut self, other: &mut BinaryHeap<T, A>) {\n        while let Option::Some(x) = other.data.pop() {\n            self.push(x);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> MinHeap<T, A> {\n    // An empty heap.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> MinHeap<T, A> {\n        MinHeap { data: Vec::new_in(a) }\n    }\n\n    // An empty heap with room for cap elements.\n    pub fn with_capacity_in(cap: usize, a: A) -> MinHeap<T, A> {\n        MinHeap { data: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A heap of v's elements, in O(n), on v's memory.\n    #[effects(T, A)]\n    pub fn from_vec(v: Vec<T, A>) -> MinHeap<T, A> {\n        let mut data = v;\n        heap_build::<T, HeapMin>(data.as_mut_slice());\n        MinHeap { data: data }\n    }\n\n    #[effects(T, A)]\n    pub fn len(&self) -> usize {\n        self.data.len()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.data.len() == 0\n    }\n\n    // Adds x, in O(log n).\n    #[effects(T, A)]\n    pub fn push(&mut self, x: T) {\n        heap_push::<T, HeapMin, A>(&mut self.data, x);\n    }\n\n    // Takes the smallest element out (None when empty), in O(log n).\n    #[effects(T, A)]\n    pub fn pop(&mut self) -> Option<T> {\n        heap_pop::<T, HeapMin, A>(&mut self.data)\n    }\n\n    // The smallest element, which stays.\n    // std2: changed: Option<&T> (MVS: a copy)\n    #[effects(T, A)]\n    pub fn peek(&self) -> Option<&T> {\n        self.data.first()\n    }\n\n    // Drops the elements; the room stays.\n    pub fn clear(&mut self) {\n        self.data.clear();\n    }\n\n");
    buf_str(out, c"    pub fn capacity(&self) -> usize {\n        self.data.capacity()\n    }\n\n    // Room for extra more elements.\n    pub fn reserve(&mut self, extra: usize) {\n        self.data.reserve(extra);\n    }\n\n    // Its allocator.\n    // std2: changed: a &A (MVS: a copy)\n    pub fn allocator(&self) -> &A {\n        self.data.allocator()\n    }\n\n    // Its elements in heap order (the smallest first, the rest in no\n    // useful order).\n    pub fn as_slice(&self) -> &[T] {\n        self.data.as_slice()\n    }\n\n    // Its elements, in heap order.\n    pub fn iter(&self) -> Iter<'_, T> {\n        self.data.iter()\n    }\n\n    // Its elements in a Vec, in heap order, on the same memory.\n    pub fn into_vec(self) -> Vec<T, A> {\n        self.data\n    }\n\n    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same\n    // memory, in O(n log n).\n    #[effects(T, A)]\n    pub fn into_sorted_vec(self) -> Vec<T, A> {\n        let mut v = self.data;\n        heap_sort::<T, HeapMin>(v.as_mut_slice());\n        v.as_mut_slice().reverse();\n        v\n    }\n\n    // Moves other's elements into it, leaving other empty.\n    pub fn append(&mut self, other: &mut MinHeap<T, A>) {\n        while let Option::Some(x) = other.data.pop() {\n            self.push(x);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> From<Vec<T, A>> for BinaryHeap<T, A> {\n    fn from(v: Vec<T, A>) -> BinaryHeap<T, A> {\n        BinaryHeap::from_vec(v)\n    }\n}\n\nimpl<T: Ord, A: Allocator> From<Vec<T, A>> for MinHeap<T, A> {\n    fn from(v: Vec<T, A>) -> MinHeap<T, A> {\n        MinHeap::from_vec(v)\n    }\n}\n\nimpl<T: Ord, A: Allocator> Extend<T> for BinaryHeap<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> Extend<T> for MinHeap<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n");
    buf_str(out, c"        }\n    }\n}\n\n// A copy on the same allocator.\nimpl<T: Ord + Clone, A: Allocator + Clone> Clone for BinaryHeap<T, A> {\n    fn clone(&self) -> BinaryHeap<T, A> {\n        BinaryHeap { data: self.data.clone() }\n    }\n}\n\nimpl<T: Ord + Clone, A: Allocator + Clone> Clone for MinHeap<T, A> {\n    fn clone(&self) -> MinHeap<T, A> {\n        MinHeap { data: self.data.clone() }\n    }\n}\n\n// Its elements in heap order, as a list (Rust's).\nimpl<T: Ord + Debug, A: Allocator> Debug for BinaryHeap<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.data.as_slice(), f)\n    }\n}\n\nimpl<T: Ord + Debug, A: Allocator> Debug for MinHeap<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.data.as_slice(), f)\n    }\n}\n\n// `for x in &heap`: its elements, in heap order.\nimpl<'a, T: Ord, A: Allocator> IntoIterator for &'a BinaryHeap<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.data.iter()\n    }\n}\n\nimpl<'a, T: Ord, A: Allocator> IntoIterator for &'a MinHeap<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.data.iter()\n    }\n}\n// ---- end mod std::collections::binary_heap ----\n}\n// ---- mod std::collections::btree_map ----\npub mod btree_map {\n// EDITION: rust\n// std::collections::btree_map (0.15.4; std2 0.28.0): `BTreeMap`, a map\n// that keeps its keys sorted, and `BTreeSet` over it. Rust's API with the\n// allocator named: `BTreeMap::new_in(a)`. A B-tree: a node holds 5 to 11\n// keys (the root 1 to 11) in order and, when it is not a leaf, one child\n// more than keys; every leaf is at the same depth. The nodes live in one\n// Vec and name each other by index, so the whole map is safe code and one\n// allocation that grows; a slot is `Option`, None when it is unused.\n");
    buf_str(out, c"// `get`, `insert` and `remove` are O(log n); `iter` and `range` visit the\n// keys in order, from either end.\n//\n// Not Rust's: `range` gives the type `iter` gives (BTreeIter), `entry`'s\n// types are BTreeEntry, BTreeOccupiedEntry and BTreeVacantEntry, and there\n// is no `iter_mut`, `values_mut`, `retain`, `append`, `split_off` or\n// cursor yet; a set has no `union`, `intersection` or `difference` yet.\n// (The names carry `BTree`: the lazy std reads items by name, and an\n// `Iter` or an `Entry` here would be read with HashMap's.)\n// mvs: std::BTreeMap, std::BTreeSet\n\nuse crate::alloc::Allocator;\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::ops::{Bound, Index, RangeBounds};\nuse crate::option::Option;\nuse crate::vec::Vec;\n\n// The keys a node holds at most, and at least (but the root).\nconst B_CAP: usize = 11;\nconst B_MIN: usize = 5;\n// No node: an empty map's root, the end of the free list.\nconst B_NONE: u32 = 0xffffffff;\n\n// A node: keys[..len] in order with their values, and, when it is not a\n// leaf, kids[..len + 1], the nodes around them (kids[i]'s keys are less\n// than keys[i], kids[i + 1]'s greater). The slots from len on are None.\nstruct BNode<K, V> {\n    len: usize,\n    leaf: bool,\n    keys: [Option<K>; 11],\n    vals: [Option<V>; 11],\n    kids: [u32; 12],\n}\n\nfn b_node<K, V>(leaf: bool) -> BNode<K, V> {\n    BNode {\n        len: 0,\n        leaf: leaf,\n        keys: [None, None, None, None, None, None, None, None, None, None, None],\n        vals: [None, None, None, None, None, None, None, None, None, None, None],\n        kids: [B_NONE; 12],\n    }\n}\n\n// How a lookup's key compares with a map's: a K itself (BDirect), or the Q\n");
    buf_str(out, c"// that K lends (BBorrowed: a `&str` for String keys). Two types with one\n// method, not K's Borrow alone: a lookup by the key's own type would ask\n// for `K: Borrow<K>`, which the front resolves to `&T: Borrow<T>` for a K\n// that is a reference.\ntrait BCompare<K> {\n    fn order(&self, k: &K) -> Ordering;\n}\n\nstruct BDirect<'a, K> {\n    key: &'a K,\n}\n\nimpl<'a, K: Ord> BCompare<K> for BDirect<'a, K> {\n    #[inline]\n    fn order(&self, k: &K) -> Ordering {\n        self.key.cmp(k)\n    }\n}\n\nstruct BBorrowed<'a, Q: ?Sized> {\n    key: &'a Q,\n}\n\nimpl<'a, K: Borrow<Q>, Q: ?Sized + Ord> BCompare<K> for BBorrowed<'a, Q> {\n    #[inline]\n    fn order(&self, k: &K) -> Ordering {\n        self.key.cmp(<K as Borrow<Q>>::borrow(k))\n    }\n}\n\n// Where key is among node's keys: (i, true) when keys[i] is it, else\n// (i, false) with i the child to look in (the keys before i are less).\n#[inline]\nfn b_find<K, V, C: BCompare<K>>(node: &BNode<K, V>, key: &C) -> (usize, bool) {\n    let mut i = 0;\n    while i < node.len {\n        match &node.keys[i] {\n            Some(k) => match key.order(k) {\n                Ordering::Less => return (i, false),\n                Ordering::Equal => return (i, true),\n                Ordering::Greater => {}\n            },\n            None => {}\n        }\n        i += 1;\n    }\n    (i, false)\n}\n\n// A key's position: the nodes from the root down to its node, and at each\n// the child taken (at the last, the key's index). depth 0 is the end,\n// after the last key.\n#[derive(Clone, Copy)]\nstruct BCursor {\n    depth: usize,\n    node: [u32; 16],\n    at: [u8; 16],\n}\n\nfn b_end() -> BCursor {\n    BCursor { depth: 0, node: [B_NONE; 16], at: [0; 16] }\n}\n\nfn b_same(a: &BCursor, b: &BCursor) -> bool {\n    if a.depth != b.depth {\n        return false;\n    }\n    if a.depth == 0 {\n        return true;\n    }\n    let d = a.depth - 1;\n    a.node[d] == b.node[d] && a.at[d] == b.at[d]\n}\n\n");
    buf_str(out, c"// A map from K to V with its keys in order, on allocator A.\npub struct BTreeMap<K, V, A: Allocator> {\n    nodes: Vec<BNode<K, V>, A>,\n    root: u32,\n    // the first unused slot of nodes; each names the next in its kids[0]\n    free: u32,\n    len: usize,\n}\n\nimpl<K, V, A: Allocator> BTreeMap<K, V, A> {\n    // An empty map on a; allocates at the first insert.\n    #[effects(K, V, A)]\n    pub fn new_in(a: A) -> BTreeMap<K, V, A> {\n        BTreeMap { nodes: Vec::new_in(a), root: B_NONE, free: B_NONE, len: 0 }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.len\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.len == 0\n    }\n\n    #[effects(K, V, A)]\n    pub fn allocator(&self) -> &A {\n        self.nodes.allocator()\n    }\n\n    // Drops every entry; keeps the nodes' memory.\n    #[effects(K, V, A)]\n    pub fn clear(&mut self) {\n        self.nodes.clear();\n        self.root = B_NONE;\n        self.free = B_NONE;\n        self.len = 0;\n    }\n\n    // The entries in the keys' order.\n    #[effects(K, V, A)]\n    pub fn iter(&self) -> BTreeIter<'_, K, V, A> {\n        BTreeIter { map: self, front: self.cursor_first(), back: b_end() }\n    }\n\n    #[effects(K, V, A)]\n    pub fn keys(&self) -> BTreeKeys<'_, K, V, A> {\n        BTreeKeys { inner: self.iter() }\n    }\n\n    #[effects(K, V, A)]\n    pub fn values(&self) -> BTreeValues<'_, K, V, A> {\n        BTreeValues { inner: self.iter() }\n    }\n\n    // The entry with the smallest key.\n    #[effects(K, V, A)]\n    pub fn first_key_value(&self) -> Option<(&K, &V)> {\n        self.iter().next()\n    }\n\n    // The entry with the largest key.\n    #[effects(K, V, A)]\n    pub fn last_key_value(&self) -> Option<(&K, &V)> {\n        self.iter().next_back()\n    }\n\n    fn new_node(&mut self, leaf: bool) -> u32 {\n        if self.free != B_NONE {\n            let n = self.free;\n            let node = &mut self.nodes[n as usize];\n");
    buf_str(out, c"            self.free = node.kids[0];\n            node.leaf = leaf;\n            node.len = 0;\n            return n;\n        }\n        self.nodes.push(b_node(leaf));\n        (self.nodes.len() - 1) as u32\n    }\n\n    // (n's slots are None by now: its entries moved out)\n    fn free_node(&mut self, n: u32) {\n        let node = &mut self.nodes[n as usize];\n        node.kids[0] = self.free;\n        node.len = 0;\n        self.free = n;\n    }\n\n    // The entry at a cursor that is not the end.\n    fn entry_at(&self, c: &BCursor) -> (&K, &V) {\n        let d = c.depth - 1;\n        let node = &self.nodes[c.node[d] as usize];\n        let i = c.at[d] as usize;\n        (node.keys[i].as_ref().unwrap(), node.vals[i].as_ref().unwrap())\n    }\n\n    // The first key's position (the end when the map is empty).\n    fn cursor_first(&self) -> BCursor {\n        let mut c = b_end();\n        let mut n = self.root;\n        let mut d = 0;\n        while n != B_NONE {\n            c.node[d] = n;\n            c.at[d] = 0;\n            d += 1;\n            let node = &self.nodes[n as usize];\n            n = if node.leaf { B_NONE } else { node.kids[0] };\n        }\n        c.depth = d;\n        c\n    }\n\n    // c, which is not the end, moved to the next key (or the end).\n    fn cursor_next(&self, c: &mut BCursor) {\n        let d = c.depth - 1;\n        let node = &self.nodes[c.node[d] as usize];\n        let i = c.at[d] as usize;\n        if !node.leaf {\n            // the smallest key of the child after it\n            c.at[d] = (i + 1) as u8;\n            let mut n = node.kids[i + 1];\n            let mut e = d + 1;\n            while n != B_NONE {\n                c.node[e] = n;\n                c.at[e] = 0;\n                e += 1;\n                let below = &self.nodes[n as usize];\n                n = if below.leaf { B_NONE } else { below.kids[0] };\n            }\n            c.depth = e;\n            return;\n        }\n        if i + 1 < node.len {\n");
    buf_str(out, c"            c.at[d] = (i + 1) as u8;\n            return;\n        }\n        // the key after the child taken, at the nearest node that has one\n        let mut e = d;\n        while e > 0 {\n            e -= 1;\n            if (c.at[e] as usize) < self.nodes[c.node[e] as usize].len {\n                c.depth = e + 1;\n                return;\n            }\n        }\n        c.depth = 0;\n    }\n\n    // c moved to the key before it (from the end: to the last key). The\n    // caller knows there is one.\n    fn cursor_prev(&self, c: &mut BCursor) {\n        let mut n: u32;\n        let mut e: usize;\n        if c.depth == 0 {\n            n = self.root;\n            e = 0;\n        } else {\n            let d = c.depth - 1;\n            let node = &self.nodes[c.node[d] as usize];\n            let i = c.at[d] as usize;\n            if node.leaf {\n                if i > 0 {\n                    c.at[d] = (i - 1) as u8;\n                    return;\n                }\n                let mut up = d;\n                while up > 0 {\n                    up -= 1;\n                    if c.at[up] > 0 {\n                        c.at[up] -= 1;\n                        c.depth = up + 1;\n                        return;\n                    }\n                }\n                c.depth = 0;\n                return;\n            }\n            // the largest key of the child before it\n            n = node.kids[i];\n            e = d + 1;\n        }\n        while n != B_NONE {\n            let below = &self.nodes[n as usize];\n            c.node[e] = n;\n            if below.leaf {\n                c.at[e] = (below.len - 1) as u8;\n                n = B_NONE;\n            } else {\n                c.at[e] = below.len as u8;\n                n = below.kids[below.len];\n            }\n            e += 1;\n        }\n        c.depth = e;\n    }\n\n    // The by-value iterator's step: the entry at c moved out of its node.\n    fn take_at(&mut self, c: &BCursor) -> (K, V) {\n");
    buf_str(out, c"        let d = c.depth - 1;\n        let node = &mut self.nodes[c.node[d] as usize];\n        let i = c.at[d] as usize;\n        (node.keys[i].take().unwrap(), node.vals[i].take().unwrap())\n    }\n}\n\nimpl<K: Ord, V, A: Allocator> BTreeMap<K, V, A> {\n    // The node and index of key, or (B_NONE, 0).\n    fn locate<C: BCompare<K>>(&self, key: &C) -> (u32, usize) {\n        let mut n = self.root;\n        while n != B_NONE {\n            let node = &self.nodes[n as usize];\n            let (i, found) = b_find(node, key);\n            if found {\n                return (n, i);\n            }\n            n = if node.leaf { B_NONE } else { node.kids[i] };\n        }\n        (B_NONE, 0)\n    }\n\n    // The position of the first key that is not less than key (after: that\n    // is greater than key), or the end.\n    fn cursor_seek<C: BCompare<K>>(&self, key: &C, after: bool) -> BCursor {\n        let mut c = b_end();\n        let mut n = self.root;\n        let mut d = 0;\n        while n != B_NONE {\n            let node = &self.nodes[n as usize];\n            let (i, found) = b_find(node, key);\n            let i = if found && after { i + 1 } else { i };\n            c.node[d] = n;\n            c.at[d] = i as u8;\n            d += 1;\n            if found && !after {\n                c.depth = d;\n                return c;\n            }\n            n = if node.leaf { B_NONE } else { node.kids[i] };\n        }\n        // at the leaf, or the nearest node above with a key after the child\n        while d > 0 {\n            if (c.at[d - 1] as usize) < self.nodes[c.node[d - 1] as usize].len {\n                c.depth = d;\n                return c;\n            }\n            d -= 1;\n        }\n        c\n    }\n\n    // The value of key.\n    #[effects(panic, K, V, A, Q)]\n    pub fn get<Q: ?Sized + Ord>(&self, key: &Q) -> Option<&V>\n        where\n            K: Borrow<Q>,\n    {\n        let (n, i) = self.locate(&BBorrowed { key: key });\n");
    buf_str(out, c"        if n == B_NONE {\n            return None;\n        }\n        self.nodes[n as usize].vals[i].as_ref()\n    }\n\n    #[effects(panic, K, V, A, Q)]\n    pub fn get_key_value<Q: ?Sized + Ord>(&self, key: &Q) -> Option<(&K, &V)>\n        where\n            K: Borrow<Q>,\n    {\n        let (n, i) = self.locate(&BBorrowed { key: key });\n        if n == B_NONE {\n            return None;\n        }\n        let node = &self.nodes[n as usize];\n        Some((node.keys[i].as_ref().unwrap(), node.vals[i].as_ref().unwrap()))\n    }\n\n    #[effects(K, V, A, Q)]\n    pub fn contains_key<Q: ?Sized + Ord>(&self, key: &Q) -> bool\n        where\n            K: Borrow<Q>,\n    {\n        self.locate(&BBorrowed { key: key }).0 != B_NONE\n    }\n\n    #[effects(panic, K, V, A, Q)]\n    pub fn get_mut<Q: ?Sized + Ord>(&mut self, key: &Q) -> Option<&mut V>\n        where\n            K: Borrow<Q>,\n    {\n        let (n, i) = self.locate(&BBorrowed { key: key });\n        if n == B_NONE {\n            return None;\n        }\n        self.nodes[n as usize].vals[i].as_mut()\n    }\n\n    // Child i of p, which is full, split in two around its middle key,\n    // which moves up into p (p is not full).\n    fn split_child(&mut self, p: u32, i: usize) {\n        let c = self.nodes[p as usize].kids[i];\n        let leaf = self.nodes[c as usize].leaf;\n        let r = self.new_node(leaf);\n        let mut j = 0;\n        while j < B_MIN {\n            let k = self.nodes[c as usize].keys[j + B_MIN + 1].take();\n            let v = self.nodes[c as usize].vals[j + B_MIN + 1].take();\n            self.nodes[r as usize].keys[j] = k;\n            self.nodes[r as usize].vals[j] = v;\n            j += 1;\n        }\n        if !leaf {\n            j = 0;\n            while j <= B_MIN {\n                let kid = self.nodes[c as usize].kids[j + B_MIN + 1];\n                self.nodes[r as usize].kids[j] = kid;\n                j += 1;\n            }\n        }\n");
    buf_str(out, c"        self.nodes[r as usize].len = B_MIN;\n        let left = &mut self.nodes[c as usize];\n        left.len = B_MIN;\n        let mk = left.keys[B_MIN].take();\n        let mv = left.vals[B_MIN].take();\n        let up = &mut self.nodes[p as usize];\n        j = up.len;\n        while j > i {\n            up.keys[j] = up.keys[j - 1].take();\n            up.vals[j] = up.vals[j - 1].take();\n            up.kids[j + 1] = up.kids[j];\n            j -= 1;\n        }\n        up.keys[i] = mk;\n        up.vals[i] = mv;\n        up.kids[i + 1] = r;\n        up.len += 1;\n    }\n\n    // insert, which also says where the entry is: its node and index.\n    fn insert_at(&mut self, key: K, value: V) -> (u32, usize, Option<V>) {\n        if self.root == B_NONE {\n            let r = self.new_node(true);\n            self.root = r;\n        } else if self.nodes[self.root as usize].len == B_CAP {\n            let r = self.new_node(false);\n            self.nodes[r as usize].kids[0] = self.root;\n            self.root = r;\n            self.split_child(r, 0);\n        }\n        let mut n = self.root;\n        loop {\n            let (i, found) = b_find(&self.nodes[n as usize], &BDirect { key: &key });\n            if found {\n                let old = self.nodes[n as usize].vals[i].replace(value);\n                return (n, i, old);\n            }\n            if self.nodes[n as usize].leaf {\n                let node = &mut self.nodes[n as usize];\n                let mut j = node.len;\n                while j > i {\n                    node.keys[j] = node.keys[j - 1].take();\n                    node.vals[j] = node.vals[j - 1].take();\n                    j -= 1;\n                }\n                node.keys[i] = Some(key);\n                node.vals[i] = Some(value);\n                node.len += 1;\n                self.len += 1;\n                return (n, i, None);\n            }\n            let mut c = self.nodes[n as usize].kids[i];\n");
    buf_str(out, c"            if self.nodes[c as usize].len == B_CAP {\n                // a full child is split on the way down, so that a split\n                // below it has room here\n                self.split_child(n, i);\n                let node = &self.nodes[n as usize];\n                let (at, same) = b_find(node, &BDirect { key: &key });\n                if same {\n                    let old = self.nodes[n as usize].vals[at].replace(value);\n                    return (n, at, old);\n                }\n                c = node.kids[at];\n            }\n            n = c;\n        }\n    }\n\n    // Sets key's value; the value it had.\n    #[effects(unsafe, K, V, A)]\n    pub fn insert(&mut self, key: K, value: V) -> Option<V> {\n        self.insert_at(key, value).2\n    }\n\n    // Children i and i + 1 of p, each with the fewest keys, made one node\n    // (child i) around p's key i, which moves down.\n    fn merge(&mut self, p: u32, i: usize) {\n        let l = self.nodes[p as usize].kids[i];\n        let r = self.nodes[p as usize].kids[i + 1];\n        let up = &mut self.nodes[p as usize];\n        let mk = up.keys[i].take();\n        let mv = up.vals[i].take();\n        let mut j = i;\n        while j + 1 < up.len {\n            up.keys[j] = up.keys[j + 1].take();\n            up.vals[j] = up.vals[j + 1].take();\n            up.kids[j + 1] = up.kids[j + 2];\n            j += 1;\n        }\n        up.len -= 1;\n        let base = self.nodes[l as usize].len;\n        self.nodes[l as usize].keys[base] = mk;\n        self.nodes[l as usize].vals[base] = mv;\n        let count = self.nodes[r as usize].len;\n        j = 0;\n        while j < count {\n            let k = self.nodes[r as usize].keys[j].take();\n            let v = self.nodes[r as usize].vals[j].take();\n            self.nodes[l as usize].keys[base + 1 + j] = k;\n            self.nodes[l as usize].vals[base + 1 + j] = v;\n            j += 1;\n        }\n        if !self.nodes[l as usize].leaf {\n");
    buf_str(out, c"            j = 0;\n            while j <= count {\n                let kid = self.nodes[r as usize].kids[j];\n                self.nodes[l as usize].kids[base + 1 + j] = kid;\n                j += 1;\n            }\n        }\n        self.nodes[l as usize].len = base + 1 + count;\n        self.free_node(r);\n    }\n\n    // Child i of p, which has the fewest keys, given one more: from the\n    // sibling before or after it through p's key between them, or merged\n    // with one. Returns the node that holds the child's keys now.\n    fn fill(&mut self, p: u32, i: usize) -> u32 {\n        let c = self.nodes[p as usize].kids[i];\n        let plen = self.nodes[p as usize].len;\n        if i > 0 && self.nodes[self.nodes[p as usize].kids[i - 1] as usize].len > B_MIN {\n            let l = self.nodes[p as usize].kids[i - 1];\n            // c's entries one to the right, p's key down, l's last key up\n            let node = &mut self.nodes[c as usize];\n            let mut j = node.len;\n            while j > 0 {\n                node.keys[j] = node.keys[j - 1].take();\n                node.vals[j] = node.vals[j - 1].take();\n                j -= 1;\n            }\n            if !node.leaf {\n                j = node.len + 1;\n                while j > 0 {\n                    node.kids[j] = node.kids[j - 1];\n                    j -= 1;\n                }\n            }\n            node.len += 1;\n            let dk = self.nodes[p as usize].keys[i - 1].take();\n            let dv = self.nodes[p as usize].vals[i - 1].take();\n            self.nodes[c as usize].keys[0] = dk;\n            self.nodes[c as usize].vals[0] = dv;\n            let left = &mut self.nodes[l as usize];\n            let last = left.len - 1;\n            let uk = left.keys[last].take();\n            let uv = left.vals[last].take();\n            let kid = left.kids[last + 1];\n            left.len = last;\n            self.nodes[p as usize].keys[i - 1] = uk;\n");
    buf_str(out, c"            self.nodes[p as usize].vals[i - 1] = uv;\n            self.nodes[c as usize].kids[0] = kid;\n            return c;\n        }\n        if i < plen && self.nodes[self.nodes[p as usize].kids[i + 1] as usize].len > B_MIN {\n            let r = self.nodes[p as usize].kids[i + 1];\n            // p's key down to c's end, r's first key up, r's rest one left\n            let dk = self.nodes[p as usize].keys[i].take();\n            let dv = self.nodes[p as usize].vals[i].take();\n            let right = &mut self.nodes[r as usize];\n            let uk = right.keys[0].take();\n            let uv = right.vals[0].take();\n            let kid = right.kids[0];\n            let mut j = 0;\n            while j + 1 < right.len {\n                right.keys[j] = right.keys[j + 1].take();\n                right.vals[j] = right.vals[j + 1].take();\n                j += 1;\n            }\n            if !right.leaf {\n                j = 0;\n                while j < right.len {\n                    right.kids[j] = right.kids[j + 1];\n                    j += 1;\n                }\n            }\n            right.len -= 1;\n            self.nodes[p as usize].keys[i] = uk;\n            self.nodes[p as usize].vals[i] = uv;\n            let node = &mut self.nodes[c as usize];\n            let end = node.len;\n            node.keys[end] = dk;\n            node.vals[end] = dv;\n            node.kids[end + 1] = kid;\n            node.len = end + 1;\n            return c;\n        }\n        if i < plen {\n            self.merge(p, i);\n            return c;\n        }\n        self.merge(p, i - 1);\n        self.nodes[p as usize].kids[i - 1]\n    }\n\n    // The entry i of leaf n taken out. n is the root or has more than the\n    // fewest keys.\n    fn take_leaf(&mut self, n: u32, i: usize) -> (K, V) {\n        let node = &mut self.nodes[n as usize];\n        let k = node.keys[i].take();\n        let v = node.vals[i].take();\n        let mut j = i;\n");
    buf_str(out, c"        while j + 1 < node.len {\n            node.keys[j] = node.keys[j + 1].take();\n            node.vals[j] = node.vals[j + 1].take();\n            j += 1;\n        }\n        node.len -= 1;\n        (k.unwrap(), v.unwrap())\n    }\n\n    // Removes the smallest (largest) entry of the subtree of n, which is\n    // the root or has more than the fewest keys. On the way down each node\n    // entered is first given more than the fewest keys, so that taking one\n    // out never leaves it with too few.\n    fn remove_edge(&mut self, start: u32, largest: bool) -> (K, V) {\n        let mut n = start;\n        loop {\n            let node = &self.nodes[n as usize];\n            if node.leaf {\n                let i = if largest { node.len - 1 } else { 0 };\n                return self.take_leaf(n, i);\n            }\n            let i = if largest { node.len } else { 0 };\n            let c = node.kids[i];\n            n = if self.nodes[c as usize].len <= B_MIN { self.fill(n, i) } else { c };\n        }\n    }\n\n    // Removes key's entry from the subtree of n, as remove_edge goes down.\n    fn remove_below<C: BCompare<K>>(&mut self, start: u32, key: &C) -> Option<(K, V)> {\n        let mut n = start;\n        loop {\n            let node = &self.nodes[n as usize];\n            let (i, found) = b_find(node, key);\n            if node.leaf {\n                if !found {\n                    return None;\n                }\n                return Some(self.take_leaf(n, i));\n            }\n            if found {\n                // a key between two children: the entry before it (the\n                // left child's largest) or after it takes its place, when\n                // that child can give one; else the two become one node\n                // with the key in it, and the search goes on there\n                let l = node.kids[i];\n                let r = node.kids[i + 1];\n                let (rk, rv) = if self.nodes[l as usize].len > B_MIN {\n");
    buf_str(out, c"                    self.remove_edge(l, true)\n                } else if self.nodes[r as usize].len > B_MIN {\n                    self.remove_edge(r, false)\n                } else {\n                    self.merge(n, i);\n                    n = l;\n                    continue;\n                };\n                let node = &mut self.nodes[n as usize];\n                let k = node.keys[i].replace(rk);\n                let v = node.vals[i].replace(rv);\n                return Some((k.unwrap(), v.unwrap()));\n            }\n            let c = node.kids[i];\n            n = if self.nodes[c as usize].len <= B_MIN { self.fill(n, i) } else { c };\n        }\n    }\n\n    // After a removal: an empty root's one child is the root now (one\n    // level less), and an empty leaf root is no root.\n    fn shrink_root(&mut self) {\n        let root = self.root;\n        if self.nodes[root as usize].len == 0 {\n            self.root = if self.nodes[root as usize].leaf {\n                B_NONE\n            } else {\n                self.nodes[root as usize].kids[0]\n            };\n            self.free_node(root);\n        }\n    }\n\n    fn remove_with<C: BCompare<K>>(&mut self, key: &C) -> Option<(K, V)> {\n        if self.root == B_NONE {\n            return None;\n        }\n        let out = self.remove_below(self.root, key);\n        self.shrink_root();\n        if out.is_some() {\n            self.len -= 1;\n        }\n        out\n    }\n\n    fn pop_edge(&mut self, largest: bool) -> Option<(K, V)> {\n        if self.root == B_NONE {\n            return None;\n        }\n        let out = self.remove_edge(self.root, largest);\n        self.shrink_root();\n        self.len -= 1;\n        Some(out)\n    }\n\n    // Removes key; its value.\n    #[effects(K, V, A, Q)]\n    pub fn remove<Q: ?Sized + Ord>(&mut self, key: &Q) -> Option<V>\n        where\n            K: Borrow<Q>,\n    {\n        match self.remove_with(&BBorrowed { key: key }) {\n");
    buf_str(out, c"            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n\n    #[effects(K, V, A, Q)]\n    pub fn remove_entry<Q: ?Sized + Ord>(&mut self, key: &Q) -> Option<(K, V)>\n        where\n            K: Borrow<Q>,\n    {\n        self.remove_with(&BBorrowed { key: key })\n    }\n\n    // Removes the entry with the smallest key.\n    #[effects(K, V, A)]\n    pub fn pop_first(&mut self) -> Option<(K, V)> {\n        self.pop_edge(false)\n    }\n\n    // Removes the entry with the largest key.\n    #[effects(K, V, A)]\n    pub fn pop_last(&mut self) -> Option<(K, V)> {\n        self.pop_edge(true)\n    }\n\n    // The entries whose keys are in `range` (`a..b`, `a..=b`, `a..`, `..b`,\n    // `..`), in order. Panics when the range's start is after its end.\n    // (`m.range(..)` waits for the front: RangeFull's impl is for every T,\n    // and the T of this bound is not found; `iter` is the same entries.)\n    #[effects(panic, K, V, A, R)]\n    pub fn range<R: RangeBounds<K>>(&self, range: R) -> BTreeIter<'_, K, V, A> {\n        let mut lo: Option<&K> = None;\n        let front = match range.start_bound() {\n            Bound::Included(k) => {\n                lo = Some(k);\n                self.cursor_seek(&BDirect { key: k }, false)\n            }\n            Bound::Excluded(k) => {\n                lo = Some(k);\n                self.cursor_seek(&BDirect { key: k }, true)\n            }\n            Bound::Unbounded => self.cursor_first(),\n        };\n        let mut hi: Option<&K> = None;\n        let back = match range.end_bound() {\n            Bound::Included(k) => {\n                hi = Some(k);\n                self.cursor_seek(&BDirect { key: k }, true)\n            }\n            Bound::Excluded(k) => {\n                hi = Some(k);\n                self.cursor_seek(&BDirect { key: k }, false)\n            }\n            Bound::Unbounded => b_end(),\n        };\n        match (lo, hi) {\n            (Some(a), Some(b)) => if *a > *b {\n");
    buf_str(out, c"                crate::panic::panic(\"range start is greater than range end in BTreeMap\");\n            },\n            _ => {}\n        }\n        BTreeIter { map: self, front: front, back: back }\n    }\n\n    // key's place in the map, to read, fill or change in one lookup.\n    #[effects(K, V, A)]\n    pub fn entry(&mut self, key: K) -> BTreeEntry<'_, K, V, A> {\n        let (n, i) = self.locate(&BDirect { key: &key });\n        if n == B_NONE {\n            BTreeEntry::Vacant(BTreeVacantEntry { map: self, key: key })\n        } else {\n            BTreeEntry::Occupied(BTreeOccupiedEntry { map: self, key: key, node: n, at: i })\n        }\n    }\n\n    // A copy on allocator b.\n    #[effects(diverge, K, V, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> BTreeMap<K, V, B>\n        where\n            K: Clone,\n            V: Clone,\n    {\n        let mut m: BTreeMap<K, V, B> = BTreeMap::new_in(b);\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K: Ord + Clone, V: Clone, A: Allocator + Clone> Clone for BTreeMap<K, V, A> {\n    fn clone(&self) -> BTreeMap<K, V, A> {\n        self.clone_in(self.allocator().clone())\n    }\n}\n\n// The same entries.\nimpl<K: PartialEq, V: PartialEq, A: Allocator, B: Allocator> PartialEq<BTreeMap<K, V, B>>\n    for BTreeMap<K, V, A>\n    {\n    fn eq(&self, other: &BTreeMap<K, V, B>) -> bool {\n        if self.len != other.len {\n            return false;\n        }\n        let mut a = self.iter();\n        let mut b = other.iter();\n        loop {\n            match (a.next(), b.next()) {\n                (Some((k, v)), Some((l, w))) => if *k != *l || *v != *w {\n                    return false;\n                },\n                _ => return true,\n            }\n        }\n    }\n}\n\nimpl<K: Eq, V: Eq, A: Allocator> Eq for BTreeMap<K, V, A> {}\n\n// `{k: v, ...}`, in the keys' order.\n");
    buf_str(out, c"impl<K: Debug, V: Debug, A: Allocator> Debug for BTreeMap<K, V, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_map().entries(self.iter()).finish()\n    }\n}\n\n// `m[&k]`: the value; panics when k is not there.\nimpl<K: Ord + Borrow<Q>, Q: ?Sized + Ord, V, A: Allocator> Index<&Q> for BTreeMap<K, V, A> {\n    type Output = V;\n\n    fn index(&self, key: &Q) -> &V {\n        self.get(key).expect(\"no entry found for key\")\n    }\n}\n\nimpl<K: Ord, V, A: Allocator> Extend<(K, V)> for BTreeMap<K, V, A> {\n    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(k, v);\n        }\n    }\n}\n\n// `pairs.collect_in(a)`.\nimpl<K: Ord, V, A: Allocator> FromIteratorIn<(K, V), A> for BTreeMap<K, V, A> {\n    fn from_iter_in<I: IntoIterator<Item = (K, V)>>(iter: I, a: A) -> BTreeMap<K, V, A> {\n        let mut m: BTreeMap<K, V, A> = BTreeMap::new_in(a);\n        m.extend(iter);\n        m\n    }\n}\n\n// An empty map on a (`entry(k).or_default()` for map values).\nimpl<K, V, A: Allocator> DefaultIn<A> for BTreeMap<K, V, A> {\n    fn default_in(a: A) -> BTreeMap<K, V, A> {\n        BTreeMap::new_in(a)\n    }\n}\n\nimpl<K, V, A: Allocator> IntoIterator for BTreeMap<K, V, A> {\n    type Item = (K, V);\n    type IntoIter = BTreeIntoIter<K, V, A>;\n\n    fn into_iter(self) -> BTreeIntoIter<K, V, A> {\n        let front = self.cursor_first();\n        BTreeIntoIter { map: self, front: front, back: b_end() }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> IntoIterator for &'a BTreeMap<K, V, A> {\n    type Item = (&'a K, &'a V);\n    type IntoIter = BTreeIter<'a, K, V, A>;\n\n    fn into_iter(self) -> BTreeIter<'a, K, V, A> {\n        self.iter()\n    }\n}\n\n// ---- Iterators ----\n\n// The entries from `front` up to `back`, which is not one of them.\npub struct BTreeIter<'a, K, V, A: Allocator> {\n    map: &'a BTreeMap<K, V, A>,\n    front: BCursor,\n    back: BCursor,\n}\n\n");
    buf_str(out, c"impl<'a, K, V, A: Allocator> Clone for BTreeIter<'a, K, V, A> {\n    fn clone(&self) -> BTreeIter<'a, K, V, A> {\n        BTreeIter { map: self.map, front: self.front, back: self.back }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for BTreeIter<'a, K, V, A> {\n    type Item = (&'a K, &'a V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        let map: &'a BTreeMap<K, V, A> = self.map;\n        let item = map.entry_at(&self.front);\n        map.cursor_next(&mut self.front);\n        Some(item)\n    }\n}\n\nimpl<'a, K, V, A: Allocator> DoubleEndedIterator for BTreeIter<'a, K, V, A> {\n    fn next_back(&mut self) -> Option<(&'a K, &'a V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        let map: &'a BTreeMap<K, V, A> = self.map;\n        map.cursor_prev(&mut self.back);\n        Some(map.entry_at(&self.back))\n    }\n}\n\npub struct BTreeKeys<'a, K, V, A: Allocator> {\n    inner: BTreeIter<'a, K, V, A>,\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for BTreeKeys<'a, K, V, A> {\n    type Item = &'a K;\n\n    fn next(&mut self) -> Option<&'a K> {\n        match self.inner.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> DoubleEndedIterator for BTreeKeys<'a, K, V, A> {\n    fn next_back(&mut self) -> Option<&'a K> {\n        match self.inner.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\npub struct BTreeValues<'a, K, V, A: Allocator> {\n    inner: BTreeIter<'a, K, V, A>,\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for BTreeValues<'a, K, V, A> {\n    type Item = &'a V;\n\n    fn next(&mut self) -> Option<&'a V> {\n        match self.inner.next() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\n");
    buf_str(out, c"impl<'a, K, V, A: Allocator> DoubleEndedIterator for BTreeValues<'a, K, V, A> {\n    fn next_back(&mut self) -> Option<&'a V> {\n        match self.inner.next_back() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\n// A map's entries by value, in order; what is left is dropped with it.\npub struct BTreeIntoIter<K, V, A: Allocator> {\n    map: BTreeMap<K, V, A>,\n    front: BCursor,\n    back: BCursor,\n}\n\nimpl<K, V, A: Allocator> Iterator for BTreeIntoIter<K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        let item = self.map.take_at(&self.front);\n        self.map.cursor_next(&mut self.front);\n        Some(item)\n    }\n}\n\nimpl<K, V, A: Allocator> DoubleEndedIterator for BTreeIntoIter<K, V, A> {\n    fn next_back(&mut self) -> Option<(K, V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        self.map.cursor_prev(&mut self.back);\n        Some(self.map.take_at(&self.back))\n    }\n}\n\n// ---- Entry ----\n\n// A key's place in a map: Occupied (its entry is there) or Vacant.\npub enum BTreeEntry<'a, K, V, A: Allocator> {\n    Occupied(BTreeOccupiedEntry<'a, K, V, A>),\n    Vacant(BTreeVacantEntry<'a, K, V, A>),\n}\n\nimpl<'a, K: Ord, V, A: Allocator> BTreeEntry<'a, K, V, A> {\n    // The value, set to `default` first when the key was not there.\n    #[effects(K, V, A)]\n    pub fn or_insert(self, default: V) -> &'a mut V {\n        match self {\n            BTreeEntry::Occupied(e) => e.into_mut(),\n            BTreeEntry::Vacant(e) => e.insert(default),\n        }\n    }\n\n    #[effects(K, V, A, F)]\n    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &'a mut V {\n        match self {\n            BTreeEntry::Occupied(e) => e.into_mut(),\n            BTreeEntry::Vacant(e) => e.insert(f()),\n        }\n    }\n\n    #[effects(K, V, A)]\n");
    buf_str(out, c"    pub fn or_default(self) -> &'a mut V\n        where\n            V: Default,\n    {\n        match self {\n            BTreeEntry::Occupied(e) => e.into_mut(),\n            BTreeEntry::Vacant(e) => e.insert(V::default()),\n        }\n    }\n\n    // The entry, its value changed by f when the key is there.\n    #[effects(K, V, A, F)]\n    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> BTreeEntry<'a, K, V, A> {\n        match self {\n            BTreeEntry::Occupied(e) => {\n                let mut e = e;\n                f(e.get_mut());\n                BTreeEntry::Occupied(e)\n            }\n            BTreeEntry::Vacant(e) => BTreeEntry::Vacant(e),\n        }\n    }\n\n    #[effects()]\n    pub fn key(&self) -> &K {\n        match self {\n            BTreeEntry::Occupied(e) => &e.key,\n            BTreeEntry::Vacant(e) => &e.key,\n        }\n    }\n}\n\npub struct BTreeOccupiedEntry<'a, K, V, A: Allocator> {\n    map: &'a mut BTreeMap<K, V, A>,\n    key: K,\n    node: u32,\n    at: usize,\n}\n\nimpl<'a, K: Ord, V, A: Allocator> BTreeOccupiedEntry<'a, K, V, A> {\n    #[effects()]\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    #[effects(panic, K, V, A)]\n    pub fn get(&self) -> &V {\n        self.map.nodes[self.node as usize].vals[self.at].as_ref().unwrap()\n    }\n\n    #[effects(panic, K, V, A)]\n    pub fn get_mut(&mut self) -> &mut V {\n        self.map.nodes[self.node as usize].vals[self.at].as_mut().unwrap()\n    }\n\n    // The value, for as long as the map is borrowed.\n    #[effects(panic, K, V, A)]\n    pub fn into_mut(self) -> &'a mut V {\n        let map = self.map;\n        map.nodes[self.node as usize].vals[self.at].as_mut().unwrap()\n    }\n\n    // Sets the value; the one it had.\n    #[effects(panic, K, V, A)]\n    pub fn insert(&mut self, value: V) -> V {\n        self.map.nodes[self.node as usize].vals[self.at].replace(value).unwrap()\n    }\n\n    // Removes the entry; its value.\n    #[effects(panic, K, V, A)]\n");
    buf_str(out, c"    pub fn remove(self) -> V {\n        self.map.remove_with(&BDirect { key: &self.key }).unwrap().1\n    }\n}\n\npub struct BTreeVacantEntry<'a, K, V, A: Allocator> {\n    map: &'a mut BTreeMap<K, V, A>,\n    key: K,\n}\n\nimpl<'a, K: Ord, V, A: Allocator> BTreeVacantEntry<'a, K, V, A> {\n    #[effects()]\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    #[effects()]\n    pub fn into_key(self) -> K {\n        self.key\n    }\n\n    // Adds the entry; its value, for as long as the map is borrowed.\n    #[effects(panic, K, V, A)]\n    pub fn insert(self, value: V) -> &'a mut V {\n        let map = self.map;\n        let (n, i, _) = map.insert_at(self.key, value);\n        map.nodes[n as usize].vals[i].as_mut().unwrap()\n    }\n}\n\n// ---- BTreeSet ----\n\n// A set of T in order, on allocator A: a BTreeMap with no values.\npub struct BTreeSet<T, A: Allocator> {\n    map: BTreeMap<T, (), A>,\n}\n\nimpl<T, A: Allocator> BTreeSet<T, A> {\n    // An empty set on a; allocates at the first insert.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> BTreeSet<T, A> {\n        BTreeSet { map: BTreeMap::new_in(a) }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.map.len\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.map.len == 0\n    }\n\n    #[effects(T, A)]\n    pub fn clear(&mut self) {\n        self.map.clear();\n    }\n\n    // The elements in order.\n    #[effects(T, A)]\n    pub fn iter(&self) -> BTreeSetIter<'_, T, A> {\n        BTreeSetIter { inner: self.map.iter() }\n    }\n\n    // The smallest element.\n    #[effects(T, A)]\n    pub fn first(&self) -> Option<&T> {\n        self.iter().next()\n    }\n\n    // The largest element.\n    #[effects(T, A)]\n    pub fn last(&self) -> Option<&T> {\n        self.iter().next_back()\n    }\n}\n\nimpl<T: Ord, A: Allocator> BTreeSet<T, A> {\n    #[effects(T, A, Q)]\n    pub fn contains<Q: ?Sized + Ord>(&self, x: &Q) -> bool\n        where\n");
    buf_str(out, c"            T: Borrow<Q>,\n    {\n        self.map.contains_key(x)\n    }\n\n    // The set's element equal to x.\n    #[effects(T, A, Q)]\n    pub fn get<Q: ?Sized + Ord>(&self, x: &Q) -> Option<&T>\n        where\n            T: Borrow<Q>,\n    {\n        match self.map.get_key_value(x) {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    // Adds x; false when it was there already.\n    #[effects(T, A)]\n    pub fn insert(&mut self, x: T) -> bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    // Removes x; whether it was there.\n    #[effects(T, A, Q)]\n    pub fn remove<Q: ?Sized + Ord>(&mut self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove_entry(x).is_some()\n    }\n\n    // Removes and returns the element equal to x.\n    #[effects(T, A, Q)]\n    pub fn take<Q: ?Sized + Ord>(&mut self, x: &Q) -> Option<T>\n        where\n            T: Borrow<Q>,\n    {\n        match self.map.remove_entry(x) {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    #[effects(T, A)]\n    pub fn pop_first(&mut self) -> Option<T> {\n        match self.map.pop_first() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    #[effects(T, A)]\n    pub fn pop_last(&mut self) -> Option<T> {\n        match self.map.pop_last() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    // The elements in `range`, in order.\n    #[effects(T, A, R)]\n    pub fn range<R: RangeBounds<T>>(&self, range: R) -> BTreeSetIter<'_, T, A> {\n        BTreeSetIter { inner: self.map.range(range) }\n    }\n\n    // Whether every element of self is in other.\n    #[effects(diverge, T, A, B)]\n    pub fn is_subset<B: Allocator>(&self, other: &BTreeSet<T, B>) -> bool {\n        if self.len() > other.len() {\n            return false;\n        }\n        for x in self.iter() {\n            if !other.contains(x) {\n");
    buf_str(out, c"                return false;\n            }\n        }\n        true\n    }\n\n    #[effects(T, A, B)]\n    pub fn is_superset<B: Allocator>(&self, other: &BTreeSet<T, B>) -> bool {\n        other.is_subset(self)\n    }\n\n    // Whether the two have no element in common.\n    #[effects(diverge, T, A, B)]\n    pub fn is_disjoint<B: Allocator>(&self, other: &BTreeSet<T, B>) -> bool {\n        for x in self.iter() {\n            if other.contains(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // A copy on allocator b.\n    #[effects(diverge, T, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> BTreeSet<T, B>\n        where\n            T: Clone,\n    {\n        let mut s: BTreeSet<T, B> = BTreeSet::new_in(b);\n        for x in self.iter() {\n            s.insert(x.clone());\n        }\n        s\n    }\n}\n\nimpl<T: Ord + Clone, A: Allocator + Clone> Clone for BTreeSet<T, A> {\n    fn clone(&self) -> BTreeSet<T, A> {\n        self.clone_in(self.map.allocator().clone())\n    }\n}\n\nimpl<T: PartialEq, A: Allocator, B: Allocator> PartialEq<BTreeSet<T, B>> for BTreeSet<T, A> {\n    fn eq(&self, other: &BTreeSet<T, B>) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        let mut a = self.iter();\n        let mut b = other.iter();\n        loop {\n            match (a.next(), b.next()) {\n                (Some(x), Some(y)) => if *x != *y {\n                    return false;\n                },\n                _ => return true,\n            }\n        }\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for BTreeSet<T, A> {}\n\n// `{a, b, ...}`, in order.\nimpl<T: Debug, A: Allocator> Debug for BTreeSet<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_set().entries(self.iter()).finish()\n    }\n}\n\nimpl<T: Ord, A: Allocator> Extend<T> for BTreeSet<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n");
    buf_str(out, c"            self.insert(x);\n        }\n    }\n}\n\n// `items.collect_in(a)`.\nimpl<T: Ord, A: Allocator> FromIteratorIn<T, A> for BTreeSet<T, A> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> BTreeSet<T, A> {\n        let mut s: BTreeSet<T, A> = BTreeSet::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T, A: Allocator> DefaultIn<A> for BTreeSet<T, A> {\n    fn default_in(a: A) -> BTreeSet<T, A> {\n        BTreeSet::new_in(a)\n    }\n}\n\nimpl<T, A: Allocator> IntoIterator for BTreeSet<T, A> {\n    type Item = T;\n    type IntoIter = BTreeSetIntoIter<T, A>;\n\n    fn into_iter(self) -> BTreeSetIntoIter<T, A> {\n        BTreeSetIntoIter { inner: self.map.into_iter() }\n    }\n}\n\nimpl<'a, T, A: Allocator> IntoIterator for &'a BTreeSet<T, A> {\n    type Item = &'a T;\n    type IntoIter = BTreeSetIter<'a, T, A>;\n\n    fn into_iter(self) -> BTreeSetIter<'a, T, A> {\n        self.iter()\n    }\n}\n\npub struct BTreeSetIter<'a, T, A: Allocator> {\n    inner: BTreeIter<'a, T, (), A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for BTreeSetIter<'a, T, A> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.inner.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<'a, T, A: Allocator> DoubleEndedIterator for BTreeSetIter<'a, T, A> {\n    fn next_back(&mut self) -> Option<&'a T> {\n        match self.inner.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\npub struct BTreeSetIntoIter<T, A: Allocator> {\n    inner: BTreeIntoIter<T, (), A>,\n}\n\nimpl<T, A: Allocator> Iterator for BTreeSetIntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        match self.inner.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<T, A: Allocator> DoubleEndedIterator for BTreeSetIntoIter<T, A> {\n    fn next_back(&mut self) -> Option<T> {\n");
    buf_str(out, c"        match self.inner.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n// ---- end mod std::collections::btree_map ----\n}\n// ---- mod std::collections::hash_map ----\npub mod hash_map {\n// EDITION: rust\n// std::collections::hash_map: HashMap<K, V, A, S>, Entry, the iterators.\n// hashbrown's Swiss table, as MVS's (its RawTable is internal). A is\n// always written; S, the BuildHasher, defaults to FixedState (a fixed\n// seed: decision 2), so it goes last: `HashMap<K, V, Gpa>`. Rust's order\n// is <K, V, S, A>: the rustc twin's shim swaps them. Lookups take a\n// reference to anything the key Borrows (`m.get(\"x\")` on String keys).\n// The K: Hash + Eq bound is on the impls, not the struct, as Rust's.\n\nuse crate::alloc::{Allocator, Layout, TryReserveError};\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{BuildHasher, FixedState, Hash, Hasher};\nuse crate::iter::{ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::marker::PhantomData;\nuse crate::ops::Index;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// A map from K to V on A, hashed by S.\n// std2: changed: an S, defaulted; the bounds moved to the impls\npub struct HashMap<K, V, A: Allocator, S = FixedState> {\n    table: RawTable<(K, V), A>,\n    hasher: S,\n}\n\n// The table itself (internal): cap slots of T and a control byte for\n// each, both from alloc; cap is 0 (nothing allocated) or a power of two\n// of at least 8. A control byte is EMPTY, DELETED (a tombstone: a probe\n// goes on past it) or a full slot's h2, the hash's top 7 bits. Probing is\n// linear from the hash's low bits, and at most 7/8 of the slots are used\n// (growth_left counts what is left), so a probe always meets an EMPTY.\nstruct RawTable<T, A: Allocator> {\n    ctrl: crate::ptr::NonNull<u8>,\n");
    buf_str(out, c"    data: crate::ptr::NonNull<T>,\n    cap: usize,\n    items: usize,\n    growth_left: usize,\n    alloc: A,\n    marker: PhantomData<T>,\n}\n\n// UNSAFE: the table's control bytes and slots are NonNulls: stated, as\n// hashbrown's.\n// SAFETY: the table owns its entries and its allocator and reaches them\n// only through itself (HashMap, IntoIter, Drain go through it).\nunsafe impl<T: Send, A: Allocator + Send> Send for RawTable<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&RawTable` reads its entries through `&T` only.\nunsafe impl<T: Sync, A: Allocator + Sync> Sync for RawTable<T, A> {}\n\nconst EMPTY: u8 = 255;\nconst DELETED: u8 = 128;\n\n// A hash's control byte (its top 7 bits) and its first slot.\nfn h2(hash: u64) -> u8 {\n    (hash >> 57) as u8\n}\n\n// The slots a table needs for n entries (0 for none).\nfn buckets_for(n: usize) -> usize {\n    if n == 0 {\n        return 0;\n    }\n    let mut cap: usize = 8;\n    while cap / 8 * 7 < n {\n        cap *= 2;\n    }\n    cap\n}\n\nimpl<T, A: Allocator> RawTable<T, A> {\n    fn new_in(a: A) -> RawTable<T, A> {\n        RawTable {\n            ctrl: crate::ptr::NonNull::dangling(),\n            data: crate::ptr::NonNull::dangling(),\n            cap: 0,\n            items: 0,\n            growth_left: 0,\n            alloc: a,\n            marker: PhantomData,\n        }\n    }\n\n    // A control array (every byte EMPTY) and a slot array of cap from the\n    // allocator; panics when it has no room.\n    fn allocate_arrays(&self, cap: usize) -> (crate::ptr::NonNull<u8>, crate::ptr::NonNull<T>) {\n        let ctrl_layout = match Layout::array::<u8>(cap) {\n            Result::Ok(l) => l,\n            Result::Err(_) => {\n                let msg: &str = \"HashMap: capacity overflow\";\n                crate::panic::panic(msg)\n            }\n        };\n        let data_layout = match Layout::array::<T>(cap) {\n            Result::Ok(l) => l,\n            Result::Err(_) => {\n");
    buf_str(out, c"                let msg: &str = \"HashMap: capacity overflow\";\n                crate::panic::panic(msg)\n            }\n        };\n        let ctrl = match self.alloc.allocate(ctrl_layout) {\n            Result::Ok(p) => p,\n            Result::Err(_) => {\n                let msg: &str = \"HashMap: out of memory\";\n                crate::panic::panic(msg)\n            }\n        };\n        let data = match self.alloc.allocate(data_layout) {\n            Result::Ok(p) => p.cast::<T>(),\n            Result::Err(_) => {\n                let msg: &str = \"HashMap: out of memory\";\n                crate::panic::panic(msg)\n            }\n        };\n        let c = ctrl.as_ptr();\n        let mut i: usize = 0;\n        while i < cap {\n            // UNSAFE: the new control array is written through its pointer.\n            // SAFETY: i < cap, the array's length, and it is ours alone.\n            unsafe {\n                *c.add(i) = EMPTY;\n            }\n            i += 1;\n        }\n        (ctrl, data)\n    }\n\n    // Gives the arrays back (their entries were moved out or dropped).\n    fn free_arrays(&mut self) {\n        let ctrl = crate::mem::replace(&mut self.ctrl, crate::ptr::NonNull::dangling());\n        let data = crate::mem::replace(&mut self.data, crate::ptr::NonNull::dangling());\n        let cap = crate::mem::replace(&mut self.cap, 0);\n        self.items = 0;\n        self.growth_left = 0;\n        self.free_raw(ctrl, data, cap);\n    }\n\n    // Gives back arrays of cap that allocate_arrays made (none when cap is 0).\n    fn free_raw(&self, ctrl: crate::ptr::NonNull<u8>, data: crate::ptr::NonNull<T>, cap: usize) {\n        if cap == 0 {\n            return;\n        }\n        // UNSAFE: the blocks go back to the allocator they came from.\n        // SAFETY: cap > 0, so ctrl and data are blocks alloc gave for these\n        // layouts (allocate_arrays); the caller uses them no more.\n        unsafe {\n");
    buf_str(out, c"            match Layout::array::<u8>(cap) {\n                Result::Ok(l) => self.alloc.deallocate(ctrl, l),\n                Result::Err(_) => {}\n            }\n            match Layout::array::<T>(cap) {\n                Result::Ok(l) => self.alloc.deallocate(data.cast::<u8>(), l),\n                Result::Err(_) => {}\n            }\n        }\n    }\n\n    // Slot i's control byte (i < cap).\n    fn ctrl_at(&self, i: usize) -> u8 {\n        let c = self.ctrl.as_ptr();\n        // UNSAFE: a read of the control array.\n        // SAFETY: callers pass i < cap, the array's length, and every byte\n        // of it was written (allocate_arrays).\n        unsafe { *c.add(i) }\n    }\n\n    fn set_ctrl(&mut self, i: usize, b: u8) {\n        let c = self.ctrl.as_ptr();\n        // UNSAFE: a write of the control array.\n        // SAFETY: callers pass i < cap; &mut self, so nothing else reads it.\n        unsafe {\n            *c.add(i) = b;\n        }\n    }\n\n    fn is_full(&self, i: usize) -> bool {\n        self.ctrl_at(i) < DELETED\n    }\n\n    // Slot i's entry (full).\n    fn slot(&self, i: usize) -> &T {\n        let d = self.data.as_ptr();\n        // UNSAFE: a reference made from the slot array's pointer.\n        // SAFETY: callers pass a full slot i < cap, so it holds an\n        // initialized T; the reference lives as long as &self.\n        unsafe { &*d.add(i) }\n    }\n\n    fn slot_mut(&mut self, i: usize) -> &mut T {\n        let d = self.data.as_ptr();\n        // UNSAFE: a &mut made from the slot array's pointer.\n        // SAFETY: callers pass a full slot i < cap; &mut self makes it the\n        // only reference.\n        unsafe { &mut *d.add(i) }\n    }\n\n    // The first slot from hash's that is EMPTY or DELETED (cap > 0).\n    fn find_insert_slot(&self, hash: u64) -> usize {\n        let mask = self.cap - 1;\n        let mut i = (hash as usize) & mask;\n        // (each slot once at most: a counted loop, no `diverge`. growth_left\n");
    buf_str(out, c"        // keeps a slot that is not full, so the last line is not reached\n        // with a full one.)\n        for _ in 0..self.cap {\n            if !self.is_full(i) {\n                return i;\n            }\n            i = (i + 1) & mask;\n        }\n        i\n    }\n\n    // Puts x in slot i (found by find_insert_slot for hash).\n    fn put(&mut self, i: usize, hash: u64, x: T) {\n        if self.ctrl_at(i) == EMPTY {\n            self.growth_left -= 1;\n        }\n        self.set_ctrl(i, h2(hash));\n        let d = self.data.as_ptr();\n        // UNSAFE: a write into the slot array.\n        // SAFETY: i < cap and slot i is not full, so nothing is overwritten\n        // that would need a drop.\n        unsafe {\n            crate::ptr::write(d.add(i), x);\n        }\n        self.items += 1;\n    }\n\n    // Moves slot i's entry out, leaving a tombstone (full slot i).\n    fn take(&mut self, i: usize) -> T {\n        // An EMPTY after it ends every probe that would pass, so slot i\n        // can be EMPTY again (its room comes back).\n        let next = (i + 1) & (self.cap - 1);\n        if self.ctrl_at(next) == EMPTY {\n            self.set_ctrl(i, EMPTY);\n            self.growth_left += 1;\n        } else {\n            self.set_ctrl(i, DELETED);\n        }\n        self.items -= 1;\n        let d = self.data.as_ptr();\n        // UNSAFE: a move out of the slot array.\n        // SAFETY: slot i was full, and its control byte now says it is not,\n        // so the T is read once and never dropped in place.\n        unsafe { crate::ptr::read(d.add(i)) }\n    }\n\n    // The next full slot at or after i; cap when there is none.\n    fn next_full(&self, i: usize) -> usize {\n        let mut j = i;\n        while j < self.cap && !self.is_full(j) {\n            j += 1;\n        }\n        j\n    }\n\n    // Drops every entry; the arrays stay.\n    fn clear(&mut self) {\n        let mut i: usize = 0;\n        while i < self.cap {\n");
    buf_str(out, c"            if self.is_full(i) {\n                let x = self.take(i);\n                crate::mem::drop(x);\n            }\n            i += 1;\n        }\n        let mut j: usize = 0;\n        while j < self.cap {\n            self.set_ctrl(j, EMPTY);\n            j += 1;\n        }\n        self.items = 0;\n        self.growth_left = self.cap / 8 * 7;\n    }\n}\n\n// A table drops what is left in it and frees its arrays (a map's, an\n// IntoIter's).\nimpl<T, A: Allocator> crate::ops::Drop for RawTable<T, A> {\n    fn drop(&mut self) {\n        self.clear();\n        self.free_arrays();\n    }\n}\n\nimpl<K, V, A: Allocator> HashMap<K, V, A, FixedState> {\n    // An empty map on a, with the fixed-seed hasher; it allocates at its\n    // first insert.\n    #[effects(K, V, A)]\n    pub fn new_in(a: A) -> HashMap<K, V, A, FixedState> {\n        HashMap::with_hasher_in(FixedState::new(), a)\n    }\n\n    // Room for n entries.\n    #[effects(K, V, A)]\n    pub fn with_capacity_in(n: usize, a: A) -> HashMap<K, V, A, FixedState> {\n        HashMap::with_capacity_and_hasher_in(n, FixedState::new(), a)\n    }\n}\n\nimpl<K, V, A: Allocator, S> HashMap<K, V, A, S> {\n    // An empty map on a, hashed by hasher (a seeded FixedState, a RandomState).\n    #[effects(K, V, A)]\n    pub fn with_hasher_in(hasher: S, a: A) -> HashMap<K, V, A, S> {\n        HashMap { table: RawTable::new_in(a), hasher: hasher }\n    }\n\n    #[effects(diverge, K, V, A)]\n    pub fn with_capacity_and_hasher_in(n: usize, hasher: S, a: A) -> HashMap<K, V, A, S> {\n        let mut table: RawTable<(K, V), A> = RawTable::new_in(a);\n        let cap = buckets_for(n);\n        if cap > 0 {\n            let (ctrl, data) = table.allocate_arrays(cap);\n            table.ctrl = ctrl;\n            table.data = data;\n            table.cap = cap;\n            table.growth_left = cap / 8 * 7;\n        }\n        HashMap { table: table, hasher: hasher }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n");
    buf_str(out, c"        self.table.items\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    // How many entries fit before it grows.\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        self.table.items + self.table.growth_left\n    }\n\n    #[effects()]\n    pub fn hasher(&self) -> &S {\n        &self.hasher\n    }\n\n    // std2: changed: returns &A (MVS: a copy of A)\n    #[effects()]\n    pub fn allocator(&self) -> &A {\n        &self.table.alloc\n    }\n\n    // Its entries, (&K, &V), in table order (the same in every run).\n    // std2: changed: yields (&K, &V) (MVS: copies)\n    #[effects(K, V)]\n    pub fn iter(&self) -> Iter<'_, K, V> {\n        Iter {\n            ctrl: self.table.ctrl.as_ptr() as *const u8,\n            data: self.table.data.as_ptr() as *const (K, V),\n            at: 0,\n            left: self.table.items,\n            marker: PhantomData,\n        }\n    }\n\n    // Its entries, (&K, &mut V).\n    #[effects(K, V)]\n    pub fn iter_mut(&mut self) -> IterMut<'_, K, V> {\n        IterMut {\n            ctrl: self.table.ctrl.as_ptr() as *const u8,\n            data: self.table.data.as_ptr(),\n            at: 0,\n            left: self.table.items,\n            marker: PhantomData,\n        }\n    }\n\n    // std2: changed: yields &K\n    #[effects(K, V, A, S)]\n    pub fn keys(&self) -> Keys<'_, K, V> {\n        Keys { inner: self.iter() }\n    }\n\n    // std2: changed: yields &V\n    #[effects(K, V, A, S)]\n    pub fn values(&self) -> Values<'_, K, V> {\n        Values { inner: self.iter() }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn values_mut(&mut self) -> ValuesMut<'_, K, V> {\n        ValuesMut { inner: self.iter_mut() }\n    }\n\n    // The keys, by value, the map consumed.\n    #[effects(K, V, A, S)]\n    pub fn into_keys(self) -> IntoKeys<K, V, A> {\n        IntoKeys { inner: self.into_iter() }\n    }\n\n    #[effects(K, V, A, S)]\n");
    buf_str(out, c"    pub fn into_values(self) -> IntoValues<K, V, A> {\n        IntoValues { inner: self.into_iter() }\n    }\n\n    // Every entry, removed and yielded by the iterator.\n    #[effects()]\n    pub fn drain(&mut self) -> Drain<'_, K, V, A> {\n        Drain { table: &mut self.table as *mut RawTable<(K, V), A>, at: 0, marker: PhantomData }\n    }\n\n    // Keeps the entries f says true of.\n    #[effects(diverge, K, V, A, F)]\n    pub fn retain<F: FnMut(&K, &mut V) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        let mut i: usize = 0;\n        while i < self.table.cap {\n            if self.table.is_full(i) {\n                let keep = {\n                    let e = self.table.slot_mut(i);\n                    f(&e.0, &mut e.1)\n                };\n                if !keep {\n                    let gone = self.table.take(i);\n                    crate::mem::drop(gone);\n                }\n            }\n            i += 1;\n        }\n    }\n\n    // Removes every entry; the capacity stays.\n    #[effects(K, V, A)]\n    pub fn clear(&mut self) {\n        self.table.clear()\n    }\n\n    // Moves the map out, leaving an empty one on clones of its allocator\n    // and hasher (vole's: a map has no Default).\n    #[effects(K, V, A, S)]\n    pub fn take(&mut self) -> HashMap<K, V, A, S>\n        where\n            A: Clone,\n            S: Clone,\n    {\n        let fresh = HashMap::with_hasher_in(self.hasher.clone(), self.table.alloc.clone());\n        crate::mem::replace(self, fresh)\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher> HashMap<K, V, A, S> {\n    // q's hash by the map's hasher.\n    fn hash_of<Q: ?Sized + Hash>(&self, q: &Q) -> u64 {\n        let mut h = self.hasher.build_hasher();\n        q.hash(&mut h);\n        h.finish()\n    }\n\n    // The full slot whose key equals k.\n    fn find<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<usize>\n        where\n            K: Borrow<Q>,\n    {\n        if self.table.cap == 0 {\n");
    buf_str(out, c"            return Option::None;\n        }\n        let hash = self.hash_of(k);\n        let tag = h2(hash);\n        let mask = self.table.cap - 1;\n        let mut i = (hash as usize) & mask;\n        // (a probe sees each slot once at most: a counted loop, no `diverge`.\n        // A table keeps an EMPTY slot, so the probe ends before that.)\n        for _ in 0..self.table.cap {\n            let c = self.table.ctrl_at(i);\n            if c == EMPTY {\n                return Option::None;\n            }\n            if c == tag {\n                let stored: &Q = self.table.slot(i).0.borrow();\n                if *stored == *k {\n                    return Option::Some(i);\n                }\n            }\n            i = (i + 1) & mask;\n        }\n        Option::None\n    }\n\n    // A new table of room for want entries, every entry moved over\n    // (tombstones dropped).\n    fn resize(&mut self, want: usize) {\n        let new_cap = buckets_for(want);\n        let (ctrl, data) = self.table.allocate_arrays(new_cap);\n        let old_ctrl = crate::mem::replace(&mut self.table.ctrl, ctrl);\n        let old_data = crate::mem::replace(&mut self.table.data, data);\n        let old_cap = crate::mem::replace(&mut self.table.cap, new_cap);\n        self.table.items = 0;\n        self.table.growth_left = new_cap / 8 * 7;\n        let oc = old_ctrl.as_ptr();\n        let od = old_data.as_ptr();\n        let mut i: usize = 0;\n        while i < old_cap {\n            // UNSAFE: the old arrays read through their pointers.\n            // SAFETY: i < old_cap, their length; a full slot holds an\n            // initialized entry, read once (the arrays are freed after,\n            // nothing dropped in them).\n            if unsafe { *oc.add(i) } < DELETED {\n                // UNSAFE: the full slot's entry moved out of the old array.\n                // SAFETY: as above: i < old_cap and the slot is full; it is read once.\n");
    buf_str(out, c"                let e = unsafe { crate::ptr::read(od.add(i)) };\n                let hash = self.hash_of(&e.0);\n                let j = self.table.find_insert_slot(hash);\n                self.table.put(j, hash, e);\n            }\n            i += 1;\n        }\n        self.table.free_raw(old_ctrl, old_data, old_cap);\n    }\n\n    // Room for n more entries.\n    // std2: changed: n more (MVS: n in all)\n    #[effects(K, V, A, S)]\n    pub fn reserve(&mut self, n: usize) {\n        if n > self.table.growth_left {\n            self.resize(self.table.items + n);\n        }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn try_reserve(&mut self, n: usize) -> Result<(), TryReserveError> {\n        if n > usize::MAX / 2 - self.table.items {\n            return Result::Err(TryReserveError::CapacityOverflow);\n        }\n        self.reserve(n);\n        Result::Ok(())\n    }\n\n    #[effects(diverge, K, V, A, S)]\n    pub fn shrink_to_fit(&mut self) {\n        let items = self.table.items;\n        if buckets_for(items) < self.table.cap {\n            if items == 0 {\n                self.table.free_arrays();\n            } else {\n                self.resize(items);\n            }\n        }\n    }\n\n    // The value for k.\n    // std2: changed: takes &Q, returns Option<&V> (MVS: a K and a copy of V)\n    #[effects(K, V, A, S, Q)]\n    pub fn get<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<&V>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => Option::Some(&self.table.slot(i).1),\n            Option::None => Option::None,\n        }\n    }\n\n    // The value for k, mutable.\n    // std2: changed: takes &Q, returns Option<&mut V> (MVS: an inout view)\n    #[effects(K, V, A, S, Q)]\n    pub fn get_mut<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<&mut V>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n");
    buf_str(out, c"            Option::Some(i) => Option::Some(&mut self.table.slot_mut(i).1),\n            Option::None => Option::None,\n        }\n    }\n\n    // The stored key and its value.\n    #[effects(K, V, A, S, Q)]\n    pub fn get_key_value<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<(&K, &V)>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => {\n                let e = self.table.slot(i);\n                Option::Some((&e.0, &e.1))\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    // mvs: HashMap::contains_key, HashMap::contains\n    // std2: changed: takes &Q\n    #[effects(K, V, A, S, Q)]\n    pub fn contains_key<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> bool\n        where\n            K: Borrow<Q>,\n    {\n        self.get(k).is_some()\n    }\n\n    // Stores v for k; the old value, if there was one.\n    #[effects(K, V, A, S)]\n    pub fn insert(&mut self, k: K, v: V) -> Option<V> {\n        if let Option::Some(i) = self.find(&k) {\n            return Option::Some(crate::mem::replace(&mut self.table.slot_mut(i).1, v));\n        }\n        let hash = self.hash_of(&k);\n        if self.table.growth_left == 0 {\n            self.resize(self.table.items + 1);\n        }\n        let i = self.table.find_insert_slot(hash);\n        self.table.put(i, hash, (k, v));\n        Option::None\n    }\n\n    // Removes k's entry; its value.\n    // std2: changed: takes &Q\n    #[effects(K, V, A, S, Q)]\n    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<V>\n        where\n            K: Borrow<Q>,\n    {\n        self.remove_entry(k).map(|(_, v)| v)\n    }\n\n    // Removes k's entry; the stored key and its value.\n    #[effects(K, V, A, S, Q)]\n    pub fn remove_entry<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<(K, V)>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => Option::Some(self.table.take(i)),\n");
    buf_str(out, c"            Option::None => Option::None,\n        }\n    }\n\n    // k's place in the map, there or not: `*m.entry(k).or_insert(0) += 1`.\n    // mvs: HashMap::get_or_insert\n    // std2: changed: Entry replaces get_or_insert (`entry(k).or_insert(v)`)\n    #[effects(K, V, A, S)]\n    pub fn entry(&mut self, k: K) -> Entry<'_, K, V, A, S> {\n        // Room for one more first, as Rust's: a VacantEntry inserts with no\n        // hasher at hand.\n        self.reserve(1);\n        match self.find(&k) {\n            Option::Some(i) => Entry::Occupied(OccupiedEntry { map: self, bucket: i }),\n            Option::None => {\n                let hash = self.hash_of(&k);\n                Entry::Vacant(VacantEntry { map: self, key: k, hash: hash })\n            }\n        }\n    }\n\n    // A copy on another allocator, with a clone of the hasher.\n    #[effects(K, V, A, S, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> HashMap<K, V, B, S>\n        where\n            K: Clone,\n            V: Clone,\n            S: Clone,\n    {\n        let mut m = HashMap::with_capacity_and_hasher_in(self.len(), self.hasher.clone(), b);\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K, V, A: Allocator, S> crate::ops::Drop for HashMap<K, V, A, S> {\n    fn drop(&mut self) {\n        self.table.clear();\n        self.table.free_arrays();\n    }\n}\n\n// A copy on the same allocator (a clone of it).\n// std2: changed: needs A: Clone and S: Clone\nimpl<K: Hash + Eq + Clone, V: Clone, A: Allocator + Clone,\n    S: BuildHasher + Clone> Clone for HashMap<K, V, A, S> {\n    fn clone(&self) -> HashMap<K, V, A, S> {\n        self.clone_in(self.table.alloc.clone())\n    }\n}\n\n// The same entries, in any order.\n// mvs: HashMap::impl Eq\n// std2: changed: PartialEq; any two allocators\nimpl<K: Hash + Eq, V: PartialEq, A: Allocator, B: Allocator,\n    S: BuildHasher> PartialEq<HashMap<K, V, B, S>>\n");
    buf_str(out, c"    for HashMap<K, V, A, S>\n    {\n    fn eq(&self, other: &HashMap<K, V, B, S>) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        self.iter().all(|(k, v)| other.get(k).map_or(false, |w| *v == *w))\n    }\n}\n\nimpl<K: Hash + Eq, V: Eq, A: Allocator, S: BuildHasher> Eq for HashMap<K, V, A, S> {}\n\n// `{k: v, ...}`.\n// mvs: HashMap::impl Debug\nimpl<K: Debug, V: Debug, A: Allocator, S> Debug for HashMap<K, V, A, S> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_map().entries(self.iter()).finish()\n    }\n}\n\n// `m[&k]`: the value; panics when k is not there.\nimpl<K: Hash + Eq + Borrow<Q>, Q: ?Sized + Hash + Eq, V, A: Allocator, S: BuildHasher> Index<&Q>\n    for HashMap<K, V, A, S>\n    {\n    type Output = V;\n\n    fn index(&self, k: &Q) -> &V {\n        self.get(k).expect(\"no entry found for key\")\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher> Extend<(K, V)> for HashMap<K, V, A, S> {\n    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(k, v);\n        }\n    }\n}\n\nimpl<'a, K: Hash + Eq + Copy, V: Copy, A: Allocator,\n    S: BuildHasher> Extend<(&'a K, &'a V)> for HashMap<K, V, A, S> {\n    fn extend<I: IntoIterator<Item = (&'a K, &'a V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(*k, *v);\n        }\n    }\n}\n\n// `pairs.collect_in(a)` into a map with S's Default.\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher + Default> FromIteratorIn<(K, V),\n    A> for HashMap<K, V, A, S> {\n    fn from_iter_in<I: IntoIterator<Item = (K, V)>>(iter: I, a: A) -> HashMap<K, V, A, S> {\n        let mut m: HashMap<K, V, A, S> = HashMap::with_hasher_in(S::default(), a);\n        m.extend(iter);\n        m\n    }\n}\n\n// An empty map on a (`entry(k).or_default()` for map values).\nimpl<K, V, A: Allocator, S: Default> DefaultIn<A> for HashMap<K, V, A, S> {\n");
    buf_str(out, c"    fn default_in(a: A) -> HashMap<K, V, A, S> {\n        HashMap::with_hasher_in(S::default(), a)\n    }\n}\n\nimpl<K, V, A: Allocator, S> IntoIterator for HashMap<K, V, A, S> {\n    type Item = (K, V);\n    type IntoIter = IntoIter<K, V, A>;\n\n    fn into_iter(self) -> IntoIter<K, V, A> {\n        // HashMap has a Drop, so its table is moved out by hand: read, and\n        // the map forgotten once its hasher is dropped.\n        let me = self;\n        // UNSAFE: the table and the hasher are moved out of a value whose type\n        // implements Drop (Rust's E0509 forbids the plain move).\n        // SAFETY: each field is read once and me is forgotten right after, so\n        // neither is dropped twice and the table's arrays have one owner.\n        let table = unsafe { crate::ptr::read(&me.table as *const RawTable<(K, V), A>) };\n        // UNSAFE: the hasher moved out, as the table above.\n        // SAFETY: read once; me is forgotten right after.\n        let hasher = unsafe { crate::ptr::read(&me.hasher as *const S) };\n        crate::mem::forget(me);\n        crate::mem::drop(hasher);\n        IntoIter { table: table, at: 0 }\n    }\n}\n\nimpl<'a, K, V, A: Allocator, S> IntoIterator for &'a HashMap<K, V, A, S> {\n    type Item = (&'a K, &'a V);\n    type IntoIter = Iter<'a, K, V>;\n\n    fn into_iter(self) -> Iter<'a, K, V> {\n        self.iter()\n    }\n}\n\nimpl<'a, K, V, A: Allocator, S> IntoIterator for &'a mut HashMap<K, V, A, S> {\n    type Item = (&'a K, &'a mut V);\n    type IntoIter = IterMut<'a, K, V>;\n\n    fn into_iter(self) -> IterMut<'a, K, V> {\n        self.iter_mut()\n    }\n}\n\n// ---- Entry ----\n\n// A key's place in a map: Occupied (its entry is there) or Vacant.\npub enum Entry<'a, K, V, A: Allocator, S> {\n    Occupied(OccupiedEntry<'a, K, V, A, S>),\n    Vacant(VacantEntry<'a, K, V, A, S>),\n}\n\nimpl<'a, K: Hash + Eq, V, A: Allocator, S: BuildHasher> Entry<'a, K, V, A, S> {\n");
    buf_str(out, c"    // The value, after inserting default if it was vacant.\n    #[effects(K, V, A, S)]\n    pub fn or_insert(self, default: V) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => e.insert(default),\n        }\n    }\n\n    // The value, after inserting f() if it was vacant.\n    #[effects(K, V, A, S, F)]\n    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => e.insert(f()),\n        }\n    }\n\n    // The value, after inserting f(&key) if it was vacant.\n    #[effects(K, V, A, S, F)]\n    pub fn or_insert_with_key<F: FnOnce(&K) -> V>(self, f: F) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => {\n                let v = f(e.key());\n                e.insert(v)\n            }\n        }\n    }\n\n    // The value, after inserting V's empty value if it was vacant: a 0, a\n    // None, or an empty Vec on a clone of the map's allocator (DefaultIn).\n    #[effects(K, V, A, S)]\n    pub fn or_default(self) -> &'a mut V\n        where\n            V: DefaultIn<A>,\n            A: Clone,\n    {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => {\n                let v = V::default_in(e.map_allocator().clone());\n                e.insert(v)\n            }\n        }\n    }\n\n    // Calls f on the value if it is there; the entry back.\n    #[effects(K, V, A, S, F)]\n    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> Entry<'a, K, V, A, S> {\n        match self {\n            Entry::Occupied(mut e) => {\n                f(e.get_mut());\n                Entry::Occupied(e)\n            }\n            Entry::Vacant(e) => Entry::Vacant(e),\n        }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn key(&self) -> &K {\n        match self {\n");
    buf_str(out, c"            Entry::Occupied(e) => e.key(),\n            Entry::Vacant(e) => e.key(),\n        }\n    }\n}\n\n// An entry that is there.\npub struct OccupiedEntry<'a, K, V, A: Allocator, S> {\n    map: &'a mut HashMap<K, V, A, S>,\n    bucket: usize,\n}\n\nimpl<'a, K, V, A: Allocator, S> OccupiedEntry<'a, K, V, A, S> {\n    #[effects(K, V, A)]\n    pub fn key(&self) -> &K {\n        &self.map.table.slot(self.bucket).0\n    }\n\n    #[effects(K, V, A)]\n    pub fn get(&self) -> &V {\n        &self.map.table.slot(self.bucket).1\n    }\n\n    #[effects(K, V, A)]\n    pub fn get_mut(&mut self) -> &mut V {\n        &mut self.map.table.slot_mut(self.bucket).1\n    }\n\n    // The value, as long as the map's borrow.\n    #[effects(K, V, A)]\n    pub fn into_mut(self) -> &'a mut V {\n        let bucket = self.bucket;\n        let map = self.map;\n        &mut map.table.slot_mut(bucket).1\n    }\n\n    // Stores v; the old value.\n    #[effects(K, V, A, S)]\n    pub fn insert(&mut self, v: V) -> V {\n        crate::mem::replace(self.get_mut(), v)\n    }\n\n    // Removes the entry; its value.\n    #[effects(K, V, A, S)]\n    pub fn remove(self) -> V {\n        self.remove_entry().1\n    }\n\n    #[effects(K, V, A)]\n    pub fn remove_entry(self) -> (K, V) {\n        self.map.table.take(self.bucket)\n    }\n}\n\n// A key's place that is empty.\npub struct VacantEntry<'a, K, V, A: Allocator, S> {\n    map: &'a mut HashMap<K, V, A, S>,\n    key: K,\n    hash: u64,\n}\n\nimpl<'a, K, V, A: Allocator, S> VacantEntry<'a, K, V, A, S> {\n    #[effects()]\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    #[effects()]\n    pub fn into_key(self) -> K {\n        self.key\n    }\n\n    // Stores v under the key; a &mut to it, as long as the map's borrow.\n    #[effects(K, V, A)]\n    pub fn insert(self, v: V) -> &'a mut V {\n        let hash = self.hash;\n        let key = self.key;\n        let map = self.map;\n        // entry() reserved the room, so growth_left > 0 here.\n");
    buf_str(out, c"        let i = map.table.find_insert_slot(hash);\n        map.table.put(i, hash, (key, v));\n        &mut map.table.slot_mut(i).1\n    }\n\n    // The map's allocator (or_default's).\n    fn map_allocator(&self) -> &A {\n        self.map.allocator()\n    }\n}\n\n// ---- The iterators ----\n\n// HashMap::iter's iterator.\n// mvs: HashMapIter\n// std2: renamed\npub struct Iter<'a, K, V> {\n    ctrl: *const u8,\n    data: *const (K, V),\n    at: usize,\n    left: usize,\n    marker: PhantomData<&'a (K, V)>,\n}\n\n// UNSAFE: Iter walks the table through raw pointers: stated, as Rust's.\n// SAFETY: it is a shared borrow of the entries for 'a (its PhantomData of\n// `&'a (K, V)`): Send and Sync as `&(K, V)` is.\nunsafe impl<'a, K: Sync, V: Sync> Send for Iter<'a, K, V> {}\n// UNSAFE: as Send's, above.\n// SAFETY: as Send's: it hands out only `&K` and `&V`.\nunsafe impl<'a, K: Sync, V: Sync> Sync for Iter<'a, K, V> {}\n\nimpl<'a, K, V> Clone for Iter<'a, K, V> {\n    fn clone(&self) -> Iter<'a, K, V> {\n        Iter { ctrl: self.ctrl, data: self.data, at: self.at, left: self.left, marker: PhantomData }\n    }\n}\n\nimpl<'a, K, V> Iterator for Iter<'a, K, V> {\n    type Item = (&'a K, &'a V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a V)> {\n        while self.left > 0 {\n            let i = self.at;\n            self.at += 1;\n            let c = self.ctrl;\n            let d = self.data;\n            // UNSAFE: the table's arrays read through the iterator's pointers.\n            // SAFETY: left > 0, so a full slot is at or after at, within the\n            // table's cap; the iterator borrows the map for 'a, so the entry\n            // stays where it is.\n            if unsafe { *c.add(i) } < DELETED {\n                self.left -= 1;\n                // UNSAFE: the full slot's entry lent for 'a.\n                // SAFETY: as above: in bounds, full, and the map is borrowed for 'a.\n                let e: &'a (K, V) = unsafe { &*d.add(i) };\n");
    buf_str(out, c"                return Option::Some((&e.0, &e.1));\n            }\n        }\n        Option::None\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.left, Option::Some(self.left))\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Iter<'a, K, V> {}\n\n// HashMap::iter_mut's iterator.\npub struct IterMut<'a, K, V> {\n    ctrl: *const u8,\n    data: *mut (K, V),\n    at: usize,\n    left: usize,\n    marker: PhantomData<&'a mut (K, V)>,\n}\n\n// UNSAFE: IterMut walks the table through raw pointers: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the entries for 'a: sending it\n// sends what `&mut (K, V)` would (K: Send, V: Send).\nunsafe impl<'a, K: Send, V: Send> Send for IterMut<'a, K, V> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&IterMut` reads entries through `&K` and `&V` only.\nunsafe impl<'a, K: Sync, V: Sync> Sync for IterMut<'a, K, V> {}\n\nimpl<'a, K, V> Iterator for IterMut<'a, K, V> {\n    type Item = (&'a K, &'a mut V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a mut V)> {\n        while self.left > 0 {\n            let i = self.at;\n            self.at += 1;\n            let c = self.ctrl;\n            let d = self.data;\n            // UNSAFE: the table's arrays read through the iterator's pointers.\n            // SAFETY: left > 0, so a full slot is at or after at, within the\n            // table's cap; the map is borrowed mutably for 'a and each slot is\n            // given out once (at only grows), so the &mut V's do not alias.\n            if unsafe { *c.add(i) } < DELETED {\n                self.left -= 1;\n                // UNSAFE: the full slot's entry lent mutably for 'a.\n                // SAFETY: as above: in bounds, full, each slot given out once.\n                let e: &'a mut (K, V) = unsafe { &mut *d.add(i) };\n                return Option::Some((&e.0, &mut e.1));\n            }\n        }\n        Option::None\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n");
    buf_str(out, c"        (self.left, Option::Some(self.left))\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for IterMut<'a, K, V> {}\n\n// HashMap::keys's iterator.\n// mvs: Keys\npub struct Keys<'a, K, V> {\n    inner: Iter<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for Keys<'a, K, V> {\n    type Item = &'a K;\n\n    fn next(&mut self) -> Option<&'a K> {\n        self.inner.next().map(|(k, _)| k)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Keys<'a, K, V> {}\n\n// HashMap::values's iterator.\n// mvs: Values\npub struct Values<'a, K, V> {\n    inner: Iter<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for Values<'a, K, V> {\n    type Item = &'a V;\n\n    fn next(&mut self) -> Option<&'a V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Values<'a, K, V> {}\n\n// HashMap::values_mut's iterator.\npub struct ValuesMut<'a, K, V> {\n    inner: IterMut<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for ValuesMut<'a, K, V> {\n    type Item = &'a mut V;\n\n    fn next(&mut self) -> Option<&'a mut V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\n// A map's entries, by value.\npub struct IntoIter<K, V, A: Allocator> {\n    table: RawTable<(K, V), A>,\n    at: usize,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoIter<K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        let i = self.table.next_full(self.at);\n        if i >= self.table.cap {\n            return Option::None;\n        }\n        self.at = i + 1;\n        Option::Some(self.table.take(i))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.table.items, Option::Some(self.table.items))\n    }\n}\n\n");
    buf_str(out, c"impl<K, V, A: Allocator> ExactSizeIterator for IntoIter<K, V, A> {}\n\n// HashMap::into_keys's iterator.\npub struct IntoKeys<K, V, A: Allocator> {\n    inner: IntoIter<K, V, A>,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoKeys<K, V, A> {\n    type Item = K;\n\n    fn next(&mut self) -> Option<K> {\n        self.inner.next().map(|(k, _)| k)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\n// HashMap::into_values's iterator.\npub struct IntoValues<K, V, A: Allocator> {\n    inner: IntoIter<K, V, A>,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoValues<K, V, A> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\n// HashMap::drain's iterator.\npub struct Drain<'a, K, V, A: Allocator> {\n    table: *mut RawTable<(K, V), A>,\n    at: usize,\n    marker: PhantomData<&'a mut RawTable<(K, V), A>>,\n}\n\n// UNSAFE: Drain reaches its table through a raw pointer: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the table for 'a: Send and Sync as\n// `&'a mut RawTable<(K, V), A>` is.\nunsafe impl<'a, K: Send, V: Send, A: Allocator + Send> Send for Drain<'a, K, V, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Drain` reads entries through `&K` and `&V` only.\nunsafe impl<'a, K: Sync, V: Sync, A: Allocator + Sync> Sync for Drain<'a, K, V, A> {}\n\nimpl<'a, K, V, A: Allocator> Iterator for Drain<'a, K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        // UNSAFE: the table reached through the pointer drain took.\n        // SAFETY: the Drain borrows the map mutably for 'a, so the table is\n        // valid and nothing else uses it.\n        let t = unsafe { &mut *self.table };\n        let i = t.next_full(self.at);\n        if i >= t.cap {\n            return Option::None;\n        }\n        self.at = i + 1;\n");
    buf_str(out, c"        Option::Some(t.take(i))\n    }\n}\n\nimpl<'a, K, V, A: Allocator> crate::ops::Drop for Drain<'a, K, V, A> {\n    fn drop(&mut self) {\n        // UNSAFE: the table reached through the pointer drain took.\n        // SAFETY: as in next: the map is borrowed mutably for 'a.\n        let t = unsafe { &mut *self.table };\n        t.clear();\n    }\n}\n// ---- end mod std::collections::hash_map ----\n}\n// ---- mod std::collections::hash_set ----\npub mod hash_set {\n// EDITION: rust\n// std::collections::hash_set: HashSet<T, A, S>, a HashMap<T, (), A, S>,\n// and its iterators. As HashMap: A always written, S defaulted to\n// FixedState and last, lookups by a reference to anything T Borrows.\n\nuse crate::alloc::Allocator;\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{BuildHasher, FixedState, Hash};\nuse crate::iter::{Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::option::Option;\n\nuse super::hash_map::{HashMap, self};\n\n// A set of T on A, hashed by S.\n// std2: changed: an S, defaulted; the bounds moved to the impls\npub struct HashSet<T, A: Allocator, S = FixedState> {\n    map: HashMap<T, (), A, S>,\n}\n\nimpl<T, A: Allocator> HashSet<T, A, FixedState> {\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> HashSet<T, A, FixedState> {\n        HashSet { map: HashMap::new_in(a) }\n    }\n\n    #[effects(T, A)]\n    pub fn with_capacity_in(n: usize, a: A) -> HashSet<T, A, FixedState> {\n        HashSet { map: HashMap::with_capacity_in(n, a) }\n    }\n}\n\nimpl<T, A: Allocator, S> HashSet<T, A, S> {\n    #[effects(T, A, S)]\n    pub fn with_hasher_in(hasher: S, a: A) -> HashSet<T, A, S> {\n        HashSet { map: HashMap::with_hasher_in(hasher, a) }\n    }\n\n    #[effects(T, A, S)]\n    pub fn len(&self) -> usize {\n        self.map.len()\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_empty(&self) -> bool {\n");
    buf_str(out, c"        self.map.is_empty()\n    }\n\n    #[effects(T, A, S)]\n    pub fn capacity(&self) -> usize {\n        self.map.capacity()\n    }\n\n    // std2: changed: returns &A\n    #[effects(T, A, S)]\n    pub fn allocator(&self) -> &A {\n        self.map.allocator()\n    }\n\n    #[effects(T, A, S)]\n    pub fn hasher(&self) -> &S {\n        self.map.hasher()\n    }\n\n    // Its elements, by reference.\n    // std2: changed: yields &T\n    #[effects(T, A, S)]\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { inner: self.map.keys() }\n    }\n\n    #[effects(T, A, S)]\n    pub fn clear(&mut self) {\n        self.map.clear()\n    }\n\n    // Every element, removed and yielded by the iterator.\n    #[effects(T, A, S)]\n    pub fn drain(&mut self) -> Drain<'_, T, A> {\n        Drain { inner: self.map.drain() }\n    }\n\n    // Keeps the elements f says true of.\n    #[effects(T, A, S)]\n    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        self.map.retain(|k, _| f(k))\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> HashSet<T, A, S> {\n    #[effects(T, A, S)]\n    pub fn reserve(&mut self, n: usize) {\n        self.map.reserve(n)\n    }\n\n    // std2: changed: takes &Q\n    #[effects(T, A, S, Q)]\n    pub fn contains<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.contains_key(x)\n    }\n\n    // The stored element equal to x.\n    #[effects(T, A, S, Q)]\n    pub fn get<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> Option<&T>\n        where\n            T: Borrow<Q>,\n    {\n        self.map.get_key_value(x).map(|(k, _)| k)\n    }\n\n    // Adds x; false when it was there already.\n    #[effects(T, A, S)]\n    pub fn insert(&mut self, x: T) -> bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    // Adds x, replacing an equal element; the old one.\n    #[effects(T, A, S)]\n    pub fn replace(&mut self, x: T) -> Option<T> {\n");
    buf_str(out, c"        let old = self.map.remove_entry(&x);\n        self.map.insert(x, ());\n        match old {\n            Option::Some((k, _)) => Option::Some(k),\n            Option::None => Option::None,\n        }\n    }\n\n    // Removes x; whether it was there.\n    // std2: changed: takes &Q\n    #[effects(T, A, S, Q)]\n    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove(x).is_some()\n    }\n\n    // Removes and returns the stored element equal to x.\n    #[effects(T, A, S, Q)]\n    pub fn take<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> Option<T>\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove_entry(x).map(|(k, _)| k)\n    }\n\n    // The elements of either, each once.\n    #[effects(T, A, S)]\n    pub fn union<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Union<'a, T, A, S> {\n        Union { a: self.iter(), b: other.iter(), a_set: self }\n    }\n\n    // The elements of both.\n    #[effects(T, A, S)]\n    pub fn intersection<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Intersection<'a, T, A, S> {\n        Intersection { a: self.iter(), other: other }\n    }\n\n    // The elements of self that other has not.\n    #[effects(T, A, S)]\n    pub fn difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Difference<'a, T, A, S> {\n        Difference { a: self.iter(), other: other }\n    }\n\n    // The elements of one of them only.\n    #[effects(T, A, S)]\n    pub fn symmetric_difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> SymmetricDifference<'a, T, A, S> {\n        SymmetricDifference { a: self.difference(other), b: other.difference(self) }\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_disjoint(&self, other: &HashSet<T, A, S>) -> bool {\n        self.iter().all(|x| !other.contains(x))\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_subset(&self, other: &HashSet<T, A, S>) -> bool {\n        self.iter().all(|x| other.contains(x))\n    }\n\n");
    buf_str(out, c"    #[effects(T, A, S)]\n    pub fn is_superset(&self, other: &HashSet<T, A, S>) -> bool {\n        other.is_subset(self)\n    }\n}\n\n// std2: changed: needs A: Clone and S: Clone\nimpl<T: Hash + Eq + Clone, A: Allocator + Clone, S: BuildHasher + Clone> Clone for HashSet<T, A,\n    S> {\n    fn clone(&self) -> HashSet<T, A, S> {\n        HashSet { map: self.map.clone() }\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, B: Allocator,\n    S: BuildHasher> PartialEq<HashSet<T, B, S>> for HashSet<T, A, S> {\n    fn eq(&self, other: &HashSet<T, B, S>) -> bool {\n        self.len() == other.len() && self.iter().all(|x| other.contains(x))\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> Eq for HashSet<T, A, S> {}\n\nimpl<T: Debug, A: Allocator, S> Debug for HashSet<T, A, S> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_set().entries(self.iter()).finish()\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> Extend<T> for HashSet<T, A, S> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.insert(x);\n        }\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher + Default> FromIteratorIn<T, A> for HashSet<T, A,\n    S> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> HashSet<T, A, S> {\n        let mut s: HashSet<T, A, S> = HashSet::with_hasher_in(S::default(), a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T, A: Allocator, S: Default> DefaultIn<A> for HashSet<T, A, S> {\n    fn default_in(a: A) -> HashSet<T, A, S> {\n        HashSet::with_hasher_in(S::default(), a)\n    }\n}\n\nimpl<T, A: Allocator, S> IntoIterator for HashSet<T, A, S> {\n    type Item = T;\n    type IntoIter = IntoIter<T, A>;\n\n    fn into_iter(self) -> IntoIter<T, A> {\n        IntoIter { inner: self.map.into_keys() }\n    }\n}\n\nimpl<'a, T, A: Allocator, S> IntoIterator for &'a HashSet<T, A, S> {\n    type Item = &'a T;\n");
    buf_str(out, c"    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\n// HashSet::iter's iterator.\n// mvs: HashSetIter\n// std2: renamed\npub struct Iter<'a, T> {\n    inner: hash_map::Keys<'a, T, ()>,\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        self.inner.next()\n    }\n}\n\n// A set's elements, by value.\npub struct IntoIter<T, A: Allocator> {\n    inner: hash_map::IntoKeys<T, (), A>,\n}\n\nimpl<T, A: Allocator> Iterator for IntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.next()\n    }\n}\n\n// HashSet::drain's iterator.\npub struct Drain<'a, T, A: Allocator> {\n    inner: hash_map::Drain<'a, T, (), A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.next().map(|(k, _)| k)\n    }\n}\n\n// HashSet::union's iterator.\npub struct Union<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    b: Iter<'a, T>,\n    a_set: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Union<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        if let Option::Some(x) = self.a.next() {\n            return Option::Some(x);\n        }\n        while let Option::Some(x) = self.b.next() {\n            if !self.a_set.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::intersection's iterator.\npub struct Intersection<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    other: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Intersection<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        while let Option::Some(x) = self.a.next() {\n            if self.other.contains(x) {\n");
    buf_str(out, c"                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::difference's iterator.\npub struct Difference<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    other: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Difference<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        while let Option::Some(x) = self.a.next() {\n            if !self.other.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::symmetric_difference's iterator.\npub struct SymmetricDifference<'a, T, A: Allocator, S> {\n    a: Difference<'a, T, A, S>,\n    b: Difference<'a, T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for SymmetricDifference<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.a.next() {\n            Option::Some(x) => Option::Some(x),\n            Option::None => self.b.next(),\n        }\n    }\n}\n// ---- end mod std::collections::hash_set ----\n}\n// ---- end mod std::collections ----\n}\n// ---- mod std::iter ----\npub mod iter {\n// EDITION: rust\n// std::iter: Iterator, the traits around it, the adapters and the\n// sources. Rust's shape: an adapter takes self by value and returns a\n// named struct (no `impl Trait` in return position), a closure that only\n// looks takes `&Self::Item` (filter, find, position's FnMut(Self::Item)),\n// and what collects names its allocator: `collect_in(a)` over\n// FromIteratorIn, the result's type given by the context (`let v:\n// Vec<_, Gpa> = it.collect_in(gpa);`) or a turbofish.\n\nmod adapters;\nmod sources;\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::cmp::{Ord, Ordering, PartialEq, PartialOrd};\nuse crate::default::DefaultIn;\nuse crate::ops::{Add, Mul, Range, RangeFrom, RangeInclusive};\nuse crate: