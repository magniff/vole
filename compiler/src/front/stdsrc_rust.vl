    buf_str(out, c"        crate::result::Result::Ok(())\n    }\n}\n\n// Everything r has left, as a String on a (Rust's io::read_to_string).\n// mvs: read_stdin_in\n// std2: changed: any reader, a String (MVS: stdin's bytes as a Vec)\n#[effects(R, A)]\npub fn read_to_string_in<R: Read, A: Allocator>(r: R, a: A) -> Result<String<A>> {\n    let mut r = r;\n    let mut s = String::new_in(a);\n    r.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// Everything from r, written to w; how many bytes.\n#[effects(alloc, io, static, panic, diverge, unsafe, R, W)]\npub fn copy<R: Read + ?Sized, W: Write + ?Sized>(r: &mut R, w: &mut W) -> Result<u64> {\n    let mut buf = [0u8; 8192];\n    let mut total: u64 = 0;\n    loop {\n        let n = match r.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        w.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// A reader with nothing in it.\n#[effects()]\npub fn empty() -> Empty {\n    Empty {}\n}\n\npub struct Empty {}\n\nimpl Read for Empty {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::result::Result::Ok(0)\n    }\n}\n\n// A writer that drops what it is given.\n#[effects()]\npub fn sink() -> Sink {\n    Sink {}\n}\n\npub struct Sink {}\n\nimpl Write for Sink {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A &mut of a reader or writer is one.\nimpl<R: Read + ?Sized> Read for &mut R {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        (**self).read(buf)\n    }\n}\n\n");
    buf_str(out, c"impl<W: Write + ?Sized> Write for &mut W {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        (**self).write(buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        (**self).flush()\n    }\n}\n\n// Bytes in memory as a reader (`Read for &[u8]`).\nimpl Read for &[u8] {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        let n = crate::cmp::min(buf.len(), self.len());\n        let (a, b) = self.split_at(n);\n        buf[..n].copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(n)\n    }\n\n    // All of buf, or UnexpectedEof with buf untouched and the slice used up\n    // (Rust's).\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        if buf.len() > self.len() {\n            *self = &self[self.len()..];\n            return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                \"failed to fill whole buffer\"));\n        }\n        let (a, b) = self.split_at(buf.len());\n        buf.copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(())\n    }\n}\n\n// A Vec<u8, A> as a writer: write grows it from A.\nimpl<A: Allocator> Write for Vec<u8, A> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        self.extend_from_slice(buf);\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n// ---- end mod std::io ----\n}\n// ---- mod std::fs ----\npub mod fs {\n// EDITION: rust\n// std::fs: files and directories, Rust's. A path is a `P: AsRef<str>`\n// (Rust's `AsRef<Path>`: a &str, a &String, a std::path::Path or a\n// &PathBuf; 0.28.0, std::path's named divergence); it reaches C as a NUL-ended copy on the stack, so nothing here allocates\n// but what returns a Vec or a String, on the allocator given. A path that\n// holds a NUL is InvalidInput, one longer than the system's PATH_MAX the\n");
    buf_str(out, c"// OS's ENAMETOOLONG (Rust passes it to the OS, which says the same).\n// mvs: std::fs\n\nuse crate::alloc::Allocator;\nuse crate::convert::AsRef;\nuse crate::io::{Error, ErrorKind, Read, Result, Seek, SeekFrom, Write};\nuse crate::iter::Iterator;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::time::SystemTime;\nuse crate::vec::Vec;\n\n// UNSAFE: the OS's file and directory calls, which take NUL-ended paths\n// and buffers as raw pointers.\n// SAFETY: POSIX's prototypes (fcntl.h, unistd.h, sys/stat.h, dirent.h,\n// stdio.h); open's mode is variadic, as declared. The callers pass a\n// CPath's buffer (NUL-ended), a StatBuf's words (larger than either\n// system's struct stat) and a DIR * that opendir returned.\nextern \"C\" {\n    #[link_name = \"open\"]\n    fn fs_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn fs_c_close(fd: i32) -> i32;\n    #[link_name = \"lseek\"]\n    fn fs_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    fn fs_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    fn fs_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fchmod\"]\n    fn fs_c_fchmod(fd: i32, mode: u32) -> i32;\n    #[link_name = \"fstat\"]\n    fn fs_c_fstat(fd: i32, buf: *mut u64) -> i32;\n    #[link_name = \"stat\"]\n    fn fs_c_stat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"lstat\"]\n    fn fs_c_lstat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"mkdir\"]\n    fn fs_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    fn fs_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    fn fs_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    fn fs_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"opendir\"]\n    fn fs_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    fn fs_c_readdir(dir: *mut u8) -> *const u8;\n");
    buf_str(out, c"    #[link_name = \"closedir\"]\n    fn fs_c_closedir(dir: *mut u8) -> i32;\n}\n\nconst O_RDONLY: i32 = 0;\nconst O_WRONLY: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst S_IFMT: u32 = 0xf000;\nconst S_IFDIR: u32 = 0x4000;\nconst S_IFREG: u32 = 0x8000;\nconst S_IFLNK: u32 = 0xa000;\nconst DT_DIR: u8 = 4;\nconst DT_REG: u8 = 8;\nconst DT_LNK: u8 = 10;\nconst EINVAL: i32 = 22;\n\n// A path and its NUL, as C takes it.\nstruct CPath {\n    buf: [u8; crate::__sys::PATH_MAX],\n}\n\nimpl CPath {\n    #[effects()]\n    fn ptr(&self) -> *const u8 {\n        &self.buf[0] as *const u8\n    }\n}\n\n// path as C takes it: InvalidInput when it holds a NUL, ENAMETOOLONG when\n// it does not fit.\n#[effects(panic, diverge)]\nfn cpath(path: &str) -> Result<CPath> {\n    let b = path.as_bytes();\n    let mut p = CPath { buf: [0u8; crate::__sys::PATH_MAX] };\n    if b.len() >= p.buf.len() {\n        return crate::result::Result::Err(Error::from_raw_os_error(crate::__sys::ENAMETOOLONG));\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 {\n            return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n                \"file name contained an unexpected NUL byte\"));\n        }\n        p.buf[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(p)\n}\n\n// A C call's -1 as the io::Error errno says.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn cvt(r: i32) -> Result<()> {\n    if r < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(())\n    }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn open_c(path: &str, flags: i32, mode: u32) -> Result<File> {\n    let p = cpath(path)?;\n    // UNSAFE: C's open. SAFETY: p is NUL-ended and lives past the call;\n    // the mode is the variadic int open reads when it creates the file.\n    let fd = unsafe { fs_c_open(p.ptr(), flags | crate::__sys::O_CLOEXEC, mode as i32) };\n");
    buf_str(out, c"    if fd < 0 {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    crate::result::Result::Ok(File { fd: fd })\n}\n\n// Room for either system's struct stat (144 bytes on macOS, 128 on Linux).\nstruct StatBuf {\n    words: [u64; 20],\n}\n\n#[effects()]\nfn metadata_of(b: &StatBuf) -> Metadata {\n    let (mode, size, mtime, mtime_nsec) = crate::__sys::stat_fields(&b.words);\n    Metadata { mode: mode, size: size, mtime: mtime, mtime_nsec: mtime_nsec }\n}\n\n// stat, or lstat (follow false), of the file at path.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn stat_at(path: &str, follow: bool) -> Result<Metadata> {\n    let p = cpath(path)?;\n    let mut b = StatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat and lstat. SAFETY: p is NUL-ended; b.words is 160\n    // bytes, 8-aligned, more than either system's struct stat.\n    let r = unsafe {\n        if follow {\n            fs_c_stat(p.ptr(), &mut b.words[0] as *mut u64)\n        } else {\n            fs_c_lstat(p.ptr(), &mut b.words[0] as *mut u64)\n        }\n    };\n    cvt(r)?;\n    crate::result::Result::Ok(metadata_of(&b))\n}\n\n// ---- Files ----\n\n// An open file; dropping it closes it.\npub struct File {\n    fd: i32,\n}\n\nimpl Drop for File {\n    fn drop(&mut self) {\n        // UNSAFE: C's close. SAFETY: fd is this File's own descriptor,\n        // closed once (here).\n        let _ = unsafe { fs_c_close(self.fd) };\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn open<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDONLY, 0x1b6)\n    }\n\n    // Opens path for writing: made when it is not there, emptied when it is.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn create<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n");
    buf_str(out, c"        open_c(path, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC, 0x1b6)\n    }\n\n    // Makes path and opens it for reading and writing: AlreadyExists when\n    // it is there.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn create_new<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDWR | crate::__sys::O_CREAT | crate::__sys::O_EXCL, 0x1b6)\n    }\n\n    // The options to open a file with: `File::options().append(true)`.\n    #[effects()]\n    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    // std2: changed: File's own (Rust's: std::os::fd::AsRawFd)\n    #[effects()]\n    pub fn as_raw_fd(&self) -> i32 {\n        self.fd\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        let mut b = StatBuf { words: [0u64; 20] };\n        // UNSAFE: C's fstat. SAFETY: b.words as in stat_at.\n        cvt(unsafe { fs_c_fstat(self.fd, &mut b.words[0] as *mut u64) })?;\n        crate::result::Result::Ok(metadata_of(&b))\n    }\n\n    // Its length becomes size (cut, or zeros after).\n    // std2: changed: u64 (MVS: i64)\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn set_len(&self, size: u64) -> Result<()> {\n        if size > i64::MAX as u64 {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        // UNSAFE: C's ftruncate. SAFETY: integers only.\n        cvt(unsafe { fs_c_ftruncate(self.fd, size as i64) })\n    }\n\n    // What the system holds of it, written to the disk.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn sync_all(&self) -> Result<()> {\n        // UNSAFE: C's fsync. SAFETY: an int only.\n        cvt(unsafe { fs_c_fsync(self.fd) })\n    }\n}\n\n// `File { fd: 3 }`.\n");
    buf_str(out, c"// std2: changed: the descriptor only (Rust's adds the path and the mode)\nimpl crate::fmt::Debug for File {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"File\").field(\"fd\", &self.fd).finish()\n    }\n}\n\nimpl Read for File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Write for File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A shared File reads and writes too (the OS keeps its position).\nimpl Read for &File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read((*self).fd, buf)\n    }\n}\n\nimpl Write for &File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write((*self).fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// mvs: File::seek\nimpl Seek for File {\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64> {\n        let (off, whence) = match pos {\n            SeekFrom::Start(o) => {\n                if o > i64::MAX as u64 {\n                    return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n                }\n                (o as i64, 0)\n            }\n            SeekFrom::Current(o) => (o, 1),\n            SeekFrom::End(o) => (o, 2),\n        };\n        // UNSAFE: C's lseek. SAFETY: integers only.\n        let r = unsafe { fs_c_lseek(self.fd, off, whence) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(r as u64)\n    }\n}\n\n// How File::open opens a file, Rust's builder:\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n#[derive(Clone, Debug)]\npub struct OpenOptions {\n    read: bool,\n");
    buf_str(out, c"    write: bool,\n    append: bool,\n    truncate: bool,\n    create: bool,\n    create_new: bool,\n    mode: u32,\n}\n\nimpl OpenOptions {\n    // Every option off (open fails until read, write or append is on).\n    #[effects()]\n    pub fn new() -> OpenOptions {\n        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn read(&mut self, read: bool) -> &mut OpenOptions {\n        self.read = read;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn write(&mut self, write: bool) -> &mut OpenOptions {\n        self.write = write;\n        self\n    }\n\n    // Writes go to the end (write is implied).\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn append(&mut self, append: bool) -> &mut OpenOptions {\n        self.append = append;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {\n        self.truncate = truncate;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create(&mut self, create: bool) -> &mut OpenOptions {\n        self.create = create;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {\n        self.create_new = create_new;\n        self\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    // std2: changed: OpenOptions' own, a u32 (Rust's:\n    // std::os::unix::fs::OpenOptionsExt)\n    #[effects()]\n    pub fn mode(&mut self, mode: u32) -> &mut OpenOptions {\n        self.mode = mode;\n        self\n    }\n\n");
    buf_str(out, c"    // Opens path with these options: InvalidInput (EINVAL) for none of\n    // read, write and append, or a create or truncate without a write, as\n    // Rust's.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn open<P: AsRef<str>>(&self, path: P) -> Result<File> {\n        let path = path.as_ref();\n        let access = if self.append {\n            (if self.read { O_RDWR } else { O_WRONLY }) | crate::__sys::O_APPEND\n        } else if self.read && self.write {\n            O_RDWR\n        } else if self.write {\n            O_WRONLY\n        } else if self.read {\n            O_RDONLY\n        } else {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        };\n        if !self.write && !self.append && (self.truncate || self.create || self.create_new) {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        if self.append && self.truncate && !self.create_new {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        let creation = if self.create_new {\n            crate::__sys::O_CREAT | crate::__sys::O_EXCL\n        } else {\n            (if self.create { crate::__sys::O_CREAT } else { 0 })\n                | (if self.truncate { crate::__sys::O_TRUNC } else { 0 })\n        };\n        open_c(path, access | creation, self.mode)\n    }\n}\n\n// What stat says of a file.\n#[derive(Clone)]\npub struct Metadata {\n    mode: u32,\n    size: u64,\n    mtime: i64,\n    mtime_nsec: i64,\n}\n\nimpl Metadata {\n    // The size in bytes.\n    #[effects()]\n    pub fn len(&self) -> u64 {\n        self.size\n    }\n\n    #[effects()]\n    pub fn file_type(&self) -> FileType {\n        FileType { fmt: self.mode & S_IFMT }\n    }\n\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.mode & S_IFMT == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.mode & S_IFMT == S_IFREG\n");
    buf_str(out, c"    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.mode & S_IFMT == S_IFLNK\n    }\n\n    #[effects()]\n    pub fn permissions(&self) -> Permissions {\n        Permissions { mode: self.mode }\n    }\n\n    // When it was last written (UNIX_EPOCH for a time before it).\n    // mvs: Metadata::modified\n    // std2: changed: an io::Result<SystemTime>, as Rust's (MVS: a\n    // Duration since the epoch)\n    #[effects(panic, diverge)]\n    pub fn modified(&self) -> Result<SystemTime> {\n        let epoch = crate::time::UNIX_EPOCH;\n        if self.mtime < 0 {\n            return crate::result::Result::Ok(epoch);\n        }\n        let d = crate::time::Duration::new(self.mtime as u64, self.mtime_nsec as u32);\n        match epoch.checked_add(d) {\n            Option::Some(t) => crate::result::Result::Ok(t),\n            Option::None => crate::result::Result::Ok(epoch),\n        }\n    }\n}\n\n// `Metadata { file_type: .., len: 6, .. }`.\n// std2: changed: the kind and the length (Rust's adds the permissions and\n// the times)\nimpl crate::fmt::Debug for Metadata {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Metadata\").field(\"file_type\", &self.file_type()).field(\"len\", &self.size)\n            .finish_non_exhaustive()\n    }\n}\n\n// A file's kind: a directory, a file, a symbolic link (or another).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct FileType {\n    fmt: u32,\n}\n\nimpl FileType {\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.fmt == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.fmt == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.fmt == S_IFLNK\n    }\n}\n\n// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as\n// Rust's.\nimpl crate::fmt::Debug for FileType {\n");
    buf_str(out, c"    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"FileType\").field(\"is_file\", &self.is_file()).field(\"is_dir\", &self.is_dir())\n            .field(\"is_symlink\", &self.is_symlink()).finish_non_exhaustive()\n    }\n}\n\n// A file's permission bits.\n#[derive(Clone, PartialEq, Eq)]\npub struct Permissions {\n    mode: u32,\n}\n\nimpl Permissions {\n    // Whether no one may write it.\n    #[effects()]\n    pub fn readonly(&self) -> bool {\n        self.mode & 0x92 == 0\n    }\n\n    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).\n    // mvs: Metadata::mode\n    // std2: changed: Permissions' own, st_mode as Rust's (Rust's:\n    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)\n    #[effects()]\n    pub fn mode(&self) -> u32 {\n        self.mode\n    }\n}\n\n// ---- Whole files ----\n\n// The bytes of the file at path, in a new Vec on a.\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read)\n#[effects(alloc, io, static, panic, diverge, unsafe, A)]\npub fn read_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<Vec<u8, A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let size = match f.metadata() {\n        crate::result::Result::Ok(m) => m.len() as usize,\n        crate::result::Result::Err(_) => 0,\n    };\n    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);\n    f.read_to_end(&mut v)?;\n    crate::result::Result::Ok(v)\n}\n\n// The text of the file at path, in a new String on a (InvalidData when it\n// is not UTF-8).\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read_to_string)\n#[effects(alloc, io, static, panic, diverge, unsafe, A)]\npub fn read_to_string_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<String<A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let mut s = String::new_in(a);\n    f.read_to_string(&mut s)?;\n");
    buf_str(out, c"    crate::result::Result::Ok(s)\n}\n\n// The file at path holds contents: made, or emptied first.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, C)]\npub fn write<P: AsRef<str>, C: AsRef<[u8]>>(path: P, contents: C) -> Result<()> {\n    let path = path.as_ref();\n    let mut f = File::create(path)?;\n    // (the path call: `contents.as_ref()` where a &[u8] is expected picks\n    // a wrong instance of AsRef for &T, 0.27.5's front gap)\n    f.write_all(AsRef::<[u8]>::as_ref(&contents))\n}\n\n// Copies the file at from to to (made, or emptied), its permission bits\n// too: the bytes copied.\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>); a u64 (MVS: i64)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn copy<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<u64> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let mut src = File::open(from)?;\n    let m = src.metadata()?;\n    if !m.is_file() {\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n            \"the source path is neither a regular file nor a symlink to a regular file\"));\n    }\n    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,\n        m.mode & 0xfff)?;\n    // UNSAFE: C's fchmod. SAFETY: integers only.\n    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;\n    let mut buf = [0u8; 65536];\n    let mut total: u64 = 0;\n    loop {\n        let n = match src.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        dst.write_all(&buf[..n])?;\n        to