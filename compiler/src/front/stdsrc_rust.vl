    buf_str(out, c"    fn next(&mut self) -> Option<(usize, &'a str)> {\n        crate::panic::todo()\n    }\n}\n\n// str::graphemes's iterator: vole's.\n// mvs: StrGraphemes\n// std2: renamed\npub struct Graphemes<'a> {\n    rest: &'a str,\n    extended: bool,\n}\n\nimpl<'a> Iterator for Graphemes<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        crate::panic::todo()\n    }\n}\n// ---- end mod std::str ----\n}\n// ---- mod std::char ----\npub mod char {\n// EDITION: rust\n// std::char: the methods of char, a Unicode scalar value (0..=0x10FFFF\n// less the surrogates), and the functions that make one. The rust front's\n// char type comes in 0.27.2 (`edition.later: char`); MVS had none (a code\n// point was a u32, `'x'` a u8), and in the rust edition `'x'` is a char\n// and `b'x'` a u8.\n\nuse crate::iter::Iterator;\nuse crate::option::Option;\n\nimpl char {\n    // The largest char, '\\u{10FFFF}'.\n    pub const MAX: char = '\\u{10FFFF}';\n\n    // U+FFFD, what bad UTF-8 decodes to.\n    pub const REPLACEMENT_CHARACTER: char = '\\u{FFFD}';\n\n    // i as a char, when it is a scalar value.\n    pub fn from_u32(i: u32) -> Option<char> {\n        crate::panic::todo()\n    }\n\n    // The digit d in radix (2..=36), as a char: from_digit(7, 10) is '7'.\n    pub fn from_digit(d: u32, radix: u32) -> Option<char> {\n        crate::panic::todo()\n    }\n\n    // Its value as a digit in radix: '7'.to_digit(10) is Some(7).\n    pub fn to_digit(self, radix: u32) -> Option<u32> {\n        crate::panic::todo()\n    }\n\n    pub fn is_digit(self, radix: u32) -> bool {\n        self.to_digit(radix).is_some()\n    }\n\n    pub fn is_alphabetic(self) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn is_numeric(self) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn is_alphanumeric(self) -> bool {\n        self.is_alphabetic() || self.is_numeric()\n    }\n\n    pub fn is_whitespace(self) -> bool {\n        crate::panic::todo()\n    }\n\n");
    buf_str(out, c"    pub fn is_uppercase(self) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn is_lowercase(self) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn is_control(self) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn is_ascii(&self) -> bool {\n        (*self as u32) < 0x80\n    }\n\n    pub fn is_ascii_alphabetic(&self) -> bool {\n        self.is_ascii_uppercase() || self.is_ascii_lowercase()\n    }\n\n    pub fn is_ascii_uppercase(&self) -> bool {\n        *self >= 'A' && *self <= 'Z'\n    }\n\n    pub fn is_ascii_lowercase(&self) -> bool {\n        *self >= 'a' && *self <= 'z'\n    }\n\n    pub fn is_ascii_digit(&self) -> bool {\n        *self >= '0' && *self <= '9'\n    }\n\n    pub fn is_ascii_hexdigit(&self) -> bool {\n        self.is_ascii_digit() || (*self >= 'a' && *self <= 'f') || (*self >= 'A' && *self <= 'F')\n    }\n\n    pub fn is_ascii_alphanumeric(&self) -> bool {\n        self.is_ascii_alphabetic() || self.is_ascii_digit()\n    }\n\n    pub fn is_ascii_whitespace(&self) -> bool {\n        *self == ' ' || *self == '\\t' || *self == '\\n' || *self == '\\r' || *self == '\\x0C'\n    }\n\n    pub fn is_ascii_punctuation(&self) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn to_ascii_uppercase(&self) -> char {\n        if self.is_ascii_lowercase() { ((*self as u8) - 32) as char } else { *self }\n    }\n\n    pub fn to_ascii_lowercase(&self) -> char {\n        if self.is_ascii_uppercase() { ((*self as u8) + 32) as char } else { *self }\n    }\n\n    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {\n        self.to_ascii_lowercase() == other.to_ascii_lowercase()\n    }\n\n    // Its upper case: one char or more ('ß' gives \"SS\").\n    pub fn to_uppercase(self) -> ToUppercase {\n        crate::panic::todo()\n    }\n\n    pub fn to_lowercase(self) -> ToLowercase {\n        crate::panic::todo()\n    }\n\n    // The bytes of its UTF-8, 1 to 4.\n    pub fn len_utf8(self) -> usize {\n");
    buf_str(out, c"        let c = self as u32;\n        if c < 0x80 {\n            1\n        } else if c < 0x800 {\n            2\n        } else if c < 0x10000 {\n            3\n        } else {\n            4\n        }\n    }\n\n    // Its UTF-8 written into buf (which must hold len_utf8 bytes), as a str.\n    pub fn encode_utf8(self, buf: &mut [u8]) -> &mut str {\n        crate::panic::todo()\n    }\n\n    // Its width in terminal columns: vole's (str::width's, for one char).\n    pub fn width(self) -> usize {\n        crate::panic::todo()\n    }\n}\n\n// A char's upper case, one char or more.\n#[derive(Clone, Debug)]\npub struct ToUppercase {\n    chars: [char; 3],\n    at: usize,\n    len: usize,\n}\n\nimpl Iterator for ToUppercase {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.at == self.len {\n            return Option::None;\n        }\n        self.at += 1;\n        Option::Some(self.chars[self.at - 1])\n    }\n}\n\n// A char's lower case, one char or more.\n#[derive(Clone, Debug)]\npub struct ToLowercase {\n    chars: [char; 3],\n    at: usize,\n    len: usize,\n}\n\nimpl Iterator for ToLowercase {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.at == self.len {\n            return Option::None;\n        }\n        self.at += 1;\n        Option::Some(self.chars[self.at - 1])\n    }\n}\n\n// i as a char, when it is a scalar value (char::from_u32).\npub fn from_u32(i: u32) -> Option<char> {\n    char::from_u32(i)\n}\n\n// The digit d in radix as a char (char::from_digit).\npub fn from_digit(d: u32, radix: u32) -> Option<char> {\n    char::from_digit(d, radix)\n}\n\n// Why a u32 is not a char.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct CharTryFromError(());\n// ---- end mod std::char ----\n}\n// ---- mod std::string ----\npub mod string {\n// EDITION: rust\n// std::string: String<A>, owned UTF-8 text on A's heap, and ToStringIn.\n");
    buf_str(out, c"// `String::new_in(a)`, `String::from_in(\"x\", a)`, `\"x\".to_string_in(a)`;\n// no `String::from(s)` and no `From<&str>` (it would allocate with no\n// allocator in the call: plan §2). A String has str's methods through\n// Deref; its own are the ones that change it, and they allocate from its\n// A only. MVS's Buf<A> (a byte buffer) is gone: a Vec<u8, A>, or a String.\n// `write(&mut s, \"{x}\")` (fmt::Write) is MVS's `s.push_fmt(\"{x}\")`.\n\nuse crate::alloc::{Allocator, TryReserveError};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::default::DefaultIn;\nuse crate::fmt::{Debug, Display, Formatter, Write};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::ops::{Add, AddAssign, Deref, DerefMut, Index, IndexMut, RangeBounds};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::slice::SliceIndex;\nuse crate::str::{Chars, Utf8Error};\nuse crate::vec::Vec;\n\n// UTF-8 text that owns its bytes, on A.\npub struct String<A: Allocator> {\n    vec: Vec<u8, A>,\n}\n\nimpl<A: Allocator> String<A> {\n    // An empty String on a; it allocates at its first push.\n    pub fn new_in(a: A) -> String<A> {\n        String { vec: Vec::new_in(a) }\n    }\n\n    pub fn with_capacity_in(cap: usize, a: A) -> String<A> {\n        String { vec: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A copy of s on a.\n    // std2: changed: takes &str\n    pub fn from_in(s: &str, a: A) -> String<A> {\n        let mut out = String::with_capacity_in(s.len(), a);\n        out.push_str(s);\n        out\n    }\n\n    // v as a String when it is UTF-8; the error gives v back.\n    // std2: changed: the error is FromUtf8Error<A>, which holds v (MVS: Utf8Error)\n    pub fn from_utf8(v: Vec<u8, A>) -> Result<String<A>, FromUtf8Error<A>> {\n");
    buf_str(out, c"        match crate::str::from_utf8(v.as_slice()) {\n            Result::Ok(_) => Result::Ok(String { vec: v }),\n            Result::Err(e) => Result::Err(FromUtf8Error { bytes: v, error: e }),\n        }\n    }\n\n    // UNSAFE: bytes that are not UTF-8 make a String whose str methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: Vec<u8, A>) -> String<A> {\n        String { vec: v }\n    }\n\n    // v as text on a, each bad sequence U+FFFD (Rust's from_utf8_lossy,\n    // which returns a Cow).\n    // std2: changed: takes &[u8]\n    pub fn from_utf8_lossy_in(v: &[u8], a: A) -> String<A> {\n        crate::panic::todo()\n    }\n\n    // Its length in bytes.\n    pub fn len(&self) -> usize {\n        self.vec.len()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.vec.is_empty()\n    }\n\n    pub fn capacity(&self) -> usize {\n        self.vec.capacity()\n    }\n\n    // std2: changed: returns &A (MVS: a copy of A)\n    pub fn allocator(&self) -> &A {\n        self.vec.allocator()\n    }\n\n    pub fn reserve(&mut self, extra: usize) {\n        self.vec.reserve(extra)\n    }\n\n    pub fn reserve_exact(&mut self, extra: usize) {\n        self.vec.reserve_exact(extra)\n    }\n\n    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {\n        self.vec.try_reserve(extra)\n    }\n\n    pub fn shrink_to_fit(&mut self) {\n        self.vec.shrink_to_fit()\n    }\n\n    // Empties it; the capacity stays.\n    pub fn clear(&mut self) {\n        self.vec.clear()\n    }\n\n    pub fn as_str(&self) -> &str {\n        crate::panic::todo()\n    }\n\n    pub fn as_mut_str(&mut self) -> &mut str {\n        crate::panic::todo()\n    }\n\n    // mvs: String::as_bytes, String::as_slice\n    pub fn as_bytes(&self) -> &[u8] {\n        self.vec.as_slice()\n    }\n\n    // Its bytes as a &mut Vec.\n    // UNSAFE: writing bytes that are not UTF-8 breaks the String.\n");
    buf_str(out, c"    // SAFETY: a contract on the caller: the bytes stay UTF-8.\n    pub unsafe fn as_mut_vec(&mut self) -> &mut Vec<u8, A> {\n        &mut self.vec\n    }\n\n    // Its bytes, the String consumed.\n    pub fn into_bytes(self) -> Vec<u8, A> {\n        self.vec\n    }\n\n    // Appends c's UTF-8.\n    // std2: changed: takes a char (MVS: a u32 code point)\n    pub fn push(&mut self, c: char) {\n        crate::panic::todo()\n    }\n\n    pub fn push_str(&mut self, s: &str) {\n        self.vec.extend_from_slice(s.as_bytes())\n    }\n\n    // The last char, removed.\n    // std2: changed: Option<char> (MVS: Option<u32>)\n    pub fn pop(&mut self) -> Option<char> {\n        crate::panic::todo()\n    }\n\n    // Keeps the first n bytes; panics when n is not a char boundary.\n    pub fn truncate(&mut self, n: usize) {\n        crate::panic::todo()\n    }\n\n    // Inserts c at byte i (a char boundary).\n    // std2: changed: takes a char\n    pub fn insert(&mut self, i: usize, c: char) {\n        crate::panic::todo()\n    }\n\n    pub fn insert_str(&mut self, i: usize, s: &str) {\n        crate::panic::todo()\n    }\n\n    // Removes the char at byte i.\n    // std2: changed: returns a char\n    pub fn remove(&mut self, i: usize) -> char {\n        crate::panic::todo()\n    }\n\n    // Keeps the chars f says true of.\n    // std2: changed: FnMut(char) (MVS: FnMut(u32))\n    pub fn retain<F: FnMut(char) -> bool>(&mut self, f: F) {\n        crate::panic::todo()\n    }\n\n    // The chars in range, removed and yielded by the iterator.\n    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, A> {\n        crate::panic::todo()\n    }\n\n    // The text from byte at on, as a new String on a clone of A.\n    pub fn split_off(&mut self, at: usize) -> String<A>\n        where\n            A: Clone,\n    {\n        crate::panic::todo()\n    }\n\n    // Replaces the bytes in range with s.\n");
    buf_str(out, c"    pub fn replace_range<R: RangeBounds<usize>>(&mut self, range: R, s: &str) {\n        crate::panic::todo()\n    }\n\n    // Appends a copy of its own bytes in src.\n    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {\n        self.vec.extend_from_within(src)\n    }\n\n    // A copy on another allocator.\n    pub fn clone_in<B: Allocator>(&self, b: B) -> String<B> {\n        String::from_in(self.as_str(), b)\n    }\n\n    // The text, never freed.\n    pub fn leak<'a>(self) -> &'a mut str\n        where\n            A: 'a,\n    {\n        crate::panic::todo()\n    }\n\n    // Moves the String out, leaving an empty one on a clone of its allocator.\n    pub fn take(&mut self) -> String<A>\n        where\n            A: Clone,\n    {\n        String { vec: self.vec.take() }\n    }\n}\n\nimpl<A: Allocator> Deref for String<A> {\n    type Target = str;\n\n    fn deref(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> DerefMut for String<A> {\n    fn deref_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\nimpl<I: SliceIndex<str>, A: Allocator> Index<I> for String<A> {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self.as_str())\n    }\n}\n\nimpl<I: SliceIndex<str>, A: Allocator> IndexMut<I> for String<A> {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self.as_mut_str())\n    }\n}\n\n// A copy on the same allocator (a clone of it).\n// std2: changed: needs A: Clone\nimpl<A: Allocator + Clone> Clone for String<A> {\n    fn clone(&self) -> String<A> {\n        String { vec: self.vec.clone() }\n    }\n}\n\n// mvs: String::impl Eq\n// std2: changed: PartialEq with any String<B>, str and &str\nimpl<A: Allocator, B: Allocator> PartialEq<String<B>> for String<A> {\n    fn eq(&self, other: &String<B>) -> bool {\n        self.as_str() == other.as_str()\n    }\n}\n\nimpl<A: Allocator> PartialEq<str> for String<A> {\n");
    buf_str(out, c"    fn eq(&self, other: &str) -> bool {\n        self.as_str() == other\n    }\n}\n\nimpl<'a, A: Allocator> PartialEq<&'a str> for String<A> {\n    fn eq(&self, other: &&'a str) -> bool {\n        self.as_str() == *other\n    }\n}\n\nimpl<A: Allocator> Eq for String<A> {}\n\nimpl<A: Allocator> PartialOrd for String<A> {\n    fn partial_cmp(&self, other: &String<A>) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\n// mvs: String::impl Ord\nimpl<A: Allocator> Ord for String<A> {\n    fn cmp(&self, other: &String<A>) -> Ordering {\n        self.as_str().cmp(other.as_str())\n    }\n}\n\n// As its str: the same for any A, so a HashMap<String<A>, V, A2> is\n// looked up by a &str (Borrow<str>).\n// mvs: String::impl Hash\nimpl<A: Allocator> Hash for String<A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.as_str().hash(state)\n    }\n}\n\n// mvs: String::impl Display\nimpl<A: Allocator> Display for String<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.as_str(), f)\n    }\n}\n\n// mvs: String::impl Debug\nimpl<A: Allocator> Debug for String<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.as_str(), f)\n    }\n}\n\n// `write(&mut s, \"{x}\")`: never fails (it grows from A).\n// mvs: String::push_fmt, Buf::push_fmt\nimpl<A: Allocator> Write for String<A> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.push_str(s);\n        Result::Ok(())\n    }\n}\n\nimpl<A: Allocator> Borrow<str> for String<A> {\n    fn borrow(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> BorrowMut<str> for String<A> {\n    fn borrow_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<str> for String<A> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<[u8]> for String<A> {\n    fn as_ref(&self) -> &[u8] {\n");
    buf_str(out, c"        self.as_bytes()\n    }\n}\n\nimpl<A: Allocator> AsMut<str> for String<A> {\n    fn as_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\n// `s + \"x\"`: s, grown from its own A.\nimpl<'b, A: Allocator> Add<&'b str> for String<A> {\n    type Output = String<A>;\n\n    fn add(self, other: &'b str) -> String<A> {\n        let mut s = self;\n        s.push_str(other);\n        s\n    }\n}\n\n// `s += \"x\"`.\nimpl<'b, A: Allocator> AddAssign<&'b str> for String<A> {\n    fn add_assign(&mut self, other: &'b str) {\n        self.push_str(other)\n    }\n}\n\nimpl<A: Allocator> Extend<char> for String<A> {\n    fn extend<I: IntoIterator<Item = char>>(&mut self, iter: I) {\n        for c in iter {\n            self.push(c);\n        }\n    }\n}\n\nimpl<'b, A: Allocator> Extend<&'b str> for String<A> {\n    fn extend<I: IntoIterator<Item = &'b str>>(&mut self, iter: I) {\n        for s in iter {\n            self.push_str(s);\n        }\n    }\n}\n\n// `chars.collect_in(a)` into a String.\nimpl<A: Allocator> FromIteratorIn<char, A> for String<A> {\n    fn from_iter_in<I: IntoIterator<Item = char>>(iter: I, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<'b, A: Allocator> FromIteratorIn<&'b str, A> for String<A> {\n    fn from_iter_in<I: IntoIterator<Item = &'b str>>(iter: I, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<A: Allocator> DefaultIn<A> for String<A> {\n    fn default_in(a: A) -> String<A> {\n        String::new_in(a)\n    }\n}\n\n// Why bytes are not a String: the error, and the bytes back.\n#[derive(Debug)]\npub struct FromUtf8Error<A: Allocator> {\n    bytes: Vec<u8, A>,\n    error: Utf8Error,\n}\n\nimpl<A: Allocator> FromUtf8Error<A> {\n    pub fn as_bytes(&self) -> &[u8] {\n        self.bytes.as_slice()\n    }\n\n    pub fn into_bytes(self) -> Vec<u8, A> {\n        self.bytes\n    }\n\n");
    buf_str(out, c"    pub fn utf8_error(&self) -> Utf8Error {\n        self.error\n    }\n}\n\n// String::drain's iterator: the removed chars.\npub struct Drain<'a, A: Allocator> {\n    string: *mut String<A>,\n    start: usize,\n    end: usize,\n    iter: Chars<'a>,\n}\n\nimpl<'a, A: Allocator> Iterator for Drain<'a, A> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        self.iter.next()\n    }\n}\n\nimpl<'a, A: Allocator> DoubleEndedIterator for Drain<'a, A> {\n    fn next_back(&mut self) -> Option<char> {\n        self.iter.next_back()\n    }\n}\n\nimpl<'a, A: Allocator> crate::ops::Drop for Drain<'a, A> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// What can be written as text, written into a new String on a: Rust's\n// ToString with the allocator named. Every Display type has it\n// (`x.to_string_in(gpa)`, `format_args(\"{a}-{b}\").to_string_in(gpa)`).\npub trait ToStringIn<A: Allocator> {\n    fn to_string_in(&self, a: A) -> String<A>;\n}\n\n// later: blanket_impl\nimpl<T: Display + ?Sized, A: Allocator> ToStringIn<A> for T {\n    fn to_string_in(&self, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        let _ = s.write_fmt(self);\n        s\n    }\n}\n// ---- end mod std::string ----\n}\n// ---- mod std::hash ----\npub mod hash {\n// EDITION: rust\n// std::hash: Hash, Hasher, BuildHasher, and the hashers. Rust's shape:\n// a type feeds its parts to a Hasher (`x.hash(&mut h)`), and a map's\n// BuildHasher makes the Hasher. MVS's Hash (`hash(self) -> u64`, one\n// fixed function) is gone into it. The default, FixedState, is foldhash\n// with fixed seeds, so a map iterates in the same order in every run and\n// on every target (decision 2); a seeded one goes through\n// `HashMap::with_hasher_in(FixedState::with_seed(s), a)`, and\n// RandomState seeds from the OS: HashDoS is the guide's topic. The\n// numbers', bool's, char's and str's impls are built in or in their\n");
    buf_str(out, c"// modules; `#[derive(Hash)]` makes the others (`edition.later:\n// rust_derives`).\n\nuse crate::default::Default;\nuse crate::marker::PhantomData;\n\n// A value that can be hashed: equal values (Eq) feed equal input.\n// std2: changed: Rust's shape, hash<H: Hasher>(&self, &mut H) (MVS: hash(self) -> u64)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Hash {\n    // std2: changed: feeds a Hasher (MVS: returned a u64)\n    fn hash<H: Hasher>(&self, state: &mut H);\n\n    // Each element of data, in order.\n    fn hash_slice<H: Hasher>(data: &[Self], state: &mut H)\n        where\n            Self: Sized,\n    {\n        for x in data {\n            x.hash(state);\n        }\n    }\n}\n\n// What a Hash feeds; finish gives the hash.\npub trait Hasher {\n    fn finish(&self) -> u64;\n    fn write(&mut self, bytes: &[u8]);\n\n    fn write_u8(&mut self, i: u8) {\n        self.write(&[i])\n    }\n\n    fn write_u16(&mut self, i: u16) {\n        self.write_u64(i as u64)\n    }\n\n    fn write_u32(&mut self, i: u32) {\n        self.write_u64(i as u64)\n    }\n\n    // Its 8 bytes, little-endian.\n    fn write_u64(&mut self, i: u64) {\n        crate::panic::todo()\n    }\n\n    fn write_usize(&mut self, i: usize) {\n        self.write_u64(i as u64)\n    }\n\n    fn write_i8(&mut self, i: i8) {\n        self.write_u8(i as u8)\n    }\n\n    fn write_i16(&mut self, i: i16) {\n        self.write_u16(i as u16)\n    }\n\n    fn write_i32(&mut self, i: i32) {\n        self.write_u32(i as u32)\n    }\n\n    fn write_i64(&mut self, i: i64) {\n        self.write_u64(i as u64)\n    }\n\n    fn write_isize(&mut self, i: isize) {\n        self.write_usize(i as usize)\n    }\n\n    // A slice's or a str's length, before its elements.\n    fn write_length_prefix(&mut self, len: usize) {\n        self.write_usize(len)\n    }\n}\n\n// What makes a map's Hashers: each one starts from the same state, so\n// equal keys hash equal.\npub trait BuildHasher {\n");
    buf_str(out, c"    type Hasher: Hasher;\n\n    fn build_hasher(&self) -> Self::Hasher;\n\n    // The hash of x with a new Hasher.\n    fn hash_one<T: Hash>(&self, x: T) -> u64 {\n        let mut h = self.build_hasher();\n        x.hash(&mut h);\n        h.finish()\n    }\n}\n\n// A BuildHasher for a Default Hasher type.\npub struct BuildHasherDefault<H> {\n    marker: PhantomData<fn() -> H>,\n}\n\nimpl<H: Default + Hasher> BuildHasher for BuildHasherDefault<H> {\n    type Hasher = H;\n\n    fn build_hasher(&self) -> H {\n        H::default()\n    }\n}\n\nimpl<H> Default for BuildHasherDefault<H> {\n    fn default() -> BuildHasherDefault<H> {\n        BuildHasherDefault { marker: PhantomData }\n    }\n}\n\n// foldhash with fixed seeds: HashMap's and HashSet's default S. The same\n// order in every run and on every target.\n#[derive(Clone, Copy, Debug)]\npub struct FixedState {\n    seed: u64,\n}\n\nimpl FixedState {\n    // The fixed seed.\n    pub fn new() -> FixedState {\n        FixedState { seed: 0 }\n    }\n\n    // A seed of the program's choosing (a per-process secret against\n    // HashDoS, or a test's).\n    pub fn with_seed(seed: u64) -> FixedState {\n        FixedState { seed: seed }\n    }\n}\n\n// mvs: FixedState::build_hasher\nimpl BuildHasher for FixedState {\n    type Hasher = FoldHasher;\n\n    fn build_hasher(&self) -> FoldHasher {\n        crate::panic::todo()\n    }\n}\n\nimpl Default for FixedState {\n    fn default() -> FixedState {\n        FixedState::new()\n    }\n}\n\n// foldhash seeded from the OS once per process: not deterministic, so\n// never a default (decision 2).\n#[derive(Clone, Copy, Debug)]\npub struct RandomState {\n    seed: u64,\n}\n\nimpl RandomState {\n    pub fn new() -> RandomState {\n        crate::panic::todo()\n    }\n}\n\n// mvs: RandomState::build_hasher\nimpl BuildHasher for RandomState {\n    type Hasher = FoldHasher;\n\n    fn build_hasher(&self) -> FoldHasher {\n        crate::panic::todo()\n    }\n}\n\n");
    buf_str(out, c"// SipHash-1-3 with fixed keys (Rust's DefaultHasher's function), for\n// tables that take untrusted keys and want a keyed hash.\n#[derive(Clone, Copy, Debug)]\npub struct SipHashState {\n    k0: u64,\n    k1: u64,\n}\n\nimpl SipHashState {\n    pub fn new() -> SipHashState {\n        SipHashState { k0: 0, k1: 0 }\n    }\n\n    pub fn with_keys(k0: u64, k1: u64) -> SipHashState {\n        SipHashState { k0: k0, k1: k1 }\n    }\n}\n\n// mvs: SipHashState::build_hasher\nimpl BuildHasher for SipHashState {\n    type Hasher = SipHasher13;\n\n    fn build_hasher(&self) -> SipHasher13 {\n        SipHasher13::new_with_keys(self.k0, self.k1)\n    }\n}\n\n// foldhash (Orson Peters'), the default hasher's function.\n#[derive(Clone, Debug)]\npub struct FoldHasher {\n    accumulator: u64,\n    // foldhash's 128-bit sponge, as two halves (vole has no u128).\n    sponge_lo: u64,\n    sponge_hi: u64,\n    sponge_len: u8,\n    seeds: FoldSeeds,\n}\n\n// The seeds foldhash mixes with.\n#[derive(Clone, Copy, Debug)]\npub struct FoldSeeds {\n    seeds: [u64; 4],\n}\n\nimpl FoldSeeds {\n    pub fn fixed() -> FoldSeeds {\n        crate::panic::todo()\n    }\n\n    pub fn from_u64(seed: u64) -> FoldSeeds {\n        crate::panic::todo()\n    }\n}\n\nimpl FoldHasher {\n    pub fn with_seeds(seed: u64, seeds: FoldSeeds) -> FoldHasher {\n        crate::panic::todo()\n    }\n}\n\n// mvs: FoldHasher::write, FoldHasher::finish, FoldHasher::write_u8, FoldHasher::write_u16, FoldHasher::write_u32, FoldHasher::write_u64, FoldHasher::write_i64\n// std2: changed: the Hasher trait's methods (MVS: inherent)\nimpl Hasher for FoldHasher {\n    fn finish(&self) -> u64 {\n        crate::panic::todo()\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        crate::panic::todo()\n    }\n}\n\n// SipHash-1-3.\n#[derive(Clone, Debug)]\npub struct SipHasher13 {\n    v0: u64,\n    v1: u64,\n    v2: u64,\n    v3: u64,\n    tail: u64,\n    ntail: usize,\n    length: usize,\n}\n\nimpl SipHasher13 {\n");
    buf_str(out, c"    pub fn new_with_keys(k0: u64, k1: u64) -> SipHasher13 {\n        crate::panic::todo()\n    }\n}\n\n// mvs: SipHasher13::write, SipHasher13::finish, SipHasher13::write_u8, SipHasher13::write_u16, SipHasher13::write_u32, SipHasher13::write_u64, SipHasher13::write_i64\n// std2: changed: the Hasher trait's methods (MVS: inherent)\nimpl Hasher for SipHasher13 {\n    fn finish(&self) -> u64 {\n        crate::panic::todo()\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        crate::panic::todo()\n    }\n}\n\n// A reference hashes as what it refers to.\nimpl<T: Hash + ?Sized> Hash for &T {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (**self).hash(state)\n    }\n}\n\nimpl<T: Hash + ?Sized> Hash for &mut T {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (**self).hash(state)\n    }\n}\n\nimpl Hash for () {\n    fn hash<H: Hasher>(&self, state: &mut H) {}\n}\n// ---- end mod std::hash ----\n}\n// ---- mod std::collections ----\npub mod collections {\n// EDITION: rust\n// std::collections: HashMap and HashSet. BTreeMap and BTreeSet come in 0.27.2.\n\npub mod hash_map;\npub mod hash_set;\n\npub use hash_map::HashMap;\npub use hash_set::HashSet;\n// ---- mod std::collections::hash_map ----\npub mod hash_map {\n// EDITION: rust\n// std::collections::hash_map: HashMap<K, V, A, S>, Entry, the iterators.\n// hashbrown's Swiss table, as MVS's (its RawTable is internal). A is\n// always written; S, the BuildHasher, defaults to FixedState (a fixed\n// seed: decision 2), so it goes last: `HashMap<K, V, Gpa>`. Rust's order\n// is <K, V, S, A>: the rustc twin's shim swaps them. Lookups take a\n// reference to anything the key Borrows (`m.get(\"x\")` on String keys).\n// The K: Hash + Eq bound is on the impls, not the struct, as Rust's.\n\nuse crate::alloc::{Allocator, TryReserveError};\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\n");
    buf_str(out, c"use crate::hash::{BuildHasher, FixedState, Hash};\nuse crate::iter::{ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::marker::PhantomData;\nuse crate::ops::Index;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// A map from K to V on A, hashed by S.\n// std2: changed: an S, defaulted; the bounds moved to the impls\npub struct HashMap<K, V, A: Allocator, S = FixedState> {\n    table: RawTable<(K, V), A>,\n    hasher: S,\n}\n\n// The table itself: buckets and their control bytes (internal).\nstruct RawTable<T, A: Allocator> {\n    ctrl: crate::ptr::NonNull<u8>,\n    bucket_mask: usize,\n    items: usize,\n    growth_left: usize,\n    alloc: A,\n    marker: PhantomData<T>,\n}\n\nimpl<K, V, A: Allocator> HashMap<K, V, A, FixedState> {\n    // An empty map on a, with the fixed-seed hasher; it allocates at its\n    // first insert.\n    pub fn new_in(a: A) -> HashMap<K, V, A, FixedState> {\n        HashMap::with_hasher_in(FixedState::new(), a)\n    }\n\n    // Room for n entries.\n    pub fn with_capacity_in(n: usize, a: A) -> HashMap<K, V, A, FixedState> {\n        HashMap::with_capacity_and_hasher_in(n, FixedState::new(), a)\n    }\n}\n\nimpl<K, V, A: Allocator, S> HashMap<K, V, A, S> {\n    // An empty map on a, hashed by hasher (a seeded FixedState, a RandomState).\n    pub fn with_hasher_in(hasher: S, a: A) -> HashMap<K, V, A, S> {\n        crate::panic::todo()\n    }\n\n    pub fn with_capacity_and_hasher_in(n: usize, hasher: S, a: A) -> HashMap<K, V, A, S> {\n        crate::panic::todo()\n    }\n\n    pub fn len(&self) -> usize {\n        self.table.items\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    // How many entries fit before it grows.\n    pub fn capacity(&self) -> usize {\n        crate::panic::todo()\n    }\n\n    pub fn hasher(&self) -> &S {\n        &self.hasher\n    }\n\n    // std2: changed: returns &A (MVS: a copy of A)\n    pub fn allocator(&self) -> &A {\n");
    buf_str(out, c"        &self.table.alloc\n    }\n\n    // Its entries, (&K, &V), in table order (the same in every run).\n    // std2: changed: yields (&K, &V) (MVS: copies)\n    pub fn iter(&self) -> Iter<'_, K, V> {\n        crate::panic::todo()\n    }\n\n    // Its entries, (&K, &mut V).\n    pub fn iter_mut(&mut self) -> IterMut<'_, K, V> {\n        crate::panic::todo()\n    }\n\n    // std2: changed: yields &K\n    pub fn keys(&self) -> Keys<'_, K, V> {\n        Keys { inner: self.iter() }\n    }\n\n    // std2: changed: yields &V\n    pub fn values(&self) -> Values<'_, K, V> {\n        Values { inner: self.iter() }\n    }\n\n    pub fn values_mut(&mut self) -> ValuesMut<'_, K, V> {\n        ValuesMut { inner: self.iter_mut() }\n    }\n\n    // The keys, by value, the map consumed.\n    pub fn into_keys(self) -> IntoKeys<K, V, A> {\n        IntoKeys { inner: self.into_iter() }\n    }\n\n    pub fn into_values(self) -> IntoValues<K, V, A> {\n        IntoValues { inner: self.into_iter() }\n    }\n\n    // Every entry, removed and yielded by the iterator.\n    pub fn drain(&mut self) -> Drain<'_, K, V, A> {\n        crate::panic::todo()\n    }\n\n    // Keeps the entries f says true of.\n    pub fn retain<F: FnMut(&K, &mut V) -> bool>(&mut self, f: F) {\n        crate::panic::todo()\n    }\n\n    // Removes every entry; the capacity stays.\n    pub fn clear(&mut self) {\n        crate::panic::todo()\n    }\n\n    // Moves the map out, leaving an empty one on clones of its allocator\n    // and hasher (vole's: a map has no Default).\n    pub fn take(&mut self) -> HashMap<K, V, A, S>\n        where\n            A: Clone,\n            S: Clone,\n    {\n        let fresh = HashMap::with_hasher_in(self.hasher.clone(), self.table.alloc.clone());\n        crate::mem::replace(self, fresh)\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher> HashMap<K, V, A, S> {\n    // Room for n more entries.\n    // std2: changed: n more (MVS: n in all)\n");
    buf_str(out, c"    pub fn reserve(&mut self, n: usize) {\n        crate::panic::todo()\n    }\n\n    pub fn try_reserve(&mut self, n: usize) -> Result<(), TryReserveError> {\n        crate::panic::todo()\n    }\n\n    pub fn shrink_to_fit(&mut self) {\n        crate::panic::todo()\n    }\n\n    // The value for k.\n    // std2: changed: takes &Q, returns Option<&V> (MVS: a K and a copy of V)\n    pub fn get<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<&V>\n        where\n            K: Borrow<Q>,\n    {\n        crate::panic::todo()\n    }\n\n    // The value for k, mutable.\n    // std2: changed: takes &Q, returns Option<&mut V> (MVS: an inout view)\n    pub fn get_mut<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<&mut V>\n        where\n            K: Borrow<Q>,\n    {\n        crate::panic::todo()\n    }\n\n    // The stored key and its value.\n    pub fn get_key_value<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<(&K, &V)>\n        where\n            K: Borrow<Q>,\n    {\n        crate::panic::todo()\n    }\n\n    // mvs: HashMap::contains_key, HashMap::contains\n    // std2: changed: takes &Q\n    pub fn contains_key<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> bool\n        where\n            K: Borrow<Q>,\n    {\n        self.get(k).is_some()\n    }\n\n    // Stores v for k; the old value, if there was one.\n    pub fn insert(&mut self, k: K, v: V) -> Option<V> {\n        crate::panic::todo()\n    }\n\n    // Removes k's entry; its value.\n    // std2: changed: takes &Q\n    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<V>\n        where\n            K: Borrow<Q>,\n    {\n        self.remove_entry(k).map(|(_, v)| v)\n    }\n\n    // Removes k's entry; the stored key and its value.\n    pub fn remove_entry<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<(K, V)>\n        where\n            K: Borrow<Q>,\n    {\n        crate::panic::todo()\n    }\n\n    // k's place in the map, there or not: `*m.entry(k).or_insert(0) += 1`.\n");
    buf_str(out, c"    // mvs: HashMap::get_or_insert\n    // std2: changed: Entry replaces get_or_insert (`entry(k).or_insert(v)`)\n    pub fn entry(&mut self, k: K) -> Entry<'_, K, V, A, S> {\n        crate::panic::todo()\n    }\n\n    // A copy on another allocator, with a clone of the hasher.\n    pub fn clone_in<B: Allocator>(&self, b: B) -> HashMap<K, V, B, S>\n        where\n            K: Clone,\n            V: Clone,\n            S: Clone,\n    {\n        crate::panic::todo()\n    }\n}\n\nimpl<K, V, A: Allocator, S> crate::ops::Drop for HashMap<K, V, A, S> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// A copy on the same allocator (a clone of it).\n// std2: changed: needs A: Clone and S: Clone\nimpl<K: Hash + Eq + Clone, V: Clone, A: Allocator + Clone,\n    S: BuildHasher + Clone> Clone for HashMap<K, V, A, S> {\n    fn clone(&self) -> HashMap<K, V, A, S> {\n        self.clone_in(self.table.alloc.clone())\n    }\n}\n\n// The same entries, in any order.\n// mvs: HashMap::impl Eq\n// std2: changed: PartialEq; any two allocators\nimpl<K: Hash + Eq, V: PartialEq, A: Allocator, B: Allocator,\n    S: BuildHasher> PartialEq<HashMap<K, V, B, S>>\n    for HashMap<K, V, A, S>\n    {\n    fn eq(&self, other: &HashMap<K, V, B, S>) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        self.iter().all(|(k, v)| other.get(k).map_or(false, |w| *v == *w))\n    }\n}\n\nimpl<K: Hash + Eq, V: Eq, A: Allocator, S: BuildHasher> Eq for HashMap<K, V, A, S> {}\n\n// `{k: v, ...}`.\n// mvs: HashMap::impl Debug\nimpl<K: Debug, V: Debug, A: Allocator, S> Debug for HashMap<K, V, A, S> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_map().entries(self.iter()).finish()\n    }\n}\n\n// `m[&k]`: the value; panics when k is not there.\nimpl<K: Hash + Eq + Borrow<Q>, Q: ?Sized + Hash + Eq, V, A: Allocator, S: BuildHasher> Index<&Q>\n    for HashMap<K, V, A, S>\n    {\n    type Output = V;\n\n");
    buf_str(out, c"    fn index(&self, k: &Q) -> &V {\n        self.get(k).expect(\"no entry found for key\")\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher> Extend<(K, V)> for HashMap<K, V, A, S> {\n    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(k, v);\n        }\n    }\n}\n\nimpl<'a, K: Hash + Eq + Copy, V: Copy, A: Allocator,\n    S: BuildHasher> Extend<(&'a K, &'a V)> for HashMap<K, V, A, S> {\n    fn extend<I: IntoIterator<Item = (&'a K, &'a V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(*k, *v);\n        }\n    }\n}\n\n// `pairs.collect_in(a)` into a map with S's Default.\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher + Default> FromIteratorIn<(K, V),\n    A> for HashMap<K, V, A, S> {\n    fn from_iter_in<I: IntoIterator<Item = (K, V)>>(iter: I, a: A) -> HashMap<K, V, A, S> {\n        let mut m = HashMap::with_hasher_in(S::default(), a);\n        m.extend(iter);\n        m\n    }\n}\n\n// An empty map on a (`entry(k).or_default()` for map values).\nimpl<K, V, A: Allocator, S: Default> DefaultIn<A> for HashMap<K, V, A, S> {\n    fn default_in(a: A) -> HashMap<K, V, A, S> {\n        HashMap::with_hasher_in(S::default(), a)\n    }\n}\n\nimpl<K, V, A: Allocator, S> IntoIterator for HashMap<K, V, A, S> {\n    type Item = (K, V);\n    type IntoIter = IntoIter<K, V, A>;\n\n    fn into_iter(self) -> IntoIter<K, V, A> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, K, V, A: Allocator, S> IntoIterator for &'a HashMap<K, V, A, S> {\n    type Item = (&'a K, &'a V);\n    type IntoIter = Iter<'a, K, V>;\n\n    fn into_iter(self) -> Iter<'a, K, V> {\n        self.iter()\n    }\n}\n\nimpl<'a, K, V, A: Allocator, S> IntoIterator for &'a mut HashMap<K, V, A, S> {\n    type Item = (&'a K, &'a mut V);\n    type IntoIter = IterMut<'a, K, V>;\n\n    fn into_iter(self) -> IterMut<'a, K, V> {\n        self.iter_mut()\n    }\n}\n\n// ---- Entry ----\n\n");
    buf_str(out, c"// A key's place in a map: Occupied (its entry is there) or Vacant.\npub enum Entry<'a, K, V, A: Allocator, S> {\n    Occupied(OccupiedEntry<'a, K, V, A, S>),\n    Vacant(VacantEntry<'a, K, V, A, S>),\n}\n\nimpl<'a, K: Hash + Eq, V, A: Allocator, S: BuildHasher> Entry<'a, K, V, A, S> {\n    // The value, after inserting default if it was vacant.\n    pub fn or_insert(self, default: V) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => e.insert(default),\n        }\n    }\n\n    // The value, after inserting f() if it was vacant.\n    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => e.insert(f()),\n        }\n    }\n\n    // The value, after inserting f(&key) if it was vacant.\n    pub fn or_insert_with_key<F: FnOnce(&K) -> V>(self, f: F) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => {\n                let v = f(e.key());\n                e.insert(v)\n            }\n        }\n    }\n\n    // The value, after inserting V's empty value if it was vacant: a 0, a\n    // None, or an empty Vec on a clone of the map's allocator (DefaultIn).\n    pub fn or_default(self) -> &'a mut V\n        where\n            V: DefaultIn<A>,\n            A: Clone,\n    {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => {\n                let v = V::default_in(e.map_allocator().clone());\n                e.insert(v)\n            }\n        }\n    }\n\n    // Calls f on the value if it is there; the entry back.\n    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> Entry<'a, K, V, A, S> {\n        match self {\n            Entry::Occupied(mut e) => {\n                f(e.get_mut());\n                Entry::Occupied(e)\n            }\n");
    buf_str(out, c"            Entry::Vacant(e) => Entry::Vacant(e),\n        }\n    }\n\n    pub fn key(&self) -> &K {\n        match self {\n            Entry::Occupied(e) => e.key(),\n            Entry::Vacant(e) => e.key(),\n        }\n    }\n}\n\n// An entry that is there.\npub struct OccupiedEntry<'a, K, V, A: Allocator, S> {\n    map: &'a mut HashMap<K, V, A, S>,\n    bucket: usize,\n}\n\nimpl<'a, K, V, A: Allocator, S> OccupiedEntry<'a, K, V, A, S> {\n    pub fn key(&self) -> &K {\n        crate::panic::todo()\n    }\n\n    pub fn get(&self) -> &V {\n        crate::panic::todo()\n    }\n\n    pub fn get_mut(&mut self) -> &mut V {\n        crate::panic::todo()\n    }\n\n    // The value, as long as the map's borrow.\n    pub fn into_mut(self) -> &'a mut V {\n        crate::panic::todo()\n    }\n\n    // Stores v; the old value.\n    pub fn insert(&mut self, v: V) -> V {\n        crate::mem::replace(self.get_mut(), v)\n    }\n\n    // Removes the entry; its value.\n    pub fn remove(self) -> V {\n        self.remove_entry().1\n    }\n\n    pub fn remove_entry(self) -> (K, V) {\n        crate::panic::todo()\n    }\n}\n\n// A key's place that is empty.\npub struct VacantEntry<'a, K, V, A: Allocator, S> {\n    map: &'a mut HashMap<K, V, A, S>,\n    key: K,\n    hash: u64,\n}\n\nimpl<'a, K, V, A: Allocator, S> VacantEntry<'a, K, V, A, S> {\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    pub fn into_key(self) -> K {\n        self.key\n    }\n\n    // Stores v under the key; a &mut to it, as long as the map's borrow.\n    pub fn insert(self, v: V) -> &'a mut V {\n        crate::panic::todo()\n    }\n\n    // The map's allocator (or_default's).\n    fn map_allocator(&self) -> &A {\n        self.map.allocator()\n    }\n}\n\n// ---- The iterators ----\n\n// HashMap::iter's iterator.\n// mvs: HashMapIter\n// std2: renamed\npub struct Iter<'a, K, V> {\n    ctrl: *const u8,\n    data: *const (K, V),\n    left: usize,\n    marker: PhantomData<&'a (K, V)>,\n}\n\n");
    buf_str(out, c"impl<'a, K, V> Clone for Iter<'a, K, V> {\n    fn clone(&self) -> Iter<'a, K, V> {\n        Iter { ctrl: self.ctrl, data: self.data, left: self.left, marker: PhantomData }\n    }\n}\n\nimpl<'a, K, V> Iterator for Iter<'a, K, V> {\n    type Item = (&'a K, &'a V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a V)> {\n        crate::panic::todo()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.left, Option::Some(self.left))\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Iter<'a, K, V> {}\n\n// HashMap::iter_mut's iterator.\npub struct IterMut<'a, K, V> {\n    ctrl: *const u8,\n    data: *mut (K, V),\n    left: usize,\n    marker: PhantomData<&'a mut (K, V)>,\n}\n\nimpl<'a, K, V> Iterator for IterMut<'a, K, V> {\n    type Item = (&'a K, &'a mut V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a mut V)> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for IterMut<'a, K, V> {}\n\n// HashMap::keys's iterator.\n// mvs: Keys\npub struct Keys<'a, K, V> {\n    inner: Iter<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for Keys<'a, K, V> {\n    type Item = &'a K;\n\n    fn next(&mut self) -> Option<&'a K> {\n        self.inner.next().map(|(k, _)| k)\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Keys<'a, K, V> {}\n\n// HashMap::values's iterator.\n// mvs: Values\npub struct Values<'a, K, V> {\n    inner: Iter<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for Values<'a, K, V> {\n    type Item = &'a V;\n\n    fn next(&mut self) -> Option<&'a V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Values<'a, K, V> {}\n\n// HashMap::values_mut's iterator.\npub struct ValuesMut<'a, K, V> {\n    inner: IterMut<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for ValuesMut<'a, K, V> {\n    type Item = &'a mut V;\n\n    fn next(&mut self) -> Option<&'a mut V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n}\n\n// A map's entries, by value.\npub struct IntoIter<K, V, A: Allocator> {\n");
    buf_str(out, c"    table: RawTable<(K, V), A>,\n    at: usize,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoIter<K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        crate::panic::todo()\n    }\n}\n\nimpl<K, V, A: Allocator> ExactSizeIterator for IntoIter<K, V, A> {}\n\n// HashMap::into_keys's iterator.\npub struct IntoKeys<K, V, A: Allocator> {\n    inner: IntoIter<K, V, A>,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoKeys<K, V, A> {\n    type Item = K;\n\n    fn next(&mut self) -> Option<K> {\n        self.inner.next().map(|(k, _)| k)\n    }\n}\n\n// HashMap::into_values's iterator.\npub struct IntoValues<K, V, A: Allocator> {\n    inner: IntoIter<K, V, A>,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoValues<K, V, A> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n}\n\n// HashMap::drain's iterator.\npub struct Drain<'a, K, V, A: Allocator> {\n    table: *mut RawTable<(K, V), A>,\n    at: usize,\n    marker: PhantomData<&'a mut RawTable<(K, V), A>>,\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for Drain<'a, K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, K, V, A: Allocator> crate::ops::Drop for Drain<'a, K, V, A> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n// ---- end mod std::collections::hash_map ----\n}\n// ---- mod std::collections::hash_set ----\npub mod hash_set {\n// EDITION: rust\n// std::collections::hash_set: HashSet<T, A, S>, a HashMap<T, (), A, S>,\n// and its iterators. As HashMap: A always written, S defaulted to\n// FixedState and last, lookups by a reference to anything T Borrows.\n\nuse crate::alloc::Allocator;\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{BuildHasher, FixedState, Hash};\n");
    buf_str(out, c"use crate::iter::{Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::option::Option;\n\nuse super::hash_map::{HashMap, self};\n\n// A set of T on A, hashed by S.\n// std2: changed: an S, defaulted; the bounds moved to the impls\npub struct HashSet<T, A: Allocator, S = FixedState> {\n    map: HashMap<T, (), A, S>,\n}\n\nimpl<T, A: Allocator> HashSet<T, A, FixedState> {\n    pub fn new_in(a: A) -> HashSet<T, A, FixedState> {\n        HashSet { map: HashMap::new_in(a) }\n    }\n\n    pub fn with_capacity_in(n: usize, a: A) -> HashSet<T, A, FixedState> {\n        HashSet { map: HashMap::with_capacity_in(n, a) }\n    }\n}\n\nimpl<T, A: Allocator, S> HashSet<T, A, S> {\n    pub fn with_hasher_in(hasher: S, a: A) -> HashSet<T, A, S> {\n        HashSet { map: HashMap::with_hasher_in(hasher, a) }\n    }\n\n    pub fn len(&self) -> usize {\n        self.map.len()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.map.is_empty()\n    }\n\n    pub fn capacity(&self) -> usize {\n        self.map.capacity()\n    }\n\n    // std2: changed: returns &A\n    pub fn allocator(&self) -> &A {\n        self.map.allocator()\n    }\n\n    pub fn hasher(&self) -> &S {\n        self.map.hasher()\n    }\n\n    // Its elements, by reference.\n    // std2: changed: yields &T\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { inner: self.map.keys() }\n    }\n\n    pub fn clear(&mut self) {\n        self.map.clear()\n    }\n\n    // Every element, removed and yielded by the iterator.\n    pub fn drain(&mut self) -> Drain<'_, T, A> {\n        Drain { inner: self.map.drain() }\n    }\n\n    // Keeps the elements f says true of.\n    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        self.map.retain(|k, _| f(k))\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> HashSet<T, A, S> {\n    pub fn reserve(&mut self, n: usize) {\n        self.map.reserve(n)\n    }\n\n    // std2: changed: takes &Q\n");
    buf_str(out, c"    pub fn contains<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.contains_key(x)\n    }\n\n    // The stored element equal to x.\n    pub fn get<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> Option<&T>\n        where\n            T: Borrow<Q>,\n    {\n        self.map.get_key_value(x).map(|(k, _)| k)\n    }\n\n    // Adds x; false when it was there already.\n    pub fn insert(&mut self, x: T) -> bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    // Adds x, replacing an equal element; the old one.\n    pub fn replace(&mut self, x: T) -> Option<T> {\n        crate::panic::todo()\n    }\n\n    // Removes x; whether it was there.\n    // std2: changed: takes &Q\n    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove(x).is_some()\n    }\n\n    // Removes and returns the stored element equal to x.\n    pub fn take<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> Option<T>\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove_entry(x).map(|(k, _)| k)\n    }\n\n    // The elements of either, each once.\n    pub fn union<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Union<'a, T, A, S> {\n        Union { a: self.iter(), b: other.iter(), a_set: self }\n    }\n\n    // The elements of both.\n    pub fn intersection<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Intersection<'a, T, A, S> {\n        Intersection { a: self.iter(), other: other }\n    }\n\n    // The elements of self that other has not.\n    pub fn difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Difference<'a, T, A, S> {\n        Difference { a: self.iter(), other: other }\n    }\n\n    // The elements of one of them only.\n    pub fn symmetric_difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> SymmetricDifference<'a, T, A, S> {\n        SymmetricDifference { a: self.difference(other), b: other.difference(self) }\n    }\n\n");
    buf_str(out, c"    pub fn is_disjoint(&self, other: &HashSet<T, A, S>) -> bool {\n        self.iter().all(|x| !other.contains(x))\n    }\n\n    pub fn is_subset(&self, other: &HashSet<T, A, S>) -> bool {\n        self.iter().all(|x| other.contains(x))\n    }\n\n    pub fn is_superset(&self, other: &HashSet<T, A, S>) -> bool {\n        other.is_subset(self)\n    }\n}\n\n// std2: changed: needs A: Clone and S: Clone\nimpl<T: Hash + Eq + Clone, A: Allocator + Clone, S: BuildHasher + Clone> Clone for HashSet<T, A,\n    S> {\n    fn clone(&self) -> HashSet<T, A, S> {\n        HashSet { map: self.map.clone() }\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, B: Allocator,\n    S: BuildHasher> PartialEq<HashSet<T, B, S>> for HashSet<T, A, S> {\n    fn eq(&self, other: &HashSet<T, B, S>) -> bool {\n        self.len() == other.len() && self.iter().all(|x| other.contains(x))\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> Eq for HashSet<T, A, S> {}\n\nimpl<T: Debug, A: Allocator, S> Debug for HashSet<T, A, S> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_set().entries(self.iter()).finish()\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> Extend<T> for HashSet<T, A, S> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.insert(x);\n        }\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher + Default> FromIteratorIn<T, A> for HashSet<T, A,\n    S> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> HashSet<T, A, S> {\n        let mut s = HashSet::with_hasher_in(S::default(), a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T, A: Allocator, S: Default> DefaultIn<A> for HashSet<T, A, S> {\n    fn default_in(a: A) -> HashSet<T, A, S> {\n        HashSet::with_hasher_in(S::default(), a)\n    }\n}\n\nimpl<T, A: Allocator, S> IntoIterator for HashSet<T, A, S> {\n    type Item = T;\n    type IntoIter = IntoIter<T, A>;\n\n");
    buf_str(out, c"    fn into_iter(self) -> IntoIter<T, A> {\n        IntoIter { inner: self.map.into_keys() }\n    }\n}\n\nimpl<'a, T, A: Allocator, S> IntoIterator for &'a HashSet<T, A, S> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\n// HashSet::iter's iterator.\n// mvs: HashSetIter\n// std2: renamed\npub struct Iter<'a, T> {\n    inner: hash_map::Keys<'a, T, ()>,\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        self.inner.next()\n    }\n}\n\n// A set's elements, by value.\npub struct IntoIter<T, A: Allocator> {\n    inner: hash_map::IntoKeys<T, (), A>,\n}\n\nimpl<T, A: Allocator> Iterator for IntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.next()\n    }\n}\n\n// HashSet::drain's iterator.\npub struct Drain<'a, T, A: Allocator> {\n    inner: hash_map::Drain<'a, T, (), A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.next().map(|(k, _)| k)\n    }\n}\n\n// HashSet::union's iterator.\npub struct Union<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    b: Iter<'a, T>,\n    a_set: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Union<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        if let Option::Some(x) = self.a.next() {\n            return Option::Some(x);\n        }\n        while let Option::Some(x) = self.b.next() {\n            if !self.a_set.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::intersection's iterator.\npub struct Intersection<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    other: &'a HashSet<T, A, S>,\n}\n\n");
    buf_str(out, c"impl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Intersection<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        while let Option::Some(x) = self.a.next() {\n            if self.other.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::difference's iterator.\npub struct Difference<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    other: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Difference<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        while let Option::Some(x) = self.a.next() {\n            if !self.other.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::symmetric_difference's iterator.\npub struct SymmetricDifference<'a, T, A: Allocator, S> {\n    a: Difference<'a, T, A, S>,\n    b: Difference<'a, T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for SymmetricDifference<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.a.next() {\n            Option::Some(x) => Option::Some(x),\n            Option::None => self.b.next(),\n        }\n    }\n}\n// ---- end mod std::collections::hash_set ----\n}\n// ---- end mod std::collections ----\n}\n// ---- mod std::iter ----\npub mod iter {\n// EDITION: rust\n// std::iter: Iterator, the traits around it, the adapters and the\n// sources. Rust's shape: an adapter takes self by value and returns a\n// named struct (no `impl Trait` in return position), a closure that only\n// looks takes `&Self::Item` (filter, find, position's FnMut(Self::Item)),\n// and what collects names its allocator: `collect_in(a)` over\n// FromIteratorIn, the result's type given by the context (`let v:\n// Vec<_, Gpa> = it.collect_in(gpa);`) or a turbofish.\n\n");
    buf_str(out, c"mod adapters;\nmod sources;\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::cmp::{Ord, Ordering, PartialEq, PartialOrd};\nuse crate::default::DefaultIn;\nuse crate::ops::{Add, Mul, Range, RangeFrom, RangeInclusive};\nuse crate::option::Option;\n\npub use adapters::{\n    Chain, Cloned, Copied, Cycle, Enumerate, Filter, FilterMap, FlatMap, Flatten, Fuse, Inspect,\n    Map, MapWhile, Peekable, Rev, Scan, Skip, SkipWhile, StepBy, Take, TakeWhile, Zip,\n};\npub use sources::{\n    Empty, FromFn, Once, Repeat, RepeatN, Successors, empty, from_fn, once, repeat, repeat_n,\n    successors, zip,\n};\n\n// A sequence of Items, one per `next` until None.\npub trait Iterator {\n    type Item;\n\n    fn next(&mut self) -> Option<Self::Item>;\n\n    // (at least, at most) items left; (0, None) when it cannot say.\n    // mvs: Iterator::exact_len\n    // std2: changed: Rust's size_hint (MVS: an exact length or -1)\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, Option::None)\n    }\n\n    // The items left, counted by consuming them.\n    fn count(self) -> usize\n        where\n            Self: Sized,\n    {\n        self.fold(0, |n, _| n + 1)\n    }\n\n    fn last(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        self.fold(Option::None, |_, x| Option::Some(x))\n    }\n\n    // Item n (from 0), the ones before it consumed.\n    // mvs: Iterator::at\n    // std2: changed: Rust's nth, an Option (MVS: at(k), the item or a panic)\n    fn nth(&mut self, n: usize) -> Option<Self::Item> {\n        let mut n = n;\n        while n > 0 {\n            self.next()?;\n            n -= 1;\n        }\n        self.next()\n    }\n\n    // Every step-th item, the first included; step > 0.\n    fn step_by(self, step: usize) -> StepBy<Self>\n        where\n            Self: Sized,\n    {\n        StepBy::new(self, step)\n    }\n\n    // Its items, then other's.\n");
    buf_str(out, c"    fn chain<U: IntoIterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U::IntoIter>\n        where\n            Self: Sized,\n    {\n        Chain::new(self, other.into_iter())\n    }\n\n    // Pairs of its items and other's, until either ends.\n    // std2: changed: takes any IntoIterator (MVS: an Iterator)\n    fn zip<U: IntoIterator>(self, other: U) -> Zip<Self, U::IntoIter>\n        where\n            Self: Sized,\n    {\n        Zip::new(self, other.into_iter())\n    }\n\n    // f of each item.\n    // std2: changed: Rust's FnMut(Self::Item) (MVS: a sink Item)\n    fn map<B, F: FnMut(Self::Item) -> B>(self, f: F) -> Map<Self, F>\n        where\n            Self: Sized,\n    {\n        Map::new(self, f)\n    }\n\n    // Calls f on each item, in order.\n    fn for_each<F: FnMut(Self::Item)>(self, f: F)\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.fold((), |_, x| f(x));\n    }\n\n    // The items predicate says true of.\n    // std2: changed: the predicate takes &Self::Item\n    fn filter<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> Filter<Self, P>\n        where\n            Self: Sized,\n    {\n        Filter::new(self, predicate)\n    }\n\n    // The Some values f gives.\n    fn filter_map<B, F: FnMut(Self::Item) -> Option<B>>(self, f: F) -> FilterMap<Self, F>\n        where\n            Self: Sized,\n    {\n        FilterMap::new(self, f)\n    }\n\n    // (index, item) pairs, from 0.\n    fn enumerate(self) -> Enumerate<Self>\n        where\n            Self: Sized,\n    {\n        Enumerate::new(self)\n    }\n\n    // An iterator that can look at its next item without taking it.\n    fn peekable(self) -> Peekable<Self>\n        where\n            Self: Sized,\n    {\n        Peekable::new(self)\n    }\n\n    fn skip_while<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> SkipWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        SkipWhile::new(self, predicate)\n    }\n\n");
    buf_str(out, c"    fn take_while<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> TakeWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        TakeWhile::new(self, predicate)\n    }\n\n    // f's values until it gives None.\n    fn map_while<B, P: FnMut(Self::Item) -> Option<B>>(self, predicate: P) -> MapWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        MapWhile::new(self, predicate)\n    }\n\n    fn skip(self, n: usize) -> Skip<Self>\n        where\n            Self: Sized,\n    {\n        Skip::new(self, n)\n    }\n\n    // The first n items.\n    fn take(self, n: usize) -> Take<Self>\n        where\n            Self: Sized,\n    {\n        Take::new(self, n)\n    }\n\n    // f's values, f keeping a state across items; None from f ends it.\n    fn scan<St, B,\n        F: FnMut(&mut St, Self::Item) -> Option<B>>(self, initial_state: St, f: F) -> Scan<Self, St,\n        F>\n        where\n            Self: Sized,\n    {\n        Scan::new(self, initial_state, f)\n    }\n\n    // The items of each f(item), in order.\n    fn flat_map<U: IntoIterator, F: FnMut(Self::Item) -> U>(self, f: F) -> FlatMap<Self, U, F>\n        where\n            Self: Sized,\n    {\n        FlatMap::new(self, f)\n    }\n\n    // The items of each item (an iterator of iterators, of Options, of Vecs).\n    fn flatten(self) -> Flatten<Self>\n        where\n            Self: Sized,\n            Self::Item: IntoIterator,\n    {\n        Flatten::new(self)\n    }\n\n    // None for ever once it has given None.\n    fn fuse(self) -> Fuse<Self>\n        where\n            Self: Sized,\n    {\n        Fuse::new(self)\n    }\n\n    // Calls f on a reference to each item as it passes.\n    fn inspect<F: FnMut(&Self::Item)>(self, f: F) -> Inspect<Self, F>\n        where\n            Self: Sized,\n    {\n        Inspect::new(self, f)\n    }\n\n    // The iterator borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n");
    buf_str(out, c"            Self: Sized,\n    {\n        self\n    }\n\n    // The items, collected into a B on a (`collect_in::<Vec<_, _>>(gpa)`,\n    // or the result's type from the context).\n    // std2: changed: generic in its result B (MVS: always a Vec)\n    // later: return_inference\n    fn collect_in<B: FromIteratorIn<Self::Item, A>, A: Allocator>(self, a: A) -> B\n        where\n            Self: Sized,\n    {\n        B::from_iter_in(self, a)\n    }\n\n    // (the items f says true of, the others), each a B on a clone of a.\n    // later: return_inference\n    fn partition_in<B, F: FnMut(&Self::Item) -> bool, A: Allocator + Clone>(self, f: F, a: A) -> (B,\n        B)\n        where\n            Self: Sized,\n            B: DefaultIn<A> + Extend<Self::Item>,\n    {\n        crate::panic::todo()\n    }\n\n    // The items' pairs split into two collections on a clone of a.\n    // later: return_inference\n    fn unzip_in<X, Y, FromX, FromY, A: Allocator + Clone>(self, a: A) -> (FromX, FromY)\n        where\n            FromX: DefaultIn<A> + Extend<X>,\n            FromY: DefaultIn<A> + Extend<Y>,\n            Self: Sized + Iterator<Item = (X, Y)>,\n    {\n        crate::panic::todo()\n    }\n\n    // f(f(f(init, a), b), c), for items a, b, c.\n    fn fold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut f = f;\n        let mut acc = init;\n        while let Option::Some(x) = it.next() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    // fold, starting from the first item; None when there is none.\n    fn reduce<F: FnMut(Self::Item, Self::Item) -> Self::Item>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let first = it.next()?;\n        Option::Some(it.fold(first, f))\n    }\n\n    // Whether f is true of every item (true when there is none); stops at\n    // the first false.\n");
    buf_str(out, c"    fn all<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if !f(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // Whether f is true of an item; stops at the first true.\n    fn any<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if f(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // The first item predicate says true of.\n    // std2: changed: the predicate takes &Self::Item\n    fn find<P: FnMut(&Self::Item) -> bool>(&mut self, predicate: P) -> Option<Self::Item> {\n        let mut p = predicate;\n        while let Option::Some(x) = self.next() {\n            if p(&x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n\n    // The first Some that f gives.\n    fn find_map<B, F: FnMut(Self::Item) -> Option<B>>(&mut self, f: F) -> Option<B> {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if let Option::Some(y) = f(x) {\n                return Option::Some(y);\n            }\n        }\n        Option::None\n    }\n\n    // The index of the first item predicate says true of.\n    fn position<P: FnMut(Self::Item) -> bool>(&mut self, predicate: P) -> Option<usize> {\n        let mut p = predicate;\n        let mut i = 0;\n        while let Option::Some(x) = self.next() {\n            if p(x) {\n                return Option::Some(i);\n            }\n            i += 1;\n        }\n        Option::None\n    }\n\n    // The index of the last item predicate says true of, from the end.\n    fn rposition<P: FnMut(Self::Item) -> bool>(&mut self, predicate: P) -> Option<usize>\n        where\n            Self: Sized + ExactSizeIterator + DoubleEndedIterator,\n    {\n        crate::panic::todo()\n    }\n\n");
    buf_str(out, c"    // The largest item; the last of equal ones.\n    // std2: changed: Item: Ord, Rust's\n    fn max(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n            Self::Item: Ord,\n    {\n        self.max_by(|a, b| a.cmp(b))\n    }\n\n    // The smallest item; the first of equal ones.\n    // std2: changed: Item: Ord, Rust's\n    fn min(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n            Self::Item: Ord,\n    {\n        self.min_by(|a, b| a.cmp(b))\n    }\n\n    fn max_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.max_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    fn max_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, compare: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut c = compare;\n        self.reduce(|a, b| if c(&a, &b).is_gt() { a } else { b })\n    }\n\n    fn min_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.min_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    fn min_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, compare: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut c = compare;\n        self.reduce(|a, b| if c(&b, &a).is_lt() { b } else { a })\n    }\n\n    // Its items from the end.\n    fn rev(self) -> Rev<Self>\n        where\n            Self: Sized + DoubleEndedIterator,\n    {\n        Rev::new(self)\n    }\n\n    // Copies of the items of an iterator of &T (`v.iter().copied()`).\n    fn copied<'a, T: Copy + 'a>(self) -> Copied<Self>\n        where\n            Self: Sized + Iterator<Item = &'a T>,\n    {\n        Copied::new(self)\n    }\n\n    fn cloned<'a, T: Clone + 'a>(self) -> Cloned<Self>\n        where\n            Self: Sized + Iterator<Item = &'a T>,\n    {\n");
    buf_str(out, c"        Cloned::new(self)\n    }\n\n    // Its items again and again (it must be Clone).\n    fn cycle(self) -> Cycle<Self>\n        where\n            Self: Sized + Clone,\n    {\n        Cycle::new(self)\n    }\n\n    // The items' sum (`let s: i64 = v.iter().sum();`).\n    // std2: changed: S: Sum<Self::Item> (MVS: the Item itself)\n    // later: return_inference\n    fn sum<S: Sum<Self::Item>>(self) -> S\n        where\n            Self: Sized,\n    {\n        S::sum(self)\n    }\n\n    // later: return_inference\n    fn product<P: Product<Self::Item>>(self) -> P\n        where\n            Self: Sized,\n    {\n        P::product(self)\n    }\n\n    // Lexicographic, item by item.\n    fn cmp<I: IntoIterator<Item = Self::Item>>(self, other: I) -> Ordering\n        where\n            Self::Item: Ord,\n            Self: Sized,\n    {\n        crate::panic::todo()\n    }\n\n    fn partial_cmp<I: IntoIterator>(self, other: I) -> Option<Ordering>\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        crate::panic::todo()\n    }\n\n    // Whether the two have equal items, in order.\n    fn eq<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialEq<I::Item>,\n            Self: Sized,\n    {\n        crate::panic::todo()\n    }\n\n    fn ne<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialEq<I::Item>,\n            Self: Sized,\n    {\n        !self.eq(other)\n    }\n\n    fn lt<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        self.partial_cmp(other) == Option::Some(Ordering::Less)\n    }\n\n    fn le<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) | Option::Some(Ordering::Equal) => true,\n");
    buf_str(out, c"            _ => false,\n        }\n    }\n\n    fn gt<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        self.partial_cmp(other) == Option::Some(Ordering::Greater)\n    }\n\n    fn ge<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    // Whether each item is <= the next.\n    fn is_sorted(self) -> bool\n        where\n            Self: Sized,\n            Self::Item: PartialOrd,\n    {\n        crate::panic::todo()\n    }\n}\n\n// A mutable borrow of an iterator is one (`it.by_ref().take(3)`).\nimpl<I: Iterator + ?Sized> Iterator for &mut I {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        (**self).next()\n    }\n}\n\n// An iterator that can also give its items from the end.\npub trait DoubleEndedIterator: Iterator {\n    fn next_back(&mut self) -> Option<Self::Item>;\n\n    // Item n from the end.\n    fn nth_back(&mut self, n: usize) -> Option<Self::Item> {\n        let mut n = n;\n        while n > 0 {\n            self.next_back()?;\n            n -= 1;\n        }\n        self.next_back()\n    }\n\n    // fold, from the end.\n    fn rfold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut f = f;\n        let mut acc = init;\n        while let Option::Some(x) = it.next_back() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    // find, from the end.\n    fn rfind<P: FnMut(&Self::Item) -> bool>(&mut self, predicate: P) -> Option<Self::Item> {\n        let mut p = predicate;\n        while let Option::Some(x) = self.next_back() {\n            if p(&x) {\n");
    buf_str(out, c"                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// An iterator that knows how many items are left: size_hint is exact.\npub trait ExactSizeIterator: Iterator {\n    fn len(&self) -> usize {\n        self.size_hint().0\n    }\n\n    fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n}\n\n// An iterator that gives None for ever after its first None.\npub trait FusedIterator: Iterator {}\n\n// What a `for` loop iterates: an iterator itself, a collection by value\n// (its items), by & (references) or by &mut.\npub trait IntoIterator {\n    type Item;\n    type IntoIter: Iterator<Item = Self::Item>;\n\n    fn into_iter(self) -> Self::IntoIter;\n}\n\n// Every iterator is one.\n// later: blanket_impl\nimpl<I: Iterator> IntoIterator for I {\n    type Item = I::Item;\n    type IntoIter = I;\n\n    fn into_iter(self) -> I {\n        self\n    }\n}\n\n// Rust's FromIterator, with the allocator named: what `collect_in(a)`\n// makes (Vec, String, HashMap, HashSet).\n// mvs: Iterator::collect_in\npub trait FromIteratorIn<T, A>: Sized {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Self;\n}\n\n// A collection that items can be added to (`v.extend(it)`); it grows\n// from its own allocator.\npub trait Extend<T> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I);\n}\n\n// What `sum` adds up to: numbers from numbers or from references to them.\n// Built in, for each type P listed: `Sum for P` and `Sum<&'a P> for P`\n// (`iter.fold(0, |a, b| a + b)`, of references `a + *b`).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Sum<A = Self>: Sized {\n    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// What `product` multiplies up to. Built in as Sum is, with 1 and `*`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Product<A = Self>: Sized {\n    fn product<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n");
    buf_str(out, c"\n// What ranges iterate over: the integers and char. Sealed: std's impls\n// only (built in for each integer type; char's waits for char).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Step: Clone + PartialOrd + Sized {\n    // How many steps from start to end; None when end < start or too many.\n    fn steps_between(start: &Self, end: &Self) -> (usize, Option<usize>);\n    // start + count, None on overflow.\n    fn forward_checked(start: Self, count: usize) -> Option<Self>;\n    // start - count, None on overflow.\n    fn backward_checked(start: Self, count: usize) -> Option<Self>;\n}\n\n// `for i in 0..n`.\n// mvs: Range::impl Iterator\nimpl<A: Step> Iterator for Range<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.start < self.end {\n            let n = Step::forward_checked(self.start.clone(), 1)?;\n            Option::Some(crate::mem::replace(&mut self.start, n))\n        } else {\n            Option::None\n        }\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        Step::steps_between(&self.start, &self.end)\n    }\n}\n\n// `(0..n).rev()`.\nimpl<A: Step> DoubleEndedIterator for Range<A> {\n    fn next_back(&mut self) -> Option<A> {\n        if self.start < self.end {\n            self.end = Step::backward_checked(self.end.clone(), 1)?;\n            Option::Some(self.end.clone())\n        } else {\n            Option::None\n        }\n    }\n}\n\nimpl<A: Step> ExactSizeIterator for Range<A> {}\n\n// `for i in 0..=n`, `(0..=n).rev()`.\n// mvs: RangeInclusive::impl Iterator\nimpl<A: Step> Iterator for RangeInclusive<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        crate::panic::todo()\n    }\n}\n\nimpl<A: Step> DoubleEndedIterator for RangeInclusive<A> {\n    fn next_back(&mut self) -> Option<A> {\n        crate::panic::todo()\n    }\n}\n\n// `for i in 0..`: for ever (overflow panics in a debug build).\nimpl<A: Step> Iterator for RangeFrom<A> {\n");
    buf_str(out, c"    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        let n = Step::forward_checked(self.start.clone(), 1).expect(\"RangeFrom overflowed\");\n        Option::Some(crate::mem::replace(&mut self.start, n))\n    }\n}\n// ---- mod std::iter::adapters ----\nmod adapters {\n// EDITION: rust\n// The iterator adapters: each a named struct that Iterator's method of\n// the same name returns (no impl Trait in return position: plan §6), its\n// fields private, its constructor std's own.\n\nuse crate::clone::Clone;\nuse crate::cmp::PartialEq;\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, FusedIterator, IntoIterator, Iterator};\nuse crate::option::Option;\n\n// Iterator::map's: f of each item.\n// mvs: Map\n#[derive(Clone)]\npub struct Map<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> Map<I, F> {\n    fn new(iter: I, f: F) -> Map<I, F> {\n        Map { iter: iter, f: f }\n    }\n}\n\n// mvs: Map::impl Iterator\nimpl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for Map<I, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        self.iter.next().map(&mut self.f)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> B> DoubleEndedIterator for Map<I, F> {\n    fn next_back(&mut self) -> Option<B> {\n        self.iter.next_back().map(&mut self.f)\n    }\n}\n\nimpl<B, I: ExactSizeIterator, F: FnMut(I::Item) -> B> ExactSizeIterator for Map<I, F> {}\n\n// Iterator::filter's: the items the predicate says true of.\n// mvs: Filter\n#[derive(Clone)]\npub struct Filter<I, P> {\n    iter: I,\n    predicate: P,\n}\n\nimpl<I, P> Filter<I, P> {\n    fn new(iter: I, predicate: P) -> Filter<I, P> {\n        Filter { iter: iter, predicate: predicate }\n    }\n}\n\n// mvs: Filter::impl Iterator\n// std2: changed: the predicate takes &I::Item\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for Filter<I, P> {\n    type Item = I::Item;\n\n");
    buf_str(out, c"    fn next(&mut self) -> Option<I::Item> {\n        self.iter.find(&mut self.predicate)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, self.iter.size_hint().1)\n    }\n}\n\nimpl<I: DoubleEndedIterator, P: FnMut(&I::Item) -> bool> DoubleEndedIterator for Filter<I, P> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        self.iter.rfind(&mut self.predicate)\n    }\n}\n\n// Iterator::filter_map's.\n#[derive(Clone)]\npub struct FilterMap<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> FilterMap<I, F> {\n    fn new(iter: I, f: F) -> FilterMap<I, F> {\n        FilterMap { iter: iter, f: f }\n    }\n}\n\nimpl<B, I: Iterator, F: FnMut(I::Item) -> Option<B>> Iterator for FilterMap<I, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        self.iter.find_map(&mut self.f)\n    }\n}\n\nimpl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> Option<B>> DoubleEndedIterator for FilterMap<I,\n    F> {\n    fn next_back(&mut self) -> Option<B> {\n        while let Option::Some(x) = self.iter.next_back() {\n            if let Option::Some(y) = (self.f)(x) {\n                return Option::Some(y);\n            }\n        }\n        Option::None\n    }\n}\n\n// Iterator::enumerate's: (index, item).\n// mvs: Enumerate\n#[derive(Clone)]\npub struct Enumerate<I> {\n    iter: I,\n    count: usize,\n}\n\nimpl<I> Enumerate<I> {\n    fn new(iter: I) -> Enumerate<I> {\n        Enumerate { iter: iter, count: 0 }\n    }\n}\n\n// mvs: Enumerate::impl Iterator\n// std2: changed: the index is usize\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (usize, I::Item);\n\n    fn next(&mut self) -> Option<(usize, I::Item)> {\n        let x = self.iter.next()?;\n        let i = self.count;\n        self.count += 1;\n        Option::Some((i, x))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<I: ExactSizeIterator + DoubleEndedIterator> DoubleEndedIterator for Enumerate<I> {\n");
    buf_str(out, c"    fn next_back(&mut self) -> Option<(usize, I::Item)> {\n        let x = self.iter.next_back()?;\n        Option::Some((self.count + self.iter.len(), x))\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {}\n\n// Iterator::zip's: pairs, until either ends.\n// mvs: Zip\n#[derive(Clone)]\npub struct Zip<A, B> {\n    a: A,\n    b: B,\n}\n\nimpl<A, B> Zip<A, B> {\n    fn new(a: A, b: B) -> Zip<A, B> {\n        Zip { a: a, b: b }\n    }\n}\n\n// mvs: Zip::impl Iterator\nimpl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {\n    type Item = (A::Item, B::Item);\n\n    fn next(&mut self) -> Option<(A::Item, B::Item)> {\n        let x = self.a.next()?;\n        let y = self.b.next()?;\n        Option::Some((x, y))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        crate::panic::todo()\n    }\n}\n\nimpl<A: ExactSizeIterator, B: ExactSizeIterator> ExactSizeIterator for Zip<A, B> {}\n\n// Iterator::chain's: one, then the other.\n#[derive(Clone)]\npub struct Chain<A, B> {\n    a: Option<A>,\n    b: Option<B>,\n}\n\nimpl<A, B> Chain<A, B> {\n    fn new(a: A, b: B) -> Chain<A, B> {\n        Chain { a: Option::Some(a), b: Option::Some(b) }\n    }\n}\n\nimpl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {\n    type Item = A::Item;\n\n    fn next(&mut self) -> Option<A::Item> {\n        if let Option::Some(a) = &mut self.a {\n            match a.next() {\n                Option::Some(x) => return Option::Some(x),\n                Option::None => self.a = Option::None,\n            }\n        }\n        match &mut self.b {\n            Option::Some(b) => b.next(),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<A: DoubleEndedIterator,\n    B: DoubleEndedIterator<Item = A::Item>> DoubleEndedIterator for Chain<A, B> {\n    fn next_back(&mut self) -> Option<A::Item> {\n        crate::panic::todo()\n    }\n}\n\n// Iterator::take's: the first n items.\n// mvs: Take\n#[derive(Clone)]\n");
    buf_str(out, c"pub struct Take<I> {\n    iter: I,\n    n: usize,\n}\n\nimpl<I> Take<I> {\n    fn new(iter: I, n: usize) -> Take<I> {\n        Take { iter: iter, n: n }\n    }\n}\n\n// mvs: Take::impl Iterator\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n == 0 {\n            return Option::None;\n        }\n        self.n -= 1;\n        self.iter.next()\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {}\n\n// Iterator::skip's: all but the first n.\n#[derive(Clone)]\npub struct Skip<I> {\n    iter: I,\n    n: usize,\n}\n\nimpl<I> Skip<I> {\n    fn new(iter: I, n: usize) -> Skip<I> {\n        Skip { iter: iter, n: n }\n    }\n}\n\nimpl<I: Iterator> Iterator for Skip<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n > 0 {\n            let n = self.n;\n            self.n = 0;\n            return self.iter.nth(n);\n        }\n        self.iter.next()\n    }\n}\n\nimpl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        crate::panic::todo()\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {}\n\n// Iterator::take_while's.\n#[derive(Clone)]\npub struct TakeWhile<I, P> {\n    iter: I,\n    flag: bool,\n    predicate: P,\n}\n\nimpl<I, P> TakeWhile<I, P> {\n    fn new(iter: I, predicate: P) -> TakeWhile<I, P> {\n        TakeWhile { iter: iter, flag: false, predicate: predicate }\n    }\n}\n\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for TakeWhile<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.flag {\n            return Option::None;\n        }\n        let x = self.iter.next()?;\n        if (self.predicate)(&x) {\n            Option::Some(x)\n        } else {\n            self.flag = true;\n            Option::None\n        }\n    }\n}\n\n// Iterator::skip_while's.\n");
    buf_str(out, c"#[derive(Clone)]\npub struct SkipWhile<I, P> {\n    iter: I,\n    flag: bool,\n    predicate: P,\n}\n\nimpl<I, P> SkipWhile<I, P> {\n    fn new(iter: I, predicate: P) -> SkipWhile<I, P> {\n        SkipWhile { iter: iter, flag: false, predicate: predicate }\n    }\n}\n\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for SkipWhile<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        loop {\n            let x = self.iter.next()?;\n            if self.flag || !(self.predicate)(&x) {\n                self.flag = true;\n                return Option::Some(x);\n            }\n        }\n    }\n}\n\n// Iterator::map_while's.\n#[derive(Clone)]\npub struct MapWhile<I, P> {\n    iter: I,\n    predicate: P,\n}\n\nimpl<I, P> MapWhile<I, P> {\n    fn new(iter: I, predicate: P) -> MapWhile<I, P> {\n        MapWhile { iter: iter, predicate: predicate }\n    }\n}\n\nimpl<B, I: Iterator, P: FnMut(I::Item) -> Option<B>> Iterator for MapWhile<I, P> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        let x = self.iter.next()?;\n        (self.predicate)(x)\n    }\n}\n\n// Iterator::step_by's.\n#[derive(Clone)]\npub struct StepBy<I> {\n    iter: I,\n    step: usize,\n    first_take: bool,\n}\n\nimpl<I> StepBy<I> {\n    fn new(iter: I, step: usize) -> StepBy<I> {\n        if step == 0 {\n            crate::panic::panic(\"step_by: step is 0\");\n        }\n        StepBy { iter: iter, step: step - 1, first_take: true }\n    }\n}\n\nimpl<I: Iterator> Iterator for StepBy<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.first_take {\n            self.first_take = false;\n            self.iter.next()\n        } else {\n            self.iter.nth(self.step)\n        }\n    }\n}\n\n// Iterator::peekable's: peek at the next item without taking it.\npub struct Peekable<I: Iterator> {\n    iter: I,\n    peeked: Option<Option<I::Item>>,\n}\n\nimpl<I: Iterator> Peekable<I> {\n");
    buf_str(out, c"    fn new(iter: I) -> Peekable<I> {\n        Peekable { iter: iter, peeked: Option::None }\n    }\n\n    // The next item, still to come.\n    pub fn peek(&mut self) -> Option<&I::Item> {\n        let iter = &mut self.iter;\n        self.peeked.get_or_insert_with(|| iter.next()).as_ref()\n    }\n\n    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {\n        let iter = &mut self.iter;\n        self.peeked.get_or_insert_with(|| iter.next()).as_mut()\n    }\n\n    // The next item, when func says true of it.\n    pub fn next_if<F: FnOnce(&I::Item) -> bool>(&mut self, func: F) -> Option<I::Item> {\n        crate::panic::todo()\n    }\n\n    // The next item, when it equals expected.\n    pub fn next_if_eq<T: ?Sized>(&mut self, expected: &T) -> Option<I::Item>\n        where\n            I::Item: PartialEq<T>,\n    {\n        self.next_if(|x| *x == *expected)\n    }\n}\n\nimpl<I: Iterator> Iterator for Peekable<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match self.peeked.take() {\n            Option::Some(v) => v,\n            Option::None => self.iter.next(),\n        }\n    }\n}\n\n// Iterator::rev's: from the end.\n#[derive(Clone)]\npub struct Rev<I> {\n    iter: I,\n}\n\nimpl<I> Rev<I> {\n    fn new(iter: I) -> Rev<I> {\n        Rev { iter: iter }\n    }\n}\n\nimpl<I: DoubleEndedIterator> Iterator for Rev<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.next_back()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        self.iter.next()\n    }\n}\n\nimpl<I: DoubleEndedIterator + ExactSizeIterator> ExactSizeIterator for Rev<I> {}\n\n// Iterator::copied's: copies of the &T items.\n#[derive(Clone)]\npub struct Copied<I> {\n    iter: I,\n}\n\nimpl<I> Copied<I> {\n    fn new(iter: I) -> Copied<I> {\n");
    buf_str(out, c"        Copied { iter: iter }\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: Iterator<Item = &'a T>> Iterator for Copied<I> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.iter.next().copied()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Copied<I> {\n    fn next_back(&mut self) -> Option<T> {\n        self.iter.next_back().copied()\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: ExactSizeIterator<Item = &'a T>> ExactSizeIterator for Copied<I> {}\n\n// Iterator::cloned's: clones of the &T items.\n#[derive(Clone)]\npub struct Cloned<I> {\n    iter: I,\n}\n\nimpl<I> Cloned<I> {\n    fn new(iter: I) -> Cloned<I> {\n        Cloned { iter: iter }\n    }\n}\n\nimpl<'a, T: Clone + 'a, I: Iterator<Item = &'a T>> Iterator for Cloned<I> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.iter.next().cloned()\n    }\n}\n\nimpl<'a, T: Clone + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Cloned<I> {\n    fn next_back(&mut self) -> Option<T> {\n        self.iter.next_back().cloned()\n    }\n}\n\n// Iterator::flatten's: the items of each item.\npub struct Flatten<I: Iterator>\n    where\n        I::Item: IntoIterator,\n{\n    iter: Fuse<I>,\n    front: Option<<I::Item as IntoIterator>::IntoIter>,\n    back: Option<<I::Item as IntoIterator>::IntoIter>,\n}\n\nimpl<I: Iterator> Flatten<I>\n    where\n        I::Item: IntoIterator,\n{\n    fn new(iter: I) -> Flatten<I> {\n        Flatten { iter: Fuse::new(iter), front: Option::None, back: Option::None }\n    }\n}\n\nimpl<I: Iterator> Iterator for Flatten<I>\n    where\n        I::Item: IntoIterator,\n{\n    type Item = <I::Item as IntoIterator>::Item;\n\n    fn next(&mut self) -> Option<<I::Item as IntoIterator>::Item> {\n        crate::panic::todo()\n    }\n}\n\n// Iterator::flat_map's: the items of each f(item).\n");
    buf_str(out, c"pub struct FlatMap<I, U: IntoIterator, F> {\n    iter: Map<I, F>,\n    front: Option<U::IntoIter>,\n    back: Option<U::IntoIter>,\n}\n\nimpl<I, U: IntoIterator, F> FlatMap<I, U, F> {\n    fn new(iter: I, f: F) -> FlatMap<I, U, F> {\n        FlatMap { iter: Map::new(iter, f), front: Option::None, back: Option::None }\n    }\n}\n\nimpl<I: Iterator, U: IntoIterator, F: FnMut(I::Item) -> U> Iterator for FlatMap<I, U, F> {\n    type Item = U::Item;\n\n    fn next(&mut self) -> Option<U::Item> {\n        loop {\n            if let Option::Some(inner) = &mut self.front {\n                if let Option::Some(x) = inner.next() {\n                    return Option::Some(x);\n                }\n                self.front = Option::None;\n            }\n            match self.iter.next() {\n                Option::Some(u) => self.front = Option::Some(u.into_iter()),\n                Option::None => {\n                    return match &mut self.back {\n                        Option::Some(b) => b.next(),\n                        Option::None => Option::None,\n                    };\n                }\n            }\n        }\n    }\n}\n\n// Iterator::fuse's: None for ever after the first None.\n#[derive(Clone)]\npub struct Fuse<I> {\n    iter: Option<I>,\n}\n\nimpl<I> Fuse<I> {\n    fn new(iter: I) -> Fuse<I> {\n        Fuse { iter: Option::Some(iter) }\n    }\n}\n\nimpl<I: Iterator> Iterator for Fuse<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match &mut self.iter {\n            Option::Some(it) => match it.next() {\n                Option::Some(x) => Option::Some(x),\n                Option::None => {\n                    self.iter = Option::None;\n                    Option::None\n                }\n            },\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<I: Iterator> FusedIterator for Fuse<I> {}\n\n// Iterator::inspect's.\n#[derive(Clone)]\npub struct Inspect<I, F> {\n    iter: I,\n    f: F,\n}\n\n");
    buf_str(out, c"impl<I, F> Inspect<I, F> {\n    fn new(iter: I, f: F) -> Inspect<I, F> {\n        Inspect { iter: iter, f: f }\n    }\n}\n\nimpl<I: Iterator, F: FnMut(&I::Item)> Iterator for Inspect<I, F> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        let x = self.iter.next()?;\n        (self.f)(&x);\n        Option::Some(x)\n    }\n}\n\n// Iterator::scan's.\n#[derive(Clone)]\npub struct Scan<I, St, F> {\n    iter: I,\n    f: F,\n    state: St,\n}\n\nimpl<I, St, F> Scan<I, St, F> {\n    fn new(iter: I, state: St, f: F) -> Scan<I, St, F> {\n        Scan { iter: iter, f: f, state: state }\n    }\n}\n\nimpl<B, I: Iterator, St, F: FnMut(&mut St, I::Item) -> Option<B>> Iterator for Scan<I, St, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        let x = self.iter.next()?;\n        (self.f)(&mut self.state, x)\n    }\n}\n\n// Iterator::cycle's: again and again.\n#[derive(Clone)]\npub struct Cycle<I> {\n    orig: I,\n    iter: I,\n}\n\nimpl<I: Clone> Cycle<I> {\n    fn new(iter: I) -> Cycle<I> {\n        Cycle { orig: iter.clone(), iter: iter }\n    }\n}\n\nimpl<I: Clone + Iterator> Iterator for Cycle<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match self.iter.next() {\n            Option::None => {\n                self.iter = self.orig.clone();\n                self.iter.next()\n            }\n            y => y,\n        }\n    }\n}\n// ---- end mod std::iter::adapters ----\n}\n// ---- mod std::iter::sources ----\nmod sources {\n// EDITION: rust\n// The iterator sources: iterators made from nothing, one value, a value\n// again and again, or a closure.\n\nuse crate::clone::Clone;\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator, Zip};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\n\n// No items.\npub fn empty<T>() -> Empty<T> {\n    Empty { marker: PhantomData }\n}\n\npub struct Empty<T> {\n    marker: PhantomData<T>,\n}\n\n");
    buf_str(out, c"impl<T> Iterator for Empty<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        Option::None\n    }\n}\n\nimpl<T> DoubleEndedIterator for Empty<T> {\n    fn next_back(&mut self) -> Option<T> {\n        Option::None\n    }\n}\n\n// One item.\npub fn once<T>(value: T) -> Once<T> {\n    Once { value: Option::Some(value) }\n}\n\npub struct Once<T> {\n    value: Option<T>,\n}\n\nimpl<T> Iterator for Once<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.value.take()\n    }\n}\n\nimpl<T> DoubleEndedIterator for Once<T> {\n    fn next_back(&mut self) -> Option<T> {\n        self.value.take()\n    }\n}\n\n// Clones of value, for ever (`.take(n)`).\npub fn repeat<T: Clone>(value: T) -> Repeat<T> {\n    Repeat { value: value }\n}\n\n#[derive(Clone)]\npub struct Repeat<T> {\n    value: T,\n}\n\nimpl<T: Clone> Iterator for Repeat<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        Option::Some(self.value.clone())\n    }\n}\n\n// n clones of value (the last one the value itself).\npub fn repeat_n<T: Clone>(value: T, n: usize) -> RepeatN<T> {\n    RepeatN { value: if n == 0 { Option::None } else { Option::Some(value) }, left: n }\n}\n\n#[derive(Clone)]\npub struct RepeatN<T> {\n    value: Option<T>,\n    left: usize,\n}\n\nimpl<T: Clone> Iterator for RepeatN<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.left == 0 {\n            return Option::None;\n        }\n        self.left -= 1;\n        if self.left == 0 { self.value.take() } else { self.value.clone() }\n    }\n}\n\nimpl<T: Clone> ExactSizeIterator for RepeatN<T> {}\n\n// f's values until it gives None.\npub fn from_fn<T, F: FnMut() -> Option<T>>(f: F) -> FromFn<F> {\n    FromFn { f: f }\n}\n\n#[derive(Clone)]\npub struct FromFn<F> {\n    f: F,\n}\n\nimpl<T, F: FnMut() -> Option<T>> Iterator for FromFn<F> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        (self.f)()\n    }\n}\n\n");
    buf_str(out, c"// first, then succ of each item, until succ gives None.\npub fn successors<T, F: FnMut(&T) -> Option<T>>(first: Option<T>, succ: F) -> Successors<T, F> {\n    Successors { next: first, succ: succ }\n}\n\n#[derive(Clone)]\npub struct Successors<T, F> {\n    next: Option<T>,\n    succ: F,\n}\n\nimpl<T, F: FnMut(&T) -> Option<T>> Iterator for Successors<T, F> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let item = self.next.take()?;\n        self.next = (self.succ)(&item);\n        Option::Some(item)\n    }\n}\n\n// The pairs of a's and b's items (`zip(&xs, &ys)`).\npub fn zip<A: IntoIterator, B: IntoIterator>(a: A, b: B) -> Zip<A::IntoIter, B::IntoIter> {\n    a.into_iter().zip(b)\n}\n// ---- end mod std::iter::sources ----\n}\n// ---- end mod std::iter ----\n}\n// ---- mod std::fmt ----\npub mod fmt {\n// EDITION: rust\n// std::fmt: Display, Debug, Formatter<'a>, fmt::Write, and the print\n// functions. Rust's shape (`fn fmt(&self, f: &mut Formatter<'_>) ->\n// fmt::Result`), with two differences that come from having no `dyn`\n// (plan §3): a Formatter is one concrete type over an erased sink (a data\n// pointer and a write function, as AnyAlloc erases an allocator), not a\n// `&mut dyn Write`, so a Debug impl is compiled once, not once per sink;\n// and the builders' `field` and `entry` are generic over the value's type\n// instead of taking a `&dyn Debug`. There are no macros: a format literal\n// at a `T: Display` parameter (`println(\"{x} {y:>5}\")`, `format_in(\"{n}\",\n// a)`) is checked by the compiler and made a value that displays it\n// (`edition.later: format_fns`); `write(w, \"..\")` and `writeln` are the\n// compiler's for `w.write_fmt(\"..\")`, fmt::Write's or io::Write's.\n\nuse crate::alloc::Allocator;\nuse crate::iter::IntoIterator;\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::string::String;\n\n// What fmt returns: Err when the sink failed (a closed pipe), not when\n");
    buf_str(out, c"// the value cannot be shown.\npub type Result = crate::result::Result<(), Error>;\n\n// A sink's failure. It carries nothing: the sink knows why.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]\npub struct Error;\n\n// How a value shows to a user: `{x}`.\n// std2: changed: fmt(&self, &mut Formatter) -> Result (MVS: fmt(self, inout Fmt))\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Display {\n    // std2: changed: takes &self and a Formatter, returns a Result\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// How a value shows to a programmer: `{x:?}`, `{x:#?}` (pretty).\n// std2: changed: fmt(&self, &mut Formatter) -> Result (MVS: fmt_debug(self, inout Fmt))\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Debug {\n    // mvs: Debug::fmt_debug\n    // std2: renamed\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:x}`: lower-case hexadecimal (integers' impls built in, as each of\n// these traits'; bodies in 0.27.2).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait LowerHex {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:X}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait UpperHex {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:o}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Octal {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:b}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Binary {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:e}`: floats in scientific notation.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait LowerExp {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:E}`.\n");
    buf_str(out, c"#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait UpperExp {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{p:p}`: a pointer's address.\npub trait Pointer {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// A sink of text: what `write(w, \"..\")` writes into when w is a String\n// (or any type that implements it). Never fails for a String.\npub trait Write {\n    fn write_str(&mut self, s: &str) -> Result;\n\n    fn write_char(&mut self, c: char) -> Result {\n        self.write_str(c.encode_utf8(&mut [0u8; 4]))\n    }\n\n    // x written as its Display shows it (a format literal: the compiler's\n    // `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result {\n        crate::panic::todo()\n    }\n}\n\n// A reference displays and debugs as what it refers to.\nimpl<T: Display + ?Sized> Display for &T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Display::fmt(&**self, f)\n    }\n}\n\nimpl<T: Debug + ?Sized> Debug for &T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Debug::fmt(&**self, f)\n    }\n}\n\nimpl<T: Display + ?Sized> Display for &mut T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Display::fmt(&**self, f)\n    }\n}\n\nimpl<T: Debug + ?Sized> Debug for &mut T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Debug::fmt(&**self, f)\n    }\n}\n\nimpl Debug for () {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        f.pad(\"()\")\n    }\n}\n\n// Where a padded value sits in its width.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Alignment {\n    Left,\n    Right,\n    Center,\n}\n\n// What a value is written into, with its hole's spec ({:>8.3}): the sink\n// erased (no dyn), the width, precision, fill, alignment and flags.\n// Its fill is a char (`edition.later: char`).\n// mvs: Fmt\n// std2: renamed\n// later: char\npub struct Formatter<'a> {\n    out: *mut u8,\n");
    buf_str(out, c"    write: fn(*mut u8, &str) -> Result,\n    width: Option<usize>,\n    precision: Option<usize>,\n    fill: char,\n    align: Option<Alignment>,\n    flags: u32,\n    marker: PhantomData<&'a mut ()>,\n}\n\nimpl<'a> Formatter<'a> {\n    // A Formatter over any fmt::Write, with an empty spec (what\n    // `write(w, ..)` makes).\n    pub fn new<W: Write>(w: &'a mut W) -> Formatter<'a> {\n        crate::panic::todo()\n    }\n\n    // s, as it is (no padding).\n    // mvs: Fmt::str\n    // std2: renamed\n    pub fn write_str(&mut self, s: &str) -> Result {\n        (self.write)(self.out, s)\n    }\n\n    // mvs: Fmt::byte\n    // std2: renamed\n    pub fn write_char(&mut self, c: char) -> Result {\n        self.write_str(c.encode_utf8(&mut [0u8; 4]))\n    }\n\n    // x as its Display shows it (a format literal inside a Display impl:\n    // `write(f, \"({x}, {y})\")`).\n    // mvs: Fmt::write, Fmt::display, Fmt::debug\n    // std2: renamed\n    pub fn write_fmt<T: Display>(&mut self, x: T) -> Result {\n        x.fmt(self)\n    }\n\n    // s padded to the width with the fill, as the alignment says (Left by\n    // default), and cut to the precision: what str's Display does.\n    pub fn pad(&mut self, s: &str) -> Result {\n        crate::panic::todo()\n    }\n\n    // An integer's digits, padded: the sign, `#`'s prefix, `0`'s zeros.\n    pub fn pad_integral(&mut self, is_nonnegative: bool, prefix: &str, digits: &str) -> Result {\n        crate::panic::todo()\n    }\n\n    // The hole's width ({:8}), its precision ({:.3}), its fill ({:*^8}),\n    // its alignment, its flags.\n    pub fn width(&self) -> Option<usize> {\n        self.width\n    }\n\n    pub fn precision(&self) -> Option<usize> {\n        self.precision\n    }\n\n    pub fn fill(&self) -> char {\n        self.fill\n    }\n\n    pub fn align(&self) -> Option<Alignment> {\n        self.align\n    }\n\n    // `#`: Debug's pretty form, `0x` for hex.\n    pub fn alternate(&self) -> bool {\n");
    buf_str(out, c"        self.flags & 4 != 0\n    }\n\n    // `+`.\n    pub fn sign_plus(&self) -> bool {\n        self.flags & 1 != 0\n    }\n\n    // `-`.\n    pub fn sign_minus(&self) -> bool {\n        self.flags & 2 != 0\n    }\n\n    // `0`.\n    pub fn sign_aware_zero_pad(&self) -> bool {\n        self.flags & 8 != 0\n    }\n\n    // `Name { a: 1, b: 2 }`, field by field.\n    pub fn debug_struct<'b>(&'b mut self, name: &str) -> DebugStruct<'b, 'a> {\n        crate::panic::todo()\n    }\n\n    // `Name(1, 2)`.\n    pub fn debug_tuple<'b>(&'b mut self, name: &str) -> DebugTuple<'b, 'a> {\n        crate::panic::todo()\n    }\n\n    // `[1, 2]`.\n    // mvs: debug_list, Fmt::debug_slice\n    // std2: changed: a builder (MVS: debug_list(f, s) of a slice)\n    pub fn debug_list<'b>(&'b mut self) -> DebugList<'b, 'a> {\n        crate::panic::todo()\n    }\n\n    // `{1, 2}`.\n    pub fn debug_set<'b>(&'b mut self) -> DebugSet<'b, 'a> {\n        crate::panic::todo()\n    }\n\n    // `{k: v, ...}`.\n    pub fn debug_map<'b>(&'b mut self) -> DebugMap<'b, 'a> {\n        crate::panic::todo()\n    }\n}\n\n// Formatter::debug_struct's builder.\npub struct DebugStruct<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_fields: bool,\n}\n\nimpl<'a, 'b> DebugStruct<'a, 'b> {\n    pub fn field<T: Debug + ?Sized>(&mut self, name: &str, value: &T) -> &mut DebugStruct<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    // `Name { a: 1, .. }`.\n    pub fn finish_non_exhaustive(&mut self) -> Result {\n        crate::panic::todo()\n    }\n\n    pub fn finish(&mut self) -> Result {\n        crate::panic::todo()\n    }\n}\n\n// Formatter::debug_tuple's builder.\npub struct DebugTuple<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    fields: usize,\n}\n\nimpl<'a, 'b> DebugTuple<'a, 'b> {\n    pub fn field<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugTuple<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    pub fn finish(&mut self) -> Result {\n");
    buf_str(out, c"        crate::panic::todo()\n    }\n}\n\n// Formatter::debug_list's builder.\npub struct DebugList<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugList<'a, 'b> {\n    pub fn entry<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugList<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    pub fn entries<D: Debug, I: IntoIterator<Item = D>>(&mut self, entries: I) -> &mut DebugList<'a,\n        'b> {\n        for e in entries {\n            self.entry(&e);\n        }\n        self\n    }\n\n    pub fn finish(&mut self) -> Result {\n        crate::panic::todo()\n    }\n}\n\n// Formatter::debug_set's builder.\npub struct DebugSet<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugSet<'a, 'b> {\n    pub fn entry<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugSet<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    pub fn entries<D: Debug, I: IntoIterator<Item = D>>(&mut self, entries: I) -> &mut DebugSet<'a,\n        'b> {\n        for e in entries {\n            self.entry(&e);\n        }\n        self\n    }\n\n    pub fn finish(&mut self) -> Result {\n        crate::panic::todo()\n    }\n}\n\n// Formatter::debug_map's builder.\npub struct DebugMap<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugMap<'a, 'b> {\n    pub fn entry<K: Debug + ?Sized,\n        V: Debug + ?Sized>(&mut self, key: &K, value: &V) -> &mut DebugMap<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    pub fn key<K: Debug + ?Sized>(&mut self, key: &K) -> &mut DebugMap<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    pub fn value<V: Debug + ?Sized>(&mut self, value: &V) -> &mut DebugMap<'a, 'b> {\n        crate::panic::todo()\n    }\n\n    pub fn entries<K: Debug, V: Debug,\n        I: IntoIterator<Item = (K, V)>>(&mut self, entries: I) -> &mut DebugMap<'a, 'b> {\n        for (k, v) in entries {\n");
    buf_str(out, c"            self.entry(&k, &v);\n        }\n        self\n    }\n\n    pub fn finish(&mut self) -> Result {\n        crate::panic::todo()\n    }\n}\n\n// ---- The print functions (Rust's macros) ----\n\n// x on stdout (`print(\"{x}\")`); stdout is line-buffered when a terminal.\n// later: format_fns\npub fn print<T: Display>(x: T) {\n    crate::panic::todo()\n}\n\n// x and a newline on stdout.\n// later: format_fns\npub fn println<T: Display>(x: T) {\n    crate::panic::todo()\n}\n\n// x on stderr.\n// later: format_fns\npub fn eprint<T: Display>(x: T) {\n    crate::panic::todo()\n}\n\n// later: format_fns\npub fn eprintln<T: Display>(x: T) {\n    crate::panic::todo()\n}\n\n// x as a String on a (Rust's `format!`, allocator last: plan §2).\n// std2: changed: takes x by value and the allocator\n// later: format_fns\npub fn format_in<T: Display, A: Allocator>(x: T, a: A) -> String<A> {\n    let mut s = String::new_in(a);\n    let _ = s.write_fmt(x);\n    s\n}\n\n// A format literal as a value (`format_args(\"{a}-{b}\").to_string_in(gpa)`):\n// the literal's Display value, passed through.\n// later: format_fns\npub fn format_args<T: Display>(x: T) -> T {\n    x\n}\n// ---- end mod std::fmt ----\n}\n// ---- mod std::io ----\npub mod io {\n// EDITION: rust\n// std::io: Read, Write and BufRead, the buffered types, the standard\n// streams, Error. Rust's shape: counts are usize, `read_line` is\n// Stdin's (and BufRead's) and returns the bytes read (0 at the end), and\n// what reads into a growing buffer takes the buffer (`read_to_end(&mut\n// v)`, which grows from v's allocator) or an allocator (`lines_in(a)`,\n// `read_to_string_in(r, a)`). The buffered types hold a fixed buffer\n// inline, so making one allocates nothing. Seek and the file types are\n// std::fs's (0.27.2).\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\n");
    buf_str(out, c"use crate::string::String;\nuse crate::vec::Vec;\n\n// io's Result: an io::Error on failure.\n// mvs: Result\npub type Result<T> = crate::result::Result<T, Error>;\n\n// What failed: a kind, and the OS's error number when it came from one.\n// mvs: Error, IoError\n// std2: changed: Rust's io::Error (MVS's root IoError is gone into it)\npub struct Error {\n    kind: ErrorKind,\n    code: i32,\n    msg: &'static str,\n}\n\nimpl Error {\n    // An error of kind k, with a message (Rust's takes any error; vole's a\n    // static text: no allocation, no dyn).\n    // std2: changed: a message, &'static str\n    pub fn new(k: ErrorKind, msg: &'static str) -> Error {\n        Error { kind: k, code: 0, msg: msg }\n    }\n\n    // An error of kind Other, with a message.\n    pub fn other(msg: &'static str) -> Error {\n        Error::new(ErrorKind::Other, msg)\n    }\n\n    // The error errno says.\n    pub fn from_raw_os_error(code: i32) -> Error {\n        crate::panic::todo()\n    }\n\n    // The error of the last failed OS call (errno).\n    pub fn last_os_error() -> Error {\n        crate::panic::todo()\n    }\n\n    pub fn kind(&self) -> ErrorKind {\n        self.kind\n    }\n\n    pub fn raw_os_error(&self) -> Option<i32> {\n        if self.code == 0 { Option::None } else { Option::Some(self.code) }\n    }\n}\n\n// mvs: Error::impl Display, IoError::impl Display\nimpl Display for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        crate::panic::todo()\n    }\n}\n\n// mvs: Error::impl Debug, IoError::impl Debug\nimpl Debug for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        crate::panic::todo()\n    }\n}\n\nimpl From<ErrorKind> for Error {\n    fn from(k: ErrorKind) -> Error {\n        Error::new(k, \"\")\n    }\n}\n\n// What kind of failure, as Rust's (the ones vole's OS calls give).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum ErrorKind {\n    NotFound,\n    PermissionDenied,\n");
    buf_str(out, c"    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\nimpl Display for ErrorKind {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        crate::panic::todo()\n    }\n}\n\n// A source of bytes.\npub trait Read {\n    // Up to buf.len() bytes into buf; how many (0 at the end).\n    // std2: changed: &mut [u8], a usize\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize>;\n\n    // Exactly buf.len() bytes, or UnexpectedEof.\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        crate::panic::todo()\n    }\n\n    // Everything left, appended to buf (grown from buf's allocator).\n    // std2: changed: a usize\n    fn read_to_end<A: Allocator>(&mut self, buf: &mut Vec<u8, A>) -> Result<usize> {\n        crate::panic::todo()\n    }\n\n    // Everything left, appended to buf; InvalidData when it is not UTF-8.\n    // std2: changed: a usize\n    fn read_to_string<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        crate::panic::todo()\n    }\n\n    // The reader borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A sink of bytes.\npub trait Write {\n    // Some of buf; how much was written.\n    // std2: changed: &[u8], a usize\n    fn write(&mut self, buf: &[u8]) -> Result<usize>;\n\n    // Whatever is buffered, out to its destination.\n    fn flush(&mut self) -> Result<()>;\n\n    // All of buf (write until it is written, or an error).\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        crate::panic::todo()\n    }\n\n    // x as its Display shows it (the compiler's `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result<()> {\n"