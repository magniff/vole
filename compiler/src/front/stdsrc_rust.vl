    buf_str(out, c"    // Appends p after a '/' (p absolute: p replaces the path).\n    // std2: changed: p an AsRef<str> (Rust: AsRef<Path>; MVS: [u8])\n    #[effects(panic, A)]\n    pub fn push<P: AsRef<str>>(&mut self, p: P) {\n        let t = p.as_ref();\n        if t.len() > 0 && t.as_bytes()[0] == b'/' {\n            self.s.clear();\n        } else if self.s.len() > 0 && self.s.as_bytes()[self.s.len() - 1] != b'/' {\n            self.s.push('/');\n        }\n        self.s.push_str(t);\n    }\n\n    // Removes the last component: false when there is none (the root, or\n    // nothing).\n    #[effects(panic, diverge, A)]\n    pub fn pop(&mut self) -> bool {\n        let n = match self.as_path().parent() {\n            Option::Some(q) => q.as_str().len(),\n            Option::None => return false,\n        };\n        self.s.truncate(n);\n        true\n    }\n\n    // Its file name replaced by name (added when it has none).\n    // std2: changed: name an AsRef<str> (Rust: AsRef<OsStr>)\n    #[effects(panic, diverge, A, S)]\n    pub fn set_file_name<S: AsRef<str>>(&mut self, name: S) {\n        if self.as_path().file_name().is_some() {\n            self.pop();\n        }\n        self.push(name);\n    }\n\n    // Its extension replaced by ext (added when it has none; \"\" removes\n    // it): false, and nothing changed, when it has no file name.\n    // std2: changed: ext an AsRef<str> (Rust: AsRef<OsStr>; MVS: [u8])\n    #[effects(panic, diverge, A)]\n    pub fn set_extension<S: AsRef<str>>(&mut self, ext: S) -> bool {\n        let (start, end) = match file_name_range(self.s.as_str()) {\n            Option::Some(r) => r,\n            Option::None => return false,\n        };\n        let stem = split_dot(&self.s.as_str()[start..end]).0.len();\n        self.s.truncate(start + stem);\n        let e = ext.as_ref();\n        if e.len() > 0 {\n            self.s.push('.');\n            self.s.push_str(e);\n        }\n        true\n    }\n\n");
