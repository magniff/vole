// Generated by compiler/std/embed.sh --edition rust from compiler/std2/
// (do not edit): the rust edition's standard library (0.27), its
// sections' index, its files and its line marks, as std_source and
// the others are for MVS's std (stdsrc.vl).

use crate::base::buf_str;

pub fn std2_source(out: i64) {
    buf_str(out, c"// EDITION: rust\n// The rust edition's standard library (0.27): the API of the std that\n// rust-edition programs use from 0.27.2 on, and that `fix --edition rust`\n// (0.27.3) rewrites MVS programs against. In 0.27.0 it is a spec: every\n// item's signature in its final form and its doc, with a body where one\n// is trivial and `todo()` otherwise. It is checked as its own root,\n// `volec check --edition rust compiler/std2/std.vl`; rust-edition\n// programs still run on MVS's std through ed270's reference-typed\n// signatures until 0.27.2 builds this tree into the compiler\n// (compiler/std/embed.sh --edition rust).\n//\n// It is a redesign, not a port of compiler/std (docs/design/rust-surface-plan.md,\n// §2, §3, §6):\n// - `v.get(i)` is `Option<&T>`, iterators yield `&T` and `iter_mut` `&mut T`;\n//   maps have `entry`, and `Option` has `take`, `as_ref` and `as_mut`;\n// - allocation is a capability: there is no default allocator, a\n//   container names its allocator type `A`, every allocation outside a\n//   container's own operations takes an allocator value, last (`_in`), and\n//   `Clone` reuses the stored allocator while `clone_in(a)` moves to another;\n// - every iterator has a named type: std needs no `impl Trait` in return\n//   position;\n// - std's paths are Rust's (std::vec::Vec, std::collections::HashMap,\n//   std::alloc::Arena), and the prelude is Rust's with vole's additions.\n//\n// Each item's line in compiler/std2/checklist.tsv (tools/std2-checklist.py)\n// says whether it is kept from MVS's std, renamed, changed or new, which\n// MVS items are gone and into what, the features it needs, and the\n// gate-1 test that covers it. Markers in an item's comment feed it:\n// `// later: NAME` (a feature the rust front reports as\n// `edition.later: NAME (0.27.N)`), `// mvs: PATH` (the MVS item it\n// replaces, when its name or place differs), `// std2: renamed` and\n// `// std2: changed: WHY`.\n//\n");
    buf_str(out, c"// Two kinds of item are the compiler's, as MVS's are: an item over\n// `[T; N]` for every N, `#[array_builtin(N)]` (until const generics), and\n// a trait's impls for the primitive types, `#[builtin_impls(i8, ...,\n// bool)]` on the trait (each type listed gets `impl Trait for P`; char's\n// come with the char feature). Both wait for 0.27.2 (array_builtin,\n// primitive_builtin), and the checklist gives each trait's builtin impls\n// a line.\n\npub mod prelude;\n\npub mod marker;\npub mod ops;\npub mod cmp;\npub mod clone;\npub mod default;\npub mod convert;\npub mod borrow;\npub mod mem;\npub mod ptr;\npub mod cell;\npub mod panic;\n\npub mod option;\npub mod result;\n\npub mod alloc;\npub mod boxed;\npub mod vec;\npub mod slice;\npub mod str;\npub mod char;\npub mod string;\npub mod hash;\npub mod collections;\n\npub mod iter;\npub mod fmt;\npub mod io;\npub mod thread;\n// ---- mod std::prelude ----\npub mod prelude {\n// EDITION: rust\n// The prelude: what every rust-edition module sees without a `use`.\n// Rust's own list (std::prelude::rust_2024), less what vole has not got\n// (`ToString`, `FromIterator` and `ToOwned` become their `_In` forms,\n// there are no macros) and with vole's: `Gpa`, `DefaultIn`, and the\n// format functions, which are functions whose format literal the\n// compiler checks (`println(\"{x}\")`; plan §3). `Send`, `Sync`, `Sized`,\n// `AllocFree` and the `Fn` traits are the compiler's and need no `use`.\n// `HashMap` is not in it, as in Rust: `use std::collections::HashMap;`.\n\npub use crate::alloc::Gpa;\npub use crate::borrow::ToOwnedIn;\npub use crate::boxed::Box;\npub use crate::clone::Clone;\npub use crate::cmp::{Eq, Ord, PartialEq, PartialOrd};\npub use crate::convert::{AsMut, AsRef, From, Into, TryFrom, TryInto};\npub use crate::default::{Default, DefaultIn};\npub use crate::fmt::{eprint, eprintln, format_in, print, println};\npub use crate::iter::{\n");
    buf_str(out, c"    DoubleEndedIterator, ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator,\n};\npub use crate::marker::Copy;\npub use crate::mem::drop;\npub use crate::ops::Drop;\npub use crate::option::Option;\npub use crate::option::Option::{None, Some};\npub use crate::panic::{\n    assert, assert_eq, assert_ne, debug_assert, panic, todo, unimplemented, unreachable,\n};\npub use crate::result::Result;\npub use crate::result::Result::{Err, Ok};\npub use crate::string::{String, ToStringIn};\npub use crate::vec::Vec;\n// ---- end mod std::prelude ----\n}\n// ---- mod std::marker ----\npub mod marker {\n// EDITION: rust\n// std::marker: Copy and PhantomData. Send, Sync, Sized, Freeze and\n// AllocFree (\"holds no allocator\", plan §2.0 rule 1: what a static's type\n// must be) are the compiler's structural markers: they are not declared\n// here, they need no `use`, and as bounds (`T: Send`) they wait for\n// `edition.later: auto_trait`. MVS's `Freeze` and `AllocFree`, traits\n// with a sealed method, are gone into them (gone.tsv).\n\nuse crate::clone::Clone;\n\n// A type whose values are copied by a move: its bits are the value, and\n// the source stays usable. Every part must be Copy, and Clone must agree\n// (`#[derive(Clone, Copy)]`). Integers, floats, bool, char, `&T`, raw\n// pointers and Gpa are Copy; `&mut T` and anything with a Drop are not.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Copy: Clone {}\n\n// A zero-sized field that makes a type act as if it held a T: for a\n// type's variance and drop check (`PhantomData<&'a T>` ties a raw\n// pointer's struct to 'a; plan §4). Built in: it has no field, and\n// `PhantomData` is its one value.\npub struct PhantomData<T: ?Sized>;\n// ---- end mod std::marker ----\n}\n// ---- mod std::ops ----\npub mod ops {\n// EDITION: rust\n// std::ops: the operator traits, Deref and DerefMut, Index and IndexMut,\n");
    buf_str(out, c"// Drop, and the ranges (`a..b` and the rest; MVS had Range and\n// RangeInclusive in std::iter). Fn, FnMut and FnOnce are the compiler's.\n// The arithmetic on numbers is built in; the traits are for other types\n// (a vector, a matrix, a String's `+`).\n\nuse crate::cmp::PartialOrd;\n\n// `*x`, and method calls through it: `v.len()` on a Box<Vec<T, A>, A>\n// finds Vec's method, `s.trim()` on a String finds str's (autoderef).\npub trait Deref {\n    type Target: ?Sized;\n\n    fn deref(&self) -> &Self::Target;\n}\n\n// `*x = v` and `&mut *x`, and `&mut self` methods through autoderef.\npub trait DerefMut: Deref {\n    fn deref_mut(&mut self) -> &mut Self::Target;\n}\n\n// `c[i]` as a place that is read: `*c.index(i)`. Vec, slices and arrays\n// are indexed by the compiler (by usize and by ranges); a user type\n// implements Index. Out of bounds panics, as `c.index` says.\npub trait Index<Idx: ?Sized> {\n    type Output: ?Sized;\n\n    fn index(&self, index: Idx) -> &Self::Output;\n}\n\n// `c[i] = v` and `&mut c[i]`.\npub trait IndexMut<Idx: ?Sized>: Index<Idx> {\n    fn index_mut(&mut self, index: Idx) -> &mut Self::Output;\n}\n\n// What runs when a value goes out of scope (not on a panic: decision 18).\n// `drop` cannot be called by hand: `std::mem::drop(x)` ends x early.\npub trait Drop {\n    fn drop(&mut self);\n}\n\n// `a + b`. MVS's Add (`fn add(self, other: Self) -> Self`) becomes\n// Rust's, with a right-hand type and an Output (so `String + &str`).\n// std2: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Add<Rhs = Self> {\n    type Output;\n\n    fn add(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a - b`.\n// std2: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Sub<Rhs = Self> {\n    type Output;\n\n    fn sub(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a * b`.\n");
    buf_str(out, c"// std2: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Mul<Rhs = Self> {\n    type Output;\n\n    fn mul(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a / b`.\n// std2: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Div<Rhs = Self> {\n    type Output;\n\n    fn div(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a % b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Rem<Rhs = Self> {\n    type Output;\n\n    fn rem(self, rhs: Rhs) -> Self::Output;\n}\n\n// `-a`.\n// std2: changed: Rust's shape, an Output\n#[builtin_impls(i8, i16, i32, i64, isize, f32, f64)]\npub trait Neg {\n    type Output;\n\n    fn neg(self) -> Self::Output;\n}\n\n// `!a`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Not {\n    type Output;\n\n    fn not(self) -> Self::Output;\n}\n\n// `a & b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitAnd<Rhs = Self> {\n    type Output;\n\n    fn bitand(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a | b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitOr<Rhs = Self> {\n    type Output;\n\n    fn bitor(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a ^ b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitXor<Rhs = Self> {\n    type Output;\n\n    fn bitxor(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a << b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Shl<Rhs = Self> {\n    type Output;\n\n    fn shl(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a >> b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Shr<Rhs = Self> {\n    type Output;\n\n    fn shr(self, rhs: Rhs) -> Self::Output;\n}\n\n");
    buf_str(out, c"// `a += b` (String's `s += \"x\"` grows s from its own allocator).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait AddAssign<Rhs = Self> {\n    fn add_assign(&mut self, rhs: Rhs);\n}\n\n// `a -= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait SubAssign<Rhs = Self> {\n    fn sub_assign(&mut self, rhs: Rhs);\n}\n\n// `a *= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait MulAssign<Rhs = Self> {\n    fn mul_assign(&mut self, rhs: Rhs);\n}\n\n// `a /= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait DivAssign<Rhs = Self> {\n    fn div_assign(&mut self, rhs: Rhs);\n}\n\n// `a %= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait RemAssign<Rhs = Self> {\n    fn rem_assign(&mut self, rhs: Rhs);\n}\n\n// `a &= b`, `a |= b`, `a ^= b`, `a <<= b`, `a >>= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitAndAssign<Rhs = Self> {\n    fn bitand_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitOrAssign<Rhs = Self> {\n    fn bitor_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitXorAssign<Rhs = Self> {\n    fn bitxor_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait ShlAssign<Rhs = Self> {\n    fn shl_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait ShrAssign<Rhs = Self> {\n    fn shr_assign(&mut self, rhs: Rhs);\n}\n\n// ---- Ranges ----\n\n// `start..end`: start included, end not. An iterator over integers and\n// chars (std::iter's Step); a slice index (`&v[1..3]`).\n#[derive(Clone, PartialEq, Eq, Hash, Debug)]\npub struct Range<Idx> {\n");
    buf_str(out, c"    pub start: Idx,\n    pub end: Idx,\n}\n\nimpl<Idx: PartialOrd<Idx>> Range<Idx> {\n    // Whether start <= item < end.\n    pub fn contains<U>(&self, item: &U) -> bool\n        where\n            Idx: PartialOrd<U>,\n            U: ?Sized + PartialOrd<Idx>,\n    {\n        *item >= self.start && *item < self.end\n    }\n\n    // Whether it holds nothing: !(start < end).\n    pub fn is_empty(&self) -> bool {\n        !(self.start < self.end)\n    }\n}\n\n// `start..=end`: both ends included. Its fields are private, as Rust's: it\n// remembers whether it is exhausted, so that `0..=u8::MAX` ends.\n#[derive(Clone, PartialEq, Eq, Hash, Debug)]\npub struct RangeInclusive<Idx> {\n    start: Idx,\n    end: Idx,\n    exhausted: bool,\n}\n\nimpl<Idx> RangeInclusive<Idx> {\n    // `start..=end`.\n    pub fn new(start: Idx, end: Idx) -> RangeInclusive<Idx> {\n        RangeInclusive { start: start, end: end, exhausted: false }\n    }\n\n    pub fn start(&self) -> &Idx {\n        &self.start\n    }\n\n    pub fn end(&self) -> &Idx {\n        &self.end\n    }\n\n    // (start, end).\n    pub fn into_inner(self) -> (Idx, Idx) {\n        (self.start, self.end)\n    }\n}\n\nimpl<Idx: PartialOrd<Idx>> RangeInclusive<Idx> {\n    // Whether start <= item <= end.\n    pub fn contains<U>(&self, item: &U) -> bool\n        where\n            Idx: PartialOrd<U>,\n            U: ?Sized + PartialOrd<Idx>,\n    {\n        *item >= self.start && *item <= self.end\n    }\n\n    // Whether it holds nothing: exhausted, or end < start.\n    pub fn is_empty(&self) -> bool {\n        self.exhausted || !(self.start <= self.end)\n    }\n}\n\n// `start..`: from start on (a slice's tail, `&s[3..]`).\n#[derive(Clone, PartialEq, Eq, Hash, Debug)]\npub struct RangeFrom<Idx> {\n    pub start: Idx,\n}\n\n// `..end`: up to end, not included.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub struct RangeTo<Idx> {\n    pub end: Idx,\n}\n\n// `..=end`: up to end, included.\n");
    buf_str(out, c"#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub struct RangeToInclusive<Idx> {\n    pub end: Idx,\n}\n\n// `..`: everything (`&v[..]`).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub struct RangeFull;\n\n// One end of a range, as RangeBounds gives it.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum Bound<T> {\n    Included(T),\n    Excluded(T),\n    Unbounded,\n}\n\n// Any range, for what takes one (`v.drain(1..)`, `s.replace_range(..3, \"x\")`).\npub trait RangeBounds<T: ?Sized> {\n    fn start_bound(&self) -> Bound<&T>;\n    fn end_bound(&self) -> Bound<&T>;\n\n    // Whether item is in the range.\n    fn contains<U>(&self, item: &U) -> bool\n        where\n            T: PartialOrd<U>,\n            U: ?Sized + PartialOrd<T>,\n    {\n        (match self.start_bound() {\n            Bound::Included(s) => *s <= *item,\n            Bound::Excluded(s) => *s < *item,\n            Bound::Unbounded => true,\n        }) && (match self.end_bound() {\n            Bound::Included(e) => *item <= *e,\n            Bound::Excluded(e) => *item < *e,\n            Bound::Unbounded => true,\n        })\n    }\n}\n\nimpl<T> RangeBounds<T> for Range<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.start)\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Excluded(&self.end)\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeInclusive<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.start)\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        if self.exhausted { Bound::Excluded(&self.end) } else { Bound::Included(&self.end) }\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeFrom<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.start)\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeTo<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n\n");
    buf_str(out, c"    fn end_bound(&self) -> Bound<&T> {\n        Bound::Excluded(&self.end)\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeToInclusive<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.end)\n    }\n}\n\nimpl<T: ?Sized> RangeBounds<T> for RangeFull {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n}\n// ---- end mod std::ops ----\n}\n// ---- mod std::cmp ----\npub mod cmp {\n// EDITION: rust\n// std::cmp: PartialEq, Eq, PartialOrd, Ord and Ordering, Rust's shape.\n// MVS's Eq (`eq(self, other: Self)`) and Ord (`cmp` returning an i64: <0,\n// 0, >0) are gone into them: `==` is PartialEq::eq on two references, `<`\n// is PartialOrd's, and floats are PartialOrd but not Ord (NaN). The\n// numbers', bool's, char's and pointers' impls are built in; derive makes\n// the others (`#[derive(PartialEq, Eq, PartialOrd, Ord)]`, field by field).\n\nuse crate::option::Option;\n\n// `==` and `!=`. Not necessarily an equivalence (f64's NaN != NaN).\n// mvs: Eq\n// std2: changed: Rust's PartialEq, over references, with a right-hand type\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait PartialEq<Rhs: ?Sized = Self> {\n    // mvs: Eq::eq\n    // std2: changed: takes &self and &Rhs\n    fn eq(&self, other: &Rhs) -> bool;\n\n    fn ne(&self, other: &Rhs) -> bool {\n        !self.eq(other)\n    }\n}\n\n// PartialEq that is an equivalence: every value equals itself. HashMap's\n// keys need it.\n// std2: changed: a marker over PartialEq (MVS's Eq had the method)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Eq: PartialEq<Self> {}\n\n// The result of a comparison.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]\npub enum Ordering {\n    Less,\n    Equal,\n    Greater,\n}\n\n");
    buf_str(out, c"impl Ordering {\n    pub fn is_eq(self) -> bool {\n        match self {\n            Ordering::Equal => true,\n            _ => false,\n        }\n    }\n\n    pub fn is_ne(self) -> bool {\n        !self.is_eq()\n    }\n\n    pub fn is_lt(self) -> bool {\n        match self {\n            Ordering::Less => true,\n            _ => false,\n        }\n    }\n\n    pub fn is_gt(self) -> bool {\n        match self {\n            Ordering::Greater => true,\n            _ => false,\n        }\n    }\n\n    pub fn is_le(self) -> bool {\n        !self.is_gt()\n    }\n\n    pub fn is_ge(self) -> bool {\n        !self.is_lt()\n    }\n\n    // Less for Greater and the other way round (`b.cmp(a)` from `a.cmp(b)`).\n    pub fn reverse(self) -> Ordering {\n        match self {\n            Ordering::Less => Ordering::Greater,\n            Ordering::Equal => Ordering::Equal,\n            Ordering::Greater => Ordering::Less,\n        }\n    }\n\n    // self, or other when self is Equal: comparing by several keys,\n    // `a.x.cmp(&b.x).then(a.y.cmp(&b.y))`.\n    pub fn then(self, other: Ordering) -> Ordering {\n        match self {\n            Ordering::Equal => other,\n            _ => self,\n        }\n    }\n\n    // `then`, with the second comparison made only when needed.\n    pub fn then_with<F: FnOnce() -> Ordering>(self, f: F) -> Ordering {\n        match self {\n            Ordering::Equal => f(),\n            _ => self,\n        }\n    }\n}\n\n// `<`, `<=`, `>` and `>=`; None when the two are not comparable (NaN).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait PartialOrd<Rhs: ?Sized = Self>: PartialEq<Rhs> {\n    fn partial_cmp(&self, other: &Rhs) -> Option<Ordering>;\n\n    fn lt(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) => true,\n            _ => false,\n        }\n    }\n\n    fn le(&self, other: &Rhs) -> bool {\n");
    buf_str(out, c"        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    fn gt(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) => true,\n            _ => false,\n        }\n    }\n\n    fn ge(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n}\n\n// A total order: what sorting, BinaryHeap and BTreeMap need.\n// std2: changed: Rust's Ord, cmp returns an Ordering (MVS: an i64)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Ord: Eq + PartialOrd<Self> {\n    // std2: changed: takes &self and &Self, returns an Ordering\n    fn cmp(&self, other: &Self) -> Ordering;\n\n    fn max(self, other: Self) -> Self\n        where\n            Self: Sized,\n    {\n        if other.cmp(&self).is_lt() { self } else { other }\n    }\n\n    fn min(self, other: Self) -> Self\n        where\n            Self: Sized,\n    {\n        if other.cmp(&self).is_lt() { other } else { self }\n    }\n\n    // self within [min, max]; panics when min > max.\n    // mvs: clamp\n    // std2: changed: a method of Ord (MVS: the free function std::clamp)\n    fn clamp(self, min: Self, max: Self) -> Self\n        where\n            Self: Sized,\n    {\n        if min.cmp(&max).is_gt() {\n            crate::panic::panic(\"clamp: min > max\");\n        }\n        if self.cmp(&min).is_lt() {\n            min\n        } else if self.cmp(&max).is_gt() {\n            max\n        } else {\n            self\n        }\n    }\n}\n\n// The smaller of two; a when they are equal.\npub fn min<T: Ord>(a: T, b: T) -> T {\n    a.min(b)\n}\n\n// The larger of two; b when they are equal.\npub fn max<T: Ord>(a: T, b: T) -> T {\n    a.max(b)\n}\n\n");
    buf_str(out, c"// The smaller by a key (`min_by_key(a, b, |p| p.len())`).\npub fn min_by_key<T, K: Ord, F: FnMut(&T) -> K>(a: T, b: T, f: F) -> T {\n    let mut f = f;\n    if f(&b).cmp(&f(&a)).is_lt() { b } else { a }\n}\n\n// The larger by a key.\npub fn max_by_key<T, K: Ord, F: FnMut(&T) -> K>(a: T, b: T, f: F) -> T {\n    let mut f = f;\n    if f(&b).cmp(&f(&a)).is_lt() { a } else { b }\n}\n\n// T's order turned round: `v.sort_by_key(|x| Reverse(x.score))`.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug, Default)]\npub struct Reverse<T>(pub T);\n\nimpl<T: PartialOrd> PartialOrd for Reverse<T> {\n    fn partial_cmp(&self, other: &Reverse<T>) -> Option<Ordering> {\n        other.0.partial_cmp(&self.0)\n    }\n}\n\nimpl<T: Ord> Ord for Reverse<T> {\n    fn cmp(&self, other: &Reverse<T>) -> Ordering {\n        other.0.cmp(&self.0)\n    }\n}\n// ---- end mod std::cmp ----\n}\n// ---- mod std::clone ----\npub mod clone {\n// EDITION: rust\n// std::clone: Clone. A container's clone reuses its stored allocator,\n// which its type shows (`&Vec<T, Gpa>` may allocate from Gpa through\n// clone; plan §2.0), so `#[derive(Clone)]` on a type generic over A needs\n// `A: Clone`; `clone_in(a)`, inherent on each container, moves the copy\n// to another allocator.\n\n// A copy of the value that owns what it holds (a Vec's elements, cloned).\n// std2: changed: takes &self\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Clone: Sized {\n    // std2: changed: takes &self (MVS: a let self)\n    fn clone(&self) -> Self;\n\n    // `*self = source.clone()`, reusing self's storage where it can.\n    fn clone_from(&mut self, source: &Self) {\n        *self = source.clone();\n    }\n}\n// ---- end mod std::clone ----\n}\n// ---- mod std::default ----\npub mod default {\n// EDITION: rust\n// std::default: Default, for types that hold no allocator, and\n// DefaultIn<A>, for the ones that do (plan §3). Vec, String and HashMap\n");
    buf_str(out, c"// are never Default (there is no ambient allocator); a blanket impl makes\n// every Default type DefaultIn<A> for any A, which is coherent under\n// Rust's rules exactly because the containers have no Default impl\n// (checked with rustc 1.98). So `map.entry(k).or_default()` makes a 0, a\n// None or an empty Vec on a clone of the map's allocator alike.\n\nuse crate::alloc::Allocator;\n\n// A type's natural empty or zero value: 0, false, None, \"\", (), an empty\n// struct of Defaults (`#[derive(Default)]`).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Default: Sized {\n    fn default() -> Self;\n}\n\n// A type's empty value, made with an allocator: `Vec::new_in(a)`,\n// `String::new_in(a)`, or Default's for a type that holds none\n// (`#[derive(DefaultIn)]` for a struct of DefaultIn fields).\npub trait DefaultIn<A>: Sized {\n    fn default_in(a: A) -> Self;\n}\n\n// later: blanket_impl\nimpl<T: Default, A> DefaultIn<A> for T {\n    fn default_in(a: A) -> T {\n        T::default()\n    }\n}\n// ---- end mod std::default ----\n}\n// ---- mod std::convert ----\npub mod convert {\n// EDITION: rust\n// std::convert: From, Into, TryFrom, TryInto, AsRef, AsMut, Infallible.\n// `?` converts an error through From only (plan §3). A conversion that\n// allocates is not From: `String::from_in(s, a)`, not `String::from(s)`.\n\nuse crate::result::Result;\n\n// A conversion that cannot fail: `i64::from(3u8)`, `Some(x)` from x.\npub trait From<T>: Sized {\n    fn from(value: T) -> Self;\n}\n\n// From's other side: `let n: i64 = b.into();`. Implement From, not Into.\npub trait Into<T>: Sized {\n    fn into(self) -> T;\n}\n\n// later: blanket_impl\nimpl<T, U: From<T>> Into<U> for T {\n    fn into(self) -> U {\n        U::from(self)\n    }\n}\n\n// A conversion that may fail: `u8::try_from(300i64)` is an Err.\npub trait TryFrom<T>: Sized {\n    type Error;\n\n    fn try_from(value: T) -> Result<Self, Self::Error>;\n}\n\n");
    buf_str(out, c"// TryFrom's other side.\npub trait TryInto<T>: Sized {\n    type Error;\n\n    fn try_into(self) -> Result<T, Self::Error>;\n}\n\n// later: blanket_impl\nimpl<T, U: TryFrom<T>> TryInto<U> for T {\n    type Error = U::Error;\n\n    fn try_into(self) -> Result<U, U::Error> {\n        U::try_from(self)\n    }\n}\n\n// A cheap view as &T: `fn open<P: AsRef<str>>(p: P)` takes a &str, a\n// String<A> or a &String<A>.\npub trait AsRef<T: ?Sized> {\n    fn as_ref(&self) -> &T;\n}\n\n// A cheap view as &mut T.\npub trait AsMut<T: ?Sized> {\n    fn as_mut(&mut self) -> &mut T;\n}\n\n// The error of a conversion that cannot fail: it has no value.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Infallible {}\n\n// The error of a narrowing integer conversion (`u8::try_from(300)`).\n// MVS's TryFromIntError, kept.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct TryFromIntError(());\n// ---- end mod std::convert ----\n}\n// ---- mod std::borrow ----\npub mod borrow {\n// EDITION: rust\n// std::borrow: Borrow, BorrowMut and ToOwnedIn<A>. Borrow is what lets a\n// HashMap<String<A>, V, A> be looked up by a &str: `String<A>:\n// Borrow<str>`, with the same Hash and Eq (Hash must not depend on A).\n// Cow<'a, B, A> waits for 0.29 (plan §3; it needs ToOwnedIn's Owned to\n// carry A through a type).\n\nuse crate::alloc::Allocator;\n\n// A view of self as a &Borrowed that hashes and compares as self does.\npub trait Borrow<Borrowed: ?Sized> {\n    fn borrow(&self) -> &Borrowed;\n}\n\n// The same, mutable.\npub trait BorrowMut<Borrowed: ?Sized>: Borrow<Borrowed> {\n    fn borrow_mut(&mut self) -> &mut Borrowed;\n}\n\n// Every T is a view of itself (a HashMap<i64, V, A> looked up by &i64).\n// later: blanket_impl\nimpl<T: ?Sized> Borrow<T> for T {\n    fn borrow(&self) -> &T {\n        self\n    }\n}\n\n// later: blanket_impl\nimpl<T: ?Sized> BorrowMut<T> for T {\n    fn borrow_mut(&mut self) -> &mut T {\n        self\n    }\n}\n\n");
    buf_str(out, c"// Rust's ToOwned, with the allocator named: an owned copy of a view, on a.\n// `\"x\".to_owned_in(gpa)` is a String<Gpa>, `[1, 2][..].to_owned_in(gpa)` a\n// Vec<i64, Gpa>; a Clone type's owned form is a clone (a's unused).\npub trait ToOwnedIn<A: Allocator> {\n    type Owned;\n\n    fn to_owned_in(&self, a: A) -> Self::Owned;\n}\n// ---- end mod std::borrow ----\n}\n// ---- mod std::mem ----\npub mod mem {\n// EDITION: rust\n// std::mem: moving values in and out of places, and the sizes of types.\n// size_of, align_of and needs_drop are evaluated by the compiler; the\n// others are plain functions over `&mut T`.\n\nuse crate::default::Default;\n\n// Exchanges the values of two places (MVS: two inout parameters).\n// std2: changed: takes &mut T twice\npub fn swap<T>(a: &mut T, b: &mut T) {\n    crate::panic::todo()\n}\n\n// Moves src into dest and returns dest's old value.\n// std2: changed: takes &mut T\npub fn replace<T>(dest: &mut T, src: T) -> T {\n    crate::panic::todo()\n}\n\n// Moves dest's value out, leaving its Default (`take(&mut v)` on an\n// allocator-free type; a Vec has no Default, and Vec::take, inherent,\n// leaves an empty Vec on a clone of its allocator).\n// std2: changed: takes &mut T\npub fn take<T: Default>(dest: &mut T) -> T {\n    replace(dest, T::default())\n}\n\n// Ends x's life here: its Drop runs now, not at the end of its scope.\npub fn drop<T>(x: T) {}\n\n// Ends x's life without running its Drop: what it owns is leaked (unless\n// something else frees it). Safe, as in Rust: a leak is not undefined.\npub fn forget<T>(x: T) {\n    crate::panic::todo()\n}\n\n// The size of a T in bytes, padding included (built in).\npub fn size_of<T>() -> usize {\n    crate::panic::todo()\n}\n\n// The alignment of a T in bytes (built in).\npub fn align_of<T>() -> usize {\n    crate::panic::todo()\n}\n\n// The size of the value x refers to (for str and [T], from its length).\npub fn size_of_val<T: ?Sized>(x: &T) -> usize {\n    crate::panic::todo()\n}\n\n");
    buf_str(out, c"// Whether dropping a T runs code: a Drop impl, or a part with one. For a\n// container on an allocator that does not free (Allocator::FREES false:\n// an arena, a FixedBuf), only its elements count (plan §9.1): an arena's\n// `alloc(x)` takes a T for which this is false (built in).\npub fn needs_drop<T: ?Sized>() -> bool {\n    crate::panic::todo()\n}\n// ---- end mod std::mem ----\n}\n// ---- mod std::ptr ----\npub mod ptr {\n// EDITION: rust\n// std::ptr: NonNull and the raw-pointer functions std's bodies use. A raw\n// pointer is `*const T` or `*mut T` (plan §5); reading or writing through\n// one is unsafe, and its SAFETY comment says why it is sound.\n\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\n\n// A *mut T that is never null: what a container keeps (Option<NonNull<T>>\n// is one word). Covariant in T, as Rust's.\n// mvs: NonNull\n// std2: changed: a struct over *const T (MVS: a distinct *T with an invariant)\npub struct NonNull<T: ?Sized> {\n    pointer: *const T,\n}\n\nimpl<T> NonNull<T> {\n    // p as a NonNull; None when it is null.\n    // std2: changed: takes *mut T\n    pub fn new(p: *mut T) -> Option<NonNull<T>> {\n        if p.is_null() { Option::None } else { Option::Some(NonNull { pointer: p as *const T }) }\n    }\n\n    // A pointer that is not null and is aligned, for a zero-sized T or an\n    // empty container: it is never read.\n    pub fn dangling() -> NonNull<T> {\n        crate::panic::todo()\n    }\n\n    // The pointer.\n    // std2: changed: returns *mut T\n    pub fn as_ptr(self) -> *mut T {\n        self.pointer as *mut T\n    }\n\n    // The value it points at, as a reference. The caller says the pointer\n    // is valid and aligned, the value initialized, and nothing writes it\n    // for 'a.\n    // UNSAFE: the caller vouches for the pointer's target and its lifetime.\n    // SAFETY: a contract on the caller, as Rust's NonNull::as_ref.\n");
    buf_str(out, c"    pub unsafe fn as_ref<'a>(&self) -> &'a T {\n        crate::panic::todo()\n    }\n\n    // The same, mutable: nothing else reads or writes it for 'a.\n    // UNSAFE: the caller vouches for the pointer's target and its lifetime.\n    // SAFETY: a contract on the caller, as Rust's NonNull::as_mut.\n    pub unsafe fn as_mut<'a>(&mut self) -> &'a mut T {\n        crate::panic::todo()\n    }\n\n    // A pointer to a U at the same address.\n    pub fn cast<U>(self) -> NonNull<U> {\n        NonNull { pointer: self.pointer as *const U }\n    }\n\n    // The pointer count elements on (inside one allocation).\n    // UNSAFE: an offset out of the allocation is undefined.\n    // SAFETY: a contract on the caller, as Rust's NonNull::add.\n    pub unsafe fn add(self, count: usize) -> NonNull<T> {\n        crate::panic::todo()\n    }\n}\n\nimpl<T: ?Sized> Clone for NonNull<T> {\n    fn clone(&self) -> NonNull<T> {\n        *self\n    }\n}\n\nimpl<T: ?Sized> Copy for NonNull<T> {}\n\nimpl<T: ?Sized> PartialEq for NonNull<T> {\n    fn eq(&self, other: &NonNull<T>) -> bool {\n        self.pointer == other.pointer\n    }\n}\n\nimpl<T: ?Sized> Eq for NonNull<T> {}\n\n// A null *const T.\npub fn null<T>() -> *const T {\n    0 as *const T\n}\n\n// A null *mut T.\npub fn null_mut<T>() -> *mut T {\n    0 as *mut T\n}\n\n// The T at src, moved out bit for bit (src is left as it was: the caller\n// makes sure only one of the two is dropped).\n// UNSAFE: reads through a raw pointer.\n// SAFETY: a contract on the caller: src valid, aligned, initialized.\npub unsafe fn read<T>(src: *const T) -> T {\n    crate::panic::todo()\n}\n\n// Moves value into dst without dropping what was there.\n// UNSAFE: writes through a raw pointer.\n// SAFETY: a contract on the caller: dst valid and aligned.\npub unsafe fn write<T>(dst: *mut T, value: T) {\n    crate::panic::todo()\n}\n\n// count T's from src to dst; the two may overlap (memmove).\n// UNSAFE: reads and writes through raw pointers.\n");
    buf_str(out, c"// SAFETY: a contract on the caller: both ranges valid and aligned.\npub unsafe fn copy<T>(src: *const T, dst: *mut T, count: usize) {\n    crate::panic::todo()\n}\n\n// count T's from src to dst, which do not overlap (memcpy).\n// UNSAFE: reads and writes through raw pointers.\n// SAFETY: a contract on the caller: both ranges valid, aligned, disjoint.\npub unsafe fn copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {\n    crate::panic::todo()\n}\n\n// Runs the drop of the value at p, in place.\n// UNSAFE: drops through a raw pointer.\n// SAFETY: a contract on the caller: p valid, its value initialized and\n// not used again.\npub unsafe fn drop_in_place<T: ?Sized>(p: *mut T) {\n    crate::panic::todo()\n}\n\n// Whether two pointers have the same address.\npub fn eq<T: ?Sized>(a: *const T, b: *const T) -> bool {\n    a == b\n}\n// ---- end mod std::ptr ----\n}\n// ---- mod std::cell ----\npub mod cell {\n// EDITION: rust\n// std::cell: Cell and UnsafeCell, Rust's API. A Cell is written through a\n// shared reference (`&self`): it is how an Arena bumps its pointer behind\n// the `&'a Arena<P>` every container holds (plan §2.1). Neither is Sync.\n// RefCell and its guards wait for 0.29 (plan §6, the cuts).\n\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::option::Option;\n\n// The one way to write through a & in safe code's types: what Cell, the\n// allocators' counters and Atomic are made of. `get` gives a raw pointer;\n// writing through it while a & to the value is live is undefined.\n#[repr(transparent)]\npub struct UnsafeCell<T: ?Sized> {\n    value: T,\n}\n\nimpl<T> UnsafeCell<T> {\n    pub fn new(value: T) -> UnsafeCell<T> {\n        UnsafeCell { value: value }\n    }\n\n    pub fn into_inner(self) -> T {\n        self.value\n    }\n}\n\nimpl<T: ?Sized> UnsafeCell<T> {\n    // A pointer to the value, writable through a &self.\n");
    buf_str(out, c"    // std2: changed: returns *mut T\n    pub fn get(&self) -> *mut T {\n        crate::panic::todo()\n    }\n\n    // The value, through an exclusive borrow: no unsafe needed.\n    pub fn get_mut(&mut self) -> &mut T {\n        &mut self.value\n    }\n}\n\n// A value set and read through a &: by copy (`get`, T: Copy) or by moving\n// it in and out (`set`, `replace`, `take`); never a reference into it.\n#[repr(transparent)]\npub struct Cell<T: ?Sized> {\n    value: UnsafeCell<T>,\n}\n\nimpl<T> Cell<T> {\n    pub fn new(value: T) -> Cell<T> {\n        Cell { value: UnsafeCell::new(value) }\n    }\n\n    // Stores v (the old value is dropped).\n    pub fn set(&self, v: T) {\n        drop(self.replace(v));\n    }\n\n    // Exchanges the values of two cells.\n    // std2: changed: takes &Cell<T>\n    pub fn swap(&self, other: &Cell<T>) {\n        crate::panic::todo()\n    }\n\n    // Stores v and returns the old value.\n    pub fn replace(&self, v: T) -> T {\n        crate::panic::todo()\n    }\n\n    pub fn into_inner(self) -> T {\n        self.value.into_inner()\n    }\n}\n\nimpl<T: Copy> Cell<T> {\n    // A copy of the value.\n    pub fn get(&self) -> T {\n        crate::panic::todo()\n    }\n\n    // Stores f(old value) (`c.update(|n| n + 1)`).\n    // std2: changed: FnOnce, returns nothing (Rust 1.88)\n    pub fn update<F: FnOnce(T) -> T>(&self, f: F) {\n        self.set(f(self.get()));\n    }\n}\n\nimpl<T: ?Sized> Cell<T> {\n    // A pointer to the value.\n    // std2: changed: returns *mut T\n    pub fn as_ptr(&self) -> *mut T {\n        self.value.get()\n    }\n\n    // The value, through an exclusive borrow.\n    pub fn get_mut(&mut self) -> &mut T {\n        self.value.get_mut()\n    }\n}\n\nimpl<T: Default> Cell<T> {\n    // Moves the value out, leaving its Default.\n    pub fn take(&self) -> T {\n        self.replace(T::default())\n    }\n}\n\nimpl<T: Copy> Clone for Cell<T> {\n    fn clone(&self) -> Cell<T> {\n        Cell::new(self.get())\n    }\n}\n\n");
    buf_str(out, c"impl<T: Default> Default for Cell<T> {\n    fn default() -> Cell<T> {\n        Cell::new(T::default())\n    }\n}\n\nimpl<T: PartialEq + Copy> PartialEq for Cell<T> {\n    fn eq(&self, other: &Cell<T>) -> bool {\n        self.get() == other.get()\n    }\n}\n\nimpl<T: Eq + Copy> Eq for Cell<T> {}\n\nimpl<T: PartialOrd + Copy> PartialOrd for Cell<T> {\n    fn partial_cmp(&self, other: &Cell<T>) -> Option<Ordering> {\n        self.get().partial_cmp(&other.get())\n    }\n}\n\nimpl<T: Ord + Copy> Ord for Cell<T> {\n    fn cmp(&self, other: &Cell<T>) -> Ordering {\n        self.get().cmp(&other.get())\n    }\n}\n\nimpl<T: Debug + Copy> Debug for Cell<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Cell\").field(\"value\", &self.get()).finish()\n    }\n}\n\nimpl<T> From<T> for Cell<T> {\n    fn from(value: T) -> Cell<T> {\n        Cell::new(value)\n    }\n}\n// ---- end mod std::cell ----\n}\n// ---- mod std::panic ----\npub mod panic {\n// EDITION: rust\n// std::panic: panic, assert and the other functions Rust spells as\n// macros (vole has none: plan §3). A panic formats its message into a\n// fixed buffer, truncating it, so it never allocates and is callable\n// from #[no_alloc] code; it then exits with 101, with no unwinding\n// (decisions 5 and 18). A message is a format literal (`panic(\"bad\n// {x}\")`): the compiler checks it and builds its Display value\n// (`edition.later: format_fns`); the default parameters are std's own.\n\nuse crate::cmp::PartialEq;\nuse crate::fmt::{Debug, Display};\n\n// UNSAFE: C's abort, the spec's way out until the compiler's panic path\n// (format_fns) writes the message and exits with 101.\n// SAFETY: abort takes nothing and does not return.\nextern \"C\" {\n    fn abort() -> !;\n}\n\n// Ends the program with msg on stderr, the caller's place and exit 101.\n// MVS's panic (a C string, unsafe) and panic_str are gone into it.\n// mvs: panic_str, panic\n// std2: renamed\n");
    buf_str(out, c"// later: format_fns\npub fn panic<M: Display>(msg: M) -> ! {\n    // UNSAFE: the extern call above.\n    // SAFETY: abort has no precondition.\n    unsafe { abort() }\n}\n\n// Panics when ok is false, with msg.\n// later: format_fns\npub fn assert(ok: bool, msg: &str = \"\") {\n    if !ok {\n        panic(msg);\n    }\n}\n\n// Panics when a != b, showing both.\n// std2: changed: by reference, Rust's assert_eq\n// later: format_fns\npub fn assert_eq<T: PartialEq + Debug + ?Sized>(a: &T, b: &T, msg: &str = \"\") {\n    crate::panic::todo()\n}\n\n// Panics when a == b, showing both.\n// std2: changed: by reference, Rust's assert_ne\n// later: format_fns\npub fn assert_ne<T: PartialEq + Debug + ?Sized>(a: &T, b: &T, msg: &str = \"\") {\n    crate::panic::todo()\n}\n\n// assert, only in debug builds (-O0, or with debug assertions).\n// later: format_fns\npub fn debug_assert(ok: bool, msg: &str = \"\") {\n    crate::panic::todo()\n}\n\n// Code that cannot be reached: panics if it is.\n// std2: changed: a format literal for its message\n// later: format_fns\npub fn unreachable(msg: &str = \"\") -> ! {\n    panic(msg)\n}\n\n// Code not written yet: panics with \"not yet implemented\". The spec\n// tree's bodies are this. Until format_fns the message is a &str: a\n// type parameter is not fixed by its default argument.\n// later: format_fns\npub fn todo(msg: &str = \"\") -> ! {\n    panic(\"not yet implemented\")\n}\n\n// Code that will not be written: panics with \"not implemented\".\n// later: format_fns\npub fn unimplemented(msg: &str = \"\") -> ! {\n    panic(\"not implemented\")\n}\n// ---- end mod std::panic ----\n}\n// ---- mod std::option ----\npub mod option {\n// EDITION: rust\n// std::option: Option<T>, Rust's API. `Some` and `None` are in the\n// prelude. What MVS's Option had is kept, with Rust's receivers; what\n// references make possible is new: `as_ref` and `as_mut` (an Option of a\n// reference into self), `take`, `insert` and `get_or_insert` (a &mut T\n");
    buf_str(out, c"// into self), and `copied` and `cloned` on an Option<&T>.\n\nuse crate::clone::Clone;\nuse crate::default::Default;\nuse crate::iter::{IntoIterator, Iterator};\nuse crate::ops::{Deref, DerefMut};\nuse crate::option::Option::{None, Some};\nuse crate::result::Result;\n\n// A value or nothing.\n// mvs: Option, Option::impl Clone, Option::impl Debug\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]\npub enum Option<T> {\n    None,\n    Some(T),\n}\n\nimpl<T> Option<T> {\n    pub fn is_some(&self) -> bool {\n        match self {\n            Some(_) => true,\n            None => false,\n        }\n    }\n\n    // Some and f(the value).\n    // std2: changed: FnOnce(T) -> bool (Rust's)\n    pub fn is_some_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {\n        match self {\n            Some(x) => f(x),\n            None => false,\n        }\n    }\n\n    pub fn is_none(&self) -> bool {\n        !self.is_some()\n    }\n\n    // None, or f(the value).\n    pub fn is_none_or<F: FnOnce(T) -> bool>(self, f: F) -> bool {\n        match self {\n            Some(x) => f(x),\n            None => true,\n        }\n    }\n\n    // An Option of a reference to the value: look without moving it out\n    // (`if let Some(n) = opt.as_ref()`).\n    pub fn as_ref(&self) -> Option<&T> {\n        match self {\n            Some(x) => Some(x),\n            None => None,\n        }\n    }\n\n    // An Option of a &mut to the value: change it in place.\n    pub fn as_mut(&mut self) -> Option<&mut T> {\n        match self {\n            Some(x) => Some(x),\n            None => None,\n        }\n    }\n\n    // The value; panics with msg when None.\n    // later: format_fns\n    pub fn expect(self, msg: &str) -> T {\n        match self {\n            Some(x) => x,\n            None => crate::panic::panic(msg),\n        }\n    }\n\n    // The value; panics when None.\n    pub fn unwrap(self) -> T {\n        match self {\n            Some(x) => x,\n");
    buf_str(out, c"            None => crate::panic::panic(\"called `Option::unwrap()` on a `None` value\"),\n        }\n    }\n\n    pub fn unwrap_or(self, default: T) -> T {\n        match self {\n            Some(x) => x,\n            None => default,\n        }\n    }\n\n    // std2: changed: FnOnce (MVS: Fn)\n    pub fn unwrap_or_else<F: FnOnce() -> T>(self, f: F) -> T {\n        match self {\n            Some(x) => x,\n            None => f(),\n        }\n    }\n\n    // The value, or T's Default.\n    pub fn unwrap_or_default(self) -> T\n        where\n            T: Default,\n    {\n        match self {\n            Some(x) => x,\n            None => T::default(),\n        }\n    }\n\n    // The value, with no check.\n    // UNSAFE: None here is undefined.\n    // SAFETY: a contract on the caller: self is Some.\n    pub unsafe fn unwrap_unchecked(self) -> T {\n        match self {\n            Some(x) => x,\n            None => crate::panic::todo(),\n        }\n    }\n\n    // std2: changed: FnOnce (MVS: Fn(sink T))\n    pub fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Option<U> {\n        match self {\n            Some(x) => Some(f(x)),\n            None => None,\n        }\n    }\n\n    // Calls f on a reference to the value, then gives self back.\n    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Option<T> {\n        if let Some(x) = &self {\n            f(x);\n        }\n        self\n    }\n\n    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {\n        match self {\n            Some(x) => f(x),\n            None => default,\n        }\n    }\n\n    pub fn map_or_else<U, D: FnOnce() -> U, F: FnOnce(T) -> U>(self, default: D, f: F) -> U {\n        match self {\n            Some(x) => f(x),\n            None => default(),\n        }\n    }\n\n    pub fn ok_or<E>(self, err: E) -> Result<T, E> {\n        match self {\n            Some(x) => Result::Ok(x),\n            None => Result::Err(err),\n        }\n    }\n\n");
    buf_str(out, c"    pub fn ok_or_else<E, F: FnOnce() -> E>(self, err: F) -> Result<T, E> {\n        match self {\n            Some(x) => Result::Ok(x),\n            None => Result::Err(err()),\n        }\n    }\n\n    // An Option of the Deref target (`Option<String<A>>` to `Option<&str>`).\n    pub fn as_deref(&self) -> Option<&T::Target>\n        where\n            T: Deref,\n    {\n        match self {\n            Some(x) => Some(x.deref()),\n            None => None,\n        }\n    }\n\n    pub fn as_deref_mut(&mut self) -> Option<&mut T::Target>\n        where\n            T: DerefMut,\n    {\n        match self {\n            Some(x) => Some(x.deref_mut()),\n            None => None,\n        }\n    }\n\n    // An iterator over the value: one item or none.\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { inner: self.as_ref() }\n    }\n\n    pub fn iter_mut(&mut self) -> IterMut<'_, T> {\n        IterMut { inner: self.as_mut() }\n    }\n\n    // None if self is None, else optb.\n    pub fn and<U>(self, optb: Option<U>) -> Option<U> {\n        match self {\n            Some(_) => optb,\n            None => None,\n        }\n    }\n\n    // std2: changed: FnOnce (MVS: Fn(sink T))\n    pub fn and_then<U, F: FnOnce(T) -> Option<U>>(self, f: F) -> Option<U> {\n        match self {\n            Some(x) => f(x),\n            None => None,\n        }\n    }\n\n    // Some only when predicate holds for the value.\n    pub fn filter<P: FnOnce(&T) -> bool>(self, predicate: P) -> Option<T> {\n        if let Some(x) = self {\n            if predicate(&x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n\n    pub fn or(self, optb: Option<T>) -> Option<T> {\n        match self {\n            Some(x) => Some(x),\n            None => optb,\n        }\n    }\n\n    pub fn or_else<F: FnOnce() -> Option<T>>(self, f: F) -> Option<T> {\n        match self {\n            Some(x) => Some(x),\n            None => f(),\n        }\n    }\n\n");
    buf_str(out, c"    // Some when exactly one of the two is.\n    pub fn xor(self, optb: Option<T>) -> Option<T> {\n        match (self, optb) {\n            (Some(a), None) => Some(a),\n            (None, Some(b)) => Some(b),\n            _ => None,\n        }\n    }\n\n    // Stores value and returns a &mut to it.\n    pub fn insert(&mut self, value: T) -> &mut T {\n        *self = Some(value);\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(),\n        }\n    }\n\n    // The value, after storing value if self was None.\n    pub fn get_or_insert(&mut self, value: T) -> &mut T {\n        if self.is_none() {\n            *self = Some(value);\n        }\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(),\n        }\n    }\n\n    pub fn get_or_insert_with<F: FnOnce() -> T>(&mut self, f: F) -> &mut T {\n        if self.is_none() {\n            *self = Some(f());\n        }\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(),\n        }\n    }\n\n    // Moves the value out, leaving None.\n    pub fn take(&mut self) -> Option<T> {\n        crate::mem::replace(self, None)\n    }\n\n    // take, when predicate holds for the value.\n    pub fn take_if<P: FnOnce(&mut T) -> bool>(&mut self, predicate: P) -> Option<T> {\n        let hit = match self.as_mut() {\n            Some(x) => predicate(x),\n            None => false,\n        };\n        if hit { self.take() } else { None }\n    }\n\n    // Stores value, returning the old one.\n    pub fn replace(&mut self, value: T) -> Option<T> {\n        crate::mem::replace(self, Some(value))\n    }\n\n    // Some((a, b)) when both are Some.\n    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {\n        match (self, other) {\n            (Some(a), Some(b)) => Some((a, b)),\n            _ => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T, U> Option<(T, U)> {\n");
    buf_str(out, c"    pub fn unzip(self) -> (Option<T>, Option<U>) {\n        match self {\n            Some((a, b)) => (Some(a), Some(b)),\n            None => (None, None),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Copy> Option<&T> {\n    // An Option of a copy of the value (`v.get(i).copied()`).\n    pub fn copied(self) -> Option<T> {\n        match self {\n            Some(&x) => Some(x),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Clone> Option<&T> {\n    pub fn cloned(self) -> Option<T> {\n        match self {\n            Some(x) => Some(x.clone()),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Copy> Option<&mut T> {\n    pub fn copied(self) -> Option<T> {\n        match self {\n            Some(&mut x) => Some(x),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Clone> Option<&mut T> {\n    pub fn cloned(self) -> Option<T> {\n        match self {\n            Some(x) => Some(x.clone()),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T, E> Option<Result<T, E>> {\n    // Some(Ok(x)) to Ok(Some(x)), and so on.\n    pub fn transpose(self) -> Result<Option<T>, E> {\n        match self {\n            Some(Result::Ok(x)) => Result::Ok(Some(x)),\n            Some(Result::Err(e)) => Result::Err(e),\n            None => Result::Ok(None),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T> Option<Option<T>> {\n    pub fn flatten(self) -> Option<T> {\n        match self {\n            Some(x) => x,\n            None => None,\n        }\n    }\n}\n\nimpl<T> Default for Option<T> {\n    fn default() -> Option<T> {\n        None\n    }\n}\n\nimpl<T> From<T> for Option<T> {\n    fn from(value: T) -> Option<T> {\n        Some(value)\n    }\n}\n\n// The iterator of a &Option<T>: its value, once.\npub struct Iter<'a, T> {\n    inner: Option<&'a T>,\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n");
    buf_str(out, c"    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        self.inner.take()\n    }\n}\n\n// The iterator of a &mut Option<T>.\npub struct IterMut<'a, T> {\n    inner: Option<&'a mut T>,\n}\n\nimpl<'a, T> Iterator for IterMut<'a, T> {\n    type Item = &'a mut T;\n\n    fn next(&mut self) -> Option<&'a mut T> {\n        self.inner.take()\n    }\n}\n\n// The iterator of an Option<T>, by value.\npub struct IntoIter<T> {\n    inner: Option<T>,\n}\n\nimpl<T> Iterator for IntoIter<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.take()\n    }\n}\n\nimpl<T> IntoIterator for Option<T> {\n    type Item = T;\n    type IntoIter = IntoIter<T>;\n\n    fn into_iter(self) -> IntoIter<T> {\n        IntoIter { inner: self }\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a Option<T> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a mut Option<T> {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n// ---- end mod std::option ----\n}\n// ---- mod std::result ----\npub mod result {\n// EDITION: rust\n// std::result: Result<T, E>, Rust's API. `Ok` and `Err` are in the\n// prelude; `?` returns the Err early, converted through From (plan §3).\n// One change from MVS beyond the receivers: `unwrap` needs `E: Debug`\n// and shows the error (into the panic's fixed buffer); an E that is not\n// Debug unwraps as `.ok().unwrap()` (the rewrite table says so).\n\nuse crate::clone::Clone;\nuse crate::default::Default;\nuse crate::fmt::Debug;\nuse crate::iter::IntoIterator;\nuse crate::ops::Deref;\nuse crate::option::Option;\nuse crate::result::Result::{Err, Ok};\n\n// A value or an error.\n// mvs: Result, Result::impl Clone, Result::impl Debug\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]\n");
    buf_str(out, c"pub enum Result<T, E> {\n    Ok(T),\n    Err(E),\n}\n\nimpl<T, E> Result<T, E> {\n    pub fn is_ok(&self) -> bool {\n        match self {\n            Ok(_) => true,\n            Err(_) => false,\n        }\n    }\n\n    pub fn is_ok_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {\n        match self {\n            Ok(x) => f(x),\n            Err(_) => false,\n        }\n    }\n\n    pub fn is_err(&self) -> bool {\n        !self.is_ok()\n    }\n\n    pub fn is_err_and<F: FnOnce(E) -> bool>(self, f: F) -> bool {\n        match self {\n            Ok(_) => false,\n            Err(e) => f(e),\n        }\n    }\n\n    // The value as Some, the error dropped.\n    pub fn ok(self) -> Option<T> {\n        match self {\n            Ok(x) => Option::Some(x),\n            Err(_) => Option::None,\n        }\n    }\n\n    pub fn err(self) -> Option<E> {\n        match self {\n            Ok(_) => Option::None,\n            Err(e) => Option::Some(e),\n        }\n    }\n\n    // A Result of references into self.\n    pub fn as_ref(&self) -> Result<&T, &E> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn as_mut(&mut self) -> Result<&mut T, &mut E> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn as_deref(&self) -> Result<&T::Target, &E>\n        where\n            T: Deref,\n    {\n        match self {\n            Ok(x) => Ok(x.deref()),\n            Err(e) => Err(e),\n        }\n    }\n\n    // std2: changed: FnOnce (MVS: Fn(sink T))\n    pub fn map<U, F: FnOnce(T) -> U>(self, op: F) -> Result<U, E> {\n        match self {\n            Ok(x) => Ok(op(x)),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {\n        match self {\n            Ok(x) => f(x),\n            Err(_) => default,\n        }\n    }\n\n");
    buf_str(out, c"    pub fn map_or_else<U, D: FnOnce(E) -> U, F: FnOnce(T) -> U>(self, default: D, f: F) -> U {\n        match self {\n            Ok(x) => f(x),\n            Err(e) => default(e),\n        }\n    }\n\n    // std2: changed: FnOnce (MVS: Fn(sink E))\n    pub fn map_err<F2, O: FnOnce(E) -> F2>(self, op: O) -> Result<T, F2> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(op(e)),\n        }\n    }\n\n    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Result<T, E> {\n        if let Ok(x) = &self {\n            f(x);\n        }\n        self\n    }\n\n    pub fn inspect_err<F: FnOnce(&E)>(self, f: F) -> Result<T, E> {\n        if let Err(e) = &self {\n            f(e);\n        }\n        self\n    }\n\n    // An iterator over the value: one item, or none for an Err.\n    pub fn iter(&self) -> crate::option::IntoIter<&T> {\n        self.as_ref().ok().into_iter()\n    }\n\n    // The value; panics with msg and the error when Err.\n    // later: format_fns\n    pub fn expect(self, msg: &str) -> T\n        where\n            E: Debug,\n    {\n        match self {\n            Ok(x) => x,\n            Err(e) => crate::panic::panic(\"{msg}: {e:?}\"),\n        }\n    }\n\n    // The value; panics with the error when Err.\n    // std2: changed: needs E: Debug and shows it\n    // later: format_fns\n    pub fn unwrap(self) -> T\n        where\n            E: Debug,\n    {\n        match self {\n            Ok(x) => x,\n            Err(e) => crate::panic::panic(\"called `Result::unwrap()` on an `Err` value: {e:?}\"),\n        }\n    }\n\n    pub fn unwrap_or_default(self) -> T\n        where\n            T: Default,\n    {\n        match self {\n            Ok(x) => x,\n            Err(_) => T::default(),\n        }\n    }\n\n    // later: format_fns\n    pub fn expect_err(self, msg: &str) -> E\n        where\n            T: Debug,\n    {\n        match self {\n            Ok(x) => crate::panic::panic(\"{msg}: {x:?}\"),\n            Err(e) => e,\n");
    buf_str(out, c"        }\n    }\n\n    // later: format_fns\n    pub fn unwrap_err(self) -> E\n        where\n            T: Debug,\n    {\n        match self {\n            Ok(x) => crate::panic::panic(\"called `Result::unwrap_err()` on an `Ok` value: {x:?}\"),\n            Err(e) => e,\n        }\n    }\n\n    pub fn and<U>(self, res: Result<U, E>) -> Result<U, E> {\n        match self {\n            Ok(_) => res,\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn and_then<U, F: FnOnce(T) -> Result<U, E>>(self, op: F) -> Result<U, E> {\n        match self {\n            Ok(x) => op(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn or<F2>(self, res: Result<T, F2>) -> Result<T, F2> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(_) => res,\n        }\n    }\n\n    pub fn or_else<F2, O: FnOnce(E) -> Result<T, F2>>(self, op: O) -> Result<T, F2> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => op(e),\n        }\n    }\n\n    pub fn unwrap_or(self, default: T) -> T {\n        match self {\n            Ok(x) => x,\n            Err(_) => default,\n        }\n    }\n\n    // std2: changed: FnOnce (MVS: Fn(sink E))\n    pub fn unwrap_or_else<F: FnOnce(E) -> T>(self, op: F) -> T {\n        match self {\n            Ok(x) => x,\n            Err(e) => op(e),\n        }\n    }\n\n    // UNSAFE: an Err here is undefined.\n    // SAFETY: a contract on the caller: self is Ok.\n    pub unsafe fn unwrap_unchecked(self) -> T {\n        match self {\n            Ok(x) => x,\n            Err(_) => crate::panic::todo(),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Copy, E> Result<&T, E> {\n    pub fn copied(self) -> Result<T, E> {\n        match self {\n            Ok(&x) => Ok(x),\n            Err(e) => Err(e),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Clone, E> Result<&T, E> {\n    pub fn cloned(self) -> Result<T, E> {\n        match self {\n            Ok(x) => Ok(x.clone()),\n");
    buf_str(out, c"            Err(e) => Err(e),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T, E> Result<Option<T>, E> {\n    // Ok(Some(x)) to Some(Ok(x)), and so on.\n    pub fn transpose(self) -> Option<Result<T, E>> {\n        match self {\n            Ok(Option::Some(x)) => Option::Some(Ok(x)),\n            Ok(Option::None) => Option::None,\n            Err(e) => Option::Some(Err(e)),\n        }\n    }\n}\n\nimpl<T, E> IntoIterator for Result<T, E> {\n    type Item = T;\n    type IntoIter = crate::option::IntoIter<T>;\n\n    fn into_iter(self) -> crate::option::IntoIter<T> {\n        self.ok().into_iter()\n    }\n}\n// ---- end mod std::result ----\n}\n// ---- mod std::alloc ----\npub mod alloc {\n// EDITION: rust\n// std::alloc: Allocator, Layout, Gpa, and the arenas (plan §2, §2.1,\n// §9.1). Allocation is a capability: a function allocates only through an\n// allocator reachable from its parameters, a type that holds one has it\n// among its parameters (`Vec<T, A>`, `Parser<'s, A>`), and nothing makes\n// one from nothing: Gpa has no public constructor (main receives it),\n// every arena is made from a parent allocator or over memory it is lent,\n// and a static's type may not hold an allocator (the compiler's\n// AllocFree marker). Allocators compose as Zig's do: an Arena over a\n// FixedBuf allocates no heap at all, an arena over an arena frees per\n// request, a scope gives back what it took while older containers stay.\n// AnyAlloc<'a> erases an allocator's type (no dyn: a struct of function\n// pointers), so a library taking `a: AnyAlloc<'_>` is compiled once.\n\nuse crate::cell::Cell;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::IntoIterator;\nuse crate::marker::{Copy, PhantomData};\nuse crate::ops::Drop;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// A block's size and alignment (a power of two), in bytes.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\n");
    buf_str(out, c"pub struct Layout {\n    size: usize,\n    align: usize,\n}\n\nimpl Layout {\n    // A T's layout.\n    pub fn new<T>() -> Layout {\n        Layout { size: crate::mem::size_of::<T>(), align: crate::mem::align_of::<T>() }\n    }\n\n    // n T's; LayoutError when the size overflows.\n    pub fn array<T>(n: usize) -> Result<Layout, LayoutError> {\n        crate::panic::todo()\n    }\n\n    // LayoutError when align is not a power of two or size overflows\n    // when rounded up to it.\n    pub fn from_size_align(size: usize, align: usize) -> Result<Layout, LayoutError> {\n        crate::panic::todo()\n    }\n\n    pub fn size(&self) -> usize {\n        self.size\n    }\n\n    pub fn align(&self) -> usize {\n        self.align\n    }\n}\n\n// A layout that cannot be.\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct LayoutError;\n\n// An allocator out of memory (or over its limit).\n// mvs: AllocError, AllocError::impl Debug\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct AllocError;\n\n// mvs: AllocError::impl Display\nimpl Display for AllocError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"memory allocation failed\")\n    }\n}\n\n// Why try_reserve failed: the capacity overflowed, or the allocator.\n#[derive(Clone, PartialEq, Eq, Debug)]\npub enum TryReserveError {\n    CapacityOverflow,\n    AllocError { layout: Layout },\n}\n\n// What gives out blocks of memory: Rust's allocator_api shape, `&self`\n// (so `&'a Arena<P>` is one, through the impl for &A), with a thin\n// pointer (`NonNull<u8>`, not `NonNull<[u8]>`: no fat raw pointers) and\n// FREES. An `unsafe trait`: every impl is `unsafe impl` with a SAFETY\n// comment naming where its memory comes from (plan §2.0 rule 1).\n// std2: changed: Rust's shape over &self and a Layout (MVS: try_alloc,\n// try_resize, free over *Self and i64 sizes)\n// UNSAFE: an impl promises its blocks are valid, aligned and its own,\n// which no type checks.\n");
    buf_str(out, c"// SAFETY: each impl states where its memory comes from (rule 1).\npub unsafe trait Allocator {\n    // Whether deallocate gives memory back. False for the arenas and\n    // FixedBuf, whose memory comes back all at once; a container on such\n    // an allocator needs dropping only if its elements do (plan §9.1:\n    // `needs_drop::<Vec<T, A>>() == needs_drop::<T>()` when !A::FREES).\n    const FREES: bool = true;\n\n    // A block for layout, or AllocError.\n    // mvs: Allocator::try_alloc, Allocator::alloc\n    // std2: changed: a Layout, a Result (MVS: a size and align, null or a panic)\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError>;\n\n    // The same, its bytes zero.\n    fn allocate_zeroed(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        crate::panic::todo()\n    }\n\n    // Gives a block back.\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, as Rust's Allocator::deallocate.\n    // mvs: Allocator::free\n    // std2: changed: a NonNull and a Layout (MVS: free(p, size, align))\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout);\n\n    // The block made larger (moved if it must), its contents kept.\n    // UNSAFE: p must be a block of this allocator's, with layout old;\n    // new.size() >= old.size().\n    // SAFETY: a contract on the caller, as Rust's Allocator::grow.\n    // mvs: Allocator::try_resize, Allocator::resize\n    // std2: changed: two Layouts, a Result\n    unsafe fn grow(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        crate::panic::todo()\n    }\n\n    // grow, the new bytes zero.\n    // UNSAFE: as grow.\n    // SAFETY: a contract on the caller, as grow's.\n    unsafe fn grow_zeroed(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        crate::panic::todo()\n    }\n\n    // The block made smaller.\n");
    buf_str(out, c"    // UNSAFE: p must be a block of this allocator's, with layout old;\n    // new.size() <= old.size().\n    // SAFETY: a contract on the caller, as Rust's Allocator::shrink.\n    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        crate::panic::todo()\n    }\n\n    // The allocator borrowed (a container on `&A` instead of moving A in).\n    fn by_ref(&self) -> &Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n\n    // The allocator with its type erased: an AnyAlloc of it (plan §2.1).\n    fn erase(&self) -> AnyAlloc<'_>\n        where\n            Self: Sized,\n    {\n        AnyAlloc::new(self)\n    }\n}\n\n// A reference to an allocator is one: containers hold `&'a Arena<P>`.\n// UNSAFE: an Allocator impl.\n// SAFETY: every block comes from *self, the referenced allocator, and goes\n// back to it; FREES is its FREES.\nunsafe impl<A: Allocator + ?Sized> Allocator for &A {\n    const FREES: bool = A::FREES;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        (**self).allocate(layout)\n    }\n\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        // UNSAFE: deallocate's own contract.\n        // SAFETY: passed through: the caller's p and layout are A's.\n        unsafe { (**self).deallocate(p, layout) }\n    }\n}\n\n// The general-purpose heap (C's malloc): zero-sized and Copy, with no\n// public constructor. The runtime makes one and `main` receives it\n// (`fn main(gpa: Gpa)`), so a function can allocate from it only when\n// it is handed one (plan §2.0 rule 1). With --check-alloc it is the\n// checking allocator (leaks, double frees, use after free).\n#[derive(Clone, Copy)]\npub struct Gpa {\n    sealed: (),\n}\n\nimpl Gpa {\n    // Blocks given out and not freed yet (with --check-alloc; else 0).\n    // std2: changed: usize\n    pub fn live_blocks(&self) -> usize {\n        crate::panic::todo()\n    }\n\n");
    buf_str(out, c"    // Whether every block was freed (with --check-alloc; else true).\n    pub fn check_leaks(&self) -> bool {\n        crate::panic::todo()\n    }\n}\n\n// UNSAFE: an Allocator impl over C's heap.\n// SAFETY: blocks come from malloc (aligned by posix_memalign above 16)\n// and go back to free; FREES true.\nunsafe impl Allocator for Gpa {\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        crate::panic::todo()\n    }\n\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        crate::panic::todo()\n    }\n}\n\n// ---- Arenas ----\n\n// A bump allocator over chunks taken from its parent P (Zig's\n// ArenaAllocator.init(child)): allocation is a pointer bump, and nothing\n// is freed one block at a time. Containers allocate through\n// `&'a Arena<P>`, which ties them to the arena; `reset(&mut self)` gives\n// every chunk's room back for reuse, safe because the exclusive borrow\n// proves nothing in the arena is live; dropping the arena gives the\n// chunks back to P. Its bump pointer is a Cell: Allocator::allocate takes\n// &self (plan §2.1).\n// mvs: Arena\n// std2: changed: generic over its parent P, which it owns (MVS: a copyable handle over a Gpa)\npub struct Arena<P: Allocator> {\n    parent: P,\n    chunk: Cell<*mut u8>,\n    at: Cell<usize>,\n    end: Cell<usize>,\n    used: Cell<usize>,\n    allocated: Cell<usize>,\n}\n\nimpl<P: Allocator> Arena<P> {\n    // An empty arena over parent; its first chunk comes with its first\n    // allocation.\n    // std2: changed: any parent P (MVS: a Gpa)\n    pub fn new_in(parent: P) -> Arena<P> {\n        crate::panic::todo()\n    }\n\n    // An arena whose first chunk holds bytes.\n    // std2: changed: usize, any parent P\n    pub fn with_capacity_in(bytes: usize, parent: P) -> Arena<P> {\n        crate::panic::todo()\n    }\n\n    // The bytes given out since it was made or reset.\n    // std2: changed: usize\n    pub fn used(&self) -> usize {\n        self.used.get()\n");
    buf_str(out, c"    }\n\n    // The bytes it holds from its parent, used or not.\n    // mvs: Arena::chunk_bytes\n    // std2: renamed\n    pub fn allocated_bytes(&self) -> usize {\n        self.allocated.get()\n    }\n\n    pub fn parent(&self) -> &P {\n        &self.parent\n    }\n\n    // Every chunk's room back for reuse (the first chunk kept, the others\n    // given back to P). Safe: `&mut self` proves no container, &T or &str\n    // in the arena is live.\n    // std2: changed: safe, &mut self (MVS: unsafe, through a raw pointer)\n    pub fn reset(&mut self) {\n        crate::panic::todo()\n    }\n\n    // x moved into the arena; a &mut to it for as long as the arena is\n    // borrowed. T must have no drop glue (`needs_drop::<T>()` false,\n    // checked at compile time): the arena never runs drops. A T holding a\n    // Vec on this arena qualifies (FREES false: plan §9.1); for drops, a\n    // TypedArena.\n    pub fn alloc<T>(&self, x: T) -> &mut T {\n        crate::panic::todo()\n    }\n\n    // A copy of s in the arena.\n    pub fn alloc_slice_copy<T: Copy>(&self, s: &[T]) -> &mut [T] {\n        crate::panic::todo()\n    }\n\n    // n values f(0), f(1), ... in the arena (no drop glue, as alloc).\n    pub fn alloc_slice_fill_with<T, F: FnMut(usize) -> T>(&self, n: usize, f: F) -> &mut [T] {\n        crate::panic::todo()\n    }\n\n    // A copy of s in the arena.\n    pub fn alloc_str(&self, s: &str) -> &mut str {\n        crate::panic::todo()\n    }\n\n    // Runs f with a scope of the arena: what f allocates in the scope is\n    // given back when f returns, while containers made before stay live\n    // (the scratch checkpoint). The scope's region is late-bound, so\n    // nothing allocated in it can leave f (`#[scoped]` is no longer\n    // needed); R cannot name it.\n    // std2: changed: FnOnce(&ArenaScope<'_, P>) (MVS: FnMut(ScopedArena))\n    pub fn scope<R, F: FnOnce(&ArenaScope<'_, P>) -> R>(&self, f: F) -> R {\n        crate::panic::todo()\n    }\n}\n\n");
    buf_str(out, c"// UNSAFE: an Allocator impl over the arena's chunks.\n// SAFETY: blocks are bumped from chunks taken from P and live until the\n// arena is reset (which needs &mut, so no block is borrowed) or dropped;\n// deallocate does nothing (FREES false).\n// mvs: Arena::impl Allocator\nunsafe impl<P: Allocator> Allocator for Arena<P> {\n    const FREES: bool = false;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        crate::panic::todo()\n    }\n\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}\n}\n\n// Gives every chunk back to P (MVS's free_all).\nimpl<P: Allocator> Drop for Arena<P> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// A scope of an arena (Arena::scope) or of any parent (arena_scope): an\n// allocator whose blocks are all given back when the scope ends. 's is\n// the scope's region, invariant, so a container on `&'s ArenaScope<'s,\n// P>` cannot outlive it.\n// mvs: ScopedArena\n// std2: renamed\npub struct ArenaScope<'s, P: Allocator> {\n    home: &'s Arena<P>,\n    chunk: Cell<*mut u8>,\n    at: Cell<usize>,\n    end: Cell<usize>,\n    used: Cell<usize>,\n    region: PhantomData<Cell<&'s ()>>,\n}\n\nimpl<'s, P: Allocator> ArenaScope<'s, P> {\n    // The bytes given out in this scope.\n    // mvs: ScopedArena::used\n    // std2: changed: usize\n    pub fn used(&self) -> usize {\n        self.used.get()\n    }\n\n    // As Arena::alloc, in the scope.\n    pub fn alloc<T>(&self, x: T) -> &mut T {\n        crate::panic::todo()\n    }\n\n    pub fn alloc_slice_copy<T: Copy>(&self, s: &[T]) -> &mut [T] {\n        crate::panic::todo()\n    }\n\n    pub fn alloc_str(&self, s: &str) -> &mut str {\n        crate::panic::todo()\n    }\n\n    // A scope inside this one.\n    // mvs: ScopedArena::scope\n    // std2: changed: FnOnce(&ArenaScope<'_, P>)\n    pub fn scope<R, F: FnOnce(&ArenaScope<'_, P>) -> R>(&self, f: F) -> R {\n        crate::panic::todo()\n    }\n}\n\n");
    buf_str(out, c"// UNSAFE: an Allocator impl over the scope's chunks.\n// SAFETY: blocks are bumped from chunks the scope took from its arena's\n// spare chunks or parent; they are given back when the scope ends, and\n// the scope's region keeps every block's borrow inside it; FREES false.\n// mvs: ScopedArena::impl Allocator\nunsafe impl<'s, P: Allocator> Allocator for ArenaScope<'s, P> {\n    const FREES: bool = false;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        crate::panic::todo()\n    }\n\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}\n}\n\nimpl<'s, P: Allocator> Drop for ArenaScope<'s, P> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// Runs f with a scope over parent (an arena made for the call): what f\n// allocates is freed when it returns. Over any allocator, a Gpa as much\n// as an arena or a FixedBuf.\n// std2: changed: any parent, by reference; FnOnce(&ArenaScope<'_, &P>) (MVS: a Gpa, FnMut(ScopedArena))\npub fn arena_scope<'p, P: Allocator, R,\n    F: FnOnce(&ArenaScope<'_, &'p P>) -> R>(parent: &'p P, f: F) -> R {\n    crate::panic::todo()\n}\n\n// An arena of T's that runs their drops at its own drop: for T's with\n// drop glue (Arena::alloc refuses those). Its chunks come from P.\npub struct TypedArena<T, P: Allocator> {\n    parent: P,\n    chunks: Cell<*mut u8>,\n    at: Cell<*mut T>,\n    end: Cell<*mut T>,\n    len: Cell<usize>,\n    marker: PhantomData<T>,\n}\n\nimpl<T, P: Allocator> TypedArena<T, P> {\n    pub fn new_in(parent: P) -> TypedArena<T, P> {\n        crate::panic::todo()\n    }\n\n    // x moved in; a &mut to it for as long as the arena is borrowed.\n    pub fn alloc(&self, x: T) -> &mut T {\n        crate::panic::todo()\n    }\n\n    // The items moved in, side by side.\n    pub fn alloc_extend<I: IntoIterator<Item = T>>(&self, iter: I) -> &mut [T] {\n        crate::panic::todo()\n    }\n\n    // How many T's it holds.\n    pub fn len(&self) -> usize {\n");
    buf_str(out, c"        self.len.get()\n    }\n}\n\n// Drops every T, then gives the chunks back to P.\nimpl<T, P: Allocator> Drop for TypedArena<T, P> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// A bump allocator over memory it is lent (`FixedBuf::new(&mut buf)`, buf\n// a local array): no heap at all; out of room is an AllocError. Its\n// counters are Cells (allocate takes &self). An arena over one\n// (`Arena<&FixedBuf<'b>>`) allocates on the stack.\n// mvs: FixedBuf\n// std2: changed: a region 'b, the lent memory's (MVS: #[views(mem)])\npub struct FixedBuf<'b> {\n    start: *mut u8,\n    len: usize,\n    at: Cell<usize>,\n    mem: PhantomData<&'b mut [u8]>,\n}\n\nimpl<'b> FixedBuf<'b> {\n    // An allocator over mem, for as long as mem is lent.\n    // std2: changed: takes &'b mut [u8]\n    pub fn new(mem: &'b mut [u8]) -> FixedBuf<'b> {\n        crate::panic::todo()\n    }\n\n    // The bytes given out since it was made or reset.\n    // std2: changed: usize\n    pub fn used(&self) -> usize {\n        self.at.get()\n    }\n\n    // The bytes it can give out in all.\n    pub fn capacity(&self) -> usize {\n        self.len\n    }\n\n    // All its room back. Safe: `&mut self` proves no block is borrowed.\n    // std2: changed: safe, &mut self (MVS: unsafe, through a raw pointer)\n    pub fn reset(&mut self) {\n        self.at.set(0)\n    }\n}\n\n// UNSAFE: an Allocator impl over lent memory.\n// SAFETY: blocks are bumped from mem, which outlives 'b and every\n// borrow of the FixedBuf; deallocate does nothing (FREES false).\n// mvs: FixedBuf::impl Allocator\nunsafe impl<'b> Allocator for FixedBuf<'b> {\n    const FREES: bool = false;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        crate::panic::todo()\n    }\n\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}\n}\n\n// Any allocator, its type erased: a data pointer and the allocator's\n");
    buf_str(out, c"// functions, Copy, five words. Made from any &'a A (`a.erase()`,\n// `AnyAlloc::new(&a)`); itself an Allocator, so `Vec<T, AnyAlloc<'a>>`\n// and a library taking `a: AnyAlloc<'_>` are compiled once for every\n// allocator (decision 9; Device<AnyAlloc<'a>>, decision 17). FREES is\n// true: it cannot know what it erased.\npub struct AnyAlloc<'a> {\n    data: *const u8,\n    allocate_fn: fn(*const u8, Layout) -> Result<NonNull<u8>, AllocError>,\n    // UNSAFE: the erased allocator's deallocate, unsafe as the trait's.\n    // SAFETY: called only from AnyAlloc's own deallocate, with its contract.\n    deallocate_fn: unsafe fn(*const u8, NonNull<u8>, Layout),\n    // UNSAFE: the erased allocator's grow, unsafe as the trait's.\n    // SAFETY: called only from AnyAlloc's own grow, with its contract.\n    grow_fn: unsafe fn(*const u8, NonNull<u8>, Layout, Layout) -> Result<NonNull<u8>, AllocError>,\n    // UNSAFE: the erased allocator's shrink, unsafe as the trait's.\n    // SAFETY: called only from AnyAlloc's own shrink, with its contract.\n    shrink_fn: unsafe fn(*const u8, NonNull<u8>, Layout, Layout) -> Result<NonNull<u8>, AllocError>,\n    marker: PhantomData<&'a ()>,\n}\n\nimpl<'a> AnyAlloc<'a> {\n    // a, erased: valid for as long as a is borrowed.\n    pub fn new<A: Allocator>(a: &'a A) -> AnyAlloc<'a> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a> Clone for AnyAlloc<'a> {\n    fn clone(&self) -> AnyAlloc<'a> {\n        *self\n    }\n}\n\nimpl<'a> Copy for AnyAlloc<'a> {}\n\nimpl<'a, A: Allocator> From<&'a A> for AnyAlloc<'a> {\n    fn from(a: &'a A) -> AnyAlloc<'a> {\n        AnyAlloc::new(a)\n    }\n}\n\n// UNSAFE: an Allocator impl through the erased functions.\n// SAFETY: each call goes to the erased allocator's own function with its\n// data pointer, valid for 'a; that allocator's impl is sound by its own\n// SAFETY comment.\nunsafe impl<'a> Allocator for AnyAlloc<'a> {\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n");
    buf_str(out, c"        (self.allocate_fn)(self.data, layout)\n    }\n\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        // UNSAFE: the erased allocator's deallocate.\n        // SAFETY: passed through: the caller's p and layout are its.\n        unsafe { (self.deallocate_fn)(self.data, p, layout) }\n    }\n\n    unsafe fn grow(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        // UNSAFE: the erased allocator's grow.\n        // SAFETY: passed through, as deallocate.\n        unsafe { (self.grow_fn)(self.data, p, old, new) }\n    }\n\n    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        // UNSAFE: the erased allocator's shrink.\n        // SAFETY: passed through, as deallocate.\n        unsafe { (self.shrink_fn)(self.data, p, old, new) }\n    }\n}\n\nimpl<'a> Debug for AnyAlloc<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"AnyAlloc\")\n    }\n}\n// ---- end mod std::alloc ----\n}\n// ---- mod std::boxed ----\npub mod boxed {\n// EDITION: rust\n// std::boxed: Box<T, A>, one value on the heap of A (MVS had none: a\n// recursive type took a Vec or raw pointers). `Box::new_in(x, a)`,\n// allocator last as nightly's allocator_api (plan §0); there is no\n// `Box::new`, as there is no default allocator. A is always written\n// (`Box<Node, Gpa>`, `Box<Node, &'a Arena<Gpa>>`). Box<[T], A> and\n// Box<str, A> wait for unsized boxes (0.29, with user DSTs).\n\nuse crate::alloc::{AllocError, Allocator};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::ops::{Deref, DerefMut, Drop};\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// A T on A's heap, freed (and dropped) when the Box is.\n");
    buf_str(out, c"pub struct Box<T, A: Allocator> {\n    ptr: NonNull<T>,\n    alloc: A,\n}\n\nimpl<T, A: Allocator> Box<T, A> {\n    // x moved to a block of a; out of memory panics.\n    pub fn new_in(x: T, a: A) -> Box<T, A> {\n        crate::panic::todo()\n    }\n\n    // The same, with AllocError instead of a panic.\n    pub fn try_new_in(x: T, a: A) -> Result<Box<T, A>, AllocError> {\n        crate::panic::todo()\n    }\n\n    // The value, moved out; the block is freed. (`*b` moves out of a Box\n    // in Rust; vole spells it into_inner.)\n    pub fn into_inner(b: Box<T, A>) -> T {\n        crate::panic::todo()\n    }\n\n    // The allocator the Box frees into.\n    pub fn allocator(b: &Box<T, A>) -> &A {\n        &b.alloc\n    }\n\n    // A copy of the value on b.\n    pub fn clone_in<B: Allocator>(&self, b: B) -> Box<T, B>\n        where\n            T: Clone,\n    {\n        Box::new_in(self.deref().clone(), b)\n    }\n\n    // The value, never freed: a &mut that lives as long as A's memory.\n    pub fn leak<'a>(b: Box<T, A>) -> &'a mut T\n        where\n            A: 'a,\n    {\n        crate::panic::todo()\n    }\n\n    // The block's pointer, the Box forgotten: from_raw_in takes it back.\n    pub fn into_raw(b: Box<T, A>) -> *mut T {\n        crate::panic::todo()\n    }\n\n    // The pointer and the allocator, the Box forgotten.\n    pub fn into_raw_with_allocator(b: Box<T, A>) -> (*mut T, A) {\n        crate::panic::todo()\n    }\n\n    // A Box again, from into_raw's pointer and the allocator it came from.\n    // UNSAFE: p must come from a Box<T, A> on an allocator equal to a.\n    // SAFETY: a contract on the caller, as Rust's Box::from_raw_in.\n    pub unsafe fn from_raw_in(p: *mut T, a: A) -> Box<T, A> {\n        crate::panic::todo()\n    }\n}\n\nimpl<T, A: Allocator> Deref for Box<T, A> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        crate::panic::todo()\n    }\n}\n\nimpl<T, A: Allocator> DerefMut for Box<T, A> {\n");
    buf_str(out, c"    fn deref_mut(&mut self) -> &mut T {\n        crate::panic::todo()\n    }\n}\n\nimpl<T, A: Allocator> Drop for Box<T, A> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// A Box on the same allocator (a clone of it).\nimpl<T: Clone, A: Allocator + Clone> Clone for Box<T, A> {\n    fn clone(&self) -> Box<T, A> {\n        self.clone_in(self.alloc.clone())\n    }\n}\n\nimpl<T: PartialEq, A: Allocator> PartialEq for Box<T, A> {\n    fn eq(&self, other: &Box<T, A>) -> bool {\n        self.deref() == other.deref()\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for Box<T, A> {}\n\nimpl<T: PartialOrd, A: Allocator> PartialOrd for Box<T, A> {\n    fn partial_cmp(&self, other: &Box<T, A>) -> crate::option::Option<Ordering> {\n        self.deref().partial_cmp(other.deref())\n    }\n}\n\nimpl<T: Ord, A: Allocator> Ord for Box<T, A> {\n    fn cmp(&self, other: &Box<T, A>) -> Ordering {\n        self.deref().cmp(other.deref())\n    }\n}\n\nimpl<T: Hash, A: Allocator> Hash for Box<T, A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.deref().hash(state)\n    }\n}\n\nimpl<T: Debug, A: Allocator> Debug for Box<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        self.deref().fmt(f)\n    }\n}\n\nimpl<T: Display, A: Allocator> Display for Box<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        self.deref().fmt(f)\n    }\n}\n\nimpl<T, A: Allocator> AsRef<T> for Box<T, A> {\n    fn as_ref(&self) -> &T {\n        self.deref()\n    }\n}\n\nimpl<T, A: Allocator> AsMut<T> for Box<T, A> {\n    fn as_mut(&mut self) -> &mut T {\n        self.deref_mut()\n    }\n}\n\nimpl<T, A: Allocator> Borrow<T> for Box<T, A> {\n    fn borrow(&self) -> &T {\n        self.deref()\n    }\n}\n\nimpl<T, A: Allocator> BorrowMut<T> for Box<T, A> {\n    fn borrow_mut(&mut self) -> &mut T {\n        self.deref_mut()\n    }\n}\n// ---- end mod std::boxed ----\n}\n// ---- mod std::vec ----\npub mod vec {\n// EDITION: rust\n");
    buf_str(out, c"// std::vec: Vec<T, A>, a growable array on A's heap. A is always written\n// (`Vec<u8, Gpa>`, `Vec<Tok<'s>, &'a Arena<Gpa>>`: plan §2.0 rule 2);\n// `Vec::new_in(a)`, `Vec::with_capacity_in(n, a)`, `Vec::from_in([..], a)`.\n// What a Vec shares with every slice (get, first, iter, sort_unstable,\n// contains, ...) is [T]'s, reached through Deref: `v.get(i)` is\n// `Option<&T>`, `v.iter()` yields `&T`. Vec's own methods are the ones\n// that change its length or its storage, and allocate from its A only:\n// push, extend, clone and the stable sorts.\n\nuse crate::alloc::{Allocator, TryReserveError};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::default::DefaultIn;\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{\n    DoubleEndedIterator, ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator,\n};\nuse crate::marker::PhantomData;\nuse crate::ops::{Deref, DerefMut, Drop, Index, IndexMut, RangeBounds};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\nuse crate::slice::{Iter, IterMut, SliceIndex};\n\n// A contiguous, growable array of T on A. Its elements are dropped and its\n// block freed when it is.\npub struct Vec<T, A: Allocator> {\n    ptr: NonNull<T>,\n    cap: usize,\n    len: usize,\n    alloc: A,\n}\n\nimpl<T, A: Allocator> Vec<T, A> {\n    // An empty Vec on a; it allocates at its first push.\n    pub fn new_in(a: A) -> Vec<T, A> {\n        crate::panic::todo()\n    }\n\n    // An empty Vec on a with room for cap elements.\n    pub fn with_capacity_in(cap: usize, a: A) -> Vec<T, A> {\n        crate::panic::todo()\n    }\n\n    // A Vec of the array's elements, moved, on a (`Vec::from_in([1, 2, 3],\n    // gpa)`, Rust's `vec![1, 2, 3]`). Compiler-provided for every length N\n    // until const generics (plan §6): `#[array_builtin(N)]` names the\n");
    buf_str(out, c"    // length, and the compiler makes the item for each N a program uses.\n    // later: array_builtin\n    #[array_builtin(N)]\n    pub fn from_in(items: [T; N], a: A) -> Vec<T, A> {\n        crate::panic::todo()\n    }\n\n    // A Vec of its parts: a pointer from a Vec on an allocator equal to a,\n    // its length and its capacity.\n    // UNSAFE: the parts must be a Vec's, as Rust's from_raw_parts_in.\n    // SAFETY: a contract on the caller: ptr allocated by a for cap T's,\n    // the first len initialized.\n    pub unsafe fn from_raw_parts_in(ptr: *mut T, len: usize, cap: usize, a: A) -> Vec<T, A> {\n        crate::panic::todo()\n    }\n\n    pub fn len(&self) -> usize {\n        self.len\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.len == 0\n    }\n\n    // How many elements fit before it reallocates.\n    pub fn capacity(&self) -> usize {\n        self.cap\n    }\n\n    // The allocator it grows into.\n    // std2: changed: returns &A (MVS: a copy of A)\n    pub fn allocator(&self) -> &A {\n        &self.alloc\n    }\n\n    // Room for extra more elements (at least: it may take more).\n    pub fn reserve(&mut self, extra: usize) {\n        crate::panic::todo()\n    }\n\n    // Room for exactly extra more.\n    pub fn reserve_exact(&mut self, extra: usize) {\n        crate::panic::todo()\n    }\n\n    // reserve, with the error instead of a panic.\n    // std2: changed: takes usize, returns TryReserveError (MVS: i64, AllocError)\n    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {\n        crate::panic::todo()\n    }\n\n    // Gives back the room beyond its length.\n    pub fn shrink_to_fit(&mut self) {\n        crate::panic::todo()\n    }\n\n    // Gives back the room beyond max(its length, min_capacity).\n    pub fn shrink_to(&mut self, min_capacity: usize) {\n        crate::panic::todo()\n    }\n\n    // Appends x, growing from A when it is full.\n    pub fn push(&mut self, x: T) {\n        crate::panic::todo()\n");
    buf_str(out, c"    }\n\n    // The last element, moved out; None when empty.\n    pub fn pop(&mut self) -> Option<T> {\n        crate::panic::todo()\n    }\n\n    // Inserts x at i, moving the ones after it up; panics when i > len.\n    pub fn insert(&mut self, i: usize, x: T) {\n        crate::panic::todo()\n    }\n\n    // Removes element i, moving the ones after it down; panics when out of\n    // bounds.\n    pub fn remove(&mut self, i: usize) -> T {\n        crate::panic::todo()\n    }\n\n    // Removes element i, putting the last one in its place: O(1), the\n    // order not kept.\n    pub fn swap_remove(&mut self, i: usize) -> T {\n        crate::panic::todo()\n    }\n\n    // Keeps the first n elements, dropping the rest.\n    pub fn truncate(&mut self, n: usize) {\n        crate::panic::todo()\n    }\n\n    // Drops every element; the capacity stays.\n    pub fn clear(&mut self) {\n        self.truncate(0)\n    }\n\n    // Its elements as a slice (`&v[..]`, or Deref).\n    pub fn as_slice(&self) -> &[T] {\n        crate::panic::todo()\n    }\n\n    // std2: changed: returns &mut [T] (MVS: an inout view)\n    pub fn as_mut_slice(&mut self) -> &mut [T] {\n        crate::panic::todo()\n    }\n\n    pub fn as_ptr(&self) -> *const T {\n        self.ptr.as_ptr() as *const T\n    }\n\n    pub fn as_mut_ptr(&mut self) -> *mut T {\n        self.ptr.as_ptr()\n    }\n\n    // Sets its length, nothing dropped or initialized.\n    // UNSAFE: the first n elements must be initialized and n <= capacity.\n    // SAFETY: a contract on the caller, as Rust's set_len.\n    pub unsafe fn set_len(&mut self, n: usize) {\n        self.len = n;\n    }\n\n    // Keeps the elements f says true of, in order.\n    // std2: changed: FnMut(&T) (MVS: a let T)\n    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {\n        crate::panic::todo()\n    }\n\n    // retain, with each element given as &mut.\n    pub fn retain_mut<F: FnMut(&mut T) -> bool>(&mut self, f: F) {\n        crate::panic::todo()\n");
    buf_str(out, c"    }\n\n    // Removes consecutive elements with the same key (f's), keeping the first.\n    // mvs: dedup_by_key\n    // std2: changed: Vec's method (MVS: a free function over a slice)\n    pub fn dedup_by_key<K: PartialEq, F: FnMut(&mut T) -> K>(&mut self, key: F) {\n        crate::panic::todo()\n    }\n\n    // Removes consecutive elements that same_bucket(a, b) says are equal.\n    // mvs: dedup_by\n    // std2: changed: Vec's method (MVS: a free function over a slice)\n    pub fn dedup_by<F: FnMut(&mut T, &mut T) -> bool>(&mut self, same_bucket: F) {\n        crate::panic::todo()\n    }\n\n    // Moves every element of other to its end, leaving other empty.\n    pub fn append(&mut self, other: &mut Vec<T, A>) {\n        crate::panic::todo()\n    }\n\n    // The elements in range, removed and yielded by the iterator; the\n    // rest closes up when it is dropped.\n    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, T, A> {\n        crate::panic::todo()\n    }\n\n    // The elements from at on, as a new Vec on a clone of A.\n    pub fn split_off(&mut self, at: usize) -> Vec<T, A>\n        where\n            A: Clone,\n    {\n        crate::panic::todo()\n    }\n\n    // Its length made n: new elements are f()'s.\n    pub fn resize_with<F: FnMut() -> T>(&mut self, n: usize, f: F) {\n        crate::panic::todo()\n    }\n\n    // The elements, never freed: a &mut slice that lives as long as A's memory.\n    pub fn leak<'a>(self) -> &'a mut [T]\n        where\n            A: 'a,\n    {\n        crate::panic::todo()\n    }\n\n    // Moves the Vec out, leaving an empty one on a clone of its allocator\n    // (vole's: a Vec has no Default, so `mem::take` does not apply).\n    // std2: changed: needs A: Clone\n    pub fn take(&mut self) -> Vec<T, A>\n        where\n            A: Clone,\n    {\n        let a = self.alloc.clone();\n        crate::mem::replace(self, Vec::new_in(a))\n    }\n\n");
    buf_str(out, c"    // Sorts it, stable (equal elements keep their order), with scratch from\n    // its own A: Rust's `sort`. MVS's sort was unstable: it is\n    // `sort_unstable` now ([T]'s, allocates nothing).\n    // std2: changed: stable, scratch from A (MVS: unstable)\n    pub fn sort(&mut self)\n        where\n            T: Ord,\n    {\n        crate::panic::todo()\n    }\n\n    // sort, by a comparison.\n    // mvs: Vec::sort_by, [T]::sort_by, sort_by\n    // std2: changed: stable, an Ordering (MVS: unstable, an i64)\n    pub fn sort_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {\n        crate::panic::todo()\n    }\n\n    // sort, by a key.\n    // std2: changed: stable, FnMut(&T) (MVS: unstable, a let T)\n    pub fn sort_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {\n        crate::panic::todo()\n    }\n}\n\nimpl<T: Clone, A: Allocator> Vec<T, A> {\n    // A Vec of n clones of x on a (Rust's `vec![x; n]`, its order).\n    // mvs: Vec::filled_in\n    // std2: renamed\n    pub fn from_elem_in(x: T, n: usize, a: A) -> Vec<T, A> {\n        crate::panic::todo()\n    }\n\n    // Appends clones of s's elements.\n    pub fn extend_from_slice(&mut self, s: &[T]) {\n        crate::panic::todo()\n    }\n\n    // Appends clones of the elements in src (its own elements).\n    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {\n        crate::panic::todo()\n    }\n\n    // Its length made n: new elements are clones of x.\n    pub fn resize(&mut self, n: usize, x: T) {\n        crate::panic::todo()\n    }\n\n    // A copy on another allocator.\n    pub fn clone_in<B: Allocator>(&self, b: B) -> Vec<T, B> {\n        crate::panic::todo()\n    }\n}\n\nimpl<T: PartialEq, A: Allocator> Vec<T, A> {\n    // Removes consecutive equal elements, keeping the first.\n    // mvs: dedup\n    // std2: changed: Vec's method (MVS: a free function over a slice)\n    pub fn dedup(&mut self) {\n        self.dedup_by(|a, b| *a == *b)\n    }\n}\n\n");
    buf_str(out, c"impl<T, A: Allocator> Drop for Vec<T, A> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\nimpl<T, A: Allocator> Deref for Vec<T, A> {\n    type Target = [T];\n\n    fn deref(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> DerefMut for Vec<T, A> {\n    fn deref_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\n// `v[i]` and `&v[a..b]`: built in for Vec in 0.27.0; this is the trait's.\nimpl<T, I: SliceIndex<[T]>, A: Allocator> Index<I> for Vec<T, A> {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self.as_slice())\n    }\n}\n\nimpl<T, I: SliceIndex<[T]>, A: Allocator> IndexMut<I> for Vec<T, A> {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self.as_mut_slice())\n    }\n}\n\n// A copy on the same allocator (a clone of it): plan §2.0, `Clone`\n// reuses the stored allocator.\n// std2: changed: needs A: Clone\nimpl<T: Clone, A: Allocator + Clone> Clone for Vec<T, A> {\n    fn clone(&self) -> Vec<T, A> {\n        self.clone_in(self.alloc.clone())\n    }\n}\n\n// mvs: Vec::impl Eq\n// std2: changed: PartialEq against any Vec<U, B>\nimpl<T: PartialEq<U>, U, A: Allocator, B: Allocator> PartialEq<Vec<U, B>> for Vec<T, A> {\n    fn eq(&self, other: &Vec<U, B>) -> bool {\n        self.as_slice() == other.as_slice()\n    }\n}\n\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U]> for Vec<T, A> {\n    fn eq(&self, other: &[U]) -> bool {\n        self.as_slice() == other\n    }\n}\n\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<&[U]> for Vec<T, A> {\n    fn eq(&self, other: &&[U]) -> bool {\n        self.as_slice() == *other\n    }\n}\n\n// Compiler-provided for every N (array_builtin, as from_in).\n// later: array_builtin\n#[array_builtin(N)]\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U; N]> for Vec<T, A> {\n    fn eq(&self, other: &[U; N]) -> bool {\n        self.as_slice() == &other[..]\n    }\n}\n\n");
    buf_str(out, c"impl<T: Eq, A: Allocator> Eq for Vec<T, A> {}\n\nimpl<T: PartialOrd, A: Allocator> PartialOrd for Vec<T, A> {\n    fn partial_cmp(&self, other: &Vec<T, A>) -> Option<Ordering> {\n        self.as_slice().partial_cmp(other.as_slice())\n    }\n}\n\nimpl<T: Ord, A: Allocator> Ord for Vec<T, A> {\n    fn cmp(&self, other: &Vec<T, A>) -> Ordering {\n        self.as_slice().cmp(other.as_slice())\n    }\n}\n\n// The elements' hashes, as the slice's: the same for any A.\nimpl<T: Hash, A: Allocator> Hash for Vec<T, A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.as_slice().hash(state)\n    }\n}\n\n// `[1, 2, 3]`.\nimpl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        self.as_slice().fmt(f)\n    }\n}\n\nimpl<T, A: Allocator> AsRef<[T]> for Vec<T, A> {\n    fn as_ref(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> AsMut<[T]> for Vec<T, A> {\n    fn as_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\nimpl<T, A: Allocator> Borrow<[T]> for Vec<T, A> {\n    fn borrow(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> BorrowMut<[T]> for Vec<T, A> {\n    fn borrow_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\n// An empty Vec on a (`map.entry(k).or_default()` for Vec values).\nimpl<T, A: Allocator> DefaultIn<A> for Vec<T, A> {\n    fn default_in(a: A) -> Vec<T, A> {\n        Vec::new_in(a)\n    }\n}\n\nimpl<T, A: Allocator> Extend<T> for Vec<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n        }\n    }\n}\n\nimpl<'a, T: Copy + 'a, A: Allocator> Extend<&'a T> for Vec<T, A> {\n    fn extend<I: IntoIterator<Item = &'a T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(*x);\n        }\n    }\n}\n\n// `iter.collect_in(a)` into a Vec.\nimpl<T, A: Allocator> FromIteratorIn<T, A> for Vec<T, A> {\n");
    buf_str(out, c"    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Vec<T, A> {\n        let mut v = Vec::new_in(a);\n        v.extend(iter);\n        v\n    }\n}\n\n// `for x in v`: the elements, moved out.\nimpl<T, A: Allocator> IntoIterator for Vec<T, A> {\n    type Item = T;\n    type IntoIter = IntoIter<T, A>;\n\n    fn into_iter(self) -> IntoIter<T, A> {\n        crate::panic::todo()\n    }\n}\n\n// `for x in &v`: &T's.\nimpl<'a, T, A: Allocator> IntoIterator for &'a Vec<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\n// `for x in &mut v`: &mut T's.\nimpl<'a, T, A: Allocator> IntoIterator for &'a mut Vec<T, A> {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n\n// A Vec's elements, by value; what is left is dropped with it.\npub struct IntoIter<T, A: Allocator> {\n    buf: NonNull<T>,\n    cap: usize,\n    start: usize,\n    end: usize,\n    alloc: A,\n}\n\nimpl<T, A: Allocator> IntoIter<T, A> {\n    // What is left, as a slice.\n    pub fn as_slice(&self) -> &[T] {\n        crate::panic::todo()\n    }\n}\n\nimpl<T, A: Allocator> Iterator for IntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        crate::panic::todo()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.end - self.start, Option::Some(self.end - self.start))\n    }\n}\n\nimpl<T, A: Allocator> DoubleEndedIterator for IntoIter<T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        crate::panic::todo()\n    }\n}\n\nimpl<T, A: Allocator> ExactSizeIterator for IntoIter<T, A> {}\n\nimpl<T, A: Allocator> Drop for IntoIter<T, A> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n\n// Vec::drain's iterator: the removed elements; the Vec closes up when it\n// is dropped.\npub struct Drain<'a, T, A: Allocator> {\n");
    buf_str(out, c"    vec: NonNull<Vec<T, A>>,\n    start: usize,\n    end: usize,\n    tail: usize,\n    marker: PhantomData<&'a mut Vec<T, A>>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T, A: Allocator> DoubleEndedIterator for Drain<'a, T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T, A: Allocator> ExactSizeIterator for Drain<'a, T, A> {}\n\nimpl<'a, T, A: Allocator> Drop for Drain<'a, T, A> {\n    fn drop(&mut self) {\n        crate::panic::todo()\n    }\n}\n// ---- end mod std::vec ----\n}\n// ---- mod std::slice ----\npub mod slice {\n// EDITION: rust\n// std::slice: the methods of [T], always behind a reference (`&[T]`,\n// `&mut [T]`: MVS's views), its iterators and SliceIndex. A Vec and an\n// array have them all through Deref and the unsize coercion `&[T; N] ->\n// &[T]`. What reads returns references into the slice (`get` is\n// `Option<&T>`, `iter` yields `&T`); what sorts in place without\n// allocating keeps Rust's name and meaning (`sort_unstable`); the stable\n// sorts allocate scratch, so on a slice they take an allocator\n// (`sort_in(a)`), while Vec's `sort` uses its own (plan §2). MVS's free\n// functions (`reverse(s)`, `binary_search(s, x)`) are methods now.\n\nuse crate::alloc::Allocator;\nuse crate::borrow::ToOwnedIn;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};\nuse crate::marker::PhantomData;\nuse crate::ops::{\n    Index, IndexMut, Range, RangeFrom, RangeFull, RangeInclusive, RangeTo, RangeToInclusive,\n};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\nuse crate::vec::Vec;\n\nimpl<T> [T] {\n");
    buf_str(out, c"    // The number of elements (built in; MVS's `.len` read).\n    pub fn len(&self) -> usize {\n        crate::panic::todo()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    // Element i, or the subslice a range names; None when out of bounds.\n    // mvs: [T]::get, Vec::get\n    // std2: changed: a reference, through SliceIndex (MVS: a copy of T)\n    pub fn get<I: SliceIndex<[T]>>(&self, index: I) -> Option<&I::Output> {\n        index.get(self)\n    }\n\n    // The same, mutable.\n    pub fn get_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> Option<&mut I::Output> {\n        index.get_mut(self)\n    }\n\n    // get, with no bounds check.\n    // UNSAFE: an index out of bounds is undefined.\n    // SAFETY: a contract on the caller: index within the slice.\n    pub unsafe fn get_unchecked<I: SliceIndex<[T]>>(&self, index: I) -> &I::Output {\n        crate::panic::todo()\n    }\n\n    // UNSAFE: an index out of bounds is undefined.\n    // SAFETY: a contract on the caller: index within the slice.\n    pub unsafe fn get_unchecked_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> &mut I::Output {\n        crate::panic::todo()\n    }\n\n    // mvs: Vec::first\n    // std2: changed: a reference (MVS: a copy, on Vec only)\n    pub fn first(&self) -> Option<&T> {\n        self.get(0)\n    }\n\n    // mvs: Vec::last\n    // std2: changed: a reference (MVS: a copy, on Vec only)\n    pub fn last(&self) -> Option<&T> {\n        if self.is_empty() { Option::None } else { self.get(self.len() - 1) }\n    }\n\n    pub fn first_mut(&mut self) -> Option<&mut T> {\n        self.get_mut(0)\n    }\n\n    pub fn last_mut(&mut self) -> Option<&mut T> {\n        let n = self.len();\n        if n == 0 { Option::None } else { self.get_mut(n - 1) }\n    }\n\n    // The first element and the rest.\n    pub fn split_first(&self) -> Option<(&T, &[T])> {\n        crate::panic::todo()\n    }\n\n    // The last element and the rest.\n");
    buf_str(out, c"    pub fn split_last(&self) -> Option<(&T, &[T])> {\n        crate::panic::todo()\n    }\n\n    // [0, mid) and [mid, len); panics when mid > len.\n    pub fn split_at(&self, mid: usize) -> (&[T], &[T]) {\n        (&self[..mid], &self[mid..])\n    }\n\n    // The same, mutable: two disjoint &mut slices.\n    pub fn split_at_mut(&mut self, mid: usize) -> (&mut [T], &mut [T]) {\n        crate::panic::todo()\n    }\n\n    // The elements, by reference, in order (`.rev()` from the end).\n    // mvs: [T]::iter, [T]::iter_ref, Vec::iter, Vec::iter_ref, SliceIter, SliceRefIter\n    // std2: changed: yields &T (MVS's iter copied each T; iter_ref is this)\n    pub fn iter(&self) -> Iter<'_, T> {\n        crate::panic::todo()\n    }\n\n    // The elements, by &mut.\n    pub fn iter_mut(&mut self) -> IterMut<'_, T> {\n        crate::panic::todo()\n    }\n\n    // Subslices of size elements (the last one shorter); size > 0.\n    pub fn chunks(&self, size: usize) -> Chunks<'_, T> {\n        crate::panic::todo()\n    }\n\n    pub fn chunks_mut(&mut self, size: usize) -> ChunksMut<'_, T> {\n        crate::panic::todo()\n    }\n\n    // Subslices of exactly size elements; the rest is `remainder()`.\n    pub fn chunks_exact(&self, size: usize) -> ChunksExact<'_, T> {\n        crate::panic::todo()\n    }\n\n    // Every run of size consecutive elements, overlapping.\n    pub fn windows(&self, size: usize) -> Windows<'_, T> {\n        crate::panic::todo()\n    }\n\n    // The subslices between the elements pred says true of.\n    pub fn split<F: FnMut(&T) -> bool>(&self, pred: F) -> Split<'_, T, F> {\n        crate::panic::todo()\n    }\n\n    // Exchanges elements i and j; panics when out of bounds.\n    // mvs: [T]::swap, Vec::swap, swap_at\n    pub fn swap(&mut self, i: usize, j: usize) {\n        crate::panic::todo()\n    }\n\n    // Reverses the order in place.\n    // mvs: reverse\n    pub fn reverse(&mut self) {\n        crate::panic::todo()\n    }\n\n");
    buf_str(out, c"    // Rotates left by mid: element mid comes first.\n    // mvs: rotate_left\n    pub fn rotate_left(&mut self, mid: usize) {\n        crate::panic::todo()\n    }\n\n    // mvs: rotate_right\n    pub fn rotate_right(&mut self, k: usize) {\n        crate::panic::todo()\n    }\n\n    // Every element set by f().\n    pub fn fill_with<F: FnMut() -> T>(&mut self, f: F) {\n        crate::panic::todo()\n    }\n\n    // Exchanges its elements with other's (the same length, or a panic).\n    pub fn swap_with_slice(&mut self, other: &mut [T]) {\n        crate::panic::todo()\n    }\n\n    // Sorts in place, unstable (equal elements may change order),\n    // allocating nothing: ipnsort, as MVS's `sort` (now this name).\n    // mvs: sort_unstable, sort, [T]::sort, Vec::sort\n    // std2: renamed\n    pub fn sort_unstable(&mut self)\n        where\n            T: Ord,\n    {\n        crate::panic::todo()\n    }\n\n    // mvs: sort_unstable_by\n    pub fn sort_unstable_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {\n        crate::panic::todo()\n    }\n\n    // mvs: sort_unstable_by_key\n    pub fn sort_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {\n        crate::panic::todo()\n    }\n\n    // Sorts stable, scratch from a (Rust's `sort` on a slice; on a Vec,\n    // `v.sort()` uses the Vec's allocator).\n    // mvs: sort_stable_in\n    // std2: renamed\n    pub fn sort_in<A: Allocator>(&mut self, a: A)\n        where\n            T: Ord,\n    {\n        crate::panic::todo()\n    }\n\n    // mvs: sort_stable_by_in, sort_stable_less_in\n    // std2: renamed\n    pub fn sort_by_in<F: FnMut(&T, &T) -> Ordering, A: Allocator>(&mut self, compare: F, a: A) {\n        crate::panic::todo()\n    }\n\n    pub fn sort_by_key_in<K: Ord, F: FnMut(&T) -> K, A: Allocator>(&mut self, f: F, a: A) {\n        crate::panic::todo()\n    }\n\n    // Puts the element that sorted order has at i at i, the smaller ones\n");
    buf_str(out, c"    // before and the larger after (unstable, no allocation).\n    // mvs: select_nth_unstable\n    pub fn select_nth_unstable(&mut self, i: usize) -> (&mut [T], &mut T, &mut [T])\n        where\n            T: Ord,\n    {\n        crate::panic::todo()\n    }\n\n    // mvs: select_nth_unstable_by, select_nth_unstable_less\n    pub fn select_nth_unstable_by<F: FnMut(&T, &T) -> Ordering>(\n        &mut self,\n        i: usize,\n        compare: F,\n    ) -> (&mut [T], &mut T, &mut [T]) {\n        crate::panic::todo()\n    }\n\n    // mvs: select_nth_unstable_by_key\n    pub fn select_nth_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(\n        &mut self,\n        i: usize,\n        f: F,\n    ) -> (&mut [T], &mut T, &mut [T]) {\n        crate::panic::todo()\n    }\n\n    // In a sorted slice: Ok(where x is) or Err(where it would go).\n    // mvs: binary_search\n    // std2: changed: Result<usize, usize> (Rust's)\n    pub fn binary_search(&self, x: &T) -> Result<usize, usize>\n        where\n            T: Ord,\n    {\n        self.binary_search_by(|p| p.cmp(x))\n    }\n\n    // mvs: binary_search_by\n    pub fn binary_search_by<F: FnMut(&T) -> Ordering>(&self, f: F) -> Result<usize, usize> {\n        crate::panic::todo()\n    }\n\n    // mvs: binary_search_by_key\n    pub fn binary_search_by_key<B: Ord, F: FnMut(&T) -> B>(&self, b: &B, f: F) -> Result<usize,\n        usize> {\n        let mut f = f;\n        self.binary_search_by(|k| f(k).cmp(b))\n    }\n\n    // The first index where pred turns false, for a slice partitioned by it.\n    // mvs: partition_point\n    pub fn partition_point<P: FnMut(&T) -> bool>(&self, pred: P) -> usize {\n        crate::panic::todo()\n    }\n\n    // Whether it is sorted (each element <= the next).\n    pub fn is_sorted(&self) -> bool\n        where\n            T: PartialOrd,\n    {\n        crate::panic::todo()\n    }\n\n    pub fn is_sorted_by_key<K: PartialOrd, F: FnMut(&T) -> K>(&self, f: F) -> bool {\n        crate::panic::todo()\n");
    buf_str(out, c"    }\n\n    // Whether an element equals x.\n    // mvs: [T]::contains, Vec::contains\n    // std2: changed: takes &T\n    pub fn contains(&self, x: &T) -> bool\n        where\n            T: PartialEq,\n    {\n        for y in self.iter() {\n            if *y == *x {\n                return true;\n            }\n        }\n        false\n    }\n\n    // std2: changed: takes &[T]\n    pub fn starts_with(&self, needle: &[T]) -> bool\n        where\n            T: PartialEq,\n    {\n        needle.len() <= self.len() && &self[..needle.len()] == needle\n    }\n\n    // std2: changed: takes &[T]\n    pub fn ends_with(&self, needle: &[T]) -> bool\n        where\n            T: PartialEq,\n    {\n        needle.len() <= self.len() && &self[self.len() - needle.len()..] == needle\n    }\n\n    // Copies src's elements in (the same length, or a panic).\n    pub fn copy_from_slice(&mut self, src: &[T])\n        where\n            T: Copy,\n    {\n        crate::panic::todo()\n    }\n\n    // Copies the elements in src to dest (they may overlap).\n    pub fn copy_within<R: crate::ops::RangeBounds<usize>>(&mut self, src: R, dest: usize)\n        where\n            T: Copy,\n    {\n        crate::panic::todo()\n    }\n\n    // Clones src's elements in (the same length, or a panic).\n    pub fn clone_from_slice(&mut self, src: &[T])\n        where\n            T: Clone,\n    {\n        crate::panic::todo()\n    }\n\n    // Every element set to a clone of x.\n    // mvs: fill\n    pub fn fill(&mut self, x: T)\n        where\n            T: Clone,\n    {\n        crate::panic::todo()\n    }\n\n    // A Vec of clones of its elements, on a.\n    pub fn to_vec_in<A: Allocator>(&self, a: A) -> Vec<T, A>\n        where\n            T: Clone,\n    {\n        let mut v = Vec::with_capacity_in(self.len(), a);\n        v.extend_from_slice(self);\n        v\n    }\n\n    // n copies of it, end to end, on a.\n    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> Vec<T, A>\n");
    buf_str(out, c"        where\n            T: Copy,\n    {\n        crate::panic::todo()\n    }\n\n    pub fn as_ptr(&self) -> *const T {\n        crate::panic::todo()\n    }\n\n    pub fn as_mut_ptr(&mut self) -> *mut T {\n        crate::panic::todo()\n    }\n}\n\n// What indexes a T (a slice or a str): usize for one element, the ranges\n// for a subslice. Sealed: only std implements it. `s[i]` and `s.get(i)`\n// go through it, so one `get` takes an index or a range.\npub trait SliceIndex<T: ?Sized> {\n    type Output: ?Sized;\n\n    fn get(self, slice: &T) -> Option<&Self::Output>;\n    fn get_mut(self, slice: &mut T) -> Option<&mut Self::Output>;\n    // Panics when out of bounds.\n    fn index(self, slice: &T) -> &Self::Output;\n    fn index_mut(self, slice: &mut T) -> &mut Self::Output;\n}\n\nimpl<T> SliceIndex<[T]> for usize {\n    type Output = T;\n\n    fn get(self, slice: &[T]) -> Option<&T> {\n        crate::panic::todo()\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut T> {\n        crate::panic::todo()\n    }\n\n    fn index(self, slice: &[T]) -> &T {\n        crate::panic::todo()\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut T {\n        crate::panic::todo()\n    }\n}\n\nimpl<T> SliceIndex<[T]> for Range<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        crate::panic::todo()\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        crate::panic::todo()\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        crate::panic::todo()\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        crate::panic::todo()\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeInclusive<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        crate::panic::todo()\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        crate::panic::todo()\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        crate::panic::todo()\n    }\n\n");
    buf_str(out, c"    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        crate::panic::todo()\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeFrom<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (self.start..slice.len()).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        let n = slice.len();\n        (self.start..n).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (self.start..slice.len()).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        let n = slice.len();\n        (self.start..n).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeTo<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (0..self.end).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        (0..self.end).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (0..self.end).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        (0..self.end).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeToInclusive<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (0..=self.end).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        (0..=self.end).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (0..=self.end).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        (0..=self.end).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeFull {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        Option::Some(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        Option::Some(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        slice\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        slice\n    }\n}\n");
    buf_str(out, c"\n// `s[i]` and `&s[a..b]`: built in for slices in 0.27.0; this is the trait's.\nimpl<T, I: SliceIndex<[T]>> Index<I> for [T] {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\nimpl<T, I: SliceIndex<[T]>> IndexMut<I> for [T] {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self)\n    }\n}\n\n// Element by element; any two slices whose elements compare.\n// mvs: [T]::impl Eq\n// std2: changed: PartialEq over any [T] (MVS: Eq for [u8] and structural ==)\nimpl<T: PartialEq<U>, U> PartialEq<[U]> for [T] {\n    fn eq(&self, other: &[U]) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        let mut i = 0;\n        while i < self.len() {\n            if self[i] != other[i] {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n}\n\nimpl<T: Eq> Eq for [T] {}\n\n// Lexicographic.\nimpl<T: PartialOrd> PartialOrd for [T] {\n    fn partial_cmp(&self, other: &[T]) -> Option<Ordering> {\n        crate::panic::todo()\n    }\n}\n\n// mvs: [T]::impl Ord\n// std2: changed: Ord over any [T] (MVS: Ord for [u8])\nimpl<T: Ord> Ord for [T] {\n    fn cmp(&self, other: &[T]) -> Ordering {\n        crate::panic::todo()\n    }\n}\n\n// The length, then each element.\n// mvs: [T]::impl Hash\n// std2: changed: Hash over any [T] (MVS: Hash for [u8])\nimpl<T: Hash> Hash for [T] {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        crate::panic::todo()\n    }\n}\n\n// `[1, 2, 3]`.\n// mvs: [T]::impl Debug\n// std2: changed: Debug over any [T] (MVS: Debug for [u8])\nimpl<T: Debug> Debug for [T] {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_list().entries(self.iter()).finish()\n    }\n}\n\n// `slice.to_owned_in(a)`: a Vec<T, A> of clones.\nimpl<T: Clone, A: Allocator> ToOwnedIn<A> for [T] {\n    type Owned = Vec<T, A>;\n\n");
    buf_str(out, c"    fn to_owned_in(&self, a: A) -> Vec<T, A> {\n        self.to_vec_in(a)\n    }\n}\n\n// later: impl_for_ref\nimpl<'a, T> Default for &'a [T] {\n    fn default() -> &'a [T] {\n        &[]\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a [T] {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a mut [T] {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n\n// [T]::iter's iterator: &T's, from either end.\npub struct Iter<'a, T> {\n    ptr: NonNull<T>,\n    end: *const T,\n    marker: PhantomData<&'a T>,\n}\n\nimpl<'a, T> Iter<'a, T> {\n    // What is left, as a slice.\n    pub fn as_slice(&self) -> &'a [T] {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> Clone for Iter<'a, T> {\n    fn clone(&self) -> Iter<'a, T> {\n        Iter { ptr: self.ptr, end: self.end, marker: PhantomData }\n    }\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        crate::panic::todo()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Iter<'a, T> {\n    fn next_back(&mut self) -> Option<&'a T> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Iter<'a, T> {}\n\n// [T]::iter_mut's iterator: &mut T's, from either end.\npub struct IterMut<'a, T> {\n    ptr: NonNull<T>,\n    end: *mut T,\n    marker: PhantomData<&'a mut T>,\n}\n\nimpl<'a, T> IterMut<'a, T> {\n    // What is left, as a &mut slice.\n    pub fn into_slice(self) -> &'a mut [T] {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> Iterator for IterMut<'a, T> {\n    type Item = &'a mut T;\n\n    fn next(&mut self) -> Option<&'a mut T> {\n        crate::panic::todo()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n");
    buf_str(out, c"        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for IterMut<'a, T> {\n    fn next_back(&mut self) -> Option<&'a mut T> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for IterMut<'a, T> {}\n\n// [T]::chunks's iterator.\npub struct Chunks<'a, T> {\n    v: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for Chunks<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.v.is_empty() {\n            return Option::None;\n        }\n        let n = crate::cmp::min(self.size, self.v.len());\n        let (head, tail) = self.v.split_at(n);\n        self.v = tail;\n        Option::Some(head)\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Chunks<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Chunks<'a, T> {}\n\n// [T]::chunks_mut's iterator.\npub struct ChunksMut<'a, T> {\n    v: &'a mut [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for ChunksMut<'a, T> {\n    type Item = &'a mut [T];\n\n    fn next(&mut self) -> Option<&'a mut [T]> {\n        crate::panic::todo()\n    }\n}\n\n// [T]::chunks_exact's iterator.\npub struct ChunksExact<'a, T> {\n    v: &'a [T],\n    rem: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> ChunksExact<'a, T> {\n    // The elements past the last whole chunk.\n    pub fn remainder(&self) -> &'a [T] {\n        self.rem\n    }\n}\n\nimpl<'a, T> Iterator for ChunksExact<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.v.len() < self.size {\n            return Option::None;\n        }\n        let (head, tail) = self.v.split_at(self.size);\n        self.v = tail;\n        Option::Some(head)\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for ChunksExact<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for ChunksExact<'a, T> {}\n\n");
    buf_str(out, c"// [T]::windows's iterator.\npub struct Windows<'a, T> {\n    v: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for Windows<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.size > self.v.len() {\n            return Option::None;\n        }\n        let w = &self.v[..self.size];\n        self.v = &self.v[1..];\n        Option::Some(w)\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Windows<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Windows<'a, T> {}\n\n// [T]::split's iterator.\npub struct Split<'a, T, P> {\n    v: &'a [T],\n    pred: P,\n    finished: bool,\n}\n\nimpl<'a, T, P: FnMut(&T) -> bool> Iterator for Split<'a, T, P> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        crate::panic::todo()\n    }\n}\n\nimpl<'a, T, P: FnMut(&T) -> bool> DoubleEndedIterator for Split<'a, T, P> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        crate::panic::todo()\n    }\n}\n// ---- end mod std::slice ----\n}\n// ---- mod std::str ----\npub mod str {\n// EDITION: rust\n// std::str: the methods of str, UTF-8 text, always behind a reference\n// (`&str`: MVS's `str` view), its iterators, Pattern, FromStr and\n// from_utf8. A String has them all through Deref. What reads returns\n// views of the text (`trim`, `split`, `strip_prefix`); what allocates\n// takes an allocator, Rust's name with `_in` (`to_uppercase_in(a)`,\n// `replace_in(from, to, a)`: plan §2). Indices are byte offsets, usize.\n// The text's code points are `char`s (0.27.2: the rust front's char\n// type; MVS had none and used u32).\n\nuse crate::alloc::Allocator;\nuse crate::borrow::ToOwnedIn;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::AsRef;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\n");
    buf_str(out, c"use crate::iter::{DoubleEndedIterator, Iterator};\nuse crate::ops::{Index, Range, RangeFrom, RangeFull, RangeInclusive, RangeTo, RangeToInclusive};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::slice::SliceIndex;\nuse crate::string::String;\n\nimpl str {\n    // bytes as a str when they are UTF-8 (Rust 1.87's inherent form;\n    // `std::str::from_utf8` too).\n    // std2: changed: &[u8] to &str\n    pub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {\n        from_utf8(v)\n    }\n\n    // UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {\n        crate::panic::todo()\n    }\n\n    // Its length in bytes.\n    pub fn len(&self) -> usize {\n        self.as_bytes().len()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    pub fn as_bytes(&self) -> &[u8] {\n        crate::panic::todo()\n    }\n\n    // The same bytes, writable as a str (an ASCII case change in place).\n    pub fn as_ptr(&self) -> *const u8 {\n        self.as_bytes().as_ptr()\n    }\n\n    // Whether byte i starts a code point (or is the end).\n    pub fn is_char_boundary(&self, i: usize) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn is_ascii(&self) -> bool {\n        crate::panic::todo()\n    }\n\n    // The subslice a byte range names; None when out of bounds or not on\n    // char boundaries.\n    pub fn get<I: SliceIndex<str>>(&self, i: I) -> Option<&I::Output> {\n        i.get(self)\n    }\n\n    // [0, mid) and [mid, len); panics when mid is not a char boundary.\n    pub fn split_at(&self, mid: usize) -> (&str, &str) {\n        (&self[..mid], &self[mid..])\n    }\n\n    // Its code points.\n    // std2: changed: yields char (MVS: u32)\n    pub fn chars(&self) -> Chars<'_> {\n        crate::panic::todo()\n    }\n\n    // Its code points with their byte offsets.\n");
    buf_str(out, c"    // std2: changed: yields (usize, char) (MVS: (i64, u32))\n    pub fn char_indices(&self) -> CharIndices<'_> {\n        crate::panic::todo()\n    }\n\n    // Its bytes.\n    // std2: changed: a Bytes<'_> of u8 (MVS: a SliceIter<u8>)\n    pub fn bytes(&self) -> Bytes<'_> {\n        crate::panic::todo()\n    }\n\n    // Its lines, without their \"\\n\" or \"\\r\\n\"; a last empty line is not one.\n    pub fn lines(&self) -> Lines<'_> {\n        crate::panic::todo()\n    }\n\n    // The pieces between the matches of p.\n    pub fn split<P: Pattern>(&self, p: P) -> Split<'_, P> {\n        crate::panic::todo()\n    }\n\n    // The same, from the end.\n    pub fn rsplit<P: Pattern>(&self, p: P) -> RSplit<'_, P> {\n        crate::panic::todo()\n    }\n\n    // At most n pieces: the last holds the rest.\n    // std2: changed: n is usize\n    pub fn splitn<P: Pattern>(&self, n: usize, p: P) -> SplitN<'_, P> {\n        crate::panic::todo()\n    }\n\n    pub fn rsplitn<P: Pattern>(&self, n: usize, p: P) -> RSplitN<'_, P> {\n        crate::panic::todo()\n    }\n\n    // split, without an empty last piece (\"a,b,\" gives \"a\" and \"b\").\n    pub fn split_terminator<P: Pattern>(&self, p: P) -> SplitTerminator<'_, P> {\n        crate::panic::todo()\n    }\n\n    // split, each piece with the match that ends it.\n    pub fn split_inclusive<P: Pattern>(&self, p: P) -> SplitInclusive<'_, P> {\n        crate::panic::todo()\n    }\n\n    // The pieces between runs of Unicode white space.\n    pub fn split_whitespace(&self) -> SplitWhitespace<'_> {\n        crate::panic::todo()\n    }\n\n    // The pieces between runs of ASCII white space.\n    pub fn split_ascii_whitespace(&self) -> SplitAsciiWhitespace<'_> {\n        crate::panic::todo()\n    }\n\n    // Before and after the first match of p.\n    pub fn split_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {\n        crate::panic::todo()\n    }\n\n    // Before and after the last match of p.\n");
    buf_str(out, c"    pub fn rsplit_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {\n        crate::panic::todo()\n    }\n\n    // The matches of p.\n    pub fn matches<P: Pattern>(&self, p: P) -> Matches<'_, P> {\n        crate::panic::todo()\n    }\n\n    // The matches of p with their byte offsets.\n    pub fn match_indices<P: Pattern>(&self, p: P) -> MatchIndices<'_, P> {\n        crate::panic::todo()\n    }\n\n    // The byte offset of the first match of p.\n    pub fn find<P: Pattern>(&self, p: P) -> Option<usize> {\n        crate::panic::todo()\n    }\n\n    // The byte offset of the last match of p.\n    pub fn rfind<P: Pattern>(&self, p: P) -> Option<usize> {\n        crate::panic::todo()\n    }\n\n    pub fn contains<P: Pattern>(&self, p: P) -> bool {\n        self.find(p).is_some()\n    }\n\n    pub fn starts_with<P: Pattern>(&self, p: P) -> bool {\n        crate::panic::todo()\n    }\n\n    pub fn ends_with<P: Pattern>(&self, p: P) -> bool {\n        crate::panic::todo()\n    }\n\n    // The rest after p, when it starts with p.\n    pub fn strip_prefix<P: Pattern>(&self, p: P) -> Option<&str> {\n        crate::panic::todo()\n    }\n\n    pub fn strip_suffix<P: Pattern>(&self, p: P) -> Option<&str> {\n        crate::panic::todo()\n    }\n\n    // Without leading and trailing Unicode white space.\n    pub fn trim(&self) -> &str {\n        self.trim_start().trim_end()\n    }\n\n    pub fn trim_start(&self) -> &str {\n        crate::panic::todo()\n    }\n\n    pub fn trim_end(&self) -> &str {\n        crate::panic::todo()\n    }\n\n    // Without leading and trailing ASCII white space.\n    pub fn trim_ascii(&self) -> &str {\n        crate::panic::todo()\n    }\n\n    // Without the leading and trailing matches of p.\n    pub fn trim_matches<P: Pattern>(&self, p: P) -> &str {\n        crate::panic::todo()\n    }\n\n    pub fn trim_start_matches<P: Pattern>(&self, p: P) -> &str {\n        crate::panic::todo()\n    }\n\n");
