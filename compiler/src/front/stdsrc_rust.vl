    buf_str(out, c"impl Display for ParseFloatError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(if self.empty { \"cannot parse float from empty string\" }\n            else { \"invalid float literal\" })\n    }\n}\n\n// Why a bool did not parse (only \"true\" and \"false\" do).\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseBoolError;\n\nimpl Display for ParseBoolError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"provided string was not `true` or `false`\")\n    }\n}\n\n// What a str method searches for: a char, a &str, a &String, a &[char]\n// (any of them) or a closure on a char. Sealed: std's impls only; its\n// methods are std's own shape (Rust's Pattern is unstable).\n// std2: changed: char, &str, &[char], FnMut(char) (MVS: str, u8, u32)\npub trait Pattern: Sized {\n    // The byte range of the first match in hay at or after start.\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)>;\n    // The byte range of the last match in hay before end.\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)>;\n}\n\nimpl Pattern for char {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match_back(hay, end)\n    }\n}\n\n// mvs: str::impl Pattern\nimpl<'b> Pattern for &'b str {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if start > h.len() || n > h.len() {\n            return None;\n        }\n        if n == 0 {\n            // the empty pattern matches at ever