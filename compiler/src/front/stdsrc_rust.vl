    buf_str(out, c"            let mut i = start;\n            while !hay.is_char_boundary(i) {\n                i += 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = start;\n        while i + n <= h.len() {\n            if h[i] == needle[0] && &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n            i += 1;\n        }\n        None\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if end > h.len() || n > end {\n            return None;\n        }\n        if n == 0 {\n            let mut i = end;\n            while !hay.is_char_boundary(i) {\n                i -= 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = end - n + 1;\n        while i > 0 {\n            i -= 1;\n            if h[i] == needle[0] && &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n        }\n        None\n    }\n}\n\nimpl<'b, A: Allocator> Pattern for &'b String<A> {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        self.as_str().next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        self.as_str().next_match_back(hay, end)\n    }\n}\n\nimpl<'b> Pattern for &'b [char] {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        if start > hay.len() {\n            return None;\n        }\n        let mut it = hay[start..].char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if self.contains(&c) {\n                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n");
    buf_str(out, c"    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if self.contains(&c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n}\n\n// later: blanket_impl\nimpl<F: FnMut(char) -> bool> Pattern for F {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        if start > hay.len() {\n            return None;\n        }\n        let mut it = hay[start..].char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n}\n\n// `&s[a..b]` and `s.get(a..b)`: byte ranges on char boundaries.\nimpl SliceIndex<str> for Range<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of UTF-8 bytes, as a str.\n");
