// (Z5) Gpa's implementation, std::__gpa (front/stdalloc.vl: std2_tail)
pub fn std2_gpa_source(out: i64) {
    buf_str(out, c"// EDITION: rust\n// Gpa's implementation (Z5): C's malloc. Not a module of std2's tree:\n// compiler/std/embed.sh --edition rust embeds it as std2_gpa_source, and\n// the compiler's tail (front/stdalloc.vl: std2_tail) puts it in\n// `std::__gpa` unless --check-alloc asks for the checking allocator\n// (rt/alloc_check.vl). alloc.vl's `impl Allocator for Gpa` calls these.\n\nuse crate::alloc::{AllocError, Layout};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// UNSAFE: C's heap, under Gpa.\n// SAFETY: malloc and posix_memalign return a block of at least size bytes\n// (null when out of memory), aligned to 16 or to align; free takes what\n// they returned, once. The functions below keep to that.\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn gpa_c_malloc(size: usize) -> *mut u8;\n    #[link_name = \"posix_memalign\"]\n    fn gpa_c_posix_memalign(out: *mut *mut u8, align: usize, size: usize) -> i32;\n    #[link_name = \"free\"]\n    fn gpa_c_free(p: *mut u8);\n}\n\n// A block for layout: from malloc (posix_memalign above 16), or a\n// dangling aligned pointer for size 0 (Rust's Global).\npub fn allocate(layout: Layout) -> Result<NonNull<u8>, AllocError> {\n    if layout.size() == 0 {\n        // UNSAFE: an address made a pointer (an integer-to-pointer cast).\n        // SAFETY: it is never read or written: a zero-size block.\n        return match NonNull::new(unsafe { layout.align() as *mut u8 }) {\n            Option::Some(p) => Result::Ok(p),\n            Option::None => Result::Err(AllocError {}),\n        };\n    }\n    // UNSAFE: C's heap.\n    // SAFETY: malloc and posix_memalign take any size; posix_memalign's\n    // align is a power of two (Layout's) and at least a word (above 16\n    // only), and it writes p only on success.\n    let p = unsafe {\n        if layout.align() <= 16 {\n            gpa_c_malloc(layout.size())\n        } else {\n            let mut out: *mut u8 = crate::ptr::null_mut();\n");
    buf_str(out, c"            if gpa_c_posix_memalign(&mut out, layout.align(), layout.size()) == 0 {\n                out\n            } else {\n                crate::ptr::null_mut()\n            }\n        }\n    };\n    match NonNull::new(p) {\n        Option::Some(p) => Result::Ok(p),\n        Option::None => Result::Err(AllocError {}),\n    }\n}\n\n// Gives block p (of layout) back to C's heap.\n// UNSAFE: p must be a block allocate gave, with this layout, not yet given\n// back.\n// SAFETY: a contract on the caller (Allocator::deallocate's).\npub unsafe fn deallocate(p: NonNull<u8>, layout: Layout) {\n    if layout.size() != 0 {\n        // UNSAFE: C's free.\n        // SAFETY: the caller's contract: p came from malloc or\n        // posix_memalign, once.\n        unsafe { gpa_c_free(p.as_ptr()) }\n    }\n}\n\n// Without --check-alloc no block is counted.\npub fn live_blocks() -> usize {\n    0\n}\n\npub fn check_leaks() -> bool {\n    true\n}\n");
}

// (Z5) the same with --check-alloc: the checking allocator
pub fn std2_check_gpa_source(out: i64) {
    buf_str(out, c"// EDITION: rust\n// Gpa's implementation with --check-alloc (Z5): the checking allocator,\n// MVS's (compiler/std/alloc_check.vl) in std2's spellings. Not a module of\n// std2's tree: compiler/std/embed.sh --edition rust embeds it as\n// std2_check_gpa_source, and the compiler's tail (front/stdalloc.vl:\n// std2_tail) puts it in `std::__gpa` with --check-alloc, after\n// CHECK_ALLOC_OS (0 macOS, 1 Linux); `std::CHECK_ALLOC_SITE` is the static\n// the compiled program stores each allocating call's site in\n// (middle/checkalloc.vl).\n//\n// Every block gets pages of its own, at the cursor of a large reservation\n// of address space with no access: a block's pages are made readable and\n// writable when it is allocated, and are given back with no access when\n// it is freed, never to be handed out again (every grow moves: the\n// Allocator's default grow). A later access to a freed block faults, and\n// the fault handler names the block, where it was allocated and where\n// freed. Frees are checked: double, invalid and wrong-size frees stop the\n// program (exit 101); the blocks left at exit are listed on stderr (the\n// exit status is unchanged). Block numbers count every allocation from 1,\n// the same each run: VOLE_ALLOC_TRAP=N raises SIGTRAP when block N is\n// allocated, for a debugger. Arenas over a Gpa take their chunks here.\n\nuse crate::alloc::{AllocError, Layout};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// UNSAFE: the system's memory maps, signals and exit, and C's realloc and\n// memcpy for the table and the moves.\n// SAFETY: the prototypes are sys/mman.h's, signal.h's, stdlib.h's,\n// string.h's and unistd.h's; each call below says why its arguments are\n// valid.\nextern \"C\" {\n    #[link_name = \"mmap\"]\n    fn check_c_mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, offset: i64)\n        -> *mut u8;\n    #[link_name = \"mprotect\"]\n");
    buf_str(out, c"    fn check_c_mprotect(addr: *mut u8, len: usize, prot: i32) -> i32;\n    #[link_name = \"getpagesize\"]\n    fn check_c_getpagesize() -> i32;\n    #[link_name = \"getenv\"]\n    fn check_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"raise\"]\n    fn check_c_raise(sig: i32) -> i32;\n    #[link_name = \"atexit\"]\n    fn check_c_atexit(f: extern \"C\" fn()) -> i32;\n    #[link_name = \"sigaction\"]\n    fn check_c_sigaction(sig: i32, act: *const CheckSigaction, old: *mut CheckSigaction) -> i32;\n    #[link_name = \"write\"]\n    fn check_c_write(fd: i32, data: *const u8, count: usize) -> isize;\n    #[link_name = \"realloc\"]\n    fn check_c_realloc(p: *mut u8, size: usize) -> *mut u8;\n    #[link_name = \"_exit\"]\n    fn check_c_exit(code: i32) -> !;\n}\n\n// std's atomic intrinsics (the lowering makes ATOMIC instructions of a std\n// function named so; middle/lower/atomic.vl): the lock's.\n// UNSAFE: a raw pointer. SAFETY: p is valid and aligned (CHECK_LOCK's).\nunsafe fn atomic_cas(p: *mut u32, expected: u32, new: u32, order: i64) -> u32 {\n    crate::panic::unreachable(\"an intrinsic\")\n}\n\n// UNSAFE: a raw pointer. SAFETY: as atomic_cas.\nunsafe fn atomic_store(p: *mut u32, v: u32, order: i64) {\n    crate::panic::unreachable(\"an intrinsic\")\n}\n\n// Threads: each entry below holds this lock (0 free, 1 taken), so the\n// tables are never changed by two threads at once. The fault handler takes\n// nothing (it stops the program). CHECK_ALLOC_SITE is stored by the program\n// without it: under threads a block may name another thread's call.\nstatic mut CHECK_LOCK: u32 = 0;\n\nfn check_lock() {\n    // UNSAFE: the lock's word, through the atomic intrinsics.\n    // SAFETY: CHECK_LOCK is a static u32, valid and aligned; it is only\n    // ever accessed atomically.\n    unsafe {\n        let p: *mut u32 = &mut CHECK_LOCK;\n        while atomic_cas(p, 0, 1, 1) != 0 {}\n    }\n}\n\nfn check_unlock() {\n");
    buf_str(out, c"    // UNSAFE: as check_lock. SAFETY: as check_lock's.\n    unsafe {\n        let p: *mut u32 = &mut CHECK_LOCK;\n        atomic_store(p, 0, 2);\n    }\n}\n\n// A block: its pages [start, start + span), its size, its state, and where\n// it was allocated and freed.\nstruct CheckBlock {\n    start: usize,\n    size: usize,\n    span: usize,\n    state: usize,\n    alloc_site: *const u8,\n    free_site: *const u8,\n}\n\nconst CHECK_LIVE_BLOCK: usize = 1;\nconst CHECK_FREED: usize = 2;\n\n// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\nstatic mut CHECK_BLOCKS: *mut CheckBlock = 0 as *mut CheckBlock;\nstatic mut CHECK_COUNT: usize = 0;\nstatic mut CHECK_CAP: usize = 0;\n// The live blocks.\nstatic mut CHECK_LIVE: usize = 0;\n// The reservations of address space (regions): their bounds and their\n// first block; a region's blocks follow each other, so the blocks are\n// sorted by address within one. The cursor is in the last region.\nconst CHECK_MAX_REGIONS: usize = 256;\nstatic mut CHECK_REGION_START: [usize; 256] = [0; 256];\nstatic mut CHECK_REGION_END: [usize; 256] = [0; 256];\nstatic mut CHECK_REGION_FIRST: [usize; 256] = [0; 256];\nstatic mut CHECK_REGIONS: usize = 0;\nstatic mut CHECK_CURSOR: usize = 0;\n// The page size, 0 until the first allocation.\nstatic mut CHECK_PAGE: usize = 0;\n// VOLE_ALLOC_TRAP; VOLE_ALLOC_MAX_LIVE (the map limit's message when this\n// many blocks are live); 0 when unset.\nstatic mut CHECK_TRAP: usize = 0;\nstatic mut CHECK_MAX_LIVE: usize = 0;\n// The changes to the blocks (allocations and frees), and their count when\n// check_leaks listed the leaks (the exit's list is left out then).\nstatic mut CHECK_CHANGES: usize = 0;\nstatic mut CHECK_LISTED: usize = 0;\nstatic mut CHECK_EVER_LISTED: bool = false;\n\nconst CHECK_REGION_BYTES: usize = 68719476736;\nconst CHECK_PROT_NONE: i32 = 0;\nconst CHECK_PROT_RW: i32 = 3;\nconst CHECK_MAP_FIXED: i32 = 16;\n\n");
    buf_str(out, c"// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\nfn check_map_flags() -> i32 {\n    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n}\n\nfn check_sigbus() -> i32 {\n    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n}\n\n// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n// or (glibc) a 128-byte mask and the flags.\n#[repr(C)]\nstruct CheckSigaction {\n    handler: extern \"C\" fn(i32, *mut u8, *mut u8),\n    words: [u64; 19],\n}\n\nfn check_sigaction() -> CheckSigaction {\n    let mut a = CheckSigaction { handler: check_fault, words: [0; 19] };\n    if CHECK_ALLOC_OS == 1 {\n        // SA_SIGINFO | SA_RESETHAND\n        a.words[16] = 4 | 2147483648;\n    } else {\n        a.words[0] = (64 | 4) << 32;\n    }\n    a\n}\n\n// The offset of si_addr in siginfo_t.\nfn check_si_addr() -> usize {\n    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n}\n\n// A message, written to stderr at once.\nstruct CheckMsg {\n    len: usize,\n    bytes: [u8; 2048],\n}\n\nimpl CheckMsg {\n    fn new() -> CheckMsg {\n        CheckMsg { len: 0, bytes: [0; 2048] }\n    }\n\n    fn byte(&mut self, b: u8) {\n        if self.len < 2048 {\n            self.bytes[self.len] = b;\n            self.len += 1;\n        }\n    }\n\n    fn text(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            self.byte(b[i]);\n            i += 1;\n        }\n    }\n\n    // UNSAFE: s must be a C string.\n    // SAFETY: a contract on the caller: every site is a string literal's.\n    unsafe fn cstr(&mut self, s: *const u8) {\n        let mut n: usize = 0;\n        // UNSAFE: the string's bytes, to its 0.\n        // SAFETY: the caller's contract: s is a C string.\n        unsafe {\n            while *s.add(n) != 0 {\n                self.byte(*s.add(n));\n                n += 1;\n            }\n        }\n    }\n\n");
    buf_str(out, c"    fn int(&mut self, v: usize) {\n        if v >= 10 {\n            self.int(v / 10);\n        }\n        self.byte(b'0' + (v % 10) as u8);\n    }\n\n    fn hex(&mut self, v: usize) {\n        self.text(\"0x\");\n        let digits = \"0123456789abcdef\".as_bytes();\n        let mut started = false;\n        let mut k: usize = 0;\n        while k < 16 {\n            let d = (v >> ((15 - k) * 4)) & 15;\n            if d != 0 || started || k == 15 {\n                started = true;\n                self.byte(digits[d]);\n            }\n            k += 1;\n        }\n    }\n\n    fn site(&mut self, s: *const u8) {\n        if s.is_null() {\n            self.text(\"an unknown place\");\n        } else {\n            // UNSAFE: a site, stored by the compiled program.\n            // SAFETY: every site is a string literal's C string.\n            unsafe { self.cstr(s) }\n        }\n    }\n\n    fn out(&mut self) {\n        self.byte(b'\\n');\n        // UNSAFE: write(2) of the message's bytes.\n        // SAFETY: bytes holds len initialized bytes.\n        unsafe {\n            check_c_write(2, &self.bytes[0] as *const u8, self.len);\n        }\n    }\n}\n\n// Stops the program with message m (exit 101, without the leaks' list).\nfn check_stop(m: &mut CheckMsg) -> ! {\n    m.out();\n    // UNSAFE: _exit. SAFETY: it takes any code.\n    unsafe { check_c_exit(101) }\n}\n\n// Block b, read from the table.\n// UNSAFE: b < CHECK_COUNT.\n// SAFETY: a contract on the caller; the table holds CHECK_COUNT blocks.\nunsafe fn check_block(b: usize) -> *mut CheckBlock {\n    // UNSAFE: an offset into the table. SAFETY: the caller's: b is in it.\n    unsafe { CHECK_BLOCKS.add(b) }\n}\n\n// `block #N (48 bytes), allocated at X[, freed at Y]`.\n// UNSAFE: b < CHECK_COUNT. SAFETY: a contract on the caller.\nunsafe fn check_describe(m: &mut CheckMsg, b: usize) {\n    // UNSAFE: block b. SAFETY: the caller's: b is in the table.\n    unsafe {\n        let k = check_block(b);\n");
    buf_str(out, c"        m.text(\"block #\");\n        m.int(b + 1);\n        m.text(\" (\");\n        m.int((*k).size);\n        m.text(if (*k).size == 1 { \" byte)\" } else { \" bytes)\" });\n        m.text(\", allocated at \");\n        m.site((*k).alloc_site);\n        if (*k).state != CHECK_LIVE_BLOCK {\n            m.text(\", freed at \");\n            m.site((*k).free_site);\n        }\n    }\n}\n\n// The decimal number in environment variable `name` (a C string; 0 when\n// unset or none).\nfn check_env_int(name: &str) -> usize {\n    // UNSAFE: getenv of a C string; its result read to its 0.\n    // SAFETY: name ends in a 0 (the callers' literals); getenv's result is\n    // null or a C string.\n    unsafe {\n        let s = check_c_getenv(name.as_ptr());\n        if s.is_null() {\n            return 0;\n        }\n        let mut v: usize = 0;\n        let mut i: usize = 0;\n        while *s.add(i) >= b'0' && *s.add(i) <= b'9' {\n            v = v * 10 + (*s.add(i) - b'0') as usize;\n            i += 1;\n        }\n        v\n    }\n}\n\n// The first allocation: the page size, the fault handlers, the leaks' list\n// at exit, the environment.\nfn check_init() {\n    // UNSAFE: the system's calls, and the checker's statics (under the lock).\n    // SAFETY: a is a valid sigaction for both signals; check_at_exit takes\n    // nothing.\n    unsafe {\n        CHECK_PAGE = check_c_getpagesize() as usize;\n        let a = check_sigaction();\n        check_c_sigaction(11, &a, crate::ptr::null_mut());\n        check_c_sigaction(check_sigbus(), &a, crate::ptr::null_mut());\n        check_c_atexit(check_at_exit);\n        CHECK_TRAP = check_env_int(\"VOLE_ALLOC_TRAP\\0\");\n        CHECK_MAX_LIVE = check_env_int(\"VOLE_ALLOC_MAX_LIVE\\0\");\n    }\n}\n\n// The system refused to change a block's pages: on Linux, the limit of\n// memory maps (each run of live blocks between freed ones is a map).\nfn check_map_limit() -> ! {\n    let mut m = CheckMsg::new();\n");
    buf_str(out, c"    m.text(\"check-alloc: out of memory maps at block #\");\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    unsafe {\n        m.int(CHECK_COUNT + 1);\n        m.text(\", with \");\n        m.int(CHECK_LIVE);\n    }\n    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n    check_stop(&mut m)\n}\n\n// A new region of at least `bytes`, or false.\nfn check_reserve(bytes: usize) -> bool {\n    // UNSAFE: mmap of address space with no access; the checker's statics.\n    // SAFETY: a fresh mapping (no address asked for); under the lock.\n    unsafe {\n        if CHECK_REGIONS == CHECK_MAX_REGIONS {\n            return false;\n        }\n        let mut size = CHECK_REGION_BYTES;\n        while size < bytes {\n            size = size * 2;\n        }\n        loop {\n            let p = check_c_mmap(crate::ptr::null_mut(), size, CHECK_PROT_NONE, check_map_flags(),\n                -1, 0);\n            if p as isize != -1 {\n                let r = CHECK_REGIONS;\n                CHECK_REGION_START[r] = p as usize;\n                CHECK_REGION_END[r] = p as usize + size;\n                CHECK_REGION_FIRST[r] = CHECK_COUNT;\n                CHECK_REGIONS += 1;\n                CHECK_CURSOR = p as usize;\n                return true;\n            }\n            // (less address space: smaller reservations)\n            if size / 2 < bytes || size <= 1073741824 {\n                return false;\n            }\n            size = size / 2;\n        }\n    }\n}\n\n// A new block of size bytes (> 0) on pages of its own, or null when out of\n// memory.\nfn check_new_block(size: usize) -> *mut u8 {\n    // UNSAFE: the pages made readable and writable; the table grown with\n    // realloc and written; the checker's statics.\n    // SAFETY: [cursor, cursor + span) is in the last region, never handed\n");
    buf_str(out, c"    // out before; the table has room for the new block; under the lock.\n    unsafe {\n        if CHECK_PAGE == 0 {\n            check_init();\n        }\n        if size > 4611686018427387904 {\n            return crate::ptr::null_mut();\n        }\n        let page = CHECK_PAGE;\n        let span = (size + page - 1) / page * page;\n        if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n            if !check_reserve(span) {\n                return crate::ptr::null_mut();\n            }\n        }\n        if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n            check_map_limit();\n        }\n        let p = CHECK_CURSOR as *mut u8;\n        if check_c_mprotect(p, span, CHECK_PROT_RW) != 0 {\n            if CHECK_ALLOC_OS == 1 {\n                check_map_limit();\n            }\n            return crate::ptr::null_mut();\n        }\n        CHECK_CURSOR += span;\n        if CHECK_COUNT == CHECK_CAP {\n            CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n            CHECK_BLOCKS = check_c_realloc(CHECK_BLOCKS as *mut u8,\n                CHECK_CAP * crate::mem::size_of::<CheckBlock>()) as *mut CheckBlock;\n        }\n        *CHECK_BLOCKS.add(CHECK_COUNT) = CheckBlock {\n            start: p as usize,\n            size: size,\n            span: span,\n            state: CHECK_LIVE_BLOCK,\n            alloc_site: crate::CHECK_ALLOC_SITE,\n            free_site: crate::ptr::null(),\n        };\n        CHECK_COUNT += 1;\n        CHECK_CHANGES += 1;\n        CHECK_LIVE += 1;\n        if CHECK_COUNT == CHECK_TRAP {\n            let mut m = CheckMsg::new();\n            m.text(\"check-alloc: \");\n            check_describe(&mut m, CHECK_COUNT - 1);\n            m.text(\" (VOLE_ALLOC_TRAP): SIGTRAP\");\n            m.out();\n            check_c_raise(5);\n        }\n        p\n    }\n}\n\n// Block b's pages given back, with no access, never used again.\n");
    buf_str(out, c"// UNSAFE: b < CHECK_COUNT, a live block. SAFETY: a contract on the caller.\nunsafe fn check_drop_block(b: usize) {\n    // UNSAFE: the block's pages mapped again with no access; its entry.\n    // SAFETY: the caller's: b is a live block, whose pages are its own.\n    unsafe {\n        let k = check_block(b);\n        let p = (*k).start as *mut u8;\n        let span = (*k).span;\n        let flags = check_map_flags() | CHECK_MAP_FIXED;\n        if check_c_mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n            if CHECK_ALLOC_OS == 1 {\n                check_map_limit();\n            }\n            // (the pages keep their contents, but no access)\n            check_c_mprotect(p, span, CHECK_PROT_NONE);\n        }\n        CHECK_LIVE -= 1;\n        (*k).state = CHECK_FREED;\n        (*k).free_site = crate::CHECK_ALLOC_SITE;\n        CHECK_CHANGES += 1;\n    }\n}\n\n// Where address a is: Some(block) whose pages hold it, None outside the\n// reservations; `inside` true when it is in one (and no block holds it).\nfn check_find(a: usize, inside: &mut bool) -> Option<usize> {\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock (or\n    // in the fault handler, which stops the program); blocks below\n    // CHECK_COUNT.\n    unsafe {\n        *inside = false;\n        let mut r: usize = 0;\n        while r < CHECK_REGIONS {\n            if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n                *inside = true;\n                let first = CHECK_REGION_FIRST[r];\n                let mut lo = first;\n                let mut hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n                    else { CHECK_COUNT };\n                // the last block starting at or before a\n                while lo < hi {\n                    let mid = (lo + hi) / 2;\n                    if (*check_block(mid)).start <= a {\n                        lo = mid + 1;\n                    } else {\n                        hi = mid;\n");
    buf_str(out, c"                    }\n                }\n                if lo > first {\n                    let b = lo - 1;\n                    let k = check_block(b);\n                    if a < (*k).start + (*k).span {\n                        return Option::Some(b);\n                    }\n                }\n                return Option::None;\n            }\n            r += 1;\n        }\n        Option::None\n    }\n}\n\n// The live block p of `size` bytes, being freed: its index, or the program\n// stops.\nfn check_owned(p: usize, size: usize) -> usize {\n    let mut inside = false;\n    let found = check_find(p, &mut inside);\n    let mut m = CheckMsg::new();\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock; b\n    // from check_find, below CHECK_COUNT.\n    unsafe {\n        let b = match found {\n            Option::Some(b) => b,\n            Option::None => {\n                m.text(\"invalid free at \");\n                m.site(crate::CHECK_ALLOC_SITE);\n                m.text(\": \");\n                m.hex(p);\n                m.text(\" is not a block of Gpa\");\n                check_stop(&mut m)\n            }\n        };\n        let k = check_block(b);\n        if (*k).start != p {\n            m.text(\"invalid free at \");\n            m.site(crate::CHECK_ALLOC_SITE);\n            m.text(\": \");\n            m.hex(p);\n            m.text(\" is \");\n            m.int(p - (*k).start);\n            m.text(\" bytes into \");\n            check_describe(&mut m, b);\n            check_stop(&mut m);\n        }\n        if (*k).state != CHECK_LIVE_BLOCK {\n            m.text(\"double free: \");\n            check_describe(&mut m, b);\n            m.text(\", freed again at \");\n            m.site(crate::CHECK_ALLOC_SITE);\n            check_stop(&mut m);\n        }\n        if (*k).size != size {\n            m.text(\"wrong-size free: \");\n            check_describe(&mut m, b);\n            m.text(\", freed as \");\n            m.int(size);\n");
    buf_str(out, c"            m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n            m.site(crate::CHECK_ALLOC_SITE);\n            check_stop(&mut m);\n        }\n        b\n    }\n}\n\n// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n// last one) is reported; any other fault happens again with the default\n// action (SA_RESETHAND), as without --check-alloc.\nextern \"C\" fn check_fault(sig: i32, info: *mut u8, context: *mut u8) {\n    // UNSAFE: siginfo_t's si_addr read through the kernel's pointer.\n    // SAFETY: info is the siginfo_t the kernel passes an SA_SIGINFO\n    // handler; si_addr is a word at check_si_addr().\n    let a = unsafe { *(info.add(check_si_addr()) as *const usize) };\n    let mut inside = false;\n    let found = check_find(a, &mut inside);\n    if !inside {\n        return;\n    }\n    let mut m = CheckMsg::new();\n    match found {\n        Option::Some(b) => {\n            m.text(\"use after free: \");\n            // UNSAFE: block b. SAFETY: from check_find, below CHECK_COUNT.\n            unsafe { check_describe(&mut m, b) }\n        }\n        Option::None => {\n            m.text(\"access outside every block: \");\n            m.hex(a);\n            m.text(\" (memory the checking allocator never handed out)\");\n        }\n    }\n    check_stop(&mut m);\n}\n\n// The live blocks, listed (at most 20).\nfn check_list_leaks() {\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock;\n    // blocks below CHECK_COUNT.\n    unsafe {\n        CHECK_LISTED = CHECK_CHANGES;\n        CHECK_EVER_LISTED = true;\n        if CHECK_LIVE == 0 {\n            return;\n        }\n        let mut bytes: usize = 0;\n        let mut b: usize = 0;\n        while b < CHECK_COUNT {\n            if (*check_block(b)).state == CHECK_LIVE_BLOCK {\n                bytes += (*check_block(b)).size;\n            }\n            b += 1;\n        }\n        let mut m = CheckMsg::new();\n        m.text(\"check-alloc: \");\n");
    buf_str(out, c"        m.int(CHECK_LIVE);\n        m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n        m.text(\" of Gpa not freed (\");\n        m.int(bytes);\n        m.text(\" bytes):\");\n        m.out();\n        let mut shown: usize = 0;\n        b = 0;\n        while b < CHECK_COUNT {\n            if (*check_block(b)).state == CHECK_LIVE_BLOCK {\n                if shown == 20 {\n                    let mut more = CheckMsg::new();\n                    more.text(\"  and \");\n                    more.int(CHECK_LIVE - shown);\n                    more.text(\" more\");\n                    more.out();\n                    return;\n                }\n                let mut line = CheckMsg::new();\n                line.text(\"  \");\n                check_describe(&mut line, b);\n                line.out();\n                shown += 1;\n            }\n            b += 1;\n        }\n    }\n}\n\n// At exit: the leaks, unless check_leaks listed them and nothing changed\n// since.\nextern \"C\" fn check_at_exit() {\n    check_lock();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    unsafe {\n        if !CHECK_EVER_LISTED || CHECK_LISTED != CHECK_CHANGES {\n            check_list_leaks();\n        }\n    }\n    check_unlock();\n}\n\n// A block for layout on pages of its own (page-aligned: any alignment up\n// to a page), or a dangling aligned pointer for size 0.\npub fn allocate(layout: Layout) -> Result<NonNull<u8>, AllocError> {\n    let p = if layout.size() == 0 {\n        // UNSAFE: an address made a pointer (an integer-to-pointer cast).\n        // SAFETY: it is never read or written: a zero-size block.\n        unsafe { layout.align() as *mut u8 }\n    } else {\n        check_lock();\n        let q = check_new_block(layout.size());\n        check_unlock();\n        q\n    };\n    match NonNull::new(p) {\n        Option::Some(p) => Result::Ok(p),\n        Option::None => Result::Err(AllocError {}),\n    }\n}\n\n");
    buf_str(out, c"// Block p (of layout) given back: checked against the table first (a\n// double, invalid or wrong-size free stops the program).\n// UNSAFE: p must be a block allocate gave, with this layout.\n// SAFETY: a contract on the caller (Allocator::deallocate's), and checked.\npub unsafe fn deallocate(p: NonNull<u8>, layout: Layout) {\n    check_lock();\n    let a = p.as_ptr() as usize;\n    let mut inside = false;\n    if layout.size() == 0 && !check_find(a, &mut inside).is_some() {\n        check_unlock();\n        return;\n    }\n    let b = check_owned(a, layout.size());\n    // UNSAFE: block b given back. SAFETY: check_owned found it live.\n    unsafe { check_drop_block(b) }\n    check_unlock();\n}\n\n// The blocks allocated and not freed.\npub fn live_blocks() -> usize {\n    check_lock();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    let n = unsafe { CHECK_LIVE };\n    check_unlock();\n    n\n}\n\n// Whether no block is left allocated (the live ones listed on stderr).\npub fn check_leaks() -> bool {\n    check_lock();\n    check_list_leaks();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    let none = unsafe { CHECK_LIVE == 0 };\n    check_unlock();\n    none\n}\n");
}
