    buf_str(out, c"    ;;\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45<<<<<<\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    ;;;;;;;;;;;;;;;;;)&&)))))))));;;\\\n    ;;;;;;);;;;;;;;;;;;;;;;;;;;;;);;\\\n    ;;;;&&))&)))&&));;;;;;;;;;;))));\\\n    ;;;;))))))))))));&&);)&);;;\\x47\\x47\\x47\\x47\\x47\\\n    ;;;;;;;;;;;;;;;););;;;;;;;;;;;;;\\\n    ;;;;;;;;;;;;;)&;;;;;;;;;;;;;;;&&\\\n    &&&&&&&&&));;;;&;;;;;;;;&&&&&&&)\\\n    )&&)))))));&&&&&&&&&&&&)&&))))&&\\\n    )&&&&;;&&&&&&&&&&&&&;)&&)&&&&&&&\\\n    &))&&&&&&&&&)&&&&&)))&&&&&&&&&&&\\\n    &)))&&&&&&&&)))&&)&)&&&&)&&&&&&)\\\n    &&&)&&&&&&);;;;;;;;;;;&&&&&);)))\\\n    ;;;&&;;;;;\\x45\\x45;;;;))))))&&&)&;;\\x45\\x45\\x45\\\n    )&&);;;;;;;;;\\x45\\x45\\x45&&&&&&&&&&<&\\x45\\x45\\x45\\x45\\\n    ;;;;;;;;;;;;\\x45\\x45\\x45\\x45;&&&&&&&&&&&&&&&\\\n    &&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&&&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&&&&&&\\x45\\x45&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&&&&&&&&&&&;;;;\\\n    ;;;;;;;;;;;&;;;;;;;;;;&;;;;;;;;;\\\n    ;;;;;;;;;;;;;\\x45\\x45\\x45;;;;;;;\\x45;\\x45\\x45\\x45;;;;\\\n    ;;;;;;;;;;;;;;\\x45;;;;;;;;;;;;;\\x45\\x45\\x45;\\\n    ;;;;;;;;;;;\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&\\\n    <<<<<<<<<<<<<<&&\";\n// ---- end mod std::unicode ----\n}\n// ---- mod std::io ----\npub mod io {\n// std::io: Read, Write and BufRead, the buffered types, the standard\n// streams, Error. Rust's shape: counts are usize, `read_line` is\n// Stdin's (and BufRead's) and returns the bytes read (0 at the end), and\n// what reads into a growing buffer takes the buffer (`read_to_end(&mut\n// v)`, which grows from v's allocator) or an allocator (`lines_in(a)`,\n// `read_to_string_in(r, a)`). The buffered types hold a fixed buffer\n// inline, so making one allocates nothing. Seek and SeekFrom are here, as\n");
    buf_str(out, c"// Rust's; the file types are std::fs's.\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// io's Result: an io::Error on failure.\n// mvs: Result\npub type Result<T> = crate::result::Result<T, Error>;\n\n// What failed: a kind, and the OS's error number when it came from one.\n// mvs: Error, IoError\n// std2: changed: Rust's io::Error (MVS's root IoError is gone into it)\npub struct Error {\n    kind: ErrorKind,\n    code: i32,\n    msg: &'static str,\n}\n\nimpl Error {\n    // An error of kind k, with a message (Rust's takes any error; vole's a\n    // static text: no allocation, no dyn).\n    // std2: changed: a message, &'static str\n    #[effects()]\n    pub fn new(k: ErrorKind, msg: &'static str) -> Error {\n        Error { kind: k, code: 0, msg: msg }\n    }\n\n    // An error of kind Other, with a message.\n    #[effects()]\n    pub fn other(msg: &'static str) -> Error {\n        Error::new(ErrorKind::Other, msg)\n    }\n\n    // The error errno says.\n    #[effects()]\n    pub fn from_raw_os_error(code: i32) -> Error {\n        Error { kind: kind_of_errno(code), code: code, msg: \"\" }\n    }\n\n    // The error of the last failed OS call (errno).\n    #[effects(static, unsafe)]\n    pub fn last_os_error() -> Error {\n        // UNSAFE: errno, read through libc's pointer to this thread's copy.\n        // SAFETY: __error returns a valid pointer to the calling thread's\n        // errno, an i32.\n        let code = unsafe { *__error() };\n        Error::from_raw_os_error(code)\n    }\n\n    #[effects()]\n    pub fn kind(&self) -> ErrorKind {\n        self.kind\n    }\n\n    #[effects()]\n    pub fn raw_os_error(&self) -> Option<i32> {\n        if self.code == 0 { Option::None } else { Option::Some(self.code) }\n    }\n}\n\n");
    buf_str(out, c"// mvs: Error::impl Display, IoError::impl Display\nimpl Display for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.write_str(os_message(self.code))?;\n            f.write_str(\" (os error \")?;\n            f.write_fmt(self.code)?;\n            f.write_str(\")\")\n        } else if !self.msg.is_empty() {\n            f.write_str(self.msg)\n        } else {\n            crate::fmt::Display::fmt(&self.kind, f)\n        }\n    }\n}\n\n// mvs: Error::impl Debug, IoError::impl Debug\nimpl Debug for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.debug_struct(\"Os\")\n                .field(\"code\", &self.code)\n                .field(\"kind\", &self.kind)\n                .field(\"message\", &os_message(self.code))\n                .finish()\n        } else if !self.msg.is_empty() {\n            f.debug_struct(\"Custom\").field(\"kind\", &self.kind).field(\"error\", &self.msg).finish()\n        } else {\n            f.debug_tuple(\"Kind\").field(&self.kind).finish()\n        }\n    }\n}\n\nimpl From<ErrorKind> for Error {\n    fn from(k: ErrorKind) -> Error {\n        Error::new(k, \"\")\n    }\n}\n\n// The ErrorKind of an errno (macOS's numbers; Linux's differ above 34 and\n// come with the sys tail).\nfn kind_of_errno(code: i32) -> ErrorKind {\n    match code {\n        1 | 13 => ErrorKind::PermissionDenied,\n        2 => ErrorKind::NotFound,\n        4 => ErrorKind::Interrupted,\n        12 => ErrorKind::OutOfMemory,\n        17 => ErrorKind::AlreadyExists,\n        20 => ErrorKind::NotADirectory,\n        21 => ErrorKind::IsADirectory,\n        22 => ErrorKind::InvalidInput,\n        32 => ErrorKind::BrokenPipe,\n        35 => ErrorKind::WouldBlock,\n        45 | 78 => ErrorKind::Unsupported,\n        60 => ErrorKind::TimedOut,\n        63 => ErrorKind::InvalidFilename,\n        66 => ErrorKind::DirectoryNotEmpty,\n");
    buf_str(out, c"        _ => ErrorKind::Other,\n    }\n}\n\n// The OS's text for an errno (C's strerror), or \"\" when it is not UTF-8.\nfn os_message(code: i32) -> &'static str {\n    // UNSAFE: strerror's C string, read through its raw pointer.\n    // SAFETY: strerror returns a NUL-terminated string that lives as long\n    // as the process (macOS's table; the bytes up to the NUL are read, no\n    // further).\n    unsafe {\n        let p = strerror(code);\n        let mut n: usize = 0;\n        while *p.add(n) != 0 {\n            n += 1;\n        }\n        match crate::str::from_utf8(crate::slice::from_raw_parts(p, n)) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n}\n\n// What a read appended to v from start: kept when it is UTF-8, cut off\n// with InvalidData when not (read_to_string's and read_line's check).\nfn append_utf8<A: Allocator>(v: &mut Vec<u8, A>, start: usize, r: Result<usize>) -> Result<usize> {\n    if crate::str::from_utf8(&v.as_slice()[start..]).is_err() {\n        v.truncate(start);\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidData,\n            \"stream did not contain valid UTF-8\"));\n    }\n    r\n}\n\n// Write::write_fmt's sink: a fmt::Write over an io::Write that keeps the\n// io::Error a write gave (fmt::Error carries nothing).\nstruct Adapter<'a, W: ?Sized> {\n    inner: &'a mut W,\n    error: Result<()>,\n}\n\nimpl<'a, W: Write + ?Sized> crate::fmt::Write for Adapter<'a, W> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        match self.inner.write_all(s.as_bytes()) {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(e) => {\n                self.error = crate::result::Result::Err(e);\n                crate::result::Result::Err(crate::fmt::Error {})\n            }\n        }\n    }\n}\n\n// UNSAFE: the OS's calls under the standard streams and io::Error.\n");
    buf_str(out, c"// SAFETY: read and write take a buffer of n bytes they may read or fill;\n// __error returns this thread's errno; strerror a static C string. The\n// callers below pass slices' pointers and lengths.\nextern \"C\" {\n    #[link_name = \"read\"]\n    fn c_read(fd: i32, buf: *mut u8, n: usize) -> isize;\n    #[link_name = \"write\"]\n    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;\n    fn __error() -> *mut i32;\n    fn strerror(code: i32) -> *const u8;\n}\n\n// Up to buf.len() bytes from fd.\n#[effects(io, static, unsafe)]\npub(crate) fn sys_read(fd: i32, buf: &mut [u8]) -> Result<usize> {\n    // UNSAFE: the OS's read.\n    // SAFETY: buf's pointer and length are a writable region of buf.len()\n    // bytes, borrowed for the call.\n    let n = unsafe { c_read(fd, buf.as_mut_ptr(), buf.len()) };\n    if n < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(n as usize)\n    }\n}\n\n// Some of buf to fd.\n#[effects(io, static, unsafe)]\npub(crate) fn sys_write(fd: i32, buf: &[u8]) -> Result<usize> {\n    // UNSAFE: the OS's write.\n    // SAFETY: buf's pointer and length are a readable region of buf.len()\n    // bytes, borrowed for the call.\n    let n = unsafe { c_write(fd, buf.as_ptr(), buf.len()) };\n    if n < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(n as usize)\n    }\n}\n\n// All of buf to fd, a standard stream's (Stdout's and Stderr's write_all:\n// Write's default, on the descriptor).\n// terminates: every pass writes at least one byte of buf or returns, but\n// for a write a signal interrupted, which is made again; signals are the\n// OS's, and no program is sent them without end.\n#[terminates]\nfn fd_write_all(fd: i32, buf: &[u8]) -> Result<()> {\n    let mut buf = buf;\n    while !buf.is_empty() {\n        match sys_write(fd, buf) {\n            crate::result::Result::Ok(0) => {\n");
    buf_str(out, c"                return crate::result::Result::Err(Error::new(ErrorKind::WriteZero,\n                    \"failed to write whole buffer\"));\n            }\n            crate::result::Result::Ok(n) => buf = &buf[n..],\n            crate::result::Result::Err(e) => {\n                if e.kind() != ErrorKind::Interrupted {\n                    return crate::result::Result::Err(e);\n                }\n            }\n        }\n    }\n    crate::result::Result::Ok(())\n}\n\n// What kind of failure, as Rust's (the ones vole's OS calls give).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum ErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    InvalidFilename,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\nimpl Display for ErrorKind {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(match *self {\n            ErrorKind::NotFound => \"entity not found\",\n            ErrorKind::PermissionDenied => \"permission denied\",\n            ErrorKind::AlreadyExists => \"entity already exists\",\n            ErrorKind::WouldBlock => \"operation would block\",\n            ErrorKind::InvalidInput => \"invalid input parameter\",\n            ErrorKind::InvalidData => \"invalid data\",\n            ErrorKind::TimedOut => \"timed out\",\n            ErrorKind::WriteZero => \"write zero\",\n            ErrorKind::Interrupted => \"operation interrupted\",\n            ErrorKind::UnexpectedEof => \"unexpected end of file\",\n            ErrorKind::BrokenPipe => \"broken pipe\",\n            ErrorKind::NotADirectory => \"not a directory\",\n            ErrorKind::IsADirectory => \"is a directory\",\n            ErrorKind::DirectoryNotEmpty => \"directory not empty\",\n");
    buf_str(out, c"            ErrorKind::InvalidFilename => \"invalid filename\",\n            ErrorKind::Unsupported => \"unsupported\",\n            ErrorKind::OutOfMemory => \"out of memory\",\n            ErrorKind::Other => \"other error\",\n        })\n    }\n}\n\n// Where Seek::seek moves to: an offset from the start, the end or the\n// position now.\n// std2: changed: std::io's, as Rust's (MVS: std::fs's); Start is a u64\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum SeekFrom {\n    Start(u64),\n    End(i64),\n    Current(i64),\n}\n\n// A stream with a position that can move (a File).\npub trait Seek {\n    // Moves the position; the new one, from the start.\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64>;\n\n    // Back to the start.\n    fn rewind(&mut self) -> Result<()> {\n        self.seek(SeekFrom::Start(0))?;\n        crate::result::Result::Ok(())\n    }\n\n    // The position, from the start.\n    fn stream_position(&mut self) -> Result<u64> {\n        self.seek(SeekFrom::Current(0))\n    }\n}\n\n// A source of bytes.\npub trait Read {\n    // Up to buf.len() bytes into buf; how many (0 at the end).\n    // std2: changed: &mut [u8], a usize\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize>;\n\n    // Exactly buf.len() bytes, or UnexpectedEof.\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        let mut buf = buf;\n        while !buf.is_empty() {\n            match self.read(buf) {\n                crate::result::Result::Ok(0) => {\n                    return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                        \"failed to fill whole buffer\"));\n                }\n                crate::result::Result::Ok(n) => {\n                    let rest = buf;\n                    buf = &mut rest[n..];\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n");
    buf_str(out, c"                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(())\n    }\n\n    // Everything left, appended to buf (grown from buf's allocator).\n    // std2: changed: a usize\n    fn read_to_end<A: Allocator>(&mut self, buf: &mut Vec<u8, A>) -> Result<usize> {\n        let start = buf.len();\n        let mut chunk = [0u8; 4096];\n        loop {\n            match self.read(&mut chunk) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(n) => buf.extend_from_slice(&chunk[..n]),\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(buf.len() - start)\n    }\n\n    // Everything left, appended to buf; InvalidData when it is not UTF-8.\n    // std2: changed: a usize\n    fn read_to_string<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8, so the String is UTF-8 whenever it is used.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let r = self.read_to_end(v);\n        append_utf8(v, start, r)\n    }\n\n    // The reader borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A sink of bytes.\npub trait Write {\n    // Some of buf; how much was written.\n    // std2: changed: &[u8], a usize\n    fn write(&mut self, buf: &[u8]) -> Result<usize>;\n\n    // Whatever is buffered, out to its destination.\n    fn flush(&mut self) -> Result<()>;\n\n    // All of buf (write until it is written, or an error).\n");
    buf_str(out, c"    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        let mut buf = buf;\n        while !buf.is_empty() {\n            match self.write(buf) {\n                crate::result::Result::Ok(0) => {\n                    return crate::result::Result::Err(Error::new(ErrorKind::WriteZero,\n                        \"failed to write whole buffer\"));\n                }\n                crate::result::Result::Ok(n) => buf = &buf[n..],\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(())\n    }\n\n    // x as its Display shows it (the compiler's `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result<()> {\n        let mut out = Adapter { inner: self, error: crate::result::Result::Ok(()) };\n        let r = {\n            let mut f = Formatter::new(&mut out);\n            crate::fmt::Display::fmt(&x, &mut f)\n        };\n        match r {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(_) => match out.error {\n                crate::result::Result::Err(e) => crate::result::Result::Err(e),\n                crate::result::Result::Ok(()) => {\n                    crate::result::Result::Err(Error::new(ErrorKind::Other, \"formatter error\"))\n                }\n            },\n        }\n    }\n\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A reader with a buffer: lines and delimited reads.\npub trait BufRead: Read {\n    // The buffered bytes, refilled when empty (empty at the end).\n    // std2: changed: returns &[u8]\n    fn fill_buf(&mut self) -> Result<&[u8]>;\n\n    // Marks n buffered bytes as read.\n    // std2: changed: n is usize\n    fn consume(&mut self, n: usize);\n\n");
    buf_str(out, c"    // The bytes up to and including delim (or the end), appended to buf.\n    // mvs: BufReader::read_until\n    fn read_until<A: Allocator>(&mut self, delim: u8, buf: &mut Vec<u8, A>) -> Result<usize> {\n        let mut read: usize = 0;\n        loop {\n            let (done, used) = {\n                let available = match self.fill_buf() {\n                    crate::result::Result::Ok(b) => b,\n                    crate::result::Result::Err(e) => {\n                        if e.kind() == ErrorKind::Interrupted {\n                            continue;\n                        }\n                        return crate::result::Result::Err(e);\n                    }\n                };\n                // (0.29: the delimiter found by the bytes' block search)\n                let i = match available.find_byte(delim) {\n                    crate::option::Option::Some(i) => i,\n                    crate::option::Option::None => available.len(),\n                };\n                if i < available.len() {\n                    buf.extend_from_slice(&available[..i + 1]);\n                    (true, i + 1)\n                } else {\n                    buf.extend_from_slice(available);\n                    (false, available.len())\n                }\n            };\n            self.consume(used);\n            read += used;\n            if done || used == 0 {\n                return crate::result::Result::Ok(read);\n            }\n        }\n    }\n\n    // A line, its \"\\n\" included, appended to buf; 0 at the end.\n    // mvs: BufReader::read_line, read_line\n    // std2: changed: BufRead's, a usize (MVS: a free function's bool, BufReader's i64)\n    fn read_line<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n");
    buf_str(out, c"        let start = v.len();\n        let r = self.read_until(10, v);\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a, without its \"\\n\".\n    // mvs: BufReader::lines_in\n    fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<Self, A>\n        where\n            Self: Sized,\n    {\n        Lines { buf: self, alloc: a }\n    }\n}\n\n// BufRead::lines_in's iterator: each line a String<A>, or an error.\n// mvs: Lines\npub struct Lines<B, A: Allocator> {\n    buf: B,\n    alloc: A,\n}\n\n// mvs: Lines::impl Iterator\nimpl<B: BufRead, A: Allocator + Clone> Iterator for Lines<B, A> {\n    type Item = Result<String<A>>;\n\n    fn next(&mut self) -> Option<Result<String<A>>> {\n        let mut s = String::new_in(self.alloc.clone());\n        match self.buf.read_line(&mut s) {\n            crate::result::Result::Ok(0) => Option::None,\n            crate::result::Result::Ok(_) => {\n                let nl: &str = \"\\n\";\n                let cr: &str = \"\\r\";\n                if s.ends_with(nl) {\n                    s.pop();\n                    if s.ends_with(cr) {\n                        s.pop();\n                    }\n                }\n                Option::Some(crate::result::Result::Ok(s))\n            }\n            crate::result::Result::Err(e) => Option::Some(crate::result::Result::Err(e)),\n        }\n    }\n}\n\n// A Read with a buffer of its own (8 KiB, inline: no allocation).\npub struct BufReader<R> {\n    inner: R,\n    buf: [u8; 8192],\n    pos: usize,\n    filled: usize,\n}\n\nimpl<R: Read> BufReader<R> {\n    #[effects()]\n    pub fn new(inner: R) -> BufReader<R> {\n        BufReader { inner: inner, buf: [0; 8192], pos: 0, filled: 0 }\n    }\n}\n\nimpl<R> BufReader<R> {\n    #[effects()]\n    pub fn get_ref(&self) -> &R {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut R {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not read yet.\n");
    buf_str(out, c"    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[self.pos..self.filled]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The reader, the buffered bytes dropped.\n    #[effects()]\n    pub fn into_inner(self) -> R {\n        self.inner\n    }\n}\n\nimpl<R: Read> Read for BufReader<R> {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        // A read as large as the buffer, with nothing buffered, skips it.\n        if self.pos == self.filled && buf.len() >= 8192 {\n            return self.inner.read(buf);\n        }\n        let n = {\n            let rem = self.fill_buf()?;\n            let n = crate::cmp::min(rem.len(), buf.len());\n            buf[..n].copy_from_slice(&rem[..n]);\n            n\n        };\n        self.consume(n);\n        crate::result::Result::Ok(n)\n    }\n}\n\nimpl<R: Read> BufRead for BufReader<R> {\n    fn fill_buf(&mut self) -> Result<&[u8]> {\n        if self.pos >= self.filled {\n            let n = self.inner.read(&mut self.buf)?;\n            self.filled = n;\n            self.pos = 0;\n        }\n        crate::result::Result::Ok(&self.buf[self.pos..self.filled])\n    }\n\n    fn consume(&mut self, n: usize) {\n        self.pos = crate::cmp::min(self.pos + n, self.filled);\n    }\n}\n\n// A Write with a buffer of its own (8 KiB, inline), flushed when full,\n// on flush and when dropped.\npub struct BufWriter<W: Write> {\n    inner: W,\n    buf: [u8; 8192],\n    len: usize,\n}\n\nimpl<W: Write> BufWriter<W> {\n    #[effects()]\n    pub fn new(inner: W) -> BufWriter<W> {\n        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n    }\n\n    #[effects()]\n    pub fn get_ref(&self) -> &W {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut W {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not written yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[..self.len]\n");
    buf_str(out, c"    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The writer, after a flush; the error and the BufWriter if it failed.\n    // std2: changed: a Result (Rust's)\n    #[effects(unsafe, W)]\n    pub fn into_inner(self) -> crate::result::Result<W, IntoInnerError<BufWriter<W>>> {\n        let mut me = self;\n        match me.flush_buf() {\n            crate::result::Result::Err(e) => {\n                crate::result::Result::Err(IntoInnerError { writer: me, error: e })\n            }\n            crate::result::Result::Ok(()) => {\n                // UNSAFE: the writer is moved out of a type with a Drop,\n                // which is then forgotten (Rust's into_inner does the same).\n                // SAFETY: me is forgotten right after, so its inner is not\n                // dropped twice, and its buffer is empty (flushed): its drop\n                // would only flush nothing.\n                let inner = unsafe { crate::ptr::read(&me.inner) };\n                crate::mem::forget(me);\n                crate::result::Result::Ok(inner)\n            }\n        }\n    }\n}\n\nimpl<W: Write> BufWriter<W> {\n    // The buffer written out to the inner writer, then emptied.\n    fn flush_buf(&mut self) -> Result<()> {\n        let n = self.len;\n        self.inner.write_all(&self.buf[..n])?;\n        self.len = 0;\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl<W: Write> Write for BufWriter<W> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        if self.len + buf.len() > 8192 {\n            self.flush_buf()?;\n        }\n        if buf.len() >= 8192 {\n            return self.inner.write(buf);\n        }\n        let n = buf.len();\n        self.buf[self.len..self.len + n].copy_from_slice(buf);\n        self.len += n;\n        crate::result::Result::Ok(n)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        self.flush_buf()?;\n        self.inner.flush()\n    }\n}\n\n");
    buf_str(out, c"impl<W: Write> crate::ops::Drop for BufWriter<W> {\n    fn drop(&mut self) {\n        let _ = self.flush();\n    }\n}\n\n// `BufWriter { writer: .., buffer: 3/8192 }`, as Rust's.\nimpl<W: Write + Debug> Debug for BufWriter<W> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"BufWriter\")\n            .field(\"writer\", &self.inner)\n            .field(\"buffer\", &Filled { len: self.len, cap: 8192 })\n            .finish()\n    }\n}\n\n// A buffer's fill as `len/cap`.\nstruct Filled {\n    len: usize,\n    cap: usize,\n}\n\nimpl Debug for Filled {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.len, f)?;\n        f.write_str(\"/\")?;\n        Debug::fmt(&self.cap, f)\n    }\n}\n\n// BufWriter::into_inner's error: the flush's error and the writer.\n#[derive(Debug)]\npub struct IntoInnerError<W> {\n    writer: W,\n    error: Error,\n}\n\nimpl<W> IntoInnerError<W> {\n    #[effects()]\n    pub fn error(&self) -> &Error {\n        &self.error\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> W {\n        self.writer\n    }\n}\n\n// The process's standard input (fd 0), buffered.\npub struct Stdin {\n    fd: i32,\n}\n\n// The process's stdin.\n#[effects()]\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\nimpl Stdin {\n    // A line, its \"\\n\" included, appended to buf; 0 at the end of input.\n    // mvs: read_line\n    // std2: changed: Stdin's, returns the bytes read (MVS: a free function, a bool)\n    #[effects(io, static, diverge, unsafe, A)]\n    pub fn read_line<A: Allocator>(&self, buf: &mut String<A>) -> Result<usize> {\n        // A byte at a time up to \"\\n\": Stdin keeps no buffer, so nothing\n        // after the line is taken from fd 0.\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n");
    buf_str(out, c"        let start = v.len();\n        let mut b = [0u8; 1];\n        let mut r: Result<usize> = crate::result::Result::Ok(0);\n        loop {\n            match sys_read(self.fd, &mut b) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(_) => {\n                    v.push(b[0]);\n                    if b[0] == 10 {\n                        break;\n                    }\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        r = crate::result::Result::Err(e);\n                        break;\n                    }\n                }\n            }\n        }\n        // (annotated: an arm's Ok gives no E, FL1)\n        let r: Result<usize> = match r {\n            crate::result::Result::Ok(_) => crate::result::Result::Ok(v.len() - start),\n            crate::result::Result::Err(e) => crate::result::Result::Err(e),\n        };\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a.\n    #[effects(A)]\n    pub fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<BufReader<Stdin>, A> {\n        BufReader::new(self).lines_in(a)\n    }\n}\n\nimpl Read for Stdin {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        sys_read(self.fd, buf)\n    }\n}\n\n// The process's standard output (fd 1): line-buffered on a terminal,\n// block-buffered otherwise, flushed at exit.\npub struct Stdout {\n    fd: i32,\n}\n\n#[effects()]\npub fn stdout() -> Stdout {\n    Stdout { fd: 1 }\n}\n\nimpl Write for Stdout {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        // Written through (no buffer yet: the sys tail's line buffering\n        // comes with the embedded std, 0.27.2's M3).\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n");
    buf_str(out, c"        fd_write_all(self.fd, buf)\n    }\n}\n\n// The process's standard error (fd 2), unbuffered.\npub struct Stderr {\n    fd: i32,\n}\n\n#[effects()]\npub fn stderr() -> Stderr {\n    Stderr { fd: 2 }\n}\n\nimpl Write for Stderr {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        fd_write_all(self.fd, buf)\n    }\n}\n\n// Everything r has left, as a String on a (Rust's io::read_to_string).\n// mvs: read_stdin_in\n// std2: changed: any reader, a String (MVS: stdin's bytes as a Vec)\n#[effects(R, A)]\npub fn read_to_string_in<R: Read, A: Allocator>(r: R, a: A) -> Result<String<A>> {\n    let mut r = r;\n    let mut s = String::new_in(a);\n    r.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// Everything from r, written to w; how many bytes.\n#[effects(panic, diverge, R, W)]\npub fn copy<R: Read + ?Sized, W: Write + ?Sized>(r: &mut R, w: &mut W) -> Result<u64> {\n    let mut buf = [0u8; 8192];\n    let mut total: u64 = 0;\n    loop {\n        let n = match r.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        w.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// A reader with nothing in it.\n#[effects()]\npub fn empty() -> Empty {\n    Empty {}\n}\n\npub struct Empty {}\n\nimpl Read for Empty {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::result::Result::Ok(0)\n    }\n}\n\n// A writer that drops what it is given.\n#[effects()]\npub fn sink() -> Sink {\n    Sink {}\n");
    buf_str(out, c"}\n\npub struct Sink {}\n\nimpl Write for Sink {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A &mut of a reader or writer is one.\nimpl<R: Read + ?Sized> Read for &mut R {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        (**self).read(buf)\n    }\n}\n\nimpl<W: Write + ?Sized> Write for &mut W {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        (**self).write(buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        (**self).flush()\n    }\n}\n\n// Bytes in memory as a reader (`Read for &[u8]`).\nimpl Read for &[u8] {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        let n = crate::cmp::min(buf.len(), self.len());\n        let (a, b) = self.split_at(n);\n        buf[..n].copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(n)\n    }\n\n    // All of buf, or UnexpectedEof with buf untouched and the slice used up\n    // (Rust's).\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        if buf.len() > self.len() {\n            *self = &self[self.len()..];\n            return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                \"failed to fill whole buffer\"));\n        }\n        let (a, b) = self.split_at(buf.len());\n        buf.copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(())\n    }\n}\n\n// A Vec<u8, A> as a writer: write grows it from A.\nimpl<A: Allocator> Write for Vec<u8, A> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        self.extend_from_slice(buf);\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n// ---- end mod std::io ----\n}\n// ---- mod std::fs ----\npub mod fs {\n");
    buf_str(out, c"// std::fs: files and directories, Rust's. A path is a `P: AsRef<str>`\n// (Rust's `AsRef<Path>`: a &str, a &String, a std::path::Path or a\n// &PathBuf; 0.28.0, std::path's named divergence); it reaches C as a NUL-ended copy on the stack, so nothing here allocates\n// but what returns a Vec or a String, on the allocator given. A path that\n// holds a NUL is InvalidInput, one longer than the system's PATH_MAX the\n// OS's ENAMETOOLONG (Rust passes it to the OS, which says the same).\n// mvs: std::fs\n\nuse crate::alloc::Allocator;\nuse crate::convert::AsRef;\nuse crate::io::{Error, ErrorKind, Read, Result, Seek, SeekFrom, Write};\nuse crate::iter::Iterator;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::time::SystemTime;\nuse crate::vec::Vec;\n\n// UNSAFE: the OS's file and directory calls, which take NUL-ended paths\n// and buffers as raw pointers.\n// SAFETY: POSIX's prototypes (fcntl.h, unistd.h, sys/stat.h, dirent.h,\n// stdio.h); open's mode is variadic, as declared. The callers pass a\n// CPath's buffer (NUL-ended), a StatBuf's words (larger than either\n// system's struct stat) and a DIR * that opendir returned.\nextern \"C\" {\n    #[link_name = \"open\"]\n    fn fs_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn fs_c_close(fd: i32) -> i32;\n    #[link_name = \"lseek\"]\n    fn fs_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn fs_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    fn fs_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fchmod\"]\n    #[effects(io)]\n    fn fs_c_fchmod(fd: i32, mode: u32) -> i32;\n    #[link_name = \"fstat\"]\n    fn fs_c_fstat(fd: i32, buf: *mut u64) -> i32;\n    #[link_name = \"stat\"]\n    fn fs_c_stat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"lstat\"]\n    #[effects(io)]\n    fn fs_c_lstat(path: *const u8, buf: *mut u64) -> i32;\n");
    buf_str(out, c"    #[link_name = \"mkdir\"]\n    fn fs_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    fn fs_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    fn fs_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    fn fs_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"opendir\"]\n    #[effects(io)]\n    fn fs_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    #[effects(io)]\n    fn fs_c_readdir(dir: *mut u8) -> *const u8;\n    #[link_name = \"closedir\"]\n    #[effects(io)]\n    fn fs_c_closedir(dir: *mut u8) -> i32;\n}\n\nconst O_RDONLY: i32 = 0;\nconst O_WRONLY: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst S_IFMT: u32 = 0xf000;\nconst S_IFDIR: u32 = 0x4000;\nconst S_IFREG: u32 = 0x8000;\nconst S_IFLNK: u32 = 0xa000;\nconst DT_DIR: u8 = 4;\nconst DT_REG: u8 = 8;\nconst DT_LNK: u8 = 10;\nconst EINVAL: i32 = 22;\n\n// A path and its NUL, as C takes it.\nstruct CPath {\n    buf: [u8; crate::__sys::PATH_MAX],\n}\n\nimpl CPath {\n    fn ptr(&self) -> *const u8 {\n        &self.buf[0] as *const u8\n    }\n}\n\n// path as C takes it: InvalidInput when it holds a NUL, ENAMETOOLONG when\n// it does not fit.\nfn cpath(path: &str) -> Result<CPath> {\n    let b = path.as_bytes();\n    let mut p = CPath { buf: [0u8; crate::__sys::PATH_MAX] };\n    if b.len() >= p.buf.len() {\n        return crate::result::Result::Err(Error::from_raw_os_error(crate::__sys::ENAMETOOLONG));\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 {\n            return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n                \"file name contained an unexpected NUL byte\"));\n        }\n        p.buf[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(p)\n}\n\n// A C call's -1 as the io::Error errno says.\nfn cvt(r: i32) -> Result<()> {\n    if r < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n");
    buf_str(out, c"        crate::result::Result::Ok(())\n    }\n}\n\nfn open_c(path: &str, flags: i32, mode: u32) -> Result<File> {\n    let p = cpath(path)?;\n    // UNSAFE: C's open. SAFETY: p is NUL-ended and lives past the call;\n    // the mode is the variadic int open reads when it creates the file.\n    let fd = unsafe { fs_c_open(p.ptr(), flags | crate::__sys::O_CLOEXEC, mode as i32) };\n    if fd < 0 {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    crate::result::Result::Ok(File { fd: fd })\n}\n\n// Room for either system's struct stat (144 bytes on macOS, 128 on Linux).\nstruct StatBuf {\n    words: [u64; 20],\n}\n\nfn metadata_of(b: &StatBuf) -> Metadata {\n    let (mode, size, mtime, mtime_nsec) = crate::__sys::stat_fields(&b.words);\n    Metadata { mode: mode, size: size, mtime: mtime, mtime_nsec: mtime_nsec }\n}\n\n// stat, or lstat (follow false), of the file at path.\nfn stat_at(path: &str, follow: bool) -> Result<Metadata> {\n    let p = cpath(path)?;\n    let mut b = StatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat and lstat. SAFETY: p is NUL-ended; b.words is 160\n    // bytes, 8-aligned, more than either system's struct stat.\n    let r = unsafe {\n        if follow {\n            fs_c_stat(p.ptr(), &mut b.words[0] as *mut u64)\n        } else {\n            fs_c_lstat(p.ptr(), &mut b.words[0] as *mut u64)\n        }\n    };\n    cvt(r)?;\n    crate::result::Result::Ok(metadata_of(&b))\n}\n\n// ---- Files ----\n\n// An open file; dropping it closes it.\npub struct File {\n    fd: i32,\n}\n\nimpl Drop for File {\n    fn drop(&mut self) {\n        // UNSAFE: C's close. SAFETY: fd is this File's own descriptor,\n        // closed once (here).\n        let _ = unsafe { fs_c_close(self.fd) };\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    #[effects(io, static, panic, diverge)]\n    pub fn open<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDONLY, 0x1b6)\n    }\n");
    buf_str(out, c"\n    // Opens path for writing: made when it is not there, emptied when it is.\n    #[effects(io, static, panic, diverge)]\n    pub fn create<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC, 0x1b6)\n    }\n\n    // Makes path and opens it for reading and writing: AlreadyExists when\n    // it is there.\n    #[effects(io, static, panic, diverge)]\n    pub fn create_new<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDWR | crate::__sys::O_CREAT | crate::__sys::O_EXCL, 0x1b6)\n    }\n\n    // The options to open a file with: `File::options().append(true)`.\n    #[effects()]\n    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    // std2: changed: File's own (Rust's: std::os::fd::AsRawFd)\n    #[effects()]\n    pub fn as_raw_fd(&self) -> i32 {\n        self.fd\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        let mut b = StatBuf { words: [0u64; 20] };\n        // UNSAFE: C's fstat. SAFETY: b.words as in stat_at.\n        cvt(unsafe { fs_c_fstat(self.fd, &mut b.words[0] as *mut u64) })?;\n        crate::result::Result::Ok(metadata_of(&b))\n    }\n\n    // Its length becomes size (cut, or zeros after).\n    // std2: changed: u64 (MVS: i64)\n    #[effects(io, static, unsafe)]\n    pub fn set_len(&self, size: u64) -> Result<()> {\n        if size > i64::MAX as u64 {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        // UNSAFE: C's ftruncate. SAFETY: integers only.\n        cvt(unsafe { fs_c_ftruncate(self.fd, size as i64) })\n    }\n\n    // What the system holds of it, written to the disk.\n    #[effects(io, static, unsafe)]\n    pub fn sync_all(&self) -> Result<()> {\n        // UNSAFE: C's fsync. SAFETY: an int only.\n");
    buf_str(out, c"        cvt(unsafe { fs_c_fsync(self.fd) })\n    }\n}\n\n// `File { fd: 3 }`.\n// std2: changed: the descriptor only (Rust's adds the path and the mode)\nimpl crate::fmt::Debug for File {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"File\").field(\"fd\", &self.fd).finish()\n    }\n}\n\nimpl Read for File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Write for File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A shared File reads and writes too (the OS keeps its position).\nimpl Read for &File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read((*self).fd, buf)\n    }\n}\n\nimpl Write for &File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write((*self).fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// mvs: File::seek\nimpl Seek for File {\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64> {\n        let (off, whence) = match pos {\n            SeekFrom::Start(o) => {\n                if o > i64::MAX as u64 {\n                    return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n                }\n                (o as i64, 0)\n            }\n            SeekFrom::Current(o) => (o, 1),\n            SeekFrom::End(o) => (o, 2),\n        };\n        // UNSAFE: C's lseek. SAFETY: integers only.\n        let r = unsafe { fs_c_lseek(self.fd, off, whence) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(r as u64)\n    }\n}\n\n// How File::open opens a file, Rust's builder:\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n");
    buf_str(out, c"#[derive(Clone, Debug)]\npub struct OpenOptions {\n    read: bool,\n    write: bool,\n    append: bool,\n    truncate: bool,\n    create: bool,\n    create_new: bool,\n    mode: u32,\n}\n\nimpl OpenOptions {\n    // Every option off (open fails until read, write or append is on).\n    #[effects()]\n    pub fn new() -> OpenOptions {\n        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn read(&mut self, read: bool) -> &mut OpenOptions {\n        self.read = read;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn write(&mut self, write: bool) -> &mut OpenOptions {\n        self.write = write;\n        self\n    }\n\n    // Writes go to the end (write is implied).\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn append(&mut self, append: bool) -> &mut OpenOptions {\n        self.append = append;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {\n        self.truncate = truncate;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create(&mut self, create: bool) -> &mut OpenOptions {\n        self.create = create;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {\n        self.create_new = create_new;\n        self\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    // std2: changed: OpenOptions' own, a u32 (Rust's:\n    // std::os::unix::fs::OpenOptionsExt)\n    #[effects()]\n    pub fn mode(&mut self, mode: u32) -> &mut OpenOptions {\n");
    buf_str(out, c"        self.mode = mode;\n        self\n    }\n\n    // Opens path with these options: InvalidInput (EINVAL) for none of\n    // read, write and append, or a create or truncate without a write, as\n    // Rust's.\n    #[effects(io, static, panic, diverge)]\n    pub fn open<P: AsRef<str>>(&self, path: P) -> Result<File> {\n        let path = path.as_ref();\n        let access = if self.append {\n            (if self.read { O_RDWR } else { O_WRONLY }) | crate::__sys::O_APPEND\n        } else if self.read && self.write {\n            O_RDWR\n        } else if self.write {\n            O_WRONLY\n        } else if self.read {\n            O_RDONLY\n        } else {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        };\n        if !self.write && !self.append && (self.truncate || self.create || self.create_new) {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        if self.append && self.truncate && !self.create_new {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        let creation = if self.create_new {\n            crate::__sys::O_CREAT | crate::__sys::O_EXCL\n        } else {\n            (if self.create { crate::__sys::O_CREAT } else { 0 })\n                | (if self.truncate { crate::__sys::O_TRUNC } else { 0 })\n        };\n        open_c(path, access | creation, self.mode)\n    }\n}\n\n// What stat says of a file.\n#[derive(Clone)]\npub struct Metadata {\n    mode: u32,\n    size: u64,\n    mtime: i64,\n    mtime_nsec: i64,\n}\n\nimpl Metadata {\n    // The size in bytes.\n    #[effects()]\n    pub fn len(&self) -> u64 {\n        self.size\n    }\n\n    #[effects()]\n    pub fn file_type(&self) -> FileType {\n        FileType { fmt: self.mode & S_IFMT }\n    }\n\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.mode & S_IFMT == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n");
    buf_str(out, c"        self.mode & S_IFMT == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.mode & S_IFMT == S_IFLNK\n    }\n\n    #[effects()]\n    pub fn permissions(&self) -> Permissions {\n        Permissions { mode: self.mode }\n    }\n\n    // When it was last written (UNIX_EPOCH for a time before it).\n    // mvs: Metadata::modified\n    // std2: changed: an io::Result<SystemTime>, as Rust's (MVS: a\n    // Duration since the epoch)\n    #[effects(panic)]\n    pub fn modified(&self) -> Result<SystemTime> {\n        let epoch = crate::time::UNIX_EPOCH;\n        if self.mtime < 0 {\n            return crate::result::Result::Ok(epoch);\n        }\n        let d = crate::time::Duration::new(self.mtime as u64, self.mtime_nsec as u32);\n        match epoch.checked_add(d) {\n            Option::Some(t) => crate::result::Result::Ok(t),\n            Option::None => crate::result::Result::Ok(epoch),\n        }\n    }\n}\n\n// `Metadata { file_type: .., len: 6, .. }`.\n// std2: changed: the kind and the length (Rust's adds the permissions and\n// the times)\nimpl crate::fmt::Debug for Metadata {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Metadata\").field(\"file_type\", &self.file_type()).field(\"len\", &self.size)\n            .finish_non_exhaustive()\n    }\n}\n\n// A file's kind: a directory, a file, a symbolic link (or another).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct FileType {\n    fmt: u32,\n}\n\nimpl FileType {\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.fmt == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.fmt == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.fmt == S_IFLNK\n    }\n}\n\n// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as\n// Rust's.\nimpl crate::fmt::Debug for FileType {\n");
    buf_str(out, c"    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"FileType\").field(\"is_file\", &self.is_file()).field(\"is_dir\", &self.is_dir())\n            .field(\"is_symlink\", &self.is_symlink()).finish_non_exhaustive()\n    }\n}\n\n// A file's permission bits.\n#[derive(Clone, PartialEq, Eq)]\npub struct Permissions {\n    mode: u32,\n}\n\nimpl Permissions {\n    // Whether no one may write it.\n    #[effects()]\n    pub fn readonly(&self) -> bool {\n        self.mode & 0x92 == 0\n    }\n\n    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).\n    // mvs: Metadata::mode\n    // std2: changed: Permissions' own, st_mode as Rust's (Rust's:\n    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)\n    #[effects()]\n    pub fn mode(&self) -> u32 {\n        self.mode\n    }\n}\n\n// ---- Whole files ----\n\n// The bytes of the file at path, in a new Vec on a.\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<Vec<u8, A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let size = match f.metadata() {\n        crate::result::Result::Ok(m) => m.len() as usize,\n        crate::result::Result::Err(_) => 0,\n    };\n    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);\n    f.read_to_end(&mut v)?;\n    crate::result::Result::Ok(v)\n}\n\n// The text of the file at path, in a new String on a (InvalidData when it\n// is not UTF-8).\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read_to_string)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_to_string_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<String<A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let mut s = String::new_in(a);\n    f.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n");
    buf_str(out, c"\n// The file at path holds contents: made, or emptied first.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P, C)]\npub fn write<P: AsRef<str>, C: AsRef<[u8]>>(path: P, contents: C) -> Result<()> {\n    let path = path.as_ref();\n    let mut f = File::create(path)?;\n    // (the path call: `contents.as_ref()` where a &[u8] is expected picks\n    // a wrong instance of AsRef for &T, 0.27.5's front gap)\n    f.write_all(AsRef::<[u8]>::as_ref(&contents))\n}\n\n// Copies the file at from to to (made, or emptied), its permission bits\n// too: the bytes copied.\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>); a u64 (MVS: i64)\n#[effects(io, static, panic, diverge, unsafe, P, Q)]\npub fn copy<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<u64> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let mut src = File::open(from)?;\n    let m = src.metadata()?;\n    if !m.is_file() {\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n            \"the source path is neither a regular file nor a symlink to a regular file\"));\n    }\n    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,\n        m.mode & 0xfff)?;\n    // UNSAFE: C's fchmod. SAFETY: integers only.\n    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;\n    let mut buf = [0u8; 65536];\n    let mut total: u64 = 0;\n    loop {\n        let n = match src.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        dst.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n");
    buf_str(out, c"// What stat says of the file at path (through a symbolic link).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, true)\n}\n\n// As metadata, of a symbolic link itself.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn symlink_metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, false)\n}\n\n// Whether something is at path (through a symbolic link): Ok(false) when\n// nothing is, an error when the OS cannot say (Rust's fs::exists).\n// std2: changed: an io::Result<bool>, as Rust's (MVS: a bool); the path an\n// AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn exists<P: AsRef<str>>(path: P) -> Result<bool> {\n    let path = path.as_ref();\n    match stat_at(path, true) {\n        crate::result::Result::Ok(_) => crate::result::Result::Ok(true),\n        crate::result::Result::Err(e) => {\n            if e.kind() == ErrorKind::NotFound {\n                crate::result::Result::Ok(false)\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_file<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's unlink. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_unlink(p.ptr()) })\n}\n\n// Removes the empty directory at path.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's rmdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_rmdir(p.ptr()) })\n");
    buf_str(out, c"}\n\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn rename<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<()> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = cpath(from)?;\n    let b = cpath(to)?;\n    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.\n    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn create_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })\n}\n\n// Whether path is a directory (through a symbolic link).\nfn is_dir_at(path: &str) -> bool {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(m) => m.is_dir(),\n        crate::result::Result::Err(_) => false,\n    }\n}\n\n// path's parent as Rust's Path::parent has it: \"\" for a relative name,\n// None for the root (or \"\").\nfn parent_of(path: &str) -> Option<&str> {\n    let b = path.as_bytes();\n    let mut end = b.len();\n    while end > 0 && b[end - 1] == 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::None;\n    }\n    while end > 0 && b[end - 1] != 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::Some(&path[..0]);\n    }\n    let mut k = end;\n    while k > 0 && b[k - 1] == 47 {\n        k -= 1;\n    }\n    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }\n}\n\n// Makes the directory at path and those above it that are missing: Ok\n// when it is there (Rust's, step for step).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, P)]\npub fn create_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    if path.is_empty() {\n");
    buf_str(out, c"        return crate::result::Result::Ok(());\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => return crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if e.kind() != ErrorKind::NotFound {\n                return if is_dir_at(path) {\n                    crate::result::Result::Ok(())\n                } else {\n                    crate::result::Result::Err(e)\n                };\n            }\n        }\n    }\n    match parent_of(path) {\n        Option::Some(p) => create_dir_all(p)?,\n        Option::None => {\n            return crate::result::Result::Err(Error::other(\"failed to create whole tree\"));\n        }\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if is_dir_at(path) {\n                crate::result::Result::Ok(())\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// Removes the directory at path and all it holds; a symbolic link is\n// removed, not followed.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P)]\npub fn remove_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let m = symlink_metadata(path)?;\n    if m.is_symlink() {\n        return remove_file(path);\n    }\n    if !m.is_dir() {\n        return crate::result::Result::Err(Error::from_raw_os_error(20));\n    }\n    remove_tree(path)\n}\n\n// Removes the directory at path and everything under it.\nfn remove_tree(path: &str) -> Result<()> {\n    let mut dir = read_dir(path)?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        if e.file_type()?.is_dir() {\n            remove_tree(e.path())?;\n        } else {\n            remove_file(e.path())?;\n        }\n    }\n");
    buf_str(out, c"    remove_dir(path)\n}\n\n// ---- Directories ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn read_dir<P: AsRef<str>>(path: P) -> Result<ReadDir> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.\n    let d = unsafe { fs_c_opendir(p.ptr()) };\n    if d.is_null() {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    let mut root = [0u8; crate::__sys::PATH_MAX];\n    let b = path.as_bytes();\n    let mut i: usize = 0;\n    while i < b.len() {\n        root[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir {\n    dir: *mut u8,\n    root: [u8; crate::__sys::PATH_MAX],\n    root_len: usize,\n}\n\nimpl Drop for ReadDir {\n    fn drop(&mut self) {\n        // UNSAFE: C's closedir. SAFETY: dir is the DIR * opendir returned,\n        // non-null (read_dir checks), closed once (here).\n        let _ = unsafe { fs_c_closedir(self.dir) };\n    }\n}\n\nimpl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(&mut self) -> Option<Result<DirEntry>> {\n        loop {\n            let mut e = DirEntry {\n                path: [0u8; crate::__sys::PATH_MAX], len: 0, name_at: 0, kind: 0,\n            };\n            // UNSAFE: errno cleared, then C's readdir on the DIR *, and its\n            // struct dirent read through the pointer readdir returns.\n            // SAFETY: errno_location is this thread's errno; dir is open\n            // (Drop closes it, after the last next); a non-null entry is a\n            // struct dirent of this system (its d_type and d_name at the\n");
