    buf_str(out, c"    fn allocate(&self, layout: Layout) -> crate::result::Result<NonNull<u8>, AllocError> {\n        if layout.align() > 16 {\n            return crate::result::Result::Err(AllocError {});\n        }\n        // UNSAFE: C's malloc.\n        // SAFETY: it takes a size and returns a block or null.\n        let p = unsafe { thread_c_malloc(layout.size()) };\n        match NonNull::new(p) {\n            Option::Some(q) => crate::result::Result::Ok(q),\n            Option::None => crate::result::Result::Err(AllocError {}),\n        }\n    }\n\n    // UNSAFE: gives a block back to C's free.\n    // SAFETY: a contract on the caller (Allocator's): p is a block this\n    // allocator gave, so malloc's.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        thread_c_free(p.as_ptr());\n    }\n}\n\n// What a thread shares with its handle: its result once done (done is\n// 1 then), and refs, the thread's and the handle's: the last of the two\n// frees it into alloc.\nstruct Out<T, A: Allocator> {\n    result: Option<T>,\n    done: u32,\n    refs: u32,\n    alloc: A,\n}\n\n// The closure, moved to the thread, and where its result goes.\nstruct Packet<F, T, A: Allocator> {\n    f: F,\n    out: *mut Out<T, A>,\n}\n\n// What the thread starts from (C's heap): run(data, this record).\nstruct Start {\n    run: fn(*mut u8, *mut u8),\n    data: *mut u8,\n}\n\n// The thread's first frame (C's convention, what pthread_create takes).\nextern \"C\" fn thread_start(arg: *mut u8) -> *mut u8 {\n    // UNSAFE: the start record through its raw pointer.\n    // SAFETY: arg is the Start start_thread wrote for this thread only;\n    // it is read here and freed by run.\n    unsafe {\n        let s = arg as *mut Start;\n        let run = (*s).run;\n        let data = (*s).data;\n        run(data, arg);\n    }\n    crate::ptr::null_mut::<u8>()\n}\n\n// A record of T's layout from a; out of memory panics.\nfn new_record<T, A: Allocator>(a: &A, x: T) -> *mut T {\n");
    buf_str(out, c"    let p = match a.allocate(Layout::new::<T>()) {\n        crate::result::Result::Ok(p) => p.as_ptr() as *mut T,\n        crate::result::Result::Err(_) => {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg)\n        }\n    };\n    // UNSAFE: x moved into the fresh block.\n    // SAFETY: p is a block of T's layout from a; the write drops nothing.\n    unsafe { crate::ptr::write(p, x) };\n    p\n}\n\n// Gives a record of T's layout back to a (its value moved out already).\n// UNSAFE: deallocates through the allocator.\n// SAFETY: a contract on the caller: p is new_record's block from a.\nunsafe fn free_record<T, A: Allocator>(a: &A, p: *mut T) {\n    match NonNull::new(p as *mut u8) {\n        Option::Some(q) => a.deallocate(q, Layout::new::<T>()),\n        Option::None => {}\n    }\n}\n\n// Drops the result (if any) and frees out into its own allocator.\n// UNSAFE: moves the record out through its raw pointer.\n// SAFETY: a contract on the caller: out is live and nobody uses it after.\nunsafe fn release_out<T, A: Allocator>(out: *mut Out<T, A>) {\n    let o = crate::ptr::read(out as *const Out<T, A>);\n    free_record(&o.alloc, out);\n    crate::mem::drop(o);\n}\n\n// The thread's work: the packet taken and freed, the closure called, its\n// result published, the thread's ref given up.\nfn thread_run<F: FnOnce() -> T, T, A: Allocator>(data: *mut u8, start: *mut u8) {\n    // UNSAFE: the packet, the start record and the result's place through\n    // raw pointers.\n    // SAFETY: data is the Packet start_thread wrote for this thread only:\n    // moved out and freed once; start is freed once into C's heap; out is\n    // live while refs > 0, and this thread holds one ref until its\n    // atomic_sub (AcqRel: the handle's side is ordered before the free).\n    unsafe {\n        let q = data as *mut Packet<F, T, A>;\n        let p = crate::ptr::read(q as *const Packet<F, T, A>);\n        let out = p.out;\n");
    buf_str(out, c"        free_record(&*(&(*out).alloc), q);\n        thread_c_free(start);\n        let r = (p.f)();\n        (*out).result = Option::Some(r);\n        atomic_store(&mut (*out).done as *mut u32, 1, RELEASE);\n        if atomic_sub(&mut (*out).refs as *mut u32, 1, ACQ_REL) == 1 {\n            release_out(out);\n        }\n    }\n}\n\n// Starts a thread running f, its records on a: its pthread_t and its\n// result's place.\nfn start_thread<F: FnOnce() -> T, T, A: Allocator>(f: F, a: A) -> (u64, *mut Out<T, A>) {\n    let out = new_record(&a, Out::<T, A> { result: Option::<T>::None, done: 0, refs: 2, alloc: a });\n    // UNSAFE: the records reached through raw pointers, and pthread_create.\n    // SAFETY: out is live (refs 2); the Packet and the Start go to the new\n    // thread only; attr is 128 bytes, more than a pthread_attr_t.\n    unsafe {\n        let q = new_record(&*(&(*out).alloc), Packet { f: f, out: out });\n        let s = thread_c_malloc(Layout::new::<Start>().size()) as *mut Start;\n        if s.is_null() {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg);\n        }\n        crate::ptr::write(s, Start { run: thread_run::<F, T, A>, data: q as *mut u8 });\n        let mut attr: [u64; 16] = [0; 16];\n        let ap = &mut attr[0] as *mut u64 as *mut u8;\n        thread_c_attr_init(ap);\n        thread_c_attr_setstacksize(ap, THREAD_STACK);\n        let mut t: u64 = 0;\n        let rc = thread_c_create(&mut t as *mut u64, ap as *const u8, thread_start, s as *mut u8);\n        thread_c_attr_destroy(ap);\n        if rc != 0 {\n            let msg: &str = \"failed to spawn thread\";\n            crate::panic::panic(msg);\n        }\n        (t, out)\n    }\n}\n\n// Waits for thread t and takes its result, freeing its place.\n// UNSAFE: pthread_join and the result's place through its raw pointer.\n// SAFETY: a contract on the caller: t is out's thread, not joined or\n// detached yet, and out is not used after.\n");
    buf_str(out, c"unsafe fn join_thread<T, A: Allocator>(t: u64, out: *mut Out<T, A>) -> T {\n    thread_c_join(t, crate::ptr::null_mut::<u64>());\n    let r = crate::mem::replace(&mut *(&mut (*out).result), Option::None);\n    release_out(out);\n    match r {\n        Option::Some(x) => x,\n        Option::None => crate::panic::unreachable(),\n    }\n}\n\n// Whether out's thread has published its result.\n// UNSAFE: an atomic read through the raw pointer.\n// SAFETY: a contract on the caller: out is live.\nunsafe fn finished<T, A: Allocator>(out: *mut Out<T, A>) -> bool {\n    atomic_load(&(*out).done as *const u32, ACQUIRE) == 1\n}\n\n// A thread of a scope, in its list: joined when the scope ends unless its\n// handle joined it.\nstruct ScopeNode {\n    native: u64,\n    joined: bool,\n    out: *mut u8,\n    join: fn(u64, *mut u8),\n    next: *mut ScopeNode,\n}\n\n// A scope node's join, erased: the thread joined and its result dropped.\n// Private, and called only by scope's end with its own node's pair.\nfn scope_join<T>(t: u64, out: *mut u8) {\n    // UNSAFE: the result's place through an erased pointer.\n    // SAFETY: the pair is one node's: out is the Out<T, CHeap> of thread\n    // t, not joined yet (the node is not marked joined).\n    crate::mem::drop(unsafe { join_thread(t, out as *mut Out<T, CHeap>) });\n}\n\n// join's result: never an Err in vole (a panic exits the process).\npub type Result<T> = crate::result::Result<T, JoinError>;\n\n// A thread's panic, as join would report it: no value is ever made.\npub struct JoinError {\n    never: crate::convert::Infallible,\n}\n\nimpl Debug for JoinError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.never {}\n    }\n}\n\n// Runs f with a Scope, joins every thread spawned in it, and returns f's\n// value. Each region in f's argument is elided, so it is late-bound (no\n// `for<'a>`, cut to 0.29): the scope's region 'scope cannot be named\n");
    buf_str(out, c"// outside f, and Scope is invariant in it, so a thread cannot borrow a\n// local of f's body (plan §4, threads).\n// std2: changed: FnOnce(&Scope<'_, 'env>) (MVS: FnMut(inout Scope))\n#[effects(alloc(CHeap), diverge, unsafe, F)]\npub fn scope<'env, F, T>(f: F) -> T\n    where\n        F: FnOnce(&Scope<'_, 'env>) -> T,\n{\n    let s = Scope {\n        first: Cell::new(crate::ptr::null_mut::<ScopeNode>()),\n        scope: PhantomData {},\n        env: PhantomData {},\n    };\n    let r = f(&s);\n    // UNSAFE: walks the scope's list through raw pointers.\n    // SAFETY: every node is one Scope::spawn made for s and freed here\n    // only, once; a node its handle joined is skipped.\n    unsafe {\n        let mut n = s.first.get();\n        while !n.is_null() {\n            let next = (*n).next;\n            if !(*n).joined {\n                ((*n).join)((*n).native, (*n).out);\n            }\n            free_record(&CHeap { sealed: () }, n);\n            n = next;\n        }\n    }\n    r\n}\n\n// The scope threads are spawned in. 'scope is the scope's own region\n// ('env outlives it); invariant in both, as Rust's.\n// std2: changed: two regions, invariant\npub struct Scope<'scope, 'env: 'scope> {\n    first: Cell<*mut ScopeNode>,\n    scope: PhantomData<&'scope mut &'scope ()>,\n    env: PhantomData<&'env mut &'env ()>,\n}\n\nimpl<'scope, 'env> Scope<'scope, 'env> {\n    // Runs f on a new thread, joined at the latest when the scope ends;\n    // f may borrow anything that outlives 'scope. `&self`, not Rust's\n    // `&'scope self`: scope's argument elides its two regions separately,\n    // so the reference may be shorter than 'scope; the bound F: 'scope,\n    // with Scope invariant in 'scope, is what keeps f's borrows alive.\n    // std2: changed: &self, FnOnce, Send, a 'scope bound (MVS: inout self, FnMut)\n    // later: auto_trait\n    #[effects(alloc(CHeap), io, panic, diverge, F, T)]\n    pub fn spawn<F, T>(&self, f: F) -> ScopedJoinHandle<'scope, T>\n");
    buf_str(out, c"        where\n            F: FnOnce() -> T + Send + 'scope,\n            T: Send + 'scope,\n    {\n        let (t, out) = start_thread(f, CHeap { sealed: () });\n        let node = new_record(&CHeap { sealed: () }, ScopeNode {\n            native: t,\n            joined: false,\n            out: out as *mut u8,\n            join: scope_join::<T>,\n            next: self.first.get(),\n        });\n        self.first.set(node);\n        ScopedJoinHandle { native: t, out: out, node: node, scope: PhantomData {} }\n    }\n}\n\n// A scoped thread: join waits for its value.\n// std2: changed: a region 'scope\npub struct ScopedJoinHandle<'scope, T> {\n    native: u64,\n    out: *mut Out<T, CHeap>,\n    node: *mut ScopeNode,\n    scope: PhantomData<&'scope ()>,\n}\n\n// UNSAFE: the handle reaches its result and its scope node through raw\n// pointers: stated, as Rust's (Send and Sync for every T).\n// SAFETY: as JoinHandle's; Scope::spawn asks T: Send, and the scope's node\n// is written only by join, which takes the handle.\nunsafe impl<'scope, T> Send for ScopedJoinHandle<'scope, T> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&ScopedJoinHandle` only reads the done flag, atomically.\nunsafe impl<'scope, T> Sync for ScopedJoinHandle<'scope, T> {}\n\nimpl<'scope, T> ScopedJoinHandle<'scope, T> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(unsafe, T)]\n    pub fn join(self) -> Result<T> {\n        // UNSAFE: the scope's node and the thread's result through raw\n        // pointers.\n        // SAFETY: the node lives until the scope ends, which 'scope\n        // outlives; marked joined, the scope's end skips the thread, so it\n        // is joined once.\n        unsafe {\n            (*self.node).joined = true;\n            crate::result::Result::Ok(join_thread(self.native, self.out))\n        }\n    }\n\n    // Whether the thread has finished (join would not wait).\n    #[effects(unsafe, T)]\n");
    buf_str(out, c"    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: out lives until the thread is joined, by this handle's\n        // join (which takes it) or the scope's end ('scope outlives self).\n        unsafe { finished(self.out) }\n    }\n}\n\n// Runs f on a new thread of its own; its closure and its result live on\n// a until join (or the handle's drop, which detaches it).\n// mvs: spawn\n// std2: changed: an allocator, FnOnce, Send and 'static (MVS: spawn(f), through C)\n// later: auto_trait\n#[effects(F, T, A)]\npub fn spawn_in<F, T, A>(f: F, a: A) -> JoinHandle<T, A>\n    where\n        F: FnOnce() -> T + Send + 'static,\n        T: Send + 'static,\n        A: Allocator + Send + 'static,\n{\n    let (t, out) = start_thread(f, a);\n    JoinHandle { native: t, out: out }\n}\n\n// A spawned thread.\n// std2: changed: an allocator parameter\npub struct JoinHandle<T, A: Allocator> {\n    native: u64,\n    out: *mut Out<T, A>,\n}\n\n// UNSAFE: the handle reaches the thread's result through a raw pointer:\n// stated, as Rust's (Send and Sync for every T).\n// SAFETY: the result's place is shared with the thread by its refs count,\n// atomically (AcqRel), and read only by join, which takes the handle;\n// spawn_in asks T: Send and A: Send.\nunsafe impl<T, A: Allocator> Send for JoinHandle<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&JoinHandle` only reads the done flag, atomically (is_finished).\nunsafe impl<T, A: Allocator> Sync for JoinHandle<T, A> {}\n\nimpl<T, A: Allocator> JoinHandle<T, A> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(alloc(A, extern), unsafe, T, A)]\n    pub fn join(self) -> Result<T> {\n        let t = self.native;\n        let out = self.out;\n        crate::mem::forget(self);\n        // UNSAFE: pthread_join and the result's place.\n");
    buf_str(out, c"        // SAFETY: the handle held a ref, so out is live; it is forgotten, so\n        // its drop does not detach or free; the thread is joined once.\n        crate::result::Result::Ok(unsafe { join_thread(t, out) })\n    }\n\n    #[effects(unsafe, T, A)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: the handle holds a ref, so out is live.\n        unsafe { finished(self.out) }\n    }\n}\n\n// Detaches the thread: it runs on, its result dropped when it ends.\nimpl<T, A: Allocator> crate::ops::Drop for JoinHandle<T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: pthread_detach and the result's place.\n        // SAFETY: out is live (the handle's ref); the last of the thread and\n        // the handle (refs, AcqRel) frees it, once.\n        unsafe {\n            thread_c_detach(self.native);\n            if atomic_sub(&mut (*self.out).refs as *mut u32, 1, ACQ_REL) == 1 {\n                release_out(self.out);\n            }\n        }\n    }\n}\n\n// Lets the OS run another thread.\n#[effects(sync, unsafe)]\npub fn yield_now() {\n    // UNSAFE: C's sched_yield.\n    // SAFETY: it takes nothing.\n    unsafe { thread_c_yield() };\n}\n\n// How many threads can run at once (the CPUs online); 1 when unknown.\n// (Rust's returns io::Result<NonZero<usize>>; vole's, a usize.)\n// std2: changed: usize\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn available_parallelism() -> usize {\n    // UNSAFE: C's sysconf.\n    // SAFETY: it takes an int.\n    let n = unsafe { thread_c_sysconf(SC_NPROCESSORS_ONLN) };\n    if n < 1 { 1 } else { n as usize }\n}\n\n// UNSAFE: C's nanosleep. SAFETY: time.h's prototype (struct timespec, two\n// 64-bit fields on the 64-bit targets, an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"nanosleep\"]\n    fn thread_c_nanosleep(req: *const i64, rem: *mut i64) -> i32;\n}\n\n// Sleeps for d at least: sleeps again for the rest when a signal wakes it.\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sleep(d: crate::time::Duration) {\n    let max_secs = 9223372036854775807u64;\n    let secs = d.as_secs();\n    let mut req = [if secs > max_secs { max_secs as i64 } else { secs as i64 },\n        d.subsec_nanos() as i64];\n    // (each round sleeps or ends, a signal per round at most: counted)\n    for _ in 0..1000000 {\n        let mut rem = [0i64; 2];\n        // UNSAFE: C's nanosleep.\n        // SAFETY: req and rem are timespecs (two i64s), rem writable; req's\n        // nanoseconds are under a second (a Duration's).\n        let r = unsafe { thread_c_nanosleep(&req[0] as *const i64, &mut rem[0] as *mut i64) };\n        if r == 0 || rem[0] == 0 && rem[1] == 0 {\n            return;\n        }\n        req = rem;\n    }\n}\n\n// ---- Thread-locals ----\n\n// `#[thread_local] static mut X: T = INIT;`: each thread has its own X,\n// made from INIT when the thread first reaches it. The compiler makes\n// every access of X `*__tls_addr(&X's initial value, size)`\n// (front/threadlocal.vl), as for MVS's std::thread, which keeps them the\n// same way: C's thread-specific data, a key per thread-local found by\n// the initial value's address in a table read without a lock, the\n// thread's copy allocated from C at its first access and freed when the\n// thread ends. A thread-local's drop does not run.\n\n// UNSAFE: POSIX thread-specific data and memcpy, with raw pointers.\n// SAFETY: the prototypes are pthread.h's and string.h's (pthread_key_t\n// written as a u64 that starts 0: macOS's unsigned long, or Linux's\n// unsigned int in its low half), as MVS's thread.\nextern \"C\" {\n    #[link_name = \"pthread_key_create\"]\n    fn tls_c_key_create(key: *mut u64, destructor: extern \"C\" fn(*mut u8)) -> i32;\n    #[link_name = \"pthread_getspecific\"]\n    fn tls_c_get(key: u64) -> *mut u8;\n    #[link_name = \"pthread_setspecific\"]\n    fn tls_c_set(key: u64, p: *mut u8) -> i32;\n");
    buf_str(out, c"    #[link_name = \"memcpy\"]\n    fn tls_c_memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;\n}\n\n// UNSAFE: as atomic_load (built in: the old value, then `new` stored when\n// it was `expected`).\n// SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The key table, by the initial value's address (open addressing): a\n// slot's address is claimed by a compare-and-swap, then its key + 1 is\n// published (release) by the thread that claimed it.\nconst TLS_SLOTS: usize = 1024;\nstatic mut TLS_ADDRS: [u64; 1024] = [0; 1024];\nstatic mut TLS_KEYS: [u64; 1024] = [0; 1024];\n\nextern \"C\" fn tls_free(p: *mut u8) {\n    // UNSAFE: C's free.\n    // SAFETY: p is a thread's copy tls_first allocated, freed once, by the\n    // key's destructor when the thread ends.\n    unsafe { thread_c_free(p) };\n}\n\n// This thread's copy of the thread-local whose initial value (size bytes)\n// is at template.\n// UNSAFE: returns a raw pointer to this thread's copy.\n// SAFETY: (the caller's: the compiler's) template is a thread-local's\n// initial value of size bytes, live for the program.\npub unsafe fn __tls_addr(template: *mut u8, size: i64) -> *mut u8 {\n    let key = tls_key(template);\n    let p = tls_c_get(key);\n    if !p.is_null() {\n        return p;\n    }\n    tls_first(key, template, size)\n}\n\n// UNSAFE: C memory and a copy from a raw pointer.\n// SAFETY: (the caller's) template has size bytes; p is checked non-null,\n// with room for them.\n#[inline(never)]\nunsafe fn tls_first(key: u64, template: *mut u8, size: i64) -> *mut u8 {\n    let n = if size > 0 { size as usize } else { 1 };\n    let p = thread_c_malloc(n);\n    if p.is_null() {\n        crate::panic::panic(\"thread-locals: out of memory\");\n    }\n    tls_c_memcpy(p, template as *const u8, n);\n    tls_c_set(key, p);\n    p\n}\n\n// The key of the thread-local at template, made at its first use: the\n");
    buf_str(out, c"// thread whose compare-and-swap claims the slot makes it and publishes\n// it; another one that finds the address waits for the key.\n// UNSAFE: the key table's statics through raw pointers, atomically, and\n// pthread_key_create.\n// SAFETY: i stays in 0..TLS_SLOTS (a hash's top 10 bits, then mod); a\n// slot's address is written only by the compare-and-swap, its key only by\n// the thread whose swap claimed it, before others read it (release,\n// acquire).\nunsafe fn tls_key(template: *mut u8) -> u64 {\n    let a = template as u64;\n    let addrs = &raw mut TLS_ADDRS as *mut u64;\n    let keys = &raw mut TLS_KEYS as *mut u64;\n    let mut i = ((a >> 4).wrapping_mul(0x9e3779b97f4a7c15) >> 54) as usize % TLS_SLOTS;\n    for _ in 0..TLS_SLOTS {\n        let mut seen = atomic_load(addrs.add(i) as *const u64, ACQUIRE);\n        if seen == 0 {\n            seen = atomic_cas(addrs.add(i), 0, a, ACQ_REL);\n            if seen == 0 {\n                let mut key: u64 = 0;\n                if tls_c_key_create(&mut key as *mut u64, tls_free) != 0 {\n                    crate::panic::panic(\"thread-locals: the system has no key left\");\n                }\n                atomic_store(keys.add(i), key + 1, RELEASE);\n                return key;\n            }\n        }\n        if seen == a {\n            loop {\n                let k = atomic_load(keys.add(i) as *const u64, ACQUIRE);\n                if k != 0 {\n                    return k - 1;\n                }\n                thread_c_yield();\n            }\n        }\n        i = (i + 1) % TLS_SLOTS;\n    }\n    crate::panic::panic(\"thread-locals: more than 1024\")\n}\n// ---- end mod std::thread ----\n}\n// ---- mod std::time ----\npub mod time {\n// EDITION: rust\n// std::time: Duration, Instant and SystemTime, Rust's shape (0.27.5). A\n// Duration is whole seconds and the nanoseconds under one second; its\n// arithmetic is checked (`checked_*` give None, `saturating_*` stop at\n");
    buf_str(out, c"// zero and the largest Duration, the operators panic, as Rust's do).\n// Instant reads the monotonic clock, SystemTime the wall clock, both\n// through C's clock_gettime (the clock's id is the target's: std::__sys).\n// mvs: std::time\n\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::ops::{Add, AddAssign, Div, DivAssign, Mul, MulAssign, Sub, SubAssign};\nuse crate::option::Option;\nuse crate::result::Result;\n\nconst NANOS_PER_SEC: u32 = 1000000000;\nconst NANOS_PER_MILLI: u32 = 1000000;\nconst NANOS_PER_MICRO: u32 = 1000;\n\n// A span of time, Rust's std::time::Duration.\n// std2: changed: no ZERO, MAX, SECOND.. constants (a constant of a struct\n// type waits for const evaluation): `Duration::from_secs(0)`, `new(..)`\n// mvs: Duration\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct Duration {\n    secs: u64,\n    nanos: u32,\n}\n\nimpl Duration {\n    // secs seconds and nanos nanoseconds; nanos past a second carry into\n    // the seconds (panics when the seconds overflow).\n    #[effects(panic, diverge)]\n    pub fn new(secs: u64, nanos: u32) -> Duration {\n        if nanos < NANOS_PER_SEC {\n            return Duration { secs: secs, nanos: nanos };\n        }\n        let extra = (nanos / NANOS_PER_SEC) as u64;\n        match secs.checked_add(extra) {\n            Option::Some(s) => Duration { secs: s, nanos: nanos % NANOS_PER_SEC },\n            Option::None => crate::panic::panic(\"overflow in Duration::new\"),\n        }\n    }\n\n    #[effects()]\n    pub fn from_secs(secs: u64) -> Duration {\n        Duration { secs: secs, nanos: 0 }\n    }\n\n    #[effects()]\n    pub fn from_millis(millis: u64) -> Duration {\n        Duration { secs: millis / 1000, nanos: ((millis % 1000) as u32) * NANOS_PER_MILLI }\n    }\n\n    #[effects()]\n    pub fn from_micros(micros: u64) -> Duration {\n        Duration { secs: micros / 1000000, nanos: ((micros % 1000000) as u32) * NANOS_PER_MICRO }\n    }\n\n    #[effects()]\n");
    buf_str(out, c"    pub fn from_nanos(nanos: u64) -> Duration {\n        Duration { secs: nanos / 1000000000, nanos: (nanos % 1000000000) as u32 }\n    }\n\n    // secs seconds, a float: panics when it is negative, not finite or too\n    // large, as Rust's does; rounded to the nearest nanosecond.\n    #[effects(panic, diverge)]\n    pub fn from_secs_f64(secs: f64) -> Duration {\n        match Duration::try_from_secs_f64(secs) {\n            Result::Ok(d) => d,\n            Result::Err(_) => crate::panic::panic(\n                \"cannot convert float seconds to Duration: value is negative, not finite or overflowing\"),\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn from_secs_f32(secs: f32) -> Duration {\n        Duration::from_secs_f64(secs as f64)\n    }\n\n    // from_secs_f64's value, or the error where it panics.\n    #[effects()]\n    pub fn try_from_secs_f64(secs: f64) -> Result<Duration, TryFromFloatSecsError> {\n        if !(secs >= 0.0) || secs >= 18446744073709551616.0 {\n            return Result::Err(TryFromFloatSecsError { negative: secs < 0.0 });\n        }\n        let whole = secs as u64;\n        let frac = secs - whole as f64;\n        let mut nanos = (frac * 1000000000.0 + 0.5) as u64;\n        let mut s = whole;\n        if nanos >= 1000000000 {\n            nanos -= 1000000000;\n            match s.checked_add(1) {\n                Option::Some(t) => s = t,\n                Option::None => return Result::Err(TryFromFloatSecsError { negative: false }),\n            }\n        }\n        Result::Ok(Duration { secs: s, nanos: nanos as u32 })\n    }\n\n    #[effects()]\n    pub fn try_from_secs_f32(secs: f32) -> Result<Duration, TryFromFloatSecsError> {\n        Duration::try_from_secs_f64(secs as f64)\n    }\n\n    #[effects()]\n    pub fn is_zero(&self) -> bool {\n        self.secs == 0 && self.nanos == 0\n    }\n\n    #[effects()]\n    pub fn as_secs(&self) -> u64 {\n        self.secs\n    }\n\n    #[effects()]\n");
    buf_str(out, c"    pub fn subsec_millis(&self) -> u32 {\n        self.nanos / NANOS_PER_MILLI\n    }\n\n    #[effects()]\n    pub fn subsec_micros(&self) -> u32 {\n        self.nanos / NANOS_PER_MICRO\n    }\n\n    #[effects()]\n    pub fn subsec_nanos(&self) -> u32 {\n        self.nanos\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_millis(&self) -> u64 {\n        self.secs.saturating_mul(1000).saturating_add((self.nanos / NANOS_PER_MILLI) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_micros(&self) -> u64 {\n        self.secs.saturating_mul(1000000).saturating_add((self.nanos / NANOS_PER_MICRO) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_nanos(&self) -> u64 {\n        self.secs.saturating_mul(1000000000).saturating_add(self.nanos as u64)\n    }\n\n    #[effects()]\n    pub fn as_secs_f64(&self) -> f64 {\n        self.secs as f64 + self.nanos as f64 / 1000000000.0\n    }\n\n    #[effects()]\n    pub fn as_secs_f32(&self) -> f32 {\n        self.as_secs_f64() as f32\n    }\n\n    #[effects()]\n    pub fn as_millis_f64(&self) -> f64 {\n        self.secs as f64 * 1000.0 + self.nanos as f64 / 1000000.0\n    }\n\n    #[effects()]\n    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_add(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let mut nanos = self.nanos + rhs.nanos;\n        if nanos >= NANOS_PER_SEC {\n            nanos -= NANOS_PER_SEC;\n            secs = match secs.checked_add(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n        }\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {\n");
    buf_str(out, c"        let mut secs = match self.secs.checked_sub(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let nanos = if self.nanos >= rhs.nanos {\n            self.nanos - rhs.nanos\n        } else {\n            secs = match secs.checked_sub(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n            self.nanos + NANOS_PER_SEC - rhs.nanos\n        };\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {\n        let total = self.nanos as u64 * rhs as u64;\n        let extra = total / NANOS_PER_SEC as u64;\n        let nanos = (total % NANOS_PER_SEC as u64) as u32;\n        match self.secs.checked_mul(rhs as u64) {\n            Option::Some(s) => match s.checked_add(extra) {\n                Option::Some(secs) => Option::Some(Duration { secs: secs, nanos: nanos }),\n                Option::None => Option::None,\n            },\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_div(self, rhs: u32) -> Option<Duration> {\n        if rhs == 0 {\n            return Option::None;\n        }\n        let secs = self.secs / rhs as u64;\n        let carry = self.secs - secs * rhs as u64;\n        let extra = carry * NANOS_PER_SEC as u64 / rhs as u64;\n        let nanos = self.nanos / rhs + extra as u32;\n        Option::Some(Duration::new(secs, nanos))\n    }\n\n    #[effects()]\n    pub fn saturating_add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n");
    buf_str(out, c"            Option::None => Duration { secs: 0, nanos: 0 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn abs_diff(self, other: Duration) -> Duration {\n        if self >= other {\n            self.saturating_sub(other)\n        } else {\n            other.saturating_sub(self)\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn mul_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(rhs * self.as_secs_f64())\n    }\n\n    #[effects(panic, diverge)]\n    pub fn div_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(self.as_secs_f64() / rhs)\n    }\n\n    #[effects()]\n    pub fn div_duration_f64(self, rhs: Duration) -> f64 {\n        self.as_secs_f64() / rhs.as_secs_f64()\n    }\n}\n\nimpl Add for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when adding durations\"),\n        }\n    }\n}\n\nimpl AddAssign for Duration {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, rhs: Duration) {\n        *self = *self + rhs;\n    }\n}\n\nimpl Sub for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when subtracting durations\"),\n        }\n    }\n}\n\nimpl SubAssign for Duration {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, rhs: Duration) {\n        *self = *self - rhs;\n    }\n}\n\n// mvs: Duration::mul_u32\nimpl Mul<u32> for Duration {\n");
    buf_str(out, c"    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when multiplying duration by scalar\"),\n        }\n    }\n}\n\nimpl MulAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn mul_assign(&mut self, rhs: u32) {\n        *self = *self * rhs;\n    }\n}\n\n// mvs: Duration::div_u32\nimpl Div<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn div(self, rhs: u32) -> Duration {\n        match self.checked_div(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\n                \"divide by zero error when dividing duration by scalar\"),\n        }\n    }\n}\n\nimpl DivAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn div_assign(&mut self, rhs: u32) {\n        *self = *self / rhs;\n    }\n}\n\n// Rust's form: `1.5s`, `100ms`, `2.000001ms`, `7µs`, `9ns`, the\n// fraction's trailing zeros dropped (or `{:.N?}` digits, rounded half\n// up), padded to the width.\nimpl Debug for Duration {\n    #[effects(unsafe)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.secs > 0 {\n            fmt_decimal(f, self.secs, self.nanos, NANOS_PER_SEC / 10, \"s\")\n        } else if self.nanos >= NANOS_PER_MILLI {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MILLI) as u64, self.nanos % NANOS_PER_MILLI,\n                NANOS_PER_MILLI / 10, \"ms\")\n        } else if self.nanos >= NANOS_PER_MICRO {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MICRO) as u64, self.nanos % NANOS_PER_MICRO,\n                NANOS_PER_MICRO / 10, \"µs\")\n        } else {\n            fmt_decimal(f, self.nanos as u64, 0, 1, \"ns\")\n        }\n    }\n}\n\n// integer.fraction then suffix: fraction's digits from divisor down, at\n");
    buf_str(out, c"// most the precision's (9 without one, its trailing zeros dropped).\n#[effects(unsafe)]\nfn fmt_decimal(f: &mut Formatter<'_>, integer: u64, fraction: u32, divisor: u32, suffix: &str)\n    -> crate::fmt::Result {\n    let mut digits = [b'0'; 9];\n    let wanted = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => 9,\n    };\n    let mut frac = fraction;\n    let mut div = divisor;\n    let mut pos: usize = 0;\n    while frac > 0 && pos < wanted && div > 0 {\n        digits[pos] = b'0' + (frac / div) as u8;\n        frac = frac % div;\n        div = div / 10;\n        pos += 1;\n    }\n    let mut int_part = integer;\n    // (rounding half up what is left)\n    if frac > 0 && div > 0 && frac >= div * 5 {\n        let mut carry = true;\n        let mut k = pos;\n        while carry && k > 0 {\n            k -= 1;\n            if digits[k] == b'9' {\n                digits[k] = b'0';\n            } else {\n                digits[k] += 1;\n                carry = false;\n            }\n        }\n        if carry {\n            int_part = int_part.saturating_add(1);\n        }\n    }\n    let shown = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => pos,\n    };\n    let mut out = [0u8; 48];\n    let mut n: usize = 0;\n    let mut int_digits = [0u8; 20];\n    let mut m: usize = 0;\n    let mut v = int_part;\n    if v == 0 {\n        int_digits[0] = b'0';\n        m = 1;\n    }\n    while v > 0 {\n        int_digits[m] = b'0' + (v % 10) as u8;\n        v = v / 10;\n        m += 1;\n    }\n    while m > 0 {\n        m -= 1;\n        out[n] = int_digits[m];\n        n += 1;\n    }\n    if shown > 0 {\n        out[n] = b'.';\n        n += 1;\n        for k in 0..shown {\n            out[n] = digits[k];\n            n += 1;\n        }\n    }\n    for b in suffix.as_bytes() {\n        out[n] = *b;\n        n += 1;\n    }\n");
    buf_str(out, c"    // UNSAFE: the bytes written above are ASCII digits, '.', and suffix's\n    // UTF-8 bytes copied whole.\n    // SAFETY: each is a whole UTF-8 sequence, so out[..n] is UTF-8.\n    let text = unsafe { crate::str::from_utf8_unchecked(&out[..n]) };\n    // (the width pads it, left-aligned by default, as Rust's; the\n    // precision was the fraction's, so not Formatter::pad, which would cut\n    // the text to it)\n    let chars = text.chars().count();\n    let w = match f.width() {\n        Option::Some(w) => w,\n        Option::None => 0,\n    };\n    if w <= chars {\n        return f.write_str(text);\n    }\n    let gap = w - chars;\n    let (before, after): (usize, usize) = match f.align() {\n        Option::Some(crate::fmt::Alignment::Right) => (gap, 0),\n        Option::Some(crate::fmt::Alignment::Center) => (gap / 2, gap - gap / 2),\n        _ => (0, gap),\n    };\n    let fill = f.fill();\n    for _ in 0..before {\n        f.write_char(fill)?;\n    }\n    f.write_str(text)?;\n    for _ in 0..after {\n        f.write_char(fill)?;\n    }\n    crate::fmt::Result::Ok(())\n}\n\n// Duration::try_from_secs_f64's error: the float was negative, not finite\n// or too large.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct TryFromFloatSecsError {\n    negative: bool,\n}\n\nimpl Display for TryFromFloatSecsError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.negative {\n            f.write_str(\"cannot convert float seconds to Duration: value is negative\")\n        } else {\n            f.write_str(\"cannot convert float seconds to Duration: value is either too big or NaN\")\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: time.h's prototype (struct timespec, two 64-bit\n// fields on the 64-bit targets, is an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    fn c_clock_gettime(clock: i32, tp: *mut i64) -> i32;\n}\n\n// Clock clock's now, a Duration since its start.\n");
    buf_str(out, c"#[effects(io, static, unsafe)]\nfn clock_now(clock: i32) -> Duration {\n    let mut ts = [0i64; 2];\n    // UNSAFE: C's clock_gettime.\n    // SAFETY: ts is a writable timespec (two i64s); clock is a valid id\n    // (the target's, std::__sys), so the call cannot fail.\n    unsafe {\n        c_clock_gettime(clock, &mut ts[0] as *mut i64);\n    }\n    Duration { secs: ts[0] as u64, nanos: ts[1] as u32 }\n}\n\n// A reading of the monotonic clock, Rust's std::time::Instant: only its\n// differences mean anything.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct Instant {\n    t: Duration,\n}\n\nimpl Instant {\n    // mvs: monotonic_now\n    #[effects(io, static, unsafe)]\n    pub fn now() -> Instant {\n        Instant { t: clock_now(crate::__sys::CLOCK_MONOTONIC) }\n    }\n\n    // The time since earlier (zero when earlier is later, as Rust's).\n    #[effects()]\n    pub fn duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {\n        self.t.checked_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn elapsed(&self) -> Duration {\n        Instant::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for Instant {\n");
    buf_str(out, c"    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> Instant {\n        Instant { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> Instant {\n        Instant { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Sub<Instant> for Instant {\n    type Output = Duration;\n    #[effects()]\n    fn sub(self, earlier: Instant) -> Duration {\n        self.duration_since(earlier)\n    }\n}\n\nimpl Debug for Instant {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Instant\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// A reading of the wall clock, Rust's std::time::SystemTime: the time\n// since UNIX_EPOCH (not before it here).\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct SystemTime {\n    t: Duration,\n}\n\n// 1970-01-01 00:00:00 UTC.\n// std2: changed: a static (Rust's is a constant: a constant of a struct\n// type waits for const evaluation)\npub static UNIX_EPOCH: SystemTime = SystemTime { t: Duration { secs: 0, nanos: 0 } };\n\nimpl SystemTime {\n    // mvs: clock_now\n    #[effects(io, static, unsafe)]\n    pub fn now() -> SystemTime {\n        SystemTime { t: clock_now(0) }\n    }\n\n    // The time since earlier, or how much later earlier is.\n    #[effects()]\n    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {\n        match self.t.checked_sub(earlier.t) {\n            Option::Some(d) => Result::Ok(d),\n");
    buf_str(out, c"            Option::None => Result::Err(SystemTimeError(earlier.t - self.t)),\n        }\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {\n        SystemTime::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Debug for SystemTime {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"SystemTime\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// SystemTime::duration_since's error: how much later the other time is.\n#[derive(Clone, Copy, Debug)]\npub struct SystemTimeError(Duration);\n\nimpl SystemTimeError {\n    #[effects()]\n    pub fn duration(&self) -> Duration {\n        self.0\n    }\n}\n\n");
    buf_str(out, c"impl Display for SystemTimeError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"second time provided was later than self\")\n    }\n}\n// ---- end mod std::time ----\n}\n// ---- mod std::sync ----\npub mod sync {\n// EDITION: rust\n// std::sync: what threads share. Its first part (0.27.3): the atomics.\n// Mutex, RwLock, Arc and the channels come later.\n// mvs: std::sync\n\npub mod atomic;\n// ---- mod std::sync::atomic ----\npub mod atomic {\n// EDITION: rust\n// std::sync::atomic: values that threads read and write at once without a\n// data race, and the memory orderings (Rust's; C++20's model). AtomicI64\n// and the others are Atomic<T> for their T, an integer, bool or a raw\n// pointer: one access of 1 to 8 bytes (the compiler implements the sealed\n// AtomicValue, AtomicBitwise and AtomicInteger for exactly those types,\n// front/traits.vl: atomic_bound). Integers wrap.\n//\n//     static HITS: AtomicUsize = AtomicUsize::new(0);\n//     HITS.fetch_add(1, Ordering::Relaxed);\n// mvs: std::sync::atomic\n\nuse crate::cell::UnsafeCell;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::result::Result;\n\n// The ordering of an atomic operation (Rust's, without Consume).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum Ordering {\n    Relaxed,\n    Release,\n    Acquire,\n    AcqRel,\n    SeqCst,\n}\n\n// The intrinsics the compiler lowers by name to its atomic instructions\n// (middle/lower/atomic.vl, as MVS's std::sync::atomic): `order` is 0\n// Relaxed, 1 Acquire, 2 Release, 3 AcqRel, 4 SeqCst, a literal after\n// inlining (else SeqCst); their bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid and aligned for T, T one the\n// AtomicValue bound admits, and *p reached only through atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n");
    buf_str(out, c"// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_swap<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The old value; *p becomes `new` when it was `expected`.\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_add<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_and<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_nand<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_or<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_xor<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (signed or unsigned as T is)\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_max<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_min<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (no pointer, no memory touched)\nfn atomic_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\nfn atomic_compiler_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\n");
    buf_str(out, c"// The one ordering of a compare-exchange, at least as strong as both.\nfn cas_order(success: Ordering, failure: Ordering) -> i64 {\n    if failure == Ordering::Release || failure == Ordering::AcqRel {\n        crate::panic::panic(\"there is no such thing as a release failure ordering\");\n    }\n    let s: i64 = match success {\n        Ordering::Relaxed => 0,\n        Ordering::Acquire => 1,\n        Ordering::Release => 2,\n        Ordering::AcqRel => 3,\n        Ordering::SeqCst => 4,\n    };\n    if s == 4 || failure == Ordering::SeqCst {\n        return 4;\n    }\n    if failure == Ordering::Acquire && (s == 0 || s == 2) {\n        return if s == 0 { 1 } else { 3 };\n    }\n    s\n}\n\n// What an Atomic holds: the integers, bool and the raw pointers (the\n// compiler's, sealed: Sealed is private).\npub trait AtomicValue: Copy + PartialEq {\n    fn sealed_value(self) -> Sealed;\n}\n\n// The integers and bool: fetch_and, fetch_or, fetch_xor, fetch_nand.\npub trait AtomicBitwise {\n    fn sealed_bitwise(self) -> Sealed;\n}\n\n// The integers: fetch_add, fetch_sub, fetch_max, fetch_min.\npub trait AtomicInteger {\n    fn sealed_integer(self) -> Sealed;\n}\n\npub struct Sealed {}\n\n// A T that threads share: read and written only through its methods.\n// std2: new: Rust's AtomicI64, AtomicBool, .. are its aliases\npub struct Atomic<T: AtomicValue> {\n    v: UnsafeCell<T>,\n}\n\npub type AtomicI8 = Atomic<i8>;\npub type AtomicI16 = Atomic<i16>;\npub type AtomicI32 = Atomic<i32>;\npub type AtomicI64 = Atomic<i64>;\npub type AtomicIsize = Atomic<isize>;\npub type AtomicU8 = Atomic<u8>;\npub type AtomicU16 = Atomic<u16>;\npub type AtomicU32 = Atomic<u32>;\npub type AtomicU64 = Atomic<u64>;\npub type AtomicUsize = Atomic<usize>;\npub type AtomicBool = Atomic<bool>;\npub type AtomicPtr<T> = Atomic<*mut T>;\n\n// UNSAFE: an Atomic holds an UnsafeCell, which is not Sync: stated, as\n// Rust's atomics state it.\n");
    buf_str(out, c"// SAFETY: every access of v is atomic (its methods), so sharing an Atomic\n// between threads races on nothing; T is Copy, with no drop.\nunsafe impl<T: AtomicValue> Sync for Atomic<T> {}\n// UNSAFE: stated with Sync, as Rust's.\n// SAFETY: T is an integer, bool or a raw pointer, moved as its bits.\nunsafe impl<T: AtomicValue> Send for Atomic<T> {}\n\n// Each `unsafe` below: an intrinsic on self.v.get(), valid and aligned for\n// T, which is reached only through them (an Atomic is not Copy).\nimpl<T: AtomicValue> Atomic<T> {\n    #[effects(T)]\n    pub fn new(v: T) -> Atomic<T> {\n        Atomic { v: UnsafeCell::new(v) }\n    }\n\n    // The value, when nothing else can reach the atomic.\n    #[effects(unsafe, T)]\n    pub fn into_inner(self) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe { atomic_load(self.v.get() as *const T, 0) }\n    }\n\n    // The value, through the unique borrow (no atomic needed).\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> &mut T {\n        self.v.get_mut()\n    }\n\n    // The value's address (an access through it must not race with the\n    // atomic ones).\n    #[effects()]\n    pub fn as_ptr(&self) -> *mut T {\n        self.v.get()\n    }\n\n    // Panics on Release and AcqRel, as Rust's.\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn load(&self, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_load(self.v.get() as *const T, 0),\n                Ordering::Acquire => atomic_load(self.v.get() as *const T, 1),\n                Ordering::SeqCst => atomic_load(self.v.get() as *const T, 4),\n                Ordering::Release => crate::panic::panic(\n                    \"there is no such thing as a release load\"),\n                Ordering::AcqRel => crate::panic::panic(\n");
    buf_str(out, c"                    \"there is no such thing as an acquire-release load\"),\n            }\n        }\n    }\n\n    // Panics on Acquire and AcqRel, as Rust's.\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn store(&self, v: T, order: Ordering) {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_store(self.v.get(), v, 0),\n                Ordering::Release => atomic_store(self.v.get(), v, 2),\n                Ordering::SeqCst => atomic_store(self.v.get(), v, 4),\n                Ordering::Acquire => crate::panic::panic(\n                    \"there is no such thing as an acquire store\"),\n                Ordering::AcqRel => crate::panic::panic(\n                    \"there is no such thing as an acquire-release store\"),\n            }\n        }\n    }\n\n    // Stores v; the old value.\n    #[effects(unsafe, T)]\n    pub fn swap(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_swap(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_swap(self.v.get(), v, 1),\n                Ordering::Release => atomic_swap(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_swap(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_swap(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Ok(the old value) when it was `current` (and is now `new`), else\n    // Err(the value found).\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn compare_exchange(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        let order = cas_order(success, failure);\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        let old = unsafe {\n            if order == 0 {\n");
    buf_str(out, c"                atomic_cas(self.v.get(), current, new, 0)\n            } else if order == 1 {\n                atomic_cas(self.v.get(), current, new, 1)\n            } else if order == 2 {\n                atomic_cas(self.v.get(), current, new, 2)\n            } else if order == 3 {\n                atomic_cas(self.v.get(), current, new, 3)\n            } else {\n                atomic_cas(self.v.get(), current, new, 4)\n            }\n        };\n        if old == current { Result::Ok(old) } else { Result::Err(old) }\n    }\n\n    // compare_exchange (it never fails spuriously here).\n    #[effects(T)]\n    pub fn compare_exchange_weak(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        self.compare_exchange(current, new, success, failure)\n    }\n}\n\n// The arithmetic: the integers only (it wraps).\nimpl<T: AtomicValue + AtomicInteger> Atomic<T> {\n    // Adds v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_add(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_add(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_add(self.v.get(), v, 1),\n                Ordering::Release => atomic_add(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_add(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_add(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Subtracts v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_sub(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_sub(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_sub(self.v.get(), v, 1),\n                Ordering::Release => atomic_sub(self.v.get(), v, 2),\n");
    buf_str(out, c"                Ordering::AcqRel => atomic_sub(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_sub(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The larger of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_max(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_max(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_max(self.v.get(), v, 1),\n                Ordering::Release => atomic_max(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_max(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_max(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The smaller of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_min(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_min(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_min(self.v.get(), v, 1),\n                Ordering::Release => atomic_min(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_min(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_min(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\n// The bitwise operations: the integers and bool.\nimpl<T: AtomicValue + AtomicBitwise> Atomic<T> {\n    // The value & v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_and(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_and(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_and(self.v.get(), v, 1),\n");
    buf_str(out, c"                Ordering::Release => atomic_and(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_and(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_and(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // !(the value & v); the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_nand(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_nand(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_nand(self.v.get(), v, 1),\n                Ordering::Release => atomic_nand(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_nand(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_nand(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value | v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_or(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_or(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_or(self.v.get(), v, 1),\n                Ordering::Release => atomic_or(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_or(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_or(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value ^ v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_xor(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_xor(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_xor(self.v.get(), v, 1),\n                Ordering::Release => atomic_xor(self.v.get(), v, 2),\n");
    buf_str(out, c"                Ordering::AcqRel => atomic_xor(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_xor(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\nimpl<T: AtomicValue + Default> Default for Atomic<T> {\n    fn default() -> Atomic<T> {\n        Atomic::new(T::default())\n    }\n}\n\n// The value, read Relaxed (as Rust's).\nimpl<T: AtomicValue + Debug> Debug for Atomic<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.load(Ordering::Relaxed), f)\n    }\n}\n\n// A memory fence: Acquire, Release, AcqRel or SeqCst; panics on Relaxed,\n// as Rust's.\n#[effects(io, sync, panic, diverge)]\npub fn fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_fence(1),\n        Ordering::Release => atomic_fence(2),\n        Ordering::AcqRel => atomic_fence(3),\n        Ordering::SeqCst => atomic_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\"there is no such thing as a relaxed fence\"),\n    }\n}\n\n// A fence for the compiler only (no instruction): memory accesses are not\n// moved across it. Panics on Relaxed, as Rust's.\n#[effects(io, sync, panic, diverge)]\npub fn compiler_fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_compiler_fence(1),\n        Ordering::Release => atomic_compiler_fence(2),\n        Ordering::AcqRel => atomic_compiler_fence(3),\n        Ordering::SeqCst => atomic_compiler_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\n            \"there is no such thing as a relaxed compiler fence\"),\n    }\n}\n// ---- end mod std::sync::atomic ----\n}\n// ---- end mod std::sync ----\n}\n// ---- mod std::gpu ----\npub mod gpu {\n// EDITION: rust\n// std::gpu (0.27.6): what of MVS's std::gpu (docs/design/gpu.md) std2 has\n// so far, the WGSL front end, `wgsl`. The device API (Instance, Device,\n// buffers, pipelines) and the writers (MSL, SPIR-V) come later.\n// mvs: std::gpu\n\npub mod wgsl;\n");
    buf_str(out, c"// ---- mod std::gpu::wgsl ----\npub mod wgsl {\n// EDITION: rust\n// std::gpu::wgsl (0.27.6): the shader compiler's front end, MVS's\n// (docs/design/gpu.md §2.10), translated: WGSL (the subset of §2.10)\n// parsed, resolved and type-checked into the target-neutral IR, and the\n// uniformity analysis. What the compiler checks an `embed wgsl` block\n// with:\n//\n//   let mut fr = front::new_front(text, a);\n//   fr.module();\n//   if !fr.failed {\n//       uniformity::check(&fr);\n//   }\n//   // fr.failed: fr.err_code (wgsl.*), fr.err_pos, fr.emsg, fr.ehelp\n//\n// `a` is an allocator the front's tables live in (an arena's scope, `&s`).\n// The writers (MSL, SPIR-V), the interpreter and `translate` (MVS's\n// api.vl) come with the device API.\n// mvs: std::gpu::wgsl\n\nmod ir;\nmod names;\nmod lex;\npub mod front;\nmod expr;\nmod builtins;\nmod entry;\npub mod uniformity;\n// ---- mod std::gpu::wgsl::ir ----\nmod ir {\n// EDITION: rust\n// ---- Shader compiler implementation, ir (0.22) ----\n// The shader IR (docs/design/gpu.md §2.10): what the front end makes\n// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is\n// plain data: i64 handles into Vecs, one arena per translation.\n//\n// - Types are module-wide and interned: a handle is equal for equal types.\n//   The scalar, vector and matrix types have fixed handles (`vec_ty`,\n//   `mat_ty`); the rest are found through `types_map`.\n// - A function has an expression arena, a statement arena and blocks\n//   (runs of statement handles in `items`). Expressions are evaluated\n//   where an `S_EMIT` statement covers them, in order, except the results\n//   of calls and atomics (made by their statement) and the leaves\n//   (literals, arguments, variables), which have no cost.\n// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's\n//   kind, set by bounds.vl; a back end never sees `CK_PENDING`.\n//\n// Moves to compiler/std/gpu/wgsl/ir.vl with C2 (std submodules).\n\n");
    buf_str(out, c"use crate::alloc::Allocator;\nuse crate::cmp::PartialEq as Eq;\nuse crate::collections::HashMap;\nuse crate::hash::Hash;\n\n// ---- Shader compiler implementation, ir: Scalars (0.22) ----\n\npub(crate) const SK_BOOL: u8 = 0;\npub(crate) const SK_I32: u8 = 1;\npub(crate) const SK_U32: u8 = 2;\npub(crate) const SK_F32: u8 = 3;\n// Abstract numbers exist only in the front end (const evaluation).\npub(crate) const SK_AINT: u8 = 4;\npub(crate) const SK_AFLOAT: u8 = 5;\n\n// ---- Shader compiler implementation, ir: Types (0.22) ----\n\npub(crate) const TK_SCALAR: u8 = 0;\npub(crate) const TK_VECTOR: u8 = 1;\n// n columns of m rows of f32\npub(crate) const TK_MATRIX: u8 = 2;\n// base: the element; n: the length, 0 when runtime-sized\npub(crate) const TK_ARRAY: u8 = 3;\npub(crate) const TK_STRUCT: u8 = 4;\npub(crate) const TK_ATOMIC: u8 = 5;\n// base: the pointee; space, access\npub(crate) const TK_POINTER: u8 = 6;\n// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format\npub(crate) const TK_TEXTURE: u8 = 7;\n// n: 1 for sampler_comparison\npub(crate) const TK_SAMPLER: u8 = 8;\n\npub(crate) const TEX_2D: i64 = 0;\npub(crate) const TEX_2D_ARRAY: i64 = 1;\npub(crate) const TEX_DEPTH_2D: i64 = 2;\npub(crate) const TEX_STORAGE_2D: i64 = 3;\n\n// Texel formats of storage textures (TK_TEXTURE.m).\npub(crate) const FMT_RGBA8UNORM: i64 = 0;\npub(crate) const FMT_RGBA32FLOAT: i64 = 1;\npub(crate) const FMT_R32FLOAT: i64 = 2;\npub(crate) const FMT_R32UINT: i64 = 3;\npub(crate) const FMT_R32SINT: i64 = 4;\npub(crate) const FMT_RGBA32UINT: i64 = 5;\npub(crate) const FMT_RGBA16FLOAT: i64 = 6;\npub(crate) const FMT_RGBA8UINT: i64 = 7;\npub(crate) const FMT_RG32FLOAT: i64 = 8;\n\n// Address spaces.\npub(crate) const SP_FUNCTION: u8 = 0;\npub(crate) const SP_PRIVATE: u8 = 1;\npub(crate) const SP_WORKGROUP: u8 = 2;\npub(crate) const SP_UNIFORM: u8 = 3;\npub(crate) const SP_STORAGE: u8 = 4;\n// textures and samplers: no address space, the global is the value\n");
    buf_str(out, c"pub(crate) const SP_HANDLE: u8 = 5;\n\n// Access modes (bits).\npub(crate) const ACC_READ: u8 = 1;\npub(crate) const ACC_WRITE: u8 = 2;\npub(crate) const ACC_RW: u8 = 3;\n\n#[derive(Clone, Copy)] pub struct Type<'a> {\n    pub(crate) kind: u8,\n    pub(crate) scalar: u8,\n    pub(crate) space: u8,\n    pub(crate) access: u8,\n    pub(crate) n: i64,\n    pub(crate) m: i64,\n    pub(crate) base: i64,\n    // struct members: members[mstart .. mstart + mcount]\n    pub(crate) mstart: i64,\n    pub(crate) mcount: i64,\n    pub(crate) name: &'a [u8],\n    // the WGSL memory layout, in bytes (every type, every address space)\n    pub(crate) size: i64,\n    pub(crate) align: i64,\n    // arrays: the element stride; matrices: the column stride\n    pub(crate) stride: i64,\n}\n\n// What an entry point's parameter, result or IO struct member is bound to.\npub(crate) const BIND_NONE: u8 = 0;\npub(crate) const BIND_BUILTIN: u8 = 1;\npub(crate) const BIND_LOCATION: u8 = 2;\n\npub(crate) const INTERP_PERSPECTIVE: u8 = 0;\npub(crate) const INTERP_LINEAR: u8 = 1;\npub(crate) const INTERP_FLAT: u8 = 2;\n\n#[derive(Clone, Copy)] pub struct Binding { pub kind: u8, pub interp: u8, pub value: i64 }\n\n#[effects()]\npub(crate) fn no_binding() -> Binding {\n    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }\n}\n\npub(crate) const BI_POSITION: i64 = 0;\npub(crate) const BI_VERTEX_INDEX: i64 = 1;\npub(crate) const BI_INSTANCE_INDEX: i64 = 2;\npub(crate) const BI_FRONT_FACING: i64 = 3;\npub(crate) const BI_FRAG_DEPTH: i64 = 4;\npub(crate) const BI_SAMPLE_INDEX: i64 = 5;\npub(crate) const BI_SAMPLE_MASK: i64 = 6;\npub(crate) const BI_LOCAL_INVOCATION_ID: i64 = 7;\npub(crate) const BI_LOCAL_INVOCATION_INDEX: i64 = 8;\npub(crate) const BI_GLOBAL_INVOCATION_ID: i64 = 9;\npub(crate) const BI_WORKGROUP_ID: i64 = 10;\npub(crate) const BI_NUM_WORKGROUPS: i64 = 11;\n\n#[derive(Clone, Copy)] pub struct StructMember<'a> {\n");
    buf_str(out, c"    pub name: &'a [u8], pub ty: i64, pub offset: i64, pub binding: Binding,\n}\n\n// ---- Shader compiler implementation, ir: Expressions (0.22) ----\n\n// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)\npub(crate) const E_LITERAL: u8 = 0;\npub(crate) const E_ZERO: u8 = 1;\n// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a\n// matrix, elements, members\npub(crate) const E_COMPOSE: u8 = 2;\n// a: a scalar\npub(crate) const E_SPLAT: u8 = 3;\n// a: the vector; b: the components, 2 bits each from bit 0; c: how many\npub(crate) const E_SWIZZLE: u8 = 4;\n// a: base (a pointer or a value); b: the index expression; c: CK_*;\n// d: the length when the check is a clamp\npub(crate) const E_ACCESS: u8 = 5;\n// a: base (a pointer or a value); b: the constant index (a member, or a\n// component of a vector, matrix or fixed-size array, checked statically)\npub(crate) const E_ACCESS_INDEX: u8 = 6;\n// a: the parameter's index\npub(crate) const E_ARG: u8 = 7;\n// a: the global; its type is a pointer (a texture or sampler: the handle)\npub(crate) const E_GLOBAL: u8 = 8;\n// a: the local; a pointer<function>\npub(crate) const E_LOCAL: u8 = 9;\n// a: the pointer\npub(crate) const E_LOAD: u8 = 10;\n// a: UN_*; b: the operand\npub(crate) const E_UNARY: u8 = 11;\n// a: OP_*; b, c: the operands\npub(crate) const E_BINARY: u8 = 12;\n// a: the condition (bool, or a vector of bool); b: if true; c: if false\npub(crate) const E_SELECT: u8 = 13;\n// a: MF_*; b, c: args[b .. b + c]\npub(crate) const E_MATH: u8 = 14;\n// a: the operand; the type is the target (value conversion)\npub(crate) const E_CONVERT: u8 = 15;\n// a: the operand; the type is the target (bits)\npub(crate) const E_BITCAST: u8 = 16;\n// made by S_CALL\npub(crate) const E_CALL_RESULT: u8 = 17;\n// made by S_ATOMIC\npub(crate) const E_ATOMIC_RESULT: u8 = 18;\n// a: a pointer to a runtime-sized array (or a struct ending in one: b is\n// then the member index, else -1)\n");
    buf_str(out, c"pub(crate) const E_ARRAY_LENGTH: u8 = 19;\n// a: DV_*; b: the operand\npub(crate) const E_DERIVATIVE: u8 = 20;\n// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then\n// array index, bias/level/depth ref as `aux`): see IMG_*\npub(crate) const E_IMAGE_SAMPLE: u8 = 21;\n// a: the texture; c: args (coords, array index, level)\npub(crate) const E_IMAGE_LOAD: u8 = 22;\n// a: the texture; b: IQ_*; c: the level expression or -1\npub(crate) const E_IMAGE_QUERY: u8 = 23;\n// a: the pointer; made by S_WG_UNIFORM_LOAD\npub(crate) const E_WG_UNIFORM_RESULT: u8 = 24;\n\n// Bounds checks of E_ACCESS.\npub(crate) const CK_PENDING: i64 = 0;\n// proven in range: no check\npub(crate) const CK_NONE: i64 = 1;\n// fixed length d: index = min(index, d - 1)\npub(crate) const CK_CLAMP: i64 = 2;\n// runtime-sized: out of range, a load reads zero and a store is skipped\npub(crate) const CK_RZSW: i64 = 3;\n\npub(crate) const UN_NEG: i64 = 0;\npub(crate) const UN_NOT: i64 = 1;\npub(crate) const UN_BITNOT: i64 = 2;\n\npub(crate) const OP_ADD: i64 = 0;\npub(crate) const OP_SUB: i64 = 1;\npub(crate) const OP_MUL: i64 = 2;\npub(crate) const OP_DIV: i64 = 3;\npub(crate) const OP_MOD: i64 = 4;\npub(crate) const OP_EQ: i64 = 5;\npub(crate) const OP_NE: i64 = 6;\npub(crate) const OP_LT: i64 = 7;\npub(crate) const OP_LE: i64 = 8;\npub(crate) const OP_GT: i64 = 9;\npub(crate) const OP_GE: i64 = 10;\n// bitwise on integers; logical (both operands evaluated) on bool\npub(crate) const OP_AND: i64 = 11;\npub(crate) const OP_OR: i64 = 12;\npub(crate) const OP_XOR: i64 = 13;\npub(crate) const OP_SHL: i64 = 14;\npub(crate) const OP_SHR: i64 = 15;\n// short-circuit forms are lowered to control flow when the right side\n// has effects; else they are these, on bool\npub(crate) const OP_LAND: i64 = 16;\npub(crate) const OP_LOR: i64 = 17;\n\n// Math functions (E_MATH). Component-wise unless noted.\npub(crate) const MF_ABS: i64 = 0;\npub(crate) const MF_MIN: i64 = 1;\npub(crate) const MF_MAX: i64 = 2;\n");
    buf_str(out, c"pub(crate) const MF_CLAMP: i64 = 3;\npub(crate) const MF_SIGN: i64 = 4;\npub(crate) const MF_FLOOR: i64 = 5;\npub(crate) const MF_CEIL: i64 = 6;\npub(crate) const MF_ROUND: i64 = 7;\npub(crate) const MF_FRACT: i64 = 8;\npub(crate) const MF_TRUNC: i64 = 9;\npub(crate) const MF_SQRT: i64 = 10;\npub(crate) const MF_INVERSE_SQRT: i64 = 11;\npub(crate) const MF_EXP: i64 = 12;\npub(crate) const MF_EXP2: i64 = 13;\npub(crate) const MF_LOG: i64 = 14;\npub(crate) const MF_LOG2: i64 = 15;\npub(crate) const MF_POW: i64 = 16;\npub(crate) const MF_SIN: i64 = 17;\npub(crate) const MF_COS: i64 = 18;\npub(crate) const MF_TAN: i64 = 19;\npub(crate) const MF_ASIN: i64 = 20;\npub(crate) const MF_ACOS: i64 = 21;\npub(crate) const MF_ATAN: i64 = 22;\npub(crate) const MF_ATAN2: i64 = 23;\npub(crate) const MF_SINH: i64 = 24;\npub(crate) const MF_COSH: i64 = 25;\npub(crate) const MF_TANH: i64 = 26;\npub(crate) const MF_MIX: i64 = 27;\npub(crate) const MF_STEP: i64 = 28;\npub(crate) const MF_SMOOTHSTEP: i64 = 29;\npub(crate) const MF_FMA: i64 = 30;\n// the rest reduce or are not component-wise\npub(crate) const MF_LENGTH: i64 = 31;\npub(crate) const MF_DISTANCE: i64 = 32;\npub(crate) const MF_DOT: i64 = 33;\npub(crate) const MF_CROSS: i64 = 34;\npub(crate) const MF_NORMALIZE: i64 = 35;\npub(crate) const MF_REFLECT: i64 = 36;\npub(crate) const MF_DETERMINANT: i64 = 37;\npub(crate) const MF_TRANSPOSE: i64 = 38;\npub(crate) const MF_COUNT_ONE_BITS: i64 = 39;\npub(crate) const MF_COUNT_LEADING_ZEROS: i64 = 40;\npub(crate) const MF_COUNT_TRAILING_ZEROS: i64 = 41;\npub(crate) const MF_FIRST_LEADING_BIT: i64 = 42;\npub(crate) const MF_FIRST_TRAILING_BIT: i64 = 43;\npub(crate) const MF_REVERSE_BITS: i64 = 44;\npub(crate) const MF_EXTRACT_BITS: i64 = 45;\npub(crate) const MF_INSERT_BITS: i64 = 46;\npub(crate) const MF_ALL: i64 = 47;\npub(crate) const MF_ANY: i64 = 48;\npub(crate) const MF_DEGREES: i64 = 49;\npub(crate) const MF_RADIANS: i64 = 50;\npub(crate) const MF_SATURATE: i64 = 51;\n");
    buf_str(out, c"pub(crate) const MF_PACK4X8UNORM: i64 = 52;\npub(crate) const MF_UNPACK4X8UNORM: i64 = 53;\npub(crate) const MF_PACK2X16FLOAT: i64 = 54;\npub(crate) const MF_UNPACK2X16FLOAT: i64 = 55;\npub(crate) const MF_ASINH: i64 = 56;\npub(crate) const MF_ACOSH: i64 = 57;\npub(crate) const MF_ATANH: i64 = 58;\npub(crate) const MF_FACE_FORWARD: i64 = 59;\npub(crate) const MF_LDEXP: i64 = 60;\npub(crate) const MF_PACK4X8SNORM: i64 = 61;\npub(crate) const MF_UNPACK4X8SNORM: i64 = 62;\npub(crate) const MF_PACK2X16UNORM: i64 = 63;\npub(crate) const MF_UNPACK2X16UNORM: i64 = 64;\npub(crate) const MF_PACK2X16SNORM: i64 = 65;\npub(crate) const MF_UNPACK2X16SNORM: i64 = 66;\npub(crate) const MF_COUNT: i64 = 67;\n\npub(crate) const DV_DPDX: i64 = 0;\npub(crate) const DV_DPDY: i64 = 1;\npub(crate) const DV_FWIDTH: i64 = 2;\n\n// E_IMAGE_SAMPLE kinds (Expr.d's low byte) and its args: the coordinates,\n// then the array index when the texture is an array, then the kind's\n// operand (bias, level, depth reference).\npub(crate) const IMG_SAMPLE: i64 = 0;\npub(crate) const IMG_SAMPLE_BIAS: i64 = 1;\npub(crate) const IMG_SAMPLE_LEVEL: i64 = 2;\npub(crate) const IMG_SAMPLE_COMPARE: i64 = 3;\npub(crate) const IMG_SAMPLE_COMPARE_LEVEL: i64 = 4;\n\npub(crate) const IQ_SIZE: i64 = 0;\npub(crate) const IQ_LEVELS: i64 = 1;\npub(crate) const IQ_LAYERS: i64 = 2;\n\n#[derive(Clone, Copy)] pub struct Expr {\n    pub op: u8, pub ty: i64, pub a: i64, pub b: i64, pub c: i64, pub d: i64,\n}\n\n// ---- Shader compiler implementation, ir: Statements (0.22) ----\n\n// a .. b: the expressions evaluated here, in order\npub(crate) const S_EMIT: u8 = 0;\n// a: the block\npub(crate) const S_BLOCK: u8 = 1;\n// a: the condition; b: then; c: else (a block, possibly empty)\npub(crate) const S_IF: u8 = 2;\n// a: the selector (i32 or u32); b, c: cases[b .. b + c]\npub(crate) const S_SWITCH: u8 = 3;\n// a: body; b: continuing; c: the break-if expression, or -1 (evaluated\n// at the end of continuing, after its emits)\n");
    buf_str(out, c"pub(crate) const S_LOOP: u8 = 4;\npub(crate) const S_BREAK: u8 = 5;\npub(crate) const S_CONTINUE: u8 = 6;\n// a: the value, or -1\npub(crate) const S_RETURN: u8 = 7;\n// discard\npub(crate) const S_KILL: u8 = 8;\n// a: BARRIER_* bits\npub(crate) const S_BARRIER: u8 = 9;\n// a: the pointer; b: the value\npub(crate) const S_STORE: u8 = 10;\n// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1\npub(crate) const S_CALL: u8 = 11;\n// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;\n// e: the comparand (AT_CMPXCHG) or -1\npub(crate) const S_ATOMIC: u8 = 12;\n// a: the texture; b: the coordinates; c: the value; d: the array index or -1\npub(crate) const S_IMAGE_STORE: u8 = 13;\n// a: the pointer; b: the E_WG_UNIFORM_RESULT\npub(crate) const S_WG_UNIFORM_LOAD: u8 = 14;\n\npub(crate) const BARRIER_WORKGROUP: i64 = 1;\npub(crate) const BARRIER_STORAGE: i64 = 2;\n\npub(crate) const AT_ADD: i64 = 0;\npub(crate) const AT_SUB: i64 = 1;\npub(crate) const AT_AND: i64 = 2;\npub(crate) const AT_OR: i64 = 3;\npub(crate) const AT_XOR: i64 = 4;\npub(crate) const AT_MIN: i64 = 5;\npub(crate) const AT_MAX: i64 = 6;\npub(crate) const AT_EXCHANGE: i64 = 7;\npub(crate) const AT_LOAD: i64 = 8;\npub(crate) const AT_STORE: i64 = 9;\n// the result is __atomic_compare_exchange_result: { old_value, exchanged }\npub(crate) const AT_CMPXCHG: i64 = 10;\n\n#[derive(Clone, Copy)] pub struct Stmt {\n    pub op: u8, pub a: i64, pub b: i64, pub c: i64, pub d: i64, pub e: i64,\n}\n\n// A switch clause: its selector values (vals[vstart .. vstart + vcount]),\n// whether it is the default, its body.\n#[derive(Clone, Copy)] pub struct Case {\n    pub vstart: i64, pub vcount: i64, pub is_default: bool, pub body: i64,\n}\n\n// A run of statement handles: items[start .. start + count].\n#[derive(Clone, Copy)] pub struct Block { pub start: i64, pub count: i64 }\n\n#[derive(Clone, Copy)] pub struct Param<'a> {\n    pub name: &'a [u8], pub ty: i64, pub binding: Binding,\n}\n\n");
    buf_str(out, c"#[derive(Clone, Copy)] pub struct Local<'a> { pub name: &'a [u8], pub ty: i64 }\n\npub(crate) struct Function<'a, A: Allocator> {\n    pub(crate) name: &'a [u8],\n    pub(crate) params: Vec<Param<'a>, A>,\n    // -1: no result\n    pub(crate) result: i64,\n    pub(crate) result_binding: Binding,\n    pub(crate) locals: Vec<Local<'a>, A>,\n    pub(crate) exprs: Vec<Expr, A>,\n    // the names of `let` declarations: names[e] for expression e, or \"\"\n    pub(crate) names: Vec<&'a [u8], A>,\n    pub(crate) stmts: Vec<Stmt, A>,\n    pub(crate) blocks: Vec<Block, A>,\n    pub(crate) items: Vec<i64, A>,\n    pub(crate) args: Vec<i64, A>,\n    pub(crate) cases: Vec<Case, A>,\n    pub(crate) vals: Vec<i64, A>,\n    pub(crate) body: i64,\n    // the source position of the declaration (a byte offset)\n    pub(crate) pos: i64,\n}\n\n#[derive(Clone, Copy)] pub struct Global<'a> {\n    pub(crate) name: &'a [u8],\n    pub(crate) space: u8,\n    pub(crate) access: u8,\n    // the value's type (a texture, a sampler, or what the pointer points to)\n    pub(crate) ty: i64,\n    pub(crate) group: i64,\n    pub(crate) binding: i64,\n    // private globals: an expression of the module's init function, or -1\n    pub(crate) init: i64,\n    pub(crate) pos: i64,\n}\n\npub(crate) const STAGE_VERTEX: u8 = 0;\npub(crate) const STAGE_FRAGMENT: u8 = 1;\npub(crate) const STAGE_COMPUTE: u8 = 2;\n\n#[derive(Clone, Copy)] pub struct Entry<'a> {\n    pub(crate) stage: u8, pub name: &'a [u8], pub func: i64, pub wg: [i64; 3],\n    pub early_depth: bool,\n}\n\n#[derive(PartialEq, Eq, Hash, Clone, Copy)]\npub(crate) struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }\n\npub(crate) struct Module<'a, A: Allocator> {\n    pub(crate) types: Vec<Type<'a>, A>,\n    types_map: HashMap<TypeKey, i64, A>,\n    pub(crate) members: Vec<StructMember<'a>, A>,\n    pub(crate) globals: Vec<Global<'a>, A>,\n    pub(crate) functions: Vec<Function<'a, A>, A>,\n");
    buf_str(out, c"    pub(crate) entries: Vec<Entry<'a>, A>,\n    // private globals' initializers live in this function's expressions\n    // (literals, zero, compose only)\n    pub(crate) consts: Function<'a, A>,\n    pub(crate) a: A,\n}\n\n// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----\n\npub(crate) const T_BOOL: i64 = 0;\npub(crate) const T_I32: i64 = 1;\npub(crate) const T_U32: i64 = 2;\npub(crate) const T_F32: i64 = 3;\n\n// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four\n// concrete scalars\n#[effects()]\npub(crate) fn vec_ty(sk: u8, n: i64) -> i64 {\n    if n == 1 {\n        return sk as i64;\n    }\n    4 + (n - 2) * 4 + sk as i64\n}\n\n// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)\n#[effects()]\npub(crate) fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }\n\npub(crate) const T_FIXED_COUNT: i64 = 25;\n\n#[effects(A)]\npub(crate) fn new_function<'a, A: Allocator + Copy>(name: &'a [u8], a: A) -> Function<'a, A> {\n    Function {\n        name: name,\n        params: Vec::new_in(a),\n        result: -1,\n        result_binding: no_binding(),\n        locals: Vec::new_in(a),\n        exprs: Vec::new_in(a),\n        names: Vec::new_in(a),\n        stmts: Vec::new_in(a),\n        blocks: Vec::new_in(a),\n        items: Vec::new_in(a),\n        args: Vec::new_in(a),\n        cases: Vec::new_in(a),\n        vals: Vec::new_in(a),\n        body: -1,\n        pos: 0,\n    }\n}\n\nfn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }\n\nimpl<'a, A: Allocator + Copy> Module<'a, A> {\n    #[effects(A)]\n    pub(crate) fn new(a: A) -> Module<'a, A> {\n        let mut m = Module {\n            types: Vec::new_in(a),\n            types_map: HashMap::new_in(a),\n            members: Vec::new_in(a),\n            globals: Vec::new_in(a),\n            functions: Vec::new_in(a),\n            entries: Vec::new_in(a),\n            consts: new_function(b\"\", a),\n            a: a,\n        };\n        for sk in 0..4 {\n");
    buf_str(out, c"            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);\n        }\n        for n in 2..5 {\n            for sk in 0..4 {\n                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);\n            }\n        }\n        for c in 2..5 {\n            for r in 2..5 {\n                m.push_type(TK_MATRIX, SK_F32, c, r, -1);\n            }\n        }\n        m\n    }\n\n    fn push_type(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {\n        let mut t = Type {\n            kind: kind,\n            scalar: sk,\n            space: 0,\n            access: 0,\n            n: n,\n            m: mm,\n            base: base,\n            mstart: 0,\n            mcount: 0,\n            name: b\"\",\n            size: 4,\n            align: 4,\n            stride: 0,\n        };\n        if kind == TK_VECTOR {\n            t.size = 4 * n;\n            t.align = if n == 2 { 8 } else { 16 };\n        } else if kind == TK_MATRIX {\n            let col_align: i64 = if mm == 2 { 8 } else { 16 };\n            t.align = col_align;\n            t.stride = round_up(4 * mm, col_align);\n            t.size = n * t.stride;\n        }\n        self.types.push(t);\n        self.types.len() as i64 - 1\n    }\n\n    // The handle of a type made of these parts, made once.\n    #[effects(panic, A)]\n    pub(crate) fn intern(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,\n        access: u8) -> i64 {\n        if kind == TK_SCALAR {\n            return sk as i64;\n        }\n        if kind == TK_VECTOR {\n            return vec_ty(sk, n);\n        }\n        if kind == TK_MATRIX {\n            return mat_ty(n, mm);\n        }\n        let key = TypeKey {\n            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base,\n        };\n        if let Some(h) = self.types_map.get(&key).copied() {\n            return h;\n        }\n        let h = self.push_type(kind, sk, n, mm, base);\n        self.types[h as usize].space = space;\n");
    buf_str(out, c"        self.types[h as usize].access = access;\n        if kind == TK_ARRAY {\n            let el = self.types[base as usize];\n            let stride = round_up(el.size, el.align);\n            self.types[h as usize].align = el.align;\n            self.types[h as usize].stride = stride;\n            self.types[h as usize].size = if n == 0 { stride } else { stride * n };\n        } else if kind == TK_POINTER {\n            self.types[h as usize].size = 8;\n            self.types[h as usize].align = 8;\n        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {\n            self.types[h as usize].size = 8;\n            self.types[h as usize].align = 8;\n        }\n        self.types_map.insert(key, h);\n        h\n    }\n\n    #[effects(A)]\n    pub(crate) fn array_ty(&mut self, elem: i64, n: i64) -> i64 {\n        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)\n    }\n\n    #[effects(A)]\n    pub(crate) fn ptr_ty(&mut self, pointee: i64, space: u8, access: u8) -> i64 {\n        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)\n    }\n\n    #[effects(A)]\n    pub(crate) fn atomic_ty(&mut self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }\n\n    // A struct type: a new handle for each declaration (structs are\n    // nominal); members[mstart ..] must already be pushed, offsets unset.\n    #[effects(panic, A)]\n    pub(crate) fn struct_ty(&mut self, name: &'a [u8], mstart: i64, mcount: i64) -> i64 {\n        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);\n        let mut off: i64 = 0;\n        let mut al: i64 = 4;\n        for i in mstart..mstart + mcount {\n            let t = self.types[self.members[i as usize].ty as usize];\n            off = round_up(off, t.align);\n            self.members[i as usize].offset = off;\n            off += t.size;\n            if t.align > al {\n                al = t.align;\n            }\n        }\n        self.types[h as usize].name = name;\n        self.types[h as usize].mstart = mstart;\n");
    buf_str(out, c"        self.types[h as usize].mcount = mcount;\n        self.types[h as usize].align = al;\n        self.types[h as usize].size = round_up(off, al);\n        h\n    }\n\n    // The scalar kind of a scalar, vector, matrix or atomic type.\n    pub(crate) fn scalar_of(&self, t: i64) -> u8 { self.types[t as usize].scalar }\n\n    // The component count of a scalar (1) or vector type, else 0.\n    #[effects(panic, A)]\n    pub(crate) fn width_of(&self, t: i64) -> i64 {\n        let k = self.types[t as usize].kind;\n        if k == TK_SCALAR {\n            1\n        } else if k == TK_VECTOR {\n            self.types[t as usize].n\n        } else {\n            0\n        }\n    }\n\n    // The pointee of a pointer type, else -1.\n    #[effects(panic, A)]\n    pub(crate) fn pointee(&self, t: i64) -> i64 {\n        if self.types[t as usize].kind == TK_POINTER {\n            self.types[t as usize].base\n        } else {\n            -1\n        }\n    }\n\n    // The type of a component of t when indexed: a vector's scalar, a\n    // matrix's column, an array's element; -1 for the others.\n    #[effects(panic, A)]\n    pub(crate) fn elem_of(&self, t: i64) -> i64 {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_VECTOR {\n            ty.scalar as i64\n        } else if ty.kind == TK_MATRIX {\n            vec_ty(SK_F32, ty.m)\n        } else if ty.kind == TK_ARRAY {\n            ty.base\n        } else {\n            -1\n        }\n    }\n\n    // How many components indexing t can reach: 0 for a runtime-sized array.\n    #[effects(panic, A)]\n    pub(crate) fn index_len(&self, t: i64) -> i64 {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {\n            ty.n\n        } else if ty.kind == TK_MATRIX {\n            ty.n\n        } else {\n            -1\n        }\n    }\n\n    // Whether t is or holds a runtime-sized array.\n    #[effects(panic, A)]\n");
    buf_str(out, c"    pub(crate) fn is_runtime_sized(&self, t: i64) -> bool {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_ARRAY {\n            return ty.n == 0;\n        }\n        if ty.kind == TK_STRUCT && ty.mcount > 0 {\n            return self.is_runtime_sized(self.members[(ty.mstart + ty.mcount - 1) as usize].ty);\n        }\n        false\n    }\n\n    // Whether t contains an atomic (such types cannot be loaded whole).\n    #[effects(panic, A)]\n    pub(crate) fn has_atomic(&self, t: i64) -> bool {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.has_atomic(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if self.has_atomic(self.members[i as usize].ty) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The type written as WGSL, for messages and the IR dump.\n    #[effects(alloc(extern), io, static, panic, diverge, A, B)]\n    pub(crate) fn type_name<B: Allocator>(&self, t: i64, b: &mut Vec<u8, B>) {\n        if t < 0 {\n            b.extend_from_slice(b\"void\");\n            return;\n        }\n        let ty = self.types[t as usize];\n        if ty.kind == TK_SCALAR {\n            b.extend_from_slice(scalar_name(ty.scalar));\n        } else if ty.kind == TK_VECTOR {\n            write(b, \"vec{}<{}>\", ty.n, str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n        } else if ty.kind == TK_MATRIX {\n            write(b, \"mat{}x{}<f32>\", ty.n, ty.m).unwrap();\n        } else if ty.kind == TK_ARRAY {\n            b.extend_from_slice(b\"array<\");\n            self.type_name(ty.base, b);\n            if ty.n > 0 {\n                write(b, \", {}\", ty.n).unwrap();\n            }\n            b.push(b'>');\n        } else if ty.kind == TK_STRUCT {\n");
    buf_str(out, c"            b.extend_from_slice(ty.name);\n        } else if ty.kind == TK_ATOMIC {\n            write(b, \"atomic<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n        } else if ty.kind == TK_POINTER {\n            write(b, \"ptr<{}, \", str::from_utf8(space_name(ty.space)).unwrap()).unwrap();\n            self.type_name(ty.base, b);\n            if ty.space == SP_STORAGE {\n                b.extend_from_slice((if ty.access == ACC_RW { b\", read_write\" }\n                    else { b\", read\" }));\n            }\n            b.push(b'>');\n        } else if ty.kind == TK_TEXTURE {\n            if ty.n == TEX_2D {\n                write(b, \"texture_2d<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n            } else if ty.n == TEX_2D_ARRAY {\n                write(b, \"texture_2d_array<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n            } else if ty.n == TEX_DEPTH_2D {\n                b.extend_from_slice(b\"texture_depth_2d\");\n            } else {\n                write(b, \"texture_storage_2d<{}, write>\",\n                    str::from_utf8(format_name(ty.m)).unwrap()).unwrap();\n            }\n        } else if ty.n == 1 {\n            b.extend_from_slice(b\"sampler_comparison\");\n        } else {\n            b.extend_from_slice(b\"sampler\");\n        }\n    }\n}\n\n#[effects()]\npub(crate) fn scalar_name(sk: u8) -> &'static [u8] {\n    if sk == SK_BOOL {\n        b\"bool\"\n    } else if sk == SK_I32 {\n        b\"i32\"\n    } else if sk == SK_U32 {\n        b\"u32\"\n    } else if sk == SK_F32 {\n        b\"f32\"\n    } else if sk == SK_AINT {\n        b\"abstract-int\"\n    } else {\n        b\"abstract-float\"\n    }\n}\n\n#[effects()]\npub(crate) fn space_name(sp: u8) -> &'static [u8] {\n    if sp == SP_FUNCTION {\n        b\"function\"\n    } else if sp == SP_PRIVATE {\n        b\"private\"\n    } else if sp == SP_WORKGROUP {\n        b\"workgroup\"\n");
    buf_str(out, c"    } else if sp == SP_UNIFORM {\n        b\"uniform\"\n    } else if sp == SP_STORAGE {\n        b\"storage\"\n    } else {\n        b\"handle\"\n    }\n}\n\n#[effects()]\npub(crate) fn format_name(f: i64) -> &'static [u8] {\n    if f == FMT_RGBA8UNORM {\n        b\"rgba8unorm\"\n    } else if f == FMT_RGBA32FLOAT {\n        b\"rgba32float\"\n    } else if f == FMT_R32FLOAT {\n        b\"r32float\"\n    } else if f == FMT_R32UINT {\n        b\"r32uint\"\n    } else if f == FMT_R32SINT {\n        b\"r32sint\"\n    } else if f == FMT_RGBA16FLOAT {\n        b\"rgba16float\"\n    } else if f == FMT_RGBA8UINT {\n        b\"rgba8uint\"\n    } else if f == FMT_RG32FLOAT {\n        b\"rg32float\"\n    } else {\n        b\"rgba32uint\"\n    }\n}\n\n// ---- Shader compiler implementation, ir: Building functions (0.22) ----\n\nimpl<'a, A: Allocator + Copy> Function<'a, A> {\n    #[effects(A)]\n    pub(crate) fn expr(&mut self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {\n        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });\n        self.names.push(b\"\");\n        self.exprs.len() as i64 - 1\n    }\n\n    #[effects(A)]\n    pub(crate) fn stmt(&mut self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });\n        self.stmts.len() as i64 - 1\n    }\n\n    // A block of the statements pending[from ..], which are removed from\n    // pending.\n    #[effects(panic, A)]\n    pub(crate) fn block_of(&mut self, pending: &mut Vec<i64, A>, from: i64) -> i64 {\n        let start = self.items.len() as i64;\n        for i in from..pending.len() as i64 {\n            self.items.push(pending[i as usize]);\n        }\n        let count = pending.len() as i64 - from;\n        pending.truncate(from as usize);\n        self.blocks.push(Block { start: start, count: count });\n        self.blocks.len() as i64 - 1\n    }\n\n    #[effects(A)]\n    pub(crate) fn empty_block(&mut self) -> i64 {\n");
    buf_str(out, c"        self.blocks.push(Block { start: self.items.len() as i64, count: 0 });\n        self.blocks.len() as i64 - 1\n    }\n\n    pub(crate) fn arg(&self, i: i64) -> i64 { self.args[i as usize] }\n\n    pub(crate) fn item(&self, blk: i64, i: i64) -> i64 { self.items[\n        (self.blocks[blk as usize].start + i) as usize] }\n}\n\n// The byte offsets of function h's parameters in a record holding them\n// all, each at its alignment (WGSL's layout); the record's size, rounded\n// to 16, is the last element.\npub(crate) fn record_offsets<A: Allocator + Copy>(m: &Module<'_, A>, h: i64, a: A) -> Vec<i64, A> {\n    let mut offs: Vec<i64, A> = Vec::new_in(a);\n    let mut off: i64 = 0;\n    let f = &m.functions[h as usize];\n    for k in 0..f.params.len() as i64 {\n        let t = m.types[f.params[k as usize].ty as usize];\n        off = round_up(off, t.align);\n        offs.push(off);\n        off += t.size;\n    }\n    offs.push(round_up(off, 16));\n    offs\n}\n\n// The bytes a value of type t takes in an array of them (its stride).\npub(crate) fn stride_of<A: Allocator + Copy>(m: &Module<'_, A>, t: i64) -> i64 {\n    let ty = m.types[t as usize];\n    round_up(ty.size, ty.align)\n}\n\n// Statements and expressions that end a block's flow.\n#[effects()]\npub(crate) fn is_terminator(op: u8) -> bool {\n    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL\n}\n\n// The bits of an f32, and back.\n#[effects()]\npub(crate) fn f32_bits(f: f32) -> u32 { f.to_bits() }\n\n#[effects()]\npub(crate) fn bits_f32(u: u32) -> f32 { f32::from_bits(u) }\n\n#[effects()]\npub(crate) fn f64_bits(f: f64) -> u64 { f.to_bits() }\n// ---- end mod std::gpu::wgsl::ir ----\n}\n// ---- mod std::gpu::wgsl::names ----\nmod names {\n// EDITION: rust\n// ---- Shader compiler implementation, names (0.22) ----\n// The predeclared names of WGSL: keywords, types, attributes and builtins.\n// The lexer interns them first, so each has the fixed symbol below. The\n");
    buf_str(out, c"// math functions are in MF_* order (ir.vl): K_ABS + MF_x is MF_x's name.\n\npub(crate) const PREDECLARED: [&[u8]; 237] = [\n    b\"fn\",\n    b\"let\",\n    b\"var\",\n    b\"const\",\n    b\"struct\",\n    b\"return\",\n    b\"if\",\n    b\"else\",\n    b\"for\",\n    b\"while\",\n    b\"loop\",\n    b\"break\",\n    b\"continue\",\n    b\"continuing\",\n    b\"switch\",\n    b\"case\",\n    b\"default\",\n    b\"discard\",\n    b\"true\",\n    b\"false\",\n    b\"alias\",\n    b\"override\",\n    b\"enable\",\n    b\"requires\",\n    b\"diagnostic\",\n    b\"const_assert\",\n    b\"fallthrough\",\n    b\"bool\",\n    b\"i32\",\n    b\"u32\",\n    b\"f32\",\n    b\"f16\",\n    b\"vec2\",\n    b\"vec3\",\n    b\"vec4\",\n    b\"vec2i\",\n    b\"vec3i\",\n    b\"vec4i\",\n    b\"vec2u\",\n    b\"vec3u\",\n    b\"vec4u\",\n    b\"vec2f\",\n    b\"vec3f\",\n    b\"vec4f\",\n    b\"vec2h\",\n    b\"vec3h\",\n    b\"vec4h\",\n    b\"mat2x2\",\n    b\"mat2x3\",\n    b\"mat2x4\",\n    b\"mat3x2\",\n    b\"mat3x3\",\n    b\"mat3x4\",\n    b\"mat4x2\",\n    b\"mat4x3\",\n    b\"mat4x4\",\n    b\"mat2x2f\",\n    b\"mat2x3f\",\n    b\"mat2x4f\",\n    b\"mat3x2f\",\n    b\"mat3x3f\",\n    b\"mat3x4f\",\n    b\"mat4x2f\",\n    b\"mat4x3f\",\n    b\"mat4x4f\",\n    b\"array\",\n    b\"atomic\",\n    b\"ptr\",\n    b\"sampler\",\n    b\"sampler_comparison\",\n    b\"texture_2d\",\n    b\"texture_2d_array\",\n    b\"texture_depth_2d\",\n    b\"texture_storage_2d\",\n    b\"texture_1d\",\n    b\"texture_3d\",\n    b\"texture_cube\",\n    b\"texture_cube_array\",\n    b\"texture_multisampled_2d\",\n    b\"texture_depth_2d_array\",\n    b\"texture_depth_cube\",\n    b\"texture_external\",\n    b\"texture_storage_1d\",\n    b\"texture_storage_3d\",\n    b\"texture_storage_2d_array\",\n    b\"function\",\n    b\"private\",\n    b\"workgroup\",\n    b\"uniform\",\n    b\"storage\",\n    b\"read\",\n    b\"write\",\n    b\"read_write\",\n    b\"rgba8unorm\",\n    b\"rgba32float\",\n");
    buf_str(out, c"    b\"r32float\",\n    b\"r32uint\",\n    b\"r32sint\",\n    b\"rgba32uint\",\n    b\"vertex\",\n    b\"fragment\",\n    b\"compute\",\n    b\"workgroup_size\",\n    b\"builtin\",\n    b\"location\",\n    b\"group\",\n    b\"binding\",\n    b\"interpolate\",\n    b\"flat\",\n    b\"linear\",\n    b\"perspective\",\n    b\"center\",\n    b\"centroid\",\n    b\"sample\",\n    b\"align\",\n    b\"size\",\n    b\"id\",\n    b\"invariant\",\n    b\"must_use\",\n    b\"position\",\n    b\"vertex_index\",\n    b\"instance_index\",\n    b\"front_facing\",\n    b\"frag_depth\",\n    b\"sample_index\",\n    b\"sample_mask\",\n    b\"local_invocation_id\",\n    b\"local_invocation_index\",\n    b\"global_invocation_id\",\n    b\"workgroup_id\",\n    b\"num_workgroups\",\n    b\"abs\",\n    b\"min\",\n    b\"max\",\n    b\"clamp\",\n    b\"sign\",\n    b\"floor\",\n    b\"ceil\",\n    b\"round\",\n    b\"fract\",\n    b\"trunc\",\n    b\"sqrt\",\n    b\"inverseSqrt\",\n    b\"exp\",\n    b\"exp2\",\n    b\"log\",\n    b\"log2\",\n    b\"pow\",\n    b\"sin\",\n    b\"cos\",\n    b\"tan\",\n    b\"asin\",\n    b\"acos\",\n    b\"atan\",\n    b\"atan2\",\n    b\"sinh\",\n    b\"cosh\",\n    b\"tanh\",\n    b\"mix\",\n    b\"step\",\n    b\"smoothstep\",\n    b\"fma\",\n    b\"length\",\n    b\"distance\",\n    b\"dot\",\n    b\"cross\",\n    b\"normalize\",\n    b\"reflect\",\n    b\"determinant\",\n    b\"transpose\",\n    b\"countOneBits\",\n    b\"countLeadingZeros\",\n    b\"countTrailingZeros\",\n    b\"firstLeadingBit\",\n    b\"firstTrailingBit\",\n    b\"reverseBits\",\n    b\"extractBits\",\n    b\"insertBits\",\n    b\"all\",\n    b\"any\",\n    b\"degrees\",\n    b\"radians\",\n    b\"saturate\",\n    b\"pack4x8unorm\",\n    b\"unpack4x8unorm\",\n    b\"pack2x16float\",\n    b\"unpack2x16float\",\n    b\"asinh\",\n    b\"acosh\",\n    b\"atanh\",\n    b\"faceForward\",\n    b\"ldexp\",\n    b\"pack4x8snorm\",\n    b\"unpack4x8snorm\",\n    b\"pack2x16unorm\",\n");
