    buf_str(out, c"    &))&&&&&&&&&)&&&&&)))&&&&&&&&&&&\\\n    &)))&&&&&&&&)))&&)&)&&&&)&&&&&&)\\\n    &&&)&&&&&&);;;;;;;;;;;&&&&&);)))\\\n    ;;;&&;;;;;\\x45\\x45;;;;))))))&&&)&;;\\x45\\x45\\x45\\\n    )&&);;;;;;;;;\\x45\\x45\\x45&&&&&&&&&&<&\\x45\\x45\\x45\\x45\\\n    ;;;;;;;;;;;;\\x45\\x45\\x45\\x45;&&&&&&&&&&&&&&&\\\n    &&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&&&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&&&&&&\\x45\\x45&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\\n    &&&&&&&&&\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&&&&&&&&&&&;;;;\\\n    ;;;;;;;;;;;&;;;;;;;;;;&;;;;;;;;;\\\n    ;;;;;;;;;;;;;\\x45\\x45\\x45;;;;;;;\\x45;\\x45\\x45\\x45;;;;\\\n    ;;;;;;;;;;;;;;\\x45;;;;;;;;;;;;;\\x45\\x45\\x45;\\\n    ;;;;;;;;;;;\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45\\x45&&\\\n    <<<<<<<<<<<<<<&&\";\n// ---- end mod std::unicode ----\n}\n// ---- mod std::io ----\npub mod io {\n// EDITION: rust\n// std::io: Read, Write and BufRead, the buffered types, the standard\n// streams, Error. Rust's shape: counts are usize, `read_line` is\n// Stdin's (and BufRead's) and returns the bytes read (0 at the end), and\n// what reads into a growing buffer takes the buffer (`read_to_end(&mut\n// v)`, which grows from v's allocator) or an allocator (`lines_in(a)`,\n// `read_to_string_in(r, a)`). The buffered types hold a fixed buffer\n// inline, so making one allocates nothing. Seek and SeekFrom are here, as\n// Rust's; the file types are std::fs's.\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// io's Result: an io::Error on failure.\n// mvs: Result\npub type Result<T> = crate::result::Result<T, Error>;\n\n// What failed: a kind, and the OS's error number when it came from one.\n// mvs: Error, IoError\n");
    buf_str(out, c"// std2: changed: Rust's io::Error (MVS's root IoError is gone into it)\npub struct Error {\n    kind: ErrorKind,\n    code: i32,\n    msg: &'static str,\n}\n\nimpl Error {\n    // An error of kind k, with a message (Rust's takes any error; vole's a\n    // static text: no allocation, no dyn).\n    // std2: changed: a message, &'static str\n    #[effects()]\n    pub fn new(k: ErrorKind, msg: &'static str) -> Error {\n        Error { kind: k, code: 0, msg: msg }\n    }\n\n    // An error of kind Other, with a message.\n    #[effects()]\n    pub fn other(msg: &'static str) -> Error {\n        Error::new(ErrorKind::Other, msg)\n    }\n\n    // The error errno says.\n    #[effects()]\n    pub fn from_raw_os_error(code: i32) -> Error {\n        Error { kind: kind_of_errno(code), code: code, msg: \"\" }\n    }\n\n    // The error of the last failed OS call (errno).\n    #[effects(static, unsafe)]\n    pub fn last_os_error() -> Error {\n        // UNSAFE: errno, read through libc's pointer to this thread's copy.\n        // SAFETY: __error returns a valid pointer to the calling thread's\n        // errno, an i32.\n        let code = unsafe { *__error() };\n        Error::from_raw_os_error(code)\n    }\n\n    #[effects()]\n    pub fn kind(&self) -> ErrorKind {\n        self.kind\n    }\n\n    #[effects()]\n    pub fn raw_os_error(&self) -> Option<i32> {\n        if self.code == 0 { Option::None } else { Option::Some(self.code) }\n    }\n}\n\n// mvs: Error::impl Display, IoError::impl Display\nimpl Display for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.write_str(os_message(self.code))?;\n            f.write_str(\" (os error \")?;\n            f.write_fmt(self.code)?;\n            f.write_str(\")\")\n        } else if !self.msg.is_empty() {\n            f.write_str(self.msg)\n        } else {\n            crate::fmt::Display::fmt(&self.kind, f)\n        }\n    }\n}\n\n");
    buf_str(out, c"// mvs: Error::impl Debug, IoError::impl Debug\nimpl Debug for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.debug_struct(\"Os\")\n                .field(\"code\", &self.code)\n                .field(\"kind\", &self.kind)\n                .field(\"message\", &os_message(self.code))\n                .finish()\n        } else if !self.msg.is_empty() {\n            f.debug_struct(\"Custom\").field(\"kind\", &self.kind).field(\"error\", &self.msg).finish()\n        } else {\n            f.debug_tuple(\"Kind\").field(&self.kind).finish()\n        }\n    }\n}\n\nimpl From<ErrorKind> for Error {\n    fn from(k: ErrorKind) -> Error {\n        Error::new(k, \"\")\n    }\n}\n\n// The ErrorKind of an errno (macOS's numbers; Linux's differ above 34 and\n// come with the sys tail).\nfn kind_of_errno(code: i32) -> ErrorKind {\n    match code {\n        1 | 13 => ErrorKind::PermissionDenied,\n        2 => ErrorKind::NotFound,\n        4 => ErrorKind::Interrupted,\n        12 => ErrorKind::OutOfMemory,\n        17 => ErrorKind::AlreadyExists,\n        20 => ErrorKind::NotADirectory,\n        21 => ErrorKind::IsADirectory,\n        22 => ErrorKind::InvalidInput,\n        32 => ErrorKind::BrokenPipe,\n        35 => ErrorKind::WouldBlock,\n        45 | 78 => ErrorKind::Unsupported,\n        60 => ErrorKind::TimedOut,\n        63 => ErrorKind::InvalidFilename,\n        66 => ErrorKind::DirectoryNotEmpty,\n        _ => ErrorKind::Other,\n    }\n}\n\n// The OS's text for an errno (C's strerror), or \"\" when it is not UTF-8.\nfn os_message(code: i32) -> &'static str {\n    // UNSAFE: strerror's C string, read through its raw pointer.\n    // SAFETY: strerror returns a NUL-terminated string that lives as long\n    // as the process (macOS's table; the bytes up to the NUL are read, no\n    // further).\n    unsafe {\n        let p = strerror(code);\n        let mut n: usize = 0;\n        while *p.add(n) != 0 {\n");
    buf_str(out, c"            n += 1;\n        }\n        match crate::str::from_utf8(crate::slice::from_raw_parts(p, n)) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n}\n\n// What a read appended to v from start: kept when it is UTF-8, cut off\n// with InvalidData when not (read_to_string's and read_line's check).\nfn append_utf8<A: Allocator>(v: &mut Vec<u8, A>, start: usize, r: Result<usize>) -> Result<usize> {\n    if crate::str::from_utf8(&v.as_slice()[start..]).is_err() {\n        v.truncate(start);\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidData,\n            \"stream did not contain valid UTF-8\"));\n    }\n    r\n}\n\n// Write::write_fmt's sink: a fmt::Write over an io::Write that keeps the\n// io::Error a write gave (fmt::Error carries nothing).\nstruct Adapter<'a, W: ?Sized> {\n    inner: &'a mut W,\n    error: Result<()>,\n}\n\nimpl<'a, W: Write + ?Sized> crate::fmt::Write for Adapter<'a, W> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        match self.inner.write_all(s.as_bytes()) {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(e) => {\n                self.error = crate::result::Result::Err(e);\n                crate::result::Result::Err(crate::fmt::Error {})\n            }\n        }\n    }\n}\n\n// UNSAFE: the OS's calls under the standard streams and io::Error.\n// SAFETY: read and write take a buffer of n bytes they may read or fill;\n// __error returns this thread's errno; strerror a static C string. The\n// callers below pass slices' pointers and lengths.\nextern \"C\" {\n    #[link_name = \"read\"]\n    fn c_read(fd: i32, buf: *mut u8, n: usize) -> isize;\n    #[link_name = \"write\"]\n    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;\n    fn __error() -> *mut i32;\n    fn strerror(code: i32) -> *const u8;\n}\n\n// Up to buf.len() bytes from fd.\n");
