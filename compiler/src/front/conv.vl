// What is left of 0.20's parameter conventions (docs/design/conventions.md
// is that design, history now): the coded errors `conv.set`,
// `conv.mode_order` and `conv.rust` (`std::env::var`), the refusals of
// the old spellings' options and pragma, and which positions are the
// program's own (user_at). (0.29) The conventions themselves went with the
// old edition in 0.28.0, and their flags (CONV_NEW, CONV_INOUT, CONV_SINK),
// a parameter's convention (param_conv and what asked it), the access
// locals and fields and the mixed reading (VOLE_SYNTAX) with them: a
// parameter's type is the type written.

use crate::base::{buf_bytes, buf_copy, buf_int, buf_new, buf_ptr, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fix, err_fmt, err_help, err_try_tool};
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{file_made, file_of_pos, file_path, within_std};
use crate::front::types::TyKind;

// The bootstrap's pragma of 0.20 (its root file's first bytes): from 0.21
// an error, syntax.legacy_removed.
pub const LEGACY_MARKER: &[u8] = b"// vole-syntax: 0.19";

// The codes (tools/explain/conv_table.vl).
pub const CODE_RUST: *mut u8 = c"conv.rust";
pub const CODE_SET: *mut u8 = c"conv.set";
pub const CODE_LEGACY_REMOVED: *mut u8 = c"syntax.legacy_removed";

// `--syntax=0.20`: accepted, and says nothing (there is one spelling);
// `--syntax=mixed` is refused (0.21). False when arg is not that option.
pub fn syntax_option(arg: &str, _pcx: &mut Ctx<Comp>) -> bool {
    if arg == "--syntax=0.20" {
        return true;
    }
    if arg == "--syntax=mixed" {
        crate::base::die(c"syntax.mixed_removed: no build, check or run reads 0.19's spelling (0.21): Rust's spellings are conv.rust errors, each with its fix (volec fix --suggested); `volec fix --only conventions` migrates 0.19 code");
    }
    false
}

// UNSAFE: POSIX's getpid and getppid: the syntax option reaches a child compiler through the
// environment, keyed by process id.
// SAFETY: each declaration is the function's C prototype on the targets vole builds for (64-bit
// macOS and Linux: pid_t is i32), under a link_name so that the names stay this module's;
// neither takes an argument.
extern "C" {
    #[link_name = "getppid"]
    fn conv_getppid() -> i32;
}

// Before parsing: a root that starts with the 0.20 bootstrap's pragma is
// syntax.legacy_removed (0.21: the legacy mode is gone).
pub fn conv_setup(pcx: &mut Ctx<Comp>) {
    pcx.cache_file = -1;
    if pcx.files.len() == 0 {
        return;
    }
    let s = pcx.files[0].start;
    let n = LEGACY_MARKER.len() as i64;
    if pcx.files[0].end - s >= n && get_src()[s as usize..(s + n) as usize] == LEGACY_MARKER {
        conv_error(CODE_LEGACY_REMOVED, s, s + n,
            b"'// vole-syntax: 0.19' was a pragma of the 0.20 bootstrap: there is one language",
            b"delete the line",
            b"", pcx);
    }
}

// Whether pos is in a file of the program's own crate (not std's, not a
// generated source).
pub fn user_at(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.cache_file >= 0 && pos >= pcx.cache_start && pos < pcx.cache_end {
        return pcx.cache_user;
    }
    let f = file_of_pos(pos, pcx);
    // (the path's facts first: the view of it ends before pcx is written)
    let p = file_path(f, pcx);
    let generated = p.starts_with(b"<");
    // (std's files and its built-in text, `<std>`; not the virtual
    // modules the compiler writes, `<std::arch::aarch64>`, in 0.19's
    // spelling until compiler/src migrates)
    let virtual_module = generated && p.len() > 4 && p[4] == b':';
    // (0.27.2: the builtin impls' text, `<builtin>`, is the rust
    // edition's, as the trait it is made for: front/builtin_impls.vl)
    let made = generated && !p.starts_with(b"<builtin>");
    // RULE: Z1.2 (0.27.2: a rust program's derives on std, `<derive>`, are
    // the rust edition's: front/derive/rust.vl)
    let derive_text = p.starts_with(b"<derive>");
    // (0.28.0: a rust program's test code on std, `<test>`, is the
    // rust edition's too: front/tests/mod.vl's rust_text)
    let test_text = p.starts_with(b"<test>");
    pcx.cache_file = f;
    pcx.cache_start = pcx.files[f as usize].start;
    pcx.cache_end = pcx.files[f as usize].end;
    pcx.cache_std = within_std(pcx.files[f as usize].module, pcx) && !virtual_module;
    pcx.cache_user = (!made || derive_text || test_text) && !pcx.cache_std;
    pcx.cache_user
}

// Whether token i is the identifier `word` (`inout`, `sink`, `var`: words
// of 0.20 that are not keywords until 0.21, conventions.md D27).
pub fn word_at(i: i64, word: &[u8], pcx: &Ctx<Comp>) -> bool {
    pcx.toks[i as usize].kind == Tok::Ident
        && sym_text(pcx.toks[i as usize].value as i64, pcx) == word
}

// Whether token kind k can start a type.
pub fn starts_type(k: Tok) -> bool {
    k == Tok::Ident || k == Tok::Star || k == Tok::LParen || k == Tok::LBracket || k == Tok::Fn
        || k == Tok::Amp || k == Tok::AmpAmp || k == Tok::Bang || k == Tok::Extern
        || k == Tok::Let
}

// ---- Diagnostics ----

// `try: volec edit patch FILE:LINE --old 'OLD' --new 'NEW'` for the
// error at pos; none in a generated source or for text a shell word
// cannot hold.
pub fn try_patch(pos: i64, old: &[u8], new: &[u8], pcx: &Ctx<Comp>) {
    let f = file_of_pos(pos, pcx);
    let path = file_path(f, pcx);
    if file_made(f, pcx) || unquotable(old) || unquotable(new) {
        return;
    }
    let mut line: i64 = 1;
    for i in pcx.files[f as usize].start..pos {
        if get_src()[i as usize] == b'\n' {
            line += 1;
        }
    }
    let a = buf_new();
    buf_str(a, c"edit patch ");
    buf_bytes(a, if path.starts_with(b"./") { &path[2..] } else { path });
    buf_bytes(a, b":");
    buf_int(a, line);
    buf_bytes(a, b" --old '");
    buf_bytes(a, old);
    buf_bytes(a, b"' --new '");
    buf_bytes(a, new);
    buf_bytes(a, b"'");
    err_try_tool(&buf_copy(a), false, pcx);
}

fn unquotable(s: &[u8]) -> bool {
    for i in 0..s.len() {
        if s[i] == b'\'' || s[i] == b'\n' {
            return true;
        }
    }
    false
}

// A coded error of this front (`conv.*`, `syntax.legacy_removed`), soft: parsing
// goes on. SRC[start..end) is replaced by `new` (the try: line, and `fix
// --suggested`) when `new` is not empty.
pub fn conv_error(code: *mut u8, start: i64, end: i64, message: &[u8], help: &[u8], new: &[u8],
    pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = code;
    err_begin(start, pcx);
    err_fmt(str::from_utf8(message).unwrap(), pcx);
    if help.len() > 0 {
        let h = buf_new();
        buf_bytes(h, help);
        buf_bytes(h, b"\0");
        err_help(buf_ptr(h), pcx);
    }
    if new.len() > 0 && end > start {
        let old = &get_src()[start as usize..end as usize];
        // the whole line's text around it, so that --old is unique
        try_patch(start, old, new, pcx);
        err_fix(start, end, new, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// (0.20) `env::var(name)`, Rust's name (and `env::var_in`, std's first):
// `var` is a word of 0.20, a keyword from 0.21, so std's are `env::get`
// and `env::get_in(name, gpa)`. Path node n names member of module (its
// key's text); an error when it is one of them.
pub fn env_var_error(n: i64, module: &[u8], member: &[u8], pcx: &mut Ctx<Comp>) {
    // (0.28.0: std's is Rust's name with `_in`, `env::var_in(name, gpa)`;
    // `env::get` went with the keyword `var`)
    if module != b"std::env" || member != b"var" {
        return;
    }
    let new = "var_in";
    let start = pcx.nodes[n as usize].end - member.len() as i64;
    let b = buf_new();
    buf_bytes(b, b"'env::");
    buf_bytes(b, member);
    buf_bytes(b, b"' allocates its result: std's is 'env::");
    buf_bytes(b, new.as_bytes());
    buf_bytes(b, b"(name, gpa)'");
    let saved = pcx.err_kind;
    pcx.err_kind = CODE_RUST;
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_fmt(str::from_utf8(&buf_copy(b)).unwrap(), pcx);
    err_help(
        c"the environment's variables: `env::var_in(name, gpa)`, a `Result<String<Gpa>, VarError>`",
        pcx);
    if start > pcx.nodes[n as usize].start
        && get_src()[start as usize..pcx.nodes[n as usize].end as usize] == member {
        try_patch(start, member, new.as_bytes(), pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    crate::base::diag::err_jump(pcx);
}

// ---- Conventions ----

// The Param node of function f's parameter i (0 for none: an extern's, a
// synthesized function's).
pub fn param_node(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    if f < 0 || i < 0 {
        return 0;
    }
    let fnode = pcx.fns[f as usize].node;
    if fnode <= 0 {
        return 0;
    }
    let mut k: i64 = 0;
    for j in 0..pcx.nodes[fnode as usize].count {
        let p = child(fnode, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param {
            if k == i {
                return p;
            }
            k += 1;
        }
    }
    0
}

// ---- T1: what a convention means ----

// (0.20) The element type of a Vec, a Buf or an array (0: another type),
// whose elements a slice views.
pub fn container_elem(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 {
        return 0;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Array {
        return pcx.types[t as usize].a;
    }
    if k != TyKind::Struct {
        return 0;
    }
    let s = pcx.types[t as usize].a;
    let name = sym_text(pcx.structs[s as usize].name, pcx);
    if pcx.structs[s as usize].targ_count > 0
        && (name.len() >= 4 && name[0..4] == b"Vec<" || name == b"Vec") {
        return (pcx.tlists[pcx.structs[s as usize].targs as usize]);
    }
    if name.len() >= 3 && name[0..3] == b"Buf" && (name.len() == 3 || name[3] == b'<') {
        return crate::front::types::TY_U8;
    }
    0
}
