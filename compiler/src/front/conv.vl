// (0.20) Parameter conventions, the front (docs/design/conventions.md,
// "Phase 0 contract"): which spelling a file is read in, Rust's spellings
// recognized with their 0.20 form, and what a parameter's convention is.
//
// A file is read in one of two ways:
// - 0.20 (the default; `--syntax=0.20`): 0.20's spelling only; Rust's
//   (`&T`, `&mut x`, `let mut`, `static mut`, `mut x:`, `move ||`) is
//   `conv.rust`, and `&x` is the inout marker;
// - mixed (`--syntax=mixed`, for the migrations, `fix --only
//   conventions` and the older ones): 0.19's spelling and 0.20's both,
//   each with its meaning; `&x` is a shared reference, except where an
//   exclusive one is wanted (the inout marker, check_mode: inout_marker).
// std is 0.20 code; the compiler's generated sources (`<check>`, ...)
// keep 0.19's meanings (generated_at). (0.21) The legacy mode, 0.19's
// spelling only for compiler/src during 0.20, is gone: its root pragma
// LEGACY_MARKER is syntax.legacy_removed.

use crate::base::{
    buf_bytes, buf_copy, buf_int, buf_new, buf_ptr, buf_str, c_bytes, get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fix, err_fmt, err_help, err_try_tool};
use crate::front::ast::{CONV_INOUT, CONV_NEW, CONV_SINK, NODE_REF, NODE_REF_MUT, NodeKind, child};
use crate::front::kinds::{K_OWNED, type_kind};
use crate::front::lexer::Tok;
use crate::front::modules::{file_made, file_of_pos, file_path, within_std};
use crate::front::types::{REF_MUT, REF_SHARED, TyKind, ref_to, struct_field, type_elem};

// The bootstrap's pragma of 0.20 (its root file's first bytes): from 0.21
// an error, syntax.legacy_removed.
pub const LEGACY_MARKER: &[u8] = b"// vole-syntax: 0.19";

// A parameter's convention (param_conv): CONV_LEGACY is a parameter
// written in 0.19's spelling (by value, `&T`, `&mut T`, `*T`: its type
// says how it is taken).
pub const CONV_LEGACY: i64 = 0;
pub const CONV_LET: i64 = 1;
pub const CONV_IN_OUT: i64 = 2;
pub const CONV_SINK_K: i64 = 3;

// The codes (conventions.md §10.1; tools/explain/conv_table.vl). Phase
// 0 reports the parser's: CODE_RUST, CODE_SET, CODE_SINK_TYPE,
// CODE_LEGACY; T1 the checker's: CODE_MARKER (an inout argument without
// `&`), CODE_MARKER_EXTRA (`&` on a let or sink argument), CODE_PLACE (`&`
// of a temporary), CODE_EXTERN (`inout`/`sink` in an extern "C"
// signature); 0.21 CODE_LEGACY_REMOVED.
pub const CODE_RUST: *mut u8 = c"conv.rust";
pub const CODE_SET: *mut u8 = c"conv.set";
pub const CODE_SINK_TYPE: *mut u8 = c"conv.sink_type";
pub const CODE_PLACE: *mut u8 = c"conv.place";
pub const CODE_EXTERN: *mut u8 = c"conv.extern";
pub const CODE_LEGACY_REMOVED: *mut u8 = c"syntax.legacy_removed";

// `--syntax=0.20`: the default, accepted; `--syntax=mixed` is refused
// (0.21): 0.19's spelling is read only by the migrations, inside `fix`
// (set_mixed). False when arg is not that option.
pub fn syntax_option(arg: &str, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if arg == "--syntax=0.20" {
            pcx.strict = true;
            // (the children, `volec try`'s, read as this one does)
            conv_setenv(c"VOLE_SYNTAX", c"0.20", 1);
            return true;
        }
        if arg == "--syntax=mixed" {
            crate::base::die(c"syntax.mixed_removed: no build, check or run reads 0.19's spelling (0.21): Rust's spellings are conv.rust errors, each with its fix (volec fix --suggested); `volec fix --only conventions` migrates 0.19 code");
        }
        false
    }
}

extern "C" {
    #[link_name = "setenv"]
    fn conv_setenv(name: *mut u8, value: *mut u8, overwrite: i32) -> i32;
    #[link_name = "getpid"]
    fn conv_getpid() -> i32;
    #[link_name = "getppid"]
    fn conv_getppid() -> i32;
    #[link_name = "atol"]
    fn conv_atol(s: *mut u8) -> i64;
}

// The program is read mixed (0.19's spelling too): only by a migration
// (`fix --only conventions`, `--values`, `--only std015|alloc016`), whose
// child processes (the checks of its edits, its later rounds) inherit it
// through VOLE_SYNTAX=mixed:PID, honored only by a child of process
// PID (syntax_from_env): no build, check or run of a user's reads it.
pub fn set_mixed(pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.strict = false;
        let b = buf_new();
        buf_bytes(b, b"mixed:");
        buf_int(b, conv_getpid() as i64);
        buf_bytes(b, b"\0");
        conv_setenv(c"VOLE_SYNTAX", buf_ptr(b), 1);
    }
}

// At start (main): VOLE_SYNTAX=mixed:PID, where PID is this process's
// parent (a migration's child: set_mixed, which it passes on to its own
// children); any other value is the default, 0.20's spelling.
pub fn syntax_from_env(pcx: &mut Ctx<Comp>) {
    unsafe {
        let v = crate::base::getenv(c"VOLE_SYNTAX");
        if v == 0 as *mut u8 {
            return;
        }
        // (v is getenv's string, read here before anything can set the
        // variable; the number starts after the six bytes just compared)
        if c_bytes(v).starts_with(b"mixed:") && conv_atol(v.add(6)) == conv_getppid() as i64 {
            set_mixed(pcx);
        }
    }
}

// Before parsing: a root that starts with the 0.20 bootstrap's pragma is
// syntax.legacy_removed (0.21: the legacy mode is gone).
pub fn conv_setup(pcx: &mut Ctx<Comp>) {
    pcx.cache_file = -1;
    if pcx.files.len() == 0 {
        return;
    }
    let s = pcx.files[0].start;
    let n = LEGACY_MARKER.len() as i64;
    if pcx.files[0].end - s >= n && get_src()[s as usize..(s + n) as usize] == LEGACY_MARKER {
        conv_error(CODE_LEGACY_REMOVED, s, s + n,
            b"'// vole-syntax: 0.19' was a pragma of the 0.20 bootstrap: there is one language",
            b"delete the line",
            b"", pcx);
    }
}

// Whether pos is in a file of the program's own crate (not std's, not a
// generated source).
pub fn user_at(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.cache_file >= 0 && pos >= pcx.cache_start && pos < pcx.cache_end {
        return pcx.cache_user;
    }
    let f = file_of_pos(pos, pcx);
    // (the path's facts first: the view of it ends before pcx is written)
    let p = file_path(f, pcx);
    let generated = p.starts_with(b"<");
    // (std's files and its built-in text, `<std>`; not the virtual
    // modules the compiler writes, `<std::arch::aarch64>`, in 0.19's
    // spelling until compiler/src migrates)
    let virtual_module = generated && p.len() > 4 && p[4] == b':';
    // (0.27.2: the builtin impls' text, `<builtin>`, is the rust
    // edition's, as the trait it is made for: front/builtin_impls.vl)
    let made = generated && !p.starts_with(b"<builtin>");
    // RULE: Z1.2 (0.27.2: a rust program's derives on std2, `<derive>`, are
    // the rust edition's: front/derive/rust.vl)
    let derive_text = p.starts_with(b"<derive>");
    // (0.28.0: a rust program's test code on std2, `<test>`, is the
    // rust edition's too: front/tests/mod.vl's rust_text)
    let test_text = p.starts_with(b"<test>");
    pcx.cache_file = f;
    pcx.cache_start = pcx.files[f as usize].start;
    pcx.cache_end = pcx.files[f as usize].end;
    pcx.cache_std = within_std(pcx.files[f as usize].module, pcx) && !virtual_module;
    let derived = derive_text && crate::front::known::on_std2(pcx);
    let tested = test_text && crate::front::known::on_std2(pcx);
    pcx.cache_user = (!made || derived || tested) && !pcx.cache_std;
    pcx.cache_user
}

// Whether token i is the identifier `word` (`inout`, `sink`, `var`: words
// of 0.20 that are not keywords until 0.21, conventions.md D27).
pub fn word_at(i: i64, word: &[u8], pcx: &Ctx<Comp>) -> bool {
    pcx.toks[i as usize].kind == Tok::Ident
        && sym_text(pcx.toks[i as usize].value as i64, pcx) == word
}

// Whether token kind k can start a type.
pub fn starts_type(k: Tok) -> bool {
    k == Tok::Ident || k == Tok::Star || k == Tok::LParen || k == Tok::LBracket || k == Tok::Fn
        || k == Tok::Amp || k == Tok::AmpAmp || k == Tok::Bang || k == Tok::Extern
        || k == Tok::Let
}

// ---- Diagnostics ----

// `try: volec edit patch FILE:LINE --old 'OLD' --new 'NEW'` for the
// error at pos; none in a generated source or for text a shell word
// cannot hold.
pub fn try_patch(pos: i64, old: &[u8], new: &[u8], pcx: &Ctx<Comp>) {
    let f = file_of_pos(pos, pcx);
    let path = file_path(f, pcx);
    if file_made(f, pcx) || unquotable(old) || unquotable(new) {
        return;
    }
    let mut line: i64 = 1;
    for i in pcx.files[f as usize].start..pos {
        if get_src()[i as usize] == b'\n' {
            line += 1;
        }
    }
    let a = buf_new();
    buf_str(a, c"edit patch ");
    buf_bytes(a, if path.starts_with(b"./") { &path[2..] } else { path });
    buf_bytes(a, b":");
    buf_int(a, line);
    buf_bytes(a, b" --old '");
    buf_bytes(a, old);
    buf_bytes(a, b"' --new '");
    buf_bytes(a, new);
    buf_bytes(a, b"'");
    err_try_tool(&buf_copy(a), false, pcx);
}

fn unquotable(s: &[u8]) -> bool {
    for i in 0..s.len() {
        if s[i] == b'\'' || s[i] == b'\n' {
            return true;
        }
    }
    false
}

// A coded error of this front (`conv.*`, `syntax.legacy_removed`), soft: parsing
// goes on. SRC[start..end) is replaced by `new` (the try: line, and `fix
// --suggested`) when `new` is not empty.
pub fn conv_error(code: *mut u8, start: i64, end: i64, message: &[u8], help: &[u8], new: &[u8],
    pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = code;
    err_begin(start, pcx);
    err_fmt(str::from_utf8(message).unwrap(), pcx);
    if help.len() > 0 {
        let h = buf_new();
        buf_bytes(h, help);
        buf_bytes(h, b"\0");
        err_help(buf_ptr(h), pcx);
    }
    if new.len() > 0 && end > start {
        let old = &get_src()[start as usize..end as usize];
        // the whole line's text around it, so that --old is unique
        try_patch(start, old, new, pcx);
        err_fix(start, end, new, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// `conv.rust`: Rust's spelling at SRC[start..end), whose 0.20 form is new
// (`what` says what the 0.20 form is).
pub fn rust_spelling(start: i64, end: i64, what: &[u8], new: &[u8], pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_bytes(b, b"'");
    buf_bytes(b, &get_src()[start as usize..end as usize]);
    buf_bytes(b, b"' is Rust's spelling; ");
    buf_bytes(b, what);
    conv_error(c"conv.rust", start, end, &buf_copy(b), b"", new, pcx);
}

// (0.20) `env::var(name)`, Rust's name (and `env::var_in`, std's first):
// `var` is a word of 0.20, a keyword from 0.21, so std's are `env::get`
// and `env::get_in(name, gpa)`. Path node n names member of module (its
// key's text); an error when it is one of them.
pub fn env_var_error(n: i64, module: &[u8], member: &[u8], pcx: &mut Ctx<Comp>) {
    // (0.28.0: std's is Rust's name with `_in`, `env::var_in(name, gpa)`;
    // `env::get` went with the keyword `var`)
    if module != b"std::env" || member != b"var" {
        return;
    }
    let new = "var_in";
    let start = pcx.nodes[n as usize].end - member.len() as i64;
    let b = buf_new();
    buf_bytes(b, b"'env::");
    buf_bytes(b, member);
    buf_bytes(b, b"' allocates its result: std's is 'env::");
    buf_bytes(b, new.as_bytes());
    buf_bytes(b, b"(name, gpa)'");
    let saved = pcx.err_kind;
    pcx.err_kind = CODE_RUST;
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_fmt(str::from_utf8(&buf_copy(b)).unwrap(), pcx);
    err_help(
        c"the environment's variables: `env::var_in(name, gpa)`, a `Result<String<Gpa>, VarError>`",
        pcx);
    if start > pcx.nodes[n as usize].start
        && get_src()[start as usize..pcx.nodes[n as usize].end as usize] == member {
        try_patch(start, member, new.as_bytes(), pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    crate::base::diag::err_jump(pcx);
}

// ---- Conventions ----

// The convention of Param node p (CONV_LEGACY, CONV_LET, CONV_IN_OUT,
// CONV_SINK_K).
pub fn param_conv(p: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = pcx.nodes[p as usize].p;
    if (f & CONV_NEW) == 0 {
        return CONV_LEGACY;
    }
    if (f & CONV_INOUT) != 0 {
        return CONV_IN_OUT;
    }
    if (f & CONV_SINK) != 0 { CONV_SINK_K } else { CONV_LET }
}

// The Param node of function f's parameter i (0 for none: an extern's, a
// synthesized function's).
pub fn param_node(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    if f < 0 || i < 0 {
        return 0;
    }
    let fnode = pcx.fns[f as usize].node;
    if fnode <= 0 {
        return 0;
    }
    let mut k: i64 = 0;
    for j in 0..pcx.nodes[fnode as usize].count {
        let p = child(fnode, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param {
            if k == i {
                return p;
            }
            k += 1;
        }
    }
    0
}

// The convention of function f's parameter i.
pub fn fn_param_conv(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let p = param_node(f, i, pcx);
    if p == 0 { CONV_LEGACY } else { param_conv(p, pcx) }
}

// The convention's word: "" (legacy), "let", "inout", "sink".
pub fn conv_word(c: i64) -> &'static [u8] {
    if c == CONV_LET {
        b"let"
    } else if c == CONV_IN_OUT {
        b"inout"
    } else if c == CONV_SINK_K {
        b"sink"
    } else {
        b""
    }
}

// ---- T1: what a convention means ----

// Whether a value of type t is copied, not borrowed, by a let parameter:
// it owns nothing (no Drop, no Vec, Buf or HashMap in it) and holds no
// exclusive access (`&mut T`, `inout [T]`), conventions.md §2.2.
pub fn copyable(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    (type_kind(t, pcx) & K_OWNED) == 0 && !holds_mut(t, 0, pcx)
}

fn holds_mut(t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    depth <= 8 && crate::front::kinds::holds_inout(t, pcx)
}

// The type parameter p (a Param node) has, from the type its node resolved
// to: a let parameter (conventions.md §2.2) takes a copy of a copyable
// value and a shared reference to any other (`&T`, an access: used as
// the value, front/check/names: synth_name); `let [T]` is the slice. Per
// instance: a generic function's instances resolve their signatures.
pub fn param_type(p: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if ty <= 0 || ty == pcx.ty_error {
        return ty;
    }
    let c = param_conv(p, pcx);
    if c == CONV_IN_OUT && pcx.types[ty as usize].kind == TyKind::Ptr
        && pcx.types[ty as usize].b == REF_MUT
        && pcx.types[pcx.types[ty as usize].a as usize].kind == TyKind::Slice {
        // (`inout self` in `impl [T]`, `x: inout T` with T a slice: the
        // exclusive slice `inout [T]`, not a reference to a slice)
        return crate::front::types::mut_slice_of(pcx.types[pcx.types[ty as usize].a as usize].a,
            pcx);
    }
    if c != CONV_LET {
        return ty;
    }
    let t = pcx.nodes[p as usize].b;
    let written = t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyPtr
        && (pcx.nodes[t as usize].p & CONV_NEW) != 0;
    let base = if written { pcx.types[ty as usize].a } else { ty };
    if base <= 0 || pcx.types[base as usize].kind == TyKind::Slice || copyable(base, pcx) {
        return base;
    }
    ref_to(base, REF_SHARED, pcx)
}

// (0.24, conventions.md "0.22.1": let is a borrow) The type a let
// parameter (node p; 0: a function type's) of type ty has in a function
// whose result has type ret: a copyable value with storage a view can
// point into (an array, a struct or tuple holding one) is passed by
// reference when the result may hold a view (of it), so that a view of the
// parameter outlives the call, as a borrow's does; otherwise a copy, the
// optimization. (`fn file_name(self) -> [u8] { self.name[0..self.len] }`)
pub fn let_by_ref(p: i64, ty: i64, ret: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if p > 0 && param_conv(p, pcx) != CONV_LET {
        return ty;
    }
    if ty <= 0 || ty == pcx.ty_error || ret <= 0 || ret == pcx.ty_error
        || pcx.types[ty as usize].kind == TyKind::Ptr
        || pcx.types[ty as usize].kind == TyKind::Slice || !copyable(ty, pcx)
        || !has_storage(ty, 0, pcx)
        || !crate::front::kinds::is_view_type(ret, pcx) {
        return ty;
    }
    ref_to(ty, REF_SHARED, pcx)
}

// Whether a value of type t holds storage a view can point into: an
// array, in place or in a field or element.
fn has_storage(t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if t <= 0 || depth > 8 {
            return false;
        }
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Array {
            return true;
        }
        if k == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if has_storage(crate::front::types::type_elem(t, i, pcx), depth + 1, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            for i in 0..pcx.structs[s as usize].field_count {
                if has_storage((*crate::front::types::struct_field(s, i, pcx)).ty, depth + 1, pcx) {
                    return true;
                }
            }
        }
        false
    }
}

// (0.20) What a let parameter of type base is: a copy of a copyable value
// (a slice is one), else a shared reference.
pub fn let_of(base: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if base <= 0 || base == pcx.ty_error || pcx.types[base as usize].kind == TyKind::Slice
        || copyable(base, pcx) {
        return base;
    }
    ref_to(base, REF_SHARED, pcx)
}

// (0.20) A function type's parameter written `let T` (node t, resolved to
// `&T`): let_of(T), as a let parameter's. (0.22) A plain `T` is the same,
// let being the default there as in a parameter list (`fn(T)` is
// `fn(let T)`, conventions.md §2.5); `sink T` is the value, `inout T` the
// exclusive access, a raw `*T` itself.
pub fn fn_type_param(t: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.nodes[t as usize].kind == NodeKind::TyPtr && (pcx.nodes[t as usize].p & CONV_NEW) != 0
        && (pcx.nodes[t as usize].p & NODE_REF_MUT) == 0 && ty > 0
        && pcx.types[ty as usize].kind == TyKind::Ptr {
        return let_of(pcx.types[ty as usize].a, pcx);
    }
    return ty;
}

// (0.20) A closure parameter p annotated with type ty: `a: let T`, and `a: T`
// in a 0.20 file, are let (let_of); `a: inout T`, `a: sink T` (0.25.3: the
// value, a by-value parameter the closure drops) and 0.19's spellings are
// as written.
pub fn closure_param_type(p: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let t = pcx.nodes[p as usize].b;
    if t <= 0 || ty <= 0 || ty == pcx.ty_error {
        return ty;
    }
    if (pcx.nodes[t as usize].p & (CONV_NEW | CONV_SINK)) != 0 {
        return fn_type_param(t, ty, pcx);
    }
    ty
}

// (0.25.4) Whether closure parameter p is let (closure_param_type): `a:
// let T`; `a: T` in a 0.20 file; `a` with no type, which takes its type
// from where the closure goes (a bound's `fn(T)`, let by default).
pub fn closure_param_lets(p: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.nodes[p as usize].kind != NodeKind::Param {
        return false;
    }
    let t = pcx.nodes[p as usize].b;
    if t <= 0 {
        return true;
    }
    if (pcx.nodes[t as usize].p & CONV_SINK) != 0 || (pcx.nodes[t as usize].p & NODE_REF_MUT) != 0 {
        return false;
    }
    if (pcx.nodes[t as usize].p & CONV_NEW) != 0 {
        return true;
    }
    false
}

// Whether Param p is an access (a let parameter that borrows, or an inout
// one) of type ty: its uses are the value it designates.
pub fn param_is_access(p: i64, ty: i64, pcx: &Ctx<Comp>) -> bool {
    let c = param_conv(p, pcx);
    (c == CONV_LET || c == CONV_IN_OUT) && ty > 0 && pcx.types[ty as usize].kind == TyKind::Ptr
        && pcx.types[ty as usize].b != 0
}

// (0.20) The element type of a Vec, a Buf or an array (0: another type),
// whose elements a slice views.
pub fn container_elem(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 {
        return 0;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Array {
        return pcx.types[t as usize].a;
    }
    if k != TyKind::Struct {
        return 0;
    }
    let s = pcx.types[t as usize].a;
    let name = sym_text(pcx.structs[s as usize].name, pcx);
    if pcx.structs[s as usize].targ_count > 0
        && (name.len() >= 4 && name[0..4] == b"Vec<" || name == b"Vec") {
        return (pcx.tlists[pcx.structs[s as usize].targs as usize]);
    }
    if name.len() >= 3 && name[0..3] == b"Buf" && (name.len() == 3 || name[3] == b'<') {
        return crate::front::types::TY_U8;
    }
    0
}

// (0.20) Whether an impl's parameter p, of type it, meets its trait's
// type tt: a let parameter (`self`, `other: Self` written in 0.20's
// spelling) that borrows (`&T`) where the trait takes T by value, as the
// operator traits do (`fn add(self, other: Self) -> Self` for an owned
// Self, conventions.md D11): the calls borrow instead of moving.
pub fn let_for_value(p: i64, it: i64, tt: i64, pcx: &Ctx<Comp>) -> bool {
    p > 0 && param_conv(p, pcx) == CONV_LET && it > 0 && pcx.types[it as usize].kind == TyKind::Ptr
        && pcx.types[it as usize].b == REF_SHARED && pcx.types[it as usize].a == tt
}

// (0.20) Whether an impl's let parameter p, a copy of type it, meets its
// trait's shared reference tt (`&T`, a trait in 0.19's spelling, or one
// whose instance the impl copies): the impl takes the trait's `&T`, used
// as the value (check_function makes it an access).
pub fn let_copy_for_ref(p: i64, it: i64, tt: i64, pcx: &Ctx<Comp>) -> bool {
    p > 0 && param_conv(p, pcx) == CONV_LET && tt > 0 && pcx.types[tt as usize].kind == TyKind::Ptr
        && pcx.types[tt as usize].b == REF_SHARED && pcx.types[tt as usize].a == it
}

// (0.20, conventions.md §9.3: legacy calls into new std) Whether an impl's
// parameter p written in 0.19's spelling, a shared reference `&T` of type
// it, meets its trait's let parameter tp that copies T (tt): the 0.19
// spelling of a let (`fn eq(self: &Self, other: &Self)` for `fn eq(self,
// other: Self)`). The impl keeps its reference; its calls pass places.
pub fn legacy_ref_for_copy(p: i64, tp: i64, it: i64, tt: i64, pcx: &Ctx<Comp>) -> bool {
    p > 0 && tp > 0 && param_conv(p, pcx) == CONV_LEGACY && param_conv(tp, pcx) == CONV_LET
        && it > 0 && pcx.types[it as usize].kind == TyKind::Ptr
        && pcx.types[it as usize].b == REF_SHARED && pcx.types[it as usize].a == tt
}

// (0.20, §9.3) The arguments of call n to f (from parameter first_param
// on) written `&e` in a file not read in 0.20's spelling (a legacy crate,
// a mixed file, std, a checker's desugaring: `a == b`'s `eq(&b)`, an
// f-string's holes) where f's parameter is let in 0.20's spelling: the `&`
// is dropped, so that a let parameter that copies (or a generic `x: T`)
// takes the value, as the 0.19 `&T` it replaces took the reference. A let
// parameter that borrows borrows the place itself.
pub fn legacy_let_args(n: i64, f: i64, first_param: i64, pcx: &mut Ctx<Comp>) {
    if f < 0 {
        return;
    }
    for i in 0..pcx.nodes[n as usize].count {
        let arg = child(n, i, pcx);
        if pcx.nodes[arg as usize].kind != NodeKind::Unary || pcx.nodes[arg as usize].op != Tok::Amp
            || (pcx.nodes[arg as usize].p & NODE_REF_MUT) != 0 {
            continue;
        }
        let p = param_node(f, first_param + i, pcx);
        if p <= 0 || param_conv(p, pcx) != CONV_LET
            || !syntactic_place(pcx.nodes[arg as usize].b, pcx) {
            continue;
        }
        // (a raw `*T`, as 0.19 meant it: `&e` is its address)
        let tn = pcx.nodes[p as usize].b;
        if tn > 0 && pcx.nodes[tn as usize].kind == NodeKind::TyPtr
            && (pcx.nodes[tn as usize].p & NODE_REF) == 0 {
            continue;
        }
        // (the `&`, for `fix --only conventions`, which sees the checked
        // program: it drops the `&` the checker dropped)
        pcx.let_stripped.push(pcx.nodes[arg as usize].start);
        pcx.let_stripped.push(arg);
        pcx.nodes[arg as usize] = pcx.nodes[pcx.nodes[arg as usize].b as usize];
    }
}

// Whether e is written as a place: a name, a field, an element, `*p`.
fn syntactic_place(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        return true;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
        return syntactic_place(pcx.nodes[e as usize].a, pcx);
    }
    k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star
}

// (0.20) conv.extern: Param p of a C function (`extern "C"`, declared or
// defined here) written `inout` or `sink`: C takes values and pointers.
pub fn extern_conv(p: i64, pcx: &mut Ctx<Comp>) {
    let c = param_conv(p, pcx);
    if c != CONV_IN_OUT && c != CONV_SINK_K {
        return;
    }
    let msg = buf_new();
    buf_bytes(msg, b"a C function takes values and raw pointers, not '");
    buf_bytes(msg, conv_word(c));
    buf_bytes(msg, b"': write '");
    buf_bytes(msg, sym_text(pcx.nodes[p as usize].a, pcx));
    buf_bytes(msg,
        if c == CONV_IN_OUT { b": *T'; the call passes '&x' (it converts)" } else { b": T'" });
    conv_error(CODE_EXTERN, pcx.nodes[p as usize].start, pcx.nodes[p as usize].end, &buf_copy(msg),
        b"", b"", pcx);
}

// (0.20) Whether field i of struct s is declared an access (`q: inout
// Query`, `cfg: let Config`): its uses are the value it designates, as an
// access local's are (front/check/synth_mode: synth_field).
pub fn field_is_access(s: i64, i: i64, pcx: &Ctx<Comp>) -> bool {
    let node = pcx.structs[s as usize].node;
    if node <= 0 || pcx.structs[s as usize].closure != 0 || i < 0
        || i >= pcx.nodes[node as usize].count {
        return false;
    }
    let f = child(node, i, pcx);
    let t = pcx.nodes[f as usize].b;
    pcx.nodes[f as usize].kind == NodeKind::Field && t > 0
        && pcx.nodes[t as usize].kind == NodeKind::TyPtr
        && (pcx.nodes[t as usize].p & CONV_NEW) != 0
}

// (0.20) conv.marker_extra at `&e` n of a file read in 0.20's spelling,
// where `expected` takes no exclusive access (a let parameter, by copy or
// shared, a sink one, a shared slice): the `&` is dropped (n becomes e),
// and the error says so.
pub fn extra_marker(n: i64, expected: i64, pcx: &mut Ctx<Comp>) {
    return;
}
