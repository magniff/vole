// Compile-time embedding (0.25.3): `include_str("shader.wgsl")` and
// `include_bytes("font.bin")` are a file's contents as a string literal
// (front::parser::exprs::parse_include makes the Str node), read when the
// program is parsed. The path is relative to the directory of the file
// that holds the call. include_str's file must be UTF-8 (embed.utf8) and
// is a literal where a `str` or a `[u8]` goes; include_bytes' is a `[u8]`
// (its node's b is 1). A file that cannot be read is embed.missing.
//
// The files are the program's inputs: EMBEDS lists them, for the tools'
// cache (tools::query::cache: a cached answer holds while each has the
// text it had); the code cache sees their bytes in the IR's strings.

use crate::base::{
    BUFS, FILES, IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_reserve, buf_slice, cstr,
    fclose, fopen, fread, overlay_of,
};
use crate::base::diag::{ERR_KIND, err_begin, err_end_soft, err_fix, err_fmt, err_help};
use crate::front::check::distinct::utf8_error_at;
use crate::front::contracts::sites::file_of_pos;
use crate::front::cpp::directives::path_dir;
use crate::front::lexer::add_string;

// The embedded files: for each, its path (embed_path's buffer) and its
// text's string id, or -1 when it could not be read.
pub static var EMBEDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// The path of `rel`, named in the file holding position `pos`: relative
// to that file's directory (as given, without a leading `./`), or
// absolute: a buffer holding it and a NUL (`.ptr` is a C string; its
// text: buf_path).
pub fn embed_path(pos: i64, rel: [u8]) -> i64 {
    let out = buf_new();
    if rel.len == 0 || rel[0] != '/' {
        let dir = plain(cstr(path_dir(file_path(pos).ptr)));
        if !(dir.len == 1 && dir[0] == '.') {
            buf_bytes(out, dir);
            buf_byte(out, '/');
        }
    }
    buf_bytes(out, rel);
    buf_byte(out, 0);
    out
}

// The path in buffer b (embed_path's), without its NUL.
pub fn buf_path(b: i64) -> [u8] {
    let all = buf_slice(b);
    all[0..all.len - 1]
}

// The path of the file holding position `pos`, as it was named (a NUL
// after it).
fn file_path(pos: i64) -> [u8] {
    cstr(FILES[file_of_pos(pos)].path)
}

// A path without its leading `./`s (a module's file is named so).
fn plain(path: [u8]) -> [u8] {
    var p = path;
    while p.len > 2 && p[0] == '.' && p[1] == '/' {
        p = p[2..p.len];
    }
    p
}

// The bytes of file `path` (followed by a NUL) into buffer `out`; false
// when it cannot be opened.
pub fn read_embedded(path: [u8], out: i64) -> bool {
    // UNSAFE: the file is read through C's stdio (fopen, fread, fclose),
    // into the buffer's own storage.
    // SAFETY: path.ptr is NUL-terminated (embed_path, the tools' cache
    // writes its paths so); each fread writes at most 65536 bytes after
    // the buffer's length, which buf_reserve has made room for, and the
    // file is closed once.
    unsafe {
        let file = fopen(overlay_of(path.ptr), c"rb");
        if file == 0 as *u8 {
            return false;
        }
        loop {
            buf_reserve(out, 65536);
            let got = fread(&BUFS[out].data[BUFS[out].len], 1, 65536, file);
            BUFS[out].len += got as i64;
            if got == 0 {
                break;
            }
        }
        fclose(file);
        true
    }
}

// The string id of the file `rel` names for the call SRC[start..end)
// (`include_bytes` when `bytes`, else `include_str`): its contents, or ""
// after an error.
pub fn embed_file(start: i64, end: i64, rel: [u8], bytes: bool) -> i64 {
    let path_buf = embed_path(start, rel);
    let path = buf_path(path_buf);
    let text = buf_new();
    let what = if bytes { "include_bytes" } else { "include_str" };
    if !read_embedded(path, text) {
        note_embed(path_buf, -1);
        let m = buf_new();
        buf_fmt_call(m, what, rel);
        buf_bytes(m, ": cannot read ");
        buf_bytes(m, path);
        let h = buf_new();
        buf_bytes(h, "the path is relative to the directory of ");
        buf_bytes(h, plain(file_path(start)));
        buf_bytes(h, ", the file that holds the call");
        embed_error(c"embed.missing", start, buf_slice(m), buf_slice(h), -1, "");
        return add_string("");
    }
    let content = buf_slice(text);
    let at = if bytes { -1 } else { utf8_error_at(content) };
    if at >= 0 {
        note_embed(path_buf, -1);
        let m = buf_new();
        buf_fmt_call(m, what, rel);
        buf_bytes(m, ": ");
        buf_bytes(m, path);
        buf_bytes(m, " is not UTF-8 (at byte ");
        buf_int(m, at);
        buf_bytes(m, ")");
        // the fix: include_bytes, the same path
        let call = buf_new();
        buf_fmt_call(call, "include_bytes", rel);
        embed_error(c"embed.utf8", start, buf_slice(m),
            "include_str's text is a str, UTF-8; include_bytes gives any file's bytes, a [u8]", end,
            buf_slice(call));
        return add_string("");
    }
    let id = add_string(content);
    note_embed(path_buf, id);
    id
}

// An embedded file: its path (embed_path's buffer) and string id.
fn note_embed(path: i64, id: i64) {
    EMBEDS.push(path);
    EMBEDS.push(id);
}

// `what("rel")`, into buffer b.
fn buf_fmt_call(b: i64, what: [u8], rel: [u8]) {
    buf_bytes(b, what);
    buf_bytes(b, "(\"");
    buf_bytes(b, rel);
    buf_bytes(b, "\")");
}

// A coded error of embedding at `pos`, soft (parsing goes on); its fix
// replaces SRC[pos..fix_end) with `fix` when fix_end > pos.
fn embed_error(code: *u8, pos: i64, message: [u8], help: [u8], fix_end: i64, fix: [u8]) {
    let saved = ERR_KIND;
    ERR_KIND = code;
    err_begin(pos);
    err_fmt(message);
    let h = buf_new();
    buf_bytes(h, help);
    buf_byte(h, 0);
    err_help(buf_slice(h).ptr);
    if fix_end > pos {
        err_fix(pos, fix_end, fix);
    }
    err_end_soft();
    ERR_KIND = saved;
}

// The embedded files, for the tools' cache: how many, the path of the
// k-th (NUL-terminated).
pub fn embed_count() -> i64 {
    EMBEDS.count / 2
}

pub fn embed_path_at(k: i64) -> [u8] {
    buf_path(EMBEDS.get(2 * k))
}
