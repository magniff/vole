// Traits (0.9): bounded generics by monomorphization.
//
//   trait Hash { fn hash(self: *Self) -> u64; }
//   impl Hash for Point { fn hash(self: *Point) -> u64 { ... } }
//   impl<T: Hash> Hash for Vec<T> { ... }
//   fn f<T: Hash + Eq>(x: T) -> u64 { x.hash() }
//
// A trait declares functions, some with a default body. An impl block for
// a trait gives its functions to the type as methods (one namespace with
// the type's own methods); a function the impl leaves out is its trait's
// default, copied into the impl (and checked there). There is at most one
// impl per (trait, type): a generic impl covers every instance of its
// template whose arguments satisfy the impl's bounds.
//
// Bounds are checked when an instance is made: each type argument must
// implement each trait of its parameter's bounds. Generic code is still
// checked per instance (0.5); a method called on a value declared with a
// bounded parameter's type (`x: T`, `x: *T`) or as `T::f(...)` must be a
// function of one of the bounds. Unbounded parameters behave as in 0.5.
//
// The operator traits of std (Add, Sub, Mul, Div, Neg, Eq, Ord): `a + b`
// on a type implementing Add is `a.add(b)`, `-a` is `a.neg()`, `a == b`
// is `a.eq(&b)` (before 0.6's structural ==), `a < b` is `a.cmp(&b) < 0`.
// Builtin types implement them intrinsically (numbers: all of them;
// everything with ==: Eq; numbers, pointers and fieldless enums: Ord).
// There are no trait objects (`dyn`): dispatch is static.

use crate::base::{
    SRC, alloc_array, buf_byte, buf_new, buf_slice, free, intern, intern_c, sym_table, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fmt, err_help, err_help_sym, err_str, err_sym,
    err_try_tool, fail_name,
};
use crate::front::assoc::{
    assoc_constraints_hold, collect_impl_assoc, collect_trait_assoc, constraint_error,
};
use crate::front::ast::{
    FN_DEFAULT_COPY, FN_LAZY, FN_SIG_FAILED, NODE_IMPLICIT, NodeKind, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::check::{
    Try, attempt, has_error_type, pop_scope, push_scope, resolve_type_or_error,
};
use crate::front::check::collect::{add_fn, slice_template, template_of_type_node};
use crate::front::check::distinct::distinct_inherits;
use crate::front::check::equality::eq_unsupported;
use crate::front::check::resolve::{resolve_type, type_name_key};
use crate::front::check::synth_mode::synth_expr;
use crate::front::closures::fn_bounds::{fn_bound_error, fn_bound_satisfied};
use crate::front::convert::{
    bound_args, buf_bound, collect_trait_params, err_bound, impl_trait_args, implements_with,
    same_trait_args, trait_param_count,
};
use crate::front::derive::derive_conflict_help;
use crate::front::derive::intrinsic::{copy_aggregate, is_plain, tuple_implements, tuple_operator};
use crate::front::distinct::is_distinct_type;
use crate::front::effects::check::note_effect_bound;
use crate::front::generics::{
    TPL_NONE, TPL_PATTERN, env_enter, env_leave, instance_of, instance_targs, mangle_type,
};
use crate::front::generics::instantiate::clone_node;
use crate::front::lexer::{SUF_NONE, Tok};
use crate::front::modules::{module_of, within_std};
use crate::front::modules::lookup::std_item_key;
use crate::front::own::kinds::is_plain_type;
use crate::front::patterns::check_pattern;
use crate::front::types::{
    TY_BOOL, TY_NEVER, TY_UNIT, TyKind, err_type, fn_param, is_fieldless_enum, is_integer,
    is_numeric, is_pointer, is_ref, make_type,
};

// (0.15: params, the Generics node of a generic trait's type parameters,
// 0 for none: convert::collect_trait_params)
pub struct TraitInfo { pub name: i64, pub node: i64, pub module: i64, pub params: i64 }

// An impl of trait `tr` for type `ty`, or (generic) for the instances of
// template `tpl` (generics.vl's encoding). (0.15: targs, the arguments
// of a generic trait, `impl From<i64> for T`: a TLISTS index, as many as
// the trait's parameters; convert::impl_trait_args.)
pub struct ImplInfo {
    pub node: i64, pub tr: i64, pub ty: i64, pub tpl: i64, pub module: i64, pub targs: i64,
}

pub fn init_traits(pcx: inout Ctx<Comp>) {
    sym_table(&pcx.sym_trait, &pcx);
}

pub fn add_trait(item: i64, key: i64, m: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.traits.push(TraitInfo { name: pcx.nodes[item].a, node: item, module: m, params: 0 });
        pcx.sym_trait[key] = pcx.traits.len() as i64;
        collect_trait_assoc(pcx.traits.len() as i64 - 1, &pcx);
        // (0.15: `trait From<T>`)
        collect_trait_params(pcx.traits.len() as i64 - 1, &pcx);
    }
}

fn set_fn_impl(f: i64, i: i64, pcx: inout Ctx<Comp>) {
    while pcx.fn_impl.count <= f {
        pcx.fn_impl.push(0);
    }
    unsafe { pcx.fn_impl.data[f] = i + 1; }
}

// The impl function f belongs to, or -1.
pub fn impl_of_fn(f: i64, pcx: Ctx<Comp>) -> i64 {
    if f < pcx.fn_impl.count { unsafe { pcx.fn_impl.data[f] - 1 } } else { -1 }
}

// The item node of the trait of the impl function f belongs to, or 0
// (volec query, 0.11).
pub fn impl_trait_node(f: i64, pcx: Ctx<Comp>) -> i64 {
    let i = impl_of_fn(f, pcx);
    if i < 0 {
        return 0;
    }
    let tr = pcx.traits_impls[i].tr;
    if tr < 0 { 0 } else { pcx.traits[tr].node }
}

// The trait named by type node n (in module CUR_MOD). (0.15: its type
// arguments, `From<i64>`, are the caller's: impl_trait_args, bound_args.)
pub fn trait_named(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let key = if pcx.nodes[n].kind == NodeKind::TyName { type_name_key(n, &pcx) } else { -1 };
        if key < 0 || pcx.sym_trait[key] == 0 {
            if key < 0 && auto_trait(n, &pcx) {
                // (0.27.0: `T: Send`, Rust's auto traits)
                crate::front::rust::later(pcx.nodes[n].start, pcx.nodes[n].end, "auto_trait",
                    "0.27.2", &pcx);
                crate::base::diag::err_jump(&pcx);
            }
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"'", pcx);
            if pcx.nodes[n].kind == NodeKind::TyName {
                err_sym(pcx.nodes[n].a, pcx);
            } else {
                // (0.27.0: not a name, `&Tr`: its text; its a is a node)
                crate::base::diag::err_fmt(SRC[pcx.nodes[n].start..pcx.nodes[n].end], pcx);
            }
            if key < 0 {
                err_str(c"' is not a trait in scope", pcx);
            } else {
                err_str(c"' is not a trait", pcx);
            }
            err_end(&pcx);
        }
        pcx.sym_trait[key] - 1
    }
}

// (0.27.0) Whether type node n is, in the rust edition, one of Rust's
// auto traits (`Send`, `Sync`, `Unpin`, `UnwindSafe`, `RefUnwindSafe`),
// which 0.27.0 does not have: edition.later (auto_trait).
fn auto_trait(n: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.edition == 0 || pcx.nodes[n].kind != NodeKind::TyName || pcx.nodes[n].list != 0
        || !crate::front::rust::rust_at(pcx.nodes[n].start, &pcx) {
        return false;
    }
    let name = sym_text(pcx.nodes[n].a, pcx);
    name == "Send" || name == "Sync" || name == "Unpin" || name == "UnwindSafe"
        || name == "RefUnwindSafe"
}

// The trait of bound node b (a TyName in a parameter's bounds), resolved
// in its own module once; -1 when it names none (0.10: an error recorded,
// and the bound holds for every type; 0.14: or it is an `Fn` bound; 0.16:
// or an `effects(...)` bound).
pub fn bound_trait(b: i64, pcx: inout Ctx<Comp>) -> i64 {
    // (0.14: `Fn(A) -> R` names no trait: fn_bound_satisfied)
    if pcx.nodes[b].kind == NodeKind::TyFn || pcx.nodes[b].kind == NodeKind::EffectSet {
        return -1;
    }
    if pcx.nodes[b].x == 0 {
        let saved = pcx.cur_mod;
        pcx.cur_mod = module_of(b, &pcx);
        pcx.nodes[b].x = if attempt(Try::Bound, b, &pcx) { pcx.try_result + 1 } else { -1 };
        pcx.cur_mod = saved;
    }
    if pcx.nodes[b].x < 0 { -1 } else { pcx.nodes[b].x - 1 }
}

// The function of trait tr named `name` (a Fn node), or 0.
pub fn trait_fn(tr: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    if tr < 0 {
        return 0;
    }
    let node = pcx.traits[tr].node;
    for i in 0..pcx.nodes[node].count {
        if pcx.nodes[child(node, i, pcx)].a == name {
            return child(node, i, pcx);
        }
    }
    0
}

pub fn trait_declares(tr: i64, name: i64, pcx: Ctx<Comp>) -> bool {
    tr < 0 || trait_fn(tr, name, pcx) != 0
}

// `impl<A> Tr for T<A>`: the impl's parameters, then f's own.
fn merged_generics(outer: i64, own: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Generics, pcx.nodes[outer].start, pcx.nodes[outer].end, &pcx);
    let mark = list_begin(pcx);
    for i in 0..pcx.nodes[outer].count {
        list_push(child(outer, i, pcx), &pcx);
    }
    if own != 0 {
        for i in 0..pcx.nodes[own].count {
            list_push(child(own, i, pcx), &pcx);
        }
    }
    list_end(n, mark, &pcx);
    pcx.nodes[n].a = pcx.nodes[outer].count;
    n
}

// (0.27.2) In the tree at n (a default body cloned from a generic
// trait's declaration), every bare name of one of the trait's parameters
// `params` becomes a copy of the trait argument an impl wrote for it,
// `args` (its Generics node; `Rhs` becomes `Self` for `impl PartialEq
// for T`), keeping the name's position. The fields walked are
// clone_node's. RULE: F12.1
pub fn subst_trait_args(n: i64, params: i64, args: i64, pcx: inout Ctx<Comp>) {
    if n == 0 || args == 0 {
        return;
    }
    let kind = pcx.nodes[n].kind;
    if kind == NodeKind::TyName && pcx.nodes[n].count == 0 && pcx.nodes[n].g == 0 {
        match crate::front::generics::instantiate::tparam_index(params, pcx.nodes[n].a, pcx) {
            Option::Some(k) => {
                if k < pcx.nodes[args].count {
                    let c = clone_node(child(args, k, pcx), &pcx);
                    let start = pcx.nodes[n].start;
                    let end = pcx.nodes[n].end;
                    pcx.nodes[n] = pcx.nodes[c];
                    pcx.nodes[n].start = start;
                    pcx.nodes[n].end = end;
                }
                return;
            }
            Option::None => {}
        }
    }
    if kind == NodeKind::Fn {
        subst_trait_args(pcx.nodes[n].b, params, args, &pcx);
        subst_trait_args(pcx.nodes[n].c, params, args, &pcx);
    } else {
        if crate::front::generics::instantiate::node_field_a(kind) {
            subst_trait_args(pcx.nodes[n].a, params, args, &pcx);
        }
        if crate::front::generics::instantiate::node_field_b(kind) {
            subst_trait_args(pcx.nodes[n].b, params, args, &pcx);
        }
        if crate::front::generics::instantiate::node_field_c(kind) {
            subst_trait_args(pcx.nodes[n].c, params, args, &pcx);
        }
        if kind == NodeKind::For || kind == NodeKind::Param {
            subst_trait_args(pcx.nodes[n].d, params, args, &pcx);
        }
        subst_trait_args(pcx.nodes[n].h, params, args, &pcx);
    }
    subst_trait_args(pcx.nodes[n].g, params, args, &pcx);
    for i in 0..pcx.nodes[n].count {
        subst_trait_args(child(n, i, pcx), params, args, &pcx);
    }
}

fn impl_is_generic(node: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[node].g != 0 && pcx.nodes[pcx.nodes[node].g].count > 0
}

fn impl_type_error(node: i64, before: *u8, tr: i64, after: *u8, pcx: inout Ctx<Comp>) {
    err_begin(pcx.nodes[node].start, &pcx);
    err_str(before, pcx);
    err_sym(pcx.traits[tr].name, pcx);
    err_str(c"' for '", pcx);
    let i = pcx.traits_impls.len() as i64 - 1;
    if pcx.traits_impls[i].ty != 0 {
        err_type(pcx.traits_impls[i].ty, pcx);
    } else if pcx.nodes[pcx.nodes[node].b].kind == NodeKind::TyName {
        err_sym(pcx.nodes[pcx.nodes[node].b].a, pcx);
    } else {
        // (0.27.0: a generic impl for a slice, `[T]`: its a is a node, not
        // a name)
        let t = pcx.nodes[node].b;
        err_fmt(format_args("{}", SRC[pcx.nodes[t].start..pcx.nodes[t].end]), pcx);
    }
    err_str(c"'", pcx);
    err_str(after, pcx);
    // (0.15: an impl `#[derive]` made)
    derive_conflict_help(node, pcx);
    err_end_soft(&pcx);
}

// The impl blocks of traits (a phase of the declarations, before the
// methods): their traits and types, coherence, and the default functions
// they leave out, copied into them.
pub fn collect_impls(pcx: inout Ctx<Comp>) {
    unsafe {
        // The bounds of every generic item name traits.
        for k in 0..pcx.nodes[pcx.program].count {
            let item = child(pcx.program, k, pcx);
            let kind = pcx.nodes[item].kind;
            let g = pcx.nodes[item].g;
            if g == 0
                || (kind != NodeKind::Fn && kind != NodeKind::Struct && kind != NodeKind::Enum) {
                continue;
            }
            for i in 0..pcx.nodes[g].count {
                let bounds = pcx.nodes[child(g, i, pcx)].h;
                if bounds != 0 {
                    for j in 0..pcx.nodes[bounds].count {
                        bound_trait(child(bounds, j, pcx), &pcx);
                    }
                }
            }
        }
        pcx.impl_extra.count = 0;
        for k in 0..pcx.nodes[pcx.program].count {
            let node = child(pcx.program, k, pcx);
            if pcx.nodes[node].kind != NodeKind::Impl {
                continue;
            }
            if !attempt(Try::Impl, node, &pcx) {
                // (its trait or type is unknown: its functions are left out)
                for i in 0..pcx.nodes[node].count {
                    let f = child(node, i, pcx);
                    pcx.nodes[f].p |= FN_SIG_FAILED;
                    fail_name(pcx.nodes[f].a, &pcx);
                }
            }
        }
        pcx.cur_mod = 0;
        if pcx.impl_extra.count > 0 {
            let mark = list_begin(pcx);
            for i in 0..pcx.nodes[pcx.program].count {
                list_push(child(pcx.program, i, pcx), &pcx);
            }
            for i in 0..pcx.impl_extra.count {
                list_push(pcx.impl_extra.data[i], &pcx);
            }
            list_end(pcx.program, mark, &pcx);
        }
    }
}

// Impl block `node`.
pub fn collect_impl(node: i64, pcx: inout Ctx<Comp>) {
    let m = module_of(node, &pcx);
    pcx.cur_mod = m;
    let tr = trait_named(pcx.nodes[node].a, &pcx);
    var ty = 0;
    var tpl = TPL_NONE;
    if impl_is_generic(node, pcx) {
        tpl = template_of_type_node(pcx.nodes[node].b, &pcx);
        // (0.14: `impl<T> Tr for [T]`)
        if tpl == TPL_NONE {
            tpl = slice_template(pcx.nodes[node].b, pcx.nodes[node].g, &pcx);
        }
        // RULE: F4.1, F5.1, F6.1, F14.1 (the rust edition: any other header
        // is a pattern impl, matched by match_type)
        if tpl == TPL_NONE && crate::front::rust::rust_at(pcx.nodes[node].start, &pcx) {
            tpl = TPL_PATTERN;
        }
        if tpl == TPL_NONE {
            err_begin(pcx.nodes[pcx.nodes[node].b].start, &pcx);
            err_str(c"a generic impl is for a generic struct or enum, with the impl's parameters as its arguments: 'impl<T> Hash for Vec<T>'", pcx);
            err_end(&pcx);
        }
    } else {
        ty = resolve_type(pcx.nodes[node].b, &pcx);
    }
    // (0.26.3: an unsafe trait's impl is `unsafe impl`)
    crate::front::check::alloc_rules::check_impl_safety(node, tr, ty, &pcx);
    pcx.traits_impls.push(ImplInfo {
        node: node, tr: tr, ty: ty, tpl: tpl, module: m, targs: 0,
    });
    let me = pcx.traits_impls.len() as i64 - 1;
    // (0.15: `impl From<i64> for T`)
    impl_trait_args(me, &pcx);
    // Coherence: one impl per (trait, type) (0.15: per trait arguments
    // too, `From<i64>` and `From<[u8]>`).
    for j in 0..me {
        if pcx.traits_impls[j].tr != tr {
            continue;
        }
        let same = (ty != 0 && pcx.traits_impls[j].ty == ty)
            || (tpl != TPL_NONE && tpl != TPL_PATTERN && pcx.traits_impls[j].tpl == tpl)
            || (ty != 0 && pcx.traits_impls[j].tpl != TPL_NONE
                && instance_of(ty, pcx.traits_impls[j].tpl, pcx))
            || (tpl != TPL_NONE && pcx.traits_impls[j].ty != 0
                && instance_of(pcx.traits_impls[j].ty, tpl, pcx));
        if same && same_trait_args(j, me, pcx) {
            impl_type_error(node, c"conflicting impls of trait '", tr,
                c" (one impl per trait and type)", &pcx);
            // (its functions are left out: the first impl's are the
            // type's)
            for i in 0..pcx.nodes[node].count {
                pcx.nodes[child(node, i, pcx)].p |= FN_SIG_FAILED;
            }
            return;
        }
    }
    collect_impl_assoc(me, &pcx);
    // Its functions: each one of the trait's.
    for i in 0..pcx.nodes[node].count {
        let f = child(node, i, pcx);
        set_fn_impl(pcx.nodes[f].x - 1, me, &pcx);
        if trait_fn(tr, pcx.nodes[f].a, pcx) == 0 {
            err_begin(pcx.nodes[f].start, &pcx);
            err_str(c"'", pcx);
            err_sym(pcx.nodes[f].a, pcx);
            err_str(c"' is not a function of trait '", pcx);
            err_sym(pcx.traits[tr].name, pcx);
            err_str(c"'", pcx);
            err_end_soft(&pcx);
        }
    }
    // The trait's functions it leaves out: their defaults.
    let tnode = pcx.traits[tr].node;
    for i in 0..pcx.nodes[tnode].count {
        let decl = child(tnode, i, pcx);
        var found = false;
        for j in 0..pcx.nodes[node].count {
            if pcx.nodes[child(node, j, pcx)].a == pcx.nodes[decl].a {
                found = true;
            }
        }
        // (0.15: a generic trait's function without a body was
        // reported by collect_trait_params)
        // RULE: F12.1 (0.27.2: a generic trait's default is copied with the
        // trait's arguments substituted, subst_trait_args)
        let generic_default = trait_param_count(tr, pcx) != 0 && pcx.nodes[decl].c != 0;
        if found
            || generic_default && !crate::front::rust::rust_at(pcx.nodes[node].start, &pcx) {
            continue;
        }
        if pcx.nodes[decl].c == 0 {
            err_begin(pcx.nodes[node].start, &pcx);
            err_str(c"the impl of trait '", pcx);
            err_sym(pcx.traits[tr].name, pcx);
            err_str(c"' is missing '", pcx);
            err_sym(pcx.nodes[decl].a, pcx);
            err_str(c"'", pcx);
            err_help(c"it has no default: write it in the impl", pcx);
            err_end_soft(&pcx);
            continue;
        }
        let f = clone_node(decl, &pcx);
        if generic_default {
            subst_trait_args(f, pcx.traits[tr].params, pcx.nodes[pcx.nodes[node].a].g, &pcx);
        }
        pcx.nodes[f].d = if pcx.nodes[pcx.nodes[node].b].kind
            == NodeKind::TyName { pcx.nodes[pcx.nodes[node].b].a }
            else { intern_c(c"_", &pcx) };
        pcx.nodes[f].h = pcx.nodes[node].b;
        if impl_is_generic(node, pcx) {
            pcx.nodes[f].g = merged_generics(pcx.nodes[node].g, pcx.nodes[f].g, &pcx);
        }
        pcx.nodes[f].p |= 1 | FN_DEFAULT_COPY;
        // (0.14: checked only when used, ensure_checked; `sum` is no
        // error for an iterator of slices that never sums)
        if pcx.nodes[f].g == 0 {
            pcx.nodes[f].p |= FN_LAZY;
        }
        add_fn(f, pcx.nodes[f].a, pcx.nodes[f].a, &pcx);
        // (checked in the trait's module, where it is written; 0.13:
        // the impl's, which does not see the names a std default uses)
        pcx.fns[pcx.fns.len() as i64 - 1].module = pcx.traits[tr].module;
        set_fn_impl(pcx.fns.len() as i64 - 1, me, &pcx);
        pcx.impl_extra.push(f);
    }
}

// After the signatures are resolved: each function of a (non-generic)
// impl has its trait's signature, with Self the impl's type.
pub fn check_impl_signatures(pcx: inout Ctx<Comp>) {
    unsafe {
        for f in 0..pcx.fns.len() as i64 {
            let i = impl_of_fn(f, pcx);
            if i < 0 || pcx.fns[f].generic > 0 || pcx.fns[f].tmpl != 0
                || (pcx.nodes[pcx.fns[f].node].p & FN_SIG_FAILED) != 0 {
                continue;
            }
            let tr = pcx.traits_impls[i].tr;
            let decl = trait_fn(tr, pcx.nodes[pcx.fns[f].node].a, pcx);
            if decl == 0 || pcx.nodes[decl].g != 0 {
                continue;
            }
            let saved_mod = pcx.cur_mod;
            let saved_self = pcx.self_type;
            pcx.cur_mod = pcx.traits[tr].module;
            pcx.self_type = pcx.fns[f].self_ty;
            // (0.27.2: the declaration's `Self::Output` is this impl's, F13.1)
            pcx.self_impl = i;
            pcx.assoc_trait = tr;
            pcx.assoc_targs = pcx.traits_impls[i].targs;
            // (0.15: a generic trait's parameters are the impl's arguments)
            let count = trait_param_count(tr, pcx);
            if count != 0 && pcx.traits_impls[i].targs < 0 {
                pcx.cur_mod = saved_mod;
                pcx.self_type = saved_self;
                continue;
            }
            let saved_env = if count
                != 0 { env_enter(pcx.traits[tr].params, pcx.traits_impls[i].targs, count, &pcx) }
                else { 0 };
            let mark = pcx.tscratch.count;
            for k in 0..pcx.nodes[decl].count {
                // (0.20: a let parameter of the trait's is a copy or a
                // reference by the impl's types, front/conv)
                let p = child(decl, k, pcx);
                let pcx_arg = crate::front::conv::param_type(p,
                    resolve_type_or_error(pcx.nodes[p].b, &pcx), &pcx);
                pcx.tscratch.push(pcx_arg);
            }
            let ret = if pcx.nodes[decl].b == 0 { TY_UNIT }
                else { resolve_type_or_error(pcx.nodes[decl].b, &pcx) };
            // (0.24: as the impl's, conv::let_by_ref)
            for k in 0..pcx.nodes[decl].count {
                pcx.tscratch.data[mark + k] = crate::front::conv::let_by_ref(child(decl, k, pcx),
                    pcx.tscratch.data[mark + k], ret, &pcx);
            }
            if count != 0 {
                env_leave(saved_env, &pcx);
            }
            pcx.cur_mod = saved_mod;
            pcx.self_type = saved_self;
            pcx.self_impl = -1;
            pcx.assoc_trait = -1;
            pcx.assoc_targs = -1;
            let count = pcx.tscratch.count - mark;
            var same = count == pcx.fns[f].param_count && ret == pcx.fns[f].ret
                && ((pcx.nodes[decl].p & 64) == (pcx.nodes[pcx.fns[f].node].p & 64));
            // (0.18.1, V4: an impl's `*T` where the trait has `&T` or `&mut
            // T`, the legacy spelling: an error, its body checked with the
            // trait's types, so that `fix --values` sees the calls)
            var raw_at = -1;
            if same {
                for k in 0..count {
                    let tt = pcx.tscratch.data[mark + k];
                    let it = fn_param(f, k, pcx);
                    if tt != it && is_ref(tt, pcx) && it > 0 && pcx.types[it].kind == TyKind::Ptr
                        && pcx.types[it].b == 0 && pcx.types[it].a == pcx.types[tt].a {
                        pcx.tlists.data[pcx.fns[f].params + k] = tt;
                        if raw_at < 0 {
                            raw_at = k;
                        }
                    }
                    else if tt != it
                        && crate::front::conv::legacy_ref_for_copy(child(pcx.fns[f].node, k, pcx),
                            child(decl, k, pcx), it, tt, pcx) {
                        // (0.20, §9.3: an impl in 0.19's spelling of a trait's
                        // let parameter: it keeps its reference)
                    }
                    else if tt != it
                        && crate::front::conv::let_copy_for_ref(child(pcx.fns[f].node, k, pcx), it,
                            tt, pcx) {
                        // (0.20: the impl's let parameter of a copyable type where
                        // the trait takes `&T`: the trait's, an access)
                        pcx.tlists.data[pcx.fns[f].params + k] = tt;
                    }
                    else if tt != it && pcx.types[tt].kind == TyKind::Ptr
                        && pcx.types[tt].b == crate::front::types::REF_MUT && it > 0
                        && pcx.types[it].kind == TyKind::Ptr
                        && pcx.types[it].b == crate::front::types::REF_SHARED
                        && pcx.types[it].a == pcx.types[tt].a
                        && !crate::front::conv::strict_at(
                            pcx.nodes[child(pcx.fns[f].node, k, pcx)].start,
                            &pcx) {
                        // (0.20: an impl in 0.19's spelling taking `&T` where
                        // the trait's parameter is inout, as `Iterator::at`'s
                        // receiver became: it reads only, which is sound)
                    }
                    else if tt != it
                        && !crate::front::conv::let_for_value(child(pcx.fns[f].node, k, pcx), it,
                            tt, pcx) {
                        same = false;
                    }
                }
            }
            if same && raw_at >= 0 {
                let item = pcx.fns[f].node;
                let p = child(item, raw_at, pcx);
                err_begin(pcx.nodes[p].start, &pcx);
                err_str(c"'", pcx);
                err_sym(pcx.nodes[item].a, pcx);
                err_str(c"' takes '", pcx);
                err_sym(pcx.nodes[p].a, pcx);
                err_str(c"' as a raw pointer where trait '", pcx);
                err_sym(pcx.traits[tr].name, pcx);
                err_str(c"' declares '", pcx);
                err_type(pcx.tscratch.data[mark + raw_at], pcx);
                err_str(c"'", pcx);
                err_help(c"a `*T` is a raw pointer (0.18.1): an impl spells the trait's references (the try: line respells every such impl)", pcx);
                err_try_tool("fix --values", true, pcx);
                err_end_soft(&pcx);
            }
            // (a type that failed, in either, follows from an earlier error)
            var failed = has_error_type(ret, pcx) || has_error_type(pcx.fns[f].ret, pcx);
            for k in 0..count {
                if has_error_type(pcx.tscratch.data[mark + k], pcx) {
                    failed = true;
                }
            }
            for k in 0..pcx.fns[f].param_count {
                if has_error_type(fn_param(f, k, pcx), pcx) {
                    failed = true;
                }
            }
            if !same && !failed {
                // (what differs is the error type from now on: the uses of
                // the function report nothing more about it)
                if ret != pcx.fns[f].ret {
                    pcx.fns[f].ret = pcx.ty_error;
                }
                for k in 0..pcx.fns[f].param_count {
                    if k >= count || pcx.tscratch.data[mark + k] != fn_param(f, k, pcx) {
                        pcx.tlists.data[pcx.fns[f].params + k] = pcx.ty_error;
                    }
                }
                let expected = make_type(TyKind::Fn, ret, 0, mark, &pcx);
                err_begin(pcx.nodes[pcx.fns[f].node].start, &pcx);
                err_str(c"'", pcx);
                err_sym(pcx.nodes[pcx.fns[f].node].a, pcx);
                err_str(c"' does not have the signature trait '", pcx);
                err_sym(pcx.traits[tr].name, pcx);
                err_str(c"' declares: expected '", pcx);
                if (pcx.nodes[decl].p & 64) != 0 {
                    err_str(c"unsafe ", pcx);
                }
                err_type(expected, pcx);
                err_str(c"'", pcx);
                err_end_soft(&pcx);
            }
            pcx.tscratch.count = mark;
        }
    }
}

// ---- Whether a type implements a trait ----

// std's trait `name`, or -1 (std not loaded, or no such trait).
pub fn std_trait(name: *u8, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.std_module < 0 {
            return -1;
        }
        let key = std_item_key(intern_c(name, &pcx), &pcx);
        if key < 0 || pcx.sym_trait[key] == 0 { -1 } else { pcx.sym_trait[key] - 1 }
    }
}

// (0.27.2) The bindings of impl i's type parameters for type t: a TLISTS
// index of as many types as the impl has parameters (0 for one the
// header leaves unbound, F14.1), or -1 when the impl is not for t. A
// concrete impl is for its type (no parameters); a template impl for
// the template's instances, bound by position; a pattern impl
// (TPL_PATTERN) by match_type over its header. The bounds are not
// checked here (impl_applies). RULE: F0.3
pub fn impl_bindings(i: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    // UNSAFE: alloc_array/free for the bindings, as instantiate_call's.
    // SAFETY: bound has `count` slots, written for k < count only, and is
    // freed on every path before returning.
    unsafe {
        let ty = pcx.traits_impls[i].ty;
        let tpl = pcx.traits_impls[i].tpl;
        if ty != 0 {
            return if ty == t { crate::front::generics::take_targs(pcx.tscratch.count, &pcx) }
                else { -1 };
        }
        if tpl == TPL_NONE {
            return -1;
        }
        if tpl != TPL_PATTERN {
            return if instance_of(t, tpl, pcx) { instance_targs(t, &pcx) } else { -1 };
        }
        let node = pcx.traits_impls[i].node;
        let params = pcx.nodes[node].g;
        let count = pcx.nodes[params].count;
        let bound = alloc_array::<i64>(count);
        for k in 0..count {
            bound[k] = 0;
        }
        let ok = crate::front::generics::instantiate::match_type(params, bound,
            pcx.traits_impls[i].module, pcx.nodes[node].b, t, &pcx);
        var r = -1;
        if ok {
            let mark = pcx.tscratch.count;
            for k in 0..count {
                pcx.tscratch.push(bound[k]);
            }
            r = crate::front::generics::take_targs(mark, &pcx);
        }
        free(bound as *u8);
        r
    }
}

// (0.27.2) impl_bindings when the impl's bounds hold for them too (an
// unbound parameter's are not checked: they hold for what fixes it
// later); -1 otherwise. The depth of nested impl searches is bounded
// by MAX_ASSOC_DEPTH (F0.3), as the associated types' is. RULE: F0.3, F0.4(c)
pub fn impl_applies(i: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    // UNSAFE: TLISTS is a raw table (base/comp.vl); every table read is.
    // SAFETY: b..b + count was written by impl_bindings for these params.
    unsafe {
        let b = impl_bindings(i, t, &pcx);
        if b < 0 || pcx.traits_impls[i].ty != 0 {
            return b;
        }
        if pcx.assoc_depth >= crate::front::assoc::MAX_ASSOC_DEPTH {
            return -1;
        }
        let params = pcx.nodes[pcx.traits_impls[i].node].g;
        let count = pcx.nodes[params].count;
        pcx.assoc_depth += 1;
        let saved = env_enter(params, b, count, &pcx);
        var ok = true;
        for k in 0..count {
            let arg = pcx.tlists.data[b + k];
            if arg != 0 && !satisfies(child(params, k, pcx), arg, &pcx) {
                ok = false;
            }
        }
        env_leave(saved, &pcx);
        pcx.assoc_depth -= 1;
        if ok { b } else { -1 }
    }
}

// (0.27.2) Whether impl i is a blanket impl: a pattern impl whose self
// type is one of its own parameters (`impl<T: ?Sized> Borrow<T> for T`,
// `impl<I: Iterator> IntoIterator for I`). RULE: F4.1, F11.4
pub fn blanket_impl(i: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.traits_impls[i].tpl != TPL_PATTERN {
        return false;
    }
    let node = pcx.traits_impls[i].node;
    let b = pcx.nodes[node].b;
    pcx.nodes[b].kind == NodeKind::TyName && pcx.nodes[b].g == 0 && pcx.nodes[b].count == 0
        && crate::front::generics::instantiate::tparam_index(pcx.nodes[node].g, pcx.nodes[b].a,
            pcx).is_some()
}

// (0.27.2) Whether impl i (of a generic trait) is for the trait
// arguments a declaration is being read with (pcx.assoc_trait,
// pcx.assoc_targs: convert::decl_param, check_impl_signatures); true
// when none are, or the impl's are unknown for t. RULE: F13.1
pub fn trait_args_agree(i: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    let tr = pcx.traits_impls[i].tr;
    if pcx.assoc_trait != tr || pcx.assoc_targs < 0 {
        return true;
    }
    let count = crate::front::convert::trait_param_count(tr, pcx);
    if count == 0 {
        return true;
    }
    let a = crate::front::convert::impl_targs(i, t, &pcx);
    a < 0 || crate::front::convert::same_list(a, pcx.assoc_targs, count, pcx)
}

// (0.27.2) The bindings of the impl parameters of f, a method of a
// pattern impl (TPL_PATTERN in GMETHODS), for receiver type t: a TLISTS
// index of every parameter of f's merged generics (the impl's first,
// its own 0), with the impl's bounds holding for what the header
// bound; -1 when the header does not match t. RULE: F0.3, F0.5(i)
pub fn fn_pattern_bindings(f: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    // UNSAFE: alloc_array/free for the bindings, as impl_bindings'.
    // SAFETY: bound has `count` slots (the merged generics' count), read and
    // written for k < count only, and is freed before returning.
    unsafe {
        let item = pcx.fns[f].node;
        let params = pcx.nodes[item].g;
        let count = pcx.nodes[params].count;
        let impl_count = pcx.nodes[params].a;
        let bound = alloc_array::<i64>(count);
        for k in 0..count {
            bound[k] = 0;
        }
        let ok = crate::front::generics::instantiate::match_type(params, bound,
            pcx.fns[f].module, pcx.nodes[item].h, t, &pcx);
        var r = -1;
        if ok && pcx.assoc_depth < crate::front::assoc::MAX_ASSOC_DEPTH {
            let mark = pcx.tscratch.count;
            for k in 0..count {
                pcx.tscratch.push(bound[k]);
            }
            r = crate::front::generics::take_targs(mark, &pcx);
            pcx.assoc_depth += 1;
            let saved = env_enter(params, r, impl_count, &pcx);
            for k in 0..impl_count {
                if bound[k] != 0 && !satisfies(child(params, k, pcx), bound[k], &pcx) {
                    r = -1;
                }
            }
            env_leave(saved, &pcx);
            pcx.assoc_depth -= 1;
        }
        free(bound as *u8);
        r
    }
}

// Whether t implements tr through an impl block.
pub fn has_impl(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    // RULE: F0.4(c), F4.3 (every impl of tr is tried: the one whose header
    // matches and whose bounds hold; 0.14: a template's bounds too)
    for i in 0..pcx.traits_impls.len() as i64 {
        if pcx.traits_impls[i].tr == tr && impl_applies(i, t, &pcx) >= 0 {
            return true;
        }
    }
    false
}

// (0.15) For t an instance of a generic type with an impl of tr: 0 when
// the impl's bounds hold, else the type argument that misses them (`U` of
// `Vec<U>` for Eq), or t when none alone does. 0 too when no generic
// impl of tr is for t's type.
pub fn unmet_impl_arg(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        for i in 0..pcx.traits_impls.len() as i64 {
            if pcx.traits_impls[i].tr != tr || pcx.traits_impls[i].tpl == TPL_NONE
                || pcx.traits_impls[i].tpl == TPL_PATTERN
                || !instance_of(t, pcx.traits_impls[i].tpl, pcx) {
                continue;
            }
            if has_impl(tr, t, &pcx) {
                return 0;
            }
            let params = pcx.nodes[pcx.traits_impls[i].node].g;
            let targs = instance_targs(t, &pcx);
            let saved = env_enter(params, targs, pcx.nodes[params].count, &pcx);
            var bad = t;
            for k in 0..pcx.nodes[params].count {
                if bad == t && !satisfies(child(params, k, pcx), pcx.tlists.data[targs + k], &pcx) {
                    bad = pcx.tlists.data[targs + k];
                }
            }
            env_leave(saved, &pcx);
            return bad;
        }
        0
    }
}

// The operator traits builtin types implement without an impl block.
fn intrinsic(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    // (0.18: a distinct type's traits from its underlying type)
    if is_distinct_type(t, pcx) {
        return distinct_inherits(tr, t, &pcx);
    }
    if tr == std_trait(c"Add", &pcx) || tr == std_trait(c"Sub", &pcx)
        || tr == std_trait(c"Mul", &pcx)
        || tr == std_trait(c"Div", &pcx) || tr == std_trait(c"Neg", &pcx) {
        return is_numeric(t);
    }
    if tr == std_trait(c"Eq", &pcx) {
        return eq_unsupported(t, &pcx) == 0 || tuple_implements(tr, t, &pcx);
    }
    if tr == std_trait(c"Ord", &pcx) {
        return is_numeric(t) || is_pointer(t, pcx) || is_fieldless_enum(t, pcx)
            || tuple_implements(tr, t, &pcx);
    }
    // (0.15: tuples of Eq, Ord, Hash, Clone types; Clone for the types
    // that copy)
    if tr == std_trait(c"Hash", &pcx) {
        return tuple_implements(tr, t, &pcx);
    }
    // (0.17: `T: Copy` holds for plain types, front/own/kinds.vl)
    if tr == std_trait(c"Copy", &pcx) {
        return is_plain_type(t, &pcx);
    }
    // (0.26.1: `T: Freeze` holds when T holds no UnsafeCell, front/cells.vl)
    if tr == std_trait(c"Freeze", &pcx) {
        return crate::front::cells::is_freeze(t, pcx);
    }
    // (0.26.3: `T: AllocFree` holds when T holds no allocator,
    // front/check/alloc_rules.vl)
    if tr == std_trait(c"AllocFree", &pcx) {
        return crate::front::check::alloc_rules::is_alloc_free(t, &pcx);
    }
    if tr == std_trait(c"Clone", &pcx) {
        // (0.17: what owns nothing, structs too, clones by copying)
        return is_plain(t, pcx) || copy_aggregate(t, &pcx) || tuple_implements(tr, t, &pcx);
    }
    atomic_bound(tr, t, &pcx)
}

// (0.25.5) std::sync::atomic's bounds, which only these types implement
// (std seals them: their function names a private type, so no impl can
// add one): AtomicValue, what an Atomic holds (an integer, a bool or a raw
// pointer: one access of 1 to 8 bytes); AtomicBitwise, the fetch_and,
// fetch_or and fetch_xor of the integers and bool; AtomicInteger, the
// arithmetic of the integers.
fn atomic_bound(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    // UNSAFE: TRAITS is the checker's raw table of traits.
    // SAFETY: tr is a trait's index (implements's callers pass one, never
    // -1: implements returns before), below the table's count.
    unsafe {
        if !within_std(pcx.traits[tr].module, pcx) {
            return false;
        }
        let name = pcx.traits[tr].name;
        if name == intern_c(c"AtomicValue", &pcx) {
            return is_integer(t) || t == TY_BOOL || is_pointer(t, pcx);
        }
        if name == intern_c(c"AtomicBitwise", &pcx) {
            return is_integer(t) || t == TY_BOOL;
        }
        name == intern_c(c"AtomicInteger", &pcx) && is_integer(t)
    }
}

pub fn implements(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    tr < 0 || has_error_type(t, pcx) || t == TY_NEVER || has_impl(tr, t, &pcx)
        || intrinsic(tr, t, &pcx)
}

// Whether type t satisfies the bounds of parameter node p.
pub fn satisfies(p: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    let bounds = pcx.nodes[p].h;
    if bounds == 0 {
        return true;
    }
    for i in 0..pcx.nodes[bounds].count {
        let b = child(bounds, i, pcx);
        // (0.15: `From<U>`, a generic trait's bound)
        if pcx.nodes[b].g != 0
            && !implements_with(bound_trait(b, &pcx), t, bound_args(b, &pcx), &pcx)
            || pcx.nodes[b].g == 0 && !implements(bound_trait(b, &pcx), t, &pcx) {
            return false;
        }
        // (0.14: `Fn(A) -> R`, and constraints `Iterator<Item = A>`)
        if pcx.nodes[b].kind == NodeKind::TyFn && !fn_bound_satisfied(b, t, &pcx)
            || pcx.nodes[b].h != 0 && !assoc_constraints_hold(b, t, &pcx) {
            return false;
        }
    }
    true
}

// The bounds the declarations met, now that every impl is known.
pub fn check_later_bounds(pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.impls_known = true;
        var i = 0;
        while i < pcx.bounds_later.count {
            let d = pcx.bounds_later.data;
            check_bounds(d[i], d[i + 1], d[i + 2], d[i + 3], d[i + 4], &pcx);
            i += 5;
        }
        pcx.bounds_later.count = 0;
    }
}

// The type arguments TLISTS[targs..] of generic item `what` (its name),
// with parameters `params`, satisfy their bounds; an error at pos if not.
pub fn check_bounds(params: i64, targs: i64, count: i64, what: i64, pos: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if params == 0 {
            return;
        }
        if !pcx.impls_known {
            pcx.bounds_later.push(params);
            pcx.bounds_later.push(targs);
            pcx.bounds_later.push(count);
            pcx.bounds_later.push(what);
            pcx.bounds_later.push(pos);
            return;
        }
        // (0.14: the parameters bound, for the constraints, `Item = T`)
        let saved = env_enter(params, targs, count, &pcx);
        for k in 0..count {
            let p = child(params, k, pcx);
            let bounds = pcx.nodes[p].h;
            if bounds == 0 {
                continue;
            }
            let t = pcx.tlists.data[targs + k];
            if t == pcx.ty_error && pcx.check_unchecked {
                continue;
            }
            for i in 0..pcx.nodes[bounds].count {
                let b = child(bounds, i, pcx);
                // (0.14: constraints `Iterator<Item = A>`)
                if pcx.nodes[b].h != 0 && !assoc_constraints_hold(b, t, &pcx) {
                    constraint_error(b, t, pcx.nodes[p].a, what, pos, &pcx);
                }
                // (0.14: `Fn(A) -> R`, its types with the parameters bound
                // to the arguments)
                if pcx.nodes[b].kind == NodeKind::TyFn {
                    let saved = env_enter(params, targs, count, &pcx);
                    let ok = fn_bound_satisfied(b, t, &pcx);
                    env_leave(saved, &pcx);
                    if !ok {
                        fn_bound_error(b, t, pcx.nodes[p].a, what, pos, &pcx);
                    }
                }
                // (0.16: `effects(...)`, checked once effects are known)
                if pcx.nodes[b].kind == NodeKind::EffectSet {
                    note_effect_bound(b, t, pos, p, what, &pcx);
                    continue;
                }
                let tr = bound_trait(b, &pcx);
                // (0.15: `From<U>`, a generic trait's bound)
                let bargs = if pcx.nodes[b].g != 0 { bound_args(b, &pcx) } else { -1 };
                let holds = if bargs >= 0 { implements_with(tr, t, bargs, &pcx) }
                    else { implements(tr, t, &pcx) };
                if !holds {
                    err_begin(pos, &pcx);
                    err_str(c"the trait '", pcx);
                    if bargs >= 0 {
                        err_bound(tr, bargs, &pcx);
                    } else {
                        err_sym(pcx.traits[tr].name, pcx);
                    }
                    err_str(c"' is not implemented for '", pcx);
                    err_type(t, pcx);
                    err_str(c"'", pcx);
                    err_help(c"required by the bound '", pcx);
                    err_help_sym(pcx.nodes[p].a, pcx);
                    // (0.26.2: a parameter `x: impl Hash` is its bound)
                    if (pcx.nodes[p].p & NODE_IMPLICIT) == 0 {
                        err_help(c": ", pcx);
                        if bargs >= 0 {
                            buf_bound(pcx.err_help, tr, bargs, pcx);
                        } else {
                            err_help_sym(pcx.traits[tr].name, pcx);
                        }
                    }
                    err_help(c"' of '", pcx);
                    err_help_sym(what, pcx);
                    err_help(c"'", pcx);
                    err_end(&pcx);
                }
            }
        }
        env_leave(saved, &pcx);
    }
}

// ---- Bounded parameters in generic code ----

// The parameter node of the instance being checked named `name`, when
// it has bounds; 0 otherwise.
pub fn bounded_param(name: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.cur_inst < 0 || pcx.fns[pcx.cur_inst].tmpl == 0 {
        return 0;
    }
    let g = pcx.nodes[pcx.fns[pcx.fns[pcx.cur_inst].tmpl - 1].node].g;
    if g == 0 {
        return 0;
    }
    for i in 0..pcx.nodes[g].count {
        let p = child(g, i, pcx);
        if pcx.nodes[p].a == name {
            return if pcx.nodes[p].h != 0 { p } else { 0 };
        }
    }
    0
}

// The bounded parameter a declared type (a parameter's type node) names,
// itself or through a pointer, or 0.
pub fn bounded_param_of_type(n: i64, pcx: Ctx<Comp>) -> i64 {
    var t = n;
    if t != 0 && pcx.nodes[t].kind == NodeKind::TyPtr {
        t = pcx.nodes[t].a;
    }
    if t == 0 || pcx.nodes[t].kind != NodeKind::TyName || pcx.nodes[t].g != 0
        || pcx.nodes[t].count != 0 {
        return 0;
    }
    bounded_param(pcx.nodes[t].a, pcx)
}

// Function `name`, used through bounded parameter p, must be one of its
// bounds'.
pub fn require_in_bounds(p: i64, name: i64, pos: i64, pcx: inout Ctx<Comp>) {
    let bounds = pcx.nodes[p].h;
    for i in 0..pcx.nodes[bounds].count {
        if trait_declares(bound_trait(child(bounds, i, pcx), &pcx), name, pcx) {
            return;
        }
    }
    err_begin(pos, &pcx);
    err_str(c"no function '", pcx);
    err_sym(name, pcx);
    err_str(c"' in the bounds of '", pcx);
    err_sym(pcx.nodes[p].a, pcx);
    err_str(c"'", pcx);
    for tr in 0..pcx.traits.len() as i64 {
        if trait_declares(tr, name, pcx) {
            err_help(c"add the bound: '", pcx);
            err_help_sym(pcx.nodes[p].a, pcx);
            err_help(c": ", pcx);
            err_help_sym(pcx.traits[tr].name, pcx);
            err_help(c"'", pcx);
            break;
        }
    }
    err_end(&pcx);
}

// ---- Operators ----

fn op_ident(name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Ident, pos, pos, &pcx);
    pcx.nodes[n].a = name;
    n
}

fn op_let(name: i64, init: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let p = new_node(NodeKind::PatBind, pos, pos, &pcx);
    pcx.nodes[p].a = name;
    let n = new_node(NodeKind::Let, pos, pos, &pcx);
    pcx.nodes[n].a = p;
    pcx.nodes[n].c = init;
    n
}

fn op_method(receiver: i64, name: *u8, arg: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::MethodCall, pos, pos, &pcx);
    pcx.nodes[n].a = receiver;
    pcx.nodes[n].b = intern_c(name, &pcx);
    let mark = list_begin(pcx);
    if arg != 0 {
        list_push(arg, &pcx);
    }
    list_end(n, mark, &pcx);
    n
}

// The trait of binary operator op on values of type t, when t implements
// it through an impl block (-1 otherwise).
pub fn binary_op_trait(op: Tok, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    // (the builtin scalars keep their operators)
    if is_numeric(t) || t == TY_BOOL || is_pointer(t, pcx) || pcx.types[t].kind == TyKind::Fn
        || t == TY_NEVER || t == pcx.ty_error {
        return -1;
    }
    let tr = if op == Tok::Plus {
        std_trait(c"Add", &pcx)
    } else if op == Tok::Minus {
        std_trait(c"Sub", &pcx)
    } else if op == Tok::Star {
        std_trait(c"Mul", &pcx)
    } else if op == Tok::Slash {
        std_trait(c"Div", &pcx)
    } else if op == Tok::EqEq || op == Tok::BangEq {
        std_trait(c"Eq", &pcx)
    } else if op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq {
        std_trait(c"Ord", &pcx)
    } else {
        -1
    };
    // (0.15: a tuple of Ord types is ordered by its `cmp`, one of Eq
    // types without the structural == compared by its `eq`)
    if tr >= 0 && (has_impl(tr, t, &pcx) || tuple_operator(tr, t, &pcx)) { tr } else { -1 }
}

// Rewrites binary node n (its operands checked, of type t) into a call of
// its trait's function:
//     { let ==l = a; let ==r = b; ==l.add(==r) }      (+ - * /)
//     { let ==l = a; let ==r = b; ==l.eq(&==r) }      (==; != negates)
//     { let ==l = a; let ==r = b; ==l.cmp(&==r) < 0 } (< > <= >=)
// and returns its type.
pub fn operator_call(n: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let op = pcx.nodes[n].op;
    let pos = pcx.nodes[n].start;
    // (0.17: an arithmetic operator's operands move into its by-value
    // `add(self, other)`: `=+` lets move, own/walk.vl; a comparison's
    // are read)
    let arith = !(op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::Gt
        || op == Tok::LtEq || op == Tok::GtEq);
    let l = if arith { intern_c(c"=+l", &pcx) } else { intern_c(c"==l", &pcx) };
    let r = if arith { intern_c(c"=+r", &pcx) } else { intern_c(c"==r", &pcx) };
    let block = new_node(NodeKind::Block, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
    let mark = list_begin(pcx);
    let let_l = op_let(l, pcx.nodes[n].b, pos, &pcx);
    let let_r = op_let(r, pcx.nodes[n].c, pos, &pcx);
    list_push(let_l, &pcx);
    list_push(let_r, &pcx);
    list_end(block, mark, &pcx);
    var tail = 0;
    if op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq
        || op == Tok::GtEq {
        let addr = new_node(NodeKind::Unary, pos, pos, &pcx);
        pcx.nodes[addr].op = Tok::Amp;
        pcx.nodes[addr].b = op_ident(r, pos, &pcx);
        if op == Tok::EqEq || op == Tok::BangEq {
            tail = op_method(op_ident(l, pos, &pcx), c"eq", addr, pos, &pcx);
            if op == Tok::BangEq {
                let not = new_node(NodeKind::Unary, pos, pos, &pcx);
                pcx.nodes[not].op = Tok::Bang;
                pcx.nodes[not].b = tail;
                tail = not;
            }
        } else {
            let zero = new_node(NodeKind::Int, pos, pos, &pcx);
            pcx.nodes[zero].b = SUF_NONE;
            let cmp = new_node(NodeKind::Binary, pos, pos, &pcx);
            pcx.nodes[cmp].op = op;
            pcx.nodes[cmp].b = op_method(op_ident(l, pos, &pcx), c"cmp", addr, pos, &pcx);
            pcx.nodes[cmp].c = zero;
            tail = cmp;
        }
    } else {
        let name = if op == Tok::Plus { c"add" } else if op == Tok::Minus { c"sub" }
            else if op == Tok::Star { c"mul" } else { c"div" };
        tail = op_method(op_ident(l, pos, &pcx), name, op_ident(r, pos, &pcx), pos, &pcx);
    }
    pcx.nodes[block].a = tail;
    // The operands are checked already: only their bindings are made.
    push_scope(&pcx);
    check_pattern(pcx.nodes[let_l].a, t, &pcx);
    check_pattern(pcx.nodes[let_r].a, pcx.nodes[pcx.nodes[n].c].ty, &pcx);
    let ty = synth_expr(tail, &pcx);
    if arith && pcx.nodes[tail].kind == NodeKind::Call && pcx.nodes[tail].x > 0 {
        // (0.20: an impl taking its operands let, `fn add(self, other:
        // Self)`, borrows them: they are read, not moved)
        let f = pcx.nodes[tail].x - 1;
        if crate::front::conv::fn_param_conv(f, 0, pcx) == crate::front::conv::CONV_LET {
            pcx.nodes[pcx.nodes[let_l].a].a = intern_c(c"==l", &pcx);
        }
        if crate::front::conv::fn_param_conv(f, 1, pcx) == crate::front::conv::CONV_LET {
            pcx.nodes[pcx.nodes[let_r].a].a = intern_c(c"==r", &pcx);
        }
    }
    pop_scope(&pcx);
    pcx.nodes[n] = pcx.nodes[block];
    pcx.nodes[n].ty = ty;
    ty
}

// `-a` on a type implementing std's Neg through an impl block: `{ let
// ==l = a; ==l.neg() }` (its operand checked, of type t).
pub fn negation_call(n: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let pos = pcx.nodes[n].start;
    // (0.17: the operand moves into `neg(self)`, as operator_call's)
    let l = intern_c(c"=+l", &pcx);
    let block = new_node(NodeKind::Block, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
    let mark = list_begin(pcx);
    let let_l = op_let(l, pcx.nodes[n].b, pos, &pcx);
    list_push(let_l, &pcx);
    list_end(block, mark, &pcx);
    let tail = op_method(op_ident(l, pos, &pcx), c"neg", 0, pos, &pcx);
    pcx.nodes[block].a = tail;
    push_scope(&pcx);
    check_pattern(pcx.nodes[let_l].a, t, &pcx);
    let ty = synth_expr(tail, &pcx);
    if pcx.nodes[tail].kind == NodeKind::Call && pcx.nodes[tail].x > 0
        && crate::front::conv::fn_param_conv(pcx.nodes[tail].x - 1, 0, pcx)
        == crate::front::conv::CONV_LET {
        // (0.20: `fn neg(self)`, let: read, not moved)
        pcx.nodes[pcx.nodes[let_l].a].a = intern_c(c"==l", &pcx);
    }
    pop_scope(&pcx);
    pcx.nodes[n] = pcx.nodes[block];
    pcx.nodes[n].ty = ty;
    ty
}

// The symbol part of a type without one (impls for builtin types):
// `T` and its code (generics.vl).
pub fn builtin_type_symbol(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_byte(out, 'T');
    mangle_type(out, t, &pcx);
    intern(buf_slice(out), &pcx)
}
