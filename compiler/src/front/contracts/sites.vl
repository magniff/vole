// The run-time check sites (0.18 T5, design §2.4): one record per check
// (contracts and the existing bounds, unwrap and `as E` checks), its
// position as file, line and column, from which the runtime prints
// `FILE:LINE:COL: WHAT: DETAILS`. Site 0 is "none": the message as before
// 0.18. The back ends pass a check's site to the run-time helper; the
// helper's tables (gen0/target.vl's emit_runtime) are written from
// SITE_FILE, SITE_LINE and SITE_COL once the code is emitted.
//
// A site is one per position: two checks at the same place (an index read
// twice, a clause checked by both back ends) share it.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::file_line_col;

pub const SITE_NONE: i64 = 0;

// The kinds of check (`lower_check`'s kinds stay as they are; these name
// the contract checks T1 adds).
pub const SITE_REQUIRES: i64 = 1;
pub const SITE_ENSURES: i64 = 2;
pub const SITE_INVARIANT: i64 = 3;
pub const SITE_ASSERT: i64 = 4;

// The file of position pos (a FILES index).
pub fn file_of_pos(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.files.len() as i64 - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if pcx.files[mid as usize].start <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// The line (from 1) of pos in file `file`, and its column through `col`.
// (0.25: diag's line index, per file, shared with the diagnostics; the
// lines were counted over all of SRC, from its start)
pub fn line_col(file: i64, pos: i64, col: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    file_line_col(file, pos, col, pcx)
}

// The site of check `kind` at `node` (its first character): its number
// in the table, made on first use.
pub fn site_of(node: i64, kind: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if node <= 0 {
        return SITE_NONE;
    }
    site_at(pcx.nodes[node as usize].start, pcx)
}

// The site at source position pos.
pub fn site_at(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.files.len() == 0 || pos < 0 || pcx.no_positions {
        return SITE_NONE;
    }
    let found = pcx.by_pos.get(pos + 1);
    if found != 0 {
        return found;
    }
    if pcx.site_file.count == 0 {
        pcx.site_file.push(0);
        pcx.site_line.push(0);
        pcx.site_col.push(0);
    }
    let file = file_of_pos(pos, pcx);
    let mut col: i64 = 0;
    let line = line_col(file, pos, &mut col, pcx);
    let site = pcx.site_file.count;
    pcx.site_file.push(file);
    pcx.site_line.push(line);
    pcx.site_col.push(col);
    pcx.by_pos.put(pos + 1, site);
    site
}

// The number of sites made (the helper's table has one entry per site,
// and an unused one at 0).
pub fn site_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.site_file.count
}
