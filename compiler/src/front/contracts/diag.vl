// The diagnostic codes of 0.18 (design §2.14), with their `explain`
// entries in tools/explain/v018_table.vl. Each task reports its own
// through these names, so that the codes and their entries stay one list.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::err_end_soft;

pub const CONTRACT_EFFECT: *const u8 = c"contract.effect";
pub const CONTRACT_OLD: *const u8 = c"contract.old";
pub const CONTRACT_RESULT: *const u8 = c"contract.result";
pub const CONTRACT_MESSAGE: *const u8 = c"contract.message";
pub const CONTRACT_VIOLATED: *const u8 = c"contract.violated";
pub const CONTRACT_SEALED: *const u8 = c"contract.sealed";
pub const CONTRACT_IMPL_REQUIRES: *const u8 = c"contract.impl-requires";
pub const DISTINCT_MIX: *const u8 = c"distinct.mix";
pub const DISTINCT_METHOD: *const u8 = c"distinct.method";
pub const DISTINCT_KIND: *const u8 = c"distinct.kind";
pub const TEST_SIGNATURE: *const u8 = c"test.signature";
pub const TEST_GENERATE: *const u8 = c"test.generate";
pub const IMPORT_WILDCARD: *const u8 = c"import.wildcard";
pub const MACRO_ARGS: *const u8 = c"macro.args";

// Ends the error being made (err_begin ...) as a soft error with code
// `code` (`error[contract.result]: ...`).
pub fn end_with_code(code: *const u8, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = code;
    err_end_soft(pcx);
    pcx.err_kind = saved;
}
