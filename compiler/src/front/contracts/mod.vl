// Contracts (0.18, docs/design/contracts-verification.md §2.1-§2.3,
// §2.10): what the parser read of `requires`, `ensures` and `invariant`
// clauses, `type X = distinct T`, and the test attributes, kept in side
// tables keyed by the item's node, so that the AST's Node is unchanged.
// Phase 0: read and kept, not checked (`check_contracts` is T1's; the
// test items are T2's; distinct types T4's).

pub mod ctx;
pub mod checks;
pub mod expand;
pub mod desugar;
pub mod sites;
pub mod diag;
pub mod flags;

use crate::base::{IntVec, SRC, buf_fmt, buf_new, buf_slice, cstr, free, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_fmt, err_help, err_str, err_try_tool, error_count};
use crate::front::ast::{NodeKind, child};
use crate::front::check::Res;
use crate::front::contracts::checks::{CHK_ENSURES, CHK_INVARIANT, CHK_REQUIRES};
use crate::front::contracts::diag::{CONTRACT_EFFECT, CONTRACT_OLD, end_with_code};
use crate::front::contracts::expand::subtree;
use crate::front::effects::{EFF_ALLOC_EXTERN, EFF_GLOBAL, EFF_IO, EFF_UNKNOWN, Effects, fn_effects};
use crate::front::effects::infer::expr_effects;
use crate::front::own::kinds::{is_owned_type, is_view_type};
use crate::front::types::err_type;

// A clause's kind (CLAUSE_KIND), with CLAUSE_DEBUG for `debug requires ...`.
pub const CLAUSE_REQUIRES: i64 = 1;
pub const CLAUSE_ENSURES: i64 = 2;
pub const CLAUSE_INVARIANT: i64 = 3;
pub const CLAUSE_DEBUG: i64 = 16;

// The test items (§2.6-§2.8): the node and its kind (TEST_FN for
// `#[test]`, TEST_PROPERTY, TEST_FUZZ, TEST_CFG for an item under
// `#[cfg(test)]`). Phase 0: they are compiled as ordinary items (T2 leaves
// them out of builds that are not tests, and scopes test modules).
pub const TEST_FN: i64 = 1;
pub const TEST_PROPERTY: i64 = 2;
pub const TEST_FUZZ: i64 = 3;
pub const TEST_CFG: i64 = 4;

pub fn add_clause(owner: i64, kind: i64, cond: i64, message: i64, pos: i64, pcx: inout Ctx<Comp>) {
    pcx.clause_owner.push(owner);
    pcx.clause_kind.push(kind);
    pcx.clause_cond.push(cond);
    pcx.clause_message.push(message);
    pcx.clause_pos.push(pos);
}

// How many clauses item `owner` has.
pub fn clause_count(owner: i64, pcx: Ctx<Comp>) -> i64 {
    var n = 0;
    unsafe {
        for i in 0..pcx.clause_owner.count {
            if pcx.clause_owner.data[i] == owner {
                n += 1;
            }
        }
    }
    n
}

pub fn mark_distinct(alias: i64, pcx: inout Ctx<Comp>) {
    pcx.distinct_aliases.push(alias);
}

pub fn is_distinct(alias: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        for i in 0..pcx.distinct_aliases.count {
            if pcx.distinct_aliases.data[i] == alias {
                return true;
            }
        }
    }
    false
}

pub fn add_test_item(item: i64, kind: i64, pcx: inout Ctx<Comp>) {
    pcx.test_item.push(item);
    pcx.test_kind.push(kind);
}

// The test kind of an item (TEST_FN, ...), or 0. An item under
// `#[cfg(test)]` that is also `#[test]` answers TEST_FN.
pub fn test_kind(item: i64, pcx: Ctx<Comp>) -> i64 {
    var kind = 0;
    unsafe {
        for i in 0..pcx.test_item.count {
            if pcx.test_item.data[i] == item && (kind == 0 || kind == TEST_CFG) {
                kind = pcx.test_kind.data[i];
            }
        }
    }
    kind
}

// The clauses checked (T1): each condition pure (no alloc, io or global:
// a passing check must not change what the program does, and turning
// `debug` clauses on and off must not either), from the inferred effects
// of what it calls (contract.effect). Called by check_program after the
// effects. (0.18, with 0.17's values) An ensures reads no moved
// parameter and keeps no view in an old(..) (contract.old). (The
// conditions' types and names were checked with the functions expand.vl
// made of them.)
pub fn check_contracts(pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.check_calls.count == 0 {
            return;
        }
        var seen = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..pcx.check_calls.count {
            let call = pcx.check_calls.data[i];
            if pcx.nodes[call].count < 3 {
                continue;
            }
            let check = pcx.nodes[child(call, 2, pcx)].a;
            if check < 0 || check >= pcx.check_kind.count
                || (0..seen.count).any(|j| seen.data[j] == check) {
                continue;
            }
            let kind = pcx.check_kind.data[check];
            if kind != CHK_REQUIRES && kind != CHK_ENSURES && kind != CHK_INVARIANT {
                continue;
            }
            if kind == CHK_ENSURES && ensures_values(child(call, 0, pcx), check, &pcx) {
                seen.push(check);
                continue;
            }
            if pcx.fn_effects_count != 0
                && (impure(child(call, 0, pcx), check, &pcx)
                    || impure_whole(child(call, 0, pcx), check, &pcx)) {
                seen.push(check);
            }
        }
        free(seen.data as *u8);
    }
}

// (0.18, with 0.17's values) contract.old in the ensures condition at n
// (of check `check`), reported once: the condition runs after the body,
// so a by-value parameter of an owned type is gone (the body took it),
// and an `old(e)` that views something would see what the body changed.
// Generic instances are left to the own pass, which rejects both too.
fn ensures_values(n: i64, check: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        if n <= 0 || pcx.nodes[n].kind == NodeKind::Closure {
            return false;
        }
        if pcx.nodes[n].kind == NodeKind::Ident && pcx.nodes[n].res == Res::Local {
            let l = pcx.nodes[n].y;
            let name = sym_text(pcx.locals[l].name, pcx);
            let ty = pcx.locals[l].ty;
            let owner = sym_text(pcx.nodes[pcx.check_owner.data[check]].a, pcx);
            if name.len > 4 && name[0..4] == "?old" && ty > 0 && is_view_type(ty, &pcx) {
                err_begin(pcx.nodes[n].start, &pcx);
                err_fmt(
                    format_args("'{}' keeps a view: the ensures of '{owner}' runs after the body, which may change what it views", SRC[pcx.nodes[n].start..pcx.nodes[n].end]), pcx);
                err_help(
                    c"take a plain part at entry (`old(x.len())`), or a copy (`old(x.clone())`)",
                    pcx);
                end_with_code(CONTRACT_OLD, &pcx);
                return true;
            }
            if pcx.locals[l].is_param && ty > 0 && is_owned_type(ty, &pcx) {
                err_begin(pcx.nodes[n].start, &pcx);
                err_fmt(
                    format_args(
                        "the ensures of '{owner}' reads '{name}' after the body took it ('"), pcx);
                err_type(ty, pcx);
                err_str(c"' is owned, passed by value)", pcx);
                err_help(c"read it at entry, `old(x.len())` or `old(x.clone())`, or take it by reference (`x: &T`)", pcx);
                end_with_code(CONTRACT_OLD, &pcx);
                return true;
            }
        }
        for k in 0..3 {
            if ensures_values(subtree(n, k, pcx), check, &pcx) {
                return true;
            }
        }
        for i in 0..pcx.nodes[n].count {
            if ensures_values(child(n, i, pcx), check, &pcx) {
                return true;
            }
        }
        false
    }
}

// Whether the condition at n (of check `check`) does io, allocates or
// touches a static; reported once.
fn impure(n: i64, check: i64, pcx: inout Ctx<Comp>) -> bool {
    if n <= 0 {
        return false;
    }
    let kind = pcx.nodes[n].kind;
    if kind == NodeKind::Closure {
        return false;
    }
    if kind == NodeKind::Ident && pcx.nodes[n].res == Res::Static {
        effect_error(n, check, -1, EFF_GLOBAL, &pcx);
        return true;
    }
    if kind == NodeKind::Call && pcx.nodes[n].x > 0 {
        let f = pcx.nodes[n].x - 1;
        let e = fn_effects(f, pcx);
        // (not inferred: a function that failed, a template checked with
        // errors in a query; not reported)
        // (unknown only after an error: a body or an instance of the
        // error type that failed, which reported it)
        if (e.bits & EFF_UNKNOWN) != 0 {
            return false;
        }
        let bad = impure_bit(e);
        if bad != 0 && f != pcx.check_fn {
            effect_error(n, check, f, bad, &pcx);
            return true;
        }
    }
    for k in 0..3 {
        if impure(subtree(n, k, pcx), check, &pcx) {
            return true;
        }
    }
    for i in 0..pcx.nodes[n].count {
        if impure(child(n, i, pcx), check, &pcx) {
            return true;
        }
    }
    // (0.25) A call through a fn value: what the functions it may
    // call do.
    if kind == NodeKind::Call && pcx.nodes[n].x <= 0 {
        let bad = impure_bit(expr_effects(n, &pcx));
        if bad != 0 && (bad != -4 || error_count(pcx) == 0) {
            effect_error(n, check, -3, bad, &pcx);
            return true;
        }
    }
    false
}

// (0.25) Whether condition n does io, allocates or touches a static by any
// other way than impure finds (all that the effect inference sees of it);
// reported at the condition.
fn impure_whole(n: i64, check: i64, pcx: inout Ctx<Comp>) -> bool {
    let bad = impure_bit(expr_effects(n, &pcx));
    if bad == 0 || bad == -4 {
        return false;
    }
    effect_error(n, check, -5, bad, &pcx);
    true
}

// (0.25) What makes effects e impure in a condition: -4 unknown
// (conservatively), -2 alloc, EFF_IO, EFF_GLOBAL, or 0.
fn impure_bit(e: Effects) -> i64 {
    if (e.bits & EFF_UNKNOWN) != 0 {
        return -4;
    }
    if e.allocs != 0 || (e.bits & EFF_ALLOC_EXTERN) != 0 {
        return -2;
    }
    if (e.bits & EFF_IO) != 0 {
        return EFF_IO;
    }
    if (e.bits & EFF_GLOBAL) != 0 {
        return EFF_GLOBAL;
    }
    // (0.26.1: a write through a shared reference, a cell: the bit cannot
    // tell a read from a write)
    if (e.bits & crate::front::effects::EFF_INTERIOR) != 0 { crate::front::effects::EFF_INTERIOR }
    else { 0 }
}

// contract.effect at node n, a call of f (-1: a static read; -3: a call
// through a fn value; -5: the condition as a whole) that has effect `bit` (-2: alloc; -4: unknown
// effects).
fn effect_error(n: i64, check: i64, f: i64, bit: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let what = if bit == -2 { c"allocates" } else if bit == EFF_IO { c"does io" }
            else if bit == -4 { c"has effects that are not known" }
            else if bit == crate::front::effects::EFF_INTERIOR {
                c"writes through a shared reference (a cell)"
            } else { c"touches a static" };
        let word = if pcx.check_kind.data[check] == CHK_REQUIRES { c"requires" }
            else if pcx.check_kind.data[check] == CHK_ENSURES { c"ensures" } else { c"invariant" };
        let owner = pcx.check_owner.data[check];
        err_begin(pcx.nodes[n].start, &pcx);
        err_fmt(format_args("the '{}' of '{}' ", cstr(word), sym_text(pcx.nodes[owner].a, pcx)),
            pcx);
        if f >= 0 {
            err_fmt(format_args("calls '{}', which {}", sym_text(pcx.fns[f].display, pcx),
                cstr(what)),
                pcx);
        } else if f == -3 {
            let callee = pcx.nodes[n].a;
            err_fmt(
                format_args("calls '{}', a fn value that may call a function which {}",
                    SRC[pcx.nodes[callee].start..pcx.nodes[callee].end], cstr(what)), pcx);
        } else if f == -5 {
            err_fmt(format_args("{}", cstr(what)), pcx);
        } else {
            err_fmt(format_args("reads the static '{}'", sym_text(pcx.nodes[n].a, pcx)), pcx);
        }
        err_str(c": a condition may not do io, allocate, touch statics or write through a shared reference", pcx);
        err_help(c"a check that passes must not change what the program does: compute the value in the body, or check it with assert there", pcx);
        if f >= 0 && bit != -4 {
            let effect = if bit == -2 { "alloc" } else if bit == EFF_IO { "io" }
                else if bit == crate::front::effects::EFF_INTERIOR { "interior" } else { "global" };
            let t = buf_new();
            buf_fmt(t,
                format_args("query effects {} --why {effect}", sym_text(pcx.fns[f].display, pcx)));
            err_try_tool(buf_slice(t), true, pcx);
        }
        end_with_code(CONTRACT_EFFECT, &pcx);
    }
}
