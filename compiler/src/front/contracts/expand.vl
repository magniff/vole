// Clauses made into ordinary functions before the names are collected
// (0.18 T1, design §5 "Desugaring"), so that generics, laziness, effects
// and both back ends treat them as any other code:
//
// - `requires`: function f gets a companion `f$pre(?site: i64, <f's
//   parameters>)` in f's module (and impl, generics), whose body checks
//   each clause with `std::contract_check(COND, ?site, CHECK)`. A direct
//   call of f calls it first with the call's site (desugar.vl), so a
//   failure blames the caller.
// - `ensures`: f's body moves to `f$body` (the same signature), and f
//   becomes `{ let ?old1 = e1; ...; let result = f$body(<parameters>);
//   std::contract_check(COND, SITE, CHECK); ...; result }`, so every return
//   of the body (`return`, `?`, the tail) is checked; `old(e)` reads the
//   value e had at entry.
//
// The functions made are flagged FN_DERIVED (the tools leave them out).
// `debug` clauses are made only with --debug-contracts.

use crate::base::{
    IntVec, buf_bytes, buf_clear, buf_new, buf_slice, buf_str, intern, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_help, err_str};
use crate::front::ast::{
    FN_DERIVED, FN_INLINE, INT_SITE, NODE_REF, NODE_REF_MUT, NodeKind, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::contracts::{CLAUSE_DEBUG, CLAUSE_ENSURES, CLAUSE_REQUIRES};
use crate::front::contracts::checks::{CHK_ENSURES, CHK_REQUIRES, add_check};
use crate::front::contracts::ctx::ContractsCx;
use crate::front::contracts::diag::{CONTRACT_MESSAGE, CONTRACT_RESULT, end_with_code};
use crate::front::contracts::sites::site_at;
use crate::front::generics::instantiate::{clone_node, node_field_a, node_field_b, node_field_c};
use crate::front::lexer::Tok;

fn words(kcx: inout ContractsCx, pcx: inout Ctx<Comp>) {
    if kcx.sym_std != 0 {
        return;
    }
    kcx.sym_std = intern_c(c"std", &pcx);
    kcx.expand_sym_check = intern_c(c"contract_check", &pcx);
    kcx.sym_result = intern_c(c"result", &pcx);
    kcx.sym_old = intern_c(c"old", &pcx);
    kcx.sym_site = intern_c(c"?site", &pcx);
    kcx.sym_i64 = intern_c(c"i64", &pcx);
    kcx.sym_self_type = intern_c(c"Self", &pcx);
    kcx.name_buf = buf_new();
}

// Whether clause k is made in this build (a `debug` one only with
// --debug-contracts).
pub fn clause_on(k: i64, pcx: Ctx<Comp>) -> bool {
    unsafe { (pcx.clause_kind.data[k] & CLAUSE_DEBUG) == 0 || pcx.debug_contracts }
}

// (0.18, with 0.17's values) Whether function f (an instance's template
// too) is a `$pre` companion: its parameters are the call's arguments,
// read in place, never moved or dropped (front/own: walk::eval_call,
// drops::param_drops).
pub fn is_pre_fn(f: i64, pcx: Ctx<Comp>) -> bool {
    if f < 0 || !pcx.any_requires {
        return false;
    }
    let t = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
    let name = sym_text(pcx.fns[t].name, pcx);
    name.len >= 4 && name[name.len as i64 - 4..] == "$pre"
}

// (0.18, with 0.17's values) The call a requires check wraps when block n
// is one (desugar::requires_call: `{ let ?aI = ..; f$pre(..); f(..) }`),
// else 0: the own pass sees through it to the call.
pub fn requires_tail(n: i64, pcx: Ctx<Comp>) -> i64 {
    if n <= 0 || !pcx.any_requires || pcx.nodes[n].kind != NodeKind::Block
        || pcx.nodes[n].count == 0 {
        return 0;
    }
    let tail = pcx.nodes[n].a;
    let last = child(n, pcx.nodes[n].count - 1, pcx);
    if tail <= 0 || pcx.nodes[tail].kind != NodeKind::Call
        || pcx.nodes[last].kind != NodeKind::ExprStmt
        || pcx.nodes[pcx.nodes[last].a].kind != NodeKind::Call
        || !is_pre_fn(pcx.nodes[pcx.nodes[last].a].x - 1, pcx) {
        return 0;
    }
    tail
}

// `name` + `suffix`, a symbol.
fn suffixed(name: i64, suffix: *u8, kcx: ContractsCx, pcx: inout Ctx<Comp>) -> i64 {
    buf_clear(kcx.name_buf);
    buf_bytes(kcx.name_buf, sym_text(name, pcx));
    buf_str(kcx.name_buf, suffix);
    intern(buf_slice(kcx.name_buf), &pcx)
}

fn ident(sym: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Ident, pos, pos, &pcx);
    pcx.nodes[n].a = sym;
    n
}

fn int_lit(value: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Int, pos, pos, &pcx);
    pcx.nodes[n].a = value;
    n
}

fn expr_stmt(e: i64, pcx: inout Ctx<Comp>) -> i64 {
    let s = new_node(NodeKind::ExprStmt, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[s].a = e;
    pcx.nodes[s].b = 1;
    s
}

fn let_stmt(sym: i64, init: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let bind = new_node(NodeKind::PatBind, pos, pos, &pcx);
    pcx.nodes[bind].a = sym;
    let s = new_node(NodeKind::Let, pos, pos, &pcx);
    pcx.nodes[s].a = bind;
    pcx.nodes[s].c = init;
    s
}

// `std::contract_check(cond, site, check)`, with the holes of an f-string
// `message` (at most three) after them.
fn check_call(cond: i64, site: i64, check: i64, message: i64, kcx: ContractsCx,
    pcx: inout Ctx<Comp>) -> i64 {
    let pos = pcx.nodes[cond].start;
    let path = new_node(NodeKind::Path, pos, pos, &pcx);
    pcx.nodes[path].a = kcx.sym_std;
    pcx.nodes[path].b = kcx.expand_sym_check;
    let call = new_node(NodeKind::Call, pcx.nodes[cond].start, pcx.nodes[cond].end, &pcx);
    pcx.nodes[call].a = path;
    let mark = list_begin(pcx);
    list_push(cond, &pcx);
    list_push(site, &pcx);
    list_push(int_lit(check, pos, &pcx), &pcx);
    if message != 0 && pcx.nodes[message].kind == NodeKind::Interp {
        var holes = 0;
        for i in 0..pcx.nodes[message].count {
            let piece = child(message, i, pcx);
            if pcx.nodes[piece].kind == NodeKind::InterpHole && holes < 3 {
                let h = clone_node(pcx.nodes[piece].a, &pcx);
                pcx.message_holes.push(h);
                list_push(h, &pcx);
                holes += 1;
            } else if pcx.nodes[piece].kind == NodeKind::InterpHole {
                // (0.25.4: a fourth was left out of the message)
                err_begin(pcx.nodes[piece].start, &pcx);
                err_str(c"a contract message's format string has at most three holes", pcx);
                err_help(c"a failed check prints at most three values: show the others as operands of the condition, or split the clause in two", pcx);
                end_with_code(CONTRACT_MESSAGE, &pcx);
                break;
            }
        }
    }
    list_end(call, mark, &pcx);
    call
}

// (0.25.4) Whether node n is a hole of a contract's f-string message.
pub fn is_message_hole(n: i64, pcx: Ctx<Comp>) -> bool {
    for i in 0..pcx.message_holes.count {
        // UNSAFE: an IntVec's data is a raw pointer (base::IntVec).
        // SAFETY: i < count, the elements written.
        if unsafe { pcx.message_holes.data[i] } == n {
            return true;
        }
    }
    false
}

// (0.25.4) Hole n of a contract's f-string message has type `actual`, not
// an integer: contract.message, with what shows such a value instead.
pub fn message_hole_error(n: i64, actual: i64, pcx: inout Ctx<Comp>) -> ! {
    let start = pcx.nodes[n].start;
    err_begin(start, &pcx);
    err_str(c"a contract message's hole is an integer, and this is '", pcx);
    crate::front::types::err_type(actual, pcx);
    err_str(c"'", pcx);
    err_help(c"a failed check prints its message with no allocator, its holes as integers (three at most); a float or text shows as an operand of the condition (`requires x > 0.0` prints x), or in the message's own words", pcx);
    end_with_code(CONTRACT_MESSAGE, &pcx);
    crate::base::diag::err_jump(&pcx)
}

// (0.27.2.1, C7.6) The ident nodes named `from` in the tree at n (not inside
// closures) renamed `to`: a trait's clause read with an impl's parameter
// names.
fn rename_idents(n: i64, from: i64, to: i64, pcx: inout Ctx<Comp>) {
    if n <= 0 {
        return;
    }
    let kind = pcx.nodes[n].kind;
    if kind == NodeKind::Ident {
        if pcx.nodes[n].a == from {
            pcx.nodes[n].a = to;
        }
        return;
    }
    if kind == NodeKind::Closure || kind == NodeKind::Fn {
        return;
    }
    for k in 0..3 {
        let e = subtree(n, k, pcx);
        if e > 0 {
            rename_idents(e, from, to, &pcx);
        }
    }
    for i in 0..pcx.nodes[n].count {
        rename_idents(child(n, i, pcx), from, to, &pcx);
    }
}

// (0.27.2.1, C7.6) The clauses of a trait's method declarations copied into
// each method of an impl of that trait in the program, before the
// method's own (req_eff = req(Tr::m) ++ req(I::m), C7.1, C7.2): each a
// clone with the trait's parameter names renamed to the impl's by
// position. The trait is the program's trait of the impl's name (its
// path's last segment). RULE: C7.6
fn copy_trait_clauses(pcx: inout Ctx<Comp>) {
    // UNSAFE: the clause tables' words (IntVecs), by index.
    // SAFETY: c < count, their length when the copy began; pushes only grow them.
    unsafe {
        let program = pcx.program;
        let count = pcx.clause_owner.count;
        // (the traits with a clause on a method, first: most programs have
        // none, and the impls are looked up among these few)
        var traits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for j in 0..pcx.nodes[program].count {
            let t = child(program, j, pcx);
            if pcx.nodes[t].kind != NodeKind::Trait {
                continue;
            }
            var owns = false;
            for c in 0..count {
                let o = pcx.clause_owner.data[c];
                if o > 0 && pcx.nodes[o].start >= pcx.nodes[t].start
                    && pcx.nodes[o].end <= pcx.nodes[t].end {
                    owns = true;
                }
            }
            if owns {
                traits.push(t);
            }
        }
        if traits.count == 0 {
            return;
        }
        for i in 0..pcx.nodes[program].count {
            let im = child(program, i, pcx);
            if pcx.nodes[im].kind != NodeKind::Impl || pcx.nodes[im].a <= 0 {
                continue;
            }
            let name = pcx.nodes[pcx.nodes[im].a].a;
            var tr = 0;
            for j in 0..traits.count {
                if pcx.nodes[traits.data[j]].a == name {
                    tr = traits.data[j];
                }
            }
            if tr == 0 {
                continue;
            }
            for k in 0..pcx.nodes[im].count {
                let f = child(im, k, pcx);
                if pcx.nodes[f].kind != NodeKind::Fn || pcx.nodes[f].c == 0 {
                    continue;
                }
                var decl = 0;
                for j in 0..pcx.nodes[tr].count {
                    let d = child(tr, j, pcx);
                    if pcx.nodes[d].kind == NodeKind::Fn && pcx.nodes[d].a == pcx.nodes[f].a {
                        decl = d;
                    }
                }
                var any = false;
                for c in 0..count {
                    if decl != 0 && pcx.clause_owner.data[c] == decl {
                        any = true;
                    }
                }
                if !any {
                    continue;
                }
                for c in 0..count {
                    if pcx.clause_owner.data[c] != decl {
                        continue;
                    }
                    let cond = clone_node(pcx.clause_cond.data[c], &pcx);
                    let params = if pcx.nodes[decl].count < pcx.nodes[f].count {
                        pcx.nodes[decl].count
                    } else {
                        pcx.nodes[f].count
                    };
                    for p in 0..params {
                        let from = pcx.nodes[child(decl, p, pcx)].a;
                        let to = pcx.nodes[child(f, p, pcx)].a;
                        if from != to {
                            rename_idents(cond, from, to, &pcx);
                        }
                    }
                    pcx.clause_owner.push(f);
                    pcx.clause_kind.push(pcx.clause_kind.data[c]);
                    pcx.clause_cond.push(cond);
                    pcx.clause_message.push(pcx.clause_message.data[c]);
                    pcx.clause_pos.push(pcx.clause_pos.data[c]);
                }
                // (then the impl's own, after the trait's)
                for c in 0..count {
                    if pcx.clause_owner.data[c] != f {
                        continue;
                    }
                    pcx.clause_owner.data[c] = -1;
                    pcx.clause_owner.push(f);
                    pcx.clause_kind.push(pcx.clause_kind.data[c]);
                    pcx.clause_cond.push(pcx.clause_cond.data[c]);
                    pcx.clause_message.push(pcx.clause_message.data[c]);
                    pcx.clause_pos.push(pcx.clause_pos.data[c]);
                }
            }
            copy_default_clauses(im, tr, count, &pcx);
        }
    }
}

// RULE: C7.4, C7.6 (0.27.3) Each default of trait tr with a clause that
// impl im (of the same file) does not define is written into it, as the
// impl's own method with the default's clauses, before the names are
// collected: a call of the default is then a call of an impl's method,
// its requires checked at the call and its ensures in the wrapper (C7.4:
// a default body is an impl for C7.1-C7.3). count: the clauses before
// the copies. Not for a generic trait (its arguments are substituted at
// collection, F12.1), nor a default with type parameters of its own in a
// generic impl (F12.2's renaming), nor an impl in another file (the
// default's names are the trait's module's): those keep 0.27.2.1's
// unchecked default, as an MVS impl does.
fn copy_default_clauses(im: i64, tr: i64, count: i64, pcx: inout Ctx<Comp>) {
    // UNSAFE: the clause tables' words (IntVecs), by index.
    // SAFETY: c < count, their length when the copy began; pushes only grow them.
    unsafe {
        // (the rust edition's: an MVS program compiles as before)
        if pcx.nodes[tr].g != 0 || pcx.edition == 0
            || !crate::front::rust::rust_at(pcx.nodes[im].start, &pcx)
            || crate::front::modules::file_of_pos(pcx.nodes[im].start, pcx)
            != crate::front::modules::file_of_pos(pcx.nodes[tr].start, pcx) {
            return;
        }
        let program = pcx.program;
        for j in 0..pcx.nodes[tr].count {
            let d = child(tr, j, pcx);
            if pcx.nodes[d].kind != NodeKind::Fn || pcx.nodes[d].c == 0
                || pcx.nodes[d].g != 0 && pcx.nodes[im].g != 0 {
                continue;
            }
            var defined = false;
            for k in 0..pcx.nodes[im].count {
                let f = child(im, k, pcx);
                if pcx.nodes[f].kind == NodeKind::Fn && pcx.nodes[f].a == pcx.nodes[d].a {
                    defined = true;
                }
            }
            var any = false;
            for c in 0..count {
                if pcx.clause_owner.data[c] == d {
                    any = true;
                }
            }
            if defined || !any {
                continue;
            }
            let f = clone_node(d, &pcx);
            let self_type = pcx.nodes[im].b;
            pcx.nodes[f].d = if pcx.nodes[self_type].kind == NodeKind::TyName {
                pcx.nodes[self_type].a
            } else {
                pcx.underscore
            };
            pcx.nodes[f].h = self_type;
            let outer = pcx.nodes[im].g;
            if outer != 0 {
                let n = new_node(NodeKind::Generics, pcx.nodes[outer].start, pcx.nodes[outer].end,
                    &pcx);
                let mark = list_begin(pcx);
                for i in 0..pcx.nodes[outer].count {
                    list_push(child(outer, i, pcx), &pcx);
                }
                list_end(n, mark, &pcx);
                pcx.nodes[n].a = pcx.nodes[outer].count;
                pcx.nodes[f].g = n;
            }
            // (public, as a trait's methods are: parser::items' ITEM_PUBLIC)
            pcx.nodes[f].p |= 1;
            for c in 0..count {
                if pcx.clause_owner.data[c] != d {
                    continue;
                }
                pcx.clause_owner.push(f);
                pcx.clause_kind.push(pcx.clause_kind.data[c]);
                let cond = clone_node(pcx.clause_cond.data[c], &pcx);
                pcx.clause_cond.push(cond);
                pcx.clause_message.push(pcx.clause_message.data[c]);
                pcx.clause_pos.push(pcx.clause_pos.data[c]);
            }
            for owner in [im, program] {
                let mark = list_begin(pcx);
                for i in 0..pcx.nodes[owner].count {
                    list_push(child(owner, i, pcx), &pcx);
                }
                list_push(f, &pcx);
                list_end(owner, mark, &pcx);
            }
        }
    }
}

// The clauses expanded, before the names are collected (check_program).
pub fn expand_contracts(kcx: inout ContractsCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.clause_owner.count == 0 {
            return;
        }
        words(&kcx, &pcx);
        copy_trait_clauses(&pcx);
        // (the conditions' purity is checked on the inferred effects)
        pcx.effects_wanted = true;
        let program = pcx.program;
        let made = list_begin(pcx);
        for i in 0..pcx.nodes[program].count {
            let f = child(program, i, pcx);
            if pcx.nodes[f].kind != NodeKind::Fn || pcx.nodes[f].c == 0 {
                continue;
            }
            var requires = 0;
            var ensures = 0;
            for k in 0..pcx.clause_owner.count {
                if pcx.clause_owner.data[k] == f && clause_on(k, pcx) {
                    let kind = pcx.clause_kind.data[k] & ~CLAUSE_DEBUG;
                    if kind == CLAUSE_REQUIRES {
                        requires += 1;
                    } else if kind == CLAUSE_ENSURES {
                        ensures += 1;
                    }
                }
            }
            if requires > 0 {
                no_result(f, kcx, &pcx);
                let pre = make_pre(f, kcx, &pcx);
                list_push(pre, &pcx);
                pcx.pre_of.put(f + 1, pre);
                pcx.any_requires = true;
            }
            if ensures > 0 {
                let body = make_body(f, kcx, &pcx);
                if body != 0 {
                    list_push(body, &pcx);
                }
            }
        }
        let count = pcx.scratch.count - made;
        if count == 0 {
            pcx.scratch.count = made;
            return;
        }
        // The program's items, then the functions made.
        let extra = crate::base::alloc_array::<i64>(count);
        for j in 0..count {
            extra[j] = pcx.scratch.data[made + j];
        }
        pcx.scratch.count = made;
        let all = list_begin(pcx);
        for i in 0..pcx.nodes[program].count {
            list_push(child(program, i, pcx), &pcx);
        }
        for j in 0..count {
            list_push(extra[j], &pcx);
        }
        list_end(program, all, &pcx);
    }
}

// `result` in a requires: contract.result.
fn no_result(f: i64, kcx: ContractsCx, pcx: inout Ctx<Comp>) {
    unsafe {
        for k in 0..pcx.clause_owner.count {
            if pcx.clause_owner.data[k] == f
                && (pcx.clause_kind.data[k] & ~CLAUSE_DEBUG) == CLAUSE_REQUIRES {
                let r = find_ident(pcx.clause_cond.data[k], kcx.sym_result, pcx);
                if r != 0 {
                    err_begin(pcx.nodes[r].start, &pcx);
                    err_str(c"'result' is the returned value, which a 'requires' does not see",
                        pcx);
                    err_help(c"a requires holds when the function is entered: state it on the parameters, or move it to an 'ensures'", pcx);
                    end_with_code(CONTRACT_RESULT, &pcx);
                }
            }
        }
    }
}

// An Ident node named `sym` in the tree at n (not inside closures), or 0.
fn find_ident(n: i64, sym: i64, pcx: Ctx<Comp>) -> i64 {
    if n == 0 {
        return 0;
    }
    let kind = pcx.nodes[n].kind;
    if kind == NodeKind::Ident {
        return if pcx.nodes[n].a == sym { n } else { 0 };
    }
    if kind == NodeKind::Closure || kind == NodeKind::Fn {
        return 0;
    }
    for k in 0..3 {
        let e = subtree(n, k, pcx);
        if e > 0 {
            let r = find_ident(e, sym, pcx);
            if r != 0 {
                return r;
            }
        }
    }
    for i in 0..pcx.nodes[n].count {
        let r = find_ident(child(n, i, pcx), sym, pcx);
        if r != 0 {
            return r;
        }
    }
    0
}

// The children of node n that are subtrees (a, b, c by the node's kind,
// as clone_node copies them): k from 0 to 2; -1 for none.
pub fn subtree(n: i64, k: i64, pcx: Ctx<Comp>) -> i64 {
    let kind = pcx.nodes[n].kind;
    if k == 0 {
        return if node_field_a(kind) { pcx.nodes[n].a } else { -1 };
    }
    if k == 1 {
        return if node_field_b(kind) { pcx.nodes[n].b } else { -1 };
    }
    if node_field_c(kind) { pcx.nodes[n].c } else { -1 }
}

// A copy of f's signature as a new function named `name` (the same
// generics, impl, flags and module; no effect declarations), with
// `first` (a Param node, or 0) before f's parameters and `extra` (or 0)
// after them.
fn signature_copy(f: i64, name: i64, first: i64, extra: i64, pcx: inout Ctx<Comp>) -> i64 {
    let g = new_node(NodeKind::Fn, pcx.nodes[f].start, pcx.nodes[f].end, &pcx);
    pcx.nodes[g] = pcx.nodes[f];
    pcx.nodes[g].a = name;
    pcx.nodes[g].b = clone_node(pcx.nodes[f].b, &pcx);
    pcx.nodes[g].c = 0;
    pcx.nodes[g].g = clone_node(pcx.nodes[f].g, &pcx);
    pcx.nodes[g].z = 0;
    pcx.nodes[g].x = 0;
    pcx.nodes[g].y = 0;
    pcx.nodes[g].ty = 0;
    pcx.nodes[g].p = pcx.nodes[f].p | FN_DERIVED;
    let mark = list_begin(pcx);
    if first != 0 {
        list_push(first, &pcx);
    }
    for i in 0..pcx.nodes[f].count {
        let p = clone_node(child(f, i, pcx), &pcx);
        // (a default is the call's: the arguments come normalized)
        pcx.nodes[p].h = 0;
        list_push(p, &pcx);
    }
    if extra != 0 {
        list_push(extra, &pcx);
    }
    list_end(g, mark, &pcx);
    g
}

// f's `$pre` companion: `fn f$pre(?site: i64, <params>) { checks }`.
fn make_pre(f: i64, kcx: ContractsCx, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let pos = pcx.nodes[f].start;
        let site = new_node(NodeKind::Param, pos, pos, &pcx);
        pcx.nodes[site].a = kcx.sym_site;
        let ty = new_node(NodeKind::TyName, pos, pos, &pcx);
        pcx.nodes[ty].a = kcx.sym_i64;
        pcx.nodes[site].b = ty;
        let pre = signature_copy(f, suffixed(pcx.nodes[f].a, c"$pre", kcx, &pcx), site, 0, &pcx);
        pcx.nodes[pre].b = 0;
        pcx.nodes[pre].p |= FN_INLINE;
        // RULE: C3 (0.27.1) a rust-edition clause reads its parameters
        // shared: a `&mut T` (`&mut [T]`, `&mut self`) is `&T` in f$pre, so
        // a write through it is refused by the types (C3.1)
        if crate::front::rust::rust_at(pcx.nodes[f].start, &pcx) {
            for i in 1..pcx.nodes[pre].count {
                let t = pcx.nodes[child(pre, i, pcx)].b;
                if t > 0
                    && (pcx.nodes[t].kind == NodeKind::TyPtr && (pcx.nodes[t].p & NODE_REF) != 0
                        || pcx.nodes[t].kind == NodeKind::TySlice) {
                    pcx.nodes[t].p &= ~NODE_REF_MUT;
                }
            }
        }
        let body = new_node(NodeKind::Block, pos, pos, &pcx);
        let mark = list_begin(pcx);
        for k in 0..pcx.clause_owner.count {
            if pcx.clause_owner.data[k] == f && clause_on(k, pcx)
                && (pcx.clause_kind.data[k] & ~CLAUSE_DEBUG) == CLAUSE_REQUIRES
                && find_ident(pcx.clause_cond.data[k], kcx.sym_result, pcx) == 0 {
                let check = add_check(CHK_REQUIRES, pcx.clause_cond.data[k],
                    pcx.clause_message.data[k], f, pcx.clause_pos.data[k], &pcx);
                let cond = clone_node(pcx.clause_cond.data[k], &pcx);
                list_push(expr_stmt(check_call(cond,
                    ident(kcx.sym_site, pcx.nodes[cond].start, &pcx), check,
                    pcx.clause_message.data[k], kcx, &pcx), &pcx), &pcx);
            }
        }
        list_end(body, mark, &pcx);
        pcx.nodes[pre].c = body;
        pre
    }
}

// f's ensures: its body moved to `f$body`, which it calls and checks the
// result of. Returns the new function (0: none made).
fn make_body(f: i64, kcx: ContractsCx, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let ret = pcx.nodes[f].b;
        let unit = ret == 0 || pcx.nodes[ret].kind == NodeKind::TyUnit;
        if ret != 0 && pcx.nodes[ret].kind == NodeKind::TyNever {
            return 0;
        }
        let pos = pcx.nodes[f].start;
        let inner = signature_copy(f, suffixed(pcx.nodes[f].a, c"$body", kcx, &pcx), 0, 0, &pcx);
        pcx.nodes[inner].c = pcx.nodes[f].c;
        // The call of the body: f$body(<params>), Self::f$body(..) in an impl,
        // with f's own type parameters written.
        let call = new_node(NodeKind::Call, pos, pos, &pcx);
        var own = 0;
        let g = pcx.nodes[f].g;
        if g != 0 && pcx.nodes[g].count > pcx.nodes[g].a {
            own = new_node(NodeKind::Generics, pos, pos, &pcx);
            let gm = list_begin(pcx);
            for i in pcx.nodes[g].a..pcx.nodes[g].count {
                let t = new_node(NodeKind::TyName, pos, pos, &pcx);
                pcx.nodes[t].a = pcx.nodes[child(g, i, pcx)].a;
                list_push(t, &pcx);
            }
            list_end(own, gm, &pcx);
        }
        if pcx.nodes[f].h != 0 {
            let path = new_node(NodeKind::Path, pos, pos, &pcx);
            pcx.nodes[path].a = kcx.sym_self_type;
            pcx.nodes[path].b = pcx.nodes[inner].a;
            pcx.nodes[path].h = own;
            pcx.nodes[call].a = path;
        } else {
            let callee = ident(pcx.nodes[inner].a, pos, &pcx);
            pcx.nodes[callee].g = own;
            pcx.nodes[call].a = callee;
        }
        let am = list_begin(pcx);
        for i in 0..pcx.nodes[f].count {
            list_push(ident(pcx.nodes[child(f, i, pcx)].a, pos, &pcx), &pcx);
        }
        list_end(call, am, &pcx);
        let block = new_node(NodeKind::Block, pcx.nodes[pcx.nodes[f].c].start,
            pcx.nodes[pcx.nodes[f].c].end, &pcx);
        let mark = list_begin(pcx);
        var olds = 0;
        // (the checks first, apart: their `old(e)` become lets before the call)
        let check_mark = list_begin(pcx);
        for k in 0..pcx.clause_owner.count {
            if pcx.clause_owner.data[k] == f && clause_on(k, pcx)
                && (pcx.clause_kind.data[k] & ~CLAUSE_DEBUG) == CLAUSE_ENSURES {
                if unit {
                    let r = find_ident(pcx.clause_cond.data[k], kcx.sym_result, pcx);
                    if r != 0 {
                        err_begin(pcx.nodes[r].start, &pcx);
                        err_str(c"'result' in an 'ensures' of a function that returns nothing",
                            pcx);
                        err_help(
                            c"state the promise on what the function changes, or return a value",
                            pcx);
                        end_with_code(CONTRACT_RESULT, &pcx);
                        continue;
                    }
                }
                let check = add_check(CHK_ENSURES, pcx.clause_cond.data[k],
                    pcx.clause_message.data[k], f, pcx.clause_pos.data[k], &pcx);
                let cond = clone_node(pcx.clause_cond.data[k], &pcx);
                let site = int_lit(site_at(pcx.clause_pos.data[k], &pcx), pcx.nodes[cond].start,
                    &pcx);
                pcx.nodes[site].p |= INT_SITE;
                list_push(expr_stmt(check_call(cond, site, check, pcx.clause_message.data[k], kcx,
                    &pcx), &pcx), &pcx);
            }
        }
        let check_count = pcx.scratch.count - check_mark;
        let stmts = crate::base::alloc_array::<i64>(check_count + 1);
        for j in 0..check_count {
            stmts[j] = pcx.scratch.data[check_mark + j];
        }
        pcx.scratch.count = check_mark;
        // old(e): `let ?oldN = e;` at entry.
        for j in 0..check_count {
            olds = replace_olds(stmts[j], olds, kcx, &pcx);
        }
        if unit {
            list_push(expr_stmt(call, &pcx), &pcx);
        } else {
            list_push(let_stmt(kcx.sym_result, call, pos, &pcx), &pcx);
        }
        replace_shared(f, &pcx);
        for j in 0..check_count {
            list_push(stmts[j], &pcx);
        }
        list_end(block, mark, &pcx);
        if !unit {
            pcx.nodes[block].a = ident(kcx.sym_result, pos, &pcx);
        }
        pcx.nodes[f].c = block;
        inner
    }
}

// RULE: C3 (0.27.1) The wrapper's ensures read a rust-edition `&mut T`
// parameter through a shared view: `let p = &*p;` after the body's call
// (pushed to the list being built), shadowing the parameter, so the
// conditions and their messages read it by its name (their old(e) are
// lets before the call).
fn replace_shared(f: i64, pcx: inout Ctx<Comp>) {
    if !crate::front::rust::rust_at(pcx.nodes[f].start, &pcx) {
        return;
    }
    let pos = pcx.nodes[f].start;
    for i in 0..pcx.nodes[f].count {
        let p = child(f, i, pcx);
        let t = pcx.nodes[p].b;
        if t > 0 && pcx.nodes[t].kind == NodeKind::TySlice && (pcx.nodes[t].p & NODE_REF_MUT) != 0 {
            // (a `&mut [T]`: `let p: &[T] = p;`)
            let view = clone_node(t, &pcx);
            pcx.nodes[view].p &= ~NODE_REF_MUT;
            let s = let_stmt(pcx.nodes[p].a, ident(pcx.nodes[p].a, pos, &pcx), pos, &pcx);
            pcx.nodes[s].b = view;
            list_push(s, &pcx);
            continue;
        }
        if t <= 0 || pcx.nodes[t].kind != NodeKind::TyPtr || (pcx.nodes[t].p & NODE_REF_MUT) == 0 {
            continue;
        }
        let deref = new_node(NodeKind::Unary, pos, pos, &pcx);
        pcx.nodes[deref].op = Tok::Star;
        pcx.nodes[deref].b = ident(pcx.nodes[p].a, pos, &pcx);
        let amp = new_node(NodeKind::Unary, pos, pos, &pcx);
        pcx.nodes[amp].op = Tok::Amp;
        pcx.nodes[amp].b = deref;
        list_push(let_stmt(pcx.nodes[p].a, amp, pos, &pcx), &pcx);
    }
}

// The `old(e)` calls in the tree at n replaced by `?oldN`, each with its
// `let ?oldN = e;` pushed to the list being built; returns the count.
fn replace_olds(n: i64, count: i64, kcx: ContractsCx, pcx: inout Ctx<Comp>) -> i64 {
    if n == 0 {
        return count;
    }
    let kind = pcx.nodes[n].kind;
    if kind == NodeKind::Closure || kind == NodeKind::Fn {
        return count;
    }
    var c = count;
    if kind == NodeKind::Call && pcx.nodes[n].count == 1 {
        let callee = pcx.nodes[n].a;
        if pcx.nodes[callee].kind == NodeKind::Ident && pcx.nodes[callee].a == kcx.sym_old {
            let e = child(n, 0, pcx);
            c = replace_olds(e, c, kcx, &pcx);
            buf_clear(kcx.name_buf);
            buf_str(kcx.name_buf, c"?old");
            crate::base::buf_int(kcx.name_buf, c);
            let sym = intern(buf_slice(kcx.name_buf), &pcx);
            list_push(let_stmt(sym, e, pcx.nodes[n].start, &pcx), &pcx);
            let start = pcx.nodes[n].start;
            let end = pcx.nodes[n].end;
            pcx.nodes[n] = pcx.nodes[callee];
            pcx.nodes[n].kind = NodeKind::Ident;
            pcx.nodes[n].a = sym;
            pcx.nodes[n].start = start;
            pcx.nodes[n].end = end;
            pcx.nodes[n].count = 0;
            pcx.nodes[n].list = 0;
            return c + 1;
        }
    }
    for k in 0..3 {
        let e = subtree(n, k, pcx);
        if e > 0 {
            c = replace_olds(e, c, kcx, &pcx);
        }
    }
    for i in 0..pcx.nodes[n].count {
        c = replace_olds(child(n, i, pcx), c, kcx, &pcx);
    }
    c
}
