// The contract checks (0.18 T1, design §2.4): what each
// `std::contract_check(COND, SITE, CHECK)` the compiler makes reports when
// COND is false, and the message both back ends give the run-time helper.
//
// A check is a clause (requires, ensures) or an assertion; its condition is
// checked one conjunct of its `&&` chain at a time, each conjunct with its
// own message: `requires failed: 'i < self.len()' of 'Stack::get'
// (stack.vl:4:14): i = 5, self.len() = 3`. The values are the integer
// operands of a comparison (or the arguments of a call) that are not
// literals, at most three, printed by the helper's dprintf; the helper
// prints the site's `FILE:LINE:COL: ` first.

use crate::base::{
    IntVec, SRC, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str, free,
    out_path, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::contracts::sites::{file_of_pos, line_col};
use crate::front::lexer::{Tok, str_at};
use crate::front::types::{is_float, is_integer, is_signed};

pub const CHK_REQUIRES: i64 = 1;
pub const CHK_ENSURES: i64 = 2;
pub const CHK_INVARIANT: i64 = 3;
pub const CHK_ASSERT: i64 = 4;

pub fn add_check(kind: i64, cond: i64, message: i64, owner: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    pcx.check_kind.push(kind);
    pcx.check_cond.push(cond);
    pcx.check_message.push(message);
    pcx.check_owner.push(owner);
    pcx.check_pos.push(pos);
    pcx.check_text.push(-1);
    pcx.check_kind.count - 1
}

// The conjuncts of condition `cond` (its `&&` chain, left to right),
// pushed to `out`.
pub fn conjuncts(cond: i64, out: inout IntVec, pcx: Ctx<Comp>) {
    var c = cond;
    while pcx.nodes[c].kind == NodeKind::Block && pcx.nodes[c].count == 0 && pcx.nodes[c].a != 0 {
        c = pcx.nodes[c].a;
    }
    if pcx.nodes[c].kind == NodeKind::Binary && pcx.nodes[c].op == Tok::AmpAmp {
        conjuncts(pcx.nodes[c].b, &out, pcx);
        conjuncts(pcx.nodes[c].c, &out, pcx);
        return;
    }
    out.push(c);
}

fn is_literal(n: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[n].kind;
    if k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Bool
        || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Unit {
        return true;
    }
    k == NodeKind::Unary && pcx.nodes[n].op == Tok::Minus && is_literal(pcx.nodes[n].b, pcx)
}

// Whether the value of n can be shown (an integer; `float`: a float, shown
// through its companion, below), and is evaluated again without harm on
// the failing path (it is pure, as a condition is; its tree is a simple
// read: names, fields, calls of names and fields).
fn shown(n: i64, float: bool, pcx: Ctx<Comp>) -> bool {
    let t = pcx.nodes[n].ty;
    if t <= 0 || is_literal(n, pcx) || !(if float { is_float(t) } else { is_integer(t) }) {
        return false;
    }
    simple(n, 0, pcx)
}

fn simple(n: i64, depth: i64, pcx: Ctx<Comp>) -> bool {
    if depth > 4 {
        return false;
    }
    match pcx.nodes[n].kind {
        NodeKind::Ident | NodeKind::Int | NodeKind::Float | NodeKind::Bool | NodeKind::Char
            | NodeKind::Path => true,
        NodeKind::FieldAccess => simple(pcx.nodes[n].a, depth + 1, pcx),
        NodeKind::TupleField => simple(pcx.nodes[n].a, depth + 1, pcx),
        NodeKind::Unary => simple(pcx.nodes[n].b, depth + 1, pcx),
        NodeKind::Cast => simple(pcx.nodes[n].a, depth + 1, pcx),
        NodeKind::Call => {
            if pcx.nodes[n].x <= 0 {
                return false;
            }
            for i in 0..pcx.nodes[n].count {
                if !simple(child(n, i, pcx), depth + 1, pcx) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn is_comparison(op: Tok) -> bool {
    op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::LtEq || op == Tok::Gt
        || op == Tok::GtEq
}

// The operands of conjunct `conj` whose values the report shows (at most
// three), pushed to `out`: an integer itself, a float its companion
// (FLOAT_OPS); with `floats`, the float operands instead (to make their
// companions).
pub fn operands(conj: i64, out: inout IntVec, floats: bool, pcx: Ctx<Comp>) {
    unsafe {
        var c = conj;
        if pcx.nodes[c].kind == NodeKind::Unary && pcx.nodes[c].op == Tok::Bang {
            c = pcx.nodes[c].b;
        }
        var cands = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if pcx.nodes[c].kind == NodeKind::Binary && is_comparison(pcx.nodes[c].op) {
            cands.push(pcx.nodes[c].b);
            cands.push(pcx.nodes[c].c);
        } else if pcx.nodes[c].kind == NodeKind::Call {
            for i in 0..pcx.nodes[c].count {
                cands.push(child(c, i, pcx));
            }
        }
        for i in 0..cands.count {
            let x = cands.data[i];
            if out.count >= 3 {
                break;
            }
            if floats {
                if shown(x, true, pcx) {
                    out.push(x);
                }
            } else if shown(x, false, pcx) {
                out.push(x);
            } else {
                for j in 0..pcx.float_ops.count {
                    if pcx.float_ops.data[j] == x {
                        out.push(pcx.float_comps.data[j]);
                        break;
                    }
                }
            }
        }
        free(cands.data as *u8);
    }
}

// The values the report of conjunct `conj` of contract check `call` shows,
// pushed to `out`: the holes of an f-string message (the call's arguments
// after the third), or the conjunct's operands.
pub fn check_values(call: i64, conj: i64, out: inout IntVec, pcx: Ctx<Comp>) {
    unsafe {
        let check = pcx.nodes[child(call, 2, pcx)].a;
        let message = pcx.check_message.data[check];
        if message != 0 && pcx.nodes[message].kind == NodeKind::Interp {
            for i in 3..pcx.nodes[call].count {
                out.push(child(call, i, pcx));
            }
            return;
        }
        operands(conj, &out, false, pcx);
    }
}

// The source text of node n, on one line (runs of whitespace one space),
// '%' doubled for the helper's format, cut at `room` bytes.
fn put_text(out: i64, n: i64, room: i64, pcx: Ctx<Comp>) {
    let start = pcx.nodes[n].start;
    let end = pcx.nodes[n].end;
    var space = false;
    var put = 0;
    for i in start..end {
        let c = SRC[i];
        if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
            space = true;
            continue;
        }
        if space && put > 0 {
            buf_byte(out, ' ');
        }
        space = false;
        if put >= room {
            buf_str(out, c"...");
            return;
        }
        if c == '%' {
            buf_byte(out, '%');
        }
        buf_byte(out, c);
        put += 1;
    }
}

fn put_escaped(out: i64, s: [u8]) {
    for i in 0..s.len {
        if s[i] == '%' {
            buf_byte(out, '%');
        }
        buf_byte(out, s[i]);
    }
}

// `FILE:LINE:COL` of position pos.
pub fn put_position(out: i64, pos: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let file = file_of_pos(pos, pcx);
        var col = 0;
        let line = line_col(file, pos, &col, &pcx);
        let path = out_path(file, pcx);
        var k = 0;
        while path[k] != 0 {
            if path[k] == '%' {
                buf_byte(out, '%');
            }
            buf_byte(out, path[k]);
            k += 1;
        }
        buf_byte(out, ':');
        buf_int(out, line);
        buf_byte(out, ':');
        buf_int(out, col);
    }
}

// The name of function f in reports: its display, without the `$pre`
// of a requires' companion.
fn put_owner(out: i64, f: i64, pcx: Ctx<Comp>) {
    unsafe {
        let text = sym_text(pcx.fns[f].display, pcx);
        var n = text.len as i64;
        for i in 0..n {
            if text[i] == '$' {
                n = i;
                break;
            }
        }
        put_escaped(out, text[0..n]);
    }
}

// The message (a string id: the helper's format) of conjunct `conj` of
// check `check`, made in function `f` (a FNS index), with `ops` the
// operands shown (as `operands` gave them).
pub fn check_message(check: i64, conj: i64, ops: IntVec, f: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.checks_msg < 0 {
            pcx.checks_msg = buf_new();
        }
        let out = pcx.checks_msg;
        buf_clear(out);
        let kind = pcx.check_kind.data[check];
        let message = pcx.check_message.data[check];
        let interp = message != 0 && pcx.nodes[message].kind == NodeKind::Interp;
        if message != 0 && pcx.nodes[message].kind == NodeKind::Str {
            put_escaped(out, str_at(pcx.nodes[message].a));
        } else if interp {
            // (an f-string: its holes are the values, as the call passes them)
            var holes = 0;
            for i in 0..pcx.nodes[message].count {
                let piece = child(message, i, pcx);
                if pcx.nodes[piece].kind == NodeKind::Str {
                    put_escaped(out, str_at(pcx.nodes[piece].a));
                } else if holes < 3 {
                    buf_str(out, c"%lld");
                    holes += 1;
                }
            }
            buf_byte(out, '\n');
            return keep_message(out, &pcx);
        } else {
            buf_str(out, if kind == CHK_REQUIRES { c"requires failed: '" }
                else if kind == CHK_ENSURES { c"ensures failed: '" }
                else if kind == CHK_INVARIANT { c"invariant failed: '" }
                else { c"assertion failed: '" });
            if pcx.check_text.data[check] >= 0 {
                put_escaped(out, buf_slice(pcx.check_text.data[check]));
            } else {
                put_text(out, conj, 120, pcx);
            }
            buf_byte(out, '\'');
            if kind == CHK_REQUIRES || kind == CHK_ENSURES {
                buf_str(out, c" of '");
                put_owner(out, f, pcx);
                buf_byte(out, '\'');
                if kind == CHK_REQUIRES && !pcx.no_positions {
                    buf_str(out, c" (");
                    put_position(out, pcx.check_pos.data[check], &pcx);
                    buf_byte(out, ')');
                }
            }
        }
        for i in 0..ops.count {
            buf_str(out, if i == 0 { c": " } else { c", " });
            let op = ops.data[i];
            put_text(out, op, 40, pcx);
            buf_str(out, if is_signed(pcx.nodes[op].ty) { c" = %lld" } else { c" = %llu" });
            // (0.25.2.1: a float's companion, in millionths)
            for j in 0..pcx.float_comps.count {
                if pcx.float_comps.data[j] == op {
                    buf_str(out, c"e-6");
                    break;
                }
            }
        }
        buf_byte(out, '\n');
        keep_message(out, &pcx)
    }
}

// Message `out` kept (or the same one found): its number.
fn keep_message(out: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let text = buf_slice(out);
        for i in 0..pcx.messages.count {
            if buf_slice(pcx.messages.data[i]) == text {
                return i;
            }
        }
        let b = buf_new();
        buf_bytes(b, text);
        pcx.messages.push(b);
        pcx.messages.count - 1
    }
}

// The text of message `m` (check_message's number).
pub fn message_text(m: i64, pcx: Ctx<Comp>) -> [u8] {
    unsafe { buf_slice(pcx.messages.data[m]) }
}

// (0.18) The number of a fixed message (its text ends in a newline), for a
// check that is not a clause: `p as NonNull<T>` of a null p
// (front/check/distinct.vl).
pub fn fixed_message(text: [u8], pcx: inout Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_bytes(out, text);
    keep_message(out, &pcx)
}
