// The contract checks (0.18 T1, design §2.4): what each
// `std::contract_check(COND, SITE, CHECK)` the compiler makes reports when
// COND is false, and the message both back ends give the run-time helper.
//
// A check is a clause (requires, ensures) or an assertion; its condition is
// checked one conjunct of its `&&` chain at a time, each conjunct with its
// own message: `requires failed: 'i < self.len()' of 'Stack::get'
// (stack.vl:4:14): i = 5, self.len() = 3`. The values are the integer
// operands of a comparison (or the arguments of a call) that are not
// literals, at most three, printed by the helper's dprintf; the helper
// prints the site's `FILE:LINE:COL: ` first.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_clear, buf_copy, buf_done, buf_eq, buf_int, buf_new, buf_str,
    free, get_src, out_path, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::contracts::sites::{file_of_pos, line_col};
use crate::front::lexer::{Tok, str_at};
use crate::front::types::{is_float, is_integer, is_signed};

pub const CHK_REQUIRES: i64 = 1;
pub const CHK_ENSURES: i64 = 2;
pub const CHK_INVARIANT: i64 = 3;
pub const CHK_ASSERT: i64 = 4;

pub fn add_check(kind: i64, cond: i64, message: i64, owner: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.check_kind.push(kind);
    pcx.check_cond.push(cond);
    pcx.check_message.push(message);
    pcx.check_owner.push(owner);
    pcx.check_pos.push(pos);
    pcx.check_text.push(-1);
    pcx.check_kind.len() as i64 - 1
}

// The conjuncts of condition `cond` (its `&&` chain, left to right),
// pushed to `out`.
pub fn conjuncts(cond: i64, out: &mut IntVec, pcx: &Ctx<Comp>) {
    let mut c = cond;
    while pcx.nodes[c as usize].kind == NodeKind::Block && pcx.nodes[c as usize].count == 0
        && pcx.nodes[c as usize].a != 0 {
        c = pcx.nodes[c as usize].a;
    }
    if pcx.nodes[c as usize].kind == NodeKind::Binary && pcx.nodes[c as usize].op == Tok::AmpAmp {
        conjuncts(pcx.nodes[c as usize].b, out, pcx);
        conjuncts(pcx.nodes[c as usize].c, out, pcx);
        return;
    }
    out.push(c);
}

fn is_literal(n: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Bool
        || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Unit {
        return true;
    }
    k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Minus
        && is_literal(pcx.nodes[n as usize].b, pcx)
}

// Whether the value of n can be shown (an integer; `float`: a float, shown
// through its companion, below), and is evaluated again without harm on
// the failing path (it is pure, as a condition is; its tree is a simple
// read: names, fields, calls of names and fields).
fn shown(n: i64, float: bool, pcx: &Ctx<Comp>) -> bool {
    let t = pcx.nodes[n as usize].ty;
    if t <= 0 || is_literal(n, pcx) || !(if float { is_float(t) } else { is_integer(t) }) {
        return false;
    }
    simple(n, 0, pcx)
}

fn simple(n: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if depth > 4 {
        return false;
    }
    match pcx.nodes[n as usize].kind {
        NodeKind::Ident | NodeKind::Int | NodeKind::Float | NodeKind::Bool | NodeKind::Char
            | NodeKind::Path => true,
        NodeKind::FieldAccess => simple(pcx.nodes[n as usize].a, depth + 1, pcx),
        NodeKind::TupleField => simple(pcx.nodes[n as usize].a, depth + 1, pcx),
        NodeKind::Unary => simple(pcx.nodes[n as usize].b, depth + 1, pcx),
        NodeKind::Cast => simple(pcx.nodes[n as usize].a, depth + 1, pcx),
        NodeKind::Call => {
            if pcx.nodes[n as usize].x <= 0 {
                return false;
            }
            // (0.28.0) an argument the callee takes by value, of a type
            // held in memory, is moved by the call: read again, it is
            // used after its move (`(h.f)(a) == 4`)
            let f = pcx.nodes[n as usize].x - 1;
            if pcx.fns[f as usize].variadic {
                return false;
            }
            for i in 0..pcx.nodes[n as usize].count {
                let pt = crate::front::types::fn_param(f, i, pcx);
                if pt > 0 && crate::front::types::is_compound(pt, pcx)
                    && !crate::front::types::is_slice(pt, pcx) {
                    return false;
                }
                if !simple(child(n, i, pcx), depth + 1, pcx) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn is_comparison(op: Tok) -> bool {
    op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::LtEq || op == Tok::Gt
        || op == Tok::GtEq
}

// The operands of conjunct `conj` whose values the report shows (at most
// three), pushed to `out`: an integer itself, a float its companion
// (FLOAT_OPS); with `floats`, the float operands instead (to make their
// companions).
pub fn operands(conj: i64, out: &mut IntVec, floats: bool, pcx: &Ctx<Comp>) {
    unsafe {
        let mut c = conj;
        if pcx.nodes[c as usize].kind == NodeKind::Unary && pcx.nodes[c as usize].op == Tok::Bang {
            c = pcx.nodes[c as usize].b;
        }
        let mut cands = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if pcx.nodes[c as usize].kind == NodeKind::Binary
            && is_comparison(pcx.nodes[c as usize].op) {
            cands.push(pcx.nodes[c as usize].b);
            cands.push(pcx.nodes[c as usize].c);
        } else if pcx.nodes[c as usize].kind == NodeKind::Call {
            for i in 0..pcx.nodes[c as usize].count {
                cands.push(child(c, i, pcx));
            }
        }
        for i in 0..cands.len() as i64 {
            let x = (cands[i as usize]);
            if out.len() as i64 >= 3 {
                break;
            }
            if floats {
                if shown(x, true, pcx) {
                    out.push(x);
                }
            } else if shown(x, false, pcx) {
                out.push(x);
            } else {
                for j in 0..pcx.float_ops.len() as i64 {
                    if (pcx.float_ops[j as usize]) == x {
                        out.push((pcx.float_comps[j as usize]));
                        break;
                    }
                }
            }
        }
        free(cands.data as *mut u8);
    }
}

// The values the report of conjunct `conj` of contract check `call` shows,
// pushed to `out`: the holes of an f-string message (the call's arguments
// after the third), or the conjunct's operands.
pub fn check_values(call: i64, conj: i64, out: &mut IntVec, pcx: &Ctx<Comp>) {
    let check = pcx.nodes[child(call, 2, pcx) as usize].a;
    let message = (pcx.check_message[check as usize]);
    if message != 0 && pcx.nodes[message as usize].kind == NodeKind::Interp {
        for i in 3..pcx.nodes[call as usize].count {
            out.push(child(call, i, pcx));
        }
        return;
    }
    operands(conj, out, false, pcx);
}

// The source text of node n, on one line (runs of whitespace one space),
// '%' doubled for the helper's format, cut at `room` bytes.
fn put_text(out: i64, n: i64, room: i64, pcx: &Ctx<Comp>) {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let mut space = false;
    let mut put: i64 = 0;
    for i in start..end {
        let c = get_src()[i as usize];
        if c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' {
            space = true;
            continue;
        }
        if space && put > 0 {
            buf_byte(out, b' ');
        }
        space = false;
        if put >= room {
            buf_str(out, c"...");
            return;
        }
        if c == b'%' {
            buf_byte(out, b'%');
        }
        buf_byte(out, c);
        put += 1;
    }
}

fn put_escaped(out: i64, s: &[u8]) {
    for i in 0..s.len() {
        if s[i] == b'%' {
            buf_byte(out, b'%');
        }
        buf_byte(out, s[i]);
    }
}

// `FILE:LINE:COL` of position pos.
pub fn put_position(out: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let file = file_of_pos(pos, pcx);
        let mut col: i64 = 0;
        let line = line_col(file, pos, &mut col, pcx);
        let path = out_path(file, pcx);
        let mut k: i64 = 0;
        while (*path.add(k as usize)) != 0 {
            if (*path.add(k as usize)) == b'%' {
                buf_byte(out, b'%');
            }
            buf_byte(out, (*path.add(k as usize)));
            k += 1;
        }
        buf_byte(out, b':');
        buf_int(out, line);
        buf_byte(out, b':');
        buf_int(out, col);
    }
}

// The name of function f in reports: its display, without the `$pre`
// of a requires' companion.
fn put_owner(out: i64, f: i64, pcx: &Ctx<Comp>) {
    let text = sym_text(pcx.fns[f as usize].display, pcx);
    let mut n = text.len() as i64;
    for i in 0..n {
        if text[i as usize] == b'$' {
            n = i;
            break;
        }
    }
    put_escaped(out, &text[0..n as usize]);
}

// The message (a string id: the helper's format) of conjunct `conj` of
// check `check`, made in function `f` (a FNS index), with `ops` the
// operands shown (as `operands` gave them).
pub fn check_message(check: i64, conj: i64, ops: IntVec, f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.checks_msg < 0 {
        pcx.checks_msg = buf_new();
    }
    let out = pcx.checks_msg;
    buf_clear(out);
    let kind = (pcx.check_kind[check as usize]);
    let message = (pcx.check_message[check as usize]);
    let interp = message != 0 && pcx.nodes[message as usize].kind == NodeKind::Interp;
    if message != 0 && pcx.nodes[message as usize].kind == NodeKind::Str {
        put_escaped(out, str_at(pcx.nodes[message as usize].a));
    } else if interp {
        // (an f-string: its holes are the values, as the call passes them)
        let mut holes: i64 = 0;
        for i in 0..pcx.nodes[message as usize].count {
            let piece = child(message, i, pcx);
            if pcx.nodes[piece as usize].kind == NodeKind::Str {
                put_escaped(out, str_at(pcx.nodes[piece as usize].a));
            } else if holes < 3 {
                buf_str(out, c"%lld");
                holes += 1;
            }
        }
        buf_byte(out, b'\n');
        return keep_message(out, pcx);
    } else {
        buf_str(out, if kind == CHK_REQUIRES { c"requires failed: '" }
            else if kind == CHK_ENSURES { c"ensures failed: '" }
            else if kind == CHK_INVARIANT { c"invariant failed: '" }
            else { c"assertion failed: '" });
        if (pcx.check_text[check as usize]) >= 0 {
            put_escaped(out, &buf_copy((pcx.check_text[check as usize])));
        } else {
            put_text(out, conj, 120, pcx);
        }
        buf_byte(out, b'\'');
        if kind == CHK_REQUIRES || kind == CHK_ENSURES {
            buf_str(out, c" of '");
            put_owner(out, f, pcx);
            buf_byte(out, b'\'');
            if kind == CHK_REQUIRES && !pcx.no_positions {
                buf_str(out, c" (");
                put_position(out, (pcx.check_pos[check as usize]), pcx);
                buf_byte(out, b')');
            }
        }
    }
    for i in 0..ops.len() as i64 {
        buf_str(out, if i == 0 { c": " } else { c", " });
        let op = (ops[i as usize]);
        put_text(out, op, 40, pcx);
        buf_str(out,
            if is_signed(pcx.nodes[op as usize].ty) { c" = %lld" } else { c" = %llu" });
        // (0.25.2.1: a float's companion, in millionths)
        for j in 0..pcx.float_comps.len() as i64 {
            if (pcx.float_comps[j as usize]) == op {
                buf_str(out, c"e-6");
                break;
            }
        }
    }
    buf_byte(out, b'\n');
    keep_message(out, pcx)
}

// Message `out` kept (or the same one found): its number.
fn keep_message(out: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let text = buf_copy(out);
    for i in 0..pcx.messages.len() as i64 {
        if buf_eq((pcx.messages[i as usize]), &text) {
            return i;
        }
    }
    let b = buf_new();
    buf_bytes(b, &text);
    pcx.messages.push(b);
    pcx.messages.len() as i64 - 1
}

// The text of message `m` (check_message's number).
pub fn message_text(m: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    // (a message's buffer is written once, where it is made)
    buf_done((pcx.messages[m as usize]))
}

// (0.18) The number of a fixed message (its text ends in a newline), for a
// check that is not a clause: `p as NonNull<T>` of a null p
// (front/check/distinct.vl).
pub fn fixed_message(text: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_bytes(out, text);
    keep_message(out, pcx)
}
