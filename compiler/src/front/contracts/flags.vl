// The compiler's options of 0.18 (design §2.1, §2.8, §4.3), set from the
// command line (cli/build.vl).

// `--debug-contracts`: `debug` clauses and `debug_assert` checked (T1;
// test builds turn it on).
pub static var DEBUG_CONTRACTS: bool = false;

// `--no-positions` (T5): every run-time check's site is 0 (no
// `FILE:LINE:COL: ` before its message, no clause position in it).
pub static var NO_POSITIONS: bool = false;
