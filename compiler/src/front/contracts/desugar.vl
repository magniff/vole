// The clauses as checked AST (0.18 T1, design §5 "Desugaring"): a direct
// call's requires checked at the call, and the assertions made checks.
// Both back ends then lower each `std::contract_check(COND, SITE, CHECK)`
// as a branch to the run-time failure (front/contracts/checks.vl).
//
// desugar_call runs on every Call the checker has just checked (from
// synth_expr and check_expr):
// - a call of f that has a requires, `f(a, b)`, becomes the block
//   `{ let ?a0 = a; let ?a1 = b; f$pre(SITE, ?a0, ?a1); f(?a0, ?a1) }`:
//   the arguments evaluated once, in order, then checked (blaming the
//   call's position, SITE), then the call (expand.vl makes `f$pre`);
// - `assert(c)`, `assert(c, "m")`, `assert_eq(a, b)`, `assert_ne(a, b)`,
//   `debug_assert(c)` (std's, not a program's own) become
//   `std::contract_check(c, SITE, CHECK)` (`a == b`, `a != b`);
//   `debug_assert` nothing outside test builds.
// The node is rewritten in place (its parent keeps it); its parts are
// checked already.

use crate::base::{
    IntVec, buf_bytes, buf_clear, buf_new, buf_slice, buf_str, free, intern, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    CONV_NEW, INT_SITE, NODE_CHECKED, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::check::{Res, pop_scope, push_scope};
use crate::front::check::synth_mode::synth_expr;
use crate::front::contracts::checks::{CHK_ASSERT, add_check, conjuncts};
use crate::front::contracts::expand::subtree;
use crate::front::contracts::sites::site_of;
use crate::front::generics::instantiate::fn_instance;
use crate::front::lexer::{Tok, add_string};
use crate::front::modules::within_std;
use crate::front::patterns::check_pattern;
use crate::front::types::{TY_F64, TY_I64, TY_UNIT, fn_param, is_compound, is_void};

fn words(pcx: &mut Ctx<Comp>) {
    if pcx.desugar_words {
        return;
    }
    // (0.28.0) std2 has them in std::panic, and its panic is MVS's panic_str
    let std2 = crate::front::known::on_std2(pcx);
    pcx.sym_assert = intern_c(if std2 { c"std.panic.assert" } else { c"std.assert" }, pcx);
    pcx.sym_assert_eq = intern_c(if std2 { c"std.panic.assert_eq" } else { c"std.assert_eq" }, pcx);
    pcx.sym_assert_ne = intern_c(if std2 { c"std.panic.assert_ne" } else { c"std.assert_ne" }, pcx);
    pcx.sym_debug_assert = intern_c(if std2 { c"std.panic.debug_assert" }
        else { c"std.debug_assert" }, pcx);
    pcx.sym_check = intern_c(c"std.contract_check", pcx);
    pcx.sym_panic = intern_c(if std2 { c"std.panic.panic" } else { c"std.panic_str" }, pcx);
    pcx.sym_unreachable = intern_c(if std2 { c"std.panic.unreachable" }
        else { c"std.unreachable" }, pcx);
    pcx.text = buf_new();
    pcx.desugar_words = true;
}

// std::contract_check's FNS index (-1 when std is not loaded).
pub fn check_fn(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.check_fn >= 0 {
        return pcx.check_fn;
    }
    words(pcx);
    for f in 0..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].name == pcx.sym_check
            && within_std(pcx.fns[f as usize].module, pcx) {
            pcx.check_fn = f;
            return f;
        }
    }
    -1
}

// The Call n just checked, desugared when it calls a function with a
// requires or an assertion. Returns n.
pub fn desugar_call(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.nodes[n as usize].kind != NodeKind::Call || pcx.nodes[n as usize].x <= 0
        || pcx.cur_fn < 0 {
        return n;
    }
    let f = pcx.nodes[n as usize].x - 1;
    if within_std(pcx.fns[f as usize].module, pcx) {
        let name = pcx.fns[(if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 }
            else { f }) as usize].name;
        words(pcx);
        if name == pcx.sym_check {
            pcx.check_fn = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 }
                else { f };
            pcx.check_calls.push(n);
            return n;
        }
        // (0.28.0) on std2, std's own asserts stay calls: a check's effects
        // (contract_check prints) are not the ones its functions declare
        if crate::front::known::on_std2(pcx)
            && within_std(pcx.fns[pcx.cur_fn as usize].module, pcx)
            && (name == pcx.sym_assert || name == pcx.sym_debug_assert
                || name == pcx.sym_assert_eq || name == pcx.sym_assert_ne) {
            return n;
        }
        if name == pcx.sym_assert || name == pcx.sym_debug_assert {
            assertion(n, name == pcx.sym_debug_assert, pcx);
            return n;
        }
        if name == pcx.sym_assert_eq || name == pcx.sym_assert_ne {
            assert_compare(n, name == pcx.sym_assert_eq, pcx);
            return n;
        }
        if name == pcx.sym_panic && crate::front::known::on_std2(pcx) {
            panic_literal(n, pcx);
            return n;
        }
        if name == pcx.sym_panic || name == pcx.sym_unreachable {
            panic_site(n, pcx);
            return n;
        }
        if crate::front::known::on_std2(pcx) && place_call(n, f, pcx) {
            return n;
        }
    }
    if !pcx.any_requires || pcx.fns[f as usize].variadic {
        return n;
    }
    let tf = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let pre_node = pcx.pre_of.get(pcx.fns[tf as usize].node + 1);
    if pre_node == 0 || pcx.nodes[pre_node as usize].x <= 0 {
        return n;
    }
    let pt = pcx.nodes[pre_node as usize].x - 1;
    let mut pre = pt;
    if pcx.fns[f as usize].tmpl > 0 {
        let mark = pcx.tscratch.len() as i64;
        for i in 0..pcx.fns[f as usize].targ_count {
            pcx.tscratch.push((pcx.tlists[(pcx.fns[f as usize].targs + i) as usize]));
        }
        pre = fn_instance(pt, mark, n, pcx);
    } else {
        crate::front::assoc::ensure_checked(pt, n, pcx);
    }
    pcx.pre_inst.put(f + 1, pre + 1);
    requires_call(n, pre, pcx);
    n
}

// Call n of a function with a requires, whose companion is `pre` (a FNS
// index): `{ let ?aI = argI; ...; pre(SITE, ?a0, ..); f(?a0, ..) }`. An
// argument that is a simple read (a local, a literal, `&place` of one) is
// read again instead of bound: nothing runs between the two calls, and a
// borrow stays a borrow (`&v` passed to `self: *Vec<T>`).
fn requires_call(n: i64, pre: i64, pcx: &mut Ctx<Comp>) {
    words(pcx);
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let count = pcx.nodes[n as usize].count;
    let inner = new_node(NodeKind::Call, start, end, pcx);
    pcx.nodes[inner as usize] = pcx.nodes[n as usize];
    pcx.nodes[inner as usize].p |= NODE_CHECKED;
    // The arguments' lets, checked by hand (their values are).
    push_scope(pcx);
    let lets = list_begin(pcx);
    for i in 0..count {
        let arg = child(n, i, pcx);
        if simple_read(arg, 0, pcx) {
            continue;
        }
        buf_clear(pcx.text);
        buf_str(pcx.text, c"?a");
        crate::base::buf_int(pcx.text, i);
        let sym = intern(buf_slice(pcx.text), pcx);
        let bind = new_node(NodeKind::PatBind, pcx.nodes[arg as usize].start,
            pcx.nodes[arg as usize].end, pcx);
        pcx.nodes[bind as usize].a = sym;
        let s = new_node(NodeKind::Let, pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].end,
            pcx);
        pcx.nodes[s as usize].a = bind;
        pcx.nodes[s as usize].c = arg;
        exclusive_view_arg(n, arg, i, pcx);
        check_pattern(bind, pcx.nodes[arg as usize].ty, pcx);
        list_push(s, pcx);
    }
    // pre(SITE, ?a0, ...), then f(?a0, ...).
    let site = new_node(NodeKind::Int, start, start, pcx);
    pcx.nodes[site as usize].a = site_of(n, 0, pcx);
    pcx.nodes[site as usize].ty = TY_I64;
    pcx.nodes[site as usize].p |= INT_SITE;
    let pc = new_node(NodeKind::Call, start, end, pcx);
    pcx.nodes[pc as usize].x = pre + 1;
    pcx.nodes[pc as usize].ty = TY_UNIT;
    pcx.nodes[pc as usize].p |= NODE_CHECKED;
    let pm = list_begin(pcx);
    list_push(site, pcx);
    for i in 0..count {
        list_push(arg_use(child(n, i, pcx), i, pcx), pcx);
    }
    list_end(pc, pm, pcx);
    let im = list_begin(pcx);
    for i in 0..count {
        list_push(arg_use(child(n, i, pcx), i, pcx), pcx);
    }
    list_end(inner, im, pcx);
    pop_scope(pcx);
    let stmt = new_node(NodeKind::ExprStmt, start, end, pcx);
    pcx.nodes[stmt as usize].a = pc;
    pcx.nodes[stmt as usize].b = 1;
    list_push(stmt, pcx);
    let ty = pcx.nodes[n as usize].ty;
    let p = pcx.nodes[n as usize].p;
    let fresh = new_node(NodeKind::Block, start, end, pcx);
    pcx.nodes[n as usize] = pcx.nodes[fresh as usize];
    pcx.nodes[n as usize].start = start;
    pcx.nodes[n as usize].end = end;
    list_end(n, lets, pcx);
    pcx.nodes[n as usize].a = inner;
    pcx.nodes[n as usize].ty = ty;
    // (0.26.0: its `let`s are temporaries of the statement, places IR)
    pcx.nodes[n as usize].p = p | NODE_CHECKED | crate::front::ast::BLOCK_TRANSPARENT;
}

// RULE: T3 (0.27.3) Argument i of call n, bound to `?aI`, when the callee
// takes it as an exclusive view (`&mut self` of `[T]::copy_from_slice`)
// and it is a place of the shared view's type, the receiver's implicit
// `&mut` (`buf[..n].copy_from_slice(a)`): the binding is the `&mut` of
// it, as `(&mut buf[..n])` is, not a shared copy the call then lends
// mutably.
fn exclusive_view_arg(n: i64, arg: i64, i: i64, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[n as usize].x - 1;
    if f < 0 || i >= pcx.fns[f as usize].param_count {
        return;
    }
    let pt = fn_param(f, i, pcx);
    let at = pcx.nodes[arg as usize].ty;
    if crate::front::types::is_mut_slice(pt, pcx) && at > 0
        && !crate::front::types::is_mut_slice(at, pcx)
        && crate::front::types::mut_view_of(at, pcx) == pt {
        pcx.nodes[arg as usize].ty = pt;
        pcx.nodes[arg as usize].p |= crate::front::ast::NODE_REF_MUT;
    }
}

// (0.18.1) The `$pre` companion whose clauses function f may take as facts
// at its entry (middle::entryfacts), or -1. Every direct call of f runs
// them first, with the same arguments (requires_call); so f must have been
// called directly (PRE_INST), take no compound or unit parameter (they are
// passed to the companion again, as they are), not be entered from C
// (exported, extern, main), and each clause must be cheap to evaluate
// again: locals, constants, operators, fields and std's `len()`. Whether
// f's address is taken (an indirect call does not check) the middle says
// (entryfacts::strip_taken).
pub fn entry_pre(f: i64, pcx: &Ctx<Comp>) -> i64 {
    if !pcx.any_requires || f < 0 {
        return -1;
    }
    let pre = pcx.pre_inst.get(f + 1) - 1;
    if pre < 0 || pcx.fns[f as usize].export || pcx.fns[f as usize].is_extern
        || pcx.fns[f as usize].variadic
        || sym_text(pcx.fns[f as usize].name, pcx) == b"main" {
        return -1;
    }
    for i in 0..pcx.fns[f as usize].param_count {
        let ty = fn_param(f, i, pcx);
        if is_compound(ty, pcx) || is_void(ty) {
            return -1;
        }
    }
    let item = pcx.fns[pre as usize].node;
    let body = pcx.nodes[item as usize].c;
    if body <= 0 || pcx.nodes[body as usize].kind != NodeKind::Block
        || pcx.nodes[body as usize].a > 0 {
        return -1;
    }
    for i in 0..pcx.nodes[body as usize].count {
        let s = child(body, i, pcx);
        if pcx.nodes[s as usize].kind != NodeKind::ExprStmt {
            return -1;
        }
        let call = pcx.nodes[s as usize].a;
        if pcx.nodes[call as usize].kind != NodeKind::Call || pcx.nodes[call as usize].count < 1
            || !cheap(child(call, 0, pcx), 0, pcx) {
            return -1;
        }
    }
    pre
}

// Whether expression n is cheap and safe to evaluate again at a callee's
// entry (see entry_pre).
fn cheap(n: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if n <= 0 || depth > 8 {
        return false;
    }
    match pcx.nodes[n as usize].kind {
        NodeKind::Int | NodeKind::Bool | NodeKind::Char => true,
        NodeKind::Ident => pcx.nodes[n as usize].res == Res::Local
            || pcx.nodes[n as usize].res == Res::Const,
        NodeKind::Binary | NodeKind::Unary | NodeKind::Cast | NodeKind::FieldAccess
            | NodeKind::TupleField => {
            for k in 0..3 {
                let e = subtree(n, k, pcx);
                if e > 0 && !cheap(e, depth + 1, pcx) {
                    return false;
                }
            }
            true
        }
        NodeKind::Call | NodeKind::MethodCall => {
            let f = pcx.nodes[n as usize].x - 1;
            if f < 0 {
                return false;
            }
            let t = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
            let name = sym_text(pcx.fns[t as usize].name, pcx);
            let method = name.len() > 4
                && (&name[(name.len() as i64 - 4) as usize..] == b".len"
                    || &name[(name.len() as i64 - 4) as usize..] == b":len");
            if !within_std(pcx.fns[t as usize].module, pcx) || !(name == b"len" || method) {
                return false;
            }
            if pcx.nodes[n as usize].kind == NodeKind::MethodCall {
                let r = subtree(n, 0, pcx);
                if r > 0 && !cheap(r, depth + 1, pcx) {
                    return false;
                }
            }
            for i in 0..pcx.nodes[n as usize].count {
                if !cheap(child(n, i, pcx), depth + 1, pcx) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

// The argument node n (a `?aI` read of a requires check's block) stands
// for, else n.
pub fn requires_arg(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 || !pcx.any_requires || pcx.nodes[n as usize].kind != NodeKind::Ident {
        return n;
    }
    let a = pcx.arg_of.get(n + 1);
    if a > 0 { a - 1 } else { n }
}

// Argument i of the call as passed to each of the two calls: a copy of a
// simple read, or an Ident of its let (`?aI`), checked: it names the local.
fn arg_use(arg: i64, i: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if simple_read(arg, 0, pcx) {
        return copy_read(arg, pcx);
    }
    buf_clear(pcx.text);
    buf_str(pcx.text, c"?a");
    crate::base::buf_int(pcx.text, i);
    let id = new_node(NodeKind::Ident, pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].end,
        pcx);
    pcx.nodes[id as usize].a = intern(buf_slice(pcx.text), pcx);
    synth_expr(id, pcx);
    pcx.arg_of.put(id + 1, arg + 1);
    id
}

// Whether checked node n is a read that may be repeated: a literal, a
// local or parameter, a constant, `&` or `*` or a field of one.
fn simple_read(n: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if depth > 6 {
        return false;
    }
    match pcx.nodes[n as usize].kind {
        NodeKind::Int | NodeKind::Bool | NodeKind::Char | NodeKind::Float
            | NodeKind::Unit => true,
        NodeKind::Ident => pcx.nodes[n as usize].res == Res::Local
            || pcx.nodes[n as usize].res == Res::Const,
        NodeKind::Unary => (pcx.nodes[n as usize].op == Tok::Amp
            || pcx.nodes[n as usize].op == Tok::Star)
            && simple_read(pcx.nodes[n as usize].b, depth + 1, pcx),
        NodeKind::FieldAccess
            | NodeKind::TupleField => simple_read(pcx.nodes[n as usize].a, depth + 1, pcx),
        _ => false,
    }
}

// A copy of simple read n, with what the checker found.
fn copy_read(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.nodes[n as usize].kind == NodeKind::Ident && pcx.nodes[n as usize].res == Res::Local {
        // (resolved again: a closure records its captured locals' uses;
        // a constant is copied as resolved: its name may be a path
        // resolved already, or one of the callee's module, from a default)
        let id = new_node(NodeKind::Ident, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx);
        pcx.nodes[id as usize].a = pcx.nodes[n as usize].a;
        pcx.nodes[id as usize].g = pcx.nodes[n as usize].g;
        // (0.25: the reference inside an access local's `*r`, as it was:
        // not made `*r` again, which would read r's referent as raw)
        pcx.nodes[id as usize].p |= pcx.nodes[n as usize].p & CONV_NEW;
        synth_expr(id, pcx);
        return id;
    }
    let c = new_node(pcx.nodes[n as usize].kind, pcx.nodes[n as usize].start,
        pcx.nodes[n as usize].end, pcx);
    pcx.nodes[c as usize] = pcx.nodes[n as usize];
    match pcx.nodes[n as usize].kind {
        NodeKind::Unary => {
            let b = copy_read(pcx.nodes[n as usize].b, pcx);
            pcx.nodes[c as usize].b = b;
        }
        NodeKind::FieldAccess | NodeKind::TupleField => {
            let a = copy_read(pcx.nodes[n as usize].a, pcx);
            pcx.nodes[c as usize].a = a;
        }
        _ => {}
    }
    c
}

// Call n made `std::contract_check(cond, SITE, check)` (all checked).
fn make_check(n: i64, cond: i64, check: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let cf = check_fn(pcx);
        if cf < 0 {
            return;
        }
        let start = pcx.nodes[n as usize].start;
        let site = new_node(NodeKind::Int, start, start, pcx);
        pcx.nodes[site as usize].a = site_of(n, 0, pcx);
        pcx.nodes[site as usize].ty = TY_I64;
        pcx.nodes[site as usize].p |= INT_SITE;
        let id = new_node(NodeKind::Int, start, start, pcx);
        pcx.nodes[id as usize].a = check;
        pcx.nodes[id as usize].ty = TY_I64;
        // (0.25.2.1) a float operand's value is shown too: the helper
        // prints integers, so its companion, in millionths,
        // `((x as f64) * (1000000 as f64)) as i64`, made and checked
        // here (checks.vl: FLOAT_OPS); x, checked, under a copy
        let mut conjs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        conjuncts(cond, &mut conjs, pcx);
        let mut fl = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..conjs.len() as i64 {
            fl.clear();
            crate::front::contracts::checks::operands((conjs[k as usize]), &mut fl, true,
                pcx);
            for i in 0..fl.len() as i64 {
                let x = (fl[i as usize]);
                let s = pcx.nodes[x as usize].start;
                let e = pcx.nodes[x as usize].end;
                let inner = new_node(NodeKind::None, s, e, pcx);
                pcx.nodes[inner as usize] = pcx.nodes[x as usize];
                pcx.nodes[inner as usize].p |= NODE_CHECKED;
                let mut wide = inner;
                if pcx.nodes[x as usize].ty != TY_F64 {
                    wide = new_node(NodeKind::Cast, s, e, pcx);
                    pcx.nodes[wide as usize].a = inner;
                    pcx.nodes[wide as usize].b = new_node(NodeKind::TyName, s, e, pcx);
                    { let at_ix = pcx.nodes[wide as usize].b as usize;
                        pcx.nodes[at_ix].a = intern_c(c"f64", pcx) };
                    { let at_ix = pcx.nodes[wide as usize].b as usize;
                        pcx.nodes[at_ix].ty = TY_F64 };
                }
                let mil = new_node(NodeKind::Int, s, e, pcx);
                pcx.nodes[mil as usize].a = 1000000;
                let milf = new_node(NodeKind::Cast, s, e, pcx);
                pcx.nodes[milf as usize].a = mil;
                pcx.nodes[milf as usize].b = new_node(NodeKind::TyName, s, e, pcx);
                { let at_ix = pcx.nodes[milf as usize].b as usize;
                    pcx.nodes[at_ix].a = intern_c(c"f64", pcx) };
                { let at_ix = pcx.nodes[milf as usize].b as usize; pcx.nodes[at_ix].ty = TY_F64 };
                let mul = new_node(NodeKind::Binary, s, e, pcx);
                pcx.nodes[mul as usize].op = Tok::Star;
                pcx.nodes[mul as usize].b = wide;
                pcx.nodes[mul as usize].c = milf;
                let comp = new_node(NodeKind::Cast, s, e, pcx);
                pcx.nodes[comp as usize].a = mul;
                pcx.nodes[comp as usize].b = new_node(NodeKind::TyName, s, e, pcx);
                { let at_ix = pcx.nodes[comp as usize].b as usize;
                    pcx.nodes[at_ix].a = intern_c(c"i64", pcx) };
                { let at_ix = pcx.nodes[comp as usize].b as usize; pcx.nodes[at_ix].ty = TY_I64 };
                crate::front::check::synth_mode::synth_expr(comp, pcx);
                pcx.float_ops.push(x);
                pcx.float_comps.push(comp);
            }
        }
        free(conjs.data as *mut u8);
        free(fl.data as *mut u8);
        let m = list_begin(pcx);
        list_push(cond, pcx);
        list_push(site, pcx);
        list_push(id, pcx);
        list_end(n, m, pcx);
        pcx.nodes[n as usize].x = cf + 1;
        pcx.nodes[n as usize].ty = TY_UNIT;
    }
}

// `assert(c)`, `assert(c, "message")`, `debug_assert(..)`.
fn assertion(n: i64, debug: bool, pcx: &mut Ctx<Comp>) {
    let cond = child(n, 0, pcx);
    let mut message: i64 = 0;
    if pcx.nodes[n as usize].count > 1 {
        let m = child(n, 1, pcx);
        if pcx.nodes[m as usize].kind == NodeKind::Str
            && crate::front::lexer::str_at(pcx.nodes[m as usize].a).len() > 0 {
            message = m;
        }
    }
    if debug && !pcx.debug_contracts {
        // Nothing: a unit value.
        let start = pcx.nodes[n as usize].start;
        let end = pcx.nodes[n as usize].end;
        let ty = pcx.nodes[n as usize].ty;
        let fresh = new_node(NodeKind::Unit, start, end, pcx);
        pcx.nodes[n as usize] = pcx.nodes[fresh as usize];
        pcx.nodes[n as usize].start = start;
        pcx.nodes[n as usize].end = end;
        pcx.nodes[n as usize].ty = ty;
        return;
    }
    let check = add_check(CHK_ASSERT, cond, message, 0, pcx.nodes[n as usize].start, pcx);
    make_check(n, cond, check, pcx);
}

// `assert_eq(a, b)` (eq) or `assert_ne(a, b)`: the check of `a == b` or
// `a != b`, reported with that text.
fn assert_compare(n: i64, eq: bool, pcx: &mut Ctx<Comp>) {
    let a = child(n, 0, pcx);
    let b = child(n, 1, pcx);
    let cmp = new_node(NodeKind::Binary, pcx.nodes[a as usize].start, pcx.nodes[b as usize].end,
        pcx);
    pcx.nodes[cmp as usize].op = if eq { Tok::EqEq } else { Tok::BangEq };
    pcx.nodes[cmp as usize].b = a;
    pcx.nodes[cmp as usize].c = b;
    pcx.nodes[a as usize].p |= NODE_CHECKED;
    pcx.nodes[b as usize].p |= NODE_CHECKED;
    synth_expr(cmp, pcx);
    let check = add_check(CHK_ASSERT, cmp, 0, 0, pcx.nodes[n as usize].start, pcx);
    let text = buf_new();
    buf_bytes(text, source(a, pcx));
    buf_str(text, if eq { c" == " } else { c" != " });
    buf_bytes(text, source(b, pcx));
    (pcx.check_text[check as usize]) = text;
    make_check(n, cmp, check, pcx);
}

// (0.25) `panic(m)` / `unreachable()` in the program: their last argument,
// `at` (its default, ""), becomes the call's `FILE:LINE:COL`, which std
// prints first, as a failed check does.
fn panic_site(n: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].count == 0 || within_std(pcx.fns[pcx.cur_fn as usize].module, pcx)
        || pcx.no_positions {
        return;
    }
    let lit = child(n, pcx.nodes[n as usize].count - 1, pcx);
    if pcx.nodes[lit as usize].kind != NodeKind::Str
        || crate::front::lexer::str_at(pcx.nodes[lit as usize].a).len() != 0 {
        return;
    }
    let b = buf_new();
    crate::front::contracts::checks::put_position(b, pcx.nodes[n as usize].start, pcx);
    pcx.nodes[lit as usize].a = add_string(buf_slice(b));
}

// (0.28.0) `panic("message")` in a program on std2, whose panic has no
// `at`: a literal message (one with holes is written in place, with its
// place: check/interp.vl direct_body_std2) gets the call's
// `FILE:LINE:COL: ` in front.
fn panic_literal(n: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].count == 0 || within_std(pcx.fns[pcx.cur_fn as usize].module, pcx)
        || pcx.no_positions {
        return;
    }
    let lit = child(n, 0, pcx);
    if pcx.nodes[lit as usize].kind != NodeKind::Str {
        return;
    }
    let b = buf_new();
    crate::front::contracts::checks::put_position(b, pcx.nodes[n as usize].start, pcx);
    buf_bytes(b, b": ");
    buf_bytes(b, crate::front::lexer::str_at(pcx.nodes[lit as usize].a));
    pcx.nodes[lit as usize].a = add_string(buf_slice(b));
}

// (0.28.0, std2) A program's `r.unwrap()`, `r.expect(m)`, `r.unwrap_err()`
// or `r.expect_err(m)` (a Result's; an Option's `expect`) calls std's
// `__NAME_at` sibling instead, with the call's `FILE:LINE:COL: ` as one
// more argument: the panic names the caller and shows the error's value,
// as rustc's does. f is the function n calls. Returns whether n changed.
fn place_call(n: i64, f: i64, pcx: &mut Ctx<Comp>) -> bool {
    let tf = pcx.fns[f as usize].tmpl - 1;
    if tf < 0 || pcx.nodes[n as usize].count == 0 || pcx.no_positions
        || within_std(pcx.fns[pcx.cur_fn as usize].module, pcx) {
        return false;
    }
    let name = sym_text(pcx.nodes[pcx.fns[tf as usize].node as usize].a, pcx);
    if name != b"unwrap" && name != b"expect" && name != b"unwrap_err" && name != b"expect_err" {
        return false;
    }
    buf_clear(pcx.text);
    buf_bytes(pcx.text, b"__");
    buf_bytes(pcx.text, name);
    buf_bytes(pcx.text, b"_at");
    let sibling = intern(buf_slice(pcx.text), pcx);
    let st = crate::front::check::calls::method_of(pcx.nodes[child(n, 0, pcx) as usize].ty,
        sibling, pcx);
    if st < 0 || !within_std(pcx.fns[st as usize].module, pcx) {
        return false;
    }
    let mark = pcx.tscratch.len() as i64;
    for i in 0..pcx.fns[f as usize].targ_count {
        pcx.tscratch.push(pcx.tlists.get(pcx.fns[f as usize].targs + i));
    }
    let inst = fn_instance(st, mark, n, pcx);
    let start = pcx.nodes[n as usize].start;
    buf_clear(pcx.text);
    crate::front::contracts::checks::put_position(pcx.text, start, pcx);
    buf_bytes(pcx.text, b": ");
    let at = new_node(NodeKind::Str, start, start, pcx);
    pcx.nodes[at as usize].a = add_string(buf_slice(pcx.text));
    synth_expr(at, pcx);
    let count = pcx.nodes[n as usize].count;
    let m = list_begin(pcx);
    for i in 0..count {
        list_push(child(n, i, pcx), pcx);
    }
    list_push(at, pcx);
    list_end(n, m, pcx);
    pcx.nodes[n as usize].x = inst + 1;
    true
}

fn source(n: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    &crate::base::get_src()[
        pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize]
}
