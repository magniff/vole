// (0.26.4, statics P3) The contracts' expansion state, made by check_program and passed
// down as `kcx` (tools/statics/front-contracts.group): what were its statics,
// the comment above a field naming the static it was.

pub struct ContractsCx {
    // (front::contracts::expand::NAME_BUF)
    pub name_buf: i64,
    // (front::contracts::expand::SYM_CHECK)
    pub expand_sym_check: i64,
    // (front::contracts::expand::SYM_I64)
    pub sym_i64: i64,
    // (front::contracts::expand::SYM_OLD)
    pub sym_old: i64,
    // (front::contracts::expand::SYM_RESULT)
    pub sym_result: i64,
    // (front::contracts::expand::SYM_SELF_TYPE)
    pub sym_self_type: i64,
    // (front::contracts::expand::SYM_SITE)
    pub sym_site: i64,
    // (front::contracts::expand::SYM_STD)
    pub sym_std: i64,
    // Whether a check was given a site (the helper's tables are then written).
    // (front::contracts::sites::SITES_USED)
    pub sites_used: bool,
}

// A new context: every field at its static's first value.
pub fn contracts_cx_new() -> ContractsCx {
    ContractsCx {
        name_buf: -1,
        expand_sym_check: 0,
        sym_i64: 0,
        sym_old: 0,
        sym_result: 0,
        sym_self_type: 0,
        sym_site: 0,
        sym_std: 0,
        sites_used: false,
    }
}

// Owned (a Drop of its own, which does nothing), so that a let
// parameter lends the context instead of copying it.
impl Drop for ContractsCx {
    fn drop(inout self) {}
}
