// Patterns: their type checking (bindings, constants, literals, ranges,
// tuples, variants and or-patterns), refutability, the type of `match`, and
// the exhaustiveness and reachability of its arms by usefulness (Maranget,
// "Warnings for pattern matching", JFP 2007; in usefulness.vl).
//
// Resolutions recorded on pattern nodes:
//   NodeKind::PatBind     x = the local
//   NodeKind::PatLit      x = the value (canonical for the type; a bool is 0 or 1)
//   NodeKind::PatRange    x = the low value, y = the high value
//   NodeKind::PatVariant  x = the variant (VARIANTS)

pub mod usefulness;

use crate::base::{BUFS, SRC, buf_fmt, buf_new, buf_slice, cstr, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_fmt, err_help, err_help_fmt, err_str, err_try_fmt};
use crate::front::ast::{
    ARM_LET_ELSE, ARM_NO_ELSE, NODE_CHECKED, NodeKind, PAT_DEREF, PAT_FIELDS, PAT_PARENS, PAT_REF,
    child, list_begin, list_end, list_push, new_node,
};
use crate::front::ast::NodeKind::{
    Ident, PatBind, PatLit, PatOr, PatRange, PatTuple, PatVariant, PatWild,
};
use crate::front::check::{
    check_recovering, define_local, lookup_local, mismatch_error, name_error, poison_pattern,
    pop_scope, push_scope, type_error, type_error_got,
};
use crate::front::check::check_mode::check_expr;
use crate::front::check::names::{
    help_nearest, near_to, scope_const, unknown_name_error, used_variant_enum,
};
use crate::front::check::resolve::{resolve_key, resolve_named};
use crate::front::check::synth_mode::is_context_value;
use crate::front::check::unsafety::check_wrapped;
use crate::front::check::variant_fields::{has_named_fields, pattern_fields, positional_error};
use crate::front::check::widen::{join_arm, takes_context};
use crate::front::closures::escape::check_scope_exit;
use crate::front::consteval::{check_const_expr, const_eval, const_less, const_value, wrap_int};
use crate::front::distinct::{is_distinct_type, strip_distinct};
use crate::front::generics::{TPL_NONE, env_lookup, instance_of, template_of_key};
use crate::front::lexer::Tok;
use crate::front::modules::lookup::{
    B_ITEM, B_PRIVATE, B_TVARIANT, B_VARIANT, access_error, binding_kind, binding_value,
    lookup_commit, lookup_name, lookup_quiet, note_c_use, note_pattern_pos, path_module,
};
use crate::front::own::drops::arm_drops;
use crate::front::patterns::usefulness::check_arms;
use crate::front::types::{
    ENUMS, REF_MUT, REF_SHARED, TY_BOOL, TY_NEVER, TY_UNIT, TyKind, buf_type, enum_type,
    enum_variant, err_type, find_variant, is_fieldless_enum, is_float, is_integer, is_ref,
    item_node_of, ref_to, type_elem, variant_field,
};
use crate::tools::query::command_line::qnote;

// What other modules use of the parts.

// Whether PatBind p names a value rather than binding one: a constant, or
// a variant in scope (`None`), as check_pat reads it.
fn names_value(p: i64, pcx: inout Ctx<Comp>) -> bool {
    let name = pcx.nodes[p].a;
    if pcx.nodes[p].b != 0 || lookup_local(name, pcx).is_some() {
        return false;
    }
    if scope_const(name, &pcx) != 0 {
        return true;
    }
    let k = binding_kind(lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, &pcx));
    k == B_VARIANT || k == B_TVARIANT
}

// Whether pattern p, matched against a value of reference type ty, matches
// what it points to (Rust's default binding modes): any pattern but a
// binding or `_`, against `&T` or `&mut T` of a T that is no reference.
fn derefs(p: i64, ty: i64, pcx: inout Ctx<Comp>) -> bool {
    if !is_ref(ty, pcx) || is_ref(pcx.types[ty].a, pcx) {
        return false;
    }
    let k = pcx.nodes[p].kind;
    k != PatWild && (k != PatBind || names_value(p, &pcx))
}

// (0.18.1, for the code generators) What pattern p, given a value of type
// ty, matches: the referent of a reference it matches through
// (PAT_DEREF), else 0.
pub fn pattern_referent(p: i64, ty: i64, pcx: Ctx<Comp>) -> i64 {
    if (pcx.nodes[p].p & PAT_DEREF) != 0 && is_ref(ty, pcx) {
        return pcx.types[ty].a;
    }
    0
}

// Whether pattern p is a binding that takes a reference into the matched
// value (PAT_REF): the generators give it the value's address.
pub fn binds_ref(p: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[p].kind == PatBind && (pcx.nodes[p].p & PAT_REF) != 0
}

pub fn check_pattern(p: i64, ty: i64, pcx: inout Ctx<Comp>) {
    pcx.pattern_start = pcx.env.count;
    let saved = pcx.bind_ref;
    pcx.bind_ref = 0;
    check_pat(p, ty, &pcx);
    pcx.bind_ref = saved;
}

fn check_pat(p: i64, ty: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if (pcx.nodes[p].p & crate::front::ast::PAT_AMP) != 0 {
            // (0.27.0: `&p`; against a value, MVS std's copies, p itself)
            pcx.nodes[p].p &= ~crate::front::ast::PAT_AMP;
            let saved = pcx.bind_ref;
            pcx.bind_ref = 0;
            let through = is_ref(ty, pcx);
            check_pat(p, if through { pcx.types[ty].a } else { ty }, &pcx);
            pcx.bind_ref = saved;
            pcx.nodes[p].p |= crate::front::ast::PAT_AMP;
            if through {
                pcx.nodes[p].p |= PAT_DEREF;
            }
            return;
        }
        if derefs(p, ty, &pcx) {
            // (0.18.1) a pattern on a reference matches what it points to;
            // its bindings are references into it, `&mut` only under
            // `&mut` all the way down (lowering: PAT_DEREF, PAT_REF)
            let saved = pcx.bind_ref;
            pcx.bind_ref = if saved == REF_SHARED || pcx.types[ty].b == REF_SHARED { REF_SHARED }
                else { REF_MUT };
            check_pat(p, pcx.types[ty].a, &pcx);
            pcx.bind_ref = saved;
            pcx.nodes[p].p |= PAT_DEREF;
            return;
        }
        // (a pattern checked again, a generic's instance: flags of its own)
        pcx.nodes[p].p &= ~(PAT_DEREF | PAT_REF);
        let kind = pcx.nodes[p].kind;
        // (0.18: a literal pattern of a distinct type matches its
        // underlying type's values)
        if (kind == PatLit || kind == PatRange) && is_distinct_type(ty, pcx) {
            check_pat(p, strip_distinct(ty, pcx), &pcx);
            return;
        }
        pcx.nodes[p].ty = ty;
        if kind == PatWild {
            return;
        }
        if kind == PatBind && pcx.nodes[p].b == 0 && scope_const(pcx.nodes[p].a, &pcx) == 0
            && lookup_local(pcx.nodes[p].a, pcx).is_none()
            && used_variant_enum(pcx.nodes[p].a, ty, p, &pcx) != 0 {
            // A variant brought into scope by `use` (0.4) or the prelude (0.6).
            lookup_commit(pcx.nodes[p].a, pcx.nodes[p].start, &pcx);
            pcx.nodes[p].y = used_variant_enum(pcx.nodes[p].a, ty, p, &pcx);
            pcx.nodes[p].kind = PatVariant;
            pcx.nodes[p].b = pcx.nodes[p].a;
            pcx.nodes[p].c = 0;
            check_pat(p, ty, &pcx);
            return;
        }
        if kind == PatVariant && pcx.nodes[p].d == 1 {
            // `V(p, ...)`: a variant by its own name, from `use`.
            let t = used_variant_enum(pcx.nodes[p].b, ty, p, &pcx);
            if t == 0 && (pcx.nodes[p].p & PAT_FIELDS) != 0 {
                // (0.17) `P { x, y }` of a struct
                name_error(pcx.nodes[p].start, c"'", pcx.nodes[p].b,
                    c"' is not an enum variant: only variants are matched by field name ('E::V { a, .. }'); bind the struct and read its fields ('p => p.x')", &pcx);
            }
            if t == 0 {
                name_error(pcx.nodes[p].start, c"unknown variant '", pcx.nodes[p].b,
                    c"' (write 'Enum::Variant', or bring it into scope with 'use Enum::Variant;')", &pcx);
            }
            lookup_commit(pcx.nodes[p].b, pcx.nodes[p].start, &pcx);
            pcx.nodes[p].y = t;
            pcx.nodes[p].d = 0;
            check_pat(p, ty, &pcx);
            return;
        }
        if kind == PatRange && (pcx.nodes[pcx.nodes[p].a].kind == PatVariant
            || pcx.nodes[pcx.nodes[p].b].kind == PatVariant) {
            if pcx.types[ty].kind != TyKind::Enum {
                // (0.17) `i8::MIN..=-1`, `0..=i64::MAX`: constants' paths
                pcx.nodes[p].a = pattern_path(pcx.nodes[p].a, &pcx);
                pcx.nodes[p].b = pattern_path(pcx.nodes[p].b, &pcx);
                check_pat(p, ty, &pcx);
                return;
            }
            if pcx.nodes[pcx.nodes[p].a].kind != PatVariant
                || pcx.nodes[pcx.nodes[p].b].kind != PatVariant {
                type_error(p, c"a variant range needs two variants of the same enum", &pcx);
            }
            variant_range(p, ty, &pcx);
            return;
        }
        if kind == PatBind && pcx.nodes[p].b == 0 && scope_const(pcx.nodes[p].a, &pcx) != 0
            && lookup_local(pcx.nodes[p].a, pcx).is_none()
            && is_fieldless_enum(const_type(scope_const(pcx.nodes[p].a, &pcx), pcx), pcx) {
            // A constant of a fieldless enum: its variant's pattern.
            note_pattern_pos(pcx.nodes[p].start, &pcx);
            lookup_commit(pcx.nodes[p].a, pcx.nodes[p].start, &pcx);
            let c = scope_const(pcx.nodes[p].a, &pcx) - 1;
            let e = pcx.types[pcx.consts[c].ty].a;
            let value = const_value(c, &pcx);
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                if wrap_int(pcx.variants[v].discr, ENUMS[e].tag) == value {
                    pcx.nodes[p].kind = PatVariant;
                    pcx.nodes[p].y = enum_type(e, &pcx);
                    pcx.nodes[p].b = pcx.variants[v].name;
                    pcx.nodes[p].c = 0;
                }
            }
            check_pat(p, ty, &pcx);
            return;
        }
        if kind == PatBind {
            let name = pcx.nodes[p].a;
            if scope_const(name, &pcx) != 0 && pcx.nodes[p].b == 0
                && lookup_local(name, pcx).is_none() {
                // A constant's name: a literal pattern.
                note_pattern_pos(pcx.nodes[p].start, &pcx);
                let e = new_node(Ident, pcx.nodes[p].start, pcx.nodes[p].end, &pcx);
                pcx.nodes[e].a = name;
                pcx.nodes[p].kind = PatLit;
                pcx.nodes[p].a = e;
                check_pat(p, ty, &pcx);
                return;
            }
            var bty = ty;
            // (0.27.0: `ref x`, `ref mut x`, the rust edition's: c is the mode)
            let mode = if pcx.nodes[p].c != 0 { pcx.nodes[p].c } else { pcx.bind_ref };
            // (a slice is a view already: a copy, as `&[T]` is `[T]`)
            if mode != 0 && !(pcx.types[ty].kind == TyKind::Slice && pcx.types[ty].b == 0) {
                if pcx.nodes[p].b != 0 {
                    err_begin(pcx.nodes[p].start, &pcx);
                    err_fmt(
                        format_args("'var {}' in a pattern through an access: its bindings are accesses into the value", sym_text(name, pcx)), pcx);
                    err_help(c"drop the 'var' (matched through an inout access, 'x = v' changes the field), or match a copy: 'match e.clone()'", pcx);
                    err_end(&pcx);
                }
                bty = ref_to(ty, mode, &pcx);
                pcx.nodes[p].p |= PAT_REF;
                pcx.nodes[p].ty = bty;
            }
            if pcx.or_mode {
                pcx.nodes[p].x = or_rebind(p, name, bty, &pcx);
                return;
            }
            for i in pcx.pattern_start..pcx.env.count {
                if pcx.locals[pcx.env.data[i]].name == name {
                    name_error(pcx.nodes[p].start, c"identifier '", name,
                        c"' is bound more than once in the same pattern", &pcx);
                }
            }
            pcx.nodes[p].x = define_local(name, bty, pcx.nodes[p].b != 0 && bty == ty, false, &pcx);
            // (0.20) a binding into a value matched through an access (`match
            // &x`, `match e` of an access) is an access too, in a 0.20 file:
            // used as the value it designates (conventions.md §5.3)
            if (pcx.nodes[p].p & crate::front::ast::PAT_REF) != 0 && bty > 0 && is_ref(bty, pcx)
                && crate::front::conv::strict_at(pcx.nodes[p].start, &pcx) {
                pcx.locals[pcx.nodes[p].x].access = true;
            }
            return;
        }
        if kind == PatOr {
            check_or_pattern(p, ty, &pcx);
            return;
        }
        if kind == PatVariant && pcx.nodes[p].c == 0 && pcx.nodes[p].d == 0 && pcx.nodes[p].y == 0
            && is_integer(ty) {
            // (0.17) `i64::MAX =>`: a constant's path
            let e = pattern_path(p, &pcx);
            pcx.nodes[p].kind = PatLit;
            pcx.nodes[p].a = e;
            check_pat(p, ty, &pcx);
            return;
        }
        if ty == TY_NEVER {
            for i in 0..pcx.nodes[p].count {
                check_pat(child(p, i, pcx), TY_NEVER, &pcx);
            }
            return;
        }
        match kind {
            PatTuple => {
                let count = pcx.nodes[p].count;
                if ty == TY_UNIT && count == 0 {
                    return;
                }
                if pcx.types[ty].kind != TyKind::Tuple || pcx.types[ty].count != count {
                    err_begin(pcx.nodes[p].start, &pcx);
                    err_fmt(
                        format_args(
                            "a tuple pattern with {count} elements cannot bind a value of type '"), pcx);
                    err_type(ty, pcx);
                    err_str(c"'", pcx);
                    err_end(&pcx);
                }
                for i in 0..count {
                    check_pat(child(p, i, pcx), type_elem(ty, i, pcx), &pcx);
                }
            }
            PatLit => {
                check_literal_type(p, ty, c"a literal pattern", &pcx);
                let e = pcx.nodes[p].a;
                check_const_expr(e, ty, &pcx);
                pcx.nodes[p].x = const_eval(e, &pcx);
            }
            PatRange => {
                check_literal_type(p, ty, c"a range pattern", &pcx);
                if ty == TY_BOOL {
                    type_error(p, c"range patterns need an integer type, not 'bool'", &pcx);
                }
                check_const_expr(pcx.nodes[p].a, ty, &pcx);
                check_const_expr(pcx.nodes[p].b, ty, &pcx);
                pcx.nodes[p].x = const_eval(pcx.nodes[p].a, &pcx);
                pcx.nodes[p].y = const_eval(pcx.nodes[p].b, &pcx);
                if const_less(pcx.nodes[p].y, pcx.nodes[p].x, ty) {
                    type_error(p, c"the range pattern is empty (its start is above its end)", &pcx);
                }
            }
            _ => check_variant_pattern(p, ty, &pcx),
        }
    }
}

// (0.27.0) The type of constant c + 1 (scope_const's answer), read apart
// from the call that finds it (refactor table: a call in an index of a
// table it may grow).
fn const_type(c1: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.consts[c1 - 1].ty
}

// `E::A..=E::C` (0.4): the variants from A to C in declaration order, as
// an or-pattern.
fn variant_range(p: i64, ty: i64, pcx: inout Ctx<Comp>) {
    let lo = pcx.nodes[p].a;
    let hi = pcx.nodes[p].b;
    let t = pattern_enum_type(lo, ty, &pcx);
    if pcx.types[t].kind != TyKind::Enum || pattern_enum_type(hi, ty, &pcx) != t {
        type_error(p, c"a variant range needs two variants of the same enum", &pcx);
    }
    let e = pcx.types[t].a;
    let first = find_variant(e, pcx.nodes[lo].b, pcx);
    let last = find_variant(e, pcx.nodes[hi].b, pcx);
    if first < 0 || last < 0 {
        type_error(p, c"unknown variant in a variant range", &pcx);
    }
    if last < first {
        type_error(p,
            c"the variant range is empty (its first variant is declared after its last)", &pcx);
    }
    let mark = list_begin(pcx);
    for v in first..last + 1 {
        if pcx.variants[v].field_count > 0 {
            name_error(pcx.nodes[p].start, c"variant ranges are for variants without fields; '",
                pcx.variants[v].name, c"' has fields", &pcx);
        }
        let alt = new_node(PatVariant, pcx.nodes[p].start, pcx.nodes[p].end, &pcx);
        pcx.nodes[alt].y = t;
        pcx.nodes[alt].b = pcx.variants[v].name;
        list_push(alt, &pcx);
    }
    list_end(p, mark, &pcx);
    pcx.nodes[p].kind = PatOr;
    check_pat(p, ty, &pcx);
}

// (0.17) A bound of a range pattern parsed as a variant (`i8::MIN` in
// `i8::MIN..=-1`): the path expression it is; any other bound as it is.
fn pattern_path(b: i64, pcx: inout Ctx<Comp>) -> i64 {
    if pcx.nodes[b].kind != PatVariant || pcx.nodes[b].c != 0 {
        return b;
    }
    let n = new_node(NodeKind::Path, pcx.nodes[b].start, pcx.nodes[b].end, &pcx);
    pcx.nodes[n].a = pcx.nodes[b].a;
    pcx.nodes[n].b = pcx.nodes[b].b;
    let prefix = pcx.nodes[b].h;
    if prefix != 0 {
        let mark = list_begin(pcx);
        for i in 0..pcx.nodes[prefix].count {
            list_push(child(prefix, i, pcx), &pcx);
        }
        for k in 0..2 {
            let seg = new_node(Ident, pcx.nodes[b].start, pcx.nodes[b].end, &pcx);
            pcx.nodes[seg].a = if k == 0 { pcx.nodes[b].a } else { pcx.nodes[b].b };
            list_push(seg, &pcx);
        }
        list_end(n, mark, &pcx);
    }
    n
}

fn check_literal_type(p: i64, ty: i64, what: *u8, pcx: inout Ctx<Comp>) {
    if is_float(ty) {
        err_begin(pcx.nodes[p].start, &pcx);
        err_fmt(format_args("{} cannot match a float", cstr(what)), pcx);
        err_help(c"compare with '==' in a guard: 'x if x == 1.5 =>'", pcx);
        err_end(&pcx);
    }
    if !(is_integer(ty) || ty == TY_BOOL) {
        err_begin(pcx.nodes[p].start, &pcx);
        err_fmt(format_args("{} cannot match a value of type '", cstr(what)), pcx);
        err_type(ty, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
}

// The type a variant pattern's enum name stands for: through its module
// path (h); a generic enum written without arguments stands for the
// instance being matched.
fn pattern_enum_type(p: i64, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.nodes[p].y != 0 {
            return pcx.nodes[p].y;
        }
        let name = pcx.nodes[p].a;
        if pcx.nodes[p].h == 0
            && (env_lookup(name, pcx) != 0 || pcx.sym_primitive[name] != 0
                || (name == pcx.self_type_sym && pcx.self_type != 0)) {
            return resolve_named(name, pcx.nodes[p].start, &pcx);
        }
        let m = if pcx.nodes[p].h
            != 0 { path_module(pcx.nodes[p].h, pcx.nodes[pcx.nodes[p].h].count, &pcx) }
            else { pcx.cur_mod };
        let b = lookup_name(m, name, pcx.cur_mod, &pcx);
        if pcx.nodes[p].h == 0 {
            note_c_use(pcx.nodes[p].start, name, b, &pcx);
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, pcx.nodes[p].start, name, &pcx);
        }
        if binding_kind(b) != B_ITEM {
            unknown_name_error(pcx.nodes[p].start, c"unknown type '", name, &pcx);
        }
        let key = binding_value(b);
        qnote(pcx.nodes[p].start, name, item_node_of(key, pcx), 0, &pcx);
        let tpl = template_of_key(key, pcx);
        if tpl != TPL_NONE {
            if instance_of(ty, tpl, pcx) {
                return ty;
            }
            err_begin(pcx.nodes[p].start, &pcx);
            err_str(c"expected '", pcx);
            err_type(ty, pcx);
            err_fmt(format_args("', got a pattern of '{}'", sym_text(name, pcx)), pcx);
            crate::front::check::names::pattern_enum_help(ty, sym_text(name, pcx), pcx);
            err_end(&pcx);
        }
        resolve_key(key, name, pcx.nodes[p].start, &pcx)
    }
}

fn check_variant_pattern(p: i64, ty: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let t = pattern_enum_type(p, ty, &pcx);
        if pcx.types[t].kind != TyKind::Enum {
            err_begin(pcx.nodes[p].start, &pcx);
            err_str(c"'", pcx);
            err_type(t, pcx);
            err_str(c"' is not an enum", pcx);
            err_end(&pcx);
        }
        if t != ty {
            mismatch_error(p, ty, t, &pcx);
        }
        let v = find_variant(pcx.types[t].a, pcx.nodes[p].b, pcx);
        if v < 0 {
            err_begin(pcx.nodes[p].start, &pcx);
            err_fmt(format_args("no variant '{}' in enum '", sym_text(pcx.nodes[p].b, pcx)), pcx);
            err_type(t, pcx);
            err_str(c"'", pcx);
            // (0.25.2.1: the nearest variants, `Left`: 'ArrowLeft')
            pcx.near_all.count = 0;
            pcx.near_collect = true;
            var near = near_to(pcx.nodes[p].b);
            for i in 0..ENUMS[pcx.types[t].a].variant_count {
                near.offer(pcx.variants[enum_variant(pcx.types[t].a, i)].name, &pcx);
            }
            pcx.near_collect = false;
            near.help(&pcx);
            if BUFS[pcx.err_help].len == 0 {
                help_nearest(c"its variants: ", pcx.nodes[p].b, pcx);
            }
            err_end(&pcx);
        }
        // (0.17: struct-like variants)
        if (pcx.nodes[p].p & PAT_FIELDS) != 0 {
            pattern_fields(p, v, t, &pcx);
        } else if (pcx.nodes[p].p & PAT_PARENS) != 0 && has_named_fields(v, pcx) {
            positional_error(p, v, t, true, &pcx);
        }
        let count = pcx.variants[v].field_count;
        if pcx.nodes[p].c == 0 && count > 0 && has_named_fields(v, pcx) {
            err_begin(pcx.nodes[p].start, &pcx);
            err_str(c"variant '", pcx);
            err_type(t, pcx);
            err_fmt(format_args("::{}' has {count}", sym_text(pcx.nodes[p].b, pcx)), pcx);
            err_str(if count == 1 { c" field" } else { c" fields" }, pcx);
            err_help(c"match them by name, or leave them out with '..'", pcx);
            let b = buf_new();
            buf_type(b, t, pcx);
            buf_fmt(b, format_args("::{} {{ .. }}", sym_text(pcx.nodes[p].b, pcx)));
            err_try_fmt(buf_slice(b), pcx);
            err_end(&pcx);
        }
        if pcx.nodes[p].c == 0 && count > 0 {
            err_begin(pcx.nodes[p].start, &pcx);
            err_str(c"variant '", pcx);
            err_type(t, pcx);
            err_fmt(format_args("::{}' has {count}", sym_text(pcx.nodes[p].b, pcx)), pcx);
            err_str(if count == 1 { c" field" } else { c" fields" }, pcx);
            err_help(c"match them: '", pcx);
            buf_type(pcx.err_help, t, pcx);
            err_help_fmt(format_args("::{}(_", sym_text(pcx.nodes[p].b, pcx)), pcx);
            for _ in 1..count {
                err_help(c", _", pcx);
            }
            err_help(c")'", pcx);
            err_end(&pcx);
        }
        if pcx.nodes[p].c != 0 && pcx.nodes[p].count != count {
            err_begin(pcx.nodes[p].start, &pcx);
            err_str(c"variant '", pcx);
            err_type(t, pcx);
            err_fmt(format_args("::{}' has {count}", sym_text(pcx.nodes[p].b, pcx)), pcx);
            err_str(if count == 1 { c" field" } else { c" fields" }, pcx);
            err_fmt(format_args(", the pattern has {}", pcx.nodes[p].count), pcx);
            err_end(&pcx);
        }
        pcx.nodes[p].x = v;
        for i in 0..count {
            check_pat(child(p, i, pcx), variant_field(v, i, pcx), &pcx);
        }
    }
}

fn check_or_pattern(p: i64, ty: i64, pcx: inout Ctx<Comp>) {
    let first = pcx.env.count;
    check_pat(child(p, 0, pcx), ty, &pcx);
    let saved_mode = pcx.or_mode;
    let saved_first = pcx.or_first;
    let saved_end = pcx.or_end;
    if !pcx.or_mode {
        pcx.or_first = first;
        pcx.or_end = pcx.env.count;
    }
    pcx.or_mode = true;
    let bound = binding_count(child(p, 0, pcx), pcx);
    for i in 1..pcx.nodes[p].count {
        let alt = child(p, i, pcx);
        check_pat(alt, ty, &pcx);
        if binding_count(alt, pcx) != bound {
            type_error(alt, c"every alternative of an or-pattern must bind the same variables",
                &pcx);
        }
    }
    for i in 0..pcx.nodes[p].count {
        if binds_ref(child(p, i, pcx), pcx) {
            // (0.18.1: the generators give an alternative a value, not
            // the address a reference binding takes)
            type_error(child(p, i, pcx), c"a binding as an alternative of an or-pattern on a reference: bind the value once, outside the or-pattern", &pcx);
        }
    }
    pcx.or_mode = saved_mode;
    pcx.or_first = saved_first;
    pcx.or_end = saved_end;
}

// The local of the first alternative named `name`, for a later one.
fn or_rebind(p: i64, name: i64, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        for i in pcx.or_first..pcx.or_end {
            let id = pcx.env.data[i];
            if pcx.locals[id].name == name {
                if pcx.locals[id].ty != ty {
                    err_begin(pcx.nodes[p].start, &pcx);
                    err_fmt(format_args("variable '{}' has type '", sym_text(name, pcx)), pcx);
                    err_type(pcx.locals[id].ty, pcx);
                    err_str(c"' in one alternative and '", pcx);
                    err_type(ty, pcx);
                    err_str(c"' in another", pcx);
                    err_end(&pcx);
                }
                return id;
            }
        }
        name_error(pcx.nodes[p].start, c"variable '", name,
            c"' is not bound in every alternative of the or-pattern", &pcx)
    }
}

pub fn binding_count(p: i64, pcx: Ctx<Comp>) -> i64 {
    match pcx.nodes[p].kind {
        PatBind => 1,
        PatOr => binding_count(child(p, 0, pcx), pcx),
        // (0.17) a field of `E::V { a, b: q }` before it is checked
        NodeKind::FieldInit => binding_count(pcx.nodes[p].b, pcx),
        PatTuple | PatVariant => {
            var total = 0;
            for i in 0..pcx.nodes[p].count {
                total += binding_count(child(p, i, pcx), pcx);
            }
            total
        }
        _ => 0,
    }
}

// ---- Refutability ----

pub fn is_irrefutable(p: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        match pcx.nodes[p].kind {
            PatWild | PatBind => true,
            _ if pcx.nodes[p].ty == TY_NEVER => true,
            PatVariant if ENUMS[pcx.variants[pcx.nodes[p].x].enum_id].variant_count != 1 => false,
            PatTuple | PatVariant => {
                for i in 0..pcx.nodes[p].count {
                    if !is_irrefutable(child(p, i, pcx), pcx) {
                        return false;
                    }
                }
                true
            }
            _ => false,
        }
    }
}

fn has_or_pattern(p: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.nodes[p].kind == PatOr {
        return p;
    }
    if pcx.nodes[p].kind == NodeKind::FieldInit {
        return has_or_pattern(pcx.nodes[p].b, pcx);
    }
    if pcx.nodes[p].kind == PatTuple || pcx.nodes[p].kind == PatVariant {
        for i in 0..pcx.nodes[p].count {
            let found = has_or_pattern(child(p, i, pcx), pcx);
            if found != 0 {
                return found;
            }
        }
    }
    0
}

// Patterns of `let` and `for` must match every value.
pub fn check_irrefutable(p: i64, what: *u8, pcx: inout Ctx<Comp>) {
    let or = has_or_pattern(p, pcx);
    if or != 0 {
        err_begin(pcx.nodes[or].start, &pcx);
        err_fmt(format_args("or-patterns are only allowed in match arms, not in '{}'", cstr(what)),
            pcx);
        err_end(&pcx);
    }
    if !is_irrefutable(p, pcx) {
        err_begin(pcx.nodes[p].start, &pcx);
        err_fmt(
            format_args("refutable pattern in '{}': it does not match every value of type '",
                cstr(what)), pcx);
        err_type(pcx.nodes[p].ty, pcx);
        err_str(c"'", pcx);
        if cstr(what) == "let" {
            // (0.18.1) let-else
            err_help(
                c"leave when it does not match: 'let PAT = e else { return ...; };' (or a 'match')", pcx);
            if pcx.nodes[p].end > pcx.nodes[p].start {
                err_try_fmt(
                    format_args("let {} = VALUE else {{ return ...; }};",
                        SRC[pcx.nodes[p].start..pcx.nodes[p].end]), pcx);
            }
        } else {
            err_help(c"use 'match' to handle the other cases", pcx);
            if pcx.nodes[p].end > pcx.nodes[p].start {
                // (0.17) the match to write, its arms ready
                err_try_fmt(
                    format_args("match VALUE {{ {} => ..., _ => ... }}",
                        SRC[pcx.nodes[p].start..pcx.nodes[p].end]), pcx);
            }
        }
        err_end(&pcx);
    }
}

// ---- match ----

// `match`; `expected` (0 for none) is the type of the arms.
pub fn check_match(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    let scrutinee = pcx.nodes[n].a;
    // (0.20, conventions.md §5.3) `match e` of an access matches through
    // it, as 0.19's `match r` of a reference did: its bindings are
    // accesses into the value (default binding modes), not copies
    if pcx.nodes[scrutinee].kind == NodeKind::Ident
        && (pcx.nodes[scrutinee].p & crate::front::ast::CONV_NEW) == 0
        && crate::front::conv::strict_at(pcx.nodes[scrutinee].start, &pcx) {
        match lookup_local(pcx.nodes[scrutinee].a, pcx) {
            Option::Some(l) => {
                if pcx.locals[l].access && is_ref(pcx.locals[l].ty, pcx) {
                    pcx.nodes[scrutinee].p |= crate::front::ast::CONV_NEW;
                }
            }
            Option::None => {}
        }
    }
    var st = check_recovering(scrutinee, 0, &pcx);
    // (0.20, D13 for a match: `match q.conds[i]` of an owned value the
    // function cannot take, an element or a part through an access,
    // matches it through a borrow, as `let x = part` does: its
    // bindings are accesses into it)
    if st > 0 && st != pcx.ty_error
        && crate::front::conv::strict_at(pcx.nodes[scrutinee].start, &pcx)
        && !crate::front::conv::copyable(st, &pcx)
        && crate::front::conv::borrowed_place(scrutinee, pcx) {
        let inner = new_node(NodeKind::None, pcx.nodes[scrutinee].start,
            pcx.nodes[scrutinee].end, &pcx);
        pcx.nodes[inner] = pcx.nodes[scrutinee];
        pcx.nodes[inner].p |= NODE_CHECKED;
        pcx.nodes[inner].ty = st;
        pcx.nodes[scrutinee].kind = NodeKind::Unary;
        pcx.nodes[scrutinee].op = Tok::Amp;
        pcx.nodes[scrutinee].a = 0;
        pcx.nodes[scrutinee].b = inner;
        pcx.nodes[scrutinee].count = 0;
        pcx.nodes[scrutinee].list = 0;
        pcx.nodes[scrutinee].p = 0;
        pcx.nodes[scrutinee].ty = 0;
        st = check_recovering(scrutinee, 0, &pcx);
    }
    var result = expected;
    var all_never = true;
    // `if let` without `else` (0.6): of type `()`, like an `if`.
    let no_else = pcx.nodes[n].count == 2 && (pcx.nodes[child(n, 1, pcx)].p & ARM_NO_ELSE) != 0;
    if no_else && expected != 0 && expected != TY_UNIT {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"'if let' without else must have type '()', expected '", pcx);
        err_type(expected, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
    // (0.14) without an expected type, an arm whose value is an
    // unsuffixed literal (0.25.4: or an array of them, is_context_value)
    // takes the type of the first other arm: checked after it (a
    // literal needs none of the pattern's bindings)
    let later = expected == 0 && !no_else
        && (0..pcx.nodes[n].count).any(|i| !is_context_value(pcx.nodes[child(n, i, pcx)].c,
            pcx));
    var typed_at = pcx.nodes[n].count;
    for i in 0..pcx.nodes[n].count {
        let arm = child(n, i, pcx);
        push_scope(&pcx);
        let locals = pcx.locals.len() as i64;
        if st == pcx.ty_error {
            // (after an error in the scrutinee: bindings of the error type)
            poison_pattern(pcx.nodes[arm].a, &pcx);
        } else {
            check_pattern(pcx.nodes[arm].a, st, &pcx);
            // (0.17, T1: its bindings' drops, or they borrow:
            // front/own/drops)
            arm_drops(n, arm, &pcx);
        }
        if pcx.nodes[arm].b != 0 {
            check_expr(pcx.nodes[arm].b, TY_BOOL, &pcx);
        }
        let body = pcx.nodes[arm].c;
        var t = 0;
        if (pcx.nodes[arm].p & ARM_LET_ELSE) != 0 {
            // (0.18.1) `let ... else { .. }`: the block leaves
            t = check_wrapped(body, 0, &pcx);
            if t != TY_NEVER && t != pcx.ty_error {
                err_begin(pcx.nodes[body].start, &pcx);
                err_str(c"the 'else' block of a 'let ... else' must not end normally", pcx);
                err_help(c"end it with 'return', 'break', 'continue' or a call that never returns ('panic(..)')", pcx);
                err_end(&pcx);
            }
        } else if no_else && i == 0 {
            t = check_wrapped(body, 0, &pcx);
            if t != TY_UNIT && t != TY_NEVER {
                type_error_got(n, c"'if let' without else must have type '()'", t, &pcx);
            }
            result = TY_UNIT;
        }
        else if result != 0 && expected == 0 && is_integer(result)
            && !takes_context(body, &pcx) {
            // (0.15: two integer types join to the wider one)
            t = join_arm(n, i, body, result, later, &pcx);
            if t != TY_NEVER {
                result = t;
            }
        } else if result != 0 {
            t = check_wrapped(body, result, &pcx);
        } else if later && is_context_value(body, pcx) {
            t = pcx.ty_error;
        } else {
            t = check_wrapped(body, 0, &pcx);
            if t != TY_NEVER {
                result = t;
                typed_at = i;
            }
        }
        if t != TY_NEVER {
            all_never = false;
        }
        check_scope_exit(t, locals, pcx.nodes[body].start, &pcx);
        pop_scope(&pcx);
    }
    if later {
        for i in 0..typed_at {
            let body = pcx.nodes[child(n, i, pcx)].c;
            if is_context_value(body, pcx) {
                let t = check_wrapped(body, result, &pcx);
                if result == 0 {
                    result = t;
                }
            }
        }
    }
    if st != TY_NEVER && st != pcx.ty_error {
        check_arms(n, st, &pcx);
    }
    if all_never || result == 0 {
        return TY_NEVER;
    }
    result
}
