// The exhaustiveness of a `match` and the reachability of its arms, by
// usefulness (Maranget, "Warnings for pattern matching", JFP 2007): an arm
// is unreachable when its pattern is not useful after the arms above it,
// and a match is exhaustive when a wildcard is not useful after all of
// them; otherwise a missing pattern (a witness) is found and shown.
//
// A pattern matrix is MAT[start + row * cols + col] (pattern nodes, 0 for a
// wildcard), with the column types at MTY[types + col]. Matrices are made
// on top of MAT and dropped on return.

use crate::base::{
    IntVec, buf_byte, buf_fmt, buf_int, buf_new, buf_slice, buf_str, buf_uint, free, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_help, err_help_fmt, err_str, err_try_fmt, pos_line};
use crate::front::ast::{ARM_SYNTHETIC, child};
use crate::front::ast::NodeKind::{PatBind, PatOr, PatRange, PatWild};
use crate::front::check::variant_fields::has_named_fields;
use crate::front::distinct::strip_distinct;
use crate::front::types::{
    TY_BOOL, TY_UNIT, TyKind, buf_type, enum_variant, get_enums, int_max, is_integer, is_ref,
    is_signed, struct_field, variant_field,
};

const W_ANY: i64 = 0;

const W_VARIANT: i64 = 1;

const W_BOOL: i64 = 2;

const W_TUPLE: i64 = 3;

const W_INT: i64 = 4;

fn is_wild(p: i64, pcx: &Ctx<Comp>) -> bool {
    p == 0 || pcx.nodes[p as usize].kind == PatWild || pcx.nodes[p as usize].kind == PatBind
}

// Integers in an order-preserving signed form: unsigned values with the
// top bit flipped.
pub fn int_key(value: i64, ty: i64) -> i64 {
    if is_signed(ty) { value } else { value ^ (1 << 63) }
}

fn key_value(key: i64, ty: i64) -> i64 {
    if is_signed(ty) { key } else { key ^ (1 << 63) }
}

fn min_key(ty: i64) -> i64 {
    if is_signed(ty) {
        return 0 - (int_max(ty) as i64) - 1;
    }
    int_key(0, ty)
}

fn max_key(ty: i64) -> i64 {
    int_key(int_max(ty) as i64, ty)
}

// The range (keys) of an integer head pattern.
fn head_low(p: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    int_key(pcx.nodes[p as usize].x, ty)
}

fn head_high(p: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[p as usize].kind == PatRange {
        return int_key(pcx.nodes[p as usize].y, ty);
    }
    int_key(pcx.nodes[p as usize].x, ty)
}

// (0.27.2) Whether struct type ty is matched by its fields: in a program
// of the rust edition (MVS has no struct patterns).
fn rust_struct(ty: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.edition != 0 && pcx.structs[pcx.types[ty as usize].a as usize].closure == 0
}

// The parts a tuple pattern of type ty has: a tuple's elements, a
// struct's fields.
fn part_count(ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[ty as usize].kind
        == TyKind::Struct { pcx.structs[pcx.types[ty as usize].a as usize].field_count }
    else { pcx.types[ty as usize].count }
}

// The kind of the constructors of type ty: 1 enum, 2 bool, 3 tuple, 4
// integer, 0 none (only wildcards match it).
fn ctor_kind(ty: i64, pcx: &Ctx<Comp>) -> i64 {
    let kind = pcx.types[ty as usize].kind;
    if kind == TyKind::Enum { return 1; }
    if ty == TY_BOOL { return 2; }
    if kind == TyKind::Tuple || ty == TY_UNIT { return 3; }
    // (0.27.2) a struct of the rust edition, which its struct patterns
    // match field by field: one constructor, as a tuple. RULE: F27.1
    if kind == TyKind::Struct && rust_struct(ty, pcx) { return 3; }
    if is_integer(ty) { return 4; }
    0
}

// The type a column of values of type t is matched as: a reference's
// referent (0.18.1: its patterns match what it points to, PAT_DEREF; a
// reference has one constructor), a distinct type's underlying type
// (0.18: its values are those).
fn column_type(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if is_ref(t, pcx) && !is_ref(pcx.types[t as usize].a, pcx) {
        return strip_distinct(pcx.types[t as usize].a, pcx);
    }
    strip_distinct(t, pcx)
}

fn mat_row(m: i64, cols: i64, r: i64) -> i64 {
    m + r * cols
}

// Copies the rows of matrix (m, rows, cols) with or-patterns in the first
// column expanded into one row per alternative; returns the new start and
// sets *out_rows.
fn expand_rows(m: i64, rows: i64, cols: i64, out_rows: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.mat.count;
    let mut count: i64 = 0;
    for r in 0..rows {
        unsafe {
            count += push_expanded(mat_row(m, cols, r), cols,
                (*pcx.mat.data.add(mat_row(m, cols, r) as usize)), pcx);
        }
    }
    *out_rows = count;
    start
}

// Pushes the row at `row` with head `head` (expanding or-patterns); returns
// the number of rows pushed.
fn push_expanded(row: i64, cols: i64, head: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if head != 0 && pcx.nodes[head as usize].kind == PatOr {
            let mut count: i64 = 0;
            for i in 0..pcx.nodes[head as usize].count {
                count += push_expanded(row, cols, child(head, i, pcx), pcx);
            }
            return count;
        }
        pcx.mat.push(head);
        for c in 1..cols {
            pcx.mat.push((*pcx.mat.data.add((row + c) as usize)));
        }
        1
    }
}

// The arity and field types of constructor `c` of type ty (pushed on
// MTY); returns the arity.
fn push_ctor_types(ty: i64, c: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = ctor_kind(ty, pcx);
    if kind == 1 {
        let v = enum_variant(pcx.types[ty as usize].a, c);
        for i in 0..pcx.variants[v as usize].field_count {
            pcx.mty.push(column_type(variant_field(v, i, pcx), pcx));
        }
        return pcx.variants[v as usize].field_count;
    }
    if kind == 3 && ty != TY_UNIT {
        let count = part_count(ty, pcx);
        for i in 0..count {
            pcx.mty.push(column_type(crate::front::types::part_type(ty, i, pcx), pcx));
        }
        return count;
    }
    0
}

// Whether head pattern p (not a wildcard) is constructor c of type ty (for
// integers, c is a segment start key, the segment ending at `c_end`).
fn head_is(p: i64, ty: i64, c: i64, c_end: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let kind = ctor_kind(ty, pcx);
        if kind == 1 {
            return pcx.nodes[p as usize].x - (*get_enums().add(pcx.types[ty as usize].a as usize)).variants == c;
        }
        if kind == 2 {
            return pcx.nodes[p as usize].x == c;
        }
        if kind == 3 {
            return true;
        }
        head_low(p, ty, pcx) <= c && c_end <= head_high(p, ty, pcx)
    }
}

// Pushes the specialization of the row at `row` (head of type ty) by
// constructor c of the given arity; returns whether the row was kept.
fn push_specialized(row: i64, cols: i64, ty: i64, c: i64, c_end: i64, arity: i64,
    pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let head = (*pcx.mat.data.add(row as usize));
        if is_wild(head, pcx) {
            for _ in 0..arity {
                pcx.mat.push(0);
            }
        } else if head_is(head, ty, c, c_end, pcx) {
            for i in 0..arity {
                pcx.mat.push(child(head, i, pcx));
            }
        } else {
            return false;
        }
        for k in 1..cols {
            pcx.mat.push((*pcx.mat.data.add((row + k) as usize)));
        }
        true
    }
}

// The integer segments of column 0 of matrix (m, rows, cols), split also
// at the range of `extra` (a head pattern, or 0): their start keys in CUTS
// (sorted, unique); the last segment ends at the type's maximum.
fn int_segments(m: i64, rows: i64, cols: i64, ty: i64, extra: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.cuts.count = 0;
        pcx.cuts.push(min_key(ty));
        let top = max_key(ty);
        for r in 0..rows + 1 {
            let p = if r < rows { (*pcx.mat.data.add(mat_row(m, cols, r) as usize)) }
                else { extra };
            if is_wild(p, pcx) {
                continue;
            }
            pcx.cuts.push(head_low(p, ty, pcx));
            let high = head_high(p, ty, pcx);
            if high < top {
                pcx.cuts.push(high + 1);
            }
        }
        // Insertion sort, then unique.
        for i in 1..pcx.cuts.count {
            let mut j = i;
            while j > 0
                && (*pcx.cuts.data.add((j - 1) as usize)) > (*pcx.cuts.data.add(j as usize)) {
                let t = (*pcx.cuts.data.add(j as usize));
                (*pcx.cuts.data.add(j as usize)) = (*pcx.cuts.data.add((j - 1) as usize));
                (*pcx.cuts.data.add((j - 1) as usize)) = t;
                j -= 1;
            }
        }
        let mut n: i64 = 0;
        for i in 0..pcx.cuts.count {
            if n == 0
                || (*pcx.cuts.data.add((n - 1) as usize)) != (*pcx.cuts.data.add(i as usize)) {
                (*pcx.cuts.data.add(n as usize)) = (*pcx.cuts.data.add(i as usize));
                n += 1;
            }
        }
        pcx.cuts.count = n;
    }
}

fn segment_end(i: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if i + 1 < pcx.cuts.count { unsafe { (*pcx.cuts.data.add((i + 1) as usize)) - 1 } }
    else { max_key(ty) }
}

// The number of constructors of the column's type to try, and whether the
// constructors in column 0 cover the type (`complete`).
fn ctor_count(m: i64, rows: i64, cols: i64, ty: i64, complete: &mut bool, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let kind = ctor_kind(ty, pcx);
        let mut total: i64 = 0;
        if kind == 1 {
            total = (*get_enums().add(pcx.types[ty as usize].a as usize)).variant_count;
        } else if kind == 2 {
            total = 2;
        } else if kind == 3 {
            total = 1;
        } else if kind == 4 {
            total = pcx.cuts.count;
        }
        let mut all = kind != 0;
        for c in 0..total {
            let mut seen = false;
            let start = if kind == 4 { (*pcx.cuts.data.add(c as usize)) } else { c };
            let end = if kind == 4 { segment_end(c, ty, pcx) } else { c };
            for r in 0..rows {
                let p = (*pcx.mat.data.add(mat_row(m, cols, r) as usize));
                if !is_wild(p, pcx) && head_is(p, ty, start, end, pcx) {
                    seen = true;
                    break;
                }
            }
            if !seen {
                all = false;
            }
        }
        *complete = all;
        total
    }
}

// Whether row q (at `q`, `cols` patterns) is useful with respect to the
// matrix (m, rows, cols) with column types at `types`: whether some value
// matches q and no row.
fn useful(m: i64, rows: i64, cols: i64, types: i64, q: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if cols == 0 {
            return rows == 0;
        }
        let mark = pcx.mat.count;
        let tmark = pcx.mty.count;
        let head = (*pcx.mat.data.add(q as usize));
        let mut result = false;
        if head != 0 && pcx.nodes[head as usize].kind == PatOr {
            for i in 0..pcx.nodes[head as usize].count {
                let q2 = pcx.mat.count;
                pcx.mat.push(child(head, i, pcx));
                for k in 1..cols {
                    pcx.mat.push((*pcx.mat.data.add((q + k) as usize)));
                }
                if useful(m, rows, cols, types, q2, pcx) {
                    result = true;
                    break;
                }
            }
            pcx.mat.count = mark;
            return result;
        }
        let mut erows: i64 = 0;
        let em = expand_rows(m, rows, cols, &mut erows, pcx);
        let ty = (*pcx.mty.data.add(types as usize));
        let kind = ctor_kind(ty, pcx);
        if kind == 4 {
            int_segments(em, erows, cols, ty, if is_wild(head, pcx) { 0 } else { head }, pcx);
        }
        if !is_wild(head, pcx) || kind != 0 {
            let mut complete = false;
            let total = ctor_count(em, erows, cols, ty, &mut complete, pcx);
            if !is_wild(head, pcx) || complete {
                // Saved: the recursion reuses CUTS.
                let cuts = pcx.mat.count;
                if kind == 4 {
                    for i in 0..pcx.cuts.count {
                        pcx.mat.push((*pcx.cuts.data.add(i as usize)));
                    }
                }
                for c in 0..total {
                    let start = if kind == 4 { (*pcx.mat.data.add((cuts + c) as usize)) }
                        else { c };
                    let end = if kind == 4 {
                        if c + 1 < total { (*pcx.mat.data.add((cuts + c + 1) as usize)) - 1 }
                        else { max_key(ty) }
                    } else { c };
                    if !is_wild(head, pcx) && !head_is(head, ty, start, end, pcx) {
                        continue;
                    }
                    if specialized_useful(em, erows, cols, types, q, ty, start, end, pcx) {
                        result = true;
                        break;
                    }
                }
                pcx.mat.count = mark;
                pcx.mty.count = tmark;
                return result;
            }
        }
        // The default matrix: the rows with a wildcard head, without it.
        let d = pcx.mat.count;
        let mut drows: i64 = 0;
        for r in 0..erows {
            let row = mat_row(em, cols, r);
            if is_wild((*pcx.mat.data.add(row as usize)), pcx) {
                for k in 1..cols {
                    pcx.mat.push((*pcx.mat.data.add((row + k) as usize)));
                }
                drows += 1;
            }
        }
        result = useful(d, drows, cols - 1, types + 1, q + 1, pcx);
        pcx.mat.count = mark;
        pcx.mty.count = tmark;
        result
    }
}

fn specialized_useful(m: i64, rows: i64, cols: i64, types: i64, q: i64, ty: i64,
    c: i64, c_end: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mark = pcx.mat.count;
    let tmark = pcx.mty.count;
    let arity = push_ctor_types(ty, c, pcx);
    for k in 1..cols {
        unsafe { pcx.mty.push((*pcx.mty.data.add((types + k) as usize))); }
    }
    let new_cols = arity + cols - 1;
    let s = pcx.mat.count;
    let mut srows: i64 = 0;
    for r in 0..rows {
        if push_specialized(mat_row(m, cols, r), cols, ty, c, c_end, arity, pcx) {
            srows += 1;
        }
    }
    let sq = pcx.mat.count;
    push_specialized(q, cols, ty, c, c_end, arity, pcx);
    let result = useful(s, srows, new_cols, tmark, sq, pcx);
    pcx.mat.count = mark;
    pcx.mty.count = tmark;
    result
}

// Whether some value matches no row of the matrix; if so, its witness
// (one node per column) is pushed on WSTACK.
fn find_missing(m: i64, rows: i64, cols: i64, types: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if cols == 0 {
            return rows == 0;
        }
        let mark = pcx.mat.count;
        let tmark = pcx.mty.count;
        let mut erows: i64 = 0;
        let em = expand_rows(m, rows, cols, &mut erows, pcx);
        let ty = (*pcx.mty.data.add(types as usize));
        let kind = ctor_kind(ty, pcx);
        if kind == 4 {
            int_segments(em, erows, cols, ty, 0, pcx);
        }
        let mut complete = false;
        let total = ctor_count(em, erows, cols, ty, &mut complete, pcx);
        let cuts = pcx.mat.count;
        if kind == 4 {
            for i in 0..pcx.cuts.count {
                pcx.mat.push((*pcx.cuts.data.add(i as usize)));
            }
        }
        if complete {
            for c in 0..total {
                let start = if kind == 4 { (*pcx.mat.data.add((cuts + c) as usize)) } else { c };
                let end = if kind == 4 {
                    if c + 1 < total { (*pcx.mat.data.add((cuts + c + 1) as usize)) - 1 }
                    else { max_key(ty) }
                } else { c };
                let arity_mark = pcx.mty.count;
                let arity = push_ctor_types(ty, start, pcx);
                for k in 1..cols {
                    pcx.mty.push((*pcx.mty.data.add((types + k) as usize)));
                }
                let s = pcx.mat.count;
                let mut srows: i64 = 0;
                for r in 0..erows {
                    if push_specialized(mat_row(em, cols, r), cols, ty, start, end, arity, pcx) {
                        srows += 1;
                    }
                }
                if find_missing(s, srows, arity + cols - 1, arity_mark, pcx) {
                    // The first `arity` witnesses are the constructor's fields:
                    // they become the kids of its node, which takes their place.
                    let found = arity + cols - 1;
                    let base = pcx.wstack.count - found;
                    let node = witness_node(if kind == 1 { W_VARIANT } else if kind == 2 { W_BOOL }
                        else if kind == 3 { W_TUPLE } else { W_INT },
                        if kind == 1 { enum_variant(pcx.types[ty as usize].a, start) }
                        else if kind == 4 { key_value(start, ty) } else { start },
                        ty, base, arity, pcx);
                    if kind == 4 {
                        // (0.17) an integer witness is its whole segment
                        (*pcx.wit.data.add((node + 3) as usize)) = key_value(end, ty);
                    }
                    for k in 0..cols - 1 {
                        pcx.wstack.push((*pcx.wstack.data.add((base + arity + k) as usize)));
                    }
                    (*pcx.wstack.data.add(base as usize)) = node;
                    for k in 0..cols - 1 {
                        (*pcx.wstack.data.add((base + 1 + k) as usize)) = (
                            *pcx.wstack.data.add((base + found + k) as usize));
                    }
                    pcx.wstack.count = base + cols;
                    pcx.mat.count = mark;
                    pcx.mty.count = tmark;
                    return true;
                }
                pcx.mat.count = s;
                pcx.mty.count = arity_mark;
            }
            pcx.mat.count = mark;
            pcx.mty.count = tmark;
            return false;
        }
        let d = pcx.mat.count;
        let mut drows: i64 = 0;
        for r in 0..erows {
            let row = mat_row(em, cols, r);
            if is_wild((*pcx.mat.data.add(row as usize)), pcx) {
                for k in 1..cols {
                    pcx.mat.push((*pcx.mat.data.add((row + k) as usize)));
                }
                drows += 1;
            }
        }
        let found = find_missing(d, drows, cols - 1, types + 1, pcx);
        if found {
            // A constructor no row starts with, or `_`.
            let mut node = witness_node(W_ANY, 0, ty, 0, 0, pcx);
            for c in 0..total {
                let start = if kind == 4 { (*pcx.mat.data.add((cuts + c) as usize)) } else { c };
                let end = if kind == 4 {
                    if c + 1 < total { (*pcx.mat.data.add((cuts + c + 1) as usize)) - 1 }
                    else { max_key(ty) }
                } else { c };
                let mut seen = false;
                for r in 0..erows {
                    let p = (*pcx.mat.data.add(mat_row(em, cols, r) as usize));
                    if !is_wild(p, pcx) && head_is(p, ty, start, end, pcx) {
                        seen = true;
                    }
                }
                if !seen {
                    if kind == 1 {
                        let v = enum_variant(pcx.types[ty as usize].a, c);
                        let kids = pcx.wkids.count;
                        for _ in 0..pcx.variants[v as usize].field_count {
                            let pcx_arg = witness_node(W_ANY, 0, 0, 0, 0, pcx);
                            pcx.wkids.push(pcx_arg);
                        }
                        node = witness_node(W_VARIANT, v, ty, 0, 0, pcx);
                        (*pcx.wit.data.add((node + 3) as usize)) = kids;
                        (*pcx.wit.data.add((node + 4) as usize)) = pcx.variants[v as usize].field_count;
                    } else if kind == 2 {
                        node = witness_node(W_BOOL, c, ty, 0, 0, pcx);
                    } else if kind == 4 {
                        node = witness_node(W_INT, key_value(start, ty), ty, 0, 0, pcx);
                        (*pcx.wit.data.add((node + 3) as usize)) = key_value(end, ty);
                    }
                    break;
                }
            }
            let base = pcx.wstack.count - (cols - 1);
            pcx.wstack.push(0);
            let mut k = pcx.wstack.count - 1;
            while k > base {
                (*pcx.wstack.data.add(k as usize)) = (*pcx.wstack.data.add((k - 1) as usize));
                k -= 1;
            }
            (*pcx.wstack.data.add(base as usize)) = node;
        }
        pcx.mat.count = mark;
        pcx.mty.count = tmark;
        found
    }
}

// A witness node; `kids` kids from WSTACK[kids_at..] are copied.
fn witness_node(kind: i64, value: i64, ty: i64, kids_at: i64, kids: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let first = pcx.wkids.count;
    for i in 0..kids {
        unsafe { pcx.wkids.push((*pcx.wstack.data.add((kids_at + i) as usize))); }
    }
    let node = pcx.wit.count;
    pcx.wit.push(kind);
    pcx.wit.push(value);
    pcx.wit.push(ty);
    pcx.wit.push(first);
    pcx.wit.push(kids);
    node
}

// (0.27.2) Witness `S { f: w, .. }` (the fields that matter, by name) or
// `S(w, ..)` of struct type ty, its kids from wkids[first..].
fn struct_witness(out: i64, ty: i64, first: i64, kids: i64, pcx: &Ctx<Comp>) {
    buf_type(out, ty, pcx);
    let s = pcx.types[ty as usize].a;
    let tuple = kids > 0 && sym_text(field_name(s, 0, pcx), pcx) == b"0";
    buf_str(out, if tuple { c"(" } else { c" { " });
    for i in 0..kids {
        let kid = pcx.wkids.get(first + i);
        if tuple {
            buf_witness(out, kid, pcx);
            buf_str(out, c", ");
        } else if !witness_any(kid, pcx) {
            buf_fmt(out,
                format_args("{}: ", str::from_utf8(sym_text(field_name(s, i, pcx), pcx)).unwrap()));
            buf_witness(out, kid, pcx);
            buf_str(out, c", ");
        }
    }
    buf_str(out, if tuple { c"..)" } else { c".. }" });
}

// The name of field i of struct s.
fn field_name(s: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FIELDS is the checker's global field table (struct_field).
    // SAFETY: i is a field of s: a witness of s has a kid per field.
    unsafe { (*struct_field(s, i, pcx)).name }
}

fn buf_witness(out: i64, node: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let kind = (*pcx.wit.data.add(node as usize));
        let value = (*pcx.wit.data.add((node + 1) as usize));
        let ty = (*pcx.wit.data.add((node + 2) as usize));
        let first = (*pcx.wit.data.add((node + 3) as usize));
        let kids = (*pcx.wit.data.add((node + 4) as usize));
        if witness_any(node, pcx) {
            buf_byte(out, b'_');
        } else if kind == W_BOOL {
            buf_str(out, if value != 0 { c"true" } else { c"false" });
        } else if kind == W_INT {
            // (0.17) the segment, `low..=high`, when it is more than one value
            if is_signed(ty) {
                buf_int(out, value);
                if first != value {
                    buf_str(out, c"..=");
                    buf_int(out, first);
                }
            } else {
                buf_uint(out, value as u64);
                if first != value {
                    buf_str(out, c"..=");
                    buf_uint(out, first as u64);
                }
            }
        } else if kind == W_VARIANT {
            buf_type(out, ty, pcx);
            buf_fmt(out,
                format_args("::{}",
                    str::from_utf8(sym_text(pcx.variants[value as usize].name, pcx)).unwrap()));
        }
        if kind == W_VARIANT && kids > 0 && has_named_fields(value, pcx) {
            // (0.17) `E::V { a: 1, .. }`: the fields that matter, by name
            let names = pcx.nodes[pcx.variants[value as usize].node as usize].d;
            buf_str(out, c" { ");
            for i in 0..kids {
                let kid = (*pcx.wkids.data.add((first + i) as usize));
                if !witness_any(kid, pcx) {
                    buf_fmt(out,
                        format_args("{}: ",
                            str::from_utf8(sym_text(pcx.nodes[child(names, i, pcx) as usize].a,
                                pcx)).unwrap()));
                    buf_witness(out, kid, pcx);
                    buf_str(out, c", ");
                }
            }
            buf_str(out, c".. }");
            return;
        }
        if kind == W_TUPLE && pcx.types[ty as usize].kind == TyKind::Struct {
            // (0.27.2) a rust struct's: `S { a: 1, .. }`, `S(_, 1)`
            struct_witness(out, ty, first, kids, pcx);
            return;
        }
        if kind == W_TUPLE || (kind == W_VARIANT && kids > 0) {
            buf_byte(out, b'(');
            for i in 0..kids {
                if i > 0 {
                    buf_str(out, c", ");
                }
                buf_witness(out, (*pcx.wkids.data.add((first + i) as usize)), pcx);
            }
            if kind == W_TUPLE && kids == 1 {
                buf_byte(out, b',');
            }
            buf_byte(out, b')');
        }
    }
}

// Whether witness `node` matches anything: `_`, or every integer.
fn witness_any(node: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let kind = (*pcx.wit.data.add(node as usize));
        let ty = (*pcx.wit.data.add((node + 2) as usize));
        kind == W_ANY
            || (kind == W_INT
                && int_key((*pcx.wit.data.add((node + 1) as usize)), ty) == min_key(ty)
                && int_key((*pcx.wit.data.add((node + 3) as usize)), ty) == max_key(ty))
    }
}

// (0.17) The patterns no row of the one-column matrix (0, rows) matches,
// one per constructor of its type (an enum's variants, bool's values, an
// integer's missing ranges, adjacent ones joined), as witness nodes into
// `list`, at most `max`; whether there were more. Other types: nothing
// (the caller has the first witness).
fn missing_witnesses(rows: i64, list: &mut IntVec, max: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let ty = (*pcx.mty.data.add(0));
        let kind = ctor_kind(ty, pcx);
        if kind != 1 && kind != 2 && kind != 4 {
            return false;
        }
        let mark = pcx.mat.count;
        let tmark = pcx.mty.count;
        let mut erows: i64 = 0;
        let em = expand_rows(0, rows, 1, &mut erows, pcx);
        if kind == 4 {
            int_segments(em, erows, 1, ty, 0, pcx);
        }
        let mut complete = false;
        let total = ctor_count(em, erows, 1, ty, &mut complete, pcx);
        let cuts = pcx.mat.count;
        if kind == 4 {
            for i in 0..pcx.cuts.count {
                pcx.mat.push((*pcx.cuts.data.add(i as usize)));
            }
        }
        let mut last: i64 = -1;
        let mut last_end: i64 = 0;
        let mut more = false;
        for c in 0..total {
            let start = if kind == 4 { (*pcx.mat.data.add((cuts + c) as usize)) } else { c };
            let end = if kind == 4 {
                if c + 1 < total { (*pcx.mat.data.add((cuts + c + 1) as usize)) - 1 }
                else { max_key(ty) }
            } else { c };
            let arity_mark = pcx.mty.count;
            let arity = push_ctor_types(ty, start, pcx);
            let s = pcx.mat.count;
            let mut srows: i64 = 0;
            for r in 0..erows {
                if push_specialized(mat_row(em, 1, r), 1, ty, start, end, arity, pcx) {
                    srows += 1;
                }
            }
            pcx.wstack.count = 0;
            if find_missing(s, srows, arity, arity_mark, pcx) {
                if kind == 4 && last >= 0 && last_end + 1 == start {
                    (*pcx.wit.data.add((last + 3) as usize)) = key_value(end, ty);
                    last_end = end;
                } else if list.count >= max {
                    more = true;
                } else {
                    let node = witness_node(if kind == 1 { W_VARIANT } else if kind == 2 { W_BOOL }
                        else { W_INT },
                        if kind == 1 { enum_variant(pcx.types[ty as usize].a, start) }
                        else if kind == 4 { key_value(start, ty) } else { start },
                        ty, 0, arity, pcx);
                    if kind == 4 {
                        (*pcx.wit.data.add((node + 3) as usize)) = key_value(end, ty);
                        last = node;
                        last_end = end;
                    }
                    list.push(node);
                }
            } else {
                last = -1;
            }
            pcx.mat.count = s;
            pcx.mty.count = arity_mark;
        }
        pcx.mat.count = mark;
        pcx.mty.count = tmark;
        more
    }
}

// Reachability of every arm, and exhaustiveness, of match n on type st.
// (0.17) An unreachable arm's help names the arm above that covers it; a
// non-exhaustive match's `try:` is the missing arms, ready to paste.
pub fn check_arms(n: i64, st: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.mat.count = 0;
        pcx.mty.count = 0;
        // (0.18: a distinct type's values are its underlying type's)
        pcx.mty.push(column_type(st, pcx));
        // The patterns of the arms without guards so far: one-column rows.
        let rows_start: i64 = 0;
        let mut rows: i64 = 0;
        let mut kept = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut kept_arms = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..pcx.nodes[n as usize].count {
            let arm = child(n, i, pcx);
            let p = pcx.nodes[arm as usize].a;
            // The matrix is rebuilt from `kept` for every arm.
            pcx.mat.count = 0;
            for r in 0..kept.count {
                pcx.mat.push((*kept.data.add(r as usize)));
            }
            let q = pcx.mat.count;
            pcx.mat.push(p);
            if !useful(rows_start, kept.count, 1, 0, q, pcx)
                && (pcx.nodes[arm as usize].p & ARM_SYNTHETIC) == 0 {
                unreachable_arm(p, kept, kept_arms, pcx);
            }
            if pcx.nodes[arm as usize].b == 0 {
                kept.push(p);
                kept_arms.push(arm);
                rows += 1;
            }
        }
        pcx.mat.count = 0;
        for r in 0..kept.count {
            pcx.mat.push((*kept.data.add(r as usize)));
        }
        pcx.wstack.count = 0;
        if find_missing(0, kept.count, 1, 0, pcx) {
            let first = (*pcx.wstack.data.add(0));
            err_begin(pcx.nodes[n as usize].start, pcx);
            err_str(c"non-exhaustive match: '", pcx);
            buf_witness(pcx.err, first, pcx);
            err_str(c"' is not covered", pcx);
            let mut list = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            pcx.mat.count = 0;
            for r in 0..kept.count {
                pcx.mat.push((*kept.data.add(r as usize)));
            }
            let more = missing_witnesses(kept.count, &mut list, 8, pcx);
            if list.count == 0 {
                list.push(first);
            }
            if rows < pcx.nodes[n as usize].count {
                err_help(c"arms with guards do not count; add an arm without a guard", pcx);
            } else if list.count > 1 {
                let plus: &[u8] = if more { b"+" } else { b"" };
                err_help_fmt(
                    { let plus = str::from_utf8(plus).unwrap(); format_args("{}{plus} patterns are not covered: add the arms (try:), or a wildcard arm '_ =>'", list.count) }, pcx);
            } else {
                err_help(c"add an arm for it (try:), or a wildcard arm '_ =>'", pcx);
            }
            let t = buf_new();
            for k in 0..list.count {
                if k > 0 {
                    buf_byte(t, b' ');
                }
                buf_witness(t, (*list.data.add(k as usize)), pcx);
                buf_str(t, c" => VALUE,");
            }
            if more {
                buf_str(t, c" _ => VALUE,");
            }
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            free(list.data as *mut u8);
            err_end(pcx);
        }
        free(kept.data as *mut u8);
        free(kept_arms.data as *mut u8);
    }
}

// The error of an unreachable arm (pattern p) after the arms `kept` (their
// patterns; `arms`, the arm nodes): the first arm above that matches all
// it matches alone, by its line, else the arms above together.
fn unreachable_arm(p: i64, kept: IntVec, arms: IntVec, pcx: &mut Ctx<Comp>) -> ! {
    unsafe {
        let mut cover: i64 = -1;
        for j in 0..kept.count {
            pcx.mat.count = 0;
            pcx.mat.push((*kept.data.add(j as usize)));
            let q = pcx.mat.count;
            pcx.mat.push(p);
            if !useful(0, 1, 1, 0, q, pcx) {
                cover = (*arms.data.add(j as usize));
                break;
            }
        }
        err_begin(pcx.nodes[p as usize].start, pcx);
        err_str(c"unreachable match arm: the arms above match every value it matches", pcx);
        if cover >= 0 {
            err_help_fmt(
                format_args("the arm at line {} matches all it matches: delete this arm, or move it above that one", pos_line(pcx.nodes[cover as usize].start, pcx)), pcx);
        } else {
            err_help(c"together, the arms above match all it matches: delete this arm, or move it above them", pcx);
        }
        err_end(pcx)
    }
}
