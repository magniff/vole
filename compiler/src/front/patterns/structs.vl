// (0.27.2) The rust edition's struct patterns (front-rust.md F27.1, F7.2,
// F5.4): `S { a, b: q, .. }`, `S(x, y)`, `Self { .. }`, `Self(x, y)`. The
// parser reads them as variant patterns of one name; the checker makes
// each the tuple pattern of the struct's fields in order (a wildcard for
// each field left out), flagged PAT_FIELDS, which the lowering projects
// field by field as it does a tuple's elements (types::part_type).

use crate::base::sym_text;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_fmt, err_help, err_str, err_try_fmt};
use crate::front::ast::{
    NodeKind, PAT_FIELDS, PAT_PARENS, PAT_REST, child, list_begin, list_end, list_push, new_node,
};
use crate::front::check::{mismatch_error, name_error};
use crate::front::check::unsafety::NODE_NO_READ;
use crate::front::modules::lookup::{B_ITEM, binding_kind, binding_value, lookup_item};
use crate::front::types::{err_type, find_field, struct_field};

// Pattern p, a variant pattern of one name, when that name is a struct
// (or `Self` of a struct): p becomes its tuple pattern, checked against
// ty; true. False when the name is no struct. RULE: F27.1, F7.2, F5.4
pub fn struct_pattern(p: i64, ty: i64, pcx: &mut Ctx<Comp>) -> bool {
    let name = pcx.nodes[p as usize].b;
    let mut st: i64 = 0;
    if name == pcx.self_type_sym && crate::front::check::rust::self_struct_node(pcx) != 0 {
        st = pcx.self_type;
    } else {
        let b = lookup_item(pcx.cur_mod, name, pcx.cur_mod, pcx);
        // UNSAFE: SYM_STRUCT is a raw table indexed by item key (base/ctx.vl).
        // SAFETY: binding_value of a B_ITEM binding is an item key, within it.
        if binding_kind(b) != B_ITEM
            || unsafe { (*pcx.sym_struct.add(binding_value(b) as usize)) } == 0 {
            return false;
        }
        pcx.nodes[p as usize].a = name;
        st = super::pattern_enum_type(p, ty, pcx);
    }
    if st != ty {
        mismatch_error(p, ty, st, pcx);
        pcx.nodes[p as usize].kind = NodeKind::PatWild;
        return true;
    }
    let s = pcx.types[st as usize].a;
    let count = pcx.structs[s as usize].field_count;
    let mark = pcx.tscratch.count;
    for _ in 0..count {
        pcx.tscratch.push(0);
    }
    if (pcx.nodes[p as usize].p & PAT_FIELDS) != 0 {
        named_parts(p, st, mark, pcx);
    } else {
        positional_parts(p, st, mark, pcx);
    }
    let list = list_begin(pcx);
    for k in 0..count {
        let mut q = pcx.tscratch.get(mark + k);
        if q == 0 {
            q = new_node(NodeKind::PatWild, pcx.nodes[p as usize].start,
                pcx.nodes[p as usize].start, pcx);
        }
        list_push(q, pcx);
    }
    pcx.tscratch.truncate(mark);
    list_end(p, list, pcx);
    pcx.nodes[p as usize].kind = NodeKind::PatTuple;
    pcx.nodes[p as usize].p = (pcx.nodes[p as usize].p & !PAT_PARENS) | PAT_FIELDS;
    check_parts(p, ty, pcx);
    true
}

// The parts of struct pattern p (a PatTuple flagged PAT_FIELDS) checked
// against the fields of struct type ty: also a generic's instance's check
// of a pattern made already.
pub fn check_parts(p: i64, ty: i64, pcx: &mut Ctx<Comp>) {
    for k in 0..pcx.nodes[p as usize].count {
        super::check_pat(child(p, k, pcx), crate::front::types::part_type(ty, k, pcx), pcx);
    }
}

// `S { a, b: q, .. }`: each field's pattern into its slot TSCRATCH[mark +
// k] (k the field's index); a field named twice, not a field of S, or
// hidden is an error, and so is one left out without `..`.
fn named_parts(p: i64, st: i64, mark: i64, pcx: &mut Ctx<Comp>) {
    let s = pcx.types[st as usize].a;
    for i in 0..pcx.nodes[p as usize].count {
        let f = child(p, i, pcx);
        let k = find_field(s, pcx.nodes[f as usize].a, pcx);
        if k < 0 {
            err_begin(pcx.nodes[f as usize].start, pcx);
            err_fmt(format_args("no field '{}' in struct '",
                str::from_utf8(sym_text(pcx.nodes[f as usize].a, pcx)).unwrap()), pcx);
            err_type(st, pcx);
            err_str(c"'", pcx);
            err_end(pcx);
            continue;
        }
        if pcx.tscratch.get(mark + k) != 0 {
            name_error(pcx.nodes[f as usize].start, c"field '", pcx.nodes[f as usize].a,
                c"' is matched twice in the pattern", pcx);
        }
        // (a field the pattern's module cannot see: as `s.f` is)
        let access = new_node(NodeKind::FieldAccess, pcx.nodes[f as usize].start,
            pcx.nodes[f as usize].end, pcx);
        pcx.nodes[access as usize].b = pcx.nodes[f as usize].a;
        pcx.nodes[access as usize].x = k;
        pcx.nodes[access as usize].p |= NODE_NO_READ;
        crate::front::check::sealed::check_field(access, s, pcx);
        pcx.tscratch.set(mark + k, pcx.nodes[f as usize].b);
    }
    if (pcx.nodes[p as usize].p & PAT_REST) != 0 {
        return;
    }
    for k in 0..pcx.structs[s as usize].field_count {
        if pcx.tscratch.get(mark + k) == 0 {
            // UNSAFE: FIELDS is the checker's global field table (struct_field).
            // SAFETY: k is a field of struct s.
            let field = unsafe { (*struct_field(s, k, pcx)).name };
            err_begin(pcx.nodes[p as usize].start, pcx);
            err_str(c"the pattern of '", pcx);
            err_type(st, pcx);
            err_fmt(format_args("' does not mention field '{}'",
                str::from_utf8(sym_text(field, pcx)).unwrap()), pcx);
            err_help(c"match it too, or end the pattern with '..' to leave the rest out", pcx);
            err_end(pcx);
            return;
        }
    }
}

// `S(x, y)`: the patterns by position, one per field of a tuple struct.
fn positional_parts(p: i64, st: i64, mark: i64, pcx: &mut Ctx<Comp>) {
    let s = pcx.types[st as usize].a;
    let count = pcx.structs[s as usize].field_count;
    let n = pcx.nodes[p as usize].count;
    if !crate::front::check::rust::is_tuple_struct(pcx.structs[s as usize].node, pcx) && count > 0 {
        err_begin(pcx.nodes[p as usize].start, pcx);
        err_str(c"'", pcx);
        err_type(st, pcx);
        err_str(c"' has named fields: match them by name", pcx);
        err_try_fmt(format_args("{} {{ .. }}",
            str::from_utf8(sym_text(pcx.nodes[p as usize].b, pcx)).unwrap()), pcx);
        err_end(pcx);
        return;
    }
    if n != count {
        err_begin(pcx.nodes[p as usize].start, pcx);
        err_str(c"'", pcx);
        err_type(st, pcx);
        err_fmt(format_args("' has {count} fields, the pattern has {n}"), pcx);
        err_end(pcx);
        return;
    }
    for i in 0..n {
        pcx.tscratch.set(mark + i, child(p, i, pcx));
    }
}

// Binding pattern p `U` (or `Self`) when U is a struct with no fields: the
// pattern that matches its value; true. RULE: F7.3
pub fn unit_pattern(p: i64, ty: i64, pcx: &mut Ctx<Comp>) -> bool {
    let name = pcx.nodes[p as usize].a;
    let mut s: i64 = 0;
    if name == pcx.self_type_sym && crate::front::check::rust::self_struct_node(pcx) != 0 {
        s = crate::front::check::rust::self_struct_node(pcx);
    } else {
        let b = lookup_item(pcx.cur_mod, name, pcx.cur_mod, pcx);
        if binding_kind(b) != B_ITEM {
            return false;
        }
        s = crate::front::check::rust::struct_node_of_key(binding_value(b), pcx);
    }
    if s == 0 || pcx.nodes[s as usize].count != 0 {
        return false;
    }
    pcx.nodes[p as usize].kind = NodeKind::PatVariant;
    pcx.nodes[p as usize].b = name;
    pcx.nodes[p as usize].c = 1;
    pcx.nodes[p as usize].p |= PAT_FIELDS;
    struct_pattern(p, ty, pcx)
}
