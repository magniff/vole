// The `#[scoped]` rules (0.16): no arena handle of a scope, and no
// container on it, outlives the scope. A closure taking a scoped
// parameter (the body of a scope: `arena_scope(gpa, |s: ScopedArena| ...)`)
// returns no type holding the scoped type (S2) and captures no variable
// whose type holds one (S3); statics hold none (check_static_type;
// constants hold no structs at all) (docs/design/effects-allocation.md
// §2.4).
use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_help, err_help_sym, err_str, err_sym};
use crate::front::ast::{NodeKind, STRUCT_SCOPED};
use crate::front::modules::within_std;
use crate::front::types::{
    TyKind, enum_variant, err_type, fn_param, get_enums, struct_field, type_elem,
};

// The #[scoped] struct (a STRUCTS index) a value of type t holds, in a
// field, an element, a variant or behind a pointer; -1: none. Memoized.
pub fn scoped_in(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if t <= 0 || t == pcx.ty_error {
            return -1;
        }
        let known = pcx.scoped.get(t + 1);
        if known != 0 {
            return known - 2;
        }
        pcx.scoped.put(t + 1, 1);
        let mut found: i64 = -1;
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if (pcx.structs[s as usize].repr & STRUCT_SCOPED) != 0 {
                found = if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl - 1 }
                    else { s };
            } else {
                for i in 0..pcx.structs[s as usize].field_count {
                    if found < 0 {
                        found = scoped_in((*struct_field(s, i, pcx)).ty, pcx);
                    }
                }
            }
        } else if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if found < 0 {
                    found = scoped_in(type_elem(t, i, pcx), pcx);
                }
            }
        } else if kind == TyKind::Ptr || kind == TyKind::Slice || kind == TyKind::Array {
            found = scoped_in(pcx.types[t as usize].a, pcx);
        } else if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(e as usize)).variant_count {
                if found < 0 {
                    found = scoped_in(pcx.variants[enum_variant(e, i) as usize].shape, pcx);
                }
            }
        }
        pcx.scoped.put(t + 1, found + 2);
        found
    }
}

// Checks closure c (its id, CLOSURES index) once its signature and
// captures are known (finish_closure).
pub fn check_closure(c: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let f = pcx.closures[c as usize].f;
        let captures = pcx.closures[c as usize].capture_count;
        // (the env parameter first when it captures)
        let first: i64 = if captures > 0 { 1 } else { 0 };
        let mut takes = false;
        for i in first..pcx.fns[f as usize].param_count {
            if scoped_in(fn_param(f, i, pcx), pcx) >= 0 {
                takes = true;
            }
        }
        if !takes {
            return;
        }
        // (S2) its value
        let ret = pcx.fns[f as usize].ret;
        let s = scoped_in(ret, pcx);
        if s >= 0 {
            err_begin(value_pos(c, pcx), pcx);
            err_str(c"this arena scope's value holds '", pcx);
            err_sym(pcx.structs[s as usize].name, pcx);
            err_str(c"' (", pcx);
            err_type(ret, pcx);
            err_str(c"): its memory is gone when the scope ends", pcx);
            err_help(c"copy it out: 'v.clone_in(gpa)', or return what is computed from it", pcx);
            err_end_soft(pcx);
        }
        // (S3) its captures
        for j in 0..captures {
            let local = (pcx.capture_list[(pcx.closures[c as usize].captures + 2 * j) as usize]);
            if scoped_in(pcx.locals[local as usize].ty, pcx) >= 0 {
                err_begin(pcx.nodes[pcx.closures[c as usize].node as usize].start, pcx);
                err_str(c"an arena scope cannot use '", pcx);
                err_sym(pcx.locals[local as usize].name, pcx);
                err_str(c"': its type holds another scope's arena", pcx);
                err_help(c"take a view first: 'let s = ", pcx);
                err_help_sym(pcx.locals[local as usize].name, pcx);
                err_help(c".as_slice();'", pcx);
                err_end_soft(pcx);
            }
        }
    }
}

// Where closure c's value is: its body's tail, else the closure.
fn value_pos(c: i64, pcx: &Ctx<Comp>) -> i64 {
    let n = pcx.closures[c as usize].node;
    let body = pcx.nodes[pcx.fns[pcx.closures[c as usize].f as usize].node as usize].c;
    if body > 0 && pcx.nodes[body as usize].kind == NodeKind::Block
        && pcx.nodes[body as usize].a > 0 {
        return pcx.nodes[pcx.nodes[body as usize].a as usize].start;
    }
    if body > 0 && pcx.nodes[body as usize].kind != NodeKind::Block {
        return pcx.nodes[body as usize].start;
    }
    pcx.nodes[n as usize].start
}

// Instance f, checked: when it is std's arena_scope or a `scope` method
// whose body is a function passed by name (not a closure: check_closure
// has those), its value must not hold a #[scoped] struct either (S2).
pub fn check_scope_instance(f: i64, pcx: &mut Ctx<Comp>) {
    if pcx.fns[f as usize].tmpl == 0 || !within_std(pcx.fns[f as usize].module, pcx)
        || pcx.fns[f as usize].param_count == 0 {
        return;
    }
    let name = pcx.nodes[pcx.fns[f as usize].node as usize].a;
    if name != intern_c(c"arena_scope", pcx) && name != intern_c(c"scope", pcx) {
        return;
    }
    let body = fn_param(f, pcx.fns[f as usize].param_count - 1, pcx);
    if pcx.types[body as usize].kind == TyKind::Struct
        && pcx.structs[pcx.types[body as usize].a as usize].closure != 0 {
        return;
    }
    let ret = pcx.fns[f as usize].ret;
    let s = scoped_in(ret, pcx);
    if s < 0 || pcx.fns[f as usize].origin <= 0 {
        return;
    }
    err_begin(pcx.nodes[pcx.fns[f as usize].origin as usize].start, pcx);
    err_str(c"this arena scope's value holds '", pcx);
    err_sym(pcx.structs[s as usize].name, pcx);
    err_str(c"' (", pcx);
    err_type(ret, pcx);
    err_str(c"): its memory is gone when the scope ends", pcx);
    err_help(c"copy it out: 'v.clone_in(gpa)', or return what is computed from it", pcx);
    err_end_soft(pcx);
}

// Static `name` of type ty (declared at pos): an error if it holds a
// #[scoped] struct (then false).
pub fn check_static_type(ty: i64, name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    let s = scoped_in(ty, pcx);
    if s < 0 {
        return true;
    }
    err_begin(pos, pcx);
    err_str(c"static '", pcx);
    err_sym(name, pcx);
    err_str(c"' holds '", pcx);
    err_sym(pcx.structs[s as usize].name, pcx);
    err_str(c"' (", pcx);
    err_type(ty, pcx);
    err_str(c"): a scope's arena lives only while its scope runs", pcx);
    // (0.26.3: no static holds an allocator at all, alloc.static)
    err_help(c"keep it in the scope's locals", pcx);
    err_end_soft(pcx);
    false
}
