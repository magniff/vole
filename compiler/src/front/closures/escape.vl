// Escape (0.14): a value whose type holds a closure that borrows a
// variable cannot leave that variable's scope (check_scope_exit).
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_help, err_help_sym, err_str, err_sym};
use crate::front::closures::struct_field_of;
use crate::front::types::{ENUMS, TYPES, TyKind, enum_variant, type_elem};

// ---- Escape ----

// The deepest local a value of type t borrows through the closures it
// holds (-1: none); memoized.
pub fn type_borrow(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if t <= 0 || t == pcx.ty_error {
            return -1;
        }
        let known = pcx.borrows.get(t + 1);
        if known != 0 {
            return known - 2;
        }
        pcx.borrows.put(t + 1, 1);
        var b = -1;
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct {
            let s = TYPES[t].a;
            if pcx.structs[s].closure != 0 {
                b = pcx.closures[pcx.structs[s].closure - 1].borrow_depth;
            } else {
                for i in 0..pcx.structs[s].field_count {
                    b = max_of(b, type_borrow((*struct_field_of(s, i, pcx)).ty, &pcx));
                }
            }
        } else if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                b = max_of(b, type_borrow(type_elem(t, i), &pcx));
            }
        } else if kind == TyKind::Ptr || kind == TyKind::Slice || kind == TyKind::Array {
            b = type_borrow(TYPES[t].a, &pcx);
        } else if kind == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                b = max_of(b, type_borrow(pcx.variants[enum_variant(e, i)].shape, &pcx));
            }
        }
        pcx.borrows.put(t + 1, b + 2);
        b
    }
}

fn max_of(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// A value of type ty leaves a scope (a block's tail, a `break` value, a
// match arm's value) whose locals are those numbered from `depth` (a
// LOCAL_COUNT mark): an error at pos if it holds a closure borrowing one.
pub fn check_scope_exit(ty: i64, depth: i64, pos: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if !pcx.any_borrow {
            return;
        }
        let b = type_borrow(ty, &pcx);
        if b < depth {
            return;
        }
        let name = pcx.locals[b].name;
        err_begin(pos, &pcx);
        err_str(c"this value holds a closure that borrows '", pcx);
        err_sym(name, pcx);
        err_str(c"', which does not live outside this block", pcx);
        err_help(c"write `move`, or declare '", pcx);
        err_help_sym(name, pcx);
        err_help(c"' outside the block", pcx);
        err_end(&pcx);
    }
}
