// Fn bounds (0.14): whether a closure or a fn type satisfies an
// `F: Fn(..)`/`FnMut(..)` bound, the errors when not, and the types a
// bound gives a closure argument's parameters during inference.

use std::Option;

use crate::base::{SRC, SYMS, buf_bytes, buf_new, buf_slice};
use crate::base::diag::{
    err_begin, err_end, err_fix, err_fmt, err_help, err_int, err_str, err_sym, errors_forget,
    errors_mark,
};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::check::{LOCALS, SELF_TYPE, TRY_RESULT, Try, attempt};
use crate::front::closures::{CLOSURES, check_closure_sig, closure_of_type};
use crate::front::generics::{TP_BASE, TP_NAMES, TP_TYPES, env_leave};
use crate::front::generics::instantiate::{
    UNIFY_SELF, UNIFY_SELF_TY, mentions_unbound, tparam_index, unify,
};
use crate::front::modules::{CUR_MOD, module_of};
use crate::front::types::{TSCRATCH, TYPES, TY_ERROR, TyKind, err_type, make_type, type_elem};

// Type node n resolved, or 0 when it names nothing here (no error).
fn resolve_quietly(n: i64) -> i64 {
    let mark = errors_mark();
    if attempt(Try::Type, n) {
        return TRY_RESULT;
    }
    errors_forget(mark);
    0
}

// The fn type bound `bound` (a TyFn node) stands for, in the current
// scope of type parameters; 0 when a part of it is unknown.
fn bound_sig(bound: i64) -> i64 {
    unsafe {
        let saved = CUR_MOD;
        CUR_MOD = module_of(bound);
        let mark = TSCRATCH.count;
        var known = true;
        for i in 0..NODES[bound].count {
            // (0.20: `Fn(let T)`, a let parameter: front/conv)
            let t = crate::front::conv::fn_type_param(child(bound, i),
                resolve_quietly(child(bound, i)));
            known = known && t != 0;
            TSCRATCH.push(t);
        }
        let ret = resolve_quietly(NODES[bound].a);
        CUR_MOD = saved;
        if !known || ret == 0 {
            TSCRATCH.count = mark;
            return 0;
        }
        // (0.24: as a function's, conv::let_by_ref; not a `sink T`)
        for i in 0..NODES[bound].count {
            if (NODES[child(bound, i)].p & crate::front::ast::CONV_SINK) == 0 {
                TSCRATCH.data[mark + i] = crate::front::conv::let_by_ref(0, TSCRATCH.data[mark + i],
                    ret);
            }
        }
        make_type(TyKind::Fn, ret, 0, mark)
    }
}

// The fn type of a value of type t a bound can take: a closure's
// signature, or a plain fn type; 0.
fn callable_sig(t: i64) -> i64 {
    unsafe {
        let c = closure_of_type(t);
        if c != 0 {
            return CLOSURES[c - 1].sig;
        }
        if t > 0 && TYPES[t].kind == TyKind::Fn && TYPES[t].b == 0 {
            return t;
        }
        0
    }
}

// Whether type t satisfies the bound `bound` (a TyFn node, d = 2 for
// `Fn`, 3 for `FnMut`), its type parameters in scope.
pub fn fn_bound_satisfied(bound: i64, t: i64) -> bool {
    unsafe {
        if t == TY_ERROR {
            return true;
        }
        let sig = callable_sig(t);
        if sig == 0 || TYPES[sig].count != NODES[bound].count {
            return false;
        }
        let c = closure_of_type(t);
        if NODES[bound].d == 2 && c != 0 && CLOSURES[c - 1].writes {
            return false;
        }
        let wanted = bound_sig(bound);
        wanted == 0 || wanted == sig || legacy_sig(wanted, sig)
    }
}

// (0.17) Whether a parameter written `*T` (a safe function's borrow, the
// legacy `&mut T`) fits where `&T` or `&mut T` is wanted: a function or
// closure with `*T` parameters satisfies `F: FnMut(&T, &T) -> i64`, the
// reference converting to the pointer.
pub fn legacy_ref_param(wanted: i64, t: i64) -> bool {
    unsafe {
        wanted > 0 && t > 0 && TYPES[wanted].kind == TyKind::Ptr && TYPES[t].kind == TyKind::Ptr
            && TYPES[t].b == 0 && TYPES[wanted].b != 0 && TYPES[wanted].a == TYPES[t].a
    }
}

// Whether fn type sig is wanted's, a `*T` parameter where wanted has a
// reference (legacy_ref_param).
fn legacy_sig(wanted: i64, sig: i64) -> bool {
    unsafe {
        if TYPES[wanted].kind != TyKind::Fn || TYPES[sig].kind != TyKind::Fn
            || TYPES[wanted].count != TYPES[sig].count || TYPES[wanted].a != TYPES[sig].a
            || TYPES[wanted].b != TYPES[sig].b {
            return false;
        }
        for i in 0..TYPES[sig].count {
            let w = type_elem(wanted, i);
            let s = type_elem(sig, i);
            if w != s && !legacy_ref_param(w, s) {
                return false;
            }
        }
        true
    }
}

// The error for a type t that does not satisfy bound `bound` of
// parameter `param` (a name) of generic item `what`, at pos.
pub fn fn_bound_error(bound: i64, t: i64, param: i64, what: i64, pos: i64) -> ! {
    unsafe {
        let c = closure_of_type(t);
        let sig = callable_sig(t);
        let wanted = bound_sig(bound);
        err_begin(pos);
        if c != 0 && NODES[bound].d == 2 && CLOSURES[c - 1].writes
            && (wanted == 0 || wanted == sig) {
            err_str(c"the closure changes '");
            err_sym(LOCALS[CLOSURES[c - 1].write_local].name);
            err_str(c"', so it is not 'Fn' as the bound of '");
            err_sym(param);
            err_str(c"' of '");
            err_sym(what);
            err_str(c"' asks");
            err_help(c"make the bound 'FnMut(...)', or do not change captured variables in the closure (an assignment, an inout method, a `&` argument)");
            err_end();
        }
        err_str(c"the type '");
        err_type(t);
        err_str(c"' does not satisfy the bound '");
        err_sym(param);
        err_str(if NODES[bound].d == 2 { c": Fn" } else { c": FnMut" });
        if wanted != 0 {
            err_str(c"(");
            for i in 0..TYPES[wanted].count {
                if i > 0 {
                    err_str(c", ");
                }
                err_type(type_elem(wanted, i));
            }
            err_str(c") -> ");
            err_type(TYPES[wanted].a);
        } else {
            err_str(c"(...)");
        }
        err_str(c"' of '");
        err_sym(what);
        err_str(c"'");
        if sig == 0 {
            err_help(c"pass a closure or a function");
        }
        err_end()
    }
}

// (0.25.4) The Fn bound a closure argument's parameters are checked
// against (infer_closure_arg sets it, check_closure_sig takes it): the
// bound (a TyFn node) and its type parameter's name; 0 for none.
pub static var CLOSURE_BOUND: i64 = 0;
pub static var CLOSURE_BOUND_NAME: i64 = 0;

// (0.25.4) Whether types a and b are one type taken two ways: a value, a
// let or an inout access of it (`R`, `let R`, `inout R`).
pub fn same_but_convention(a: i64, b: i64) -> bool {
    a > 0 && b > 0 && a != TY_ERROR && b != TY_ERROR && a != b && view_base(a) == view_base(b)
}

fn view_base(t: i64) -> i64 {
    // UNSAFE: TYPES is the checker's table of types, a raw pointer.
    // SAFETY: t is a resolved type (0 < t < TYPE_COUNT), checked by the
    // caller; the table lives while the program is checked.
    unsafe {
        if TYPES[t].kind == TyKind::Ptr && TYPES[t].b != 0 { TYPES[t].a } else { t }
    }
}

// (0.25.4) Where type node tn's text starts with its convention word
// (`sink R`, `inout R`, `let R`: the node is the type, the word before it).
fn conv_start(tn: i64) -> i64 {
    // UNSAFE: NODES is the parser's table of nodes, a raw pointer (front/ast).
    // SAFETY: tn is a type node of the program (0 < tn < NODE_COUNT); SRC
    // is read below its start only, from index 0 up.
    unsafe {
        let s = NODES[tn].start;
        var k = s;
        while k > 0 && (SRC[k - 1] == ' ' || SRC[k - 1] == '\t') {
            k -= 1;
        }
        var w = k;
        while w > 0 && SRC[w - 1] >= 'a' && SRC[w - 1] <= 'z' {
            w -= 1;
        }
        let word = SRC[w..k];
        if word == "sink" || word == "inout" || word == "let" { w } else { s }
    }
}

// (0.25.4) Closure parameter `param` (its index i), whose written type
// node gives it a convention other than the one Fn bound `bound` of type
// parameter `name` gives it (`wanted`): the same type taken another way
// (let, sink, inout). The closure does not satisfy the bound: its caller
// would drop a sink value it still holds, or lend what the closure means
// to keep. The fix writes the bound's way.
pub fn closure_param_conv_error(bound: i64, name: i64, param: i64, i: i64, wanted: i64) -> ! {
    // UNSAFE: NODES and TYPES are the parser's and the checker's tables, raw
    // pointers (front/ast, front/types).
    // SAFETY: bound is a TyFn node with more than i parameters, param a
    // closure's Param node with a type node (its b), wanted a resolved
    // type; the tables live while the program is checked.
    unsafe {
        let bp = child(bound, i);
        let by_sink = (NODES[bp].p & crate::front::ast::CONV_SINK) != 0;
        let by_inout = TYPES[wanted].kind == TyKind::Ptr
            && TYPES[wanted].b == crate::front::types::REF_MUT;
        let fix = buf_new();
        if by_sink {
            buf_bytes(fix, "sink ");
        } else if by_inout {
            buf_bytes(fix, "inout ");
        }
        crate::front::types::buf_type(fix, view_base(wanted));
        let gives = buf_new();
        if !by_sink && !by_inout {
            buf_bytes(gives, "let ");
        }
        buf_bytes(gives, buf_slice(fix));
        let given = buf_new();
        for k in 0..NODES[bound].count {
            if k > 0 {
                buf_bytes(given, ", ");
            }
            let q = child(bound, k);
            buf_bytes(given, SRC[conv_start(q)..NODES[q].end]);
        }
        let tn = NODES[param].b;
        let from = conv_start(tn);
        let kind: [u8] = if NODES[bound].d == 2 { "Fn" } else { "FnMut" };
        err_begin(from);
        err_fmt(
            f"the closure does not satisfy the bound '{SYMS[name].text}: {kind}({buf_slice(given)})': its parameter '{SYMS[NODES[param].a].text}' is '{SRC[from..NODES[tn].end]}', the bound gives '{buf_slice(gives)}'");
        err_help(c"a closure takes each parameter the way its bound gives it (let, inout or sink): write it so, or change the bound");
        err_fix(from, NODES[tn].end, buf_slice(fix));
        err_end()
    }
}

// The Fn or FnMut bound of type parameter k of `params` (0: none).
fn fn_bound_of(params: i64, k: i64) -> i64 {
    let bounds = NODES[child(params, k)].h;
    if bounds == 0 {
        return 0;
    }
    for i in 0..NODES[bounds].count {
        let b = child(bounds, i);
        if NODES[b].kind == NodeKind::TyFn && NODES[b].d >= 2 {
            return b;
        }
    }
    0
}

// Whether argument `arg` is inferred last (infer_from's third pass): a
// closure, whose parameter types come from its parameter's bound.
pub fn is_deferred_arg(arg: i64) -> bool {
    NODES[arg].kind == NodeKind::Closure && NODES[arg].x == 0
}

// infer_from's third pass (and infer_struct_literal's): closure `arg`
// against parameter type node `p` of a template declared in module `tmod`
// (bound[] holds what is inferred so far). Its parameter types (and
// result) come from p's `Fn` bound, as far as they are known; then it
// binds the parameter p names, and what the bound's types name.
pub fn infer_closure_arg(params: i64, bound: *i64, tmod: i64, arg: i64, p: i64) {
    unsafe {
        var fnb = 0;
        if NODES[p].kind == NodeKind::TyName && NODES[p].count == 0 && NODES[p].g == 0 {
            match tparam_index(params, NODES[p].a) {
                Option::Some(k) => fnb = fn_bound_of(params, k),
                Option::None => {}
            }
        }
        let count = NODES[arg].count;
        let mark = TSCRATCH.count;
        var ret = 0;
        if fnb != 0 && NODES[fnb].count != count {
            err_begin(NODES[arg].start);
            err_str(c"this closure takes ");
            err_int(count);
            err_str(if count == 1 { c" parameter, but the bound of '" }
                else { c" parameters, but the bound of '" });
            err_sym(NODES[p].a);
            err_str(c"' takes ");
            err_int(NODES[fnb].count);
            err_end();
        }
        if fnb != 0 {
            // The bound's types, in the template's scope: its parameters
            // bound so far, its module, its `Self`.
            let saved_base = TP_BASE;
            let saved_mod = CUR_MOD;
            let saved_self = SELF_TYPE;
            TP_BASE = TP_NAMES.count;
            for k in 0..NODES[params].count {
                if bound[k] != 0 {
                    TP_NAMES.push(NODES[child(params, k)].a);
                    TP_TYPES.push(bound[k]);
                }
            }
            CUR_MOD = tmod;
            SELF_TYPE = if UNIFY_SELF != 0
                && !mentions_unbound(params, bound, UNIFY_SELF) {
                // (in the impl's module: a trait default copied into an
                // impl elsewhere is checked in the trait's)
                CUR_MOD = module_of(UNIFY_SELF);
                let t = resolve_quietly(UNIFY_SELF);
                CUR_MOD = tmod;
                t
            } else {
                UNIFY_SELF_TY
            };
            for i in 0..count {
                let q = child(fnb, i);
                TSCRATCH.push(if mentions_unbound(params, bound, q) { 0 }
                    else { crate::front::conv::fn_type_param(q, resolve_quietly(q)) });
            }
            if !mentions_unbound(params, bound, NODES[fnb].a) {
                ret = resolve_quietly(NODES[fnb].a);
            }
            env_leave(saved_base);
            CUR_MOD = saved_mod;
            SELF_TYPE = saved_self;
        } else {
            for _ in 0..count {
                TSCRATCH.push(0);
            }
        }
        CLOSURE_BOUND = fnb;
        CLOSURE_BOUND_NAME = NODES[p].a;
        let sig = check_closure_sig(arg, mark, ret);
        CLOSURE_BOUND = 0;
        let t = NODES[arg].ty;
        if !unify(params, bound, tmod, p, t) {
            err_begin(NODES[arg].start);
            err_str(c"mismatched types: this is '");
            err_type(t);
            err_str(c"', which does not fit the type parameters inferred so far");
            err_end();
        }
        if fnb != 0 {
            unify_bound(params, bound, tmod, fnb, sig);
        }
    }
}

// What the types of Fn bound `fnb` name, bound from fn type `sig`.
fn unify_bound(params: i64, bound: *i64, tmod: i64, fnb: i64, sig: i64) {
    unsafe {
        if TYPES[sig].count != NODES[fnb].count {
            return;
        }
        for i in 0..NODES[fnb].count {
            unify(params, bound, tmod, child(fnb, i), type_elem(sig, i));
        }
        unify(params, bound, tmod, NODES[fnb].a, TYPES[sig].a);
    }
}

// After the arguments (infer_from): type parameter k, bound to a closure
// or fn type, binds what its Fn bound's types name (`B` of
// `F: FnMut(A) -> B` when a function is passed for F).
pub fn infer_from_fn_bound(params: i64, bound: *i64, tmod: i64, k: i64) {
    unsafe {
        if bound[k] == 0 {
            return;
        }
        let fnb = fn_bound_of(params, k);
        if fnb == 0 {
            return;
        }
        let sig = callable_sig(bound[k]);
        if sig != 0 {
            unify_bound(params, bound, tmod, fnb, sig);
        }
    }
}
