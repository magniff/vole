// Fn bounds (0.14): whether a closure or a fn type satisfies an
// `F: Fn(..)`/`FnMut(..)` bound, the errors when not, and the types a
// bound gives a closure argument's parameters during inference.

use crate::base::{buf_bytes, buf_new, buf_slice, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_fix, err_fmt, err_help, err_int, err_str, err_sym, errors_forget,
    errors_mark,
};
use crate::front::ast::{NodeKind, child};
use crate::front::check::{Try, attempt};
use crate::front::closures::{check_closure_sig, closure_of_type};
use crate::front::generics::env_leave;
use crate::front::generics::instantiate::{mentions_unbound, tparam_index, unify};
use crate::front::modules::module_of;
use crate::front::types::{TyKind, err_type, make_type, type_elem};

// Type node n resolved, or 0 when it names nothing here (no error).
fn resolve_quietly(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mark = errors_mark(pcx);
    if attempt(Try::Type, n, pcx) {
        return pcx.try_result;
    }
    errors_forget(mark, pcx);
    0
}

// The fn type bound `bound` (a TyFn node) stands for, in the current
// scope of type parameters; 0 when a part of it is unknown.
fn bound_sig(bound: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved = pcx.cur_mod;
    pcx.cur_mod = module_of(bound, pcx);
    let mark = pcx.tscratch.len() as i64;
    let mut known = true;
    for i in 0..pcx.nodes[bound as usize].count {
        // (0.20: `Fn(let T)`, a let parameter: front/conv)
        let t = crate::front::conv::fn_type_param(child(bound, i, pcx),
            resolve_quietly(child(bound, i, pcx), pcx), pcx);
        known = known && t != 0;
        pcx.tscratch.push(t);
    }
    let ret = resolve_quietly(pcx.nodes[bound as usize].a, pcx);
    pcx.cur_mod = saved;
    if !known || ret == 0 {
        pcx.tscratch.truncate(mark as usize);
        return 0;
    }
    // (0.24: as a function's, conv::let_by_ref; not a `sink T`)
    for i in 0..pcx.nodes[bound as usize].count {
        if (pcx.nodes[child(bound, i, pcx) as usize].p & crate::front::ast::CONV_SINK) == 0 {
            (pcx.tscratch[(mark + i) as usize]) = crate::front::conv::let_by_ref(0,
                (pcx.tscratch[(mark + i) as usize]), ret, pcx);
        }
    }
    make_type(TyKind::Fn, ret, 0, mark, pcx)
}

// The fn type of a value of type t a bound can take: a closure's
// signature, or a plain fn type; 0.
fn callable_sig(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let c = closure_of_type(t, pcx);
    if c != 0 {
        return pcx.closures[(c - 1) as usize].sig;
    }
    if t > 0 && pcx.types[t as usize].kind == TyKind::Fn && pcx.types[t as usize].b == 0 {
        return t;
    }
    0
}

// Whether type t satisfies the bound `bound` (a TyFn node, d = 2 for
// `Fn`, 3 for `FnMut`), its type parameters in scope.
pub fn fn_bound_satisfied(bound: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t == pcx.ty_error {
        return true;
    }
    // RULE: F33.1 (the rust edition: `&mut F` is FnMut and FnOnce when F
    // is FnMut, `&F` every kind when F is Fn: `.map(&mut self.f)`)
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != 0
        && closure_of_type(pcx.types[t as usize].a, pcx) != 0 {
        let c = closure_of_type(pcx.types[t as usize].a, pcx);
        let mutable = pcx.types[t as usize].b == crate::front::types::REF_MUT;
        if mutable && pcx.nodes[bound as usize].d == 2
            || !mutable && pcx.closures[(c - 1) as usize].writes {
            return false;
        }
        let need: i64 = if mutable { 3 } else { 2 };
        if pcx.closures[(c - 1) as usize].bound_kind == 0
            || need < pcx.closures[(c - 1) as usize].bound_kind {
            pcx.closures[(c - 1) as usize].bound_kind = need;
            pcx.closures[(c - 1) as usize].bound_node = bound;
        }
        let inner = pcx.closures[(c - 1) as usize].sig;
        if pcx.types[inner as usize].count != pcx.nodes[bound as usize].count {
            return false;
        }
        let wanted = bound_sig(bound, pcx);
        return wanted == 0 || wanted == inner || legacy_sig(wanted, inner, pcx);
    }
    let sig = callable_sig(t, pcx);
    if sig == 0 || pcx.types[sig as usize].count != pcx.nodes[bound as usize].count {
        return false;
    }
    let c = closure_of_type(t, pcx);
    if pcx.nodes[bound as usize].d == 2 && c != 0 && pcx.closures[(c - 1) as usize].writes {
        return false;
    }
    // RULE: D19.6 (whether a closure that moves a capture, `FnOnce`, meets an
    // `Fn`/`FnMut` bound is decided once its kind is: kinds.vl; the
    // strictest bound is kept)
    let d = pcx.nodes[bound as usize].d;
    if c != 0 && d < 4
        && (pcx.closures[(c - 1) as usize].bound_kind == 0
            || d < pcx.closures[(c - 1) as usize].bound_kind) {
        pcx.closures[(c - 1) as usize].bound_kind = d;
        pcx.closures[(c - 1) as usize].bound_node = bound;
    }
    let wanted = bound_sig(bound, pcx);
    wanted == 0 || wanted == sig || legacy_sig(wanted, sig, pcx)
}

// (0.17) Whether a parameter written `*T` (a safe function's borrow, the
// legacy `&mut T`) fits where `&T` or `&mut T` is wanted: a function or
// closure with `*T` parameters satisfies `F: FnMut(&T, &T) -> i64`, the
// reference converting to the pointer.
pub fn legacy_ref_param(wanted: i64, t: i64, pcx: &Ctx<Comp>) -> bool {
    wanted > 0 && t > 0 && pcx.types[wanted as usize].kind == TyKind::Ptr
        && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0
        && pcx.types[wanted as usize].b != 0
        && pcx.types[wanted as usize].a == pcx.types[t as usize].a
}

// Whether fn type sig is wanted's, a `*T` parameter where wanted has a
// reference (legacy_ref_param).
fn legacy_sig(wanted: i64, sig: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.types[wanted as usize].kind != TyKind::Fn || pcx.types[sig as usize].kind != TyKind::Fn
        || pcx.types[wanted as usize].count != pcx.types[sig as usize].count
        || pcx.types[wanted as usize].a != pcx.types[sig as usize].a
        || pcx.types[wanted as usize].b != pcx.types[sig as usize].b {
        return false;
    }
    for i in 0..pcx.types[sig as usize].count {
        let w = type_elem(wanted, i, pcx);
        let s = type_elem(sig, i, pcx);
        if w != s && !legacy_ref_param(w, s, pcx) {
            return false;
        }
    }
    true
}

// The error for a type t that does not satisfy bound `bound` of
// parameter `param` (a name) of generic item `what`, at pos.
pub fn fn_bound_error(bound: i64, t: i64, param: i64, what: i64, pos: i64, pcx: &mut Ctx<Comp>) -> ! {
    let c = closure_of_type(t, pcx);
    let sig = callable_sig(t, pcx);
    let wanted = bound_sig(bound, pcx);
    err_begin(pos, pcx);
    if c != 0 && pcx.nodes[bound as usize].d == 2 && pcx.closures[(c - 1) as usize].writes
        && (wanted == 0 || wanted == sig) {
        err_str(c"the closure changes '", pcx);
        err_sym(pcx.locals[pcx.closures[(c - 1) as usize].write_local as usize].name, pcx);
        err_str(c"', so it is not 'Fn' as the bound of '", pcx);
        err_sym(param, pcx);
        err_str(c"' of '", pcx);
        err_sym(what, pcx);
        err_str(c"' asks", pcx);
        err_help(c"make the bound 'FnMut(...)', or do not change captured variables in the closure (an assignment, a `&mut self` method, a `&mut` argument)", pcx);
        err_end(pcx);
    }
    err_str(c"the type '", pcx);
    err_type(t, pcx);
    err_str(c"' does not satisfy the bound '", pcx);
    err_sym(param, pcx);
    err_str(if pcx.nodes[bound as usize].d == 2 { c": Fn" }
        else if pcx.nodes[bound as usize].d == 4 { c": FnOnce" } else { c": FnMut" }, pcx);
    if wanted != 0 {
        err_str(c"(", pcx);
        for i in 0..pcx.types[wanted as usize].count {
            if i > 0 {
                err_str(c", ", pcx);
            }
            err_type(type_elem(wanted, i, pcx), pcx);
        }
        err_str(c") -> ", pcx);
        err_type(pcx.types[wanted as usize].a, pcx);
    } else {
        err_str(c"(...)", pcx);
    }
    err_str(c"' of '", pcx);
    err_sym(what, pcx);
    err_str(c"'", pcx);
    if sig == 0 {
        err_help(c"pass a closure or a function", pcx);
    }
    err_end(pcx)
}

// (0.25.4) Whether types a and b are one type taken two ways: a value, a
// let or an inout access of it (`R`, `let R`, `inout R`).
pub fn same_but_convention(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    a > 0 && b > 0 && a != pcx.ty_error && b != pcx.ty_error && a != b
        && view_base(a, pcx) == view_base(b, pcx)
}

fn view_base(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind == TyKind::Ptr
        && pcx.types[t as usize].b != 0 { pcx.types[t as usize].a } else { t }
}

// (0.25.4) Where type node tn's text starts with its convention word
// (`sink R`, `inout R`, `let R`: the node is the type, the word before it).
fn conv_start(tn: i64, pcx: &Ctx<Comp>) -> i64 {
    let s = pcx.nodes[tn as usize].start;
    let mut k = s;
    while k > 0 && (get_src()[(k - 1) as usize] == b' ' || get_src()[(k - 1) as usize] == b'\t') {
        k -= 1;
    }
    let mut w = k;
    while w > 0 && get_src()[(w - 1) as usize] >= b'a' && get_src()[(w - 1) as usize] <= b'z' {
        w -= 1;
    }
    let word = &get_src()[w as usize..k as usize];
    if word == b"sink" || word == b"inout" || word == b"let" { w } else { s }
}

// (0.25.4) Closure parameter `param` (its index i), whose written type
// node gives it a convention other than the one Fn bound `bound` of type
// parameter `name` gives it (`wanted`): the same type taken another way
// (let, sink, inout). The closure does not satisfy the bound: its caller
// would drop a sink value it still holds, or lend what the closure means
// to keep. The fix writes the bound's way.
pub fn closure_param_conv_error(bound: i64, name: i64, param: i64, i: i64, wanted: i64,
    pcx: &mut Ctx<Comp>) -> ! {
    let bp = child(bound, i, pcx);
    let by_sink = (pcx.nodes[bp as usize].p & crate::front::ast::CONV_SINK) != 0;
    let by_inout = pcx.types[wanted as usize].kind == TyKind::Ptr
        && pcx.types[wanted as usize].b == crate::front::types::REF_MUT;
    let fix = buf_new();
    if by_sink {
        buf_bytes(fix, b"sink ");
    } else if by_inout {
        buf_bytes(fix, b"inout ");
    }
    crate::front::types::buf_type(fix, view_base(wanted, pcx), pcx);
    let gives = buf_new();
    if !by_sink && !by_inout {
        buf_bytes(gives, b"let ");
    }
    buf_bytes(gives, buf_slice(fix));
    let given = buf_new();
    for k in 0..pcx.nodes[bound as usize].count {
        if k > 0 {
            buf_bytes(given, b", ");
        }
        let q = child(bound, k, pcx);
        buf_bytes(given,
            &get_src()[conv_start(q, pcx) as usize..pcx.nodes[q as usize].end as usize]);
    }
    let tn = pcx.nodes[param as usize].b;
    let from = conv_start(tn, pcx);
    let kind: &[u8] = if pcx.nodes[bound as usize].d == 2 { b"Fn" }
        else if pcx.nodes[bound as usize].d == 4 { b"FnOnce" } else { b"FnMut" };
    err_begin(from, pcx);
    err_fmt(
        { let kind = str::from_utf8(kind).unwrap(); format_args("the closure does not satisfy the bound '{}: {kind}({})': its parameter '{}' is '{}', the bound gives '{}'", str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(buf_slice(given)).unwrap(), str::from_utf8(sym_text(pcx.nodes[param as usize].a, pcx)).unwrap(), &str::from_utf8(get_src()[from as usize..pcx.nodes[tn as usize].end as usize]).unwrap(), str::from_utf8(buf_slice(gives)).unwrap()) }, pcx);
    err_help(c"a closure takes each parameter the way its bound gives it (let, inout or sink): write it so, or change the bound", pcx);
    err_fix(from, pcx.nodes[tn as usize].end, buf_slice(fix), pcx);
    err_end(pcx)
}

// The Fn or FnMut bound of type parameter k of `params` (0: none).
pub fn fn_bound_of(params: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    let bounds = pcx.nodes[child(params, k, pcx) as usize].h;
    if bounds == 0 {
        return 0;
    }
    for i in 0..pcx.nodes[bounds as usize].count {
        let b = child(bounds, i, pcx);
        if pcx.nodes[b as usize].kind == NodeKind::TyFn && pcx.nodes[b as usize].d >= 2 {
            return b;
        }
    }
    0
}

// RULE: D19.5 The call kind of a call of parameter `local` of function f, an
// instance: the least `Fn*` bound (2 `Fn`, 3 `FnMut`, 4 `FnOnce`) of the
// type parameter its template declares the parameter with; 0 when it is
// not one (the closure's own kind is the call's).
pub fn param_call_kind(f: i64, local: i64, pcx: &Ctx<Comp>) -> i64 {
    // (tmpl: the template + 1, 0 for a function that is not an instance)
    let tf = pcx.fns[f as usize].tmpl - 1;
    if tf < 0 || local < 0 {
        return 0;
    }
    let node = pcx.fns[f as usize].node;
    let tnode = pcx.fns[tf as usize].node;
    let g = pcx.nodes[tnode as usize].g;
    if node <= 0 || tnode <= 0 || g <= 0 {
        return 0;
    }
    for i in 0..pcx.nodes[node as usize].count {
        let p = child(node, i, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param || pcx.nodes[p as usize].x != local
            || i >= pcx.nodes[tnode as usize].count {
            continue;
        }
        let tn = pcx.nodes[child(tnode, i, pcx) as usize].b;
        if tn <= 0 || pcx.nodes[tn as usize].kind != NodeKind::TyName
            || pcx.nodes[tn as usize].count != 0
            || pcx.nodes[tn as usize].g != 0 {
            return 0;
        }
        match tparam_index(g, pcx.nodes[tn as usize].a, pcx) {
            Option::Some(k) => {
                let bounds = pcx.nodes[child(g, k, pcx) as usize].h;
                let mut least: i64 = 0;
                for j in 0..(if bounds > 0 { pcx.nodes[bounds as usize].count } else { 0 }) {
                    let b = child(bounds, j, pcx);
                    if pcx.nodes[b as usize].kind == NodeKind::TyFn && pcx.nodes[b as usize].d >= 2
                        && (least == 0 || pcx.nodes[b as usize].d < least) {
                        least = pcx.nodes[b as usize].d;
                    }
                }
                return least;
            }
            Option::None => return 0,
        }
    }
    0
}

// Whether argument `arg` is inferred last (infer_from's third pass): a
// closure, whose parameter types come from its parameter's bound.
pub fn is_deferred_arg(arg: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[arg as usize].kind == NodeKind::Closure && pcx.nodes[arg as usize].x == 0
}

// (0.27.3, infer_from) Whether the closure for parameter type node p can be
// typed now: each parameter type of p's `Fn` bound is known (bound[] holds
// what is inferred so far). RULE: F18.1
pub fn closure_ready(params: i64, bound: *mut i64, p: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[p as usize].kind != NodeKind::TyName || pcx.nodes[p as usize].count != 0
        || pcx.nodes[p as usize].g != 0 {
        return true;
    }
    match tparam_index(params, pcx.nodes[p as usize].a, pcx) {
        Option::Some(k) => {
            let fnb = fn_bound_of(params, k, pcx);
            for i in 0..(if fnb != 0 { pcx.nodes[fnb as usize].count } else { 0 }) {
                if crate::front::generics::instantiate::mentions_unbound(params, bound,
                    child(fnb, i, pcx), pcx) {
                    return false;
                }
            }
            true
        }
        Option::None => true,
    }
}

// infer_from's third pass (and infer_struct_literal's): closure `arg`
// against parameter type node `p` of a template declared in module `tmod`
// (bound[] holds what is inferred so far). Its parameter types (and
// result) come from p's `Fn` bound, as far as they are known; then it
// binds the parameter p names, and what the bound's types name.
pub fn infer_closure_arg(params: i64, bound: *mut i64, tmod: i64, arg: i64, p: i64,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut fnb: i64 = 0;
        if pcx.nodes[p as usize].kind == NodeKind::TyName && pcx.nodes[p as usize].count == 0
            && pcx.nodes[p as usize].g == 0 {
            match tparam_index(params, pcx.nodes[p as usize].a, pcx) {
                Option::Some(k) => fnb = fn_bound_of(params, k, pcx),
                Option::None => {}
            }
        }
        let count = pcx.nodes[arg as usize].count;
        let mark = pcx.tscratch.len() as i64;
        let mut ret: i64 = 0;
        if fnb != 0 && pcx.nodes[fnb as usize].count != count {
            err_begin(pcx.nodes[arg as usize].start, pcx);
            err_str(c"this closure takes ", pcx);
            err_int(count, pcx);
            err_str(if count == 1 { c" parameter, but the bound of '" }
                else { c" parameters, but the bound of '" }, pcx);
            err_sym(pcx.nodes[p as usize].a, pcx);
            err_str(c"' takes ", pcx);
            err_int(pcx.nodes[fnb as usize].count, pcx);
            err_end(pcx);
        }
        if fnb != 0 {
            // The bound's types, in the template's scope: its parameters
            // bound so far, its module, its `Self`.
            let saved_base = pcx.tp_base;
            let saved_mod = pcx.cur_mod;
            let saved_self = pcx.self_type;
            let saved_impl = pcx.self_impl;
            // RULE: F5.4 (0.27.2: `Self::Item` here is the callee's Self's,
            // not the impl being checked's)
            pcx.self_impl = -1;
            pcx.tp_base = pcx.tp_names.len() as i64;
            for k in 0..pcx.nodes[params as usize].count {
                if (*bound.add(k as usize)) != 0 {
                    pcx.tp_names.push(pcx.nodes[child(params, k, pcx) as usize].a);
                    pcx.tp_types.push((*bound.add(k as usize)));
                }
            }
            pcx.cur_mod = tmod;
            pcx.self_type = if pcx.unify_self != 0
                && !mentions_unbound(params, bound, pcx.unify_self, pcx) {
                // (in the impl's module: a trait default copied into an
                // impl elsewhere is checked in the trait's)
                pcx.cur_mod = module_of(pcx.unify_self, pcx);
                let t = resolve_quietly(pcx.unify_self, pcx);
                pcx.cur_mod = tmod;
                t
            } else {
                pcx.unify_self_ty
            };
            for i in 0..count {
                let q = child(fnb, i, pcx);
                let pcx_arg: i64 = if mentions_unbound(params, bound, q, pcx) { 0 }
                    else { crate::front::conv::fn_type_param(q, resolve_quietly(q, pcx), pcx) };
                pcx.tscratch.push(pcx_arg);
            }
            if !mentions_unbound(params, bound, pcx.nodes[fnb as usize].a, pcx) {
                ret = resolve_quietly(pcx.nodes[fnb as usize].a, pcx);
            }
            env_leave(saved_base, pcx);
            pcx.cur_mod = saved_mod;
            pcx.self_type = saved_self;
            pcx.self_impl = saved_impl;
        } else {
            for _ in 0..count {
                pcx.tscratch.push(0);
            }
        }
        pcx.closure_bound = fnb;
        pcx.closure_bound_name = pcx.nodes[p as usize].a;
        let sig = check_closure_sig(arg, mark, ret, pcx);
        pcx.closure_bound = 0;
        // RULE: D20.3 (the bound's types are written in the template's generics)
        if fnb != 0 && pcx.nodes[arg as usize].x > 0 {
            { let at_ix = (pcx.nodes[arg as usize].x - 1) as usize;
                pcx.closures[at_ix].exp_tps = params };
        }
        let t = pcx.nodes[arg as usize].ty;
        if !unify(params, bound, tmod, p, t, pcx) {
            err_begin(pcx.nodes[arg as usize].start, pcx);
            err_str(c"mismatched types: this is '", pcx);
            err_type(t, pcx);
            err_str(c"', which does not fit the type parameters inferred so far", pcx);
            err_end(pcx);
        }
        if fnb != 0 {
            unify_bound(params, bound, tmod, fnb, sig, pcx);
        }
    }
}

// What the types of Fn bound `fnb` name, bound from fn type `sig`.
fn unify_bound(params: i64, bound: *mut i64, tmod: i64, fnb: i64, sig: i64, pcx: &mut Ctx<Comp>) {
    if pcx.types[sig as usize].count != pcx.nodes[fnb as usize].count {
        return;
    }
    for i in 0..pcx.nodes[fnb as usize].count {
        unify(params, bound, tmod, child(fnb, i, pcx), type_elem(sig, i, pcx), pcx);
    }
    unify(params, bound, tmod, pcx.nodes[fnb as usize].a, pcx.types[sig as usize].a, pcx);
}

// After the arguments (infer_from): type parameter k, bound to a closure
// or fn type, binds what its Fn bound's types name (`B` of
// `F: FnMut(A) -> B` when a function is passed for F).
pub fn infer_from_fn_bound(params: i64, bound: *mut i64, tmod: i64, k: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if (*bound.add(k as usize)) == 0 {
            return;
        }
        let fnb = fn_bound_of(params, k, pcx);
        if fnb == 0 {
            return;
        }
        let sig = callable_sig((*bound.add(k as usize)), pcx);
        if sig != 0 {
            unify_bound(params, bound, tmod, fnb, sig, pcx);
        }
    }
}

// (0.27.2) An impl's free type parameter named by the result of
// parameter k's Fn bound, bound to that of the closure or fn type k is:
// Map's B, from `F: FnMut(I::Item) -> B` (traits::impl_bindings). Only a
// bare name: the bound's other types are not resolved here, outside the
// impl's frame; or a generic type's arguments (0.27.2.1: `-> Option<B>`).
// RULE: F14.1
pub fn infer_output_from_fn_bound(params: i64, bound: *mut i64, tmod: i64, k: i64,
    pcx: &mut Ctx<Comp>) {
    // UNSAFE: bound is the caller's raw array of bindings (impl_bindings'
    // alloc_array), read and written through a pointer.
    // SAFETY: k and the index tparam_index gives are < the count of
    // params, the array's length, and it lives until the caller frees it.
    unsafe {
        if (*bound.add(k as usize)) == 0 {
            return;
        }
        let fnb = fn_bound_of(params, k, pcx);
        let sig = callable_sig((*bound.add(k as usize)), pcx);
        if fnb == 0 || sig == 0 {
            return;
        }
        let out = pcx.nodes[fnb as usize].a;
        if out == 0 || pcx.nodes[out as usize].kind != NodeKind::TyName
            || pcx.nodes[out as usize].count != 0 {
            return;
        }
        // (0.27.2.1: a result with arguments, MapWhile's `-> Option<B>`:
        // unified whole, its parameters bound by the closure's result)
        if pcx.nodes[out as usize].g != 0 {
            if tparam_index(params, pcx.nodes[out as usize].a, pcx).is_none() {
                unify(params, bound, tmod, out, pcx.types[sig as usize].a, pcx);
            }
            return;
        }
        match tparam_index(params, pcx.nodes[out as usize].a, pcx) {
            Option::Some(j) => {
                if (*bound.add(j as usize)) == 0 {
                    unify(params, bound, tmod, out, pcx.types[sig as usize].a, pcx);
                }
            }
            Option::None => {}
        }
    }
}
