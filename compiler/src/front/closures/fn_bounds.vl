// Fn bounds (0.14): whether a closure or a fn type satisfies an
// `F: Fn(..)`/`FnMut(..)` bound, the errors when not, and the types a
// bound gives a closure argument's parameters during inference.

use std::Option;

use crate::base::{SRC, buf_bytes, buf_new, buf_slice, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_fix, err_fmt, err_help, err_int, err_str, err_sym, errors_forget,
    errors_mark,
};
use crate::front::ast::{NodeKind, child};
use crate::front::check::{Try, attempt};
use crate::front::closures::{check_closure_sig, closure_of_type};
use crate::front::generics::env_leave;
use crate::front::generics::instantiate::{mentions_unbound, tparam_index, unify};
use crate::front::modules::module_of;
use crate::front::types::{TyKind, err_type, make_type, type_elem};

// Type node n resolved, or 0 when it names nothing here (no error).
fn resolve_quietly(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let mark = errors_mark(pcx);
    if attempt(Try::Type, n, &pcx) {
        return pcx.try_result;
    }
    errors_forget(mark, &pcx);
    0
}

// The fn type bound `bound` (a TyFn node) stands for, in the current
// scope of type parameters; 0 when a part of it is unknown.
fn bound_sig(bound: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let saved = pcx.cur_mod;
        pcx.cur_mod = module_of(bound, &pcx);
        let mark = pcx.tscratch.count;
        var known = true;
        for i in 0..pcx.nodes[bound].count {
            // (0.20: `Fn(let T)`, a let parameter: front/conv)
            let t = crate::front::conv::fn_type_param(child(bound, i, pcx),
                resolve_quietly(child(bound, i, pcx), &pcx), &pcx);
            known = known && t != 0;
            pcx.tscratch.push(t);
        }
        let ret = resolve_quietly(pcx.nodes[bound].a, &pcx);
        pcx.cur_mod = saved;
        if !known || ret == 0 {
            pcx.tscratch.count = mark;
            return 0;
        }
        // (0.24: as a function's, conv::let_by_ref; not a `sink T`)
        for i in 0..pcx.nodes[bound].count {
            if (pcx.nodes[child(bound, i, pcx)].p & crate::front::ast::CONV_SINK) == 0 {
                pcx.tscratch.data[mark + i] = crate::front::conv::let_by_ref(0,
                    pcx.tscratch.data[mark + i], ret, &pcx);
            }
        }
        make_type(TyKind::Fn, ret, 0, mark, &pcx)
    }
}

// The fn type of a value of type t a bound can take: a closure's
// signature, or a plain fn type; 0.
fn callable_sig(t: i64, pcx: Ctx<Comp>) -> i64 {
    let c = closure_of_type(t, pcx);
    if c != 0 {
        return pcx.closures[c - 1].sig;
    }
    if t > 0 && pcx.types[t].kind == TyKind::Fn && pcx.types[t].b == 0 {
        return t;
    }
    0
}

// Whether type t satisfies the bound `bound` (a TyFn node, d = 2 for
// `Fn`, 3 for `FnMut`), its type parameters in scope.
pub fn fn_bound_satisfied(bound: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if t == pcx.ty_error {
        return true;
    }
    let sig = callable_sig(t, pcx);
    if sig == 0 || pcx.types[sig].count != pcx.nodes[bound].count {
        return false;
    }
    let c = closure_of_type(t, pcx);
    if pcx.nodes[bound].d == 2 && c != 0 && pcx.closures[c - 1].writes {
        return false;
    }
    let wanted = bound_sig(bound, &pcx);
    wanted == 0 || wanted == sig || legacy_sig(wanted, sig, pcx)
}

// (0.17) Whether a parameter written `*T` (a safe function's borrow, the
// legacy `&mut T`) fits where `&T` or `&mut T` is wanted: a function or
// closure with `*T` parameters satisfies `F: FnMut(&T, &T) -> i64`, the
// reference converting to the pointer.
pub fn legacy_ref_param(wanted: i64, t: i64, pcx: Ctx<Comp>) -> bool {
    wanted > 0 && t > 0 && pcx.types[wanted].kind == TyKind::Ptr && pcx.types[t].kind == TyKind::Ptr
        && pcx.types[t].b == 0 && pcx.types[wanted].b != 0 && pcx.types[wanted].a == pcx.types[t].a
}

// Whether fn type sig is wanted's, a `*T` parameter where wanted has a
// reference (legacy_ref_param).
fn legacy_sig(wanted: i64, sig: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.types[wanted].kind != TyKind::Fn || pcx.types[sig].kind != TyKind::Fn
        || pcx.types[wanted].count != pcx.types[sig].count
        || pcx.types[wanted].a != pcx.types[sig].a
        || pcx.types[wanted].b != pcx.types[sig].b {
        return false;
    }
    for i in 0..pcx.types[sig].count {
        let w = type_elem(wanted, i, pcx);
        let s = type_elem(sig, i, pcx);
        if w != s && !legacy_ref_param(w, s, pcx) {
            return false;
        }
    }
    true
}

// The error for a type t that does not satisfy bound `bound` of
// parameter `param` (a name) of generic item `what`, at pos.
pub fn fn_bound_error(bound: i64, t: i64, param: i64, what: i64, pos: i64, pcx: inout Ctx<Comp>) -> ! {
    unsafe {
        let c = closure_of_type(t, pcx);
        let sig = callable_sig(t, pcx);
        let wanted = bound_sig(bound, &pcx);
        err_begin(pos, &pcx);
        if c != 0 && pcx.nodes[bound].d == 2 && pcx.closures[c - 1].writes
            && (wanted == 0 || wanted == sig) {
            err_str(c"the closure changes '", pcx);
            err_sym(pcx.locals[pcx.closures[c - 1].write_local].name, pcx);
            err_str(c"', so it is not 'Fn' as the bound of '", pcx);
            err_sym(param, pcx);
            err_str(c"' of '", pcx);
            err_sym(what, pcx);
            err_str(c"' asks", pcx);
            err_help(c"make the bound 'FnMut(...)', or do not change captured variables in the closure (an assignment, an inout method, a `&` argument)", pcx);
            err_end(&pcx);
        }
        err_str(c"the type '", pcx);
        err_type(t, pcx);
        err_str(c"' does not satisfy the bound '", pcx);
        err_sym(param, pcx);
        err_str(if pcx.nodes[bound].d == 2 { c": Fn" } else { c": FnMut" }, pcx);
        if wanted != 0 {
            err_str(c"(", pcx);
            for i in 0..pcx.types[wanted].count {
                if i > 0 {
                    err_str(c", ", pcx);
                }
                err_type(type_elem(wanted, i, pcx), pcx);
            }
            err_str(c") -> ", pcx);
            err_type(pcx.types[wanted].a, pcx);
        } else {
            err_str(c"(...)", pcx);
        }
        err_str(c"' of '", pcx);
        err_sym(what, pcx);
        err_str(c"'", pcx);
        if sig == 0 {
            err_help(c"pass a closure or a function", pcx);
        }
        err_end(&pcx)
    }
}

// (0.25.4) Whether types a and b are one type taken two ways: a value, a
// let or an inout access of it (`R`, `let R`, `inout R`).
pub fn same_but_convention(a: i64, b: i64, pcx: Ctx<Comp>) -> bool {
    a > 0 && b > 0 && a != pcx.ty_error && b != pcx.ty_error && a != b
        && view_base(a, pcx) == view_base(b, pcx)
}

fn view_base(t: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b != 0 { pcx.types[t].a } else { t }
}

// (0.25.4) Where type node tn's text starts with its convention word
// (`sink R`, `inout R`, `let R`: the node is the type, the word before it).
fn conv_start(tn: i64, pcx: Ctx<Comp>) -> i64 {
    let s = pcx.nodes[tn].start;
    var k = s;
    while k > 0 && (SRC[k - 1] == ' ' || SRC[k - 1] == '\t') {
        k -= 1;
    }
    var w = k;
    while w > 0 && SRC[w - 1] >= 'a' && SRC[w - 1] <= 'z' {
        w -= 1;
    }
    let word = SRC[w..k];
    if word == "sink" || word == "inout" || word == "let" { w } else { s }
}

// (0.25.4) Closure parameter `param` (its index i), whose written type
// node gives it a convention other than the one Fn bound `bound` of type
// parameter `name` gives it (`wanted`): the same type taken another way
// (let, sink, inout). The closure does not satisfy the bound: its caller
// would drop a sink value it still holds, or lend what the closure means
// to keep. The fix writes the bound's way.
pub fn closure_param_conv_error(bound: i64, name: i64, param: i64, i: i64, wanted: i64,
    pcx: inout Ctx<Comp>) -> ! {
    let bp = child(bound, i, pcx);
    let by_sink = (pcx.nodes[bp].p & crate::front::ast::CONV_SINK) != 0;
    let by_inout = pcx.types[wanted].kind == TyKind::Ptr
        && pcx.types[wanted].b == crate::front::types::REF_MUT;
    let fix = buf_new();
    if by_sink {
        buf_bytes(fix, "sink ");
    } else if by_inout {
        buf_bytes(fix, "inout ");
    }
    crate::front::types::buf_type(fix, view_base(wanted, pcx), pcx);
    let gives = buf_new();
    if !by_sink && !by_inout {
        buf_bytes(gives, "let ");
    }
    buf_bytes(gives, buf_slice(fix));
    let given = buf_new();
    for k in 0..pcx.nodes[bound].count {
        if k > 0 {
            buf_bytes(given, ", ");
        }
        let q = child(bound, k, pcx);
        buf_bytes(given, SRC[conv_start(q, pcx)..pcx.nodes[q].end]);
    }
    let tn = pcx.nodes[param].b;
    let from = conv_start(tn, pcx);
    let kind: [u8] = if pcx.nodes[bound].d == 2 { "Fn" } else { "FnMut" };
    err_begin(from, &pcx);
    err_fmt(
        format_args("the closure does not satisfy the bound '{}: {kind}({})': its parameter '{}' is '{}', the bound gives '{}'", sym_text(name, pcx), buf_slice(given), sym_text(pcx.nodes[param].a, pcx), SRC[from..pcx.nodes[tn].end], buf_slice(gives)), pcx);
    err_help(c"a closure takes each parameter the way its bound gives it (let, inout or sink): write it so, or change the bound", pcx);
    err_fix(from, pcx.nodes[tn].end, buf_slice(fix), &pcx);
    err_end(&pcx)
}

// The Fn or FnMut bound of type parameter k of `params` (0: none).
fn fn_bound_of(params: i64, k: i64, pcx: Ctx<Comp>) -> i64 {
    let bounds = pcx.nodes[child(params, k, pcx)].h;
    if bounds == 0 {
        return 0;
    }
    for i in 0..pcx.nodes[bounds].count {
        let b = child(bounds, i, pcx);
        if pcx.nodes[b].kind == NodeKind::TyFn && pcx.nodes[b].d >= 2 {
            return b;
        }
    }
    0
}

// Whether argument `arg` is inferred last (infer_from's third pass): a
// closure, whose parameter types come from its parameter's bound.
pub fn is_deferred_arg(arg: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[arg].kind == NodeKind::Closure && pcx.nodes[arg].x == 0
}

// infer_from's third pass (and infer_struct_literal's): closure `arg`
// against parameter type node `p` of a template declared in module `tmod`
// (bound[] holds what is inferred so far). Its parameter types (and
// result) come from p's `Fn` bound, as far as they are known; then it
// binds the parameter p names, and what the bound's types name.
pub fn infer_closure_arg(params: i64, bound: *i64, tmod: i64, arg: i64, p: i64,
    pcx: inout Ctx<Comp>) {
    unsafe {
        var fnb = 0;
        if pcx.nodes[p].kind == NodeKind::TyName && pcx.nodes[p].count == 0 && pcx.nodes[p].g == 0 {
            match tparam_index(params, pcx.nodes[p].a, pcx) {
                Option::Some(k) => fnb = fn_bound_of(params, k, pcx),
                Option::None => {}
            }
        }
        let count = pcx.nodes[arg].count;
        let mark = pcx.tscratch.count;
        var ret = 0;
        if fnb != 0 && pcx.nodes[fnb].count != count {
            err_begin(pcx.nodes[arg].start, &pcx);
            err_str(c"this closure takes ", pcx);
            err_int(count, pcx);
            err_str(if count == 1 { c" parameter, but the bound of '" }
                else { c" parameters, but the bound of '" }, pcx);
            err_sym(pcx.nodes[p].a, pcx);
            err_str(c"' takes ", pcx);
            err_int(pcx.nodes[fnb].count, pcx);
            err_end(&pcx);
        }
        if fnb != 0 {
            // The bound's types, in the template's scope: its parameters
            // bound so far, its module, its `Self`.
            let saved_base = pcx.tp_base;
            let saved_mod = pcx.cur_mod;
            let saved_self = pcx.self_type;
            pcx.tp_base = pcx.tp_names.count;
            for k in 0..pcx.nodes[params].count {
                if bound[k] != 0 {
                    pcx.tp_names.push(pcx.nodes[child(params, k, pcx)].a);
                    pcx.tp_types.push(bound[k]);
                }
            }
            pcx.cur_mod = tmod;
            pcx.self_type = if pcx.unify_self != 0
                && !mentions_unbound(params, bound, pcx.unify_self, pcx) {
                // (in the impl's module: a trait default copied into an
                // impl elsewhere is checked in the trait's)
                pcx.cur_mod = module_of(pcx.unify_self, &pcx);
                let t = resolve_quietly(pcx.unify_self, &pcx);
                pcx.cur_mod = tmod;
                t
            } else {
                pcx.unify_self_ty
            };
            for i in 0..count {
                let q = child(fnb, i, pcx);
                let pcx_arg = if mentions_unbound(params, bound, q, pcx) { 0 }
                    else { crate::front::conv::fn_type_param(q, resolve_quietly(q, &pcx), &pcx) };
                pcx.tscratch.push(pcx_arg);
            }
            if !mentions_unbound(params, bound, pcx.nodes[fnb].a, pcx) {
                ret = resolve_quietly(pcx.nodes[fnb].a, &pcx);
            }
            env_leave(saved_base, &pcx);
            pcx.cur_mod = saved_mod;
            pcx.self_type = saved_self;
        } else {
            for _ in 0..count {
                pcx.tscratch.push(0);
            }
        }
        pcx.closure_bound = fnb;
        pcx.closure_bound_name = pcx.nodes[p].a;
        let sig = check_closure_sig(arg, mark, ret, &pcx);
        pcx.closure_bound = 0;
        let t = pcx.nodes[arg].ty;
        if !unify(params, bound, tmod, p, t, &pcx) {
            err_begin(pcx.nodes[arg].start, &pcx);
            err_str(c"mismatched types: this is '", pcx);
            err_type(t, pcx);
            err_str(c"', which does not fit the type parameters inferred so far", pcx);
            err_end(&pcx);
        }
        if fnb != 0 {
            unify_bound(params, bound, tmod, fnb, sig, &pcx);
        }
    }
}

// What the types of Fn bound `fnb` name, bound from fn type `sig`.
fn unify_bound(params: i64, bound: *i64, tmod: i64, fnb: i64, sig: i64, pcx: inout Ctx<Comp>) {
    if pcx.types[sig].count != pcx.nodes[fnb].count {
        return;
    }
    for i in 0..pcx.nodes[fnb].count {
        unify(params, bound, tmod, child(fnb, i, pcx), type_elem(sig, i, pcx), &pcx);
    }
    unify(params, bound, tmod, pcx.nodes[fnb].a, pcx.types[sig].a, &pcx);
}

// After the arguments (infer_from): type parameter k, bound to a closure
// or fn type, binds what its Fn bound's types name (`B` of
// `F: FnMut(A) -> B` when a function is passed for F).
pub fn infer_from_fn_bound(params: i64, bound: *i64, tmod: i64, k: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if bound[k] == 0 {
            return;
        }
        let fnb = fn_bound_of(params, k, pcx);
        if fnb == 0 {
            return;
        }
        let sig = callable_sig(bound[k], pcx);
        if sig != 0 {
            unify_bound(params, bound, tmod, fnb, sig, &pcx);
        }
    }
}
