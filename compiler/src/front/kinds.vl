// Kinds (0.17, docs/design/value-semantics.md §2.1, §4 step 1): what a
// type's values do when copied. They are computed structurally and
// memoized per type id:
// - plain: numbers, bool, fieldless enums, fn pointers, raw `*T`, and
//   aggregates of plain types; `=` copies the bits;
// - owned (K_OWNED): has a `Drop` impl (std's Vec, Buf, HashMap and Arena
//   count as owned before std implements Drop, T4), or a part that is
//   owned; `=` moves;
// - view (K_VIEW): holds a slice, a reference (`&T`, `&mut T`, `&mut
//   [T]`), a closure capturing by reference, a `#[scoped]` type, or a
//   part that is a view. A type can be owned and a view (`Vec<[u8]>`).
// K_NEEDS_DROP: dropping a value may run code (a Drop impl, std's
// containers, or a part that needs one: every owned type but
// std::cell::UnsafeCell, owned with no drop of its own, 0.26.1, and what
// holds only cells of plain values); K_LEVEL2: the
// type holds views of views (`[[u8]]`, `&Vec<[u8]>`, `[Tok]` with `Tok {
// text: [u8] }`): its origins need both levels (§2.4).
//
// param_mode is the parameter side of §2.3, with the legacy `*T` rule.
//
// Phase 0 contract: the signatures here are fixed; T1-T3 read them.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::STRUCT_SCOPED;
use crate::front::generics::{TPL_NONE, instance_of};
use crate::front::modules::within_std;
use crate::front::traits::{has_impl, std_trait};
use crate::front::types::{
    REF_MUT, REF_SHARED, TyKind, enum_variant, fn_param, struct_field, type_elem,
};

pub const K_PLAIN: i64 = 0;
pub const K_OWNED: i64 = 1;
pub const K_VIEW: i64 = 2;
pub const K_NEEDS_DROP: i64 = 4;
pub const K_LEVEL2: i64 = 8;

fn kind_put(t: i64, v: i64, pcx: &mut Ctx<Comp>) {
    if t >= pcx.kind_arr.len() as i64 {
        pcx.kind_arr.resize((t * 2 + 1024) as usize, 0);
    }
    pcx.kind_arr[t as usize] = v;
}

// Whether struct s (an instance: its template's) is one of std's owning
// containers.
fn owned_base(s: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.kinds_sym_vec == 0 {
        pcx.kinds_sym_vec = intern_c(c"Vec", pcx);
        pcx.sym_buf = intern_c(c"Buf", pcx);
        pcx.kinds_sym_hashmap = intern_c(c"HashMap", pcx);
    }
    let t = if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl - 1 } else { s };
    if !within_std(pcx.structs[t as usize].module, pcx) {
        return false;
    }
    let name = pcx.structs[t as usize].name;
    // (Arena is a handle whose copies share the arena, with no Drop:
    // plain until 0.17.1 makes arena handles references, U3)
    name == pcx.kinds_sym_vec || name == pcx.sym_buf || name == pcx.kinds_sym_hashmap
}

// Whether type t is one of std's owning containers (Vec, Buf, HashMap).
pub fn owned_base_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Struct
        && owned_base(pcx.types[t as usize].a, pcx)
}

// Whether type t has an `impl Drop` (the prelude's trait). The impls of
// Drop are listed once (has_impl scans every impl block, and kinds ask
// for every struct and enum type): a type no listed impl names, or is an
// instance of, has none.
pub fn has_drop_impl(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.drop_trait == -2 {
        pcx.drop_trait = std_trait(c"Drop", pcx);
        pcx.drop_impls.clear();
        for i in 0..pcx.traits_impls.len() as i64 {
            if pcx.traits_impls[i as usize].tr == pcx.drop_trait && pcx.drop_trait >= 0 {
                pcx.drop_impls.push(i);
            }
        }
    }
    if pcx.drop_trait < 0 || t <= 0
        || pcx.types[t as usize].kind != TyKind::Struct
        && pcx.types[t as usize].kind != TyKind::Enum {
        return false;
    }
    let mut named = false;
    for k in 0..pcx.drop_impls.len() as i64 {
        let i = (pcx.drop_impls[k as usize]);
        if pcx.traits_impls[i as usize].ty != 0 && pcx.traits_impls[i as usize].ty == t
            || pcx.traits_impls[i as usize].tpl != TPL_NONE
            && instance_of(t, pcx.traits_impls[i as usize].tpl, pcx) {
            named = true;
        }
    }
    named && has_impl(pcx.drop_trait, t, pcx)
}

// RULE: D9.1 (drop glue reads the impls of Drop) The kinds asked before
// the impls are collected, forgotten: collect_impls calls it last. A
// struct field's `fn(T) -> R` asks T's kind while the structs are
// collected (conv::let_by_ref), when no impl of Drop is known yet; kept,
// that answer said a type with `impl Drop` has no drop glue (a rust
// program on std2 dropped nothing).
pub fn forget_kinds(pcx: &mut Ctx<Comp>) {
    pcx.drop_trait = -2;
    pcx.drop_impls.clear();
    for i in 0..pcx.kind_arr.len() as i64 {
        (pcx.kind_arr[i as usize]) = 0;
    }
}

// The kind bits of type t (K_OWNED, K_VIEW, K_NEEDS_DROP, K_LEVEL2); 0:
// plain.
pub fn type_kind(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if t <= 0 || t == pcx.ty_error {
            return 0;
        }
        if t < pcx.kind_arr.len() as i64 && (pcx.kind_arr[t as usize]) != 0 {
            return (pcx.kind_arr[t as usize]) - 1;
        }
        // (a recursive type through a raw pointer is plain there)
        kind_put(t, 1, pcx);
        let mut k: i64 = 0;
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Slice {
            k = K_VIEW | level2_of(pcx.types[t as usize].a, pcx);
        } else if kind == TyKind::Ptr {
            if pcx.types[t as usize].b != 0 {
                k = K_VIEW | level2_of(pcx.types[t as usize].a, pcx);
            }
        } else if kind == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if owned_base(s, pcx) {
                k = K_OWNED | K_NEEDS_DROP;
                for i in 0..pcx.structs[s as usize].targ_count {
                    k |= type_kind(
                        (pcx.tlists[(pcx.structs[s as usize].targs + i) as usize]), pcx)
                        & (K_VIEW | K_LEVEL2);
                }
            } else {
                // (0.17, T1: a Drop impl owns; its fields may hold views)
                if has_drop_impl(t, pcx) {
                    k = K_OWNED | K_NEEDS_DROP;
                }
                // (0.26.1: std::cell::UnsafeCell is owned, move-only, with no
                // drop of its own; what it holds may need one)
                if crate::front::cells::is_unsafe_cell_struct(s, pcx) {
                    k |= K_OWNED;
                }
                if pcx.structs[s as usize].closure != 0
                    && pcx.closures[(pcx.structs[s as usize].closure - 1) as usize].borrow_depth
                    >= 0 {
                    k |= K_VIEW;
                }
                if (pcx.structs[s as usize].repr & STRUCT_SCOPED) != 0 {
                    k |= K_VIEW;
                }
                let mut raw = false;
                for i in 0..pcx.structs[s as usize].field_count {
                    let ft = (*struct_field(s, i, pcx)).ty;
                    if pcx.structs[s as usize].closure != 0 && ft > 0
                        && pcx.types[ft as usize].kind == TyKind::Ptr {
                        // (a capture by reference)
                        k |= K_VIEW;
                    }
                    if ft > 0 && pcx.types[ft as usize].kind == TyKind::Ptr
                        && pcx.types[ft as usize].b == 0 {
                        raw = true;
                    }
                    k |= type_kind(ft, pcx);
                }
                if raw && pcx.structs[s as usize].closure == 0 && (k & K_OWNED) != 0 {
                    // (0.25) a generic owner that keeps its T values
                    // through raw pointers (a BTreeMap's nodes, a heap's or
                    // a deque's buffer) holds the views they hold
                    for i in 0..pcx.structs[s as usize].targ_count {
                        k |= type_kind(
                            (pcx.tlists[(pcx.structs[s as usize].targs + i) as usize]),
                            pcx)
                            & (K_VIEW | K_LEVEL2);
                    }
                }
            }
        } else if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                k |= type_kind(type_elem(t, i, pcx), pcx);
            }
        } else if kind == TyKind::Array {
            k = type_kind(pcx.types[t as usize].a, pcx);
        } else if kind == TyKind::Distinct {
            // (0.24: a distinct type is its underlying one: `str` and
            // `Path` over `[u8]` are views)
            k = type_kind(pcx.types[t as usize].a, pcx);
        } else if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            if has_drop_impl(t, pcx) {
                k = K_OWNED | K_NEEDS_DROP;
            }
            for i in 0..(pcx.enums[e as usize]).variant_count {
                k |= type_kind(pcx.variants[enum_variant(e, i, pcx) as usize].shape, pcx);
            }
        }
        kind_put(t, k + 1, pcx);
        k
    }
}

// K_LEVEL2 when what a view of `elem` points to holds views.
fn level2_of(elem: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if (type_kind(elem, pcx) & K_VIEW) != 0 { K_LEVEL2 } else { 0 }
}

pub fn is_plain_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    (type_kind(t, pcx) & (K_OWNED | K_VIEW)) == 0
}

pub fn is_owned_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    (type_kind(t, pcx) & K_OWNED) != 0
}

pub fn is_view_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    (type_kind(t, pcx) & K_VIEW) != 0
}

// (0.25) Whether a value of type t holds an inout access, directly or in a
// part: an `inout T` or `inout [T]` (a reference REF_MUT inside), a struct
// with such a field, a closure that changes a capture
// (closures::closure_holds_inout), a tuple, array, enum variant or
// container element (a type argument: `Vec<C>`, `Option<C>`) holding one.
// Such a value is move-only (conventions.md §6.2): `let d = c`, `var p2 =
// p` and a sink argument move it, a later use is own.moved, and it is
// never copyable (conv::copyable).
pub fn holds_inout(t: i64, pcx: &Ctx<Comp>) -> bool {
    holds_inout_rec(t, 0, pcx)
}

fn holds_inout_rec(t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if t <= 0 || t == pcx.ty_error || depth > 8 {
            return false;
        }
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Ptr || kind == TyKind::Slice {
            return pcx.types[t as usize].b == REF_MUT;
        }
        if kind == TyKind::Struct {
            if crate::front::closures::closure_holds_inout(t, pcx) {
                return true;
            }
            let s = pcx.types[t as usize].a;
            for i in 0..pcx.structs[s as usize].field_count {
                if holds_inout_rec((*struct_field(s, i, pcx)).ty, depth + 1, pcx) {
                    return true;
                }
            }
            for i in 0..pcx.structs[s as usize].targ_count {
                if holds_inout_rec(
                    (pcx.tlists[(pcx.structs[s as usize].targs + i) as usize]), depth + 1,
                    pcx) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if holds_inout_rec(type_elem(t, i, pcx), depth + 1, pcx) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Array || kind == TyKind::Distinct {
            return holds_inout_rec(pcx.types[t as usize].a, depth + 1, pcx);
        }
        if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            for i in 0..(pcx.enums[e as usize]).variant_count {
                if holds_inout_rec(pcx.variants[enum_variant(e, i, pcx) as usize].shape, depth + 1,
                    pcx) {
                    return true;
                }
            }
        }
        false
    }
}

// What moves when assigned or passed by value: an owned value, or an
// aggregate holding an inout access (holds_inout: a struct, tuple, enum,
// array, closure or container of one). An access itself (`inout T`,
// `inout [T]`) passed on is a reborrow, not a move.
pub fn is_moved_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if is_owned_type(t, pcx) {
        return true;
    }
    if t <= 0 || pcx.types[t as usize].kind == TyKind::Ptr
        || pcx.types[t as usize].kind == TyKind::Slice {
        return false;
    }
    let m = pcx.inout_memo.get(t + 1);
    if m != 0 {
        return m == 2;
    }
    let v = holds_inout(t, pcx);
    pcx.inout_memo.put(t + 1, if v { 2 } else { 1 });
    v
}

// The element type of the views a value of type t holds (`[E]`: E,
// `Vec<[E]>`: E, `&E`: E, a struct holding only views of E: E); 0: none;
// -1: several, or unknown (a closure). For the type filter (§2.4, T3).
pub fn view_elem(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if t <= 0 || !is_view_type(t, pcx) {
        return 0;
    }
    let known = pcx.elem_memo.get(t + 1);
    if known != 0 {
        return known - 2;
    }
    pcx.elem_memo.put(t + 1, 1);
    let r = view_elem_of(t, pcx);
    pcx.elem_memo.put(t + 1, r + 2);
    r
}

fn view_elem_of(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Slice || k == TyKind::Ptr {
            return pcx.types[t as usize].a;
        }
        let mut r: i64 = 0;
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if pcx.structs[s as usize].closure != 0 {
                return -1;
            }
            if owned_base_type(t, pcx) {
                for i in 0..pcx.structs[s as usize].targ_count {
                    r = join_elem(r,
                        view_elem(
                            (pcx.tlists[(pcx.structs[s as usize].targs + i) as usize]),
                            pcx));
                }
                return r;
            }
            for i in 0..pcx.structs[s as usize].field_count {
                let ft = (*struct_field(s, i, pcx)).ty;
                if ft > 0 && pcx.types[ft as usize].kind == TyKind::Ptr
                    && pcx.types[ft as usize].b == 0 {
                    // (0.25) a raw pointer of a view (an iterator's into a
                    // table's buckets) points to its pointee too
                    r = join_elem(r, pcx.types[ft as usize].a);
                } else {
                    r = join_elem(r, view_elem(ft, pcx));
                }
            }
            return r;
        }
        if k == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                r = join_elem(r, view_elem(type_elem(t, i, pcx), pcx));
            }
            return r;
        }
        if k == TyKind::Array || k == TyKind::Distinct {
            // (0.25: a distinct type, `str`, is its base's)
            return view_elem(pcx.types[t as usize].a, pcx);
        }
        if k == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            for i in 0..(pcx.enums[e as usize]).variant_count {
                r = join_elem(r,
                    view_elem(pcx.variants[enum_variant(e, i, pcx) as usize].shape, pcx));
            }
            return r;
        }
        -1
    }
}

fn join_elem(a: i64, b: i64) -> i64 {
    if a == 0 { b } else if b == 0 || a == b { a } else { -1 }
}

// ---------------------------------------------------------------------------
// Parameters (§2.3, the legacy `*T` rule)

// How a function takes a parameter: by value (a move or a copy), by `&T`,
// by `&mut T`, raw, or a slice view (`[T]`: shared, `&mut [T]`:
// exclusive).
pub const P_VALUE: i64 = 0;
pub const P_SHARED: i64 = 1;
pub const P_MUT: i64 = 2;
pub const P_RAW: i64 = 3;
pub const P_VIEW: i64 = 4;
pub const P_MUT_VIEW: i64 = 5;

// How function f takes its parameter i: by value, a reference, a view, or
// raw (`*T`: since 0.18.1, docs/design/value-semantics.md §7 V4, every
// `*T` parameter is raw, `mut` or not; through 0.18.0 one written without
// `mut` in a safe function was `&mut T`).
pub fn param_mode(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    if f < 0 || i >= pcx.fns[f as usize].param_count {
        return P_VALUE;
    }
    let t = fn_param(f, i, pcx);
    if t <= 0 {
        return P_VALUE;
    }
    let kind = pcx.types[t as usize].kind;
    if kind == TyKind::Slice {
        return if pcx.types[t as usize].b == REF_MUT { P_MUT_VIEW } else { P_VIEW };
    }
    // RULE: F0.1 (0.27.2: the rust edition's `&mut str` and `&str`, as
    // `&mut [u8]` and `&[u8]`)
    if kind == TyKind::Distinct
        && crate::front::distinct::is_view_distinct(t, pcx) {
        return if crate::front::types::is_mut_slice(t, pcx) { P_MUT_VIEW } else { P_VIEW };
    }
    if kind != TyKind::Ptr {
        return P_VALUE;
    }
    if pcx.types[t as usize].b == REF_SHARED {
        return P_SHARED;
    }
    if pcx.types[t as usize].b == REF_MUT { P_MUT } else { P_RAW }
}

// Whether parameter mode m holds a loan on (or a view of) what the
// argument points into.
pub fn mode_borrows(m: i64) -> bool {
    m == P_SHARED || m == P_MUT || m == P_VIEW || m == P_MUT_VIEW
}

// Whether parameter mode m may write what the argument points into.
pub fn mode_writes(m: i64) -> bool {
    m == P_MUT || m == P_MUT_VIEW
}
