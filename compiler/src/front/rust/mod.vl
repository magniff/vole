// (0.27.0) The rust edition (docs/design/rust-surface-plan.md §6): a
// program read with Rust's meanings. It is a mode of the one front, not a
// second front: the lexer, the parser and the checker branch on it where
// the MVS front reports a Rust spelling (conv.rust). A program is in one
// edition; std and the compiler's generated sources stay MVS (rust_at is
// false in them), so a rust-edition program calls today's std through its
// signatures, which are reference-typed already (front/conv param_type).
//
// (0.28.0) It is the one edition: every program is read as it. `--edition
// rust` and a root's `// EDITION: rust` line are accepted and say nothing;
// `--edition mvs` and VOLE_EDITION=mvs are refused.

use crate::base::get_src;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

pub const EDITION_MVS: i64 = 0;
pub const EDITION_RUST: i64 = 1;

// `--edition=rust`: accepted, the one edition. False when arg is not that
// option.
pub fn edition_option(arg: &str, pcx: &mut Ctx<Comp>) -> bool {
    if !arg.starts_with("--edition=") {
        return false;
    }
    set_edition(&arg["--edition=".len()..], pcx);
    true
}

// The value of `--edition`: `rust`, the one edition (accepted and ignored
// until the option goes); `mvs` is gone with 0.28.0.
pub fn set_edition(value: &str, pcx: &mut Ctx<Comp>) {
    if value == "mvs" {
        crate::base::die(c"the MVS edition is gone (0.28.0): there is one edition, Rust's surface (volec guide rust)");
    } else if value != "rust" {
        crate::base::die(c"unknown edition (expected --edition rust)");
    }
    pcx.edition = EDITION_RUST;
}

// At start (main): VOLE_EDITION=mvs is refused as `--edition mvs` is; any
// other value is ignored.
pub fn edition_from_env(pcx: &mut Ctx<Comp>) {
    // UNSAFE: getenv's result is C's string, read byte by byte.
    // SAFETY: a non-null result is NUL-terminated: each byte is read only
    // while the ones before it were not NUL.
    unsafe {
        let v = crate::base::getenv(c"VOLE_EDITION");
        if v != 0 as *mut u8 && (*v.add(0)) == b'm' && (*v.add(1)) == b'v' && (*v.add(2)) == b's'
            && (*v.add(3)) == 0 {
            set_edition("mvs", pcx);
        }
    }
}

// Whether pos is read in the rust edition: the program is, and pos is in
// one of its own files (not std's, not a generated source).
pub fn rust_at(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    // RULE: Z1.2 (and std2's text, when it is the program's std)
    // (user_at leaves pos's file in pcx.cache_file, its one-file cache:
    // no second search, 0.28.0)
    pcx.edition == EDITION_RUST && (crate::front::conv::user_at(pos, pcx)
        || pcx.std_file >= 0 && pcx.cache_file == pcx.std_file)
}

// (0.27.0) error edition.later, soft: SRC[start..end) uses a part of
// Rust's surface the rust edition has from a later release (`feature`, a
// name std270's and the gates' counts use; `release`, 0.27.N): one code,
// so that what is left is counted (`volec check` lists them).
pub fn later(start: i64, end: i64, feature: &str, release: &str, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.later";
    crate::base::diag::err_begin(start, pcx);
    if end > start {
        crate::base::diag::err_fmt(
            format_args("'{}' ({feature}) comes with the rust edition in {release}",
                str::from_utf8(one_line(&get_src()[start as usize..end as usize])).unwrap()),
            pcx);
    } else {
        crate::base::diag::err_fmt(
            format_args("{feature} comes with the rust edition in {release}"), pcx);
    }
    crate::base::diag::err_help(c"0.27.0's rust edition has references, lifetimes and elision, Deref, Index, reborrows, match ergonomics and `impl Trait` arguments: `volec guide edition` says what comes when", pcx);
    crate::base::diag::err_end_soft(pcx);
    pcx.err_kind = saved;
}

// (0.27.0) Source text quoted in a message on one line: a line break and
// the spaces around it are one space (`FilterMap<I,\n    F>`).
fn one_line(text: &[u8]) -> &[u8] {
    let b = crate::base::buf_new();
    let mut space = false;
    for &c in text {
        if c == b'\n' || c == b'\r' || (space && (c == b' ' || c == b'\t')) {
            if !space {
                crate::base::buf_byte(b, b' ');
            }
            space = true;
        } else {
            crate::base::buf_byte(b, c);
            space = c == b' ';
        }
    }
    crate::base::buf_slice(b)
}
