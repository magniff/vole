// (0.27.0) The rust edition (docs/design/rust-surface-plan.md §6): a
// program read with Rust's meanings.
//
// (0.28.0) It is the language: every source is read as it, the
// program's, std's and the ones the compiler writes. (0.29.0) The option
// `--edition` and VOLE_EDITION are gone (main: an unknown option); a
// line `// EDITION: rust` is a comment like any other.

use crate::base::get_src;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

// (0.27.0) error syntax.later, soft: SRC[start..end) uses a part of
// Rust's surface the rust edition has from a later release (`feature`, a
// name std70's and the gates' counts use; `_release`, the release once
// promised, no longer printed: 0.29 came without them): one code,
// so that what is left is counted (`volec check` lists them).
pub fn later(start: i64, end: i64, feature: &str, _release: &str, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"syntax.later";
    crate::base::diag::err_begin(start, pcx);
    if end > start {
        crate::base::diag::err_fmt(
            format_args("'{}' ({feature}) is not in the language yet",
                str::from_utf8(one_line(&get_src()[start as usize..end as usize])).unwrap()),
            pcx);
    } else {
        crate::base::diag::err_fmt(
            format_args("{feature} is not in the language yet"), pcx);
    }
    crate::base::diag::err_help(c"`volec explain syntax.later` says what to write until then; `volec guide rust`: what the language has of Rust's", pcx);
    crate::base::diag::err_end_soft(pcx);
    pcx.err_kind = saved;
}

// (0.27.0) Source text quoted in a message on one line: a line break and
// the spaces around it are one space (`FilterMap<I,\n    F>`).
fn one_line(text: &[u8]) -> &'static [u8] {
    let b = crate::base::buf_new();
    let mut space = false;
    for &c in text {
        if c == b'\n' || c == b'\r' || (space && (c == b' ' || c == b'\t')) {
            if !space {
                crate::base::buf_byte(b, b' ');
            }
            space = true;
        } else {
            crate::base::buf_byte(b, c);
            space = c == b' ';
        }
    }
    crate::base::buf_done(b)
}
