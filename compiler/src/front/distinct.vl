// Distinct types (0.18, docs/design/contracts-verification.md §2.10):
// `type X = distinct T` is a type of its own with T's representation.
//
// A distinct type is a type of kind Distinct: `a` the underlying type T
// (itself maybe distinct), `b` the alias's node, and as its elements the
// type arguments of a generic alias (`Id<Node>` and `Id<Edge>` differ).
// The checker keeps it apart from T; once the program checks,
// erase_types() writes T in its place everywhere the code generators
// look, so that they never see one (`Vec<NodeId>` stays an instance of
// its own, with i64 elements).
//
// The null niche (§2.11): an enum of two variants, one without fields
// and one whose only field is a `#[niche_null]` distinct type (std's
// NonNull<T>), is that one pointer, the variant without fields the null
// one: `Option<NonNull<T>>` is 8 bytes and is C's nullable pointer.

use crate::base::{IntVec, buf_byte, buf_str, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{
    REF_MUT, TyKind, array_of, enum_variant, get_enums, make_type, mut_slice_of, ptr_to, ref_to,
    slice_of, type_elem,
};

// Per enum: 0 not known yet, 1 no niche, 2 the null niche.
static mut NICHE: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };

// The distinct type of alias node `alias` over `base`, with the type
// arguments TSCRATCH[mark..] (popped).
pub fn distinct_type(alias: i64, base: i64, mark: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.any_distinct = true;
    make_type(TyKind::Distinct, base, alias, mark, pcx)
}

pub fn is_distinct_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Distinct
}

// (0.20) Whether t is a distinct type over a slice: std's `str` over
// `[u8]`, the one such type (front/check/distinct: distinct_of), a view.
pub fn is_view_distinct(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Distinct && pcx.types[t as usize].a > 0
        && pcx.types[pcx.types[t as usize].a as usize].kind == TyKind::Slice
}

// (0.20) Forgets what erase_type found: its mode changed.
pub fn reset_erased(pcx: &mut Ctx<Comp>) {
    pcx.erased.clear();
}

// The type under every `distinct` of t (t itself when it is not one).
pub fn strip_distinct(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut u = t;
    while u > 0 && pcx.types[u as usize].kind == TyKind::Distinct {
        u = pcx.types[u as usize].a;
    }
    u
}

// The alias node of distinct type t.
pub fn distinct_alias(t: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.types[t as usize].b
}

// `NodeId`, `Id<Node>`: how messages name distinct type t.
pub fn buf_distinct(out: i64, t: i64, pcx: &Ctx<Comp>) {
    buf_str(out, sym_name(pcx.nodes[pcx.types[t as usize].b as usize].a, pcx));
    if pcx.types[t as usize].count > 0 {
        buf_byte(out, b'<');
        for i in 0..pcx.types[t as usize].count {
            if i > 0 {
                buf_str(out, c", ");
            }
            crate::front::types::buf_type(out, type_elem(t, i, pcx), pcx);
        }
        buf_byte(out, b'>');
    }
}

// Whether alias node `alias` is #[niche_null].
pub fn is_niche_alias(alias: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        for i in 0..pcx.niche_aliases.count {
            if (*pcx.niche_aliases.data.add(i as usize)) == alias {
                return true;
            }
        }
    }
    false
}

// ---- Erasure ----

// t with every distinct type in it replaced by its underlying type.
// Structs and enums are kept (their fields are erased in place).
pub fn erase_type(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if t <= 0 || !pcx.any_distinct {
            return t;
        }
        if t + 1 < pcx.erased.count && (*pcx.erased.data.add((t + 1) as usize)) != 0 {
            return (*pcx.erased.data.add((t + 1) as usize));
        }
        let kind = pcx.types[t as usize].kind;
        let mut r = t;
        if kind == TyKind::Distinct && pcx.erase_views_only && !is_view_distinct(t, pcx) {
            r = t;
        } else if kind == TyKind::Distinct {
            r = erase_type(pcx.types[t as usize].a, pcx);
        } else if kind == TyKind::Ptr {
            // (0.20: a reference stays one, as the own pass reads it)
            let e = erase_type(pcx.types[t as usize].a, pcx);
            r = if e == pcx.types[t as usize].a { t }
                else if pcx.types[t as usize].b != 0 { ref_to(e, pcx.types[t as usize].b, pcx) }
                else { ptr_to(e, pcx) };
        } else if kind == TyKind::Slice {
            let e = erase_type(pcx.types[t as usize].a, pcx);
            r = if e == pcx.types[t as usize].a { t }
                else if pcx.types[t as usize].b == REF_MUT { mut_slice_of(e, pcx) }
                else { slice_of(e, pcx) };
        } else if kind == TyKind::Array {
            r = array_of(erase_type(pcx.types[t as usize].a, pcx), pcx.types[t as usize].b, pcx);
        } else if kind == TyKind::Tuple || kind == TyKind::Fn {
            let count = pcx.types[t as usize].count;
            let mark = pcx.tscratch.count;
            for i in 0..count {
                let e = erase_type(type_elem(t, i, pcx), pcx);
                pcx.tscratch.push(e);
            }
            let a = if kind == TyKind::Fn { erase_type(pcx.types[t as usize].a, pcx) }
                else { pcx.types[t as usize].a };
            r = make_type(kind, a, pcx.types[t as usize].b, mark, pcx);
        }
        while pcx.erased.count <= t + 1 {
            pcx.erased.push(0);
        }
        (*pcx.erased.data.add((t + 1) as usize)) = r;
        r
    }
}

// The list TLISTS[list..list + count] erased: `list` itself when nothing
// in it changes, else a copy at the end of TLISTS (a list may be shared
// with an interned type's elements, which must not change).
pub fn erase_list(list: i64, count: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut changed = false;
        for i in 0..count {
            if erase_type((*pcx.tlists.data.add((list + i) as usize)), pcx)
                != (*pcx.tlists.data.add((list + i) as usize)) {
                changed = true;
            }
        }
        if !changed {
            return list;
        }
        let copy = pcx.tlists.count;
        for i in 0..count {
            let e = erase_type((*pcx.tlists.data.add((list + i) as usize)), pcx);
            pcx.tlists.push(e);
        }
        copy
    }
}

// ---- The null niche ----

// Whether enum e has the null niche (decided from its variants' types
// while they are still distinct, then remembered).
pub fn enum_niche(e: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        while get_niche().count <= e {
            { let mut niche_copy = get_niche(); niche_copy.push(0); set_niche(niche_copy); }
        }
        if (*get_niche().data.add(e as usize)) == 0 {
            (*get_niche().data.add(e as usize)) = if niche_shape(e, pcx) { 2 } else { 1 };
        }
        (*get_niche().data.add(e as usize)) == 2
    }
}

fn niche_shape(e: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !pcx.any_distinct || (*get_enums().add(e as usize)).variant_count != 2
            || (*get_enums().add(e as usize)).repr != 0 {
            return false;
        }
        let v0 = enum_variant(e, 0);
        let v1 = enum_variant(e, 1);
        let (empty, full) = if pcx.variants[v0 as usize].field_count == 0 { (v0, v1) }
            else { (v1, v0) };
        if pcx.variants[empty as usize].field_count != 0
            || pcx.variants[full as usize].field_count != 1 {
            return false;
        }
        let f = (*pcx.tlists.data.add(pcx.variants[full as usize].fields as usize));
        is_distinct_type(f, pcx) && is_niche_alias(pcx.types[f as usize].b, pcx)
            && pcx.types[strip_distinct(f, pcx) as usize].kind == TyKind::Ptr
    }
}

// The variant of niche enum e that holds the pointer.
pub fn niche_full_variant(e: i64, pcx: &Ctx<Comp>) -> i64 {
    let v0 = enum_variant(e, 0);
    if pcx.variants[v0 as usize].field_count == 1 { v0 } else { enum_variant(e, 1) }
}

// Whether variant v is the one that holds the pointer of a niche enum.
pub fn is_niche_full(v: i64, pcx: &Ctx<Comp>) -> bool {
    let e = pcx.variants[v as usize].enum_id;
    enum_niche(e, pcx) && pcx.variants[v as usize].field_count == 1
}

// (0.28.0) NICHE's accessors: every use of it is one of them.
fn get_niche() -> IntVec {
    // UNSAFE: the enum niche memo, a process-wide static mut the tasks
    // read; Rust has no safe access to a static mut
    // SAFETY: enum_niche pushes and writes NICHE.data[e] only while it is
    // short or the entry is 0; prepare_layouts (main thread, before every
    // phase's pool_run and in prepare_tasks) calls enum_niche for every
    // enum below pcx.enum_count, leaving each entry 1 or 2; a task, which
    // cannot add an enum (context let), then only reads
    unsafe { NICHE }
}

fn set_niche(v: IntVec) {
    // UNSAFE: the enum niche memo, a process-wide static mut the tasks
    // read; Rust has no safe access to a static mut
    // SAFETY: enum_niche pushes and writes NICHE.data[e] only while it is
    // short or the entry is 0; prepare_layouts (main thread, before every
    // phase's pool_run and in prepare_tasks) calls enum_niche for every
    // enum below pcx.enum_count, leaving each entry 1 or 2; a task, which
    // cannot add an enum (context let), then only reads
    unsafe {
        NICHE = v;
    }
}
