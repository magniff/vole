// C declarations: declarators (pointers, arrays, functions, nested
// declarators), type names, the constant expressions of declarations
// (enumerators, sizeof, casts), and the external declarations of the
// headers read into the tables (typedefs, functions, variables).

use crate::base::{IntVec, grow, intern_c, streq};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::{
    CFunc, CTypedef, CVar, cty_bad, cty_int, cty_integer, cty_new, cty_ptr, cty_resolve, d_eat,
    d_expect, d_is, d_is_at, d_skip_parens, dcur, dpeek, skip_reason,
};
use crate::front::cimport::CT::{Array, Func, Named};
use crate::front::cimport::ctx::CImportCx;
use crate::front::cimport::layout::{c_align, c_size};
use crate::front::cimport::specifiers::{
    SP_CONST, SP_EXTERN, SP_INLINE, SP_NORETURN, SP_STATIC, SP_THREAD, SP_TYPEDEF, apply_mode,
    attrs_reset, d_attributes, d_collect_until, d_specifiers, d_starts_type, is_qualifier,
    is_storage_word, is_type_keyword, typedef_of,
};
use crate::front::cpp::{
    CK, ORIGIN_FUNC, ORIGIN_TYPEDEF, ORIGIN_VAR, ctok_text, origin_lines, origin_note, strtoull,
};
use crate::front::cpp::eval::{ev_convert, ev_peek, ev_unary, eval_tokens};

// ---- Declarators ----

fn skip_pointer_qualifiers(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        loop {
            let t = dcur(ccx, pcx);
            if t == pcx.c_eof || (pcx.ctoks[t as usize]).kind != CK::Ident {
                return;
            }
            let s = ctok_text(t, pcx);
            if is_qualifier(s) || streq(s, c"_Atomic") {
                ccx.d_pos += 1;
            } else if streq(s, c"__attribute__") || streq(s, c"__attribute") {
                d_attributes(ccx, pcx);
            } else {
                return;
            }
        }
    }
}

// Whether `(` at the cursor opens a nested declarator (not parameters).
fn d_nested_declarator(ccx: &CImportCx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let t = dpeek(1, ccx, pcx);
        if t == pcx.c_eof {
            return false;
        }
        if d_is_at(1, c"*", ccx, pcx) || d_is_at(1, c"(", ccx, pcx) || d_is_at(1, c"^", ccx, pcx)
            || d_is_at(1, c"[", ccx, pcx) {
            return true;
        }
        if (pcx.ctoks[t as usize]).kind != CK::Ident {
            return false;
        }
        let s = ctok_text(t, pcx);
        if streq(s, c"__attribute__") || streq(s, c"__attribute") {
            return true;
        }
        !(is_type_keyword(s) || is_qualifier(s) || is_storage_word(s)
            || typedef_of((pcx.ctoks[t as usize]).text, ccx) >= 0)
    }
}

// A declarator (abstract or not): the name (-1: none) and the type.
pub fn d_declarator(base: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (i64, i64) {
    unsafe {
        let mut ty = base;
        d_attributes(ccx, pcx);
        while d_eat(c"*", ccx, pcx) || d_eat(c"^", ccx, pcx) {
            ty = cty_ptr(ty, ccx);
            let first = ccx.d_pos;
            skip_pointer_qualifiers(ccx, pcx);
            // (0.18: clang's `_Nonnull` makes it std::NonNull: CType b = 1)
            for k in first..ccx.d_pos {
                let tok = (*ccx.d_toks.add(k as usize));
                if (pcx.ctoks[tok as usize]).kind == CK::Ident
                    && streq(ctok_text(tok, pcx), c"_Nonnull") {
                    (ccx.ctypes[ty as usize]).b = 1;
                }
            }
        }
        d_attributes(ccx, pcx);
        if d_is(c"(", ccx, pcx) && d_nested_declarator(ccx, pcx) {
            ccx.d_pos += 1;
            let inner = ccx.d_pos;
            let mut depth: i64 = 1;
            while depth > 0 && ccx.d_pos < ccx.d_n {
                if d_is(c"(", ccx, pcx) {
                    depth += 1;
                } else if d_is(c")", ccx, pcx) {
                    depth -= 1;
                }
                ccx.d_pos += 1;
            }
            let outer_ty = d_suffixes(ty, ccx, pcx);
            let end = ccx.d_pos;
            ccx.d_pos = inner;
            let (name, t) = d_declarator(outer_ty, ccx, pcx);
            d_expect(c")", ccx, pcx);
            ccx.d_pos = end;
            return (name, t);
        }
        let mut name: i64 = -1;
        let t = dcur(ccx, pcx);
        if t != pcx.c_eof && (pcx.ctoks[t as usize]).kind == CK::Ident
            && !is_qualifier(ctok_text(t, pcx)) && !d_is(c"__attribute__", ccx, pcx)
            && !d_is(c"__asm__", ccx, pcx) && !d_is(c"__asm", ccx, pcx)
            && !d_is(c"asm", ccx, pcx) {
            name = (pcx.ctoks[t as usize]).text;
            ccx.d_pos += 1;
        }
        let full = d_suffixes(ty, ccx, pcx);
        if name >= 0 {
            // (after the parameters' declarators)
            ccx.d_name_tok = t;
        }
        (name, full)
    }
}

// Array and function suffixes.
fn d_suffixes(base: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if d_eat(c"[", ccx, pcx) {
        skip_pointer_qualifiers(ccx, pcx);
        d_eat(c"static", ccx, pcx);
        skip_pointer_qualifiers(ccx, pcx);
        let mut len: i64 = -1;
        if !d_is(c"]", ccx, pcx) {
            let at = dcur(ccx, pcx);
            let list = d_collect_until(c"]", c"]", ccx, pcx);
            let (v, _) = eval_tokens(list, at, true, ccx, pcx);
            if pcx.ev_fail {
                d_expect(c"]", ccx, pcx);
                let elem = d_suffixes(base, ccx, pcx);
                let _ = elem;
                return cty_bad(c"an array whose length is not a constant vole can compute",
                    ccx, pcx);
            }
            len = v as i64;
        }
        d_expect(c"]", ccx, pcx);
        let elem = d_suffixes(base, ccx, pcx);
        return cty_new(Array, elem, len, 0, 0, ccx);
    }
    if d_is(c"(", ccx, pcx) {
        ccx.d_pos += 1;
        let saved = (ccx.a_packed, ccx.a_align, ccx.a_mode, ccx.a_link, ccx.a_noreturn,
            ccx.a_unavailable, ccx.a_vector);
        let mut params = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut variadic: i64 = 0;
        if d_is(c"void", ccx, pcx) && d_is_at(1, c")", ccx, pcx) {
            ccx.d_pos += 1;
        }
        while !d_is(c")", ccx, pcx) && ccx.d_pos < ccx.d_n {
            if d_eat(c"...", ccx, pcx) {
                variadic = 1;
                break;
            }
            attrs_reset(ccx);
            let (pbase, _) = d_specifiers(ccx, pcx);
            let (_, pt) = d_declarator(pbase, ccx, pcx);
            d_attributes(ccx, pcx);
            params.push(param_adjust(apply_mode(pt, ccx, pcx), ccx));
            if !d_eat(c",", ccx, pcx) {
                break;
            }
        }
        d_expect(c")", ccx, pcx);
        let (p, a, m, l, nr, u, v) = saved;
        ccx.a_packed = p;
        ccx.a_align = a;
        ccx.a_mode = m;
        ccx.a_link = l;
        ccx.a_noreturn = nr;
        ccx.a_unavailable = u;
        ccx.a_vector = v;
        let start = pcx.cints.len() as i64;
        for i in 0..params.len() as i64 {
            pcx.cints.push((params[i as usize]));
        }
        return cty_new(Func, base, start, params.len() as i64, variadic, ccx);
    }
    base
}

// Parameters of array and function type are pointers.
fn param_adjust(t: i64, ccx: &mut CImportCx<Comp>) -> i64 {
    unsafe {
        let r = cty_resolve(t, ccx);
        if (ccx.ctypes[r as usize]).kind == Array {
            return cty_ptr((ccx.ctypes[r as usize]).a, ccx);
        }
        if (ccx.ctypes[r as usize]).kind == Func {
            return cty_ptr(t, ccx);
        }
        t
    }
}

// A type name (in casts and sizeof): specifiers and an abstract declarator.
fn d_type_name(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let saved = (ccx.a_packed, ccx.a_align, ccx.a_mode, ccx.a_link, ccx.a_noreturn,
        ccx.a_unavailable, ccx.a_vector);
    let (base, _) = d_specifiers(ccx, pcx);
    let (_, t) = d_declarator(base, ccx, pcx);
    let (p, a, m, l, nr, u, v) = saved;
    ccx.a_packed = p;
    ccx.a_align = a;
    ccx.a_mode = m;
    ccx.a_link = l;
    ccx.a_noreturn = nr;
    ccx.a_unavailable = u;
    ccx.a_vector = v;
    t
}

// ---- Constant expressions in declarations ----

// Casts, sizeof and _Alignof, for cpp.vl's evaluator: whether one
// was read, and its value and type.
pub fn cdecl_eval_special(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (bool, u64, i64) {
    unsafe {
        let t = ev_peek(pcx, ccx);
        if t == pcx.c_eof {
            return (false, 0, 0);
        }
        let s = ctok_text(t, pcx);
        let is_sizeof = streq(s, c"sizeof");
        let is_alignof = streq(s, c"_Alignof") || streq(s, c"__alignof__") || streq(s, c"__alignof")
            || streq(s, c"alignof");
        let is_cast = (pcx.ctoks[t as usize]).kind == CK::Punct && streq(s, c"(");
        if !is_sizeof && !is_alignof && !is_cast {
            return (false, 0, 0);
        }
        // The type name is read by the declaration parser, at the
        // evaluator's position.
        let saved = (ccx.d_toks, ccx.d_n, ccx.d_pos, ccx.d_bad);
        ccx.d_toks = ccx.ev_toks;
        ccx.d_n = ccx.ev_n;
        ccx.d_pos = ccx.ev_pos;
        ccx.d_bad = -1;
        let mut ty: i64 = -1;
        if is_cast {
            if d_starts_type(1, ccx, pcx) {
                ccx.d_pos += 1;
                ty = d_type_name(ccx, pcx);
                d_expect(c")", ccx, pcx);
            }
        } else if d_is_at(1, c"(", ccx, pcx) && d_starts_type(2, ccx, pcx) {
            ccx.d_pos += 2;
            ty = d_type_name(ccx, pcx);
            d_expect(c")", ccx, pcx);
        }
        let after = ccx.d_pos;
        let bad = ccx.d_bad >= 0;
        let (d_toks, d_n, d_pos, d_bad) = saved;
        ccx.d_toks = d_toks;
        ccx.d_n = d_n;
        ccx.d_pos = d_pos;
        ccx.d_bad = d_bad;
        if ty < 0 {
            // A parenthesized expression, or sizeof of one.
            return (false, 0, 0);
        }
        ccx.ev_pos = after;
        if bad {
            pcx.ev_fail = true;
            return (true, 0, cty_int(32, signed: true, ccx: ccx));
        }
        if is_cast {
            let (v, _) = ev_unary(ccx, pcx);
            if cty_integer(ty, ccx) == 0 {
                pcx.ev_fail = true;
                return (true, 0, cty_int(32, signed: true, ccx: ccx));
            }
            return (true, ev_convert(v, ty, ccx), ty);
        }
        let v = if is_sizeof { c_size(ty, ccx, pcx) } else { c_align(ty, ccx, pcx) };
        if v < 0 {
            pcx.ev_fail = true;
        }
        (true, v as u64, cty_int(64, signed: false, ccx: ccx))
    }
}

// An identifier's value in a constant expression: an enumerator.
pub fn cdecl_ident_value(sym: i64, ccx: &CImportCx<Comp>) -> (bool, u64, i64) {
    let e = ccx.enumerator_of.get(sym + 1) - 1;
    if e < 0 {
        return (false, 0, 0);
    }
    (true, ccx.cenumerators[e as usize].value as u64, enumerator_type(e, ccx))
}

// C's type of an enumerator: int when its value fits, else the enum's.
pub fn enumerator_type(e: i64, ccx: &CImportCx<Comp>) -> i64 {
    unsafe {
        let v = ccx.cenumerators[e as usize].value;
        if v >= -2147483648 && v <= 2147483647 {
            return cty_int(32, signed: true, ccx: ccx);
        }
        (*ccx.cenums.add(ccx.cenumerators[e as usize].ty as usize)).underlying
    }
}

// ---- #pragma pack ----

pub fn d_pack_markers(ccx: &mut CImportCx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        while d_is(c"__vole_pack", ccx, pcx) {
            ccx.d_pos += 1;
            let mut end = 0 as *mut u8;
            ccx.d_pack = strtoull(ctok_text(dcur(ccx, pcx), pcx), &mut end, 10) as i64;
            ccx.d_pos += 1;
        }
    }
}

// ---- Reading the declarations ----

// Reads every external declaration of the token list.
pub fn cdecl_parse(toks: IntVec, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    ccx.d_toks = toks.data;
    ccx.d_n = toks.len() as i64;
    ccx.d_pos = 0;
    while ccx.d_pos < ccx.d_n {
        d_pack_markers(ccx, pcx);
        if ccx.d_pos >= ccx.d_n {
            break;
        }
        if d_eat(c";", ccx, pcx) {
            continue;
        }
        if d_is(c"_Static_assert", ccx, pcx) || d_is(c"static_assert", ccx, pcx)
            || d_is(c"__asm__", ccx, pcx)
            || d_is(c"__asm", ccx, pcx) || d_is(c"asm", ccx, pcx) {
            ccx.d_pos += 1;
            d_skip_parens(ccx, pcx);
            d_eat(c";", ccx, pcx);
            continue;
        }
        let start = ccx.d_pos;
        let saved_n = ccx.d_n;
        let places = pcx.c_origins.len() as i64 / 3;
        ccx.d_name_tok = -1;
        ccx.d_bad = -1;
        attrs_reset(ccx);
        let first_name = d_declaration(ccx, pcx);
        if ccx.d_bad >= 0 {
            // Skip what remains of it: to `;` at depth 0, or past a body.
            ccx.d_n = saved_n;
            ccx.d_pos = start;
            skip_reason(first_name, ccx.d_bad, pcx);
            skip_declaration(ccx, pcx);
        }
        // (0.25.2) the lines of the declaration's names
        origin_lines(places, toks, start, ccx.d_pos, pcx);
    }
}

fn skip_declaration(ccx: &mut CImportCx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let mut depth: i64 = 0;
        while ccx.d_pos < ccx.d_n {
            if d_is(c"(", ccx, pcx) || d_is(c"[", ccx, pcx) {
                depth += 1;
            } else if d_is(c")", ccx, pcx) || d_is(c"]", ccx, pcx) {
                depth -= 1;
            } else if d_is(c"{", ccx, pcx) {
                // A record's body, or a function's.
                let mut braces: i64 = 0;
                loop {
                    if d_is(c"{", ccx, pcx) {
                        braces += 1;
                    } else if d_is(c"}", ccx, pcx) {
                        braces -= 1;
                        if braces == 0 {
                            break;
                        }
                    }
                    ccx.d_pos += 1;
                    if ccx.d_pos >= ccx.d_n {
                        return;
                    }
                }
                ccx.d_pos += 1;
                if depth == 0 && ccx.d_pos < ccx.d_n && !d_is(c";", ccx, pcx)
                    && !d_is(c",", ccx, pcx) && !d_is(c"__attribute__", ccx, pcx)
                    && (pcx.ctoks[dcur(ccx, pcx) as usize]).kind != CK::Ident
                    && !d_is(c"*", ccx, pcx)
                    && !d_is(c"[", ccx, pcx) {
                    return;
                }
                continue;
            } else if d_is(c";", ccx, pcx) && depth == 0 {
                ccx.d_pos += 1;
                return;
            }
            ccx.d_pos += 1;
        }
    }
}

// One declaration; returns its first declared name (-1: none).
fn d_declaration(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let (base, flags) = d_specifiers(ccx, pcx);
        if ccx.d_bad >= 0 {
            return -1;
        }
        if d_eat(c";", ccx, pcx) {
            return -1;
        }
        let mut first: i64 = -1;
        loop {
            let decl_attrs = (ccx.a_align, ccx.a_mode, ccx.a_link, ccx.a_noreturn,
                ccx.a_unavailable, ccx.a_vector);
            let (name, raw_ty) = d_declarator(base, ccx, pcx);
            d_attributes(ccx, pcx);
            if ccx.d_bad >= 0 {
                return if first >= 0 { first } else { name };
            }
            if first < 0 {
                first = name;
            }
            let ty = apply_mode(raw_ty, ccx, pcx);
            let r = cty_resolve(ty, ccx);
            let is_func = (ccx.ctypes[r as usize]).kind == Func
                && (ccx.ctypes[ty as usize]).kind != Named;
            if name >= 0 {
                if (flags & SP_TYPEDEF) != 0 {
                    add_typedef(name, ty, ccx.a_align, ccx, pcx);
                } else if (ccx.ctypes[r as usize]).kind == Func {
                    if d_is(c"{", ccx, pcx) {
                        // A definition: imported when it has an external one.
                        skip_body(ccx, pcx);
                        if (flags & SP_STATIC) != 0
                            || ((flags & SP_INLINE) != 0 && (flags & SP_EXTERN) == 0) {
                            skip_reason(name,
                                intern_c(c"it is defined in the header (static or inline)", pcx),
                                pcx);
                        } else {
                            add_function(name, ty, flags, ccx, pcx);
                        }
                        return first;
                    }
                    if (flags & SP_STATIC) != 0 {
                        skip_reason(name, intern_c(c"it is static", pcx), pcx);
                    } else {
                        add_function(name, ty, flags, ccx, pcx);
                    }
                } else if (flags & SP_THREAD) != 0 {
                    skip_reason(name, intern_c(c"it is thread-local", pcx), pcx);
                } else if (flags & SP_EXTERN) != 0 {
                    add_variable(name, ty, flags, ccx, pcx);
                } else {
                    skip_reason(name, intern_c(c"it is defined in the header", pcx), pcx);
                }
            }
            let _ = is_func;
            let (a, m, l, nr, u, v) = decl_attrs;
            ccx.a_align = a;
            ccx.a_mode = m;
            ccx.a_link = l;
            ccx.a_noreturn = nr;
            ccx.a_unavailable = u;
            ccx.a_vector = v;
            if d_eat(c"=", ccx, pcx) {
                d_collect_until(c",", c";", ccx, pcx);
            }
            if !d_eat(c",", ccx, pcx) {
                break;
            }
        }
        d_expect(c";", ccx, pcx);
        first
    }
}

fn skip_body(ccx: &mut CImportCx<Comp>, pcx: &Ctx<Comp>) {
    let mut depth: i64 = 0;
    while ccx.d_pos < ccx.d_n {
        if d_is(c"{", ccx, pcx) {
            depth += 1;
        } else if d_is(c"}", ccx, pcx) {
            depth -= 1;
            if depth == 0 {
                ccx.d_pos += 1;
                return;
            }
        }
        ccx.d_pos += 1;
    }
}

fn add_typedef(name: i64, ty: i64, align: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if typedef_of(name, ccx) >= 0 {
        return;
    }
    unsafe {
        ccx.ctypedefs = grow(ccx.ctypedefs, ccx.ctypedef_count, &mut ccx.ctypedef_cap);
        { let at_ix = ccx.ctypedef_count as usize;
            (*ccx.ctypedefs.add(at_ix)) = CTypedef { name, ty, tname: -1, align_attr: align } };
    }
    ccx.typedef_of.put(name + 1, ccx.ctypedef_count + 1);
    origin_note(ORIGIN_TYPEDEF, name, ccx.d_name_tok, 0, 0, replace: false, ccx: ccx, pcx: pcx);
    ccx.ctypedef_count += 1;
}

fn add_function(name: i64, ty: i64, flags: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if ccx.func_of.get(name + 1) != 0 || ccx.var_of.get(name + 1) != 0 {
        return;
    }
    if ccx.a_unavailable {
        skip_reason(name, intern_c(c"it is marked unavailable", pcx), pcx);
        return;
    }
    let noreturn = (flags & SP_NORETURN) != 0 || ccx.a_noreturn;
    ccx.cfuncs.push(CFunc { name, ty, link: ccx.a_link, noreturn: noreturn as i64 });
    ccx.func_of.put(name + 1, ccx.cfuncs.len() as i64);
    origin_note(ORIGIN_FUNC, name, ccx.d_name_tok, 0, 0, replace: false, ccx: ccx, pcx: pcx);
}

fn add_variable(name: i64, ty: i64, flags: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if ccx.func_of.get(name + 1) != 0 || ccx.var_of.get(name + 1) != 0 {
        return;
    }
    ccx.cvars.push(CVar {
        name, ty, link: ccx.a_link, is_const: ((flags & SP_CONST) != 0) as i64,
    });
    ccx.var_of.put(name + 1, ccx.cvars.len() as i64);
    origin_note(ORIGIN_VAR, name, ccx.d_name_tok, 0, 0, replace: false, ccx: ccx, pcx: pcx);
}
