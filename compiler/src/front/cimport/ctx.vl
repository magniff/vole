// (0.26.4, statics P3) The C import's state, made by import_c_headers and passed
// down as `ccx` (tools/statics/front-cimport.group): what were its statics,
// the comment above a field naming the static it was.

use std::alloc::Allocator;

use crate::base::comp::Comp;
use crate::front::cimport::{CEnum, CEnumerator, CField, CFunc, CRec, CType, CTypedef, CVar};
use crate::front::cpp::HsNode;
use crate::middle::lower::ssa::HMap;

pub struct CImportCx<A: Allocator> {
    // (front::cpp::eval::EV_TOKS, 0.26.5)
    pub ev_toks: Vec<i64, A>,
    // (front::cpp::eval::EV_N)
    pub ev_n: i64,
    // (front::cpp::eval::EV_POS)
    pub ev_pos: i64,
    // (front::cpp::DEFINING_BUILTINS)
    pub defining_builtins: bool,
    // (front::cpp::HS)
    pub hs: Vec<HsNode, A>,
    // Symbol + 1 -> macro + 1 (0: not defined).
    // (front::cpp::MACRO_OF)
    pub macro_of: HMap,
    // key + 1 -> origin + 1, the key: index * 16 + kind
    // (front::cpp::ORIGIN_OF)
    pub origin_of: HMap,
    // (front::cpp::S_COMMA)
    pub s_comma: i64,
    // (front::cpp::S_COUNTER)
    pub s_counter: i64,
    // (front::cpp::S_DEFINED)
    pub s_defined: i64,
    // (front::cpp::S_ELLIPSIS)
    pub s_ellipsis: i64,
    // (front::cpp::S_FILE)
    pub s_file: i64,
    // (front::cpp::S_GT)
    pub s_gt: i64,
    // (front::cpp::S_HASH)
    pub s_hash: i64,
    // (front::cpp::S_HASHHASH)
    pub s_hashhash: i64,
    // (front::cpp::S_HAS_INCLUDE)
    pub s_has_include: i64,
    // (front::cpp::S_HAS_INCLUDE_NEXT)
    pub s_has_include_next: i64,
    // (front::cpp::S_LINE)
    pub s_line: i64,
    // (front::cpp::S_LT)
    pub s_lt: i64,
    // (front::cpp::S_ONE)
    pub s_one: i64,
    // (front::cpp::S_PRAGMA_OP)
    pub s_pragma_op: i64,
    // (front::cpp::S_VA_ARGS)
    pub s_va_args: i64,
    // (front::cpp::S_ZERO)
    pub s_zero: i64,
    // (front::cpp::directives::CPP_ONCE)
    pub cpp_once: HMap,
    // (front::cpp::directives::PACK_NOW)
    pub pack_now: i64,
    // #pragma pack: (n), (), (push), (push, n), (pop), (push, name, n). The
    // packing in force is passed to the declarations as the tokens
    // `__vole_pack <n>` (0: none).
    // (front::cpp::directives::PACK_STACK)
    pub pack_stack: Vec<i64, A>,
    // (front::cpp::eval::EV_AT)
    pub ev_at: i64,
    // (front::cpp::eval::EV_DECL)
    pub ev_decl: bool,
    // (front::cpp::expand::CPP_COUNTER)
    pub cpp_counter: i64,
    // Conditional inclusion: per open #if, COND_TAKEN (in the branch being
    // read), COND_SEARCH (no branch taken yet), COND_DONE (a branch was taken).
    // (front::cpp::input::CPP_CONDS)
    pub cpp_conds: Vec<i64, A>,
    // Expanding a list on its own (macro arguments, #if lines): the end of
    // CPP_PENDING is the end of the input.
    // (front::cpp::input::CPP_LIST_MODE)
    pub cpp_list_mode: bool,
    // Tokens to read before the file's: the next one last.
    // (front::cpp::input::CPP_PENDING)
    pub cpp_pending: Vec<i64, A>,
    // (front::cpp::input::FRAME_COND)
    pub frame_cond: Vec<i64, A>,
    // (front::cpp::input::FRAME_FILE)
    pub frame_file: Vec<i64, A>,
    // (front::cpp::input::FRAME_POS)
    pub frame_pos: Vec<i64, A>,
    // (front::cimport::CENUMERATORS)
    pub cenumerators: Vec<CEnumerator, A>,
    // (front::cimport::CENUMS)
    pub cenums: Vec<CEnum, A>,
    // (front::cimport::CFIELDS)
    pub cfields: Vec<CField, A>,
    // (front::cimport::CFUNCS)
    pub cfuncs: Vec<CFunc, A>,
    // (front::cimport::CRECS)
    pub crecs: Vec<CRec, A>,
    // (front::cimport::CTYPEDEFS)
    pub ctypedefs: Vec<CTypedef, A>,
    // (front::cimport::CTYPES)
    pub ctypes: Vec<CType, A>,
    // (front::cimport::CTY_BOOL)
    pub cty_bool: i64,
    // (front::cimport::CTY_F32)
    pub cty_f32: i64,
    // (front::cimport::CTY_F64)
    pub cty_f64: i64,
    // (front::cimport::CTY_INTS)
    pub cty_ints: [i64; 16],
    // (front::cimport::CTY_VOID)
    pub cty_void: i64,
    // (front::cimport::CVARS)
    pub cvars: Vec<CVar, A>,
    // The declaration being read cannot be: the reason (a symbol), or -1.
    // (front::cimport::D_BAD)
    pub d_bad: i64,
    // (front::cimport::D_N)
    pub d_n: i64,
    // (0.25.2) The token of the name the last declarator read (-1: none).
    // (front::cimport::D_NAME_TOK)
    pub d_name_tok: i64,
    // (front::cimport::D_POS)
    pub d_pos: i64,
    // (front::cimport::D_TOKS)
    pub d_toks: Vec<i64, A>,
    // (front::cimport::ENUMERATOR_OF)
    pub enumerator_of: HMap,
    // (front::cimport::FUNC_OF)
    pub func_of: HMap,
    // C's namespaces (symbol + 1 -> index + 1): tags, typedefs, functions and
    // variables, enumerators.
    // (front::cimport::TAG_OF)
    pub tag_of: HMap,
    // (front::cimport::TYPEDEF_OF)
    pub typedef_of: HMap,
    // (front::cimport::VAR_OF)
    pub var_of: HMap,
    // The packing in force (#pragma pack), from the `__vole_pack <n>`
    // tokens of the preprocessor.
    // (front::cimport::decls::D_PACK)
    pub d_pack: i64,
    // Macros naming a variable or a function: (macro, name) pairs.
    // (front::cimport::emit::ALIASES)
    pub aliases: Vec<i64, A>,
    // (front::cimport::emit::C_TARGET_ELF)
    pub c_target_elf: bool,
    // Values emitted as declarations (symbol + 1 -> 1).
    // (front::cimport::emit::EMITTED_VALUE)
    pub emitted_value: HMap,
    // (front::cimport::emit::OUTB)
    pub outb: i64,
    // Vole names taken: types, values (symbol + 1 -> 1).
    // (front::cimport::emit::USED_TYPE)
    pub used_type: HMap,
    // (front::cimport::emit::USED_VALUE)
    pub used_value: HMap,
    // (front::cimport::specifiers::A_ALIGN)
    pub a_align: i64,
    // (front::cimport::specifiers::A_LINK)
    pub a_link: i64,
    // (front::cimport::specifiers::A_MODE)
    pub a_mode: i64,
    // (front::cimport::specifiers::A_NORETURN)
    pub a_noreturn: bool,
    // What `__attribute__((...))` and `__asm__("...")` said about the
    // declaration being read.
    // (front::cimport::specifiers::A_PACKED)
    pub a_packed: bool,
    // (front::cimport::specifiers::A_UNAVAILABLE)
    pub a_unavailable: bool,
    // (front::cimport::specifiers::A_VECTOR)
    pub a_vector: bool,
    // (front::cimport::specifiers::C_LONG_DOUBLE_64)
    pub c_long_double_64: bool,
    // (front::cimport::specifiers::C_TARGET_A64_LINUX)
    pub c_target_a64_linux: bool,
    // (front::cimport::specifiers::C_TARGET_X86)
    pub c_target_x86: bool,
    // (front::cimport::specifiers::C_VA_LIST)
    pub c_va_list: i64,
}

// A new context: every field at its static's first value.
pub fn cimport_cx_new() -> CImportCx<Comp> {
    CImportCx {
        ev_toks: Vec::new_in(Comp {}),
        ev_n: 0,
        ev_pos: 0,
        defining_builtins: false,
        hs: Vec::new_in(Comp {}),
        macro_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        origin_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        s_comma: 0,
        s_counter: 0,
        s_defined: 0,
        s_ellipsis: 0,
        s_file: 0,
        s_gt: 0,
        s_hash: 0,
        s_hashhash: 0,
        s_has_include: 0,
        s_has_include_next: 0,
        s_line: 0,
        s_lt: 0,
        s_one: 0,
        s_pragma_op: 0,
        s_va_args: 0,
        s_zero: 0,
        cpp_once: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        pack_now: 0,
        pack_stack: Vec::new_in(Comp {}),
        ev_at: 0,
        ev_decl: false,
        cpp_counter: 0,
        cpp_conds: Vec::new_in(Comp {}),
        cpp_list_mode: false,
        cpp_pending: Vec::new_in(Comp {}),
        frame_cond: Vec::new_in(Comp {}),
        frame_file: Vec::new_in(Comp {}),
        frame_pos: Vec::new_in(Comp {}),
        cenumerators: Vec::new_in(Comp {}),
        cenums: Vec::new_in(Comp {}),
        cfields: Vec::new_in(Comp {}),
        cfuncs: Vec::new_in(Comp {}),
        crecs: Vec::new_in(Comp {}),
        ctypedefs: Vec::new_in(Comp {}),
        ctypes: Vec::new_in(Comp {}),
        cty_bool: 0,
        cty_f32: 0,
        cty_f64: 0,
        cty_ints: [0i64; 16],
        cty_void: 0,
        cvars: Vec::new_in(Comp {}),
        d_bad: -1,
        d_n: 0,
        d_name_tok: -1,
        d_pos: 0,
        d_toks: Vec::new_in(Comp {}),
        enumerator_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        func_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        tag_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        typedef_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        var_of: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        d_pack: 0,
        aliases: Vec::new_in(Comp {}),
        c_target_elf: false,
        emitted_value: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        outb: 0,
        used_type: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        used_value: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        a_align: 0,
        a_link: -1,
        a_mode: 0,
        a_noreturn: false,
        a_packed: false,
        a_unavailable: false,
        a_vector: false,
        c_long_double_64: false,
        c_target_a64_linux: false,
        c_target_x86: false,
        c_va_list: 0,
    }
}
