// Writing the imported declarations as vole: names for C's types,
// `#[repr(C)]` structs and unions with explicit padding, type aliases,
// constants for enumerators and macros, and the `extern "C"` block of
// functions and variables, with link names and aliases.

use crate::base::{
    IntVec, alloc_zeroed, buf_byte, buf_bytes, buf_fmt, buf_int, buf_new, buf_slice, buf_str,
    buf_uint, intern, intern_c, streq, strlen, strtod, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::{cfield, cty_integer, cty_resolve, cty_signed, skip_reason};
use crate::front::cimport::CT::{Array, Bad, Bool, Enum, Float, Func, Int, Named, Ptr, Record, Void};
use crate::front::cimport::ctx::CImportCx;
use crate::front::cimport::decls::enumerator_type;
use crate::front::cimport::layout::{c_align, c_size, c_value_problem, crec_layout};
use crate::front::cimport::specifiers::typedef_of;
use crate::front::cpp::{
    CK, ORIGIN_ENUM, ORIGIN_ENUMERATOR, ORIGIN_FIELD, ORIGIN_FUNC, ORIGIN_MACRO, ORIGIN_RECORD,
    ORIGIN_TYPEDEF, ORIGIN_VAR, ctok_copy, ctok_is, ctok_text, macro_of, macro_tok, origin_of,
    snprintf, strtof,
};
use crate::front::cpp::eval::{ev_convert, eval_tokens};
use crate::front::cpp::expand::expand_list;
use crate::front::lexer::{Tok, keyword_of_sym};
use crate::front::types::align_to;

// ---- Writing vole ----

fn out(s: *mut u8, ccx: &CImportCx<Comp>) {
    buf_str(ccx.outb, s);
}

fn out_int(v: i64, ccx: &CImportCx<Comp>) {
    buf_int(ccx.outb, v);
}

// A C identifier as a vole name: keywords as raw identifiers.
fn out_name(sym: i64, ccx: &CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let k = keyword_of_sym(sym, pcx);
    if k != Tok::Eof || sym == intern_c(c"self", pcx) || sym == intern_c(c"Self", pcx)
        || sym == intern_c(c"_", pcx) {
        out(c"r#", ccx);
    }
    buf_bytes(ccx.outb, sym_text(sym, pcx));
}

fn is_primitive_name(sym: i64, pcx: &mut Ctx<Comp>) -> bool {
    let names: [*mut u8; 14] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64",
        c"f32", c"f64", c"bool", c"isize", c"usize", c"Self"];
    for i in 0..14 {
        if sym == intern_c(names[i as usize], pcx) {
            return true;
        }
    }
    false
}

// Claims a type name; false when taken.
fn claim_type(sym: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if ccx.used_type.get(sym + 1) != 0 || is_primitive_name(sym, pcx) {
        return false;
    }
    ccx.used_type.put(sym + 1, 1);
    true
}

fn prefixed(prefix: *mut u8, sym: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = buf_new();
    buf_str(b, prefix);
    buf_bytes(b, sym_text(sym, pcx));
    intern(buf_slice(b), pcx)
}

// The vole spelling of C type t (a value's type; void is not one).
fn out_type(t: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let k = (ccx.ctypes[t as usize]).kind;
        match k {
            Int => {
                out(if (ccx.ctypes[t as usize]).b != 0 { c"i" } else { c"u" }, ccx);
                out_int((ccx.ctypes[t as usize]).a, ccx);
            }
            Bool => out(c"bool", ccx),
            Float => out(if (ccx.ctypes[t as usize]).a == 32 { c"f32" } else { c"f64" }, ccx),
            Void => out(c"u8", ccx),
            Ptr => {
                let p = cty_resolve((ccx.ctypes[t as usize]).a, ccx);
                let pk = (ccx.ctypes[p as usize]).kind;
                if pk == Func {
                    if (ccx.ctypes[p as usize]).d != 0 || c_fn_problem(p, ccx, pcx) >= 0 {
                        out(c"*u8", ccx);
                    } else {
                        out_fn_type(p, ccx, pcx);
                    }
                } else if (ccx.ctypes[t as usize]).b != 0 {
                    // (0.18: `_Nonnull`)
                    out(c"std::NonNull<", ccx);
                    if pk == Void || pk == Bad {
                        out(c"u8", ccx);
                    } else {
                        out_type((ccx.ctypes[t as usize]).a, ccx, pcx);
                    }
                    out(c">", ccx);
                } else if pk == Void || pk == Bad {
                    out(c"*u8", ccx);
                } else {
                    out(c"*", ccx);
                    out_type((ccx.ctypes[t as usize]).a, ccx, pcx);
                }
            }
            Array => {
                out(c"[", ccx);
                out_type((ccx.ctypes[t as usize]).a, ccx, pcx);
                out(c"; ", ccx);
                out_int(if (ccx.ctypes[t as usize]).b < 0 { 0 }
                    else { (ccx.ctypes[t as usize]).b }, ccx);
                out(c"]", ccx);
            }
            Record => out_name((ccx.crecs[(ccx.ctypes[t as usize]).a as usize]).name, ccx,
                pcx),
            Enum => {
                let e = (ccx.ctypes[t as usize]).a;
                if (ccx.cenums[e as usize]).name >= 0 {
                    out_name((ccx.cenums[e as usize]).name, ccx, pcx);
                } else {
                    out_type((ccx.cenums[e as usize]).underlying, ccx, pcx);
                }
            }
            Named => {
                let td = (ccx.ctypes[t as usize]).a;
                if (ccx.ctypedefs[td as usize]).tname >= 0 {
                    out_name((ccx.ctypedefs[td as usize]).tname, ccx, pcx);
                } else {
                    out_type((ccx.ctypedefs[td as usize]).ty, ccx, pcx);
                }
            }
            Func => out_fn_type(t, ccx, pcx),
            Bad => out(c"u8", ccx),
        }
    }
}

fn out_fn_type(f: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        out(c"extern \"C\" fn(", ccx);
        for i in 0..(ccx.ctypes[f as usize]).c {
            if i > 0 {
                out(c", ", ccx);
            }
            out_type((pcx.cints[((ccx.ctypes[f as usize]).b + i) as usize]), ccx,
                pcx);
        }
        out(c")", ccx);
        let ret = cty_resolve((ccx.ctypes[f as usize]).a, ccx);
        if (ccx.ctypes[ret as usize]).kind != Void {
            out(c" -> ", ccx);
            out_type((ccx.ctypes[f as usize]).a, ccx, pcx);
        }
    }
}

// Why function type f cannot be imported, or -1.
fn c_fn_problem(f: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        for i in 0..(ccx.ctypes[f as usize]).c {
            let p = c_value_problem(
                (pcx.cints[((ccx.ctypes[f as usize]).b + i) as usize]), ccx, pcx);
            if p >= 0 {
                return p;
            }
        }
        let ret = cty_resolve((ccx.ctypes[f as usize]).a, ccx);
        if (ccx.ctypes[ret as usize]).kind == Void {
            return -1;
        }
        if (ccx.ctypes[ret as usize]).kind == Array {
            return intern_c(c"it returns an array", pcx);
        }
        c_value_problem((ccx.ctypes[f as usize]).a, ccx, pcx)
    }
}

// Names for the records, enums and typedefs (C's tag and ordinary
// namespaces share vole's type namespace).
fn assign_type_names(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        // Anonymous records and enums take the name of their first typedef.
        for i in 0..ccx.ctypedefs.len() as i64 {
            let t = (ccx.ctypedefs[i as usize]).ty;
            if (ccx.ctypes[t as usize]).kind == Record {
                let r = (ccx.ctypes[t as usize]).a;
                // (Not a typedef that raises the alignment: GCC keeps the
                // size, which no vole type can do.)
                let raises = (ccx.ctypedefs[i as usize]).align_attr > 0
                    && (ccx.ctypedefs[i as usize]).align_attr > c_align(t, ccx, pcx);
                if (ccx.crecs[r as usize]).tag < 0 && (ccx.crecs[r as usize]).name < 0
                    && (ccx.crecs[r as usize]).parent < 0 && !raises
                    && claim_type((ccx.ctypedefs[i as usize]).name, ccx, pcx) {
                    (ccx.crecs[r as usize]).name = (ccx.ctypedefs[i as usize]).name;
                    (ccx.ctypedefs[i as usize]).tname = -2;
                }
            } else if (ccx.ctypes[t as usize]).kind == Enum {
                let e = (ccx.ctypes[t as usize]).a;
                if (ccx.cenums[e as usize]).tag < 0 && (ccx.cenums[e as usize]).name < 0
                    && claim_type((ccx.ctypedefs[i as usize]).name, ccx, pcx) {
                    (ccx.cenums[e as usize]).name = (ccx.ctypedefs[i as usize]).name;
                    (ccx.ctypedefs[i as usize]).tname = -2;
                }
            }
        }
        // Typedefs other than `typedef struct x x;`.
        for i in 0..ccx.ctypedefs.len() as i64 {
            if (ccx.ctypedefs[i as usize]).tname == -2 {
                continue;
            }
            let t = (ccx.ctypedefs[i as usize]).ty;
            let name = (ccx.ctypedefs[i as usize]).name;
            let r = cty_resolve(t, ccx);
            if (ccx.ctypes[r as usize]).kind == Func
                || (ccx.ctypes[r as usize]).kind == Bad
                || (ccx.ctypes[r as usize]).kind == Void {
                continue;
            }
            if (ccx.ctypes[t as usize]).kind == Record
                && (ccx.crecs[(ccx.ctypes[t as usize]).a as usize]).tag == name {
                continue;
            }
            if (ccx.ctypes[t as usize]).kind == Enum
                && (ccx.cenums[(ccx.ctypes[t as usize]).a as usize]).tag == name {
                continue;
            }
            // A typedef that raises its type's alignment is another type,
            // which a vole alias is not.
            if (ccx.ctypedefs[i as usize]).align_attr > 0
                && (ccx.ctypedefs[i as usize]).align_attr > c_align(t, ccx, pcx) {
                skip_reason(name, intern_c(c"its typedef raises the alignment", pcx), pcx);
                continue;
            }
            if claim_type(name, ccx, pcx) {
                (ccx.ctypedefs[i as usize]).tname = name;
            }
        }
        for r in 0..ccx.crecs.len() as i64 {
            if (ccx.crecs[r as usize]).name >= 0 {
                continue;
            }
            if (ccx.crecs[r as usize]).tag >= 0 {
                if claim_type((ccx.crecs[r as usize]).tag, ccx, pcx) {
                    (ccx.crecs[r as usize]).name = (ccx.crecs[r as usize]).tag;
                } else {
                    (ccx.crecs[r as usize]).name = prefixed(
                        if (ccx.crecs[r as usize]).is_union != 0 { c"union_" }
                        else { c"struct_" }, (ccx.crecs[r as usize]).tag, pcx);
                    claim_type((ccx.crecs[r as usize]).name, ccx, pcx);
                }
            }
        }
        // Anonymous records: after their parent, `<parent>_anon<k>`; others
        // `anon_<k>`.
        let mut k: i64 = 0;
        for r in 0..ccx.crecs.len() as i64 {
            if (ccx.crecs[r as usize]).name < 0 {
                let b = buf_new();
                if (ccx.crecs[r as usize]).parent >= 0
                    && (ccx.crecs[(ccx.crecs[r as usize]).parent as usize]).name >= 0 {
                    buf_fmt(b,
                        format_args("{}_anon",
                            str::from_utf8(
                                sym_text(
                                    (ccx.crecs[(ccx.crecs[r as usize]).parent as usize]).name,
                                    pcx)).unwrap()));
                } else {
                    buf_str(b, c"anon_");
                }
                buf_int(b, k);
                k += 1;
                (ccx.crecs[r as usize]).name = intern(buf_slice(b), pcx);
                claim_type((ccx.crecs[r as usize]).name, ccx, pcx);
            }
        }
        for e in 0..ccx.cenums.len() as i64 {
            if (ccx.cenums[e as usize]).name < 0 && (ccx.cenums[e as usize]).tag >= 0 {
                if claim_type((ccx.cenums[e as usize]).tag, ccx, pcx) {
                    (ccx.cenums[e as usize]).name = (ccx.cenums[e as usize]).tag;
                } else {
                    (ccx.cenums[e as usize]).name = prefixed(c"enum_",
                        (ccx.cenums[e as usize]).tag, pcx);
                    claim_type((ccx.cenums[e as usize]).name, ccx, pcx);
                }
            }
        }
    }
}

// A member name not used by a field of r: `base<k>`.
fn member_name(r: i64, base: *mut u8, k: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let b = buf_new();
    buf_str(b, base);
    buf_int(b, k);
    let mut sym = intern(buf_slice(b), pcx);
    loop {
        let clash = unsafe {
            (0i64..(ccx.crecs[r as usize]).field_count).any(|i| (ccx.cfields[cfield(r, i, ccx,
                pcx)]).name
                == sym)
        };
        if !clash {
            return sym;
        }
        buf_byte(b, b'_');
        sym = intern(buf_slice(b), pcx);
    }
}

fn out_member(name: i64, size: i64, ccx: &CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    emit_mark(0, 0, ccx, pcx);
    out(c"    ", ccx);
    out_name(name, ccx, pcx);
    out(c": [u8; ", ccx);
    out_int(size, ccx);
    out(c"],\n", ccx);
}

fn emit_record(r: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        crec_layout(r, ccx, pcx);
        emit_mark(ORIGIN_RECORD, r, ccx, pcx);
        // The C spelling, when there is one.
        if (ccx.crecs[r as usize]).tag >= 0
            && (ccx.crecs[r as usize]).tag != intern_c(c"__va_list_tag", pcx)
            && (ccx.crecs[r as usize]).tag != intern_c(c"__va_list", pcx) {
            out(if (ccx.crecs[r as usize]).is_union != 0 { c"// C: union " }
                else { c"// C: struct " }, ccx);
            buf_bytes(ccx.outb, sym_text((ccx.crecs[r as usize]).tag, pcx));
            out(c"\n", ccx);
        }
        else if (ccx.crecs[r as usize]).parent < 0 && (ccx.crecs[r as usize]).name >= 0
            && typedef_of((ccx.crecs[r as usize]).name, ccx) >= 0 {
            out(c"// C: ", ccx);
            buf_bytes(ccx.outb, sym_text((ccx.crecs[r as usize]).name, pcx));
            out(c"\n", ccx);
        }
        if (ccx.crecs[r as usize]).opaque >= 0 {
            // Usable through pointers only.
            out(c"// ", ccx);
            buf_bytes(ccx.outb, sym_text((ccx.crecs[r as usize]).name, pcx));
            out(c": opaque, ", ccx);
            buf_bytes(ccx.outb, sym_text((ccx.crecs[r as usize]).opaque, pcx));
            out(c"\nstruct ", ccx);
            out_name((ccx.crecs[r as usize]).name, ccx, pcx);
            out(c" {}\n", ccx);
            return;
        }
        // (a C record is copied as C copies it; a union is without the derive)
        if (ccx.crecs[r as usize]).is_union == 0 {
            out(c"#[derive(Clone, Copy)]\n", ccx);
        }
        out(c"#[repr(C", ccx);
        if (ccx.crecs[r as usize]).emit_packed != 0 {
            out(c", packed", ccx);
            if (ccx.crecs[r as usize]).emit_packed > 1 {
                out(c"(", ccx);
                out_int((ccx.crecs[r as usize]).emit_packed, ccx);
                out(c")", ccx);
            }
        }
        if (ccx.crecs[r as usize]).emit_align != 0 {
            out(c", align(", ccx);
            out_int((ccx.crecs[r as usize]).emit_align, ccx);
            out(c")", ccx);
        }
        out(c")]\n", ccx);
        let is_union = (ccx.crecs[r as usize]).is_union != 0;
        out(if is_union { c"union " } else { c"struct " }, ccx);
        out_name((ccx.crecs[r as usize]).name, ccx, pcx);
        out(c" {\n", ccx);
        let mut at: i64 = 0;
        let mut pads: i64 = 0;
        let mut anons: i64 = 0;
        let mut bitfields: i64 = 0;
        let n = (ccx.crecs[r as usize]).field_count;
        let mut i: i64 = 0;
        while i < n {
            let f = cfield(r, i, ccx, pcx);
            if ccx.cfields[f].bits >= 0 {
                if is_union {
                    if ccx.cfields[f].bits > 0 {
                        out_member(member_name(r, c"_bitfield", bitfields, ccx, pcx),
                            (ccx.cfields[f].bits + 7) / 8, ccx, pcx);
                        bitfields += 1;
                    }
                    i += 1;
                    continue;
                }
                // A run of bit-fields: their bytes.
                let first_bit = ccx.cfields[f].bit_offset;
                let mut end_bit = first_bit;
                while i < n && (ccx.cfields[cfield(r, i, ccx, pcx)]).bits >= 0 {
                    let g = cfield(r, i, ccx, pcx);
                    let e = ccx.cfields[g].bit_offset + ccx.cfields[g].bits;
                    end_bit = if e > end_bit { e } else { end_bit };
                    i += 1;
                }
                let lo = first_bit / 8;
                let hi = (end_bit + 7) / 8;
                if hi > lo {
                    if lo > at {
                        out_member(member_name(r, c"_pad", pads, ccx, pcx), lo - at, ccx, pcx);
                        pads += 1;
                    }
                    let start = if lo > at { lo } else { at };
                    out_member(member_name(r, c"_bitfield", bitfields, ccx, pcx), hi - start, ccx,
                        pcx);
                    bitfields += 1;
                    at = hi;
                }
                continue;
            }
            // Padding only where vole's own placement would differ.
            let mut ma = c_align(ccx.cfields[f].ty, ccx, pcx);
            if (ccx.crecs[r as usize]).emit_packed != 0
                && ma > (ccx.crecs[r as usize]).emit_packed {
                ma = (ccx.crecs[r as usize]).emit_packed;
            }
            if !is_union && ccx.cfields[f].offset > align_to(at, ma) {
                out_member(member_name(r, c"_pad", pads, ccx, pcx), ccx.cfields[f].offset - at, ccx,
                    pcx);
                pads += 1;
            }
            emit_mark(ORIGIN_FIELD, pcx.cints[((ccx.crecs[r as usize]).fields + i) as usize], ccx,
                pcx);
            out(c"    ", ccx);
            if ccx.cfields[f].name >= 0 {
                out_name(ccx.cfields[f].name, ccx, pcx);
            } else {
                out_name(member_name(r, c"_anon", anons, ccx, pcx), ccx, pcx);
                anons += 1;
            }
            out(c": ", ccx);
            out_type(ccx.cfields[f].ty, ccx, pcx);
            out(c",\n", ccx);
            if !is_union {
                at = ccx.cfields[f].offset + c_size(ccx.cfields[f].ty, ccx, pcx);
            }
            i += 1;
        }
        // Tail padding beyond what alignment gives.
        let align = if (ccx.crecs[r as usize]).emit_packed
            != 0 { (ccx.crecs[r as usize]).emit_packed }
            else { (ccx.crecs[r as usize]).align };
        if is_union {
            let mut largest: i64 = 0;
            for j in 0..n {
                let f = cfield(r, j, ccx, pcx);
                let s = if ccx.cfields[f].bits >= 0 { (ccx.cfields[f].bits + 7) / 8 }
                    else { c_size(ccx.cfields[f].ty, ccx, pcx) };
                largest = if s > largest { s } else { largest };
            }
            if align_to(largest, align) < (ccx.crecs[r as usize]).size {
                out_member(member_name(r, c"_pad", pads, ccx, pcx),
                    (ccx.crecs[r as usize]).size, ccx, pcx);
            }
        } else if align_to(at, align) < (ccx.crecs[r as usize]).size {
            out_member(member_name(r, c"_pad", pads, ccx, pcx),
                (ccx.crecs[r as usize]).size - at, ccx, pcx);
        }
        out(c"}\n", ccx);
    }
}

// The vole type of an integer constant of C type t.
fn out_const_type(t: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let r = cty_resolve(t, ccx);
    if unsafe {
        (ccx.ctypes[t as usize]).kind == Named
            && (ccx.ctypedefs[(ccx.ctypes[t as usize]).a as usize]).tname >= 0
            && (ccx.ctypes[r as usize]).kind == Int
    } {
        out_type(t, ccx, pcx);
        return;
    }
    out_type(cty_integer(t, ccx), ccx, pcx);
}

fn out_value(v: u64, t: i64, ccx: &CImportCx<Comp>) {
    if cty_signed(t, ccx) {
        out_int(v as i64, ccx);
    } else {
        buf_uint(ccx.outb, v);
    }
}

fn claim_value(sym: i64, ccx: &mut CImportCx<Comp>) -> bool {
    if ccx.used_value.get(sym + 1) != 0 {
        return false;
    }
    ccx.used_value.put(sym + 1, 1);
    true
}

// (0.25.2) The item written next is declaration (kind, index)'s (kind
// 0: no declaration's), for the language server: C_EMIT_AT.
fn emit_mark(kind: i64, index: i64, ccx: &CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if !pcx.c_keep_origins {
        return;
    }
    pcx.c_emit_at.push(buf_slice(ccx.outb).len() as i64);
    pcx.c_emit_at.push(if kind == 0 { -1 } else { origin_of(kind, index, ccx) });
}

// Writes the imported declarations as vole source to buffer `b`.
pub fn cimport_emit(b: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        ccx.outb = b;
        assign_type_names(ccx, pcx);
        for r in 0..ccx.crecs.len() as i64 {
            emit_record(r, ccx, pcx);
        }
        for i in 0..ccx.ctypedefs.len() as i64 {
            if (ccx.ctypedefs[i as usize]).tname >= 0 {
                let problem = c_value_problem((ccx.ctypedefs[i as usize]).ty, ccx, pcx);
                let r = cty_resolve((ccx.ctypedefs[i as usize]).ty, ccx);
                if problem >= 0 && !((ccx.ctypes[r as usize]).kind == Record) {
                    skip_reason((ccx.ctypedefs[i as usize]).name, problem, pcx);
                    continue;
                }
                emit_mark(ORIGIN_TYPEDEF, (ccx.ctypedefs[i as usize]).name, ccx, pcx);
                out(c"type ", ccx);
                out_name((ccx.ctypedefs[i as usize]).tname, ccx, pcx);
                out(c" = ", ccx);
                out_type((ccx.ctypedefs[i as usize]).ty, ccx, pcx);
                out(c";\n", ccx);
            }
        }
        for e in 0..ccx.cenums.len() as i64 {
            if (ccx.cenums[e as usize]).name >= 0 {
                emit_mark(ORIGIN_ENUM, e, ccx, pcx);
                out(c"type ", ccx);
                out_name((ccx.cenums[e as usize]).name, ccx, pcx);
                out(c" = ", ccx);
                out_type((ccx.cenums[e as usize]).underlying, ccx, pcx);
                out(c";\n", ccx);
            }
        }
        emit_mark(0, 0, ccx, pcx);
        out(c"extern \"C\" {\n", ccx);
        for i in 0..ccx.cfuncs.len() as i64 {
            let f = cty_resolve(ccx.cfuncs[i as usize].ty, ccx);
            let problem = c_fn_problem(f, ccx, pcx);
            if problem >= 0 {
                skip_reason(ccx.cfuncs[i as usize].name, problem, pcx);
                continue;
            }
            if !claim_value(ccx.cfuncs[i as usize].name, ccx) {
                continue;
            }
            ccx.emitted_value.put(ccx.cfuncs[i as usize].name + 1, 1);
            emit_mark(ORIGIN_FUNC, ccx.cfuncs[i as usize].name, ccx, pcx);
            out_link_name(ccx.cfuncs[i as usize].link, ccx.cfuncs[i as usize].name, ccx, pcx);
            out_function(i, ccx.cfuncs[i as usize].name, ccx, pcx);
        }
        for i in 0..ccx.cvars.len() {
            let problem = c_value_problem(ccx.cvars[i].ty, ccx, pcx);
            let r = cty_resolve(ccx.cvars[i].ty, ccx);
            if problem >= 0
                || ((ccx.ctypes[r as usize]).kind == Array
                    && (ccx.ctypes[r as usize]).b < 0) {
                skip_reason(ccx.cvars[i].name,
                    if problem >= 0 { problem }
                    else { intern_c(c"an array of unknown size", pcx) },
                    pcx);
                continue;
            }
            if !claim_value(ccx.cvars[i].name, ccx) {
                continue;
            }
            ccx.emitted_value.put(ccx.cvars[i].name + 1, 1);
            emit_mark(ORIGIN_VAR, ccx.cvars[i].name, ccx, pcx);
            out_link_name(ccx.cvars[i].link, ccx.cvars[i].name, ccx, pcx);
            out(if ccx.cvars[i].is_const != 0 { c"    static " } else { c"    static mut " }, ccx);
            out_name(ccx.cvars[i].name, ccx, pcx);
            out(c": ", ccx);
            out_type(ccx.cvars[i].ty, ccx, pcx);
            out(c";\n", ccx);
        }
        out(c"}\n", ccx);
        for i in 0..ccx.cenumerators.len() as i64 {
            let name = ccx.cenumerators[i as usize].name;
            if ccx.enumerator_of.get(name + 1) != i + 1 || !claim_value(name, ccx) {
                continue;
            }
            let e = ccx.cenumerators[i as usize].ty;
            emit_mark(ORIGIN_ENUMERATOR, i, ccx, pcx);
            out(c"const ", ccx);
            out_name(name, ccx, pcx);
            out(c": ", ccx);
            let t = if (ccx.cenums[e as usize]).name >= 0 { (ccx.cenums[e as usize]).ty }
                else { enumerator_type(i, ccx) };
            out_type(t, ccx, pcx);
            out(c" = ", ccx);
            out_value(ccx.cenumerators[i as usize].value as u64, t, ccx);
            out(c";\n", ccx);
        }
        emit_macro_constants(ccx, pcx);
        emit_aliases(ccx, pcx);
    }
}

// The declaration of C function f under `name`.
fn out_function(i: i64, name: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let f = cty_resolve(ccx.cfuncs[i as usize].ty, ccx);
        out(c"    fn ", ccx);
        out_name(name, ccx, pcx);
        out(c"(", ccx);
        for k in 0..(ccx.ctypes[f as usize]).c {
            if k > 0 {
                out(c", ", ccx);
            }
            out(c"p", ccx);
            out_int(k, ccx);
            out(c": ", ccx);
            out_type((pcx.cints[((ccx.ctypes[f as usize]).b + k) as usize]), ccx,
                pcx);
        }
        if (ccx.ctypes[f as usize]).d != 0 {
            out(if (ccx.ctypes[f as usize]).c > 0 { c", ..." } else { c"..." }, ccx);
        }
        out(c")", ccx);
        let ret = cty_resolve((ccx.ctypes[f as usize]).a, ccx);
        if (ccx.ctypes[ret as usize]).kind == Void {
            if ccx.cfuncs[i as usize].noreturn != 0 {
                out(c" -> !", ccx);
            }
        } else {
            out(c" -> ", ccx);
            out_type((ccx.ctypes[f as usize]).a, ccx, pcx);
        }
        out(c";\n", ccx);
    }
}

// `#[link_name]` when an asm label renames the symbol. Labels are
// assembler names: on Mach-O, C's names have a leading underscore.
fn out_link_name(link: i64, name: i64, ccx: &CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if link < 0 {
        return;
    }
    let text = sym_text(link, pcx);
    let mut start: i64 = 0;
    if !ccx.c_target_elf {
        if text.len() == 0 || text[0] != b'_' {
            return;
        }
        start = 1;
    }
    let sym = intern(&text[start as usize..], pcx);
    if sym == name {
        return;
    }
    out(c"    #[link_name = \"", ccx);
    buf_bytes(ccx.outb, sym_text(sym, pcx));
    out(c"\"]\n", ccx);
}

// Object-like macros that are integer or float constants, as constants.
fn emit_macro_constants(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        for m in 0..pcx.macros.len() as i64 {
            let name = (pcx.macros[m as usize]).name;
            if (pcx.macros[m as usize]).builtin || (pcx.macros[m as usize]).func
                || macro_of(name, ccx) != m
                || (pcx.macros[m as usize]).body_count == 0 {
                continue;
            }
            if ccx.used_value.get(name + 1) != 0 {
                continue;
            }
            let at = macro_tok(m, 0, pcx);
            let start = pcx.cints.len() as i64;
            let tok = ctok_copy(at, ccx, pcx);
            (pcx.ctoks[tok as usize]).kind = CK::Ident;
            (pcx.ctoks[tok as usize]).text = name;
            pcx.cints.push(tok);
            let mut expanded = expand_list(start, 1, ccx, pcx);
            if expanded.len() as i64 == 0 {
                continue;
            }
            emit_mark(ORIGIN_MACRO, m, ccx, pcx);
            if emit_float_constant(name, &mut expanded, ccx, pcx) {
                continue;
            }
            if expanded.len() as i64 == 1
                && (pcx.ctoks[(expanded[0]) as usize]).kind == CK::Ident {
                // `#define stdin __stdinp`: another name for a variable or a
                // function, declared again under it.
                ccx.aliases.push(name);
                ccx.aliases.push((pcx.ctoks[(expanded[0]) as usize]).text);
                continue;
            }
            let saved = (ccx.d_toks, ccx.d_n, ccx.d_pos);
            let (v, t) = eval_tokens(expanded, at, true, ccx, pcx);
            let (dt, dn, dp) = saved;
            ccx.d_toks = dt;
            ccx.d_n = dn;
            ccx.d_pos = dp;
            if pcx.ev_fail || cty_integer(t, ccx) == 0 {
                continue;
            }
            claim_value(name, ccx);
            out(c"const ", ccx);
            out_name(name, ccx, pcx);
            out(c": ", ccx);
            out_const_type(t, ccx, pcx);
            out(c" = ", ccx);
            out_value(ev_convert(v, t, ccx), t, ccx);
            out(c";\n", ccx);
        }
    }
}

// The aliases as declarations of the same C symbols under the macros'
// names (only of variables and functions that were imported).
fn emit_aliases(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    out(c"extern \"C\" {\n", ccx);
    let mut i: i64 = 0;
    while i < ccx.aliases.len() as i64 {
        let name = (ccx.aliases[i as usize]);
        let target = (ccx.aliases[(i + 1) as usize]);
        i += 2;
        if ccx.used_value.get(name + 1) != 0 {
            continue;
        }
        let v = ccx.var_of.get(target + 1) - 1;
        let f = ccx.func_of.get(target + 1) - 1;
        if v >= 0 && ccx.emitted_value.get(target + 1) != 0 {
            emit_mark(ORIGIN_MACRO, macro_of(name, ccx), ccx, pcx);
            claim_value(name, ccx);
            out_alias_link(ccx.cvars[v as usize].link, target, ccx, pcx);
            out(if ccx.cvars[v as usize].is_const != 0 { c"    static " }
                else { c"    static mut " },
                ccx);
            out_name(name, ccx, pcx);
            out(c": ", ccx);
            out_type(ccx.cvars[v as usize].ty, ccx, pcx);
            out(c";\n", ccx);
        } else if f >= 0 && ccx.emitted_value.get(target + 1) != 0 {
            emit_mark(ORIGIN_MACRO, macro_of(name, ccx), ccx, pcx);
            claim_value(name, ccx);
            out_alias_link(ccx.cfuncs[f as usize].link, target, ccx, pcx);
            out_function(f, name, ccx, pcx);
        }
    }
    out(c"}\n", ccx);
}

// The link name of an alias: the target's own, or its name.
fn out_alias_link(link: i64, target: i64, ccx: &CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if link >= 0 {
        out_link_name(link, -1, ccx, pcx);
        return;
    }
    out(c"    #[link_name = \"", ccx);
    buf_bytes(ccx.outb, sym_text(target, pcx));
    out(c"\"]\n", ccx);
}

// `[(] [-] float-literal [)]`: a float constant.
fn emit_float_constant(name: i64, toks: &mut IntVec, ccx: &mut CImportCx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut lo: i64 = 0;
        let mut hi = toks.len() as i64;
        while hi - lo >= 2 && ctok_is((toks[lo as usize]), pcx.s_lparen, pcx)
            && ctok_is((toks[(hi - 1) as usize]), pcx.s_rparen, pcx) {
            lo += 1;
            hi -= 1;
        }
        let mut negative = false;
        if hi - lo == 2
            && (pcx.ctoks[(toks[lo as usize]) as usize]).kind == CK::Punct
            && streq(ctok_text((toks[lo as usize]), pcx), c"-") {
            negative = true;
            lo += 1;
        }
        if hi - lo != 1
            || (pcx.ctoks[(toks[lo as usize]) as usize]).kind != CK::Num {
            return false;
        }
        let text = ctok_text((toks[lo as usize]), pcx);
        let n = strlen(text) as i64;
        let hex = n > 1 && (*text.add(0)) == b'0'
            && ((*text.add(1)) == b'x' || (*text.add(1)) == b'X');
        let mut is_float = false;
        for i in 0..n {
            let c = (*text.add(i as usize));
            if c == b'.' || (!hex && (c == b'e' || c == b'E'))
                || (hex && (c == b'p' || c == b'P')) {
                is_float = true;
            }
        }
        if !is_float {
            return false;
        }
        let last = (*text.add((n - 1) as usize));
        let mut end = 0 as *mut u8;
        let mut is_f32 = false;
        let mut value: f64 = 0.0;
        if last == b'f' || last == b'F' {
            is_f32 = true;
            value = strtof(text, &mut end) as f64;
        } else if last == b'l' || last == b'L' {
            if !ccx.c_long_double_64 {
                return false;
            }
            value = strtod(text, &mut end);
        } else {
            value = strtod(text, &mut end);
        }
        if negative {
            // (-value: 0.0 - value is +0.0 for a C -0.0)
            value = -value;
        }
        if value != value || value - value != 0.0 {
            return false;
        }
        if !claim_value(name, ccx) {
            return true;
        }
        let digits = alloc_zeroed(64);
        snprintf(digits, 64, c"%.17g", value);
        let mut dot = false;
        let mut exp: i64 = -1;
        let dn = strlen(digits) as i64;
        for i in 0..dn {
            if (*digits.add(i as usize)) == b'.' {
                dot = true;
            }
            if (*digits.add(i as usize)) == b'e' {
                exp = i;
            }
        }
        out(c"const ", ccx);
        out_name(name, ccx, pcx);
        out(if is_f32 { c": f32 = " } else { c": f64 = " }, ccx);
        if dot {
            out(digits, ccx);
        } else if exp >= 0 {
            buf_bytes(ccx.outb,
                std::slice::from_raw_parts(digits.add((0) as usize), (exp - (0)) as usize));
            out(c".0", ccx);
            out(digits.add(exp as usize), ccx);
        } else {
            out(digits, ccx);
            out(c".0", ccx);
        }
        out(c";\n", ccx);
        true
    }
}
