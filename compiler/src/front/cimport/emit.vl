// Writing the imported declarations as vole: names for C's types,
// `#[repr(C)]` structs and unions with explicit padding, type aliases,
// constants for enumerators and macros, and the `extern "C"` block of
// functions and variables, with link names and aliases.

use crate::base::{
    IntVec, SYMS, alloc_zeroed, buf_byte, buf_bytes, buf_fmt, buf_int, buf_new, buf_slice, buf_str,
    buf_uint, intern, intern_c, streq, strlen, strtod,
};
use crate::base::comp::Comp;
use crate::front::cimport::{cfield, cty_integer, cty_resolve, cty_signed, skip_reason};
use crate::front::cimport::CT::{Array, Bad, Bool, Enum, Float, Func, Int, Named, Ptr, Record, Void};
use crate::front::cimport::ctx::CImportCx;
use crate::front::cimport::decls::enumerator_type;
use crate::front::cimport::layout::{c_align, c_size, c_value_problem, crec_layout};
use crate::front::cimport::specifiers::typedef_of;
use crate::front::cpp::{
    CINTS, CK, CTOKS, C_EMIT_AT, C_KEEP_ORIGINS, MACROS, MACRO_COUNT, ORIGIN_ENUM,
    ORIGIN_ENUMERATOR, ORIGIN_FIELD, ORIGIN_FUNC, ORIGIN_MACRO, ORIGIN_RECORD, ORIGIN_TYPEDEF,
    ORIGIN_VAR, S_LPAREN, S_RPAREN, ctok_copy, ctok_is, ctok_text, macro_of, macro_tok, origin_of,
    snprintf, strtof,
};
use crate::front::cpp::eval::{EV_FAIL, ev_convert, eval_tokens};
use crate::front::cpp::expand::expand_list;
use crate::front::lexer::{Tok, keyword_of_sym};
use crate::front::types::align_to;

// ---- Writing vole ----

fn out(s: *u8, ccx: CImportCx<Comp>) {
    buf_str(ccx.outb, s);
}

fn out_int(v: i64, ccx: CImportCx<Comp>) {
    buf_int(ccx.outb, v);
}

// A C identifier as a vole name: keywords as raw identifiers.
fn out_name(sym: i64, ccx: CImportCx<Comp>) {
    let k = keyword_of_sym(sym);
    if k != Tok::Eof || sym == intern_c(c"self") || sym == intern_c(c"Self")
        || sym == intern_c(c"_") {
        out(c"r#", ccx);
    }
    buf_bytes(ccx.outb, SYMS[sym].text);
}

fn is_primitive_name(sym: i64) -> bool {
    let names: [*u8; 14] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64",
        c"f32", c"f64", c"bool", c"isize", c"usize", c"Self"];
    for i in 0..14 {
        if sym == intern_c(names[i]) {
            return true;
        }
    }
    false
}

// Claims a type name; false when taken.
fn claim_type(sym: i64, ccx: inout CImportCx<Comp>) -> bool {
    if ccx.used_type.get(sym + 1) != 0 || is_primitive_name(sym) {
        return false;
    }
    ccx.used_type.put(sym + 1, 1);
    true
}

fn prefixed(prefix: *u8, sym: i64) -> i64 {
    let b = buf_new();
    buf_str(b, prefix);
    buf_bytes(b, SYMS[sym].text);
    intern(buf_slice(b))
}

// The vole spelling of C type t (a value's type; void is not one).
fn out_type(t: i64, ccx: inout CImportCx<Comp>) {
    unsafe {
        let k = ccx.ctypes[t].kind;
        match k {
            Int => {
                out(if ccx.ctypes[t].b != 0 { c"i" } else { c"u" }, ccx);
                out_int(ccx.ctypes[t].a, ccx);
            }
            Bool => out(c"bool", ccx),
            Float => out(if ccx.ctypes[t].a == 32 { c"f32" } else { c"f64" }, ccx),
            Void => out(c"u8", ccx),
            Ptr => {
                let p = cty_resolve(ccx.ctypes[t].a, ccx);
                let pk = ccx.ctypes[p].kind;
                if pk == Func {
                    if ccx.ctypes[p].d != 0 || c_fn_problem(p, &ccx) >= 0 {
                        out(c"*u8", ccx);
                    } else {
                        out_fn_type(p, &ccx);
                    }
                } else if ccx.ctypes[t].b != 0 {
                    // (0.18: `_Nonnull`)
                    out(c"std::NonNull<", ccx);
                    if pk == Void || pk == Bad {
                        out(c"u8", ccx);
                    } else {
                        out_type(ccx.ctypes[t].a, &ccx);
                    }
                    out(c">", ccx);
                } else if pk == Void || pk == Bad {
                    out(c"*u8", ccx);
                } else {
                    out(c"*", ccx);
                    out_type(ccx.ctypes[t].a, &ccx);
                }
            }
            Array => {
                out(c"[", ccx);
                out_type(ccx.ctypes[t].a, &ccx);
                out(c"; ", ccx);
                out_int(if ccx.ctypes[t].b < 0 { 0 } else { ccx.ctypes[t].b }, ccx);
                out(c"]", ccx);
            }
            Record => out_name(ccx.crecs[ccx.ctypes[t].a].name, ccx),
            Enum => {
                let e = ccx.ctypes[t].a;
                if ccx.cenums[e].name >= 0 {
                    out_name(ccx.cenums[e].name, ccx);
                } else {
                    out_type(ccx.cenums[e].underlying, &ccx);
                }
            }
            Named => {
                let td = ccx.ctypes[t].a;
                if ccx.ctypedefs[td].tname >= 0 {
                    out_name(ccx.ctypedefs[td].tname, ccx);
                } else {
                    out_type(ccx.ctypedefs[td].ty, &ccx);
                }
            }
            Func => out_fn_type(t, &ccx),
            Bad => out(c"u8", ccx),
        }
    }
}

fn out_fn_type(f: i64, ccx: inout CImportCx<Comp>) {
    unsafe {
        out(c"extern \"C\" fn(", ccx);
        for i in 0..ccx.ctypes[f].c {
            if i > 0 {
                out(c", ", ccx);
            }
            out_type(CINTS.data[ccx.ctypes[f].b + i], &ccx);
        }
        out(c")", ccx);
        let ret = cty_resolve(ccx.ctypes[f].a, ccx);
        if ccx.ctypes[ret].kind != Void {
            out(c" -> ", ccx);
            out_type(ccx.ctypes[f].a, &ccx);
        }
    }
}

// Why function type f cannot be imported, or -1.
fn c_fn_problem(f: i64, ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        for i in 0..ccx.ctypes[f].c {
            let p = c_value_problem(CINTS.data[ccx.ctypes[f].b + i], &ccx);
            if p >= 0 {
                return p;
            }
        }
        let ret = cty_resolve(ccx.ctypes[f].a, ccx);
        if ccx.ctypes[ret].kind == Void {
            return -1;
        }
        if ccx.ctypes[ret].kind == Array {
            return intern_c(c"it returns an array");
        }
        c_value_problem(ccx.ctypes[f].a, &ccx)
    }
}

// Names for the records, enums and typedefs (C's tag and ordinary
// namespaces share vole's type namespace).
fn assign_type_names(ccx: inout CImportCx<Comp>) {
    unsafe {
        // Anonymous records and enums take the name of their first typedef.
        for i in 0..ccx.ctypedef_count {
            let t = ccx.ctypedefs[i].ty;
            if ccx.ctypes[t].kind == Record {
                let r = ccx.ctypes[t].a;
                // (Not a typedef that raises the alignment: GCC keeps the
                // size, which no vole type can do.)
                let raises = ccx.ctypedefs[i].align_attr > 0
                    && ccx.ctypedefs[i].align_attr > c_align(t, &ccx);
                if ccx.crecs[r].tag < 0 && ccx.crecs[r].name < 0 && ccx.crecs[r].parent < 0
                    && !raises
                    && claim_type(ccx.ctypedefs[i].name, &ccx) {
                    ccx.crecs[r].name = ccx.ctypedefs[i].name;
                    ccx.ctypedefs[i].tname = -2;
                }
            } else if ccx.ctypes[t].kind == Enum {
                let e = ccx.ctypes[t].a;
                if ccx.cenums[e].tag < 0 && ccx.cenums[e].name < 0
                    && claim_type(ccx.ctypedefs[i].name, &ccx) {
                    ccx.cenums[e].name = ccx.ctypedefs[i].name;
                    ccx.ctypedefs[i].tname = -2;
                }
            }
        }
        // Typedefs other than `typedef struct x x;`.
        for i in 0..ccx.ctypedef_count {
            if ccx.ctypedefs[i].tname == -2 {
                continue;
            }
            let t = ccx.ctypedefs[i].ty;
            let name = ccx.ctypedefs[i].name;
            let r = cty_resolve(t, ccx);
            if ccx.ctypes[r].kind == Func || ccx.ctypes[r].kind == Bad
                || ccx.ctypes[r].kind == Void {
                continue;
            }
            if ccx.ctypes[t].kind == Record && ccx.crecs[ccx.ctypes[t].a].tag == name {
                continue;
            }
            if ccx.ctypes[t].kind == Enum && ccx.cenums[ccx.ctypes[t].a].tag == name {
                continue;
            }
            // A typedef that raises its type's alignment is another type,
            // which a vole alias is not.
            if ccx.ctypedefs[i].align_attr > 0 && ccx.ctypedefs[i].align_attr > c_align(t, &ccx) {
                skip_reason(name, intern_c(c"its typedef raises the alignment"));
                continue;
            }
            if claim_type(name, &ccx) {
                ccx.ctypedefs[i].tname = name;
            }
        }
        for r in 0..ccx.crec_count {
            if ccx.crecs[r].name >= 0 {
                continue;
            }
            if ccx.crecs[r].tag >= 0 {
                if claim_type(ccx.crecs[r].tag, &ccx) {
                    ccx.crecs[r].name = ccx.crecs[r].tag;
                } else {
                    ccx.crecs[r].name = prefixed(if ccx.crecs[r].is_union != 0 { c"union_" }
                        else { c"struct_" }, ccx.crecs[r].tag);
                    claim_type(ccx.crecs[r].name, &ccx);
                }
            }
        }
        // Anonymous records: after their parent, `<parent>_anon<k>`; others
        // `anon_<k>`.
        var k = 0;
        for r in 0..ccx.crec_count {
            if ccx.crecs[r].name < 0 {
                let b = buf_new();
                if ccx.crecs[r].parent >= 0 && ccx.crecs[ccx.crecs[r].parent].name >= 0 {
                    buf_fmt(b,
                        format_args("{}_anon", SYMS[ccx.crecs[ccx.crecs[r].parent].name].text));
                } else {
                    buf_str(b, c"anon_");
                }
                buf_int(b, k);
                k += 1;
                ccx.crecs[r].name = intern(buf_slice(b));
                claim_type(ccx.crecs[r].name, &ccx);
            }
        }
        for e in 0..ccx.cenum_count {
            if ccx.cenums[e].name < 0 && ccx.cenums[e].tag >= 0 {
                if claim_type(ccx.cenums[e].tag, &ccx) {
                    ccx.cenums[e].name = ccx.cenums[e].tag;
                } else {
                    ccx.cenums[e].name = prefixed(c"enum_", ccx.cenums[e].tag);
                    claim_type(ccx.cenums[e].name, &ccx);
                }
            }
        }
    }
}

// A member name not used by a field of r: `base<k>`.
fn member_name(r: i64, base: *u8, k: i64, ccx: inout CImportCx<Comp>) -> i64 {
    let b = buf_new();
    buf_str(b, base);
    buf_int(b, k);
    var sym = intern(buf_slice(b));
    loop {
        let clash = unsafe {
            (0..ccx.crecs[r].field_count).any(|i| (*cfield(r, i, &ccx)).name == sym)
        };
        if !clash {
            return sym;
        }
        buf_byte(b, '_');
        sym = intern(buf_slice(b));
    }
}

fn out_member(name: i64, size: i64, ccx: CImportCx<Comp>) {
    emit_mark(0, 0, ccx);
    out(c"    ", ccx);
    out_name(name, ccx);
    out(c": [u8; ", ccx);
    out_int(size, ccx);
    out(c"],\n", ccx);
}

fn emit_record(r: i64, ccx: inout CImportCx<Comp>) {
    unsafe {
        crec_layout(r, &ccx);
        emit_mark(ORIGIN_RECORD, r, ccx);
        // The C spelling, when there is one.
        if ccx.crecs[r].tag >= 0 && ccx.crecs[r].tag != intern_c(c"__va_list_tag")
            && ccx.crecs[r].tag != intern_c(c"__va_list") {
            out(if ccx.crecs[r].is_union != 0 { c"// C: union " } else { c"// C: struct " }, ccx);
            buf_bytes(ccx.outb, SYMS[ccx.crecs[r].tag].text);
            out(c"\n", ccx);
        }
        else if ccx.crecs[r].parent < 0 && ccx.crecs[r].name >= 0
            && typedef_of(ccx.crecs[r].name, ccx) >= 0 {
            out(c"// C: ", ccx);
            buf_bytes(ccx.outb, SYMS[ccx.crecs[r].name].text);
            out(c"\n", ccx);
        }
        if ccx.crecs[r].opaque >= 0 {
            // Usable through pointers only.
            out(c"// ", ccx);
            buf_bytes(ccx.outb, SYMS[ccx.crecs[r].name].text);
            out(c": opaque, ", ccx);
            buf_bytes(ccx.outb, SYMS[ccx.crecs[r].opaque].text);
            out(c"\nstruct ", ccx);
            out_name(ccx.crecs[r].name, ccx);
            out(c" {}\n", ccx);
            return;
        }
        out(c"#[repr(C", ccx);
        if ccx.crecs[r].emit_packed != 0 {
            out(c", packed", ccx);
            if ccx.crecs[r].emit_packed > 1 {
                out(c"(", ccx);
                out_int(ccx.crecs[r].emit_packed, ccx);
                out(c")", ccx);
            }
        }
        if ccx.crecs[r].emit_align != 0 {
            out(c", align(", ccx);
            out_int(ccx.crecs[r].emit_align, ccx);
            out(c")", ccx);
        }
        out(c")]\n", ccx);
        let is_union = ccx.crecs[r].is_union != 0;
        out(if is_union { c"union " } else { c"struct " }, ccx);
        out_name(ccx.crecs[r].name, ccx);
        out(c" {\n", ccx);
        var at = 0;
        var pads = 0;
        var anons = 0;
        var bitfields = 0;
        let n = ccx.crecs[r].field_count;
        var i = 0;
        while i < n {
            let f = cfield(r, i, &ccx);
            if (*f).bits >= 0 {
                if is_union {
                    if (*f).bits > 0 {
                        out_member(member_name(r, c"_bitfield", bitfields, &ccx),
                            ((*f).bits + 7) / 8, ccx);
                        bitfields += 1;
                    }
                    i += 1;
                    continue;
                }
                // A run of bit-fields: their bytes.
                let first_bit = (*f).bit_offset;
                var end_bit = first_bit;
                while i < n && (*cfield(r, i, &ccx)).bits >= 0 {
                    let g = cfield(r, i, &ccx);
                    let e = (*g).bit_offset + (*g).bits;
                    end_bit = if e > end_bit { e } else { end_bit };
                    i += 1;
                }
                let lo = first_bit / 8;
                let hi = (end_bit + 7) / 8;
                if hi > lo {
                    if lo > at {
                        out_member(member_name(r, c"_pad", pads, &ccx), lo - at, ccx);
                        pads += 1;
                    }
                    let start = if lo > at { lo } else { at };
                    out_member(member_name(r, c"_bitfield", bitfields, &ccx), hi - start, ccx);
                    bitfields += 1;
                    at = hi;
                }
                continue;
            }
            // Padding only where vole's own placement would differ.
            var ma = c_align((*f).ty, &ccx);
            if ccx.crecs[r].emit_packed != 0 && ma > ccx.crecs[r].emit_packed {
                ma = ccx.crecs[r].emit_packed;
            }
            if !is_union && (*f).offset > align_to(at, ma) {
                out_member(member_name(r, c"_pad", pads, &ccx), (*f).offset - at, ccx);
                pads += 1;
            }
            emit_mark(ORIGIN_FIELD, CINTS.get(ccx.crecs[r].fields + i), ccx);
            out(c"    ", ccx);
            if (*f).name >= 0 {
                out_name((*f).name, ccx);
            } else {
                out_name(member_name(r, c"_anon", anons, &ccx), ccx);
                anons += 1;
            }
            out(c": ", ccx);
            out_type((*f).ty, &ccx);
            out(c",\n", ccx);
            if !is_union {
                at = (*f).offset + c_size((*f).ty, &ccx);
            }
            i += 1;
        }
        // Tail padding beyond what alignment gives.
        let align = if ccx.crecs[r].emit_packed != 0 { ccx.crecs[r].emit_packed }
            else { ccx.crecs[r].align };
        if is_union {
            var largest = 0;
            for j in 0..n {
                let f = cfield(r, j, &ccx);
                let s = if (*f).bits >= 0 { ((*f).bits + 7) / 8 } else { c_size((*f).ty, &ccx) };
                largest = if s > largest { s } else { largest };
            }
            if align_to(largest, align) < ccx.crecs[r].size {
                out_member(member_name(r, c"_pad", pads, &ccx), ccx.crecs[r].size, ccx);
            }
        } else if align_to(at, align) < ccx.crecs[r].size {
            out_member(member_name(r, c"_pad", pads, &ccx), ccx.crecs[r].size - at, ccx);
        }
        out(c"}\n", ccx);
    }
}

// The vole type of an integer constant of C type t.
fn out_const_type(t: i64, ccx: inout CImportCx<Comp>) {
    let r = cty_resolve(t, ccx);
    if unsafe {
        ccx.ctypes[t].kind == Named && ccx.ctypedefs[ccx.ctypes[t].a].tname >= 0
            && ccx.ctypes[r].kind == Int
    } {
        out_type(t, &ccx);
        return;
    }
    out_type(cty_integer(t, ccx), &ccx);
}

fn out_value(v: u64, t: i64, ccx: CImportCx<Comp>) {
    if cty_signed(t, ccx) {
        out_int(v as i64, ccx);
    } else {
        buf_uint(ccx.outb, v);
    }
}

fn claim_value(sym: i64, ccx: inout CImportCx<Comp>) -> bool {
    if ccx.used_value.get(sym + 1) != 0 {
        return false;
    }
    ccx.used_value.put(sym + 1, 1);
    true
}

// (0.25.2) The item written next is declaration (kind, index)'s (kind
// 0: no declaration's), for the language server: C_EMIT_AT.
fn emit_mark(kind: i64, index: i64, ccx: CImportCx<Comp>) {
    if !C_KEEP_ORIGINS {
        return;
    }
    C_EMIT_AT.push(buf_slice(ccx.outb).len as i64);
    C_EMIT_AT.push(if kind == 0 { -1 } else { origin_of(kind, index, ccx) });
}

// Writes the imported declarations as vole source to buffer `b`.
pub fn cimport_emit(b: i64, ccx: inout CImportCx<Comp>) {
    unsafe {
        ccx.outb = b;
        assign_type_names(&ccx);
        for r in 0..ccx.crec_count {
            emit_record(r, &ccx);
        }
        for i in 0..ccx.ctypedef_count {
            if ccx.ctypedefs[i].tname >= 0 {
                let problem = c_value_problem(ccx.ctypedefs[i].ty, &ccx);
                let r = cty_resolve(ccx.ctypedefs[i].ty, ccx);
                if problem >= 0 && !(ccx.ctypes[r].kind == Record) {
                    skip_reason(ccx.ctypedefs[i].name, problem);
                    continue;
                }
                emit_mark(ORIGIN_TYPEDEF, ccx.ctypedefs[i].name, ccx);
                out(c"type ", ccx);
                out_name(ccx.ctypedefs[i].tname, ccx);
                out(c" = ", ccx);
                out_type(ccx.ctypedefs[i].ty, &ccx);
                out(c";\n", ccx);
            }
        }
        for e in 0..ccx.cenum_count {
            if ccx.cenums[e].name >= 0 {
                emit_mark(ORIGIN_ENUM, e, ccx);
                out(c"type ", ccx);
                out_name(ccx.cenums[e].name, ccx);
                out(c" = ", ccx);
                out_type(ccx.cenums[e].underlying, &ccx);
                out(c";\n", ccx);
            }
        }
        emit_mark(0, 0, ccx);
        out(c"extern \"C\" {\n", ccx);
        for i in 0..ccx.cfuncs.len() as i64 {
            let f = cty_resolve(ccx.cfuncs[i].ty, ccx);
            let problem = c_fn_problem(f, &ccx);
            if problem >= 0 {
                skip_reason(ccx.cfuncs[i].name, problem);
                continue;
            }
            if !claim_value(ccx.cfuncs[i].name, &ccx) {
                continue;
            }
            ccx.emitted_value.put(ccx.cfuncs[i].name + 1, 1);
            emit_mark(ORIGIN_FUNC, ccx.cfuncs[i].name, ccx);
            out_link_name(ccx.cfuncs[i].link, ccx.cfuncs[i].name, ccx);
            out_function(i, ccx.cfuncs[i].name, &ccx);
        }
        for i in 0..ccx.cvars.len() {
            let problem = c_value_problem(ccx.cvars[i].ty, &ccx);
            let r = cty_resolve(ccx.cvars[i].ty, ccx);
            if problem >= 0 || (ccx.ctypes[r].kind == Array && ccx.ctypes[r].b < 0) {
                skip_reason(ccx.cvars[i].name,
                    if problem >= 0 { problem } else { intern_c(c"an array of unknown size") });
                continue;
            }
            if !claim_value(ccx.cvars[i].name, &ccx) {
                continue;
            }
            ccx.emitted_value.put(ccx.cvars[i].name + 1, 1);
            emit_mark(ORIGIN_VAR, ccx.cvars[i].name, ccx);
            out_link_name(ccx.cvars[i].link, ccx.cvars[i].name, ccx);
            out(if ccx.cvars[i].is_const != 0 { c"    static " } else { c"    static mut " }, ccx);
            out_name(ccx.cvars[i].name, ccx);
            out(c": ", ccx);
            out_type(ccx.cvars[i].ty, &ccx);
            out(c";\n", ccx);
        }
        out(c"}\n", ccx);
        for i in 0..ccx.cenumerators.len() as i64 {
            let name = ccx.cenumerators[i].name;
            if ccx.enumerator_of.get(name + 1) != i + 1 || !claim_value(name, &ccx) {
                continue;
            }
            let e = ccx.cenumerators[i].ty;
            emit_mark(ORIGIN_ENUMERATOR, i, ccx);
            out(c"const ", ccx);
            out_name(name, ccx);
            out(c": ", ccx);
            let t = if ccx.cenums[e].name >= 0 { ccx.cenums[e].ty }
                else { enumerator_type(i, ccx) };
            out_type(t, &ccx);
            out(c" = ", ccx);
            out_value(ccx.cenumerators[i].value as u64, t, ccx);
            out(c";\n", ccx);
        }
        emit_macro_constants(&ccx);
        emit_aliases(&ccx);
    }
}

// The declaration of C function f under `name`.
fn out_function(i: i64, name: i64, ccx: inout CImportCx<Comp>) {
    unsafe {
        let f = cty_resolve(ccx.cfuncs[i].ty, ccx);
        out(c"    fn ", ccx);
        out_name(name, ccx);
        out(c"(", ccx);
        for k in 0..ccx.ctypes[f].c {
            if k > 0 {
                out(c", ", ccx);
            }
            out(c"p", ccx);
            out_int(k, ccx);
            out(c": ", ccx);
            out_type(CINTS.data[ccx.ctypes[f].b + k], &ccx);
        }
        if ccx.ctypes[f].d != 0 {
            out(if ccx.ctypes[f].c > 0 { c", ..." } else { c"..." }, ccx);
        }
        out(c")", ccx);
        let ret = cty_resolve(ccx.ctypes[f].a, ccx);
        if ccx.ctypes[ret].kind == Void {
            if ccx.cfuncs[i].noreturn != 0 {
                out(c" -> !", ccx);
            }
        } else {
            out(c" -> ", ccx);
            out_type(ccx.ctypes[f].a, &ccx);
        }
        out(c";\n", ccx);
    }
}

// `#[link_name]` when an asm label renames the symbol. Labels are
// assembler names: on Mach-O, C's names have a leading underscore.
fn out_link_name(link: i64, name: i64, ccx: CImportCx<Comp>) {
    if link < 0 {
        return;
    }
    let text = SYMS[link].text;
    var start = 0;
    if !ccx.c_target_elf {
        if text.len == 0 || text[0] != '_' {
            return;
        }
        start = 1;
    }
    let sym = intern(text[start..]);
    if sym == name {
        return;
    }
    out(c"    #[link_name = \"", ccx);
    buf_bytes(ccx.outb, SYMS[sym].text);
    out(c"\"]\n", ccx);
}

// Object-like macros that are integer or float constants, as constants.
fn emit_macro_constants(ccx: inout CImportCx<Comp>) {
    unsafe {
        for m in 0..MACRO_COUNT {
            let name = MACROS[m].name;
            if MACROS[m].builtin || MACROS[m].func || macro_of(name, ccx) != m
                || MACROS[m].body_count == 0 {
                continue;
            }
            if ccx.used_value.get(name + 1) != 0 {
                continue;
            }
            let at = macro_tok(m, 0);
            let start = CINTS.count;
            let tok = ctok_copy(at, &ccx);
            CTOKS[tok].kind = CK::Ident;
            CTOKS[tok].text = name;
            CINTS.push(tok);
            var expanded = expand_list(start, 1, &ccx);
            if expanded.count == 0 {
                continue;
            }
            emit_mark(ORIGIN_MACRO, m, ccx);
            if emit_float_constant(name, &expanded, &ccx) {
                continue;
            }
            if expanded.count == 1 && CTOKS[expanded.data[0]].kind == CK::Ident {
                // `#define stdin __stdinp`: another name for a variable or a
                // function, declared again under it.
                ccx.aliases.push(name);
                ccx.aliases.push(CTOKS[expanded.data[0]].text);
                continue;
            }
            let saved = (ccx.d_toks, ccx.d_n, ccx.d_pos);
            let (v, t) = eval_tokens(expanded, at, true, &ccx);
            let (dt, dn, dp) = saved;
            ccx.d_toks = dt;
            ccx.d_n = dn;
            ccx.d_pos = dp;
            if EV_FAIL || cty_integer(t, ccx) == 0 {
                continue;
            }
            claim_value(name, &ccx);
            out(c"const ", ccx);
            out_name(name, ccx);
            out(c": ", ccx);
            out_const_type(t, &ccx);
            out(c" = ", ccx);
            out_value(ev_convert(v, t, ccx), t, ccx);
            out(c";\n", ccx);
        }
    }
}

// The aliases as declarations of the same C symbols under the macros'
// names (only of variables and functions that were imported).
fn emit_aliases(ccx: inout CImportCx<Comp>) {
    unsafe {
        out(c"extern \"C\" {\n", ccx);
        var i = 0;
        while i < ccx.aliases.count {
            let name = ccx.aliases.data[i];
            let target = ccx.aliases.data[i + 1];
            i += 2;
            if ccx.used_value.get(name + 1) != 0 {
                continue;
            }
            let v = ccx.var_of.get(target + 1) - 1;
            let f = ccx.func_of.get(target + 1) - 1;
            if v >= 0 && ccx.emitted_value.get(target + 1) != 0 {
                emit_mark(ORIGIN_MACRO, macro_of(name, ccx), ccx);
                claim_value(name, &ccx);
                out_alias_link(ccx.cvars[v].link, target, ccx);
                out(if ccx.cvars[v].is_const != 0 { c"    static " } else { c"    static mut " },
                    ccx);
                out_name(name, ccx);
                out(c": ", ccx);
                out_type(ccx.cvars[v].ty, &ccx);
                out(c";\n", ccx);
            } else if f >= 0 && ccx.emitted_value.get(target + 1) != 0 {
                emit_mark(ORIGIN_MACRO, macro_of(name, ccx), ccx);
                claim_value(name, &ccx);
                out_alias_link(ccx.cfuncs[f].link, target, ccx);
                out_function(f, name, &ccx);
            }
        }
        out(c"}\n", ccx);
    }
}

// The link name of an alias: the target's own, or its name.
fn out_alias_link(link: i64, target: i64, ccx: CImportCx<Comp>) {
    if link >= 0 {
        out_link_name(link, -1, ccx);
        return;
    }
    out(c"    #[link_name = \"", ccx);
    buf_bytes(ccx.outb, SYMS[target].text);
    out(c"\"]\n", ccx);
}

// `[(] [-] float-literal [)]`: a float constant.
fn emit_float_constant(name: i64, toks: inout IntVec, ccx: inout CImportCx<Comp>) -> bool {
    unsafe {
        var lo = 0;
        var hi = toks.count;
        while hi - lo >= 2 && ctok_is(toks.data[lo], S_LPAREN)
            && ctok_is(toks.data[hi - 1], S_RPAREN) {
            lo += 1;
            hi -= 1;
        }
        var negative = false;
        if hi - lo == 2 && CTOKS[toks.data[lo]].kind == CK::Punct
            && streq(ctok_text(toks.data[lo]), c"-") {
            negative = true;
            lo += 1;
        }
        if hi - lo != 1 || CTOKS[toks.data[lo]].kind != CK::Num {
            return false;
        }
        let text = ctok_text(toks.data[lo]);
        let n = strlen(text) as i64;
        let hex = n > 1 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X');
        var is_float = false;
        for i in 0..n {
            let c = text[i];
            if c == '.' || (!hex && (c == 'e' || c == 'E')) || (hex && (c == 'p' || c == 'P')) {
                is_float = true;
            }
        }
        if !is_float {
            return false;
        }
        let last = text[n - 1];
        var end = 0 as *u8;
        var is_f32 = false;
        var value: f64 = 0.0;
        if last == 'f' || last == 'F' {
            is_f32 = true;
            value = strtof(text, &end) as f64;
        } else if last == 'l' || last == 'L' {
            if !ccx.c_long_double_64 {
                return false;
            }
            value = strtod(text, &end);
        } else {
            value = strtod(text, &end);
        }
        if negative {
            // (-value: 0.0 - value is +0.0 for a C -0.0)
            value = -value;
        }
        if value != value || value - value != 0.0 {
            return false;
        }
        if !claim_value(name, &ccx) {
            return true;
        }
        let digits = alloc_zeroed(64);
        snprintf(digits, 64, c"%.17g", value);
        var dot = false;
        var exp = -1;
        let dn = strlen(digits) as i64;
        for i in 0..dn {
            if digits[i] == '.' {
                dot = true;
            }
            if digits[i] == 'e' {
                exp = i;
            }
        }
        out(c"const ", ccx);
        out_name(name, ccx);
        out(if is_f32 { c": f32 = " } else { c": f64 = " }, ccx);
        if dot {
            out(digits, ccx);
        } else if exp >= 0 {
            buf_bytes(ccx.outb, digits[0..exp]);
            out(c".0", ccx);
            out(&digits[exp], ccx);
        } else {
            out(digits, ccx);
            out(c".0", ccx);
        }
        out(c";\n", ccx);
        true
    }
}
