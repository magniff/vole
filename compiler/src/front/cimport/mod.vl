// C import (2/2): C declarations to vole, for `import "header.h" as c;`.
//
// The preprocessed headers (cpp.vl) are parsed as C declarations
// (C11 6.7, with the GNU extensions of system headers: __attribute__,
// __asm__ labels, __extension__, anonymous members) and written out as
// vole source: `#[repr(C)]` structs and unions with C's exact layout
// (computed here: bit-fields, `packed` and `aligned` become explicit
// padding where vole's own C layout would differ), type aliases for
// typedefs and enums, constants for enumerators and for object-like
// macros that are integer or float constants, and an `extern "C"` block
// of functions and variables (with `#[link_name]` where a label renames
// the symbol). That text is then compiled with the program (90_main).
//
// What vole cannot express is left out, and remembered with the
// reason, for the error when it is used: long double (80-bit on x86-64),
// _Complex, __int128, vectors, variables with thread-local storage,
// `static` and inline functions. A struct whose layout depends on such a
// type stays opaque (usable through pointers only).
//
// This file: C's types, the tables of the declarations read, the token
// cursor over the preprocessed tokens, and the import itself; the parts:
// specifiers (attributes, type specifiers, structs, unions, enums),
// decls (declarators and declarations), layout (C's sizes, alignments
// and record layouts) and emit (the vole text written).

mod emit;
mod layout;
pub mod ctx;
pub mod decls;
mod specifiers;

use crate::host_target;
use crate::base::{
    BUFS, IntVec, _setjmp, add_source, buf_byte, buf_fmt, buf_new, buf_str, buf_write_file, cstr,
    die, exit, grow, intern_c, streq, sym_name,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{exit_if_errors, fail_name, recover_enter, recover_leave};
use crate::base::target::{
    T_AARCH64_LINUX, T_AARCH64_MACOS, T_X86_64_MACOS, target_is_linux, target_name,
};
use crate::front::ast::{NodeKind, child, list_begin, list_end, list_push};
use crate::front::cimport::ctx::{CImportCx, cimport_cx_new};
use crate::front::cimport::decls::cdecl_parse;
use crate::front::cimport::emit::cimport_emit;
use crate::front::cpp::{CK, ctok_text, init_cpp, macro_of, macro_tok, strtoull};
use crate::front::cpp::cc::{c_compiler_given, cpp_query_compiler};
use crate::front::cpp::directives::{path_dir, path_join};
use crate::front::cpp::expand::cpp_next;
use crate::front::cpp::input::{c_load_text, push_frame};
use crate::front::lexer::{Tok, lex_range, str_at};
use crate::front::modules::{add_module, module_of};
use crate::middle::lower::ssa::HMap;

use CT::{Array, Bad, Bool, Enum, Float, Func, Int, Named, Ptr, Record, Void};

enum CT { Void, Int, Bool, Float, Ptr, Array, Func, Record, Enum, Named, Bad }

// Int: a=bits b=signed. Float: a=bits. Ptr: a=pointee. Array: a=element
// b=length (-1: unknown). Func: a=result b=params (CINTS) c=count
// d=variadic. Record: a=record. Enum: a=enum. Named: a=typedef.
// Bad: a=the reason (a symbol).
pub struct CType { kind: CT, a: i64, b: i64, c: i64, d: i64 }

fn cty_new(kind: CT, a: i64, b: i64, c: i64, d: i64, ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        ccx.ctypes = grow(ccx.ctypes, ccx.ctype_count, &ccx.ctype_cap);
        ccx.ctypes[ccx.ctype_count] = CType { kind, a, b, c, d };
    }
    ccx.ctype_count += 1;
    ccx.ctype_count - 1
}

fn bits_index(bits: i64) -> i64 {
    if bits == 8 { 0 } else if bits == 16 { 1 } else if bits == 32 { 2 } else { 3 }
}

pub fn cty_int(bits: i64, signed: bool, ccx: CImportCx<Comp>) -> i64 {
    ccx.cty_ints[bits_index(bits) * 2 + signed as i64]
}

fn cty_bad(reason: *u8, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    cty_new(Bad, intern_c(reason, &pcx), 0, 0, 0, &ccx)
}

fn cty_ptr(t: i64, ccx: inout CImportCx<Comp>) -> i64 {
    cty_new(Ptr, t, 0, 0, 0, &ccx)
}

// Through typedefs.
fn cty_resolve(t: i64, ccx: CImportCx<Comp>) -> i64 {
    unsafe {
        var r = t;
        while ccx.ctypes[r].kind == Named {
            r = ccx.ctypedefs[ccx.ctypes[r].a].ty;
        }
        r
    }
}

// Integer-like: integers, bool, enums (as their integer type).
fn cty_integer(t: i64, ccx: CImportCx<Comp>) -> i64 {
    unsafe {
        let r = cty_resolve(t, ccx);
        match ccx.ctypes[r].kind {
            Int => r,
            Bool => cty_int(8, signed: false, ccx: ccx),
            Enum => cty_integer(ccx.cenums[ccx.ctypes[r].a].underlying, ccx),
            _ => 0,
        }
    }
}

pub fn cty_bits(t: i64, ccx: CImportCx<Comp>) -> i64 {
    let r = cty_integer(t, ccx);
    if r == 0 { 64 } else { unsafe { ccx.ctypes[r].a } }
}

pub fn cty_signed(t: i64, ccx: CImportCx<Comp>) -> bool {
    let r = cty_integer(t, ccx);
    unsafe { r != 0 && ccx.ctypes[r].b != 0 }
}

// ---- Declarations ----

// Records: `opaque` is the reason (a symbol) it cannot be laid out or
// expressed, or -1. `name`: its vole name. `state`: layout 0 not done,
// 1 in progress, 2 done.
pub struct CRec {
    tag: i64, is_union: i64, complete: i64, packed: i64, align_attr: i64,
    fields: i64, field_count: i64, size: i64, align: i64, state: i64,
    opaque: i64, name: i64, ty: i64, parent: i64, emit_packed: i64, emit_align: i64, pack: i64,
}

// `bits`: the width of a bit-field, -1 for other fields; `name` -1 for
// anonymous members and unnamed bit-fields.
pub struct CField { name: i64, ty: i64, bits: i64, align_attr: i64, offset: i64, bit_offset: i64 }
pub struct CEnum { tag: i64, underlying: i64, name: i64, ty: i64, has_values: i64 }
pub struct CTypedef { name: i64, ty: i64, tname: i64, align_attr: i64 }
pub struct CFunc { name: i64, ty: i64, link: i64, noreturn: i64 }
pub struct CVar { name: i64, ty: i64, link: i64, is_const: i64 }
pub struct CEnumerator { name: i64, value: i64, ty: i64 }

fn crec_new(tag: i64, is_union: bool, ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        ccx.crecs = grow(ccx.crecs, ccx.crec_count, &ccx.crec_cap);
        let r = ccx.crec_count;
        ccx.crec_count += 1;
        ccx.crecs[r] = CRec {
            tag, is_union: is_union as i64, complete: 0, packed: 0, align_attr: 0,
            fields: 0, field_count: 0, size: -1, align: 1, state: 0, opaque: -1, name: -1,
            ty: 0, parent: -1, emit_packed: 0, emit_align: 0, pack: 0,
        };
        ccx.crecs[r].ty = cty_new(Record, r, 0, 0, 0, &ccx);
        r
    }
}

fn cfield(r: i64, i: i64, ccx: inout CImportCx<Comp>, pcx: Ctx<Comp>) -> *CField {
    unsafe { &ccx.cfields[pcx.cints.data[ccx.crecs[r].fields + i]] }
}

fn skip_reason(name: i64, reason: i64, pcx: inout Ctx<Comp>) {
    if name >= 0 && pcx.c_skipped.get(name + 1) == 0 {
        pcx.c_skipped.put(name + 1, reason + 1);
    }
}

// ---- The token cursor ----

fn dpeek(k: i64, ccx: CImportCx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if ccx.d_pos + k < ccx.d_n { unsafe { ccx.d_toks[ccx.d_pos + k] } } else { pcx.c_eof }
}

fn dcur(ccx: CImportCx<Comp>, pcx: Ctx<Comp>) -> i64 {
    dpeek(0, ccx, pcx)
}

fn d_is(text: *u8, ccx: CImportCx<Comp>, pcx: Ctx<Comp>) -> bool {
    let t = dcur(ccx, pcx);
    unsafe {
        t != pcx.c_eof && pcx.ctoks[t].kind != CK::Str && pcx.ctoks[t].kind != CK::Char
            && streq(ctok_text(t, pcx), text)
    }
}

fn d_is_at(k: i64, text: *u8, ccx: CImportCx<Comp>, pcx: Ctx<Comp>) -> bool {
    let t = dpeek(k, ccx, pcx);
    unsafe {
        t != pcx.c_eof && pcx.ctoks[t].kind != CK::Str && pcx.ctoks[t].kind != CK::Char
            && streq(ctok_text(t, pcx), text)
    }
}

fn d_eat(text: *u8, ccx: inout CImportCx<Comp>, pcx: Ctx<Comp>) -> bool {
    if d_is(text, ccx, pcx) {
        ccx.d_pos += 1;
        return true;
    }
    false
}

fn d_fail(reason: *u8, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    if ccx.d_bad < 0 {
        ccx.d_bad = intern_c(reason, &pcx);
    }
    ccx.d_pos = ccx.d_n;
}

fn d_expect(text: *u8, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    if !d_eat(text, &ccx, pcx) {
        d_fail(c"syntax vole cannot read", &ccx, &pcx);
    }
}

// Skips a balanced (...) group starting at `(`.
fn d_skip_parens(ccx: inout CImportCx<Comp>, pcx: Ctx<Comp>) {
    if !d_eat(c"(", &ccx, pcx) {
        return;
    }
    var depth = 1;
    while depth > 0 && ccx.d_pos < ccx.d_n {
        if d_is(c"(", ccx, pcx) {
            depth += 1;
        } else if d_is(c")", ccx, pcx) {
            depth -= 1;
        }
        ccx.d_pos += 1;
    }
}

// ---- The import ----

fn init_cimport(ccx: inout CImportCx<Comp>) {
    let widths: [i64; 4] = [8, 16, 32, 64];
    for i in 0..4 {
        ccx.cty_ints[i * 2] = cty_new(Int, widths[i], 0, 0, 0, &ccx);
        ccx.cty_ints[i * 2 + 1] = cty_new(Int, widths[i], 1, 0, 0, &ccx);
    }
    ccx.cty_void = cty_new(Void, 0, 0, 0, 0, &ccx);
    ccx.cty_bool = cty_new(Bool, 0, 0, 0, 0, &ccx);
    ccx.cty_f32 = cty_new(Float, 32, 0, 0, 0, &ccx);
    ccx.cty_f64 = cty_new(Float, 64, 0, 0, 0, &ccx);
}

// The value of a predefined macro that is a number, or -1.
fn builtin_number(name: *u8, ccx: CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let m = macro_of(intern_c(name, &pcx), ccx);
        if m < 0 || pcx.macros[m].body_count != 1 {
            return -1;
        }
        let t = macro_tok(m, 0, pcx);
        if pcx.ctoks[t].kind != CK::Num {
            return -1;
        }
        var end = 0 as *u8;
        strtoull(ctok_text(t, pcx), &end, 10) as i64
    }
}

// Imports the C headers named by the `import` items (`names`: C strings;
// `relative`: whether each is relative to `dirs`, the directory of its
// file) for target `target`; returns the vole source as a buffer.
pub fn c_import(names: IntVec, dirs: IntVec, include_dirs: IntVec, target: i64,
    ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        init_cpp(&ccx, &pcx);
        init_cimport(&ccx);
        ccx.c_target_x86 = target != T_AARCH64_MACOS && target != T_AARCH64_LINUX;
        ccx.c_target_a64_linux = target == T_AARCH64_LINUX;
        ccx.c_target_elf = target_is_linux(target);
        let host = host_target();
        let host_linux = target_is_linux(host);
        let target_linux = target_is_linux(target);
        if (host == 0 || host_linux != target_linux || (target_linux && host != target))
            && !c_compiler_given() {
            // (0.9) Cross-compiling: the target's headers and predefined
            // macros come from a C compiler for it, named by $VOLE_CC.
            let b = buf_new();
            buf_fmt(b, format_args("`import` of C headers for {}", cstr(target_name(target))));
            buf_str(b, c" needs a C compiler for that target, with its headers: this host's cc is not one. Set VOLE_CC to one (for example `clang --target=x86_64-linux-gnu --sysroot=DIR`, DIR holding a Linux system's /usr/include), or write the declarations as vole source with `volec --emit-imports` on a host of the target's system");
            buf_byte(b, 0);
            die(BUFS[b].data);
        }
        for i in 0..include_dirs.count {
            pcx.cdirs.push(include_dirs.data[i]);
        }
        let flags = if target == T_AARCH64_MACOS { c" -arch arm64" }
            else if target == T_X86_64_MACOS { c" -arch x86_64" } else { c"" };
        cpp_query_compiler(flags, &ccx, &pcx);
        ccx.c_long_double_64 = builtin_number(c"__SIZEOF_LONG_DOUBLE__", ccx, &pcx) == 8;
        // The headers, as one translation unit of #includes.
        let top = buf_new();
        for i in 0..names.count {
            let name = names.data[i] as *u8;
            if name[0] == '.' && (name[1] == '/' || (name[1] == '.' && name[2] == '/')) {
                buf_fmt(top,
                    format_args("#include \"{}\"\n", cstr(path_join(dirs.data[i] as *u8, name))));
            } else {
                buf_fmt(top, format_args("#include <{}>\n", cstr(name)));
            }
        }
        let f = c_load_text(c"<import>", top, &ccx, &pcx);
        pcx.c_import_file = f;
        push_frame(f, &ccx, &pcx);
        var toks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        loop {
            let t = cpp_next(&ccx, &pcx);
            if t == pcx.c_eof {
                break;
            }
            toks.push(t);
        }
        cdecl_parse(toks, &ccx, &pcx);
        let b = buf_new();
        buf_str(b, c"// Declarations imported from C headers by volec.\n");
        cimport_emit(b, &ccx, &pcx);
        b
    }
}

// Imported declarations live in a module of their own (modules.vl), so
// the program's own functions and constants of the same names shadow them
// without clashing (0.5). The program's types replace the imported ones
// of the same names (a program may declare the types a header it imports
// also declares; the imported functions then take the program's, as the
// C module sees the root's names), and so do its statics (the code
// generators know statics by symbol).
pub fn drop_shadowed_imports(program: i64, pcx: inout Ctx<Comp>) {
    var types = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var values = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for i in 0..pcx.nodes[program].count {
        let item = child(program, i, pcx);
        if pcx.nodes[item].start >= pcx.imported_start || module_of(item, &pcx) != 0 {
            continue;
        }
        let name = pcx.nodes[item].a;
        match pcx.nodes[item].kind {
            NodeKind::Struct | NodeKind::Enum | NodeKind::TypeAlias => types.put(name + 1, 1),
            NodeKind::Static => values.put(name + 1, 1),
            _ => {}
        }
    }
    let mark = list_begin(pcx);
    for i in 0..pcx.nodes[program].count {
        let item = child(program, i, pcx);
        if pcx.nodes[item].start >= pcx.imported_start {
            let name = pcx.nodes[item].a;
            let shadowed = match pcx.nodes[item].kind {
                NodeKind::Struct | NodeKind::Enum | NodeKind::TypeAlias => types.get(name + 1)
                    != 0,
                NodeKind::Static => values.get(name + 1) != 0,
                _ => false,
            };
            if shadowed {
                continue;
            }
        }
        list_push(item, &pcx);
    }
    list_end(program, mark, &pcx);
}

// Why `name` was not imported from the C headers (0: it was not
// skipped), for the error when a program uses it.
pub fn c_import_skip_reason(name: i64, pcx: Ctx<Comp>) -> *u8 {
    let r = pcx.c_skipped.get(name + 1);
    if r == 0 { 0 as *u8 } else { sym_name(r - 1, pcx) }
}

// `import "header.h" as c;` items: the headers are read (cimport.vl) and
// their declarations, as vole source, are added to the program.
pub fn import_c_headers(target: i64, include_dirs: IntVec, emit: bool, output: *u8,
    pcx: inout Ctx<Comp>) {
    var ccx = cimport_cx_new();
    unsafe {
        var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var dirs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..pcx.toks.len() as i64 {
            if pcx.toks[i].kind == Tok::Import && i + 1 < pcx.toks.len() as i64
                && pcx.toks[i + 1].kind == Tok::Str {
                let name = str_at(pcx.toks[i + 1].value as i64).ptr;
                var file = 0;
                while file + 1 < pcx.files.len() as i64
                    && pcx.toks[i].start >= pcx.files[file + 1].start {
                    file += 1;
                }
                names.push(name as i64);
                pcx.c_import_pos.push(pcx.toks[i + 1].start);
                dirs.push(path_dir(pcx.files[file].path) as i64);
            }
        }
        if names.count == 0 {
            if emit {
                buf_write_file(buf_new(), output);
                exit(0);
            }
            return;
        }
        // A recovery point (0.10): after an error in the headers, the
        // program is checked without them; the names they would have
        // brought (`c` in `import "h.h" as c;`) are failed names.
        let depth = pcx.recover_depth;
        var text = -1;
        if _setjmp(recover_enter(&pcx)) == 0 {
            text = c_import(names, dirs, include_dirs, target, &ccx, &pcx);
        }
        recover_leave(depth, &pcx);
        if text < 0 {
            for i in 0..pcx.toks.len() as i64 {
                if pcx.toks[i].kind == Tok::Import && i + 3 < pcx.toks.len() as i64
                    && pcx.toks[i + 2].kind == Tok::As
                    && pcx.toks[i + 3].kind == Tok::Ident {
                    fail_name(pcx.toks[i + 3].value as i64, &pcx);
                }
            }
            if emit {
                exit_if_errors(&pcx);
            }
            return;
        }
        if emit {
            buf_write_file(text, output);
            exit(0);
        }
        pcx.imported_start = add_source(c"<C import>", text, &pcx);
        pcx.c_module = add_module(intern_c(c"<c>", &pcx), 0, true, &pcx);
        pcx.modules[pcx.c_module].is_c = true;
        pcx.files[pcx.files.len() as i64 - 1].module = pcx.c_module;
        lex_range(pcx.imported_start, pcx.files[pcx.files.len() as i64 - 1].end, last: false,
            pcx: &pcx);
    }
}
