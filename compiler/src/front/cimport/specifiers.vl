// C declaration specifiers: `__attribute__` and `__asm__` labels, storage
// classes and qualifiers, the type specifiers (with the target's C types:
// long double, __builtin_va_list), and struct, union and enum
// definitions with their members.

use crate::base::{
    IntVec, SYMS, buf_bytes, buf_new, buf_slice, grow, intern, intern_c, streq, sym_name,
};
use crate::base::comp::Comp;
use crate::front::cimport::{
    CEnum, CEnumerator, CField, crec_new, cty_bad, cty_int, cty_integer, cty_new, cty_ptr,
    cty_signed, d_eat, d_expect, d_fail, d_is, d_is_at, d_skip_parens, dcur, dpeek,
};
use crate::front::cimport::CT::{Array, Bad, Enum, Named, Record};
use crate::front::cimport::ctx::CImportCx;
use crate::front::cimport::decls::{d_declarator, d_pack_markers};
use crate::front::cpp::{
    CINTS, CK, CTOKS, C_EOF, ORIGIN_ENUM, ORIGIN_ENUMERATOR, ORIGIN_FIELD, ORIGIN_RECORD, ctok_line,
    ctok_text, origin_note,
};
use crate::front::cpp::eval::{EV_FAIL, eval_tokens};

// ---- Attributes ----

pub fn attrs_reset(ccx: inout CImportCx<Comp>) {
    ccx.a_packed = false;
    ccx.a_align = 0;
    ccx.a_mode = 0;
    ccx.a_link = -1;
    ccx.a_noreturn = false;
    ccx.a_unavailable = false;
    ccx.a_vector = false;
}

// An attribute's name without GNU's underscores: __packed__ is packed.
fn attr_name(t: i64) -> *u8 {
    let s = unsafe { SYMS[CTOKS[t].text].text };
    var lo = 0;
    var hi = s.len as i64;
    if hi > 4 && s[0] == '_' && s[1] == '_' && s[hi - 1] == '_' && s[hi - 2] == '_' {
        lo = 2;
        hi -= 2;
    }
    sym_name(intern(s[lo..hi]))
}

// Attributes and asm labels, wherever they may appear.
pub fn d_attributes(ccx: inout CImportCx<Comp>) {
    unsafe {
        loop {
            if d_is(c"__attribute__", ccx) || d_is(c"__attribute", ccx) {
                ccx.d_pos += 1;
                d_expect(c"(", &ccx);
                d_expect(c"(", &ccx);
                while !d_is(c")", ccx) && ccx.d_pos < ccx.d_n {
                    if d_is(c",", ccx) {
                        ccx.d_pos += 1;
                        continue;
                    }
                    let t = dcur(ccx);
                    ccx.d_pos += 1;
                    let name = attr_name(t);
                    if streq(name, c"packed") {
                        ccx.a_packed = true;
                    } else if streq(name, c"noreturn") {
                        ccx.a_noreturn = true;
                    } else if streq(name, c"unavailable") {
                        ccx.a_unavailable = true;
                    } else if streq(name, c"vector_size") || streq(name, c"ext_vector_type") {
                        ccx.a_vector = true;
                    } else if streq(name, c"aligned") {
                        if d_is(c"(", ccx) {
                            let (v, ok) = d_paren_value(&ccx);
                            if ok {
                                ccx.a_align = v;
                            }
                        } else {
                            ccx.a_align = 16;
                        }
                        continue;
                    } else if streq(name, c"mode") && d_is(c"(", ccx) {
                        ccx.d_pos += 1;
                        let m = attr_name(dcur(ccx));
                        ccx.a_mode = if streq(m, c"QI") || streq(m, c"byte") { 8 }
                            else if streq(m, c"HI") { 16 } else if streq(m, c"SI") { 32 }
                            else if streq(m, c"DI") || streq(m, c"word")
                            || streq(m, c"pointer") { 64 } else { -1 };
                        ccx.d_pos += 1;
                        d_expect(c")", &ccx);
                        continue;
                    }
                    if d_is(c"(", ccx) {
                        d_skip_parens(&ccx);
                    }
                }
                d_expect(c")", &ccx);
                d_expect(c")", &ccx);
            } else if d_is(c"__asm__", ccx) || d_is(c"__asm", ccx) || d_is(c"asm", ccx) {
                ccx.d_pos += 1;
                d_expect(c"(", &ccx);
                let b = buf_new();
                while dcur(ccx) != C_EOF && CTOKS[dcur(ccx)].kind == CK::Str {
                    let s = SYMS[CTOKS[dcur(ccx)].text].text;
                    buf_bytes(b, s[1..s.len as i64 - 1]);
                    ccx.d_pos += 1;
                }
                d_expect(c")", &ccx);
                ccx.a_link = intern(buf_slice(b));
            } else if d_is(c"__declspec", ccx) {
                ccx.d_pos += 1;
                d_skip_parens(&ccx);
            } else {
                return;
            }
        }
    }
}

// `( constant-expression )`: its value.
fn d_paren_value(ccx: inout CImportCx<Comp>) -> (i64, bool) {
    let open = dcur(ccx);
    if !d_eat(c"(", &ccx) {
        return (0, false);
    }
    let list = d_collect_until(c")", c")", &ccx);
    d_expect(c")", &ccx);
    let (v, _) = eval_tokens(list, open, true, &ccx);
    (v as i64, !EV_FAIL)
}

// The tokens up to `a` or `b` at depth 0 (not consumed).
pub fn d_collect_until(a: *u8, b: *u8, ccx: inout CImportCx<Comp>) -> IntVec {
    var out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var depth = 0;
    while ccx.d_pos < ccx.d_n {
        if depth == 0 && (d_is(a, ccx) || d_is(b, ccx)) {
            break;
        }
        if d_is(c"(", ccx) || d_is(c"[", ccx) || d_is(c"{", ccx) {
            depth += 1;
        } else if d_is(c")", ccx) || d_is(c"]", ccx) || d_is(c"}", ccx) {
            if depth == 0 {
                break;
            }
            depth -= 1;
        }
        out.push(dcur(ccx));
        ccx.d_pos += 1;
    }
    out
}

// ---- Specifiers ----

pub const SP_TYPEDEF: i64 = 1;

pub const SP_EXTERN: i64 = 2;

pub const SP_STATIC: i64 = 4;

pub const SP_INLINE: i64 = 8;

pub const SP_NORETURN: i64 = 16;

pub const SP_CONST: i64 = 32;

pub const SP_THREAD: i64 = 64;

pub fn is_qualifier(s: *u8) -> bool {
    let names: [*u8; 17] = [c"const", c"__const", c"volatile", c"__volatile", c"__volatile__",
        c"restrict", c"__restrict", c"__restrict__", c"_Nullable", c"_Nonnull",
        c"_Null_unspecified", c"_Nullable_result", c"__nullable", c"__nonnull",
        c"__unaligned", c"__ptr64", c"__ptr32"];
    for i in 0..17 {
        if streq(s, names[i]) {
            return true;
        }
    }
    false
}

pub fn is_type_keyword(s: *u8) -> bool {
    let names: [*u8; 33] = [c"void", c"char", c"short", c"int", c"long", c"float", c"double",
        c"signed", c"__signed", c"__signed__", c"unsigned", c"_Bool", c"_Complex", c"__complex__",
        c"__int128", c"__int128_t", c"__uint128_t", c"_Float16", c"_Float32", c"_Float64",
        c"_Float128", c"_Float32x", c"_Float64x", c"__float128", c"__fp16", c"__bf16",
        c"struct", c"union", c"enum", c"__builtin_va_list", c"__typeof__", c"__typeof", c"typeof"];
    for i in 0..33 {
        if streq(s, names[i]) {
            return true;
        }
    }
    false
}

pub fn is_storage_word(s: *u8) -> bool {
    streq(s, c"typedef") || streq(s, c"extern") || streq(s, c"static") || streq(s, c"auto")
        || streq(s, c"register") || streq(s, c"_Thread_local") || streq(s, c"__thread")
        || streq(s, c"inline") || streq(s, c"__inline") || streq(s, c"__inline__")
        || streq(s, c"_Noreturn") || streq(s, c"__extension__") || streq(s, c"_Alignas")
        || streq(s, c"__attribute__") || streq(s, c"__attribute") || streq(s, c"_Atomic")
}

pub fn typedef_of(sym: i64, ccx: CImportCx<Comp>) -> i64 {
    ccx.typedef_of.get(sym + 1) - 1
}

// Whether token k starts a type name (for casts, sizeof, parameters).
pub fn d_starts_type(k: i64, ccx: CImportCx<Comp>) -> bool {
    unsafe {
        let t = dpeek(k, ccx);
        if t == C_EOF || CTOKS[t].kind != CK::Ident {
            return false;
        }
        let s = ctok_text(t);
        is_type_keyword(s) || is_qualifier(s) || is_storage_word(s)
            || typedef_of(CTOKS[t].text, ccx) >= 0
    }
}

// Declaration specifiers: the base type and SP_* flags.
pub fn d_specifiers(ccx: inout CImportCx<Comp>) -> (i64, i64) {
    unsafe {
        var flags = 0;
        var other = 0;
        var n_void = 0;
        var n_char = 0;
        var n_short = 0;
        var n_int = 0;
        var n_long = 0;
        var n_float = 0;
        var n_double = 0;
        var n_signed = 0;
        var n_unsigned = 0;
        var n_bool = 0;
        var bad = -1;
        var seen = false;
        while ccx.d_pos < ccx.d_n {
            let t = dcur(ccx);
            if CTOKS[t].kind != CK::Ident {
                break;
            }
            let s = ctok_text(t);
            if streq(s, c"__attribute__") || streq(s, c"__attribute") || streq(s, c"__declspec") {
                d_attributes(&ccx);
                continue;
            }
            if is_qualifier(s) {
                if streq(s, c"const") || streq(s, c"__const") {
                    flags |= SP_CONST;
                }
                ccx.d_pos += 1;
                continue;
            }
            if streq(s, c"_Atomic") {
                if d_is_at(1, c"(", ccx) {
                    d_fail(c"_Atomic", &ccx);
                    break;
                }
                ccx.d_pos += 1;
                continue;
            }
            if streq(s, c"_Alignas") || streq(s, c"alignas") {
                ccx.d_pos += 1;
                let (v, ok) = d_paren_value(&ccx);
                if ok {
                    ccx.a_align = v;
                }
                continue;
            }
            let storage = if streq(s, c"typedef") { SP_TYPEDEF }
                else if streq(s, c"extern") { SP_EXTERN } else if streq(s, c"static") { SP_STATIC }
                else if streq(s, c"inline") || streq(s, c"__inline")
                || streq(s, c"__inline__") { SP_INLINE }
                else if streq(s, c"_Noreturn") { SP_NORETURN }
                else if streq(s, c"_Thread_local") || streq(s, c"__thread") { SP_THREAD }
                else if streq(s, c"auto") || streq(s, c"register")
                || streq(s, c"__extension__") { -1 } else { 0 };
            if storage != 0 {
                if storage > 0 {
                    flags |= storage;
                }
                ccx.d_pos += 1;
                continue;
            }
            if streq(s, c"void") { n_void += 1; }
            else if streq(s, c"char") { n_char += 1; }
            else if streq(s, c"short") { n_short += 1; }
            else if streq(s, c"int") { n_int += 1; }
            else if streq(s, c"long") { n_long += 1; }
            else if streq(s, c"float") { n_float += 1; }
            else if streq(s, c"double") { n_double += 1; }
            else if streq(s, c"signed") || streq(s, c"__signed")
                || streq(s, c"__signed__") { n_signed += 1; }
            else if streq(s, c"unsigned") { n_unsigned += 1; }
            else if streq(s, c"_Bool") { n_bool += 1; }
            else if streq(s, c"_Complex")
                || streq(s, c"__complex__") { bad = intern_c(c"_Complex"); }
            else if streq(s, c"__int128") || streq(s, c"__int128_t")
                || streq(s, c"__uint128_t") { bad = intern_c(c"__int128"); }
            else if streq(s, c"_Float32") { other = ccx.cty_f32; }
            else if streq(s, c"_Float64") || streq(s, c"_Float32x") { other = ccx.cty_f64; }
            else if streq(s, c"_Float16") || streq(s, c"__fp16")
                || streq(s, c"__bf16") { bad = intern_c(c"a 16-bit float"); }
            else if streq(s, c"_Float128") || streq(s, c"_Float64x")
                || streq(s, c"__float128") { bad = intern_c(c"a 128-bit float"); }
            else if streq(s, c"__builtin_va_list") { other = c_va_list(&ccx); }
            else if streq(s, c"struct") || streq(s, c"union") {
                ccx.d_pos += 1;
                other = d_record(streq(s, c"union"), &ccx);
                seen = true;
                continue;
            } else if streq(s, c"enum") {
                ccx.d_pos += 1;
                other = d_enum(&ccx);
                seen = true;
                continue;
            } else if streq(s, c"__typeof__") || streq(s, c"__typeof") || streq(s, c"typeof") {
                ccx.d_pos += 1;
                d_skip_parens(&ccx);
                bad = intern_c(c"typeof");
                seen = true;
                continue;
            } else if !seen && typedef_of(CTOKS[t].text, ccx) >= 0 {
                other = cty_new(Named, typedef_of(CTOKS[t].text, ccx), 0, 0, 0, &ccx);
            } else {
                break;
            }
            seen = true;
            ccx.d_pos += 1;
        }
        if bad >= 0 {
            return (cty_new(Bad, bad, 0, 0, 0, &ccx), flags);
        }
        if other != 0 {
            return (other, flags);
        }
        if n_void > 0 {
            return (ccx.cty_void, flags);
        }
        if n_bool > 0 {
            return (ccx.cty_bool, flags);
        }
        if n_float > 0 {
            return (ccx.cty_f32, flags);
        }
        if n_double > 0 {
            if n_long > 0 {
                return (if ccx.c_long_double_64 { ccx.cty_f64 }
                    else { cty_bad(c"long double", &ccx) }, flags);
            }
            return (ccx.cty_f64, flags);
        }
        if n_char > 0 {
            // Plain char is vole's byte, u8 (the type of c"..." strings).
            return (cty_int(8, n_signed > 0, ccx), flags);
        }
        let signed = n_unsigned == 0;
        if n_short > 0 {
            return (cty_int(16, signed, ccx), flags);
        }
        if n_long > 0 {
            return (cty_int(64, signed, ccx), flags);
        }
        if n_int > 0 || n_signed > 0 || n_unsigned > 0 || flags != 0 {
            return (cty_int(32, signed, ccx), flags);
        }
        d_fail(c"a declaration without a type", &ccx);
        (cty_int(32, signed: true, ccx: ccx), flags)
    }
}

// __builtin_va_list: `char *` on Apple's arm64, an array of one
// struct __va_list_tag on x86-64, struct __va_list on AArch64 Linux.
fn c_va_list(ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        if ccx.c_va_list != 0 {
            return ccx.c_va_list;
        }
        if ccx.c_target_a64_linux {
            let r = crec_new(intern_c(c"__va_list"), is_union: false, ccx: &ccx);
            ccx.tag_of.put(ccx.crecs[r].tag + 1, r * 4 + 1);
            let names: [*u8; 5] = [c"__stack", c"__gr_top", c"__vr_top", c"__gr_offs",
                c"__vr_offs"];
            let start = CINTS.count;
            for i in 0..5 {
                let ty = if i < 3 { cty_ptr(ccx.cty_void, &ccx) }
                    else { cty_int(32, signed: true, ccx: ccx) };
                CINTS.push(cfield_new(intern_c(names[i]), ty, -1, 0, &ccx));
            }
            ccx.crecs[r].fields = start;
            ccx.crecs[r].field_count = 5;
            ccx.crecs[r].complete = 1;
            ccx.c_va_list = ccx.crecs[r].ty;
            return ccx.c_va_list;
        }
        if !ccx.c_target_x86 {
            ccx.c_va_list = cty_ptr(cty_int(8, signed: false, ccx: ccx), &ccx);
            return ccx.c_va_list;
        }
        let r = crec_new(intern_c(c"__va_list_tag"), is_union: false, ccx: &ccx);
        ccx.tag_of.put(ccx.crecs[r].tag + 1, r * 4 + 1);
        let names: [*u8; 4] = [c"gp_offset", c"fp_offset", c"overflow_arg_area", c"reg_save_area"];
        ccx.crecs[r].fields = CINTS.count;
        let start = CINTS.count;
        for i in 0..4 {
            let ty = if i < 2 { cty_int(32, signed: false, ccx: ccx) }
                else { cty_ptr(ccx.cty_void, &ccx) };
            CINTS.push(cfield_new(intern_c(names[i]), ty, -1, 0, &ccx));
        }
        ccx.crecs[r].fields = start;
        ccx.crecs[r].field_count = 4;
        ccx.crecs[r].complete = 1;
        ccx.c_va_list = cty_new(Array, ccx.crecs[r].ty, 1, 0, 0, &ccx);
        ccx.c_va_list
    }
}

fn cfield_new(name: i64, ty: i64, bits: i64, align: i64, ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        ccx.cfields = grow(ccx.cfields, ccx.cfield_count, &ccx.cfield_cap);
        ccx.cfields[ccx.cfield_count] = CField {
            name, ty, bits, align_attr: align, offset: 0, bit_offset: 0,
        };
    }
    ccx.cfield_count += 1;
    ccx.cfield_count - 1
}

// `struct` or `union` (already read) [attributes] [tag] [{ fields }].
fn d_record(is_union: bool, ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        let saved = (ccx.a_packed, ccx.a_align);
        ccx.a_packed = false;
        ccx.a_align = 0;
        d_attributes(&ccx);
        var tag = -1;
        // (0.25.2: where it is, for the language server: its tag, else `{`)
        var tag_tok = dcur(ccx);
        if dcur(ccx) != C_EOF && CTOKS[dcur(ccx)].kind == CK::Ident
            && !d_is(c"__attribute__", ccx) {
            tag = CTOKS[dcur(ccx)].text;
            ccx.d_pos += 1;
        }
        d_attributes(&ccx);
        let kind = if is_union { 1 } else { 0 };
        var r = -1;
        if tag >= 0 {
            let found = ccx.tag_of.get(tag + 1) - 1;
            if found >= 0 && found % 4 == kind {
                r = found / 4;
            }
        }
        if !d_is(c"{", ccx) {
            if r < 0 {
                r = crec_new(tag, is_union, &ccx);
                if tag >= 0 {
                    ccx.tag_of.put(tag + 1, r * 4 + kind + 1);
                }
            }
            origin_note(ORIGIN_RECORD, r, if tag >= 0 { tag_tok } else { -1 }, 0, 0,
                replace: false, ccx: &ccx);
            let (p, a) = saved;
            ccx.a_packed = p;
            ccx.a_align = a;
            return ccx.crecs[r].ty;
        }
        if r < 0 || ccx.crecs[r].complete != 0 {
            r = crec_new(tag, is_union, &ccx);
            if tag >= 0 {
                ccx.tag_of.put(tag + 1, r * 4 + kind + 1);
            }
        }
        let packed_before = ccx.a_packed;
        let align_before = ccx.a_align;
        if tag < 0 {
            tag_tok = dcur(ccx);
        }
        ccx.d_pos += 1;
        ccx.crecs[r].pack = ccx.d_pack;
        var fields = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        while !d_is(c"}", ccx) && ccx.d_pos < ccx.d_n {
            d_pack_markers(&ccx);
            if d_is(c"}", ccx) {
                break;
            }
            if d_eat(c";", &ccx) {
                continue;
            }
            if d_is(c"_Static_assert", ccx) || d_is(c"static_assert", ccx) {
                while !d_is(c";", ccx) && ccx.d_pos < ccx.d_n {
                    ccx.d_pos += 1;
                }
                continue;
            }
            let outer = (ccx.a_packed, ccx.a_align, ccx.a_mode, ccx.a_vector);
            ccx.a_align = 0;
            ccx.a_mode = 0;
            ccx.a_vector = false;
            let (base, _) = d_specifiers(&ccx);
            if d_is(c";", ccx) {
                // An anonymous struct or union member (C11).
                let rb = ccx.ctypes[base].kind == Record && ccx.crecs[ccx.ctypes[base].a].tag < 0;
                if rb {
                    ccx.crecs[ccx.ctypes[base].a].parent = r;
                    fields.push(cfield_new(-1, base, -1, ccx.a_align, &ccx));
                }
                ccx.d_pos += 1;
                let (p, a, m, v) = outer;
                ccx.a_packed = p;
                ccx.a_mode = m;
                ccx.a_vector = v;
                ccx.a_align = a;
                continue;
            }
            loop {
                let field_align_before = ccx.a_align;
                var name = -1;
                var ty = base;
                if !d_is(c":", ccx) {
                    ccx.d_name_tok = -1;
                    let (n, t) = d_declarator(base, &ccx);
                    name = n;
                    ty = t;
                }
                var bits = -1;
                if d_eat(c":", &ccx) {
                    let at = dcur(ccx);
                    let list = d_collect_until(c",", c";", &ccx);
                    let (v, _) = eval_tokens(list, at, true, &ccx);
                    if EV_FAIL {
                        d_fail(c"a bit-field width", &ccx);
                    }
                    bits = v as i64;
                }
                d_attributes(&ccx);
                ty = apply_mode(ty, &ccx);
                let fa = if ccx.a_align > field_align_before { ccx.a_align }
                    else { field_align_before };
                let fi = cfield_new(name, ty, bits, fa, &ccx);
                fields.push(fi);
                if name >= 0 && ccx.d_name_tok >= 0 {
                    let line = ctok_line(ccx.d_name_tok);
                    origin_note(ORIGIN_FIELD, fi, ccx.d_name_tok, line, line, replace: false,
                        ccx: &ccx);
                }
                ccx.a_align = 0;
                if !d_eat(c",", &ccx) {
                    break;
                }
            }
            d_expect(c";", &ccx);
            let (p, a, m, v) = outer;
            ccx.a_packed = p;
            ccx.a_mode = m;
            ccx.a_vector = v;
            ccx.a_align = a;
        }
        d_expect(c"}", &ccx);
        if tag_tok != C_EOF && ccx.d_pos > 0 {
            // (0.25.2) its definition: from the tag to `}`
            origin_note(ORIGIN_RECORD, r, tag_tok, ctok_line(tag_tok), ctok_line(dpeek(-1, ccx)),
                replace: true, ccx: &ccx);
        }
        ccx.a_packed = packed_before;
        ccx.a_align = align_before;
        d_attributes(&ccx);
        ccx.crecs[r].packed = ccx.a_packed as i64;
        ccx.crecs[r].align_attr = ccx.a_align;
        ccx.crecs[r].fields = CINTS.count;
        for i in 0..fields.count {
            CINTS.push(fields.data[i]);
        }
        ccx.crecs[r].field_count = fields.count;
        ccx.crecs[r].complete = 1;
        let (p, a) = saved;
        ccx.a_packed = p;
        ccx.a_align = a;
        ccx.crecs[r].ty
    }
}

// `mode(...)` on an integer type: the integer of that width.
pub fn apply_mode(t: i64, ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        if ccx.a_vector {
            return cty_bad(c"a vector type", &ccx);
        }
        if ccx.a_mode == 0 {
            return t;
        }
        if ccx.a_mode < 0 {
            return cty_bad(c"an integer of that mode", &ccx);
        }
        let r = cty_integer(t, ccx);
        if r == 0 {
            return t;
        }
        cty_int(ccx.a_mode, ccx.ctypes[r].b != 0, ccx)
    }
}

// `enum` (already read) [attributes] [tag] [: type] [{ enumerators }].
fn d_enum(ccx: inout CImportCx<Comp>) -> i64 {
    unsafe {
        let packed_before = ccx.a_packed;
        ccx.a_packed = false;
        d_attributes(&ccx);
        let leading_packed = ccx.a_packed;
        ccx.a_packed = packed_before;
        var tag = -1;
        let tag_tok = dcur(ccx);
        if dcur(ccx) != C_EOF && CTOKS[dcur(ccx)].kind == CK::Ident {
            tag = CTOKS[dcur(ccx)].text;
            ccx.d_pos += 1;
        }
        d_attributes(&ccx);
        var fixed = 0;
        if d_eat(c":", &ccx) {
            let (t, _) = d_specifiers(&ccx);
            fixed = t;
        }
        var e = -1;
        if tag >= 0 {
            let found = ccx.tag_of.get(tag + 1) - 1;
            if found >= 0 && found % 4 == 2 {
                e = found / 4;
            }
        }
        if e < 0 {
            ccx.cenums = grow(ccx.cenums, ccx.cenum_count, &ccx.cenum_cap);
            e = ccx.cenum_count;
            ccx.cenum_count += 1;
            ccx.cenums[e] = CEnum {
                tag, underlying: cty_int(32, signed: false, ccx: ccx), name: -1, ty: 0,
                has_values: 0,
            };
            ccx.cenums[e].ty = cty_new(Enum, e, 0, 0, 0, &ccx);
            if tag >= 0 {
                ccx.tag_of.put(tag + 1, e * 4 + 2 + 1);
            }
        }
        if fixed != 0 {
            ccx.cenums[e].underlying = fixed;
        }
        // (0.25.2) where it is: its tag, else its `{`; its enumerators' names
        origin_note(ORIGIN_ENUM, e, tag_tok, 0, 0, replace: d_is(c"{", ccx), ccx: &ccx);
        if !d_eat(c"{", &ccx) {
            return ccx.cenums[e].ty;
        }
        ccx.cenums[e].has_values = 1;
        let first = ccx.cenumerators.len() as i64;
        var next: i64 = 0;
        var min: i64 = 0;
        var max: u64 = 0;
        while !d_is(c"}", ccx) && ccx.d_pos < ccx.d_n {
            let t = dcur(ccx);
            if CTOKS[t].kind != CK::Ident {
                d_fail(c"an enumerator", &ccx);
                break;
            }
            ccx.d_pos += 1;
            d_attributes(&ccx);
            var value = next;
            if d_eat(c"=", &ccx) {
                let list = d_collect_until(c",", c"}", &ccx);
                let (v, vt) = eval_tokens(list, t, true, &ccx);
                if EV_FAIL {
                    d_fail(c"an enumerator's value", &ccx);
                    break;
                }
                value = if cty_signed(vt, ccx) { v as i64 } else { v as i64 };
            }
            ccx.cenumerators.push(CEnumerator {
                name: CTOKS[t].text, value, ty: e,
            });
            ccx.enumerator_of.put(CTOKS[t].text + 1, ccx.cenumerators.len() as i64);
            origin_note(ORIGIN_ENUMERATOR, ccx.cenumerators.len() as i64 - 1, t, ctok_line(t),
                ctok_line(t), replace: false, ccx: &ccx);
            if value < min {
                min = value;
            }
            if value >= 0 && value as u64 > max {
                max = value as u64;
            }
            next = value + 1;
            if !d_eat(c",", &ccx) {
                break;
            }
        }
        d_expect(c"}", &ccx);
        let saved_packed = ccx.a_packed;
        ccx.a_packed = leading_packed;
        d_attributes(&ccx);
        if fixed == 0 {
            // GCC and Clang: unsigned int when no value is negative, int
            // otherwise; wider when the values need it; the smallest with
            // `packed`.
            let neg = min < 0;
            var bits = 32;
            if ccx.a_packed {
                bits = 8;
                while bits < 64
                    && !(if neg {
                        min >= -(1 << (bits - 1) as u64)
                            && max <= ((1 << (bits - 1) as u64) - 1) as u64
                    } else { max <= ((1 << bits as u64) - 1) as u64 }) {
                        bits *= 2;
                    }
            } else if neg && (min < -2147483648 || max > 2147483647) {
                bits = 64;
            } else if !neg && max > 4294967295 {
                bits = 64;
            }
            ccx.cenums[e].underlying = cty_int(bits, neg, ccx);
        }
        ccx.a_packed = saved_packed;
        let _ = first;
        ccx.cenums[e].ty
    }
}
