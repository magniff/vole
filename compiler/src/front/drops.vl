// The own pass's part in drops (0.17; 0.26.2, docs/design/places-ir.md §5
// step 7: the drop half deleted). The places IR places and decides every
// drop (places/build.vl, places/elab.vl); what is left here, during type
// checking (check/body.vl, check/iterate.vl, patterns/mod.vl call these),
// is what the own walk's checks and the IR read:
//
// - the bindings that borrow what they bind (byref.vl BYREF, MATCH_BYREF):
//   a match reached through a reference (`match self.kind`, `match *p`,
//   `match v[i]`), a `for` loop's element of a slice or Vec, (0.25) the
//   items of a borrowing iterator (copies of a container's elements,
//   borrowed_call), a requires check's owned parameters. Moving one is
//   own.move_out; the IR makes them BORROWED locals;
// - an owned value a statement discards (`make(3);`, `let _ = make();`)
//   bound to a hidden local, `{ let __own_tmp = e; }`, which the IR drops at
//   once;
// - the statement temporaries as hidden `let`s (visit_temps, below), which
//   the view checks read (own.escape names one);
// - `needs_drop::<T>()` folded, and own.drop_view (an `impl Drop` of a type
//   that holds views), reported by report_drop_views.

use crate::base::{IntVec, intern_c};
use crate::front::ast::{
    BLOCK_DROPS_DONE, NODE_CHECKED, NODE_IN_BOUNDS, NODE_RAW, NodeKind, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::byref::{MATCH_BYREF, binds, borrowed_call, fresh, push_bindings};
use crate::front::check::{Res, define_local};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::temps::NODE_TEMP;
use crate::front::kinds::{has_drop_impl, is_owned_type, is_view_type};
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::types::{REF_SHARED, TY_UNIT, TyKind, struct_field};
use crate::places::glue::has_glue;

// Node flags (0.17, T1): on an Arm whose bindings were looked at
// (arm_drops); on a body whose parameters were (param_drops). (NO_DROP is
// byref.vl's; named here too for the checker.)
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
pub use crate::front::byref::NO_DROP;
pub const ARM_DROPS_DONE: i64 = 1 << 60;
pub const PARAM_DROPS_DONE: i64 = 1 << 61;

fn syms(pcx: &mut Ctx<Comp>) {
    if pcx.sym_tmp == 0 {
        pcx.sym_tmp = intern_c(c"__own_tmp", pcx);
        pcx.sym_needs_drop = intern_c(c"needs_drop", pcx);
        pcx.drops_sym_drop = intern_c(c"drop", pcx);
    }
}

// ---------------------------------------------------------------------------
// Rows and entries

// ---------------------------------------------------------------------------
// Placing the drops (check/body.vl)

// Whether function f is std's function `name` (or an instance of it).
fn is_std_fn(f: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    let t = if pcx.fns[f as usize].tmpl != 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    within_std(pcx.fns[t as usize].module, pcx) && pcx.fns[t as usize].node != 0
        && pcx.nodes[pcx.fns[t as usize].node as usize].a == name
}

// (0.17) Whether type t, which has `impl Drop`, holds views: own.drop_view.
// (0.25) A view reached through a type argument counts too (`impl<T> Drop
// for G<T>` with T = `[i64]`: its drop may read the view after what it
// views is gone, which nothing orders), except in std's types, whose
// generic drops only drop their elements and read none (`impl<T> Drop for
// Vec<T>` of a `Vec<[u8]>`, as Rust's `may_dangle`). Fields of a std
// template are looked at, so a std `struct P<T> { s: [u8], x: T }` with
// `impl<T> Drop` is still reported.
fn drop_reads_views(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if !is_view_type(t, pcx) {
            return false;
        }
        if pcx.types[t as usize].kind != TyKind::Struct {
            return true;
        }
        let s = pcx.types[t as usize].a;
        if pcx.structs[s as usize].tmpl == 0 {
            return true;
        }
        let tm = pcx.structs[s as usize].tmpl - 1;
        if !within_std(pcx.structs[tm as usize].module, pcx) {
            return true;
        }
        for i in 0..pcx.structs[tm as usize].field_count {
            let ft = (*struct_field(tm, i, pcx)).ty;
            if ft > 0 && is_view_type(ft, pcx) {
                return true;
            }
        }
        false
    }
}

// check_function, its parameters defined: `needs_drop::<T>()` folded;
// `impl Drop` of a view type noted (own.drop_view); a requires check's
// owned parameters borrow the caller's arguments.
pub fn param_drops(item: i64, f: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        syms(pcx);
        let body = pcx.nodes[item as usize].c;
        if pcx.fns[f as usize].tmpl != 0 && is_std_fn(f, pcx.sym_needs_drop, pcx) && body != 0
            && pcx.nodes[body as usize].a != 0 {
            let t = (pcx.tlists[pcx.fns[f as usize].targs as usize]);
            { let at_ix = pcx.nodes[body as usize].a as usize;
                pcx.nodes[at_ix].a = if has_glue(t, pcx) { 1 } else { 0 } };
        }
        if pcx.fns[f as usize].self_ty > 0 && pcx.nodes[item as usize].a == pcx.drops_sym_drop
            && has_drop_impl(pcx.fns[f as usize].self_ty, pcx)
            && drop_reads_views(pcx.fns[f as usize].self_ty, pcx) {
            pcx.drop_views.push(item);
            pcx.drop_views.push(pcx.fns[f as usize].self_ty);
        }
        if body == 0 || (pcx.nodes[body as usize].p & PARAM_DROPS_DONE) != 0 {
            return;
        }
        pcx.nodes[body as usize].p |= PARAM_DROPS_DONE;
        if crate::front::contracts::expand::is_pre_fn(f, pcx) {
            // (0.18: a requires check reads the caller's arguments in place:
            // its owned parameters borrow them, are never dropped, and
            // moving one is own.move_out)
            for i in 0..pcx.nodes[item as usize].count {
                let p = child(item, i, pcx);
                let l = pcx.nodes[p as usize].x;
                if l >= 0 && is_owned_type(pcx.locals[l as usize].ty, pcx) {
                    pcx.byref.put(l + 1, p + 1);
                }
            }
        }
    }
}

// check_block, before its statements: whether after_stmt and after_tail
// do their work there (not when done already, or with drops off).
pub fn block_begin(block: i64, pcx: &mut Ctx<Comp>) -> bool {
    if (pcx.nodes[block as usize].p & BLOCK_DROPS_DONE) != 0 {
        return false;
    }
    pcx.nodes[block as usize].p |= BLOCK_DROPS_DONE;
    true
}

// check_block, after statement stmt, checked (on: block_begin's): a value
// it discards bound to a hidden local, a `let`'s bindings that borrow, its
// temporaries (visit_temps).
pub fn after_stmt(on: bool, stmt: i64, pcx: &mut Ctx<Comp>) {
    if !on {
        return;
    }
    let k = pcx.nodes[stmt as usize].kind;
    if k == NodeKind::Let {
        let init = pcx.nodes[stmt as usize].c;
        if pcx.nodes[stmt as usize].a != 0
            && pcx.nodes[pcx.nodes[stmt as usize].a as usize].kind == NodeKind::PatWild
            && is_temp(init, pcx) {
            // (0.25: `let _ = make();` drops the value at once, as `make();`)
            pcx.nodes[stmt as usize].c = temporary(init, pcx);
            return;
        }
        if pcx.nodes[stmt as usize].a != 0
            && pcx.nodes[pcx.nodes[stmt as usize].a as usize].kind == NodeKind::PatWild && init != 0
            && is_owned_type(pcx.nodes[init as usize].ty, pcx) && is_place(init, pcx) {
            // (`let _ = x;` of an owned place moves nothing, as Rust's:
            // it reads x)
            let r = t_node(NodeKind::Unary, init,
                crate::front::types::ref_to(pcx.nodes[init as usize].ty,
                    REF_SHARED, pcx), pcx);
            pcx.nodes[r as usize].op = Tok::Amp;
            pcx.nodes[r as usize].b = init;
            pcx.nodes[stmt as usize].c = r;
            return;
        }
        let_drops(stmt, pcx);
        // (0.20: its temporaries, to the end of the statement; to the
        // end of the block when the binding may view them)
        if init != 0 && is_view_type(pcx.nodes[init as usize].ty, pcx) {
            visit_temps(init, pcx);
        } else {
            pcx.nodes[stmt as usize].c = unit_value(init, pcx);
        }
    } else if k == NodeKind::ExprStmt {
        let e = pcx.nodes[stmt as usize].a;
        if e == 0 {
            return;
        }
        if pcx.nodes[stmt as usize].b != 0 && has_glue(pcx.nodes[e as usize].ty, pcx)
            && !is_place(e, pcx) {
            pcx.nodes[stmt as usize].a = temporary(e, pcx);
        } else {
            // (0.20: its temporaries, to the end of the statement)
            pcx.nodes[stmt as usize].a = unit_value(e, pcx);
        }
    }
}

// check_block, after its tail (checked; on: block_begin's): its
// temporaries, to the end of the block (0.20).
pub fn after_tail(on: bool, block: i64, pcx: &mut Ctx<Comp>) {
    let tail = pcx.nodes[block as usize].a;
    if on && tail != 0 {
        visit_temps(tail, pcx);
    }
}

fn is_place(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        return pcx.nodes[e as usize].res == Res::Local || pcx.nodes[e as usize].res == Res::Static;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return pcx.nodes[e as usize].y == 1 || is_place(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op == Tok::Star;
    }
    k == NodeKind::Index
}

// Pattern p's owned bindings borrow what they bind (node at).
fn mark_byref(p: i64, at: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mark = list_begin(pcx);
        push_bindings(p, pcx);
        for i in mark..pcx.scratch.len() as i64 {
            let b = (pcx.scratch[i as usize]);
            let l = pcx.nodes[b as usize].x;
            if l >= 0 && is_owned_type(pcx.locals[l as usize].ty, pcx) {
                pcx.byref.put(l + 1, at + 1);
            }
        }
        pcx.scratch.truncate(mark);
    }
}

// (0.25) `e?` (check/try_op.vl), its `let ?try = e;` bound (pattern bind):
// when e is a borrowed copy (`v.last()?`), ?try borrows it, so the match
// binds ?v by reference and nothing in the desugaring drops the element.
pub fn try_let_borrows(bind: i64, operand: i64, pcx: &mut Ctx<Comp>) {
    if borrowed_call(operand, pcx) {
        mark_byref(bind, operand, pcx);
    }
}

// Closure parameter local l (node p) borrows the item it is given.
pub fn item_borrowed(l: i64, at: i64, pcx: &mut Ctx<Comp>) {
    if l >= 0 && is_owned_type(pcx.locals[l as usize].ty, pcx) {
        pcx.byref.put(l + 1, at + 1);
    }
}

// `let pat = init;`, checked: its bindings that borrow what they bind
// (BYREF), when init is a copy of an element a collection keeps
// (`v.get(i)`), a binding that borrows, destructured, or a `for` loop's
// element.
fn let_drops(stmt: i64, pcx: &mut Ctx<Comp>) {
    let pat = pcx.nodes[stmt as usize].a;
    let init = pcx.nodes[stmt as usize].c;
    if pat == 0 || init == 0 || (pcx.nodes[stmt as usize].p & NO_DROP) != 0 {
        return;
    }
    if borrowed_call(init, pcx) {
        // (a copy of an element a collection keeps: `v.get(i)`)
        mark_byref(pat, init, pcx);
        return;
    }
    if pcx.nodes[pat as usize].kind != NodeKind::PatBind
        && pcx.nodes[init as usize].kind == NodeKind::Ident
        && reached_by_ref(init, pcx) {
        // (0.25: a binding that borrows, destructured, `|(i, d)|` of a
        // borrowing iterator's item: its parts borrow, as a match on it)
        pcx.nodes[init as usize].p |= MATCH_BYREF;
        mark_byref(pat, init, pcx);
        return;
    }
    if pcx.nodes[init as usize].kind == NodeKind::Index
        && (pcx.nodes[init as usize].p & NODE_IN_BOUNDS) != 0 {
        // (a `for` loop's element: a copy of what the loop borrows)
        mark_byref(pat, init, pcx);
    }
}

// `e;` discarding an owned value e (checked): `{ let __own_tmp = e; }`,
// which drops it at once.
fn temporary(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    syms(pcx);
    let start = pcx.nodes[e as usize].start;
    let end = pcx.nodes[e as usize].end;
    pcx.nodes[e as usize].p |= NODE_CHECKED;
    let pat = new_node(NodeKind::PatBind, start, start, pcx);
    pcx.nodes[pat as usize].a = pcx.sym_tmp;
    let st = new_node(NodeKind::Let, start, end, pcx);
    pcx.nodes[st as usize].a = pat;
    pcx.nodes[st as usize].c = e;
    let b = new_node(NodeKind::Block, start, end, pcx);
    let mark = list_begin(pcx);
    list_push(st, pcx);
    list_end(b, mark, pcx);
    synth_expr(b, pcx);
    b
}

// Whether match scrutinee e is reached through a reference, an index or a
// static (or is a binding that borrows): its bindings borrow.
fn reached_by_ref(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        if pcx.nodes[e as usize].res == Res::Static {
            return true;
        }
        return pcx.nodes[e as usize].res == Res::Local && pcx.nodes[e as usize].y >= 0
            && pcx.byref.get(pcx.nodes[e as usize].y + 1) != 0;
    }
    if k == NodeKind::FieldAccess {
        return pcx.nodes[e as usize].y == 1 || reached_by_ref(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::TupleField {
        return reached_by_ref(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op == Tok::Star;
    }
    k == NodeKind::Index
}

// check_match, arm `arm` of match m, its pattern checked: a match reached
// through a reference (or a borrowed copy) binds by reference, its owned
// bindings borrowing (BYREF) and its scrutinee marked (MATCH_BYREF).
pub fn arm_drops(m: i64, arm: i64, pcx: &mut Ctx<Comp>) {
    if (pcx.nodes[arm as usize].p & ARM_DROPS_DONE) != 0 {
        return;
    }
    pcx.nodes[arm as usize].p |= ARM_DROPS_DONE;
    // (0.25: a `for` loop's `next()`, ARM_FOR_NEXT, as any match: a
    // borrowing iterator's items borrow)
    let scrutinee = pcx.nodes[m as usize].a;
    if scrutinee != 0 && (reached_by_ref(scrutinee, pcx) || borrowed_call(scrutinee, pcx)) {
        pcx.nodes[scrutinee as usize].p |= MATCH_BYREF;
        mark_byref(pcx.nodes[arm as usize].a, scrutinee, pcx);
    }
}

// ---------------------------------------------------------------------------
// The walk's records (moves.vl)

// ---------------------------------------------------------------------------
// Finishing (check_own, after the walks)

// Typed nodes for the flags.
fn t_node(kind: NodeKind, at: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(kind, pcx.nodes[at as usize].start, pcx.nodes[at as usize].start, pcx);
    pcx.nodes[n as usize].ty = ty;
    n
}

fn t_ident(l: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = t_node(NodeKind::Ident, at, pcx.locals[l as usize].ty, pcx);
    pcx.nodes[n as usize].a = pcx.locals[l as usize].name;
    pcx.nodes[n as usize].res = Res::Local;
    pcx.nodes[n as usize].y = l;
    n
}

// ---------------------------------------------------------------------------
// Statement temporaries (0.20)
//
// An owned value made by an expression and used without being moved (a
// receiver, `f()?.read()`, `make().len()`; a field read out of it,
// `make().id`; an argument a `let` parameter borrows) lives until its
// statement ends and is dropped then, after every use: Rust's rule. Its
// statement gets, in front of it, `var __own_tp: *T = 0 as *T; var
// __own_tf = false; defer { if __own_tf { unsafe { let __own_drop =
// *__own_tp; } } }` (the drop is __own_drop's), and the value becomes
// `{ var __own_tv = value; __own_tp = &__own_tv; __own_tf = true; __own_tp }`
// where it is made, in the evaluation order: a `?` or a branch that leaves
// the statement before it is made drops nothing. The value moves into
// __own_tv, so a `?`'s or a block's value is no longer dropped at the end
// of its arm (which made `f()?.m()` use a closed File). An expression
// statement's temporaries drop at its end (it becomes a block); a `let`'s,
// a tail's, at the end of their block (the `let` may keep a view of them),
// a `while` condition's at the end of each test. The nodes are made typed:
// they are not checked again.
//
// (0.25, conventions.md §2.2 "Temporaries") This is the one place a
// statement's temporaries live: a value lent to a let parameter
// (check_mode::LET_ARG), an operator's operands an impl reads, a
// scrutinee no arm takes a part of, the rest of a value a part is moved
// out of (part_drops), and a value moved into a call a later argument may
// leave before (hold_args, TV_MOVE). The block that makes one gives
// `&__own_tv` and is no scope of its own (NODE_TEMP, own/walk): views of
// it end with the statement (or the block), own.escape past that. A `let`
// keeps its temporaries to the end of the block only when it binds a view.

// Whether e is a temporary to keep to the end of the statement: new,
// owned, with a drop.
fn is_temp(e: i64, pcx: &mut Ctx<Comp>) -> bool {
    e != 0 && pcx.nodes[e as usize].ty > 0 && has_glue(pcx.nodes[e as usize].ty, pcx)
        && fresh(e, pcx)
}

fn t_let(l: i64, init: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let pat = t_node(NodeKind::PatBind, at, pcx.locals[l as usize].ty, pcx);
    pcx.nodes[pat as usize].a = pcx.locals[l as usize].name;
    pcx.nodes[pat as usize].b = 1;
    pcx.nodes[pat as usize].x = l;
    let st = t_node(NodeKind::Let, at, TY_UNIT, pcx);
    pcx.nodes[st as usize].a = pat;
    pcx.nodes[st as usize].c = init;
    pcx.nodes[st as usize].p |= NO_DROP;
    st
}

fn t_block(mark: i64, tail: i64, at: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = t_node(NodeKind::Block, at, ty, pcx);
    list_end(b, mark, pcx);
    pcx.nodes[b as usize].a = tail;
    pcx.nodes[b as usize].p |= BLOCK_DROPS_DONE;
    b
}

// Temporary e (checked, with glue), whose address its statement uses
// (`&value`, a receiver, a let argument, a part read out of it):
// temp_value's block, of type `&T`.
fn temp_ptr(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.temps_made += 1;
    temp_value(e, pcx)
}

// The number of fields (tuple parts, elements) of struct, tuple or array
// type t.
fn part_count(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind == TyKind::Struct {
        return pcx.structs[pcx.types[t as usize].a as usize].field_count;
    }
    if pcx.types[t as usize].kind == TyKind::Tuple {
        return pcx.types[t as usize].count;
    }
    if pcx.types[t as usize].kind == TyKind::Array {
        return pcx.types[t as usize].b;
    }
    0
}

// Visits expression e (checked) after its parts, in the positions
// evaluated with its statement: the temporaries it uses without moving
// them are kept (temp_ptr), the parts moved out of one leave the rest to
// drop (part_drops), a value it moves into a call is held until the call
// when a later argument may leave the statement (hold_args). Blocks were
// visited as they were checked (but an operator's, operator_temps);
// closures' bodies are their own; a `while`'s condition is its own unit.
fn visit_temps(e: i64, pcx: &mut Ctx<Comp>) {
    if e == 0 {
        return;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Block && operator_temps(e, pcx) {
        return;
    }
    if k == NodeKind::Block && crate::front::contracts::expand::requires_tail(e, pcx) > 0 {
        // (0.25.2.2: a call of a function with a requires,
        // contracts::desugar::requires_call `{ let ?aI = argI; ..;
        // f$pre(SITE, ?a0, ..); f(?a0, ..) }`, checked by hand, not as a
        // block: its arguments' temporaries are the statement's, as a
        // call's. `dev.compute_pipeline(dev.shader_wgsl(SRC)?, "e")?`
        // lent the shader dropped, a plain temporary leaked)
        for i in 0..pcx.nodes[e as usize].count {
            let s = child(e, i, pcx);
            if pcx.nodes[s as usize].kind == NodeKind::Let {
                visit_temps(pcx.nodes[s as usize].c, pcx);
            }
        }
        hold_args(e, pcx);
        return;
    }
    if k == NodeKind::Block || k == NodeKind::Closure || k == NodeKind::Loop
        || k == NodeKind::Defer || k == NodeKind::Let {
        return;
    }
    if k == NodeKind::While {
        pcx.nodes[e as usize].b = unit_value(pcx.nodes[e as usize].b, pcx);
        return;
    }
    if k == NodeKind::For {
        visit_temps(pcx.nodes[e as usize].c, pcx);
        return;
    }
    if k == NodeKind::Unary {
        // (`&make().v`: the field is borrowed, not moved)
        pcx.temp_borrow = pcx.nodes[e as usize].op == Tok::Amp;
        visit_temps(pcx.nodes[e as usize].b, pcx);
        pcx.temp_borrow = false;
        if pcx.nodes[e as usize].op == Tok::Amp && is_temp(pcx.nodes[e as usize].b, pcx) {
            // (`&value`: a receiver, a let argument; the block gives
            // the address, as `&` did)
            let ty = pcx.nodes[e as usize].ty;
            let b = temp_ptr(pcx.nodes[e as usize].b, pcx);
            pcx.nodes[e as usize] = pcx.nodes[b as usize];
            pcx.nodes[e as usize].ty = ty;
        } else if pcx.nodes[e as usize].op == Tok::Amp && lent_value(pcx.nodes[e as usize].b, pcx) {
            // (0.25: a value without glue lent the same way, `E { .. }.nm()`:
            // a local of the statement, whose views are checked as a
            // local's)
            let ty = pcx.nodes[e as usize].ty;
            let b = temp_value(pcx.nodes[e as usize].b, pcx);
            pcx.nodes[e as usize] = pcx.nodes[b as usize];
            pcx.nodes[e as usize].ty = ty;
        }
        return;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        let borrowed = pcx.temp_borrow;
        let base = pcx.nodes[e as usize].a;
        pcx.temp_borrow = borrowed && (pcx.nodes[base as usize].kind == NodeKind::FieldAccess
            || pcx.nodes[base as usize].kind == NodeKind::TupleField);
        // (0.25: a part moved out of a part, `make().a.b`: the chain is
        // the outermost node's)
        let moved_out = !borrowed && pcx.nodes[e as usize].y != 1
            && is_owned_type(pcx.nodes[e as usize].ty, pcx);
        if moved_out && part_move(e, pcx) {
            pcx.temp_borrow = false;
            return;
        }
        visit_temps(base, pcx);
        pcx.temp_borrow = false;
        // (0.24: an owned field moved out, `let x = make().v;`, is not
        // read through the temporary's address, which would drop it
        // again with the temporary: part_move, or own.partial when
        // a type on the way implements Drop)
        if pcx.nodes[e as usize].y != 1 && is_temp(pcx.nodes[e as usize].a, pcx)
            && (borrowed || !is_owned_type(pcx.nodes[e as usize].ty, pcx)) {
            // (`make().id`: read through the address)
            pcx.nodes[e as usize].a = temp_ptr(pcx.nodes[e as usize].a, pcx);
            if k == NodeKind::FieldAccess {
                pcx.nodes[e as usize].y = 1;
                pcx.nodes[e as usize].p |= NODE_RAW;
            } else {
                // (`make().1`: a tuple part of the temporary, `(*&tv).1`)
                pcx.nodes[e as usize].a = deref_of(pcx.nodes[e as usize].a, pcx);
            }
        }
        return;
    }
    if k == NodeKind::Binary || k == NodeKind::Assign || k == NodeKind::Index
        || k == NodeKind::Range || k == NodeKind::If {
        if k == NodeKind::If {
            // RULE: L3 (0.27.3: in the rust edition an `if`'s condition is a
            // terminating scope, its temporaries dropped before a branch
            // runs, as a `while`'s; MVS keeps them to the statement's end)
            pcx.nodes[e as usize].a = unit_value(pcx.nodes[e as usize].a, pcx);
            visit_temps(pcx.nodes[e as usize].b, pcx);
            visit_temps(pcx.nodes[e as usize].c, pcx);
            return;
        }
        if k == NodeKind::Index && !pcx.temp_borrow
            && is_owned_type(pcx.nodes[e as usize].ty, pcx) {
            // (0.25: an element moved out of an array temporary,
            // `make()[1]`; by a run-time index the others would leak)
            if part_move(e, pcx) {
                return;
            }
            let base = pcx.nodes[e as usize].a;
            if is_temp(base, pcx)
                && pcx.types[pcx.nodes[base as usize].ty as usize].kind == TyKind::Array {
                temp_element_error(e, pcx);
            }
        }
        if k == NodeKind::Index || k == NodeKind::Range {
            visit_temps(pcx.nodes[e as usize].a, pcx);
            visit_temps(pcx.nodes[e as usize].b, pcx);
            return;
        }
        visit_temps(pcx.nodes[e as usize].b, pcx);
        visit_temps(pcx.nodes[e as usize].c, pcx);
        return;
    }
    if k == NodeKind::Cast || k == NodeKind::Return || k == NodeKind::Repeat
        || k == NodeKind::EnumPanic {
        visit_temps(pcx.nodes[e as usize].a, pcx);
        return;
    }
    if k == NodeKind::Break || k == NodeKind::FieldInit || k == NodeKind::NamedArg {
        visit_temps(pcx.nodes[e as usize].b, pcx);
        return;
    }
    if k == NodeKind::Try {
        // (0.25.2.1: its desugaring, `{ let ?try = e; match ?try { .. } }`
        // (check/try_op.vl), is checked by hand, not as a block: the
        // temporaries of e are its statement's. `f(make()?, 8)?` lent
        // the argument by its address, unkept: the match's `?v` was
        // dropped under it, a leak without the inner `?`)
        let y = pcx.nodes[e as usize].y;
        if y > 0 && pcx.nodes[y as usize].kind == NodeKind::Block && pcx.nodes[y as usize].count > 0
            && pcx.nodes[child(y, 0, pcx) as usize].kind == NodeKind::Let {
            visit_temps(pcx.nodes[child(y, 0, pcx) as usize].c, pcx);
            return;
        }
        visit_temps(y, pcx);
        return;
    }
    if k == NodeKind::Interp {
        // (the holes, then what the f-string became)
        for i in 0..pcx.nodes[e as usize].count {
            let h = child(e, i, pcx);
            if pcx.nodes[h as usize].kind == NodeKind::InterpHole {
                visit_temps(pcx.nodes[h as usize].a, pcx);
            }
        }
        let y = pcx.nodes[e as usize].y;
        if y > 0 && pcx.nodes[y as usize].kind == NodeKind::Block {
            // (a call written in place, check/interp.vl direct_call:
            // its holes are the values of its `let`s)
            for i in 0..pcx.nodes[y as usize].count {
                let s = child(y, i, pcx);
                if pcx.nodes[s as usize].kind == NodeKind::Let {
                    visit_temps(pcx.nodes[s as usize].c, pcx);
                }
            }
        } else {
            visit_temps(y, pcx);
        }
        return;
    }
    if k == NodeKind::Match {
        visit_temps(pcx.nodes[e as usize].a, pcx);
        for i in 0..pcx.nodes[e as usize].count {
            let arm = child(e, i, pcx);
            // RULE: L3 (0.27.3: a guard is a terminating scope in the rust
            // edition, as an `if`'s condition)
            pcx.nodes[arm as usize].b = unit_value(pcx.nodes[arm as usize].b, pcx);
            visit_temps(pcx.nodes[arm as usize].c, pcx);
        }
        // (0.25: an owned temporary matched with no binding that takes
        // a part of it, `match make() { E::A(_) => .. }`: matched where
        // it is kept, and dropped with the statement)
        let s = pcx.nodes[e as usize].a;
        if is_temp(s, pcx) && !match_binds_owned(e, pcx) {
            pcx.nodes[e as usize].a = deref_of(temp_ptr(s, pcx), pcx);
        }
        return;
    }
    if k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::VecOp {
        if k == NodeKind::MethodCall || k == NodeKind::VecOp || pcx.nodes[e as usize].x == 0 {
            visit_temps(pcx.nodes[e as usize].a, pcx);
        }
        for i in 0..pcx.nodes[e as usize].count {
            visit_temps(child(e, i, pcx), pcx);
        }
        hold_args(e, pcx);
        return;
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
        || k == NodeKind::VariantLit {
        for i in 0..pcx.nodes[e as usize].count {
            visit_temps(child(e, i, pcx), pcx);
        }
        if k == NodeKind::StructLit {
            // (0.25.2.2: a let field given a branch's value, hold_args)
            hold_args(e, pcx);
        }
    }
}

// `*b` of the block b temp_make made (of type `&T`): the temporary as a
// place.
fn deref_of(b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = t_node(NodeKind::Unary, b, pcx.types[pcx.nodes[b as usize].ty as usize].a, pcx);
    pcx.nodes[n as usize].op = Tok::Star;
    pcx.nodes[n as usize].b = b;
    n
}

// (0.25) Whether `&v` lends value v as a temporary of no glue (`&E { .. }`,
// a receiver; a let argument): v is no place, and has storage.
fn lent_value(v: i64, pcx: &mut Ctx<Comp>) -> bool {
    let t = pcx.nodes[v as usize].ty;
    if t <= 0 || has_glue(t, pcx) || is_place(v, pcx) {
        return false;
    }
    let k = pcx.nodes[v as usize].kind;
    (k == NodeKind::Call || k == NodeKind::StructLit || k == NodeKind::Tuple
        || k == NodeKind::Array || k == NodeKind::VariantLit || k == NodeKind::Repeat)
        && (pcx.types[t as usize].kind == TyKind::Struct
            || pcx.types[t as usize].kind == TyKind::Tuple
            || pcx.types[t as usize].kind == TyKind::Array
            || pcx.types[t as usize].kind == TyKind::Enum)
}

// (0.25) Value v lent as a temporary: `{ var __own_tv = v; &__own_tv }`, a
// block that is no scope of its own (own/walk), so that __own_tv lives as
// long as the statement, and views of it are checked as views of a local
// of it.
fn temp_value(v: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.sym_tv == 0 {
        pcx.sym_tv = intern_c(c"__own_tv", pcx);
    }
    let t = pcx.nodes[v as usize].ty;
    let tv = define_local(pcx.sym_tv, t, true, false, pcx);
    pcx.temp_src.put(tv + 1, v + 1);
    let m = list_begin(pcx);
    list_push(t_let(tv, v, v, pcx), pcx);
    let rt = crate::front::types::ref_to(t, REF_SHARED, pcx);
    let addr = t_node(NodeKind::Unary, v, rt, pcx);
    pcx.nodes[addr as usize].op = Tok::Amp;
    pcx.nodes[addr as usize].b = t_ident(tv, v, pcx);
    let b = t_block(m, addr, v, rt, pcx);
    pcx.nodes[b as usize].p |= NODE_TEMP;
    pcx.nodes[b as usize].end = pcx.nodes[v as usize].end;
    b
}

// (0.25) Whether an arm of match m binds an owned part of what it matches.
fn match_binds_owned(m: i64, pcx: &mut Ctx<Comp>) -> bool {
    for i in 0..pcx.nodes[m as usize].count {
        if crate::front::byref::pattern_binds_owned(pcx.nodes[child(m, i, pcx) as usize].a, pcx) {
            return true;
        }
    }
    false
}

// (0.25) borrowck.move_out: `make()[i]`, an owned element moved out of an array
// temporary by a run-time index (the other elements have no owner left).
fn temp_element_error(e: i64, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.move_out";
    crate::base::diag::err_begin(pcx.nodes[e as usize].start, pcx);
    let text = &crate::base::get_src()[
        pcx.nodes[e as usize].start as usize..pcx.nodes[e as usize].end as usize];
    crate::base::diag::err_fmt({
        let text = str::from_utf8(text).unwrap(); format_args("'{text}'")
    }, pcx);
    crate::base::diag::err_str(c" moves an element out of a temporary array by a run-time index: the other elements would not be dropped", pcx);
    crate::base::diag::err_help(c"index it by a constant, or bind the array first ('let a = VALUE;') and take the element from it", pcx);
    crate::base::diag::err_end_soft(pcx);
    pcx.err_kind = saved;
}

// (0.25) e, a field, tuple part or array element (by a constant) moved
// out of a part chain over an owned temporary (`let a = make().a;`,
// `make().1.b`, `make()[1]`): the temporary is kept and the part read out
// of it, the rest dropped with the statement (part_drops); false, nothing
// done, for another chain, or one through a type with `impl Drop`
// (own.partial, the own walk).
fn part_move(e: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut c = e;
    while is_part_node(c, pcx) {
        let base = pcx.nodes[c as usize].a;
        let bt = pcx.nodes[base as usize].ty;
        if bt <= 0 || has_drop_impl(bt, pcx) || part_count(bt, pcx) == 0 {
            return false;
        }
        if !is_part_node(base, pcx) {
            break;
        }
        c = base;
    }
    if !is_part_node(c, pcx) {
        return false;
    }
    let base = pcx.nodes[c as usize].a;
    if !is_temp(base, pcx) {
        return false;
    }
    visit_temps(base, pcx);
    let b = temp_ptr(base, pcx);
    pcx.nodes[c as usize].a = deref_of(b, pcx);
    { let at_ix = pcx.nodes[c as usize].a as usize; pcx.nodes[at_ix].p |= NODE_RAW };
    // (the chain reads the temporary's storage, which keeps the part
    // no longer: no own.move_out of an index)
    let mut d = e;
    while d != pcx.nodes[c as usize].a {
        pcx.nodes[d as usize].p |= NODE_RAW;
        d = pcx.nodes[d as usize].a;
    }
    true
}

// Whether n takes a part of its base where it is (a field, a tuple part,
// an element of an array by a constant), not through a pointer.
fn is_part_node(n: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::FieldAccess {
        return pcx.nodes[n as usize].y != 1;
    }
    if k == NodeKind::TupleField {
        return true;
    }
    let base = pcx.nodes[n as usize].a;
    k == NodeKind::Index && pcx.nodes[pcx.nodes[n as usize].b as usize].kind == NodeKind::Int
        && pcx.nodes[base as usize].ty > 0
        && pcx.types[pcx.nodes[base as usize].ty as usize].kind == TyKind::Array
}

// (0.25) Call e (0.25.2.2: or a requires check's block, or a struct
// literal, whose fields are its arguments), its arguments visited: an
// owned value an argument moves into the callee (`two(mk(1), g()?)`)
// while a later argument may leave the statement (`?`, `return`, `break`)
// is held as a temporary, its flag cleared once the last argument is
// evaluated: the statement leaving before the call drops it, once (hold,
// a function's call).
//
// (0.25.2.1) First, an argument lent to a let parameter (of type `&T`)
// whose value is a branch's: a `match` (`count(match make() { Ok(s) => s,
// Err(e) => return Err(e) }, 8)`), an `if`, a block, a `?` in one of
// them. Each value was checked against `&T`, `&s`: a local declared in the
// argument (a `let` of a block or a binding of an arm on the way to it),
// which dies before the call, is moved into a temporary of the statement
// instead (it was lent dropped).
fn hold_args(e: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        // (0.25.2.2: a requires check's block, `{ let ?aI = argI; ..; f$pre(..);
        // f(?a0, ..) }`: its lets' values, in order, are the arguments)
        let mut vals = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..pcx.nodes[e as usize].count {
            let c = child(e, i, pcx);
            if pcx.nodes[e as usize].kind != NodeKind::Block {
                // (a named argument's value; 0.25.2.2: a struct literal's
                // field's, `Desc { s: make()?, n: 1 }` with s a let field)
                let named = pcx.nodes[c as usize].kind == NodeKind::NamedArg
                    || pcx.nodes[c as usize].kind == NodeKind::FieldInit;
                vals.push(if named { pcx.nodes[c as usize].b } else { c });
            } else if pcx.nodes[c as usize].kind == NodeKind::Let {
                vals.push(pcx.nodes[c as usize].c);
            }
        }
        for ai in 0..vals.len() as i64 {
            let a = (vals[ai as usize]);
            let at = pcx.nodes[a as usize].ty;
            let ak = pcx.nodes[a as usize].kind;
            if at <= 0 || pcx.types[at as usize].kind != TyKind::Ptr
                || pcx.types[at as usize].b != REF_SHARED
                || ak != NodeKind::Match && ak != NodeKind::If && ak != NodeKind::Block
                && ak != NodeKind::Try || (pcx.nodes[a as usize].p & NODE_TEMP) != 0 {
                continue;
            }
            // (a walk with a stack of (node, the count of the scopes above
            // it, a scope it adds): the blocks and arms on the way)
            let mut todo = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut scopes = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            todo.push(a);
            todo.push(0);
            todo.push(0);
            while todo.len() as i64 > 0 {
                let adds = (todo[(todo.len() as i64 - 1) as usize]);
                scopes.truncate((todo[(todo.len() as i64 - 2) as usize]));
                let n = (todo[(todo.len() as i64 - 3) as usize]);
                todo.truncate(todo.len() as i64 - 3);
                if adds != 0 {
                    scopes.push(adds);
                }
                if n <= 0 {
                    continue;
                }
                let k = pcx.nodes[n as usize].kind;
                let mut next = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
                if k == NodeKind::Block {
                    next.push(pcx.nodes[n as usize].a);
                    next.push(n);
                } else if k == NodeKind::Try {
                    next.push(pcx.nodes[n as usize].y);
                    next.push(0);
                } else if k == NodeKind::If {
                    next.push(pcx.nodes[n as usize].b);
                    next.push(0);
                    next.push(pcx.nodes[n as usize].c);
                    next.push(0);
                } else if k == NodeKind::Match {
                    for i in 0..pcx.nodes[n as usize].count {
                        let arm = child(n, i, pcx);
                        next.push(pcx.nodes[arm as usize].c);
                        next.push(arm);
                    }
                } else if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Amp {
                    let b = pcx.nodes[n as usize].b;
                    let l = pcx.nodes[b as usize].y;
                    if pcx.nodes[b as usize].kind != NodeKind::Ident
                        || pcx.nodes[b as usize].res != Res::Local || l < 0
                        || pcx.byref.get(l + 1) != 0
                        || !is_owned_type(pcx.nodes[b as usize].ty, pcx)
                        || !has_glue(pcx.nodes[b as usize].ty, pcx) {
                        continue;
                    }
                    let mut inside = false;
                    for j in 0..scopes.len() as i64 {
                        let s = (scopes[j as usize]);
                        if pcx.nodes[s as usize].kind == NodeKind::Arm {
                            inside = inside || binds(pcx.nodes[s as usize].a, l, pcx);
                            continue;
                        }
                        for m in 0..pcx.nodes[s as usize].count {
                            let st = child(s, m, pcx);
                            inside = inside
                                || pcx.nodes[st as usize].kind == NodeKind::Let
                                && pcx.nodes[st as usize].a != 0
                                && binds(pcx.nodes[st as usize].a, l, pcx);
                        }
                    }
                    if inside {
                        let ty = pcx.nodes[n as usize].ty;
                        let t = temp_ptr(b, pcx);
                        pcx.nodes[n as usize] = pcx.nodes[t as usize];
                        pcx.nodes[n as usize].ty = ty;
                    }
                }
                let depth = scopes.len() as i64;
                let mut i: i64 = 0;
                while i < next.len() as i64 {
                    todo.push((next[i as usize]));
                    todo.push(depth);
                    todo.push((next[(i + 1) as usize]));
                    i += 2;
                }
            }
        }
    }
}

// (0.25) Operator block e (traits::operator_call: `{ let ==l = a; let ==r =
// b; ==l.add(==r) }`): an operand an impl reads (`==`, a let parameter)
// that is an owned temporary is kept and dropped with the statement (it
// was read and never dropped); one it takes (`=+`) moves on. Whether e is
// one.
fn operator_temps(e: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.nodes[e as usize].count == 0 {
        return false;
    }
    let s0 = child(e, 0, pcx);
    if pcx.nodes[s0 as usize].kind != NodeKind::Let || pcx.nodes[s0 as usize].a == 0
        || pcx.nodes[pcx.nodes[s0 as usize].a as usize].kind != NodeKind::PatBind {
        return false;
    }
    let w = crate::base::sym_text(pcx.nodes[pcx.nodes[s0 as usize].a as usize].a, pcx);
    if w != b"==l" && w != b"=+l" {
        return false;
    }
    for i in 0..pcx.nodes[e as usize].count {
        let s = child(e, i, pcx);
        if pcx.nodes[s as usize].kind != NodeKind::Let || pcx.nodes[s as usize].a == 0
            || pcx.nodes[pcx.nodes[s as usize].a as usize].kind != NodeKind::PatBind {
            continue;
        }
        visit_temps(pcx.nodes[s as usize].c, pcx);
        let name = crate::base::sym_text(pcx.nodes[pcx.nodes[s as usize].a as usize].a, pcx);
        if name.len() > 1 && name[1] == b'=' && is_temp(pcx.nodes[s as usize].c, pcx) {
            pcx.nodes[s as usize].c = deref_of(temp_ptr(pcx.nodes[s as usize].c, pcx), pcx);
        }
    }
    true
}

// Expression e (checked), a unit of its own (an expression statement, a
// `let`'s value that binds no view, a `while` condition): its temporaries
// end when it is evaluated, `{ e }` when it made one.
fn unit_value(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if e == 0 {
        return e;
    }
    let made = pcx.temps_made;
    visit_temps(e, pcx);
    if pcx.temps_made == made {
        return e;
    }
    t_block(list_begin(pcx), e, e, pcx.nodes[e as usize].ty, pcx)
}
