// `#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15;
// docs/design/errors-formatting.md): before the names are collected, each
// derive of a struct or enum (its `h`, a holder of TyNames) becomes an
// `impl` item appended to the program, whose functions (flagged
// FN_DERIVED, spans the derive attribute's) are syntactic: they call
// std's generic helpers (`eq_of`, `cmp_of`, `hash_of`, `clone_of`,
// `Fmt::debug`), so no type is needed to make them. On a generic type each
// parameter is bounded by the trait. Eq compares the fields with `==` (the
// structural `==` of the type, except that a `[u8]` field or one with an
// Eq impl compares through it).
//
// The impls are written as text (one source file, `<derive>`), parsed,
// and their nodes given the span of the derive's trait name, or, for the
// code of one field, the field's: an error in them points at the
// attribute or the field. Once the types are known, check_derives
// reports a field whose type lacks the trait (and leaves that impl's
// function unchecked).
//
// intrinsic.vl: the methods of the types that implement Clone, Ord or
// Hash without an impl block.

pub mod intrinsic;
pub mod rust;

use crate::base::{
    _setjmp, add_source, buf_clear, buf_int, buf_len, buf_new, buf_str, sym_name, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end_soft, err_fmt, err_help, err_help_fmt, err_str, recover_enter, recover_leave,
};
use crate::front::ast::{
    FN_BODY_FAILED, FN_DERIVED, NodeKind, child, list_begin, list_end, list_push,
};
use crate::front::lexer::lex_range;
use crate::front::parser::parse_items_fragment;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    TyKind, buf_type, enum_variant, err_type, is_float, struct_field, type_elem, variant_field,
};

// What a derive names (the D_* codes), by the name written.
const D_EQ: i64 = 1;
const D_ORD: i64 = 2;
const D_HASH: i64 = 3;
const D_DEBUG: i64 = 4;

// ---- Expansion ----

// The derives of the program's structs and enums, expanded into impls
// (after the modules are loaded, before collect_names).
pub fn expand_derives(pcx: &mut Ctx<Comp>) {
    if pcx.derive_gen < 0 {
        pcx.derive_gen = buf_new();
    }
    buf_clear(pcx.derive_gen);
    pcx.spans.clear();
    pcx.derived.clear();
    for i in 0..pcx.nodes[pcx.program as usize].count {
        let item = child(pcx.program, i, pcx);
        let kind = pcx.nodes[item as usize].kind;
        if (kind == NodeKind::Struct || kind == NodeKind::Enum)
            && pcx.nodes[item as usize].h != 0 {
            expand_item(item, pcx);
        }
    }
    if buf_len(pcx.derive_gen) > 0 {
        parse_derived(pcx);
    }
}

// The derives of struct or enum `item`.
fn expand_item(item: i64, pcx: &mut Ctx<Comp>) {
    let holder = pcx.nodes[item as usize].h;
    for k in 0..pcx.nodes[holder as usize].count {
        let d = child(holder, k, pcx);
        // RULE: F17.1 (std's traits, in its shapes)
        if sym_text(pcx.nodes[d as usize].a, pcx) == b"Copy" {
            pcx.rust_copy.push(item);
        }
        let code = rust::rust_code(d, item, pcx);
        if code == 0 {
            continue;
        }
        if (0i64..k).any(|j| rust::rust_code_quiet(child(holder, j, pcx), pcx) == code) {
            err_begin(pcx.nodes[d as usize].start, pcx);
            err_fmt(format_args("'{}' is derived twice",
                str::from_utf8(sym_text(pcx.nodes[d as usize].a, pcx)).unwrap()), pcx);
            err_help(c"remove one of them", pcx);
            err_end_soft(pcx);
            continue;
        }
        if code == rust::R_CLONE && rust::clone_of_mut_ref(item, d, pcx) {
            continue;
        }
        pcx.derived.push(item);
        pcx.derived.push(d);
        pcx.derived.push(code);
        pcx.derived.push(0);
        rust::write_rust_impl(item, d, code, pcx);
    }
}

// ---- Writing the impls ----

fn w(s: *const u8, pcx: &Ctx<Comp>) {
    buf_str(pcx.derive_gen, s);
}

fn w_sym(sym: i64, pcx: &Ctx<Comp>) {
    buf_str(pcx.derive_gen, sym_name(sym, pcx));
}

fn w_int(v: i64, pcx: &Ctx<Comp>) {
    buf_int(pcx.derive_gen, v);
}

// The code written from here on has node n's span.
fn span_from(n: i64, pcx: &mut Ctx<Comp>) {
    pcx.spans.push(buf_len(pcx.derive_gen));
    pcx.spans.push(n);
}

// `<T, U>` of a generic item; nothing for another.
fn w_type_args(item: i64, pcx: &Ctx<Comp>) {
    let g = pcx.nodes[item as usize].g;
    if g == 0 {
        return;
    }
    w(c"<", pcx);
    for i in 0..pcx.nodes[g as usize].count {
        if i > 0 {
            w(c", ", pcx);
        }
        w_sym(pcx.nodes[child(g, i, pcx) as usize].a, pcx);
    }
    w(c">", pcx);
}

// `E::V`, `E::V(_, _)` (`binder` 0), or `E::V(__a0, __a1)` (`binder` the
// prefix, "__a"); `E::V { .. }`, `E::V { x: __a0, y: __a1 }` for a
// struct-like variant (0.17).
fn w_variant_pattern(item: i64, v: i64, binder: *const u8, pcx: &Ctx<Comp>) {
    w_sym(pcx.nodes[item as usize].a, pcx);
    w(c"::", pcx);
    w_sym(pcx.nodes[v as usize].a, pcx);
    if pcx.nodes[v as usize].count == 0 && pcx.nodes[v as usize].c == 0 {
        return;
    }
    let names = pcx.nodes[v as usize].d;
    if names != 0 {
        if binder == 0 as *mut u8 || pcx.nodes[v as usize].count == 0 {
            w(c" { .. }", pcx);
            return;
        }
        w(c" { ", pcx);
        for k in 0..pcx.nodes[v as usize].count {
            if k > 0 {
                w(c", ", pcx);
            }
            w_sym(pcx.nodes[child(names, k, pcx) as usize].a, pcx);
            w(c": ", pcx);
            w(binder, pcx);
            w_int(k, pcx);
        }
        w(c" }", pcx);
        return;
    }
    w(c"(", pcx);
    for k in 0..pcx.nodes[v as usize].count {
        if k > 0 {
            w(c", ", pcx);
        }
        if binder == 0 as *mut u8 {
            w(c"_", pcx);
        } else {
            w(binder, pcx);
            w_int(k, pcx);
        }
    }
    w(c")", pcx);
}

// ---- Parsing them ----

// Parses GEN as a source file `<derive>`, gives its nodes their spans,
// flags the impls and their functions FN_DERIVED, and appends them to the
// program.
fn parse_derived(pcx: &mut Ctx<Comp>) {
    let base = add_source(c"<derive>", pcx.derive_gen, pcx, 0);
    let first = pcx.toks.len() as i64;
    let node_mark = pcx.nodes.len() as i64;
    let mark = list_begin(pcx);
    let depth = pcx.recover_depth;
    // UNSAFE: the front end's error recovery is C's setjmp/longjmp (base::diag::err_jump):
    // an error raised in what this guards returns here, and setjmp must be called in the
    // frame that stays live, so no safe wrapper can make the call.
    // SAFETY: recover_enter gives the jmp_buf of this frame's depth (512 zeroed bytes kept
    // in pcx.recover_bufs, never freed); err_jump jumps only to the buffer of recover_depth
    // - 1, and this function sets recover_depth back to the depth it entered with
    // (recover_leave(depth) below) before it returns, on both paths, so no jump lands in a
    // frame that has returned. A jump skips the destructors of the frames between: their
    // allocations leak, nothing is freed twice.
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        lex_range(base, base + buf_len(pcx.derive_gen), last: true,
            pcx: pcx);
        parse_items_fragment(first, pcx);
    } else {
        // (a syntax error in the made text: a compiler bug, reported)
        pcx.scratch.truncate(mark as usize);
    }
    recover_leave(depth, pcx);
    for k in node_mark..pcx.nodes.len() as i64 {
        let target = span_at(pcx.nodes[k as usize].start - base, pcx);
        pcx.nodes[k as usize].start = pcx.nodes[target as usize].start;
        pcx.nodes[k as usize].end = pcx.nodes[target as usize].end;
    }
    // The impls come in the order of DERIVED's.
    let mut next: i64 = 0;
    for i in mark..pcx.scratch.len() as i64 {
        let n = (pcx.scratch[i as usize]);
        pcx.nodes[n as usize].p |= FN_DERIVED;
        if pcx.nodes[n as usize].kind == NodeKind::Impl {
            if next < pcx.derived.len() as i64 {
                (pcx.derived[(next + 3) as usize]) = n;
                next += 4;
            }
        }
    }
    let count = pcx.scratch.len() as i64 - mark;
    let all = list_begin(pcx);
    for i in 0..pcx.nodes[pcx.program as usize].count {
        list_push(child(pcx.program, i, pcx), pcx);
    }
    for i in 0..count {
        list_push((pcx.scratch[(mark + i) as usize]), pcx);
    }
    list_end(pcx.program, all, pcx);
    pcx.scratch.truncate(mark as usize);
}

// The node whose span the code at `offset` of GEN has.
fn span_at(offset: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.spans.len() as i64 / 2 - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if (pcx.spans[(2 * mid) as usize]) <= offset {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    (pcx.spans[(2 * lo + 1) as usize])
}

// ---- Checking the fields ----

// Once the types are known (after the collect phases): each field of a
// derived non-generic type has the trait (a generic type's fields are
// checked in its instances). An error leaves the impl's function
// unchecked.
pub fn check_derives(pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < pcx.derived.len() as i64 {
        let item = (pcx.derived[i as usize]);
        let d = (pcx.derived[(i + 1) as usize]);
        let code = (pcx.derived[(i + 2) as usize]);
        let imp = (pcx.derived[(i + 3) as usize]);
        i += 4;
        // (the rust derives, F17, are the trait checker's: rust.vl)
        if pcx.nodes[item as usize].g != 0 || imp == 0 || code >= rust::R_PARTIAL_EQ {
            continue;
        }
        let ok = if pcx.nodes[item as usize].kind
            == NodeKind::Struct { check_struct_fields(item, d, code, pcx) }
            else { check_enum_fields(item, d, code, pcx) };
        if !ok {
            for k in 0..pcx.nodes[imp as usize].count {
                { let at_ix = child(imp, k, pcx) as usize;
                    pcx.nodes[at_ix].p |= FN_BODY_FAILED };
            }
        }
    }
}

fn check_struct_fields(item: i64, d: i64, code: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut s: i64 = -1;
    for k in 0..pcx.structs.len() as i64 {
        if pcx.structs[k as usize].node == item && pcx.structs[k as usize].tmpl == 0 {
            s = k;
        }
    }
    if s < 0 || pcx.structs[s as usize].field_count != pcx.nodes[item as usize].count {
        return true;
    }
    let mut ok = true;
    for k in 0..pcx.structs[s as usize].field_count {
        let field = child(item, k, pcx);
        let ty = (struct_field(s, k, pcx)).ty;
        if !field_has(ty, code, pcx) {
            field_error(item, d, code, field, ty, -1, k, pcx);
            ok = false;
        }
    }
    ok
}

fn check_enum_fields(item: i64, d: i64, code: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut e: i64 = -1;
    for k in 0..pcx.enum_count {
        if (pcx.enums[k as usize]).node == item
            && (pcx.enums[k as usize]).tmpl == 0 {
            e = k;
        }
    }
    if e < 0 || (pcx.enums[e as usize]).variant_count != pcx.nodes[item as usize].count {
        return true;
    }
    let mut ok = true;
    for i in 0..(pcx.enums[e as usize]).variant_count {
        let v = enum_variant(e, i, pcx);
        let vn = child(item, i, pcx);
        if pcx.variants[v as usize].field_count != pcx.nodes[vn as usize].count {
            continue;
        }
        for k in 0..pcx.variants[v as usize].field_count {
            let ty = variant_field(v, k, pcx);
            if !field_has(ty, code, pcx) {
                field_error(item, d, code, child(vn, k, pcx), ty, i, k, pcx);
                ok = false;
            }
        }
    }
    ok
}

// Whether type `ty` has the trait of D_* `code`.
fn field_has(ty: i64, code: i64, pcx: &mut Ctx<Comp>) -> bool {
    let name = if code == D_EQ { c"Eq" } else if code == D_ORD { c"Ord" }
        else if code == D_HASH { c"Hash" } else if code == D_DEBUG { c"Debug" } else { c"Clone" };
    implements(std_trait(name, pcx), ty, pcx)
}

// "cannot derive Hash for 'P': field 'x' of type 'f64' has no Hash", at
// the field (`variant`: its index for field `index` of an enum's variant,
// else -1).
fn field_error(item: i64, d: i64, code: i64, field: i64, ty: i64, variant: i64, index: i64,
    pcx: &mut Ctx<Comp>) {
    err_begin(pcx.nodes[field as usize].start, pcx);
    err_fmt(format_args("cannot derive {} for '{}': ",
        str::from_utf8(sym_text(pcx.nodes[d as usize].a, pcx)).unwrap(),
        str::from_utf8(sym_text(pcx.nodes[item as usize].a, pcx)).unwrap()), pcx);
    if variant >= 0 {
        err_fmt(format_args("field {index} of '{}::",
            str::from_utf8(sym_text(pcx.nodes[item as usize].a, pcx)).unwrap()), pcx);
        err_fmt(format_args("{}'",
            str::from_utf8(sym_text(pcx.nodes[child(item, variant, pcx) as usize].a, pcx)).unwrap()), pcx);
    } else {
        err_fmt(format_args("field '{}'",
            str::from_utf8(sym_text(pcx.nodes[field as usize].a, pcx)).unwrap()), pcx);
    }
    err_str(c" of type '", pcx);
    err_type(ty, pcx);
    err_str(c"' has no ", pcx);
    err_str(if code == D_EQ { c"==" } else { sym_name(pcx.nodes[d as usize].a, pcx) }, pcx);
    if code == D_HASH && (is_float(ty) || has_float(ty, pcx)) {
        err_help(c"floats have no Hash (NaN is not equal to itself): remove Hash from #[derive], or write the impl, hashing the field's bits", pcx);
    } else if code == D_EQ {
        err_help(c"remove Eq from #[derive], or give the field a type with ==", pcx);
    } else {
        err_help_fmt(format_args("remove {} from #[derive], or implement it for '",
            str::from_utf8(sym_text(pcx.nodes[d as usize].a, pcx)).unwrap()), pcx);
        buf_type(pcx.err_help, ty, pcx);
        err_help(c"'", pcx);
    }
    err_end_soft(pcx);
}

// Whether a tuple or array type `ty` holds a float.
fn has_float(ty: i64, pcx: &Ctx<Comp>) -> bool {
    let kind = pcx.types[ty as usize].kind;
    if kind == TyKind::Array {
        return is_float(pcx.types[ty as usize].a) || has_float(pcx.types[ty as usize].a, pcx);
    }
    if kind == TyKind::Tuple {
        for i in 0..pcx.types[ty as usize].count {
            if is_float(type_elem(ty, i, pcx)) || has_float(type_elem(ty, i, pcx), pcx) {
                return true;
            }
        }
    }
    false
}

// The help of a conflict between impl `node` and another impl of its
// trait for its type: when `node` is a derive's, remove the derive.
pub fn derive_conflict_help(node: i64, pcx: &Ctx<Comp>) {
    if (pcx.nodes[node as usize].p & FN_DERIVED) == 0 {
        return;
    }
    err_help_fmt(format_args("remove {}",
        str::from_utf8(sym_text(pcx.nodes[pcx.nodes[node as usize].a as usize].a, pcx)).unwrap()),
        pcx);
    err_help(c" from #[derive], or the impl written by hand", pcx);
}
