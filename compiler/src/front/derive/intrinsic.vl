// The methods of the types that implement Clone, Eq, Ord or Hash without
// an impl block (0.15): `x.clone()` on a type that copies, `x.cmp(&y)` on
// a float, pointer or fieldless enum, and `eq`, `cmp`, `hash`, `clone` on
// tuples of 2 to 6 elements, which call std's copy_clone, scalar_cmp and
// tupleN_* (std/clone.vl); and the intrinsic Eq, Ord, Hash and Clone of
// tuples and Clone of the types that copy (traits::intrinsic).

use crate::base::{buf_clear, buf_fmt, buf_new, buf_slice, cstr, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::check::distinct::distinct_helper;
use crate::front::check::equality::eq_unsupported;
use crate::front::distinct::is_distinct_type;
use crate::front::generics::instantiate::fn_instance;
use crate::front::modules::lookup::std_item_key;
use crate::front::own::kinds::is_owned_type;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    TY_BOOL, TY_UNIT, TyKind, is_fieldless_enum, is_fn_type, is_numeric, is_pointer, is_slice,
    is_vector, type_elem,
};

// ---- Clone, Ord and Hash without an impl ----

// Whether values of type t are copies that own nothing: numbers, bool,
// (), pointers, slices (a view), fn types, fieldless enums, vectors, and
// tuples and arrays of them. They implement Clone without an impl.
pub fn is_plain(t: i64, pcx: Ctx<Comp>) -> bool {
    if is_numeric(t) || t == TY_BOOL || t == TY_UNIT || is_pointer(t, pcx) || is_fn_type(t, pcx)
        || is_fieldless_enum(t, pcx) || is_slice(t, pcx) || is_vector(t, pcx) {
        return true;
    }
    let kind = pcx.types[t].kind;
    if kind == TyKind::Array {
        return is_plain(pcx.types[t].a, pcx);
    }
    if kind == TyKind::Tuple {
        for i in 0..pcx.types[t].count {
            if !is_plain(type_elem(t, i, pcx), pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

// (0.17) Whether t is a struct or an enum that owns nothing (plain, or a
// view): it clones by copying, without an impl.
pub fn copy_aggregate(t: i64, pcx: inout Ctx<Comp>) -> bool {
    t > 0 && (pcx.types[t].kind == TyKind::Struct || pcx.types[t].kind == TyKind::Enum)
        && !is_owned_type(t, &pcx) && !crate::front::own::kinds::holds_inout(t, pcx)
}

// Whether t is a tuple of 2 to 6 elements that each implement trait tr
// (it then implements tr: Eq, Ord, Hash or Clone, through std's
// tupleN_*).
pub fn tuple_implements(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if tr < 0 || pcx.types[t].kind != TyKind::Tuple || pcx.types[t].count < 2
        || pcx.types[t].count > 6 {
        return false;
    }
    for i in 0..pcx.types[t].count {
        if !implements(tr, type_elem(t, i, pcx), &pcx) {
            return false;
        }
    }
    true
}

// Whether operator trait tr (Eq: == and !=; Ord: < > <= >=) on values of
// tuple type t is a call of its function (tupleN_eq, tupleN_cmp): Ord
// when the elements are; Eq when they are but the structural == does
// not apply (a `[u8]` element compares its bytes).
pub fn tuple_operator(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.types[t].kind != TyKind::Tuple {
        return false;
    }
    if tr == std_trait(c"Ord", &pcx) {
        return tuple_implements(tr, t, &pcx);
    }
    tr == std_trait(c"Eq", &pcx) && eq_unsupported(t, &pcx) != 0 && tuple_implements(tr, t, &pcx)
}

// Whether `x.name(..)` on a value of type t is one of the methods of
// intrinsic_method.
pub fn has_intrinsic_method(t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    intrinsic_helper(t, name, &pcx) != 0
}

// std's function that `x.name(..)` calls, x of type t, when t implements
// Clone, Eq, Ord or Hash without an impl block (`name` is clone, eq, cmp
// or hash); 0 when none.
fn intrinsic_helper(t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    if pcx.std_module < 0 {
        return 0;
    }
    // (0.18: a distinct type's, through its underlying type)
    if is_distinct_type(t, pcx) {
        // RULE: F0.4 (0.27.3: on std2 a shared view clones by copying,
        // `&str`'s clone)
        if crate::front::known::on_std2(pcx) && sym_text(name, pcx) == "clone"
            && !crate::front::opaque::is_opaque(t, pcx)
            && crate::places::regions::rust_copy(t, &pcx) {
            return intern_c(c"copy_clone", &pcx);
        }
        return distinct_helper(t, name, &pcx);
    }
    let text = sym_text(name, pcx);
    if text == "clone" {
        if is_plain(t, pcx) || copy_aggregate(t, &pcx) {
            return intern_c(c"copy_clone", &pcx);
        }
        if tuple_implements(std_trait(c"Clone", &pcx), t, &pcx) {
            return tuple_helper(t, c"clone", &pcx);
        }
    } else if text == "cmp" {
        if is_numeric(t) || is_pointer(t, pcx) || is_fieldless_enum(t, pcx) {
            return intern_c(c"scalar_cmp", &pcx);
        }
        if tuple_implements(std_trait(c"Ord", &pcx), t, &pcx) {
            return tuple_helper(t, c"cmp", &pcx);
        }
    } else if text == "eq" {
        if tuple_implements(std_trait(c"Eq", &pcx), t, &pcx) {
            return tuple_helper(t, c"eq", &pcx);
        }
    } else if text == "hash" {
        if tuple_implements(std_trait(c"Hash", &pcx), t, &pcx) {
            return tuple_helper(t, c"hash", &pcx);
        }
    }
    0
}

// `tupleN_what`, N the number of t's elements.
fn tuple_helper(t: i64, what: *u8, pcx: inout Ctx<Comp>) -> i64 {
    let b = buf_new_scratch(&pcx);
    buf_fmt(b, format_args("tuple{}_{}", pcx.types[t].count, cstr(what)));
    intern(buf_slice(b), &pcx)
}

fn buf_new_scratch(pcx: inout Ctx<Comp>) -> i64 {
    if pcx.name_buf < 0 {
        pcx.name_buf = buf_new();
    }
    buf_clear(pcx.name_buf);
    pcx.name_buf
}

// The function `x.name(..)` (call node n, x of type t) calls when t has no
// method `name` but implements Clone, Eq, Ord or Hash without an impl: the
// instance of std's copy_clone, scalar_cmp or tupleN_* for t; -1 when
// there is none.
pub fn intrinsic_method(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let helper = intrinsic_helper(t, name, &pcx);
        if helper == 0 {
            return -1;
        }
        let key = std_item_key(helper, &pcx);
        if key < 0 || pcx.sym_fn[key] == 0 {
            return -1;
        }
        let tf = pcx.sym_fn[key] - 1;
        let mark = pcx.tscratch.count;
        if pcx.types[t].kind == TyKind::Tuple && sym_text(helper, pcx)[0..5] == "tuple" {
            for i in 0..pcx.types[t].count {
                pcx.tscratch.push(type_elem(t, i, pcx));
            }
        } else {
            pcx.tscratch.push(t);
            // (0.18: distinct_*'s second argument, the underlying type)
            if is_distinct_type(t, pcx) && sym_text(helper, pcx)[0..8] == "distinct" {
                pcx.tscratch.push(pcx.types[t].a);
            }
        }
        fn_instance(tf, mark, n, &pcx)
    }
}
