// (0.27.2) The rust edition's derives, in std2's shapes (F17): a rust
// program reads std2, and each `#[derive(..)]` of its structs and enums
// (its own and std2's) becomes an impl of std2's trait, named by path
// (`std::cmp::PartialEq` from a program, `crate::cmp::PartialEq` inside
// std2), never by the names in scope. The text goes to `<derive>` as
// MVS's derives do (mod.vl), and that text is a rust-edition position
// (Z1.2). Every type parameter but an allocator is bounded by the derived
// trait, as rustc derives. A field without the trait is the trait
// checker's error in the generated body, at the field.
// RULE: F17.1, F17.3, F17.4

use crate::base::sym_text;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fmt, err_help};
use crate::front::ast::{NODE_REF, NodeKind, child};

use super::{span_from, w, w_int, w_sym, w_type_args, w_variant_pattern};

// What a rust derive names (codes apart from mod.vl's D_*, so that
// check_derives leaves them to the trait checker).
pub const R_PARTIAL_EQ: i64 = 11;
pub const R_EQ: i64 = 12;
pub const R_PARTIAL_ORD: i64 = 13;
pub const R_ORD: i64 = 14;
pub const R_HASH: i64 = 15;
pub const R_DEBUG: i64 = 16;
pub const R_CLONE: i64 = 17;
pub const R_COPY: i64 = 18;
pub const R_DEFAULT: i64 = 19;

// The R_* code of derive `d` (a TyName: `Clone`, or `std::clone::Clone`,
// `core::..`), or 0.
pub fn rust_code_quiet(d: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.nodes[d as usize].kind != NodeKind::TyName || pcx.nodes[d as usize].g != 0 {
        return 0;
    }
    if pcx.nodes[d as usize].count > 0 {
        let root = sym_text(pcx.nodes[child(d, 0, pcx) as usize].a, pcx);
        if root != b"std" && root != b"core" && root != b"crate" {
            return 0;
        }
    }
    let text = sym_text(pcx.nodes[d as usize].a, pcx);
    if text == b"PartialEq" {
        R_PARTIAL_EQ
    } else if text == b"Eq" {
        R_EQ
    } else if text == b"PartialOrd" {
        R_PARTIAL_ORD
    } else if text == b"Ord" {
        R_ORD
    } else if text == b"Hash" {
        R_HASH
    } else if text == b"Debug" {
        R_DEBUG
    } else if text == b"Clone" {
        R_CLONE
    } else if text == b"Copy" {
        R_COPY
    } else if text == b"Default" {
        R_DEFAULT
    } else {
        0
    }
}

// The R_* code of derive `d`, or 0 after an error.
pub fn rust_code(d: i64, item: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let code = rust_code_quiet(d, pcx);
    if code != 0 {
        return code;
    }
    err_begin(pcx.nodes[d as usize].start, pcx);
    if pcx.nodes[d as usize].kind != NodeKind::TyName || pcx.nodes[d as usize].g != 0 {
        err_fmt(format_args("#[derive] takes trait names: {}", DERIVABLE), pcx);
        err_end_soft(pcx);
        return 0;
    }
    err_fmt(format_args("cannot derive '{}' (derivable: {})",
        str::from_utf8(sym_text(pcx.nodes[d as usize].a, pcx)).unwrap(), DERIVABLE), pcx);
    if sym_text(pcx.nodes[d as usize].a, pcx) == b"Display" {
        err_help(c"Display has no derive: write `impl std::fmt::Display for T { fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { .. } }`", pcx);
    }
    let _ = item;
    err_end_soft(pcx);
    0
}

const DERIVABLE: &str = "PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy, Default";

// The path's root for a derive of `item`: `crate` inside std2, `std` in
// a program.
fn root(item: i64, pcx: &mut Ctx<Comp>) -> *mut u8 {
    let m = crate::front::modules::module_at(pcx.nodes[item as usize].start, pcx);
    if crate::front::modules::within_std(m, pcx) { c"crate" } else { c"std" }
}

// `std::cmp::PartialEq`: `rest` after the item's root.
fn wp(item: i64, rest: *mut u8, pcx: &mut Ctx<Comp>) {
    w(root(item, pcx), pcx);
    w(rest, pcx);
}

// RULE: F17.1 (0.27.2) The item's lifetimes, `'a, 'b`, as its header
// writes them (no bounds), each followed by `, ` when `more`; their count.
// `impl<'a> Clone for Chars<'a>`: the derived impl's own, so its methods'
// `&Self` is the item's type with them, not with fresh ones.
fn w_lifetimes(item: i64, more: bool, pcx: &Ctx<Comp>) -> i64 {
    let lts = crate::front::parser::rust::lifetimes_of(item, pcx);
    if lts == 0 {
        return 0;
    }
    let n = pcx.nodes[lts as usize].count;
    for i in 0..n {
        let l = child(lts, i, pcx);
        if i > 0 {
            w(c", ", pcx);
        }
        crate::base::buf_bytes(pcx.derive_gen,
            &crate::base::get_src()[
                pcx.nodes[l as usize].start as usize..pcx.nodes[l as usize].end as usize]);
    }
    if n > 0 && more {
        w(c", ", pcx);
    }
    n
}

// The type `item` declares, `S`, `S<T, A>` or `S<'a, T>`.
fn w_self(item: i64, pcx: &Ctx<Comp>) {
    w_sym(pcx.nodes[item as usize].a, pcx);
    let g = pcx.nodes[item as usize].g;
    let types = g != 0 && pcx.nodes[g as usize].count > 0;
    if crate::front::parser::rust::lifetimes_of(item, pcx) == 0 {
        w_type_args(item, pcx);
        return;
    }
    w(c"<", pcx);
    let _ = w_lifetimes(item, types, pcx);
    if types {
        for i in 0..pcx.nodes[g as usize].count {
            if i > 0 {
                w(c", ", pcx);
            }
            w_sym(pcx.nodes[child(g, i, pcx) as usize].a, pcx);
        }
    }
    w(c">", pcx);
}

// `impl<T: B + Tr, A: Allocator> Tr for S<T, A> {` (`trait_rest` after
// the root): each parameter with its bounds as written and the trait,
// but an allocator parameter, which takes none (std2's containers derive
// over an allocator that has not the trait: Gpa has no Debug).
fn w_head(item: i64, trait_rest: *mut u8, pcx: &mut Ctx<Comp>) {
    w(c"impl", pcx);
    let g = pcx.nodes[item as usize].g;
    let types = g != 0 && pcx.nodes[g as usize].count > 0;
    let lts = crate::front::parser::rust::lifetimes_of(item, pcx) != 0;
    if types || lts {
        w(c"<", pcx);
        let _ = w_lifetimes(item, types, pcx);
    }
    if types {
        for i in 0..pcx.nodes[g as usize].count {
            let p = child(g, i, pcx);
            if i > 0 {
                w(c", ", pcx);
            }
            w_sym(pcx.nodes[p as usize].a, pcx);
            w(c": ", pcx);
            let bounds = pcx.nodes[p as usize].h;
            let text = if bounds != 0 {
                &crate::base::get_src()[
                    pcx.nodes[bounds as usize].start as usize..pcx.nodes[bounds as usize].end as usize] } else { b"" };
            if text == b"Allocator" || text.ends_with(b"::Allocator") {
                crate::base::buf_bytes(pcx.derive_gen, text);
                continue;
            }
            if bounds != 0 {
                crate::base::buf_bytes(pcx.derive_gen, text);
                w(c" + ", pcx);
            }
            wp(item, trait_rest, pcx);
        }
    }
    if types || lts {
        w(c">", pcx);
    }
    w(c" ", pcx);
    wp(item, trait_rest, pcx);
    w(c" for ", pcx);
    w_self(item, pcx);
    w(c" {\n", pcx);
}

// Whether struct `item` is a tuple struct (its fields named 0, 1, ..).
fn tuple_struct(item: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[item as usize].count > 0 && {
        let name = sym_text(pcx.nodes[child(item, 0, pcx) as usize].a, pcx);
        name.len() > 0 && name[0] >= b'0' && name[0] <= b'9'
    }
}

// Whether field node `field`'s type is written as a raw pointer.
fn raw_pointer_field(field: i64, pcx: &Ctx<Comp>) -> bool {
    let tn = pcx.nodes[field as usize].b;
    tn > 0 && pcx.nodes[tn as usize].kind == NodeKind::TyPtr
        && (pcx.nodes[tn as usize].p & NODE_REF) == 0
        && crate::base::get_src()[pcx.nodes[tn as usize].start as usize] == b'*'
}

// RULE: F17.1 (0.27.2) Whether field node `field`'s type is written as a
// shared reference, `&'a T`, `&'a str`, `&'a [T]`: the derived bodies pass
// it as it is (`self.f`, the reference) where another field is passed as
// `&self.f`, and its clone is a copy, as Rust's `impl Clone for &T` and
// `PartialEq<&B> for &A` give (std2 has neither impl yet).
fn shared_ref_field(field: i64, pcx: &Ctx<Comp>) -> bool {
    ref_type(pcx.nodes[field as usize].b, pcx) == 1
}

// How type node `tn` is written: 1 a shared reference (`&T`, `&'a T`), 2
// an exclusive one (`&mut T`, `&'a mut T`), 0 neither.
fn ref_type(tn: i64, pcx: &Ctx<Comp>) -> i64 {
    if tn <= 0 || pcx.nodes[tn as usize].end <= pcx.nodes[tn as usize].start
        || crate::base::get_src()[pcx.nodes[tn as usize].start as usize] != b'&' {
        return 0;
    }
    // (`&str` is the str view's node, its `&` in the source only: the
    // text says which; `&'a mut T` is not shared)
    let text = &crate::base::get_src()[
        (pcx.nodes[tn as usize].start + 1) as usize..pcx.nodes[tn as usize].end as usize];
    let mut i: i64 = 0;
    let n = text.len() as i64;
    if n > 0 && text[0] == b'\'' {
        while i < n && text[i as usize] != b' ' {
            i += 1;
        }
    }
    while i < n && text[i as usize] == b' ' {
        i += 1;
    }
    let exclusive = n - i >= 4 && text[i as usize..(i + 4) as usize] == b"mut ";
    if exclusive { 2 } else { 1 }
}

// (0.28.0) `#[derive(Clone)]` (derive `d`) of an `item` that holds a
// `&mut T`, a struct's field or an enum variant's: the error, at the
// field, and true (no impl is written: its `Clone::clone(&self.f)` would
// be checked against the field's type, an error about a call nobody
// wrote). A `&mut` is the one access to what it points to, so it has no
// Clone, and neither has what holds it.
pub fn clone_of_mut_ref(item: i64, d: i64, pcx: &mut Ctx<Comp>) -> bool {
    let is_enum = pcx.nodes[item as usize].kind == NodeKind::Enum;
    for i in 0..pcx.nodes[item as usize].count {
        let member = child(item, i, pcx);
        let mut tn: i64 = 0;
        if is_enum {
            for k in 0..pcx.nodes[member as usize].count {
                if tn == 0 && ref_type(child(member, k, pcx), pcx) == 2 {
                    tn = child(member, k, pcx);
                }
            }
        } else if ref_type(pcx.nodes[member as usize].b, pcx) == 2 {
            tn = pcx.nodes[member as usize].b;
        }
        if tn == 0 {
            continue;
        }
        err_begin(pcx.nodes[tn as usize].start, pcx);
        err_fmt(format_args("cannot derive {} for '{}': ",
            str::from_utf8(sym_text(pcx.nodes[d as usize].a, pcx)).unwrap(),
            str::from_utf8(sym_text(pcx.nodes[item as usize].a, pcx)).unwrap()), pcx);
        err_fmt(format_args("{} '{}' holds a `&mut` reference, which has no Clone",
            if is_enum { "variant" } else { "field" },
            str::from_utf8(sym_text(pcx.nodes[member as usize].a, pcx)).unwrap()), pcx);
        err_help(c"a `&mut T` is the only access to its value, so a copy of it would be a second one: remove Clone from #[derive] and move the value or lend it (`&x`); or hold a shared `&T`, which is Copy; or write `impl Clone` yourself, making what the `&mut` points to anew", pcx);
        err_end_soft(pcx);
        return true;
    }
    false
}

// `&self.f`, or `self.f` of a shared reference field (`owner`: "self",
// "other").
fn w_field_arg(field: i64, owner: *mut u8, pcx: &Ctx<Comp>) {
    if !shared_ref_field(field, pcx) {
        w(c"&", pcx);
    }
    w(owner, pcx);
    w(c".", pcx);
    w_sym(pcx.nodes[field as usize].a, pcx);
}

// The impl of rust derive `d` (R_* `code`) of `item`.
pub fn write_rust_impl(item: i64, d: i64, code: i64, pcx: &mut Ctx<Comp>) {
    span_from(d, pcx);
    let is_struct = pcx.nodes[item as usize].kind == NodeKind::Struct;
    if code == R_EQ {
        w_head(item, c"::cmp::Eq", pcx);
        w(c"}\n", pcx);
        return;
    }
    if code == R_COPY {
        w_head(item, c"::marker::Copy", pcx);
        w(c"}\n", pcx);
        return;
    }
    if code == R_PARTIAL_EQ {
        w_head(item, c"::cmp::PartialEq", pcx);
        w(c"    #[inline]\n    fn eq(&self, other: &", pcx);
        w_self(item, pcx);
        w(c") -> bool {\n", pcx);
        if is_struct { struct_eq(item, d, pcx); } else { enum_eq(item, d, pcx); }
        // (0.27.8) `ne` written, inline: the trait's default `!self.eq(o)`
        // was a call out of line at every `!=` of a derived type
        w(c"    }\n    #[inline]\n    fn ne(&self, other: &", pcx);
        w_self(item, pcx);
        w(c") -> bool {\n", pcx);
        if !is_struct && by_cast(item, pcx) {
            w(c"        *self as isize != *other as isize\n", pcx);
        } else {
            w(c"        !", pcx);
            wp(item, c"::cmp::PartialEq::eq(self, other)\n", pcx);
        }
    } else if code == R_PARTIAL_ORD || code == R_ORD {
        let ord = code == R_ORD;
        w_head(item, if ord { c"::cmp::Ord" } else { c"::cmp::PartialOrd" }, pcx);
        w(if ord { c"    #[inline]\n    fn cmp(&self, other: &" }
            else { c"    #[inline]\n    fn partial_cmp(&self, other: &" }, pcx);
        w_self(item, pcx);
        w(c") -> ", pcx);
        if ord {
            wp(item, c"::cmp::Ordering", pcx);
        } else {
            wp(item, c"::option::Option<", pcx);
            wp(item, c"::cmp::Ordering>", pcx);
        }
        w(c" {\n", pcx);
        if is_struct { struct_cmp(item, d, ord, pcx); } else { enum_cmp(item, d, ord, pcx); }
        if !ord && !is_struct && by_cast(item, pcx) {
            // (0.27.8) `<` and the rest on the discriminants, inline, not
            // the trait's defaults through partial_cmp
            for op in 0..4 {
                w(c"    }\n    #[inline]\n    fn ", pcx);
                w(if op == 0 { c"lt" } else if op == 1 { c"le" } else if op == 2 { c"gt" }
                    else { c"ge" }, pcx);
                w(c"(&self, other: &", pcx);
                w_self(item, pcx);
                w(c") -> bool {\n        (*self as isize) ", pcx);
                w(if op == 0 { c"<" } else if op == 1 { c"<=" } else if op == 2 { c">" }
                    else { c">=" }, pcx);
                w(c" (*other as isize)\n", pcx);
            }
        }
    } else if code == R_HASH {
        w_head(item, c"::hash::Hash", pcx);
        w(c"    fn hash<__H: ", pcx);
        wp(item, c"::hash::Hasher>(&self, state: &mut __H) {\n", pcx);
        if is_struct { struct_hash(item, d, pcx); } else { enum_hash(item, d, pcx); }
    } else if code == R_DEBUG {
        w_head(item, c"::fmt::Debug", pcx);
        w(c"    fn fmt(&self, f: &mut ", pcx);
        wp(item, c"::fmt::Formatter<'_>) -> ", pcx);
        wp(item, c"::fmt::Result {\n", pcx);
        if is_struct { struct_debug(item, d, pcx); } else { enum_debug(item, d, pcx); }
    } else if code == R_CLONE {
        w_head(item, c"::clone::Clone", pcx);
        w(c"    #[inline]\n    fn clone(&self) -> ", pcx);
        w_self(item, pcx);
        w(c" {\n", pcx);
        if is_struct { struct_clone(item, d, pcx); } else { enum_clone(item, d, pcx); }
    } else {
        w_head(item, c"::default::Default", pcx);
        w(c"    fn default() -> ", pcx);
        w_self(item, pcx);
        w(c" {\n", pcx);
        if is_struct { struct_default(item, d, pcx); } else { enum_default(item, d, pcx); }
    }
    w(c"    }\n}\n", pcx);
}

// `self.a == other.a && ..`, through PartialEq::eq.
fn struct_eq(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    w(c"        ", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let field = child(item, i, pcx);
        if i > 0 {
            w(c"\n            && ", pcx);
        }
        span_from(field, pcx);
        wp(item, c"::cmp::PartialEq::eq(", pcx);
        w_field_arg(field, c"self", pcx);
        w(c", ", pcx);
        w_field_arg(field, c"other", pcx);
        w(c")", pcx);
        span_from(d, pcx);
    }
    if pcx.nodes[item as usize].count == 0 {
        w(c"true", pcx);
    }
    w(c"\n", pcx);
}

// (0.27.8) Whether `item`'s own derive list names Copy.
fn derives_copy(item: i64, pcx: &Ctx<Comp>) -> bool {
    let holder = pcx.nodes[item as usize].h;
    holder != 0 && (0i64..pcx.nodes[holder as usize].count).any(|k|
        sym_text(pcx.nodes[child(holder, k, pcx) as usize].a, pcx) == b"Copy")
}

// (0.27.8) Whether no variant of enum `item` has fields (`E::V()` and
// `E::V {}` count as fields here: Rust casts only a unit-only enum).
fn unit_only(item: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.nodes[item as usize].count {
        let v = child(item, i, pcx);
        if pcx.nodes[v as usize].count != 0 || pcx.nodes[v as usize].c != 0 {
            return false;
        }
    }
    true
}

// (0.27.8) Whether some variant of enum `item` has fields.
fn some_fields(item: i64, pcx: &Ctx<Comp>) -> bool {
    (0i64..pcx.nodes[item as usize].count).any(|i| pcx.nodes[child(item, i, pcx) as usize].count
        != 0)
}

// (0.27.8) A unit-only enum that derives Copy: its derives read the
// discriminant, `*self as isize`, as rustc's do, with no match (a match
// of a pair is a compare and branch per variant: 0.27.8's flipped
// compiler spent most of its time in `Tok`'s `==`).
fn by_cast(item: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[item as usize].count > 0 && unit_only(item, pcx) && derives_copy(item, pcx)
}

// The pairs of the same variant, fieldwise; any other pair is unequal.
// (0.27.8) A unit-only Copy enum compares its discriminants; another
// compares the variants' indexes first, then matches the variants with
// fields only.
fn enum_eq(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[item as usize].count == 0 {
        w(c"        match *self {}\n", pcx);
        return;
    }
    if by_cast(item, pcx) {
        w(c"        *self as isize == *other as isize\n", pcx);
        return;
    }
    if pcx.nodes[item as usize].count > 1 {
        w_index(item, c"__i", c"self", pcx);
        w_index(item, c"__j", c"other", pcx);
        if !some_fields(item, pcx) {
            w(c"        __i == __j\n", pcx);
            return;
        }
        w(c"        if __i != __j {\n            return false;\n        }\n", pcx);
    }
    w(c"        match (self, other) {\n", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let v = child(item, i, pcx);
        if pcx.nodes[item as usize].count > 1 && pcx.nodes[v as usize].count == 0 {
            continue;
        }
        w(c"            (", pcx);
        w_variant_pattern(item, v, c"__a", pcx);
        w(c", ", pcx);
        w_variant_pattern(item, v, c"__b", pcx);
        w(c") => ", pcx);
        for k in 0..pcx.nodes[v as usize].count {
            if k > 0 {
                w(c" && ", pcx);
            }
            span_from(child(v, k, pcx), pcx);
            wp(item, c"::cmp::PartialEq::eq(__a", pcx);
            w_int(k, pcx);
            w(c", __b", pcx);
            w_int(k, pcx);
            w(c")", pcx);
            span_from(d, pcx);
        }
        if pcx.nodes[v as usize].count == 0 {
            w(c"true", pcx);
        }
        w(c",\n", pcx);
    }
    if pcx.nodes[item as usize].count > 1 {
        // (the same variant, without fields)
        w(c"            _ => true,\n", pcx);
    }
    w(c"        }\n", pcx);
}

// `Equal` of the comparison (`Some(Equal)` for partial_cmp).
fn w_equal(item: i64, ord: bool, pcx: &mut Ctx<Comp>) {
    if ord {
        wp(item, c"::cmp::Ordering::Equal", pcx);
    } else {
        wp(item, c"::option::Option::Some(", pcx);
        wp(item, c"::cmp::Ordering::Equal)", pcx);
    }
}

// One step of a lexicographic comparison: of `&self.F, &other.F` (`field`
// the field node; a shared reference passed as it is) or of `__aK, __bK` (`field` 0): the last returns its
// result, another returns it unless it is Equal.
fn w_cmp_step(item: i64, field: i64, k: i64, ord: bool, last: bool, pad: *mut u8,
    pcx: &mut Ctx<Comp>) {
    w(pad, pcx);
    if !last {
        w(c"match ", pcx);
    }
    wp(item, if ord { c"::cmp::Ord::cmp(" } else { c"::cmp::PartialOrd::partial_cmp(" }, pcx);
    if field != 0 {
        w_field_arg(field, c"self", pcx);
        w(c", ", pcx);
        w_field_arg(field, c"other", pcx);
    } else {
        w(c"__a", pcx);
        w_int(k, pcx);
        w(c", __b", pcx);
        w_int(k, pcx);
    }
    w(c")", pcx);
    if last {
        w(c"\n", pcx);
        return;
    }
    w(c" {\n", pcx);
    w(pad, pcx);
    w(c"    ", pcx);
    w_equal(item, ord, pcx);
    w(c" => {}\n", pcx);
    w(pad, pcx);
    w(c"    __c => { return __c; }\n", pcx);
    w(pad, pcx);
    w(c"}\n", pcx);
}

// Lexicographic over the fields, in their order.
fn struct_cmp(item: i64, d: i64, ord: bool, pcx: &mut Ctx<Comp>) {
    let count = pcx.nodes[item as usize].count;
    for i in 0..count {
        let field = child(item, i, pcx);
        span_from(field, pcx);
        w_cmp_step(item, field, 0, ord, i + 1 == count, c"        ", pcx);
        span_from(d, pcx);
    }
    if count == 0 {
        w(c"        ", pcx);
        w_equal(item, ord, pcx);
        w(c"\n", pcx);
    }
}

// `let __i: isize = match self { E::A(..) => 0, .. };`: the index of the
// variant `value` (text) holds. (0.27.8) Of a unit-only enum with a
// written discriminant, the discriminant (`E::A as isize`): rustc orders
// and hashes by it.
fn w_index(item: i64, binder: *mut u8, value: *mut u8, pcx: &mut Ctx<Comp>) {
    let written = unit_only(item, pcx)
        && (0i64..pcx.nodes[item as usize].count).any(|i| pcx.nodes[child(item, i, pcx) as usize].b
            != 0);
    w(c"        let ", pcx);
    w(binder, pcx);
    w(c": isize = match ", pcx);
    w(value, pcx);
    w(c" {", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let v = child(item, i, pcx);
        w(c" ", pcx);
        w_variant_pattern(item, v, 0 as *mut u8, pcx);
        w(c" => ", pcx);
        if written {
            w_variant_pattern(item, v, 0 as *mut u8, pcx);
            w(c" as isize", pcx);
        } else {
            w_int(i, pcx);
        }
        w(c",", pcx);
    }
    w(c" };\n", pcx);
}

// The variants' order first, then the fields, lexicographic.
fn enum_cmp(item: i64, d: i64, ord: bool, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[item as usize].count == 0 {
        w(c"        match *self {}\n", pcx);
        return;
    }
    if by_cast(item, pcx) {
        w(c"        ", pcx);
        wp(item, if ord { c"::cmp::Ord::cmp(&(*self as isize), &(*other as isize))\n" }
            else { c"::cmp::PartialOrd::partial_cmp(&(*self as isize), &(*other as isize))\n" },
            pcx);
        return;
    }
    w_index(item, c"__i", c"self", pcx);
    w_index(item, c"__j", c"other", pcx);
    if !some_fields(item, pcx) {
        w(c"        ", pcx);
        wp(item, if ord { c"::cmp::Ord::cmp(&__i, &__j)\n" }
            else { c"::cmp::PartialOrd::partial_cmp(&__i, &__j)\n" }, pcx);
        return;
    }
    w(c"        if __i != __j {\n            return ", pcx);
    wp(item, if ord { c"::cmp::Ord::cmp(&__i, &__j);\n" }
        else { c"::cmp::PartialOrd::partial_cmp(&__i, &__j);\n" }, pcx);
    w(c"        }\n        match (self, other) {\n", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let v = child(item, i, pcx);
        let count = pcx.nodes[v as usize].count;
        if count == 0 {
            continue;
        }
        w(c"            (", pcx);
        w_variant_pattern(item, v, c"__a", pcx);
        w(c", ", pcx);
        w_variant_pattern(item, v, c"__b", pcx);
        w(c") => {\n", pcx);
        for k in 0..count {
            span_from(child(v, k, pcx), pcx);
            w_cmp_step(item, 0, k, ord, k + 1 == count, c"                ", pcx);
            span_from(d, pcx);
        }
        w(c"            }\n", pcx);
    }
    w(c"            _ => ", pcx);
    w_equal(item, ord, pcx);
    w(c",\n        }\n", pcx);
}

fn struct_hash(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[item as usize].count {
        let field = child(item, i, pcx);
        span_from(field, pcx);
        w(c"        ", pcx);
        wp(item, c"::hash::Hash::hash(", pcx);
        w_field_arg(field, c"self", pcx);
        w(c", state);\n", pcx);
        span_from(d, pcx);
    }
}

// The variant's index as an isize, then its fields. (0.27.8) As rustc's:
// a unit-only Copy enum hashes its discriminant, `*self as isize`; an
// enum of one variant hashes no index, only the fields.
fn enum_hash(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    let count = pcx.nodes[item as usize].count;
    if count == 0 {
        w(c"        match *self {}\n", pcx);
        return;
    }
    if count > 1 && by_cast(item, pcx) {
        w(c"        ", pcx);
        wp(item, c"::hash::Hash::hash(&(*self as isize), state);\n", pcx);
        return;
    }
    if count > 1 {
        w_index(item, c"__i", c"self", pcx);
        w(c"        ", pcx);
        wp(item, c"::hash::Hash::hash(&__i, state);\n", pcx);
    }
    if !some_fields(item, pcx) {
        if count == 1 {
            w(c"        let _ = state;\n", pcx);
        }
        return;
    }
    w(c"        match self {\n", pcx);
    for i in 0..count {
        let v = child(item, i, pcx);
        if pcx.nodes[v as usize].count == 0 {
            continue;
        }
        w(c"            ", pcx);
        w_variant_pattern(item, v, c"__a", pcx);
        w(c" => {\n", pcx);
        for k in 0..pcx.nodes[v as usize].count {
            span_from(child(v, k, pcx), pcx);
            w(c"                ", pcx);
            wp(item, c"::hash::Hash::hash(__a", pcx);
            w_int(k, pcx);
            w(c", state);\n", pcx);
            span_from(d, pcx);
        }
        w(c"            }\n", pcx);
    }
    if (0i64..count).any(|i| pcx.nodes[child(item, i, pcx) as usize].count == 0) {
        w(c"            _ => {}\n", pcx);
    }
    w(c"        }\n", pcx);
}

// `f.debug_struct("P").field("x", &self.x).finish()`, `debug_tuple`, or
// the name of a unit struct, as Rust prints them.
fn struct_debug(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    let count = pcx.nodes[item as usize].count;
    w(c"        f.", pcx);
    if count == 0 {
        w(c"write_str(\"", pcx);
        w_sym(pcx.nodes[item as usize].a, pcx);
        w(c"\")\n", pcx);
        return;
    }
    let tuple = tuple_struct(item, pcx);
    w(if tuple { c"debug_tuple(\"" } else { c"debug_struct(\"" }, pcx);
    w_sym(pcx.nodes[item as usize].a, pcx);
    w(c"\")", pcx);
    for i in 0..count {
        let field = child(item, i, pcx);
        span_from(field, pcx);
        w(c"\n            .field(", pcx);
        if !tuple {
            w(c"\"", pcx);
            w_sym(pcx.nodes[field as usize].a, pcx);
            w(c"\", ", pcx);
        }
        w_field_arg(field, c"self", pcx);
        w(c")", pcx);
        span_from(d, pcx);
    }
    w(c"\n            .finish()\n", pcx);
}

fn enum_debug(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[item as usize].count == 0 {
        w(c"        match *self {}\n", pcx);
        return;
    }
    w(c"        match self {\n", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let v = child(item, i, pcx);
        let names = pcx.nodes[v as usize].d;
        w(c"            ", pcx);
        w_variant_pattern(item, v, c"__a", pcx);
        w(c" => f.", pcx);
        if pcx.nodes[v as usize].count == 0 {
            w(c"write_str(\"", pcx);
            w_sym(pcx.nodes[v as usize].a, pcx);
            w(c"\"),\n", pcx);
            continue;
        }
        w(if names != 0 { c"debug_struct(\"" } else { c"debug_tuple(\"" }, pcx);
        w_sym(pcx.nodes[v as usize].a, pcx);
        w(c"\")", pcx);
        for k in 0..pcx.nodes[v as usize].count {
            span_from(child(v, k, pcx), pcx);
            w(c".field(", pcx);
            if names != 0 {
                w(c"\"", pcx);
                w_sym(pcx.nodes[child(names, k, pcx) as usize].a, pcx);
                w(c"\", ", pcx);
            }
            w(c"__a", pcx);
            w_int(k, pcx);
            w(c")", pcx);
            span_from(d, pcx);
        }
        w(c".finish(),\n", pcx);
    }
    w(c"        }\n", pcx);
}

// (0.27.8) Whether a derived Clone of `item` is `*self`, as rustc's: the
// list derives Copy too and `item` has no type parameters (a parameter's
// Clone is not its Copy).
fn plain_copy(item: i64, pcx: &Ctx<Comp>) -> bool {
    let g = pcx.nodes[item as usize].g;
    derives_copy(item, pcx) && (g == 0 || pcx.nodes[g as usize].count == 0)
}

// `S { a: Clone::clone(&self.a), .. }` (a raw pointer field copied).
fn struct_clone(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    if plain_copy(item, pcx) {
        w(c"        *self\n", pcx);
        return;
    }
    w(c"        ", pcx);
    w_sym(pcx.nodes[item as usize].a, pcx);
    w(c" {", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let field = child(item, i, pcx);
        if i > 0 {
            w(c",", pcx);
        }
        span_from(field, pcx);
        w(c" ", pcx);
        w_sym(pcx.nodes[field as usize].a, pcx);
        if raw_pointer_field(field, pcx) || shared_ref_field(field, pcx) {
            w(c": self.", pcx);
        } else {
            w(c": ", pcx);
            wp(item, c"::clone::Clone::clone(&self.", pcx);
        }
        w_sym(pcx.nodes[field as usize].a, pcx);
        if !raw_pointer_field(field, pcx) && !shared_ref_field(field, pcx) {
            w(c")", pcx);
        }
        span_from(d, pcx);
    }
    w(c" }\n", pcx);
}

// `E::V(a, ..)` or `E::V { x: a, .. }` of variant v, each field's value
// written by `field` (0: Clone::clone(__aK), 1: Default::default()).
fn w_variant_value(item: i64, v: i64, field: i64, pcx: &mut Ctx<Comp>) {
    w_sym(pcx.nodes[item as usize].a, pcx);
    w(c"::", pcx);
    w_sym(pcx.nodes[v as usize].a, pcx);
    let names = pcx.nodes[v as usize].d;
    if pcx.nodes[v as usize].count == 0 && pcx.nodes[v as usize].c == 0 {
        return;
    }
    w(if names != 0 { c" { " } else { c"(" }, pcx);
    for k in 0..pcx.nodes[v as usize].count {
        if k > 0 {
            w(c", ", pcx);
        }
        if names != 0 {
            w_sym(pcx.nodes[child(names, k, pcx) as usize].a, pcx);
            w(c": ", pcx);
        }
        if field == 0 {
            wp(item, c"::clone::Clone::clone(__a", pcx);
            w_int(k, pcx);
            w(c")", pcx);
        } else {
            wp(item, c"::default::Default::default()", pcx);
        }
    }
    w(if names != 0 { c" }" } else { c")" }, pcx);
}

fn enum_clone(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[item as usize].count == 0 {
        w(c"        match *self {}\n", pcx);
        return;
    }
    if plain_copy(item, pcx) {
        w(c"        *self\n", pcx);
        return;
    }
    w(c"        match self {\n", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let v = child(item, i, pcx);
        w(c"            ", pcx);
        w_variant_pattern(item, v, c"__a", pcx);
        w(c" => ", pcx);
        w_variant_value(item, v, 0, pcx);
        w(c",\n", pcx);
    }
    let _ = d;
    w(c"        }\n", pcx);
}

// `S { a: Default::default(), .. }`.
fn struct_default(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    w(c"        ", pcx);
    w_sym(pcx.nodes[item as usize].a, pcx);
    w(c" {", pcx);
    for i in 0..pcx.nodes[item as usize].count {
        let field = child(item, i, pcx);
        if i > 0 {
            w(c",", pcx);
        }
        span_from(field, pcx);
        w(c" ", pcx);
        w_sym(pcx.nodes[field as usize].a, pcx);
        w(c": ", pcx);
        wp(item, c"::default::Default::default()", pcx);
        span_from(d, pcx);
    }
    w(c" }\n", pcx);
}

// The `#[default]` variant (F17.1); without one, `error derive.default`.
fn enum_default(item: i64, d: i64, pcx: &mut Ctx<Comp>) {
    let mut chosen: i64 = -1;
    for i in 0..pcx.nodes[item as usize].count {
        if (pcx.nodes[child(item, i, pcx) as usize].p & crate::front::ast::VARIANT_DEFAULT) != 0 {
            chosen = i;
        }
    }
    if chosen < 0 {
        err_begin(pcx.nodes[d as usize].start, pcx);
        pcx.err_kind = c"derive.default";
        err_fmt(format_args("cannot derive Default for '{}': no variant is marked #[default]",
            str::from_utf8(sym_text(pcx.nodes[item as usize].a, pcx)).unwrap()), pcx);
        err_help(
            c"mark the default variant `#[default]` (a variant without fields), or write the impl", pcx);
        err_end_soft(pcx);
        w(c"        loop {}\n", pcx);
        return;
    }
    w(c"        ", pcx);
    w_variant_value(item, child(item, chosen, pcx), 1, pcx);
    w(c"\n", pcx);
}
