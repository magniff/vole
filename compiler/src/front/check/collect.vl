// Collecting the declarations (the first phases of collect_phase): every
// item's name in its module, the constants' types, the structs' fields,
// the enums' variants (their discriminants and tag types), the methods of
// impl blocks (generic ones as templates) and the type aliases.

use crate::base::{
    FILES, IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, grow,
    intern, intern_c,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_file_line, err_begin, err_end, err_end_soft, err_fix, err_help, err_help_fmt, err_help_sym,
    err_int, err_str, err_sym, err_try_tool, error_at, error_at_soft,
};
use crate::front::ast::{
    FN_COLD, FN_EFFECT_DECL, FN_INLINE, FN_NO_INLINE, FN_SIG_FAILED, FN_UNSAFE, NODES, NodeKind,
    REPR_C, REPR_INT, child,
};
use crate::front::ast::NodeKind::{
    CStr, Const, Enum, ExternFn, Fn, Impl, Mod, Static, Str, Struct, Trait, TyArray, TyName,
    TySlice, TypeAlias, Use,
};
use crate::front::check::{
    Try, attempt, name_error, resolve_type_or_error, type_error, type_error_got,
};
use crate::front::check::distinct::distinct_tpl_symbol;
use crate::front::check::resolve::{resolve_alias, resolve_type, type_name_key};
use crate::front::check::synth_mode::synth_expr;
use crate::front::consteval::{const_eval, wrap_int};
use crate::front::contracts::is_distinct;
use crate::front::convert::{generic_trait_impl, impl_fn_symbol};
use crate::front::distinct::is_view_distinct;
use crate::front::generics::{
    TPL_DISTINCT, TPL_NONE, TPL_SLICE, env_lookup, template_name, template_of_key,
};
use crate::front::modules::{
    MODULES, child_module, file_of_pos, item_symbol, join_sym, module_of, qualify,
};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::parser::items::attrs::views_of;
use crate::front::traits::{add_trait, builtin_type_symbol, impl_of_fn};
use crate::front::types::{
    ConstInfo, ENUMS, EnumInfo, FIELDS, FNS, FN_COUNT, FieldInfo, FnInfo, MethodInfo, STATICS,
    STRUCTS, SYM_STATIC, StaticInfo, StructInfo, TLISTS, TSCRATCH, TYPES, TY_BOOL, TY_ERROR, TY_I16,
    TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U8, TY_UNIT, TyKind, VARIANTS, VariantInfo, buf_type,
    enum_variant, err_type, find_method, find_variant, int_bits, is_fieldless_enum, is_integer,
    is_numeric, is_pointer, is_signed, item_node_of, make_type, variant_field,
};

// A second item of an item's name (0.17: the help says where the first is;
// the try: lines delete either, by position).
fn duplicate_error(item: i64, kind: *u8, pcx: inout Ctx<Comp>) -> ! {
    unsafe {
        err_begin(NODES[item].start, &pcx);
        err_str(c"duplicate ", pcx);
        err_str(kind, pcx);
        err_str(c" '", pcx);
        err_sym(NODES[item].a, pcx);
        err_str(c"'", pcx);
        let first = item_node_of(qualify(module_of(item, &pcx), NODES[item].a, &pcx), pcx);
        if first != 0 && first != item && FILES[file_of_pos(NODES[first].start)].path[0] != '<' {
            let here = buf_new();
            buf_file_line(here, NODES[item].start, &pcx);
            let there = buf_new();
            buf_file_line(there, NODES[first].start, &pcx);
            err_help_fmt(format_args("it is defined at {} too: keep one (delete either, try:), or give this one another name; `volec edit replace NAME < text` changes an item in place", buf_slice(there)), pcx);
            let a = buf_new();
            buf_fmt(a, format_args("edit delete {}", buf_slice(here)));
            err_try_tool(buf_slice(a), true, pcx);
            let b = buf_new();
            buf_fmt(b, format_args("edit delete {}", buf_slice(there)));
            err_try_tool(buf_slice(b), true, pcx);
        }
        err_end(&pcx)
    }
}

pub fn collect_names(pcx: inout Ctx<Comp>) {
    for i in 0..NODES[pcx.program].count {
        attempt(Try::Name, child(pcx.program, i, pcx), &pcx);
    }
}

// The name item declares (a duplicate is left out: a function's x stays
// 0).
pub fn collect_name(item: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var kind = NODES[item].kind;
        if kind == Impl {
            return;
        }
        if kind == Const && NODES[item].b != 0 && NODES[NODES[item].b].kind == TyArray {
            // An array constant (0.9) is an immutable static: memory
            // holding its elements.
            NODES[item].kind = Static;
            NODES[item].d = 0;
            NODES[item].y = 0;
            kind = Static;
        }
        let name = NODES[item].a;
        let m = module_of(item, &pcx);
        if MODULES[m].is_c {
            NODES[item].p |= ITEM_PUBLIC;
        }
        let key = qualify(m, name, &pcx);
        match kind {
            Struct | TypeAlias | Enum => {
                if pcx.sym_struct[key] != 0 || pcx.sym_enum[key] != 0 || pcx.sym_alias[key] != 0
                    || pcx.sym_primitive[name] != 0 || name == pcx.self_type_sym {
                    duplicate_error(item, match kind {
                        Struct => c"struct",
                        Enum => c"enum",
                        _ => c"type",
                    }, &pcx);
                }
                match kind {
                    Struct => add_struct(item, key, m, &pcx),
                    Enum => add_enum(item, key, m, &pcx),
                    _ => pcx.sym_alias[key] = item,
                }
                pcx.sym_item[key] = item;
                return;
            }
            Use => return,
            Trait => {
                if item_node_of(key, pcx) != 0 || pcx.sym_primitive[name] != 0 {
                    duplicate_error(item, c"name", &pcx);
                }
                pcx.sym_item[key] = item;
                add_trait(item, key, m, &pcx);
                return;
            }
            Mod => {
                if item_node_of(key, pcx) != 0 {
                    duplicate_error(item, c"name", &pcx);
                }
                return;
            }
            Fn if NODES[item].d != 0 => {
                // A method or associated function: found through METHODS
                // (see collect_methods), which also names it.
                add_fn(item, name, name, &pcx);
                return;
            }
            _ => {}
        }
        if pcx.sym_fn[key] != 0 || pcx.sym_const[key] != 0 || SYM_STATIC[key] != 0 {
            match kind {
                Const => duplicate_error(item, c"constant", &pcx),
                Static => duplicate_error(item, c"static", &pcx),
                _ => duplicate_error(item, c"function", &pcx),
            }
        }
        if child_module(m, name, pcx) >= 0 {
            duplicate_error(item, c"name (a module has it)", &pcx);
        }
        if name == intern_c(c"size_of") || name == intern_c(c"align_of") {
            name_error(NODES[item].start, c"'", name,
                c"' is a builtin (size_of(T) and align_of(T)); choose another name", &pcx);
        }
        pcx.sym_item[key] = item;
        match kind {
            Fn | ExternFn => {
                // C functions and `extern "C" fn` definitions keep their
                // names as symbols; others are prefixed by their module.
                let c_name = kind == ExternFn || NODES[item].y != 0;
                add_fn(item, if c_name { name } else { item_symbol(m, name, &pcx) }, key, &pcx);
                pcx.sym_fn[key] = FN_COUNT;
            }
            Const => {
                pcx.consts = grow(pcx.consts, pcx.const_count, &pcx.const_cap);
                pcx.consts[pcx.const_count] = ConstInfo { node: item, ty: 0, value: 0, state: 0 };
                pcx.const_count += 1;
                pcx.sym_const[key] = pcx.const_count;
            }
            Static => {
                STATICS = grow(STATICS, pcx.static_count, &pcx.static_cap);
                STATICS[pcx.static_count] = StaticInfo {
                    node: item, ty: 0, mutable: NODES[item].d != 0, linkage: NODES[item].y,
                };
                pcx.static_count += 1;
                SYM_STATIC[key] = pcx.static_count;
                // The static's symbol (its name for C, prefixed by its
                // module otherwise) is its item's name from now on, and
                // also finds it (the code generators look statics up by
                // symbol).
                let sym = if NODES[item].y != 0 { name } else { item_symbol(m, name, &pcx) };
                SYM_STATIC[sym] = pcx.static_count;
                NODES[item].a = sym;
            }
            _ => {}
        }
    }
}

pub fn add_fn(item: i64, name: i64, display: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        FNS = grow(FNS, FN_COUNT, &pcx.fn_cap);
        let kind = NODES[item].kind;
        FNS[FN_COUNT] = FnInfo {
            name: name, node: item, params: 0, param_count: 0, ret: TY_UNIT,
            variadic: kind == ExternFn && NODES[item].d != 0, is_extern: kind == ExternFn,
            self_ty: 0, export: kind == Fn && NODES[item].y != 0,
            display: display, generic: generic_count(NODES[item].g), tmpl: 0, targs: 0,
            targ_count: 0,
            origin: 0, parent: 0, depth: 0, module: module_of(item, &pcx),
            attrs: NODES[item].p & (FN_INLINE | FN_NO_INLINE | FN_COLD | FN_UNSAFE),
            effect_decl: if (NODES[item].p & FN_EFFECT_DECL) != 0 { NODES[item].z } else { 0 },
            views_decl: views_of(item, pcx),
        };
        FN_COUNT += 1;
        NODES[item].x = FN_COUNT;
    }
}

fn generic_count(g: i64) -> i64 {
    if g == 0 { 0 } else { NODES[g].count }
}

// The symbol `Type.name` of a method (from its type's symbol).
fn method_symbol(type_sym: i64, name: i64) -> i64 {
    let out = buf_new();
    buf_bytes(out, SYMS[type_sym].text);
    buf_byte(out, '.');
    buf_bytes(out, SYMS[name].text);
    intern(buf_slice(out))
}

// The symbol of a type with methods.
fn type_symbol(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if TYPES[t].kind == TyKind::Struct { return STRUCTS[TYPES[t].a].sym; }
        if TYPES[t].kind == TyKind::Enum { return ENUMS[TYPES[t].a].sym; }
        // (0.9: a trait's impl for a builtin type)
        builtin_type_symbol(t, &pcx)
    }
}

pub fn new_enum(item: i64, name: i64, sym: i64, module: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        ENUMS = grow(ENUMS, pcx.enum_count, &pcx.enum_cap);
        ENUMS[pcx.enum_count] = EnumInfo {
            name: name, node: item, variants: 0, variant_count: 0, tag: TY_U8,
            has_fields: false, layout_state: 0, repr: NODES[item].c, payload: 0,
            generic: 0, tmpl: 0, targs: 0, targ_count: 0, sym: sym, module: module,
        };
    }
    pcx.enum_count += 1;
    pcx.enum_count - 1
}

fn add_enum(item: i64, key: i64, module: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let e = new_enum(item, NODES[item].a, item_symbol(module, NODES[item].a, &pcx), module,
            &pcx);
        ENUMS[e].generic = generic_count(NODES[item].g);
        pcx.sym_enum[key] = e + 1;
    }
}

pub fn new_struct(item: i64, name: i64, sym: i64, module: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        STRUCTS = grow(STRUCTS, pcx.struct_count, &pcx.struct_cap);
        STRUCTS[pcx.struct_count] = StructInfo {
            name: name, node: item, fields: 0, field_count: 0, layout_state: 0,
            repr: NODES[item].c, align: NODES[item].d,
            generic: 0, tmpl: 0, targs: 0, targ_count: 0, sym: sym, module: module, closure: 0,
        };
    }
    pcx.struct_count += 1;
    pcx.struct_count - 1
}

fn add_struct(item: i64, key: i64, module: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let s = new_struct(item, NODES[item].a, item_symbol(module, NODES[item].a, &pcx), module,
            &pcx);
        STRUCTS[s].generic = generic_count(NODES[item].g);
        pcx.sym_struct[key] = s + 1;
    }
}

pub fn collect_const_types(pcx: inout Ctx<Comp>) {
    unsafe {
        for c in 0..pcx.const_count {
            let item = pcx.consts[c].node;
            pcx.cur_mod = module_of(item, &pcx);
            var ty = resolve_type_or_error(NODES[item].b, &pcx);
            // 0.4: fieldless enums, and C strings (`const S: *u8 = c"...";`);
            // 0.14: strings (`const S: [u8] = "...";`); 0.25.4: text
            // (`const S: str = "...";`), its uses the literal (synth_name).
            let init_kind = NODES[NODES[item].c].kind;
            let string = (is_pointer(ty) && init_kind == CStr)
                || (ty == pcx.ty_string && init_kind == Str)
                || (init_kind == Str && is_view_distinct(ty));
            if !(is_numeric(ty) || ty == TY_BOOL || is_fieldless_enum(ty) || string) {
                err_begin(NODES[NODES[item].b].start, &pcx);
                err_str(c"constant '", pcx);
                err_sym(NODES[item].a, pcx);
                err_str(c"' has type '", pcx);
                err_type(ty, pcx);
                let init = NODES[item].c;
                let array = init_kind == NodeKind::Array;
                err_str(c"'; constants must be integers, floats, bool or string literals", pcx);
                if (ty == pcx.ty_string || is_view_distinct(ty)) && !array {
                    // (0.25.2.1: `const S: [u8] = f();`, `= [A, B][..]`: a
                    // static cannot run code either)
                    err_help(c"a `", pcx);
                    buf_type(pcx.err_help, ty);
                    err_help(c"` constant is one string literal (`const S: ", pcx);
                    buf_type(pcx.err_help, ty);
                    err_help(c" = \"...\";`); text made by code is a function's: `fn ", pcx);
                    err_help_sym(NODES[item].a, pcx);
                    err_help(c"() -> ", pcx);
                    buf_type(pcx.err_help, ty);
                    err_help(c" { ... }`, called where it is used", pcx);
                } else if TYPES[ty].kind == TyKind::Slice && array {
                    // (0.25.2.1: `const VIEWS: [[u8]] = ["a", "b"];`: a
                    // static array, whose slice is `VIEWS[..]`)
                    err_help(c"a `static` array holds them (`X[i]` reads one, `X[..]` is the slice): `static ", pcx);
                    err_help_sym(NODES[item].a, pcx);
                    err_help(c": [", pcx);
                    buf_type(pcx.err_help, TYPES[ty].a);
                    err_help_fmt(format_args("; {}] = ...;`", NODES[init].count), pcx);
                    // (0.25.2.2) the fix: `const S: [T]` is `static S: [T; N]`
                    let tn = NODES[item].b;
                    var k = NODES[item].start;
                    while k + 6 < NODES[tn].start && SRC[k..k + 6] != "const " {
                        k += 1;
                    }
                    if k + 6 < NODES[tn].start {
                        let fix = buf_new();
                        buf_fmt(fix, format_args("static {}: [", SYMS[NODES[item].a].text));
                        buf_type(fix, TYPES[ty].a);
                        buf_fmt(fix, format_args("; {}]", NODES[init].count));
                        err_fix(k, NODES[tn].end, buf_slice(fix), &pcx);
                    }
                } else {
                    err_help(c"a `static` holds other values: `static ", pcx);
                    err_help_sym(NODES[item].a, pcx);
                    err_help(c": ", pcx);
                    buf_type(pcx.err_help, ty);
                    err_help(c" = ...;`", pcx);
                }
                err_end_soft(&pcx);
                ty = TY_ERROR;
            }
            pcx.consts[c].ty = ty;
        }
    }
}

pub fn collect_structs(pcx: inout Ctx<Comp>) {
    unsafe {
        for s in 0..pcx.struct_count {
            if STRUCTS[s].generic == 0 && STRUCTS[s].tmpl == 0 {
                pcx.cur_mod = STRUCTS[s].module;
                collect_struct_fields(s, &pcx);
            }
        }
        pcx.cur_mod = 0;
    }
}

// The fields of struct s (of a struct item, or of an instance of a
// generic one, with its parameters in scope).
pub fn collect_struct_fields(s: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let item = STRUCTS[s].node;
        let mark = TSCRATCH.count;
        for i in 0..NODES[item].count {
            let field = child(item, i, pcx);
            for j in 0..i {
                if NODES[child(item, j, pcx)].a == NODES[field].a {
                    err_begin(NODES[field].start, &pcx);
                    err_str(c"duplicate field '", pcx);
                    err_sym(NODES[field].a, pcx);
                    err_str(c"' in struct '", pcx);
                    err_sym(NODES[item].a, pcx);
                    err_str(c"'", pcx);
                    err_end_soft(&pcx);
                    break;
                }
            }
            let ty = resolve_type_or_error(NODES[field].b, &pcx);
            TSCRATCH.push(ty);
        }
        // Instances made while resolving the types added fields of their own:
        // this struct's go after them.
        STRUCTS[s].fields = pcx.field_count;
        for i in 0..NODES[item].count {
            FIELDS = grow(FIELDS, pcx.field_count, &pcx.field_cap);
            FIELDS[pcx.field_count] = FieldInfo {
                name: NODES[child(item, i, pcx)].a, ty: TSCRATCH.data[mark + i], offset: 0,
            };
            pcx.field_count += 1;
        }
        TSCRATCH.count = mark;
        STRUCTS[s].field_count = NODES[item].count;
    }
}

pub fn collect_enums(pcx: inout Ctx<Comp>) {
    unsafe {
        for e in 0..pcx.enum_count {
            if ENUMS[e].generic == 0 && ENUMS[e].tmpl == 0 {
                pcx.cur_mod = ENUMS[e].module;
                collect_enum_variants(e, &pcx);
            }
        }
        pcx.cur_mod = 0;
    }
}

// The variants of enum e (of an enum item, or of an instance of a generic
// one, with its parameters in scope).
pub fn collect_enum_variants(e: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let item = ENUMS[e].node;
        var has_fields = false;
        for i in 0..NODES[item].count {
            if NODES[child(item, i, pcx)].c != 0 {
                has_fields = true;
            }
        }
        ENUMS[e].has_fields = has_fields;
        // The field types of every variant first (resolving them may make
        // instances, with variants of their own), then the variants.
        let types = TSCRATCH.count;
        var discrs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var next = 0;
        var low = 0;
        var high = 0;
        for i in 0..NODES[item].count {
            let node = child(item, i, pcx);
            for j in 0..i {
                if NODES[child(item, j, pcx)].a == NODES[node].a {
                    err_begin(NODES[node].start, &pcx);
                    err_str(c"duplicate variant '", pcx);
                    err_sym(NODES[node].a, pcx);
                    err_str(c"' in enum '", pcx);
                    err_sym(NODES[item].a, pcx);
                    err_str(c"'", pcx);
                    err_end_soft(&pcx);
                    break;
                }
            }
            if NODES[node].c != 0 && NODES[node].count == 0 {
                error_at_soft(NODES[node].start,
                    c"a tuple variant needs at least one field; write the variant without '()'",
                    &pcx);
            }
            for k in 0..NODES[node].count {
                let ty = resolve_type_or_error(child(node, k, pcx), &pcx);
                TSCRATCH.push(ty);
            }
            var discr = next;
            if NODES[node].b != 0 {
                if has_fields {
                    error_at_soft(NODES[NODES[node].b].start,
                        c"explicit discriminants are only allowed in enums without fields", &pcx);
                } else if attempt(Try::Discr, NODES[node].b, &pcx) {
                    discr = pcx.try_result;
                }
            }
            for j in 0..i {
                if discrs.data[j] == discr {
                    err_begin(NODES[node].start, &pcx);
                    err_str(c"discriminant ", pcx);
                    err_int(discr, pcx);
                    err_str(c" of variant '", pcx);
                    err_sym(NODES[node].a, pcx);
                    err_str(c"' is already used by '", pcx);
                    err_sym(NODES[child(item, j, pcx)].a, pcx);
                    err_str(c"'", pcx);
                    err_end_soft(&pcx);
                    break;
                }
            }
            discrs.push(discr);
            if i == 0 || discr < low {
                low = discr;
            }
            if i == 0 || discr > high {
                high = discr;
            }
            next = discr + 1;
        }
        ENUMS[e].variants = pcx.variant_count;
        ENUMS[e].variant_count = NODES[item].count;
        var at = types;
        for i in 0..NODES[item].count {
            let node = child(item, i, pcx);
            let fields = TLISTS.count;
            for k in 0..NODES[node].count {
                TLISTS.push(TSCRATCH.data[at + k]);
            }
            at += NODES[node].count;
            VARIANTS = grow(VARIANTS, pcx.variant_count, &pcx.variant_cap);
            VARIANTS[pcx.variant_count] = VariantInfo {
                name: NODES[node].a, node: node, enum_id: e, discr: discrs.data[i], fields: fields,
                field_count: NODES[node].count, shape: 0,
            };
            pcx.variant_count += 1;
        }
        TSCRATCH.count = types;
        ENUMS[e].tag = enum_tag_type(e, item, low, high, &pcx);
        let repr_c = (ENUMS[e].repr & REPR_C) != 0;
        if has_fields {
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                let mark = TSCRATCH.count;
                if !repr_c {
                    TSCRATCH.push(ENUMS[e].tag);
                }
                for k in 0..VARIANTS[v].field_count {
                    TSCRATCH.push(variant_field(v, k));
                }
                VARIANTS[v].shape = make_type(TyKind::Tuple, 0, 0, mark);
            }
        }
    }
}

// The type of the tag of enum e: from #[repr(u8)] and the like, a C int
// for #[repr(C)], else the smallest that holds every discriminant.
fn enum_tag_type(e: i64, item: i64, low: i64, high: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var tag = 0;
        if (ENUMS[e].repr & REPR_INT) != 0 {
            tag = pcx.sym_primitive[NODES[item].d];
        } else if (ENUMS[e].repr & REPR_C) != 0 {
            tag = TY_I32;
        } else {
            return tag_type_for(low, high);
        }
        if ENUMS[e].variant_count > 0
            && (wrap_int(low, tag) != low || wrap_int(high, tag) != high) {
            err_begin(NODES[item].start, &pcx);
            err_str(c"the discriminants of enum '", pcx);
            err_sym(NODES[item].a, pcx);
            err_str(c"' do not fit its tag type '", pcx);
            err_type(tag, pcx);
            err_str(c"'", pcx);
            err_end_soft(&pcx);
        }
        tag
    }
}

// The smallest integer type holding every discriminant in low..=high.
fn tag_type_for(low: i64, high: i64) -> i64 {
    if low >= 0 {
        if high <= 255 { return TY_U8; }
        if high <= 65535 { return TY_U16; }
        if high <= 4294967295 { return TY_U32; }
        return TY_I64;
    }
    if low >= -128 && high <= 127 { return TY_I8; }
    if low >= -32768 && high <= 32767 { return TY_I16; }
    if low >= -2147483648 && high <= 2147483647 { return TY_I32; }
    TY_I64
}

pub fn eval_discriminant(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let saved_context = pcx.const_context;
    pcx.const_context = true;
    let ty = synth_expr(n, &pcx);
    if !is_integer(ty) {
        type_error_got(n, c"an enum discriminant must be an integer", ty, &pcx);
    }
    let value = const_eval(n, &pcx);
    pcx.const_context = saved_context;
    if !is_signed(ty) && int_bits(ty) == 64 && value < 0 {
        type_error(n, c"an enum discriminant must fit in i64", &pcx);
    }
    value
}

// The methods and associated functions of impl blocks. Those of a
// generic type (`impl<T> Vec<T>`) are templates, found through GMETHODS
// by the type's template; the others are found through METHODS by type.
pub fn collect_methods(pcx: inout Ctx<Comp>) {
    unsafe {
        for f in 0..FN_COUNT {
            let item = FNS[f].node;
            if FNS[f].is_extern || NODES[item].h == 0 || (NODES[item].p & FN_SIG_FAILED) != 0 {
                continue;
            }
            if !attempt(Try::Method, f, &pcx) {
                // (its Self is unknown: neither its signature nor its body
                // is checked)
                NODES[item].p |= FN_SIG_FAILED;
            }
        }
        pcx.cur_mod = 0;
    }
}

pub fn collect_method(f: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let item = FNS[f].node;
        let self_node = NODES[item].h;
        // (its own module but for a trait default copied into an impl,
        // 0.14: the impl's, where the type is written)
        pcx.cur_mod = module_of(self_node, &pcx);
        let name = NODES[item].a;
        let tpl = impl_template(item, &pcx);
        // (0.15: a function of a generic trait's impl, `from` of `impl
        // From<i64> for T`, has no name in the type: generic_trait_call
        // finds it; its symbol is its impl's)
        let gt = generic_trait_impl(impl_of_fn(f, pcx), pcx);
        if tpl != TPL_NONE && gt >= 0 {
            let base = if tpl == TPL_SLICE { intern_c(c"TS") }
                else if tpl >= TPL_DISTINCT { distinct_tpl_symbol(tpl, &pcx) }
                else if tpl > 0 { STRUCTS[tpl - 1].sym } else { ENUMS[-tpl - 1].sym };
            FNS[f].name = impl_fn_symbol(method_symbol(base, name), gt);
            FNS[f].display = join_sym(template_name(tpl), c"::", name, &pcx);
            return;
        }
        if tpl != TPL_NONE {
            for i in 0..pcx.gmethods.len() as i64 {
                if pcx.gmethods[i].ty == tpl && pcx.gmethods[i].name == name {
                    err_begin(NODES[item].start, &pcx);
                    err_str(c"duplicate method '", pcx);
                    err_sym(name, pcx);
                    err_str(c"' for type '", pcx);
                    err_sym(template_name(tpl), pcx);
                    err_str(c"'", pcx);
                    err_end(&pcx);
                }
            }
            if tpl < 0 && template_variant_named(-tpl - 1, name, pcx) {
                variant_and_method_error(item, template_name(tpl), &pcx);
            }
            pcx.gmethods.push(MethodInfo { ty: tpl, name: name, f: f });
            let base = if tpl == TPL_SLICE { intern_c(c"TS") }
                else if tpl >= TPL_DISTINCT { distinct_tpl_symbol(tpl, &pcx) }
                else if tpl > 0 { STRUCTS[tpl - 1].sym } else { ENUMS[-tpl - 1].sym };
            FNS[f].name = method_symbol(base, name);
            FNS[f].display = join_sym(template_name(tpl), c"::", name, &pcx);
            return;
        }
        if NODES[self_node].kind == TyName && NODES[self_node].count == 0 && NODES[self_node].g == 0
            && type_name_key(self_node, &pcx) < 0
            && pcx.sym_primitive[NODES[self_node].a] == 0
            && env_lookup(NODES[self_node].a, pcx) == 0 {
            name_error(NODES[item].start, c"impl for unknown type '", NODES[self_node].a, c"'",
                &pcx);
        }
        let t = resolve_type(self_node, &pcx);
        let kind = TYPES[t].kind;
        if kind != TyKind::Struct && kind != TyKind::Enum && kind != TyKind::Distinct
            && impl_of_fn(f, pcx) < 0 {
            err_begin(NODES[item].start, &pcx);
            err_str(c"impl blocks are only allowed for structs and enums, not '", pcx);
            err_type(t, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        if find_method(t, name, pcx) >= 0 && gt < 0 {
            err_begin(NODES[item].start, &pcx);
            err_str(c"duplicate method '", pcx);
            err_sym(name, pcx);
            err_str(c"' for type '", pcx);
            err_type(t, pcx);
            err_str(c"'", pcx);
            let first = FNS[find_method(t, name, pcx)].node;
            if first != 0 && FILES[file_of_pos(NODES[first].start)].path[0] != '<' {
                let there = buf_new();
                buf_file_line(there, NODES[first].start, &pcx);
                err_help_fmt(
                    format_args("it is defined at {} too: keep one (delete either), or give this one another name", buf_slice(there)), pcx);
                let a = buf_new();
                buf_str(a, c"edit delete ");
                buf_file_line(a, NODES[item].start, &pcx);
                err_try_tool(buf_slice(a), true, pcx);
            }
            err_end(&pcx);
        }
        if kind == TyKind::Enum && find_variant(TYPES[t].a, name) >= 0 && gt < 0 {
            let out = buf_new();
            buf_type(out, t);
            variant_and_method_error(item, intern(buf_slice(out)), &pcx);
        }
        if FNS[f].generic == 0 {
            FNS[f].self_ty = t;
        }
        FNS[f].name = method_symbol(type_symbol(t, &pcx), name);
        let out = buf_new();
        buf_type(out, t);
        buf_str(out, c"::");
        buf_bytes(out, SYMS[name].text);
        FNS[f].display = intern(buf_slice(out));
        if gt >= 0 {
            FNS[f].name = impl_fn_symbol(FNS[f].name, gt);
            return;
        }
        pcx.methods.push(MethodInfo { ty: t, name: name, f: f });
    }
}

fn variant_and_method_error(item: i64, type_name: i64, pcx: inout Ctx<Comp>) -> ! {
    err_begin(NODES[item].start, &pcx);
    err_str(c"'", pcx);
    err_sym(NODES[item].a, pcx);
    err_str(c"' is both a variant and an associated function of '", pcx);
    err_sym(type_name, pcx);
    err_str(c"'", pcx);
    err_end(&pcx)
}

pub fn template_variant_named(e: i64, name: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let item = ENUMS[e].node;
        for i in 0..NODES[item].count {
            if NODES[child(item, i, pcx)].a == name {
                return true;
            }
        }
        false
    }
}

// The template an impl block is for, when it is generic (`impl<T>
// Vec<T>`): its self type names a generic type with the impl's
// parameters as arguments. TPL_NONE otherwise.
fn impl_template(item: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let self_node = NODES[item].h;
        let tpl = template_of_type_node(self_node, &pcx);
        if tpl == TPL_NONE {
            // (0.14: `impl<T> [T]`)
            return slice_template(self_node, NODES[item].g, &pcx);
        }
        let params = NODES[item].g;
        let impl_count = if params == 0 { 0 } else { NODES[params].a };
        if impl_count == 0 {
            // `impl Vec<i64>`: methods of one instance.
            return TPL_NONE;
        }
        let g = NODES[self_node].g;
        // (0.16: with a default type parameter, still every argument)
        let full = if tpl >= TPL_DISTINCT { NODES[NODES[tpl - TPL_DISTINCT].g].count }
            else if tpl > 0 { STRUCTS[tpl - 1].generic } else { ENUMS[-tpl - 1].generic };
        if g != 0 && NODES[g].count < full && NODES[g].count == impl_count {
            impl_args_error(item, self_node, tpl, params, &pcx);
        }
        if g == 0 || NODES[g].count != impl_count {
            error_at(NODES[self_node].start, c"a generic impl block is for its type with its parameters as arguments: 'impl<T> Vec<T>'", &pcx);
        }
        for i in 0..impl_count {
            let arg = child(g, i, pcx);
            if NODES[arg].kind != TyName || NODES[arg].a != NODES[child(params, i, pcx)].a
                || NODES[arg].g != 0 {
                error_at(NODES[arg].start, c"a generic impl block is for its type with its parameters as arguments, in order: 'impl<T> Vec<T>'", &pcx);
            }
        }
        crate::front::check::alloc_rules::note_generic_impl(item, tpl, g, &pcx);
        tpl
    }
}

// An impl block whose type leaves out arguments that have defaults (0.16):
// `impl<T> Vec<T>` is an error, its type parameters are written in full,
// `impl<T, A: Allocator> Vec<T, A>`.
fn impl_args_error(item: i64, self_node: i64, tpl: i64, params: i64, pcx: inout Ctx<Comp>) -> ! {
    unsafe {
        let node = if tpl > 0 { STRUCTS[tpl - 1].node } else { ENUMS[-tpl - 1].node };
        let tparams = NODES[node].g;
        let out = buf_new();
        buf_str(out, c"impl<");
        for i in 0..NODES[tparams].count {
            if i > 0 {
                buf_str(out, c", ");
            }
            let p = if i < NODES[params].count { child(params, i, pcx) }
                else { child(tparams, i, pcx) };
            buf_bytes(out, SYMS[NODES[p].a].text);
            if i >= NODES[params].count && NODES[NODES[p].h].count > 0
                && NODES[child(NODES[p].h, 0, pcx)].kind == NodeKind::TyName {
                buf_str(out, c": ");
                buf_bytes(out, SYMS[NODES[child(NODES[p].h, 0, pcx)].a].text);
            }
        }
        buf_str(out, c"> ");
        let name = template_name(tpl);
        buf_bytes(out, SYMS[name].text);
        buf_byte(out, '<');
        for i in 0..NODES[tparams].count {
            if i > 0 {
                buf_str(out, c", ");
            }
            let p = if i < NODES[params].count { child(params, i, pcx) }
                else { child(tparams, i, pcx) };
            buf_bytes(out, SYMS[NODES[p].a].text);
        }
        buf_byte(out, '>');
        // (0.26.3: the allocators left out, alloc.default with its fix)
        crate::front::check::alloc_rules::impl_missing_allocator(item, self_node, tparams, params,
            name, intern(buf_slice(out)), &pcx);
        err_begin(NODES[self_node].start, &pcx);
        err_str(c"an impl block writes every type argument of '", pcx);
        err_sym(template_name(tpl), pcx);
        err_str(c"', also those with defaults", pcx);
        err_help(c"'", pcx);
        err_help_sym(intern(buf_slice(out)), pcx);
        err_help(c"'", pcx);
        err_end(&pcx)
    }
}

// (0.14) TPL_SLICE when type node n is `[T]`, T the only parameter of the
// impl whose parameters (then the function's own) are `params`;
// TPL_NONE otherwise.
pub fn slice_template(n: i64, params: i64, pcx: inout Ctx<Comp>) -> i64 {
    if NODES[n].kind != TySlice || params == 0 {
        return TPL_NONE;
    }
    let elem = NODES[n].a;
    let impl_count = if NODES[params].a != 0 { NODES[params].a } else { NODES[params].count };
    if impl_count != 1 || NODES[elem].kind != TyName || NODES[elem].count != 0
        || NODES[elem].g != 0 || NODES[elem].a != NODES[child(params, 0, pcx)].a {
        error_at(NODES[n].start,
            c"a generic impl for slices is for '[T]', T its only parameter: 'impl<T> [T]'", &pcx);
    }
    TPL_SLICE
}

// The template a TyName names (a generic struct or enum), or TPL_NONE.
pub fn template_of_type_node(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    if NODES[n].kind != TyName || env_lookup(NODES[n].a, pcx) != 0 {
        return TPL_NONE;
    }
    let key = type_name_key(n, &pcx);
    if key < 0 {
        return TPL_NONE;
    }
    let tpl = template_of_key(key, pcx);
    // (0.18: a generic distinct type, `impl<T> NonNull<T>`)
    let alias = unsafe { pcx.sym_alias[key] };
    if tpl == TPL_NONE && alias != 0 && (NODES[alias].g != 0) && is_distinct(alias, pcx) {
        return TPL_DISTINCT + alias;
    }
    tpl
}

// The method template `name` of template tpl, or -1.
pub fn find_generic_method(tpl: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    for i in 0..pcx.gmethods.len() as i64 {
        if pcx.gmethods[i].ty == tpl && pcx.gmethods[i].name == name {
            return pcx.gmethods[i].f;
        }
    }
    -1
}

pub fn collect_aliases(pcx: inout Ctx<Comp>) {
    for i in 0..NODES[pcx.program].count {
        let item = child(pcx.program, i, pcx);
        // (generic aliases (0.6) are resolved where they are used)
        if NODES[item].kind == TypeAlias && NODES[item].g == 0 {
            pcx.cur_mod = module_of(item, &pcx);
            resolve_alias(qualify(pcx.cur_mod, NODES[item].a, &pcx), NODES[item].start, &pcx);
        }
    }
    pcx.cur_mod = 0;
}
