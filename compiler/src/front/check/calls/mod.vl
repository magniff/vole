// Calls: direct calls and calls through a function value, their arguments
// against the parameters (generic functions instantiated), paths
// (`m::f`, `T::f`, `Enum::Variant`) and the calls through them, and
// method calls (`x.m()`, with `&x` or `*x` as its `self` needs).

pub mod paths;

use crate::base::{
    BUFS, SRC, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, intern, intern_c,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_failed_name, err_fix, err_help, err_help_fmt, err_help_sym, err_int,
    err_str, err_sym, err_try_fmt, err_try_tool,
};
use crate::front::ambient::has_local_gpa;
use crate::front::assoc::ensure_checked;
use crate::front::ast::{
    NODE_CHECKED, NODE_REF_MUT, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::ast::NodeKind::{Call, Ident, Index, Range, Unary};
use crate::front::check::{Res, is_std_named, name_error};
use crate::front::check::args::{arity_help, int_limit_help, normalize_args};
use crate::front::check::assign::is_place;
use crate::front::check::collect::find_generic_method;
use crate::front::check::distinct::{distinct_method_error, is_utf8_text, null_test};
use crate::front::check::interp::{direct_call, direct_kind};
use crate::front::check::names::{Near, help_nearest, near_to, std_has};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::{U_METHOD, check_call_safety, is_borrow, unsafe_through};
use crate::front::check::vectors::{sym_is_c, vector_method};
use crate::front::convert::generic_trait_call;
use crate::front::derive::intrinsic::{has_intrinsic_method, intrinsic_method};
use crate::front::generics::{TPL_DISTINCT, TPL_SLICE, check_call_arg};
use crate::front::generics::instantiate::instantiate_call;
use crate::front::lexer::{SUF_USIZE, Tok};
