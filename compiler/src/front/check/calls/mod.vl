// ---- Paths, variants and methods ----

// The method or associated function `name` of type t: of its impl
// blocks, or a template of the generic impl blocks of its template.
pub fn method_of(t: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let f = find_method(t, name, pcx);
        if f >= 0 {
            return f;
        }
        let kind = pcx.types[t].kind;
        // RULE: Z9.1c (0.27.4: a view's methods are its place's, the
        // autoderef step from `&str` to `str`; a slice's generic ones below)
        let place = crate::front::types::find_place_of_view(t, pcx);
        if place > 0 {
            let g = find_method(place, name, pcx);
            // (its `&self` methods and associated functions, `str::from_utf8`:
            // a by-value `self` one takes no view)
            if g >= 0 && (node_ref_self(g, pcx) || !node_has_self(g, pcx)) {
                return g;
            }
        }
        if kind == TyKind::Unsized && pcx.types[pcx.types[t].a].kind == TyKind::Slice {
            return find_generic_method(TPL_SLICE, name, pcx);
        }
        if kind == TyKind::Unsized {
            return method_of(pcx.types[t].a, name, pcx);
        }
        if kind == TyKind::Struct && pcx.structs[pcx.types[t].a].tmpl != 0 {
            return find_generic_method(pcx.structs[pcx.types[t].a].tmpl, name, pcx);
        }
        if kind == TyKind::Enum && ENUMS[pcx.types[t].a].tmpl != 0 {
            return find_generic_method(-ENUMS[pcx.types[t].a].tmpl, name, pcx);
        }
        // (0.18: `impl<T> NonNull<T>`)
        if kind == TyKind::Distinct && pcx.types[t].count > 0 {
            return find_generic_method(TPL_DISTINCT + pcx.types[t].b, name, pcx);
        }
        // (0.14: `impl<T> [T]`)
        if kind == TyKind::Slice {
            return find_generic_method(TPL_SLICE, name, pcx);
        }
        -1
    }
}

// (0.27.2) The method or associated function `name` of type t from the
// pattern impls (TPL_PATTERN, the rust edition's `impl<'a, T> Option<&'a
// T>`, `impl<T> Tr for &T`): the first whose header matches t with its
// bounds holding, or -1. RULE: F0.5(i), F5.1, F6.1
pub fn pattern_method_of(t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    pattern_method_via(t, name, -1, &pcx)
}

// (0.27.2) pattern_method_of of trait `via`'s impls only (-1: any):
// `Debug::fmt(&r, f)` is Debug's `impl<T> Debug for &T`, not Display's
// of the same shape. RULE: F8.2
pub fn pattern_method_via(t: i64, name: i64, via: i64, pcx: inout Ctx<Comp>) -> i64 {
    var i = gm_start(TPL_PATTERN, name, pcx);
    while i >= 0 {
        let at = i;
        i = gm_after(i, pcx);
        if pcx.gmethods[at].ty != TPL_PATTERN || pcx.gmethods[at].name != name {
            continue;
        }
        let f = pcx.gmethods[at].f;
        if via >= 0 {
            let im = crate::front::traits::impl_of_fn(f, pcx);
            if im < 0 || pcx.traits_impls[im].tr != via {
                continue;
            }
        }
        if crate::front::traits::fn_pattern_bindings(f, t, &pcx) >= 0 {
            return f;
        }
    }
    -1
}

// (0.27.2) Of the methods `name` of type t (its own, or its template's:
// tpl, 0 for none), the one a call `x.m()` of the rust edition
// means, f0 being method_of's: an inherent one first; of the traits'
// (none inherent), the one of trait `via` for `Tr::m(x)` (F8.2), else the
// only one, and more than one is error method.ambiguous (rustc E0034),
// with a qualified call per candidate. RULE: F9.1, F9.3
fn trait_method_choice(n: i64, t: i64, tpl: i64, name: i64, f0: i64, via: i64,
    pcx: inout Ctx<Comp>) -> i64 {
    if via < 0 && crate::front::traits::impl_of_fn(f0, pcx) < 0 {
        return f0;
    }
    // (the candidates, in TSCRATCH from mark)
    let mark = pcx.tscratch.count;
    let own = find_method(t, name, pcx) >= 0;
    if own {
        for i in 0..pcx.methods.len() as i64 {
            if pcx.methods[i].ty == t && pcx.methods[i].name == name {
                pcx.tscratch.push(pcx.methods[i].f);
            }
        }
    } else if tpl != 0 {
        var i = gm_start(tpl, name, pcx);
        while i >= 0 {
            if pcx.gmethods[i].ty == tpl && pcx.gmethods[i].name == name {
                pcx.tscratch.push(pcx.gmethods[i].f);
            }
            i = gm_after(i, pcx);
        }
    }
    var found = -1;
    var count = 0;
    for k in mark..pcx.tscratch.count {
        let f = pcx.tscratch.get(k);
        let imp = crate::front::traits::impl_of_fn(f, pcx);
        if imp < 0 || via >= 0 && pcx.traits_impls[imp].tr != via {
            continue;
        }
        count += 1;
        if found < 0 {
            found = f;
        }
    }
    // RULE: D22.3, F9.3 (0.27.2: `x.m()` with x of a bounded parameter`s
    // type, in an instance: the method of the bound that declares it, as
    // the generic body read it, `msg.fmt(f)` with `M: Display`)
    if count > 1 && via < 0 {
        // (through the derefs the probe made: `value.fmt(f)` with `value:
        // &T`, T = `&i32`, reads `*value`)
        var recv = pcx.nodes[n].a;
        while pcx.nodes[recv].kind == NodeKind::Unary && pcx.nodes[recv].op == Tok::Star {
            recv = pcx.nodes[recv].b;
        }
        if pcx.nodes[recv].kind == NodeKind::Ident && pcx.nodes[recv].res == Res::Local
            && pcx.nodes[recv].y >= 0 && pcx.locals[pcx.nodes[recv].y].tparam != 0 {
            let p = pcx.locals[pcx.nodes[recv].y].tparam;
            let bounds = pcx.nodes[p].h;
            var chosen = -1;
            var hits = 0;
            for k in mark..pcx.tscratch.count {
                let f = pcx.tscratch.get(k);
                let imp = crate::front::traits::impl_of_fn(f, pcx);
                if imp >= 0 && bounds != 0 && (0..pcx.nodes[bounds].count).any(|b|
                    crate::front::traits::bound_trait(child(bounds, b, pcx), &pcx)
                    == pcx.traits_impls[imp].tr) {
                    chosen = f;
                    hits += 1;
                }
            }
            if hits == 1 {
                pcx.tscratch.count = mark;
                return chosen;
            }
        }
    }
    // RULE: F9.2 (0.27.2.1: of the traits' candidates only those of a trait
    // in scope count, `self.v.fmt(f)` with only Binary imported)
    if count > 1 && via < 0 && pcx.edition != 0 {
        var chosen = -1;
        var hits = 0;
        for k in mark..pcx.tscratch.count {
            let f = pcx.tscratch.get(k);
            let imp = crate::front::traits::impl_of_fn(f, pcx);
            if imp >= 0 && trait_in_scope(pcx.traits_impls[imp].tr, &pcx) {
                chosen = f;
                hits += 1;
            }
        }
        if hits == 1 {
            pcx.tscratch.count = mark;
            return chosen;
        }
    }
    if count > 1 && via < 0 {
        let saved_kind = pcx.err_kind;
        pcx.err_kind = c"method.ambiguous";
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"multiple applicable items: '", pcx);
        err_sym(name, pcx);
        err_str(c"' is a method of more than one trait for '", pcx);
        err_type(t, pcx);
        err_str(c"'", pcx);
        err_help(c"call it through its trait to say which", pcx);
        let recv = pcx.nodes[n].a;
        for k in mark..pcx.tscratch.count {
            let imp = crate::front::traits::impl_of_fn(pcx.tscratch.get(k), pcx);
            if imp >= 0 {
                let rest = if pcx.nodes[n].count > 0 { ", .." } else { "" };
                err_try_fmt(format_args("{}::{}(&{}{})",
                    sym_text(pcx.traits[pcx.traits_impls[imp].tr].name, pcx), sym_text(name, pcx),
                    SRC[pcx.nodes[recv].start..pcx.nodes[recv].end], rest), pcx);
            }
        }
        err_end_soft(&pcx);
        pcx.err_kind = saved_kind;
    }
    pcx.tscratch.count = mark;
    if found >= 0 { found } else { f0 }
}

// RULE: F9.2 Whether trait tr is in scope in the module being checked:
// declared there, or its name there names it (a `use`, a glob, the
// edition's prelude).
fn trait_in_scope(tr: i64, pcx: inout Ctx<Comp>) -> bool {
    let m = pcx.cur_mod;
    if pcx.traits[tr].module == m {
        return true;
    }
    let b = crate::front::modules::lookup::lookup_quiet(m, pcx.traits[tr].name, m, &pcx);
    if crate::front::modules::lookup::binding_kind(b) != crate::front::modules::lookup::B_ITEM {
        return false;
    }
    let key = crate::front::modules::lookup::binding_value(b);
    // UNSAFE: sym_trait is a raw table indexed by item key (sym_table)
    // SAFETY: key is an item's key from lookup_quiet, so within the table,
    // which has a slot for every key
    key >= 0 && unsafe { pcx.sym_trait[key] } - 1 == tr
}

// (0.27.2) The template whose method templates are t's, in method_of's
// order, or 0 for none.
fn method_template(t: i64, pcx: Ctx<Comp>) -> i64 {
    let kind = pcx.types[t].kind;
    if kind == TyKind::Struct {
        return pcx.structs[pcx.types[t].a].tmpl;
    }
    if kind == TyKind::Enum {
        // UNSAFE: ENUMS is the checker's global enum table, read as method_of reads it.
        // SAFETY: t is an enum type, so its a is an index of ENUMS.
        let tmpl = unsafe { ENUMS[pcx.types[t].a].tmpl };
        return -tmpl;
    }
    if kind == TyKind::Distinct && pcx.types[t].count > 0 {
        return TPL_DISTINCT + pcx.types[t].b;
    }
    // RULE: Z9.1c (0.27.4: `[T]` the place is the slice template too)
    if kind == TyKind::Unsized
        && pcx.types[pcx.types[t].a].kind == TyKind::Slice {
        return TPL_SLICE;
    }
    if kind == TyKind::Slice { TPL_SLICE } else { 0 }
}

// Offers near the names of type t's methods (with `self`; with
// associated functions too unless methods_only), of its impl blocks and of
// its template's (0.14: an unknown method's `did you mean`).
pub fn offer_methods(near: inout Near, t: i64, methods_only: bool, pcx: inout Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.methods.len() as i64 {
            if pcx.methods[i].ty == t && (!methods_only || is_method(pcx.methods[i].f, pcx)) {
                near.offer(pcx.methods[i].name, &pcx);
            }
        }
        let kind = pcx.types[t].kind;
        var tpl = 0;
        if kind == TyKind::Struct && pcx.structs[pcx.types[t].a].tmpl != 0 {
            tpl = pcx.structs[pcx.types[t].a].tmpl;
        } else if kind == TyKind::Enum && ENUMS[pcx.types[t].a].tmpl != 0 {
            tpl = -ENUMS[pcx.types[t].a].tmpl;
        }
        if tpl != 0 {
            offer_template_methods(&near, tpl, methods_only, &pcx);
        }
    }
}

// The same for the methods of template tpl (as find_generic_method).
pub fn offer_template_methods(near: inout Near, tpl: i64, methods_only: bool, pcx: inout Ctx<Comp>) {
    for i in 0..pcx.gmethods.len() as i64 {
        if pcx.gmethods[i].ty == tpl && (!methods_only || is_method(pcx.gmethods[i].f, pcx)) {
            near.offer(pcx.gmethods[i].name, &pcx);
        }
    }
}

// The help of an unknown method a Rust programmer calls on a slice, an
// array or a Vec (0.14): what vole writes instead.
fn rust_method_help(t: i64, name: i64, pcx: inout Ctx<Comp>) {
    let text = sym_text(name, pcx);
    let kind = pcx.types[t].kind;
    let seq = kind == TyKind::Slice || kind == TyKind::Array;
    // (0.20) a method of `str` on bytes
    if kind == TyKind::Slice && pcx.types[t].a == TY_U8 && pcx.str_type > 0
        && method_of(pcx.str_type, name, pcx) >= 0 {
        err_help(c"`[u8]` is bytes; text is `str` (UTF-8), which has it: a literal is a `str` where one goes (`let s: str = \"..\";`, `fn f(s: str)`); bytes become one by `str::from_utf8(b)?`", pcx);
        return;
    }
    // (0.14 has `iter`: only the names it lacks)
    let iter = text == "into_iter" || text == "chars" || text == "bytes";
    if seq && text == "len" {
        err_help(if kind == TyKind::Slice { c"`len` is a field of slices: `s.len`" }
            else { c"an array's length is its slice's field: `a[..].len`" }, pcx);
    } else if (seq || is_std_vec(t, &pcx)) && text == "iter_mut" {
        err_help(c"no `iter_mut`: change elements by index, `s[i] = x` (a Vec: `v.set(i, x)`)",
            pcx);
    } else if seq && iter {
        err_help(c"`s.iter()`, or `for x in s`, goes over a slice's elements (a [u8]'s bytes)",
            pcx);
    } else if seq && (text == "to_string" || text == "to_owned" || text == "to_vec"
        || text == "clone" || text == "as_str" || text == "as_bytes") {
        err_help(
            c"a string is a `[u8]` already; to copy it, push it into a `std::Buf` (`b.push_str(s)`)", pcx);
    } else if text == "is_empty" && (seq || is_std_vec(t, &pcx) || is_std_named(t, c"Buf", pcx)) {
        err_help(if kind == TyKind::Slice { c"no `is_empty`: `s.len == 0`" }
            else { c"no `is_empty`: `x.len() == 0`" }, pcx);
    } else if iter && is_std_vec(t, &pcx) {
        err_help(c"`v.iter()`, or `for x in v`, goes over a Vec's elements", pcx);
    } else if is_std_named(t, c"Interp", pcx) {
        // (0.25.2.1: `f"..".as_slice()`)
        err_help(c"a format_args value prints, with no methods: format it, 'format_in(\"...\", gpa)', a Buf ('.as_slice()' views it, '.free()' frees it)", pcx);
    } else if is_float(t) && is_math_name(text) {
        // (0.25.2.1: a float method of Rust's that std's Float lacks)
        err_help_fmt(
            format_args("'{text}' is not one of std's float methods (`volec query items std::math` lists them; `x.powf(y)` is a power): write it from those, e.g. sinh from exp"), pcx);
    }
}

// (0.25.2.1) Whether `name` is a float method of Rust's (`sqrt`, `sin`,
// `powf`, ...): std math's names.
fn is_math_name(name: [u8]) -> bool {
    name == "sqrt" || name == "cbrt" || name == "sin" || name == "cos" || name == "tan"
        || name == "asin" || name == "acos" || name == "atan" || name == "atan2"
        || name == "sinh" || name == "cosh" || name == "tanh" || name == "sin_cos"
        || name == "exp" || name == "exp2" || name == "ln" || name == "log" || name == "log2"
        || name == "log10" || name == "powi" || name == "powf" || name == "pow"
        || name == "floor" || name == "ceil" || name == "round" || name == "trunc"
        || name == "fract" || name == "abs" || name == "signum" || name == "hypot"
        || name == "mul_add" || name == "recip" || name == "to_radians" || name == "to_degrees"
        || name == "min" || name == "max" || name == "clamp"
}

// (0.17) The help of an unknown method that is a function of std
// (`s.trim()`: `std::trim(s)`; Rust's names for a few: `parse`,
// `is_ascii_digit`, `sort_unstable`): the call to write, as the try: line
// (with `gpa` for an allocating `_in` form).
fn std_function_help(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let text = sym_text(name, pcx);
        let mapped: [u8] = if text == "parse" { "parse_int" }
            else if text == "is_ascii_digit" { "is_digit" }
            else if text == "is_ascii_whitespace" || text == "is_whitespace" { "is_space" }
            else if text == "sort_unstable" { "sort" }
            else if text == "sort_unstable_by" { "sort_by" }
            else if text == "split_ascii_whitespace" { "split_whitespace" }
            else { text };
        var f = intern(mapped, &pcx);
        let with_in = buf_new();
        buf_bytes(with_in, mapped);
        buf_str(with_in, c"_in");
        let fin = intern(buf_slice(with_in), &pcx);
        let gpa = std_has(fin, true, &pcx);
        if gpa {
            f = fin;
        } else if !std_has(f, true, &pcx) {
            return;
        }
        if BUFS[pcx.err_help].len == 0 {
            err_help_fmt(
                format_args("'{text}' is no method: std's function `{}` takes the value as its first argument", sym_text(f, pcx)), pcx);
        }
        let recv = pcx.nodes[n].a;
        if recv == 0 || pcx.nodes[recv].end <= pcx.nodes[recv].start {
            return;
        }
        let c = buf_new();
        // (0.17: a name of the prelude needs no `std::`)
        if !is_prelude_name(f, &pcx) {
            buf_str(c, c"std::");
        }
        buf_fmt(c, format_args("{}(", sym_text(f, pcx)));
        buf_bytes(c, SRC[pcx.nodes[recv].start..pcx.nodes[recv].end]);
        if is_std_vec(t, &pcx) {
            buf_str(c, c".as_slice()");
        }
        for i in 0..pcx.nodes[n].count {
            let a = child(n, i, pcx);
            buf_str(c, c", ");
            buf_bytes(c, SRC[pcx.nodes[a].start..pcx.nodes[a].end]);
        }
        if gpa {
            buf_str(c, c", gpa");
        }
        buf_byte(c, ')');
        err_try_fmt(buf_slice(c), pcx);
        // (0.18) the fix, when the allocator it passes is this function's
        if !gpa || has_local_gpa(&pcx) {
            err_fix(pcx.nodes[n].start, pcx.nodes[n].end, buf_slice(c), &pcx);
        }
    }
}

// (0.17) The try: line that lists the methods of type t (a struct's or an
// enum's, std's or the program's): `volec query items TYPE ROOT`.
fn type_items_try(t: i64, pcx: Ctx<Comp>) {
    let kind = pcx.types[t].kind;
    if kind != TyKind::Struct && kind != TyKind::Enum {
        return;
    }
    let b = buf_new();
    buf_type(b, t, pcx);
    let s = buf_slice(b);
    var e = 0;
    while e < s.len as i64 && s[e] != '<' {
        e += 1;
    }
    let a = buf_new();
    buf_str(a, c"query items ");
    buf_bytes(a, s[0..e]);
    err_try_tool(buf_slice(a), true, pcx);
}

// Whether t is a `Vec<T>` (std's), or a pointer to one.
pub fn is_std_vec(t: i64, pcx: inout Ctx<Comp>) -> bool {
    var s = t;
    if pcx.types[s].kind == TyKind::Ptr {
        s = pcx.types[s].a;
    }
    pcx.types[s].kind == TyKind::Struct && pcx.structs[pcx.types[s].a].tmpl != 0
        && crate::front::generics::template_text(pcx.structs[pcx.types[s].a].tmpl, &pcx)
        == "Vec"
}

// `T::m` where type t has no `m` (0.17: when nothing is near, the nearest
// of its variants and functions, and the command that lists them).
fn path_member_error(n: i64, t: i64, member: i64, pcx: inout Ctx<Comp>) -> ! {
    unsafe {
        err_begin(pcx.nodes[n].start, &pcx);
        if pcx.types[t].kind == TyKind::Enum {
            err_str(c"no variant or associated function '", pcx);
        } else {
            err_str(c"no associated function '", pcx);
        }
        err_sym(member, pcx);
        err_failed_name(member, pcx);
        err_str(c"' in '", pcx);
        err_type(t, pcx);
        err_str(c"'", pcx);
        pcx.near_all.count = 0;
        pcx.near_collect = true;
        var near = near_to(member);
        if pcx.types[t].kind == TyKind::Enum {
            let e = pcx.types[t].a;
            for i in 0..ENUMS[e].variant_count {
                near.offer(pcx.variants[enum_variant(e, i)].name, &pcx);
            }
        }
        offer_methods(&near, t, false, &pcx);
        pcx.near_collect = false;
        // (0.15: `i64::MAX()`, a constant)
        int_limit_help(t, member, &pcx);
        // (0.25.2.1: `Gpa::default()`, `Gpa::new()`: where one comes from)
        if crate::front::check::is_std_named(t, c"Gpa", pcx) {
            let cur = pcx.cur_fn;
            crate::front::ambient::gpa_param_help(if cur >= 0 { pcx.fns[cur].node } else { -1 },
                if cur >= 0 { sym_text(pcx.fns[cur].display, pcx) } else { "" }, pcx);
        }
        near.help(&pcx);
        if BUFS[pcx.err_help].len == 0 && pcx.near_all.count > 0 {
            help_nearest(if pcx.types[t].kind
                == TyKind::Enum { c"its nearest variants and functions: " }
                else { c"its nearest functions: " }, member, pcx);
        }
        type_items_try(t, pcx);
        err_end(&pcx)
    }
}

// Whether function f is a method: its first parameter is named `self`.
fn is_method(f: i64, pcx: Ctx<Comp>) -> bool {
    let item = pcx.fns[f].node;
    pcx.nodes[item].count > 0 && pcx.nodes[child(item, 0, pcx)].a == pcx.self_sym
}

// (0.17) Method call n (of method f0 on type t) when it is std's
// `Buf::push_str(f"...")` outside std: Buf::push_fmt, which n then calls
// (an f-string is no `[u8]`; push_fmt writes it into the Buf without
// making the text apart); else -1.
fn push_str_interp(n: i64, f0: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    if f0 < 0 || pcx.std_module < 0 || !within_std(pcx.fns[f0].module, pcx)
        || within_std(pcx.cur_mod, pcx) || pcx.nodes[n].count != 1
        || pcx.nodes[child(n, 0, pcx)].kind != NodeKind::Interp
        || sym_text(pcx.nodes[pcx.fns[f0].node].a, pcx) != "push_str" {
        return -1;
    }
    let push_fmt = intern_c(c"push_fmt", &pcx);
    let f = method_of(t, push_fmt, pcx);
    if f >= 0 {
        pcx.nodes[n].b = push_fmt;
    }
    f
}

// A new node for the checker: `op operand` (`&` or `*`) of type `ty`.
pub fn synthetic_unary(op: Tok, operand: i64, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    let u = new_node(Unary, pcx.nodes[operand].start, pcx.nodes[operand].end, &pcx);
    pcx.nodes[u].op = op;
    pcx.nodes[u].b = operand;
    pcx.nodes[u].ty = ty;
    // (0.17: the own pass's record, front/own/fast.vl)
    crate::front::own::fast::note_synthetic(u, &pcx);
    u
}

// (0.16) A new node for the checker: `place[..]`, the whole of an array
// place as a slice of type `ty`, as `a[..]` is checked.
pub fn whole_slice(place: i64, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    let r = new_node(Range, pcx.nodes[place].start, pcx.nodes[place].end, &pcx);
    pcx.nodes[r].ty = TY_UNIT;
    let s = new_node(Index, pcx.nodes[place].start, pcx.nodes[place].end, &pcx);
    pcx.nodes[s].a = place;
    pcx.nodes[s].b = r;
    pcx.nodes[s].ty = ty;
    s
}

// RULE: F0.1, F6.3 (0.27.2) A `&mut self` method of a view (`impl str`'s
// `make_ascii_uppercase`) called on a shared one, a `&str`: a write
// through a shared reference, own.readonly (rustc E0596, "cannot borrow
// `*s` as mutable, as it is behind a `&` reference").
fn mut_view_receiver_error(n: i64, name: i64, t: i64, pcx: inout Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"own.readonly";
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"method '", pcx);
    err_sym(name, pcx);
    err_str(c"' takes '&mut self', but the receiver is a shared '", pcx);
    err_type(t, pcx);
    err_str(c"': it is read-only", pcx);
    err_help(c"take the receiver as `&mut`, from a place declared `let mut`", pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// RULE: F0.5, F22.1 (0.27.2) The method `name` of a pattern impl whose self
// type is written `&mut [T]` (`impl<'a, T> IntoIterator for &'a mut [T]`)
// for `&mut [T]` receiver type t, or -1 (a blanket impl's does not count).
fn mut_slice_impl_method(t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    let f = pattern_method_of(t, name, &pcx);
    let im = if f >= 0 { crate::front::traits::impl_of_fn(f, pcx) } else { -1 };
    if im < 0 {
        return -1;
    }
    let h = pcx.nodes[pcx.traits_impls[im].node].b;
    if h > 0 && pcx.nodes[h].kind == NodeKind::TySlice
        && (pcx.nodes[h].p & crate::front::ast::NODE_REF_MUT) != 0 { f } else { -1 }
}

// RULE: F6.2 (0.27.4) Whether method f takes `&self` or `&mut self` (read
// from its nodes, as a template's own signature is not resolved).
fn node_ref_self(f: i64, pcx: Ctx<Comp>) -> bool {
    if f < 0 {
        return false;
    }
    let item = pcx.fns[f].node;
    if item <= 0 || pcx.nodes[item].count == 0 {
        return false;
    }
    let p0 = child(item, 0, pcx);
    let tn = pcx.nodes[p0].b;
    pcx.nodes[p0].a == pcx.self_sym && tn > 0 && pcx.nodes[tn].kind == NodeKind::TyPtr
        && (pcx.nodes[tn].p & crate::front::ast::NODE_REF) != 0
}

// (0.27.4) Whether method f takes `&mut self`, from its nodes.
fn node_mut_self(f: i64, pcx: Ctx<Comp>) -> bool {
    node_ref_self(f, pcx)
        && (pcx.nodes[pcx.nodes[child(pcx.fns[f].node, 0, pcx)].b].p & NODE_REF_MUT) != 0
}

// (0.27.4) Whether function f takes a `self` (in any form), from its nodes.
fn node_has_self(f: i64, pcx: Ctx<Comp>) -> bool {
    if f < 0 {
        return false;
    }
    let item = pcx.fns[f].node;
    item > 0 && pcx.nodes[item].count > 0 && pcx.nodes[child(item, 0, pcx)].a == pcx.self_sym
}

// RULE: F6.2 (0.27.4) Whether f is a `&self` (`&mut self`) method of an impl
// for a reference type, `impl<A: Ord> Ord for &A`: its receiver is `&&A`,
// at the probe's `&` step of a `&A` (read from its nodes: a template's
// signature is its instances').
fn ref_self_of_ref_impl(f: i64, pcx: Ctx<Comp>) -> bool {
    let im = if f >= 0 { crate::front::traits::impl_of_fn(f, pcx) } else { -1 };
    if im < 0 {
        return false;
    }
    let head = pcx.nodes[pcx.traits_impls[im].node].b;
    let item = pcx.fns[f].node;
    if pcx.nodes[head].kind != NodeKind::TyPtr || pcx.nodes[item].count == 0 {
        return false;
    }
    let p0 = child(item, 0, pcx);
    let tn = pcx.nodes[p0].b;
    pcx.nodes[p0].a == pcx.self_sym && tn > 0 && pcx.nodes[tn].kind == NodeKind::TyPtr
        && (pcx.nodes[tn].p & crate::front::ast::NODE_REF) != 0
}

// `x.m(args)`: a call of method m of x's type (or of the type x points
// to), with `&x` or `*x` as needed for its `self`; becomes an NodeKind::Call.
pub fn synth_method(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var receiver = pcx.nodes[n].a;
        let name = pcx.nodes[n].b;
        // RULE: F8.2 (`Tr::m(x)`: the method of trait Tr, read before the
        // receiver, which may be another such call)
        let via = if pcx.via_node == n { pcx.via_trait } else { -1 };
        // RULE: F18.1 (0.27.2: the expected type of the call, which the
        // receiver's own checking overwrites, `(1..4).sum()` in a `let s:
        // i64`: back for instantiate_call)
        let hint = crate::front::generics::hint_for(n, pcx);
        // RULE: F26.3 (0.27.3: `s[1..].make_ascii_uppercase()`, a `&mut self`
        // method of str called on an index: the index is a place written,
        // through IndexMut, as rustc's mutable autoref makes it)
        let outer_place = pcx.mut_place;
        if pcx.nodes[receiver].kind == NodeKind::Index && pcx.str_type > 0
            && crate::front::known::on_std2(pcx) && crate::front::check::rust::rust_node(n, &pcx) {
            let sm = method_of(pcx.str_type, name, pcx);
            if sm >= 0 && pcx.fns[sm].param_count > 0 && is_mut_slice(fn_param(sm, 0, pcx), pcx) {
                pcx.mut_place = receiver;
            }
        }
        var receiver_ty = synth_expr(receiver, &pcx);
        pcx.mut_place = outer_place;
        // RULE: D21.3 (an `impl Tr` result's methods: its bounds', its hidden
        // type's)
        receiver_ty = crate::front::opaque::reveal_receiver(n, receiver, receiver_ty, name, &pcx);
        if hint != 0 && crate::front::check::rust::rust_node(n, &pcx) {
            pcx.hint_node = n;
            pcx.hint_ty = hint;
        }
        // RULE: F0.5 (0.27.2: a receiver whose type is the error type has
        // no candidates: the probe would offer any trait's method, an
        // iterator adapter's `len`; its arguments are checked)
        if receiver_ty == pcx.ty_error && pcx.ty_error != 0
            && crate::front::check::rust::rust_node(n, &pcx) {
            for i in 0..pcx.nodes[n].count {
                synth_expr(child(n, i, pcx), &pcx);
            }
            return pcx.ty_error;
        }
        // (0.20) a string literal has `str`'s methods, as Rust's `&str`:
        // `"a,b".split(',')`, `" 7 ".trim()`; and the ones std has only as
        // `_in` (0.26.3: `"a".to_uppercase()` is alloc.no_in, as on a `str`)
        if pcx.nodes[receiver].kind == NodeKind::Str && pcx.str_type > 0
            && (method_of(pcx.str_type, name, pcx) >= 0
                || method_of(pcx.str_type, crate::front::check::alloc_rules::in_name(name, &pcx),
                    pcx)
                >= 0)
            && pcx.nodes[receiver].b == 0
            && is_utf8_text(crate::front::lexer::str_at(pcx.nodes[receiver].a)) {
            receiver_ty = pcx.str_type;
            pcx.nodes[receiver].ty = pcx.str_type;
        }
        // RULE: F6.2 (the receiver's type as written: the probe's steps
        // start from it)
        let probe_ty = receiver_ty;
        // (0.18.1) `tr.cell(i)` of a `tr: &&Table`, `s.len()` of an `s:
        // &[u8]`: read through to the reference (the slice) that has the
        // methods, as Rust does
        while is_ref(receiver_ty, pcx) && (is_ref(pcx.types[receiver_ty].a, pcx)
            || pcx.types[pcx.types[receiver_ty].a].kind == TyKind::Slice) {
            receiver_ty = pcx.types[receiver_ty].a;
            receiver = synthetic_unary(Tok::Star, receiver, receiver_ty, &pcx);
            pcx.nodes[n].a = receiver;
        }
        // (0.17: a `&mut [T]` has `[T]`'s methods)
        var recv_mut = is_mut_slice(receiver_ty, pcx);
        // RULE: F0.5, F22.1 (0.27.2: a `&mut [T]` receiver has `impl .. for
        // &'a mut [T]`'s methods first, `for x in s`'s IterMut, before
        // `&[T]`'s)
        let own_mut = recv_mut && crate::front::check::rust::rust_node(n, &pcx)
            && pcx.types[receiver_ty].kind == TyKind::Slice
            && mut_slice_impl_method(receiver_ty, name, &pcx) >= 0;
        if recv_mut && !own_mut {
            receiver_ty = decay_ref(receiver_ty, &pcx);
        }
        // (0.16: an array place has its slice's methods: `a.iter()` is
        // `a[..].iter()`)
        // RULE: F6.2 (0.27.3: the rust edition's by-value step on the array
        // first, `a.into_iter()` the array's IntoIterator, std::array's
        // IntoIter, before the unsizing step to its slice)
        if pcx.types[receiver_ty].kind == TyKind::Array && method_of(receiver_ty, name, pcx) < 0
            && is_place(receiver, pcx)
            && !(crate::front::check::rust::rust_node(n, &pcx)
                && pattern_method_via(receiver_ty, name, -1, &pcx) >= 0) {
            let s = slice_of(pcx.types[receiver_ty].a, &pcx);
            if method_of(s, name, pcx) >= 0 {
                receiver = whole_slice(receiver, s, &pcx);
                pcx.nodes[n].a = receiver;
                receiver_ty = s;
            }
        }
        if pcx.nodes[n].count == 0 && pcx.nodes[n].g == 0 && sym_is_c(name, c"len", &pcx)
            && (pcx.types[receiver_ty].kind == TyKind::Slice
                || pcx.types[receiver_ty].kind == TyKind::Array && is_plain_place(receiver, pcx))
            && method_of(receiver_ty, name, pcx) < 0 {
            return len_method(n, receiver, receiver_ty, &pcx);
        }
        if is_vector(receiver_ty, pcx) {
            return vector_method(n, name, receiver_ty, &pcx);
        }
        // (0.18: `p.is_null()` of a raw pointer)
        if is_pointer(receiver_ty, pcx) && pcx.nodes[n].count == 0
            && sym_is_c(name, c"is_null", &pcx)
            && method_of(pcx.types[receiver_ty].a, name, pcx) < 0 {
            return null_test(n, &pcx);
        }
        var t = receiver_ty;
        var through_pointer = false;
        if is_pointer(t, pcx)
            && (pcx.types[pcx.types[t].a].kind == TyKind::Struct
                || pcx.types[pcx.types[t].a].kind == TyKind::Enum
                || (method_of(t, name, pcx) < 0 && (method_of(pcx.types[t].a, name, pcx) >= 0
                    || has_intrinsic_method(pcx.types[t].a, name, &pcx)
                    // RULE: F6.2 (0.27.2: `r.eq(&x)` with `r: &i32`: the
                    // pointee's impl, a primitive's or a pattern impl's)
                    || crate::front::check::rust::rust_node(n, &pcx)
                    && (pattern_method_of(pcx.types[t].a, name, &pcx) >= 0
                        || crate::front::convert::has_generic_trait_fn(pcx.types[t].a, name,
                            &pcx))))) {
            t = pcx.types[t].a;
            through_pointer = true;
        }
        // (0.9: a value of a bounded parameter's type has its bounds' methods)
        // (0.17: not a drop's glue, `x.drop()` of an instance whose T has
        // `impl Drop`, front/own/glue.vl)
        if pcx.nodes[receiver].kind == Ident && pcx.nodes[receiver].res == Res::Local
            && pcx.nodes[receiver].y >= 0
            && pcx.locals[pcx.nodes[receiver].y].tparam != 0
            && !(name == intern_c(c"drop", &pcx) && has_drop_impl(t, &pcx))
            // RULE: Z9.1c (0.27.4: `x: &T` with T the unsized place is a
            // view, not a T: its methods are the place's, size_of_val's `len`)
            && !(crate::front::types::find_place_of_view(t, pcx) > 0) {
            require_in_bounds(pcx.locals[pcx.nodes[receiver].y].tparam, name, pcx.nodes[n].start,
                &pcx);
        }
        var f0 = if own_mut { mut_slice_impl_method(t, name, &pcx) }
            else { method_of(t, name, pcx) };
        // RULE: Z9.1c, F6.2 (0.27.4: on a view its place's `&self` method,
        // receiver the view itself, comes at the by-value step, before the
        // view's own `&self` one at the `&` step; through a type parameter
        // the bound's, the view's own)
        let tparam_receiver = pcx.nodes[receiver].kind == Ident
            && pcx.nodes[receiver].res == Res::Local && pcx.nodes[receiver].y >= 0
            && pcx.locals[pcx.nodes[receiver].y].tparam != 0;
        var placed = false;
        // (not through a reference, `(&s).tell()`: `&&str` by value first)
        let ref_receiver = pcx.types[receiver_ty].kind == TyKind::Ptr
            && (pcx.types[receiver_ty].b == REF_SHARED || pcx.types[receiver_ty].b == REF_MUT);
        if f0 >= 0 && !own_mut && !tparam_receiver && !ref_receiver
            && crate::front::check::rust::rust_node(n, &pcx) {
            let place = crate::front::types::find_place_of_view(t, pcx);
            let g = if place > 0 { find_method(place, name, pcx) } else { -1 };
            // (a `&self` method only: a by-value one of the place, a default
            // `max(self, ..)`, takes no view)
            if g >= 0 && node_ref_self(g, pcx) {
                // (of the trait `Tr::m(x)` names, F8.2)
                f0 = trait_method_choice(n, place, method_template(place, pcx), name, g, via, &pcx);
                placed = true;
            }
        }
        if f0 >= 0 && !own_mut && !placed && crate::front::check::rust::rust_node(n, &pcx) {
            f0 = trait_method_choice(n, t, method_template(t, pcx), name, f0, via, &pcx);
        }
        // RULE: Z9.1c, F8.2 (0.27.4: `Tr::m(x)` of a view whose own impls
        // lack Tr's m: the place's method of another trait is not it; the
        // pattern impls below are searched, `impl<T: Debug> Debug for &T`)
        if f0 >= 0 && via >= 0 && !placed
            && crate::front::traits::impl_of_fn(f0, pcx) >= 0
            && pcx.traits_impls[crate::front::traits::impl_of_fn(f0, pcx)].tr != via {
            f0 = -1;
        }
        // RULE: F0.5 (0.27.2: a pattern impl's method, first for the
        // receiver's own type by value, `impl<'a, T> IntoIterator for &'a
        // Vec<T, A>`, then for the type it points to)
        if crate::front::check::rust::rust_node(n, &pcx) {
            var pf = pattern_method_via(receiver_ty, name, via, &pcx);
            if pf < 0 && receiver_ty != t {
                // (`impl<'a> Tr for &'a S`: a concrete impl for a reference)
                pf = method_of(receiver_ty, name, pcx);
            }
            // RULE: F6.2 (of t's method and the reference type's, the one
            // rustc's probe finds first; the reference's when that says
            // nothing and t is behind it)
            let first = if pf >= 0 && f0 >= 0 && receiver_ty != t {
                crate::front::check::rust::probe_first(n, f0, t, pf, receiver_ty, probe_ty, name,
                    &pcx)
            } else {
                -1
            };
            // RULE: F6.2 (0.27.4: a `&self` method of a pattern impl for the
            // receiver's reference type, `impl<A: Ord> Ord for &A`, is at the
            // `&` step: one found at the by-value step, `<P as Ord>::cmp` of
            // a `&P`, comes first)
            let pf_ref_self = ref_self_of_ref_impl(pf, pcx);
            // (a receiver `&X`: the impl for `&A` matched against X, its `&self`
            // the receiver itself, is at the by-value step; the one matched
            // against `&X` at the `&` step: `Ord::cmp(*self, *other)` of `impl
            // Ord for &A` with A = &str is `<&str as Ord>::cmp`)
            var took_referent = false;
            // (`a.cmp(b)` of a `&String` the closure gives: String's `&self`
            // cmp at the by-value step, before `<&String as Ord>::cmp`)
            if pf_ref_self && f0 < 0 && is_pointer(receiver_ty, pcx)
                && pcx.types[receiver_ty].a > 0 {
                let pt = pcx.types[receiver_ty].a;
                let gm = method_of(pt, name, pcx);
                let g_trait_ok = gm >= 0
                    && (via < 0 || crate::front::traits::impl_of_fn(gm, pcx) >= 0
                        && pcx.traits_impls[crate::front::traits::impl_of_fn(gm, pcx)].tr == via);
                // (else the `&A` impl matched against the referent, its `&self`
                // the receiver itself: `<&str as Debug>::fmt` of a `&&str`)
                let g = if g_trait_ok && node_ref_self(gm, pcx) { gm } else {
                    let g2 = pattern_method_via(pt, name, via, &pcx);
                    if node_ref_self(g2, pcx) { g2 } else { -1 }
                };
                if g >= 0 {
                    f0 = g;
                    t = pt;
                    through_pointer = true;
                    took_referent = true;
                }
            }
            if pf_ref_self && through_pointer && receiver_ty != t && !took_referent {
                let pf2 = pattern_method_via(t, name, via, &pcx);
                if pf2 >= 0 && node_ref_self(pf2, pcx)
                    && !(f0 >= 0 && crate::front::traits::impl_of_fn(f0, pcx) < 0) {
                    f0 = pf2;
                    took_referent = true;
                }
            }
            // (`&self` of t, the receiver a reference to t, `let` bound or not)
            let f0_by_value = f0 >= 0 && node_ref_self(f0, pcx) && is_pointer(probe_ty, pcx)
                && pcx.types[probe_ty].a == t
                && node_mut_self(f0, pcx) == (pcx.types[probe_ty].b == REF_MUT);
            if pf >= 0 && !took_referent && !(pf_ref_self && f0_by_value)
                && (f0 < 0 || first == pf || first < 0 && through_pointer) {
                f0 = pf;
                t = receiver_ty;
                through_pointer = false;
            } else if f0 < 0 {
                f0 = pattern_method_via(t, name, via, &pcx);
            }
            // RULE: F6.2 (a by-value method of `&t` or `&mut t` before t's
            // own: the receiver autoref'd)
            if f0 >= 0 && !through_pointer && receiver_ty == t && via < 0
                && crate::front::check::rust::autoref_first(n, f0, t, probe_ty, name, &pcx) {
                return synth_expr(n, &pcx);
            }
        }
        // (0.20) a String has its `str`'s methods (Rust's Deref): `s.trim()`
        // is `s.as_str().trim()`; a PathBuf its Path's (`p.as_path()`)
        let string = pcx.types[t].kind == TyKind::Struct && is_std_named(t, c"String", pcx);
        let path_buf = pcx.types[t].kind == TyKind::Struct && is_std_named(t, c"PathBuf", pcx);
        if f0 < 0 && (string || path_buf) {
            let view = if string { pcx.str_type } else { pcx.path_type };
            if view > 0 && method_of(view, name, pcx) >= 0 {
                pcx.nodes[receiver].p |= NODE_CHECKED;
                let call = new_node(NodeKind::MethodCall, pcx.nodes[receiver].start,
                    pcx.nodes[receiver].end, &pcx);
                pcx.nodes[call].a = receiver;
                // RULE: F0.1, F6.2 (0.27.2: a `&mut self` method of str on a
                // String: its `as_mut_str`, DerefMut's)
                let vm = method_of(view, name, pcx);
                let as_mut = string && crate::front::check::rust::rust_node(n, &pcx)
                    && fn_param_count(vm, pcx) > 0 && is_mut_slice(fn_param(vm, 0, pcx), pcx)
                    && method_of(t, intern_c(c"as_mut_str", &pcx), pcx) >= 0;
                pcx.nodes[call].b = intern_c(if as_mut { c"as_mut_str" }
                    else if string { c"as_str" } else { c"as_path" }, &pcx);
                let mark = list_begin(pcx);
                list_end(call, mark, &pcx);
                pcx.nodes[n].a = call;
                receiver = call;
                receiver_ty = synth_expr(call, &pcx);
                if as_mut && is_mut_slice(receiver_ty, pcx) {
                    recv_mut = true;
                    receiver_ty = decay_ref(receiver_ty, &pcx);
                }
                t = receiver_ty;
                through_pointer = false;
                f0 = method_of(t, name, pcx);
            }
        }
        // (0.17) `b.push_str(f"..")`: Buf::push_fmt's, the f-string written
        // straight into the Buf
        let pf = push_str_interp(n, f0, t, &pcx);
        if pf >= 0 {
            f0 = pf;
        }
        var f = -1;
        if pcx.types[t].kind == TyKind::Struct || pcx.types[t].kind == TyKind::Enum || f0 >= 0 {
            f = f0;
        }
        // (0.15: `x.clone()`, `x.cmp(&y)`, `x.hash()` of a type that has
        // Clone, Ord or Hash without an impl: a copy, a float, a tuple...)
        if f < 0 {
            f = intrinsic_method(n, t, name, &pcx);
        }
        // RULE: F0.4 (0.27.3: on std2 a shared view's clone, `&str`'s, is its
        // copy: the call becomes the receiver's value)
        if f < 0 && pcx.nodes[n].count == 0 && sym_is_c(name, c"clone", &pcx)
            && crate::front::known::on_std2(pcx) && crate::front::check::rust::rust_node(n, &pcx)
            && crate::front::distinct::is_view_distinct(t, pcx)
            && !crate::front::opaque::is_opaque(t, pcx)
            && crate::places::regions::rust_copy(t, &pcx) {
            let v = if through_pointer { synthetic_unary(Tok::Star, receiver, t, &pcx) }
                else { receiver };
            crate::front::convert::become_value(n, v, t, &pcx);
            return t;
        }
        if f < 0 {
            // (0.15: `x.into()`, `x.from(..)`: a function of a generic trait's impl)
            let r = generic_trait_call(n, t, name, &pcx);
            if r >= 0 {
                return r;
            }
        }
        if f < 0 && crate::front::check::rust::rust_node(n, &pcx)
            && crate::front::check::rust::deref_receiver(n, t, name, &pcx) {
            // (0.27.0: a method of Deref's target, the rust edition's)
            return synth_expr(n, &pcx);
        }
        if f < 0 && crate::front::check::rust::rust_node(n, &pcx)
            && crate::front::check::rust::autoref_receiver(n, t, name, &pcx) {
            return synth_expr(n, &pcx);
        }
        if f < 0 {
            // (0.26.3: `s.to_string()`, `it.collect()`: their `_in` forms)
            if method_of(t, crate::front::check::alloc_rules::in_name(name, &pcx), pcx) >= 0 {
                crate::front::check::alloc_rules::no_in_error(n, name, sym_text(name, pcx), &pcx);
            }
            // (0.18: a method of a distinct type's underlying type)
            distinct_method_error(n, receiver, t, name, &pcx);
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"no method '", pcx);
            err_sym(name, pcx);
            err_failed_name(name, pcx);
            err_str(c"' on type '", pcx);
            err_type(receiver_ty, pcx);
            err_str(c"'", pcx);
            if pcx.types[t].kind == TyKind::Struct && find_field(pcx.types[t].a, name, pcx) >= 0 {
                err_help(c"to call a function stored in a field, write (s.f)(x)", pcx);
            }
            if pcx.types[t].kind == TyKind::Array
                && method_of(slice_of(pcx.types[t].a, &pcx), name, pcx) >= 0 {
                err_help(c"an array has its slice's methods where it is a place: bind it to a variable first", pcx);
            }
            rust_method_help(t, name, &pcx);
            std_function_help(n, t, name, &pcx);
            pcx.near_all.count = 0;
            pcx.near_collect = true;
            var near = near_to(name);
            offer_methods(&near, t, true, &pcx);
            pcx.near_collect = false;
            near.help(&pcx);
            if BUFS[pcx.err_help].len == 0 && pcx.near_all.count > 0 {
                help_nearest(c"no method of that name; the nearest: ", name, pcx);
            }
            type_items_try(t, pcx);
            err_end(&pcx);
        }
        // RULE: F8.2 (0.27.2: `Step::forward_checked(x, 1)`, a trait's
        // function with no `self`, called by the trait's path: x is its first
        // argument, and the impl is the one of its type, as a receiver's)
        if !is_method(f, pcx) && !(via >= 0 && pcx.fns[f].param_count > 0) {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"'", pcx);
            err_type(t, pcx);
            err_str(c"::", pcx);
            err_sym(name, pcx);
            err_str(c"' is an associated function, not a method (it has no 'self' parameter)", pcx);
            err_help(c"call it as '", pcx);
            buf_type(pcx.err_help, t, pcx);
            err_help(c"::", pcx);
            err_help_sym(name, pcx);
            err_help(c"(...)'", pcx);
            err_end(&pcx);
        }
        // (0.26.2: `b.push_fmt("{} {x}", a.b)`, `f.write("..", ..)`: a format
        // literal and its arguments made one Interp)
        // RULE: F10.2, F21.3 (a method's `where Self: Tr` must hold for the
        // receiver's type; a template's is checked with its instance)
        if pcx.fns[f].generic == 0 && crate::front::check::rust::rust_node(n, &pcx)
            && !crate::front::traits::where_preds_hold(pcx.fns[f].node, t, pcx.nodes[n].start,
                true, &pcx) {
            // (the method is not the type's: its body is not checked for it)
            return pcx.ty_error;
        }
        f = crate::front::check::format::format_call(n, f, true, &pcx);
        // (0.15: named arguments, defaults)
        normalize_args(n, f, 1, &pcx);
        // (0.17: `b.push_fmt(f"..")`: the f-string written in place, the
        // receiver as push_fmt's `self: *Buf<A>` takes it)
        let direct = direct_kind(n, f, true, pcx);
        if direct != 0 && pcx.nodes[n].g == 0 {
            if through_pointer && !is_borrow(receiver, pcx) {
                unsafe_through(n, receiver, U_METHOD,
                    c"calling a method through a raw pointer is unsafe", &pcx);
            }
            let arg = if through_pointer { receiver }
                else { synthetic_unary(Tok::Amp, receiver, ptr_to(t, &pcx), &pcx) };
            // (0.25) an `inout self` receiver needs the place mutable
            let st = fn_param(f, 0, pcx);
            if !through_pointer && pcx.types[st].kind == TyKind::Ptr && pcx.types[st].b == REF_MUT {
                // RULE: F20.6 (0.27.5: as below)
                if crate::front::check::rust::rust_node(n, &pcx) {
                    crate::front::check::rust::place_to_mut(receiver, &pcx);
                }
                crate::front::check::assign::check_inout_place(receiver, n, &pcx);
            }
            return direct_call(n, f, direct, arg, &pcx);
        }
        if pcx.fns[f].generic > 0 {
            // A method template: its impl's parameters from the receiver's
            // type, its own from the arguments.
            // (0.24: a closure given a borrowing iterator's copied items
            // borrows them, own::drops::ITEM_BORROW)
            let w = sym_text(name, pcx);
            let item_at = if !crate::front::own::byref::copies_owned_items(t, 0, &pcx) { -1 }
                else if w == "map" || w == "for_each" || w == "filter_map" { 0 }
                else if w == "fold" { 1 } else { -1 };
            if (w == "map" || w == "for_each" || w == "filter_map" || w == "fold")
                && crate::front::own::byref::copies_items(t, 0, true, &pcx) {
                // (0.26.1: items that are not Freeze, copies given to the
                // closure, are other cells)
                crate::front::cells::interior_items(n, t, &pcx);
            }
            pcx.item_borrow = item_at;
            f = instantiate_call(f, n, 1, t, pcx.nodes[n].g, &pcx);
            pcx.item_borrow = -1;
        } else if pcx.nodes[n].g != 0 {
            name_error(pcx.nodes[n].start, c"method '", name, c"' is not generic", &pcx);
        }
        let self_ty = fn_param(f, 0, pcx);
        var arg = receiver;
        // (0.18.1: a raw `self: *T` takes the pointer as it is: safe)
        if through_pointer && !is_borrow(receiver, pcx)
            && !(pcx.types[self_ty].kind == TyKind::Ptr && pcx.types[self_ty].b == 0) {
            unsafe_through(n, receiver, U_METHOD,
                c"calling a method through a raw pointer is unsafe", &pcx);
        }
        if self_ty == t {
            if through_pointer {
                arg = synthetic_unary(Tok::Star, receiver, t, &pcx);
            }
        } else if pcx.types[self_ty].kind == TyKind::Ptr && pcx.types[self_ty].a == t {
            // (`self: *T`, `self: &T`, `self: &mut T`)
            if !through_pointer {
                // RULE: F15.1 (0.27.2: the rust edition borrows a temporary
                // receiver, `5i64.hash(&mut h)`, `a.len().cmp(&b.len())`,
                // as `&5` borrows one)
                if !is_place(receiver, pcx) && !is_compound(t, pcx)
                    && !crate::front::check::rust::rust_node(n, &pcx) {
                    err_begin(pcx.nodes[n].start, &pcx);
                    err_str(c"method '", pcx);
                    err_sym(name, pcx);
                    err_str(c"' takes 'self: *", pcx);
                    err_type(t, pcx);
                    err_str(c"', but the receiver is a temporary value", pcx);
                    err_help(c"bind it to a variable first", pcx);
                    err_end(&pcx);
                }
                arg = synthetic_unary(Tok::Amp, receiver, self_ty, &pcx);
                // (0.25) an `inout self` receiver needs the place mutable
                if pcx.types[self_ty].b == REF_MUT {
                    // RULE: F20.6 (0.27.5: its indexes and derefs IndexMut's
                    // and DerefMut's)
                    if crate::front::check::rust::rust_node(n, &pcx) {
                        crate::front::check::rust::place_to_mut(receiver, &pcx);
                    }
                    crate::front::check::assign::check_inout_place(receiver, n, &pcx);
                    check_elem_receiver(receiver, n, &pcx);
                }
            }
        } else if pcx.types[self_ty].kind == TyKind::Slice && pcx.types[t].kind == TyKind::Slice
            && pcx.types[self_ty].a == pcx.types[t].a {
            // (0.17) `self: &mut [T]` on a slice, `self: [T]` on a `&mut
            // [T]`: a slice is its own view
            if pcx.types[self_ty].b == REF_MUT && pcx.types[t].b != REF_MUT {
                if pcx.nodes[receiver].kind == Index
                    && pcx.nodes[pcx.nodes[receiver].b].kind == Range
                    && pcx.nodes[pcx.nodes[receiver].a].ty > 0
                    && pcx.types[pcx.nodes[pcx.nodes[receiver].a].ty].kind == TyKind::Array {
                    // (0.25) an array's slicing, `a.sort()`, `a[1..].sort()`:
                    // an exclusive one, as `&a[..]` is
                    pcx.nodes[receiver].p |= NODE_REF_MUT;
                    pcx.nodes[receiver].ty = self_ty;
                }
                // (any other view: the own pass takes the call as a change
                // of what it views, `s.sort()` of `let s = v.as_slice()`;
                // threads::capture_write as a thread's write)
            }
        } else if is_mut_slice(self_ty, pcx) && decay_ref(self_ty, &pcx) == t {
            // RULE: F0.1, F6.3 (0.27.2: `&mut self` of `impl str` on a str:
            // the receiver must be a `&mut str`, a write through a `&str`
            // is refused, rustc E0596)
            if !recv_mut && !through_pointer && crate::front::check::rust::rust_node(n, &pcx) {
                mut_view_receiver_error(n, name, t, &pcx);
            }
        } else {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"method '", pcx);
            err_sym(name, pcx);
            err_str(c"' has 'self' of type '", pcx);
            err_type(self_ty, pcx);
            err_str(c"'; a method's receiver is 'self', 'inout self', 'sink self' or 'self: *",
                pcx);
            err_type(t, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        let count = pcx.nodes[n].count;
        if count + 1 != pcx.fns[f].param_count {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"method '", pcx);
            err_sym(name, pcx);
            err_str(c"' expects ", pcx);
            err_int(pcx.fns[f].param_count - 1, pcx);
            err_str(c" arguments, got ", pcx);
            err_int(count, pcx);
            arity_help(n, f, count, pcx.fns[f].param_count - 1, &pcx);
            err_end(&pcx);
        }
        let mark = list_begin(pcx);
        list_push(arg, &pcx);
        for i in 0..count {
            let a = child(n, i, pcx);
            check_call_arg(a, f, i + 1, &pcx);
            list_push(a, &pcx);
        }
        list_end(n, mark, &pcx);
        pcx.nodes[n].kind = Call;
        pcx.nodes[n].a = 0;
        pcx.nodes[n].x = f + 1;
        ensure_checked(f, n, &pcx);
        check_call_safety(n, f, 1, &pcx);
        pcx.fns[f].ret
    }
}

// (0.25) An `inout self` receiver that is an element of a Vec, a Buf or a
// String (`v[0].inc()`, checked as `v.as_slice()[0]`): the rule of an inout
// access for the container, v.
fn check_elem_receiver(receiver: i64, at: i64, pcx: inout Ctx<Comp>) {
    var p = receiver;
    for _ in 0..64 {
        let k = pcx.nodes[p].kind;
        if k == NodeKind::FieldAccess && pcx.nodes[p].y == 0 || k == NodeKind::TupleField
            || k == NodeKind::Index {
            p = pcx.nodes[p].a;
        } else {
            break;
        }
    }
    if p != receiver
        && (pcx.nodes[p].kind == NodeKind::Call || pcx.nodes[p].kind == NodeKind::MethodCall)
        && pcx.nodes[p].count > 0 {
        let f = pcx.nodes[p].x - 1;
        if f >= 0 && sym_text(pcx.fns[f].display, pcx).len >= 8 {
            let w = sym_text(pcx.fns[f].display, pcx);
            if w.len >= 8 && w[w.len as i64 - 8..] == "as_slice" {
                var base = child(p, 0, pcx);
                if pcx.nodes[base].kind == Unary && pcx.nodes[base].op == Tok::Amp {
                    base = pcx.nodes[base].b;
                }
                crate::front::check::assign::check_inout_place(base, at, &pcx);
            }
        }
    }
}

// (0.17) `s.len()` on a slice is its field `s.len`; on an array, its
// length; a usize (0.26.2, as the field and std's lengths), as Rust
// writes both.
fn len_method(n: i64, receiver: i64, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    if pcx.types[ty].kind == TyKind::Array {
        pcx.nodes[n].kind = NodeKind::Int;
        pcx.nodes[n].a = pcx.types[ty].b;
        pcx.nodes[n].b = SUF_USIZE;
        pcx.nodes[n].count = 0;
        return TY_USIZE;
    }
    pcx.nodes[n].kind = NodeKind::FieldAccess;
    pcx.nodes[n].a = receiver;
    pcx.nodes[n].count = 0;
    pcx.nodes[n].y = 2;
    pcx.nodes[n].x = 1;
    TY_USIZE
}

// Whether e is a variable, a constant, a static or a field of one: what
// can be left unevaluated (an array's `.len()` is its type's).
pub fn is_plain_place(e: i64, pcx: Ctx<Comp>) -> bool {
    match pcx.nodes[e].kind {
        NodeKind::Ident | NodeKind::Path => true,
        NodeKind::FieldAccess | NodeKind::TupleField => is_plain_place(pcx.nodes[e].a, pcx),
        _ => false,
    }
}
