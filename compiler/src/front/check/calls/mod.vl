// Calls: direct calls and calls through a function value, their arguments
// against the parameters (generic functions instantiated), paths
// (`m::f`, `T::f`, `Enum::Variant`) and the calls through them, and
// method calls (`x.m()`, with `&x` or `*x` as its `self` needs).

pub mod paths;

