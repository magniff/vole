fn is_variadic_arg_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    is_ffi_safe(t, pcx)
}

pub fn synth_call(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let callee = pcx.nodes[n as usize].a;
        if callee == 0 && pcx.nodes[n as usize].x != 0 {
            // A method call, already checked (and made a call), when a rewrite
            // checks an expression again (`for x in v.items()`).
            return pcx.fns[(pcx.nodes[n as usize].x - 1) as usize].ret;
        }
        if pcx.nodes[callee as usize].kind == Path {
            return synth_path_call(n, callee, pcx);
        }
        if pcx.nodes[callee as usize].kind == Ident
            && (pcx.nodes[callee as usize].p & NODE_RESOLVED) == 0
            && lookup_local(pcx.nodes[callee as usize].a, pcx).is_none()
            && env_lookup(pcx.nodes[callee as usize].a, pcx) == 0
            && is_vector((*pcx.sym_primitive.add(pcx.nodes[callee as usize].a as usize)), pcx) {
            // `v4f32(a, b, c, d)` (0.10).
            return make_vecop(n, 0, VK_NEW,
                (*pcx.sym_primitive.add(pcx.nodes[callee as usize].a as usize)), pcx);
        }
        if pcx.nodes[callee as usize].kind == Ident
            && (pcx.nodes[callee as usize].p & NODE_RESOLVED) == 0
            && lookup_local(pcx.nodes[callee as usize].a, pcx).is_none() {
            let name = pcx.nodes[callee as usize].a;
            let b = lookup_item(pcx.cur_mod, name, pcx.cur_mod, pcx);
            note_c_use(pcx.nodes[callee as usize].start, name, b, pcx);
            // RULE: F7.2, F5.4 (the rust edition: `S(a, b)` of a tuple
            // struct, `Self(a, b)` in its impls)
            if name == pcx.self_type_sym && pcx.edition != 0
                && crate::front::check::rust::tuple_struct_call(n,
                    crate::front::check::rust::SELF_KEY, pcx) {
                return synth_expr(n, pcx);
            }
            if binding_kind(b) == B_ITEM && pcx.edition != 0
                && crate::front::check::rust::tuple_struct_call(n, binding_value(b), pcx) {
                return synth_expr(n, pcx);
            }
            if binding_kind(b) == B_VARIANT {
                // `V(a, b)` for a variant brought into scope by `use`.
                let v = binding_value(b);
                pcx.nodes[callee as usize].kind = Path;
                pcx.nodes[callee as usize].b = name;
                pcx.nodes[callee as usize].y = enum_type(pcx.variants[v as usize].enum_id, pcx);
                return synth_path_call(n, callee, pcx);
            }
            if binding_kind(b) == B_TVARIANT {
                // ... of a generic enum (0.6), its type arguments inferred.
                pcx.nodes[callee as usize].kind = Path;
                pcx.nodes[callee as usize].b = name;
                pcx.nodes[callee as usize].y = -binding_value(b) - 1;
                return synth_path_call(n, callee, pcx);
            }
            if binding_kind(b) == B_PRIVATE {
                access_error(b, pcx.nodes[callee as usize].start, name, pcx);
            }
            if binding_kind(b) == B_ITEM && (*pcx.sym_fn.add(binding_value(b) as usize)) != 0 {
                return call_function(n, (*pcx.sym_fn.add(binding_value(b) as usize)) - 1,
                    pcx.nodes[callee as usize].g, pcx);
            }
        }
        if pcx.nodes[callee as usize].kind == Ident
            && (pcx.nodes[callee as usize].p & NODE_RESOLVED) != 0
            && (*pcx.sym_fn.add(pcx.nodes[callee as usize].a as usize)) != 0 {
            return call_function(n, (*pcx.sym_fn.add(pcx.nodes[callee as usize].a as usize)) - 1,
                pcx.nodes[callee as usize].g, pcx);
        }
        pcx.callee_pos = pcx.nodes[callee as usize].start;
        let callee_ty0 = synth_expr(callee, pcx);
        // RULE: D21.3 (an `impl Fn*` result called: its hidden closure)
        let callee_ty0 = crate::front::opaque::reveal_callee(callee, callee_ty0, pcx);
        let callee_ty = crate::front::closures::fn_through_ref(n, callee_ty0, pcx);
        if closure_of_type(callee_ty, pcx) != 0
            || crate::front::closures::closure_through_ref(callee_ty, pcx) {
            return closure_call(n, callee_ty, pcx);
        }
        if !is_fn_type(callee_ty, pcx) {
            err_begin(pcx.nodes[callee as usize].start, pcx);
            err_str(c"cannot call non-function type '", pcx);
            err_type(callee_ty, pcx);
            err_str(c"'", pcx);
            err_end(pcx);
        }
        if pcx.nodes[n as usize].count != pcx.types[callee_ty as usize].count {
            err_begin(pcx.nodes[n as usize].start, pcx);
            err_str(c"function pointer expects ", pcx);
            err_int(pcx.types[callee_ty as usize].count, pcx);
            err_str(c" arguments, got ", pcx);
            err_int(pcx.nodes[n as usize].count, pcx);
            err_end(pcx);
        }
        // RULE: F19.3 (a call through an `unsafe fn` pointer needs `unsafe`,
        // as rustc's E0133; a C function pointer's, as in MVS: FL)
        if crate::front::types::fn_ty_unsafe(callee_ty, pcx) {
            unsafe_op(n, U_UNSAFE_CALL, c"calling an `unsafe fn` pointer is unsafe", pcx);
        } else if crate::front::types::fn_ty_c(callee_ty, pcx) {
            unsafe_op(n, U_C_CALL, c"calling an extern \"C\" function pointer is unsafe", pcx);
        }
        for i in 0..pcx.nodes[n as usize].count {
            let arg = child(n, i, pcx);
            // (0.28.0: a rust program's call through a fn value: its
            // arguments as a function's, no place lent unasked, R5)
            let saved = pcx.rust_arg;
            pcx.rust_arg = if crate::front::check::rust::rust_node(arg, pcx) { arg } else { 0 };
            check_expr(arg, type_elem(callee_ty, i, pcx), pcx);
            pcx.rust_arg = saved;
        }
        pcx.types[callee_ty as usize].a
    }
}

// A direct call of function f (a template is instantiated first, with
// the turbofish `written`, a Generics node or 0).
fn call_function(n: i64, f0: i64, written: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // (0.26.2: `println("{} {x}", a.b)`: a format literal and its
    // arguments made one Interp, as an f-string; `panic("{x}")` calls
    // std's __panic_fmt)
    crate::front::check::sealed::check_method_private(n, f0, pcx);
    let f = format_call(n, f0, false, pcx);
    let mut g = f;
    // (0.15: named arguments, defaults)
    normalize_args(n, f, 0, pcx);
    // RULE: F16.4 (0.28.0, a rust program on std2: the format functions
    // are Rust's macros, whose format is a string literal: `println(a)`
    // is rustc's "format argument must be a string literal")
    if written == 0 && pcx.nodes[n as usize].count > 0 && crate::front::known::on_std2(pcx)
        && crate::front::check::rust::rust_node(n, pcx)
        && crate::front::modules::within_std(pcx.fns[f as usize].module, pcx)
        && !crate::front::modules::within_std(pcx.cur_mod, pcx) {
        let fname = crate::base::sym_text(pcx.nodes[pcx.fns[f as usize].node as usize].a, pcx);
        let at: i64 = if fname == "writeln".as_bytes() { 1 }
            else if fname == "print".as_bytes() || fname == "println".as_bytes()
            || fname == "eprint".as_bytes() || fname == "eprintln".as_bytes()
            || fname == "panic".as_bytes() || fname == "format_in".as_bytes() { 0 }
            else { -1 };
        if at >= 0 && pcx.nodes[n as usize].count > at {
            let fmt_arg = child(n, at, pcx);
            let k = pcx.nodes[fmt_arg as usize].kind;
            if k != NodeKind::Str && k != NodeKind::Interp && k != NodeKind::NamedArg {
                err_begin(pcx.nodes[fmt_arg as usize].start, pcx);
                err_str(c"format argument must be a string literal", pcx);
                err_help(c"write the format and pass the value: `println(\"{}\", x)`", pcx);
                err_end(pcx);
            }
        }
    }
    // (0.17: `println(f"..")`, `format_in(f"..", a)`: the f-string
    // written in place)
    if written == 0 {
        let direct = direct_kind(n, f, false, pcx);
        if direct == crate::front::check::interp::D_WRITE
            || direct == crate::front::check::interp::D_WRITELN {
            // (the destination apart, as push_fmt's receiver: `__r`)
            let mut w = child(n, 0, pcx);
            // RULE: F16.3 (0.27.3: `write(v, ..)` of a place that is no
            // reference is `write(&mut v, ..)`, as Rust's `v.write_fmt(..)`
            // takes it, its autoref)
            let simple = pcx.nodes[w as usize].kind == NodeKind::Ident
                || pcx.nodes[w as usize].kind == NodeKind::FieldAccess;
            if simple && crate::front::known::on_std2(pcx)
                && crate::front::check::rust::rust_node(n, pcx) {
                let t = synth_expr(w, pcx);
                if t > 0 && t != pcx.ty_error && !is_pointer(t, pcx) {
                    let u = new_node(NodeKind::Unary, pcx.nodes[w as usize].start,
                        pcx.nodes[w as usize].end, pcx);
                    pcx.nodes[u as usize].op = crate::front::lexer::Tok::Amp;
                    pcx.nodes[u as usize].b = w;
                    pcx.nodes[u as usize].p |= crate::front::ast::NODE_REF_MUT;
                    w = u;
                }
            }
            synth_expr(w, pcx);
            let fs = child(n, 1, pcx);
            let mark = list_begin(pcx);
            list_push(fs, pcx);
            list_end(n, mark, pcx);
            return direct_call(n, f, direct, w, pcx);
        }
        if direct != 0 {
            return direct_call(n, f, direct, 0, pcx);
        }
    }
    if pcx.fns[f as usize].generic > 0 {
        g = instantiate_call(f, n, 0, 0, written, pcx);
    } else if written != 0 {
        err_begin(pcx.nodes[written as usize].start, pcx);
        err_str(c"function '", pcx);
        err_sym(pcx.fns[f as usize].display, pcx);
        err_str(c"' is not generic", pcx);
        err_end(pcx);
    }
    pcx.nodes[n as usize].x = g + 1;
    check_direct_call(n, g, pcx)
}

pub fn check_direct_call(n: i64, f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    ensure_checked(f, n, pcx);
    let count = pcx.nodes[n as usize].count;
    let params = pcx.fns[f as usize].param_count;
    let variadic = pcx.fns[f as usize].variadic;
    let arity_ok = if variadic { count >= params } else { count == params };
    // (0.19: `vld1q_u8(p)`, a memory intrinsic called with a pointer)
    if !arity_ok && (pcx.nodes[pcx.fns[f as usize].node as usize].p & FN_INTRINSIC) != 0
        && check_raw_form(n, f, pcx) {
        return pcx.fns[f as usize].ret;
    }
    if !arity_ok {
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_str(c"function '", pcx);
        err_sym(pcx.fns[f as usize].display, pcx);
        err_str(c"' expects ", pcx);
        if variadic {
            err_str(c"at least ", pcx);
        }
        err_int(params, pcx);
        err_str(c" arguments, got ", pcx);
        err_int(count, pcx);
        if !variadic {
            arity_help(n, f, count, params, pcx);
        }
        err_end(pcx);
    }
    // RULE: F0.6 (0.27.5: std::arch's feature names, `has("neon")`, are
    // the literal's text, read by the compiler: a `&str` in the rust
    // edition where the intrinsic's `[u8]` goes)
    let intrinsic = (pcx.nodes[pcx.fns[f as usize].node as usize].p & FN_INTRINSIC) != 0;
    if intrinsic {
        pcx.text_bytes += 1;
    }
    for i in 0..params {
        check_call_arg(child(n, i, pcx), f, i, pcx);
    }
    if intrinsic {
        pcx.text_bytes -= 1;
    }
    check_call_safety(n, f, 0, pcx);
    // (0.19: std::arch's immediates and feature names)
    if (pcx.nodes[pcx.fns[f as usize].node as usize].p & FN_INTRINSIC) != 0 {
        check_intrinsic_call(n, f, pcx);
    }
    for i in params..count {
        let arg = child(n, i, pcx);
        let ty = synth_expr(arg, pcx);
        if !is_variadic_arg_type(ty, pcx) {
            err_begin(pcx.nodes[arg as usize].start, pcx);
            err_str(c"cannot pass value of type '", pcx);
            err_type(ty, pcx);
            err_str(c"' as a variadic argument", pcx);
            err_end(pcx);
        }
    }
    pcx.fns[f as usize].ret
}

fn path_target(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.nodes[n as usize].y > 0 {
            // Made by the checker from a variant in scope.
            return pcx.nodes[n as usize].y;
        }
        if pcx.nodes[n as usize].y < 0 {
            // ... of a generic enum (0.6): its template.
            pcx.path_tpl = pcx.nodes[n as usize].y;
            return -1;
        }
        let name = pcx.nodes[n as usize].a;
        let member = pcx.nodes[n as usize].b;
        let mut m = pcx.cur_mod;
        let mut b: i64 = 0;
        let segments = pcx.nodes[n as usize].count;
        if segments > 0 {
            // `a::b::T::m` or `a::b::f`: the module of the next-to-last part.
            m = path_module(n, segments - 2, pcx);
            b = lookup_name(m, name, pcx.cur_mod, pcx);
            // (`a::m::f`: m is a reference to the module too)
            if binding_kind(b) == B_MODULE {
                qnote_module(pcx.nodes[child(n, segments - 2, pcx) as usize].start, name,
                    binding_value(b), 0, pcx);
            }
        } else {
            if env_lookup(name, pcx) != 0 || (*pcx.sym_primitive.add(name as usize)) != 0
                || (name == pcx.self_type_sym && pcx.self_type != 0) {
                if pcx.nodes[n as usize].g != 0 {
                    name_error(pcx.nodes[n as usize].start, c"'", name,
                        c"' takes no type arguments", pcx);
                }
                return resolve_named(name, pcx.nodes[n as usize].start, pcx);
            }
            if name == pcx.sym_crate || name == pcx.self_sym || name == pcx.sym_super {
                m = if name == pcx.sym_crate {
                    // RULE: Z1.1 (0.27.2: in std2, `crate` is std2's root)
                    if pcx.std2 && pcx.edition != 0
                        && crate::front::modules::within_std(pcx.cur_mod, pcx) { pcx.std_module }
                    else { 0 }
                } else if name == pcx.self_sym { pcx.cur_mod }
                    else { pcx.modules[pcx.cur_mod as usize].parent };
                if m < 0 {
                    error_at(pcx.nodes[n as usize].start, c"the root module has no 'super'", pcx);
                }
                b = binding(B_MODULE, m);
            } else {
                b = lookup_name(m, name, pcx.cur_mod, pcx);
                note_c_use(pcx.nodes[n as usize].start, name, b, pcx);
                if b == B_NONE && name == pcx.sym_std && pcx.std_module >= 0 {
                    b = binding(B_MODULE, pcx.std_module);
                }
                if b == B_NONE {
                    // (0.17) a module beside this one, else the root's, as
                    // a `use` path's first segment
                    let other = sibling_module(pcx.cur_mod, name, n, n, -1, pcx);
                    if other >= 0 {
                        b = binding(B_MODULE, other);
                    }
                }
                if binding_kind(b) == B_MODULE {
                    qnote_module(pcx.nodes[n as usize].start, name, binding_value(b), 0, pcx);
                }
            }
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, pcx.nodes[n as usize].start, name, pcx);
        }
        if binding_kind(b) == B_MODULE {
            // `m::item`: the item, by key.
            let target = binding_value(b);
            let item = lookup_name(target, member, pcx.cur_mod, pcx);
            if binding_kind(item) == B_PRIVATE {
                access_error(item, pcx.nodes[n as usize].start, member, pcx);
            }
            if binding_kind(item) == B_MODULE {
                name_error(pcx.nodes[n as usize].start, c"'", member, c"' is a module, not a value",
                    pcx);
            }
            if binding_kind(item) == B_VARIANT {
                let v = binding_value(item);
                pcx.nodes[n as usize].y = enum_type(pcx.variants[v as usize].enum_id, pcx);
                pcx.nodes[n as usize].count = 0;
                return pcx.nodes[n as usize].y;
            }
            if binding_kind(item) != B_ITEM && target == pcx.c_module {
                // (`c::name`, through `import "h.h" as c;`)
                unknown_name_error(pcx.nodes[n as usize].start,
                    c"no declaration in the C headers named '", member, pcx);
            }
            if binding_kind(item) != B_ITEM && target != 0 {
                crate::front::conv::env_var_error(n,
                    sym_text(pcx.modules[target as usize].key, pcx), sym_text(member, pcx), pcx);
            }
            // (0.26.3: `env::get(name)`: `env::get_in(name, gpa)`)
            if binding_kind(item) != B_ITEM && target > 0 && binding_kind(lookup_name(target,
                crate::front::check::alloc_rules::in_name(member, pcx), pcx.cur_mod,
                pcx)) == B_ITEM {
                let what = buf_new();
                buf_bytes(what, sym_text(pcx.modules[target as usize].key, pcx));
                buf_str(what, c"::");
                buf_bytes(what, sym_text(member, pcx));
                crate::front::check::alloc_rules::no_in_error(n, member, buf_slice(what), pcx);
            }
            if binding_kind(item) != B_ITEM {
                err_begin(pcx.nodes[n as usize].start, pcx);
                err_str(c"no '", pcx);
                err_sym(member, pcx);
                err_str(c"' in module '", pcx);
                if target == 0 {
                    err_str(c"crate", pcx);
                } else {
                    err_sym(pcx.modules[target as usize].key, pcx);
                }
                err_str(c"'", pcx);
                // (0.25.2.2: the prelude's item, or another module's of std)
                crate::front::check::names::help_std_elsewhere(target, member, false,
                    pcx.std_module, pcx.cur_mod, (*get_bufs().add(pcx.err_help as usize)).len > 0,
                    pcx);
                // (0.25.2.1: a function std has under another name)
                let syn = crate::front::check::names::std_synonym_help(sym_text(member, pcx));
                if crate::front::modules::within_std(target, pcx) && syn.len() > 0 {
                    err_help_fmt(str::from_utf8(syn).unwrap(), pcx);
                }
                help_near_item(target, member, pcx);
                err_end(pcx);
            }
            pcx.nodes[n as usize].kind = Ident;
            pcx.nodes[n as usize].a = binding_value(item);
            pcx.nodes[n as usize].p |= NODE_RESOLVED;
            pcx.nodes[n as usize].g = pcx.nodes[n as usize].h;
            pcx.nodes[n as usize].count = 0;
            return -2;
        }
        if binding_kind(b) != B_ITEM {
            if segments == 0 && b == B_NONE {
                module_as_path_error(pcx.cur_mod, name, pcx.nodes[n as usize].start, n, pcx);
            }
            unknown_name_error(pcx.nodes[n as usize].start, c"unknown type '", name, pcx);
        }
        let key = binding_value(b);
        qnote(pcx.nodes[n as usize].start, name, item_node_of(key, pcx), 0, pcx);
        let tpl = template_of_key(key, pcx);
        if tpl != TPL_NONE {
            if pcx.nodes[n as usize].g != 0 {
                let mark = pcx.tscratch.count;
                push_written_targs(pcx.nodes[n as usize].g, pcx);
                return template_instance(tpl, mark, pcx.nodes[n as usize].start, pcx);
            }
            pcx.path_tpl = tpl;
            return -1;
        }
        // (0.18: `NonNull::new(p)`, a generic distinct type's function)
        let alias = (*pcx.sym_alias.add(key as usize));
        if alias != 0 && pcx.nodes[alias as usize].g != 0 && pcx.nodes[n as usize].g == 0
            && is_distinct(alias, pcx) {
            pcx.path_tpl = TPL_DISTINCT + alias;
            return -1;
        }
        if pcx.nodes[n as usize].g != 0 {
            name_error(pcx.nodes[n as usize].start, c"'", name, c"' is not generic", pcx);
        }
        resolve_key(key, name, pcx.nodes[n as usize].start, pcx)
    }
}

// `T::m`: a variant without fields, or an associated function as a value.
pub fn synth_path(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let hint = hint_for(n, pcx);
    // (0.25.2.1) `f64::consts::PI`, `std::f32::consts::TAU`: no module
    let segs = pcx.nodes[n as usize].count;
    if pcx.nodes[n as usize].y == 0 && (segs == 3 || segs == 4)
        && sym_is_c(pcx.nodes[n as usize].a, c"consts", pcx)
        && (segs == 3 || sym_is_c(pcx.nodes[child(n, 0, pcx) as usize].a, c"std", pcx)) {
        let prim = pcx.nodes[child(n, segs - 3, pcx) as usize].a;
        let ft: i64 = if sym_is_c(prim, c"f64", pcx) { TY_F64 }
            else if sym_is_c(prim, c"f32", pcx) { TY_F32 } else { 0 };
        if ft != 0 {
            let r = float_const(n, ft, pcx.nodes[n as usize].b, true, pcx);
            if r < 0 {
                float_const_error(pcx.nodes[n as usize].start, ft, pcx.nodes[n as usize].b, true,
                    pcx);
            }
            return r;
        }
    }
    let mut t = path_target(n, pcx);
    if t == -2 {
        return synth_expr(n, pcx);
    }
    let member = pcx.nodes[n as usize].b;
    if t == -1 {
        if pcx.path_tpl < 0 && template_variant_named(-pcx.path_tpl - 1, member, pcx) {
            pcx.hint_ty_path = hint;
            t = infer_enum(pcx.path_tpl, 0, member, 0, pcx.nodes[n as usize].start, pcx);
        } else {
            err_begin(pcx.nodes[n as usize].start, pcx);
            err_str(c"'", pcx);
            err_sym(template_name(pcx.path_tpl, pcx), pcx);
            err_str(c"' is generic: write its type arguments ('", pcx);
            err_sym(template_name(pcx.path_tpl, pcx), pcx);
            err_str(c"::<...>::", pcx);
            err_sym(member, pcx);
            err_str(c"')", pcx);
            err_end(pcx);
        }
    }
    if pcx.types[t as usize].kind == TyKind::Enum {
        let v = find_variant(pcx.types[t as usize].a, member, pcx);
        if v >= 0 {
            if pcx.variants[v as usize].field_count > 0 {
                err_begin(pcx.nodes[n as usize].start, pcx);
                err_str(c"variant '", pcx);
                err_type(t, pcx);
                err_str(c"::", pcx);
                err_sym(member, pcx);
                err_str(c"' has ", pcx);
                err_int(pcx.variants[v as usize].field_count, pcx);
                err_str(if pcx.variants[v as usize].field_count == 1 { c" field" }
                    else { c" fields" },
                    pcx);
                if has_named_fields(v, pcx) {
                    // (0.17)
                    positional_error(n, v, t, false, pcx);
                }
                err_help(c"construct it with '", pcx);
                buf_type(pcx.err_help, t, pcx);
                err_help(c"::", pcx);
                err_help_sym(member, pcx);
                err_help(c"(...)'", pcx);
                err_end(pcx);
            }
            pcx.nodes[n as usize].kind = VariantLit;
            pcx.nodes[n as usize].a = v;
            pcx.nodes[n as usize].count = 0;
            return t;
        }
    }
    let mut f = method_of(t, member, pcx);
    // (0.15: `i64::MAX`, `u8::MIN`, a literal)
    if f < 0 && is_integer(t)
        && (sym_is_c(member, c"MAX", pcx) || sym_is_c(member, c"MIN", pcx)) {
        return int_limit(n, t, sym_is_c(member, c"MAX", pcx), pcx);
    }
    // (0.25.2.1: `f64::EPSILON`, `f32::NAN`, a literal)
    if f < 0 && (t == TY_F32 || t == TY_F64) {
        let r = float_const(n, t, member, false, pcx);
        if r >= 0 {
            return r;
        }
        if float_const_bits(t == TY_F32, member, true, pcx) != 0 {
            float_const_error(pcx.nodes[n as usize].start, t, member, false, pcx);
        }
    }
    // RULE: F3.2 (0.27.2: `t::N`, an associated constant)
    if f < 0 && crate::front::check::rust::rust_node(n, pcx) {
        let mut r = crate::front::assoc::inherent_const_value(n, t, member, pcx);
        if r < 0 {
            r = crate::front::assoc::assoc_const_value(n, t, member, pcx);
        }
        if r >= 0 {
            return r;
        }
    }
    // RULE: D22.1 (0.27.3: `Ω::NAME`, a bound's associated constant, FL11)
    if f < 0 && crate::front::opaque::is_omega(t, pcx) {
        let r = crate::front::opaque::omega_const(n, t, member, pcx);
        if r >= 0 {
            return r;
        }
    }
    if f < 0 {
        path_member_error(n, t, member, pcx);
    }
    if pcx.fns[f as usize].generic > 0 {
        if pcx.nodes[n as usize].h == 0 && pcx.fns[f as usize].generic > impl_param_count(f, pcx) {
            err_begin(pcx.nodes[n as usize].start, pcx);
            err_str(c"generic function '", pcx);
            err_sym(member, pcx);
            err_str(c"' needs its type arguments to be used as a value", pcx);
            err_end(pcx);
        }
        let mark = pcx.tscratch.count;
        bind_impl_params(f, t, pcx);
        if pcx.nodes[n as usize].h != 0 {
            push_written_targs(pcx.nodes[n as usize].h, pcx);
        }
        if pcx.tscratch.count - mark != pcx.fns[f as usize].generic {
            targ_count_error(pcx.nodes[n as usize].start, c"function", pcx.fns[f as usize].display,
                pcx.fns[f as usize].generic - impl_param_count(f, pcx),
                pcx.tscratch.count - mark - impl_param_count(f, pcx), pcx);
        }
        f = fn_instance(f, mark, n, pcx);
    }
    pcx.nodes[n as usize].kind = Ident;
    pcx.nodes[n as usize].a = pcx.fns[f as usize].name;
    pcx.nodes[n as usize].res = Res::Fn;
    pcx.nodes[n as usize].y = f;
    pcx.nodes[n as usize].count = 0;
    ensure_checked(f, n, pcx);
    fn_value_type(f, n, pcx)
}

// The number of a method template's parameters that are its impl's.
fn impl_param_count(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let item = pcx.fns[f as usize].node;
    if pcx.nodes[item as usize].h == 0 || pcx.nodes[item as usize].g == 0 { 0 }
    else { pcx.nodes[pcx.nodes[item as usize].g as usize].a }
}

// Pushes on TSCRATCH the arguments of t's template that a method
// template of it takes as its impl's parameters.
fn bind_impl_params(f: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let count = impl_param_count(f, pcx);
    if count == 0 {
        return;
    }
    // (0.27.2: a pattern impl's, by its header; RULE: F0.3)
    let mut targs: i64 = -1;
    for i in 0..pcx.gmethods.len() as i64 {
        if pcx.gmethods[i as usize].f == f && pcx.gmethods[i as usize].ty == TPL_PATTERN {
            targs = crate::front::traits::fn_pattern_bindings(f, t, pcx);
        }
    }
    if targs < 0 {
        targs = instance_targs(t, pcx);
    }
    for i in 0..count {
        unsafe { pcx.tscratch.push((*pcx.tlists.data.add((targs + i) as usize))); }
    }
}

// (0.27.2) The trait a path callee names (`Tr::f`, `a::b::Tr::f`), its
// index + 1, or 0: neither a local nor a primitive, an item that is a
// trait. RULE: F8.2
fn trait_path_key(callee: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let segments = pcx.nodes[callee as usize].count;
    let mut key: i64 = -1;
    if segments == 0 {
        if env_lookup(pcx.nodes[callee as usize].a, pcx) != 0
            || is_primitive_name(pcx.nodes[callee as usize].a, pcx) {
            return 0;
        }
        key = type_name_key(callee, pcx);
    } else {
        // (`a::b::Tr::m`: Tr in the module of the parts before it)
        let m = path_module(callee, segments - 2, pcx);
        let b = lookup_name(m, pcx.nodes[callee as usize].a, pcx.cur_mod, pcx);
        if binding_kind(b) == B_ITEM {
            key = binding_value(b);
        }
    }
    if key < 0 {
        return 0;
    }
    // UNSAFE: sym_trait is a raw table indexed by item key (sym_table)
    // SAFETY: key is an item's key from type_name_key or lookup_name, so
    // within the table, which has a slot for every key
    unsafe { (*pcx.sym_trait.add(key as usize)) }
}

// Whether sym names a primitive type.
fn is_primitive_name(sym: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: sym_primitive is a raw table indexed by symbol (sym_table)
    // SAFETY: sym is an interned symbol, and the table has a slot for each
    unsafe { (*pcx.sym_primitive.add(sym as usize)) != 0 }
}

// (0.27.2) `Tr::f(args)` where a `T` is expected, f an associated function
// of trait Tr without a receiver (`Default::default()`, `From::from(x)`):
// Self is the expected type, as `<T as Tr>::f(args)`; call n's callee
// then names it (y, the type path_target reads). RULE: F8.2
pub fn trait_assoc_self(n: i64, expected: i64, pcx: &mut Ctx<Comp>) {
    let callee = pcx.nodes[n as usize].a;
    if callee <= 0 || pcx.nodes[callee as usize].kind != NodeKind::Path
        || pcx.nodes[callee as usize].y != 0 || pcx.nodes[callee as usize].b == 0 || expected <= 0
        || has_error_type(expected, pcx)
        || pcx.types[expected as usize].kind == TyKind::None {
        return;
    }
    let tr = trait_path_key(callee, pcx);
    if tr == 0 {
        return;
    }
    let f = crate::front::traits::trait_fn(tr - 1, pcx.nodes[callee as usize].b, pcx);
    if f == 0
        || pcx.nodes[f as usize].count > 0
        && pcx.nodes[child(f, 0, pcx) as usize].a == pcx.self_sym {
        return;
    }
    // (0.27.3: only a function whose result is `Self`, or std's Option or
    // Result of it, `TryFrom::try_from(x)`; `Step::steps_between(&a, &b)`
    // returns a tuple, and its Self comes from its arguments)
    let s = self_in_result(pcx.nodes[f as usize].b, expected, 0, pcx);
    if s > 0 {
        pcx.nodes[callee as usize].y = s;
    }
}

// RULE: F8.2 (0.27.3) The type a trait function's Self is when its written
// result `ret` (a type node) has type `expected`: ret is `Self`, or std's
// enum of it (`Result<Self, Self::Error>`, `Option<Self>`) with expected
// that enum's instance; 0 when ret does not say.
fn self_in_result(ret: i64, expected: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if ret <= 0 || expected <= 0 || depth > 4 || pcx.nodes[ret as usize].kind != NodeKind::TyName
        || pcx.nodes[ret as usize].count != 0 {
        return 0;
    }
    let g = pcx.nodes[ret as usize].g;
    if g == 0 {
        return if pcx.nodes[ret as usize].a == pcx.self_type_sym { expected } else { 0 };
    }
    let mut targs: i64 = 0;
    if crate::front::convert::std_enum_name(expected, &mut targs, pcx)
        != pcx.nodes[ret as usize].a {
        return 0;
    }
    for i in 0..pcx.nodes[g as usize].count {
        let s = self_in_result(child(g, i, pcx), pcx.tlists.get(targs + i), depth + 1, pcx);
        if s > 0 {
            return s;
        }
    }
    0
}

// RULE: F8.2 (0.27.6) The type a trait function's Self is from call n's
// arguments, for a function without a receiver whose parameter's written
// type holds Self (`Self`, `&Self`, `&mut Self`, `&[Self]`, `[Self]`):
// from the type the argument has without being checked (a local, `&e`,
// `&mut e`, `e[a..b]` of one), as rustc infers it (`Hash::hash_slice(self,
// state)` with `self: &[T]` is `<T as Hash>::hash_slice`); 0 when none says.
fn self_from_args(f: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let count = if pcx.nodes[n as usize].count
        < pcx.nodes[f as usize].count { pcx.nodes[n as usize].count }
        else { pcx.nodes[f as usize].count };
    for i in 0..count {
        let param_ty = pcx.nodes[child(f, i, pcx) as usize].b;
        let t = quiet_type(child(n, i, pcx), 0, pcx);
        let s = self_in_param(param_ty, t, 0, pcx);
        if s > 0 {
            return s;
        }
    }
    0
}

// The type of expression e known without checking it: a local's, `&e` and
// `&mut e` of one, `e[a..b]` of an array, a slice or a Vec; 0 otherwise.
fn quiet_type(e: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if e <= 0 || depth > 4 {
        return 0;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident && pcx.nodes[e as usize].count == 0 {
        return match lookup_local(pcx.nodes[e as usize].a, pcx) {
            Option::Some(l) => pcx.locals[l as usize].ty,
            Option::None => 0,
        };
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Amp {
        let t = quiet_type(pcx.nodes[e as usize].b, depth + 1, pcx);
        if t <= 0 {
            return 0;
        }
        if pcx.types[t as usize].kind == TyKind::Slice {
            return t;
        }
        return crate::front::types::ref_to(t,
            if (pcx.nodes[e as usize].p & NODE_REF_MUT) != 0 { crate::front::types::REF_MUT }
            else { crate::front::types::REF_SHARED }, pcx);
    }
    if k == NodeKind::Index && pcx.nodes[pcx.nodes[e as usize].b as usize].kind == NodeKind::Range {
        let mut t = quiet_type(pcx.nodes[e as usize].a, depth + 1, pcx);
        while t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            t = pcx.types[t as usize].a;
        }
        if t > 0
            && (pcx.types[t as usize].kind == TyKind::Array
                || pcx.types[t as usize].kind == TyKind::Slice) {
            return crate::front::types::slice_of(pcx.types[t as usize].a, pcx);
        }
    }
    0
}

// The type Self is when a parameter written `ty` (a type node) takes a
// value of type t: `Self` itself, through `&`, `&mut` and `[..]`; 0 when
// ty does not hold Self in those.
fn self_in_param(ty: i64, t: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if ty <= 0 || t <= 0 || depth > 4 {
        return 0;
    }
    let k = pcx.nodes[ty as usize].kind;
    if k == NodeKind::TyName {
        return if pcx.nodes[ty as usize].a == pcx.self_type_sym && pcx.nodes[ty as usize].count == 0
            && pcx.nodes[ty as usize].g == 0 { t } else { 0 };
    }
    if k == NodeKind::TyPtr && pcx.types[t as usize].kind == TyKind::Ptr {
        return self_in_param(pcx.nodes[ty as usize].a, pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == NodeKind::TySlice && pcx.types[t as usize].kind == TyKind::Slice {
        return self_in_param(pcx.nodes[ty as usize].a, pcx.types[t as usize].a, depth + 1, pcx);
    }
    0
}

// RULE: Z9.1c (0.27.6) The trait of a bound of type parameter `name` (of
// the instance being checked) that declares `member` with a `self`
// receiver, or -1.
fn bound_method_trait(name: i64, member: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let p = bounded_param(name, pcx);
    if p == 0 {
        return -1;
    }
    let bounds = pcx.nodes[p as usize].h;
    for i in 0..pcx.nodes[bounds as usize].count {
        let tr = crate::front::traits::bound_trait(child(bounds, i, pcx), pcx);
        if tr < 0 {
            continue;
        }
        let f = crate::front::traits::trait_fn(tr, member, pcx);
        if f != 0 && pcx.nodes[f as usize].count > 0
            && pcx.nodes[child(f, 0, pcx) as usize].a == pcx.self_sym {
            return tr;
        }
    }
    -1
}

// `T::m(args)`: a variant with fields, or a call of an associated function
// (or of a method, with the receiver passed explicitly).
fn synth_path_call(n: i64, callee: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.nodes[callee as usize].count == 0 && pcx.nodes[callee as usize].y == 0
            && env_lookup(pcx.nodes[callee as usize].a, pcx) == 0
            && is_vector((*pcx.sym_primitive.add(pcx.nodes[callee as usize].a as usize)), pcx) {
            // `v4f32::splat(x)`, `v4f32::load(s, i)` (0.10).
            return vector_assoc_call(n, callee,
                (*pcx.sym_primitive.add(pcx.nodes[callee as usize].a as usize)), pcx);
        }
        // RULE: F8.2 (0.27.2: `Tr::m(x, args)`, a trait's method with its
        // receiver explicit, is `x.m(args)`, probed as a method call is;
        // 0.27.2 M3: by its path too, `std::clone::Clone::clone(x)`, as
        // the derives write it, F17.1)
        if pcx.nodes[callee as usize].y == 0 && pcx.nodes[n as usize].count > 0
            && crate::front::check::rust::rust_node(n, pcx) {
            let mut tr = trait_path_key(callee, pcx);
            // RULE: Z9.1c (0.27.6: `A::m(x, args)` of a bounded parameter A
            // whose bound declares the method m, with a receiver: `Tr::m(x,
            // args)`, the bound's method of the type A stands for, as rustc
            // resolves it on the generic body; `A::clone(&a)` with A = &Gpa
            // is `<&Gpa as Clone>::clone`)
            if tr == 0 && pcx.nodes[callee as usize].count == 0 {
                tr = bound_method_trait(pcx.nodes[callee as usize].a, pcx.nodes[callee as usize].b,
                    pcx) + 1;
            }
            // RULE: F8.2 (0.27.6: a function of the trait without a receiver,
            // its Self from an argument, `Hash::hash_slice(self, state)`:
            // `<T as Hash>::hash_slice`, path_target reads y)
            let f: i64 = if tr
                != 0 { crate::front::traits::trait_fn(tr - 1, pcx.nodes[callee as usize].b, pcx) }
                else { 0 };
            let receiver = f != 0 && pcx.nodes[f as usize].count > 0
                && pcx.nodes[child(f, 0, pcx) as usize].a == pcx.self_sym;
            let s: i64 = if f != 0 && !receiver { self_from_args(f, n, pcx) } else { 0 };
            if s > 0 {
                pcx.nodes[callee as usize].y = s;
                tr = 0;
            }
            if tr != 0 {
                let mut first = child(n, 0, pcx);
                // (`Display::fmt(&x, f)`: the receiver x, the method's
                // `&self` borrows it again)
                if pcx.nodes[first as usize].kind == NodeKind::Unary
                    && pcx.nodes[first as usize].op == Tok::Amp {
                    first = pcx.nodes[first as usize].b;
                }
                let mark = list_begin(pcx);
                for k in 1..pcx.nodes[n as usize].count {
                    list_push(child(n, k, pcx), pcx);
                }
                list_end(n, mark, pcx);
                pcx.nodes[n as usize].kind = NodeKind::MethodCall;
                pcx.nodes[n as usize].a = first;
                pcx.nodes[n as usize].b = pcx.nodes[callee as usize].b;
                pcx.nodes[n as usize].g = pcx.nodes[callee as usize].h;
                pcx.via_node = n;
                pcx.via_trait = tr - 1;
                return synth_expr(n, pcx);
            }
        }
        let mut t = path_target(callee, pcx);
        if t > 0 && is_vector(t, pcx) {
            // (0.19) through an alias: `uint8x16_t::from_bits(v)`
            return vector_assoc_call(n, callee, t, pcx);
        }
        if t == -2 {
            // `m::f(args)`: a call of an item of a module.
            return synth_call(n, pcx);
        }
        let member = pcx.nodes[callee as usize].b;
        if pcx.nodes[callee as usize].count == 0 && t >= 0 {
            let bp = bounded_param(pcx.nodes[callee as usize].a, pcx);
            if bp != 0 {
                require_in_bounds(bp, member, pcx.nodes[callee as usize].start, pcx);
            }
        }
        if t == -1 {
            let tpl = pcx.path_tpl;
            if tpl < 0 && template_variant_named(-tpl - 1, member, pcx) {
                t = infer_enum(tpl, 0, member, n, pcx.nodes[callee as usize].start, pcx);
            } else {
                let mut f = find_generic_method(tpl, member, pcx);
                if f < 0 {
                    // RULE: F5.1 (`HashMap::new_in(a)` of `impl<K, V, A>
                    // HashMap<K, V, A, FixedState>`: a pattern impl on tpl)
                    f = pattern_fn_of_template(tpl, member, pcx);
                }
                // (0.26.3: `W::scalar(x)`, which only `impl W<ScopedArena>`
                // has: that instance's, below)
                let inst: i64 = if f < 0 { sole_instance_with(tpl, member, pcx) } else { 0 };
                if inst > 0 {
                    t = inst;
                } else {
                    if f < 0 {
                        // (0.15: `W::from(x)`, a generic trait's impl for W)
                        let r = template_trait_call(n, tpl, member, pcx);
                        if r >= 0 {
                            return r;
                        }
                        // (0.26.3: `Vec::new()`: `Vec::new_in(gpa)`)
                        if find_generic_method(tpl,
                            crate::front::check::alloc_rules::in_name(member, pcx), pcx)
                            >= 0 {
                            let what = buf_new();
                            buf_bytes(what, sym_text(template_name(tpl, pcx), pcx));
                            buf_str(what, c"::");
                            buf_bytes(what, sym_text(member, pcx));
                            crate::front::check::alloc_rules::no_in_error(n, member,
                                buf_slice(what), pcx);
                        }
                        err_begin(pcx.nodes[callee as usize].start, pcx);
                        err_str(c"no associated function '", pcx);
                        err_sym(member, pcx);
                        err_failed_name(member, pcx);
                        err_str(c"' in '", pcx);
                        err_sym(template_name(tpl, pcx), pcx);
                        err_str(c"'", pcx);
                        pcx.near_all.count = 0;
                        pcx.near_collect = true;
                        let mut near = near_to(member);
                        offer_template_methods(&mut near, tpl, false, pcx);
                        pcx.near_collect = false;
                        near.help(pcx);
                        if (*get_bufs().add(pcx.err_help as usize)).len == 0
                            && pcx.near_all.count > 0 {
                            help_nearest(c"its nearest functions: ", member, pcx);
                        }
                        let a = buf_new();
                        buf_str(a, c"query items ");
                        let name = template_name(tpl, pcx);
                        buf_bytes(a, sym_text(name, pcx));
                        err_try_tool(buf_slice(a), true, pcx);
                        err_end(pcx);
                    }
                    // `Vec::new()`: the type's arguments are inferred too.
                    normalize_args(n, f, 0, pcx);
                    crate::front::check::sealed::check_method_private(n, f, pcx);
                    let g = instantiate_call(f, n, 0, 0, pcx.nodes[callee as usize].h, pcx);
                    pcx.nodes[n as usize].x = g + 1;
                    return check_direct_call(n, g, pcx);
                }
            }
        }
        if pcx.types[t as usize].kind == TyKind::Enum {
            let v = find_variant(pcx.types[t as usize].a, member, pcx);
            if v >= 0 {
                let count = pcx.variants[v as usize].field_count;
                if (pcx.nodes[n as usize].p & CALL_FIELDS) == 0 && has_named_fields(v, pcx) {
                    positional_error(n, v, t, false, pcx);
                }
                if count == 0 {
                    err_begin(pcx.nodes[n as usize].start, pcx);
                    err_str(c"variant '", pcx);
                    err_type(t, pcx);
                    err_str(c"::", pcx);
                    err_sym(member, pcx);
                    err_str(c"' has no fields", pcx);
                    err_help(c"write it without parentheses", pcx);
                    err_end(pcx);
                }
                if pcx.nodes[n as usize].count != count {
                    err_begin(pcx.nodes[n as usize].start, pcx);
                    err_str(c"variant '", pcx);
                    err_type(t, pcx);
                    err_str(c"::", pcx);
                    err_sym(member, pcx);
                    err_str(c"' has ", pcx);
                    err_int(count, pcx);
                    err_str(if count == 1 { c" field" } else { c" fields" }, pcx);
                    err_str(c", got ", pcx);
                    err_int(pcx.nodes[n as usize].count, pcx);
                    err_end(pcx);
                }
                for i in 0..count {
                    check_arg(child(n, i, pcx), variant_field(v, i, pcx), pcx);
                }
                pcx.nodes[n as usize].kind = VariantLit;
                pcx.nodes[n as usize].a = v;
                return t;
            }
        }
        let mut f = method_of(t, member, pcx);
        // RULE: D22.1a (0.27.3: `Ω::f(args)`, a bound's associated function,
        // `T::default()`: its virtual function, FL11)
        if f < 0 && crate::front::opaque::is_omega(t, pcx) {
            f = crate::front::opaque::virtual_fn(t, member, pcx);
        }
        if f < 0 {
            // (0.15: `T::from(x)`, a function of a generic trait's impl)
            let r = generic_trait_call(n, t, member, pcx);
            if r >= 0 {
                return r;
            }
            path_member_error(callee, t, member, pcx);
        }
        crate::front::check::sealed::check_method_private(n, f, pcx);
        normalize_args(n, f, 0, pcx);
        if pcx.fns[f as usize].generic > 0 {
            f = instantiate_call(f, n, 0, t, pcx.nodes[callee as usize].h, pcx);
        }
        pcx.nodes[n as usize].x = f + 1;
        check_direct_call(n, f, pcx)
    }
}

// (0.26.3) The one instance of template tpl whose impl has the function
// `name` (`impl W<ScopedArena> { fn scalar(..) }`, called `W::scalar(x)`);
// 0 when no instance's impl has it, or several have.
fn sole_instance_with(tpl: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut found: i64 = 0;
    // UNSAFE: METHODS is the checker's raw table of methods.
    // SAFETY: i < METHOD_COUNT.
    unsafe {
        for i in 0..pcx.methods.len() as i64 {
            let t = pcx.methods[i as usize].ty;
            if pcx.methods[i as usize].name == name && t > 0 && t != found
                && instance_of(t, tpl, pcx) {
                if found != 0 {
                    return 0;
                }
                found = t;
            }
        }
    }
    found
}

// (0.27.2) The function `name` of a rust-edition pattern impl (TPL_PATTERN)
// whose header names template tpl (`impl<K, V, A> HashMap<K, V, A,
// FixedState>`, for `HashMap::new_in(a)`), or -1: its header's arguments
// are inferred as the call's. RULE: F5.1
fn pattern_fn_of_template(tpl: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if tpl == TPL_NONE || tpl == TPL_PATTERN {
        return -1;
    }
    let mut i = gm_start(TPL_PATTERN, name, pcx);
    while i >= 0 {
        let at = i;
        i = gm_after(i, pcx);
        if pcx.gmethods[at as usize].ty != TPL_PATTERN || pcx.gmethods[at as usize].name != name {
            continue;
        }
        let f = pcx.gmethods[at as usize].f;
        let header = pcx.nodes[pcx.fns[f as usize].node as usize].h;
        if header == 0 || pcx.nodes[header as usize].kind != crate::front::ast::NodeKind::TyName {
            continue;
        }
        let saved = pcx.cur_mod;
        pcx.cur_mod = pcx.fns[f as usize].module;
        let t = template_of_type_node(header, pcx);
        pcx.cur_mod = saved;
        if t == tpl {
            return f;
        }
    }
    -1
}
