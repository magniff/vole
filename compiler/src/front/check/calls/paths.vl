fn is_variadic_arg_type(t: i64, pcx: Ctx<Comp>) -> bool {
    is_ffi_safe(t, pcx)
}

pub fn synth_call(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let callee = pcx.nodes[n].a;
        if callee == 0 && pcx.nodes[n].x != 0 {
            // A method call, already checked (and made a call), when a rewrite
            // checks an expression again (`for x in v.items()`).
            return pcx.fns[pcx.nodes[n].x - 1].ret;
        }
        if pcx.nodes[callee].kind == Path {
            return synth_path_call(n, callee, &pcx);
        }
        if pcx.nodes[callee].kind == Ident && (pcx.nodes[callee].p & NODE_RESOLVED) == 0
            && lookup_local(pcx.nodes[callee].a, pcx).is_none()
            && env_lookup(pcx.nodes[callee].a, pcx) == 0
            && is_vector(pcx.sym_primitive[pcx.nodes[callee].a]) {
            // `v4f32(a, b, c, d)` (0.10).
            return make_vecop(n, 0, VK_NEW, pcx.sym_primitive[pcx.nodes[callee].a], &pcx);
        }
        if pcx.nodes[callee].kind == Ident && (pcx.nodes[callee].p & NODE_RESOLVED) == 0
            && lookup_local(pcx.nodes[callee].a, pcx).is_none() {
            let name = pcx.nodes[callee].a;
            let b = lookup_item(pcx.cur_mod, name, pcx.cur_mod, &pcx);
            note_c_use(pcx.nodes[callee].start, name, b, &pcx);
            if binding_kind(b) == B_VARIANT {
                // `V(a, b)` for a variant brought into scope by `use`.
                let v = binding_value(b);
                pcx.nodes[callee].kind = Path;
                pcx.nodes[callee].b = name;
                pcx.nodes[callee].y = enum_type(pcx.variants[v].enum_id);
                return synth_path_call(n, callee, &pcx);
            }
            if binding_kind(b) == B_TVARIANT {
                // ... of a generic enum (0.6), its type arguments inferred.
                pcx.nodes[callee].kind = Path;
                pcx.nodes[callee].b = name;
                pcx.nodes[callee].y = -binding_value(b) - 1;
                return synth_path_call(n, callee, &pcx);
            }
            if binding_kind(b) == B_PRIVATE {
                access_error(b, pcx.nodes[callee].start, name, &pcx);
            }
            if binding_kind(b) == B_ITEM && pcx.sym_fn[binding_value(b)] != 0 {
                return call_function(n, pcx.sym_fn[binding_value(b)] - 1, pcx.nodes[callee].g,
                    &pcx);
            }
        }
        if pcx.nodes[callee].kind == Ident && (pcx.nodes[callee].p & NODE_RESOLVED) != 0
            && pcx.sym_fn[pcx.nodes[callee].a] != 0 {
            return call_function(n, pcx.sym_fn[pcx.nodes[callee].a] - 1, pcx.nodes[callee].g, &pcx);
        }
        pcx.callee_pos = pcx.nodes[callee].start;
        let callee_ty = synth_expr(callee, &pcx);
        if closure_of_type(callee_ty, pcx) != 0 {
            return closure_call(n, callee_ty, &pcx);
        }
        if !is_fn_type(callee_ty) {
            err_begin(pcx.nodes[callee].start, &pcx);
            err_str(c"cannot call non-function type '", pcx);
            err_type(callee_ty, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        if pcx.nodes[n].count != TYPES[callee_ty].count {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"function pointer expects ", pcx);
            err_int(TYPES[callee_ty].count, pcx);
            err_str(c" arguments, got ", pcx);
            err_int(pcx.nodes[n].count, pcx);
            err_end(&pcx);
        }
        if TYPES[callee_ty].b != 0 {
            unsafe_op(n, U_C_CALL, c"calling an extern \"C\" function pointer is unsafe", &pcx);
        }
        for i in 0..pcx.nodes[n].count {
            let arg = child(n, i, pcx);
            check_expr(arg, type_elem(callee_ty, i), &pcx);
        }
        TYPES[callee_ty].a
    }
}

// A direct call of function f (a template is instantiated first, with
// the turbofish `written`, a Generics node or 0).
fn call_function(n: i64, f0: i64, written: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        // (0.26.2: `println("{} {x}", a.b)`: a format literal and its
        // arguments made one Interp, as an f-string; `panic("{x}")` calls
        // std's __panic_fmt)
        let f = format_call(n, f0, false, &pcx);
        var g = f;
        // (0.15: named arguments, defaults)
        normalize_args(n, f, 0, &pcx);
        // (0.17: `println(f"..")`, `format_in(f"..", a)`: the f-string
        // written in place)
        if written == 0 {
            let direct = direct_kind(n, f, false, pcx);
            if direct != 0 {
                return direct_call(n, f, direct, 0, &pcx);
            }
        }
        if pcx.fns[f].generic > 0 {
            g = instantiate_call(f, n, 0, 0, written, &pcx);
        } else if written != 0 {
            err_begin(pcx.nodes[written].start, &pcx);
            err_str(c"function '", pcx);
            err_sym(pcx.fns[f].display, pcx);
            err_str(c"' is not generic", pcx);
            err_end(&pcx);
        }
        pcx.nodes[n].x = g + 1;
        check_direct_call(n, g, &pcx)
    }
}

pub fn check_direct_call(n: i64, f: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        ensure_checked(f, n, &pcx);
        let count = pcx.nodes[n].count;
        let params = pcx.fns[f].param_count;
        let variadic = pcx.fns[f].variadic;
        let arity_ok = if variadic { count >= params } else { count == params };
        // (0.19: `vld1q_u8(p)`, a memory intrinsic called with a pointer)
        if !arity_ok && (pcx.nodes[pcx.fns[f].node].p & FN_INTRINSIC) != 0
            && check_raw_form(n, f, &pcx) {
            return pcx.fns[f].ret;
        }
        if !arity_ok {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"function '", pcx);
            err_sym(pcx.fns[f].display, pcx);
            err_str(c"' expects ", pcx);
            if variadic {
                err_str(c"at least ", pcx);
            }
            err_int(params, pcx);
            err_str(c" arguments, got ", pcx);
            err_int(count, pcx);
            if !variadic {
                arity_help(n, f, count, params, &pcx);
            }
            err_end(&pcx);
        }
        for i in 0..params {
            check_call_arg(child(n, i, pcx), f, i, &pcx);
        }
        check_call_safety(n, f, 0, &pcx);
        // (0.19: std::arch's immediates and feature names)
        if (pcx.nodes[pcx.fns[f].node].p & FN_INTRINSIC) != 0 {
            check_intrinsic_call(n, f, &pcx);
        }
        for i in params..count {
            let arg = child(n, i, pcx);
            let ty = synth_expr(arg, &pcx);
            if !is_variadic_arg_type(ty, pcx) {
                err_begin(pcx.nodes[arg].start, &pcx);
                err_str(c"cannot pass value of type '", pcx);
                err_type(ty, pcx);
                err_str(c"' as a variadic argument", pcx);
                err_end(&pcx);
            }
        }
        pcx.fns[f].ret
    }
}

fn path_target(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.nodes[n].y > 0 {
            // Made by the checker from a variant in scope.
            return pcx.nodes[n].y;
        }
        if pcx.nodes[n].y < 0 {
            // ... of a generic enum (0.6): its template.
            pcx.path_tpl = pcx.nodes[n].y;
            return -1;
        }
        let name = pcx.nodes[n].a;
        let member = pcx.nodes[n].b;
        var m = pcx.cur_mod;
        var b = 0;
        let segments = pcx.nodes[n].count;
        if segments > 0 {
            // `a::b::T::m` or `a::b::f`: the module of the next-to-last part.
            m = path_module(n, segments - 2, &pcx);
            b = lookup_name(m, name, pcx.cur_mod, &pcx);
            // (`a::m::f`: m is a reference to the module too)
            if binding_kind(b) == B_MODULE {
                qnote_module(pcx.nodes[child(n, segments - 2, pcx)].start, name, binding_value(b),
                    0, &pcx);
            }
        } else {
            if env_lookup(name, pcx) != 0 || pcx.sym_primitive[name] != 0
                || (name == pcx.self_type_sym && pcx.self_type != 0) {
                if pcx.nodes[n].g != 0 {
                    name_error(pcx.nodes[n].start, c"'", name, c"' takes no type arguments", &pcx);
                }
                return resolve_named(name, pcx.nodes[n].start, &pcx);
            }
            if name == pcx.sym_crate || name == pcx.self_sym || name == pcx.sym_super {
                m = if name == pcx.sym_crate { 0 } else if name == pcx.self_sym { pcx.cur_mod }
                    else { pcx.modules[pcx.cur_mod].parent };
                if m < 0 {
                    error_at(pcx.nodes[n].start, c"the root module has no 'super'", &pcx);
                }
                b = binding(B_MODULE, m);
            } else {
                b = lookup_name(m, name, pcx.cur_mod, &pcx);
                note_c_use(pcx.nodes[n].start, name, b, &pcx);
                if b == B_NONE && name == pcx.sym_std && pcx.std_module >= 0 {
                    b = binding(B_MODULE, pcx.std_module);
                }
                if b == B_NONE {
                    // (0.17) a module beside this one, else the root's, as
                    // a `use` path's first segment
                    let other = sibling_module(pcx.cur_mod, name, n, n, -1, &pcx);
                    if other >= 0 {
                        b = binding(B_MODULE, other);
                    }
                }
                if binding_kind(b) == B_MODULE {
                    qnote_module(pcx.nodes[n].start, name, binding_value(b), 0, &pcx);
                }
            }
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, pcx.nodes[n].start, name, &pcx);
        }
        if binding_kind(b) == B_MODULE {
            // `m::item`: the item, by key.
            let target = binding_value(b);
            let item = lookup_name(target, member, pcx.cur_mod, &pcx);
            if binding_kind(item) == B_PRIVATE {
                access_error(item, pcx.nodes[n].start, member, &pcx);
            }
            if binding_kind(item) == B_MODULE {
                name_error(pcx.nodes[n].start, c"'", member, c"' is a module, not a value", &pcx);
            }
            if binding_kind(item) == B_VARIANT {
                let v = binding_value(item);
                pcx.nodes[n].y = enum_type(pcx.variants[v].enum_id);
                pcx.nodes[n].count = 0;
                return pcx.nodes[n].y;
            }
            if binding_kind(item) != B_ITEM && target == pcx.c_module {
                // (`c::name`, through `import "h.h" as c;`)
                unknown_name_error(pcx.nodes[n].start, c"no declaration in the C headers named '",
                    member, &pcx);
            }
            if binding_kind(item) != B_ITEM && target != 0 {
                crate::front::conv::env_var_error(n, sym_text(pcx.modules[target].key),
                    sym_text(member), &pcx);
            }
            // (0.26.3: `env::get(name)`: `env::get_in(name, gpa)`)
            if binding_kind(item) != B_ITEM && target > 0 && binding_kind(lookup_name(target,
                crate::front::check::alloc_rules::in_name(member), pcx.cur_mod, &pcx)) == B_ITEM {
                let what = buf_new();
                buf_bytes(what, sym_text(pcx.modules[target].key));
                buf_str(what, c"::");
                buf_bytes(what, sym_text(member));
                crate::front::check::alloc_rules::no_in_error(n, member, buf_slice(what), &pcx);
            }
            if binding_kind(item) != B_ITEM {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"no '", pcx);
                err_sym(member, pcx);
                err_str(c"' in module '", pcx);
                if target == 0 {
                    err_str(c"crate", pcx);
                } else {
                    err_sym(pcx.modules[target].key, pcx);
                }
                err_str(c"'", pcx);
                // (0.25.2.2: the prelude's item, or another module's of std)
                crate::front::check::names::help_std_elsewhere(target, member, false,
                    pcx.std_module, pcx.cur_mod, BUFS[pcx.err_help].len > 0, &pcx);
                // (0.25.2.1: a function std has under another name)
                let syn = crate::front::check::names::std_synonym_help(SYMS[member].text);
                if crate::front::modules::within_std(target, pcx) && syn.len > 0 {
                    err_help_fmt(syn, pcx);
                }
                help_near_item(target, member, &pcx);
                err_end(&pcx);
            }
            pcx.nodes[n].kind = Ident;
            pcx.nodes[n].a = binding_value(item);
            pcx.nodes[n].p |= NODE_RESOLVED;
            pcx.nodes[n].g = pcx.nodes[n].h;
            pcx.nodes[n].count = 0;
            return -2;
        }
        if binding_kind(b) != B_ITEM {
            if segments == 0 && b == B_NONE {
                module_as_path_error(pcx.cur_mod, name, pcx.nodes[n].start, n, &pcx);
            }
            unknown_name_error(pcx.nodes[n].start, c"unknown type '", name, &pcx);
        }
        let key = binding_value(b);
        qnote(pcx.nodes[n].start, name, item_node_of(key, pcx), 0, &pcx);
        let tpl = template_of_key(key, pcx);
        if tpl != TPL_NONE {
            if pcx.nodes[n].g != 0 {
                let mark = TSCRATCH.count;
                push_written_targs(pcx.nodes[n].g, &pcx);
                return template_instance(tpl, mark, pcx.nodes[n].start, &pcx);
            }
            pcx.path_tpl = tpl;
            return -1;
        }
        // (0.18: `NonNull::new(p)`, a generic distinct type's function)
        let alias = pcx.sym_alias[key];
        if alias != 0 && pcx.nodes[alias].g != 0 && pcx.nodes[n].g == 0 && is_distinct(alias, pcx) {
            pcx.path_tpl = TPL_DISTINCT + alias;
            return -1;
        }
        if pcx.nodes[n].g != 0 {
            name_error(pcx.nodes[n].start, c"'", name, c"' is not generic", &pcx);
        }
        resolve_key(key, name, pcx.nodes[n].start, &pcx)
    }
}

// `T::m`: a variant without fields, or an associated function as a value.
pub fn synth_path(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let hint = hint_for(n, pcx);
        // (0.25.2.1) `f64::consts::PI`, `std::f32::consts::TAU`: no module
        let segs = pcx.nodes[n].count;
        if pcx.nodes[n].y == 0 && (segs == 3 || segs == 4) && sym_is_c(pcx.nodes[n].a, c"consts")
            && (segs == 3 || sym_is_c(pcx.nodes[child(n, 0, pcx)].a, c"std")) {
            let prim = pcx.nodes[child(n, segs - 3, pcx)].a;
            let ft = if sym_is_c(prim, c"f64") { TY_F64 } else if sym_is_c(prim, c"f32") { TY_F32 }
                else { 0 };
            if ft != 0 {
                let r = float_const(n, ft, pcx.nodes[n].b, true, &pcx);
                if r < 0 {
                    float_const_error(pcx.nodes[n].start, ft, pcx.nodes[n].b, true, &pcx);
                }
                return r;
            }
        }
        var t = path_target(n, &pcx);
        if t == -2 {
            return synth_expr(n, &pcx);
        }
        let member = pcx.nodes[n].b;
        if t == -1 {
            if pcx.path_tpl < 0 && template_variant_named(-pcx.path_tpl - 1, member, pcx) {
                pcx.hint_ty_path = hint;
                t = infer_enum(pcx.path_tpl, 0, member, 0, pcx.nodes[n].start, &pcx);
            } else {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"'", pcx);
                err_sym(template_name(pcx.path_tpl, pcx), pcx);
                err_str(c"' is generic: write its type arguments ('", pcx);
                err_sym(template_name(pcx.path_tpl, pcx), pcx);
                err_str(c"::<...>::", pcx);
                err_sym(member, pcx);
                err_str(c"')", pcx);
                err_end(&pcx);
            }
        }
        if TYPES[t].kind == TyKind::Enum {
            let v = find_variant(TYPES[t].a, member, pcx);
            if v >= 0 {
                if pcx.variants[v].field_count > 0 {
                    err_begin(pcx.nodes[n].start, &pcx);
                    err_str(c"variant '", pcx);
                    err_type(t, pcx);
                    err_str(c"::", pcx);
                    err_sym(member, pcx);
                    err_str(c"' has ", pcx);
                    err_int(pcx.variants[v].field_count, pcx);
                    err_str(if pcx.variants[v].field_count == 1 { c" field" } else { c" fields" },
                        pcx);
                    if has_named_fields(v, pcx) {
                        // (0.17)
                        positional_error(n, v, t, false, &pcx);
                    }
                    err_help(c"construct it with '", pcx);
                    buf_type(pcx.err_help, t, pcx);
                    err_help(c"::", pcx);
                    err_help_sym(member, pcx);
                    err_help(c"(...)'", pcx);
                    err_end(&pcx);
                }
                pcx.nodes[n].kind = VariantLit;
                pcx.nodes[n].a = v;
                pcx.nodes[n].count = 0;
                return t;
            }
        }
        var f = method_of(t, member, pcx);
        // (0.15: `i64::MAX`, `u8::MIN`, a literal)
        if f < 0 && is_integer(t) && (sym_is_c(member, c"MAX") || sym_is_c(member, c"MIN")) {
            return int_limit(n, t, sym_is_c(member, c"MAX"), &pcx);
        }
        // (0.25.2.1: `f64::EPSILON`, `f32::NAN`, a literal)
        if f < 0 && (t == TY_F32 || t == TY_F64) {
            let r = float_const(n, t, member, false, &pcx);
            if r >= 0 {
                return r;
            }
            if float_const_bits(t == TY_F32, member, true) != 0 {
                float_const_error(pcx.nodes[n].start, t, member, false, &pcx);
            }
        }
        if f < 0 {
            path_member_error(n, t, member, &pcx);
        }
        if pcx.fns[f].generic > 0 {
            if pcx.nodes[n].h == 0 && pcx.fns[f].generic > impl_param_count(f, pcx) {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"generic function '", pcx);
                err_sym(member, pcx);
                err_str(c"' needs its type arguments to be used as a value", pcx);
                err_end(&pcx);
            }
            let mark = TSCRATCH.count;
            bind_impl_params(f, t, &pcx);
            if pcx.nodes[n].h != 0 {
                push_written_targs(pcx.nodes[n].h, &pcx);
            }
            if TSCRATCH.count - mark != pcx.fns[f].generic {
                targ_count_error(pcx.nodes[n].start, c"function", pcx.fns[f].display,
                    pcx.fns[f].generic - impl_param_count(f, pcx),
                    TSCRATCH.count - mark - impl_param_count(f, pcx), &pcx);
            }
            f = fn_instance(f, mark, n, &pcx);
        }
        pcx.nodes[n].kind = Ident;
        pcx.nodes[n].a = pcx.fns[f].name;
        pcx.nodes[n].res = Res::Fn;
        pcx.nodes[n].y = f;
        pcx.nodes[n].count = 0;
        ensure_checked(f, n, &pcx);
        fn_value_type(f, pcx)
    }
}

// The number of a method template's parameters that are its impl's.
fn impl_param_count(f: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let item = pcx.fns[f].node;
        if pcx.nodes[item].h == 0 || pcx.nodes[item].g == 0 { 0 }
        else { pcx.nodes[pcx.nodes[item].g].a }
    }
}

// Pushes on TSCRATCH the arguments of t's template that a method
// template of it takes as its impl's parameters.
fn bind_impl_params(f: i64, t: i64, pcx: inout Ctx<Comp>) {
    let count = impl_param_count(f, pcx);
    if count == 0 {
        return;
    }
    let targs = instance_targs(t, &pcx);
    for i in 0..count {
        unsafe { TSCRATCH.push(TLISTS.data[targs + i]); }
    }
}

// `T::m(args)`: a variant with fields, or a call of an associated function
// (or of a method, with the receiver passed explicitly).
fn synth_path_call(n: i64, callee: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.nodes[callee].count == 0 && pcx.nodes[callee].y == 0
            && env_lookup(pcx.nodes[callee].a, pcx) == 0
            && is_vector(pcx.sym_primitive[pcx.nodes[callee].a]) {
            // `v4f32::splat(x)`, `v4f32::load(s, i)` (0.10).
            return vector_assoc_call(n, callee, pcx.sym_primitive[pcx.nodes[callee].a], &pcx);
        }
        var t = path_target(callee, &pcx);
        if t > 0 && is_vector(t) {
            // (0.19) through an alias: `uint8x16_t::from_bits(v)`
            return vector_assoc_call(n, callee, t, &pcx);
        }
        if t == -2 {
            // `m::f(args)`: a call of an item of a module.
            return synth_call(n, &pcx);
        }
        let member = pcx.nodes[callee].b;
        if pcx.nodes[callee].count == 0 && t >= 0 {
            let bp = bounded_param(pcx.nodes[callee].a, pcx);
            if bp != 0 {
                require_in_bounds(bp, member, pcx.nodes[callee].start, &pcx);
            }
        }
        if t == -1 {
            let tpl = pcx.path_tpl;
            if tpl < 0 && template_variant_named(-tpl - 1, member, pcx) {
                t = infer_enum(tpl, 0, member, n, pcx.nodes[callee].start, &pcx);
            } else {
                let f = find_generic_method(tpl, member, pcx);
                // (0.26.3: `W::scalar(x)`, which only `impl W<ScopedArena>`
                // has: that instance's, below)
                let inst = if f < 0 { sole_instance_with(tpl, member, pcx) } else { 0 };
                if inst > 0 {
                    t = inst;
                } else {
                    if f < 0 {
                        // (0.15: `W::from(x)`, a generic trait's impl for W)
                        let r = template_trait_call(n, tpl, member, &pcx);
                        if r >= 0 {
                            return r;
                        }
                        // (0.26.3: `Vec::new()`: `Vec::new_in(gpa)`)
                        if find_generic_method(tpl,
                            crate::front::check::alloc_rules::in_name(member), pcx)
                            >= 0 {
                            let what = buf_new();
                            buf_bytes(what, SYMS[template_name(tpl, pcx)].text);
                            buf_str(what, c"::");
                            buf_bytes(what, SYMS[member].text);
                            crate::front::check::alloc_rules::no_in_error(n, member,
                                buf_slice(what), &pcx);
                        }
                        err_begin(pcx.nodes[callee].start, &pcx);
                        err_str(c"no associated function '", pcx);
                        err_sym(member, pcx);
                        err_failed_name(member, pcx);
                        err_str(c"' in '", pcx);
                        err_sym(template_name(tpl, pcx), pcx);
                        err_str(c"'", pcx);
                        pcx.near_all.count = 0;
                        pcx.near_collect = true;
                        var near = near_to(member);
                        offer_template_methods(&near, tpl, false, &pcx);
                        pcx.near_collect = false;
                        near.help(&pcx);
                        if BUFS[pcx.err_help].len == 0 && pcx.near_all.count > 0 {
                            help_nearest(c"its nearest functions: ", member, pcx);
                        }
                        let a = buf_new();
                        buf_str(a, c"query items ");
                        let name = template_name(tpl, pcx);
                        buf_bytes(a, SYMS[name].text);
                        err_try_tool(buf_slice(a), true, pcx);
                        err_end(&pcx);
                    }
                    // `Vec::new()`: the type's arguments are inferred too.
                    normalize_args(n, f, 0, &pcx);
                    let g = instantiate_call(f, n, 0, 0, pcx.nodes[callee].h, &pcx);
                    pcx.nodes[n].x = g + 1;
                    return check_direct_call(n, g, &pcx);
                }
            }
        }
        if TYPES[t].kind == TyKind::Enum {
            let v = find_variant(TYPES[t].a, member, pcx);
            if v >= 0 {
                let count = pcx.variants[v].field_count;
                if (pcx.nodes[n].p & CALL_FIELDS) == 0 && has_named_fields(v, pcx) {
                    positional_error(n, v, t, false, &pcx);
                }
                if count == 0 {
                    err_begin(pcx.nodes[n].start, &pcx);
                    err_str(c"variant '", pcx);
                    err_type(t, pcx);
                    err_str(c"::", pcx);
                    err_sym(member, pcx);
                    err_str(c"' has no fields", pcx);
                    err_help(c"write it without parentheses", pcx);
                    err_end(&pcx);
                }
                if pcx.nodes[n].count != count {
                    err_begin(pcx.nodes[n].start, &pcx);
                    err_str(c"variant '", pcx);
                    err_type(t, pcx);
                    err_str(c"::", pcx);
                    err_sym(member, pcx);
                    err_str(c"' has ", pcx);
                    err_int(count, pcx);
                    err_str(if count == 1 { c" field" } else { c" fields" }, pcx);
                    err_str(c", got ", pcx);
                    err_int(pcx.nodes[n].count, pcx);
                    err_end(&pcx);
                }
                for i in 0..count {
                    check_arg(child(n, i, pcx), variant_field(v, i, pcx), &pcx);
                }
                pcx.nodes[n].kind = VariantLit;
                pcx.nodes[n].a = v;
                return t;
            }
        }
        var f = method_of(t, member, pcx);
        if f < 0 {
            // (0.15: `T::from(x)`, a function of a generic trait's impl)
            let r = generic_trait_call(n, t, member, &pcx);
            if r >= 0 {
                return r;
            }
            path_member_error(callee, t, member, &pcx);
        }
        normalize_args(n, f, 0, &pcx);
        if pcx.fns[f].generic > 0 {
            f = instantiate_call(f, n, 0, t, pcx.nodes[callee].h, &pcx);
        }
        pcx.nodes[n].x = f + 1;
        check_direct_call(n, f, &pcx)
    }
}

// (0.26.3) The one instance of template tpl whose impl has the function
// `name` (`impl W<ScopedArena> { fn scalar(..) }`, called `W::scalar(x)`);
// 0 when no instance's impl has it, or several have.
fn sole_instance_with(tpl: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    var found = 0;
    // UNSAFE: METHODS is the checker's raw table of methods.
    // SAFETY: i < METHOD_COUNT.
    unsafe {
        for i in 0..pcx.methods.len() as i64 {
            let t = pcx.methods[i].ty;
            if pcx.methods[i].name == name && t > 0 && t != found && instance_of(t, tpl, pcx) {
                if found != 0 {
                    return 0;
                }
                found = t;
            }
        }
    }
    found
}
