// Types of the declarations (the later phases of collect_phase): structs
// and enums that would contain themselves, function signatures (and the C
// FFI rules for `extern "C"` ones), statics and constants; and resolving
// a type as written (a name, a path, an alias, a generic instance) to a
// type.

use crate::base::{buf_fmt, buf_new, buf_slice, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_int, err_str,
    err_sym, err_try_fmt, error_count,
};
use crate::front::assoc::{is_projection_node, resolve_projection_node};
use crate::front::ast::{FN_SIG_FAILED, NODE_REF, NODE_REF_MUT, NodeKind, REPR_C, TY_OMEGA, child};
use crate::front::ast::NodeKind::{CStr, TyArray, TyName, TyNever, TyPtr, TySlice, TyTuple, TyUnit};
use crate::front::check::{Try, attempt, has_error_type, name_error, resolve_type_or_error};
use crate::front::check::distinct::distinct_of;
use crate::front::check::names::unknown_name_error;
use crate::front::closures::scoped::check_static_type;
use crate::front::consteval::{
    check_const_expr, const_emit, const_value, eval_array_len, has_const_call,
};
use crate::front::contracts::is_distinct;
use crate::front::generics::{
    TPL_NONE, env_lookup, required_targs, template_instance, template_of_key,
};
use crate::front::generics::instantiate::push_written_targs;
use crate::front::modules::module_of;
use crate::front::modules::lookup::{
    B_ITEM, B_MODULE, B_PRIVATE, access_error, binding_kind, binding_value, lookup_item,
    lookup_name, note_c_use, path_module,
};
use crate::front::types::{
    REF_MUT, REF_SHARED, TY_NEVER, TY_UNIT, TyKind, array_of, buf_type, enum_type, enum_variant,
    err_type, fn_param, is_ffi_field, is_ffi_safe, item_node_of, make_type, mut_slice_of, ptr_to,
    ref_to, slice_of, struct_field, struct_type, type_elem, variant_field,
};
use crate::tools::query::command_line::{qnote, qnote_self};

pub fn reset_layout_states(pcx: &mut Ctx<Comp>) {
    unsafe {
        for t in 0..pcx.structs.len() as i64 {
            pcx.structs[t as usize].layout_state = 0;
        }
        for t in 0..pcx.enum_count {
            (pcx.enums[t as usize]).layout_state = 0;
        }
    }
}

// Each struct or enum on a cycle of fields is reported, and the cycle is
// broken: its fields that hold it have the error type.
pub fn check_struct_cycles(pcx: &mut Ctx<Comp>) {
    unsafe {
        for s in 0..pcx.structs.len() as i64 {
            if pcx.structs[s as usize].generic == 0 {
                struct_cycle_error(s, pcx.nodes[pcx.structs[s as usize].node as usize].start, pcx);
            }
        }
        for e in 0..pcx.enum_count {
            if (pcx.enums[e as usize]).generic == 0 {
                enum_cycle_error(e, pcx.nodes[(pcx.enums[e as usize]).node as usize].start,
                    pcx);
            }
        }
    }
}

// Reports (at pos) that struct s holds itself through its fields, and
// breaks the cycle; whether it does.
pub fn struct_cycle_error(s: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut found = false;
        for i in 0..pcx.structs[s as usize].field_count {
            let field = struct_field(s, i, pcx);
            reset_layout_states(pcx);
            if holds(field.ty, s + 1, pcx) {
                let at = (pcx.structs[s as usize].fields + i) as usize;
                pcx.fields[at].ty = pcx.ty_error;
                found = true;
            }
        }
        reset_layout_states(pcx);
        if found {
            err_begin(pos, pcx);
            err_str(c"struct '", pcx);
            err_sym(pcx.structs[s as usize].name, pcx);
            err_str(
                c"' has infinite size due to recursive field (use a pointer to break the cycle)",
                pcx);
            err_end_soft(pcx);
        }
        found
    }
}

pub fn enum_cycle_error(e: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut found = false;
        for i in 0..(pcx.enums[e as usize]).variant_count {
            let v = enum_variant(e, i, pcx);
            for k in 0..pcx.variants[v as usize].field_count {
                reset_layout_states(pcx);
                if holds(variant_field(v, k, pcx), -(e + 1), pcx) {
                    (pcx.tlists[(pcx.variants[v as usize].fields + k) as usize]) = pcx.ty_error;
                    found = true;
                }
            }
        }
        reset_layout_states(pcx);
        if !found {
            return false;
        }
        // (the variants' shapes hold their field types)
        if (pcx.enums[e as usize]).has_fields {
            let repr_c = ((pcx.enums[e as usize]).repr & REPR_C) != 0;
            for i in 0..(pcx.enums[e as usize]).variant_count {
                let v = enum_variant(e, i, pcx);
                let mark = pcx.tscratch.len() as i64;
                if !repr_c {
                    pcx.tscratch.push((pcx.enums[e as usize]).tag);
                }
                for k in 0..pcx.variants[v as usize].field_count {
                    pcx.tscratch.push(variant_field(v, k, pcx));
                }
                pcx.variants[v as usize].shape = make_type(TyKind::Tuple, 0, 0, mark, pcx);
            }
        }
        err_begin(pos, pcx);
        err_str(c"enum '", pcx);
        err_sym((pcx.enums[e as usize]).name, pcx);
        err_str(c"' has infinite size due to a recursive field (use a pointer to break the cycle)",
            pcx);
        err_end_soft(pcx);
        true
    }
}

// Whether a value of type t holds the struct or enum `at` (struct s as
// s + 1, enum e as -(e + 1)); layout_state 2 marks the ones seen.
fn holds(t: i64, at: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if s + 1 == at {
                return true;
            }
            if pcx.structs[s as usize].layout_state != 0 {
                return false;
            }
            pcx.structs[s as usize].layout_state = 2;
            for i in 0..pcx.structs[s as usize].field_count {
                if holds((struct_field(s, i, pcx)).ty, at, pcx) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            if -(e + 1) == at {
                return true;
            }
            if (pcx.enums[e as usize]).layout_state != 0 {
                return false;
            }
            (pcx.enums[e as usize]).layout_state = 2;
            for i in 0..(pcx.enums[e as usize]).variant_count {
                let v = enum_variant(e, i, pcx);
                for k in 0..pcx.variants[v as usize].field_count {
                    if holds(variant_field(v, k, pcx), at, pcx) {
                        return true;
                    }
                }
            }
            return false;
        }
        if kind == TyKind::Array {
            return holds(pcx.types[t as usize].a, at, pcx);
        }
        if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if holds(type_elem(t, i, pcx), at, pcx) {
                    return true;
                }
            }
        }
        false
    }
}

pub fn collect_functions(pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].generic == 0 && pcx.fns[f as usize].tmpl == 0 {
            pcx.cur_mod = pcx.fns[f as usize].module;
            pcx.self_type = pcx.fns[f as usize].self_ty;
            pcx.self_impl = crate::front::traits::impl_of_fn(f, pcx);
            resolve_signature(f, pcx);
        }
    }
    pcx.self_type = 0;
    pcx.cur_mod = 0;
}

// The parameter and result types of function f.
// (A type that names nothing is the error type; 0.10. So are all of them
// for a function whose declaration failed.)
pub fn resolve_signature(f: i64, pcx: &mut Ctx<Comp>) {
    let item = pcx.fns[f as usize].node;
    let failed = (pcx.nodes[item as usize].p & FN_SIG_FAILED) != 0;
    let mark = pcx.tscratch.len() as i64;
    for i in 0..pcx.nodes[item as usize].count {
        let param = child(item, i, pcx);
        let name = pcx.nodes[param as usize].a;
        if name != pcx.underscore && !failed {
            for j in 0..i {
                if pcx.nodes[child(item, j, pcx) as usize].a == name {
                    err_begin(pcx.nodes[param as usize].start, pcx);
                    err_str(c"duplicate parameter '", pcx);
                    err_sym(name, pcx);
                    err_str(c"'", pcx);
                    err_end_soft(pcx);
                    break;
                }
            }
        }
        let mut ty = if failed { pcx.ty_error }
            else { resolve_type_or_error(pcx.nodes[param as usize].b, pcx) };
        // (0.20) a let parameter: a copy or a reference (front/conv)
        ty = crate::front::conv::param_type(param, ty, pcx);
        if pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export {
            crate::front::conv::extern_conv(param, pcx);
        }
        pcx.tscratch.push(ty);
    }
    // RULE: F21.2 (the rust edition: no parameter or result of an
    // unsized type)
    if !failed {
        for i in 0..pcx.nodes[item as usize].count {
            crate::front::check::rust::check_sized(pcx.nodes[child(item, i, pcx) as usize].b,
                c"a parameter", pcx);
        }
        crate::front::check::rust::check_sized(pcx.nodes[item as usize].b, c"a result", pcx);
    }
    pcx.fns[f as usize].params = pcx.tlists.len() as i64;
    pcx.fns[f as usize].param_count = pcx.tscratch.len() as i64 - mark;
    for i in mark..pcx.tscratch.len() as i64 {
        pcx.tlists.push((pcx.tscratch[i as usize]));
    }
    pcx.tscratch.truncate(mark as usize);
    pcx.fns[f as usize].ret = if failed {
        pcx.ty_error
    } else if pcx.nodes[item as usize].b == 0 {
        TY_UNIT
    } else if crate::front::opaque::is_opaque_node(pcx.nodes[item as usize].b, pcx) {
        // RULE: D21.1 (`-> impl Tr`: its opaque type, front/opaque.vl)
        crate::front::opaque::opaque_result(f, pcx)
    } else {
        resolve_type_or_error(pcx.nodes[item as usize].b, pcx)
    };
    // (0.24: a let parameter a view of which the result may hold is a
    // borrow, conv::let_by_ref)
    if !failed {
        for i in 0..pcx.fns[f as usize].param_count {
            let k = pcx.fns[f as usize].params + i;
            (pcx.tlists[k as usize]) = crate::front::conv::let_by_ref(child(item, i,
                pcx),
                (pcx.tlists[k as usize]), pcx.fns[f as usize].ret, pcx);
        }
    }
    if (pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export) && !failed {
        check_c_function(f, pcx);
    }
}

// The parameters and result of a function with C's convention must be
// FFI-safe (see is_ffi_safe).
fn check_c_function(f: i64, pcx: &mut Ctx<Comp>) {
    let item = pcx.fns[f as usize].node;
    for i in 0..pcx.fns[f as usize].param_count {
        let param = child(item, i, pcx);
        check_ffi_type(fn_param(f, i, pcx), pcx.nodes[param as usize].b, c"parameter", pcx);
    }
    let ret = pcx.fns[f as usize].ret;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, pcx.nodes[item as usize].b, c"result", pcx);
    }
}

fn check_c_signature(fn_ty: i64, n: i64, what: *mut u8, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.types[fn_ty as usize].count {
        check_ffi_type(type_elem(fn_ty, i, pcx), child(n, i, pcx), c"parameter", pcx);
    }
    let ret = pcx.types[fn_ty as usize].a;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, pcx.nodes[n as usize].a, c"result", pcx);
    }
}

fn check_ffi_type(t: i64, n: i64, what: *mut u8, pcx: &mut Ctx<Comp>) {
    if is_ffi_safe(t, pcx) || has_error_type(t, pcx) {
        return;
    }
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"type '", pcx);
    err_type(t, pcx);
    err_str(c"' of this ", pcx);
    err_str(what, pcx);
    err_str(c" cannot cross to C", pcx);
    let kind = pcx.types[t as usize].kind;
    if kind == TyKind::Struct || kind == TyKind::Enum {
        err_help(c"declare it #[repr(C)] (its layout is unspecified otherwise), with fields that can cross to C", pcx);
    } else if kind == TyKind::Fn {
        err_help(
            c"use an extern \"C\" fn type, and pass functions defined with extern \"C\" fn", pcx);
    } else if kind == TyKind::Slice {
        err_help(c"pass the pointer and the length (s.ptr, s.len)", pcx);
    } else if kind == TyKind::Tuple {
        err_help(c"use a #[repr(C)] struct", pcx);
    } else if kind == TyKind::Array {
        err_help(c"pass a pointer to its first element, or wrap it in a #[repr(C)] struct", pcx);
    }
    err_end_soft(pcx);
}

pub fn collect_statics(pcx: &mut Ctx<Comp>) {
    for s in 0..pcx.statics.len() as i64 {
        let item = pcx.statics[s as usize].node;
        pcx.cur_mod = module_of(item, pcx);
        let ty = resolve_type_or_error(pcx.nodes[item as usize].b, pcx);
        pcx.statics[s as usize].ty = ty;
        // (0.16: no scope's arena)
        if !check_static_type(ty, pcx.nodes[item as usize].a,
            pcx.nodes[pcx.nodes[item as usize].b as usize].start, pcx) {
            continue;
        }
        // A static shared with C is memory with C's layout: arrays of
        // FFI-safe types too (0.4).
        if pcx.statics[s as usize].linkage != 0 && !is_ffi_field(ty, pcx) {
            check_ffi_type(ty, pcx.nodes[item as usize].b, c"static", pcx);
        }
        if pcx.statics[s as usize].linkage == 1 || has_error_type(ty, pcx) {
            continue;
        }
        attempt(Try::Static, s, pcx);
    }
    pcx.cur_mod = 0;
}

// The initializer of static s.
pub fn check_static(s: i64, pcx: &mut Ctx<Comp>) {
    let item = pcx.statics[s as usize].node;
    let ty = pcx.statics[s as usize].ty;
    let init = pcx.nodes[item as usize].c;
    if pcx.types[ty as usize].kind == TyKind::Slice
        && pcx.nodes[init as usize].kind == NodeKind::Array {
        // (0.25.2.2, eval 0.25.2.1: sdftext) `static S: [f32] = [...];`:
        // the array, of the literal's length, as the fix
        let arr = buf_new();
        buf_str(arr, c"[");
        buf_type(arr, pcx.types[ty as usize].a, pcx);
        buf_fmt(arr, format_args("; {}]", pcx.nodes[init as usize].count));
        let name = sym_text(pcx.nodes[item as usize].a, pcx);
        err_begin(pcx.nodes[pcx.nodes[item as usize].b as usize].start, pcx);
        err_fmt({
            let name = str::from_utf8(name).unwrap();
            format_args("static '{name}' has slice type '")
        }, pcx);
        err_type(ty, pcx);
        err_fmt(format_args("': a static holds an array, of the literal's {} elements",
            pcx.nodes[init as usize].count), pcx);
        err_help_fmt(
            { let name = str::from_utf8(name).unwrap(); format_args(
                "`static {name}: {} = [...];` (`{name}[i]` reads one, `{name}[..]` is the slice)", str::from_utf8(buf_slice(arr)).unwrap()) }, pcx);
        err_fix(pcx.nodes[pcx.nodes[item as usize].b as usize].start,
            pcx.nodes[pcx.nodes[item as usize].b as usize].end, buf_slice(arr), pcx);
        err_end_soft(pcx);
        return;
    }
    let errors = error_count(pcx);
    check_const_expr(pcx.nodes[item as usize].c, ty, pcx);
    // (0.16: not after an error in it, a #[sealed] literal's)
    if error_count(pcx) != errors {
        return;
    }
    if pcx.nodes[pcx.nodes[item as usize].c as usize].kind == CStr {
        // A C string (0.4): the address of the literal.
        return;
    }
    // (0.16: a call of a constructor once its body is checked)
    if has_const_call(pcx.nodes[item as usize].c, pcx) {
        pcx.static_calls.push(s);
        return;
    }
    // Evaluated now to report non-constant initializers; the code
    // generator evaluates it again into the data section.
    let scratch = buf_new();
    const_emit(pcx.nodes[item as usize].c, ty, scratch, pcx);
}

// The initializers that call constructors, evaluated (to report what is
// not constant) once every function body is checked.
pub fn check_static_calls(pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.static_calls.len() as i64 {
        attempt(Try::StaticCall, (pcx.static_calls[i as usize]), pcx);
    }
    pcx.static_calls.clear();
}

// The value of static s's initializer, which calls a constructor.
pub fn static_call_value(s: i64, pcx: &mut Ctx<Comp>) {
    let scratch = buf_new();
    const_emit(pcx.nodes[pcx.statics[s as usize].node as usize].c, pcx.statics[s as usize].ty,
        scratch, pcx);
}

pub fn evaluate_consts(pcx: &mut Ctx<Comp>) {
    pcx.cur_mod = 0;
    for c in 0..pcx.consts.len() as i64 {
        // RULE: F34.2 (one made at each use: checked there)
        if pcx.consts[c as usize].state != 3 {
            const_value(c, pcx);
        }
    }
}

// ---- Resolving types ----

// RULE: F6.1 (0.27.2) Whether type node t is `Self` of an impl whose self
// type is written as a reference to a view, `impl Tr for &'a str`: its
// `&mut self` is a `&mut &str`, not a `&mut str`.
fn self_node_is_view_ref(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || pcx.nodes[t as usize].kind != TyName
        || sym_text(pcx.nodes[t as usize].a, pcx) != b"Self"
        || pcx.self_impl < 0 || pcx.self_impl >= pcx.traits_impls.len() as i64 {
        return false;
    }
    let h = pcx.nodes[pcx.traits_impls[pcx.self_impl as usize].node as usize].b;
    h > 0 && crate::base::get_src()[pcx.nodes[h as usize].start as usize] == b'&'
}

// RULE: Z9.1, FL10 (0.27.3) Whether type node t is written as a reference
// to a view, `&[T]`, `&'a str`, is `Self` of an impl whose self type is
// (`impl Read for &[u8]`), or is a Sized type parameter (`R` of `fn fill<R:
// Read>(r: &mut R)`, R = `&[u8]`): `&mut` of it is a reference to the view.
fn view_ref_node(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let k = pcx.nodes[t as usize].kind;
    (k == TySlice || k == TyName && sym_text(pcx.nodes[t as usize].a, pcx) == b"str")
        && crate::base::get_src()[pcx.nodes[t as usize].start as usize] == b'&'
        || k == NodeKind::TyPtr && (pcx.nodes[t as usize].p & NODE_REF) != 0
        && (pcx.nodes[t as usize].p & NODE_REF_MUT) == 0
        && written_unsized(pcx.nodes[t as usize].a, pcx)
        || self_node_is_view_ref(t, pcx) || sized_param_node(t, pcx)
}

// RULE: F21.1, FL10 (0.27.3) Whether type node t names a type parameter in
// scope that is Sized (not `?Sized`): a view it stands for is `&[T]` or
// `&str`, never the unsized `[T]` or `str`.
fn sized_param_node(t: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[t as usize].kind != TyName || pcx.nodes[t as usize].count != 0
        || pcx.nodes[t as usize].g != 0
        || crate::front::generics::env_lookup(pcx.nodes[t as usize].a, pcx) == 0 {
        return false;
    }
    let p = crate::front::generics::env_param_node(pcx.nodes[t as usize].a, pcx);
    p > 0 && (pcx.nodes[p as usize].p & crate::front::ast::TY_MAYBE_UNSIZED) == 0
}

// RULE: Z9.3 (0.27.2) Whether type node t writes an unsized type itself,
// `[T]` or `str` (not a parameter or `Self` that stands for one).
pub fn written_unsized(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && (pcx.nodes[t as usize].kind == TySlice
        || pcx.nodes[t as usize].kind == TyName && pcx.nodes[t as usize].count == 0
        && pcx.nodes[t as usize].g == 0 && sym_text(pcx.nodes[t as usize].a, pcx) == b"str")
}

// RULE: Z9.1c (0.27.4) `&X`, `&mut X`, `*const X`/`*mut X` (TyPtr n) of the
// rust edition with X resolved to inner: of the unsized place `[T]`/`str`
// today's view forms (the view, the exclusive view, the fat raw pointer);
// of anything else, a view too, a pointer to it (`&&str` thin).
fn z91c_pointer(n: i64, inner: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let is_ref = (pcx.nodes[n as usize].p & NODE_REF) != 0;
    let mutable = (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0;
    if crate::front::types::is_unsized_place(inner, pcx) {
        let v = pcx.types[inner as usize].a;
        if is_ref && mutable {
            return if pcx.types[v as usize].kind
                == TyKind::Slice { mut_slice_of(pcx.types[v as usize].a, pcx) }
                else { crate::front::types::mut_view_of(v, pcx) };
        }
        if is_ref {
            return v;
        }
        return crate::front::types::raw_view_of(v, pcx);
    }
    if is_ref {
        return ref_to(inner, if mutable { REF_MUT } else { REF_SHARED }, pcx);
    }
    ptr_to(inner, pcx)
}

// RULE: Z9.1c (0.27.4) Whether type node n, of a rust-edition position,
// writes the unsized place itself: `[T]` or `str` as written, not folded
// into a `&` (the parser's `&[T]` is the TySlice from the `&`); a
// generated item's nodes, spanning its attribute, are the view, as
// check_sized reads them.
pub fn z91c_place_node(n: i64, pcx: &Ctx<Comp>) -> bool {
    if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0 {
        return false;
    }
    let written = &get_src()[
        pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
    if pcx.nodes[n as usize].kind == NodeKind::TySlice {
        return written.len() > 0 && written[0] == b'[';
    }
    written == b"str"
}

pub fn resolve_type(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = pcx.nodes[n as usize].kind;
    match kind {
        TyName => {
            // RULE: D22.1 (an opaque type parameter Ω's node, front/opaque.vl)
            if (pcx.nodes[n as usize].p & TY_OMEGA) != 0 {
                return pcx.nodes[n as usize].z;
            }
            // RULE: F18.6 (0.27.4: `_` written in a type, `let f: FromFn<_>
            // = ..`, in a rust-edition function being checked: a type
            // variable)
            if pcx.nodes[n as usize].a == pcx.underscore && pcx.nodes[n as usize].count == 0
                && pcx.nodes[n as usize].g == 0
                && crate::front::check::infer::can_defer(pcx.nodes[n as usize].start, pcx) {
                return crate::front::check::infer::hole(n, pcx);
            }
            let t = resolve_type_name(n, pcx);
            // RULE: Z9.1c (0.27.4: a bare `str`, the unsized place)
            if crate::front::distinct::is_view_distinct(t, pcx)
                && !crate::front::types::is_mut_slice(t, pcx)
                && !crate::front::types::is_raw_view(t, pcx) && z91c_place_node(n, pcx)
                && sym_text(pcx.nodes[n as usize].a, pcx) == b"str" {
                return crate::front::types::unsized_of(t, pcx);
            }
            // RULE: F0.1 (0.27.2: `&mut str`, the parser's str TyName
            // flagged)
            if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0
                && crate::front::distinct::is_view_distinct(t, pcx) {
                return crate::front::types::mut_view_of(t, pcx);
            }
            return t;
        }
        TyUnit => return TY_UNIT,
        TyNever => return TY_NEVER,
        TyPtr => {
            // (0.17: `&T`, `&mut T`)
            let inner = resolve_type(pcx.nodes[n as usize].a, pcx);
            if inner > 0 {
                return z91c_pointer(n, inner, pcx);
            }
            if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0 {
                // (0.27.0: `&mut Self` of a view, as `&mut [T]` and
                // `&mut str` are written)
                // (0.27.2: not of a `&mut [T]` itself, a T or Self that
                // stands for one: `&mut T` is then a reference to it,
                // `mem::replace(&mut self.v, ..)` of IterMut's)
                // RULE: Z9.1, FL10 (0.27.3: `&mut` of a view written as a
                // reference, `&mut &[u8]`, `&mut self` of `impl Tr for
                // &[T]` or `&str`: a reference to the view, its place)
                if inner > 0 && view_ref_node(pcx.nodes[n as usize].a, pcx)
                    && (pcx.types[inner as usize].kind == TyKind::Slice
                        && pcx.types[inner as usize].b == 0
                        || crate::front::distinct::is_view_distinct(inner, pcx)
                        && !crate::front::types::is_mut_slice(inner, pcx)) {
                    return ref_to(inner, REF_MUT, pcx);
                }
                if inner > 0
                    && pcx.types[inner as usize].kind == TyKind::Slice
                    && pcx.types[inner as usize].b == 0 {
                    return mut_slice_of(pcx.types[inner as usize].a, pcx);
                }
                // RULE: F0.1 (0.27.2: `&mut str` keeps its mutability, the
                // str over an exclusive slice)
                if crate::front::distinct::is_view_distinct(inner, pcx)
                    && !crate::front::types::is_mut_slice(inner, pcx) {
                    // (`&mut self` of `impl Tr for &'a str`: a `&mut
                    // &str`, the view itself until Z9.1)
                    if self_node_is_view_ref(pcx.nodes[n as usize].a, pcx) {
                        return inner;
                    }
                    return crate::front::types::mut_view_of(inner, pcx);
                }
                return ref_to(inner, REF_MUT, pcx);
            }
            if (pcx.nodes[n as usize].p & NODE_REF) != 0 {
                // (0.27.0) in the rust edition, `&Self` or `&T` of a view
                // (str, a slice) is the view, as `&str` and `&[T]` are
                // written: `impl PartialEq for str`'s `other: &str`
                if inner > 0
                    && (pcx.types[inner as usize].kind == TyKind::Slice
                        || crate::front::distinct::is_view_distinct(inner, pcx)) {
                    return inner;
                }
                return ref_to(inner, REF_SHARED, pcx);
            }
            // RULE: Z9.3 (0.27.2: in the rust edition `*const [T]`, `*mut
            // [T]`, `*const str` keep both words, a fat raw pointer)
            // (a pointer to a reference, `*const &[T]`, stays thin)
            // (0.27.2: only a pointee written `[T]` or `str`: a `*const T`
            // with T a view, `Vec<&str>`'s, points to the view, thin,
            // until Z9.1 tells `&str` from `str`)
            if inner > 0
                && pcx.nodes[pcx.nodes[n as usize].a as usize].kind != TyPtr
                && written_unsized(pcx.nodes[n as usize].a, pcx)
                && (pcx.types[inner as usize].kind == TyKind::Slice
                    && pcx.types[inner as usize].b == 0
                    || crate::front::distinct::is_view_distinct(inner, pcx)
                    && !crate::front::types::is_raw_view(inner, pcx)) {
                return crate::front::types::raw_view_of(inner, pcx);
            }
            return ptr_to(inner, pcx);
        }
        TySlice => {
            let elem = resolve_type(pcx.nodes[n as usize].a, pcx);
            if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0 {
                return mut_slice_of(elem, pcx);
            }
            // RULE: Z9.1c (0.27.4: a bare `[T]`, the unsized place)
            if z91c_place_node(n, pcx) {
                let v = slice_of(elem, pcx);
                return crate::front::types::unsized_of(v, pcx);
            }
            return slice_of(elem, pcx);
        }
        TyArray => {
            let elem = resolve_type(pcx.nodes[n as usize].a, pcx);
            return array_of(elem, eval_array_len(pcx.nodes[n as usize].b, pcx), pcx);
        }
        _ => {}
    }
    // A tuple or a function type: the element types first.
    let mark = pcx.tscratch.len() as i64;
    for i in 0..pcx.nodes[n as usize].count {
        let mut elem = resolve_type(child(n, i, pcx), pcx);
        if kind == NodeKind::TyFn {
            // (0.20) `fn(let T)`, `Fn(let T)`: a let parameter, a copy
            // or a reference by T (front/conv)
            elem = crate::front::conv::fn_type_param(child(n, i, pcx), elem, pcx);
        }
        pcx.tscratch.push(elem);
    }
    if kind == TyTuple {
        return make_type(TyKind::Tuple, 0, 0, mark, pcx);
    }
    let result = resolve_type(pcx.nodes[n as usize].a, pcx);
    // (0.24: as a function's, conv::let_by_ref; not a `sink T`)
    for i in 0..pcx.nodes[n as usize].count {
        if (pcx.nodes[child(n, i, pcx) as usize].p & crate::front::ast::CONV_SINK) == 0
            && pcx.nodes[n as usize].d == 0 {
            (pcx.tscratch[(mark + i) as usize]) = crate::front::conv::let_by_ref(0,
                (pcx.tscratch[(mark + i) as usize]), result, pcx);
        }
    }
    // RULE: F19.3 (`unsafe fn(..)`, `unsafe extern "C" fn(..)`: the
    // parser marks the node in a rust-edition position only)
    let unsafe_bit: i64 = if (pcx.nodes[n as usize].p & crate::front::ast::ITEM_UNSAFE) != 0 {
        crate::front::types::FN_TY_UNSAFE
    } else {
        0
    };
    let fn_ty = make_type(TyKind::Fn, result, pcx.nodes[n as usize].d | unsafe_bit, mark, pcx);
    if pcx.nodes[n as usize].d != 0 {
        check_c_signature(fn_ty, n, c"an extern \"C\" fn type", pcx);
    }
    fn_ty
}

// A named type: a type parameter, a primitive, `Self`, or a struct, enum
// or alias (through the module path in its list, if any; an instance of a
// generic one with the arguments in its `g`).
fn resolve_type_name(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let name = pcx.nodes[n as usize].a;
    let g = pcx.nodes[n as usize].g;
    // RULE: F8.1, F11.3 (0.27.2: `<X as Tr>::A`, the A of X's impl of Tr)
    if (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0 {
        return qualified_projection(n, pcx);
    }
    // (0.14: `T::Item`, `Self::Item`)
    if pcx.nodes[n as usize].count != 0 && is_projection_node(n, pcx) {
        return resolve_projection_node(n, pcx);
    }
    if pcx.nodes[n as usize].count == 0 {
        let param = env_lookup(name, pcx);
        if param != 0 {
            if g != 0 {
                name_error(pcx.nodes[n as usize].start, c"type parameter '", name,
                    c"' takes no type arguments", pcx);
            }
            return param;
        }
        if g == 0 {
            return resolve_named(name, pcx.nodes[n as usize].start, pcx);
        }
    }
    let key = type_name_key(n, pcx);
    if key < 0 {
        // (0.25.2.2) a module of constants: their type
        let mb = lookup_name(
            if pcx.nodes[n as usize].count
                > 0 { path_module(n, pcx.nodes[n as usize].count, pcx) }
            else { pcx.cur_mod },
            name, pcx.cur_mod, pcx);
        if binding_kind(mb) == B_MODULE {
            let tb = buf_new();
            let mut cname: &[u8] = b"";
            for c in 0..pcx.consts.len() as i64 {
                if module_of(pcx.consts[c as usize].node, pcx) == binding_value(mb)
                    && pcx.consts[c as usize].ty > 0 {
                    buf_type(tb, pcx.consts[c as usize].ty, pcx);
                    cname = sym_text(pcx.nodes[pcx.consts[c as usize].node as usize].a, pcx);
                    break;
                }
            }
            module_type_error(pcx.nodes[n as usize].start, name, cname, buf_slice(tb), pcx);
        }
        unknown_name_error(pcx.nodes[n as usize].start, c"unknown type '", name, pcx);
    }
    let tpl = template_of_key(key, pcx);
    if tpl != TPL_NONE {
        // (0.16: `Buf`, every parameter with a default)
        if g == 0 && required_targs(tpl, pcx) > 0
            && !crate::front::check::alloc_rules::bare_allocator_only(tpl, pcx) {
            err_begin(pcx.nodes[n as usize].start, pcx);
            err_str(c"'", pcx);
            err_sym(name, pcx);
            err_str(c"' is generic: write its type arguments ('", pcx);
            err_sym(name, pcx);
            err_str(c"<...>')", pcx);
            err_end(pcx);
        }
        let mark = pcx.tscratch.len() as i64;
        if g != 0 {
            push_written_targs(g, pcx);
        }
        return template_instance(tpl, mark, pcx.nodes[n as usize].start, pcx);
    }
    if g != 0 && (pcx.sym_alias[key as usize]) != 0
        && pcx.nodes[(pcx.sym_alias[key as usize]) as usize].g != 0 {
        return generic_alias(key, g, pcx.nodes[n as usize].start, pcx);
    }
    if g != 0 {
        name_error(pcx.nodes[n as usize].start, c"'", name, c"' is not generic", pcx);
    }
    resolve_key(key, name, pcx.nodes[n as usize].start, pcx)
}

// (0.27.2) `<X as Tr>::A` (TyName n flagged NODE_QPATH): the associated
// type A of X's impl of Tr; an error when X has none. RULE: F8.1, F11.3
fn qualified_projection(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let t = resolve_type(child(n, 0, pcx), pcx);
    if has_error_type(t, pcx) {
        return pcx.ty_error;
    }
    let tr = crate::front::traits::bound_trait(pcx.nodes[n as usize].c, pcx);
    if tr < 0 {
        return pcx.ty_error;
    }
    // RULE: F8.1, F14.1 (0.27.4: the trait written with its arguments,
    // `<I as SliceIndex<[i64]>>::Output`: the impl they name)
    let tn = pcx.nodes[n as usize].c;
    let with: i64 = if pcx.nodes[tn as usize].kind == NodeKind::TyName
        && pcx.nodes[tn as usize].g != 0
        && !crate::front::opaque::is_omega(t, pcx) {
        crate::front::assoc::trait_projection_with(tr, t, crate::front::convert::bound_args(tn,
            pcx), pcx.nodes[n as usize].a, pcx.nodes[n as usize].start, pcx)
    } else {
        0
    };
    // (else as before: the impl of tr for t, whatever its arguments)
    let r = if with != 0 { with }
        else {
            crate::front::assoc::trait_projection(tr, t, pcx.nodes[n as usize].a,
                pcx.nodes[n as usize].start, pcx)
        };
    if r != 0 {
        return r;
    }
    // (X written with a parameter, `<I::Item as IntoIterator>::IntoIter`
    // in an instance whose argument has no such impl: the instance's
    // `where` bound fails, which its use reports (F10.2); a field of a
    // struct made for a default method's signature is never read)
    if crate::front::coherence::mentions_param(child(n, 0, pcx), pcx) {
        return pcx.ty_error;
    }
    let saved_kind = pcx.err_kind;
    pcx.err_kind = c"trait.unmet";
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"'", pcx);
    err_type(t, pcx);
    err_fmt(format_args("' has no impl of '{}' that defines '{}'",
        str::from_utf8(sym_text(pcx.traits[tr as usize].name, pcx)).unwrap(),
        str::from_utf8(sym_text(pcx.nodes[n as usize].a, pcx)).unwrap()), pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved_kind;
    pcx.ty_error
}

// `Pair<i64>` of a generic alias (0.6): its type with its parameters bound
// to the arguments written in `g` (resolved here), in its own module.
fn generic_alias(key: i64, g: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let alias = (pcx.sym_alias[key as usize]);
    let params = pcx.nodes[alias as usize].g;
    if pcx.nodes[g as usize].count != pcx.nodes[params as usize].count {
        err_begin(pos, pcx);
        err_str(c"type alias '", pcx);
        err_sym(pcx.nodes[alias as usize].a, pcx);
        err_str(c"' takes ", pcx);
        err_int(pcx.nodes[params as usize].count, pcx);
        err_str(if pcx.nodes[params as usize].count == 1 { c" type argument, got " }
            else { c" type arguments, got " }, pcx);
        err_int(pcx.nodes[g as usize].count, pcx);
        err_end(pcx);
    }
    if (pcx.alias_busy[key as usize]) != 0 {
        name_error(pos, c"type alias '", pcx.nodes[alias as usize].a,
            c"' is defined in terms of itself", pcx);
    }
    let mark = pcx.tscratch.len() as i64;
    push_written_targs(g, pcx);
    let saved = pcx.tp_base;
    let saved_mod = pcx.cur_mod;
    pcx.tp_base = pcx.tp_names.len() as i64;
    for i in 0..pcx.nodes[params as usize].count {
        pcx.tp_names.push(pcx.nodes[child(params, i, pcx) as usize].a);
        pcx.tp_types.push((pcx.tscratch[(mark + i) as usize]));
    }
    pcx.tscratch.truncate(mark as usize);
    pcx.cur_mod = module_of(alias, pcx);
    (pcx.alias_busy[key as usize]) = 1;
    let mut t = resolve_type_or_error(pcx.nodes[alias as usize].b, pcx);
    // (0.18: a generic distinct type, its arguments part of it)
    if is_distinct(alias, pcx) {
        let targs = pcx.tscratch.len() as i64;
        for i in 0..pcx.nodes[params as usize].count {
            pcx.tscratch.push((pcx.tp_types[(pcx.tp_base + i) as usize]));
        }
        t = distinct_of(alias, t, targs, pcx);
    }
    (pcx.alias_busy[key as usize]) = 0;
    pcx.cur_mod = saved_mod;
    pcx.tp_names.truncate(pcx.tp_base as usize);
    pcx.tp_types.truncate(pcx.tp_base as usize);
    pcx.tp_base = saved;
    t
}

// The key a TyName names (through its module path), or -1.
pub fn type_name_key(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let name = pcx.nodes[n as usize].a;
    let mut m = pcx.cur_mod;
    let mut b: i64 = 0;
    if pcx.nodes[n as usize].count > 0 {
        m = path_module(n, pcx.nodes[n as usize].count, pcx);
        b = lookup_name(m, name, pcx.cur_mod, pcx);
    } else {
        if (pcx.sym_primitive[name as usize]) != 0
            || (name == pcx.self_type_sym && pcx.self_type != 0) {
            return -1;
        }
        b = lookup_item(m, name, pcx.cur_mod, pcx);
        note_c_use(pcx.nodes[n as usize].start, name, b, pcx);
    }
    if binding_kind(b) == B_PRIVATE {
        access_error(b, pcx.nodes[n as usize].start, name, pcx);
    }
    if binding_kind(b) != B_ITEM {
        return -1;
    }
    let key = binding_value(b);
    qnote(pcx.nodes[n as usize].start, name, item_node_of(key, pcx), 0, pcx);
    key
}

pub fn resolve_named(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let param = env_lookup(name, pcx);
    if param != 0 {
        return param;
    }
    if (pcx.sym_primitive[name as usize]) != 0 {
        return (pcx.sym_primitive[name as usize]);
    }
    if name == pcx.self_type_sym && pcx.self_type != 0 {
        qnote_self(pos, name, pcx.self_type, pcx);
        return pcx.self_type;
    }
    let b = lookup_item(pcx.cur_mod, name, pcx.cur_mod, pcx);
    note_c_use(pos, name, b, pcx);
    if binding_kind(b) == B_PRIVATE {
        access_error(b, pos, name, pcx);
    }
    if binding_kind(b) != B_ITEM {
        // (0.25.2.2) a module of constants: their type
        let mb = lookup_name(pcx.cur_mod, name, pcx.cur_mod, pcx);
        if binding_kind(mb) == B_MODULE {
            let tb = buf_new();
            let mut cname: &[u8] = b"";
            for c in 0..pcx.consts.len() as i64 {
                if module_of(pcx.consts[c as usize].node, pcx) == binding_value(mb)
                    && pcx.consts[c as usize].ty > 0 {
                    buf_type(tb, pcx.consts[c as usize].ty, pcx);
                    cname = sym_text(pcx.nodes[pcx.consts[c as usize].node as usize].a, pcx);
                    break;
                }
            }
            module_type_error(pos, name, cname, buf_slice(tb), pcx);
        }
        unknown_name_error(pos, c"unknown type '", name, pcx);
    }
    let key = binding_value(b);
    qnote(pos, name, item_node_of(key, pcx), 0, pcx);
    let tpl = template_of_key(key, pcx);
    // (0.16: `Buf` is `Buf<Gpa>`, every parameter has a default)
    if tpl != TPL_NONE && (required_targs(tpl, pcx) == 0
        || crate::front::check::alloc_rules::bare_allocator_only(tpl, pcx)) {
        return template_instance(tpl, pcx.tscratch.len() as i64, pos, pcx);
    }
    if tpl != TPL_NONE {
        err_begin(pos, pcx);
        err_str(c"'", pcx);
        err_sym(name, pcx);
        err_str(c"' is generic: write its type arguments ('", pcx);
        err_sym(name, pcx);
        err_str(c"<...>')", pcx);
        err_end(pcx);
    }
    resolve_key(key, name, pos, pcx)
}

// (0.25.2.2, eval 0.25.2.1: cloth) A type that names a module (`u:
// gpu::BufferUsage`): when the module holds constants (std::gpu's
// BufferUsage, u32 flags: one is `cname`, of type `ct`), their type is the
// type meant.
fn module_type_error(pos: i64, name: i64, cname: &[u8], ct: &[u8], pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pos, pcx);
    err_str(c"unknown type '", pcx);
    err_sym(name, pcx);
    err_str(c"'", pcx);
    let t = sym_text(name, pcx);
    if ct.len() > 0 {
        err_help_fmt(
            { let t = str::from_utf8(t).unwrap(); { let cname = str::from_utf8(cname).unwrap(); { let ct = str::from_utf8(ct).unwrap(); format_args("'{t}' is a module of constants, not a type: its constants ('{t}::{cname}', ...) are '{ct}', so a value of them is a '{ct}' (`x: {ct}`)") } } }, pcx);
        err_try_fmt(str::from_utf8(ct).unwrap(), pcx);
    } else {
        err_help_fmt({
            let t = str::from_utf8(t).unwrap();
            format_args("'{t}' is a module, not a type: its items are `{t}::NAME`")
        }, pcx);
    }
    err_end(pcx)
}

// The struct, enum or alias with key `key`.
pub fn resolve_key(key: i64, name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if (pcx.sym_struct[key as usize]) != 0 {
        return struct_type((pcx.sym_struct[key as usize]) - 1, pcx);
    }
    if (pcx.sym_enum[key as usize]) != 0 {
        return enum_type((pcx.sym_enum[key as usize]) - 1, pcx);
    }
    if (pcx.sym_alias[key as usize]) == 0 {
        if (pcx.sym_trait[key as usize]) != 0 {
            name_error(pos, c"'", name, c"' is a trait, not a type (no trait objects: use a type parameter bounded by it, 'T: Trait')", pcx);
        }
        unknown_name_error(pos, c"unknown type '", name, pcx);
    }
    resolve_alias(key, pos, pcx)
}

pub fn resolve_alias(key: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if (pcx.alias_type[key as usize]) != 0 {
        return (pcx.alias_type[key as usize]);
    }
    let alias = (pcx.sym_alias[key as usize]);
    if pcx.nodes[alias as usize].g != 0 {
        err_begin(pos, pcx);
        err_str(c"type alias '", pcx);
        err_sym(pcx.nodes[alias as usize].a, pcx);
        err_str(c"' is generic: write its type arguments ('", pcx);
        err_sym(pcx.nodes[alias as usize].a, pcx);
        err_str(c"<...>')", pcx);
        err_end(pcx);
    }
    if (pcx.alias_busy[key as usize]) != 0 {
        name_error(pos, c"type alias '", pcx.nodes[alias as usize].a,
            c"' is defined in terms of itself", pcx);
    }
    (pcx.alias_busy[key as usize]) = 1;
    let saved = pcx.cur_mod;
    pcx.cur_mod = module_of(alias, pcx);
    let mut resolved = resolve_type_or_error(pcx.nodes[alias as usize].b, pcx);
    // (0.18: `type X = distinct T`, a type of its own)
    if is_distinct(alias, pcx) {
        resolved = distinct_of(alias, resolved, pcx.tscratch.len() as i64, pcx);
    }
    pcx.cur_mod = saved;
    (pcx.alias_busy[key as usize]) = 0;
    (pcx.alias_type[key as usize]) = resolved;
    resolved
}
