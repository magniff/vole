// Types of the declarations (the later phases of collect_phase): structs
// and enums that would contain themselves, function signatures (and the C
// FFI rules for `extern "C"` ones), statics and constants; and resolving
// a type as written (a name, a path, an alias, a generic instance) to a
// type.

use crate::base::{buf_fmt, buf_new, buf_slice, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_int, err_str,
    err_sym, err_try_fmt, error_count,
};
use crate::front::assoc::{is_projection_node, resolve_projection_node};
use crate::front::ast::{FN_SIG_FAILED, NODE_REF, NODE_REF_MUT, NodeKind, REPR_C, child};
use crate::front::ast::NodeKind::{CStr, TyArray, TyName, TyNever, TyPtr, TySlice, TyTuple, TyUnit};
use crate::front::check::{Try, attempt, has_error_type, name_error, resolve_type_or_error};
use crate::front::check::args::check_param_defaults;
use crate::front::check::distinct::distinct_of;
use crate::front::check::names::unknown_name_error;
use crate::front::closures::scoped::check_static_type;
use crate::front::consteval::{
    check_const_expr, const_emit, const_value, eval_array_len, has_const_call,
};
use crate::front::contracts::is_distinct;
use crate::front::generics::{
    TPL_NONE, env_lookup, required_targs, template_instance, template_of_key,
};
use crate::front::generics::instantiate::push_written_targs;
use crate::front::modules::module_of;
use crate::front::modules::lookup::{
    B_ITEM, B_MODULE, B_PRIVATE, access_error, binding_kind, binding_value, lookup_item,
    lookup_name, note_c_use, path_module,
};
use crate::front::types::{
    ENUMS, REF_MUT, REF_SHARED, TY_NEVER, TY_UNIT, TyKind, array_of, buf_type, enum_type,
    enum_variant, err_type, fn_param, is_ffi_field, is_ffi_safe, item_node_of, make_type,
    mut_slice_of, ptr_to, ref_to, slice_of, struct_field, struct_type, type_elem, variant_field,
};
use crate::tools::query::command_line::{qnote, qnote_self};

pub fn reset_layout_states(pcx: inout Ctx<Comp>) {
    unsafe {
        for t in 0..pcx.structs.len() as i64 {
            pcx.structs[t].layout_state = 0;
        }
        for t in 0..pcx.enum_count {
            ENUMS[t].layout_state = 0;
        }
    }
}

// Each struct or enum on a cycle of fields is reported, and the cycle is
// broken: its fields that hold it have the error type.
pub fn check_struct_cycles(pcx: inout Ctx<Comp>) {
    unsafe {
        for s in 0..pcx.structs.len() as i64 {
            if pcx.structs[s].generic == 0 {
                struct_cycle_error(s, pcx.nodes[pcx.structs[s].node].start, &pcx);
            }
        }
        for e in 0..pcx.enum_count {
            if ENUMS[e].generic == 0 {
                enum_cycle_error(e, pcx.nodes[ENUMS[e].node].start, &pcx);
            }
        }
    }
}

// Reports (at pos) that struct s holds itself through its fields, and
// breaks the cycle; whether it does.
pub fn struct_cycle_error(s: i64, pos: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var found = false;
        for i in 0..pcx.structs[s].field_count {
            let field = struct_field(s, i, pcx);
            reset_layout_states(&pcx);
            if holds((*field).ty, s + 1, &pcx) {
                (*field).ty = pcx.ty_error;
                found = true;
            }
        }
        reset_layout_states(&pcx);
        if found {
            err_begin(pos, &pcx);
            err_str(c"struct '", pcx);
            err_sym(pcx.structs[s].name, pcx);
            err_str(
                c"' has infinite size due to recursive field (use a pointer to break the cycle)",
                pcx);
            err_end_soft(&pcx);
        }
        found
    }
}

pub fn enum_cycle_error(e: i64, pos: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var found = false;
        for i in 0..ENUMS[e].variant_count {
            let v = enum_variant(e, i);
            for k in 0..pcx.variants[v].field_count {
                reset_layout_states(&pcx);
                if holds(variant_field(v, k, pcx), -(e + 1), &pcx) {
                    pcx.tlists.data[pcx.variants[v].fields + k] = pcx.ty_error;
                    found = true;
                }
            }
        }
        reset_layout_states(&pcx);
        if !found {
            return false;
        }
        // (the variants' shapes hold their field types)
        if ENUMS[e].has_fields {
            let repr_c = (ENUMS[e].repr & REPR_C) != 0;
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                let mark = pcx.tscratch.count;
                if !repr_c {
                    pcx.tscratch.push(ENUMS[e].tag);
                }
                for k in 0..pcx.variants[v].field_count {
                    pcx.tscratch.push(variant_field(v, k, pcx));
                }
                pcx.variants[v].shape = make_type(TyKind::Tuple, 0, 0, mark, &pcx);
            }
        }
        err_begin(pos, &pcx);
        err_str(c"enum '", pcx);
        err_sym(ENUMS[e].name, pcx);
        err_str(c"' has infinite size due to a recursive field (use a pointer to break the cycle)",
            pcx);
        err_end_soft(&pcx);
        true
    }
}

// Whether a value of type t holds the struct or enum `at` (struct s as
// s + 1, enum e as -(e + 1)); layout_state 2 marks the ones seen.
fn holds(t: i64, at: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let kind = pcx.types[t].kind;
        if kind == TyKind::Struct {
            let s = pcx.types[t].a;
            if s + 1 == at {
                return true;
            }
            if pcx.structs[s].layout_state != 0 {
                return false;
            }
            pcx.structs[s].layout_state = 2;
            for i in 0..pcx.structs[s].field_count {
                if holds((*struct_field(s, i, pcx)).ty, at, &pcx) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Enum {
            let e = pcx.types[t].a;
            if -(e + 1) == at {
                return true;
            }
            if ENUMS[e].layout_state != 0 {
                return false;
            }
            ENUMS[e].layout_state = 2;
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                for k in 0..pcx.variants[v].field_count {
                    if holds(variant_field(v, k, pcx), at, &pcx) {
                        return true;
                    }
                }
            }
            return false;
        }
        if kind == TyKind::Array {
            return holds(pcx.types[t].a, at, &pcx);
        }
        if kind == TyKind::Tuple {
            for i in 0..pcx.types[t].count {
                if holds(type_elem(t, i, pcx), at, &pcx) {
                    return true;
                }
            }
        }
        false
    }
}

pub fn collect_functions(pcx: inout Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if pcx.fns[f].generic == 0 && pcx.fns[f].tmpl == 0 {
            pcx.cur_mod = pcx.fns[f].module;
            pcx.self_type = pcx.fns[f].self_ty;
            pcx.self_impl = crate::front::traits::impl_of_fn(f, pcx);
            resolve_signature(f, &pcx);
        }
    }
    pcx.self_type = 0;
    pcx.cur_mod = 0;
}

// The parameter and result types of function f.
// (A type that names nothing is the error type; 0.10. So are all of them
// for a function whose declaration failed.)
pub fn resolve_signature(f: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let item = pcx.fns[f].node;
        let failed = (pcx.nodes[item].p & FN_SIG_FAILED) != 0;
        let mark = pcx.tscratch.count;
        for i in 0..pcx.nodes[item].count {
            let param = child(item, i, pcx);
            let name = pcx.nodes[param].a;
            if name != pcx.underscore && !failed {
                for j in 0..i {
                    if pcx.nodes[child(item, j, pcx)].a == name {
                        err_begin(pcx.nodes[param].start, &pcx);
                        err_str(c"duplicate parameter '", pcx);
                        err_sym(name, pcx);
                        err_str(c"'", pcx);
                        err_end_soft(&pcx);
                        break;
                    }
                }
            }
            var ty = if failed { pcx.ty_error }
                else { resolve_type_or_error(pcx.nodes[param].b, &pcx) };
            // (0.20) a let parameter: a copy or a reference (front/conv)
            ty = crate::front::conv::param_type(param, ty, &pcx);
            if pcx.fns[f].is_extern || pcx.fns[f].export {
                crate::front::conv::extern_conv(param, &pcx);
            }
            pcx.tscratch.push(ty);
        }
        // RULE: F21.2 (the rust edition: no parameter or result of an
        // unsized type)
        if !failed && pcx.edition != 0 {
            for i in 0..pcx.nodes[item].count {
                crate::front::check::rust::check_sized(pcx.nodes[child(item, i, pcx)].b,
                    c"a parameter", &pcx);
            }
            crate::front::check::rust::check_sized(pcx.nodes[item].b, c"a result", &pcx);
        }
        pcx.fns[f].params = pcx.tlists.count;
        pcx.fns[f].param_count = pcx.tscratch.count - mark;
        for i in mark..pcx.tscratch.count {
            pcx.tlists.push(pcx.tscratch.data[i]);
        }
        pcx.tscratch.count = mark;
        pcx.fns[f].ret = if failed {
            pcx.ty_error
        } else if pcx.nodes[item].b == 0 {
            TY_UNIT
        } else if crate::front::opaque::is_opaque_node(pcx.nodes[item].b, pcx) {
            // RULE: D21.1 (`-> impl Tr`: its opaque type, front/opaque.vl)
            crate::front::opaque::opaque_result(f, &pcx)
        } else {
            resolve_type_or_error(pcx.nodes[item].b, &pcx)
        };
        // (0.24: a let parameter a view of which the result may hold is a
        // borrow, conv::let_by_ref)
        if !failed {
            for i in 0..pcx.fns[f].param_count {
                let k = pcx.fns[f].params + i;
                pcx.tlists.data[k] = crate::front::conv::let_by_ref(child(item, i, pcx),
                    pcx.tlists.data[k], pcx.fns[f].ret, &pcx);
            }
        }
        if (pcx.fns[f].is_extern || pcx.fns[f].export) && !failed {
            check_c_function(f, &pcx);
        }
        // (0.15: the parameters' defaults)
        if !failed {
            check_param_defaults(f, &pcx);
        }
    }
}

// The parameters and result of a function with C's convention must be
// FFI-safe (see is_ffi_safe).
fn check_c_function(f: i64, pcx: inout Ctx<Comp>) {
    let item = pcx.fns[f].node;
    for i in 0..pcx.fns[f].param_count {
        let param = child(item, i, pcx);
        check_ffi_type(fn_param(f, i, pcx), pcx.nodes[param].b, c"parameter", &pcx);
    }
    let ret = pcx.fns[f].ret;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, pcx.nodes[item].b, c"result", &pcx);
    }
}

fn check_c_signature(fn_ty: i64, n: i64, what: *u8, pcx: inout Ctx<Comp>) {
    for i in 0..pcx.types[fn_ty].count {
        check_ffi_type(type_elem(fn_ty, i, pcx), child(n, i, pcx), c"parameter", &pcx);
    }
    let ret = pcx.types[fn_ty].a;
    if ret != TY_UNIT && ret != TY_NEVER {
        check_ffi_type(ret, pcx.nodes[n].a, c"result", &pcx);
    }
}

fn check_ffi_type(t: i64, n: i64, what: *u8, pcx: inout Ctx<Comp>) {
    if is_ffi_safe(t, pcx) || has_error_type(t, pcx) {
        return;
    }
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"type '", pcx);
    err_type(t, pcx);
    err_str(c"' of this ", pcx);
    err_str(what, pcx);
    err_str(c" cannot cross to C", pcx);
    let kind = pcx.types[t].kind;
    if kind == TyKind::Struct || kind == TyKind::Enum {
        err_help(c"declare it #[repr(C)] (its layout is unspecified otherwise), with fields that can cross to C", pcx);
    } else if kind == TyKind::Fn {
        err_help(
            c"use an extern \"C\" fn type, and pass functions defined with extern \"C\" fn", pcx);
    } else if kind == TyKind::Slice {
        err_help(c"pass the pointer and the length (s.ptr, s.len)", pcx);
    } else if kind == TyKind::Tuple {
        err_help(c"use a #[repr(C)] struct", pcx);
    } else if kind == TyKind::Array {
        err_help(c"pass a pointer to its first element, or wrap it in a #[repr(C)] struct", pcx);
    }
    err_end_soft(&pcx);
}

pub fn collect_statics(pcx: inout Ctx<Comp>) {
    for s in 0..pcx.statics.len() as i64 {
        let item = pcx.statics[s].node;
        pcx.cur_mod = module_of(item, &pcx);
        let ty = resolve_type_or_error(pcx.nodes[item].b, &pcx);
        pcx.statics[s].ty = ty;
        // (0.16: no scope's arena)
        if !check_static_type(ty, pcx.nodes[item].a, pcx.nodes[pcx.nodes[item].b].start, &pcx) {
            continue;
        }
        // A static shared with C is memory with C's layout: arrays of
        // FFI-safe types too (0.4).
        if pcx.statics[s].linkage != 0 && !is_ffi_field(ty, pcx) {
            check_ffi_type(ty, pcx.nodes[item].b, c"static", &pcx);
        }
        if pcx.statics[s].linkage == 1 || has_error_type(ty, pcx) {
            continue;
        }
        attempt(Try::Static, s, &pcx);
    }
    pcx.cur_mod = 0;
}

// The initializer of static s.
pub fn check_static(s: i64, pcx: inout Ctx<Comp>) {
    let item = pcx.statics[s].node;
    let ty = pcx.statics[s].ty;
    let init = pcx.nodes[item].c;
    if pcx.types[ty].kind == TyKind::Slice && pcx.nodes[init].kind == NodeKind::Array {
        // (0.25.2.2, eval 0.25.2.1: sdftext) `static S: [f32] = [...];`:
        // the array, of the literal's length, as the fix
        let arr = buf_new();
        buf_str(arr, c"[");
        buf_type(arr, pcx.types[ty].a, pcx);
        buf_fmt(arr, format_args("; {}]", pcx.nodes[init].count));
        let name = sym_text(pcx.nodes[item].a, pcx);
        err_begin(pcx.nodes[pcx.nodes[item].b].start, &pcx);
        err_fmt(format_args("static '{name}' has slice type '"), pcx);
        err_type(ty, pcx);
        err_fmt(format_args("': a static holds an array, of the literal's {} elements",
            pcx.nodes[init].count), pcx);
        err_help_fmt(
            format_args(
                "`static {name}: {} = [...];` (`{name}[i]` reads one, `{name}[..]` is the slice)", buf_slice(arr)), pcx);
        err_fix(pcx.nodes[pcx.nodes[item].b].start, pcx.nodes[pcx.nodes[item].b].end,
            buf_slice(arr), &pcx);
        err_end_soft(&pcx);
        return;
    }
    let errors = error_count(pcx);
    check_const_expr(pcx.nodes[item].c, ty, &pcx);
    // (0.16: not after an error in it, a #[sealed] literal's)
    if error_count(pcx) != errors {
        return;
    }
    if pcx.nodes[pcx.nodes[item].c].kind == CStr {
        // A C string (0.4): the address of the literal.
        return;
    }
    // (0.16: a call of a constructor once its body is checked)
    if has_const_call(pcx.nodes[item].c, pcx) {
        pcx.static_calls.push(s);
        return;
    }
    // Evaluated now to report non-constant initializers; the code
    // generator evaluates it again into the data section.
    let scratch = buf_new();
    const_emit(pcx.nodes[item].c, ty, scratch, &pcx);
}

// The initializers that call constructors, evaluated (to report what is
// not constant) once every function body is checked.
pub fn check_static_calls(pcx: inout Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.static_calls.count {
            attempt(Try::StaticCall, pcx.static_calls.data[i], &pcx);
        }
        pcx.static_calls.count = 0;
    }
}

// The value of static s's initializer, which calls a constructor.
pub fn static_call_value(s: i64, pcx: inout Ctx<Comp>) {
    let scratch = buf_new();
    const_emit(pcx.nodes[pcx.statics[s].node].c, pcx.statics[s].ty, scratch, &pcx);
}

pub fn evaluate_consts(pcx: inout Ctx<Comp>) {
    pcx.cur_mod = 0;
    for c in 0..pcx.consts.len() as i64 {
        const_value(c, &pcx);
    }
}

// ---- Resolving types ----

// RULE: F6.1 (0.27.2) Whether type node t is `Self` of an impl whose self
// type is written as a reference to a view, `impl Tr for &'a str`: its
// `&mut self` is a `&mut &str`, not a `&mut str`.
fn self_node_is_view_ref(t: i64, pcx: Ctx<Comp>) -> bool {
    if t <= 0 || pcx.nodes[t].kind != TyName || sym_text(pcx.nodes[t].a, pcx) != "Self"
        || pcx.self_impl < 0 || pcx.self_impl >= pcx.traits_impls.len() as i64 {
        return false;
    }
    let h = pcx.nodes[pcx.traits_impls[pcx.self_impl].node].b;
    h > 0 && crate::base::SRC[pcx.nodes[h].start] == '&'
}

// RULE: Z9.3 (0.27.2) Whether type node t writes an unsized type itself,
// `[T]` or `str` (not a parameter or `Self` that stands for one).
pub fn written_unsized(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && (pcx.nodes[t].kind == TySlice
        || pcx.nodes[t].kind == TyName && pcx.nodes[t].count == 0 && pcx.nodes[t].g == 0
        && sym_text(pcx.nodes[t].a, pcx) == "str")
}

pub fn resolve_type(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let kind = pcx.nodes[n].kind;
        match kind {
            TyName => {
                let t = resolve_type_name(n, &pcx);
                // RULE: F0.1 (0.27.2: `&mut str`, the parser's str TyName
                // flagged)
                if (pcx.nodes[n].p & NODE_REF_MUT) != 0
                    && crate::front::distinct::is_view_distinct(t, pcx) {
                    return crate::front::types::mut_view_of(t, &pcx);
                }
                return t;
            }
            TyUnit => return TY_UNIT,
            TyNever => return TY_NEVER,
            TyPtr => {
                // (0.17: `&T`, `&mut T`)
                let inner = resolve_type(pcx.nodes[n].a, &pcx);
                if (pcx.nodes[n].p & NODE_REF_MUT) != 0 {
                    // (0.27.0: `&mut Self` of a view, as `&mut [T]` and
                    // `&mut str` are written)
                    // (0.27.2: not of a `&mut [T]` itself, a T or Self that
                    // stands for one: `&mut T` is then a reference to it,
                    // `mem::replace(&mut self.v, ..)` of IterMut's)
                    if inner > 0 && pcx.edition != 0 && pcx.types[inner].kind == TyKind::Slice
                        && pcx.types[inner].b == 0
                        && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx) {
                        return mut_slice_of(pcx.types[inner].a, &pcx);
                    }
                    // RULE: F0.1 (0.27.2: `&mut str` keeps its mutability, the
                    // str over an exclusive slice)
                    if crate::front::distinct::is_view_distinct(inner, pcx) && pcx.edition != 0
                        && !crate::front::types::is_mut_slice(inner, pcx)
                        && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx) {
                        // (`&mut self` of `impl Tr for &'a str`: a `&mut
                        // &str`, the view itself until Z9.1)
                        if self_node_is_view_ref(pcx.nodes[n].a, pcx) {
                            return inner;
                        }
                        return crate::front::types::mut_view_of(inner, &pcx);
                    }
                    return ref_to(inner, REF_MUT, &pcx);
                }
                if (pcx.nodes[n].p & NODE_REF) != 0 {
                    // (0.27.0) in the rust edition, `&Self` or `&T` of a view
                    // (str, a slice) is the view, as `&str` and `&[T]` are
                    // written: `impl PartialEq for str`'s `other: &str`
                    if inner > 0 && pcx.edition != 0
                        && (pcx.types[inner].kind == TyKind::Slice
                            || crate::front::distinct::is_view_distinct(inner, pcx))
                        && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx) {
                        return inner;
                    }
                    return ref_to(inner, REF_SHARED, &pcx);
                }
                // RULE: Z9.3 (0.27.2: in the rust edition `*const [T]`, `*mut
                // [T]`, `*const str` keep both words, a fat raw pointer)
                // (a pointer to a reference, `*const &[T]`, stays thin)
                // (0.27.2: only a pointee written `[T]` or `str`: a `*const T`
                // with T a view, `Vec<&str>`'s, points to the view, thin,
                // until Z9.1 tells `&str` from `str`)
                if inner > 0 && pcx.edition != 0 && pcx.nodes[pcx.nodes[n].a].kind != TyPtr
                    && written_unsized(pcx.nodes[n].a, pcx)
                    && (pcx.types[inner].kind == TyKind::Slice && pcx.types[inner].b == 0
                        || crate::front::distinct::is_view_distinct(inner, pcx)
                        && !crate::front::types::is_raw_view(inner, pcx))
                    && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx) {
                    return crate::front::types::raw_view_of(inner, &pcx);
                }
                return ptr_to(inner, &pcx);
            }
            TySlice => {
                let elem = resolve_type(pcx.nodes[n].a, &pcx);
                if (pcx.nodes[n].p & NODE_REF_MUT) != 0 {
                    return mut_slice_of(elem, &pcx);
                }
                return slice_of(elem, &pcx);
            }
            TyArray => {
                let elem = resolve_type(pcx.nodes[n].a, &pcx);
                return array_of(elem, eval_array_len(pcx.nodes[n].b, &pcx), &pcx);
            }
            _ => {}
        }
        // A tuple or a function type: the element types first.
        let mark = pcx.tscratch.count;
        for i in 0..pcx.nodes[n].count {
            var elem = resolve_type(child(n, i, pcx), &pcx);
            if kind == NodeKind::TyFn {
                // (0.20) `fn(let T)`, `Fn(let T)`: a let parameter, a copy
                // or a reference by T (front/conv)
                elem = crate::front::conv::fn_type_param(child(n, i, pcx), elem, &pcx);
            }
            pcx.tscratch.push(elem);
        }
        if kind == TyTuple {
            return make_type(TyKind::Tuple, 0, 0, mark, &pcx);
        }
        let result = resolve_type(pcx.nodes[n].a, &pcx);
        // (0.24: as a function's, conv::let_by_ref; not a `sink T`)
        for i in 0..pcx.nodes[n].count {
            if (pcx.nodes[child(n, i, pcx)].p & crate::front::ast::CONV_SINK) == 0
                && pcx.nodes[n].d == 0 {
                pcx.tscratch.data[mark + i] = crate::front::conv::let_by_ref(0,
                    pcx.tscratch.data[mark + i], result, &pcx);
            }
        }
        // RULE: F19.3 (`unsafe fn(..)`, `unsafe extern "C" fn(..)`: the
        // parser marks the node in a rust-edition position only)
        let unsafe_bit = if (pcx.nodes[n].p & crate::front::ast::ITEM_UNSAFE) != 0 {
            crate::front::types::FN_TY_UNSAFE
        } else {
            0
        };
        let fn_ty = make_type(TyKind::Fn, result, pcx.nodes[n].d | unsafe_bit, mark, &pcx);
        if pcx.nodes[n].d != 0 {
            check_c_signature(fn_ty, n, c"an extern \"C\" fn type", &pcx);
        }
        fn_ty
    }
}

// A named type: a type parameter, a primitive, `Self`, or a struct, enum
// or alias (through the module path in its list, if any; an instance of a
// generic one with the arguments in its `g`).
fn resolve_type_name(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let name = pcx.nodes[n].a;
        let g = pcx.nodes[n].g;
        // RULE: F8.1, F11.3 (0.27.2: `<X as Tr>::A`, the A of X's impl of Tr)
        if (pcx.nodes[n].p & crate::front::ast::NODE_QPATH) != 0 {
            return qualified_projection(n, &pcx);
        }
        // (0.14: `T::Item`, `Self::Item`)
        if pcx.nodes[n].count != 0 && is_projection_node(n, pcx) {
            return resolve_projection_node(n, &pcx);
        }
        if pcx.nodes[n].count == 0 {
            let param = env_lookup(name, pcx);
            if param != 0 {
                if g != 0 {
                    name_error(pcx.nodes[n].start, c"type parameter '", name,
                        c"' takes no type arguments", &pcx);
                }
                return param;
            }
            if g == 0 {
                return resolve_named(name, pcx.nodes[n].start, &pcx);
            }
        }
        let key = type_name_key(n, &pcx);
        if key < 0 {
            // (0.25.2.2) a module of constants: their type
            let mb = lookup_name(
                if pcx.nodes[n].count > 0 { path_module(n, pcx.nodes[n].count, &pcx) }
                else { pcx.cur_mod },
                name, pcx.cur_mod, &pcx);
            if binding_kind(mb) == B_MODULE {
                let tb = buf_new();
                var cname: [u8] = "";
                for c in 0..pcx.consts.len() as i64 {
                    if module_of(pcx.consts[c].node, &pcx) == binding_value(mb)
                        && pcx.consts[c].ty > 0 {
                        buf_type(tb, pcx.consts[c].ty, pcx);
                        cname = sym_text(pcx.nodes[pcx.consts[c].node].a, pcx);
                        break;
                    }
                }
                module_type_error(pcx.nodes[n].start, name, cname, buf_slice(tb), &pcx);
            }
            unknown_name_error(pcx.nodes[n].start, c"unknown type '", name, &pcx);
        }
        let tpl = template_of_key(key, pcx);
        if tpl != TPL_NONE {
            // (0.16: `Buf`, every parameter with a default)
            if g == 0 && required_targs(tpl, pcx) > 0
                && !crate::front::check::alloc_rules::bare_allocator_only(tpl, &pcx) {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"'", pcx);
                err_sym(name, pcx);
                err_str(c"' is generic: write its type arguments ('", pcx);
                err_sym(name, pcx);
                err_str(c"<...>')", pcx);
                err_end(&pcx);
            }
            let mark = pcx.tscratch.count;
            if g != 0 {
                push_written_targs(g, &pcx);
            }
            return template_instance(tpl, mark, pcx.nodes[n].start, &pcx);
        }
        if g != 0 && pcx.sym_alias[key] != 0 && pcx.nodes[pcx.sym_alias[key]].g != 0 {
            return generic_alias(key, g, pcx.nodes[n].start, &pcx);
        }
        if g != 0 {
            name_error(pcx.nodes[n].start, c"'", name, c"' is not generic", &pcx);
        }
        resolve_key(key, name, pcx.nodes[n].start, &pcx)
    }
}

// (0.27.2) `<X as Tr>::A` (TyName n flagged NODE_QPATH): the associated
// type A of X's impl of Tr; an error when X has none. RULE: F8.1, F11.3
fn qualified_projection(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let t = resolve_type(child(n, 0, pcx), &pcx);
    if has_error_type(t, pcx) {
        return pcx.ty_error;
    }
    let tr = crate::front::traits::bound_trait(pcx.nodes[n].c, &pcx);
    if tr < 0 {
        return pcx.ty_error;
    }
    let r = crate::front::assoc::trait_projection(tr, t, pcx.nodes[n].a, pcx.nodes[n].start, &pcx);
    if r != 0 {
        return r;
    }
    // (X written with a parameter, `<I::Item as IntoIterator>::IntoIter`
    // in an instance whose argument has no such impl: the instance's
    // `where` bound fails, which its use reports (F10.2); a field of a
    // struct made for a default method's signature is never read)
    if crate::front::coherence::mentions_param(child(n, 0, pcx), pcx) {
        return pcx.ty_error;
    }
    let saved_kind = pcx.err_kind;
    pcx.err_kind = c"trait.unmet";
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"'", pcx);
    err_type(t, pcx);
    err_fmt(format_args("' has no impl of '{}' that defines '{}'",
        sym_text(pcx.traits[tr].name, pcx), sym_text(pcx.nodes[n].a, pcx)), pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved_kind;
    pcx.ty_error
}

// `Pair<i64>` of a generic alias (0.6): its type with its parameters bound
// to the arguments written in `g` (resolved here), in its own module.
fn generic_alias(key: i64, g: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let alias = pcx.sym_alias[key];
        let params = pcx.nodes[alias].g;
        if pcx.nodes[g].count != pcx.nodes[params].count {
            err_begin(pos, &pcx);
            err_str(c"type alias '", pcx);
            err_sym(pcx.nodes[alias].a, pcx);
            err_str(c"' takes ", pcx);
            err_int(pcx.nodes[params].count, pcx);
            err_str(if pcx.nodes[params].count == 1 { c" type argument, got " }
                else { c" type arguments, got " }, pcx);
            err_int(pcx.nodes[g].count, pcx);
            err_end(&pcx);
        }
        if pcx.alias_busy[key] != 0 {
            name_error(pos, c"type alias '", pcx.nodes[alias].a, c"' is defined in terms of itself",
                &pcx);
        }
        let mark = pcx.tscratch.count;
        push_written_targs(g, &pcx);
        let saved = pcx.tp_base;
        let saved_mod = pcx.cur_mod;
        pcx.tp_base = pcx.tp_names.count;
        for i in 0..pcx.nodes[params].count {
            pcx.tp_names.push(pcx.nodes[child(params, i, pcx)].a);
            pcx.tp_types.push(pcx.tscratch.data[mark + i]);
        }
        pcx.tscratch.count = mark;
        pcx.cur_mod = module_of(alias, &pcx);
        pcx.alias_busy[key] = 1;
        var t = resolve_type_or_error(pcx.nodes[alias].b, &pcx);
        // (0.18: a generic distinct type, its arguments part of it)
        if is_distinct(alias, pcx) {
            let targs = pcx.tscratch.count;
            for i in 0..pcx.nodes[params].count {
                pcx.tscratch.push(pcx.tp_types.data[pcx.tp_base + i]);
            }
            t = distinct_of(alias, t, targs, &pcx);
        }
        pcx.alias_busy[key] = 0;
        pcx.cur_mod = saved_mod;
        pcx.tp_names.count = pcx.tp_base;
        pcx.tp_types.count = pcx.tp_base;
        pcx.tp_base = saved;
        t
    }
}

// The key a TyName names (through its module path), or -1.
pub fn type_name_key(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let name = pcx.nodes[n].a;
        var m = pcx.cur_mod;
        var b = 0;
        if pcx.nodes[n].count > 0 {
            m = path_module(n, pcx.nodes[n].count, &pcx);
            b = lookup_name(m, name, pcx.cur_mod, &pcx);
        } else {
            if pcx.sym_primitive[name] != 0 || (name == pcx.self_type_sym && pcx.self_type != 0) {
                return -1;
            }
            b = lookup_item(m, name, pcx.cur_mod, &pcx);
            note_c_use(pcx.nodes[n].start, name, b, &pcx);
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, pcx.nodes[n].start, name, &pcx);
        }
        if binding_kind(b) != B_ITEM {
            return -1;
        }
        let key = binding_value(b);
        qnote(pcx.nodes[n].start, name, item_node_of(key, pcx), 0, &pcx);
        key
    }
}

pub fn resolve_named(name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let param = env_lookup(name, pcx);
        if param != 0 {
            return param;
        }
        if pcx.sym_primitive[name] != 0 {
            return pcx.sym_primitive[name];
        }
        if name == pcx.self_type_sym && pcx.self_type != 0 {
            qnote_self(pos, name, pcx.self_type, &pcx);
            return pcx.self_type;
        }
        let b = lookup_item(pcx.cur_mod, name, pcx.cur_mod, &pcx);
        note_c_use(pos, name, b, &pcx);
        if binding_kind(b) == B_PRIVATE {
            access_error(b, pos, name, &pcx);
        }
        if binding_kind(b) != B_ITEM {
            // (0.25.2.2) a module of constants: their type
            let mb = lookup_name(pcx.cur_mod, name, pcx.cur_mod, &pcx);
            if binding_kind(mb) == B_MODULE {
                let tb = buf_new();
                var cname: [u8] = "";
                for c in 0..pcx.consts.len() as i64 {
                    if module_of(pcx.consts[c].node, &pcx) == binding_value(mb)
                        && pcx.consts[c].ty > 0 {
                        buf_type(tb, pcx.consts[c].ty, pcx);
                        cname = sym_text(pcx.nodes[pcx.consts[c].node].a, pcx);
                        break;
                    }
                }
                module_type_error(pos, name, cname, buf_slice(tb), &pcx);
            }
            unknown_name_error(pos, c"unknown type '", name, &pcx);
        }
        let key = binding_value(b);
        qnote(pos, name, item_node_of(key, pcx), 0, &pcx);
        let tpl = template_of_key(key, pcx);
        // (0.16: `Buf` is `Buf<Gpa>`, every parameter has a default)
        if tpl != TPL_NONE && (required_targs(tpl, pcx) == 0
            || crate::front::check::alloc_rules::bare_allocator_only(tpl, &pcx)) {
            return template_instance(tpl, pcx.tscratch.count, pos, &pcx);
        }
        if tpl != TPL_NONE {
            err_begin(pos, &pcx);
            err_str(c"'", pcx);
            err_sym(name, pcx);
            err_str(c"' is generic: write its type arguments ('", pcx);
            err_sym(name, pcx);
            err_str(c"<...>')", pcx);
            err_end(&pcx);
        }
        resolve_key(key, name, pos, &pcx)
    }
}

// (0.25.2.2, eval 0.25.2.1: cloth) A type that names a module (`u:
// gpu::BufferUsage`): when the module holds constants (std::gpu's
// BufferUsage, u32 flags: one is `cname`, of type `ct`), their type is the
// type meant.
fn module_type_error(pos: i64, name: i64, cname: [u8], ct: [u8], pcx: inout Ctx<Comp>) -> ! {
    err_begin(pos, &pcx);
    err_str(c"unknown type '", pcx);
    err_sym(name, pcx);
    err_str(c"'", pcx);
    let t = sym_text(name, pcx);
    if ct.len > 0 {
        err_help_fmt(
            format_args("'{t}' is a module of constants, not a type: its constants ('{t}::{cname}', ...) are '{ct}', so a value of them is a '{ct}' (`x: {ct}`)"), pcx);
        err_try_fmt(ct, pcx);
    } else {
        err_help_fmt(format_args("'{t}' is a module, not a type: its items are `{t}::NAME`"), pcx);
    }
    err_end(&pcx)
}

// The struct, enum or alias with key `key`.
pub fn resolve_key(key: i64, name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.sym_struct[key] != 0 {
            return struct_type(pcx.sym_struct[key] - 1, &pcx);
        }
        if pcx.sym_enum[key] != 0 {
            return enum_type(pcx.sym_enum[key] - 1, &pcx);
        }
        if pcx.sym_alias[key] == 0 {
            if pcx.sym_trait[key] != 0 {
                name_error(pos, c"'", name, c"' is a trait, not a type (no trait objects: use a type parameter bounded by it, 'T: Trait')", &pcx);
            }
            unknown_name_error(pos, c"unknown type '", name, &pcx);
        }
        resolve_alias(key, pos, &pcx)
    }
}

pub fn resolve_alias(key: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.alias_type[key] != 0 {
            return pcx.alias_type[key];
        }
        let alias = pcx.sym_alias[key];
        if pcx.nodes[alias].g != 0 {
            err_begin(pos, &pcx);
            err_str(c"type alias '", pcx);
            err_sym(pcx.nodes[alias].a, pcx);
            err_str(c"' is generic: write its type arguments ('", pcx);
            err_sym(pcx.nodes[alias].a, pcx);
            err_str(c"<...>')", pcx);
            err_end(&pcx);
        }
        if pcx.alias_busy[key] != 0 {
            name_error(pos, c"type alias '", pcx.nodes[alias].a, c"' is defined in terms of itself",
                &pcx);
        }
        pcx.alias_busy[key] = 1;
        let saved = pcx.cur_mod;
        pcx.cur_mod = module_of(alias, &pcx);
        var resolved = resolve_type_or_error(pcx.nodes[alias].b, &pcx);
        // (0.18: `type X = distinct T`, a type of its own)
        if is_distinct(alias, pcx) {
            resolved = distinct_of(alias, resolved, pcx.tscratch.count, &pcx);
        }
        pcx.cur_mod = saved;
        pcx.alias_busy[key] = 0;
        pcx.alias_type[key] = resolved;
        resolved
    }
}
