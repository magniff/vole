// Named arguments and parameter defaults (0.15;
// docs/design/errors-formatting.md). At a call, the positional arguments
// come first, then `name: value` in parameter order (Swift's rule); a
// parameter not given takes its default, a copy of the default expression
// (`Param.h`) checked in the callee's module, per call. Defaults are on
// trailing parameters of fn items and inherent methods only.
//
// Also the shorthand of a struct literal's field (`P { x, y }`), whose
// unknown name gets the long form as its help.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, free, get_bufs, get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_file_line, err_begin, err_end, err_end_soft, err_fix, err_help, err_help_fmt, err_help_sym,
    err_int, err_str, err_sym, err_try_fmt,
};
use crate::front::ast::{
    CALL_ARGS_DONE, FIELD_SHORTHAND, NodeKind, child, list_begin, list_end, list_push,
};
use crate::front::check::lookup_local;
use crate::front::check::check_mode::check_expr;
use crate::front::check::names::near_to;
use crate::front::check::vectors::sym_is_c;
use crate::front::generics::instantiate::{clone_node, node_field_a, node_field_b, node_field_c};
use crate::front::modules::lookup::{B_NONE, binding_kind, lookup_quiet};
use crate::front::traits::impl_trait_node;
use crate::front::types::{buf_type, fn_param, is_integer};

// The arguments of call n (a Call or MethodCall) of function f (a FNS
// index, a template before it is instantiated), whose list holds the
// arguments of the parameters from first_param on (1 for a method call:
// the receiver is apart): put in parameter order, the defaults of the
// parameters not given appended (clones of Param.h), and n flagged
// CALL_ARGS_DONE. Nothing to do when n has no named argument and gives
// every parameter (an arity error is check_direct_call's).
pub fn normalize_args(n: i64, f: i64, first_param: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if f < 0 || (pcx.nodes[n as usize].p & CALL_ARGS_DONE) != 0 {
            return;
        }
        // (0.20: `&e` of 0.19 code given to a let parameter, front/conv)
        crate::front::conv::legacy_let_args(n, f, first_param, pcx);
        let node = pcx.fns[f as usize].node;
        let count = pcx.nodes[n as usize].count;
        let mut positional: i64 = 0;
        while positional < count
            && pcx.nodes[child(n, positional, pcx) as usize].kind != NodeKind::NamedArg {
            positional += 1;
        }
        let is_fn = pcx.nodes[node as usize].kind == NodeKind::Fn;
        let params = if is_fn { pcx.nodes[node as usize].count }
            else { pcx.fns[f as usize].param_count };
        if positional == count {
            // (a parameter left out: when one after it has a default, the
            // missing one is named, else the arity error)
            let given = first_param + count;
            if !is_fn || given >= params
                || pcx.nodes[child(node, params - 1, pcx) as usize].h == 0
                && !macro_message(f, node, params - 1, pcx) {
                return;
            }
        } else {
            named_args_allowed(n, f, child(n, positional, pcx), pcx);
        }
        if first_param + positional > params {
            arity_error(n, f, first_param, params, pcx);
        }
        // slots[k]: the argument of parameter k; text[k]: its node as
        // written (the NamedArg of a named one), for the help
        let slots = alloc_array_i64(params);
        let text = alloc_array_i64(params);
        for i in 0..positional {
            (*slots.add((first_param + i) as usize)) = child(n, i, pcx);
            (*text.add((first_param + i) as usize)) = child(n, i, pcx);
        }
        let mut last: i64 = -1;
        for i in positional..count {
            let arg = child(n, i, pcx);
            if pcx.nodes[arg as usize].c == 1 {
                // (0.26.2) `name = e` outside a format call
                err_begin(pcx.nodes[arg as usize].start, pcx);
                err_str(c"'", pcx);
                err_sym(pcx.nodes[arg as usize].a, pcx);
                err_str(c" = ...' is a format string's named argument; a named argument of a call is written '", pcx);
                err_sym(pcx.nodes[arg as usize].a, pcx);
                err_str(c": ...'", pcx);
                err_end(pcx);
            }
            let k = param_named(node, pcx.nodes[arg as usize].a, pcx);
            if k < 0 {
                unknown_param_error(arg, f, node, pcx);
            }
            if k < first_param {
                err_begin(pcx.nodes[arg as usize].start, pcx);
                err_str(c"'self' cannot be named: the receiver is the value before '.'", pcx);
                err_end(pcx);
            }
            if (*slots.add(k as usize)) != 0 {
                err_begin(pcx.nodes[arg as usize].start, pcx);
                err_str(c"parameter '", pcx);
                err_sym(pcx.nodes[arg as usize].a, pcx);
                if k < first_param + positional {
                    err_str(c"' is given by position already", pcx);
                } else {
                    err_str(c"' is given twice", pcx);
                }
                err_end(pcx);
            }
            (*slots.add(k as usize)) = pcx.nodes[arg as usize].b;
            (*text.add(k as usize)) = arg;
            if k < last {
                order_error(n, f, arg, text, first_param, params, pcx);
            }
            last = k;
        }
        for k in first_param..params {
            if (*slots.add(k as usize)) == 0 {
                let h: i64 = if is_fn { pcx.nodes[child(node, k, pcx) as usize].h } else { 0 };
                let message = h == 0 && is_fn && macro_message(f, node, k, pcx);
                if h == 0 && !message {
                    missing_error(n, f, node, k, text, first_param, params, pcx);
                }
                // RULE: F33.1 (the message left out: an empty string
                // literal at the call, checked as a default was)
                let c = if message {
                    let s = crate::front::ast::new_node(NodeKind::Str, pcx.nodes[n as usize].start,
                        pcx.nodes[n as usize].start, pcx);
                    pcx.nodes[s as usize].a = crate::front::lexer::add_string(&get_src()[0..0]);
                    s
                } else {
                    clone_node(h, pcx)
                };
                if !pcx.defaults_used {
                    pcx.defaults_used = true;
                }
                pcx.default_args.put(c + 1, f + 1);
                (*slots.add(k as usize)) = c;
            }
        }
        let mark = list_begin(pcx);
        for k in first_param..params {
            list_push((*slots.add(k as usize)), pcx);
        }
        list_end(n, mark, pcx);
        pcx.nodes[n as usize].p |= CALL_ARGS_DONE;
        free(slots as *mut u8);
        free(text as *mut u8);
    }
}

fn alloc_array_i64(n: i64) -> *mut i64 {
    let a = crate::base::alloc_array::<i64>(if n > 0 { n } else { 1 });
    unsafe {
        for i in 0..n {
            (*a.add(i as usize)) = 0;
        }
    }
    a
}

// The index of function node `node`'s parameter named `name`, or -1.
fn param_named(node: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[node as usize].kind != NodeKind::Fn
        && pcx.nodes[node as usize].kind != NodeKind::ExternFn {
        return -1;
    }
    for k in 0..pcx.nodes[node as usize].count {
        if pcx.nodes[child(node, k, pcx) as usize].a == name {
            return k;
        }
    }
    -1
}

// Whether call n of f may name its arguments (`arg` is the first named
// one): not a trait's function (an impl may name its parameters
// differently), not a variadic C function.
fn named_args_allowed(n: i64, f: i64, arg: i64, pcx: &mut Ctx<Comp>) {
    let mut what = 0 as *mut u8;
    if impl_trait_node(f, pcx) != 0 {
        what = c"' is a trait's function: its arguments are positional";
    } else if pcx.fns[f as usize].variadic {
        what = c"' is variadic: its arguments are positional";
    } else if pcx.nodes[pcx.fns[f as usize].node as usize].kind != NodeKind::Fn
        && pcx.nodes[pcx.fns[f as usize].node as usize].kind != NodeKind::ExternFn {
        what = c"' takes positional arguments only";
    }
    if what == 0 as *mut u8 {
        return;
    }
    err_begin(pcx.nodes[arg as usize].start, pcx);
    err_str(c"'", pcx);
    err_sym(pcx.fns[f as usize].display, pcx);
    err_str(what, pcx);
    err_help(c"write '", pcx);
    buf_bytes(pcx.err_help,
        &get_src()[
            pcx.nodes[pcx.nodes[arg as usize].b as usize].start as usize..pcx.nodes[
                pcx.nodes[arg as usize].b as usize].end as usize]);
    err_help(c"' without its name", pcx);
    err_end(pcx);
}

fn arity_error(n: i64, f: i64, first_param: i64, params: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"function '", pcx);
    err_sym(pcx.fns[f as usize].display, pcx);
    err_str(c"' expects ", pcx);
    err_int(params - first_param, pcx);
    err_str(c" arguments, got more", pcx);
    err_end(pcx)
}

// (0.17) The help of a call of f with `count` arguments where it takes
// `params` (a method's: without self): its signature
// and where it is; with too few, the try: line is the call with a VALUE
// for each missing argument.
pub fn arity_help(n: i64, f: i64, count: i64, params: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let node = pcx.fns[f as usize].node;
        if node == 0 || pcx.nodes[node as usize].end <= pcx.nodes[node as usize].start {
            return;
        }
        let s = pcx.nodes[node as usize].start;
        let mut e = s;
        let mut depth: i64 = 0;
        while e < pcx.nodes[node as usize].end && !(get_src()[e as usize] == b'{' && depth == 0)
            && get_src()[e as usize] != b';' {
            if get_src()[e as usize] == b'(' || get_src()[e as usize] == b'['
                || get_src()[e as usize] == b'<' {
                depth += 1;
            }
            else if get_src()[e as usize] == b')' || get_src()[e as usize] == b']'
                || get_src()[e as usize] == b'>' && get_src()[(e - 1) as usize] != b'-' {
                depth -= 1;
            }
            e += 1;
        }
        let sig = buf_new();
        let mut space = false;
        for k in s..e {
            let c = get_src()[k as usize];
            if c == b' ' || c == b'\n' || c == b'\t' {
                space = true;
                continue;
            }
            if space && (*get_bufs().add(sig as usize)).len > 0
                && (
                    *(*get_bufs().add(sig as usize)).data.add(
                        ((*get_bufs().add(sig as usize)).len - 1) as usize)) != b'(' && c != b')' {
                buf_byte(sig, b' ');
            }
            space = false;
            buf_byte(sig, c);
        }
        let at = buf_new();
        buf_file_line(at, s, pcx);
        err_help_fmt(format_args("its signature: `{}` ({})",
            str::from_utf8(buf_slice(sig)).unwrap(), str::from_utf8(buf_slice(at)).unwrap()), pcx);
        if count < params && pcx.nodes[n as usize].end > pcx.nodes[n as usize].start
            && get_src()[(pcx.nodes[n as usize].end - 1) as usize] == b')' {
            let t = buf_new();
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[n as usize].start as usize..(pcx.nodes[n as usize].end - 1) as usize]);
            // (0.18) a missing argument a local of its parameter's name and
            // type gives (`gpa`); when every one is, the call is the fix
            let off = pcx.fns[f as usize].param_count - params;
            let is_fn = pcx.nodes[node as usize].kind == NodeKind::Fn
                || pcx.nodes[node as usize].kind == NodeKind::ExternFn;
            let mut all = true;
            for k in count..params {
                if k > 0 {
                    buf_str(t, c", ");
                }
                let name: i64 = if is_fn && k + off < pcx.nodes[node as usize].count {
                    pcx.nodes[child(node, k + off, pcx) as usize].a
                } else {
                    -1
                };
                let mut given = false;
                if name > 0 {
                    match lookup_local(name, pcx) {
                        Option::Some(id) => {
                            if pcx.locals[id as usize].ty == fn_param(f, k + off, pcx) {
                                buf_bytes(t, sym_text(name, pcx));
                                given = true;
                            }
                        }
                        Option::None => {}
                    }
                }
                if !given {
                    buf_str(t, c"VALUE");
                    all = false;
                }
            }
            buf_byte(t, b')');
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            if all {
                err_fix(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, buf_slice(t), pcx);
            }
        }
    }
}

// A named argument whose name no parameter of f has.
fn unknown_param_error(arg: i64, f: i64, node: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[arg as usize].start, pcx);
    err_str(c"function '", pcx);
    err_sym(pcx.fns[f as usize].display, pcx);
    err_str(c"' has no parameter '", pcx);
    err_sym(pcx.nodes[arg as usize].a, pcx);
    err_str(c"'", pcx);
    let mut near = near_to(pcx.nodes[arg as usize].a);
    if pcx.nodes[node as usize].kind == NodeKind::Fn
        || pcx.nodes[node as usize].kind == NodeKind::ExternFn {
        for k in 0..pcx.nodes[node as usize].count {
            near.offer(pcx.nodes[child(node, k, pcx) as usize].a, pcx);
        }
    }
    near.help(pcx);
    err_end(pcx)
}

// The call n as it would be written with its arguments in parameter
// order (text[k]: parameter k's argument as written, 0: none), and
// `name: VALUE` for parameter `missing` (-1: none), into the help.
fn help_call(n: i64, node: i64, text: *mut i64, first_param: i64, params: i64, missing: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        let first_arg = child(n, 0, pcx);
        let open = if pcx.nodes[n as usize].count > 0 { pcx.nodes[first_arg as usize].start }
            else { pcx.nodes[n as usize].end - 1 };
        buf_bytes(pcx.err_help, &get_src()[pcx.nodes[n as usize].start as usize..open as usize]);
        let mut any = false;
        for k in first_param..params {
            if (*text.add(k as usize)) != 0 || k == missing {
                if any {
                    err_help(c", ", pcx);
                }
                any = true;
                if k == missing {
                    err_help_sym(pcx.nodes[child(node, k, pcx) as usize].a, pcx);
                    err_help(c": VALUE", pcx);
                } else {
                    buf_bytes(pcx.err_help,
                        &get_src()[
                            pcx.nodes[(*text.add(k as usize)) as usize].start as usize..pcx.nodes[
                                (*text.add(k as usize)) as usize].end as usize]);
                }
            }
        }
        err_help(c")", pcx);
    }
}

// Named argument `arg` comes after one of a later parameter.
fn order_error(n: i64, f: i64, arg: i64, text: *mut i64, first_param: i64, params: i64,
    pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[arg as usize].start, pcx);
    err_str(c"named argument '", pcx);
    err_sym(pcx.nodes[arg as usize].a, pcx);
    err_str(c"' is out of order: named arguments follow the parameters of '", pcx);
    err_sym(pcx.fns[f as usize].display, pcx);
    err_str(c"'", pcx);
    err_help(c"write '", pcx);
    help_call(n, pcx.fns[f as usize].node, text, first_param, params, -1, pcx);
    err_help(c"'", pcx);
    err_end(pcx)
}

// RULE: F33.1 (0.28.0: no parameter has a default value. Std's macro-like
// panic functions, Rust's macros of the same names, are the one exception,
// by name and not by syntax: `assert`, `assert_eq`, `assert_ne`,
// `debug_assert`, `unreachable`, `todo`, `unimplemented` and
// `__assert_fmt` take their message `msg` and their position `at` as an
// empty string when the call leaves them out, `assert(ok)`,
// `unreachable()`.) Whether parameter k of f (its Fn node) is such a one.
fn macro_message(f: i64, node: i64, k: i64, pcx: &Ctx<Comp>) -> bool {
    if !crate::front::modules::within_std(pcx.fns[f as usize].module, pcx)
        || pcx.fns[f as usize].self_ty > 0 {
        return false;
    }
    let p = sym_text(pcx.nodes[child(node, k, pcx) as usize].a, pcx);
    if !(p == b"msg" || p == b"at") {
        return false;
    }
    let name = sym_text(crate::places::front::fn_name_sym(f, pcx), pcx);
    name == b"assert" || name == b"assert_eq" || name == b"assert_ne" || name == b"debug_assert"
        || name == b"unreachable" || name == b"todo" || name == b"unimplemented"
        || name == b"__assert_fmt"
}

// Parameter k of f is given no argument and has no default.
fn missing_error(n: i64, f: i64, node: i64, k: i64, text: *mut i64, first_param: i64,
    params: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"missing argument '", pcx);
    err_sym(pcx.nodes[child(node, k, pcx) as usize].a, pcx);
    err_str(c"' of '", pcx);
    err_sym(pcx.fns[f as usize].display, pcx);
    err_str(c"'", pcx);
    err_help(c"give it: '", pcx);
    help_call(n, node, text, first_param, params, k, pcx);
    err_help(c"'", pcx);
    err_end(pcx)
}

// Whether argument `arg` is a parameter's default put into its call.
pub fn is_default_arg(arg: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.defaults_used && pcx.default_args.get(arg + 1) != 0
}

// Default `arg` (is_default_arg) checked against its parameter's type ty
// (of the instance called): in its function's module, with its `Self`,
// without the caller's locals, outside `unsafe`.
pub fn check_default_arg(arg: i64, ty: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let f = pcx.default_args.get(arg + 1) - 1;
        let saved_mod = pcx.cur_mod;
        let saved_self = pcx.self_type;
        let saved_unsafe = pcx.unsafe_depth;
        let saved_env = pcx.env;
        pcx.env = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        pcx.cur_mod = pcx.fns[f as usize].module;
        pcx.self_type = pcx.fns[f as usize].self_ty;
        pcx.self_impl = crate::front::traits::impl_of_fn(f, pcx);
        pcx.unsafe_depth = 0;
        check_expr(arg, ty, pcx);
        free(pcx.env.data as *mut u8);
        pcx.env = saved_env;
        pcx.unsafe_depth = saved_unsafe;
        pcx.self_type = saved_self;
        pcx.cur_mod = saved_mod;
    }
}

// The defaults of function f's parameters (a FNS index; called once its
// signature is resolved): on trailing parameters only, naming no
// parameter. (Their types: check_default_types, with the body.)
pub fn check_param_defaults(f: i64, pcx: &mut Ctx<Comp>) {
    let node = pcx.fns[f as usize].node;
    if pcx.nodes[node as usize].kind != NodeKind::Fn {
        return;
    }
    let mut with_default: i64 = -1;
    for i in 0..pcx.nodes[node as usize].count {
        let p = child(node, i, pcx);
        if pcx.nodes[p as usize].h != 0 {
            with_default = i;
            let used = param_use(pcx.nodes[p as usize].h, node, pcx);
            if used != 0 {
                err_begin(pcx.nodes[used as usize].start, pcx);
                err_str(c"the default of '", pcx);
                err_sym(pcx.nodes[p as usize].a, pcx);
                err_str(c"' uses parameter '", pcx);
                err_sym(pcx.nodes[used as usize].a, pcx);
                err_str(c"': a default is computed without the arguments", pcx);
                err_help(
                    c"compute it in the body from an Option parameter, or give it a constant", pcx);
                err_end_soft(pcx);
            }
        } else if with_default >= 0 {
            err_begin(pcx.nodes[p as usize].start, pcx);
            err_str(c"parameter '", pcx);
            err_sym(pcx.nodes[p as usize].a, pcx);
            err_str(c"' has no default, but '", pcx);
            err_sym(pcx.nodes[child(node, with_default, pcx) as usize].a, pcx);
            err_str(c"' before it has one: defaults are on the last parameters", pcx);
            err_help(c"give '", pcx);
            err_help_sym(pcx.nodes[p as usize].a, pcx);
            err_help(c"' a default too, or move it before '", pcx);
            err_help_sym(pcx.nodes[child(node, with_default, pcx) as usize].a, pcx);
            err_help(c"'", pcx);
            err_end_soft(pcx);
            return;
        }
    }
}

// An Ident in expression e that names a parameter of function node `node`
// (0: none).
fn param_use(e: i64, node: i64, pcx: &Ctx<Comp>) -> i64 {
    if e == 0 {
        return 0;
    }
    let kind = pcx.nodes[e as usize].kind;
    if kind == NodeKind::Ident {
        return if param_named(node, pcx.nodes[e as usize].a, pcx) >= 0 { e } else { 0 };
    }
    if kind == NodeKind::Closure {
        return 0;
    }
    let mut found: i64 = 0;
    if node_field_a(kind) {
        found = param_use(pcx.nodes[e as usize].a, node, pcx);
    }
    if found == 0 && node_field_b(kind) {
        found = param_use(pcx.nodes[e as usize].b, node, pcx);
    }
    if found == 0 && node_field_c(kind) {
        found = param_use(pcx.nodes[e as usize].c, node, pcx);
    }
    let mut i: i64 = 0;
    while found == 0 && i < pcx.nodes[e as usize].count {
        found = param_use(child(e, i, pcx), node, pcx);
        i += 1;
    }
    found
}

// The types of function f's defaults (f an instance, or not generic),
// checked when its body is (a copy of each, against the parameter's type,
// as a call would check it): before its parameters are locals.
pub fn check_default_types(item: i64, f: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[item as usize].kind != NodeKind::Fn {
        return;
    }
    for i in 0..pcx.nodes[item as usize].count {
        let h = pcx.nodes[child(item, i, pcx) as usize].h;
        if h != 0 && param_use(h, item, pcx) == 0 {
            let saved_unsafe = pcx.unsafe_depth;
            pcx.unsafe_depth = 0;
            check_expr(clone_node(h, pcx), fn_param(f, i, pcx), pcx);
            pcx.unsafe_depth = saved_unsafe;
        }
    }
}

// A named argument outside the arguments of a function's call (of a
// closure, a variant, a function value).
pub fn misplaced_named_arg(n: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"named argument '", pcx);
    err_sym(pcx.nodes[n as usize].a, pcx);
    err_str(c"': only the calls of functions and methods name their arguments", pcx);
    err_help(c"write '", pcx);
    buf_bytes(pcx.err_help,
        &get_src()[
            pcx.nodes[pcx.nodes[n as usize].b as usize].start as usize..pcx.nodes[
                pcx.nodes[n as usize].b as usize].end as usize]);
    err_help(c"' without its name", pcx);
    err_end(pcx)
}

// The shorthand fields of struct literal n (`P { x, y }`): a name that is
// neither a local nor an item gets the long form as its help.
pub fn check_shorthands(n: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        let init = child(n, i, pcx);
        if (pcx.nodes[init as usize].p & FIELD_SHORTHAND) != 0 {
            let name = pcx.nodes[init as usize].a;
            if lookup_local(name, pcx).is_none()
                && binding_kind(lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, pcx)) == B_NONE {
                err_begin(pcx.nodes[init as usize].start, pcx);
                err_str(c"undefined variable '", pcx);
                err_sym(name, pcx);
                err_str(c"' (the shorthand of '", pcx);
                err_sym(name, pcx);
                err_str(c": ", pcx);
                err_sym(name, pcx);
                err_str(c"')", pcx);
                err_help(c"write '", pcx);
                err_help_sym(name, pcx);
                err_help(c": VALUE'", pcx);
                err_end(pcx);
            }
        }
    }
}

// (0.15) The help of `i64::MAX()`: an integer type's MAX and MIN are
// constants (`int_limit`), written without parentheses.
pub fn int_limit_help(t: i64, member: i64, pcx: &mut Ctx<Comp>) {
    if !is_integer(t) || !sym_is_c(member, c"MAX", pcx) && !sym_is_c(member, c"MIN", pcx) {
        return;
    }
    err_help(c"a constant, without (): '", pcx);
    buf_type(pcx.err_help, t, pcx);
    err_help(c"::", pcx);
    err_help_sym(member, pcx);
    err_help(c"'", pcx);
}
