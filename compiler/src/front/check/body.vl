// Function bodies and control flow: a function's body checked against its
// return type, blocks (their scopes, unsafe blocks, recovery at each
// statement), statements (`let`, `defer`), `if` in both modes, loops and
// the jumps out of them (`break`, `continue`, `return`).

use crate::base::{SRC, _setjmp, buf_fmt, buf_new, buf_slice};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fix, err_help, err_str, err_sym, err_try_fmt,
    recover_enter, recover_leave,
};
use crate::front::ast::{
    BLOCK_UNSAFE, CONV_INOUT, CONV_NEW, FN_LAZY, FN_UNSAFE, NODE_CHECKED, NODE_REF, NodeKind, child,
    new_node,
};
use crate::front::ast::NodeKind::{Block, Defer, Ident, If, Let, Loop, PatTuple, Path, Range, While};
use crate::front::check::{
    check_recovering, define_local, lookup_local, mismatch_error, name_error, poison_statement,
    pop_scope, push_scope, restore_check_state, save_check_state, type_error, type_error_got,
};
use crate::front::check::args::check_default_types;
use crate::front::check::check_mode::check_expr;
use crate::front::check::iterate::check_for_iter;
use crate::front::check::resolve::resolve_type;
use crate::front::check::synth_mode::{
    is_context_literal, is_context_value, literal_takes_rhs_type, synth_expr,
};
use crate::front::check::unsafety::{
    audit_checked, is_borrow_param, pointee_is_param, written_param,
};
use crate::front::check::widen::{join_values, widens};
use crate::front::closures::escape::check_scope_exit;
use crate::front::closures::scoped::check_scope_instance;
use crate::front::conv::borrowed_place;
use crate::front::generics::{env_enter, env_leave, template_of_key};
use crate::front::lexer::Tok;
use crate::front::modules::lookup::{B_ITEM, B_TVARIANT, binding_kind, binding_value, lookup_quiet};
use crate::front::own::drops::{after_stmt, after_tail, block_begin, param_drops};
use crate::front::patterns::{check_irrefutable, check_pattern};
use crate::front::traits::bounded_param_of_type;
use crate::front::types::{
    REF_MUT, TY_BOOL, TY_I64, TY_NEVER, TY_UNIT, TY_USIZE, TyKind, buf_type, err_type, fn_param,
    is_integer, is_numeric,
};

// ---- Functions ----

pub fn check_function(item: i64, pcx: inout Ctx<Comp>) {
    let f = pcx.nodes[item].x - 1;
    pcx.cur_mod = pcx.fns[f].module;
    var saved_env = pcx.tp_base;
    if pcx.fns[f].tmpl != 0 {
        // An instance: its template's parameters stand for its arguments.
        saved_env = env_enter(pcx.nodes[pcx.fns[pcx.fns[f].tmpl - 1].node].g, pcx.fns[f].targs,
            pcx.fns[f].targ_count, &pcx);
        pcx.cur_inst = f;
        // (0.16: a scope's body passed by name)
        check_scope_instance(f, &pcx);
    } else if (pcx.nodes[item].p & FN_LAZY) != 0 {
        // (0.14: a lazy default, checked when used: as an instance, for
        // the notes of its errors)
        pcx.cur_inst = f;
    }
    pcx.self_type = pcx.fns[f].self_ty;
    pcx.self_impl = crate::front::traits::impl_of_fn(f, pcx);
    pcx.return_type = pcx.fns[f].ret;
    crate::front::opaque::body_begin(f, &pcx);
    // (0.14: for the closures in it; a lazy default is checked inside
    // another function)
    let saved_fn = pcx.cur_fn;
    let saved_base = pcx.loop_base;
    pcx.cur_fn = f;
    // (0.17: the own pass's record starts, front/own/fast.vl)
    crate::front::own::fast::check_begin(f, &pcx);
    pcx.loop_base = 0;
    pcx.loop_stack.count = 0;
    pcx.env.count = 0;
    pcx.check_scopes.count = 0;
    pcx.const_ptrs.count = 0;
    // (0.15: the defaults' types, without the parameters)
    check_default_types(item, f, &pcx);
    for i in 0..pcx.nodes[item].count {
        let param = child(item, i, pcx);
        if pcx.nodes[param].a != pcx.underscore {
            pcx.nodes[param].x = define_local(pcx.nodes[param].a, fn_param(f, i, pcx),
                pcx.nodes[param].c != 0, true, &pcx);
            pcx.locals[pcx.nodes[param].x].borrow = is_borrow_param(param, pcx);
            crate::front::check::rust::note_const_ptr(pcx.nodes[param].x, pcx.nodes[param].b, &pcx);
            pcx.locals[pcx.nodes[param].x].tparam = bounded_param_of_type(pcx.nodes[param].b,
                pcx);
            pcx.locals[pcx.nodes[param].x].twritten = written_param(pcx.nodes[param].b, -1,
                pcx);
            pcx.locals[pcx.nodes[param].x].tnode = pcx.nodes[param].b;
            // (0.20) a let or inout parameter that is a reference: used as
            // the value it designates (front/conv, names: synth_name)
            pcx.locals[pcx.nodes[param].x].access =
                crate::front::conv::param_is_access(param, fn_param(f, i, pcx), pcx);
            pcx.locals[pcx.nodes[param].x].is_sink =
                crate::front::conv::param_conv(param, pcx) == crate::front::conv::CONV_SINK_K;
        } else {
            pcx.nodes[param].x = -1;
        }
    }
    pcx.unsafe_depth = if (pcx.fns[f].attrs & FN_UNSAFE) != 0 { 1 } else { 0 };
    pcx.wrap_node = 0;
    let body = pcx.nodes[item].c;
    if pcx.unsafe_depth > 0 {
        audit_checked(pcx.nodes[body].start, &pcx);
    }
    // (0.17, T1: the by-value parameters' drops, front/own/drops)
    param_drops(item, f, &pcx);
    crate::front::check::assign::clear_inout_places(&pcx);
    let deferred_at = pcx.deferred.count;
    let open_at = pcx.open_lets.count;
    // RULE: F18.6 (the type variables the body makes are its own)
    let infer_at = crate::front::check::infer::begin(&pcx);
    // RULE: D21.2 (an `impl Tr` result: the body's type is the hidden type,
    // front/opaque.vl)
    let opaque = crate::front::opaque::has_opaque_result(f, pcx);
    let tail = pcx.nodes[body].a;
    let body_ty = check_block(body,
        if opaque { crate::front::opaque::tail_expected(f, pcx) } else { pcx.return_type }, &pcx);
    // (0.27.1) a deferred `let x;` never assigned: its type is not known
    // (rustc E0282)
    var i = deferred_at;
    while i + 1 < pcx.deferred.count {
        let l = pcx.deferred.get(i);
        let pos = pcx.deferred.get(i + 1);
        i += 2;
        if pcx.locals[l].ty == 0 {
            pcx.locals[l].ty = pcx.ty_error;
            err_begin(pos, &pcx);
            err_str(c"the type of '", pcx);
            err_sym(pcx.locals[l].name, pcx);
            err_str(c"' is not known: it is never assigned", pcx);
            err_help(c"write its type, `let x: T;`, or assign it", pcx);
            err_end_soft(&pcx);
        }
    }
    // RULE: F18.5 (what is still open has the fallback)
    crate::front::check::literals::open_end(open_at, &pcx);
    // RULE: F18.6 (what is still free is an error; the rest is retyped)
    crate::front::check::infer::end(infer_at, &pcx);
    // (0.25: the inout accesses of let places, assign::check_inout_place)
    crate::front::check::assign::flush_inout_places(&pcx);
    if opaque {
        crate::front::opaque::result_value(if tail != 0 { tail } else { body }, body_ty,
            pcx.return_type, &pcx);
        crate::front::opaque::check_hidden_bounds(f, &pcx);
    } else if body_ty != pcx.return_type && body_ty != TY_NEVER {
        err_begin(pcx.nodes[body].start, &pcx);
        err_str(c"function '", pcx);
        err_sym(pcx.nodes[item].a, pcx);
        err_str(c"' body has type '", pcx);
        err_type(body_ty, pcx);
        err_str(c"', expected '", pcx);
        err_type(pcx.return_type, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
    pcx.self_type = 0;
    pcx.cur_fn = saved_fn;
    crate::front::own::fast::check_end(&pcx);
    pcx.loop_base = saved_base;
    if pcx.fns[f].tmpl != 0 {
        env_leave(saved_env, &pcx);
    }
    pcx.cur_inst = -1;
    pcx.cur_mod = 0;
}

// The type of a block; `expected` (0 for none) goes to its tail.
pub fn check_block(block: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        push_scope(&pcx);
        let locals = pcx.locals.len() as i64;
        let is_unsafe = (pcx.nodes[block].p & BLOCK_UNSAFE) != 0;
        if is_unsafe {
            pcx.unsafe_depth += 1;
            audit_checked(pcx.nodes[block].start, &pcx);
        }
        let saved_wrap = pcx.wrap_node;
        var diverges = false;
        // (0.17, T1: its statements' temporaries and borrowing bindings,
        // front/own/drops; the places IR drops its owned locals)
        let drops = block_begin(block, &pcx);
        // (0.18.1: `&f(x)`, a temporary)
        crate::front::check::temps::hoist_temporaries(block, &pcx);
        for i in 0..pcx.nodes[block].count {
            // A recovery point: after an error, on at the next statement. A
            // block with a statement that failed counts as diverging, which
            // reports nothing more about its type.
            let stmt = child(block, i, pcx);
            let depth = pcx.recover_depth;
            let state = save_check_state(pcx);
            var result = false;
            pcx.wrap_node = stmt;
            if _setjmp(recover_enter(&pcx)) == 0 {
                result = check_stmt(stmt, &pcx);
                after_stmt(drops, stmt, &pcx);
            } else {
                restore_check_state(state, &pcx);
                poison_statement(stmt, &pcx);
                result = true;
            }
            recover_leave(depth, &pcx);
            if result {
                diverges = true;
            }
        }
        let tail = pcx.nodes[block].a;
        var ty = TY_UNIT;
        if tail != 0 {
            pcx.wrap_node = tail;
            // RULE: D21.4, D20.3 (the tail closure of a function with an
            // `impl Fn*` result: its bound's parameter types)
            if expected == 0 && pcx.cur_fn >= 0 && block == pcx.nodes[pcx.fns[pcx.cur_fn].node].c
                && crate::front::opaque::has_opaque_result(pcx.cur_fn, pcx) {
                crate::front::opaque::closure_value(tail, pcx.fns[pcx.cur_fn].ret, &pcx);
            }
            ty = if expected != 0 { check_expr(tail, expected, &pcx) }
                else { synth_expr(tail, &pcx) };
            check_scope_exit(ty, locals, pcx.nodes[tail].start, &pcx);
            after_tail(drops, block, &pcx);
        }
        pcx.wrap_node = saved_wrap;
        if is_unsafe {
            pcx.unsafe_depth -= 1;
        }
        pop_scope(&pcx);
        pcx.nodes[block].ty = if diverges { TY_NEVER } else { ty };
        pcx.nodes[block].ty
    }
}

pub fn check_branch(block: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    let ty = check_block(block, expected, &pcx);
    // RULE: F18.6 (a) (a later arm against the first's type)
    if ty != expected && ty != TY_NEVER && pcx.infer_live
        && crate::front::check::infer::unify(ty, expected, &pcx) {
        return crate::front::check::infer::resolve(expected, &pcx);
    }
    if ty != expected && ty != TY_NEVER {
        mismatch_error(block, expected, ty, &pcx);
    }
    ty
}

// Whether the statement diverges.
fn check_stmt(stmt: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[stmt].kind == Let {
        return check_let(stmt, &pcx);
    }
    if pcx.nodes[stmt].kind == Defer {
        return check_defer(stmt, &pcx);
    }
    let expr = pcx.nodes[stmt].a;
    let ty = if pcx.nodes[stmt].b != 0 { synth_expr(expr, &pcx) }
        else { check_expr(expr, TY_UNIT, &pcx) };
    ty == TY_NEVER
}

// A `defer` (error syntax.defer since 0.26.2; nothing else makes one):
// its body, checked.
fn check_defer(stmt: i64, pcx: inout Ctx<Comp>) -> bool {
    synth_expr(pcx.nodes[stmt].a, &pcx);
    false
}

fn check_let(stmt: i64, pcx: inout Ctx<Comp>) -> bool {
    let init = pcx.nodes[stmt].c;
    if init == 0 {
        // (0.27.1) the rust edition's deferred initialization, `let x: T;`:
        // its binding typed, its value the first assignment's (the
        // borrow checker checks no read comes first, D8)
        // (`let x;`: its type the first assignment's, check_assign)
        let pat = pcx.nodes[stmt].a;
        if pcx.nodes[pat].kind != NodeKind::PatBind {
            err_begin(pcx.nodes[stmt].start, &pcx);
            err_str(c"a 'let' without a value binds one name: 'let x: T;' or 'let x;'", pcx);
            err_help(c"bind one name, or give it its value here", pcx);
            err_end_soft(&pcx);
            return false;
        }
        let t = if pcx.nodes[stmt].b != 0 { resolve_type(pcx.nodes[stmt].b, &pcx) } else { 0 };
        check_pattern(pat, t, &pcx);
        if pcx.nodes[pat].x >= 0 {
            pcx.deferred.push(pcx.nodes[pat].x);
            pcx.deferred.push(pcx.nodes[stmt].start);
        }
        return false;
    }
    var binding_ty = 0;
    var actual = 0;
    if pcx.nodes[stmt].b != 0 {
        binding_ty = resolve_type(pcx.nodes[stmt].b, &pcx);
        // RULE: F21.2 (the rust edition: no local of an unsized type)
        if pcx.edition != 0 {
            crate::front::check::rust::check_sized(pcx.nodes[stmt].b, c"a local", &pcx);
        }
        // (0.27.1: a written type, R5 closed in the rust edition)
        let saved = pcx.rust_arg;
        pcx.rust_arg = if crate::front::check::rust::rust_node(init, &pcx) { init } else { 0 };
        actual = check_expr(init, binding_ty, &pcx);
        pcx.rust_arg = saved;
    } else {
        // (0.27.3: a literal of its tree may not fit the fallback, F18.5)
        if pcx.open_hints.count > 0 && pcx.open_lets.count > 0 {
            crate::front::check::literals::open_hint(stmt, init, &pcx);
        }
        let saved_init = pcx.open_init;
        pcx.open_init = init;
        // (`let r = &x;` of an open x keeps it open: open_let decides)
        pcx.open_keep = crate::front::check::literals::open_borrow_init(init, pcx)
            && crate::front::check::rust::rust_node(stmt, &pcx);
        binding_ty = synth_expr(init, &pcx);
        pcx.open_keep = false;
        pcx.open_init = saved_init;
        actual = binding_ty;
    }
    let borrowed = pcx.nodes[stmt].b == 0 && let_part(stmt, init, binding_ty, &pcx);
    if borrowed {
        binding_ty = synth_expr(init, &pcx);
        actual = binding_ty;
    }
    check_pattern(pcx.nodes[stmt].a, binding_ty, &pcx);
    if pcx.nodes[pcx.nodes[stmt].a].kind == NodeKind::PatBind {
        crate::front::check::rust::note_const_ptr(pcx.nodes[pcx.nodes[stmt].a].x, pcx.nodes[stmt].b,
            &pcx);
    }
    // RULE: F18.5 (an unannotated `let` of a literal tree: an open local)
    if pcx.nodes[stmt].b == 0 && crate::front::check::rust::rust_node(stmt, &pcx) {
        let bound = if !borrowed && pcx.nodes[pcx.nodes[stmt].a].kind == NodeKind::PatBind {
            pcx.nodes[pcx.nodes[stmt].a].x } else { -1 };
        crate::front::check::literals::open_let(bound, init, &pcx);
    }
    if borrowed && pcx.nodes[pcx.nodes[stmt].a].x >= 0 {
        pcx.locals[pcx.nodes[pcx.nodes[stmt].a].x].access = true;
    }
    check_irrefutable(pcx.nodes[stmt].a, c"let", &pcx);
    let pat = pcx.nodes[stmt].a;
    // (0.20) `inout x = &place;`: x is an exclusive access, used as the
    // value it designates (front/conv)
    if (pcx.nodes[stmt].p & CONV_INOUT) != 0 && pcx.nodes[pat].kind == NodeKind::PatBind
        && pcx.nodes[pat].x >= 0 {
        if binding_ty > 0 && pcx.types[binding_ty].kind == TyKind::Ptr
            && pcx.types[binding_ty].b == REF_MUT {
            pcx.locals[pcx.nodes[pat].x].access = true;
        } else if binding_ty > 0 && binding_ty != pcx.ty_error
            && !(pcx.types[binding_ty].kind == TyKind::Slice
                && pcx.types[binding_ty].b == REF_MUT) {
            crate::front::conv::conv_error(crate::front::conv::CODE_PLACE,
                pcx.nodes[init].start, pcx.nodes[init].end,
                "an inout binding is an exclusive access of a place: 'inout x = &place;'",
                "lend the place with '&', or bind a copy with 'var x = ..'", "", &pcx);
        }
    }
    // (0.25) `inout r = &make()` binds a temporary (no conv.place);
    // `let r = &x` is a let access of x, not an inout one
    if pcx.nodes[init].kind == NodeKind::Unary && pcx.nodes[init].op == Tok::Amp {
        pcx.let_amps.push(init);
        if (pcx.nodes[stmt].p & CONV_INOUT) == 0 {
            pcx.raw_addrs.push(init);
        }
    }
    // (0.17) `let p = &v;`: v, for an error indexing through p
    if pcx.nodes[pat].kind == NodeKind::PatBind && pcx.nodes[pat].b == 0
        && pcx.nodes[init].kind == NodeKind::Unary && pcx.nodes[init].op == Tok::Amp {
        pcx.locals[pcx.nodes[pat].x].init = pcx.nodes[init].b;
    }
    // (0.17) `let p: *T = ..` or `let p = self.ptr;`: p points, as
    // written, to a type parameter
    if pcx.nodes[pat].kind == NodeKind::PatBind {
        pcx.locals[pcx.nodes[pat].x].twritten = if pcx.nodes[stmt].b != 0 {
            written_param(pcx.nodes[stmt].b, -1, pcx)
        } else if pointee_is_param(init, &pcx) { 1 } else { 0 };
        // RULE: Z9.1c (0.27.5: `let t: &T = ..` of a bounded parameter T: a
        // receiver `t` is T's in an instance too, as a parameter `t: &T` is,
        // front/convert: dispatch)
        let ann = pcx.nodes[stmt].b;
        pcx.locals[pcx.nodes[pat].x].tnode = ann;
        if ann != 0 && pcx.nodes[ann].kind == NodeKind::TyPtr && (pcx.nodes[ann].p & NODE_REF) != 0
            && crate::front::check::rust::rust_node(stmt, &pcx) {
            let tp = crate::front::traits::bounded_param_of_type(ann, pcx);
            if tp != 0 {
                pcx.locals[pcx.nodes[pat].x].borrow = true;
                pcx.locals[pcx.nodes[pat].x].tparam = tp;
            }
        }
    }
    actual == TY_NEVER
}

// (0.20, conventions.md D13) `let x = part;` in a 0.20 file, where part is
// a place of an owned (or move-only) value that the function cannot take:
// an element (`rows[0]`), a field reached through an access or a pointer,
// a let parameter. 0.19 rejected it (own.move_out); here x borrows it: init
// becomes `&part`, and x an access (the caller sets Local.access). Whatever
// the function owns (a local, a sink parameter, their fields) still moves.
// (0.25.2) In std too: until 0.25.2 std was exempt, and there the same
// line was a copy of the element's bits that the scope then dropped while
// the collection still owned it (std::gpu::wgsl freed parts of its module
// on every translation). A move of the bits that std means, its
// containers' and iterators', is written as one: a read through a raw
// pointer (`let at: *T = &v[i]; let x = unsafe { *at };`, borrowed_place).
fn let_part(stmt: i64, init: i64, ty: i64, pcx: inout Ctx<Comp>) -> bool {
    let pat = pcx.nodes[stmt].a;
    if pcx.nodes[pat].kind != NodeKind::PatBind || pcx.nodes[pat].b != 0 || ty <= 0
        || ty == pcx.ty_error || (pcx.nodes[stmt].p & CONV_NEW) != 0
        || !crate::front::conv::strict_at(pcx.nodes[stmt].start, &pcx)
        || crate::front::conv::copyable(ty, &pcx) || !borrowed_place(init, pcx) {
        return false;
    }
    let inner = new_node(NodeKind::None, pcx.nodes[init].start, pcx.nodes[init].end, &pcx);
    pcx.nodes[inner] = pcx.nodes[init];
    pcx.nodes[inner].p |= NODE_CHECKED;
    pcx.nodes[inner].ty = ty;
    pcx.nodes[init].kind = NodeKind::Unary;
    pcx.nodes[init].op = Tok::Amp;
    pcx.nodes[init].a = 0;
    pcx.nodes[init].b = inner;
    pcx.nodes[init].count = 0;
    pcx.nodes[init].list = 0;
    pcx.nodes[init].p = 0;
    true
}

pub fn check_if(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    check_recovering(pcx.nodes[n].a, TY_BOOL, &pcx);
    let else_block = pcx.nodes[n].c;
    if else_block == 0 {
        if expected != TY_UNIT {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"if without else must have type '()', expected '", pcx);
            err_type(expected, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        check_branch(pcx.nodes[n].b, TY_UNIT, &pcx);
        return expected;
    }
    let then_ty = check_branch(pcx.nodes[n].b, expected, &pcx);
    let else_ty = check_branch(else_block, expected, &pcx);
    if then_ty == TY_NEVER && else_ty == TY_NEVER { TY_NEVER } else { expected }
}

// Whether block b ends in a variant of a generic enum named without its
// type arguments (`None`, `Option::None`): its type comes from context.
fn tail_needs_context(b: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[b].kind != Block {
        return false;
    }
    let tail = pcx.nodes[b].a;
    tail != 0 && names_context_variant(tail, &pcx)
}

// Whether expression e is a variant of a generic enum named without its
// type arguments (`None`, `Option::None`): its type comes from context.
pub fn names_context_variant(e: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[e].g != 0 {
        return false;
    }
    if pcx.nodes[e].kind == Ident {
        if lookup_local(pcx.nodes[e].a, pcx).is_some() {
            return false;
        }
        return binding_kind(lookup_quiet(pcx.cur_mod, pcx.nodes[e].a, pcx.cur_mod, &pcx))
            == B_TVARIANT;
    }
    if pcx.nodes[e].kind == Path && pcx.nodes[e].count == 0 && pcx.nodes[e].y == 0 {
        let b2 = lookup_quiet(pcx.cur_mod, pcx.nodes[e].a, pcx.cur_mod, &pcx);
        return binding_kind(b2) == B_ITEM && template_of_key(binding_value(b2), pcx) < 0;
    }
    false
}

// Whether branch b of an if takes its type from the other branch: it ends
// in a variant of a generic enum without its type arguments, or (0.14) its
// value is an unsuffixed literal, or (0.25.4) an array of them (also
// through an `else if` chain of them).
fn branch_takes_type(b: i64, pcx: inout Ctx<Comp>) -> bool {
    if tail_needs_context(b, &pcx) || is_context_value(b, pcx) {
        return true;
    }
    var e = b;
    if pcx.nodes[e].kind == Block && pcx.nodes[e].count == 0 && pcx.nodes[e].a != 0 {
        e = pcx.nodes[e].a;
    }
    pcx.nodes[e].kind == If && pcx.nodes[e].c != 0 && branch_takes_type(pcx.nodes[e].b, &pcx)
        && branch_takes_type(pcx.nodes[e].c, &pcx)
}

// (0.25.4) Whether branch b of an if is an array literal of unsuffixed
// literals (is_context_value; also through an `else if` chain of them)
// and the other branch's type `ty` an array: b is checked as a `ty`, so
// `if c { ACCENT } else { [0.2, 0.5, 0.7, 1.0] }` is a `[f32; 4]`.
fn literal_array_takes(b: i64, ty: i64, pcx: Ctx<Comp>) -> bool {
    if ty <= 0 || pcx.types[ty].kind != TyKind::Array {
        return false;
    }
    var e = b;
    if pcx.nodes[e].kind == Block && pcx.nodes[e].count == 0 && pcx.nodes[e].a != 0 {
        e = pcx.nodes[e].a;
    }
    if pcx.nodes[e].kind == If {
        return pcx.nodes[e].c != 0 && literal_array_takes(pcx.nodes[e].b, ty, pcx)
            && literal_array_takes(pcx.nodes[e].c, ty, pcx);
    }
    is_context_value(e, pcx) && !is_context_literal(e, pcx)
}

pub fn synth_if(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    check_recovering(pcx.nodes[n].a, TY_BOOL, &pcx);
    let then_block = pcx.nodes[n].b;
    let else_block = pcx.nodes[n].c;
    // (0.9) `if c { None } else { Some(x) }`, (0.14) `if c { 0 } else {
    // b[i] }`: the type from the other branch.
    var then_ty = 0;
    if else_block != 0 && pcx.nodes[else_block].kind == Block && branch_takes_type(then_block, &pcx)
        && !branch_takes_type(else_block, &pcx) {
        let else_ty = check_block(else_block, 0, &pcx);
        if else_ty == TY_NEVER {
            return check_block(then_block, 0, &pcx);
        }
        if tail_needs_context(then_block, &pcx) || is_numeric(else_ty)
            || literal_array_takes(then_block, else_ty, pcx) {
            check_branch(then_block, else_ty, &pcx);
            return else_ty;
        }
        then_ty = check_block(then_block, 0, &pcx);
        if then_ty == TY_NEVER {
            return else_ty;
        }
        // (0.15: two integer types join to the wider one)
        let joined = join_values(then_block, then_ty, else_block, else_ty, &pcx);
        if joined != 0 {
            return joined;
        }
        branch_types_error(n, then_ty, else_ty, &pcx);
    }
    then_ty = check_block(then_block, 0, &pcx);
    if else_block != 0 && then_ty != TY_NEVER && (branch_takes_type(else_block, &pcx)
        && (tail_needs_context(else_block, &pcx) || is_numeric(then_ty)
            || literal_array_takes(else_block, then_ty, pcx))
        // RULE: F18.1 (0.27.2, std2: the else branch is checked against
        // the then branch's type, `if c { p } else { null_mut() }`)
        || crate::front::known::on_std2(pcx) && then_ty != pcx.ty_error
        && pcx.nodes[else_block].kind == Block
        && crate::front::check::rust::rust_node(n, &pcx)) {
        // RULE: F18.5 (0.27.6: a tuple element the then branch gives by
        // literals alone takes the else branch's type there)
        let want = crate::front::check::literals::branch_expected(n, 1, else_block, then_ty, &pcx);
        check_branch(else_block, want, &pcx);
        if want != then_ty {
            return crate::front::check::literals::branch_settle(n, 1, else_block, then_ty, want,
                &pcx);
        }
        return then_ty;
    }
    if else_block == 0 {
        if then_ty != TY_UNIT && then_ty != TY_NEVER {
            type_error_got(n, c"if without else must have type '()'", then_ty, &pcx);
        }
        return TY_UNIT;
    }
    let else_ty = check_block(else_block, 0, &pcx);
    if then_ty == TY_NEVER {
        return else_ty;
    }
    if else_ty == TY_NEVER || then_ty == else_ty {
        return then_ty;
    }
    // (0.15: two integer types join to the wider one)
    let joined = join_values(then_block, then_ty, else_block, else_ty, &pcx);
    if joined != 0 {
        return joined;
    }
    branch_types_error(n, then_ty, else_ty, &pcx)
}

fn branch_types_error(n: i64, then_ty: i64, else_ty: i64, pcx: inout Ctx<Comp>) -> ! {
    // (0.25.4) a branch that is a local made of literals (`let base =
    // [0.2, 0.5, 0.7, 1.0];`, `[f64; 4]` beside a `[f32; 4]`): the
    // note at its `let`, as for a mismatch (literal_let), once
    let then_tail = branch_tail(pcx.nodes[n].b, pcx);
    let else_tail = branch_tail(pcx.nodes[n].c, pcx);
    var literal = crate::front::check::literals::literal_let(else_tail, then_ty, else_ty, &pcx);
    if literal == 0 {
        literal = crate::front::check::literals::literal_let(then_tail, else_ty, then_ty, &pcx);
    }
    if literal == 2 {
        crate::base::diag::err_jump(&pcx);
    }
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"if/else branches have different types: '", pcx);
    err_type(then_ty, pcx);
    err_str(c"' vs '", pcx);
    err_type(else_ty, pcx);
    err_str(c"'", pcx);
    // (0.15: integers that do not widen one to the other)
    if is_integer(then_ty) && is_integer(else_ty) {
        err_help(c"convert a branch explicitly: '", pcx);
        let wide = if widens(then_ty, TY_I64) && widens(else_ty, TY_I64) { TY_I64 }
            else { then_ty };
        err_help(c"as ", pcx);
        buf_type(pcx.err_help, wide, pcx);
        err_help(c"'", pcx);
    }
    // (0.26.2) a usize length and an i64: the length to i64, as `fix
    // --only usize` writes it
    let u = if then_ty == TY_USIZE && else_ty == TY_I64 { then_tail }
        else if else_ty == TY_USIZE && then_ty == TY_I64 { else_tail } else { 0 };
    if u > 0 && literal == 0 && pcx.nodes[u].end > pcx.nodes[u].start {
        let text = SRC[pcx.nodes[u].start..pcx.nodes[u].end];
        let t = buf_new();
        if crate::front::check::widen::operand_is_simple(u, pcx) {
            buf_fmt(t, format_args("{text} as i64"));
        } else {
            buf_fmt(t, format_args("({text}) as i64"));
        }
        err_try_fmt(buf_slice(t), pcx);
        err_fix(pcx.nodes[u].start, pcx.nodes[u].end, buf_slice(t), &pcx);
    }
    if literal == 1 {
        crate::front::check::literals::literal_help(pcx.nodes[n].start, &pcx);
    }
    err_end(&pcx)
}

// The value of branch b of an if: a block's last expression (0: none).
fn branch_tail(b: i64, pcx: Ctx<Comp>) -> i64 {
    if b <= 0 || pcx.nodes[b].kind != Block { b } else { pcx.nodes[b].a }
}

// ---- Loops and jumps ----

// (0.14) A closure's body is a function of its own.
fn leave_closure_error(n: i64, keyword: *u8, pcx: inout Ctx<Comp>) {
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"'", pcx);
    err_str(keyword, pcx);
    err_str(c"' cannot leave a closure (its body is a function of its own)", pcx);
    err_end(&pcx);
}

// The loop a `break`/`continue` refers to.
pub fn find_loop(n: i64, keyword: *u8, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let label = pcx.nodes[n].a;
        if label == 0 {
            if pcx.loop_stack.count == 0 {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(keyword, pcx);
                err_str(c" outside of loop", pcx);
                err_end(&pcx);
            }
            if pcx.loop_base >= pcx.loop_stack.count {
                leave_closure_error(n, keyword, &pcx);
            }
            return pcx.loop_stack.data[pcx.loop_stack.count - 1];
        }
        var i = pcx.loop_stack.count - 1;
        while i >= 0 {
            let lp = pcx.loop_stack.data[i];
            if pcx.nodes[lp].a == label {
                if pcx.loop_base > i {
                    leave_closure_error(n, keyword, &pcx);
                }
                return lp;
            }
            i -= 1;
        }
        name_error(pcx.nodes[n].start, c"unknown loop label ':", label, c"'", &pcx)
    }
}

fn check_loop_body(lp: i64, body: i64, pcx: inout Ctx<Comp>) {
    pcx.loop_stack.push(lp);
    check_branch(body, TY_UNIT, &pcx);
    pcx.loop_stack.pop();
}

// `loop`; `expected` (0 for none) is the type of its break values.
pub fn check_loop(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    pcx.nodes[n].x = 0;
    pcx.nodes[n].y = expected;
    // (0.14: the locals declared in it are those from d on; see
    // check_break)
    pcx.nodes[n].d = pcx.locals.len() as i64;
    check_loop_body(n, pcx.nodes[n].b, &pcx);
    if pcx.nodes[n].x == 0 {
        return TY_NEVER;
    }
    if pcx.nodes[n].y == 0 { TY_UNIT } else { pcx.nodes[n].y }
}

pub fn check_while(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    check_recovering(pcx.nodes[n].b, TY_BOOL, &pcx);
    check_loop_body(n, pcx.nodes[n].c, &pcx);
    TY_UNIT
}

pub fn check_for(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let range = pcx.nodes[n].c;
    // (0.27.2: `for i in 0..`, a RangeFrom on std2, through its Iterator)
    if pcx.nodes[range].kind != Range || pcx.nodes[range].a == 0 || pcx.nodes[range].b == 0 {
        return check_for_each(n, &pcx);
    }
    let start = pcx.nodes[range].a;
    let end = pcx.nodes[range].b;
    var elem_ty = 0;
    // RULE: F18.5 (b) (an open local's start, as a literal, takes the
    // end's type: `for i in e0..np`)
    if literal_takes_rhs_type(start, end, pcx) || pcx.open_lets.count > 0
        && crate::front::check::literals::open_local(start, pcx) >= 0
        && !crate::front::check::widen::takes_context(end, &pcx) {
        elem_ty = synth_expr(end, &pcx);
        check_expr(start, elem_ty, &pcx);
    } else {
        elem_ty = synth_expr(start, &pcx);
        check_expr(end, elem_ty, &pcx);
    }
    if !is_integer(elem_ty) {
        type_error_got(range, c"range bounds must be integers", elem_ty, &pcx);
    }
    pcx.nodes[range].ty = elem_ty;
    let pattern = pcx.nodes[n].b;
    if pcx.nodes[pattern].kind == PatTuple {
        type_error(pattern, c"a 'for' loop over a range binds one integer, not a tuple", &pcx);
    }
    push_scope(&pcx);
    check_pattern(pattern, elem_ty, &pcx);
    check_irrefutable(pattern, c"for", &pcx);
    check_loop_body(n, pcx.nodes[n].d, &pcx);
    pop_scope(&pcx);
    TY_UNIT
}

// `for p in e` where e is not a range literal (0.4: slices and arrays;
// 0.14: iterators, Vec, ranges as values, ...): e is checked here, once,
// and the loop desugared by its type (iterate.vl).
fn check_for_each(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    if check_recovering(pcx.nodes[n].c, 0, &pcx) == pcx.ty_error {
        // (after an error in the sequence, the body is checked too)
        push_scope(&pcx);
        check_pattern(pcx.nodes[n].b, pcx.ty_error, &pcx);
        check_loop_body(n, pcx.nodes[n].d, &pcx);
        pop_scope(&pcx);
        return TY_UNIT;
    }
    check_for_iter(n, &pcx)
}

pub fn check_break(n: i64, pcx: inout Ctx<Comp>) {
    let lp = find_loop(n, c"break", &pcx);
    pcx.nodes[n].x = lp;
    let value = pcx.nodes[n].b;
    if value != 0 {
        if pcx.nodes[lp].kind != Loop {
            err_begin(pcx.nodes[value].start, &pcx);
            err_str(c"'break' with a value is only allowed in 'loop', not in '", pcx);
            err_str(if pcx.nodes[lp].kind == While { c"while" } else { c"for" }, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        let ty = if pcx.nodes[lp].y != 0 { check_expr(value, pcx.nodes[lp].y, &pcx) }
            else { synth_expr(value, &pcx) };
        if pcx.nodes[lp].y == 0 && ty != TY_NEVER {
            pcx.nodes[lp].y = ty;
        }
        check_scope_exit(ty, pcx.nodes[lp].d, pcx.nodes[value].start, &pcx);
    } else if pcx.nodes[lp].kind == Loop {
        let ty = pcx.nodes[lp].y;
        if ty != 0 && ty != TY_UNIT && ty != TY_NEVER {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"expected '", pcx);
            err_type(ty, pcx);
            err_str(c"', got '()' (break without a value)", pcx);
            err_end(&pcx);
        }
        if ty == 0 {
            pcx.nodes[lp].y = TY_UNIT;
        }
    }
    pcx.nodes[lp].x = 1;
}

pub fn check_return(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let value = pcx.nodes[n].a;
    if value != 0 {
        let r = pcx.return_type;
        if crate::front::opaque::is_opaque(r, pcx)
            && crate::front::opaque::opaque_fn(r, pcx) == pcx.cur_fn {
            // RULE: D21.2 (the function's hidden type, front/opaque.vl)
            crate::front::opaque::closure_value(value, r, &pcx);
            let h = pcx.types[r].a;
            let saved = pcx.err_kind;
            if h != 0 {
                pcx.err_kind = c"opaque.mismatch";
            }
            let got = if h != 0 && h != pcx.ty_error { check_expr(value, h, &pcx) }
                else { synth_expr(value, &pcx) };
            pcx.err_kind = saved;
            crate::front::opaque::result_value(value, got, r, &pcx);
        } else {
            check_expr(value, r, &pcx);
        }
    } else if pcx.return_type != TY_UNIT && pcx.return_type != TY_NEVER {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"empty return in function returning '", pcx);
        err_type(pcx.return_type, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
    TY_NEVER
}
