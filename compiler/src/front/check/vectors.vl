// Vector operations (0.10).
//
// The vector types (`v2f64`, `v4f32`, `v2i64`, `v4i32`, `v8i16`, `v16i8`)
// have lanewise operators (`+ - *` on all of them, `/` on the float ones,
// `& | ^` on the integer ones, comparisons giving a mask: the integer
// vector of the lane width, each lane -1 or 0) and these operations, which
// become VecOp nodes: `vNtT(lanes...)`, `vNtT::splat(x)`,
// `vNtT::load(s, i)`, `v.store(s, i)`, `v.lane(i)`, `v.with_lane(i, x)`,
// `v.sum()`, `mask.select(a, b)`. Indices are i64.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_failed_name, err_help, err_int, err_str, err_sym};
use crate::front::ast::{
    VK_FROM_BITS, VK_LANE, VK_LOAD, VK_NEW, VK_SELECT, VK_SPLAT, VK_STORE, VK_SUM, VK_WITH, child,
};
use crate::front::ast::NodeKind::VecOp;
use crate::front::check::{name_error, type_error, type_error_got};
use crate::front::check::assign::{check_mutable_place, is_place};
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::lexer::Tok;
use crate::front::types::{
    TYPES, TY_BOOL, TY_I64, TY_NEVER, TY_UNIT, TyKind, err_type, is_float_vector, is_opaque_vector,
    is_vector, type_size, vec_elem, vec_lanes, vec_mask_type,
};

pub fn sym_is_c(sym: i64, s: *u8) -> bool {
    sym == intern_c(s)
}

// Turns call (or method call) n into a VecOp of kind `kind` on vector type
// `vt` (receiver: the method's receiver, or 0), and checks it.
pub fn make_vecop(n: i64, receiver: i64, kind: i64, vt: i64, pcx: inout Ctx<Comp>) -> i64 {
    pcx.nodes[n].kind = VecOp;
    pcx.nodes[n].a = receiver;
    pcx.nodes[n].b = 0;
    pcx.nodes[n].x = kind;
    pcx.nodes[n].y = vt;
    synth_vecop(n, &pcx)
}

pub fn vector_method(n: i64, name: i64, vt: i64, pcx: inout Ctx<Comp>) -> i64 {
    let receiver = pcx.nodes[n].a;
    if is_opaque_vector(vt) {
        // (0.19)
        opaque_lanes_error(pcx.nodes[n].start, vt, name, &pcx);
        synth_expr(receiver, &pcx);
        for i in 0..pcx.nodes[n].count {
            synth_expr(child(n, i, pcx), &pcx);
        }
        return pcx.ty_error;
    }
    if pcx.nodes[n].g != 0 {
        name_error(pcx.nodes[n].start, c"method '", name, c"' is not generic", &pcx);
    }
    if sym_is_c(name, c"lane") { return make_vecop(n, receiver, VK_LANE, vt, &pcx); }
    if sym_is_c(name, c"with_lane") { return make_vecop(n, receiver, VK_WITH, vt, &pcx); }
    if sym_is_c(name, c"sum") { return make_vecop(n, receiver, VK_SUM, vt, &pcx); }
    if sym_is_c(name, c"store") { return make_vecop(n, receiver, VK_STORE, vt, &pcx); }
    if sym_is_c(name, c"select") && !is_float_vector(vt) {
        return make_vecop(n, receiver, VK_SELECT, vt, &pcx);
    }
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"no method '", pcx);
    err_sym(name, pcx);
    err_failed_name(name, pcx);
    err_str(c"' on vector type '", pcx);
    err_type(vt, pcx);
    err_str(c"'", pcx);
    err_help(c"vectors have `lane(i)`, `with_lane(i, x)`, `sum()`, `store(slice, i)`, and masks `select(a, b)`", pcx);
    err_end(&pcx);
    vt
}

// `T::m(args)` for vector type vt: `splat(x)`, `load(s, i)`, `from_bits(v)`
// (0.10; 0.19: through an alias too, `uint8x16_t::from_bits(v)`; Intel's
// opaque types have only `from_bits`).
pub fn vector_assoc_call(n: i64, callee: i64, vt: i64, pcx: inout Ctx<Comp>) -> i64 {
    let member = pcx.nodes[callee].b;
    if pcx.nodes[callee].g != 0 {
        name_error(pcx.nodes[callee].start, c"'", pcx.nodes[callee].a, c"' takes no type arguments",
            &pcx);
    }
    if sym_is_c(member, c"from_bits") {
        return make_vecop(n, 0, VK_FROM_BITS, vt, &pcx);
    }
    let known = sym_is_c(member, c"splat") || sym_is_c(member, c"load");
    if known && is_opaque_vector(vt) {
        opaque_lanes_error(pcx.nodes[callee].start, vt, member, &pcx);
        for i in 0..pcx.nodes[n].count {
            synth_expr(child(n, i, pcx), &pcx);
        }
        return vt;
    }
    if sym_is_c(member, c"splat") {
        return make_vecop(n, 0, VK_SPLAT, vt, &pcx);
    }
    if sym_is_c(member, c"load") {
        return make_vecop(n, 0, VK_LOAD, vt, &pcx);
    }
    err_begin(pcx.nodes[callee].start, &pcx);
    err_str(c"no associated function '", pcx);
    err_sym(member, pcx);
    err_failed_name(member, pcx);
    err_str(c"' for vector type '", pcx);
    err_type(vt, pcx);
    err_str(c"'", pcx);
    err_help(c"vector types have `splat(x)`, `load(slice, index)` and `from_bits(v)`", pcx);
    err_end(&pcx);
    vt
}

// (0.19) `member` used on Intel's opaque vector type vt, which has no lanes.
fn opaque_lanes_error(pos: i64, vt: i64, member: i64, pcx: inout Ctx<Comp>) {
    err_begin(pos, &pcx);
    err_str(c"'", pcx);
    err_type(vt, pcx);
    err_str(c"' has no lanes, so no '", pcx);
    err_sym(member, pcx);
    err_str(c"': Intel's vector types are made, read and combined by their intrinsics", pcx);
    err_help(c"use the intrinsic (`_mm_set1_epi8(x)`, `_mm_loadu_si128(s, i)`, `_mm_storeu_si128(s, i, v)`), or convert to a vector with lanes: `v16u8::from_bits(v)`", pcx);
    err_end(&pcx);
}

fn vecop_arity(n: i64, want: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[n].count == want {
        return true;
    }
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"this vector operation takes ", pcx);
    err_int(want, pcx);
    err_str(c" arguments, got ", pcx);
    err_int(pcx.nodes[n].count, pcx);
    err_end(&pcx);
    for i in 0..pcx.nodes[n].count {
        synth_expr(child(n, i, pcx), &pcx);
    }
    false
}

// The memory operand of a vector load or store: a slice or an array of
// the lanes' type.
fn check_vector_memory(n: i64, e: i64, elem: i64, store: bool, pcx: inout Ctx<Comp>) {
    let ty = synth_expr(e, &pcx);
    let kind = TYPES[ty].kind;
    if ty == pcx.ty_error || ty == TY_NEVER {
        return;
    }
    if (kind != TyKind::Slice && kind != TyKind::Array) || TYPES[ty].a != elem {
        err_begin(pcx.nodes[e].start, &pcx);
        err_str(c"expected a slice or an array of '", pcx);
        err_type(elem, pcx);
        err_str(c"', got '", pcx);
        err_type(ty, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
        return;
    }
    if store && kind == TyKind::Array {
        if !is_place(e, pcx) {
            type_error(e, c"a vector can only be stored into an array that is a place (a variable, field or element)", &pcx);
        }
        check_mutable_place(e, &pcx);
    }
}

pub fn synth_vecop(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let kind = pcx.nodes[n].x;
    let vt = pcx.nodes[n].y;
    let elem = vec_elem(vt);
    let receiver = pcx.nodes[n].a;
    if receiver != 0 {
        synth_expr(receiver, &pcx);
    }
    if kind == VK_NEW {
        if vecop_arity(n, vec_lanes(vt), &pcx) {
            for i in 0..pcx.nodes[n].count {
                check_expr(child(n, i, pcx), elem, &pcx);
            }
        }
        return vt;
    }
    if kind == VK_FROM_BITS {
        if vecop_arity(n, 1, &pcx) {
            let a = child(n, 0, pcx);
            let ty = synth_expr(a, &pcx);
            if ty != pcx.ty_error && ty != TY_NEVER
                && (!is_vector(ty) || type_size(ty, pcx) != type_size(vt, pcx)) {
                err_begin(pcx.nodes[a].start, &pcx);
                err_str(c"from_bits takes a vector of the same size as '", pcx);
                err_type(vt, pcx);
                err_str(c"' (", pcx);
                err_int(type_size(vt, pcx), pcx);
                err_str(c" bytes), got '", pcx);
                err_type(ty, pcx);
                err_str(c"'", pcx);
                err_end(&pcx);
            }
        }
        return vt;
    }
    if kind == VK_SPLAT {
        if vecop_arity(n, 1, &pcx) {
            check_expr(child(n, 0, pcx), elem, &pcx);
        }
        return vt;
    }
    if kind == VK_LOAD || kind == VK_STORE {
        if vecop_arity(n, 2, &pcx) {
            check_vector_memory(n, child(n, 0, pcx), elem, kind == VK_STORE, &pcx);
            check_expr(child(n, 1, pcx), TY_I64, &pcx);
        }
        return if kind == VK_LOAD { vt } else { TY_UNIT };
    }
    if kind == VK_LANE {
        if vecop_arity(n, 1, &pcx) {
            check_expr(child(n, 0, pcx), TY_I64, &pcx);
        }
        return elem;
    }
    if kind == VK_WITH {
        if vecop_arity(n, 2, &pcx) {
            check_expr(child(n, 0, pcx), TY_I64, &pcx);
            check_expr(child(n, 1, pcx), elem, &pcx);
        }
        return vt;
    }
    if kind == VK_SUM {
        vecop_arity(n, 0, &pcx);
        return elem;
    }
    // VK_SELECT: the mask is the receiver.
    if !vecop_arity(n, 2, &pcx) {
        return vt;
    }
    let a = child(n, 0, pcx);
    let ty = synth_expr(a, &pcx);
    if !is_vector(ty) || vec_mask_type(ty, pcx) != vt {
        if ty != pcx.ty_error && ty != TY_NEVER {
            err_begin(pcx.nodes[a].start, &pcx);
            err_str(c"a mask of type '", pcx);
            err_type(vt, pcx);
            err_str(c"' selects between vectors with lanes of its width, got '", pcx);
            err_type(ty, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        synth_expr(child(n, 1, pcx), &pcx);
        return vt;
    }
    check_expr(child(n, 1, pcx), ty, &pcx);
    ty
}

// Reports an error when operator `op` (arithmetic or bitwise) does not
// apply to vector type `ty`.
pub fn vector_operator_ok(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) {
    unsafe { vector_operator_check(n, op, ty, &pcx); }
}

unsafe fn vector_operator_check(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) {
    if is_opaque_vector(ty) {
        // (0.19: `m += m` on an __m128i)
        type_error_got(n, c"Intel's vector types have no operators: use their intrinsics, or convert with T::from_bits(v) (`v16u8::from_bits(x)`)", ty, &pcx);
        return;
    }
    if op == Tok::Plus || op == Tok::Minus || op == Tok::Star {
        return;
    }
    if op == Tok::Slash {
        if !is_float_vector(ty) {
            type_error_got(n, c"integer vectors have no division", ty, &pcx);
        }
        return;
    }
    if op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret {
        if is_float_vector(ty) {
            type_error_got(n, c"bitwise operators on vectors require an integer vector", ty, &pcx);
        }
        return;
    }
    type_error_got(n, c"this operator does not apply to vectors", ty, &pcx);
}

pub fn vector_binary(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    if is_opaque_vector(ty) {
        // (0.19: `__m128i` and the like)
        type_error_got(n, c"Intel's vector types have no operators: use their intrinsics, or convert with T::from_bits(v) (`v16u8::from_bits(x)`)", ty, &pcx);
        return ty;
    }
    if op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq
        || op == Tok::GtEq {
        return vec_mask_type(ty, pcx);
    }
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        type_error_got(n, c"logical operator requires bool", ty, &pcx);
        return TY_BOOL;
    }
    vector_operator_ok(n, op, ty, &pcx);
    ty
}
