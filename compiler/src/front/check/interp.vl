// f-strings (0.15; docs/design/errors-formatting.md): an Interp node is
// checked as the block
//
//   { let __f0 = e0; ...; std::Interp { f: move |__out: *std::Fmt| {
//       __out.str("a "); __out.display(&__f0);
//       let __s1 = __out.spec(w, p, flags); __out.debug(&__f1); __out.end_spec(__s1);
//       ... } } }
//
// (its `y`, which the back ends lower; its type, `std::Interp<closure>`,
// is the Interp's): the holes are evaluated where the f-string is written,
// left to right, once; a hole with `?` in its spec is written with
// `debug`, one with a spec between `spec` and `end_spec` (which pads it).
// A hole of type `*T`, where T has the trait and `*T` has not, is written
// as the T it points to (`__f0.fmt(__out)`). Texts of up to SHORT_TEXT
// bytes are written with `byte`.

use crate::base::{SRC, SYMS, buf_int, buf_new, buf_slice, buf_str, intern, intern_c};
use crate::base::diag::{
    ERR_HELP, err_begin, err_end, err_end_soft, err_help, err_help_sym, err_str, err_try_fmt,
};
use crate::front::ast::{
    CLOSURE_HOLES, CLOSURE_MOVE, FMT_BIN, FMT_CHAR, FMT_EXP, FMT_HEX, FMT_LEFT, FMT_RIGHT, FMT_ZERO,
    NODES, NODE_IMPLICIT, NODE_REF, NODE_REF_MUT, NodeKind, child, list_begin, list_end, list_push,
    new_node,
};
use crate::front::check::{CONST_CONTEXT, LOCALS, mismatch_error, pop_scope, push_scope, type_error};
use crate::front::check::format::{
    FMT_ALT, FMT_OCT, FMT_PTR, hole_alias, hole_debug, hole_eval_only, hole_fill,
};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::is_borrow;
use crate::front::lexer::{SUF_I64, SUF_U8, Tok, str_at};
use crate::front::modules::{CUR_MOD, STD_MODULE, within_std};
use crate::front::own::drops::NO_DROP;
use crate::front::patterns::check_pattern;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    FNS, TYPES, TY_ERROR, TY_F32, TY_F64, TY_I64, TY_U64, TY_U8, TY_UNIT, TyKind, buf_type,
    err_type, is_integer, is_pointer, is_signed, primitive_name,
};

// Texts up to this long are written byte by byte (Fmt::byte is inlined,
// Fmt::str is a call).
const SHORT_TEXT: i64 = 2;

// The type of f-string n; `expected` is the type it is checked against
// (0: synthesized).
pub fn check_interp(n: i64, expected: i64) -> i64 {
    crate::front::check::format::note_site(n, crate::front::check::format::SITE_CHECKED);
    if NODES[n].y == 0 {
        NODES[n].ty = expand(n);
    }
    let t = NODES[n].ty;
    if expected == 0 || expected == t || expected == TY_ERROR || t == TY_ERROR {
        return t;
    }
    if TYPES[expected].kind == TyKind::Slice {
        err_begin(NODES[n].start);
        err_str(c"an f-string is a 'std::Interp' (a value that prints), not '");
        err_type(expected);
        err_str(c"'");
        err_help(c"format it: 'format_in(f\"...\", gpa)' makes the text, a Buf ('.as_slice()' views it, '.free()' frees it), or pass the f-string where a 'T: Display' is taken (print, println, Buf::push_fmt)");
        // (0.25.2.1: the call to write)
        if NODES[n].end > NODES[n].start {
            err_try_fmt(f"format_in({SRC[NODES[n].start..NODES[n].end]}, gpa).as_slice()");
        }
        err_end();
    }
    mismatch_error(n, expected, t)
}

fn is_alnum(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
}

// Checks f-string n and makes its block (NODES[n].y); its type.
fn expand(n: i64) -> i64 {
    let start = NODES[n].start;
    let end = NODES[n].end;
    if CONST_CONTEXT {
        type_error(n,
            c"an f-string cannot be used in a constant expression: it is made when it runs");
    }
    if !check_holes(n) {
        NODES[n].y = new_node(NodeKind::Block, start, end);
        return TY_ERROR;
    }
    let out = intern_c(c"__out");
    let lets = list_begin();
    push_hole_lets(n);
    let block = new_node(NodeKind::Block, start, end);
    list_end(block, lets);
    // The closure's body.
    let stmts = list_begin();
    push_writes(n, out, false);
    let body = new_node(NodeKind::Block, start, end);
    list_end(body, stmts);
    // move |__out: &mut std::Fmt| body (0.18: Display's `f: &mut Fmt`)
    let fmt_name = new_node(NodeKind::TyName, start, end);
    NODES[fmt_name].a = intern_c(c"Fmt");
    let smark = list_begin();
    list_push(std_ident(n));
    list_end(fmt_name, smark);
    let fmt_ptr = new_node(NodeKind::TyPtr, start, end);
    NODES[fmt_ptr].a = fmt_name;
    NODES[fmt_ptr].p |= NODE_REF | NODE_REF_MUT;
    let param = new_node(NodeKind::Param, start, end);
    NODES[param].a = out;
    NODES[param].b = fmt_ptr;
    let closure = new_node(NodeKind::Closure, start, end);
    NODES[closure].c = CLOSURE_MOVE | CLOSURE_HOLES;
    NODES[closure].a = body;
    let pmark = list_begin();
    list_push(param);
    list_end(closure, pmark);
    // std::Interp { f: closure }
    let lit = new_node(NodeKind::StructLit, start, end);
    NODES[lit].a = intern_c(c"Interp");
    // (0.26.0: the compiler's, made wherever the f-string is: its field is std::fmt's)
    NODES[lit].p |= NODE_IMPLICIT;
    let prefix = new_node(NodeKind::Path, start, end);
    let prefix_mark = list_begin();
    list_push(std_ident(n));
    list_end(prefix, prefix_mark);
    NODES[lit].h = prefix;
    let field = new_node(NodeKind::FieldInit, start, end);
    NODES[field].a = intern_c(c"f");
    NODES[field].b = closure;
    let fmark = list_begin();
    list_push(field);
    list_end(lit, fmark);
    NODES[block].a = lit;
    // The `let`s by hand (their values are checked), then the literal.
    push_scope();
    bind_lets(block);
    let t = synth_expr(lit);
    pop_scope();
    NODES[block].ty = t;
    NODES[n].y = block;
    t
}

// The holes of f-string n checked, left to right, once: whether none
// failed. (0.26.2, a format literal's) A hole that reads an argument's
// hole (HOLE_ALIAS) has its type; a width or precision named by an
// argument or a name (g, h) is an integer.
fn check_holes(n: i64) -> bool {
    var failed = false;
    var k = 0;
    for i in 0..NODES[n].count {
        let item = child(n, i);
        if NODES[item].kind != NodeKind::InterpHole {
            continue;
        }
        let alias = hole_alias(item);
        let t = if alias >= 0 { hole_type(n, alias) } else { synth_expr(NODES[item].a) };
        if alias >= 0 {
            NODES[NODES[item].a].ty = t;
        }
        NODES[item].ty = t;
        if t == TY_ERROR {
            failed = true;
        } else if !hole_eval_only(item) {
            check_hole(item, t);
            failed = failed || !count_ok(n, NODES[item].g) || !count_ok(n, NODES[item].h);
        }
        k += 1;
    }
    !failed
}

// The type of hole k (its index among f-string n's holes), checked.
fn hole_type(n: i64, k: i64) -> i64 {
    var j = 0;
    for i in 0..NODES[n].count {
        let item = child(n, i);
        if NODES[item].kind == NodeKind::InterpHole {
            if j == k {
                return NODES[item].ty;
            }
            j += 1;
        }
    }
    TY_ERROR
}

// Width or precision c of a hole of n (an Ident, 0: none) is an integer:
// a name in scope, or (`=fK`) argument hole K's.
fn count_ok(n: i64, c: i64) -> bool {
    if c == 0 {
        return true;
    }
    let text = SYMS[NODES[c].a].text;
    var t = TY_ERROR;
    if text.len > 2 && text[0] == '=' && text[1] == 'f' {
        var k = 0;
        for q in 2..text.len {
            k = k * 10 + (text[q] - '0') as i64;
        }
        t = hole_type(n, k);
    } else {
        t = synth_expr(c);
    }
    if t == TY_ERROR {
        return false;
    }
    if !is_integer(t) {
        err_begin(NODES[c].start);
        err_str(c"a format width or precision is an integer, got '");
        err_type(t);
        err_str(c"'");
        err_end_soft();
        return false;
    }
    true
}

// `let __fN = eN;` for each hole of f-string n, into the list being made
// (0.26.2: not for a hole that reads another's).
fn push_hole_lets(n: i64) {
    var holes = 0;
    for i in 0..NODES[n].count {
        let item = child(n, i);
        if NODES[item].kind == NodeKind::InterpHole {
            if hole_alias(item) < 0 {
                list_push(let_node(hidden(c"=f", holes), NODES[item].a, item, false));
            }
            holes += 1;
        }
    }
}

// `let [mut] name = value;`, at node at.
fn let_node(name: i64, value: i64, at: i64, mutable: bool) -> i64 {
    let bind = new_node(NodeKind::PatBind, NODES[at].start, NODES[at].end);
    NODES[bind].a = name;
    NODES[bind].b = if mutable { 1 } else { 0 };
    let binding = new_node(NodeKind::Let, NODES[at].start, NODES[at].end);
    NODES[binding].a = bind;
    NODES[binding].c = value;
    binding
}

// The `let`s of block b, whose values are checked, bound by hand (in the
// scope the caller opens).
fn bind_lets(b: i64) {
    unsafe {
        for i in 0..NODES[b].count {
            let binding = child(b, i);
            let bind = NODES[binding].a;
            let value = NODES[binding].c;
            let t = NODES[value].ty;
            check_pattern(bind, t);
            // (`{self}`, `{&p}`: a borrow, as passed directly)
            if is_pointer(t) && is_borrow(value) {
                LOCALS[NODES[bind].x].borrow = true;
            }
        }
    }
}

// The statements that write f-string n's text to `out` (a `*std::Fmt`;
// `direct`: a std::Fmt, a local), into the list being made, the holes
// read from `__f0`, `__f1`... (0.26.2: a format literal's holes too: one
// that reads another's writes that one's value; an argument only
// evaluated writes nothing; a width or precision may be a value, a fill
// byte is in spec's flags, from bit 16: std/fmt.vl's FMT_FILL_SHIFT.)
fn push_writes(n: i64, out: i64, direct: bool) {
    var holes = 0;
    for i in 0..NODES[n].count {
        let item = child(n, i);
        if NODES[item].kind == NodeKind::Str {
            // (a short text: its bytes, `__out.byte(b'a')`, inlined)
            let text = str_at(NODES[item].a);
            if text.len <= SHORT_TEXT {
                for k in 0..text.len {
                    let c = new_node(NodeKind::Char, NODES[item].start, NODES[item].end);
                    NODES[c].a = text[k] as i64;
                    list_push(stmt(call1(ident(out, item), c"byte", c)));
                }
            } else {
                list_push(stmt(call1(ident(out, item), c"str", item)));
            }
            continue;
        }
        if hole_eval_only(item) {
            holes += 1;
            continue;
        }
        let alias = hole_alias(item);
        let name = hidden(c"=f", if alias >= 0 { alias } else { holes });
        let debug = hole_debug(item);
        var flags = NODES[item].p;
        let ty = NODES[item].ty;
        // (`__out.display(&__f0)`; through a pointer, `__f0.fmt(__out)`:
        // a pointer value is passed as a receiver)
        var write = 0;
        if (flags & FMT_PTR) != 0 {
            // (0.26.2) `{:p}`: the address, `0x..`
            flags = (flags & ~FMT_PTR) | FMT_HEX | FMT_ALT;
            write = call1(ident(out, item), c"uint", cast_to(ident(name, item), TY_U64, item));
        } else if (flags & FMT_EXP) != 0 && is_integer(ty) {
            // (0.26.2) `{:e}` of an integer: as the f64 of its value
            write = call1(ident(out, item), c"display", cast_to(ident(name, item), TY_F64, item));
        } else if debug && debug_slice(ty) {
            write = call1(ident(out, item), c"debug_slice", ident(name, item));
        } else if takes_pointer(item) {
            let to = if direct { amp_mut(ident(out, item)) } else { ident(out, item) };
            write = call1(ident(name, item), if debug { c"fmt_debug" } else { c"fmt" }, to);
        } else {
            write = call1(ident(out, item), if debug { c"debug" } else { c"display" },
                unary(Tok::Amp, ident(name, item)));
        }
        let fill = hole_fill(item);
        let wv = NODES[item].g;
        let pv = NODES[item].h;
        let spec = NODES[item].c > 0 || NODES[item].d >= 0 || flags != 0 || fill != 0 || wv != 0
            || pv != 0;
        if spec && is_integer(ty) && (flags & ~(FMT_LEFT | FMT_RIGHT | FMT_ZERO)) == 0 && fill == 0
            && wv == 0 && (NODES[item].p & FMT_PTR) == 0 {
            // (0.16) A decimal integer with a spec: `__out.int_hole(__fN as
            // i64, w, flags)` (`uint_hole`, `as u64`), what spec, display
            // and end_spec write, in one pass (std's Display of an integer
            // writes only its digits)
            let signed = is_signed(ty);
            let hole = method_call(ident(out, item),
                if signed { c"int_hole" } else { c"uint_hole" });
            let amark = list_begin();
            list_push(cast_to(ident(name, item), if signed { TY_I64 } else { TY_U64 }, item));
            list_push(int_node(if NODES[item].c > 0 { NODES[item].c } else { 0 }, item));
            list_push(int_node(flags, item));
            list_end(hole, amark);
            list_push(stmt(hole));
        } else if spec {
            // let __sN = __out.spec(w, p, flags); write; __out.end_spec(__sN);
            let saved = hidden(c"__s", holes);
            let spec = method_call(ident(out, item), c"spec");
            let amark = list_begin();
            if wv != 0 {
                list_push(cast_to(ident(NODES[wv].a, wv), TY_I64, wv));
            } else {
                list_push(int_node(if NODES[item].c > 0 { NODES[item].c } else { 0 }, item));
            }
            if pv != 0 {
                list_push(cast_to(ident(NODES[pv].a, pv), TY_I64, pv));
            } else {
                list_push(int_node(NODES[item].d, item));
            }
            list_push(int_node(flags | fill << 16, item));
            list_end(spec, amark);
            list_push(let_node(saved, spec, item, false));
            list_push(stmt(write));
            list_push(stmt(call1(ident(out, item), c"end_spec", ident(saved, item))));
        } else {
            list_push(stmt(write));
        }
        holes += 1;
    }
}

// `e as T`, T a primitive type, at node at.
fn cast_to(e: i64, t: i64, at: i64) -> i64 {
    let cast = new_node(NodeKind::Cast, NODES[at].start, NODES[at].end);
    let tname = new_node(NodeKind::TyName, NODES[at].start, NODES[at].end);
    NODES[tname].a = intern_c(primitive_name(t));
    NODES[tname].ty = t;
    NODES[cast].a = e;
    NODES[cast].b = tname;
    cast
}

// ---- (0.17) f-strings written straight into std's printing ----

// What direct_kind returns: the std function an f-string is passed to.
const D_PRINT: i64 = 1;
const D_PRINTLN: i64 = 2;
const D_EPRINT: i64 = 3;
const D_EPRINTLN: i64 = 4;
const D_FORMAT_IN: i64 = 5;
const D_PUSH_FMT: i64 = 6;

// (0.17) Whether call n of function f (a template; n's named arguments
// normalized; `method`: a method call, its receiver not among them) is
// std's print, println, eprint, eprintln, format_in or (a method)
// Buf::push_fmt with an f-string as its Display argument, outside std:
// which one (D_*), else 0.
pub fn direct_kind(n: i64, f: i64, method: bool) -> i64 {
    unsafe {
        if STD_MODULE < 0 || !within_std(FNS[f].module) || within_std(CUR_MOD)
            || CONST_CONTEXT
            || NODES[n].count == 0 {
            return 0;
        }
        let fs = child(n, 0);
        if NODES[fs].kind != NodeKind::Interp || NODES[fs].y != 0 {
            return 0;
        }
        let name = SYMS[NODES[FNS[f].node].a].text;
        let k = if method {
            // (0.20: Buf's; String's is an ordinary call)
            if name == "push_fmt" && SYMS[NODES[FNS[f].node].d].text == "Buf" { D_PUSH_FMT }
            else { 0 }
        } else if name == "print" {
            D_PRINT
        } else if name == "println" {
            D_PRINTLN
        } else if name == "eprint" {
            D_EPRINT
        } else if name == "eprintln" {
            D_EPRINTLN
        } else if name == "format_in" {
            D_FORMAT_IN
        } else {
            0
        };
        let count = if k == D_FORMAT_IN { 2 } else { 1 };
        if k == 0 || NODES[n].count != count
            || NODES[child(n, count - 1)].kind == NodeKind::NamedArg {
            return 0;
        }
        k
    }
}

// (0.17) Call n of std function f (direct_kind k; `recv`, push_fmt's
// receiver as its `self` takes it, checked, else 0) with its f-string fs
// written in place: no closure, no std::Interp, no instance of f. n
// becomes an Interp node (the back ends lower its y, as an f-string's)
// whose y is the block
//
//   { [let __r = recv;] let __f0 = e0; ...; [let __a = a;] BODY }
//
// (BODY: direct_body): the receiver, the holes left to right, then the
// allocator, where the call evaluates them. A copy of the call as written
// is kept for `query refs` (not lowered); fs's y is -1 (`query type`
// shows its type as an Interp's); n's x is f + 1 (effects: what the
// writes do is the call's, `println(f"..")` calls 'std::println'). The
// call's type.
pub fn direct_call(n: i64, f: i64, k: i64, recv: i64) -> i64 {
    unsafe {
        let start = NODES[n].start;
        let end = NODES[n].end;
        let fs = child(n, 0);
        let orig = new_node(NodeKind::Call, start, end);
        NODES[orig].a = if recv == 0 { NODES[n].a } else { 0 };
        NODES[orig].x = f + 1;
        let omark = list_begin();
        if recv != 0 {
            list_push(recv);
        }
        for i in 0..NODES[n].count {
            list_push(child(n, i));
        }
        list_end(orig, omark);
        var ok = check_holes(fs);
        var alloc = 0;
        if k == D_FORMAT_IN {
            alloc = child(n, 1);
            let t = synth_expr(alloc);
            ok = ok && t != TY_ERROR && allocator_ok(t, f, start);
        }
        NODES[fs].y = -1;
        NODES[fs].ty = TY_UNIT;
        let block = new_node(NodeKind::Block, start, end);
        var t = TY_ERROR;
        if ok {
            let lets = list_begin();
            if recv != 0 {
                list_push(let_node(intern_c(c"__r"), recv, n, false));
            }
            push_hole_lets(fs);
            if alloc != 0 {
                list_push(let_node(intern_c(c"__a"), alloc, n, false));
            }
            list_end(block, lets);
            let body = direct_body(fs, k, n);
            NODES[block].a = body;
            push_scope();
            bind_lets(block);
            if recv != 0 {
                // (its safety is the call's, checked)
                LOCALS[NODES[NODES[child(block, 0)].a].x].borrow = true;
            }
            t = synth_expr(body);
            pop_scope();
        }
        NODES[block].ty = t;
        NODES[orig].ty = t;
        let lowered = new_node(NodeKind::Interp, start, end);
        NODES[n] = NODES[lowered];
        NODES[n].x = f + 1;
        NODES[n].y = block;
        NODES[n].ty = t;
        t
    }
}

// (0.17) Whether t, format_in's allocator, is an Allocator; else the error
// instantiating f (format_in) gives.
fn allocator_ok(t: i64, f: i64, pos: i64) -> bool {
    unsafe {
        let tr = std_trait(c"Allocator");
        if tr < 0 || implements(tr, t) {
            return true;
        }
        err_begin(pos);
        err_str(c"the trait 'Allocator' is not implemented for '");
        err_type(t);
        err_str(c"'");
        err_help(c"required by the bound 'A: Allocator' of '");
        err_help_sym(FNS[f].display);
        err_help(c"'");
        err_end();
        false
    }
}

// (0.17) The block direct_call writes f-string fs with, at call n, for
// kind k:
//
//   print, println, eprint, eprintln (fd 1 or 2):
//     { let mut __out = std::__print_begin(FD); WRITES; [__out.byte('\n');]
//       std::__print_end(&mut __out); }
//   push_fmt:
//     { let mut __out = std::__buf_fmt(__r);
//       loop { WRITES; if std::__buf_fmt_end(__r, &__out) { break; } } }
//   format_in:
//     { let mut __b = std::Buf::new_in(__a); let mut __t = [0u8; 256];
//       let mut __out = std::__fmt_tmp(&__t);
//       loop { WRITES; if std::__fmt_in_end(&__b, &__out) { break; } }
//       __b }
//
// (WRITES: push_writes; std's helpers: compiler/std/fmt.vl.)
fn direct_body(fs: i64, k: i64, n: i64) -> i64 {
    let out = intern_c(c"__out");
    let none = 0 as *u8;
    let stmts = list_begin();
    var tail = 0;
    if k == D_FORMAT_IN {
        let b = intern_c(c"__b");
        let t = intern_c(c"__t");
        let new_in = std_call(c"Buf", c"new_in", ident(intern_c(c"__a"), n), 0, 0, n);
        // (0.17: no drop: the block's value, moved out by its tail; the
        // own walk sees the holes as borrows, not this move)
        let lb = let_node(b, new_in, n, true);
        NODES[lb].p |= NO_DROP;
        list_push(lb);
        let zero = new_node(NodeKind::Int, NODES[n].start, NODES[n].end);
        NODES[zero].b = SUF_U8;
        let tmp = new_node(NodeKind::Repeat, NODES[n].start, NODES[n].end);
        NODES[tmp].a = zero;
        NODES[tmp].b = int_node(256, n);
        list_push(let_node(t, tmp, n, true));
        let fmt = std_call(none, c"__fmt_tmp", amp_mut(ident(t, n)), 0, 0, n);
        list_push(let_node(out, fmt, n, true));
        let end = std_call(none, c"__fmt_in_end", amp_mut(ident(b, n)),
            amp_mut(ident(out, n)), 0, n);
        list_push(stmt(retry_loop(fs, out, end, n)));
        tail = ident(b, n);
    } else if k == D_PUSH_FMT {
        let r = intern_c(c"__r");
        // (`&mut *__r`: the receiver, `&b` or a pointer, as std's `&mut Buf`)
        let buf = amp_mut(unary(Tok::Star, ident(r, n)));
        list_push(let_node(out, std_call(none, c"__buf_fmt", buf, 0, 0, n), n, true));
        let end = std_call(none, c"__buf_fmt_end", amp_mut(unary(Tok::Star, ident(r, n))),
            amp_mut(ident(out, n)), 0, n);
        list_push(stmt(retry_loop(fs, out, end, n)));
    } else {
        let fd = new_node(NodeKind::Int, NODES[n].start, NODES[n].end);
        NODES[fd].a = if k == D_EPRINT || k == D_EPRINTLN { 2 } else { 1 };
        // (0.21: __print_begin holds std's print lock once threads run)
        list_push(let_node(out, std_call(none, c"__print_begin", fd, 0, 0, n), n, true));
        push_writes(fs, out, true);
        if k == D_PRINTLN || k == D_EPRINTLN {
            let c = new_node(NodeKind::Char, NODES[n].start, NODES[n].end);
            NODES[c].a = '\n' as i64;
            list_push(stmt(call1(ident(out, n), c"byte", c)));
        }
        let end = std_call(none, c"__print_end", amp_mut(ident(out, n)), 0, 0, n);
        list_push(stmt(end));
    }
    let body = new_node(NodeKind::Block, NODES[n].start, NODES[n].end);
    list_end(body, stmts);
    NODES[body].a = tail;
    body
}

// `loop { WRITES; if done { break; } }`: f-string fs written to `out`
// until `done` (a call) says the text is all there.
fn retry_loop(fs: i64, out: i64, done: i64, n: i64) -> i64 {
    let start = NODES[n].start;
    let end = NODES[n].end;
    let stmts = list_begin();
    push_writes(fs, out, true);
    let then = new_node(NodeKind::Block, start, end);
    let tmark = list_begin();
    list_push(stmt(new_node(NodeKind::Break, start, end)));
    list_end(then, tmark);
    let test = new_node(NodeKind::If, start, end);
    NODES[test].a = done;
    NODES[test].b = then;
    list_push(stmt(test));
    let body = new_node(NodeKind::Block, start, end);
    list_end(body, stmts);
    let repeat = new_node(NodeKind::Loop, start, end);
    NODES[repeat].b = body;
    repeat
}

// `std::T::name(a0, a1, a2)` (T: none, `std::name(..)`; an argument 0:
// none, the rest too), at node at. (A path of three segments has them
// all in its list: front/parser/exprs.vl.)
fn std_call(t: *u8, name: *u8, a0: i64, a1: i64, a2: i64, at: i64) -> i64 {
    let path = new_node(NodeKind::Path, NODES[at].start, NODES[at].end);
    NODES[path].b = intern_c(name);
    if t == 0 as *u8 {
        NODES[path].a = intern_c(c"std");
    } else {
        NODES[path].a = intern_c(t);
        let pmark = list_begin();
        list_push(std_ident(at));
        list_push(ident(NODES[path].a, at));
        list_push(ident(NODES[path].b, at));
        list_end(path, pmark);
    }
    let call = new_node(NodeKind::Call, NODES[at].start, NODES[at].end);
    NODES[call].a = path;
    let amark = list_begin();
    if a0 != 0 {
        list_push(a0);
        if a1 != 0 {
            list_push(a1);
            if a2 != 0 {
                list_push(a2);
            }
        }
    }
    list_end(call, amark);
    call
}

// Hole h, of type t (not the error type): the trait its spec needs, and
// the integer its `x`, `X`, `b`, `c` need (`e`, `E`: the float). (0.26.2:
// `o` an integer, `e` an integer too, `p` a pointer, `x?` any Debug.)
fn check_hole(h: i64, t: i64) {
    let debug = hole_debug(h);
    let flags = NODES[h].p;
    if (flags & FMT_PTR) != 0 {
        if !is_pointer(t) {
            spec_error(h, t, c"'p' writes an address: it needs a pointer, got '");
        }
        return;
    }
    let tr = std_trait(if debug { c"Debug" } else { c"Display" });
    if tr < 0 {
        return;
    }
    let shown = if takes_pointer(h) { TYPES[t].a } else { t };
    if !implements(tr, shown) && !(debug && debug_slice(shown)) {
        missing_trait(h, shown, debug);
    }
    if (flags & FMT_CHAR) != 0 && shown != TY_U8 {
        spec_error(h, shown, c"'c' writes a byte: it needs a 'u8', got '");
    }
    if (flags & (FMT_HEX | FMT_BIN | FMT_OCT)) != 0 && !debug && !is_integer(shown) {
        spec_error(h, shown,
            c"'x', 'X', 'o' and 'b' write an integer's digits: they need an integer, got '");
    }
    if (flags & FMT_EXP) != 0 && shown != TY_F64 && shown != TY_F32 && !is_integer(shown) {
        spec_error(h, shown,
            c"'e' and 'E' write a number with an exponent: they need an integer or a float, got '");
    }
}

// Whether hole h (checked) is written through its value: a pointer to a
// type with the trait, the pointer type having none.
fn takes_pointer(h: i64) -> bool {
    let t = NODES[h].ty;
    if !is_pointer(t) || TYPES[t].a == 0 || (NODES[h].p & FMT_PTR) != 0 {
        return false;
    }
    let tr = std_trait(if hole_debug(h) { c"Debug" } else { c"Display" });
    tr >= 0 && !implements(tr, t) && implements(tr, TYPES[t].a)
}

// (0.25.3, eval 0.25.2.2) Whether `{x:?}` of a value of type t writes it
// with Fmt::debug_slice: a slice whose elements have Debug (`[1, 2, 3]`,
// as a Vec's), the slice having none of its own (`[u8]` has, quoted).
fn debug_slice(t: i64) -> bool {
    let info = TYPES[t];
    if info.kind != TyKind::Slice {
        return false;
    }
    let tr = std_trait(c"Debug");
    tr >= 0 && !implements(tr, t) && implements(tr, info.a)
}

fn missing_trait(h: i64, t: i64, debug: bool) -> ! {
    err_begin(NODES[NODES[h].a].start);
    err_str(c"'");
    err_type(t);
    err_str(if debug {
        c"' does not implement Debug, which '{x:?}' needs"
    } else {
        c"' does not implement Display, which '{x}' needs"
    });
    if TYPES[t].kind == TyKind::Struct || TYPES[t].kind == TyKind::Enum {
        if debug {
            err_help(
                c"derive it: '#[derive(Debug)]' before the type, or write 'impl Debug for ");
            buf_type(ERR_HELP, t);
            err_help(c" { fn fmt_debug(");
        } else {
            err_help(c"write 'impl Display for ");
            buf_type(ERR_HELP, t);
            err_help(c" { fn fmt(");
        }
        err_help(c"self");
        err_help(
            c", f: inout std::Fmt) { f.write(f\"...\"); } }'");
    } else if debug && TYPES[t].kind == TyKind::Slice {
        // (0.25.3) a slice is written with its elements' Debug
        err_help(c"a slice is written as a list of its elements' Debug, which '");
        buf_type(ERR_HELP, TYPES[t].a);
        err_help(
            c"' does not have: give it one ('#[derive(Debug)]' before a struct or an enum)");
    } else if !debug && debug_slice(t) {
        // (0.25.3) a slice of printable elements: Debug writes it
        err_help(c"a slice has no Display (no one way to separate its elements): '{x:?}' writes it as a list, '[1, 2, 3]', or format its parts");
    } else if !debug {
        err_help(c"write it with Debug, '{x:?}', or format its parts");
    }
    err_end()
}

fn spec_error(h: i64, t: i64, message: *u8) -> ! {
    err_begin(NODES[NODES[h].a].start);
    err_str(message);
    err_type(t);
    err_str(c"'");
    err_end()
}

// `=f3` (0.17: a hole, which the own walk reads, not moves: front/own/walk.vl's eval_let), `__s3`: a hidden local's name.
fn hidden(prefix: *u8, i: i64) -> i64 {
    let out = buf_new();
    buf_str(out, prefix);
    buf_int(out, i);
    intern(buf_slice(out))
}

fn ident(sym: i64, at: i64) -> i64 {
    let id = new_node(NodeKind::Ident, NODES[at].start, NODES[at].end);
    NODES[id].a = sym;
    id
}

fn std_ident(at: i64) -> i64 {
    ident(intern_c(c"std"), at)
}

fn unary(op: Tok, e: i64) -> i64 {
    let u = new_node(NodeKind::Unary, NODES[e].start, NODES[e].end);
    NODES[u].op = op;
    NODES[u].b = e;
    u
}

// `&mut e` (0.18: what Display's and Fmt's `&mut Fmt` take).
fn amp_mut(e: i64) -> i64 {
    let u = unary(Tok::Amp, e);
    NODES[u].p |= NODE_REF_MUT;
    u
}

// An i64 literal of value v (a negative one as `-v`), at node at.
fn int_node(v: i64, at: i64) -> i64 {
    let lit = new_node(NodeKind::Int, NODES[at].start, NODES[at].end);
    NODES[lit].a = if v < 0 { -v } else { v };
    NODES[lit].b = SUF_I64;
    if v < 0 { unary(Tok::Minus, lit) } else { lit }
}

// `receiver.name()`, its arguments to be added.
fn method_call(receiver: i64, name: *u8) -> i64 {
    let c = new_node(NodeKind::MethodCall, NODES[receiver].start, NODES[receiver].end);
    NODES[c].a = receiver;
    NODES[c].b = intern_c(name);
    c
}

// `receiver.name(arg)`.
fn call1(receiver: i64, name: *u8, arg: i64) -> i64 {
    let c = method_call(receiver, name);
    let mark = list_begin();
    list_push(arg);
    list_end(c, mark);
    c
}

// `e;`
fn stmt(e: i64) -> i64 {
    let s = new_node(NodeKind::ExprStmt, NODES[e].start, NODES[e].end);
    NODES[s].a = e;
    NODES[s].b = 1;
    s
}
