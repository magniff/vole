// f-strings (0.15; docs/design/errors-formatting.md): an Interp node is
// checked as the block
//
//   { let __f0 = e0; ...; std::Interp { f: move |__out: *std::Fmt| {
//       __out.str("a "); __out.display(&__f0);
//       let __s1 = __out.spec(w, p, flags); __out.debug(&__f1); __out.end_spec(__s1);
//       ... } } }
//
// (its `y`, which the back ends lower; its type, `std::Interp<closure>`,
// is the Interp's): the holes are evaluated where the f-string is written,
// left to right, once; a hole with `?` in its spec is written with
// `debug`, one with a spec between `spec` and `end_spec` (which pads it).
// A hole of type `*T`, where T has the trait and `*T` has not, is written
// as the T it points to (`__f0.fmt(__out)`). Texts of up to SHORT_TEXT
// bytes are written with `byte`.

use crate::base::{buf_int, buf_new, buf_str, get_src, intern_buf, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_help, err_help_sym, err_str, err_try_fmt,
};
use crate::front::ast::{
    CLOSURE_HOLES, CLOSURE_MOVE, FMT_BIN, FMT_CHAR, FMT_EXP, FMT_HEX, FMT_LEFT, FMT_RIGHT,
    FMT_UPPER, FMT_ZERO, NODE_IMPLICIT, NODE_REF, NODE_REF_MUT, NodeKind, child, list_begin,
    list_end, list_push, new_node,
};
use crate::front::check::{Res, mismatch_error, pop_scope, push_scope, type_error};
use crate::front::check::format::{
    FMT_ALT, FMT_OCT, FMT_PTR, hole_alias, hole_debug, hole_eval_only, hole_fill,
};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::is_borrow;
use crate::front::drops::NO_DROP;
use crate::front::lexer::{SUF_I64, SUF_U8, Tok, str_at};
use crate::front::modules::within_std;
use crate::front::patterns::check_pattern;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    TY_F32, TY_F64, TY_I64, TY_U64, TY_U8, TY_UNIT, TyKind, buf_type, err_type, is_integer,
    is_pointer, is_signed, primitive_name,
};

// Texts up to this long are written byte by byte (Fmt::byte is inlined,
// Fmt::str is a call).
const SHORT_TEXT: i64 = 2;

// The type of f-string n; `expected` is the type it is checked against
// (0: synthesized).
pub fn check_interp(n: i64, expected: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.nodes[n as usize].y == 0 {
        pcx.nodes[n as usize].ty = expand(n, pcx);
    }
    let t = pcx.nodes[n as usize].ty;
    if expected == 0 || expected == t || expected == pcx.ty_error || t == pcx.ty_error {
        return t;
    }
    if pcx.types[expected as usize].kind == TyKind::Slice {
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_str(c"a format_args value is a 'std::Interp' (a value that prints), not '", pcx);
        err_type(expected, pcx);
        err_str(c"'", pcx);
        err_help(c"format it: 'format_in(\"...\", gpa)' makes the text, a String ('.as_str()' views it), or pass the value where a 'T: Display' is taken (print, println, String::push_fmt)", pcx);
        // (0.25.2.1: the call to write)
        if pcx.nodes[n as usize].end > pcx.nodes[n as usize].start {
            err_try_fmt(format_args("format_in({}, gpa).as_slice()",
                &str::from_utf8(
                    get_src()[
                        pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize]).unwrap()), pcx);
        }
        err_end(pcx);
    }
    mismatch_error(n, expected, t, pcx)
}

fn is_alnum(c: u8) -> bool {
    c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9'
}

// Checks f-string n and makes its block (NODES[n].y); its type.
fn expand(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    if pcx.const_context {
        type_error(n,
            c"a format_args value cannot be used in a constant expression: it is made when it runs", pcx);
    }
    if !check_holes(n, false, pcx) {
        pcx.nodes[n as usize].y = new_node(NodeKind::Block, start, end, pcx);
        return pcx.ty_error;
    }
    let out = intern_c(c"__out", pcx);
    let lets = list_begin(pcx);
    push_hole_lets(n, pcx);
    let block = new_node(NodeKind::Block, start, end, pcx);
    list_end(block, lets, pcx);
    // The closure's body.
    // RULE: F16.4 (0.27.4: on std2, a rust program's std, the writes are
    // F16.3's through `__out: &mut std::fmt::Formatter`, and the value is
    // `std::__rt::Interp { f: closure }`)
    let std2 = crate::front::known::on_std2(pcx);
    let stmts = list_begin(pcx);
    if std2 {
        push_writes_std2(n, out, true, pcx);
    } else {
        push_writes(n, out, false, pcx);
    }
    let body = new_node(NodeKind::Block, start, end, pcx);
    list_end(body, stmts, pcx);
    // move |__out: &mut std::Fmt| body (0.18: Display's `f: &mut Fmt`)
    let fmt_name = new_node(NodeKind::TyName, start, end, pcx);
    pcx.nodes[fmt_name as usize].a = intern_c(if std2 { c"Formatter" } else { c"Fmt" }, pcx);
    let smark = list_begin(pcx);
    list_push(std_ident(n, pcx), pcx);
    if std2 {
        list_push(ident(intern_c(c"fmt", pcx), n, pcx), pcx);
    }
    list_end(fmt_name, smark, pcx);
    let fmt_ptr = new_node(NodeKind::TyPtr, start, end, pcx);
    pcx.nodes[fmt_ptr as usize].a = fmt_name;
    pcx.nodes[fmt_ptr as usize].p |= NODE_REF | NODE_REF_MUT;
    let param = new_node(NodeKind::Param, start, end, pcx);
    pcx.nodes[param as usize].a = out;
    pcx.nodes[param as usize].b = fmt_ptr;
    let closure = new_node(NodeKind::Closure, start, end, pcx);
    pcx.nodes[closure as usize].c = CLOSURE_MOVE | CLOSURE_HOLES;
    pcx.nodes[closure as usize].a = body;
    let pmark = list_begin(pcx);
    list_push(param, pcx);
    list_end(closure, pmark, pcx);
    // std::Interp { f: closure }
    let lit = new_node(NodeKind::StructLit, start, end, pcx);
    pcx.nodes[lit as usize].a = intern_c(c"Interp", pcx);
    // (0.26.0: the compiler's, made wherever the f-string is: its field is std::fmt's)
    pcx.nodes[lit as usize].p |= NODE_IMPLICIT;
    let prefix = new_node(NodeKind::Path, start, end, pcx);
    let prefix_mark = list_begin(pcx);
    list_push(std_ident(n, pcx), pcx);
    if std2 {
        list_push(ident(intern_c(c"__rt", pcx), n, pcx), pcx);
    }
    list_end(prefix, prefix_mark, pcx);
    pcx.nodes[lit as usize].h = prefix;
    let field = new_node(NodeKind::FieldInit, start, end, pcx);
    pcx.nodes[field as usize].a = intern_c(c"f", pcx);
    pcx.nodes[field as usize].b = closure;
    let fmark = list_begin(pcx);
    list_push(field, pcx);
    list_end(lit, fmark, pcx);
    pcx.nodes[block as usize].a = lit;
    // The `let`s by hand (their values are checked), then the literal.
    push_scope(pcx);
    bind_lets(block, pcx);
    let t = synth_expr(lit, pcx);
    pop_scope(pcx);
    pcx.nodes[block as usize].ty = t;
    pcx.nodes[n as usize].y = block;
    t
}

// The holes of f-string n checked, left to right, once: whether none
// failed. (0.26.2, a format literal's) A hole that reads an argument's
// hole (HOLE_ALIAS) has its type; a width or precision named by an
// argument or a name (g, h) is an integer.
fn check_holes(n: i64, direct: bool, pcx: &mut Ctx<Comp>) -> bool {
    let mut failed = false;
    let mut k: i64 = 0;
    for i in 0..pcx.nodes[n as usize].count {
        let item = child(n, i, pcx);
        if pcx.nodes[item as usize].kind != NodeKind::InterpHole {
            continue;
        }
        let alias = hole_alias(item, pcx);
        // RULE: F18.5 (0.28.0: a direct call's hole of an open local, on
        // std2, keeps it open: its write is made again when it is solved,
        // hole_retype)
        let e = pcx.nodes[item as usize].a;
        pcx.open_keep = direct && alias < 0 && crate::front::known::on_std2(pcx)
            && crate::front::check::literals::open_scalar(e, pcx) >= 0;
        let t = if alias >= 0 { hole_type(n, alias, pcx) }
            else { synth_expr(e, pcx) };
        pcx.open_keep = false;
        if alias >= 0 {
            { let at_ix = pcx.nodes[item as usize].a as usize; pcx.nodes[at_ix].ty = t };
        }
        pcx.nodes[item as usize].ty = t;
        if t == pcx.ty_error {
            failed = true;
        } else if !hole_eval_only(item, pcx) {
            check_hole(item, t, pcx);
            failed = failed || !count_ok(n, pcx.nodes[item as usize].g, pcx)
                || !count_ok(n, pcx.nodes[item as usize].h, pcx);
        }
        k += 1;
    }
    !failed
}

// The type of hole k (its index among f-string n's holes), checked.
fn hole_type(n: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut j: i64 = 0;
    for i in 0..pcx.nodes[n as usize].count {
        let item = child(n, i, pcx);
        if pcx.nodes[item as usize].kind == NodeKind::InterpHole {
            if j == k {
                return pcx.nodes[item as usize].ty;
            }
            j += 1;
        }
    }
    pcx.ty_error
}

// Width or precision c of a hole of n (an Ident, 0: none) is an integer:
// a name in scope, or (`=fK`) argument hole K's.
fn count_ok(n: i64, c: i64, pcx: &mut Ctx<Comp>) -> bool {
    if c == 0 {
        return true;
    }
    let text = sym_text(pcx.nodes[c as usize].a, pcx);
    let mut t = pcx.ty_error;
    if text.len() > 2 && text[0] == b'=' && text[1] == b'f' {
        let mut k: i64 = 0;
        for q in 2..text.len() {
            k = k * 10 + (text[q] - b'0') as i64;
        }
        t = hole_type(n, k, pcx);
    } else {
        t = synth_expr(c, pcx);
    }
    if t == pcx.ty_error {
        return false;
    }
    if !is_integer(t) {
        err_begin(pcx.nodes[c as usize].start, pcx);
        err_str(c"a format width or precision is an integer, got '", pcx);
        err_type(t, pcx);
        err_str(c"'", pcx);
        err_end_soft(pcx);
        return false;
    }
    true
}

// `let __fN = eN;` for each hole of f-string n, into the list being made
// (0.26.2: not for a hole that reads another's).
fn push_hole_lets(n: i64, pcx: &mut Ctx<Comp>) {
    let mut holes: i64 = 0;
    for i in 0..pcx.nodes[n as usize].count {
        let item = child(n, i, pcx);
        if pcx.nodes[item as usize].kind == NodeKind::InterpHole {
            if hole_alias(item, pcx) < 0 {
                list_push(let_node(hidden(c"=f", holes, pcx), pcx.nodes[item as usize].a, item,
                    false, pcx),
                    pcx);
            }
            holes += 1;
        }
    }
}

// `let [mut] name = value;`, at node at.
fn let_node(name: i64, value: i64, at: i64, mutable: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let bind = new_node(NodeKind::PatBind, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[bind as usize].a = name;
    pcx.nodes[bind as usize].b = if mutable { 1 } else { 0 };
    let binding = new_node(NodeKind::Let, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[binding as usize].a = bind;
    pcx.nodes[binding as usize].c = value;
    binding
}

// The `let`s of block b, whose values are checked, bound by hand (in the
// scope the caller opens).
fn bind_lets(b: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[b as usize].count {
        let binding = child(b, i, pcx);
        let bind = pcx.nodes[binding as usize].a;
        let value = pcx.nodes[binding as usize].c;
        let t = pcx.nodes[value as usize].ty;
        check_pattern(bind, t, pcx);
        // (`{self}`, `{&p}`: a borrow, as passed directly)
        if is_pointer(t, pcx) && is_borrow(value, pcx) {
            { let at_ix = pcx.nodes[bind as usize].x as usize; pcx.locals[at_ix].borrow = true };
        }
    }
}

// The statements that write f-string n's text to `out` (a `*std::Fmt`;
// `direct`: a std::Fmt, a local), into the list being made, the holes
// read from `__f0`, `__f1`... (0.26.2: a format literal's holes too: one
// that reads another's writes that one's value; an argument only
// evaluated writes nothing; a width or precision may be a value, a fill
// byte is in spec's flags, from bit 16: std/fmt.vl's FMT_FILL_SHIFT.)
fn push_writes(n: i64, out: i64, direct: bool, pcx: &mut Ctx<Comp>) {
    let mut holes: i64 = 0;
    for i in 0..pcx.nodes[n as usize].count {
        let item = child(n, i, pcx);
        if pcx.nodes[item as usize].kind == NodeKind::Str {
            // (a short text: its bytes, `__out.byte(b'a')`, inlined)
            let text = str_at(pcx.nodes[item as usize].a, pcx);
            if text.len() as i64 <= SHORT_TEXT {
                for k in 0..text.len() {
                    let c = new_node(NodeKind::Char, pcx.nodes[item as usize].start,
                        pcx.nodes[item as usize].end, pcx);
                    pcx.nodes[c as usize].a = text[k] as i64;
                    list_push(stmt(call1(ident(out, item, pcx), c"byte", c, pcx), pcx), pcx);
                }
            } else {
                list_push(stmt(call1(ident(out, item, pcx), c"str", item, pcx), pcx), pcx);
            }
            continue;
        }
        if hole_eval_only(item, pcx) {
            holes += 1;
            continue;
        }
        let alias = hole_alias(item, pcx);
        let name = hidden(c"=f", if alias >= 0 { alias } else { holes }, pcx);
        let debug = hole_debug(item, pcx);
        let mut flags = pcx.nodes[item as usize].p;
        let ty = pcx.nodes[item as usize].ty;
        // (`__out.display(&__f0)`; through a pointer, `__f0.fmt(__out)`:
        // a pointer value is passed as a receiver)
        let mut write: i64 = 0;
        if (flags & FMT_PTR) != 0 {
            // (0.26.2) `{:p}`: the address, `0x..`
            flags = (flags & !FMT_PTR) | FMT_HEX | FMT_ALT;
            write = call1(ident(out, item, pcx), c"uint",
                cast_to(ident(name, item, pcx), TY_U64, item, pcx), pcx);
        } else if (flags & FMT_EXP) != 0 && is_integer(ty) {
            // (0.26.2) `{:e}` of an integer: as the f64 of its value
            write = call1(ident(out, item, pcx), c"display",
                cast_to(ident(name, item, pcx), TY_F64, item, pcx), pcx);
        } else if debug && debug_slice(ty, pcx) {
            write = call1(ident(out, item, pcx), c"debug_slice", ident(name, item, pcx), pcx);
        } else if takes_pointer(item, pcx) {
            let to = if direct { amp_mut(ident(out, item, pcx), pcx) }
                else { ident(out, item, pcx) };
            write = call1(ident(name, item, pcx), if debug { c"fmt_debug" } else { c"fmt" }, to,
                pcx);
        } else {
            write = call1(ident(out, item, pcx), if debug { c"debug" } else { c"display" },
                unary(Tok::Amp, ident(name, item, pcx), pcx), pcx);
        }
        let fill = hole_fill(item, pcx);
        let wv = pcx.nodes[item as usize].g;
        let pv = pcx.nodes[item as usize].h;
        let spec = pcx.nodes[item as usize].c > 0 || pcx.nodes[item as usize].d >= 0 || flags != 0
            || fill != 0 || wv != 0 || pv != 0;
        if spec && is_integer(ty) && (flags & !(FMT_LEFT | FMT_RIGHT | FMT_ZERO)) == 0 && fill == 0
            && wv == 0 && (pcx.nodes[item as usize].p & FMT_PTR) == 0 {
            // (0.16) A decimal integer with a spec: `__out.int_hole(__fN as
            // i64, w, flags)` (`uint_hole`, `as u64`), what spec, display
            // and end_spec write, in one pass (std's Display of an integer
            // writes only its digits)
            let signed = is_signed(ty);
            let hole = method_call(ident(out, item, pcx),
                if signed { c"int_hole" } else { c"uint_hole" }, pcx);
            let amark = list_begin(pcx);
            list_push(cast_to(ident(name, item, pcx), if signed { TY_I64 } else { TY_U64 }, item,
                pcx), pcx);
            list_push(int_node(if pcx.nodes[item as usize].c > 0 { pcx.nodes[item as usize].c }
                else { 0 }, item,
                pcx), pcx);
            list_push(int_node(flags, item, pcx), pcx);
            list_end(hole, amark, pcx);
            list_push(stmt(hole, pcx), pcx);
        } else if spec {
            // let __sN = __out.spec(w, p, flags); write; __out.end_spec(__sN);
            let saved = hidden(c"__s", holes, pcx);
            let spec = method_call(ident(out, item, pcx), c"spec", pcx);
            let amark = list_begin(pcx);
            if wv != 0 {
                list_push(cast_to(ident(pcx.nodes[wv as usize].a, wv, pcx), TY_I64, wv, pcx), pcx);
            } else {
                list_push(int_node(if pcx.nodes[item as usize].c > 0 { pcx.nodes[item as usize].c }
                    else { 0 }, item,
                    pcx), pcx);
            }
            if pv != 0 {
                list_push(cast_to(ident(pcx.nodes[pv as usize].a, pv, pcx), TY_I64, pv, pcx), pcx);
            } else {
                list_push(int_node(pcx.nodes[item as usize].d, item, pcx), pcx);
            }
            list_push(int_node(flags | fill << 16, item, pcx), pcx);
            list_end(spec, amark, pcx);
            list_push(let_node(saved, spec, item, false, pcx), pcx);
            list_push(stmt(write, pcx), pcx);
            list_push(stmt(call1(ident(out, item, pcx), c"end_spec", ident(saved, item, pcx),
                pcx), pcx), pcx);
        } else {
            list_push(stmt(write, pcx), pcx);
        }
        holes += 1;
    }
}

// `e as T`, T a primitive type, at node at.
fn cast_to(e: i64, t: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let cast = new_node(NodeKind::Cast, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    let tname = new_node(NodeKind::TyName, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[tname as usize].a = intern_c(primitive_name(t), pcx);
    pcx.nodes[tname as usize].ty = t;
    pcx.nodes[cast as usize].a = e;
    pcx.nodes[cast as usize].b = tname;
    cast
}

// ---- (0.17) f-strings written straight into std's printing ----

// What direct_kind returns: the std function an f-string is passed to.
const D_PRINT: i64 = 1;
const D_PRINTLN: i64 = 2;
const D_EPRINT: i64 = 3;
const D_EPRINTLN: i64 = 4;
const D_FORMAT_IN: i64 = 5;
const D_PUSH_FMT: i64 = 6;
// (0.27.2: std2's panic, F16.3)
const D_PANIC: i64 = 7;

// (0.27.2) std2's fmt::write and writeln (F16.1): the destination is the
// call's first argument, bound as `__r` (a `&mut W`), the f-string its
// second.
pub const D_WRITE: i64 = 8;
pub const D_WRITELN: i64 = 9;

// (0.17) Whether call n of function f (a template; n's named arguments
// normalized; `method`: a method call, its receiver not among them) is
// std's print, println, eprint, eprintln, format_in or (a method)
// Buf::push_fmt with an f-string as its Display argument, outside std:
// which one (D_*), else 0.
pub fn direct_kind(n: i64, f: i64, method: bool, pcx: &Ctx<Comp>) -> i64 {
    if pcx.std_module < 0 || !within_std(pcx.fns[f as usize].module, pcx)
        || within_std(pcx.cur_mod, pcx) && !crate::front::known::on_std2(pcx)
        || pcx.const_context
        || pcx.nodes[n as usize].count == 0 {
        return 0;
    }
    let name = sym_text(pcx.nodes[pcx.fns[f as usize].node as usize].a, pcx);
    // RULE: F16.3 (std2's `write(w, "..")`, `writeln`: the f-string second)
    if !method && (name == b"write" || name == b"writeln") && crate::front::known::on_std2(pcx) {
        if pcx.nodes[n as usize].count != 2 {
            return 0;
        }
        let fs = child(n, 1, pcx);
        // (0.28.0) a literal with no hole too, as print's below: written
        // as it is, to an io::Write as well (`writeln(&mut file, "done")`)
        // (fmt's: std::fs::write(path, "text") is another `write`)
        let full = sym_text(pcx.fns[f as usize].name, pcx);
        let plain = pcx.nodes[fs as usize].kind == NodeKind::Str
            && (full == b"std.fmt.write" || full == b"std.fmt.writeln");
        if !plain
            && (pcx.nodes[fs as usize].kind != NodeKind::Interp || pcx.nodes[fs as usize].y != 0) {
            return 0;
        }
        return if name == b"write" { D_WRITE } else { D_WRITELN };
    }
    let fs = child(n, 0, pcx);
    // (0.27.3) on std2, a literal with no hole too, as Rust's format
    // literal: its text written as it is, not through str's Display and
    // its padding (Formatter::pad). RULE: F16.3
    let plain = pcx.nodes[fs as usize].kind == NodeKind::Str && !method
        && crate::front::known::on_std2(pcx)
        && (name == b"print" || name == b"println" || name == b"eprint" || name == b"eprintln");
    if !plain
        && (pcx.nodes[fs as usize].kind != NodeKind::Interp || pcx.nodes[fs as usize].y != 0) {
        return 0;
    }
    let k: i64 = if method {
        // (0.20: Buf's; String's is an ordinary call)
        if name == b"push_fmt"
            && sym_text(pcx.nodes[pcx.fns[f as usize].node as usize].d, pcx)
            == b"Buf" { D_PUSH_FMT }
        else { 0 }
    } else if name == b"print" {
        D_PRINT
    } else if name == b"println" {
        D_PRINTLN
    } else if name == b"eprint" {
        D_EPRINT
    } else if name == b"eprintln" {
        D_EPRINTLN
    } else if name == b"format_in" {
        D_FORMAT_IN
    } else if name == b"panic" && crate::front::known::on_std2(pcx) {
        D_PANIC
    } else {
        0
    };
    let count: i64 = if k == D_FORMAT_IN { 2 } else { 1 };
    if k == 0 || pcx.nodes[n as usize].count != count
        || pcx.nodes[child(n, count - 1, pcx) as usize].kind == NodeKind::NamedArg {
        return 0;
    }
    k
}

// (0.17) Call n of std function f (direct_kind k; `recv`, push_fmt's
// receiver as its `self` takes it, checked, else 0) with its f-string fs
// written in place: no closure, no std::Interp, no instance of f. n
// becomes an Interp node (the back ends lower its y, as an f-string's)
// whose y is the block
//
//   { [let __r = recv;] let __f0 = e0; ...; [let __a = a;] BODY }
//
// (BODY: direct_body): the receiver, the holes left to right, then the
// allocator, where the call evaluates them. A copy of the call as written
// is kept for `query refs` (not lowered); fs's y is -1 (`query type`
// shows its type as an Interp's); n's x is f + 1 (effects: what the
// writes do is the call's, `println(f"..")` calls 'std::println'). The
// call's type.
pub fn direct_call(n: i64, f: i64, k: i64, recv: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let mut fs = child(n, 0, pcx);
    if pcx.nodes[fs as usize].kind == NodeKind::Str {
        // (a literal with no hole, direct_kind: an f-string of its text)
        let lit = fs;
        fs = new_node(NodeKind::Interp, pcx.nodes[lit as usize].start, pcx.nodes[lit as usize].end,
            pcx);
        let mark = list_begin(pcx);
        list_push(lit, pcx);
        list_end(fs, mark, pcx);
    }
    let orig = new_node(NodeKind::Call, start, end, pcx);
    pcx.nodes[orig as usize].a = if recv == 0 { pcx.nodes[n as usize].a } else { 0 };
    // (0.27.6: a method's name, as a written call has it: the translator's
    // rows, `x.push_fmt("..")`)
    pcx.nodes[orig as usize].b = if recv != 0
        && pcx.nodes[n as usize].kind == NodeKind::MethodCall { pcx.nodes[n as usize].b }
        else { 0 };
    pcx.nodes[orig as usize].x = f + 1;
    let omark = list_begin(pcx);
    if recv != 0 {
        list_push(recv, pcx);
    }
    for i in 0..pcx.nodes[n as usize].count {
        list_push(child(n, i, pcx), pcx);
    }
    list_end(orig, omark, pcx);
    let mut ok = check_holes(fs, true, pcx);
    let mut alloc: i64 = 0;
    if k == D_FORMAT_IN {
        alloc = child(n, 1, pcx);
        let t = synth_expr(alloc, pcx);
        ok = ok && t != pcx.ty_error && allocator_ok(t, f, start, pcx);
    }
    pcx.nodes[fs as usize].y = -1;
    pcx.nodes[fs as usize].ty = TY_UNIT;
    let block = new_node(NodeKind::Block, start, end, pcx);
    let mut t = pcx.ty_error;
    if ok {
        let lets = list_begin(pcx);
        if recv != 0 {
            list_push(let_node(intern_c(c"__r", pcx), recv, n, false, pcx), pcx);
        }
        push_hole_lets(fs, pcx);
        if alloc != 0 {
            list_push(let_node(intern_c(c"__a", pcx), alloc, n, false, pcx), pcx);
        }
        list_end(block, lets, pcx);
        let body = direct_body(fs, k, n, recv != 0 && io_destination(recv, pcx), pcx);
        pcx.nodes[block as usize].a = body;
        push_scope(pcx);
        bind_lets(block, pcx);
        if recv != 0 {
            // (its safety is the call's, checked)
            { let at_ix = pcx.nodes[pcx.nodes[child(block, 0, pcx) as usize].a as usize].x as usize;
                pcx.locals[at_ix].borrow = true };
        }
        // RULE: F0.6 (0.27.5: the literal's text, the bytes the writer
        // takes, not a `&str` where a `&[u8]` goes: the holes are checked
        // already, bind_lets)
        pcx.text_bytes += 1;
        t = synth_expr(body, pcx);
        pcx.text_bytes -= 1;
        pop_scope(pcx);
    }
    pcx.nodes[block as usize].ty = t;
    pcx.nodes[orig as usize].ty = t;
    let lowered = new_node(NodeKind::Interp, start, end, pcx);
    pcx.nodes[n as usize] = pcx.nodes[lowered as usize];
    pcx.nodes[n as usize].x = f + 1;
    pcx.nodes[n as usize].y = block;
    pcx.nodes[n as usize].ty = t;
    t
}

// RULE: F16.3 (0.27.3) Whether write's destination recv (checked: `&mut W`
// or `W`) is an io::Write's rather than a fmt::Write's: on std2, its
// referent does not implement std::fmt::Write (Vec<u8>, Stdout, a File).
fn io_destination(recv: i64, pcx: &mut Ctx<Comp>) -> bool {
    if !crate::front::known::on_std2(pcx) {
        return false;
    }
    let key = crate::base::find_sym(b"std::fmt::Write", pcx);
    if key < 0 {
        return false;
    }
    let tr = ((pcx.sym_trait[key as usize])) - 1;
    let t = pcx.nodes[recv as usize].ty;
    if tr < 0 || t <= 0 || t == pcx.ty_error {
        return false;
    }
    let p = if pcx.types[t as usize].kind == TyKind::Ptr
        && pcx.types[t as usize].a > 0 { pcx.types[t as usize].a } else { t };
    !implements(tr, p, pcx)
}

// (0.17) Whether t, format_in's allocator, is an Allocator; else the error
// instantiating f (format_in) gives.
fn allocator_ok(t: i64, f: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    let tr = std_trait(c"Allocator", pcx);
    if tr < 0 || implements(tr, t, pcx) {
        return true;
    }
    err_begin(pos, pcx);
    err_str(c"the trait 'Allocator' is not implemented for '", pcx);
    err_type(t, pcx);
    err_str(c"'", pcx);
    err_help(c"required by the bound 'A: Allocator' of '", pcx);
    err_help_sym(pcx.fns[f as usize].display, pcx);
    err_help(c"'", pcx);
    err_end(pcx);
    false
}

// (0.17) The block direct_call writes f-string fs with, at call n, for
// kind k:
//
//   print, println, eprint, eprintln (fd 1 or 2):
//     { let mut __out = std::__print_begin(FD); WRITES; [__out.byte('\n');]
//       std::__print_end(&mut __out); }
//   push_fmt:
//     { let mut __out = std::__buf_fmt(__r);
//       loop { WRITES; if std::__buf_fmt_end(__r, &__out) { break; } } }
//   format_in:
//     { let mut __b = std::string::String::new_in(__a); let mut __t = [0u8; 256];
//       let mut __out = std::__fmt_tmp(&__t);
//       loop { WRITES; if std::__fmt_str_end(&__b, &__out) { break; } }
//       __b }
//   (0.26.3: a String, as std's format_in makes; a Buf before)
//
// (WRITES: push_writes; std's helpers: compiler/std/fmt.vl.)
fn direct_body(fs: i64, k: i64, n: i64, io: bool, pcx: &mut Ctx<Comp>) -> i64 {
    if crate::front::known::on_std2(pcx) && k != D_PUSH_FMT {
        return direct_body_std2(fs, k, n, io, pcx);
    }
    let out = intern_c(c"__out", pcx);
    let none = 0 as *mut u8;
    let stmts = list_begin(pcx);
    let mut tail: i64 = 0;
    if k == D_FORMAT_IN {
        let b = intern_c(c"__b", pcx);
        let t = intern_c(c"__t", pcx);
        let new_in = string_new_in(ident(intern_c(c"__a", pcx), n, pcx), n, pcx);
        // (0.17: no drop: the block's value, moved out by its tail; the
        // own walk sees the holes as borrows, not this move)
        let lb = let_node(b, new_in, n, true, pcx);
        pcx.nodes[lb as usize].p |= NO_DROP;
        list_push(lb, pcx);
        let zero = new_node(NodeKind::Int, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx);
        pcx.nodes[zero as usize].b = SUF_U8;
        let tmp = new_node(NodeKind::Repeat, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx);
        pcx.nodes[tmp as usize].a = zero;
        pcx.nodes[tmp as usize].b = int_node(256, n, pcx);
        list_push(let_node(t, tmp, n, true, pcx), pcx);
        let fmt = std_call(none, c"__fmt_tmp", amp_mut(ident(t, n, pcx), pcx), 0, 0, n, pcx);
        list_push(let_node(out, fmt, n, true, pcx), pcx);
        let end = std_call(none, c"__fmt_str_end", amp_mut(ident(b, n, pcx), pcx),
            amp_mut(ident(out, n, pcx), pcx), 0, n, pcx);
        list_push(stmt(retry_loop(fs, out, end, n, pcx), pcx), pcx);
        tail = ident(b, n, pcx);
    } else if k == D_PUSH_FMT {
        let r = intern_c(c"__r", pcx);
        // (`&mut *__r`: the receiver, `&b` or a pointer, as std's `&mut Buf`)
        let buf = amp_mut(unary(Tok::Star, ident(r, n, pcx), pcx), pcx);
        list_push(let_node(out, std_call(none, c"__buf_fmt", buf, 0, 0, n, pcx), n, true, pcx),
            pcx);
        let end = std_call(none, c"__buf_fmt_end",
            amp_mut(unary(Tok::Star, ident(r, n, pcx), pcx), pcx),
            amp_mut(ident(out, n, pcx), pcx), 0, n, pcx);
        list_push(stmt(retry_loop(fs, out, end, n, pcx), pcx), pcx);
    } else {
        let fd = new_node(NodeKind::Int, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx);
        pcx.nodes[fd as usize].a = if k == D_EPRINT || k == D_EPRINTLN { 2 } else { 1 };
        // (0.21: __print_begin holds std's print lock once threads run)
        list_push(let_node(out, std_call(none, c"__print_begin", fd, 0, 0, n, pcx), n, true, pcx),
            pcx);
        push_writes(fs, out, true, pcx);
        if k == D_PRINTLN || k == D_EPRINTLN {
            let c = new_node(NodeKind::Char, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
                pcx);
            pcx.nodes[c as usize].a = b'\n' as i64;
            list_push(stmt(call1(ident(out, n, pcx), c"byte", c, pcx), pcx), pcx);
        }
        let end = std_call(none, c"__print_end", amp_mut(ident(out, n, pcx), pcx), 0, 0, n, pcx);
        list_push(stmt(end, pcx), pcx);
    }
    let body = new_node(NodeKind::Block, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    list_end(body, stmts, pcx);
    pcx.nodes[body as usize].a = tail;
    body
}

// (0.27.2) direct_body on std2 (a rust program's std): the f-string written
// through std2's Formatter, Rust's shape:
//
//   print, println, eprint, eprintln:
//     { let mut __o = std::io::stdout(); (stderr)
//       { let mut __out = std::fmt::Formatter::new(&mut __o);
//         WRITES; [__out.write_str("\n");] } }
//   format_in:
//     { let mut __b = std::string::String::new_in(__a);
//       { let mut __out = std::fmt::Formatter::new(&mut __b); WRITES } __b }
//
// WRITES: each text `__out.write_str("..")`, each hole
// `std::fmt::Display::fmt(&__fN, &mut __out)` (Debug for `{:?}`, LowerHex,
// UpperHex, Octal, Binary, LowerExp for theirs), a hole's spec (width,
// precision, fill, alignment, `+`, `#`, `0`) set before it by
// `__out.__spec(..)` and cleared after (spec_call). write and writeln
// write through their destination, `__r`, the last write their value.
// RULE: F16.3
fn direct_body_std2(fs: i64, k: i64, n: i64, io: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let out = intern_c(c"__out", pcx);
    let stmts = list_begin(pcx);
    let mut tail: i64 = 0;
    let write = k == D_WRITE || k == D_WRITELN;
    let dst = if k == D_FORMAT_IN { intern_c(c"__b", pcx) } else if k == D_PANIC {
        intern_c(c"__p", pcx) } else if write { intern_c(c"__r", pcx) }
        else { intern_c(c"__o", pcx) };
    if write && io {
        // RULE: F16.3 (0.27.3: an io::Write's, `let mut __o =
        // std::__rt::io_fmt(__r);`, its io::Result made by `__o.finish(..)`)
        let wrap = std_path_call(c"__rt", c"io_fmt", 0 as *mut u8,
            ident(intern_c(c"__r", pcx), n, pcx), 0, n, pcx);
        list_push(let_node(intern_c(c"__o", pcx), wrap, n, true, pcx), pcx);
    } else if write {
        // (`__r`, the `&mut W` direct_call bound: written through as it is)
    } else if k == D_FORMAT_IN {
        let new_in = string_new_in(ident(intern_c(c"__a", pcx), n, pcx), n, pcx);
        let lb = let_node(dst, new_in, n, true, pcx);
        pcx.nodes[lb as usize].p |= NO_DROP;
        list_push(lb, pcx);
    } else if k == D_PANIC {
        let open = std_path_call(c"__rt", c"PanicOut", c"new", 0, 0, n, pcx);
        list_push(let_node(dst, open, n, true, pcx), pcx);
        tail = method_call(ident(dst, n, pcx), c"panic", pcx);
        let none = list_begin(pcx);
        list_end(tail, none, pcx);
    } else {
        // (`let mut __s = std::io::stdout(); let mut __o = std::__rt::io_out(&mut __s);`)
        let err = k == D_EPRINT || k == D_EPRINTLN;
        let which = if err { c"stderr" } else { c"stdout" };
        let s = intern_c(c"__s", pcx);
        let open = std_path_call(c"io", which, 0 as *mut u8, 0, 0, n, pcx);
        list_push(let_node(s, open, n, true, pcx), pcx);
        let wrap = std_path_call(c"__rt", c"io_out", 0 as *mut u8, amp_mut(ident(s, n, pcx), pcx),
            0, n, pcx);
        list_push(let_node(dst, wrap, n, true, pcx), pcx);
    }
    let inner = list_begin(pcx);
    let to = if write && io { intern_c(c"__o", pcx) } else { dst };
    let made = std_path_call(c"fmt", c"Formatter", c"new",
        if write && !io { ident(dst, n, pcx) } else { amp_mut(ident(to, n, pcx), pcx) }, 0, n,
        pcx);
    list_push(let_node(out, made, n, true, pcx), pcx);
    if k == D_PANIC && !pcx.no_positions && pcx.cur_fn >= 0
        && !crate::front::modules::within_std(pcx.fns[pcx.cur_fn as usize].module, pcx) {
        // (0.28.0) a panic in the program says where: `FILE:LINE:COL: `
        // first, as a failed check does (and panic_site for a message
        // without holes)
        let b = crate::base::buf_new();
        crate::front::contracts::checks::put_position(b, pcx.nodes[n as usize].start, pcx);
        crate::base::buf_bytes(b, b": ");
        let at = new_node(NodeKind::Str, pcx.nodes[n as usize].start, pcx.nodes[n as usize].start,
            pcx);
        pcx.nodes[at as usize].a = crate::front::lexer::add_string(&crate::base::buf_copy(b), pcx);
        list_push(stmt(call1(ident(out, n, pcx), c"write_str", at, pcx), pcx), pcx);
    }
    push_writes_std2(fs, out, false, pcx);
    if k == D_PRINTLN || k == D_EPRINTLN {
        let nl = new_node(NodeKind::Str, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx);
        pcx.nodes[nl as usize].a = crate::front::lexer::add_string(b"\n", pcx);
        list_push(stmt(call1(ident(out, n, pcx), c"write_str", nl, pcx), pcx), pcx);
    }
    let writes = new_node(NodeKind::Block, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    list_end(writes, inner, pcx);
    if write {
        // (its fmt::Result: the last write's, `\n` for writeln, the block's
        // value; the writes before are a String's or a Formatter's, which
        // do not fail; 0.27.3 carries each one's error)
        let last = new_node(NodeKind::Str, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx);
        pcx.nodes[last as usize].a = crate::front::lexer::add_string(if k == D_WRITELN { b"\n" }
            else { b"" }, pcx);
        pcx.nodes[writes as usize].a = call1(ident(out, n, pcx), c"write_str", last, pcx);
        tail = writes;
        if io {
            // (`let __w = { WRITES }; __o.finish(__w)`)
            let w = intern_c(c"__w", pcx);
            list_push(let_node(w, writes, n, false, pcx), pcx);
            tail = call1(ident(intern_c(c"__o", pcx), n, pcx), c"finish", ident(w, n, pcx),
                pcx);
        }
    } else {
        list_push(stmt(writes, pcx), pcx);
    }
    if k == D_FORMAT_IN {
        tail = ident(dst, n, pcx);
    }
    let body = new_node(NodeKind::Block, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    list_end(body, stmts, pcx);
    pcx.nodes[body as usize].a = tail;
    body
}

// RULE: F16.3, F16.4 (0.27.4) The writes of format literal fs through std2's
// Formatter `out`, into the list being made: each text
// `out.write_str("..")`, each hole `std::fmt::Tr::fmt(&__fN, &mut out)` with
// its spec set before it and cleared after; `by_ref`: out is a `&mut
// Formatter` already (format_args's closure parameter), passed as it is.
fn push_writes_std2(fs: i64, out: i64, by_ref: bool, pcx: &mut Ctx<Comp>) {
    let mut holes: i64 = 0;
    for i in 0..pcx.nodes[fs as usize].count {
        let item = child(fs, i, pcx);
        if pcx.nodes[item as usize].kind == NodeKind::Str {
            list_push(stmt(call1(ident(out, item, pcx), c"write_str", item, pcx), pcx), pcx);
            continue;
        }
        if hole_eval_only(item, pcx) {
            holes += 1;
            continue;
        }
        let alias = hole_alias(item, pcx);
        let name = hidden(c"=f", if alias >= 0 { alias } else { holes }, pcx);
        let write = hole_write(item, name, out, by_ref, pcx);
        // (the hole's spec on the Formatter for its value, then cleared)
        let spec = hole_has_spec(item, pcx);
        if spec {
            list_push(stmt(spec_call(out, item, false, pcx), pcx), pcx);
        }
        let ws = stmt(write, pcx);
        // RULE: F18.5 (0.28.0: a hole of an open local, kept open by
        // check_holes: its write is made again when the local is solved,
        // hole_retype)
        let source = pcx.nodes[hole_source(fs, item, pcx) as usize].a;
        let k = crate::front::check::literals::open_leaf(source, pcx);
        if k >= 0 {
            let m = new_node(NodeKind::InterpHole, pcx.nodes[item as usize].start,
                pcx.nodes[item as usize].end, pcx);
            pcx.nodes[m as usize].a = ws;
            pcx.nodes[m as usize].b = item;
            pcx.nodes[m as usize].c = pcx.nodes[child(write, 0, pcx) as usize].b;
            pcx.nodes[m as usize].d = if by_ref { child(write, 1, pcx) }
                else { pcx.nodes[child(write, 1, pcx) as usize].b };
            pcx.nodes[m as usize].x = if by_ref { 1 } else { 0 };
            pcx.nodes[m as usize].y = name;
            crate::front::check::literals::open_record(k, m, pcx);
        }
        list_push(ws, pcx);
        if spec {
            list_push(stmt(spec_call(out, item, true, pcx), pcx), pcx);
        }
        holes += 1;
    }
}

// The write of hole item through std2's Formatter `out` (push_writes_std2),
// its value `name`: `std::fmt::Tr::fmt(&name, &mut out)`, Tr the trait its
// spec names.
fn hole_write(item: i64, name: i64, out: i64, by_ref: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let flags = pcx.nodes[item as usize].p;
    // (`{:p}` of a pointer: its Display; of a type with Pointer: that)
    let tr = if (flags & FMT_PTR) != 0 && !spec_trait_impl(item, pcx.nodes[item as usize].ty, pcx) {
        c"Display"
    } else {
        spec_trait(item, pcx)
    };
    let mut value = unary(Tok::Amp, ident(name, item, pcx), pcx);
    if (flags & crate::front::check::format::FMT_AS_SLICE) != 0 {
        // (`&__fN[..]`, `&(*__fN)[..]` for a reference to an array)
        let full = new_node(NodeKind::Range, pcx.nodes[item as usize].start,
            pcx.nodes[item as usize].end, pcx);
        let ix = new_node(NodeKind::Index, pcx.nodes[item as usize].start,
            pcx.nodes[item as usize].end, pcx);
        let ht = pcx.nodes[item as usize].ty;
        pcx.nodes[ix as usize].a = if ht > 0 && pcx.types[ht as usize].kind == TyKind::Ptr {
            unary(Tok::Star, ident(name, item, pcx), pcx)
        } else {
            ident(name, item, pcx)
        };
        pcx.nodes[ix as usize].b = full;
        value = unary(Tok::Amp, ix, pcx);
    }
    let dst = if by_ref { ident(out, item, pcx) }
        else { amp_mut(ident(out, item, pcx), pcx) };
    std_path_call(c"fmt", tr, c"fmt", value, dst, item, pcx)
}

// The hole of f-string fs whose value hole item writes: item, or the one
// it reads (HOLE_ALIAS).
fn hole_source(fs: i64, item: i64, pcx: &Ctx<Comp>) -> i64 {
    let alias = hole_alias(item, pcx);
    if alias < 0 {
        return item;
    }
    let mut j: i64 = 0;
    for i in 0..pcx.nodes[fs as usize].count {
        let h = child(fs, i, pcx);
        if pcx.nodes[h as usize].kind == NodeKind::InterpHole {
            if j == alias {
                return h;
            }
            j += 1;
        }
    }
    item
}

// RULE: F18.5 (0.28.0) The open local a hole of a direct call writes
// (push_writes_std2's record m, an InterpHole: its write statement a, its
// hole b, the identifiers of its value c and of its Formatter d, by_ref x,
// the value's name y) is solved to type t: the value's local and the hole
// take t, and the write is made and checked again, its impl t's (rustc
// picks the impl when the integer is typed, at the end if nothing does).
pub fn hole_retype(m: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let fid = pcx.nodes[m as usize].c;
    let oid = pcx.nodes[m as usize].d;
    if pcx.nodes[fid as usize].res != Res::Local || pcx.nodes[oid as usize].res != Res::Local {
        return;
    }
    let item = pcx.nodes[m as usize].b;
    let value = pcx.nodes[fid as usize].y;
    if pcx.locals[value as usize].ty == t {
        return;
    }
    pcx.locals[value as usize].ty = t;
    pcx.nodes[item as usize].ty = t;
    let write = hole_write(item, pcx.nodes[m as usize].y, pcx.nodes[oid as usize].a,
        pcx.nodes[m as usize].x != 0, pcx);
    // (the value and the Formatter by their locals, wherever this is)
    let saved_env = pcx.env.len() as i64;
    let saved_keep = pcx.open_keep;
    pcx.env.push(value);
    pcx.env.push(pcx.nodes[oid as usize].y);
    pcx.open_keep = false;
    synth_expr(write, pcx);
    pcx.open_keep = saved_keep;
    pcx.env.truncate(saved_env as usize);
    { let at_ix = pcx.nodes[m as usize].a as usize; pcx.nodes[at_ix].a = write };
}

// (0.27.2) Whether hole item has a spec std2's Formatter carries: a
// width, a precision, a fill, an alignment, `+`, `#` or `0`.
fn hole_has_spec(item: i64, pcx: &Ctx<Comp>) -> bool {
    let f = pcx.nodes[item as usize].p;
    pcx.nodes[item as usize].c >= 0 || pcx.nodes[item as usize].d >= 0 || hole_fill(item, pcx) != 0
        || (f & (crate::front::ast::FMT_LEFT | crate::front::ast::FMT_RIGHT
            | crate::front::check::format::FMT_CENTER | crate::front::check::format::FMT_PLUS
            | crate::front::check::format::FMT_ALT | crate::front::ast::FMT_ZERO
            | crate::front::check::format::FMT_MINUS)) != 0
}

// `__out.__spec(width, precision, fill, align, flags)` for hole item, or
// the empty spec's when `clear`. RULE: F16.3
fn spec_call(out: i64, item: i64, clear: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let f = pcx.nodes[item as usize].p;
    let width: i64 = if clear { -1 } else { pcx.nodes[item as usize].c };
    let precision: i64 = if clear { -1 } else { pcx.nodes[item as usize].d };
    let fill: i64 = if clear || hole_fill(item, pcx) == 0 { 32 } else { hole_fill(item, pcx) };
    let align: i64 = if clear { 0 }
        else if (f & crate::front::ast::FMT_LEFT) != 0 { 1 }
        else if (f & crate::front::ast::FMT_RIGHT) != 0 { 2 }
        else if (f & crate::front::check::format::FMT_CENTER) != 0 { 3 }
        else { 0 };
    let mut flags: i64 = 0;
    if !clear {
        if (f & crate::front::check::format::FMT_PLUS) != 0 {
            flags |= 1;
        }
        if (f & crate::front::check::format::FMT_MINUS) != 0 {
            flags |= 2;
        }
        if (f & crate::front::check::format::FMT_ALT) != 0 {
            flags |= 4;
        }
        if (f & crate::front::ast::FMT_ZERO) != 0 {
            flags |= 8;
        }
    }
    let c = method_call(ident(out, item, pcx), c"__spec", pcx);
    let mark = list_begin(pcx);
    list_push(int_node(width, item, pcx), pcx);
    list_push(int_node(precision, item, pcx), pcx);
    list_push(spec_int(fill, item, pcx), pcx);
    list_push(int_node(align, item, pcx), pcx);
    list_push(spec_int(flags, item, pcx), pcx);
    list_end(c, mark, pcx);
    c
}

// A u32 literal of value v (>= 0), at node at.
fn spec_int(v: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let lit = new_node(NodeKind::Int, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[lit as usize].a = v;
    pcx.nodes[lit as usize].b = crate::front::lexer::SUF_U32;
    lit
}

// `std::m::name(a0, a1)` (t the name, `name` none) or `std::m::t::name(a0,
// a1)`, at node at: a path whose list holds every segment.
fn std_path_call(m: *mut u8, t: *mut u8, name: *mut u8, a0: i64, a1: i64, at: i64,
    pcx: &mut Ctx<Comp>) -> i64 {
    let two = name == 0 as *mut u8;
    let last = if two { t } else { name };
    let path = new_node(NodeKind::Path, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[path as usize].a = intern_c(if two { m } else { t }, pcx);
    pcx.nodes[path as usize].b = intern_c(last, pcx);
    let pmark = list_begin(pcx);
    list_push(std_ident(at, pcx), pcx);
    list_push(ident(intern_c(m, pcx), at, pcx), pcx);
    if !two {
        list_push(ident(intern_c(t, pcx), at, pcx), pcx);
    }
    list_push(ident(intern_c(last, pcx), at, pcx), pcx);
    list_end(path, pmark, pcx);
    let call = new_node(NodeKind::Call, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[call as usize].a = path;
    let amark = list_begin(pcx);
    if a0 != 0 {
        list_push(a0, pcx);
        if a1 != 0 {
            list_push(a1, pcx);
        }
    }
    list_end(call, amark, pcx);
    call
}

// `loop { WRITES; if done { break; } }`: f-string fs written to `out`
// until `done` (a call) says the text is all there.
fn retry_loop(fs: i64, out: i64, done: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let stmts = list_begin(pcx);
    push_writes(fs, out, true, pcx);
    let then = new_node(NodeKind::Block, start, end, pcx);
    let tmark = list_begin(pcx);
    list_push(stmt(new_node(NodeKind::Break, start, end, pcx), pcx), pcx);
    list_end(then, tmark, pcx);
    let test = new_node(NodeKind::If, start, end, pcx);
    pcx.nodes[test as usize].a = done;
    pcx.nodes[test as usize].b = then;
    list_push(stmt(test, pcx), pcx);
    let body = new_node(NodeKind::Block, start, end, pcx);
    list_end(body, stmts, pcx);
    let repeat = new_node(NodeKind::Loop, start, end, pcx);
    pcx.nodes[repeat as usize].b = body;
    repeat
}

// `std::T::name(a0, a1, a2)` (T: none, `std::name(..)`; an argument 0:
// none, the rest too), at node at. (A path of three segments has them
// all in its list: front/parser/exprs.vl.)
fn std_call(t: *mut u8, name: *mut u8, a0: i64, a1: i64, a2: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let path = new_node(NodeKind::Path, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[path as usize].b = intern_c(name, pcx);
    if t == 0 as *mut u8 {
        pcx.nodes[path as usize].a = intern_c(c"std", pcx);
    } else {
        pcx.nodes[path as usize].a = intern_c(t, pcx);
        let pmark = list_begin(pcx);
        list_push(std_ident(at, pcx), pcx);
        list_push(ident(pcx.nodes[path as usize].a, at, pcx), pcx);
        list_push(ident(pcx.nodes[path as usize].b, at, pcx), pcx);
        list_end(path, pmark, pcx);
    }
    let call = new_node(NodeKind::Call, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[call as usize].a = path;
    let amark = list_begin(pcx);
    if a0 != 0 {
        list_push(a0, pcx);
        if a1 != 0 {
            list_push(a1, pcx);
            if a2 != 0 {
                list_push(a2, pcx);
            }
        }
    }
    list_end(call, amark, pcx);
    call
}

// (0.26.3) `std::string::String::new_in(a0)`, at node at: format_in's
// String (std's root does not re-export String; the prelude names it).
fn string_new_in(a0: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let path = new_node(NodeKind::Path, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[path as usize].a = intern_c(c"String", pcx);
    pcx.nodes[path as usize].b = intern_c(c"new_in", pcx);
    let pmark = list_begin(pcx);
    list_push(std_ident(at, pcx), pcx);
    list_push(ident(intern_c(c"string", pcx), at, pcx), pcx);
    list_push(ident(pcx.nodes[path as usize].a, at, pcx), pcx);
    list_push(ident(pcx.nodes[path as usize].b, at, pcx), pcx);
    list_end(path, pmark, pcx);
    let call = new_node(NodeKind::Call, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[call as usize].a = path;
    let amark = list_begin(pcx);
    list_push(a0, pcx);
    list_end(call, amark, pcx);
    call
}

// Hole h, of type t (not the error type): the trait its spec needs, and
// the integer its `x`, `X`, `b`, `c` need (`e`, `E`: the float). (0.26.2:
// `o` an integer, `e` an integer too, `p` a pointer, `x?` any Debug.)
fn check_hole(h: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let debug = hole_debug(h, pcx);
    let flags = pcx.nodes[h as usize].p;
    if spec_trait_impl(h, t, pcx) {
        return;
    }
    if (flags & FMT_PTR) != 0 {
        if !is_pointer(t, pcx) {
            spec_error(h, t, c"'p' writes an address: it needs a pointer, got '", pcx);
        }
        return;
    }
    let tr = std_trait(if debug { c"Debug" } else { c"Display" }, pcx);
    if tr < 0 {
        return;
    }
    let shown = if takes_pointer(h, pcx) { pcx.types[t as usize].a } else { t };
    if !implements(tr, shown, pcx) && !(debug && debug_slice(shown, pcx)) {
        // RULE: F16.4 (std2: an array's `{:?}` is its slice's)
        // (or a reference to one, `&a`)
        let arr = if shown > 0
            && pcx.types[shown as usize].kind == TyKind::Ptr { pcx.types[shown as usize].a }
            else { shown };
        if debug && crate::front::known::on_std2(pcx) && arr > 0
            && pcx.types[arr as usize].kind == TyKind::Array
            && implements(tr, crate::front::types::slice_of(pcx.types[arr as usize].a, pcx), pcx) {
            pcx.nodes[h as usize].p |= crate::front::check::format::FMT_AS_SLICE;
            return;
        }
        missing_trait(h, shown, debug, pcx);
    }
    if (flags & FMT_CHAR) != 0 && shown != TY_U8 {
        spec_error(h, shown, c"'c' writes a byte: it needs a 'u8', got '", pcx);
    }
    if (flags & (FMT_HEX | FMT_BIN | FMT_OCT)) != 0 && !debug && !is_integer(shown) {
        spec_error(h, shown,
            c"'x', 'X', 'o' and 'b' write an integer's digits: they need an integer, got '", pcx);
    }
    if (flags & FMT_EXP) != 0 && shown != TY_F64 && shown != TY_F32 && !is_integer(shown) {
        spec_error(h, shown,
            c"'e' and 'E' write a number with an exponent: they need an integer or a float, got '", pcx);
    }
}

// RULE: F16.5 (0.27.2.1) On std2 the trait that writes hole item, as in
// Rust: `x` LowerHex, `X` UpperHex, `o` Octal, `b` Binary, `e` LowerExp,
// `E` UpperExp, `p` Pointer, `?` Debug, else Display.
fn spec_trait(item: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    let flags = pcx.nodes[item as usize].p;
    if hole_debug(item, pcx) {
        c"Debug"
    } else if (flags & FMT_HEX) != 0 {
        if (flags & FMT_UPPER) != 0 { c"UpperHex" } else { c"LowerHex" }
    } else if (flags & FMT_OCT) != 0 {
        c"Octal"
    } else if (flags & FMT_BIN) != 0 {
        c"Binary"
    } else if (flags & FMT_EXP) != 0 {
        if (flags & FMT_UPPER) != 0 { c"UpperExp" } else { c"LowerExp" }
    } else if (flags & FMT_PTR) != 0 {
        c"Pointer"
    } else {
        c"Display"
    }
}

// RULE: F16.5 Whether hole h of type t, its spec one of std2's own traits
// (`{:b}`, `{:p}`: not Display or Debug), is written by a user type's impl
// of that trait (or its referent's).
fn spec_trait_impl(h: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    let flags = pcx.nodes[h as usize].p;
    if !crate::front::known::on_std2(pcx) || hole_debug(h, pcx)
        || (flags & (FMT_HEX | FMT_OCT | FMT_BIN | FMT_EXP | FMT_PTR)) == 0 {
        return false;
    }
    let tr = std_trait(spec_trait(h, pcx), pcx);
    if tr < 0 {
        return false;
    }
    let shown = if (flags & FMT_PTR) == 0 && is_pointer(t, pcx) && pcx.types[t as usize].a != 0 {
        pcx.types[t as usize].a
    } else {
        t
    };
    (pcx.types[shown as usize].kind == TyKind::Struct
        || pcx.types[shown as usize].kind == TyKind::Enum)
        && implements(tr, shown, pcx)
}

// Whether hole h (checked) is written through its value: a pointer to a
// type with the trait, the pointer type having none.
fn takes_pointer(h: i64, pcx: &mut Ctx<Comp>) -> bool {
    let t = pcx.nodes[h as usize].ty;
    if !is_pointer(t, pcx) || pcx.types[t as usize].a == 0
        || (pcx.nodes[h as usize].p & FMT_PTR) != 0 {
        return false;
    }
    let tr = std_trait(if hole_debug(h, pcx) { c"Debug" } else { c"Display" }, pcx);
    tr >= 0 && !implements(tr, t, pcx) && implements(tr, pcx.types[t as usize].a, pcx)
}

// (0.25.3, eval 0.25.2.2) Whether `{x:?}` of a value of type t writes it
// with Fmt::debug_slice: a slice whose elements have Debug (`[1, 2, 3]`,
// as a Vec's), the slice having none of its own (`[u8]` has, quoted).
fn debug_slice(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    let info = pcx.types[t as usize];
    if info.kind != TyKind::Slice {
        return false;
    }
    let tr = std_trait(c"Debug", pcx);
    tr >= 0 && !implements(tr, t, pcx) && implements(tr, info.a, pcx)
}

fn missing_trait(h: i64, t: i64, debug: bool, pcx: &mut Ctx<Comp>) -> ! {
    // RULE: F18.6 (a format hole of a type not known yet)
    crate::front::check::infer::unknown_in(t, pcx);
    err_begin(pcx.nodes[pcx.nodes[h as usize].a as usize].start, pcx);
    err_str(c"'", pcx);
    err_type(t, pcx);
    err_str(if debug {
        c"' does not implement Debug, which '{x:?}' needs"
    } else {
        c"' does not implement Display, which '{x}' needs"
    }, pcx);
    if pcx.types[t as usize].kind == TyKind::Struct || pcx.types[t as usize].kind == TyKind::Enum {
        if debug {
            err_help(
                c"derive it: '#[derive(Debug)]' before the type, or write 'impl Debug for ", pcx);
            buf_type(pcx.err_help, t, pcx);
            err_help(c" { fn fmt_debug(", pcx);
        } else {
            err_help(c"write 'impl Display for ", pcx);
            buf_type(pcx.err_help, t, pcx);
            err_help(c" { fn fmt(", pcx);
        }
        err_help(c"self", pcx);
        err_help(
            c", f: inout std::Fmt) { f.write(\"..\", args); } }'", pcx);
    } else if debug && pcx.types[t as usize].kind == TyKind::Slice {
        // (0.25.3) a slice is written with its elements' Debug
        err_help(c"a slice is written as a list of its elements' Debug, which '", pcx);
        buf_type(pcx.err_help, pcx.types[t as usize].a, pcx);
        err_help(
            c"' does not have: give it one ('#[derive(Debug)]' before a struct or an enum)", pcx);
    } else if !debug && debug_slice(t, pcx) {
        // (0.25.3) a slice of printable elements: Debug writes it
        err_help(c"a slice has no Display (no one way to separate its elements): '{x:?}' writes it as a list, '[1, 2, 3]', or format its parts", pcx);
    } else if !debug {
        err_help(c"write it with Debug, '{x:?}', or format its parts", pcx);
    }
    err_end(pcx)
}

fn spec_error(h: i64, t: i64, message: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[pcx.nodes[h as usize].a as usize].start, pcx);
    err_str(message, pcx);
    err_type(t, pcx);
    err_str(c"'", pcx);
    err_end(pcx)
}

// `=f3` (0.17: a hole, which the own walk reads, not moves: front/own/walk.vl's eval_let), `__s3`: a hidden local's name.
fn hidden(prefix: *mut u8, i: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_str(out, prefix);
    buf_int(out, i);
    intern_buf(out, pcx)
}

fn ident(sym: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let id = new_node(NodeKind::Ident, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[id as usize].a = sym;
    id
}

fn std_ident(at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    ident(intern_c(c"std", pcx), at, pcx)
}

fn unary(op: Tok, e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let u = new_node(NodeKind::Unary, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, pcx);
    pcx.nodes[u as usize].op = op;
    pcx.nodes[u as usize].b = e;
    u
}

// `&mut e` (0.18: what Display's and Fmt's `&mut Fmt` take).
fn amp_mut(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let u = unary(Tok::Amp, e, pcx);
    pcx.nodes[u as usize].p |= NODE_REF_MUT;
    u
}

// An i64 literal of value v (a negative one as `-v`), at node at.
fn int_node(v: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let lit = new_node(NodeKind::Int, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end,
        pcx);
    pcx.nodes[lit as usize].a = if v < 0 { -v } else { v };
    pcx.nodes[lit as usize].b = SUF_I64;
    if v < 0 { unary(Tok::Minus, lit, pcx) } else { lit }
}

// `receiver.name()`, its arguments to be added.
fn method_call(receiver: i64, name: *mut u8, pcx: &mut Ctx<Comp>) -> i64 {
    let c = new_node(NodeKind::MethodCall, pcx.nodes[receiver as usize].start,
        pcx.nodes[receiver as usize].end, pcx);
    pcx.nodes[c as usize].a = receiver;
    pcx.nodes[c as usize].b = intern_c(name, pcx);
    c
}

// `receiver.name(arg)`.
fn call1(receiver: i64, name: *mut u8, arg: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let c = method_call(receiver, name, pcx);
    let mark = list_begin(pcx);
    list_push(arg, pcx);
    list_end(c, mark, pcx);
    c
}

// `e;`
fn stmt(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let s = new_node(NodeKind::ExprStmt, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end,
        pcx);
    pcx.nodes[s as usize].a = e;
    pcx.nodes[s as usize].b = 1;
    s
}
