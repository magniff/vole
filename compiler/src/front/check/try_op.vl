// `e?` (0.15; docs/design/errors-formatting.md): with `e: Option<T>` it
// is the T, or returns None; with `e: Result<T, E>` the T, or returns
// `Err(conv(err))` (convert::error_conversion), from the function or the
// closure being checked (RETURN_TYPE). The Try node's `y` becomes
//     { let ?try = e; match ?try { std::Option::Some(?v) => ?v,
//                                  std::Option::None => return None } }
//     { let ?try = e; match ?try { std::Result::Ok(?v) => ?v,
//                                  std::Result::Err(?e) => return Err(conv(?e)) } }
// (the second arm ARM_SYNTHETIC; at -O2 the code is that of the match
// written by hand, tests/run/try_ir), which the back ends lower. The `let`
// binds e, checked once, by hand.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_help, err_str, err_sym};
use crate::front::ast::{ARM_SYNTHETIC, NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::check::{has_error_type, pop_scope, push_scope};
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::convert::{error_conversion, std_enum_name, std_variant_pattern};
use crate::front::patterns::check_pattern;
use crate::front::types::{buf_type, err_type};

// Which of Option (1) and Result (2) type t is (0: neither); its type
// arguments in *targs.
fn try_kind(t: i64, targs: inout i64, pcx: inout Ctx<Comp>) -> i64 {
    let name = std_enum_name(t, &targs, pcx);
    if name == 0 {
        0
    } else if name == intern_c(c"Option", &pcx) {
        1
    } else if name == intern_c(c"Result", &pcx) {
        2
    } else {
        0
    }
}

// The function or closure `?` returns from, for messages.
fn err_returner(pcx: Ctx<Comp>) {
    unsafe {
        if pcx.closure_stack.count > 0 || pcx.cur_fn < 0 {
            err_str(c"the closure", pcx);
        } else {
            err_str(c"'", pcx);
            err_sym(pcx.fns[pcx.cur_fn].display, pcx);
            err_str(c"'", pcx);
        }
    }
}

// The type of `e?` node n; `expected` is the type it is checked against
// (0: synthesized).
pub fn check_try(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let operand = pcx.nodes[n].a;
        let pos = pcx.nodes[n].end - 1;
        let t = synth_expr(operand, &pcx);
        if has_error_type(t, pcx) {
            return pcx.ty_error;
        }
        var targs = 0;
        let kind = try_kind(t, &targs, &pcx);
        if kind == 0 {
            err_begin(pos, &pcx);
            err_str(c"'?' needs an Option or a Result, got '", pcx);
            err_type(t, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        let r = pcx.return_type;
        if has_error_type(r, pcx) {
            return pcx.ty_error;
        }
        var rargs = 0;
        let rkind = try_kind(r, &rargs, &pcx);
        if rkind == 0 {
            err_begin(pos, &pcx);
            err_str(c"'?' needs ", pcx);
            err_returner(pcx);
            err_str(c" to return Option or Result; it returns '", pcx);
            err_type(r, pcx);
            err_str(c"'", pcx);
            err_help(c"make it return ", pcx);
            if kind == 1 {
                err_help(c"an Option: '-> Option<", pcx);
                buf_type(pcx.err_help, r, pcx);
                err_help(c">'", pcx);
            } else {
                err_help(c"a Result: '-> Result<", pcx);
                buf_type(pcx.err_help, r, pcx);
                err_help(c", ", pcx);
                buf_type(pcx.err_help, pcx.tlists.data[targs + 1], pcx);
                err_help(c">'", pcx);
            }
            err_end(&pcx);
        }
        if kind == 1 && rkind == 2 {
            err_begin(pos, &pcx);
            err_str(c"'?' on an Option in ", pcx);
            err_returner(pcx);
            err_str(c", which returns '", pcx);
            err_type(r, pcx);
            err_str(c"': a None has no error to return", pcx);
            err_help(c"make the None an error: 'e.ok_or(", pcx);
            buf_type(pcx.err_help, pcx.tlists.data[rargs + 1], pcx);
            err_help(c"::...)?'", pcx);
            err_end(&pcx);
        }
        if kind == 2 && rkind == 1 {
            err_begin(pos, &pcx);
            err_str(c"'?' on a Result in ", pcx);
            err_returner(pcx);
            err_str(c", which returns '", pcx);
            err_type(r, pcx);
            err_str(c"': the error would be lost", pcx);
            err_help(c"drop it explicitly: 'e.ok()?', or return a Result", pcx);
            err_end(&pcx);
        }
        let start = pcx.nodes[n].start;
        let end = pcx.nodes[n].end;
        // let ?try = e;
        let try_sym = intern_c(c"?try", &pcx);
        let bind = new_node(NodeKind::PatBind, start, end, &pcx);
        pcx.nodes[bind].a = try_sym;
        let let_stmt = new_node(NodeKind::Let, start, end, &pcx);
        pcx.nodes[let_stmt].a = bind;
        pcx.nodes[let_stmt].c = operand;
        // Some(?v) => ?v  /  Ok(?v) => ?v
        let v = intern_c(c"?v", &pcx);
        let vbind = new_node(NodeKind::PatBind, start, end, &pcx);
        pcx.nodes[vbind].a = v;
        let value_arm = new_node(NodeKind::Arm, start, end, &pcx);
        pcx.nodes[value_arm].a = std_variant_pattern(if kind == 1 { c"Option" } else { c"Result" },
            if kind == 1 { c"Some" } else { c"Ok" }, vbind, start, end, &pcx);
        pcx.nodes[value_arm].c = ident(v, start, end, &pcx);
        // _ => return None  /  Err(?e) => return Err(conv(?e))
        let ret = new_node(NodeKind::Return, start, end, &pcx);
        let other_arm = new_node(NodeKind::Arm, start, end, &pcx);
        pcx.nodes[other_arm].p = ARM_SYNTHETIC;
        pcx.nodes[other_arm].c = ret;
        if kind == 1 {
            pcx.nodes[other_arm].a = std_variant_pattern(c"Option", c"None", 0, start, end, &pcx);
            pcx.nodes[ret].a = variant_path(r, c"None", start, end, &pcx);
        } else {
            let e = intern_c(c"?e", &pcx);
            let ebind = new_node(NodeKind::PatBind, start, end, &pcx);
            pcx.nodes[ebind].a = e;
            pcx.nodes[other_arm].a = std_variant_pattern(c"Result", c"Err", ebind, start, end,
                &pcx);
            let conv = error_conversion(ident(e, start, end, &pcx), pcx.tlists.data[targs + 1],
                pcx.tlists.data[rargs + 1], pos, &pcx);
            let call = new_node(NodeKind::Call, start, end, &pcx);
            pcx.nodes[call].a = variant_path(r, c"Err", start, end, &pcx);
            let cmark = list_begin(pcx);
            list_push(conv, &pcx);
            list_end(call, cmark, &pcx);
            pcx.nodes[ret].a = call;
        }
        let m = new_node(NodeKind::Match, start, end, &pcx);
        pcx.nodes[m].a = ident(try_sym, start, end, &pcx);
        let amark = list_begin(pcx);
        list_push(value_arm, &pcx);
        list_push(other_arm, &pcx);
        list_end(m, amark, &pcx);
        let block = new_node(NodeKind::Block, start, end, &pcx);
        let bmark = list_begin(pcx);
        list_push(let_stmt, &pcx);
        list_end(block, bmark, &pcx);
        pcx.nodes[block].a = m;
        // (0.26.0: its `let` is a temporary of the statement, places IR)
        pcx.nodes[block].p |= crate::front::ast::BLOCK_TRANSPARENT;
        pcx.nodes[n].y = block;
        // The `let` by hand (e is checked), then the match.
        push_scope(&pcx);
        check_pattern(bind, t, &pcx);
        crate::front::own::drops::try_let_borrows(bind, operand, &pcx);
        let ty = if expected != 0 { check_expr(m, expected, &pcx) } else { synth_expr(m, &pcx) };
        pop_scope(&pcx);
        pcx.nodes[block].ty = pcx.nodes[m].ty;
        ty
    }
}

fn ident(sym: i64, start: i64, end: i64, pcx: inout Ctx<Comp>) -> i64 {
    let id = new_node(NodeKind::Ident, start, end, &pcx);
    pcx.nodes[id].a = sym;
    id
}

// `T::variant` (T the enum type t): a Path the checker resolves to t.
fn variant_path(t: i64, variant: *u8, start: i64, end: i64, pcx: inout Ctx<Comp>) -> i64 {
    let p = new_node(NodeKind::Path, start, end, &pcx);
    pcx.nodes[p].b = intern_c(variant, &pcx);
    pcx.nodes[p].y = t;
    p
}
