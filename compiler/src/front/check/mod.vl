// What an identifier names.
#[derive(Clone, Copy, PartialEq, Eq)] pub enum Res { None, Local, Const, Static, Fn }

// `borrow` (0.9): a parameter declared with a pointer type, not `mut`: a
// borrow of what the caller passed, dereferenced in safe code (see
// unsafety.vl).
// `tparam` (0.9): the bounded type parameter its declared type names (a
// parameter `x: T` or `x: *T`), whose bounds its methods come from; 0.
// `init` (0.17): v, for a local `let p = &v;` (not `mut`); 0.
// `twritten` (0.17): its type as written names a type parameter P: 1 for
// `*P`, 2 for `[P]` (written_param); 0.
#[derive(Clone, Copy)] pub struct Local {
    pub name: i64, pub ty: i64, pub mutable: bool, pub is_param: bool, pub offset: i64,
    pub borrow: bool, pub tparam: i64,
    init: i64,
    twritten: i64,
    pub access: bool,
    pub is_sink: bool,
    // RULE: Z9.1c (0.27.5) its type node as written (a parameter's, a
    // `let`'s annotation), 0: none (calls/mod.vl: template_param_trait)
    pub tnode: i64,
}

// ---- Errors ----

pub fn type_error(n: i64, message: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    error_at(pcx.nodes[n as usize].start, message, pcx)
}

// A value of type `actual` where `expected` goes (0.17: the conversion to
// write, as the try: line, when there is one: `x as i32`, `a[..]`,
// `b.as_slice()`, `v.as_slice()`, `&x`).
pub fn mismatch_error(n: i64, expected: i64, actual: i64, pcx: &mut Ctx<Comp>) -> ! {
    // (0.25.4: a contract message's hole, which the failure prints as an
    // integer: contract.message)
    if crate::front::contracts::expand::is_message_hole(n, pcx) {
        crate::front::contracts::expand::message_hole_error(n, actual, pcx);
    }
    // (0.18: a distinct type and its underlying type: distinct.mix)
    distinct_mismatch(n, expected, actual, pcx);
    // (0.20) a place where an exclusive reference is wanted: an inout
    // argument without its marker (conv.marker)
    // (0.27.0: `&x` where MVS std takes x by value, the rust edition's seam)
    if pcx.types[actual as usize].kind == TyKind::Ptr && pcx.types[actual as usize].b != 0
        && pcx.types[actual as usize].a == expected
        && pcx.nodes[n as usize].start > 0 && !crate::front::known::on_std2(pcx) {
        // RULE: Z4.1 (not on std2, whose functions take references where
        // Rust's do: the plain mismatch, E0308)
        crate::front::check::rust::std_by_value_error(n, expected, pcx);
    }
    // (0.25.2: a literal's default type as the cause, reported once)
    let literal = crate::front::check::literals::literal_let(n, expected, actual, pcx);
    if literal == 2 {
        crate::base::diag::err_jump(pcx);
    }
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"expected '", pcx);
    err_type(expected, pcx);
    err_str(c"', got '", pcx);
    err_type(actual, pcx);
    err_str(c"'", pcx);
    mismatch_help(n, expected, actual, pcx);
    if literal == 1 {
        crate::front::check::literals::literal_help(pcx.nodes[n as usize].start, pcx);
    }
    err_end(pcx)
}

fn mismatch_help(n: i64, expected: i64, actual: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if n == 0 || pcx.nodes[n as usize].end <= pcx.nodes[n as usize].start
            || expected == pcx.ty_error
            || actual == pcx.ty_error {
            return;
        }
        let text = &get_src()[
            pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
        // (an operator's operand: what binds looser than `as` and `!=`)
        let k = pcx.nodes[n as usize].kind;
        let simple = !(k == NodeKind::Binary || k == NodeKind::Unary || k == NodeKind::Cast
            || k == NodeKind::Range || k == NodeKind::If || k == NodeKind::Match
            || k == NodeKind::Block || k == NodeKind::Closure);
        let open: &[u8] = if simple { b"" } else { b"(" };
        let close: &[u8] = if simple { b"" } else { b")" };
        let ek = pcx.types[expected as usize].kind;
        let ak = pcx.types[actual as usize].kind;
        // (0.20) text: a String from a `str` or bytes, a `str` from a String
        let bytes = ak == TyKind::Slice && pcx.types[actual as usize].a == TY_U8;
        if ek == TyKind::Struct && is_std_named(expected, c"String", pcx)
            && (bytes || is_view_distinct(actual, pcx)) {
            err_help(c"a String owns its text, on an allocator: `String::from_in(s, gpa)`; a `&str` is a view of one (a `&str` parameter takes both: a literal, a String's `&s`)", pcx);
            err_try_fmt({
                let text = str::from_utf8(text).unwrap();
                format_args("String::from_in({text}, gpa)")
            }, pcx);
            return;
        }
        if ak == TyKind::Struct && is_std_named(actual, c"String", pcx)
            && (is_view_distinct(expected, pcx)
                || ek == TyKind::Slice && pcx.types[expected as usize].a == TY_U8) {
            err_help(
                c"a String is lent where a `&str` goes: `&s`, or `s.as_str()`", pcx);
            err_try_fmt({
                let text = str::from_utf8(text).unwrap(); format_args("({text}).as_str()")
            }, pcx);
            return;
        }
        // The conversion, written in place of the value (0.18: the fix
        // `volec fix --suggested` makes; `&x` of a simple value only).
        let t = buf_new();
        let mut exact = true;
        let bn = pcx.binary_node;
        // (and a fat one: a shared view, a shared reference to an array)
        let fat_shared = crate::front::types::is_raw_view(expected, pcx)
            && (ak == TyKind::Ptr && pcx.types[actual as usize].b == REF_SHARED
                || crate::front::distinct::strip_distinct(actual, pcx) > 0
                && pcx.types[crate::front::distinct::strip_distinct(actual, pcx) as usize].kind
                == TyKind::Slice
                && !crate::front::types::is_raw_view(actual, pcx)
                && !crate::front::types::is_mut_slice(actual, pcx));
        if (ek == TyKind::Ptr && pcx.types[expected as usize].b == 0 && ak == TyKind::Ptr
            && pcx.types[actual as usize].b == REF_SHARED || fat_shared) && n == pcx.raw_mut_at {
            // RULE: D3.6a (0.27.7: rustc's E0308; `&x` made `&mut x`)
            err_help(c"the types differ in mutability (rustc E0308): a `*mut T` takes an exclusive reference, `&mut x`; a `&T` coerces to `*const T` only", pcx);
            if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Amp
                && (pcx.nodes[n as usize].p & NODE_REF_MUT) == 0 {
                let operand = pcx.nodes[n as usize].b;
                buf_fmt(t, format_args("&mut {}",
                    &str::from_utf8(
                        get_src()[
                            pcx.nodes[operand as usize].start as usize..pcx.nodes[operand as usize].end as usize]).unwrap()));
                err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
                err_fix(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, buf_slice(t), pcx);
            }
            return;
        }
        if ek == TyKind::Ptr && pcx.types[expected as usize].b != 0
            && pcx.types[expected as usize].a == actual && (is_numeric(actual) || actual == TY_BOOL)
            && bn > 0 && pcx.nodes[bn as usize].kind == NodeKind::Binary
            && (pcx.nodes[bn as usize].b == n || pcx.nodes[bn as usize].c == n) {
            // (0.18.1) `n + 1` with `n: &i64` (a pattern's binding on a
            // reference, a closure's parameter): the other operand is the
            // reference, read through it
            let other = if pcx.nodes[bn as usize].b == n { pcx.nodes[bn as usize].c }
                else { pcx.nodes[bn as usize].b };
            let ok = pcx.nodes[other as usize].kind;
            let plain = ok == NodeKind::Ident || ok == NodeKind::FieldAccess
                || ok == NodeKind::TupleField || ok == NodeKind::Call || ok == NodeKind::Index;
            err_help(c"the other operand is a reference: read through it with '*'", pcx);
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[bn as usize].start as usize..pcx.nodes[other as usize].start as usize]);
            buf_bytes(t, if plain { b"*" } else { b"*(" });
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[other as usize].start as usize..pcx.nodes[other as usize].end as usize]);
            buf_bytes(t, if plain { b"" } else { b")" });
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[other as usize].end as usize..pcx.nodes[bn as usize].end as usize]);
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            err_fix(pcx.nodes[bn as usize].start, pcx.nodes[bn as usize].end, buf_slice(t), pcx);
            return;
        }
        if ak == TyKind::Slice
            && (is_std_named(expected, c"Vec", pcx) || is_std_named(expected, c"Buf", pcx))
            && bn > 0 && pcx.nodes[bn as usize].kind == NodeKind::Binary
            && (pcx.nodes[bn as usize].b == n || pcx.nodes[bn as usize].c == n) {
            // (0.25.3, eval 0.25.2.2: qwen35) `v == s`, a Vec (or a Buf) and
            // a slice: compared as slices, the Vec's `.as_slice()`
            let other = if pcx.nodes[bn as usize].b == n { pcx.nodes[bn as usize].c }
                else { pcx.nodes[bn as usize].b };
            let plain = plain_operand_text(
                &get_src()[
                    pcx.nodes[other as usize].start as usize..pcx.nodes[other as usize].end as usize]);
            err_help(c"a Vec and a slice are compared as slices: the Vec's is '.as_slice()'", pcx);
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[bn as usize].start as usize..pcx.nodes[other as usize].start as usize]);
            buf_bytes(t, if plain { b"" } else { b"(" });
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[other as usize].start as usize..pcx.nodes[other as usize].end as usize]);
            buf_bytes(t, if plain { b".as_slice()" } else { b").as_slice()" });
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[other as usize].end as usize..pcx.nodes[bn as usize].end as usize]);
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            err_fix(pcx.nodes[bn as usize].start, pcx.nodes[bn as usize].end, buf_slice(t), pcx);
            return;
        }
        if ak == TyKind::Ptr && pcx.types[actual as usize].b != 0
            && pcx.types[actual as usize].a == expected
            && !(pcx.nodes[n as usize].kind == NodeKind::Unary
                && pcx.nodes[n as usize].op == Tok::Amp) {
            // (0.18.1) `n` with `n: &i64` where an i64 is wanted (not
            // `&k` itself: the value was meant, below)
            err_help(c"it is a reference: read through it with '*'", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("*{open}{text}{close}") } } });
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            err_fix(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, buf_slice(t), pcx);
            return;
        }
        let p: i64 = if is_numeric(expected)
            && is_numeric(actual) { cast_parent(pcx.wrap_node, n, pcx) }
            else { 0 };
        if p != 0 {
            // (0.18.1) `cr - 1 as i32`: the whole operation, converted
            let c = pcx.nodes[p as usize].c;
            let ae = pcx.nodes[pcx.nodes[c as usize].a as usize].end;
            err_help(c"'as' binds tighter than the operator ('a - (1 as T)'): convert the whole operation", pcx);
            buf_fmt(t,
                format_args("({}){}",
                    &str::from_utf8(get_src()[pcx.nodes[p as usize].start as usize..ae as usize]).unwrap(), &str::from_utf8(get_src()[ae as usize..pcx.nodes[c as usize].end as usize]).unwrap()));
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            err_fix(pcx.nodes[p as usize].start, pcx.nodes[c as usize].end, buf_slice(t), pcx);
            return;
        }
        if is_numeric(expected) && is_numeric(actual) {
            err_help(c"only widening is implicit: convert explicitly", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("{open}{text}{close} as ") } } });
            buf_type(t, expected, pcx);
        } else if expected == TY_BOOL && is_integer(actual) {
            err_help(
                c"a condition is a bool: compare (`x != 0`); bitwise not is `!x`", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("{open}{text}{close} != 0") } } });
        } else if ek == TyKind::Slice && ak == TyKind::Array {
            err_help(c"an array is not a slice: take one of all of it", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("{open}{text}{close}[..]") } } });
        }
        else if ek == TyKind::Slice && pcx.types[expected as usize].a == TY_U8
            && is_std_named(actual, c"Buf", pcx) {
            err_help(c"a Buf's text is its slice", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("{open}{text}{close}.as_slice()") } } });
        } else if ek == TyKind::Slice && is_std_named(actual, c"Vec", pcx) {
            err_help(c"a Vec's elements are its slice", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("{open}{text}{close}.as_slice()") } } });
        } else if ek == TyKind::Ptr && (k == NodeKind::PatVariant || k == NodeKind::PatTuple
            || k == NodeKind::PatLit || k == NodeKind::PatRange || k == NodeKind::PatOr) {
            // (0.18.1: a pattern on `&T` matches the T; a pattern is no
            // place for `&`)
            err_help(c"a pattern matches what one reference points to ('match e' on 'e: &E'); a raw pointer's value is 'match *p', in unsafe code", pcx);
        }
        else if ek == TyKind::Ptr && pcx.types[expected as usize].a == actual && ak == TyKind::Slice
            && pcx.nodes[n as usize].start > 0
            && get_src()[(pcx.nodes[n as usize].start - 1) as usize] == b'&' {
            // (0.18.1: `&x.text()` here was the slice itself)
            err_help(c"'&' of a slice value is the slice; for a '&[T]', name it first: 'let t = VALUE;' before the statement, then '&t'", pcx);
            exact = false;
        }
        else if ek == TyKind::Ptr && pcx.types[expected as usize].a == actual
            && pcx.types[expected as usize].b == REF_SHARED {
            // (0.28.0: a value that is no place, a call's result or an
            // operation, where a shared reference goes: lent as Rust's
            // temporary, `&f()`, `&(a + 1)`)
            err_help(c"a reference is expected: lend the value with `&` (a temporary lives to the end of the statement)", pcx);
            buf_fmt(t,
                { let open = str::from_utf8(open).unwrap();
                    { let text = str::from_utf8(text).unwrap();
                        { let close = str::from_utf8(close).unwrap();
                            format_args("&{open}{text}{close}") } } });
        } else if ek == TyKind::Ptr && pcx.types[expected as usize].a == actual {
            if pcx.types[expected as usize].b == REF_MUT {
                // (0.28.0: Rust's marker, `&mut x`)
                err_help(c"the parameter takes an exclusive reference, which the callee may change: `&mut x` (of a `let mut x`)", pcx);
                buf_fmt(t,
                    { let text = str::from_utf8(text).unwrap(); format_args("&mut {text}") });
            } else {
                err_help(c"a pointer to it: its address", pcx);
                buf_fmt(t, { let text = str::from_utf8(text).unwrap(); format_args("&{text}") });
            }
            exact = simple;
        }
        else if ek == TyKind::Ptr && ak == TyKind::Ptr
            && pcx.types[expected as usize].a == pcx.types[actual as usize].a
            && pcx.types[expected as usize].b == REF_MUT
            && pcx.types[actual as usize].b == REF_SHARED && k == NodeKind::Unary
            && pcx.nodes[n as usize].op == Tok::Amp {
            // (0.17) `&x` where `&mut T` is expected
            let operand = pcx.nodes[n as usize].b;
            // RULE: F18.4 (0.27.6: rustc's E0308, the borrow made
            // exclusive)
            err_help(c"the types differ in mutability (rustc E0308): the parameter takes an exclusive reference, `&mut x`", pcx);
            buf_fmt(t, format_args("&mut {}",
                &str::from_utf8(
                    get_src()[
                        pcx.nodes[operand as usize].start as usize..pcx.nodes[operand as usize].end as usize]).unwrap()));
        }
        else if ek == TyKind::Slice && ak == TyKind::Slice
            && pcx.types[expected as usize].b == REF_MUT && pcx.types[actual as usize].b == 0
            && pcx.types[expected as usize].a == pcx.types[actual as usize].a {
            // RULE: F18.4 (0.27.6: `&a[..]` where `&mut [T]` goes: rustc's
            // E0308; the `&` before the slice made `&mut`)
            err_help(c"the types differ in mutability (rustc E0308): the parameter takes an exclusive reference, `&mut x`", pcx);
            let mut amp = pcx.nodes[n as usize].start - 1;
            while amp > 0 && (get_src()[amp as usize] == b' ' || get_src()[amp as usize] == b'\t') {
                amp -= 1;
            }
            if amp >= 0 && get_src()[amp as usize] == b'&' {
                let fixed = buf_new();
                buf_fmt(fixed,
                    { let text = str::from_utf8(text).unwrap(); format_args("&mut {text}") });
                err_try_fmt(str::from_utf8(buf_slice(fixed)).unwrap(), pcx);
                err_fix(amp, pcx.nodes[n as usize].end, buf_slice(fixed), pcx);
            }
            return;
        }
        else if ek == TyKind::Ptr && ak == TyKind::Ptr
            && pcx.types[expected as usize].a == pcx.types[actual as usize].a
            && pcx.types[expected as usize].b != 0 && pcx.types[actual as usize].b == 0 {
            // (0.17) a raw pointer where a reference is expected
            err_help(c"a raw pointer is not a reference: nothing checks what it points to; pass `&place`, or, in unsafe code, `&*p`", pcx);
        }
        else if ak == TyKind::Ptr && pcx.types[actual as usize].a == expected
            && pcx.types[actual as usize].b == REF_SHARED
            && k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Amp {
            // (0.18.1) `m.get(&k)`, `v.contains(&x)`: Rust's borrowed key
            err_help(c"a value is expected here, not a reference: pass it without the `&`", pcx);
            let operand = pcx.nodes[n as usize].b;
            buf_bytes(t,
                &get_src()[
                    pcx.nodes[operand as usize].start as usize..pcx.nodes[operand as usize].end as usize]);
        } else if is_vector(expected, pcx) && is_vector(actual, pcx)
            && type_size(expected, pcx) == type_size(actual, pcx) {
            // (0.19: `vaddq_u8(a, b)` with a: v16i8; __m128i and the lanes)
            err_help(c"vectors of the same size convert by their bits, with no instruction", pcx);
            buf_type(t, expected, pcx);
            buf_fmt(t,
                { let text = str::from_utf8(text).unwrap(); format_args("::from_bits({text})") });
        } else if is_std_allocator(actual, pcx) && !is_std_allocator(expected, pcx) {
            // (0.18.1) `Vec::filled_in(gpa, n, x)`: the order of new_in(gpa)
            err_help(c"an allocator goes last in std's `_in` forms, as in Rust's allocator API: `Vec::filled_in(n, x, gpa)`, `with_capacity_in(n, gpa)`", pcx);
        }
        else if ek == TyKind::Ptr && pcx.types[expected as usize].b == REF_SHARED
            && is_numeric(actual) && is_numeric(pcx.types[expected as usize].a)
            && k == NodeKind::Int {
            // (0.28.0: `rd(5)` with `x: &i64`: the literal, lent)
            err_help(c"a reference is expected: lend the value with `&`", pcx);
            buf_fmt(t, { let text = str::from_utf8(text).unwrap(); format_args("&{text}") });
        }
        if (*get_bufs().add(t as usize)).len > 0 {
            err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
            if exact {
                err_fix(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, buf_slice(t), pcx);
            }
        }
    }
}

// (0.25.3) Whether expression text t needs no parentheses before a method
// call (`t.f()`): outside its brackets, only names, digits, `_`, `.` and
// `::` (`v`, `self.key`, `m.get(k, 1)`, `a[i]`, `std::f(x)`).
pub fn plain_operand_text(t: &[u8]) -> bool {
    let mut depth: i64 = 0;
    for &c in t {
        if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            depth -= 1;
        } else if depth == 0 && !(crate::front::lexer::is_ident_byte(c) || c == b'.' || c == b':') {
            return false;
        }
    }
    t.len() > 0 && depth == 0
}

// (0.18.1) Whether t is one of std's allocators (Gpa, Arena, ScopedArena,
// FixedBuf).
fn is_std_allocator(t: i64, pcx: &Ctx<Comp>) -> bool {
    is_std_named(t, c"Gpa", pcx) || is_std_named(t, c"Arena", pcx)
        || is_std_named(t, c"ScopedArena", pcx) || is_std_named(t, c"FixedBuf", pcx)
}

// (0.18.1) The binary operation in `root` whose left operand is n and
// whose right one is a cast ending it, `cr - 1 as i32` (`as` binds
// tighter: `cr - (1 as i32)`); 0 when there is none.
fn cast_parent(root: i64, n: i64, pcx: &Ctx<Comp>) -> i64 {
    if root <= 0 {
        return 0;
    }
    let k = pcx.nodes[root as usize].kind;
    if k == NodeKind::Binary && pcx.nodes[root as usize].b == n {
        let c = pcx.nodes[root as usize].c;
        let op = pcx.nodes[root as usize].op;
        if c > 0 && pcx.nodes[c as usize].kind == NodeKind::Cast
            && pcx.nodes[c as usize].end == pcx.nodes[root as usize].end
            && (op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
                || op == Tok::Percent || op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret
                || op == Tok::Shl || op == Tok::Shr) {
            return root;
        }
    }
    if node_field_a(k) {
        let r = cast_parent(pcx.nodes[root as usize].a, n, pcx);
        if r != 0 {
            return r;
        }
    }
    if node_field_b(k) {
        let r = cast_parent(pcx.nodes[root as usize].b, n, pcx);
        if r != 0 {
            return r;
        }
    }
    if node_field_c(k) {
        let r = cast_parent(pcx.nodes[root as usize].c, n, pcx);
        if r != 0 {
            return r;
        }
    }
    for i in 0..pcx.nodes[root as usize].count {
        let r = cast_parent(child(root, i, pcx), n, pcx);
        if r != 0 {
            return r;
        }
    }
    0
}

// Whether type t is std's struct `name` (an instance of it).
pub fn is_std_named(t: i64, name: *mut u8, pcx: &Ctx<Comp>) -> bool {
    if pcx.types[t as usize].kind != TyKind::Struct {
        return false;
    }
    let b = buf_new();
    buf_type(b, t, pcx);
    let s = buf_slice(b);
    let w = cstr(name);
    s.len() >= w.len() && s[0..w.len()] == w
        && (s.len() == w.len() || s[w.len()] == b'<')
}

// `message` followed by `, got '<type>'`.
pub fn type_error_got(n: i64, message: *mut u8, t: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(message, pcx);
    err_str(c", got '", pcx);
    err_type(t, pcx);
    err_str(c"'", pcx);
    err_end(pcx)
}

pub fn name_error(pos: i64, before: *mut u8, name: i64, after: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pos, pcx);
    err_str(before, pcx);
    err_sym(name, pcx);
    err_str(after, pcx);
    err_end(pcx)
}

// ---- Scopes ----

pub fn push_scope(pcx: &mut Ctx<Comp>) {
    pcx.check_scopes.push(pcx.env.len() as i64);
}

pub fn pop_scope(pcx: &mut Ctx<Comp>) {
    pcx.env.truncate(pcx.check_scopes.pop().unwrap() as usize);
}

pub fn define_local(name: i64, ty: i64, mutable: bool, is_param: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let id = pcx.locals.len() as i64;
    pcx.locals.push(Local {
        name: name, ty: ty, mutable: mutable, is_param: is_param, offset: 0,
        // (0.17: a reference is a borrow)
        borrow: ty > 0 && is_ref(ty, pcx),
        tparam: 0,
        init: 0,
        twritten: 0,
        tnode: 0,
        access: false,
        is_sink: false,
    });
    pcx.env.push(id);
    id
}

// The innermost local named `name`, or -1.
pub fn lookup_local(name: i64, pcx: &Ctx<Comp>) -> Option<i64> {
    if pcx.const_context {
        return Option::None;
    }
    let mut i = pcx.env.len() as i64 - 1;
    // RULE: F34.2 (a constant's copied value sees no local of its use)
    while i >= pcx.env_floor {
        let id = (pcx.env[i as usize]);
        if pcx.locals[id as usize].name == name {
            return Option::Some(id);
        }
        i -= 1;
    }
    Option::None
}

// ---- Declarations ----

pub fn check_program(program: i64, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    let mut fcx = features_cx_new();
    let mut kcx = contracts_cx_new();
    let mut wcx = embed_cx_new();
    let mut thcx = threads_cx_new();
    let mut pbody = body_new();
    pcx.program = program;
    pcx.self_type_sym = intern_c(c"Self", pcx);
    pcx.self_sym = intern_c(c"self", pcx);
    init_modules(pcx);
    init_traits(pcx);
    // The declarations, one phase after the other (see collect_phase),
    // then every function body, whatever errors the declarations had
    // (0.10: what failed in them is the error type, or left out).
    // (0.15: `#[derive(...)]`, impls added to the program; std's
    // functions lazy)
    // (0.26.0: `embed wgsl K { .. }`: its struct and static, front/embed)
    crate::front::embed::wgsl::expand_embeds(&mut wcx, pcx, wgx);
    expand_derives(pcx);
    // (0.27.2: `#[builtin_impls(P, ..)]`, impls added to the program, F15.1)
    crate::front::builtin_impls::expand_builtin_impls(pcx);
    // (0.18: clauses made into functions, front/contracts/expand.vl)
    // (0.19: #[multiversion]'s versions and dispatchers)
    crate::front::features::multiversion::expand_multiversion(&mut fcx, pcx);
    crate::front::contracts::expand::expand_contracts(&mut kcx, pcx);
    lazy_std(program, pcx);
    for phase in 0..PHASE_COUNT {
        collect_phase(phase, pcx);
    }
    // (0.15: the fields of a derived impl have its trait)
    check_derives(pcx);
    // RULE: Z3.1 (--verify-places: every known item std2 has)
    if pcx.verify_places {
        crate::front::known::known_items_check(pcx);
    }
    // (0.15: `fn main() -> Result<(), E>`)
    // (0.16: `fn main(gpa: Gpa)`)
    main_gpa(pcx);
    main_result_wrapper(pcx);
    // (0.26.3: allocation as a capability, check/alloc_rules)
    crate::front::check::alloc_rules::check_alloc_rules(pcx);
    for i in 0..pcx.nodes[program as usize].count {
        let item = child(program, i, pcx);
        // (x is 0 for a function left out by its declaration's error)
        // (0.14: a lazy default is checked when first used: ensure_checked)
        if pcx.nodes[item as usize].kind == Fn && pcx.nodes[item as usize].x != 0
            && pcx.fns[(pcx.nodes[item as usize].x - 1) as usize].generic == 0
            && (pcx.nodes[item as usize].p & FN_LAZY) == 0 {
            check_function_recovering(item, pcx);
        }
    }
    // The instances, as they are made: an instance may make more.
    let mut q: i64 = 0;
    while q < pcx.inst_queue.len() as i64 {
        check_function_recovering(pcx.fns[(pcx.inst_queue[q as usize]) as usize].node,
            pcx);
        q += 1;
    }
    // RULE: D22.2 (0.27.2.1: the opaque instances, front/opaque.vl)
    crate::front::opaque::build_opaque_instances(program, pcx);
    q = pcx.inst_queue.len() as i64;
    // (0.17: std from its files, to be edited: its generic functions too)
    if pcx.std_tree != 0 as *mut u8 || crate::places::borrowck::std2::std2_check(pcx) {
        check_std_generics(program, pcx);
        while q < pcx.inst_queue.len() as i64 {
            check_function_recovering(
                pcx.fns[(pcx.inst_queue[q as usize]) as usize].node, pcx);
            q += 1;
        }
    }
    if pcx.query {
        check_unchecked(program, pcx);
    }
    // (0.27.1: contract.old before the places IR, as the checker's
    // errors: the borrow checker does not see such an ensures)
    crate::front::traits::check_copy_drop(pcx);
    crate::front::contracts::check_contract_olds(pcx);
    // (0.26.0: the places IR, every checked body: places/; before the
    // effects, which see the own pass's drops as before)
    crate::places::run_places(&mut pbody, pcx);
    // (0.16: the statics that call constant constructors)
    check_static_calls(pcx);
    // (0.8: `*` imports and plain header imports, once the names used
    // through them are known)
    report_legacy_imports(true, pcx);
    // (0.16: the effects of every function, then the declared ones)
    // (none at -O0 when nothing reads them: EFFECTS_WANTED)
    let threads = crate::front::threads::uses_threads(&mut thcx, pcx);
    if pcx.effects_wanted || effects_declared(pcx) || threads {
        infer_effects(pcx);
        check_effects(pcx);
    }
    // (0.25: no view in a channel, a Mutex or an atomic)
    crate::front::threads::check_sync_items(&mut thcx, pcx);
    // (0.21: what crosses threads, front/threads)
    if threads {
        crate::front::threads::check_threads(&mut thcx, pcx);
    }
    // (0.19: target features, when the program names std::arch)
    crate::front::features::check_features(&mut fcx, pcx);
    // (0.18: the clauses, front/contracts; phase 0 reads them only)
    check_contracts(pcx);
    // (0.18 with 0.17: a distinct type over a Drop type, known now)
    crate::front::check::distinct::check_distinct_kinds(pcx);
    // (0.26.2: std::gpu's calls against the blocks, front/embed/gpu_lint)
    crate::front::embed::gpu_lint::gpu_lint(&mut wcx, pcx);
    exit_if_errors(pcx);
    // (0.20: std's `str` becomes `[u8]`, a view the own pass checks)
    crate::front::check::distinct::erase_view_distincts(pcx);
    // (0.26.0: --places-diff)
    crate::places::after_own(pcx);
    exit_if_errors(pcx);
    // (0.26.3: the uses of #[deprecated] items, warnings)
    crate::front::check::deprecated::report_deprecated_uses(pcx);
    // (0.25.2: the imports nothing names, a warning, use.unused; after
    // the checks, which --deny-warnings would stop)
    crate::tools::fix::report_unused_imports(pcx);
    exit_if_errors(pcx);
    // (0.18: distinct types become their underlying types for the code
    // generators; tools keep them)
    if !pcx.query {
        erase_program_types(pcx);
    }
    finish_program(program, pcx);
}

const PHASE_COUNT: i64 = 15;

// One phase of the declarations. Each item recovers from its errors on
// its own (see attempt); an error none of them catches ends the checking.
fn collect_phase(phase: i64, pcx: &mut Ctx<Comp>) {
    let depth = pcx.recover_depth;
    let state = save_check_state(pcx);
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        match phase {
            0 => collect_names(pcx),
            1 => collect_uses(pcx),
            2 => collect_const_types(pcx),
            3 => collect_structs(pcx),
            4 => collect_enums(pcx),
            5 => resolve_all_uses(pcx),
            6 => collect_aliases(pcx),
            7 => check_struct_cycles(pcx),
            8 => collect_impls(pcx),
            9 => collect_methods(pcx),
            10 => collect_functions(pcx),
            11 => check_impl_signatures(pcx),
            12 => collect_statics(pcx),
            13 => evaluate_consts(pcx),
            _ => check_later_bounds(pcx),
        }
    } else {
        // Later phases would only report what follows from this error.
        restore_check_state(state, pcx);
        report_legacy_imports(false, pcx);
        exit_if_errors(pcx);
    }
    recover_leave(depth, pcx);
}

pub fn check_function_recovering(item: i64, pcx: &mut Ctx<Comp>) {
    // (not a function whose body had a syntax error, but in
    // check_unchecked, or whose declaration failed)
    let p = pcx.nodes[item as usize].p;
    // (0.19: nor a declaration of std::arch's, which has no body)
    if (p & FN_SIG_FAILED) != 0 || ((p & FN_BODY_FAILED) != 0 && !pcx.check_unchecked)
        || ((p & FN_INTRINSIC) != 0 && (pcx.nodes[item as usize].c) == 0) {
        return;
    }
    // RULE: D21.2 (an `impl Tr` result's function is checked once, maybe
    // early: check_nested)
    if (p & FN_OPAQUE_DONE) != 0 {
        return;
    }
    // RULE: D22.2 (an Ω instance of std's, an opaque instance's check made
    // it: type-checked only; std's bodies are borrow-checked as std's)
    let fi = pcx.nodes[item as usize].x - 1;
    if crate::front::opaque::omega_instance(fi, pcx)
        && !crate::front::conv::user_at(
            pcx.nodes[pcx.fns[(pcx.fns[fi as usize].tmpl - 1) as usize].node as usize].start, pcx) {
        pcx.fns[fi as usize].attrs |= crate::front::ast::FN_QUERY_ONLY;
    }
    let depth = pcx.recover_depth;
    let state = save_check_state(pcx);
    let infer_state = crate::front::check::infer::save(pcx);
    let errors = error_count(pcx);
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        check_function(item, pcx);
    } else {
        restore_check_state(state, pcx);
        crate::front::check::infer::restore(infer_state, pcx);
        // RULE: D22.2 (an opaque instance left out without an error: not
        // borrow-checked either)
        if crate::front::opaque::omega_instance(pcx.nodes[item as usize].x - 1, pcx) {
            pcx.nodes[item as usize].p |= FN_BODY_FAILED;
        }
    }
    let f = pcx.nodes[item as usize].x - 1;
    if crate::front::opaque::has_opaque_result(f, pcx) {
        crate::front::opaque::body_end(f, pcx);
        pcx.nodes[item as usize].p |= FN_OPAQUE_DONE;
    }
    // (0.16: its effects are unknown)
    if error_count(pcx) != errors {
        note_body_failed(pcx.nodes[item as usize].x - 1, pcx);
    }
    recover_leave(depth, pcx);
}

// (0.27.2.1, D21.3) Function item checked inside another's check, for its
// `impl Tr` result's hidden type (front/opaque.vl: hidden): what the
// enclosing check keeps per function is saved around it and restored.
pub fn check_nested(item: i64, pcx: &mut Ctx<Comp>) {
    let mut keep: Vec<i64, Comp> = Vec::new_in(Comp {});
    keep_list(&pcx.env, &mut keep);
    keep_list(&pcx.check_scopes, &mut keep);
    keep_list(&pcx.loop_stack, &mut keep);
    keep_list(&pcx.const_ptrs, &mut keep);
    keep_list(&pcx.closure_stack, &mut keep);
    keep_list(&pcx.inout_pending, &mut keep);
    keep_list(&pcx.raw_addrs, &mut keep);
    keep_list(&pcx.let_amps, &mut keep);
    let state = save_check_state(pcx);
    let hint_node = pcx.hint_node;
    let hint_ty = pcx.hint_ty;
    pcx.closure_stack.clear();
    check_function_recovering(item, pcx);
    restore_check_state(state, pcx);
    pcx.hint_node = hint_node;
    pcx.hint_ty = hint_ty;
    restore_list(&mut pcx.let_amps, &mut keep);
    restore_list(&mut pcx.raw_addrs, &mut keep);
    restore_list(&mut pcx.inout_pending, &mut keep);
    restore_list(&mut pcx.closure_stack, &mut keep);
    restore_list(&mut pcx.const_ptrs, &mut keep);
    restore_list(&mut pcx.loop_stack, &mut keep);
    restore_list(&mut pcx.check_scopes, &mut keep);
    restore_list(&mut pcx.env, &mut keep);
}

// RULE: D22.1, D22.2 (0.27.2.1) Template f's (its item `item`) opaque
// instance, each type parameter an Ω (front/opaque.vl), or -1: a failure
// to make it (a bound Ω does not meet) leaves it out.
pub fn opaque_instance(f: i64, item: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let depth = pcx.recover_depth;
    let state = save_check_state(pcx);
    let mut made: i64 = -1;
    // UNSAFE: the checker's error recovery is setjmp/longjmp (err_jump), a
    // C call: an error in making the instance returns here.
    // SAFETY: recover_enter gives the jmp_buf of this frame's depth, live
    // until recover_leave below; the state a jump leaves is restored.
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        let g = pcx.nodes[item as usize].g;
        let mut omegas = Vec::<i64, Comp>::new_in(Comp {});
        for k in 0..pcx.nodes[g as usize].count {
            omegas.push(crate::front::opaque::omega_of(child(g, k, pcx), pcx));
        }
        let m = pcx.tscratch.len() as i64;
        for &t in omegas.as_slice() {
            pcx.tscratch.push(t);
        }
        made = fn_instance(f, m, item, pcx);
    } else {
        restore_check_state(state, pcx);
    }
    recover_leave(depth, pcx);
    made
}

fn keep_list(v: &Vec<i64, Comp>, keep: &mut Vec<i64, Comp>) {
    for i in 0..v.len() {
        keep.push(v[i]);
    }
    keep.push(v.len() as i64);
}

fn restore_list(v: &mut Vec<i64, Comp>, keep: &mut Vec<i64, Comp>) {
    let n = keep.pop().unwrap() as usize;
    let base = keep.len() - n;
    v.clear();
    for i in base..keep.len() {
        v.push(keep[i]);
    }
    keep.truncate(base);
}

// (0.26.1) The instances queued from INST_QUEUE[from] on checked, as
// check_program checks them (and those they make): for the places IR's
// drop shims, which make the `Drop::drop` instances they call
// (places/shim.vl: drop_fn).
pub fn check_queued_instances(from: i64, pcx: &mut Ctx<Comp>) {
    let mut q = from;
    while q < pcx.inst_queue.len() as i64 {
        let item = pcx.fns[pcx.inst_queue[q as usize] as usize].node;
        check_function_recovering(item, pcx);
        q += 1;
    }
}

// For a query (0.13): what no compilation checks, checked as far as it
// goes for its references, and what it finds wrong forgotten: a function
// whose body has a syntax error (what was parsed of it), and a generic
// function never instantiated (an instance whose type arguments are the
// error type). The instances made for them are not the program's.
fn check_unchecked(program: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mark = errors_mark(pcx);
        let queued = pcx.inst_queue.len() as i64;
        let closures = pcx.closure_fns.len() as i64;
        pcx.check_unchecked = true;
        // (0.27.2: what it finds wrong is forgotten, so no limit stops the
        // run inside it: std2 has templates whose error-typed instances do
        // not check, and the 50th error exited with them all, at a query or
        // a check that keeps the cache, before the program's own were read)
        let max_errors = pcx.max_errors;
        pcx.max_errors = 9223372036854775807;
        let fns = pcx.fns.len() as i64;
        // (0.25) The templates with an instance, marked in one pass: each
        // generic function looked through every function for one.
        let instantiated = alloc_zeroed(fns);
        for g in 0..fns {
            let t = pcx.fns[g as usize].tmpl - 1;
            if t >= 0 && t < fns {
                (*instantiated.add(t as usize)) = 1;
            }
        }
        for i in 0..pcx.nodes[program as usize].count {
            let item = child(program, i, pcx);
            if pcx.nodes[item as usize].kind != Fn || pcx.nodes[item as usize].x == 0
                || (pcx.nodes[item as usize].p & FN_SIG_FAILED) != 0 {
                continue;
            }
            let f = pcx.nodes[item as usize].x - 1;
            if pcx.fns[f as usize].generic == 0 {
                // (0.14: a lazy default no one uses, for its references)
                if (pcx.nodes[item as usize].p & FN_LAZY) != 0 {
                    ensure_checked(f, item, pcx);
                }
                if (pcx.nodes[item as usize].p & FN_BODY_FAILED) != 0 {
                    check_function_recovering(item, pcx);
                }
                continue;
            }
            if pcx.fns[f as usize].tmpl != 0 {
                continue;
            }
            if f < fns && (*instantiated.add(f as usize)) != 0 {
                continue;
            }
            let depth = pcx.recover_depth;
            let state = save_check_state(pcx);
            if _setjmp(recover_enter(pcx)) == 0 {
                let m = pcx.tscratch.len() as i64;
                for _ in 0..pcx.fns[f as usize].generic {
                    pcx.tscratch.push(pcx.ty_error);
                }
                fn_instance(f, m, item, pcx);
            } else {
                restore_check_state(state, pcx);
            }
            recover_leave(depth, pcx);
        }
        free(instantiated);
        let mut q = queued;
        while q < pcx.inst_queue.len() as i64 {
            check_function_recovering(pcx.fns[(pcx.inst_queue[q as usize]) as usize].node,
                pcx);
            q += 1;
        }
        pcx.check_unchecked = false;
        pcx.max_errors = max_errors;
        // (0.27.2: what it checked is not the program's: on std2, its
        // functions are not built, and their borrowck errors, std2's own
        // bugs, not shown; std2's root check and --std2-check show them)
        if crate::front::known::on_std2(pcx) {
            for f in fns..pcx.fns.len() as i64 {
                pcx.fns[f as usize].attrs |= crate::front::ast::FN_QUERY_ONLY;
            }
            for k in queued..pcx.inst_queue.len() as i64 {
                let f = (pcx.inst_queue[k as usize]);
                pcx.fns[f as usize].attrs |= crate::front::ast::FN_QUERY_ONLY;
            }
        }
        pcx.inst_queue.truncate(queued as usize);
        pcx.closure_fns.truncate(closures as usize);
        errors_forget(mark, pcx);
    }
}

// (0.17) With std read from its files to be edited (front/stdtree.vl):
// std's generic functions that nothing instantiated, each instantiated
// once, i64 for its type parameters (Gpa where i64 does not satisfy the
// bounds: an `Allocator`), so that an edit's errors in their bodies are
// found. One whose bounds neither satisfies (an `Fn`, an `Iterator`) is
// checked only where a program uses it, and so is a trait's default method
// copied into an impl (lazy: `sum` of an iterator of pairs). Its errors are kept: the edit's
// check reports those it added.
fn check_std_generics(program: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let gpa = crate::front::effects::infer::std_struct_type(c"Gpa", pcx);
        let fns = pcx.fns.len() as i64;
        for i in 0..pcx.nodes[program as usize].count {
            let item = child(program, i, pcx);
            if pcx.nodes[item as usize].kind != Fn || pcx.nodes[item as usize].x == 0
                || (pcx.nodes[item as usize].p & (FN_SIG_FAILED | FN_LAZY | FN_DEFAULT_COPY)) != 0
                || !within_std(module_of(item, pcx), pcx) {
                continue;
            }
            let f = pcx.nodes[item as usize].x - 1;
            if pcx.fns[f as usize].generic == 0 || pcx.fns[f as usize].tmpl != 0
                || (0i64..fns).any(|g| pcx.fns[g as usize].tmpl == f + 1) {
                continue;
            }
            let params = pcx.nodes[item as usize].g;
            let m = pcx.tscratch.len() as i64;
            for k in 0..pcx.fns[f as usize].generic {
                let t = simple_targ(child(params, k, pcx), gpa, pcx);
                if t == 0 {
                    break;
                }
                pcx.tscratch.push(t);
            }
            if pcx.tscratch.len() as i64 - m != pcx.fns[f as usize].generic {
                pcx.tscratch.truncate(m as usize);
                continue;
            }
            let depth = pcx.recover_depth;
            let state = save_check_state(pcx);
            if _setjmp(recover_enter(pcx)) == 0 {
                fn_instance(f, m, item, pcx);
            } else {
                restore_check_state(state, pcx);
            }
            recover_leave(depth, pcx);
        }
    }
}

// A type for type parameter p (check_std_generics): i64, or gpa, the one
// that satisfies its bounds; 0 when neither does or a bound is not a
// plain trait.
fn simple_targ(p: i64, gpa: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let bounds = pcx.nodes[p as usize].h;
    if bounds == 0 {
        return TY_I64;
    }
    for c in 0..2 {
        let t = if c == 0 { TY_I64 } else { gpa };
        if t == 0 {
            continue;
        }
        let mut ok = true;
        for i in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, i, pcx);
            if pcx.nodes[b as usize].kind == crate::front::ast::NodeKind::EffectSet {
                continue;
            }
            if pcx.nodes[b as usize].kind == crate::front::ast::NodeKind::TyFn
                || pcx.nodes[b as usize].h != 0
                || pcx.nodes[b as usize].g != 0 {
                return 0;
            }
            if !implements(bound_trait(b, pcx), t, pcx) {
                ok = false;
                break;
            }
        }
        if ok {
            return t;
        }
    }
    0
}

// What the checker must put back after an error (see err_end): its
// scopes, stacks and context.
#[derive(Clone, Copy)] struct CheckState {
    env: i64, scopes: i64, loops: i64, module: i64, self_ty: i64, self_impl: i64, tp_base: i64,
    tp_count: i64,
    inst: i64, ret: i64, tscratch: i64, scratch: i64, const_context: bool, env_floor: i64,
    unsafe_depth: i64, wrap: i64, loop_base: i64, cur_fn: i64, closures: i64,
}

fn save_check_state(pcx: &Ctx<Comp>) -> CheckState {
    CheckState {
        env: pcx.env.len() as i64, scopes: pcx.check_scopes.len() as i64,
        loops: pcx.loop_stack.len() as i64,
        module: pcx.cur_mod,
        self_ty: pcx.self_type, self_impl: pcx.self_impl, tp_base: pcx.tp_base,
        tp_count: pcx.tp_names.len() as i64,
        inst: pcx.cur_inst,
        ret: pcx.return_type, tscratch: pcx.tscratch.len() as i64,
        scratch: pcx.scratch.len() as i64,
        const_context: pcx.const_context, env_floor: pcx.env_floor,
        unsafe_depth: pcx.unsafe_depth,
        wrap: pcx.wrap_node, loop_base: pcx.loop_base, cur_fn: pcx.cur_fn,
        closures: pcx.closure_stack.len() as i64,
    }
}

fn restore_check_state(s: CheckState, pcx: &mut Ctx<Comp>) {
    cut_back(&mut pcx.env, s.env);
    cut_back(&mut pcx.check_scopes, s.scopes);
    cut_back(&mut pcx.loop_stack, s.loops);
    pcx.cur_mod = s.module;
    pcx.self_type = s.self_ty;
    pcx.self_impl = s.self_impl;
    pcx.tp_base = s.tp_base;
    cut_back(&mut pcx.tp_names, s.tp_count);
    cut_back(&mut pcx.tp_types, s.tp_count);
    pcx.cur_inst = s.inst;
    pcx.return_type = s.ret;
    cut_back(&mut pcx.tscratch, s.tscratch);
    cut_back(&mut pcx.scratch, s.scratch);
    pcx.const_context = s.const_context;
    pcx.env_floor = s.env_floor;
    pcx.unsafe_depth = s.unsafe_depth;
    pcx.wrap_node = s.wrap;
    pcx.loop_base = s.loop_base;
    pcx.cur_fn = s.cur_fn;
    cut_back(&mut pcx.closure_stack, s.closures);
    pcx.or_mode = false;
    pcx.self_bound_pos = -1;
    pcx.unify_self = 0;
    pcx.unify_self_ty = 0;
}

// (0.29) Stack v cut back to the n items it had when the state was saved.
// A check that began anew since (check_function clears the function's
// stacks; a jump out of it leaves them as they were at the error) may
// have left fewer: those stay. The items above them at the save are not
// brought back: they were the function's before, which nothing reads
// again (check_nested keeps the lists it needs, by value).
fn cut_back(v: &mut Vec<i64, Comp>, n: i64) {
    if n < v.len() as i64 {
        v.truncate(n as usize);
    }
}

// ---- Recovery (0.10) ----
//
// The declarations recover from errors item by item, and the parts of an
// item one by one (a field's, a parameter's type...): what failed becomes
// the error type (an unresolvable type) or is left out (a duplicate), and
// the errors that would follow from it are not reported. The function
// bodies recover statement by statement (see check_block); a function
// whose body had a syntax error, or whose declaration failed, is not
// checked.

// What `attempt` does.
#[derive(Clone, Copy, PartialEq, Eq)] pub enum Try {
    Name, Type, Method, Static, Const, Use, Impl, Bound, Discr, StaticCall,
}

// Does `what` for `arg` with a recovery point: whether it went through
// (an error was recorded otherwise, and the checker's state is as it was).
pub fn attempt(what: Try, arg: i64, pcx: &mut Ctx<Comp>) -> bool {
    let depth = pcx.recover_depth;
    let state = save_check_state(pcx);
    let mut ok = true;
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        match what {
            Try::Name => collect_name(arg, pcx),
            Try::Type => pcx.try_result = resolve_type(arg, pcx),
            Try::Method => collect_method(arg, pcx),
            Try::Static => check_static(arg, pcx),
            Try::Const => const_value_of(arg, pcx),
            Try::Use => resolve_use_of(arg, pcx),
            Try::Impl => collect_impl(arg, pcx),
            Try::Bound => pcx.try_result = trait_named(arg, pcx),
            Try::Discr => pcx.try_result = eval_discriminant(arg, pcx),
            Try::StaticCall => static_call_value(arg, pcx),
        }
    } else {
        restore_check_state(state, pcx);
        ok = false;
    }
    recover_leave(depth, pcx);
    ok
}

// Checks e as check_wrapped does, with a recovery point (0.14): after an
// error in it, the error type, so that what depends on it (an if's
// branches, a loop's body, a match's arms) is checked too, its errors
// reported in the same pass.
pub fn check_recovering(e: i64, expected: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let depth = pcx.recover_depth;
    let state = save_check_state(pcx);
    let mut ty = pcx.ty_error;
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        ty = check_wrapped(e, expected, pcx);
    } else {
        restore_check_state(state, pcx);
    }
    recover_leave(depth, pcx);
    ty
}

// The type node n names; the error type (an error recorded) when it
// names none.
pub fn resolve_type_or_error(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if attempt(Try::Type, n, pcx) { pcx.try_result } else { pcx.ty_error }
}

// Whether type t is or holds the error type (a type that failed).
pub fn has_error_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if t == pcx.ty_error {
            return true;
        }
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Ptr || kind == TyKind::Slice || kind == TyKind::Array {
            return has_error_type(pcx.types[t as usize].a, pcx);
        }
        if kind == TyKind::Distinct && has_error_type(pcx.types[t as usize].a, pcx) {
            return true;
        }
        if kind == TyKind::Fn && has_error_type(pcx.types[t as usize].a, pcx) {
            return true;
        }
        // (0.14: `Option<{error}>`, from an associated type an impl lacks)
        if kind == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].tmpl != 0 {
            let s = pcx.types[t as usize].a;
            for i in 0..pcx.structs[s as usize].targ_count {
                if has_error_type(
                    (pcx.tlists[(pcx.structs[s as usize].targs + i) as usize]), pcx) {
                    return true;
                }
            }
        }
        if kind == TyKind::Enum && (*get_enums().add(pcx.types[t as usize].a as usize)).tmpl != 0 {
            let e = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(e as usize)).targ_count {
                if has_error_type(
                    (pcx.tlists[((*get_enums().add(e as usize)).targs + i) as usize]),
                    pcx) {
                    return true;
                }
            }
        }
        if kind == TyKind::Tuple || kind == TyKind::Fn || kind == TyKind::Distinct {
            for i in 0..pcx.types[t as usize].count {
                if has_error_type(type_elem(t, i, pcx), pcx) {
                    return true;
                }
            }
        }
        false
    }
}

// After an error in statement `stmt`: the names its `let` binds stand for
// values of the error type, so that their uses report nothing more.
fn poison_statement(stmt: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[stmt as usize].kind == Let {
        poison_pattern(pcx.nodes[stmt as usize].a, pcx);
    }
}

pub fn poison_pattern(p: i64, pcx: &mut Ctx<Comp>) {
    if p == 0 {
        return;
    }
    if pcx.nodes[p as usize].kind == PatBind {
        pcx.nodes[p as usize].x = define_local(pcx.nodes[p as usize].a, pcx.ty_error, true, false,
            pcx);
        return;
    }
    if pcx.nodes[p as usize].kind == NodeKind::FieldInit {
        // (0.17) a field of `E::V { a, b: q }`: its pattern
        poison_pattern(pcx.nodes[p as usize].b, pcx);
        return;
    }
    for i in 0..pcx.nodes[p as usize].count {
        poison_pattern(child(p, i, pcx), pcx);
    }
}

// The program's list, for the code generators: its items without the
// generic templates (0.14: and the lazy defaults never used), then the
// instances of generic functions, then the closures' functions.
fn finish_program(program: i64, pcx: &mut Ctx<Comp>) {
    let mark = list_begin(pcx);
    for i in 0..pcx.nodes[program as usize].count {
        let item = child(program, i, pcx);
        let kind = pcx.nodes[item as usize].kind;
        if (kind == Fn || kind == Struct || kind == Enum) && pcx.nodes[item as usize].g != 0 {
            continue;
        }
        // (0.14: a lazy default never used)
        if kind == Fn && (pcx.nodes[item as usize].p & FN_LAZY) != 0 {
            continue;
        }
        // (0.19: std::arch's declarations without a body)
        if kind == Fn && (pcx.nodes[item as usize].p & FN_INTRINSIC) != 0
            && pcx.nodes[item as usize].c == 0 {
            continue;
        }
        list_push(item, pcx);
    }
    // RULE: D22.2 (not the opaque instances, nor those of their checks
    // with an Ω)
    for q in 0..pcx.inst_queue.len() as i64 {
        if crate::front::opaque::omega_instance((pcx.inst_queue[q as usize]), pcx) {
            continue;
        }
        list_push(pcx.fns[(pcx.inst_queue[q as usize]) as usize].node, pcx);
    }
    // (0.14: then the closures' functions)
    for i in 0..pcx.closure_fns.len() as i64 {
        list_push((pcx.closure_fns[i as usize]), pcx);
    }
    list_end(program, mark, pcx);
}
