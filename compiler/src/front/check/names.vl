// Names in expressions: what an identifier names (a local, a constant, a
// static, a function as a value, a variant), the scope lookups patterns
// share, and the unknown-name error with its suggestions (a near name in
// scope, or the `use` that would bring it).

use crate::base::{
    buf_byte, buf_bytes, buf_len, buf_new, buf_slice, buf_str, buf_truncate, get_src, intern,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    edit_distance, err_begin, err_end, err_failed_name, err_fix, err_fix_word, err_fixable,
    err_help, err_help_fmt, err_help_sym, err_pos, err_str, err_sym, err_try, err_try_fmt,
};
use crate::front::assoc::ensure_checked;
use crate::front::ast::{CONV_NEW, FN_UNSAFE, NodeKind, new_node};
use crate::front::ast::NodeKind::{CStr, Path, Str};
use crate::front::check::{Res, lookup_local, name_error};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::unsafe_op;
use crate::front::cimport::c_import_skip_reason;
use crate::front::closures::note_local_use;
use crate::front::distinct::is_view_distinct;
use crate::front::generics::{TPL_NONE, env_lookup, instance_of, targ_count_error, template_of_key};
use crate::front::generics::instantiate::{fn_instance, push_written_targs};
use crate::front::lexer::Tok;
use crate::front::modules::{item_key_if_known, module_count, within_std};
use crate::front::modules::lookup::{
    B_ITEM, B_MODULE, B_PRIVATE, B_TVARIANT, B_VARIANT, access_error, binding, binding_kind,
    binding_value, help_std_path, is_prelude_name, lookup_item, lookup_name, lookup_quiet,
    note_c_use,
};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::stdsrc_rust::std2_source;
use crate::front::threadlocal::note_static_use;
use crate::front::types::{
    TyKind, buf_type, enum_type, err_type, fn_param, is_pointer, item_node_of, make_type,
};
use crate::tools::fix::note_missing_use;

pub fn synth_name(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let name = pcx.nodes[n as usize].a;
    let resolved = (pcx.nodes[n as usize].p & NODE_RESOLVED) != 0;
    if !resolved {
        match lookup_local(name, pcx) {
            Option::Some(local) => {
                if pcx.nodes[n as usize].g != 0 {
                    name_error(pcx.nodes[n as usize].start, c"'", name,
                        c"' is a variable, not a generic function", pcx);
                }
                pcx.nodes[n as usize].res = Res::Local;
                pcx.nodes[n as usize].y = local;
                note_local_use(n, local, pcx);
                // RULE: F18.5 (a use of an open local)
                if pcx.open_lets.len() as i64 > 0 {
                    crate::front::check::literals::open_use(n, local, pcx);
                }
                if pcx.locals[local as usize].access
                    && (pcx.nodes[n as usize].p & CONV_NEW) == 0 {
                    // (0.20) an access is used as the value it designates:
                    // `x` is `*x` (`&x`: `&*x`, a reborrow), conventions.md D12
                    return access_use(n, pcx);
                }
                return pcx.locals[local as usize].ty;
            }
            Option::None => {}
        }
    }
    // RULE: F15.3 (the rust edition: an `#[array_builtin(N)]` item's N is
    // the instance's length, a `usize` constant)
    if !resolved {
        let len = crate::front::generics::instantiate::length_of(
            crate::front::generics::env_lookup(name, pcx), pcx);
        if len >= 0 {
            pcx.nodes[n as usize].kind = NodeKind::Int;
            pcx.nodes[n as usize].a = len;
            pcx.nodes[n as usize].b = crate::front::lexer::SUF_USIZE;
            return crate::front::check::synth_mode::synth_expr(n, pcx);
        }
    }
    // RULE: F5.4 (the rust edition: `Self` of a unit struct is its value)
    if !resolved && name == pcx.self_type_sym
        && crate::front::check::rust::unit_struct_value(n, crate::front::check::rust::SELF_KEY,
            pcx) {
        return crate::front::check::synth_mode::synth_expr(n, pcx);
    }
    let b = if resolved { binding(B_ITEM, name) }
        else { lookup_item(pcx.cur_mod, name, pcx.cur_mod, pcx) };
    if !resolved {
        note_c_use(pcx.nodes[n as usize].start, name, b, pcx);
    }
    let kind = binding_kind(b);
    if kind == B_PRIVATE {
        access_error(b, pcx.nodes[n as usize].start, name, pcx);
    }
    if kind == B_VARIANT {
        // A variant brought into scope by `use E::...;`: `E::V`.
        let v = binding_value(b);
        pcx.nodes[n as usize].kind = Path;
        pcx.nodes[n as usize].a = pcx.variants[v as usize].name;
        pcx.nodes[n as usize].b = pcx.variants[v as usize].name;
        pcx.nodes[n as usize].y = enum_type(pcx.variants[v as usize].enum_id, pcx);
        return synth_expr(n, pcx);
    }
    if kind == B_TVARIANT {
        // A variant of a generic enum (0.6): its type arguments inferred
        // (`y` < 0: the template; see path_target).
        pcx.nodes[n as usize].kind = Path;
        pcx.nodes[n as usize].b = name;
        pcx.nodes[n as usize].y = -binding_value(b) - 1;
        return synth_expr(n, pcx);
    }
    if kind == B_MODULE {
        name_error(pcx.nodes[n as usize].start, c"'", name, c"' is a module, not a value", pcx);
    }
    if kind != B_ITEM {
        // (0.26.3: `format(x)`: `format_in(x, gpa)`)
        if !pcx.check_unchecked && binding_kind(lookup_item(pcx.cur_mod,
            crate::front::check::alloc_rules::in_name(name, pcx), pcx.cur_mod,
            pcx)) == B_ITEM {
            crate::front::check::alloc_rules::no_in_error(n, name, sym_text(name, pcx), pcx);
        }
        if pcx.check_unchecked {
            // (a binding of what was not parsed: the rest goes on)
            return pcx.ty_error;
        }
        unknown_name_error(pcx.nodes[n as usize].start, c"undefined variable '", name, pcx);
    }
    let key = binding_value(b);
    if (pcx.sym_const[key as usize]) != 0 {
        let c = (pcx.sym_const[key as usize]) - 1;
        let init = pcx.nodes[pcx.consts[c as usize].node as usize].c;
        if pcx.nodes[init as usize].kind == CStr && is_pointer(pcx.consts[c as usize].ty, pcx) {
            // A C string constant: the literal itself.
            pcx.nodes[n as usize].kind = CStr;
            pcx.nodes[n as usize].a = pcx.nodes[init as usize].a;
            return pcx.consts[c as usize].ty;
        }
        if pcx.nodes[init as usize].kind == Str
            && (pcx.consts[c as usize].ty == pcx.ty_string
                || is_view_distinct(pcx.consts[c as usize].ty, pcx)) {
            // A string constant (0.14; a `str` one, 0.25.4): the literal
            // itself. (A `str` constant read as a `Res::Const` was lowered
            // as an integer, `ir_const(0)`: a null slice, a crash.)
            pcx.nodes[n as usize].kind = Str;
            pcx.nodes[n as usize].a = pcx.nodes[init as usize].a;
            pcx.nodes[n as usize].b = pcx.nodes[init as usize].b;
            return pcx.consts[c as usize].ty;
        }
        // RULE: F34.2 (a constant made at each use)
        if pcx.consts[c as usize].state >= 3 {
            return inline_const(n, c, pcx);
        }
        pcx.nodes[n as usize].res = Res::Const;
        pcx.nodes[n as usize].y = c;
        return pcx.consts[pcx.nodes[n as usize].y as usize].ty;
    }
    if (pcx.sym_static[key as usize]) != 0 {
        pcx.nodes[n as usize].res = Res::Static;
        pcx.nodes[n as usize].y = (pcx.sym_static[key as usize]) - 1;
        // The code generators find statics by their symbol.
        pcx.nodes[n as usize].a = pcx.nodes[
            pcx.statics[pcx.nodes[n as usize].y as usize].node as usize].a;
        // (0.21: a thread-local brings std's __tls_addr)
        note_static_use(pcx.nodes[n as usize].y, n, pcx);
        // RULE: F19.6 (0.27.3: a `static mut`, read or written, is
        // unsafe in the rust edition, rustc E0133)
        if pcx.statics[pcx.nodes[n as usize].y as usize].mutable {
            crate::front::check::unsafety::unsafe_op(n,
                crate::front::check::unsafety::U_STATIC_MUT,
                c"use of a mutable static is unsafe (rustc E0133)", pcx);
        }
        return pcx.statics[pcx.nodes[n as usize].y as usize].ty;
    }
    if (pcx.sym_fn[key as usize]) != 0 {
        let mut f = (pcx.sym_fn[key as usize]) - 1;
        if pcx.fns[f as usize].variadic {
            name_error(pcx.nodes[n as usize].start, c"variadic function '", name,
                c"' cannot be used as a value", pcx);
        }
        if pcx.fns[f as usize].generic > 0 {
            // `max::<i64>` as a value: the arguments must be written.
            if pcx.nodes[n as usize].g == 0 {
                name_error(pcx.nodes[n as usize].start, c"generic function '", name,
                    c"' needs its type arguments to be used as a value ('f::<T>')", pcx);
            }
            if pcx.nodes[pcx.nodes[n as usize].g as usize].count
                != pcx.fns[f as usize].generic {
                targ_count_error(pcx.nodes[n as usize].start, c"function",
                    pcx.fns[f as usize].display, pcx.fns[f as usize].generic,
                    pcx.nodes[pcx.nodes[n as usize].g as usize].count, pcx);
            }
            let mark = pcx.tscratch.len() as i64;
            push_written_targs(pcx.nodes[n as usize].g, pcx);
            f = fn_instance(f, mark, n, pcx);
        } else if pcx.nodes[n as usize].g != 0 {
            name_error(pcx.nodes[n as usize].start, c"function '", name, c"' is not generic",
                pcx);
        }
        pcx.nodes[n as usize].res = Res::Fn;
        pcx.nodes[n as usize].y = f;
        ensure_checked(f, n, pcx);
        // (RULE: F19.3: in the rust edition the value's type is an
        // `unsafe fn` type, whose calls need `unsafe`)
        return fn_value_type(f, n, pcx);
    }
    // RULE: F7.3 (the rust edition: a unit struct is a value)
    if (pcx.sym_struct[key as usize]) != 0
        && crate::front::check::rust::unit_struct_value(n, key, pcx) {
        return crate::front::check::synth_mode::synth_expr(n, pcx);
    }
    if (pcx.sym_struct[key as usize]) != 0 || (pcx.sym_enum[key as usize]) != 0
        || (pcx.sym_alias[key as usize]) != 0 {
        name_error(pcx.nodes[n as usize].start, c"'", name, c"' is a type, not a value", pcx);
    }
    unknown_name_error(pcx.nodes[n as usize].start, c"undefined variable '", name, pcx)
}

// RULE: F34.2 Ident n names constant c, made at each use (a rust-edition
// constant of another type, or whose value calls a function): n becomes a
// copy of its value expression checked against its type in the
// constant's module, as an inherent constant's (assoc.vl:
// inherent_const_value), so each use is a fresh value; its type.
fn inline_const(n: i64, c: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let item = pcx.consts[c as usize].node;
    if pcx.consts[c as usize].state == 4 {
        name_error(pcx.nodes[item as usize].start, c"constant '", pcx.nodes[item as usize].a,
            c"' is defined in terms of itself", pcx);
    }
    let ty = pcx.consts[c as usize].ty;
    let saved_mod = pcx.cur_mod;
    pcx.cur_mod = crate::front::modules::module_of(item, pcx);
    pcx.consts[c as usize].state = 4;
    // (resolved as at the constant: none of the use's locals, nor its
    // type parameters)
    let saved_floor = pcx.env_floor;
    pcx.env_floor = pcx.env.len() as i64;
    let saved_env = crate::front::generics::env_enter(0, 0, 0, pcx);
    let e = crate::front::generics::instantiate::clone_node(pcx.nodes[item as usize].c, pcx);
    crate::front::check::check_mode::check_expr(e, ty, pcx);
    crate::front::generics::env_leave(saved_env, pcx);
    pcx.env_floor = saved_floor;
    pcx.consts[c as usize].state = 3;
    pcx.cur_mod = saved_mod;
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    pcx.nodes[n as usize] = pcx.nodes[0];
    pcx.nodes[n as usize].kind = NodeKind::Block;
    pcx.nodes[n as usize].start = start;
    pcx.nodes[n as usize].end = end;
    pcx.nodes[n as usize].a = e;
    pcx.nodes[n as usize].ty = ty;
    ty
}

// (0.20) Ident n, a use of an access local (front/check: Local.access),
// becomes `*n`: the place it designates. (The Ident inside is flagged
// CONV_NEW, so that it is the reference.)
fn access_use(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let inner = new_node(NodeKind::Ident, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    pcx.nodes[inner as usize] = pcx.nodes[n as usize];
    pcx.nodes[inner as usize].p |= CONV_NEW;
    pcx.nodes[n as usize].kind = NodeKind::Unary;
    pcx.nodes[n as usize].op = Tok::Star;
    pcx.nodes[n as usize].a = 0;
    pcx.nodes[n as usize].b = inner;
    pcx.nodes[n as usize].count = 0;
    pcx.nodes[n as usize].list = 0;
    pcx.nodes[n as usize].p = pcx.nodes[n as usize].p & NODE_RESOLVED;
    synth_expr(n, pcx)
}

// An Ident whose `a` is already a key (a path resolved to an item).
pub const NODE_RESOLVED: i64 = 2;

// The enum type of the variant `name` in scope, in a pattern (p) against
// a value of type `ty`, or 0 when `name` is no variant: a generic enum's
// variant (0.6) takes the instance `ty`.
pub fn used_variant_enum(name: i64, ty: i64, p: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let b = lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, pcx);
        if binding_kind(b) == B_VARIANT {
            return enum_type(pcx.variants[binding_value(b) as usize].enum_id, pcx);
        }
        if binding_kind(b) != B_TVARIANT {
            return 0;
        }
        let e = binding_value(b);
        if !instance_of(ty, -e - 1, pcx) {
            err_begin(pcx.nodes[p as usize].start, pcx);
            err_str(c"expected '", pcx);
            err_type(ty, pcx);
            err_str(c"', got a pattern of '", pcx);
            err_sym((pcx.enums[e as usize]).name, pcx);
            err_str(c"'", pcx);
            pattern_enum_help(ty, sym_text((pcx.enums[e as usize]).name, pcx), pcx);
            err_end(pcx);
        }
        ty
    }
}

// (0.25.2.2, eval 0.25.2.1: windtunnel) The help of a pattern of Option
// against a Result (`match parse_int(s) { Some(n) => .. }`), or of Result
// against an Option: the patterns of the value's own enum.
pub fn pattern_enum_help(ty: i64, pat: &[u8], pcx: &Ctx<Comp>) {
    let b = buf_new();
    buf_type(b, ty, pcx);
    let v = buf_slice(b);
    if v.len() > 7 && v[0..7] == b"Result<" && pat == b"Option" {
        err_help(
            c"the value is a Result: its patterns are `Ok(x)` and `Err(e)`; `.ok()` makes it an Option (`match r.ok() { Some(x) => ..., None => ... }`), `.unwrap_or(d)` gives the value or d", pcx);
    } else if v.len() > 7 && v[0..7] == b"Option<" && pat == b"Result" {
        err_help(
            c"the value is an Option: its patterns are `Some(x)` and `None`; `.ok_or(e)` makes it a Result", pcx);
    }
}

// Whether `name` is a constant in the current scope (its index + 1, or 0).
pub fn scope_const(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, pcx);
    if binding_kind(b) == B_ITEM { (pcx.sym_const[binding_value(b) as usize]) }
    else { 0 }
}

// An unknown name; when a C header left it out, why.
pub fn unknown_name_error(pos: i64, before: *mut u8, name: i64, pcx: &mut Ctx<Comp>) -> ! {
    unsafe {
        if sym_text(name, pcx) == b"char" {
            // (0.27.0: Rust's `char`, the rust edition's from 0.27.2)
            crate::front::rust::later(pos, pos + 4, "char", "0.27.2", pcx);
            crate::base::diag::err_jump(pcx);
        }
        err_begin(pos, pcx);
        err_str(before, pcx);
        err_sym(name, pcx);
        err_str(c"'", pcx);
        err_failed_name(name, pcx);
        let reason = c_import_skip_reason(name, pcx);
        if reason != 0 as *mut u8 {
            err_help(c"'", pcx);
            err_help_sym(name, pcx);
            err_help(c"' was not imported from the C headers: ", pcx);
            err_help(reason, pcx);
        }
        else if (*before.add(0)) == b'u' && (*before.add(2)) == b'd'
            && sym_text(name, pcx) == b"gpa" {
            // (0.25.2.1: the allocator is a parameter, a test's too)
            let cur = pcx.cur_fn;
            crate::front::ambient::gpa_param_help(if cur >= 0 { pcx.fns[cur as usize].node }
                else { -1 },
                if cur >= 0 { sym_text(pcx.fns[cur as usize].display, pcx) } else { b"" }, pcx);
        }
        else if (*before.add(0)) == b'u' && (*before.add(1)) == b'n'
            && ((*before.add(2)) == b'd' || (*before.add(2)) == b'k') {
            // (`undefined variable '`, `unknown type '`, `unknown struct '`)
            suggest_name(name, (*before.add(2)) == b'd',
                pos == pcx.callee_pos || (*before.add(2)) == b'k', pcx);
        }
        err_end(pcx)
    }
}

// ---- Suggestions for unknown names (0.11) ----

// (0.25.2.1) The help for a function std has under another name, by what
// it does (`parse_i64` is the prelude's `parse_int`, not the nearest name,
// `parse_f64`), or "" when `name` is not one of those guesses.
pub fn std_synonym_help(name: &[u8]) -> &'static [u8] {
    if name == b"parse_i64" || name == b"parse_i32" || name == b"parse_isize"
        || name == b"parse_usize" || name == b"parse_u32" || name == b"parse_i16"
        || name == b"parse_u16" || name == b"parse_i8" || name == b"parse_u8"
        || name == b"parse_integer" || name == b"atoi" || name == b"atol"
        || name == b"strtol" {
        return b"std parses an integer with `parse`, a method of `str` (no `use`): `s.parse::<i64>()` is a Result<i64, ParseIntError>, and so for every integer type; a radix: `i64::from_str_radix(s, 16)`";
    }
    if name == b"parse_u64" || name == b"strtoul" || name == b"strtoull" {
        return b"std parses a u64 with `s.parse::<u64>()`, a Result<u64, ParseIntError>; a radix: `u64::from_str_radix(s, 16)`";
    }
    if name == b"parse_float" || name == b"atof" || name == b"strtod" {
        return b"std parses a float with `s.parse::<f64>()` (`f32` too), a Result<f64, ParseFloatError>";
    }
    b""
}

// (0.25.2.2, eval 0.25.2.1: cloth, sdftext, mandelbulb) The help of a path
// `std::a::NAME` whose module (`target`, std or one of its modules) has no
// NAME that the prelude or another module of std has: `std::num::parse_int`
// is the prelude's `parse_int` (not the nearest name there, `parse_f64`),
// and std has no global allocator (`std::heap_gpa`). `in_use`: the path is
// a `use` item's; seen from module `from`, std being `std_module`;
// `has_help`: the error has a help already. Whether there was a help.
pub fn help_std_elsewhere(target: i64, name: i64, in_use: bool, std_module: i64, from: i64,
    has_help: bool, pcx: &mut Ctx<Comp>) -> bool {
    if !within_std(target, pcx) || has_help {
        return false;
    }
    let t = sym_text(name, pcx);
    if is_prelude_name(name, pcx) {
        let w = buf_new();
        buf_bytes(w, t);
        if t.len() > 0 && t[0] >= b'a' && t[0] <= b'z' && t != b"str" {
            buf_str(w, c"(...)");
        }
        let written = buf_slice(w);
        if in_use {
            err_help_fmt(
                { let t = str::from_utf8(t).unwrap(); { let written = str::from_utf8(written).unwrap(); format_args("'{t}' is in the prelude: every module has it without a `use` or a path; delete this line and write `{written}`") } }, pcx);
        } else {
            err_help_fmt({
                let t = str::from_utf8(t).unwrap();
                { let written = str::from_utf8(written).unwrap();
                    format_args("'{t}' is in the prelude: write `{written}`, with no path") }
            },
                pcx);
        }
        err_try_fmt(str::from_utf8(written).unwrap(), pcx);
        return true;
    }
    if target != std_module && std_module >= 0
        && binding_kind(lookup_quiet(std_module, name, from, pcx)) == B_ITEM {
        err_help_fmt({
            let t = str::from_utf8(t).unwrap(); format_args("'{t}' is std's own item: `std::{t}`")
        }, pcx);
        if in_use {
            err_try_fmt({ let t = str::from_utf8(t).unwrap(); format_args("use std::{t};") }, pcx);
        } else {
            err_try_fmt({ let t = str::from_utf8(t).unwrap(); format_args("std::{t}") }, pcx);
        }
        return true;
    }
    let at0 = import_path_for(name, true, pcx);
    let at = if at0 != 0 { at0 } else { import_path_for(name, false, pcx) };
    if at != 0 {
        err_help_fmt({
            let t = str::from_utf8(t).unwrap();
            format_args("'{t}' is in {}", str::from_utf8(buf_slice(at)).unwrap())
        }, pcx);
        if in_use {
            err_try_fmt({
                let t = str::from_utf8(t).unwrap();
                format_args("use {}::{t};", str::from_utf8(buf_slice(at)).unwrap())
            }, pcx);
        } else {
            err_try_fmt({
                let t = str::from_utf8(t).unwrap();
                format_args("{}::{t}", str::from_utf8(buf_slice(at)).unwrap())
            }, pcx);
        }
        return true;
    }
    if has_part(t, b"gpa") || has_part(t, b"alloc") || has_part(t, b"heap") {
        err_help(
            c"std has no global allocator: main takes one, `fn main(gpa: Gpa)`, and passes it down as a parameter (a #[test] fn takes one too: `#[test] fn t(gpa: Gpa)`)", pcx);
        return true;
    }
    false
}

// Whether text t has `part` in it.
fn has_part(t: &[u8], part: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + part.len() as i64 <= t.len() as i64 {
        if &t[i as usize..(i + part.len() as i64) as usize] == part {
            return true;
        }
        i += 1;
    }
    false
}

// The help of an unknown name (a value, or a type): inside std, the
// variant the prelude would name (0.17); the item of that name
// another module has (`add `use crate::m::name;``), std's when std is not
// read (0.14), what replaces a Rust type, else the nearest name in scope or
// in std (`did you mean 'x'?`), what std reads input with, or where std's
// API is listed.
fn suggest_name(name: i64, value: bool, hint_std: bool, pcx: &mut Ctx<Comp>) {
    // (0.18.1: and `Reverse(x)`, a value, as a type)
    if (!value || sym_text(name, pcx) == b"Reverse") && rust_type_help(name, pcx) {
        return;
    }
    // (0.25.2.1: a function std has under another name)
    let syn = std_synonym_help(sym_text(name, pcx));
    if value && syn.len() > 0 {
        err_help_fmt(str::from_utf8(syn).unwrap(), pcx);
        return;
    }
    let mut path = import_path_for(name, value, pcx);
    if path == 0 && pcx.import_paths != 0 {
        // (0.25.3) several modules have it, none named in the file: each
        err_help(c"'", pcx);
        err_help_sym(name, pcx);
        err_help(c"' is in several modules: add ", pcx);
        buf_bytes(pcx.err_help, buf_slice(pcx.import_paths));
        return;
    }
    if path == 0 && pcx.std_module < 0 && std_has(name, value, pcx) {
        path = buf_new();
        buf_str(path, c"std");
    }
    if path != 0 {
        note_missing_use(pcx.cur_mod, intern(buf_slice(path), pcx), name, pcx);
        err_help(c"add `use ", pcx);
        buf_bytes(pcx.err_help, buf_slice(path));
        err_help(c"::", pcx);
        err_help_sym(name, pcx);
        err_help(c";`", pcx);
        // (0.18: `fix --suggested` adds it, as `fix --only imports`)
        err_fixable(pcx);
        return;
    }
    let mut tie = false;
    let near = nearest_name(name, value, &mut tie, pcx);
    if near >= 0 {
        err_help(c"did you mean '", pcx);
        err_help_sym(near, pcx);
        err_help(c"'?", pcx);
        if !tie {
            err_fix_word(err_pos(pcx), sym_text(name, pcx), sym_text(near, pcx), pcx);
        }
        return;
    }
    if value && rust_input_help(name, pcx) {
        return;
    }
    let mut in_std = near_to(name);
    std_names(pcx);
    for i in 0..pcx.std_names.len() as i64 / 2 {
        if ((pcx.std_names[(2 * i + 1) as usize]) != 0) == value {
            in_std.offer((pcx.std_names[(2 * i) as usize]), pcx);
        }
    }
    if in_std.best >= 0 && is_prelude_name(in_std.best, pcx) {
        // (0.17) a name of the prelude: no `use`
        err_help(c"did you mean '", pcx);
        err_help_sym(in_std.best, pcx);
        err_help(c"'?", pcx);
        if !in_std.tie {
            err_fix_word(err_pos(pcx), sym_text(name, pcx), sym_text(in_std.best, pcx), pcx);
        }
        return;
    }
    if in_std.best >= 0 {
        err_help(c"did you mean 'std::", pcx);
        err_help_sym(in_std.best, pcx);
        err_help(c"'? (`use std::", pcx);
        err_help_sym(in_std.best, pcx);
        err_help(c";`)", pcx);
        if !in_std.tie {
            let b = buf_new();
            buf_str(b, c"std::");
            buf_bytes(b, sym_text(in_std.best, pcx));
            err_fix_word(err_pos(pcx), sym_text(name, pcx), buf_slice(b), pcx);
        }
        return;
    }
    if hint_std && !crate::front::modules::within_std(pcx.cur_mod, pcx)
        && sym_text(name, pcx).len() > 2 {
        err_help(c"std's names: `volec guide std`", pcx);
    }
}

fn std_names(pcx: &mut Ctx<Comp>) {
    if pcx.std_names.len() as i64 > 0 {
        return;
    }
    let src = buf_new();
    std2_source(src);
    let text = buf_slice(src);
    let mut start: i64 = 0;
    while start < text.len() as i64 {
        let mut end = start;
        while end < text.len() as i64 && text[end as usize] != b'\n' {
            end += 1;
        }
        let line = &text[start as usize..end as usize];
        start = end + 1;
        // (the root's items, `std::NAME`: the text up to the first module's
        // banner, embed.sh's)
        if line.len() > 17 && &line[0..17] == b"// ---- mod std::" {
            break;
        }
        if line.len() < 8 || &line[0..4] != b"pub " {
            continue;
        }
        let mut rest = &line[4..];
        if rest.len() > 7 && rest[0..7] == b"unsafe " {
            rest = &rest[7..];
        }
        let mut value: i64 = -1;
        let mut skip: i64 = 0;
        if rest.len() > 3 && rest[0..3] == b"fn " {
            value = 1;
            skip = 3;
        } else if rest.len() > 6 && (&rest[0..6] == b"const " || &rest[0..6] == b"trait ") {
            value = if rest[0] == b'c' { 1 } else { 0 };
            skip = 6;
        } else if rest.len() > 7 && (&rest[0..7] == b"static " || &rest[0..7] == b"struct ") {
            value = if rest[1] == b't' && rest[2] == b'a' { 1 } else { 0 };
            skip = 7;
        } else if rest.len() > 5 && (&rest[0..5] == b"enum " || &rest[0..5] == b"type ") {
            value = 0;
            skip = 5;
        }
        if value < 0 {
            continue;
        }
        rest = &rest[skip as usize..];
        if rest.len() > 4 && rest[0..4] == b"mut " {
            rest = &rest[4..];
        }
        let mut n: i64 = 0;
        while n < rest.len() as i64 && is_ident_byte(rest[n as usize]) {
            n += 1;
        }
        if n > 0 {
            let name = intern(&rest[0..n as usize], pcx);
            pcx.std_names.push(name);
            pcx.std_names.push(value);
        }
    }
}

fn is_ident_byte(x: u8) -> bool {
    (x >= b'a' && x <= b'z') || (x >= b'A' && x <= b'Z') || (x >= b'0' && x <= b'9') || x == b'_'
}

// Whether std has a public value (or type) `name`.
pub fn std_has(name: i64, value: bool, pcx: &mut Ctx<Comp>) -> bool {
    std_names(pcx);
    for i in 0..pcx.std_names.len() as i64 / 2 {
        if (pcx.std_names[(2 * i) as usize]) == name
            && ((pcx.std_names[(2 * i + 1) as usize]) != 0) == value {
            return true;
        }
    }
    false
}

// The help of an unknown function a Rust or Python programmer reads input
// or parses numbers with (0.14).
fn rust_input_help(name: i64, pcx: &Ctx<Comp>) -> bool {
    let t = sym_text(name, pcx);
    if t == b"read_to_string" || t == b"read_all" || t == b"stdin" || t == b"input"
        || t == b"read_input" || t == b"read" || t == b"lines" || t == b"read_lines"
        || t == b"getline" || t == b"gets" || t == b"scanf" {
        err_help(c"std reads stdin: `std::io::read_to_string_in(std::io::stdin(), gpa)` (all of it, a String), `std::io::stdin().read_line(&mut s)` (one line, Ok(0) at the end), `lines_in(gpa)` (volec guide conversions#reading-input)", pcx);
    } else if t == b"parse" || t == b"atoi" || t == b"parse_i64" || t == b"to_int"
        || t == b"int" || t == b"from_str" {
        err_help(
            c"`s.parse::<i64>()` (a Result<i64, ParseIntError>; any number type); `s.split_whitespace()`, `s.trim()`", pcx);
    } else {
        return false;
    }
    true
}

// The help of an unknown type a Rust programmer writes (0.14): what
// vole has instead, exactly (0.17: the type to write as the try: line
// when there is one); whether there was one. (0.18.1) `Reverse`, a value
// too (`Reverse(x)`).
fn rust_type_help(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    let text = sym_text(name, pcx);
    if text == b"String" {
        err_help(c"text is `[u8]`, a slice of bytes (string literals are one); text you build is a `std::Buf` (`Buf::new_in(gpa)`, `b.push_str(s)`, `b.as_slice()` is its `[u8]`)", pcx);
        err_try(c"[u8]", pcx);
        rust_type_fix(text, b"[u8]", pcx);
    } else if text == b"str" {
        err_help(c"`&str` and `str` are `[u8]`: a slice of bytes, as string literals are", pcx);
        err_try(c"[u8]", pcx);
        rust_type_fix(text, b"[u8]", pcx);
    } else if text == b"char" {
        err_help(c"`u8`: text is bytes, and 'a' is a u8", pcx);
        err_try(c"u8", pcx);
        rust_type_fix(text, b"u8", pcx);
    } else if text == b"usize" || text == b"isize" {
        err_help(c"`i64`: lengths and indices are i64 (`s.len`, `v.len()`)", pcx);
        err_try(c"i64", pcx);
        rust_type_fix(text, b"i64", pcx);
    } else if text == b"Reverse" {
        // (0.18.1) Rust's min-heap, `BinaryHeap<Reverse<T>>`, and its
        // `Reverse(x)`: no tuple structs here
        err_help(c"a min-heap is `MinHeap<T>` (prelude): `h.push(x)`, `h.pop()` gives the smallest first, no wrapper; `BinaryHeap<T>` pops the largest", pcx);
        err_try(c"MinHeap<T>", pcx);
    } else if text == b"VecDeque" || text == b"LinkedList" {
        err_help(c"a `Vec<T>` (with a start index for a queue)", pcx);
        err_try(c"Vec<T>", pcx);
    } else if text == b"Box" || text == b"Rc" || text == b"Arc" {
        err_help(c"`*T` points to a value (`&x`; a parameter `p: *T` is a borrow); a value owned on the heap is a `Vec<T>` of one", pcx);
        err_try(c"*T", pcx);
    } else if text == b"RefCell" || text == b"Cell" || text == b"Mutex" {
        err_help(c"no interior mutability types: a `*T` writes through (`p.x = 1`), a `var` changes in place", pcx);
        err_try(c"*T", pcx);
    } else if pcx.std_module >= 0 && help_std_path(name, 0, pcx.cur_mod, false, pcx) {
        // (`std::cmp::max`: a Rust module of std read as a type)
    } else {
        return false;
    }
    true
}

// (0.18) The fix of a Rust type that has one vole spelling: the name at
// the error respelled, with the `&` before it (`&str`, `&String`: `[u8]`).
fn rust_type_fix(old: &[u8], new: &[u8], pcx: &mut Ctx<Comp>) {
    let pos = err_pos(pcx);
    if pos > 0 && get_src()[(pos - 1) as usize] == b'&'
        && get_src()[pos as usize..(pos + old.len() as i64) as usize] == old {
        err_fix(pos - 1, pos + old.len() as i64, new, pcx);
    } else {
        err_fix_word(pos, old, new, pcx);
    }
}

// Whether key `key` (an item's) is a value (a function, constant or
// static) or, for !value, a type.
fn key_is(key: i64, value: bool, pcx: &Ctx<Comp>) -> bool {
    if value {
        (pcx.sym_fn[key as usize]) != 0 || (pcx.sym_const[key as usize]) != 0
            || (pcx.sym_static[key as usize]) != 0
    } else {
        (pcx.sym_struct[key as usize]) != 0 || (pcx.sym_enum[key as usize]) != 0
            || (pcx.sym_alias[key as usize]) != 0 || template_of_key(key, pcx) != TPL_NONE
    }
}

// Whether `name` is a value (or a type) where the checker is.
fn name_in_scope(name: i64, value: bool, pcx: &mut Ctx<Comp>) -> bool {
    if value {
        match lookup_local(name, pcx) {
            Option::Some(_) => { return true; }
            Option::None => {}
        }
    } else if env_lookup(name, pcx) != 0 || (pcx.sym_primitive[name as usize]) != 0 {
        return true;
    }
    let b = lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, pcx);
    binding_kind(b) == B_ITEM && key_is(binding_value(b), value, pcx)
}

// The name in scope nearest to `name` (see name_distance), or -1.
fn nearest_name(name: i64, value: bool, tie: &mut bool, pcx: &mut Ctx<Comp>) -> i64 {
    let mut near = near_to(name);
    for s in 0..pcx.syms.len() as i64 {
        if near.close(s, pcx) && name_in_scope(s, value, pcx) {
            near.take(s, pcx);
        }
    }
    *tie = near.tie;
    near.best
}

// The help of an unknown item `name` of module m: the nearest name the
// current module can use there (an item, a module, a variant).
pub fn help_near_item(m: i64, name: i64, pcx: &mut Ctx<Comp>) {
    if pcx.help_off {
        return;
    }
    let mut near = near_to(name);
    for s in 0..pcx.syms.len() as i64 {
        if near.close(s, pcx) {
            let kind = binding_kind(lookup_quiet(m, s, pcx.cur_mod, pcx));
            if kind == B_ITEM || kind == B_MODULE || kind == B_VARIANT || kind == B_TVARIANT {
                near.take(s, pcx);
            }
        }
    }
    near.help(pcx);
}

// ---- Near names (0.14) ----
//
// The help of an unknown method, field, item or name: the closest known
// one, by name_distance, only computed once the error is made.

const NEAR_NONE: i64 = 1000000;

// The best candidate so far for an unknown name `want`, at distance d.
#[derive(Clone, Copy)] pub struct Near { pub want: i64, pub best: i64, pub d: i64, tie: bool }

// No candidate yet for unknown name `want`.
pub fn near_to(want: i64) -> Near {
    Near { want: want, best: -1, d: NEAR_NONE, tie: false }
}

// (0.17) The `max` names of NEAR_ALL closest to `want`, into the help as
// `'a', 'b'`: those related to it (a common prefix of 3, a shared
// `_` word, one inside the other, or an edit distance of at most half its
// length), closest first; how many.
pub fn help_closest_names(want: i64, max: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let w = sym_text(want, pcx);
        let mut score: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..pcx.near_all.len() as i64 {
            let c = sym_text((pcx.near_all[i as usize]), pcx);
            let d = edit_distance(w, c);
            let mut p: i64 = 0;
            while p < w.len() as i64 && p < c.len() as i64 && w[p as usize] == c[p as usize] {
                p += 1;
            }
            let inside = c.len() >= w.len()
                && (0i64..c.len() as i64 - w.len() as i64 + 1).any(
                    |k| &c[k as usize..(k + w.len() as i64) as usize] == w)
                || w.len() >= c.len() && c.len() >= 3
                && (0i64..w.len() as i64 - c.len() as i64 + 1).any(
                    |k| &w[k as usize..(k + c.len() as i64) as usize] == c);
            // (0.25.2.1: only related names, however few: `x.sqrt()` on an
            // f64 offered `fmt`, `fmt_debug`; `query items T` lists them all)
            let related = p >= 3 || inside || d * 2 <= w.len() as i64 || shares_word(w, c);
            score.push(if related { d * 4 - p * 3 - (if inside { 8 } else { 0 }) }
                else { i64::MAX });
        }
        let mut shown: i64 = 0;
        while shown < max {
            let mut best: i64 = -1;
            for i in 0..pcx.near_all.len() as i64 {
                if (score[i as usize]) != i64::MAX
                    && (best < 0 || (score[i as usize]) < (score[best as usize])
                        || (score[i as usize]) == (score[best as usize])
                        && sym_text((pcx.near_all[i as usize]), pcx).len()
                        < sym_text((pcx.near_all[best as usize]), pcx).len()) {
                    best = i;
                }
            }
            if best < 0 {
                break;
            }
            if shown > 0 {
                err_help(c", ", pcx);
            }
            err_help(c"'", pcx);
            err_help_sym((pcx.near_all[best as usize]), pcx);
            err_help(c"'", pcx);
            (score[best as usize]) = i64::MAX;
            shown += 1;
        }
        shown
    }
}

// (0.17) `prefix` and the names of NEAR_ALL nearest to `want` as the help
// (help_closest_names); no help when none is near.
pub fn help_nearest(prefix: *mut u8, want: i64, pcx: &Ctx<Comp>) {
    let mark = buf_len(pcx.err_help);
    err_help(prefix, pcx);
    if help_closest_names(want, 4, pcx) == 0 {
        buf_truncate(pcx.err_help, mark);
    }
}

// Whether names a and b share a word of 3 letters or more (words split at
// `_`: `push_string` and `push_str` share `push`).
fn shares_word(a: &[u8], b: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < a.len() as i64 {
        let mut j = i;
        while j < a.len() as i64 && a[j as usize] != b'_' {
            j += 1;
        }
        if j - i >= 3 {
            let word = &a[i as usize..j as usize];
            let mut k: i64 = 0;
            while k < b.len() as i64 {
                let mut e = k;
                while e < b.len() as i64 && b[e as usize] != b'_' {
                    e += 1;
                }
                if &b[k as usize..e as usize] == word {
                    return true;
                }
                k = e + 1;
            }
        }
        i = j + 1;
    }
    false
}

impl Near {
    // Whether candidate `cand` (a symbol) is closer than the best so far.
    pub fn close(self, cand: i64, pcx: &Ctx<Comp>) -> bool {
        if cand < 0 || cand == self.want {
            return false;
        }
        let d = name_distance(sym_text(self.want, pcx), sym_text(cand, pcx));
        // (0.18: as near as the best: a tie, which take notes)
        d >= 0 && (d < self.d || d == self.d && cand != self.best)
    }

    pub fn take(&mut self, cand: i64, pcx: &Ctx<Comp>) {
        let d = name_distance(sym_text(self.want, pcx), sym_text(cand, pcx));
        if d == self.d {
            // (0.18) another name as near as the best: the help keeps
            // the first, and there is no fix
            self.tie = self.tie || sym_text(cand, pcx) != sym_text(self.best, pcx);
            return;
        }
        self.d = d;
        self.best = cand;
        self.tie = false;
    }

    // Offers candidate `cand`.
    pub fn offer(&mut self, cand: i64, pcx: &mut Ctx<Comp>) {
        if pcx.near_collect && cand >= 0 && cand != self.want {
            let mut seen = false;
            for i in 0..pcx.near_all.len() as i64 {
                if (pcx.near_all[i as usize]) == cand {
                    seen = true;
                }
            }
            if !seen {
                pcx.near_all.push(cand);
            }
        }
        if self.close(cand, pcx) {
            self.take(cand, pcx);
        }
    }

    // The error's help, `did you mean 'x'?`, when there is a candidate and
    // no other help.
    pub fn help(self, pcx: &mut Ctx<Comp>) {
        if self.best >= 0 && buf_len(pcx.err_help) == 0 {
            err_help(c"did you mean '", pcx);
            err_help_sym(self.best, pcx);
            err_help(c"'?", pcx);
            // (0.18) the only name that near: the fix renames it
            if !self.tie {
                err_fix_word(err_pos(pcx), sym_text(self.want, pcx), sym_text(self.best, pcx),
                    pcx);
            }
        }
    }
}

// How far candidate name `cand` is from `want`, or -1 when it is not close:
// 0 when they differ only in case and underscores (`pushStr`, `push_str`),
// else their edit distance, at most a third of want's length (at least 1)
// and less than either length (`y` is not near `f`). Only identifiers count.
pub fn name_distance(want: &[u8], cand: &[u8]) -> i64 {
    if cand.len() == 0 || !is_ident_text(cand) {
        return -1;
    }
    if loosely_equal(want, cand) {
        return 0;
    }
    let mut limit = want.len() as i64 / 3;
    if limit < 1 {
        limit = 1;
    }
    if cand.len() as i64 > want.len() as i64 + limit
        || cand.len() as i64 + limit < want.len() as i64 {
        return -1;
    }
    let d = edit_distance(want, cand);
    if d > limit || d >= want.len() as i64 || d >= cand.len() as i64 {
        return -1;
    }
    d
}

fn is_ident_text(t: &[u8]) -> bool {
    let c = t[0];
    if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_') {
        return false;
    }
    for &x in t {
        if !((x >= b'a' && x <= b'z') || (x >= b'A' && x <= b'Z') || (x >= b'0' && x <= b'9')
            || x == b'_') {
            return false;
        }
    }
    true
}

// Whether a and b are the same name but for case and underscores.
fn loosely_equal(a: &[u8], b: &[u8]) -> bool {
    let mut i: i64 = 0;
    let mut j: i64 = 0;
    loop {
        while i < a.len() as i64 && a[i as usize] == b'_' {
            i += 1;
        }
        while j < b.len() as i64 && b[j as usize] == b'_' {
            j += 1;
        }
        if i == a.len() as i64 || j == b.len() as i64 {
            return i == a.len() as i64 && j == b.len() as i64;
        }
        if lower(a[i as usize]) != lower(b[j as usize]) {
            return false;
        }
        i += 1;
        j += 1;
    }
}

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 } else { c }
}

// (0.28.0) Whether a program can name std's module m: each module on its
// path below std's root is public (std::window's `mod script;` is not, and
// its `pub fn size` is no item to import).
fn std_nameable(m: i64, pcx: &Ctx<Comp>) -> bool {
    let mut s = m;
    while s > 0 && s != pcx.std_module && within_std(s, pcx) {
        if !pcx.modules[s as usize].public {
            return false;
        }
        s = pcx.modules[s as usize].parent;
    }
    true
}

// The path of the module (`crate::a::b`, `std`) whose public item `name`
// is a value (or a type) the current module could import: a buffer, or 0.
// The program's module first (`fix --only imports` chooses among several
// by nearness). (0.25.3, eval 0.25.2.2: `Matches`, std::cli's and
// std::string's) Else, when several of std's modules have one (from std's
// whole source: a module the program does not name is not loaded), the
// one whose path the file already names (`use std::cli::{Arg, ..}`); else
// none, and IMPORT_PATHS lists them all.
pub fn import_path_for(name: i64, value: bool, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.import_paths = 0;
    let paths = buf_new();
    let mut in_std = false;
    let mut std_first: i64 = 0;
    for m in 0..module_count(pcx) {
        if m == pcx.cur_mod || m == pcx.c_module {
            continue;
        }
        let key = item_key_if_known(m, name, pcx);
        if key < 0 {
            continue;
        }
        let item = item_node_of(key, pcx);
        if item == 0 || (pcx.nodes[item as usize].p & ITEM_PUBLIC) == 0
            || !key_is(key, value, pcx) {
            continue;
        }
        let out = buf_new();
        // (0.20) std's modules: `std` when its root re-exports the item
        // (`use std::HashSet;`, not `std::collections::hash_set`)
        if m != pcx.std_module && within_std(m, pcx)
            && binding_kind(lookup_name(pcx.std_module, name, pcx.cur_mod, pcx)) == B_ITEM {
            buf_str(out, c"std");
            return out;
        }
        if within_std(m, pcx) && !std_nameable(m, pcx) {
            continue;
        }
        if within_std(m, pcx) {
            if !in_std {
                put_module_path(out, m, pcx);
                std_first = out;
            }
            in_std = true;
            continue;
        }
        put_module_path(out, m, pcx);
        return out;
    }
    if in_std {
        std_item_paths(paths, name, value, pcx);
    }
    let all = buf_slice(paths);
    let f = crate::front::modules::file_of_pos(err_pos(pcx), pcx);
    let file = if f
        >= 0 { &get_src()[
            pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize] }
        else { &get_src()[0..0] };
    let mut count: i64 = 0;
    let mut named_count: i64 = 0;
    let mut first = &all[0..0];
    let mut named = &all[0..0];
    let list = buf_new();
    let mut a: i64 = 0;
    while a < all.len() as i64 {
        let mut e = a;
        while e < all.len() as i64 && all[e as usize] != b'\n' {
            e += 1;
        }
        let p = &all[a as usize..e as usize];
        a = e + 1;
        if count == 0 {
            first = p;
        } else {
            buf_str(list, c" or ");
        }
        count += 1;
        buf_str(list, c"`use ");
        buf_bytes(list, p);
        buf_str(list, c"::");
        buf_bytes(list, sym_text(name, pcx));
        buf_str(list, c";`");
        let mentioned = buf_new();
        buf_bytes(mentioned, p);
        buf_str(mentioned, c"::");
        if mentions(file, buf_slice(mentioned)) {
            named = p;
            named_count += 1;
        }
    }
    let one = if count == 1 { first } else if named_count == 1 { named } else { &all[0..0] };
    if one.len() > 0 {
        let out = buf_new();
        buf_bytes(out, one);
        return out;
    }
    if count > 1 {
        pcx.import_paths = list;
        return 0;
    }
    // (std's source not read as the scan reads it: the module found)
    std_first
}

// Path p as a line of paths (a buffer), unless it has it.
fn add_path(paths: i64, p: &[u8]) {
    let have = buf_new();
    buf_str(have, c"\n");
    buf_bytes(have, buf_slice(paths));
    let line = buf_new();
    buf_str(line, c"\n");
    buf_bytes(line, p);
    buf_str(line, c"\n");
    if !mentions(buf_slice(have), buf_slice(line)) {
        buf_bytes(paths, p);
        buf_str(paths, c"\n");
    }
}

// (0.28.0) Whether the module above the one in std's file `file`
// (`collections/binary_heap.vl`: `collections/mod.vl`; `alloc.vl`:
// `std.vl`) re-exports `word` from it, `pub use binary_heap::{BinaryHeap,
// MinHeap};`: the path a program writes is the parent's, as Rust's
// (`std::collections::BinaryHeap`). text: std's whole source; list: its
// files with their offsets.
fn parent_reexports(text: &[u8], list: &[u8], file: &[u8], word: &[u8]) -> bool {
    if file.len() < 4 {
        return false;
    }
    let mut f = &file[0..file.len() - 3];
    if f.len() > 4 && f[f.len() - 4..] == b"/mod" {
        f = &f[0..f.len() - 4];
    }
    let mut cut: i64 = -1;
    for i in 0..f.len() as i64 {
        if f[i as usize] == b'/' {
            cut = i;
        }
    }
    let leaf = &f[(cut + 1) as usize..];
    let own = buf_new();
    let flat = buf_new();
    if cut < 0 {
        buf_str(own, c"std.vl");
        buf_str(flat, c"std.vl");
    } else {
        buf_bytes(own, &f[0..cut as usize]);
        buf_str(own, c"/mod.vl");
        buf_bytes(flat, &f[0..cut as usize]);
        buf_str(flat, c".vl");
    }
    // (the parent's text: from its offset to the next file's)
    let mut from: i64 = -1;
    let mut to = text.len() as i64;
    let mut a: i64 = 0;
    while a < list.len() as i64 {
        let mut e = a;
        while e < list.len() as i64 && list[e as usize] != b'\n' {
            e += 1;
        }
        let mut s = a;
        let mut off: i64 = 0;
        while s < e && list[s as usize] != b' ' {
            off = off * 10 + (list[s as usize] - b'0') as i64;
            s += 1;
        }
        a = e + 1;
        if s >= e {
            continue;
        }
        if from >= 0 {
            to = off;
            break;
        }
        let name = &list[(s + 1) as usize..e as usize];
        if name == buf_slice(own) || name == buf_slice(flat) {
            from = off;
        }
    }
    if from < 0 || to > text.len() as i64 {
        return false;
    }
    let part = buf_new();
    buf_bytes(part, leaf);
    buf_str(part, c"::");
    let mut start = from;
    while start < to {
        let mut end = start;
        while end < to && text[end as usize] != b'\n' {
            end += 1;
        }
        let line = &text[start as usize..end as usize];
        start = end + 1;
        if line.len() < 9 || &line[0..8] != b"pub use " || !mentions(line, buf_slice(part)) {
            continue;
        }
        // (the name as a whole word of the line)
        let mut i: i64 = 8;
        while i + word.len() as i64 <= line.len() as i64 {
            if &line[i as usize..i as usize + word.len()] == word
                && !crate::front::lexer::is_ident_byte(line[(i - 1) as usize])
                && (i as usize + word.len() == line.len()
                    || !crate::front::lexer::is_ident_byte(line[i as usize + word.len()])) {
                return true;
            }
            i += 1;
        }
    }
    false
}

// (0.25.3) The paths of std's modules (`std::cli`) that define a public
// value (or type) `name` at their top level, from std's whole source and
// its files' list (`flat/` and std.vl: `std`), added to paths.
fn std_item_paths(paths: i64, name: i64, value: bool, pcx: &Ctx<Comp>) {
    let src = buf_new();
    std2_source(src);
    let files = buf_new();
    crate::front::stdsrc_rust::std2_files(files);
    let text = buf_slice(src);
    let list = buf_slice(files);
    let word = sym_text(name, pcx);
    let mut start: i64 = 0;
    while start < text.len() as i64 {
        let mut end = start;
        while end < text.len() as i64 && text[end as usize] != b'\n' {
            end += 1;
        }
        let line = &text[start as usize..end as usize];
        let at = start;
        start = end + 1;
        if line.len() < 5 || &line[0..4] != b"pub " {
            continue;
        }
        let mut rest = &line[4..line.len()];
        if rest.len() > 7 && rest[0..7] == b"unsafe " {
            rest = &rest[7..rest.len()];
        }
        let mut kind_len: i64 = 0;
        let kinds: &[&[u8]] = if value { &[b"fn ", b"const ", b"static "] }
            else { &[b"struct ", b"enum ", b"type ", b"trait ", b"union "] };
        for &k in kinds {
            if rest.len() > k.len() && rest[0..k.len()] == k {
                kind_len = k.len() as i64;
            }
        }
        if kind_len == 0 {
            continue;
        }
        rest = &rest[kind_len as usize..];
        if rest.len() < word.len() || &rest[0..word.len()] != word
            || rest.len() > word.len()
            && crate::front::lexer::is_ident_byte(rest[word.len()]) {
            continue;
        }
        // (the file at `at`: the last whose offset is not past it)
        let mut file = &list[0..0];
        let mut a: i64 = 0;
        while a < list.len() as i64 {
            let mut e = a;
            while e < list.len() as i64 && list[e as usize] != b'\n' {
                e += 1;
            }
            let mut s = a;
            let mut off: i64 = 0;
            while s < e && list[s as usize] != b' ' {
                off = off * 10 + (list[s as usize] - b'0') as i64;
                s += 1;
            }
            if off > at || s >= e {
                break;
            }
            file = &list[(s + 1) as usize..e as usize];
            a = e + 1;
        }
        let path = buf_new();
        buf_str(path, c"std");
        if file.len() > 3 && file != b"std.vl" {
            let mut f = &file[0..(file.len() as i64 - 3) as usize];
            if f.len() > 4 && f[(f.len() as i64 - 4) as usize..] == b"/mod" {
                f = &f[0..(f.len() as i64 - 4) as usize];
            }
            buf_str(path, c"::");
            for &c in f {
                if c == b'/' {
                    buf_str(path, c"::");
                } else {
                    buf_byte(path, c);
                }
            }
        }
        // (the module above re-exports it: its path, `std::collections`)
        if parent_reexports(text, list, file, word) {
            let whole = buf_slice(path);
            let mut cut = whole.len() as i64;
            for i in 0..whole.len() as i64 {
                if whole[i as usize] == b':' {
                    cut = i;
                }
            }
            if cut > 0 && cut < whole.len() as i64 {
                add_path(paths, &whole[0..(cut - 1) as usize]);
                continue;
            }
        }
        add_path(paths, buf_slice(path));
    }
}

// Whether text t has part in it.
fn mentions(t: &[u8], part: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + part.len() as i64 <= t.len() as i64 {
        if &t[i as usize..(i + part.len() as i64) as usize] == part {
            return true;
        }
        i += 1;
    }
    false
}

fn put_module_path(out: i64, m: i64, pcx: &Ctx<Comp>) {
    if m == 0 {
        buf_str(out, c"crate");
    } else if m == pcx.std_module {
        buf_str(out, c"std");
    } else {
        put_module_path(out, pcx.modules[m as usize].parent, pcx);
        buf_str(out, c"::");
        buf_bytes(out, sym_text(pcx.modules[m as usize].name, pcx));
    }
}

// The type of function f as a value, named at node n: in a rust-edition
// position, an `unsafe fn` or a C function (an extern block's) is an
// `unsafe fn` type (RULE: F19.3).
pub fn fn_value_type(f: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mark = pcx.tscratch.len() as i64;
    for i in 0..pcx.fns[f as usize].param_count {
        pcx.tscratch.push(fn_param(f, i, pcx));
    }
    let mut b: i64 = 0;
    if pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export {
        b = crate::front::types::FN_TY_C;
    }
    if (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 || pcx.fns[f as usize].is_extern {
        b |= crate::front::types::FN_TY_UNSAFE;
    }
    make_type(TyKind::Fn, pcx.fns[f as usize].ret, b, mark, pcx)
}
