// (0.27.4) F18.6's type variables, FL1's deferred inference: in the rust
// edition a type parameter of a generic call, a variant or a struct
// literal that the call leaves free is a variable ?ᵢ (a distinct type over
// `()` whose TyName is flagged TY_INFER, its solution in its y, 0 while
// free), solved by the first check that unifies a type mentioning it with
// a definite type (check_mode: check_expr_inner). The function being
// checked keeps the records of the calls that made its variables
// (INFER_RECS from INFER_BASE): at its end a variable still free is the
// call's `type.infer`, and the nodes, locals and closure signatures that
// mention one are retyped, the instances made with one made again. No
// variable outlives the function: an instance made with one is never
// queued (no body check, no code, no effects) and is marked
// FN_QUERY_ONLY; its instance key holds a variable no later type equals.
// MVS makes none (can_defer), and every hook is behind INFER_LIVE.

use std::alloc::Allocator;

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, TY_OMEGA, TY_OPAQUE, child, new_node};
use crate::front::types::{TY_UNIT, TyKind, make_type};

// The TyName flag of a variable's node (with TY_OPAQUE and TY_OMEGA: an
// Ω without bounds, so no instance with one is lowered, D22.2).
pub const TY_INFER: i64 = 1 << 61;

// A record of INFER_RECS: its length, then the call's position, what it
// calls, the message's shape, outer and member (require_bound's), the
// Generics node, the parameter count, and the bound types (the variables
// at the free ones).
const REC_HEAD: i64 = 8;

// The state of the function being checked, saved around a nested check.
#[derive(Clone, Copy)] pub struct InferMark {
    base: i64,
    live: bool,
    nodes: i64,
    locals: i64,
    fns: i64,
    count: i64,
    dbase: i64,
    deps: i64,
    closures: i64,
}

// (check_function) A function's check starts: its records from here on.
pub fn begin(pcx: &mut Ctx<Comp>) -> InferMark {
    let m = save(pcx);
    pcx.infer_base = pcx.infer_recs.len() as i64;
    pcx.infer_dbase = pcx.infer_deps.len() as i64;
    pcx.infer_live = false;
    pcx.infer_nodes = pcx.nodes.len() as i64;
    pcx.infer_locals = pcx.locals.len() as i64;
    pcx.infer_fns = pcx.fns.len() as i64;
    pcx.infer_closures = pcx.closures.len() as i64;
    m
}

pub fn save(pcx: &Ctx<Comp>) -> InferMark {
    InferMark {
        base: pcx.infer_base, live: pcx.infer_live, nodes: pcx.infer_nodes,
        locals: pcx.infer_locals, fns: pcx.infer_fns, count: pcx.infer_recs.len() as i64,
        dbase: pcx.infer_dbase, deps: pcx.infer_deps.len() as i64, closures: pcx.infer_closures,
    }
}

// (check_function_recovering) The state before a check an error left.
pub fn restore(m: InferMark, pcx: &mut Ctx<Comp>) {
    pcx.infer_recs.truncate(m.count as usize);
    pcx.infer_deps.truncate(m.deps as usize);
    pcx.infer_base = m.base;
    pcx.infer_dbase = m.dbase;
    pcx.infer_live = m.live;
    pcx.infer_nodes = m.nodes;
    pcx.infer_locals = m.locals;
    pcx.infer_fns = m.fns;
    pcx.infer_closures = m.closures;
}

// Whether type t is a variable.
pub fn is_var(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Distinct && pcx.types[t as usize].b > 0
        && pcx.nodes[pcx.types[t as usize].b as usize].kind == NodeKind::TyName
        && (pcx.nodes[pcx.types[t as usize].b as usize].p & TY_INFER) != 0
}

// Variable v's solution, 0 while free.
fn solution(v: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.nodes[pcx.types[v as usize].b as usize].y
}

// RULE: F18.6 Whether the call at pos may leave a parameter to a variable:
// a rust-edition call, in a function being checked.
pub fn can_defer(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    pcx.infer_base >= 0 && !pcx.check_unchecked && pcx.cur_fn >= 0
}

// RULE: F18.6 (require_bound) The free parameters of `params` (bound[i] ==
// 0) take fresh variables, and the call is recorded for its message.
pub fn make_vars(params: i64, bound: &mut [i64], pos: i64, what: i64, shape: i64, outer: i64,
    member: i64, pcx: &mut Ctx<Comp>) {
    let count = pcx.nodes[params as usize].count;
    go_live(pcx);
    let rec = pcx.infer_recs.len() as i64;
    for i in 0..count {
        if (bound[i as usize]) == 0 {
            (bound[i as usize]) = fresh(child(params, i, pcx), rec, pcx);
        }
    }
    pcx.infer_recs.push(REC_HEAD + count);
    pcx.infer_recs.push(pos);
    pcx.infer_recs.push(what);
    pcx.infer_recs.push(shape);
    pcx.infer_recs.push(outer);
    pcx.infer_recs.push(member);
    pcx.infer_recs.push(params);
    pcx.infer_recs.push(count);
    for i in 0..count {
        pcx.infer_recs.push((bound[i as usize]));
    }
}

// A fresh variable for parameter `param` of the call recorded at rec.
fn fresh(param: i64, rec: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let node = new_node(NodeKind::TyName, pcx.nodes[param as usize].start,
        pcx.nodes[param as usize].end, pcx);
    pcx.nodes[node as usize].a = pcx.underscore;
    pcx.nodes[node as usize].p |= TY_OPAQUE | TY_OMEGA | TY_INFER;
    pcx.nodes[node as usize].x = rec + 1;
    pcx.any_distinct = true;
    let t = make_type(TyKind::Distinct, TY_UNIT, node, pcx.tscratch.len() as i64, pcx);
    pcx.nodes[node as usize].z = t;
    t
}

// RULE: F18.5 (0.30.2) The flag of an integer variable's TyName node (with
// TY_INFER): the type of an unsuffixed integer literal, rustc's
// `{integer}`. It is solved by unification with an integer type or another
// integer variable, never with another type; one still free when the
// function's check ends is `i32` (int_fallback), rustc's fallback.
pub const TY_INT_VAR: i64 = 1 << 58;

// The record shapes of an integer variable (INFER_RECS: one per variable,
// its `what` the literal that made it) and of a negation of one's value.
const SHAPE_INT: i64 = -2;
const SHAPE_NEG: i64 = -3;
const SHAPE_HOLE: i64 = -4;
const SHAPE_MATCH: i64 = -5;
const SHAPE_METHOD: i64 = -6;

// RULE: F18.5 (0.30.2: calls/mod.vl int_var_method) Call n, made of a
// method `name` of trait tr called on a value of integer variable v, its
// callee i32's: its callee is the method of the type v takes, at the
// function's end (int_fallback), as rustc selects the impl then.
pub fn int_method(n: i64, v: i64, name: i64, pcx: &mut Ctx<Comp>) {
    int_record(n, SHAPE_METHOD, v, pcx);
    let r = pcx.infer_recs.len() as i64 - REC_HEAD - 1;
    pcx.infer_recs[(r + 5) as usize] = name;
}

// Whether type t is type x or holds it (a reference to it, an element, a
// type argument).
pub fn holds_type(t: i64, x: i64, pcx: &Ctx<Comp>) -> bool {
    holds_at(t, x, 0, pcx)
}

fn holds_at(t: i64, x: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || depth > 16 {
        return false;
    }
    if t == x {
        return true;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return holds_at(pcx.types[t as usize].a, x, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t as usize].count {
            if holds_at(pcx.tlists[(pcx.types[t as usize].list + i) as usize], x, depth + 1, pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && holds_at(pcx.types[t as usize].a, x, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if holds_at(pcx.tlists[(at + i) as usize], x, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// Whether some integer type implements trait tr (traits.vl implements, of
// an integer variable still free).
pub fn int_some_impl(tr: i64, pcx: &mut Ctx<Comp>) -> bool {
    for k in 0..10 {
        if crate::front::traits::implements(tr, INT_TYPES[k as usize], pcx) {
            return true;
        }
    }
    false
}

// RULE: F18.5 (0.30.2: calls int_var_method) Two integer types whose
// method `name` is of an impl of one trait, i32 first when it is one, as
// rustc's probe finds the trait's method for `{integer}` whichever impl
// the variable comes to select (`e.show()` with `impl Show` for i32 and
// i64: Self the variable, the impl the type it takes): (their methods,
// their types); (-1, -1, 0, 0) when fewer than two have it so.
pub fn int_impl_pair(name: i64, pcx: &mut Ctx<Comp>) -> (i64, i64, i64, i64) {
    let mut f: i64 = -1;
    let mut ft: i64 = 0;
    let mut tr: i64 = -1;
    for k in 0..10 {
        let t = INT_TYPES[k as usize];
        let m = crate::front::check::calls::int_trait_fn(t, name, pcx);
        let im = if m >= 0 { crate::front::traits::impl_of_fn(m, pcx) } else { -1 };
        if im < 0 {
            continue;
        }
        let mtr = pcx.traits_impls[im as usize].tr;
        if f < 0 {
            f = m;
            ft = t;
            tr = mtr;
        } else if mtr == tr {
            return (f, m, ft, t);
        }
    }
    (-1, -1, 0, 0)
}

// RULE: F18.5 (0.30.2: synth_expr of an unsuffixed integer literal n, or
// of an operator whose type an integer variable gives) A fresh integer
// variable.
pub fn int_var(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    go_live(pcx);
    let rec = pcx.infer_recs.len() as i64;
    let v = fresh(n, rec, pcx);
    let node = pcx.types[v as usize].b;
    pcx.nodes[node as usize].p |= TY_INT_VAR;
    pcx.nodes[node as usize].a = crate::base::intern_c(c"{integer}", pcx);
    int_record(n, SHAPE_INT, v, pcx);
    v
}

// RULE: F18.5 (0.30.2: synth_unary) Negation n of a value of integer
// variable v: checked at the function's end to be of a signed type.
pub fn int_negated(n: i64, v: i64, pcx: &mut Ctx<Comp>) {
    int_record(n, SHAPE_NEG, v, pcx);
}

// RULE: F18.5 (0.30.2: interp.vl push_writes_std) The write of a direct
// call's hole whose value is of integer variable v (interp's record m):
// made again with v's type when the function's check ends.
pub fn int_hole(m: i64, v: i64, pcx: &mut Ctx<Comp>) {
    int_record(m, SHAPE_HOLE, v, pcx);
}

// RULE: F18.5 (0.30.2: traits.vl check_bounds) The arguments TLISTS[args..]
// of generic trait tr in a bound on type t: each that is an integer
// variable still free is the one integer type for which t implements tr,
// as rustc's selection confirms the one impl (`i64: Sum<{integer}>` gives
// i64, std's `impl Sum for i64`). Whether none is left free (the bound is
// checked now); one that several types or none fit is checked on the type
// it takes, when the instance is made again with it.
pub fn int_trait_args(tr: i64, t: i64, args: i64, pcx: &mut Ctx<Comp>) -> bool {
    if tr < 0 {
        return true;
    }
    let count = crate::front::convert::trait_param_count(tr, pcx);
    for k in 0..count {
        let v = pcx.tlists[(args + k) as usize];
        if !int_free(v, pcx) {
            continue;
        }
        let mut found: i64 = 0;
        for j in 0..10 {
            let c = INT_TYPES[j as usize];
            let at = pcx.tlists.len() as i64;
            for i in 0..count {
                let a = if i == k { c } else { pcx.tlists[(args + i) as usize] };
                pcx.tlists.push(a);
            }
            if crate::front::convert::implements_with(tr, t, at, pcx) {
                if found != 0 {
                    return false;
                }
                found = c;
            }
        }
        if found == 0 || !unify(v, found, pcx) {
            return false;
        }
        pcx.tlists[(args + k) as usize] = found;
    }
    true
}

// RULE: F18.5 (0.30.2: patterns/mod.vl check_match) Whether the arms of
// match n, on a value of type st, are checked for reachability and
// exhaustiveness when the function's check ends, not now: st holds an
// integer variable still free, whose type decides the values its patterns
// cover (`0..=255` is all of a u8's, not of an i32's).
pub fn int_match_later(n: i64, st: i64, pcx: &mut Ctx<Comp>) -> bool {
    if !pcx.infer_live || !int_open(st, pcx) {
        return false;
    }
    int_record(n, SHAPE_MATCH, st, pcx);
    true
}

// Whether type t is or holds an integer variable still free.
pub fn int_open(t: i64, pcx: &Ctx<Comp>) -> bool {
    first_int(t, 0, pcx) != 0
}

// A record of node n (its `what`) and integer variable v, of shape s.
fn int_record(n: i64, s: i64, v: i64, pcx: &mut Ctx<Comp>) {
    pcx.infer_recs.push(REC_HEAD + 1);
    pcx.infer_recs.push(pcx.nodes[n as usize].start);
    pcx.infer_recs.push(n);
    pcx.infer_recs.push(s);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(1);
    pcx.infer_recs.push(v);
}

// Whether type t is an integer variable (solved or not).
pub fn is_int_var(t: i64, pcx: &Ctx<Comp>) -> bool {
    is_var(t, pcx) && (pcx.nodes[pcx.types[t as usize].b as usize].p & TY_INT_VAR) != 0
}

// Type t, a variable's solution in its place when t is one that is solved
// (followed through the variables it names), else t.
pub fn follow(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut r = t;
    let mut depth: i64 = 0;
    while depth < 64 && is_var(r, pcx) && solution(r, pcx) != 0 {
        r = solution(r, pcx);
        depth += 1;
    }
    r
}

// Whether type t, with the solutions so far, is an integer variable still
// free: a value of some integer type nothing has decided yet.
pub fn int_free(t: i64, pcx: &Ctx<Comp>) -> bool {
    let mut r = t;
    let mut depth: i64 = 0;
    while depth < 64 && is_var(r, pcx) && solution(r, pcx) != 0 {
        r = solution(r, pcx);
        depth += 1;
    }
    is_int_var(r, pcx) && solution(r, pcx) == 0
}

// RULE: F18.5 (0.30.2: check_mode's coercions) A value of type `actual`
// that holds an integer variable, where `expected` goes and neither type
// unifies with the other: the variables under its references take the
// coercion target's types there, as rustc's coercions unify the pointee
// (`&[1, 2, 250]` where `&[u8]` goes: the elements are u8; `&n` where
// `*const i64` goes: n is an i64). `actual` with the solutions.
pub fn coerce_vars(actual: i64, expected: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // (a variable unify solved before it failed counts: `&{integer}` and
    // `*const i64` unified the pointees, then failed on the pointers)
    if actual <= 0 || expected <= 0 || !mentions(actual, true, pcx) {
        return actual;
    }
    let mut a = actual;
    let mut e = expected;
    let mut depth: i64 = 0;
    while depth < 8 && a > 0 && e > 0 && pcx.types[a as usize].kind == TyKind::Ptr
        && pcx.types[e as usize].kind == TyKind::Ptr {
        a = follow(pcx.types[a as usize].a, pcx);
        e = pcx.types[e as usize].a;
        depth += 1;
    }
    if a > 0 && e > 0 && pcx.types[a as usize].kind == TyKind::Ptr
        && pcx.types[e as usize].kind == TyKind::Slice {
        let p = follow(pcx.types[a as usize].a, pcx);
        if p > 0 && pcx.types[p as usize].kind == TyKind::Array {
            let _ = unify(pcx.types[p as usize].a, pcx.types[e as usize].a, pcx);
        }
    } else if depth > 0 && a != e {
        let _ = unify(a, e, pcx);
    }
    resolve(actual, pcx)
}

// The primitive integer types, in the order a choice among them is made.
const INT_TYPES: [i64; 10] = [crate::front::types::TY_I32, crate::front::types::TY_I64,
    crate::front::types::TY_U8, crate::front::types::TY_U16, crate::front::types::TY_U32,
    crate::front::types::TY_U64, crate::front::types::TY_USIZE, crate::front::types::TY_ISIZE,
    crate::front::types::TY_I8, crate::front::types::TY_I16];

// RULE: F18.5 (0.30.2: traits.vl check_bounds) Type t, an integer variable
// still free or a type that holds one (`Range<{integer}>` of `s.get(1..3)`),
// is bound by the trait bounds of parameter node p: when one integer type
// alone, put for the variable, satisfies them all, the variable is that
// type, as rustc's selection confirms the one impl that can apply (`f(5)`
// with `f<T: Tr>` and `impl Tr for i64` alone; `Range<usize>: SliceIndex`);
// otherwise it stays free and the bounds are checked on the type it takes,
// when the instance is made again. `args`: the parameters of the bounds'
// trait arguments are bound (check_bounds' env), so a generic trait's bound
// is checked with them; else it is not counted.
pub fn int_bounds(t: i64, p: i64, args: bool, pcx: &mut Ctx<Comp>) {
    let bounds = pcx.nodes[p as usize].h;
    let v = first_int(t, 0, pcx);
    if bounds == 0 || v == 0 {
        return;
    }
    let mut found: i64 = 0;
    for k in 0..10 {
        let c = INT_TYPES[k as usize];
        let tc = with_solution(t, v, c, pcx);
        let mut all = true;
        for i in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, i, pcx);
            // (a trait's bound; an `Fn` or an effects bound says nothing)
            let tr = crate::front::traits::bound_trait(b, pcx);
            if tr < 0 {
                continue;
            }
            let holds = if pcx.nodes[b as usize].g == 0 {
                crate::front::traits::implements(tr, tc, pcx)
            } else if args {
                let ba = crate::front::convert::bound_ref(b, tc, pcx);
                crate::front::convert::implements_with(tr, tc, ba, pcx)
            } else { true };
            if !holds {
                all = false;
            }
        }
        if all {
            if found != 0 {
                return;
            }
            found = c;
        }
    }
    if found != 0 {
        unify(v, found, pcx);
    }
}

// The first integer variable still free that type t is or holds; 0 when
// none.
fn first_int(t: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return 0;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return if s != 0 { first_int(s, depth + 1, pcx) } else if is_int_var(t, pcx) { t }
            else { 0 };
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return first_int(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            let v = first_int(pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1,
                pcx);
            if v != 0 {
                return v;
            }
        }
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            let v = first_int(pcx.tlists[(at + i) as usize], depth + 1, pcx);
            if v != 0 {
                return v;
            }
        }
    }
    0
}

// Whether type t is or holds a type variable still free that is not an
// integer variable (unify: the sweep its solution needs).
fn first_general(t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return if s != 0 { first_general(s, depth + 1, pcx) } else { !is_int_var(t, pcx) };
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized
        || k == TyKind::Distinct || k == TyKind::Vector {
        return first_general(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            if first_general(pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1,
                pcx) {
                return true;
            }
        }
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if first_general(pcx.tlists[(at + i) as usize], depth + 1, pcx) {
                return true;
            }
        }
    }
    if k == TyKind::Fn {
        if first_general(pcx.types[t as usize].a, depth + 1, pcx) {
            return true;
        }
        for i in 0..pcx.types[t as usize].count {
            if first_general(pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1,
                pcx) {
                return true;
            }
        }
    }
    false
}

// Type t with free integer variable v read as integer type c (a trial: v
// stays free).
fn with_solution(t: i64, v: i64, c: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if t == v {
        return c;
    }
    let node = pcx.types[v as usize].b;
    pcx.nodes[node as usize].y = c;
    let r = subst(t, 0, pcx);
    pcx.nodes[node as usize].y = 0;
    r
}

// RULE: F18.5 (0.30.2: calls synth_method) The integer type a method
// `name` called on a value of a free integer variable's type is taken
// from: the one integer type that has it, as rustc's probe finds its one
// candidate (`a.hi()` with `impl Tr for i64` alone); else the fallback,
// i32 (FL6: a method several integer types share closes the variable).
pub fn int_method_type(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut found: i64 = 0;
    for k in 0..10 {
        let t = INT_TYPES[k as usize];
        if crate::front::check::calls::method_of(t, name, pcx) >= 0 {
            if found != 0 {
                return crate::front::types::TY_I32;
            }
            found = t;
        }
    }
    if found != 0 { found } else { crate::front::types::TY_I32 }
}

// Whether type t is one an integer variable may take: a primitive integer
// type, not `char`.
fn int_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    crate::front::types::is_integer(t) && t != pcx.char_type
}

// Whether type t, with the solutions so far, is an integer type or a free
// integer variable: an operand integer arithmetic takes.
pub fn int_like(t: i64, pcx: &Ctx<Comp>) -> bool {
    int_type(t, pcx) || int_free(t, pcx)
}

// (sweep, remap_patterns, remake_calls) The nodes the end of a function's
// check retypes: those the parser made for it, [lo, pe) (from its item's
// node to the first node of source after it), the nodes of its tree made
// after them (by the checks of other functions before it: moved, desugared,
// [extras]), and those made since its check began, [infer_nodes, len).
// (0.30.2: not every node from its tree's first on, a range that held every
// node made between a function's parse and its check: with integer
// literals' variables nearly every function's check goes live, and that
// range made the check quadratic.)
struct Swept<A: Allocator> {
    lo: i64,
    pe: i64,
    extras: Vec<i64, A>,
}

impl Swept<Comp> {
    fn count(&self, pcx: &Ctx<Comp>) -> i64 {
        (self.pe - self.lo) + self.extras.len() as i64 + (pcx.nodes.len() as i64 - pcx.infer_nodes)
    }

    fn at(&self, k: i64, pcx: &Ctx<Comp>) -> i64 {
        if k < self.pe - self.lo {
            return self.lo + k;
        }
        let e = k - (self.pe - self.lo);
        if e < self.extras.len() as i64 {
            return self.extras[e as usize];
        }
        pcx.infer_nodes + e - self.extras.len() as i64
    }
}

fn swept(pcx: &Ctx<Comp>) -> Swept<Comp> {
    let mut s = Swept { lo: 0, pe: 0, extras: Vec::new_in(Comp {}) };
    if pcx.cur_fn < 0 {
        return s;
    }
    let item = pcx.fns[pcx.cur_fn as usize].node;
    if item <= 0 || item >= pcx.infer_nodes {
        return s;
    }
    // (the parser makes an item's node first, then the nodes of its source
    // in order: they end at the first node of source past the item's)
    let is = pcx.nodes[item as usize].start;
    let ie = pcx.nodes[item as usize].end;
    let mut pe = item + 1;
    while pe < pcx.infer_nodes && pcx.nodes[pe as usize].start <= ie
        && pcx.nodes[pe as usize].start >= is {
        pe += 1;
    }
    s.lo = item;
    s.pe = pe;
    let mut extras: Vec<i64, Comp> = Vec::new_in(Comp {});
    tree_extras(item, item, pe, 0, &mut extras, pcx);
    s.extras = extras;
    s
}

// The nodes of the tree at n outside [lo, pe) made before the function's
// check began, pushed to out (the walk of instantiate's node fields).
fn tree_extras(n: i64, lo: i64, pe: i64, depth: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    if n <= 0 || depth > 4096 {
        return;
    }
    if (n < lo || n >= pe) && n < pcx.infer_nodes {
        out.push(n);
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Fn {
        tree_extras(pcx.nodes[n as usize].b, lo, pe, depth + 1, out, pcx);
        tree_extras(pcx.nodes[n as usize].c, lo, pe, depth + 1, out, pcx);
    } else {
        if crate::front::generics::instantiate::node_field_a(k) {
            tree_extras(pcx.nodes[n as usize].a, lo, pe, depth + 1, out, pcx);
        }
        if crate::front::generics::instantiate::node_field_b(k) {
            tree_extras(pcx.nodes[n as usize].b, lo, pe, depth + 1, out, pcx);
        }
        if crate::front::generics::instantiate::node_field_c(k) {
            tree_extras(pcx.nodes[n as usize].c, lo, pe, depth + 1, out, pcx);
        }
    }
    for i in 0..pcx.nodes[n as usize].count {
        tree_extras(child(n, i, pcx), lo, pe, depth + 1, out, pcx);
    }
}

// Whether type t is or holds a variable (solved or not: `any`), or a free
// one.
pub fn mentions(t: i64, any: bool, pcx: &Ctx<Comp>) -> bool {
    mentions_at(t, any, 0, pcx)
}

fn mentions_at(t: i64, any: bool, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return any || s == 0 || mentions_at(s, any, depth + 1, pcx);
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return mentions_at(pcx.types[t as usize].a, any, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t as usize].count {
            if mentions_at(pcx.tlists[(pcx.types[t as usize].list + i) as usize], any, depth + 1,
                pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && mentions_at(pcx.types[t as usize].a, any, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if mentions_at(pcx.tlists[(at + i) as usize], any, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// A struct's or an enum's type arguments: their TLISTS start and count.
fn targs_of(t: i64, pcx: &Ctx<Comp>) -> (i64, i64) {
    if pcx.types[t as usize].kind == TyKind::Struct {
        return (pcx.structs[pcx.types[t as usize].a as usize].targs,
            pcx.structs[pcx.types[t as usize].a as usize].targ_count);
    }
    ((pcx.enums[pcx.types[t as usize].a as usize]).targs,
        (pcx.enums[pcx.types[t as usize].a as usize]).targ_count)
}

// An instance type's template (encoded as template_instance takes it), 0
// for a type that is not one.
fn template_of(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind == TyKind::Struct {
        return pcx.structs[pcx.types[t as usize].a as usize].tmpl;
    }
    -(pcx.enums[pcx.types[t as usize].a as usize]).tmpl
}

// RULE: F18.6 Type t with each solved variable replaced by its solution
// (t itself when it holds none).
pub fn resolve(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !pcx.infer_live || !mentions(t, true, pcx) {
        return t;
    }
    subst(t, 0, pcx)
}

fn subst(t: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return t;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return if s == 0 { t } else { subst(s, depth + 1, pcx) };
    }
    if !mentions(t, true, pcx) {
        return t;
    }
    let k = pcx.types[t as usize].kind;
    let a = pcx.types[t as usize].a;
    let b = pcx.types[t as usize].b;
    if k == TyKind::Ptr {
        // (a pointer of the same kind and constness: F30.5)
        let sa = subst(a, depth + 1, pcx);
        return crate::front::types::ptr_like(t, sa, pcx);
    }
    if k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        let sa = subst(a, depth + 1, pcx);
        return make_type(k, sa, b, pcx.tscratch.len() as i64, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        let list = pcx.types[t as usize].list;
        let count = pcx.types[t as usize].count;
        let sa = if k == TyKind::Fn { subst(a, depth + 1, pcx) } else { a };
        let parts: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut ps = parts;
        for i in 0..count {
            let e = pcx.tlists[(list + i) as usize];
            ps.push(subst(e, depth + 1, pcx));
        }
        let mark = pcx.tscratch.len() as i64;
        for i in 0..count {
            pcx.tscratch.push(ps[i as usize]);
        }
        return make_type(k, sa, b, mark, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let tpl = template_of(t, pcx);
        if tpl == 0 {
            return t;
        }
        let (at, n) = targs_of(t, pcx);
        let parts: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut ps = parts;
        // (the made instance's bounds are checked at the call or the `_`
        // that made its first variable, not at the file's start)
        let mut pos: i64 = 0;
        for i in 0..n {
            let e = pcx.tlists[(at + i) as usize];
            if pos == 0 && is_var(e, pcx) {
                pos = pcx.infer_recs[pcx.nodes[pcx.types[e as usize].b as usize].x as usize];
            }
            ps.push(subst(e, depth + 1, pcx));
        }
        let mark = pcx.tscratch.len() as i64;
        for i in 0..n {
            pcx.tscratch.push(ps[i as usize]);
        }
        return crate::front::generics::template_instance(tpl, mark, pos, pcx);
    }
    t
}

// RULE: F18.6 (a)-(c) Unifies a and b: a free variable on one side takes
// the other side's type there (not one that holds it). Whether the two are
// the same type after.
pub fn unify(a: i64, b: i64, pcx: &mut Ctx<Comp>) -> bool {
    let x = resolve(a, pcx);
    let y = resolve(b, pcx);
    // (0.30.2: the retyping of the function so far is for a type
    // variable's solution; an integer variable's alone waits for the
    // function's end, as each reader of one resolves it: an integer
    // literal's unify sweeping the function made its check quadratic)
    let general = first_general(x, 0, pcx) || first_general(y, 0, pcx);
    unify_at(x, y, 0, pcx);
    settle_deps(pcx);
    let s = resolve(x, pcx) == resolve(y, pcx);
    if s && general {
        sweep(pcx);
    }
    s
}

fn bind(v: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if occurs(v, t, 0, pcx) || t == pcx.ty_error || t <= 0 || t == crate::front::types::TY_NEVER {
        return false;
    }
    // RULE: F18.5 (0.30.2) An integer variable takes an integer type or
    // another integer variable; a type variable that meets one takes it.
    if is_int_var(v, pcx) {
        if is_var(t, pcx) && !is_int_var(t, pcx) {
            return bind(t, v, pcx);
        }
        if !is_var(t, pcx) && !int_type(t, pcx) {
            return false;
        }
    }
    { let at_ix = pcx.types[v as usize].b as usize; pcx.nodes[at_ix].y = t };
    true
}

fn occurs(v: i64, t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t == v {
        return true;
    }
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return s != 0 && occurs(v, s, depth + 1, pcx);
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return occurs(v, pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t as usize].count {
            if occurs(v, pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1, pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && occurs(v, pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if occurs(v, pcx.tlists[(at + i) as usize], depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

fn unify_at(a0: i64, b0: i64, depth: i64, pcx: &mut Ctx<Comp>) {
    let a = resolve(a0, pcx);
    let b = resolve(b0, pcx);
    if a == b || a <= 0 || b <= 0 || depth > 16 {
        return;
    }
    if is_var(a, pcx) {
        bind(a, b, pcx);
        return;
    }
    if is_var(b, pcx) {
        bind(b, a, pcx);
        return;
    }
    let k = pcx.types[a as usize].kind;
    if k != pcx.types[b as usize].kind {
        return;
    }
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        unify_at(pcx.types[a as usize].a, pcx.types[b as usize].a, depth + 1, pcx);
        return;
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        if pcx.types[a as usize].count != pcx.types[b as usize].count {
            return;
        }
        for i in 0..pcx.types[a as usize].count {
            unify_at(pcx.tlists[(pcx.types[a as usize].list + i) as usize],
                pcx.tlists[(pcx.types[b as usize].list + i) as usize], depth + 1, pcx);
        }
        if k == TyKind::Fn {
            unify_at(pcx.types[a as usize].a, pcx.types[b as usize].a, depth + 1, pcx);
        }
        return;
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let ta = template_of(a, pcx);
        if ta == 0 || ta != template_of(b, pcx) {
            return;
        }
        let (xa, n) = targs_of(a, pcx);
        let (xb, m) = targs_of(b, pcx);
        if n != m {
            return;
        }
        for i in 0..n {
            unify_at(pcx.tlists[(xa + i) as usize], pcx.tlists[(xb + i) as usize], depth + 1, pcx);
        }
    }
}

// RULE: F18.6 (solving retypes in place) The function's locals, the nodes
// of its tree and those made since its check began, and the signatures of
// the functions made since (its closures), with the solutions so far.
pub fn sweep(pcx: &mut Ctx<Comp>) {
    for l in pcx.infer_locals..pcx.locals.len() as i64 {
        let t = pcx.locals[l as usize].ty;
        if t > crate::front::types::TY_ISIZE && mentions(t, true, pcx) {
            let r = subst(t, 0, pcx);
            pcx.locals[l as usize].ty = r;
        }
    }
    let s = swept(pcx);
    for k in 0..s.count(pcx) {
        let n = s.at(k, pcx);
        let t = pcx.nodes[n as usize].ty;
        // (0.30: a primitive holds no variable; most nodes are of one)
        if t > crate::front::types::TY_ISIZE && mentions(t, true, pcx) {
            let r = subst(t, 0, pcx);
            pcx.nodes[n as usize].ty = r;
            remap_variant(n, r, pcx);
        }
    }
    crate::front::closures::resolve_sigs(pcx.infer_closures, pcx);
    for f in pcx.infer_fns..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].tmpl != 0 {
            continue;
        }
        if mentions(pcx.fns[f as usize].ret, true, pcx) {
            pcx.fns[f as usize].ret = subst(pcx.fns[f as usize].ret, 0, pcx);
        }
        for i in 0..pcx.fns[f as usize].param_count {
            let p = pcx.fns[f as usize].params + i;
            let t = pcx.tlists[p as usize];
            if mentions(t, true, pcx) {
                let r = subst(t, 0, pcx);
                pcx.tlists[p as usize] = r;
            }
        }
    }
}

// (synth_expr, check_expr, sweep) Node n's type t with the solutions so
// far; a variant's value names its variant of the enum instance it now has.
pub fn settle(n: i64, t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let r = resolve(t, pcx);
    if r != t {
        remap_variant(n, r, pcx);
    }
    r
}

fn remap_variant(n: i64, r: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].kind == NodeKind::VariantLit && r > 0
        && pcx.types[r as usize].kind == TyKind::Enum
        && pcx.nodes[n as usize].a >= 0 {
        let v = crate::front::types::find_variant(pcx.types[r as usize].a,
            pcx.variants[pcx.nodes[n as usize].a as usize].name, pcx);
        if v >= 0 {
            pcx.nodes[n as usize].a = v;
        }
    }
}

// (end) A variant pattern names its variant in x, of the enum it was
// checked against (check_variant_pattern); one checked against a variable's
// enum names it again in the solution's, once the function's check is done
// (the match's usefulness, checked before, read the ids it had).
fn remap_patterns(pcx: &mut Ctx<Comp>) {
    let s = swept(pcx);
    for k in 0..s.count(pcx) {
        let n = s.at(k, pcx);
        let r = pcx.nodes[n as usize].ty;
        if pcx.nodes[n as usize].kind == NodeKind::PatVariant && r > 0
            && pcx.types[r as usize].kind == TyKind::Enum
            && pcx.nodes[n as usize].x >= 0 {
            let v = crate::front::types::find_variant(pcx.types[r as usize].a,
                pcx.variants[pcx.nodes[n as usize].x as usize].name, pcx);
            if v >= 0 {
                pcx.nodes[n as usize].x = v;
            }
        }
    }
}

// Whether the type arguments TSCRATCH[mark..] hold a variable.
pub fn targs_mention(mark: i64, pcx: &Ctx<Comp>) -> bool {
    if !pcx.infer_live {
        return false;
    }
    for i in mark..pcx.tscratch.len() as i64 {
        if mentions(pcx.tscratch[i as usize], true, pcx) {
            return true;
        }
    }
    false
}

// Whether function f is an instance made with a variable (fn_instance did
// not queue it).
fn var_instance(f: i64, pcx: &Ctx<Comp>) -> bool {
    if f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f as usize].tmpl == 0 {
        return false;
    }
    for i in 0..pcx.fns[f as usize].targ_count {
        if mentions(pcx.tlists[(pcx.fns[f as usize].targs + i) as usize], true, pcx) {
            return true;
        }
    }
    false
}

// RULE: F18.6 (check_function) The function's check ends: a variable
// still free is its call's `type.infer`; the rest is retyped, and each call
// of an instance made with a variable calls the instance of the solutions.
pub fn end(m: InferMark, pcx: &mut Ctx<Comp>) {
    if pcx.infer_live {
        int_fallback(pcx);
        settle_deps(pcx);
        let mut r = pcx.infer_base;
        let mut seen: Vec<i64, Comp> = Vec::new_in(Comp {});
        while r < pcx.infer_recs.len() as i64 {
            if !named_before(r, &mut seen, pcx) {
                report_rec(r, pcx);
            }
            r += pcx.infer_recs[r as usize];
        }
        sweep(pcx);
        remap_patterns(pcx);
        remake_calls(pcx);
        // (an instance made with a variable is dead: its type arguments the
        // error type, as query mode's instances, which effects, the tools
        // and the instance lookups pass over; it was never queued)
        for f in pcx.infer_fns..pcx.fns.len() as i64 {
            if var_instance(f, pcx) {
                for i in 0..pcx.fns[f as usize].targ_count {
                    pcx.tlists[(pcx.fns[f as usize].targs + i) as usize] = pcx.ty_error;
                }
            }
        }
    }
    pcx.infer_recs.truncate(if pcx.infer_base >= 0 { pcx.infer_base } else { 0 } as usize);
    pcx.infer_deps.truncate(pcx.infer_dbase as usize);
    pcx.infer_base = m.base;
    pcx.infer_dbase = m.dbase;
    pcx.infer_live = m.live;
    pcx.infer_nodes = m.nodes;
    pcx.infer_locals = m.locals;
    pcx.infer_fns = m.fns;
    pcx.infer_closures = m.closures;
}

// RULE: F18.5 (0.30.2) The function's check ends: each integer variable
// still free is `i32`, rustc's fallback, decided here and nowhere before;
// then each unsuffixed literal typed through a variable is checked to fit
// the type it has (rustc's overflowing_literals, an error), and a
// negation typed through one to be of a signed type (rustc E0600).
fn int_fallback(pcx: &mut Ctx<Comp>) {
    // (an instance made with a variable: its bounds may give the variables
    // their types before the fallback, as check_bounds does for the others)
    for f in pcx.infer_fns..pcx.fns.len() as i64 {
        let tf = pcx.fns[f as usize].tmpl - 1;
        if tf < 0 || !var_instance(f, pcx) {
            continue;
        }
        crate::front::traits::int_bound_vars(f, tf, pcx);
    }
    if !bind_free_ints(pcx) {
        return;
    }
    // (a direct call's hole: its write made with the type its value has)
    let mut r = pcx.infer_base;
    while r < pcx.infer_recs.len() as i64 {
        let m = pcx.infer_recs[(r + 2) as usize];
        let shape = pcx.infer_recs[(r + 3) as usize];
        let t = resolve(pcx.infer_recs[(r + REC_HEAD) as usize], pcx);
        r += pcx.infer_recs[r as usize];
        if shape == SHAPE_HOLE {
            crate::front::check::interp::hole_retype(m, t, pcx);
        }
    }
    // (the variables that made again)
    bind_free_ints(pcx);
    // (a match on a value of a variable's type: its arms, on that type)
    r = pcx.infer_base;
    while r < pcx.infer_recs.len() as i64 {
        let m = pcx.infer_recs[(r + 2) as usize];
        let shape = pcx.infer_recs[(r + 3) as usize];
        let st = pcx.infer_recs[(r + REC_HEAD) as usize];
        let name = pcx.infer_recs[(r + 5) as usize];
        r += pcx.infer_recs[r as usize];
        // (on the type its patterns were checked against: its variables
        // read through their solutions, usefulness.vl column_type)
        if shape == SHAPE_MATCH {
            crate::front::patterns::usefulness::check_arms(m, st, pcx);
        }
        // (a trait's method called on a variable's value: the impl's of
        // the type it took, int_impls_all said every one has it)
        if shape == SHAPE_METHOD {
            let t = resolve(st, pcx);
            let mut tmpl = crate::front::check::calls::int_trait_fn(t, name, pcx);
            let f = pcx.nodes[m as usize].x - 1;
            // (the type taken implements the trait whose method was called,
            // else rustc's E0277 for `{integer}: Show` with the type it took)
            if f >= 0 && pcx.nodes[m as usize].kind == NodeKind::Call {
                let cf = if pcx.fns[f as usize].tmpl != 0 { pcx.fns[f as usize].tmpl - 1 }
                    else { f };
                let ci = crate::front::traits::impl_of_fn(cf, pcx);
                let ti = if tmpl >= 0 { crate::front::traits::impl_of_fn(tmpl, pcx) } else { -1 };
                if ci >= 0 && (ti < 0
                    || pcx.traits_impls[ti as usize].tr != pcx.traits_impls[ci as usize].tr) {
                    let tr = pcx.traits_impls[ci as usize].tr;
                    let saved = pcx.err_kind;
                    pcx.err_kind = c"type error";
                    crate::base::diag::err_begin(pcx.nodes[m as usize].start, pcx);
                    crate::base::diag::err_str(c"the trait '", pcx);
                    crate::base::diag::err_sym(pcx.traits[tr as usize].name, pcx);
                    crate::base::diag::err_str(c"' is not implemented for '", pcx);
                    crate::front::types::err_type(t, pcx);
                    crate::base::diag::err_str(c"' (rustc E0277)", pcx);
                    crate::base::diag::err_help(c"the integer literal's type is the one its uses give it, i32 when none does: write the type that implements the trait (`7i64`)", pcx);
                    crate::base::diag::err_end_soft(pcx);
                    pcx.err_kind = saved;
                    tmpl = -1;
                }
            }
            if tmpl >= 0 && f >= 0 && pcx.nodes[m as usize].kind == NodeKind::Call {
                // (a generic method's instance: t's with its arguments,
                // `hash::<DefaultHasher>`)
                let g = if pcx.fns[f as usize].tmpl == 0 { tmpl } else {
                    let mark = pcx.tscratch.len() as i64;
                    for i in 0..pcx.fns[f as usize].targ_count {
                        pcx.tscratch.push(pcx.tlists[(pcx.fns[f as usize].targs + i) as usize]);
                    }
                    crate::front::generics::instantiate::fn_instance(tmpl, mark, m, pcx)
                };
                pcx.nodes[m as usize].x = g + 1;
                crate::front::assoc::ensure_checked(g, m, pcx);
            }
        }
    }
    // (the records, not the nodes' types: a sweep retyped those)
    let mut negated: Vec<i64, Comp> = Vec::new_in(Comp {});
    r = pcx.infer_base;
    while r < pcx.infer_recs.len() as i64 {
        let n = pcx.infer_recs[(r + 2) as usize];
        let shape = pcx.infer_recs[(r + 3) as usize];
        let t = resolve(pcx.infer_recs[(r + REC_HEAD) as usize], pcx);
        r += pcx.infer_recs[r as usize];
        if shape != SHAPE_NEG {
            continue;
        }
        let x = pcx.nodes[n as usize];
        if crate::front::types::is_integer(t) && !crate::front::types::is_signed(t) {
            let saved = pcx.err_kind;
            pcx.err_kind = c"type error";
            crate::base::diag::err_begin(x.start, pcx);
            crate::base::diag::err_str(c"cannot apply unary operator '-' to type '", pcx);
            crate::front::types::err_type(t, pcx);
            crate::base::diag::err_str(c"' (rustc E0600)", pcx);
            crate::base::diag::err_help(c"an unsigned integer has no negative values: a signed type, or `0 - x` with its overflow check", pcx);
            crate::base::diag::err_end_soft(pcx);
            pcx.err_kind = saved;
        }
        let o = x.b;
        if o > 0 && pcx.nodes[o as usize].kind == NodeKind::Int
            && pcx.nodes[o as usize].b == crate::front::lexer::SUF_NONE {
            negated.push(o);
            literal_fits(o, true, t, pcx);
        }
    }
    r = pcx.infer_base;
    while r < pcx.infer_recs.len() as i64 {
        let n = pcx.infer_recs[(r + 2) as usize];
        let shape = pcx.infer_recs[(r + 3) as usize];
        let t = resolve(pcx.infer_recs[(r + REC_HEAD) as usize], pcx);
        r += pcx.infer_recs[r as usize];
        if shape == SHAPE_INT && n > 0 && pcx.nodes[n as usize].kind == NodeKind::Int
            && pcx.nodes[n as usize].b == crate::front::lexer::SUF_NONE && !negated.contains(&n) {
            literal_fits(n, false, t, pcx);
        }
    }
}

// Each integer variable of the function still free takes `i32`: whether
// the function made one.
fn bind_free_ints(pcx: &mut Ctx<Comp>) -> bool {
    let mut r = pcx.infer_base;
    let mut any = false;
    while r < pcx.infer_recs.len() as i64 {
        if pcx.infer_recs[(r + 3) as usize] == SHAPE_INT {
            any = true;
            let v = resolve(pcx.infer_recs[(r + REC_HEAD) as usize], pcx);
            if is_int_var(v, pcx) && solution(v, pcx) == 0 {
                bind(v, crate::front::types::TY_I32, pcx);
            }
        }
        r += pcx.infer_recs[r as usize];
    }
    any
}

// Literal n's value, negated or not, where integer type t goes: an error
// (soft) when it does not fit.
pub fn literal_fits(n: i64, negated: bool, t: i64, pcx: &mut Ctx<Comp>) {
    if !crate::front::types::is_integer(t) {
        return;
    }
    let value = pcx.nodes[n as usize].a as u64;
    let magnitude: u64 = if negated && value > 0 && crate::front::types::is_signed(t) { value - 1 }
        else { value };
    if magnitude > crate::front::types::int_max(t) {
        let saved = pcx.err_kind;
        pcx.err_kind = c"type error";
        crate::base::diag::err_begin(pcx.nodes[n as usize].start, pcx);
        crate::base::diag::err_str(if negated { c"integer literal -" } else { c"integer literal " },
            pcx);
        crate::base::buf_uint(pcx.err, value);
        crate::base::diag::err_str(c" does not fit in type '", pcx);
        crate::front::types::err_type(t, pcx);
        crate::base::diag::err_str(c"'", pcx);
        crate::front::check::check_mode::int_range_help(t, pcx);
        crate::base::diag::err_end_soft(pcx);
        pcx.err_kind = saved;
    }
}

// Each Call node of the sweep's range whose callee is an instance made with
// a variable now solved calls the instance of the solutions.
fn remake_calls(pcx: &mut Ctx<Comp>) {
    let s = swept(pcx);
    for k in 0..s.count(pcx) {
        let n = s.at(k, pcx);
        if pcx.nodes[n as usize].kind != NodeKind::Call || pcx.nodes[n as usize].x <= 0 {
            continue;
        }
        let f = pcx.nodes[n as usize].x - 1;
        if !var_instance(f, pcx) {
            continue;
        }
        let mark = pcx.tscratch.len() as i64;
        let mut free = false;
        for i in 0..pcx.fns[f as usize].targ_count {
            let t = subst(pcx.tlists[(pcx.fns[f as usize].targs + i) as usize], 0, pcx);
            if mentions(t, false, pcx) {
                free = true;
            }
            pcx.tscratch.push(t);
        }
        if free {
            pcx.tscratch.truncate(mark as usize);
            continue;
        }
        let g = crate::front::generics::instantiate::fn_instance(pcx.fns[f as usize].tmpl - 1, mark,
            n, pcx);
        pcx.nodes[n as usize].x = g + 1;
    }
}

// RULE: F18.6 (a method call or a field on a bare variable) The type is not
// known: the `type.infer` of the call that made variable v.
pub fn unknown_error(v: i64, pcx: &mut Ctx<Comp>) -> ! {
    report_rec(pcx.nodes[pcx.types[v as usize].b as usize].x - 1, pcx);
    crate::base::diag::err_jump(pcx)
}

// (end) Whether each variable record r leaves free is one an earlier
// record's error named: a `_` and the parameter it was bound to are one
// variable, one error (rustc's one E0282). The new ones join seen.
fn named_before(r: i64, seen: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let count = pcx.infer_recs[(r + 7) as usize];
    let mut any = false;
    let mut all = true;
    for i in 0..count {
        let v = first_free(resolve(pcx.infer_recs[(r + REC_HEAD + i) as usize], pcx), 0, pcx);
        if v > 0 {
            any = true;
            let mut found = false;
            for j in 0..seen.len() {
                if seen[j] == v {
                    found = true;
                }
            }
            if !found {
                all = false;
                seen.push(v);
            }
        }
    }
    any && all
}

// The `type.infer` of the call recorded at r (or of a `_` written in a
// type, shape -1) when one of its variables is still free; whether it was.
fn report_rec(r: i64, pcx: &mut Ctx<Comp>) -> bool {
    // (an integer variable's records, int_fallback's: none is a call's)
    if pcx.infer_recs[(r + 3) as usize] <= SHAPE_INT {
        return false;
    }
    let count = pcx.infer_recs[(r + 7) as usize];
    let mut free = false;
    for i in 0..count {
        if mentions(resolve(pcx.infer_recs[(r + REC_HEAD + i) as usize], pcx), false, pcx) {
            free = true;
        }
    }
    if !free {
        return false;
    }
    if pcx.infer_recs[(r + 3) as usize] == -1 {
        let saved = pcx.err_kind;
        pcx.err_kind = c"type.infer";
        crate::base::diag::err_begin(pcx.infer_recs[(r + 1) as usize], pcx);
        crate::base::diag::err_str(c"cannot infer the type written `_` here (rustc E0282)", pcx);
        crate::base::diag::err_help(c"nothing in the function says what it is: write the type",
            pcx);
        crate::base::diag::err_end_soft(pcx);
        pcx.err_kind = saved;
        return true;
    }
    let mut bound_room: Vec<i64, Comp> = Vec::new_in(Comp {});
    bound_room.resize((count) as usize, 0);
    let bound = bound_room.as_mut_slice();
    for i in 0..count {
        let t = resolve(pcx.infer_recs[(r + REC_HEAD + i) as usize], pcx);
        (bound[i as usize]) = if mentions(t, false, pcx) { 0 } else { t };
    }
    crate::front::generics::instantiate::report_unbound(pcx.infer_recs[(r + 6) as usize], bound,
        pcx.infer_recs[(r + 1) as usize], pcx.infer_recs[(r + 2) as usize],
        pcx.infer_recs[(r + 3) as usize], pcx.infer_recs[(r + 4) as usize],
        pcx.infer_recs[(r + 5) as usize], pcx);
    true
}

// RULE: F18.6 (resolve_type) `_` written in a type (`let f: FromFn<_> =
// ..`), TyName n: a fresh variable, its record shape -1.
pub fn hole(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    go_live(pcx);
    let rec = pcx.infer_recs.len() as i64;
    let v = fresh(n, rec, pcx);
    pcx.infer_recs.push(REC_HEAD + 1);
    pcx.infer_recs.push(pcx.nodes[n as usize].start);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(-1);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(1);
    pcx.infer_recs.push(v);
    v
}

// The function being checked makes its first variable: its end sweeps
// (swept: its tree's nodes and those made since).
fn go_live(pcx: &mut Ctx<Comp>) {
    pcx.infer_live = true;
}

// Whether type t is a variable still free.
pub fn is_free_var(t: i64, pcx: &Ctx<Comp>) -> bool {
    is_var(t, pcx) && solution(t, pcx) == 0
}

// RULE: F18.6 (a use that needs t's type, a format hole's trait) When t
// holds a free variable: the `type.infer` of the call that made it.
pub fn unknown_in(t: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.infer_live {
        return;
    }
    let v = first_free(resolve(t, pcx), 0, pcx);
    if v > 0 {
        unknown_error(v, pcx);
    }
}

fn first_free(t: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return 0;
    }
    // (0.30.2: an integer variable has its fallback, never this error)
    if is_free_var(t, pcx) {
        return if is_int_var(t, pcx) { 0 } else { t };
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return first_free(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            let v = first_free(pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1,
                pcx);
            if v > 0 {
                return v;
            }
        }
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            let v = first_free(pcx.tlists[(at + i) as usize], depth + 1, pcx);
            if v > 0 {
                return v;
            }
        }
    }
    0
}

// RULE: F18.6 (a capture by a closure) The closure whose captures are
// CAPS' pairs from `from` on is checked: a local it captures whose type
// holds a free variable is the `type.infer` of the call that made it.
pub fn captured(from: i64, pcx: &mut Ctx<Comp>) {
    let mut i = from;
    while i + 1 < pcx.caps.len() as i64 {
        let l = pcx.caps[i as usize];
        if l >= 0 && l < pcx.locals.len() as i64 {
            unknown_in(pcx.locals[l as usize].ty, pcx);
        }
        i += 2;
    }
}

// RULE: F18.6 (assoc::projection) `v::name` of a free variable v: a
// variable standing for it, solved when v is (settle_deps).
pub fn dependent(v: i64, name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut i = pcx.infer_dbase;
    while i + 3 < pcx.infer_deps.len() as i64 {
        if pcx.infer_deps[(i + 1) as usize] == v && pcx.infer_deps[(i + 2) as usize] == name {
            return pcx.infer_deps[i as usize];
        }
        i += 4;
    }
    let rec = pcx.nodes[pcx.types[v as usize].b as usize].x - 1;
    let d = fresh(pcx.types[v as usize].b, rec, pcx);
    pcx.infer_deps.push(d);
    pcx.infer_deps.push(v);
    pcx.infer_deps.push(name);
    pcx.infer_deps.push(pos);
    d
}

// Each variable standing for a projection whose variable is solved to a
// type with no free one takes the projection's type.
fn settle_deps(pcx: &mut Ctx<Comp>) {
    let mut changed = true;
    while changed {
        changed = false;
        let mut i = pcx.infer_dbase;
        while i + 3 < pcx.infer_deps.len() as i64 {
            let d = pcx.infer_deps[i as usize];
            let base = resolve(pcx.infer_deps[(i + 1) as usize], pcx);
            if is_free_var(d, pcx) && !mentions(base, false, pcx) {
                let t = crate::front::assoc::projection(base, pcx.infer_deps[(i + 2) as usize],
                    pcx.infer_deps[(i + 3) as usize], pcx);
                if t > 0 && t != pcx.ty_error && bind(d, t, pcx) {
                    changed = true;
                }
            }
            i += 4;
        }
    }
}
