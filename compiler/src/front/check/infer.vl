// (0.27.4) F18.6's type variables, FL1's deferred inference: in the rust
// edition a type parameter of a generic call, a variant or a struct
// literal that the call leaves free is a variable ?ᵢ (a distinct type over
// `()` whose TyName is flagged TY_INFER, its solution in its y, 0 while
// free), solved by the first check that unifies a type mentioning it with
// a definite type (check_mode: check_expr_inner). The function being
// checked keeps the records of the calls that made its variables
// (INFER_RECS from INFER_BASE): at its end a variable still free is the
// call's `type.infer`, and the nodes, locals and closure signatures that
// mention one are retyped, the instances made with one made again. No
// variable outlives the function: an instance made with one is never
// queued (no body check, no code, no effects) and is marked
// FN_QUERY_ONLY; its instance key holds a variable no later type equals.
// MVS makes none (can_defer), and every hook is behind INFER_LIVE.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, TY_OMEGA, TY_OPAQUE, child, new_node};
use crate::front::types::{TY_UNIT, TyKind, make_type};

// The TyName flag of a variable's node (with TY_OPAQUE and TY_OMEGA: an
// Ω without bounds, so no instance with one is lowered, D22.2).
pub const TY_INFER: i64 = 1 << 61;

// A record of INFER_RECS: its length, then the call's position, what it
// calls, the message's shape, outer and member (require_bound's), the
// Generics node, the parameter count, and the bound types (the variables
// at the free ones).
const REC_HEAD: i64 = 8;

// The state of the function being checked, saved around a nested check.
pub struct InferMark {
    base: i64,
    live: bool,
    nodes: i64,
    locals: i64,
    fns: i64,
    count: i64,
}

// (check_function) A function's check starts: its records from here on.
pub fn begin(pcx: inout Ctx<Comp>) -> InferMark {
    let m = save(pcx);
    pcx.infer_base = pcx.infer_recs.count;
    pcx.infer_live = false;
    pcx.infer_nodes = pcx.nodes.len() as i64;
    pcx.infer_locals = pcx.locals.len() as i64;
    pcx.infer_fns = pcx.fns.len() as i64;
    m
}

pub fn save(pcx: Ctx<Comp>) -> InferMark {
    InferMark {
        base: pcx.infer_base, live: pcx.infer_live, nodes: pcx.infer_nodes,
        locals: pcx.infer_locals, fns: pcx.infer_fns, count: pcx.infer_recs.count,
    }
}

// (check_function_recovering) The state before a check an error left.
pub fn restore(m: InferMark, pcx: inout Ctx<Comp>) {
    pcx.infer_recs.count = m.count;
    pcx.infer_base = m.base;
    pcx.infer_live = m.live;
    pcx.infer_nodes = m.nodes;
    pcx.infer_locals = m.locals;
    pcx.infer_fns = m.fns;
}

// Whether type t is a variable.
pub fn is_var(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t].kind == TyKind::Distinct && pcx.types[t].b > 0
        && pcx.nodes[pcx.types[t].b].kind == NodeKind::TyName
        && (pcx.nodes[pcx.types[t].b].p & TY_INFER) != 0
}

// Variable v's solution, 0 while free.
fn solution(v: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.nodes[pcx.types[v].b].y
}

// RULE: F18.6 Whether the call at pos may leave a parameter to a variable:
// a rust-edition call, in a function being checked.
pub fn can_defer(pos: i64, pcx: inout Ctx<Comp>) -> bool {
    pcx.infer_base >= 0 && pcx.edition != 0 && !pcx.check_unchecked && pcx.cur_fn >= 0
        && crate::front::rust::rust_at(pos, &pcx)
}

// RULE: F18.6 (require_bound) The free parameters of `params` (bound[i] ==
// 0) take fresh variables, and the call is recorded for its message.
pub fn make_vars(params: i64, bound: *i64, pos: i64, what: i64, shape: i64, outer: i64, member: i64,
    pcx: inout Ctx<Comp>) {
    // UNSAFE: bound is require_bound's raw array of the call's bound types.
    // SAFETY: it has one slot per parameter of `params` (count), as require_bound's caller allocated it; i < count.
    unsafe {
        let count = pcx.nodes[params].count;
        if !pcx.infer_live {
            pcx.infer_live = true;
            // (the sweep's nodes: the function's tree, and those made since)
            let item = pcx.fns[pcx.cur_fn].node;
            let lo = tree_min(item, item, 0, pcx);
            if lo < pcx.infer_nodes {
                pcx.infer_nodes = lo;
            }
        }
        let rec = pcx.infer_recs.count;
        for i in 0..count {
            if bound[i] == 0 {
                bound[i] = fresh(child(params, i, pcx), rec, &pcx);
            }
        }
        pcx.infer_recs.push(REC_HEAD + count);
        pcx.infer_recs.push(pos);
        pcx.infer_recs.push(what);
        pcx.infer_recs.push(shape);
        pcx.infer_recs.push(outer);
        pcx.infer_recs.push(member);
        pcx.infer_recs.push(params);
        pcx.infer_recs.push(count);
        for i in 0..count {
            pcx.infer_recs.push(bound[i]);
        }
    }
}

// A fresh variable for parameter `param` of the call recorded at rec.
fn fresh(param: i64, rec: i64, pcx: inout Ctx<Comp>) -> i64 {
    let node = new_node(NodeKind::TyName, pcx.nodes[param].start, pcx.nodes[param].end, &pcx);
    pcx.nodes[node].a = pcx.underscore;
    pcx.nodes[node].p |= TY_OPAQUE | TY_OMEGA | TY_INFER;
    pcx.nodes[node].x = rec + 1;
    pcx.any_distinct = true;
    let t = make_type(TyKind::Distinct, TY_UNIT, node, pcx.tscratch.count, &pcx);
    pcx.nodes[node].z = t;
    t
}

// The smallest node index of the tree at n (from `low`).
fn tree_min(n: i64, low: i64, depth: i64, pcx: Ctx<Comp>) -> i64 {
    if n <= 0 || depth > 4096 {
        return low;
    }
    var m = if n < low { n } else { low };
    let k = pcx.nodes[n].kind;
    if k == NodeKind::Fn {
        m = tree_min(pcx.nodes[n].b, m, depth + 1, pcx);
        m = tree_min(pcx.nodes[n].c, m, depth + 1, pcx);
    } else {
        if crate::front::generics::instantiate::node_field_a(k) {
            m = tree_min(pcx.nodes[n].a, m, depth + 1, pcx);
        }
        if crate::front::generics::instantiate::node_field_b(k) {
            m = tree_min(pcx.nodes[n].b, m, depth + 1, pcx);
        }
        if crate::front::generics::instantiate::node_field_c(k) {
            m = tree_min(pcx.nodes[n].c, m, depth + 1, pcx);
        }
    }
    for i in 0..pcx.nodes[n].count {
        m = tree_min(child(n, i, pcx), m, depth + 1, pcx);
    }
    m
}

// Whether type t is or holds a variable (solved or not: `any`), or a free
// one.
pub fn mentions(t: i64, any: bool, pcx: Ctx<Comp>) -> bool {
    mentions_at(t, any, 0, pcx)
}

fn mentions_at(t: i64, any: bool, depth: i64, pcx: Ctx<Comp>) -> bool {
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return any || s == 0 || mentions_at(s, any, depth + 1, pcx);
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return mentions_at(pcx.types[t].a, any, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t].count {
            if mentions_at(pcx.tlists.get(pcx.types[t].list + i), any, depth + 1, pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && mentions_at(pcx.types[t].a, any, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if mentions_at(pcx.tlists.get(at + i), any, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// A struct's or an enum's type arguments: their TLISTS start and count.
fn targs_of(t: i64, pcx: Ctx<Comp>) -> (i64, i64) {
    if pcx.types[t].kind == TyKind::Struct {
        return (pcx.structs[pcx.types[t].a].targs, pcx.structs[pcx.types[t].a].targ_count);
    }
    // UNSAFE: ENUMS is the checker's static table of enums (front/types.vl).
    // SAFETY: t is an Enum type, so its a indexes ENUMS; read only.
    unsafe {
        (crate::front::types::ENUMS[pcx.types[t].a].targs,
            crate::front::types::ENUMS[pcx.types[t].a].targ_count)
    }
}

// An instance type's template (encoded as template_instance takes it), 0
// for a type that is not one.
fn template_of(t: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.types[t].kind == TyKind::Struct {
        return pcx.structs[pcx.types[t].a].tmpl;
    }
    // UNSAFE: as targs_of's.
    // SAFETY: as targs_of's.
    unsafe { -crate::front::types::ENUMS[pcx.types[t].a].tmpl }
}

// RULE: F18.6 Type t with each solved variable replaced by its solution
// (t itself when it holds none).
pub fn resolve(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    if !pcx.infer_live || !mentions(t, true, pcx) {
        return t;
    }
    subst(t, 0, &pcx)
}

fn subst(t: i64, depth: i64, pcx: inout Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return t;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return if s == 0 { t } else { subst(s, depth + 1, &pcx) };
    }
    if !mentions(t, true, pcx) {
        return t;
    }
    let k = pcx.types[t].kind;
    let a = pcx.types[t].a;
    let b = pcx.types[t].b;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        let sa = subst(a, depth + 1, &pcx);
        return make_type(k, sa, b, pcx.tscratch.count, &pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        let list = pcx.types[t].list;
        let count = pcx.types[t].count;
        let sa = if k == TyKind::Fn { subst(a, depth + 1, &pcx) } else { a };
        let parts = crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var ps = parts;
        for i in 0..count {
            let e = pcx.tlists.get(list + i);
            ps.push(subst(e, depth + 1, &pcx));
        }
        let mark = pcx.tscratch.count;
        for i in 0..count {
            pcx.tscratch.push(ps.get(i));
        }
        return make_type(k, sa, b, mark, &pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let tpl = template_of(t, pcx);
        if tpl == 0 {
            return t;
        }
        let (at, n) = targs_of(t, pcx);
        let parts = crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var ps = parts;
        for i in 0..n {
            let e = pcx.tlists.get(at + i);
            ps.push(subst(e, depth + 1, &pcx));
        }
        let mark = pcx.tscratch.count;
        for i in 0..n {
            pcx.tscratch.push(ps.get(i));
        }
        return crate::front::generics::template_instance(tpl, mark, 0, &pcx);
    }
    t
}

// RULE: F18.6 (a)-(c) Unifies a and b: a free variable on one side takes
// the other side's type there (not one that holds it). Whether the two are
// the same type after.
pub fn unify(a: i64, b: i64, pcx: inout Ctx<Comp>) -> bool {
    let x = resolve(a, &pcx);
    let y = resolve(b, &pcx);
    unify_at(x, y, 0, &pcx);
    let s = resolve(x, &pcx) == resolve(y, &pcx);
    if s {
        sweep(&pcx);
    }
    s
}

fn bind(v: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if occurs(v, t, 0, pcx) || t == pcx.ty_error || t <= 0 || t == crate::front::types::TY_NEVER {
        return false;
    }
    pcx.nodes[pcx.types[v].b].y = t;
    true
}

fn occurs(v: i64, t: i64, depth: i64, pcx: Ctx<Comp>) -> bool {
    if t == v {
        return true;
    }
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return s != 0 && occurs(v, s, depth + 1, pcx);
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return occurs(v, pcx.types[t].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t].count {
            if occurs(v, pcx.tlists.get(pcx.types[t].list + i), depth + 1, pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && occurs(v, pcx.types[t].a, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if occurs(v, pcx.tlists.get(at + i), depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

fn unify_at(a0: i64, b0: i64, depth: i64, pcx: inout Ctx<Comp>) {
    let a = resolve(a0, &pcx);
    let b = resolve(b0, &pcx);
    if a == b || a <= 0 || b <= 0 || depth > 16 {
        return;
    }
    if is_var(a, pcx) {
        bind(a, b, &pcx);
        return;
    }
    if is_var(b, pcx) {
        bind(b, a, &pcx);
        return;
    }
    let k = pcx.types[a].kind;
    if k != pcx.types[b].kind {
        return;
    }
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        unify_at(pcx.types[a].a, pcx.types[b].a, depth + 1, &pcx);
        return;
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        if pcx.types[a].count != pcx.types[b].count {
            return;
        }
        for i in 0..pcx.types[a].count {
            unify_at(pcx.tlists.get(pcx.types[a].list + i), pcx.tlists.get(pcx.types[b].list + i),
                depth + 1, &pcx);
        }
        if k == TyKind::Fn {
            unify_at(pcx.types[a].a, pcx.types[b].a, depth + 1, &pcx);
        }
        return;
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let ta = template_of(a, pcx);
        if ta == 0 || ta != template_of(b, pcx) {
            return;
        }
        let (xa, n) = targs_of(a, pcx);
        let (xb, m) = targs_of(b, pcx);
        if n != m {
            return;
        }
        for i in 0..n {
            unify_at(pcx.tlists.get(xa + i), pcx.tlists.get(xb + i), depth + 1, &pcx);
        }
    }
}

// RULE: F18.6 (solving retypes in place) The function's locals, the nodes
// of its tree and those made since its check began, and the signatures of
// the functions made since (its closures), with the solutions so far.
pub fn sweep(pcx: inout Ctx<Comp>) {
    for l in pcx.infer_locals..pcx.locals.len() as i64 {
        let t = pcx.locals[l].ty;
        if t > 0 && mentions(t, true, pcx) {
            let r = subst(t, 0, &pcx);
            pcx.locals[l].ty = r;
            crate::front::own::fast::note_type(r, &pcx);
        }
    }
    for n in pcx.infer_nodes..pcx.nodes.len() as i64 {
        let t = pcx.nodes[n].ty;
        if t > 0 && mentions(t, true, pcx) {
            let r = subst(t, 0, &pcx);
            pcx.nodes[n].ty = r;
            remap_variant(n, r, &pcx);
            crate::front::own::fast::note_type(r, &pcx);
        }
    }
    for f in pcx.infer_fns..pcx.fns.len() as i64 {
        if pcx.fns[f].tmpl != 0 {
            continue;
        }
        if mentions(pcx.fns[f].ret, true, pcx) {
            pcx.fns[f].ret = subst(pcx.fns[f].ret, 0, &pcx);
        }
        for i in 0..pcx.fns[f].param_count {
            let p = pcx.fns[f].params + i;
            let t = pcx.tlists.get(p);
            if mentions(t, true, pcx) {
                let r = subst(t, 0, &pcx);
                pcx.tlists.set(p, r);
            }
        }
    }
}

// (synth_expr, check_expr, sweep) Node n's type t with the solutions so
// far; a variant's value names its variant of the enum instance it now has.
pub fn settle(n: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let r = resolve(t, &pcx);
    if r != t {
        remap_variant(n, r, &pcx);
    }
    r
}

fn remap_variant(n: i64, r: i64, pcx: inout Ctx<Comp>) {
    if pcx.nodes[n].kind == NodeKind::VariantLit && r > 0 && pcx.types[r].kind == TyKind::Enum
        && pcx.nodes[n].a >= 0 {
        let v = crate::front::types::find_variant(pcx.types[r].a,
            pcx.variants[pcx.nodes[n].a].name, pcx);
        if v >= 0 {
            pcx.nodes[n].a = v;
        }
    }
}

// Whether the type arguments TSCRATCH[mark..] hold a variable.
pub fn targs_mention(mark: i64, pcx: Ctx<Comp>) -> bool {
    if !pcx.infer_live {
        return false;
    }
    for i in mark..pcx.tscratch.count {
        if mentions(pcx.tscratch.get(i), true, pcx) {
            return true;
        }
    }
    false
}

// Whether function f is an instance made with a variable (fn_instance did
// not queue it).
fn var_instance(f: i64, pcx: Ctx<Comp>) -> bool {
    if f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f].tmpl == 0 {
        return false;
    }
    for i in 0..pcx.fns[f].targ_count {
        if mentions(pcx.tlists.get(pcx.fns[f].targs + i), true, pcx) {
            return true;
        }
    }
    false
}

// RULE: F18.6 (check_function) The function's check ends: a variable
// still free is its call's `type.infer`; the rest is retyped, and each call
// of an instance made with a variable calls the instance of the solutions.
pub fn end(m: InferMark, pcx: inout Ctx<Comp>) {
    if pcx.infer_live {
        // UNSAFE: report_unbound reads the bound types through a raw array, require_bound's.
        // SAFETY: bound has one slot per parameter of the record's Generics node (count), each written before it is read; freed once, after the call.
        unsafe {
            var r = pcx.infer_base;
            while r < pcx.infer_recs.count {
                let len = pcx.infer_recs.get(r);
                let count = pcx.infer_recs.get(r + 7);
                let bound = crate::base::alloc_array::<i64>(count);
                var free = false;
                for i in 0..count {
                    let t = resolve(pcx.infer_recs.get(r + REC_HEAD + i), &pcx);
                    if mentions(t, false, pcx) {
                        free = true;
                        bound[i] = 0;
                    } else {
                        bound[i] = t;
                    }
                }
                if free {
                    crate::front::generics::instantiate::report_unbound(
                        pcx.infer_recs.get(r + 6), bound, pcx.infer_recs.get(r + 1),
                        pcx.infer_recs.get(r + 2), pcx.infer_recs.get(r + 3),
                        pcx.infer_recs.get(r + 4), pcx.infer_recs.get(r + 5), &pcx);
                }
                crate::base::free(bound as *u8);
                r += len;
            }
        }
        sweep(&pcx);
        remake_calls(&pcx);
        // (an instance made with a variable is dead: its type arguments the
        // error type, as query mode's instances, which effects, the tools
        // and the instance lookups pass over; it was never queued)
        for f in pcx.infer_fns..pcx.fns.len() as i64 {
            if var_instance(f, pcx) {
                for i in 0..pcx.fns[f].targ_count {
                    pcx.tlists.set(pcx.fns[f].targs + i, pcx.ty_error);
                }
            }
        }
    }
    pcx.infer_recs.count = if pcx.infer_base >= 0 { pcx.infer_base } else { 0 };
    pcx.infer_base = m.base;
    pcx.infer_live = m.live;
    pcx.infer_nodes = m.nodes;
    pcx.infer_locals = m.locals;
    pcx.infer_fns = m.fns;
}

// Each Call node of the sweep's range whose callee is an instance made with
// a variable now solved calls the instance of the solutions.
fn remake_calls(pcx: inout Ctx<Comp>) {
    for n in pcx.infer_nodes..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Call || pcx.nodes[n].x <= 0 {
            continue;
        }
        let f = pcx.nodes[n].x - 1;
        if !var_instance(f, pcx) {
            continue;
        }
        let mark = pcx.tscratch.count;
        var free = false;
        for i in 0..pcx.fns[f].targ_count {
            let t = subst(pcx.tlists.get(pcx.fns[f].targs + i), 0, &pcx);
            if mentions(t, false, pcx) {
                free = true;
            }
            pcx.tscratch.push(t);
        }
        if free {
            pcx.tscratch.count = mark;
            continue;
        }
        let g = crate::front::generics::instantiate::fn_instance(pcx.fns[f].tmpl - 1, mark, n,
            &pcx);
        pcx.nodes[n].x = g + 1;
    }
}

// RULE: F18.6 (a method call or a field on a bare variable) The type is not
// known: the `type.infer` of the call that made variable v.
pub fn unknown_error(v: i64, pcx: inout Ctx<Comp>) -> ! {
    // UNSAFE: report_unbound reads the bound types through a raw array, require_bound's.
    // SAFETY: bound has one slot per parameter of the record's Generics node (count), each written before the call, freed after.
    unsafe {
        let r = pcx.nodes[pcx.types[v].b].x - 1;
        let count = pcx.infer_recs.get(r + 7);
        let bound = crate::base::alloc_array::<i64>(count);
        for i in 0..count {
            let t = resolve(pcx.infer_recs.get(r + REC_HEAD + i), &pcx);
            bound[i] = if mentions(t, false, pcx) { 0 } else { t };
        }
        crate::front::generics::instantiate::report_unbound(pcx.infer_recs.get(r + 6), bound,
            pcx.infer_recs.get(r + 1), pcx.infer_recs.get(r + 2), pcx.infer_recs.get(r + 3),
            pcx.infer_recs.get(r + 4), pcx.infer_recs.get(r + 5), &pcx);
        crate::base::diag::err_jump(&pcx)
    }
}

// Whether type t is a variable still free.
pub fn is_free_var(t: i64, pcx: Ctx<Comp>) -> bool {
    is_var(t, pcx) && solution(t, pcx) == 0
}

// RULE: F18.6 (a use that needs t's type, a format hole's trait) When t
// holds a free variable: the `type.infer` of the call that made it.
pub fn unknown_in(t: i64, pcx: inout Ctx<Comp>) {
    if !pcx.infer_live {
        return;
    }
    let v = first_free(resolve(t, &pcx), 0, pcx);
    if v > 0 {
        unknown_error(v, &pcx);
    }
}

fn first_free(t: i64, depth: i64, pcx: Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return 0;
    }
    if is_free_var(t, pcx) {
        return t;
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return first_free(pcx.types[t].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t].count {
            let v = first_free(pcx.tlists.get(pcx.types[t].list + i), depth + 1, pcx);
            if v > 0 {
                return v;
            }
        }
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            let v = first_free(pcx.tlists.get(at + i), depth + 1, pcx);
            if v > 0 {
                return v;
            }
        }
    }
    0
}

// RULE: F18.6 (a capture by a closure) The closure whose captures are
// CAPS' pairs from `from` on is checked: a local it captures whose type
// holds a free variable is the `type.infer` of the call that made it.
pub fn captured(from: i64, pcx: inout Ctx<Comp>) {
    var i = from;
    while i + 1 < pcx.caps.count {
        let l = pcx.caps.get(i);
        if l >= 0 && l < pcx.locals.len() as i64 {
            unknown_in(pcx.locals[l].ty, &pcx);
        }
        i += 2;
    }
}
