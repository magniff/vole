// (0.27.4) F18.6's type variables, FL1's deferred inference: in the rust
// edition a type parameter of a generic call, a variant or a struct
// literal that the call leaves free is a variable ?ᵢ (a distinct type over
// `()` whose TyName is flagged TY_INFER, its solution in its y, 0 while
// free), solved by the first check that unifies a type mentioning it with
// a definite type (check_mode: check_expr_inner). The function being
// checked keeps the records of the calls that made its variables
// (INFER_RECS from INFER_BASE): at its end a variable still free is the
// call's `type.infer`, and the nodes, locals and closure signatures that
// mention one are retyped, the instances made with one made again. No
// variable outlives the function: an instance made with one is never
// queued (no body check, no code, no effects) and is marked
// FN_QUERY_ONLY; its instance key holds a variable no later type equals.
// MVS makes none (can_defer), and every hook is behind INFER_LIVE.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, TY_OMEGA, TY_OPAQUE, child, new_node};
use crate::front::types::{TY_UNIT, TyKind, make_type};

// The TyName flag of a variable's node (with TY_OPAQUE and TY_OMEGA: an
// Ω without bounds, so no instance with one is lowered, D22.2).
pub const TY_INFER: i64 = 1 << 61;

// A record of INFER_RECS: its length, then the call's position, what it
// calls, the message's shape, outer and member (require_bound's), the
// Generics node, the parameter count, and the bound types (the variables
// at the free ones).
const REC_HEAD: i64 = 8;

// The state of the function being checked, saved around a nested check.
#[derive(Clone, Copy)] pub struct InferMark {
    base: i64,
    live: bool,
    nodes: i64,
    locals: i64,
    fns: i64,
    count: i64,
    dbase: i64,
    deps: i64,
    closures: i64,
}

// (check_function) A function's check starts: its records from here on.
pub fn begin(pcx: &mut Ctx<Comp>) -> InferMark {
    let m = save(pcx);
    pcx.infer_base = pcx.infer_recs.len() as i64;
    pcx.infer_dbase = pcx.infer_deps.len() as i64;
    pcx.infer_live = false;
    pcx.infer_nodes = pcx.nodes.len() as i64;
    pcx.infer_locals = pcx.locals.len() as i64;
    pcx.infer_fns = pcx.fns.len() as i64;
    pcx.infer_closures = pcx.closures.len() as i64;
    m
}

pub fn save(pcx: &Ctx<Comp>) -> InferMark {
    InferMark {
        base: pcx.infer_base, live: pcx.infer_live, nodes: pcx.infer_nodes,
        locals: pcx.infer_locals, fns: pcx.infer_fns, count: pcx.infer_recs.len() as i64,
        dbase: pcx.infer_dbase, deps: pcx.infer_deps.len() as i64, closures: pcx.infer_closures,
    }
}

// (check_function_recovering) The state before a check an error left.
pub fn restore(m: InferMark, pcx: &mut Ctx<Comp>) {
    pcx.infer_recs.truncate(m.count as usize);
    pcx.infer_deps.truncate(m.deps as usize);
    pcx.infer_base = m.base;
    pcx.infer_dbase = m.dbase;
    pcx.infer_live = m.live;
    pcx.infer_nodes = m.nodes;
    pcx.infer_locals = m.locals;
    pcx.infer_fns = m.fns;
    pcx.infer_closures = m.closures;
}

// Whether type t is a variable.
pub fn is_var(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Distinct && pcx.types[t as usize].b > 0
        && pcx.nodes[pcx.types[t as usize].b as usize].kind == NodeKind::TyName
        && (pcx.nodes[pcx.types[t as usize].b as usize].p & TY_INFER) != 0
}

// Variable v's solution, 0 while free.
fn solution(v: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.nodes[pcx.types[v as usize].b as usize].y
}

// RULE: F18.6 Whether the call at pos may leave a parameter to a variable:
// a rust-edition call, in a function being checked.
pub fn can_defer(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    pcx.infer_base >= 0 && !pcx.check_unchecked && pcx.cur_fn >= 0
}

// RULE: F18.6 (require_bound) The free parameters of `params` (bound[i] ==
// 0) take fresh variables, and the call is recorded for its message.
pub fn make_vars(params: i64, bound: &mut [i64], pos: i64, what: i64, shape: i64, outer: i64,
    member: i64, pcx: &mut Ctx<Comp>) {
    let count = pcx.nodes[params as usize].count;
    go_live(pcx);
    let rec = pcx.infer_recs.len() as i64;
    for i in 0..count {
        if (bound[i as usize]) == 0 {
            (bound[i as usize]) = fresh(child(params, i, pcx), rec, pcx);
        }
    }
    pcx.infer_recs.push(REC_HEAD + count);
    pcx.infer_recs.push(pos);
    pcx.infer_recs.push(what);
    pcx.infer_recs.push(shape);
    pcx.infer_recs.push(outer);
    pcx.infer_recs.push(member);
    pcx.infer_recs.push(params);
    pcx.infer_recs.push(count);
    for i in 0..count {
        pcx.infer_recs.push((bound[i as usize]));
    }
}

// A fresh variable for parameter `param` of the call recorded at rec.
fn fresh(param: i64, rec: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let node = new_node(NodeKind::TyName, pcx.nodes[param as usize].start,
        pcx.nodes[param as usize].end, pcx);
    pcx.nodes[node as usize].a = pcx.underscore;
    pcx.nodes[node as usize].p |= TY_OPAQUE | TY_OMEGA | TY_INFER;
    pcx.nodes[node as usize].x = rec + 1;
    pcx.any_distinct = true;
    let t = make_type(TyKind::Distinct, TY_UNIT, node, pcx.tscratch.len() as i64, pcx);
    pcx.nodes[node as usize].z = t;
    t
}

// The smallest node index of the tree at n (from `low`).
fn tree_min(n: i64, low: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 || depth > 4096 {
        return low;
    }
    let mut m = if n < low { n } else { low };
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Fn {
        m = tree_min(pcx.nodes[n as usize].b, m, depth + 1, pcx);
        m = tree_min(pcx.nodes[n as usize].c, m, depth + 1, pcx);
    } else {
        if crate::front::generics::instantiate::node_field_a(k) {
            m = tree_min(pcx.nodes[n as usize].a, m, depth + 1, pcx);
        }
        if crate::front::generics::instantiate::node_field_b(k) {
            m = tree_min(pcx.nodes[n as usize].b, m, depth + 1, pcx);
        }
        if crate::front::generics::instantiate::node_field_c(k) {
            m = tree_min(pcx.nodes[n as usize].c, m, depth + 1, pcx);
        }
    }
    for i in 0..pcx.nodes[n as usize].count {
        m = tree_min(child(n, i, pcx), m, depth + 1, pcx);
    }
    m
}

// Whether type t is or holds a variable (solved or not: `any`), or a free
// one.
pub fn mentions(t: i64, any: bool, pcx: &Ctx<Comp>) -> bool {
    mentions_at(t, any, 0, pcx)
}

fn mentions_at(t: i64, any: bool, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return any || s == 0 || mentions_at(s, any, depth + 1, pcx);
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return mentions_at(pcx.types[t as usize].a, any, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t as usize].count {
            if mentions_at(pcx.tlists[(pcx.types[t as usize].list + i) as usize], any, depth + 1,
                pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && mentions_at(pcx.types[t as usize].a, any, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if mentions_at(pcx.tlists[(at + i) as usize], any, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// A struct's or an enum's type arguments: their TLISTS start and count.
fn targs_of(t: i64, pcx: &Ctx<Comp>) -> (i64, i64) {
    if pcx.types[t as usize].kind == TyKind::Struct {
        return (pcx.structs[pcx.types[t as usize].a as usize].targs,
            pcx.structs[pcx.types[t as usize].a as usize].targ_count);
    }
    ((pcx.enums[pcx.types[t as usize].a as usize]).targs,
        (pcx.enums[pcx.types[t as usize].a as usize]).targ_count)
}

// An instance type's template (encoded as template_instance takes it), 0
// for a type that is not one.
fn template_of(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind == TyKind::Struct {
        return pcx.structs[pcx.types[t as usize].a as usize].tmpl;
    }
    -(pcx.enums[pcx.types[t as usize].a as usize]).tmpl
}

// RULE: F18.6 Type t with each solved variable replaced by its solution
// (t itself when it holds none).
pub fn resolve(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !pcx.infer_live || !mentions(t, true, pcx) {
        return t;
    }
    subst(t, 0, pcx)
}

fn subst(t: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return t;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return if s == 0 { t } else { subst(s, depth + 1, pcx) };
    }
    if !mentions(t, true, pcx) {
        return t;
    }
    let k = pcx.types[t as usize].kind;
    let a = pcx.types[t as usize].a;
    let b = pcx.types[t as usize].b;
    if k == TyKind::Ptr {
        // (a pointer of the same kind and constness: F30.5)
        let sa = subst(a, depth + 1, pcx);
        return crate::front::types::ptr_like(t, sa, pcx);
    }
    if k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        let sa = subst(a, depth + 1, pcx);
        return make_type(k, sa, b, pcx.tscratch.len() as i64, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        let list = pcx.types[t as usize].list;
        let count = pcx.types[t as usize].count;
        let sa = if k == TyKind::Fn { subst(a, depth + 1, pcx) } else { a };
        let parts: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut ps = parts;
        for i in 0..count {
            let e = pcx.tlists[(list + i) as usize];
            ps.push(subst(e, depth + 1, pcx));
        }
        let mark = pcx.tscratch.len() as i64;
        for i in 0..count {
            pcx.tscratch.push(ps[i as usize]);
        }
        return make_type(k, sa, b, mark, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let tpl = template_of(t, pcx);
        if tpl == 0 {
            return t;
        }
        let (at, n) = targs_of(t, pcx);
        let parts: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut ps = parts;
        // (the made instance's bounds are checked at the call or the `_`
        // that made its first variable, not at the file's start)
        let mut pos: i64 = 0;
        for i in 0..n {
            let e = pcx.tlists[(at + i) as usize];
            if pos == 0 && is_var(e, pcx) {
                pos = pcx.infer_recs[pcx.nodes[pcx.types[e as usize].b as usize].x as usize];
            }
            ps.push(subst(e, depth + 1, pcx));
        }
        let mark = pcx.tscratch.len() as i64;
        for i in 0..n {
            pcx.tscratch.push(ps[i as usize]);
        }
        return crate::front::generics::template_instance(tpl, mark, pos, pcx);
    }
    t
}

// RULE: F18.6 (a)-(c) Unifies a and b: a free variable on one side takes
// the other side's type there (not one that holds it). Whether the two are
// the same type after.
pub fn unify(a: i64, b: i64, pcx: &mut Ctx<Comp>) -> bool {
    let x = resolve(a, pcx);
    let y = resolve(b, pcx);
    unify_at(x, y, 0, pcx);
    settle_deps(pcx);
    let s = resolve(x, pcx) == resolve(y, pcx);
    if s {
        sweep(pcx);
    }
    s
}

fn bind(v: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if occurs(v, t, 0, pcx) || t == pcx.ty_error || t <= 0 || t == crate::front::types::TY_NEVER {
        return false;
    }
    { let at_ix = pcx.types[v as usize].b as usize; pcx.nodes[at_ix].y = t };
    true
}

fn occurs(v: i64, t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t == v {
        return true;
    }
    if t <= 0 || depth > 16 {
        return false;
    }
    if is_var(t, pcx) {
        let s = solution(t, pcx);
        return s != 0 && occurs(v, s, depth + 1, pcx);
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return occurs(v, pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        for i in 0..pcx.types[t as usize].count {
            if occurs(v, pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1, pcx) {
                return true;
            }
        }
        return k == TyKind::Fn && occurs(v, pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            if occurs(v, pcx.tlists[(at + i) as usize], depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

fn unify_at(a0: i64, b0: i64, depth: i64, pcx: &mut Ctx<Comp>) {
    let a = resolve(a0, pcx);
    let b = resolve(b0, pcx);
    if a == b || a <= 0 || b <= 0 || depth > 16 {
        return;
    }
    if is_var(a, pcx) {
        bind(a, b, pcx);
        return;
    }
    if is_var(b, pcx) {
        bind(b, a, pcx);
        return;
    }
    let k = pcx.types[a as usize].kind;
    if k != pcx.types[b as usize].kind {
        return;
    }
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        unify_at(pcx.types[a as usize].a, pcx.types[b as usize].a, depth + 1, pcx);
        return;
    }
    if k == TyKind::Tuple || k == TyKind::Fn {
        if pcx.types[a as usize].count != pcx.types[b as usize].count {
            return;
        }
        for i in 0..pcx.types[a as usize].count {
            unify_at(pcx.tlists[(pcx.types[a as usize].list + i) as usize],
                pcx.tlists[(pcx.types[b as usize].list + i) as usize], depth + 1, pcx);
        }
        if k == TyKind::Fn {
            unify_at(pcx.types[a as usize].a, pcx.types[b as usize].a, depth + 1, pcx);
        }
        return;
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let ta = template_of(a, pcx);
        if ta == 0 || ta != template_of(b, pcx) {
            return;
        }
        let (xa, n) = targs_of(a, pcx);
        let (xb, m) = targs_of(b, pcx);
        if n != m {
            return;
        }
        for i in 0..n {
            unify_at(pcx.tlists[(xa + i) as usize], pcx.tlists[(xb + i) as usize], depth + 1, pcx);
        }
    }
}

// RULE: F18.6 (solving retypes in place) The function's locals, the nodes
// of its tree and those made since its check began, and the signatures of
// the functions made since (its closures), with the solutions so far.
pub fn sweep(pcx: &mut Ctx<Comp>) {
    for l in pcx.infer_locals..pcx.locals.len() as i64 {
        let t = pcx.locals[l as usize].ty;
        if t > 0 && mentions(t, true, pcx) {
            let r = subst(t, 0, pcx);
            pcx.locals[l as usize].ty = r;
        }
    }
    for n in pcx.infer_nodes..pcx.nodes.len() as i64 {
        let t = pcx.nodes[n as usize].ty;
        if t > 0 && mentions(t, true, pcx) {
            let r = subst(t, 0, pcx);
            pcx.nodes[n as usize].ty = r;
            remap_variant(n, r, pcx);
        }
    }
    crate::front::closures::resolve_sigs(pcx.infer_closures, pcx);
    for f in pcx.infer_fns..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].tmpl != 0 {
            continue;
        }
        if mentions(pcx.fns[f as usize].ret, true, pcx) {
            pcx.fns[f as usize].ret = subst(pcx.fns[f as usize].ret, 0, pcx);
        }
        for i in 0..pcx.fns[f as usize].param_count {
            let p = pcx.fns[f as usize].params + i;
            let t = pcx.tlists[p as usize];
            if mentions(t, true, pcx) {
                let r = subst(t, 0, pcx);
                pcx.tlists[p as usize] = r;
            }
        }
    }
}

// (synth_expr, check_expr, sweep) Node n's type t with the solutions so
// far; a variant's value names its variant of the enum instance it now has.
pub fn settle(n: i64, t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let r = resolve(t, pcx);
    if r != t {
        remap_variant(n, r, pcx);
    }
    r
}

fn remap_variant(n: i64, r: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].kind == NodeKind::VariantLit && r > 0
        && pcx.types[r as usize].kind == TyKind::Enum
        && pcx.nodes[n as usize].a >= 0 {
        let v = crate::front::types::find_variant(pcx.types[r as usize].a,
            pcx.variants[pcx.nodes[n as usize].a as usize].name, pcx);
        if v >= 0 {
            pcx.nodes[n as usize].a = v;
        }
    }
}

// (end) A variant pattern names its variant in x, of the enum it was
// checked against (check_variant_pattern); one checked against a variable's
// enum names it again in the solution's, once the function's check is done
// (the match's usefulness, checked before, read the ids it had).
fn remap_patterns(pcx: &mut Ctx<Comp>) {
    for n in pcx.infer_nodes..pcx.nodes.len() as i64 {
        let r = pcx.nodes[n as usize].ty;
        if pcx.nodes[n as usize].kind == NodeKind::PatVariant && r > 0
            && pcx.types[r as usize].kind == TyKind::Enum
            && pcx.nodes[n as usize].x >= 0 {
            let v = crate::front::types::find_variant(pcx.types[r as usize].a,
                pcx.variants[pcx.nodes[n as usize].x as usize].name, pcx);
            if v >= 0 {
                pcx.nodes[n as usize].x = v;
            }
        }
    }
}

// Whether the type arguments TSCRATCH[mark..] hold a variable.
pub fn targs_mention(mark: i64, pcx: &Ctx<Comp>) -> bool {
    if !pcx.infer_live {
        return false;
    }
    for i in mark..pcx.tscratch.len() as i64 {
        if mentions(pcx.tscratch[i as usize], true, pcx) {
            return true;
        }
    }
    false
}

// Whether function f is an instance made with a variable (fn_instance did
// not queue it).
fn var_instance(f: i64, pcx: &Ctx<Comp>) -> bool {
    if f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f as usize].tmpl == 0 {
        return false;
    }
    for i in 0..pcx.fns[f as usize].targ_count {
        if mentions(pcx.tlists[(pcx.fns[f as usize].targs + i) as usize], true, pcx) {
            return true;
        }
    }
    false
}

// RULE: F18.6 (check_function) The function's check ends: a variable
// still free is its call's `type.infer`; the rest is retyped, and each call
// of an instance made with a variable calls the instance of the solutions.
pub fn end(m: InferMark, pcx: &mut Ctx<Comp>) {
    if pcx.infer_live {
        settle_deps(pcx);
        let mut r = pcx.infer_base;
        let mut seen: Vec<i64, Comp> = Vec::new_in(Comp {});
        while r < pcx.infer_recs.len() as i64 {
            if !named_before(r, &mut seen, pcx) {
                report_rec(r, pcx);
            }
            r += pcx.infer_recs[r as usize];
        }
        sweep(pcx);
        remap_patterns(pcx);
        remake_calls(pcx);
        // (an instance made with a variable is dead: its type arguments the
        // error type, as query mode's instances, which effects, the tools
        // and the instance lookups pass over; it was never queued)
        for f in pcx.infer_fns..pcx.fns.len() as i64 {
            if var_instance(f, pcx) {
                for i in 0..pcx.fns[f as usize].targ_count {
                    pcx.tlists[(pcx.fns[f as usize].targs + i) as usize] = pcx.ty_error;
                }
            }
        }
    }
    pcx.infer_recs.truncate(if pcx.infer_base >= 0 { pcx.infer_base } else { 0 } as usize);
    pcx.infer_deps.truncate(pcx.infer_dbase as usize);
    pcx.infer_base = m.base;
    pcx.infer_dbase = m.dbase;
    pcx.infer_live = m.live;
    pcx.infer_nodes = m.nodes;
    pcx.infer_locals = m.locals;
    pcx.infer_fns = m.fns;
    pcx.infer_closures = m.closures;
}

// Each Call node of the sweep's range whose callee is an instance made with
// a variable now solved calls the instance of the solutions.
fn remake_calls(pcx: &mut Ctx<Comp>) {
    for n in pcx.infer_nodes..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Call || pcx.nodes[n as usize].x <= 0 {
            continue;
        }
        let f = pcx.nodes[n as usize].x - 1;
        if !var_instance(f, pcx) {
            continue;
        }
        let mark = pcx.tscratch.len() as i64;
        let mut free = false;
        for i in 0..pcx.fns[f as usize].targ_count {
            let t = subst(pcx.tlists[(pcx.fns[f as usize].targs + i) as usize], 0, pcx);
            if mentions(t, false, pcx) {
                free = true;
            }
            pcx.tscratch.push(t);
        }
        if free {
            pcx.tscratch.truncate(mark as usize);
            continue;
        }
        let g = crate::front::generics::instantiate::fn_instance(pcx.fns[f as usize].tmpl - 1, mark,
            n, pcx);
        pcx.nodes[n as usize].x = g + 1;
    }
}

// RULE: F18.6 (a method call or a field on a bare variable) The type is not
// known: the `type.infer` of the call that made variable v.
pub fn unknown_error(v: i64, pcx: &mut Ctx<Comp>) -> ! {
    report_rec(pcx.nodes[pcx.types[v as usize].b as usize].x - 1, pcx);
    crate::base::diag::err_jump(pcx)
}

// (end) Whether each variable record r leaves free is one an earlier
// record's error named: a `_` and the parameter it was bound to are one
// variable, one error (rustc's one E0282). The new ones join seen.
fn named_before(r: i64, seen: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let count = pcx.infer_recs[(r + 7) as usize];
    let mut any = false;
    let mut all = true;
    for i in 0..count {
        let v = first_free(resolve(pcx.infer_recs[(r + REC_HEAD + i) as usize], pcx), 0, pcx);
        if v > 0 {
            any = true;
            let mut found = false;
            for j in 0..seen.len() {
                if seen[j] == v {
                    found = true;
                }
            }
            if !found {
                all = false;
                seen.push(v);
            }
        }
    }
    any && all
}

// The `type.infer` of the call recorded at r (or of a `_` written in a
// type, shape -1) when one of its variables is still free; whether it was.
fn report_rec(r: i64, pcx: &mut Ctx<Comp>) -> bool {
    let count = pcx.infer_recs[(r + 7) as usize];
    let mut free = false;
    for i in 0..count {
        if mentions(resolve(pcx.infer_recs[(r + REC_HEAD + i) as usize], pcx), false, pcx) {
            free = true;
        }
    }
    if !free {
        return false;
    }
    if pcx.infer_recs[(r + 3) as usize] == -1 {
        let saved = pcx.err_kind;
        pcx.err_kind = c"type.infer";
        crate::base::diag::err_begin(pcx.infer_recs[(r + 1) as usize], pcx);
        crate::base::diag::err_str(c"cannot infer the type written `_` here (rustc E0282)", pcx);
        crate::base::diag::err_help(c"nothing in the function says what it is: write the type",
            pcx);
        crate::base::diag::err_end_soft(pcx);
        pcx.err_kind = saved;
        return true;
    }
    let mut bound_room: Vec<i64, Comp> = Vec::new_in(Comp {});
    bound_room.resize((count) as usize, 0);
    let bound = bound_room.as_mut_slice();
    for i in 0..count {
        let t = resolve(pcx.infer_recs[(r + REC_HEAD + i) as usize], pcx);
        (bound[i as usize]) = if mentions(t, false, pcx) { 0 } else { t };
    }
    crate::front::generics::instantiate::report_unbound(pcx.infer_recs[(r + 6) as usize], bound,
        pcx.infer_recs[(r + 1) as usize], pcx.infer_recs[(r + 2) as usize],
        pcx.infer_recs[(r + 3) as usize], pcx.infer_recs[(r + 4) as usize],
        pcx.infer_recs[(r + 5) as usize], pcx);
    true
}

// RULE: F18.6 (resolve_type) `_` written in a type (`let f: FromFn<_> =
// ..`), TyName n: a fresh variable, its record shape -1.
pub fn hole(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    go_live(pcx);
    let rec = pcx.infer_recs.len() as i64;
    let v = fresh(n, rec, pcx);
    pcx.infer_recs.push(REC_HEAD + 1);
    pcx.infer_recs.push(pcx.nodes[n as usize].start);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(-1);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(0);
    pcx.infer_recs.push(1);
    pcx.infer_recs.push(v);
    v
}

// The function being checked makes its first variable: the sweep's nodes
// are its tree's and those made since.
fn go_live(pcx: &mut Ctx<Comp>) {
    if !pcx.infer_live {
        pcx.infer_live = true;
        let item = pcx.fns[pcx.cur_fn as usize].node;
        let lo = tree_min(item, item, 0, pcx);
        if lo < pcx.infer_nodes {
            pcx.infer_nodes = lo;
        }
    }
}

// Whether type t is a variable still free.
pub fn is_free_var(t: i64, pcx: &Ctx<Comp>) -> bool {
    is_var(t, pcx) && solution(t, pcx) == 0
}

// RULE: F18.6 (a use that needs t's type, a format hole's trait) When t
// holds a free variable: the `type.infer` of the call that made it.
pub fn unknown_in(t: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.infer_live {
        return;
    }
    let v = first_free(resolve(t, pcx), 0, pcx);
    if v > 0 {
        unknown_error(v, pcx);
    }
}

fn first_free(t: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 || depth > 16 {
        return 0;
    }
    if is_free_var(t, pcx) {
        return t;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Unsized {
        return first_free(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            let v = first_free(pcx.tlists[(pcx.types[t as usize].list + i) as usize], depth + 1,
                pcx);
            if v > 0 {
                return v;
            }
        }
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = targs_of(t, pcx);
        for i in 0..n {
            let v = first_free(pcx.tlists[(at + i) as usize], depth + 1, pcx);
            if v > 0 {
                return v;
            }
        }
    }
    0
}

// RULE: F18.6 (a capture by a closure) The closure whose captures are
// CAPS' pairs from `from` on is checked: a local it captures whose type
// holds a free variable is the `type.infer` of the call that made it.
pub fn captured(from: i64, pcx: &mut Ctx<Comp>) {
    let mut i = from;
    while i + 1 < pcx.caps.len() as i64 {
        let l = pcx.caps[i as usize];
        if l >= 0 && l < pcx.locals.len() as i64 {
            unknown_in(pcx.locals[l as usize].ty, pcx);
        }
        i += 2;
    }
}

// RULE: F18.6 (assoc::projection) `v::name` of a free variable v: a
// variable standing for it, solved when v is (settle_deps).
pub fn dependent(v: i64, name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut i = pcx.infer_dbase;
    while i + 3 < pcx.infer_deps.len() as i64 {
        if pcx.infer_deps[(i + 1) as usize] == v && pcx.infer_deps[(i + 2) as usize] == name {
            return pcx.infer_deps[i as usize];
        }
        i += 4;
    }
    let rec = pcx.nodes[pcx.types[v as usize].b as usize].x - 1;
    let d = fresh(pcx.types[v as usize].b, rec, pcx);
    pcx.infer_deps.push(d);
    pcx.infer_deps.push(v);
    pcx.infer_deps.push(name);
    pcx.infer_deps.push(pos);
    d
}

// Each variable standing for a projection whose variable is solved to a
// type with no free one takes the projection's type.
fn settle_deps(pcx: &mut Ctx<Comp>) {
    let mut changed = true;
    while changed {
        changed = false;
        let mut i = pcx.infer_dbase;
        while i + 3 < pcx.infer_deps.len() as i64 {
            let d = pcx.infer_deps[i as usize];
            let base = resolve(pcx.infer_deps[(i + 1) as usize], pcx);
            if is_free_var(d, pcx) && !mentions(base, false, pcx) {
                let t = crate::front::assoc::projection(base, pcx.infer_deps[(i + 2) as usize],
                    pcx.infer_deps[(i + 3) as usize], pcx);
                if t > 0 && t != pcx.ty_error && bind(d, t, pcx) {
                    changed = true;
                }
            }
            i += 4;
        }
    }
}
