// Unsafe code (0.9): the operations that need it, borrows, and the units
// --fix-unsafe wraps.
//
// Safe code has no undefined behaviour; the operations that can have it
// are allowed in unsafe code only: inside `unsafe { ... }` and in the body
// of an `unsafe fn` (UNSAFE_DEPTH > 0). They are dereferencing, indexing
// and slicing a raw pointer, casting an integer (other than the literal 0)
// to a pointer, calling C (an `extern "C"` declaration or function
// pointer), calling an `unsafe fn`, and reading a union's field.
//
// A *borrow* is a pointer known to point to live memory of its type: `&p`
// for a place p, or a reference (`&T`, `&mut T`: a parameter, `self`
// included, a local, a field, a result). Dereferencing a borrow (`*b`,
// `b.f`, a method through it) is safe; any other pointer is raw, a `*T`
// parameter too (0.18.1, V4: through 0.18.0 one not `mut` was a borrow,
// the legacy `&mut T`); dereferencing one through a `*T` parameter says
// to make it a reference (`fix --values`). The types keep a raw pointer
// from a reference parameter, so passing a pointer is always safe.
//
// An unsafe operation outside unsafe code is an error (`error[unsafe]`;
// a warning in 0.9). `--fix-unsafe` wraps them in unsafe blocks
// (fixunsafe.vl).

use crate::base::{SRC, buf_fmt, buf_new, buf_slice, cstr, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end_soft, err_fix, err_fmt, err_help_fmt, err_str, err_try_fmt, err_try_tool,
    error_keyed, report_error_once,
};
use crate::front::ast::{FN_UNSAFE, NODE_REF, Node, NodeKind, child};
use crate::front::ast::NodeKind::{
    Call, Cast, FieldAccess, Ident, MethodCall, TupleField, TyName, TyPtr, TySlice, Unary,
};
use crate::front::check::Res;
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::generics::env_lookup;
use crate::front::lexer::Tok;
use crate::front::types::{TY_BOOL, TyKind, err_type, is_numeric, is_ref};
use crate::tools::fixunsafe::note_unsafe_site;

// Flag of an expression whose value is not read (a place written, or
// whose address is taken): a union's field may be written so.
pub const NODE_NO_READ: i64 = 256;

// The kinds of unsafe operations (a warning is reported once per position
// and kind).
pub const U_DEREF: i64 = 1;

pub const U_FIELD: i64 = 2;

pub const U_METHOD: i64 = 3;

pub const U_INDEX: i64 = 4;

pub const U_SLICE: i64 = 5;

pub const U_INT_PTR: i64 = 6;

pub const U_C_CALL: i64 = 7;

pub const U_UNSAFE_CALL: i64 = 8;

pub const U_UNION: i64 = 9;

pub const U_FN_VALUE: i64 = 11;

// Unsafe code at position pos (an unsafe block, the body of an `unsafe fn`)
// was checked: a site without operations has none (not an instance never
// made).
pub fn audit_checked(pos: i64, pcx: inout Ctx<Comp>) {
    if pcx.audit_unsafe {
        pcx.audit_checked.push(pos);
    }
}

fn audit_op(n: i64, key: i64, base: i64, callee: i64, pcx: inout Ctx<Comp>) {
    pcx.audit_ops.push(audit_node(n, pcx).start);
    pcx.audit_ops.push(key);
    pcx.audit_ops.push(callee);
    pcx.audit_ops.push(if base > 0 && held_in_static(base, pcx) { 1 } else { 0 });
}

// Node n (a copy), for the audit.
fn audit_node(n: i64, pcx: Ctx<Comp>) -> Node {
    pcx.nodes[n]
}

// Whether pointer expression e is a static, or a field of one
// (`NODES`, `TABLE.data`).
fn held_in_static(e: i64, pcx: Ctx<Comp>) -> bool {
    var x = audit_node(e, pcx);
    while x.kind == FieldAccess || x.kind == TupleField {
        x = audit_node(x.a, pcx);
    }
    x.kind == Ident && x.res == Res::Static
}

// Operation n, of kind `key`, needs unsafe code.
pub fn unsafe_op(n: i64, key: i64, message: *u8, pcx: inout Ctx<Comp>) {
    if pcx.audit_unsafe && pcx.unsafe_depth > 0 {
        let base = if key == U_INDEX || key == U_SLICE { audit_node(n, pcx).a } else { 0 };
        audit_op(n, key, base, pcx.audit_callee, &pcx);
    }
    // (0.25: a pointer made from an integer needs unsafe code in the
    // initializer of a constant or a static too; the fix wraps the cast,
    // which consteval reads through)
    if pcx.unsafe_depth > 0 || pcx.const_context && key != U_INT_PTR {
        return;
    }
    if pcx.fix_unsafe && (pcx.wrap_node != 0 || pcx.const_context) {
        note_unsafe_site(if pcx.const_context { n } else { pcx.wrap_node }, &pcx);
        return;
    }
    report_error_once(pcx.nodes[n].start, key, c"unsafe", message,
        c"put it in an `unsafe { ... }` block, or the function's body in an `unsafe fn` (the try: line wraps every such place)",
        "fix --only unsafe", &pcx);
}

// (0.18.1, V4) Whether expression e is a parameter written `p: *T` (not
// `mut`, not `self` of a method of C's): a raw pointer, which until 0.18.1
// was a borrow.
fn raw_param(e: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if pcx.nodes[e].kind != Ident || pcx.nodes[e].res != Res::Local || pcx.nodes[e].y < 0 {
            return false;
        }
        let local = pcx.nodes[e].y;
        let t = pcx.locals[local].ty;
        pcx.locals[local].is_param && !pcx.locals[local].mutable && t > 0
            && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == 0
    }
}

// Operation n, of kind `key`, through pointer `base` needs unsafe code.
// Through a `*T` parameter (V4) the help is the parameter's type: `&T`, or
// `&mut T` when written through, which `fix --values` writes with every
// call.
pub fn unsafe_through(n: i64, base: i64, key: i64, message: *u8, pcx: inout Ctx<Comp>) {
    if pcx.audit_unsafe && pcx.unsafe_depth > 0 {
        audit_op(n, key, base, -1, &pcx);
    }
    if pcx.unsafe_depth > 0 || pcx.const_context {
        return;
    }
    if (pcx.fix_unsafe && pcx.wrap_node != 0) || !raw_param(base, pcx) {
        unsafe_op(n, key, message, &pcx);
        return;
    }
    if error_keyed(pcx.nodes[n].start, key, &pcx) {
        return;
    }
    let p = SRC[pcx.nodes[base].start..pcx.nodes[base].end];
    let saved = pcx.err_kind;
    pcx.err_kind = c"unsafe";
    err_begin(pcx.nodes[n].start, &pcx);
    err_fmt(format_args("{}: `{p}` is a `*T` parameter", cstr(message)), pcx);
    err_help_fmt(format_args("a `*T` parameter is a raw pointer (0.18.1); a borrow is `&T`, or `&mut T` when written through: make `{p}` one (the first try: changes such parameters, with their calls), or put this in an `unsafe {{ ... }}` block (the second: what the first keeps raw, a pointer indexed, compared, cast, stored or given to C)"), pcx);
    err_try_tool("fix --values", true, pcx);
    err_try_tool("fix --only unsafe", true, pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// (0.17) `p[i]` (`p[a..b]`) on a raw pointer p to a Vec, a Buf or a slice
// (pointee), outside unsafe code. It indexes the one p points to, checked,
// as through a borrow; reading through a raw pointer is what is unsafe, so
// `fix --only unsafe` wraps it (its meaning is the same in `unsafe`). For a
// local `let p = &v;` the try: indexes v itself.
pub fn unsafe_view_index(n: i64, base: i64, index: i64, pointee: i64, slicing: bool,
    pcx: inout Ctx<Comp>) {
    if pcx.audit_unsafe && pcx.unsafe_depth > 0 {
        audit_op(n, if slicing { U_SLICE } else { U_INDEX }, base, -1, &pcx);
    }
    if pcx.unsafe_depth > 0 || pcx.const_context {
        return;
    }
    if pcx.fix_unsafe && pcx.wrap_node != 0 {
        note_unsafe_site(pcx.wrap_node, &pcx);
        return;
    }
    if !(pcx.fix_unsafe && pcx.wrap_node != 0) && raw_param(base, pcx) {
        // (c"..." to a `*u8` parameter: a raw pointer, through 0.18.0)
        if slicing {
            unsafe_through(n, base, U_SLICE, c"slicing through a raw pointer is unsafe", &pcx);
        } else {
            unsafe_through(n, base, U_INDEX, c"indexing through a raw pointer is unsafe", &pcx);
        }
        return;
    }
    unsafe {
        let key = if slicing { U_SLICE } else { U_INDEX };
        if error_keyed(pcx.nodes[n].start, key, &pcx) {
            return;
        }
        let saved = pcx.err_kind;
        pcx.err_kind = c"unsafe";
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(if slicing { c"slicing a '" } else { c"indexing a '" }, pcx);
        err_type(pointee, pcx);
        err_str(c"' through a raw pointer is unsafe", pcx);
        let p = if pcx.nodes[base].end
            > pcx.nodes[base].start { SRC[pcx.nodes[base].start..pcx.nodes[base].end] }
            else { "p" };
        var what = "a raw pointer";
        var place = 0;
        if pcx.nodes[base].kind == Ident && pcx.nodes[base].res == Res::Local
            && pcx.nodes[base].y >= 0 {
            let local = pcx.nodes[base].y;
            place = pcx.locals[local].init;
            what = if pcx.locals[local].is_param { "a `*T` parameter" } else { "a local" };
        } else if pcx.nodes[base].kind == Ident && pcx.nodes[base].res == Res::Static {
            what = "a static";
        } else if pcx.nodes[base].kind == FieldAccess {
            what = "a field";
        }
        if place != 0 && (pcx.nodes[place].kind == Ident || pcx.nodes[place].kind == FieldAccess)
            && pcx.nodes[place].end > pcx.nodes[place].start {
            // `let p = &v;`: v itself, the rest of the statement after it
            // when it is assigned on one line
            let v = SRC[pcx.nodes[place].start..pcx.nodes[place].end];
            err_help_fmt(
                format_args("`{p}` is {what} holding `&{v}`, a raw pointer, not a borrow; `{v}` itself is indexed safely"), pcx);
            var end = pcx.nodes[n].end;
            let assign = pcx.assigning;
            if assign != 0 && pcx.nodes[assign].b == n {
                end = pcx.nodes[assign].end;
                for c in SRC[pcx.nodes[n].end..end] {
                    if c == '\n' {
                        end = pcx.nodes[n].end;
                    }
                }
            }
            err_try_fmt(format_args("{v}{}", SRC[pcx.nodes[base].end..end]), pcx);
            let t = buf_new();
            buf_fmt(t, format_args("{v}"));
            err_fix(pcx.nodes[base].start, pcx.nodes[base].end, buf_slice(t), &pcx);
        } else {
            err_help_fmt(format_args("`{p}` is {what}, a raw pointer, not a borrow: `{p}[i]` indexes what it points to, checked, in an `unsafe {{ ... }}` block (the try: line wraps every such place)"), pcx);
            err_try_tool("fix --only unsafe", true, pcx);
        }
        err_end_soft(&pcx);
        pcx.err_kind = saved;
    }
}

// (0.17) `p[0]` on a pointer to anything but a Vec, a Buf or a slice,
// outside unsafe code: pointer arithmetic, where the value p points to,
// `*p`, was meant (eval iteration 10: `out[0] = acc` with `out: *i64` a
// parameter, which unsafe_op's try: wrapped in `unsafe`). Through a
// borrow `*p` is safe: the try: is the statement written with it (and
// `fix --suggested` makes it), or the read. Through a raw pointer `*p` is
// unsafe too: unsafe_op's error, its help naming `*p`.
pub fn unsafe_index_zero(n: i64, base: i64, pointee: i64, pcx: inout Ctx<Comp>) {
    if pcx.audit_unsafe && pcx.unsafe_depth > 0 {
        audit_op(n, U_INDEX, base, -1, &pcx);
    }
    if pcx.unsafe_depth > 0 || pcx.const_context {
        return;
    }
    if pcx.fix_unsafe && pcx.wrap_node != 0 {
        // `fix --only unsafe` makes the program check: it wraps `p[0]`,
        // which is `*p`'s value, so the code stays right
        note_unsafe_site(pcx.wrap_node, &pcx);
        return;
    }
    if !is_borrow(base, pcx) {
        report_error_once(pcx.nodes[n].start, U_INDEX, c"unsafe",
            c"indexing a raw pointer is unsafe",
            c"`p[0]` is pointer arithmetic; the value p points to is `*p` (`*p = x` writes it), unsafe as well through a raw pointer (not a borrow: a `*T` parameter, a local, a field), so put it in an `unsafe { ... }` block (the try: line wraps every such place)",
            "fix --only unsafe", &pcx);
        return;
    }
    if pcx.nodes[base].kind != Ident || pcx.nodes[base].end <= pcx.nodes[base].start {
        // `(&x)[0]`
        unsafe_op(n, U_INDEX, c"indexing a raw pointer is unsafe", &pcx);
        return;
    }
    if error_keyed(pcx.nodes[n].start, U_INDEX, &pcx) {
        return;
    }
    let b = SRC[pcx.nodes[base].start..pcx.nodes[base].end];
    let saved = pcx.err_kind;
    pcx.err_kind = c"unsafe";
    err_begin(pcx.nodes[n].start, &pcx);
    err_fmt(
        format_args(
            "indexing a pointer is unsafe pointer arithmetic; the value '{b}' points to is `*{b}`"), pcx);
    err_help_fmt(
        format_args("`{b}[0]` indexes memory from {b}, unchecked (a borrow is one value, not an array); `*{b}` reads and writes the value it points to, safely through a borrow (`&T`, `&mut T`, `&x`)"), pcx);
    let assign = pcx.assigning;
    if assign != 0 && pcx.nodes[assign].b == n {
        let rest = SRC[pcx.nodes[n].end..pcx.nodes[assign].end];
        var one_line = true;
        for c in rest {
            if c == '\n' {
                one_line = false;
            }
        }
        if one_line {
            err_try_fmt(format_args("*{b}{rest}"), pcx);
        } else {
            err_try_fmt(format_args("*{b}"), pcx);
        }
        let t = buf_new();
        buf_fmt(t, format_args("*{b}"));
        err_fix(pcx.nodes[n].start, pcx.nodes[n].end, buf_slice(t), &pcx);
    } else if is_numeric(pointee) || pointee == TY_BOOL {
        err_try_fmt(format_args("*{b}"), pcx);
    } else {
        err_try_fmt(format_args("(*{b})"), pcx);
    }
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// Checks expression e (synthesized when `expected` is 0) as a unit
// --fix-unsafe may wrap: a condition, a sequence, an arm's body.
pub fn check_wrapped(e: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    let saved = pcx.wrap_node;
    pcx.wrap_node = e;
    let ty = if expected != 0 { check_expr(e, expected, &pcx) } else { synth_expr(e, &pcx) };
    pcx.wrap_node = saved;
    ty
}

// Whether parameter node `param` is a borrow: a reference, `&T` or
// `&mut T` (0.18.1, V4: a `*T` parameter is raw, `mut` or not).
pub fn is_borrow_param(param: i64, pcx: Ctx<Comp>) -> bool {
    let t = pcx.nodes[param].b;
    t != 0 && pcx.nodes[t].kind == TyPtr && (pcx.nodes[t].p & NODE_REF) != 0
}

// Whether expression e (checked) is a borrow.
pub fn is_borrow(e: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let kind = pcx.nodes[e].kind;
        if kind == Unary && pcx.nodes[e].op == Tok::Amp {
            return true;
        }
        // (0.17) a reference: `let r = &x;`, a `&T` field or result
        if pcx.nodes[e].ty > 0 && is_ref(pcx.nodes[e].ty, pcx) {
            return true;
        }
        if kind == Ident && pcx.nodes[e].res == Res::Local && pcx.nodes[e].y >= 0 {
            return pcx.locals[pcx.nodes[e].y].borrow;
        }
        false
    }
}

// (0.17, decided 2026-10-16) What type node t, as written, makes of a
// type parameter: 1 for `*P`, 2 for `[P]`, 0 otherwise. P is one of the
// parameters of Generics node `params`, or, for `params` -1, one in scope.
pub fn written_param(t: i64, params: i64, pcx: Ctx<Comp>) -> i64 {
    if t == 0 || (pcx.nodes[t].kind != TyPtr && pcx.nodes[t].kind != TySlice) {
        return 0;
    }
    let inner = pcx.nodes[t].a;
    if inner == 0 || pcx.nodes[inner].kind != TyName || pcx.nodes[inner].g != 0
        || pcx.nodes[inner].count != 0 {
        return 0;
    }
    let name = pcx.nodes[inner].a;
    var found = false;
    if params < 0 {
        found = env_lookup(name, pcx) != 0;
    } else if params > 0 {
        for i in 0..pcx.nodes[params].count {
            if pcx.nodes[child(params, i, pcx)].a == name {
                found = true;
            }
        }
    }
    if !found {
        0
    } else if pcx.nodes[t].kind == TyPtr {
        1
    } else {
        2
    }
}

// (0.17, decided 2026-10-16) Whether pointer expression e (checked) points,
// as written, to a type parameter: a local or parameter `p: *T` (or one
// initialized from such an expression), a field declared `*T` in a generic
// struct, `x as *T`, the `ptr` of a local `s: [T]`. Then `p[i]` is pointer
// arithmetic for every T, a Vec's too: a generic body means one thing in
// every instance.
pub fn pointee_is_param(e: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let kind = pcx.nodes[e].kind;
        if kind == Ident && pcx.nodes[e].res == Res::Local && pcx.nodes[e].y >= 0 {
            return pcx.locals[pcx.nodes[e].y].twritten == 1;
        }
        if kind == Cast {
            return written_param(pcx.nodes[e].b, -1, pcx) == 1;
        }
        if (kind == Call || kind == MethodCall) && pcx.nodes[e].x > 0 {
            // a call: its function's result as declared, `-> *T` with T a
            // parameter of the function or of its impl
            let f = pcx.nodes[e].x - 1;
            let tf = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
            let item = pcx.fns[tf].node;
            return item > 0 && written_param(pcx.nodes[item].b, pcx.nodes[item].g, pcx) == 1;
        }
        if kind != FieldAccess {
            return false;
        }
        let base = pcx.nodes[e].a;
        var bt = pcx.nodes[base].ty;
        if bt <= 0 {
            return false;
        }
        if pcx.types[bt].kind == TyKind::Slice {
            return pcx.nodes[e].b == intern_c(c"ptr", &pcx) && pcx.nodes[base].kind == Ident
                && pcx.nodes[base].res == Res::Local && pcx.nodes[base].y >= 0
                && pcx.locals[pcx.nodes[base].y].twritten == 2;
        }
        if pcx.types[bt].kind == TyKind::Ptr {
            bt = pcx.types[bt].a;
        }
        if pcx.types[bt].kind != TyKind::Struct {
            return false;
        }
        let item = pcx.structs[pcx.types[bt].a].node;
        if item <= 0 || pcx.nodes[item].kind != NodeKind::Struct {
            return false;
        }
        for i in 0..pcx.nodes[item].count {
            let field = child(item, i, pcx);
            if pcx.nodes[field].a == pcx.nodes[e].b {
                return written_param(pcx.nodes[field].b, pcx.nodes[item].g, pcx) == 1;
            }
        }
        false
    }
}

// Marks the place `target` (a chain of fields) as not read.
pub fn mark_no_read(target: i64, pcx: inout Ctx<Comp>) {
    var e = target;
    while pcx.nodes[e].kind == FieldAccess || pcx.nodes[e].kind == TupleField {
        pcx.nodes[e].p |= NODE_NO_READ;
        e = pcx.nodes[e].a;
    }
}

// A direct call n of function f (its arguments in n's list, from `first`
// on for the ones written after a method's receiver): calling C or an
// `unsafe fn` is unsafe. (0.18.1, V4: a pointer parameter is a reference,
// whose arguments the types check, or raw, which takes any pointer.)
pub fn check_call_safety(n: i64, f: i64, first: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.audit_callee = f;
        if pcx.fns[f].is_extern {
            unsafe_op(n, U_C_CALL, c"calling a C function is unsafe", &pcx);
        } else if (pcx.fns[f].attrs & FN_UNSAFE) != 0 {
            unsafe_op(n, U_UNSAFE_CALL, c"calling an `unsafe fn` is unsafe", &pcx);
        }
        pcx.audit_callee = -1;
    }
}
