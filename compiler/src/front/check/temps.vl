// `&e` of a value that is no place (0.18.1): a temporary. Before a block
// is checked, each of its statements (and its tail) that takes `&f(x)`
// where nothing evaluated before it in the statement can tell the
// difference gets `let f(x) = f(x);` in front of it, and the `&` takes
// that local: the temporary lives to the end of the block (Rust's
// temporary lifetime extension, for `let r = &f(x);`), is dropped there,
// and the own pass checks it as any local (its name is the expression's
// text; a literal, `&P { x: 1 }`, is hoisted from anywhere). Where the
// order could differ (a call, an assignment or an index
// evaluated before it, a condition's other side, a closure), it stays an
// error with a `try:` (synth_unary). In a 0.20 file `&` of a value is
// conv.place.
//
// (0.25) A value given to a let parameter (`total(make())`) is no longer
// hoisted here: the checker lends it where it stands
// (check_mode::LET_ARG) and front/own/drops.vl makes it a temporary of
// the statement, conventions.md §2.2 "Temporaries".

use crate::base::{SRC, buf_bytes, buf_int, buf_new, buf_slice, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    NODE_CHECKED, NODE_REF_MUT, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::lexer::Tok;

// A flag of the Ident that names a temporary (on the `&`'s operand).
pub const NODE_TEMP: i64 = 1 << 52;

// Whether e, written after `&`, is a value rather than a place: what the
// checker would call a non-lvalue (a slice or a function's value is
// handled where it is typed: synth_unary).
fn is_value_expr(e: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Unary {
        return pcx.nodes[e].op != Tok::Star;
    }
    k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::StructLit
        || k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::Int
        || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Str
        || k == NodeKind::Bool || k == NodeKind::Binary || k == NodeKind::Cast
        || k == NodeKind::Try
}

// Whether evaluating e could be told apart from evaluating it later: a
// call, an assignment, an index (it may stop the program), a block.
fn impure(e: i64, pcx: Ctx<Comp>) -> bool {
    if e == 0 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident || k == NodeKind::Path || k == NodeKind::Int
        || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Str
        || k == NodeKind::CStr || k == NodeKind::Bool || k == NodeKind::Unit {
        return false;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Cast {
        return impure(pcx.nodes[e].a, pcx);
    }
    if k == NodeKind::Unary {
        return impure(pcx.nodes[e].b, pcx);
    }
    if k == NodeKind::Binary {
        return impure(pcx.nodes[e].b, pcx) || impure(pcx.nodes[e].c, pcx);
    }
    if k == NodeKind::Tuple || k == NodeKind::Array {
        for i in 0..pcx.nodes[e].count {
            let c = child(e, i, pcx);
            if impure(c, pcx) {
                return true;
            }
        }
        return false;
    }
    true
}

// Whether e is made of literals only (`P { x: 1 }`, `(2, "a")`): the same
// whenever it is evaluated.
fn constant(e: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char
        || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Bool
        || k == NodeKind::Unit {
        return true;
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e].op == Tok::Minus && constant(pcx.nodes[e].b, pcx);
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit {
        for i in 0..pcx.nodes[e].count {
            let c = child(e, i, pcx);
            if !constant(if pcx.nodes[c].kind == NodeKind::FieldInit { pcx.nodes[c].b } else { c },
                pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

// The name of the temporary of e: its text (its first line), unique in
// the block.
fn temp_name(e: i64, pcx: inout Ctx<Comp>) -> i64 {
    let s = pcx.nodes[e].start;
    var end = pcx.nodes[e].end;
    var i = s;
    while i < end {
        if SRC[i] == '\n' {
            end = i;
        }
        i += 1;
    }
    let base = SRC[s..end];
    var name = intern(base, &pcx);
    var k = 1;
    while pcx.names.items().any(|x| x == name) {
        k += 1;
        let b = buf_new();
        buf_bytes(b, base);
        buf_bytes(b, " #");
        buf_int(b, k);
        name = intern(buf_slice(b), &pcx);
    }
    pcx.names.push(name);
    name
}

// `&e` (node amp): `let NAME = e;` onto LETS, and the operand made the
// Ident NAME (NODE_TEMP), with e's position.
fn hoist(amp: i64, pcx: inout Ctx<Comp>) {
    let e = pcx.nodes[amp].b;
    let start = pcx.nodes[e].start;
    let end = pcx.nodes[e].end;
    let name = temp_name(e, &pcx);
    let pat = new_node(NodeKind::PatBind, start, end, &pcx);
    pcx.nodes[pat].a = name;
    // (`&mut f(x)`: a `mut` local)
    pcx.nodes[pat].b = if (pcx.nodes[amp].p & NODE_REF_MUT) != 0 { 1 } else { 0 };
    let st = new_node(NodeKind::Let, start, end, &pcx);
    pcx.nodes[st].a = pat;
    pcx.nodes[st].c = e;
    pcx.lets.push(st);
    let id = new_node(NodeKind::Ident, start, end, &pcx);
    pcx.nodes[id].a = name;
    pcx.nodes[id].p |= NODE_TEMP;
    pcx.nodes[amp].b = id;
}

// Visits expression e in evaluation order, through the positions that are
// evaluated once and unconditionally with the statement.
fn visit(e: i64, pcx: inout Ctx<Comp>) {
    if e == 0 {
        return;
    }
    if (pcx.nodes[e].p & NODE_CHECKED) != 0 {
        // (0.25.2: a value checked already, under a block a desugaring
        // made and checks (`p = rhs` in front/own/drops.vl
        // assign_drops): its temporaries are placed, and an `&` in it
        // may be the checker's own (a let argument lent where it
        // stands). A `let` hoisted from it would name a value through
        // an Ident nothing checks.)
        if impure(e, pcx) {
            pcx.impure = true;
        }
        return;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Amp {
        let o = pcx.nodes[e].b;
        // (0.18.1: `&pool[a..b]`, a slice, where `&[u8]` is expected)
        let slicing = pcx.nodes[o].kind == NodeKind::Index
            && pcx.nodes[pcx.nodes[o].b].kind == NodeKind::Range
            && (pcx.nodes[e].p & NODE_REF_MUT) == 0;
        if !is_value_expr(o, pcx) && !slicing {
            visit(o, &pcx);
            return;
        }
        if pcx.impure && !constant(o, pcx) {
            return;
        }
        // (0.27.2: `&[]`, typed by the slice expected where it stands, check
        // mode's; it holds nothing to keep. RULE: Z9.2)
        if pcx.nodes[o].kind == NodeKind::Array && pcx.nodes[o].count == 0
            && crate::front::check::rust::rust_node(e, &pcx) {
            return;
        }
        // (what e evaluates moves with it into its `let`, in order; a
        // literal of literals may move before anything: constant)
        let before = pcx.impure;
        visit(o, &pcx);
        pcx.impure = before;
        hoist(e, &pcx);
        return;
    }
    if k == NodeKind::Call || k == NodeKind::MethodCall {
        visit(pcx.nodes[e].a, &pcx);
        for i in 0..pcx.nodes[e].count {
            visit(child(e, i, pcx), &pcx);
        }
        pcx.impure = true;
    } else if k == NodeKind::NamedArg {
        visit(pcx.nodes[e].b, &pcx);
    } else if k == NodeKind::Binary {
        visit(pcx.nodes[e].b, &pcx);
        if pcx.nodes[e].op == Tok::AmpAmp || pcx.nodes[e].op == Tok::PipePipe {
            // (its right side is evaluated or not: its temporaries in a
            // block of its own, 0.18.1)
            pcx.nodes[e].c = visit_sub(pcx.nodes[e].c, &pcx);
            pcx.impure = true;
            return;
        }
        visit(pcx.nodes[e].c, &pcx);
    } else if k == NodeKind::Unary || k == NodeKind::Return {
        visit(if k == NodeKind::Unary { pcx.nodes[e].b } else { pcx.nodes[e].a }, &pcx);
    } else if k == NodeKind::Cast || k == NodeKind::FieldAccess || k == NodeKind::TupleField
        || k == NodeKind::Try || k == NodeKind::Index {
        // (0.24: an Index's base, `f([1, 2])[0]`, first)
        visit(pcx.nodes[e].a, &pcx);
    } else if k == NodeKind::Tuple || k == NodeKind::Array {
        for i in 0..pcx.nodes[e].count {
            visit(child(e, i, pcx), &pcx);
        }
    } else if k == NodeKind::Interp {
        // (an f-string's holes, evaluated in order where it stands)
        for i in 0..pcx.nodes[e].count {
            let h = child(e, i, pcx);
            if pcx.nodes[h].kind == NodeKind::InterpHole {
                visit(pcx.nodes[h].a, &pcx);
            }
        }
    } else if k == NodeKind::StructLit {
        for i in 0..pcx.nodes[e].count {
            let f = child(e, i, pcx);
            if pcx.nodes[f].kind == NodeKind::FieldInit {
                visit(pcx.nodes[f].b, &pcx);
            }
        }
    } else if k == NodeKind::If || k == NodeKind::Match {
        // (the condition, the scrutinee; the rest is evaluated or not:
        // an arm's temporaries in a block of their own, 0.18.1)
        visit(pcx.nodes[e].a, &pcx);
        if k == NodeKind::Match {
            for i in 0..pcx.nodes[e].count {
                let arm = child(e, i, pcx);
                pcx.nodes[arm].c = visit_sub(pcx.nodes[arm].c, &pcx);
            }
        }
        pcx.impure = true;
    } else if k == NodeKind::Closure {
        // (0.18.1: a body that is an expression, `|a, b| cmp(&f(a),
        // &f(b))`: its temporaries in a block of their own)
        pcx.nodes[e].a = visit_sub(pcx.nodes[e].a, &pcx);
        // (0.20: a body that is an expression becomes the tail of a
        // block, so that its owned temporaries drop when the body
        // ends: front/own/drops)
        let body = pcx.nodes[e].a;
        if body != 0 && pcx.nodes[body].kind != NodeKind::Block {
            let b = new_node(NodeKind::Block, pcx.nodes[body].start, pcx.nodes[body].end, &pcx);
            let m = list_begin(pcx);
            list_end(b, m, &pcx);
            pcx.nodes[b].a = body;
            pcx.nodes[e].a = b;
        }
    } else if k == NodeKind::Assign {
        visit(pcx.nodes[e].c, &pcx);
        pcx.impure = true;
    } else if impure(e, pcx) {
        pcx.impure = true;
    }
}

// (0.18.1) Expression e, evaluated or not with its statement (a
// condition's other side, a match arm's value, a closure's body): its
// temporaries go in a block made for it, `{ let f(x) = f(x); e }`; that
// block, or e when it has none.
fn visit_sub(e: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if e == 0 || pcx.nodes[e].kind == NodeKind::Block {
            return e;
        }
        let mark = pcx.lets.count;
        let saved = pcx.impure;
        pcx.impure = false;
        visit(e, &pcx);
        pcx.impure = saved;
        if pcx.lets.count == mark {
            return e;
        }
        let b = new_node(NodeKind::Block, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
        let m = list_begin(pcx);
        for j in mark..pcx.lets.count {
            list_push(pcx.lets.data[j], &pcx);
        }
        list_end(b, m, &pcx);
        pcx.nodes[b].a = e;
        pcx.lets.count = mark;
        b
    }
}

// The temporaries of the statements of block (a `let`'s initializer, an
// expression statement, the tail): their `let`s in front of each.
pub fn hoist_temporaries(block: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.names.count = 0;
        var any = false;
        let mark = list_begin(pcx);
        // (0.27.0) in the rust edition, as Rust's, only `let r = &f(x);`
        // makes a temporary of the block (lifetime extension); the others
        // are their statement's, made where they stand (synth_unary)
        let rust = pcx.edition != 0 && crate::front::rust::rust_at(pcx.nodes[block].start, &pcx);
        for i in 0..pcx.nodes[block].count {
            let s = child(block, i, pcx);
            pcx.lets.count = 0;
            pcx.impure = false;
            let k = pcx.nodes[s].kind;
            if rust {
                let init = if k == NodeKind::Let { pcx.nodes[s].c } else { 0 };
                if init != 0 && pcx.nodes[init].kind == NodeKind::Unary
                    && pcx.nodes[init].op == Tok::Amp {
                    visit(init, &pcx);
                }
            } else if k == NodeKind::Let {
                visit(pcx.nodes[s].c, &pcx);
            } else if k == NodeKind::ExprStmt {
                visit(pcx.nodes[s].a, &pcx);
            }
            for j in 0..pcx.lets.count {
                list_push(pcx.lets.data[j], &pcx);
                any = true;
            }
            list_push(s, &pcx);
        }
        let tail = pcx.nodes[block].a;
        if tail != 0 && !rust {
            pcx.lets.count = 0;
            pcx.impure = false;
            visit(tail, &pcx);
            for j in 0..pcx.lets.count {
                list_push(pcx.lets.data[j], &pcx);
                any = true;
            }
        }
        if any {
            list_end(block, mark, &pcx);
        } else {
            pcx.scratch.count = mark;
        }
    }
}
