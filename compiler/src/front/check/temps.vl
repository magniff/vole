// `&e` of a value that is no place (0.18.1): a temporary. Before a block
// is checked, each of its statements (and its tail) that takes `&f(x)`
// where nothing evaluated before it in the statement can tell the
// difference gets `let f(x) = f(x);` in front of it, and the `&` takes
// that local: the temporary lives to the end of the block (Rust's
// temporary lifetime extension, for `let r = &f(x);`), is dropped there,
// and the own pass checks it as any local (its name is the expression's
// text; a literal, `&P { x: 1 }`, is hoisted from anywhere). Where the
// order could differ (a call, an assignment or an index
// evaluated before it, a condition's other side, a closure), it stays an
// error with a `try:` (synth_unary). In a 0.20 file `&` of a value is
// conv.place.
//
// (0.25) A value given to a let parameter (`total(make())`) is no longer
// hoisted here: the checker lends it where it stands
// (check_mode::LET_ARG) and front/own/drops.vl makes it a temporary of
// the statement, conventions.md §2.2 "Temporaries".

use crate::base::{buf_bytes, buf_int, buf_new, buf_slice, get_src, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    NODE_CHECKED, NODE_REF_MUT, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::lexer::Tok;

// A flag of the Ident that names a temporary (on the `&`'s operand).
pub const NODE_TEMP: i64 = 1 << 52;

// Whether e, written after `&`, is a value rather than a place: what the
// checker would call a non-lvalue (a slice or a function's value is
// handled where it is typed: synth_unary).
fn is_value_expr(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op != Tok::Star;
    }
    k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::StructLit
        || k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::Int
        || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Str
        || k == NodeKind::Bool || k == NodeKind::Binary || k == NodeKind::Cast
        || k == NodeKind::Try
}

// Whether evaluating e could be told apart from evaluating it later: a
// call, an assignment, an index (it may stop the program), a block.
fn impure(e: i64, pcx: &Ctx<Comp>) -> bool {
    if e == 0 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident || k == NodeKind::Path || k == NodeKind::Int
        || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Str
        || k == NodeKind::CStr || k == NodeKind::Bool || k == NodeKind::Unit {
        return false;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Cast {
        return impure(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::Unary {
        return impure(pcx.nodes[e as usize].b, pcx);
    }
    if k == NodeKind::Binary {
        return impure(pcx.nodes[e as usize].b, pcx) || impure(pcx.nodes[e as usize].c, pcx);
    }
    if k == NodeKind::Tuple || k == NodeKind::Array {
        for i in 0..pcx.nodes[e as usize].count {
            let c = child(e, i, pcx);
            if impure(c, pcx) {
                return true;
            }
        }
        return false;
    }
    true
}

// Whether e is made of literals only (`P { x: 1 }`, `(2, "a")`): the same
// whenever it is evaluated.
fn constant(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char
        || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Bool
        || k == NodeKind::Unit {
        return true;
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op == Tok::Minus && constant(pcx.nodes[e as usize].b, pcx);
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit {
        for i in 0..pcx.nodes[e as usize].count {
            let c = child(e, i, pcx);
            if !constant(if pcx.nodes[c as usize].kind
                == NodeKind::FieldInit { pcx.nodes[c as usize].b } else { c },
                pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

// The name of the temporary of e: its text (its first line), unique in
// the block.
fn temp_name(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let s = pcx.nodes[e as usize].start;
    let mut end = pcx.nodes[e as usize].end;
    let mut i = s;
    while i < end {
        if get_src()[i as usize] == b'\n' {
            end = i;
        }
        i += 1;
    }
    let base = &get_src()[s as usize..end as usize];
    let mut name = intern(base, pcx);
    let mut k: i64 = 1;
    while pcx.names.items().any(|x| x == name) {
        k += 1;
        let b = buf_new();
        buf_bytes(b, base);
        buf_bytes(b, b" #");
        buf_int(b, k);
        name = intern(buf_slice(b), pcx);
    }
    pcx.names.push(name);
    name
}

// `&e` (node amp): `let NAME = e;` onto LETS, and the operand made the
// Ident NAME (NODE_TEMP), with e's position.
fn hoist(amp: i64, pcx: &mut Ctx<Comp>) {
    let e = pcx.nodes[amp as usize].b;
    let start = pcx.nodes[e as usize].start;
    let end = pcx.nodes[e as usize].end;
    let name = temp_name(e, pcx);
    let pat = new_node(NodeKind::PatBind, start, end, pcx);
    pcx.nodes[pat as usize].a = name;
    // (`&mut f(x)`: a `mut` local)
    pcx.nodes[pat as usize].b = if (pcx.nodes[amp as usize].p & NODE_REF_MUT) != 0 { 1 } else { 0 };
    let st = new_node(NodeKind::Let, start, end, pcx);
    pcx.nodes[st as usize].a = pat;
    pcx.nodes[st as usize].c = e;
    pcx.lets.push(st);
    let id = new_node(NodeKind::Ident, start, end, pcx);
    pcx.nodes[id as usize].a = name;
    pcx.nodes[id as usize].p |= NODE_TEMP;
    pcx.nodes[amp as usize].b = id;
}

// Visits expression e in evaluation order, through the positions that are
// evaluated once and unconditionally with the statement.
fn visit(e: i64, pcx: &mut Ctx<Comp>) {
    if e == 0 {
        return;
    }
    if (pcx.nodes[e as usize].p & NODE_CHECKED) != 0 {
        // (0.25.2: a value checked already, under a block a desugaring
        // made and checks (`p = rhs` in front/own/drops.vl
        // assign_drops): its temporaries are placed, and an `&` in it
        // may be the checker's own (a let argument lent where it
        // stands). A `let` hoisted from it would name a value through
        // an Ident nothing checks.)
        if impure(e, pcx) {
            pcx.impure = true;
        }
        return;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Amp {
        let o = pcx.nodes[e as usize].b;
        // (0.18.1: `&pool[a..b]`, a slice, where `&[u8]` is expected)
        let slicing = pcx.nodes[o as usize].kind == NodeKind::Index
            && pcx.nodes[pcx.nodes[o as usize].b as usize].kind == NodeKind::Range
            && (pcx.nodes[e as usize].p & NODE_REF_MUT) == 0;
        if !is_value_expr(o, pcx) && !slicing {
            visit(o, pcx);
            return;
        }
        if pcx.impure && !constant(o, pcx) {
            return;
        }
        // (0.27.2: `&[]`, typed by the slice expected where it stands, check
        // mode's; it holds nothing to keep. RULE: Z9.2)
        if pcx.nodes[o as usize].kind == NodeKind::Array && pcx.nodes[o as usize].count == 0
            && crate::front::check::rust::rust_node(e, pcx) {
            return;
        }
        // (what e evaluates moves with it into its `let`, in order; a
        // literal of literals may move before anything: constant)
        let before = pcx.impure;
        visit(o, pcx);
        pcx.impure = before;
        hoist(e, pcx);
        return;
    }
    if k == NodeKind::Call || k == NodeKind::MethodCall {
        visit(pcx.nodes[e as usize].a, pcx);
        for i in 0..pcx.nodes[e as usize].count {
            visit(child(e, i, pcx), pcx);
        }
        pcx.impure = true;
    } else if k == NodeKind::NamedArg {
        visit(pcx.nodes[e as usize].b, pcx);
    } else if k == NodeKind::Binary {
        visit(pcx.nodes[e as usize].b, pcx);
        if pcx.nodes[e as usize].op == Tok::AmpAmp || pcx.nodes[e as usize].op == Tok::PipePipe {
            // (its right side is evaluated or not: its temporaries in a
            // block of its own, 0.18.1)
            pcx.nodes[e as usize].c = visit_sub(pcx.nodes[e as usize].c, pcx);
            pcx.impure = true;
            return;
        }
        visit(pcx.nodes[e as usize].c, pcx);
    } else if k == NodeKind::Unary || k == NodeKind::Return {
        visit(if k == NodeKind::Unary { pcx.nodes[e as usize].b } else { pcx.nodes[e as usize].a },
            pcx);
    } else if k == NodeKind::Cast || k == NodeKind::FieldAccess || k == NodeKind::TupleField
        || k == NodeKind::Try || k == NodeKind::Index {
        // (0.24: an Index's base, `f([1, 2])[0]`, first)
        visit(pcx.nodes[e as usize].a, pcx);
    } else if k == NodeKind::Tuple || k == NodeKind::Array {
        for i in 0..pcx.nodes[e as usize].count {
            visit(child(e, i, pcx), pcx);
        }
    } else if k == NodeKind::Interp {
        // (an f-string's holes, evaluated in order where it stands)
        for i in 0..pcx.nodes[e as usize].count {
            let h = child(e, i, pcx);
            if pcx.nodes[h as usize].kind == NodeKind::InterpHole {
                visit(pcx.nodes[h as usize].a, pcx);
            }
        }
    } else if k == NodeKind::StructLit {
        for i in 0..pcx.nodes[e as usize].count {
            let f = child(e, i, pcx);
            if pcx.nodes[f as usize].kind == NodeKind::FieldInit {
                visit(pcx.nodes[f as usize].b, pcx);
            }
        }
    } else if k == NodeKind::If || k == NodeKind::Match {
        // (the condition, the scrutinee; the rest is evaluated or not:
        // an arm's temporaries in a block of their own, 0.18.1)
        visit(pcx.nodes[e as usize].a, pcx);
        if k == NodeKind::Match {
            for i in 0..pcx.nodes[e as usize].count {
                let arm = child(e, i, pcx);
                pcx.nodes[arm as usize].c = visit_sub(pcx.nodes[arm as usize].c, pcx);
            }
        }
        pcx.impure = true;
    } else if k == NodeKind::Closure {
        // (0.18.1: a body that is an expression, `|a, b| cmp(&f(a),
        // &f(b))`: its temporaries in a block of their own)
        pcx.nodes[e as usize].a = visit_sub(pcx.nodes[e as usize].a, pcx);
        // (0.20: a body that is an expression becomes the tail of a
        // block, so that its owned temporaries drop when the body
        // ends: front/own/drops)
        let body = pcx.nodes[e as usize].a;
        if body != 0 && pcx.nodes[body as usize].kind != NodeKind::Block {
            let b = new_node(NodeKind::Block, pcx.nodes[body as usize].start,
                pcx.nodes[body as usize].end, pcx);
            let m = list_begin(pcx);
            list_end(b, m, pcx);
            pcx.nodes[b as usize].a = body;
            pcx.nodes[e as usize].a = b;
        }
    } else if k == NodeKind::Assign {
        visit(pcx.nodes[e as usize].c, pcx);
        pcx.impure = true;
    } else if impure(e, pcx) {
        pcx.impure = true;
    }
}

// (0.18.1) Expression e, evaluated or not with its statement (a
// condition's other side, a match arm's value, a closure's body): its
// temporaries go in a block made for it, `{ let f(x) = f(x); e }`; that
// block, or e when it has none.
fn visit_sub(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if e == 0 || pcx.nodes[e as usize].kind == NodeKind::Block {
            return e;
        }
        let mark = pcx.lets.count;
        let saved = pcx.impure;
        pcx.impure = false;
        visit(e, pcx);
        pcx.impure = saved;
        if pcx.lets.count == mark {
            return e;
        }
        let b = new_node(NodeKind::Block, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end,
            pcx);
        let m = list_begin(pcx);
        for j in mark..pcx.lets.count {
            list_push((*pcx.lets.data.add(j as usize)), pcx);
        }
        list_end(b, m, pcx);
        pcx.nodes[b as usize].a = e;
        pcx.lets.count = mark;
        b
    }
}

// (0.27.2.1) The temporary hoisted for `let r: ANN = &e;` (e a literal)
// gets the type ANN says it has: `let d: &[u8] = &[1, 2, 3];` makes `let
// t: [u8; 3] = [1, 2, 3];`, `let x: &u8 = &1;` makes `let t: u8 = 1;`, so
// the literals are typed from the annotation, not by the default.
fn annotate_temp(ann: i64, operand: i64, init: i64, pcx: &mut Ctx<Comp>) {
    // RULE: F18.4 (a hoisted literal takes the let's annotation)
    let k = pcx.nodes[operand as usize].kind;
    // RULE: F18.4 (0.27.6: `let s: &[T] = &[1, 2, 3][1..];`, a sliced array
    // literal: the temporary is the array, `let t: [T; 3] = [1, 2, 3];`, and
    // the initializer `&t[1..]`, so the literals take T)
    // (`&[T]` is a TySlice, MVS's view; a TyPtr over one, `&[T]` written
    // over a slice type)
    let slice = if ann != 0
        && pcx.nodes[ann as usize].kind == NodeKind::TyPtr { pcx.nodes[ann as usize].a }
        else { ann };
    if ann != 0 && k == NodeKind::Index && pcx.nodes[slice as usize].kind == NodeKind::TySlice
        && pcx.nodes[pcx.nodes[operand as usize].b as usize].kind == NodeKind::Range
        && pcx.nodes[pcx.nodes[operand as usize].a as usize].kind == NodeKind::Array
        && pcx.nodes[pcx.nodes[operand as usize].a as usize].count > 0
        && pcx.nodes[init as usize].kind == NodeKind::Unary
        && pcx.nodes[pcx.nodes[init as usize].b as usize].kind == NodeKind::Ident {
        for j in 0..pcx.lets.count {
            // UNSAFE: LETS is a raw IntVec (base/comp.vl), as every table.
            // SAFETY: j < count, the vector's own length.
            let st = unsafe { (*pcx.lets.data.add(j as usize)) };
            if pcx.nodes[st as usize].c != operand {
                continue;
            }
            let array = pcx.nodes[operand as usize].a;
            let start = pcx.nodes[array as usize].start;
            let len = new_node(NodeKind::Int, start, start, pcx);
            pcx.nodes[len as usize].a = pcx.nodes[array as usize].count;
            let at = new_node(NodeKind::TyArray, pcx.nodes[slice as usize].start,
                pcx.nodes[slice as usize].end, pcx);
            pcx.nodes[at as usize].a = pcx.nodes[slice as usize].a;
            pcx.nodes[at as usize].b = len;
            pcx.nodes[st as usize].b = at;
            pcx.nodes[st as usize].c = array;
            // (the temporary's name, hoist's Ident, now the slicing's base)
            let id = pcx.nodes[init as usize].b;
            pcx.nodes[id as usize].start = start;
            pcx.nodes[id as usize].end = pcx.nodes[array as usize].end;
            pcx.nodes[operand as usize].a = id;
            pcx.nodes[init as usize].b = operand;
        }
        return;
    }
    // RULE: F18.5 (`let s: &[T] = &a[..];` of an open array `a`: the slice
    // annotation, which literals::open_hint reads)
    if ann != 0 && k == NodeKind::Index
        && pcx.nodes[pcx.nodes[operand as usize].b as usize].kind == NodeKind::Range {
        let slice = if pcx.nodes[ann as usize].kind == NodeKind::TyPtr { pcx.nodes[ann as usize].a }
            else { ann };
        for j in 0..(if pcx.nodes[slice as usize].kind == NodeKind::TySlice { pcx.lets.count }
            else { 0 }) {
            // UNSAFE: LETS is a raw IntVec (base/comp.vl), as every table.
            // SAFETY: j < count, the vector's own length.
            let st = unsafe { (*pcx.lets.data.add(j as usize)) };
            if pcx.nodes[st as usize].c == operand {
                pcx.open_hints.push(st);
                pcx.open_hints.push(slice);
            }
        }
        return;
    }
    if ann == 0 || !(k == NodeKind::Array || k == NodeKind::Int || k == NodeKind::Float
        || k == NodeKind::Tuple) {
        return;
    }
    for j in 0..pcx.lets.count {
        // UNSAFE: LETS is a raw IntVec (base/comp.vl), as every table.
        // SAFETY: j < count, the vector's own length.
        let st = unsafe { (*pcx.lets.data.add(j as usize)) };
        if pcx.nodes[st as usize].c != operand {
            continue;
        }
        if pcx.nodes[ann as usize].kind == NodeKind::TyPtr {
            pcx.nodes[st as usize].b = pcx.nodes[ann as usize].a;
        } else if pcx.nodes[ann as usize].kind == NodeKind::TySlice && k == NodeKind::Array {
            let start = pcx.nodes[operand as usize].start;
            let len = new_node(NodeKind::Int, start, start, pcx);
            pcx.nodes[len as usize].a = pcx.nodes[operand as usize].count;
            let at = new_node(NodeKind::TyArray, pcx.nodes[ann as usize].start,
                pcx.nodes[ann as usize].end, pcx);
            pcx.nodes[at as usize].a = pcx.nodes[ann as usize].a;
            pcx.nodes[at as usize].b = len;
            pcx.nodes[st as usize].b = at;
        }
    }
}

// The temporaries of the statements of block (a `let`'s initializer, an
// expression statement, the tail): their `let`s in front of each.
pub fn hoist_temporaries(block: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.names.count = 0;
        let mut any = false;
        let mark = list_begin(pcx);
        // (0.27.0) in the rust edition, as Rust's, only `let r = &f(x);`
        // makes a temporary of the block (lifetime extension); the others
        // are their statement's, made where they stand (synth_unary)
        let rust = crate::front::rust::rust_at(pcx.nodes[block as usize].start, pcx);
        for i in 0..pcx.nodes[block as usize].count {
            let s = child(block, i, pcx);
            pcx.lets.count = 0;
            pcx.impure = false;
            let k = pcx.nodes[s as usize].kind;
            if rust {
                let init: i64 = if k == NodeKind::Let { pcx.nodes[s as usize].c } else { 0 };
                if init != 0 && pcx.nodes[init as usize].kind == NodeKind::Unary
                    && pcx.nodes[init as usize].op == Tok::Amp {
                    let operand = pcx.nodes[init as usize].b;
                    visit(init, pcx);
                    annotate_temp(pcx.nodes[s as usize].b, operand, init, pcx);
                }
            } else if k == NodeKind::Let {
                visit(pcx.nodes[s as usize].c, pcx);
            } else if k == NodeKind::ExprStmt {
                visit(pcx.nodes[s as usize].a, pcx);
            }
            for j in 0..pcx.lets.count {
                list_push((*pcx.lets.data.add(j as usize)), pcx);
                any = true;
            }
            list_push(s, pcx);
        }
        let tail = pcx.nodes[block as usize].a;
        if tail != 0 && !rust {
            pcx.lets.count = 0;
            pcx.impure = false;
            visit(tail, pcx);
            for j in 0..pcx.lets.count {
                list_push((*pcx.lets.data.add(j as usize)), pcx);
                any = true;
            }
        }
        if any {
            list_end(block, mark, pcx);
        } else {
            pcx.scratch.count = mark;
        }
    }
}
