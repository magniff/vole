// Distinct types in the checker (0.18, docs/design/contracts-verification.md
// §2.10; the types themselves are front/distinct.vl): the alias that
// makes one, literals, operators, the methods it does not take from its
// underlying type, and the erasure once the program checks.
//
// The rules are Go's defined types: `x as X` and `id as i64` convert for
// free; a literal becomes X; X's operators are T's between two X (or an X
// and a literal); X has none of T's methods, but the traits Eq, Ord, Hash,
// Debug, Display and Clone when T has them (front/traits.vl, std's
// distinct_* helpers).

use crate::base::{IntVec, get_src, buf_fmt, buf_new, buf_slice, free, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_jump, err_str,
    err_try_fmt,
};
use crate::front::ast::{NODE_CHECKED, NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::check::is_std_named;
use crate::front::contracts::checks::fixed_message;
use crate::front::contracts::diag::{DISTINCT_KIND, DISTINCT_METHOD, DISTINCT_MIX};
use crate::front::distinct::{
    distinct_type, enum_niche, erase_list, erase_type, is_distinct_type, is_niche_alias,
    is_view_distinct, reset_erased, strip_distinct,
};
use crate::front::lexer::{SUF_NONE, Tok};
use crate::front::modules::{module_of, within_std};
use crate::front::own::kinds::{is_owned_type, is_plain_type};
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    get_enums, get_fields, TyKind, buf_type, enum_variant, is_numeric, struct_field, type_count, type_elem,
    variant_field,
};
use crate::gen0::target::message_kind;

// The type that `type X = distinct T` (alias node `alias`) names, T being
// `base`, with the type arguments TSCRATCH[mark..] (popped).
pub fn distinct_of(alias: i64, base: i64, mark: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if base == pcx.ty_error {
        pcx.tscratch.count = mark;
        return base;
    }
    // (0.20) std's `str`, over `[u8]`: a view, checked as one by the
    // own pass (erase_view_distincts)
    let text = view_text_alias(alias, base, pcx);
    if text {
        pcx.any_view_distinct = true;
    }
    let bad: i64 = if text { 0 } else { not_plain(base, 0, pcx) };
    if bad != 0 {
        let saved = pcx.err_kind;
        pcx.err_kind = DISTINCT_KIND;
        err_begin(pcx.nodes[pcx.nodes[alias as usize].b as usize].start, pcx);
        let b = buf_new();
        buf_type(b, bad, pcx);
        let what = if pcx.types[bad as usize].kind == TyKind::Slice || pcx.types[bad as usize].kind == TyKind::Ptr
            { "views memory" }
            else { "owns memory" };
        err_fmt(format_args("a distinct type is over a plain type: '{}' {what}", str::from_utf8(buf_slice(b)).unwrap()),
            pcx);
        let name = sym_text(pcx.nodes[alias as usize].a, pcx);
        err_help_fmt({ let name = str::from_utf8(name).unwrap(); format_args("a distinct value is copied freely; for an owned or view type declare a struct of one field instead: 'struct {name} {{ v: {} }}'", str::from_utf8(buf_slice(b)).unwrap()) }, pcx);
        err_end_soft(pcx);
        pcx.err_kind = saved;
    }
    // (std's NonNull: the null niche, front/distinct.vl)
    if within_std(module_of(alias, pcx), pcx) && sym_text(pcx.nodes[alias as usize].a, pcx) == b"NonNull"
        && !is_niche_alias(alias, pcx) {
        pcx.niche_aliases.push(alias);
    }
    let t = distinct_type(alias, base, mark, pcx);
    if text && sym_text(pcx.nodes[alias as usize].a, pcx) == b"str" {
        pcx.str_type = t;
    } else if text {
        pcx.path_type = t;
    }
    t
}

// (0.20) Whether alias node `alias` over `base` is std's `type str =
// distinct [u8]` or `type Path = distinct [u8]` (std::path): the distinct
// types over a view.
fn view_text_alias(alias: i64, base: i64, pcx: &mut Ctx<Comp>) -> bool {
    base > 0 && pcx.types[base as usize].kind == TyKind::Slice && pcx.types[base as usize].b == 0
        && within_std(module_of(alias, pcx), pcx)
        && (sym_text(pcx.nodes[alias as usize].a, pcx) == b"str"
            || sym_text(pcx.nodes[alias as usize].a, pcx) == b"Path")
}

// A type in t that is not plain (an owned or a view type: a slice, a
// reference, Vec, Buf, HashMap, or a struct, enum, tuple or array holding
// one); 0. A type that owns by its Drop impl is found later, when the
// impls are known (check_distinct_kinds).
fn not_plain(t: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if t <= 0 || depth > 16 {
            return 0;
        }
        let kind = pcx.types[t as usize].kind;
        // (0.17: a reference is a view)
        if kind == TyKind::Slice || kind == TyKind::Ptr && pcx.types[t as usize].b != 0 {
            return t;
        }
        if kind == TyKind::Struct {
            if is_std_named(t, c"Vec", pcx) || is_std_named(t, c"Buf", pcx)
                || is_std_named(t, c"HashMap", pcx) {
                return t;
            }
            let s = pcx.types[t as usize].a;
            for i in 0..pcx.structs[s as usize].field_count {
                let bad = not_plain((*struct_field(s, i, pcx)).ty, depth + 1, pcx);
                if bad != 0 {
                    return bad;
                }
            }
            return 0;
        }
        if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(e as usize)).variant_count {
                let v = enum_variant(e, i);
                for k in 0..pcx.variants[v as usize].field_count {
                    let bad = not_plain(variant_field(v, k, pcx), depth + 1, pcx);
                    if bad != 0 {
                        return bad;
                    }
                }
            }
            return 0;
        }
        if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                let bad = not_plain(type_elem(t, i, pcx), depth + 1, pcx);
                if bad != 0 {
                    return bad;
                }
            }
            return 0;
        }
        if kind == TyKind::Array || kind == TyKind::Distinct {
            return not_plain(pcx.types[t as usize].a, depth + 1, pcx);
        }
        0
    }
}

// (0.18, with 0.17's values) distinct.kind for the distinct types whose
// underlying type is owned or a view by 0.17's kinds but passed
// not_plain: a struct or enum with a Drop impl (known once the impls
// are), or an instance's type argument. Once per alias; called by
// check_program before the own pass, which takes every distinct type as
// plain.
pub fn check_distinct_kinds(pcx: &mut Ctx<Comp>) {
    unsafe {
        if !pcx.any_distinct {
            return;
        }
        let mut seen = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for t in 1..type_count(pcx) {
            if pcx.types[t as usize].kind != TyKind::Distinct {
                continue;
            }
            let alias = pcx.types[t as usize].b;
            let base = pcx.types[t as usize].a;
            if alias <= 0 || base <= 0 || base == pcx.ty_error || not_plain(base, 0, pcx) != 0
                || view_text_alias(alias, base, pcx)
                || is_plain_type(base, pcx) || (0i64..seen.count).any(|j| (*seen.data.add(j as usize)) == alias) {
                continue;
            }
            seen.push(alias);
            let saved = pcx.err_kind;
            pcx.err_kind = DISTINCT_KIND;
            err_begin(pcx.nodes[pcx.nodes[alias as usize].b as usize].start, pcx);
            let b = buf_new();
            buf_type(b, base, pcx);
            let what = if is_owned_type(base, pcx) { "owns memory" } else { "views memory" };
            err_fmt(format_args("a distinct type is over a plain type: '{}' {what}", str::from_utf8(buf_slice(b)).unwrap()),
                pcx);
            let name = sym_text(pcx.nodes[alias as usize].a, pcx);
            err_help_fmt({ let name = str::from_utf8(name).unwrap(); format_args("a distinct value is copied freely; for an owned or view type declare a struct of one field instead: 'struct {name} {{ v: {} }}'", str::from_utf8(buf_slice(b)).unwrap()) }, pcx);
            err_end_soft(pcx);
            pcx.err_kind = saved;
        }
        free(seen.data as *mut u8);
    }
}

// ---- Literals, operators, the methods ----

// Whether literal n, checked against distinct type `expected` over a
// number, was checked against that number: the one implicit conversion.
// (0.20) And a string literal where std's `str` goes: a `str`.
pub fn distinct_literal(n: i64, expected: i64, pcx: &mut Ctx<Comp>) -> bool {
    if !is_distinct_type(expected, pcx) {
        return false;
    }
    // RULE: F0.6 (0.27.5: in the rust edition a string literal is a `&str`
    // itself, not checked as its bytes)
    if expected == pcx.str_type && is_string_literal(n, pcx)
        && crate::front::check::rust::rust_node(n, pcx) && literal_utf8(n, pcx)
        && crate::front::check::synth_mode::synth_expr(n, pcx) == expected {
        return true;
    }
    if is_view_distinct(expected, pcx) && is_string_literal(n, pcx)
        && (expected != pcx.str_type || literal_utf8(n, pcx)) {
        crate::front::check::check_mode::check_expr(n, strip_distinct(expected, pcx), pcx);
        return true;
    }
    if !crate::front::check::synth_mode::is_context_literal(n, pcx) {
        return false;
    }
    let base = strip_distinct(expected, pcx);
    if !is_numeric(base) {
        return false;
    }
    crate::front::check::check_mode::check_expr(n, base, pcx);
    true
}

// (0.20) Whether string literal n (or the block of only it) is UTF-8: a
// literal with `\x80`..`\xff` escapes that break it stays `[u8]`.
fn literal_utf8(n: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[n as usize].kind == NodeKind::Block {
        return literal_utf8(pcx.nodes[n as usize].a, pcx);
    }
    // (0.25.3: include_bytes, b=1, is bytes whatever they hold)
    pcx.nodes[n as usize].b == 0 && is_utf8_text(crate::front::lexer::str_at(pcx.nodes[n as usize].a))
}

// (0.20) Whether s is well-formed UTF-8 (RFC 3629: no overlong forms, no
// surrogates, nothing above U+10FFFF).
pub fn is_utf8_text(s: &[u8]) -> bool {
    utf8_error_at(s) < 0
}

// (0.25.3) The offset of the first byte of s where it stops being UTF-8,
// -1 when it is UTF-8 throughout.
pub fn utf8_error_at(s: &[u8]) -> i64 {
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let b = s[i as usize];
        if b < 0x80 {
            i += 1;
            continue;
        }
        let n: i64 = if b >= 0xc2 && b < 0xe0 { 2 } else if b >= 0xe0 && b < 0xf0 { 3 }
            else if b >= 0xf0 && b < 0xf5 { 4 } else { 0 };
        if n == 0 || i + n > s.len() as i64 {
            return i;
        }
        let b1 = s[(i + 1) as usize];
        let lo: u8 = if b == 0xe0 { 0xa0 } else if b == 0xf0 { 0x90 } else { 0x80 };
        let hi: u8 = if b == 0xed { 0x9f } else if b == 0xf4 { 0x8f } else { 0xbf };
        if b1 < lo || b1 > hi {
            return i;
        }
        for k in 2..n {
            if (s[(i + k) as usize] & 0xc0) != 0x80 {
                return i;
            }
        }
        i += n;
    }
    -1
}

// (0.20) Whether n is a string literal ("..", not c".."), or a block of
// only one.
fn is_string_literal(n: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[n as usize].kind == NodeKind::Block {
        return pcx.nodes[n as usize].count == 0 && pcx.nodes[n as usize].a != 0
            && is_string_literal(pcx.nodes[n as usize].a, pcx);
    }
    pcx.nodes[n as usize].kind == NodeKind::Str
}

// Binary node n (operator op), whose operands are both of distinct type
// ty: T's operator. Arithmetic and bitwise operators give a `ty`,
// comparisons a bool.
pub fn distinct_binary(n: i64, op: Tok, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let base = strip_distinct(ty, pcx);
    let lhs = pcx.nodes[n as usize].b;
    let rhs = pcx.nodes[n as usize].c;
    if pcx.nodes[lhs as usize].ty == ty {
        pcx.nodes[lhs as usize].ty = base;
    }
    if pcx.nodes[rhs as usize].ty == ty {
        pcx.nodes[rhs as usize].ty = base;
    }
    let r = crate::front::check::synth_mode::binary_result(n, op, base, pcx);
    let compares = op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::Gt
        || op == Tok::LtEq || op == Tok::GtEq;
    if r == base && !compares { ty } else { r }
}

// (0.25.2, feedbacks/galaga.md #5) Whether `str::from_utf8(b)?` type-checks
// in the function being checked: it returns a Result whose error is std's
// Utf8Error or converts from one (From). The try: line is printed only
// then: a suggestion that does not compile costs more than none.
pub fn from_utf8_try_fits(pcx: &mut Ctx<Comp>) -> bool {
    let mut rargs: i64 = 0;
    let r = pcx.return_type;
    if r <= 0 || crate::front::convert::std_enum_name(r, &mut rargs, pcx) != intern_c(c"Result", pcx) {
        return false;
    }
    let from = utf8_error_type(pcx);
    if from <= 0 {
        // (std's str section is not loaded: nothing names Utf8Error, so
        // no error type converts from it)
        return false;
    }
    let to = tlist_at(rargs + 1, pcx);
    if to == from {
        return true;
    }
    let tr = crate::front::traits::std_trait(c"From", pcx);
    tr >= 0 && crate::front::convert::implements_with(tr, to,
        crate::front::convert::list_of(from, pcx), pcx)
}

// The type of std::str::Utf8Error, 0 when it is not loaded.
fn utf8_error_type(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.std_module < 0 {
        return 0;
    }
    let m = crate::front::modules::child_module(pcx.std_module,
        intern_c(c"str", pcx), pcx);
    if m < 0 {
        return 0;
    }
    let b = crate::front::modules::lookup::lookup_quiet(m, intern_c(c"Utf8Error", pcx), m, pcx);
    if crate::front::modules::lookup::binding_kind(b) != crate::front::modules::lookup::B_ITEM {
        return 0;
    }
    let s = struct_of_key(crate::front::modules::lookup::binding_value(b), pcx);
    if s < 0 { 0 } else { crate::front::types::struct_type(s, pcx) }
}

fn struct_of_key(key: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: SYM_STRUCT is the checker's table of structs by item key, a
    // raw pointer.
    // SAFETY: key is a binding's item key, below SYM_COUNT, which the table
    // covers.
    unsafe { (*pcx.sym_struct.add(key as usize)) - 1 }
}

fn tlist_at(i: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: TLISTS's data is a raw buffer (an IntVec).
    // SAFETY: i is a Result's error type argument, rargs + 1 of the two
    // std_enum_name gave, below TLISTS.count.
    unsafe { (*pcx.tlists.data.add(i as usize)) }
}

// A value of type `actual` where `expected` goes, one of them distinct
// over the other's type (or both numbers): distinct.mix, with the
// conversion (of the operand that is not distinct, in an operation).
// Returns when it is some other mismatch.
pub fn distinct_mismatch(n: i64, expected: i64, actual: i64, pcx: &mut Ctx<Comp>) {
    if !is_distinct_type(expected, pcx) && !is_distinct_type(actual, pcx)
        || expected == pcx.ty_error
        || actual == pcx.ty_error || n == 0 || pcx.nodes[n as usize].end <= pcx.nodes[n as usize].start
        // RULE: D21.3 (an `impl Tr` result converts to nothing: the plain
        // mismatch, rustc E0308)
        || crate::front::opaque::is_opaque(expected, pcx)
        || crate::front::opaque::is_opaque(actual, pcx) {
        return;
    }
    // (0.20) bytes where std's `str` goes: checked, not converted
    if expected == pcx.str_type && !is_distinct_type(actual, pcx)
        && actual == pcx.types[expected as usize].a {
        let text = &get_src()[pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
        let saved = pcx.err_kind;
        pcx.err_kind = DISTINCT_MIX;
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_fmt({ let text = str::from_utf8(text).unwrap(); format_args("'{text}' is '[u8]' where 'str' goes") }, pcx);
        err_help(c"a `str` is UTF-8: bytes become one through `str::from_utf8(b)` (a Result, Utf8Error when they are not); a literal with \\x80..\\xff escapes is `[u8]`", pcx);
        if from_utf8_try_fits(pcx) {
            err_try_fmt({ let text = str::from_utf8(text).unwrap(); format_args("str::from_utf8({text})?") }, pcx);
        } else {
            err_help(c"; not with '?' here: the function does not return a Result whose error takes a Utf8Error (match the Result, or make the value a str where it comes from)", pcx);
        }
        err_end_soft(pcx);
        pcx.err_kind = saved;
        err_jump(pcx)
    }
    // RULE: F0.6 (0.27.5: a `&str` where a `&[u8]` goes, in the rust
    // edition: a mismatch, rustc E0308, with its conversion)
    if is_view_distinct(actual, pcx) && pcx.types[actual as usize].a == expected
        && crate::front::check::rust::rust_node(n, pcx) {
        let text = &get_src()[pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_str(c"mismatched types: expected `&[u8]`, found `&str`", pcx);
        if is_string_literal(n, pcx) {
            err_help(c"a byte string literal is a `&[u8]` (rustc E0308)", pcx);
            err_try_fmt({ let text = str::from_utf8(text).unwrap(); format_args("b{text}") }, pcx);
        } else {
            err_help(c"its bytes are `as_bytes()` (rustc E0308)", pcx);
            err_try_fmt({ let text = str::from_utf8(text).unwrap(); format_args("{text}.as_bytes()") }, pcx);
        }
        err_end_soft(pcx);
        err_jump(pcx)
    }
    let be = strip_distinct(expected, pcx);
    let ba = strip_distinct(actual, pcx);
    if be != ba && !(is_numeric(be) && is_numeric(ba)) {
        return;
    }
    let saved = pcx.err_kind;
    pcx.err_kind = DISTINCT_MIX;
    let te = buf_new();
    buf_type(te, expected, pcx);
    let ta = buf_new();
    buf_type(ta, actual, pcx);
    let b = pcx.binary_node;
    let in_binary = b != 0 && (pcx.nodes[b as usize].b == n || pcx.nodes[b as usize].c == n);
    // What is converted, to what: in an operation, the operand that is
    // not distinct, to the other's type.
    let mut target = n;
    let mut to = te;
    if in_binary && is_distinct_type(actual, pcx) && !is_distinct_type(expected, pcx) {
        target = if pcx.nodes[b as usize].b == n { pcx.nodes[b as usize].c } else { pcx.nodes[b as usize].b };
        to = ta;
    }
    let conv = conversion(target, buf_slice(to), pcx);
    err_begin(pcx.nodes[n as usize].start, pcx);
    if in_binary {
        let whole = &get_src()[pcx.nodes[b as usize].start as usize..pcx.nodes[b as usize].end as usize];
        let left = pcx.nodes[b as usize].b == n;
        let lt = if left { buf_slice(ta) } else { buf_slice(te) };
        let rt = if left { buf_slice(te) } else { buf_slice(ta) };
        err_fmt({ let whole = str::from_utf8(whole).unwrap(); { let lt = str::from_utf8(lt).unwrap(); { let rt = str::from_utf8(rt).unwrap(); format_args("'{whole}' mixes '{lt}' and '{rt}'") } } }, pcx);
        err_help(c"a distinct type's operators take two of it (or one and a literal): convert the other operand with 'as' (free)", pcx);
        let before = &get_src()[pcx.nodes[b as usize].start as usize..pcx.nodes[target as usize].start as usize];
        let after = &get_src()[pcx.nodes[target as usize].end as usize..pcx.nodes[b as usize].end as usize];
        err_try_fmt({ let before = str::from_utf8(before).unwrap(); { let after = str::from_utf8(after).unwrap(); format_args("{before}{}{after}", str::from_utf8(buf_slice(conv)).unwrap()) } }, pcx);
    } else {
        let text = &get_src()[pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
        err_fmt({ let text = str::from_utf8(text).unwrap(); format_args("'{text}' is '{}' where '{}' goes", str::from_utf8(buf_slice(ta)).unwrap(), str::from_utf8(buf_slice(te)).unwrap()) }, pcx);
        err_help(
            c"a distinct type and its underlying type do not mix: convert with 'as' (free)", pcx);
        err_try_fmt(str::from_utf8(buf_slice(conv)).unwrap(), pcx);
    }
    err_fix(pcx.nodes[target as usize].start, pcx.nodes[target as usize].end, buf_slice(conv), pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
    err_jump(pcx)
}

// `x as T` for expression node n (in parentheses when an operator would
// bind it), in a new buffer.
fn conversion(n: i64, to: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let text = &get_src()[pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
    let k = pcx.nodes[n as usize].kind;
    let simple = !(k == NodeKind::Binary || k == NodeKind::Unary || k == NodeKind::Cast
        || k == NodeKind::Range || k == NodeKind::If || k == NodeKind::Match
        || k == NodeKind::Block || k == NodeKind::Closure);
    let out = buf_new();
    if simple {
        buf_fmt(out, { let text = str::from_utf8(text).unwrap(); { let to = str::from_utf8(to).unwrap(); format_args("{text} as {to}") } });
    } else {
        buf_fmt(out, { let text = str::from_utf8(text).unwrap(); { let to = str::from_utf8(to).unwrap(); format_args("({text}) as {to}") } });
    }
    out
}

// `x.name(..)` (call n, receiver node `receiver`) where x is of distinct
// type t, which has no method `name`: distinct.method when t's underlying
// type has it. Returns otherwise.
pub fn distinct_method_error(n: i64, receiver: i64, t: i64, name: i64, pcx: &mut Ctx<Comp>) {
    if !is_distinct_type(t, pcx) {
        return;
    }
    let base = strip_distinct(t, pcx);
    if crate::front::check::calls::method_of(base, name, pcx) < 0 {
        return;
    }
    let saved = pcx.err_kind;
    pcx.err_kind = DISTINCT_METHOD;
    let tt = buf_new();
    buf_type(tt, t, pcx);
    let tb = buf_new();
    buf_type(tb, base, pcx);
    let text = &get_src()[pcx.nodes[receiver as usize].start as usize..pcx.nodes[receiver as usize].end as usize];
    let mname = sym_text(name, pcx);
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_fmt({ let mname = str::from_utf8(mname).unwrap(); format_args("'{mname}' is a method of '{}', not of '{}'", str::from_utf8(buf_slice(tb)).unwrap(),
        str::from_utf8(buf_slice(tt)).unwrap()) }, pcx);
    err_help(c"a distinct type has only the methods its own impl gives it: convert to call the underlying type's", pcx);
    let conv = buf_new();
    buf_fmt(conv, { let text = str::from_utf8(text).unwrap(); format_args("({text} as {})", str::from_utf8(buf_slice(tb)).unwrap()) });
    err_try_fmt({ let mname = str::from_utf8(mname).unwrap(); format_args("{}.{mname}(..)", str::from_utf8(buf_slice(conv)).unwrap()) }, pcx);
    err_fix(pcx.nodes[receiver as usize].start, pcx.nodes[receiver as usize].end, buf_slice(conv), pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
    err_jump(pcx)
}

// ---- The traits ----

// Whether distinct type t has trait tr without an impl: Eq, Ord, Hash,
// Debug, Display and Clone, when its underlying type has them.
pub fn distinct_inherits(tr: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    let names: [*mut u8; 6] = [c"Eq", c"Ord", c"Hash", c"Debug", c"Display", c"Clone"];
    for i in 0..6 {
        if tr == std_trait(names[i as usize], pcx) {
            return implements(tr, pcx.types[t as usize].a, pcx);
        }
    }
    false
}

// std's function that `x.name(..)` calls, x of distinct type t without
// an impl of the method's trait (0: none): distinct_eq, distinct_cmp,
// distinct_hash, distinct_fmt, distinct_fmt_debug or distinct_clone
// (std/clone.vl), with t and its underlying type as arguments.
pub fn distinct_helper(t: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let text = sym_text(name, pcx);
    let tr = if text == b"eq" { c"Eq" } else if text == b"cmp" { c"Ord" }
        else if text == b"hash" { c"Hash" } else if text == b"fmt" { c"Display" }
        else if text == b"fmt_debug" { c"Debug" } else if text == b"clone" { c"Clone" }
        else { return 0; };
    if !implements(std_trait(tr, pcx), pcx.types[t as usize].a, pcx) {
        return 0;
    }
    let b = buf_new();
    buf_fmt(b, { let text = str::from_utf8(text).unwrap(); format_args("distinct_{text}") });
    intern(buf_slice(b), pcx)
}

// The symbol prefix of the methods of generic distinct template tpl
// (`impl<T> NonNull<T>`): its alias's symbol.
pub fn distinct_tpl_symbol(tpl: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let alias = tpl - crate::front::generics::TPL_DISTINCT;
    crate::front::modules::item_symbol(module_of(alias, pcx), pcx.nodes[alias as usize].a, pcx)
}

// ---- `p.is_null()` ----

// `p.is_null()` (call n, p of raw pointer type, checked): becomes
// `p as u64 == 0`; its type.
pub fn null_test(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let receiver = pcx.nodes[n as usize].a;
    let (start, end) = (pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
    pcx.nodes[receiver as usize].p |= NODE_CHECKED;
    let u64_name = new_node(NodeKind::TyName, start, end, pcx);
    pcx.nodes[u64_name as usize].a = intern_c(c"u64", pcx);
    let cast = new_node(NodeKind::Cast, start, end, pcx);
    pcx.nodes[cast as usize].a = receiver;
    pcx.nodes[cast as usize].b = u64_name;
    let zero = new_node(NodeKind::Int, start, end, pcx);
    pcx.nodes[zero as usize].b = SUF_NONE;
    let test = new_node(NodeKind::Binary, start, end, pcx);
    pcx.nodes[test as usize].op = Tok::EqEq;
    pcx.nodes[test as usize].b = cast;
    pcx.nodes[test as usize].c = zero;
    let ty = crate::front::check::synth_mode::synth_expr(test, pcx);
    pcx.nodes[n as usize] = pcx.nodes[test as usize];
    ty
}

// ---- `p as NonNull<T>`, checked ----

// `p as NonNull<T>` (cast n, p a raw pointer, checked, to type `to`): a
// null p is a run-time failure, as `n as E` of a value E lacks is; the
// niche would read `Some(p)` back as None otherwise. It becomes
//     { let ==nn = p; if ==nn as u64 == 0 { <panic> } ==nn }
pub fn nonnull_cast(n: i64, operand: i64, to: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let (start, end) = (pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
    let name = intern_c(c"==nn", pcx);
    pcx.nodes[operand as usize].p |= NODE_CHECKED;
    let bind = new_node(NodeKind::PatBind, start, end, pcx);
    pcx.nodes[bind as usize].a = name;
    let let_p = new_node(NodeKind::Let, start, end, pcx);
    pcx.nodes[let_p as usize].a = bind;
    pcx.nodes[let_p as usize].c = operand;
    let u64_name = new_node(NodeKind::TyName, start, end, pcx);
    pcx.nodes[u64_name as usize].a = intern_c(c"u64", pcx);
    let cast = new_node(NodeKind::Cast, start, end, pcx);
    pcx.nodes[cast as usize].a = local_ident(name, n, pcx);
    pcx.nodes[cast as usize].b = u64_name;
    let zero = new_node(NodeKind::Int, start, end, pcx);
    pcx.nodes[zero as usize].b = SUF_NONE;
    let test = new_node(NodeKind::Binary, start, end, pcx);
    pcx.nodes[test as usize].op = Tok::EqEq;
    pcx.nodes[test as usize].b = cast;
    pcx.nodes[test as usize].c = zero;
    let panic = new_node(NodeKind::EnumPanic, start, end, pcx);
    pcx.nodes[panic as usize].a = local_ident(name, n, pcx);
    pcx.nodes[panic as usize].x = message_kind(fixed_message(b"null pointer made NonNull\n", pcx), pcx);
    let then = new_node(NodeKind::Block, start, end, pcx);
    let tmark = list_begin(pcx);
    list_push(expr_stmt(panic, pcx), pcx);
    list_end(then, tmark, pcx);
    let check = new_node(NodeKind::If, start, end, pcx);
    pcx.nodes[check as usize].a = test;
    pcx.nodes[check as usize].b = then;
    let block = new_node(NodeKind::Block, start, end, pcx);
    let mark = list_begin(pcx);
    list_push(let_p, pcx);
    list_push(expr_stmt(check, pcx), pcx);
    list_end(block, mark, pcx);
    pcx.nodes[block as usize].a = local_ident(name, n, pcx);
    crate::front::check::synth_mode::synth_expr(block, pcx);
    pcx.nodes[n as usize] = pcx.nodes[block as usize];
    to
}

fn local_ident(name: i64, at: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Ident, pcx.nodes[at as usize].start, pcx.nodes[at as usize].end, pcx);
    pcx.nodes[n as usize].a = name;
    n
}

fn expr_stmt(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let s = new_node(NodeKind::ExprStmt, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, pcx);
    pcx.nodes[s as usize].a = e;
    pcx.nodes[s as usize].b = 1;
    s
}

// ---- Erasure ----

// Once the program checks: every distinct type replaced by its
// underlying type where the code generators read types
// (front/distinct.vl).
pub fn erase_program_types(pcx: &mut Ctx<Comp>) {
    if !pcx.any_distinct {
        return;
    }
    // (the niche is decided while the variants' types are distinct)
    for e in 0..pcx.enum_count {
        enum_niche(e, pcx);
    }
    erase_all_types(pcx);
}

// (0.20) Before the own pass: std's `str` (a distinct type over `[u8]`)
// replaced by `[u8]` everywhere, so that the own pass checks it as the
// view it is; other distinct types stay until erase_program_types.
pub fn erase_view_distincts(pcx: &mut Ctx<Comp>) {
    if !pcx.any_view_distinct {
        return;
    }
    pcx.erase_views_only = true;
    reset_erased(pcx);
    erase_all_types(pcx);
    pcx.erase_views_only = false;
    reset_erased(pcx);
}

// The types of every node, field, function, variant, static, constant and
// local, erased (erase_type, in its mode).
fn erase_all_types(pcx: &mut Ctx<Comp>) {
    unsafe {
        let types = type_count(pcx);
        for n in 0..pcx.nodes.len() {
            let t = pcx.nodes[n].ty;
            if t > 0 && t < types {
                pcx.nodes[n].ty = erase_type(t, pcx);
            }
        }
        for i in 0..pcx.field_count {
            (*get_fields().add(i as usize)).ty = erase_type((*get_fields().add(i as usize)).ty, pcx);
        }
        for f in 0..pcx.fns.len() as i64 {
            pcx.fns[f as usize].ret = erase_type(pcx.fns[f as usize].ret, pcx);
            pcx.fns[f as usize].self_ty = erase_type(pcx.fns[f as usize].self_ty, pcx);
            pcx.fns[f as usize].params = erase_list(pcx.fns[f as usize].params, pcx.fns[f as usize].param_count, pcx);
        }
        for v in 0..pcx.variants.len() as i64 {
            pcx.variants[v as usize].fields = erase_list(pcx.variants[v as usize].fields, pcx.variants[v as usize].field_count,
                pcx);
            pcx.variants[v as usize].shape = erase_type(pcx.variants[v as usize].shape, pcx);
        }
        for i in 0..pcx.statics.len() as i64 {
            pcx.statics[i as usize].ty = erase_type(pcx.statics[i as usize].ty, pcx);
        }
        for i in 0..pcx.consts.len() as i64 {
            pcx.consts[i as usize].ty = erase_type(pcx.consts[i as usize].ty, pcx);
        }
        for i in 0..pcx.locals.len() as i64 {
            pcx.locals[i as usize].ty = erase_type(pcx.locals[i as usize].ty, pcx);
        }
    }
}
