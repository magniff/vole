// `for` over slices, arrays, iterators and ranges as values (0.14;
// docs/design/closures-iterators.md): `for p in e` where e is not a range
// literal goes through check_for_iter; `a..b` and `a..=b` outside `for`
// and slicing are std's Range and RangeInclusive (range_value).
//
// `for p in e body` becomes a block whose first statement binds e's value
// to `__for_seq`, then a loop over it by e's type:
//
//   slice, array          for __for_index in 0..len { let p = __for_seq[__for_index]; body }
//   *slice, *array        for p in *__for_seq body
//   std's Vec, SliceIter  for p in __for_seq.as_slice() body
//   std's Range           for p in __for_seq.start..__for_seq.end body
//   std's RangeInclusive  if !__for_seq.done { for p in __for_seq.start..=__for_seq.end body }
//   an Iterator           label: loop { match __for_seq.next() { std::Option::Some(p) => body, _ => break } }
//   a type with `iter`    for p in __for_seq.iter() body
//
// (`*T` for a struct or enum T: the same, through the pointer.) e is
// checked once, by the caller; the `let` is checked here, so that the
// rest, made of new nodes, is the only part checked after it. The
// counted forms stay counted loops, with no `next` call. `iter` is found
// by name (Vec, HashMap, user types); `next` only through Iterator.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_help, err_str};
use crate::front::ast::{ARM_SYNTHETIC, NODE_IN_BOUNDS, list_begin, list_end, list_push, new_node};
use crate::front::ast::NodeKind::{
    Arm, Block, Break, ExprStmt, FieldAccess, FieldInit, For, Ident, If, Index, Int, Let, Loop,
    Match, MethodCall, PatBind, PatVariant, PatWild, Path, Range, StructLit, Unary,
};
use crate::front::check::{pop_scope, push_scope};
use crate::front::check::calls::method_of;
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::is_borrow;
use crate::front::drops::{after_stmt, block_begin};
use crate::front::lexer::{SUF_I64, SUF_USIZE, Tok};
use crate::front::modules::within_std;
use crate::front::patterns::check_pattern;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{
    REF_MUT, REF_SHARED, TY_UNIT, TyKind, buf_type, err_type, is_pointer, struct_field,
};

// On a `for` made by the `iter` form: its sequence is the result of
// `iter()`, which must not need another `iter()`.
const FOR_VIA_ITER: i64 = 1 << 29;
// (0.27.0) On a `for` of the rust edition over a reference to elements
// (`&[T]`, `&Vec<T, A>`, `&[T; N]`, their `&mut`): its items are `&T`
// (`&mut T`), Rust's, not copies; kept on the `for` it is rewritten to.
const FOR_REFS: i64 = 1 << 56;
const FOR_REFS_MUT: i64 = 1 << 57;
// (0.27.0) ... and its items are values (`for x in v` of a Vec, an array).
const FOR_VALUES: i64 = 1 << 58;

// `for` loop n whose sequence (NODES[n].c) is checked (its type is set)
// and is not a range literal: the loop, rewritten in place as above. Its
// type.
pub fn check_for_iter(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut seq = pcx.nodes[n as usize].c;
    let mut seq_ty = pcx.nodes[seq as usize].ty;
    if seq_ty > 0 && pcx.types[seq_ty as usize].kind == TyKind::Array
        && !crate::front::cells::is_freeze(seq_ty, pcx)
        && crate::front::check::assign::is_place(seq, pcx) {
        // (0.26.1) an array place that is not Freeze is iterated as a
        // view of it, `for p in a[0..N]`: a copy of it would be other
        // cells (front/cells.vl)
        let lo = new_node(Int, pcx.nodes[seq as usize].start, pcx.nodes[seq as usize].end, pcx);
        pcx.nodes[lo as usize].b = SUF_I64;
        let hi = new_node(Int, pcx.nodes[seq as usize].start, pcx.nodes[seq as usize].end, pcx);
        pcx.nodes[hi as usize].a = pcx.types[seq_ty as usize].b;
        pcx.nodes[hi as usize].b = SUF_I64;
        let range = new_node(Range, pcx.nodes[seq as usize].start, pcx.nodes[seq as usize].end,
            pcx);
        pcx.nodes[range as usize].a = lo;
        pcx.nodes[range as usize].b = hi;
        let view = new_node(Index, pcx.nodes[seq as usize].start, pcx.nodes[seq as usize].end, pcx);
        pcx.nodes[view as usize].a = seq;
        pcx.nodes[view as usize].b = range;
        pcx.nodes[view as usize].p |= NODE_IN_BOUNDS;
        synth_expr(view, pcx);
        pcx.nodes[n as usize].c = view;
        seq = view;
        seq_ty = pcx.nodes[view as usize].ty;
    }
    // RULE: F22.1 (0.27.2: on std2, `for` is IntoIterator::into_iter and
    // Iterator::next, whatever the sequence)
    // (an array by value, `for x in [a, b]`, its elements by value: an
    // index loop, as IntoIterator for [T; N] would give; RULE: F22.1. Of
    // plain elements only: an owned element moved out by its index is not
    // a move the places IR follows, and the array's drop would free it
    // again; 0.27.3: such an array goes through IntoIterator, std2's
    // array::IntoIter, FL13, which moves it)
    let array_value = seq_ty > 0 && pcx.types[seq_ty as usize].kind == TyKind::Array
        && crate::front::kinds::is_plain_type(pcx.types[seq_ty as usize].a, pcx);
    if seq_ty != pcx.ty_error && !array_value {
        return rust_for(n, seq, seq_ty, pcx);
    }
    let mut t = seq_ty;
    let through = is_pointer(t, pcx) && pcx.types[t as usize].a != 0
        && is_iterable_kind(pcx.types[pcx.types[t as usize].a as usize].kind);
    if through {
        t = pcx.types[t as usize].a;
    }
    // (0.27.0: the rust edition's items by reference)
    let mut refs = pcx.nodes[n as usize].p & (FOR_REFS | FOR_REFS_MUT | FOR_VALUES);
    if refs == 0
        && seq_ty > 0 {
        let k = pcx.types[seq_ty as usize].b;
        let by_ref = through || pcx.types[seq_ty as usize].kind == TyKind::Slice;
        refs = if by_ref && k == REF_MUT { FOR_REFS | FOR_REFS_MUT }
            else if by_ref && (k == REF_SHARED || pcx.types[seq_ty as usize].kind == TyKind::Slice)
            || !through && std_struct_name(t, pcx) == intern_c(c"SliceIter", pcx) { FOR_REFS }
            else { FOR_VALUES };
    }
    let kind = pcx.types[t as usize].kind;
    let std_name = std_struct_name(t, pcx);
    let iterator = std_trait(c"Iterator", pcx);
    let is_iterator = seq_ty != pcx.ty_error && iterator >= 0 && implements(iterator, t, pcx);
    let iter_f: i64 = if seq_ty == pcx.ty_error { -1 }
        else { method_of(t, intern_c(c"iter", pcx), pcx) };
    let is_slice = kind == TyKind::Slice || kind == TyKind::Array;
    let counted = std_name == intern_c(c"Vec", pcx) || std_name == intern_c(c"SliceIter", pcx)
        || std_name == intern_c(c"Range", pcx)
        || std_name == intern_c(c"RangeInclusive", pcx);
    if seq_ty == pcx.ty_error || !is_slice && !counted && !is_iterator
        && (iter_f < 0 || (pcx.nodes[n as usize].p & FOR_VIA_ITER) != 0) {
        not_iterable(n, seq, seq_ty, t, pcx);
    }
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let seq_sym = intern_c(c"__for_seq", pcx);
    // let __for_seq = e;   (`mut` for `next`)
    let bind = new_node(PatBind, start, end, pcx);
    pcx.nodes[bind as usize].a = seq_sym;
    let by_next = !is_slice && !counted && is_iterator;
    pcx.nodes[bind as usize].b = (by_next && !through) as i64;
    let let_stmt = new_node(Let, start, end, pcx);
    pcx.nodes[let_stmt as usize].a = bind;
    pcx.nodes[let_stmt as usize].c = seq;
    // The loop over it.
    let pattern = pcx.nodes[n as usize].b;
    let body = pcx.nodes[n as usize].d;
    let mut rest: i64 = 0;
    if is_slice && !through {
        rest = index_loop(n, seq_ty, refs & (FOR_REFS | FOR_REFS_MUT), pcx);
    } else if is_slice && (refs & FOR_REFS) != 0 && kind == TyKind::Array {
        // (the rust edition: `&a` of an array, its elements by reference)
        rest = for_copy(n, pattern, full_slice(deref(ident(seq_sym, n, pcx), pcx), pcx),
            body, pcx);
    } else if is_slice {
        rest = for_copy(n, pattern, deref(ident(seq_sym, n, pcx), pcx), body, pcx);
    } else if std_name == intern_c(c"Vec", pcx) || std_name == intern_c(c"SliceIter", pcx) {
        let slice = if (refs & FOR_REFS_MUT) != 0 && std_name == intern_c(c"Vec", pcx) {
            c"as_mut_slice"
        } else { c"as_slice" };
        rest = for_copy(n, pattern,
            method_call(ident(seq_sym, n, pcx), intern_c(slice, pcx), pcx), body, pcx);
    }
    else if std_name == intern_c(c"Range", pcx)
        || std_name == intern_c(c"RangeInclusive", pcx) {
        let range = new_node(Range, start, end, pcx);
        pcx.nodes[range as usize].a = field(ident(seq_sym, n, pcx), intern_c(c"start", pcx), pcx);
        pcx.nodes[range as usize].b = field(ident(seq_sym, n, pcx), intern_c(c"end", pcx), pcx);
        let inclusive = std_name == intern_c(c"RangeInclusive", pcx);
        pcx.nodes[range as usize].c = inclusive as i64;
        rest = for_copy(n, pattern, range, body, pcx);
        if inclusive {
            // (exhausted by `next`: no more items)
            let not_done = new_node(Unary, start, end, pcx);
            pcx.nodes[not_done as usize].op = Tok::Bang;
            pcx.nodes[not_done as usize].b = field(ident(seq_sym, n, pcx), intern_c(c"done", pcx),
                pcx);
            let then = block_of(rest, n, pcx);
            rest = new_node(If, start, end, pcx);
            pcx.nodes[rest as usize].a = not_done;
            pcx.nodes[rest as usize].b = then;
        }
    } else if is_iterator {
        rest = next_loop(n, ident(seq_sym, n, pcx), false, pcx);
    } else {
        rest = for_copy(n, pattern,
            method_call(ident(seq_sym, n, pcx), intern_c(c"iter", pcx), pcx), body, pcx);
        pcx.nodes[rest as usize].p |= FOR_VIA_ITER;
    }
    if refs != 0 && pcx.nodes[rest as usize].kind == For {
        pcx.nodes[rest as usize].p |= refs;
    }
    let rest_stmt = new_node(ExprStmt, start, end, pcx);
    pcx.nodes[rest_stmt as usize].a = rest;
    pcx.nodes[rest_stmt as usize].b = 1;
    // The block, in the loop's place, checked: the `let` by hand (e is
    // checked), then the rest.
    let outer = new_node(Block, start, end, pcx);
    let mark = list_begin(pcx);
    list_push(let_stmt, pcx);
    list_push(rest_stmt, pcx);
    list_end(outer, mark, pcx);
    pcx.nodes[n as usize] = pcx.nodes[outer as usize];
    push_scope(pcx);
    // (0.25: as check_block does, the temporaries of the `let`; a
    // sequence that is not a place, `for x in make()`, `for x in
    // v.take()`, an owning iterator, is __for_seq's, which the places
    // IR drops at the loop's end, on every exit; a place, `for x in v`,
    // is borrowed)
    let drops = block_begin(n, pcx);
    check_pattern(bind, seq_ty, pcx);
    if through && is_borrow(seq, pcx) {
        // (`for x in &v`: a borrow, as `&v` passed directly is)
        { let at_ix = pcx.nodes[bind as usize].x as usize; pcx.locals[at_ix].borrow = true };
    }
    after_stmt(drops, let_stmt, pcx);
    synth_expr(rest, pcx);
    pop_scope(pcx);
    pcx.nodes[n as usize].ty = TY_UNIT;
    TY_UNIT
}

// RULE: E2.1 (0.28.0) Whether an iterator of type t ends by itself: one
// of std's over a slice, a Vec, an array, a map or a set, a string's
// characters, bytes, lines or pieces, or a range with an end; or one of
// std's adapters over such (`map`, `filter`, `rev`, `enumerate`, ..: it
// ends when its inner iterator does; `zip` when both do). A `for` over
// one is a counted loop, as MVS's `for` over a slice, a Vec or a range
// was, and so is a `while let Some(p) = it.next()` whose body does not
// use `it` (effects/infer.vl walk_loop): the loop is no `diverge` (what
// `next` and the body do is theirs). A program's, `chain`, `flat_map`,
// `cycle` or an endless one's (`0..`, `repeat`) is a loop.
pub fn ends_by_itself(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let name = std_struct_name(t, pcx);
    if name == 0 {
        return false;
    }
    let s = crate::base::sym_text(name, pcx);
    if s == b"Iter" || s == b"IterMut" || s == b"IntoIter" || s == b"Range"
        || s == b"RangeInclusive" || s == b"Chars" || s == b"Bytes" || s == b"Keys"
        || s == b"Values" || s == b"ValuesMut" || s == b"CharIndices" || s == b"Lines"
        || s == b"SplitWhitespace" || s == b"Split" || s == b"Windows" || s == b"Chunks"
        || s == b"Drain" {
        return true;
    }
    let both = s == b"Zip";
    let inner = both || s == b"Map" || s == b"Filter" || s == b"FilterMap" || s == b"Enumerate"
        || s == b"Take" || s == b"Skip" || s == b"TakeWhile" || s == b"SkipWhile"
        || s == b"MapWhile" || s == b"StepBy" || s == b"Peekable" || s == b"Rev" || s == b"Copied"
        || s == b"Cloned" || s == b"Inspect" || s == b"Scan";
    let st = pcx.types[t as usize].a;
    if !inner || pcx.structs[st as usize].field_count < (if both { 2 } else { 1 }) {
        return false;
    }
    let first = (struct_field(st, 0, pcx)).ty;
    if !ends_by_itself(first, pcx) {
        return false;
    }
    if !both {
        return true;
    }
    let second = (struct_field(st, 1, pcx)).ty;
    ends_by_itself(second, pcx)
}

// (0.27.2) `for pat in e body` of a rust program on std2, rewritten in
// place as
//     { let __for_seq = e;
//       { let mut __for_it = __for_seq.into_iter();
//         loop { match __for_it.next() { Some(pat) => body, _ => break } } } }
// (e is checked already; `into_iter` is IntoIterator's, by the probe:
// `impl<I: Iterator> IntoIterator for I` for an iterator, `for &'a
// Vec<T, A>` for `&v`). Its type. RULE: F22.1
fn rust_for(n: i64, seq: i64, seq_ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let seq_sym = intern_c(c"__for_seq", pcx);
    let it_sym = intern_c(c"__for_it", pcx);
    let bind = new_node(PatBind, start, end, pcx);
    pcx.nodes[bind as usize].a = seq_sym;
    let let_stmt = new_node(Let, start, end, pcx);
    pcx.nodes[let_stmt as usize].a = bind;
    pcx.nodes[let_stmt as usize].c = seq;
    let it_bind = new_node(PatBind, start, end, pcx);
    pcx.nodes[it_bind as usize].a = it_sym;
    pcx.nodes[it_bind as usize].b = 1;
    let it_let = new_node(Let, start, end, pcx);
    pcx.nodes[it_let as usize].a = it_bind;
    pcx.nodes[it_let as usize].c = method_call(ident(seq_sym, n, pcx), intern_c(c"into_iter", pcx),
        pcx);
    let lp = next_loop(n, ident(it_sym, n, pcx), true, pcx);
    let lp_stmt = new_node(ExprStmt, start, end, pcx);
    pcx.nodes[lp_stmt as usize].a = lp;
    pcx.nodes[lp_stmt as usize].b = 1;
    let rest = new_node(Block, start, end, pcx);
    let rmark = list_begin(pcx);
    list_push(it_let, pcx);
    list_push(lp_stmt, pcx);
    list_end(rest, rmark, pcx);
    let rest_stmt = new_node(ExprStmt, start, end, pcx);
    pcx.nodes[rest_stmt as usize].a = rest;
    pcx.nodes[rest_stmt as usize].b = 1;
    let outer = new_node(Block, start, end, pcx);
    let mark = list_begin(pcx);
    list_push(let_stmt, pcx);
    list_push(rest_stmt, pcx);
    list_end(outer, mark, pcx);
    pcx.nodes[n as usize] = pcx.nodes[outer as usize];
    push_scope(pcx);
    let drops = block_begin(n, pcx);
    check_pattern(bind, seq_ty, pcx);
    if is_borrow(seq, pcx) {
        { let at_ix = pcx.nodes[bind as usize].x as usize; pcx.locals[at_ix].borrow = true };
    }
    after_stmt(drops, let_stmt, pcx);
    synth_expr(rest, pcx);
    if ends_by_itself(pcx.nodes[pcx.nodes[it_let as usize].c as usize].ty, pcx) {
        pcx.nodes[lp as usize].p |= NODE_IN_BOUNDS;
    }
    pop_scope(pcx);
    pcx.nodes[n as usize].ty = TY_UNIT;
    TY_UNIT
}

// Whether a pointer to a type of this kind is iterated through.
fn is_iterable_kind(kind: TyKind) -> bool {
    kind == TyKind::Struct || kind == TyKind::Enum || kind == TyKind::Slice
        || kind == TyKind::Array
}

// The name of std's generic struct that t is an instance of (Vec,
// Range, ...), or 0.
fn std_struct_name(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.std_module < 0 || pcx.types[t as usize].kind != TyKind::Struct {
        return 0;
    }
    let s = pcx.types[t as usize].a;
    if pcx.structs[s as usize].tmpl == 0 {
        return 0;
    }
    let tmpl = pcx.structs[s as usize].tmpl - 1;
    if !within_std(pcx.structs[tmpl as usize].module, pcx) {
        return 0;
    }
    pcx.structs[tmpl as usize].name
}

// (t: the type iterated, seq's or the one it points to)
fn not_iterable(n: i64, seq: i64, seq_ty: i64, t: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[seq as usize].start, pcx);
    err_str(c"'for' iterates over ranges, slices, arrays, iterators and types with an 'iter' method, got '", pcx);
    err_type(seq_ty, pcx);
    err_str(c"'", pcx);
    if (pcx.nodes[n as usize].p & FOR_VIA_ITER) != 0 {
        err_help(c"its 'iter()' gives a value that is not an Iterator", pcx);
    }
    else if pcx.types[t as usize].kind == TyKind::Struct
        || pcx.types[t as usize].kind == TyKind::Enum {
        if method_of(t, intern_c(c"next", pcx), pcx) >= 0 {
            err_help(
                c"it has a 'next' method but does not implement Iterator: write 'impl Iterator for ", pcx);
        } else {
            err_help(c"implement Iterator for it: 'impl Iterator for ", pcx);
        }
        buf_type(pcx.err_help, t, pcx);
        err_help(c" { type Item = ...; fn next(self: *Self) -> Option<Self::Item> { ... } }', or give it an 'iter' method that returns an iterator", pcx);
    }
    err_end(pcx)
}

// for __for_index in 0..len { let p = __for_seq[__for_index]; body }, for
// `for` loop n over a slice or an array of type t, bound to __for_seq.
fn index_loop(n: i64, t: i64, refs: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let seq_sym = intern_c(c"__for_seq", pcx);
    let index_sym = intern_c(c"__for_index", pcx);
    let zero = new_node(Int, start, end, pcx);
    pcx.nodes[zero as usize].b = SUF_USIZE;
    let len = if pcx.types[t as usize].kind == TyKind::Slice {
        field(ident(seq_sym, n, pcx), intern_c(c"len", pcx), pcx)
    } else {
        let count = new_node(Int, start, end, pcx);
        pcx.nodes[count as usize].a = pcx.types[t as usize].b;
        pcx.nodes[count as usize].b = SUF_USIZE;
        count
    };
    let range = new_node(Range, start, end, pcx);
    pcx.nodes[range as usize].a = zero;
    pcx.nodes[range as usize].b = len;
    // let p = __for_seq[__for_index];
    let elem = new_node(Index, start, end, pcx);
    pcx.nodes[elem as usize].a = ident(seq_sym, n, pcx);
    pcx.nodes[elem as usize].b = ident(index_sym, n, pcx);
    // (0.16: no panic, for the effects)
    pcx.nodes[elem as usize].p |= NODE_IN_BOUNDS;
    let elem_let = new_node(Let, start, end, pcx);
    pcx.nodes[elem_let as usize].a = pcx.nodes[n as usize].b;
    pcx.nodes[elem_let as usize].c = elem;
    if refs != 0 {
        // (0.27.0) `let p = &__for_seq[__for_index];` (`&mut`), Rust's items
        let r = new_node(Unary, start, end, pcx);
        pcx.nodes[r as usize].op = Tok::Amp;
        pcx.nodes[r as usize].b = elem;
        pcx.nodes[r as usize].p |= if (refs & FOR_REFS_MUT) != 0 {
            crate::front::ast::NODE_REF | crate::front::ast::NODE_REF_MUT
        } else { crate::front::ast::NODE_REF };
        pcx.nodes[elem_let as usize].c = r;
    }
    let body = new_node(Block, start, end, pcx);
    let mark = list_begin(pcx);
    list_push(elem_let, pcx);
    let old_body = new_node(ExprStmt, start, end, pcx);
    pcx.nodes[old_body as usize].a = pcx.nodes[n as usize].d;
    list_push(old_body, pcx);
    list_end(body, mark, pcx);
    let index_bind = new_node(PatBind, start, end, pcx);
    pcx.nodes[index_bind as usize].a = index_sym;
    for_copy(n, index_bind, range, body, pcx)
}

// label: loop { match it.next() { std::Option::Some(p) => body, _ => break } }
// for `for` loop n (its label, pattern and body).
fn next_loop(n: i64, it: i64, std2: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let m = new_node(Match, start, end, pcx);
    pcx.nodes[m as usize].a = method_call(it, intern_c(c"next", pcx), pcx);
    let some = new_node(PatVariant, start, end, pcx);
    let std_seg = ident(intern_c(c"std", pcx), n, pcx);
    let prefix = new_node(Path, start, end, pcx);
    let pmark = list_begin(pcx);
    list_push(std_seg, pcx);
    if std2 {
        // (std2's Option is std::option::Option)
        list_push(ident(intern_c(c"option", pcx), n, pcx), pcx);
    }
    list_end(prefix, pmark, pcx);
    pcx.nodes[some as usize].h = prefix;
    pcx.nodes[some as usize].a = intern_c(c"Option", pcx);
    pcx.nodes[some as usize].b = intern_c(c"Some", pcx);
    pcx.nodes[some as usize].c = 1;
    let smark = list_begin(pcx);
    list_push(pcx.nodes[n as usize].b, pcx);
    list_end(some, smark, pcx);
    let some_arm = new_node(Arm, start, end, pcx);
    pcx.nodes[some_arm as usize].a = some;
    pcx.nodes[some_arm as usize].c = pcx.nodes[n as usize].d;
    let brk = new_node(Break, end, end, pcx);
    let wild = new_node(PatWild, end, end, pcx);
    let none_arm = new_node(Arm, end, end, pcx);
    pcx.nodes[none_arm as usize].a = wild;
    pcx.nodes[none_arm as usize].c = brk;
    pcx.nodes[none_arm as usize].p = ARM_SYNTHETIC;
    let amark = list_begin(pcx);
    list_push(some_arm, pcx);
    list_push(none_arm, pcx);
    list_end(m, amark, pcx);
    let lp = new_node(Loop, start, end, pcx);
    pcx.nodes[lp as usize].a = pcx.nodes[n as usize].a;
    pcx.nodes[lp as usize].b = block_of_tail(m, n, pcx);
    lp
}

// A copy of `for` loop n (its label) as `for pattern in seq body`.
fn for_copy(n: i64, pattern: i64, seq: i64, body: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let f = new_node(For, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx);
    pcx.nodes[f as usize] = pcx.nodes[n as usize];
    pcx.nodes[f as usize].b = pattern;
    pcx.nodes[f as usize].c = seq;
    pcx.nodes[f as usize].d = body;
    pcx.nodes[f as usize].p = pcx.nodes[n as usize].p & !FOR_VIA_ITER;
    pcx.nodes[f as usize].ty = 0;
    f
}

fn ident(sym: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let id = new_node(Ident, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx);
    pcx.nodes[id as usize].a = sym;
    id
}

fn field(obj: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let f = new_node(FieldAccess, pcx.nodes[obj as usize].start, pcx.nodes[obj as usize].end, pcx);
    pcx.nodes[f as usize].a = obj;
    pcx.nodes[f as usize].b = name;
    f
}

fn deref(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let u = new_node(Unary, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, pcx);
    pcx.nodes[u as usize].op = Tok::Star;
    pcx.nodes[u as usize].b = e;
    u
}

// `e[..]`: the whole of array e, a slice.
fn full_slice(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let range = new_node(Range, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, pcx);
    let s = new_node(Index, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, pcx);
    pcx.nodes[s as usize].a = e;
    pcx.nodes[s as usize].b = range;
    s
}

// `receiver.name()`.
fn method_call(receiver: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let c = new_node(MethodCall, pcx.nodes[receiver as usize].start,
        pcx.nodes[receiver as usize].end, pcx);
    pcx.nodes[c as usize].a = receiver;
    pcx.nodes[c as usize].b = name;
    let mark = list_begin(pcx);
    list_end(c, mark, pcx);
    c
}

// `{ e }` (e: a statement-like expression, for loop n's position).
fn block_of(e: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let stmt = new_node(ExprStmt, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx);
    pcx.nodes[stmt as usize].a = e;
    pcx.nodes[stmt as usize].b = 1;
    let b = new_node(Block, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx);
    let mark = list_begin(pcx);
    list_push(stmt, pcx);
    list_end(b, mark, pcx);
    b
}

// `{ e }` with e as the tail.
fn block_of_tail(e: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = new_node(Block, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx);
    let mark = list_begin(pcx);
    list_end(b, mark, pcx);
    pcx.nodes[b as usize].a = e;
    b
}

// RULE: Z3.1 (0.27.2) Range n as a value on std2: std2's ops types,
// `std::ops::Range { start: a, end: b }`, `RangeFrom { start }`,
// `RangeTo { end }`, `RangeToInclusive { end }`, `RangeFull {}`, and
// `std::ops::RangeInclusive::new(a, b)` (its fields are private, as
// Rust's), in its place. Its type.
pub fn range_value(n: i64, expected: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let inclusive = pcx.nodes[n as usize].c != 0;
    let lo = pcx.nodes[n as usize].a;
    let hi = pcx.nodes[n as usize].b;
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let name = if lo != 0 && hi != 0 && inclusive { c"RangeInclusive" }
        else if lo != 0 && hi != 0 { c"Range" }
        else if lo != 0 { c"RangeFrom" }
        else if hi != 0 && inclusive { c"RangeToInclusive" }
        else if hi != 0 { c"RangeTo" }
        else { c"RangeFull" };
    let type_sym = intern_c(name, pcx);
    let mut e: i64 = 0;
    if lo != 0 && hi != 0 && inclusive {
        // std::ops::RangeInclusive::new(a, b)
        let callee = new_node(Path, start, end, pcx);
        let pmark = list_begin(pcx);
        list_push(ident(intern_c(c"std", pcx), n, pcx), pcx);
        list_push(ident(intern_c(c"ops", pcx), n, pcx), pcx);
        list_push(ident(type_sym, n, pcx), pcx);
        list_push(ident(intern_c(c"new", pcx), n, pcx), pcx);
        list_end(callee, pmark, pcx);
        pcx.nodes[callee as usize].a = type_sym;
        pcx.nodes[callee as usize].b = intern_c(c"new", pcx);
        e = new_node(crate::front::ast::NodeKind::Call, start, end, pcx);
        pcx.nodes[e as usize].a = callee;
        let amark = list_begin(pcx);
        list_push(lo, pcx);
        list_push(hi, pcx);
        list_end(e, amark, pcx);
    } else {
        e = new_node(StructLit, start, end, pcx);
        pcx.nodes[e as usize].a = type_sym;
        let prefix = new_node(Path, start, end, pcx);
        let pmark = list_begin(pcx);
        list_push(ident(intern_c(c"std", pcx), n, pcx), pcx);
        list_push(ident(intern_c(c"ops", pcx), n, pcx), pcx);
        list_end(prefix, pmark, pcx);
        pcx.nodes[e as usize].h = prefix;
        let mark = list_begin(pcx);
        if lo != 0 {
            list_push(field_init(intern_c(c"start", pcx), lo, pcx), pcx);
        }
        if hi != 0 {
            list_push(field_init(intern_c(c"end", pcx), hi, pcx), pcx);
        }
        list_end(e, mark, pcx);
    }
    pcx.nodes[n as usize] = pcx.nodes[e as usize];
    if expected != 0 { check_expr(n, expected, pcx) } else { synth_expr(n, pcx) }
}

fn field_init(name: i64, value: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let f = new_node(FieldInit, pcx.nodes[value as usize].start, pcx.nodes[value as usize].end,
        pcx);
    pcx.nodes[f as usize].a = name;
    pcx.nodes[f as usize].b = value;
    f
}
