// (0.25.2, feedbacks/galaga.md #2) Mismatches whose cause is a literal's
// default type: `let col = if c { [1.0, 0.0, 0.0, 1.0] } else { .. };`
// makes col `[f64; 4]` (a float literal is f64, an integer one i64, where
// nothing gives their type), and each use of col where `[f32; 4]` goes
// failed far from the `let`, with no word of it. The first such error says
// where the type came from and gives the annotation to write (its try:
// line, and the fix `volec fix --suggested` makes); the later ones from
// the same `let` are not reported again while that error stands: one
// error per cause.

use crate::base::{IntVec, SourceFile, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, buf_uint};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_file_line, err_begin, err_end_soft, err_fix, err_help_fmt, err_note_at, err_str,
    err_try_tool, error_recorded_at,
};
use crate::front::ast::{Node, NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::{SUF_NONE, Tok};
use crate::front::modules::file_of_pos;
use crate::front::types::{
    TY_F64, TY_I32, TY_I64, TY_NEVER, TY_USIZE, TyKind, Type, array_of, buf_type, err_type, int_max,
    is_float, is_integer, is_signed, type_elem,
};

// For the mismatch at node n (a value of type actual where expected goes):
// whether its cause is the defaulted literals of a local's unannotated
// `let` (its name, or an element of it, `col[1]`); then literal_help may
// add the cause. Returns 1 for that, 2 when that `let`'s cause is reported
// already (the caller drops the error), 0 otherwise.
pub fn literal_let(n: i64, expected: i64, actual: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.name_start = -1;
    if n <= 0 || expected <= 0 || actual <= 0 || pcx.cur_fn < 0 {
        return 0;
    }
    let e = node(n, pcx);
    let mut ident = n;
    let mut want = expected;
    if e.kind == NodeKind::Index {
        ident = e.a;
    } else if e.kind != NodeKind::Ident {
        return 0;
    }
    let id = node(ident, pcx);
    if id.kind != NodeKind::Ident || id.res != Res::Local {
        return 0;
    }
    let had = local_type(id.y, pcx);
    if e.kind == NodeKind::Index {
        let h = type_info(had, pcx);
        if h.kind != TyKind::Array || h.a != actual {
            return 0;
        }
        want = array_of(expected, h.b, pcx);
    } else if had != actual {
        return 0;
    }
    // (only literals' types apart: f64 for another float, i64 for
    // another integer)
    let mut floats = false;
    let mut ints = false;
    if !defaulted_apart(had, want, &mut floats, &mut ints, pcx) || !(floats || ints) {
        return 0;
    }
    if !find_let(id.a, id.start, node(fn_node(pcx.cur_fn, pcx), pcx).start, pcx) {
        return 0;
    }
    if !init_has_literal(pcx.eq_end, floats, ints, pcx) {
        pcx.name_start = -1;
        return 0;
    }
    pcx.want = want;
    pcx.had = had;
    let mut k: i64 = 0;
    while k + 1 < pcx.literals_noted.count {
        if int_at(pcx.literals_noted, k) == pcx.name_start
            && error_recorded_at(int_at(pcx.literals_noted, k + 1), pcx) {
            return 2;
        }
        k += 2;
    }
    1
}

// The cause of the error at pos being made, after literal_let gave 1: a
// help naming the `let`, its try: line (the annotation, an edit patch)
// and its fix.
pub fn literal_help(pos: i64, pcx: &mut Ctx<Comp>) {
    if pcx.name_start < 0 {
        return;
    }
    pcx.literals_noted.push(pcx.name_start);
    pcx.literals_noted.push(pos);
    let name = src_text(pcx.name_start, pcx.name_end, pcx);
    let had = buf_new();
    buf_type(had, pcx.had, pcx);
    let want = buf_new();
    buf_type(want, pcx.want, pcx);
    // (0.25.3, eval 0.25.2.2: cloth) a note at the `let`, the line to change
    let note = buf_new();
    buf_fmt(note,
        { let name = str::from_utf8(name).unwrap(); format_args("'{name}' is '{}' from its literals (a float literal is f64, an integer one i64, where nothing gives their type): annotate it, `{}: {} = ...`", str::from_utf8(buf_slice(had)).unwrap(), str::from_utf8(src_text(pcx.let_start, pcx.name_end, pcx)).unwrap(), str::from_utf8(buf_slice(want)).unwrap()) });
    err_note_at(pcx.let_start, buf_slice(note), pcx);
    if buf_slice(pcx.err_help).len() == 0 {
        err_help_fmt(
            { let name = str::from_utf8(name).unwrap(); format_args(
                "'{name}' has its literals' type: annotate it where it is made (the note)") }, pcx);
    }
    let old = src_text(pcx.let_start, pcx.eq_end, pcx);
    if !has_quote(old) {
        let cmd = buf_new();
        buf_str(cmd, c"edit patch ");
        buf_file_line(cmd, pcx.let_start, pcx);
        buf_str(cmd, c" --old '");
        buf_bytes(cmd, old);
        buf_str(cmd, c"' --new '");
        buf_bytes(cmd, src_text(pcx.let_start, pcx.name_end, pcx));
        buf_str(cmd, c": ");
        buf_bytes(cmd, buf_slice(want));
        buf_bytes(cmd, src_text(pcx.name_end, pcx.eq_end, pcx));
        buf_str(cmd, c"'");
        err_try_tool(buf_slice(cmd), true, pcx);
    }
    // (0.26.2) a length or an index the i64 meets: the conversion at the
    // use stays the fix (fix --only usize), the annotation the help
    if pcx.want == TY_USIZE && crate::base::diag::err_has_fix(pcx) {
        return;
    }
    let fix = buf_new();
    buf_str(fix, c": ");
    buf_bytes(fix, buf_slice(want));
    err_fix(pcx.name_end, pcx.name_end, buf_slice(fix), pcx);
}

// Whether types a (the local's) and b (the one wanted) differ only where a
// has a literal's default type, f64 for another float (floats) or i64 for
// another integer (ints), through arrays and tuples.
fn defaulted_apart(a: i64, b: i64, floats: &mut bool, ints: &mut bool, pcx: &Ctx<Comp>) -> bool {
    if a == b {
        return true;
    }
    if a == TY_F64 && is_float(b) {
        *floats = true;
        return true;
    }
    if a == TY_I64 && is_integer(b) {
        *ints = true;
        return true;
    }
    if a <= 0 || b <= 0 {
        return false;
    }
    let ta = type_info(a, pcx);
    let tb = type_info(b, pcx);
    if ta.kind != tb.kind {
        return false;
    }
    if ta.kind == TyKind::Array {
        return ta.b == tb.b && defaulted_apart(ta.a, tb.a, floats, ints, pcx);
    }
    if ta.kind == TyKind::Tuple && ta.count == tb.count {
        for i in 0..ta.count {
            if !defaulted_apart(type_elem(a, i, pcx), type_elem(b, i, pcx), floats, ints, pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

// The nearest `let NAME =` or `var NAME =` (no type written) before pos,
// after from (the function's start): sets LET_START, NAME_START, NAME_END
// and EQ_END (after the `=`).
fn find_let(name: i64, pos: i64, from: i64, pcx: &mut Ctx<Comp>) -> bool {
    let text = crate::base::sym_text(name, pcx);
    let mut p = pos - text.len() as i64;
    while p > from + 3 {
        if word_at(p, text, pcx) {
            let mut k = p - 1;
            while k > from && src(k, pcx) == b' ' {
                k -= 1;
            }
            // (`let` or `var` before it, a word of its own)
            if k >= from + 2 && k + 1 < p
                && (keyword_ends(k, b"let", pcx) || keyword_ends(k, b"var", pcx)) {
                let mut q = p + text.len() as i64;
                while src(q, pcx) == b' ' {
                    q += 1;
                }
                if src(q, pcx) != b'=' || src(q + 1, pcx) == b'=' {
                    // (a type written, `let x: T`, or a pattern)
                    return false;
                }
                pcx.let_start = k - 2;
                pcx.name_start = p;
                pcx.name_end = p + text.len() as i64;
                pcx.eq_end = q + 1;
                return true;
            }
        }
        p -= 1;
    }
    false
}

// Whether the word text is at p (not inside a longer name).
fn word_at(p: i64, text: &[u8], pcx: &Ctx<Comp>) -> bool {
    for i in 0..text.len() as i64 {
        if src(p + i, pcx) != text[i as usize] {
            return false;
        }
    }
    !ident_byte(src(p - 1, pcx)) && !ident_byte(src(p + text.len() as i64, pcx))
}

// Whether keyword kw (three letters) ends at k, a word of its own.
fn keyword_ends(k: i64, kw: &[u8], pcx: &Ctx<Comp>) -> bool {
    src(k - 2, pcx) == kw[0] && src(k - 1, pcx) == kw[1] && src(k, pcx) == kw[2]
        && !ident_byte(src(k - 3, pcx))
}

// Whether the initializer from p to its `;` has a literal without a
// suffix: a float one (with floats), an integer one (with ints).
fn init_has_literal(p: i64, floats: bool, ints: bool, pcx: &Ctx<Comp>) -> bool {
    let end = file_info(file_of_pos(p, pcx), pcx).end;
    let mut depth: i64 = 0;
    let mut i = p;
    while i < end {
        let c = src(i, pcx);
        if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            depth -= 1;
        } else if c == b';' && depth <= 0 {
            return false;
        } else if c == b'"' {
            // (a string's text is no literal)
            i += 1;
            while i < end && src(i, pcx) != b'"' {
                if src(i, pcx) == b'\\' {
                    i += 1;
                }
                i += 1;
            }
        } else if is_digit(c) && !ident_byte(src(i - 1, pcx)) && src(i - 1, pcx) != b'.' {
            let mut j = i;
            while j < end && (is_digit(src(j, pcx)) || src(j, pcx) == b'_') {
                j += 1;
            }
            let mut float = false;
            if src(j, pcx) == b'.' && is_digit(src(j + 1, pcx)) {
                float = true;
                j += 1;
                while j < end && (is_digit(src(j, pcx)) || src(j, pcx) == b'_') {
                    j += 1;
                }
            }
            // (a suffix, `1.0f32`, `2u8`, gives the type; `0x..`: a word)
            if !ident_byte(src(j, pcx)) && (float && floats || !float && ints) {
                return true;
            }
            i = j;
            continue;
        }
        i += 1;
    }
    false
}

fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

fn ident_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || is_digit(c) || c == b'_'
}

fn has_quote(text: &[u8]) -> bool {
    for &c in text {
        if c == b'\'' {
            return true;
        }
    }
    false
}

// ---- The tables, read ----

fn node(n: i64, pcx: &Ctx<Comp>) -> Node {
    pcx.nodes[n as usize]
}

fn fn_node(f: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.fns[f as usize].node
}

fn local_type(l: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.locals[l as usize].ty
}

fn type_info(t: i64, pcx: &Ctx<Comp>) -> Type {
    pcx.types[t as usize]
}

fn file_info(f: i64, pcx: &Ctx<Comp>) -> SourceFile {
    pcx.files[f as usize]
}

// The byte at p of the source, 0 outside the current function's file.
fn src(p: i64, pcx: &Ctx<Comp>) -> u8 {
    let f = file_info(file_of_pos(fn_start(pcx), pcx), pcx);
    if p < f.start || p >= f.end {
        return 0;
    }
    crate::base::get_src()[p as usize]
}

fn src_text(a: i64, b: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let f = file_info(file_of_pos(a, pcx), pcx);
    if a < f.start || b > f.end || b < a {
        return b"";
    }
    &crate::base::get_src()[a as usize..b as usize]
}

fn fn_start(pcx: &Ctx<Comp>) -> i64 {
    node(fn_node(pcx.cur_fn, pcx), pcx).start
}

fn int_at(v: IntVec, k: i64) -> i64 {
    // UNSAFE: an IntVec's data is a raw buffer (base::IntVec).
    // SAFETY: 0 <= k < v.count (the caller's loop).
    unsafe { (*v.data.add(k as usize)) }
}

// ---- (0.27.3) F18.5: open locals, the integer inference variables ----
//
// In the rust edition an unannotated `let x = e;` of a literal tree makes x
// open: its integer positions are variables, read meanwhile at the
// fallback, i32. OPEN_LETS holds pairs (local, init), OPEN_USES pairs
// (local, node) of the nodes typed through an open local by the uses that
// keep it open (`x += 1`, `x = 1`, `x < 10`). The first use that gives the
// positions a type solves it (open_solve: the local, its init and those
// nodes retyped in place); any other use closes it at the fallback
// (open_close). After a function is checked nothing is open (open_end).

fn arith_op(op: Tok) -> bool {
    op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
        || op == Tok::Percent || op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret
}

fn shift_op(op: Tok) -> bool {
    op == Tok::Shl || op == Tok::Shr
}

// Whether checked expression e is a literal tree whose integer positions
// are untyped literals at the fallback (F18.5), or (0.28.0) open locals of
// an integer type (open_leaf) where its value is one.
pub fn open_tree(e: i64, pcx: &Ctx<Comp>) -> bool {
    open_tree_at(e, true, pcx)
}

// open_tree of e; `leaf`: an open local may be e itself (a position of the
// tree's own type, not an element of an array or a tuple).
fn open_tree_at(e: i64, leaf: bool, pcx: &Ctx<Comp>) -> bool {
    let x = node(e, pcx);
    if x.kind == NodeKind::Int {
        return x.b == SUF_NONE && x.ty == TY_I32;
    }
    if x.kind == NodeKind::Ident {
        return leaf && open_leaf(e, pcx) >= 0;
    }
    // (0.28.0: a `for` loop's range, its local's init, of an integer type)
    if x.kind == NodeKind::Range {
        return leaf && x.a != 0 && x.b != 0 && x.ty == TY_I32 && open_tree_at(x.a, true, pcx)
            && open_tree_at(x.b, true, pcx);
    }
    if x.kind == NodeKind::Unary {
        // (0.27.7: `!` of a literal tree too, `!0`, an integer `!` made `~`)
        return (x.op == Tok::Minus || x.op == Tok::Tilde) && x.ty == TY_I32
            && open_tree_at(x.b, leaf, pcx);
    }
    if x.kind == NodeKind::Binary {
        // RULE: F18.5 (0.27.7: a shift by its left operand alone; the right
        // operand, any integer, does not type it, as in rustc)
        if shift_op(x.op) {
            return x.ty == TY_I32 && open_tree_at(x.b, leaf, pcx);
        }
        return arith_op(x.op) && x.ty == TY_I32 && open_tree_at(x.b, leaf, pcx)
            && open_tree_at(x.c, leaf, pcx);
    }
    if x.kind == NodeKind::Repeat {
        return open_tree_at(x.a, false, pcx);
    }
    if x.kind == NodeKind::Array && x.count > 0 {
        for i in 0..x.count {
            if !open_tree_at(child(e, i, pcx), false, pcx) {
                return false;
            }
        }
        return true;
    }
    if x.kind == NodeKind::Tuple {
        for i in 0..x.count {
            if open_tree_at(child(e, i, pcx), false, pcx) {
                return true;
            }
        }
    }
    // RULE: F18.5 (0.27.4: a block by its tail, an `if` with an `else` and
    // a `match` by their branches, each a literal tree)
    if x.kind == NodeKind::Block {
        return x.a != 0 && open_tree_at(x.a, leaf, pcx);
    }
    if x.kind == NodeKind::If {
        return x.c != 0 && open_tree_at(x.b, leaf, pcx) && open_tree_at(x.c, leaf, pcx);
    }
    if x.kind == NodeKind::Match && x.count > 0 {
        for i in 0..x.count {
            if !open_tree_at(node(child(e, i, pcx), pcx).c, leaf, pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

// Whether open tree e can take type t: an integer at each literal (a
// signed one under a negation), the shape of t elsewhere.
fn open_fit(e: i64, t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let x = node(e, pcx);
    let tt = type_info(t, pcx);
    // (0.28.0: an open local's identifier, a leaf, its local solved with
    // the tree, open_group)
    if x.kind == NodeKind::Int || x.kind == NodeKind::Ident || x.kind == NodeKind::InterpHole {
        return is_integer(t) && t != pcx.char_type;
    }
    if x.kind == NodeKind::Range {
        return is_integer(t) && t != pcx.char_type && open_fit(x.a, t, pcx)
            && open_fit(x.b, t, pcx);
    }
    if x.kind == NodeKind::Unary {
        return (x.op == Tok::Tilde && is_integer(t) && t != pcx.char_type || is_signed(t))
            && open_fit(x.b, t, pcx);
    }
    if x.kind == NodeKind::Binary {
        return is_integer(t) && t != pcx.char_type && open_fit(x.b, t, pcx)
            && (shift_op(x.op) || open_fit(x.c, t, pcx));
    }
    if x.kind == NodeKind::Repeat {
        return tt.kind == TyKind::Array && x.ty > 0 && tt.b == type_info(x.ty, pcx).b
            && open_fit(x.a, tt.a, pcx);
    }
    if x.kind == NodeKind::Array {
        if tt.kind != TyKind::Array || tt.b != x.count {
            return false;
        }
        for i in 0..x.count {
            if !open_fit(child(e, i, pcx), tt.a, pcx) {
                return false;
            }
        }
        return true;
    }
    if x.kind == NodeKind::Tuple {
        if tt.kind != TyKind::Tuple || tt.count != x.count {
            return false;
        }
        for i in 0..x.count {
            let c = child(e, i, pcx);
            let want = type_elem(t, i, pcx);
            if open_tree(c, pcx) && !open_fit(c, want, pcx)
                || !open_tree(c, pcx) && node(c, pcx).ty != want {
                return false;
            }
        }
        return true;
    }
    if x.kind == NodeKind::Block {
        return open_fit(x.a, t, pcx);
    }
    if x.kind == NodeKind::If {
        return open_fit(x.b, t, pcx) && open_fit(x.c, t, pcx);
    }
    if x.kind == NodeKind::Match {
        for i in 0..x.count {
            if !open_fit(node(child(e, i, pcx), pcx).c, t, pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

// Literal n's value where type t goes, negated or not: an error (soft)
// when it does not fit.
fn open_fits(n: i64, negated: bool, t: i64, pcx: &mut Ctx<Comp>) {
    let value = node(n, pcx).a as u64;
    let magnitude: u64 = if negated && value > 0 { value - 1 } else { value };
    if magnitude > int_max(t) {
        err_begin(node(n, pcx).start, pcx);
        err_str(if negated { c"integer literal -" } else { c"integer literal " }, pcx);
        buf_uint(pcx.err, value);
        err_str(c" does not fit in type '", pcx);
        err_type(t, pcx);
        err_str(c"'", pcx);
        err_end_soft(pcx);
    }
}

// Node e, an open tree or an identifier typed through an open local,
// takes type t (open_fit said it can), its literals checked to fit.
fn open_set(e: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let x = node(e, pcx);
    // (0.28.0: a direct call's hole that writes the local, its write made
    // again, interp.vl's record)
    if x.kind == NodeKind::InterpHole {
        crate::front::check::interp::hole_retype(e, t, pcx);
        return;
    }
    let tt = type_info(t, pcx);
    pcx.nodes[e as usize].ty = t;
    if x.kind == NodeKind::Int {
        open_fits(e, false, t, pcx);
    } else if x.kind == NodeKind::Unary && node(x.b, pcx).kind == NodeKind::Int {
        pcx.nodes[x.b as usize].ty = t;
        open_fits(x.b, x.op == Tok::Minus, t, pcx);
    } else if x.kind == NodeKind::Unary {
        open_set(x.b, t, pcx);
    } else if x.kind == NodeKind::Binary {
        open_set(x.b, t, pcx);
        if !shift_op(x.op) {
            open_set(x.c, t, pcx);
        }
    } else if x.kind == NodeKind::Range {
        open_set(x.a, t, pcx);
        open_set(x.b, t, pcx);
    } else if x.kind == NodeKind::Repeat {
        open_set(x.a, tt.a, pcx);
    } else if x.kind == NodeKind::Array {
        for i in 0..x.count {
            open_set(child(e, i, pcx), tt.a, pcx);
        }
    } else if x.kind == NodeKind::Tuple {
        for i in 0..x.count {
            let c = child(e, i, pcx);
            if open_tree(c, pcx) {
                open_set(c, type_elem(t, i, pcx), pcx);
            }
        }
    } else if x.kind == NodeKind::Block {
        open_set(x.a, t, pcx);
    } else if x.kind == NodeKind::If {
        open_set(x.b, t, pcx);
        open_set(x.c, t, pcx);
    } else if x.kind == NodeKind::Match {
        for i in 0..x.count {
            open_set(node(child(e, i, pcx), pcx).c, t, pcx);
        }
    }
}

// RULE: F18.5 (0.27.6: the branches of an `if` or a `match` where no type
// is expected) Body k of the branches of n checked before the one being
// checked (an `if`: its then block; a `match`: arm k's), 0 for one left
// for later (a context value) or one that diverges.
fn earlier_body(n: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    let b = if node(n, pcx).kind == NodeKind::If { node(n, pcx).b }
        else { node(child(n, k, pcx), pcx).c };
    let t = node(branch_value(b, pcx), pcx).ty;
    if t <= 0 || t == TY_NEVER { 0 } else { b }
}

// The value branch body e gives: its block's tail, through blocks.
fn branch_value(e: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut v = e;
    while v > 0 && node(v, pcx).kind == NodeKind::Block && node(v, pcx).a != 0 {
        v = node(v, pcx).a;
    }
    v
}

// Whether element j of the tuples the branches of n before branch i give is
// an open tree in each of them (and there is one).
fn open_column(n: i64, i: i64, j: i64, pcx: &Ctx<Comp>) -> bool {
    let mut any = false;
    for k in 0..i {
        let b = earlier_body(n, k, pcx);
        if b == 0 {
            continue;
        }
        let v = branch_value(b, pcx);
        if node(v, pcx).kind != NodeKind::Tuple || j >= node(v, pcx).count
            || !open_tree(child(v, j, pcx), pcx) {
            return false;
        }
        any = true;
    }
    any
}

// RULE: F18.5 (0.27.6) The type branch i of n (its body `body`) is checked
// against when the branches before it are of type `result` and no type is
// expected: result, with a fresh variable for each element of a tuple that
// every earlier branch gives by an open tree, so that a branch of a definite
// type there types them all (`(gap, 0)`, then `(0, gap)`).
pub fn branch_expected(n: i64, i: i64, body: i64, result: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if result <= 0 || type_info(result, pcx).kind != TyKind::Tuple
        || !crate::front::check::infer::can_defer(node(body, pcx).start, pcx) {
        return result;
    }
    let count = type_info(result, pcx).count;
    let mut open = false;
    for j in 0..count {
        if type_elem(result, j, pcx) == TY_I32 && open_column(n, i, j, pcx) {
            open = true;
        }
    }
    if !open {
        return result;
    }
    let mark = pcx.tscratch.count;
    for j in 0..count {
        let e = type_elem(result, j, pcx);
        if e == TY_I32 && open_column(n, i, j, pcx) {
            let v = crate::front::check::infer::hole(body, pcx);
            pcx.tscratch.push(v);
        } else {
            pcx.tscratch.push(e);
        }
    }
    crate::front::types::make_type(TyKind::Tuple, 0, 0, mark, pcx)
}

// RULE: F18.5 (0.27.6) After branch i of n (body) was checked against
// `expected`, branch_expected's for `result`: each variable solved (one
// still free, the branch diverges there, is the fallback `i32`), the earlier
// branches' open elements take the solution's types. The branches' type.
pub fn branch_settle(n: i64, i: i64, body: i64, result: i64, expected: i64,
    pcx: &mut Ctx<Comp>) -> i64 {
    if expected == result {
        return result;
    }
    for j in 0..type_info(expected, pcx).count {
        let e = type_elem(expected, j, pcx);
        if crate::front::check::infer::is_free_var(e, pcx) {
            crate::front::check::infer::unify(e, TY_I32, pcx);
        }
    }
    let m = crate::front::check::infer::resolve(expected, pcx);
    if m == result {
        return m;
    }
    // (an element the earlier literals cannot take, not an integer: the
    // error at this branch's element, as rustc's "expected integer")
    let v = branch_value(body, pcx);
    for j in 0..type_info(m, pcx).count {
        let got = type_elem(m, j, pcx);
        if got != type_elem(result, j, pcx) && (!is_integer(got) || got == pcx.char_type)
            && node(v, pcx).kind == NodeKind::Tuple && j < node(v, pcx).count {
            crate::front::check::mismatch_error(child(v, j, pcx), TY_I32, got, pcx);
        }
    }
    for k in 0..i {
        let b = earlier_body(n, k, pcx);
        if b == 0 || node(b, pcx).ty == m {
            continue;
        }
        if !open_fit(b, m, pcx) {
            crate::front::check::mismatch_error(body, result, m, pcx);
        }
        open_set(b, m, pcx);
    }
    m
}

fn open_index(l: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i: i64 = 0;
    while i + 1 < pcx.open_lets.count {
        if pcx.open_lets.get(i) == l {
            return i;
        }
        i += 2;
    }
    -1
}

// (0.27.3) The open local a `let r = &x;` (or `&mut x`) init borrows,
// x's local, when x is open: r is open with it, its type `&` of x's
// (a link: solving one solves the other, closing one closes both); -1
// otherwise.
fn open_link(init: i64, pcx: &Ctx<Comp>) -> i64 {
    let x = node(init, pcx);
    if x.kind != NodeKind::Unary || x.op != Tok::Amp || node(x.b, pcx).kind != NodeKind::Ident
        || node(x.b, pcx).res != Res::Local {
        return -1;
    }
    let l = node(x.b, pcx).y;
    if open_index(l, pcx) >= 0 { l } else { -1 }
}

// The pairs linked to local l (open_link) leave the table; with t > 0
// their locals and inits take `&` of t first.
fn open_dependents(l: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i + 1 < pcx.open_lets.count {
        let init = pcx.open_lets.get(i + 1);
        if open_link(init, pcx) != l {
            i += 2;
            continue;
        }
        if t > 0 {
            let d = pcx.open_lets.get(i);
            let r = crate::front::types::ref_to(t, type_info(pcx.locals[d as usize].ty, pcx).b,
                pcx);
            pcx.locals[d as usize].ty = r;
            pcx.nodes[init as usize].ty = r;
        }
        open_drop(i, pcx);
    }
}

// (check_let) Whether `let x = init;` (unannotated, the rust edition) may
// make x a link (open_link): init is `&y` of a local y; its use keeps y
// open (OPEN_KEEP) until open_let decides.
pub fn open_borrow_init(init: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.open_lets.count > 0 && node(init, pcx).kind == NodeKind::Unary
        && node(init, pcx).op == Tok::Amp && node(node(init, pcx).b, pcx).kind == NodeKind::Ident
        && open_local(node(init, pcx).b, pcx) >= 0
}

// (check_let) An unannotated `let` of the rust edition bound local l to
// init: l is open when init is a literal tree or a link (open_link); a
// borrowed open local that does not make one is closed. RULE: F18.5
pub fn open_let(l: i64, init: i64, pcx: &mut Ctx<Comp>) {
    let root = open_link(init, pcx);
    if l >= 0 && (root >= 0 || open_tree(init, pcx)) {
        pcx.open_lets.push(l);
        pcx.open_lets.push(init);
        return;
    }
    if root >= 0 {
        open_close(open_index(root, pcx), pcx);
    }
    // (`let _ = a + 1;`, a tree of open locals bound to no name: a use of
    // its first, retyped with them)
    let owner = open_owner(init, pcx);
    if root < 0 && owner >= 0 && open_tree(init, pcx) {
        open_record(owner, init, pcx);
        return;
    }
    open_release(init, pcx);
}

// (0.28.0) The open locals among the leaves of tree e, which no open local
// holds (a `let` that bound none, `let _ = a + 1;`), are closed.
fn open_release(e: i64, pcx: &mut Ctx<Comp>) {
    let mut k = open_owner(e, pcx);
    while k >= 0 {
        open_close(k, pcx);
        k = open_owner(e, pcx);
    }
}

// RULE: F18.5 (0.28.0) Whether the range bounds a and b of a `for` loop
// are trees of untyped literals and open locals (`0..64`, `0..n` of an
// open n): its local is open, its init the range (check_for).
pub fn open_bounds(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    shape_leaves(a, true, pcx) >= 0 && shape_leaves(b, true, pcx) >= 0
}

// The pair of the open local identifier n names (its index in
// OPEN_LETS), or -1.
pub fn open_local(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.open_lets.count == 0 || node(n, pcx).kind != NodeKind::Ident {
        return -1;
    }
    match crate::front::check::lookup_local(node(n, pcx).a, pcx) {
        Option::Some(l) => open_index(l, pcx),
        Option::None => -1,
    }
}

// Pair k leaves the table, with its uses.
fn open_drop(k: i64, pcx: &mut Ctx<Comp>) {
    let l = pcx.open_lets.get(k);
    let last = pcx.open_lets.count - 2;
    pcx.open_lets.set(k, pcx.open_lets.get(last));
    pcx.open_lets.set(k + 1, pcx.open_lets.get(last + 1));
    pcx.open_lets.count = last;
    let mut w: i64 = 0;
    let mut i: i64 = 0;
    while i + 1 < pcx.open_uses.count {
        if pcx.open_uses.get(i) != l {
            pcx.open_uses.set(w, pcx.open_uses.get(i));
            pcx.open_uses.set(w + 1, pcx.open_uses.get(i + 1));
            w += 2;
        }
        i += 2;
    }
    pcx.open_uses.count = w;
}

// Pair k is closed at its provisional type, the fallback: its literals
// are checked to fit it. A link closes its root, a root its links; (0.28.0)
// a pair closes its group (open_group) with it.
fn open_close(k: i64, pcx: &mut Ctx<Comp>) {
    let init = pcx.open_lets.get(k + 1);
    let root = open_link(init, pcx);
    if root >= 0 {
        open_close(open_index(root, pcx), pcx);
        return;
    }
    let mark = open_group(k, pcx);
    let end = pcx.tscratch.count;
    for i in mark..end {
        let l = pcx.tscratch.get(i);
        // (the trees its uses recorded too, their literals checked to fit)
        let mut u: i64 = 0;
        while u + 1 < pcx.open_uses.count {
            if pcx.open_uses.get(u) == l {
                open_set(pcx.open_uses.get(u + 1), pcx.locals[l as usize].ty, pcx);
            }
            u += 2;
        }
        open_dependents(l, 0, pcx);
    }
    for i in mark..end {
        let l = pcx.tscratch.get(i);
        let j = open_index(l, pcx);
        if j >= 0 {
            let e = pcx.open_lets.get(j + 1);
            open_drop(j, pcx);
            open_set(e, pcx.locals[l as usize].ty, pcx);
        }
    }
    pcx.tscratch.count = mark;
}

// Pair k is solved to type t when its literals, and those of the uses
// that kept it open, can take it: the local, its init and those nodes
// retyped in place; (0.28.0) with its group's (open_group), one variable.
// Whether it was. RULE: F18.5
pub fn open_solve(k: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    let l = pcx.open_lets.get(k);
    let init = pcx.open_lets.get(k + 1);
    // (a link, `&x`: x solved to what the reference points to)
    let root = open_link(init, pcx);
    if root >= 0 {
        let rt = type_info(t, pcx);
        if t > 0 && rt.kind != TyKind::Ptr {
            // (`let b: i64 = r;`: the referent takes the type, for the
            // error that follows, a reference where its value goes)
            open_solve(open_index(root, pcx), t, pcx);
            return false;
        }
        if t <= 0 || rt.kind != TyKind::Ptr || rt.b != type_info(pcx.locals[l as usize].ty, pcx).b {
            return false;
        }
        return open_solve(open_index(root, pcx), rt.a, pcx);
    }
    if t == pcx.locals[l as usize].ty {
        open_close(k, pcx);
        return true;
    }
    let mark = open_group(k, pcx);
    let end = pcx.tscratch.count;
    if end - mark > 1 && !is_integer(t) {
        pcx.tscratch.count = mark;
        return false;
    }
    for g in mark..end {
        if !open_fits_all(pcx.tscratch.get(g), t, pcx) {
            pcx.tscratch.count = mark;
            return false;
        }
    }
    for g in mark..end {
        { let at_ix = pcx.tscratch.get(g) as usize; pcx.locals[at_ix].ty = t };
    }
    for g in mark..end {
        let m = pcx.tscratch.get(g);
        let mut i: i64 = 0;
        while i + 1 < pcx.open_uses.count {
            if pcx.open_uses.get(i) == m {
                open_set(pcx.open_uses.get(i + 1), t, pcx);
            }
            i += 2;
        }
        open_dependents(m, t, pcx);
    }
    for g in mark..end {
        let m = pcx.tscratch.get(g);
        let j = open_index(m, pcx);
        if j >= 0 {
            let e = pcx.open_lets.get(j + 1);
            open_drop(j, pcx);
            open_set(e, t, pcx);
        }
    }
    pcx.tscratch.count = mark;
    true
}

// Whether open local l's init, and the uses that kept it open, can take
// type t (open_fit).
fn open_fits_all(l: i64, t: i64, pcx: &Ctx<Comp>) -> bool {
    let k = open_index(l, pcx);
    if k < 0 || !open_fit(pcx.open_lets.get(k + 1), t, pcx) {
        return false;
    }
    let mut i: i64 = 0;
    while i + 1 < pcx.open_uses.count {
        let u = pcx.open_uses.get(i + 1);
        if pcx.open_uses.get(i) == l && node(u, pcx).kind != NodeKind::Ident
            && !open_fit(u, t, pcx) {
            return false;
        }
        i += 2;
    }
    true
}

// RULE: F18.5 (0.28.0) The open locals one variable with pair k's: its
// local, the open locals that are leaves of its init or of a tree a use
// recorded (`let b = a + 1;`, `a < b`, `s += x`), theirs, and the locals
// whose init or use trees have one of them as a leaf, pushed on TSCRATCH;
// the mark they start at. Solving or closing one solves or closes them
// all, at one type.
fn open_group(k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mark = pcx.tscratch.count;
    pcx.tscratch.push(pcx.open_lets.get(k));
    let mut g = mark;
    while g < pcx.tscratch.count {
        let l = pcx.tscratch.get(g);
        let mut j: i64 = 0;
        while j + 1 < pcx.open_lets.count {
            let m = pcx.open_lets.get(j);
            if open_link(pcx.open_lets.get(j + 1), pcx) < 0 && !in_group(m, mark, pcx)
                && (open_names(m, l, pcx) || open_names(l, m, pcx)) {
                pcx.tscratch.push(m);
            }
            j += 2;
        }
        g += 1;
    }
    mark
}

fn in_group(l: i64, mark: i64, pcx: &Ctx<Comp>) -> bool {
    for g in mark..pcx.tscratch.count {
        if pcx.tscratch.get(g) == l {
            return true;
        }
    }
    false
}

// Whether open local l's init, or a tree one of its uses recorded, has
// local m as a leaf.
fn open_names(l: i64, m: i64, pcx: &Ctx<Comp>) -> bool {
    let k = open_index(l, pcx);
    if k < 0 {
        return false;
    }
    if leaf_of(pcx.open_lets.get(k + 1), m, pcx) {
        return true;
    }
    let mut i: i64 = 0;
    while i + 1 < pcx.open_uses.count {
        if pcx.open_uses.get(i) == l && leaf_of(pcx.open_uses.get(i + 1), m, pcx) {
            return true;
        }
        i += 2;
    }
    false
}

// Whether tree e (checked) has an identifier of local m as a leaf, where
// the tree's own type goes (open_tree_at's leaves).
fn leaf_of(e: i64, m: i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 {
        return false;
    }
    let x = node(e, pcx);
    if x.kind == NodeKind::Ident {
        return x.res == Res::Local && x.y == m;
    }
    if x.kind == NodeKind::Range {
        return leaf_of(x.a, m, pcx) || leaf_of(x.b, m, pcx);
    }
    if x.kind == NodeKind::Unary {
        return (x.op == Tok::Minus || x.op == Tok::Tilde) && leaf_of(x.b, m, pcx);
    }
    if x.kind == NodeKind::Binary {
        return leaf_of(x.b, m, pcx) || !shift_op(x.op) && leaf_of(x.c, m, pcx);
    }
    if x.kind == NodeKind::Block {
        return leaf_of(x.a, m, pcx);
    }
    if x.kind == NodeKind::If {
        return leaf_of(x.b, m, pcx) || leaf_of(x.c, m, pcx);
    }
    if x.kind == NodeKind::Match {
        for i in 0..x.count {
            if leaf_of(node(child(e, i, pcx), pcx).c, m, pcx) {
                return true;
            }
        }
    }
    false
}

// The pair of the open local of an integer type identifier n (checked)
// names, or -1. RULE: F18.5 (0.28.0)
pub fn open_leaf(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let x = node(n, pcx);
    if pcx.open_lets.count == 0 || x.kind != NodeKind::Ident || x.res != Res::Local {
        return -1;
    }
    let k = open_index(x.y, pcx);
    if k < 0 || !is_integer(pcx.locals[x.y as usize].ty) {
        return -1;
    }
    k
}

// (synth_operands) The pair of the first open local among the leaves of
// tree e (checked), or -1.
pub fn open_owner(e: i64, pcx: &Ctx<Comp>) -> i64 {
    if e <= 0 {
        return -1;
    }
    let x = node(e, pcx);
    if x.kind == NodeKind::Ident {
        return open_leaf(e, pcx);
    }
    if x.kind == NodeKind::Unary || x.kind == NodeKind::Block {
        return open_owner(if x.kind == NodeKind::Unary { x.b } else { x.a }, pcx);
    }
    if x.kind == NodeKind::Range || x.kind == NodeKind::If {
        let k = open_owner(if x.kind == NodeKind::If { x.b } else { x.a }, pcx);
        return if k >= 0 { k }
            else { open_owner(if x.kind == NodeKind::If { x.c } else { x.b }, pcx) };
    }
    if x.kind == NodeKind::Binary {
        let k = open_owner(x.b, pcx);
        return if k >= 0 || shift_op(x.op) { k } else { open_owner(x.c, pcx) };
    }
    -1
}

// RULE: F18.5 (0.28.0) Whether e, not yet checked, is a tree of untyped
// integer literals and names (`a`, `a + 1`, `n - i`, `1 << k`) with an
// open local of an integer type among them; `strict`: every name is one.
// Its open locals stay open while it is checked (OPEN_KEEP): the tree's
// leaves, solved or closed with what it gives its type.
pub fn open_shape(e: i64, strict: bool, pcx: &Ctx<Comp>) -> bool {
    pcx.open_lets.count > 0 && shape_leaves(e, strict, pcx) > 0
}

// RULE: F18.5 (0.28.0) Tree e (open_shape, not yet checked) where it
// gives its open locals no type, a cast's operand or a shift amount
// (rustc's `{integer}` there stays a variable): checked with its open
// locals kept, and recorded as a use of the first, retyped with them
// (open_group). Its type.
pub fn open_kept(e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved_keep = pcx.open_keep;
    let saved_init = pcx.open_init;
    pcx.open_keep = true;
    pcx.open_init = e;
    let t = crate::front::check::synth_mode::synth_expr(e, pcx);
    pcx.open_keep = saved_keep;
    pcx.open_init = saved_init;
    let k = open_owner(e, pcx);
    if k >= 0 && open_tree(e, pcx) {
        open_record(k, e, pcx);
    } else {
        open_release(e, pcx);
    }
    t
}

// (check_assign) Whether e, not yet checked, is a tree of untyped integer
// literals and open locals of an integer type only (`1`, `1 << 31`, `x`,
// `x + 1`): assigned to an open local it keeps it open.
pub fn open_value(e: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.open_lets.count > 0 && shape_leaves(e, true, pcx) >= 0
}

// The open locals among the leaves of tree e (open_shape), -1 when e is
// not one.
fn shape_leaves(e: i64, strict: bool, pcx: &Ctx<Comp>) -> i64 {
    if e <= 0 {
        return -1;
    }
    let x = node(e, pcx);
    if x.kind == NodeKind::Int {
        return if x.b == SUF_NONE { 0 } else { -1 };
    }
    if x.kind == NodeKind::Ident {
        if x.count != 0 {
            return -1;
        }
        if open_scalar(e, pcx) >= 0 {
            return 1;
        }
        return if strict { -1 } else { 0 };
    }
    if x.kind == NodeKind::Unary {
        return if x.op == Tok::Minus || x.op == Tok::Tilde || x.op == Tok::Bang {
            shape_leaves(x.b, strict, pcx) } else { -1 };
    }
    if x.kind == NodeKind::Binary && (arith_op(x.op) || shift_op(x.op)) {
        let a = shape_leaves(x.b, strict, pcx);
        let b = shape_leaves(x.c, strict, pcx);
        return if a < 0 || b < 0 { -1 } else { a + b };
    }
    if x.kind == NodeKind::Block && x.count == 0 {
        return shape_leaves(x.a, strict, pcx);
    }
    // (an `if` with an `else` by its branches; its condition is any)
    if x.kind == NodeKind::If && x.c != 0 {
        let a = shape_leaves(x.b, strict, pcx);
        let b = shape_leaves(x.c, strict, pcx);
        return if a < 0 || b < 0 { -1 } else { a + b };
    }
    -1
}

// (synth_name) Identifier n uses local l: when l is open, the use is
// recorded where it keeps it open (OPEN_KEEP), and closes it otherwise
// (a closure that captures it closes it when it is checked,
// open_captured). RULE: F18.5
pub fn open_use(n: i64, l: i64, pcx: &mut Ctx<Comp>) {
    let k = open_index(l, pcx);
    if k < 0 {
        return;
    }
    if pcx.open_keep {
        pcx.open_uses.push(l);
        pcx.open_uses.push(n);
        return;
    }
    open_close(k, pcx);
}

// Literal tree n is typed through the open local of pair k (`x += 1`,
// `x < 10`): retyped with it.
pub fn open_record(k: i64, n: i64, pcx: &mut Ctx<Comp>) {
    if k >= 0 && k < pcx.open_lets.count {
        pcx.open_uses.push(pcx.open_lets.get(k));
        pcx.open_uses.push(n);
    }
}

// (check_expr) Expression n is checked against `expected`: an open local,
// `&x` of one where `&T` or `&[T]` goes, or an element or a range of an
// open array (`a[0]`, `&a[..]`), takes the type when its literals can
// (F18.5 (a)).
pub fn open_expected(n: i64, expected: i64, pcx: &mut Ctx<Comp>) {
    if expected <= 0 || expected == pcx.ty_error {
        return;
    }
    let x = node(n, pcx);
    if x.kind == NodeKind::Ident {
        let k = open_local(n, pcx);
        if k >= 0 {
            open_solve(k, expected, pcx);
        }
        return;
    }
    let te = type_info(expected, pcx);
    let mut e = n;
    let mut want = expected;
    if x.kind == NodeKind::Unary && x.op == Tok::Amp {
        e = x.b;
        // (a reference or a raw pointer: `let q: *const i64 = &n;`)
        want = if te.kind == TyKind::Ptr { te.a } else { 0 };
    }
    if node(e, pcx).kind == NodeKind::Index {
        // (an element: `a[0]` where T goes; a range: `&a[..]` where `&[T]`)
        let base = node(e, pcx).a;
        let k = open_local(base, pcx);
        if k < 0 {
            return;
        }
        let had = pcx.locals[pcx.open_lets.get(k) as usize].ty;
        if had <= 0 || type_info(had, pcx).kind != TyKind::Array {
            return;
        }
        let range = node(node(e, pcx).b, pcx).kind == NodeKind::Range;
        let elem: i64 = if range && te.kind == TyKind::Slice { te.a } else if range { 0 }
            else { want };
        if elem > 0 {
            open_solve(k, array_of(elem, type_info(had, pcx).b, pcx), pcx);
        }
        return;
    }
    if e == n {
        return;
    }
    let k = open_local(e, pcx);
    if k < 0 {
        return;
    }
    let had = pcx.locals[pcx.open_lets.get(k) as usize].ty;
    if want > 0 {
        open_solve(k, want, pcx);
    } else if te.kind == TyKind::Slice && had > 0 && type_info(had, pcx).kind == TyKind::Array {
        open_solve(k, array_of(te.a, type_info(had, pcx).b, pcx), pcx);
    }
}

// The pair of an open local whose type is an integer, for a use that may
// keep it open: identifier n names it; -1 otherwise.
pub fn open_scalar(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = open_local(n, pcx);
    if k < 0 {
        return -1;
    }
    let l = pcx.open_lets.get(k);
    if !is_integer(pcx.locals[l as usize].ty) {
        return -1;
    }
    k
}

// Whether e is an untyped integer literal, maybe negated.
pub fn open_literal(e: i64, pcx: &Ctx<Comp>) -> bool {
    let x = node(e, pcx);
    if x.kind == NodeKind::Unary && x.op == Tok::Minus {
        return open_literal(x.b, pcx);
    }
    x.kind == NodeKind::Int && x.b == SUF_NONE
}

// (check_expr) Whether e, behind a `&` where `&t` goes, is an untyped
// literal that takes t: an integer literal for an integer t, a float one
// for a float t, maybe negated (`&1`, `&-9`, `&0.0`). RULE: F18.3
pub fn ref_literal_takes(e: i64, t: i64, pcx: &Ctx<Comp>) -> bool {
    let mut x = node(e, pcx);
    if x.kind == NodeKind::Unary && x.op == Tok::Minus {
        x = node(x.b, pcx);
    }
    x.b == SUF_NONE && (x.kind == NodeKind::Int && is_integer(t) && t != pcx.char_type
        || x.kind == NodeKind::Float && is_float(t))
}

// (check_expr) Whether e, behind a `&` where `&t` goes, is an array, a
// repeat or a tuple literal and t a type of its kind, which it is checked
// against. RULE: F18.4 (0.27.5)
pub fn ref_aggregate_takes(e: i64, t: i64, pcx: &Ctx<Comp>) -> bool {
    let k = node(e, pcx).kind;
    if t <= 0 {
        return false;
    }
    let tk = pcx.types[t as usize].kind;
    (k == NodeKind::Array || k == NodeKind::Repeat) && tk == TyKind::Array
        || k == NodeKind::Tuple && tk == TyKind::Tuple
}

// Whether node n is in the literal tree of root, as written.
fn in_tree(root: i64, n: i64, pcx: &Ctx<Comp>) -> bool {
    if root == n {
        return true;
    }
    if root <= 0 {
        return false;
    }
    let x = node(root, pcx);
    if x.kind == NodeKind::Unary || x.kind == NodeKind::Repeat {
        return in_tree(if x.kind == NodeKind::Unary { x.b } else { x.a }, n, pcx);
    }
    if x.kind == NodeKind::Binary {
        return in_tree(x.b, n, pcx) || !shift_op(x.op) && in_tree(x.c, n, pcx);
    }
    if x.kind == NodeKind::Range {
        return in_tree(x.a, n, pcx) || in_tree(x.b, n, pcx);
    }
    if x.kind == NodeKind::Array || x.kind == NodeKind::Tuple {
        for i in 0..x.count {
            if in_tree(child(root, i, pcx), n, pcx) {
                return true;
            }
        }
    }
    // (0.27.4: a block's tail, an `if`'s and a `match`'s branches)
    if x.kind == NodeKind::Block {
        return in_tree(x.a, n, pcx);
    }
    if x.kind == NodeKind::If {
        return in_tree(x.b, n, pcx) || in_tree(x.c, n, pcx);
    }
    if x.kind == NodeKind::Match {
        for i in 0..x.count {
            if in_tree(node(child(root, i, pcx), pcx).c, n, pcx) {
                return true;
            }
        }
    }
    false
}

// (synth_expr) The type of untyped integer literal n with no context in
// the rust edition: the fallback, i32 (F18.3). One that does not fit is an
// error, but in the literal tree of a `let` being checked (OPEN_INIT),
// whose local may take a wider type (checked when it is solved or closed).
pub fn literal_fallback(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if node(n, pcx).a as u64 > int_max(TY_I32) && !in_tree(pcx.open_init, n, pcx) {
        open_fits(n, false, TY_I32, pcx);
    }
    TY_I32
}

// (check_function) The function's open locals, from mark on, take the
// fallback at its end.
pub fn open_end(mark: i64, pcx: &mut Ctx<Comp>) {
    while pcx.open_lets.count > mark {
        open_close(pcx.open_lets.count - 2, pcx);
    }
}

// (check_assign) Identifier n, an assignment's target kept open, is
// assigned a value of type t: its local takes t when its literals can,
// else it is closed. Its type now.
pub fn open_settle(n: i64, t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let k = open_local(n, pcx);
    if k >= 0 && !(t > 0 && t != TY_NEVER && t != pcx.ty_error && open_solve(k, t, pcx)) {
        open_close(k, pcx);
    }
    pcx.nodes[n as usize].ty
}

// (check_let) The hoisted temporary `let` stmt of `let s: &[T] = &a[..];`
// (temps::annotate_temp's OPEN_HINTS): its range of an open array takes
// the annotation's slice type before it is synthesized (F18.5 (a)).
pub fn open_hint(stmt: i64, init: i64, pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i + 1 < pcx.open_hints.count {
        if pcx.open_hints.get(i) == stmt {
            let t = crate::front::check::resolve::resolve_type(pcx.open_hints.get(i + 1), pcx);
            open_expected(init, t, pcx);
            return;
        }
        i += 2;
    }
}

// (check_closure_sig) The closure whose captures are CAPS' pairs from `from`
// on is checked: an open local it captures is closed, its type the one its
// environment holds. RULE: F18.5
pub fn open_captured(from: i64, pcx: &mut Ctx<Comp>) {
    let mut i = from;
    while i + 1 < pcx.caps.count && pcx.open_lets.count > 0 {
        let k = open_index(pcx.caps.get(i), pcx);
        if k >= 0 {
            open_close(k, pcx);
        }
        i += 2;
    }
}
