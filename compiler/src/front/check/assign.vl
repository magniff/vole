// Places and assignment: which expressions are places, `=` and the
// compound assignments (`+=` and the others, on numbers and vectors), and
// the mutability a write to a place needs.

use crate::base::{SRC, SYMS, buf_bytes, buf_new, buf_slice, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fmt, err_help, err_help_sym, err_str, err_sym,
    err_try_fmt,
};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::ast::NodeKind::{FieldAccess, Ident, Index, Range, TupleField, Unary};
use crate::front::check::{LOCALS, Res, lookup_local, name_error, type_error, type_error_got};
use crate::front::check::check_mode::{check_expr, check_shift_amount};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::mark_no_read;
use crate::front::check::vectors::vector_operator_ok;
use crate::front::closures::note_local_write;
use crate::front::distinct::strip_distinct;
use crate::front::lexer::Tok;
use crate::front::types::{
    FNS, REF_MUT, REF_SHARED, STATICS, SYM_STATIC, TYPES, TyKind, buf_type, is_integer, is_numeric,
    is_pointer, is_slice, is_vector,
};

fn arith_token_of_assign(op: Tok) -> Tok {
    if op == Tok::PlusEq { return Tok::Plus; }
    if op == Tok::MinusEq { return Tok::Minus; }
    if op == Tok::StarEq { return Tok::Star; }
    if op == Tok::SlashEq { return Tok::Slash; }
    if op == Tok::PercentEq { return Tok::Percent; }
    if op == Tok::AmpEq { return Tok::Amp; }
    if op == Tok::PipeEq { return Tok::Pipe; }
    if op == Tok::CaretEq { return Tok::Caret; }
    op
}

// ---- Places and assignment ----

pub fn is_place(n: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        match NODES[n].kind {
            Ident => {
                let name = NODES[n].a;
                lookup_local(name, pcx).is_some() || SYM_STATIC[name] != 0
            }
            Unary => NODES[n].op == Tok::Star,
            // Through a pointer.
            FieldAccess if NODES[n].y == 1 => true,
            FieldAccess | TupleField => is_place(NODES[n].a, pcx),
            Index => {
                let base = NODES[n].a;
                if NODES[NODES[n].b].kind == Range {
                    return false;
                }
                is_pointer(NODES[base].ty) || is_slice(NODES[base].ty) || is_place(base, pcx)
            }
            _ => false,
        }
    }
}

pub fn check_assign(n: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let op = NODES[n].op;
        let target = NODES[n].b;
        let value = NODES[n].c;
        if op == Tok::Eq {
            // Writing a union's field reads nothing.
            mark_no_read(target);
        }
        let outer = pcx.assigning;
        pcx.assigning = n;
        let outer_place = pcx.mut_place;
        pcx.mut_place = target;
        let target_ty = synth_expr(target, &pcx);
        pcx.mut_place = outer_place;
        pcx.assigning = outer;
        if !is_place(target, pcx) {
            let name = NODES[target].a;
            if NODES[target].kind == Ident && NODES[target].res == Res::Const {
                name_error(NODES[target].start, c"cannot assign to constant '",
                    NODES[pcx.consts[NODES[target].y].node].a, c"'", &pcx);
            }
            if NODES[target].kind == Ident && NODES[target].res == Res::Fn {
                name_error(NODES[target].start, c"cannot assign to function '", name, c"'", &pcx);
            }
            type_error(target, c"invalid assignment target", &pcx);
        }
        check_mutable_place(target, &pcx);
        if op == Tok::Eq {
            check_expr(value, target_ty, &pcx);
            return;
        }
        if op == Tok::ShlEq || op == Tok::ShrEq {
            // (0.18: a distinct type as its underlying type)
            if !is_integer(strip_distinct(target_ty)) {
                type_error_got(n, c"shift assignment requires integer type", target_ty, &pcx);
            }
            check_shift_amount(value, &pcx);
            return;
        }
        if is_vector(target_ty) {
            // (0.10: lanewise, as the operator)
            vector_operator_ok(n, arith_token_of_assign(op), target_ty, &pcx);
            check_expr(value, target_ty, &pcx);
            return;
        }
        if op == Tok::AmpEq || op == Tok::PipeEq || op == Tok::CaretEq {
            if !is_integer(strip_distinct(target_ty)) {
                type_error_got(n, c"bitwise assignment requires integer type", target_ty, &pcx);
            }
        } else if !is_numeric(strip_distinct(target_ty)) {
            type_error_got(n, c"compound assignment requires numeric type", target_ty, &pcx);
        }
        check_expr(value, target_ty, &pcx);
    }
}

pub fn check_mutable_place(target: i64, pcx: inout Ctx<Comp>) {
    let root = place_root(target);
    if root > 0 {
        check_mutable_name(root, target, &pcx);
    } else {
        note_write_through(target, &pcx);
    }
}

// (0.25) A write through an inout access a local holds (`c.n += 1` with
// `struct C { n: inout i64 }`, `self.q.push(x)` through an inout field): a
// closure that does it changes that local, which it then captures inout
// (closures::note_local_write; the closure is move-only).
pub fn note_write_through(target: i64, pcx: inout Ctx<Comp>) {
    var e = target;
    for _ in 0..64 {
        unsafe {
            match NODES[e].kind {
                Unary if NODES[e].op == Tok::Star => {
                    // (only through an inout access, not a raw pointer)
                    let t = NODES[NODES[e].b].ty;
                    if t <= 0 || TYPES[t].kind != TyKind::Ptr || TYPES[t].b != REF_MUT {
                        return;
                    }
                    e = NODES[e].b;
                }
                Index => {
                    let t = NODES[NODES[e].a].ty;
                    if t > 0 && (TYPES[t].kind == TyKind::Ptr
                        || TYPES[t].kind == TyKind::Slice && TYPES[t].b != REF_MUT) {
                        return;
                    }
                    e = NODES[e].a;
                }
                FieldAccess | TupleField => e = NODES[e].a,
                Ident => {
                    if NODES[e].res == Res::Local && NODES[e].y >= 0
                        && (LOCALS[NODES[e].y].mutable || LOCALS[NODES[e].y].access) {
                        note_local_write(NODES[e].y, &pcx);
                    }
                    return;
                }
                _ => return,
            }
        }
    }
}

// The Ident a write to place `target` changes, through fields, tuple parts
// and the elements of an array (0: none to check, the place reached
// through a pointer, a reference or a slice, or not a place).
pub fn place_root(target: i64) -> i64 {
    var root = target;
    loop {
        match NODES[root].kind {
            // Through a pointer: no `mut` needed.
            FieldAccess if NODES[root].y == 1 => return 0,
            FieldAccess | TupleField => root = NODES[root].a,
            Index if !is_pointer(NODES[NODES[root].a].ty)
                && !is_slice(NODES[NODES[root].a].ty) => root = NODES[root].a,
            Ident => return root,
            _ => return 0,
        }
    }
}

// (0.25) The rule of an inout access: `&place` taken exclusive (an inout
// argument, `inout r = &place`, `match &place`, `for inout x in &place`)
// and the receiver of an `inout self` method (`c.inc()`, `v.push(x)`,
// `v[i] = x` through `as_mut_slice`) need the place's root mutable: a
// `var` local, an inout parameter or `inout self`, a `static var`, or
// memory reached through a raw pointer (unsafe) or an inout access. A let
// binding, a let parameter, a let receiver and an immutable static (in
// read-only data) are read-only: own.readonly, naming the binding. (A let
// access to an owned value, a reference inside, is the own pass's:
// views::on_mut_loan.) `at` is the node reported: the `&`, the call.
// `&place` given where a raw `*T` is wanted is its address, not an
// access (unsafe code answers for writes through it): its check waits for
// the function's end (flush_inout_places), when the node's type says.
pub fn check_inout_place(target: i64, at: i64, pcx: inout Ctx<Comp>) {
    let kind = inout_root_kind(target, &pcx);
    if kind != 0 {
        inout_place_error(at, kind, NODES[pcx.inout_root].a, pcx.inout_root_ty, &pcx);
    }
}

// (0.25) The call of a sink closure that changes what it owns, through
// place `callee`: the rule of an inout access (check_inout_place), and a let
// access (a let parameter of a generic's instance, `f: F`) is read-only
// too: own.readonly.
pub fn check_closure_call_place(callee: i64, at: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if NODES[callee].kind == Ident && NODES[callee].res == Res::Local && NODES[callee].y >= 0 {
            let l = NODES[callee].y;
            let t = LOCALS[l].ty;
            if LOCALS[l].access && t > 0 && TYPES[t].kind == TyKind::Ptr
                && TYPES[t].b == REF_SHARED {
                inout_place_error(at, if LOCALS[l].is_param { 2 } else { 1 }, NODES[callee].a,
                    TYPES[t].a, &pcx);
                return;
            }
        }
        check_inout_place(callee, at, &pcx);
    }
}

// The same for `&place` (synth_unary): reported at the function's end
// unless the `&` became a raw pointer.
pub fn defer_inout_place(target: i64, at: i64, pcx: inout Ctx<Comp>) {
    let kind = inout_root_kind(target, &pcx);
    if kind != 0 {
        pcx.inout_pending.push(at);
        pcx.inout_pending.push(kind);
        pcx.inout_pending.push(NODES[pcx.inout_root].a);
        pcx.inout_pending.push(pcx.inout_root_ty);
    }
}

// (0.25) `&value` of a temporary (check/temps.vl made its local): conv.place
// at the function's end if it was lent inout.
pub fn defer_conv_place(at: i64, pcx: inout Ctx<Comp>) {
    pcx.inout_pending.push(at);
    pcx.inout_pending.push(5);
    pcx.inout_pending.push(0);
    pcx.inout_pending.push(0);
}

pub fn clear_inout_places(pcx: inout Ctx<Comp>) {
    pcx.inout_pending.count = 0;
    pcx.raw_addrs.count = 0;
    pcx.let_amps.count = 0;
}

pub fn flush_inout_places(pcx: inout Ctx<Comp>) {
    unsafe {
        var i = 0;
        while i + 3 < pcx.inout_pending.count {
            let at = pcx.inout_pending.data[i];
            let t0 = NODES[at].ty;
            let t = if t0 > 0 { strip_distinct(t0) } else { t0 };
            // (only an exclusive access is checked: `&x` that became a raw
            // pointer, a let `[T]` or `str`, or a let view is none)
            var raw = !(t > 0 && (TYPES[t].kind == TyKind::Ptr || TYPES[t].kind == TyKind::Slice)
                && TYPES[t].b == REF_MUT);
            for j in 0..pcx.raw_addrs.count {
                if pcx.raw_addrs.data[j] == at {
                    raw = true;
                }
            }
            if pcx.inout_pending.data[i + 1] == 5 {
                // (conv.place: only where the access is inout)
                // (`inout r = &make()` binds the temporary: no lending)
                var bound = false;
                for j in 0..pcx.let_amps.count {
                    if pcx.let_amps.data[j] == at {
                        bound = true;
                    }
                }
                if !raw && !bound {
                    conv_place_error(at, &pcx);
                }
            } else if !raw {
                inout_place_error(at, pcx.inout_pending.data[i + 1], pcx.inout_pending.data[i + 2],
                    pcx.inout_pending.data[i + 3], &pcx);
            }
            i += 4;
        }
        clear_inout_places(&pcx);
    }
}

// conv.place: `&make()` lent inout, a temporary whose change is lost.
fn conv_place_error(at: i64, pcx: inout Ctx<Comp>) {
    let text = SRC[NODES[at].start..NODES[at].end];
    let value = if text.len > 1 && text[0] == '&' { text[1..text.len] } else { text };
    let m = buf_new();
    buf_str(m, c"'&' lends a place for the callee to change; '");
    buf_bytes(m, value);
    buf_str(m, c"' is a temporary, whose change would be lost");
    crate::front::conv::conv_error(crate::front::conv::CODE_PLACE, NODES[at].start,
        NODES[at].end, buf_slice(m), "name it first, then lend it: 'var t = VALUE;' and '&t'",
        "", &pcx);
}

// What the root of place `target` is when an inout access of it breaks the
// rule (0: nothing wrong): 1 a let binding, 2 a let parameter, 3 a let
// receiver, 4 an immutable static; INOUT_ROOT is the Ident, INOUT_ROOT_TY
// its type.
fn inout_root_kind(target: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.inout_free > 0 {
            return 0;
        }
        let root = place_root(target);
        if root <= 0 {
            note_write_through(target, &pcx);
            return 0;
        }
        pcx.inout_root = root;
        if NODES[root].res == Res::Local {
            let local = NODES[root].y;
            if local < 0 {
                return 0;
            }
            let t = LOCALS[local].ty;
            pcx.inout_root_ty = t;
            if LOCALS[local].mutable {
                // (a closure that changes it this way writes it)
                note_local_write(local, &pcx);
            }
            // (an access, a reference: through it; a slice is a view,
            // whose writes the own pass checks: views::on_mut_loan)
            if LOCALS[local].mutable || LOCALS[local].access
                || t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b != 0
                || t > 0 && TYPES[t].kind == TyKind::Slice {
                return 0;
            }
            if SYMS[NODES[root].a].text == "self" {
                return 3;
            }
            return if LOCALS[local].is_param { 2 } else { 1 };
        }
        if NODES[root].res == Res::Static && !STATICS[NODES[root].y].mutable {
            pcx.inout_root_ty = STATICS[NODES[root].y].ty;
            return 4;
        }
        0
    }
}

fn inout_place_error(at: i64, kind: i64, name: i64, t: i64, pcx: inout Ctx<Comp>) {
    let text = SRC[NODES[at].start..NODES[at].end];
    let saved = pcx.err_kind;
    pcx.err_kind = c"own.readonly";
    err_begin(NODES[at].start, &pcx);
    err_fmt(format_args("'{text}' changes '"), pcx);
    err_sym(name, pcx);
    let b = buf_new();
    if kind == 4 {
        err_str(c"', an immutable static: it is read-only (in read-only memory)", pcx);
        err_help(c"declare it `static var` to change it", pcx);
        buf_str(b, c"static var ");
        buf_bytes(b, SYMS[name].text);
    } else if kind == 3 {
        err_str(c"', a let receiver: it is read-only", pcx);
        err_help(c"take the receiver inout to change it", pcx);
        buf_str(b, c"inout self");
    } else if kind == 2 {
        err_str(c"', a let parameter: it is read-only", pcx);
        err_help(
            c"take it inout to change the caller's value, or `sink` for a copy of its own", pcx);
        buf_bytes(b, SYMS[name].text);
        buf_str(b, c": inout ");
        // (the type as written, `F` in a generic, else the type)
        let written = written_param_type(name, pcx);
        if written.len > 0 {
            buf_bytes(b, written);
        } else {
            buf_type(b, t);
        }
    } else {
        err_str(c"', a let binding: it is read-only", pcx);
        err_help(c"declare it `var` to change it", pcx);
        buf_str(b, c"var ");
        buf_bytes(b, SYMS[name].text);
        buf_str(b, c" = ...");
    }
    err_try_fmt(buf_slice(b), pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// The type of the current function's parameter `name` as written (empty: none
// written, or no such parameter).
fn written_param_type(name: i64, pcx: Ctx<Comp>) -> [u8] {
    unsafe {
        if pcx.cur_fn < 0 {
            return "";
        }
        let fnode = FNS[pcx.cur_fn].node;
        if fnode <= 0 {
            return "";
        }
        for i in 0..NODES[fnode].count {
            let p = child(fnode, i, pcx);
            if NODES[p].kind == NodeKind::Param && NODES[p].a == name && NODES[p].b > 0 {
                let tn = NODES[p].b;
                return SRC[NODES[tn].start..NODES[tn].end];
            }
        }
        ""
    }
}

fn check_mutable_name(ident: i64, target: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let name = NODES[ident].a;
        let local = if NODES[ident].res == Res::Local { NODES[ident].y } else { -1 };
        if local >= 0 {
            note_local_write(local, &pcx);
            if LOCALS[local].mutable {
                return;
            }
            err_begin(NODES[target].start, &pcx);
            err_str(c"cannot assign to immutable variable '", pcx);
            err_sym(name, pcx);
            err_str(c"'", pcx);
            // (mixed files keep the 0.19 words until Phase M)
            let legacy = !crate::front::conv::strict_at(NODES[target].start, &pcx);
            if LOCALS[local].is_param && !legacy {
                // (0.20, conventions.md §2.1: a let parameter is read-only)
                err_help(c"a parameter is read-only (let); to change the caller's value take it `",
                    pcx);
                err_help_sym(name, pcx);
                err_help(c": inout ", pcx);
                buf_type(pcx.err_help, LOCALS[local].ty);
                err_help(c"` (called with `&x`); for a copy of its own, `", pcx);
                err_help_sym(name, pcx);
                err_help(c": sink ", pcx);
                buf_type(pcx.err_help, LOCALS[local].ty);
                err_help(c"`", pcx);
            } else if !legacy {
                err_help(c"make it mutable: `var ", pcx);
                err_help_sym(name, pcx);
                err_help(c"`", pcx);
            } else if LOCALS[local].is_param {
                err_help(c"make the parameter mutable: `mut ", pcx);
                err_help_sym(name, pcx);
                err_help(c": ", pcx);
                buf_type(pcx.err_help, LOCALS[local].ty);
                err_help(c"`", pcx);
            } else {
                err_help(c"make it mutable: `let mut ", pcx);
                err_help_sym(name, pcx);
                err_help(c"`", pcx);
            }
            err_end(&pcx);
        }
        if NODES[ident].res == Res::Static && !STATICS[NODES[ident].y].mutable {
            err_begin(NODES[target].start, &pcx);
            err_str(c"cannot assign to immutable static '", pcx);
            err_sym(name, pcx);
            err_str(c"'", pcx);
            err_help(
                if !crate::front::conv::strict_at(NODES[target].start, &pcx) {
                    c"declare it `static var "
                }
                else { c"declare it `static var " }, pcx);
            err_help_sym(name, pcx);
            err_help(c"`", pcx);
            err_end(&pcx);
        }
    }
}
