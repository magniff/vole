// Places and assignment: which expressions are places, `=` and the
// compound assignments (`+=` and the others, on numbers and vectors), and
// the mutability a write to a place needs.

use crate::base::{buf_bytes, buf_new, buf_slice, buf_str, get_src, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_help, err_help_sym, err_str, err_sym, err_try_fmt,
};
use crate::front::ast::{NODE_CHECKED, NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::ast::NodeKind::{FieldAccess, Ident, Index, Range, TupleField, Unary};
use crate::front::check::{Res, lookup_local, name_error, type_error, type_error_got};
use crate::front::check::check_mode::{check_expr, check_shift_amount};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::mark_no_read;
use crate::front::check::vectors::vector_operator_ok;
use crate::front::check::widen::takes_context;
use crate::front::closures::note_local_write;
use crate::front::distinct::strip_distinct;
use crate::front::lexer::Tok;
use crate::front::types::{
    REF_MUT, REF_SHARED, TY_NEVER, TyKind, buf_type, is_integer, is_numeric, is_pointer, is_slice,
    is_vector,
};

fn arith_token_of_assign(op: Tok) -> Tok {
    if op == Tok::PlusEq { return Tok::Plus; }
    if op == Tok::MinusEq { return Tok::Minus; }
    if op == Tok::StarEq { return Tok::Star; }
    if op == Tok::SlashEq { return Tok::Slash; }
    if op == Tok::PercentEq { return Tok::Percent; }
    if op == Tok::AmpEq { return Tok::Amp; }
    if op == Tok::PipeEq { return Tok::Pipe; }
    if op == Tok::CaretEq { return Tok::Caret; }
    op
}

// ---- Places and assignment ----

pub fn is_place(n: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        match { pcx.nodes[n as usize].kind } {
            Ident => {
                let name = pcx.nodes[n as usize].a;
                lookup_local(name, pcx).is_some() || (*pcx.sym_static.add(name as usize)) != 0
            }
            Unary => pcx.nodes[n as usize].op == Tok::Star,
            // Through a pointer.
            FieldAccess if pcx.nodes[n as usize].y == 1 => true,
            FieldAccess | TupleField => is_place(pcx.nodes[n as usize].a, pcx),
            Index => {
                let base = pcx.nodes[n as usize].a;
                if pcx.nodes[pcx.nodes[n as usize].b as usize].kind == Range {
                    return false;
                }
                is_pointer(pcx.nodes[base as usize].ty, pcx)
                    || is_slice(pcx.nodes[base as usize].ty, pcx) || is_place(base, pcx)
            }
            _ => false,
        }
    }
}

// RULE: F26.1 (0.27.2) `a op= b` of a rust program on std2, through the
// `op=` trait's impl for a's type: n becomes `a.op_assign(b)`, whose `&mut
// self` the probe takes from a (F6.3: a needs to be mutable).
fn op_assign_call(n: i64, pcx: &mut Ctx<Comp>) {
    let target = pcx.nodes[n as usize].b;
    let value = pcx.nodes[n as usize].c;
    let name = crate::front::traits::rust_op_method(pcx.nodes[n as usize].op);
    pcx.nodes[target as usize].p |= NODE_CHECKED;
    let call = new_node(NodeKind::MethodCall, pcx.nodes[n as usize].start,
        pcx.nodes[n as usize].end, pcx);
    pcx.nodes[call as usize].a = target;
    pcx.nodes[call as usize].b = intern_c(name, pcx);
    let mark = list_begin(pcx);
    list_push(value, pcx);
    list_end(call, mark, pcx);
    pcx.nodes[n as usize] = pcx.nodes[call as usize];
    synth_expr(n, pcx);
}

pub fn check_assign(n: i64, pcx: &mut Ctx<Comp>) {
    let op = pcx.nodes[n as usize].op;
    let target = pcx.nodes[n as usize].b;
    let value = pcx.nodes[n as usize].c;
    if op == Tok::Eq {
        // Writing a union's field reads nothing.
        mark_no_read(target, pcx);
    }
    if op == Tok::Eq && pcx.deferred.count > 0 && pcx.nodes[target as usize].kind == Ident {
        // (0.27.1) the first assignment of an untyped deferred `let x;`
        // gives it its type
        match crate::front::check::lookup_local(pcx.nodes[target as usize].a, pcx) {
            Some(l) => {
                if pcx.locals[l as usize].ty == 0
                    && (0i64..pcx.deferred.count / 2).any(|i| pcx.deferred.get(2 * i) == l) {
                    pcx.locals[l as usize].ty = synth_expr(value, pcx);
                    synth_expr(target, pcx);
                    check_mutable_place(target, pcx);
                    return;
                }
            }
            None => {}
        }
    }
    // RULE: F18.5 (c) (an open local assigned: by an untyped literal it
    // stays open, by a value of a definite type it takes that type)
    let mut open: i64 = -1;
    if pcx.open_lets.count > 0 && op != Tok::ShlEq && op != Tok::ShrEq
        && pcx.nodes[target as usize].kind == Ident {
        // (an open tuple or array takes a value of a definite type too,
        // `kv = e.remove_entry()`; only an integer one a literal)
        // (0.28.0: so does a tree of literals and open locals, `s += x`,
        // one variable with them: open_group)
        let lit = crate::front::check::literals::open_value(value, pcx);
        open = if lit { crate::front::check::literals::open_scalar(target, pcx) }
            else { crate::front::check::literals::open_local(target, pcx) };
        // (`s += f()?` too: a `?` takes no type from its target)
        if open >= 0 && !lit
            && pcx.nodes[value as usize].kind != NodeKind::Try && takes_context(value, pcx) {
            open = -1;
        }
    }
    let outer = pcx.assigning;
    pcx.assigning = n;
    let outer_place = pcx.mut_place;
    pcx.mut_place = target;
    pcx.open_keep = open >= 0;
    let target_ty = synth_expr(target, pcx);
    pcx.open_keep = false;
    pcx.mut_place = outer_place;
    pcx.assigning = outer;
    if pcx.const_ptrs.count > 0 {
        crate::front::check::rust::const_write(target, pcx);
    }
    if !is_place(target, pcx) {
        let name = pcx.nodes[target as usize].a;
        if pcx.nodes[target as usize].kind == Ident
            && pcx.nodes[target as usize].res == Res::Const {
            name_error(pcx.nodes[target as usize].start, c"cannot assign to constant '",
                pcx.nodes[pcx.consts[pcx.nodes[target as usize].y as usize].node as usize].a, c"'",
                pcx);
        }
        if pcx.nodes[target as usize].kind == Ident && pcx.nodes[target as usize].res == Res::Fn {
            name_error(pcx.nodes[target as usize].start, c"cannot assign to function '", name, c"'",
                pcx);
        }
        type_error(target, c"invalid assignment target", pcx);
    }
    check_mutable_place(target, pcx);
    if open >= 0 && crate::front::check::literals::open_value(value, pcx)
        && !crate::front::check::literals::open_literal(value, pcx) {
        // (the tree checked, its open locals kept, and typed with the local;
        // its literals checked to fit when it is: `i += 1 << 31`)
        let saved_init = pcx.open_init;
        pcx.open_init = value;
        pcx.open_keep = true;
        synth_expr(value, pcx);
        pcx.open_keep = false;
        pcx.open_init = saved_init;
        crate::front::check::literals::open_record(
            crate::front::check::literals::open_local(target, pcx), value, pcx);
        return;
    } else if open >= 0 && crate::front::check::literals::open_literal(value, pcx) {
        // (the literal typed with the local)
        crate::front::check::literals::open_record(
            crate::front::check::literals::open_local(target, pcx), value, pcx);
    } else if open >= 0 {
        let vt = synth_expr(value, pcx);
        // (`s += x` of an `x: &i64` reads through it, as the operator does)
        let through = if vt > 0 && pcx.types[vt as usize].kind == TyKind::Ptr
            && pcx.types[vt as usize].b != 0
            && is_integer(pcx.types[vt as usize].a) { pcx.types[vt as usize].a } else { vt };
        let tt = crate::front::check::literals::open_settle(target, through, pcx);
        if op != Tok::Eq && !is_numeric(tt) {
            type_error_got(n, c"compound assignment requires numeric type", tt, pcx);
        }
        let kind = pcx.nodes[value as usize].kind;
        if kind == Ident || kind == NodeKind::FieldAccess || kind == NodeKind::TupleField
            || kind == NodeKind::Index || kind == NodeKind::Call || kind == NodeKind::MethodCall
            || kind == NodeKind::Path || kind == NodeKind::Cast {
            // (the value checked as check_expr would, from its type)
            pcx.nodes[value as usize].p |= NODE_CHECKED;
            check_expr(value, tt, pcx);
        } else if vt != tt && vt != TY_NEVER && vt != pcx.ty_error && tt != pcx.ty_error
            && !crate::front::check::widen::try_widen(value, vt, tt, pcx) {
            crate::front::check::mismatch_error(value, tt, vt, pcx);
        }
        return;
    }
    if op == Tok::Eq {
        // RULE: D3.6a (0.27.7: a place declared `*mut T` takes no `&T`)
        let saved_raw = pcx.raw_mut_at;
        pcx.raw_mut_at = crate::front::check::rust::raw_mut_value(value,
            crate::front::check::rust::place_type_node(target, pcx), pcx);
        check_expr(value, target_ty, pcx);
        pcx.raw_mut_at = saved_raw;
        return;
    }
    // RULE: F26.1, F26.2 (0.27.2: on std2, `a += b` of a non-number is
    // `AddAssign::add_assign(&mut a, b)`, every `op=` alike)
    if crate::front::known::on_std2(pcx) && !is_numeric(strip_distinct(target_ty, pcx))
        && !is_vector(target_ty, pcx) {
        crate::front::check::synth_mode::require_op_bound(n, target, op, true, pcx);
        if crate::front::traits::rust_op_trait(op, target_ty, true, pcx) >= 0 {
            op_assign_call(n, pcx);
            return;
        }
    }
    if op == Tok::ShlEq || op == Tok::ShrEq {
        // (0.18: a distinct type as its underlying type)
        if !is_integer(strip_distinct(target_ty, pcx)) {
            type_error_got(n, c"shift assignment requires integer type", target_ty, pcx);
        }
        check_shift_amount(value, pcx);
        return;
    }
    if is_vector(target_ty, pcx) {
        // (0.10: lanewise, as the operator)
        vector_operator_ok(n, arith_token_of_assign(op), target_ty, pcx);
        check_expr(value, target_ty, pcx);
        return;
    }
    if op == Tok::AmpEq || op == Tok::PipeEq || op == Tok::CaretEq {
        if !is_integer(strip_distinct(target_ty, pcx)) {
            type_error_got(n, c"bitwise assignment requires integer type", target_ty, pcx);
        }
    } else if !is_numeric(strip_distinct(target_ty, pcx)) {
        type_error_got(n, c"compound assignment requires numeric type", target_ty, pcx);
    }
    check_expr(value, target_ty, pcx);
}

pub fn check_mutable_place(target: i64, pcx: &mut Ctx<Comp>) {
    let root = place_root(target, pcx);
    if root > 0 {
        check_mutable_name(root, target, pcx);
    } else {
        note_write_through(target, pcx);
    }
}

// (0.25) A write through an inout access a local holds (`c.n += 1` with
// `struct C { n: inout i64 }`, `self.q.push(x)` through an inout field): a
// closure that does it changes that local, which it then captures inout
// (closures::note_local_write; the closure is move-only).
pub fn note_write_through(target: i64, pcx: &mut Ctx<Comp>) {
    let mut e = target;
    for _ in 0..64 {
        match { pcx.nodes[e as usize].kind } {
            Unary if pcx.nodes[e as usize].op == Tok::Star => {
                // (only through an inout access, not a raw pointer)
                let t = pcx.nodes[pcx.nodes[e as usize].b as usize].ty;
                if t <= 0 || pcx.types[t as usize].kind != TyKind::Ptr
                    || pcx.types[t as usize].b != REF_MUT {
                    return;
                }
                e = pcx.nodes[e as usize].b;
            }
            Index => {
                let t = pcx.nodes[pcx.nodes[e as usize].a as usize].ty;
                if t > 0 && (pcx.types[t as usize].kind == TyKind::Ptr
                    || pcx.types[t as usize].kind == TyKind::Slice
                    && pcx.types[t as usize].b != REF_MUT) {
                    return;
                }
                e = pcx.nodes[e as usize].a;
            }
            FieldAccess | TupleField => e = pcx.nodes[e as usize].a,
            Ident => {
                if pcx.nodes[e as usize].res == Res::Local && pcx.nodes[e as usize].y >= 0
                    && (pcx.locals[pcx.nodes[e as usize].y as usize].mutable
                        || pcx.locals[pcx.nodes[e as usize].y as usize].access) {
                    note_local_write(pcx.nodes[e as usize].y, pcx);
                }
                return;
            }
            _ => return,
        }
    }
}

// The Ident a write to place `target` changes, through fields, tuple parts
// and the elements of an array (0: none to check, the place reached
// through a pointer, a reference or a slice, or not a place).
pub fn place_root(target: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut root = target;
    loop {
        match { pcx.nodes[root as usize].kind } {
            // Through a pointer: no `mut` needed.
            FieldAccess if pcx.nodes[root as usize].y == 1 => return 0,
            FieldAccess | TupleField => root = pcx.nodes[root as usize].a,
            Index if !is_pointer(pcx.nodes[pcx.nodes[root as usize].a as usize].ty, pcx)
                && !is_slice(pcx.nodes[pcx.nodes[root as usize].a as usize].ty, pcx) => root = pcx.nodes[root as usize].a,
            Ident => return root,
            _ => return 0,
        }
    }
}

// (0.25) The rule of an inout access: `&place` taken exclusive (an inout
// argument, `inout r = &place`, `match &place`, `for inout x in &place`)
// and the receiver of an `inout self` method (`c.inc()`, `v.push(x)`,
// `v[i] = x` through `as_mut_slice`) need the place's root mutable: a
// `var` local, an inout parameter or `inout self`, a `static var`, or
// memory reached through a raw pointer (unsafe) or an inout access. A let
// binding, a let parameter, a let receiver and an immutable static (in
// read-only data) are read-only: own.readonly, naming the binding. (A let
// access to an owned value, a reference inside, is the own pass's:
// views::on_mut_loan.) `at` is the node reported: the `&`, the call.
// `&place` given where a raw `*T` is wanted is its address, not an
// access (unsafe code answers for writes through it): its check waits for
// the function's end (flush_inout_places), when the node's type says.
pub fn check_inout_place(target: i64, at: i64, pcx: &mut Ctx<Comp>) {
    let kind = inout_root_kind(target, pcx);
    if kind != 0 {
        inout_place_error(at, kind, pcx.nodes[pcx.inout_root as usize].a, pcx.inout_root_ty, pcx);
    }
}

// (0.25) The call of a sink closure that changes what it owns, through
// place `callee`: the rule of an inout access (check_inout_place), and a let
// access (a let parameter of a generic's instance, `f: F`) is read-only
// too: own.readonly.
pub fn check_closure_call_place(callee: i64, at: i64, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[callee as usize].kind == Ident && pcx.nodes[callee as usize].res == Res::Local
        && pcx.nodes[callee as usize].y >= 0 {
        let l = pcx.nodes[callee as usize].y;
        let t = pcx.locals[l as usize].ty;
        if pcx.locals[l as usize].access && t > 0 && pcx.types[t as usize].kind == TyKind::Ptr
            && pcx.types[t as usize].b == REF_SHARED {
            inout_place_error(at, if pcx.locals[l as usize].is_param { 2 } else { 1 },
                pcx.nodes[callee as usize].a, pcx.types[t as usize].a, pcx);
            return;
        }
    }
    check_inout_place(callee, at, pcx);
}

// The same for `&place` (synth_unary): reported at the function's end
// unless the `&` became a raw pointer.
pub fn defer_inout_place(target: i64, at: i64, pcx: &mut Ctx<Comp>) {
    let kind = inout_root_kind(target, pcx);
    if kind != 0 {
        pcx.inout_pending.push(at);
        pcx.inout_pending.push(kind);
        pcx.inout_pending.push(pcx.nodes[pcx.inout_root as usize].a);
        pcx.inout_pending.push(pcx.inout_root_ty);
    }
}

pub fn clear_inout_places(pcx: &mut Ctx<Comp>) {
    pcx.inout_pending.clear();
    pcx.raw_addrs.clear();
    pcx.let_amps.clear();
}

pub fn flush_inout_places(pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut i: i64 = 0;
        while i + 3 < pcx.inout_pending.count {
            let at = (*pcx.inout_pending.data.add(i as usize));
            let t0 = pcx.nodes[at as usize].ty;
            let t = if t0 > 0 { strip_distinct(t0, pcx) } else { t0 };
            // (only an exclusive access is checked: `&x` that became a raw
            // pointer, a let `[T]` or `str`, or a let view is none)
            let mut raw = !(t > 0
                && (pcx.types[t as usize].kind == TyKind::Ptr
                    || pcx.types[t as usize].kind == TyKind::Slice)
                && pcx.types[t as usize].b == REF_MUT);
            for j in 0..pcx.raw_addrs.count {
                if (*pcx.raw_addrs.data.add(j as usize)) == at {
                    raw = true;
                }
            }
            if (*pcx.inout_pending.data.add((i + 1) as usize)) == 5 {
                // (conv.place: only where the access is inout)
                // (`inout r = &make()` binds the temporary: no lending)
                let mut bound = false;
                for j in 0..pcx.let_amps.count {
                    if (*pcx.let_amps.data.add(j as usize)) == at {
                        bound = true;
                    }
                }
                if !raw && !bound {
                    conv_place_error(at, pcx);
                }
            } else if !raw {
                inout_place_error(at, (*pcx.inout_pending.data.add((i + 1) as usize)),
                    (*pcx.inout_pending.data.add((i + 2) as usize)),
                    (*pcx.inout_pending.data.add((i + 3) as usize)), pcx);
            }
            i += 4;
        }
        clear_inout_places(pcx);
    }
}

// conv.place: `&make()` lent inout, a temporary whose change is lost.
fn conv_place_error(at: i64, pcx: &mut Ctx<Comp>) {
    let text = &get_src()[
        pcx.nodes[at as usize].start as usize..pcx.nodes[at as usize].end as usize];
    let value = if text.len() > 1 && text[0] == b'&' { &text[1..text.len()] } else { text };
    let m = buf_new();
    buf_str(m, c"'&' lends a place for the callee to change; '");
    buf_bytes(m, value);
    buf_str(m, c"' is a temporary, whose change would be lost");
    crate::front::conv::conv_error(crate::front::conv::CODE_PLACE, pcx.nodes[at as usize].start,
        pcx.nodes[at as usize].end, buf_slice(m),
        b"name it first, then lend it: 'var t = VALUE;' and '&t'", b"", pcx);
}

// What the root of place `target` is when an inout access of it breaks the
// rule (0: nothing wrong): 1 a let binding, 2 a let parameter, 3 a let
// receiver, 4 an immutable static; INOUT_ROOT is the Ident, INOUT_ROOT_TY
// its type.
fn inout_root_kind(target: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.inout_free > 0 {
        return 0;
    }
    let root = place_root(target, pcx);
    if root <= 0 {
        note_write_through(target, pcx);
        return 0;
    }
    pcx.inout_root = root;
    if pcx.nodes[root as usize].res == Res::Local {
        let local = pcx.nodes[root as usize].y;
        if local < 0 {
            return 0;
        }
        let t = pcx.locals[local as usize].ty;
        pcx.inout_root_ty = t;
        if pcx.locals[local as usize].mutable {
            // (a closure that changes it this way writes it)
            note_local_write(local, pcx);
        }
        // (an access, a reference: through it; a slice is a view,
        // whose writes the own pass checks: views::on_mut_loan)
        if pcx.locals[local as usize].mutable || pcx.locals[local as usize].access
            || t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != 0
            || t > 0 && pcx.types[t as usize].kind == TyKind::Slice {
            return 0;
        }
        if sym_text(pcx.nodes[root as usize].a, pcx) == b"self" {
            return 3;
        }
        return if pcx.locals[local as usize].is_param { 2 } else { 1 };
    }
    if pcx.nodes[root as usize].res == Res::Static
        && !pcx.statics[pcx.nodes[root as usize].y as usize].mutable {
        pcx.inout_root_ty = pcx.statics[pcx.nodes[root as usize].y as usize].ty;
        return 4;
    }
    0
}

fn inout_place_error(at: i64, kind: i64, name: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let text = &get_src()[
        pcx.nodes[at as usize].start as usize..pcx.nodes[at as usize].end as usize];
    // RULE: D8.1 (0.28.0, the rust edition: rustc's E0596 and its words,
    // the borrow checker's code; own.readonly and `var` were MVS's)
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.borrow_immutable";
    err_begin(pcx.nodes[at as usize].start, pcx);
    let b = buf_new();
    if kind == 4 {
        err_str(c"cannot borrow immutable static item '", pcx);
        err_sym(name, pcx);
        err_str(c"' as mutable (rustc E0596)", pcx);
        err_help(c"a static that changes is a `static mut`, or holds a cell or an atomic", pcx);
    } else if kind == 3 {
        err_str(c"cannot borrow '*", pcx);
        err_sym(name, pcx);
        err_str(c"' as mutable, which is behind a `&` reference (rustc E0596)", pcx);
        err_help(c"take the receiver as `&mut self`", pcx);
        buf_str(b, c"&mut self");
    } else {
        err_str(c"cannot borrow '", pcx);
        err_sym(name, pcx);
        err_str(c"' as mutable, as it is not declared as mutable (rustc E0596)", pcx);
        if kind == 2 {
            err_help(c"declare the parameter `mut`", pcx);
            buf_str(b, c"mut ");
            buf_bytes(b, sym_text(name, pcx));
        } else {
            err_help(c"declare it `let mut`", pcx);
            buf_str(b, c"let mut ");
            buf_bytes(b, sym_text(name, pcx));
            buf_str(b, c" = ...");
        }
    }
    if buf_slice(b).len() > 0 {
        err_try_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    return;
}

fn check_mutable_name(ident: i64, target: i64, pcx: &mut Ctx<Comp>) {
    let name = pcx.nodes[ident as usize].a;
    let local: i64 = if pcx.nodes[ident as usize].res == Res::Local { pcx.nodes[ident as usize].y }
        else { -1 };
    if local >= 0 {
        note_local_write(local, pcx);
        if pcx.locals[local as usize].mutable
            || (0i64..pcx.deferred.count / 2).any(|i| pcx.deferred.get(2 * i) == local) {
            return;
        }
        err_begin(pcx.nodes[target as usize].start, pcx);
        err_str(c"cannot assign to immutable variable '", pcx);
        err_sym(name, pcx);
        err_str(c"'", pcx);
        // (mixed files keep the 0.19 words until Phase M)
        if pcx.locals[local as usize].is_param {
            err_help(c"make the parameter mutable: `mut ", pcx);
            err_help_sym(name, pcx);
            err_help(c": ", pcx);
            buf_type(pcx.err_help, pcx.locals[local as usize].ty, pcx);
            err_help(c"`", pcx);
        } else {
            err_help(c"make it mutable: `let mut ", pcx);
            err_help_sym(name, pcx);
            err_help(c"`", pcx);
        }
        err_end(pcx);
    }
    if pcx.nodes[ident as usize].res == Res::Static
        && !pcx.statics[pcx.nodes[ident as usize].y as usize].mutable {
        err_begin(pcx.nodes[target as usize].start, pcx);
        err_str(c"cannot assign to immutable static '", pcx);
        err_sym(name, pcx);
        err_str(c"'", pcx);
        err_help(
            c"declare it `static var ", pcx);
        err_help_sym(name, pcx);
        err_help(c"`", pcx);
        err_end(pcx);
    }
}
