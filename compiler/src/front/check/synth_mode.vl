// Synth mode: the type of an expression computed from the expression
// alone (synth_expr), and the expressions that need no more than that:
// suffixed literals, casts, indexing and slicing, fields and tuple fields,
// arrays, the binary and unary operators, and the layout queries
// (`size_of`, `align_of`) folded to constants.

use crate::base::{
    SRC, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, buf_uint, intern, intern_c,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_help_sym,
    err_int, err_str, err_sym, err_try_fmt, report_warning,
};
