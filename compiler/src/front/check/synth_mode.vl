use crate::gen0::target::enum_panic_kind;

pub fn synth_expr(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    // (0.17) a node the checker moved under a new one, checked already
    if (pcx.nodes[n].p & NODE_CHECKED) != 0 {
        return pcx.nodes[n].ty;
    }
    fold_layout_query(n, &pcx);
    // (0.17: the own pass's record, front/own/fast.vl)
    let mark = crate::front::own::fast::expr_enter(n, &pcx);
    let ty = synth_expr_inner(n, &pcx);
    pcx.nodes[n].ty = ty;
    // (0.18: a requires checked at the call, an assertion made a check)
    if pcx.nodes[n].kind == NodeKind::Call {
        desugar_call(n, &pcx);
    }
    crate::front::own::fast::synth_exit(n, ty, mark, &pcx);
    ty
}

fn synth_expr_inner(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    match pcx.nodes[n].kind {
        Int | Float => {
            if pcx.nodes[n].b != SUF_NONE {
                return suffixed_literal(n, false, &pcx);
            }
            if pcx.nodes[n].kind == Int { TY_I64 } else { TY_F64 }
        }
        // RULE: F1.2 (0.27.2: a rust-edition character literal is a `char`,
        // b == 1; a byte literal, 2, and MVS's are u8)
        Char => if pcx.nodes[n].b == 1 && pcx.char_type != 0 { pcx.char_type } else { TY_U8 },
        Bool => TY_BOOL,
        Unit => TY_UNIT,
        // RULE: F23.1 (0.27.2: on std2 a rust-edition string literal is a
        // `&'static str`, std2's str, not the bytes: `panic("..")` finds
        // `str: Display`)
        Str => if pcx.std2 && pcx.edition != 0 && pcx.str_type > 0
            && crate::front::check::rust::rust_node(n, &pcx) { pcx.str_type }
            else { pcx.ty_string },
        CStr => pcx.ty_u8_ptr,
        Ident => synth_name(n, &pcx),
        EnumPanic => {
            synth_expr(pcx.nodes[n].a, &pcx);
            TY_NEVER
        }
        // Already checked (a path made a variant), when a rewrite checks
        // an expression again.
        VariantLit => pcx.nodes[n].ty,
        VecOp => synth_vecop(n, &pcx),
        Binary => synth_binary(n, &pcx),
        Unary => synth_unary(n, &pcx),
        Cast => synth_cast(n, &pcx),
        Call => synth_call(n, &pcx),
        Index => synth_index(n, &pcx),
        FieldAccess => synth_field(n, &pcx),
        TupleField => synth_tuple_field(n, &pcx),
        Tuple => {
            let mark = pcx.tscratch.count;
            for i in 0..pcx.nodes[n].count {
                let elem = synth_expr(child(n, i, pcx), &pcx);
                pcx.tscratch.push(elem);
            }
            make_type(TyKind::Tuple, 0, 0, mark, &pcx)
        }
        Array => synth_array(n, &pcx),
        Repeat => {
            let elem = synth_expr(pcx.nodes[n].a, &pcx);
            array_of(elem, eval_array_len(pcx.nodes[n].b, &pcx), &pcx)
        }
        StructLit => {
            // (0.17: `E::V { a: x }`, a struct-like variant's literal)
            if variant_literal(n, &pcx) { synth_expr_inner(n, &pcx) }
            else { check_struct_fields(n, 0, &pcx) }
        }
        Block => check_block(n, 0, &pcx),
        If => synth_if(n, &pcx),
        Match => check_match(n, 0, &pcx),
        Path => synth_path(n, &pcx),
        MethodCall => synth_method(n, &pcx),
        Loop => check_loop(n, 0, &pcx),
        While => check_while(n, &pcx),
        For => check_for(n, &pcx),
        Range => range_value(n, 0, &pcx),
        Closure => check_closure(n, 0, &pcx),
        // (0.15)
        NodeKind::Try => check_try(n, 0, &pcx),
        NodeKind::Interp => check_interp(n, 0, &pcx),
        NodeKind::NamedArg => misplaced_named_arg(n, &pcx),
        Assign => {
            check_assign(n, &pcx);
            TY_UNIT
        }
        Return => check_return(n, &pcx),
        Break => {
            check_break(n, &pcx);
            TY_NEVER
        }
        Continue => {
            pcx.nodes[n].x = find_loop(n, c"continue", &pcx);
            TY_NEVER
        }
        _ => type_error(n, c"internal error: not an expression", &pcx),
    }
}

fn suffix_type(suffix: i64) -> i64 {
    if suffix == SUF_I8 { return TY_I8; }
    if suffix == SUF_I16 { return TY_I16; }
    if suffix == SUF_I32 { return TY_I32; }
    if suffix == SUF_I64 { return TY_I64; }
    if suffix == SUF_ISIZE { return TY_ISIZE; }
    if suffix == SUF_U8 { return TY_U8; }
    if suffix == SUF_U16 { return TY_U16; }
    if suffix == SUF_U32 { return TY_U32; }
    if suffix == SUF_U64 { return TY_U64; }
    if suffix == SUF_USIZE { return TY_USIZE; }
    if suffix == SUF_F32 { return TY_F32; }
    TY_F64
}

// `1u8`, `2.5f32`; `negated` allows `-128i8`.
fn suffixed_literal(n: i64, negated: bool, pcx: inout Ctx<Comp>) -> i64 {
    let ty = suffix_type(pcx.nodes[n].b);
    if pcx.nodes[n].kind == Int && is_integer(ty) {
        let value = pcx.nodes[n].a as u64;
        var limit = value;
        if negated && is_signed(ty) && value > 0 {
            limit = value - 1;
        }
        if limit > int_max(ty) {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"integer literal ", pcx);
            if negated {
                err_str(c"-", pcx);
            }
            buf_uint(pcx.err, value);
            err_str(c" does not fit in type '", pcx);
            err_type(ty, pcx);
            err_str(c"'", pcx);
            int_range_help(ty, pcx);
            err_end(&pcx);
        }
    }
    ty
}

fn is_valid_cast(from: i64, to: i64, pcx: Ctx<Comp>) -> bool {
    if is_fieldless_enum(from, pcx) && is_integer(to) { return true; }
    if is_integer(from) && is_fieldless_enum(to, pcx) { return true; }
    if is_numeric(from) && is_numeric(to) { return true; }
    if is_pointer(from, pcx) && is_pointer(to, pcx) { return true; }
    if is_integer(from) && is_pointer(to, pcx) { return true; }
    if is_pointer(from, pcx) && is_integer(to) { return true; }
    if from == TY_BOOL && is_integer(to) { return true; }
    from == TY_NEVER
}

fn synth_cast(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let operand = pcx.nodes[n].a;
    let from_ty = synth_expr(operand, &pcx);
    let to_ty = resolve_type(pcx.nodes[n].b, &pcx);
    // (0.25) `&x as *T`: an address, not an inout access
    let raw_to = strip_distinct(to_ty, pcx);
    if pcx.nodes[operand].kind == Unary && pcx.nodes[operand].op == Tok::Amp
        && is_pointer(raw_to, pcx)
        && pcx.types[raw_to].b == 0 {
        pcx.raw_addrs.push(operand);
    }
    // RULE: F1.3 (the rust edition's `char`: only `u8 as char`; a char
    // casts to the integers)
    if pcx.char_type != 0 && from_ty != to_ty
        && (to_ty == pcx.char_type && from_ty != TY_U8 && !has_error_type(from_ty, pcx)
            || from_ty == pcx.char_type && !is_integer(to_ty)) {
        let saved_kind = pcx.err_kind;
        pcx.err_kind = c"type.cast";
        err_begin(pcx.nodes[operand].start, &pcx);
        err_str(c"cannot cast '", pcx);
        err_type(from_ty, pcx);
        err_str(c"' to '", pcx);
        err_type(to_ty, pcx);
        err_str(c"'", pcx);
        if to_ty == pcx.char_type {
            err_help(c"only a u8 casts to char: a u32 is checked, `char::from_u32(x)`, as not every u32 is a char", pcx);
        }
        err_end_soft(&pcx);
        pcx.err_kind = saved_kind;
        return to_ty;
    }
    // (0.18: a distinct type converts as its underlying type does, and
    // to and from that type for free: the cast is its operand)
    let from = strip_distinct(from_ty, pcx);
    let to = strip_distinct(to_ty, pcx);
    if (from != from_ty || to != to_ty) && from == to {
        // (std::NonNull from a raw pointer: checked)
        if is_distinct_type(to_ty, pcx) && is_niche_alias(pcx.types[to_ty].b, pcx)
            && from == from_ty {
            return nonnull_cast(n, operand, to_ty, &pcx);
        }
        // (0.20) bytes become std's `str` only checked, outside std
        if to_ty == pcx.str_type && from == from_ty && !within_std(pcx.cur_mod, pcx) {
            bytes_as_str_error(n, operand, &pcx);
        }
        pcx.nodes[n] = pcx.nodes[operand];
        return to_ty;
    }
    // RULE: Z9.3 (0.27.2: a cast between fat pointers of one element type,
    // `&[T] as *const [T]`, `&mut [u8] as *mut [u8]`, `*mut [u8] as *mut
    // str`, keeps both words: the cast is its operand)
    if from > 0 && to > 0 && pcx.types[from].kind == TyKind::Slice
        && pcx.types[to].kind == TyKind::Slice && pcx.types[from].a == pcx.types[to].a
        && (crate::front::types::is_raw_view(from, pcx)
            || crate::front::types::is_raw_view(to, pcx))
        && crate::front::check::rust::rust_node(n, &pcx) {
        pcx.nodes[n] = pcx.nodes[operand];
        return to_ty;
    }
    if !is_valid_cast(from, to, pcx) {
        err_begin(pcx.nodes[operand].start, &pcx);
        err_str(c"cannot cast '", pcx);
        err_type(from_ty, pcx);
        err_str(c"' to '", pcx);
        err_type(to_ty, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
    if is_integer(from) && is_fieldless_enum(to, pcx) && to == to_ty {
        return enum_cast(n, operand, from, to, &pcx);
    }
    // RULE: F29.1 (the rust edition: an integer to a raw pointer is safe;
    // the deref is what is unsafe)
    if is_integer(from) && is_pointer(to, pcx)
        && !(pcx.nodes[operand].kind == Int && pcx.nodes[operand].a == 0)
        && !crate::front::check::rust::rust_node(n, &pcx) {
        unsafe_op(n, U_INT_PTR, c"casting an integer to a pointer is unsafe", &pcx);
    }
    to_ty
}

// (0.20) `b as str` of bytes outside std: an error, a `str` being UTF-8
// (str::from_utf8 checks it).
fn bytes_as_str_error(n: i64, operand: i64, pcx: inout Ctx<Comp>) {
    let text = SRC[pcx.nodes[operand].start..pcx.nodes[operand].end];
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"'as str' does not check that bytes are UTF-8", pcx);
    err_help(c"a `str` is UTF-8: bytes become one through `str::from_utf8(b)` (a Result, Utf8Error when they are not); `String::from_utf8_lossy_in(b, gpa)` replaces what is not", pcx);
    if crate::front::check::distinct::from_utf8_try_fits(&pcx) {
        err_try_fmt(format_args("str::from_utf8({text})?"), pcx);
    } else {
        err_help(c"; not with '?' here: the function does not return a Result whose error takes a Utf8Error (match the Result, or make the value a str where it comes from)", pcx);
    }
    err_end_soft(&pcx);
}

// `n as E` for a fieldless enum E (0.4), checked: it becomes
//   match n { d0 => E::V0, d1 => E::V1, ..., v => <panic: invalid value> }
// (the discriminants the operand's type can hold).
fn enum_cast(n: i64, operand: i64, from: i64, to: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let e = pcx.types[to].a;
        let start = pcx.nodes[n].start;
        let end = pcx.nodes[n].end;
        let m = new_node(Match, start, end, &pcx);
        pcx.nodes[m].a = operand;
        let mark = list_begin(pcx);
        for i in 0..ENUMS[e].variant_count {
            let v = enum_variant(e, i);
            let d = pcx.variants[v].discr;
            let fits = if is_signed(from) {
                let half = 1 << (int_bits(from) - 1) as u64;
                int_bits(from) == 64 || (d >= 0 - half && d < half)
            } else {
                d >= 0 && (int_bits(from) == 64 || d as u64 <= int_max(from))
            };
            if !fits {
                continue;
            }
            let lit = new_node(Int, start, end, &pcx);
            pcx.nodes[lit].a = if d < 0 { 0 - d } else { d };
            var value = lit;
            if d < 0 {
                value = new_node(Unary, start, end, &pcx);
                pcx.nodes[value].op = Tok::Minus;
                pcx.nodes[value].b = lit;
            }
            let pat = new_node(PatLit, start, end, &pcx);
            pcx.nodes[pat].a = value;
            let body = new_node(Path, start, end, &pcx);
            pcx.nodes[body].a = ENUMS[e].name;
            pcx.nodes[body].b = pcx.variants[v].name;
            let arm = new_node(Arm, start, end, &pcx);
            pcx.nodes[arm].a = pat;
            pcx.nodes[arm].c = body;
            list_push(arm, &pcx);
        }
        let name = intern_c(c"__invalid_value", &pcx);
        let bind = new_node(PatBind, start, end, &pcx);
        pcx.nodes[bind].a = name;
        let value = new_node(Ident, start, end, &pcx);
        pcx.nodes[value].a = name;
        let panic = new_node(EnumPanic, start, end, &pcx);
        pcx.nodes[panic].a = value;
        pcx.nodes[panic].x = enum_panic_kind(e, &pcx);
        let arm = new_node(Arm, start, end, &pcx);
        pcx.nodes[arm].a = bind;
        pcx.nodes[arm].c = panic;
        list_push(arm, &pcx);
        list_end(m, mark, &pcx);
        pcx.nodes[n] = pcx.nodes[m];
        synth_expr(n, &pcx)
    }
}

// `T` as a type node: for casts the checker adds.
fn type_name_node(t: i64, at: i64, pcx: inout Ctx<Comp>) -> i64 {
    let node = new_node(TyName, pcx.nodes[at].start, pcx.nodes[at].end, &pcx);
    pcx.nodes[node].a = intern_c(primitive_name(t), &pcx);
    node
}

fn cast_node(e: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let c = new_node(Cast, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[c].a = e;
    pcx.nodes[c].b = type_name_node(t, e, &pcx);
    c
}

// The method `v[i]` (index node n) on a Vec or a Buf calls: as_mut_slice
// on MUT_PLACE's path, else as_slice.
fn slice_method(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    var p = pcx.mut_place;
    for _ in 0..1000 {
        if p == 0 {
            break;
        }
        if p == n {
            return intern_c(c"as_mut_slice", &pcx);
        }
        let k = pcx.nodes[p].kind;
        if k != Index && k != FieldAccess && k != TupleField {
            break;
        }
        p = pcx.nodes[p].a;
    }
    intern_c(c"as_slice", &pcx)
}

fn synth_index(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    var base = pcx.nodes[n].a;
    var base_ty = synth_expr(base, &pcx);
    var base_kind = pcx.types[base_ty].kind;
    if base_kind == TyKind::Struct && indexes_as_slice(base_ty, pcx) {
        // (0.17) `v[i]` (`v[a..b]`) on a Vec or a Buf is
        // `v.as_slice()[i]`: checked, and a place to assign, through
        // `v.as_mut_slice()` when it is written
        pcx.nodes[base].p |= NODE_CHECKED;
        let call = new_node(NodeKind::MethodCall, pcx.nodes[base].start, pcx.nodes[base].end, &pcx);
        pcx.nodes[call].a = base;
        pcx.nodes[call].b = slice_method(n, &pcx);
        let mark = list_begin(pcx);
        list_end(call, mark, &pcx);
        pcx.nodes[n].a = call;
        base = call;
        base_ty = synth_expr(call, &pcx);
        base_kind = pcx.types[base_ty].kind;
    }
    let index = pcx.nodes[n].b;
    // RULE: F30.3 (0.27.2: the rust edition does not index a raw pointer,
    // as Rust's: `*p.add(i)`, `slice::from_raw_parts(p, n)`; rustc E0608)
    if base_kind == TyKind::Ptr && pcx.types[base_ty].b == 0
        && crate::front::check::rust::rust_node(n, &pcx) && !in_std_ptr(pcx.nodes[n].start, pcx) {
        err_begin(pcx.nodes[base].start, &pcx);
        err_str(c"cannot index into a value of type '", pcx);
        err_type(base_ty, pcx);
        err_str(c"'", pcx);
        if pcx.nodes[index].kind == Range {
            err_help(c"a raw pointer is not indexed: make the slice, `unsafe { std::slice::from_raw_parts(p, n) }`, and index that (rustc E0608)", pcx);
        } else {
            err_help(c"a raw pointer is not indexed: offset it and read, `unsafe { *p.add(i) }` (rustc E0608)", pcx);
        }
        err_end(&pcx);
        return pcx.ty_error;
    }
    // (0.17) through a pointer to a Vec, a Buf or a slice: the one it
    // points to, checked; through a raw pointer, unsafe
    // (decided 2026-10-16) unless it points, as written, to a type
    // parameter (`p: *T`): arithmetic then, whatever T is
    if base_kind == TyKind::Ptr && indexes_through(pcx.types[base_ty].a, pcx)
        && !pointee_is_param(base, &pcx) {
        let pointee = pcx.types[base_ty].a;
        let raw = !is_borrow(base, pcx);
        if raw {
            unsafe_view_index(n, base, index, pointee, pcx.nodes[index].kind == Range, &pcx);
            // (reported: the method called through p below is not)
            pcx.unsafe_depth += 1;
        }
        if pcx.types[pointee].kind == TyKind::Slice {
            // a borrow: `p[i]` is `(*p)[i]`
            let deref = synthetic_unary(Tok::Star, base, pointee, &pcx);
            pcx.nodes[n].a = deref;
            base = deref;
            base_ty = pointee;
            base_kind = TyKind::Slice;
        } else {
            // a borrow of a Vec or a Buf: `p.as_slice()[i]`, the
            // method called through the borrow, safely
            let call = new_node(NodeKind::MethodCall, pcx.nodes[base].start, pcx.nodes[base].end,
                &pcx);
            pcx.nodes[call].a = base;
            pcx.nodes[call].b = slice_method(n, &pcx);
            let mark = list_begin(pcx);
            list_end(call, mark, &pcx);
            pcx.nodes[base].p |= NODE_CHECKED;
            pcx.nodes[n].a = call;
            base = call;
            base_ty = synth_expr(call, &pcx);
            base_kind = pcx.types[base_ty].kind;
        }
        if raw {
            pcx.unsafe_depth -= 1;
        }
    }
    // (0.20) std's `str`: indexed as its bytes' slice (`s[i]` a u8), and
    // a range of it is a `str` (`s[1..]`)
    var text = 0;
    if is_view_distinct(base_ty, pcx) {
        text = base_ty;
        base_ty = pcx.types[base_ty].a;
        base_kind = TyKind::Slice;
    }
    if base_kind != TyKind::Array && base_kind != TyKind::Ptr && base_kind != TyKind::Slice
        && text == 0 && crate::front::check::rust::rust_node(n, &pcx)
        && crate::front::check::rust::index_through_trait(n, base_ty, &pcx) {
        // (0.27.0: `c[i]` through Index, the rust edition's)
        return synth_expr(n, &pcx);
    }
    if base_kind != TyKind::Array && base_kind != TyKind::Ptr && base_kind != TyKind::Slice {
        err_begin(pcx.nodes[base].start, &pcx);
        err_str(c"cannot index type '", pcx);
        err_type(base_ty, pcx);
        err_str(c"'", pcx);
        // (0.17) a Vec or a Buf through its slice, a HashMap by get
        let index = pcx.nodes[n].b;
        if pcx.nodes[base].end > pcx.nodes[base].start && index != 0
            && pcx.nodes[index].end > pcx.nodes[index].start {
            let b = SRC[pcx.nodes[base].start..pcx.nodes[base].end];
            let i = SRC[pcx.nodes[index].start..pcx.nodes[index].end];
            if is_std_named(base_ty, c"Vec", pcx) || is_std_named(base_ty, c"Buf", pcx) {
                err_help(c"its elements are its slice's: `v.as_slice()[i]` (also to assign), or `v.get(i)`, `v.set(i, x)`", pcx);
                err_try_fmt(format_args("{b}.as_slice()[{i}]"), pcx);
                let t = buf_new();
                buf_fmt(t, format_args("{b}.as_slice()[{i}]"));
                err_fix(pcx.nodes[n].start, pcx.nodes[n].end, buf_slice(t), &pcx);
            } else if is_std_named(base_ty, c"HashMap", pcx) {
                err_help(c"a HashMap is read with `m.get(k)` (an Option) and written with `m.insert(k, v)`", pcx);
                err_try_fmt(format_args("{b}.get({i})"), pcx);
            }
        }
        err_end(&pcx);
    }
    if base_kind == TyKind::Ptr {
        // (0.10: what --check-unsafe checks)
        pcx.nodes[n].p |= NODE_RAW;
        if pcx.nodes[index].kind == Range {
            unsafe_op(n, U_SLICE, c"slicing a raw pointer is unsafe", &pcx);
        } else if pcx.nodes[index].kind == Int && pcx.nodes[index].a == 0 {
            // (0.17) `p[0]`, meant as `*p`
            unsafe_index_zero(n, base, pcx.types[base_ty].a, &pcx);
        } else {
            unsafe_op(n, U_INDEX, c"indexing a raw pointer is unsafe", &pcx);
        }
    }
    if pcx.nodes[index].kind == Range {
        // Slicing.
        if pcx.nodes[index].a != 0 {
            check_index_type(pcx.nodes[index].a, &pcx);
        }
        if pcx.nodes[index].b != 0 {
            check_index_type(pcx.nodes[index].b, &pcx);
        } else if base_kind == TyKind::Ptr {
            type_error(index, c"slicing a pointer needs an end: 'p[lo..hi]'", &pcx);
        }
        pcx.nodes[index].ty = TY_UNIT;
        if text != 0 {
            return text;
        }
        return slice_of(pcx.types[base_ty].a, &pcx);
    }
    check_index_type(index, &pcx);
    pcx.types[base_ty].a
}

// (0.27.2) Whether position pos is in std2's `ptr` module, where the raw
// pointers' own primitives (`read`, `write`, `slice_parts`) are written
// with MVS's raw indexing: std::ptr of a program on std2, or the file
// compiler/std2/ptr.vl of std2's own check. RULE: F30.3
fn in_std_ptr(pos: i64, pcx: Ctx<Comp>) -> bool {
    let m = pcx.cur_mod;
    // UNSAFE: the module and file tables are the compiler's raw-pointer
    // globals; a file's path is a C string.
    // SAFETY: m is a module of the table (cur_mod, set by the checker); f
    // is the file pos is in (file_of_pos), its path NUL-terminated, read
    // only below its length.
    unsafe {
        if m >= 0 && pcx.std_module >= 0 && pcx.modules[m].parent == pcx.std_module
            && crate::base::sym_text(pcx.modules[m].name, pcx) == "ptr" {
            return true;
        }
        let f = crate::front::modules::file_of_pos(pos, pcx);
        if f < 0 {
            return false;
        }
        let path = pcx.files[f].path;
        let n = crate::base::strlen(path) as i64;
        let tail = "std2/ptr.vl";
        let k = tail.len() as i64;
        if n < k {
            return false;
        }
        for i in 0..k {
            if path[n - k + i] != tail[i] {
                return false;
            }
        }
        true
    }
}

// (0.17) Whether a value of type t (a struct) is indexed through its
// slice: std's Vec and Buf.
fn indexes_as_slice(t: i64, pcx: Ctx<Comp>) -> bool {
    pcx.std_module >= 0 && within_std(pcx.structs[pcx.types[t].a].module, pcx)
        && (is_std_named(t, c"Vec", pcx) || is_std_named(t, c"Buf", pcx))
}

// (0.17) Whether `p[i]` on a pointer of type *t indexes the pointee (a
// Vec, a Buf or a slice), not memory from p.
fn indexes_through(t: i64, pcx: Ctx<Comp>) -> bool {
    pcx.types[t].kind == TyKind::Slice
        || (pcx.types[t].kind == TyKind::Struct && indexes_as_slice(t, pcx))
}

// The index of `a[i]` (or an end of `a[i..j]`): an integer, or (0.18.1) a
// reference to one, read through (`keys[a]` in a `sort_by` closure, whose
// `a` is `&i64`; `*a` written for it).
fn check_index_type(index: i64, pcx: inout Ctx<Comp>) {
    let index_ty = synth_expr(index, &pcx);
    if is_ref(index_ty, pcx) && is_integer(pcx.types[index_ty].a) {
        let inner = new_node(NodeKind::Ident, pcx.nodes[index].start, pcx.nodes[index].end, &pcx);
        pcx.nodes[inner] = pcx.nodes[index];
        pcx.nodes[index].kind = Unary;
        pcx.nodes[index].op = Tok::Star;
        pcx.nodes[index].b = inner;
        pcx.nodes[index].a = 0;
        pcx.nodes[index].count = 0;
        pcx.nodes[index].p = 0;
        pcx.nodes[index].res = Res::None;
        pcx.nodes[index].x = 0;
        pcx.nodes[index].y = 0;
        pcx.nodes[index].ty = pcx.types[index_ty].a;
        return;
    }
    if !is_integer(index_ty) {
        err_begin(pcx.nodes[index].start, &pcx);
        err_str(c"index must be integer, got '", pcx);
        err_type(index_ty, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
}

// Fields of structs (also through a pointer to one: y = 1) and the `ptr`
// and `len` of slices (y = 2, x = 0 for ptr and 1 for len).
fn synth_field(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var base_ty = synth_expr(pcx.nodes[n].a, &pcx);
        let name = pcx.nodes[n].b;
        pcx.nodes[n].y = 0;
        if pcx.types[base_ty].kind == TyKind::Slice {
            pcx.nodes[n].y = 2;
            if name == intern_c(c"len", &pcx) {
                // usize (0.26.2, as Rust; i64 from 0.4, u64 before)
                pcx.nodes[n].x = 1;
                return TY_USIZE;
            }
            if name == intern_c(c"ptr", &pcx) {
                pcx.nodes[n].x = 0;
                return ptr_to(pcx.types[base_ty].a, &pcx);
            }
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"slices have the fields 'ptr' and 'len', not '", pcx);
            err_sym(name, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        // (0.17) `v.len` on std's Vec, Buf or HashMap (its field sealed, or
        // none) reads as `v.len()`, and `a.len` on an array place as
        // `a.len()`: both spellings are the length. A write (`v.len = n`,
        // `&v.len`) stays the sealed field's error.
        if name == intern_c(c"len", &pcx) && (pcx.nodes[n].p & NODE_NO_READ) == 0
            && len_is_method(n, base_ty, &pcx) {
            pcx.nodes[pcx.nodes[n].a].p |= NODE_CHECKED;
            pcx.nodes[n].kind = MethodCall;
            pcx.nodes[n].x = 0;
            pcx.nodes[n].list = 0;
            pcx.nodes[n].count = 0;
            return synth_method(n, &pcx);
        }
        if pcx.types[base_ty].kind == TyKind::Ptr
            && pcx.types[pcx.types[base_ty].a].kind == TyKind::Struct {
            pcx.nodes[n].y = 1;
            base_ty = pcx.types[base_ty].a;
            if !is_borrow(pcx.nodes[n].a, pcx) {
                pcx.nodes[n].p |= NODE_RAW;
                unsafe_through(n, pcx.nodes[n].a, U_FIELD,
                    c"access to a field through a raw pointer is unsafe", &pcx);
            }
        }
        if pcx.edition != 0 && crate::front::check::rust::rust_node(n, &pcx)
            && (pcx.types[base_ty].kind != TyKind::Struct
                || find_field(pcx.types[base_ty].a, name, pcx) < 0)
            && crate::front::check::rust::deref_field_base(n, pcx.nodes[n].a, base_ty, &pcx) {
            // (0.27.0: a field of Deref's target, the rust edition's)
            return synth_expr(n, &pcx);
        }
        if pcx.types[base_ty].kind != TyKind::Struct {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"cannot access field '", pcx);
            err_sym(name, pcx);
            err_str(c"' on type '", pcx);
            err_type(base_ty, pcx);
            err_str(c"'", pcx);
            enum_field_help(base_ty, name, pcx.nodes[n].a, pcx);
            err_end(&pcx);
        }
        let s = pcx.types[base_ty].a;
        let field = find_field(s, name, pcx);
        // (0.26.0: an `embed wgsl` block's entry point, gpu.entry)
        if field < 0 && crate::front::embed::wgsl::entry_error(n, pcx.structs[s].node, name, &pcx) {
            return pcx.ty_error;
        }
        if field < 0 {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"struct '", pcx);
            err_sym(pcx.structs[s].name, pcx);
            err_str(c"' has no field '", pcx);
            err_sym(name, pcx);
            err_str(c"'", pcx);
            if find_method(base_ty, name, pcx) >= 0 {
                err_help(c"'", pcx);
                err_help_sym(name, pcx);
                err_help(c"' is a method: call it with '(...)'", pcx);
            }
            help_near_field(s, name, &pcx);
            err_end(&pcx);
        }
        // (0.26.2: a part's own `.src` or entry field, embed.part_use)
        if pcx.block_struct.count > 0
            && crate::front::embed::wgsl::part_use_error(n, pcx.structs[s].node, name, &pcx) {
            return pcx.ty_error;
        }
        pcx.nodes[n].x = field;
        // (0.16: a #[sealed] struct's fields)
        check_field(n, s, &pcx);
        if (pcx.structs[s].repr & REPR_UNION) != 0 && (pcx.nodes[n].p & NODE_NO_READ) == 0 {
            unsafe_op(n, U_UNION, c"reading a field of a union is unsafe", &pcx);
        }
        let fty = (*struct_field(s, field, pcx)).ty;
        if (pcx.nodes[n].p & CONV_NEW) == 0 && is_ref(fty, pcx)
            && crate::front::conv::field_is_access(s, field, pcx) {
            // (0.20) an access field: `p.q` is `*p.q`, the value it designates
            let inner = new_node(NodeKind::None, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
            pcx.nodes[inner] = pcx.nodes[n];
            pcx.nodes[inner].p |= CONV_NEW | NODE_CHECKED;
            pcx.nodes[inner].ty = fty;
            pcx.nodes[n].kind = NodeKind::Unary;
            pcx.nodes[n].op = Tok::Star;
            pcx.nodes[n].a = 0;
            pcx.nodes[n].b = inner;
            pcx.nodes[n].count = 0;
            pcx.nodes[n].list = 0;
            pcx.nodes[n].p = 0;
            return synth_expr(n, &pcx);
        }
        fty
    }
}

// (0.17) Whether `x.len` (node n, x of type t) is read as `x.len()`: an
// array place, or std's Vec, Buf, HashMap (or a pointer to one).
fn len_is_method(n: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.types[t].kind == TyKind::Array {
        return is_plain_place(pcx.nodes[n].a, pcx);
    }
    var st = t;
    if pcx.types[st].kind == TyKind::Ptr {
        st = pcx.types[st].a;
    }
    pcx.types[st].kind == TyKind::Struct && len_reads_as_method(n, pcx.types[st].a, &pcx)
}

// The help of an unknown field `name` of struct s: the nearest field.
pub fn help_near_field(s: i64, name: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var near = near_to(name);
        for i in 0..pcx.structs[s].field_count {
            near.offer((*struct_field(s, i, pcx)).name, &pcx);
        }
        near.help(&pcx);
    }
}

fn synth_tuple_field(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    var base_ty = synth_expr(pcx.nodes[n].a, &pcx);
    let index = pcx.nodes[n].b;
    // RULE: F7.1 (the rust edition: `s.0` of a tuple struct, or through a
    // reference to one, is its field `0`)
    var inner = base_ty;
    while pcx.types[inner].kind == TyKind::Ptr {
        inner = pcx.types[inner].a;
    }
    if pcx.types[inner].kind == TyKind::Struct && crate::front::check::rust::rust_node(n, &pcx) {
        pcx.nodes[pcx.nodes[n].a].p |= NODE_CHECKED;
        let name = buf_new();
        buf_fmt(name, format_args("{index}"));
        pcx.nodes[n].kind = NodeKind::FieldAccess;
        pcx.nodes[n].b = intern(buf_slice(name), &pcx);
        return synth_field(n, &pcx);
    }
    if pcx.types[base_ty].kind == TyKind::Ptr
        && pcx.types[pcx.types[base_ty].a].kind == TyKind::Tuple {
        // (0.17) through a pointer to a tuple, as a field through a
        // pointer to a struct: `p.0` is `(*p).0`
        let base = pcx.nodes[n].a;
        base_ty = pcx.types[base_ty].a;
        let deref = synthetic_unary(Tok::Star, base, base_ty, &pcx);
        if !is_borrow(base, pcx) {
            pcx.nodes[deref].p |= NODE_RAW;
            unsafe_through(n, base, U_FIELD,
                c"access to a field through a raw pointer is unsafe", &pcx);
        }
        pcx.nodes[n].a = deref;
    }
    if pcx.types[base_ty].kind != TyKind::Tuple {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"cannot use tuple index on type '", pcx);
        err_type(base_ty, pcx);
        err_str(c"'", pcx);
        err_end(&pcx);
    }
    if index >= pcx.types[base_ty].count {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"tuple index ", pcx);
        err_int(index, pcx);
        err_str(c" out of range for tuple with ", pcx);
        err_int(pcx.types[base_ty].count, pcx);
        err_str(c" elements", pcx);
        err_end(&pcx);
    }
    type_elem(base_ty, index, pcx)
}

fn synth_array(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let count = pcx.nodes[n].count;
    if count == 0 {
        type_error(n, c"cannot infer the type of an empty array; annotate it", &pcx);
    }
    // (0.14) the type of the first element that is not an unsuffixed
    // literal: `[0, x]` is of x's type; (0.25.4) nor an array of them
    // (is_context_value): `[[0.5, 1.0], v]` is of v's type
    var first = 0;
    while first + 1 < count && is_context_value(child(n, first, pcx), pcx) {
        first += 1;
    }
    if is_context_value(child(n, first, pcx), pcx) {
        first = 0;
    }
    let elem = synth_expr(child(n, first, pcx), &pcx);
    for i in 0..count {
        if i != first {
            check_expr(child(n, i, pcx), elem, &pcx);
        }
    }
    array_of(elem, count, &pcx)
}

// ---- Operators ----

fn is_untyped_literal(n: i64, pcx: Ctx<Comp>) -> bool {
    match pcx.nodes[n].kind {
        Int | Float => pcx.nodes[n].b == SUF_NONE,
        Char => true,
        Unary if pcx.nodes[n].op == Tok::Minus => is_untyped_literal(pcx.nodes[n].b, pcx),
        _ => false,
    }
}

pub fn literal_takes_rhs_type(lhs: i64, rhs: i64, pcx: Ctx<Comp>) -> bool {
    is_untyped_literal(lhs, pcx) && !is_untyped_literal(rhs, pcx)
}

// Whether e is an unsuffixed literal whose type comes from the code around
// it (0.14): the literal, or a block of only it. `if c { b[i] } else { 0 }`,
// match arms and array elements give it the type of the others.
pub fn is_context_literal(e: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.nodes[e].kind == Block {
        return pcx.nodes[e].count == 0 && pcx.nodes[e].a != 0
            && is_context_literal(pcx.nodes[e].a, pcx);
    }
    is_untyped_literal(e, pcx)
}

// Whether e takes its type from the code around it: a context literal
// (is_context_literal) or (0.25.4) an array literal of them, nested too,
// or a block of only one: `[0.20, 0.52, 0.70, 1.0]` in an `if`, a match
// arm or an array beside a `[f32; 4]` is a `[f32; 4]`, as it is in a
// `let c: [f32; 4] = ..`.
pub fn is_context_value(e: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.nodes[e].kind == Block {
        return pcx.nodes[e].count == 0 && pcx.nodes[e].a != 0
            && is_context_value(pcx.nodes[e].a, pcx);
    }
    if pcx.nodes[e].kind == Array {
        let count = pcx.nodes[e].count;
        return count > 0 && (0..count).all(|i| is_context_value(child(e, i, pcx), pcx));
    }
    is_untyped_literal(e, pcx)
}

// The common type of a non-shift operator's operands. (0.15) Two integer
// types join to the wider one: an operand of a definite type is
// synthesized first (widen::takes_context), and the narrower is widened;
// an operand whose type comes from context (a literal, `None`) takes the
// other's. (0.18.1) An operand that is a reference to a number or a bool
// (a pattern's binding on a reference, `n + 1`; a closure's `&i64`) is
// read through, as Rust's operators on `&i64` do.
fn synth_operands(lhs: i64, rhs: i64, pcx: inout Ctx<Comp>) -> i64 {
    if literal_takes_rhs_type(lhs, rhs, pcx)
        || takes_context(lhs, &pcx) && !takes_context(rhs, &pcx) {
        let rhs_ty = read_through(rhs, synth_expr(rhs, &pcx), &pcx);
        check_expr(lhs, rhs_ty, &pcx);
        return rhs_ty;
    }
    let lhs_ty = read_through(lhs, synth_expr(lhs, &pcx), &pcx);
    if is_integer(lhs_ty) && !takes_context(rhs, &pcx) {
        return join_operands(lhs, lhs_ty, rhs, &pcx);
    }
    check_expr(rhs, lhs_ty, &pcx);
    lhs_ty
}

// (0.18.1) Operand e (of BINARY_NODE) of type ty: when it is `&T` of a
// number or a bool, `*e` in its place; T, or ty.
pub fn read_through(e: i64, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    let b = pcx.binary_node;
    if !is_ref(ty, pcx) || b <= 0 || !(is_numeric(pcx.types[ty].a) || pcx.types[ty].a == TY_BOOL) {
        return ty;
    }
    let t = pcx.types[ty].a;
    let u = synthetic_unary(Tok::Star, e, t, &pcx);
    if pcx.nodes[b].b == e {
        pcx.nodes[b].b = u;
    } else if pcx.nodes[b].c == e {
        pcx.nodes[b].c = u;
    } else {
        return ty;
    }
    t
}

fn synth_binary(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let op = pcx.nodes[n].op;
    let lhs = pcx.nodes[n].b;
    let rhs = pcx.nodes[n].c;
    if op == Tok::Shl || op == Tok::Shr {
        let value_ty = synth_expr(lhs, &pcx);
        let amount_ty = synth_expr(rhs, &pcx);
        // RULE: F26.1 (0.27.2: on std2 `a << n` of a non-integer is Shl::shl)
        if crate::front::known::on_std2(pcx) && crate::front::check::rust::rust_node(n, &pcx)
            && !is_integer(strip_distinct(value_ty, pcx)) {
            require_op_bound(n, lhs, op, false, &pcx);
            if crate::front::traits::rust_op_trait(op, value_ty, false, &pcx) >= 0 {
                return crate::front::traits::operator_call(n, value_ty, true, &pcx);
            }
        }
        // (0.18: a distinct type over an integer shifts as it does)
        if !is_integer(strip_distinct(value_ty, pcx)) {
            type_error_got(n, c"shift operator requires integer type", value_ty, &pcx);
        }
        if !is_integer(strip_distinct(amount_ty, pcx)) {
            type_error_got(n, c"shift amount must be integer", amount_ty, &pcx);
        }
        return value_ty;
    }
    let saved = pcx.binary_node;
    pcx.binary_node = n;
    var ty = synth_operands(lhs, rhs, &pcx);
    pcx.binary_node = saved;
    if is_ref(ty, pcx) && is_ref(pcx.nodes[lhs].ty, pcx) && is_ref(pcx.nodes[rhs].ty, pcx)
        && (op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::Gt
            || op == Tok::LtEq || op == Tok::GtEq) {
        // (0.17: a comparison of two references compares what they
        // point to, by T's Eq and Ord, as Rust's; raw `*T` pointers
        // compare as addresses)
        ty = pcx.types[ty].a;
        pcx.nodes[n].b = synthetic_unary(Tok::Star, lhs, ty, &pcx);
        pcx.nodes[n].c = synthetic_unary(Tok::Star, rhs, ty, &pcx);
    }
    // (0.18: two values of a distinct type: its underlying type's
    // operator)
    // RULE: F1.4 (a `char` compares; it has no arithmetic)
    if ty == pcx.char_type && pcx.char_type != 0 && !(op == Tok::EqEq || op == Tok::BangEq
        || op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq) {
        type_error_got(n, c"a char has no arithmetic (cast it, `c as u32`)", ty, &pcx);
    }
    if is_distinct_type(ty, pcx) {
        return distinct_binary(n, op, ty, &pcx);
    }
    binary_result(n, op, ty, &pcx)
}

// RULE: F26.2, D22.3 (0.27.2) An operator applied to a value of a type
// parameter's type (node e: a parameter, or `*p` of one) needs the
// operator's trait in the parameter's bounds: generic.unbounded_use
// (rustc E0369) naming the bound to add.
pub fn require_op_bound(n: i64, e: i64, op: Tok, assign: bool, pcx: inout Ctx<Comp>) {
    var x = e;
    if pcx.nodes[x].kind == NodeKind::Unary && pcx.nodes[x].op == Tok::Star {
        x = pcx.nodes[x].b;
    }
    if pcx.nodes[x].kind != NodeKind::Ident || pcx.nodes[x].res != Res::Local
        || pcx.nodes[x].y < 0 {
        return;
    }
    let p = pcx.locals[pcx.nodes[x].y].tparam;
    // (a raw pointer to a T, `*const T`, compares as an address)
    let xt = pcx.nodes[e].ty;
    if p == 0 || xt > 0 && pcx.types[xt].kind == TyKind::Ptr && pcx.types[xt].b == 0 {
        return;
    }
    let name = crate::front::traits::rust_op_trait_name(op, assign);
    if name == 0 as *u8 {
        return;
    }
    let tr = crate::front::traits::std_trait(name, &pcx);
    if tr < 0 {
        return;
    }
    let m = intern_c(crate::front::traits::rust_op_method(op), &pcx);
    let bounds = pcx.nodes[p].h;
    for i in 0..(if bounds == 0 { 0 } else { pcx.nodes[bounds].count }) {
        if crate::front::traits::trait_declares_closure(
            crate::front::traits::bound_trait(child(bounds, i, pcx), &pcx), m, &pcx) {
            return;
        }
    }
    let saved = pcx.err_kind;
    pcx.err_kind = c"generic.unbounded_use";
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"binary operation '", pcx);
    err_str(crate::front::traits::rust_op_sign(op), pcx);
    err_str(c"' cannot be applied to type '", pcx);
    err_sym(pcx.nodes[p].a, pcx);
    err_str(c"'", pcx);
    err_help(c"add the bound: '", pcx);
    err_help_sym(pcx.nodes[p].a, pcx);
    err_help(c": ", pcx);
    err_help_sym(pcx.traits[tr].name, pcx);
    err_help(c"'", pcx);
    err_end(&pcx);
    pcx.err_kind = saved;
}

// The type of binary node n (operator op, not a shift), whose operands are
// checked, of type ty.
pub fn binary_result(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let lhs = pcx.nodes[n].b;
        let rhs = pcx.nodes[n].c;
        if is_vector(ty, pcx) {
            return vector_binary(n, op, ty, &pcx);
        }
        // (0.9: an operator trait's impl for the type)
        // RULE: F26.1, F26.2 (0.27.2: a rust program on std2: the operator
        // is its ops trait's method, PartialEq, PartialOrd, Rem and the bit
        // traits among them; on a parameter's value, the bound must give it)
        if crate::front::known::on_std2(pcx) && crate::front::check::rust::rust_node(n, &pcx) {
            require_op_bound(n, lhs, op, false, &pcx);
            if crate::front::traits::rust_op_trait(op, ty, false, &pcx) >= 0 {
                return operator_call(n, ty, true, &pcx);
            }
        }
        if binary_op_trait(op, ty, &pcx) >= 0 {
            return operator_call(n, ty, false, &pcx);
        }
        if op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
            || op == Tok::Percent {
            if !is_numeric(ty) {
                arithmetic_error(n, op, ty, &pcx);
            }
            return ty;
        }
        if (op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq)
            && is_fieldless_enum(ty, pcx) {
            // 0.4: fieldless enums are ordered by declaration, which must be
            // the order of their discriminants; compared as their tags.
            let e = pcx.types[ty].a;
            for i in 1..ENUMS[e].variant_count {
                if pcx.variants[enum_variant(e, i)].discr
                    <= pcx.variants[enum_variant(e, i - 1)].discr {
                    err_begin(pcx.nodes[n].start, &pcx);
                    err_str(c"'", pcx);
                    err_sym(ENUMS[e].name, pcx);
                    err_str(c"' cannot be ordered: its discriminants do not increase in declaration order", pcx);
                    err_end(&pcx);
                }
            }
            pcx.nodes[n].b = cast_node(pcx.nodes[n].b, ENUMS[e].tag, &pcx);
            pcx.nodes[n].c = cast_node(pcx.nodes[n].c, ENUMS[e].tag, &pcx);
            synth_expr(pcx.nodes[n].b, &pcx);
            synth_expr(pcx.nodes[n].c, &pcx);
            return TY_BOOL;
        }
        if op == Tok::Lt || op == Tok::Gt || op == Tok::LtEq || op == Tok::GtEq {
            if !(is_numeric(ty) || is_pointer(ty, pcx)) {
                type_error_got(n, c"comparison requires numeric type", ty, &pcx);
            }
            unsigned_compare(n, op, ty, &pcx);
            return TY_BOOL;
        }
        if op == Tok::EqEq || op == Tok::BangEq {
            if ty == TY_NEVER || ty == pcx.ty_error {
                return TY_BOOL;
            }
            let bad = eq_unsupported(ty, &pcx);
            if bad != 0 {
                if bad == ty {
                    type_error_got(n, c"equality requires numeric, bool, pointer or enum type, or a struct, tuple, array or slice of them", ty, &pcx);
                }
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"cannot compare '", pcx);
                err_type(ty, pcx);
                err_str(c"' with ==: it holds a '", pcx);
                err_type(bad, pcx);
                err_str(c"', which has no ==", pcx);
                err_end(&pcx);
            }
            if is_compound(ty, pcx) {
                structural_eq(n, ty, &pcx);
            }
            return TY_BOOL;
        }
        if op == Tok::AmpAmp || op == Tok::PipePipe {
            if ty != TY_BOOL {
                type_error_got(n, c"logical operator requires bool", ty, &pcx);
            }
            return TY_BOOL;
        }
        if !is_integer(ty) {
            type_error_got(n, c"bitwise operator requires integer type", ty, &pcx);
        }
        ty
    }
}

// (0.26.2) `i >= 0` or `i < 0` of a usize local i (a length, since
// 0.26.2): always true or false, as a count down to 0 in a usize that
// never stops (num.unsigned-cmp, a warning; outside std).
fn unsigned_compare(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) {
    if ty != TY_USIZE || within_std(pcx.cur_mod, pcx) {
        return;
    }
    // (a local against 0: a count; `v.len() >= 0` is only redundant)
    let l = pcx.nodes[n].b;
    let r = pcx.nodes[n].c;
    let zero_r = pcx.nodes[r].kind == NodeKind::Int && pcx.nodes[r].a == 0
        && pcx.nodes[l].kind == NodeKind::Ident;
    let zero_l = pcx.nodes[l].kind == NodeKind::Int && pcx.nodes[l].a == 0
        && pcx.nodes[r].kind == NodeKind::Ident;
    let always_true = zero_r && op == Tok::GtEq || zero_l && op == Tok::LtEq;
    let always_false = zero_r && op == Tok::Lt || zero_l && op == Tok::Gt;
    if !always_true && !always_false {
        return;
    }
    let m = buf_new();
    buf_str(m, c"a '");
    buf_type(m, ty, pcx);
    buf_str(m, if always_true { c"' is never below 0: this comparison is always true" }
        else { c"' is never below 0: this comparison is always false" });
    buf_byte(m, 0);
    report_warning(pcx.nodes[n].start, 4, c"num.unsigned-cmp", buf_slice(m).ptr,
        c"a count down to 0 in an unsigned type: `while i > 0 { i -= 1; ... }`; or convert the length to i64 where it is made (`v.len() as i64`)", &pcx);
}

// (0.25.3, eval 0.25.2.2: qwen35, `Duration - Duration`) An arithmetic
// operator on a type that is not a number: the methods of its type that
// do it (`a.saturating_sub(b)`, `a.checked_sub(b)`), the first the try:
// and the fix.
fn arithmetic_error(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) -> ! {
    let (bin, lhs, rhs) = (pcx.nodes[n], pcx.nodes[pcx.nodes[n].b], pcx.nodes[pcx.nodes[n].c]);
    let k = pcx.types[ty].kind;
    let (lt, rt) = (SRC[lhs.start..lhs.end], SRC[rhs.start..rhs.end]);
    err_begin(bin.start, &pcx);
    err_str(c"arithmetic operator requires numeric type, got '", pcx);
    err_type(ty, pcx);
    err_str(c"'", pcx);
    let names: [[u8]] = if op == Tok::Minus {
        ["saturating_sub", "checked_sub", "abs_diff", "sub", "wrapping_sub"]
    } else if op == Tok::Plus {
        ["saturating_add", "checked_add", "add", "wrapping_add"]
    } else if op == Tok::Star {
        ["saturating_mul", "checked_mul", "mul", "mul_u32", "wrapping_mul"]
    } else if op == Tok::Slash {
        ["checked_div", "div", "div_u32"]
    } else {
        ["checked_rem", "rem"]
    };
    let found = buf_new();
    var first: [u8] = "";
    if k == TyKind::Struct || k == TyKind::Enum {
        for m in names {
            if crate::front::check::calls::method_of(ty, intern(m, &pcx), pcx) >= 0 {
                if first.len == 0 {
                    first = m;
                } else {
                    buf_bytes(found, ", ");
                }
                buf_bytes(found, "'");
                buf_bytes(found, m);
                buf_bytes(found, "'");
            }
        }
    }
    if first.len > 0 {
        err_help(c"'", pcx);
        crate::front::types::buf_type(pcx.err_help, ty, pcx);
        err_help_fmt(format_args("' has no operator; its methods do it: {} (`a.{first}(b)`)",
            buf_slice(found)), pcx);
        let t = buf_new();
        let simple = crate::front::check::plain_operand_text(lt);
        buf_bytes(t, if simple { "" } else { "(" });
        buf_bytes(t, lt);
        buf_bytes(t, if simple { "" } else { ")" });
        buf_fmt(t, format_args(".{first}("));
        buf_bytes(t, rt);
        buf_bytes(t, ")");
        err_try_fmt(buf_slice(t), pcx);
        err_fix(bin.start, bin.end, buf_slice(t), &pcx);
    }
    err_end(&pcx)
}

fn synth_unary(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let op = pcx.nodes[n].op;
    let operand = pcx.nodes[n].b;
    if op == Tok::Minus {
        var ty = 0;
        if pcx.nodes[operand].kind == Int && pcx.nodes[operand].b != SUF_NONE {
            ty = suffixed_literal(operand, true, &pcx);
            pcx.nodes[operand].ty = ty;
        } else {
            ty = synth_expr(operand, &pcx);
        }
        // (0.18: a distinct type over a number negates as it does)
        // (0.19: Intel's opaque vectors have no operators)
        if !is_numeric(strip_distinct(ty, pcx))
            && (!is_vector(ty, pcx) || is_opaque_vector(ty, pcx)) {
            let neg = std_trait(c"Neg", &pcx);
            if neg >= 0 && has_impl(neg, ty, &pcx) {
                return negation_call(n, ty, &pcx);
            }
            type_error_got(n, c"unary '-' requires numeric type", ty, &pcx);
        }
        return ty;
    }
    if op == Tok::Bang && crate::front::check::rust::rust_node(n, &pcx) {
        // (0.27.2) `!a`: logical on a bool, bitwise on an integer, else
        // Not::not (MVS's `~` is not the rust edition's). RULE: F26.1
        let ty = synth_expr(operand, &pcx);
        if ty == TY_BOOL || ty == pcx.ty_error {
            return TY_BOOL;
        }
        if is_integer(strip_distinct(ty, pcx)) && ty != pcx.char_type {
            pcx.nodes[n].op = Tok::Tilde;
            return ty;
        }
        let not = std_trait(c"Not", &pcx);
        if not >= 0 && has_impl(not, ty, &pcx) {
            return crate::front::traits::unary_call(n, ty, c"not", &pcx);
        }
        type_error_got(n,
            c"cannot apply unary operator '!': it needs a bool, an integer or an impl of Not", ty,
            &pcx);
        return TY_BOOL;
    }
    if op == Tok::Bang {
        check_expr(operand, TY_BOOL, &pcx);
        return TY_BOOL;
    }
    if op == Tok::Tilde {
        let ty = synth_expr(operand, &pcx);
        if !is_integer(strip_distinct(ty, pcx)) {
            type_error_got(n, c"bitwise NOT requires integer type", ty, &pcx);
        }
        return ty;
    }
    if op == Tok::Star {
        if star_on_access(n, operand, &pcx) {
            return synth_expr(n, &pcx);
        }
        let ty = synth_expr(operand, &pcx);
        // (0.17, issue #1: `(*f)(10)` on a fn value, C's habit: the
        // value is called as it is)
        if pcx.types[ty].kind == TyKind::Fn {
            fn_value_error(n, operand, c"deref", &pcx);
            return ty;
        }
        // RULE: Z9.3, F30.1 (0.27.2: `*p` of a fat raw pointer is the view
        // it points to, both words: unsafe, and its value is p's, until Z9's
        // unsized places)
        if crate::front::types::is_raw_view(ty, pcx)
            && crate::front::check::rust::rust_node(n, &pcx) {
            unsafe_through(n, operand, U_DEREF, c"dereference of a raw pointer is unsafe", &pcx);
            pcx.nodes[n] = pcx.nodes[operand];
            return crate::front::types::raw_view_target(ty, &pcx);
        }
        if pcx.edition != 0 && !is_pointer(ty, pcx) && crate::front::check::rust::rust_node(n, &pcx)
            && crate::front::check::rust::deref_operand(n, operand, ty, &pcx) {
            // (0.27.0: `*x` through Deref, the rust edition's)
            return synth_expr(n, &pcx);
        }
        // RULE: Z4.1 (0.27.2, std2: `*s` of a shared view, `&str` or `&[T]`,
        // is the unsized place, read as the view itself: `&**self` in Debug
        // for &T with T = str; an exclusive one stays an error until Z9.1)
        let view = if ty > 0 && pcx.types[ty].kind == TyKind::Distinct { pcx.types[ty].a }
            else { ty };
        if view > 0 && pcx.types[view].kind == TyKind::Slice && pcx.types[view].b == 0
            && crate::front::known::on_std2(pcx) && crate::front::check::rust::rust_node(n, &pcx) {
            pcx.nodes[n] = pcx.nodes[operand];
            return ty;
        }
        if !is_pointer(ty, pcx) && ty != pcx.ty_error && pcx.types[ty].kind != TyKind::Fn
            && crate::front::check::rust::rust_node(n, &pcx) {
            crate::front::check::rust::std_copy_error(n, operand, ty, &pcx);
            return ty;
        }
        if !is_pointer(ty, pcx) {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"cannot deref non-pointer type '", pcx);
            err_type(ty, pcx);
            err_str(c"'", pcx);
            // (0.25.2.2, eval 0.25.2.1: sph) `for x in xs { *x }`
            if pcx.nodes[operand].kind == Ident && pcx.nodes[operand].res == Res::Local
                && bound_by_for(
                    SRC[
                        pcx.files[crate::front::modules::file_of_pos(pcx.nodes[n].start, pcx)].start..pcx.nodes[
                            n].start],
                    sym_text(pcx.nodes[operand].a, pcx)) {
                let t = sym_text(pcx.nodes[operand].a, pcx);
                err_help_fmt(
                    format_args("'{t}' is a `for` loop's variable, the element's value already: write `{t}`, not `*{t}`"), pcx);
                err_try_fmt(format_args("{t}"), pcx);
            }
            err_end(&pcx);
        }
        if !is_borrow(operand, pcx) {
            pcx.nodes[n].p |= NODE_RAW;
            unsafe_through(n, operand, U_DEREF, c"dereference of a raw pointer is unsafe", &pcx);
        }
        return pcx.types[ty].a;
    }
    // Tok::Amp: taking an address reads nothing (a union's field too).
    mark_no_read(operand, &pcx);
    let mutable = (pcx.nodes[n].p & NODE_REF_MUT) != 0;
    let outer_place = pcx.mut_place;
    if mutable {
        pcx.mut_place = operand;
    }
    let star = pcx.nodes[operand].kind == Unary && pcx.nodes[operand].op == Tok::Star;
    let ty = synth_expr(operand, &pcx);
    pcx.mut_place = outer_place;
    // RULE: Z9.3 (0.27.2: `&*p`, `&mut *p` of a fat raw pointer: the view,
    // its two words; the deref was made the pointer's value)
    if star && pcx.nodes[operand].kind != Unary && crate::front::check::rust::rust_node(n, &pcx)
        && (pcx.types[ty].kind == TyKind::Slice && pcx.types[ty].b == 0
            || is_view_distinct(ty, pcx)) {
        pcx.nodes[n] = pcx.nodes[operand];
        // (`&mut *p` of a `*mut str`: `&mut str`, RULE: F0.1)
        return if mutable { crate::front::types::mut_view_of(ty, &pcx) } else { ty };
    }
    // (0.25) an inout access needs the place mutable
    if mutable && (pcx.nodes[operand].p & NODE_TEMP) == 0 && is_place(operand, pcx) {
        crate::front::check::assign::defer_inout_place(operand, n, &pcx);
    } else if mutable && (pcx.nodes[operand].p & NODE_TEMP) != 0
        && pcx.types[ty].kind != TyKind::Slice && pcx.types[ty].kind != TyKind::Fn
        && crate::front::conv::strict_at(pcx.nodes[n].start, &pcx) {
        // (0.25) `&make()` given an inout parameter: conv.place, when
        // the function ends and the `&` is known to be inout
        crate::front::check::assign::defer_conv_place(n, &pcx);
    }
    // (0.18.1) a temporary's local (check/temps.vl) is the value as
    // `&` of it was before: a slice is its own view, a function's
    // name its pointer
    let temp = (pcx.nodes[operand].p & NODE_TEMP) != 0
        && (pcx.types[ty].kind == TyKind::Slice || pcx.types[ty].kind == TyKind::Fn);
    if !is_place(operand, pcx) || temp {
        if pcx.types[ty].kind == TyKind::Slice {
            // (0.17) `&s[a..b]`, `&mut a[..]`: a slice value is its own
            // view; `&mut` makes it the exclusive `&mut [T]`
            let flags = pcx.nodes[n].p;
            // (0.25) `&a[..]` of an array: an inout access of a
            let sb = if pcx.nodes[operand].kind == Index { pcx.nodes[pcx.nodes[operand].a].ty }
                else { 0 };
            if mutable && sb > 0 && pcx.types[sb].kind == TyKind::Array && !temp {
                crate::front::check::assign::defer_inout_place(pcx.nodes[operand].a, n, &pcx);
            }
            // (0.20: the `&`, for `fix --only conventions`)
            pcx.slice_amps.push(pcx.nodes[n].start);
            pcx.slice_amps.push(pcx.nodes[operand].start);
            pcx.nodes[n] = pcx.nodes[operand];
            pcx.nodes[n].p |= flags & NODE_REF_MUT;
            return if mutable { mut_slice_of(pcx.types[ty].a, &pcx) } else { ty };
        }
        // RULE: Z9.1 (0.27.2: on std2, `&s[a..]` of a str is the str, its
        // own view, as a slice's is, until the unsized representation)
        if crate::front::known::on_std2(pcx) && is_view_distinct(ty, pcx)
            && crate::front::check::rust::rust_node(n, &pcx) {
            let flags = pcx.nodes[n].p;
            pcx.nodes[n] = pcx.nodes[operand];
            pcx.nodes[n].p |= flags & NODE_REF_MUT;
            return ty;
        }
        // (0.17, issue #1: `&factorial`: a function's name is its
        // pointer already)
        if pcx.types[ty].kind == TyKind::Fn {
            fn_value_error(n, operand, c"address", &pcx);
            return ty;
        }
        // (0.27.0) in the rust edition, as Rust's, `&f(x)` of a value is a
        // temporary of the statement where it stands (its drop at the
        // statement's end, front/own/drops.vl), the order kept:
        // `len(&mk()) + len(&mk())`
        if !(pcx.edition != 0 && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx)) {
            non_lvalue_error(n, operand, &pcx);
        }
    }
    // (0.17) `&place` is a reference, `&mut place` an exclusive one
    // (docs/design/value-semantics.md §2.3); a place reached through a
    // raw pointer gives a raw pointer, as before; `&*p` (unsafe) makes
    // one a reference.
    if reached_through_raw(operand, pcx)
        && !(pcx.nodes[operand].kind == Unary && pcx.nodes[operand].op == Tok::Star) {
        return ptr_to(ty, &pcx);
    }
    ref_to(ty, if mutable { REF_MUT } else { REF_SHARED }, &pcx)
}

// (0.25.2.2) Whether the name `t`, used at the end of `text` (its file's
// text up to the use), is by that text a `for` loop's variable: `for t
// in`, or t in its pattern (`for (i, t) in`), after the start of the
// function it is in.
fn bound_by_for(text: [u8], t: [u8]) -> bool {
    let pos = text.len as i64;
    var i = pos;
    while i > 1 {
        i -= 1;
        let edge = text[i - 1] == ' ' || text[i - 1] == '\n' || text[i - 1] == '\t';
        if !edge || i + 4 >= pos {
            continue;
        }
        if text[i] == 'f' && text[i + 1] == 'n' && text[i + 2] == ' ' {
            return false;
        }
        if text[i] == 'f' && text[i + 1] == 'o' && text[i + 2] == 'r' && text[i + 3] == ' ' {
            var j = i + 4;
            while j + 3 < pos && text[j] != '\n'
                && !(text[j] == ' ' && text[j + 1] == 'i' && text[j + 2] == 'n'
                    && text[j + 3] == ' ') {
                if word_at(text, j, t) {
                    return true;
                }
                j += 1;
            }
        }
    }
    false
}

// Whether text[j..] starts with the whole word t.
fn word_at(text: [u8], j: i64, t: [u8]) -> bool {
    if j < 1 || j + t.len as i64 >= text.len as i64 {
        return false;
    }
    if is_word_char(text[j - 1]) || is_word_char(text[j + t.len as i64]) {
        return false;
    }
    text[j..j + t.len as i64] == t
}

fn is_word_char(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// (0.20) `*x` where x is an access (a let or inout parameter, an `inout`
// local): conv.rust, `*` is for raw pointers; n becomes x, the value.
fn star_on_access(n: i64, operand: i64, pcx: inout Ctx<Comp>) -> bool {
    // (only a `*` written in the source: the checker's own desugarings,
    // an owned assignment's `*x`, make one of a use too)
    if pcx.nodes[operand].kind != NodeKind::Ident || (pcx.nodes[operand].p & CONV_NEW) != 0
        || pcx.nodes[n].start >= pcx.nodes[operand].start || SRC[pcx.nodes[n].start] != '*' {
        return false;
    }
    let l = lookup_local(pcx.nodes[operand].a, pcx);
    if l.is_none() || !pcx.locals[l.unwrap()].access {
        return false;
    }
    let text = SRC[pcx.nodes[operand].start..pcx.nodes[operand].end];
    let b = buf_new();
    buf_bytes(b, "'");
    buf_bytes(b, text);
    buf_bytes(b, "' is an access, used as its value: '");
    buf_bytes(b, text);
    buf_bytes(b, "' (`*` is for raw pointers)");
    crate::front::conv::rust_spelling(pcx.nodes[n].start, pcx.nodes[operand].end, buf_slice(b),
        text, &pcx);
    pcx.nodes[n] = pcx.nodes[operand];
    true
}

// (0.18.1) `&e` of a value where no temporary is made for it
// (check/temps.vl: something evaluated before it in its statement):
// bind it first, `let t = e;`, then `&t`; the try: is the statement so,
// when it is on one line, with a name the statement does not use (`t`
// may be the receiver).
fn non_lvalue_error(n: i64, operand: i64, pcx: inout Ctx<Comp>) {
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"cannot take address of non-lvalue expression", pcx);
    err_help(c"'&' takes a place; a value made here needs a name first: 'let t = VALUE;' before the statement, then '&t'", pcx);
    let s = pcx.wrap_node;
    let a = pcx.nodes[n].start;
    let b = pcx.nodes[n].end;
    if s > 0 && pcx.nodes[s].start <= a && b <= pcx.nodes[s].end {
        let text = SRC[pcx.nodes[s].start..pcx.nodes[s].end];
        var one_line = true;
        for i in 0..text.len() {
            if text[i] == '\n' {
                one_line = false;
            }
        }
        if one_line {
            var name: [u8] = "t";
            if uses_word(text, "t") {
                name = "tmp";
                if uses_word(text, "tmp") {
                    name = "tmp_ref";
                }
            }
            let t = buf_new();
            buf_bytes(t, "let ");
            buf_bytes(t, name);
            buf_bytes(t, " = ");
            buf_bytes(t, SRC[pcx.nodes[operand].start..pcx.nodes[operand].end]);
            buf_bytes(t, "; ");
            buf_bytes(t, SRC[pcx.nodes[s].start..a]);
            buf_bytes(t, "&");
            buf_bytes(t, name);
            buf_bytes(t, SRC[b..pcx.nodes[s].end]);
            err_try_fmt(buf_slice(t), pcx);
        }
    }
    err_end(&pcx);
}

// Whether text has the identifier w (not inside a longer name).
fn uses_word(text: [u8], w: [u8]) -> bool {
    var i = 0;
    while i + w.len() as i64 <= text.len() as i64 {
        if text[i..i + w.len() as i64] == w && (i == 0 || !is_word_byte(text[i - 1]))
            && (i + w.len() as i64 == text.len() as i64 || !is_word_byte(text[i + w.len() as i64])) {
            return true;
        }
        i += 1;
    }
    false
}

fn is_word_byte(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

// `&f` or `*f` (node n) of a function value f (operand): a function's name
// is a `fn(..) -> ..` value, a pointer to its code already; it is called
// as it is (`f(10)`). The fix (fix --suggested) writes f alone.
fn fn_value_error(n: i64, operand: i64, what: *u8, pcx: inout Ctx<Comp>) {
    unsafe {
        let ty = pcx.nodes[operand].ty;
        let f = SRC[pcx.nodes[operand].start..pcx.nodes[operand].end];
        let address = what[0] == 'a';
        err_begin(pcx.nodes[n].start, &pcx);
        if address {
            err_fmt(
                format_args(
                    "cannot take the address of '{f}': a function's name is already a pointer to it"), pcx);
        } else {
            err_fmt(format_args("cannot dereference '{f}': a function value is called as it is"),
                pcx);
        }
        let t = buf_new();
        buf_type(t, ty, pcx);
        let tt = buf_slice(t);
        if address {
            err_help_fmt(
                format_args("'{f}' is a value of type `{tt}`: `let g = {f};` keeps it, `g(x)` calls it, with no `&`"), pcx);
        } else {
            err_help_fmt(format_args("'{f}' is a `{tt}`: call it as `{f}(...)`, without `*`"), pcx);
        }
        err_try_fmt(format_args("{f}"), pcx);
        err_fix(pcx.nodes[n].start, pcx.nodes[n].end, f, &pcx);
        err_end_soft(&pcx);
    }
}

// (0.17) Whether place expression e (checked) is reached through a raw
// pointer: a dereference, a field or an index of one.
fn reached_through_raw(e: i64, pcx: Ctx<Comp>) -> bool {
    if (pcx.nodes[e].p & NODE_RAW) != 0 {
        return true;
    }
    let k = pcx.nodes[e].kind;
    if k == FieldAccess || k == TupleField || k == Index {
        return reached_through_raw(pcx.nodes[e].a, pcx);
    }
    if k == Unary && pcx.nodes[e].op == Tok::Star {
        return reached_through_raw(pcx.nodes[e].b, pcx);
    }
    false
}

// `size_of(T)` and `align_of(T)` (0.4): integer constants, typed like an
// integer literal. The argument, parsed as an expression, is read as a type
// (`*T`, `[T; n]`, `[T]`, `(A, B)` and names are also expressions); the
// call becomes the literal. They are builtins: no function, constant or
// static may have their names (0.5; in 0.4 a function of the same name
// replaced them).
pub fn fold_layout_query(n: i64, pcx: inout Ctx<Comp>) {
    // RULE: F19.4 (the rust edition: `size_of::<T>()`, `align_of::<T>()`,
    // also `mem::size_of::<T>()`: the constant, per instance)
    if pcx.nodes[n].kind == Call && pcx.nodes[n].count == 0 && pcx.edition != 0 {
        rust_layout_query(n, &pcx);
        return;
    }
    if pcx.nodes[n].kind != Call || pcx.nodes[n].count != 1 {
        return;
    }
    let callee = pcx.nodes[n].a;
    if pcx.nodes[callee].kind != Ident || (pcx.nodes[callee].p & NODE_RESOLVED) != 0 {
        return;
    }
    let name = pcx.nodes[callee].a;
    let is_size = name == intern_c(c"size_of", &pcx);
    if !is_size && name != intern_c(c"align_of", &pcx) {
        return;
    }
    if lookup_local(name, pcx).is_some() {
        return;
    }
    let t = resolve_type(expr_as_type(child(n, 0, pcx), &pcx), &pcx);
    let value = if is_size { type_size(t, pcx) } else { type_align(t, pcx) };
    pcx.nodes[n].kind = Int;
    pcx.nodes[n].a = value;
    pcx.nodes[n].b = SUF_NONE;
    pcx.nodes[n].count = 0;
}

// (0.27.2) `size_of::<T>()` of the rust edition (call n, no arguments):
// the callee `size_of` or `align_of`, or a path ending in one, with one
// type argument; n becomes the constant, a `usize` (`1usize`), as std2's
// signature says.
// RULE: F19.4
fn rust_layout_query(n: i64, pcx: inout Ctx<Comp>) {
    let callee = pcx.nodes[n].a;
    let kind = pcx.nodes[callee].kind;
    var name = 0;
    var targs = 0;
    if kind == Ident && (pcx.nodes[callee].p & NODE_RESOLVED) == 0 {
        name = pcx.nodes[callee].a;
        targs = pcx.nodes[callee].g;
    } else if kind == Path {
        name = pcx.nodes[callee].b;
        targs = pcx.nodes[callee].h;
    }
    let is_size = name == intern_c(c"size_of", &pcx);
    if !is_size && name != intern_c(c"align_of", &pcx) || targs == 0
        || pcx.nodes[targs].count != 1 || !crate::front::check::rust::rust_node(n, &pcx) {
        return;
    }
    if kind == Ident && lookup_local(name, pcx).is_some() {
        return;
    }
    let t = resolve_type(child(targs, 0, pcx), &pcx);
    let value = if is_size { type_size(t, pcx) } else { type_align(t, pcx) };
    pcx.nodes[n].kind = Int;
    pcx.nodes[n].a = value;
    pcx.nodes[n].b = SUF_USIZE;
    pcx.nodes[n].count = 0;
}

// The expression `e` turned into the type node it spells.
fn expr_as_type(e: i64, pcx: inout Ctx<Comp>) -> i64 {
    let kind = pcx.nodes[e].kind;
    if kind == TyName || kind == TyPtr || kind == TyUnit
        || kind == TyNever || kind == TyTuple || kind == TyArray
        || kind == TyFn || kind == TySlice {
        // Parsed as a type already (0.5).
        return e;
    }
    if kind == Ident {
        pcx.nodes[e].kind = TyName;
    } else if kind == Unary && pcx.nodes[e].op == Tok::Star {
        pcx.nodes[e].kind = TyPtr;
        pcx.nodes[e].a = expr_as_type(pcx.nodes[e].b, &pcx);
    } else if kind == Repeat {
        pcx.nodes[e].kind = TyArray;
        pcx.nodes[e].a = expr_as_type(pcx.nodes[e].a, &pcx);
    } else if kind == Array && pcx.nodes[e].count == 1 {
        pcx.nodes[e].kind = TySlice;
        pcx.nodes[e].a = expr_as_type(child(e, 0, pcx), &pcx);
    } else if kind == Tuple {
        pcx.nodes[e].kind = TyTuple;
        for i in 0..pcx.nodes[e].count {
            expr_as_type(child(e, i, pcx), &pcx);
        }
    } else if kind == Unit {
        pcx.nodes[e].kind = TyUnit;
    } else {
        type_error(e, c"size_of and align_of take a type", &pcx);
    }
    e
}
