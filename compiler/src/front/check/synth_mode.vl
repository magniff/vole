    ENUMS, REF_MUT, REF_SHARED, TY_BOOL, TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE,
    TY_NEVER, TY_U16, TY_U32, TY_U64, TY_U8, TY_UNIT, TY_USIZE, TyKind, array_of, buf_type,
    enum_variant, err_type, find_field, find_method, int_bits, int_max, is_compound,
    is_fieldless_enum, is_integer, is_numeric, is_opaque_vector, is_pointer, is_ref, is_signed,
    is_vector, make_type, mut_slice_of, primitive_name, ptr_to, ref_to, slice_of, struct_field,
    type_align, type_elem, type_size,
