// Integer widening (0.15; docs/design/errors-formatting.md): a value of a
// narrower integer type where a wider one of the same signedness (or,
// from unsigned, a strictly wider signed one) is expected is converted,
// losslessly; where two integer types meet without an expected type
// (operands, branches, two arguments for one type parameter) the result
// is the wider one. Never between integers and floats, from bool, signed
// to unsigned, or narrowing; never inside other types (`*i32`, `[i32]`).

use crate::base::{buf_bytes, buf_copy, buf_fmt, buf_new, get_src, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_fix, err_fmt, err_help, err_help_fmt, err_str, err_try_fmt,
};
use crate::front::ast::{NODE_IMPLICIT, NodeKind, child, new_node};
use crate::front::check::{Res, mismatch_error};
use crate::front::check::body::names_context_variant;
use crate::front::check::synth_mode::{fold_layout_query, is_context_value, synth_expr};
use crate::front::check::unsafety::check_wrapped;
use crate::front::check::vectors::sym_is_c;
use crate::front::lexer::{
    SUF_F32, SUF_F64, SUF_I16, SUF_I32, SUF_I64, SUF_I8, SUF_ISIZE, SUF_NONE, SUF_U16, SUF_U32,
    SUF_U64, SUF_U8, SUF_USIZE, Tok,
};
use crate::front::types::{
    TY_F32, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE, TY_NEVER, TY_U16, TY_U32, TY_U64, TY_U8,
    TY_USIZE, buf_type, err_type, int_bits, int_max, is_integer, is_signed, primitive_name,
};

// Whether integer type a widens to integer type b (a != b): from i8 to
// i16, i32, i64; from u8 to u16, u32, u64 and to i16, i32, i64; ...
// (0.26.2: usize and isize are types of their own, of 64 bits: u8 to u32
// widen to usize, i8 to i32 and u8 to u32 to isize; u64 and usize, i64 and
// isize, take `as`.)
pub fn widens(a: i64, b: i64) -> bool {
    if a == b || !is_integer(a) || !is_integer(b) {
        return false;
    }
    if is_signed(a) == is_signed(b) {
        return int_bits(a) < int_bits(b);
    }
    !is_signed(a) && int_bits(a) < int_bits(b)
}

// Checked node n (of an integer type) becomes `n as to`, in place: a Cast
// (flagged NODE_IMPLICIT) of a copy of n, so that the nodes that refer to
// n refer to the widened value.
pub fn widen_node(n: i64, to: i64, pcx: &mut Ctx<Comp>) {
    let copy = new_node(pcx.nodes[n as usize].kind, pcx.nodes[n as usize].start,
        pcx.nodes[n as usize].end, pcx);
    pcx.nodes[copy as usize] = pcx.nodes[n as usize];
    let ty = new_node(NodeKind::TyName, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    pcx.nodes[ty as usize].a = intern_c(primitive_name(to), pcx);
    pcx.nodes[ty as usize].ty = to;
    let (start, end) = (pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
    pcx.nodes[n as usize] = pcx.nodes[0];
    pcx.nodes[n as usize].kind = NodeKind::Cast;
    pcx.nodes[n as usize].start = start;
    pcx.nodes[n as usize].end = end;
    pcx.nodes[n as usize].op = Tok::Eof;
    pcx.nodes[n as usize].res = Res::None;
    pcx.nodes[n as usize].a = copy;
    pcx.nodes[n as usize].b = ty;
    pcx.nodes[n as usize].ty = to;
    pcx.nodes[n as usize].p = NODE_IMPLICIT;
}

// Value n of type `actual` where `expected` is expected (they differ):
// widened (widen_value) when actual widens to expected, and true; false
// otherwise (the caller reports the mismatch).
pub fn try_widen(n: i64, actual: i64, expected: i64, pcx: &mut Ctx<Comp>) -> bool {
    if !widens(actual, expected) {
        // (0.26.2) a contract message's hole of a 64-bit unsigned type (a
        // usize length or index) is passed as the i64 it holds
        if expected == TY_I64 && (actual == TY_USIZE || actual == TY_U64)
            && crate::front::contracts::expand::is_message_hole(n, pcx) {
            widen_node(n, expected, pcx);
            return true;
        }
        return false;
    }
    widen_value(n, expected, pcx);
    true
}

// The join of integer types a and b: the wider when one widens to the
// other (a when they are the same), 0 otherwise.
pub fn join_int(a: i64, b: i64) -> i64 {
    if a == b {
        return if is_integer(a) { a } else { 0 };
    }
    if widens(a, b) {
        return b;
    }
    if widens(b, a) {
        return a;
    }
    0
}

// (0.15) `i64::MAX`, `u8::MIN`: the limits of a primitive integer type
// `t`, path n made the literal that has the value (`9223372036854775807i64`,
// a signed MIN `-9223372036854775808i64`), then synthesized: constant, as
// a written literal is. std's `I64_MAX` ... are the same values.
pub fn int_limit(n: i64, t: i64, max: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let suffix = if t == TY_I8 { SUF_I8 } else if t == TY_I16 { SUF_I16 }
        else if t == TY_I32 { SUF_I32 } else if t == TY_I64 { SUF_I64 }
        else if t == TY_U8 { SUF_U8 } else if t == TY_U16 { SUF_U16 }
        else if t == TY_U32 { SUF_U32 } else if t == TY_USIZE { SUF_USIZE }
        else if t == TY_ISIZE { SUF_ISIZE } else { SUF_U64 };
    let lit = if max || !is_signed(t) { n }
        else { new_node(NodeKind::Int, pcx.nodes[n as usize].start,
            pcx.nodes[n as usize].end, pcx) };
    pcx.nodes[lit as usize].kind = NodeKind::Int;
    pcx.nodes[lit as usize].a = if max { int_max(t) as i64 }
        else if is_signed(t) { (int_max(t) + 1) as i64 } else { 0 };
    pcx.nodes[lit as usize].b = suffix;
    pcx.nodes[lit as usize].c = 0;
    pcx.nodes[lit as usize].h = 0;
    pcx.nodes[lit as usize].y = 0;
    pcx.nodes[lit as usize].count = 0;
    if lit != n {
        pcx.nodes[n as usize].kind = NodeKind::Unary;
        pcx.nodes[n as usize].op = Tok::Minus;
        pcx.nodes[n as usize].a = 0;
        pcx.nodes[n as usize].b = lit;
        pcx.nodes[n as usize].c = 0;
        pcx.nodes[n as usize].h = 0;
        pcx.nodes[n as usize].y = 0;
        pcx.nodes[n as usize].count = 0;
    }
    synth_expr(n, pcx)
}

// (0.25.2.1) The float types' constants: (name, f64's bits, f32's value as
// f64 bits). (0.25.3: tables of their own, for `query items --find` too.)
// `f64::EPSILON`, `f32::MAX`:
pub const FLOAT_LIMITS: [(&[u8], u64, u64); 7] = [
    (b"EPSILON", 0x3cb0000000000000, 0x3e80000000000000),
    (b"MAX", 0x7fefffffffffffff, 0x47efffffe0000000),
    (b"MIN", 0xffefffffffffffff, 0xc7efffffe0000000),
    (b"MIN_POSITIVE", 0x0010000000000000, 0x3810000000000000),
    (b"INFINITY", 0x7ff0000000000000, 0x7ff0000000000000),
    (b"NEG_INFINITY", 0xfff0000000000000, 0xfff0000000000000),
    (b"NAN", 0x7ff8000000000000, 0x7ff8000000000000),
];

// `f64::consts::PI`, `f32::consts::TAU` (each correctly rounded from 80
// digits, f32's too):
pub const FLOAT_CONSTS: [(&[u8], u64, u64); 19] = [
    (b"PI", 0x400921fb54442d18, 0x400921fb60000000),
    (b"TAU", 0x401921fb54442d18, 0x401921fb60000000),
    (b"E", 0x4005bf0a8b145769, 0x4005bf0a80000000),
    (b"SQRT_2", 0x3ff6a09e667f3bcd, 0x3ff6a09e60000000),
    (b"LN_2", 0x3fe62e42fefa39ef, 0x3fe62e4300000000),
    (b"LN_10", 0x40026bb1bbb55516, 0x40026bb1c0000000),
    (b"LOG2_E", 0x3ff71547652b82fe, 0x3ff7154760000000),
    (b"LOG10_E", 0x3fdbcb7b1526e50e, 0x3fdbcb7b20000000),
    (b"LOG2_10", 0x400a934f0979a371, 0x400a934f00000000),
    (b"LOG10_2", 0x3fd34413509f79ff, 0x3fd3441360000000),
    (b"FRAC_PI_2", 0x3ff921fb54442d18, 0x3ff921fb60000000),
    (b"FRAC_PI_3", 0x3ff0c152382d7366, 0x3ff0c15240000000),
    (b"FRAC_PI_4", 0x3fe921fb54442d18, 0x3fe921fb60000000),
    (b"FRAC_PI_6", 0x3fe0c152382d7366, 0x3fe0c15240000000),
    (b"FRAC_PI_8", 0x3fd921fb54442d18, 0x3fd921fb60000000),
    (b"FRAC_1_PI", 0x3fd45f306dc9c883, 0x3fd45f3060000000),
    (b"FRAC_2_PI", 0x3fe45f306dc9c883, 0x3fe45f3060000000),
    (b"FRAC_2_SQRT_PI", 0x3ff20dd750429b6d, 0x3ff20dd760000000),
    (b"FRAC_1_SQRT_2", 0x3fe6a09e667f3bcd, 0x3fe6a09e60000000),
];

// (0.25.2.1) The bits of a float constant as an f64 (an f32's value
// exactly, so that the f32 suffix rounds nothing), or 0 when `member` is
// none: Rust's associated constants of f32 and f64 (`f64::EPSILON`,
// `f32::MAX`) or, `consts`, of `f64::consts` (`PI`, `TAU`, ...).
pub fn float_const_bits(f32: bool, member: i64, consts: bool, pcx: &Ctx<Comp>) -> u64 {
    let name = sym_text(member, pcx);
    if consts {
        for (k, b64, b32) in FLOAT_CONSTS {
            if k == name {
                return if f32 { b32 } else { b64 };
            }
        }
    } else {
        for (k, b64, b32) in FLOAT_LIMITS {
            if k == name {
                return if f32 { b32 } else { b64 };
            }
        }
    }
    0
}

// (0.25.2.1) `f64::EPSILON`, `f32::MAX`, `f64::consts::PI` (Rust's
// constants of f32 and f64): path n made the float literal that has the
// value (its type's suffix), then synthesized, constant as a written
// literal is; -1 when `member` names none.
pub fn float_const(n: i64, t: i64, member: i64, consts: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let bits = float_const_bits(t == TY_F32, member, consts, pcx);
    if bits == 0 {
        return -1;
    }
    pcx.nodes[n as usize].kind = NodeKind::Float;
    pcx.nodes[n as usize].a = bits as i64;
    pcx.nodes[n as usize].b = if t == TY_F32 { SUF_F32 } else { SUF_F64 };
    pcx.nodes[n as usize].c = 0;
    pcx.nodes[n as usize].h = 0;
    pcx.nodes[n as usize].y = 0;
    pcx.nodes[n as usize].count = 0;
    synth_expr(n, pcx)
}

// (0.25.2.1) At pos, `f64::consts::PIE`: a name that is none of
// f64::consts'; `f64::PI` (consts false): one of them without `consts::`.
pub fn float_const_error(pos: i64, t: i64, member: i64, consts: bool, pcx: &mut Ctx<Comp>) -> ! {
    let ty = if t == TY_F32 { "f32" } else { "f64" };
    let name = sym_text(member, pcx);
    err_begin(pos, pcx);
    if consts {
        err_fmt({
            let name = str::from_utf8(name).unwrap();
            format_args("no constant '{name}' in '{ty}::consts'")
        }, pcx);
        err_help(c"its constants: PI, TAU, E, SQRT_2, LN_2, LN_10, LOG2_E, LOG10_E, LOG2_10, ",
            pcx);
        err_help(c"LOG10_2, FRAC_PI_2, FRAC_PI_3, FRAC_PI_4, FRAC_PI_6, FRAC_PI_8, FRAC_1_PI, ",
            pcx);
        err_help(c"FRAC_2_PI, FRAC_2_SQRT_PI, FRAC_1_SQRT_2; ", pcx);
        err_help_fmt(
            format_args(
                "{ty}'s own: EPSILON, MAX, MIN, MIN_POSITIVE, INFINITY, NEG_INFINITY, NAN"), pcx);
    } else {
        err_fmt({
            let name = str::from_utf8(name).unwrap();
            format_args("no associated constant '{name}' in '{ty}'")
        }, pcx);
        err_help_fmt(
            { let name = str::from_utf8(name).unwrap();
                format_args("the math constants are in '{ty}::consts': '{ty}::consts::{name}'") },
            pcx);
    }
    err_end(pcx)
}

// Checked value n (of an integer type that widens to `to`, or `!`) as a
// value of type `to`: a block, `if` or `match` where its values are (the
// tail, each branch, each arm), so that they keep their shape; any other
// expression becomes a Cast (widen_node).
pub fn widen_value(n: i64, to: i64, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].ty;
    if t == to || t == TY_NEVER || t == pcx.ty_error {
        return;
    }
    match { pcx.nodes[n as usize].kind } {
        NodeKind::Block if pcx.nodes[n as usize].a
            != 0 => widen_value(pcx.nodes[n as usize].a, to, pcx),
        NodeKind::If if pcx.nodes[n as usize].c != 0 => {
            widen_value(pcx.nodes[n as usize].b, to, pcx);
            widen_value(pcx.nodes[n as usize].c, to, pcx);
        }
        NodeKind::Match => {
            for i in 0..pcx.nodes[n as usize].count {
                widen_value(pcx.nodes[child(n, i, pcx) as usize].c, to, pcx);
            }
        }
        _ => {
            widen_node(n, to, pcx);
            return;
        }
    }
    pcx.nodes[n as usize].ty = to;
}

// Two values that meet without an expected type (the branches of an `if`,
// the arms of a `match`, an operator's operands), a of type at and b of
// type bt: when one type widens to the other, the narrower value is
// widened and the join is returned; 0 otherwise (nothing changed).
pub fn join_values(a: i64, at: i64, b: i64, bt: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let j = join_int(at, bt);
    if j != 0 {
        widen_value(a, j, pcx);
        widen_value(b, j, pcx);
    }
    j
}

// Arm i of match n, whose body is of a definite type (!takes_context),
// when the arms before it have integer type `result` and no type is
// expected: synthesized, then joined with them (the narrower widened;
// earlier arms left for later, the context literals, are not checked
// yet). The arm's type: `!`, or the join.
pub fn join_arm(n: i64, i: i64, body: i64, result: i64, later: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let t = check_wrapped(body, 0, pcx);
    if t == result || t == TY_NEVER {
        return t;
    }
    if t == pcx.ty_error {
        return result;
    }
    // RULE: F18.6 (a) (an arm against the type of those before it)
    if pcx.infer_live && crate::front::check::infer::unify(t, result, pcx) {
        return crate::front::check::infer::resolve(result, pcx);
    }
    let j = join_int(result, t);
    if j == 0 {
        mismatch_error(body, result, t, pcx);
    }
    if j == result {
        widen_value(body, j, pcx);
        return j;
    }
    for k in 0..i {
        let b = pcx.nodes[child(n, k, pcx) as usize].c;
        if !(later && is_context_value(b, pcx)) {
            widen_value(b, j, pcx);
        }
    }
    j
}

// Whether expression e takes its type from the code around it, before it
// is checked: an unsuffixed literal (also negated, or in arithmetic of
// such), a variant of a generic enum without its type arguments (`None`),
// `x.into()`, a block or `if` whose values are such, and (conservatively)
// the compound expressions whose type their parts decide (`match`, loops,
// closures, literals of tuples, arrays and structs). An operand or a
// match arm of a definite type (a local, a field, a call, a cast, ...) can
// be synthesized first, and joined.
pub fn takes_context(e: i64, pcx: &mut Ctx<Comp>) -> bool {
    fold_layout_query(e, pcx);
    match { pcx.nodes[e as usize].kind } {
        NodeKind::Int | NodeKind::Float => pcx.nodes[e as usize].b == SUF_NONE,
        NodeKind::Char => true,
        // (0.28.0: the rust edition's `!` of an integer, as `~`: `x & !(1 <<
        // 40)` typed its literals i32 by themselves)
        NodeKind::Unary if pcx.nodes[e as usize].op == Tok::Minus
            || pcx.nodes[e as usize].op == Tok::Tilde
            || pcx.nodes[e as usize].op == Tok::Bang => {
            takes_context(pcx.nodes[e as usize].b, pcx)
        }
        NodeKind::Binary => {
            let op = pcx.nodes[e as usize].op;
            if op == Tok::Shl || op == Tok::Shr {
                return takes_context(pcx.nodes[e as usize].b, pcx);
            }
            if is_arith_op(op) {
                return takes_context(pcx.nodes[e as usize].b, pcx)
                    && takes_context(pcx.nodes[e as usize].c, pcx);
            }
            false
        }
        // RULE: F18.5 (b) (an open local, as a literal)
        NodeKind::Ident if pcx.open_lets.len() as i64 > 0
            && crate::front::check::literals::open_local(e, pcx) >= 0 => true,
        NodeKind::Ident | NodeKind::Path => names_context_variant(e, pcx),
        NodeKind::MethodCall => pcx.nodes[e as usize].count == 0
            && sym_is_c(pcx.nodes[e as usize].b, c"into", pcx),
        // (a block by its tail, an `if` by its branches)
        NodeKind::Block => pcx.nodes[e as usize].a != 0
            && takes_context(pcx.nodes[e as usize].a, pcx),
        NodeKind::If => pcx.nodes[e as usize].c != 0 && takes_context(pcx.nodes[e as usize].b, pcx)
            && takes_context(pcx.nodes[e as usize].c, pcx),
        NodeKind::Match | NodeKind::Loop
            | NodeKind::Closure | NodeKind::Tuple | NodeKind::Array | NodeKind::Repeat
            | NodeKind::StructLit | NodeKind::Range | NodeKind::Try | NodeKind::Interp => true,
        _ => false,
    }
}

// The arithmetic and bitwise operators, whose operands and result have one
// type.
fn is_arith_op(op: Tok) -> bool {
    op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
        || op == Tok::Percent || op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret
}

// The operands of a non-shift operator (synth_operands), lhs already
// synthesized, of integer type lhs_ty, and rhs of a definite type
// (!takes_context): rhs is synthesized (with lhs_ty as its hint, as
// check_expr would give it), then the two join: the narrower is widened.
// Their common type.
pub fn join_operands(lhs: i64, lhs_ty: i64, rhs: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.hint_node = rhs;
    pcx.hint_ty = lhs_ty;
    let rhs_ty = crate::front::check::synth_mode::read_through(rhs, synth_expr(rhs, pcx), pcx);
    if rhs_ty == lhs_ty || rhs_ty == pcx.ty_error || lhs_ty == pcx.ty_error {
        return lhs_ty;
    }
    if rhs_ty == TY_NEVER {
        pcx.nodes[rhs as usize].ty = lhs_ty;
        return lhs_ty;
    }
    let j = join_values(lhs, lhs_ty, rhs, rhs_ty, pcx);
    if j != 0 {
        return j;
    }
    if !is_integer(rhs_ty) {
        mismatch_error(rhs, lhs_ty, rhs_ty, pcx);
    }
    int_mismatch_error(lhs, lhs_ty, rhs, rhs_ty, pcx)
}

// Two integer values of types that do not widen one to the other (`i32`
// and `u32`, `i64` and `u64`): the mismatch, with the conversion to write
// (both to i64 when both widen to it, else the right one to the left's
// type; 0.26.2: of a usize and an i64, the usize, a length, to i64, as
// `fix --only usize` writes it).
fn int_mismatch_error(lhs: i64, lhs_ty: i64, rhs: i64, rhs_ty: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[rhs as usize].start, pcx);
    err_str(c"expected '", pcx);
    err_type(lhs_ty, pcx);
    err_str(c"', got '", pcx);
    err_type(rhs_ty, pcx);
    err_str(c"'", pcx);
    if lhs_ty == TY_USIZE && rhs_ty == TY_I64 || lhs_ty == TY_I64 && rhs_ty == TY_USIZE {
        let u = if lhs_ty == TY_USIZE { lhs } else { rhs };
        let text = &get_src()[
            pcx.nodes[u as usize].start as usize..pcx.nodes[u as usize].end as usize];
        let t = buf_new();
        if operand_is_simple(u, pcx) {
            buf_fmt(t, { let text = str::from_utf8(text).unwrap(); format_args("{text} as i64") });
        } else {
            buf_fmt(t,
                { let text = str::from_utf8(text).unwrap(); format_args("({text}) as i64") });
        }
        err_help(c"a length or an index is a usize: convert it to the i64's type", pcx);
        err_try_fmt(str::from_utf8(&buf_copy(t)).unwrap(), pcx);
        err_fix(pcx.nodes[u as usize].start, pcx.nodes[u as usize].end, &buf_copy(t), pcx);
        err_end(pcx);
    }
    let both = widens(lhs_ty, TY_I64) && widens(rhs_ty, TY_I64);
    err_help(c"convert explicitly: '", pcx);
    if both {
        err_help(c"(", pcx);
        buf_bytes(pcx.err_help,
            &get_src()[
                pcx.nodes[lhs as usize].start as usize..pcx.nodes[lhs as usize].end as usize]);
        err_help(c" as i64)", pcx);
        buf_bytes(pcx.err_help,
            &get_src()[
                pcx.nodes[lhs as usize].end as usize..pcx.nodes[rhs as usize].start as usize]);
    }
    // (`(x as T)`; 0.26.2: `(a - b) as T` of an operation)
    let simple = operand_is_simple(rhs, pcx);
    err_help(c"(", pcx);
    buf_bytes(pcx.err_help,
        &get_src()[pcx.nodes[rhs as usize].start as usize..pcx.nodes[rhs as usize].end as usize]);
    err_help(if simple { c" as " } else { c") as " }, pcx);
    if both {
        err_help(c"i64", pcx);
    } else {
        buf_type(pcx.err_help, lhs_ty, pcx);
    }
    err_help(if simple { c")'" } else { c"'" }, pcx);
    err_end(pcx)
}

// (0.26.2) Whether operand n is written `x as T` without parentheses: it
// binds tighter than `as` (not an operator's own expression).
pub fn operand_is_simple(n: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[n as usize].kind;
    !(k == NodeKind::Binary || k == NodeKind::Unary || k == NodeKind::Cast
        || k == NodeKind::Range || k == NodeKind::If || k == NodeKind::Match
        || k == NodeKind::Block || k == NodeKind::Closure)
}
