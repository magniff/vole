// Integer widening (0.15; docs/design/errors-formatting.md): a value of a
// narrower integer type where a wider one of the same signedness (or,
// from unsigned, a strictly wider signed one) is expected is converted,
// losslessly; where two integer types meet without an expected type
// (operands, branches, two arguments for one type parameter) the result
// is the wider one. Never between integers and floats, from bool, signed
// to unsigned, or narrowing; never inside other types (`*i32`, `[i32]`).

use crate::base::{SRC, buf_bytes, buf_fmt, buf_new, buf_slice, intern_c, sym_text};
use crate::base::diag::{
    ERR_HELP, err_begin, err_end, err_fix, err_fmt, err_help, err_help_fmt, err_str, err_try_fmt,
};
use crate::front::ast::{NODES, NODE_IMPLICIT, NodeKind, child, new_node};
use crate::front::check::{Res, mismatch_error};
use crate::front::check::body::names_context_variant;
use crate::front::check::synth_mode::{fold_layout_query, is_context_value, synth_expr};
use crate::front::check::unsafety::check_wrapped;
use crate::front::check::vectors::sym_is_c;
use crate::front::generics::{HINT_NODE, HINT_TY};
use crate::front::lexer::{
    SUF_F32, SUF_F64, SUF_I16, SUF_I32, SUF_I64, SUF_I8, SUF_ISIZE, SUF_NONE, SUF_U16, SUF_U32,
    SUF_U64, SUF_U8, SUF_USIZE, Tok,
};
use crate::front::types::{
    TY_ERROR, TY_F32, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE, TY_NEVER, TY_U16, TY_U32, TY_U8,
    TY_USIZE, buf_type, err_type, int_bits, int_max, is_integer, is_signed, primitive_name,
};

// Whether integer type a widens to integer type b (a != b): from i8 to
// i16, i32, i64; from u8 to u16, u32, u64 and to i16, i32, i64; ...
// (0.26.2: usize and isize are types of their own, of 64 bits: u8 to u32
// widen to usize, i8 to i32 and u8 to u32 to isize; u64 and usize, i64 and
// isize, take `as`.)
pub fn widens(a: i64, b: i64) -> bool {
    if a == b || !is_integer(a) || !is_integer(b) {
        return false;
    }
    if is_signed(a) == is_signed(b) {
        return int_bits(a) < int_bits(b);
    }
    !is_signed(a) && int_bits(a) < int_bits(b)
}

// Checked node n (of an integer type) becomes `n as to`, in place: a Cast
// (flagged NODE_IMPLICIT) of a copy of n, so that the nodes that refer to
// n refer to the widened value.
pub fn widen_node(n: i64, to: i64) {
    let copy = new_node(NODES[n].kind, NODES[n].start, NODES[n].end);
    NODES[copy] = NODES[n];
    let ty = new_node(NodeKind::TyName, NODES[n].start, NODES[n].end);
    NODES[ty].a = intern_c(primitive_name(to));
    NODES[ty].ty = to;
    let (start, end) = (NODES[n].start, NODES[n].end);
    NODES[n] = NODES[0];
    NODES[n].kind = NodeKind::Cast;
    NODES[n].start = start;
    NODES[n].end = end;
    NODES[n].op = Tok::Eof;
    NODES[n].res = Res::None;
    NODES[n].a = copy;
    NODES[n].b = ty;
    NODES[n].ty = to;
    NODES[n].p = NODE_IMPLICIT;
}

// Value n of type `actual` where `expected` is expected (they differ):
// widened (widen_value) when actual widens to expected, and true; false
// otherwise (the caller reports the mismatch).
pub fn try_widen(n: i64, actual: i64, expected: i64) -> bool {
    if !widens(actual, expected) {
        return false;
    }
    widen_value(n, expected);
    true
}

// The join of integer types a and b: the wider when one widens to the
// other (a when they are the same), 0 otherwise.
pub fn join_int(a: i64, b: i64) -> i64 {
    if a == b {
        return if is_integer(a) { a } else { 0 };
    }
    if widens(a, b) {
        return b;
    }
    if widens(b, a) {
        return a;
    }
    0
}

// (0.15) `i64::MAX`, `u8::MIN`: the limits of a primitive integer type
// `t`, path n made the literal that has the value (`9223372036854775807i64`,
// a signed MIN `-9223372036854775808i64`), then synthesized: constant, as
// a written literal is. std's `I64_MAX` ... are the same values.
pub fn int_limit(n: i64, t: i64, max: bool) -> i64 {
    let suffix = if t == TY_I8 { SUF_I8 } else if t == TY_I16 { SUF_I16 }
        else if t == TY_I32 { SUF_I32 } else if t == TY_I64 { SUF_I64 }
        else if t == TY_U8 { SUF_U8 } else if t == TY_U16 { SUF_U16 }
        else if t == TY_U32 { SUF_U32 } else if t == TY_USIZE { SUF_USIZE }
        else if t == TY_ISIZE { SUF_ISIZE } else { SUF_U64 };
    let lit = if max || !is_signed(t) { n } else { new_node(NodeKind::Int, NODES[n].start,
        NODES[n].end) };
    NODES[lit].kind = NodeKind::Int;
    NODES[lit].a = if max { int_max(t) as i64 } else if is_signed(t) { (int_max(t) + 1) as i64 }
        else { 0 };
    NODES[lit].b = suffix;
    NODES[lit].c = 0;
    NODES[lit].h = 0;
    NODES[lit].y = 0;
    NODES[lit].count = 0;
    if lit != n {
        NODES[n].kind = NodeKind::Unary;
        NODES[n].op = Tok::Minus;
        NODES[n].a = 0;
        NODES[n].b = lit;
        NODES[n].c = 0;
        NODES[n].h = 0;
        NODES[n].y = 0;
        NODES[n].count = 0;
    }
    synth_expr(n)
}

// (0.25.2.1) The float types' constants: (name, f64's bits, f32's value as
// f64 bits). (0.25.3: tables of their own, for `query items --find` too.)
// `f64::EPSILON`, `f32::MAX`:
pub const FLOAT_LIMITS: [([u8], u64, u64); 7] = [
    ("EPSILON", 0x3cb0000000000000, 0x3e80000000000000),
    ("MAX", 0x7fefffffffffffff, 0x47efffffe0000000),
    ("MIN", 0xffefffffffffffff, 0xc7efffffe0000000),
    ("MIN_POSITIVE", 0x0010000000000000, 0x3810000000000000),
    ("INFINITY", 0x7ff0000000000000, 0x7ff0000000000000),
    ("NEG_INFINITY", 0xfff0000000000000, 0xfff0000000000000),
    ("NAN", 0x7ff8000000000000, 0x7ff8000000000000),
];

// `f64::consts::PI`, `f32::consts::TAU` (each correctly rounded from 80
// digits, f32's too):
pub const FLOAT_CONSTS: [([u8], u64, u64); 19] = [
    ("PI", 0x400921fb54442d18, 0x400921fb60000000),
    ("TAU", 0x401921fb54442d18, 0x401921fb60000000),
    ("E", 0x4005bf0a8b145769, 0x4005bf0a80000000),
    ("SQRT_2", 0x3ff6a09e667f3bcd, 0x3ff6a09e60000000),
    ("LN_2", 0x3fe62e42fefa39ef, 0x3fe62e4300000000),
    ("LN_10", 0x40026bb1bbb55516, 0x40026bb1c0000000),
    ("LOG2_E", 0x3ff71547652b82fe, 0x3ff7154760000000),
    ("LOG10_E", 0x3fdbcb7b1526e50e, 0x3fdbcb7b20000000),
    ("LOG2_10", 0x400a934f0979a371, 0x400a934f00000000),
    ("LOG10_2", 0x3fd34413509f79ff, 0x3fd3441360000000),
    ("FRAC_PI_2", 0x3ff921fb54442d18, 0x3ff921fb60000000),
    ("FRAC_PI_3", 0x3ff0c152382d7366, 0x3ff0c15240000000),
    ("FRAC_PI_4", 0x3fe921fb54442d18, 0x3fe921fb60000000),
    ("FRAC_PI_6", 0x3fe0c152382d7366, 0x3fe0c15240000000),
    ("FRAC_PI_8", 0x3fd921fb54442d18, 0x3fd921fb60000000),
    ("FRAC_1_PI", 0x3fd45f306dc9c883, 0x3fd45f3060000000),
    ("FRAC_2_PI", 0x3fe45f306dc9c883, 0x3fe45f3060000000),
    ("FRAC_2_SQRT_PI", 0x3ff20dd750429b6d, 0x3ff20dd760000000),
    ("FRAC_1_SQRT_2", 0x3fe6a09e667f3bcd, 0x3fe6a09e60000000),
];

// (0.25.2.1) The bits of a float constant as an f64 (an f32's value
// exactly, so that the f32 suffix rounds nothing), or 0 when `member` is
// none: Rust's associated constants of f32 and f64 (`f64::EPSILON`,
// `f32::MAX`) or, `consts`, of `f64::consts` (`PI`, `TAU`, ...).
pub fn float_const_bits(f32: bool, member: i64, consts: bool) -> u64 {
    let name = sym_text(member);
    if consts {
        for (k, b64, b32) in FLOAT_CONSTS {
            if k == name {
                return if f32 { b32 } else { b64 };
            }
        }
    } else {
        for (k, b64, b32) in FLOAT_LIMITS {
            if k == name {
                return if f32 { b32 } else { b64 };
            }
        }
    }
    0
}

// (0.25.2.1) `f64::EPSILON`, `f32::MAX`, `f64::consts::PI` (Rust's
// constants of f32 and f64): path n made the float literal that has the
// value (its type's suffix), then synthesized, constant as a written
// literal is; -1 when `member` names none.
pub fn float_const(n: i64, t: i64, member: i64, consts: bool) -> i64 {
    let bits = float_const_bits(t == TY_F32, member, consts);
    if bits == 0 {
        return -1;
    }
    NODES[n].kind = NodeKind::Float;
    NODES[n].a = bits as i64;
    NODES[n].b = if t == TY_F32 { SUF_F32 } else { SUF_F64 };
    NODES[n].c = 0;
    NODES[n].h = 0;
    NODES[n].y = 0;
    NODES[n].count = 0;
    synth_expr(n)
}

// (0.25.2.1) At pos, `f64::consts::PIE`: a name that is none of
// f64::consts'; `f64::PI` (consts false): one of them without `consts::`.
pub fn float_const_error(pos: i64, t: i64, member: i64, consts: bool) -> ! {
    let ty = if t == TY_F32 { "f32" } else { "f64" };
    let name = sym_text(member);
    err_begin(pos);
    if consts {
        err_fmt(f"no constant '{name}' in '{ty}::consts'");
        err_help(c"its constants: PI, TAU, E, SQRT_2, LN_2, LN_10, LOG2_E, LOG10_E, LOG2_10, ");
        err_help(c"LOG10_2, FRAC_PI_2, FRAC_PI_3, FRAC_PI_4, FRAC_PI_6, FRAC_PI_8, FRAC_1_PI, ");
        err_help(c"FRAC_2_PI, FRAC_2_SQRT_PI, FRAC_1_SQRT_2; ");
        err_help_fmt(f"{ty}'s own: EPSILON, MAX, MIN, MIN_POSITIVE, INFINITY, NEG_INFINITY, NAN");
    } else {
        err_fmt(f"no associated constant '{name}' in '{ty}'");
        err_help_fmt(f"the math constants are in '{ty}::consts': '{ty}::consts::{name}'");
    }
    err_end()
}

// Checked value n (of an integer type that widens to `to`, or `!`) as a
// value of type `to`: a block, `if` or `match` where its values are (the
// tail, each branch, each arm), so that they keep their shape; any other
// expression becomes a Cast (widen_node).
pub fn widen_value(n: i64, to: i64) {
    let t = NODES[n].ty;
    if t == to || t == TY_NEVER || t == TY_ERROR {
        return;
    }
    match NODES[n].kind {
        NodeKind::Block if NODES[n].a != 0 => widen_value(NODES[n].a, to),
        NodeKind::If if NODES[n].c != 0 => {
            widen_value(NODES[n].b, to);
            widen_value(NODES[n].c, to);
        }
        NodeKind::Match => {
            for i in 0..NODES[n].count {
                widen_value(NODES[child(n, i)].c, to);
            }
        }
        _ => {
            widen_node(n, to);
            return;
        }
    }
    NODES[n].ty = to;
}

// Two values that meet without an expected type (the branches of an `if`,
// the arms of a `match`, an operator's operands), a of type at and b of
// type bt: when one type widens to the other, the narrower value is
// widened and the join is returned; 0 otherwise (nothing changed).
pub fn join_values(a: i64, at: i64, b: i64, bt: i64) -> i64 {
    let j = join_int(at, bt);
    if j != 0 {
        widen_value(a, j);
        widen_value(b, j);
    }
    j
}

// Arm i of match n, whose body is of a definite type (!takes_context),
// when the arms before it have integer type `result` and no type is
// expected: synthesized, then joined with them (the narrower widened;
// earlier arms left for later, the context literals, are not checked
// yet). The arm's type: `!`, or the join.
pub fn join_arm(n: i64, i: i64, body: i64, result: i64, later: bool) -> i64 {
    let t = check_wrapped(body, 0);
    if t == result || t == TY_NEVER {
        return t;
    }
    if t == TY_ERROR {
        return result;
    }
    let j = join_int(result, t);
    if j == 0 {
        mismatch_error(body, result, t);
    }
    if j == result {
        widen_value(body, j);
        return j;
    }
    for k in 0..i {
        let b = NODES[child(n, k)].c;
        if !(later && is_context_value(b)) {
            widen_value(b, j);
        }
    }
    j
}

// Whether expression e takes its type from the code around it, before it
// is checked: an unsuffixed literal (also negated, or in arithmetic of
// such), a variant of a generic enum without its type arguments (`None`),
// `x.into()`, a block or `if` whose values are such, and (conservatively)
// the compound expressions whose type their parts decide (`match`, loops,
// closures, literals of tuples, arrays and structs). An operand or a
// match arm of a definite type (a local, a field, a call, a cast, ...) can
// be synthesized first, and joined.
pub fn takes_context(e: i64) -> bool {
    fold_layout_query(e);
    match NODES[e].kind {
        NodeKind::Int | NodeKind::Float => NODES[e].b == SUF_NONE,
        NodeKind::Char => true,
        NodeKind::Unary if NODES[e].op == Tok::Minus || NODES[e].op == Tok::Tilde => {
            takes_context(NODES[e].b)
        }
        NodeKind::Binary => {
            let op = NODES[e].op;
            if op == Tok::Shl || op == Tok::Shr {
                return takes_context(NODES[e].b);
            }
            if is_arith_op(op) {
                return takes_context(NODES[e].b) && takes_context(NODES[e].c);
            }
            false
        }
        NodeKind::Ident | NodeKind::Path => names_context_variant(e),
        NodeKind::MethodCall => NODES[e].count == 0 && sym_is_c(NODES[e].b, c"into"),
        // (a block by its tail, an `if` by its branches)
        NodeKind::Block => NODES[e].a != 0 && takes_context(NODES[e].a),
        NodeKind::If => NODES[e].c != 0 && takes_context(NODES[e].b)
            && takes_context(NODES[e].c),
        NodeKind::Match | NodeKind::Loop
            | NodeKind::Closure | NodeKind::Tuple | NodeKind::Array | NodeKind::Repeat
            | NodeKind::StructLit | NodeKind::Range | NodeKind::Try | NodeKind::Interp => true,
        _ => false,
    }
}

// The arithmetic and bitwise operators, whose operands and result have one
// type.
fn is_arith_op(op: Tok) -> bool {
    op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
        || op == Tok::Percent || op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret
}

// The operands of a non-shift operator (synth_operands), lhs already
// synthesized, of integer type lhs_ty, and rhs of a definite type
// (!takes_context): rhs is synthesized (with lhs_ty as its hint, as
// check_expr would give it), then the two join: the narrower is widened.
// Their common type.
pub fn join_operands(lhs: i64, lhs_ty: i64, rhs: i64) -> i64 {
    HINT_NODE = rhs;
    HINT_TY = lhs_ty;
    let rhs_ty = crate::front::check::synth_mode::read_through(rhs, synth_expr(rhs));
    if rhs_ty == lhs_ty || rhs_ty == TY_ERROR || lhs_ty == TY_ERROR {
        return lhs_ty;
    }
    if rhs_ty == TY_NEVER {
        NODES[rhs].ty = lhs_ty;
        return lhs_ty;
    }
    let j = join_values(lhs, lhs_ty, rhs, rhs_ty);
    if j != 0 {
        return j;
    }
    if !is_integer(rhs_ty) {
        mismatch_error(rhs, lhs_ty, rhs_ty);
    }
    int_mismatch_error(lhs, lhs_ty, rhs, rhs_ty)
}

// Two integer values of types that do not widen one to the other (`i32`
// and `u32`, `i64` and `u64`): the mismatch, with the conversion to write
// (both to i64 when both widen to it, else the right one to the left's
// type; 0.26.2: of a usize and an i64, the usize, a length, to i64, as
// `fix --only usize` writes it).
fn int_mismatch_error(lhs: i64, lhs_ty: i64, rhs: i64, rhs_ty: i64) -> ! {
    err_begin(NODES[rhs].start);
    err_str(c"expected '");
    err_type(lhs_ty);
    err_str(c"', got '");
    err_type(rhs_ty);
    err_str(c"'");
    if lhs_ty == TY_USIZE && rhs_ty == TY_I64 || lhs_ty == TY_I64 && rhs_ty == TY_USIZE {
        let u = if lhs_ty == TY_USIZE { lhs } else { rhs };
        let text = SRC[NODES[u].start..NODES[u].end];
        let t = buf_new();
        if operand_is_simple(u) {
            buf_fmt(t, f"{text} as i64");
        } else {
            buf_fmt(t, f"({text}) as i64");
        }
        err_help(c"a length or an index is a usize: convert it to the i64's type");
        err_try_fmt(buf_slice(t));
        err_fix(NODES[u].start, NODES[u].end, buf_slice(t));
        err_end();
    }
    let both = widens(lhs_ty, TY_I64) && widens(rhs_ty, TY_I64);
    err_help(c"convert explicitly: '");
    if both {
        err_help(c"(");
        buf_bytes(ERR_HELP, SRC[NODES[lhs].start..NODES[lhs].end]);
        err_help(c" as i64)");
        buf_bytes(ERR_HELP, SRC[NODES[lhs].end..NODES[rhs].start]);
    }
    // (`(x as T)`; 0.26.2: `(a - b) as T` of an operation)
    let simple = operand_is_simple(rhs);
    err_help(c"(");
    buf_bytes(ERR_HELP, SRC[NODES[rhs].start..NODES[rhs].end]);
    err_help(if simple { c" as " } else { c") as " });
    if both {
        err_help(c"i64");
    } else {
        buf_type(ERR_HELP, lhs_ty);
    }
    err_help(if simple { c")'" } else { c"'" });
    err_end()
}

// (0.26.2) Whether operand n is written `x as T` without parentheses: it
// binds tighter than `as` (not an operator's own expression).
pub fn operand_is_simple(n: i64) -> bool {
    let k = NODES[n].kind;
    !(k == NodeKind::Binary || k == NodeKind::Unary || k == NodeKind::Cast
        || k == NodeKind::Range || k == NodeKind::If || k == NodeKind::Match
        || k == NodeKind::Block || k == NodeKind::Closure)
}
