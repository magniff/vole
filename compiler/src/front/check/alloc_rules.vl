// (0.26.3) Allocation is a capability (docs/design/rust-surface-plan.md
// §2.0, docs/grammar.md "Allocators"): a function allocates only through
// an allocator reachable from its parameters, and its signature shows
// that one is. The rules, each an error with its code:
//
// - alloc.default (rule 2): no default allocator type. `Vec<u8>` names
//   no allocator: `Vec<u8, Gpa>`, or a generic `A: Allocator`. A type
//   parameter bounded by Allocator takes no default.
//
// Its exact fix (`fix --only alloc`) writes `Gpa`, what the 0.26.2
// default meant; it is refused inside an item generic over an allocator
// (`A` may be what was meant), but for the program's own type in its own
// generic impl, `Bag<T>` in `impl<T, A: Allocator> Bag<T, A>`, where it
// writes the impl's `A`. An impl block leaving out its type's allocator,
// `impl<T> Bag<T>`, is alloc.default too: its fix adds the parameter.

use crate::base::{
    buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_src, intern, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_jump, err_str, err_sym,
    err_try_tool, errors_forget, errors_mark,
};
use crate::front::ast::{FN_DEFAULT_COPY, ITEM_UNSAFE, NodeKind, child};
use crate::front::check::{Try, attempt};
use crate::front::generics::instance_of;
use crate::front::modules::{module_of, within_std};
use crate::front::traits::{bound_trait, std_trait};
use crate::front::types::{
    TyKind, enum_variant, err_type, get_enums, struct_field, struct_type, type_elem, variant_field,
};

// ---- Allocator types ----

// std's Allocator trait, -1 when std is not loaded.
pub fn allocator_trait(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.alloc_rules_allocator_trait == -2 {
        pcx.alloc_rules_allocator_trait = std_trait(c"Allocator", pcx);
    }
    pcx.alloc_rules_allocator_trait
}

// Whether type t is an allocator: it has an impl of std's Allocator.
pub fn is_allocator_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    let tr = allocator_trait(pcx);
    if tr < 0 || t <= 0 || pcx.types[t as usize].kind != TyKind::Struct {
        return false;
    }
    // (0.27.2.1: the impls of tr only, by its chain)
    let mut next_impl = crate::front::traits::impls_start(tr, pcx);
    while next_impl >= 0 {
        let i = next_impl;
        next_impl = crate::front::traits::impls_after(i, pcx);
        if pcx.traits_impls[i as usize].tr != tr {
            continue;
        }
        if pcx.traits_impls[i as usize].ty == t
            || (pcx.traits_impls[i as usize].ty == 0
                && instance_of(t, pcx.traits_impls[i as usize].tpl, pcx)) {
            return true;
        }
    }
    false
}

// Whether type parameter node p (of a Generics node) is bounded by
// Allocator.
pub fn is_allocator_param(p: i64, pcx: &mut Ctx<Comp>) -> bool {
    let tr = allocator_trait(pcx);
    if tr < 0 {
        return false;
    }
    let bounds = pcx.nodes[p as usize].h;
    if bounds == 0 {
        return false;
    }
    for j in 0..pcx.nodes[bounds as usize].count {
        if bound_trait(child(bounds, j, pcx), pcx) == tr {
            return true;
        }
    }
    false
}

// std's Gpa, 0 when std is not loaded.
pub fn gpa_type(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.alloc_rules_gpa_type != 0 {
        return pcx.alloc_rules_gpa_type;
    }
    let name = intern_c(c"Gpa", pcx);
    for s in 0..pcx.structs.len() as i64 {
        if pcx.structs[s as usize].name == name && pcx.structs[s as usize].tmpl == 0
            && pcx.structs[s as usize].generic == 0
            && within_std(pcx.structs[s as usize].module, pcx) {
            pcx.alloc_rules_gpa_type = struct_type(s, pcx);
            return pcx.alloc_rules_gpa_type;
        }
    }
    0
}

// The name of a type parameter in scope bound to an allocator (the
// instance being checked or made is generic over one), or 0.
fn allocator_param_in_scope(pcx: &mut Ctx<Comp>) -> i64 {
    let mut i = pcx.tp_names.len() as i64 - 1;
    while i >= 0 {
        // UNSAFE: TP_NAMES and TP_TYPES are the checker's raw IntVecs.
        // SAFETY: 0 <= i < TP_NAMES.count == TP_TYPES.count (pushed in pairs).
        unsafe {
            if is_allocator_type((pcx.tp_types[i as usize]), pcx) {
                return (pcx.tp_names[i as usize]);
            }
        }
        i -= 1;
    }
    0
}

// The name of an allocator type parameter of an item that pos is in (a
// function with its impl's parameters, an impl, a struct, an enum, a
// trait), the first that is not `skip` (0: the first); 0 when none. By
// position, as a generic item is also checked without an instance, where
// the scope names no parameter.
fn allocator_param_at(pos: i64, skip: i64, pcx: &mut Ctx<Comp>) -> i64 {
    for k in 0..pcx.nodes[pcx.program as usize].count {
        let item = child(pcx.program, k, pcx);
        let g = pcx.nodes[item as usize].g;
        let kind = pcx.nodes[item as usize].kind;
        if g == 0 || pos < pcx.nodes[item as usize].start || pos >= pcx.nodes[item as usize].end
            || (kind != NodeKind::Fn && kind != NodeKind::Impl && kind != NodeKind::Struct
                && kind != NodeKind::Enum && kind != NodeKind::Trait) {
            continue;
        }
        for i in 0..pcx.nodes[g as usize].count {
            let p = child(g, i, pcx);
            if pcx.nodes[p as usize].a != skip && is_allocator_param(p, pcx) {
                return pcx.nodes[p as usize].a;
            }
        }
    }
    0
}

// ---- Rule 2: no default allocator type ----

// The type arguments TSCRATCH[mark..] of `name`<..> (a struct or enum
// with type parameters `params`, `generic` of them), written at pos, when
// fewer than its parameters: when those left out are its allocator
// parameters, alloc.default, and Gpa in their place (what the 0.26.2
// default meant, so the check goes on); false (nothing pushed) when they
// are not.
pub fn missing_allocator(params: i64, generic: i64, mark: i64, name: i64, pos: i64,
    pcx: &mut Ctx<Comp>) -> bool {
    let count = pcx.tscratch.len() as i64 - mark;
    let gpa = gpa_type(pcx);
    // (0.28.0) The parameters after the allocators that have defaults
    // (`HashMap<K, V, A, S = FixedState>`) are not missing: the caller
    // fills them after this.
    let mut generic = generic;
    while generic > count && pcx.nodes[child(params, generic - 1, pcx) as usize].b != 0 {
        generic -= 1;
    }
    if count >= generic || gpa == 0 {
        return false;
    }
    for k in count..generic {
        if !is_allocator_param(child(params, k, pcx), pcx) {
            return false;
        }
    }
    let missing = generic - count;
    let saved = pcx.err_kind;
    pcx.err_kind = c"alloc.default";
    err_begin(pos, pcx);
    err_str(c"'", pcx);
    err_sym(name, pcx);
    err_str(c"' names no allocator: its '", pcx);
    err_sym(pcx.nodes[child(params, generic - 1, pcx) as usize].a, pcx);
    err_str(c"' is written, last", pcx);
    // (0.28.0) The allocator parameters of the item the type is written
    // in: one, and the fix writes it (`Vec<T, A>` in `impl<T, A:
    // Allocator> Ring<T, A>`, not `Gpa`, which the item's callers may
    // not have); two, and which one is the writer's to say: no fix.
    let mut inside = allocator_param_at(pos, 0, pcx);
    let other = if inside != 0 { allocator_param_at(pos, inside, pcx) } else { 0 };
    if inside == 0 {
        inside = allocator_param_in_scope(pcx);
    }
    if other != 0 || (inside != 0 && missing != 1) {
        err_help(c"this item is generic over the allocators '", pcx);
        crate::base::diag::err_help_sym(inside, pcx);
        err_help(if other != 0 { c"' and '" } else { c"" }, pcx);
        if other != 0 {
            crate::base::diag::err_help_sym(other, pcx);
        }
        err_help(c"': write the one this '", pcx);
        crate::base::diag::err_help_sym(name, pcx);
        err_help(c"' allocates from as its last type argument (`, ", pcx);
        crate::base::diag::err_help_sym(inside, pcx);
        err_help(c"`); no fix chooses between them", pcx);
    } else if inside != 0 {
        err_help_fmt(format_args(
            "this item is generic over the allocator '{}': write it (`, {}`, the fix), or `Gpa`",
            str::from_utf8(sym_text(inside, pcx)).unwrap(),
            str::from_utf8(sym_text(inside, pcx)).unwrap()), pcx);
        if default_fix(pos, name, count, missing, sym_text(inside, pcx), pcx) {
            err_try_tool(b"fix --only alloc", true, pcx);
        }
    } else {
        err_help(c"the allocator is part of the type: `Gpa` (the type of main's `gpa`), or a generic `A: Allocator`", pcx);
        let own = impl_allocator_at(pos, name, pcx);
        let _ = default_fix(pos, name, count, missing,
            if own != 0 && missing == 1 { sym_text(own, pcx) } else { b"Gpa" }, pcx);
        err_try_tool(b"fix --only alloc", true, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    for _ in 0..missing {
        pcx.tscratch.push(gpa);
    }
    true
}

// The fix of a type written at pos, `name` or `name<..count..>`: `Gpa`
// for each of the `missing` allocators (`what`: Gpa, or the name of an
// allocator parameter), as the last type arguments.
fn default_fix(pos: i64, name: i64, count: i64, missing: i64, what: &[u8], pcx: &mut Ctx<Comp>)
    -> bool {
    // The name as written: a path, its last part `name`.
    let mut i = pos;
    let mut last = pos;
    while i < get_src().len() as i64
        && (ident_byte(get_src()[i as usize]) || get_src()[i as usize] == b':') {
        if get_src()[i as usize] == b':' {
            last = i + 1;
        }
        i += 1;
    }
    let mut end = i;
    let mut j = end;
    // (a path's turbofish, `Vec::<i64>::new_in(gpa)`: the name before `::<`)
    if end - pos >= 2 && get_src()[(end - 1) as usize] == b':'
        && get_src()[(end - 2) as usize] == b':' && end < get_src().len() as i64
        && get_src()[end as usize] == b'<' {
        j = end;
        end -= 2;
        last = pos;
        for q in pos..end {
            if get_src()[q as usize] == b':' {
                last = q + 1;
            }
        }
    }
    if &get_src()[last as usize..end as usize] != sym_text(name, pcx) {
        return false;
    }
    while j < get_src().len() as i64 && get_src()[j as usize] == b' ' {
        j += 1;
    }
    let text = buf_new();
    if j < get_src().len() as i64 && get_src()[j as usize] == b'<' && count > 0 {
        // the matching `>`
        let mut depth: i64 = 0;
        let mut brackets: i64 = 0;
        let mut k = j;
        while k < get_src().len() as i64 {
            let c = get_src()[k as usize];
            if c == b'<' {
                depth += 1;
            } else if c == b'>' && get_src()[(k - 1) as usize] != b'-' {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            } else if c == b'[' || c == b'(' {
                brackets += 1;
            } else if c == b']' || c == b')' {
                brackets -= 1;
            } else if (c == b';' && brackets == 0) || c == b'{' {
                return false;
            }
            k += 1;
        }
        if k >= get_src().len() as i64 {
            return false;
        }
        for _ in 0..missing {
            buf_str(text, c", ");
            buf_bytes(text, what);
        }
        err_fix(k, k, buf_slice(text), pcx);
        true
    } else if count == 0 {
        buf_str(text, c"<");
        buf_bytes(text, what);
        for _ in 1..missing {
            buf_str(text, c", ");
            buf_bytes(text, what);
        }
        buf_str(text, c">");
        err_fix(end, end, buf_slice(text), pcx);
        true
    } else {
        false
    }
}

// A generic impl's block for template `tpl` (its type's arguments `args`):
// when the type's last parameter is an allocator, the impl is noted as
// impl_missing_allocator notes one, so that `Bag<T>` inside `impl<T, A:
// Allocator> Bag<T, A>` gets the impl's `A` (where it is checked without
// an instance, the scope names no allocator).
pub fn note_generic_impl(item: i64, tpl: i64, args: i64, pcx: &mut Ctx<Comp>) {
    // UNSAFE: NODES, STRUCTS and ENUMS are the checker's raw tables.
    // SAFETY: tpl is a struct (1 + index) or an enum (-1 - index) template; args the impl's type's arguments.
    unsafe {
        if tpl == 0 || tpl >= crate::front::generics::TPL_SLICE || args == 0
            || within_std(module_of(item, pcx), pcx) {
            return;
        }
        let node = if tpl > 0 { pcx.structs[(tpl - 1) as usize].node }
            else { (*get_enums().add((-tpl - 1) as usize)).node };
        let tparams = pcx.nodes[node as usize].g;
        if tparams == 0 || pcx.nodes[tparams as usize].count != pcx.nodes[args as usize].count {
            return;
        }
        let last = pcx.nodes[tparams as usize].count - 1;
        if !is_allocator_param(child(tparams, last, pcx), pcx) {
            return;
        }
        pcx.impl_alloc.push(pcx.nodes[item as usize].start);
        pcx.impl_alloc.push(pcx.nodes[item as usize].end);
        let name = crate::front::generics::template_name(tpl, pcx);
        pcx.impl_alloc.push(name);
        pcx.impl_alloc.push(pcx.nodes[child(args, last, pcx) as usize].a);
    }
}

// The allocator parameter an impl being given one names `name`'s by, when
// pos is inside it (impl_missing_allocator); 0 when none.
fn impl_allocator_at(pos: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i: i64 = 0;
    while i + 3 < pcx.impl_alloc.len() as i64 {
        // UNSAFE: IMPL_ALLOC is an IntVec, read by index.
        // SAFETY: i + 3 < count: the four values of one impl.
        unsafe {
            let d = pcx.impl_alloc.data;
            if (*d.add(i as usize)) <= pos && pos < (*d.add((i + 1) as usize))
                && (*d.add((i + 2) as usize)) == name {
                return (*d.add((i + 3) as usize));
            }
        }
        i += 4;
    }
    0
}

// (0.26.3) An impl block for a type whose left-out parameters are its
// allocators, `impl<T> Bag<T>` for `struct Bag<T, A: Allocator>` (the
// impl's parameters `iparams`, the type's `tparams`): alloc.default,
// whose fix writes them as the impl's parameters and the type's
// arguments, `impl<T, A: Allocator> Bag<T, A>` (help: the whole header).
// False, nothing reported, when one left out is not an allocator; else
// the error, which ends the check.
pub fn impl_missing_allocator(item: i64, self_node: i64, tparams: i64, iparams: i64, name: i64,
    help: i64, pcx: &mut Ctx<Comp>)
    -> bool {
    let generic = pcx.nodes[tparams as usize].count;
    let written = pcx.nodes[iparams as usize].count;
    if written >= generic {
        return false;
    }
    for k in written..generic {
        if !is_allocator_param(child(tparams, k, pcx), pcx) {
            return false;
        }
    }
    // (the impl's other uses of the type, `-> Bag<T>`, checked after
    // this error: its parameter, in the same round)
    pcx.impl_alloc.push(pcx.nodes[item as usize].start);
    pcx.impl_alloc.push(pcx.nodes[item as usize].end);
    pcx.impl_alloc.push(name);
    pcx.impl_alloc.push(pcx.nodes[child(tparams, generic - 1, pcx) as usize].a);
    // (the kind is this error's only: when the check goes on after it,
    // in a tool that collects errors, the next ones have their own)
    let saved = pcx.err_kind;
    pcx.err_kind = c"alloc.default";
    err_begin(pcx.nodes[self_node as usize].start, pcx);
    err_str(c"'", pcx);
    err_sym(name, pcx);
    err_str(c"' names no allocator: its '", pcx);
    err_sym(pcx.nodes[child(tparams, generic - 1, pcx) as usize].a, pcx);
    err_str(c"' is the impl's parameter too", pcx);
    err_help(c"an impl block writes every type argument: '", pcx);
    crate::base::diag::err_help_sym(help, pcx);
    err_help(c"'", pcx);
    impl_fix(self_node, tparams, iparams, pcx);
    err_try_tool(b"fix --only alloc", true, pcx);
    if pcx.errors_as_dump {
        crate::base::diag::err_end(pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    crate::base::diag::err_jump(pcx)
}

// The fix of impl_missing_allocator: `, A: Allocator` before the `>` of
// the impl's parameters, `, A` before the type's; none when the impl
// already has a parameter of that name.
fn impl_fix(self_node: i64, tparams: i64, iparams: i64, pcx: &mut Ctx<Comp>) {
    let start = pcx.nodes[self_node as usize].start;
    let mut g = start - 1;
    while g > 0 && get_src()[g as usize] == b' ' {
        g -= 1;
    }
    if g <= 0 || get_src()[g as usize] != b'>' {
        return;
    }
    let mut k = start;
    let mut depth: i64 = 0;
    while k < get_src().len() as i64 {
        let c = get_src()[k as usize];
        if c == b'<' {
            depth += 1;
        } else if c == b'>' && get_src()[(k - 1) as usize] != b'-' {
            depth -= 1;
            if depth == 0 {
                break;
            }
        } else if c == b'{' || c == b';' {
            return;
        }
        k += 1;
    }
    if k >= get_src().len() as i64 || depth != 0 {
        return;
    }
    let text = buf_new();
    let args = buf_new();
    for i in pcx.nodes[iparams as usize].count..pcx.nodes[tparams as usize].count {
        let p = pcx.nodes[child(tparams, i, pcx) as usize].a;
        for j in 0..pcx.nodes[iparams as usize].count {
            if pcx.nodes[child(iparams, j, pcx) as usize].a == p {
                return;
            }
        }
        buf_str(text, c", ");
        buf_bytes(text, sym_text(p, pcx));
        buf_str(text, c": Allocator");
        buf_str(args, c", ");
        buf_bytes(args, sym_text(p, pcx));
    }
    buf_bytes(text, &get_src()[g as usize..k as usize]);
    buf_bytes(text, buf_slice(args));
    err_fix(g, k, buf_slice(text), pcx);
}

fn ident_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// ---- The declarations' rules ----

// (after the declarations are collected) Each rule on the program's items.
pub fn check_alloc_rules(pcx: &mut Ctx<Comp>) {
    if allocator_trait(pcx) < 0 {
        return;
    }
    for k in 0..pcx.nodes[pcx.program as usize].count {
        let item = child(pcx.program, k, pcx);
        let kind = pcx.nodes[item as usize].kind;
        if (kind == NodeKind::Struct || kind == NodeKind::Enum)
            && pcx.nodes[item as usize].g != 0 {
            check_declared_defaults(pcx.nodes[item as usize].g, pcx);
        }
    }
    check_alloc_statics(pcx);
    check_alloc_fields(pcx);
    check_alloc_last(pcx);
}

// alloc.default on a declaration: a type parameter bounded by Allocator
// with a default (`A: Allocator = Gpa`).
fn check_declared_defaults(g: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[g as usize].count {
        let p = child(g, i, pcx);
        let def = pcx.nodes[p as usize].b;
        if def == 0 || !is_allocator_param(p, pcx) {
            continue;
        }
        let saved = pcx.err_kind;
        pcx.err_kind = c"alloc.default";
        err_begin(pcx.nodes[p as usize].start, pcx);
        err_str(c"the allocator parameter '", pcx);
        err_sym(pcx.nodes[p as usize].a, pcx);
        err_str(c"' has a default: an allocator type is always written (0.26.3)", pcx);
        err_help(c"take the default out: each use writes its allocator (`Vec<u8, Gpa>`)", pcx);
        // (` = Gpa`: from the end of the bounds to the end of the default)
        let mut s = pcx.nodes[def as usize].start;
        while s > pcx.nodes[p as usize].start && get_src()[(s - 1) as usize] != b'=' {
            s -= 1;
        }
        if s > pcx.nodes[p as usize].start {
            s -= 1;
            while s > pcx.nodes[p as usize].start && get_src()[(s - 1) as usize] == b' ' {
                s -= 1;
            }
            err_fix(s, pcx.nodes[def as usize].end, b"", pcx);
        }
        err_try_tool(b"fix --only alloc", true, pcx);
        err_end_soft(pcx);
        pcx.err_kind = saved;
    }
}

// Whether template tpl (generics.vl's encoding: struct + 1, or -(enum +
// 1)) has only allocator parameters, so that its bare name (`Buf`) is an
// instance missing its allocator (alloc.default) rather than a template.
pub fn bare_allocator_only(tpl: i64, pcx: &mut Ctx<Comp>) -> bool {
    // UNSAFE: STRUCTS, ENUMS and NODES are the checker's raw tables.
    // SAFETY: tpl encodes a struct or enum id in range; its node's g a
    // Generics node.
    unsafe {
        let node = if tpl > 0 { pcx.structs[(tpl - 1) as usize].node }
            else { (*get_enums().add((-tpl - 1) as usize)).node };
        let g = pcx.nodes[node as usize].g;
        if g == 0 || pcx.nodes[g as usize].count == 0 {
            return false;
        }
        for k in 0..pcx.nodes[g as usize].count {
            if !is_allocator_param(child(g, k, pcx), pcx) {
                return false;
            }
        }
    }
    true
}

// ---- Statics (0.26.3) ----

// (0.27.0) No static is exempt: the compiler's last two that held an
// allocator, base::SYMS and front::types::TYPES, are fields of the
// compilation context (base::ctx::Ctx.syms, Ctx.types), which code
// generation's tasks are lent let: they read the symbols and the types
// (find_sym, find_type, type_size), and the main thread makes them before
// the tasks run (intern, make_type, compute_layout).

// A static item's name as written: its symbol is the module's path and
// the name (`front.embed.wgsl.WGSL_ARENA`).
fn static_name(node: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let s = sym_text(pcx.nodes[node as usize].a, pcx);
    let mut k = s.len() as i64;
    while k > 0 && s[(k - 1) as usize] != b'.' {
        k -= 1;
    }
    &s[k as usize..]
}

// ---- Rule 1: an allocator's impl is unsafe ----

// alloc.safe_impl: impl block `node` of trait tr, for type ty (0: a
// generic impl). Allocator is an `unsafe trait`: a type built over
// malloc from nothing is the global allocator it would be, so its impl is
// `unsafe impl`, with `// UNSAFE:` and `// SAFETY:` comments naming where
// its memory comes from (0.26.4: Comp's too). No fix: the comments are the author's. `unsafe impl` of a safe trait is an
// error too (Rust's E0199), with the `unsafe` taken out as its fix.
pub fn check_impl_safety(node: i64, tr: i64, ty: i64, pcx: &mut Ctx<Comp>) {
    let trait_unsafe = (pcx.nodes[pcx.traits[tr as usize].node as usize].p & ITEM_UNSAFE) != 0;
    let impl_unsafe = (pcx.nodes[node as usize].p & ITEM_UNSAFE) != 0;
    if trait_unsafe == impl_unsafe {
        return;
    }
    let is_alloc = tr == allocator_trait(pcx);
    let saved = pcx.err_kind;
    if is_alloc {
        pcx.err_kind = c"alloc.safe_impl";
    }
    err_begin(pcx.nodes[node as usize].start, pcx);
    if trait_unsafe {
        err_str(c"the trait '", pcx);
        err_sym(pcx.traits[tr as usize].name, pcx);
        err_str(c"' is unsafe: its impl is `unsafe impl`", pcx);
        err_help(if is_alloc {
            c"an allocator says where its memory comes from: `unsafe impl Allocator for T`, under `// UNSAFE:` (why it cannot be safe) and `// SAFETY:` (where its memory comes from, why it is sound)" }
            else { c"write `unsafe impl`, under `// UNSAFE:` and `// SAFETY:` comments: why the impl keeps the trait's promise" }, pcx);
    } else {
        err_str(c"`unsafe impl` of the trait '", pcx);
        err_sym(pcx.traits[tr as usize].name, pcx);
        err_str(c"', which is not unsafe: only an unsafe trait's impl is", pcx);
        err_help(c"take the `unsafe` out", pcx);
        // (from `unsafe` to `impl`)
        let mut e = pcx.nodes[node as usize].start + 6;
        while e < pcx.nodes[node as usize].end
            && (get_src()[e as usize] == b' ' || get_src()[e as usize] == b'\n'
                || get_src()[e as usize] == b'\t') {
            e += 1;
        }
        err_fix(pcx.nodes[node as usize].start, e, b"", pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// ---- AllocFree (rule 1): what holds no allocator ----

// Whether type t is AllocFree: it holds no allocator, looking through
// everything (fields, enum payloads, tuples, arrays, slices, pointers and
// references, closure environments), not through a function type.
pub fn is_alloc_free(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    alloc_part(t, pcx) == 0
}

// The allocator type that t holds, the first found, 0: none.
pub fn alloc_part(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if t <= 0 || t == pcx.ty_error || allocator_trait(pcx) < 0 {
        return 0;
    }
    let known = pcx.alloc_memo.get(t + 1);
    if known != 0 {
        return known - 1;
    }
    // (a type reached again while it is decided: none there)
    pcx.alloc_memo.put(t + 1, 1);
    let r = alloc_of(t, pcx);
    pcx.alloc_memo.put(t + 1, r + 1);
    r
}

fn alloc_of(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // UNSAFE: STRUCTS, ENUMS and VARIANTS are the checker's raw tables.
    // SAFETY: t > 0 is a type id; a struct type's TYPES[t].a is a struct id,
    // an enum type's an enum id, whose variants and fields are in range.
    unsafe {
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Struct {
            if is_allocator_type(t, pcx) {
                return t;
            }
            let s = pcx.types[t as usize].a;
            for i in 0..pcx.structs[s as usize].field_count {
                let r = alloc_part((*struct_field(s, i, pcx)).ty, pcx);
                if r != 0 {
                    return r;
                }
            }
            return 0;
        }
        if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                let r = alloc_part(type_elem(t, i, pcx), pcx);
                if r != 0 {
                    return r;
                }
            }
            return 0;
        }
        if kind == TyKind::Array || kind == TyKind::Distinct || kind == TyKind::Ptr
            || kind == TyKind::Slice {
            return alloc_part(pcx.types[t as usize].a, pcx);
        }
        if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(e as usize)).variant_count {
                let v = enum_variant(e, i);
                for k in 0..pcx.variants[v as usize].field_count {
                    let r = alloc_part(variant_field(v, k, pcx), pcx);
                    if r != 0 {
                        return r;
                    }
                }
            }
        }
        0
    }
}

// ---- Rule 1: no static holds an allocator ----

// alloc.static: a `static`, `static var` or thread-local whose type holds
// an allocator: any function could allocate through it with nothing in
// its signature saying so. No fix: the value moves into main.
fn check_alloc_statics(pcx: &mut Ctx<Comp>) {
    for s in 0..pcx.statics.len() as i64 {
        let t = pcx.statics[s as usize].ty;
        if t <= 0 || t == pcx.ty_error || pcx.statics[s as usize].linkage != 0 {
            continue;
        }
        let part = alloc_part(t, pcx);
        if part == 0 {
            continue;
        }
        let node = pcx.statics[s as usize].node;
        let saved = pcx.err_kind;
        pcx.err_kind = c"alloc.static";
        err_begin(pcx.nodes[node as usize].start, pcx);
        let name = static_name(node, pcx);
        err_fmt({ let name = str::from_utf8(name).unwrap(); format_args("the static '{name}") },
            pcx);
        err_str(c"' holds an allocator, '", pcx);
        err_type(part, pcx);
        if part != t {
            err_str(c"' (in its type '", pcx);
            err_type(t, pcx);
            err_str(c"')", pcx);
        } else {
            err_str(c"'", pcx);
        }
        err_str(c": a static's type may not hold one", pcx);
        err_help(c"any function could allocate through it with nothing in its signature saying so: keep the value in main and pass it down (or what it allocates, as a slice)", pcx);
        err_end_soft(pcx);
        pcx.err_kind = saved;
    }
}

// ---- Rule 3: a type holding an allocator names it in its parameters ----

// alloc.field: a struct's field (an enum variant's payload) holds an
// allocator its type parameters do not name (`struct P { v: Vec<u8, Gpa> }`):
// `fn f(p: &mut P)` could allocate with nothing in its signature saying
// so. Its fix makes the type generic over the allocator,
// `struct P<A: Allocator> { v: Vec<u8, A> }`; its uses then name it
// (`P<Gpa>`, alloc.default's fix).
fn check_alloc_fields(pcx: &mut Ctx<Comp>) {
    for k in 0..pcx.nodes[pcx.program as usize].count {
        let item = child(pcx.program, k, pcx);
        let kind = pcx.nodes[item as usize].kind;
        if kind != NodeKind::Struct && kind != NodeKind::Enum {
            continue;
        }
        let module = module_of(item, pcx);
        let g = pcx.nodes[item as usize].g;
        for i in 0..pcx.nodes[item as usize].count {
            let f = child(item, i, pcx);
            if kind == NodeKind::Struct {
                let part = field_allocator(pcx.nodes[f as usize].b, g, module, pcx);
                if part != 0 {
                    field_error(item, f, pcx.nodes[f as usize].b, part, pcx);
                    break;
                }
            } else {
                let mut found = false;
                for j in 0..pcx.nodes[f as usize].count {
                    let ty = child(f, j, pcx);
                    let part = field_allocator(ty, g, module, pcx);
                    if part != 0 {
                        field_error(item, f, ty, part, pcx);
                        found = true;
                        break;
                    }
                }
                if found {
                    break;
                }
            }
        }
    }
}

// Whether type node n names a type parameter of Generics node g.
fn mentions_param(n: i64, g: i64, pcx: &Ctx<Comp>) -> bool {
    if n == 0 || g == 0 {
        return false;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::TyName {
        if pcx.nodes[n as usize].count == 0 {
            for i in 0..pcx.nodes[g as usize].count {
                if pcx.nodes[child(g, i, pcx) as usize].a == pcx.nodes[n as usize].a {
                    return true;
                }
            }
        }
        let args = pcx.nodes[n as usize].g;
        if args != 0 {
            for i in 0..pcx.nodes[args as usize].count {
                if mentions_param(child(args, i, pcx), g, pcx) {
                    return true;
                }
            }
        }
        return false;
    }
    if kind == NodeKind::TyPtr || kind == NodeKind::TySlice || kind == NodeKind::TyArray {
        return mentions_param(pcx.nodes[n as usize].a, g, pcx);
    }
    if kind == NodeKind::TyTuple || kind == NodeKind::TyFn {
        for i in 0..pcx.nodes[n as usize].count {
            if mentions_param(child(n, i, pcx), g, pcx) {
                return true;
            }
        }
        return kind == NodeKind::TyFn && mentions_param(pcx.nodes[n as usize].a, g, pcx);
    }
    false
}

// The allocator type that field type node n (of an item with type
// parameters g, in module) holds without naming it through g; 0: none.
// A part written with g's parameters is theirs (`Vec<T, A>`, `&'a
// Arena<P>`); a part without is resolved and looked through (AllocFree).
fn field_allocator(n: i64, g: i64, module: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if n == 0 {
        return 0;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::TyFn {
        return 0;
    }
    // RULE: F33.1 (0.27.2: in the rust edition a raw pointer holds no
    // allocator: it carries no ownership)
    if kind == NodeKind::TyPtr
        && (pcx.nodes[n as usize].p
            & (crate::front::ast::NODE_REF | crate::front::ast::NODE_REF_MUT))
        == 0 {
        return 0;
    }
    if !mentions_param(n, g, pcx) {
        let t = resolve_quietly(n, module, pcx);
        return alloc_part(t, pcx);
    }
    if kind == NodeKind::TyName {
        let args = pcx.nodes[n as usize].g;
        if args != 0 {
            for i in 0..pcx.nodes[args as usize].count {
                let r = field_allocator(child(args, i, pcx), g, module, pcx);
                if r != 0 {
                    return r;
                }
            }
        }
        return 0;
    }
    if kind == NodeKind::TyPtr || kind == NodeKind::TySlice || kind == NodeKind::TyArray {
        return field_allocator(pcx.nodes[n as usize].a, g, module, pcx);
    }
    if kind == NodeKind::TyTuple {
        for i in 0..pcx.nodes[n as usize].count {
            let r = field_allocator(child(n, i, pcx), g, module, pcx);
            if r != 0 {
                return r;
            }
        }
    }
    0
}

// Type node n resolved in module, with no type parameter in scope; 0 when
// it does not resolve (its error is the declaration's, reported there).
fn resolve_quietly(n: i64, module: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mark = errors_mark(pcx);
    let saved_mod = pcx.cur_mod;
    let saved_base = pcx.tp_base;
    pcx.tp_base = pcx.tp_names.len() as i64;
    pcx.cur_mod = module;
    let saved_help = pcx.help_off;
    pcx.help_off = true;
    let ok = attempt(Try::Type, n, pcx);
    pcx.help_off = saved_help;
    pcx.cur_mod = saved_mod;
    pcx.tp_base = saved_base;
    if !ok {
        errors_forget(mark, pcx);
        return 0;
    }
    pcx.try_result
}

fn field_error(item: i64, f: i64, ty: i64, part: i64, pcx: &mut Ctx<Comp>) {
    let is_enum = pcx.nodes[item as usize].kind == NodeKind::Enum;
    let saved = pcx.err_kind;
    pcx.err_kind = c"alloc.field";
    err_begin(pcx.nodes[ty as usize].start, pcx);
    err_str(if is_enum { c"the enum '" } else { c"the struct '" }, pcx);
    err_sym(pcx.nodes[item as usize].a, pcx);
    err_str(c"' holds an allocator its parameters do not name: '", pcx);
    err_type(part, pcx);
    err_str(c"', in ", pcx);
    if is_enum {
        err_str(c"variant '", pcx);
    } else {
        err_str(c"field '", pcx);
    }
    err_sym(pcx.nodes[f as usize].a, pcx);
    err_str(c"'", pcx);
    err_help(c"a type that holds an allocator says so in its parameters: make it generic over it (`struct P<A: Allocator> { v: Vec<u8, A> }`, used as `P<Gpa>`)", pcx);
    generic_fix(item, part, pcx);
    err_try_tool(b"fix --only alloc", true, pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// True when the line starting at position p is a `use` (or `pub use`).
fn use_line_at(p: i64) -> bool {
    let src = get_src();
    let rest = &src[p as usize..];
    rest.starts_with(b"use ") || rest.starts_with(b"pub use ")
}

// (0.28.0) Where `use std::alloc::Allocator;` goes in the file of position
// `at`, for a fix that writes the bound `A: Allocator` in a rust program
// (std's prelude has no Allocator there): the start of the file's first
// line that is neither blank nor a comment. -1 when a `use` of the file
// names `Allocator` already.
fn allocator_use_at(at: i64, pcx: &Ctx<Comp>) -> i64 {
    let src = get_src();
    let f = crate::front::contracts::sites::file_of_pos(at, pcx);
    let lo = pcx.files[f as usize].start;
    let hi = if f + 1 < pcx.files.len() as i64 { pcx.files[(f + 1) as usize].start }
        else { src.len() as i64 };
    let word = b"Allocator";
    let mut first: i64 = -1;
    let mut in_use = false;
    let mut p = lo;
    while p < hi {
        // (one line: [p, e))
        let mut e = p;
        while e < hi && src[e as usize] != b'\n' {
            e += 1;
        }
        let mut s = p;
        while s < e && (src[s as usize] == b' ' || src[s as usize] == b'\t') {
            s += 1;
        }
        let comment = s + 1 < e && src[s as usize] == b'/' && src[(s + 1) as usize] == b'/';
        if s < e && !comment {
            if first < 0 {
                first = p;
            }
            if use_line_at(s) {
                in_use = true;
            }
            if in_use {
                let mut k = s;
                while k + word.len() as i64 <= e {
                    if &src[k as usize..(k + word.len() as i64) as usize] == word
                        && !ident_byte(src[(k - 1) as usize])
                        && (k + word.len() as i64 >= e
                            || !ident_byte(src[(k + word.len() as i64) as usize])) {
                        return -1;
                    }
                    k += 1;
                }
                if src[(e - 1) as usize] == b';' {
                    in_use = false;
                }
            }
        }
        p = e + 1;
    }
    if first > at { -1 } else { first }
}

// The fix of alloc.field: item (a struct or enum) made generic over a new
// parameter `A: Allocator` (a name it does not use), which replaces the
// allocator `part` where its fields write it by name. None when the
// allocator is not written in them (held through another type).
fn generic_fix(item: i64, part: i64, pcx: &mut Ctx<Comp>) {
    let pname = sym_text(pcx.structs[pcx.types[part as usize].a as usize].name, pcx);
    let g = pcx.nodes[item as usize].g;
    // (an allocator parameter it has already, from an earlier round:
    // that one, `Bus<A>` holding a `Cart<Gpa>` as `Cart<A>`, the same
    // Gpa the 0.26.2 default meant)
    let mut reuse: i64 = 0;
    if g != 0 {
        for i in 0..pcx.nodes[g as usize].count {
            if reuse == 0 && is_allocator_param(child(g, i, pcx), pcx) {
                reuse = pcx.nodes[child(g, i, pcx) as usize].a;
            }
        }
    }
    // The parameter's name: A, else B, C...
    let mut letter: u8 = b'A';
    let mut free = false;
    while !free && letter <= b'Z' && reuse == 0 {
        free = true;
        if g != 0 {
            for i in 0..pcx.nodes[g as usize].count {
                let n = sym_text(pcx.nodes[child(g, i, pcx) as usize].a, pcx);
                if n.len() == 1 && n[0] == letter {
                    free = false;
                }
            }
        }
        if !free {
            letter += 1;
        }
    }
    if reuse == 0 && (!free || pname.len() == 1 && pname[0] == letter) {
        return;
    }
    // From the end of the name to the end of the item: the parameter
    // added, and `pname` (a whole word, in the fields) replaced.
    let mut name_end = pcx.nodes[item as usize].start;
    let word = sym_text(pcx.nodes[item as usize].a, pcx);
    while name_end + word.len() as i64 <= pcx.nodes[item as usize].end
        && get_src()[name_end as usize..(name_end + word.len() as i64) as usize] != word {
        name_end += 1;
    }
    name_end += word.len() as i64;
    let mut body = name_end;
    let text = buf_new();
    if g != 0 && get_src()[name_end as usize] == b'<' {
        // (before the `>` of its parameters)
        let mut depth: i64 = 0;
        let mut k = name_end;
        while k < pcx.nodes[item as usize].end {
            if get_src()[k as usize] == b'<' {
                depth += 1;
            } else if get_src()[k as usize] == b'>' {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            k += 1;
        }
        if reuse != 0 {
            buf_bytes(text, &get_src()[name_end as usize..(k + 1) as usize]);
        } else {
            buf_bytes(text, &get_src()[name_end as usize..k as usize]);
            buf_str(text, c", ");
            buf_byte(text, letter);
            buf_str(text, c": Allocator>");
        }
        body = k + 1;
    } else {
        buf_byte(text, b'<');
        buf_byte(text, letter);
        buf_str(text, c": Allocator>");
    }
    let mut replaced: i64 = 0;
    let mut i = body;
    let end = pcx.nodes[item as usize].end;
    while i < end {
        let c = get_src()[i as usize];
        if c == b'/' && i + 1 < end && get_src()[(i + 1) as usize] == b'/' {
            while i < end && get_src()[i as usize] != b'\n' {
                buf_byte(text, get_src()[i as usize]);
                i += 1;
            }
            continue;
        }
        if i + pname.len() as i64 <= end
            && get_src()[i as usize..(i + pname.len() as i64) as usize] == pname
            && !ident_byte(get_src()[(i - 1) as usize])
            && (i + pname.len() as i64 >= end
                || !ident_byte(get_src()[(i + pname.len() as i64) as usize])) {
            if reuse != 0 {
                buf_bytes(text, sym_text(reuse, pcx));
            } else {
                buf_byte(text, letter);
            }
            replaced += 1;
            i += pname.len() as i64;
            continue;
        }
        buf_byte(text, c);
        i += 1;
    }
    if replaced > 0 {
        // (0.28.0) with the import the bound needs, in the same fix: the
        // text from the import's place to the item's name is kept
        let import_at = if reuse == 0 { allocator_use_at(name_end, pcx) } else { -1 };
        if import_at >= 0 {
            let whole = buf_new();
            buf_str(whole, c"use std::alloc::Allocator;\n");
            if !use_line_at(import_at) {
                buf_byte(whole, b'\n');
            }
            buf_bytes(whole, &get_src()[import_at as usize..name_end as usize]);
            buf_bytes(whole, buf_slice(text));
            err_fix(import_at, end, buf_slice(whole), pcx);
        } else {
            err_fix(name_end, end, buf_slice(text), pcx);
        }
    }
}

// ---- Allocator last ----

// alloc.last: a function named `*_in` takes its allocator last (Rust's
// allocator API, `Vec::with_capacity_in(cap, alloc)`); an allocator
// parameter before its last one is the error. No fix: `volec refactor
// signature` moves it, with every call.
fn check_alloc_last(pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        let node = pcx.fns[f as usize].node;
        if pcx.fns[f as usize].tmpl != 0 || pcx.nodes[node as usize].kind != NodeKind::Fn
            || (pcx.nodes[node as usize].p & FN_DEFAULT_COPY) != 0 {
            continue;
        }
        let name = sym_text(pcx.nodes[node as usize].a, pcx);
        if name.len() < 4 || !name.ends_with(b"_in") {
            continue;
        }
        let count = pcx.nodes[node as usize].count;
        let mut at: i64 = -1;
        for i in 0..count {
            if is_allocator_param_type(pcx.nodes[child(node, i, pcx) as usize].b, node,
                pcx.fns[f as usize].module, pcx) {
                at = i;
            }
        }
        if at < 0 || at == count - 1 {
            continue;
        }
        let p = child(node, at, pcx);
        let saved = pcx.err_kind;
        pcx.err_kind = c"alloc.last";
        err_begin(pcx.nodes[p as usize].start, pcx);
        err_str(c"'", pcx);
        err_sym(pcx.nodes[node as usize].a, pcx);
        err_str(c"' takes its allocator '", pcx);
        err_sym(pcx.nodes[p as usize].a, pcx);
        err_str(c"' before its last parameter: an `_in` function takes it last", pcx);
        err_help(c"move the allocator to the end of the parameters (Rust's `with_capacity_in(cap, alloc)`), and at every call: `volec refactor signature` does both", pcx);
        err_try_tool(b"refactor signature --help", false, pcx);
        err_end_soft(pcx);
        pcx.err_kind = saved;
    }
}

// Whether parameter type node n of function node fnode is an allocator:
// a type parameter (of the function or its impl) bounded by Allocator, or
// a type that is one.
fn is_allocator_param_type(n: i64, fnode: i64, module: i64, pcx: &mut Ctx<Comp>) -> bool {
    if n == 0 || pcx.nodes[n as usize].kind != NodeKind::TyName
        || pcx.nodes[n as usize].count != 0
        || pcx.nodes[n as usize].g != 0 {
        return false;
    }
    let g = pcx.nodes[fnode as usize].g;
    if g != 0 {
        for i in 0..pcx.nodes[g as usize].count {
            let p = child(g, i, pcx);
            if pcx.nodes[p as usize].a == pcx.nodes[n as usize].a {
                return is_allocator_param(p, pcx);
            }
        }
    }
    let name = sym_text(pcx.nodes[n as usize].a, pcx);
    if name == b"Self" || name.len() == 1 {
        return false;
    }
    is_allocator_type(resolve_quietly(n, module, pcx), pcx)
}

// ---- No constructor without `_in` (rule 1) ----

// alloc.no_in: call n (a Call or MethodCall) of `name`, which std does
// not have, when `name_in` is what it has (`Vec::new()`, `collect()`,
// `format(x)`, `s.to_string()`): std has no function that allocates from
// an allocator nobody passed. `what` is the call as named (`Vec::new`).
// The fix names the `_in` form and passes, last, the one allocator value
// in scope (`gpa` first); none when there is none, or several.
pub fn no_in_error(n: i64, name: i64, what: &[u8], pcx: &mut Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"alloc.no_in";
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_fmt(
        { let what = str::from_utf8(what).unwrap();
            format_args(
                "'{what}' allocates from nothing: pass the allocator, last, to '{what}_in'") },
        pcx);
    let a = allocator_in_scope(pcx);
    if a > 0 {
        err_help_fmt(format_args("this function's `{}` is the allocator to pass",
            str::from_utf8(sym_text(a, pcx)).unwrap()), pcx);
        in_fix(n, name, sym_text(a, pcx), pcx);
        // (0.28.0: the fix exists only with one allocator in scope; without
        // one, `fix --only alloc` left the same error)
        err_try_tool(b"fix --only alloc", true, pcx);
    } else if a < 0 {
        err_help(c"several allocators are in scope: pass the one it allocates from", pcx);
    } else {
        crate::front::ambient::gpa_param_help(
            if pcx.cur_fn >= 0 { pcx.fns[pcx.cur_fn as usize].node } else { -1 },
            if pcx.cur_fn >= 0 { sym_text(pcx.fns[pcx.cur_fn as usize].display, pcx) }
            else { b"" }, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    err_jump(pcx)
}

// The name of the one local or parameter in scope whose type is an
// allocator (one named `gpa` first); 0: none; -1: several.
fn allocator_in_scope(pcx: &mut Ctx<Comp>) -> i64 {
    let gpa = intern_c(c"gpa", pcx);
    let mut found: i64 = 0;
    // UNSAFE: ENV and LOCALS are the checker's raw tables of locals.
    // SAFETY: i < ENV.count; ENV's entries are local ids.
    unsafe {
        let mut i = pcx.env.len() as i64 - 1;
        while i >= 0 {
            let id = (pcx.env[i as usize]);
            let t = pcx.locals[id as usize].ty;
            if is_allocator_type(t, pcx) || is_allocator_type(pointee_of(t, pcx), pcx) {
                if pcx.locals[id as usize].name == gpa {
                    return gpa;
                }
                if found != 0 && found != pcx.locals[id as usize].name {
                    found = -1;
                } else if found == 0 {
                    found = pcx.locals[id as usize].name;
                }
            }
            i -= 1;
        }
    }
    found
}

fn pointee_of(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr { pcx.types[t as usize].a } else { 0 }
}

// The fix of alloc.no_in at node n (the call, or its callee's name):
// `name` (the last place it is written before a `(`) becomes `name_in`,
// and `alloc` the call's last argument.
fn in_fix(n: i64, name: i64, alloc: &[u8], pcx: &mut Ctx<Comp>) {
    let start = pcx.nodes[n as usize].start;
    let word = sym_text(name, pcx);
    let w = word.len() as i64;
    let mut at: i64 = -1;
    let mut i = start;
    while i < pcx.nodes[n as usize].end && i + w < get_src().len() as i64 {
        if get_src()[i as usize] == b'"' {
            // (0.28.0: a string before the name, `"a".to_string()`: to
            // its closing quote; a raw one is refused)
            if i > 0 && get_src()[(i - 1) as usize] == b'#' {
                break;
            }
            i += 1;
            while i < pcx.nodes[n as usize].end && get_src()[i as usize] != b'"' {
                if get_src()[i as usize] == b'\\' {
                    i += 1;
                }
                i += 1;
            }
            i += 1;
            continue;
        }
        if &get_src()[i as usize..(i + w) as usize] == word
            && (i == start || !ident_byte(get_src()[(i - 1) as usize]))
            && (get_src()[(i + w) as usize] == b'(' || get_src()[(i + w) as usize] == b':') {
            at = i;
        }
        i += 1;
    }
    if at < 0 {
        return;
    }
    let mut open = at + w;
    while open < get_src().len() as i64 && get_src()[open as usize] != b'(' {
        if get_src()[open as usize] == b';' || get_src()[open as usize] == b'{' {
            return;
        }
        open += 1;
    }
    // its `)`
    let mut depth: i64 = 0;
    let mut close = open;
    while close < get_src().len() as i64 {
        let c = get_src()[close as usize];
        if c == b'"' {
            // (a string: to its closing quote; a raw one is refused)
            if close > 0 && get_src()[(close - 1) as usize] == b'#' {
                return;
            }
            close += 1;
            while close < get_src().len() as i64 && get_src()[close as usize] != b'"' {
                if get_src()[close as usize] == b'\\' {
                    close += 1;
                }
                close += 1;
            }
            close += 1;
            continue;
        }
        if c == b'\'' {
            // (a byte: `'x'`, `'\n'`; anything else is refused)
            if close + 2 < get_src().len() as i64 && get_src()[(close + 2) as usize] == b'\'' {
                close += 3;
                continue;
            }
            if close + 3 < get_src().len() as i64 && get_src()[(close + 1) as usize] == b'\\'
                && get_src()[(close + 3) as usize] == b'\'' {
                close += 4;
                continue;
            }
            return;
        }
        if c == b'(' || c == b'[' {
            depth += 1;
        } else if c == b')' || c == b']' {
            depth -= 1;
            if depth == 0 {
                break;
            }
        }
        close += 1;
    }
    if close >= get_src().len() as i64 {
        return;
    }
    let mut blank = true;
    for k in open + 1..close {
        if get_src()[k as usize] != b' ' && get_src()[k as usize] != b'\n'
            && get_src()[k as usize] != b'\t' {
            blank = false;
        }
    }
    let b = buf_new();
    buf_bytes(b, word);
    buf_str(b, c"_in");
    buf_bytes(b, &get_src()[(at + w) as usize..close as usize]);
    if !blank {
        buf_str(b, c", ");
    }
    buf_bytes(b, alloc);
    buf_byte(b, b')');
    err_fix(at, close + 1, buf_slice(b), pcx);
}

// The symbol of `name_in`, the `_in` form of name.
pub fn in_name(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = buf_new();
    buf_bytes(b, sym_text(name, pcx));
    buf_str(b, c"_in");
    intern(buf_slice(b), pcx)
}
