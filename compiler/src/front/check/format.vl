// Format literals (0.26.2; docs/grammar.md, "Formatting"): a plain string
// literal (a text block and `r"..."` too) is a Rust format string where it
// is the first argument of one of std's format functions (the closed table
// of format_kind): `println("{} {x:>4}", a.b)`, `format_in("{}", v, gpa)`.
// format_call parses it before any argument is typed, so it knows the
// holes and which arguments they take, and makes of the literal and its
// arguments the Interp node an f-string makes (check/interp.vl lowers it):
// its holes the arguments' expressions (or Ident nodes for the names in
// the text, at their positions), so direct_call, the effects, the own pass
// and both IRs see what they see of an f-string.
//
// The grammar is Rust's std::fmt: `{}`, `{0}`, `{name}`, each with an
// optional `:spec`, `{{` and `}}` for braces;
//
//   spec = [[fill]align][sign]['#']['0'][width]['.' precision][type]
//
// align `<` `^` `>`, sign `+` (`-` is accepted and means nothing), width
// and precision an integer, `N$` or `name$`, precision `*` too; type `?`,
// `x?`, `X?`, `x`, `X`, `o`, `b`, `e`, `E`, `p`, and vole's `c` (a u8 as
// its byte). Arguments are positional or named (`name = expr`), each
// evaluated once, left to right; one never used, or one a hole asks and
// the call lacks, is format.args. An expression in a hole is
// format.expr-hole, whose fix moves it to an argument.
//
// When every argument is used once, as a value, in the order written (what
// `fix --only fstring` writes), the holes are the arguments themselves:
// the lowering is the f-string's. Otherwise each argument is first an
// evaluated-only hole (HOLE_EVAL), in order, and the holes that use it
// read its value (HOLE_ALIAS: the `=fK` of that hole).

use std::alloc::Allocator; use crate::base::{
    get_src, buf_byte, buf_bytes, buf_done, buf_fmt, buf_new, buf_slice, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fix, err_fmt, err_help};
use crate::front::ast::{
    FMT_BIN, FMT_CHAR, FMT_EXP, FMT_HEX, FMT_LEFT, FMT_RIGHT, FMT_UPPER, FMT_ZERO, NodeKind, child,
    list_begin, list_end, list_push, new_node,
};
use crate::front::lexer::{add_string, str_at};
use crate::front::modules::within_std;

// Flags of a hole beyond the f-string's (std/fmt.vl's Fmt has the same
// values): `^`, `+`, `#`, `o`; FMT_PTR (`p`) is the checker's: the hole is
// written as an address, `0x..`.
pub const FMT_CENTER: i64 = 1024;
pub const FMT_PLUS: i64 = 2048;
pub const FMT_ALT: i64 = 4096;
pub const FMT_OCT: i64 = 8192;
pub const FMT_PTR: i64 = 16384;
// (0.27.2) The checker's too: std2's `{:?}` of an array writes its slice
// (`&x[..]`), [T; N] having no impl of its own. RULE: F16.4
pub const FMT_AS_SLICE: i64 = 32768;
// (0.27.2.1) `-`: std2's Formatter::sign_minus (its flag bit 2).
pub const FMT_MINUS: i64 = 65536;

// An InterpHole's b: HOLE_DEBUG (`?`), its fill byte (0: a space) at
// HOLE_FILL, HOLE_EVAL (an argument only evaluated, not written), and
// the hole it reads (+ 1) at HOLE_ALIAS.
pub const HOLE_DEBUG: i64 = 1;
const HOLE_FILL: i64 = 2;
pub const HOLE_EVAL: i64 = 512;
const HOLE_ALIAS: i64 = 1024;

pub fn hole_debug(h: i64, pcx: &Ctx<Comp>) -> bool {
    (pcx.nodes[h as usize].b & HOLE_DEBUG) != 0
}

pub fn hole_fill(h: i64, pcx: &Ctx<Comp>) -> i64 {
    (pcx.nodes[h as usize].b / HOLE_FILL) & 255
}

pub fn hole_eval_only(h: i64, pcx: &Ctx<Comp>) -> bool {
    (pcx.nodes[h as usize].b & HOLE_EVAL) != 0
}

// The hole (its index among the Interp's holes) hole h reads, -1: none.
pub fn hole_alias(h: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.nodes[h as usize].b / HOLE_ALIAS - 1
}

// The kinds of format function.
const FK_PRINT: i64 = 1;
const FK_FORMAT_IN: i64 = 2;
const FK_PANIC: i64 = 3;
const FK_ASSERT: i64 = 4;
const FK_DEBUG_ASSERT: i64 = 5;
const FK_METHOD: i64 = 6;

// (0.27.2) std2's fmt::write and writeln: the destination, then the format
// literal (F16.2).
const FK_WRITE: i64 = 7;

// Which format function f is (its template; `method`: called as one): 0
// for none. print, println, eprint, eprintln, format_args; format_in;
// panic; assert, debug_assert; and the methods Buf::push_fmt,
// String::push_fmt, Fmt::write.
fn format_kind(f: i64, method: bool, pcx: &Ctx<Comp>) -> i64 {
    let info = pcx.fns[f as usize];
    if pcx.std_module < 0 || !within_std(info.module, pcx) || info.node <= 0 {
        return 0;
    }
    let name = sym_text(pcx.nodes[info.node as usize].a, pcx);
    if method {
        let owner = pcx.nodes[info.node as usize].d;
        let ty = if owner > 0 { sym_text(owner, pcx) } else { b"" };
        if name == b"push_fmt" && (ty == b"Buf" || ty == b"String")
            || name == b"write" && ty == b"Fmt" {
            return FK_METHOD;
        }
        return 0;
    }
    if name == b"print" || name == b"println" || name == b"eprint" || name == b"eprintln"
        || name == b"format_args" {
        FK_PRINT
    } else if (name == b"write" || name == b"writeln") && crate::front::known::on_std2(pcx)
        && sym_text(pcx.modules[info.module as usize].name, pcx) == "fmt".as_bytes() {
        // (0.28.0: std::fmt's alone: std::fs::write, a module's own `write`
        // called by its path, `msl::write(&m, a, out, refl)`, are functions
        // like any, not the format call they were read as by the name)
        // RULE: F16.1 (std2's fmt::write, writeln: the literal is the second)
        FK_WRITE
    } else if name == b"format_in" {
        FK_FORMAT_IN
    } else if name == b"panic_str" || name == b"panic" && crate::front::known::on_std2(pcx) {
        FK_PANIC
    } else if name == b"assert" {
        FK_ASSERT
    } else if name == b"debug_assert" {
        FK_DEBUG_ASSERT
    } else {
        0
    }
}

// Whether node n is a plain string literal (`"..."`, a text block,
// `r"..."`): not an f-string, a C string, nor include_str's text.
pub fn is_format_literal(n: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[n as usize].kind != NodeKind::Str || pcx.nodes[n as usize].b != 0
        || pcx.nodes[n as usize].end <= pcx.nodes[n as usize].start {
        return false;
    }
    let c = get_src()[pcx.nodes[n as usize].start as usize];
    c == b'"' || c == b'r'
}

// The std function `name` of std's root and its modules (a template), -1:
// none.
fn std_fn(name: &[u8], pcx: &Ctx<Comp>) -> i64 {
    for f in 0..pcx.fns.len() as i64 {
        let info = pcx.fns[f as usize];
        if info.tmpl == 0 && info.node > 0 && within_std(info.module, pcx)
            && sym_text(pcx.nodes[info.node as usize].a, pcx) == name {
            return f;
        }
    }
    -1
}

// Call n of function f (its named arguments not yet put in order;
// `method`: a method call, its receiver apart): when f is a format
// function and its format argument is a literal, the literal and its
// arguments are made one Interp node, in its place (format_in's allocator
// stays last). `panic` and `assert` with holes call std's __panic_fmt and
// __assert_fmt, which format into 256 bytes on the stack (decision 5);
// that function is returned, else f. A format argument that is not a
// literal is a plain value (`println(s)`); arguments after it are
// format.args.
pub fn format_call(n: i64, f: i64, method: bool, pcx: &mut Ctx<Comp>) -> i64 {
    if f < 0 {
        return f;
    }
    let k = format_kind(f, method, pcx);
    if k == 0 {
        return f;
    }
    let at: i64 = if k == FK_ASSERT || k == FK_DEBUG_ASSERT || k == FK_WRITE { 1 } else { 0 };
    // (the positional arguments; vole's named ones, `at: ..`, are apart)
    let mut count: i64 = 0;
    while count < pcx.nodes[n as usize].count && !vole_named(child(n, count, pcx), pcx) {
        count += 1;
    }
    if count <= at {
        return f;
    }
    let lit = child(n, at, pcx);
    let last = if k == FK_FORMAT_IN { count - 1 } else { count };
    // (panic and assert: what follows a message that is no literal, or has
    // no brace, is their own `at`)
    let own_at = k >= FK_PANIC && k <= FK_DEBUG_ASSERT;
    if !is_format_literal(lit, pcx) {
        if !own_at && last > at + 1 && pcx.nodes[lit as usize].kind != NodeKind::Interp {
            args_error(pcx.nodes[child(n, at + 1, pcx) as usize].start, b"a format string is a literal: this argument has no hole to go to", b"write the text where the format string goes, '\"{}\"', or format it first: 'format_args(\"{}\", x)'", pcx);
            // (the arguments left out: no error of the call's arity)
            let mark = list_begin(pcx);
            for i in 0..at + 1 {
                list_push(child(n, i, pcx), pcx);
            }
            for i in last..pcx.nodes[n as usize].count {
                list_push(child(n, i, pcx), pcx);
            }
            list_end(n, mark, pcx);
        }
        return f;
    }
    if own_at && !has_brace(lit, pcx) {
        return f;
    }
    // (after an error, the literal alone: no error of the call's arity)
    let mut made = make_format(lit, n, at + 1, last, pcx);
    if made == 0 {
        made = lit;
    }
    // The call's arguments: those before the literal, the Interp, the
    // allocator, vole's named ones.
    let mark = list_begin(pcx);
    for i in 0..at {
        list_push(child(n, i, pcx), pcx);
    }
    list_push(made, pcx);
    for i in last..pcx.nodes[n as usize].count {
        list_push(child(n, i, pcx), pcx);
    }
    list_end(n, mark, pcx);
    if pcx.nodes[made as usize].kind != NodeKind::Interp {
        return f;
    }
    // RULE: F16.3 (on std2, panic's message is written in place:
    // interp::direct_body_std2)
    if k == FK_PANIC && crate::front::known::on_std2(pcx) {
        return f;
    }
    if k == FK_PANIC || k == FK_ASSERT || k == FK_DEBUG_ASSERT {
        return panic_call(n, f, k, pcx);
    }
    f
}

// Whether argument a is one of vole's named arguments, `at: x`.
fn vole_named(a: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[a as usize].kind == NodeKind::NamedArg && pcx.nodes[a as usize].c == 0
}

// panic or assert call n (k) whose message has holes: std::__panic_fmt
// (message, at) or std::__assert_fmt(ok, message, at), `at` the call's
// FILE:LINE:COL as panic_site gives panic's; debug_assert without
// --debug-contracts loses its message (it is not evaluated: nothing is).
fn panic_call(n: i64, f: i64, k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if k == FK_DEBUG_ASSERT && !pcx.debug_contracts {
        let mark = list_begin(pcx);
        list_push(child(n, 0, pcx), pcx);
        list_end(n, mark, pcx);
        return f;
    }
    if pcx.panic_fmt == -2 {
        pcx.panic_fmt = std_fn(b"__panic_fmt", pcx);
        pcx.assert_fmt = std_fn(b"__assert_fmt", pcx);
    }
    let target = if k == FK_PANIC { pcx.panic_fmt } else { pcx.assert_fmt };
    if target < 0 {
        return f;
    }
    let in_std = pcx.cur_fn >= 0 && within_std(pcx.fns[pcx.cur_fn as usize].module, pcx);
    let bare = pcx.nodes[n as usize].count == (if k == FK_PANIC { 1 } else { 2 });
    if !in_std && !pcx.no_positions && bare {
        let b = buf_new();
        crate::front::contracts::checks::put_position(b, pcx.nodes[n as usize].start, pcx);
        let s = new_node(NodeKind::Str, pcx.nodes[n as usize].start, pcx.nodes[n as usize].start,
            pcx);
        pcx.nodes[s as usize].a = add_string(buf_slice(b));
        let mark = list_begin(pcx);
        for i in 0..pcx.nodes[n as usize].count {
            list_push(child(n, i, pcx), pcx);
        }
        list_push(s, pcx);
        list_end(n, mark, pcx);
    }
    target
}

// (0.26.2) A contract's message, `else "len {}", v.len()` (front/parser/
// clauses.vl): literal lit and the argument nodes SCRATCH-free in `args`
// (a node whose list they are, 0: none), made an Interp (or a Str); 0 when
// the literal has an error (reported).
pub fn format_message(lit: i64, args: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !is_format_literal(lit, pcx) {
        return lit;
    }
    let made = make_format(lit, args, 0, if args == 0 { 0 } else { pcx.nodes[args as usize].count },
        pcx);
    if made == 0 { lit } else { made }
}

// ---- The literal ----

// What a hole names: its value, its width, its precision.
const R_NONE: i64 = 0;
// the next positional argument (`{}`), argument N (`{N}`, `N$`), a name
// (`{x}`, `x$`), `.*`
const R_NEXT: i64 = 1;
const R_INDEX: i64 = 2;
const R_NAME: i64 = 3;
const R_STAR: i64 = 4;
// an integer constant (a width or a precision)
const R_INT: i64 = 5;

// A parsed hole: its value's reference, its spec, where it is.
#[derive(Clone, Copy)] struct Hole {
    kind: i64, value: i64, pos: i64, end: i64,
    fill: i64, flags: i64, debug: bool,
    wkind: i64, wvalue: i64, pkind: i64, pvalue: i64,
    // (a width's or precision's `name$`: where the name is)
    wpos: i64, wend: i64, ppos: i64, pend: i64,
}

// The texts and holes of a literal, in order: `texts[i]` (a string id, -1
// for none) comes before hole i; one more text ends it.
struct Parsed<A: Allocator> {
    texts: Vec<i64, A>, holes: Vec<Hole, A>, ok: bool, braces: bool,
}

// The literal lit of call n, its arguments n's children first..last: an
// Interp node (a Str when it has no hole: the text, `{{` as `{`), 0 after
// an error. n may be a node holding the arguments in its list (a
// contract's message) or 0.
fn make_format(lit: i64, n: i64, first: i64, last: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let s = str_at(pcx.nodes[lit as usize].a);
    // (no brace at all: the literal as it is, the common case)
    if !has_brace(lit, pcx) {
        if last > first {
            args_error(pcx.nodes[child(n, first, pcx) as usize].start,
                b"this argument is never used: the format string has no hole",
                b"write a hole for it, '{}'", pcx);
            return 0;
        }
        return lit;
    }
    let map = raw_map(lit, pcx);
    let mut p = parse(lit, s, &map, pcx);
    if !p.ok {
        return 0;
    }
    let made = build(lit, n, first, last, &mut p, &map, pcx);
    made
}

// Whether literal lit's text has a brace (else it is its own text).
fn has_brace(lit: i64, pcx: &Ctx<Comp>) -> bool {
    let s = str_at(pcx.nodes[lit as usize].a);
    for i in 0..s.len() {
        if s[i] == b'{' || s[i] == b'}' {
            return true;
        }
    }
    false
}

// The raw position (in SRC) of each byte of literal lit's text, and of its
// end: escapes read as the lexer reads them, a text block's indentation
// skipped. Positions only (the tools' `{x}`), so a near one will do.
fn raw_map(lit: i64, pcx: &Ctx<Comp>) -> Vec<i64, Comp> {
    let s = str_at(pcx.nodes[lit as usize].a);
    let mut map: Vec<i64, Comp> = Vec::new_in(Comp {});
    let start = pcx.nodes[lit as usize].start;
    let end = pcx.nodes[lit as usize].end;
    let mut raw = false;
    let mut i = start;
    if get_src()[i as usize] == b'r' {
        raw = true;
        i += 1;
        while i < end && get_src()[i as usize] == b'#' {
            i += 1;
        }
    }
    // (past the opening quote, or a text block's `"""` and its line)
    if i + 2 < end && get_src()[i as usize] == b'"' && get_src()[(i + 1) as usize] == b'"'
        && get_src()[(i + 2) as usize] == b'"' {
        i += 3;
        while i < end && get_src()[i as usize] != b'\n' {
            i += 1;
        }
        i += 1;
    } else {
        i += 1;
    }
    let mut j: i64 = 0;
    while j < s.len() as i64 {
        if i >= end {
            map.push(end);
            j += 1;
            continue;
        }
        if !raw && get_src()[i as usize] == b'\\' && i + 1 < end {
            let e = get_src()[(i + 1) as usize];
            map.push(i);
            if e == b'\n' {
                // (a line continuation: no byte)
                map.pop();
                i += 2;
                while i < end
                    && (get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\t'
                        || get_src()[i as usize] == b'\n') {
                    i += 1;
                }
                continue;
            }
            if e == b'x' {
                i += 4;
            } else if e == b'u' {
                let mut k = i + 2;
                while k < end && get_src()[k as usize] != b'}' {
                    k += 1;
                }
                // (its UTF-8 bytes, all at the escape)
                let mut cp: i64 = 0;
                for q in i + 3..k {
                    cp = cp * 16 + hex_digit(get_src()[q as usize]);
                }
                let len: i64 = if cp < 128 { 1 } else if cp < 2048 { 2 } else if cp < 65536 { 3 }
                    else { 4 };
                for _ in 1..len {
                    map.push(i);
                }
                j += len - 1;
                i = k + 1;
            } else {
                i += 2;
            }
            j += 1;
            continue;
        }
        if get_src()[i as usize] != s[j as usize] {
            // (a text block's indentation, or a CRLF's CR)
            i += 1;
            continue;
        }
        map.push(i);
        i += 1;
        j += 1;
    }
    map.push(if i < end { i } else { end - 1 });
    map
}

fn hex_digit(c: u8) -> i64 {
    if c >= b'0' && c <= b'9' { (c - b'0') as i64 }
    else if c >= b'a' && c <= b'f' { (c - b'a') as i64 + 10 }
    else if c >= b'A' && c <= b'F' { (c - b'A') as i64 + 10 }
    else { 0 }
}

fn is_ident_start(c: u8) -> bool {
    c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c == b'_'
}

fn is_ident_byte(c: u8) -> bool {
    is_ident_start(c) || c >= b'0' && c <= b'9'
}

fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

// The literal's text s parsed into texts and holes (errors reported:
// format.syntax, format.spec, format.expr-hole).
fn parse(lit: i64, s: &[u8], map: &[i64], pcx: &mut Ctx<Comp>) -> Parsed<Comp> {
    let mut p = Parsed {
        texts: Vec::new_in(crate::base::comp::Comp {}),
        holes: Vec::new_in(crate::base::comp::Comp {}), ok: true, braces: false,
    };
    let text = buf_new();
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let c = s[i as usize];
        if c == b'{' && i + 1 < s.len() as i64 && s[(i + 1) as usize] == b'{' {
            buf_byte(text, b'{');
            p.braces = true;
            i += 2;
            continue;
        }
        if c == b'}' && i + 1 < s.len() as i64 && s[(i + 1) as usize] == b'}' {
            buf_byte(text, b'}');
            p.braces = true;
            i += 2;
            continue;
        }
        if c == b'}' {
            syntax_error(lit, map[i as usize], b"unmatched '}' in a format string",
                b"a '}' of the text is written '}}'", pcx);
            p.ok = false;
            return p;
        }
        if c != b'{' {
            buf_byte(text, c);
            i += 1;
            continue;
        }
        // A hole.
        p.texts.push(text_id(text));
        let open = i;
        let mut close = i + 1;
        while close < s.len() as i64 && s[close as usize] != b'}' && s[close as usize] != b'{' {
            close += 1;
        }
        if close >= s.len() as i64 || s[close as usize] == b'{' {
            // (an expression with braces or strings, or none closed)
            let e = expr_end(s, i + 1);
            if e < s.len() as i64 && e > i + 1 {
                expr_hole(lit, s, map, open, e, pcx);
            } else {
                syntax_error(lit, map[open as usize],
                    b"a hole of the format string is not closed: expected '}'",
                    b"a '{' of the text is written '{{'", pcx);
            }
            p.ok = false;
            return p;
        }
        let mut h = Hole {
            kind: R_NEXT, value: 0, pos: map[(open + 1) as usize], end: map[close as usize],
            fill: 0, flags: 0, debug: false, wkind: R_NONE, wvalue: 0, pkind: R_NONE, pvalue: -1,
            wpos: 0, wend: 0, ppos: 0, pend: 0,
        };
        let mut k = i + 1;
        if k < close && is_digit(s[k as usize]) {
            let mut v: i64 = 0;
            while k < close && is_digit(s[k as usize]) {
                v = v * 10 + (s[k as usize] - b'0') as i64;
                k += 1;
            }
            h.kind = R_INDEX;
            h.value = v;
        } else if k < close && is_ident_start(s[k as usize]) {
            let from = k;
            while k < close && is_ident_byte(s[k as usize]) {
                k += 1;
            }
            h.kind = R_NAME;
            h.value = intern(&s[from as usize..k as usize], pcx);
            h.pos = map[from as usize];
            h.end = map[k as usize];
        }
        let arg_end = k;
        while k < close && s[k as usize] == b' ' {
            k += 1;
        }
        // (Rust's: `{ x }`, `{a b}` are no holes but text whose braces are
        // not doubled)
        if k < close && s[k as usize] != b':' && k > arg_end
            && (arg_end == i + 1 || is_ident_start(s[k as usize]) || is_digit(s[k as usize])) {
            syntax_error(lit, map[open as usize],
                b"a hole of the format string is not closed: expected '}'",
                b"a '{' of the text is written '{{'", pcx);
            p.ok = false;
            return p;
        }
        if k < close && s[k as usize] != b':'
            || k < close && s[k as usize] == b':' && k + 1 < close && s[(k + 1) as usize] == b':' {
            // `{a.b}`, `{f(x)}`, `{a::b}`
            expr_hole(lit, s, map, open, expr_end(s, i + 1), pcx);
            p.ok = false;
            return p;
        }
        if k < close && s[k as usize] == b':' {
            if !parse_spec(lit, s, map, k + 1, close, &mut h, pcx) {
                p.ok = false;
                return p;
            }
        }
        p.holes.push(h);
        i = close + 1;
    }
    p.texts.push(text_id(text));
    p
}

// The text gathered so far, as a string id (-1 when empty), and cleared.
fn text_id(b: i64) -> i64 {
    let t = buf_slice(b);
    let id: i64 = if t.len() > 0 { add_string(t) } else { -1 };
    crate::base::buf_clear(b);
    id
}

// The end of an expression hole's text starting at s[k]: the `}` closing
// it at depth 0 (brackets and strings skipped), or s.len.
fn expr_end(s: &[u8], k: i64) -> i64 {
    let mut depth: i64 = 0;
    let mut i = k;
    while i < s.len() as i64 {
        let c = s[i as usize];
        if c == b'"' {
            i += 1;
            while i < s.len() as i64 && s[i as usize] != b'"' {
                if s[i as usize] == b'\\' {
                    i += 1;
                }
                i += 1;
            }
        } else if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' {
            depth -= 1;
        } else if c == b'}' {
            if depth == 0 {
                return i;
            }
            depth -= 1;
        }
        i += 1;
    }
    s.len() as i64
}

// The spec s[from..to] of hole h, into its fields; false after an error
// (format.spec).
fn parse_spec(lit: i64, s: &[u8], map: &[i64], from: i64, to: i64, h: &mut Hole,
    pcx: &mut Ctx<Comp>) -> bool {
    let mut i = from;
    let spec = &s[from as usize..to as usize];
    // [[fill]align]
    if i + 1 < to
        && (s[(i + 1) as usize] == b'<' || s[(i + 1) as usize] == b'^'
            || s[(i + 1) as usize] == b'>') {
        if s[i as usize] >= 128 {
            spec_error(lit, map[i as usize], spec, b"a fill is one ASCII character in this release",
                pcx);
            return false;
        }
        h.fill = s[i as usize] as i64;
        i += 1;
    }
    if i < to && (s[i as usize] == b'<' || s[i as usize] == b'^' || s[i as usize] == b'>') {
        h.flags |= if s[i as usize] == b'<' { FMT_LEFT } else if s[i as usize] == b'>' { FMT_RIGHT }
            else { FMT_CENTER };
        i += 1;
    }
    if i < to && (s[i as usize] == b'+' || s[i as usize] == b'-') {
        if s[i as usize] == b'+' {
            h.flags |= FMT_PLUS;
        } else {
            h.flags |= FMT_MINUS;
        }
        i += 1;
    }
    if i < to && s[i as usize] == b'#' {
        h.flags |= FMT_ALT;
        i += 1;
    }
    if i < to && s[i as usize] == b'0' && !(i + 1 < to && s[(i + 1) as usize] == b'$') {
        h.flags |= FMT_ZERO;
        i += 1;
    }
    // width: N, N$, name$
    let w = count(s, i, to, pcx);
    if w.kind == R_INT || w.kind == R_INDEX || w.kind == R_NAME {
        if w.kind == R_INT && w.value > 65535 {
            spec_error(lit, map[i as usize], spec, b"a format width is at most 65535", pcx);
            return false;
        }
        h.wkind = w.kind;
        h.wvalue = w.value;
        h.wpos = map[i as usize];
        h.wend = map[(w.end - 1) as usize];
        i = w.end;
    }
    if i < to && s[i as usize] == b'.' {
        i += 1;
        if i < to && s[i as usize] == b'*' {
            h.pkind = R_STAR;
            i += 1;
        } else {
            let pr = count(s, i, to, pcx);
            if pr.kind == R_NONE {
                spec_error(lit, map[i as usize], spec,
                    b"expected the precision after '.': digits, 'N$', 'name$' or '*'", pcx);
                return false;
            }
            if pr.kind == R_INT && pr.value > 65535 {
                spec_error(lit, map[i as usize], spec, b"a format precision is at most 65535", pcx);
                return false;
            }
            h.pkind = pr.kind;
            h.pvalue = pr.value;
            h.ppos = map[i as usize];
            h.pend = map[(pr.end - 1) as usize];
            i = pr.end;
        }
    }
    // type
    let rest = &s[i as usize..to as usize];
    if rest == b"" {
    } else if rest == b"?" {
        h.debug = true;
    } else if rest == b"x?" {
        h.debug = true;
        h.flags |= FMT_HEX;
    } else if rest == b"X?" {
        h.debug = true;
        h.flags |= FMT_HEX | FMT_UPPER;
    } else if rest == b"x" {
        h.flags |= FMT_HEX;
    } else if rest == b"X" {
        h.flags |= FMT_HEX | FMT_UPPER;
    } else if rest == b"o" {
        h.flags |= FMT_OCT;
    } else if rest == b"b" {
        h.flags |= FMT_BIN;
    } else if rest == b"e" {
        h.flags |= FMT_EXP;
    } else if rest == b"E" {
        h.flags |= FMT_EXP | FMT_UPPER;
    } else if rest == b"p" {
        h.flags |= FMT_PTR;
    } else if rest == b"c" {
        h.flags |= FMT_CHAR;
    } else {
        let b = buf_new();
        if (h.flags & FMT_ALT) != 0 && rest == b"?" {
            buf_fmt(b,
                format_args("'{{:#?}}', Debug written over several lines, is not in this release"));
        } else {
            buf_fmt(b,
                { let rest = str::from_utf8(rest).unwrap();
                    format_args("unknown format trait '{rest}'") });
        }
        spec_error(lit, map[i as usize], spec, buf_slice(b), pcx);
        return false;
    }
    // (0.27.2: std2's Formatter carries `#`, F16.3)
    if (h.flags & FMT_ALT) != 0 && h.debug && !crate::front::known::on_std2(pcx) {
        spec_error(lit, map[from as usize], spec,
            b"'{:#?}', Debug written over several lines, is not in this release", pcx);
        return false;
    }
    true
}

// A width or precision at s[i..to]: R_INT (`8`), R_INDEX (`1$`), R_NAME
// (`w$`) or R_NONE, and where it ends.
#[derive(Clone, Copy)] struct Count { kind: i64, value: i64, end: i64 }

fn count(s: &[u8], i: i64, to: i64, pcx: &mut Ctx<Comp>) -> Count {
    if i < to && is_digit(s[i as usize]) {
        let mut k = i;
        let mut v: i64 = 0;
        while k < to && is_digit(s[k as usize]) {
            v = v * 10 + (s[k as usize] - b'0') as i64;
            k += 1;
        }
        if k < to && s[k as usize] == b'$' {
            return Count { kind: R_INDEX, value: v, end: k + 1 };
        }
        return Count { kind: R_INT, value: v, end: k };
    }
    if i < to && is_ident_start(s[i as usize]) {
        let mut k = i;
        while k < to && is_ident_byte(s[k as usize]) {
            k += 1;
        }
        if k < to && s[k as usize] == b'$' {
            return Count {
                kind: R_NAME, value: intern(&s[i as usize..k as usize], pcx), end: k + 1,
            };
        }
    }
    Count { kind: R_NONE, value: 0, end: i }
}

// ---- The Interp node ----

// The arguments of a format call: n's children first..last, positional
// (P) then named (`name = e`, N).
struct Args<A: Allocator> {
    pos: Vec<i64, A>, named: Vec<i64, A>, uses: Vec<i64, A>, value_uses: Vec<i64, A>,
}

fn build(lit: i64, n: i64, first: i64, last: i64, p: &mut Parsed<Comp>, map: &[i64],
    pcx: &mut Ctx<Comp>) -> i64 {
    let mut a = Args {
        pos: Vec::new_in(crate::base::comp::Comp {}),
        named: Vec::new_in(crate::base::comp::Comp {}),
        uses: Vec::new_in(crate::base::comp::Comp {}),
        value_uses: Vec::new_in(crate::base::comp::Comp {}),
    };
    for i in first..last {
        let arg = child(n, i, pcx);
        if pcx.nodes[arg as usize].kind == NodeKind::NamedArg {
            a.named.push(arg);
        } else {
            a.pos.push(arg);
        }
        a.uses.push(0);
        a.value_uses.push(0);
    }
    if p.holes.len() == 0 {
        if last > first {
            args_error(pcx.nodes[child(n, first, pcx) as usize].start,
                b"this argument is never used: the format string has no hole",
                b"write a hole for it, '{}'", pcx);
            return 0;
        }
        // (only `{{`, `}}`: the text)
        let s = new_node(NodeKind::Str, pcx.nodes[lit as usize].start, pcx.nodes[lit as usize].end,
            pcx);
        pcx.nodes[s as usize].a = if p.texts[0 as usize] >= 0 { p.texts[0 as usize] }
            else { add_string(b"") };
        return s;
    }
    // Each hole's value, width and precision: the argument it takes (an
    // index into the arguments, positional then named), or -1 - sym for a
    // name in scope.
    let np = a.pos.len() as i64;
    let mut next: i64 = 0;
    let mut vals: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut widths: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut precs: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut order: i64 = -1;
    let mut simple = true;
    let mut missing = false;
    for i in 0..p.holes.len() {
        let h = p.holes[i];
        let mut pr: i64 = -2;
        if h.pkind == R_STAR {
            pr = next;
            next += 1;
            missing = missing || pr >= np;
        } else if h.pkind != R_NONE && h.pkind != R_INT {
            pr = resolve_ref(h.pkind, h.pvalue, &mut a, &mut next, pcx);
            missing = missing || h.pkind == R_INDEX && pr >= np;
        }
        let mut w: i64 = -2;
        if h.wkind != R_NONE && h.wkind != R_INT {
            w = resolve_ref(h.wkind, h.wvalue, &mut a, &mut next, pcx);
            missing = missing || h.wkind == R_INDEX && w >= np;
        }
        let v = resolve_ref(h.kind, h.value, &mut a, &mut next, pcx);
        missing = missing || (h.kind == R_NEXT || h.kind == R_INDEX) && v >= np;
        if missing {
            missing_error(lit, p, np, pcx);
            return 0;
        }
        for r in [w, pr] {
            if r >= 0 {
                a.uses[r as usize] = a.uses[r as usize] + 1;
                simple = false;
            }
        }
        if v >= 0 {
            a.uses[v as usize] = a.uses[v as usize] + 1;
            a.value_uses[v as usize] = a.value_uses[v as usize] + 1;
            if v <= order {
                simple = false;
            }
            order = v;
        }
        vals.push(v);
        widths.push(w);
        precs.push(pr);
    }
    for i in 0..a.uses.len() as i64 {
        if a.uses[i as usize] == 0 {
            let arg = if i < np { a.pos[i as usize] } else { a.named[(i - np) as usize] };
            args_error(pcx.nodes[arg as usize].start,
                if i < np { b"this argument is never used: no hole of the format string takes it" }
                else {
                    b"this named argument is never used: no hole of the format string names it"
                },
                b"write a hole for it, '{}', or remove it", pcx);
            return 0;
        }
        if a.value_uses[i as usize] != 1 {
            simple = false;
        }
    }
    // The Interp.
    let interp = new_node(NodeKind::Interp, pcx.nodes[lit as usize].start,
        pcx.nodes[lit as usize].end, pcx);
    let mark = list_begin(pcx);
    let nargs = a.uses.len() as i64;
    if !simple {
        for i in 0..nargs {
            let arg = if i < np { a.pos[i as usize] }
                else { pcx.nodes[a.named[(i - np) as usize] as usize].b };
            let h = new_node(NodeKind::InterpHole, pcx.nodes[arg as usize].start,
                pcx.nodes[arg as usize].end, pcx);
            pcx.nodes[h as usize].a = arg;
            pcx.nodes[h as usize].b = HOLE_EVAL;
            pcx.nodes[h as usize].c = -1;
            pcx.nodes[h as usize].d = -1;
            list_push(h, pcx);
        }
    }
    for i in 0..p.holes.len() as i64 {
        let t = p.texts[i as usize];
        if t >= 0 {
            list_push(text_node(t, lit, pcx), pcx);
        }
        let h = p.holes[i as usize];
        let hole = new_node(NodeKind::InterpHole, h.pos, h.end, pcx);
        let v = vals[i as usize];
        pcx.nodes[hole as usize].b = (if h.debug { HOLE_DEBUG } else { 0 }) + h.fill * HOLE_FILL;
        if v < 0 {
            // a name in scope, at its position in the text
            pcx.nodes[hole as usize].a = name_node(-v - 1, h.pos, h.end, pcx);
        } else if simple {
            pcx.nodes[hole as usize].a = if v < np { a.pos[v as usize] }
                else { pcx.nodes[a.named[(v - np) as usize] as usize].b };
        } else {
            pcx.nodes[hole as usize].a = name_node(hidden_name(v, pcx), h.pos, h.end, pcx);
            pcx.nodes[hole as usize].b += (v + 1) * HOLE_ALIAS;
        }
        pcx.nodes[hole as usize].c = if h.wkind == R_INT { h.wvalue } else { -1 };
        pcx.nodes[hole as usize].d = if h.pkind == R_INT { h.pvalue } else { -1 };
        pcx.nodes[hole as usize].p = h.flags;
        let w = widths[i as usize];
        if w != -2 {
            pcx.nodes[hole as usize].g = if w < 0 { name_node(-w - 1, h.wpos, h.wend, pcx) }
                else { name_node(hidden_name(w, pcx), h.pos, h.end, pcx) };
        }
        let pr = precs[i as usize];
        if pr != -2 {
            pcx.nodes[hole as usize].h = if pr < 0 { name_node(-pr - 1, h.ppos, h.pend, pcx) }
                else { name_node(hidden_name(pr, pcx), h.pos, h.end, pcx) };
        }
        list_push(hole, pcx);
    }
    let t = p.texts[p.holes.len() as i64 as usize];
    if t >= 0 {
        list_push(text_node(t, lit, pcx), pcx);
    }
    list_end(interp, mark, pcx);
    interp
}

// The argument (positional, then named) a reference takes, or -1 - sym for
// a name in scope; -2 for none. `next` counts the `{}` holes.
fn resolve_ref(kind: i64, value: i64, a: &mut Args<Comp>, next: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    if kind == R_NEXT {
        let v = *next;
        *next += 1;
        return v;
    }
    if kind == R_INDEX {
        return value;
    }
    if kind == R_NAME {
        for i in 0..a.named.len() as i64 {
            if pcx.nodes[a.named[i as usize] as usize].a == value {
                return a.pos.len() as i64 + i;
            }
        }
        return -1 - value;
    }
    -2
}

// `=fK`, the hidden local of hole K (check/interp.vl's hidden()).
fn hidden_name(k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = buf_new();
    buf_fmt(b, format_args("=f{k}"));
    intern(buf_slice(b), pcx)
}

fn name_node(sym: i64, start: i64, end: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let id = new_node(NodeKind::Ident, start, end, pcx);
    pcx.nodes[id as usize].a = sym;
    id
}

fn text_node(id: i64, lit: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let s = new_node(NodeKind::Str, pcx.nodes[lit as usize].start, pcx.nodes[lit as usize].end,
        pcx);
    pcx.nodes[s as usize].a = id;
    s
}

// ---- Errors ----

// format.args: more holes take positional arguments than the call has.
fn missing_error(lit: i64, p: &mut Parsed<Comp>, np: i64, pcx: &mut Ctx<Comp>) {
    let mut asked: i64 = 0;
    let mut next: i64 = 0;
    for i in 0..p.holes.len() {
        let h = p.holes[i];
        if h.pkind == R_STAR {
            next += 1;
        }
        if h.kind == R_NEXT {
            next += 1;
        }
        for (k, v) in [(h.kind, h.value), (h.wkind, h.wvalue), (h.pkind, h.pvalue)] {
            if k == R_INDEX && v + 1 > asked {
                asked = v + 1;
            }
        }
    }
    if next > asked {
        asked = next;
    }
    let b = buf_new();
    buf_fmt(b,
        format_args("{asked} positional argument{} in the format string, but the call has {np}",
            if asked == 1 { "" } else { "s" }));
    args_error(pcx.nodes[lit as usize].start, buf_slice(b),
        b"give each '{}' (and '{N}', 'N$', '.*') its argument after the format string", pcx);
}

fn args_error(pos: i64, message: &[u8], help: &[u8], pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"format.args";
    err_begin(pos, pcx);
    err_fmt(str::from_utf8(message).unwrap(), pcx);
    help_text(help, pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

fn help_text(help: &[u8], pcx: &Ctx<Comp>) {
    let h = buf_new();
    buf_bytes(h, help);
    buf_byte(h, 0);
    err_help(buf_slice(h).ptr, pcx);
}

// format.syntax at pos; its fix doubles the literal's braces (its text as
// it printed before 0.26.2).
fn syntax_error(lit: i64, pos: i64, message: &[u8], help: &[u8], pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"format.syntax";
    err_begin(pos, pcx);
    err_fmt(str::from_utf8(message).unwrap(), pcx);
    help_text(help, pcx);
    let raw = &get_src()[
        pcx.nodes[lit as usize].start as usize..pcx.nodes[lit as usize].end as usize];
    let fixed = buf_new();
    for i in 0..raw.len() {
        if raw[i] == b'{' || raw[i] == b'}' {
            buf_byte(fixed, raw[i]);
        }
        buf_byte(fixed, raw[i]);
    }
    err_fix(pcx.nodes[lit as usize].start, pcx.nodes[lit as usize].end, buf_slice(fixed), pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

fn spec_error(lit: i64, pos: i64, spec: &[u8], message: &[u8], pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"format.spec";
    err_begin(pos, pcx);
    err_fmt({
        let spec = str::from_utf8(spec).unwrap();
        { let message = str::from_utf8(message).unwrap();
            format_args("invalid format spec ':{spec}': {message}") }
    }, pcx);
    help_text(b"a spec is [[fill]align][+][#][0][width][.precision][type]: align < ^ >, width and precision N, N$ or name$ (precision also *), type ? x? X? x X o b e E p c: '{x:>8.2}', '{v:?}', '{n:#010x}', '{s:*^9}'", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// format.expr-hole: the hole s[open..close] (`{a.b}`) holds an expression;
// its fix makes it `{}` (its spec kept) and the expression an argument,
// when the call has no other positional argument.
fn expr_hole(lit: i64, s: &[u8], map: &[i64], open: i64, close: i64, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"format.expr-hole";
    let inner = &s[(open + 1) as usize..close as usize];
    let mut colon: i64 = -1;
    let mut depth: i64 = 0;
    for k in 0..inner.len() as i64 {
        let c = inner[k as usize];
        if c == b'(' || c == b'[' {
            depth += 1;
        } else if c == b')' || c == b']' {
            depth -= 1;
        } else if c == b':' && depth == 0 && colon < 0
            && !(k + 1 < inner.len() as i64 && inner[(k + 1) as usize] == b':')
            && !(k > 0 && inner[(k - 1) as usize] == b':') {
            colon = k;
        }
    }
    let expr = if colon >= 0 { &inner[0..colon as usize] } else { inner };
    err_begin(map[(open + 1) as usize], pcx);
    err_fmt({
        let expr = str::from_utf8(expr).unwrap();
        format_args("'{{{expr}}}': a hole of a format string holds a name, not an expression")
    },
        pcx);
    help_text(b"write '{}' and pass the expression after the format string, as Rust does: 'println(\"{} {x}\", a.b)'", pcx);
    // The fix: every expression hole of the literal moved, in order.
    let fixed = fixed_literal(lit, map, pcx);
    if fixed.len() > 0 {
        err_fix(pcx.nodes[lit as usize].start, pcx.nodes[lit as usize].end, fixed, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// Literal lit's source with each expression hole written `{}` (or `{:spec}`)
// and the expressions after it, `"a {} {x}", e`: empty when the literal has
// a `{}` or `{N}` of its own (its arguments would move).
fn fixed_literal(lit: i64, map: &[i64], pcx: &Ctx<Comp>) -> &'static [u8] {
    let s = str_at(pcx.nodes[lit as usize].a);
    let raw = &get_src()[
        pcx.nodes[lit as usize].start as usize..pcx.nodes[lit as usize].end as usize];
    let base = pcx.nodes[lit as usize].start;
    let out = buf_new();
    let exprs = buf_new();
    let mut r: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        if (s[i as usize] == b'{' || s[i as usize] == b'}') && i + 1 < s.len() as i64
            && s[(i + 1) as usize] == s[i as usize] {
            i += 2;
            continue;
        }
        if s[i as usize] != b'{' {
            i += 1;
            continue;
        }
        let close = expr_end(s, i + 1);
        if close >= s.len() as i64 {
            return b"";
        }
        let inner = &s[(i + 1) as usize..close as usize];
        let mut k: i64 = 0;
        while k < inner.len() as i64 && is_ident_byte(inner[k as usize]) {
            k += 1;
        }
        let name_only = k > 0 && is_ident_start(inner[0])
            && (k == inner.len() as i64 || inner[k as usize] == b':'
                && !(k + 1 < inner.len() as i64 && inner[(k + 1) as usize] == b':'));
        if !name_only {
            if inner.len() == 0 || is_digit(inner[0]) || inner[0] == b':' {
                return b"";
            }
            // the expression's raw text, up to its spec
            let mut colon = inner.len() as i64;
            let mut depth: i64 = 0;
            for q in 0..inner.len() as i64 {
                let c = inner[q as usize];
                if c == b'(' || c == b'[' {
                    depth += 1;
                } else if c == b')' || c == b']' {
                    depth -= 1;
                } else if c == b':' && depth == 0 && colon == inner.len() as i64
                    && !(q + 1 < inner.len() as i64 && inner[(q + 1) as usize] == b':')
                    && !(q > 0 && inner[(q - 1) as usize] == b':') {
                    colon = q;
                }
            }
            let rs = map[(i + 1) as usize] - base;
            let re = map[(i + 1 + colon) as usize] - base;
            if rs < r || re < rs || re > raw.len() as i64 {
                return b"";
            }
            buf_bytes(out, &raw[r as usize..rs as usize]);
            r = re;
            buf_bytes(exprs, b", ");
            buf_bytes(exprs, &raw[rs as usize..re as usize]);
        }
        i = close + 1;
    }
    buf_bytes(out, &raw[r as usize..]);
    buf_bytes(out, buf_slice(exprs));
    // (out is not written again: its view lasts the process, buf_done)
    buf_done(out)
}
