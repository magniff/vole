// (0.27.0) The rust edition in the type checker (front/rust): what Rust's
// references add to the checker's 0.19 meanings, which are Rust's already
// (a `&T` is a value, `*r` explicit, receivers and fields reached through
// references). Here: std's Deref and DerefMut (`*x`, a field, a method
// through a type that implements them), Index and IndexMut on a type the
// checker does not index itself (`c[i]` is `*c.index(i)`, `*c.index_mut(i)`
// where it is written). Each rewrites the node in place, as the checker's
// other desugarings do, and the caller checks it again.

use crate::base::{SRC, cstr, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fmt, err_help, err_try_fmt};
use crate::front::ast::{NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::check::calls::method_of;
use crate::front::lexer::Tok;
use crate::front::types::{REF_MUT, REF_SHARED, TyKind, fn_param, ref_to};

// Whether node n is read in the rust edition.
pub fn rust_node(n: i64, pcx: inout Ctx<Comp>) -> bool {
    pcx.edition != 0 && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx)
}

// Whether node n is on the path of the place being written or lent
// exclusively (MUT_PLACE: an assignment's target, `&mut e`'s e), through
// fields, indexes and derefs.
fn on_mut_path(n: i64, pcx: Ctx<Comp>) -> bool {
    var p = pcx.mut_place;
    for _ in 0..1000 {
        if p == 0 {
            return false;
        }
        if p == n {
            return true;
        }
        let k = pcx.nodes[p].kind;
        if k == NodeKind::Unary && pcx.nodes[p].op == Tok::Star {
            p = pcx.nodes[p].b;
        } else if k == NodeKind::Index || k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            p = pcx.nodes[p].a;
        } else {
            return false;
        }
    }
    false
}

// Whether a value of type t has method `name` (its impls', a trait's
// impl's among them).
fn has_method(t: i64, name: *u8, pcx: inout Ctx<Comp>) -> bool {
    t > 0 && (method_of(t, intern_c(name, &pcx), pcx) >= 0
        || crate::front::convert::has_generic_trait_fn(t, intern_c(name, &pcx), &pcx))
}

// `e.name(args)`: a MethodCall node at e's span (args: a list made with
// list_begin's mark, or -1 for none).
fn method_call(e: i64, name: *u8, arg: i64, pcx: inout Ctx<Comp>) -> i64 {
    let call = new_node(NodeKind::MethodCall, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[call].a = e;
    pcx.nodes[call].b = intern_c(name, &pcx);
    let mark = list_begin(pcx);
    if arg != 0 {
        list_push(arg, &pcx);
    }
    list_end(call, mark, &pcx);
    call
}

// `*e` of a type t that is not a pointer (synth_unary): through Deref,
// `*e.deref()` (`*e.deref_mut()` in a place written); true when the
// operand of n was so rewritten.
pub fn deref_operand(n: i64, e: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if !has_method(t, c"deref", &pcx) {
        return false;
    }
    let name = if on_mut_path(n, pcx) && has_method(t, c"deref_mut", &pcx) { c"deref_mut" }
        else { c"deref" };
    pcx.nodes[n].b = method_call(e, name, 0, &pcx);
    true
}

// A field `f` that type t (not a pointer, a struct without that field)
// does not have, at field access n of base e: through Deref, `(*e.deref()).f`
// (deref_mut when written); true when the base was so rewritten.
pub fn deref_field_base(n: i64, e: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if !has_method(t, c"deref", &pcx) {
        return false;
    }
    let name = if on_mut_path(n, pcx) && has_method(t, c"deref_mut", &pcx) { c"deref_mut" }
        else { c"deref" };
    let call = method_call(e, name, 0, &pcx);
    let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[u].op = Tok::Star;
    pcx.nodes[u].b = call;
    pcx.nodes[n].a = u;
    true
}

// A method `name` that the receiver's type t does not have, at method call
// n: through Deref when the target type has it, the receiver
// `*e.deref()` (deref_mut when the method takes `&mut self`); true when
// rewritten.
pub fn deref_receiver(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    if !has_method(t, c"deref", &pcx) {
        return false;
    }
    let target = deref_target(t, &pcx);
    if target <= 0 || method_of(target, name, pcx) < 0 && !has_method(target, c"deref", &pcx) {
        return false;
    }
    let m = method_of(target, name, pcx);
    let mutable = m >= 0 && pcx.fns.len() as i64 > m && fn_param_count(m, pcx) > 0
        && pcx.types[fn_param(m, 0, pcx)].kind == TyKind::Ptr
        && pcx.types[fn_param(m, 0, pcx)].b == REF_MUT;
    let e = pcx.nodes[n].a;
    let call = method_call(e, if mutable && has_method(t, c"deref_mut", &pcx) { c"deref_mut" }
        else { c"deref" }, 0, &pcx);
    let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[u].op = Tok::Star;
    pcx.nodes[u].b = call;
    pcx.nodes[n].a = u;
    true
}

// RULE: F6.2 (the probe's `&` and `&mut` steps) A method `name` that the
// receiver's type t does not have, at method call n, which `&t` or
// `&mut t` has (`impl Tr for &S` with `fn m(self)`): the receiver
// becomes `&e` (`&mut e`); true when rewritten.
pub fn autoref_receiver(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t].kind == TyKind::Ptr {
        return false;
    }
    for mode in [REF_SHARED, REF_MUT] {
        if method_of(ref_to(t, mode, &pcx), name, pcx) >= 0 {
            let e = pcx.nodes[n].a;
            let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
            pcx.nodes[u].op = Tok::Amp;
            pcx.nodes[u].b = e;
            if mode == REF_MUT {
                pcx.nodes[u].p |= crate::front::ast::NODE_REF_MUT;
            }
            pcx.nodes[n].a = u;
            return true;
        }
    }
    false
}

// RULE: F21.2 (Z9's type side) A value of an unsized type, `[T]` or
// `str` written bare (not behind `&`, `*const`, `*mut` or as a generic
// argument), at type node t of a rust-edition position where a value
// goes (`what`: a parameter, a result, a field, a `let`), also as a
// tuple's or an array's element: error type.unsized (rustc E0277).
pub fn check_sized(t: i64, what: *u8, pcx: inout Ctx<Comp>) {
    if t == 0 || !crate::front::rust::rust_at(pcx.nodes[t].start, &pcx) {
        return;
    }
    let k = pcx.nodes[t].kind;
    if k == NodeKind::TyTuple {
        for i in 0..pcx.nodes[t].count {
            check_sized(crate::front::ast::child(t, i, pcx), c"a tuple's element", &pcx);
        }
        return;
    }
    if k == NodeKind::TyArray {
        check_sized(pcx.nodes[t].a, c"an array's element", &pcx);
        return;
    }
    // (as written: a generated item's nodes, spanning its attribute, are not)
    let written = SRC[pcx.nodes[t].start..pcx.nodes[t].end];
    let slice = k == NodeKind::TySlice && written.len() > 0 && written[0] == '[';
    let text = k == NodeKind::TyName && written == "str";
    if !slice && !text {
        return;
    }
    let saved_kind = pcx.err_kind;
    pcx.err_kind = c"type.unsized";
    err_begin(pcx.nodes[t].start, &pcx);
    err_fmt(format_args("the size of '{written}' cannot be known: {} holds its value",
        cstr(what)), pcx);
    err_help(c"a slice or a str is used behind a reference or a pointer", pcx);
    err_try_fmt(format_args("&{written}"), pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved_kind;
}

// The number of parameters of function f (0 <= f < the table's length).
fn fn_param_count(f: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.fns[f].param_count
}

// The type `deref` of t returns a reference to (0: none known).
fn deref_target(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let f = method_of(t, intern_c(c"deref", &pcx), pcx);
    if f < 0 || f >= pcx.fns.len() as i64 {
        return 0;
    }
    let r = pcx.fns[f].ret;
    if r > 0 && pcx.types[r].kind == TyKind::Ptr {
        return pcx.types[r].a;
    }
    0
}

// `c[i]` (index node n) on a type t the checker does not index: through
// Index, `*c.index(i)` (`*c.index_mut(i)` in a place written); n becomes
// that Unary. True when rewritten.
pub fn index_through_trait(n: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.types[t].kind != TyKind::Struct && pcx.types[t].kind != TyKind::Enum
        || !has_method(t, c"index", &pcx) {
        return false;
    }
    let name = if on_mut_path(n, pcx) && has_method(t, c"index_mut", &pcx) { c"index_mut" }
        else { c"index" };
    let call = method_call(pcx.nodes[n].a, name, pcx.nodes[n].b, &pcx);
    pcx.nodes[n].kind = NodeKind::Unary;
    pcx.nodes[n].op = Tok::Star;
    pcx.nodes[n].b = call;
    pcx.nodes[n].a = 0;
    true
}

// (0.27.0) `*e` of a value that is no reference and has no Deref, in the
// rust edition: edition.std_copy. The rust edition runs on MVS std in
// 0.27.0, whose iterators and getters (`iter()`, `get`, `last`, `next`)
// give copies where Rust's give `&T`: the value is used as it is.
pub fn std_copy_error(n: i64, e: i64, t: i64, pcx: inout Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.std_copy";
    crate::base::diag::err_begin(pcx.nodes[n].start, &pcx);
    crate::base::diag::err_str(c"'", pcx);
    let text = crate::base::SRC[pcx.nodes[e].start..pcx.nodes[e].end];
    crate::base::diag::err_fmt(format_args("{text}' is a '"), pcx);
    crate::front::types::err_type(t, pcx);
    crate::base::diag::err_str(c"', not a reference: `*` takes a reference or a raw pointer",
        pcx);
    crate::base::diag::err_help(c"in 0.27.0 the rust edition runs on MVS std, whose iterators and getters (`iter()`, `get`, `last`, `next`) give copies where Rust's give `&T` (0.27.2's std gives references): use the value as it is", pcx);
    crate::base::diag::err_try_fmt(format_args("{text}"), pcx);
    crate::base::diag::err_fix(pcx.nodes[n].start, pcx.nodes[n].end, text, &pcx);
    crate::base::diag::err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// (0.27.1) R5 closed, edition.lenient: in the rust edition a reference is
// not read where its value goes (`f(&a)` for `f(n: i64)`, read: `*`), nor
// a place lent where a reference goes (`f(a)` for `f(n: &i64)`: `&`), as
// 0.19's meanings let MVS do. Rust's spelling is the fix.
pub fn lenient_error(n: i64, read: bool, pcx: inout Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.lenient";
    crate::base::diag::err_begin(pcx.nodes[n].start, &pcx);
    let text = crate::base::SRC[pcx.nodes[n].start..pcx.nodes[n].end];
    let fixed = crate::base::buf_new();
    if read && pcx.nodes[n].kind == NodeKind::Unary && pcx.nodes[n].op == Tok::Amp {
        // (`&a` where `a`'s value goes: `a`)
        let b = pcx.nodes[n].b;
        crate::base::buf_bytes(fixed, crate::base::SRC[pcx.nodes[b].start..pcx.nodes[b].end]);
    } else {
        crate::base::buf_bytes(fixed, if read { "*" } else { "&" });
        crate::base::buf_bytes(fixed, text);
    }
    if read {
        crate::base::diag::err_fmt(format_args("'{text}' is a reference where its value goes"),
            pcx);
        crate::base::diag::err_help(c"Rust reads no reference as its value: dereference it, `*r` (0.27.0 read it so; rustc E0308)", pcx);
    } else {
        crate::base::diag::err_fmt(format_args("'{text}' is a value where a reference goes"), pcx);
        crate::base::diag::err_help(
            c"Rust lends no place unasked: borrow it, `&x` (0.27.0 lent it so; rustc E0308)", pcx);
    }
    crate::base::diag::err_try_fmt(format_args("{}", crate::base::buf_slice(fixed)), pcx);
    crate::base::diag::err_fix(pcx.nodes[n].start, pcx.nodes[n].end, crate::base::buf_slice(fixed),
        &pcx);
    crate::base::diag::err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// (0.27.0) Local l, declared with type node t: kept when t is `*const T`
// (front/parser/rust.vl: its TyPtr's c is 1), for const_write.
pub fn note_const_ptr(l: i64, t: i64, pcx: inout Ctx<Comp>) {
    if l >= 0 && t > 0 && pcx.nodes[t].kind == NodeKind::TyPtr && pcx.nodes[t].c == 1
        && (pcx.nodes[t].p & crate::front::ast::NODE_REF) == 0 {
        pcx.const_ptrs.push(l);
    }
}

// (0.27.0) An assignment's target: `*p` (also `(*p).f`, `p[i]`) where p
// is a local declared `*const T` is edition.later (const_ptr_write,
// 0.27.1): both raw pointers are `*T` in 0.27.0, so the write is not
// refused yet; it is counted.
pub fn const_write(target: i64, pcx: inout Ctx<Comp>) {
    var e = target;
    for _ in 0..100 {
        let k = pcx.nodes[e].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
            e = pcx.nodes[e].a;
        } else {
            break;
        }
    }
    if pcx.nodes[e].kind != NodeKind::Unary || pcx.nodes[e].op != Tok::Star {
        return;
    }
    let p = pcx.nodes[e].b;
    if pcx.nodes[p].kind != NodeKind::Ident || pcx.nodes[p].res != crate::front::check::Res::Local {
        return;
    }
    for i in 0..pcx.const_ptrs.count {
        if pcx.const_ptrs.get(i) == pcx.nodes[p].y {
            crate::front::rust::later(pcx.nodes[target].start, pcx.nodes[target].end,
                "const_ptr_write", "0.27.1", &pcx);
            return;
        }
    }
}

// (0.27.0) `&x` given where a value of type t goes, in the rust edition:
// edition.std_by_value. MVS std takes some arguments by value (`sink`:
// `v.contains(x)`, `m.insert(k, v)`) where Rust's takes `&T`; 0.27.2's std
// takes references.
pub fn std_by_value_error(n: i64, t: i64, pcx: inout Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.std_by_value";
    crate::base::diag::err_begin(pcx.nodes[n].start, &pcx);
    crate::base::diag::err_str(c"a reference where a '", pcx);
    crate::front::types::err_type(t, pcx);
    crate::base::diag::err_str(c"' goes: the parameter takes the value", pcx);
    crate::base::diag::err_help(c"pass the value: `*x` of a copyable value, `x.clone()`, or `x` to move it; in 0.27.0 the rust edition runs on MVS std, which takes some arguments by value (`v.contains(x)`, `m.insert(k, v)`) where Rust's takes `&T` (0.27.2's std takes references)", pcx);
    if pcx.nodes[n].kind == NodeKind::Unary && pcx.nodes[n].b > 0 {
        let e = pcx.nodes[n].b;
        let text = crate::base::SRC[pcx.nodes[e].start..pcx.nodes[e].end];
        crate::base::diag::err_try_fmt(format_args("{text}.clone()"), pcx);
    }
    crate::base::diag::err_end_soft(&pcx);
    pcx.err_kind = saved;
    crate::base::diag::err_jump(&pcx)
}

// ---- Tuple structs and unit structs (0.27.2) ----

// The key tuple_struct_call and unit_struct_value read as `Self`.
pub const SELF_KEY: i64 = -2;

// The struct node of `Self` in an impl whose self type is a struct, or 0.
// RULE: F5.4
pub fn self_struct_node(pcx: Ctx<Comp>) -> i64 {
    let t = pcx.self_type;
    if t <= 0 || pcx.types[t].kind != TyKind::Struct {
        return 0;
    }
    pcx.structs[pcx.types[t].a].node
}

// The struct node the item key names (SELF_KEY: `Self`'s), or 0.
pub fn struct_node_of_key(key: i64, pcx: Ctx<Comp>) -> i64 {
    if key == SELF_KEY {
        return self_struct_node(pcx);
    }
    if key < 0 {
        return 0;
    }
    // UNSAFE: SYM_STRUCT is a raw table indexed by item key (base/ctx.vl),
    // as every reader of it.
    // SAFETY: key is an item key (type_name_key's, >= 0), within the table
    // sym_table sized for every symbol.
    let s = unsafe { pcx.sym_struct[key] };
    if s == 0 { 0 } else { pcx.structs[s - 1].node }
}

// Whether struct node s is a tuple struct (its fields named 0, 1, ..).
pub fn is_tuple_struct(s: i64, pcx: inout Ctx<Comp>) -> bool {
    s != 0 && pcx.nodes[s].count > 0
        && pcx.nodes[crate::front::ast::child(s, 0, pcx)].a == intern_c(c"0", &pcx)
}

// Node n becomes the literal `name { 0: e0, 1: e1, .. }` of its
// expressions SCRATCH[mark..] (popped), with type arguments g.
fn become_struct_lit(n: i64, name: i64, g: i64, mark: i64, pcx: inout Ctx<Comp>) {
    let count = pcx.scratch.count - mark;
    let inits = list_begin(pcx);
    for k in 0..count {
        let e = pcx.scratch.get(mark + k);
        let init = new_node(NodeKind::FieldInit, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
        let field = crate::base::buf_new();
        crate::base::buf_fmt(field, format_args("{k}"));
        pcx.nodes[init].a = crate::base::intern(crate::base::buf_slice(field), &pcx);
        pcx.nodes[init].b = e;
        list_push(init, &pcx);
    }
    // (the inits after the expressions in SCRATCH: moved down over them)
    for k in 0..count {
        pcx.scratch.set(mark + k, pcx.scratch.get(inits + k));
    }
    pcx.scratch.count = mark + count;
    let start = pcx.nodes[n].start;
    let end = pcx.nodes[n].end;
    pcx.nodes[n] = pcx.nodes[0];
    pcx.nodes[n].kind = NodeKind::StructLit;
    pcx.nodes[n].start = start;
    pcx.nodes[n].end = end;
    pcx.nodes[n].a = name;
    pcx.nodes[n].g = g;
    list_end(n, mark, &pcx);
}

// `S(a, b)` of the rust edition, S a tuple struct (callee an Ident naming
// it): call n becomes the literal `S { 0: a, 1: b }`; true. RULE: F7.2
pub fn tuple_struct_call(n: i64, key: i64, pcx: inout Ctx<Comp>) -> bool {
    let s = struct_node_of_key(key, pcx);
    if !is_tuple_struct(s, &pcx) || !rust_node(n, &pcx) {
        return false;
    }
    let callee = pcx.nodes[n].a;
    let mark = list_begin(pcx);
    for k in 0..pcx.nodes[n].count {
        list_push(crate::front::ast::child(n, k, pcx), &pcx);
    }
    become_struct_lit(n, pcx.nodes[callee].a, pcx.nodes[callee].g, mark, &pcx);
    true
}

// `U` of the rust edition, U a struct with no fields (Ident n): n becomes
// the literal `U {}`; true. RULE: F7.3
pub fn unit_struct_value(n: i64, key: i64, pcx: inout Ctx<Comp>) -> bool {
    let s = struct_node_of_key(key, pcx);
    if s == 0 || pcx.nodes[s].count != 0 || !rust_node(n, &pcx) {
        return false;
    }
    let mark = list_begin(pcx);
    become_struct_lit(n, pcx.nodes[n].a, pcx.nodes[n].g, mark, &pcx);
    true
}
