// (0.27.0) The rust edition in the type checker (front/rust): what Rust's
// references add to the checker's 0.19 meanings, which are Rust's already
// (a `&T` is a value, `*r` explicit, receivers and fields reached through
// references). Here: std's Deref and DerefMut (`*x`, a field, a method
// through a type that implements them), Index and IndexMut on a type the
// checker does not index itself (`c[i]` is `*c.index(i)`, `*c.index_mut(i)`
// where it is written). Each rewrites the node in place, as the checker's
// other desugarings do, and the caller checks it again.

use crate::base::{SRC, cstr, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fmt, err_help, err_help_fmt, err_str, err_try_fmt,
};
use crate::front::ast::{NodeKind, child, list_begin, list_end, list_push, new_node};
use crate::front::check::Res;
use crate::front::check::calls::method_of;
use crate::front::lexer::Tok;
use crate::front::types::{REF_MUT, REF_SHARED, TY_U8, TyKind, err_type, fn_param, ref_to};

// Whether node n is read in the rust edition.
pub fn rust_node(n: i64, pcx: inout Ctx<Comp>) -> bool {
    pcx.edition != 0 && crate::front::rust::rust_at(pcx.nodes[n].start, &pcx)
}

// Whether node n is on the path of the place being written or lent
// exclusively (MUT_PLACE: an assignment's target, `&mut e`'s e), through
// fields, indexes and derefs.
fn on_mut_path(n: i64, pcx: Ctx<Comp>) -> bool {
    var p = pcx.mut_place;
    for _ in 0..1000 {
        if p == 0 {
            return false;
        }
        if p == n {
            return true;
        }
        let k = pcx.nodes[p].kind;
        if k == NodeKind::Unary && pcx.nodes[p].op == Tok::Star {
            p = pcx.nodes[p].b;
        } else if k == NodeKind::Index || k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            p = pcx.nodes[p].a;
        } else {
            return false;
        }
    }
    false
}

// RULE: F20.6 (0.27.5) Keeps alt, the IndexMut, DerefMut or as_mut_slice
// call that place node p becomes when it is then used mutably
// (place_to_mut), with its receiver's type now: the call it stands beside
// may retype that receiver (check_expr gives an argument the parameter's
// type).
pub fn keep_alt(p: i64, alt: i64, pcx: inout Ctx<Comp>) {
    pcx.mut_alt.put(p + 1, alt + 1);
    pcx.mut_alt_ty.put(alt + 1, pcx.nodes[pcx.nodes[alt].a].ty + 1);
}

// RULE: F20.6 (0.27.5) Place e is used mutably, known only once its use
// is (a `&mut self` method's receiver, a `ref mut` binding of it): each
// index and deref on its path read through Index or Deref, `*c.index(i)`,
// `*x.deref()`, `v.as_slice()[i]`, becomes the IndexMut, DerefMut or
// as_mut_slice call kept for it (mut_alt), as rustc's
// convert_place_derefs_to_mutable makes it. That call takes its receiver
// by `&mut`, so the places under it are made mutable in turn (the
// receiver's autoref calls this again).
pub fn place_to_mut(e: i64, pcx: inout Ctx<Comp>) {
    var p = e;
    for _ in 0..1000 {
        if p <= 0 {
            return;
        }
        let k = pcx.nodes[p].kind;
        let deref = k == NodeKind::Unary && pcx.nodes[p].op == Tok::Star;
        if !deref && k != NodeKind::FieldAccess && k != NodeKind::TupleField
            && k != NodeKind::Index {
            return;
        }
        let alt = pcx.mut_alt.get(p + 1) - 1;
        if alt > 0 && (deref || k == NodeKind::Index) {
            pcx.mut_alt.put(p + 1, 0);
            // (its receiver and arguments, checked with the call it
            // replaces, the receiver of its type then, keep_alt)
            let recv = pcx.nodes[alt].a;
            let rt = pcx.mut_alt_ty.get(alt + 1) - 1;
            if rt > 0 {
                pcx.nodes[recv].ty = rt;
            }
            pcx.nodes[recv].p |= crate::front::ast::NODE_CHECKED;
            for i in 0..pcx.nodes[alt].count {
                let c = child(alt, i, pcx);
                pcx.nodes[c].p |= crate::front::ast::NODE_CHECKED;
            }
            if deref {
                pcx.nodes[p].b = alt;
            } else {
                pcx.nodes[p].a = alt;
            }
            crate::front::check::synth_mode::synth_expr(alt, &pcx);
            return;
        }
        p = if deref { pcx.nodes[p].b } else { pcx.nodes[p].a };
    }
}

// Whether a value of type t has method `name` (its impls', a trait's
// impl's among them).
fn has_method(t: i64, name: *u8, pcx: inout Ctx<Comp>) -> bool {
    t > 0 && (method_of(t, intern_c(name, &pcx), pcx) >= 0
        || crate::front::convert::has_generic_trait_fn(t, intern_c(name, &pcx), &pcx)
        // (0.27.3: an Ω's bounds' methods, `*d` with `D: Deref`, FL11)
        || crate::front::opaque::is_omega(t, pcx)
        && crate::front::opaque::virtual_fn(t, intern_c(name, &pcx), &pcx) >= 0)
}

// `e.name(args)`: a MethodCall node at e's span (args: a list made with
// list_begin's mark, or -1 for none).
fn method_call(e: i64, name: *u8, arg: i64, pcx: inout Ctx<Comp>) -> i64 {
    let call = new_node(NodeKind::MethodCall, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[call].a = e;
    pcx.nodes[call].b = intern_c(name, &pcx);
    let mark = list_begin(pcx);
    if arg != 0 {
        list_push(arg, &pcx);
    }
    list_end(call, mark, &pcx);
    call
}

// `*e` of a type t that is not a pointer (synth_unary): through Deref,
// `*e.deref()` (`*e.deref_mut()` in a place written); true when the
// operand of n was so rewritten.
pub fn deref_operand(n: i64, e: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if !has_method(t, c"deref", &pcx) {
        return false;
    }
    let name = if on_mut_path(n, pcx) && has_method(t, c"deref_mut", &pcx) { c"deref_mut" }
        else { c"deref" };
    // RULE: F20.6 (0.27.5: read through Deref, the DerefMut call kept for a
    // mutable use known later, place_to_mut)
    if cstr(name) == "deref" && has_method(t, c"deref_mut", &pcx) {
        let alt = method_call(e, c"deref_mut", 0, &pcx);
        keep_alt(n, alt, &pcx);
    }
    pcx.nodes[n].b = method_call(e, name, 0, &pcx);
    true
}

// A field `f` that type t (not a pointer, a struct without that field)
// does not have, at field access n of base e: through Deref, `(*e.deref()).f`
// (deref_mut when written); true when the base was so rewritten.
pub fn deref_field_base(n: i64, e: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if !has_method(t, c"deref", &pcx) {
        return false;
    }
    let name = if on_mut_path(n, pcx) && has_method(t, c"deref_mut", &pcx) { c"deref_mut" }
        else { c"deref" };
    let call = method_call(e, name, 0, &pcx);
    let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[u].op = Tok::Star;
    pcx.nodes[u].b = call;
    // RULE: F20.6 (0.27.5: as deref_operand)
    if cstr(name) == "deref" && has_method(t, c"deref_mut", &pcx) {
        let alt = method_call(e, c"deref_mut", 0, &pcx);
        keep_alt(u, alt, &pcx);
    }
    pcx.nodes[n].a = u;
    true
}

// A method `name` that the receiver's type t does not have, at method call
// n: through Deref when the target type has it, the receiver
// `*e.deref()` (deref_mut when the method takes `&mut self`); true when
// rewritten.
pub fn deref_receiver(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    if !has_method(t, c"deref", &pcx) {
        return false;
    }
    let target = deref_target(t, &pcx);
    if target <= 0 || method_of(target, name, pcx) < 0 && !has_method(target, c"deref", &pcx) {
        return false;
    }
    let m = method_of(target, name, pcx);
    let mutable = m >= 0 && pcx.fns.len() as i64 > m && fn_param_count(m, pcx) > 0
        && (pcx.types[fn_param(m, 0, pcx)].kind == TyKind::Ptr
            && pcx.types[fn_param(m, 0, pcx)].b == REF_MUT
            // (0.27.2: `&mut self` of str, `&mut str`; RULE: F0.1)
            || crate::front::types::is_mut_slice(fn_param(m, 0, pcx), pcx))
        // (a template's signature is not resolved: its written `&mut self`)
        || m >= 0 && pcx.fns[m].generic > 0 && pcx.fns[m].node > 0
        && pcx.nodes[pcx.fns[m].node].count > 0
        && (pcx.nodes[pcx.nodes[child(pcx.fns[m].node, 0, pcx)].b].p
            & crate::front::ast::NODE_REF_MUT) != 0;
    let e = pcx.nodes[n].a;
    let call = method_call(e, if mutable && has_method(t, c"deref_mut", &pcx) { c"deref_mut" }
        else { c"deref" }, 0, &pcx);
    // (a view target: `e.deref()` is the view, no `*`)
    if pcx.types[target].kind == TyKind::Slice
        || crate::front::distinct::is_view_distinct(target, pcx) {
        pcx.nodes[n].a = call;
        return true;
    }
    let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
    pcx.nodes[u].op = Tok::Star;
    pcx.nodes[u].b = call;
    pcx.nodes[n].a = u;
    true
}

// RULE: F6.2 (the probe's `&` and `&mut` steps) A method `name` that the
// receiver's type t does not have, at method call n, which `&t` or
// `&mut t` has (`impl Tr for &S` with `fn m(self)`): the receiver
// becomes `&e` (`&mut e`); true when rewritten.
pub fn autoref_receiver(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t].kind == TyKind::Ptr {
        return false;
    }
    for mode in [REF_SHARED, REF_MUT] {
        let r = ref_to(t, mode, &pcx);
        let f = method_of(r, name, pcx);
        // (a method of `&t`'s that takes `&self` or `&mut self` has the
        // receiver `&&t`, which one autoref does not reach: rustc E0599)
        if f >= 0 && !self_behind(f, r, pcx) {
            let e = pcx.nodes[n].a;
            let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
            pcx.nodes[u].op = Tok::Amp;
            pcx.nodes[u].b = e;
            if mode == REF_MUT {
                pcx.nodes[u].p |= crate::front::ast::NODE_REF_MUT;
            }
            pcx.nodes[n].a = u;
            return true;
        }
    }
    false
}

// RULE: F6.2 Whether method f of type r takes its receiver behind a
// reference (`&self`, `&mut self`: of type `&r`, `&mut r`).
fn self_behind(f: i64, r: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.fns[f].param_count == 0 {
        return false;
    }
    let p = fn_param(f, 0, pcx);
    p > 0 && pcx.types[p].kind == TyKind::Ptr && pcx.types[p].a == r
}

// RULE: F6.2 The step of rustc's method probe at which method f of type x
// is found for a receiver of type t0: with τ₀ = t0 and τₖ₊₁ the referent
// of τₖ, 3k when f's receiver type (its `self` parameter's: x, `&x` or
// `&mut x`) is τₖ, 3k + 1 when it is `&τₖ`, 3k + 2 when `&mut τₖ`. -1 when
// it is none of them through references (a `Deref` target, a view: the
// probe's other steps, which decide nothing here).
pub fn probe_step(f: i64, x: i64, t0: i64, pcx: Ctx<Comp>) -> i64 {
    if f < 0 || x <= 0 || pcx.fns[f].param_count == 0 {
        return -1;
    }
    let p = fn_param(f, 0, pcx);
    if !(p == x || crate::front::types::is_ref(p, pcx) && pcx.types[p].a == x) {
        return -1;
    }
    var tau = t0;
    for k in 0..MAX_PROBE_DEREFS {
        if p == tau {
            return 3 * k;
        }
        if crate::front::types::is_ref(p, pcx) && pcx.types[p].a == tau {
            return 3 * k + if pcx.types[p].b == REF_MUT { 2 } else { 1 };
        }
        if !crate::front::types::is_ref(tau, pcx) {
            return -1;
        }
        tau = pcx.types[tau].a;
    }
    -1
}

// The references probe_step reads through.
const MAX_PROBE_DEREFS: i64 = 16;

// RULE: F6.2 Of method a of type xa and method b of type xb (both named
// `name`, for call n whose receiver has type t0), the one rustc's probe
// finds first: the earlier step (probe_step), and at one step the
// inherent one; two trait methods at one step are error method.ambiguous
// (rustc E0034), and a is kept. -1 when either step is unknown: the
// caller's order stands.
pub fn probe_first(n: i64, a: i64, xa: i64, b: i64, xb: i64, t0: i64, name: i64,
    pcx: inout Ctx<Comp>) -> i64 {
    let sa = probe_step(a, xa, t0, pcx);
    let sb = probe_step(b, xb, t0, pcx);
    if sa < 0 || sb < 0 {
        return -1;
    }
    if sa != sb {
        return if sa < sb { a } else { b };
    }
    let a_inherent = crate::front::traits::impl_of_fn(a, pcx) < 0;
    let b_inherent = crate::front::traits::impl_of_fn(b, pcx) < 0;
    if a_inherent != b_inherent {
        return if a_inherent { a } else { b };
    }
    let saved_kind = pcx.err_kind;
    pcx.err_kind = c"method.ambiguous";
    err_begin(pcx.nodes[n].start, &pcx);
    let ta = pcx.traits[pcx.traits_impls[crate::front::traits::impl_of_fn(a, pcx)].tr].name;
    let tb = pcx.traits[pcx.traits_impls[crate::front::traits::impl_of_fn(b, pcx)].tr].name;
    err_fmt(format_args("multiple applicable items: '{}' of trait '{}' and of trait '{}' take \
        one receiver type", sym_text(name, pcx), sym_text(ta, pcx), sym_text(tb, pcx)), pcx);
    err_help_fmt(format_args("call it through its trait to say which: `{}::{}(..)` or `{}::{}(..)`",
        sym_text(ta, pcx), sym_text(name, pcx), sym_text(tb, pcx), sym_text(name, pcx)), pcx);
    err_end(&pcx);
    pcx.err_kind = saved_kind;
    a
}

// RULE: F6.2 Method f0 of type t, for call n whose receiver (of type
// t0) is a t by value: when a by-value method of `&t` or `&mut t` comes
// before it in rustc's probe (`s.c()` with `fn c(&mut self)` on S and
// `impl C for &S { fn c(self) }`: the `&S` step is earlier), the receiver
// becomes `&e` (`&mut e`); true when rewritten.
pub fn autoref_first(n: i64, f0: i64, t: i64, t0: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    for mode in [REF_SHARED, REF_MUT] {
        let r = ref_to(t, mode, &pcx);
        let g = method_of(r, name, pcx);
        if g >= 0 && !self_behind(g, r, pcx) && probe_first(n, f0, t, g, r, t0, name, &pcx) == g {
            let e = pcx.nodes[n].a;
            let u = new_node(NodeKind::Unary, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
            pcx.nodes[u].op = Tok::Amp;
            pcx.nodes[u].b = e;
            if mode == REF_MUT {
                pcx.nodes[u].p |= crate::front::ast::NODE_REF_MUT;
            }
            pcx.nodes[n].a = u;
            return true;
        }
    }
    false
}

// RULE: F21.2 (Z9's type side) A value of an unsized type, `[T]` or
// `str` written bare (not behind `&`, `*const`, `*mut` or as a generic
// argument), at type node t of a rust-edition position where a value
// goes (`what`: a parameter, a result, a field, a `let`), also as a
// tuple's or an array's element: error type.unsized (rustc E0277).
pub fn check_sized(t: i64, what: *u8, pcx: inout Ctx<Comp>) {
    if t == 0 || !crate::front::rust::rust_at(pcx.nodes[t].start, &pcx) {
        return;
    }
    let k = pcx.nodes[t].kind;
    if k == NodeKind::TyTuple {
        for i in 0..pcx.nodes[t].count {
            check_sized(crate::front::ast::child(t, i, pcx), c"a tuple's element", &pcx);
        }
        return;
    }
    if k == NodeKind::TyArray {
        check_sized(pcx.nodes[t].a, c"an array's element", &pcx);
        return;
    }
    // (as written: a generated item's nodes, spanning its attribute, are not)
    let written = SRC[pcx.nodes[t].start..pcx.nodes[t].end];
    let slice = k == NodeKind::TySlice && written.len() > 0 && written[0] == '[';
    let text = k == NodeKind::TyName && written == "str";
    if !slice && !text {
        return;
    }
    let saved_kind = pcx.err_kind;
    pcx.err_kind = c"type.unsized";
    err_begin(pcx.nodes[t].start, &pcx);
    err_fmt(format_args("the size of '{written}' cannot be known: {} holds its value",
        cstr(what)), pcx);
    err_help(c"a slice or a str is used behind a reference or a pointer", pcx);
    err_try_fmt(format_args("&{written}"), pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved_kind;
}

// RULE: F19.3 Whether a value of fn type `actual` where `expected` is
// wanted is a safe fn where the same `unsafe fn` type is (`fn(A) -> R` to
// `unsafe fn(A) -> R`): it coerces, the pointer as it is. The reverse is
// a mismatch.
pub fn coerce_unsafe_fn(actual: i64, expected: i64, pcx: inout Ctx<Comp>) -> bool {
    actual > 0 && expected > 0 && pcx.types[actual].kind == TyKind::Fn
        && pcx.types[expected].kind == TyKind::Fn
        && crate::front::types::fn_ty_unsafe(expected, pcx)
        && !crate::front::types::fn_ty_unsafe(actual, pcx)
        && crate::front::types::fn_ty_with_unsafe(actual, &pcx) == expected
}

// The number of parameters of function f (0 <= f < the table's length).
fn fn_param_count(f: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.fns[f].param_count
}

// The type `deref` of t returns a reference to (0: none known).
pub fn deref_target(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let f = method_of(t, intern_c(c"deref", &pcx), pcx);
    if f < 0 || f >= pcx.fns.len() as i64 {
        return 0;
    }
    let r = pcx.fns[f].ret;
    if r > 0 && pcx.types[r].kind == TyKind::Ptr {
        return pcx.types[r].a;
    }
    // RULE: F6.2, F20.2 (0.27.2: `Deref<Target = [T]>`'s `&[T]`, `&str`: the
    // view, its own reference until Z9.1)
    if r > 0
        && (pcx.types[r].kind == TyKind::Slice || crate::front::distinct::is_view_distinct(r, pcx)) {
        return r;
    }
    // (a generic impl's template, `impl<T, A> Deref for Vec<T, A>`, has no
    // signature resolved: its written result, `&[T]` or `&str`, says which
    // view; a view's methods do not depend on its element type)
    let fnode = pcx.fns[f].node;
    var rn = if fnode > 0 { pcx.nodes[fnode].b } else { 0 };
    // (`&[T]` is parsed as the view itself, a TySlice node)
    if rn > 0 && pcx.nodes[rn].kind == NodeKind::TyPtr {
        rn = pcx.nodes[rn].a;
    }
    if crate::front::check::resolve::written_unsized(rn, pcx) {
        if pcx.nodes[rn].kind == NodeKind::TySlice {
            return crate::front::types::slice_of(TY_U8, &pcx);
        }
        return pcx.str_type;
    }
    0
}

// (0.27.2.1) `<t as Deref>::Target` (a generic impl's too, `Box<T, A>`'s
// T), else deref_target's answer; 0 when t has no Deref. RULE: F32.2
pub fn deref_projection(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let tr = crate::front::traits::std_trait(c"Deref", &pcx);
    if tr >= 0 {
        let d = crate::front::assoc::trait_projection(tr, t, intern_c(c"Target", &pcx),
            0, &pcx);
        if d > 0 && !crate::front::check::has_error_type(d, pcx) {
            return d;
        }
    }
    deref_target(t, &pcx)
}

// (0.27.2.1) Rust's deref coercion through Deref: a shared reference `&S`
// where `&U` (or the view `&[T]`, `&str`) is expected and S's Deref chain
// reaches U (`&Box<List<A>, A>` for `&List<A>`, `&String` for `&str`):
// n becomes `n.deref()` as many times as the chain is long; true when so
// rewritten and typed `expected`. RULE: F32.2
pub fn deref_coerce(n: i64, actual: i64, expected: i64, pcx: inout Ctx<Comp>) -> bool {
    if actual <= 0 || expected <= 0 || pcx.types[actual].kind != TyKind::Ptr
        || pcx.types[actual].b != crate::front::types::REF_SHARED || !rust_node(n, &pcx) {
        return false;
    }
    let ek = pcx.types[expected].kind;
    let want_ptr = ek == TyKind::Ptr && pcx.types[expected].b == crate::front::types::REF_SHARED;
    let want_view = ek == TyKind::Slice && pcx.types[expected].b == 0
        || crate::front::distinct::is_view_distinct(expected, pcx);
    if !want_ptr && !want_view {
        return false;
    }
    let levels = deref_levels(pcx.types[actual].a, expected, want_ptr, &pcx);
    if levels == 0 {
        return false;
    }
    for _ in 0..levels {
        let inner = new_node(NodeKind::Ident, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
        pcx.nodes[inner] = pcx.nodes[n];
        pcx.nodes[n].kind = NodeKind::MethodCall;
        pcx.nodes[n].a = inner;
        pcx.nodes[n].b = intern_c(c"deref", &pcx);
        pcx.nodes[n].c = 0;
        pcx.nodes[n].g = 0;
        pcx.nodes[n].count = 0;
        pcx.nodes[n].list = 0;
        pcx.nodes[n].p = 0;
        pcx.nodes[n].res = Res::None;
        pcx.nodes[n].x = 0;
        pcx.nodes[n].y = 0;
        pcx.nodes[n].ty = 0;
    }
    crate::front::check::synth_mode::synth_expr(n, &pcx) == expected
}

// How many Deref steps from s reach the expected type (its pointee when
// want_ptr), 0 when none within MAX_PROBE_DEREFS. RULE: F32.2
pub fn deref_levels(s: i64, expected: i64, want_ptr: bool, pcx: inout Ctx<Comp>) -> i64 {
    var t = s;
    for k in 0..4 {
        if t <= 0 || pcx.types[t].kind != TyKind::Struct && pcx.types[t].kind != TyKind::Enum {
            return 0;
        }
        let d = deref_projection(t, &pcx);
        if d <= 0 {
            return 0;
        }
        if want_ptr && d == pcx.types[expected].a || !want_ptr && d == expected {
            return k + 1;
        }
        t = d;
    }
    0
}

// `c[i]` (index node n) on a type t the checker does not index: through
// Index, `*c.index(i)` (`*c.index_mut(i)` in a place written); n becomes
// that Unary. True when rewritten.
pub fn index_through_trait(n: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.types[t].kind != TyKind::Struct && pcx.types[t].kind != TyKind::Enum
        && !crate::front::opaque::is_omega(t, pcx) || !has_method(t, c"index", &pcx) {
        return false;
    }
    let name = if on_mut_path(n, pcx) && has_method(t, c"index_mut", &pcx) { c"index_mut" }
        else { c"index" };
    // RULE: F26.3 (0.27.3: IndexMut's `&mut self` needs the place mutable,
    // `s[1..].make_ascii_uppercase()` of a `let s` is own.readonly, E0596)
    if cstr(name) == "index_mut" {
        crate::front::check::assign::check_inout_place(pcx.nodes[n].a, n, &pcx);
    }
    // RULE: F20.6 (0.27.5: read through Index, the IndexMut call kept for
    // a mutable use known later, place_to_mut)
    if cstr(name) == "index" && has_method(t, c"index_mut", &pcx) {
        let alt = method_call(pcx.nodes[n].a, c"index_mut", pcx.nodes[n].b, &pcx);
        keep_alt(n, alt, &pcx);
    }
    let call = method_call(pcx.nodes[n].a, name, pcx.nodes[n].b, &pcx);
    pcx.nodes[n].kind = NodeKind::Unary;
    pcx.nodes[n].op = Tok::Star;
    pcx.nodes[n].b = call;
    pcx.nodes[n].a = 0;
    true
}

// RULE: F26.3 (0.27.3) `a[r]` (index node n) of a slice, an array or a str
// whose index r is a range value, `r: Range<usize>`, `RangeFull`, a struct
// (not a `lo..hi` written there): through Index, `*a.index(r)`, the
// slice's or str's SliceIndex impl, as rustc's (a read: not yet in a
// place written);
// an array is its whole slice first. True when rewritten, n that Unary.
pub fn index_range_value(n: i64, array_ty: i64, pcx: inout Ctx<Comp>) -> bool {
    let index = pcx.nodes[n].b;
    // (a value that may be a range: a name, a field, a call; not a literal
    // or an operator, which are integers)
    let k = if index == 0 { NodeKind::Range } else { pcx.nodes[index].kind };
    if k != NodeKind::Ident && k != NodeKind::FieldAccess && k != NodeKind::TupleField
        && k != NodeKind::Path && k != NodeKind::Call && k != NodeKind::MethodCall {
        return false;
    }
    let it = crate::front::check::synth_mode::synth_expr(index, &pcx);
    pcx.nodes[index].p |= crate::front::ast::NODE_CHECKED;
    if it <= 0 || pcx.types[it].kind != TyKind::Struct {
        return false;
    }
    // (not in a place written, `&mut v[r]`: a `&mut [T]` receiver of
    // IndexMut::index_mut is not taken yet)
    if on_mut_path(n, pcx) {
        return false;
    }
    var recv = pcx.nodes[n].a;
    pcx.nodes[recv].p |= crate::front::ast::NODE_CHECKED;
    if array_ty > 0 {
        let s = crate::front::types::slice_of(pcx.types[array_ty].a, &pcx);
        recv = crate::front::check::calls::whole_slice(recv, s, &pcx);
    }
    let call = method_call(recv, c"index", index, &pcx);
    pcx.nodes[n].kind = NodeKind::Unary;
    pcx.nodes[n].op = Tok::Star;
    pcx.nodes[n].b = call;
    pcx.nodes[n].a = 0;
    true
}

// (0.27.0) `*e` of a value that is no reference and has no Deref, in the
// rust edition: edition.std_copy. The rust edition runs on MVS std in
// 0.27.0, whose iterators and getters (`iter()`, `get`, `last`, `next`)
// give copies where Rust's give `&T`: the value is used as it is.
pub fn std_copy_error(n: i64, e: i64, t: i64, pcx: inout Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.std_copy";
    crate::base::diag::err_begin(pcx.nodes[n].start, &pcx);
    crate::base::diag::err_str(c"'", pcx);
    let text = crate::base::SRC[pcx.nodes[e].start..pcx.nodes[e].end];
    crate::base::diag::err_fmt(format_args("{text}' is a '"), pcx);
    crate::front::types::err_type(t, pcx);
    crate::base::diag::err_str(c"', not a reference: `*` takes a reference or a raw pointer",
        pcx);
    crate::base::diag::err_help(c"in 0.27.0 the rust edition runs on MVS std, whose iterators and getters (`iter()`, `get`, `last`, `next`) give copies where Rust's give `&T` (0.27.2's std gives references): use the value as it is", pcx);
    crate::base::diag::err_try_fmt(format_args("{text}"), pcx);
    crate::base::diag::err_fix(pcx.nodes[n].start, pcx.nodes[n].end, text, &pcx);
    crate::base::diag::err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// (0.27.1) R5 closed, edition.lenient: in the rust edition a reference is
// not read where its value goes (`f(&a)` for `f(n: i64)`, read: `*`), nor
// a place lent where a reference goes (`f(a)` for `f(n: &i64)`: `&`), as
// 0.19's meanings let MVS do. Rust's spelling is the fix.
pub fn lenient_error(n: i64, read: bool, pcx: inout Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.lenient";
    crate::base::diag::err_begin(pcx.nodes[n].start, &pcx);
    let text = crate::base::SRC[pcx.nodes[n].start..pcx.nodes[n].end];
    let fixed = crate::base::buf_new();
    if read && pcx.nodes[n].kind == NodeKind::Unary && pcx.nodes[n].op == Tok::Amp {
        // (`&a` where `a`'s value goes: `a`)
        let b = pcx.nodes[n].b;
        crate::base::buf_bytes(fixed, crate::base::SRC[pcx.nodes[b].start..pcx.nodes[b].end]);
    } else {
        crate::base::buf_bytes(fixed, if read { "*" } else { "&" });
        crate::base::buf_bytes(fixed, text);
    }
    if read {
        crate::base::diag::err_fmt(format_args("'{text}' is a reference where its value goes"),
            pcx);
        crate::base::diag::err_help(c"Rust reads no reference as its value: dereference it, `*r` (0.27.0 read it so; rustc E0308)", pcx);
    } else {
        crate::base::diag::err_fmt(format_args("'{text}' is a value where a reference goes"), pcx);
        crate::base::diag::err_help(
            c"Rust lends no place unasked: borrow it, `&x` (0.27.0 lent it so; rustc E0308)", pcx);
    }
    crate::base::diag::err_try_fmt(format_args("{}", crate::base::buf_slice(fixed)), pcx);
    crate::base::diag::err_fix(pcx.nodes[n].start, pcx.nodes[n].end, crate::base::buf_slice(fixed),
        &pcx);
    crate::base::diag::err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// (0.27.0) Local l, declared with type node t: kept when t is `*const T`
// (front/parser/rust.vl: its TyPtr's c is 1), for const_write.
pub fn note_const_ptr(l: i64, t: i64, pcx: inout Ctx<Comp>) {
    if l >= 0 && t > 0 && pcx.nodes[t].kind == NodeKind::TyPtr && pcx.nodes[t].c == 1
        && (pcx.nodes[t].p & crate::front::ast::NODE_REF) == 0 {
        pcx.const_ptrs.push(l);
    }
}

// RULE: D3.6a (0.27.7) Whether type node t is written `*mut T` (its
// TyPtr's c is 2, front/parser/rust.vl: raw_pointer_kind): where a `&T`
// is rustc's E0308, the types' mutability differing.
pub fn mut_raw_node(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.nodes[t].kind == NodeKind::TyPtr && pcx.nodes[t].c == 2
        && (pcx.nodes[t].p & crate::front::ast::NODE_REF) == 0
}

// RULE: D3.6a (0.27.7) What pcx.raw_mut_at is while value n is checked
// against type node t: n when n is read in the rust edition and t is
// written `*mut T`, else 0.
pub fn raw_mut_value(n: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    if n > 0 && mut_raw_node(t, pcx) && rust_node(n, &pcx) { n } else { 0 }
}

// RULE: D3.6a (0.27.7) The type node field `field` of struct s is
// declared with (0 for none: a closure's environment).
pub fn field_type_node(s: i64, field: i64, pcx: Ctx<Comp>) -> i64 {
    let item = if s >= 0 { pcx.structs[s].node } else { 0 };
    if field < 0 || item <= 0 || pcx.nodes[item].kind != NodeKind::Struct
        || field >= pcx.nodes[item].count {
        return 0;
    }
    pcx.nodes[child(item, field, pcx)].b
}

// RULE: D3.6a (0.27.7) The type node place e (an assignment's target,
// synthesized) is declared with: a local's, a struct field's, `*p`'s the
// pointee of p's; 0 when not known.
pub fn place_type_node(e: i64, pcx: Ctx<Comp>) -> i64 {
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident && pcx.nodes[e].res == Res::Local && pcx.nodes[e].y >= 0 {
        return pcx.locals[pcx.nodes[e].y].tnode;
    }
    if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
        let inner = place_type_node(pcx.nodes[e].b, pcx);
        return if inner > 0 && pcx.nodes[inner].kind == NodeKind::TyPtr { pcx.nodes[inner].a }
            else { 0 };
    }
    if k == NodeKind::FieldAccess && pcx.nodes[e].y != 2 {
        var t = pcx.nodes[pcx.nodes[e].a].ty;
        if t > 0 && pcx.types[t].kind == TyKind::Ptr {
            t = pcx.types[t].a;
        }
        if t <= 0 || pcx.types[t].kind != TyKind::Struct {
            return 0;
        }
        return field_type_node(pcx.types[t].a, pcx.nodes[e].x, pcx);
    }
    0
}

// (0.27.0) An assignment's target: `*p` (also `(*p).f`, `p[i]`) where p
// is a local declared `*const T` is edition.later (const_ptr_write,
// 0.27.1): both raw pointers are `*T` in 0.27.0, so the write is not
// refused yet; it is counted.
pub fn const_write(target: i64, pcx: inout Ctx<Comp>) {
    var e = target;
    for _ in 0..100 {
        let k = pcx.nodes[e].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
            e = pcx.nodes[e].a;
        } else {
            break;
        }
    }
    if pcx.nodes[e].kind != NodeKind::Unary || pcx.nodes[e].op != Tok::Star {
        return;
    }
    let p = pcx.nodes[e].b;
    if pcx.nodes[p].kind != NodeKind::Ident || pcx.nodes[p].res != crate::front::check::Res::Local {
        return;
    }
    for i in 0..pcx.const_ptrs.count {
        if pcx.const_ptrs.get(i) == pcx.nodes[p].y {
            crate::front::rust::later(pcx.nodes[target].start, pcx.nodes[target].end,
                "const_ptr_write", "0.27.1", &pcx);
            return;
        }
    }
}

// (0.27.0) `&x` given where a value of type t goes, in the rust edition:
// edition.std_by_value. MVS std takes some arguments by value (`sink`:
// `v.contains(x)`, `m.insert(k, v)`) where Rust's takes `&T`; 0.27.2's std
// takes references.
pub fn std_by_value_error(n: i64, t: i64, pcx: inout Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"edition.std_by_value";
    crate::base::diag::err_begin(pcx.nodes[n].start, &pcx);
    crate::base::diag::err_str(c"a reference where a '", pcx);
    crate::front::types::err_type(t, pcx);
    crate::base::diag::err_str(c"' goes: the parameter takes the value", pcx);
    crate::base::diag::err_help(c"pass the value: `*x` of a copyable value, `x.clone()`, or `x` to move it; in 0.27.0 the rust edition runs on MVS std, which takes some arguments by value (`v.contains(x)`, `m.insert(k, v)`) where Rust's takes `&T` (0.27.2's std takes references)", pcx);
    if pcx.nodes[n].kind == NodeKind::Unary && pcx.nodes[n].b > 0 {
        let e = pcx.nodes[n].b;
        let text = crate::base::SRC[pcx.nodes[e].start..pcx.nodes[e].end];
        crate::base::diag::err_try_fmt(format_args("{text}.clone()"), pcx);
    }
    crate::base::diag::err_end_soft(&pcx);
    pcx.err_kind = saved;
    crate::base::diag::err_jump(&pcx)
}

// ---- Tuple structs and unit structs (0.27.2) ----

// The key tuple_struct_call and unit_struct_value read as `Self`.
pub const SELF_KEY: i64 = -2;

// The struct node of `Self` in an impl whose self type is a struct, or 0.
// RULE: F5.4
pub fn self_struct_node(pcx: Ctx<Comp>) -> i64 {
    let t = pcx.self_type;
    if t <= 0 || pcx.types[t].kind != TyKind::Struct {
        return 0;
    }
    pcx.structs[pcx.types[t].a].node
}

// The struct node the item key names (SELF_KEY: `Self`'s), or 0.
pub fn struct_node_of_key(key: i64, pcx: Ctx<Comp>) -> i64 {
    if key == SELF_KEY {
        return self_struct_node(pcx);
    }
    if key < 0 {
        return 0;
    }
    // UNSAFE: SYM_STRUCT is a raw table indexed by item key (base/ctx.vl),
    // as every reader of it.
    // SAFETY: key is an item key (type_name_key's, >= 0), within the table
    // sym_table sized for every symbol.
    let s = unsafe { pcx.sym_struct[key] };
    if s == 0 { 0 } else { pcx.structs[s - 1].node }
}

// Whether struct node s is a tuple struct (its fields named 0, 1, ..).
pub fn is_tuple_struct(s: i64, pcx: inout Ctx<Comp>) -> bool {
    s != 0 && pcx.nodes[s].count > 0
        && pcx.nodes[crate::front::ast::child(s, 0, pcx)].a == intern_c(c"0", &pcx)
}

// Node n becomes the literal `name { 0: e0, 1: e1, .. }` of its
// expressions SCRATCH[mark..] (popped), with type arguments g.
fn become_struct_lit(n: i64, name: i64, g: i64, mark: i64, pcx: inout Ctx<Comp>) {
    let count = pcx.scratch.count - mark;
    let inits = list_begin(pcx);
    for k in 0..count {
        let e = pcx.scratch.get(mark + k);
        let init = new_node(NodeKind::FieldInit, pcx.nodes[e].start, pcx.nodes[e].end, &pcx);
        let field = crate::base::buf_new();
        crate::base::buf_fmt(field, format_args("{k}"));
        pcx.nodes[init].a = crate::base::intern(crate::base::buf_slice(field), &pcx);
        pcx.nodes[init].b = e;
        list_push(init, &pcx);
    }
    // (the inits after the expressions in SCRATCH: moved down over them)
    for k in 0..count {
        pcx.scratch.set(mark + k, pcx.scratch.get(inits + k));
    }
    pcx.scratch.count = mark + count;
    let start = pcx.nodes[n].start;
    let end = pcx.nodes[n].end;
    pcx.nodes[n] = pcx.nodes[0];
    pcx.nodes[n].kind = NodeKind::StructLit;
    pcx.nodes[n].start = start;
    pcx.nodes[n].end = end;
    pcx.nodes[n].a = name;
    pcx.nodes[n].g = g;
    list_end(n, mark, &pcx);
}

// `S(a, b)` of the rust edition, S a tuple struct (callee an Ident naming
// it): call n becomes the literal `S { 0: a, 1: b }`; true. RULE: F7.2
pub fn tuple_struct_call(n: i64, key: i64, pcx: inout Ctx<Comp>) -> bool {
    let s = struct_node_of_key(key, pcx);
    if !is_tuple_struct(s, &pcx) || !rust_node(n, &pcx) {
        return false;
    }
    let callee = pcx.nodes[n].a;
    let mark = list_begin(pcx);
    for k in 0..pcx.nodes[n].count {
        list_push(crate::front::ast::child(n, k, pcx), &pcx);
    }
    become_struct_lit(n, pcx.nodes[callee].a, pcx.nodes[callee].g, mark, &pcx);
    true
}

// (0.27.3, check_expr) Call n of the rust edition checked against a type:
// `S(a, b)` of a tuple struct S (or `Self(..)` in its impls) becomes its
// literal before it is checked, so that the expected type gives its type
// arguments (`let w: Wrap<i64> = Wrap(7);`, F18.1 step 3); true when it
// did. RULE: F7.2
pub fn tuple_struct_expected(n: i64, pcx: inout Ctx<Comp>) -> bool {
    let callee = pcx.nodes[n].a;
    if pcx.nodes[callee].kind != NodeKind::Ident
        || (pcx.nodes[callee].p & crate::front::check::names::NODE_RESOLVED) != 0
        || crate::front::check::lookup_local(pcx.nodes[callee].a, pcx).is_some() {
        return false;
    }
    let name = pcx.nodes[callee].a;
    if name == pcx.self_type_sym {
        return tuple_struct_call(n, SELF_KEY, &pcx);
    }
    let b = crate::front::modules::lookup::lookup_item(pcx.cur_mod, name, pcx.cur_mod, &pcx);
    crate::front::modules::lookup::binding_kind(b) == crate::front::modules::lookup::B_ITEM
        && tuple_struct_call(n, crate::front::modules::lookup::binding_value(b), &pcx)
}

// `U` of the rust edition, U a struct with no fields (Ident n): n becomes
// the literal `U {}`; true. RULE: F7.3
pub fn unit_struct_value(n: i64, key: i64, pcx: inout Ctx<Comp>) -> bool {
    let s = struct_node_of_key(key, pcx);
    if s == 0 || pcx.nodes[s].count != 0 || !rust_node(n, &pcx) {
        return false;
    }
    let mark = list_begin(pcx);
    become_struct_lit(n, pcx.nodes[n].a, pcx.nodes[n].g, mark, &pcx);
    true
}

// RULE: F30.2 (synth_unary) The raw borrow n, `&raw const P` or `&raw mut P`
// of operand P: the address of the place, a raw pointer to its type, no
// reference. `mut` needs the place mutable (the borrow checker's
// borrowck.borrow_immutable of the raw loan, rustc E0596); a
// value that is not a place is an error (rustc E0745). The bare `&raw mut
// S` of a `static mut` needs no unsafe (rustc's), its projections do.
pub fn raw_borrow(n: i64, operand: i64, pcx: inout Ctx<Comp>) -> i64 {
    let mutable = (pcx.nodes[n].p & crate::front::ast::NODE_REF_MUT) != 0;
    crate::front::check::unsafety::mark_no_read(operand, &pcx);
    let outer_place = pcx.mut_place;
    if mutable {
        pcx.mut_place = operand;
    }
    let bare = pcx.nodes[operand].kind == NodeKind::Ident;
    let saved_audit = pcx.audit_unsafe;
    if bare {
        pcx.audit_unsafe = false;
        pcx.unsafe_depth += 1;
    }
    let ty = crate::front::check::synth_mode::synth_expr(operand, &pcx);
    if bare {
        pcx.unsafe_depth -= 1;
        pcx.audit_unsafe = saved_audit;
    }
    pcx.mut_place = outer_place;
    // (a temporary check/temps.vl hoisted, `&raw const f()`, is no place)
    if !crate::front::check::assign::is_place(operand, pcx)
        || (pcx.nodes[operand].p & crate::front::check::temps::NODE_TEMP) != 0 {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"cannot take the address of a temporary: `&raw` needs a place (rustc E0745)",
            pcx);
        err_help(c"bind the value to a variable first, then take its address", pcx);
        err_end_soft(&pcx);
    }
    crate::front::types::ptr_to(ty, &pcx)
}

// RULE: F29.1 Whether cast n is the rust edition's `e as *const _` or `e as
// *mut _`: a raw pointer type whose pointee is written `_`.
pub fn raw_hole_cast(n: i64, pcx: Ctx<Comp>) -> bool {
    let t = pcx.nodes[n].b;
    if t <= 0 || pcx.nodes[t].kind != NodeKind::TyPtr || pcx.edition == 0
        || (pcx.nodes[t].p & (crate::front::ast::NODE_REF | crate::front::ast::NODE_REF_MUT)) != 0 {
        return false;
    }
    let a = pcx.nodes[t].a;
    a > 0 && pcx.nodes[a].kind == NodeKind::TyName && pcx.nodes[a].count == 0
        && pcx.nodes[a].g == 0 && pcx.nodes[a].a == pcx.underscore
}

// RULE: F29.1 The type of cast n, `e as *const _` (raw_hole_cast), of an
// operand of type from: a raw pointer to its pointee; an operand that is no
// reference or pointer gives none (rustc E0641).
pub fn raw_hole_target(n: i64, from: i64, pcx: inout Ctx<Comp>) -> i64 {
    if from > 0 && pcx.types[from].kind == TyKind::Ptr {
        return crate::front::types::ptr_to(pcx.types[from].a, &pcx);
    }
    if from > 0 && from != pcx.ty_error {
        let saved = pcx.err_kind;
        pcx.err_kind = c"type.cast";
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"cannot cast '", pcx);
        err_type(from, pcx);
        err_str(c"' to a pointer of an unknown kind (rustc E0641)", pcx);
        err_help(c"write the pointee: `as *const T`", pcx);
        err_end_soft(&pcx);
        pcx.err_kind = saved;
    }
    pcx.ty_error
}
