// Struct-like enum variants (0.17). `enum E { V { a: A, b: B } }` is the
// variant `V(A, B)` whose fields have names too (the Variant node's d: a
// node listing a Field node per field, a = the name). A literal
// `E::V { b: y, a: x }` is checked as the call `E::V(x, y)` (flagged
// CALL_FIELDS; its z lists the fields in the order they were written, when
// that is not theirs: the back ends evaluate them in that order), a
// pattern `E::V { a, .. }` as `E::V(a, _)`. Fields are read only through
// patterns, as in Rust.

use crate::base::{buf_bytes, buf_fmt, buf_len, buf_new, buf_slice, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_fmt, err_help, err_help_fmt, err_str, err_try_fmt};
use crate::front::ast::{
    CALL_FIELDS, FIELD_SHORTHAND, NodeKind, PAT_FIELDS, PAT_REST, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::check::name_error;
use crate::front::check::args::check_shorthands;
use crate::front::check::names::{help_nearest, near_to};
use crate::front::check::resolve::resolve_alias;
use crate::front::generics::env_lookup;
use crate::front::modules::lookup::{
    B_ITEM, B_MODULE, B_TVARIANT, B_VARIANT, binding_kind, binding_value, lookup_quiet,
    resolve_path,
};
use crate::front::types::{TyKind, buf_type, enum_variant, err_type};

// The field of Variant node `vnode` named `name`, or -1.
pub fn field_index(vnode: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let names = pcx.nodes[vnode as usize].d;
    if names == 0 {
        return -1;
    }
    for i in 0..pcx.nodes[names as usize].count {
        if pcx.nodes[child(names, i, pcx) as usize].a == name {
            return i;
        }
    }
    -1
}

// Whether variant v (a VARIANTS index) is written `V { a: A, ... }`.
pub fn has_named_fields(v: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[pcx.variants[v as usize].node as usize].d != 0
}

// The variant of enum e named `name`: its node; -1 when e has none.
fn enum_variant_node(e: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        pcx.lit_enum = e;
        let item = (pcx.enums[e as usize]).node;
        for i in 0..pcx.nodes[item as usize].count {
            if pcx.nodes[child(item, i, pcx) as usize].a == name {
                return child(item, i, pcx);
            }
        }
        -1
    }
}

// The variant node binding b names (a variant in scope by `use`), or 0.
fn variant_of_binding(b: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if binding_kind(b) == B_VARIANT {
        let v = binding_value(b);
        return enum_variant_node(pcx.variants[v as usize].enum_id, pcx.variants[v as usize].name,
            pcx);
    }
    if binding_kind(b) == B_TVARIANT {
        return enum_variant_node(binding_value(b), name, pcx);
    }
    0
}

// The variant struct literal n names (`E::V { .. }`, `m::E::V { .. }`,
// `Self::V { .. }`, `V { .. }` after `use E::V;`): its Variant node, -1 for
// an enum without that variant (LIT_ENUM: the enum), 0 for no enum.
fn literal_variant(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let name = pcx.nodes[n as usize].a;
    let h = pcx.nodes[n as usize].h;
    if h == 0 {
        if name == pcx.self_type_sym || env_lookup(name, pcx) != 0 {
            return 0;
        }
        return variant_of_binding(lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, pcx), name,
            pcx);
    }
    let k = pcx.nodes[h as usize].count;
    let owner = pcx.nodes[child(h, k - 1, pcx) as usize].a;
    if k == 1 && owner == pcx.self_type_sym {
        if pcx.self_type != 0 && pcx.types[pcx.self_type as usize].kind == TyKind::Enum {
            return enum_variant_node(pcx.types[pcx.self_type as usize].a, name, pcx);
        }
        return 0;
    }
    if k == 1 && env_lookup(owner, pcx) != 0 {
        return 0;
    }
    let b = resolve_path(pcx.cur_mod, h, k, -1, pcx);
    if binding_kind(b) == B_MODULE {
        return variant_of_binding(lookup_quiet(binding_value(b), name, pcx.cur_mod, pcx), name,
            pcx);
    }
    if binding_kind(b) != B_ITEM {
        return 0;
    }
    let key = binding_value(b);
    if (pcx.sym_enum[key as usize]) != 0 {
        return enum_variant_node((pcx.sym_enum[key as usize]) - 1, name, pcx);
    }
    if (pcx.sym_alias[key as usize]) != 0 {
        let t = resolve_alias(key, pcx.nodes[n as usize].start, pcx);
        if pcx.types[t as usize].kind == TyKind::Enum {
            return enum_variant_node(pcx.types[t as usize].a, name, pcx);
        }
    }
    0
}

// The callee of the call literal n becomes: `E::V` as written (a Path),
// or the variant's own name (an Ident).
fn literal_callee(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let h = pcx.nodes[n as usize].h;
    let name = pcx.nodes[n as usize].a;
    let name_start = if h == 0 { pcx.nodes[n as usize].start } else { pcx.nodes[h as usize].end };
    let name_end = name_start + sym_text(name, pcx).len() as i64;
    if h == 0 {
        let id = new_node(NodeKind::Ident, name_start, name_end, pcx);
        pcx.nodes[id as usize].a = name;
        pcx.nodes[id as usize].g = pcx.nodes[n as usize].g;
        return id;
    }
    let k = pcx.nodes[h as usize].count;
    let before = child(h, k - 1, pcx);
    let path = new_node(NodeKind::Path, pcx.nodes[n as usize].start, name_end, pcx);
    pcx.nodes[path as usize].a = pcx.nodes[before as usize].a;
    pcx.nodes[path as usize].g = pcx.nodes[before as usize].g;
    pcx.nodes[path as usize].b = name;
    pcx.nodes[path as usize].h = pcx.nodes[n as usize].g;
    if k > 1 {
        let mark = list_begin(pcx);
        for i in 0..k {
            list_push(child(h, i, pcx), pcx);
        }
        let last = new_node(NodeKind::Ident, name_start, name_end, pcx);
        pcx.nodes[last as usize].a = name;
        pcx.nodes[last as usize].g = pcx.nodes[n as usize].g;
        list_push(last, pcx);
        list_end(path, mark, pcx);
    }
    path
}

// `E::V` for messages: the enum of the variant last found, and `name`.
fn buf_variant(b: i64, name: i64, pcx: &Ctx<Comp>) {
    unsafe {
        buf_bytes(b, sym_text((pcx.enums[pcx.lit_enum as usize]).name, pcx));
        buf_str(b, c"::");
        buf_bytes(b, sym_text(name, pcx));
    }
}

// `a: A, b: B`: the fields of Variant node vnode, written as declared.
fn buf_fields(b: i64, vnode: i64, with_types: bool, pcx: &Ctx<Comp>) {
    let names = pcx.nodes[vnode as usize].d;
    for i in 0..pcx.nodes[names as usize].count {
        if i > 0 {
            buf_str(b, c", ");
        }
        let f = child(names, i, pcx);
        buf_bytes(b, sym_text(pcx.nodes[f as usize].a, pcx));
        if with_types {
            let ty = child(vnode, i, pcx);
            buf_str(b, c": ");
            buf_bytes(b,
                &get_src()[
                    pcx.nodes[ty as usize].start as usize..pcx.nodes[ty as usize].end as usize]);
        }
    }
}

// The help of an unknown field `name` of variant node vnode: the nearest
// field, else the fields.
fn help_fields(vnode: i64, name: i64, pcx: &mut Ctx<Comp>) {
    let names = pcx.nodes[vnode as usize].d;
    let mut near = near_to(name);
    for i in 0..pcx.nodes[names as usize].count {
        near.offer(pcx.nodes[child(names, i, pcx) as usize].a, pcx);
    }
    if near.best >= 0 {
        near.help(pcx);
        return;
    }
    let f = buf_new();
    buf_fields(f, vnode, true, pcx);
    err_help_fmt(format_args("its fields: {}", str::from_utf8(buf_slice(f)).unwrap()), pcx);
}

// An error at `pos` naming variant `name` of the enum last found:
// `before` 'E::V' `after`.
fn variant_error(pos: i64, before: *mut u8, name: i64, after: *mut u8, pcx: &mut Ctx<Comp>) {
    err_begin(pos, pcx);
    err_str(before, pcx);
    let b = buf_new();
    buf_variant(b, name, pcx);
    err_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
    err_str(after, pcx);
}

// (0.17) Struct literal n when it names a variant (`E::V { a: x, b: y }`):
// made the call `E::V(x, y)`, to be checked again; false when n names no
// variant (a struct's literal).
pub fn variant_literal(n: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let vnode = literal_variant(n, pcx);
        if vnode == 0 {
            return false;
        }
        let name = pcx.nodes[n as usize].a;
        if vnode < 0 {
            err_begin(pcx.nodes[n as usize].start, pcx);
            err_fmt(format_args("no variant '{}' in enum '{}'",
                str::from_utf8(sym_text(name, pcx)).unwrap(),
                str::from_utf8(sym_text((pcx.enums[pcx.lit_enum as usize]).name, pcx)).unwrap()),
                pcx);
            // (0.25.2.1: the nearest variants)
            pcx.near_all.clear();
            pcx.near_collect = true;
            let mut near = near_to(name);
            for i in 0..(pcx.enums[pcx.lit_enum as usize]).variant_count {
                near.offer(pcx.variants[enum_variant(pcx.lit_enum, i, pcx) as usize].name, pcx);
            }
            pcx.near_collect = false;
            near.help(pcx);
            if buf_len(pcx.err_help) == 0 {
                help_nearest(c"its variants: ", name, pcx);
            }
            err_end(pcx);
        }
        check_shorthands(n, pcx);
        let callee = literal_callee(n, pcx);
        let names = pcx.nodes[vnode as usize].d;
        let count = pcx.nodes[vnode as usize].count;
        if count == 0 && pcx.nodes[n as usize].count == 0 {
            // `E::V {}`: the variant without fields.
            let start = pcx.nodes[n as usize].start;
            let end = pcx.nodes[n as usize].end;
            pcx.nodes[n as usize] = pcx.nodes[callee as usize];
            pcx.nodes[n as usize].start = start;
            pcx.nodes[n as usize].end = end;
            return true;
        }
        if names == 0 {
            variant_error(pcx.nodes[n as usize].start, c"variant '", name, c"' has no named fields",
                pcx);
            let b = buf_new();
            buf_variant(b, name, pcx);
            if count == 0 {
                err_help(c"write it without braces", pcx);
            } else {
                buf_str(b, c"(");
                for i in 0..count {
                    if i > 0 {
                        buf_str(b, c", ");
                    }
                    buf_str(b, c"_");
                }
                buf_str(b, c")");
                err_help(c"its fields are by position", pcx);
            }
            err_try_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
            err_end(pcx);
        }
        let mut slots_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        slots_room.resize((count + 1) as usize, 0);
        let slots = slots_room.as_mut_slice();
        let mut ordered = true;
        let mut last: i64 = -1;
        for i in 0..pcx.nodes[n as usize].count {
            let init = child(n, i, pcx);
            let k = field_index(vnode, pcx.nodes[init as usize].a, pcx);
            if k < 0 {
                err_begin(pcx.nodes[init as usize].start, pcx);
                err_fmt(format_args("no field '{}' in variant '",
                    str::from_utf8(sym_text(pcx.nodes[init as usize].a, pcx)).unwrap()),
                    pcx);
                let b = buf_new();
                buf_variant(b, name, pcx);
                err_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
                err_str(c"'", pcx);
                help_fields(vnode, pcx.nodes[init as usize].a, pcx);
                err_end(pcx);
            }
            if (slots[k as usize]) != 0 {
                name_error(pcx.nodes[init as usize].start, c"duplicate field '",
                    pcx.nodes[init as usize].a, c"' in constructor", pcx);
            }
            (slots[k as usize]) = pcx.nodes[init as usize].b;
            if k < last {
                ordered = false;
            }
            last = k;
        }
        for k in 0..count {
            if (slots[k as usize]) == 0 {
                err_begin(pcx.nodes[n as usize].start, pcx);
                err_fmt(format_args("missing field '{}' in variant '",
                    str::from_utf8(sym_text(pcx.nodes[child(names, k, pcx) as usize].a, pcx)).unwrap()), pcx);
                let b = buf_new();
                buf_variant(b, name, pcx);
                err_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
                err_str(c"' constructor", pcx);
                let f = buf_new();
                buf_fields(f, vnode, true, pcx);
                err_help_fmt(format_args("its fields: {}", str::from_utf8(buf_slice(f)).unwrap()),
                    pcx);
                err_end(pcx);
            }
        }
        let mut order: i64 = 0;
        if !ordered {
            order = new_node(NodeKind::None, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
                pcx);
            let mark = list_begin(pcx);
            for i in 0..pcx.nodes[n as usize].count {
                list_push(field_index(vnode, pcx.nodes[child(n, i, pcx) as usize].a, pcx), pcx);
            }
            list_end(order, mark, pcx);
        }
        let mark = list_begin(pcx);
        for k in 0..count {
            list_push((slots[k as usize]), pcx);
        }
        list_end(n, mark, pcx);
        pcx.nodes[n as usize].kind = NodeKind::Call;
        pcx.nodes[n as usize].a = callee;
        pcx.nodes[n as usize].g = 0;
        pcx.nodes[n as usize].h = 0;
        pcx.nodes[n as usize].z = order;
        pcx.nodes[n as usize].p |= CALL_FIELDS;
        true
    }
}

// (0.17) `E::V(x, y)` (call n), or a pattern `E::V(p, q)`, for variant v
// (of enum type t) whose fields have names: the error, with the form to
// write.
pub fn positional_error(n: i64, v: i64, t: i64, pattern: bool, pcx: &mut Ctx<Comp>) -> ! {
    let vnode = pcx.variants[v as usize].node;
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"variant '", pcx);
    err_type(t, pcx);
    err_fmt(format_args("::{}' has named fields; ",
        str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()), pcx);
    err_str(if pattern { c"match them by name" } else { c"give them by name" }, pcx);
    let b = buf_new();
    buf_type(b, t, pcx);
    buf_fmt(b,
        format_args("::{} {{ ",
            str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()));
    let names = pcx.nodes[vnode as usize].d;
    // (the values or patterns written, when there is one per field)
    let given = pcx.nodes[n as usize].count == pcx.nodes[names as usize].count;
    for i in 0..pcx.nodes[names as usize].count {
        if i > 0 {
            buf_str(b, c", ");
        }
        let name = sym_text(pcx.nodes[child(names, i, pcx) as usize].a, pcx);
        buf_bytes(b, name);
        if given {
            let text = &get_src()[
                pcx.nodes[child(n, i, pcx) as usize].start as usize..pcx.nodes[
                    child(n, i, pcx) as usize].end as usize];
            if text != name {
                buf_str(b, c": ");
                buf_bytes(b, text);
            }
        } else if !pattern {
            buf_str(b, c": VALUE");
        }
    }
    buf_str(b, c" }");
    err_try_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
    err_end(pcx)
}

// (0.17) Pattern p `E::V { a, b: q, .. }` of variant v (enum type t): its
// list made the patterns in field order, a wildcard for each field left
// out (with `..`).
pub fn pattern_fields(p: i64, v: i64, t: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let vnode = pcx.variants[v as usize].node;
        let names = pcx.nodes[vnode as usize].d;
        let count = pcx.variants[v as usize].field_count;
        if names == 0 && pcx.nodes[p as usize].count > 0 {
            err_begin(pcx.nodes[p as usize].start, pcx);
            err_str(c"variant '", pcx);
            err_type(t, pcx);
            err_fmt(format_args("::{}' has no named fields",
                str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()),
                pcx);
            let b = buf_new();
            buf_type(b, t, pcx);
            buf_fmt(b,
                format_args("::{}",
                    str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()));
            if count > 0 {
                buf_str(b, c"(");
                for i in 0..count {
                    if i > 0 {
                        buf_str(b, c", ");
                    }
                    buf_str(b, c"_");
                }
                buf_str(b, c")");
                err_help(c"match its fields by position", pcx);
            }
            err_try_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
            err_end(pcx);
        }
        let mut slots_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        slots_room.resize((count + 1) as usize, 0);
        let slots = slots_room.as_mut_slice();
        for i in 0..pcx.nodes[p as usize].count {
            let f = child(p, i, pcx);
            let k = field_index(vnode, pcx.nodes[f as usize].a, pcx);
            if k < 0 {
                err_begin(pcx.nodes[f as usize].start, pcx);
                err_fmt(format_args("no field '{}' in variant '",
                    str::from_utf8(sym_text(pcx.nodes[f as usize].a, pcx)).unwrap()),
                    pcx);
                err_type(t, pcx);
                err_fmt(format_args("::{}'",
                    str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()), pcx);
                help_fields(vnode, pcx.nodes[f as usize].a, pcx);
                err_end(pcx);
            }
            if (slots[k as usize]) != 0 {
                name_error(pcx.nodes[f as usize].start, c"field '", pcx.nodes[f as usize].a,
                    c"' is matched twice in the pattern", pcx);
            }
            (slots[k as usize]) = pcx.nodes[f as usize].b;
        }
        if (pcx.nodes[p as usize].p & PAT_REST) == 0 {
            for k in 0..count {
                if (slots[k as usize]) == 0 {
                    err_begin(pcx.nodes[p as usize].start, pcx);
                    err_str(c"the pattern of '", pcx);
                    err_type(t, pcx);
                    err_fmt(
                        format_args("::{}' does not mention field '{}'",
                            str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap(),
                            str::from_utf8(sym_text(pcx.nodes[child(names, k, pcx) as usize].a,
                                pcx)).unwrap()), pcx);
                    err_help(c"match it too, or end the pattern with '..' to leave the rest out",
                        pcx);
                    let b = buf_new();
                    buf_type(b, t, pcx);
                    buf_fmt(b,
                        format_args("::{} {{ ",
                            str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()));
                    for i in 0..pcx.nodes[p as usize].count {
                        let f = child(p, i, pcx);
                        if (pcx.nodes[f as usize].p & FIELD_SHORTHAND) != 0 {
                            buf_bytes(b,
                                &get_src()[
                                    pcx.nodes[f as usize].start as usize..pcx.nodes[f as usize].end as usize]);
                        } else {
                            buf_fmt(b,
                                format_args("{}: ",
                                    str::from_utf8(sym_text(pcx.nodes[f as usize].a, pcx)).unwrap()));
                            buf_bytes(b,
                                &get_src()[
                                    pcx.nodes[pcx.nodes[f as usize].b as usize].start as usize..pcx.nodes[pcx.nodes[f as usize].b as usize].end as usize]);
                        }
                        buf_str(b, c", ");
                    }
                    buf_str(b, c".. }");
                    err_try_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
                    err_end(pcx);
                }
            }
        }
        let mark = list_begin(pcx);
        for k in 0..count {
            let mut q = (slots[k as usize]);
            if q == 0 {
                q = new_node(NodeKind::PatWild, pcx.nodes[p as usize].start,
                    pcx.nodes[p as usize].start, pcx);
            }
            list_push(q, pcx);
        }
        list_end(p, mark, pcx);
        pcx.nodes[p as usize].c = (count > 0) as i64;
        pcx.nodes[p as usize].p -= PAT_FIELDS;
    }
}

// (0.17) The help of `e.a` on a value of enum type t (or a pointer to
// one), when a variant has a field `a`: read it through a pattern. `base`:
// the expression e.
pub fn enum_field_help(t: i64, name: i64, base: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let mut e = t;
        if pcx.types[e as usize].kind == TyKind::Ptr {
            e = pcx.types[e as usize].a;
        }
        if pcx.types[e as usize].kind != TyKind::Enum {
            return;
        }
        for i in 0..(pcx.enums[pcx.types[e as usize].a as usize]).variant_count {
            let v = enum_variant(pcx.types[e as usize].a, i, pcx);
            if field_index(pcx.variants[v as usize].node, name, pcx) >= 0 {
                err_help(c"a variant's fields are read through a pattern (no '.field' on an enum)",
                    pcx);
                let b = buf_new();
                buf_str(b, c"if let ");
                buf_type(b, e, pcx);
                buf_fmt(b,
                    format_args("::{} {{ {}, .. }} = ",
                        str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap(),
                        str::from_utf8(sym_text(name, pcx)).unwrap()));
                buf_bytes(b,
                    &get_src()[
                        pcx.nodes[base as usize].start as usize..pcx.nodes[base as usize].end as usize]);
                buf_str(b, c" { ... }");
                err_try_fmt(str::from_utf8(buf_slice(b)).unwrap(), pcx);
                return;
            }
        }
    }
}
