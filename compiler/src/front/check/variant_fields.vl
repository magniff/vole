// Struct-like enum variants (0.17). `enum E { V { a: A, b: B } }` is the
// variant `V(A, B)` whose fields have names too (the Variant node's d: a
// node listing a Field node per field, a = the name). A literal
// `E::V { b: y, a: x }` is checked as the call `E::V(x, y)` (flagged
// CALL_FIELDS; its z lists the fields in the order they were written, when
// that is not theirs: the back ends evaluate them in that order), a
// pattern `E::V { a, .. }` as `E::V(a, _)`. Fields are read only through
// patterns, as in Rust.

use crate::base::{
    BUFS, SRC, alloc_array, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, free, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_fmt, err_help, err_help_fmt, err_str, err_try_fmt};
use crate::front::ast::{
    CALL_FIELDS, FIELD_SHORTHAND, NodeKind, PAT_FIELDS, PAT_REST, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::check::name_error;
use crate::front::check::args::check_shorthands;
use crate::front::check::names::{help_nearest, near_to};
use crate::front::check::resolve::resolve_alias;
use crate::front::generics::env_lookup;
use crate::front::modules::lookup::{
    B_ITEM, B_MODULE, B_TVARIANT, B_VARIANT, binding_kind, binding_value, lookup_quiet,
    resolve_path,
};
use crate::front::types::{ENUMS, TyKind, buf_type, enum_variant, err_type};

// The field of Variant node `vnode` named `name`, or -1.
pub fn field_index(vnode: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    let names = pcx.nodes[vnode].d;
    if names == 0 {
        return -1;
    }
    for i in 0..pcx.nodes[names].count {
        if pcx.nodes[child(names, i, pcx)].a == name {
            return i;
        }
    }
    -1
}

// Whether variant v (a VARIANTS index) is written `V { a: A, ... }`.
pub fn has_named_fields(v: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[pcx.variants[v].node].d != 0
}

// The variant of enum e named `name`: its node; -1 when e has none.
fn enum_variant_node(e: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        pcx.lit_enum = e;
        let item = ENUMS[e].node;
        for i in 0..pcx.nodes[item].count {
            if pcx.nodes[child(item, i, pcx)].a == name {
                return child(item, i, pcx);
            }
        }
        -1
    }
}

// The variant node binding b names (a variant in scope by `use`), or 0.
fn variant_of_binding(b: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    if binding_kind(b) == B_VARIANT {
        let v = binding_value(b);
        return enum_variant_node(pcx.variants[v].enum_id, pcx.variants[v].name, &pcx);
    }
    if binding_kind(b) == B_TVARIANT {
        return enum_variant_node(binding_value(b), name, &pcx);
    }
    0
}

// The variant struct literal n names (`E::V { .. }`, `m::E::V { .. }`,
// `Self::V { .. }`, `V { .. }` after `use E::V;`): its Variant node, -1 for
// an enum without that variant (LIT_ENUM: the enum), 0 for no enum.
fn literal_variant(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let name = pcx.nodes[n].a;
        let h = pcx.nodes[n].h;
        if h == 0 {
            if name == pcx.self_type_sym || env_lookup(name, pcx) != 0 {
                return 0;
            }
            return variant_of_binding(lookup_quiet(pcx.cur_mod, name, pcx.cur_mod, &pcx), name,
                &pcx);
        }
        let k = pcx.nodes[h].count;
        let owner = pcx.nodes[child(h, k - 1, pcx)].a;
        if k == 1 && owner == pcx.self_type_sym {
            if pcx.self_type != 0 && pcx.types[pcx.self_type].kind == TyKind::Enum {
                return enum_variant_node(pcx.types[pcx.self_type].a, name, &pcx);
            }
            return 0;
        }
        if k == 1 && env_lookup(owner, pcx) != 0 {
            return 0;
        }
        let b = resolve_path(pcx.cur_mod, h, k, -1, &pcx);
        if binding_kind(b) == B_MODULE {
            return variant_of_binding(lookup_quiet(binding_value(b), name, pcx.cur_mod, &pcx), name,
                &pcx);
        }
        if binding_kind(b) != B_ITEM {
            return 0;
        }
        let key = binding_value(b);
        if pcx.sym_enum[key] != 0 {
            return enum_variant_node(pcx.sym_enum[key] - 1, name, &pcx);
        }
        if pcx.sym_alias[key] != 0 {
            let t = resolve_alias(key, pcx.nodes[n].start, &pcx);
            if pcx.types[t].kind == TyKind::Enum {
                return enum_variant_node(pcx.types[t].a, name, &pcx);
            }
        }
        0
    }
}

// The callee of the call literal n becomes: `E::V` as written (a Path),
// or the variant's own name (an Ident).
fn literal_callee(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let h = pcx.nodes[n].h;
    let name = pcx.nodes[n].a;
    let name_start = if h == 0 { pcx.nodes[n].start } else { pcx.nodes[h].end };
    let name_end = name_start + sym_text(name, pcx).len as i64;
    if h == 0 {
        let id = new_node(NodeKind::Ident, name_start, name_end, &pcx);
        pcx.nodes[id].a = name;
        pcx.nodes[id].g = pcx.nodes[n].g;
        return id;
    }
    let k = pcx.nodes[h].count;
    let before = child(h, k - 1, pcx);
    let path = new_node(NodeKind::Path, pcx.nodes[n].start, name_end, &pcx);
    pcx.nodes[path].a = pcx.nodes[before].a;
    pcx.nodes[path].g = pcx.nodes[before].g;
    pcx.nodes[path].b = name;
    pcx.nodes[path].h = pcx.nodes[n].g;
    if k > 1 {
        let mark = list_begin(pcx);
        for i in 0..k {
            list_push(child(h, i, pcx), &pcx);
        }
        let last = new_node(NodeKind::Ident, name_start, name_end, &pcx);
        pcx.nodes[last].a = name;
        pcx.nodes[last].g = pcx.nodes[n].g;
        list_push(last, &pcx);
        list_end(path, mark, &pcx);
    }
    path
}

// `E::V` for messages: the enum of the variant last found, and `name`.
fn buf_variant(b: i64, name: i64, pcx: Ctx<Comp>) {
    unsafe {
        buf_bytes(b, sym_text(ENUMS[pcx.lit_enum].name, pcx));
        buf_str(b, c"::");
        buf_bytes(b, sym_text(name, pcx));
    }
}

// `a: A, b: B`: the fields of Variant node vnode, written as declared.
fn buf_fields(b: i64, vnode: i64, with_types: bool, pcx: Ctx<Comp>) {
    let names = pcx.nodes[vnode].d;
    for i in 0..pcx.nodes[names].count {
        if i > 0 {
            buf_str(b, c", ");
        }
        let f = child(names, i, pcx);
        buf_bytes(b, sym_text(pcx.nodes[f].a, pcx));
        if with_types {
            let ty = child(vnode, i, pcx);
            buf_str(b, c": ");
            buf_bytes(b, SRC[pcx.nodes[ty].start..pcx.nodes[ty].end]);
        }
    }
}

// The help of an unknown field `name` of variant node vnode: the nearest
// field, else the fields.
fn help_fields(vnode: i64, name: i64, pcx: inout Ctx<Comp>) {
    let names = pcx.nodes[vnode].d;
    var near = near_to(name);
    for i in 0..pcx.nodes[names].count {
        near.offer(pcx.nodes[child(names, i, pcx)].a, &pcx);
    }
    if near.best >= 0 {
        near.help(&pcx);
        return;
    }
    let f = buf_new();
    buf_fields(f, vnode, true, pcx);
    err_help_fmt(format_args("its fields: {}", buf_slice(f)), pcx);
}

// An error at `pos` naming variant `name` of the enum last found:
// `before` 'E::V' `after`.
fn variant_error(pos: i64, before: *u8, name: i64, after: *u8, pcx: inout Ctx<Comp>) {
    err_begin(pos, &pcx);
    err_str(before, pcx);
    let b = buf_new();
    buf_variant(b, name, pcx);
    err_fmt(buf_slice(b), pcx);
    err_str(after, pcx);
}

// (0.17) Struct literal n when it names a variant (`E::V { a: x, b: y }`):
// made the call `E::V(x, y)`, to be checked again; false when n names no
// variant (a struct's literal).
pub fn variant_literal(n: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let vnode = literal_variant(n, &pcx);
        if vnode == 0 {
            return false;
        }
        let name = pcx.nodes[n].a;
        if vnode < 0 {
            err_begin(pcx.nodes[n].start, &pcx);
            err_fmt(format_args("no variant '{}' in enum '{}'", sym_text(name, pcx),
                sym_text(ENUMS[pcx.lit_enum].name, pcx)), pcx);
            // (0.25.2.1: the nearest variants)
            pcx.near_all.count = 0;
            pcx.near_collect = true;
            var near = near_to(name);
            for i in 0..ENUMS[pcx.lit_enum].variant_count {
                near.offer(pcx.variants[enum_variant(pcx.lit_enum, i)].name, &pcx);
            }
            pcx.near_collect = false;
            near.help(&pcx);
            if BUFS[pcx.err_help].len == 0 {
                help_nearest(c"its variants: ", name, pcx);
            }
            err_end(&pcx);
        }
        check_shorthands(n, &pcx);
        let callee = literal_callee(n, &pcx);
        let names = pcx.nodes[vnode].d;
        let count = pcx.nodes[vnode].count;
        if count == 0 && pcx.nodes[n].count == 0 {
            // `E::V {}`: the variant without fields.
            let start = pcx.nodes[n].start;
            let end = pcx.nodes[n].end;
            pcx.nodes[n] = pcx.nodes[callee];
            pcx.nodes[n].start = start;
            pcx.nodes[n].end = end;
            return true;
        }
        if names == 0 {
            variant_error(pcx.nodes[n].start, c"variant '", name, c"' has no named fields", &pcx);
            let b = buf_new();
            buf_variant(b, name, pcx);
            if count == 0 {
                err_help(c"write it without braces", pcx);
            } else {
                buf_str(b, c"(");
                for i in 0..count {
                    if i > 0 {
                        buf_str(b, c", ");
                    }
                    buf_str(b, c"_");
                }
                buf_str(b, c")");
                err_help(c"its fields are by position", pcx);
            }
            err_try_fmt(buf_slice(b), pcx);
            err_end(&pcx);
        }
        let slots = alloc_array::<i64>(count + 1);
        var ordered = true;
        var last = -1;
        for i in 0..pcx.nodes[n].count {
            let init = child(n, i, pcx);
            let k = field_index(vnode, pcx.nodes[init].a, pcx);
            if k < 0 {
                err_begin(pcx.nodes[init].start, &pcx);
                err_fmt(format_args("no field '{}' in variant '", sym_text(pcx.nodes[init].a, pcx)),
                    pcx);
                let b = buf_new();
                buf_variant(b, name, pcx);
                err_fmt(buf_slice(b), pcx);
                err_str(c"'", pcx);
                help_fields(vnode, pcx.nodes[init].a, &pcx);
                err_end(&pcx);
            }
            if slots[k] != 0 {
                name_error(pcx.nodes[init].start, c"duplicate field '", pcx.nodes[init].a,
                    c"' in constructor", &pcx);
            }
            slots[k] = pcx.nodes[init].b;
            if k < last {
                ordered = false;
            }
            last = k;
        }
        for k in 0..count {
            if slots[k] == 0 {
                err_begin(pcx.nodes[n].start, &pcx);
                err_fmt(format_args("missing field '{}' in variant '",
                    sym_text(pcx.nodes[child(names, k, pcx)].a, pcx)), pcx);
                let b = buf_new();
                buf_variant(b, name, pcx);
                err_fmt(buf_slice(b), pcx);
                err_str(c"' constructor", pcx);
                let f = buf_new();
                buf_fields(f, vnode, true, pcx);
                err_help_fmt(format_args("its fields: {}", buf_slice(f)), pcx);
                err_end(&pcx);
            }
        }
        var order = 0;
        if !ordered {
            order = new_node(NodeKind::None, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
            let mark = list_begin(pcx);
            for i in 0..pcx.nodes[n].count {
                list_push(field_index(vnode, pcx.nodes[child(n, i, pcx)].a, pcx), &pcx);
            }
            list_end(order, mark, &pcx);
        }
        let mark = list_begin(pcx);
        for k in 0..count {
            list_push(slots[k], &pcx);
        }
        list_end(n, mark, &pcx);
        free(slots as *u8);
        pcx.nodes[n].kind = NodeKind::Call;
        pcx.nodes[n].a = callee;
        pcx.nodes[n].g = 0;
        pcx.nodes[n].h = 0;
        pcx.nodes[n].z = order;
        pcx.nodes[n].p |= CALL_FIELDS;
        true
    }
}

// (0.17) `E::V(x, y)` (call n), or a pattern `E::V(p, q)`, for variant v
// (of enum type t) whose fields have names: the error, with the form to
// write.
pub fn positional_error(n: i64, v: i64, t: i64, pattern: bool, pcx: inout Ctx<Comp>) -> ! {
    let vnode = pcx.variants[v].node;
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"variant '", pcx);
    err_type(t, pcx);
    err_fmt(format_args("::{}' has named fields; ", sym_text(pcx.variants[v].name, pcx)), pcx);
    err_str(if pattern { c"match them by name" } else { c"give them by name" }, pcx);
    let b = buf_new();
    buf_type(b, t, pcx);
    buf_fmt(b, format_args("::{} {{ ", sym_text(pcx.variants[v].name, pcx)));
    let names = pcx.nodes[vnode].d;
    // (the values or patterns written, when there is one per field)
    let given = pcx.nodes[n].count == pcx.nodes[names].count;
    for i in 0..pcx.nodes[names].count {
        if i > 0 {
            buf_str(b, c", ");
        }
        let name = sym_text(pcx.nodes[child(names, i, pcx)].a, pcx);
        buf_bytes(b, name);
        if given {
            let text = SRC[pcx.nodes[child(n, i, pcx)].start..pcx.nodes[child(n, i, pcx)].end];
            if text != name {
                buf_str(b, c": ");
                buf_bytes(b, text);
            }
        } else if !pattern {
            buf_str(b, c": VALUE");
        }
    }
    buf_str(b, c" }");
    err_try_fmt(buf_slice(b), pcx);
    err_end(&pcx)
}

// (0.17) Pattern p `E::V { a, b: q, .. }` of variant v (enum type t): its
// list made the patterns in field order, a wildcard for each field left
// out (with `..`).
pub fn pattern_fields(p: i64, v: i64, t: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let vnode = pcx.variants[v].node;
        let names = pcx.nodes[vnode].d;
        let count = pcx.variants[v].field_count;
        if names == 0 && pcx.nodes[p].count > 0 {
            err_begin(pcx.nodes[p].start, &pcx);
            err_str(c"variant '", pcx);
            err_type(t, pcx);
            err_fmt(format_args("::{}' has no named fields", sym_text(pcx.variants[v].name, pcx)),
                pcx);
            let b = buf_new();
            buf_type(b, t, pcx);
            buf_fmt(b, format_args("::{}", sym_text(pcx.variants[v].name, pcx)));
            if count > 0 {
                buf_str(b, c"(");
                for i in 0..count {
                    if i > 0 {
                        buf_str(b, c", ");
                    }
                    buf_str(b, c"_");
                }
                buf_str(b, c")");
                err_help(c"match its fields by position", pcx);
            }
            err_try_fmt(buf_slice(b), pcx);
            err_end(&pcx);
        }
        let slots = alloc_array::<i64>(count + 1);
        for i in 0..pcx.nodes[p].count {
            let f = child(p, i, pcx);
            let k = field_index(vnode, pcx.nodes[f].a, pcx);
            if k < 0 {
                err_begin(pcx.nodes[f].start, &pcx);
                err_fmt(format_args("no field '{}' in variant '", sym_text(pcx.nodes[f].a, pcx)),
                    pcx);
                err_type(t, pcx);
                err_fmt(format_args("::{}'", sym_text(pcx.variants[v].name, pcx)), pcx);
                help_fields(vnode, pcx.nodes[f].a, &pcx);
                err_end(&pcx);
            }
            if slots[k] != 0 {
                name_error(pcx.nodes[f].start, c"field '", pcx.nodes[f].a,
                    c"' is matched twice in the pattern", &pcx);
            }
            slots[k] = pcx.nodes[f].b;
        }
        if (pcx.nodes[p].p & PAT_REST) == 0 {
            for k in 0..count {
                if slots[k] == 0 {
                    err_begin(pcx.nodes[p].start, &pcx);
                    err_str(c"the pattern of '", pcx);
                    err_type(t, pcx);
                    err_fmt(
                        format_args("::{}' does not mention field '{}'",
                            sym_text(pcx.variants[v].name, pcx),
                            sym_text(pcx.nodes[child(names, k, pcx)].a, pcx)), pcx);
                    err_help(c"match it too, or end the pattern with '..' to leave the rest out",
                        pcx);
                    let b = buf_new();
                    buf_type(b, t, pcx);
                    buf_fmt(b, format_args("::{} {{ ", sym_text(pcx.variants[v].name, pcx)));
                    for i in 0..pcx.nodes[p].count {
                        let f = child(p, i, pcx);
                        if (pcx.nodes[f].p & FIELD_SHORTHAND) != 0 {
                            buf_bytes(b, SRC[pcx.nodes[f].start..pcx.nodes[f].end]);
                        } else {
                            buf_fmt(b, format_args("{}: ", sym_text(pcx.nodes[f].a, pcx)));
                            buf_bytes(b,
                                SRC[
                                    pcx.nodes[pcx.nodes[f].b].start..pcx.nodes[pcx.nodes[f].b].end]);
                        }
                        buf_str(b, c", ");
                    }
                    buf_str(b, c".. }");
                    err_try_fmt(buf_slice(b), pcx);
                    err_end(&pcx);
                }
            }
        }
        let mark = list_begin(pcx);
        for k in 0..count {
            var q = slots[k];
            if q == 0 {
                q = new_node(NodeKind::PatWild, pcx.nodes[p].start, pcx.nodes[p].start, &pcx);
            }
            list_push(q, &pcx);
        }
        list_end(p, mark, &pcx);
        free(slots as *u8);
        pcx.nodes[p].c = (count > 0) as i64;
        pcx.nodes[p].p -= PAT_FIELDS;
    }
}

// (0.17) The help of `e.a` on a value of enum type t (or a pointer to
// one), when a variant has a field `a`: read it through a pattern. `base`:
// the expression e.
pub fn enum_field_help(t: i64, name: i64, base: i64, pcx: Ctx<Comp>) {
    unsafe {
        var e = t;
        if pcx.types[e].kind == TyKind::Ptr {
            e = pcx.types[e].a;
        }
        if pcx.types[e].kind != TyKind::Enum {
            return;
        }
        for i in 0..ENUMS[pcx.types[e].a].variant_count {
            let v = enum_variant(pcx.types[e].a, i);
            if field_index(pcx.variants[v].node, name, pcx) >= 0 {
                err_help(c"a variant's fields are read through a pattern (no '.field' on an enum)",
                    pcx);
                let b = buf_new();
                buf_str(b, c"if let ");
                buf_type(b, e, pcx);
                buf_fmt(b,
                    format_args("::{} {{ {}, .. }} = ", sym_text(pcx.variants[v].name, pcx),
                        sym_text(name, pcx)));
                buf_bytes(b, SRC[pcx.nodes[base].start..pcx.nodes[base].end]);
                buf_str(b, c" { ... }");
                err_try_fmt(buf_slice(b), pcx);
                return;
            }
        }
    }
}
