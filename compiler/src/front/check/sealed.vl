// Field privacy (0.26.0, Rust's rule; 0.16's `#[sealed]` made the
// default): a struct's field not marked `pub` is visible in the module
// that declares the struct and in the modules inside it, and nowhere
// else; a literal of the struct needs every field visible (a struct with
// no fields has its literal anywhere). Std's modules are modules like
// any: a child sees its parent's private fields, a sibling does not. The
// compiler's own nodes (NODE_IMPLICIT: main's `Gpa {}`, the fields
// structural `==` compares, an f-string's `std::Interp` literal) are let
// through, and so are closure environments and C's structs.
use crate::base::{buf_bytes, get_src, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_position, err_begin, err_end_soft, err_fix, err_fixable, err_help, err_help_sym, err_str,
    err_sym,
};
use crate::front::ast::{NODE_IMPLICIT, child};
use crate::front::check::collect::find_generic_method;
use crate::front::check::unsafety::NODE_NO_READ;
use crate::front::modules::{is_within, module_of, within_std};
use crate::front::modules::vis::{admits, restriction_span, vis_end_of, vis_where};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{MethodInfo, StructInfo, find_field, find_method, struct_type};
use crate::tools::fix::note_private_field;

pub const FIELD_PRIVATE: *mut u8 = c"field.private";
pub const FIELD_LITERAL_PRIVATE: *mut u8 = c"field.literal-private";

// Struct s's record, copied.
fn info(s: i64, pcx: &Ctx<Comp>) -> StructInfo {
    // UNSAFE: STRUCTS is the table of structs, a raw pointer (front/types).
    // SAFETY: every s here is a struct type's index (a TYPES entry's a, or
    // its template's), below the number of structs; the record is copied.
    unsafe { pcx.structs[s as usize] }
}

// The key (qualified name) of module m, a struct's module.
fn module_key(m: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: MODULES is the table of modules, a raw pointer (front/modules).
    // SAFETY: m is a struct's module, a module's index (>= 0: field_hidden
    // says no error before it checked), below module_count().
    unsafe { pcx.modules[m as usize].key }
}

// Method i's record, copied.
fn method(i: i64, pcx: &Ctx<Comp>) -> MethodInfo {
    // UNSAFE: METHODS is the table of methods, a raw pointer (front/types).
    // SAFETY: the caller's i is below METHOD_COUNT, the table's length.
    unsafe { pcx.methods[i as usize] }
}

// Function f's node, display name and return type.
fn fn_node(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: f >= 0 (the callers check) is a method's function or CUR_FN,
    // a function's index, below the number of functions.
    unsafe { pcx.fns[f as usize].node }
}

fn fn_display(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: as fn_node's: f >= 0 is a function's index.
    unsafe { pcx.fns[f as usize].display }
}

fn fn_ret(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: as fn_node's: f >= 0 is a function's index.
    unsafe { pcx.fns[f as usize].ret }
}

// The template of struct s (s when it is not an instance).
fn template_of(s: i64, pcx: &Ctx<Comp>) -> i64 {
    let tmpl = info(s, pcx).tmpl;
    if tmpl != 0 { tmpl - 1 } else { s }
}

// The declaration (a Field node) of field `field` of struct s, or 0.
fn field_node(s: i64, field: i64, pcx: &Ctx<Comp>) -> i64 {
    let t = info(template_of(s, pcx), pcx);
    if field < 0 || t.closure != 0 || t.node <= 0 || field >= pcx.nodes[t.node as usize].count {
        return 0;
    }
    child(t.node, field, pcx)
}

// Whether field `field` of struct s is private where node n is.
fn field_hidden(n: i64, s: i64, field: i64, pcx: &mut Ctx<Comp>) -> bool {
    let f = field_node(s, field, pcx);
    if f == 0 || (pcx.nodes[n as usize].p & NODE_IMPLICIT) != 0 {
        return false;
    }
    // (0.26.2: `pub(crate)`, `pub(super)`, `pub(in path)`: up to a module)
    if (pcx.nodes[f as usize].p & ITEM_PUBLIC) != 0 {
        return !admits(f, module_of(n, pcx), pcx);
    }
    let home = info(template_of(s, pcx), pcx).module;
    if home < 0 || home == pcx.c_module {
        return false;
    }
    !is_within(module_of(n, pcx), home, pcx)
}

// " module 'geometry'", for an error.
fn err_module(s: i64, pcx: &Ctx<Comp>) {
    err_str(c" module '", pcx);
    err_sym(module_key(info(template_of(s, pcx), pcx).module, pcx), pcx);
    err_str(c"'", pcx);
}

// "' is private to module 'geometry'" for field node f of struct s, or
// (0.26.2) "' is visible only in crate 'std'" for a restricted one.
fn err_privacy(f: i64, s: i64, pcx: &mut Ctx<Comp>) {
    let end = vis_end_of(f, pcx);
    if (pcx.nodes[f as usize].p & ITEM_PUBLIC) != 0 && end >= 0 {
        err_str(c"' is visible only in ", pcx);
        buf_bytes(pcx.err, vis_where(end, pcx));
        return;
    }
    err_str(c"' is private to", pcx);
    err_module(s, pcx);
}

// Whether struct s is std's.
fn std_struct(s: i64, pcx: &Ctx<Comp>) -> bool {
    within_std(info(template_of(s, pcx), pcx).module, pcx)
}

// Whether struct s is one of std's containers and allocators, whose
// fields only their methods change.
fn container(s: i64, pcx: &mut Ctx<Comp>) -> bool {
    let name = info(template_of(s, pcx), pcx).name;
    std_struct(s, pcx) && (name == intern_c(c"Vec", pcx) || name == intern_c(c"Buf", pcx)
        || name == intern_c(c"HashMap", pcx) || name == intern_c(c"Arena", pcx)
        || name == intern_c(c"ScopedArena", pcx) || name == intern_c(c"FixedBuf", pcx)
        || name == intern_c(c"Gpa", pcx))
}

// The help of a program's private field (its Field node f): its
// declaration with `pub`, where it is: `make it public: 'pub len: i64' at
// FILE:L:C`, which `volec fix --only pub` writes. (0.26.2) A restricted
// one (`pub(super)`) is widened to its crate: `pub(crate) len: i64`.
fn help_field_public(f: i64, pcx: &mut Ctx<Comp>) {
    let start = pcx.nodes[f as usize].start;
    let (rs, re) = restriction_span(f, pcx);
    if rs >= 0 {
        err_help(c"make it visible in its crate: 'pub(crate)", pcx);
        buf_bytes(pcx.err_help, &get_src()[re as usize..pcx.nodes[f as usize].end as usize]);
    } else {
        err_help(c"make it public: 'pub ", pcx);
        buf_bytes(pcx.err_help, &get_src()[start as usize..pcx.nodes[f as usize].end as usize]);
    }
    err_help(c"' at ", pcx);
    buf_position(pcx.err_help, start, pcx);
    err_fixable(pcx);
}

// Ends the error being made with code `code`.
fn end_with(code: *mut u8, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = code;
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// Whether struct s has a method `name` (an instance: its template's too).
fn has_method(s: i64, name: i64, pcx: &mut Ctx<Comp>) -> bool {
    find_method(struct_type(s, pcx), name, pcx) >= 0
        || (info(s, pcx).tmpl != 0 && find_generic_method(info(s, pcx).tmpl, name, pcx) >= 0)
}

// Field access n (a FieldAccess, x = the field) of struct s.
pub fn check_field(n: i64, s: i64, pcx: &mut Ctx<Comp>) {
    let field = pcx.nodes[n as usize].x;
    if !field_hidden(n, s, field, pcx) {
        return;
    }
    let name = pcx.nodes[n as usize].b;
    // (`volec fix --only pub` writes `pub` where the field is written)
    note_private_field(field_node(s, field, pcx), pcx);
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"field '", pcx);
    err_sym(name, pcx);
    err_str(c"' of '", pcx);
    err_sym(info(s, pcx).name, pcx);
    err_privacy(field_node(s, field, pcx), s, pcx);
    // (a read of a method's name; a write, `v.len = n`, `&v.len`, has no
    // method to call)
    if (pcx.nodes[n as usize].p & NODE_NO_READ) == 0 && has_method(s, name, pcx) {
        err_help(c"call its method: '.", pcx);
        err_help_sym(name, pcx);
        err_help(c"()'", pcx);
        // (0.18) the fix: the call's `()`
        if pcx.nodes[n as usize].end > pcx.nodes[n as usize].start
            && get_src()[(pcx.nodes[n as usize].end - 1) as usize] != b')' {
            err_fix(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, b"()", pcx);
        }
    } else if std_struct(s, pcx) {
        err_help(c"use the methods of '", pcx);
        err_help_sym(info(template_of(s, pcx), pcx).name, pcx);
        if container(s, pcx) {
            err_help(c"' (its fields change only through them: `.len()`, `.as_slice()`, ...)", pcx);
        } else {
            err_help(c"'", pcx);
        }
    } else {
        help_field_public(field_node(s, field, pcx), pcx);
    }
    end_with(FIELD_PRIVATE, pcx);
}

// (0.17) Whether `x.len` on std's struct s, at node n, reads as `x.len()`:
// s has a `len` method and no `len` field n can see (Vec's is private, a
// Buf has none), so both spellings mean the length.
pub fn len_reads_as_method(n: i64, s: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.std_module < 0 || !within_std(info(template_of(s, pcx), pcx).module, pcx) {
        return false;
    }
    let name = intern_c(c"len", pcx);
    let field = find_field(s, name, pcx);
    if field >= 0 && !field_hidden(n, s, field, pcx) {
        return false;
    }
    has_method(s, name, pcx)
}

// The help of a literal of program struct s: its module's functions that
// return one (`Rect::new`, at most three), else a function of its module.
fn help_constructors(s: i64, pcx: &mut Ctx<Comp>) {
    let t = struct_type(s, pcx);
    let mut named: i64 = 0;
    if info(s, pcx).generic == 0 && info(s, pcx).tmpl == 0 {
        for i in 0..pcx.methods.len() as i64 {
            let m = method(i, pcx);
            if m.ty == t && m.f >= 0 && fn_ret(m.f, pcx) == t && named < 3 {
                let d = fn_node(m.f, pcx);
                let takes_self = d > 0 && pcx.nodes[d as usize].count > 0
                    && pcx.nodes[child(d, 0, pcx) as usize].a == pcx.self_sym;
                if !takes_self {
                    err_help(if named == 0 { c"make one with its constructor: '" } else { c", '" },
                        pcx);
                    err_help_sym(info(s, pcx).name, pcx);
                    err_help(c"::", pcx);
                    err_help_sym(m.name, pcx);
                    err_help(c"'", pcx);
                    named += 1;
                }
            }
        }
    }
    if named == 0 && info(s, pcx).tmpl != 0
        && find_generic_method(info(s, pcx).tmpl, intern_c(c"new", pcx), pcx) >= 0 {
        // (a generic struct's: its `new`)
        err_help(c"make one with its constructor: '", pcx);
        err_help_sym(info(template_of(s, pcx), pcx).name, pcx);
        err_help(c"::new'", pcx);
        named = 1;
    }
    if named == 0 {
        err_help(c"use a function of", pcx);
        buf_bytes(pcx.err_help, b" module '");
        err_help_sym(module_key(info(template_of(s, pcx), pcx).module, pcx), pcx);
        err_help(c"' that returns a '", pcx);
        err_help_sym(info(template_of(s, pcx), pcx).name, pcx);
        err_help(c"'", pcx);
    }
}

// Struct literal n of struct s: whether it may be made here, every field
// visible (its fields are checked then).
pub fn check_literal(n: i64, s: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut hidden: i64 = -1;
    for f in 0..info(s, pcx).field_count {
        if field_hidden(n, s, f, pcx) {
            if hidden < 0 {
                hidden = f;
            }
            // (`volec fix --only pub`: every field the literal names)
            note_private_field(field_node(s, f, pcx), pcx);
        }
    }
    if hidden < 0 {
        return true;
    }
    let name = info(template_of(s, pcx), pcx).name;
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"cannot make a '", pcx);
    err_sym(info(s, pcx).name, pcx);
    err_str(c"' here: its field '", pcx);
    err_sym(pcx.nodes[field_node(s, hidden, pcx) as usize].a, pcx);
    err_privacy(field_node(s, hidden, pcx), s, pcx);
    let cur = pcx.cur_fn;
    let in_std = std_struct(s, pcx);
    if in_std && name == intern_c(c"Gpa", pcx)
        && crate::front::ambient::test_gpa_help(if cur >= 0 { fn_node(cur, pcx) } else { -1 },
            if cur >= 0 { sym_text(fn_display(cur, pcx), pcx) } else { b"" }, pcx) {
        // (0.25.2.1: in a test, its parameter)
    } else if in_std && name == intern_c(c"Gpa", pcx) {
        err_help(c"a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)' and is passed down as a parameter",
            pcx);
    } else if in_std && name == intern_c(c"ScopedArena", pcx) {
        err_help(c"a scope's arena comes from 'arena_scope(gpa, |s: ScopedArena| ...)' or 'a.scope(|s: ScopedArena| ...)'", pcx);
    } else if in_std && name == intern_c(c"Arena", pcx) {
        err_help(
            c"make one with its constructor: 'Arena::new_in(gpa)'", pcx);
    } else if in_std && name == intern_c(c"FixedBuf", pcx) {
        err_help(c"make one with its constructor: 'FixedBuf::new(mem)'", pcx);
    } else if in_std && (name == intern_c(c"Vec", pcx) || name == intern_c(c"Buf", pcx)
        || name == intern_c(c"HashMap", pcx)) {
        err_help(c"make one with its constructor: '", pcx);
        err_help_sym(name, pcx);
        // (0.26.3: no static holds one, alloc.static)
        err_help(c"::new_in(gpa)'", pcx);
    } else {
        help_constructors(s, pcx);
    }
    end_with(FIELD_LITERAL_PRIVATE, pcx);
    false
}
