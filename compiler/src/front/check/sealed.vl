// Field privacy (0.26.0, Rust's rule; 0.16's `#[sealed]` made the
// default): a struct's field not marked `pub` is visible in the module
// that declares the struct and in the modules inside it, and nowhere
// else; a literal of the struct needs every field visible (a struct with
// no fields has its literal anywhere). Std's modules are modules like
// any: a child sees its parent's private fields, a sibling does not. The
// compiler's own nodes (NODE_IMPLICIT: main's `Gpa {}`, the fields
// structural `==` compares, an f-string's `std::Interp` literal) are let
// through, and so are closure environments and C's structs.
use crate::base::{SRC, buf_bytes, intern_c, sym_text};
use crate::base::diag::{
    ERR_HELP, ERR_KIND, buf_position, err_begin, err_end_soft, err_fix, err_fixable, err_help,
    err_help_sym, err_str, err_sym,
};
use crate::front::ast::{NODES, NODE_IMPLICIT, child};
use crate::front::check::SELF_SYM;
use crate::front::check::collect::find_generic_method;
use crate::front::check::unsafety::NODE_NO_READ;
use crate::front::modules::{C_MODULE, MODULES, STD_MODULE, is_within, module_of, within_std};
use crate::front::modules::vis::{admits, restriction_span, vis_end_of, vis_where};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{
    FNS, METHODS, METHOD_COUNT, MethodInfo, STRUCTS, StructInfo, find_field, find_method,
    struct_type,
};
use crate::tools::fix::note_private_field;

pub const FIELD_PRIVATE: *u8 = c"field.private";
pub const FIELD_LITERAL_PRIVATE: *u8 = c"field.literal-private";

// Struct s's record, copied.
fn info(s: i64) -> StructInfo {
    // UNSAFE: STRUCTS is the table of structs, a raw pointer (front/types).
    // SAFETY: every s here is a struct type's index (a TYPES entry's a, or
    // its template's), below the number of structs; the record is copied.
    unsafe { STRUCTS[s] }
}

// The key (qualified name) of module m, a struct's module.
fn module_key(m: i64) -> i64 {
    // UNSAFE: MODULES is the table of modules, a raw pointer (front/modules).
    // SAFETY: m is a struct's module, a module's index (>= 0: field_hidden
    // says no error before it checked), below module_count().
    unsafe { MODULES[m].key }
}

// Method i's record, copied.
fn method(i: i64) -> MethodInfo {
    // UNSAFE: METHODS is the table of methods, a raw pointer (front/types).
    // SAFETY: the caller's i is below METHOD_COUNT, the table's length.
    unsafe { METHODS[i] }
}

// Function f's node, display name and return type.
fn fn_node(f: i64) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: f >= 0 (the callers check) is a method's function or CUR_FN,
    // a function's index, below the number of functions.
    unsafe { FNS[f].node }
}

fn fn_display(f: i64) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: as fn_node's: f >= 0 is a function's index.
    unsafe { FNS[f].display }
}

fn fn_ret(f: i64) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: as fn_node's: f >= 0 is a function's index.
    unsafe { FNS[f].ret }
}

// The template of struct s (s when it is not an instance).
fn template_of(s: i64) -> i64 {
    let tmpl = info(s).tmpl;
    if tmpl != 0 { tmpl - 1 } else { s }
}

// The declaration (a Field node) of field `field` of struct s, or 0.
fn field_node(s: i64, field: i64) -> i64 {
    let t = info(template_of(s));
    if field < 0 || t.closure != 0 || t.node <= 0 || field >= NODES[t.node].count {
        return 0;
    }
    child(t.node, field)
}

// Whether field `field` of struct s is private where node n is.
fn field_hidden(n: i64, s: i64, field: i64) -> bool {
    let f = field_node(s, field);
    if f == 0 || (NODES[n].p & NODE_IMPLICIT) != 0 {
        return false;
    }
    // (0.26.2: `pub(crate)`, `pub(super)`, `pub(in path)`: up to a module)
    if (NODES[f].p & ITEM_PUBLIC) != 0 {
        return !admits(f, module_of(n));
    }
    let home = info(template_of(s)).module;
    if home < 0 || home == C_MODULE {
        return false;
    }
    !is_within(module_of(n), home)
}

// " module 'geometry'", for an error.
fn err_module(s: i64) {
    err_str(c" module '");
    err_sym(module_key(info(template_of(s)).module));
    err_str(c"'");
}

// "' is private to module 'geometry'" for field node f of struct s, or
// (0.26.2) "' is visible only in crate 'std'" for a restricted one.
fn err_privacy(f: i64, s: i64) {
    let end = vis_end_of(f);
    if (NODES[f].p & ITEM_PUBLIC) != 0 && end >= 0 {
        err_str(c"' is visible only in ");
        buf_bytes(crate::base::diag::ERR, vis_where(end));
        return;
    }
    err_str(c"' is private to");
    err_module(s);
}

// Whether struct s is std's.
fn std_struct(s: i64) -> bool {
    within_std(info(template_of(s)).module)
}

// Whether struct s is one of std's containers and allocators, whose
// fields only their methods change.
fn container(s: i64) -> bool {
    let name = info(template_of(s)).name;
    std_struct(s) && (name == intern_c(c"Vec") || name == intern_c(c"Buf")
        || name == intern_c(c"HashMap") || name == intern_c(c"Arena")
        || name == intern_c(c"ScopedArena") || name == intern_c(c"FixedBuf")
        || name == intern_c(c"Gpa"))
}

// The help of a program's private field (its Field node f): its
// declaration with `pub`, where it is: `make it public: 'pub len: i64' at
// FILE:L:C`, which `volec fix --only pub` writes. (0.26.2) A restricted
// one (`pub(super)`) is widened to its crate: `pub(crate) len: i64`.
fn help_field_public(f: i64) {
    let start = NODES[f].start;
    let (rs, re) = restriction_span(f);
    if rs >= 0 {
        err_help(c"make it visible in its crate: 'pub(crate)");
        buf_bytes(ERR_HELP, SRC[re..NODES[f].end]);
    } else {
        err_help(c"make it public: 'pub ");
        buf_bytes(ERR_HELP, SRC[start..NODES[f].end]);
    }
    err_help(c"' at ");
    buf_position(ERR_HELP, start);
    err_fixable();
}

// Ends the error being made with code `code`.
fn end_with(code: *u8) {
    let saved = ERR_KIND;
    ERR_KIND = code;
    err_end_soft();
    ERR_KIND = saved;
}

// Whether struct s has a method `name` (an instance: its template's too).
fn has_method(s: i64, name: i64) -> bool {
    find_method(struct_type(s), name) >= 0
        || (info(s).tmpl != 0 && find_generic_method(info(s).tmpl, name) >= 0)
}

// Field access n (a FieldAccess, x = the field) of struct s.
pub fn check_field(n: i64, s: i64) {
    let field = NODES[n].x;
    if !field_hidden(n, s, field) {
        return;
    }
    let name = NODES[n].b;
    // (`volec fix --only pub` writes `pub` where the field is written)
    note_private_field(field_node(s, field));
    err_begin(NODES[n].start);
    err_str(c"field '");
    err_sym(name);
    err_str(c"' of '");
    err_sym(info(s).name);
    err_privacy(field_node(s, field), s);
    // (a read of a method's name; a write, `v.len = n`, `&v.len`, has no
    // method to call)
    if (NODES[n].p & NODE_NO_READ) == 0 && has_method(s, name) {
        err_help(c"call its method: '.");
        err_help_sym(name);
        err_help(c"()'");
        // (0.18) the fix: the call's `()`
        if NODES[n].end > NODES[n].start && SRC[NODES[n].end - 1] != ')' {
            err_fix(NODES[n].end, NODES[n].end, "()");
        }
    } else if std_struct(s) {
        err_help(c"use the methods of '");
        err_help_sym(info(template_of(s)).name);
        if container(s) {
            err_help(c"' (its fields change only through them: `.len()`, `.as_slice()`, ...)");
        } else {
            err_help(c"'");
        }
    } else {
        help_field_public(field_node(s, field));
    }
    end_with(FIELD_PRIVATE);
}

// (0.17) Whether `x.len` on std's struct s, at node n, reads as `x.len()`:
// s has a `len` method and no `len` field n can see (Vec's is private, a
// Buf has none), so both spellings mean the length.
pub fn len_reads_as_method(n: i64, s: i64) -> bool {
    if STD_MODULE < 0 || !within_std(info(template_of(s)).module) {
        return false;
    }
    let name = intern_c(c"len");
    let field = find_field(s, name);
    if field >= 0 && !field_hidden(n, s, field) {
        return false;
    }
    has_method(s, name)
}

// The help of a literal of program struct s: its module's functions that
// return one (`Rect::new`, at most three), else a function of its module.
fn help_constructors(s: i64) {
    let t = struct_type(s);
    var named = 0;
    if info(s).generic == 0 && info(s).tmpl == 0 {
        for i in 0..METHOD_COUNT {
            let m = method(i);
            if m.ty == t && m.f >= 0 && fn_ret(m.f) == t && named < 3 {
                let d = fn_node(m.f);
                let takes_self = d > 0 && NODES[d].count > 0 && NODES[child(d, 0)].a == SELF_SYM;
                if !takes_self {
                    err_help(if named == 0 { c"make one with its constructor: '" } else { c", '" });
                    err_help_sym(info(s).name);
                    err_help(c"::");
                    err_help_sym(m.name);
                    err_help(c"'");
                    named += 1;
                }
            }
        }
    }
    if named == 0 && info(s).tmpl != 0 && find_generic_method(info(s).tmpl, intern_c(c"new")) >= 0 {
        // (a generic struct's: its `new`)
        err_help(c"make one with its constructor: '");
        err_help_sym(info(template_of(s)).name);
        err_help(c"::new'");
        named = 1;
    }
    if named == 0 {
        err_help(c"use a function of");
        buf_bytes(ERR_HELP, " module '");
        err_help_sym(module_key(info(template_of(s)).module));
        err_help(c"' that returns a '");
        err_help_sym(info(template_of(s)).name);
        err_help(c"'");
    }
}

// Struct literal n of struct s: whether it may be made here, every field
// visible (its fields are checked then).
pub fn check_literal(n: i64, s: i64) -> bool {
    var hidden = -1;
    for f in 0..info(s).field_count {
        if field_hidden(n, s, f) {
            if hidden < 0 {
                hidden = f;
            }
            // (`volec fix --only pub`: every field the literal names)
            note_private_field(field_node(s, f));
        }
    }
    if hidden < 0 {
        return true;
    }
    let name = info(template_of(s)).name;
    err_begin(NODES[n].start);
    err_str(c"cannot make a '");
    err_sym(info(s).name);
    err_str(c"' here: its field '");
    err_sym(NODES[field_node(s, hidden)].a);
    err_privacy(field_node(s, hidden), s);
    let cur = crate::front::check::CUR_FN;
    let in_std = std_struct(s);
    if in_std && name == intern_c(c"Gpa")
        && crate::front::ambient::test_gpa_help(if cur >= 0 { fn_node(cur) } else { -1 },
            if cur >= 0 { sym_text(fn_display(cur)) } else { "" }) {
        // (0.25.2.1: in a test, its parameter)
    } else if in_std && name == intern_c(c"Gpa") {
        err_help(c"a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)' and is passed down as a parameter");
    } else if in_std && name == intern_c(c"ScopedArena") {
        err_help(c"a scope's arena comes from 'arena_scope(gpa, |s: ScopedArena| ...)' or 'a.scope(|s: ScopedArena| ...)'");
    } else if in_std && name == intern_c(c"Arena") {
        err_help(
            c"make one with its constructor: 'Arena::new_in(gpa)' (a static: 'Arena::none()')");
    } else if in_std && name == intern_c(c"FixedBuf") {
        err_help(c"make one with its constructor: 'FixedBuf::new(mem)'");
    } else if in_std && (name == intern_c(c"Vec") || name == intern_c(c"Buf")
        || name == intern_c(c"HashMap")) {
        err_help(c"make one with its constructor: '");
        err_help_sym(name);
        err_help(c"::new_in(gpa)' (a static: '");
        err_help_sym(name);
        err_help(c"::new_in(Arena::none())')");
    } else {
        help_constructors(s);
    }
    end_with(FIELD_LITERAL_PRIVATE);
    false
}
