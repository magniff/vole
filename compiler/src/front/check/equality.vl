// Structural equality (0.6).
//
// `a == b` on a struct, tuple, array or enum with fields compares field by
// field (floats as floats: NaN differs from itself); `!=` is its negation.
// The checker rewrites the comparison in place into a block it checks:
//     { let l = a; let r = b; l.f == r.f && l.g == r.g }        (struct)
//     { let l = a; let r = b; l.0 == r.0 && ... }               (tuple)
//     { let l = a; let r = b; let mut i = 0; let mut e = true;
//       while e && i < N { e = l[i] == r[i]; i += 1; } e }      (array)
//     { let l = a; let r = b; match (l, r) {
//         (E::V(x0, x1), E::V(y0, y1)) => x0 == y0 && x1 == y1,
//         ..., _ => false } }                                   (enum)
// whose inner comparisons are rewritten the same way when compound.

use crate::base::{buf_int, buf_new, buf_str, intern_buf, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    ARM_SYNTHETIC, NODE_IMPLICIT, NODE_IN_BOUNDS, REPR_UNION, list_begin, list_end, list_push,
    new_node,
};
use crate::front::ast::NodeKind::{
    Arm, Assign, Binary, Block, Bool, ExprStmt, FieldAccess, Ident, Index, Int, Let, Match, PatBind,
    PatTuple, PatVariant, PatWild, Tuple, TupleField, Unary, While,
};
use crate::front::check::{pop_scope, push_scope};
use crate::front::check::check_mode::check_expr;
use crate::front::lexer::{SUF_NONE, SUF_USIZE, Tok};
use crate::front::patterns::check_pattern;
use crate::front::traits::{has_impl, std_trait, unmet_impl_arg};
use crate::front::types::{
    TY_BOOL, TyKind, enum_variant, is_fieldless_enum, is_fn_type, is_numeric, is_pointer,
    struct_field, type_elem, variant_field,
};

// 0 when values of type `ty` can be compared with ==, else a type in it
// that cannot: the scalars, the types with an `impl Eq`, and the
// compounds (slices too) whose parts all can.
pub fn eq_unsupported(ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if is_numeric(ty) || ty == TY_BOOL || is_pointer(ty, pcx) || is_fn_type(ty, pcx)
        || is_fieldless_enum(ty, pcx) {
        return 0;
    }
    // (0.14: a part with its own `==`, an `impl Eq`, is compared by
    // it, as `==` on it alone is; a slice of comparable elements by
    // its elements, std loaded or not)
    if has_impl(std_trait(c"Eq", pcx), ty, pcx) {
        return 0;
    }
    // (0.15: `Vec<U>` with no == on U: not its fields, a pointer)
    let unmet = unmet_impl_arg(std_trait(c"Eq", pcx), ty, pcx);
    if unmet != 0 {
        return unmet;
    }
    let kind = pcx.types[ty as usize].kind;
    if kind == TyKind::Struct {
        let s = pcx.types[ty as usize].a;
        if (pcx.structs[s as usize].repr & REPR_UNION) != 0 {
            return ty;
        }
        for i in 0..pcx.structs[s as usize].field_count {
            let bad = eq_unsupported((struct_field(s, i, pcx)).ty, pcx);
            if bad != 0 { return bad; }
        }
        return 0;
    }
    if kind == TyKind::Tuple {
        for i in 0..pcx.types[ty as usize].count {
            let bad = eq_unsupported(type_elem(ty, i, pcx), pcx);
            if bad != 0 { return bad; }
        }
        return 0;
    }
    if kind == TyKind::Array || kind == TyKind::Slice {
        return eq_unsupported(pcx.types[ty as usize].a, pcx);
    }
    if kind == TyKind::Enum {
        let e = pcx.types[ty as usize].a;
        for i in 0..(pcx.enums[e as usize]).variant_count {
            let v = enum_variant(e, i, pcx);
            for k in 0..pcx.variants[v as usize].field_count {
                let bad = eq_unsupported(variant_field(v, k, pcx), pcx);
                if bad != 0 { return bad; }
            }
        }
        return 0;
    }
    ty
}

// RULE: F26.4 (0.28.0, the rust edition) 0 when `==` on type `ty` is
// PartialEq's, as rustc's: a struct or an enum has an impl of it (a
// derive's), a tuple, an array or a slice is of such. Else the type in it
// that has none (rustc E0369): the fields are not compared in its place.
pub fn partial_eq_missing(ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = pcx.types[ty as usize].kind;
    if kind == TyKind::Struct || kind == TyKind::Enum {
        let tr = std_trait(c"PartialEq", pcx);
        if tr < 0 || has_impl(tr, ty, pcx) {
            return 0;
        }
        let unmet = unmet_impl_arg(tr, ty, pcx);
        return if unmet != 0 { unmet } else { ty };
    }
    if kind == TyKind::Tuple {
        for i in 0..pcx.types[ty as usize].count {
            let bad = partial_eq_missing(type_elem(ty, i, pcx), pcx);
            if bad != 0 {
                return bad;
            }
        }
        return 0;
    }
    if kind == TyKind::Array || kind == TyKind::Slice {
        return partial_eq_missing(pcx.types[ty as usize].a, pcx);
    }
    0
}

fn eq_ident(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(Ident, pos, pos, pcx);
    pcx.nodes[n as usize].a = name;
    n
}

fn eq_binary(op: Tok, lhs: i64, rhs: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(Binary, pos, pos, pcx);
    pcx.nodes[n as usize].op = op;
    pcx.nodes[n as usize].b = lhs;
    pcx.nodes[n as usize].c = rhs;
    n
}

fn eq_bool(value: bool, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(Bool, pos, pos, pcx);
    pcx.nodes[n as usize].a = value as i64;
    n
}

fn eq_int(value: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(Int, pos, pos, pcx);
    pcx.nodes[n as usize].a = value;
    pcx.nodes[n as usize].b = SUF_NONE;
    n
}

// `name.len`, the length of the slice named `name`.
fn eq_len(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(FieldAccess, pos, pos, pcx);
    pcx.nodes[n as usize].a = eq_ident(name, pos, pcx);
    pcx.nodes[n as usize].b = intern_c(c"len", pcx);
    n
}

fn eq_bind(name: i64, mutable: bool, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let p = new_node(PatBind, pos, pos, pcx);
    pcx.nodes[p as usize].a = name;
    pcx.nodes[p as usize].b = mutable as i64;
    p
}

fn eq_let(pattern: i64, init: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(Let, pos, pos, pcx);
    pcx.nodes[n as usize].a = pattern;
    pcx.nodes[n as usize].c = init;
    n
}

fn eq_stmt(expr: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(ExprStmt, pos, pos, pcx);
    pcx.nodes[n as usize].a = expr;
    pcx.nodes[n as usize].b = 1;
    n
}

fn eq_assign(op: Tok, target: i64, value: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(Assign, pos, pos, pcx);
    pcx.nodes[n as usize].op = op;
    pcx.nodes[n as usize].b = target;
    pcx.nodes[n as usize].c = value;
    n
}

// `parts` conjoined with &&, `true` for none.
fn eq_and(mark: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let count = pcx.scratch.len() as i64 - mark;
    if count == 0 {
        return eq_bool(true, pos, pcx);
    }
    let mut e = (pcx.scratch[mark as usize]);
    for i in 1..count {
        e = eq_binary(Tok::AmpAmp, e, (pcx.scratch[(mark + i) as usize]), pos, pcx);
    }
    pcx.scratch.truncate(mark as usize);
    e
}

// The comparison of the values named `l` and `r` (of type `ty`), as
// unchecked nodes.
fn eq_compare(ty: i64, l: i64, r: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = pcx.types[ty as usize].kind;
    if kind == TyKind::Struct {
        let s = pcx.types[ty as usize].a;
        let mark = pcx.scratch.len() as i64;
        for i in 0..pcx.structs[s as usize].field_count {
            let name = (struct_field(s, i, pcx)).name;
            let a = new_node(FieldAccess, pos, pos, pcx);
            pcx.nodes[a as usize].a = eq_ident(l, pos, pcx);
            pcx.nodes[a as usize].b = name;
            // (0.16: past #[sealed])
            pcx.nodes[a as usize].p = NODE_IMPLICIT;
            let b = new_node(FieldAccess, pos, pos, pcx);
            pcx.nodes[b as usize].a = eq_ident(r, pos, pcx);
            pcx.nodes[b as usize].b = name;
            pcx.nodes[b as usize].p = NODE_IMPLICIT;
            let eq = eq_binary(Tok::EqEq, a, b, pos, pcx);
            pcx.scratch.push(eq);
        }
        return eq_and(mark, pos, pcx);
    }
    if kind == TyKind::Tuple {
        let mark = pcx.scratch.len() as i64;
        for i in 0..pcx.types[ty as usize].count {
            let a = new_node(TupleField, pos, pos, pcx);
            pcx.nodes[a as usize].a = eq_ident(l, pos, pcx);
            pcx.nodes[a as usize].b = i;
            let b = new_node(TupleField, pos, pos, pcx);
            pcx.nodes[b as usize].a = eq_ident(r, pos, pcx);
            pcx.nodes[b as usize].b = i;
            let eq = eq_binary(Tok::EqEq, a, b, pos, pcx);
            pcx.scratch.push(eq);
        }
        return eq_and(mark, pos, pcx);
    }
    // (0.14: a slice the same way, its length first: `[u8] == [u8]`
    // needs no std)
    if kind == TyKind::Array || kind == TyKind::Slice {
        let i_name = intern_c(c"==i", pcx);
        let e_name = intern_c(c"==e", pcx);
        let block = new_node(Block, pos, pos, pcx);
        let li = new_node(Index, pos, pos, pcx);
        pcx.nodes[li as usize].a = eq_ident(l, pos, pcx);
        pcx.nodes[li as usize].b = eq_ident(i_name, pos, pcx);
        let ri = new_node(Index, pos, pos, pcx);
        pcx.nodes[ri as usize].a = eq_ident(r, pos, pcx);
        pcx.nodes[ri as usize].b = eq_ident(i_name, pos, pcx);
        let body = new_node(Block, pos, pos, pcx);
        let body_mark = list_begin(pcx);
        list_push(eq_stmt(eq_assign(Tok::Eq, eq_ident(e_name, pos, pcx),
            eq_binary(Tok::EqEq, li, ri, pos, pcx), pos, pcx), pos, pcx), pcx);
        list_push(eq_stmt(eq_assign(Tok::PlusEq, eq_ident(i_name, pos, pcx),
            eq_int(1, pos, pcx), pos, pcx),
            pos, pcx), pcx);
        list_end(body, body_mark, pcx);
        // (0.16: a counted loop whose indexes are in bounds: no
        // diverge, no panic)
        pcx.nodes[li as usize].p |= NODE_IN_BOUNDS;
        pcx.nodes[ri as usize].p |= NODE_IN_BOUNDS;
        let w = new_node(While, pos, pos, pcx);
        pcx.nodes[w as usize].p |= NODE_IN_BOUNDS;
        let len = if kind == TyKind::Slice { eq_len(l, pos, pcx) }
            else { eq_int(pcx.types[ty as usize].b, pos, pcx) };
        pcx.nodes[w as usize].b = eq_binary(Tok::AmpAmp, eq_ident(e_name, pos, pcx),
            eq_binary(Tok::Lt, eq_ident(i_name, pos, pcx), len, pos, pcx), pos, pcx);
        let same_len = if kind == TyKind::Slice {
            eq_binary(Tok::EqEq, eq_len(l, pos, pcx), eq_len(r, pos, pcx), pos, pcx)
        } else {
            eq_bool(true, pos, pcx)
        };
        pcx.nodes[w as usize].c = body;
        // (0.26.2: the index a usize, as the length)
        let zero = eq_int(0, pos, pcx);
        pcx.nodes[zero as usize].b = SUF_USIZE;
        let mark = list_begin(pcx);
        list_push(eq_let(eq_bind(i_name, true, pos, pcx), zero, pos, pcx), pcx);
        list_push(eq_let(eq_bind(e_name, true, pos, pcx), same_len, pos, pcx), pcx);
        list_push(eq_stmt(w, pos, pcx), pcx);
        list_end(block, mark, pcx);
        pcx.nodes[block as usize].a = eq_ident(e_name, pos, pcx);
        return block;
    }
    // An enum with fields: a match on the pair.
    let e = pcx.types[ty as usize].a;
    let m = new_node(Match, pos, pos, pcx);
    let pair = new_node(Tuple, pos, pos, pcx);
    let pair_mark = list_begin(pcx);
    list_push(eq_ident(l, pos, pcx), pcx);
    list_push(eq_ident(r, pos, pcx), pcx);
    list_end(pair, pair_mark, pcx);
    pcx.nodes[m as usize].a = pair;
    let arms = list_begin(pcx);
    for i in 0..(pcx.enums[e as usize]).variant_count {
        let v = enum_variant(e, i, pcx);
        let count = pcx.variants[v as usize].field_count;
        let pats = new_node(PatTuple, pos, pos, pcx);
        let pats_mark = list_begin(pcx);
        for side in 0..2 {
            let pv = new_node(PatVariant, pos, pos, pcx);
            pcx.nodes[pv as usize].a = (pcx.enums[e as usize]).name;
            pcx.nodes[pv as usize].b = pcx.variants[v as usize].name;
            pcx.nodes[pv as usize].c = (count > 0) as i64;
            pcx.nodes[pv as usize].y = ty;
            let fields_mark = list_begin(pcx);
            for k in 0..count {
                list_push(eq_bind(eq_field_name(side, k, pcx), false, pos, pcx), pcx);
            }
            list_end(pv, fields_mark, pcx);
            list_push(pv, pcx);
        }
        list_end(pats, pats_mark, pcx);
        let mark = pcx.scratch.len() as i64;
        for k in 0..count {
            let lhs = eq_ident(eq_field_name(0, k, pcx), pos, pcx);
            let rhs = eq_ident(eq_field_name(1, k, pcx), pos, pcx);
            let eq = eq_binary(Tok::EqEq, lhs, rhs, pos, pcx);
            pcx.scratch.push(eq);
        }
        let body = eq_and(mark, pos, pcx);
        let arm = new_node(Arm, pos, pos, pcx);
        pcx.nodes[arm as usize].a = pats;
        pcx.nodes[arm as usize].c = body;
        list_push(arm, pcx);
    }
    let arm = new_node(Arm, pos, pos, pcx);
    pcx.nodes[arm as usize].a = new_node(PatWild, pos, pos, pcx);
    pcx.nodes[arm as usize].c = eq_bool(false, pos, pcx);
    pcx.nodes[arm as usize].p = ARM_SYNTHETIC;
    list_push(arm, pcx);
    list_end(m, arms, pcx);
    m
}

// The binding of field k of the left (side 0) or right value in an arm.
fn eq_field_name(side: i64, k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_str(out, if side == 0 { c"==x" } else { c"==y" });
    buf_int(out, k);
    intern_buf(out, pcx)
}

// Rewrites the checked comparison `n` of two values of compound type `ty`
// into the block above, checked.
pub fn structural_eq(n: i64, ty: i64, pcx: &mut Ctx<Comp>) {
    let pos = pcx.nodes[n as usize].start;
    let l = intern_c(c"==l", pcx);
    let r = intern_c(c"==r", pcx);
    let pl = eq_bind(l, false, pos, pcx);
    let pr = eq_bind(r, false, pos, pcx);
    let block = new_node(Block, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx);
    let mark = list_begin(pcx);
    list_push(eq_let(pl, pcx.nodes[n as usize].b, pos, pcx), pcx);
    list_push(eq_let(pr, pcx.nodes[n as usize].c, pos, pcx), pcx);
    list_end(block, mark, pcx);
    let mut tail = eq_compare(ty, l, r, pos, pcx);
    if pcx.nodes[n as usize].op == Tok::BangEq {
        let not = new_node(Unary, pos, pos, pcx);
        pcx.nodes[not as usize].op = Tok::Bang;
        pcx.nodes[not as usize].b = tail;
        tail = not;
    }
    pcx.nodes[block as usize].a = tail;
    // The operands are checked already: only their bindings are made.
    push_scope(pcx);
    check_pattern(pl, ty, pcx);
    check_pattern(pr, ty, pcx);
    check_expr(tail, TY_BOOL, pcx);
    pop_scope(pcx);
    pcx.nodes[n as usize] = pcx.nodes[block as usize];
    pcx.nodes[n as usize].ty = TY_BOOL;
}
