// `#[deprecated]` (0.26.3, Rust's): a use of a deprecated item outside std
// is warning item.deprecated, at the name, with the item's note. The
// attribute's table is DEPRECATED (front/parser/items/attrs.vl), keyed by
// the item's start. The uses are what the checker resolved: the names, the
// calls, the fields and the struct literals its nodes keep (as `query
// refs` reads them, report_deprecated_uses, after the checks), and the
// type names, paths and imports it notes (note_deprecated_use, from
// qnote). Std's own uses are std's: none is reported, and neither is a
// use inside a deprecated item (a recursive call, a derived impl), as in
// Rust.

use crate::base::{buf_bytes, buf_new, buf_slice, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, report_warning};
use crate::front::ast::{NODE_IMPLICIT, NodeKind, child};
use crate::front::check::Res;
use crate::front::modules::{module_at, within_std};
use crate::front::types::TyKind;

// The key of the warnings (report_warning tells warnings at one position
// apart by it).
const KEY: i64 = 7300;

// The note of item node def + 2 (1: deprecated with no note), 0 when it
// is not deprecated.
fn note_of(def: i64, pcx: &Ctx<Comp>) -> i64 {
    if def <= 0 {
        return 0;
    }
    pcx.deprecated.get(pcx.nodes[def as usize].start + 1)
}

// What item node def is, for the message.
fn kind_word(def: i64, method: bool, pcx: &Ctx<Comp>) -> *mut u8 {
    let k = pcx.nodes[def as usize].kind;
    if k == NodeKind::Fn {
        if method { c"method" } else { c"function" }
    } else if k == NodeKind::Struct {
        c"struct"
    } else if k == NodeKind::Enum {
        c"enum"
    } else if k == NodeKind::TypeAlias {
        c"type alias"
    } else if k == NodeKind::Trait {
        c"trait"
    } else if k == NodeKind::Const {
        c"constant"
    } else if k == NodeKind::Static {
        c"static"
    } else if k == NodeKind::Field {
        c"field"
    } else {
        c"item"
    }
}

// Whether pos is inside a deprecated item, from its attributes on (a
// recursive call, a derived impl's names, a deprecated method's field):
// Rust reports no use there.
fn inside_deprecated(pos: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.deprecated_nodes.len() as i64 {
        // UNSAFE: an IntVec's data is a raw pointer (base).
        // SAFETY: i is below its count, the number of items it holds.
        let d = unsafe { (pcx.deprecated_nodes[i as usize]) };
        let from = pcx.deprecated_at.get(pcx.nodes[d as usize].start + 1) - 1;
        let start = if from >= 0 && from < pcx.nodes[d as usize].start { from }
            else { pcx.nodes[d as usize].start };
        if pos >= start && pos < pcx.nodes[d as usize].end {
            return true;
        }
    }
    false
}

// The warning for a use at pos of deprecated item node def, named `name`
// (its symbol, or for a field `owner.name`), when pos is outside std and
// outside the item.
fn warn(pos: i64, def: i64, owner: i64, name: i64, method: bool, pcx: &mut Ctx<Comp>) {
    let note = note_of(def, pcx);
    if note == 0 || pos < 0 {
        return;
    }
    if inside_deprecated(pos, pcx) || within_std(module_at(pos, pcx), pcx) {
        return;
    }
    let m = buf_new();
    buf_str(m, c"use of deprecated ");
    buf_str(m, kind_word(def, method, pcx));
    buf_str(m, c" '");
    if owner >= 0 {
        buf_bytes(m, sym_text(owner, pcx));
        buf_bytes(m, if pcx.nodes[def as usize].kind == NodeKind::Field { b"." } else { b"::" });
    }
    buf_bytes(m, sym_text(name, pcx));
    buf_str(m, c"'");
    if note >= 2 {
        buf_str(m, c": ");
        buf_bytes(m, sym_text(note - 2, pcx));
    }
    let h = buf_new();
    buf_str(h, c"marked #[deprecated] at ");
    buf_position(h, pcx.nodes[def as usize].start, pcx);
    report_warning(pos, KEY, c"item.deprecated", buf_slice(m).ptr, buf_slice(h).ptr, pcx);
}

// The name noted at `from` stands for item node def (qnote: a type name,
// a path, an import).
pub fn note_deprecated_use(from: i64, def: i64, pcx: &mut Ctx<Comp>) {
    if pcx.deprecated.count == 0 || note_of(def, pcx) == 0 {
        return;
    }
    warn(from, def, -1, pcx.nodes[def as usize].a, false, pcx);
}

// The start of the name after the `.` at or after pos (a method's or a
// field's, after its receiver), or `at`.
fn name_after_dot(pos: i64, end: i64, at: i64) -> i64 {
    let mut i = pos;
    while i < end && get_src()[i as usize] != b'.' {
        i += 1;
    }
    if i >= end {
        return at;
    }
    i += 1;
    while i < end
        && (get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\n'
            || get_src()[i as usize] == b'\t' || get_src()[i as usize] == b'\r') {
        i += 1;
    }
    i
}

// A use of function f at pos.
fn warn_fn(pos: i64, f: i64, pcx: &mut Ctx<Comp>) {
    let def = pcx.fns[f as usize].node;
    if note_of(def, pcx) == 0 {
        return;
    }
    let t = if pcx.fns[f as usize].tmpl != 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let method = pcx.fns[t as usize].self_ty != 0;
    warn(pos, def, -1,
        if method { pcx.fns[t as usize].display } else { pcx.nodes[def as usize].a }, method,
        pcx);
}

// The struct item of struct type t (through a pointer), or 0.
fn struct_node(t0: i64, pcx: &Ctx<Comp>) -> i64 {
    if t0 <= 0 {
        return 0;
    }
    let t = if pcx.types[t0 as usize].kind == TyKind::Ptr { pcx.types[t0 as usize].a }
        else { t0 };
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct
        || pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        return 0;
    }
    pcx.structs[pcx.types[t as usize].a as usize].node
}

// Field i of struct item s, if it is named `name`; or 0.
fn field_of(s: i64, i: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    if s <= 0 || i < 0 || i >= pcx.nodes[s as usize].count
        || pcx.nodes[child(s, i, pcx) as usize].a != name {
        return 0;
    }
    child(s, i, pcx)
}

// After the checks: the uses the nodes keep (a name, a call, a field, a
// struct literal and its fields) of a deprecated item.
pub fn report_deprecated_uses(pcx: &mut Ctx<Comp>) {
    if pcx.deprecated.count == 0 {
        return;
    }
    for n in 1..pcx.nodes.len() as i64 {
        let kind = pcx.nodes[n as usize].kind;
        if (pcx.nodes[n as usize].p & NODE_IMPLICIT) != 0 {
            continue;
        }
        if kind == NodeKind::Ident {
            let res = pcx.nodes[n as usize].res;
            let y = pcx.nodes[n as usize].y;
            if res == Res::Fn {
                warn_fn(pcx.nodes[n as usize].start, y, pcx);
            } else if res == Res::Const {
                warn(pcx.nodes[n as usize].start, pcx.consts[y as usize].node, -1,
                    pcx.nodes[pcx.consts[y as usize].node as usize].a, false, pcx);
            } else if res == Res::Static {
                warn(pcx.nodes[n as usize].start, pcx.statics[y as usize].node, -1,
                    pcx.nodes[pcx.statics[y as usize].node as usize].a, false, pcx);
            }
        } else if kind == NodeKind::Call {
            if pcx.nodes[n as usize].x <= 0 {
                continue;
            }
            let callee = pcx.nodes[n as usize].a;
            if callee != 0 {
                warn_fn(pcx.nodes[callee as usize].start, pcx.nodes[n as usize].x - 1, pcx);
            } else if pcx.nodes[n as usize].count > 0 {
                let recv = child(n, 0, pcx);
                warn_fn(name_after_dot(pcx.nodes[recv as usize].end, pcx.nodes[n as usize].end,
                    pcx.nodes[n as usize].start),
                    pcx.nodes[n as usize].x - 1, pcx);
            }
        } else if kind == NodeKind::FieldAccess {
            if pcx.nodes[n as usize].y == 2 {
                continue;
            }
            let s = struct_node(pcx.nodes[pcx.nodes[n as usize].a as usize].ty, pcx);
            let field = field_of(s, pcx.nodes[n as usize].x, pcx.nodes[n as usize].b, pcx);
            if field != 0 && note_of(field, pcx) != 0 {
                warn(name_after_dot(pcx.nodes[pcx.nodes[n as usize].a as usize].end,
                    pcx.nodes[n as usize].end, pcx.nodes[n as usize].start),
                    field, pcx.nodes[s as usize].a, pcx.nodes[n as usize].b, false, pcx);
            }
        } else if kind == NodeKind::StructLit {
            let s = struct_node(pcx.nodes[n as usize].ty, pcx);
            if s == 0 {
                continue;
            }
            warn(pcx.nodes[n as usize].start, s, -1, pcx.nodes[s as usize].a, false, pcx);
            for i in 0..pcx.nodes[n as usize].count {
                let init = child(n, i, pcx);
                let field = field_of(s, pcx.nodes[init as usize].x, pcx.nodes[init as usize].a,
                    pcx);
                if field != 0 {
                    warn(pcx.nodes[init as usize].start, field, pcx.nodes[s as usize].a,
                        pcx.nodes[init as usize].a, false, pcx);
                }
            }
        }
    }
}
