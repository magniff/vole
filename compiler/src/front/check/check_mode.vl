// Check mode: an expression checked against the type its context expects
// (check_expr). Integer literals take the expected type (and must fit it),
// tuples, arrays and struct literals pass it to their parts, branches and
// arithmetic operands are checked against it; everything else is
// synthesized and compared with it.

use crate::base::{BUFS, SRC, buf_bytes, buf_new, buf_slice, buf_str, buf_uint, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fix, err_fmt, err_help, err_help_fmt, err_int, err_str,
    err_sym, err_try_fmt, err_try_tool,
};
use crate::front::ast::{
    NODE_CHECKED, NODE_IMPLICIT, NODE_REF_MUT, NodeKind, REPR_UNION, child, list_begin, list_end,
    new_node,
};
use crate::front::ast::NodeKind::{
    Array, Binary, Block, Char, Closure, Float, If, Int, Loop, Match, Range, Repeat, StructLit,
    Tuple, Unary,
};
use crate::front::check::{
    Res, is_std_named, lookup_local, mismatch_error, name_error, type_error_got,
};
use crate::front::check::args::check_shorthands;
use crate::front::check::assign::is_place;
use crate::front::check::body::{check_branch, check_if, check_loop};
use crate::front::check::distinct::distinct_literal;
use crate::front::check::interp::check_interp;
use crate::front::check::iterate::range_value;
use crate::front::check::names::unknown_name_error;
use crate::front::check::resolve::resolve_alias;
use crate::front::check::sealed::check_literal;
use crate::front::check::synth_mode::{fold_layout_query, help_near_field, synth_expr};
use crate::front::check::temps::NODE_TEMP;
use crate::front::check::try_op::check_try;
use crate::front::check::variant_fields::variant_literal;
use crate::front::check::vectors::sym_is_c;
use crate::front::check::widen::try_widen;
use crate::front::closures::{check_closure, coerce_closure};
use crate::front::consteval::eval_array_len;
use crate::front::contracts::desugar::desugar_call;
use crate::front::convert::into_call;
use crate::front::distinct::{is_view_distinct, strip_distinct};
use crate::front::generics::{check_arg, env_lookup};
use crate::front::generics::instantiate::infer_struct_literal;
use crate::front::lexer::{SUF_NONE, Tok, is_ident_byte};
use crate::front::modules::within_std;
use crate::front::modules::lookup::{
    B_ITEM, B_PRIVATE, access_error, binding_kind, binding_value, lookup_item, note_c_use,
    path_module,
};
use crate::front::patterns::check_match;
use crate::front::types::{
    REF_MUT, REF_SHARED, TY_BOOL, TY_NEVER, TY_U8, TyKind, array_of, buf_type, decay_ref, err_type,
    find_field, int_max, is_float, is_integer, is_mut_slice, is_numeric, is_ref, is_signed,
    struct_field, struct_type, type_elem,
};

fn passes_expected_to_operands(op: Tok, ex: i64, pcx: Ctx<Comp>) -> bool {
    // (0.18: a distinct type over a number, as the number)
    let expected = strip_distinct(ex, pcx);
    if op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
        || op == Tok::Percent {
        return is_numeric(expected);
    }
    if op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret {
        return is_integer(expected);
    }
    false
}

// Checks `n` against `expected`; returns `expected`, or `!` when the
// expression diverges.
pub fn check_expr(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    // (0.20) `&x` where nothing changes it, in a 0.20 file: conv.marker_extra
    crate::front::conv::extra_marker(n, expected, &pcx);
    fold_layout_query(n, &pcx);
    pcx.hint_node = n;
    pcx.hint_ty = expected;
    // (0.17: the own pass's record of the types and loans a function has,
    // front/own/fast.vl; its fast path reads it instead of the nodes)
    let mark = crate::front::own::fast::expr_enter(n, &pcx);
    crate::front::own::fast::check_node(n, &pcx);
    // (0.20) `&x` of a 0.20 or mixed file where an exclusive reference
    // is expected: the inout marker (front/conv), exclusive
    if expected > 0 && crate::front::conv::inout_marker(n, pcx) && pcx.types[expected].b == REF_MUT
        && (pcx.types[expected].kind == TyKind::Ptr || pcx.types[expected].kind == TyKind::Slice) {
        pcx.nodes[n].p |= NODE_REF_MUT;
    }
    let actual = check_expr_inner(n, expected, &pcx);
    pcx.nodes[n].ty = expected;
    // (0.18: as synth_expr's)
    if pcx.nodes[n].kind == NodeKind::Call {
        desugar_call(n, &pcx);
    }
    crate::front::own::fast::check_exit(n, expected, mark, &pcx);
    actual
}

fn check_expr_inner(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    // RULE: F1.2 (a rust-edition character literal where a `char` goes:
    // the char; a `char` is not an integer, so nowhere else)
    if pcx.nodes[n].kind == NodeKind::Char && pcx.nodes[n].b == 1 && expected > 0
        && expected == pcx.char_type {
        return expected;
    }
    // (0.18: a literal where a distinct type over a number goes)
    if distinct_literal(n, expected, &pcx) {
        return expected;
    }
    // RULE: F7.3 (a unit struct where a value goes takes its type
    // arguments from the expected type: `PhantomData`)
    if pcx.nodes[n].kind == NodeKind::Ident && pcx.edition != 0 && pcx.nodes[n].count == 0
        && lookup_local(pcx.nodes[n].a, pcx).is_none() {
        let key = crate::front::check::resolve::type_name_key(n, &pcx);
        if key >= 0 && crate::front::check::rust::unit_struct_value(n, key, &pcx) {
            check_struct_literal(n, expected, &pcx);
            return expected;
        }
    }
    if pcx.nodes[n].kind == NodeKind::Call && pcx.edition != 0
        && crate::front::check::rust::rust_node(n, &pcx) {
        // RULE: F8.2 (`Default::default()`: Self from the expected type)
        crate::front::check::calls::paths::trait_assoc_self(n, expected, &pcx);
    }
    match pcx.nodes[n].kind {
        Int if pcx.nodes[n].b == SUF_NONE && is_integer(expected) => {
            check_int_fits(n, pcx.nodes[n].a as u64, expected, &pcx);
            return expected;
        }
        // RULE: F1.2, F23.2 (a rust-edition character literal is a char, a
        // byte literal a u8: neither takes another integer type, and a char
        // is no integer, rustc E0308)
        Char if is_integer(expected) && (pcx.nodes[n].b == 0
            || pcx.nodes[n].b == 2 && expected == TY_U8
            || pcx.nodes[n].b == 1 && expected == crate::front::types::TY_U32
            && pcx.char_scalar) => {
            check_int_fits(n, pcx.nodes[n].a as u64, expected, &pcx);
            return expected;
        }
        Float if pcx.nodes[n].b == SUF_NONE && is_float(expected) => {
            return expected;
        }
        Tuple if pcx.types[expected].kind == TyKind::Tuple => {
            check_tuple(n, expected, &pcx);
            return expected;
        }
        Array if pcx.types[expected].kind == TyKind::Array => {
            check_array(n, expected, &pcx);
            return expected;
        }
        // (0.25.2.1) an array literal where a slice of numbers is wanted
        // takes the slice's element type, `let xs: [u32] = [1, 2, 3];`,
        // `sum([1, 2])` for `xs: [u32]`, and is viewed as one as before
        // (coerce_ref's elements_view; it was `[i64; 3]`)
        Array if pcx.types[expected].kind == TyKind::Slice && pcx.types[expected].b == 0
            && pcx.nodes[n].count > 0 && is_numeric(pcx.types[expected].a) => {
            let at = array_of(pcx.types[expected].a, pcx.nodes[n].count, &pcx);
            check_array(n, at, &pcx);
            pcx.nodes[n].ty = at;
            if coerce_ref(n, at, expected, &pcx) {
                return expected;
            }
            mismatch_error(n, expected, at, &pcx);
        }
        Repeat if pcx.types[expected].kind == TyKind::Array => {
            check_expr(pcx.nodes[n].a, pcx.types[expected].a, &pcx);
            let count = eval_array_len(pcx.nodes[n].b, &pcx);
            if count != pcx.types[expected].b {
                err_begin(pcx.nodes[pcx.nodes[n].b].start, &pcx);
                err_str(c"array repeat count is ", pcx);
                err_int(count, pcx);
                err_str(c", expected ", pcx);
                err_int(pcx.types[expected].b, pcx);
                err_end(&pcx);
            }
            return expected;
        }
        StructLit => {
            // (0.17: `E::V { a: x }`, a struct-like variant's literal)
            if variant_literal(n, &pcx) {
                return check_expr_inner(n, expected, &pcx);
            }
            check_struct_literal(n, expected, &pcx);
            return expected;
        }
        Closure => return check_closure(n, expected, &pcx),
        // (0.15)
        NodeKind::Try => return check_try(n, expected, &pcx),
        NodeKind::Interp => return check_interp(n, expected, &pcx),
        NodeKind::MethodCall if pcx.nodes[n].count == 0
            && sym_is_c(pcx.nodes[n].b, c"into", &pcx) => {
            let t = into_call(n, expected, &pcx);
            if t >= 0 {
                return t;
            }
        }
        Range => return range_value(n, expected, &pcx),
        If => return check_if(n, expected, &pcx),
        Match => return check_match(n, expected, &pcx),
        Block => return check_branch(n, expected, &pcx),
        Loop => return check_loop(n, expected, &pcx),
        Binary if passes_expected_to_operands(pcx.nodes[n].op, expected, pcx) => {
            let saved = pcx.binary_node;
            pcx.binary_node = n;
            check_expr(pcx.nodes[n].b, expected, &pcx);
            check_expr(pcx.nodes[n].c, expected, &pcx);
            pcx.binary_node = saved;
            return expected;
        }
        Binary if (pcx.nodes[n].op == Tok::Shl || pcx.nodes[n].op == Tok::Shr)
            && is_integer(expected) => {
            check_expr(pcx.nodes[n].b, expected, &pcx);
            check_shift_amount(pcx.nodes[n].c, &pcx);
            return expected;
        }
        Unary if pcx.nodes[n].op == Tok::Minus && is_numeric(expected)
            && !suffixed_int(pcx.nodes[n].b, pcx) => {
            check_negation(n, expected, &pcx);
            return expected;
        }
        // RULE: Z9.2 (0.27.2: `&[a, b]`, `&[]` where `&[T]` is expected: an
        // array of T, coerced to the slice)
        Unary if pcx.nodes[n].op == Tok::Amp && (pcx.nodes[n].p & NODE_REF_MUT) == 0
            && pcx.types[expected].kind == TyKind::Slice && pcx.types[expected].b == 0
            && pcx.nodes[pcx.nodes[n].b].kind == NodeKind::Array
            && crate::front::check::rust::rust_node(n, &pcx) => {
            let inner = pcx.nodes[n].b;
            let at = array_of(pcx.types[expected].a, pcx.nodes[inner].count, &pcx);
            check_expr(inner, at, &pcx);
            pcx.nodes[inner].p |= NODE_CHECKED;
            let t = synth_expr(n, &pcx);
            if coerce_ref(n, t, expected, &pcx) {
                return expected;
            }
            mismatch_error(n, expected, t, &pcx);
        }
        Unary if pcx.nodes[n].op == Tok::Tilde && is_integer(expected) => {
            check_expr(pcx.nodes[n].b, expected, &pcx);
            return expected;
        }
        // (0.27.2) `!a` of an integer type, the rust edition's. RULE: F26.1
        Unary if pcx.nodes[n].op == Tok::Bang && is_integer(expected)
            && pcx.nodes[pcx.nodes[n].b].kind == Int
            && crate::front::check::rust::rust_node(n, &pcx) => {
            pcx.nodes[n].op = Tok::Tilde;
            check_expr(pcx.nodes[n].b, expected, &pcx);
            return expected;
        }
        _ => {}
    }
    let actual = synth_expr(n, &pcx);
    if actual == TY_NEVER {
        return actual;
    }
    // (a value of the error type, or one where it is expected, follows
    // from an earlier error: nothing to report)
    if actual != expected && actual != pcx.ty_error && expected != pcx.ty_error {
        // (0.15: a narrower integer)
        if try_widen(n, actual, expected, &pcx) {
            return expected;
        }
        if coerce_closure(n, expected, &pcx) {
            return expected;
        }
        if crate::front::check::rust::coerce_unsafe_fn(actual, expected, &pcx) {
            return expected;
        }
        // (0.17: references)
        if coerce_ref(n, actual, expected, &pcx) {
            return expected;
        }
        // (0.20: str, and the deref coercions to text and slices)
        if coerce_text(n, actual, expected, &pcx) {
            return expected;
        }
        mismatch_error(n, expected, actual, &pcx);
    }
    expected
}

// (0.17, docs/design/value-semantics.md §2.3) Value n of type `actual`
// where `expected` is expected (they differ): whether a reference converts.
// `&T` and `&mut T` become a raw `*T` (dereferencing one stays unsafe),
// `&mut T` a `&T`, `&mut [T]` a `[T]`; a reference to a slice is the slice
// (`f(&s)` for `s: [T]`, `&mut s` for a `&mut [T]`), n rewritten to read it.
pub fn coerce_ref(n: i64, actual: i64, expected: i64, pcx: inout Ctx<Comp>) -> bool {
    if actual <= 0 || expected <= 0 {
        return false;
    }
    let ak = pcx.types[actual].kind;
    let ek = pcx.types[expected].kind;
    // RULE: F32.1 (0.27.2: Rust's deref coercion of a reference to a shared
    // reference, `&&str` where a `&str` goes, `&&[T]` a `&[T]`, `&&T` a `&T`:
    // the inner reference read, `*n`; a `&str` type argument is the view, so
    // `&T` of it, in std2's generic bodies, is a reference to the view)
    if ak == TyKind::Ptr && pcx.types[actual].b != 0 && pcx.types[actual].a == expected
        && (ek == TyKind::Slice && pcx.types[expected].b == 0
            || ek == TyKind::Ptr && pcx.types[expected].b == REF_SHARED
            || crate::front::distinct::is_view_distinct(expected, pcx)
            && !is_mut_slice(expected, pcx))
        && crate::front::check::rust::rust_node(n, &pcx) {
        wrap_unary(n, Tok::Star, expected, &pcx);
        return true;
    }
    if ek == TyKind::Slice && elements_view(n, actual, expected, &pcx) {
        return true;
    }
    // RULE: F0.1 (0.27.2: a `&mut str` where a `&str` is expected, as
    // `&mut [T]` a `[T]`; never the other way)
    if ak == TyKind::Distinct && ek == TyKind::Distinct && is_mut_slice(actual, pcx)
        && !is_mut_slice(expected, pcx) && decay_ref(actual, &pcx) == expected {
        return true;
    }
    if ak == TyKind::Slice && ek == TyKind::Slice {
        if pcx.types[actual].a != pcx.types[expected].a {
            return false;
        }
        if pcx.types[actual].b == REF_MUT && pcx.types[expected].b == 0 {
            return true;
        }
        // A `[T]` where `&mut [T]` is expected (`sort(a[..])`,
        // `sort(v.as_slice())`, `sort(s)`): own.readonly (0.19.1; 0.17's
        // legacy slice rule took it as the exclusive view), the call
        // checked as if it were one
        if pcx.types[actual].b == 0 && pcx.types[expected].b == REF_MUT {
            readonly_slice_arg(n, actual, &pcx);
            return true;
        }
        return false;
    }
    if ek == TyKind::Ptr && pcx.types[expected].b == REF_SHARED && pcx.types[expected].a == actual
        && (is_place(n, pcx)
            || pcx.nodes[n].kind == NodeKind::Ident && (pcx.nodes[n].p & NODE_TEMP) != 0) {
        // (0.18.1) a place where `&T` is expected is borrowed, as a
        // `self: &T` receiver is: `f(it)` for `f(x: &Item)` with `it`
        // from `for it in v.iter()`; a temporary slice, `&x.text()`,
        // where `&[T]` is (`cmp_of(&a.text(), &b.text())`). (0.27.1: a
        // place written so is edition.lenient in the rust edition, R5)
        if (pcx.nodes[n].p & NODE_TEMP) == 0 && n == pcx.rust_arg && n > 0 {
            crate::front::check::rust::lenient_error(n, false, &pcx);
        }
        wrap_unary(n, Tok::Amp, expected, &pcx);
        return true;
    }
    if ek == TyKind::Ptr && pcx.types[expected].b == REF_SHARED && pcx.types[expected].a == actual
        && n == pcx.let_arg && pcx.let_arg > 0 && lendable_value(n, actual, &pcx) {
        // (0.25) a value given to a let parameter that borrows is lent
        // as a temporary of its statement (LET_ARG); (0.27.1) given to a
        // rust-edition function, edition.lenient (R5)
        if n == pcx.rust_arg && n > 0 {
            crate::front::check::rust::lenient_error(n, false, &pcx);
        }
        wrap_unary(n, Tok::Amp, expected, &pcx);
        pcx.nodes[n].p |= NODE_TEMP;
        return true;
    }
    if ek == TyKind::Ptr && pcx.types[expected].b == REF_SHARED && pcx.types[expected].a == actual
        && pcx.nodes[n].kind == NodeKind::Closure
        && (pcx.nodes[n].c & crate::front::ast::CLOSURE_MOVE) == 0 {
        // (0.20) a closure, made here, given to a let parameter that
        // borrows it (one that captures an inout access, so is no copy):
        // its environment is the caller's, lent for the call; it owns
        // nothing (it captures by reference), so nothing drops
        wrap_unary(n, Tok::Amp, expected, &pcx);
        return true;
    }
    if ek == TyKind::Ptr && pcx.types[expected].b == REF_MUT && pcx.types[expected].a == actual
        && pcx.nodes[n].start == pcx.nodes[n].end && crate::front::check::assign::is_place(n, pcx) {
        // (0.20) a place the checker passes on where an exclusive
        // reference is wanted (a contract's companion given an inout
        // parameter, which is the value it designates): lent again
        wrap_unary(n, Tok::Amp, expected, &pcx);
        pcx.nodes[n].p |= NODE_REF_MUT;
        return true;
    }
    if ek == TyKind::Ptr && pcx.types[expected].b == REF_MUT && ak == TyKind::Ptr
        && pcx.types[actual].b == REF_SHARED && pcx.types[actual].a == pcx.types[expected].a
        && crate::front::conv::inout_marker(n, pcx) {
        // (0.20) the inout marker `&x` checked before its parameter was
        // known (an argument of a generic function, inferred from):
        // exclusive, the place checked again as one
        pcx.nodes[n].p |= NODE_REF_MUT;
        return crate::front::check::synth_mode::synth_expr(n, &pcx) == expected;
    }
    if ak != TyKind::Ptr || pcx.types[actual].b == 0 {
        return false;
    }
    let pointee = pcx.types[actual].a;
    if pointee == expected && (is_numeric(expected) || expected == TY_BOOL
        || crate::front::own::kinds::is_plain_type(expected, &pcx)) {
        // (0.18.1) a reference to a plain value (a number, a struct of
        // numbers: a pattern's binding on a reference, a closure's
        // parameter) where the value is expected: read through it, as
        // `*n`, a copy. (0.27.1: a reference given so to a rust-edition
        // function or a `let`'s written type is edition.lenient, R5)
        if n == pcx.rust_arg && n > 0 {
            crate::front::check::rust::lenient_error(n, true, &pcx);
        }
        wrap_unary(n, Tok::Star, expected, &pcx);
        return true;
    }
    if ek == TyKind::Ptr && pcx.types[expected].b != 0 && is_ref(pointee, pcx)
        && pointee_fits(pcx.types[pointee].a, pcx.types[expected].a, pcx)
        && (pcx.types[expected].b == REF_SHARED || pcx.types[pointee].b == REF_MUT) {
        // (0.18.1) `&&T` where `&T` is expected (`let tr = &t;` of a
        // `t: &T`): the reference it holds
        wrap_unary(n, Tok::Star, pointee, &pcx);
        return true;
    }
    if ek == TyKind::Ptr && pointee_fits(pointee, pcx.types[expected].a, pcx) {
        if pcx.types[expected].b == 0 {
            // (0.20: a reference that converts to a raw pointer, for
            // `fix --only conventions`: an access is its value, so its
            // address is `&x` then)
            pcx.raw_from_ref.push(n);
        }
        return pcx.types[expected].b == 0 || pcx.types[expected].b == REF_SHARED;
    }
    if ek == TyKind::Slice && pcx.types[pointee].kind == TyKind::Slice
        && pcx.types[pointee].a == pcx.types[expected].a
        && (pcx.types[expected].b == 0 || pcx.types[actual].b == REF_MUT) {
        if pcx.nodes[n].kind == Unary && pcx.nodes[n].op == Tok::Amp {
            // `&s`: s itself
            let operand = pcx.nodes[n].b;
            let flags = pcx.nodes[n].p;
            // (0.20: the `&`, for `fix --only conventions`)
            pcx.slice_amps.push(pcx.nodes[n].start);
            pcx.slice_amps.push(pcx.nodes[operand].start);
            pcx.nodes[n] = pcx.nodes[operand];
            pcx.nodes[n].p |= flags & NODE_REF_MUT;
        } else {
            // `*r`
            let inner = new_node(Unary, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
            pcx.nodes[inner] = pcx.nodes[n];
            pcx.nodes[n].kind = Unary;
            pcx.nodes[n].op = Tok::Star;
            pcx.nodes[n].b = inner;
            pcx.nodes[n].a = 0;
            pcx.nodes[n].count = 0;
            pcx.nodes[n].p = 0;
        }
        return true;
    }
    false
}

// (0.20, conventions.md §6.1) A Vec, a Buf or an array where a slice of its
// elements is wanted: `sort(&v)` for `s: inout [T]` is `sort(&v[..])`,
// `sum(v)` for `s: [T]` is `sum(v[..])`. n (of type actual) becomes the
// slicing, checked again.
fn elements_view(n: i64, actual: i64, expected: i64, pcx: inout Ctx<Comp>) -> bool {
    let mutable = pcx.types[expected].b == REF_MUT;
    var place = n;
    var container = actual;
    var reborrow = false;
    if mutable {
        if pcx.nodes[n].kind != NodeKind::Unary || pcx.nodes[n].op != Tok::Amp
            || (pcx.nodes[n].p & NODE_REF_MUT) == 0 || pcx.types[actual].kind != TyKind::Ptr {
            return false;
        }
        place = pcx.nodes[n].b;
        container = pcx.types[actual].a;
    } else if crate::front::check::rust::rust_node(n, &pcx) && pcx.nodes[n].kind == NodeKind::Unary
        && pcx.nodes[n].op == Tok::Amp && (pcx.nodes[n].p & NODE_REF_MUT) == 0
        && pcx.types[actual].kind == TyKind::Ptr {
        // RULE: Z9.2, F20.2 (0.27.2: the rust edition's unsized coercion,
        // `&a` of an array, a Vec, where `&[T]` is expected: `&a[..]`)
        place = pcx.nodes[n].b;
        container = pcx.types[actual].a;
        reborrow = true;
    } else if !crate::front::check::assign::is_place(n, pcx) && !temporary_container(n, pcx) {
        return false;
    }
    let elem = crate::front::conv::container_elem(container, pcx);
    if elem <= 0 || elem != pcx.types[expected].a {
        return false;
    }
    let range = new_node(NodeKind::Range, pcx.nodes[place].start, pcx.nodes[place].start, &pcx);
    let inner = new_node(NodeKind::None, pcx.nodes[place].start, pcx.nodes[place].end, &pcx);
    pcx.nodes[inner] = pcx.nodes[place];
    pcx.nodes[inner].p |= NODE_CHECKED;
    pcx.nodes[inner].ty = container;
    // (the place's node becomes the slicing, as a closure's use of a
    // captured name is that node: closures::rewrite_use finds it under)
    let index = place;
    pcx.nodes[index].kind = NodeKind::Index;
    pcx.nodes[index].a = inner;
    pcx.nodes[index].b = range;
    pcx.nodes[index].c = 0;
    pcx.nodes[index].count = 0;
    pcx.nodes[index].list = 0;
    pcx.nodes[index].p = 0;
    pcx.nodes[index].ty = 0;
    if mutable || reborrow {
        pcx.nodes[n].ty = 0;
        pcx.nodes[n].p &= ~NODE_CHECKED;
    }
    crate::front::check::synth_mode::synth_expr(n, &pcx) == expected
}

// (0.25) Whether n makes a new container (an array literal, a call's
// result), whose slice a let parameter may view for the call: `sum([1, 2])`,
// `sum(make(gpa))`, as `sum([1, 2][..])` (the temporary lives to the end of
// the statement).
fn temporary_container(n: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[n].kind;
    k == NodeKind::Array || k == NodeKind::Repeat || k == NodeKind::Call
        || k == NodeKind::MethodCall
}

// Whether value n (of type t) may be lent as a temporary: no place, and a
// new value (front/own/drops::fresh) or one without glue.
pub fn lendable_value(n: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    !crate::front::check::assign::is_place(n, pcx)
        && (crate::front::own::byref::fresh(n, &pcx) || !crate::front::own::glue::has_glue(t, &pcx))
}

// (0.25) Value n, checked, lent as a temporary of its statement where the
// reference `expected` goes: `&n` (NODE_TEMP).
pub fn lend_temporary(n: i64, expected: i64, pcx: inout Ctx<Comp>) {
    wrap_unary(n, Tok::Amp, expected, &pcx);
    pcx.nodes[n].p |= NODE_TEMP;
}

// (0.20, docs/design/collections-text-io.md §2.3 L3) Value n of type
// `actual` where `expected` goes (they differ): whether text converts.
// std's `str` where `[u8]` goes is the same view (free); `&s` of a
// String where `str` or `[u8]` goes, and `&b` of a Buf or `&v` of a Vec
// where its slice goes, are Rust's deref coercions: n becomes
// `(&s).as_str()` (`as_bytes`, `as_slice`).
pub fn coerce_text(n: i64, actual: i64, expected: i64, pcx: inout Ctx<Comp>) -> bool {
    if actual <= 0 || expected <= 0 {
        return false;
    }
    if is_view_distinct(actual, pcx) && pcx.types[actual].a == expected {
        return true;
    }
    // (0.20, conventions.md §6.1, as a Vec where its slice goes: in a
    // 0.20 file the owner itself, `f(s)` for `x: str`, a let argument
    // that lends s; `&` marks an inout one)
    let owner_place = pcx.types[actual].kind == TyKind::Struct
        && crate::front::conv::strict_at(pcx.nodes[n].start, &pcx)
        && crate::front::check::assign::is_place(n, pcx);
    if !owner_place && (pcx.types[actual].kind != TyKind::Ptr || pcx.types[actual].b == 0) {
        return false;
    }
    let pointee = if owner_place { actual } else { pcx.types[actual].a };
    if pointee <= 0 || pcx.types[pointee].kind != TyKind::Struct
        || !within_std(pcx.structs[pcx.types[pointee].a].module, pcx) {
        return false;
    }
    let to_slice = pcx.types[expected].kind == TyKind::Slice && pcx.types[expected].b == 0;
    let text_owner = is_std_named(pointee, c"String", pcx)
        || is_std_named(pointee, c"PathBuf", pcx);
    let method = if text_owner {
        if is_view_distinct(expected, pcx) && is_mut_slice(expected, pcx) {
            // RULE: F0.1 (0.27.2: `&mut s` of a String where a `&mut str`
            // goes, DerefMut's coercion; only from a `&mut`)
            if is_std_named(pointee, c"String", pcx) && pcx.types[actual].kind == TyKind::Ptr
                && pcx.types[actual].b == REF_MUT { c"as_mut_str" } else { 0 as *u8 }
        } else if is_view_distinct(expected, pcx) {
            if is_std_named(pointee, c"String", pcx) { c"as_str" } else { c"as_path" }
        } else if to_slice { c"as_bytes" } else { 0 as *u8 }
    }
        else if (is_std_named(pointee, c"Vec", pcx) || is_std_named(pointee, c"Buf", pcx))
        && to_slice {
        c"as_slice"
    } else {
        0 as *u8
    };
    if method == 0 as *u8 {
        return false;
    }
    let inner = new_node(Unary, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
    pcx.nodes[inner] = pcx.nodes[n];
    pcx.nodes[inner].p |= NODE_CHECKED;
    let call = new_node(NodeKind::MethodCall, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
    pcx.nodes[call].a = inner;
    pcx.nodes[call].b = intern_c(method, &pcx);
    let mark = list_begin(pcx);
    list_end(call, mark, &pcx);
    if synth_expr(call, &pcx) != expected {
        return false;
    }
    pcx.nodes[n] = pcx.nodes[call];
    true
}

// (0.19.1) own.readonly: `[T]` value n (a read-only view) where `&mut [T]`
// is expected, a parameter the callee writes through (`sort(v.as_slice())`,
// `vst1q_u8(out[..], ...)`): the view must be exclusive. The fix, exact
// where it is one (`fix --suggested`): `&mut a[..]`, `v.as_mut_slice()`;
// a `[T]` parameter passed on is retyped (`refactor signature`).
fn readonly_slice_arg(n: i64, actual: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let text = SRC[pcx.nodes[n].start..pcx.nodes[n].end];
        let saved = pcx.err_kind;
        pcx.err_kind = c"own.readonly";
        err_begin(pcx.nodes[n].start, &pcx);
        err_fmt(format_args("'{text}', a '"), pcx);
        err_type(actual, pcx);
        err_str(c"', is read-only where 'inout [", pcx);
        err_type(pcx.types[actual].a, pcx);
        err_str(c"]' is expected: the callee writes through it", pcx);
        err_help(c"pass it inout: '&a[..]', '&v', or an 'inout [T]' parameter passed on as '&s'",
            pcx);
        let new = buf_new();
        // `sort(v.as_slice())`, `sort(a[..])`: the method, `v.sort()`
        let s = pcx.nodes[n].start;
        let e = pcx.nodes[n].end;
        let whole = if text.len > 11
            && text[text.len as i64 - 11..] == ".as_slice()" { 11 }
            else if text.len > 4
            && text[text.len as i64 - 4..] == "[..]" { 4 } else { 0 };
        if whole > 0 && s >= 5 && SRC[s - 5..s] == "sort(" && SRC[e] == ')'
            && (s == 5 || !is_ident_byte(SRC[s - 6]) && SRC[s - 6] != '.' && SRC[s - 6] != ':') {
            let call = buf_new();
            buf_bytes(call, text[0..text.len as i64 - whole]);
            buf_str(call, c".sort()");
            err_try_fmt(buf_slice(call), pcx);
            err_fix(s - 5, e + 1, buf_slice(call), &pcx);
        } else if pcx.nodes[n].kind == NodeKind::Index && fresh_slice(n, &pcx) {
            buf_str(new, c"&");
            buf_bytes(new, text);
        }
        else if text.len > 11
            && text[text.len as i64 - 11..] == ".as_slice()" {
            buf_bytes(new, text[0..text.len as i64 - 10]);
            buf_str(new, c"as_mut_slice()");
        }
        if BUFS[new].len > 0 {
            err_try_fmt(buf_slice(new), pcx);
            err_fix(pcx.nodes[n].start, pcx.nodes[n].end, buf_slice(new), &pcx);
        } else if pcx.nodes[n].kind == NodeKind::Ident && pcx.cur_fn >= 0 {
            let l = lookup_local(pcx.nodes[n].a, pcx);
            if l.is_some() && pcx.locals[l.unwrap()].is_param {
                let a = buf_new();
                buf_str(a, c"refactor signature ");
                // (a generic function's template: its name without `<...>`)
                let name = sym_text(pcx.fns[pcx.cur_fn].display, pcx);
                var cut = 0;
                while cut < name.len as i64 && name[cut] != '<' {
                    cut += 1;
                }
                buf_bytes(a, name[0..cut]);
                buf_str(a, c" --type ");
                buf_bytes(a, text);
                // (the parameter's type as written: `[T]` in a generic one)
                let fnode = pcx.fns[pcx.cur_fn].node;
                var written = 0;
                for i in 0..pcx.nodes[fnode].count {
                    let p = child(fnode, i, pcx);
                    if pcx.nodes[p].kind == NodeKind::Param && pcx.nodes[p].a == pcx.nodes[n].a
                        && pcx.nodes[p].b > 0 {
                        written = pcx.nodes[p].b;
                    }
                }
                if written == 0 {
                    // (a closure's parameter: no signature to retype)
                    err_end_soft(&pcx);
                    pcx.err_kind = saved;
                    return;
                }
                buf_str(a, c" 'inout ");
                if written > 0 {
                    buf_bytes(a, SRC[pcx.nodes[written].start..pcx.nodes[written].end]);
                } else {
                    buf_str(a, c"[");
                    buf_type(a, pcx.types[actual].a, pcx);
                    buf_str(a, c"]");
                }
                buf_str(a, c"'");
                err_try_tool(buf_slice(a), false, pcx);
            }
        }
        err_end_soft(&pcx);
        pcx.err_kind = saved;
    }
}

// (0.18.1) Node n becomes `op n` (`&` or `*`) of type ty: what it was
// moves to a new node under it.
fn wrap_unary(n: i64, op: Tok, ty: i64, pcx: inout Ctx<Comp>) {
    let inner = new_node(NodeKind::Ident, pcx.nodes[n].start, pcx.nodes[n].end, &pcx);
    pcx.nodes[inner] = pcx.nodes[n];
    pcx.nodes[n].kind = Unary;
    pcx.nodes[n].op = op;
    pcx.nodes[n].b = inner;
    pcx.nodes[n].a = 0;
    pcx.nodes[n].c = 0;
    pcx.nodes[n].count = 0;
    pcx.nodes[n].p = 0;
    pcx.nodes[n].res = Res::None;
    pcx.nodes[n].x = 0;
    pcx.nodes[n].y = 0;
    pcx.nodes[n].ty = ty;
    crate::front::own::fast::note_synthetic(n, &pcx);
}

// (0.17) Whether n makes a slice of a place: `a[x..y]`, `v.as_slice()` (a
// call of std's as_slice, once checked) (coerce_ref's legacy slice rule).
fn fresh_slice(n: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[n].kind == NodeKind::Index {
        return pcx.nodes[pcx.nodes[n].b].kind == NodeKind::Range;
    }
    if pcx.nodes[n].kind == NodeKind::MethodCall {
        return pcx.nodes[n].count == 0 && pcx.nodes[n].b == intern_c(c"as_slice", &pcx);
    }
    let f = pcx.nodes[n].x - 1;
    pcx.nodes[n].kind == NodeKind::Call && f >= 0 && within_std(pcx.fns[f].module, pcx)
        && pcx.nodes[pcx.fns[f].node].a == intern_c(c"as_slice", &pcx)
}

// Whether a pointer to `a` converts to a pointer to `e`: the same type, or
// pointers all the way where e's are raw (`&&T` to `**T`).
fn pointee_fits(a: i64, e: i64, pcx: Ctx<Comp>) -> bool {
    if a == e {
        return true;
    }
    pcx.types[a].kind == TyKind::Ptr && pcx.types[e].kind == TyKind::Ptr && pcx.types[e].b == 0
        && pointee_fits(pcx.types[a].a, pcx.types[e].a, pcx)
}

fn check_int_fits(n: i64, value: u64, ty: i64, pcx: inout Ctx<Comp>) {
    if value > int_max(ty) {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"integer literal ", pcx);
        buf_uint(pcx.err, value);
        err_str(c" does not fit in type '", pcx);
        err_type(ty, pcx);
        err_str(c"'", pcx);
        int_range_help(ty, pcx);
        err_end(&pcx);
    }
}

// (0.17) The help of a literal out of integer type ty's range: the range,
// and what to write instead.
pub fn int_range_help(ty: i64, pcx: Ctx<Comp>) {
    let max = int_max(ty);
    let b = buf_new();
    buf_type(b, ty, pcx);
    err_help(c"'", pcx);
    err_help_fmt(buf_slice(b), pcx);
    err_help(c"' holds ", pcx);
    if is_signed(ty) {
        err_help(c"-", pcx);
        err_help_fmt(max + 1, pcx);
    } else {
        err_help(c"0", pcx);
    }
    err_help(c"..=", pcx);
    err_help_fmt(max, pcx);
    err_help(c": a wider type (`i64`), or the literal's low bits with `as` (`LITERAL as ", pcx);
    err_help_fmt(buf_slice(b), pcx);
    err_help(c"`)", pcx);
}

fn check_tuple(n: i64, expected: i64, pcx: inout Ctx<Comp>) {
    let count = pcx.nodes[n].count;
    if count != pcx.types[expected].count {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"tuple has ", pcx);
        err_int(count, pcx);
        err_str(c" elements, expected ", pcx);
        err_int(pcx.types[expected].count, pcx);
        err_end(&pcx);
    }
    for i in 0..count {
        check_expr(child(n, i, pcx), type_elem(expected, i, pcx), &pcx);
    }
}

fn check_array(n: i64, expected: i64, pcx: inout Ctx<Comp>) {
    let count = pcx.nodes[n].count;
    if count != pcx.types[expected].b {
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"array has ", pcx);
        err_int(count, pcx);
        err_str(c" elements, expected ", pcx);
        err_int(pcx.types[expected].b, pcx);
        err_end(&pcx);
    }
    for i in 0..count {
        check_expr(child(n, i, pcx), pcx.types[expected].a, &pcx);
    }
}

// The struct a struct literal names (`Self` included; through its module
// path, h), or -1. A generic struct's template is returned as it is.
fn struct_of_literal(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let name = pcx.nodes[n].a;
        if pcx.nodes[n].h == 0 {
            if name == pcx.self_type_sym && pcx.self_type != 0
                && pcx.types[pcx.self_type].kind == TyKind::Struct {
                return pcx.types[pcx.self_type].a;
            }
            let param = env_lookup(name, pcx);
            if param != 0 && pcx.types[param].kind == TyKind::Struct {
                return pcx.types[param].a;
            }
        }
        let m = if pcx.nodes[n].h
            != 0 { path_module(pcx.nodes[n].h, pcx.nodes[pcx.nodes[n].h].count, &pcx) }
            else { pcx.cur_mod };
        let b = lookup_item(m, name, pcx.cur_mod, &pcx);
        if pcx.nodes[n].h == 0 {
            note_c_use(pcx.nodes[n].start, name, b, &pcx);
        }
        if binding_kind(b) == B_PRIVATE {
            access_error(b, pcx.nodes[n].start, name, &pcx);
        }
        if binding_kind(b) != B_ITEM {
            return -1;
        }
        let key = binding_value(b);
        if pcx.sym_struct[key] != 0 {
            return pcx.sym_struct[key] - 1;
        }
        if pcx.sym_alias[key] != 0 {
            let t = resolve_alias(key, pcx.nodes[n].start, &pcx);
            if pcx.types[t].kind == TyKind::Struct {
                return pcx.types[t].a;
            }
        }
        -1
    }
}

fn check_struct_literal(n: i64, expected: i64, pcx: inout Ctx<Comp>) {
    let actual = check_struct_fields(n, expected, &pcx);
    if actual != expected {
        if pcx.types[expected].kind == TyKind::Struct
            && pcx.types[actual].kind == TyKind::Struct {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"expected struct '", pcx);
            err_sym(pcx.structs[pcx.types[expected].a].name, pcx);
            err_str(c"', got constructor for '", pcx);
            err_sym(pcx.structs[pcx.types[actual].a].name, pcx);
            err_str(c"'", pcx);
            err_end(&pcx);
        }
        mismatch_error(n, expected, actual, &pcx);
    }
}

// The fields of `Name { ... }`: each exactly once, with its declared type.
// `expected` (0: none) may give a generic struct's type arguments.
pub fn check_struct_fields(n: i64, expected: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let name = pcx.nodes[n].a;
        // (0.15: `P { x }` with no `x`)
        check_shorthands(n, &pcx);
        var s = struct_of_literal(n, &pcx);
        if s < 0 {
            unknown_name_error(pcx.nodes[n].start, c"unknown struct '", name, &pcx);
        }
        if pcx.structs[s].generic > 0 {
            s = infer_struct_literal(s, n, expected, &pcx);
        } else if pcx.nodes[n].g != 0 {
            name_error(pcx.nodes[n].start, c"struct '", name, c"' is not generic", &pcx);
        }
        // (0.16: a #[sealed] struct's literals)
        if !check_literal(n, s, &pcx) {
            return struct_type(s, &pcx);
        }
        for i in 0..pcx.nodes[n].count {
            let init = child(n, i, pcx);
            for j in 0..i {
                if pcx.nodes[child(n, j, pcx)].a == pcx.nodes[init].a {
                    name_error(pcx.nodes[init].start, c"duplicate field '", pcx.nodes[init].a,
                        c"' in constructor", &pcx);
                }
            }
            let field = find_field(s, pcx.nodes[init].a, pcx);
            if field < 0 {
                err_begin(pcx.nodes[init].start, &pcx);
                err_str(c"unknown field '", pcx);
                err_sym(pcx.nodes[init].a, pcx);
                err_str(c"' in struct '", pcx);
                err_sym(pcx.structs[s].name, pcx);
                err_str(c"'", pcx);
                help_near_field(s, pcx.nodes[init].a, &pcx);
                err_end(&pcx);
            }
            pcx.nodes[init].x = field;
            check_arg(pcx.nodes[init].b, (*struct_field(s, field, pcx)).ty, &pcx);
        }
        if (pcx.structs[s].repr & REPR_UNION) != 0 {
            if pcx.nodes[n].count != 1 {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"a literal of union '", pcx);
                err_sym(pcx.structs[s].name, pcx);
                err_str(c"' sets exactly one field", pcx);
                err_end(&pcx);
            }
            return struct_type(s, &pcx);
        }
        for f in 0..pcx.structs[s].field_count {
            var found = false;
            for i in 0..pcx.nodes[n].count {
                if pcx.nodes[child(n, i, pcx)].x == f {
                    found = true;
                }
            }
            // (0.26.0: the compiler's own literal, main's `Gpa {}`, is whole as made)
            if !found && (pcx.nodes[n].p & NODE_IMPLICIT) == 0 {
                err_begin(pcx.nodes[n].start, &pcx);
                err_str(c"missing field '", pcx);
                err_sym((*struct_field(s, f, pcx)).name, pcx);
                err_str(c"' in struct '", pcx);
                err_sym(pcx.structs[s].name, pcx);
                err_str(c"' constructor", pcx);
                err_end(&pcx);
            }
        }
        struct_type(s, &pcx)
    }
}

fn check_negation(n: i64, expected: i64, pcx: inout Ctx<Comp>) {
    let operand = pcx.nodes[n].b;
    if pcx.nodes[operand].kind == Int && pcx.nodes[operand].b == SUF_NONE && is_signed(expected) {
        let value = pcx.nodes[operand].a as u64;
        let magnitude: u64 = if value == 0 { 0 } else { value - 1 };
        if magnitude > int_max(expected) {
            err_begin(pcx.nodes[n].start, &pcx);
            err_str(c"integer literal -", pcx);
            buf_uint(pcx.err, value);
            err_str(c" does not fit in type '", pcx);
            err_type(expected, pcx);
            err_str(c"'", pcx);
            int_range_help(expected, pcx);
            err_end(&pcx);
        }
        pcx.nodes[operand].ty = expected;
        return;
    }
    check_expr(operand, expected, &pcx);
}

// Whether n is an integer literal with a suffix (`-128i8` is checked as
// written: synth_unary allows the negated literal its sign).
fn suffixed_int(n: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[n].kind == Int && pcx.nodes[n].b != SUF_NONE
}

pub fn check_shift_amount(amount: i64, pcx: inout Ctx<Comp>) {
    let ty = synth_expr(amount, &pcx);
    if !is_integer(ty) {
        type_error_got(amount, c"shift amount must be integer", ty, &pcx);
    }
}
