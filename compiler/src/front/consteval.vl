// Compile-time constants: `const` items, array lengths and the
// initializers of statics. A scalar constant is held as 64 bits: integers
// wrapped to their type (sign-extended when signed), floats as the bits of
// an f64 (rounded to f32 first for f32), bools as 0 or 1.

use crate::base::{buf_ptr, buf_set, buf_slice, buf_zeros, memcpy};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_help, err_str};
use crate::front::ast::{BLOCK_UNSAFE, NodeKind, VK_NEW, VK_SPLAT, child};
use crate::front::check::{Res, Try, attempt, name_error, type_error, type_error_got};
use crate::front::check::check_mode::check_expr;
use crate::front::check::synth_mode::synth_expr;
use crate::front::distinct::enum_niche;
use crate::front::generics::{env_enter, env_leave};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{
    Amp, AmpAmp, Bang, BangEq, Caret, EqEq, Gt, GtEq, Lt, LtEq, Minus, Percent, Pipe, PipePipe,
    Plus, Shl, Shr, Slash, Star, Tilde,
};
use crate::front::modules::module_of;
use crate::front::types::{
    TY_BOOL, TY_F32, TY_I64, TY_U64, TY_UNIT, err_type, field_offset, int_bits, is_compound,
    is_float, is_integer, is_pointer, is_signed, scalar_type, struct_field, tuple_offset, type_elem,
    type_size, variant_field, variant_field_offset,
};
use crate::middle::fold::fold_overflow;
use crate::middle::ir::Op;

pub fn f64_of_bits(bits: i64) -> f64 {
    let copy = bits;
    unsafe { *(&raw const copy as *mut f64) }
}

pub fn bits_of(value: f64) -> i64 {
    let copy = value;
    unsafe { *(&raw const copy as *mut i64) }
}

pub fn f32_bits(value: f64) -> u32 {
    let narrow = value as f32;
    unsafe { *(&raw const narrow as *mut u32) }
}

// `value` wrapped to the integer (or pointer) type `ty`.
pub fn wrap_int(value: i64, ty: i64) -> i64 {
    if !is_integer(ty) {
        return value;
    }
    let bits = int_bits(ty);
    if bits == 64 {
        return value;
    }
    let mask: i64 = (1 << bits as u64) - 1;
    let masked = value & mask;
    if is_signed(ty) && (masked >> (bits - 1) as u64) == 1 {
        return masked - (1 << bits as u64);
    }
    masked
}

pub fn float_const(value: f64, ty: i64) -> i64 {
    if ty == TY_F32 {
        return bits_of(value as f32 as f64);
    }
    bits_of(value)
}

fn not_constant(n: i64, pcx: &mut Ctx<Comp>) -> ! {
    type_error(n, c"expression is not a compile-time constant", pcx)
}

// (0.25) Whether n is `unsafe { e }`, a block of only a tail: its value is
// e's (a pointer made from an integer in a static's initializer).
fn unsafe_tail(n: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[n as usize].kind == NodeKind::Block && (pcx.nodes[n as usize].p & BLOCK_UNSAFE) != 0
        && pcx.nodes[n as usize].count == 0 && pcx.nodes[n as usize].a != 0
}

// Type checks `n` against `ty` with no locals in scope.
pub fn check_const_expr(n: i64, ty: i64, pcx: &mut Ctx<Comp>) {
    let saved_context = pcx.const_context;
    let saved_return = pcx.return_type;
    pcx.const_context = true;
    pcx.return_type = TY_UNIT;
    check_expr(n, ty, pcx);
    pcx.const_context = saved_context;
    pcx.return_type = saved_return;
}

pub fn const_value(c: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.consts[c as usize].state == 2 {
        return pcx.consts[c as usize].value;
    }
    let item = pcx.consts[c as usize].node;
    if pcx.consts[c as usize].state == 3 {
        // RULE: F34.2 (a constant made at each use is no compile-time
        // value: an array length, a pattern)
        name_error(pcx.nodes[item as usize].start, c"constant '", pcx.nodes[item as usize].a,
            c"' is made at each use (its value calls a function, or its type is not a number, a bool or a string): not a compile-time value yet",
            pcx);
    }
    if pcx.consts[c as usize].state == 1 {
        name_error(pcx.nodes[item as usize].start, c"constant '", pcx.nodes[item as usize].a,
            c"' is defined in terms of itself", pcx);
    }
    pcx.consts[c as usize].state = 1;
    // (0.10: a constant whose type or initializer failed is 0, and the
    // checking goes on)
    pcx.consts[c as usize].value = 0;
    if pcx.consts[c as usize].ty != pcx.ty_error {
        attempt(Try::Const, c, pcx);
    }
    pcx.consts[c as usize].state = 2;
    pcx.consts[c as usize].value
}

pub fn const_value_of(c: i64, pcx: &mut Ctx<Comp>) {
    let item = pcx.consts[c as usize].node;
    // In the constant's module, without type parameters in scope.
    let saved_mod = pcx.cur_mod;
    pcx.cur_mod = module_of(item, pcx);
    let saved_env = env_enter(0, 0, 0, pcx);
    check_const_expr(pcx.nodes[item as usize].c, pcx.consts[c as usize].ty, pcx);
    // A C string constant (0.4) has no value: its uses are the literal.
    let init_kind = pcx.nodes[pcx.nodes[item as usize].c as usize].kind;
    let value: i64 = if init_kind == NodeKind::CStr || init_kind == NodeKind::Str { 0 }
        else { const_eval(pcx.nodes[item as usize].c, pcx) };
    env_leave(saved_env, pcx);
    pcx.cur_mod = saved_mod;
    pcx.consts[c as usize].value = value;
}

pub fn eval_array_len(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // RULE: F15.3 (`[T; N]` with N a length parameter: the instance's
    // length, the node kept for the next instance)
    if pcx.nodes[n as usize].kind == crate::front::ast::NodeKind::Ident {
        let len = crate::front::generics::instantiate::length_of(
            crate::front::generics::env_lookup(pcx.nodes[n as usize].a, pcx), pcx);
        if len >= 0 {
            return len;
        }
    }
    // RULE: F34.2 (a constant made at each use is no length yet)
    if pcx.nodes[n as usize].kind == crate::front::ast::NodeKind::Ident {
        let c = crate::front::check::names::scope_const(pcx.nodes[n as usize].a, pcx) - 1;
        if c >= 0 && pcx.consts[c as usize].state >= 3 {
            const_value(c, pcx);
        }
    }
    let saved_context = pcx.const_context;
    pcx.const_context = true;
    let ty = synth_expr(n, pcx);
    if !is_integer(ty) {
        type_error_got(n, c"array length must be an integer", ty, pcx);
    }
    let value = const_eval(n, pcx);
    pcx.const_context = saved_context;
    if is_signed(ty) && value < 0 {
        type_error(n, c"array length must not be negative", pcx);
    }
    value
}

// The value of a scalar constant expression (already type checked).
pub fn const_eval(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let ty = pcx.nodes[n as usize].ty;
    // (0.16: inside a constant constructor, a static's)
    if pcx.nodes[n as usize].kind == NodeKind::Call && pcx.const_frame >= 0 {
        let body = const_frame_enter(n, pcx);
        let value = const_eval(body, pcx);
        const_frame_leave(pcx);
        return value;
    }
    let arg = const_arg(n, pcx);
    if arg >= 0 {
        let saved = pcx.const_frame;
        pcx.const_frame = (pcx.const_frames[(2 * saved + 1) as usize]);
        let value = const_eval(arg, pcx);
        pcx.const_frame = saved;
        return value;
    }
    match { pcx.nodes[n as usize].kind } {
        NodeKind::Int | NodeKind::Char => wrap_int(pcx.nodes[n as usize].a, ty),
        NodeKind::Float => float_const(f64_of_bits(pcx.nodes[n as usize].a), ty),
        NodeKind::Bool => pcx.nodes[n as usize].a,
        NodeKind::Unit => 0,
        NodeKind::Ident => {
            if pcx.nodes[n as usize].res != Res::Const {
                name_error(pcx.nodes[n as usize].start, c"'", pcx.nodes[n as usize].a,
                    c"' is not a constant", pcx);
            }
            const_value(pcx.nodes[n as usize].y, pcx)
        }
        NodeKind::Block if unsafe_tail(n, pcx) => const_eval(pcx.nodes[n as usize].a, pcx),
        NodeKind::Unary => const_unary(n, ty, pcx),
        NodeKind::Binary => const_binary(n, ty, pcx),
        NodeKind::Cast => {
            let operand = pcx.nodes[n as usize].a;
            let value = const_eval(operand, pcx);
            const_cast(n, value, scalar_type(pcx.nodes[operand as usize].ty, pcx), ty, pcx)
        }
        NodeKind::VariantLit if !is_compound(ty, pcx) => wrap_int(
            pcx.variants[pcx.nodes[n as usize].a as usize].discr,
            scalar_type(ty, pcx)),
        _ => not_constant(n, pcx),
    }
}

fn const_unary(n: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let value = const_eval(pcx.nodes[n as usize].b, pcx);
    match pcx.nodes[n as usize].op {
        Minus => if is_float(ty) {
            float_const(-f64_of_bits(value), ty)
        } else {
            // (0.26.3: a literal, -128 as an i8, is no negation of 128)
            if pcx.nodes[pcx.nodes[n as usize].b as usize].kind != NodeKind::Int {
                const_overflow(n, Op::Neg, value, 0, ty, pcx);
            }
            wrap_int(value.wrapping_neg(), ty)
        },
        Bang => 1 - value,
        Tilde => wrap_int(!value, ty),
        _ => not_constant(n, pcx),
    }
}

fn const_binary(n: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let op = pcx.nodes[n as usize].op;
    let lhs = pcx.nodes[n as usize].b;
    let operand_ty = pcx.nodes[lhs as usize].ty;
    let a = const_eval(lhs, pcx);
    if op == AmpAmp && a == 0 {
        return 0;
    }
    if op == PipePipe && a == 1 {
        return 1;
    }
    let b = const_eval(pcx.nodes[n as usize].c, pcx);
    if operand_ty == TY_BOOL {
        if op == AmpAmp || op == PipePipe { return b; }
        if op == EqEq { return (a == b) as i64; }
        if op == BangEq { return (a != b) as i64; }
        type_error(n, c"invalid operator on bools", pcx);
    }
    if is_float(operand_ty) {
        return const_float_binary(n, op, f64_of_bits(a), f64_of_bits(b), ty, pcx);
    }
    const_int_binary(n, op, a, b, operand_ty, ty, pcx)
}

fn const_float_binary(n: i64, op: Tok, a: f64, b: f64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    match op {
        Plus => float_const(a + b, ty),
        Minus => float_const(a - b, ty),
        Star => float_const(a * b, ty),
        Slash => float_const(a / b, ty),
        Percent => float_const(a % b, ty),
        EqEq => (a == b) as i64,
        BangEq => (a != b) as i64,
        Lt => (a < b) as i64,
        Gt => (a > b) as i64,
        LtEq => (a <= b) as i64,
        GtEq => (a >= b) as i64,
        _ => type_error(n, c"invalid operator on floats", pcx),
    }
}

// `a < b` for values of an integer type.
pub fn const_less(a: i64, b: i64, ty: i64) -> bool {
    if is_signed(ty) { a < b } else { (a as u64) < (b as u64) }
}

// (0.26.3, decision 6) A constant's `a <op> b` (`-a` for Op::Neg) of
// integer type ty, with the overflow checks on (-O0's default, or
// --overflow-checks=on): an overflow is an error, as the program's own
// arithmetic would panic. With them off, it wraps.
fn const_overflow(n: i64, op: Op, a: i64, b: i64, ty: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.overflow_checks || !is_integer(ty) || is_pointer(ty, pcx) {
        return;
    }
    if fold_overflow(op as i64 | ty << 8, a, b) {
        let what = match op {
            Op::Add => c"add",
            Op::Sub => c"subtract",
            Op::Mul => c"multiply",
            _ => c"negate",
        };
        overflow_error(n, what, ty, false, pcx);
    }
}

// The error of a constant expression of type ty whose `what` (Rust's
// words: add, subtract, shift left, divide) overflows; `always` for
// MIN / -1 and MIN % -1, an error whatever the checks.
fn overflow_error(n: i64, what: *mut u8, ty: i64, always: bool, pcx: &mut Ctx<Comp>) -> ! {
    pcx.err_kind = c"arith.overflow";
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"this constant expression overflows '", pcx);
    err_type(ty, pcx);
    err_str(c"': attempt to ", pcx);
    err_str(what, pcx);
    err_str(c" with overflow", pcx);
    err_help(if always {
        c"MIN / -1 and MIN % -1 overflow at every level, as they panic at run time: write the value"
    } else {
        c"with the overflow checks on (-O0, or --overflow-checks=on) a constant's arithmetic is checked as the program's: write a value that fits, or wrap it with --overflow-checks=off"
    }, pcx);
    err_end(pcx)
}

// The least value of the signed integer type ty.
fn min_of(ty: i64) -> i64 {
    let bits = int_bits(ty);
    if bits == 64 { 0 - 9223372036854775807 - 1 } else { 0 - (1 << (bits - 1) as u64) }
}

fn const_int_binary(n: i64, op: Tok, a: i64, b: i64, operand_ty: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    match op {
        Plus => {
            const_overflow(n, Op::Add, a, b, ty, pcx);
            wrap_int(a.wrapping_add(b), ty)
        }
        Minus => {
            const_overflow(n, Op::Sub, a, b, ty, pcx);
            wrap_int(a.wrapping_sub(b), ty)
        }
        Star => {
            const_overflow(n, Op::Mul, a, b, ty, pcx);
            wrap_int(a.wrapping_mul(b), ty)
        }
        Slash | Percent => {
            if b == 0 {
                type_error(n, c"division by zero in constant expression", pcx);
            }
            if is_signed(operand_ty) {
                // (0.26.3) MIN / -1 and MIN % -1 overflow, an error at
                // every level, as they panic at run time (decision 6).
                if b == -1 {
                    if a == min_of(operand_ty) {
                        let what = if op == Slash { c"divide" } else { c"calculate the remainder" };
                        overflow_error(n, what, ty, true, pcx);
                    }
                    return if op == Slash { wrap_int(a.wrapping_neg(), ty) } else { 0 };
                }
                return wrap_int(if op == Slash { a / b } else { a % b }, ty);
            }
            let ua = a as u64;
            let ub = b as u64;
            wrap_int((if op == Slash { ua / ub } else { ua % ub }) as i64, ty)
        }
        Amp => wrap_int(a & b, ty),
        Pipe => wrap_int(a | b, ty),
        Caret => wrap_int(a ^ b, ty),
        Shl | Shr => {
            // (0.26.3: an amount past the bits is an overflow, checked)
            if pcx.overflow_checks && (b as u64) >= int_bits(operand_ty) as u64 {
                let what = if op == Shl { c"shift left" } else { c"shift right" };
                overflow_error(n, what, operand_ty, false, pcx);
            }
            let amount = (b as u64 & 0xffffffff) % int_bits(operand_ty) as u64;
            if op == Shl {
                wrap_int(a << amount, ty)
            } else if is_signed(operand_ty) {
                wrap_int(a >> amount, ty)
            } else {
                wrap_int(((a as u64) >> amount) as i64, ty)
            }
        }
        EqEq => (a == b) as i64,
        BangEq => (a != b) as i64,
        Lt => const_less(a, b, operand_ty) as i64,
        Gt => const_less(b, a, operand_ty) as i64,
        LtEq => !const_less(b, a, operand_ty) as i64,
        GtEq => !const_less(a, b, operand_ty) as i64,
        _ => not_constant(n, pcx),
    }
}

fn int_to_f64(value: i64, from: i64) -> f64 {
    if is_signed(from) { value as f64 } else { (value as u64) as f64 }
}

fn const_cast(n: i64, value: i64, from: i64, to: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let from_float = is_float(from);
    if (is_integer(to) || is_pointer(to, pcx)) && !from_float {
        if from == TY_BOOL {
            return value;
        }
        return wrap_int(value, to);
    }
    if is_float(to) && from_float {
        return float_const(f64_of_bits(value), to);
    }
    if is_float(to) && (is_integer(from) || is_pointer(from, pcx)) {
        return float_const(int_to_f64(value, from), to);
    }
    if is_integer(to) && from_float {
        return float_to_int(f64_of_bits(value), to);
    }
    not_constant(n, pcx)
}

// Float to integer `as` (grammar.md; the constant folder's too, and what
// the back ends emit), as Rust's: NaN is 0, and every target saturates at
// its own bounds (0.26.2: an unsigned one at 0 too; before, below 2^63 it
// was the i64 conversion, so -5.0 as u64 was 2^64 - 5).
pub fn float_to_int(value: f64, to: i64) -> i64 {
    if value != value {
        return 0;
    }
    let bits = int_bits(to);
    if !is_signed(to) {
        if value < 1.0 {
            return 0;
        }
        if bits == 64 {
            if value >= 18446744073709551616.0 {
                return -1;
            }
            if value >= 9223372036854775808.0 {
                return ((value - 9223372036854775808.0) as i64) ^ (1 << 63);
            }
            return value as i64;
        }
        let max = (1 << bits as u64) - 1;
        if value >= max as f64 {
            return max;
        }
        return value as i64;
    }
    if bits == 64 {
        if value <= -9223372036854775808.0 {
            return -9223372036854775807 - 1;
        }
        if value >= 9223372036854775808.0 {
            return 9223372036854775807;
        }
        return value as i64;
    }
    let max = (1 << (bits - 1) as u64) - 1;
    if value >= max as f64 {
        return max;
    }
    if value <= (-max - 1) as f64 {
        return -max - 1;
    }
    value as i64
}

// ---- Aggregate constants (the initializers of statics) ----

// Whether every byte is zero.
pub fn all_zero(bytes: &[u8]) -> bool {
    for i in 0..bytes.len() {
        if bytes[i] != 0 {
            return false;
        }
    }
    true
}

pub fn const_emit(n: i64, ty: i64, out: i64, pcx: &mut Ctx<Comp>) {
    pcx.const_relocs.clear();
    pcx.const_frames.clear();
    pcx.const_args.clear();
    pcx.const_frame = -1;
    let size = type_size(ty, pcx);
    let at = buf_zeros(out, size);
    const_write(n, ty, out, at, pcx);
    // (by offset: a struct's fields are not in their order)
    let count = pcx.const_relocs.len() as i64 / 2;
    for i in 1..count {
        let mut j = i;
        while j > 0
            && (pcx.const_relocs[(2 * j) as usize])
            < (pcx.const_relocs[(2 * (j - 1)) as usize]) {
            for k in 0..2 {
                let t = (pcx.const_relocs[(2 * j + k) as usize]);
                (pcx.const_relocs[(2 * j + k) as usize]) = (
                    pcx.const_relocs[(2 * (j - 1) + k) as usize]);
                (pcx.const_relocs[(2 * (j - 1) + k) as usize]) = t;
            }
            j -= 1;
        }
    }
}

fn const_write(n: i64, ty: i64, out: i64, at: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        // (0.16: a constant constructor; a use of its parameter)
        if pcx.nodes[n as usize].kind == NodeKind::Call {
            let body = const_frame_enter(n, pcx);
            const_write(body, ty, out, at, pcx);
            const_frame_leave(pcx);
            return;
        }
        let arg = const_arg(n, pcx);
        if arg >= 0 {
            let saved = pcx.const_frame;
            pcx.const_frame = (pcx.const_frames[(2 * saved + 1) as usize]);
            const_write(arg, ty, out, at, pcx);
            pcx.const_frame = saved;
            return;
        }
        match { pcx.nodes[n as usize].kind } {
            NodeKind::StructLit => {
                let s = pcx.types[ty as usize].a;
                for i in 0..pcx.nodes[n as usize].count {
                    let init = child(n, i, pcx);
                    let field = pcx.nodes[init as usize].x;
                    const_write(pcx.nodes[init as usize].b, (struct_field(s, field, pcx)).ty, out,
                        at + field_offset(s, field, pcx), pcx);
                }
            }
            NodeKind::Tuple => {
                for i in 0..pcx.nodes[n as usize].count {
                    const_write(child(n, i, pcx), type_elem(ty, i, pcx), out,
                        at + tuple_offset(ty, i, pcx), pcx);
                }
            }
            NodeKind::Repeat if pcx.types[ty as usize].b > 0 => {
                // (0.25.5) one element evaluated, then its bytes copied: each
                // is the same constant (a [0; 65536] took 65536 evaluations,
                // most of a small program's build); zeros are there already.
                // An element with an address in it is written each time, for
                // its relocations.
                let elem = pcx.types[ty as usize].a;
                let elem_size = type_size(elem, pcx);
                let relocs = pcx.const_relocs.len() as i64;
                const_write(pcx.nodes[n as usize].a, elem, out, at, pcx);
                if pcx.const_relocs.len() as i64 != relocs {
                    for i in 1..pcx.types[ty as usize].b {
                        const_write(pcx.nodes[n as usize].a, elem, out, at + i * elem_size, pcx);
                    }
                }
                else if !all_zero(
                    &buf_slice(out)[at as usize..(at + elem_size) as usize]) {
                    // (the elements written so far, copied after them)
                    let count = pcx.types[ty as usize].b;
                    let mut done: i64 = 1;
                    while done < count {
                        let k = if done < count - done { done } else { count - done };
                        memcpy(
                            buf_ptr(out).add(
                                (at + done * elem_size) as usize),
                            buf_ptr(out).add(at as usize),
                            (k * elem_size) as u64);
                        done += k;
                    }
                }
            }
            NodeKind::Array | NodeKind::Repeat => {
                let elem = pcx.types[ty as usize].a;
                let elem_size = type_size(elem, pcx);
                for i in 0..pcx.types[ty as usize].b {
                    let value = if pcx.nodes[n as usize].kind
                        == NodeKind::Array { child(n, i, pcx) }
                        else { pcx.nodes[n as usize].a };
                    const_write(value, elem, out, at + i * elem_size, pcx);
                }
            }
            NodeKind::VecOp if pcx.nodes[n as usize].x == VK_NEW
                || pcx.nodes[n as usize].x == VK_SPLAT => {
                // A vector of constant lanes (0.10).
                let elem = pcx.types[ty as usize].a;
                let elem_size = type_size(elem, pcx);
                for i in 0..pcx.types[ty as usize].b {
                    let value = if pcx.nodes[n as usize].x == VK_NEW { child(n, i, pcx) }
                        else { child(n, 0, pcx) };
                    const_write(value, elem, out, at + i * elem_size, pcx);
                }
            }
            NodeKind::Str => {
                // A string literal in an aggregate (0.9): its address, then
                // its length.
                pcx.const_relocs.push(at);
                pcx.const_relocs.push(pcx.nodes[n as usize].a);
                write_scalar(out, at + 8,
                    crate::front::lexer::str_at(pcx.nodes[n as usize].a).len() as i64, TY_I64, pcx);
            }
            NodeKind::CStr if is_pointer(ty, pcx) => {
                pcx.const_relocs.push(at);
                pcx.const_relocs.push(pcx.nodes[n as usize].a);
            }
            // (0.18: the null niche, only the pointer: 0 for the other variant)
            NodeKind::VariantLit if is_compound(ty, pcx)
                && enum_niche(pcx.types[ty as usize].a, pcx) => {
                let v = pcx.nodes[n as usize].a;
                if pcx.nodes[n as usize].count == 1 {
                    const_write(child(n, 0, pcx), variant_field(v, 0, pcx), out, at, pcx);
                } else {
                    write_scalar(out, at, 0, TY_U64, pcx);
                }
            }
            NodeKind::VariantLit if is_compound(ty, pcx) => {
                let v = pcx.nodes[n as usize].a;
                let tag = (pcx.enums[pcx.types[ty as usize].a as usize]).tag;
                write_scalar(out, at, wrap_int(pcx.variants[v as usize].discr, tag), tag, pcx);
                for i in 0..pcx.nodes[n as usize].count {
                    const_write(child(n, i, pcx), variant_field(v, i, pcx), out,
                        at + variant_field_offset(v, i, pcx), pcx);
                }
            }
            NodeKind::Block if unsafe_tail(n, pcx) => const_write(pcx.nodes[n as usize].a, ty, out,
                at, pcx),
            _ => {
                if is_compound(ty, pcx) {
                    not_constant(n, pcx);
                }
                let value = const_eval(n, pcx);
                write_scalar(out, at, value, scalar_type(ty, pcx), pcx);
            }
        }
    }
}

// The bytes of a scalar constant, little-endian.
pub fn write_scalar(out: i64, at: i64, value: i64, ty: i64, pcx: &Ctx<Comp>) {
    let size = type_size(ty, pcx);
    let mut bits = value as u64;
    if ty == TY_F32 {
        bits = f32_bits(f64_of_bits(value)) as u64;
    }
    for i in 0..size {
        buf_set(out, (at + i), (bits
            >> (i * 8) as u64) as u8)
            ;
    }
}

// ---- Constant constructors (0.16) ----

// Constructors calling constructors, at most this deep.
const CONST_CALL_DEPTH: i64 = 64;

// The expression that is the body of function f, or -1.
fn constructor_body(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let item = pcx.fns[f as usize].node;
    if pcx.nodes[item as usize].kind != NodeKind::Fn {
        return -1;
    }
    let body = pcx.nodes[item as usize].c;
    if body <= 0 || pcx.nodes[body as usize].kind != NodeKind::Block
        || pcx.nodes[body as usize].count != 0
        || pcx.nodes[body as usize].a <= 0
        || pcx.nodes[pcx.nodes[body as usize].a as usize].ty <= 0 {
        return -1;
    }
    pcx.nodes[body as usize].a
}

// Call n, evaluated as a constant: its frame entered; the expression to
// evaluate (then const_frame_leave).
fn const_frame_enter(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let f = pcx.nodes[n as usize].x - 1;
    let body: i64 = if f >= 0 { constructor_body(f, pcx) } else { -1 };
    let item: i64 = if f >= 0 { pcx.fns[f as usize].node } else { 0 };
    if body < 0 || pcx.const_frames.len() as i64 >= 2 * CONST_CALL_DEPTH
        || pcx.nodes[n as usize].count < pcx.nodes[item as usize].count {
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_str(c"expression is not a compile-time constant", pcx);
        err_help(c"a call is constant when its function's body is one expression of constants and its parameters (a constructor: 'Vec::new_in(Arena::none())')", pcx);
        err_end(pcx);
    }
    let first = pcx.const_args.len() as i64;
    for i in 0..pcx.nodes[item as usize].count {
        pcx.const_args.push(pcx.nodes[child(item, i, pcx) as usize].x);
        pcx.const_args.push(child(n, i, pcx));
    }
    pcx.const_frames.push(first);
    pcx.const_frames.push(pcx.const_frame);
    pcx.const_frame = pcx.const_frames.len() as i64 / 2 - 1;
    body
}

fn const_frame_leave(pcx: &mut Ctx<Comp>) {
    let k = pcx.const_frame;
    pcx.const_args.truncate((pcx.const_frames[(2 * k) as usize]) as usize);
    pcx.const_frame = (pcx.const_frames[(2 * k + 1) as usize]);
    pcx.const_frames.truncate((2 * k) as usize);
}

// The argument node that n stands for, when it is a use of a parameter of
// the constructor being evaluated; else -1.
fn const_arg(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.const_frame < 0 || pcx.nodes[n as usize].kind != NodeKind::Ident
        || pcx.nodes[n as usize].res != Res::Local {
        return -1;
    }
    let first = (pcx.const_frames[(2 * pcx.const_frame) as usize]);
    let end = if 2 * pcx.const_frame + 2 < pcx.const_frames.len() as i64 {
        (pcx.const_frames[(2 * pcx.const_frame + 2) as usize])
    } else {
        pcx.const_args.len() as i64
    };
    let mut i = first;
    while i < end {
        if (pcx.const_args[i as usize]) == pcx.nodes[n as usize].y {
            return (pcx.const_args[(i + 1) as usize]);
        }
        i += 2;
    }
    -1
}

// Whether constant expression n calls a function (its check waits for
// the functions' bodies: check_static_calls).
pub fn has_const_call(n: i64, pcx: &Ctx<Comp>) -> bool {
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::Call {
        return true;
    }
    if kind == NodeKind::StructLit {
        for i in 0..pcx.nodes[n as usize].count {
            if has_const_call(pcx.nodes[child(n, i, pcx) as usize].b, pcx) {
                return true;
            }
        }
    } else if kind == NodeKind::Tuple || kind == NodeKind::Array {
        for i in 0..pcx.nodes[n as usize].count {
            if has_const_call(child(n, i, pcx), pcx) {
                return true;
            }
        }
    } else if kind == NodeKind::Repeat {
        return has_const_call(pcx.nodes[n as usize].a, pcx);
    }
    false
}
