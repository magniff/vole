// Explicit allocation (0.16, the user's decision U1): nothing allocates
// without being given an allocator. A program's general-purpose
// allocator is the `gpa: Gpa` its `fn main(gpa: Gpa)` takes (main_gpa),
// passed down as a parameter; std has no ambient allocator. (0.26.3: std
// has no `Vec::new()`, `collect()`, `format(x)` either; a call of one is
// alloc.no_in, naming its `_in` form: front/check/alloc_rules.vl.) Here:
// main's Gpa, and the helps that say where a function's allocator comes
// from.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_help, err_help_fmt};
use crate::front::ast::{
    FN_SIG_FAILED, NODE_IMPLICIT, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::modules::within_std;
use crate::front::types::TyKind;

// (0.25.2.1) In a #[test] fn (or a property or fuzz test) `name`, its node
// fnode (-1: none): the help that its allocator is a parameter too,
// `#[test] fn t(gpa: Gpa)`; whether it was given (`Gpa::default()`,
// `Gpa {}`, `gpa` not defined in a test).
pub fn test_gpa_help(fnode: i64, name: &[u8], pcx: &Ctx<Comp>) -> bool {
    if fnode < 0 {
        return false;
    }
    let kind = crate::front::contracts::test_kind(fnode, pcx);
    if kind == 0 || kind == crate::front::contracts::TEST_CFG {
        return false;
    }
    err_help_fmt(
        { let name = str::from_utf8(name).unwrap(); format_args(
            "a #[test] fn takes the allocator as a parameter: `#[test] fn {name}(gpa: Gpa)`") },
        pcx);
    true
}

// (0.25.2.1) Where the allocator of function `name` (its node fnode, -1:
// none) comes from, for a help: a #[test] fn's parameter, main's, or a
// parameter to add to it.
pub fn gpa_param_help(fnode: i64, name: &[u8], pcx: &Ctx<Comp>) {
    if test_gpa_help(fnode, name, pcx) {
        return;
    }
    if fnode >= 0 && name == b"main" {
        err_help(c"main takes the allocator: `fn main(gpa: Gpa)`, passed down as a parameter", pcx);
    } else if fnode >= 0 {
        err_help_fmt(
            { let name = str::from_utf8(name).unwrap(); format_args("a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)': add the parameter `gpa: Gpa` to '{name}' and pass it down") }, pcx);
        // (0.28.0) the edit that does it, one function up at a time: the
        // parameter added last, `gpa` written at each call (`= gpa`: the
        // argument the calls get). --no-check: a caller without a `gpa`
        // has the next error, with this try for it, up to main.
        let t = crate::base::buf_new();
        crate::base::buf_str(t, c"refactor signature ");
        // (the name without its type arguments, `Ring::new` of
        // `Ring<T, A>::new`: a `<` would be the shell's)
        let mut depth: i64 = 0;
        for i in 0..name.len() {
            if name[i] == b'<' {
                depth += 1;
            } else if name[i] == b'>' {
                depth -= 1;
            } else if depth == 0 {
                crate::base::buf_bytes(t, &name[i..i + 1]);
            }
        }
        crate::base::buf_str(t, c" --add 'gpa: Gpa = gpa' --fill-calls --no-check");
        crate::base::diag::err_try_tool(crate::base::buf_slice(t), true, pcx);
    } else {
        err_help(c"a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)' and is passed down as a parameter",
            pcx);
    }
}

// `fn main(gpa: Gpa)`, or a last parameter `gpa: Gpa` after main's others
// (`fn main(argc: i32, argv: **u8, gpa: Gpa)`) (called once the signatures are resolved, before
// main_result_wrapper): the program's general-purpose allocator, made by
// the runtime's entry. Its body becomes `{ let gpa: Gpa = Gpa {}; body }`
// (the literal flagged NODE_IMPLICIT: the one Gpa made outside std, which
// #[sealed] lets through) and main takes no parameter, as C's entry.
pub fn main_gpa(pcx: &mut Ctx<Comp>) {
    unsafe {
        let main = intern_c(c"main", pcx);
        let gpa = intern_c(c"Gpa", pcx);
        for f in 0..pcx.fns.len() as i64 {
            let node = pcx.fns[f as usize].node;
            if pcx.fns[f as usize].name != main || pcx.nodes[node as usize].kind != NodeKind::Fn
                || pcx.nodes[node as usize].d != 0 || pcx.nodes[node as usize].h != 0
                || (pcx.nodes[node as usize].p & FN_SIG_FAILED) != 0
                || pcx.fns[f as usize].generic != 0 || pcx.fns[f as usize].tmpl != 0
                || pcx.fns[f as usize].param_count < 1 {
                continue;
            }
            let last = pcx.fns[f as usize].param_count - 1;
            let t = (*pcx.tlists.data.add((pcx.fns[f as usize].params + last) as usize));
            if pcx.types[t as usize].kind != TyKind::Struct
                || pcx.structs[pcx.types[t as usize].a as usize].name != gpa
                || !within_std(pcx.structs[pcx.types[t as usize].a as usize].module, pcx) {
                continue;
            }
            let param = child(node, last, pcx);
            let (start, end) = (pcx.nodes[param as usize].start, pcx.nodes[param as usize].end);
            let lit = new_node(NodeKind::StructLit, start, end, pcx);
            pcx.nodes[lit as usize].a = gpa;
            pcx.nodes[lit as usize].p = NODE_IMPLICIT;
            let none = list_begin(pcx);
            list_end(lit, none, pcx);
            let bind = new_node(NodeKind::PatBind, start, end, pcx);
            pcx.nodes[bind as usize].a = pcx.nodes[param as usize].a;
            pcx.nodes[bind as usize].b = pcx.nodes[param as usize].c;
            let binding = new_node(NodeKind::Let, start, end, pcx);
            pcx.nodes[binding as usize].a = bind;
            pcx.nodes[binding as usize].b = pcx.nodes[param as usize].b;
            pcx.nodes[binding as usize].c = lit;
            let body = pcx.nodes[node as usize].c;
            let block = new_node(NodeKind::Block, pcx.nodes[body as usize].start,
                pcx.nodes[body as usize].end, pcx);
            pcx.nodes[block as usize].a = body;
            let mark = list_begin(pcx);
            list_push(binding, pcx);
            list_end(block, mark, pcx);
            pcx.nodes[node as usize].c = block;
            // (0.16 T5: `fn main(argc: i32, argv: **u8, gpa: Gpa)` keeps
            // the others)
            let kept = list_begin(pcx);
            for i in 0..last {
                list_push(child(node, i, pcx), pcx);
            }
            list_end(node, kept, pcx);
            pcx.fns[f as usize].param_count = last;
        }
    }
}
