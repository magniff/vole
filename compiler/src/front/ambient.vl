// Explicit allocation (0.16, the user's decision U1): nothing allocates
// without being given an allocator. A program's general-purpose
// allocator is the `gpa: Gpa` its `fn main(gpa: Gpa)` takes (main_gpa),
// passed down as a parameter; std has no ambient allocator. (0.26.3: std
// has no `Vec::new()`, `collect()`, `format(x)` either; a call of one is
// alloc.no_in, naming its `_in` form: front/check/alloc_rules.vl.) Here:
// main's Gpa, and the helps that say where a function's allocator comes
// from.

use crate::base::intern_c;
use crate::base::diag::{err_help, err_help_fmt};
use crate::front::ast::{
    FN_SIG_FAILED, NODES, NODE_IMPLICIT, NodeKind, child, list_begin, list_end, list_push, new_node,
};
use crate::front::check::lookup_local;
use crate::front::modules::within_std;
use crate::front::types::{FNS, FN_COUNT, STRUCTS, TLISTS, TYPES, TyKind};

// (0.25.2.1) In a #[test] fn (or a property or fuzz test) `name`, its node
// fnode (-1: none): the help that its allocator is a parameter too,
// `#[test] fn t(gpa: Gpa)`; whether it was given (`Gpa::default()`,
// `Gpa {}`, `gpa` not defined in a test).
pub fn test_gpa_help(fnode: i64, name: [u8]) -> bool {
    if fnode < 0 {
        return false;
    }
    let kind = crate::front::contracts::test_kind(fnode);
    if kind == 0 || kind == crate::front::contracts::TEST_CFG {
        return false;
    }
    err_help_fmt(
        format_args(
            "a #[test] fn takes the allocator as a parameter: `#[test] fn {name}(gpa: Gpa)`"));
    true
}

// (0.25.2.1) Where the allocator of function `name` (its node fnode, -1:
// none) comes from, for a help: a #[test] fn's parameter, main's, or a
// parameter to add to it.
pub fn gpa_param_help(fnode: i64, name: [u8]) {
    if test_gpa_help(fnode, name) {
        return;
    }
    if fnode >= 0 && name == "main" {
        err_help(c"main takes the allocator: `fn main(gpa: Gpa)`, passed down as a parameter");
    } else if fnode >= 0 {
        err_help_fmt(
            format_args("a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)': add the parameter `gpa: Gpa` to '{name}' and pass it down"));
    } else {
        err_help(c"a 'gpa: Gpa' comes from 'fn main(gpa: Gpa)' and is passed down as a parameter");
    }
}

// Whether the function being checked has a local or parameter `gpa`.
pub fn has_local_gpa() -> bool {
    match lookup_local(intern_c(c"gpa")) {
        Option::Some(_) => true,
        Option::None => false,
    }
}

// `fn main(gpa: Gpa)`, or a last parameter `gpa: Gpa` after main's others
// (`fn main(argc: i32, argv: **u8, gpa: Gpa)`) (called once the signatures are resolved, before
// main_result_wrapper): the program's general-purpose allocator, made by
// the runtime's entry. Its body becomes `{ let gpa: Gpa = Gpa {}; body }`
// (the literal flagged NODE_IMPLICIT: the one Gpa made outside std, which
// #[sealed] lets through) and main takes no parameter, as C's entry.
pub fn main_gpa() {
    unsafe {
        let main = intern_c(c"main");
        let gpa = intern_c(c"Gpa");
        for f in 0..FN_COUNT {
            let node = FNS[f].node;
            if FNS[f].name != main || NODES[node].kind != NodeKind::Fn || NODES[node].d != 0
                || NODES[node].h != 0 || (NODES[node].p & FN_SIG_FAILED) != 0
                || FNS[f].generic != 0 || FNS[f].tmpl != 0 || FNS[f].param_count < 1 {
                continue;
            }
            let last = FNS[f].param_count - 1;
            let t = TLISTS.data[FNS[f].params + last];
            if TYPES[t].kind != TyKind::Struct || STRUCTS[TYPES[t].a].name != gpa
                || !within_std(STRUCTS[TYPES[t].a].module) {
                continue;
            }
            let param = child(node, last);
            let (start, end) = (NODES[param].start, NODES[param].end);
            let lit = new_node(NodeKind::StructLit, start, end);
            NODES[lit].a = gpa;
            NODES[lit].p = NODE_IMPLICIT;
            let none = list_begin();
            list_end(lit, none);
            let bind = new_node(NodeKind::PatBind, start, end);
            NODES[bind].a = NODES[param].a;
            NODES[bind].b = NODES[param].c;
            let binding = new_node(NodeKind::Let, start, end);
            NODES[binding].a = bind;
            NODES[binding].b = NODES[param].b;
            NODES[binding].c = lit;
            let body = NODES[node].c;
            let block = new_node(NodeKind::Block, NODES[body].start, NODES[body].end);
            NODES[block].a = body;
            let mark = list_begin();
            list_push(binding);
            list_end(block, mark);
            NODES[node].c = block;
            // (0.16 T5: `fn main(argc: i32, argv: **u8, gpa: Gpa)` keeps
            // the others)
            let kept = list_begin();
            for i in 0..last {
                list_push(child(node, i));
            }
            list_end(node, kept);
            FNS[f].param_count = last;
        }
    }
}
