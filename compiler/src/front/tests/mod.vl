// Tests in the language (0.18, T2; docs/design/contracts-verification.md
// §2.6, §2.7): a `#[cfg(test)]` module sees its parent's items, test items
// are left out of other builds, and a test build (`--test-build`, what
// `volec test` uses) gets a `main` that runs the test its arguments
// name, with a generator for each property's parameters made from their
// types. The test build's code is made from the tokens, before parsing,
// as the trace and profile runtimes are: one source per module that has
// tests (or a type a property generates), in that module, so that its
// names (private ones too) are in scope. The runtime is std's Testing
// section (compiler/std/test.vl).

use crate::base::{
    IntVec, add_source, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, get_src,
    intern_c, out_path, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, pos_line};
use crate::front::ast::{NodeKind, child, list_begin, list_end, list_push};
use crate::front::contracts::{TEST_CFG, TEST_FN, TEST_FUZZ, TEST_PROPERTY, test_kind};
use crate::front::lexer::{Tok, lex_range};
use crate::front::modules::{file_of_pos, module_at, module_of, within_std};

// ---- A test module's view ----

// Whether module m is a `#[cfg(test)]` module, which sees its parent's
// items (private ones too) without an import, as a nested scope sees its
// parent's names (design §2.6; `use super::*` is not allowed).
pub fn is_test_module(m: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if pcx.test_item.count == 0 || m <= 0 {
            return false;
        }
        for i in 0..pcx.test_item.count {
            let n = (*pcx.test_item.data.add(i as usize));
            if (*pcx.test_kind.data.add(i as usize)) == TEST_CFG
                && pcx.nodes[n as usize].kind == NodeKind::Mod
                && pcx.nodes[n as usize].a == pcx.modules[m as usize].name
                && module_of(n, pcx) == pcx.modules[m as usize].parent {
                return true;
            }
        }
        false
    }
}

// Whether item n is for tests only: `#[test]`, `#[property]`, `#[fuzz]`,
// under `#[cfg(test)]`, or in a `#[cfg(test)]` module.
fn test_only(n: i64, pcx: &mut Ctx<Comp>) -> bool {
    if test_kind(n, pcx) != 0 {
        return true;
    }
    let mut m = module_of(n, pcx);
    while m > 0 {
        if is_test_module(m, pcx) {
            return true;
        }
        m = pcx.modules[m as usize].parent;
    }
    false
}

// After parsing, in a build (compile_program; not `check` or a query,
// which check the tests too): a build that is not for tests leaves the
// test items out.
pub fn drop_test_items(program: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.test_build || pcx.test_item.count == 0 {
            return;
        }
        let mut kept = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..pcx.nodes[program as usize].count {
            let item = child(program, i, pcx);
            if !test_only(item, pcx) {
                kept.push(item);
            }
        }
        if kept.count == pcx.nodes[program as usize].count {
            return;
        }
        let mark = list_begin(pcx);
        for i in 0..kept.count {
            list_push((*kept.data.add(i as usize)), pcx);
        }
        list_end(program, mark, pcx);
    }
}

// ---- The tokens of a test build ----

fn kind(i: i64, pcx: &Ctx<Comp>) -> Tok {
    if i < 0 || i >= pcx.toks.len() as i64 {
        return Tok::Eof;
    }
    pcx.toks[i as usize].kind
}

fn is_ident(i: i64, word: &[u8], pcx: &Ctx<Comp>) -> bool {
    kind(i, pcx) == Tok::Ident && sym_text(pcx.toks[i as usize].value as i64, pcx) == word
}

fn tok_text(i: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    &get_src()[pcx.toks[i as usize].start as usize..pcx.toks[i as usize].end as usize]
}

// The source text of tokens a..b (b excluded).
fn text_of(a: i64, b: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    if b <= a {
        return b"";
    }
    &get_src()[pcx.toks[a as usize].start as usize..pcx.toks[(b - 1) as usize].end as usize]
}

// The token after the bracket at i that closes it (kinds open/close).
fn after_close(i: i64, open: Tok, close: Tok, pcx: &Ctx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = i;
    while j < pcx.toks.len() as i64 {
        let k = kind(j, pcx);
        if k == open {
            depth += 1;
        } else if k == close {
            depth -= 1;
            if depth == 0 {
                return j + 1;
            }
        } else if k == Tok::Eof {
            return j;
        }
        j += 1;
    }
    j
}

// Whether token i is in the program's own files (not std's, nor a made
// runtime's).
fn in_program(i: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let f = file_of_pos(pcx.toks[i as usize].start, pcx);
        let m = pcx.files[f as usize].module;
        (*pcx.files[f as usize].path.add(0)) != b'<' && !within_std(m, pcx)
    }
}

// The end of a type's tokens from a: at a `,` or a closing bracket of the
// level it starts at, or `{`, `;`, `=` there.
fn type_end(a: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = a;
    loop {
        let k = kind(j, pcx);
        if k == Tok::Eof {
            return j;
        }
        if depth == 0 && (k == Tok::Comma || k == Tok::RParen || k == Tok::RBracket
            || k == Tok::Gt || k == Tok::Shr || k == Tok::LBrace || k == Tok::RBrace
            || k == Tok::Semi || k == Tok::Eq) {
            return j;
        }
        if k == Tok::LParen || k == Tok::LBracket || k == Tok::Lt {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket || k == Tok::Gt {
            depth -= 1;
        } else if k == Tok::Shr {
            depth -= 2;
            if depth < 0 {
                return j;
            }
        }
        j += 1;
    }
}

// A test found in the tokens.
#[derive(Clone, Copy)] pub struct Found {
    kind: i64, module: i64, name: i64, pos: i64, params: i64, close: i64,
    returns: i64, ret_end: i64, gpa: bool, label: i64,
}

// The kinds of a contract, tested as a property (a function with an
// `ensures`).
const TEST_CONTRACT: i64 = 5;

fn add_found(f: Found<'_>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.found_count == pcx.found_cap {
            let cap: i64 = if pcx.found_cap == 0 { 16 } else { pcx.found_cap * 2 };
            let bigger = crate::base::alloc_array::<Found<'_>>(cap);
            for i in 0..pcx.found_count {
                (*bigger.add(i as usize)) = (*pcx.found.add(i as usize));
            }
            pcx.found = bigger;
            pcx.found_cap = cap;
        }
        { let at_ix = pcx.found_count as usize; (*pcx.found.add(at_ix)) = f };
        pcx.found_count += 1;
    }
}

// The attribute `#[word]` at i (test, property, fuzz): its kind, else 0.
fn test_attribute_at(i: i64, pcx: &Ctx<Comp>) -> i64 {
    if kind(i, pcx) != Tok::Hash || kind(i + 1, pcx) != Tok::LBracket
        || kind(i + 3, pcx) != Tok::RBracket {
        return 0;
    }
    if is_ident(i + 2, b"test", pcx) {
        TEST_FN
    } else if is_ident(i + 2, b"property", pcx) {
        TEST_PROPERTY
    } else if is_ident(i + 2, b"fuzz", pcx) {
        TEST_FUZZ
    } else {
        0
    }
}

// The function after attribute tokens at i (more attributes, `pub`,
// `unsafe`): the index of its `fn`, else -1.
fn fn_after(i: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut j = i;
    loop {
        if kind(j, pcx) == Tok::Hash && kind(j + 1, pcx) == Tok::LBracket {
            j = after_close(j + 1, Tok::LBracket, Tok::RBracket, pcx);
        } else if kind(j, pcx) == Tok::Pub || kind(j, pcx) == Tok::Unsafe {
            j += 1;
        } else {
            break;
        }
    }
    if kind(j, pcx) == Tok::Fn && kind(j + 1, pcx) == Tok::Ident { j } else { -1 }
}

// The function at `fn` token f: its parameters' `(`, its result's tokens
// (-1: none) and where its signature ends (the body's `{`, or the first
// clause word).
fn read_signature(f: i64, kind_of: i64, pcx: &mut Ctx<Comp>) -> Found<'_> {
    let mut open = f + 2;
    if kind(open, pcx) == Tok::Lt {
        open = -1;
    }
    let close: i64 = if open >= 0 { after_close(open, Tok::LParen, Tok::RParen, pcx) - 1 }
        else { -1 };
    let mut returns: i64 = -1;
    let mut ret_end: i64 = -1;
    if close >= 0 && kind(close + 1, pcx) == Tok::Arrow {
        returns = close + 2;
        ret_end = returns;
        while kind(ret_end, pcx) != Tok::LBrace && kind(ret_end, pcx) != Tok::Semi
            && kind(ret_end, pcx) != Tok::Eof && !is_ident(ret_end, b"requires", pcx)
            && !is_ident(ret_end, b"ensures", pcx)
            && !is_ident(ret_end, b"debug", pcx) {
            ret_end += 1;
        }
    }
    Found {
        kind: kind_of, module: module_at(pcx.toks[f as usize].start, pcx),
        name: pcx.toks[(f + 1) as usize].value as i64,
        pos: pcx.toks[(f + 1) as usize].start, params: open, close, returns, ret_end, gpa: false,
        label: pcx.toks[(f + 1) as usize].value as i64,
    }
}

// The parameters of a found function: (name token, type start, type end)
// triples in `out`; false when one is not `name: T`.
fn params_of(t: Found<'_>, out: &mut IntVec, pcx: &Ctx<Comp>) -> bool {
    out.clear();
    if t.params < 0 {
        return false;
    }
    let mut j = t.params + 1;
    while j < t.close {
        if kind(j, pcx) == Tok::Mut {
            j += 1;
        }
        if kind(j, pcx) != Tok::Ident || kind(j + 1, pcx) != Tok::Colon {
            return false;
        }
        let mut a = j + 2;
        // (0.20: a convention is not the type: `v: sink Vec<i64>`)
        if kind(a, pcx) == Tok::Let {
            a += 1;
        }
        let b = type_end(a, pcx);
        out.push(j);
        out.push(a);
        out.push(b);
        j = b;
        if kind(j, pcx) == Tok::Comma {
            j += 1;
        } else if j != t.close {
            return false;
        }
    }
    true
}

// ---- Generators, from the parameters' types ----

fn want_type(name: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.wanted.count {
            if (*pcx.wanted.data.add(i as usize)) == name {
                return;
            }
        }
        pcx.wanted.push(name);
    }
}

fn int_type(s: &[u8]) -> bool {
    s == b"i64" || s == b"i32" || s == b"i16" || s == b"i8" || s == b"u64" || s == b"u32"
        || s == b"u16" || s == b"u8" || s == b"bool" || s == b"f64"
}

// The expression that generates a value of the type at tokens a..b into
// out (`g` is the generator); false, with the reason in `why`, when it is
// not generable.
fn gen_expr(out: i64, a: i64, b: i64, why: i64, pcx: &mut Ctx<Comp>) -> bool {
    let k = kind(a, pcx);
    if k == Tok::Star || k == Tok::Fn || k == Tok::Amp || k == Tok::AmpAmp {
        buf_bytes(why, if k == Tok::Fn { b"a function" } else { b"a pointer" });
        return false;
    }
    if k == Tok::LParen {
        // a tuple: its elements in order
        buf_byte(out, b'(');
        let mut j = a + 1;
        let mut n: i64 = 0;
        while j < b - 1 {
            let e = type_end(j, pcx);
            if n > 0 {
                buf_bytes(out, b", ");
            }
            if !gen_expr(out, j, e, why, pcx) {
                return false;
            }
            n += 1;
            j = if kind(e, pcx) == Tok::Comma { e + 1 } else { e };
        }
        if n == 1 {
            buf_byte(out, b',');
        }
        buf_byte(out, b')');
        return true;
    }
    if k == Tok::LBracket {
        let e = type_end(a + 1, pcx);
        if kind(e, pcx) == Tok::Semi {
            buf_bytes(why, b"an array");
            return false;
        }
        // a slice: an owned Vec, lent (gen_param)
        if e == a + 2 && is_ident(a + 1, b"u8", pcx) {
            put(out, b"std::gen_text(g)", pcx);
            return true;
        }
        put(out, b"std::gen_vec(g, |g: &mut std::Gen<Gpa>| ", pcx);
        if !gen_expr(out, a + 1, e, why, pcx) {
            return false;
        }
        buf_byte(out, b')');
        return true;
    }
    if k != Tok::Ident {
        buf_bytes(why, b"this type");
        return false;
    }
    // a path: its last name, and its arguments
    let mut last = a;
    let mut j = a;
    while j + 2 < b && kind(j + 1, pcx) == Tok::ColonColon && kind(j + 2, pcx) == Tok::Ident {
        j += 2;
        last = j;
    }
    let name = tok_text(last, pcx);
    let args: i64 = if kind(last + 1, pcx) == Tok::Lt { last + 2 } else { -1 };
    if args < 0 && int_type(name) {
        put(out, b"std::arbitrary_of::<", pcx);
        buf_bytes(out, name);
        buf_bytes(out, b">(g)");
        return true;
    }
    if args < 0 && (name == b"usize" || name == b"isize" || name == b"f32") {
        put(out, if name == b"f32" { b"(std::gen_f64(g) as f32)" } else { b"(g.int() as " }, pcx);
        if name != b"f32" {
            buf_bytes(out, name);
            buf_byte(out, b')');
        }
        return true;
    }
    // (0.26.3: `Buf<Gpa>`, `Vec<T, Gpa>`: std's generators make them on Gpa)
    let on_gpa = args >= 0 && tok_text(args, pcx) == b"Gpa" && type_end(args, pcx) == args + 1;
    // (0.28.0: the rust edition's text, `&str` lent a String)
    if rust_text(pcx) && (args < 0 && name == b"str" || (args < 0 || on_gpa) && name == b"String") {
        buf_bytes(out, b"std::test::gen_string(g)");
        return true;
    }
    if (args < 0 || on_gpa) && name == b"Buf" {
        put(out, b"std::gen_buf(g)", pcx);
        return true;
    }
    if args >= 0 && (name == b"Vec" || name == b"Option" || name == b"Result") {
        let e1 = type_end(args, pcx);
        if name == b"Vec" && kind(e1, pcx) == Tok::Comma
            && !(tok_text(e1 + 1, pcx) == b"Gpa" && type_end(e1 + 1, pcx) == e1 + 2) {
            buf_bytes(why, b"a Vec on another allocator than Gpa");
            return false;
        }
        put(out, if name == b"Vec" { b"std::gen_vec(g, |g: &mut std::Gen<Gpa>| " }
            else if name == b"Option" { b"std::gen_option(g, |g: &mut std::Gen<Gpa>| " }
            else { b"std::gen_result(g, |g: &mut std::Gen<Gpa>| " }, pcx);
        if !gen_expr(out, args, e1, why, pcx) {
            return false;
        }
        if name == b"Result" {
            put(out, b", |g: &mut std::Gen<Gpa>| ", pcx);
            if kind(e1, pcx) != Tok::Comma
                || !gen_expr(out, e1 + 1, type_end(e1 + 1, pcx), why, pcx) {
                return false;
            }
        }
        buf_byte(out, b')');
        return true;
    }
    if name == b"HashMap" || name == b"Arena" || name == b"Gpa" || name == b"ScopedArena" {
        buf_bytes(why, b"a ");
        buf_bytes(why, name);
        return false;
    }
    // any other type: its impl Arbitrary (std's, the program's, or one
    // made here for a struct or enum)
    // (0.28.0: a one-letter name too, `struct P`: it was taken for a type
    // parameter of a made impl and got no generator; put_arbitrary makes
    // nothing for a name that is no struct or enum of the program)
    want_type(pcx.toks[last as usize].value as i64, pcx);
    put(out, b"std::arbitrary_of::<", pcx);
    buf_bytes(out, text_of(a, b, pcx));
    buf_bytes(out, b">(g)");
    true
}

// Whether the type at a..b is printed with `{:?}`: a struct or enum only
// when it derives or implements Debug.
fn debug_type(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    for j in a..b {
        if kind(j, pcx) == Tok::LParen {
            return false;
        }
        if kind(j, pcx) == Tok::Ident {
            let s = tok_text(j, pcx);
            if !int_type(s) && s != b"Vec" && s != b"Option" && s != b"Result" && s != b"Buf"
                && s != b"usize" && s != b"isize" && s != b"f32" && s != b"std"
                && s != b"str" && s != b"String" && s != b"char"
                // (0.26.3: `Vec<i64, Gpa>`: an allocator argument, which
                // a container's Debug asks nothing of)
                && s != b"Gpa"
                && !has_debug(pcx.toks[j as usize].value as i64, pcx) {
                return false;
            }
        }
    }
    true
}

// Whether the program's type `name` derives or implements Debug.
fn has_debug(name: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.toks.len() as i64 {
        if kind(i, pcx) == Tok::Ident && pcx.toks[i as usize].value as i64 == name && i > 0
            && in_program(i, pcx) {
            let before = kind(i - 1, pcx);
            if before == Tok::Struct || before == Tok::Enum {
                // `#[derive(..., Debug, ...)]` above it
                let mut j = i - 2;
                while j >= 0 && kind(j, pcx) != Tok::Semi && kind(j, pcx) != Tok::RBrace
                    && kind(j, pcx) != Tok::LBrace {
                    if is_ident(j, b"Debug", pcx) {
                        return true;
                    }
                    j -= 1;
                }
            }
            if before == Tok::For && i >= 3 && (is_ident(i - 2, b"Debug", pcx)) {
                return true;
            }
        }
    }
    false
}

// Whether the program has `impl Arbitrary for name` (or std::Arbitrary).
fn has_arbitrary(name: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 2..pcx.toks.len() as i64 {
        if kind(i, pcx) == Tok::Ident && pcx.toks[i as usize].value as i64 == name
            && kind(i - 1, pcx) == Tok::For
            && is_ident(i - 2, b"Arbitrary", pcx) {
            return true;
        }
    }
    false
}

// ---- The code of a test build ----

fn text_for(m: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        while pcx.module_text.count <= m {
            pcx.module_text.push(-1);
            pcx.runs_tests.push(0);
        }
        if (*pcx.module_text.data.add(m as usize)) < 0 {
            (*pcx.module_text.data.add(m as usize)) = buf_new();
        }
        (*pcx.module_text.data.add(m as usize))
    }
}

fn module_path(out: i64, m: i64, pcx: &Ctx<Comp>) {
    if m <= 0 {
        return;
    }
    let p = pcx.modules[m as usize].parent;
    if p > 0 {
        module_path(out, p, pcx);
        buf_bytes(out, b"::");
    }
    buf_bytes(out, sym_text(pcx.modules[m as usize].name, pcx));
}

fn test_error(pos: i64, code: *mut u8, message: &[u8], help: &[u8], pcx: &mut Ctx<Comp>) {
    let kind_was = pcx.err_kind;
    pcx.err_kind = code;
    err_begin(pos, pcx);
    buf_bytes(pcx.err, message);
    if help.len() > 0 {
        crate::base::diag::err_help_fmt(str::from_utf8(help).unwrap(), pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = kind_was;
}

// The lines of a test's call: `NAME(args)` for a #[test] (with gpa), a
// property's closure for the others.
fn put_test_case(out: i64, t: Found<'_>, ps: IntVec, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let name = sym_text(t.name, pcx);
        if t.kind == TEST_FN {
            let mut call = buf_new();
            buf_bytes(call, name);
            buf_byte(call, b'(');
            let mut ok = true;
            let mut k: i64 = 0;
            while k < ps.count {
                let p = tok_text((*ps.data.add(k as usize)), pcx);
                let ty = text_of((*ps.data.add((k + 1) as usize)), (*ps.data.add((k + 2) as usize)),
                    pcx);
                if ty != b"Gpa" || k > 0 {
                    ok = false;
                }
                buf_bytes(call, p);
                buf_bytes(call, b": gpa");
                k += 3;
            }
            buf_byte(call, b')');
            if !ok {
                let m = buf_new();
                buf_bytes(m, b"'");
                buf_bytes(m, name);
                buf_bytes(m,
                    b"' is a #[test] with parameters: a #[test] takes nothing or `gpa: Gpa`");
                test_error(t.pos, c"test.signature", buf_slice(m),
                    b"a function of generated arguments is a #[property]", pcx);
                return false;
            }
            let returns = if t.returns >= 0 { text_of(t.returns, t.ret_end, pcx) } else { b"" };
            if returns.len() > 0 && returns != b"()" {
                buf_bytes(out, b"        match ");
                buf_bytes(out, buf_slice(call));
                put(out, b" { Ok(_) => {}, Err(e) => std::test_err(e), }\n", pcx);
            } else {
                buf_bytes(out, b"        ");
                buf_bytes(out, buf_slice(call));
                buf_bytes(out, b";\n");
            }
            put(out, b"        std::test_done();\n", pcx);
            if crate::front::stdalloc::get_check_alloc_mode() {
                // (--check-alloc: a test that leaves blocks allocated fails)
                put(out, b"        let mut leak_gpa = gpa;\n        if leak_gpa.live_blocks() > 0 {\n            leak_gpa.check_leaks();\n            std::test_leaked();\n        }\n", pcx);
            }
            return true;
        }
        // a property, a fuzz target or a contract: the values, then the call
        if t.kind == TEST_FUZZ {
            put_fuzz_words(out, pcx);
        }
        put(out, if t.kind == TEST_FUZZ { b"        std::run_fuzz_target(gpa, \"" }
            else { b"        std::run_property(gpa, \"" }, pcx);
        buf_bytes(out, sym_text(t.label, pcx));
        put(out, b"\", |g: &mut std::Gen<Gpa>| {\n", pcx);
        let call = buf_new();
        buf_bytes(call, name);
        buf_byte(call, b'(');
        let mut k: i64 = 0;
        while k < ps.count {
            let p = tok_text((*ps.data.add(k as usize)), pcx);
            let a = (*ps.data.add((k + 1) as usize));
            let b = (*ps.data.add((k + 2) as usize));
            if b == a + 1 && is_ident(a, b"Gpa", pcx) {
                // (0.25) an allocator parameter: the test's own, not generated
                buf_bytes(out, b"            let ");
                buf_bytes(out, p);
                buf_bytes(out, b" = gpa;\n");
                if k > 0 {
                    buf_bytes(call, b", ");
                }
                buf_bytes(call, p);
                k += 3;
                continue;
            }
            // (0.27.1: a rust-edition `&T`, `&mut T`: a T generated, then
            // lent to the call)
            let lend = lent(a, pcx);
            let a = a + lend_skip(a, pcx);
            let why = buf_new();
            let gen = buf_new();
            let bytes = t.kind == TEST_FUZZ && b == a + 3 && kind(a, pcx) == Tok::LBracket
                && is_ident(a + 1, b"u8", pcx);
            if bytes {
                // (a fuzz target's input, its bytes: std/fuzz.vl)
                put(gen, b"std::gen_bytes(g)", pcx);
            } else if !gen_expr(gen, a, b, why, pcx) {
                let m = buf_new();
                buf_bytes(m, b"no generator for '");
                buf_bytes(m, text_of(a, b, pcx));
                buf_bytes(m, b"' (");
                buf_bytes(m, buf_slice(why));
                buf_bytes(m, b"), parameter '");
                buf_bytes(m, p);
                buf_bytes(m, b"' of '");
                buf_bytes(m, name);
                buf_bytes(m, b"'");
                test_error(pcx.toks[(*ps.data.add(k as usize)) as usize].start, c"test.generate", buf_slice(m), b"parameters are generated from their types: numbers, bool, text, Vec, Option, Result, tuples, the program's structs and enums, a type with an `impl std::Arbitrary`", pcx);
                return false;
            }
            buf_bytes(out, if lend == 2 { b"            let mut " } else { b"            let " });
            buf_bytes(out, p);
            let slice = kind(a, pcx) == Tok::LBracket;
            if slice || lend > 0 {
                buf_bytes(out, b"_owned");
            }
            buf_bytes(out, b" = ");
            buf_bytes(out, buf_slice(gen));
            buf_bytes(out, b";\n");
            if slice || lend > 0 {
                buf_bytes(out, b"            let ");
                buf_bytes(out, p);
                buf_bytes(out, b" = ");
                if !slice {
                    buf_bytes(out, if lend == 2 { b"&mut " } else { b"&" });
                }
                buf_bytes(out, p);
                buf_bytes(out,
                    if !slice { b"_owned;\n" } else if lend == 2 { b"_owned.as_mut_slice();\n" }
                    else { b"_owned.as_slice();\n" });
            }
            if k > 0 {
                buf_bytes(call, b", ");
            }
            buf_bytes(call, p);
            k += 3;
        }
        buf_byte(call, b')');
        // (a contract's requires: an input that fails it is discarded)
        if t.kind == TEST_CONTRACT {
            put_requires_filters(out, t, pcx);
        }
        buf_bytes(out, b"            if g.showing() {\n");
        k = 0;
        while k < ps.count {
            let p = tok_text((*ps.data.add(k as usize)), pcx);
            if (*ps.data.add((k + 2) as usize)) == (*ps.data.add((k + 1) as usize)) + 1
                && is_ident((*ps.data.add((k + 1) as usize)), b"Gpa", pcx) {
                k += 3;
                continue;
            }
            put(out, b"                std::test_input(\"", pcx);
            buf_bytes(out, p);
            buf_bytes(out, b"\");\n");
            let a = (*ps.data.add((k + 1) as usize));
            let lend = lent(a, pcx);
            if debug_type(a + lend_skip(a, pcx), (*ps.data.add((k + 2) as usize)), pcx) {
                buf_bytes(out, b"                print(\"{");
                buf_bytes(out, p);
                buf_bytes(out, b":?}\");\n");
            } else {
                buf_bytes(out, b"                print(\"(no Debug)\");\n");
            }
            put(out, b"                std::test_input_end();\n", pcx);
            k += 3;
        }
        buf_bytes(out, b"            }\n");
        buf_bytes(out, b"            g.generated();\n");
        if t.kind == TEST_CONTRACT {
            buf_bytes(out, b"            let _ = ");
        } else {
            buf_bytes(out, b"            ");
        }
        buf_bytes(out, buf_slice(call));
        buf_bytes(out, b";\n");
        buf_bytes(out, b"        });\n");
        true
    }
}

// (0.27.1) A parameter's type at token a, a rust-edition `&T` (1), `&mut
// T` (2), or neither (0): a contract's generated T is lent to the call.
fn lent(a: i64, pcx: &Ctx<Comp>) -> i64 {
    if kind(a, pcx) != Tok::Amp {
        return 0;
    }
    let b = if kind(a + 1, pcx) == Tok::Lifetime { a + 2 } else { a + 1 };
    if kind(b, pcx) == Tok::Mut { 2 } else { 1 }
}

// The tokens of `&`, `&'a`, `&mut` before the lent type at a (0: none).
fn lend_skip(a: i64, pcx: &Ctx<Comp>) -> i64 {
    let l = lent(a, pcx);
    if l == 0 {
        return 0;
    }
    let lt: i64 = if kind(a + 1, pcx) == Tok::Lifetime { 1 } else { 0 };
    1 + lt + if l == 2 { 1 } else { 0 }
}

// A fuzz target's dictionary: the program's string constants (up to 64,
// of 32 bytes at most), which mutations put in its inputs.
fn put_fuzz_words(out: i64, pcx: &Ctx<Comp>) {
    let mut n: i64 = 0;
    let rust = rust_text(pcx);
    for i in 0..pcx.toks.len() as i64 {
        if n < 64 && kind(i, pcx) == Tok::Str && in_program(i, pcx) {
            let t = tok_text(i, pcx);
            // (0.28.0: in the rust edition, a text literal or a byte
            // string, `b".."`, its bytes; not a C string)
            let pre: i64 = if !rust || t.len() > 0 && t[0] == b'"' { 0 }
                else if t.len() > 1 && t[0] == b'b' && t[1] == b'"' { 1 } else { -1 };
            let len = t.len() as i64 - pre;
            if pre < 0 || len > 34 || len <= 2 {
                continue;
            }
            put(out, b"        std::fuzz_word(", pcx);
            buf_bytes(out, t);
            buf_bytes(out, if rust && pre == 0 { b".as_bytes());\n" } else { b");\n" });
            n += 1;
        }
    }
}

// A contract's `requires` clauses, as filters of the generated values
// (bound to the parameters' names).
fn put_requires_filters(out: i64, t: Found<'_>, pcx: &Ctx<Comp>) {
    let mut j = t.close + 1;
    while kind(j, pcx) != Tok::LBrace && kind(j, pcx) != Tok::Eof && kind(j, pcx) != Tok::Semi {
        if is_ident(j, b"requires", pcx) {
            let a = j + 1;
            let mut e = a;
            let mut depth: i64 = 0;
            loop {
                let k = kind(e, pcx);
                if k == Tok::Eof || depth == 0 && (k == Tok::LBrace || k == Tok::Else
                    || is_ident(e, b"requires", pcx) || is_ident(e, b"ensures", pcx)
                    || is_ident(e, b"debug", pcx)) {
                    break;
                }
                if k == Tok::LParen || k == Tok::LBracket {
                    depth += 1;
                } else if k == Tok::RParen || k == Tok::RBracket {
                    depth -= 1;
                }
                e += 1;
            }
            buf_bytes(out, b"            if !(");
            buf_bytes(out, text_of(a, e, pcx));
            put(out, b") { std::test_discard(); }\n", pcx);
            j = e;
        } else {
            j += 1;
        }
    }
}

// The function at `fn` token f has an `ensures` (a contract tested as a
// property): a free function, not generic, without `self`.
fn contract_at(f: i64, pcx: &Ctx<Comp>) -> bool {
    if kind(f + 2, pcx) != Tok::LParen || is_ident(f + 3, b"self", pcx) {
        return false;
    }
    let close = after_close(f + 2, Tok::LParen, Tok::RParen, pcx);
    let mut j = close;
    while kind(j, pcx) != Tok::LBrace && kind(j, pcx) != Tok::Semi && kind(j, pcx) != Tok::Eof {
        if is_ident(j, b"ensures", pcx)
            && !(kind(j - 1, pcx) == Tok::Ident && is_ident(j - 1, b"debug", pcx)) {
            return true;
        }
        j += 1;
    }
    false
}

// Whether the `fn` at token f is inside an impl or trait block (a method).
fn in_impl(f: i64, pcx: &Ctx<Comp>) -> bool {
    let mut depth: i64 = 0;
    let mut j = f - 1;
    while j >= 0 {
        let k = kind(j, pcx);
        if k == Tok::RBrace {
            depth += 1;
        } else if k == Tok::LBrace {
            if depth == 0 {
                // the block's head: `impl ... {` or `trait ... {`
                let mut h = j - 1;
                while h >= 0 && kind(h, pcx) != Tok::RBrace && kind(h, pcx) != Tok::LBrace
                    && kind(h, pcx) != Tok::Semi {
                    if kind(h, pcx) == Tok::Impl || kind(h, pcx) == Tok::Trait {
                        return true;
                    }
                    if kind(h, pcx) == Tok::Mod {
                        return false;
                    }
                    h -= 1;
                }
                return false;
            }
            depth -= 1;
        }
        j -= 1;
    }
    false
}

// A struct or enum's generator, an `impl std::Arbitrary`, into its
// module's text (structurally: its fields, or a variant then its fields).
fn put_arbitrary(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut at: i64 = -1;
        for i in 1..pcx.toks.len() as i64 {
            if kind(i, pcx) == Tok::Ident && pcx.toks[i as usize].value as i64 == name
                && (kind(i - 1, pcx) == Tok::Struct || kind(i - 1, pcx) == Tok::Enum)
                && in_program(i, pcx) {
                at = i;
                break;
            }
        }
        if at < 0 {
            return true;
        }
        let is_enum = kind(at - 1, pcx) == Tok::Enum;
        let out = text_for(module_at(pcx.toks[at as usize].start, pcx), pcx);
        // generics: `<T, U>` (names only)
        let params = buf_new();
        let bounds = buf_new();
        let mut j = at + 1;
        if kind(j, pcx) == Tok::Lt {
            j += 1;
            buf_byte(params, b'<');
            buf_byte(bounds, b'<');
            let mut n: i64 = 0;
            while kind(j, pcx) != Tok::Gt && kind(j, pcx) != Tok::Eof {
                if kind(j, pcx) == Tok::Ident
                    && (kind(j - 1, pcx) == Tok::Lt || kind(j - 1, pcx) == Tok::Comma) {
                    if n > 0 {
                        buf_bytes(params, b", ");
                        buf_bytes(bounds, b", ");
                    }
                    buf_bytes(params, tok_text(j, pcx));
                    buf_bytes(bounds, tok_text(j, pcx));
                    put(bounds, b": std::Arbitrary", pcx);
                    n += 1;
                }
                j += 1;
            }
            j += 1;
            buf_byte(params, b'>');
            buf_byte(bounds, b'>');
        }
        let ty = buf_new();
        buf_bytes(ty, sym_text(name, pcx));
        buf_bytes(ty, buf_slice(params));
        buf_bytes(out, b"impl");
        buf_bytes(out, buf_slice(bounds));
        put(out, b" std::Arbitrary for ", pcx);
        buf_bytes(out, buf_slice(ty));
        put(out, b" {\n    fn arbitrary(g: &mut std::Gen<Gpa>) -> ", pcx);
        buf_bytes(out, buf_slice(ty));
        buf_bytes(out, b" {\n");
        let why = buf_new();
        if !is_enum {
            buf_bytes(out, b"        ");
            buf_bytes(out, sym_text(name, pcx));
            buf_bytes(out, b" {");
            if kind(j, pcx) == Tok::LBrace {
                if !put_fields(out, j, why, pcx) {
                    return false;
                }
            }
            buf_bytes(out, b"}\n");
        } else {
            // the variants
            let mut count: i64 = 0;
            let mut k = j + 1;
            let end = after_close(j, Tok::LBrace, Tok::RBrace, pcx) - 1;
            let mut arm_list = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            while k < end {
                if kind(k, pcx) == Tok::Ident {
                    let arms = buf_new();
                    arm_list.push(arms);
                    buf_bytes(arms, sym_text(name, pcx));
                    buf_bytes(arms, b"::");
                    buf_bytes(arms, tok_text(k, pcx));
                    k += 1;
                    if kind(k, pcx) == Tok::LParen {
                        buf_byte(arms, b'(');
                        let mut e = k + 1;
                        let mut n: i64 = 0;
                        while kind(e, pcx) != Tok::RParen && e < end {
                            let te = type_end(e, pcx);
                            if n > 0 {
                                buf_bytes(arms, b", ");
                            }
                            if !gen_expr(arms, e, te, why, pcx) {
                                return false;
                            }
                            n += 1;
                            e = if kind(te, pcx) == Tok::Comma { te + 1 } else { te };
                        }
                        buf_byte(arms, b')');
                        k = e + 1;
                    } else if kind(k, pcx) == Tok::LBrace {
                        buf_bytes(arms, b" {");
                        if !put_fields(arms, k, why, pcx) {
                            return false;
                        }
                        buf_byte(arms, b'}');
                        k = after_close(k, Tok::LBrace, Tok::RBrace, pcx);
                    }
                    if kind(k, pcx) == Tok::Eq {
                        // (`A = 3`: the discriminant)
                        k += 2;
                    }
                    count += 1;
                }
                if kind(k, pcx) == Tok::Comma {
                    k += 1;
                } else if kind(k, pcx) != Tok::Ident {
                    k += 1;
                }
            }
            buf_bytes(out, b"        g.enter();\n        let k = if g.depth() > 3 { g.choose(1) } else { g.choose(");
            buf_int(out, count);
            buf_bytes(out, b") };\n        let v = match k {\n");
            for a in 0..arm_list.count {
                buf_bytes(out, b"            ");
                if a + 1 == arm_list.count {
                    buf_byte(out, b'_');
                } else {
                    buf_int(out, a);
                }
                buf_bytes(out, b" => ");
                buf_bytes(out, buf_slice((*arm_list.data.add(a as usize))));
                buf_bytes(out, b",\n");
            }
            buf_bytes(out, b"        };\n        g.leave();\n        v\n");
        }
        buf_bytes(out, b"    }\n}\n\n");
        true
    }
}

// The fields `{ a: T, b: U }` at the `{` token at j, generated.
fn put_fields(out: i64, j: i64, why: i64, pcx: &mut Ctx<Comp>) -> bool {
    let end = after_close(j, Tok::LBrace, Tok::RBrace, pcx) - 1;
    let mut k = j + 1;
    let mut n: i64 = 0;
    while k < end {
        if kind(k, pcx) == Tok::Pub {
            k += 1;
        }
        if kind(k, pcx) != Tok::Ident || kind(k + 1, pcx) != Tok::Colon {
            k += 1;
            continue;
        }
        let a = k + 2;
        let b = type_end(a, pcx);
        if n > 0 {
            buf_byte(out, b',');
        }
        buf_byte(out, b' ');
        buf_bytes(out, tok_text(k, pcx));
        buf_bytes(out, b": ");
        if !gen_expr(out, a, b, why, pcx) {
            return false;
        }
        n += 1;
        k = if kind(b, pcx) == Tok::Comma { b + 1 } else { b };
    }
    if n > 0 {
        buf_byte(out, b' ');
    }
    true
}

// After the modules' files are read (load_modules), in a test build: the
// tests found in the tokens, their code made and lexed into their
// modules, the program's own `main` renamed.
pub fn add_test_code(pcx: &mut Ctx<Comp>) {
    unsafe {
        plant_miscompile(pcx);
        if pcx.coverage {
            // (--coverage counts the IR's blocks: -O1 at least; std's
            // counters in the program)
            if pcx.opt_level < 1 {
                pcx.opt_level = 1;
            }
            if !pcx.test_build {
                let anchor = buf_new();
                put(anchor,
                    b"pub fn __vole_coverage() -> [u8] {\n    std::coverage()\n}\n", pcx);
                let start = add_source(c"<test>", anchor, pcx, 0);
                lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false,
                    pcx: pcx);
            }
        }
        if !pcx.test_build && !pcx.check_tests {
            return;
        }
        pcx.found_count = 0;
        pcx.wanted.clear();
        pcx.module_text.clear();
        pcx.runs_tests.clear();
        let count = pcx.toks.len() as i64;
        for i in 0..count {
            let attr = test_attribute_at(i, pcx);
            if attr != 0 && in_program(i, pcx) {
                let f = fn_after(i, pcx);
                if f >= 0 {
                    add_found(read_signature(f, attr, pcx), pcx);
                }
            }
            else if kind(i, pcx) == Tok::Fn && kind(i + 1, pcx) == Tok::Ident && in_program(i, pcx)
                && contract_at(i, pcx) && !in_impl(i, pcx) {
                add_found(read_signature(i, TEST_CONTRACT, pcx), pcx);
            }
        }
        // the program's main: renamed (the test main replaces it)
        let renamed: i64 = if pcx.test_build { count } else { 0 };
        for i in 0..renamed {
            if kind(i, pcx) == Tok::Fn && is_ident(i + 1, b"main", pcx) && in_program(i, pcx)
                && module_at(pcx.toks[i as usize].start, pcx) == 0 {
                pcx.toks[(i + 1) as usize].value = intern_c(c"__vole_program_main", pcx) as u64;
            }
        }
        // names: a test's own, else its path when two have it
        for t in 0..pcx.found_count {
            for u in 0..pcx.found_count {
                if u != t
                    && (*pcx.found.add(u as usize)).name == (*pcx.found.add(t as usize)).name {
                    let b = buf_new();
                    module_path(b, (*pcx.found.add(t as usize)).module, pcx);
                    if buf_slice(b).len() > 0 {
                        buf_bytes(b, b"::");
                    }
                    buf_bytes(b, sym_text((*pcx.found.add(t as usize)).name, pcx));
                    (*pcx.found.add(t as usize)).label = crate::base::intern(buf_slice(b), pcx);
                }
            }
        }
        // each module's cases
        let mut params = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for t in 0..pcx.found_count {
            let found = (*pcx.found.add(t as usize));
            if !params_of(found, &mut params, pcx) && found.params >= 0 {
                test_error(found.pos, c"test.signature", b"a test's parameters are `name: Type`",
                    b"", pcx);
                continue;
            }
            if found.params < 0 {
                test_error(found.pos, c"test.signature", b"a test is not generic", b"", pcx);
                continue;
            }
            let body = buf_new();
            if !put_test_case(body, found, params, pcx) || !pcx.test_build {
                continue;
            }
            // (kept in the module's dispatcher, below)
            let label = sym_text(found.label, pcx);
            let d = dispatch_for(found.module, pcx);
            buf_bytes(d, b"    if name == \"");
            buf_bytes(d, label);
            put(d, b"\" {\n        std::test_begin(\"", pcx);
            module_path(d, found.module, pcx);
            buf_bytes(d, b"\", \"");
            buf_bytes(d, sym_text(found.name, pcx));
            buf_bytes(d, b"\", gpa);\n");
            buf_bytes(d, buf_slice(body));
            buf_bytes(d, b"        return true;\n    }\n");
            // the list: KIND NAME FILE:LINE
            let l = list_text(pcx);
            buf_bytes(l, b"        println(\"vole-test: ");
            buf_bytes(l,
                if found.kind == TEST_FN { b"test " }
                else if found.kind == TEST_PROPERTY { b"property " }
                else if found.kind == TEST_FUZZ { b"fuzz " } else { b"contract " });
            buf_bytes(l, label);
            buf_byte(l, b' ');
            let f = file_of_pos(found.pos, pcx);
            put_c(l, out_path(f, pcx));
            buf_byte(l, b':');
            buf_int(l, pos_line(found.pos, pcx));
            buf_bytes(l, b"\");\n");
        }
        if !pcx.test_build {
            return;
        }
        // the types the properties generate
        let mut w: i64 = 0;
        while w < pcx.wanted.count {
            if !has_arbitrary((*pcx.wanted.data.add(w as usize)), pcx) {
                put_arbitrary((*pcx.wanted.data.add(w as usize)), pcx);
            }
            w += 1;
        }
        // the dispatchers: a module's children first, then its own tests
        for m in 0..pcx.module_text.count {
            if m < pcx.tests_dispatch.count && (*pcx.tests_dispatch.data.add(m as usize)) >= 0 {
                mark_runs(m, pcx);
            }
        }
        for m in 0..pcx.module_text.count {
            if (*pcx.runs_tests.data.add(m as usize)) == 0 {
                continue;
            }
            let out = text_for(m, pcx);
            put(out, b"pub fn __vole_tests(name: [u8], gpa: Gpa) -> bool {\n", pcx);
            for c in 0..pcx.module_text.count {
                if c > 0 && (*pcx.runs_tests.data.add(c as usize)) != 0
                    && pcx.modules[c as usize].parent == m {
                    buf_bytes(out, b"    if ");
                    buf_bytes(out, sym_text(pcx.modules[c as usize].name, pcx));
                    buf_bytes(out, b"::__vole_tests(name, gpa) {\n        return true;\n    }\n");
                }
            }
            if m < pcx.tests_dispatch.count && (*pcx.tests_dispatch.data.add(m as usize)) >= 0 {
                buf_bytes(out, buf_slice((*pcx.tests_dispatch.data.add(m as usize))));
            }
            buf_bytes(out, b"    false\n}\n\n");
        }
        // the root's: the test main
        let root = text_for(0, pcx);
        buf_bytes(root, b"fn main(gpa: Gpa) -> i32 {\n");
        put(root, b"    let name = std::test_args();\n    if name.len == 0 {\n", pcx);
        if pcx.list >= 0 {
            buf_bytes(root, buf_slice(pcx.list));
        }
        buf_bytes(root, b"        return 0;\n    }\n");
        if (*pcx.runs_tests.data.add(0)) != 0 {
            buf_bytes(root, b"    if __vole_tests(name, gpa) {\n        return 0;\n    }\n");
        }
        put(root, b"    std::test_unknown(name)\n}\n", pcx);
        // each module's text, lexed into it
        for m in 0..pcx.module_text.count {
            let b = (*pcx.module_text.data.add(m as usize));
            if b < 0 || buf_slice(b).len() == 0 {
                continue;
            }
            let start = add_source(c"<test>", b, pcx, 0);
            { let at_ix = (pcx.files.len() as i64 - 1) as usize; pcx.files[at_ix].module = m };
            lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false,
                pcx: pcx);
        }
    }
}

extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
}

// A test-only switch (tests/testcmd): with VOLE_PLANT_MISCOMPILE set, a
// build at -O1 or -O2 reads the literal 12345 as 12346, a difference
// between the levels for `volec test` to catch and `reduce --differs`
// to narrow down.
fn plant_miscompile(pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.opt_level < 1 || getenv(c"VOLE_PLANT_MISCOMPILE") == 0 as *mut u8 {
            return;
        }
        for i in 0..pcx.toks.len() as i64 {
            if pcx.toks[i as usize].kind == Tok::Int && pcx.toks[i as usize].value == 12345
                && in_program(i, pcx) {
                pcx.toks[i as usize].value = 12346;
            }
        }
    }
}

fn dispatch_for(m: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        while pcx.tests_dispatch.count <= m {
            pcx.tests_dispatch.push(-1);
        }
        if (*pcx.tests_dispatch.data.add(m as usize)) < 0 {
            (*pcx.tests_dispatch.data.add(m as usize)) = buf_new();
        }
        text_for(m, pcx);
        (*pcx.tests_dispatch.data.add(m as usize))
    }
}

fn list_text(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.list < 0 {
        pcx.list = buf_new();
    }
    pcx.list
}

// Module m and its ancestors run tests.
fn mark_runs(m: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut k = m;
        while k >= 0 {
            text_for(k, pcx);
            (*pcx.runs_tests.data.add(k as usize)) = 1;
            if k == 0 {
                break;
            }
            k = pcx.modules[k as usize].parent;
        }
    }
}

fn put_c(out: i64, s: *mut u8) {
    buf_str(out, s);
}

// (0.28.0) Whether the test code is written in the rust edition, on
// std2's runtime (std::test, compiler/std/test.vl): a rust-edition
// program on std2. Its `<test>` sources are read so (front/conv.vl:
// user_at).
fn rust_text(pcx: &Ctx<Comp>) -> bool {
    crate::front::known::on_std2(pcx)
}

// The test code's own text s into out: for rust_text, the runtime's
// names are std::test's (`std::test::run_property`) and the types the
// rust edition's (`name: &str`).
fn put(out: i64, s: &[u8], pcx: &Ctx<Comp>) {
    if !rust_text(pcx) {
        buf_bytes(out, s);
        return;
    }
    let mut i: usize = 0;
    while i < s.len() {
        let t = &s[i..];
        if t.starts_with(b"std::") && runtime_name(&t[5..]) {
            buf_bytes(out, b"std::test::");
            i += 5;
        } else if t.starts_with(b"name: [u8]") {
            buf_bytes(out, b"name: &str");
            i += 10;
        } else if t.starts_with(b"name.len == 0") {
            buf_bytes(out, b"name.is_empty()");
            i += 13;
        } else if t.starts_with(b"-> [u8] {") {
            buf_bytes(out, b"-> &'static [u8] {");
            i += 9;
        } else {
            buf_byte(out, s[i]);
            i += 1;
        }
    }
}

// Whether t starts with a name of the test runtime's (after `std::`).
fn runtime_name(t: &[u8]) -> bool {
    t.starts_with(b"Gen<") || t.starts_with(b"Arbitrary") || t.starts_with(b"arbitrary_of")
        || t.starts_with(b"gen_") || t.starts_with(b"test_") || t.starts_with(b"run_")
        || t.starts_with(b"fuzz_word") || t.starts_with(b"coverage")
}
