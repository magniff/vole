// Names across modules: what a name stands for in a module's scope (a
// binding), the `use` declarations and their resolution, lookups with
// privacy, the names `*` imports and C header imports bring, the prelude,
// and paths (`a::b::c`) resolved to what they name.

use crate::base::{
    IntVec, alloc_array, buf_bytes, buf_new, buf_slice, buf_str, cstr, get_bufs, get_src, grow,
    intern_c, sym_table, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_position, err_begin, err_end, err_end_soft, err_failed_name, err_fix, err_fixable, err_fmt,
    err_help, err_help_fmt, err_help_sym, err_jump, err_str, err_sym, err_try, err_try_fmt,
    error_at, fail_name, fix_at_ok,
};
use crate::front::ast::{NodeKind, child};
use crate::front::check::{Try, attempt, name_error};
use crate::front::check::collect::template_variant_named;
use crate::front::check::names::{help_near_item, help_nearest, import_path_for, near_to};
use crate::front::lexer::is_ident_byte;
use crate::front::modules::{
    child_module, file_of_pos, is_within, item_key_if_known, module_of, qualified_if_known, qualify,
    within_std,
};
use crate::front::modules::vis::{admits, module_admits};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{enum_variant, find_variant, get_enums, item_node_of};
use crate::tools::fix::note_private;
use crate::tools::query::QF_USE;
use crate::tools::query::command_line::{qnote, qnote_module};

// ---- Scopes ----

// What a name stands for in a scope: nothing, an item (by key), a module,
// a variant, or an item that is private there.
pub const B_NONE: i64 = 0;

pub const B_ITEM: i64 = 1;

pub const B_MODULE: i64 = 2;

pub const B_VARIANT: i64 = 3;

pub const B_PRIVATE: i64 = 4;

// A variant of a generic enum (0.6), by the enum's template (its ENUMS
// index): its type arguments are inferred where it is used.
pub const B_TVARIANT: i64 = 5;

// An ambiguous name (0.6): two `*` imports bring different things (code
// written for 0.7, being rewritten by --fix-imports).
pub const B_AMBIGUOUS: i64 = -4;

pub fn binding(kind: i64, value: i64) -> i64 {
    kind + value * 8
}

pub fn binding_kind(b: i64) -> i64 {
    b & 7
}

pub fn binding_value(b: i64) -> i64 {
    b >> 3
}

// `use` items: one entry per imported name, one per `*`.
#[derive(Clone, Copy)] pub struct UseEntry {
    module: i64, name: i64, item: i64, path: i64, glob: bool, public: bool,
    state: i64, result: i64, node: i64,
}

fn add_use_entry(module: i64, name: i64, item: i64, path: i64, glob: bool, public: bool, node: i64,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.use_entries = grow(pcx.use_entries, pcx.use_entry_count, &mut pcx.use_entry_cap);
        { let at_ix = pcx.use_entry_count as usize; (*pcx.use_entries.add(at_ix)) = UseEntry {
            module, name, item, path, glob, public, state: 0, result: 0, node,
        } };
    }
    unsafe { (*pcx.module_uses.add(module as usize)).push(pcx.use_entry_count); }
    pcx.use_entry_count += 1;
}

// The entries of the program's `use` and `import` items.
pub fn collect_uses(pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.sym_crate = intern_c(c"crate", pcx);
        pcx.sym_super = intern_c(c"super", pcx);
        pcx.sym_std = intern_c(c"std", pcx);
        // (0.26.2: each `pub(in path)` names a module around its item)
        crate::front::modules::vis::check_vis_paths(pcx);
        // (0.25) Each module's entries, filled as they are added: an
        // import is compared with its own module's entries only, not with
        // every entry of the program (that scan was 21% of `check`).
        pcx.module_uses = alloc_array::<IntVec>(pcx.modules.len() as i64);
        pcx.uses_indexed = 0;
        for i in 0..pcx.nodes[pcx.program as usize].count {
            let item = child(pcx.program, i, pcx);
            if pcx.nodes[item as usize].kind != NodeKind::Use {
                continue;
            }
            let m = module_of(item, pcx);
            let public = (pcx.nodes[item as usize].p & ITEM_PUBLIC) != 0;
            if pcx.nodes[item as usize].d == 2 {
                // `import "h.h";` sees the C module's items; `import "h.h"
                // as c;` names the module.
                if pcx.c_module < 0 {
                    continue;
                }
                let entry = pcx.use_entry_count;
                if pcx.nodes[item as usize].a == 0 {
                    pcx.legacy_imports = true;
                }
                add_use_entry(m, pcx.nodes[item as usize].a, 0, 0, pcx.nodes[item as usize].a == 0,
                    public, item, pcx);
                (*pcx.use_entries.add(entry as usize)).state = 2;
                (*pcx.use_entries.add(entry as usize)).result = binding(B_MODULE, pcx.c_module);
                continue;
            }
            let path = pcx.nodes[item as usize].c;
            if pcx.nodes[item as usize].b == 1 {
                pcx.legacy_imports = true;
                add_use_entry(m, -1, 0, path, true, public, item, pcx);
                continue;
            }
            for k in 0..pcx.nodes[item as usize].count {
                let id = child(item, k, pcx);
                // RULE: F19.2 (the rust edition: `use a::{self, B}` binds the
                // module a by its name)
                let self_import = pcx.nodes[id as usize].a == intern_c(c"self", pcx)
                    && pcx.nodes[path as usize].count > 0;
                if self_import {
                    // (the import's name is the module's; its text stays
                    // `self`, which resolve_use_of reads)
                    pcx.nodes[id as usize].a = pcx.nodes[child(path,
                        pcx.nodes[path as usize].count - 1, pcx) as usize].a;
                }
                let name = if pcx.nodes[id as usize].b != 0 { pcx.nodes[id as usize].b }
                    else { pcx.nodes[id as usize].a };
                // (a counted loop, not `.any`: a loop over a range's
                // iterator costs a move per element more at -O2)
                let mut twice = false;
                let own = (*pcx.module_uses.add(m as usize));
                for k2 in 0..own.count {
                    let e = (*own.data.add(k2 as usize));
                    if (*pcx.use_entries.add(e as usize)).name == name
                        && !(*pcx.use_entries.add(e as usize)).glob {
                        twice = true;
                        break;
                    }
                }
                if twice {
                    err_begin(pcx.nodes[id as usize].start, pcx);
                    err_fmt(format_args("'{}' is imported twice",
                        str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
                    err_end_soft(pcx);
                    continue;
                }
                add_use_entry(m, name, id, path, false, public, item, pcx);
            }
        }
        pcx.uses_indexed = pcx.modules.len() as i64;
        pcx.scopes_ready = true;
    }
}

// What use entry u imports: for `use p::x`, what x names in p; for `use
// p::*`, the module (or enum) p.
fn resolve_use(u: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if (*pcx.use_entries.add(u as usize)).state == 2 {
            return (*pcx.use_entries.add(u as usize)).result;
        }
        if (*pcx.use_entries.add(u as usize)).state == 1 {
            // (0.25.2.1) When the path starts with the name it imports
            // (`use text::{text, width};` in a module beside module
            // `text`), that name is the import, which hides the module: the
            // error names the clash, the path from the root its try: line.
            let path = (*pcx.use_entries.add(u as usize)).path;
            let name = (*pcx.use_entries.add(u as usize)).name;
            if !(*pcx.use_entries.add(u as usize)).glob && path > 0
                && pcx.nodes[path as usize].count > 0
                && pcx.nodes[child(path, 0, pcx) as usize].a == name {
                let seg = child(path, 0, pcx);
                let other = sibling_module((*pcx.use_entries.add(u as usize)).module, name, seg,
                    path, u, pcx);
                if other >= 0 {
                    err_begin(pcx.nodes[(*pcx.use_entries.add(u as usize)).node as usize].start,
                        pcx);
                    err_failed_name(name, pcx);
                    err_fmt(
                        format_args("this import depends on itself: its path starts with '{}', the name it imports, so '{}' is this import, not module 'crate::{}'", str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(sym_text(pcx.modules[other as usize].key, pcx)).unwrap()), pcx);
                    err_help(c"a name imported into a module hides the module of that name beside it: start the path at the root (or rename the module or the item)", pcx);
                    let parent = pcx.modules[other as usize].parent;
                    if parent <= 0 {
                        path_try(u, seg, path, b"crate", pcx);
                    } else {
                        let a = buf_new();
                        buf_str(a, c"crate::");
                        buf_bytes(a, sym_text(pcx.modules[parent as usize].key, pcx));
                        path_try(u, seg, path, buf_slice(a), pcx);
                    }
                    err_end(pcx);
                }
            }
            error_at(pcx.nodes[(*pcx.use_entries.add(u as usize)).node as usize].start,
                c"this import depends on itself", pcx);
        }
        (*pcx.use_entries.add(u as usize)).state = 1;
        // (an import that fails imports nothing, and the errors saying
        // its name is unknown follow from it: 0.10)
        if !attempt(Try::Use, u, pcx) {
            (*pcx.use_entries.add(u as usize)).result = B_NONE;
            if !(*pcx.use_entries.add(u as usize)).glob {
                fail_name((*pcx.use_entries.add(u as usize)).name, pcx);
            }
        }
        (*pcx.use_entries.add(u as usize)).state = 2;
        (*pcx.use_entries.add(u as usize)).result
    }
}

pub fn resolve_use_of(u: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let m = (*pcx.use_entries.add(u as usize)).module;
        let path = (*pcx.use_entries.add(u as usize)).path;
        let prefix = resolve_path(m, path, pcx.nodes[path as usize].count, u, pcx);
        let mut result: i64 = 0;
        if (*pcx.use_entries.add(u as usize)).glob {
            if binding_kind(prefix) == B_MODULE {
                result = prefix;
            }
            else if binding_kind(prefix) == B_ITEM
                && (*pcx.sym_enum.add(binding_value(prefix) as usize)) != 0 {
                result = prefix;
            } else {
                not_enum_or_module(path, pcx);
            }
        } else {
            let id = (*pcx.use_entries.add(u as usize)).item;
            let name = pcx.nodes[id as usize].a;
            if binding_kind(prefix) == B_MODULE
                && get_src()[
                    pcx.nodes[id as usize].start as usize..pcx.nodes[id as usize].end as usize]
                == b"self" {
                // RULE: F19.2 (`use a::{self}`: the module itself)
                result = prefix;
            } else if binding_kind(prefix) == B_MODULE {
                result = lookup_name(binding_value(prefix), name, m, pcx);
                if binding_kind(result) == B_PRIVATE {
                    access_error(result, pcx.nodes[id as usize].start, name, pcx);
                }
                // (0.20: std's built-in text is read in sections, and an
                // import of std's from a section not read imports nothing)
                if result == B_NONE && !(within_std(m, pcx) && pcx.std_tree == 0 as *mut u8) {
                    unresolved_import(id, path, prefix, m, pcx);
                }
            }
            else if binding_kind(prefix) == B_ITEM
                && (*pcx.sym_enum.add(binding_value(prefix) as usize)) != 0 {
                let e = (*pcx.sym_enum.add(binding_value(prefix) as usize)) - 1;
                let v = enum_variant_binding(e, name, pcx);
                if v == B_NONE {
                    err_begin(pcx.nodes[id as usize].start, pcx);
                    err_fmt(format_args("enum '{}' has no variant '{}'",
                        str::from_utf8(sym_text((*get_enums().add(e as usize)).name, pcx)).unwrap(),
                        str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
                    // (0.25.2.1: the nearest variants)
                    pcx.near_all.count = 0;
                    pcx.near_collect = true;
                    let mut near = near_to(name);
                    for i in 0..(*get_enums().add(e as usize)).variant_count {
                        near.offer(pcx.variants[enum_variant(e, i) as usize].name, pcx);
                    }
                    pcx.near_collect = false;
                    near.help(pcx);
                    if (*get_bufs().add(pcx.err_help as usize)).len == 0 {
                        help_nearest(c"its variants: ", name, pcx);
                    }
                    err_end(pcx);
                }
                result = v;
            } else {
                not_enum_or_module(path, pcx);
            }
        }
        (*pcx.use_entries.add(u as usize)).result = result;
        note_import((*pcx.use_entries.add(u as usize)).item, result, pcx);
    }
}

// `volec query` (0.11): what the name `use` item `id` imports.
fn note_import(id: i64, b: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if id == 0 {
            return;
        }
        let pos = pcx.nodes[id as usize].start;
        let name = pcx.nodes[id as usize].a;
        let kind = binding_kind(b);
        if kind == B_ITEM {
            qnote(pos, name, item_node_of(binding_value(b), pcx), QF_USE, pcx);
        } else if kind == B_VARIANT {
            qnote(pos, name, pcx.variants[binding_value(b) as usize].node, QF_USE, pcx);
        } else if kind == B_TVARIANT {
            let item = (*get_enums().add(binding_value(b) as usize)).node;
            for i in 0..pcx.nodes[item as usize].count {
                if pcx.nodes[child(item, i, pcx) as usize].a == name {
                    qnote(pos, name, child(item, i, pcx), QF_USE, pcx);
                }
            }
        } else if kind == B_MODULE {
            qnote_module(pos, name, binding_value(b), QF_USE, pcx);
        }
    }
}

fn not_enum_or_module(path: i64, pcx: &mut Ctx<Comp>) -> ! {
    let last = child(path, pcx.nodes[path as usize].count - 1, pcx);
    name_error(pcx.nodes[last as usize].start, c"'", pcx.nodes[last as usize].a, c"' is not an enum or a module (use brings the variants of an enum, or the items of a module, into scope)", pcx)
}

// Every use is resolved (once the enums' variants are known), the
// unused ones too: an import that names nothing still has its errors (the
// warning use.unused is check_program's, tools/fix).
pub fn resolve_all_uses(pcx: &mut Ctx<Comp>) {
    for u in 0..pcx.use_entry_count {
        resolve_use(u, pcx);
    }
}

// `use path::name;` where the module of path has no `name` (0.17: what
// std has instead, the nearest name there, or the module that has it).
fn unresolved_import(id: i64, path: i64, prefix: i64, from: i64, pcx: &mut Ctx<Comp>) -> ! {
    unsafe {
        err_begin(pcx.nodes[id as usize].start, pcx);
        err_str(c"unresolved import '", pcx);
        for i in 0..pcx.nodes[path as usize].count {
            err_fmt(format_args("{}::",
                str::from_utf8(sym_text(pcx.nodes[child(path, i, pcx) as usize].a, pcx)).unwrap()),
                pcx);
        }
        let name = pcx.nodes[id as usize].a;
        err_fmt(format_args("{}'", str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
        let pm = binding_value(prefix);
        if name == pcx.self_sym && pcx.nodes[path as usize].count > 0 {
            // (0.17) Rust's `use m::{self, X};`
            let p = buf_new();
            for i in 0..pcx.nodes[path as usize].count {
                if i > 0 {
                    buf_str(p, c"::");
                }
                buf_bytes(p, sym_text(pcx.nodes[child(path, i, pcx) as usize].a, pcx));
            }
            err_help_fmt(
                format_args("`self` in a `use` list is not supported: import the module on a line of its own, `use {};`, and the rest from it", str::from_utf8(buf_slice(p)).unwrap()), pcx);
            err_try_fmt(format_args("use {};", str::from_utf8(buf_slice(p)).unwrap()), pcx);
            err_end(pcx);
        }
        if pm == pcx.std_module {
            if !help_std_path(name, 0, from, true, pcx) && sym_text(name, pcx) == b"gpa" {
                err_help(c"the allocator is main's parameter, `fn main(gpa: Gpa)`, passed down",
                    pcx);
            }
        }
        // (0.25.2.2: the prelude's item, or another module's of std)
        crate::front::check::names::help_std_elsewhere(pm, name, true, pcx.std_module, pcx.cur_mod,
            (*get_bufs().add(pcx.err_help as usize)).len > 0, pcx);
        // (0.25.2.1: a function std has under another name)
        let syn = crate::front::check::names::std_synonym_help(sym_text(name, pcx));
        if within_std(pm, pcx) && syn.len() > 0
            && (*get_bufs().add(pcx.err_help as usize)).len == 0 {
            err_help_fmt(str::from_utf8(syn).unwrap(), pcx);
        }
        help_near_item(pm, name, pcx);
        if (*get_bufs().add(pcx.err_help as usize)).len == 0 {
            let other = import_path_for(name, true, pcx);
            let at = if other != 0 { other } else { import_path_for(name, false, pcx) };
            if at != 0 {
                err_help_fmt(format_args("'{}' is in {}",
                    str::from_utf8(sym_text(name, pcx)).unwrap(),
                    str::from_utf8(buf_slice(at)).unwrap()), pcx);
                err_try_fmt(format_args("use {}::{};", str::from_utf8(buf_slice(at)).unwrap(),
                    str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
            }
        }
        err_end(pcx)
    }
}

// (0.26.2: item.private, Rust's E0603; a restricted item, `pub(crate)`,
// says where it is visible)
pub fn private_error(pos: i64, name: i64, key: i64, pcx: &mut Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"item.private";
    err_begin(pos, pcx);
    let item: i64 = if key >= 0 && key < pcx.syms.len() as i64 { item_node_of(key, pcx) }
        else { 0 };
    let end: i64 = if item != 0 { crate::front::modules::vis::vis_end_of(item, pcx) } else { -1 };
    if end >= 0 {
        err_fmt(
            format_args("'{}' is visible only in {}", str::from_utf8(sym_text(name, pcx)).unwrap(),
                str::from_utf8(crate::front::modules::vis::vis_where(end, pcx)).unwrap()), pcx);
    } else {
        err_fmt(format_args("'{}' is private", str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
    }
    help_make_public(key, name, pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
    err_jump(pcx)
}

// The help of a private item (by key): its declaration with `pub` (0.14),
// `make it public: `pub fn f` at FILE: line L, column C`: the text of its
// first line up to its name, where `volec fix --only pub` writes `pub`.
fn help_make_public(key: i64, name: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let item: i64 = if key >= 0 && key < pcx.syms.len() as i64 { item_node_of(key, pcx) }
            else { 0 };
        if item == 0 {
            if child_module_key(key, pcx) {
                err_help_fmt(format_args("make it public: `pub mod {}`",
                    str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
            }
            return;
        }
        let start = pcx.nodes[item as usize].start;
        if (*pcx.files[file_of_pos(start, pcx) as usize].path.add(0)) == b'<' {
            // (std's)
            return;
        }
        let text = sym_text(name, pcx);
        let mut e = start;
        while e < pcx.nodes[item as usize].end && get_src()[e as usize] != b'\n' {
            e += 1;
        }
        // The first whole word `name` on the line.
        let mut stop: i64 = -1;
        let mut i = start;
        while i + text.len() as i64 <= e && stop < 0 {
            let same = (0i64..text.len() as i64).all(|k| get_src()[(i + k) as usize]
                == text[k as usize]);
            if same && (i == start || !ident_byte(get_src()[(i - 1) as usize]))
                && (i + text.len() as i64 == e
                    || !ident_byte(get_src()[(i + text.len() as i64) as usize])) {
                stop = i + text.len() as i64;
            }
            i += 1;
        }
        // (0.26.2: a restricted one, widened to its crate)
        let restricted = crate::front::modules::vis::vis_token(item, pcx) >= 0;
        err_help(if restricted { c"make it visible in its crate: `pub(crate) " }
            else { c"make it public: `pub " }, pcx);
        if stop > 0 {
            buf_bytes(pcx.err_help, &get_src()[start as usize..stop as usize]);
        } else {
            err_help_sym(name, pcx);
        }
        err_help(c"` at ", pcx);
        buf_position(pcx.err_help, start, pcx);
        // (0.18: `fix --suggested` adds it, as `fix --only pub`)
        err_fixable(pcx);
    }
}

fn ident_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// Whether key is a module's (`a::b` of `mod b;` in a).
fn child_module_key(key: i64, pcx: &Ctx<Comp>) -> bool {
    for m in 1..pcx.modules.len() as i64 {
        if pcx.modules[m as usize].key == key {
            return true;
        }
    }
    false
}

// The error for a binding that cannot be used: private, or (0.6) brought
// by two `*` imports.
pub fn access_error(b: i64, pos: i64, name: i64, pcx: &mut Ctx<Comp>) -> ! {
    // (0.18: `fix --suggested --at FILE:LINE`, the error at that line)
    if fix_at_ok(pos, pcx) {
        note_private(b, pcx);
    }
    if b == B_AMBIGUOUS {
        name_error(pos, c"'", name, c"' is ambiguous: more than one '*' import brings it (import it by name, or write its path)", pcx);
    }
    private_error(pos, name, binding_value(b), pcx)
}

// What `name` stands for in module m, seen from code in module `from`.
pub fn lookup_name(m: i64, name: i64, from: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // (not while the imports are recorded: see LEGACY_IMPORTS)
    let cacheable = pcx.scopes_ready && m == from && !pcx.legacy_imports;
    let k = (name + 1) * 65536 + m;
    if cacheable {
        let known = pcx.scope_cache.get(k);
        if known != 0 {
            return known - 1;
        }
    }
    let result = lookup_uncached(m, name, from, 0, pcx);
    if cacheable {
        pcx.scope_cache.put(k, result + 1);
    }
    result
}

// (0.20) The key of the item `std::NAME` names, -1 for none: std's own
// item, else what std re-exports under that name (std's items are in its
// modules, and `std::NAME` keeps naming them); before the imports are
// read, the item of that name in the first of std's modules that has one.
// (0.25.3) A program from the tools' cache has neither the items' nodes
// nor the scopes this asks: there, what the front end answered, as the
// cache keeps it (std_item_keys, restore_std_keys).
pub fn std_item_key(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.std_module < 0 || name < 0 {
        return -1;
    }
    // RULE: Z3.1 (0.27.2: on std2, a known item by its path in std2)
    if crate::front::known::on_std2(pcx) {
        let k = crate::front::known::std2_key(name, pcx);
        if k >= 0 {
            return k;
        }
    }
    if pcx.std_keys_restored {
        return pcx.std_keys.get(name + 1) - 1;
    }
    let own = item_key_if_known(pcx.std_module, name, pcx);
    if own >= 0 && item_node_of(own, pcx) != 0 {
        return own;
    }
    if pcx.scopes_ready {
        let b = lookup_quiet(pcx.std_module, name, pcx.std_module, pcx);
        return if binding_kind(b) == B_ITEM { binding_value(b) } else { -1 };
    }
    for m in 0..pcx.modules.len() as i64 {
        if m != pcx.std_module && within_std(m, pcx) {
            let k = item_key_if_known(m, name, pcx);
            if k >= 0 && item_node_of(k, pcx) != 0 {
                return k;
            }
        }
    }
    -1
}

// (0.25.3) std_item_key's answers for the tools' cache: for each of the
// first n symbols that `std::NAME` names an item by, the symbol and the
// item's key, into out (pairs). Asked of every symbol, as an answer from
// the cache may ask of any.
pub fn std_item_keys(n: i64, out: &mut IntVec, pcx: &mut Ctx<Comp>) {
    for s in 0..n {
        let k = std_item_key(s, pcx);
        if k >= 0 {
            out.push(s);
            out.push(k);
        }
    }
}

// (0.25.3) The answers std_item_keys kept, for a program restored from
// the tools' cache: std_item_key answers from them from then on.
pub fn restore_std_keys(pairs: IntVec, pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i + 1 < pairs.count {
        pcx.std_keys.put(pairs.get(i) + 1, pairs.get(i + 1) + 1);
        i += 2;
    }
    pcx.std_keys_restored = true;
}

// What `name` stands for in module m, seen from `from`, where a value or a
// type is wanted (0.14): when m has a child module `name` and imports an
// item of that name too (`mod eval; use eval::eval;`), the item, as in
// Rust; paths (`eval::other`) still go through the module.
pub fn lookup_item(m: i64, name: i64, from: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let b = lookup_name(m, name, from, pcx);
        if binding_kind(b) != B_MODULE || !pcx.scopes_ready {
            return b;
        }
        let inside = is_within(from, m, pcx);
        let count: i64 = if m < pcx.uses_indexed { (*pcx.module_uses.add(m as usize)).count }
            else { 0 };
        for k in 0..count {
            let u = (*(*pcx.module_uses.add(m as usize)).data.add(k as usize));
            if (*pcx.use_entries.add(u as usize)).name == name
                && !(*pcx.use_entries.add(u as usize)).glob
                && (inside || (*pcx.use_entries.add(u as usize)).public) {
                let item = resolve_use(u, pcx);
                if binding_kind(item) == B_ITEM || binding_kind(item) == B_PRIVATE {
                    return item;
                }
            }
        }
        b
    }
}

fn lookup_uncached(m: i64, name: i64, from: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let inside = is_within(from, m, pcx);
        // (no symbol is made for the names looked for and not found)
        let key = qualified_if_known(m, name, pcx);
        let item: i64 = if key >= 0 { item_node_of(key, pcx) } else { 0 };
        if item != 0 {
            // (0.26.2: `pub(crate)`, `pub(super)`, `pub(in path)`: public
            // up to a module, front/modules/vis.vl)
            if inside || (pcx.nodes[item as usize].p & ITEM_PUBLIC) != 0 && admits(item, from, pcx)
                || pcx.modules[m as usize].is_c {
                return binding(B_ITEM, key);
            }
            return binding(B_PRIVATE, key);
        }
        let c = child_module(m, name, pcx);
        if c >= 0 {
            if inside || pcx.modules[c as usize].public && module_admits(c, from, pcx) {
                return binding(B_MODULE, c);
            }
            return binding(B_PRIVATE, qualify(m, name, pcx));
        }
        if !pcx.scopes_ready || depth > 8 {
            return B_NONE;
        }
        // (only the module's own entries: its imports, then its `*` imports)
        let count: i64 = if m < pcx.uses_indexed { (*pcx.module_uses.add(m as usize)).count }
            else { 0 };
        for k in 0..count {
            let u = (*(*pcx.module_uses.add(m as usize)).data.add(k as usize));
            if (*pcx.use_entries.add(u as usize)).name == name
                && !(*pcx.use_entries.add(u as usize)).glob
                && (inside
                    || (*pcx.use_entries.add(u as usize)).public
                    && admits((*pcx.use_entries.add(u as usize)).node, from, pcx)) {
                return resolve_use(u, pcx);
            }
        }
        // `*` imports: two that bring different things make the name
        // ambiguous (an error where it is used; 0.6, before the first won).
        let mut globbed = B_NONE;
        let mut via: i64 = -1;
        for k in 0..count {
            let u = (*(*pcx.module_uses.add(m as usize)).data.add(k as usize));
            if !(*pcx.use_entries.add(u as usize)).glob
                || !(inside
                    || (*pcx.use_entries.add(u as usize)).public
                    && admits((*pcx.use_entries.add(u as usize)).node, from, pcx)) {
                continue;
            }
            let what = resolve_use(u, pcx);
            let mut found = B_NONE;
            if what == B_NONE {
                // (an import that failed)
                continue;
            }
            if binding_kind(what) == B_MODULE {
                let item = lookup_uncached(binding_value(what), name, m, depth + 1, pcx);
                let kind = binding_kind(item);
                if kind == B_ITEM || kind == B_MODULE || kind == B_VARIANT || kind == B_TVARIANT {
                    found = item;
                }
            } else {
                found = enum_variant_binding((*pcx.sym_enum.add(binding_value(what) as usize)) - 1,
                    name, pcx);
            }
            if found != B_NONE {
                if globbed == B_NONE {
                    globbed = found;
                    via = u;
                } else if globbed != found {
                    return B_AMBIGUOUS;
                }
            }
        }
        if globbed != B_NONE {
            if pcx.lookup_quiet == 0 {
                note_glob_use(via, name, m == from && depth == 0, pcx);
            }
            return globbed;
        }
        if pcx.modules[m as usize].is_c {
            // The imported declarations see the root's names (its types
            // replace the headers' of the same names).
            return lookup_uncached(0, name, 0, depth + 1, pcx);
        }
        // (0.18) A `#[cfg(test)]` module sees its parent's items, private
        // ones too, as a nested scope sees its parent's names (front/tests).
        if depth == 0 && m == from && crate::front::tests::is_test_module(m, pcx) {
            let up = lookup_uncached(pcx.modules[m as usize].parent, name, m, depth + 1, pcx);
            if up != B_NONE {
                return up;
            }
        }
        // The prelude is part of the scope of the code being checked, not an
        // item of the modules its `*` imports and paths go through.
        // (0.17: std's own code too: `None`, `Some(x)`)
        if pcx.std_module >= 0 && depth == 0 && m == from {
            return prelude_lookup(name, m, depth, pcx);
        }
        B_NONE
    }
}

// ---- What the `*` imports and the plain header imports bring (0.8) ----
//
// 0.8 removed `use a::b::*;`, `use E::*;` and `import "h.h";` (without
// `as`). They are still parsed and resolved, so that `volec
// --fix-imports` can turn code written for 0.7 into explicit imports, and
// the errors for them can name what replaces them. While a program has
// one (LEGACY_IMPORTS), every name a lookup finds through a `*` is
// recorded with the entry that brought it, and the scope cache is off
// (a lookup that only asks, LOOKUP_QUIET, records nothing; its caller
// repeats it with lookup_commit once the answer is used).

// The name at `pos` is a pattern's.
pub fn note_pattern_pos(pos: i64, pcx: &mut Ctx<Comp>) {
    if pcx.legacy_imports {
        pcx.pattern_pos.put(pos + 1, 1);
    }
}

fn glob_key(u: i64, name: i64) -> i64 {
    (u + 1) * 16777216 + name + 1
}

fn note_glob_use(u: i64, name: i64, bare: bool, pcx: &mut Ctx<Comp>) {
    if bare {
        unsafe {
            pcx.glob_via.put((name + 1) * 65536 + (*pcx.use_entries.add(u as usize)).module, u + 1);
        }
    }
    let k = glob_key(u, name);
    if pcx.glob_seen.get(k) == 0 {
        pcx.glob_seen.put(k, 1);
        pcx.glob_uses.push(u);
        pcx.glob_uses.push(name);
    }
}

// A lookup whose answer may go unused (records nothing).
pub fn lookup_quiet(m: i64, name: i64, from: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.lookup_quiet += 1;
    let b = lookup_name(m, name, from, pcx);
    pcx.lookup_quiet -= 1;
    b
}

// Bare name `name` at `pos`, looked up quietly in the current module, is
// used.
pub fn lookup_commit(name: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    if pcx.legacy_imports {
        note_c_use(pos, name, lookup_name(pcx.cur_mod, name, pcx.cur_mod, pcx), pcx);
    }
}

// Bare name `name` at `pos` in the current module stands for b: when b is
// a C declaration found through a `*` entry (a plain import, or a `*`
// that leads to one), the use is recorded for --fix-imports.
pub fn note_c_use(pos: i64, name: i64, b: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.legacy_imports || pcx.lookup_quiet > 0 || pcx.c_module < 0
        || binding_kind(b) != B_ITEM {
        return;
    }
    let via = pcx.glob_via.get((name + 1) * 65536 + pcx.cur_mod) - 1;
    if via < 0 || qualified_if_known(pcx.c_module, name, pcx) != binding_value(b)
        || pcx.qual_seen.get(pos + 1) != 0 {
        return;
    }
    pcx.qual_seen.put(pos + 1, 1);
    pcx.qual_names.put(glob_key(via, name), 1);
    if pcx.pattern_pos.get(pos + 1) != 0 {
        if pcx.by_name_seen.get(glob_key(via, name)) == 0 {
            pcx.by_name_seen.put(glob_key(via, name), 1);
            pcx.c_by_name.push(via);
            pcx.c_by_name.push(name);
        }
        return;
    }
    pcx.c_quals.push(pos);
    pcx.c_quals.push(via);
    pcx.c_quals.push(name);
}

// Whether the C declaration `name`, found through entry u, is written
// with its path instead (so it is not imported by name).
pub fn glob_name_qualified(u: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.qual_names.get(glob_key(u, name)) != 0
}

pub fn use_entry_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.use_entry_count
}

// Entry u: its `use`/`import` node, module, and whether it is a `*` (or a
// plain import, d = 2).
pub fn use_entry_node(u: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.use_entries.add(u as usize)).node }
}

pub fn use_entry_module(u: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.use_entries.add(u as usize)).module }
}

pub fn use_entry_glob(u: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { (*pcx.use_entries.add(u as usize)).glob }
}

// Variant `name` of enum e: B_VARIANT, or B_TVARIANT for a generic enum,
// or B_NONE.
pub fn enum_variant_binding(e: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    if unsafe { (*get_enums().add(e as usize)).generic > 0 } {
        if template_variant_named(e, name, pcx) {
            return binding(B_TVARIANT, e);
        }
        return B_NONE;
    }
    let v = find_variant(e, name, pcx);
    if v >= 0 { binding(B_VARIANT, v) } else { B_NONE }
}

// ---- The prelude (0.6) ----
//
// Names every module sees without `use`, after everything else (its own
// items, its imports): std's Option, Some, None, Result, Ok, Err, Vec,
// print and println (0.9: the operator traits and Hash; 0.14: Iterator;
// 0.15: Display, Debug, Clone, From, Into, format, eprint, eprintln;
// 0.17: Buf, HashMap, read_line, trim, ..., panic, unreachable, see
// prelude_name): a fixed list, not a `*` import (it stays in 0.8). The
// standard library is loaded when a program names one of them (or `std`;
// 0.14: or uses a range as a value, see load_std_if_named). (0.17) std's
// own code sees the prelude too.

// The number of the prelude's names; those from PRELUDE_LATE on (0.15's,
// 0.16's and 0.17's) load std only where the program uses them
// (front::modules::uses_prelude015). (0.18) The one bound of the prelude's
// tables (its names here, PRELUDE_DECLARED): a name is added to
// prelude_name's list and counted here.
pub const PRELUDE_COUNT: i64 = 71;

pub const PRELUDE_LATE: i64 = 18;

// The index of `panic` (0.17), which is std's safe `panic_str`, not the
// `unsafe fn panic` of a C string that `std::panic` names.
const PRELUDE_PANIC: i64 = 49;

// The index of `str` (0.20), and of `String` and `to_string_in` after it:
// std::string's, not std's (where `str` is the module std::str).
const PRELUDE_STR: i64 = 66;

pub fn prelude_name(i: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !pcx.prelude_interned {
        // (0.9: and the traits of the operators, and Hash; 0.14: Iterator;
        // 0.15: formatting, conversions, Clone; 0.16: allocators, format_in;
        // 0.17: what Rust has without a `use` or programs reach for first:
        // text and input, Buf, HashMap, sorting, cmp_of/eq_of, Fmt, a safe
        // panic and unreachable; the stable sorts; value semantics: Drop,
        // drop, forget, needs_drop, Copy; 0.18: the assertions; 0.18.1: the heaps;
        // 0.20: text, str and String, std::string's: prelude_lookup; 0.26.2:
        // TryFrom, as Rust 2021's)
        let names: [*mut u8; PRELUDE_COUNT] = [c"Option", c"Some", c"None", c"Result", c"Ok",
            c"Err", c"Vec", c"print", c"println", c"Add", c"Sub", c"Mul", c"Div", c"Neg", c"Eq",
            c"Ord", c"Hash", c"Iterator", c"Display", c"Debug", c"Clone", c"From", c"Into",
            c"format", c"eprint", c"eprintln", c"Allocator", c"Gpa", c"Arena", c"ScopedArena",
            c"arena_scope", c"format_in", c"Buf", c"HashMap", c"read_line", c"read_stdin_in",
            c"read_stdin", c"Scanner", c"parse_int", c"trim", c"split", c"split_in",
            c"split_whitespace", c"split_whitespace_in", c"cmp_of", c"eq_of", c"Fmt", c"sort",
            c"sort_by", c"panic", c"unreachable", c"sort_stable", c"sort_stable_by",
            c"sort_stable_in", c"sort_stable_by_in", c"Drop", c"drop", c"forget", c"needs_drop",
            c"Copy", c"assert", c"assert_eq", c"assert_ne", c"debug_assert", c"BinaryHeap",
            c"MinHeap", c"str", c"String", c"to_string_in", c"TryFrom", c"format_args"];
        unsafe {
            sym_table(&mut pcx.sym_prelude, pcx);
            for k in 0..PRELUDE_COUNT {
                let sym = intern_c(names[k as usize], pcx);
                pcx.prelude_names[k as usize] = sym;
                (*pcx.sym_prelude.add(sym as usize)) = k + 1;
            }
        }
        pcx.prelude_interned = true;
    }
    pcx.prelude_names[i as usize]
}

// The index of `name` in the prelude, -1 when it is not one of its names.
pub fn prelude_index(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    prelude_name(0, pcx);
    unsafe { (*pcx.sym_prelude.add(name as usize)) - 1 }
}

pub fn is_prelude_name(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    prelude_index(name, pcx) >= 0
}

// Whether name is one the prelude gained in 0.15 or later (Display, Debug,
// Clone, From, Into, format, eprint, eprintln; 0.16's Allocator, Gpa,
// Arena, ScopedArena, arena_scope, format_in; 0.17's Buf, HashMap, trim,
// ...): load_std_if_named looks at how a program uses these before it
// loads std for them.
pub fn is_prelude015(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    prelude_index(name, pcx) >= PRELUDE_LATE
}

fn prelude_lookup(name: i64, m: i64, depth: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // RULE: Z2.1 (0.27.2: a rust program on std2 reads std2's prelude, the
    // `pub use`s of `std::prelude`, not MVS's list)
    if pcx.std2 {
        let pm = lookup_uncached(pcx.std_module, intern_c(c"prelude", pcx), m, depth + 1, pcx);
        if binding_kind(pm) != B_MODULE {
            return B_NONE;
        }
        return lookup_uncached(binding_value(pm), name, m, depth + 1, pcx);
    }
    unsafe {
        let k = prelude_index(name, pcx);
        if k < 0 {
            return B_NONE;
        }
        let some = k == 1 || k == 2;
        let ok = k == 4 || k == 5;
        if some || ok {
            let e = lookup_uncached(pcx.std_module,
                if some { prelude_name(0, pcx) } else { prelude_name(3, pcx) }, m, depth + 1,
                pcx);
            if binding_kind(e) != B_ITEM || (*pcx.sym_enum.add(binding_value(e) as usize)) == 0 {
                return B_NONE;
            }
            return enum_variant_binding((*pcx.sym_enum.add(binding_value(e) as usize)) - 1, name,
                pcx);
        }
        if k >= PRELUDE_STR && k <= PRELUDE_STR + 2 {
            let sm = lookup_uncached(pcx.std_module, intern_c(c"string", pcx), m, depth + 1, pcx);
            if binding_kind(sm) != B_MODULE {
                return B_NONE;
            }
            return lookup_uncached(binding_value(sm), name, m, depth + 1, pcx);
        }
        if k == PRELUDE_PANIC {
            return lookup_uncached(pcx.std_module, intern_c(c"panic_str", pcx), m, depth + 1,
                pcx);
        }
        lookup_uncached(pcx.std_module, name, m, depth + 1, pcx)
    }
}

// The module (or the item, for the last segment) named by the first
// `count` segments of `path` (a Path node whose list holds Ident nodes),
// from module m: `crate`, `self` and `super` first; `std`. `entry`: the
// use entry whose path it is, or -1 (for the helps of its errors, 0.17).
pub fn resolve_path(m: i64, path: i64, count: i64, entry: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut cur = binding(B_MODULE, m);
        for i in 0..count {
            let seg = child(path, i, pcx);
            let name = pcx.nodes[seg as usize].a;
            if binding_kind(cur) != B_MODULE {
                name_error(pcx.nodes[seg as usize].start, c"'",
                    pcx.nodes[child(path, i - 1, pcx) as usize].a, c"' is not a module", pcx);
            }
            let here = binding_value(cur);
            if i == 0 && name == pcx.sym_crate {
                // RULE: Z1.1 (0.27.2: in std2, `crate` is std2's root)
                cur = binding(B_MODULE, if pcx.std2 && within_std(m, pcx) {
                    pcx.std_module } else { 0 });
                continue;
            }
            if i == 0 && name == pcx.self_sym {
                continue;
            }
            if name == pcx.sym_super
                && (i == 0 || pcx.nodes[child(path, i - 1, pcx) as usize].a == pcx.sym_super) {
                if pcx.modules[here as usize].parent < 0 {
                    error_at(pcx.nodes[seg as usize].start, c"the root module has no 'super'", pcx);
                }
                cur = binding(B_MODULE, pcx.modules[here as usize].parent);
                continue;
            }
            let found = lookup_name(here, name, m, pcx);
            if binding_kind(found) == B_PRIVATE {
                access_error(found, pcx.nodes[seg as usize].start, name, pcx);
            }
            if found == B_NONE {
                if i == 0 && name == pcx.sym_std && pcx.std_module >= 0 {
                    cur = binding(B_MODULE, pcx.std_module);
                    continue;
                }
                if i == 0 {
                    let other = sibling_module(m, name, seg, path, entry, pcx);
                    if other >= 0 {
                        cur = binding(B_MODULE, other);
                        qnote_module(pcx.nodes[seg as usize].start, name, other, 0, pcx);
                        continue;
                    }
                }
                err_begin(pcx.nodes[seg as usize].start, pcx);
                err_failed_name(name, pcx);
                if i == 0 {
                    err_fmt(format_args("unknown module '{}'",
                        str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
                    help_unknown_module(m, name, path, entry, pcx);
                } else {
                    err_fmt(format_args("no '{}' in module '",
                        str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
                    if here == 0 {
                        err_str(c"crate", pcx);
                    } else {
                        err_sym(pcx.modules[here as usize].key, pcx);
                    }
                    err_str(c"'", pcx);
                    if here == pcx.std_module {
                        let next: i64 = if i + 1
                            < pcx.nodes[path as usize].count { pcx.nodes[
                                child(path, i + 1, pcx) as usize].a }
                            else if entry >= 0 && !(*pcx.use_entries.add(entry as usize)).glob {
                                pcx.nodes[(*pcx.use_entries.add(entry as usize)).item as usize].a
                            } else { 0 };
                        help_std_path(name, next, m, entry >= 0, pcx);
                    }
                    // (0.25.2.2: the prelude's item, or another module's of std)
                    crate::front::check::names::help_std_elsewhere(here, name, entry >= 0,
                        pcx.std_module, pcx.cur_mod,
                        (*get_bufs().add(pcx.err_help as usize)).len > 0, pcx);
                    // (0.25.2.1: a function std has under another name)
                    let syn = crate::front::check::names::std_synonym_help(sym_text(name, pcx));
                    if within_std(here, pcx) && syn.len() > 0
                        && (*get_bufs().add(pcx.err_help as usize)).len == 0 {
                        err_help_fmt(str::from_utf8(syn).unwrap(), pcx);
                    }
                    help_near_item(here, name, pcx);
                }
                err_end(pcx);
            }
            cur = found;
            if binding_kind(found) == B_MODULE {
                qnote_module(pcx.nodes[seg as usize].start, name, binding_value(found), 0, pcx);
            }
        }
        cur
    }
}

// (0.17) The module the first segment `name` (node seg) of a path names
// when module m, where it is written, has nothing of that name: a child
// of m's parent (a sibling: `use lexer::Tok;` or `lexer::next(..)` in
// parser.vl, where main.vl has `mod lexer;`), else a child of the
// root; -1: neither. A `use` path (its entry) and a path in code (entry
// -1: a type's, a literal's, an expression's, ending where node path
// ends) alike. Both, and different modules: an error, the two paths from
// the root its try: lines.
pub fn sibling_module(m: i64, name: i64, seg: i64, path: i64, entry: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // (0.20: std's root is std, not the program's)
    if m == 0 || m == pcx.std_module {
        return -1;
    }
    let root: i64 = if within_std(m, pcx) { pcx.std_module } else { 0 };
    let parent = pcx.modules[m as usize].parent;
    let mut sibling: i64 = -1;
    if parent >= 0 {
        sibling = child_module(parent, name, pcx);
    }
    let mut top: i64 = -1;
    if parent != root {
        top = child_module(root, name, pcx);
    }
    if sibling == pcx.std_module || sibling == pcx.c_module {
        sibling = -1;
    }
    if top == pcx.std_module || top == pcx.c_module {
        top = -1;
    }
    if sibling >= 0 && top >= 0 && sibling != top {
        err_begin(pcx.nodes[seg as usize].start, pcx);
        err_failed_name(name, pcx);
        err_fmt(
            format_args(
                "ambiguous module '{}': crate::{} (beside this module) or crate::{} (at the root)", str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(sym_text(pcx.modules[sibling as usize].key, pcx)).unwrap(), str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
        err_help(c"a path that starts with neither `crate`, `self`, `super` nor a name of this module starts beside it, or at the root: name the one you mean", pcx);
        let a = buf_new();
        buf_str(a, c"crate::");
        buf_bytes(a, sym_text(pcx.modules[parent as usize].key, pcx));
        path_try(entry, seg, path, buf_slice(a), pcx);
        path_try(entry, seg, path, b"crate", pcx);
        err_end(pcx);
    }
    if sibling >= 0 { sibling } else { top }
}

// (0.17) A try: line for use entry `entry`: its line with `prefix::`
// written before its path (`use crate::lexer::{Tok, mk};`).
fn use_line_try(entry: i64, path: i64, prefix: &[u8], pcx: &mut Ctx<Comp>) {
    unsafe {
        let node = (*pcx.use_entries.add(entry as usize)).node;
        let at = pcx.nodes[path as usize].start;
        let t = buf_new();
        buf_bytes(t, &get_src()[pcx.nodes[node as usize].start as usize..at as usize]);
        buf_bytes(t, prefix);
        buf_str(t, c"::");
        let mut e = pcx.nodes[node as usize].end;
        while e > at && get_src()[(e - 1) as usize] != b';' {
            e -= 1;
        }
        let stop = if e > at { e } else { pcx.nodes[node as usize].end };
        buf_bytes(t, &get_src()[at as usize..stop as usize]);
        err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
        // (0.18) the fix: the line so written
        err_fix(pcx.nodes[node as usize].start, stop, buf_slice(t), pcx);
    }
}

// (0.17) A try: line for a path (its first segment, node seg) with
// `prefix::` written before it: a `use` entry's line (use_line_try), or the
// path in code, its names and `::`s (`crate::front::util::twice`).
fn path_try(entry: i64, seg: i64, path: i64, prefix: &[u8], pcx: &mut Ctx<Comp>) {
    if entry >= 0 {
        use_line_try(entry, path, prefix, pcx);
        return;
    }
    let start = pcx.nodes[seg as usize].start;
    let mut end = start;
    while is_ident_byte(get_src()[end as usize]) || get_src()[end as usize] == b':' {
        end += 1;
    }
    while end > start && get_src()[(end - 1) as usize] == b':' {
        end -= 1;
    }
    let t = buf_new();
    buf_bytes(t, prefix);
    buf_str(t, c"::");
    buf_bytes(t, &get_src()[start as usize..end as usize]);
    err_try_fmt(str::from_utf8(buf_slice(t)).unwrap(), pcx);
    // (0.18) the fix: the first segment so written
    let full = buf_new();
    buf_bytes(full, prefix);
    buf_str(full, c"::");
    buf_bytes(full, sym_text(pcx.nodes[seg as usize].a, pcx));
    path_fix(start, pcx.nodes[seg as usize].a, buf_slice(full), pcx);
}

// (0.17) The help of `unknown module 'name'` at the start of path, from
// module m: a module of that name elsewhere in the crate is reached from
// the root (`crate::name::...`; for a `use`, its line so written is the
// try:); a Rust std module is std's item; else the nearest module.
fn help_unknown_module(m: i64, name: i64, path: i64, entry: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut found: i64 = -1;
        if m != 0 && pcx.modules[m as usize].parent >= 0 {
            found = child_module(pcx.modules[m as usize].parent, name, pcx);
        }
        if m != 0 && found < 0 {
            found = child_module(0, name, pcx);
        }
        if found == m || found == pcx.std_module || found == pcx.c_module {
            found = -1;
        }
        if found < 0 {
            for k in 1..pcx.modules.len() as i64 {
                if pcx.modules[k as usize].name == name && k != pcx.std_module && k != pcx.c_module
                    && k != m
                    && !is_within(k, pcx.std_module, pcx) {
                    found = k;
                    break;
                }
            }
        }
        if found >= 0 {
            let full = buf_new();
            buf_str(full, c"crate");
            if pcx.modules[found as usize].parent != 0 {
                buf_str(full, c"::");
                buf_bytes(full,
                    sym_text(pcx.modules[pcx.modules[found as usize].parent as usize].key, pcx));
            }
            err_help_fmt(
                format_args("'{}' is the module {}::{}; a path starts in this module, beside it or at the root: write `{}::{}::...`", str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(buf_slice(full)).unwrap(), str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(buf_slice(full)).unwrap(), str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
            if entry >= 0 {
                use_line_try(entry, path, buf_slice(full), pcx);
            } else {
                // (a type or a literal's path: the module imported, as
                // module_as_path_error's for an expression)
                err_try_fmt(format_args("use {}::{};", str::from_utf8(buf_slice(full)).unwrap(),
                    str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
                // (0.18) the fix: the path from the crate's root
                buf_str(full, c"::");
                buf_bytes(full, sym_text(name, pcx));
                path_fix(if path > 0 { pcx.nodes[path as usize].start } else { -1 }, name,
                    buf_slice(full), pcx);
            }
            return;
        }
        // (0.25.2.2: a module file checked alone, its sibling beside it)
        if m == 0 {
            let mut r: i64 = 0;
            while r < pcx.files.len() as i64 && (*pcx.files[r as usize].path.add(0)) == b'<' {
                r += 1;
            }
            if r < pcx.files.len() as i64 && crate::front::modules::beside_root_help(
                cstr(pcx.files[r as usize].path), sym_text(name, pcx), pcx) {
                return;
            }
        }
        // (0.25.3) a module std has (before help_std_path: Rust's modules)
        if pcx.std_module >= 0 && m != pcx.std_module && !is_within(m, pcx.std_module, pcx)
            && std_has_module(sym_text(name, pcx)) {
            std_module_help(m, name, path, entry, entry >= 0, pcx);
            return;
        }
        if help_std_path(name, 0, m, entry >= 0, pcx) {
            return;
        }
        help_near_item(m, name, pcx);
    }
}

// (0.25.3, eval 0.25.2.2: terrain) The help of `unknown module 'gpu'` when
// std has the module: a `use` of its items (`use std::gpu::{Surface};`)
// does not bring its name, `use std::gpu;` does (the fix adds it); in a
// `use` line (in_use), the path from std (`use std::gpu::Surface;`, the
// line so written when its entry is known).
fn std_module_help(m: i64, name: i64, path: i64, entry: i64, in_use: bool, pcx: &mut Ctx<Comp>) {
    let t = sym_text(name, pcx);
    if in_use {
        err_help_fmt(
            { let t = str::from_utf8(t).unwrap(); format_args("'{t}' is std's module std::{t}: a path in a `use` starts at `std`, `crate` or a module of this one") }, pcx);
        if entry >= 0 && path > 0 {
            use_line_try(entry, path, b"std", pcx);
        }
        return;
    }
    err_help_fmt(
        { let t = str::from_utf8(t).unwrap(); format_args("'{t}' is std's module std::{t}: its name comes with `use std::{t};` (then `{t}::NAME`; importing its items, `use std::{t}::{{A, B}};`, does not bring it), or write the path `std::{t}::NAME`") }, pcx);
    crate::tools::fix::note_missing_use(m, intern_c(c"std", pcx), name, pcx);
    err_fixable(pcx);
}

// (0.25.3) Whether std has a module `name` of its own (std::gpu, std::fs),
// loaded or not: from the list of std's files (`gpu/mod.vl`, `fs.vl`;
// `flat/` is std itself).
pub fn std_has_module(name: &[u8]) -> bool {
    let files = buf_new();
    crate::front::stdsrc::std_files(files);
    let list = buf_slice(files);
    let mut a: i64 = 0;
    while a < list.len() as i64 {
        let mut e = a;
        while e < list.len() as i64 && list[e as usize] != b'\n' {
            e += 1;
        }
        let mut s = a;
        while s < e && list[s as usize] != b' ' {
            s += 1;
        }
        a = e + 1;
        if s >= e {
            continue;
        }
        let file = &list[(s + 1) as usize..e as usize];
        let mut f = if file.len() > 3 { &file[0..(file.len() as i64 - 3) as usize] } else { file };
        if f.len() > 4 && f[(f.len() as i64 - 4) as usize..] == b"/mod" {
            f = &f[0..(f.len() as i64 - 4) as usize];
        }
        if f == name {
            return true;
        }
    }
    false
}

// (0.17) `table::f(x)` in an expression (Path node path at `at`), where
// `table` is no name of module m nor a module beside it or at the root
// (those are found as a `use` path's are), but a module elsewhere in the
// crate: the error names it and its `use` line; returns when no module
// has that name.
pub fn module_as_path_error(m: i64, name: i64, at: i64, path: i64, pcx: &mut Ctx<Comp>) {
    let mut found: i64 = -1;
    for k in 1..pcx.modules.len() as i64 {
        if pcx.modules[k as usize].name == name && k != pcx.std_module && k != pcx.c_module
            && k != m
            && !is_within(k, pcx.std_module, pcx) {
            found = k;
            break;
        }
    }
    if found < 0 {
        return;
    }
    err_begin(at, pcx);
    err_failed_name(name, pcx);
    err_fmt(format_args("unknown module '{}'", str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
    help_unknown_module(m, name, path, -1, pcx);
    err_end(pcx)
}

// (0.18) The fix of a path whose first segment, module `name` at `at`
// (-1: unknown), is written from the crate's root: `full` in its place.
fn path_fix(at: i64, name: i64, full: &[u8], pcx: &mut Ctx<Comp>) {
    let text = sym_text(name, pcx);
    if at < 0 || &get_src()[at as usize..(at + text.len() as i64) as usize] != text
        || get_src()[(at + text.len() as i64) as usize] != b':' {
        return;
    }
    err_fix(at, at + text.len() as i64, full, pcx);
}

// (0.17) The help of a path through `std::name` that std does not have,
// `next` the name after it (or 0), seen from module m: (0.20) std has a few
// of Rust's modules and every item at `std::NAME` too, so a Rust path (`std::collections::HashMap`, `std::io`) is
// std's item itself (`std::HashMap`, the `use` line as try:), or what
// replaces that module (`in_use`: the path is a `use` item's; else the
// try: is the path to write). Whether there was a help.
pub fn help_std_path(name: i64, next: i64, m: i64, in_use: bool, pcx: &mut Ctx<Comp>) -> bool {
    let t = sym_text(name, pcx);
    // (0.25.3) a module std has, written without `std::` (`fs::read_in`)
    if next == 0 && pcx.std_module >= 0 && m != pcx.std_module && !is_within(m, pcx.std_module, pcx)
        && std_has_module(t) {
        std_module_help(m, name, 0, -1, in_use, pcx);
        return true;
    }
    if next != 0 && pcx.std_module >= 0
        && binding_kind(lookup_quiet(pcx.std_module, next, m, pcx)) == B_ITEM {
        err_help_fmt(
            { let t = str::from_utf8(t).unwrap();
                format_args(
                    "vole's std has no module '{t}': std's items are all `std::NAME` too") },
            pcx);
        if in_use {
            err_try_fmt(format_args("use std::{};", str::from_utf8(sym_text(next, pcx)).unwrap()),
                pcx);
        } else {
            err_try_fmt(format_args("std::{}", str::from_utf8(sym_text(next, pcx)).unwrap()), pcx);
        }
        return true;
    }
    if t == b"io" {
        err_help(c"stdin is `read_line(&buf)` (a line), `read_stdin_in(gpa)` (all of it, a Vec<u8>), `Scanner` (tokens); output is `print`, `println`", pcx);
        err_try(c"use std::{Scanner, read_line, read_stdin_in};", pcx);
    } else if t == b"collections" {
        err_help(c"`HashMap<K, V>` (a set: `HashMap<K, bool>`), `Vec<T>` (in the prelude)", pcx);
        err_try(c"use std::HashMap;", pcx);
    } else if t == b"fmt" {
        err_help(
            c"`Display` (`fn fmt(self: *T, f: *Fmt)`), `Fmt`", pcx);
        err_try(c"use std::{Display, Fmt};", pcx);
    } else if t == b"string" || t == b"str" || t == b"char" {
        err_help(c"text is `[u8]` (string literals are one), built in a `std::Buf`; std's text functions are `std::trim`, `std::split_in`, `std::parse_int`, ...", pcx);
        err_try(c"use std::Buf;", pcx);
    } else if t == b"vec" || t == b"option" || t == b"result" || t == b"prelude" {
        err_help(
            c"`Vec`, `Option`, `Result` and their variants are in the prelude: no `use` needed",
            pcx);
    } else if t == b"mem" || t == b"cmp" || t == b"iter" || t == b"ops" || t == b"convert"
        || t == b"hash" || t == b"process" || t == b"env" || t == b"fs" || t == b"num"
        || t == b"boxed" || t == b"rc" || t == b"cell" || t == b"sync" || t == b"thread"
        || t == b"time" || t == b"path" || t == b"slice" || t == b"error" || t == b"core"
        || t == b"alloc" {
        // (0.20: std's modules are iter, ops, slice, collections, io, fmt,
        // num, convert and clone)
        err_help(c"vole's std has no such module: std's items are all `std::NAME` too (`volec query items std` lists them)", pcx);
    } else {
        return false;
    }
    true
}

// The item a node names through a path of modules (h of a StructLit or a
// PatVariant, the list of a TyName or a Path): the module after its
// segments, from the module being checked.
pub fn path_module(path: i64, count: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = resolve_path(pcx.cur_mod, path, count, -1, pcx);
    if binding_kind(b) != B_MODULE {
        name_error(pcx.nodes[child(path, count - 1, pcx) as usize].start, c"'",
            pcx.nodes[child(path, count - 1, pcx) as usize].a, c"' is not a module", pcx);
    }
    binding_value(b)
}
