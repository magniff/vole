// std in sections (0.15): the loader lexes only the sections of std a
// program can reach. compiler/std/index.awk makes their index (std_index):
// for each section its bytes in std's text, whether it is core (always
// loaded), the words that ask for a lazy one (the items it defines, the
// methods of its impls of other sections' types), its items, its trait
// impls and the sections it needs. A lazy section is loaded when the program names one
// of its words, or a construct names it for the compiler (seeds), or one
// of its impls may apply (trait and type both known); with what it needs.
// The sections keep their places in std's text: positions and line
// numbers are std's.

use crate::base::{IntVec, buf_new, buf_slice, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::{Tok, lex_range};
use crate::front::modules::range_as_value;
use crate::front::stdalloc::CHECK_ALLOC_MODE;
use crate::front::stdsrc::{std_check_index, std_index};

const PROGRAM: i64 = 1;
const DEFINED: i64 = 2;

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

// The index, read once.
fn read_index(pcx: inout Ctx<Comp>) {
    unsafe {
        let b = buf_new();
        if CHECK_ALLOC_MODE {
            std_check_index(b);
        } else {
            std_index(b);
        }
        let t = buf_slice(b);
        var i = 0;
        pcx.sec_count = 0;
        while i < t.len as i64 {
            // START END CORE|WORDS|ITEMS|IMPLS|DEPS
            var nums = [0, 0, 0];
            for k in 0..3 {
                var v = 0;
                while i < t.len as i64 && is_digit(t[i]) {
                    v = v * 10 + (t[i] - '0') as i64;
                    i += 1;
                }
                nums[k] = v;
                i += 1;
            }
            pcx.sec_start.push(nums[0]);
            pcx.sec_end.push(nums[1]);
            pcx.sec_core.push(nums[2]);
            pcx.sec_loaded.push(0);
            pcx.sec_words.push(pcx.stdsections_words.count);
            pcx.sec_items.push(pcx.items.count);
            pcx.sec_impls.push(pcx.stdsections_impls.count);
            pcx.sec_deps.push(pcx.deps.count);
            pcx.sec_gate.push(-1);
            // four fields of words, up to the end of the line
            for field in 0..4 {
                loop {
                    while i < t.len as i64 && t[i] == ' ' {
                        i += 1;
                    }
                    if i >= t.len as i64 || t[i] == '|' || t[i] == '\n' {
                        break;
                    }
                    let w = i;
                    while i < t.len as i64 && t[i] != ' ' && t[i] != '|' && t[i] != '\n' {
                        i += 1;
                    }
                    let word = t[w..i];
                    if field == 0 && word.len > 1 && word[0] == '+' {
                        // (0.20) the gate: a word the program must name too
                        pcx.sec_gate.data[pcx.sec_count] = intern(word[1..word.len]);
                    } else if field == 0 {
                        pcx.stdsections_words.push(intern(word));
                    } else if field == 1 {
                        pcx.items.push(intern(word));
                        if word.len > 3 && word[word.len - 3..word.len] == "_in" {
                            pcx.in_of.put(intern(word[0..word.len - 3]) + 1, intern(word) + 1);
                        }
                    } else if field == 2 {
                        pcx.stdsections_impls.push(if word == "*" { -1 } else { intern(word) });
                    } else {
                        var v = 0;
                        for k in 0..word.len {
                            v = v * 10 + (word[k] - '0') as i64;
                        }
                        pcx.deps.push(v);
                    }
                }
                i += 1;
            }
            pcx.sec_count += 1;
        }
        pcx.sec_words.push(pcx.stdsections_words.count);
        pcx.sec_items.push(pcx.items.count);
        pcx.sec_impls.push(pcx.stdsections_impls.count);
        pcx.sec_deps.push(pcx.deps.count);
    }
}

fn know(sym: i64, how: i64, pcx: inout Ctx<Comp>) {
    let known = pcx.stdsections_known.get(sym + 1);
    pcx.stdsections_known.put(sym + 1, known | how);
}

// Whether sym is known as `how` (either: PROGRAM | DEFINED); -1 (any type)
// always.
fn known(sym: i64, how: i64, pcx: Ctx<Comp>) -> bool {
    sym < 0 || (pcx.stdsections_known.get(sym + 1) & how) != 0
}

fn know_c(name: [u8], pcx: inout Ctx<Comp>) {
    know(intern(name), PROGRAM, &pcx);
}

// Section s loaded, with what it needs; its items known.
fn mark(s: i64, now: inout IntVec, pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.sec_loaded.data[s] != 0 {
            return;
        }
        pcx.sec_loaded.data[s] = 1;
        now.push(s);
        for k in pcx.sec_items.data[s]..pcx.sec_items.data[s + 1] {
            know(pcx.items.data[k], DEFINED, &pcx);
        }
        for k in pcx.sec_deps.data[s]..pcx.sec_deps.data[s + 1] {
            mark(pcx.deps.data[k], &now, &pcx);
        }
    }
}

// Whether lazy section s is reached: the program names a word of it, or
// an impl of it may apply (its trait and type named or defined); (0.20)
// a section with a gate (SEC_GATE) asks for its words only when the
// program names the gate too.
fn reached(s: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        // (0.20) a gated module's section: only for a program naming its gate
        let gated = pcx.sec_gate.data[s] >= 0 && !known(pcx.sec_gate.data[s], PROGRAM, pcx);
        for k in pcx.sec_words.data[s]..(if gated { pcx.sec_words.data[s] }
            else { pcx.sec_words.data[s + 1] }) {
            if known(pcx.stdsections_words.data[k], PROGRAM, pcx) {
                return true;
            }
        }
        var k = pcx.sec_impls.data[s];
        while k + 1 < pcx.sec_impls.data[s + 1] {
            if known(pcx.stdsections_impls.data[k], PROGRAM | DEFINED, pcx)
                && known(pcx.stdsections_impls.data[k + 1], PROGRAM | DEFINED, pcx) {
                return true;
            }
            k += 2;
        }
        false
    }
}

// The names of the program's tokens (not std's), and the seeds: what a
// construct makes the compiler use of std.
fn know_program(pcx: inout Ctx<Comp>) {
    // (type arguments' brackets open: `Vec<i64>`, `fn f<T>`)
    var angles = 0;
    let detect = intern_c(c"detect");
    let multiversion = intern_c(c"multiversion");
    let format_sym = intern_c(c"format");
    // (0.20) what makes floats: their Display and Debug are lazy
    // (std::fmt's `impl Display for f64`)
    let v2f64 = intern_c(c"v2f64");
    let v4f32 = intern_c(c"v4f32");
    for i in 0..pcx.toks.len() as i64 {
        let at = pcx.toks[i].start;
        if at >= pcx.std_start && at < pcx.std_end {
            continue;
        }
        let k = pcx.toks[i].kind;
        if k == Tok::Ident {
            know(pcx.toks[i].value as i64, PROGRAM, &pcx);
            if pcx.toks[i].value as i64 == v2f64 || pcx.toks[i].value as i64 == v4f32 {
                know_c("f64", &pcx);
                know_c("f32", &pcx);
            }
            // (0.26.3) `format(..)`, gone: its error names format_in,
            // which it reaches
            if pcx.toks[i].value as i64 == format_sym {
                know_c("format_in", &pcx);
            }
            // (0.26.3) `m::get(..)` of a module m: std's `m::get_in`
            if i >= 2 && i + 1 < pcx.toks.len() as i64 && pcx.toks[i + 1].kind == Tok::LParen
                && pcx.toks[i - 1].kind == Tok::ColonColon && pcx.toks[i - 2].kind == Tok::Ident {
                let m = crate::base::sym_text(pcx.toks[i - 2].value as i64);
                let alt = if m.len > 0 && m[0] >= 'a' && m[0] <= 'z' {
                    pcx.in_of.get(pcx.toks[i].value as i64 + 1)
                } else {
                    0
                };
                if alt > 0 {
                    know(alt - 1, PROGRAM, &pcx);
                }
            }
            // (0.17) `panic(..)`, the prelude's: std's panic_str (not
            // `effects(panic)`, `std::panic(..)` nor `fn panic(..)`)
            if i + 1 < pcx.toks.len() as i64 && pcx.toks[i + 1].kind == Tok::LParen && i > 0
                && pcx.toks[i - 1].kind != Tok::ColonColon && pcx.toks[i - 1].kind != Tok::Fn
                && pcx.toks[i].value as i64 == intern_c(c"panic") {
                know_c("panic_str", &pcx);
            }
            // (0.19) std::arch::detect, #[multiversion]: the run-time
            // features of the target's system (std/arch.vl)
            if pcx.toks[i].value as i64 == detect && i + 1 < pcx.toks.len() as i64
                && pcx.toks[i + 1].kind == Tok::LParen
                || pcx.toks[i].value as i64 == multiversion && i >= 2
                && pcx.toks[i - 1].kind == Tok::LBracket && pcx.toks[i - 2].kind == Tok::Hash {
                know_c(if crate::base::target::X86 { "arch_init_x86" }
                    else if crate::base::target::ELF { "arch_init_linux" }
                    else { "arch_init_macos" }, &pcx);
            }
            // `#[derive(...)]`: the helpers the derived impls call
            if i >= 2 && pcx.toks[i - 1].kind == Tok::LBracket
                && pcx.toks[i - 2].kind == Tok::Hash {
                know_c("Clone", &pcx);
                know_c("clone_of", &pcx);
                know_c("cmp_of", &pcx);
                know_c("hash_of", &pcx);
                know_c("eq_of", &pcx);
                know_c("hash_mix", &pcx);
            }
        } else if k == Tok::Int && pcx.toks[i].suffix == crate::front::lexer::SUF_USIZE {
            // (0.26.2) `3usize`: usize's impls (the section usize and isize)
            know_c("usize", &pcx);
        } else if k == Tok::Int && pcx.toks[i].suffix == crate::front::lexer::SUF_ISIZE {
            know_c("isize", &pcx);
        } else if k == Tok::Float || k == Tok::Import {
            // (0.20) a float literal or a C header: floats
            know_c("f64", &pcx);
            know_c("f32", &pcx);
        } else if k == Tok::Question {
            know_c("From", &pcx);
        } else if k == Tok::EqEq || k == Tok::BangEq {
            know_c("Eq", &pcx);
        } else if k == Tok::Lt && i > 0 && type_arguments(i, pcx) {
            angles += 1;
        } else if k == Tok::Gt && angles > 0 {
            angles -= 1;
        } else if k == Tok::Lt || k == Tok::Gt || k == Tok::LtEq || k == Tok::GtEq {
            // (a comparison)
            know_c("Ord", &pcx);
        } else if k == Tok::For && iterates(i, pcx) {
            know_c("Iterator", &pcx);
            know_c("IntoIterator", &pcx);
        } else if (k == Tok::DotDot || k == Tok::DotDotEq) && range_as_value(i, pcx) {
            know_c("Range", &pcx);
            know_c("RangeInclusive", &pcx);
            know_c("Iterator", &pcx);
        }
        else if k == Tok::Fn && i + 1 < pcx.toks.len() as i64 && pcx.toks[i + 1].kind == Tok::Ident
            && pcx.toks[i + 1].value as i64 == intern_c(c"main") {
            // `fn main() -> Result<(), E>`: std::main_error
            var j = i + 2;
            while j < pcx.toks.len() as i64 && pcx.toks[j].kind != Tok::LBrace
                && pcx.toks[j].kind != Tok::Semi {
                if pcx.toks[j].kind == Tok::Ident
                    && pcx.toks[j].value as i64 == intern_c(c"Result") {
                    know_c("main_error", &pcx);
                }
                j += 1;
            }
        }
    }
}

// (0.25.2.1) std::math's Float methods (`x.sqrt()`) name no item of it: a
// program naming one reads std (load_std_if_named), std::math (its gate,
// `math`) and the trait. The first FLOAT_ONLY names are float math only;
// the rest (abs, min, max, the rounding) are common elsewhere
// (`v.iter().max()`): those only in a program with floats.
pub fn float_method_names() -> [i64; 39] {
    [
        intern("sqrt"), intern("cbrt"), intern("hypot"), intern("sin"), intern("cos"),
        intern("tan"), intern("sin_cos"), intern("asin"), intern("acos"), intern("atan"),
        intern("atan2"), intern("exp"), intern("exp2"), intern("ln"), intern("log2"),
        intern("log10"), intern("powf"), intern("powi"), intern("to_radians"),
        intern("to_degrees"), intern("is_nan"), intern("is_finite"), intern("is_infinite"),
        intern("is_sign_positive"), intern("is_sign_negative"), intern("copysign"),
        intern("recip"), intern("round_ties_even"), intern("fract"), intern("abs"),
        intern("signum"), intern("min"), intern("max"), intern("clamp"), intern("floor"),
        intern("ceil"), intern("round"), intern("trunc"), intern("log"),
    ]
}

// How many of float_method_names are float math only.
pub const FLOAT_ONLY: i64 = 29;

// Whether sym names a Float method: 1 float math only, 2 a name common
// elsewhere too, 0 neither.
pub fn float_method_kind(names: [i64; 39], sym: i64) -> i64 {
    for k in 0..39 {
        if names[k] == sym {
            return if k < FLOAT_ONLY { 1 } else { 2 };
        }
    }
    0
}

// (0.25.2.2) std::num's Int methods (`n.abs()`): a program calling one
// reads std, as for a float-only name; the section comes by its words
// (index.awk's TRIGGERS). (0.26.4) Also `n.wrapping_mul(m)` and the
// checked_, overflowing_ and saturating_ families: a program that names
// nothing else of std had no such method.
pub fn int_method_name(sym: i64) -> bool {
    if sym == intern("abs") || sym == intern("signum") || sym == intern("min")
        || sym == intern("max") || sym == intern("clamp") || sym == intern("pow") {
        return true;
    }
    let t = sym_text(sym);
    t.starts_with("wrapping_") || t.starts_with("checked_") || t.starts_with("overflowing_")
        || t.starts_with("saturating_")
}

fn know_float_math(pcx: inout Ctx<Comp>) {
    let names = float_method_names();
    var reach = false;
    for k in 0..FLOAT_ONLY {
        reach = reach || known(names[k], PROGRAM, pcx);
    }
    if !reach && (known(intern("f64"), PROGRAM, pcx) || known(intern("f32"), PROGRAM, pcx)) {
        for k in FLOAT_ONLY..39 {
            reach = reach || known(names[k], PROGRAM, pcx);
        }
    }
    if reach {
        know_c("math", &pcx);
        know_c("Float", &pcx);
    }
}

// Whether the `<` at token i opens type arguments or parameters, not a
// comparison: after `::`, `impl`, a capitalized name (a type), or the name
// an item declares (`fn f<T>`).
fn type_arguments(i: i64, pcx: Ctx<Comp>) -> bool {
    let p = pcx.toks[i - 1].kind;
    if p == Tok::ColonColon || p == Tok::Impl {
        return true;
    }
    if p != Tok::Ident {
        return false;
    }
    let c = pcx.toks[i - 1].start;
    if crate::base::SRC[c] >= 'A' && crate::base::SRC[c] <= 'Z' {
        return true;
    }
    if i < 2 {
        return false;
    }
    let d = pcx.toks[i - 2].kind;
    d == Tok::Fn || d == Tok::Struct || d == Tok::Enum || d == Tok::Trait || d == Tok::Type
}

// Whether the `for` at token i iterates something other than a range
// written in it (`for x in v`, not `for i in 0..n`).
fn iterates(i: i64, pcx: Ctx<Comp>) -> bool {
    var j = i + 1;
    while j < pcx.toks.len() as i64 && pcx.toks[j].kind != Tok::In
        && pcx.toks[j].kind != Tok::LBrace {
        j += 1;
    }
    var depth = 0;
    j += 1;
    while j < pcx.toks.len() as i64 {
        let k = pcx.toks[j].kind;
        if k == Tok::LParen || k == Tok::LBracket {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket {
            depth -= 1;
        } else if k == Tok::LBrace && depth == 0 {
            return true;
        } else if (k == Tok::DotDot || k == Tok::DotDotEq) && depth == 0 {
            return false;
        }
        j += 1;
    }
    true
}

// Lexes the sections of std (its text at start..end in SRC) the program
// reaches, those not lexed yet (every one when `all`): at the first call,
// for the files read so far; again once the modules' files are read.
pub fn load_std_sections(start: i64, end: i64, all: bool, pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.sec_count < 0 {
            read_index(&pcx);
        }
        pcx.std_start = start;
        pcx.std_end = end;
        var now = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for s in 0..pcx.sec_count {
            if pcx.sec_core.data[s] != 0 || all {
                mark(s, &now, &pcx);
            }
        }
        know_program(&pcx);
        know_float_math(&pcx);
        var changed = true;
        while changed {
            changed = false;
            for s in 0..pcx.sec_count {
                if pcx.sec_loaded.data[s] == 0 && reached(s, pcx) {
                    mark(s, &now, &pcx);
                    changed = true;
                }
            }
        }
        // (in the text's order)
        for s in 0..pcx.sec_count {
            if (0..now.count).any(|k| now.data[k] == s) {
                lex_range(start + pcx.sec_start.data[s], start + pcx.sec_end.data[s], last: false,
                    pcx: &pcx);
            }
        }
    }
}
