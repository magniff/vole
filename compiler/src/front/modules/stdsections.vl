// std in sections (0.15): the loader lexes only the sections of std a
// program can reach. compiler/std/index.awk makes their index (std_index):
// for each section its bytes in std's text, whether it is core (always
// loaded), the words that ask for a lazy one (the items it defines, the
// methods of its impls of other sections' types), its items, its trait
// impls and the sections it needs. A lazy section is loaded when the program names one
// of its words, or a construct names it for the compiler (seeds), or one
// of its impls may apply (trait and type both known); with what it needs.
// The sections keep their places in std's text: positions and line
// numbers are std's.

use crate::base::{IntVec, buf_new, buf_slice, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::{Tok, lex_range};
use crate::front::modules::range_as_value;
use crate::front::stdalloc::get_check_alloc_mode;
use crate::front::stdsrc::{std_check_index, std_index};

const PROGRAM: i64 = 1;
const DEFINED: i64 = 2;

fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

// The index, read once.
fn read_index(pcx: &mut Ctx<Comp>) {
    unsafe {
        let b = buf_new();
        if get_check_alloc_mode() {
            std_check_index(b);
        } else {
            std_index(b);
        }
        let t = buf_slice(b);
        let mut i: i64 = 0;
        pcx.sec_count = 0;
        while i < t.len() as i64 {
            // START END CORE|WORDS|ITEMS|IMPLS|DEPS
            let mut nums = [0i64, 0, 0];
            for k in 0..3 {
                let mut v: i64 = 0;
                while i < t.len() as i64 && is_digit(t[i as usize]) {
                    v = v * 10 + (t[i as usize] - b'0') as i64;
                    i += 1;
                }
                nums[k as usize] = v;
                i += 1;
            }
            pcx.sec_start.push(nums[0]);
            pcx.sec_end.push(nums[1]);
            pcx.sec_core.push(nums[2]);
            pcx.sec_loaded.push(0);
            pcx.sec_words.push(pcx.stdsections_words.count);
            pcx.sec_items.push(pcx.items.count);
            pcx.sec_impls.push(pcx.stdsections_impls.count);
            pcx.sec_deps.push(pcx.deps.count);
            pcx.sec_gate.push(-1);
            // four fields of words, up to the end of the line
            for field in 0..4 {
                loop {
                    while i < t.len() as i64 && t[i as usize] == b' ' {
                        i += 1;
                    }
                    if i >= t.len() as i64 || t[i as usize] == b'|' || t[i as usize] == b'\n' {
                        break;
                    }
                    let w = i;
                    while i < t.len() as i64 && t[i as usize] != b' ' && t[i as usize] != b'|' && t[i as usize] != b'\n' {
                        i += 1;
                    }
                    let word = &t[w as usize..i as usize];
                    if field == 0 && word.len() > 1 && word[0] == b'+' {
                        // (0.20) the gate: a word the program must name too
                        (*pcx.sec_gate.data.add(pcx.sec_count as usize)) = intern(&word[1..word.len()], pcx);
                    } else if field == 0 {
                        let sym = intern(word, pcx);
                        pcx.stdsections_words.push(sym);
                    } else if field == 1 {
                        let sym = intern(word, pcx);
                        pcx.items.push(sym);
                        if word.len() > 3 && word[word.len() - 3..word.len()] == b"_in" {
                            let plain = intern(&word[0..word.len() - 3], pcx);
                            pcx.in_of.put(plain + 1, sym + 1);
                        }
                    } else if field == 2 {
                        let sym: i64 = if word == b"*" { -1 } else { intern(word, pcx) };
                        pcx.stdsections_impls.push(sym);
                    } else {
                        let mut v: i64 = 0;
                        for k in 0..word.len() {
                            v = v * 10 + (word[k] - b'0') as i64;
                        }
                        pcx.deps.push(v);
                    }
                }
                i += 1;
            }
            pcx.sec_count += 1;
        }
        pcx.sec_words.push(pcx.stdsections_words.count);
        pcx.sec_items.push(pcx.items.count);
        pcx.sec_impls.push(pcx.stdsections_impls.count);
        pcx.sec_deps.push(pcx.deps.count);
    }
}

fn know(sym: i64, how: i64, pcx: &mut Ctx<Comp>) {
    let known = pcx.stdsections_known.get(sym + 1);
    pcx.stdsections_known.put(sym + 1, known | how);
}

// Whether sym is known as `how` (either: PROGRAM | DEFINED); -1 (any type)
// always.
fn known(sym: i64, how: i64, pcx: &Ctx<Comp>) -> bool {
    sym < 0 || (pcx.stdsections_known.get(sym + 1) & how) != 0
}

fn know_c(name: &[u8], pcx: &mut Ctx<Comp>) {
    know(intern(name, pcx), PROGRAM, pcx);
}

// Section s loaded, with what it needs; its items known.
fn mark(s: i64, now: &mut IntVec, pcx: &mut Ctx<Comp>) {
    unsafe {
        if (*pcx.sec_loaded.data.add(s as usize)) != 0 {
            return;
        }
        (*pcx.sec_loaded.data.add(s as usize)) = 1;
        now.push(s);
        for k in (*pcx.sec_items.data.add(s as usize))..(*pcx.sec_items.data.add((s + 1) as usize)) {
            know((*pcx.items.data.add(k as usize)), DEFINED, pcx);
        }
        for k in (*pcx.sec_deps.data.add(s as usize))..(*pcx.sec_deps.data.add((s + 1) as usize)) {
            mark((*pcx.deps.data.add(k as usize)), now, pcx);
        }
    }
}

// Whether lazy section s is reached: the program names a word of it, or
// an impl of it may apply (its trait and type named or defined); (0.20)
// a section with a gate (SEC_GATE) asks for its words only when the
// program names the gate too.
fn reached(s: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // (0.20) a gated module's section: only for a program naming its gate
        let gated = (*pcx.sec_gate.data.add(s as usize)) >= 0 && !known((*pcx.sec_gate.data.add(s as usize)), PROGRAM, pcx);
        for k in (*pcx.sec_words.data.add(s as usize))..(if gated { (*pcx.sec_words.data.add(s as usize)) }
            else { (*pcx.sec_words.data.add((s + 1) as usize)) }) {
            if known((*pcx.stdsections_words.data.add(k as usize)), PROGRAM, pcx) {
                return true;
            }
        }
        let mut k = (*pcx.sec_impls.data.add(s as usize));
        while k + 1 < (*pcx.sec_impls.data.add((s + 1) as usize)) {
            if known((*pcx.stdsections_impls.data.add(k as usize)), PROGRAM | DEFINED, pcx)
                && known((*pcx.stdsections_impls.data.add((k + 1) as usize)), PROGRAM | DEFINED, pcx) {
                return true;
            }
            k += 2;
        }
        false
    }
}

// The names of the program's tokens (not std's), and the seeds: what a
// construct makes the compiler use of std.
fn know_program(pcx: &mut Ctx<Comp>) {
    // (type arguments' brackets open: `Vec<i64>`, `fn f<T>`)
    let mut angles: i64 = 0;
    let detect = intern_c(c"detect", pcx);
    let multiversion = intern_c(c"multiversion", pcx);
    let format_sym = intern_c(c"format", pcx);
    // (0.20) what makes floats: their Display and Debug are lazy
    // (std::fmt's `impl Display for f64`)
    let v2f64 = intern_c(c"v2f64", pcx);
    let v4f32 = intern_c(c"v4f32", pcx);
    for i in 0..pcx.toks.len() as i64 {
        let at = pcx.toks[i as usize].start;
        if at >= pcx.std_start && at < pcx.std_end {
            continue;
        }
        let k = pcx.toks[i as usize].kind;
        if k == Tok::Ident {
            know(pcx.toks[i as usize].value as i64, PROGRAM, pcx);
            if pcx.toks[i as usize].value as i64 == v2f64 || pcx.toks[i as usize].value as i64 == v4f32 {
                know_c(b"f64", pcx);
                know_c(b"f32", pcx);
            }
            // (0.26.3) `format(..)`, gone: its error names format_in,
            // which it reaches
            if pcx.toks[i as usize].value as i64 == format_sym {
                know_c(b"format_in", pcx);
            }
            // (0.26.3) `m::get(..)` of a module m: std's `m::get_in`
            if i >= 2 && i + 1 < pcx.toks.len() as i64 && pcx.toks[(i + 1) as usize].kind == Tok::LParen
                && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon && pcx.toks[(i - 2) as usize].kind == Tok::Ident {
                let m = crate::base::sym_text(pcx.toks[(i - 2) as usize].value as i64, pcx);
                let alt: i64 = if m.len() > 0 && m[0] >= b'a' && m[0] <= b'z' {
                    pcx.in_of.get(pcx.toks[i as usize].value as i64 + 1)
                } else {
                    0
                };
                if alt > 0 {
                    know(alt - 1, PROGRAM, pcx);
                }
            }
            // (0.17) `panic(..)`, the prelude's: std's panic_str (not
            // `effects(panic)`, `std::panic(..)` nor `fn panic(..)`)
            if i + 1 < pcx.toks.len() as i64 && pcx.toks[(i + 1) as usize].kind == Tok::LParen && i > 0
                && pcx.toks[(i - 1) as usize].kind != Tok::ColonColon && pcx.toks[(i - 1) as usize].kind != Tok::Fn
                && pcx.toks[i as usize].value as i64 == intern_c(c"panic", pcx) {
                know_c(b"panic_str", pcx);
            }
            // (0.19) std::arch::detect, #[multiversion]: the run-time
            // features of the target's system (std/arch.vl)
            if pcx.toks[i as usize].value as i64 == detect && i + 1 < pcx.toks.len() as i64
                && pcx.toks[(i + 1) as usize].kind == Tok::LParen
                || pcx.toks[i as usize].value as i64 == multiversion && i >= 2
                && pcx.toks[(i - 1) as usize].kind == Tok::LBracket && pcx.toks[(i - 2) as usize].kind == Tok::Hash {
                know_c(if crate::base::target::get_x86() { b"arch_init_x86" }
                    else if crate::base::target::get_elf() { b"arch_init_linux" }
                    else { b"arch_init_macos" }, pcx);
            }
            // `#[derive(...)]`: the helpers the derived impls call
            if i >= 2 && pcx.toks[(i - 1) as usize].kind == Tok::LBracket
                && pcx.toks[(i - 2) as usize].kind == Tok::Hash {
                know_c(b"Clone", pcx);
                know_c(b"clone_of", pcx);
                know_c(b"cmp_of", pcx);
                know_c(b"hash_of", pcx);
                know_c(b"eq_of", pcx);
                know_c(b"hash_mix", pcx);
            }
        } else if k == Tok::Int && pcx.toks[i as usize].suffix == crate::front::lexer::SUF_USIZE {
            // (0.26.2) `3usize`: usize's impls (the section usize and isize)
            know_c(b"usize", pcx);
        } else if k == Tok::Int && pcx.toks[i as usize].suffix == crate::front::lexer::SUF_ISIZE {
            know_c(b"isize", pcx);
        } else if k == Tok::Float || k == Tok::Import {
            // (0.20) a float literal or a C header: floats
            know_c(b"f64", pcx);
            know_c(b"f32", pcx);
        } else if k == Tok::Question {
            know_c(b"From", pcx);
        } else if k == Tok::EqEq || k == Tok::BangEq {
            know_c(b"Eq", pcx);
        } else if k == Tok::Lt && i > 0 && type_arguments(i, pcx) {
            angles += 1;
        } else if k == Tok::Gt && angles > 0 {
            angles -= 1;
        } else if k == Tok::Lt || k == Tok::Gt || k == Tok::LtEq || k == Tok::GtEq {
            // (a comparison)
            know_c(b"Ord", pcx);
        } else if k == Tok::For && iterates(i, pcx) {
            know_c(b"Iterator", pcx);
            know_c(b"IntoIterator", pcx);
        } else if (k == Tok::DotDot || k == Tok::DotDotEq) && range_as_value(i, pcx) {
            know_c(b"Range", pcx);
            know_c(b"RangeInclusive", pcx);
            know_c(b"Iterator", pcx);
        }
        else if k == Tok::Fn && i + 1 < pcx.toks.len() as i64 && pcx.toks[(i + 1) as usize].kind == Tok::Ident
            && pcx.toks[(i + 1) as usize].value as i64 == intern_c(c"main", pcx) {
            // `fn main() -> Result<(), E>`: std::main_error
            let mut j = i + 2;
            while j < pcx.toks.len() as i64 && pcx.toks[j as usize].kind != Tok::LBrace
                && pcx.toks[j as usize].kind != Tok::Semi {
                if pcx.toks[j as usize].kind == Tok::Ident
                    && pcx.toks[j as usize].value as i64 == intern_c(c"Result", pcx) {
                    know_c(b"main_error", pcx);
                }
                j += 1;
            }
        }
    }
}

// (0.25.2.1) std::math's Float methods (`x.sqrt()`) name no item of it: a
// program naming one reads std (load_std_if_named), std::math (its gate,
// `math`) and the trait. The first FLOAT_ONLY names are float math only;
// the rest (abs, min, max, the rounding) are common elsewhere
// (`v.iter().max()`): those only in a program with floats.
pub fn float_method_names(pcx: &mut Ctx<Comp>) -> [i64; 39] {
    [
        intern(b"sqrt", pcx), intern(b"cbrt", pcx), intern(b"hypot", pcx), intern(b"sin", pcx),
        intern(b"cos", pcx), intern(b"tan", pcx), intern(b"sin_cos", pcx), intern(b"asin", pcx),
        intern(b"acos", pcx), intern(b"atan", pcx), intern(b"atan2", pcx), intern(b"exp", pcx),
        intern(b"exp2", pcx), intern(b"ln", pcx), intern(b"log2", pcx), intern(b"log10", pcx),
        intern(b"powf", pcx), intern(b"powi", pcx), intern(b"to_radians", pcx),
        intern(b"to_degrees", pcx), intern(b"is_nan", pcx), intern(b"is_finite", pcx),
        intern(b"is_infinite", pcx), intern(b"is_sign_positive", pcx),
        intern(b"is_sign_negative", pcx), intern(b"copysign", pcx), intern(b"recip", pcx),
        intern(b"round_ties_even", pcx), intern(b"fract", pcx), intern(b"abs", pcx),
        intern(b"signum", pcx), intern(b"min", pcx), intern(b"max", pcx), intern(b"clamp", pcx),
        intern(b"floor", pcx), intern(b"ceil", pcx), intern(b"round", pcx), intern(b"trunc", pcx),
        intern(b"log", pcx)]
}

// How many of float_method_names are float math only.
pub const FLOAT_ONLY: i64 = 29;

// Whether sym names a Float method: 1 float math only, 2 a name common
// elsewhere too, 0 neither.
pub fn float_method_kind(names: [i64; 39], sym: i64) -> i64 {
    for k in 0..39 {
        if names[k as usize] == sym {
            return if k < FLOAT_ONLY { 1 } else { 2 };
        }
    }
    0
}

// (0.25.2.2) std::num's Int methods (`n.abs()`): a program calling one
// reads std, as for a float-only name; the section comes by its words
// (index.awk's TRIGGERS). (0.26.4) Also `n.wrapping_mul(m)` and the
// checked_, overflowing_ and saturating_ families: a program that names
// nothing else of std had no such method.
pub fn int_method_name(sym: i64, pcx: &mut Ctx<Comp>) -> bool {
    if sym == intern(b"abs", pcx) || sym == intern(b"signum", pcx) || sym == intern(b"min", pcx)
        || sym == intern(b"max", pcx) || sym == intern(b"clamp", pcx)
        || sym == intern(b"pow", pcx) {
        return true;
    }
    let t = sym_text(sym, pcx);
    t.starts_with(b"wrapping_") || t.starts_with(b"checked_") || t.starts_with(b"overflowing_")
        || t.starts_with(b"saturating_")
}

fn know_float_math(pcx: &mut Ctx<Comp>) {
    let names = float_method_names(pcx);
    let mut reach = false;
    for k in 0..FLOAT_ONLY {
        reach = reach || known(names[k as usize], PROGRAM, pcx);
    }
    if !reach
        && (known(intern(b"f64", pcx), PROGRAM, pcx) || known(intern(b"f32", pcx), PROGRAM, pcx)) {
        for k in FLOAT_ONLY..39 {
            reach = reach || known(names[k as usize], PROGRAM, pcx);
        }
    }
    if reach {
        know_c(b"math", pcx);
        know_c(b"Float", pcx);
    }
}

// Whether the `<` at token i opens type arguments or parameters, not a
// comparison: after `::`, `impl`, a capitalized name (a type), or the name
// an item declares (`fn f<T>`).
fn type_arguments(i: i64, pcx: &Ctx<Comp>) -> bool {
    let p = pcx.toks[(i - 1) as usize].kind;
    if p == Tok::ColonColon || p == Tok::Impl {
        return true;
    }
    if p != Tok::Ident {
        return false;
    }
    let c = pcx.toks[(i - 1) as usize].start;
    if crate::base::get_src()[c as usize] >= b'A' && crate::base::get_src()[c as usize] <= b'Z' {
        return true;
    }
    if i < 2 {
        return false;
    }
    let d = pcx.toks[(i - 2) as usize].kind;
    d == Tok::Fn || d == Tok::Struct || d == Tok::Enum || d == Tok::Trait || d == Tok::Type
}

// Whether the `for` at token i iterates something other than a range
// written in it (`for x in v`, not `for i in 0..n`).
fn iterates(i: i64, pcx: &Ctx<Comp>) -> bool {
    let mut j = i + 1;
    while j < pcx.toks.len() as i64 && pcx.toks[j as usize].kind != Tok::In
        && pcx.toks[j as usize].kind != Tok::LBrace {
        j += 1;
    }
    let mut depth: i64 = 0;
    j += 1;
    while j < pcx.toks.len() as i64 {
        let k = pcx.toks[j as usize].kind;
        if k == Tok::LParen || k == Tok::LBracket {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket {
            depth -= 1;
        } else if k == Tok::LBrace && depth == 0 {
            return true;
        } else if (k == Tok::DotDot || k == Tok::DotDotEq) && depth == 0 {
            return false;
        }
        j += 1;
    }
    true
}

// Lexes the sections of std (its text at start..end in SRC) the program
// reaches, those not lexed yet (every one when `all`): at the first call,
// for the files read so far; again once the modules' files are read.
pub fn load_std_sections(start: i64, end: i64, all: bool, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.sec_count < 0 {
            read_index(pcx);
        }
        pcx.std_start = start;
        pcx.std_end = end;
        let mut now = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for s in 0..pcx.sec_count {
            if (*pcx.sec_core.data.add(s as usize)) != 0 || all {
                mark(s, &mut now, pcx);
            }
        }
        know_program(pcx);
        know_float_math(pcx);
        let mut changed = true;
        while changed {
            changed = false;
            for s in 0..pcx.sec_count {
                if (*pcx.sec_loaded.data.add(s as usize)) == 0 && reached(s, pcx) {
                    mark(s, &mut now, pcx);
                    changed = true;
                }
            }
        }
        // (in the text's order)
        for s in 0..pcx.sec_count {
            if (0i64..now.count).any(|k| (*now.data.add(k as usize)) == s) {
                lex_range(start + (*pcx.sec_start.data.add(s as usize)), start + (*pcx.sec_end.data.add(s as usize)), last: false,
                    pcx: pcx);
            }
        }
    }
}
