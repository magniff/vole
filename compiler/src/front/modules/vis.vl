// Restricted visibility (0.26.2), Rust's `pub(crate)`, `pub(super)`,
// `pub(self)` and `pub(in path)`, on items, fields, `use` re-exports and
// modules. ITEM_PUBLIC (a module's `public`) keeps meaning "visible
// outside its module"; a restricted one also has the token of its `pub`
// here (VIS: node + 1 -> token + 1; MOD_VIS: module + 1 -> token + 1),
// and vis_end says the module where its visibility ends: its crate's
// root for `crate` (a program's crate is its root module, std's is std),
// its module's parent for `super`, the path's module for `in`, which must
// be its module or one around it (vis.path). `pub(self)` is private.

use crate::base::{buf_fmt, buf_new, buf_slice, get_src, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fmt, err_help};
use crate::front::lexer::{Tok, Token};
use crate::front::modules::{child_module, is_within, module_of, within_std};

fn tok(i: i64, pcx: &Ctx<Comp>) -> Token {
    // UNSAFE: TOKS is the lexer's token array, a raw pointer (front/lexer).
    // SAFETY: the callers ask for tokens of a `pub (..)` the parser or the
    // module scan read, below TOK_COUNT (checked where it could run past).
    unsafe { pcx.toks[i as usize] }
}

fn parent_of(m: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: MODULES is the table of modules, a raw pointer (front/modules).
    // SAFETY: m >= 0 is a module's index, below module_count().
    unsafe { pcx.modules[m as usize].parent }
}

fn tok_word(i: i64, word: &[u8], pcx: &Ctx<Comp>) -> bool {
    i < pcx.toks.len() as i64 && tok(i, pcx).kind == Tok::Ident
        && sym_text(tok(i, pcx).value as i64, pcx) == word
}

// Whether token p, a `pub`, is followed by a restriction: `(crate)`,
// `(super)`, `(self)`, `(in path)`.
pub fn restricted_at(p: i64, pcx: &Ctx<Comp>) -> bool {
    p + 2 < pcx.toks.len() as i64 && tok(p + 1, pcx).kind == Tok::LParen
        && (tok_word(p + 2, b"crate", pcx) || tok_word(p + 2, b"super", pcx)
            || tok_word(p + 2, b"self", pcx) || tok(p + 2, pcx).kind == Tok::In)
}

// Whether the restriction at `pub` token p is `pub(self)`: private.
pub fn self_only(p: i64, pcx: &Ctx<Comp>) -> bool {
    tok_word(p + 2, b"self", pcx)
}

// The token after the restriction's `)`.
pub fn restriction_end(p: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = p + 2;
    while i < pcx.toks.len() as i64 && tok(i, pcx).kind != Tok::RParen
        && tok(i, pcx).kind != Tok::Eof {
        i += 1;
    }
    if i < pcx.toks.len() as i64 && tok(i, pcx).kind == Tok::RParen { i + 1 } else { i }
}

// The parser read restricted `pub` p on node n (an item, a field, a use).
pub fn note_vis(n: i64, p: i64, pcx: &mut Ctx<Comp>) {
    if pcx.vis.get(n + 1) == 0 {
        pcx.vis_nodes.push(n);
    }
    pcx.vis.put(n + 1, p + 1);
}

// The module scan at a `mod` at token i: whether the module is public
// (`pub mod`, `pub(crate) mod`; `pub(self) mod` is not).
pub fn module_public(i: i64, pcx: &Ctx<Comp>) -> bool {
    if i < 1 {
        return false;
    }
    if tok(i - 1, pcx).kind == Tok::Pub {
        return true;
    }
    let p = restriction_before(i, pcx);
    p >= 0 && !self_only(p, pcx)
}

// The `pub` token of a restriction just before token i (`pub(crate)
// mod`), -1 for none.
fn restriction_before(i: i64, pcx: &Ctx<Comp>) -> i64 {
    if i < 1 || tok(i - 1, pcx).kind != Tok::RParen {
        return -1;
    }
    let mut j = i - 1;
    while j > 0 && tok(j, pcx).kind != Tok::LParen {
        j -= 1;
    }
    if j < 1 || tok(j - 1, pcx).kind != Tok::Pub || !restricted_at(j - 1, pcx) { -1 } else { j - 1 }
}

// After it made module m for the `mod` at token i: its restriction, if
// any, noted.
pub fn note_module_vis(m: i64, i: i64, pcx: &mut Ctx<Comp>) {
    let p = restriction_before(i, pcx);
    if p >= 0 && !self_only(p, pcx) {
        pcx.mod_vis.put(m + 1, p + 1);
        pcx.vis_mods.push(m);
    }
}

// The crate of module m: std for std's modules, else the program's root.
fn crate_root(m: i64, pcx: &Ctx<Comp>) -> i64 {
    if within_std(m, pcx) { pcx.std_module } else { 0 }
}

// The module where the visibility of restricted `pub` p, in module m,
// ends (-1: p is not restricted). A bad `in` path ends it at the crate.
fn vis_end(p: i64, m: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let known = pcx.vis_end.get(p + 1);
    if known != 0 {
        return known - 2;
    }
    let end = resolve(p, m, false, pcx);
    pcx.vis_end.put(p + 1, end + 2);
    end
}

// What restricted `pub` p in module m names (report: vis.path errors).
fn resolve(p: i64, m: i64, report: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let root = crate_root(m, pcx);
    if tok_word(p + 2, b"crate", pcx) {
        return root;
    }
    if tok_word(p + 2, b"super", pcx) {
        if m == root || parent_of(m, pcx) < 0 {
            if report {
                path_error(p, b"'super' of a crate's root is outside the crate", pcx);
            }
            return root;
        }
        return parent_of(m, pcx);
    }
    // `in path`
    let mut i = p + 3;
    let mut cur: i64 = -1;
    let mut first = true;
    while i < pcx.toks.len() as i64 && tok(i, pcx).kind == Tok::Ident {
        let name = tok(i, pcx).value as i64;
        if first && name == intern_c(c"crate", pcx) {
            cur = root;
        } else if first && name == intern_c(c"self", pcx) {
            cur = m;
        } else if first && name == intern_c(c"std", pcx) && pcx.std_module >= 0 {
            cur = pcx.std_module;
        } else if name == intern_c(c"super", pcx) && (first || cur >= 0) {
            let from = if first { m } else { cur };
            cur = if from >= 0 && from != root { parent_of(from, pcx) } else { -1 };
        } else if first {
            cur = child_module(m, name, pcx);
        } else if cur >= 0 {
            cur = child_module(cur, name, pcx);
        }
        first = false;
        i += 1;
        if i < pcx.toks.len() as i64 && tok(i, pcx).kind == Tok::ColonColon {
            i += 1;
        } else {
            break;
        }
    }
    if cur < 0 || !is_within(m, cur, pcx) {
        if report {
            path_error(p, if cur < 0 { b"the path names no module" }
                else { b"the path names a module that is not around this item" }, pcx);
        }
        return root;
    }
    cur
}

// error vis.path (E0742): `pub(in path)` names no ancestor of the item's
// module.
fn path_error(p: i64, why: &[u8], pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"vis.path";
    let end = tok(restriction_end(p, pcx) - 1, pcx).end;
    err_begin(tok(p, pcx).start, pcx);
    err_fmt({
        let why = str::from_utf8(why).unwrap();
        format_args("'{}': {why}",
            &str::from_utf8(get_src()[tok(p, pcx).start as usize..end as usize]).unwrap())
    }, pcx);
    err_help(c"'pub(in path)' names the item's module or one around it: 'pub(in crate::a)', 'pub(super)', 'pub(crate)'", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// The module where node n's visibility ends, -1 when it is not
// restricted (plain `pub`, or private: ITEM_PUBLIC says which).
pub fn vis_end_of(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.vis.count == 0 {
        return -1;
    }
    let p = pcx.vis.get(n + 1);
    if p == 0 { -1 } else { vis_end(p - 1, module_of(n, pcx), pcx) }
}

// The same for module c (declared in its parent).
pub fn module_vis_end(c: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.mod_vis.count == 0 {
        return -1;
    }
    let p = pcx.mod_vis.get(c + 1);
    if p == 0 { -1 } else { vis_end(p - 1, parent_of(c, pcx), pcx) }
}

// Whether public node n is visible from code in module `from`.
pub fn admits(n: i64, from: i64, pcx: &mut Ctx<Comp>) -> bool {
    let end = vis_end_of(n, pcx);
    end < 0 || is_within(from, end, pcx)
}

// Whether public module c is visible from code in module `from`.
pub fn module_admits(c: i64, from: i64, pcx: &mut Ctx<Comp>) -> bool {
    let end = module_vis_end(c, pcx);
    end < 0 || is_within(from, end, pcx)
}

// The restricted `pub` token of node n, -1 for none.
pub fn vis_token(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.vis.count == 0 {
        return -1;
    }
    pcx.vis.get(n + 1) - 1
}

// The text of node n's `pub (..)` (`pub(crate)`), empty for none.
pub fn vis_text(n: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let p = vis_token(n, pcx);
    if p < 0 {
        return b"";
    }
    &get_src()[tok(p, pcx).start as usize..tok(restriction_end(p, pcx) - 1, pcx).end as usize]
}

// Whether module m is a crate's root (the program's, or std).
pub fn is_crate_root(m: i64, pcx: &Ctx<Comp>) -> bool {
    m == 0 || m == pcx.std_module
}

// After the modules are loaded and the program parsed: each `pub(in
// path)` and `pub(super)` names a module around its item (vis.path).
pub fn check_vis_paths(pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.vis_nodes.count {
        let n = pcx.vis_nodes.get(i);
        let p = pcx.vis.get(n + 1) - 1;
        if !tok_word(p + 2, b"crate", pcx) {
            let pcx_arg = p + 1;
            let pcx_arg1 = resolve(p, module_of(n, pcx), true, pcx) + 2;
            pcx.vis_end.put(pcx_arg, pcx_arg1);
        }
    }
    for i in 0..pcx.vis_mods.count {
        let c = pcx.vis_mods.get(i);
        let p = pcx.mod_vis.get(c + 1) - 1;
        if !tok_word(p + 2, b"crate", pcx) {
            let pcx_arg = p + 1;
            let pcx_arg1 = resolve(p, parent_of(c, pcx), true, pcx) + 2;
            pcx.vis_end.put(pcx_arg, pcx_arg1);
        }
    }
}

// Where a restriction that ends at module `end` lets its item be seen,
// for a message: `crate 'std'`, `this crate`, `module 'a::b'`.
pub fn vis_where(end: i64, pcx: &Ctx<Comp>) -> &[u8] {
    if end == pcx.std_module {
        return b"crate 'std'";
    }
    if end == 0 {
        return b"this crate";
    }
    let b = buf_new();
    // UNSAFE: MODULES is the table of modules, a raw pointer (front/modules).
    // SAFETY: end > 0 is a module's index (vis_end's), below module_count().
    let key = unsafe { pcx.modules[end as usize].key };
    buf_fmt(b, format_args("module '{}'", str::from_utf8(sym_text(key, pcx)).unwrap()));
    buf_slice(b)
}

// The bytes of node n's restriction, `pub(crate)` (its start, its end),
// (-1, -1) for none.
pub fn restriction_span(n: i64, pcx: &Ctx<Comp>) -> (i64, i64) {
    let p = vis_token(n, pcx);
    if p < 0 {
        return (-1, -1);
    }
    (tok(p, pcx).start, tok(restriction_end(p, pcx) - 1, pcx).end)
}

// The bytes of a `pub(self)` written at or just before position pos (an
// item's start is after its `pub`, a field's at it), (-1, -1) for none:
// `fix --only pub` makes it `pub`.
pub fn self_span(pos: i64) -> (i64, i64) {
    let mut s = pos;
    if !(s + 3 <= get_src().len() as i64 && get_src()[s as usize..(s + 3) as usize] == b"pub") {
        // (back over blanks to a `)`)
        let mut i = pos - 1;
        while i > 0
            && (get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\t'
                || get_src()[i as usize] == b'\n') {
            i -= 1;
        }
        if i <= 0 || get_src()[i as usize] != b')' {
            return (-1, -1);
        }
        while i > 0 && get_src()[i as usize] != b'(' {
            i -= 1;
        }
        while i > 0
            && (get_src()[(i - 1) as usize] == b' ' || get_src()[(i - 1) as usize] == b'\t') {
            i -= 1;
        }
        if i < 3 || &get_src()[(i - 3) as usize..i as usize] != b"pub" {
            return (-1, -1);
        }
        s = i - 3;
    }
    let mut e = s + 3;
    while e < get_src().len() as i64
        && (get_src()[e as usize] == b' ' || get_src()[e as usize] == b'\t') {
        e += 1;
    }
    if e >= get_src().len() as i64 || get_src()[e as usize] != b'(' {
        return (-1, -1);
    }
    let mut close = e;
    while close < get_src().len() as i64 && get_src()[close as usize] != b')' {
        close += 1;
    }
    if close >= get_src().len() as i64 {
        return (-1, -1);
    }
    let mut w = e + 1;
    while w < close && get_src()[w as usize] == b' ' {
        w += 1;
    }
    let mut we = close;
    while we > w && get_src()[(we - 1) as usize] == b' ' {
        we -= 1;
    }
    if &get_src()[w as usize..we as usize] != b"self" {
        return (-1, -1);
    }
    (s, close + 1)
}

// The text of a restriction written at or just before position pos
// (`pub(crate)`, `pub(in a::b)`), from the source alone (the tools'
// cache has no tokens), empty for none: what `query context` and hover
// show of a definition's visibility.
pub fn written_restriction(pos: i64) -> &'static [u8] {
    let mut s = pos;
    if !(s + 4 <= get_src().len() as i64 && get_src()[s as usize..(s + 4) as usize] == b"pub(") {
        let mut i = pos - 1;
        while i > 0
            && (get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\t'
                || get_src()[i as usize] == b'\n') {
            i -= 1;
        }
        if i <= 0 || get_src()[i as usize] != b')' {
            return b"";
        }
        while i > 0 && get_src()[i as usize] != b'(' {
            i -= 1;
        }
        if i < 3 || &get_src()[(i - 3) as usize..i as usize] != b"pub" {
            return b"";
        }
        s = i - 3;
    }
    let mut e = s;
    while e < get_src().len() as i64 && get_src()[e as usize] != b')'
        && get_src()[e as usize] != b'\n' {
        e += 1;
    }
    if e < get_src().len() as i64
        && get_src()[e as usize] == b')' { &get_src()[s as usize..(e + 1) as usize] } else { b"" }
}
