// Modules (0.5): a file is a module. The files named on the command line
// make the root module (the crate); `mod name;` in a module's file loads
// name.vl (or name/mod.vl) as its child module `name`. The C headers
// of `import` make a module of their own.
//
// Every item has a key: its name qualified by its module's path
// (`util::Point`; an item of the root module is keyed by its bare name).
// The tables of declarations (types.vl) are indexed by keys. Code
// names an item through its module's scope: the module's own items, its
// child modules, what its `use` items import, and the prelude. (0.8: no
// `*` imports, which brought every item of a module, or every variant of
// an enum; they are still resolved, for --fix-imports and for the errors
// that replace them: see LEGACY_IMPORTS.)
//
// Items are private to their module (and its descendants) unless `pub`.
//
// Here: the table of modules, item keys, and loading the modules' files;
// in lookup.vl: scopes, `use` items, lookups and paths.

use std::mem; pub mod lookup;
// (0.27.3: std2 parsed lazily)
pub mod std2lazy;
// (0.26.2: `pub(crate)`, `pub(super)`, `pub(in path)`)
pub mod vis;

use crate::arch::virtual::load_arch_modules;
use crate::base::{
    add_source, buf_append, buf_byte, buf_bytes, buf_clear, buf_copy, buf_fmt, buf_len, buf_new,
    buf_ptr, buf_str, c_bytes, c_plain_path, cstr, intern_buf, intern_c, read_file, streq, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end_soft, err_fmt, err_help, err_help_fmt, err_try_tool, error_at_soft,
    fail_name,
};
use crate::front::cpp::directives::{file_exists, path_base, path_dir};
use crate::front::lexer::{Tok, lex_range};
use crate::middle::profile::profile_runtime_source;
use crate::middle::trace::trace_runtime_source;
use crate::middle::unsafecheck::check_runtime_source;

// What other modules use of the parts.

// `key`: the module's path (`a::b`), `sym`: the same with dots (`a.b`),
// the prefix of its items' symbols in the assembly.
#[derive(Clone, Copy)] pub struct Module {
    pub name: i64, pub parent: i64, pub key: i64, sym: i64, pub public: bool, pub is_c: bool,
}

pub fn add_module(name: i64, parent: i64, public: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let m = pcx.modules.len() as i64;
    let mut key = name;
    let mut sym = name;
    if parent > 0 {
        key = join_sym(pcx.modules[parent as usize].key, c"::", name, pcx);
        sym = join_sym(pcx.modules[parent as usize].sym, c".", name, pcx);
    }
    pcx.modules.push(Module { name, parent, key, sym, public, is_c: false });
    let k = child_key(parent, name);
    if m > 0 && k != 0 && pcx.children.get(k) == 0 {
        pcx.children.put(k, m);
    }
    m
}

pub fn init_modules(pcx: &mut Ctx<Comp>) {
    if pcx.modules.len() as i64 == 0 {
        add_module(-1, -1, public: true, pcx: pcx);
    }
}

pub fn join_sym(a: i64, sep: *const u8, b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    joined(a, sep, b, pcx);
    intern_buf(pcx.join_buf, pcx)
}

// `a`, `sep`, `b` written into pcx.join_buf, which is cleared each time:
// its view lasts until the next call, so the consumer reads it in its own
// call (src-buffer.md, views of other storage).
fn joined(a: i64, sep: *const u8, b: i64, pcx: &mut Ctx<Comp>) {
    if pcx.join_buf < 0 {
        pcx.join_buf = buf_new();
    }
    buf_clear(pcx.join_buf);
    buf_bytes(pcx.join_buf, sym_text(a, pcx));
    buf_str(pcx.join_buf, sep);
    buf_bytes(pcx.join_buf, sym_text(b, pcx));
}

// The key of item `name` of module m.
pub fn qualify(m: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if m <= 0 {
        return name;
    }
    let k = (name + 1) * 65536 + m;
    let known = pcx.qualified.get(k);
    if known != 0 {
        return known - 1;
    }
    let key = join_sym(pcx.modules[m as usize].key, c"::", name, pcx);
    pcx.qualified.put(k, key + 1);
    key
}

// The key of item `name` of module m if it has been made (an item of that
// name exists there), else -1; makes no symbol.
fn qualified_if_known(m: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if m <= 0 {
        return name;
    }
    let known = pcx.qualified.get((name + 1) * 65536 + m);
    if known != 0 {
        return known - 1;
    }
    joined(pcx.modules[m as usize].key, c"::", name, pcx);
    crate::base::find_sym_buf(pcx.join_buf, pcx)
}

// The key of item `name` of module m, if it has one, else -1 (0.11:
// suggestions for unknown names).
pub fn item_key_if_known(m: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    qualified_if_known(m, name, pcx)
}

// The assembly symbol of item `name` of module m.
pub fn item_symbol(m: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if m <= 0 { name } else { join_sym(pcx.modules[m as usize].sym, c".", name, pcx) }
}

// The file holding position `pos`.
fn file_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    // (the files are in order of their start positions)
    let mut lo: i64 = 0;
    let mut hi = pcx.files.len() as i64 - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if pos >= pcx.files[mid as usize].start {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

pub fn module_of(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    module_at(pcx.nodes[n as usize].start, pcx)
}

// The module of the code at position `pos`: the innermost inline module
// around it, else its file's. (0.22) By the index below: the entry with
// the last start at or before pos, else the nearest of its ancestors
// around pos (inline modules nest or are disjoint), in O(log n) rather
// than a scan of every inline module, std's included, for each token.
pub fn module_at(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.im_indexed != pcx.inline_mods.len() as i64 {
        index_inline_mods(pcx);
    }
    let mut lo: i64 = 0;
    let mut hi = pcx.im_order.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if (pcx.inline_mods[(3 * (pcx.im_order[mid as usize])) as usize])
            <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    let mut p = lo - 1;
    while p >= 0 {
        let e = 3 * (pcx.im_order[p as usize]);
        if pos < (pcx.inline_mods[(e + 1) as usize]) {
            return (pcx.inline_mods[(e + 2) as usize]);
        }
        p = (pcx.im_parent[p as usize]);
    }
    pcx.files[file_of(pos, pcx) as usize].module
}

fn index_inline_mods(pcx: &mut Ctx<Comp>) {
    let n = pcx.inline_mods.len() as i64 / 3;
    pcx.im_order.clear();
    pcx.im_parent.clear();
    for k in 0..n {
        pcx.im_order.push(k);
    }
    // by start (an insertion sort: stable, and the table is short and
    // already in order but for modules added out of it)
    for a in 1..n {
        let mut b = a;
        while b > 0
            && (pcx.inline_mods[(3 * (pcx.im_order[(b - 1) as usize])) as usize])
            > (pcx.inline_mods[(3 * (pcx.im_order[b as usize])) as usize]) {
            let t = (pcx.im_order[(b - 1) as usize]);
            (pcx.im_order[(b - 1) as usize]) = (pcx.im_order[b as usize]);
            (pcx.im_order[b as usize]) = t;
            b -= 1;
        }
    }
    // parents: the open entries on a stack
    let mut stack = mem::replace(&mut pcx.im_stack, Vec::new_in(Comp {}));
    stack.clear();
    for p in 0..n {
        let start = (pcx.inline_mods[(3 * (pcx.im_order[p as usize])) as usize]);
        while stack.len() as i64 > 0
            && (
                pcx.inline_mods[
                    (3 * (pcx.im_order[(stack[(stack.len() as i64 - 1) as usize]) as usize]) + 1) as usize])
            <= start {
            stack.pop();
        }
        pcx.im_parent.push(if stack.len() as i64
            > 0 { (stack[(stack.len() as i64 - 1) as usize]) }
            else { -1 });
        stack.push(p);
    }
    pcx.im_stack = stack;
    pcx.im_indexed = pcx.inline_mods.len() as i64;
}

pub fn module_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.modules.len() as i64
}

// (0.25) The module named `name` in `m` (the first added), by CHILDREN,
// not a scan of every module: lookups and imports ask it often.
pub fn child_module(m: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = child_key(m, name);
    if k != 0 {
        let c = pcx.children.get(k);
        return if c > 0 { c } else { -1 };
    }
    for c in 1..pcx.modules.len() as i64 {
        if pcx.modules[c as usize].parent == m && pcx.modules[c as usize].name == name {
            return c;
        }
    }
    -1
}

// The key of module `name` in `parent` in CHILDREN (0: none, for a name
// or parent outside the key's range; child_module then scans).
fn child_key(parent: i64, name: i64) -> i64 {
    if parent < -1 || parent >= 2147483647 || name < 0 || name >= 4294967296 {
        return 0;
    }
    ((parent + 2) << 32) | name
}

// Whether module `inner` is `outer` or one of its descendants.
pub fn is_within(inner: i64, outer: i64, pcx: &Ctx<Comp>) -> bool {
    let mut m = inner;
    while m >= 0 {
        if m == outer {
            return true;
        }
        m = pcx.modules[m as usize].parent;
    }
    false
}

// (0.20) Whether module m is std or one of its modules (std is a tree:
// std::iter, std::collections::hash_map).
pub fn within_std(m: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.std_module >= 0 && m >= 0 && is_within(m, pcx.std_module, pcx)
}

// (0.26.3, decision 6) Whether module m is std::num::wrapping, whose
// arithmetic never checks overflow (places/build.vl binary_rv): Rust's
// wrapping_add and its kin are written there with the operators.
pub fn std_wraps(m: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.std_module < 0 || m < 0 || m == pcx.std_module
        || !is_within(m, pcx.std_module, pcx) {
        return false;
    }
    let parent = pcx.modules[m as usize].parent;
    parent >= 0 && pcx.modules[parent as usize].parent == pcx.std_module
        && sym_text(pcx.modules[m as usize].name, pcx) == b"wrapping"
        && sym_text(pcx.modules[parent as usize].name, pcx) == b"num"
}

// ---- Loading ----

// `mod name;` in the files read so far (and in the files they load): the
// child modules' files are read, lexed and appended. Done before parsing.
pub fn load_modules(pcx: &mut Ctx<Comp>) {
    init_modules(pcx);
    load_std_if_named(pcx);
    scan_modules(0, pcx);
    // (0.18: a test build's code, front/tests)
    crate::front::tests::add_test_code(pcx);
    // Named only in a module's file (fixed in 0.6: 0.5 looked at the files
    // of the command line alone; 0.20: then std's modules).
    let before = pcx.toks.len() as i64;
    load_std_if_named(pcx);
    scan_modules(before, pcx);
    // (0.27.3) std2 parsed lazily: what the program cannot reach dropped
    crate::front::modules::std2lazy::filter_std2(pcx);
    // (0.19: std::arch's virtual modules, when the program names them)
    load_arch_modules(pcx);
    // (0.10: --check-unsafe's runtime)
    if pcx.check_unsafe && pcx.check_module < 0 {
        let text = buf_new();
        check_runtime_source(text, pcx);
        let start = add_source(c"<check>", text, pcx, 0);
        pcx.check_module = add_module(intern_c(c"__check", pcx), 0, public: false, pcx: pcx);
        { let at_ix = (pcx.files.len() as i64 - 1) as usize;
            pcx.files[at_ix].module = pcx.check_module };
        lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false,
            pcx: pcx);
    }
    // (0.10: --profile-generate's runtime)
    if pcx.profile_generate != 0 as *mut u8 && pcx.profile_module < 0 {
        let text = buf_new();
        profile_runtime_source(text);
        let start = add_source(c"<profile>", text, pcx, 0);
        pcx.profile_module = add_module(intern_c(c"__profile", pcx), 0, public: false, pcx: pcx);
        { let at_ix = (pcx.files.len() as i64 - 1) as usize;
            pcx.files[at_ix].module = pcx.profile_module };
        lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false,
            pcx: pcx);
    }
    // (0.17: --trace's runtime)
    if pcx.trace && pcx.trace_module < 0 {
        let text = buf_new();
        trace_runtime_source(text);
        let start = add_source(c"<trace>", text, pcx, 0);
        pcx.trace_module = add_module(intern_c(c"__trace", pcx), 0, public: false, pcx: pcx);
        { let at_ix = (pcx.files.len() as i64 - 1) as usize;
            pcx.files[at_ix].module = pcx.trace_module };
        lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false,
            pcx: pcx);
    }
}

// One pass over the tokens from token i, in the order of the files (a
// module's file and its tokens are appended when it is loaded, so its own
// `mod` items come later in the pass).
fn scan_modules(from: i64, pcx: &mut Ctx<Comp>) {
    let mut i = from;
    while i + 2 < pcx.toks.len() as i64 {
        // RULE: Z5.2 (std2's tail before its text is lexed: its modules
        // made after the text's, std2_inline_modules)
        if crate::front::modules::std2lazy::deferred(i) {
            i += 1;
            continue;
        }
        if pcx.toks[i as usize].kind == Tok::Mod && pcx.toks[(i + 1) as usize].kind == Tok::Ident
            && pcx.toks[(i + 2) as usize].kind == Tok::Semi {
            let f = file_of(pcx.toks[i as usize].start, pcx);
            // (after an error, on with the next one: 0.10)
            if f == pcx.std_file {
                // (0.20) std's text: its modules are there, as
                // `mod name { }` after their parent's text (embed.sh)
            } else if module_at(pcx.toks[i as usize].start, pcx) != pcx.files[f as usize].module {
                error_at_soft(pcx.toks[i as usize].start, c"'mod name;' cannot be inside an inline module (a module's file is found from its file's module)", pcx);
                fail_name(pcx.toks[(i + 1) as usize].value as i64, pcx);
            } else {
                load_module(f, i, pcx);
            }
        }
        if pcx.toks[i as usize].kind == Tok::Mod && pcx.toks[(i + 1) as usize].kind == Tok::Ident
            && pcx.toks[(i + 2) as usize].kind == Tok::LBrace {
            add_inline_module(i, pcx);
        }
        i += 1;
    }
}

// The standard library, once: std's whole text (load_std2), whether the
// program names std or not (RULE: Z1.1).
fn load_std_if_named(pcx: &mut Ctx<Comp>) {
    if pcx.std_module >= 0 {
        return;
    }
    load_std2(pcx);
}

// (0.27.2) std2, the rust edition's std, as the module std: its built-in
// text (stdsrc_rust.vl), every section. RULE: Z1.1
fn load_std2(pcx: &mut Ctx<Comp>) {
    let text = buf_new();
    // RULE: Z4.2 (std's files read: std2's too, as embed.sh assembles them;
    // the built-in text when the tree has none, or a file is missing)
    let own = buf_new();
    let from_tree = crate::front::stdtree::std2_tree_text(own, pcx);
    let tree = if from_tree { pcx.std_tree } else { 0 as *mut u8 };
    if from_tree {
        buf_append(text, own);
    } else {
        crate::front::stdsrc_rust::std2_source(text);
    }
    let body_len = buf_len(text);
    // (std is checked as the built-in std is, whichever text it is)
    pcx.std_tree = 0 as *mut u8;
    // RULE: Z5.1 (what the lowerings name: std::__rt)
    crate::front::stdalloc::std2_tail(text, tree);
    let start = add_source(c"<std>", text, pcx, 0);
    pcx.std_module = add_module(intern_c(c"std", pcx), 0, public: true, pcx: pcx);
    pcx.std_file = pcx.files.len() as i64 - 1;
    { let at_ix = pcx.std_file as usize; pcx.files[at_ix].module = pcx.std_module };
    // (0.26.2: its lines from std2_line_marks, base/diag: the built-in
    // text's)
    if !from_tree {
        pcx.std_text_file = pcx.std_file;
    }
    let first = pcx.toks.len() as i64;
    let end = pcx.files[pcx.std_file as usize].end;
    // RULE: Z5.2 (0.27.5: the built-in text lexed later by the units the
    // build reaches, std2lazy.vl: filter_std2; the tail now)
    if crate::front::modules::std2lazy::index_ready(body_len, from_tree, pcx) {
        lex_range(start + body_len, end, last: false, pcx: pcx);
        crate::front::modules::std2lazy::std2_tail_lexed(first, pcx.toks.len() as i64, start, end);
        return;
    }
    lex_range(start, end, last: false, pcx: pcx);
    // (0.27.3: its tokens, for the lazy read, std2lazy.vl)
    crate::front::modules::std2lazy::std2_lexed(first, pcx.toks.len() as i64);
}

// `mod name { ... }` at token i (0.6): a child module of the module around
// it, holding the code between the braces.
fn add_inline_module(i: i64, pcx: &mut Ctx<Comp>) {
    let parent = module_at(pcx.toks[i as usize].start, pcx);
    let name = pcx.toks[(i + 1) as usize].value as i64;
    if child_module(parent, name, pcx) >= 0 {
        err_begin(pcx.toks[(i + 1) as usize].start, pcx);
        err_fmt(format_args("module '{}' is declared twice",
            str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
        err_end_soft(pcx);
    }
    let public = crate::front::modules::vis::module_public(i, pcx);
    // The matching closing brace.
    let mut depth: i64 = 0;
    let mut j = i + 2;
    while j < pcx.toks.len() as i64 {
        if pcx.toks[j as usize].kind == Tok::LBrace {
            depth += 1;
        } else if pcx.toks[j as usize].kind == Tok::RBrace {
            depth -= 1;
            if depth == 0 {
                break;
            }
        }
        j += 1;
    }
    let m = add_module(name, parent, public, pcx);
    crate::front::modules::vis::note_module_vis(m, i, pcx);
    pcx.inline_mods.push(pcx.toks[(i + 2) as usize].start);
    pcx.inline_mods.push(if j < pcx.toks.len() as i64 { pcx.toks[j as usize].start + 1 }
        else { pcx.toks[(pcx.toks.len() as i64 - 1) as usize].start + 1 });
    pcx.inline_mods.push(m);
}

// RULE: Z5.2 (0.27.5) std2's inline modules, tokens first..end, once
// std2lazy.vl has lexed the units a build keeps (scan_modules left them).
pub fn std2_inline_modules(first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    for i in first..end - 2 {
        if pcx.toks[i as usize].kind == Tok::Mod && pcx.toks[(i + 1) as usize].kind == Tok::Ident
            && pcx.toks[(i + 2) as usize].kind == Tok::LBrace {
            add_inline_module(i, pcx);
        }
    }
}

fn load_module(f: i64, i: i64, pcx: &mut Ctx<Comp>) {
    let parent = pcx.files[f as usize].module;
    let name = pcx.toks[(i + 1) as usize].value as i64;
    if child_module(parent, name, pcx) >= 0 {
        err_begin(pcx.toks[(i + 1) as usize].start, pcx);
        err_fmt(format_args("module '{}' is declared twice",
            str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
        err_end_soft(pcx);
        return;
    }
    let public = crate::front::modules::vis::module_public(i, pcx);
    let path = module_file(f, name, pcx);
    if path == 0 as *mut u8 {
        err_begin(pcx.toks[(i + 1) as usize].start, pcx);
        err_fmt(format_args("cannot find the file of module '{}'",
            str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
        missing_module_help(f, name, pcx);
        err_end_soft(pcx);
        // (what it would have declared is unknown: no errors for it)
        fail_name(name, pcx);
        return;
    }
    if pcx.module_conflict != 0 as *mut u8 {
        // (0.21) `x.vl` and `x.vl` both: which one is the module
        err_begin(pcx.toks[(i + 1) as usize].start, pcx);
        err_fmt(
            format_args("module '{}' has two files, {} and {}",
                str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(&cstr(path)).unwrap(),
                str::from_utf8(&cstr(pcx.module_conflict)).unwrap()), pcx);
        err_help(
            c"a module is one file: delete or rename one of them (`.vl` is the extension from 0.24)", pcx);
        err_end_soft(pcx);
    }
    let m = add_module(name, parent, public, pcx);
    crate::front::modules::vis::note_module_vis(m, i, pcx);
    let text = buf_new();
    read_file(path, text, pcx);
    let start = add_source(path, text, pcx, 0);
    { let at_ix = (pcx.files.len() as i64 - 1) as usize; pcx.files[at_ix].module = m };
    lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false, pcx: pcx);
}

// (0.17) The help of `mod name;` in file f without its file: when f is
// not the root and the file is next to f, it is the root's module (the
// `mod` line goes there, f imports it through `crate::`); else where the
// compiler looked, and the command that makes the file.
fn missing_module_help(f: i64, name: i64, pcx: &Ctx<Comp>) {
    // (0.21: the file f's own extension, `.vl` or `.vl`)
    let ext = if crate::base::source_ext_len(&cstr(pcx.files[f as usize].path)) == 3 {
        c".vl"
    } else {
        c".vl"
    };
    let flat = module_candidate(f, name, nested: false, ext: ext, pcx: pcx);
    let shown = c_plain_path(flat);
    if pcx.files[f as usize].module > 0 && pcx.files[f as usize].module != pcx.std_module
        && !is_mod_file(path_base(pcx.files[f as usize].path)) {
        let side = buf_new();
        buf_fmt(side,
            format_args("{}/{}{}",
                str::from_utf8(&cstr(path_dir(pcx.files[f as usize].path))).unwrap(),
                str::from_utf8(sym_text(name, pcx)).unwrap(),
                str::from_utf8(&cstr(ext)).unwrap()));
        buf_byte(side, 0);
        let sp = buf_ptr(side);
        if file_exists(sp, pcx) {
            let mut r: i64 = 0;
            while r < pcx.files.len() as i64 && file_made(r, pcx) {
                r += 1;
            }
            let root = if r < pcx.files.len() as i64 { pcx.files[r as usize].path }
                else { c"main.vl" };
            err_help_fmt(
                format_args("{} is a module of the root: its `mod {};` goes in {}, and this file imports it as `use crate::{}::...;`", str::from_utf8(&cstr(c_plain_path(sp))).unwrap(), str::from_utf8(sym_text(name, pcx)).unwrap(), str::from_utf8(&cstr(path_base(root))).unwrap(), str::from_utf8(sym_text(name, pcx)).unwrap()), pcx);
            return;
        }
    }
    err_help(c"looked for ", pcx);
    err_help(shown, pcx);
    err_help(c" and ", pcx);
    let nested = module_candidate(f, name, nested: true, ext: ext, pcx: pcx);
    err_help(c_plain_path(nested), pcx);
    err_help(c": write the file (`edit new-file` takes its text on stdin)", pcx);
    let args = buf_new();
    buf_fmt(args, format_args("edit new-file {}", str::from_utf8(&cstr(shown)).unwrap()));
    err_try_tool(&buf_copy(args), true, pcx);
}

// (0.25.2.2, eval 0.25.2.1: qwen35, deferred) The help of `unknown module
// 'name'` in the root module when name.vl is beside the root's file
// (`root`, its path): the file checked is a module of a program whose
// main.vl (beside it) does not `mod` it (yet), so it was checked as a
// program of its own; or the program lacks `mod name;`. Whether there was a
// help.
pub fn beside_root_help(root: &[u8], name: &[u8], pcx: &Ctx<Comp>) -> bool {
    let mut cut = root.len() as i64;
    while cut > 0 && root[(cut - 1) as usize] != b'/' {
        cut -= 1;
    }
    let base = &root[cut as usize..];
    let dir = if cut > 0 { &root[0..cut as usize] } else { b"" };
    let side = buf_new();
    buf_bytes(side, dir);
    buf_bytes(side, name);
    buf_str(side, c".vl");
    if !file_exists(crate::tools::proc::buf_cstr(side), pcx) {
        return false;
    }
    let main = buf_new();
    buf_bytes(main,
        if dir.len() > 2 && dir[0] == b'.' && dir[1] == b'/' { &dir[2..dir.len()] }
        else { dir });
    buf_str(main, c"main.vl");
    let shown = buf_copy(main);
    let stem = if base.len() > 3 { &base[0..(base.len() as i64 - 3) as usize] } else { base };
    if base != b"main.vl" && file_exists(crate::tools::proc::buf_cstr(main), pcx) {
        err_help_fmt(
            { let base = str::from_utf8(base).unwrap(); { let stem = str::from_utf8(stem).unwrap(); { let shown = str::from_utf8(&shown).unwrap(); { let name = str::from_utf8(name).unwrap(); format_args("{base} was checked as a program of its own (no `mod {stem};` in {shown} names it), so {name}.vl beside it is not its module: a module is checked through its program's root, once the root has `mod {stem};`") } } } }, pcx);
        let args = buf_new();
        buf_fmt(args,
            { let shown = str::from_utf8(&shown).unwrap(); format_args("check {shown}") });
        err_try_tool(&buf_copy(args), false, pcx);
    } else {
        err_help_fmt(
            { let name = str::from_utf8(name).unwrap(); { let base = str::from_utf8(base).unwrap(); format_args("{name}.vl is beside {base} but not a module of the program: `mod {name};` in {base} makes it one") } }, pcx);
    }
    true
}

// Where `mod name;` in file f looks: next to the file for a root file, one
// of std's root files (0.20: std is a crate of its own; compiler/std/NAME.vl
// is std::NAME) or a `mod.vl`, else in the directory named after the file
// (`a.vl`: `a/`); as `name.vl`, or `name/mod.vl` when `nested`.
// (0.21) ext is the extension, `.vl` or `.vl`: `a.vl`, `mod.vl` likewise.
fn module_candidate(f: i64, name: i64, nested: bool, ext: *const u8, pcx: &Ctx<Comp>) -> *mut u8 {
    let path = pcx.files[f as usize].path;
    let out = buf_new();
    buf_fmt(out, format_args("{}/", str::from_utf8(&cstr(path_dir(path))).unwrap()));
    let base = path_base(path);
    if pcx.files[f as usize].module > 0 && pcx.files[f as usize].module != pcx.std_module
        && !is_mod_file(base) {
        let name = cstr(base);
        let stem = name.len() - crate::base::source_ext_len(&name) as usize;
        buf_fmt(out, format_args("{}/", str::from_utf8(&name[..stem]).unwrap()));
    }
    buf_bytes(out, sym_text(name, pcx));
    buf_str(out, if nested { c"/mod" } else { c"" });
    buf_str(out, ext);
    buf_byte(out, 0);
    buf_ptr(out)
}

// (0.21) Whether a file's base name is a module's folder file, `mod.vl`
// or `mod.vl`.
fn is_mod_file(base: *const u8) -> bool {
    streq(base, c"mod.vl") || streq(base, c"mod.vl")
}

// The file of `mod name;` in file f (module_candidate), `.vl` or (0.21)
// `.vl`; 0 when there is none. Both of one candidate: MODULE_CONFLICT is
// the `.vl` one, which load_module reports, and the `.vl` one is read.
fn module_file(f: i64, name: i64, pcx: &mut Ctx<Comp>) -> *mut u8 {
    pcx.module_conflict = 0 as *mut u8;
    for k in 0..2 {
        let nested = k == 1;
        let tach = module_candidate(f, name, nested, c".vl", pcx);
        let vl = module_candidate(f, name, nested, c".vl", pcx);
        let has_tach = file_exists(tach, pcx);
        let has_vl = file_exists(vl, pcx);
        // (one file when the two are one path: 0.24's rename makes the
        // `.vl` here `.vl`, tools/rename-vole.sh)
        if has_tach && has_vl && !crate::base::streq(tach, vl) {
            pcx.module_conflict = vl;
        }
        // (the other extension, absent: a cached answer is stale once
        // it appears, MODULE_PROBES)
        if has_tach && !has_vl {
            pcx.module_probes.push(vl as i64);
        }
        if has_vl && !has_tach {
            pcx.module_probes.push(tach as i64);
        }
        if has_tach {
            return tach;
        }
        if has_vl {
            return vl;
        }
        pcx.module_probes.push(tach as i64);
        pcx.module_probes.push(vl as i64);
    }
    0 as *mut u8
}

// (0.29) The path of file f as bytes: read as a slice, not by offsets
// from the C string (which read past a short path's NUL).
pub fn file_path(f: i64, pcx: &Ctx<Comp>) -> &[u8] {
    // UNSAFE: a file's path is kept as a C string (FileInfo.path)
    // SAFETY: the path is made when the file is added (load_sources,
    // add_source, the tools' cache's read buffer, which is frozen) and
    // is never written or freed after; the slice borrows pcx, whose
    // files it is read from, so it cannot outlive them
    unsafe { c_bytes(pcx.files[f as usize].path) }
}

// Whether file f is a source the compiler made (`<std>`, `<derive>`,
// `<test>`, a virtual module): its path starts with `<`.
pub fn file_made(f: i64, pcx: &Ctx<Comp>) -> bool {
    file_path(f, pcx).starts_with(b"<")
}

pub fn file_of_pos(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    file_of(pos, pcx)
}
