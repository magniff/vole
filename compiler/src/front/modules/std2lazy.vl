// (0.27.3) std2 parsed lazily (cost273): std2's text is lexed whole, as
// before, and then only the units a build can reach are kept for the
// parser; the other units' tokens are dropped, so they are never parsed,
// derived, expanded (`#[builtin_impls]`) or collected. A unit is a
// top-level item of a module of std2; an inherent impl is split into its
// header, each method (or associated const) and its closing brace; a
// trait into its header with its required items, each default method and
// its closing brace.
//
// What is reached, by name (a word is an identifier token):
// - the words of the program's files, the known items (front/known.vl)
//   and SEEDS (the names the compiler's lowerings and made text use);
// - an item whose name is a word of a reached unit, and every trait that
//   has an item of that name (`v.extend(..)` names Extend by its method);
// - an inherent method or a trait's default method whose name is such a
//   word, once its type or trait is reached (a type that is no item of
//   std2, `str`, `[T]`, a number, is always reached);
// - a trait impl once its trait and its type are reached (a blanket
//   `impl<T: Display> ToString for T`, of a type that is no item of std2,
//   with its trait; an impl of a trait no std2 item is, Send's, with its
//   type);
// - a `use` line's leaf asks for the capitalized segments before it
//   (`Some` asks for `Option`) and, under `as`, for the name it renames.
// - (0.27.6) a unit of a GATED module (std::gpu), its `use` lines
//   included, only once its name is asked: until then it waits (Z5.2).
// `use` and `mod` lines, extern blocks and the tail's modules (`__rt`,
// `__gpa`, `__sys`, which the lowerings name) are always kept, the last
// two read.
//
// Names are matched without their modules: two items of one name are
// both reached, which keeps more than needed. A lazy build with errors is
// made again with every unit (rerun_eager), so that its diagnostics are
// the whole std2's; one that needed a unit not kept has errors so. A build
// is lazy only (BUILD); VOLE_STD2_EAGER=1 keeps every unit, and so do
// queries, `--std2-check` and std2 read from its files.

use std::alloc::Allocator; use crate::base::{
    get_src, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_uint, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::middle::lower::ssa::HMap;

static STD2_FIRST: Atomic<i64> = Atomic::new(-1);
static STD2_END: Atomic<i64> = Atomic::new(-1);
static EAGER: Atomic<bool> = Atomic::new(false);
static BUILD: Atomic<bool> = Atomic::new(false);
static DROPPED: Atomic<i64> = Atomic::new(0);
// (VOLE_STD2_NORERUN=1, front/stdtree.vl: no rerun_eager, for the twin)
static NORERUN: Atomic<bool> = Atomic::new(false);

// RULE: Z5.2 (0.27.5) std2 lexed by its units, from the index embed.sh
// writes (stdsrc_rust.vl: std2_units, made by `volec __std2-index`).
// INDEX_FORMAT is the index's format: embed.sh asks for this number
// (STD2_UNITS_FORMAT there), and an index of another is not read.
const INDEX_FORMAT: i64 = 1;
// (VOLE_STD2_INDEX=0, front/stdtree.vl: the text lexed whole, as in 0.27.4)
static INDEX_OFF: Atomic<bool> = Atomic::new(false);
// (VOLE_STD2_DUMP=FILE: the tokens kept, written there, dump_std2)
static DUMP: Atomic<*mut u8> = Atomic::new(0 as *mut u8);
// The index's text (a buffer), when load_std2 lexed only the tail.
static INDEX_BUF: Atomic<i64> = Atomic::new(-1);
// Then: where std2's text starts in SRC and where the std file ends.
static TEXT_START: Atomic<i64> = Atomic::new(-1);
static TEXT_END: Atomic<i64> = Atomic::new(-1);

// RULE: F15.1 (0.27.4) The primitives whose builtin impls a lazy build makes
// (front/builtin_impls.vl): those the program's files name, by a word or a
// literal's suffix (`5u16`), and the ones that come unnamed (the literals'
// i32 and f64, a length's usize, a str's bytes' u8, a condition's bool).
// Bit k is PRIM_NAMES[k]; PRIMS_READ once filter_std2 has read the words.
// A build whose check then fails is made again whole (rerun_eager): a
// dropped impl counts as dropped text.
const PRIM_NAMES: [&[u8]; 13] = [b"i8", b"i16", b"i32", b"i64", b"isize", b"u8", b"u16", b"u32",
    b"u64", b"usize", b"f32", b"f64", b"bool"];
static PRIMS_NAMED: Atomic<i64> = Atomic::new(0);
static PRIMS_READ: Atomic<bool> = Atomic::new(false);

// (0.27.4) Words of a program that bring a primitive it need not name,
// through std2's types and signatures (prim_wanted): a char's u32 (its
// Display, to_digit), Hash's and io::copy's u64, a derived order's isize,
// the atomics' aliases, a popped or drained char; (0.28.0) the modules
// whose items hold or return numbers (a program names the module to use
// one: `std::time::Duration`, its u64 and u32; a file's length and mode;
// std::cli's i64 values; std::sys's and std::unicode's numbers) and the
// methods that give a float (`as_secs_f64`); std::arch's intrinsics take
// and give every one (8191: all of PRIM_NAMES). std::num::Wrapping<T>
// computes in u64 and i64; unsigned_abs and abs_diff give the unsigned type
// of a signed one. A word missing here costs a
// rerun (VOLE_STD2_RERUN_NOTE says so), not a meaning.
const PRIM_WORDS: [&[u8]; 74] = [b"char", b"chars", b"char_indices", b"to_digit", b"from_digit",
    b"from_u32", b"to_uppercase", b"to_lowercase", b"HashMap", b"HashSet", b"Hash", b"Hasher",
    b"BuildHasher", b"hash", b"hash_one", b"copy", b"to_bits", b"from_bits", b"FixedState",
    b"FoldHasher", b"FoldSeeds", b"SipHasher13", b"SipHashState", b"PartialOrd", b"Ord",
    b"AtomicI8", b"AtomicI16", b"AtomicI32", b"AtomicI64", b"AtomicIsize", b"AtomicU16",
    b"AtomicU32", b"AtomicU64", b"floor", b"pop", b"drain", b"time", b"Duration", b"Instant",
    b"SystemTime", b"sleep", b"thread", b"cli", b"fs", b"File", b"metadata", b"symlink_metadata",
    b"Metadata", b"Path", b"PathBuf", b"random", b"sys", b"unicode", b"gpu", b"window",
    b"process", b"as_secs_f64", b"as_millis_f64", b"from_secs_f64", b"try_from_secs_f64",
    b"mul_f64", b"div_f64", b"div_duration_f64", b"as_secs_f32", b"from_secs_f32", b"mul_f32",
    b"div_f32", b"thread_local", b"objc", b"arch",
    b"Wrapping", b"carrying_mul", b"unsigned_abs", b"abs_diff"];
// Each word's primitives: bit k is PRIM_NAMES[k].
const P_I64: i64 = 1 << 3;
const P_U16: i64 = 1 << 6;
const P_U32: i64 = 1 << 7;
const P_U64: i64 = 1 << 8;
const P_F32: i64 = 1 << 10;
const P_F64: i64 = 1 << 11;
const P_TIME: i64 = P_U64 | P_U32 | P_I64;
const P_FILE: i64 = P_U64 | P_U32 | P_I64;
const P_SYS: i64 = P_U64 | P_U32 | P_I64 | P_U16;
const PRIM_WORD_BITS: [i64; 74] = [P_U32, P_U32, P_U32, P_U32, P_U32, P_U32, P_U32, P_U32, P_U64,
    P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64, P_U64,
    P_U64, 1 << 4, 1 << 4, 1 << 0, 1 << 1, 1 << 2, P_I64, 1 << 4, P_U16, P_U32, P_U64, P_U32,
    P_U32, P_U32, P_TIME, P_TIME, P_TIME, P_TIME, P_TIME, P_TIME, P_I64 | P_U64, P_FILE, P_FILE,
    P_FILE, P_FILE, P_FILE, P_FILE, P_FILE, P_SYS, P_SYS, P_SYS, P_SYS | P_F64 | P_F32,
    P_SYS | P_F64 | P_F32, P_SYS, P_F64, P_F64, P_F64, P_F64, P_F64, P_F64, P_F64, P_F32, P_F32,
    P_F32, P_F32, P_U64, P_SYS, 8191, P_U64 | P_I64 | P_U32, P_U64, P_U16 | P_U32 | P_U64,
    P_U16 | P_U32 | P_U64];

// Whether the builtin impls for primitive p are made (true when std2 is
// read whole, or p is no primitive of PRIM_NAMES).
pub fn prim_wanted(p: &[u8]) -> bool {
    if !get_prims_read() || p == b"i32" || p == b"usize" || p == b"u8" || p == b"bool" {
        return true;
    }
    for k in 0..PRIM_NAMES.len() {
        if PRIM_NAMES[k] == p {
            return (get_prims_named() & (1 << k as i64)) != 0;
        }
    }
    true
}

// A builtin impl not made (prim_wanted): a failing build reruns whole.
pub fn impl_dropped() {
    set_dropped(get_dropped() + (1));
}

// std2's tokens, first..end, as load_std2 lexed them.
pub fn std2_lexed(first: i64, end: i64) {
    set_std2_first(first);
    set_std2_end(end);
}

// RULE: Z5.2 Whether load_std2 may lex only the tail of std2's text, whose
// first body_len bytes are the built-in text (not a tree's): a lazy build
// whose index (std2_units) is of INDEX_FORMAT and of this text's length.
pub fn index_ready(body_len: i64, from_tree: bool, pcx: &Ctx<Comp>) -> bool {
    if get_index_off() || from_tree || get_eager_value() || !get_build_value()
        || !crate::front::known::on_std2(pcx) || pcx.query || pcx.std_always
        || crate::places::borrowck::std2::std2_check(pcx) {
        return false;
    }
    let b = buf_new();
    crate::front::stdsrc_rust::std2_units(b);
    let s = buf_slice(b);
    let mut at: i64 = 0;
    // (the text it was made for: embed.sh's first line, its cksum)
    let tw = next_word(s, &mut at);
    if tw < 0 || &s[tw as usize..at as usize] != b"std2-text"
        || next_num(s, &mut at) != crate::front::stdsrc_rust::std2_text_sum() {
        return false;
    }
    let w = next_word(s, &mut at);
    if w < 0 || &s[w as usize..at as usize] != b"std2-units" || next_num(s, &mut at) != INDEX_FORMAT
        || next_num(s, &mut at) != body_len {
        return false;
    }
    set_index_buf(b);
    true
}

// load_std2 lexed only the tail (index_ready): its tokens first..end;
// std2's text at text_start in SRC, the std file ending at text_end.
pub fn std2_tail_lexed(first: i64, end: i64, text_start: i64, text_end: i64) {
    std2_lexed(first, end);
    set_text_start(text_start);
    set_text_end(text_end);
    set_deferred(true);
}

// Whether token i is the tail's, whose inline modules front/modules:
// scan_modules leaves to filter_std2, so that std2's modules are made in
// their text's order, the tail's last, as when std2 is lexed whole.
pub fn deferred(i: i64) -> bool {
    get_deferred() && i >= get_std2_first() && i < get_std2_end()
}

static DEFERRED: Atomic<bool> = Atomic::new(false);

// The index's units, methods and asks (index_command writes them).
fn read_index(u: &mut Units<Comp>, pcx: &mut Ctx<Comp>) {
    let s = buf_slice(get_index_buf());
    let mut at: i64 = 0;
    next_word(s, &mut at);
    next_num(s, &mut at);
    next_word(s, &mut at);
    next_num(s, &mut at);
    next_num(s, &mut at);
    let nwords = next_num(s, &mut at);
    let nunits = next_num(s, &mut at);
    let nmethods = next_num(s, &mut at);
    let nasks = next_num(s, &mut at);
    // (the words' symbols, by their numbers: u.wlist)
    for _ in 0..nwords {
        let w = next_word(s, &mut at);
        u.wlist.push(intern(&s[w as usize..at as usize], pcx));
    }
    let mut end: i64 = 0;
    for k in 0..nunits {
        let kind = index_num(s, &mut at);
        let start = end + index_num(s, &mut at);
        end = start + index_num(s, &mut at);
        let name = index_num(s, &mut at);
        let tr = index_num(s, &mut at);
        let ty = index_num(s, &mut at);
        let back = index_num(s, &mut at);
        let nw = index_num(s, &mut at);
        add_unit(u, kind, get_text_start() + start, get_text_start() + end,
            if name > 0 { u.wlist[(name - 1) as usize] } else { -1 },
            if tr > 0 { u.wlist[(tr - 1) as usize] } else { -1 },
            if ty > 0 { u.wlist[(ty - 1) as usize] } else { -1 },
            if back > 0 { k - back } else { -1 });
        // (the words it asks for are read when it is reached, reach: most
        // units are not; the unit's line ends them)
        u.wstart[k as usize] = at;
        u.wend[k as usize] = nw;
        let mut i = at as usize;
        while i < s.len() && s[i] != b'\n' {
            i += 1;
        }
        at = i as i64;
    }
    for _ in 0..nmethods {
        let m = u.wlist[index_num(s, &mut at) as usize];
        add_method(u, m, index_num(s, &mut at));
    }
    for _ in 0..nasks {
        let a = u.wlist[index_num(s, &mut at) as usize];
        let b = u.wlist[index_num(s, &mut at) as usize];
        add_ask(u, a, b);
    }
    u.nbytes = nunits;
}

// The next word of s at or after at (its start; at after it), or -1.
fn next_word(s: &[u8], at: &mut i64) -> i64 {
    let n = s.len() as i64;
    while *at < n && (s[*at as usize] == b' ' || s[*at as usize] == b'\n') {
        *at += 1;
    }
    if *at >= n {
        return -1;
    }
    let w = *at;
    while *at < n && s[*at as usize] != b' ' && s[*at as usize] != b'\n' {
        *at += 1;
    }
    w
}

// The next number of s (a word of decimal digits), -1 when there is none.
fn next_num(s: &[u8], at: &mut i64) -> i64 {
    let w = next_word(s, at);
    if w < 0 {
        return -1;
    }
    let mut v: i64 = 0;
    for i in w..*at {
        if s[i as usize] < b'0' || s[i as usize] > b'9' {
            return -1;
        }
        v = v * 10 + (s[i as usize] - b'0') as i64;
    }
    v
}

// The next number of the index at `at` (the index is the one index_ready
// accepted: its numbers are digits): one pass over its bytes, where
// next_num makes two.
fn index_num(s: &[u8], at: &mut i64) -> i64 {
    let n = s.len();
    let mut i = *at as usize;
    while i < n && s[i] <= b' ' {
        i += 1;
    }
    let mut v: i64 = 0;
    while i < n {
        let c = s[i];
        if c < b'0' || c > b'9' {
            break;
        }
        v = v * 10 + (c - b'0') as i64;
        i += 1;
    }
    *at = i as i64;
    v
}

// RULE: Z5.2 `volec __std2-index FILE`: the index of
// std2's text in FILE (embed.sh's, without the tail), std2_units's text,
// on stdout: `std2-units FORMAT LENGTH WORDS UNITS METHODS ASKS`, the
// words (each an identifier's text), then each unit (its kind, its start
// after the last's end and its length in bytes, its name, trait and type
// head as a word's number from 1, 0 for none, how many units back its
// parent is, 0 for none, and the numbers of the words it asks for, how
// many first), each trait item name (its word, its trait's unit) and each
// `use` leaf's ask (the word asking, the word asked).
pub fn index_command(path: &str, pcx: &mut Ctx<Comp>) -> i64 {
    let text = buf_new();
    if !crate::tools::proc::read_file_if(crate::cli::c_of(path), text) {
        crate::base::die2(c"cannot read ", crate::cli::c_of(path));
    }
    let len = buf_slice(text).len() as i64;
    // (std's module and file, as load_std2 makes them: the text is read in
    // the rust edition, front/rust: rust_at)
    pcx.err_kind = c"tokenizer error";
    crate::front::lexer::init_lexer(pcx);
    crate::front::modules::init_modules(pcx);
    let start = crate::base::add_source(c"<std>", text, pcx, 0);
    pcx.std_module = crate::front::modules::add_module(intern(b"std", pcx), 0, public: true,
        pcx: pcx);
    pcx.std_file = pcx.files.len() as i64 - 1;
    { let at_ix = pcx.std_file as usize; pcx.files[at_ix].module = pcx.std_module };
    let first = pcx.toks.len() as i64;
    crate::front::lexer::lex_range(start, start + len, last: false, pcx: pcx);
    std2_lexed(first, pcx.toks.len() as i64);
    set_sym_async(intern(b"async", pcx));
    set_sym_default(intern(b"default", pcx));
    set_sym_dyn(intern(b"dyn", pcx));
    let mut u = units_new();
    split_units(&mut u, pcx);
    // the words, numbered from 0 as they come
    let mut number = hmap();
    let mut words = Vec::<i64, Comp>::new_in(Comp {});
    let n = u.kind.len() as i64;
    let body = buf_new();
    let mut last_end: i64 = 0;
    let mut seen = hmap();
    for k in 0..n {
        let bstart = pcx.toks[u.start[k as usize] as usize].start - start;
        let bend = pcx.toks[(u.end[k as usize] - 1) as usize].end - start;
        buf_int(body, u.kind[k as usize]);
        buf_byte(body, b' ');
        buf_int(body, bstart - last_end);
        buf_byte(body, b' ');
        buf_int(body, bend - bstart);
        last_end = bend;
        for f in 0..3 {
            let s = if f == 0 { u.name[k as usize] } else if f == 1 { u.trait_of[k as usize] }
                else { u.type_of[k as usize] };
            buf_byte(body, b' ');
            buf_int(body, if s >= 0 { word_number(s, &mut number, &mut words) + 1 } else { 0 });
        }
        buf_byte(body, b' ');
        buf_int(body, if u.parent[k as usize] >= 0 { k - u.parent[k as usize] } else { 0 });
        let mut asked = Vec::<i64, Comp>::new_in(Comp {});
        if asks_words(u.kind[k as usize]) {
            for t in u.start[k as usize]..u.end[k as usize] {
                if pcx.toks[t as usize].kind == Tok::Ident {
                    let s = pcx.toks[t as usize].value as i64;
                    if seen.get(s + 1) != k + 1 {
                        seen.put(s + 1, k + 1);
                        asked.push(word_number(s, &mut number, &mut words));
                    }
                }
            }
        }
        buf_byte(body, b' ');
        buf_int(body, asked.len() as i64);
        for j in 0..asked.len() {
            buf_byte(body, b' ');
            buf_int(body, asked[j]);
        }
        buf_byte(body, b'\n');
    }
    for m in 0..u.method_name.len() as i64 {
        buf_int(body, word_number(u.method_name[m as usize], &mut number, &mut words));
        buf_byte(body, b' ');
        buf_int(body, u.method_trait[m as usize]);
        buf_byte(body, b'\n');
    }
    for a in 0..u.alias_sym.len() as i64 {
        buf_int(body, word_number(u.alias_from[a as usize], &mut number, &mut words));
        buf_byte(body, b' ');
        buf_int(body, word_number(u.alias_sym[a as usize], &mut number, &mut words));
        buf_byte(body, b'\n');
    }
    let out = buf_new();
    buf_bytes(out, b"std2-units ");
    buf_int(out, INDEX_FORMAT);
    for v in [len, words.len() as i64, n, u.method_name.len() as i64, u.alias_sym.len() as i64] {
        buf_byte(out, b' ');
        buf_int(out, v);
    }
    buf_byte(out, b'\n');
    for j in 0..words.len() as i64 {
        buf_bytes(out, sym_text(words[j as usize], pcx));
        buf_byte(out, if j % 16 == 15 || j + 1 == words.len() as i64 { b'\n' } else { b' ' });
    }
    buf_bytes(out, buf_slice(body));
    crate::base::buf_write_fd(out, crate::base::STDOUT);
    if pcx.error_count > 0 { 1 } else { 0 }
}

// Symbol s's number among the index's words (the next, when it is new).
fn word_number(s: i64, number: &mut HMap, words: &mut Vec<i64, Comp>) -> i64 {
    let k = number.get(s + 1);
    if k > 0 {
        return k - 1;
    }
    words.push(s);
    number.put(s + 1, words.len() as i64);
    words.len() as i64 - 1
}

// $VOLE_STD2_EAGER=1 (front/stdtree.vl: std_tree_env).
pub fn set_eager(on: bool) {
    set_eager_value(on);
}

// The compilation is a build (main.vl: build), the only one read lazily.
pub fn set_build() {
    set_build_value(true);
}

// Whether the compilation is a build (set_build).
pub fn building() -> bool {
    get_build_value()
}

// How many of std2's tokens were dropped (0: std2 whole).
pub fn dropped() -> i64 {
    if get_norerun() { 0 } else { get_dropped() }
}

// A lazy build that has errors made again with std2 whole: this command
// line, with VOLE_STD2_EAGER=1, its output and exit status this run's
// (base/diag: exit_if_errors, before any error is written). The errors,
// their order, help and nearest names are then those of std2 read whole.
pub fn rerun_eager(nested: bool) -> ! {
    let mut words = Vec::<&[u8], Comp>::new_in(Comp {});
    for a in std::env::args_os() {
        words.push(a);
    }
    let mut cmd = std::process::Command::new_in(str::from_utf8(words[0]).unwrap(), Comp {});
    for k in 1..words.len() {
        cmd.arg(str::from_utf8(words[k]).unwrap());
    }
    // UNSAFE: the environment changed (std::env::set_var, Rust 2024's
    // unsafe fn), for the run made next to inherit it.
    // SAFETY: the checking that reports the errors is serial: no other
    // thread reads the environment now, and no view of it is used after.
    unsafe {
        // (0.28.0: the run made next is this command again, not a volec
        // inside one: it has this run's form, a terminal's, and its `ok:` line)
        if !nested {
            std::env::remove_var("VOLEC_NESTED");
        }
        std::env::set_var("VOLE_STD2_EAGER", "1");
    }
    let code = match cmd.status() {
        Ok(st) => match st.code() {
            Some(c) => c,
            None => 1,
        },
        Err(_) => 1i32,
    };
    if code == 0 {
        rerun_note(&mut cmd, &words);
    }
    std::process::exit(code)
}

// (0.28.0) $VOLE_STD2_RERUN_NOTE (tests/run.sh sets it): a lazy build that
// failed where the whole one passed is a miss of the lazy rules (a word of
// PRIM_WORDS, a seed), which costs every such build three or four times
// its work, silently. Then: a line on stderr, the lazy build's errors (the
// command once more, with VOLE_STD2_NORERUN=1), and, when the variable
// names a file (anything but `1`), the command line appended to it.
fn rerun_note(cmd: &mut std::process::Command<Comp>, words: &Vec<&[u8], Comp>) {
    let file = match std::env::var_in("VOLE_STD2_RERUN_NOTE", Comp {}) {
        Ok(p) => p,
        Err(_) => return,
    };
    if file.len() == 0 {
        return;
    }
    eprintln(
        "volec: note: the lazy std build failed and the build was made again with std whole, which passed: a word or a seed is missing (front/modules/std2lazy.vl); the lazy build's errors:",
    );
    // UNSAFE: the environment changed (std::env::set_var, remove_var), for
    // the run made next to inherit it.
    // SAFETY: as in rerun_eager: serial, and no view of it is used after.
    unsafe {
        std::env::remove_var("VOLE_STD2_EAGER");
        std::env::set_var("VOLE_STD2_NORERUN", "1");
    }
    let _ = cmd.status();
    if file.as_bytes() != b"1" {
        let b = buf_new();
        for k in 0..words.len() {
            if k > 0 {
                buf_byte(b, b' ');
            }
            buf_bytes(b, words[k]);
        }
        buf_byte(b, b'\n');
        let _ = std::fs::OpenOptions::new()
            .append(true)
            .create(true)
            .open(str::from_utf8(file.as_bytes()).unwrap())
            .and_then(|mut f| std::io::Write::write_all(&mut f, buf_slice(b).as_ref()));
    }
}

const K_CORE: i64 = 0;
const K_ITEM: i64 = 1;
const K_IMPL: i64 = 2;
const K_HEADER: i64 = 3;
const K_MEMBER: i64 = 4;
const K_USE: i64 = 5;
// an inherent impl's closing brace, kept with its header (parent)
const K_CLOSE: i64 = 6;
// a trait's required item (no default: a method without a body, an
// associated type or const), kept and read with its trait (parent)
const K_TREQ: i64 = 7;
// always kept, and read: an item of the tail's modules, an extern block,
// what is no item this split knows
const K_KEEP: i64 = 8;

// The units and their indexes.
struct Units<A: Allocator> {
    kind: Vec<i64, A>,
    start: Vec<i64, A>,
    end: Vec<i64, A>,
    // an item's or member's name, a header's closing brace; -1
    name: Vec<i64, A>,
    // a trait impl's trait; -1
    trait_of: Vec<i64, A>,
    // an impl's, header's or member's type head, -1 for any
    type_of: Vec<i64, A>,
    // a member's header
    parent: Vec<i64, A>,
    loaded: Vec<bool, A>,
    // the next unit in the list of its name (by_name, member_by_name), of
    // its trait (by_trait), of its type (by_type, member_by_type)
    next_name: Vec<i64, A>,
    next_type: Vec<i64, A>,
    next_trait: Vec<i64, A>,
    by_name: HMap,
    member_by_name: HMap,
    by_trait: HMap,
    by_type: HMap,
    member_by_type: HMap,
    // a std2 item's name
    item_name: HMap,
    // the names asked for, the items reached
    used: HMap,
    defined: HMap,
    // a `use` leaf's asks: (sym, next) pairs, listed by alias_head
    alias_head: HMap,
    alias_sym: Vec<i64, A>,
    alias_next: Vec<i64, A>,
    // a trait's item names: (trait, next) pairs, listed by method_head
    method_head: HMap,
    method_trait: Vec<i64, A>,
    method_next: Vec<i64, A>,
    words: Vec<i64, A>,
    todo: Vec<i64, A>,
    // RULE: Z5.2 (0.27.5) the units from the index (std2_units): the first
    // `nbytes`, their start and end SRC's bytes, not tokens; a unit's words
    // are the wend numbers at byte wstart of the index, each a word of
    // wlist, the index's words (wstart -1: its tokens are read); for the index's own
    // writing, each method_trait's name and each alias_sym's asker
    nbytes: i64,
    wstart: Vec<i64, A>,
    wend: Vec<i64, A>,
    wlist: Vec<i64, A>,
    method_name: Vec<i64, A>,
    alias_from: Vec<i64, A>,
    // RULE: Z5.2 (0.27.6) a unit of a gated module (GATED): the module's
    // name, else -1; the units waiting for it, listed by gate_head
    gate: Vec<i64, A>,
    gate_head: HMap,
    gate_next: Vec<i64, A>,
}

fn units_new() -> Units<Comp> {
    Units {
        kind: Vec::new_in(Comp {}), start: Vec::new_in(Comp {}), end: Vec::new_in(Comp {}),
        name: Vec::new_in(Comp {}), trait_of: Vec::new_in(Comp {}),
        type_of: Vec::new_in(Comp {}), parent: Vec::new_in(Comp {}),
        loaded: Vec::new_in(Comp {}), next_name: Vec::new_in(Comp {}),
        next_type: Vec::new_in(Comp {}), next_trait: Vec::new_in(Comp {}),
        by_name: hmap(), member_by_name: hmap(), by_trait: hmap(), by_type: hmap(),
        member_by_type: hmap(), item_name: hmap(), used: hmap(), defined: hmap(),
        alias_head: hmap(), alias_sym: Vec::new_in(Comp {}), alias_next: Vec::new_in(Comp {}),
        method_head: hmap(), method_trait: Vec::new_in(Comp {}), method_next: Vec::new_in(Comp {}),
        words: Vec::new_in(Comp {}), todo: Vec::new_in(Comp {}), nbytes: 0,
        wstart: Vec::new_in(Comp {}), wend: Vec::new_in(Comp {}), wlist: Vec::new_in(Comp {}),
        method_name: Vec::new_in(Comp {}), alias_from: Vec::new_in(Comp {}),
        gate: Vec::new_in(Comp {}), gate_head: hmap(), gate_next: Vec::new_in(Comp {}),
    }
}

fn hmap() -> HMap {
    HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 }
}

fn add_unit(u: &mut Units<Comp>, kind: i64, start: i64, end: i64, name: i64, tr: i64, ty: i64,
    parent: i64) -> i64 {
    let k = u.kind.len() as i64;
    u.kind.push(kind);
    u.start.push(start);
    u.end.push(end);
    u.name.push(name);
    u.trait_of.push(tr);
    u.type_of.push(ty);
    u.parent.push(parent);
    u.loaded.push(false);
    u.next_name.push(-1);
    u.next_type.push(-1);
    u.next_trait.push(-1);
    u.wstart.push(-1);
    u.wend.push(-1);
    u.gate.push(-1);
    u.gate_next.push(-1);
    if kind == K_ITEM && name >= 0 {
        u.next_name[k as usize] = u.by_name.get(name + 1) - 1;
        u.by_name.put(name + 1, k + 1);
        u.item_name.put(name + 1, 1);
    } else if kind == K_MEMBER && name >= 0 {
        u.next_name[k as usize] = u.member_by_name.get(name + 1) - 1;
        u.member_by_name.put(name + 1, k + 1);
        if ty >= 0 {
            u.next_type[k as usize] = u.member_by_type.get(ty + 1) - 1;
            u.member_by_type.put(ty + 1, k + 1);
        }
    } else if kind == K_IMPL {
        if tr >= 0 {
            u.next_trait[k as usize] = u.by_trait.get(tr + 1) - 1;
            u.by_trait.put(tr + 1, k + 1);
        }
        if ty >= 0 {
            u.next_type[k as usize] = u.by_type.get(ty + 1) - 1;
            u.by_type.put(ty + 1, k + 1);
        }
    }
    k
}

// Whether the read keeps every unit of std2.
fn eager(pcx: &Ctx<Comp>) -> bool {
    get_eager_value() || !get_build_value() || get_std2_first() < 0
        || !crate::front::known::on_std2(pcx) || pcx.query
        || pcx.std_tree != 0 as *mut u8 || pcx.std_always
        || crate::places::borrowck::std2::std2_check(pcx)
}

// After the program's files are lexed (front/modules: load_modules): std2's
// tokens that no reached unit has, dropped.
pub fn filter_std2(pcx: &mut Ctx<Comp>) {
    let by_index = get_text_start() >= 0;
    if !by_index && (eager(pcx) || get_dropped() != 0) {
        return;
    }
    let mut u = units_new();
    set_sym_async(intern(b"async", pcx));
    set_sym_default(intern(b"default", pcx));
    set_sym_dyn(intern(b"dyn", pcx));
    // RULE: Z5.2 (the text's units from the index, the tail's from its
    // tokens, STD2_FIRST..STD2_END)
    if by_index {
        read_index(&mut u, pcx);
    }
    split_units(&mut u, pcx);
    set_gates(&mut u, pcx);
    // the program's words, then the seeds; the primitives it names
    let mut prim_syms = Vec::<i64, Comp>::new_in(Comp {});
    for k in 0..PRIM_NAMES.len() {
        prim_syms.push(intern(PRIM_NAMES[k], pcx));
    }
    let mut word_syms = Vec::<i64, Comp>::new_in(Comp {});
    for k in 0..PRIM_WORDS.len() {
        word_syms.push(intern(PRIM_WORDS[k], pcx));
    }
    let tl_sym = intern(b"thread_local", pcx);
    let tls_sym = intern(b"__tls_addr", pcx);
    // (0.28.0) what the compiler calls for a word of the program: `assert`
    // with a message that has holes is __assert_fmt (check/format.vl), a
    // `main` that returns a Result ends in main_error (convert/try_main.vl)
    let assert_sym = intern(b"assert", pcx);
    let assert_fmt_sym = intern(b"__assert_fmt", pcx);
    let result_sym = intern(b"Result", pcx);
    let main_error_sym = intern(b"main_error", pcx);
    let detect_sym = intern(b"detect", pcx);
    let multiversion_sym = intern(b"multiversion", pcx);
    let x86 = crate::base::target::get_x86();
    let elf = crate::base::target::get_elf();
    let arch_init_sym = intern(if x86 { b"arch_init_x86" } else if elf { b"arch_init_linux" }
        else { b"arch_init_macos" }, pcx);
    let arch_word_sym = intern(if x86 { b"arch_word_x86" } else if elf { b"arch_word_linux" }
        else { b"arch_word_macos" }, pcx);
    for i in 0..pcx.toks.len() as i64 {
        if i >= get_std2_first() && i < get_std2_end() {
            continue;
        }
        let kind = pcx.toks[i as usize].kind;
        if kind == Tok::Ident {
            let s = pcx.toks[i as usize].value as i64;
            ask(&mut u, s);
            if s == tl_sym {
                // (0.28.0) a `#[thread_local]` static's every access is a
                // call of std::thread::__tls_addr (front/threadlocal.vl),
                // which no source names
                ask(&mut u, tls_sym);
            }
            if s == assert_sym {
                ask(&mut u, assert_fmt_sym);
            }
            if s == result_sym {
                ask(&mut u, main_error_sym);
            }
            if s == detect_sym || s == multiversion_sym {
                // (0.28.0) std::arch::detect and `#[multiversion]` test the
                // run-time feature word, which the target system's
                // functions at std's root fill and read (std.vl:
                // arch_init_*, arch_word_*): the back ends call them
                // (back/isel/arch.vl), and no source names them
                ask(&mut u, arch_init_sym);
                ask(&mut u, arch_word_sym);
            }
            for k in 0..prim_syms.len() {
                if prim_syms[k] == s {
                    set_prims_named(get_prims_named() | (1 << k as i64));
                }
            }
            for k in 0..word_syms.len() {
                if word_syms[k] == s {
                    set_prims_named(get_prims_named() | PRIM_WORD_BITS[k]);
                }
            }
        } else if (kind == Tok::Int || kind == Tok::Float) && pcx.toks[i as usize].suffix > 0
            && pcx.toks[i as usize].suffix <= 12 {
            // (SUF_I8..SUF_F64 are PRIM_NAMES' first twelve, in order)
            set_prims_named(get_prims_named() | (1 << (pcx.toks[i as usize].suffix - 1)));
        } else if kind == Tok::Char {
            // (a char literal: its u32)
            set_prims_named(get_prims_named() | (1 << 7));
        } else if kind == Tok::Float {
            // (an unsuffixed float is an f64)
            set_prims_named(get_prims_named() | (1 << 11));
        }
    }
    // (a float's formatting and bits, std2's flt and fmath: u64, i64, u32)
    if (get_prims_named() & (3 << 10)) != 0 {
        set_prims_named(get_prims_named() | ((1 << 8) | (1 << 3) | (1 << 7)));
    }
    set_prims_read(true);
    // (0.28.0) the float seeds only for a program with a float: the text
    // that names them is the builtin impls of f32 and f64 (Display,
    // LowerExp, FromStr), made only then (prim_wanted); std2/flt.vl is a
    // tenth of what a hello-world kept
    let floats = (get_prims_named() & (3 << 10)) != 0;
    for k in 0..SEEDS.len() {
        if !floats && (SEEDS[k] == b"fmt_float" || SEEDS[k] == b"parse_float"
            || SEEDS[k] == b"ParseFloatError") {
            continue;
        }
        ask(&mut u, intern(SEEDS[k], pcx));
    }
    for k in 0..crate::front::known::known_count() {
        ask(&mut u, intern(crate::front::known::known_name(k), pcx));
    }
    let n = u.kind.len() as i64;
    for k in 0..n {
        if u.kind[k as usize] == K_CORE || u.kind[k as usize] == K_USE
            || u.kind[k as usize] == K_KEEP {
            load(&mut u, k);
        } else if u.kind[k as usize] == K_IMPL && !trait_reachable(&u, k) && type_reached(&u, k) {
            // (a trait std2 does not define)
            load(&mut u, k);
        }
    }
    reach(&mut u, pcx);
    if by_index {
        if eager(pcx) {
            for k in 0..n {
                u.loaded[k as usize] = true;
            }
        }
        lex_units(&u, pcx);
        set_deferred(false);
        crate::front::modules::std2_inline_modules(get_std2_first(), get_std2_end(), pcx);
        dump_std2(pcx);
        return;
    }
    // the tokens kept, in their order (the units are)
    let mut w = get_std2_first();
    for k in 0..n {
        if !u.loaded[k as usize]
            && !(u.kind[k as usize] == K_CLOSE && u.loaded[u.parent[k as usize] as usize]) {
            continue;
        }
        for r in u.start[k as usize]..u.end[k as usize] {
            if w != r {
                pcx.toks[w as usize] = pcx.toks[r as usize];
            }
            w += 1;
        }
    }
    let total = pcx.toks.len() as i64;
    for r in get_std2_end()..total {
        pcx.toks[w as usize] = pcx.toks[r as usize];
        w += 1;
    }
    set_dropped(total - w);
    pcx.toks.truncate(w as usize);
    set_std2_end(get_std2_end() - (get_dropped()));
    dump_std2(pcx);
}

// Whether unit k is kept: reached, or the closing brace of a header that is.
fn kept(u: &Units<Comp>, k: i64) -> bool {
    u.loaded[k as usize] || u.kind[k as usize] == K_CLOSE && u.loaded[u.parent[k as usize] as usize]
}

// RULE: Z5.2 The kept units of the index lexed, each run of them in one
// lex_span, then the tail's kept tokens: appended after the tokens, with
// the other files' tokens after them, and the whole moved to STD2_FIRST.
fn lex_units(u: &Units<Comp>, pcx: &mut Ctx<Comp>) {
    let total = pcx.toks.len() as i64;
    let n = u.kind.len() as i64;
    let mut dropped: i64 = 0;
    let mut k: i64 = 0;
    while k < u.nbytes {
        if !kept(u, k) {
            dropped += 1;
            k += 1;
            continue;
        }
        let mut j = k;
        while j + 1 < u.nbytes && kept(u, j + 1) {
            j += 1;
        }
        crate::front::lexer::lex_span(u.start[k as usize], u.end[j as usize], get_text_end(), pcx);
        k = j + 1;
    }
    for t in u.nbytes..n {
        if !kept(u, t) {
            dropped += u.end[t as usize] - u.start[t as usize];
            continue;
        }
        for r in u.start[t as usize]..u.end[t as usize] {
            let tok = pcx.toks[r as usize];
            pcx.toks.push(tok);
        }
    }
    let std2_end = pcx.toks.len() as i64;
    for r in get_std2_end()..total {
        let tok = pcx.toks[r as usize];
        pcx.toks.push(tok);
    }
    let made = pcx.toks.len() as i64 - total;
    for i in 0..made {
        pcx.toks[(get_std2_first() + i) as usize] = pcx.toks[(total + i) as usize];
    }
    pcx.toks.truncate((get_std2_first() + made) as usize);
    set_std2_end(get_std2_first() + std2_end - total);
    set_dropped(dropped);
}

// RULE: Z5.2 $VOLE_STD2_DUMP=FILE: std2's tokens as the read keeps them, a
// line each (its kind, bytes, joint and suffix, and an identifier's or a
// lifetime's name or a number's value), for the test that compares the
// index's read with the tokens' (tests/std/units.sh).
fn dump_std2(pcx: &Ctx<Comp>) {
    if get_dump() == 0 as *mut u8 {
        return;
    }
    let b = buf_new();
    buf_bytes(b, if get_text_start() >= 0 { b"by-index\n" } else { b"by-tokens\n" });
    for i in get_std2_first()..get_std2_end() {
        let t = pcx.toks[i as usize];
        buf_int(b, t.kind as i64);
        buf_byte(b, b' ');
        buf_int(b, t.start);
        buf_byte(b, b' ');
        buf_int(b, t.end);
        buf_byte(b, b' ');
        buf_int(b, if t.joint { 1 } else { 0 });
        if t.kind == Tok::Ident || t.kind == Tok::Reserved || t.kind == Tok::Lifetime {
            buf_byte(b, b' ');
            buf_bytes(b, sym_text(t.value as i64, pcx));
        } else if t.kind == Tok::Int || t.kind == Tok::Float || t.kind == Tok::Char {
            buf_byte(b, b' ');
            buf_uint(b, t.value);
            buf_byte(b, b' ');
            buf_int(b, t.suffix);
        }
        buf_byte(b, b'\n');
    }
    crate::base::buf_write_file(b, get_dump());
}

// Name s asked for.
fn ask(u: &mut Units<Comp>, s: i64) {
    if u.used.get(s + 1) != 0 {
        return;
    }
    u.used.put(s + 1, 1);
    u.words.push(s);
    // RULE: Z5.2 (0.27.6: a gated module's name asked: its waiting units)
    let mut k = u.gate_head.get(s + 1) - 1;
    u.gate_head.put(s + 1, 0);
    while k >= 0 {
        let next = u.gate_next[k as usize];
        u.gate_next[k as usize] = -1;
        load(u, k);
        k = if next == -2 { -1 } else { next };
    }
}

fn load(u: &mut Units<Comp>, k: i64) {
    if u.loaded[k as usize] {
        return;
    }
    // RULE: Z5.2 (0.27.6: a gated module's unit waits for its name)
    let g = u.gate[k as usize];
    if g >= 0 && u.used.get(g + 1) == 0 {
        if u.gate_next[k as usize] == -1 {
            let h = u.gate_head.get(g + 1) - 1;
            u.gate_next[k as usize] = if h >= 0 { h } else { -2 };
            u.gate_head.put(g + 1, k + 1);
        }
        return;
    }
    u.loaded[k as usize] = true;
    u.todo.push(k);
}

// RULE: Z5.2 (0.27.6) The modules of std2 a build reads only when its
// program, or a unit it reaches, names them: std::gpu (the WGSL front,
// 7k lines whose common names, `Type`, `Module`, `Entry`, `check`, would
// otherwise be reached by name from any program) and (0.28.0) std::sys
// (the OS layer: its sixty extern blocks, which are always kept, cost
// every hello-world 5 M instructions), and std::fs, std::test,
// std::process and std::env (extern blocks, statics and names as common
// as `open`, `read`, `close`, `args`: 8 thousand tokens of a hello-world,
// 14 M instructions); std::collections (a `struct Iter` or `IntoIter`
// brought the hash table in by name) and std::unicode (its tables and
// names as common as `width`, `graphemes`, `props`): 8 M more. What a
// module that is always read needs of a gated one names it in a body
// (`crate::unicode::is_alphabetic(c)`), not only in a `use` line, whose
// words are not asked: TryReserveError is defined in std::alloc for that.
const GATED: [&[u8]; 10] = [b"gpu", b"sys", b"fs", b"test", b"process", b"env", b"objc", b"window",
    b"collections", b"unicode"];

// The gate of each unit: the name of the top module of std2 it is in,
// when that module is GATED (its own `mod` lines and braces excepted).
fn set_gates(u: &mut Units<Comp>, pcx: &mut Ctx<Comp>) {
    let mut stack = Vec::<i64, Comp>::new_in(Comp {});
    let mut gated = Vec::<i64, Comp>::new_in(Comp {});
    for k in 0..GATED.len() {
        gated.push(intern(GATED[k], pcx));
    }
    let n = u.kind.len() as i64;
    for k in 0..n {
        if u.kind[k as usize] != K_CORE {
            if stack.len() > 0 {
                let top = stack[0];
                for g in 0..gated.len() {
                    if gated[g] == top {
                        u.gate[k as usize] = top;
                    }
                }
            }
            continue;
        }
        // (a module's `mod NAME {` line pushes it, its `}` pops it)
        let bs = if k < u.nbytes { u.start[k as usize] }
            else { pcx.toks[u.start[k as usize] as usize].start };
        let be = if k < u.nbytes { u.end[k as usize] }
            else { pcx.toks[(u.end[k as usize] - 1) as usize].end };
        let mut a = bs;
        let mut b = be;
        while a < b
            && (get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\n'
                || get_src()[a as usize] == b'\t') {
            a += 1;
        }
        while b > a
            && (get_src()[(b - 1) as usize] == b' ' || get_src()[(b - 1) as usize] == b'\n'
                || get_src()[(b - 1) as usize] == b'\t') {
            b -= 1;
        }
        if b == a + 1 && get_src()[a as usize] == b'}' {
            if stack.len() > 0 {
                stack.pop();
            }
        } else if b > a && get_src()[(b - 1) as usize] == b'{' {
            let mut m = b - 1;
            while m > a + 3
                && !(get_src()[(m - 4) as usize] == b'm' && get_src()[(m - 3) as usize] == b'o'
                    && get_src()[(m - 2) as usize] == b'd' && get_src()[(m - 1) as usize] == b' ') {
                m -= 1;
            }
            let mut e = m;
            while e < b - 1 && get_src()[e as usize] != b' ' && get_src()[e as usize] != b'{' {
                e += 1;
            }
            stack.push(if m > a + 3 { intern(&get_src()[m as usize..e as usize], pcx) }
                else { -1 });
        }
    }
}

// Whether a unit's type is reached, or is no item of std2 (any type).
fn type_reached(u: &Units<Comp>, k: i64) -> bool {
    let ty = u.type_of[k as usize];
    ty < 0 || u.item_name.get(ty + 1) == 0 || u.defined.get(ty + 1) != 0
}

// Whether a trait impl's trait is one of std2's items.
fn trait_reachable(u: &Units<Comp>, k: i64) -> bool {
    u.trait_of[k as usize] >= 0 && u.item_name.get(u.trait_of[k as usize] + 1) != 0
}

fn trait_reached(u: &Units<Comp>, k: i64) -> bool {
    !trait_reachable(u, k) || u.defined.get(u.trait_of[k as usize] + 1) != 0
}

// The names asked for and the units loaded, until neither grows.
fn reach(u: &mut Units<Comp>, pcx: &Ctx<Comp>) {
    loop {
        if u.words.len() > 0 {
            let s = u.words.pop().unwrap();
            let mut k = u.by_name.get(s + 1) - 1;
            while k >= 0 {
                load(u, k);
                k = u.next_name[k as usize];
            }
            k = u.member_by_name.get(s + 1) - 1;
            while k >= 0 {
                if type_reached(u, k) {
                    load(u, k);
                }
                k = u.next_name[k as usize];
            }
            // (a method call names its trait by the method alone)
            let mut m = u.method_head.get(s + 1) - 1;
            while m >= 0 {
                load(u, u.method_trait[m as usize]);
                m = u.method_next[m as usize];
            }
            let mut a = u.alias_head.get(s + 1) - 1;
            while a >= 0 {
                ask(u, u.alias_sym[a as usize]);
                a = u.alias_next[a as usize];
            }
        } else if u.todo.len() > 0 {
            let k = u.todo.pop().unwrap();
            let kind = u.kind[k as usize];
            if kind == K_MEMBER {
                load(u, u.parent[k as usize]);
            }
            if kind == K_ITEM {
                // (a trait's required items, after it)
                let mut j = k + 1;
                while j < u.kind.len() as i64 && u.parent[j as usize] == k {
                    if u.kind[j as usize] == K_TREQ {
                        load(u, j);
                    }
                    j += 1;
                }
            }
            if u.wstart[k as usize] >= 0 {
                // (the index's unit: its words, read from its line now)
                let s = buf_slice(get_index_buf());
                let mut at = u.wstart[k as usize];
                for _ in 0..u.wend[k as usize] {
                    let w = u.wlist[index_num(s, &mut at) as usize];
                    ask(u, w);
                }
            } else if asks_words(kind) {
                for t in u.start[k as usize]..u.end[k as usize] {
                    if pcx.toks[t as usize].kind == Tok::Ident {
                        ask(u, pcx.toks[t as usize].value as i64);
                    }
                }
            }
            if kind == K_ITEM && u.name[k as usize] >= 0 {
                define(u, u.name[k as usize]);
            }
        } else {
            return;
        }
    }
}

// Whether a unit of this kind asks for the words it holds.
fn asks_words(kind: i64) -> bool {
    kind == K_ITEM || kind == K_IMPL || kind == K_HEADER || kind == K_MEMBER || kind == K_TREQ
        || kind == K_KEEP
}

// Item name n reached: the impls and methods that waited on it.
fn define(u: &mut Units<Comp>, n: i64) {
    if u.defined.get(n + 1) != 0 {
        return;
    }
    u.defined.put(n + 1, 1);
    let mut k = u.by_trait.get(n + 1) - 1;
    while k >= 0 {
        if type_reached(u, k) {
            load(u, k);
        }
        k = u.next_trait[k as usize];
    }
    k = u.by_type.get(n + 1) - 1;
    while k >= 0 {
        if trait_reached(u, k) {
            load(u, k);
        }
        k = u.next_type[k as usize];
    }
    k = u.member_by_type.get(n + 1) - 1;
    while k >= 0 {
        if u.used.get(u.name[k as usize] + 1) != 0 {
            load(u, k);
        }
        k = u.next_type[k as usize];
    }
}

// ---- Splitting std2's tokens into units ----

fn kind_at(t: i64, pcx: &Ctx<Comp>) -> Tok {
    if t < get_std2_end() { pcx.toks[t as usize].kind } else { Tok::Eof }
}

// The symbols of `async`, `default` and `dyn` (filter_std2 interns them).
static SYM_ASYNC: Atomic<i64> = Atomic::new(-1);
static SYM_DEFAULT: Atomic<i64> = Atomic::new(-1);
static SYM_DYN: Atomic<i64> = Atomic::new(-1);

fn is_word(t: i64, sym: i64, pcx: &Ctx<Comp>) -> bool {
    kind_at(t, pcx) == Tok::Ident && pcx.toks[t as usize].value as i64 == sym
}

// The token after the bracketed group opening at t (`(..)`, `[..]`, `{..}`).
fn after_group(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut i = t;
    while i < get_std2_end() {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::LParen || k == Tok::LBracket || k == Tok::LBrace {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket || k == Tok::RBrace {
            depth -= 1;
            if depth == 0 {
                return i + 1;
            }
        }
        i += 1;
    }
    get_std2_end()
}

// The token after an item's attributes, visibility and qualifiers.
fn item_keyword(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = t;
    loop {
        let k = kind_at(i, pcx);
        if k == Tok::Hash && kind_at(i + 1, pcx) == Tok::LBracket {
            i = after_group(i + 1, pcx);
        } else if k == Tok::Hash && kind_at(i + 1, pcx) == Tok::Bang
            && kind_at(i + 2, pcx) == Tok::LBracket {
            i = after_group(i + 2, pcx);
        } else if k == Tok::Pub {
            i += 1;
            if kind_at(i, pcx) == Tok::LParen {
                i = after_group(i, pcx);
            }
        } else if k == Tok::Unsafe || (k == Tok::Const && kind_at(i + 1, pcx) == Tok::Fn)
            || (k == Tok::Const && kind_at(i + 1, pcx) == Tok::Unsafe)
            || is_word(i, get_sym_async(), pcx) || is_word(i, get_sym_default(), pcx)
            && kind_at(i + 1, pcx) == Tok::Fn {
            i += 1;
        } else if k == Tok::Extern && kind_at(i + 1, pcx) == Tok::Str
            && kind_at(i + 2, pcx) != Tok::LBrace {
            i += 2;
        } else {
            return i;
        }
    }
}

// The end of the item whose keyword is at t: after its `;` (one that ends
// it at its own depth) or its body's `}`.
fn item_end(t: i64, semi_only: bool, pcx: &Ctx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut i = t;
    while i < get_std2_end() {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::LParen || k == Tok::LBracket || k == Tok::LBrace {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket || k == Tok::RBrace {
            depth -= 1;
            if depth == 0 && k == Tok::RBrace && !semi_only {
                return i + 1;
            }
            if depth < 0 {
                return i;
            }
        } else if k == Tok::Semi && depth == 0 {
            return i + 1;
        }
        i += 1;
    }
    get_std2_end()
}

// The next identifier at or after t (an item's name), or -1.
fn name_at(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = t;
    if kind_at(i, pcx) == Tok::Mut {
        i += 1;
    }
    if kind_at(i, pcx) == Tok::Ident { pcx.toks[i as usize].value as i64 } else { -1 }
}

// The token after a generic list `<..>` opening at t (or t).
fn after_generics(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if kind_at(t, pcx) != Tok::Lt {
        return t;
    }
    let mut depth: i64 = 0;
    let mut i = t;
    while i < get_std2_end() {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::Lt {
            depth += 1;
        } else if k == Tok::Gt {
            depth -= 1;
        } else if k == Tok::Shr {
            depth -= 2;
        }
        i += 1;
        if depth <= 0 {
            return i;
        }
    }
    get_std2_end()
}

// The head of the type or trait path at t (`crate::vec::Vec<T>`: Vec), or
// -1 for a type that names no item (`&T` is T's head; `[T]`, `(A, B)`,
// `*const T`, `dyn Tr`, `fn(..)`: -1).
fn head_at(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = t;
    while kind_at(i, pcx) == Tok::Amp || kind_at(i, pcx) == Tok::AmpAmp
        || kind_at(i, pcx) == Tok::Lifetime || kind_at(i, pcx) == Tok::Mut
        || kind_at(i, pcx) == Tok::Bang {
        i += 1;
    }
    if kind_at(i, pcx) != Tok::Ident || is_word(i, get_sym_dyn(), pcx) {
        return -1;
    }
    let mut head = pcx.toks[i as usize].value as i64;
    while kind_at(i + 1, pcx) == Tok::ColonColon && kind_at(i + 2, pcx) == Tok::Ident {
        i += 2;
        head = pcx.toks[i as usize].value as i64;
    }
    head
}

// An impl at keyword t, ending at end: a trait impl (its unit), or an
// inherent one split into its header, its members and its closing brace.
fn split_impl(u: &mut Units<Comp>, s: i64, t: i64, end: i64, pcx: &Ctx<Comp>) {
    let after = after_generics(t + 1, pcx);
    // ` for ` outside brackets and generics, before the body
    let mut depth: i64 = 0;
    let mut angles: i64 = 0;
    let mut i = after;
    let mut body: i64 = -1;
    let mut for_at: i64 = -1;
    while i < end {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::LBrace && depth == 0 && angles <= 0 {
            body = i;
            break;
        }
        if k == Tok::LParen || k == Tok::LBracket {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket {
            depth -= 1;
        } else if k == Tok::Lt {
            angles += 1;
        } else if k == Tok::Gt {
            angles -= 1;
        } else if k == Tok::Shr {
            angles -= 2;
        } else if k == Tok::For && depth == 0 && angles <= 0 && kind_at(i + 1, pcx) != Tok::Lt
            && for_at < 0 {
            for_at = i;
        }
        i += 1;
    }
    if body < 0 {
        add_unit(u, K_ITEM, s, end, -1, -1, -1, -1);
        return;
    }
    if for_at >= 0 {
        // the trait's head: the last identifier at depth 0 before ` for `
        let mut tr: i64 = -1;
        let mut j = after;
        let mut a: i64 = 0;
        while j < for_at {
            let k = pcx.toks[j as usize].kind;
            if k == Tok::Lt {
                a += 1;
            } else if k == Tok::Gt {
                a -= 1;
            } else if k == Tok::Shr {
                a -= 2;
            } else if k == Tok::Ident && a <= 0 {
                tr = pcx.toks[j as usize].value as i64;
            }
            j += 1;
        }
        add_unit(u, K_IMPL, s, end, -1, tr, head_at(for_at + 1, pcx), -1);
        return;
    }
    let ty = head_at(after, pcx);
    // the members: each a unit, unless one is no fn, const or type
    let mut members = Vec::<i64, Comp>::new_in(Comp {});
    let mut m = body + 1;
    while m < end - 1 {
        let kw = item_keyword(m, pcx);
        let k = kind_at(kw, pcx);
        if k != Tok::Fn && k != Tok::Const && k != Tok::Type {
            add_unit(u, K_ITEM, s, end, -1, -1, -1, -1);
            return;
        }
        let e = item_end(kw, k != Tok::Fn, pcx);
        members.push(m);
        members.push(e);
        members.push(name_at(kw + 1, pcx));
        m = e;
    }
    let header = add_unit(u, K_HEADER, s, body + 1, -1, -1, ty, -1);
    let mut j: i64 = 0;
    while j < members.len() as i64 {
        add_unit(u, K_MEMBER, members[j as usize], members[(j + 1) as usize],
            members[(j + 2) as usize], -1, ty, header);
        j += 3;
    }
    add_unit(u, K_CLOSE, end - 1, end, -1, -1, -1, header);
}

// A trait at keyword t, ending at end: its header (the item: its name,
// supertraits, `where` and the brace) with its required items, each
// default method a member of the trait's name, and its closing brace.
fn split_trait(u: &mut Units<Comp>, s: i64, t: i64, end: i64, pcx: &Ctx<Comp>) {
    let name = name_at(t + 1, pcx);
    let mut depth: i64 = 0;
    let mut i = t;
    let mut body: i64 = -1;
    while i < end {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::LBrace && depth == 0 {
            body = i;
            break;
        }
        if k == Tok::LParen || k == Tok::LBracket {
            depth += 1;
        } else if k == Tok::RParen || k == Tok::RBracket {
            depth -= 1;
        }
        i += 1;
    }
    if body < 0 || name < 0 {
        add_unit(u, K_ITEM, s, end, name, -1, -1, -1);
        return;
    }
    // the members: (start, end, kind) each, or the trait whole
    let mut members = Vec::<i64, Comp>::new_in(Comp {});
    let mut m = body + 1;
    while m < end - 1 {
        let kw = item_keyword(m, pcx);
        let k = kind_at(kw, pcx);
        if k != Tok::Fn && k != Tok::Const && k != Tok::Type {
            add_unit(u, K_ITEM, s, end, name, -1, -1, -1);
            return;
        }
        let e = item_end(kw, k != Tok::Fn, pcx);
        let has_body = k == Tok::Fn && e > kw && pcx.toks[(e - 1) as usize].kind == Tok::RBrace;
        members.push(m);
        members.push(e);
        members.push(name_at(kw + 1, pcx));
        members.push(if has_body { 1 } else { 0 });
        m = e;
    }
    let header = add_unit(u, K_ITEM, s, body + 1, name, -1, -1, -1);
    let mut j: i64 = 0;
    while j < members.len() as i64 {
        if members[(j + 3) as usize] != 0 {
            add_unit(u, K_MEMBER, members[j as usize], members[(j + 1) as usize],
                members[(j + 2) as usize], -1, name, header);
        } else {
            add_unit(u, K_TREQ, members[j as usize], members[(j + 1) as usize], -1, -1, -1, header);
        }
        if members[(j + 2) as usize] >= 0 {
            add_method(u, members[(j + 2) as usize], header);
        }
        j += 4;
    }
    add_unit(u, K_CLOSE, end - 1, end, -1, -1, -1, header);
}

// A `use` item s..end: each leaf asks for the capitalized segments before
// it, and an `as` rename for what it renames.
fn split_use(u: &mut Units<Comp>, s: i64, end: i64, pcx: &Ctx<Comp>) {
    add_unit(u, K_USE, s, end, -1, -1, -1, -1);
    // the capitalized prefix segments, by brace depth
    let mut prefix = Vec::<i64, Comp>::new_in(Comp {});
    let mut marks = Vec::<i64, Comp>::new_in(Comp {});
    let mut i = s;
    while i < end {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::LBrace {
            marks.push(prefix.len() as i64);
        } else if k == Tok::RBrace || k == Tok::Comma {
            // a leaf's own segments end with it
            let keep: i64 = if marks.len() > 0 { marks[marks.len() - 1] } else { 0 };
            if k == Tok::RBrace && marks.len() > 0 {
                marks.pop();
            }
            while prefix.len() as i64 > keep {
                prefix.pop();
            }
        } else if k == Tok::Ident {
            let sym = pcx.toks[i as usize].value as i64;
            let next = kind_at(i + 1, pcx);
            if next == Tok::ColonColon {
                let text = sym_text(sym, pcx);
                if text.len() > 0 && text[0] >= b'A' && text[0] <= b'Z' {
                    prefix.push(sym);
                }
            } else if next == Tok::As && kind_at(i + 2, pcx) == Tok::Ident {
                let alias = pcx.toks[(i + 2) as usize].value as i64;
                add_ask(u, alias, sym);
                for p in 0..prefix.len() as i64 {
                    add_ask(u, alias, prefix[p as usize]);
                }
                i += 2;
            } else {
                for p in 0..prefix.len() as i64 {
                    add_ask(u, sym, prefix[p as usize]);
                }
            }
        }
        i += 1;
    }
}

// Trait item name m of the trait whose header is unit header.
fn add_method(u: &mut Units<Comp>, m: i64, header: i64) {
    let k = u.method_trait.len() as i64;
    u.method_trait.push(header);
    u.method_name.push(m);
    u.method_next.push(u.method_head.get(m + 1) - 1);
    u.method_head.put(m + 1, k + 1);
}

// Name a asks for name b.
fn add_ask(u: &mut Units<Comp>, a: i64, b: i64) {
    let k = u.alias_sym.len() as i64;
    u.alias_sym.push(b);
    u.alias_from.push(a);
    u.alias_next.push(u.alias_head.get(a + 1) - 1);
    u.alias_head.put(a + 1, k + 1);
}

// std2's tokens as units: modules' lines and closing braces, then items.
fn split_units(u: &mut Units<Comp>, pcx: &Ctx<Comp>) {
    // (the module stack's tail flags: inside a `__` module, every unit kept)
    let mut tails = Vec::<bool, Comp>::new_in(Comp {});
    let mut t = get_std2_first();
    while t < get_std2_end() {
        let k0 = pcx.toks[t as usize].kind;
        if k0 == Tok::RBrace {
            add_unit(u, K_CORE, t, t + 1, -1, -1, -1, -1);
            if tails.len() > 0 {
                tails.pop();
            }
            t += 1;
            continue;
        }
        if k0 == Tok::Semi {
            add_unit(u, K_CORE, t, t + 1, -1, -1, -1, -1);
            t += 1;
            continue;
        }
        let kw = item_keyword(t, pcx);
        let k = kind_at(kw, pcx);
        let in_tail = tails.len() > 0 && tails[tails.len() - 1];
        if k == Tok::Mod && kind_at(kw + 1, pcx) == Tok::Ident
            && kind_at(kw + 2, pcx) == Tok::LBrace {
            let name = sym_text(pcx.toks[(kw + 1) as usize].value as i64, pcx);
            tails.push(in_tail || name.len() >= 2 && name[0] == b'_' && name[1] == b'_');
            add_unit(u, K_CORE, t, kw + 3, -1, -1, -1, -1);
            t = kw + 3;
            continue;
        }
        let semi = k == Tok::Use || k == Tok::Const || k == Tok::Static || k == Tok::Type;
        let end = item_end(kw, semi, pcx);
        if end <= t {
            // (no item here: the rest kept)
            add_unit(u, K_CORE, t, get_std2_end(), -1, -1, -1, -1);
            return;
        }
        if k == Tok::Mod {
            add_unit(u, K_CORE, t, end, -1, -1, -1, -1);
        } else if in_tail || k == Tok::Extern {
            add_unit(u, K_KEEP, t, end, -1, -1, -1, -1);
        } else if k == Tok::Use {
            split_use(u, t, end, pcx);
        } else if k == Tok::Impl {
            split_impl(u, t, kw, end, pcx);
        } else if k == Tok::Trait {
            split_trait(u, t, kw, end, pcx);
        } else if k == Tok::Fn || k == Tok::Struct || k == Tok::Enum || k == Tok::Union
            || k == Tok::Trait || k == Tok::Type || k == Tok::Const || k == Tok::Static {
            add_unit(u, K_ITEM, t, end, name_at(kw + 1, pcx), -1, -1, -1);
        } else {
            add_unit(u, K_KEEP, t, end, -1, -1, -1, -1);
        }
        t = end;
    }
}

// The names the compiler itself names in std2 with no token of a source
// naming them, besides the known items (front/known.vl, Z3.1): the
// methods its lowerings call (front/traits.vl's LOWERED_METHODS) and the
// names the text it makes calls or names (front/builtin_impls.vl, the
// derives, check/interp.vl and format.vl, stdalloc.vl, check/iterate.vl,
// try_op.vl, rust.vl, convert/try_main.vl, places/shim.vl,
// contracts/desugar.vl). One missed is an error, and the build is made
// again with std2 whole (rerun_eager): slower, not wrong.
const SEEDS: [&[u8]; 130] = [
    b"Error", b"FromStr", b"IntErrorKind", b"Item", b"MAX", b"Output", b"ParseBoolError",
    b"ParseFloatError", b"ParseIntError", b"Product", b"Target", b"Write", b"__spec", b"add",
    b"add_assign", b"bitand", b"bitand_assign", b"bitor", b"bitor_assign", b"bitxor",
    b"bitxor_assign", b"div", b"div_assign", b"mul", b"mul_assign", b"neg", b"not", b"rem",
    b"rem_assign", b"shl", b"shl_assign", b"shr", b"shr_assign", b"sub", b"sub_assign", b"eq",
    b"ne", b"lt", b"le", b"gt", b"ge", b"cmp", b"partial_cmp", b"clone", b"default", b"hash",
    b"fmt", b"display", b"debug", b"pad", b"pad_integral", b"fmt_float", b"fmt_int_exp",
    b"parse_float", b"parse_bool", b"from_str", b"from_utf8", b"from_utf8_unchecked",
    b"forward_checked", b"backward_checked", b"steps_between", b"sum", b"product", b"write_str",
    b"write_char", b"write_u8", b"write_u16", b"write_u32", b"write_u64", b"write_u128",
    b"write_usize", b"write_i8", b"write_i16", b"write_i32", b"write_i64", b"write_i128",
    b"write_isize", b"write_fmt", b"write_all", b"mul_hi", b"rotate_left", b"rotate_right",
    b"is_char_boundary", b"as_bytes", b"as_str", b"as_slice", b"as_mut_slice", b"as_path", b"len",
    b"debug_struct", b"debug_tuple", b"field", b"finish", b"new", b"new_in", b"spec", b"width",
    b"precision", b"fill", b"stdout", b"stderr", b"print", b"println", b"eprint", b"eprintln",
    b"format_in", b"format_args", b"write", b"writeln", b"into_iter", b"next", b"iter", b"ok_or",
    b"map_err", b"from", b"into", b"deref", b"deref_mut", b"index", b"index_mut", b"borrow",
    b"drop", b"drop_in_place", b"assert", b"assert_eq", b"assert_ne", b"debug_assert",
    b"contract_check", b"unreachable", b"panic"];

use std::sync::atomic::{Atomic, Ordering};

// (0.28.0) STD2_FIRST's accessors: every use of it is one of them.
// Atomic, Relaxed: only the main thread reads and writes it (no function a
// worker or the assembler thread runs touches it), so Relaxed orders
// nothing else.
fn get_std2_first() -> i64 {
    STD2_FIRST.load(Ordering::Relaxed)
}

fn set_std2_first(v: i64) {
    STD2_FIRST.store(v, Ordering::Relaxed);
}

