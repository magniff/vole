// View summaries inferred (0.17, docs/design/value-semantics.md §2.4, §4
// step 2): the own pass's driver, the type filter, the collection of a
// walk's summary, indirect calls and the why-chains.
//
// The driver (infer_summaries) walks the functions callees first, in the
// order of the effects' strongly connected components (front/effects/
// infer.vl: Tarjan numbers a component when it completes, so a callee's
// number is below its callers'). A function that is not recursive is
// walked once; its summary is known before any caller is walked. A
// recursive component whose members have view-carrying summaries starts
// every member from its parametric floor (views() for a non-generic one)
// and walks them all until no summary grows (the masks only grow: each
// round joins the old summary and the new); its findings are those of one
// more walk, after the last round (own_flush only then).
//
// The type filter (§2.4): a level whose views are of type E points only
// into storage that can hold an E. holds(T, E): T's own storage (fields,
// elements, a Vec's or a HashMap's buffer; not through a view) can hold an
// E; deep(T, E): what T's views point to can (at any depth). A parameter's
// `p` is its referent (`&T`: holds(T, E)) or what its views point into (by
// value: a view of X in it, holds(X, E)); its `*p` is deeper (deep). A
// result whose type holds no views of views (no K_LEVEL2) has no level 2.
//
// Indirect calls (§2.4): a call through a fn value has the join of the
// summaries of every function of that type whose address the program takes
// (ADDRESS_TAKEN, as the effects use it). The effects graph has a virtual
// node per such type with edges to those functions, so they are summarized
// before the callers.
//
// The why-chains: per function, for each bit of its summary, the first
// exit (a `return`, the tail) whose value brought it; `query views --why`
// prints them, and a callee's summary when the value is a call.

use crate::base::{buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_src, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, put_short_positions};
use crate::front::ast::{FN_CLOSURE, NodeKind, child};
use crate::front::effects::infer::{body_walked, infer_effects};
use crate::front::modules::within_std;
use crate::front::own::ctx::OwnCx;
use crate::front::own::diag::{
    OWN_VIEWS, own_begin, own_bytes, own_discard, own_end, own_flush, own_help, own_str, own_try,
};
use crate::front::own::kinds::{K_LEVEL2, is_view_type, owned_base_type, type_kind, view_elem};
use crate::front::own::state::{RK_LOCAL, RK_ROOT, RK_STATIC, root_of, slot_of_local, slot_off};
use crate::front::own::summary::{
    S_L1_P, S_L1_STAR, S_L2_P, S_L2_STAR, ViewSummary, closure_param, decl_of, declared_summary,
    empty_summary, env_param, env_ref_field, floor_summary, has_mut_ref_param, join_summary,
    put_params, ret_parametric, same_summary, store_param, summary_inferred, summary_of,
    summary_store, summary_store_casts, summary_text, top_summary, view_fn,
};
use crate::front::own::walk::walk_fn;
use crate::front::types::{TyKind, enum_variant, fn_param, get_enums, struct_field, type_elem};

// ---------------------------------------------------------------------------
// The type filter

fn pair_key(t: i64, e: i64) -> i64 {
    t * 16777216 + e + 1
}

// Whether types a and b are the same storage element (a `&mut [T]` is a
// `[T]`, a `&T` a `*T`).
fn same_elem(a0: i64, b0: i64, pcx: &Ctx<Comp>) -> bool {
    // (0.25: a distinct type is its base's storage, `str` a `[u8]`)
    let a = if a0 > 0 { crate::front::distinct::strip_distinct(a0, pcx) } else { a0 };
    let b = if b0 > 0 { crate::front::distinct::strip_distinct(b0, pcx) } else { b0 };
    if a == b {
        return true;
    }
    if a <= 0 || b <= 0 {
        return false;
    }
    let k = pcx.types[a as usize].kind;
    (k == TyKind::Slice || k == TyKind::Ptr) && pcx.types[b as usize].kind == k
        && pcx.types[a as usize].a == pcx.types[b as usize].a
}

// Whether the storage of a value of type t (its fields, elements, a
// container's buffer; through raw pointers, not through views) can hold
// a value of type e.
pub fn holds(t: i64, e: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t <= 0 || e <= 0 {
        return t > 0 && e < 0;
    }
    if same_elem(t, e, pcx) {
        return true;
    }
    let key = pair_key(t, e);
    let known = pcx.holds_memo.get(key);
    if known != 0 {
        return known == 2;
    }
    // (a recursive type: the outer walk sees its other parts)
    pcx.holds_memo.put(key, 1);
    let r = holds_of(t, e, pcx);
    pcx.holds_memo.put(key, if r { 2 } else { 1 });
    r
}

fn holds_of(t: i64, e: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Distinct {
            // (0.25) its base's storage
            return holds(pcx.types[t as usize].a, e, pcx);
        }
        if k == TyKind::Ptr {
            // (raw: it may own what it points to; a reference does not)
            return pcx.types[t as usize].b == 0 && holds(pcx.types[t as usize].a, e, pcx);
        }
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            // (0.25: a closure holds its captures, its env's fields: by
            // reference, nothing of its own; by value, what they hold)
            if owned_base_type(t, pcx) {
                let tpl = if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl - 1 }
                    else { s };
                if pcx.sym_vec_t == 0 {
                    pcx.sym_vec_t = intern_c(c"Vec", pcx);
                    pcx.sym_map_t = intern_c(c"HashMap", pcx);
                }
                if pcx.structs[tpl as usize].name != pcx.sym_vec_t
                    && pcx.structs[tpl as usize].name != pcx.sym_map_t {
                    // (Buf holds bytes; Arena anything)
                    return true;
                }
                for i in 0..pcx.structs[s as usize].targ_count {
                    if holds((*pcx.tlists.data.add((pcx.structs[s as usize].targs + i) as usize)),
                        e, pcx) {
                        return true;
                    }
                }
                for i in 0..pcx.structs[s as usize].field_count {
                    // (0.25) a field itself: `-> let RawTable` of a HashMap
                    // (raw_table) is a view of its table
                    if same_elem((*struct_field(s, i, pcx)).ty, e, pcx) {
                        return true;
                    }
                }
                if pcx.structs[tpl as usize].name == pcx.sym_map_t {
                    // (0.25) a HashMap's table: its buckets, (K, V) pairs
                    let x = crate::front::distinct::strip_distinct(e, pcx);
                    if pcx.types[x as usize].kind == TyKind::Tuple {
                        let mut all = true;
                        for i in 0..pcx.types[x as usize].count {
                            if !holds(t, type_elem(x, i, pcx), pcx) {
                                all = false;
                            }
                        }
                        return all;
                    }
                }
                return false;
            }
            for i in 0..pcx.structs[s as usize].field_count {
                if holds((*struct_field(s, i, pcx)).ty, e, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if holds(type_elem(t, i, pcx), e, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return holds(pcx.types[t as usize].a, e, pcx);
        }
        if k == TyKind::Enum {
            let en = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(en as usize)).variant_count {
                if holds(pcx.variants[enum_variant(en, i) as usize].shape, e, pcx) {
                    return true;
                }
            }
        }
        false
    }
}

// Whether what the views of a value of type t point to (at any depth)
// can hold an e.
pub fn deep(t: i64, e: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t <= 0 || e <= 0 {
        return t > 0 && e < 0;
    }
    if !is_view_type(t, pcx) && pcx.types[t as usize].kind != TyKind::Ptr {
        return false;
    }
    let key = pair_key(t, e);
    let known = pcx.deep_memo.get(key);
    if known != 0 {
        return known == 2;
    }
    pcx.deep_memo.put(key, 1);
    let r = targets(t, e, true, pcx);
    pcx.deep_memo.put(key, if r { 2 } else { 1 });
    r
}

// Whether the views in the parts of a value of type t point to storage
// that can hold an e (with far: to storage whose views do, at any depth).
fn targets(t: i64, e: i64, far: bool, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.targets_depth > 16 {
        return true;
    }
    pcx.targets_depth += 1;
    let r = targets_of(t, e, far, pcx);
    pcx.targets_depth -= 1;
    r
}

fn targets_of(t: i64, e: i64, far: bool, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if t <= 0 {
            return false;
        }
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Slice || k == TyKind::Ptr {
            let y = pcx.types[t as usize].a;
            return holds(y, e, pcx) || far && deep(y, e, pcx);
        }
        if !is_view_type(t, pcx) {
            return false;
        }
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if pcx.structs[s as usize].closure != 0 {
                return true;
            }
            if owned_base_type(t, pcx) {
                for i in 0..pcx.structs[s as usize].targ_count {
                    if targets((*pcx.tlists.data.add((pcx.structs[s as usize].targs + i) as usize)),
                        e, far, pcx) {
                        return true;
                    }
                }
                return false;
            }
            for i in 0..pcx.structs[s as usize].field_count {
                if targets((*struct_field(s, i, pcx)).ty, e, far, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if targets(type_elem(t, i, pcx), e, far, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return targets(pcx.types[t as usize].a, e, far, pcx);
        }
        if k == TyKind::Enum {
            let en = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(en as usize)).variant_count {
                if targets(pcx.variants[enum_variant(en, i) as usize].shape, e, far, pcx) {
                    return true;
                }
            }
            return false;
        }
        // (a scoped arena, a closure: anything)
        true
    }
}

// Whether a parameter of type t can carry views or loans at all: a view,
// or a pointer (a reference, a legacy `*T` borrow).
pub fn param_carries(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    t > 0 && (is_view_type(t, pcx) || pcx.types[t as usize].kind == TyKind::Ptr)
}

// Whether parameter type t's `p` (star false) or `*p` (star true) can hold
// views of element type e.
fn root_can(t: i64, e: i64, star: bool, pcx: &mut Ctx<Comp>) -> bool {
    if !param_carries(t, pcx) {
        return false;
    }
    if e < 0 {
        return true;
    }
    if pcx.types[t as usize].kind == TyKind::Ptr {
        let x = pcx.types[t as usize].a;
        return if star { deep(x, e, pcx) } else { holds(x, e, pcx) };
    }
    if star {
        // (by value: what its views point to holds views of e)
        return targets_far_only(t, e, pcx);
    }
    targets(t, e, false, pcx)
}

// The views in t's parts point to storage whose own views reach an e.
fn targets_far_only(t: i64, e: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Slice || k == TyKind::Ptr {
            return deep(pcx.types[t as usize].a, e, pcx);
        }
        if !is_view_type(t, pcx) {
            return false;
        }
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if pcx.structs[s as usize].closure != 0 {
                return true;
            }
            if owned_base_type(t, pcx) {
                for i in 0..pcx.structs[s as usize].targ_count {
                    if targets_far_only(
                        (*pcx.tlists.data.add((pcx.structs[s as usize].targs + i) as usize)), e,
                        pcx) {
                        return true;
                    }
                }
                return false;
            }
            for i in 0..pcx.structs[s as usize].field_count {
                if targets_far_only((*struct_field(s, i, pcx)).ty, e, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if targets_far_only(type_elem(t, i, pcx), e, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return targets_far_only(pcx.types[t as usize].a, e, pcx);
        }
        if k == TyKind::Enum {
            let en = pcx.types[t as usize].a;
            for i in 0..(*get_enums().add(en as usize)).variant_count {
                if targets_far_only(pcx.variants[enum_variant(en, i) as usize].shape, e, pcx) {
                    return true;
                }
            }
            return false;
        }
        true
    }
}

fn filter_masks(f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.filt_n <= f {
            let n = pcx.fns.len() as i64 + 64;
            let a = crate::base::alloc_array::<i64>(n * 7);
            for i in 0..pcx.filt_n * 7 {
                (*a.add(i as usize)) = (*pcx.filt.add(i as usize));
            }
            pcx.filt = a;
            pcx.filt_n = n;
        }
        let o = f * 7;
        if (*pcx.filt.add((o + 4) as usize)) != 0 {
            return o;
        }
        let r = pcx.fns[f as usize].ret;
        let e = view_elem(r, pcx);
        let mut p: i64 = 0;
        let mut s: i64 = 0;
        if pcx.fns[f as usize].param_count > 63 || e == 0 {
            p = -1;
            s = -1;
        } else {
            for i in 0..pcx.fns[f as usize].param_count {
                let t = fn_param(f, i, pcx);
                if root_can(t, e, false, pcx) {
                    p |= 1 << i;
                }
                if root_can(t, e, true, pcx) {
                    s |= 1 << i;
                }
            }
        }
        (*pcx.filt.add(o as usize)) = p;
        (*pcx.filt.add((o + 1) as usize)) = s;
        (*pcx.filt.add((o + 2) as usize)) = if (type_kind(r, pcx) & K_LEVEL2) != 0 { -1 }
            else { 0 };
        // (level 2, when the result has exactly two levels: views of E2,
        // the element of the views an E holds)
        (*pcx.filt.add((o + 5) as usize)) = (*pcx.filt.add((o + 2) as usize));
        (*pcx.filt.add((o + 6) as usize)) = (*pcx.filt.add((o + 2) as usize));
        let e2: i64 = if e > 0 { view_elem(e, pcx) } else { 0 };
        if (*pcx.filt.add((o + 2) as usize)) != 0 && e2 > 0 && !is_view_type(e2, pcx)
            && pcx.fns[f as usize].param_count <= 63 {
            let mut p2: i64 = 0;
            let mut s2: i64 = 0;
            for i in 0..pcx.fns[f as usize].param_count {
                let t = fn_param(f, i, pcx);
                if root_can(t, e2, false, pcx) {
                    p2 |= 1 << i;
                }
                if root_can(t, e2, true, pcx) {
                    s2 |= 1 << i;
                }
            }
            (*pcx.filt.add((o + 5) as usize)) = p2;
            (*pcx.filt.add((o + 6) as usize)) = s2;
        }
        // (the stores: a referent never gains what it holds already, so
        // with one `&mut` parameter its own bits go)
        let mut targets: i64 = 0;
        let mut only: i64 = -1;
        for i in 0..pcx.fns[f as usize].param_count {
            if store_param(f, i, pcx) {
                targets += 1;
                only = i;
            }
        }
        // (a closure's env, or a closure given: its own bits stay, as one
        // capture may come to view another)
        (*pcx.filt.add((o + 3) as usize)) = if targets == 1 && only < 63 && !env_param(f, only, pcx)
            && !closure_param(f, only, pcx)
            { ~(1 << only) } else { -1 };
        (*pcx.filt.add((o + 4) as usize)) = 1;
        o
    }
}

// Summary s of f narrowed by the type filter (summary_of's last step).
pub fn filter_summary(f: i64, s: ViewSummary, pcx: &mut Ctx<Comp>) -> ViewSummary {
    unsafe {
        let mut r = s;
        let o = filter_masks(f, pcx);
        if !is_view_type(pcx.fns[f as usize].ret, pcx) {
            for k in 0..4 {
                r.ret[k as usize] = 0;
            }
        } else {
            r.ret[S_L1_P as usize] &= (*pcx.filt.add(o as usize));
            r.ret[S_L1_STAR as usize] &= (*pcx.filt.add((o + 1) as usize));
            r.ret[S_L2_P as usize] &= (*pcx.filt.add((o + 5) as usize));
            r.ret[S_L2_STAR as usize] &= (*pcx.filt.add((o + 6) as usize));
        }
        for k in 0..4 {
            r.sto[k as usize] &= (*pcx.filt.add((o + 3) as usize));
            if !has_mut_ref_param(f, pcx) {
                r.sto[k as usize] = 0;
            }
        }
        r
    }
}

// ---------------------------------------------------------------------------
// Indirect calls

// The summary of a call through a value of fn type t: the join of the
// summaries of the functions of that type whose address is taken (none:
// views()).
pub fn indirect_summary(t: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    let t = crate::front::types::fn_ty_safe(t, pcx);
    unsafe {
        let mut s = empty_summary();
        let mut i: i64 = 0;
        while i < pcx.address_taken.count {
            if (*pcx.address_taken.data.add(i as usize)) == t {
                s = join_summary(s,
                    summary_of((*pcx.address_taken.data.add((i + 1) as usize)), pcx));
            }
            i += 2;
        }
        s.declared = false;
        s
    }
}

// The summary call n uses: of f, or (f < 0) of every function its fn
// value may be (indirect_summary of the callee's type).
pub fn summary_at_call(n: i64, f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    if f >= 0 {
        return summary_of(f, pcx);
    }
    let callee = pcx.nodes[n as usize].a;
    if callee == 0 || pcx.nodes[callee as usize].ty <= 0
        || pcx.types[pcx.nodes[callee as usize].ty as usize].kind != TyKind::Fn {
        return top_summary();
    }
    indirect_summary(pcx.nodes[callee as usize].ty, pcx)
}

// ---------------------------------------------------------------------------
// Collection (summary.vl's collect_*, called by the walk)

pub fn col_begin(f: i64, round: i64, pcx: &mut Ctx<Comp>) {
    pcx.col_f = f;
    pcx.col_on = f >= 0 && view_fn(f, pcx);
    pcx.col_reported = false;
    pcx.col_why.count = 0;
    pcx.col_call = 0;
    pcx.col_cast = 0;
    pcx.col_stored[0] = 0;
    pcx.col_stored[1] = 0;
    for k in 0..4 {
        pcx.col_ret[k as usize] = 0;
        pcx.col_sto[k as usize] = 0;
    }
    pcx.col_declared = pcx.col_on && decl_of(f, pcx) != 0;
    if pcx.col_declared {
        pcx.col_decl = declared_summary(f, pcx);
    }
}

// The index of parameter local l (walk::PARAM_LOCALS), -1.
fn param_index(l: i64, ocx: &OwnCx) -> i64 {
    unsafe {
        for i in 0..ocx.param_locals.count {
            if (*ocx.param_locals.data.add(i as usize)) == l {
                return i;
            }
        }
        -1
    }
}

// The parameter root place q comes from: parameter * 2 (+ 1 for `*p`), or
// -1 (a local, a static, a by-value parameter's own storage, or local
// skip's own roots).
fn root_param(q: i64, skip: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let r = root_of(q, ocx);
        if (*ocx.pl_rkind.add(r as usize)) == RK_STATIC {
            return -1;
        }
        let l = (*ocx.pl_rid.add(r as usize));
        if l < 0 || l == skip || !pcx.locals[l as usize].is_param {
            return -1;
        }
        let i = param_index(l, ocx);
        if i < 0 {
            return -1;
        }
        if (*ocx.pl_rkind.add(r as usize)) == RK_ROOT {
            return i * 2 + (*ocx.pl_field.add(r as usize));
        }
        // (a place reached through a reference parameter: its referent)
        let t = pcx.locals[l as usize].ty;
        if (*ocx.pl_rkind.add(r as usize)) == RK_LOCAL && t > 0
            && pcx.types[t as usize].kind == TyKind::Ptr {
            if q != r && env_param(pcx.col_f, i, pcx) {
                // (a closure's capture by reference: the captured variable,
                // what the env's views point into)
                let mut a = q;
                while (*ocx.pl_parent.add(a as usize)) != r {
                    a = (*ocx.pl_parent.add(a as usize));
                }
                if env_ref_field(pcx.col_f, (*ocx.pl_field.add(a as usize)), pcx) {
                    return i * 2 + 1;
                }
            }
            return i * 2;
        }
        -1
    }
}

// Masks m[lv] (p) and m[lv + 1] (`*p`) get the parameter roots of bitset
// words POOL[w..w + NW].
fn add_roots(w: i64, skip: i64, m: *mut i64, lv: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        for q in 0..ocx.pl_count {
            if ((*ocx.pool.add((w + (q >> 6)) as usize)) & (1 << (q & 63))) == 0 {
                continue;
            }
            let pr = root_param(q, skip, ocx, pcx);
            if pr < 0 {
                continue;
            }
            let i = pr >> 1;
            let bit: i64 = if i >= 63 { -1 } else { 1 << i };
            (*m.add((lv + (pr & 1)) as usize)) |= bit;
        }
    }
}

// The function's result at node e (origin v, -1: none): an exit. Its
// levels' parameter roots go to the result's masks; the `&mut`
// parameters' slots at this exit, to the stores'.
pub fn col_result(e: i64, v: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        if !pcx.col_on {
            return;
        }
        let f = pcx.col_f;
        let mut ret: [i64; 4] = [0i64, 0, 0, 0];
        let mut sto: [i64; 4] = [0i64, 0, 0, 0];
        if v >= 0 && is_view_type(pcx.fns[f as usize].ret, pcx) {
            add_roots(v, -1, &mut ret[0], S_L1_P, ocx, pcx);
            add_roots(v + ocx.nw, -1, &mut ret[0], S_L2_P, ocx, pcx);
        }
        let mut target: [i64; 4] = [-1, -1, -1, -1];
        for i in 0..ocx.param_locals.count {
            let l = (*ocx.param_locals.data.add(i as usize));
            if l < 0 || i >= pcx.fns[f as usize].param_count || !store_param(f, i, pcx) {
                continue;
            }
            let s = slot_of_local(l, ocx);
            if s < 0 {
                continue;
            }
            let off = slot_off(ocx.cur, s, ocx);
            let mut m: [i64; 2] = [0i64, 0];
            add_roots(off, l, &mut m[0], 0, ocx, pcx);
            add_roots(off + ocx.nw, l, &mut m[0], 0, ocx, pcx);
            if i < 63 && (ocx.captures_stored & (1 << i)) != 0 {
                // (a closure stored into: one capture may now view another,
                // its own roots among what was stored, col_stored)
                m[0] |= pcx.col_stored[0];
                m[1] |= pcx.col_stored[1];
            }
            for k in 0..4 {
                let add = if k == S_L1_P || k == S_L2_P { m[0] } else { m[1] };
                if (add & ~sto[k as usize]) != 0 && target[k as usize] < 0 {
                    target[k as usize] = i;
                }
                sto[k as usize] |= add;
            }
        }
        note_why(ret, pcx.col_ret, 0, e, -1, pcx);
        note_why_sto(sto, e, target, pcx);
        for k in 0..4 {
            pcx.col_ret[k as usize] |= ret[k as usize];
            pcx.col_sto[k as usize] |= sto[k as usize];
        }
        if pcx.col_declared && !pcx.col_reported {
            check_declared(f, e, ret, sto, target, pcx);
        }
    }
}

// Whether a call of f (-1: through a fn value) in the walked function is
// a callable's (a closure's, a fn value's, or a function outside std: what
// a type parameter's bound lets the body call) whose result's views the
// parametric floor does not cover: a generic body that calls its `F`
// makes a result that may view anything the callable views (col_end).
pub fn col_callable(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    if !pcx.col_on || pcx.fns[pcx.col_f as usize].tmpl == 0 || ret_parametric(pcx.col_f, pcx) == 0 {
        return false;
    }
    f < 0 || !within_std(pcx.fns[f as usize].module, pcx) || pcx.fns[f as usize].node > 0
        && (pcx.nodes[pcx.fns[f as usize].node as usize].p & FN_CLOSURE) != 0
}

// The origin v of a callable's result (col_callable): the parameters it
// views, at any level.
pub fn col_call(v: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) {
    let mut m: [i64; 4] = [0i64, 0, 0, 0];
    add_roots(v, -1, &mut m[0], S_L1_P, ocx, pcx);
    add_roots(v + ocx.nw, -1, &mut m[0], S_L2_P, ocx, pcx);
    pcx.col_call |= m[0] | m[1] | m[2] | m[3];
}

// The origin v of a cast's argument (calls::on_call).
pub fn col_cast(v: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) {
    if !pcx.col_on {
        return;
    }
    let mut m: [i64; 2] = [0i64, 0];
    add_roots(v, -1, &mut m[0], 0, ocx, pcx);
    pcx.col_cast |= m[0] | m[1];
}

pub fn col_stored(v: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) {
    if !pcx.col_on {
        return;
    }
    // (both masks taken out: add_roots writes m[0] and m[1] through the
    // pointer to the first)
    let mut stored = pcx.col_stored;
    add_roots(v, -1, &mut stored[0], 0, ocx, pcx);
    add_roots(v + ocx.nw, -1, &mut stored[0], 0, ocx, pcx);
    pcx.col_stored = stored;
}

// The why of the bits of m that are new (not in old): (mask base + k,
// parameter, node e, target).
fn note_why(m: [i64; 4], old: [i64; 4], base: i64, e: i64, target: i64, pcx: &mut Ctx<Comp>) {
    for k in 0..4 {
        let new = m[k as usize] & ~old[k as usize];
        if new == 0 {
            continue;
        }
        for i in 0..63 {
            if (new & (1 << i)) != 0 {
                pcx.col_why.push(base + k);
                pcx.col_why.push(i);
                pcx.col_why.push(e);
                pcx.col_why.push(target);
            }
        }
    }
}

fn note_why_sto(sto: [i64; 4], e: i64, target: [i64; 4], pcx: &mut Ctx<Comp>) {
    for k in 0..4 {
        let mut one: [i64; 4] = [0i64, 0, 0, 0];
        one[k as usize] = sto[k as usize];
        note_why(one, pcx.col_sto, 4, e, target[k as usize], pcx);
    }
}

// The walk of f ended: the summary its body makes (a parametric result
// takes its floor's masks, by its type; the floor's stores are joined).
// Its why is kept for query views.
pub fn col_end(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    let mut s = empty_summary();
    if !pcx.col_on {
        return s;
    }
    for k in 0..4 {
        s.ret[k as usize] = pcx.col_ret[k as usize];
        s.sto[k as usize] = pcx.col_sto[k as usize];
    }
    if pcx.fns[f as usize].tmpl != 0 {
        let floor = floor_summary(f, pcx);
        for k in 0..4 {
            if ret_parametric(f, pcx) != 0 {
                // (and what its callables' results view, as the body
                // passes them on: col_call)
                s.ret[k as usize] = floor.ret[k as usize] | pcx.col_ret[k as usize] & pcx.col_call;
            }
            s.sto[k as usize] |= floor.sto[k as usize];
        }
    }
    summary_store_casts(f, pcx.col_cast, pcx);
    keep_why(f, pcx);
    s
}

// ---------------------------------------------------------------------------
// #[views] checked against the body (own.views)

fn sym_text(f: i64, i: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    crate::base::sym_text(pcx.nodes[child(pcx.fns[f as usize].node, i, pcx) as usize].a, pcx)
}

// The first parameter bit of m beyond d: parameter * 2 (+ 1 for `*p`),
// -1.
fn first_excess(m: [i64; 4], d: [i64; 4]) -> i64 {
    for k in 0..4 {
        let x = m[k as usize] & ~d[k as usize];
        if x == 0 {
            continue;
        }
        for i in 0..63 {
            if (x & (1 << i)) != 0 {
                let star: i64 = if k == S_L1_STAR || k == S_L2_STAR { 1 } else { 0 };
                return i * 2 + star;
            }
        }
        return 126;
    }
    -1
}

fn put_decl(f: i64, stores: bool, pcx: &Ctx<Comp>) {
    let b = buf_new();
    if stores {
        buf_str(b, c"#[stores(");
        put_params(b, f, pcx.col_decl.sto, pcx);
    } else {
        buf_str(b, c"#[views(");
        put_params(b, f, pcx.col_decl.ret, pcx);
    }
    buf_str(b, c")]");
    own_bytes(buf_slice(b), pcx);
}

fn put_root(f: i64, x: i64, pcx: &Ctx<Comp>) {
    let i = x >> 1;
    if i >= pcx.fns[f as usize].param_count {
        own_str(c"its parameters", pcx);
        return;
    }
    if (x & 1) != 0 {
        own_str(c"what '", pcx);
        own_bytes(sym_text(f, i, pcx), pcx);
        own_str(c"' holds ('*", pcx);
        own_bytes(sym_text(f, i, pcx), pcx);
        own_str(c"')", pcx);
    } else {
        own_str(c"'", pcx);
        own_bytes(sym_text(f, i, pcx), pcx);
        own_str(c"'", pcx);
    }
}

// Appends the source text of node n (its first line, shortened).
pub fn buf_node_source(out: i64, n: i64, pcx: &Ctx<Comp>) {
    let start = pcx.nodes[n as usize].start;
    let mut end = start;
    while end < pcx.nodes[n as usize].end && get_src()[end as usize] != b'\n' {
        end += 1;
    }
    if end - start > 48 {
        buf_bytes(out, &get_src()[start as usize..(start + 44) as usize]);
        buf_str(out, c"..");
        return;
    }
    buf_bytes(out, &get_src()[start as usize..end as usize]);
    if end < pcx.nodes[n as usize].end {
        buf_str(out, c" ..");
    }
}

fn check_declared(f: i64, e: i64, ret: [i64; 4], sto: [i64; 4], target: [i64; 4],
    pcx: &mut Ctx<Comp>) {
    let name = crate::base::sym_text(pcx.fns[f as usize].display, pcx);
    let rx = first_excess(ret, pcx.col_decl.ret);
    let sx = first_excess(sto, pcx.col_decl.sto);
    if rx < 0 && sx < 0 {
        return;
    }
    pcx.col_reported = true;
    own_begin(e, OWN_VIEWS, pcx);
    own_str(c"'", pcx);
    own_bytes(name, pcx);
    own_str(c"' is ", pcx);
    let mut inferred = buf_new();
    if rx >= 0 {
        put_decl(f, false, pcx);
        own_str(c" but returns a view of ", pcx);
        put_root(f, rx, pcx);
        own_str(c": '", pcx);
        let src = buf_new();
        buf_node_source(src, e, pcx);
        own_bytes(buf_slice(src), pcx);
        own_str(c"'", pcx);
        buf_str(inferred, c"views(");
        let mut all = pcx.col_decl.ret;
        for k in 0..4 {
            all[k as usize] |= ret[k as usize] | pcx.col_ret[k as usize];
        }
        put_params(inferred, f, all, pcx);
        buf_str(inferred, c")");
    } else {
        put_decl(f, true, pcx);
        own_str(c" but ", pcx);
        let mut t: i64 = -1;
        for k in 0..4 {
            if t < 0 && (sto[k as usize] & ~pcx.col_decl.sto[k as usize]) != 0 {
                t = target[k as usize];
            }
        }
        if t >= 0 && t < pcx.fns[f as usize].param_count {
            own_str(c"'", pcx);
            own_bytes(sym_text(f, t, pcx), pcx);
            own_str(c"'", pcx);
        } else {
            own_str(c"an `inout` parameter", pcx);
        }
        own_str(c" may hold a view of ", pcx);
        put_root(f, sx, pcx);
        own_str(c" when it returns", pcx);
        buf_str(inferred, c"stores(");
        let mut all = pcx.col_decl.sto;
        for k in 0..4 {
            all[k as usize] |= sto[k as usize] | pcx.col_sto[k as usize];
        }
        put_params(inferred, f, all, pcx);
        buf_str(inferred, c")");
    }
    own_help(c"callers rely on the declaration: change the body to keep to it, or declare what it does: #[", pcx);
    crate::front::own::diag::own_help_bytes(buf_slice(inferred), pcx);
    own_help(c"]", pcx);
    let cmd = buf_new();
    buf_str(cmd, c"volec query views ");
    buf_bytes(cmd, name);
    buf_str(cmd, c" --why");
    own_try(buf_slice(cmd), pcx);
    own_end(pcx);
}

// ---------------------------------------------------------------------------
// The why-chains

fn keep_why(f: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let start = pcx.why_all.count;
        for i in 0..pcx.col_why.count {
            pcx.why_all.push((*pcx.col_why.data.add(i as usize)));
        }
        pcx.why_at.put(f + 1, start * 65536 + pcx.col_why.count / 4 + 1);
    }
}

// The call a result expression e makes its value with (through `Ok(..)`,
// `Some(..)`, a block's tail, `?`), or 0.
fn result_call(e: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n = e;
    let mut steps: i64 = 0;
    while n != 0 && steps < 8 {
        steps += 1;
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Call {
            return n;
        }
        if k == NodeKind::VariantLit && pcx.nodes[n as usize].count == 1 {
            n = child(n, 0, pcx);
        } else if k == NodeKind::Block {
            n = pcx.nodes[n as usize].a;
        } else if k == NodeKind::Try {
            n = pcx.nodes[n as usize].y;
        } else {
            return 0;
        }
    }
    0
}

fn put_short_pos(out: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let tmp = buf_new();
    buf_position(tmp, pos, pcx);
    put_short_positions(out, buf_slice(tmp));
}

// The why of a parametric result (by its type, whatever the body does).
fn put_parametric_why(out: i64, f: i64, pcx: &mut Ctx<Comp>) {
    let p = ret_parametric(f, pcx);
    if p == 1 {
        buf_str(out, c"  why: a generic result made of its type parameters: the T values its arguments hold (by its type)\n");
    } else if p == 2 {
        buf_str(out, c"  why: a generic result that views T storage: its arguments' storage, level by level (by its type)\n");
    }
}

// The why of f's summary into out: a line for each source (`  why:
// FILE:L:C 'SOURCE' ...`), indented. Nothing when f was not walked.
pub fn views_why(out: i64, f: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let at = pcx.why_at.get(f + 1);
        if decl_of(f, pcx) != 0 {
            buf_str(out, c"  why: declared (#[views], #[stores]): callers use the declaration, and the body is checked against it\n");
            return;
        }
        if at == 0 {
            if !summary_inferred(f, pcx) && view_fn(f, pcx) {
                if ret_parametric(f, pcx) != 0 {
                    put_parametric_why(out, f, pcx);
                } else {
                    buf_str(out, c"  why: its body was not walked (it did not check): every parameter assumed\n");
                }
            }
            return;
        }
        let start = (at - 1) / 65536;
        let n = (at - 1) % 65536;
        put_parametric_why(out, f, pcx);
        let fin = summary_of(f, pcx);
        let fin_p = fin.ret[S_L1_P as usize] | fin.ret[S_L2_P as usize];
        let sto_p = fin.sto[S_L1_P as usize] | fin.sto[S_L2_P as usize];
        // (a line per parameter as the text rounds it: shown[group * 2 +
        // star], parameter bits)
        let mut shown: [i64; 4] = [0i64, 0, 0, 0];
        for j in 0..n {
            let o = start + j * 4;
            let k = (*pcx.why_all.data.add(o as usize));
            let i = (*pcx.why_all.data.add((o + 1) as usize));
            let e = (*pcx.why_all.data.add((o + 2) as usize));
            let target = (*pcx.why_all.data.add((o + 3) as usize));
            if i >= pcx.fns[f as usize].param_count {
                continue;
            }
            // (only the bits the summary keeps after the filter)
            let m = if k < 4 { fin.ret[k as usize] } else { fin.sto[(k - 4) as usize] };
            if (m & (1 << i)) == 0 || k >= 4 && ret_parametric(f, pcx) != 0 {
                continue;
            }
            let star = k == S_L1_STAR || k == S_L2_STAR || k == 4 + S_L1_STAR
                || k == 4 + S_L2_STAR;
            let level2 = k == S_L2_P || k == S_L2_STAR || k == 4 + S_L2_P || k == 4 + S_L2_STAR;
            let group: i64 = if k >= 4 { 1 } else { 0 };
            let p_bits = if k >= 4 { sto_p } else { fin_p };
            let g = group * 2 + if star { 1 } else { 0 };
            if star && (p_bits & (1 << i)) != 0 || (shown[g as usize] & (1 << i)) != 0 {
                continue;
            }
            shown[g as usize] |= 1 << i;
            buf_str(out, c"  why: ");
            put_short_pos(out, pcx.nodes[e as usize].start, pcx);
            if e == pcx.nodes[pcx.fns[f as usize].node as usize].c || k >= 4 {
                buf_str(out, c" (when '");
                buf_bytes(out, crate::base::sym_text(pcx.fns[f as usize].display, pcx));
                buf_str(out, c"' returns)");
            } else {
                buf_str(out, c" '");
                buf_node_source(out, e, pcx);
                buf_str(out, c"'");
            }
            if k >= 4 {
                buf_str(out, c": '");
                if target >= 0 && target < pcx.fns[f as usize].param_count {
                    buf_bytes(out, sym_text(f, target, pcx));
                } else {
                    buf_str(out, c"an `inout` parameter");
                }
                buf_str(out, c"' may hold views of ");
            } else if level2 {
                buf_str(out, c": the views it points to view ");
            } else {
                buf_str(out, c": views ");
            }
            if star {
                buf_str(out, c"what '");
                buf_bytes(out, sym_text(f, i, pcx));
                buf_str(out, c"' holds");
            } else {
                buf_str(out, c"'");
                buf_bytes(out, sym_text(f, i, pcx));
                buf_str(out, c"'");
            }
            let call: i64 = if k < 4 { result_call(e, pcx) } else { 0 };
            if call != 0 && pcx.nodes[call as usize].x > 0 {
                let g = pcx.nodes[call as usize].x - 1;
                buf_str(out, c", through '");
                buf_bytes(out, crate::base::sym_text(pcx.fns[g as usize].display, pcx));
                buf_str(out, c"' (");
                summary_text(out, g, summary_of(g, pcx), pcx);
                buf_str(out, c")");
            }
            buf_byte(out, b'\n');
        }
    }
}

// ---------------------------------------------------------------------------
// The driver

// Whether function f is walked: it has a checked body (not C's, not a
// template).
pub fn walkable(f: i64, pcx: &Ctx<Comp>) -> bool {
    f >= 0 && f < pcx.fns.len() as i64 && !pcx.fns[f as usize].is_extern && body_walked(f, pcx)
}

fn self_edge(v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        for e in (*pcx.edge_start.data.add(v as usize))..(
            *pcx.edge_start.data.add((v + 1) as usize)) {
            if ((*pcx.edges.data.add(e as usize)) >> 2) == v {
                return true;
            }
        }
        false
    }
}

// Where a recursive component's member starts: its floor's stores, and
// its result's when it is parametric; else views().
fn start_summary(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    if pcx.fns[f as usize].tmpl == 0 {
        return empty_summary();
    }
    let mut s = floor_summary(f, pcx);
    if s.top {
        for k in 0..4 {
            s.ret[k as usize] = 0;
        }
        s.top = false;
    }
    s
}

// Rounds a recursive component is walked at most before its undecided
// summaries are taken as top.
const MAX_ROUNDS: i64 = 24;

// Walks f once, its findings kept; its summary stored.
fn walk_kept(f: i64, all: bool, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    if !all && !view_fn(f, pcx) {
        return;
    }
    let s = walk_fn(f, 0, ocx, pcx);
    own_flush(pcx);
    if view_fn(f, pcx) && decl_of(f, pcx) == 0 {
        summary_store(f, s, pcx);
    }
}

pub fn infer_summaries(all: bool, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.component == 0 as *mut i64 || pcx.graph_fns > pcx.fns.len() as i64 {
            infer_effects(pcx);
        }
        let size = pcx.graph_size;
        let n = pcx.graph_fns;
        // (the nodes by component, components in completion order:
        // counting sort)
        let mut ncomp: i64 = 0;
        for v in 0..size {
            if (*pcx.component.add(v as usize)) > ncomp {
                ncomp = (*pcx.component.add(v as usize));
            }
        }
        let start = crate::base::alloc_array::<i64>(ncomp + 2);
        for v in 0..size {
            (*start.add(((*pcx.component.add(v as usize)) + 1) as usize)) += 1;
        }
        for c in 0..ncomp + 1 {
            (*start.add((c + 1) as usize)) += (*start.add(c as usize));
        }
        let order = crate::base::alloc_array::<i64>(size + 1);
        let fill = crate::base::alloc_array::<i64>(ncomp + 2);
        for v in 0..size {
            let c = (*pcx.component.add(v as usize));
            (*order.add(((*start.add(c as usize)) + (*fill.add(c as usize))) as usize)) = v;
            (*fill.add(c as usize)) += 1;
        }
        for c in 0..ncomp + 1 {
            let a = (*start.add(c as usize));
            let b = (*start.add((c + 1) as usize));
            if a == b {
                continue;
            }
            // (iterated: a recursive component with a member whose
            // summary is inferred and can carry views)
            let mut iterate = false;
            for k in a..b {
                let f = (*order.add(k as usize));
                if f < n && decl_of(f, pcx) == 0 && walkable(f, pcx) && view_fn(f, pcx)
                    && (b - a > 1 || self_edge(f, pcx)) {
                    iterate = true;
                }
            }
            if !iterate {
                for k in a..b {
                    let f = (*order.add(k as usize));
                    if f < n && walkable(f, pcx) {
                        walk_kept(f, all, ocx, pcx);
                    }
                }
                continue;
            }
            // (a recursive component: from the floor, until nothing grows)
            for k in a..b {
                let f = (*order.add(k as usize));
                if f < n && walkable(f, pcx) && view_fn(f, pcx) && decl_of(f, pcx) == 0 {
                    summary_store(f, start_summary(f, pcx), pcx);
                }
            }
            let mut round: i64 = 0;
            loop {
                let mut changed = false;
                for k in a..b {
                    let f = (*order.add(k as usize));
                    if f >= n || !walkable(f, pcx) || !view_fn(f, pcx) {
                        continue;
                    }
                    let s = walk_fn(f, round, ocx, pcx);
                    own_discard(pcx);
                    if decl_of(f, pcx) == 0 {
                        let old = crate::front::own::summary::summary_stored(f, pcx);
                        let j = join_summary(old, s);
                        if !same_summary(j, old) {
                            summary_store(f, j, pcx);
                            changed = true;
                        }
                    }
                }
                round += 1;
                pcx.scc_rounds += 1;
                if !changed {
                    break;
                }
                if round >= MAX_ROUNDS {
                    for k in a..b {
                        let f = (*order.add(k as usize));
                        if f < n && walkable(f, pcx) && view_fn(f, pcx) && decl_of(f, pcx) == 0 {
                            summary_store(f, top_summary(), pcx);
                        }
                    }
                    break;
                }
            }
            // (the findings: one more walk of each, against the summaries
            // of the last round)
            for k in a..b {
                let f = (*order.add(k as usize));
                if f >= n || !walkable(f, pcx) || !all && !view_fn(f, pcx) {
                    continue;
                }
                walk_fn(f, round, ocx, pcx);
                own_flush(pcx);
            }
        }
        // (functions made after the effects' graph: none, usually)
        for f in n..pcx.fns.len() as i64 {
            if walkable(f, pcx) {
                walk_kept(f, all, ocx, pcx);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// --print-views

// Every function's summary, a line each (`name: views(...)`), in FNS
// order: the program's functions, instances and closures (not templates,
// not std's own); like --print-effects.
pub fn print_views(out: i64, pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].generic > 0 || pcx.fns[f as usize].node == 0
            || pcx.fns[f as usize].module == pcx.std_module {
            continue;
        }
        if pcx.nodes[pcx.fns[f as usize].node as usize].kind != NodeKind::Fn {
            continue;
        }
        buf_bytes(out, crate::base::sym_text(pcx.fns[f as usize].display, pcx));
        buf_str(out, c": ");
        summary_text(out, f, summary_of(f, pcx), pcx);
        buf_str(out, c"\n");
    }
}
