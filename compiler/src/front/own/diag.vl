// The own pass's diagnostics (0.17, docs/design/value-semantics.md §2.9,
// §4 "Diagnostic codes"). Every one follows §2.9's contract: one line with
// the position, the code, what happened and the other position; a `help:`
// with the fix in words (and its text); `try:` lines that run as they are.
//
// How a finding is shown depends on --values (mod.vl, OWN_MODE):
// - off: the pass does not run;
// - report (the default until T7): it is recorded, and printed only
//   when --values=report is given (`note[own.moved]: ...`, then a count);
// - warn: a warning; error (the default from T7): an error.
//
// A message is built as an error is (err_* in base/diag): own_begin, then
// own_str/own_sym/own_type/own_pos, own_help, own_try, then own_end. The
// explain entries are tools/explain/own_table.vl.
//
// Phase 0 contract: the codes and these helpers are fixed; T1 reports
// own.moved, own.move_out, own.partial, own.drop_view; T2 own.conflict,
// own.escape, own.static, own.readonly; T3 own.views.

use crate::base::{
    STDERR, SYMS, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, put_try_lines, report_error_tries};
use crate::front::own::ctx::OwnCx;
use crate::front::types::buf_type;

// The codes (§4). own.readonly is new in Phase 0: a write through a `&T`
// or a `[T]` (U2).
pub const OWN_MOVED: i64 = 0;
pub const OWN_MOVE_OUT: i64 = 1;
pub const OWN_PARTIAL: i64 = 2;
pub const OWN_CONFLICT: i64 = 3;
pub const OWN_ESCAPE: i64 = 4;
pub const OWN_STATIC: i64 = 5;
pub const OWN_VIEWS: i64 = 6;
pub const OWN_DROP_VIEW: i64 = 7;
pub const OWN_READONLY: i64 = 8;
pub const OWN_DROP_CALL: i64 = 9;
pub const OWN_CODES: i64 = 10;

pub fn code_name(c: i64) -> *u8 {
    if c == OWN_MOVED { return c"own.moved"; }
    if c == OWN_MOVE_OUT { return c"own.move_out"; }
    if c == OWN_PARTIAL { return c"own.partial"; }
    if c == OWN_CONFLICT { return c"own.conflict"; }
    if c == OWN_ESCAPE { return c"own.escape"; }
    if c == OWN_STATIC { return c"own.static"; }
    if c == OWN_VIEWS { return c"own.views"; }
    if c == OWN_DROP_VIEW { return c"own.drop_view"; }
    if c == OWN_DROP_CALL { return c"own.drop_call"; }
    c"own.readonly"
}

// --values: off, report, warn, error.
pub const MODE_OFF: i64 = 0;
pub const MODE_REPORT: i64 = 1;
pub const MODE_WARN: i64 = 2;
pub const MODE_ERROR: i64 = 3;

// A finding's code carries this bit when it is a warning in every mode
// (own_soft).
const SOFT_BIT: i64 = 1 << 20;

// Starts a finding of code `code` at node n.
pub fn own_begin(n: i64, code: i64, pcx: inout Ctx<Comp>) {
    if pcx.diag_msg < 0 {
        pcx.diag_msg = buf_new();
        pcx.help = buf_new();
        pcx.try = buf_new();
    }
    buf_clear(pcx.diag_msg);
    buf_clear(pcx.help);
    buf_clear(pcx.try);
    pcx.m_node = n;
    pcx.m_code = code;
    pcx.m_soft = false;
}

pub fn own_str(s: *u8, pcx: Ctx<Comp>) {
    buf_str(pcx.diag_msg, s);
}

pub fn own_bytes(s: [u8], pcx: Ctx<Comp>) {
    buf_bytes(pcx.diag_msg, s);
}

// A name, quoted: 'v'.
pub fn own_sym(sym: i64, pcx: Ctx<Comp>) {
    buf_str(pcx.diag_msg, c"'");
    buf_bytes(pcx.diag_msg, SYMS[sym].text);
    buf_str(pcx.diag_msg, c"'");
}

pub fn own_type(t: i64, pcx: Ctx<Comp>) {
    buf_type(pcx.diag_msg, t, pcx);
}

// Node n's position, `LINE:COL` (the other position of the line).
pub fn own_pos(n: i64, pcx: inout Ctx<Comp>) {
    buf_position(pcx.diag_msg, pcx.nodes[n].start, &pcx);
}

pub fn own_help(s: *u8, pcx: Ctx<Comp>) {
    buf_str(pcx.help, s);
}

pub fn own_help_bytes(s: [u8], pcx: Ctx<Comp>) {
    buf_bytes(pcx.help, s);
}

// A `try:` line: a command that runs as it is (one call per line).
pub fn own_try(s: [u8], pcx: Ctx<Comp>) {
    if buf_slice(pcx.try).len > 0 {
        // (each line a try: of its own, as check prints them)
        buf_byte(pcx.try, '\n');
    }
    buf_bytes(pcx.try, s);
}

// The finding being built is a warning even under --values=error: a
// conflict that comes only from an assumed summary (design §7 V3).
pub fn own_soft(pcx: inout Ctx<Comp>) {
    pcx.m_soft = true;
}

// Ends the finding. It waits (PENDING) until the driver keeps the walk
// it came from (own_flush) or walks again (own_discard): a function walked
// twice, wider, or a fixed-point round that is not the last (T3).
pub fn own_end(pcx: inout Ctx<Comp>) {
    if pcx.own_mode == MODE_OFF {
        return;
    }
    let msg = buf_new();
    buf_bytes(msg, buf_slice(pcx.diag_msg));
    let help = buf_new();
    buf_bytes(help, buf_slice(pcx.help));
    let tries = buf_new();
    buf_bytes(tries, buf_slice(pcx.try));
    pcx.pending.push(pcx.nodes[pcx.m_node].start);
    pcx.pending.push(if pcx.m_soft { pcx.m_code | SOFT_BIT } else { pcx.m_code });
    pcx.pending.push(msg);
    pcx.pending.push(help);
    pcx.pending.push(tries);
}

// A finding in one call: the message, then ` (LINE:COL)` of node other
// when it is not 0.
pub fn own_error(n: i64, code: i64, msg: *u8, other: i64, pcx: inout Ctx<Comp>) {
    own_begin(n, code, &pcx);
    own_str(msg, pcx);
    if other > 0 {
        own_str(c" (", pcx);
        own_pos(other, &pcx);
        own_str(c")", pcx);
    }
    own_end(&pcx);
}

pub fn own_discard(pcx: inout Ctx<Comp>) {
    pcx.pending.count = 0;
}

// The findings waiting: recorded (report), warnings or errors, by
// OWN_MODE; once per position and code.
pub fn own_flush(pcx: inout Ctx<Comp>) {
    unsafe {
        var i = 0;
        while i < pcx.pending.count {
            let pos = pcx.pending.data[i];
            let soft = (pcx.pending.data[i + 1] & SOFT_BIT) != 0;
            let code = pcx.pending.data[i + 1] & ~SOFT_BIT;
            let msg = pcx.pending.data[i + 2];
            let help = pcx.pending.data[i + 3];
            let tries = pcx.pending.data[i + 4];
            i += 5;
            if code >= 0 && code < OWN_CODES {
                pcx.own_counts[code] += 1;
            }
            if pcx.own_mode == MODE_REPORT {
                let line = buf_new();
                buf_str(line, c"note[");
                buf_str(line, code_name(code));
                buf_str(line, c"]: ");
                buf_bytes(line, buf_slice(msg));
                buf_str(line, c"\n --> ");
                buf_position(line, pos, &pcx);
                buf_str(line, c"\n");
                if buf_slice(help).len > 0 {
                    buf_str(line, c"  = help: ");
                    buf_bytes(line, buf_slice(help));
                    buf_str(line, c"\n");
                }
                put_try_lines(line, buf_slice(tries));
                pcx.own_reports.push(line);
                continue;
            }
            let has_help = buf_slice(help).len > 0;
            buf_byte(msg, 0);
            buf_byte(help, 0);
            let h = if has_help { buf_slice(help).ptr } else { 0 as *u8 };
            report_error_tries(pos, 1000 + code, code_name(code), buf_slice(msg).ptr, h,
                buf_slice(tries), pcx.own_mode == MODE_WARN || soft, &pcx);
        }
        pcx.pending.count = 0;
    }
}

// --values=report: the findings recorded, then their count, on stderr.
pub fn print_reports(ocx: OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        for i in 0..pcx.own_reports.count {
            buf_bytes(out, buf_slice(pcx.own_reports.data[i]));
        }
        buf_str(out, c"own: ");
        buf_int(out, pcx.own_reports.count);
        buf_str(out, c" findings (");
        buf_int(out, ocx.walked);
        buf_str(out, c" functions walked, ");
        buf_int(out, pcx.skipped);
        buf_str(out, c" skipped, ");
        buf_int(out, ocx.visits);
        buf_str(out, c" node visits, ");
        buf_int(out, ocx.loop_rounds);
        buf_str(out, c" loop rounds)\n");
        buf_write_fd(out, STDERR);
    }
}
