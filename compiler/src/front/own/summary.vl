// View summaries (0.17, docs/design/value-semantics.md §2.4): for each
// function, which parameter roots its result's views come from, level by
// level, and what its `&mut` parameters' referents may come to hold.
//
// A mask has bit i for parameter i (at most 63 parameters are told apart;
// the rest count as all). The result's masks, ret[k], and the stores'
// masks, sto[k], are indexed by:
// - S_L1_P: level 1 of the value comes from parameter p's own level (`p`:
//   what the argument points into);
// - S_L1_STAR: level 1 comes from what p's views point into (`*p`);
// - S_L2_P, S_L2_STAR: the same for level 2.
// The stores' two levels are what the referents' new views point into
// (level 1) and what those hold (level 2).
//
// The text form rounds the masks up: a parameter is `p` when any of its
// four bits is set, `*p` when only its `*p` bits are. A declaration reads
// back the other way (`p`: all four bits; `*p`: the two `*p` bits), so a
// summary's text, pinned with #[views], always covers it.
//
// summary_of's order (the Phase 0 contract): a declaration (`#[views]`,
// `#[stores]`), else what infer.vl inferred, else the parametric floor
// of a generic result, else `top` (every level from every parameter). The
// type filter (infer.vl) narrows each of them: a level whose views are of
// type E comes only from parameters that can hold an E there (casts
// excepted, 0.25.3: cast_mask, declared or inferred).

use crate::base::{buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::report_error_once;
use crate::front::ast::{FN_CLOSURE, NodeKind, child};
use crate::front::effects::infer::template_of;
use crate::front::own::ctx::OwnCx;
use crate::front::own::infer::{filter_summary, param_carries};
use crate::front::own::kinds::{P_MUT, P_MUT_VIEW, is_view_type, param_mode};
use crate::front::parser::items::attrs::{STORES_FORM, views_of};
use crate::front::traits::{impl_of_fn, trait_fn};
use crate::front::types::{REF_MUT, REF_SHARED, TyKind, fn_param};

pub const S_L1_P: i64 = 0;
pub const S_L1_STAR: i64 = 1;
pub const S_L2_P: i64 = 2;
pub const S_L2_STAR: i64 = 3;

#[derive(Clone, Copy)] pub struct ViewSummary { pub ret: [i64; 4], pub sto: [i64; 4], pub top: bool, pub declared: bool }

pub fn empty_summary() -> ViewSummary {
    ViewSummary { ret: [0i64, 0, 0, 0], sto: [0i64, 0, 0, 0], top: false, declared: false }
}

// Every level from every parameter, for the result and the stores: what a
// function whose body was not walked (it failed to check) is taken to do.
pub fn top_summary() -> ViewSummary {
    ViewSummary { ret: [-1, -1, -1, -1], sto: [-1, -1, -1, -1], top: true, declared: false }
}

// a ⊔ b.
pub fn join_summary(a: ViewSummary, b: ViewSummary) -> ViewSummary {
    let mut r = a;
    for k in 0..4 {
        r.ret[k as usize] = a.ret[k as usize] | b.ret[k as usize];
        r.sto[k as usize] = a.sto[k as usize] | b.sto[k as usize];
    }
    r.top = a.top || b.top;
    r
}

// Whether a and b have the same masks.
pub fn same_summary(a: ViewSummary, b: ViewSummary) -> bool {
    for k in 0..4 {
        if a.ret[k as usize] != b.ret[k as usize] || a.sto[k as usize] != b.sto[k as usize] {
            return false;
        }
    }
    true
}

// Whether every bit of a is in b.
pub fn summary_within(a: ViewSummary, b: ViewSummary) -> bool {
    for k in 0..4 {
        if (a.ret[k as usize] & ~b.ret[k as usize]) != 0 || (a.sto[k as usize] & ~b.sto[k as usize]) != 0 {
            return false;
        }
    }
    true
}

// Records f's inferred summary (infer.vl's driver).
pub fn summary_store(f: i64, s: ViewSummary, pcx: &mut Ctx<Comp>) {
    unsafe {
        if f < 0 {
            return;
        }
        if pcx.stored_n <= f {
            let n = pcx.fns.len() as i64 + 64;
            let a = crate::base::alloc_array::<i64>(n * 9);
            for i in 0..pcx.stored_n * 9 {
                (*a.add(i as usize)) = (*pcx.stored.add(i as usize));
            }
            pcx.stored = a;
            pcx.stored_n = n;
        }
        let o = f * 9;
        for k in 0..4 {
            (*pcx.stored.add((o + k) as usize)) = s.ret[k as usize];
            (*pcx.stored.add((o + 4 + k) as usize)) = s.sto[k as usize];
        }
        (*pcx.stored.add((o + 8) as usize)) = if s.top { 2 } else { 1 };
    }
}

// Whether f has an inferred summary.
pub fn summary_inferred(f: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { f >= 0 && f < pcx.stored_n && (*pcx.stored.add((f * 9 + 8) as usize)) != 0 }
}

// f's inferred summary as stored (no filter), empty when there is none.
pub fn summary_stored(f: i64, pcx: &Ctx<Comp>) -> ViewSummary {
    unsafe {
        if !summary_inferred(f, pcx) {
            return empty_summary();
        }
        let o = f * 9;
        ViewSummary {
            ret: [(*pcx.stored.add(o as usize)), (*pcx.stored.add((o + 1) as usize)), (*pcx.stored.add((o + 2) as usize)), (*pcx.stored.add((o + 3) as usize))],
            sto: [(*pcx.stored.add((o + 4) as usize)), (*pcx.stored.add((o + 5) as usize)), (*pcx.stored.add((o + 6) as usize)), (*pcx.stored.add((o + 7) as usize))],
            top: (*pcx.stored.add((o + 8) as usize)) == 2, declared: false,
        }
    }
}

// Forgets the inferred summaries (a program checked again: `query`'s
// second reading).
pub fn summary_reset(pcx: &mut Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.stored_n * 9 {
            (*pcx.stored.add(i as usize)) = 0;
        }
        pcx.casts.count = 0;
    }
}

pub fn summary_store_casts(f: i64, m: i64, pcx: &mut Ctx<Comp>) {
    if f < 0 || m == 0 {
        return;
    }
    while pcx.casts.count <= f {
        pcx.casts.push(0);
    }
    pcx.casts.set(f, pcx.casts.get(f) | m);
}

// f's cast parameters (summary_store_casts), 0: none.
fn casts_of(f: i64, pcx: &Ctx<Comp>) -> i64 {
    if f >= 0 && f < pcx.casts.count { pcx.casts.get(f) } else { 0 }
}

// The summary callers of f use: its declaration, else what infer.vl
// inferred, else the parametric floor of a generic result, else top; each
// narrowed by the type filter.
pub fn summary_of(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    unsafe {
        if f < 0 || f >= pcx.fns.len() as i64 {
            return top_summary();
        }
        // (a result that holds no views, and no `&mut` parameter to store
        // into: views() by its type)
        if !view_fn(f, pcx) {
            return empty_summary();
        }
        if decl_of(f, pcx) != 0 {
            // (0.25.3) with its casts: parameters it names that the type
            // filter drops (cast_mask)
            let mut s = filter_summary(f, declared_summary(f, pcx), pcx);
            s.ret[S_L1_P as usize] |= cast_mask(f, pcx.fns[f as usize].ret, pcx);
            return s;
        }
        if f < pcx.stored_n && (*pcx.stored.add((f * 9 + 8) as usize)) != 0 {
            let o = f * 9;
            let mut s = filter_summary(f, ViewSummary {
                ret: [(*pcx.stored.add(o as usize)), (*pcx.stored.add((o + 1) as usize)), (*pcx.stored.add((o + 2) as usize)), (*pcx.stored.add((o + 3) as usize))],
                sto: [(*pcx.stored.add((o + 4) as usize)), (*pcx.stored.add((o + 5) as usize)), (*pcx.stored.add((o + 6) as usize)), (*pcx.stored.add((o + 7) as usize))],
                top: (*pcx.stored.add((o + 8) as usize)) == 2, declared: false,
            }, pcx);
            // (0.25.3) with the casts its body passes on (cast_mask)
            s.ret[S_L1_P as usize] |= cast_mask(f, pcx.fns[f as usize].ret, pcx);
            return s;
        }
        if pcx.fns[f as usize].is_extern {
            // (C returns raw pointers: no loans)
            return empty_summary();
        }
        filter_summary(f, floor_summary(f, pcx), pcx)
    }
}

// (0.25.3) The parameters whose loans f's result keeps past the type
// filter, which would drop them altogether: a cast, unsafe code viewing
// one element type as another (`gpu::f32s(b: [u8]) -> [f32]` is
// #[views(b)]; filtered, its result viewed nothing, and a buffer could be
// unmapped and rewritten under it). Of a declaration (of type ret), the
// parameters it names that the filter drops; of an inferred summary, those
// its body passed through such a cast (summary_store_casts) to a result
// that views them, e.g. `fn read(buf: inout Buffer, ..) -> [f32] {
// gpu::f32s(buf.map_read(dev)) }` views `buf`. Their level 1 is kept, by
// summary_of and by a call (calls::on_call adds their loans past the
// per-place filter, and passes them on: infer::col_cast); 0: none.
pub fn cast_mask(f: i64, ret: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if f < 0 || f >= pcx.fns.len() as i64 || !is_view_type(ret, pcx) {
        return 0;
    }
    if decl_of(f, pcx) != 0 {
        let d = declared_summary(f, pcx);
        let s = filter_summary(f, d, pcx);
        return d.ret[S_L1_P as usize] & ~(s.ret[S_L1_P as usize] | s.ret[S_L1_STAR as usize]);
    }
    let c = casts_of(f, pcx);
    if c == 0 {
        return 0;
    }
    let st = summary_stored(f, pcx);
    let s = filter_summary(f, st, pcx);
    (st.ret[S_L1_P as usize] | st.ret[S_L1_STAR as usize]) & c & ~(s.ret[S_L1_P as usize] | s.ret[S_L1_STAR as usize])
}

// Whether f's summary can be other than views(): its result holds views,
// or it has a `&mut` parameter whose referent can hold some (memoized:
// summary_of asks it at every call).
pub fn view_fn(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if f >= pcx.view_fn_n {
            let n = pcx.fns.len() as i64 + 64;
            let a = crate::base::alloc_array::<i64>(n);
            for i in 0..pcx.view_fn_n {
                (*a.add(i as usize)) = (*pcx.view_fn.add(i as usize));
            }
            pcx.view_fn = a;
            pcx.view_fn_n = n;
        }
        if (*pcx.view_fn.add(f as usize)) == 0 {
            (*pcx.view_fn.add(f as usize)) = if is_view_type(pcx.fns[f as usize].ret, pcx)
                || has_mut_ref_param(f, pcx) { 2 }
                else { 1 };
        }
        (*pcx.view_fn.add(f as usize)) == 2
    }
}

pub fn has_mut_ref_param(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    for i in 0..pcx.fns[f as usize].param_count {
        if store_param(f, i, pcx) {
            return true;
        }
    }
    false
}

// Whether parameter type t is a pointer to something that holds views, or
// a `&mut [T]` of view elements: a referent stores can go into.
pub fn is_mut_ref(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    if pcx.types[t as usize].kind == TyKind::Ptr {
        return pcx.types[t as usize].b != REF_SHARED && is_view_type(pcx.types[t as usize].a, pcx);
    }
    pcx.types[t as usize].kind == TyKind::Slice && pcx.types[t as usize].b == REF_MUT
        && is_view_type(pcx.types[t as usize].a, pcx)
}

// Whether parameter mode m writes what the argument points into: a
// referent stores go into (`&mut T`, a legacy `*T`, `&mut [T]`).
pub fn is_mut_mode(m: i64) -> bool {
    m == P_MUT || m == P_MUT_VIEW
}

// Whether parameter i of f is a closure's env (`*Env`, the first
// parameter of a closure that captures; closures/mod.vl), whose captures
// hold or borrow views: the body reads and changes the captured
// variables through it, so the walk takes it as an `inout` parameter
// (its stores are checked, own.escape, and summarized).
pub fn env_param(f: i64, i: i64, pcx: &mut Ctx<Comp>) -> bool {
    if i != 0 || f < 0 || pcx.fns[f as usize].param_count == 0 || pcx.fns[f as usize].node <= 0
        || (pcx.nodes[pcx.fns[f as usize].node as usize].p & FN_CLOSURE) == 0 {
        return false;
    }
    let t = fn_param(f, 0, pcx);
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Ptr {
        return false;
    }
    let e = pcx.types[t as usize].a;
    e > 0 && pcx.types[e as usize].kind == TyKind::Struct && pcx.structs[pcx.types[e as usize].a as usize].closure != 0
        && is_view_type(e, pcx)
}

// Whether parameter i of f holds a closure by value whose captures hold or
// borrow views (an `F` of a generic function's instance): calling it may
// store into what it captures, so stores go into it (store_param).
pub fn closure_param(f: i64, i: i64, pcx: &mut Ctx<Comp>) -> bool {
    let t = fn_param(f, i, pcx);
    t > 0 && pcx.types[t as usize].kind == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0
        && is_view_type(t, pcx)
}

pub fn closure_of_fn(f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if f == pcx.closure_of_f {
        return pcx.closure_of_c;
    }
    let mut c: i64 = -1;
    for i in 0..pcx.closures.len() as i64 {
        if pcx.closures[i as usize].f == f {
            c = i;
        }
    }
    pcx.closure_of_f = f;
    pcx.closure_of_c = c;
    c
}

// Whether field sym of closure function f's env holds a capture by
// reference (a pointer to the captured variable, `*(*env).x`): what the
// env's views point into, `*env`, not the env itself.
pub fn env_ref_field(f: i64, sym: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let c = closure_of_fn(f, pcx);
        if c < 0 {
            return false;
        }
        for j in 0..pcx.closures[c as usize].capture_count {
            let l = (*pcx.capture_list.data.add((pcx.closures[c as usize].captures + 2 * j) as usize));
            if pcx.locals[l as usize].name == sym {
                return (*pcx.capture_list.data.add((pcx.closures[c as usize].captures + 2 * j + 1) as usize)) != 0;
            }
        }
        false
    }
}

// Whether closure function f captures local l by reference.
pub fn captures_by_ref(f: i64, l: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let c = closure_of_fn(f, pcx);
        if c < 0 {
            return false;
        }
        for j in 0..pcx.closures[c as usize].capture_count {
            if (*pcx.capture_list.data.add((pcx.closures[c as usize].captures + 2 * j) as usize)) == l {
                return (*pcx.capture_list.data.add((pcx.closures[c as usize].captures + 2 * j + 1) as usize)) != 0;
            }
        }
        false
    }
}

// Whether parameter i of f is one stores go into: a `&mut` one (a legacy
// `*T` too) to what holds views, or a closure's env (env_param).
pub fn store_param(f: i64, i: i64, pcx: &mut Ctx<Comp>) -> bool {
    is_mut_ref(fn_param(f, i, pcx), pcx)
        && (is_mut_mode(param_mode(f, i, pcx)) || env_param(f, i, pcx))
        || closure_param(f, i, pcx)
}

// Whether f has a `&mut` parameter (a legacy `*T` too) to what holds
// views: not counting closures' (env_param, closure_param).
pub fn inout_target(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    for i in 0..pcx.fns[f as usize].param_count {
        if is_mut_ref(fn_param(f, i, pcx), pcx) && is_mut_mode(param_mode(f, i, pcx)) {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------------------
// The parametric floor (§2.4, "Generic results are parametric")

// The floor of f, a generic instance (§2.4, "Generic results are
// parametric"): a result made of its type parameters (ret_parametric)
// carries the T values its arguments hold (1: `T`, `Option<T>`, `(K, V)`,
// `Vec<T>`) or views of their T storage (2: `[T]`, another generic type),
// never loans its body makes; any other result is top. Its `&mut`
// parameters may come to hold the T values of every argument. `top` when
// f is not an instance.
pub fn floor_summary(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    if f < 0 || pcx.fns[f as usize].tmpl == 0 {
        return top_summary();
    }
    let p = ret_parametric(f, pcx);
    let mut s = empty_summary();
    for i in 0..pcx.fns[f as usize].param_count {
        let t = fn_param(f, i, pcx);
        if !param_carries(t, pcx) {
            continue;
        }
        let bit: i64 = if i >= 63 { -1 } else { 1 << i };
        let by_ref = t > 0 && pcx.types[t as usize].kind == TyKind::Ptr;
        if !by_ref || p == 2 && param_can_name_param(f, i, pcx) {
            // (a by-value argument holds its T values at its own level;
            // a view of T storage points into any argument's that can
            // hold a T: a by-reference one whose type can name one, 0.25.2)
            s.ret[S_L1_P as usize] |= bit;
        }
        s.ret[S_L1_STAR as usize] |= bit;
        s.ret[S_L2_STAR as usize] |= bit;
        if !by_ref {
            s.sto[S_L1_P as usize] |= bit;
            s.sto[S_L2_P as usize] |= bit;
        }
        s.sto[S_L1_STAR as usize] |= bit;
        s.sto[S_L2_STAR as usize] |= bit;
    }
    if p == 0 && is_view_type(pcx.fns[f as usize].ret, pcx) {
        for k in 0..4 {
            s.ret[k as usize] = -1;
        }
        s.top = true;
    }
    s
}

// Whether type node t (of a generic template whose type parameters are
// the list gens) can name a type parameter: a by-reference parameter
// whose type cannot name one holds no T value, so a parametric result views T
// storage in it only through a loan the body makes, which the floor
// leaves out (0.25.2: a let parameter `a: Arg` passed by reference, its
// type holding an array, is not viewed by `Command<CA>::arg`'s result).
// 0 (`self`) and what is not read here: it can.
fn type_can_name_param(t: i64, gens: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t <= 0 {
        return true;
    }
    let n = type_node(t, pcx);
    let k = n.kind;
    if k == NodeKind::TyName {
        if n.g == 0 {
            return n.a == self_type_sym(pcx) || is_generic_name(n.a, gens, pcx);
        }
        for i in 0..type_node(n.g, pcx).count {
            if type_can_name_param(child(n.g, i, pcx), gens, pcx) {
                return true;
            }
        }
        return n.a == self_type_sym(pcx) || is_generic_name(n.a, gens, pcx);
    }
    if k == NodeKind::TyTuple {
        for i in 0..n.count {
            if type_can_name_param(child(t, i, pcx), gens, pcx) {
                return true;
            }
        }
        return false;
    }
    if k == NodeKind::TySlice || k == NodeKind::TyPtr || k == NodeKind::TyArray {
        return type_can_name_param(n.a, gens, pcx);
    }
    !(k == NodeKind::TyUnit || k == NodeKind::TyNever)
}

fn self_type_sym(pcx: &mut Ctx<Comp>) -> i64 {
    intern_c(c"Self", pcx)
}

// Parameter i of generic instance f: whether its declared type can name
// a type parameter (type_can_name_param).
fn param_can_name_param(f: i64, i: i64, pcx: &mut Ctx<Comp>) -> bool {
    let tn = type_node_of_template(f, pcx);
    if tn <= 0 || i >= type_node(tn, pcx).count {
        return true;
    }
    type_can_name_param(type_node(child(tn, i, pcx), pcx).b, type_node(tn, pcx).g, pcx)
}

fn type_node_of_template(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is an instance (FNS[f].tmpl != 0, floor_summary's test), so
    // both f and its template (tmpl - 1) are below FN_COUNT.
    unsafe { pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node }
}

// Node n of a signature (a copy).
fn type_node(n: i64, pcx: &Ctx<Comp>) -> crate::front::ast::Node {
    pcx.nodes[n as usize]
}

// Whether generic function instance f's result type is made of its type
// parameters only (§2.4, parametric results): 0: not; 1: T values (`T`,
// `Option<T>`, `Result<T, E>`, `(K, V)`, an owned `Vec<T>`); 2: views of
// T storage (`[T]`, `*T`, another generic type such as `SliceIter<T>`).
pub fn ret_parametric(f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if f < 0 || pcx.fns[f as usize].tmpl == 0 {
        return 0;
    }
    let tn = pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node;
    if tn == 0 || pcx.nodes[tn as usize].g == 0 || pcx.nodes[tn as usize].b == 0 {
        return 0;
    }
    params_only(pcx.nodes[tn as usize].b, pcx.nodes[tn as usize].g, pcx)
}

fn is_generic_name(sym: i64, gens: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.nodes[gens as usize].count {
        if pcx.nodes[child(gens, i, pcx) as usize].a == sym {
            return true;
        }
    }
    false
}

// Whether sym names a primitive type (no views of its own).
fn is_primitive_name(sym: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let s = sym_text(sym, pcx);
        let names: [*mut u8; 14] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64",
            c"f32", c"f64", c"bool", c"usize", c"isize", c"char"];
        for k in 0..14 {
            let n = names[k as usize];
            let mut i: i64 = 0;
            while (*n.add(i as usize)) != 0 && i < s.len() as i64 && (*n.add(i as usize)) == s[i as usize] {
                i += 1;
            }
            if (*n.add(i as usize)) == 0 && i == s.len() as i64 {
                return true;
            }
        }
        false
    }
}

fn params_only(t: i64, gens: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.sym_option == 0 {
        pcx.sym_option = intern_c(c"Option", pcx);
        pcx.sym_result = intern_c(c"Result", pcx);
        pcx.summary_sym_vec = intern_c(c"Vec", pcx);
        pcx.summary_sym_hashmap = intern_c(c"HashMap", pcx);
    }
    let k = pcx.nodes[t as usize].kind;
    let mut r: i64 = 1;
    if k == NodeKind::TyName {
        let args = pcx.nodes[t as usize].g;
        let name = pcx.nodes[t as usize].a;
        if args == 0 {
            if is_generic_name(name, gens, pcx) || is_primitive_name(name, pcx) {
                return 1;
            }
            // (a type of its own, which may view anything: not made
            // of the parameters)
            return 0;
        }
        for i in 0..pcx.nodes[args as usize].count {
            let a = params_only(child(args, i, pcx), gens, pcx);
            if a == 0 {
                return 0;
            }
            if a > r {
                r = a;
            }
        }
        if name == pcx.sym_option || name == pcx.sym_result || name == pcx.summary_sym_vec
            || name == pcx.summary_sym_hashmap {
            return r;
        }
        // (another generic type: it may view its arguments' storage)
        return 2;
    }
    if k == NodeKind::TyTuple {
        for i in 0..pcx.nodes[t as usize].count {
            let a = params_only(child(t, i, pcx), gens, pcx);
            if a == 0 {
                return 0;
            }
            if a > r {
                r = a;
            }
        }
        return r;
    }
    if k == NodeKind::TySlice || k == NodeKind::TyPtr {
        if params_only(pcx.nodes[t as usize].a, gens, pcx) == 0 {
            return 0;
        }
        return 2;
    }
    if k == NodeKind::TyUnit || k == NodeKind::TyNever { 1 } else { 0 }
}

// ---------------------------------------------------------------------------
// Declarations

// The parameter of f named sym, -1.
pub fn param_named(f: i64, sym: i64, pcx: &Ctx<Comp>) -> i64 {
    let item = pcx.fns[f as usize].node;
    for i in 0..pcx.nodes[item as usize].count {
        if pcx.nodes[child(item, i, pcx) as usize].a == sym {
            return i;
        }
    }
    -1
}

// The declaration that binds f (its first views/stores EffectSet node, 0:
// none): f's own, else its trait method's (§2.4: a declaration on a
// trait's method binds every impl). DECL_NAMES gets the Fn node whose
// parameter names it uses (memoized per function).
pub fn decl_of(f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if f < 0 {
            return 0;
        }
        if f >= pcx.decl_n {
            let n = pcx.fns.len() as i64 + 64;
            let a = crate::base::alloc_array::<i64>(n * 2);
            for i in 0..pcx.decl_n * 2 {
                (*a.add(i as usize)) = (*pcx.decl_memo.add(i as usize));
            }
            pcx.decl_memo = a;
            pcx.decl_n = n;
        }
        if (*pcx.decl_memo.add((f * 2) as usize)) == 0 {
            let mut d = pcx.fns[f as usize].views_decl;
            let mut names = pcx.fns[f as usize].node;
            if d == 0 && pcx.fns[f as usize].tmpl != 0 {
                // (an instance: its template's declaration, `#[views]` on
                // std's generic functions)
                let t = template_of(f, pcx);
                d = pcx.fns[t as usize].views_decl;
                if d != 0 {
                    names = pcx.fns[t as usize].node;
                }
            }
            if d == 0 && pcx.fns[f as usize].node != 0 {
                let i = impl_of_fn(template_of(f, pcx), pcx);
                if i >= 0 && pcx.traits_impls[i as usize].tr >= 0 {
                    let tf = trait_fn(pcx.traits_impls[i as usize].tr, pcx.nodes[pcx.fns[f as usize].node as usize].a, pcx);
                    if tf != 0 && views_of(tf, pcx) != 0 {
                        d = views_of(tf, pcx);
                        names = tf;
                    }
                }
            }
            (*pcx.decl_memo.add((f * 2) as usize)) = d + 1;
            (*pcx.decl_memo.add((f * 2 + 1) as usize)) = names;
        }
        pcx.decl_names = (*pcx.decl_memo.add((f * 2 + 1) as usize));
        (*pcx.decl_memo.add((f * 2) as usize)) - 1
    }
}

// f's declared summary: `#[views(a, *b)]` puts a at every level (S_L1_P,
// S_L1_STAR, S_L2_P, S_L2_STAR), b at S_L1_STAR and S_L2_STAR; `#[stores(..)]`
// the same for the stores. Names that are no parameter count for nothing
// (validate_views_decls reports them). A declaration without
// `#[stores]` stores nothing; one without `#[views]` returns no views.
pub fn declared_summary(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    let mut s = empty_summary();
    s.declared = true;
    let mut d = decl_of(f, pcx);
    let names = pcx.decl_names;
    while d != 0 {
        let stores = pcx.nodes[d as usize].c == STORES_FORM;
        for k in 0..pcx.nodes[d as usize].count {
            let item = child(d, k, pcx);
            let i = node_param_named(names, pcx.nodes[item as usize].a, pcx);
            if i < 0 {
                continue;
            }
            let bit: i64 = if i >= 63 { -1 } else { 1 << i };
            let star = pcx.nodes[item as usize].b != 0;
            for lv in 0..4 {
                if star && (lv == S_L1_P || lv == S_L2_P) {
                    continue;
                }
                if stores {
                    s.sto[lv as usize] |= bit;
                } else {
                    s.ret[lv as usize] |= bit;
                }
            }
        }
        d = pcx.nodes[d as usize].b;
    }
    s
}

// The parameter of Fn node item named sym, -1.
fn node_param_named(item: i64, sym: i64, pcx: &Ctx<Comp>) -> i64 {
    for i in 0..pcx.nodes[item as usize].count {
        if pcx.nodes[child(item, i, pcx) as usize].a == sym {
            return i;
        }
    }
    -1
}

// Whether f's declaration has a `#[views]` part (else: views()), a
// `#[stores]` part (else: stores()).
pub fn declares(f: i64, stores: bool, pcx: &mut Ctx<Comp>) -> bool {
    let mut d = decl_of(f, pcx);
    while d != 0 {
        if (pcx.nodes[d as usize].c == STORES_FORM) == stores {
            return true;
        }
        d = pcx.nodes[d as usize].b;
    }
    false
}

// The declaration of #[views]/#[stores] of every function, against its
// parameter names (check_own, in every mode).
pub fn validate_views_decls(pcx: &mut Ctx<Comp>) {
    let views = intern_c(c"views", pcx);
    for f in 0..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].tmpl != 0 {
            continue;
        }
        let mut d = pcx.fns[f as usize].views_decl;
        while d != 0 {
            for k in 0..pcx.nodes[d as usize].count {
                let item = child(d, k, pcx);
                if param_named(f, pcx.nodes[item as usize].a, pcx) < 0 {
                    let m = buf_new();
                    buf_fmt(m,
                        format_args("'{}' has no parameter '{}'",
                            str::from_utf8(sym_text(pcx.fns[f as usize].display, pcx)).unwrap(),
                            str::from_utf8(sym_text(pcx.nodes[item as usize].a, pcx)).unwrap()));
                    buf_byte(m, 0);
                    report_error_once(pcx.nodes[item as usize].start, views, c"own.views", buf_slice(m).ptr, c"#[views(...)] and #[stores(...)] name parameters (`self`, `p`) or what their views point into (`*p`)", b"", pcx);
                }
            }
            d = pcx.nodes[d as usize].b;
        }
    }
}

// ---------------------------------------------------------------------------
// Text

// The parameters of masks m (the four of one summary part), rounded up:
// `p` when any of p's bits is set, `*p` when only its `*p` bits are.
pub fn put_params(out: i64, f: i64, m: [i64; 4], pcx: &Ctx<Comp>) -> bool {
    let item = pcx.fns[f as usize].node;
    let p_mask = m[S_L1_P as usize] | m[S_L2_P as usize];
    let star_mask = m[S_L1_STAR as usize] | m[S_L2_STAR as usize];
    let mut first = true;
    for i in 0..pcx.nodes[item as usize].count {
        let bit: i64 = if i >= 63 { -1 } else { 1 << i };
        let name = pcx.nodes[child(item, i, pcx) as usize].a;
        if (p_mask & bit) == 0 && (star_mask & bit) == 0 {
            continue;
        }
        if !first {
            buf_str(out, c", ");
        }
        if (p_mask & bit) == 0 {
            buf_str(out, c"*");
        }
        buf_bytes(out, sym_text(name, pcx));
        first = false;
    }
    !first
}

// Summary s of function f as text: `views(self)`, `views(*self)`,
// `views(s, *t) stores(word)`, `views()`; then ` declared` for a
// declaration, ` assumed` for top.
pub fn summary_text(out: i64, f: i64, s: ViewSummary, pcx: &mut Ctx<Comp>) {
    buf_str(out, c"views(");
    put_params(out, f, s.ret, pcx);
    buf_str(out, c")");
    if (s.sto[0] | s.sto[1] | s.sto[2] | s.sto[3]) != 0 && has_mut_ref_param(f, pcx) {
        buf_str(out, c" stores(");
        put_params(out, f, s.sto, pcx);
        buf_str(out, c")");
    }
    if s.declared {
        buf_str(out, c" declared");
    } else if s.top {
        buf_str(out, c" assumed");
    }
}

// The declaration of f parsed into a summary (Phase 0's name in the
// design: parse_views_attr).
pub fn parse_views_attr(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    declared_summary(f, pcx)
}

// ---------------------------------------------------------------------------
// Collection: the walk's results and `&mut` parameters' slots at the exits
// make the summary walk_fn returns (infer.vl does the work).

// The walk of f (round `round` of its SCC) begins.
pub fn collect_begin(f: i64, round: i64, pcx: &mut Ctx<Comp>) {
    crate::front::own::infer::col_begin(f, round, pcx);
}

// The function's result at node e, its origin v (-1: none): an exit.
pub fn collect_result(e: i64, v: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) {
    crate::front::own::infer::col_result(e, v, ocx, pcx);
}

// The walk of f ended: the summary its body makes.
pub fn collect_end(f: i64, pcx: &mut Ctx<Comp>) -> ViewSummary {
    crate::front::own::infer::col_end(f, pcx)
}
