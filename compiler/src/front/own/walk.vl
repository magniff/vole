// The own walk (0.17, docs/design/value-semantics.md §4 step 4): a forward
// abstract interpretation of one checked function body, in the grammar's
// evaluation order (left to right, the right-hand side before the place,
// an index before its base is read, a `&mut self` receiver after the
// arguments). It is the prototype's traversal (c17-proto, §8.1) with every
// rule taken out into the event hooks below:
//
//   ev_read    a place is read, or borrowed (T1: use after move; T2: an
//              invalidated view used)
//   ev_write   a place is written, or mutably borrowed (T2: invalidation)
//   ev_move    an owned place is moved (T1: the moved bits; T2: its views
//              invalidated)
//   ev_init    a place is (re)initialized (T1)
//   ev_drop    a local's drop runs at an exit (T1: drop states; T2)
//   ev_borrow  `&place`, `&mut place`: the loan and its origin (T2)
//   ev_value   the views a value read out of a place holds (T2)
//   ev_bind    a local is bound to a value (T1: initialized; T2: its slot)
//   ev_assign  an assignment's place, after its value (T1, T2)
//   ev_scope   a scope ends: its locals die (T2)
//   ev_call    a call, its arguments pending (T2: conflicts, stores,
//              statics, the result's origin through summary_of)
//   ev_result  the function's result, at a `return` or the tail (T2:
//              escapes; T3: the summary)
//
// moves.vl (T1) and views.vl/calls.vl (T2) implement the hooks;
// summary.vl (T3) collects the result's summary. The traversal (control
// flow: if and match join, loops iterate to a fixed point, break/continue/
// return feed their targets, defers and drops share one exit list) is the
// lead's: neither task changes it without the lead.
//
// Phase 0 contract: walk_fn and the ev_* signatures are fixed.

use crate::base::{intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    CLOSURE_MOVE, FN_CLOSURE, NODE_CAPTURE, NODE_IN_BOUNDS, NODE_RAW, NODE_REF_MUT, NodeKind, child,
};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::own::{calls, fast, moves, views};
use crate::front::own::ctx::OwnCx;
use crate::front::own::glue::has_glue;
use crate::front::own::kinds::{
    P_MUT, P_MUT_VIEW, P_RAW, P_SHARED, P_VALUE, P_VIEW, has_drop_impl, is_moved_type,
    is_owned_type, is_view_type, param_mode,
};
use crate::front::own::state::{
    MAXNW, PK_MUT, PK_MUT_VIEW, PK_NONE, PK_RAW, PK_RESERVE, PK_SHARED, PK_VIEW, RK_STATIC,
    TUPLE_FIELD, alias_local, child_place, copy_state, is_empty, join_state, l1, l2, local_place,
    new_ov, new_state, or_into, ov_inner, ov_or, pend_push, reachable, reset_places, root_of,
    same_state, set_bit, set_unreachable, set_words, slot_for, static_has_place, static_place,
    variant_field_key,
};
use crate::front::own::summary::{
    ViewSummary, collect_begin, collect_end, collect_result, env_param,
};
use crate::front::patterns::binds_ref;
use crate::front::types::{REF_MUT, REF_SHARED, TyKind};

// The value of an expression is read (a copy, or a borrow) or moved.
pub const CX_READ: i64 = 0;
pub const CX_MOVE: i64 = 1;

// How a move leaves its place (ev_move): a local or a field of one; out of
// an index, through a pointer or reference, out of a static (all errors,
// T1's own.move_out).
pub const MO_PLACE: i64 = 0;
pub const MO_INDEX: i64 = 1;
pub const MO_DEREF: i64 = 2;
pub const MO_STATIC: i64 = 3;

// How a write reaches its place (ev_write).
pub const W_WRITE: i64 = 0;
pub const W_MOVE: i64 = 1;
pub const W_DROP: i64 = 2;
pub const W_MUT_BORROW: i64 = 3;

// ---------------------------------------------------------------------------
// The events

pub fn ev_read(p: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if p < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    moves::on_read(p, n, &ocx, &pcx);
    views::on_read(p, n, &ocx, &pcx);
}

pub fn ev_write(p: i64, n: i64, how: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if p < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    views::on_write(p, n, how, &ocx, &pcx);
}

pub fn ev_move(p: i64, n: i64, how: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if p < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    if ocx.no_move > 0 {
        ev_read(p, n, &ocx, &pcx);
        return;
    }
    moves::on_move(p, n, how, &ocx, &pcx);
    if how == MO_PLACE {
        views::on_write(p, n, W_MOVE, &ocx, &pcx);
    }
}

pub fn ev_init(p: i64, ocx: inout OwnCx) {
    if p < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    moves::on_init(p, &ocx);
}

// (0.26.2) Local l dropped at an exit of its scope (at: its binding): its
// views end there, "was dropped" (views.vl H_DROP). The places IR places
// and decides the drop; the walk sees where the scope's owned locals end,
// under --values=error: a local whose type has glue (glue.vl), but not one
// that borrows what it holds (BYREF).
pub fn ev_drop(l: i64, at: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if l < 0 || at < 0 || !reachable(ocx.cur, ocx) || !crate::front::own::drops::drops_on(pcx)
        || pcx.byref.get(l + 1) != 0 {
        return;
    }
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l >= 0 is a local the checker defined (a binding or a
    // parameter of the function walked), below its count; one thread.
    let glue = unsafe { has_glue(pcx.locals[l].ty, &pcx) };
    if glue {
        views::on_write(local_place(l, &ocx, pcx), at, W_DROP, &ocx, &pcx);
    }
}

// (0.26.2) The drops at an exit of the scopes whose bindings are
// BOUND[mark..], last first (ev_drop); with `params`, at the end of the
// function's body: then its parameters', last first.
fn drop_bound(mark: i64, params: bool, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    var i = ocx.bound.count - 1;
    while i >= mark {
        let l = ocx.bound.get(i);
        ev_drop(l, ocx.bind_at.get(l + 1) - 1, &ocx, &pcx);
        i -= 1;
    }
    if params {
        // UNSAFE: FNS is the checker's raw table of functions.
        // SAFETY: CUR_F is the function walked, below FN_COUNT; one thread.
        let item = unsafe { pcx.fns[ocx.cur_f].node };
        var j = pcx.nodes[item].count - 1;
        while j >= 0 {
            let p = child(item, j, pcx);
            ev_drop(pcx.nodes[p].x, p, &ocx, &pcx);
            j -= 1;
        }
    }
}

// `&p` (kind REF_SHARED) or `&mut p` (REF_MUT) at node n; dst (an origin
// value, or -1) gets the loan. raw: p is reached through a raw pointer.
pub fn ev_borrow(p: i64, n: i64, kind: i64, raw: bool, dst: i64, ocx: inout OwnCx,
    pcx: inout Ctx<Comp>) {
    if p < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    ev_read(p, n, &ocx, &pcx);
    if kind == REF_MUT {
        views::on_write(p, n, W_MUT_BORROW, &ocx, &pcx);
    }
    views::on_borrow(p, n, kind, raw, dst, &ocx, &pcx);
}

// The value read out of place p at node n, of type ty: dst gets the views
// it holds (PO_* say how p was reached).
pub fn ev_value(p: i64, n: i64, ty: i64, dst: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    if p < 0 || dst < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    views::on_value(p, n, ty, dst, &ocx, pcx);
}

// Local l bound at node n to a value of origin v (-1: none).
pub fn ev_bind(l: i64, n: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if l < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    ocx.bound.push(l);
    ocx.bind_at.put(l + 1, n + 1);
    views::on_bind(l, n, v, &ocx, &pcx);
    if is_moved_type(pcx.locals[l].ty, &pcx) {
        ev_init(local_place(l, &ocx, pcx), &ocx);
    }
}

// Assignment n (`=` or `op=`) to place p, its value's origin v.
pub fn ev_assign(p: i64, n: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if p < 0 || !reachable(ocx.cur, ocx) {
        return;
    }
    let compound = pcx.nodes[n].op != Tok::Eq;
    if ocx.po_viewslot < 0 && !ocx.po_raw && compound {
        ev_read(p, n, &ocx, &pcx);
    }
    if !compound {
        // (0.18.1: an owned copy that borrows, replaced: its old value
        // dropped)
        moves::byref_change(p, n, pcx.nodes[pcx.nodes[n].b].ty, ocx, &pcx);
    }
    views::on_assign(p, n, v, &ocx, &pcx);
    if !compound && !ocx.po_index && !ocx.po_deref {
        moves::partial_assign(p, n, &ocx, &pcx);
        ev_init(p, &ocx);
    }
}

// The end of a scope whose bindings are BOUND[mark..]: they die; v is the
// origin of the scope's value (-1: none), tail its node (0: none).
pub fn ev_scope(mark: i64, v: i64, tail: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if reachable(ocx.cur, ocx) {
        views::on_scope_end(mark, v, tail, &ocx, &pcx);
    }
    ocx.bound.count = mark;
}

// Call n of function f (-1: through a fn value), its arguments pending at
// PEND[base..]; dst gets the result's views.
pub fn ev_call(n: i64, f: i64, base: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    calls::on_call(n, f, base, dst, &ocx, &pcx);
}

// The function's result: e its node (a `return`'s value, the tail, or the
// return or body when there is none), v its origin (-1: none).
pub fn ev_result(e: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if !reachable(ocx.cur, ocx) {
        return;
    }
    views::on_result(e, v, &ocx, &pcx);
    collect_result(e, v, ocx, &pcx);
}

// ---------------------------------------------------------------------------
// Places

// A local whose place matters even unborrowed: it holds views or owns, or
// is a parameter (reads through it reach its roots).
fn relevant_local(l: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        if l < 0 {
            return false;
        }
        if l < ocx.loc_cap && (ocx.loc_pl[l] != 0 || ocx.loc_slot[l] != 0) {
            return true;
        }
        pcx.locals[l].is_param || is_moved_type(pcx.locals[l].ty, &pcx)
    }
}

fn clear_po(make: bool, ocx: inout OwnCx) {
    ocx.po_deref = false;
    ocx.po_index = false;
    ocx.po_raw = false;
    ocx.po_inner = false;
    ocx.po_viewslot = -1;
    ocx.po_make = make;
}

// The place expression e denotes (its index expressions evaluated), or -1;
// sets PO_*.
pub fn place_of(e: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    clear_po(false, &ocx);
    place_rec(e, &ocx, &pcx)
}

// place_of, making the places of plain locals and statics (a loan is taken
// on it).
pub fn place_of_make(e: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    clear_po(true, &ocx);
    let p = place_rec(e, &ocx, &pcx);
    ocx.po_make = false;
    p
}

// Whether pointer expression e is a reference or a borrow (safe to
// dereference), not raw.
fn is_reference(e: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[e].ty > 0 && pcx.types[pcx.nodes[e].ty].kind == TyKind::Ptr
        && pcx.types[pcx.nodes[e].ty].b != 0 {
        return true;
    }
    if pcx.nodes[e].kind == NodeKind::FieldAccess && pcx.nodes[e].y == 1 && pcx.nodes[e].a > 0
        && (pcx.nodes[e].p & NODE_CAPTURE) == 0 && env_local(pcx.nodes[e].a, ocx, &pcx) {
        // (a closure's capture by reference, `(*env).x`: the captured
        // variable itself, env_ref_field)
        return true;
    }
    pcx.nodes[e].kind == NodeKind::Ident && pcx.nodes[e].res == Res::Local
        && pcx.nodes[e].y >= 0 && (pcx.locals[pcx.nodes[e].y].borrow || env_local(e, ocx, &pcx))
}

// Whether e names the walked closure's env parameter (summary::env_param):
// a reference to the closure's value, its captures.
pub fn env_local(e: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        pcx.nodes[e].kind == NodeKind::Ident && pcx.nodes[e].res == Res::Local
            && ocx.param_locals.count > 0 && pcx.nodes[e].y == ocx.param_locals.data[0]
            && env_param(ocx.cur_f, 0, &pcx)
    }
}

fn place_rec(e: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let k = pcx.nodes[e].kind;
        if k == NodeKind::Ident {
            if pcx.nodes[e].res == Res::Local {
                let l = pcx.nodes[e].y;
                if !ocx.po_make && !relevant_local(l, ocx, &pcx) {
                    return -1;
                }
                return local_place(l, &ocx, pcx);
            }
            if pcx.nodes[e].res == Res::Static {
                let s = pcx.nodes[e].y;
                if !ocx.po_make && !static_has_place(s, ocx) {
                    return -1;
                }
                return static_place(s, &ocx, pcx);
            }
            return -1;
        }
        if k == NodeKind::FieldAccess {
            let base = place_rec(pcx.nodes[e].a, &ocx, &pcx);
            if pcx.nodes[e].y == 1 {
                ocx.po_deref = true;
                if !is_reference(pcx.nodes[e].a, ocx, &pcx) {
                    ocx.po_raw = true;
                }
            }
            return child_place(base, pcx.nodes[e].b, &ocx, pcx);
        }
        if k == NodeKind::TupleField {
            let base = place_rec(pcx.nodes[e].a, &ocx, &pcx);
            return child_place(base, TUPLE_FIELD + pcx.nodes[e].b, &ocx, pcx);
        }
        if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
            ocx.po_deref = true;
            if !is_reference(pcx.nodes[e].b, ocx, &pcx) {
                ocx.po_raw = true;
            }
            return place_rec(pcx.nodes[e].b, &ocx, &pcx);
        }
        if k == NodeKind::Index {
            // (the index first: the 0.14 order)
            let deref = ocx.po_deref;
            let index = ocx.po_index;
            let raw = ocx.po_raw;
            let inner = ocx.po_inner;
            let vs = ocx.po_viewslot;
            let make = ocx.po_make;
            let vd = ocx.po_value_dst;
            ocx.po_value_dst = -1;
            eval(pcx.nodes[e].b, CX_READ, -1, &ocx, &pcx);
            ocx.po_value_dst = vd;
            ocx.po_make = make;
            ocx.po_deref = deref;
            ocx.po_index = index;
            ocx.po_raw = raw;
            ocx.po_inner = inner;
            ocx.po_viewslot = vs;
            let base = pcx.nodes[e].a;
            let bt = pcx.nodes[base].ty;
            let p = place_rec(base, &ocx, &pcx);
            ocx.po_index = true;
            if bt > 0 && pcx.types[bt].kind == TyKind::Slice {
                ocx.po_deref = true;
                ocx.po_inner = true;
                if p >= 0 && ocx.pl_parent[p] < 0 {
                    ocx.po_viewslot = crate::front::own::state::slot_of_place(p, ocx);
                }
            } else if bt > 0 && pcx.types[bt].kind == TyKind::Ptr {
                ocx.po_deref = true;
                if (pcx.nodes[e].p & NODE_RAW) != 0 || !is_reference(base, ocx, &pcx) {
                    ocx.po_raw = true;
                }
            }
            return p;
        }
        // (a value: a call's result, a literal; under `&`, what the
        // loan views: `&v[i]` of a Vec is `&v.as_slice()[i]`)
        let d = ocx.po_value_dst;
        ocx.po_value_dst = -1;
        // (0.25: what the value's own evaluation finds on its way is not this
        // place's: PO_* as they were)
        let deref = ocx.po_deref;
        let index = ocx.po_index;
        let raw = ocx.po_raw;
        let inner = ocx.po_inner;
        let vs = ocx.po_viewslot;
        let make = ocx.po_make;
        eval(e, CX_READ, d, &ocx, &pcx);
        ocx.po_deref = deref;
        ocx.po_index = index;
        ocx.po_raw = raw;
        ocx.po_inner = inner;
        ocx.po_viewslot = vs;
        ocx.po_make = make;
        -1
    }
}

fn is_place_expr(e: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident {
        return pcx.nodes[e].res == Res::Local || pcx.nodes[e].res == Res::Static;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return pcx.nodes[e].y == 1 || is_place_expr(pcx.nodes[e].a, pcx);
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e].op == Tok::Star;
    }
    if k == NodeKind::Index {
        return pcx.nodes[pcx.nodes[e].b].kind != NodeKind::Range;
    }
    false
}

// ---------------------------------------------------------------------------
// Expressions

fn eval_list(n: i64, ctx: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    for i in 0..pcx.nodes[n].count {
        eval(child(n, i, pcx), ctx, dst, &ocx, &pcx);
    }
}

// Evaluates expression n (0: none); ctx says whether its value is moved;
// dst (an origin value, or -1) gets the views it holds.
pub fn eval(n: i64, ctx: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if n == 0 {
            return;
        }
        ocx.visits += 1;
        match pcx.nodes[n].kind {
            NodeKind::Ident | NodeKind::FieldAccess
                | NodeKind::TupleField => eval_place_value(n, ctx, dst, &ocx, &pcx),
            NodeKind::Unary => {
                let op = pcx.nodes[n].op;
                if op == Tok::Star {
                    eval_place_value(n, ctx, dst, &ocx, &pcx);
                } else if op == Tok::Amp {
                    let operand = pcx.nodes[n].b;
                    if is_place_expr(operand, pcx) {
                        ocx.po_value_dst = dst;
                        let p = place_of_make(operand, &ocx, &pcx);
                        ocx.po_value_dst = -1;
                        let kind = if (pcx.nodes[n].p & NODE_REF_MUT) != 0 { REF_MUT }
                            else { REF_SHARED };
                        ev_borrow(p, n, kind, ocx.po_raw, dst, &ocx, &pcx);
                    } else if dst >= 0 {
                        // (0.25) `&temp`: a loan on a value no place holds;
                        // what it holds is at both levels (a method of the
                        // temporary reads it through the loan, `*self`)
                        let t = new_ov(&ocx);
                        eval(operand, CX_READ, t, &ocx, &pcx);
                        crate::front::own::calls::deep_into(dst, t, &ocx);
                        ocx.pool_top = t;
                        // and, when it has storage of its own (an owner, or
                        // plain data: not only views), the temporary itself,
                        // which dies at the end of the statement
                        let ot = pcx.nodes[operand].ty;
                        if ot > 0 && (is_owned_type(ot, &pcx) || !is_view_type(ot, &pcx)) {
                            let q = crate::front::own::state::temp_place(operand, &ocx, pcx);
                            if q >= 0 {
                                set_bit(l1(dst, &ocx), q);
                                ocx.temps.push(q);
                            }
                        }
                    } else {
                        eval(operand, CX_READ, dst, &ocx, &pcx);
                    }
                } else {
                    eval(pcx.nodes[n].b, CX_READ, -1, &ocx, &pcx);
                }
            }
            NodeKind::Index => {
                if pcx.nodes[pcx.nodes[n].b].kind == NodeKind::Range {
                    eval_slicing(n, dst, &ocx, &pcx);
                } else {
                    eval_place_value(n, ctx, dst, &ocx, &pcx);
                }
            }
            NodeKind::Cast => eval(pcx.nodes[n].a, CX_READ, dst, &ocx, &pcx),
            NodeKind::Binary => {
                eval(pcx.nodes[n].b, CX_READ, -1, &ocx, &pcx);
                let op = pcx.nodes[n].op;
                if op == Tok::AmpAmp || op == Tok::PipePipe {
                    let saved = new_state(&ocx);
                    copy_state(saved, ocx.cur, &ocx);
                    eval(pcx.nodes[n].c, CX_READ, -1, &ocx, &pcx);
                    join_state(ocx.cur, saved, &ocx);
                    ocx.pool_top = saved;
                } else {
                    eval(pcx.nodes[n].c, CX_READ, -1, &ocx, &pcx);
                }
            }
            NodeKind::Assign => eval_assign(n, &ocx, &pcx),
            NodeKind::Call => {
                let ok = ocx.borrow_ok == n;
                eval_call(n, dst, &ocx, &pcx);
                moves::drop_call(n, ocx, &pcx);
                if ctx == CX_MOVE && !ok && !within_std(pcx.fns[ocx.cur_f].module, pcx)
                    && crate::front::own::byref::borrowed_call(n, &pcx) {
                    // (a copy of an element a collection keeps, moved:
                    // returned, stored, passed by value)
                    crate::front::own::moves::borrowed_move(n, ocx, &pcx);
                }
            }
            NodeKind::Block => eval_block(n, ctx, dst, &ocx, &pcx),
            NodeKind::If => {
                eval(pcx.nodes[n].a, CX_READ, -1, &ocx, &pcx);
                let saved = new_state(&ocx);
                copy_state(saved, ocx.cur, &ocx);
                eval(pcx.nodes[n].b, ctx, dst, &ocx, &pcx);
                let then_state = new_state(&ocx);
                copy_state(then_state, ocx.cur, &ocx);
                copy_state(ocx.cur, saved, &ocx);
                eval(pcx.nodes[n].c, ctx, dst, &ocx, &pcx);
                join_state(ocx.cur, then_state, &ocx);
                ocx.pool_top = saved;
            }
            NodeKind::Match => {
                // (0.25: let-else on a borrowed copy, `let Some(t) = v.last()
                // else ..`: its bindings borrow, read as its value, as `?`'s)
                if crate::front::own::byref::borrowed_call(n, &pcx) {
                    let ok = ocx.borrow_ok == n;
                    let value = pcx.nodes[child(n, 0, pcx)].c;
                    let saved = ocx.le_read;
                    ocx.le_read = value;
                    eval_match(n, CX_READ, dst, &ocx, &pcx);
                    ocx.le_read = saved;
                    if ctx == CX_MOVE && !ok && !within_std(pcx.fns[ocx.cur_f].module, pcx) {
                        crate::front::own::moves::borrowed_move(n, ocx, &pcx);
                    }
                } else {
                    eval_match(n, ctx, dst, &ocx, &pcx);
                }
            }
            NodeKind::Loop | NodeKind::While | NodeKind::For => eval_loop(n, &ocx, &pcx),
            NodeKind::Break => {
                let lp = pcx.nodes[n].x;
                eval(pcx.nodes[n].b, CX_MOVE, -1, &ocx, &pcx);
                let f = find_frame(lp, ocx);
                if f >= 0 {
                    drop_bound(ocx.loopf.data[f + 3], false, &ocx, &pcx);
                    join_state(ocx.loopf.data[f + 1], ocx.cur, &ocx);
                }
                set_unreachable(ocx.cur, &ocx);
            }
            NodeKind::Continue => {
                let f = find_frame(pcx.nodes[n].x, ocx);
                if f >= 0 {
                    drop_bound(ocx.loopf.data[f + 3], false, &ocx, &pcx);
                    join_state(ocx.loopf.data[f + 2], ocx.cur, &ocx);
                }
                set_unreachable(ocx.cur, &ocx);
            }
            NodeKind::Return => {
                let v = new_ov(&ocx);
                eval(pcx.nodes[n].a, CX_MOVE, v, &ocx, &pcx);
                if pcx.nodes[n].a != 0 {
                    ev_result(pcx.nodes[n].a, v, &ocx, &pcx);
                } else {
                    ev_result(n, -1, &ocx, &pcx);
                }
                set_unreachable(ocx.cur, &ocx);
                ocx.pool_top = v;
            }
            NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
                crate::front::own::moves::note_literal(n, &pcx);
                eval_list(n, if ocx.le_read == n { CX_READ } else { CX_MOVE }, dst, &ocx, &pcx);
            }
            NodeKind::FieldInit | NodeKind::NamedArg => eval(pcx.nodes[n].b, ctx, dst, &ocx, &pcx),
            NodeKind::Repeat => eval(pcx.nodes[n].a, CX_MOVE, dst, &ocx, &pcx),
            NodeKind::Range => {
                eval(pcx.nodes[n].a, CX_READ, -1, &ocx, &pcx);
                eval(pcx.nodes[n].b, CX_READ, -1, &ocx, &pcx);
            }
            NodeKind::Closure => {
                let moving = (pcx.nodes[n].c & CLOSURE_MOVE) != 0;
                if !moving {
                    ocx.no_move += 1;
                } else {
                    moves::sink_borrowed_captures(n, ocx, &pcx);
                }
                eval(pcx.nodes[n].y, CX_MOVE, dst, &ocx, &pcx);
                if !moving {
                    ocx.no_move -= 1;
                }
            }
            NodeKind::Try => {
                // (0.25: `v.last()?`, a borrowed copy, as the Call above)
                // (its match binds ?v by reference, drops::try_let_borrows:
                // the value is read there, and moved only as a whole, here)
                let ok = ocx.borrow_ok == n;
                let borrowed = crate::front::own::byref::borrowed_call(n, &pcx);
                eval(pcx.nodes[n].y, if borrowed { CX_READ } else { ctx }, dst, &ocx, &pcx);
                if borrowed && ctx == CX_MOVE && !ok
                    && !within_std(pcx.fns[ocx.cur_f].module, pcx) {
                    crate::front::own::moves::borrowed_move(n, ocx, &pcx);
                }
            }
            NodeKind::Interp => {
                // (the holes are shared borrows, §2.7: their lets, `let =fN
                // = eN`, read eN (eval_let); what eN moves inside, as
                // `E::A(w)`, it moves; the closure does not own them)
                eval(pcx.nodes[n].y, ctx, dst, &ocx, &pcx);
            }
            NodeKind::EnumPanic => eval(pcx.nodes[n].a, CX_READ, -1, &ocx, &pcx),
            NodeKind::VecOp => {
                eval(pcx.nodes[n].a, CX_READ, -1, &ocx, &pcx);
                eval_list(n, CX_READ, -1, &ocx, &pcx);
            }
            _ => {}
        }
    }
}

// The value of a place expression: a read, or a move of an owned value.
fn eval_place_value(n: i64, ctx: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let t = pcx.nodes[n].ty;
        if pcx.nodes[n].kind == NodeKind::Ident && pcx.nodes[n].res != Res::Local
            && pcx.nodes[n].res != Res::Static {
            return;
        }
        if !is_place_expr(n, pcx) {
            // (a field of a call's result: the value's; an element of a
            // collection a call views, `v[i]` of a Vec (`v.as_slice()[i]`),
            // or what a call's reference points to, moved: own.move_out)
            // (a raw pointer's `p[i]`, `*p`: unsafe code's bitwise read)
            if ctx == CX_MOVE && is_moved_type(t, &pcx) && (pcx.nodes[n].p & NODE_RAW) == 0 {
                let k = pcx.nodes[n].kind;
                if k == NodeKind::Index {
                    crate::front::own::moves::move_out_value(n, MO_INDEX, ocx, &pcx);
                } else if k == NodeKind::Unary
                    || k == NodeKind::FieldAccess && pcx.nodes[n].y == 1 {
                    crate::front::own::moves::move_out_value(n, MO_DEREF, ocx, &pcx);
                } else if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
                    // (0.24: a field of a temporary whose type implements
                    // Drop, `make().v`: the drop needs all of it, as a
                    // local's, own.partial)
                    crate::front::own::moves::partial(n, ocx, &pcx);
                }
            }
            // (0.25: a plain field of a borrowed copy, `v.last()?.id`, is read)
            let bctx = if ctx == CX_MOVE && !is_owned_type(t, &pcx)
                && crate::front::own::byref::borrowed_call(pcx.nodes[n].a, &pcx) { CX_READ }
                else { ctx };
            eval(pcx.nodes[n].a, bctx, dst, &ocx, &pcx);
            return;
        }
        // (0.25) a place reached through a value, `v[i]` of a Vec
        // (`v.as_slice()[i]`), `*r()`: tmp gets that value's views, and
        // the element read out of what it views gets their level 2
        let view = dst >= 0 && (is_view_type(t, &pcx) || t > 0 && pcx.types[t].kind == TyKind::Ptr);
        let tmp = if view { new_ov(&ocx) } else { -1 };
        ocx.po_value_dst = tmp;
        let p = place_of(n, &ocx, &pcx);
        ocx.po_value_dst = -1;
        if tmp >= 0 {
            if p < 0 && !ocx.po_raw {
                if ocx.po_inner || ocx.po_deref {
                    ov_inner(dst, tmp, &ocx);
                } else {
                    ov_or(dst, tmp, &ocx);
                }
            }
            ocx.pool_top = tmp;
        }
        if p < 0 {
            // (`v[i]` of a Vec through a reference: no place, a copy of an
            // element the Vec keeps)
            // (0.25: a field or a tuple part of such an element too, `w[0].v`)
            if ctx == CX_MOVE && is_moved_type(t, &pcx) && (pcx.nodes[n].p & NODE_RAW) == 0
                && part_of_index(n, pcx) {
                crate::front::own::moves::move_out_value(n, MO_INDEX, ocx, &pcx);
            } else if ctx == CX_MOVE && is_moved_type(t, &pcx) && (pcx.nodes[n].p & NODE_RAW) == 0
                && static_root(n, pcx) {
                // (0.26.1: a static this function makes no place for, `let
                // x = S;` alone: moved out all the same, as Rust's E0507;
                // before, nothing checked it, and x dropped what S keeps)
                crate::front::own::moves::move_out_value(n, MO_STATIC, ocx, &pcx);
            }
            return;
        }
        // (0.25: or one holding an inout access, move-only)
        if ctx == CX_MOVE && is_moved_type(t, &pcx) {
            let r = root_of(p, ocx);
            let how = if ocx.pl_rkind[r] == RK_STATIC { MO_STATIC }
                else if ocx.po_index { MO_INDEX } else if ocx.po_deref { MO_DEREF }
                else { MO_PLACE };
            ev_move(p, n, how, &ocx, &pcx);
        } else {
            ev_read(p, n, &ocx, &pcx);
        }
        if is_view_type(t, &pcx) || t > 0 && pcx.types[t].kind == TyKind::Ptr
            || crate::front::own::glue::has_glue(t, &pcx)
            && crate::front::own::state::slot_of_place(p, ocx) >= 0 {
            ev_value(p, n, t, dst, &ocx, pcx);
        }
    }
}

// (0.25) Whether place expression n is an index, or a field or a tuple part
// of one (`w[0].v.1`).
fn part_of_index(n: i64, pcx: Ctx<Comp>) -> bool {
    var e = n;
    while pcx.nodes[e].kind == NodeKind::FieldAccess && pcx.nodes[e].y != 1
        || pcx.nodes[e].kind == NodeKind::TupleField {
        e = pcx.nodes[e].a;
    }
    pcx.nodes[e].kind == NodeKind::Index
}

// `base[a..b]`: an array's elements are a loan on it; a slice's (or a
// pointer's) are what the slice views.
fn eval_slicing(n: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let base = pcx.nodes[n].a;
    let range = pcx.nodes[n].b;
    eval(pcx.nodes[range].a, CX_READ, -1, &ocx, &pcx);
    eval(pcx.nodes[range].b, CX_READ, -1, &ocx, &pcx);
    let bt = pcx.nodes[base].ty;
    if bt > 0 && pcx.types[bt].kind == TyKind::Array && is_place_expr(base, pcx) {
        let p = place_of_make(base, &ocx, &pcx);
        let kind = if (pcx.nodes[n].p & NODE_REF_MUT) != 0 { REF_MUT } else { REF_SHARED };
        ev_borrow(p, n, kind, ocx.po_raw, dst, &ocx, &pcx);
        return;
    }
    eval(base, CX_READ, dst, &ocx, &pcx);
}

// (0.25) Whether local l is a statement temporary's pointer (drops::
// visit_temps: `__own_tp = &__own_tv`), which the walk follows: what it
// points to is the temporary, alive to the end of its statement.
fn tp_local(l: i64, pcx: Ctx<Comp>) -> bool {
    l >= 0 && sym_text(pcx.locals[l].name, pcx) == "__own_tp"
}

// (0.25) Whether place expression e is a part of a static (not through a
// pointer): an assignment to it needs its place, for statics hold only
// views of static data (views::static_store).
fn static_root(e: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident {
        return pcx.nodes[e].res == Res::Static;
    }
    if k == NodeKind::FieldAccess && pcx.nodes[e].y == 0 || k == NodeKind::TupleField
        || k == NodeKind::Index {
        return static_root(pcx.nodes[e].a, pcx);
    }
    false
}

fn eval_assign(n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let target = pcx.nodes[n].b;
    let value = pcx.nodes[n].c;
    let v = new_ov(&ocx);
    eval(value, if pcx.nodes[n].op == Tok::Eq { CX_MOVE } else { CX_READ }, v, &ocx, &pcx);
    // (0.25: a place reached through a view value, `v[i] = w` of a Vec:
    // its origin, what the write reaches)
    let t = new_ov(&ocx);
    ocx.po_value_dst = t;
    let p = if static_root(target, pcx) { place_of_make(target, &ocx, &pcx) }
        else { place_of(target, &ocx, &pcx) };
    ocx.po_value_dst = -1;
    if p >= 0 && pcx.nodes[target].kind == NodeKind::Ident && pcx.nodes[target].res == Res::Local
        && tp_local(pcx.nodes[target].y, pcx) {
        // (0.25) `__own_tp = &__own_tv`: it points to the statement's
        // temporary (a place of its own, which dies with the statement,
        // views::kill_temps), which holds what __own_tv holds
        let w = new_ov(&ocx);
        let q = crate::front::own::state::temp_place(n, &ocx, pcx);
        if q >= 0 {
            set_bit(l1(w, &ocx), q);
            ocx.temps.push(q);
        }
        or_into(l2(w, &ocx), l2(v, &ocx), ocx);
        ev_assign(p, n, w, &ocx, &pcx);
    } else if p >= 0 {
        ev_assign(p, n, v, &ocx, &pcx);
    } else if !ocx.po_raw && reachable(ocx.cur, ocx) {
        views::write_through_value(t, n, v, &ocx, pcx);
    }
    ocx.pool_top = v;
}

// Binds pattern pat (at node n) to a value with origin v (-1: none).
fn bind(pat: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    bind_at(pat, v, -1, &ocx, &pcx);
}

// bind, the matched value at place `place` (-1: none, or not followed):
// a binding that is a reference into it (0.18.1, PAT_REF) borrows its
// field's place, as `&(*e).f` does, so that references to two fields
// are apart; without a place it views what the value views.
fn bind_at(pat: i64, v: i64, place: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if pat == 0 {
        return;
    }
    let k = pcx.nodes[pat].kind;
    if k == NodeKind::PatBind {
        let l = pcx.nodes[pat].x;
        if l < 0 {
            return;
        }
        if place >= 0 && binds_ref(pat, pcx) {
            let o = new_ov(&ocx);
            clear_po(false, &ocx);
            ocx.po_deref = true;
            let kind = if pcx.types[pcx.locals[l].ty].b == REF_MUT { REF_MUT }
                else { REF_SHARED };
            ev_borrow(place, pat, kind, false, o, &ocx, &pcx);
            slot_for(l, true, &ocx, pcx);
            ev_bind(l, pat, o, &ocx, &pcx);
            ocx.pool_top = o;
            return;
        }
        // (0.25: or a value of no view type that views something, a
        // borrowed copy of an element: `let x = v.get(0)` of a
        // Vec<String> is a view of v)
        slot_for(l,
            is_view_type(pcx.locals[l].ty, &pcx) || tp_local(l, pcx)
                || v >= 0 && ocx.bind_borrowed
                && crate::front::own::glue::has_glue(pcx.locals[l].ty, &pcx)
                && (!is_empty(l1(v, &ocx), ocx) || !is_empty(l2(v, &ocx), ocx)), &ocx, pcx);
        ev_bind(l, pat, v, &ocx, &pcx);
        return;
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[pat].count {
            var sub = -1;
            if place >= 0 && k == NodeKind::PatTuple {
                sub = child_place(place, TUPLE_FIELD + i, &ocx, pcx);
            } else if place >= 0 && k == NodeKind::PatVariant {
                sub = child_place(place, variant_field_key(pcx.nodes[pat].x, i), &ocx, pcx);
            }
            bind_at(child(pat, i, pcx), v, sub, &ocx, &pcx);
        }
    }
}

// Whether pattern p binds a reference into the matched value (PAT_REF).
fn has_ref_binding(p: i64, pcx: Ctx<Comp>) -> bool {
    if p == 0 {
        return false;
    }
    let k = pcx.nodes[p].kind;
    if k == NodeKind::PatBind {
        return binds_ref(p, pcx);
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[p].count {
            if has_ref_binding(child(p, i, pcx), pcx) {
                return true;
            }
        }
    }
    false
}

// The place pattern pat's references borrow from, matched against e:
// e's, when pat has one and e is a path of locals, fields and `*` through
// references (an index is evaluated, a raw pointer is not followed); else
// -1.
fn ref_bind_place(e: i64, pat: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    if e == 0 || !has_ref_binding(pat, pcx) {
        return -1;
    }
    var x = e;
    loop {
        let k = pcx.nodes[x].kind;
        if k == NodeKind::Ident {
            break;
        }
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            x = pcx.nodes[x].a;
        } else if k == NodeKind::Unary && pcx.nodes[x].op == Tok::Star {
            x = pcx.nodes[x].b;
        } else {
            return -1;
        }
    }
    if !is_place_expr(e, pcx) {
        return -1;
    }
    let p = place_of_make(e, &ocx, &pcx);
    if ocx.po_raw || ocx.po_index {
        return -1;
    }
    p
}

pub fn pattern_binds_owned(p: i64, pcx: inout Ctx<Comp>) -> bool {
    if p == 0 {
        return false;
    }
    let k = pcx.nodes[p].kind;
    if k == NodeKind::PatBind {
        return pcx.nodes[p].x >= 0 && is_moved_type(pcx.locals[pcx.nodes[p].x].ty, &pcx);
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[p].count {
            if pattern_binds_owned(child(p, i, pcx), &pcx) {
                return true;
            }
        }
    }
    false
}

fn eval_match(n: i64, ctx: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    var moves = false;
    for i in 0..pcx.nodes[n].count {
        if pattern_binds_owned(pcx.nodes[child(n, i, pcx)].a, &pcx) {
            moves = true;
        }
    }
    let v = new_ov(&ocx);
    ocx.borrow_ok = pcx.nodes[n].a;
    // (0.25: a local's place matched by value moves only the parts its
    // arms bind: the rest stays, dropped where the local is)
    let parts = moves && part_scrutinee(pcx.nodes[n].a, &pcx);
    let sty = if pcx.nodes[n].a != 0 { pcx.nodes[pcx.nodes[n].a].ty } else { 0 };
    if moves && has_drop_impl(sty, &pcx)
        && (pcx.nodes[pcx.nodes[n].a].p & crate::front::own::byref::MATCH_BYREF) == 0 {
        for i in 0..pcx.nodes[n].count {
            let p = pcx.nodes[child(n, i, pcx)].a;
            if pcx.nodes[p].kind != NodeKind::PatBind && pattern_binds_owned(p, &pcx) {
                moves::partial_pattern(p, sty, ocx, &pcx);
            }
        }
    }
    eval(pcx.nodes[n].a, if moves && !parts { CX_MOVE } else { CX_READ }, v, &ocx, &pcx);
    let pp = if parts { part_place(pcx.nodes[n].a, &ocx, &pcx) } else { -1 };
    if parts && pp < 0 {
        // (no place for it: moved whole, as before)
        eval(pcx.nodes[n].a, CX_MOVE, -1, &ocx, &pcx);
    }
    let entry = new_state(&ocx);
    copy_state(entry, ocx.cur, &ocx);
    let acc = new_state(&ocx);
    for i in 0..pcx.nodes[n].count {
        let arm = child(n, i, pcx);
        copy_state(ocx.cur, entry, &ocx);
        let mark = ocx.bound.count;
        if parts && pp >= 0 {
            bind_parts(pcx.nodes[arm].a, v, pp, &ocx, &pcx);
        } else {
            // (a view bound out of the scrutinee reborrows what it
            // comes from: `if let Some(a) = m.get_mut(k)`, views::on_bind)
            ocx.bind_from = pcx.nodes[n].a;
            ocx.bind_borrowed = crate::front::own::byref::borrowed_call(pcx.nodes[n].a, &pcx);
            bind_at(pcx.nodes[arm].a, v,
                ref_bind_place(pcx.nodes[n].a, pcx.nodes[arm].a, &ocx, &pcx), &ocx, &pcx);
            ocx.bind_borrowed = false;
            ocx.bind_from = 0;
        }
        eval(pcx.nodes[arm].b, CX_READ, -1, &ocx, &pcx);
        eval(pcx.nodes[arm].c, ctx, dst, &ocx, &pcx);
        // (0.26.2: its bindings' drops, at the arm's end)
        drop_bound(mark, false, &ocx, &pcx);
        ev_scope(mark, -1, 0, &ocx, &pcx);
        join_state(acc, ocx.cur, &ocx);
    }
    copy_state(ocx.cur, acc, &ocx);
    ocx.pool_top = v;
}

// (0.25, conventions.md "Partial moves") Whether match or `let` scrutinee
// e, matched by value with owned bindings, moves part by part: a path of
// a local's fields (`e`, `s.f`, `t.0`, no index, no `*`, no static), owned,
// not matched through a reference (MATCH_BYREF), with no Drop impl on the
// way (its drop needs all of it).
fn part_scrutinee(e: i64, pcx: inout Ctx<Comp>) -> bool {
    if e == 0 || (pcx.nodes[e].p & crate::front::own::byref::MATCH_BYREF) != 0
        || !is_owned_type(pcx.nodes[e].ty, &pcx) {
        return false;
    }
    var x = e;
    loop {
        if has_drop_impl(pcx.nodes[x].ty, &pcx) || (pcx.nodes[x].p & NODE_RAW) != 0 {
            return false;
        }
        let k = pcx.nodes[x].kind;
        if k == NodeKind::Ident {
            return pcx.nodes[x].res == Res::Local && pcx.nodes[x].y >= 0
                && pcx.byref.get(pcx.nodes[x].y + 1) == 0;
        }
        if k == NodeKind::FieldAccess && pcx.nodes[x].y != 1 || k == NodeKind::TupleField {
            x = pcx.nodes[x].a;
        } else {
            return false;
        }
    }
    false
}

// The place of part_scrutinee e (evaluated already), or -1.
fn part_place(e: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let p = place_of_make(e, &ocx, &pcx);
        if p < 0 || ocx.po_raw || ocx.po_index || ocx.po_deref
            || ocx.pl_rkind[root_of(p, ocx)] == RK_STATIC {
            return -1;
        }
        p
    }
}

// Pattern pat of a match (or `let`) by value on the value at place `place`
// (part_place; -1: none) binds: an owned binding moves its part only
// (moves::MOVE_AT, the arm's body, clears its drop flag), so the parts it
// leaves (`_`, `..`, other variants) stay in the place, and drop with it.
// A part without a place moves its parent whole.
fn bind_parts(pat: i64, v: i64, place: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if pat == 0 {
        return;
    }
    let k = pcx.nodes[pat].kind;
    if k == NodeKind::PatBind {
        let l = pcx.nodes[pat].x;
        if l < 0 {
            return;
        }
        if place >= 0 && is_owned_type(pcx.locals[l].ty, &pcx) {
            ev_move(place, pat, MO_PLACE, &ocx, &pcx);
        } else if place >= 0 {
            ev_read(place, pat, &ocx, &pcx);
        }
        slot_for(l, is_view_type(pcx.locals[l].ty, &pcx), &ocx, pcx);
        ev_bind(l, pat, v, &ocx, &pcx);
        return;
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[pat].count {
            let c = child(pat, i, pcx);
            var sub = place;
            if place >= 0 && k == NodeKind::PatTuple {
                sub = child_place(place, TUPLE_FIELD + i, &ocx, pcx);
            } else if place >= 0 && k == NodeKind::PatVariant {
                sub = child_place(place, variant_field_key(pcx.nodes[pat].x, i), &ocx, pcx);
            }
            if place >= 0 && pattern_binds_owned(c, &pcx)
                && (sub < 0
                    || has_drop_impl(pcx.nodes[c].ty, &pcx)
                    && pcx.nodes[c].kind != NodeKind::PatBind) {
                // (no place for the part, or a Drop impl's value taken
                // apart, own.partial: the part moves whole)
                if sub >= 0 {
                    moves::partial_pattern(c, pcx.nodes[c].ty, ocx, &pcx);
                }
                ev_move(if sub >= 0 { sub } else { place }, pat, MO_PLACE, &ocx, &pcx);
                sub = -1;
            }
            bind_parts(c, v, sub, &ocx, &pcx);
        }
    }
}

fn find_frame(lp: i64, ocx: OwnCx) -> i64 {
    unsafe {
        var f = ocx.loopf.count - 4;
        while f >= 0 {
            if ocx.loopf.data[f] == lp {
                return f;
            }
            f -= 4;
        }
        -1
    }
}

// The rounds a loop is walked at most before its head is taken as stable.
const MAX_ROUNDS: i64 = 6;

fn eval_loop(n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let k = pcx.nodes[n].kind;
    let mark = ocx.bound.count;
    if k == NodeKind::For {
        eval(pcx.nodes[n].c, CX_READ, -1, &ocx, &pcx);
        bind(pcx.nodes[n].b, -1, &ocx, &pcx);
    }
    let brk = new_state(&ocx);
    let cont = new_state(&ocx);
    let head = new_state(&ocx);
    let exit = new_state(&ocx);
    ocx.loopf.push(n);
    ocx.loopf.push(brk);
    ocx.loopf.push(cont);
    ocx.loopf.push(ocx.bound.count);
    var round = 0;
    while round < MAX_ROUNDS {
        copy_state(head, ocx.cur, &ocx);
        set_unreachable(brk, &ocx);
        set_unreachable(cont, &ocx);
        if k == NodeKind::While {
            eval(pcx.nodes[n].b, CX_READ, -1, &ocx, &pcx);
            copy_state(exit, ocx.cur, &ocx);
            eval(pcx.nodes[n].c, CX_READ, -1, &ocx, &pcx);
        } else if k == NodeKind::Loop {
            set_unreachable(exit, &ocx);
            eval(pcx.nodes[n].b, CX_READ, -1, &ocx, &pcx);
        } else {
            copy_state(exit, ocx.cur, &ocx);
            eval(pcx.nodes[n].d, CX_READ, -1, &ocx, &pcx);
        }
        ocx.loop_rounds += 1;
        join_state(ocx.cur, cont, &ocx);
        join_state(ocx.cur, head, &ocx);
        if same_state(ocx.cur, head, ocx) {
            break;
        }
        round += 1;
    }
    join_state(exit, brk, &ocx);
    copy_state(ocx.cur, exit, &ocx);
    ocx.loopf.count -= 4;
    ocx.bound.count = mark;
    ocx.pool_top = brk;
}

// `let __for_seq = v;` of a `for` over an owned place v: __for_seq is v
// (the loop borrows it), not a move.
fn for_alias(s: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> bool {
    let pat = pcx.nodes[s].a;
    let init = pcx.nodes[s].c;
    if pat == 0 || init == 0 || pcx.nodes[pat].kind != NodeKind::PatBind
        || pcx.nodes[pat].a != ocx.walk_sym_for_seq || pcx.nodes[pat].x < 0 {
        return false;
    }
    let t = pcx.nodes[init].ty;
    if !is_owned_type(t, &pcx) || !is_place_expr(init, pcx) {
        return false;
    }
    let p = place_of(init, &ocx, &pcx);
    if p < 0 {
        return false;
    }
    ev_read(p, init, &ocx, &pcx);
    alias_local(pcx.nodes[pat].x, p, &ocx, pcx);
    views::on_for_alias(pcx.nodes[pat].x, p, init);
    true
}

fn eval_block(n: i64, ctx: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let mark = ocx.bound.count;
    // (0.18: a requires check's block whose call may be a borrowed copy)
    let tail_ok = ocx.borrow_ok == n && crate::front::contracts::expand::requires_tail(n, pcx) > 0;
    // (0.25) a `let`'s temporaries, and the tail's, live to the block's
    // end (the `let` may keep a view of them); a statement's, to its own
    let bmark = ocx.temps.count;
    for i in 0..pcx.nodes[n].count {
        if !reachable(ocx.cur, ocx) {
            break;
        }
        let s = child(n, i, pcx);
        let k = pcx.nodes[s].kind;
        let tmark = ocx.temps.count;
        if k == NodeKind::Let && for_alias(s, &ocx, &pcx) {
            // (`for x in v`: the loop borrows v)
        } else if k == NodeKind::Let {
            eval_let(s, &ocx, &pcx);
        } else if k == NodeKind::ExprStmt {
            eval(pcx.nodes[s].a, CX_READ, -1, &ocx, &pcx);
        } else {
            eval(s, CX_READ, -1, &ocx, &pcx);
        }
        if k != NodeKind::Let {
            views::kill_temps(tmark, &ocx, pcx);
        }
    }
    let tail = pcx.nodes[n].a;
    if tail != 0 && reachable(ocx.cur, ocx) {
        if tail_ok {
            ocx.borrow_ok = tail;
        }
        eval(tail, ctx, dst, &ocx, &pcx);
    }
    // (0.25: a statement temporary's block, own/drops temp_value: its
    // __own_tv lives as long as the statement, which kill_temps ends)
    let temp = (pcx.nodes[n].p & crate::front::check::temps::NODE_TEMP) != 0;
    if !temp {
        // UNSAFE: FNS is the checker's raw table of functions.
        // SAFETY: CUR_F is the function walked, below FN_COUNT; one thread.
        let body = unsafe { pcx.nodes[pcx.fns[ocx.cur_f].node].c };
        drop_bound(mark, n == body, &ocx, &pcx);
    }
    views::kill_temps(bmark, &ocx, pcx);
    if temp {
        return;
    }
    ev_scope(mark, dst, tail, &ocx, &pcx);
}

// `let p = e;`. The checker's own lets read rather than move: structural
// equality's `let ==l = a;`, a `for` loop's element `let x =
// __for_seq[i];`. A tuple pattern over a tuple expression binds element by
// element.
fn eval_let(s: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let pat = pcx.nodes[s].a;
    let init = pcx.nodes[s].c;
    var ctx = CX_MOVE;
    if pat != 0 && pcx.nodes[pat].kind == NodeKind::PatBind {
        let name = pcx.nodes[pat].a;
        let text = sym_text(name, pcx);
        // (`=+l`: an arithmetic operator's operand, which moves)
        if text.len > 0 && text[0] == '=' && !(text.len > 1 && text[1] == '+') {
            ctx = CX_READ;
        }
    }
    // (a `for` loop's element, `__for_seq[i]`: not any index proved in
    // bounds, which the effects pass marks when it runs, at -O1 and
    // up: what is checked must not depend on the level)
    if init != 0 && pcx.nodes[init].kind == NodeKind::Index
        && (pcx.nodes[init].p & NODE_IN_BOUNDS) != 0 && for_seq_index(init, pcx) {
        ctx = CX_READ;
    }
    if pat != 0 && init != 0 && pcx.nodes[pat].kind == NodeKind::PatTuple
        && pcx.nodes[init].kind == NodeKind::Tuple
        && pcx.nodes[pat].count == pcx.nodes[init].count {
        crate::front::own::moves::note_literal(init, &pcx);
        for i in 0..pcx.nodes[init].count {
            let v = new_ov(&ocx);
            eval(child(init, i, pcx), CX_MOVE, v, &ocx, &pcx);
            bind(child(pat, i, pcx), v, &ocx, &pcx);
            ocx.pool_top = v;
        }
        return;
    }
    let v = new_ov(&ocx);
    // (not the assignment desugaring's `let __own_new = rhs;`: what it
    // binds is stored)
    if !(pat != 0 && pcx.nodes[pat].kind == NodeKind::PatBind
        && sym_text(pcx.nodes[pat].a, pcx) == "__own_new") {
        ocx.borrow_ok = init;
    }
    if ctx == CX_MOVE && pat != 0 && init != 0
        && (pcx.nodes[pat].kind == NodeKind::PatTuple
            || pcx.nodes[pat].kind == NodeKind::PatVariant)
        && pattern_binds_owned(pat, &pcx) && part_scrutinee(init, &pcx) {
        // (0.25: `let (a, _) = t;` moves t.0 only, as a match does)
        eval(init, CX_READ, v, &ocx, &pcx);
        let pp = part_place(init, &ocx, &pcx);
        if pp >= 0 {
            bind_parts(pat, v, pp, &ocx, &pcx);
            ocx.pool_top = v;
            return;
        }
        eval(init, CX_MOVE, -1, &ocx, &pcx);
    } else {
        eval(init, ctx, v, &ocx, &pcx);
    }
    ocx.bind_borrowed = init != 0 && crate::front::own::byref::borrowed_call(init, &pcx);
    bind_at(pat, v, ref_bind_place(init, pat, &ocx, &pcx), &ocx, &pcx);
    ocx.bind_borrowed = false;
    ocx.pool_top = v;
    if pat != 0 && init != 0 && pcx.nodes[pat].kind == NodeKind::PatBind && pcx.nodes[pat].x >= 0 {
        views::on_let(pcx.nodes[pat].x, init, &ocx, &pcx);
    }
}

// Whether index node n reads a `for` loop's sequence, `__for_seq[i]`
// (check/iterate.vl).
fn for_seq_index(n: i64, pcx: Ctx<Comp>) -> bool {
    let base = pcx.nodes[n].a;
    base != 0 && pcx.nodes[base].kind == NodeKind::Ident
        && sym_text(pcx.nodes[base].a, pcx) == "__for_seq"
}

// ---------------------------------------------------------------------------
// Calls

// The mode of argument i of a call of f (-1: through a fn value: by the
// argument's type, a pointer taken as the legacy rule takes one).
fn arg_mode(f: i64, i: i64, arg: i64, pcx: Ctx<Comp>) -> i64 {
    if f >= 0 {
        return param_mode(f, i, pcx);
    }
    let t = pcx.nodes[arg].ty;
    if t <= 0 {
        return P_VALUE;
    }
    if pcx.types[t].kind == TyKind::Slice {
        return if pcx.types[t].b == REF_MUT { P_MUT_VIEW } else { P_VIEW };
    }
    if pcx.types[t].kind == TyKind::Ptr {
        return if pcx.types[t].b == REF_SHARED { P_SHARED } else { P_MUT };
    }
    P_VALUE
}

// Call n: its arguments left to right as pending entries, then ev_call.
// An argument `&place` (or a reference passed on) is a loan of the
// parameter's kind: `&x` and `&mut x` to a `&mut T` or a legacy `*T`
// parameter are exclusive (§2.3), a `&mut self` receiver is two-phase
// (PK_RESERVE).
fn eval_call(n: i64, dst: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let f = pcx.nodes[n].x - 1;
    if f < 0 {
        eval(pcx.nodes[n].a, CX_READ, -1, &ocx, &pcx);
    }
    let base = ocx.pend.count;
    let mark = ocx.pool_top;
    let c_callee = f >= 0 && pcx.fns[f].is_extern;
    for i in 0..pcx.nodes[n].count {
        let arg = child(n, i, pcx);
        let at_ty = pcx.nodes[arg].ty;
        let mode = arg_mode(f, i, arg, pcx);
        if f >= 0 && mode == P_VALUE && at_ty > 0 && is_owned_type(at_ty, &pcx) {
            // (0.20: for own.moved to name the parameter)
            crate::front::own::moves::note_move_arg(arg, n, i, &pcx);
        }
        let o = new_ov(&ocx);
        var pl = -1;
        var receiver = false;
        var raw = false;
        // (whether walk::PO_* describe pl: `&place`, not a reference
        // passed on)
        var made = false;
        let k = pcx.nodes[arg].kind;
        if k == NodeKind::Unary && pcx.nodes[arg].op == Tok::Amp
            && is_place_expr(pcx.nodes[arg].b, pcx) {
            let operand = pcx.nodes[arg].b;
            receiver = i == 0 && pcx.nodes[arg].start == pcx.nodes[operand].start;
            pl = place_of_make(operand, &ocx, &pcx);
            raw = ocx.po_raw;
            made = true;
        } else if k == NodeKind::Ident && is_reference(arg, ocx, &pcx) && at_ty > 0
            && pcx.types[at_ty].kind == TyKind::Ptr {
            // (a reference passed on: a reborrow)
            pl = local_place(pcx.nodes[arg].y, &ocx, pcx);
            receiver = i == 0;
        }
        if pl >= 0 && !raw {
            var kind = PK_SHARED;
            if mode == P_MUT {
                kind = if receiver { PK_RESERVE } else { PK_MUT };
            } else if mode == P_RAW || c_callee {
                kind = PK_RAW;
            }
            if i == 0
                && crate::front::closures::closure_of_type(pcx.nodes[pcx.nodes[arg].b].ty, pcx)
                > 0
                && kind == PK_RAW {
                // (0.25) a closure called or lent, `&g`: an access of its
                // captures for the call (o holds them at level 2),
                // inout where it changes one
                kind = if views::holds_mut(pcx.nodes[pcx.nodes[arg].b].ty, 0, &ocx, pcx) {
                    PK_MUT_VIEW
                }
                    else { PK_VIEW };
            }
            if made && mode == P_MUT && f >= 0 && i < pcx.fns[f].param_count {
                // (a `&mut` parameter, not a legacy `*T` one: through a
                // `&T` or a `[T]` it is own.readonly, as a write is)
                let pt = crate::front::types::fn_param(f, i, pcx);
                if pt > 0 && pcx.types[pt].b == REF_MUT {
                    views::on_mut_loan(pl, arg, &ocx, &pcx);
                }
            }
            ev_read(pl, arg, &ocx, &pcx);
            views::on_borrow(pl, arg, if kind == PK_SHARED { REF_SHARED } else { REF_MUT },
                false, o, &ocx, &pcx);
            pend_push(kind, pl, o, arg, mode, &ocx);
        } else if pl >= 0 {
            ev_read(pl, arg, &ocx, &pcx);
            pend_push(PK_RAW, -1, o, arg, mode, &ocx);
        } else {
            // (a borrowed copy, `v.get(i)`, moves only into a raw or
            // C parameter, or as the receiver of `unwrap` and the like:
            // `out.push(v.get(i))` is own.move_out, eval)
            // (0.18: a requires check's companion reads the call's
            // arguments in place: contracts::expand::is_pre_fn)
            let pre = crate::front::contracts::expand::is_pre_fn(f, pcx);
            if mode != P_VALUE || c_callee || pre
                || i == 0 && crate::front::own::byref::borrowed_call(n, &pcx) {
                ocx.borrow_ok = arg;
            }
            // (std's iterators hand a closure the elements they read,
            // `g(acc, s[k])` in fold: borrowed copies, as a `for` loop's
            // element; a closure's by-value parameters drop nothing
            // in 0.17.0. Only an element read out of a slice: a value
            // std owns, `f(e)` in map_err, moves)
            let actx = if within_std(pcx.fns[ocx.cur_f].module, pcx)
                && pcx.nodes[arg].kind == NodeKind::Index
                && (f < 0
                    || pcx.fns[f].node > 0 && (pcx.nodes[pcx.fns[f].node].p & FN_CLOSURE) != 0)
                || pre
                { CX_READ }
                else { CX_MOVE };
            eval(arg, actx, o, &ocx, &pcx);
            var kind = PK_NONE;
            if c_callee || mode == P_RAW {
                kind = PK_RAW;
            } else if mode == P_MUT_VIEW {
                kind = PK_MUT_VIEW;
            } else if made && mode == P_MUT && !raw
                || mode == P_MUT && k == NodeKind::Unary && pcx.nodes[arg].op == Tok::Amp
                && through_exclusive_view(pcx.nodes[arg].b, pcx) {
                // (0.25) `&mut v[i]` of a Vec, `v[i].push(w)`: a place
                // inside what a view value points to, written by the
                // call: its origin (the loans it holds) is written;
                // `&v[i]` of a Vec, a Buf, a String: a loan of an
                // element through the view `v.as_mut_slice()` makes (o
                // holds it), exclusive as `&a[i]` of an array is
                kind = PK_MUT;
            } else if is_view_type(at_ty, &pcx) {
                // (0.25) one holding an inout access (a closure that
                // writes a capture, a struct with an inout field) may
                // change what it views during the call
                // (a closure lent to a let parameter, `&|| ..`, too: the
                // callee calls it)
                let inner = if pcx.types[at_ty].kind == TyKind::Ptr { pcx.types[at_ty].a }
                    else { 0 };
                // (a temporary lent, `&v.iter()`, writes itself: only a
                // value that holds an inout access writes through it)
                let held = if inner > 0 { views::holds_mut(inner, 0, &ocx, pcx) }
                    else { views::holds_mut(at_ty, 0, &ocx, pcx) };
                kind = if held
                    || inner > 0 && crate::front::closures::closure_holds_inout(inner, pcx) {
                    PK_MUT_VIEW
                } else {
                    PK_VIEW
                };
            } else if at_ty > 0 && pcx.types[at_ty].kind == TyKind::Ptr {
                kind = PK_RAW;
            } else if crate::front::own::glue::has_glue(at_ty, &pcx)
                && (!is_empty(l1(o, &ocx), ocx) || !is_empty(l2(o, &ocx), ocx)) {
                // (0.25) a value of no view type that views something:
                // a borrowed copy of an element (`m.get(k).unwrap()`)
                kind = PK_VIEW;
            }
            pend_push(kind, -1, o, arg, mode, &ocx);
        }
    }
    if f >= 0 && within_std(pcx.fns[f].module, pcx)
        && !within_std(pcx.fns[ocx.cur_f].module, pcx) {
        // (0.24: a borrowing iterator's copied items kept: own.move_out)
        crate::front::own::moves::iter_item_copy(n, f, &pcx);
    }
    if f >= 0 && within_std(pcx.fns[f].module, pcx) && pcx.nodes[n].count == 2
        && !within_std(pcx.fns[ocx.cur_f].module, pcx) {
        // (std's bitwise extend_from_slice on owned elements)
        let s = child(n, 1, pcx);
        let st = pcx.nodes[s].ty;
        if st > 0 && pcx.types[st].kind == TyKind::Slice
            && crate::front::own::glue::has_glue(pcx.types[st].a, &pcx)
            && crate::front::own::byref::method_word(sym_text(pcx.fns[f].display, pcx))
            == "extend_from_slice" {
            crate::front::own::moves::bitwise_extend(s, &pcx);
        }
    }
    if reachable(ocx.cur, ocx) {
        ev_call(n, f, base, dst, &ocx, &pcx);
    }
    ocx.pend.count = base;
    ocx.pool_top = mark;
}

// (0.25) Whether place e (`v.as_mut_slice()[i].x`) is reached through an
// exclusive view a call makes (an `inout [T]` or `inout T` result): a loan of
// it writes what that view points into. A temporary itself (`&v.iter()`)
// is not: its change is its own.
fn through_exclusive_view(e: i64, pcx: Ctx<Comp>) -> bool {
    var p = e;
    var depth = 0;
    while depth < 64 {
        let k = pcx.nodes[p].kind;
        if k == NodeKind::Index || k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            p = pcx.nodes[p].a;
        } else if k == NodeKind::Call || k == NodeKind::MethodCall {
            if depth == 0 {
                return false;
            }
            // (a part of what a call returns a view of: `v[0]` as a
            // receiver is `v.as_slice()[0]`; a written element)
            let t = pcx.nodes[p].ty;
            return t > 0
                && (pcx.types[t].kind == TyKind::Slice || pcx.types[t].kind == TyKind::Ptr);
        } else {
            return false;
        }
        depth += 1;
    }
    false
}

// ---------------------------------------------------------------------------
// A function

fn walk_once(f: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        ocx.cur_f = f;
        ocx.walked += 1;
        ocx.param_locals.count = 0;
        ocx.pool_top = 0;
        ocx.pend.count = 0;
        ocx.loopf.count = 0;
        ocx.bound.count = 0;
        ocx.no_move = 0;
        ocx.pl_overflow = false;
        ocx.slot_overflow = false;
        ocx.cur = new_state(&ocx);
        ocx.pool[ocx.cur] = 1;
        let item = pcx.fns[f].node;
        for i in 0..pcx.nodes[item].count {
            let l = pcx.nodes[child(item, i, pcx)].x;
            ocx.param_locals.push(l);
            if l >= 0 {
                slot_for(l, is_view_type(pcx.locals[l].ty, &pcx), &ocx, pcx);
            }
        }
        views::on_enter(f, &ocx, &pcx);
        let body = pcx.nodes[item].c;
        let v = new_ov(&ocx);
        eval(body, CX_MOVE, v, &ocx, &pcx);
        if reachable(ocx.cur, ocx) {
            let tail = pcx.nodes[body].a;
            ev_result(if tail != 0 { tail } else { body }, if tail != 0 { v } else { -1 }, &ocx,
                &pcx);
        }
    }
}

// Walks function f (round: which round of its SCC's fixed point, T3) and
// returns the summary its body makes. A function with more places than
// one bitset word, or more slots than a state has room for, is walked
// again, wider; its findings are those of the last walk (diag.vl,
// own_discard and own_flush, are the driver's).
pub fn walk_fn(f: i64, round: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> ViewSummary {
    if ocx.walk_sym_for_seq == 0 {
        ocx.walk_sym_for_seq = intern_c(c"__for_seq", &pcx);
    }
    ocx.hm_now += 1;
    if !pcx.force_walk && !fast::needs_walk(f, &pcx) {
        // (nothing to track: views() by type, no findings)
        pcx.skipped += 1;
        collect_begin(f, round, &pcx);
        return collect_end(f, &pcx);
    }
    set_words(1, &ocx);
    ocx.slot_cap = 8;
    var tries = 0;
    loop {
        collect_begin(f, round, &pcx);
        moves::on_fn(f, &pcx);
        walk_once(f, &ocx, &pcx);
        let wide = ocx.pl_overflow && ocx.nw == 1;
        let more = ocx.slot_overflow && ocx.slot_cap < 1024;
        reset_places(&ocx);
        if !(wide || more) || tries > 4 {
            break;
        }
        crate::front::own::diag::own_discard(&pcx);
        if wide {
            set_words(MAXNW, &ocx);
        }
        if more {
            ocx.slot_cap = ocx.slot_cap * 4;
        }
        tries += 1;
    }
    collect_end(f, &pcx)
}
