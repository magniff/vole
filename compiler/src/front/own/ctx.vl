// (0.26.4, statics P3) The own pass's walk state, made by check_program and own_state_at and passed
// down as `ocx` (tools/statics/front-own.group): what were its statics,
// the comment above a field naming the static it was.

use crate::base::IntVec;
use crate::middle::lower::ssa::HMap;

pub struct OwnCx {
    // (front::own::observe::OBS_BEFORE)
    pub obs_before: bool,
    // (the closest event after the position taken so far)
    // (front::own::observe::OBS_BEST)
    pub obs_best: i64,
    // The locals taken (a LOCALS index each) and their notes (buffers).
    // (front::own::observe::OBS_LOCALS)
    pub obs_locals: IntVec,
    // (front::own::observe::OBS_NOTES)
    pub obs_notes: IntVec,
    // (front::own::observe::OBS_OUT)
    pub obs_out: i64,
    // (front::own::observe::OBS_POS)
    pub obs_pos: i64,
    // (front::own::observe::OBS_TAKEN)
    pub obs_taken: bool,
    // (0.25.3) The root places of the walked function whose storage a cast
    // views as another element type (calls::on_call, summary::cast_mask: a
    // `[f32]` of a Buffer's bytes): the per-place type filters keep loans on
    // them, which they would drop since the root's type holds no such element.
    // (front::own::state::CAST_ROOTS)
    pub cast_roots: IntVec,
    // The current state.
    // (front::own::state::CUR)
    pub cur: i64,
    // (front::own::state::LOC_CAP)
    pub loc_cap: i64,
    // Per local (a LOCALS index): its place + 1, its roots' places + 1 (`p`,
    // `*p`), its slot + 1; 0: none yet.
    // (front::own::state::LOC_PL)
    pub loc_pl: *i64,
    // (front::own::state::LOC_ROOT)
    pub loc_root: *i64,
    // (front::own::state::LOC_ROOT2)
    pub loc_root2: *i64,
    // (front::own::state::LOC_SLOT)
    pub loc_slot: *i64,
    // (front::own::state::MARK_PL)
    pub mark_pl: i64,
    // (front::own::state::MAXPL)
    pub maxpl: i64,
    // (front::own::state::NSLOT)
    pub nslot: i64,
    // Words per bitset (1, or MAXNW when a function has more than 64 places)
    // and the places a bitset holds.
    // (front::own::state::NW)
    pub nw: i64,
    // An origin value's words, and a slot's (its origin, flags, reason).
    // (front::own::state::OV)
    pub ov: i64,
    // (front::own::state::PEND)
    pub pend: IntVec,
    // (front::own::state::PL_COUNT)
    pub pl_count: i64,
    // (front::own::state::PL_FIELD)
    pub pl_field: *i64,
    // Per place, NW words: the places it overlaps (itself, its ancestors and
    // descendants).
    // (front::own::state::PL_MASK)
    pub pl_mask: *i64,
    // The last node that moved the place (T1's messages).
    // (front::own::state::PL_MOVED_BY)
    pub pl_moved_by: *i64,
    // Set when a function has more places than MAXPL: walk_fn walks again,
    // wider.
    // (front::own::state::PL_OVERFLOW)
    pub pl_overflow: bool,
    // (front::own::state::PL_PARENT)
    pub pl_parent: *i64,
    // (front::own::state::PL_RID)
    pub pl_rid: *i64,
    // (front::own::state::PL_RKIND)
    pub pl_rkind: *i64,
    // (front::own::state::POOL)
    pub pool: *i64,
    // (front::own::state::POOL_CAP)
    pub pool_cap: i64,
    // (front::own::state::POOL_TOP)
    pub pool_top: i64,
    // The slots a state has room for; past it, SLOT_OVERFLOW and walk_fn walks
    // again with twice the room.
    // (front::own::state::SLOT_CAP)
    pub slot_cap: i64,
    // (front::own::state::SLOT_LOCAL)
    pub slot_local: IntVec,
    // (front::own::state::SLOT_OVERFLOW)
    pub slot_overflow: bool,
    // Per slot: the slot it reborrows (`let out = acc[..]`), -1: none.
    // (front::own::state::SLOT_PARENT)
    pub slot_parent: IntVec,
    // The places that are statics or under one.
    // (front::own::state::STATIC_MASK)
    pub static_mask: *i64,
    // (front::own::state::STATIC_PL)
    pub static_pl: *i64,
    // (front::own::state::STATIC_TOUCHED)
    pub static_touched: IntVec,
    // (front::own::state::SW)
    pub sw: i64,
    // (front::own::state::S_DMOVED)
    pub s_dmoved: i64,
    // (front::own::state::S_SLOTS)
    pub s_slots: i64,
    // (front::own::state::TOUCHED)
    pub touched: IntVec,
    // (front::own::views::ANY_CHILD)
    pub any_child: bool,
    // (front::own::views::ANY_MUT)
    pub any_mut: bool,
    // (front::own::views::ANY_REF)
    pub any_ref: bool,
    // The expression a pattern binds out of (walk::eval_match), or 0.
    // (front::own::views::BIND_FROM)
    pub bind_from: i64,
    // The parameters (bits) holding a closure that the walk stores views into:
    // the walked closure's env (it stores into what it captures), a closure
    // given to the walked function. Their summary's stores then name their own
    // roots too (infer::col_result), as one capture may now view another.
    // (front::own::views::CAPTURES_STORED)
    pub captures_stored: i64,
    // Per local: 1 bound by the checker, 2 by the program (note_binding).
    // (front::own::views::GEN)
    pub gen: *u8,
    // (front::own::views::GEN_CAP)
    pub gen_cap: i64,
    // (front::own::views::HM_GEN)
    pub hm_gen: [i64; 64],
    // (front::own::views::HM_NOW)
    pub hm_now: i64,
    // (0.26.4) holds_mut's answers, memoized for one function's walk (walk_fn
    // starts a new generation, HM_NOW): a call's inout argument asks it of its
    // type, and kinds::holds_inout walks every field (an inout FnCtx's, at
    // every call).
    // (front::own::views::HM_TYPE)
    pub hm_type: [i64; 64],
    // (front::own::views::HM_VAL)
    pub hm_val: [bool; 64],
    // The last read (on_read): the place, the node.
    // (front::own::views::LAST_READ_NODE)
    pub last_read_node: i64,
    // (front::own::views::LAST_READ_PLACE)
    pub last_read_place: i64,
    // (front::own::views::MARK_WORDS)
    pub mark_words: i64,
    // (front::own::views::OWN_STD)
    pub own_std: i64,
    // (front::own::views::QUIET)
    pub quiet: bool,
    // The nodes reported in this walk (one finding per node), whether any
    // slot holds a `&mut` loan, a reference, or a parent; whether findings
    // are reported (not in std's own functions).
    // (front::own::views::REPORTED)
    pub views_reported: IntVec,
    // Per slot (this walk, not per state): the pattern that last bound it, the
    // expression it was bound to (0: none).
    // (front::own::views::SLOT_BIND)
    pub slot_bind: IntVec,
    // (front::own::views::SLOT_INIT)
    pub slot_init: IntVec,
    // (front::own::views::SYM_FOR_SEQ)
    pub views_sym_for_seq: i64,
    // (0.26.2) Per local bound in a walk (+ 1): the node it is bound at (+ 1),
    // where its drop names it (ev_drop).
    // (front::own::walk::BIND_AT)
    pub bind_at: HMap,
    // (0.25) Whether the value being bound is a borrowed copy (drops::
    // borrowed_call: `let s = v.get(0)` of a Vec<String>): a binding of an
    // owned type then views what the copy's container holds.
    // (front::own::walk::BIND_BORROWED)
    pub bind_borrowed: bool,
    // The call whose value may be a borrowed copy (drops::borrowed_call)
    // without an error: a `let`'s or a `match`'s, a raw or C argument, the
    // receiver of `unwrap` and the like (eval_let, eval_match, eval_call).
    // (front::own::walk::BORROW_OK)
    pub borrow_ok: i64,
    // The locals bound in the enclosing scopes, in order (ev_scope gets the
    // ones that die).
    // (front::own::walk::BOUND)
    pub bound: crate::base::IntVec,
    // The function walked, and its parameters' locals (by index).
    // (front::own::walk::CUR_F)
    pub cur_f: i64,
    // (0.25) The value of a let-else's matching arm on a borrowed copy, a
    // tuple of its bindings, read (not moved): eval's Match.
    // (front::own::walk::LE_READ)
    pub le_read: i64,
    // Loop frames: node, break state, continue state, the BOUND mark of its
    // scopes (drop_bound).
    // (front::own::walk::LOOPF)
    pub loopf: crate::base::IntVec,
    // (front::own::walk::LOOP_ROUNDS)
    pub loop_rounds: i64,
    // Inside a closure that borrows its captures, or an f-string's holes (they
    // read, never move).
    // (front::own::walk::NO_MOVE)
    pub no_move: i64,
    // (front::own::walk::PARAM_LOCALS)
    pub param_locals: crate::base::IntVec,
    // What place_of found on the way: through a pointer or reference
    // (PO_DEREF), a raw one (PO_RAW), an index (PO_INDEX), inside what a view
    // points to (PO_INNER), into the elements of a slot's slice (PO_VIEWSLOT).
    // (front::own::walk::PO_DEREF)
    pub po_deref: bool,
    // (front::own::walk::PO_INDEX)
    pub po_index: bool,
    // (front::own::walk::PO_INNER)
    pub po_inner: bool,
    // (whether place_rec makes the places of plain locals and statics: where
    // something borrows them)
    // (front::own::walk::PO_MAKE)
    pub po_make: bool,
    // (front::own::walk::PO_RAW)
    pub po_raw: bool,
    // (0.18.1) While `&place` is taken: the origin that gets the views of a
    // value the place is reached through (`&v.as_slice()[i]`), place_rec.
    // (front::own::walk::PO_VALUE_DST)
    pub po_value_dst: i64,
    // (front::own::walk::PO_VIEWSLOT)
    pub po_viewslot: i64,
    // (front::own::walk::SYM_FOR_SEQ)
    pub walk_sym_for_seq: i64,
    // (0.25) The temporaries' places made in the statement being walked
    // (state::temp_place), which die at its end.
    // (front::own::walk::TEMPS)
    pub temps: IntVec,
    // Node visits, and loop rounds (for --time-passes' report and the budget).
    // (front::own::walk::VISITS)
    pub visits: i64,
    // (front::own::walk::WALKED)
    pub walked: i64,
}

// A new context: every field at its static's first value.
pub fn own_cx_new() -> OwnCx {
    OwnCx {
        obs_before: true,
        obs_best: 0,
        obs_locals: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        obs_notes: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        obs_out: -1,
        obs_pos: -1,
        obs_taken: false,
        cast_roots: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        cur: 0,
        loc_cap: 0,
        loc_pl: 0 as *i64,
        loc_root: 0 as *i64,
        loc_root2: 0 as *i64,
        loc_slot: 0 as *i64,
        mark_pl: -1,
        maxpl: 64,
        nslot: 0,
        nw: 1,
        ov: 2,
        pend: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        pl_count: 0,
        pl_field: 0 as *i64,
        pl_mask: 0 as *i64,
        pl_moved_by: 0 as *i64,
        pl_overflow: false,
        pl_parent: 0 as *i64,
        pl_rid: 0 as *i64,
        pl_rkind: 0 as *i64,
        pool: 0 as *i64,
        pool_cap: 0,
        pool_top: 0,
        slot_cap: 8,
        slot_local: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        slot_overflow: false,
        slot_parent: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        static_mask: 0 as *i64,
        static_pl: 0 as *i64,
        static_touched: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        sw: 4,
        s_dmoved: 2,
        s_slots: 3,
        touched: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        any_child: false,
        any_mut: false,
        any_ref: false,
        bind_from: 0,
        captures_stored: 0,
        gen: 0 as *u8,
        gen_cap: 0,
        hm_gen: [0; 64],
        hm_now: 1,
        hm_type: [0; 64],
        hm_val: [false; 64],
        last_read_node: 0,
        last_read_place: -1,
        mark_words: -1,
        own_std: -1,
        quiet: false,
        views_reported: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        slot_bind: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        slot_init: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        views_sym_for_seq: 0,
        bind_at: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        bind_borrowed: false,
        borrow_ok: 0,
        bound: crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 },
        cur_f: -1,
        le_read: 0,
        loopf: crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 },
        loop_rounds: 0,
        no_move: 0,
        param_locals: crate::base::IntVec { data: 0 as *i64, count: 0, cap: 0 },
        po_deref: false,
        po_index: false,
        po_inner: false,
        po_make: false,
        po_raw: false,
        po_value_dst: -1,
        po_viewslot: -1,
        walk_sym_for_seq: 0,
        temps: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        visits: 0,
        walked: 0,
    }
}

// Owned (a Drop of its own, which does nothing), so that a let
// parameter lends the context instead of copying it.
impl Drop for OwnCx {
    fn drop(inout self) {}
}
