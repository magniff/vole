// Moves and drops: the walk's move events (0.17, docs/design/
// value-semantics.md §2.2, §4 steps 0 and 5). T1 owns this file, drops.vl
// and glue.vl.
//
// The state's moved bits (state.vl: moved_bits, dmoved_bits) hold, per
// place, whether it may have moved and whether it has moved on every path;
// PL_MOVED_BY the node that moved it. A use of a place that overlaps a
// moved one is own.moved; a move out of an index, through a reference
// (`*r`, `r.f`), out of a static, or out of a binding that borrows (a
// `for` loop's element, a match through a reference) is own.move_out
// (reads through a raw pointer move nothing: unsafe code's business); a
// move out of a field of a type with a Drop impl is own.partial. Every
// exit of an implicit defer records the state of its local
// (drops.vl: drop_state).

use crate::base::{
    SRC, buf_byte, buf_bytes, buf_fmt, buf_int, buf_new, buf_slice, buf_str, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::buf_tool_command;
use crate::front::ast::{FN_CLOSURE, NODE_CAPTURE, NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::own::byref::{MATCH_BYREF, copies_owned_items};
use crate::front::own::ctx::OwnCx;
use crate::front::own::diag::{
    OWN_DROP_CALL, OWN_MOVED, OWN_MOVE_OUT, OWN_PARTIAL, OWN_READONLY, own_begin, own_bytes,
    own_end, own_help, own_help_bytes, own_str, own_sym, own_try, own_type,
};
use crate::front::own::kinds::{has_drop_impl, is_owned_type, owned_base_type};
use crate::front::own::state::{
    DEREF_FIELD, RK_LOCAL, RK_STATIC, TUPLE_FIELD, any_and, dmoved_bits, field_number, get_bit,
    is_below, moved_bits, root_of, set_bit,
};
use crate::front::own::walk::{MO_DEREF, MO_INDEX, MO_STATIC};
use crate::front::types::{TyKind, buf_type};

// The walk starts function f.
pub fn on_fn(f: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.reported_keys.count {
            pcx.reported.put(pcx.reported_keys.data[i], 0);
        }
        pcx.reported_keys.count = 0;
    }
}

// Place p is read, or borrowed, at node n: a use of a moved value is
// own.moved.
pub fn on_read(p: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    check_moved(p, n, &ocx, &pcx);
}

// Owned place p is moved at node n; how (walk::MO_*) says how it left its
// place: out of an index, a pointer or reference, or a static is
// own.move_out.
pub fn on_move(p: i64, n: i64, how: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if (pcx.nodes[n].p & MATCH_BYREF) != 0 {
            // (a match through a reference: its bindings borrow)
            check_moved(p, n, &ocx, &pcx);
            return;
        }
        let cap = captured_use(n, pcx);
        if cap > 0 {
            // (0.20: a closure's capture, reached through its env. A sink
            // closure's own one moves out under its flag; any other is
            // still its owner's, or the closure may run again)
            if cap != n || !sink_capture_move(n, ocx, &pcx) {
                move_out(p, n, MO_CAPTURED, ocx, &pcx);
            }
            return;
        }
        if how == crate::front::own::walk::MO_DEREF && !ocx.po_raw && let_param_view(n, &pcx) {
            // (0.25) a move-only view a let parameter lends (a closure that
            // changes a capture: `var g = f;` to call it): the callee takes
            // it over for the rest of the call, the caller's waits; the
            // parameter is moved from here
            check_moved(p, n, &ocx, &pcx);
            set_bit(moved_bits(&ocx), p);
            ocx.pl_moved_by[p] = n;
            return;
        }
        if how != 0 {
            if ocx.po_raw {
                return;
            }
            move_out(p, n, how, ocx, &pcx);
            return;
        }
        let root = root_of(p, ocx);
        if ocx.pl_rkind[root] == RK_LOCAL && pcx.byref.get(ocx.pl_rid[root] + 1) != 0 {
            move_out(p, n, -1, ocx, &pcx);
            return;
        }
        partial(n, ocx, &pcx);
        check_moved(p, n, &ocx, &pcx);
        set_bit(moved_bits(&ocx), p);
        set_bit(dmoved_bits(&ocx), p);
        ocx.pl_moved_by[p] = n;
    }
}

// (0.25) Whether node n reads a let parameter whose value is a move-only
// view that owns nothing (kinds::holds_inout, not owned): a closure that
// changes a capture, a struct with an inout field.
fn let_param_view(n: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var e = n;
        if pcx.nodes[e].kind == NodeKind::Unary
            && pcx.nodes[e].op == crate::front::lexer::Tok::Star {
            e = pcx.nodes[e].b;
        }
        if pcx.nodes[e].kind != NodeKind::Ident
            || pcx.nodes[e].res != crate::front::check::Res::Local
            || pcx.nodes[e].y < 0 {
            return false;
        }
        let l = pcx.nodes[e].y;
        let t = pcx.nodes[n].ty;
        pcx.locals[l].is_param && !pcx.locals[l].is_sink && t > 0
            && !crate::front::own::kinds::is_owned_type(t, &pcx)
            && crate::front::own::kinds::is_moved_type(t, &pcx)
    }
}

// (0.20) How move_out says a capture was moved inside its closure.
const MO_CAPTURED: i64 = -2;

// The capture of a closure that place expression n reaches through the
// closure's env (closures::rewrite_use: NODE_CAPTURE), or 0.
fn captured_use(n: i64, pcx: Ctx<Comp>) -> i64 {
    var e = n;
    while e > 0 {
        if (pcx.nodes[e].p & NODE_CAPTURE) != 0 {
            return e;
        }
        let k = pcx.nodes[e].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            e = pcx.nodes[e].a;
        } else if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
            e = pcx.nodes[e].b;
        } else {
            return 0;
        }
    }
    0
}

// Capture use n (`(*env).x`) moved in the body of the closure walked: when
// it is a sink closure's own capture with a flag (closures::finish_closure),
// the move is allowed (the places IR clears the flag, and stops the
// program at a second move: build.vl live_writes).
fn sink_capture_move(n: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) -> bool {
    if pcx.nodes[n].kind != NodeKind::FieldAccess {
        return false;
    }
    var id = -1;
    for i in 0..pcx.closures.len() as i64 {
        if pcx.closures[i].f == ocx.cur_f {
            id = i;
        }
    }
    if id < 0 || (pcx.nodes[pcx.closures[id].node].c & crate::front::ast::CLOSURE_MOVE) == 0 {
        return false;
    }
    let s = pcx.closures[id].env_struct;
    let flag = crate::front::own::glue::flag_field(s, pcx.nodes[n].b, &pcx);
    if flag == 0 {
        return false;
    }
    true
}

// (0.25) Sink closure n (`sink || ..`, its Closure node) takes what it
// captures: a capture of a borrow of an owned value (a `let` or `inout`
// parameter, a `let self`, a loop's borrowed element) cannot be taken, as
// its owner keeps it: own.move_out. (A view, `[T]`, is captured as it is.)
pub fn sink_borrowed_captures(n: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let id = pcx.nodes[n].x - 1;
        if id < 0 || crate::front::modules::std_moves_bits(pcx.fns[ocx.cur_f].module, pcx) {
            return;
        }
        for j in 0..pcx.closures[id].capture_count {
            let at = pcx.closures[id].captures + 2 * j;
            let l = pcx.capture_list.data[at];
            if pcx.capture_list.data[at + 1] != 0 {
                continue;
            }
            let t = pcx.locals[l].ty;
            if t <= 0 || pcx.types[t].kind != TyKind::Ptr || pcx.types[t].b == 0
                || !is_owned_type(pcx.types[t].a, &pcx) {
                continue;
            }
            own_begin(n, OWN_MOVE_OUT, &pcx);
            own_str(c"cannot move ", pcx);
            own_sym(pcx.locals[l].name, pcx);
            own_str(c" (", pcx);
            own_type(pcx.types[t].a, pcx);
            own_str(c") into the sink closure: it is borrowed here (", pcx);
            own_str(if pcx.types[t].b == crate::front::types::REF_MUT { c"inout" } else { c"let" },
                pcx);
            own_str(c"), and its owner keeps it", pcx);
            own_help(c"clone it before the closure and capture the copy, drop 'sink' to borrow it, or take the parameter 'sink' to own it", pcx);
            own_end(&pcx);
        }
    }
}

// Place p is (re)initialized: it and its parts are no longer moved.
pub fn on_init(p: i64, ocx: inout OwnCx) {
    unsafe {
        let moved = moved_bits(&ocx);
        let dmoved = dmoved_bits(&ocx);
        for q in p..ocx.pl_count {
            if q == p || is_below(q, p, ocx) {
                let w = q >> 6;
                let bit = 1 << (q & 63);
                moved[w] = moved[w] & ~bit;
                dmoved[w] = dmoved[w] & ~bit;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The findings

// A use of place p at node n: own.moved when a place overlapping it has
// moved (once per local).
fn check_moved(p: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let moved = moved_bits(&ocx);
        if !any_and(moved, &ocx.pl_mask[p * ocx.nw], ocx) {
            return;
        }
        let root = root_of(p, ocx);
        let key = ocx.pl_rid[root] * 4 + ocx.pl_rkind[root] + 1;
        if pcx.reported.get(key) != 0 {
            return;
        }
        pcx.reported.put(key, 1);
        pcx.reported_keys.push(key);
        // (the moved place: the last one found that overlaps p)
        var q = -1;
        for i in 0..ocx.pl_count {
            if get_bit(moved, i) && get_bit(&ocx.pl_mask[p * ocx.nw], i) {
                q = i;
            }
        }
        let definite = any_and(dmoved_bits(&ocx), &ocx.pl_mask[p * ocx.nw], ocx);
        let by = if q >= 0 { ocx.pl_moved_by[q] } else { 0 };
        own_begin(n, OWN_MOVED, &pcx);
        place_name(p, ocx, pcx);
        if q >= 0 && q != p {
            own_str(c" is used here after ", pcx);
            place_name(q, ocx, pcx);
            own_str(if definite { c" moved" } else { c" may have moved" }, pcx);
        } else {
            own_str(if definite { c" is used here after it moved" }
                else { c" is used here after it may have moved" }, pcx);
        }
        // (0.25.3) the literal that took it: `App { dev: d, .. }`, `(a, b)`
        let lit = if by > 0 && !made_closure(by, pcx) { literal_of(by, pcx) } else { 0 };
        if by > 0 && made_closure(by, pcx) {
            own_str(c" into the sink closure", pcx);
        } else if lit > 0 {
            own_str(c" into ", pcx);
            own_bytes(literal_words(lit, pcx), pcx);
        } else if by > 0 {
            moved_into(by, pcx);
        }
        if by > 0 {
            own_str(c" at ", pcx);
            line_col(pcx.nodes[by].start, pcx);
        }
        if !definite {
            own_str(c" (on some paths)", pcx);
        }
        // (0.25: a copy only of what has Clone; a sink closure takes what it
        // captures, and its node is no argument to wrap)
        let closure = by > 0 && made_closure(by, pcx);
        let moved_ty = if by > 0 && !closure { pcx.nodes[by].ty }
            else if q == p || q < 0 { pcx.nodes[n].ty } else { -1 };
        let copy = moved_ty >= 0 && can_clone(moved_ty, &pcx);
        // (0.25.3) a std function that keeps it (`Vec::push(sink x)`): its
        // parameter is not the program's to change
        let std_callee = if by > 0 && !closure && lit == 0 { std_sink_callee(by, pcx) } else { "" };
        if lit > 0 {
            own_help(if copy {
                c"a literal moves the values it is given: use it before the literal, give the literal a copy ('.clone()'), or reach it through its new owner (the literal's field)"
            } else {
                c"a literal moves the values it is given: use it before the literal, or reach it through its new owner (the literal's field); a function that only reads it takes it let ('x: T')"
            }, pcx);
        } else if std_callee.len > 0 {
            own_help_bytes(std_callee, pcx);
            own_help(if copy {
                c" keeps it: use it before the call, give the call a copy ('.clone()'), or reach it where it is kept ('v[i]', 'v.last()')"
            } else {
                c" keeps it: use it before the call, or reach it where it is kept ('v[i]', 'v.last()')"
            }, pcx);
        } else if closure {
            own_help(if copy {
                c"the sink closure takes what it captures: use it before the closure, give the closure a copy ('let c = x.clone();' before it, 'c' in it), or capture it as a view: a closure without 'sink' that does not outlive it"
            } else {
                c"the sink closure takes what it captures: use it before the closure, or capture it as a view: a closure without 'sink' that does not outlive it"
            }, pcx);
        } else if !crate::front::conv::strict_at(pcx.nodes[n].start, &pcx) {
            own_help(if copy {
                c"use it before the move, pass a copy where it moves ('.clone()'), or take it by reference ('&')"
            } else {
                c"use it before the move, or take it by reference ('&')"
            }, pcx);
        } else {
            own_help(if copy {
                c"use it before the move, pass a copy where it moves ('.clone()'), or let the callee read it: a let parameter ('x: T'), not 'sink'"
            } else {
                c"use it before the move, or let the callee read it: a let parameter ('x: T'), not 'sink'"
            }, pcx);
        }
        gpu_handle_help(moved_ty, &pcx);
        // (0.25: not a pattern's binding, walk::bind_parts: `.clone()` there
        // does not parse)
        if by > 0 && copy && !closure && pcx.nodes[by].kind != NodeKind::PatBind {
            try_wrap(by, c"", c".clone()", ocx, pcx);
        }
        own_end(&pcx);
    }
}

// Whether a value of type t has a `.clone()` to suggest (0.25: not for a
// type without Clone). std's containers' Clone impls are in a section
// read only when the program mentions Clone (stdsections), so they are
// known by name too: Vec, Buf, String, HashMap, Option, Result of what
// has Clone (an allocator argument aside).
fn can_clone(t: i64, pcx: inout Ctx<Comp>) -> bool {
    clone_depth(t, 0, &pcx)
}

fn clone_depth(t: i64, depth: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        // (std's Clone itself is read only when the program mentions it)
        let tr = crate::front::traits::std_trait(c"Clone", &pcx);
        if t <= 0 || crate::front::check::has_error_type(t, pcx) || depth > 4 {
            return false;
        }
        if tr >= 0 && crate::front::traits::implements(tr, t, &pcx) {
            return true;
        }
        if crate::front::derive::intrinsic::is_plain(t, pcx) {
            return true;
        }
        let k = pcx.types[t].kind;
        var tmpl = 0;
        var targs = 0;
        var count = 0;
        if k == TyKind::Struct && pcx.structs[pcx.types[t].a].tmpl != 0 {
            let s = pcx.types[t].a;
            tmpl = pcx.structs[s].tmpl;
            targs = pcx.structs[s].targs;
            count = pcx.structs[s].targ_count;
            if !within_std(pcx.structs[pcx.structs[s].tmpl - 1].module, pcx) {
                return false;
            }
        } else if k == TyKind::Enum && crate::front::types::ENUMS[pcx.types[t].a].tmpl != 0 {
            let e = pcx.types[t].a;
            tmpl = -crate::front::types::ENUMS[e].tmpl;
            targs = crate::front::types::ENUMS[e].targs;
            count = crate::front::types::ENUMS[e].targ_count;
            if !within_std(
                crate::front::types::ENUMS[crate::front::types::ENUMS[e].tmpl - 1].module, pcx) {
                return false;
            }
        } else {
            return false;
        }
        let sym = crate::front::generics::template_name(tmpl, &pcx);
        let name = sym_text(sym, pcx);
        if !(name == "Vec" || name == "Buf" || name == "String" || name == "HashMap"
            || name == "Option" || name == "Result") {
            return false;
        }
        let alloc = crate::front::traits::std_trait(c"Allocator", &pcx);
        for i in 0..count {
            let a = pcx.tlists.data[targs + i];
            if !(alloc >= 0 && crate::front::traits::implements(alloc, a, &pcx))
                && !clone_depth(a, depth + 1, &pcx) {
                return false;
            }
        }
        true
    }
}

// Whether node n is a closure as made (the closure, or the env the
// closures pass made of it at its position).
fn made_closure(n: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.nodes[n].kind == NodeKind::Closure {
        return true;
    }
    for i in 0..pcx.closures.len() as i64 {
        let c = pcx.closures[i].node;
        if c > 0 && pcx.nodes[c].start == pcx.nodes[n].start
            && pcx.nodes[c].end == pcx.nodes[n].end {
            return true;
        }
    }
    false
}

pub fn note_move_arg(arg: i64, call: i64, i: i64, pcx: inout Ctx<Comp>) {
    if i < 256 {
        pcx.move_call.put(arg + 1, call * 256 + i);
    }
}

// ` into 'f(sink x)'` (or `'f(x)'` for a by-value parameter in 0.19's
// spelling) for the move at node by, when it is an argument.
fn moved_into(by: i64, pcx: Ctx<Comp>) {
    unsafe {
        let v = pcx.move_call.get(by + 1);
        if v <= 0 {
            return;
        }
        let call = v / 256;
        let i = v % 256;
        let f = pcx.nodes[call].x - 1;
        if f < 0 {
            return;
        }
        let p = crate::front::conv::param_node(f, i, pcx);
        // (a parameter written `sink`: one in 0.19's spelling keeps the
        // message it had)
        if p <= 0 || crate::front::conv::param_conv(p, pcx) != crate::front::conv::CONV_SINK_K {
            return;
        }
        let name = sym_text(
            pcx.fns[if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f }].display, pcx);
        var cut = 0;
        while cut < name.len as i64 && name[cut] != '<' {
            cut += 1;
        }
        own_str(c" into '", pcx);
        own_bytes(name[0..cut], pcx);
        own_str(c"(", pcx);
        own_str(c"sink ", pcx);
        own_bytes(sym_text(pcx.nodes[p].a, pcx), pcx);
        own_str(c")'", pcx);
    }
}

// (0.25.3) The name of the std function whose sink parameter took the
// value moved at node `by` (`'Vec::push'`), else "".
fn std_sink_callee(by: i64, pcx: Ctx<Comp>) -> [u8] {
    let v = pcx.move_call.get(by + 1);
    if v <= 0 {
        return "";
    }
    let f = (pcx.nodes[v / 256].x) - 1;
    if f < 0 {
        return "";
    }
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is the function the call resolved to (its node's x - 1,
    // below FN_COUNT), and an instance's tmpl - 1 its template's index.
    let info = unsafe {
        if pcx.fns[f].tmpl > 0 { pcx.fns[pcx.fns[f].tmpl - 1] } else { pcx.fns[f] }
    };
    if !within_std(info.module, pcx) {
        return "";
    }
    let name = crate::base::sym_text(info.display, pcx);
    var cut = 0;
    while cut < name.len as i64 && name[cut] != '<' {
        cut += 1;
    }
    let b = buf_new();
    buf_bytes(b, "'");
    buf_bytes(b, name[0..cut]);
    buf_bytes(b, "'");
    buf_slice(b)
}

pub fn note_literal(lit: i64, pcx: inout Ctx<Comp>) {
    for i in 0..lit_node(lit, pcx).count {
        let c = child(lit, i, pcx);
        let cn = lit_node(c, pcx);
        let v = if cn.kind == NodeKind::FieldInit || cn.kind == NodeKind::NamedArg { cn.b }
            else { c };
        if v > 0 {
            pcx.move_lit.put(v + 1, lit + 1);
        }
    }
}

// Node n of a literal or of what it holds.
fn lit_node(n: i64, pcx: Ctx<Comp>) -> crate::front::ast::Node {
    pcx.nodes[n]
}

// The literal node n moved into (0: none).
fn literal_of(n: i64, pcx: Ctx<Comp>) -> i64 {
    if n <= 0 {
        return 0;
    }
    let v = pcx.move_lit.get(n + 1);
    if v > 0 { v - 1 } else { 0 }
}

// What literal `lit` is called in a message: `the struct literal 'App {
// .. }'`, `a tuple`, `an array`, `'E::V(..)'`.
fn literal_words(lit: i64, pcx: Ctx<Comp>) -> [u8] {
    let ln = lit_node(lit, pcx);
    let k = ln.kind;
    if k == NodeKind::Tuple {
        return "a tuple";
    }
    if k == NodeKind::Array {
        return "an array";
    }
    let text = SRC[ln.start..ln.end];
    var e = 0;
    while e < text.len as i64 && text[e] != '{' && text[e] != '(' {
        e += 1;
    }
    var h = e;
    while h > 0 && (text[h - 1] == ' ' || text[h - 1] == '\n') {
        h -= 1;
    }
    let b = buf_new();
    if k == NodeKind::StructLit {
        buf_bytes(b, "the struct literal '");
    } else {
        buf_bytes(b, "'");
    }
    buf_bytes(b, text[0..h]);
    if e < text.len as i64 && text[e] == '(' {
        buf_bytes(b, "(..)'");
    } else {
        buf_bytes(b, " { .. }'");
    }
    buf_slice(b)
}

// (0.25.3) Whether type t is one of std::gpu's (a Device, a Buffer, a
// BindGroup: handles that move, which the guide's gpu#handles explains).
fn gpu_handle(t: i64, pcx: inout Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let info = pcx.types[t];
    if info.kind != TyKind::Struct {
        return false;
    }
    // UNSAFE: STRUCTS is the table of structs, a raw pointer (front/types).
    // SAFETY: a struct type's a is its struct's index, below the number of
    // structs.
    let m = unsafe { pcx.structs[info.a].module };
    let std_m = pcx.std_module;
    if std_m < 0 || m < 0 {
        return false;
    }
    let g = crate::front::modules::child_module(std_m, crate::base::intern_c(c"gpu", &pcx), pcx);
    g >= 0 && crate::front::modules::is_within(m, g, pcx)
}

// The help's pointer to the guide for a std::gpu handle of type t.
fn gpu_handle_help(t: i64, pcx: inout Ctx<Comp>) {
    if gpu_handle(t, &pcx) {
        own_help(c"; std::gpu's handles move and are kept by one owner: `volec guide gpu#handles`",
            pcx);
    }
}

// own.move_out: place p moved at node n out of an index, a reference, a
// static (how: MO_*), or a binding that borrows (-1).
fn move_out(p: i64, n: i64, how: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if crate::front::modules::std_moves_bits(pcx.fns[ocx.cur_f].module, pcx) {
            // (std's containers and iterators copy elements as unsafe
            // code does, for the callers that borrow them
            // (drops::borrowed_call); a copy that would be owned twice is
            // reported at the call: bitwise_extend. 0.25.2: not the rest of
            // std, which moves as a program does)
            return;
        }
        own_begin(n, OWN_MOVE_OUT, &pcx);
        own_str(c"cannot move ", pcx);
        src_quoted(n, pcx);
        own_str(c" (", pcx);
        own_type(pcx.nodes[n].ty, pcx);
        own_str(c") ", pcx);
        if how == MO_INDEX {
            own_str(c"out of an index: the collection keeps its elements", pcx);
        } else if how == MO_STATIC {
            own_str(c"out of a static", pcx);
        } else if how == MO_DEREF {
            own_str(c"out of a reference: what it points to keeps its value", pcx);
        } else if how == MO_CAPTURED {
            own_str(c"out of the closure that captures it: the closure may be called again, and its drop, or its owner's, drops it", pcx);
        } else {
            let root = root_of(p, ocx);
            var at = pcx.byref.get(ocx.pl_rid[root] + 1) - 1;
            // (0.18: a requires check's block, through to its call)
            let wrapped = crate::front::contracts::expand::requires_tail(at, pcx);
            if wrapped > 0 {
                at = wrapped;
            }
            // (0.25: `v.last()?`, its call)
            while at > 0 && pcx.nodes[at].kind == NodeKind::Try {
                at = pcx.nodes[at].a;
            }
            if at > 0 && pcx.nodes[at].kind == NodeKind::Index {
                own_str(c"out of ", pcx);
                own_sym(pcx.locals[ocx.pl_rid[root]].name, pcx);
                own_str(c": it is a loop's element, which the loop reads in place", pcx);
            } else if at > 0 && pcx.nodes[at].kind == NodeKind::Call {
                own_str(c"out of ", pcx);
                own_sym(pcx.locals[ocx.pl_rid[root]].name, pcx);
                own_str(c": it is a copy of an element ", pcx);
                src_quoted(at, pcx);
                own_str(c" (", pcx);
                line_col(pcx.nodes[at].start, pcx);
                own_str(c") reads, which the collection keeps", pcx);
            } else if at > 0 && (pcx.nodes[at].kind == NodeKind::Closure
                || pcx.nodes[at].kind == NodeKind::Unary && pcx.nodes[at].b > 0
                && pcx.nodes[pcx.nodes[at].b].kind == NodeKind::Closure) {
                // (a closure lent to a let parameter, `&|v| ..`, too)
                own_str(c"out of ", pcx);
                own_sym(pcx.locals[ocx.pl_rid[root]].name, pcx);
                own_str(c": the closure is given an iterator's item, a copy of an element the container keeps", pcx);
            } else if at > 0 && pcx.nodes[at].kind == NodeKind::Param {
                own_str(c"out of ", pcx);
                own_sym(pcx.locals[ocx.pl_rid[root]].name, pcx);
                own_str(c": a contract's condition reads the parameters in place", pcx);
            } else if at > 0 {
                own_str(c"out of ", pcx);
                own_sym(pcx.locals[ocx.pl_rid[root]].name, pcx);
                own_str(c": the match on ", pcx);
                src_quoted(at, pcx);
                own_str(c" (", pcx);
                line_col(pcx.nodes[at].start, pcx);
                own_str(c") binds it by reference", pcx);
            } else {
                own_str(c"out of a binding that views it", pcx);
            }
        }
        // (0.25.2.1: '.clone()' only for a type that has it; a handle such
        // as std::gpu's Device is moved into its owner, or kept by index)
        let cl = can_clone(pcx.nodes[n].ty, &pcx);
        let tn = buf_new();
        if !cl {
            buf_type(tn, pcx.nodes[n].ty, pcx);
        }
        let strict = crate::front::conv::strict_at(pcx.nodes[n].start, &pcx);
        // (0.25.2.2) whether the type has a Default for 'std::take' to leave
        // in its place: a plain value, std's Default (read only when the
        // program mentions it, so a type nothing makes Default has none),
        // an Option (None)
        let ty = pcx.nodes[n].ty;
        var dflt = false;
        if ty > 0 && !crate::front::check::has_error_type(ty, pcx) {
            let tr = crate::front::traits::std_trait(c"Default", &pcx);
            dflt = crate::front::derive::intrinsic::is_plain(ty, pcx)
                || (tr >= 0 && crate::front::traits::implements(tr, ty, &pcx));
            if !dflt && pcx.types[ty].kind == TyKind::Enum
                && crate::front::types::ENUMS[pcx.types[ty].a].tmpl != 0 {
                let tmpl = crate::front::types::ENUMS[pcx.types[ty].a].tmpl;
                dflt = within_std(crate::front::types::ENUMS[tmpl - 1].module, pcx)
                    && crate::front::generics::template_text(-tmpl, &pcx) == "Option";
            }
        }
        if how == MO_INDEX {
            if cl {
                own_help(if !strict {
                    c"take it out with 'v.remove(i)' or 'std::take(&mut v[i])', or copy it ('.clone()')"
                } else {
                    c"read it in place ('let x = v[i];'), take it out with 'v.remove(i)' or 'std::take(&v[i])', or copy it ('.clone()')"
                }, pcx);
                try_wrap(n, c"", c".clone()", ocx, pcx);
            } else {
                own_help(if !strict {
                    c"take it out with 'v.remove(i)' or 'std::take(&mut v[i])', or keep the index and use 'v[i]' where it is needed"
                } else {
                    c"take it out with 'v.remove(i)' or 'std::take(&v[i])', or keep the index and use 'v[i]' where it is needed"
                }, pcx);
                no_clone_help(buf_slice(tn), pcx);
            }
        } else if how == -1 {
            if cl {
                own_help(c"copy it ('.clone()'), or match (or loop over) a value the code owns",
                    pcx);
                try_wrap(n, c"", c".clone()", ocx, pcx);
            } else {
                own_help(c"match (or loop over) a value the code owns, or keep an index and read the element in place", pcx);
                no_clone_help(buf_slice(tn), pcx);
            }
        } else if how == MO_CAPTURED {
            if cl {
                own_help(c"use a copy inside the closure ('.clone()'), or move the value out where the closure is made, not in its body", pcx);
                try_wrap(n, c"", c".clone()", ocx, pcx);
            } else {
                own_help(c"move the value out where the closure is made, not in its body, or use it in place in the closure", pcx);
                no_clone_help(buf_slice(tn), pcx);
            }
        } else if read_only_root(p, ocx, pcx) {
            // (0.24: through a let access, `fn add(self, ..) -> N { self }`:
            // nothing can be taken out of it)
            if cl {
                own_help(c"it is a let access, read-only: copy it ('.clone()'), or take the parameter 'sink' to own it ('sink self', 'x: sink T')", pcx);
                try_wrap(n, c"", c".clone()", ocx, pcx);
            } else {
                own_help(c"it is a let access, read-only: take the parameter 'sink' to own it and store it ('sink self', 'x: sink T'), move it into its one owner and reach it through that owner, or keep an index to it", pcx);
                no_clone_help(buf_slice(tn), pcx);
            }
        } else if !cl && !owned_base_type(pcx.nodes[n].ty, &pcx) && !dflt {
            // (0.25.2.2, eval 0.25.2.1: windtunnel, physarum) a handle with
            // neither Default nor Clone (std::gpu's BindGroup, Buffer):
            // nothing can be left in its place, and taking it would empty
            // the field the next step reads
            let f = file_of(pcx.nodes[n].start, pcx);
            let lit = literal_of(n, pcx);
            no_default_help(SRC[pcx.nodes[n].start..pcx.nodes[n].end],
                SRC[pcx.files[f].start..pcx.nodes[n].start],
                SRC[pcx.nodes[n].end..pcx.files[f].end], buf_slice(tn),
                if lit > 0 { literal_words(lit, pcx) } else { "" }, pcx);
        } else {
            if cl {
                own_help(if !strict {
                    c"take it out and leave an empty value in its place ('x.take()' of a Vec, Buf or HashMap, 'std::take(&mut x)', 'std::replace(&mut x, v)'), copy it ('.clone()'), or borrow it ('&')"
                } else {
                    c"take it out and leave an empty value in its place ('x.take()' of a Vec, Buf or HashMap, 'std::take(&x)', 'std::replace(&x, v)'), copy it ('.clone()'), or read it in place: pass it on let, or take the parameter 'sink' to own it"
                }, pcx);
            } else {
                own_help(if !strict {
                    c"take it out and leave an empty value in its place ('x.take()' of a Vec, Buf or HashMap, 'std::take(&mut x)', 'std::replace(&mut x, v)'), or borrow it ('&')"
                } else {
                    c"take it out and leave an empty value in its place ('x.take()' of a Vec, Buf or HashMap, 'std::take(&x)', 'std::replace(&x, v)'), or read it in place: pass it on let, or take the parameter 'sink' to own it"
                }, pcx);
                no_clone_help(buf_slice(tn), pcx);
            }
            if owned_base_type(pcx.nodes[n].ty, &pcx) {
                // (a container keeps its allocator: T4's `take`)
                try_wrap(n, c"", c".take()", ocx, pcx);
            } else if dflt {
                try_wrap(n,
                    c"std::take(&", c")", ocx, pcx);
            }
            if cl { try_wrap(n, c"", c".clone()", ocx, pcx); }
        }
        gpu_handle_help(pcx.nodes[n].ty, &pcx);
        own_end(&pcx);
    }
}

// (0.25.2.2) The help of a move out of a reference of a value with neither
// Default nor Clone (a std::gpu handle), the value's text `s` (`before`
// and `after` it, its file's text): read it in place, and where an `if` or
// `match` picks one of two fields (`let g = if k == 0 { self.g0 } else {
// self.g1 };`), use each field inside its branch.
fn no_default_help(s: [u8], before: [u8], after: [u8], tn: [u8], lit: [u8], pcx: Ctx<Comp>) {
    let b = buf_new();
    if lit.len > 0 {
        // (0.25.3, eval 0.25.2.2: `App { dev: self.dev }`, `let (a, b) =
        // (self.a, self.b);`) a literal moves what it is given
        buf_fmt(b,
            format_args("{lit} moves '{s}' out of its owner, and '{tn}' has no Default to leave in its place (no 'std::take') and no '.clone()': read it in place where it is needed, passing '{s}' itself to a let parameter (`f({s})`), or make the literal where the value is owned (a 'sink' parameter, a local)"));
    } else if chosen_by_branch(before, after) {
        buf_fmt(b,
            format_args("an `if` or `match` that picks '{s}' moves it out, and '{tn}' has no Default to leave in its place (no 'std::take') and no '.clone()': use the field inside each branch, where a let parameter reads it in place (`if c {{ f({s}) }} else {{ f(...) }}`), or pass '{s}' itself where it is needed"));
    } else {
        buf_fmt(b,
            format_args("'{tn}' has no Default to leave in its place (no 'std::take') and no '.clone()': read it in place, passing '{s}' itself to a let parameter (`f({s})`), or take the parameter 'sink' to own it"));
    }
    own_help_bytes(buf_slice(b), pcx);
}

// Whether a value is one a branch gives, from the text `before` and
// `after` it: a match arm's (`=> self.g0,`), or the last thing in a block
// (`{ self.g0 }`) that is an `if`'s, an `else`'s or an arm's (its line has
// `if`, `else` or `=>`), not a function's body.
fn chosen_by_branch(before: [u8], after: [u8]) -> bool {
    var i = before.len as i64;
    while i > 0 && (before[i - 1] == ' ' || before[i - 1] == '\n' || before[i - 1] == '\t') {
        i -= 1;
    }
    var j = 0;
    while j < after.len as i64 && (after[j] == ' ' || after[j] == '\n' || after[j] == '\t') {
        j += 1;
    }
    if i < 2 || j >= after.len as i64 {
        return false;
    }
    if before[i - 1] == '>' && before[i - 2] == '=' {
        return after[j] == ',' || after[j] == '}';
    }
    if before[i - 1] != '{' || after[j] != '}' {
        return false;
    }
    // (the text before the `{` on its line)
    var ls = i - 1;
    while ls > 0 && before[ls - 1] != '\n' {
        ls -= 1;
    }
    let line = buf_new();
    buf_byte(line, ' ');
    buf_bytes(line, before[ls..i - 1]);
    let t = buf_slice(line);
    !has_text(t, " fn ") && (has_text(t, " if ") || has_text(t, "else") || has_text(t, "=>"))
}

// Whether text t has `part` in it.
fn has_text(t: [u8], part: [u8]) -> bool {
    var k = 0;
    while k + part.len as i64 <= t.len as i64 {
        if t[k..k + part.len as i64] == part {
            return true;
        }
        k += 1;
    }
    false
}

// The help's note that a type (its name) has no `.clone()`, which
// move_out then offers none of: ` ('Device' has no '.clone()')`.
fn no_clone_help(name: [u8], pcx: Ctx<Comp>) {
    own_help(c" ('", pcx);
    own_help_bytes(name, pcx);
    own_help(c"' has no '.clone()')", pcx);
}

// Whether place p is reached through a let access (a let parameter or
// binding that borrows: read-only).
fn read_only_root(p: i64, ocx: OwnCx, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if p < 0 {
            return false;
        }
        let root = root_of(p, ocx);
        if ocx.pl_rkind[root] != RK_LOCAL {
            return false;
        }
        let l = ocx.pl_rid[root];
        let t = pcx.locals[l].ty;
        pcx.locals[l].access && t > 0 && pcx.types[t].kind == TyKind::Ptr
            && pcx.types[t].b == crate::front::types::REF_SHARED
    }
}

// own.move_out of value n, no place (`v[i]` of a Vec, a call's `*r`): out
// of an index or a reference (how: MO_INDEX, MO_DEREF).
pub fn move_out_value(n: i64, how: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    // (std's accessors make the copies callers borrow:
    // drops::borrowed_call)
    move_out(-1, n, how, ocx, &pcx);
}

// (0.18.1) own.readonly: a `&mut` loan at node n of owned place p (of type
// t), or an assignment to one, that is part of a binding that borrows (BYREF: a match through a
// reference, a `for` loop's element, a copy `v.get(i)` reads): the binding
// is a bitwise copy, and a change to it (a push that moves the elements,
// a free) would leave the original pointing at memory that is gone.
pub fn byref_change(p: i64, n: i64, t: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if p < 0 || crate::front::modules::std_moves_bits(pcx.fns[ocx.cur_f].module, pcx)
            || ocx.po_raw
            || !is_owned_type(t, &pcx) {
            return;
        }
        let root = root_of(p, ocx);
        if ocx.pl_rkind[root] != RK_LOCAL {
            return;
        }
        let l = ocx.pl_rid[root];
        let at = pcx.byref.get(l + 1) - 1;
        if at <= 0 {
            return;
        }
        own_begin(n, OWN_READONLY, &pcx);
        own_str(c"changes ", pcx);
        own_sym(pcx.locals[l].name, pcx);
        own_str(c" (", pcx);
        own_type(pcx.locals[l].ty, pcx);
        own_str(c"), ", pcx);
        let k = pcx.nodes[at].kind;
        if k == NodeKind::Index {
            own_str(c"a copy of a loop's element, which the loop reads in place: ", pcx);
            own_str(c"the change would not reach the element, and could free memory it points to",
                pcx);
            own_help(c"loop over the indices and change the element in place ('for i in 0..v.len() { v[i]... }')", pcx);
        } else if crate::front::own::byref::borrowed_call(at, &pcx) {
            own_str(c"a copy of an element ", pcx);
            src_quoted(at, pcx);
            own_str(c" reads: the change would not reach the element, and could free memory it points to", pcx);
            own_help(c"change the element in place ('v[i]...'), or work on a copy ('.clone()')",
                pcx);
        } else {
            own_str(c"a copy the match on ", pcx);
            src_quoted(at, pcx);
            own_str(c" (", pcx);
            line_col(pcx.nodes[at].start, pcx);
            own_str(c") binds: the change would not reach it, and could free memory it points to",
                pcx);
            own_help(c"match the access itself ('match e' for 'e: inout E', or 'match &x'): its bindings are inout accesses into the value", pcx);
        }
        own_end(&pcx);
    }
}

// own.move_out: the value of call n, a copy of an element a collection
// keeps (drops::borrowed_call), moved at once: passed by value.
pub fn borrowed_move(n: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    own_begin(n, OWN_MOVE_OUT, &pcx);
    own_str(c"cannot move ", pcx);
    src_quoted(n, pcx);
    own_str(c" (", pcx);
    own_type(pcx.nodes[n].ty, pcx);
    own_str(c"): it is a copy of an element the collection keeps", pcx);
    own_help(c"copy it ('.clone()'), or pass the element by reference ('&v[i]')", pcx);
    if can_clone(pcx.nodes[n].ty, &pcx) { try_wrap(n, c"", c".clone()", ocx, pcx); }
    own_end(&pcx);
}

// own.move_out: argument n, a slice of owned elements, given to std's
// `extend_from_slice`, which copies them bit for bit (until 0.17.1 gives
// it a `T: Clone` bound): both would own them.
pub fn bitwise_extend(n: i64, pcx: inout Ctx<Comp>) {
    own_begin(n, OWN_MOVE_OUT, &pcx);
    own_str(c"cannot copy the elements of ", pcx);
    src_quoted(n, pcx);
    own_str(c" (", pcx);
    own_type(pcx.nodes[n].ty, pcx);
    own_str(c"): extend_from_slice copies them bit for bit, and the elements are owned", pcx);
    own_help(c"push clones: 'for x in s.iter() { v.push(x.clone()); }'", pcx);
    own_end(&pcx);
}

// (0.24, a stopgap until a borrowing iterator's items are views) Call n of
// std's f, in the program's code: when an argument (the receiver too) is
// an iterator that yields, by a bitwise copy, the non-copyable elements of
// a container it borrows (`w.iter()` of a Vec<Vec<i64>>, a HashMap's
// iter, keys, values; or an adapter of one), and f may keep, return or
// drop its items (collect, map, fold, for_each, next, find, extend...),
// own.move_out: they would be owned twice. Building adapters that only
// look at them (filter, take, zip...) and the counting and testing ones
// (count, any, all, position) are allowed, and so is a `for` loop (its
// items are borrowed).
pub fn iter_item_copy(n: i64, f: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let name = fn_word(sym_text(pcx.fns[f].display, pcx));
        if name == "filter" || name == "skip" || name == "take" || name == "step_by"
            || name == "rev" || name == "enumerate" || name == "zip" || name == "chain"
            || name == "peekable" || name == "count" || name == "any" || name == "all"
            || name == "position" || name == "len" || name == "exact_len" || name == "is_empty"
            || name == "size_hint" || name == "as_slice" || name == "iter" || name == "iter_ref"
            // (their closures borrow the items, check::calls::synth_method)
            || (name == "map" || name == "for_each" || name == "filter_map")
            && pcx.nodes[n].count == 2 && pcx.nodes[child(n, 1, pcx)].kind == NodeKind::Closure
            || name == "fold" && pcx.nodes[n].count == 3
            && pcx.nodes[child(n, 2, pcx)].kind == NodeKind::Closure {
            return;
        }
        for i in 0..pcx.nodes[n].count {
            let arg = child(n, i, pcx);
            // (a `for` loop's own `next`: its items are borrowed)
            var r = arg;
            if pcx.nodes[r].kind == NodeKind::Unary && pcx.nodes[r].b > 0 {
                r = pcx.nodes[r].b;
            }
            if pcx.nodes[r].kind == NodeKind::Ident
                && sym_text(pcx.nodes[r].a, pcx) == "__for_seq" {
                return;
            }
            var t = pcx.nodes[arg].ty;
            if t > 0 && pcx.types[t].kind == TyKind::Ptr {
                t = pcx.types[t].a;
            }
            if !copies_owned_items(t, 0, &pcx) {
                continue;
            }
            own_begin(arg, OWN_MOVE_OUT, &pcx);
            own_str(c"cannot take the items of ", pcx);
            src_quoted(arg, pcx);
            own_str(c": they are views of the elements of the container it iterates over, copied bit for bit, and '", pcx);
            own_str(sym_text(pcx.fns[f].display, pcx).ptr, pcx);
            own_str(c"' may keep or drop them (each would be owned twice)", pcx);
            own_help(c"take copies, `.iter_ref().map(|x| x.clone())` (a Vec or a slice), or push clones in a loop, `for x in v.iter() { out.push(x.clone()); }`", pcx);
            own_end(&pcx);
            return;
        }
    }
}

// The name of function display name d without its type arguments:
// `filter` of `SliceIter<Vec<i64>>::filter<closure(..) at f.vl:8:2>`.
fn fn_word(d: [u8]) -> [u8] {
    var depth = 0;
    var from = 0;
    var i = 0;
    while i < d.len as i64 {
        let c = d[i];
        if c == '<' || c == '(' {
            depth += 1;
        } else if c == '>' && (i == 0 || d[i - 1] != '-') || c == ')' {
            depth -= 1;
        } else if depth == 0 && c == ':' && i + 1 < d.len as i64 && d[i + 1] == ':' {
            from = i + 2;
            i += 1;
        }
        i += 1;
    }
    var to = from;
    while to < d.len as i64 && d[to] != '<' {
        to += 1;
    }
    d[from..to]
}

// own.partial: moving node n (a field) out of a value whose type has a
// Drop impl (its drop needs all of it).
pub fn partial(n: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    var e = n;
    while pcx.nodes[e].kind == NodeKind::FieldAccess || pcx.nodes[e].kind == NodeKind::TupleField {
        if pcx.nodes[e].kind == NodeKind::FieldAccess && pcx.nodes[e].y == 1 {
            return;
        }
        let base = pcx.nodes[e].a;
        if has_drop_impl(pcx.nodes[base].ty, &pcx) {
            own_begin(n, OWN_PARTIAL, &pcx);
            own_str(c"cannot move ", pcx);
            src_quoted(n, pcx);
            own_str(c" out of ", pcx);
            src_quoted(base, pcx);
            own_str(c": '", pcx);
            own_type(pcx.nodes[base].ty, pcx);
            own_str(c"' implements Drop, which needs all of it", pcx);
            own_help(c"take the field out and leave a value in its place ('std::take(&x.f)', 'std::replace(&x.f, v)'), or copy it ('.clone()')", pcx);
            try_wrap(n, c"std::take(&", c")", ocx, pcx);
            own_end(&pcx);
            return;
        }
        e = base;
    }
}

// own.partial (0.26.1): assignment n gives back a part (place p) of a
// value whose type has a Drop impl after that value moved (on some path):
// its drop needs all of it, so a part alone cannot make it whole again
// (Rust's E0382, "assign to part of moved value"). With the value there,
// assigning a part is a write like any other.
pub fn partial_assign(p: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    // UNSAFE: the own pass's place tables (PL_MASK, PL_PARENT, PL_MOVED_BY)
    // and its moved sets are raw arrays (*i64).
    // SAFETY: p and every place read (its parents, i < PL_COUNT) are places
    // the walk made, below PL_COUNT; each set and mask is NW words.
    unsafe {
        let moved = moved_bits(&ocx);
        if !any_and(moved, &ocx.pl_mask[p * ocx.nw], ocx) {
            return;
        }
        var e = pcx.nodes[n].b;
        var q = p;
        while pcx.nodes[e].kind == NodeKind::FieldAccess
            || pcx.nodes[e].kind == NodeKind::TupleField {
            if pcx.nodes[e].kind == NodeKind::FieldAccess && pcx.nodes[e].y == 1 {
                return;
            }
            let base = pcx.nodes[e].a;
            let qb = ocx.pl_parent[q];
            if qb < 0 {
                return;
            }
            if has_drop_impl(pcx.nodes[base].ty, &pcx) {
                // (the whole, or a value it is part of, moved)
                var by = -1;
                for i in 0..ocx.pl_count {
                    if get_bit(moved, i) && (i == qb || is_below(qb, i, ocx)) {
                        by = i;
                    }
                }
                if by >= 0 {
                    let definite = get_bit(dmoved_bits(&ocx), by);
                    own_begin(pcx.nodes[n].b, OWN_PARTIAL, &pcx);
                    own_str(c"cannot assign to ", pcx);
                    src_quoted(pcx.nodes[n].b, pcx);
                    own_str(c": ", pcx);
                    src_quoted(base, pcx);
                    own_str(if definite { c" moved" } else { c" may have moved" }, pcx);
                    if ocx.pl_moved_by[by] > 0 {
                        own_str(c" at ", pcx);
                        line_col(pcx.nodes[ocx.pl_moved_by[by]].start, pcx);
                    }
                    own_str(c", and '", pcx);
                    own_type(pcx.nodes[base].ty, pcx);
                    own_str(c"' implements Drop, which needs all of it", pcx);
                    own_help(
                        c"assign the whole value, or change the field before it moves", pcx);
                    own_end(&pcx);
                }
                return;
            }
            e = base;
            q = qb;
        }
    }
}

// (0.25) own.partial: pattern pat, of a match by value, takes owned parts
// out of a value of type t, which implements Drop (its drop needs all of
// it).
pub fn partial_pattern(pat: i64, t: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if crate::front::modules::std_moves_bits(pcx.fns[ocx.cur_f].module, pcx) {
            return;
        }
        own_begin(pat, OWN_PARTIAL, &pcx);
        own_str(c"cannot move parts out of a '", pcx);
        own_type(t, pcx);
        own_str(c"' with ", pcx);
        src_quoted(pat, pcx);
        own_str(c": it implements Drop, which needs all of it", pcx);
        own_help(c"match it through an access ('match &e'), and clone what is kept; or bind it whole ('x => ...')", pcx);
        own_end(&pcx);
    }
}

// (0.25) own.drop_call: call n is `x.drop()` of a type's Drop impl,
// written by hand (the glue's own calls are not walked): x would be
// dropped again where its owner's scope ends.
pub fn drop_call(n: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if crate::front::modules::std_moves_bits(pcx.fns[ocx.cur_f].module, pcx)
            || pcx.nodes[n].kind != NodeKind::Call || pcx.nodes[n].count == 0 {
            return;
        }
        let f = pcx.nodes[n].x - 1;
        if f < 0 || pcx.fns[f].self_ty <= 0 || pcx.fns[f].node <= 0
            || !has_drop_impl(pcx.fns[f].self_ty, &pcx)
            || sym_text(pcx.nodes[pcx.fns[f].node].a, pcx) != "drop" {
            return;
        }
        var r = child(n, 0, pcx);
        if pcx.nodes[r].kind == NodeKind::Unary && pcx.nodes[r].op == Tok::Amp
            && pcx.nodes[r].b != 0 {
            r = pcx.nodes[r].b;
        }
        own_begin(n, OWN_DROP_CALL, &pcx);
        own_str(c"cannot call ", pcx);
        src_quoted(n, pcx);
        own_str(c": Drop's drop runs where the value's owner ends, and would run again there", pcx);
        own_help(c"drop it now with 'drop(x)', which takes it, or let its scope end", pcx);
        if pcx.nodes[r].start < pcx.nodes[r].end && pcx.nodes[r].end <= pcx.nodes[n].end {
            pcx.skip_from = pcx.nodes[r].end;
            pcx.skip_to = pcx.nodes[n].end;
            try_wrap(r, c"drop(", c")", ocx, pcx);
            pcx.skip_from = 0;
            pcx.skip_to = 0;
        }
        own_end(&pcx);
    }
}

// ---------------------------------------------------------------------------
// Positions and source text

// The file of position pos (an index in FILES).
fn file_of(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var f = 0;
    while f + 1 < pcx.files.len() as i64 && pos >= pcx.files[f + 1].start {
        f += 1;
    }
    f
}

// The line of position pos, from 1.
fn line_of(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var line = 1;
    var i = pcx.files[file_of(pos, pcx)].start;
    while i < pos {
        if SRC[i] == '\n' {
            line += 1;
        }
        i += 1;
    }
    line
}

// `LINE:COL` of position pos.
fn line_col(pos: i64, pcx: Ctx<Comp>) {
    var col = 1;
    var i = pos;
    let start = pcx.files[file_of(pos, pcx)].start;
    while i > start && SRC[i - 1] != '\n' {
        col += 1;
        i -= 1;
    }
    let b = buf_new();
    buf_int(b, line_of(pos, pcx));
    buf_byte(b, ':');
    buf_int(b, col);
    crate::front::own::diag::own_bytes(buf_slice(b), pcx);
}

// 'text' of node n's source.
fn src_quoted(n: i64, pcx: Ctx<Comp>) {
    let b = buf_new();
    buf_byte(b, '\'');
    for i in pcx.nodes[n].start..pcx.nodes[n].end {
        buf_byte(b, SRC[i]);
    }
    buf_byte(b, '\'');
    crate::front::own::diag::own_bytes(buf_slice(b), pcx);
}

// Appends s quoted for a shell (single quotes).
fn shell_quoted(out: i64, from: i64, to: i64, pre: i64, at: i64, end: i64, post: i64,
    pcx: Ctx<Comp>) {
    buf_byte(out, '\'');
    var i = from;
    while i <= to {
        if i == at && pre >= 0 {
            quote_bytes(out, buf_slice(pre));
        }
        if i == end && post >= 0 {
            quote_bytes(out, buf_slice(post));
        }
        if i < to && !(pre >= 0 && i >= pcx.skip_from && i < pcx.skip_to) {
            quote_byte(out, SRC[i]);
        }
        i += 1;
    }
    buf_byte(out, '\'');
}

fn quote_byte(out: i64, c: u8) {
    if c == '\'' {
        buf_str(out, c"'\\''");
    } else {
        buf_byte(out, c);
    }
}

fn quote_bytes(out: i64, s: [u8]) {
    for i in 0..s.len {
        quote_byte(out, s[i]);
    }
}

// The item (a function) that holds the code walked: a closure's enclosing
// function.
fn item_node(ocx: OwnCx, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var f = ocx.cur_f;
        var guard = 0;
        while f >= 0 && (pcx.nodes[pcx.fns[f].node].p & FN_CLOSURE) != 0 && guard < 64 {
            var outer = -1;
            for i in 0..pcx.closures.len() as i64 {
                if pcx.closures[i].f == f {
                    outer = pcx.closures[i].encl_fn;
                }
            }
            f = outer;
            guard += 1;
        }
        if f < 0 { 0 } else { pcx.fns[f].node }
    }
}

// A `try:` line that rewrites node n's text t as `pre t post` on its line:
// `volec edit patch FILE:LINE --old 'LINE' --new 'LINE'`, the line's
// text without its indentation (with --nth when the item has it more than
// once). None in std, or for a node over several lines.
fn try_wrap(n: i64, pre: *u8, post: *u8, ocx: OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        let start = pcx.nodes[n].start;
        let end = pcx.nodes[n].end;
        let f = file_of(start, pcx);
        let path = pcx.files[f].path;
        if path[0] == '<' || end <= start {
            return;
        }
        var ls = start;
        while ls > pcx.files[f].start && SRC[ls - 1] != '\n' {
            ls -= 1;
        }
        while ls < start && (SRC[ls] == ' ' || SRC[ls] == '\t') {
            ls += 1;
        }
        var le = start;
        while le < pcx.files[f].end && SRC[le] != '\n' {
            le += 1;
        }
        if end > le {
            return;
        }
        while le > end && (SRC[le - 1] == ' ' || SRC[le - 1] == '\t') {
            le -= 1;
        }
        let pre_b = buf_new();
        buf_str(pre_b, pre);
        let post_b = buf_new();
        buf_str(post_b, post);
        let args = buf_new();
        buf_str(args, c"edit patch ");
        buf_str(args, if path[0] == '.' && path[1] == '/' { &path[2] } else { path });
        buf_byte(args, ':');
        buf_int(args, line_of(start, pcx));
        buf_str(args, c" --old ");
        shell_quoted(args, ls, le, -1, -1, -1, -1, pcx);
        buf_str(args, c" --new ");
        shell_quoted(args, ls, le, pre_b, start, end, post_b, pcx);
        // (the line's text more than once in its item: which one)
        let item = item_node(ocx, pcx);
        if item != 0 {
            let len = le - ls;
            var seen = 0;
            var nth = 0;
            var i = pcx.nodes[item].start;
            while i + len <= pcx.nodes[item].end {
                var same = true;
                var j = 0;
                while j < len && same {
                    if SRC[i + j] != SRC[ls + j] {
                        same = false;
                    }
                    j += 1;
                }
                if same {
                    seen += 1;
                    if i == ls {
                        nth = seen;
                    }
                }
                i += 1;
            }
            if seen > 1 && nth > 0 {
                buf_str(args, c" --nth ");
                buf_int(args, nth);
            }
        }
        let out = buf_new();
        buf_tool_command(out, buf_slice(args), false, pcx);
        own_try(buf_slice(out), pcx);
    }
}

// The name of place p, quoted: 'v', 'p.a', 't.0'.
fn place_name(p: i64, ocx: OwnCx, pcx: Ctx<Comp>) {
    let b = buf_new();
    buf_byte(b, '\'');
    place_text(b, p, ocx, pcx);
    buf_byte(b, '\'');
    crate::front::own::diag::own_bytes(buf_slice(b), pcx);
}

fn place_text(b: i64, p: i64, ocx: OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if ocx.pl_parent[p] >= 0 {
            place_text(b, ocx.pl_parent[p], ocx, pcx);
            let f = ocx.pl_field[p];
            if f == DEREF_FIELD {
                return;
            }
            buf_byte(b, '.');
            if f >= TUPLE_FIELD {
                buf_int(b, field_number(f));
            } else {
                buf_bytes(b, sym_text(f, pcx));
            }
            return;
        }
        if ocx.pl_rkind[p] == RK_STATIC {
            buf_bytes(b, sym_text(pcx.nodes[pcx.statics[ocx.pl_rid[p]].node].a, pcx));
        } else {
            buf_bytes(b, sym_text(pcx.locals[ocx.pl_rid[p]].name, pcx));
        }
    }
}
