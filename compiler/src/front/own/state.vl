// The own walk's state (0.17, docs/design/value-semantics.md §4 steps 3-4),
// from the prototype (c17-proto, §8.1) with its apparatus taken out: one
// origin of two levels per value, slots made on the fly.
//
// Places. A place is a root (a local, a static, or a parameter's root:
// `p`, what the argument points into, and `*p`, what the views it holds
// point into) and a path of fields; indexes collapse to their base. They
// are interned per function, at most MAXPL (64, or 512 when a function has
// more: the walk is redone with NW = 8 words per bitset).
//
// Origins (§2.4). An origin value is 2 * NW words: level 1, the places the
// value's own views point into; level 2, the places the views at level 1
// point to hold. ov_* below combine them.
//
// The state (a pool offset): [reachable] [moved: NW] [definitely moved:
// NW], then SW words per slot (a view-holding local): its origin (2 * NW),
// its flags (F_*) and the node that set them. States join at if and match
// and at loop heads: moved bits and origins OR, definitely-moved bits AND.
//
// Pending arguments (§4 step 4, calls): PE words per argument of the call
// being walked: its kind (PK_*), its place (a loan: `&place`, a reference
// passed on) or -1, its origin value or -1, whether a later argument
// invalidated it and by which node, the argument's node, and the
// parameter's mode (kinds::param_mode).
//
// Phase 0 contract: the layout and these functions are fixed; T1 owns the
// moved bits, T2 the origins, flags and pending entries. A new per-slot or
// per-state word is a change to this file, made by the lead.

use crate::base::{alloc_array, die, realloc};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::own::ctx::OwnCx;

// ---------------------------------------------------------------------------
// Places

pub const MAXNW: i64 = 8;

pub const RK_LOCAL: i64 = 0;
pub const RK_STATIC: i64 = 1;
// A parameter's root: PL_FIELD 0 is `p`, 1 is `*p`.
pub const RK_ROOT: i64 = 2;

// The mark of an origin (T2, design §6 V3): one place per function that
// nothing overlaps or writes; an origin holding it came in part from an
// assumed (top) summary, so its conflicts are warnings until summaries are
// inferred.
pub const RK_MARK: i64 = 3;

// The tables, once (check_own).
pub fn init_state(ocx: &mut OwnCx, pcx: &Ctx<Comp>) {
    if ocx.pl_rkind != 0 as *mut i64 {
        return;
    }
    ocx.pl_rkind = alloc_array::<i64>(MAXNW * 64);
    ocx.pl_rid = alloc_array::<i64>(MAXNW * 64);
    ocx.pl_parent = alloc_array::<i64>(MAXNW * 64);
    ocx.pl_field = alloc_array::<i64>(MAXNW * 64);
    ocx.pl_moved_by = alloc_array::<i64>(MAXNW * 64);
    ocx.pl_mask = alloc_array::<i64>(MAXNW * 64 * MAXNW);
    ocx.static_mask = alloc_array::<i64>(MAXNW);
    ocx.static_pl = alloc_array::<i64>(pcx.statics.len() as i64 + 1);
    ensure_locals(ocx, pcx);
}

fn ensure_locals(ocx: &mut OwnCx, pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.locals.len() as i64 + 1 <= ocx.loc_cap {
            return;
        }
        let n = pcx.locals.len() as i64 * 2 + 64;
        let a = alloc_array::<i64>(n);
        let b = alloc_array::<i64>(n);
        let c = alloc_array::<i64>(n);
        let d = alloc_array::<i64>(n);
        for i in 0..ocx.loc_cap {
            (*a.add(i as usize)) = (*ocx.loc_pl.add(i as usize));
            (*b.add(i as usize)) = (*ocx.loc_root.add(i as usize));
            (*c.add(i as usize)) = (*ocx.loc_root2.add(i as usize));
            (*d.add(i as usize)) = (*ocx.loc_slot.add(i as usize));
        }
        ocx.loc_pl = a;
        ocx.loc_root = b;
        ocx.loc_root2 = c;
        ocx.loc_slot = d;
        ocx.loc_cap = n;
    }
}

fn touch(l: i64, ocx: &mut OwnCx) {
    unsafe {
        if (*ocx.loc_pl.add(l as usize)) == 0 && (*ocx.loc_root.add(l as usize)) == 0
            && (*ocx.loc_root2.add(l as usize)) == 0
            && (*ocx.loc_slot.add(l as usize)) == 0 {
            ocx.touched.push(l);
        }
    }
}

// The roots of the places a cast's argument views (level-1 words w).
pub fn mark_cast_roots(w: *mut i64, ocx: &mut OwnCx) {
    for q in 0..ocx.pl_count {
        if get_bit(w, q) && !is_cast_root(root_of(q, ocx), ocx) {
            ocx.cast_roots.push(root_of(q, ocx));
        }
    }
}

// Whether root place r is one a cast views (CAST_ROOTS).
pub fn is_cast_root(r: i64, ocx: &OwnCx) -> bool {
    for i in 0..ocx.cast_roots.count {
        if ocx.cast_roots.get(i) == r {
            return true;
        }
    }
    false
}

// Forgets the places and slots of the function walked.
pub fn reset_places(ocx: &mut OwnCx) {
    unsafe {
        for i in 0..ocx.touched.count {
            let l = (*ocx.touched.data.add(i as usize));
            (*ocx.loc_pl.add(l as usize)) = 0;
            (*ocx.loc_root.add(l as usize)) = 0;
            (*ocx.loc_root2.add(l as usize)) = 0;
            (*ocx.loc_slot.add(l as usize)) = 0;
        }
        ocx.touched.count = 0;
        for i in 0..ocx.static_touched.count {
            (*ocx.static_pl.add((*ocx.static_touched.data.add(i as usize)) as usize)) = 0;
        }
        ocx.static_touched.count = 0;
        for w in 0..ocx.pl_count * ocx.nw {
            (*ocx.pl_mask.add(w as usize)) = 0;
        }
        for w in 0..ocx.nw {
            (*ocx.static_mask.add(w as usize)) = 0;
        }
        ocx.pl_count = 0;
        ocx.cast_roots.count = 0;
        ocx.mark_pl = -1;
        ocx.nslot = 0;
        ocx.slot_local.count = 0;
        ocx.slot_parent.count = 0;
    }
}

fn new_place(rkind: i64, rid: i64, parent: i64, field: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if ocx.pl_count >= ocx.maxpl {
            ocx.pl_overflow = true;
            return -1;
        }
        let p = ocx.pl_count;
        ocx.pl_count += 1;
        (*ocx.pl_rkind.add(p as usize)) = rkind;
        (*ocx.pl_rid.add(p as usize)) = rid;
        (*ocx.pl_parent.add(p as usize)) = parent;
        (*ocx.pl_field.add(p as usize)) = field;
        (*ocx.pl_moved_by.add(p as usize)) = 0;
        set_bit(ocx.pl_mask.add((p * ocx.nw) as usize), p);
        let mut a = parent;
        while a >= 0 {
            set_bit(ocx.pl_mask.add((p * ocx.nw) as usize), a);
            set_bit(ocx.pl_mask.add((a * ocx.nw) as usize), p);
            a = (*ocx.pl_parent.add(a as usize));
        }
        // (a `const` or a `static` without `mut` is never written: a call
        // with `global` effects leaves its views alone)
        if rkind == RK_STATIC && pcx.statics[rid as usize].mutable {
            set_bit(ocx.static_mask, p);
        }
        p
    }
}

// The place of local l (made on first use), -1 past MAXPL.
pub fn local_place(l: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if l < 0 {
            return -1;
        }
        ensure_locals(ocx, pcx);
        if (*ocx.loc_pl.add(l as usize)) != 0 {
            return (*ocx.loc_pl.add(l as usize)) - 1;
        }
        let p = new_place(RK_LOCAL, l, -1, 0, ocx, pcx);
        if p < 0 {
            return -1;
        }
        touch(l, ocx);
        (*ocx.loc_pl.add(l as usize)) = p + 1;
        p
    }
}

// Parameter l's root: `p` (inner false), what its argument points into;
// `*p` (inner true), what the views the argument holds point into.
pub fn root_place(l: i64, inner: bool, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        ensure_locals(ocx, pcx);
        let known = if inner { (*ocx.loc_root2.add(l as usize)) }
            else { (*ocx.loc_root.add(l as usize)) };
        if known != 0 {
            return known - 1;
        }
        let p = new_place(RK_ROOT, l, -1, if inner { 1 } else { 0 }, ocx, pcx);
        if p < 0 {
            return -1;
        }
        touch(l, ocx);
        if inner {
            (*ocx.loc_root2.add(l as usize)) = p + 1;
        } else {
            (*ocx.loc_root.add(l as usize)) = p + 1;
        }
        p
    }
}

pub fn static_place(s: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if s < 0 {
            return -1;
        }
        if (*ocx.static_pl.add(s as usize)) != 0 {
            return (*ocx.static_pl.add(s as usize)) - 1;
        }
        let p = new_place(RK_STATIC, s, -1, 0, ocx, pcx);
        if p < 0 {
            return -1;
        }
        ocx.static_touched.push(s);
        (*ocx.static_pl.add(s as usize)) = p + 1;
        p
    }
}

// Whether static s has a place in this function (something borrowed it).
pub fn static_has_place(s: i64, ocx: &OwnCx) -> bool {
    unsafe { s >= 0 && (*ocx.static_pl.add(s as usize)) != 0 }
}

// The mark place of this function (RK_MARK), made on first use; -1 past
// MAXPL.
pub fn mark_place(ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    if ocx.mark_pl < 0 {
        ocx.mark_pl = new_place(RK_MARK, -1, -1, 0, ocx, pcx);
    }
    ocx.mark_pl
}

// (0.25) A temporary's place (RK_TEMP, PL_RID its node): what `&temp`
// lends, a method's receiver made by a call (`mk().view()`); it dies at
// the end of its statement (walk::eval_block), and at the return.
pub const RK_TEMP: i64 = 4;

pub fn temp_place(node: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        for q in 0..ocx.pl_count {
            if (*ocx.pl_rkind.add(q as usize)) == RK_TEMP && (*ocx.pl_rid.add(q as usize)) == node {
                return q;
            }
        }
        new_place(RK_TEMP, node, -1, 0, ocx, pcx)
    }
}

// The place of field `field` of place parent (a tuple's element i:
// TUPLE_FIELD + i).
pub const TUPLE_FIELD: i64 = 1 << 40;

// (0.18.1) The place of field i of variant v (a pattern's reference into
// an enum, walk::bind_at): TUPLE_FIELD + (v + 1) * VARIANT_STEP + i; its
// name is `.i`, as a tuple's (field_number).
pub const VARIANT_STEP: i64 = 1 << 20;

pub fn variant_field_key(v: i64, i: i64) -> i64 {
    TUPLE_FIELD + (v + 1) * VARIANT_STEP + i
}

// The number a tuple's or a variant's field place is named by.
pub fn field_number(f: i64) -> i64 {
    (f - TUPLE_FIELD) % VARIANT_STEP
}

// (0.18.1) The place of what reference local r points to, as passed on
// to a call (`s.as_slice()` for `s: &Vec<u8>`): its child DEREF_FIELD.
// A view through it is not a view of r's own storage: it does not die
// with r (the view also holds what r views), so a result that views it
// does not escape (views::escaping, on_scope_end). Its name is r's.
pub const DEREF_FIELD: i64 = TUPLE_FIELD - 1;

pub fn is_deref_place(q: i64, ocx: &OwnCx) -> bool {
    unsafe {
        (*ocx.pl_parent.add(q as usize)) >= 0 && (*ocx.pl_field.add(q as usize)) == DEREF_FIELD
    }
}

pub fn child_place(parent: i64, field: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if parent < 0 {
            return -1;
        }
        for q in parent + 1..ocx.pl_count {
            if (*ocx.pl_parent.add(q as usize)) == parent
                && (*ocx.pl_field.add(q as usize)) == field {
                return q;
            }
        }
        new_place((*ocx.pl_rkind.add(parent as usize)), (*ocx.pl_rid.add(parent as usize)), parent,
            field, ocx, pcx)
    }
}

pub fn root_of(p: i64, ocx: &OwnCx) -> i64 {
    unsafe {
        let mut r = p;
        while (*ocx.pl_parent.add(r as usize)) >= 0 {
            r = (*ocx.pl_parent.add(r as usize));
        }
        r
    }
}

// Whether place q is a part of place p.
pub fn is_below(q: i64, p: i64, ocx: &OwnCx) -> bool {
    unsafe {
        let mut a = (*ocx.pl_parent.add(q as usize));
        while a >= 0 {
            if a == p {
                return true;
            }
            a = (*ocx.pl_parent.add(a as usize));
        }
        false
    }
}

// The local (or static) name of place p's root, for messages; 0: none.
pub fn place_local(p: i64, ocx: &OwnCx) -> i64 {
    unsafe {
        if p < 0 {
            return -1;
        }
        let r = root_of(p, ocx);
        if (*ocx.pl_rkind.add(r as usize)) == RK_STATIC { -1 }
        else { (*ocx.pl_rid.add(r as usize)) }
    }
}

// ---------------------------------------------------------------------------
// Slots: the view-holding locals, made when first bound

// Local l's slot, made when l holds views (its type is a view); -1 when it
// does not, or past SLOT_CAP.
pub fn slot_for(l: i64, is_view: bool, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if l < 0 {
            return -1;
        }
        ensure_locals(ocx, pcx);
        if (*ocx.loc_slot.add(l as usize)) != 0 {
            return (*ocx.loc_slot.add(l as usize)) - 1;
        }
        if !is_view {
            return -1;
        }
        if ocx.nslot >= ocx.slot_cap {
            ocx.slot_overflow = true;
            return -1;
        }
        touch(l, ocx);
        (*ocx.loc_slot.add(l as usize)) = ocx.nslot + 1;
        ocx.slot_local.push(l);
        ocx.slot_parent.push(-1);
        ocx.nslot += 1;
        ocx.nslot - 1
    }
}

pub fn slot_of_local(l: i64, ocx: &OwnCx) -> i64 {
    unsafe {
        if l < 0 || l >= ocx.loc_cap {
            return -1;
        }
        (*ocx.loc_slot.add(l as usize)) - 1
    }
}

// The slot of place p's root local, or -1.
pub fn slot_of_place(p: i64, ocx: &OwnCx) -> i64 {
    unsafe {
        if p < 0 || (*ocx.pl_rkind.add(p as usize)) != RK_LOCAL {
            return -1;
        }
        slot_of_local((*ocx.pl_rid.add(p as usize)), ocx)
    }
}

// ---------------------------------------------------------------------------
// Bitsets of NW words

pub fn set_bit(b: *mut i64, i: i64) {
    unsafe { (*b.add((i >> 6) as usize)) = (*b.add((i >> 6) as usize)) | (1 << (i & 63)); }
}

pub fn clear_bit(b: *mut i64, i: i64) {
    unsafe { (*b.add((i >> 6) as usize)) = (*b.add((i >> 6) as usize)) & ~(1 << (i & 63)); }
}

pub fn get_bit(b: *mut i64, i: i64) -> bool {
    unsafe { ((*b.add((i >> 6) as usize)) & (1 << (i & 63))) != 0 }
}

pub fn any_and(a: *mut i64, b: *mut i64, ocx: &OwnCx) -> bool {
    unsafe {
        if ocx.nw == 1 {
            return ((*a.add(0)) & (*b.add(0))) != 0;
        }
        for w in 0..ocx.nw {
            if ((*a.add(w as usize)) & (*b.add(w as usize))) != 0 {
                return true;
            }
        }
        false
    }
}

pub fn is_empty(a: *mut i64, ocx: &OwnCx) -> bool {
    unsafe {
        for w in 0..ocx.nw {
            if (*a.add(w as usize)) != 0 {
                return false;
            }
        }
        true
    }
}

pub fn or_into(d: *mut i64, s: *mut i64, ocx: &OwnCx) {
    unsafe {
        if ocx.nw == 1 {
            (*d.add(0)) = (*d.add(0)) | (*s.add(0));
            return;
        }
        for w in 0..ocx.nw {
            (*d.add(w as usize)) = (*d.add(w as usize)) | (*s.add(w as usize));
        }
    }
}

// d |= the places overlapping some place of s.
pub fn or_expanded(d: *mut i64, s: *mut i64, ocx: &mut OwnCx) {
    unsafe {
        for w in 0..ocx.nw {
            let mut bits = (*s.add(w as usize));
            let mut i = w * 64;
            while bits != 0 {
                if (bits & 1) != 0 && i < ocx.pl_count {
                    or_into(d, ocx.pl_mask.add((i * ocx.nw) as usize), ocx);
                }
                bits = (bits >> 1) & 0x7fffffffffffffff;
                i += 1;
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The pool: states, origin values and masks, allocated as a stack (a
// caller resets POOL_TOP to what it was)

// n zeroed words; their offset.
pub fn alloc(n: i64, ocx: &mut OwnCx) -> i64 {
    unsafe {
        if ocx.pool_top + n > ocx.pool_cap {
            let cap = (ocx.pool_cap + n) * 2 + 4096;
            ocx.pool = realloc(ocx.pool as *mut u8, (cap * 8) as u64) as *mut i64;
            if ocx.pool == 0 as *mut i64 {
                die(c"out of memory");
            }
            ocx.pool_cap = cap;
        }
        let off = ocx.pool_top;
        ocx.pool_top += n;
        for i in off..ocx.pool_top {
            (*ocx.pool.add(i as usize)) = 0;
        }
        off
    }
}

// The words at pool offset off (valid until the pool grows: use at once).
pub fn at(off: i64, ocx: &mut OwnCx) -> *mut i64 {
    unsafe { ocx.pool.add(off as usize) }
}

// ---------------------------------------------------------------------------
// The state

pub const S_MOVED: i64 = 1;

// Slot flags: invalidated (something wrote, moved, dropped or mutably
// borrowed a place it views), by a call writing statics, by its owner's
// scope ending.
pub const F_INVALID: i64 = 1;
pub const F_STATIC: i64 = 2;
pub const F_SCOPE: i64 = 4;

pub fn set_words(nw: i64, ocx: &mut OwnCx) {
    ocx.nw = nw;
    ocx.maxpl = nw * 64;
    ocx.s_dmoved = 1 + nw;
    ocx.s_slots = 1 + 2 * nw;
    ocx.ov = 2 * nw;
    ocx.sw = 2 * nw + 2;
}

pub fn state_size(ocx: &OwnCx) -> i64 {
    ocx.s_slots + ocx.slot_cap * ocx.sw
}

// The offset of slot s's words in state st (its origin value first).
pub fn slot_off(st: i64, s: i64, ocx: &OwnCx) -> i64 {
    st + ocx.s_slots + s * ocx.sw
}

// The offset of slot s's flags in the current state (the reason next).
pub fn slot_flags(s: i64, ocx: &OwnCx) -> i64 {
    slot_off(ocx.cur, s, ocx) + ocx.ov
}

pub fn new_state(ocx: &mut OwnCx) -> i64 {
    alloc(state_size(ocx), ocx)
}

pub fn copy_state(dst: i64, src: i64, ocx: &mut OwnCx) {
    unsafe {
        // (the slots made so far: a state's later slots are still empty)
        for i in 0..ocx.s_slots + ocx.nslot * ocx.sw {
            (*ocx.pool.add((dst + i) as usize)) = (*ocx.pool.add((src + i) as usize));
        }
    }
}

pub fn reachable(st: i64, ocx: &OwnCx) -> bool {
    unsafe { (*ocx.pool.add(st as usize)) != 0 }
}

pub fn set_unreachable(st: i64, ocx: &mut OwnCx) {
    unsafe { (*ocx.pool.add(st as usize)) = 0; }
}

// dst := dst ⊔ src.
pub fn join_state(dst: i64, src: i64, ocx: &mut OwnCx) {
    unsafe {
        if (*ocx.pool.add(src as usize)) == 0 {
            return;
        }
        if (*ocx.pool.add(dst as usize)) == 0 {
            copy_state(dst, src, ocx);
            return;
        }
        for w in 0..ocx.nw {
            (*ocx.pool.add((dst + S_MOVED + w) as usize)) = (
                *ocx.pool.add((dst + S_MOVED + w) as usize))
                | (*ocx.pool.add((src + S_MOVED + w) as usize));
            (*ocx.pool.add((dst + ocx.s_dmoved + w) as usize)) = (
                *ocx.pool.add((dst + ocx.s_dmoved + w) as usize))
                & (*ocx.pool.add((src + ocx.s_dmoved + w) as usize));
        }
        for s in 0..ocx.nslot {
            let d = slot_off(dst, s, ocx);
            let r = slot_off(src, s, ocx);
            for w in 0..ocx.ov + 1 {
                (*ocx.pool.add((d + w) as usize)) = (*ocx.pool.add((d + w) as usize))
                    | (*ocx.pool.add((r + w) as usize));
            }
            if (*ocx.pool.add((d + ocx.ov + 1) as usize)) == 0 {
                (*ocx.pool.add((d + ocx.ov + 1) as usize)) = (
                    *ocx.pool.add((r + ocx.ov + 1) as usize));
            }
        }
    }
}

// Whether states a and b are the same (the reasons aside): a loop's head
// is stable.
pub fn same_state(a: i64, b: i64, ocx: &OwnCx) -> bool {
    unsafe {
        for i in 0..ocx.s_slots + ocx.nslot * ocx.sw {
            if (*ocx.pool.add((a + i) as usize)) != (*ocx.pool.add((b + i) as usize)) {
                let rel = i - ocx.s_slots;
                if rel >= 0 && rel % ocx.sw == ocx.ov + 1 {
                    continue;
                }
                return false;
            }
        }
        true
    }
}

// The moved bits of the current state.
pub fn moved_bits(ocx: &mut OwnCx) -> *mut i64 {
    at(ocx.cur + S_MOVED, ocx)
}

pub fn dmoved_bits(ocx: &mut OwnCx) -> *mut i64 {
    at(ocx.cur + ocx.s_dmoved, ocx)
}

// ---------------------------------------------------------------------------
// Origin values

pub fn new_ov(ocx: &mut OwnCx) -> i64 {
    alloc(ocx.ov, ocx)
}

// Level 1 (what the value's views point into) and level 2 (what the views
// those point to hold) of origin value o.
pub fn l1(o: i64, ocx: &mut OwnCx) -> *mut i64 {
    at(o, ocx)
}

pub fn l2(o: i64, ocx: &mut OwnCx) -> *mut i64 {
    at(o + ocx.nw, ocx)
}

pub fn ov_or(dst: i64, src: i64, ocx: &mut OwnCx) {
    unsafe {
        if dst < 0 || src < 0 {
            return;
        }
        for w in 0..ocx.ov {
            (*ocx.pool.add((dst + w) as usize)) = (*ocx.pool.add((dst + w) as usize))
                | (*ocx.pool.add((src + w) as usize));
        }
    }
}

pub fn ov_copy(dst: i64, src: i64, ocx: &mut OwnCx) {
    unsafe {
        for w in 0..ocx.ov {
            (*ocx.pool.add((dst + w) as usize)) = (*ocx.pool.add((src + w) as usize));
        }
    }
}

pub fn ov_clear(dst: i64, ocx: &mut OwnCx) {
    unsafe {
        for w in 0..ocx.ov {
            (*ocx.pool.add((dst + w) as usize)) = 0;
        }
    }
}

// dst's level 1 gets src's level 2: an element read out of what src views.
pub fn ov_inner(dst: i64, src: i64, ocx: &mut OwnCx) {
    if dst < 0 || src < 0 {
        return;
    }
    or_into(l1(dst, ocx), l2(src, ocx), ocx);
    or_into(l2(dst, ocx), l2(src, ocx), ocx);
}

// Whether origin o views a place of mask (at either level).
pub fn ov_hits(o: i64, mask: *mut i64, ocx: &mut OwnCx) -> bool {
    any_and(l1(o, ocx), mask, ocx) || any_and(l2(o, ocx), mask, ocx)
}

// ---------------------------------------------------------------------------
// Pending arguments

pub const PE: i64 = 7;
pub const PE_KIND: i64 = 0;
pub const PE_PLACE: i64 = 1;
pub const PE_OV: i64 = 2;
pub const PE_INVALID: i64 = 3;
pub const PE_BY: i64 = 4;
pub const PE_NODE: i64 = 5;
pub const PE_MODE: i64 = 6;

// No loan and no view; a shared loan; a `&mut self` receiver (two-phase:
// reserved during the arguments, active at the call); an exclusive loan;
// a view (a slice, a view struct); an exclusive view (`&mut [T]`); raw (a
// raw pointer, or what C is given: its origin counts for the result, not
// for conflicts).
pub const PK_NONE: i64 = 0;
pub const PK_SHARED: i64 = 1;
pub const PK_RESERVE: i64 = 2;
pub const PK_MUT: i64 = 3;
pub const PK_VIEW: i64 = 4;
pub const PK_MUT_VIEW: i64 = 5;
pub const PK_RAW: i64 = 6;

pub fn pend_push(kind: i64, place: i64, ov: i64, node: i64, mode: i64, ocx: &mut OwnCx) {
    unsafe {
        if ocx.pend.count + PE > ocx.pend.cap {
            // (growing: the slow way)
            ocx.pend.push(kind);
            ocx.pend.push(place);
            ocx.pend.push(ov);
            ocx.pend.push(0);
            ocx.pend.push(0);
            ocx.pend.push(node);
            ocx.pend.push(mode);
            return;
        }
        let d = ocx.pend.data;
        let c = ocx.pend.count;
        (*d.add(c as usize)) = kind;
        (*d.add((c + 1) as usize)) = place;
        (*d.add((c + 2) as usize)) = ov;
        (*d.add((c + 3) as usize)) = 0;
        (*d.add((c + 4) as usize)) = 0;
        (*d.add((c + 5) as usize)) = node;
        (*d.add((c + 6) as usize)) = mode;
        ocx.pend.count = c + PE;
    }
}

// The name of local l, for messages.
pub fn local_name(l: i64, pcx: &Ctx<Comp>) -> i64 {
    if l < 0 { 0 } else { pcx.locals[l as usize].name }
}

// Local l (a `for` loop's sequence, `__for_seq`) is place p: the loop
// reads v through it, it does not move v.
pub fn alias_local(l: i64, p: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) {
    unsafe {
        if l < 0 || p < 0 {
            return;
        }
        ensure_locals(ocx, pcx);
        touch(l, ocx);
        (*ocx.loc_pl.add(l as usize)) = p + 1;
    }
}
