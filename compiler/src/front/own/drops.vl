// The own pass's part in drops (0.17; 0.26.2, docs/design/places-ir.md §5
// step 7: the drop half deleted). The places IR places and decides every
// drop (places/build.vl, places/elab.vl); what is left here, during type
// checking (check/body.vl, check/iterate.vl, patterns/mod.vl call these),
// is what the own walk's checks and the IR read:
//
// - the bindings that borrow what they bind (byref.vl BYREF, MATCH_BYREF):
//   a match reached through a reference (`match self.kind`, `match *p`,
//   `match v[i]`), a `for` loop's element of a slice or Vec, (0.25) the
//   items of a borrowing iterator (copies of a container's elements,
//   borrowed_call), a requires check's owned parameters. Moving one is
//   own.move_out; the IR makes them BORROWED locals;
// - an owned value a statement discards (`make(3);`, `let _ = make();`)
//   bound to a hidden local, `{ let __own_tmp = e; }`, which the IR drops at
//   once;
// - the statement temporaries as hidden `let`s (visit_temps, below), which
//   the view checks read (own.escape names one);
// - `needs_drop::<T>()` folded, and own.drop_view (an `impl Drop` of a type
//   that holds views), reported by report_drop_views.
//
// Only --values=error does this (drops_on); the other modes keep 0.16's
// semantics: nothing drops.

use crate::base::{IntVec, SYMS, intern_c};
use crate::front::ast::{
    BLOCK_DROPS_DONE, NODES, NODE_CHECKED, NODE_IN_BOUNDS, NODE_RAW, NodeKind, SCRATCH, child,
    list_begin, list_end, list_push, new_node,
};
use crate::front::check::{LOCALS, Res, define_local};
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::temps::NODE_TEMP;
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::own::byref::{BYREF, MATCH_BYREF, binds, borrowed_call, fresh, push_bindings};
use crate::front::own::diag::{
    MODE_ERROR, OWN_DROP_VIEW, OWN_MODE, own_end, own_help, own_str, own_type,
};
use crate::front::own::glue::has_glue;
use crate::front::own::kinds::{has_drop_impl, is_owned_type, is_view_type};
use crate::front::own::state::{PL_RID, PL_RKIND, RK_LOCAL, root_of};
use crate::front::types::{FNS, REF_SHARED, STRUCTS, TLISTS, TYPES, TY_UNIT, TyKind, struct_field};
use crate::middle::lower::ssa::HMap;

// Node flags (0.17, T1): on an Arm whose bindings were looked at
// (arm_drops); on a body whose parameters were (param_drops). (NO_DROP is
// byref.vl's; named here too for the checker.)
pub use crate::front::own::byref::NO_DROP;
pub const ARM_DROPS_DONE: i64 = 1 << 60;
pub const PARAM_DROPS_DONE: i64 = 1 << 61;

// `impl Drop` of view types (own.drop_view): the method's node, the type.
static var DROP_VIEWS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

static var SYM_TMP: i64 = 0;
static var SYM_NEEDS_DROP: i64 = 0;
static var SYM_DROP: i64 = 0;

fn syms() {
    if SYM_TMP == 0 {
        SYM_TMP = intern_c(c"__own_tmp");
        SYM_NEEDS_DROP = intern_c(c"needs_drop");
        SYM_DROP = intern_c(c"drop");
    }
}

// Whether drops are placed: only where moves are enforced, --values=error
// (0.17, integration of T1 and T4). Under report and warn a use after a
// move, or a handle copied and freed twice (0.16's idioms, migrated by
// `fix --values`), still compiles, and dropping the copies would free
// memory twice; there nothing drops, as in 0.16 (`free` frees).
pub fn drops_on() -> bool {
    OWN_MODE == MODE_ERROR
}

// ---------------------------------------------------------------------------
// Rows and entries

// ---------------------------------------------------------------------------
// Placing the drops (check/body.vl)

// Whether function f is std's function `name` (or an instance of it).
fn is_std_fn(f: i64, name: i64) -> bool {
    unsafe {
        let t = if FNS[f].tmpl != 0 { FNS[f].tmpl - 1 } else { f };
        within_std(FNS[t].module) && FNS[t].node != 0 && NODES[FNS[t].node].a == name
    }
}

// (0.17) Whether type t, which has `impl Drop`, holds views: own.drop_view.
// (0.25) A view reached through a type argument counts too (`impl<T> Drop
// for G<T>` with T = `[i64]`: its drop may read the view after what it
// views is gone, which nothing orders), except in std's types, whose
// generic drops only drop their elements and read none (`impl<T> Drop for
// Vec<T>` of a `Vec<[u8]>`, as Rust's `may_dangle`). Fields of a std
// template are looked at, so a std `struct P<T> { s: [u8], x: T }` with
// `impl<T> Drop` is still reported.
fn drop_reads_views(t: i64) -> bool {
    unsafe {
        if !is_view_type(t) {
            return false;
        }
        if TYPES[t].kind != TyKind::Struct {
            return true;
        }
        let s = TYPES[t].a;
        if STRUCTS[s].tmpl == 0 {
            return true;
        }
        let tm = STRUCTS[s].tmpl - 1;
        if !within_std(STRUCTS[tm].module) {
            return true;
        }
        for i in 0..STRUCTS[tm].field_count {
            let ft = (*struct_field(tm, i)).ty;
            if ft > 0 && is_view_type(ft) {
                return true;
            }
        }
        false
    }
}

// (0.17; 0.26.2: on its own, the drops it was found with gone)
// own.drop_view: each `impl Drop` of a type that holds views (param_drops
// noted them), after the walks.
pub fn report_drop_views() {
    var i = 0;
    while i < DROP_VIEWS.count {
        let item = DROP_VIEWS.get(i);
        let dt = DROP_VIEWS.get(i + 1);
        crate::front::own::diag::own_begin(item, OWN_DROP_VIEW);
        own_str(c"'");
        own_type(dt);
        // UNSAFE: STRUCTS is the checker's raw table of structs.
        // SAFETY: dt is a struct type (the left side of the `&&`), so
        // TYPES[dt].a is a struct below the table's count; the checker runs
        // on one thread.
        let instance = TYPES[dt].kind == TyKind::Struct
            && unsafe { STRUCTS[TYPES[dt].a].tmpl != 0 };
        if instance {
            // (0.25: an instance whose type argument is a view)
            own_str(c"' holds views (a type argument is one) and cannot implement Drop: its drop could read what it views after that is gone");
            own_help(c"give it an owned type argument instead of the view (`.to_vec_in(gpa)`, `.to_string_in(gpa)`, a Buf), or remove the impl");
        } else {
            own_str(c"' holds views and cannot implement Drop: its drop could read what it views after that is gone");
            own_help(c"hold owned values (Buf, Vec) instead of the views, or remove the impl");
        }
        own_end();
        i += 2;
    }
}

// check_function, its parameters defined: `needs_drop::<T>()` folded;
// `impl Drop` of a view type noted (own.drop_view); a requires check's
// owned parameters borrow the caller's arguments.
pub fn param_drops(item: i64, f: i64) {
    unsafe {
        syms();
        let body = NODES[item].c;
        if FNS[f].tmpl != 0 && is_std_fn(f, SYM_NEEDS_DROP) && body != 0 && NODES[body].a != 0 {
            let t = TLISTS.data[FNS[f].targs];
            NODES[NODES[body].a].a = if has_glue(t) { 1 } else { 0 };
        }
        if FNS[f].self_ty > 0 && NODES[item].a == SYM_DROP && has_drop_impl(FNS[f].self_ty)
            && drop_reads_views(FNS[f].self_ty) {
            DROP_VIEWS.push(item);
            DROP_VIEWS.push(FNS[f].self_ty);
        }
        if !drops_on() || body == 0 || (NODES[body].p & PARAM_DROPS_DONE) != 0 {
            return;
        }
        NODES[body].p |= PARAM_DROPS_DONE;
        if crate::front::contracts::expand::is_pre_fn(f) {
            // (0.18: a requires check reads the caller's arguments in place:
            // its owned parameters borrow them, are never dropped, and
            // moving one is own.move_out)
            for i in 0..NODES[item].count {
                let p = child(item, i);
                let l = NODES[p].x;
                if l >= 0 && is_owned_type(LOCALS[l].ty) {
                    BYREF.put(l + 1, p + 1);
                }
            }
        }
    }
}

// check_block, before its statements: whether after_stmt and after_tail
// do their work there (not when done already, or with drops off).
pub fn block_begin(block: i64) -> bool {
    if !drops_on() || (NODES[block].p & BLOCK_DROPS_DONE) != 0 {
        return false;
    }
    NODES[block].p |= BLOCK_DROPS_DONE;
    true
}

// check_block, after statement stmt, checked (on: block_begin's): a value
// it discards bound to a hidden local, a `let`'s bindings that borrow, its
// temporaries (visit_temps).
pub fn after_stmt(on: bool, stmt: i64) {
    if !on {
        return;
    }
    let k = NODES[stmt].kind;
    if k == NodeKind::Let {
        let init = NODES[stmt].c;
        if NODES[stmt].a != 0 && NODES[NODES[stmt].a].kind == NodeKind::PatWild
            && is_temp(init) {
            // (0.25: `let _ = make();` drops the value at once, as `make();`)
            NODES[stmt].c = temporary(init);
            return;
        }
        if NODES[stmt].a != 0 && NODES[NODES[stmt].a].kind == NodeKind::PatWild && init != 0
            && is_owned_type(NODES[init].ty) && is_place(init) {
            // (`let _ = x;` of an owned place moves nothing, as Rust's:
            // it reads x)
            let r = t_node(NodeKind::Unary, init, crate::front::types::ref_to(NODES[init].ty,
                REF_SHARED));
            NODES[r].op = Tok::Amp;
            NODES[r].b = init;
            NODES[stmt].c = r;
            return;
        }
        let_drops(stmt);
        // (0.20: its temporaries, to the end of the statement; to the
        // end of the block when the binding may view them)
        if init != 0 && is_view_type(NODES[init].ty) {
            visit_temps(init);
        } else {
            NODES[stmt].c = unit_value(init);
        }
    } else if k == NodeKind::ExprStmt {
        let e = NODES[stmt].a;
        if e == 0 {
            return;
        }
        if NODES[stmt].b != 0 && has_glue(NODES[e].ty) && !is_place(e) {
            NODES[stmt].a = temporary(e);
        } else {
            // (0.20: its temporaries, to the end of the statement)
            NODES[stmt].a = unit_value(e);
        }
    }
}

// check_block, after its tail (checked; on: block_begin's): its
// temporaries, to the end of the block (0.20).
pub fn after_tail(on: bool, block: i64) {
    let tail = NODES[block].a;
    if on && tail != 0 {
        visit_temps(tail);
    }
}

fn is_place(e: i64) -> bool {
    let k = NODES[e].kind;
    if k == NodeKind::Ident {
        return NODES[e].res == Res::Local || NODES[e].res == Res::Static;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return NODES[e].y == 1 || is_place(NODES[e].a);
    }
    if k == NodeKind::Unary {
        return NODES[e].op == Tok::Star;
    }
    k == NodeKind::Index
}

// Pattern p's owned bindings borrow what they bind (node at).
fn mark_byref(p: i64, at: i64) {
    unsafe {
        let mark = list_begin();
        push_bindings(p);
        for i in mark..SCRATCH.count {
            let b = SCRATCH.data[i];
            let l = NODES[b].x;
            if l >= 0 && is_owned_type(LOCALS[l].ty) {
                BYREF.put(l + 1, at + 1);
            }
        }
        SCRATCH.count = mark;
    }
}

// (0.25) `e?` (check/try_op.vl), its `let ?try = e;` bound (pattern bind):
// when e is a borrowed copy (`v.last()?`), ?try borrows it, so the match
// binds ?v by reference and nothing in the desugaring drops the element.
pub fn try_let_borrows(bind: i64, operand: i64) {
    if drops_on() && borrowed_call(operand) {
        mark_byref(bind, operand);
    }
}

// (0.24, with moves::iter_item_copy) The parameter (its index) of the
// closure being checked as the argument of `map`, `for_each`,
// `filter_map` or `fold` on a borrowing iterator's chain that gets its
// items, which are copies of the container's elements: borrowed (BYREF:
// not dropped, and moving it is own.move_out); -1: none.
pub static var ITEM_BORROW: i64 = -1;

// Closure parameter local l (node p) borrows the item it is given.
pub fn item_borrowed(l: i64, at: i64) {
    unsafe {
        if l >= 0 && is_owned_type(LOCALS[l].ty) {
            BYREF.put(l + 1, at + 1);
        }
    }
}

// `let pat = init;`, checked: its bindings that borrow what they bind
// (BYREF), when init is a copy of an element a collection keeps
// (`v.get(i)`), a binding that borrows, destructured, or a `for` loop's
// element.
fn let_drops(stmt: i64) {
    let pat = NODES[stmt].a;
    let init = NODES[stmt].c;
    if pat == 0 || init == 0 || (NODES[stmt].p & NO_DROP) != 0 {
        return;
    }
    if borrowed_call(init) {
        // (a copy of an element a collection keeps: `v.get(i)`)
        mark_byref(pat, init);
        return;
    }
    if NODES[pat].kind != NodeKind::PatBind && NODES[init].kind == NodeKind::Ident
        && reached_by_ref(init) {
        // (0.25: a binding that borrows, destructured, `|(i, d)|` of a
        // borrowing iterator's item: its parts borrow, as a match on it)
        NODES[init].p |= MATCH_BYREF;
        mark_byref(pat, init);
        return;
    }
    if NODES[init].kind == NodeKind::Index && (NODES[init].p & NODE_IN_BOUNDS) != 0 {
        // (a `for` loop's element: a copy of what the loop borrows)
        mark_byref(pat, init);
    }
}

// `e;` discarding an owned value e (checked): `{ let __own_tmp = e; }`,
// which drops it at once.
fn temporary(e: i64) -> i64 {
    syms();
    let start = NODES[e].start;
    let end = NODES[e].end;
    NODES[e].p |= NODE_CHECKED;
    let pat = new_node(NodeKind::PatBind, start, start);
    NODES[pat].a = SYM_TMP;
    let st = new_node(NodeKind::Let, start, end);
    NODES[st].a = pat;
    NODES[st].c = e;
    let b = new_node(NodeKind::Block, start, end);
    let mark = list_begin();
    list_push(st);
    list_end(b, mark);
    synth_expr(b);
    b
}

// Whether match scrutinee e is reached through a reference, an index or a
// static (or is a binding that borrows): its bindings borrow.
fn reached_by_ref(e: i64) -> bool {
    let k = NODES[e].kind;
    if k == NodeKind::Ident {
        if NODES[e].res == Res::Static {
            return true;
        }
        return NODES[e].res == Res::Local && NODES[e].y >= 0
            && BYREF.get(NODES[e].y + 1) != 0;
    }
    if k == NodeKind::FieldAccess {
        return NODES[e].y == 1 || reached_by_ref(NODES[e].a);
    }
    if k == NodeKind::TupleField {
        return reached_by_ref(NODES[e].a);
    }
    if k == NodeKind::Unary {
        return NODES[e].op == Tok::Star;
    }
    k == NodeKind::Index
}

// check_match, arm `arm` of match m, its pattern checked: a match reached
// through a reference (or a borrowed copy) binds by reference, its owned
// bindings borrowing (BYREF) and its scrutinee marked (MATCH_BYREF).
pub fn arm_drops(m: i64, arm: i64) {
    if !drops_on() || (NODES[arm].p & ARM_DROPS_DONE) != 0 {
        return;
    }
    NODES[arm].p |= ARM_DROPS_DONE;
    // (0.25: a `for` loop's `next()`, ARM_FOR_NEXT, as any match: a
    // borrowing iterator's items borrow)
    let scrutinee = NODES[m].a;
    if scrutinee != 0 && (reached_by_ref(scrutinee) || borrowed_call(scrutinee)) {
        NODES[scrutinee].p |= MATCH_BYREF;
        mark_byref(NODES[arm].a, scrutinee);
    }
}

// ---------------------------------------------------------------------------
// The walk's records (moves.vl)

// ---------------------------------------------------------------------------
// Finishing (check_own, after the walks)

// Typed nodes for the flags.
fn t_node(kind: NodeKind, at: i64, ty: i64) -> i64 {
    let n = new_node(kind, NODES[at].start, NODES[at].start);
    NODES[n].ty = ty;
    n
}

fn t_ident(l: i64, at: i64) -> i64 {
    unsafe {
        let n = t_node(NodeKind::Ident, at, LOCALS[l].ty);
        NODES[n].a = LOCALS[l].name;
        NODES[n].res = Res::Local;
        NODES[n].y = l;
        n
    }
}

// ---------------------------------------------------------------------------
// Statement temporaries (0.20)
//
// An owned value made by an expression and used without being moved (a
// receiver, `f()?.read()`, `make().len()`; a field read out of it,
// `make().id`; an argument a `let` parameter borrows) lives until its
// statement ends and is dropped then, after every use: Rust's rule. Its
// statement gets, in front of it, `var __own_tp: *T = 0 as *T; var
// __own_tf = false; defer { if __own_tf { unsafe { let __own_drop =
// *__own_tp; } } }` (the drop is __own_drop's), and the value becomes
// `{ var __own_tv = value; __own_tp = &__own_tv; __own_tf = true; __own_tp }`
// where it is made, in the evaluation order: a `?` or a branch that leaves
// the statement before it is made drops nothing. The value moves into
// __own_tv, so a `?`'s or a block's value is no longer dropped at the end
// of its arm (which made `f()?.m()` use a closed File). An expression
// statement's temporaries drop at its end (it becomes a block); a `let`'s,
// a tail's, at the end of their block (the `let` may keep a view of them),
// a `while` condition's at the end of each test. The nodes are made typed:
// they are not checked again.
//
// (0.25, conventions.md §2.2 "Temporaries") This is the one place a
// statement's temporaries live: a value lent to a let parameter
// (check_mode::LET_ARG), an operator's operands an impl reads, a
// scrutinee no arm takes a part of, the rest of a value a part is moved
// out of (part_drops), and a value moved into a call a later argument may
// leave before (hold_args, TV_MOVE). The block that makes one gives
// `&__own_tv` and is no scope of its own (NODE_TEMP, own/walk): views of
// it end with the statement (or the block), own.escape past that. A `let`
// keeps its temporaries to the end of the block only when it binds a view.

// ---------------------------------------------------------------------------
// Statement temporaries (0.20)
//
// An owned value made by an expression and used without being moved (a
// receiver, `f()?.read()`, `make().len()`; a field read out of it,
// `make().id`; an argument a `let` parameter borrows) lives until its
// statement ends and is dropped then, after every use: Rust's rule. It
// becomes `{ var __own_tv = value; &__own_tv }` where it is made, a block
// that is no scope of its own (NODE_TEMP, own/walk): views of __own_tv end
// with the statement (or the block), own.escape past that. The places IR
// reads the block as `&value` and makes and drops the temporary itself
// (build.vl own_temp_block, value_temp); the own walk's view checks read
// the hidden `let`. The nodes are made typed: they are not checked again.
//
// (0.25, conventions.md §2.2 "Temporaries") So are a value lent to a let
// parameter (check_mode::LET_ARG), an operator's operands an impl reads, a
// scrutinee no arm takes a part of, and the rest of a value a part is moved
// out of (part_move). A `let` keeps its temporaries to the end of the block
// only when it binds a view; an expression statement's, a `let`'s that
// binds none and a `while` condition's end with it (unit_value).
static var SYM_TV: i64 = 0;

// (0.24) Whether the expression visit_temps is visiting is borrowed by its parent (`&e`).
static var TEMP_BORROW: bool = false;

// The statement temporaries with glue made so far (temp_ptr): unit_value
// makes its expression a block of its own when it made one.
static var TEMPS_MADE: i64 = 0;

// Whether e is a temporary to keep to the end of the statement: new,
// owned, with a drop.
fn is_temp(e: i64) -> bool {
    e != 0 && NODES[e].ty > 0 && has_glue(NODES[e].ty) && fresh(e)
}

fn t_let(l: i64, init: i64, at: i64) -> i64 {
    unsafe {
        let pat = t_node(NodeKind::PatBind, at, LOCALS[l].ty);
        NODES[pat].a = LOCALS[l].name;
        NODES[pat].b = 1;
        NODES[pat].x = l;
        let st = t_node(NodeKind::Let, at, TY_UNIT);
        NODES[st].a = pat;
        NODES[st].c = init;
        NODES[st].p |= NO_DROP;
        st
    }
}

fn t_block(mark: i64, tail: i64, at: i64, ty: i64) -> i64 {
    let b = t_node(NodeKind::Block, at, ty);
    list_end(b, mark);
    NODES[b].a = tail;
    NODES[b].p |= BLOCK_DROPS_DONE;
    b
}

// Temporary e (checked, with glue), whose address its statement uses
// (`&value`, a receiver, a let argument, a part read out of it):
// temp_value's block, of type `&T`.
fn temp_ptr(e: i64) -> i64 {
    TEMPS_MADE += 1;
    temp_value(e)
}

// (0.25) The statement temporaries' locals (__own_tv, + 1) and the
// expressions they hold (+ 1): own.escape names the temporary
// (temp_source).
static var TEMP_SRC: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// The expression whose statement temporary is place p's root, or 0.
pub fn temp_source(p: i64) -> i64 {
    unsafe {
        if p < 0 || TEMP_SRC.count == 0 {
            return 0;
        }
        let r = root_of(p);
        if PL_RKIND[r] != RK_LOCAL {
            return 0;
        }
        let s = TEMP_SRC.get(PL_RID[r] + 1);
        if s > 0 { s - 1 } else { 0 }
    }
}

// The number of fields (tuple parts, elements) of struct, tuple or array
// type t.
fn part_count(t: i64) -> i64 {
    unsafe {
        if TYPES[t].kind == TyKind::Struct {
            return STRUCTS[TYPES[t].a].field_count;
        }
        if TYPES[t].kind == TyKind::Tuple {
            return TYPES[t].count;
        }
        if TYPES[t].kind == TyKind::Array {
            return TYPES[t].b;
        }
        0
    }
}

// Visits expression e (checked) after its parts, in the positions
// evaluated with its statement: the temporaries it uses without moving
// them are kept (temp_ptr), the parts moved out of one leave the rest to
// drop (part_drops), a value it moves into a call is held until the call
// when a later argument may leave the statement (hold_args). Blocks were
// visited as they were checked (but an operator's, operator_temps);
// closures' bodies are their own; a `while`'s condition is its own unit.
fn visit_temps(e: i64) {
    if e == 0 {
        return;
    }
    let k = NODES[e].kind;
    if k == NodeKind::Block && operator_temps(e) {
        return;
    }
    if k == NodeKind::Block && crate::front::contracts::expand::requires_tail(e) > 0 {
        // (0.25.2.2: a call of a function with a requires,
        // contracts::desugar::requires_call `{ let ?aI = argI; ..;
        // f$pre(SITE, ?a0, ..); f(?a0, ..) }`, checked by hand, not as a
        // block: its arguments' temporaries are the statement's, as a
        // call's. `dev.compute_pipeline(dev.shader_wgsl(SRC)?, "e")?`
        // lent the shader dropped, a plain temporary leaked)
        for i in 0..NODES[e].count {
            let s = child(e, i);
            if NODES[s].kind == NodeKind::Let {
                visit_temps(NODES[s].c);
            }
        }
        hold_args(e);
        return;
    }
    if k == NodeKind::Block || k == NodeKind::Closure || k == NodeKind::Loop
        || k == NodeKind::Defer || k == NodeKind::Let {
        return;
    }
    if k == NodeKind::While {
        NODES[e].b = unit_value(NODES[e].b);
        return;
    }
    if k == NodeKind::For {
        visit_temps(NODES[e].c);
        return;
    }
    if k == NodeKind::Unary {
        // (`&make().v`: the field is borrowed, not moved)
        TEMP_BORROW = NODES[e].op == Tok::Amp;
        visit_temps(NODES[e].b);
        TEMP_BORROW = false;
        if NODES[e].op == Tok::Amp && is_temp(NODES[e].b) {
            // (`&value`: a receiver, a let argument; the block gives
            // the address, as `&` did)
            let ty = NODES[e].ty;
            let b = temp_ptr(NODES[e].b);
            NODES[e] = NODES[b];
            NODES[e].ty = ty;
        } else if NODES[e].op == Tok::Amp && lent_value(NODES[e].b) {
            // (0.25: a value without glue lent the same way, `E { .. }.nm()`:
            // a local of the statement, whose views are checked as a
            // local's)
            let ty = NODES[e].ty;
            let b = temp_value(NODES[e].b);
            NODES[e] = NODES[b];
            NODES[e].ty = ty;
        }
        return;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        let borrowed = TEMP_BORROW;
        let base = NODES[e].a;
        TEMP_BORROW = borrowed && (NODES[base].kind == NodeKind::FieldAccess
            || NODES[base].kind == NodeKind::TupleField);
        // (0.25: a part moved out of a part, `make().a.b`: the chain is
        // the outermost node's)
        let moved_out = !borrowed && NODES[e].y != 1 && is_owned_type(NODES[e].ty);
        if moved_out && part_move(e) {
            TEMP_BORROW = false;
            return;
        }
        visit_temps(base);
        TEMP_BORROW = false;
        // (0.24: an owned field moved out, `let x = make().v;`, is not
        // read through the temporary's address, which would drop it
        // again with the temporary: part_move, or own.partial when
        // a type on the way implements Drop)
        if NODES[e].y != 1 && is_temp(NODES[e].a) && (borrowed || !is_owned_type(NODES[e].ty)) {
            // (`make().id`: read through the address)
            NODES[e].a = temp_ptr(NODES[e].a);
            if k == NodeKind::FieldAccess {
                NODES[e].y = 1;
                NODES[e].p |= NODE_RAW;
            } else {
                // (`make().1`: a tuple part of the temporary, `(*&tv).1`)
                NODES[e].a = deref_of(NODES[e].a);
            }
        }
        return;
    }
    if k == NodeKind::Binary || k == NodeKind::Assign || k == NodeKind::Index
        || k == NodeKind::Range || k == NodeKind::If {
        if k == NodeKind::If {
            visit_temps(NODES[e].a);
            visit_temps(NODES[e].b);
            visit_temps(NODES[e].c);
            return;
        }
        if k == NodeKind::Index && !TEMP_BORROW && is_owned_type(NODES[e].ty) {
            // (0.25: an element moved out of an array temporary,
            // `make()[1]`; by a run-time index the others would leak)
            if part_move(e) {
                return;
            }
            let base = NODES[e].a;
            if is_temp(base) && TYPES[NODES[base].ty].kind == TyKind::Array {
                temp_element_error(e);
            }
        }
        if k == NodeKind::Index || k == NodeKind::Range {
            visit_temps(NODES[e].a);
            visit_temps(NODES[e].b);
            return;
        }
        visit_temps(NODES[e].b);
        visit_temps(NODES[e].c);
        return;
    }
    if k == NodeKind::Cast || k == NodeKind::Return || k == NodeKind::Repeat
        || k == NodeKind::EnumPanic {
        visit_temps(NODES[e].a);
        return;
    }
    if k == NodeKind::Break || k == NodeKind::FieldInit || k == NodeKind::NamedArg {
        visit_temps(NODES[e].b);
        return;
    }
    if k == NodeKind::Try {
        // (0.25.2.1: its desugaring, `{ let ?try = e; match ?try { .. } }`
        // (check/try_op.vl), is checked by hand, not as a block: the
        // temporaries of e are its statement's. `f(make()?, 8)?` lent
        // the argument by its address, unkept: the match's `?v` was
        // dropped under it, a leak without the inner `?`)
        let y = NODES[e].y;
        if y > 0 && NODES[y].kind == NodeKind::Block && NODES[y].count > 0
            && NODES[child(y, 0)].kind == NodeKind::Let {
            visit_temps(NODES[child(y, 0)].c);
            return;
        }
        visit_temps(y);
        return;
    }
    if k == NodeKind::Interp {
        // (the holes, then what the f-string became)
        for i in 0..NODES[e].count {
            let h = child(e, i);
            if NODES[h].kind == NodeKind::InterpHole {
                visit_temps(NODES[h].a);
            }
        }
        let y = NODES[e].y;
        if y > 0 && NODES[y].kind == NodeKind::Block {
            // (a call written in place, check/interp.vl direct_call:
            // its holes are the values of its `let`s)
            for i in 0..NODES[y].count {
                let s = child(y, i);
                if NODES[s].kind == NodeKind::Let {
                    visit_temps(NODES[s].c);
                }
            }
        } else {
            visit_temps(y);
        }
        return;
    }
    if k == NodeKind::Match {
        visit_temps(NODES[e].a);
        for i in 0..NODES[e].count {
            let arm = child(e, i);
            visit_temps(NODES[arm].b);
            visit_temps(NODES[arm].c);
        }
        // (0.25: an owned temporary matched with no binding that takes
        // a part of it, `match make() { E::A(_) => .. }`: matched where
        // it is kept, and dropped with the statement)
        let s = NODES[e].a;
        if is_temp(s) && !match_binds_owned(e) {
            NODES[e].a = deref_of(temp_ptr(s));
        }
        return;
    }
    if k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::VecOp {
        if k == NodeKind::MethodCall || k == NodeKind::VecOp || NODES[e].x == 0 {
            visit_temps(NODES[e].a);
        }
        for i in 0..NODES[e].count {
            visit_temps(child(e, i));
        }
        hold_args(e);
        return;
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
        || k == NodeKind::VariantLit {
        for i in 0..NODES[e].count {
            visit_temps(child(e, i));
        }
        if k == NodeKind::StructLit {
            // (0.25.2.2: a let field given a branch's value, hold_args)
            hold_args(e);
        }
    }
}

// `*b` of the block b temp_make made (of type `&T`): the temporary as a
// place.
fn deref_of(b: i64) -> i64 {
    let n = t_node(NodeKind::Unary, b, TYPES[NODES[b].ty].a);
    NODES[n].op = Tok::Star;
    NODES[n].b = b;
    n
}

// (0.25) Whether `&v` lends value v as a temporary of no glue (`&E { .. }`,
// a receiver; a let argument): v is no place, and has storage.
fn lent_value(v: i64) -> bool {
    let t = NODES[v].ty;
    if t <= 0 || has_glue(t) || is_place(v) {
        return false;
    }
    let k = NODES[v].kind;
    (k == NodeKind::Call || k == NodeKind::StructLit || k == NodeKind::Tuple
        || k == NodeKind::Array || k == NodeKind::VariantLit || k == NodeKind::Repeat)
        && (TYPES[t].kind == TyKind::Struct || TYPES[t].kind == TyKind::Tuple
            || TYPES[t].kind == TyKind::Array || TYPES[t].kind == TyKind::Enum)
}

// (0.25) Value v lent as a temporary: `{ var __own_tv = v; &__own_tv }`, a
// block that is no scope of its own (own/walk), so that __own_tv lives as
// long as the statement, and views of it are checked as views of a local
// of it.
fn temp_value(v: i64) -> i64 {
    if SYM_TV == 0 {
        SYM_TV = intern_c(c"__own_tv");
    }
    let t = NODES[v].ty;
    let tv = define_local(SYM_TV, t, true, false);
    TEMP_SRC.put(tv + 1, v + 1);
    let m = list_begin();
    list_push(t_let(tv, v, v));
    let rt = crate::front::types::ref_to(t, REF_SHARED);
    let addr = t_node(NodeKind::Unary, v, rt);
    NODES[addr].op = Tok::Amp;
    NODES[addr].b = t_ident(tv, v);
    let b = t_block(m, addr, v, rt);
    NODES[b].p |= NODE_TEMP;
    NODES[b].end = NODES[v].end;
    b
}

// (0.25) Whether an arm of match m binds an owned part of what it matches.
fn match_binds_owned(m: i64) -> bool {
    for i in 0..NODES[m].count {
        if crate::front::own::walk::pattern_binds_owned(NODES[child(m, i)].a) {
            return true;
        }
    }
    false
}

// (0.25) own.partial: `make()[i]`, an owned element moved out of an array
// temporary by a run-time index (the other elements have no owner left).
fn temp_element_error(e: i64) {
    let saved = crate::base::diag::ERR_KIND;
    crate::base::diag::ERR_KIND = c"own.partial";
    crate::base::diag::err_begin(NODES[e].start);
    let text = crate::base::SRC[NODES[e].start..NODES[e].end];
    crate::base::diag::err_fmt(f"'{text}'");
    crate::base::diag::err_str(c" moves an element out of a temporary array by a run-time index: the other elements would not be dropped");
    crate::base::diag::err_help(c"index it by a constant, or bind the array first ('let a = VALUE;') and take the element from it");
    crate::base::diag::err_end_soft();
    crate::base::diag::ERR_KIND = saved;
}

// (0.25) e, a field, tuple part or array element (by a constant) moved
// out of a part chain over an owned temporary (`let a = make().a;`,
// `make().1.b`, `make()[1]`): the temporary is kept and the part read out
// of it, the rest dropped with the statement (part_drops); false, nothing
// done, for another chain, or one through a type with `impl Drop`
// (own.partial, the own walk).
fn part_move(e: i64) -> bool {
    var c = e;
    while is_part_node(c) {
        let base = NODES[c].a;
        let bt = NODES[base].ty;
        if bt <= 0 || has_drop_impl(bt) || part_count(bt) == 0 {
            return false;
        }
        if !is_part_node(base) {
            break;
        }
        c = base;
    }
    if !is_part_node(c) {
        return false;
    }
    let base = NODES[c].a;
    if !is_temp(base) {
        return false;
    }
    visit_temps(base);
    let b = temp_ptr(base);
    NODES[c].a = deref_of(b);
    NODES[NODES[c].a].p |= NODE_RAW;
    // (the chain reads the temporary's storage, which keeps the part
    // no longer: no own.move_out of an index)
    var d = e;
    while d != NODES[c].a {
        NODES[d].p |= NODE_RAW;
        d = NODES[d].a;
    }
    true
}

// Whether n takes a part of its base where it is (a field, a tuple part,
// an element of an array by a constant), not through a pointer.
fn is_part_node(n: i64) -> bool {
    let k = NODES[n].kind;
    if k == NodeKind::FieldAccess {
        return NODES[n].y != 1;
    }
    if k == NodeKind::TupleField {
        return true;
    }
    let base = NODES[n].a;
    k == NodeKind::Index && NODES[NODES[n].b].kind == NodeKind::Int && NODES[base].ty > 0
        && TYPES[NODES[base].ty].kind == TyKind::Array
}

// (0.25) Call e (0.25.2.2: or a requires check's block, or a struct
// literal, whose fields are its arguments), its arguments visited: an
// owned value an argument moves into the callee (`two(mk(1), g()?)`)
// while a later argument may leave the statement (`?`, `return`, `break`)
// is held as a temporary, its flag cleared once the last argument is
// evaluated: the statement leaving before the call drops it, once (hold,
// a function's call).
//
// (0.25.2.1) First, an argument lent to a let parameter (of type `&T`)
// whose value is a branch's: a `match` (`count(match make() { Ok(s) => s,
// Err(e) => return Err(e) }, 8)`), an `if`, a block, a `?` in one of
// them. Each value was checked against `&T`, `&s`: a local declared in the
// argument (a `let` of a block or a binding of an arm on the way to it),
// which dies before the call, is moved into a temporary of the statement
// instead (it was lent dropped).
fn hold_args(e: i64) {
    unsafe {
        // (0.25.2.2: a requires check's block, `{ let ?aI = argI; ..; f$pre(..);
        // f(?a0, ..) }`: its lets' values, in order, are the arguments)
        var vals = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..NODES[e].count {
            let c = child(e, i);
            if NODES[e].kind != NodeKind::Block {
                // (a named argument's value; 0.25.2.2: a struct literal's
                // field's, `Desc { s: make()?, n: 1 }` with s a let field)
                let named = NODES[c].kind == NodeKind::NamedArg
                    || NODES[c].kind == NodeKind::FieldInit;
                vals.push(if named { NODES[c].b } else { c });
            } else if NODES[c].kind == NodeKind::Let {
                vals.push(NODES[c].c);
            }
        }
        for ai in 0..vals.count {
            let a = vals.data[ai];
            let at = NODES[a].ty;
            let ak = NODES[a].kind;
            if at <= 0 || TYPES[at].kind != TyKind::Ptr || TYPES[at].b != REF_SHARED
                || ak != NodeKind::Match && ak != NodeKind::If && ak != NodeKind::Block
                && ak != NodeKind::Try || (NODES[a].p & NODE_TEMP) != 0 {
                continue;
            }
            // (a walk with a stack of (node, the count of the scopes above
            // it, a scope it adds): the blocks and arms on the way)
            var todo = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var scopes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            todo.push(a);
            todo.push(0);
            todo.push(0);
            while todo.count > 0 {
                let adds = todo.data[todo.count - 1];
                scopes.count = todo.data[todo.count - 2];
                let n = todo.data[todo.count - 3];
                todo.count -= 3;
                if adds != 0 {
                    scopes.push(adds);
                }
                if n <= 0 {
                    continue;
                }
                let k = NODES[n].kind;
                var next = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                if k == NodeKind::Block {
                    next.push(NODES[n].a);
                    next.push(n);
                } else if k == NodeKind::Try {
                    next.push(NODES[n].y);
                    next.push(0);
                } else if k == NodeKind::If {
                    next.push(NODES[n].b);
                    next.push(0);
                    next.push(NODES[n].c);
                    next.push(0);
                } else if k == NodeKind::Match {
                    for i in 0..NODES[n].count {
                        let arm = child(n, i);
                        next.push(NODES[arm].c);
                        next.push(arm);
                    }
                } else if k == NodeKind::Unary && NODES[n].op == Tok::Amp {
                    let b = NODES[n].b;
                    let l = NODES[b].y;
                    if NODES[b].kind != NodeKind::Ident || NODES[b].res != Res::Local || l < 0
                        || BYREF.get(l + 1) != 0 || !is_owned_type(NODES[b].ty)
                        || !has_glue(NODES[b].ty) {
                        continue;
                    }
                    var inside = false;
                    for j in 0..scopes.count {
                        let s = scopes.data[j];
                        if NODES[s].kind == NodeKind::Arm {
                            inside = inside || binds(NODES[s].a, l);
                            continue;
                        }
                        for m in 0..NODES[s].count {
                            let st = child(s, m);
                            inside = inside || NODES[st].kind == NodeKind::Let && NODES[st].a != 0
                                && binds(NODES[st].a, l);
                        }
                    }
                    if inside {
                        let ty = NODES[n].ty;
                        let t = temp_ptr(b);
                        NODES[n] = NODES[t];
                        NODES[n].ty = ty;
                    }
                }
                let depth = scopes.count;
                var i = 0;
                while i < next.count {
                    todo.push(next.data[i]);
                    todo.push(depth);
                    todo.push(next.data[i + 1]);
                    i += 2;
                }
            }
        }
    }
}

// (0.25) Operator block e (traits::operator_call: `{ let ==l = a; let ==r =
// b; ==l.add(==r) }`): an operand an impl reads (`==`, a let parameter)
// that is an owned temporary is kept and dropped with the statement (it
// was read and never dropped); one it takes (`=+`) moves on. Whether e is
// one.
fn operator_temps(e: i64) -> bool {
    if NODES[e].count == 0 {
        return false;
    }
    let s0 = child(e, 0);
    if NODES[s0].kind != NodeKind::Let || NODES[s0].a == 0
        || NODES[NODES[s0].a].kind != NodeKind::PatBind {
        return false;
    }
    let w = crate::base::SYMS[NODES[NODES[s0].a].a].text;
    if w != "==l" && w != "=+l" {
        return false;
    }
    for i in 0..NODES[e].count {
        let s = child(e, i);
        if NODES[s].kind != NodeKind::Let || NODES[s].a == 0
            || NODES[NODES[s].a].kind != NodeKind::PatBind {
            continue;
        }
        visit_temps(NODES[s].c);
        let name = crate::base::SYMS[NODES[NODES[s].a].a].text;
        if name.len as i64 > 1 && name[1] == '=' && is_temp(NODES[s].c) {
            NODES[s].c = deref_of(temp_ptr(NODES[s].c));
        }
    }
    true
}

// Expression e (checked), a unit of its own (an expression statement, a
// `let`'s value that binds no view, a `while` condition): its temporaries
// end when it is evaluated, `{ e }` when it made one.
fn unit_value(e: i64) -> i64 {
    if e == 0 || !drops_on() {
        return e;
    }
    let made = TEMPS_MADE;
    visit_temps(e);
    if TEMPS_MADE == made {
        return e;
    }
    t_block(list_begin(), e, e, NODES[e].ty)
}
