// The own pass's fast path (0.17, docs/design/value-semantics.md §4,
// "Cost"; T2 owns it): a function with nothing to track is not walked.
//
// walk_fn asks needs_walk(f) first; a function that does not need it gets
// the summary views() (collect_begin, then collect_end with nothing
// collected) and no findings. A function needs the walk when:
// - a parameter, its result or any expression in it has an owned or a
//   view type (moves, drops, slots, results, `&T` loans, f-strings over
//   owned values: everything the events track hangs on one of them);
// - or a call in it takes a loan (`&place`, a borrowed pointer parameter
//   passed on) of a root that an earlier argument of the same call, or of
//   an enclosing one, also borrows, or that is assigned meanwhile: the only
//   findings left without views or owned values are argument conflicts
//   (`f(&a, &a)`, `a.f(g(&a))` with legacy `*T` parameters).
// The scan below visits what walk.vl's eval visits; a node kind the walk
// learns must be added here too.

use crate::base::alloc_array;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NODE_RAW, NodeKind, child};
use crate::front::check::Res;
use crate::front::own::glue::has_glue;
use crate::front::own::kinds::{K_OWNED, K_VIEW, type_kind};
use crate::front::types::TyKind;

// Whether type t is owned or a view (kinds.vl), memoized here per type
// id in one byte (the scan asks it of every node): 0 unknown, 1 no, 2
// owned, 3 a view only.
fn tracked(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if t <= 0 {
            return false;
        }
        if t < pcx.memo_cap {
            let m = (*pcx.memo.add(t as usize));
            if m != 0 {
                return m >= 2;
            }
        } else {
            let n = t * 2 + 1024;
            let a = alloc_array::<u8>(n);
            for i in 0..pcx.memo_cap {
                (*a.add(i as usize)) = (*pcx.memo.add(i as usize));
            }
            pcx.memo = a;
            pcx.memo_cap = n;
        }
        let k = type_kind(t, pcx);
        (*pcx.memo.add(t as usize)) = if (k & K_OWNED) != 0 { 2 } else if (k & K_VIEW) != 0 { 3 } else { 1 };
        (*pcx.memo.add(t as usize)) >= 2
    }
}

// Whether expression e (of a view type) holds only views of static data
// or of what a raw pointer reaches (origin ∅: the walk gives it none): a
// string literal, a place reached through a raw pointer (`SYMS[s].text`).
fn raw_view(e: i64, pcx: &mut Ctx<Comp>) -> bool {
    raw_view_of(e, true, pcx)
}

// raw_view; calls: a call given no loans and no views counts (it asks the
// kinds of its arguments' types: not during type checking).
fn raw_view_of(e: i64, calls: bool, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let k = pcx.nodes[e as usize].kind;
        if k == NodeKind::Str {
            return true;
        }
        if k == NodeKind::FieldAccess {
            if pcx.nodes[e as usize].y == 1 {
                return !reference(pcx.nodes[e as usize].a, pcx);
            }
            return raw_view_of(pcx.nodes[e as usize].a, calls, pcx);
        }
        if k == NodeKind::Call && calls {
            // (a call given no loans and no views: its result has none)
            if pcx.nodes[e as usize].x - 1 < 0 {
                return false;
            }
            for i in 0..pcx.nodes[e as usize].count {
                let arg = child(e, i, pcx);
                let ak = pcx.nodes[arg as usize].kind;
                if ak == NodeKind::Unary && pcx.nodes[arg as usize].op == crate::front::lexer::Tok::Amp
                    || ak == NodeKind::Ident && pcx.nodes[arg as usize].res == Res::Local
                    && pcx.nodes[arg as usize].y >= 0
                    && pcx.locals[pcx.nodes[arg as usize].y as usize].borrow {
                    return false;
                }
                let at = pcx.nodes[arg as usize].ty;
                if tracked(at, pcx) && !((*pcx.memo.add(at as usize)) == 3 && raw_view(arg, pcx)) {
                    return false;
                }
            }
            return true;
        }
        if k == NodeKind::TupleField {
            return raw_view_of(pcx.nodes[e as usize].a, calls, pcx);
        }
        if k == NodeKind::Unary && pcx.nodes[e as usize].op == crate::front::lexer::Tok::Star {
            return !reference(pcx.nodes[e as usize].b, pcx);
        }
        if k == NodeKind::Index && pcx.nodes[pcx.nodes[e as usize].b as usize].kind != NodeKind::Range {
            let bt = pcx.nodes[pcx.nodes[e as usize].a as usize].ty;
            if bt > 0 && pcx.types[bt as usize].kind == TyKind::Ptr {
                return (pcx.nodes[e as usize].p & NODE_RAW) != 0 || !reference(pcx.nodes[e as usize].a, pcx);
            }
            return raw_view_of(pcx.nodes[e as usize].a, calls, pcx);
        }
        false
    }
}

// Whether pointer expression e is a reference or a borrow (walk.vl's
// is_reference).
fn reference(e: i64, pcx: &Ctx<Comp>) -> bool {
    let t = pcx.nodes[e as usize].ty;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != 0 {
        return true;
    }
    pcx.nodes[e as usize].kind == NodeKind::Ident && pcx.nodes[e as usize].res == Res::Local
        && pcx.nodes[e as usize].y >= 0 && pcx.locals[pcx.nodes[e as usize].y as usize].borrow
}

// Whether function f has anything the walk tracks (memoized: the driver
// walks a recursive component's functions several times). A function the
// type checker recorded (check_begin) is decided by its record; another
// (a closure's function, checked inside its parent) by the scan.
pub fn needs_walk(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if f < pcx.known_cap && (*pcx.fast_known.add(f as usize)) != 0 {
            return (*pcx.fast_known.add(f as usize)) == 2;
        }
        if f >= pcx.known_cap {
            let n = f * 2 + 1024;
            let a = alloc_array::<u8>(n);
            for i in 0..pcx.known_cap {
                (*a.add(i as usize)) = (*pcx.fast_known.add(i as usize));
            }
            pcx.fast_known = a;
            pcx.known_cap = n;
        }
        let need = if f < pcx.rec_cap
            && ((*pcx.rec_flags.add(f as usize)) & R_CHECKED) != 0 { record_says(f, pcx) }
            else { scan_fn(f, pcx) };
        (*pcx.fast_known.add(f as usize)) = if need { 2 } else { 1 };
        need
    }
}

// ---------------------------------------------------------------------------
// The record the type checker keeps (check/ hooks, the contract): per
// function, the types of its expressions, locals and parameters (each once
// in a row: STAMP), and whether a call in it borrows one root twice (the
// loans of the pending arguments, as scan_call has them). Types only: the
// kinds are asked here, after the checker (a closure's kind is known once
// it is finished).

const R_CHECKED: u8 = 1;
const R_LOANS: u8 = 2;

const R_SCAN: u8 = 4;

#[inline]
fn makes_value(k: NodeKind, pcx: &mut Ctx<Comp>) -> bool {
    if !pcx.makes_set {
        pcx.makes_set = true;
        pcx.makes[NodeKind::Call as i64 as usize] = true;
        pcx.makes[NodeKind::MethodCall as i64 as usize] = true;
        pcx.makes[NodeKind::StructLit as i64 as usize] = true;
        pcx.makes[NodeKind::Tuple as i64 as usize] = true;
        pcx.makes[NodeKind::Array as i64 as usize] = true;
        pcx.makes[NodeKind::VariantLit as i64 as usize] = true;
        pcx.makes[NodeKind::Repeat as i64 as usize] = true;
        pcx.makes[NodeKind::Closure as i64 as usize] = true;
    }
    pcx.makes[k as i64 as usize]
}

fn fresh_on(pcx: &mut Ctx<Comp>) -> bool {
    if pcx.fresh_state == 0 {
        pcx.fresh_state = if crate::places::by_glue(pcx) { 1 } else { 2 };
    }
    pcx.fresh_state == 1
}

// Type t of a value the function being checked makes.
fn note_fresh(t: i64, pcx: &mut Ctx<Comp>) {
    // UNSAFE: FSTAMP is this file's raw array of stamps, grown as STAMP is (alloc_array).
    // SAFETY: t < FSTAMP_CAP before FSTAMP[t]; a grown array copies the old one first.
    unsafe {
        let f = pcx.rec_f;
        if f < 0 || t <= 0 || t < pcx.fstamp_cap && (*pcx.fstamp.add(t as usize)) == f + 1 {
            return;
        }
        if t >= pcx.fstamp_cap {
            let n = t * 2 + 1024;
            let a = alloc_array::<i64>(n);
            for i in 0..pcx.fstamp_cap {
                (*a.add(i as usize)) = (*pcx.fstamp.add(i as usize));
            }
            pcx.fstamp = a;
            pcx.fstamp_cap = n;
        }
        (*pcx.fstamp.add(t as usize)) = f + 1;
        pcx.fresh.push(f);
        pcx.fresh.push(t);
    }
}

// FRESH by function, once (by_fn's counting sort).
fn fresh_by_fn(pcx: &mut Ctx<Comp>) {
    // UNSAFE: FRESH's data and the arrays made here are raw (*i64).
    // SAFETY: start has n + 1 entries for f < n; out has one per pair; FRESH.data has
    // FRESH.count entries.
    unsafe {
        if pcx.fby_n >= 0 {
            return;
        }
        let n = pcx.fns.len() as i64 + 1;
        let start = alloc_array::<i64>(n + 1);
        let pairs = pcx.fresh.count / 2;
        for i in 0..pairs {
            let f = (*pcx.fresh.data.add((2 * i) as usize));
            if f < n {
                (*start.add((f + 1) as usize)) += 1;
            }
        }
        for f in 0..n {
            (*start.add((f + 1) as usize)) += (*start.add(f as usize));
        }
        let fill = alloc_array::<i64>(n + 1);
        let out = alloc_array::<i64>(pairs + 1);
        for i in 0..pairs {
            let f = (*pcx.fresh.data.add((2 * i) as usize));
            if f < n {
                (*out.add(((*start.add(f as usize)) + (*fill.add(f as usize))) as usize)) = (*pcx.fresh.data.add((2 * i + 1) as usize));
                (*fill.add(f as usize)) += 1;
            }
        }
        pcx.fby_start = start;
        pcx.fby = out;
        pcx.fby_n = n;
    }
}

fn rec_flags(f: i64, pcx: &mut Ctx<Comp>) -> *mut u8 {
    unsafe {
        if f >= pcx.rec_cap {
            let n = f * 2 + 1024;
            let a = alloc_array::<u8>(n);
            for i in 0..pcx.rec_cap {
                (*a.add(i as usize)) = (*pcx.rec_flags.add(i as usize));
            }
            pcx.rec_flags = a;
            pcx.rec_cap = n;
        }
        pcx.rec_flags.add(f as usize)
    }
}

// The type checker starts function f (check_function; a function may be
// checked inside another's call: an instance, a lazy default). The
// enclosing record is saved, check_end restores it.
pub fn check_begin(f: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.saved.push(pcx.rec_f);
        pcx.saved.push(pcx.cdepth);
        pcx.saved.push(pcx.croots.count);
        pcx.rec_f = f;
        pcx.cdepth = 0;
        pcx.span_a = if f >= 0 { pcx.nodes[pcx.fns[f as usize].node as usize].start } else { 0 };
        pcx.span_b = if f >= 0 { pcx.nodes[pcx.fns[f as usize].node as usize].end } else { 0 };
        if f >= 0 {
            *rec_flags(f, pcx) |= R_CHECKED;
        }
        pcx.by_n = -1;
        pcx.fby_n = -1;
    }
}

// The type checker ends the function check_begin started.
pub fn check_end(pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.saved.count < 3 {
            pcx.rec_f = -1;
            return;
        }
        pcx.croots.count = (*pcx.saved.data.add((pcx.saved.count - 1) as usize));
        pcx.cdepth = (*pcx.saved.data.add((pcx.saved.count - 2) as usize));
        pcx.rec_f = (*pcx.saved.data.add((pcx.saved.count - 3) as usize));
        pcx.span_a = if pcx.rec_f >= 0 { pcx.nodes[pcx.fns[pcx.rec_f as usize].node as usize].start } else { 0 };
        pcx.span_b = if pcx.rec_f >= 0 { pcx.nodes[pcx.fns[pcx.rec_f as usize].node as usize].end } else { 0 };
        pcx.saved.count -= 3;
    }
}

// Type t is met in the function being checked: a local's, defined now
// (front::check::define_local).
#[inline]
pub fn note_type(t: i64, pcx: &mut Ctx<Comp>) {
    // UNSAFE: LOCALS and STAMP are raw arrays (*Local, *i64).
    // SAFETY: define_local, the one caller, made local LOCAL_COUNT - 1 just before;
    // t < STAMP_CAP before STAMP[t].
    unsafe {
        // (a local, not a parameter: a value the function makes)
        if pcx.rec_f >= 0 && !pcx.locals[(pcx.locals.len() as i64 - 1) as usize].is_param
            && fresh_on(pcx) {
            note_fresh(t, pcx);
        }
        let f = pcx.rec_f;
        if f < 0 || t <= 0 || t < pcx.stamp_cap && (*pcx.stamp.add(t as usize)) == f + 1 {
            return;
        }
        note_new(f, t, pcx);
    }
}

fn note_new(f: i64, t: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if t >= pcx.stamp_cap {
            let n = t * 2 + 1024;
            let a = alloc_array::<i64>(n);
            for i in 0..pcx.stamp_cap {
                (*a.add(i as usize)) = (*pcx.stamp.add(i as usize));
            }
            pcx.stamp = a;
            pcx.stamp_cap = n;
        }
        (*pcx.stamp.add(t as usize)) = f + 1;
        pcx.rec.push(f);
        pcx.rec.push(t);
    }
}

// check_expr or synth_expr enters node n: a call's frame of loans (its
// mark, -1 for another node).
#[inline]
pub fn expr_enter(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Call || k == NodeKind::MethodCall {
            pcx.cdepth += 1;
            return pcx.croots.count;
        }
        if pcx.rec_f >= 0 && (k == NodeKind::Closure || pcx.nodes[n as usize].start < pcx.span_a
            || pcx.nodes[n as usize].start > pcx.span_b) {
            *rec_flags(pcx.rec_f, pcx) |= R_SCAN;
        }
        -1
    }
}

// check_expr leaves node n, of type t (expected), entered with mark m.
// (The checker's hottest path: a type the function has recorded already
// costs a lookup.)
#[inline]
pub fn check_exit(n: i64, t: i64, m: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if m >= 0 {
            pcx.croots.count = m;
            pcx.cdepth -= 1;
        }
        if pcx.rec_f < 0 {
            return;
        }
        let k = pcx.nodes[n as usize].kind;
        if makes_value(k, pcx) && fresh_on(pcx) {
            note_fresh(t, pcx);
        }
        if (k == NodeKind::Unary || k == NodeKind::Ident
            || pcx.cdepth > 0 && (k == NodeKind::FieldAccess || k == NodeKind::Index))
            && check_loans(n, t, k, pcx) {
            return;
        }
        if t <= 0 || t < pcx.stamp_cap && (*pcx.stamp.add(t as usize)) == pcx.rec_f + 1 {
            return;
        }
        if k == NodeKind::Str || raw_view_of(n, false, pcx) {
            return;
        }
        note_new(pcx.rec_f, t, pcx);
    }
}

// The loans of check_exit: `&place`, a borrowed pointer passed on, a view
// read out of a place inside a call (view_arg: then true, its type not
// recorded; ∅ when reached through a raw pointer).
fn check_loans(n: i64, t: i64, k: NodeKind, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if k == NodeKind::Unary {
            if pcx.nodes[n as usize].op == crate::front::lexer::Tok::Amp {
                check_loan(place_root(pcx.nodes[n as usize].b, pcx), true, pcx);
            }
            return false;
        }
        if k == NodeKind::Ident && pcx.nodes[n as usize].res == Res::Local && pcx.nodes[n as usize].y >= 0
            && pcx.locals[pcx.nodes[n as usize].y as usize].borrow && t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            check_loan(2 * pcx.nodes[n as usize].y, true, pcx);
            return false;
        }
        if pcx.cdepth > 0 && t > 0
            && (pcx.types[t as usize].kind == TyKind::Slice || pcx.types[t as usize].kind == TyKind::Ptr) {
            if raw_view_of(n, false, pcx) {
                return true;
            }
            let r = place_root(n, pcx);
            if r >= 0 {
                if (r & 1) == 1 {
                    *rec_flags(pcx.rec_f, pcx) |= R_LOANS;
                }
                check_loan(r, true, pcx);
                return true;
            }
        }
        false
    }
}

// synth_expr leaves node n, of type t, entered with mark m.
#[inline]
pub fn synth_exit(n: i64, t: i64, m: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if m >= 0 {
            pcx.croots.count = m;
            pcx.cdepth -= 1;
        }
        if pcx.rec_f < 0 || n == pcx.chk_node {
            return;
        }
        let k = pcx.nodes[n as usize].kind;
        if makes_value(k, pcx) && fresh_on(pcx) {
            note_fresh(t, pcx);
        }
        if k == NodeKind::Assign {
            check_loan(place_root(pcx.nodes[n as usize].b, pcx), false, pcx);
        }
        if t <= 0 || t < pcx.stamp_cap && (*pcx.stamp.add(t as usize)) == pcx.rec_f + 1 {
            return;
        }
        if k == NodeKind::Str || k == NodeKind::FieldAccess && raw_view_of(n, false, pcx) {
            return;
        }
        note_new(pcx.rec_f, t, pcx);
    }
}

// check_expr is checking node n (its own synth is not recorded).
#[inline]
pub fn check_node(n: i64, pcx: &mut Ctx<Comp>) {
    pcx.chk_node = n;
}

// The function being checked holds nodes its check does not type (a
// default argument's, args.vl): the scan decides it.
pub fn note_scan(pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.rec_f >= 0 {
            *rec_flags(pcx.rec_f, pcx) |= R_SCAN;
        }
    }
}

// The functions holding closures (a closure is typed when it is
// finished, not where it is checked): the scan decides them. Once.
fn mark_closures(pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.closures_marked {
            return;
        }
        pcx.closures_marked = true;
        for i in 0..pcx.closures.len() as i64 {
            let e = pcx.closures[i as usize].encl_fn;
            if e >= 0 {
                *rec_flags(e, pcx) |= R_SCAN;
            }
        }
    }
}

// The checker made node u (a method's receiver `&recv`, or `*recv`) typed.
pub fn note_synthetic(u: i64, pcx: &mut Ctx<Comp>) {
    if pcx.rec_f < 0 {
        return;
    }
    if pcx.nodes[u as usize].op == crate::front::lexer::Tok::Amp {
        check_loan(place_root(pcx.nodes[u as usize].b, pcx), true, pcx);
    }
    let t = pcx.nodes[u as usize].ty;
    // UNSAFE: STAMP is a raw array (*i64).
    // SAFETY: t < STAMP_CAP before STAMP[t].
    if t > 0 && !(t < pcx.stamp_cap && unsafe { (*pcx.stamp.add(t as usize)) } == pcx.rec_f + 1) {
        note_new(pcx.rec_f, t, pcx);
    }
}

// A loan of root r (-1: none) in the call being checked: one an enclosing
// pending argument also holds is a possible conflict; pending: it stays
// pending for the call's later arguments.
fn check_loan(r: i64, pending: bool, pcx: &mut Ctx<Comp>) {
    unsafe {
        if r < 0 || pcx.cdepth <= 0 {
            return;
        }
        for i in 0..pcx.croots.count {
            if (*pcx.croots.data.add(i as usize)) == r {
                *rec_flags(pcx.rec_f, pcx) |= R_LOANS;
                return;
            }
        }
        if pending {
            pcx.croots.push(r);
        }
    }
}

// What f's record says (needs_walk).
fn record_says(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        mark_closures(pcx);
        if ((*pcx.rec_flags.add(f as usize)) & R_LOANS) != 0 {
            return true;
        }
        if ((*pcx.rec_flags.add(f as usize)) & R_SCAN) != 0 {
            return scan_fn(f, pcx);
        }
        let item = pcx.fns[f as usize].node;
        if tracked(pcx.fns[f as usize].ret, pcx) {
            return true;
        }
        for i in 0..pcx.nodes[item as usize].count {
            let l = pcx.nodes[child(item, i, pcx) as usize].x;
            if l < 0 {
                continue;
            }
            let t = pcx.locals[l as usize].ty;
            if tracked(t, pcx)
                || t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && tracked(pcx.types[t as usize].a, pcx) {
                return true;
            }
        }
        by_fn(pcx);
        if f >= pcx.by_n {
            return true;
        }
        for i in (*pcx.by_start.add(f as usize))..(*pcx.by_start.add((f + 1) as usize)) {
            if tracked((*pcx.by_fn.add(i as usize)), pcx) {
                return true;
            }
        }
        false
    }
}

// glue_met's rule: a
// parameter it takes by value (`sink`) with glue, or a value it makes
// (FRESH: a local's, a call's result, an aggregate's, a closure's) with
// glue.
fn makes_glue(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    // UNSAFE: FBY_START and FBY are raw arrays (*i64), LOCALS too (*Local).
    // SAFETY: f < FBY_N, the length of FBY_START less one, before FBY_START[f + 1], whose
    // range lies in FBY; l is a parameter's local, below LOCAL_COUNT.
    unsafe {
        let item = pcx.fns[f as usize].node;
        for i in 0..pcx.nodes[item as usize].count {
            let l = pcx.nodes[child(item, i, pcx) as usize].x;
            if l >= 0 && i < pcx.fns[f as usize].param_count
                && crate::front::own::kinds::param_mode(f, i, pcx)
                == crate::front::own::kinds::P_VALUE
                && has_glue(pcx.locals[l as usize].ty, pcx) {
                return true;
            }
        }
        fresh_by_fn(pcx);
        if f >= pcx.fby_n {
            return true;
        }
        for i in (*pcx.fby_start.add(f as usize))..(*pcx.fby_start.add((f + 1) as usize)) {
            if has_glue((*pcx.fby.add(i as usize)), pcx) {
                return true;
            }
        }
        false
    }
}

// (0.26.1, the places IR's cost at check) Whether function f may drop
// anything, so that places::run_places builds its body at check: whether
// it takes a parameter by value (`sink`) whose type has glue, or makes a
// value whose type has glue (makes_glue: a local, a call's result, an
// aggregate, a closure, as the checker met them). Over compiler/src 1,033
// bodies of 10,933, and the IR finds no drop that runs in the others
// (--places-noglue-check, over compiler/src and every tests/run source).
// A function with no record of its own, or one holding a closure (R_SCAN),
// may. The own pass's drops are not asked: it stays when they go (step
// 7). Unlike needs_walk it memoizes nothing: it runs before the own pass,
// whose kinds of views may change meanwhile.
pub fn glue_met(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    // UNSAFE: REC_FLAGS is a raw array (*u8).
    // SAFETY: f < REC_CAP before REC_FLAGS[f].
    unsafe {
        mark_closures(pcx);
        if f >= pcx.rec_cap || ((*pcx.rec_flags.add(f as usize)) & R_CHECKED) == 0
            || ((*pcx.rec_flags.add(f as usize)) & R_SCAN) != 0 {
            return true;
        }
    }
    makes_glue(f, pcx)
}

// The records by function (a counting sort of REC), once.
fn by_fn(pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.by_n >= 0 {
            return;
        }
        let n = pcx.fns.len() as i64 + 1;
        let start = alloc_array::<i64>(n + 1);
        let pairs = pcx.rec.count / 2;
        for i in 0..pairs {
            let f = (*pcx.rec.data.add((2 * i) as usize));
            if f < n {
                (*start.add((f + 1) as usize)) += 1;
            }
        }
        for f in 0..n {
            (*start.add((f + 1) as usize)) += (*start.add(f as usize));
        }
        let fill = alloc_array::<i64>(n + 1);
        let out = alloc_array::<i64>(pairs + 1);
        for i in 0..pairs {
            let f = (*pcx.rec.data.add((2 * i) as usize));
            if f < n {
                (*out.add(((*start.add(f as usize)) + (*fill.add(f as usize))) as usize)) = (*pcx.rec.data.add((2 * i + 1) as usize));
                (*fill.add(f as usize)) += 1;
            }
        }
        pcx.by_start = start;
        pcx.by_fn = out;
        pcx.by_n = n;
    }
}

fn scan_fn(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    let item = pcx.fns[f as usize].node;
    if tracked(pcx.fns[f as usize].ret, pcx) {
        return true;
    }
    for i in 0..pcx.nodes[item as usize].count {
        let l = pcx.nodes[child(item, i, pcx) as usize].x;
        if l < 0 {
            continue;
        }
        let t = pcx.locals[l as usize].ty;
        // (a pointer parameter to what holds views: the stores)
        if tracked(t, pcx)
            || t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && tracked(pcx.types[t as usize].a, pcx) {
            return true;
        }
    }
    pcx.need = false;
    pcx.roots.count = 0;
    pcx.static_views = 0;
    scan(pcx.nodes[item as usize].c, pcx);
    pcx.need
}

// The root of place expression e: 2 * local, 2 * static + 1; -1: not a
// place.
fn place_root(e: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        if pcx.nodes[e as usize].res == Res::Local && pcx.nodes[e as usize].y >= 0 {
            return 2 * pcx.nodes[e as usize].y;
        }
        if pcx.nodes[e as usize].res == Res::Static && pcx.nodes[e as usize].y >= 0 {
            return 2 * pcx.nodes[e as usize].y + 1;
        }
        return -1;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return place_root(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == crate::front::lexer::Tok::Star {
        return place_root(pcx.nodes[e as usize].b, pcx);
    }
    if k == NodeKind::Index && pcx.nodes[pcx.nodes[e as usize].b as usize].kind != NodeKind::Range {
        return place_root(pcx.nodes[e as usize].a, pcx);
    }
    -1
}

// A loan of root r is taken while the pending ones are ROOTS.
fn loan(r: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if r < 0 {
            return;
        }
        for i in 0..pcx.roots.count {
            if (*pcx.roots.data.add(i as usize)) == r {
                pcx.need = true;
                return;
            }
        }
    }
}

fn scan_list(n: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        scan(child(n, i, pcx), pcx);
    }
}

fn scan_pattern(p: i64, pcx: &mut Ctx<Comp>) {
    if p == 0 {
        return;
    }
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::PatBind {
        if pcx.nodes[p as usize].x >= 0 && tracked(pcx.locals[pcx.nodes[p as usize].x as usize].ty, pcx) {
            pcx.need = true;
        }
        return;
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[p as usize].count {
            scan_pattern(child(p, i, pcx), pcx);
        }
    }
}

// Node n: its type, then (not for a leaf: a local, a literal) its parts.
// Inlined: a leaf costs no call (the scan's hottest path).
#[inline]
fn scan(n: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if n == 0 || pcx.need {
            return;
        }
        let t = pcx.nodes[n as usize].ty;
        if t > 0 {
            let m = if t < pcx.memo_cap { (*pcx.memo.add(t as usize)) } else { 0 };
            if m != 1 && (m >= 2 || tracked(t, pcx)) && !((*pcx.memo.add(t as usize)) == 3 && raw_view(n, pcx)) {
                pcx.need = true;
                return;
            }
        }
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Ident || k == NodeKind::Int || k == NodeKind::Bool
            || k == NodeKind::Char || k == NodeKind::CStr || k == NodeKind::Str {
            return;
        }
        scan_node(n, pcx);
    }
}

fn scan_node(n: i64, pcx: &mut Ctx<Comp>) {
    match pcx.nodes[n as usize].kind {
        NodeKind::FieldAccess | NodeKind::TupleField | NodeKind::Cast
            | NodeKind::Repeat | NodeKind::EnumPanic => scan(pcx.nodes[n as usize].a, pcx),
        NodeKind::Unary => scan(pcx.nodes[n as usize].b, pcx),
        NodeKind::Index | NodeKind::Range => {
            scan(pcx.nodes[n as usize].b, pcx);
            scan(pcx.nodes[n as usize].a, pcx);
        }
        NodeKind::Binary => {
            scan(pcx.nodes[n as usize].b, pcx);
            scan(pcx.nodes[n as usize].c, pcx);
        }
        NodeKind::Assign => {
            scan(pcx.nodes[n as usize].c, pcx);
            scan(pcx.nodes[n as usize].b, pcx);
            loan(place_root(pcx.nodes[n as usize].b, pcx), pcx);
        }
        NodeKind::Call => scan_call(n, pcx),
        NodeKind::Block => {
            for i in 0..pcx.nodes[n as usize].count {
                let s = child(n, i, pcx);
                let k = pcx.nodes[s as usize].kind;
                if k == NodeKind::Let {
                    scan_pattern(pcx.nodes[s as usize].a, pcx);
                    scan(pcx.nodes[s as usize].c, pcx);
                } else if k == NodeKind::Defer || k == NodeKind::ExprStmt {
                    scan(pcx.nodes[s as usize].a, pcx);
                } else {
                    scan(s, pcx);
                }
            }
            scan(pcx.nodes[n as usize].a, pcx);
        }
        NodeKind::If => {
            scan(pcx.nodes[n as usize].a, pcx);
            scan(pcx.nodes[n as usize].b, pcx);
            scan(pcx.nodes[n as usize].c, pcx);
        }
        NodeKind::Match => {
            scan(pcx.nodes[n as usize].a, pcx);
            for i in 0..pcx.nodes[n as usize].count {
                let arm = child(n, i, pcx);
                scan_pattern(pcx.nodes[arm as usize].a, pcx);
                scan(pcx.nodes[arm as usize].b, pcx);
                scan(pcx.nodes[arm as usize].c, pcx);
            }
        }
        // (as walk.vl's eval_loop: a loop's other fields are no nodes)
        NodeKind::Loop => scan(pcx.nodes[n as usize].b, pcx),
        NodeKind::While => {
            scan(pcx.nodes[n as usize].b, pcx);
            scan(pcx.nodes[n as usize].c, pcx);
        }
        NodeKind::For => {
            scan_pattern(pcx.nodes[n as usize].b, pcx);
            scan(pcx.nodes[n as usize].c, pcx);
            scan(pcx.nodes[n as usize].d, pcx);
        }
        NodeKind::Break => scan(pcx.nodes[n as usize].b, pcx),
        NodeKind::Return => scan(pcx.nodes[n as usize].a, pcx),
        NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit
            | NodeKind::VariantLit => scan_list(n, pcx),
        NodeKind::FieldInit | NodeKind::NamedArg => scan(pcx.nodes[n as usize].b, pcx),
        NodeKind::Closure | NodeKind::Try | NodeKind::Interp => scan(pcx.nodes[n as usize].y, pcx),
        NodeKind::VecOp => {
            scan(pcx.nodes[n as usize].a, pcx);
            scan_list(n, pcx);
        }
        _ => {}
    }
}

// A call: its arguments in order; a loan (`&place`, a borrowed pointer
// passed on, a view read out of a place: `p.text`) is checked against the
// pending ones, then pending itself. A view of a static pending while a
// nested call runs (it may write statics) needs the walk.
fn scan_call(n: i64, pcx: &mut Ctx<Comp>) {
    if pcx.static_views > 0 {
        pcx.need = true;
        return;
    }
    if pcx.nodes[n as usize].x - 1 < 0 {
        scan(pcx.nodes[n as usize].a, pcx);
    }
    let mark = pcx.roots.count;
    let statics = pcx.static_views;
    for i in 0..pcx.nodes[n as usize].count {
        let arg = child(n, i, pcx);
        let k = pcx.nodes[arg as usize].kind;
        let mut r: i64 = -1;
        if k == NodeKind::Unary && pcx.nodes[arg as usize].op == crate::front::lexer::Tok::Amp {
            scan(pcx.nodes[arg as usize].b, pcx);
            r = place_root(pcx.nodes[arg as usize].b, pcx);
        }
        else if k == NodeKind::Ident && pcx.nodes[arg as usize].res == Res::Local
            && pcx.nodes[arg as usize].y >= 0 && pcx.locals[pcx.nodes[arg as usize].y as usize].borrow
            && pcx.nodes[arg as usize].ty > 0
            && pcx.types[pcx.nodes[arg as usize].ty as usize].kind == TyKind::Ptr {
            r = 2 * pcx.nodes[arg as usize].y;
        } else {
            r = view_arg(arg, pcx);
            if r == -2 {
                scan(arg, pcx);
                r = -1;
            } else if r >= 0 && (r & 1) == 1 {
                pcx.static_views += 1;
            }
        }
        if pcx.need {
            break;
        }
        if r >= 0 {
            loan(r, pcx);
            pcx.roots.push(r);
        }
    }
    pcx.roots.count = mark;
    pcx.static_views = statics;
}

// An argument that is a view (not owned) read out of a place, or one that
// holds no views of anything (raw_view): its parts scanned, then its root
// (a loan for the call: the walk's pending view), -1 for none; -2: another
// kind of argument.
fn view_arg(arg: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let t = pcx.nodes[arg as usize].ty;
        if t <= 0 || !tracked(t, pcx) || (*pcx.memo.add(t as usize)) != 3 {
            return -2;
        }
        if raw_view(arg, pcx) {
            scan_node(arg, pcx);
            return -1;
        }
        let r = place_root(arg, pcx);
        if r < 0 {
            return -2;
        }
        scan_node(arg, pcx);
        r
    }
}
