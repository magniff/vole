// Views and exclusivity: the walk's view events (0.17, docs/design/
// value-semantics.md §2.4, §4 step 4). T2 owns this file, calls.vl,
// fast.vl and observe.vl.
//
// A slot (state.vl) is a view-holding local: its origin (level 1, what
// its views point into; level 2, what those hold), its flags and the node
// that invalidated it. The rules:
// - a write, move, drop or `&mut` of a place invalidates the slots whose
//   origin overlaps it (invalidate); a read of a place invalidates the
//   slots holding an exclusive loan on it (F_MUTLOAN);
// - liveness is implicit: using an invalidated slot is the finding,
//   reported at the node that invalidated it, once per slot (use_slot);
// - a reborrow (`let out = acc[..]`, `let q = &mut *p`, a `&mut` local
//   passed on) is a child slot (SLOT_PARENT): writing through it leaves its
//   parents valid; using a parent ends its `&mut` children;
// - places under a reference local are paths into its referent: a write
//   that reaches a reference's referent reaches every path under it
//   (close_mask);
// - a scope's end invalidates the views of its locals: a later use, a
//   block value, a result or a store into a `&mut` parameter that views
//   one is own.escape;
// - a write through `&T` or `[T]` is own.readonly (U2).
// An origin holding the mark place (state::mark_place) came in part from
// an assumed (top) summary: its conflicts are warnings (design §7 V3)
// until T3's inferred summaries replace the fallback. Findings inside
// std's own functions are not reported (std is trusted code; T4).

use crate::base::{SRC, SYMS, buf_bytes, buf_new, buf_slice, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, buf_tool_command};
use crate::front::ast::{NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::own::ctx::OwnCx;
use crate::front::own::diag::{
    OWN_CONFLICT, OWN_ESCAPE, OWN_READONLY, OWN_STATIC, own_begin, own_bytes, own_end, own_help,
    own_pos, own_soft, own_str, own_sym, own_try, own_type,
};
use crate::front::own::kinds::{P_MUT, is_owned_type, is_view_type, param_mode};
use crate::front::own::state::{
    DEREF_FIELD, F_INVALID, F_SCOPE, F_STATIC, PE, PE_BY, PE_INVALID, PE_KIND, PE_OV, PK_NONE,
    PK_RAW, RK_LOCAL, RK_MARK, RK_ROOT, RK_STATIC, TUPLE_FIELD, any_and, at, child_place, clear_bit,
    field_number, get_bit, is_deref_place, is_empty, l1, l2, local_place, mark_place, new_ov,
    or_expanded, or_into, ov_hits, ov_inner, ov_or, root_of, root_place, set_bit, slot_for,
    slot_of_local, slot_of_place, slot_off,
};
use crate::front::own::summary::{closure_param, env_param};
use crate::front::own::walk::{W_DROP, W_MOVE, W_MUT_BORROW};
use crate::front::types::{REF_MUT, REF_SHARED, TYPES, TyKind};

// ---------------------------------------------------------------------------
// Flags and the per-walk tables

// The slot holds an exclusive loan (its type is `&mut T`, `&mut [T]`, or
// holds one): a read of what it views ends it.
pub const F_MUTLOAN: i64 = 8;
// How a slot was invalidated (bits 8-11 of its flags), for the messages.
const HOW_SHIFT: i64 = 8;

// The place the invalidation hit, + 1 (bits 16-25), for the messages.
const HIT_SHIFT: i64 = 16;
pub const H_WRITE: i64 = 1;
pub const H_MOVE: i64 = 2;
pub const H_DROP: i64 = 3;
pub const H_MUT: i64 = 4;
pub const H_READ: i64 = 5;
pub const H_CALL: i64 = 6;
pub const H_GLOBAL: i64 = 7;
pub const H_SCOPE: i64 = 8;
pub const H_PARENT: i64 = 9;

fn slot_note(s: i64, bind: i64, init: i64, ocx: inout OwnCx) {
    unsafe {
        while ocx.slot_bind.count <= s {
            ocx.slot_bind.push(0);
            ocx.slot_init.push(0);
        }
        if bind >= 0 {
            ocx.slot_bind.data[s] = bind;
        }
        if init >= 0 {
            ocx.slot_init.data[s] = init;
        }
    }
}

fn slot_bind(s: i64, ocx: OwnCx) -> i64 {
    unsafe { if s < ocx.slot_bind.count { ocx.slot_bind.data[s] } else { 0 } }
}

fn slot_init(s: i64, ocx: OwnCx) -> i64 {
    unsafe { if s < ocx.slot_init.count { ocx.slot_init.data[s] } else { 0 } }
}

// Whether node n was reported in this walk; marks it.
pub fn seen(n: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let key = pcx.nodes[n].start * 16 + 1;
        for i in 0..ocx.views_reported.count {
            if ocx.views_reported.data[i] == key {
                return true;
            }
        }
        ocx.views_reported.push(key);
        false
    }
}

// ---------------------------------------------------------------------------
// Types

fn is_ptr(t: i64) -> bool {
    t > 0 && TYPES[t].kind == TyKind::Ptr
}

// Whether a value of type t holds an exclusive loan (kinds::holds_inout).
pub fn holds_mut(t: i64, depth: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) -> bool {
    if depth > 3 || t <= 0 {
        return false;
    }
    let k = t & 63;
    if ocx.hm_gen[k] == ocx.hm_now && ocx.hm_type[k] == t {
        return ocx.hm_val[k];
    }
    let m = ocx.holds_memo.get(t + 1);
    let v = if m != 0 { m == 2 } else { crate::front::own::kinds::holds_inout(t, pcx) };
    if m == 0 {
        ocx.holds_memo.put(t + 1, if v { 2 } else { 1 });
    }
    ocx.hm_type[k] = t;
    ocx.hm_gen[k] = ocx.hm_now;
    ocx.hm_val[k] = v;
    v
}

// The flags a slot of local l starts with.
fn start_flags(l: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let t = pcx.locals[l].ty;
        if is_ptr(t) {
            ocx.any_ref = true;
        }
        if holds_mut(t, 0, &ocx, pcx) {
            ocx.any_mut = true;
            return F_MUTLOAN;
        }
        0
    }
}

// Whether slot local l is a reference (its places are paths into what it
// points to).
fn is_ref_slot(s: i64, ocx: OwnCx, pcx: Ctx<Comp>) -> bool {
    unsafe { is_ptr(pcx.locals[ocx.slot_local.data[s]].ty) }
}

// ---------------------------------------------------------------------------
// Invalidation

// Whether slot a is s or an ancestor of s (by reborrow).
fn is_slot_ancestor(a: i64, s: i64, ocx: OwnCx) -> bool {
    unsafe {
        if s < 0 {
            return false;
        }
        var p = s;
        var steps = 0;
        while p >= 0 && steps < 32 {
            if p == a {
                return true;
            }
            p = ocx.slot_parent.data[p];
            steps += 1;
        }
        false
    }
}

// Mask m (NW words, already expanded) also covers the paths under every
// reference whose referent it reaches: a write to x reaches `r.f` for
// `let r = &mut x`.
pub fn close_mask(m: *i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if !ocx.any_ref {
            return;
        }
        var round = 0;
        var grew = true;
        while grew && round < 4 {
            grew = false;
            for s in 0..ocx.nslot {
                if !is_ref_slot(s, ocx, pcx) {
                    continue;
                }
                let l = ocx.slot_local.data[s];
                if l >= ocx.loc_cap || ocx.loc_pl[l] == 0 {
                    continue;
                }
                let lp = ocx.loc_pl[l] - 1;
                if get_bit(m, lp) {
                    continue;
                }
                if any_and(l1(slot_off(ocx.cur, s, ocx), &ocx), m, ocx) {
                    or_into(m, &ocx.pl_mask[lp * ocx.nw], ocx);
                    grew = true;
                }
            }
            round += 1;
        }
    }
}

// Invalidates the slots viewing a place of mask m (how: H_*, reason: the
// node, or -(l + 1) for local l's scope end), except slot `except` and
// its ancestors; and the pending arguments PEND[..pend_end] viewing one.
pub fn invalidate(m: *i64, reason: i64, how: i64, except: i64, pend_end: i64, ocx: inout OwnCx) {
    unsafe {
        for s in 0..ocx.nslot {
            if except >= 0 && is_slot_ancestor(s, except, ocx) {
                continue;
            }
            let off = slot_off(ocx.cur, s, ocx);
            if !ov_hits(off, m, &ocx) {
                continue;
            }
            let fl = off + ocx.ov;
            if (ocx.pool[fl] & F_INVALID) == 0 {
                ocx.pool[fl + 1] = reason;
                ocx.pool[fl] = (ocx.pool[fl] & ~(15 << HOW_SHIFT) & ~(1023 << HIT_SHIFT))
                    | (how << HOW_SHIFT) | F_INVALID;
                let hit = first_place(off, m, &ocx);
                if hit >= 0 && hit < 1023 {
                    ocx.pool[fl] |= (hit + 1) << HIT_SHIFT;
                }
                if how == H_GLOBAL {
                    ocx.pool[fl] |= F_STATIC;
                }
                if how == H_SCOPE || how == H_DROP {
                    ocx.pool[fl] |= F_SCOPE;
                }
            }
        }
        var e = 0;
        while e < pend_end {
            let k = ocx.pend.data[e + PE_KIND];
            let o = ocx.pend.data[e + PE_OV];
            if k != PK_NONE && k != PK_RAW && o >= 0 && ocx.pend.data[e + PE_INVALID] == 0
                && ov_hits(o, m, &ocx) {
                ocx.pend.data[e + PE_INVALID] = how;
                ocx.pend.data[e + PE_BY] = reason;
            }
            e += PE;
        }
    }
}

// Invalidates what a write to place p reaches.
fn write_place(p: i64, n: i64, how: i64, except: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        let m = new_ov(&ocx);
        or_into(at(m, &ocx), &ocx.pl_mask[p * ocx.nw], ocx);
        close_mask(at(m, &ocx), &ocx, pcx);
        // (a drop is never one of a call's own arguments changing what an
        // earlier one borrows: the locals a scope drops inside an argument
        // were declared there, after the pending ones; a jump out of the
        // argument, `?` or `return`, drops the older ones but skips the call)
        invalidate(at(m, &ocx), n, how, except, if how == H_DROP { 0 } else { ocx.pend.count },
            &ocx);
        ocx.pool_top = m;
    }
}

// ---------------------------------------------------------------------------
// Messages

// (0.25) The statement ends: the temporaries made in it since
// walk::TEMPS[mark..] die; a later use of a view of one is own.escape.
pub fn kill_temps(mark: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        let n = ocx.temps.count;
        if n <= mark {
            return;
        }
        let m = new_ov(&ocx);
        for i in mark..n {
            or_into(at(m, &ocx), &ocx.pl_mask[ocx.temps.data[i] * ocx.nw], ocx);
        }
        close_mask(at(m, &ocx), &ocx, pcx);
        let first = ocx.temps.data[mark];
        invalidate(at(m, &ocx), ocx.pl_rid[first], H_DROP, -1, 0, &ocx);
        ocx.pool_top = m;
        ocx.temps.count = mark;
    }
}

// (0.25) Slot s's value now holds what origin v views: at both levels
// (where in it is not known), minus loans on s's own local.
pub fn store_deep(s: i64, v: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if s < 0 || v < 0 {
            return;
        }
        let m = new_ov(&ocx);
        crate::front::own::calls::deep_into(m, v, &ocx);
        let own = local_place(ocx.slot_local.data[s], &ocx, pcx);
        for q in 0..ocx.pl_count {
            if own >= 0 && root_of(q, ocx) == own {
                clear_bit(l1(m, &ocx), q);
                clear_bit(l2(m, &ocx), q);
            }
        }
        let so = slot_off(ocx.cur, s, ocx);
        let lt = pcx.locals[ocx.slot_local.data[s]].ty;
        if is_ptr(lt) || lt > 0 && TYPES[lt].kind == TyKind::Slice {
            // (a reference, a slice: its level 1 is what it points to, and
            // a write through it writes that; what is stored is held there)
            or_into(l2(so, &ocx), l1(m, &ocx), ocx);
            or_into(l2(so, &ocx), l2(m, &ocx), ocx);
        } else {
            or_into(l1(so, &ocx), l1(m, &ocx), ocx);
            or_into(l2(so, &ocx), l2(m, &ocx), ocx);
        }
        ocx.pool_top = m;
    }
}

// (0.25) A store of origin v into slot s reaches the locals s holds loans
// on (the locals at its level 1: `r = &mut v; r.push(w)`, a match's `&`
// binding, `m = v.as_mut_slice(); m[0] = w`): each holds v too, at both
// levels; through references to references, a few deep.
pub fn store_through_loans(s: i64, v: i64, depth: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if s < 0 || v < 0 || depth > 4 {
            return;
        }
        // (only a reference or a slice points to what it stores into: the
        // level 1 of an owned container, a Vec<[u8]>, is what its elements
        // view, not where a store into it goes)
        let lt = pcx.locals[ocx.slot_local.data[s]].ty;
        if !(is_ptr(lt) || lt > 0 && TYPES[lt].kind == TyKind::Slice) {
            return;
        }
        let so = slot_off(ocx.cur, s, ocx);
        for p in 0..ocx.pl_count {
            if !get_bit(l1(so, &ocx), p) {
                continue;
            }
            let r = root_of(p, ocx);
            if ocx.pl_rkind[r] != RK_LOCAL {
                continue;
            }
            let t = slot_of_local(ocx.pl_rid[r], ocx);
            if t < 0 || t == s {
                continue;
            }
            store_deep(t, v, &ocx, pcx);
            store_through_loans(t, v, depth + 1, &ocx, pcx);
        }
    }
}

// (0.25) A write at node n into a place reached through a view value of
// origin o, which has no place of its own (`v[i] = w`, `v.as_mut_slice()
// [i]`): the places at o's level 1 are written, and (v >= 0: a store of
// origin v) the locals they belong to hold v.
pub fn write_through_value(o: i64, n: i64, v: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if o < 0 {
            return;
        }
        for p in 0..ocx.pl_count {
            if !get_bit(l1(o, &ocx), p) {
                continue;
            }
            let r = root_of(p, ocx);
            if ocx.pl_rkind[r] != RK_LOCAL {
                // (the loans are the places written: a parameter's root at
                // level 1 is what the container's own views point into, an
                // arena a Vec<T, ScopedArena> is in, not its elements)
                continue;
            }
            // (written through r: a reference r, `self.v[i] = x`, stays
            // valid, as a write through it does, on_assign)
            write_place(p, n, H_WRITE, slot_of_place(r, ocx), &ocx, pcx);
            if v >= 0 {
                let t = slot_of_local(ocx.pl_rid[r], ocx);
                if t >= 0 {
                    store_deep(t, v, &ocx, pcx);
                    store_through_loans(t, v, 1, &ocx, pcx);
                }
            }
        }
    }
}

fn src_of(n: i64, pcx: Ctx<Comp>) -> [u8] {
    let s = pcx.nodes[n].start;
    var e = pcx.nodes[n].end;
    if e <= s {
        return "";
    }
    var i = s;
    while i < e {
        if SRC[i] == '\n' {
            e = i;
        }
        i += 1;
    }
    if e - s > 60 {
        e = s + 60;
    }
    SRC[s..e]
}

// 'TEXT' of node n.
pub fn own_src(n: i64, pcx: Ctx<Comp>) {
    own_str(c"'", pcx);
    own_bytes(src_of(n, pcx), pcx);
    own_str(c"'", pcx);
}

// The name of place p: its root (a local, a static, `*p`), then its fields.
pub fn own_place(p: i64, ocx: OwnCx, pcx: Ctx<Comp>) {
    own_str(c"'", pcx);
    put_place(p, ocx, pcx);
    own_str(c"'", pcx);
}

fn put_place(p: i64, ocx: OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if ocx.pl_parent[p] >= 0 {
            put_place(ocx.pl_parent[p], ocx, pcx);
            let f = ocx.pl_field[p];
            if f == DEREF_FIELD {
                return;
            }
            own_str(c".", pcx);
            if f >= TUPLE_FIELD {
                let b = buf_new();
                crate::base::buf_int(b, field_number(f));
                own_bytes(buf_slice(b), pcx);
            } else {
                own_bytes(SYMS[f].text, pcx);
            }
            return;
        }
        let k = ocx.pl_rkind[p];
        if k == RK_LOCAL {
            own_bytes(SYMS[pcx.locals[ocx.pl_rid[p]].name].text, pcx);
        } else if k == RK_STATIC {
            own_bytes(SYMS[pcx.nodes[pcx.statics[ocx.pl_rid[p]].node].a].text, pcx);
        } else if k == RK_MARK {
            own_str(c"?", pcx);
        } else if k == crate::front::own::state::RK_TEMP {
            own_str(c"the temporary ", pcx);
            own_src(ocx.pl_rid[p], pcx);
        } else {
            if ocx.pl_field[p] == 1 {
                own_str(c"*", pcx);
            }
            own_bytes(SYMS[pcx.locals[ocx.pl_rid[p]].name].text, pcx);
        }
    }
}

// The first place of origin o (level 1, else 2) that is a local's, a
// static's or a parameter's; -1.
pub fn first_place(o: i64, m: *i64, ocx: inout OwnCx) -> i64 {
    unsafe {
        for q in 0..ocx.pl_count {
            if ocx.pl_rkind[root_of(q, ocx)] == RK_MARK {
                continue;
            }
            let hit = get_bit(l1(o, &ocx), q) || get_bit(l2(o, &ocx), q);
            if hit && (m == 0 as *i64 || get_bit(m, q)) {
                return q;
            }
        }
        -1
    }
}

// FILE:LINE:COL of position pos (or FILE:LINE), into buffer out.
pub fn put_loc(out: i64, pos: i64, col: bool, pcx: inout Ctx<Comp>) {
    let t = buf_new();
    buf_position(t, pos, &pcx);
    let s = buf_slice(t);
    // `FILE: line L, column C`
    var i = 0;
    while i + 7 < s.len as i64 && !(s[i] == ':' && s[i + 1] == ' ' && s[i + 2] == 'l') {
        i += 1;
    }
    buf_bytes(out, s[0..i]);
    var j = i + 7;
    buf_str(out, c":");
    while j < s.len as i64 && s[j] != ',' {
        buf_bytes(out, s[j..j + 1]);
        j += 1;
    }
    if col {
        buf_str(out, c":");
        j += 9;
        if j <= s.len as i64 {
            buf_bytes(out, s[j..]);
        }
    }
}

// `try: volec query own FILE:L:C` at node n.
fn try_query_own(n: i64, pcx: inout Ctx<Comp>) {
    let a = buf_new();
    buf_str(a, c"query own ");
    put_loc(a, pcx.nodes[n].start, true, &pcx);
    let t = buf_new();
    buf_tool_command(t, buf_slice(a), false, pcx);
    own_try(buf_slice(t), pcx);
}

// `try: volec edit patch FN --old OLD --new NEW` in function CUR_F.
fn try_patch(old: [u8], new: [u8], ocx: OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        let a = buf_new();
        buf_str(a, c"edit patch ");
        buf_bytes(a, SYMS[pcx.fns[ocx.cur_f].display].text);
        buf_str(a, c" --old '");
        buf_bytes(a, old);
        buf_str(a, c"' --new '");
        buf_bytes(a, new);
        buf_str(a, c"'");
        let t = buf_new();
        buf_tool_command(t, buf_slice(a), false, pcx);
        own_try(buf_slice(t), pcx);
    }
}

fn ends_with(s: [u8], t: *u8) -> bool {
    unsafe {
        var n = 0;
        while t[n] != 0 {
            n += 1;
        }
        if s.len as i64 < n {
            return false;
        }
        for i in 0..n {
            if s[s.len as i64 - n + i] != t[i] {
                return false;
            }
        }
        true
    }
}

fn verb(how: i64) -> *u8 {
    if how == H_WRITE { return c"writes"; }
    if how == H_MOVE { return c"moves"; }
    if how == H_DROP { return c"drops"; }
    if how == H_MUT { return c"takes an inout access to"; }
    if how == H_READ { return c"reads"; }
    if how == H_CALL { return c"may change"; }
    if how == H_PARENT { return c"uses"; }
    c"changes"
}

// Whether the walk reports findings (not in std's own functions, nor in a
// round the driver throws away).
fn reporting(n: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) -> bool {
    !ocx.quiet && !seen(n, &ocx, pcx)
}

// (0.22) Whether std's own functions are reported too: VOLE_OWN_STD=1
// (tests/std_own.sh, which runs the own pass over std and fails on any
// finding).
fn own_std(ocx: inout OwnCx) -> bool {
    unsafe {
        if ocx.own_std < 0 {
            let v = crate::base::getenv(c"VOLE_OWN_STD");
            ocx.own_std = if v != 0 as *u8 && v[0] == '1' { 1 } else { 0 };
        }
        ocx.own_std == 1
    }
}

// Whether local l is the checker's own: a desugaring's (`__t`, `__out`,
// `__b` of format_in; `__f`, `__a0` of a derived impl) or an f-string
// hole's (`=f0`, `==l`). Its views and loans are the desugaring's, which
// std's raw code keeps right: a finding on them would name nothing the
// program wrote, so none is reported. A `for` loop's `__for_seq` is the
// user's sequence and stays. What decides is where the local was bound
// (note_binding), never its name alone: a program's own `let __out` is
// checked like any local.
pub fn hidden_local(l: i64, ocx: OwnCx, pcx: Ctx<Comp>) -> bool {
    unsafe {
        l >= 0 && l < ocx.gen_cap && ocx.gen[l] == 1 && pcx.locals[l].name != ocx.views_sym_for_seq
    }
}

// Local l is bound by node n (a pattern, a parameter): it is the
// checker's when its name is one a program cannot write there: `=f0`, or
// a `__` name that is not the text at n's position (the checker made the
// binding: an f-string's block, a derived impl's text, a `for` loop).
fn note_binding(l: i64, n: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if l < 0 || n <= 0 {
            return;
        }
        if l >= ocx.gen_cap {
            let c = l * 2 + 1024;
            let a = crate::base::alloc_array::<u8>(c);
            for i in 0..ocx.gen_cap {
                a[i] = ocx.gen[i];
            }
            ocx.gen = a;
            ocx.gen_cap = c;
        }
        let name = SYMS[pcx.locals[l].name].text;
        var gen = false;
        if name.len >= 1 && name[0] == '=' {
            gen = true;
        } else if name.len >= 2 && name[0] == '_' && name[1] == '_' {
            var s = pcx.nodes[n].start;
            // (`mut x`: the name after it)
            if pcx.nodes[n].end - s > 4 && SRC[s] == 'm' && SRC[s + 1] == 'u' && SRC[s + 2] == 't'
                && (SRC[s + 3] == ' ' || SRC[s + 3] == '\t') {
                s += 3;
                while s < pcx.nodes[n].end && (SRC[s] == ' ' || SRC[s] == '\t') {
                    s += 1;
                }
            }
            gen = pcx.nodes[n].end - s < name.len as i64;
            var i = 0;
            while !gen && i < name.len as i64 {
                if SRC[s + i] != name[i] {
                    gen = true;
                }
                i += 1;
            }
        }
        ocx.gen[l] = if gen { 1 } else { 2 };
    }
}

// Whether place p's root is a hidden local (or one of its roots).
pub fn hidden_place(p: i64, ocx: OwnCx, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if p < 0 {
            return false;
        }
        let r = root_of(p, ocx);
        (ocx.pl_rkind[r] == RK_LOCAL || ocx.pl_rkind[r] == RK_ROOT)
            && hidden_local(ocx.pl_rid[r], ocx, pcx)
    }
}

// Slot s, invalidated, is used at node n: the finding.
fn report_invalid(s: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let off = slot_off(ocx.cur, s, ocx);
        let flags = ocx.pool[off + ocx.ov];
        let reason = ocx.pool[off + ocx.ov + 1];
        let how = (flags >> HOW_SHIFT) & 15;
        let l = ocx.slot_local.data[s];
        let at_node = if reason > 0 { reason } else { n };
        let hit = (flags >> HIT_SHIFT) & 1023;
        let what = if hit > 0 { hit - 1 } else { first_place(off, 0 as *i64, &ocx) };
        // (0.25: a view of a statement temporary, own/drops temp_make, is
        // reported naming it)
        let temp = if how == H_SCOPE
            || how == H_DROP { crate::front::own::drops::temp_source(what, ocx, pcx) }
            else { 0 };
        if hidden_local(l, ocx, pcx) || hidden_place(what, ocx, pcx) && temp == 0
            || !reporting(at_node, &ocx, pcx) {
            return;
        }
        let assumed = (any_and(l1(off, &ocx), at_mark(&ocx, pcx), ocx)
            || any_and(l2(off, &ocx), at_mark(&ocx, pcx), ocx));
        if pcx.locals[l].name == ocx.views_sym_for_seq && reason > 0 && how != H_GLOBAL {
            // (a `for` loop's sequence: §2.9 situation 4)
            own_begin(at_node, OWN_CONFLICT, &pcx);
            own_src(reason, pcx);
            own_str(c" ", pcx);
            own_str(verb(how), pcx);
            own_str(c" the elements of ", pcx);
            if what >= 0 {
                own_place(what, ocx, pcx);
            } else {
                own_str(c"the sequence", pcx);
            }
            own_str(c" while the 'for' at ", pcx);
            own_pos(n, &pcx);
            own_str(c" iterates over them", pcx);
            own_help(c"loop over the indexes (the loop sees the elements present when it starts), or collect the new elements and append them after the loop", pcx);
            try_for_index(n, ocx, pcx);
        } else if (flags & F_STATIC) != 0 && how == H_GLOBAL {
            own_begin(at_node, OWN_STATIC, &pcx);
            own_src(reason, pcx);
            own_str(c" writes statics (its effects include global) while ", pcx);
            own_sym(pcx.locals[l].name, pcx);
            put_bound_at(s, ocx, &pcx);
            own_str(c" views ", pcx);
            if what >= 0 {
                own_place(what, ocx, pcx);
            } else {
                own_str(c"a static", pcx);
            }
            own_str(c"; ", pcx);
            own_sym(pcx.locals[l].name, pcx);
            own_str(c" is used at ", pcx);
            own_pos(n, &pcx);
            own_help(c"copy the plain value out of the static first, or take the view again after the call", pcx);
            try_query_own(n, &pcx);
        } else if how == H_SCOPE || how == H_DROP {
            own_begin(n, OWN_ESCAPE, &pcx);
            own_sym(pcx.locals[l].name, pcx);
            own_str(c" is used here, but ", pcx);
            if temp > 0 {
                own_str(c"the temporary ", pcx);
                own_src(temp, pcx);
                own_str(c", which it views, was dropped at the end of its statement", pcx);
                if reason > 0 {
                    own_str(c" at ", pcx);
                    own_pos(reason, &pcx);
                }
                own_help(c"a temporary lives until its statement ends: bind it first, 'let x = VALUE;', in a block that lives as long as the view", pcx);
                try_query_own(n, &pcx);
                if assumed {
                    own_soft(&pcx);
                }
                own_end(&pcx);
                return;
            }
            if reason < 0 {
                own_sym(pcx.locals[0 - reason - 1].name, pcx);
            } else if what >= 0 {
                own_place(what, ocx, pcx);
            } else {
                own_str(c"what it views", pcx);
            }
            own_str(c", which it views, ", pcx);
            own_str(if how == H_DROP { c"was dropped" } else { c"went out of scope" }, pcx);
            if reason > 0 {
                own_str(c" at ", pcx);
                own_pos(reason, &pcx);
            }
            own_help(c"keep the owner alive as long as the view (declare it in an outer block), or keep a copy instead of the view", pcx);
            try_query_own(n, &pcx);
        } else {
            own_begin(at_node, OWN_CONFLICT, &pcx);
            if reason > 0 && how != H_READ {
                own_src(reason, pcx);
                own_str(c" ", pcx);
                own_str(verb(how), pcx);
                own_str(c" ", pcx);
            }
            if what >= 0 {
                own_place(what, ocx, pcx);
            } else {
                own_str(c"what it views", pcx);
            }
            if how == H_READ {
                own_str(c" is read", pcx);
            }
            own_str(c" while ", pcx);
            own_sym(pcx.locals[l].name, pcx);
            put_bound_at(s, ocx, &pcx);
            own_str(if (flags & F_MUTLOAN) != 0 { c" has an inout access to it; " }
                else { c" views it; " }, pcx);
            own_sym(pcx.locals[l].name, pcx);
            own_str(c" is used at ", pcx);
            own_pos(n, &pcx);
            if crate::front::closures::closure_of_type(pcx.locals[l].ty, pcx) > 0 {
                // (0.25) a closure holds its captures' accesses until its
                // last call (conventions.md §5.4)
                own_help(c"a closure holds what it captures until its last call: move this after that call, or pass the value to the closure as a parameter instead of capturing it", pcx);
            } else if how == H_READ {
                own_help(c"an inout access is the only way to its place while it is used: read through it, or end it (use it for the last time) before the read", pcx);
            } else {
                own_help(c"use the view before the change, keep an index instead of a view, or keep a copy", pcx);
            }
            let init = slot_init(s, ocx);
            if init > 0 && ends_with(src_of(init, pcx), c".as_slice()") {
                let old = src_of(init, pcx);
                let b = buf_new();
                buf_bytes(b, old[0..old.len as i64 - 11]);
                buf_str(b, c".clone()");
                try_patch(old, buf_slice(b), ocx, pcx);
            }
            try_query_own(n, &pcx);
        }
        if assumed {
            own_soft(&pcx);
        }
        own_end(&pcx);
    }
}

// ` (L:C)`: where slot s was bound.
fn put_bound_at(s: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) {
    let b = slot_bind(s, ocx);
    if b > 0 {
        own_str(c" (", pcx);
        own_pos(b, &pcx);
        own_str(c")", pcx);
    }
}

// The `try:` of §2.9 situation 4: `for x in v {` becomes an index loop.
fn try_for_index(n: i64, ocx: OwnCx, pcx: Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    var e = s;
    while e < pcx.nodes[n].end && SRC[e] != '{' && SRC[e] != '\n' {
        e += 1;
    }
    if e >= pcx.nodes[n].end || SRC[e] != '{' {
        return;
    }
    let head = SRC[s..e + 1];
    if head.len < 10 || head[0] != 'f' || head[1] != 'o' || head[2] != 'r'
        || head[3] != ' ' {
        return;
    }
    var k = 4;
    while k + 4 < head.len as i64 && !(head[k] == ' ' && head[k + 1] == 'i' && head[k + 2] == 'n'
        && head[k + 3] == ' ') {
        k += 1;
    }
    if k + 4 >= head.len as i64 {
        return;
    }
    let pat = head[4..k];
    var q = head.len as i64 - 1;
    while q > k + 4 && head[q - 1] == ' ' {
        q -= 1;
    }
    let seq = head[k + 4..q];
    let b = buf_new();
    buf_str(b, c"for i in 0..");
    buf_bytes(b, seq);
    buf_str(b, c".len() { let ");
    buf_bytes(b, pat);
    buf_str(b, c" = ");
    buf_bytes(b, seq);
    buf_str(b, c"[i];");
    try_patch(head, buf_slice(b), ocx, pcx);
}

// A mask holding only the mark place (empty when it has none yet).
fn at_mark(ocx: inout OwnCx, pcx: Ctx<Comp>) -> *i64 {
    let m = new_ov(&ocx);
    let p = mark_place(&ocx, pcx);
    if p >= 0 {
        set_bit(at(m, &ocx), p);
    }
    ocx.pool_top = m;
    at(m, &ocx)
}

// ---------------------------------------------------------------------------
// The events

// Slot s is used at node n: an invalidated slot is the finding; a `&mut`
// child of s ends, if it borrows what mask m covers (null: all; the place
// read through s: a field read leaves a view of another field alive).
pub fn use_slot(s: i64, n: i64, m: *i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let fl = slot_off(ocx.cur, s, ocx) + ocx.ov;
        if (ocx.pool[fl] & F_INVALID) != 0 {
            report_invalid(s, n, &ocx, &pcx);
            ocx.pool[fl] = ocx.pool[fl] & ~F_INVALID;
        }
        if ocx.any_child && ocx.any_mut {
            for q in 0..ocx.nslot {
                if q != s && is_slot_ancestor(s, q, ocx)
                    && (m == 0 as *i64 || any_and(l1(slot_off(ocx.cur, q, ocx), &ocx), m, ocx)) {
                    let qf = slot_off(ocx.cur, q, ocx) + ocx.ov;
                    if (ocx.pool[qf] & F_MUTLOAN) != 0 && (ocx.pool[qf] & F_INVALID) == 0 {
                        ocx.pool[qf + 1] = n;
                        ocx.pool[qf] = (ocx.pool[qf] & ~(15 << HOW_SHIFT)) | (H_PARENT << HOW_SHIFT)
                            | F_INVALID;
                    }
                }
            }
        }
    }
}

// The walk starts function f, its parameters bound (walk::PARAM_LOCALS):
// a parameter's slot views its roots (`p` at level 1, `*p` at level 2).
pub fn on_enter(f: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if ocx.views_sym_for_seq == 0 {
            ocx.views_sym_for_seq = crate::base::intern_c(c"__for_seq");
        }
        ocx.views_reported.count = 0;
        ocx.slot_bind.count = 0;
        ocx.slot_init.count = 0;
        ocx.any_mut = false;
        ocx.any_ref = false;
        ocx.any_child = false;
        ocx.captures_stored = 0;
        ocx.last_read_node = 0;
        // (0.27.0: a rust-edition function's views and loans are borrowck's)
        ocx.rust = pcx.edition != 0
            && crate::front::rust::rust_at(pcx.nodes[pcx.fns[f].node].start, &pcx);
        ocx.quiet = within_std(pcx.fns[f].module, pcx) && !own_std(&ocx) || ocx.rust;
        for i in 0..ocx.param_locals.count {
            let l = ocx.param_locals.data[i];
            if l < 0 {
                continue;
            }
            note_binding(l, crate::front::ast::child(pcx.fns[f].node, i, pcx), &ocx, pcx);
            let t = pcx.locals[l].ty;
            var s = slot_of_local(l, ocx);
            let env = env_param(f, i, &pcx);
            if s < 0 && is_ptr(t) && (param_mode(f, i, pcx) == P_MUT || env)
                && is_view_type(TYPES[t].a, &pcx) {
                // (a legacy `*T` parameter to what holds views, or a
                // closure's env: its referent's views are tracked, for the
                // stores)
                s = slot_for(l, true, &ocx, pcx);
            }
            if s < 0 {
                continue;
            }
            let off = slot_off(ocx.cur, s, ocx);
            let a = root_place(l, false, &ocx, pcx);
            let b = root_place(l, true, &ocx, pcx);
            if a >= 0 {
                set_bit(l1(off, &ocx), a);
            }
            if b >= 0 {
                set_bit(l2(off, &ocx), b);
            }
            ocx.pool[off + ocx.ov] = start_flags(l, &ocx, pcx);
            if is_ptr(t) && pcx.locals[l].ty > 0 && TYPES[t].b == 0 {
                ocx.any_ref = true;
                if param_mode(f, i, pcx) == P_MUT || env {
                    ocx.any_mut = true;
                    ocx.pool[off + ocx.ov] |= F_MUTLOAN;
                }
            }
        }
    }
}

// Slot s gains the views of origin v by a store or an assignment through
// it: when s is a closure's (the walked closure's env, or a parameter
// holding a closure), CAPTURES_STORED notes it.
pub fn note_env_store(s: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if v < 0 || ocx.slot_local.data[s] < 0
            || is_empty(l1(v, &ocx), ocx) && is_empty(l2(v, &ocx), ocx) {
            return;
        }
        let l = ocx.slot_local.data[s];
        for i in 0..ocx.param_locals.count {
            if ocx.param_locals.data[i] == l && i < 63 && i < pcx.fns[ocx.cur_f].param_count
                && (env_param(ocx.cur_f, i, &pcx) || closure_param(ocx.cur_f, i, &pcx)) {
                ocx.captures_stored |= 1 << i;
                crate::front::own::infer::col_stored(v, ocx, &pcx);
            }
        }
    }
}

// The walked closure's env slot (summary::env_param), or -1.
pub fn env_slot(ocx: OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if ocx.param_locals.count == 0 || ocx.param_locals.data[0] < 0
            || !env_param(ocx.cur_f, 0, &pcx) {
            return -1;
        }
        slot_of_local(ocx.param_locals.data[0], ocx)
    }
}

// Place p is read, or borrowed, at node n: an invalidated slot used here
// is the finding; a slot's `&mut` loan on p ends. (A pending `&mut`
// argument is two-phase, as a receiver is: a plain read of its place in a
// later argument is fine, `f(&mut v, v.len())`; a later argument that
// keeps a view of it overlaps it at the call, calls.vl.)
pub fn on_read(p: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        crate::front::own::observe::at(n, &ocx, &pcx);
        ocx.last_read_node = n;
        ocx.last_read_place = p;
        if ocx.nslot == 0 {
            return;
        }
        let s = slot_of_place(p, ocx);
        if s >= 0 {
            use_slot(s, n, &ocx.pl_mask[p * ocx.nw], &ocx, &pcx);
        }
        if ocx.any_mut {
            let m = &ocx.pl_mask[p * ocx.nw];
            for q in 0..ocx.nslot {
                if q == s || is_slot_ancestor(q, s, ocx) || is_slot_ancestor(s, q, ocx) {
                    continue;
                }
                let off = slot_off(ocx.cur, q, ocx);
                let fl = off + ocx.ov;
                if (ocx.pool[fl] & F_MUTLOAN) != 0 && (ocx.pool[fl] & F_INVALID) == 0
                    && any_and(l1(off, &ocx), m, ocx) {
                    ocx.pool[fl + 1] = n;
                    ocx.pool[fl] = (ocx.pool[fl] & ~(15 << HOW_SHIFT)) | (H_READ << HOW_SHIFT)
                        | F_INVALID;
                }
            }
        }
    }
}

// Place p is written, moved, dropped or mutably borrowed at node n (how:
// walk::W_*): the views of it are invalid from here.
pub fn on_write(p: i64, n: i64, how: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    crate::front::own::observe::at(n, &ocx, &pcx);
    // (p < 0: no place, a local past the bitsets' room, PL_OVERFLOW; the
    // walk is redone wider. A local with no place was never borrowed in
    // this walk: no slot views it, so there is nothing to invalidate)
    if p < 0 || ocx.nslot == 0 && ocx.pend.count == 0 {
        return;
    }
    let h = if how == W_MOVE { H_MOVE } else if how == W_DROP { H_DROP }
        else if how == W_MUT_BORROW { H_MUT } else { H_WRITE };
    let except = if how == W_MUT_BORROW { slot_of_place(p, ocx) } else { -1 };
    // (a `&mut` of a slot's own place, or a path through a reference:
    // the slot itself stays valid)
    write_place(p, n, h, if ocx.po_deref { except } else { -1 }, &ocx, pcx);
}

// `&p` (kind REF_SHARED) or `&mut p` (REF_MUT) at node n; raw: reached
// through a raw pointer. dst (-1: none) gets the loan, and at level 2
// what p holds. An Ident n is a reference local passed on to a call (an
// implicit reborrow): dst gets what it views, and its own place (the
// paths through it).
pub fn on_borrow(p: i64, n: i64, kind: i64, raw: bool, dst: i64, ocx: inout OwnCx,
    pcx: inout Ctx<Comp>) {
    unsafe {
        crate::front::own::observe::at(n, &ocx, &pcx);
        if raw || dst < 0 || p < 0 {
            return;
        }
        if pcx.nodes[n].kind == NodeKind::Ident && pcx.nodes[n].res == Res::Local {
            let s = slot_of_local(pcx.nodes[n].y, ocx);
            if s >= 0 {
                ov_or(dst, slot_off(ocx.cur, s, ocx), &ocx);
            }
            // (0.18.1: what it points to, DEREF_FIELD, not its own storage)
            let d = child_place(p, DEREF_FIELD, &ocx, pcx);
            set_bit(l1(dst, &ocx), if d >= 0 { d } else { p });
            return;
        }
        // (0.20) `&*r` or `*r` of an access r (a use of it, names::
        // access_use): a reborrow, as r passed on is: dst gets what r
        // views, and the place r designates
        var id = n;
        if pcx.nodes[id].kind == NodeKind::Unary && pcx.nodes[id].op == Tok::Amp
            && pcx.nodes[id].b > 0 {
            id = pcx.nodes[id].b;
        }
        if pcx.nodes[id].kind == NodeKind::Unary && pcx.nodes[id].op == Tok::Star
            && pcx.nodes[id].b > 0 {
            let r = pcx.nodes[id].b;
            if pcx.nodes[r].kind == NodeKind::Ident && pcx.nodes[r].res == Res::Local
                && pcx.nodes[r].y >= 0
                && pcx.locals[pcx.nodes[r].y].access {
                let s = slot_of_local(pcx.nodes[r].y, ocx);
                if s >= 0 && !pcx.locals[pcx.nodes[r].y].is_param {
                    // (a parameter's place lives for the call: `*r` stays a
                    // place of its own, below)
                    ov_or(dst, slot_off(ocx.cur, s, ocx), &ocx);
                    return;
                }
            }
        }
        set_bit(l1(dst, &ocx), p);
        let s = slot_of_place(p, ocx);
        if s >= 0 {
            let so = slot_off(ocx.cur, s, ocx);
            if ocx.po_inner || ocx.po_deref {
                // (inside what the slot points to)
                if ocx.po_inner {
                    or_into(l1(dst, &ocx), l1(so, &ocx), ocx);
                }
                or_into(l2(dst, &ocx), l2(so, &ocx), ocx);
            } else {
                or_into(l2(dst, &ocx), l1(so, &ocx), ocx);
                or_into(l2(dst, &ocx), l2(so, &ocx), ocx);
            }
            return;
        }
        let r = root_of(p, ocx);
        if ocx.pl_rkind[r] == RK_LOCAL && pcx.locals[ocx.pl_rid[r]].is_param && ocx.po_deref {
            let t = pcx.nodes[n].ty;
            if t > 0 && (TYPES[t].kind == TyKind::Ptr || TYPES[t].kind == TyKind::Slice)
                && is_view_type(TYPES[t].a, &pcx) {
                let q = root_place(ocx.pl_rid[r], true, &ocx, pcx);
                if q >= 0 {
                    set_bit(l2(dst, &ocx), q);
                }
            }
        }
    }
}

// The value read out of place p at node n, of type ty: dst gets the views
// it holds (walk::PO_* say how p was reached).
pub fn on_value(p: i64, n: i64, ty: i64, dst: i64, ocx: inout OwnCx, pcx: Ctx<Comp>) {
    unsafe {
        if ocx.po_raw {
            return;
        }
        let r0 = root_of(p, ocx);
        if ocx.po_deref && ty > 0 && TYPES[ty].kind == TyKind::Ptr && TYPES[ty].b == 0
            && ocx.pl_rkind[r0] == RK_LOCAL && pcx.locals[ocx.pl_rid[r0]].is_param {
            // (a raw pointer read out of what a parameter points to: into
            // storage that referent owns, `p`: how std's `as_slice` views
            // `self`)
            set_bit(l1(dst, &ocx), p);
            let q = root_place(ocx.pl_rid[r0], true, &ocx, pcx);
            if q >= 0 {
                set_bit(l2(dst, &ocx), q);
            }
            return;
        }
        let s = slot_of_place(p, ocx);
        if s >= 0 {
            let so = slot_off(ocx.cur, s, ocx);
            if ocx.po_inner || ocx.po_deref {
                ov_inner(dst, so, &ocx);
            } else {
                ov_or(dst, so, &ocx);
            }
            return;
        }
        let r = root_of(p, ocx);
        if ocx.pl_rkind[r] == RK_LOCAL && ocx.po_deref && pcx.locals[ocx.pl_rid[r]].is_param {
            let q = root_place(ocx.pl_rid[r], true, &ocx, pcx);
            if q >= 0 {
                set_bit(l1(dst, &ocx), q);
                set_bit(l2(dst, &ocx), q);
            }
        }
    }
}

// Local l bound at node n (a pattern) to a value of origin v (-1: none).
pub fn on_bind(l: i64, n: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        crate::front::own::observe::at(n, &ocx, &pcx);
        note_binding(l, n, &ocx, pcx);
        let s = slot_of_local(l, ocx);
        if s < 0 {
            return;
        }
        let off = slot_off(ocx.cur, s, ocx);
        for w in 0..ocx.ov + 2 {
            ocx.pool[off + w] = 0;
        }
        if v >= 0 {
            ov_or(off, v, &ocx);
        }
        ocx.pool[off + ocx.ov] = start_flags(l, &ocx, pcx);
        ocx.slot_parent.data[s] = -1;
        if ocx.bind_from != 0 {
            let ps = root_slot(ocx.bind_from, ocx, &pcx);
            if ps >= 0 && ps != s {
                ocx.slot_parent.data[s] = ps;
                ocx.any_child = true;
            }
        }
        slot_note(s, n, 0, &ocx);
    }
}

// The slot an expression's value comes from (a slot local, an element or
// a field of one, a reference to one), or -1.
fn root_slot(e: i64, ocx: OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident && pcx.nodes[e].res == Res::Local {
        return slot_of_local(pcx.nodes[e].y, ocx);
    }
    if k == NodeKind::Index || k == NodeKind::Cast || k == NodeKind::FieldAccess
        || k == NodeKind::TupleField {
        return root_slot(pcx.nodes[e].a, ocx, &pcx);
    }
    if k == NodeKind::Unary {
        return root_slot(pcx.nodes[e].b, ocx, &pcx);
    }
    if k == NodeKind::Call && pcx.nodes[e].count > 0 && is_view_type(pcx.nodes[e].ty, &pcx) {
        // (a view a method makes of its receiver, `v.as_mut_slice()`
        // of a reference `v`: a reborrow of it)
        return root_slot(child(e, 0, pcx), ocx, &pcx);
    }
    -1
}

// `let l = init;` after the binding: a view taken from a view local is a
// reborrow of it (SLOT_PARENT).
pub fn on_let(l: i64, init: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let s = slot_of_local(l, ocx);
        if s < 0 {
            return;
        }
        slot_note(s, -1, init, &ocx);
        let ps = root_slot(init, ocx, &pcx);
        if ps >= 0 && ps != s {
            ocx.slot_parent.data[s] = ps;
            ocx.any_child = true;
        }
    }
}

// A `for` over owned place p: the loop's sequence local l is p (the loop
// borrows it through its `as_slice()`, whose slot the loop reads at every
// step: a change of p in the body invalidates it).
pub fn on_for_alias(l: i64, p: i64, init: i64) {}

// Assignment n to place p, its value's origin v (walk::PO_* as the target
// left them: PO_VIEWSLOT, a write through a view).
pub fn on_assign(p: i64, n: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        crate::front::own::observe::at(n, &ocx, &pcx);
        let vs = ocx.po_viewslot;
        let inner = ocx.po_inner;
        let deref = ocx.po_deref;
        if ocx.po_raw {
            return;
        }
        if vs >= 0 {
            // A write through a slice: an exclusive use of what it views.
            let t = pcx.locals[ocx.slot_local.data[vs]].ty;
            if t > 0 && TYPES[t].kind == TyKind::Slice && TYPES[t].b != REF_MUT {
                readonly(n, ocx.slot_local.data[vs], t, &ocx, &pcx);
            }
            use_slot(vs, n, 0 as *i64, &ocx, &pcx);
            let so = slot_off(ocx.cur, vs, ocx);
            let m = new_ov(&ocx);
            or_expanded(at(m, &ocx), l1(so, &ocx), &ocx);
            close_mask(at(m, &ocx), &ocx, pcx);
            invalidate(at(m, &ocx), n, H_WRITE, vs, ocx.pend.count, &ocx);
            ocx.pool_top = m;
            if v >= 0 {
                or_into(l2(slot_off(ocx.cur, vs, ocx), &ocx), l1(v, &ocx), ocx);
                or_into(l2(slot_off(ocx.cur, vs, ocx), &ocx), l2(v, &ocx), ocx);
                store_through_loans(vs, v, 0, &ocx, pcx);
            }
            return;
        }
        let s = slot_of_place(p, ocx);
        if deref && s >= 0 {
            // Through a reference: `r.f = v`, `*r = v`.
            let l = ocx.slot_local.data[s];
            let t = pcx.locals[l].ty;
            if t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b == REF_SHARED {
                readonly(n, l, t, &ocx, &pcx);
            }
            // (a `&mut` child viewing another field stays: write_place
            // invalidates what views p)
            use_slot(s, n, &ocx.pl_mask[p * ocx.nw], &ocx, &pcx);
            write_place(p, n, H_WRITE, s, &ocx, pcx);
            note_env_store(s, v, &ocx, &pcx);
            if v >= 0 {
                or_into(l2(slot_off(ocx.cur, s, ocx), &ocx), l1(v, &ocx), ocx);
                or_into(l2(slot_off(ocx.cur, s, ocx), &ocx), l2(v, &ocx), ocx);
                store_through_loans(s, v, 0, &ocx, pcx);
            }
            return;
        }
        write_place(p, n, H_WRITE, -1, &ocx, pcx);
        let r = root_of(p, ocx);
        if ocx.pl_rkind[r] == RK_STATIC && v >= 0 && !deref {
            static_store(p, n, v, &ocx, &pcx);
        }
        if s >= 0 && !deref {
            let off = slot_off(ocx.cur, s, ocx);
            if ocx.pl_parent[p] < 0 && pcx.nodes[n].op == crate::front::lexer::Tok::Eq && !inner {
                for w in 0..ocx.ov + 2 {
                    ocx.pool[off + w] = 0;
                }
                ocx.pool[off + ocx.ov] = start_flags(ocx.slot_local.data[s], &ocx, pcx);
                ocx.slot_parent.data[s] = -1;
                slot_note(s, n, pcx.nodes[n].c, &ocx);
                if v >= 0 {
                    ov_or(off, v, &ocx);
                }
            } else if v >= 0 {
                ov_or(off, v, &ocx);
            }
        }
    }
}

// own.readonly for a `&mut` loan of place p at node n (a `&mut self`
// receiver, `&mut x` to a `&mut T` parameter), as for an assignment: p
// reached through a `&T` or a read-only `[T]` (walk::PO_* as the place
// left them).
pub fn on_mut_loan(p: i64, n: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if ocx.po_raw {
            return;
        }
        let nt = pcx.nodes[n].ty;
        if nt > 0 && TYPES[nt].kind == TyKind::Ptr {
            crate::front::own::moves::byref_change(p, n, TYPES[nt].a, ocx, &pcx);
        }
        let vs = ocx.po_viewslot;
        if vs >= 0 {
            let t = pcx.locals[ocx.slot_local.data[vs]].ty;
            if t > 0 && TYPES[t].kind == TyKind::Slice && TYPES[t].b != REF_MUT {
                readonly(n, ocx.slot_local.data[vs], t, &ocx, &pcx);
            }
            return;
        }
        let s = slot_of_place(p, ocx);
        if ocx.po_deref && s >= 0 {
            let l = ocx.slot_local.data[s];
            let t = pcx.locals[l].ty;
            if t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b == REF_SHARED {
                readonly(n, l, t, &ocx, &pcx);
            }
        }
    }
}

// own.readonly: assignment n writes through local l of type t (`&T`, `[T]`).
fn readonly(n: i64, l: i64, t: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if hidden_local(l, ocx, pcx)
            || !(reporting(n, &ocx, pcx) || ocx.rust && !seen(n, &ocx, pcx)) {
            return;
        }
        own_begin(n, OWN_READONLY, &pcx);
        // (0.20: in the conventions' words, but in a crate read in 0.19's)
        let words = crate::front::conv::strict_at(pcx.nodes[n].start, &pcx);
        own_str(c"writes through ", pcx);
        own_sym(pcx.locals[l].name, pcx);
        own_str(c", a '", pcx);
        own_type(t, pcx);
        own_str(c"', which is read-only", pcx);
        if words && TYPES[t].kind == TyKind::Slice {
            own_str(c" (a let view)", pcx);
            own_help(c"take the slice inout ('s: inout [T]', called with '&v' or '&a[..]') to change its elements", pcx);
        } else if words {
            own_str(c" (let: read-only)", pcx);
            own_help(c"take it inout ('x: inout T', called with '&x') to change it", pcx);
        } else if TYPES[t].kind == TyKind::Slice {
            own_help(c"take the slice inout ('s: inout [T]', called with '&v' or '&a[..]') to write its elements", pcx);
        } else {
            own_help(c"take it inout ('x: inout T', called with '&x') to write through it", pcx);
        }
        if pcx.locals[l].is_param {
            // (the parameter retyped, with every call)
            let a = buf_new();
            buf_str(a, c"refactor signature ");
            buf_bytes(a, SYMS[pcx.fns[ocx.cur_f].display].text);
            buf_str(a, c" --type ");
            buf_bytes(a, SYMS[pcx.locals[l].name].text);
            buf_str(a, c" 'inout ");
            if TYPES[t].kind == TyKind::Slice {
                buf_str(a, c"[");
                crate::front::types::buf_type(a, TYPES[t].a, pcx);
                buf_str(a, c"]");
            } else {
                crate::front::types::buf_type(a, TYPES[t].a, pcx);
            }
            buf_str(a, c"'");
            let tl = buf_new();
            buf_tool_command(tl, buf_slice(a), false, pcx);
            own_try(buf_slice(tl), pcx);
        }
        own_end(&pcx);
    }
}

// Static place p is assigned a value of origin v at node n: statics hold
// only views of static data (∅).
fn static_store(p: i64, n: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    let q = first_place(v, 0 as *i64, &ocx);
    // (0.25: a raw pointer is unsafe code's, which vouches for it)
    let vt = if pcx.nodes[n].kind == NodeKind::Assign { pcx.nodes[pcx.nodes[n].c].ty } else { 0 };
    if vt > 0 && !is_view_type(vt, &pcx) {
        return;
    }
    if q < 0 || hidden_place(q, ocx, pcx) || !reporting(n, &ocx, pcx) {
        return;
    }
    own_begin(n, OWN_ESCAPE, &pcx);
    own_place(root_of(p, ocx), ocx, pcx);
    own_str(c" would hold a view of ", pcx);
    own_place(q, ocx, pcx);
    own_str(c": statics hold only views of static data (literals)", pcx);
    own_help(c"store an owned copy (a Buf or a Vec), or an index", pcx);
    own_end(&pcx);
}

// A scope ends: the locals walk::BOUND[mark..] die. v is the origin of its
// value (-1: none), tail that value's node (0: none): a value viewing a
// dying local escapes.
pub fn on_scope_end(mark: i64, v: i64, tail: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        if ocx.nslot == 0 && v < 0 {
            return;
        }
        let m = new_ov(&ocx);
        var first = -1;
        for i in mark..ocx.bound.count {
            let l = ocx.bound.data[i];
            if l < ocx.loc_cap && ocx.loc_pl[l] != 0 {
                set_bit(at(m, &ocx), ocx.loc_pl[l] - 1);
                if first < 0 {
                    first = l;
                }
            }
        }
        if first < 0 {
            ocx.pool_top = m;
            return;
        }
        let mask = new_ov(&ocx);
        or_expanded(at(mask, &ocx), at(m, &ocx), &ocx);
        close_mask(at(mask, &ocx), &ocx, pcx);
        // (0.18.1) what a dying reference points to lives on: the views
        // through it, DEREF_FIELD, also hold what it views
        for q in 0..ocx.pl_count {
            if is_deref_place(q, ocx) && get_bit(at(m, &ocx), ocx.pl_parent[q]) {
                clear_bit(at(mask, &ocx), q);
            }
        }
        // (the pending arguments outlive the scope, write_place)
        invalidate(at(mask, &ocx), 0 - first - 1, H_SCOPE, -1, 0, &ocx);
        let body = pcx.nodes[pcx.fns[ocx.cur_f].node].c;
        if v >= 0 && tail != 0 && tail != pcx.nodes[body].a && ov_hits(v, at(mask, &ocx), &ocx)
            && !hidden_place(first_place(v, at(mask, &ocx), &ocx), ocx, pcx)
            && reporting(tail, &ocx, pcx) {
            let q = first_place(v, at(mask, &ocx), &ocx);
            own_begin(tail, OWN_ESCAPE, &pcx);
            own_str(c"the block's value views ", pcx);
            if q >= 0 {
                own_place(q, ocx, pcx);
            } else {
                own_str(c"a local", pcx);
            }
            own_str(c", which dies at the block's end", pcx);
            own_help(c"declare the owner before the block, or make the value an owned copy", pcx);
            own_end(&pcx);
        }
        ocx.pool_top = m;
    }
}

// The function's result at node e, origin v (-1: none): views of locals
// or of owned by-value parameters escape (own.escape); so do views of
// them stored into what a `&mut` parameter points to.
pub fn on_result(e: i64, v: i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    unsafe {
        let f = ocx.cur_f;
        let rt = pcx.fns[f].ret;
        if is_ptr(rt) && TYPES[rt].b != 0 && reporting(pcx.fns[f].node, &ocx, pcx) {
            own_begin(pcx.fns[f].node, OWN_ESCAPE, &pcx);
            own_sym(pcx.fns[f].display, pcx);
            own_str(c" returns a reference ('", pcx);
            own_type(rt, pcx);
            own_str(c"'): references as results come in 0.17.1", pcx);
            own_help(c"return the value (a copy, or '.clone()'), a view ('[T]'), or an index", pcx);
            own_end(&pcx);
        }
        if v >= 0 {
            let q = escaping(v, 0 as *i64, &ocx, &pcx);
            if q >= 0 && !hidden_place(q, ocx, pcx) && reporting(e, &ocx, pcx) {
                let l = ocx.pl_rid[root_of(q, ocx)];
                own_begin(e, OWN_ESCAPE, &pcx);
                let main_body = is_main_closure(f, pcx);
                if main_body {
                    // (0.25: main returning a Result: its body is a closure)
                    own_str(c"'main' returns an error that views ", pcx);
                    own_place(q, ocx, pcx);
                    own_str(c", which is dropped when 'main' returns", pcx);
                } else {
                    own_sym(pcx.fns[f].display, pcx);
                    own_str(c" returns a view of ", pcx);
                    own_place(q, ocx, pcx);
                    own_str(c", which is dropped when ", pcx);
                    own_sym(pcx.fns[f].display, pcx);
                    own_str(c" returns", pcx);
                }
                let lt = pcx.locals[l].ty;
                if main_body {
                    own_help(c"main's error is printed after its locals are dropped: make the error an owned value (a 'String': 'String::from_in(s, gpa)'), or handle it in main and return 'Ok(())'", pcx);
                } else if pcx.byref.get(l + 1) != 0 {
                    // (0.18.1) `match *e { E::S(s) => s.as_slice() }`
                    own_help(c"it is a copy that 'match *e' (a loop, a 'get') binds; match the reference itself, 'match e', whose bindings are references to what it points to", pcx);
                } else if is_owned_type(lt, &pcx) {
                    own_help(c"return the owner itself; a caller that wants a view takes '.as_slice()' of it", pcx);
                    let text = src_of(e, pcx);
                    if ends_with(text, c".as_slice()") {
                        let tb = buf_new();
                        crate::front::types::buf_type(tb, lt, pcx);
                        let rb = buf_new();
                        crate::front::types::buf_type(rb, rt, pcx);
                        let a = buf_new();
                        buf_str(a, c"edit patch ");
                        buf_bytes(a, SYMS[pcx.fns[f].display].text);
                        buf_str(a, c" --old '-> ");
                        buf_bytes(a, buf_slice(rb));
                        buf_str(a, c"' --new '-> ");
                        buf_bytes(a, buf_slice(tb));
                        buf_str(a, c"' --old '");
                        buf_bytes(a, text);
                        buf_str(a, c"' --new '");
                        buf_bytes(a, text[0..text.len as i64 - 11]);
                        buf_str(a, c"'");
                        let t = buf_new();
                        buf_tool_command(t, buf_slice(a), false, pcx);
                        own_try(buf_slice(t), pcx);
                    }
                } else {
                    own_help(c"return an owned copy, or take the storage as a parameter and return a view of it", pcx);
                }
                if any_and(l1(v, &ocx), at_mark(&ocx, pcx), ocx) {
                    own_soft(&pcx);
                }
                own_end(&pcx);
            }
        }
        // What the `&mut` parameters' referents now hold.
        for i in 0..ocx.param_locals.count {
            let l = ocx.param_locals.data[i];
            if l < 0 {
                continue;
            }
            let s = slot_of_local(l, ocx);
            if s < 0 || (ocx.pool[slot_off(ocx.cur, s, ocx) + ocx.ov] & F_MUTLOAN) == 0 {
                continue;
            }
            // (0.25) what it holds reaches the caller here: a view stored
            // into it that a later write invalidated is used at the exit
            // (a local that dies at the return is the escape below)
            // (a write of the parameter's own referent, through an access
            // it lent, `p.item()` of `Parser { out: &out }`, leaves what is
            // stored in it valid: no stored view is lost)
            let fl = ocx.pool[slot_off(ocx.cur, s, ocx) + ocx.ov];
            let how = (fl >> HOW_SHIFT) & 15;
            let hit = ((fl >> HIT_SHIFT) & 1023) - 1;
            let hr = if hit >= 0 { root_of(hit, ocx) } else { -1 };
            let own = hr >= 0 && (ocx.pl_rkind[hr] == RK_LOCAL || ocx.pl_rkind[hr] == RK_ROOT)
                && ocx.pl_rid[hr] == l;
            if how != H_SCOPE && how != H_DROP && !own {
                use_slot(s, e, 0 as *i64, &ocx, &pcx);
            }
            let off = slot_off(ocx.cur, s, ocx);
            let m = new_ov(&ocx);
            or_into(at(m, &ocx), l2(off, &ocx), ocx);
            let q = escaping(m, 0 as *i64, &ocx, &pcx);
            if q >= 0 && !hidden_place(q, ocx, pcx) && !hidden_local(l, ocx, pcx)
                && reporting(e, &ocx, pcx) {
                own_begin(e, OWN_ESCAPE, &pcx);
                if env_param(f, i, &pcx) {
                    // (0.25: a closure storing into what it captures)
                    own_str(c"the closure stores a view of ", pcx);
                    own_place(q, ocx, pcx);
                    own_str(c" into a variable it captures, and ", pcx);
                    own_place(root_of(q, ocx), ocx, pcx);
                    own_str(c" is dropped when the closure returns", pcx);
                } else {
                    own_sym(pcx.fns[f].display, pcx);
                    own_str(c" stores a view of ", pcx);
                    own_place(q, ocx, pcx);
                    own_str(c" into what ", pcx);
                    own_sym(pcx.locals[l].name, pcx);
                    own_str(c" points to, and ", pcx);
                    own_place(root_of(q, ocx), ocx, pcx);
                    own_str(c" is dropped when ", pcx);
                    own_sym(pcx.fns[f].display, pcx);
                    own_str(c" returns", pcx);
                }
                own_help(
                    c"store an owned copy (a Buf, '.to_vec()'), or keep the owner in the caller",
                    pcx);
                if any_and(l2(off, &ocx), at_mark(&ocx, pcx), ocx) {
                    own_soft(&pcx);
                }
                own_end(&pcx);
            }
            ocx.pool_top = m;
        }
    }
}

// (0.25) Whether function f is the closure main's body became
// (try_main: main_result_wrapper): its messages name 'main'.
fn is_main_closure(f: i64, pcx: Ctx<Comp>) -> bool {
    let m = pcx.main_closure;
    if m <= 0 {
        return false;
    }
    for i in 0..pcx.closures.len() as i64 {
        let c = pcx.closures[i];
        if c.f == f {
            return c.node == m
                || (pcx.nodes[c.node].start == pcx.nodes[m].start
                    && pcx.nodes[c.node].end == pcx.nodes[m].end);
        }
    }
    false
}

// The first place of origin o (both levels) that dies when the function
// returns: a local's, or a by-value parameter's own place; -1.
fn escaping(o: i64, m: *i64, ocx: inout OwnCx, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        for q in 0..ocx.pl_count {
            if !get_bit(l1(o, &ocx), q) && !get_bit(l2(o, &ocx), q) || is_deref_place(q, ocx) {
                continue;
            }
            let r = root_of(q, ocx);
            if ocx.pl_rkind[r] == crate::front::own::state::RK_TEMP {
                // (0.25: a temporary dies at its statement's end)
                return q;
            }
            if ocx.pl_rkind[r] != RK_LOCAL {
                continue;
            }
            let l = ocx.pl_rid[r];
            if !pcx.locals[l].is_param {
                return q;
            }
            let t = pcx.locals[l].ty;
            if t > 0 && TYPES[t].kind != TyKind::Ptr && TYPES[t].kind != TyKind::Slice
                && !is_view_type(t, &pcx) {
                return q;
            }
        }
        -1
    }
}
