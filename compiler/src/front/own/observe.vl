// `volec query own FILE:LINE:COL` (0.17, docs/design/value-semantics.md
// §2.9): the walk's state at a point, per local: its kind, whether it is
// moved (where, by what), the views it holds with their origins. T2 owns
// this file; T6 the command.
//
// own_state_at walks the function holding the position (the fast path
// off), and the view events call at(n) first: the state before the event
// closest after the position (entered from before it), in the walk's last
// pass there (a loop's last round), is written out.

use crate::base::{buf_bytes, buf_new, buf_slice, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::effects::infer::body_walked;
use crate::front::own::ctx::{OwnCx, own_cx_new};
use crate::front::own::diag::own_discard;
use crate::front::own::kinds::kind_word;
use crate::front::own::state::{
    DEREF_FIELD, RK_LOCAL, RK_MARK, RK_STATIC, TUPLE_FIELD, field_number, get_bit, l1, l2,
    moved_bits, reachable, root_of, slot_of_local, slot_off,
};
use crate::front::own::views::{F_MUTLOAN, put_loc};
use crate::front::own::walk::walk_fn;
use crate::front::types::buf_type;

// The state at the position (a byte offset into the program's text): a
// line per local in scope (its name, type and kind, aligned; then whether
// it is moved and the views it holds), written to out; false when the
// position is in no walked function or the walk does not reach it.
pub fn own_state_at(out: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut ocx = own_cx_new();
    unsafe {
        let mut f: i64 = -1;
        let mut span: i64 = 0;
        for g in 0..pcx.fns.len() as i64 {
            if pcx.fns[g as usize].is_extern || !body_walked(g, pcx) {
                continue;
            }
            let item = pcx.fns[g as usize].node;
            let s = pcx.nodes[item as usize].start;
            let e = pcx.nodes[item as usize].end;
            if s <= pos && pos <= e && (f < 0 || e - s < span) {
                f = g;
                span = e - s;
            }
        }
        if f < 0 {
            return false;
        }
        crate::front::own::state::init_state(&mut ocx, pcx);
        ocx.obs_pos = pos;
        ocx.obs_before = true;
        ocx.obs_taken = false;
        pcx.force_walk = true;
        walk_fn(f, 0, &mut ocx, pcx);
        pcx.force_walk = false;
        own_discard(pcx);
        ocx.obs_pos = -1;
        if !ocx.obs_taken {
            return false;
        }
        let mut wn: i64 = 1;
        let mut wt: i64 = 1;
        for i in 0..ocx.obs_locals.count {
            let l = (*ocx.obs_locals.data.add(i as usize));
            let nl = sym_text(pcx.locals[l as usize].name, pcx).len() as i64;
            if nl > wn {
                wn = nl;
            }
            let t = buf_new();
            buf_type(t, pcx.locals[l as usize].ty, pcx);
            if buf_slice(t).len() as i64 > wt {
                wt = buf_slice(t).len() as i64;
            }
        }
        for i in 0..ocx.obs_locals.count {
            let l = (*ocx.obs_locals.data.add(i as usize));
            let name = sym_text(pcx.locals[l as usize].name, pcx);
            buf_bytes(out, name);
            pad(out, wn - name.len() as i64 + 2);
            let t = buf_new();
            buf_type(t, pcx.locals[l as usize].ty, pcx);
            buf_bytes(out, buf_slice(t));
            pad(out, wt - buf_slice(t).len() as i64 + 2);
            buf_str(out, kind_word(pcx.locals[l as usize].ty, pcx));
            buf_bytes(out, buf_slice((*ocx.obs_notes.data.add(i as usize))));
            buf_str(out, c"\n");
        }
        true
    }
}

fn pad(out: i64, n: i64) {
    for i in 0..n {
        buf_str(out, c" ");
    }
}

// An event at node n: the state is taken before the first event at or
// after the position (each pass: a loop's last round wins).
pub fn at(n: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        if ocx.obs_pos < 0 || n <= 0 || !reachable(ocx.cur, ocx) {
            return;
        }
        if pcx.nodes[n as usize].start < ocx.obs_pos {
            ocx.obs_before = true;
            return;
        }
        if !ocx.obs_before || ocx.obs_taken && pcx.nodes[n as usize].start > ocx.obs_best {
            return;
        }
        ocx.obs_before = false;
        ocx.obs_best = pcx.nodes[n as usize].start;
        ocx.obs_taken = true;
        ocx.obs_locals.count = 0;
        ocx.obs_notes.count = 0;
        for i in 0..ocx.param_locals.count {
            local_line((*ocx.param_locals.data.add(i as usize)), ocx, pcx);
        }
        for i in 0..ocx.bound.count {
            local_line((*ocx.bound.data.add(i as usize)), ocx, pcx);
        }
    }
}

fn local_line(l: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        if l < 0 {
            return;
        }
        let name = sym_text(pcx.locals[l as usize].name, pcx);
        if name.len() > 1 && name[0] == b'_' && name[1] == b'_' {
            return;
        }
        for i in 0..ocx.obs_locals.count {
            if (*ocx.obs_locals.data.add(i as usize)) == l {
                return;
            }
        }
        let out = buf_new();
        ocx.obs_locals.push(l);
        ocx.obs_notes.push(out);
        if l < ocx.loc_cap && (*ocx.loc_pl.add(l as usize)) != 0 {
            let p = (*ocx.loc_pl.add(l as usize)) - 1;
            if get_bit(moved_bits(ocx), p) {
                buf_str(out, c"  moved");
                let by = (*ocx.pl_moved_by.add(p as usize));
                if by > 0 {
                    buf_str(out, c" at ");
                    put_loc(out, pcx.nodes[by as usize].start, true, pcx);
                }
            }
        }
        let s = slot_of_local(l, ocx);
        if s >= 0 && s < ocx.nslot {
            let off = slot_off(ocx.cur, s, ocx);
            let flags = (*ocx.pool.add((off + ocx.ov) as usize));
            buf_str(out, c"  views ");
            put_set(out, l1(off, ocx), ocx, pcx);
            if crate::front::own::state::is_empty(l2(off, ocx), ocx) == false {
                buf_str(out, c", which hold views of ");
                put_set(out, l2(off, ocx), ocx, pcx);
            }
            if (flags & F_MUTLOAN) != 0 {
                buf_str(out, c" (exclusive)");
            }
            if (flags & crate::front::own::state::F_INVALID) != 0 {
                buf_str(out, c"; invalid since ");
                let why = (*ocx.pool.add((off + ocx.ov + 1) as usize));
                if why > 0 {
                    put_loc(out, pcx.nodes[why as usize].start, true, pcx);
                } else {
                    buf_str(out, c"its owner's scope ended");
                }
            }
        }
    }
}

// The places of bitset b, by name: `nothing` when empty.
fn put_set(out: i64, b: *mut i64, ocx: &OwnCx, pcx: &Ctx<Comp>) {
    unsafe {
        let mut first = true;
        for q in 0..ocx.pl_count {
            if !get_bit(b, q) || (*ocx.pl_rkind.add(root_of(q, ocx) as usize)) == RK_MARK {
                continue;
            }
            if !first {
                buf_str(out, c", ");
            }
            first = false;
            put_place(out, q, ocx, pcx);
        }
        if first {
            buf_str(out, c"nothing (static data)");
        }
    }
}

fn put_place(out: i64, p: i64, ocx: &OwnCx, pcx: &Ctx<Comp>) {
    unsafe {
        if (*ocx.pl_parent.add(p as usize)) >= 0 {
            put_place(out, (*ocx.pl_parent.add(p as usize)), ocx, pcx);
            let f = (*ocx.pl_field.add(p as usize));
            if f == DEREF_FIELD {
                return;
            }
            buf_str(out, c".");
            if f >= TUPLE_FIELD {
                crate::base::buf_int(out, field_number(f));
            } else {
                buf_bytes(out, sym_text(f, pcx));
            }
            return;
        }
        let k = (*ocx.pl_rkind.add(p as usize));
        if k == RK_LOCAL {
            buf_bytes(out, sym_text(pcx.locals[(*ocx.pl_rid.add(p as usize)) as usize].name, pcx));
        } else if k == RK_STATIC {
            buf_bytes(out, sym_text(pcx.nodes[pcx.statics[(*ocx.pl_rid.add(p as usize)) as usize].node as usize].a, pcx));
        } else {
            buf_str(out, if (*ocx.pl_field.add(p as usize)) == 1 { c"what *" } else { c"what " });
            buf_bytes(out, sym_text(pcx.locals[(*ocx.pl_rid.add(p as usize)) as usize].name, pcx));
            buf_str(out, if (*ocx.pl_field.add(p as usize)) == 1 { c" holds" } else { c" points to" });
        }
    }
}
