// Calls (0.17, docs/design/value-semantics.md §4 step 4, "Calls"). T2 owns
// this file.
//
// The walk evaluates a call's arguments left to right as pending entries
// (state.vl PEND: a loan `&place`, a reference passed on, a view, a
// value); then on_call, in order:
// 1. an argument a later one changed (G2: `take(v.as_slice(), grow(&mut
//    v))`, a `&mut self` receiver changed by its own argument) is a
//    conflict at the later one;
// 2. an argument overlapping one the call writes is a conflict (`f(&mut a,
//    &a)`, `v.extend_from_slice(v.as_slice())`); a `&mut self` receiver is
//    two-phase: reads of it in the arguments are fine (`v.push(v.len())`);
// 3. what the call writes invalidates the views of it (not the slot it is
//    written through, nor that slot's parents);
// 4. the callee's summary (infer::summary_at_call: declared, inferred,
//    the parametric floor, or top, through the type filter; the join of the
//    address-taken functions' for a call through a fn value) gives what its
//    `&mut` arguments' referents come to hold (stores), and the result's
//    origin;
// 5. a callee whose effects include `global` invalidates the views of
//    statics (own.static at their use).
// A top summary (one region: every level from every argument) marks what
// it gives (state::mark_place): conflicts that come from it are warnings
// (§7 V3).

use crate::base::{get_src, buf_bytes, buf_new, buf_slice, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::check::Res;
use crate::front::closures::closure_of_type;
use crate::front::effects::{EFF_GLOBAL, effects_top, fn_effects};
use crate::front::modules::within_std;
use crate::front::own::ctx::OwnCx;
use crate::front::own::diag::{
    OWN_CONFLICT, OWN_ESCAPE, OWN_STATIC, own_begin, own_end, own_help, own_pos, own_soft, own_str,
    own_sym, own_try,
};
use crate::front::own::infer::{col_callable, deep, holds, summary_at_call};
use crate::front::own::kinds::{is_view_type, view_elem};
use crate::front::own::state::{
    PE, PE_BY, PE_INVALID, PE_NODE, PE_OV, PE_PLACE, PK_MUT, PK_MUT_VIEW, PK_NONE, PK_RAW,
    PK_RESERVE, PK_SHARED, PK_VIEW, RK_LOCAL, RK_STATIC, at, clear_bit, get_bit, is_empty, l1, l2,
    local_place, mark_place, new_ov, or_expanded, or_into, ov_hits, ov_or, root_of, set_bit,
    slot_of_local, slot_off,
};
use crate::front::own::summary::{
    S_L1_P, S_L1_STAR, S_L2_P, S_L2_STAR, ViewSummary, captures_by_ref, env_param, store_param,
};
use crate::front::own::views::{
    H_CALL, H_GLOBAL, close_mask, env_slot, first_place, hidden_place, invalidate, note_env_store,
    own_place, own_src, seen,
};
use crate::front::threads::is_interior_type;
use crate::front::types::{TyKind, struct_field};

// Whether origin o holds the mark place (it came in part from a top
// summary).
pub fn any_mark(o: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> bool {
    if o < 0 {
        return false;
    }
    let p = mark_place(ocx, pcx);
    p >= 0 && (get_bit(l1(o, ocx), p) || get_bit(l2(o, ocx), p))
}

fn set_mark(o: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) {
    let p = mark_place(ocx, pcx);
    if p >= 0 {
        set_bit(l1(o, ocx), p);
        set_bit(l2(o, ocx), p);
    }
}

fn is_mut_kind(k: i64) -> bool {
    k == PK_MUT || k == PK_RESERVE || k == PK_MUT_VIEW
}

fn reporting(n: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> bool {
    !ocx.quiet && !seen(n, ocx, pcx)
}

// The slot an argument goes through (a slot local, a place under one, a
// reference passed on), or -1.
fn arg_slot(e: i64, ocx: &OwnCx, pcx: &mut Ctx<Comp>) -> i64 {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident && pcx.nodes[e as usize].res == Res::Local {
        return crate::front::own::state::slot_of_local(pcx.nodes[e as usize].y, ocx);
    }
    if k == NodeKind::Index || k == NodeKind::Cast || k == NodeKind::FieldAccess
        || k == NodeKind::TupleField {
        return arg_slot(pcx.nodes[e as usize].a, ocx, pcx);
    }
    if k == NodeKind::Unary {
        return arg_slot(pcx.nodes[e as usize].b, ocx, pcx);
    }
    if k == NodeKind::Call && pcx.nodes[e as usize].count > 0 && is_view_type(pcx.nodes[e as usize].ty, pcx) {
        // (a view a method makes of its receiver: a reborrow of it,
        // views::root_slot)
        return arg_slot(child(e, 0, pcx), ocx, pcx);
    }
    -1
}

// Whether the path of expression e goes through a pointer, a reference or
// a slice (its place is inside what something points to).
fn path_derefs(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::FieldAccess {
        return pcx.nodes[e as usize].y == 1 || path_derefs(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::TupleField {
        return path_derefs(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op == crate::front::lexer::Tok::Star
            || path_derefs(pcx.nodes[e as usize].b, pcx);
    }
    if k == NodeKind::Index {
        let bt = pcx.nodes[pcx.nodes[e as usize].a as usize].ty;
        if bt > 0 && (pcx.types[bt as usize].kind == TyKind::Ptr || pcx.types[bt as usize].kind == TyKind::Slice) {
            return true;
        }
        return path_derefs(pcx.nodes[e as usize].a, pcx);
    }
    false
}

// The mask of what pending entry e may write: what its level 1 points into,
// expanded, and the paths through references that reach it. (0.25) A
// closure, called (its env `&g`) or passed (`g`, `&g`, `|| ..`): the
// captures it changes, its inout accesses (conventions.md §5.4), and no
// more: its let captures are read.
fn write_mask(e: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let m = new_ov(ocx);
        let t = pcx.nodes[(*ocx.pend.data.add((e + PE_NODE) as usize)) as usize].ty;
        let inner = if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr { pcx.types[t as usize].a } else { t };
        let c = crate::front::closures::closure_of_type(inner, pcx) - 1;
        if c >= 0 {
            let cl = pcx.closures[c as usize];
            for j in 0..cl.capture_count {
                if (*pcx.capture_list.data.add((cl.captures + 2 * j + 1) as usize)) == 2 {
                    let p = crate::front::own::state::local_place(
                        (*pcx.capture_list.data.add((cl.captures + 2 * j) as usize)), ocx, pcx);
                    if p >= 0 {
                        or_into(at(m, ocx), ocx.pl_mask.add((p * ocx.nw) as usize), ocx);
                    }
                }
            }
            close_mask(at(m, ocx), ocx, pcx);
            return m;
        }
        or_expanded(at(m, ocx), l1((*ocx.pend.data.add((e + PE_OV) as usize)), ocx), ocx);
        // (0.25) `&c` of a value holding an inout access (a struct with an
        // inout field): the callee may write through it, what c views at
        // level 2
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr
            && crate::front::own::views::holds_mut(pcx.types[t as usize].a, 0, ocx, pcx) {
            or_expanded(at(m, ocx), l2((*ocx.pend.data.add((e + PE_OV) as usize)), ocx), ocx);
        }
        close_mask(at(m, ocx), ocx, pcx);
        m
    }
}

// ---------------------------------------------------------------------------
// Summaries applied (the type filter is in them: infer::summary_at_call)

// dst gets the levels argument j (origin o) gives through the summary
// masks m (S_* indexed).
fn apply(dst: i64, o: i64, j: i64, m: *mut i64, ocx: &mut OwnCx) {
    unsafe {
        let bit: i64 = if j >= 63 { -1 } else { 1 << j };
        if ((*m.add(S_L1_P as usize)) & bit) != 0 {
            or_into(l1(dst, ocx), l1(o, ocx), ocx);
        }
        if ((*m.add(S_L1_STAR as usize)) & bit) != 0 {
            or_into(l1(dst, ocx), l2(o, ocx), ocx);
        }
        if ((*m.add(S_L2_P as usize)) & bit) != 0 {
            or_into(l2(dst, ocx), l2(o, ocx), ocx);
        }
        if ((*m.add(S_L2_STAR as usize)) & bit) != 0 {
            or_into(l2(dst, ocx), l2(o, ocx), ocx);
        }
    }
}

// (0.25) The type filter per place: a call's result of type rt, origin o,
// whose views are of E (kinds::view_elem) points at level 1 only into
// storage that can hold an E, so a loan on a whole local whose type holds
// no E, by itself or through its views, is dropped (a `[u8]` made by a
// closure an iterator over a `Vec<i64>` calls views none of the Vec).
fn type_narrow(o: i64, rt: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let e = view_elem(rt, pcx);
        if e <= 0 {
            return;
        }
        for q in 0..ocx.pl_count {
            if (*ocx.pl_parent.add(q as usize)) >= 0 || (*ocx.pl_rkind.add(q as usize)) != RK_LOCAL || !get_bit(l1(o, ocx), q) {
                continue;
            }
            if crate::front::own::state::is_cast_root(q, ocx) {
                // (0.25.3: its storage viewed by a cast as another element)
                continue;
            }
            let l = (*ocx.pl_rid.add(q as usize));
            if l < 0 {
                continue;
            }
            let t = pcx.locals[l as usize].ty;
            if t > 0 && !holds(t, e, pcx) && !deep(t, e, pcx) {
                clear_bit(l1(o, ocx), q);
            }
        }
    }
}

// ---------------------------------------------------------------------------
// The call

// Call n of function f (-1: through a fn value), its arguments pending at
// state::PEND[base..] (PE words each); dst (-1: none) gets the result's
// views.
pub fn on_call(n: i64, f: i64, base: i64, dst: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        crate::front::own::observe::at(n, ocx, pcx);
        let end = ocx.pend.count;
        let mark = ocx.pool_top;
        // (whether a written argument's referent holds views: the stores)
        let mut stores = false;
        // 1. Arguments a later one changed.
        let mut e = base;
        while e < end {
            if (*ocx.pend.data.add((e + PE_INVALID) as usize)) != 0 {
                changed_by_later(e, n, ocx, pcx);
            }
            e += PE;
        }
        // 2. Arguments overlapping one the call writes; 3. what it writes.
        let mut a = base;
        while a < end {
            let ka = (*ocx.pend.data.add(a as usize));
            if is_mut_kind(ka) && (*ocx.pend.data.add((a + PE_OV) as usize)) >= 0 {
                let m = write_mask(a, ocx, pcx);
                let mut b = base;
                while b < end {
                    let kb = (*ocx.pend.data.add(b as usize));
                    let ob = (*ocx.pend.data.add((b + PE_OV) as usize));
                    if b != a && kb != PK_NONE && kb != PK_RAW && ob >= 0
                        && !(is_mut_kind(kb) && b < a) && ov_hits(ob, at(m, ocx), ocx) {
                        overlap(a, b, m, ocx, pcx);
                    }
                    else if b < a && is_mut_kind(kb) && ob >= 0 && ov_hits(ob, at(m, ocx), ocx) {
                        // (0.25) an earlier written argument that b's own pass
                        // missed: what a writes reaches what b views (`run(&g,
                        // &n)`, g a closure reading n)
                        let top = ocx.pool_top;
                        let mb = write_mask(b, ocx, pcx);
                        if !ov_hits((*ocx.pend.data.add((a + PE_OV) as usize)), at(mb, ocx), ocx) {
                            overlap(a, b, m, ocx, pcx);
                        }
                        ocx.pool_top = top;
                    }
                    b += PE;
                }
                if ocx.nslot > 0 || base > 0 {
                    invalidate(at(m, ocx), n, H_CALL,
                        arg_slot((*ocx.pend.data.add((a + PE_NODE) as usize)), ocx, pcx), base, ocx);
                }
                ocx.pool_top = m;
                if !stores && end - base > PE && ocx.nslot > 0 {
                    stores = arg_slot((*ocx.pend.data.add((a + PE_NODE) as usize)), ocx, pcx) >= 0;
                }
            }
            a += PE;
        }
        // (0.25) statics lent to a callee that reaches them by name
        if end > base && !is_empty(ocx.static_mask, ocx) {
            static_args(n, f, base, end, ocx, pcx);
        }
        // 5. Statics (before the stores and the result: they do not hold
        // views of statics that the call may have changed).
        if (ocx.nslot > 0 || base > 0) && !is_empty(ocx.static_mask, ocx) {
            let eff = if f >= 0 { fn_effects(f, pcx) } else { effects_top() };
            if (eff.bits & EFF_GLOBAL) != 0 {
                global_call(n, base, ocx, pcx);
            }
        }
        // (0.25) A closure given to the call (or called: its env) may
        // keep anything the other arguments view in what it captures by
        // reference, whatever the summary says (closure_stores)
        if ocx.nslot > 0 && end > base {
            let mut c = base;
            while c < end {
                if closure_arg((*ocx.pend.data.add((c + PE_NODE) as usize)), pcx) && (*ocx.pend.data.add((c + PE_OV) as usize)) >= 0 {
                    closure_stores(c, base, end, ocx, pcx);
                }
                c += PE;
            }
        }
        let rt = pcx.nodes[n as usize].ty;
        // (0.25) a copy of an element the receiver keeps (drops::
        // borrowed_call: `v.get(i)` of a Vec<String>): its storage is the
        // receiver's, a view of all the receiver views
        if dst >= 0 && end > base && !is_view_type(rt, pcx)
            && crate::front::own::byref::borrowed_call(n, pcx) {
            deep_into(dst, (*ocx.pend.data.add((base + PE_OV) as usize)), ocx);
        }
        let result = dst >= 0 && end > base && is_view_type(rt, pcx);
        // (a closure's captures written: its env given to its function, a
        // closure given to a function that calls it; store_captures)
        let mut captures = false;
        if f >= 0 && ocx.nslot > 0 {
            let mut a1 = base;
            let mut j1: i64 = 0;
            while a1 < end {
                if closure_target(f, j1, (*ocx.pend.data.add((a1 + PE_NODE) as usize)), pcx) {
                    captures = true;
                }
                a1 += PE;
                j1 += 1;
            }
        }
        if f >= 0 && within_std(pcx.fns[f as usize].module, pcx) && ocx.nslot > 0 {
            interior_stores(base, end, ocx, pcx);
        }
        if !stores && !result && !captures {
            return;
        }
        let mut s = summary_at_call(n, f, pcx);
        if pcx.fns[ocx.cur_f as usize].tmpl != 0 && within_std(pcx.fns[ocx.cur_f as usize].module, pcx)
            && (f < 0 || !within_std(pcx.fns[f as usize].module, pcx)) {
            lent_escape(n, f, base, end, s, ocx, pcx);
        }
        if captures && !s.top {
            let mut a3 = base;
            let mut j3: i64 = 0;
            while a3 < end {
                if closure_target(f, j3, (*ocx.pend.data.add((a3 + PE_NODE) as usize)), pcx) {
                    store_captures(a3, base, end, s.sto, ocx, pcx);
                }
                a3 += PE;
                j3 += 1;
            }
        }
        // 4. The stores into `&mut` arguments' referents (std's are pinned
        // by T4: an unpinned one assumes none, until its legacy `*T`
        // parameters are `&T` or `&mut T`)
        if stores && !(s.top && f >= 0 && within_std(pcx.fns[f as usize].module, pcx)) {
            let mut a2 = base;
            while a2 < end {
                if is_mut_kind((*ocx.pend.data.add(a2 as usize))) {
                    store(a2, base, end, s.sto, s.top, ocx, pcx);
                }
                a2 += PE;
            }
        }
        ocx.pool_top = mark;
        // 6. The result.
        if result {
            // (a callable result in a generic body: what it views is kept
            // apart for the parametric result, infer::col_call)
            let callable = col_callable(f, pcx);
            let into = new_ov(ocx);
            let mut b = base;
            let mut j: i64 = 0;
            while b < end {
                let o = (*ocx.pend.data.add((b + PE_OV) as usize));
                if o >= 0 && (*ocx.pend.data.add(b as usize)) != PK_NONE {
                    apply(into, o, j, &mut s.ret[0], ocx);
                }
                b += PE;
                j += 1;
            }
            type_narrow(into, rt, ocx, pcx);
            if callable {
                crate::front::own::infer::col_call(into, ocx, pcx);
            }
            or_into(l1(dst, ocx), l1(into, ocx), ocx);
            or_into(l2(dst, ocx), l2(into, ocx), ocx);
            ocx.pool_top = into;
            if s.top && !is_empty(l1(dst, ocx), ocx) {
                set_mark(dst, ocx, pcx);
            }
            // (0.25) and what a closure among the arguments views, at any
            // depth: its captures (a closure called, its env); a declared
            // summary (#[views], checked against the body) says it all
            let mut c = base;
            while c < end && !s.declared {
                let cn = (*ocx.pend.data.add((c + PE_NODE) as usize));
                let co = (*ocx.pend.data.add((c + PE_OV) as usize));
                if closure_arg(cn, pcx) && co >= 0 {
                    if pcx.nodes[cn as usize].ty > 0 && pcx.types[pcx.nodes[cn as usize].ty as usize].kind == TyKind::Ptr {
                        // (an env, `&c`: its level 1 is the loan on c, not
                        // what the closure gives; its captures are level 2)
                        or_into(l1(dst, ocx), l2(co, ocx), ocx);
                        or_into(l2(dst, ocx), l2(co, ocx), ocx);
                    } else {
                        // (its captures' loans, at level 1 only: the type
                        // filter below drops those that cannot hold the
                        // result's views)
                        or_into(l1(dst, ocx), l1(co, ocx), ocx);
                        or_into(l1(dst, ocx), l2(co, ocx), ocx);
                        or_into(l2(dst, ocx), l2(co, ocx), ocx);
                    }
                }
                c += PE;
            }
            filter_places(dst, rt, ocx, pcx);
            // (0.25.3) a cast (summary::cast_mask): the loans of the
            // arguments it views as another element type, past the filter
            let cast: i64 = if f >= 0 { crate::front::own::summary::cast_mask(f, rt, pcx) } else { 0 };
            if cast != 0 {
                let mut b2 = base;
                let mut j2: i64 = 0;
                while b2 < end {
                    let o = (*ocx.pend.data.add((b2 + PE_OV) as usize));
                    let bit: i64 = if j2 >= 63 { -1 } else { 1 << j2 };
                    if (cast & bit) != 0 && o >= 0 && (*ocx.pend.data.add(b2 as usize)) != PK_NONE {
                        or_into(l1(dst, ocx), l1(o, ocx), ocx);
                        crate::front::own::infer::col_cast(o, ocx, pcx);
                        crate::front::own::state::mark_cast_roots(l1(o, ocx), ocx);
                    }
                    b2 += PE;
                    j2 += 1;
                }
            }
        }
    }
}

// (0.25) The type filter place by place (§2.4): a result of type rt whose
// views are of element E points at level 1 only into storage that can
// hold an E, so a loan on a local whose own storage cannot (`order:
// Vec<i64>` for a Vec<[u8]> result) is dropped. Paths through a reference
// (DEREF), statics and the parameters' roots are kept.
fn filter_places(dst: i64, rt: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let e = crate::front::own::kinds::view_elem(rt, pcx);
        if e <= 0 || dst < 0 {
            return;
        }
        for q in 0..ocx.pl_count {
            if !get_bit(l1(dst, ocx), q) {
                continue;
            }
            let mut through = false;
            let mut a = q;
            while a >= 0 {
                if crate::front::own::state::is_deref_place(a, ocx) {
                    through = true;
                }
                a = (*ocx.pl_parent.add(a as usize));
            }
            let r = root_of(q, ocx);
            if crate::front::own::state::is_cast_root(r, ocx) {
                // (0.25.3: its storage viewed by a cast as another element)
                continue;
            }
            let rk = (*ocx.pl_rkind.add(r as usize));
            if through || rk != crate::front::own::state::RK_LOCAL
                && rk != crate::front::own::state::RK_TEMP {
                continue;
            }
            let rid = (*ocx.pl_rid.add(r as usize));
            let t = if rk == crate::front::own::state::RK_TEMP { pcx.nodes[rid as usize].ty }
                else { pcx.locals[rid as usize].ty };
            if t > 0 && pcx.types[t as usize].kind != TyKind::Ptr
                && !crate::front::own::infer::holds(t, e, pcx) {
                clear_bit(l1(dst, ocx), q);
            }
        }
    }
}

// (0.25) Whether argument node e is a closure, or a pointer to one (the env
// of a closure called): its origin is what its captures view.
fn closure_arg(e: i64, pcx: &Ctx<Comp>) -> bool {
    closure_type(pcx.nodes[e as usize].ty, pcx)
}

// (0.25) Whether type t is a closure's, or a pointer to one.
fn closure_type(t0: i64, pcx: &Ctx<Comp>) -> bool {
    let mut t = t0;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        t = pcx.types[t as usize].a;
    }
    crate::front::closures::closure_of_type(t, pcx) != 0
}

// (0.25) dst gets, at both levels, everything origin o views at any depth.
pub fn deep_into(dst: i64, o: i64, ocx: &mut OwnCx) {
    if dst < 0 || o < 0 {
        return;
    }
    or_into(l1(dst, ocx), l1(o, ocx), ocx);
    or_into(l1(dst, ocx), l2(o, ocx), ocx);
    or_into(l2(dst, ocx), l1(o, ocx), ocx);
    or_into(l2(dst, ocx), l2(o, ocx), ocx);
}

// (0.25) Pending closure c (an argument, or the env of the closure called)
// may store what the other arguments view into the locals it captures by
// reference (the places at its level 1): no summary says what its body
// does with them, so each of those locals' slots gets all of it, at both
// levels, minus loans on the local itself.
fn closure_stores(c: i64, base: i64, end: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) {
    unsafe {
        let oc = (*ocx.pend.data.add((c + PE_OV) as usize));
        let u = new_ov(ocx);
        let mut b = base;
        while b < end {
            let o = (*ocx.pend.data.add((b + PE_OV) as usize));
            if b != c && o >= 0 && (*ocx.pend.data.add(b as usize)) != PK_NONE {
                deep_into(u, o, ocx);
            }
            b += PE;
        }
        // (the env of a closure called, `&c`: its captures are at level 2,
        // level 1 is the loan on c)
        let at_ty = pcx.nodes[(*ocx.pend.data.add((c + PE_NODE) as usize)) as usize].ty;
        let env = at_ty > 0 && pcx.types[at_ty as usize].kind == TyKind::Ptr;
        let caps = if env { l2(oc, ocx) } else { l1(oc, ocx) };
        // and what the closure itself views: it may store one capture into
        // another (`|i| out.push(s)`)
        if env {
            or_into(l1(u, ocx), l2(oc, ocx), ocx);
            or_into(l2(u, ocx), l2(oc, ocx), ocx);
        } else {
            deep_into(u, oc, ocx);
        }
        if is_empty(l1(u, ocx), ocx) {
            ocx.pool_top = u;
            return;
        }
        for p in 0..ocx.pl_count {
            if !get_bit(caps, p) || root_of(p, ocx) != p {
                continue;
            }
            let s = crate::front::own::state::slot_of_place(p, ocx);
            if s < 0 || closure_type(pcx.locals[
                (*ocx.slot_local.data.add(s as usize)) as usize].ty, pcx) {
                continue;
            }
            let t = new_ov(ocx);
            ov_or(t, u, ocx);
            for q in 0..ocx.pl_count {
                if root_of(q, ocx) == p {
                    clear_bit(l1(t, ocx), q);
                    clear_bit(l2(t, ocx), q);
                }
            }
            crate::front::own::views::store_deep(s, t, ocx, pcx);
            crate::front::own::views::store_through_loans(s, t, 0, ocx, pcx);
            ocx.pool_top = t;
        }
        ocx.pool_top = u;
    }
}

// Pending entry a (written by the call) stores the other arguments' views
// as the summary's stores say (sto, top: a top summary).
fn store(a: i64, base: i64, end: i64, mut sto: [i64; 4], top: bool, ocx: &mut OwnCx,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        let arg = (*ocx.pend.data.add((a + PE_NODE) as usize));
        let ts = arg_slot(arg, ocx, pcx);
        if ts < 0 {
            return;
        }
        let at_ty = pcx.nodes[arg as usize].ty;
        let mut rt = if at_ty > 0 && pcx.types[at_ty as usize].kind == TyKind::Ptr { pcx.types[at_ty as usize].a }
            else { at_ty };
        // (0.25) through a slice lent as a view (`inout [T]` passed on, not
        // `&s` of a slice variable, which may be replaced), what is stored
        // goes into its elements: a `[(i64, i64)]` sorted with a closure
        // holds no views
        if (*ocx.pend.data.add(a as usize)) == PK_MUT_VIEW && rt > 0 && pcx.types[rt as usize].kind == TyKind::Slice {
            rt = pcx.types[rt as usize].a;
        }
        if rt <= 0 || !is_view_type(rt, pcx) {
            return;
        }
        let tmp = new_ov(ocx);
        let mut b = base;
        let mut j: i64 = 0;
        while b < end {
            let o = (*ocx.pend.data.add((b + PE_OV) as usize));
            if b != a && o >= 0 && (*ocx.pend.data.add(b as usize)) != PK_NONE {
                apply(tmp, o, j, &mut sto[0], ocx);
            }
            b += PE;
            j += 1;
        }
        if is_empty(l1(tmp, ocx), ocx) && is_empty(l2(tmp, ocx), ocx) {
            ocx.pool_top = tmp;
            return;
        }
        // (minus loans on the referent itself)
        let pa = (*ocx.pend.data.add((a + PE_PLACE) as usize));
        if pa >= 0 {
            let r = root_of(pa, ocx);
            for q in 0..ocx.pl_count {
                if root_of(q, ocx) == r {
                    clear_bit(l1(tmp, ocx), q);
                    clear_bit(l2(tmp, ocx), q);
                }
            }
        }
        if top {
            set_mark(tmp, ocx, pcx);
        }
        crate::front::own::views::note_env_store(ts, tmp, ocx, pcx);
        let off = slot_off(ocx.cur, ts, ocx);
        let through = pcx.nodes[arg as usize].kind == NodeKind::Ident || (*ocx.pend.data.add(a as usize)) == PK_MUT_VIEW
            || pcx.nodes[arg as usize].kind == NodeKind::Unary && path_derefs(pcx.nodes[arg as usize].b, pcx);
        if through {
            // (what the slot points to now holds them)
            or_into(l2(off, ocx), l1(tmp, ocx), ocx);
            or_into(l2(off, ocx), l2(tmp, ocx), ocx);
        } else {
            or_into(l1(off, ocx), l1(tmp, ocx), ocx);
            or_into(l2(off, ocx), l2(tmp, ocx), ocx);
        }
        // (0.25) and what the slot holds loans on: `r = &mut v; r.push(w)`
        crate::front::own::views::store_through_loans(ts, tmp, 0, ocx, pcx);
        ocx.pool_top = tmp;
    }
}

// Whether argument j (node arg) of a call of f holds a closure whose
// captures the call may store into: the env of a call of the closure's
// own function, or a closure given to a parameter that stores go into
// (summary::store_param: a generic function that calls it).
fn closure_target(f: i64, j: i64, arg: i64, pcx: &mut Ctx<Comp>) -> bool {
    if j == 0 && env_param(f, 0, pcx) {
        return true;
    }
    let mut t = pcx.nodes[arg as usize].ty;
    if t <= 0 || closure_of_type(t, pcx) == 0 {
        return false;
    }
    j < pcx.fns[f as usize].param_count && store_param(f, j, pcx)
}

// Pending entry a, a closure (its env or its value) the call may store
// into as the summary's stores say (sto): every argument's views, the
// closure's own among them (it may store one capture into another), go to
// the variables it captures by reference: their slots when they are this
// function's; else this closure's env, when it captures them too (a
// nested closure); and the closure's own slot.
fn store_captures(a: i64, base: i64, end: i64, mut sto: [i64; 4], ocx: &mut OwnCx,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        let arg = (*ocx.pend.data.add((a + PE_NODE) as usize));
        let mut t = pcx.nodes[arg as usize].ty;
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            t = pcx.types[t as usize].a;
        }
        let c = closure_of_type(t, pcx) - 1;
        if c < 0 {
            return;
        }
        let tmp = new_ov(ocx);
        let mut b = base;
        let mut j: i64 = 0;
        while b < end {
            let o = (*ocx.pend.data.add((b + PE_OV) as usize));
            if o >= 0 && (*ocx.pend.data.add(b as usize)) != PK_NONE {
                apply(tmp, o, j, &mut sto[0], ocx);
            }
            b += PE;
            j += 1;
        }
        if is_empty(l1(tmp, ocx), ocx) && is_empty(l2(tmp, ocx), ocx) {
            ocx.pool_top = tmp;
            return;
        }
        let env = env_slot(ocx, pcx);
        for k in 0..pcx.closures[c as usize].capture_count {
            if (*pcx.capture_list.data.add((pcx.closures[c as usize].captures + 2 * k + 1) as usize)) == 0 {
                continue;
            }
            let l = (*pcx.capture_list.data.add((pcx.closures[c as usize].captures + 2 * k) as usize));
            let s = slot_of_local(l, ocx);
            if s >= 0 {
                let off = slot_off(ocx.cur, s, ocx);
                let r = local_place(l, ocx, pcx);
                let m = new_ov(ocx);
                or_into(l1(m, ocx), l1(tmp, ocx), ocx);
                or_into(l2(m, ocx), l2(tmp, ocx), ocx);
                // (minus loans on the variable itself)
                if r >= 0 {
                    for q in 0..ocx.pl_count {
                        if root_of(q, ocx) == r {
                            clear_bit(l1(m, ocx), q);
                            clear_bit(l2(m, ocx), q);
                        }
                    }
                }
                or_into(l1(off, ocx), l1(m, ocx), ocx);
                or_into(l2(off, ocx), l2(m, ocx), ocx);
                ocx.pool_top = m;
            } else if env >= 0 && captures_by_ref(ocx.cur_f, l, pcx) {
                let off = slot_off(ocx.cur, env, ocx);
                note_env_store(env, tmp, ocx, pcx);
                or_into(l2(off, ocx), l1(tmp, ocx), ocx);
                or_into(l2(off, ocx), l2(tmp, ocx), ocx);
            }
        }
        // (a parameter of the same closure type, of which the argument may
        // be a copy, `var g = f`: the same closure, so the same captures)
        for i in 0..ocx.param_locals.count {
            let pl = (*ocx.param_locals.data.add(i as usize));
            if pl < 0 || i >= pcx.fns[ocx.cur_f as usize].param_count
                || crate::front::types::fn_param(ocx.cur_f, i, pcx) != t {
                continue;
            }
            let ps = slot_of_local(pl, ocx);
            if ps >= 0 && ps != arg_slot(arg, ocx, pcx) {
                let off = slot_off(ocx.cur, ps, ocx);
                note_env_store(ps, tmp, ocx, pcx);
                or_into(l1(off, ocx), l1(tmp, ocx), ocx);
                or_into(l2(off, ocx), l2(tmp, ocx), ocx);
            }
        }
        let own = arg_slot(arg, ocx, pcx);
        if own >= 0 {
            let off = slot_off(ocx.cur, own, ocx);
            note_env_store(own, tmp, ocx, pcx);
            if own == env {
                or_into(l2(off, ocx), l1(tmp, ocx), ocx);
            } else {
                or_into(l1(off, ocx), l1(tmp, ocx), ocx);
            }
            or_into(l2(off, ocx), l2(tmp, ocx), ocx);
        }
        ocx.pool_top = tmp;
    }
}

// Whether type t lends what it locks (std's Mutex and what holds one; a
// MutexGuard's pointer to one): a function of it hands its callable a
// reference into memory that changes through shared references.
fn lends_interior(t: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if t <= 0 {
            return false;
        }
        let u = if pcx.types[t as usize].kind == TyKind::Ptr { pcx.types[t as usize].a } else { t };
        if is_interior_type(u, pcx) {
            return true;
        }
        if u > 0 && pcx.types[u as usize].kind == TyKind::Struct {
            let st = pcx.types[u as usize].a;
            for i in 0..pcx.structs[st as usize].field_count {
                let ft = (*struct_field(st, i, pcx)).ty;
                if ft > 0 && pcx.types[ft as usize].kind == TyKind::Ptr
                    && is_interior_type(pcx.types[ft as usize].a, pcx) {
                    return true;
                }
            }
        }
        false
    }
}

// Call n, in an instance of std's (Mutex::with: CUR_F), of the program's
// callable f (summary s): a reference the instance makes from a raw
// pointer into data it locks (`&*p`) must not be viewed by f's result nor
// stored by f, as the lock is released when the instance returns: own.escape
// at the call that made the instance.
fn lent_escape(n: i64, f: i64, base: i64, end: i64, s: ViewSummary, ocx: &mut OwnCx,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        let origin = pcx.fns[ocx.cur_f as usize].origin;
        if origin <= 0 {
            return;
        }
        let mut lends = false;
        for i in 0..pcx.fns[ocx.cur_f as usize].param_count {
            if lends_interior(crate::front::types::fn_param(ocx.cur_f, i, pcx), pcx) {
                lends = true;
            }
        }
        if !lends {
            return;
        }
        let mut b = base;
        let mut j: i64 = 0;
        while b < end && j < 63 {
            let arg = (*ocx.pend.data.add((b + PE_NODE) as usize));
            let t = pcx.nodes[arg as usize].ty;
            let o = (*ocx.pend.data.add((b + PE_OV) as usize));
            let raw = (*ocx.pend.data.add(b as usize)) == PK_RAW || o < 0
                || is_empty(l1(o, ocx), ocx) && is_empty(l2(o, ocx), ocx);
            if raw && !(j == 0 && env_param(f, 0, pcx)) && t > 0
                && pcx.types[t as usize].kind == TyKind::Ptr
                && (f < 0 || j < pcx.fns[f as usize].param_count) {
                let bit = 1 << j;
                let ret = (s.ret[S_L1_P as usize] & bit) != 0;
                if ret || (s.sto[S_L1_P as usize] & bit) != 0 {
                    if seen(origin, ocx, pcx) {
                        return;
                    }
                    own_begin(origin, OWN_ESCAPE, pcx);
                    if f < 0 {
                        own_str(if ret { c"the function's result views its argument" }
                            else { c"the function stores a view of its argument" }, pcx);
                    } else {
                        let pl = pcx.nodes[child(pcx.fns[f as usize].node, j, pcx) as usize].x;
                        own_str(if ret { c"the closure's result views " }
                            else { c"the closure stores a view of " }, pcx);
                        if pl >= 0 {
                            own_sym(pcx.locals[pl as usize].name, pcx);
                        } else {
                            own_str(c"its argument", pcx);
                        }
                    }
                    own_str(c", the data ", pcx);
                    own_sym(pcx.nodes[pcx.fns[ocx.cur_f as usize].node as usize].a, pcx);
                    own_str(c" locks: the lock is released when ", pcx);
                    own_sym(pcx.nodes[pcx.fns[ocx.cur_f as usize].node as usize].a, pcx);
                    own_str(c" returns, and the view would outlive it", pcx);
                    own_help(c"copy what you need out inside the closure ('.to_vec()', an element), or do the work there", pcx);
                    own_end(pcx);
                    return;
                }
            }
            b += PE;
            j += 1;
        }
    }
}

// A call of std's with an argument that locks data holding views (a
// `Mutex<Vec<[u8]>>`, interior: changed through a shared reference, which
// no summary's stores can say): the closures given to it that store views
// (their summaries' stores) may store them into the data, so the argument
// comes to view everything those closures hold.
fn interior_stores(base: i64, end: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut a = base;
        while a < end {
            let arg = (*ocx.pend.data.add((a + PE_NODE) as usize));
            let at_ty = pcx.nodes[arg as usize].ty;
            let u = if at_ty > 0 && pcx.types[at_ty as usize].kind == TyKind::Ptr { pcx.types[at_ty as usize].a }
                else { at_ty };
            let ts = arg_slot(arg, ocx, pcx);
            if ts >= 0 && is_view_type(u, pcx) && lends_interior(at_ty, pcx) {
                let off = slot_off(ocx.cur, ts, ocx);
                let mut b = base;
                while b < end {
                    let o = (*ocx.pend.data.add((b + PE_OV) as usize));
                    let bt = pcx.nodes[(*ocx.pend.data.add((b + PE_NODE) as usize)) as usize].ty;
                    let c = closure_of_type(bt, pcx) - 1;
                    if b != a && o >= 0 && c >= 0 && stores_any(pcx.closures[c as usize].f, pcx) {
                        or_into(l1(off, ocx), l1(o, ocx), ocx);
                        or_into(l1(off, ocx), l2(o, ocx), ocx);
                        or_into(l2(off, ocx), l2(o, ocx), ocx);
                    }
                    b += PE;
                }
            }
            a += PE;
        }
    }
}

// Whether f's summary stores views.
fn stores_any(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    let s = crate::front::own::summary::summary_of(f, pcx);
    (s.sto[0] | s.sto[1] | s.sto[2] | s.sto[3]) != 0
}

// A call whose effects include `global`: the views of statics are invalid
// from here (slots, and pending views of enclosing calls; a loan on a
// static's own place stays: its address does not change).
fn global_call(n: i64, base: i64, ocx: &mut OwnCx, pcx: &Ctx<Comp>) {
    unsafe {
        let m = new_ov(ocx);
        or_expanded(at(m, ocx), ocx.static_mask, ocx);
        close_mask(at(m, ocx), ocx, pcx);
        // (the pending views only)
        let mut e: i64 = 0;
        while e < base {
            let k = (*ocx.pend.data.add(e as usize));
            let o = (*ocx.pend.data.add((e + PE_OV) as usize));
            if (k == PK_VIEW || k == PK_MUT_VIEW) && o >= 0 && (*ocx.pend.data.add((e + PE_INVALID) as usize)) == 0
                && ov_hits(o, at(m, ocx), ocx) {
                (*ocx.pend.data.add((e + PE_INVALID) as usize)) = H_GLOBAL;
                (*ocx.pend.data.add((e + PE_BY) as usize)) = n;
            }
            e += PE;
        }
        invalidate(at(m, ocx), n, H_GLOBAL, -1, 0, ocx);
        ocx.pool_top = m;
    }
}

// (0.25) Statics lent to call n of f (-1: through a fn value): an
// argument that reaches mutable static S (`&S`, `&S.f`, a let `S`
// passed by reference, `S[..]`, a receiver `S.m()`, at level 1 or 2)
// conflicts with a callee that may change S by name, itself or through
// what it calls (effects::infer::static_access), and an inout one with a
// callee that reads it: the callee would see S through two names, which
// the optimizer takes to be apart (noalias). own.static, at the argument.
fn static_args(n: i64, f: i64, base: i64, end: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut e = base;
        while e < end {
            let k = (*ocx.pend.data.add(e as usize));
            let o = (*ocx.pend.data.add((e + PE_OV) as usize));
            if k != PK_NONE && k != PK_RAW && o >= 0 {
                let arg = (*ocx.pend.data.add((e + PE_NODE) as usize));
                for p in 0..ocx.pl_count {
                    if !get_bit(l1(o, ocx), p) && !get_bit(l2(o, ocx), p) {
                        continue;
                    }
                    let r = root_of(p, ocx);
                    if (*ocx.pl_rkind.add(r as usize)) != RK_STATIC {
                        continue;
                    }
                    let s = (*ocx.pl_rid.add(r as usize));
                    let how = crate::front::effects::infer::static_access(f, s, pcx);
                    if (how & 2) != 0 || is_mut_kind(k) && how != 0 {
                        static_arg_error(n, f, arg, s, how, ocx, pcx);
                        break;
                    }
                }
            }
            e += PE;
        }
    }
}

fn static_arg_error(n: i64, f: i64, arg: i64, s: i64, how: i64, ocx: &mut OwnCx,
    pcx: &mut Ctx<Comp>) {
    if !reporting(arg, ocx, pcx) {
        return;
    }
    let name = pcx.nodes[pcx.statics[s as usize].node as usize].a;
    own_begin(arg, OWN_STATIC, pcx);
    own_src(arg, pcx);
    own_str(c" lends the static ", pcx);
    own_sym(name, pcx);
    own_str(c" to ", pcx);
    own_src(n, pcx);
    if f >= 0 {
        own_str(c", and ", pcx);
        own_sym(pcx.fns[f as usize].display, pcx);
        own_str(if (how & 2) != 0 { c" changes " } else { c" reads " }, pcx);
        own_sym(name, pcx);
        own_str(c" by name (itself or through what it calls)", pcx);
    } else {
        own_str(c", whose callee is not known and may reach it by name", pcx);
    }
    own_help(c"a static lent to a call must not be reached by name during the call (two names for one place, which the optimizer takes to be apart): lend a copy, then write it back", pcx);
    // the try: the call on a copy, `var copy = G; f(&copy); G = copy;`
    let at = &get_src()[pcx.nodes[arg as usize].start as usize..pcx.nodes[arg as usize].end as usize];
    let call = &get_src()[pcx.nodes[n as usize].start as usize..pcx.nodes[n as usize].end as usize];
    let amp = at.len() > 1 && at[0] == b'&';
    let whole = if amp { &at[1..at.len()] } else { at };
    // (`A[..]`: a copy of A, its elements lent)
    let sliced = whole.len() > 4
        && whole[(whole.len() as i64 - 4) as usize..] == b"[..]";
    let place = if sliced { &whole[0..(whole.len() as i64 - 4) as usize] } else { whole };
    let mut cut: i64 = 0;
    while cut + at.len() as i64 <= call.len() as i64 && call[cut as usize..(cut + at.len() as i64) as usize] != at {
        cut += 1;
    }
    if cut + at.len() as i64 <= call.len() as i64 && place.len() > 0 {
        let t = buf_new();
        buf_str(t, c"var copy = ");
        buf_bytes(t, place);
        buf_str(t, c"; ");
        buf_bytes(t, &call[0..cut as usize]);
        buf_str(t, if amp { c"&copy" } else { c"copy" });
        if sliced {
            buf_str(t, c"[..]");
        }
        buf_bytes(t, &call[(cut + at.len() as i64) as usize..]);
        buf_str(t, c"; ");
        buf_bytes(t, place);
        buf_str(t, c" = copy;");
        own_try(buf_slice(t), pcx);
    }
    own_end(pcx);
}

// Pending entry e was changed by a later argument (PE_BY, how PE_INVALID)
// before call n: the finding, at the later argument.
fn changed_by_later(e: i64, n: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let arg = (*ocx.pend.data.add((e + PE_NODE) as usize));
        let by = (*ocx.pend.data.add((e + PE_BY) as usize));
        let k = (*ocx.pend.data.add(e as usize));
        // (the change at a node with no text of its own inside the call, a
        // drop or a scope's end: the finding is at the call, unnamed)
        let named = by > 0 && pcx.nodes[by as usize].end > pcx.nodes[by as usize].start
            && pcx.nodes[by as usize].start >= pcx.nodes[n as usize].start && pcx.nodes[by as usize].end <= pcx.nodes[n as usize].end;
        let at_node = if named { by } else { n };
        let pl = (*ocx.pend.data.add((e + PE_PLACE) as usize));
        let o = (*ocx.pend.data.add((e + PE_OV) as usize));
        if hidden_place(pl, ocx, pcx)
            || o >= 0 && hidden_place(first_place(o, 0 as *mut i64, ocx), ocx, pcx)
            || !reporting(at_node, ocx, pcx) {
            return;
        }
        own_begin(at_node, OWN_CONFLICT, pcx);
        if k == PK_RESERVE {
            own_str(c"the receiver ", pcx);
            own_src(arg, pcx);
            own_str(c" of ", pcx);
            own_src(n, pcx);
            if named {
                own_str(c" is changed by its own argument ", pcx);
                own_src(at_node, pcx);
            } else {
                own_str(c" is changed by its own arguments", pcx);
            }
            own_help(c"an 'inout self' receiver is lent when the call happens, after its arguments, and must not change in between: compute the argument into a 'let' before the call", pcx);
        } else {
            if named {
                own_src(at_node, pcx);
            } else {
                own_str(c"a later argument", pcx);
            }
            own_str(c" may change what argument ", pcx);
            own_src(arg, pcx);
            own_str(c" (", pcx);
            own_pos(arg, pcx);
            own_str(if k == PK_MUT || k == PK_SHARED { c") accesses, " } else { c") views, " },
                pcx);
            own_str(c"before ", pcx);
            own_src(n, pcx);
            own_str(c" uses it", pcx);
            own_help(c"evaluate the later argument into a 'let' before the call, then take the view (or the access) in the call", pcx);
        }
        if any_mark((*ocx.pend.data.add((e + PE_OV) as usize)), ocx, pcx) {
            own_soft(pcx);
        }
        own_end(pcx);
    }
}

// Pending entries a (written by the call) and b overlap (mask m: what a
// writes): the finding, at b.
fn overlap(a: i64, b: i64, m: i64, ocx: &mut OwnCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let an = (*ocx.pend.data.add((a + PE_NODE) as usize));
        let bn = (*ocx.pend.data.add((b + PE_NODE) as usize));
        let ob = (*ocx.pend.data.add((b + PE_OV) as usize));
        let mut q: i64 = -1;
        for p in 0..ocx.pl_count {
            if get_bit(at(m, ocx), p) && (get_bit(l1(ob, ocx), p) || get_bit(l2(ob, ocx), p))
                && (*ocx.pl_rkind.add(root_of(p, ocx) as usize))
                != crate::front::own::state::RK_MARK {
                q = p;
                break;
            }
        }
        // (a desugaring's own temporaries: views::hidden_local)
        if hidden_place(q, ocx, pcx) || hidden_place((*ocx.pend.data.add((a + PE_PLACE) as usize)), ocx, pcx)
            || !reporting(bn, ocx, pcx) {
            return;
        }
        own_begin(bn, OWN_CONFLICT, pcx);
        if q >= 0 {
            own_place(q, ocx, pcx);
        } else {
            own_str(c"a place", pcx);
        }
        own_str(c" has an inout access, ", pcx);
        own_src(an, pcx);
        let kb = (*ocx.pend.data.add(b as usize));
        let named = is_mut_kind(kb) || kb == PK_VIEW;
        own_str(if is_mut_kind(kb) { c", and another one, " }
            else if kb == PK_VIEW { c", and a view, " } else { c", and is read by " }, pcx);
        own_src(bn, pcx);
        own_str(if named { c", in the same call" } else { c" in the same call" }, pcx);
        if (*ocx.pend.data.add(a as usize)) == PK_RESERVE {
            own_help(c"the call changes its receiver while this argument still views it: copy what it views first ('.clone()'), or pass a part the receiver does not hold", pcx);
        } else {
            own_help(c"pass disjoint places ('&a.x, a.y'), copy the plain value out first, or for two elements of one Vec use 'v.swap(i, j)'", pcx);
        }
        if any_mark(ob, ocx, pcx) || any_mark((*ocx.pend.data.add((a + PE_OV) as usize)), ocx, pcx) {
            own_soft(pcx);
        }
        own_end(pcx);
    }
}
