// The own pass (0.17, docs/design/value-semantics.md): mutable value
// semantics checked on the typed AST, after the effects (check_program).
// Kinds, moves and drops, views with two-level origins and exclusivity,
// view summaries inferred per function.
//
// The files (Phase 0 fixed their interfaces; §6 and "Phase 0 contract"
// say who fills what):
//   kinds.vl    type_kind, view_elem, param_mode (the legacy `*T` rule)
//   state.vl    places, bitsets, the pool, states, origins, slots,
//                 pending arguments
//   walk.vl     the evaluation-order walk, its events, walk_fn
//   moves.vl    the move events (T1); drops.vl, glue.vl (T1)
//   views.vl    the view events (T2); calls.vl: calls (T2)
//   summary.vl  ViewSummary, summary_of, summary_text, #[views] (T3)
//   infer.vl    the driver (SCC order, recursive components to a fixed
//                 point), the type filter, indirect calls, own.views, the
//                 why-chains, --print-views (T3)
//   diag.vl     the codes, the messages, --values
//   observe.vl  `query own` (T2, T6)
//   fast.vl     the fast path: functions with nothing to track (T2)
//
// --values=off|report|warn|error (OWN_MODE, diag.vl): off skips the
// pass; report (the default until T7) records the findings and prints
// them only when --values=report is given; warn and error report them so.
// error is the default (T7): compiler/src too is checked and dropped under
// it (its legacy `*T` parameters are the legacy rule's, and it checks
// clean), so no mode of its own.

pub mod ctx;
pub mod kinds;
pub mod state;
pub mod walk;
pub mod moves;
pub mod views;
pub mod calls;
pub mod summary;
pub mod infer;
pub mod diag;
pub mod observe;
pub mod fast;
pub mod drops;
pub mod glue;
pub mod byref;

use crate::base::{STDOUT, buf_new, buf_str, buf_write_fd};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::timer::{T_CHECK, T_OWN, timer_now, timer_sub};
use crate::front::own::ctx::OwnCx;
use crate::front::own::diag::{
    MODE_ERROR, MODE_OFF, MODE_REPORT, MODE_WARN, own_discard, own_flush, print_reports,
};
use crate::front::own::drops::report_drop_views;
use crate::front::own::infer::{infer_summaries, print_views};
use crate::front::own::state::init_state;
use crate::front::own::summary::validate_views_decls;

// `--values=MODE` (main's arguments): sets the mode; false when arg is not
// that option. An unknown mode is an error there (main).
pub fn values_option(arg: str, pcx: inout Ctx<Comp>) -> bool {
    if arg == "--values=off" {
        pcx.own_mode = MODE_OFF;
    } else if arg == "--values=report" {
        pcx.own_mode = MODE_REPORT;
        pcx.own_report_print = true;
    } else if arg == "--values=warn" {
        pcx.own_mode = MODE_WARN;
    } else if arg == "--values=error" {
        pcx.own_mode = MODE_ERROR;
    } else if arg == "--print-views" {
        // (every function's view summary, after checking: infer.vl)
        pcx.print_views = true;
    } else {
        return false;
    }
    true
}

// Whether arg starts with `--values`.
pub fn is_values_option(arg: str) -> bool {
    arg.starts_with("--values")
}

// RULE: Z8 Whether the own pass is off: a rust program on std2 (every
// body, std2's included, is the borrow checker's: §1-§10, dropck for
// own.drop_view). The mode stays as it is: it also says the drops are the
// places IR's and the optimizer's facts may be used (D17.7). A rust
// program on MVS std (VOLE_STD2=0, until the cases migrate) keeps the
// pass for std's summaries.
pub fn own_off(pcx: Ctx<Comp>) -> bool {
    crate::front::known::on_std2(pcx)
}

// What `--print-views`, `query own` and `query views` say for a program
// whose own pass is off (own_off).
pub const OWN_OFF_NOTE: *u8 =
    c"the own pass does not run in the rust edition: its moves, borrows and drops are the borrow checker's\n";

// The pass (check_program, after the effects): the #[views] declarations
// checked, then (unless off, or report without --values=report) every
// function walked, callees first (infer.vl). For the summaries alone
// (`query`, the cache, --print-views), only the functions whose summaries
// can carry views are walked, and their findings are not printed.
//
// (0.26.2) The places IR places and decides the drops; own.drop_view is
// reported here (drops::report_drop_views).
pub fn check_own(ocx: inout OwnCx, pcx: inout Ctx<Comp>) {
    if own_off(pcx) {
        if pcx.print_views {
            let out = buf_new();
            buf_str(out, OWN_OFF_NOTE);
            buf_write_fd(out, STDOUT);
        }
        return;
    }
    validate_views_decls(&pcx);
    // (report, the default, walks only when its findings are printed:
    // --values=report; tests/refactor/run.sh keeps compiler/src clean
    // under it)
    let all = !(pcx.own_mode == MODE_OFF || pcx.own_mode == MODE_REPORT && !pcx.own_report_print);
    if !all && !pcx.print_views && !pcx.query {
        return;
    }
    let t = timer_now(pcx);
    init_state(&ocx, pcx);
    infer_summaries(all, &ocx, &pcx);
    report_drop_views(&pcx);
    if all {
        own_flush(&pcx);
    } else {
        own_discard(&pcx);
    }
    if pcx.own_report_print {
        print_reports(ocx, pcx);
    }
    if pcx.print_views {
        let out = buf_new();
        print_views(out, &pcx);
        buf_write_fd(out, STDOUT);
    }
    timer_sub(T_CHECK, T_OWN, t, pcx);
}
