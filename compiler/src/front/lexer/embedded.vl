// Embedded blocks (0.26.0): `embed wgsl NAME { WGSL }`. Vole's lexer
// cannot lex another language's text (WGSL's `1u`, `2.0f`, its nested
// comments), so when it adds the `{` of `embed LANG NAME {` it hands the
// body to that language's rule for its end: a WGSL body ends at the `}`
// that matches outside `//` and nested `/* */` comments (WGSL has no
// string or character literals). The body is one Tok::Embedded token
// (its bytes, no string id); lexing resumes at the closing `}`. The
// parser (front::parser::items) makes the item, front::embed its meaning.

use crate::base::{buf_bytes, buf_copy, buf_int, buf_new, get_src, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fmt, err_help, err_jump};
use crate::front::contracts::sites::file_of_pos;
use crate::front::lexer::{Tok, Token, add_token};

// Whether the `{` just added (the last token) opens an embedded block: the
// tokens before it are `embed`, an identifier and an identifier, then
// (0.26.2, parts) maybe `with` and paths (`A`, `a::B`) separated by commas,
// at most 64 tokens back, in the same file (TOKS holds every file: a file
// ending in `embed wgsl` and the next starting `K {` are not one block).
pub fn at_embedded_open(pcx: &mut Ctx<Comp>) -> bool {
    let n = pcx.toks.len() as i64 - 1;
    if n - 3 < pcx.lex_first || tok(n - 1, pcx).kind != Tok::Ident {
        return false;
    }
    if pcx.sym_embed == 0 {
        pcx.sym_embed = intern_c(c"embed", pcx);
        pcx.sym_with = intern_c(c"with", pcx);
    }
    let mut head = n - 3;
    if !is_embed_head(head, pcx) {
        // `with` and its paths: back over `Ident (:: Ident)*` items and
        // the commas between them
        let mut i = n - 1;
        loop {
            while i - 2 >= pcx.lex_first && n - i < 64 && tok(i - 1, pcx).kind == Tok::ColonColon
                && tok(i - 2, pcx).kind == Tok::Ident {
                i -= 2;
            }
            if i - 2 < pcx.lex_first || n - i >= 64 {
                return false;
            }
            if tok(i - 1, pcx).kind == Tok::Comma && tok(i - 2, pcx).kind == Tok::Ident {
                i -= 2;
                continue;
            }
            break;
        }
        // tok(i) is the first path's first segment: `with` before it
        let w = i - 1;
        if w - 3 < pcx.lex_first || tok(w, pcx).kind != Tok::Ident
            || tok(w, pcx).value as i64 != pcx.sym_with {
            return false;
        }
        head = w - 3;
        if !is_embed_head(head, pcx) {
            return false;
        }
    }
    !program_text(pcx)
        || file_of_pos(tok(head, pcx).start, pcx) == file_of_pos(tok(n, pcx).start, pcx)
}

// Whether tokens h, h + 1 and h + 2 are `embed`, an identifier and an
// identifier.
fn is_embed_head(h: i64, pcx: &Ctx<Comp>) -> bool {
    tok(h, pcx).kind == Tok::Ident && tok(h, pcx).value as i64 == pcx.sym_embed
        && tok(h + 1, pcx).kind == Tok::Ident && tok(h + 2, pcx).kind == Tok::Ident
}

// Token i of TOKS, for i in LEX_FIRST..TOK_COUNT.
fn tok(i: i64, pcx: &Ctx<Comp>) -> Token {
    pcx.toks[i as usize]
}

// Whether SRC is the program's files, FILES' text (fmt and rewrite lex a
// text of their own, one file).
fn program_text(pcx: &Ctx<Comp>) -> bool {
    pcx.files.len() > 0 && get_src().as_ptr() == pcx.src_base
}

// The end of the text the block at `open` may take: its file's end, or
// the lexed range's.
fn text_end(open: i64, pcx: &Ctx<Comp>) -> i64 {
    if !program_text(pcx) {
        return pcx.lex_end;
    }
    let f = pcx.files[file_of_pos(open, pcx) as usize].end;
    if f < pcx.lex_end { f } else { pcx.lex_end }
}

// The body of the block whose `{` is at `open`, as one Tok::Embedded token
// (open + 1 .. its `}`): the position of that `}`, where lexing resumes. No
// matching `}` is embed.unterminated, fatal.
pub fn lex_embedded(open: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let end = text_end(open, pcx);
    let close = embed_block_end(&get_src()[0..end as usize], open);
    if close < 0 {
        unterminated(open, -close - 1, pcx);
    }
    add_token(Tok::Embedded, open + 1, close, 0, 0, true, pcx);
    close
}

// The `}` matching the `{` at src[open], outside `//` comments and nested
// `/* */` comments (WGSL's rules, std::gpu::wgsl::lex); -1 - the position
// of the innermost `{` left open when there is none.
pub fn embed_block_end(src: &[u8], open: i64) -> i64 {
    let mut depth: i64 = 0;
    let mut p = open;
    while p < src.len() as i64 {
        let c = src[p as usize];
        if c == b'/' && p + 1 < src.len() as i64
            && (src[(p + 1) as usize] == b'/' || src[(p + 1) as usize] == b'*') {
            p = comment_end(src, p);
            continue;
        }
        if c == b'{' {
            depth += 1;
        } else if c == b'}' {
            depth -= 1;
            if depth == 0 {
                return p;
            }
        }
        p += 1;
    }
    -1 - innermost_open(src, open)
}

// The innermost `{` left open at the end of src, from the `{` at `open`
// (none closes it).
fn innermost_open(src: &[u8], open: i64) -> i64 {
    let mut opens: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut p = open;
    while p < src.len() as i64 {
        let c = src[p as usize];
        if c == b'/' && p + 1 < src.len() as i64
            && (src[(p + 1) as usize] == b'/' || src[(p + 1) as usize] == b'*') {
            p = comment_end(src, p);
            continue;
        }
        if c == b'{' {
            opens.push(p);
        } else if c == b'}' && opens.len() > 0 {
            opens.pop();
        }
        p += 1;
    }
    if opens.len() == 0 { open } else { opens[(opens.len() as i64 - 1) as usize] }
}

// The position after the comment at src[p0]: a `//` comment to its line's
// end, a `/* */` one (they nest) past its `*/`, or the text's end when it
// is not closed.
pub fn comment_end(src: &[u8], p0: i64) -> i64 {
    let mut p = p0 + 2;
    if src[(p0 + 1) as usize] == b'/' {
        while p < src.len() as i64 && src[p as usize] != b'\n' {
            p += 1;
        }
        return p;
    }
    let mut depth: i64 = 1;
    while p < src.len() as i64 {
        if src[p as usize] == b'/' && p + 1 < src.len() as i64 && src[(p + 1) as usize] == b'*' {
            depth += 1;
            p += 2;
        }
        else if src[p as usize] == b'*' && p + 1 < src.len() as i64
            && src[(p + 1) as usize] == b'/' {
            depth -= 1;
            p += 2;
            if depth == 0 {
                return p;
            }
        } else {
            p += 1;
        }
    }
    p
}

// (query grep) Whether byte `at` of an embedded block's text is in one
// of its comments (WGSL's: `//` to the line's end, nested `/* */`).
pub fn in_embedded_comment(text: &[u8], at: i64) -> bool {
    let mut p: i64 = 0;
    while p < text.len() as i64 && p <= at {
        if text[p as usize] == b'/' && p + 1 < text.len() as i64
            && (text[(p + 1) as usize] == b'/' || text[(p + 1) as usize] == b'*') {
            let e = comment_end(text, p);
            if at < e {
                return true;
            }
            p = e;
            continue;
        }
        p += 1;
    }
    false
}

// embed.unterminated at the `{` at `open`; `inner` is the innermost `{`
// left open (the block's own or one in its text).
fn unterminated(open: i64, inner: i64, pcx: &mut Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"embed.unterminated";
    err_begin(open, pcx);
    let m = buf_new();
    buf_bytes(m, b"unterminated embedded block: no '}' closes this '{'");
    if inner != open {
        buf_bytes(m, b" (the '{' at line ");
        buf_int(m, line_of(inner, pcx));
        buf_bytes(m, b" is the last left open)");
    }
    err_fmt(str::from_utf8(&buf_copy(m)).unwrap(), pcx);
    err_help(
        c"a block's text ends at the '}' that matches its '{', outside '//' and '/* */' comments", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
    err_jump(pcx)
}

// The 1-based line of position pos in its file.
fn line_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut start: i64 = 0;
    if program_text(pcx) {
        start = pcx.files[file_of_pos(pos, pcx) as usize].start;
    }
    let mut line: i64 = 1;
    for i in start..pos {
        if get_src()[i as usize] == b'\n' {
            line += 1;
        }
    }
    line
}
