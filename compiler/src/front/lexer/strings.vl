// The lexer's strings and characters (0.15: split from front/lexer.vl,
// which calls them from lex_token): string, C string and f-string
// literals (lex_fstring: FHead, the holes' tokens, FMid, FTail), character
// literals and their escapes; STRS, the strings' table.

use crate::base::{
    alloc_zeroed, buf_at, buf_byte, buf_bytes, buf_clear, buf_done, buf_len, buf_new, buf_slice,
    buf_truncate, elem_at, get_src, grow, memcpy,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_fix, err_fmt, err_help, err_str, err_try_fmt, error_at,
};
use crate::front::lexer::{
    Tok, at_end, get_str_cap, get_str_count, get_strs, lex_token, peek_at, push_token, set_str_cap,
    set_str_count, set_strs, skip_whitespace_and_comments,
};
use crate::front::lexer::Tok::{CStr, Char, Str};
use crate::front::lexer::blocks::{at_ftext_block, ftext_line, in_ftext_block, open_ftext_block};

// ---- Strings and characters ----

pub fn add_string(bytes: &[u8]) -> i64 {
    unsafe {
        set_strs({
            let mut str_cap_copy = get_str_cap();
            let r_copy = grow(get_strs(), get_str_count(), &mut str_cap_copy);
            set_str_cap(str_cap_copy); r_copy
        });
        let n = bytes.len() as i64;
        let copy = alloc_zeroed(n + 1);
        memcpy(copy, bytes.ptr, n as u64);
        *elem_at(get_strs(), get_str_count()) = std::slice::from_raw_parts(copy.add((0) as usize),
            (n - (0)) as usize);
        set_str_count(get_str_count() + (1));
        get_str_count() - 1
    }
}

// After a backslash in a string: a line continuation (0.9) is skipped
// (the line break and the next line's leading whitespace are not part of
// the string), and true returned.
fn line_continuation(pcx: &mut Ctx<Comp>) -> bool {
    if at_end(pcx)
        || !(peek_at(0, pcx) == b'\n' || (peek_at(0, pcx) == b'\r' && peek_at(1, pcx) == b'\n')) {
        return false;
    }
    while !at_end(pcx)
        && (peek_at(0, pcx) == b' ' || peek_at(0, pcx) == b'\t' || peek_at(0, pcx) == b'\n'
            || peek_at(0, pcx) == b'\r') {
        pcx.lex_pos += 1;
    }
    true
}

// `"..."` or `c"..."` starting at `start`.
pub fn lex_string(start: i64, is_c: bool, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.lex_pos += if is_c { 2 } else { 1 };
        buf_clear(pcx.lex_scratch);
        loop {
            plain_run(false, pcx);
            if at_end(pcx) {
                error_at(start, c"unterminated string literal", pcx);
            }
            let c = peek_at(0, pcx);
            pcx.lex_pos += 1;
            if c == b'"' {
                break;
            }
            if c == b'\n' {
                error_at(pcx.lex_pos - 1, c"newline in string literal", pcx);
            }
            if c == b'\\' && line_continuation(pcx) {
                continue;
            }
            if c == b'\\' {
                lex_escape(pcx.lex_scratch, in_char: false, pcx: pcx);
            } else {
                buf_byte(pcx.lex_scratch, c);
            }
        }
        if is_c && buf_slice(pcx.lex_scratch).contains(&0) {
            error_at(start, c"C string literal contains a NUL byte", pcx);
        }
        let id = add_string(buf_slice(pcx.lex_scratch));
        // (0.27.3: `b"..."`, the rust edition's byte string, suffix 2. RULE: F23.2)
        push_token(if is_c { CStr } else { Str }, start, id as u64,
            if !is_c && crate::base::get_src()[start as usize] == b'b' { 2 } else { 0 }, pcx);
    }
}

// `f"..."` starting at `start` (0.15): FHead, then for each hole its
// tokens and an FMid, the last one an FTail (see Tok). A hole ends at the
// `}` that closes it, or at a `:` outside brackets, which starts its spec
// (the bytes up to the `}`).
pub fn lex_fstring(start: i64, pcx: &mut Ctx<Comp>) {
    pcx.lex_pos += 2;
    let mut more = false;
    if at_ftext_block(start, pcx) {
        // (0.25.4) `f"""`: a text block with holes (lexer/blocks)
        buf_clear(pcx.lex_scratch);
        if !open_ftext_block(start, pcx) {
            more = lex_fstring_text(start, pcx);
        }
    } else {
        more = lex_fstring_text(start, pcx);
    }
    let head = add_string(
        buf_slice(pcx.lex_scratch));
    push_token(Tok::FHead, start, head as u64, if more { 0 } else { 1 }, pcx);
    while more {
        let hole = pcx.lex_pos;
        let first = pcx.toks.len() as i64;
        // (braces end the hole; any bracket protects a `:`; a string
        // literal in a hole is a token of it)
        let mut braces: i64 = 0;
        let mut depth: i64 = 0;
        loop {
            skip_whitespace_and_comments(pcx);
            if at_end(pcx) {
                error_at(start, c"unterminated f-string", pcx);
            }
            let c = peek_at(0, pcx);
            if braces == 0 && c == b'}' || depth == 0 && c == b':' && peek_at(1, pcx) != b':' {
                break;
            }
            if c == b'f' && peek_at(1, pcx) == b'"' {
                error_at(pcx.lex_pos,
                    c"f-strings cannot be nested: compute the inner one in a 'let' first",
                    pcx);
            }
            if c == b'{' {
                braces += 1;
            } else if c == b'}' {
                braces -= 1;
            }
            if c == b'(' || c == b'[' || c == b'{' {
                depth += 1;
            } else if (c == b')' || c == b']' || c == b'}') && depth > 0 {
                depth -= 1;
            }
            lex_token(pcx);
        }
        if pcx.toks.len() as i64 == first {
            error_at(hole - 1,
                c"an f-string hole needs an expression, as in '{x}'; write '{{' for a brace",
                pcx);
        }
        let piece = pcx.lex_pos;
        let mut spec: i64 = -1;
        if peek_at(0, pcx) == b':' {
            pcx.lex_pos += 1;
            let from = pcx.lex_pos;
            while !at_end(pcx) && peek_at(0, pcx) != b'}' && peek_at(0, pcx) != b'"'
                && peek_at(0, pcx) != b'\n' {
                pcx.lex_pos += 1;
            }
            if peek_at(0, pcx) != b'}' {
                error_at(piece, c"unterminated format spec: expected '}'", pcx);
            }
            spec = add_string(&get_src()[from as usize..pcx.lex_pos as usize]);
        }
        pcx.lex_pos += 1;
        more = lex_fstring_text(start, pcx);
        let text = add_string(
            buf_slice(pcx.lex_scratch));
        push_token(if more { Tok::FMid } else { Tok::FTail }, piece, text as u64, spec, pcx);
    }
}

// The text of an f-string up to a hole (its `{` consumed: true) or the
// end (the closing quote consumed: false), in LEX_SCRATCH.
fn lex_fstring_text(start: i64, pcx: &mut Ctx<Comp>) -> bool {
    buf_clear(pcx.lex_scratch);
    loop {
        plain_run(true, pcx);
        if at_end(pcx) {
            error_at(start, c"unterminated string literal", pcx);
        }
        let c = peek_at(0, pcx);
        pcx.lex_pos += 1;
        if c == b'"' && !in_ftext_block(pcx) {
            return false;
        }
        if c == b'{' && peek_at(0, pcx) != b'{' {
            return true;
        }
        if c == b'{' || c == b'}' {
            if peek_at(0, pcx) != c {
                error_at(pcx.lex_pos - 1, c"a single '}' in an f-string: write '}}' for a brace",
                    pcx);
            }
            pcx.lex_pos += 1;
            buf_byte(pcx.lex_scratch, c);
            continue;
        }
        if c == b'\n' && in_ftext_block(pcx) {
            // (0.25.4) a line of an f-string text block ends: a CR
            // before it is not text, the next line's indentation is not
            if pcx.lex_pos >= 2 && get_src()[(pcx.lex_pos - 2) as usize] == b'\r'
                && buf_len(pcx.lex_scratch) > 0 {
                buf_truncate(pcx.lex_scratch, buf_len(pcx.lex_scratch) - 1);
            }
            if ftext_line(pcx.lex_pos, pcx) {
                return false;
            }
            buf_byte(pcx.lex_scratch, b'\n');
            continue;
        }
        if c == b'\n' {
            error_at(pcx.lex_pos - 1, c"newline in string literal", pcx);
        }
        if c == b'\\' && in_ftext_block(pcx)
            && (peek_at(0, pcx) == b'\n' || peek_at(0, pcx) == b'\r' && peek_at(1, pcx) == b'\n') {
            // (a `\` at a line's end joins it to the next)
            let next = pcx.lex_pos + if peek_at(0, pcx) == b'\r' { 2 } else { 1 };
            if ftext_line(next, pcx) {
                return false;
            }
            continue;
        }
        if c == b'\\' && line_continuation(pcx) {
            continue;
        }
        if c == b'\\' {
            lex_escape(pcx.lex_scratch, in_char: false, pcx: pcx);
        } else {
            buf_byte(pcx.lex_scratch, c);
        }
    }
    false
}

// (0.25) The bytes of a string literal from LEX_POS that stand for
// themselves (not '"', '\\' or a newline; in an f-string, not '{' or '}'
// either), appended to LEX_SCRATCH at once; LEX_POS after them.
fn plain_run(braces: bool, pcx: &mut Ctx<Comp>) {
    unsafe {
        let src = get_src();
        let end = pcx.lex_end;
        let from = pcx.lex_pos;
        let mut p = from;
        while p < end {
            let c = src[p as usize];
            if c == b'"' || c == b'\\' || c == b'\n' || braces && (c == b'{' || c == b'}') {
                break;
            }
            p += 1;
        }
        if p > from {
            buf_bytes(pcx.lex_scratch, &src[from as usize..p as usize]);
            pcx.lex_pos = p;
        }
    }
}

pub fn hex_value(c: u8) -> i64 {
    if c >= b'0' && c <= b'9' { return (c - b'0') as i64; }
    if c >= b'a' && c <= b'f' { return (c - b'a') as i64 + 10; }
    if c >= b'A' && c <= b'F' { return (c - b'A') as i64 + 10; }
    -1
}

fn lex_hex_digit(pcx: &mut Ctx<Comp>) -> i64 {
    if at_end(pcx) {
        error_at(pcx.lex_pos, c"expected hex digit", pcx);
    }
    let value = hex_value(peek_at(0, pcx));
    if value < 0 {
        error_at(pcx.lex_pos, c"expected hex digit", pcx);
    }
    pcx.lex_pos += 1;
    value
}

// UTF-8 encoding of a code point.
fn buf_utf8(out: i64, cp: i64) {
    if cp < 0x80 {
        buf_byte(out, cp as u8);
    } else if cp < 0x800 {
        buf_byte(out, (0xc0 | (cp >> 6)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    } else if cp < 0x10000 {
        buf_byte(out, (0xe0 | (cp >> 12)) as u8);
        buf_byte(out, (0x80 | ((cp >> 6) & 0x3f)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    } else {
        buf_byte(out, (0xf0 | (cp >> 18)) as u8);
        buf_byte(out, (0x80 | ((cp >> 12) & 0x3f)) as u8);
        buf_byte(out, (0x80 | ((cp >> 6) & 0x3f)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    }
}

// An escape after '\'; appends its bytes to `out`.
pub fn lex_escape(out: i64, in_char: bool, pcx: &mut Ctx<Comp>) {
    if at_end(pcx) {
        error_at(pcx.lex_pos, c"unterminated escape", pcx);
    }
    let escape_at = pcx.lex_pos;
    let c = peek_at(0, pcx);
    pcx.lex_pos += 1;
    if c == b'n' { buf_byte(out, b'\n'); return; }
    if c == b't' { buf_byte(out, b'\t'); return; }
    if c == b'r' { buf_byte(out, b'\r'); return; }
    if c == b'0' { buf_byte(out, 0); return; }
    if c == b'"' { buf_byte(out, b'"'); return; }
    if c == b'\'' { buf_byte(out, b'\''); return; }
    if c == b'\\' { buf_byte(out, b'\\'); return; }
    if c == b'x' {
        let high = lex_hex_digit(pcx);
        let low = lex_hex_digit(pcx);
        buf_byte(out, ((high << 4) | low) as u8);
        return;
    }
    if c == b'u' {
        let cp = lex_unicode_escape(escape_at - 1, in_char, pcx);
        buf_utf8(out, cp);
        return;
    }
    error_at(escape_at, c"unknown escape", pcx);
}

fn lex_unicode_escape(backslash_at: i64, in_char: bool, pcx: &mut Ctx<Comp>) -> i64 {
    if peek_at(0, pcx) != b'{' || at_end(pcx) {
        error_at(pcx.lex_pos, c"expected '{' after '\\u'", pcx);
    }
    pcx.lex_pos += 1;
    let mut value: i64 = 0;
    let mut digits: i64 = 0;
    while at_end(pcx) || peek_at(0, pcx) != b'}' {
        if digits == 6 {
            error_at(pcx.lex_pos, c"too many digits in '\\u{...}' escape", pcx);
        }
        value = value * 16 + lex_hex_digit(pcx);
        digits += 1;
    }
    pcx.lex_pos += 1;
    if digits == 0 {
        error_at(pcx.lex_pos, c"empty '\\u{}' escape", pcx);
    }
    if value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff) {
        error_at(backslash_at, c"invalid unicode escape", pcx);
    }
    if in_char && value >= 0x80 {
        // RULE: F1.2 (Rust's `char`: any scalar; lex_char decodes it)
        return value;
    }
    if in_char && value >= 0x80 {
        error_at(backslash_at, c"character literal is not ASCII (a character is one byte, u8)",
            pcx);
    }
    value
}

// A character literal at lex_pos (its quote). byte_at >= 0: a byte
// literal `b'x'` of the rust edition whose `b` is there (F23.2). In the
// rust edition a character literal is Rust's `char` (F1.2): its value is
// the scalar, any one, and its token's suffix 1 (2: a byte literal); in
// MVS a character is one byte (u8).
pub fn lex_char(byte_at: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let start = if byte_at >= 0 { byte_at } else { pcx.lex_pos };
        pcx.lex_pos += 1;
        buf_clear(pcx.lex_scratch);
        let c = peek_at(0, pcx);
        if at_end(pcx) || c == b'\n' {
            unterminated_char(start, pcx);
        }
        if c == b'\'' {
            error_at(start, c"empty character literal", pcx);
        }
        // (0.27.0) a lifetime or a label in the rust edition: `'a` not
        // followed by a quote (`'a'` is a character), front/rust
        if byte_at < 0
            && (c == b'_' || c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z')
            && peek_at(1, pcx) != b'\'' {
            let end = ident_end(start + 1, pcx);
            pcx.lex_pos = end;
            push_token(Tok::Lifetime, start,
                crate::base::intern(&get_src()[(start + 1) as usize..end as usize], pcx) as u64, 0,
                pcx);
            return;
        }
        if c == b'\\' {
            pcx.lex_pos += 1;
            lex_escape(pcx.lex_scratch, in_char: true, pcx: pcx);
        } else if c < 0x80 {
            pcx.lex_pos += 1;
            buf_byte(pcx.lex_scratch, c);
        } else {
            // The character's UTF-8 bytes: the lead byte and its continuations.
            let mut end = pcx.lex_pos + 1;
            while end < pcx.lex_end && (get_src()[end as usize] & 0xc0) == 0x80 {
                end += 1;
            }
            if end < pcx.lex_end && get_src()[end as usize] == b'\'' {
                // RULE: F1.2 (the rust edition's `char`: the scalar)
                for k in pcx.lex_pos..end {
                    buf_byte(pcx.lex_scratch, get_src()[k as usize]);
                }
                pcx.lex_pos = end;
            } else {
                err_begin(start, pcx);
                err_fmt(format_args("character literal '{}",
                    &str::from_utf8(get_src()[pcx.lex_pos as usize..end as usize]).unwrap()), pcx);
                err_str(c"' is not ASCII (a character is one byte, u8)", pcx);
                err_end(pcx);
            }
        }
        if at_end(pcx) || peek_at(0, pcx) != b'\'' {
            unterminated_char(start, pcx);
        }
        pcx.lex_pos += 1;
        let len = buf_len(pcx.lex_scratch);
        // (the literal's bytes, 0 where it has fewer: an error is reported)
        let mut bytes: [u8; 4] = [0u8; 4];
        for k in 0..len.min(4) {
            bytes[k as usize] = buf_at(pcx.lex_scratch, k);
        }
        if byte_at >= 0 {
            // RULE: F23.2 (`b'x'`: one byte, ASCII or `\xHH`)
            let escape = get_src()[(byte_at + 2) as usize] == b'\\';
            if len != 1 || bytes[0] >= 0x80 && !escape
                || escape && byte_at + 3 < pcx.lex_end
                && get_src()[(byte_at + 3) as usize] == b'u' {
                error_at(start, c"a byte literal is one ASCII character or a '\\xHH' escape",
                    pcx);
            }
            push_token(Char, start, bytes[0] as u64, 2, pcx);
            return;
        }
        // (the scalar of the UTF-8 bytes)
        let mut v = bytes[0] as u64;
        if len == 2 {
            v = (v & 0x1f) << 6 | (bytes[1] & 0x3f) as u64;
        } else if len == 3 {
            v = (v & 0x0f) << 12 | ((bytes[1] & 0x3f) as u64) << 6 | (bytes[2] & 0x3f) as u64;
        } else if len >= 4 {
            v = (v & 0x07) << 18 | ((bytes[1] & 0x3f) as u64) << 12
                | ((bytes[2] & 0x3f) as u64) << 6 | (bytes[3] & 0x3f) as u64;
        }
        push_token(Char, start, v, 1, pcx);
    }
}

// (0.17) An unterminated character literal at `start`: a Rust label or
// lifetime (`'outer:`, `'a`) has no quote in vole (a label: the line
// respelled, `outer: loop { break :outer; }`, is the try: line); several
// characters are a string (the try: line); a lone quote, often a shell's
// doing, says how to write one.
fn unterminated_char(start: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(start, pcx);
    err_str(c"unterminated character literal", pcx);
    let mut e = start + 1;
    while e < pcx.lex_end && get_src()[e as usize] != b'\'' && get_src()[e as usize] != b'\n' {
        e += 1;
    }
    let word = ident_end(start + 1, pcx);
    let mut before = start;
    while before > 0 && get_src()[(before - 1) as usize] == b' ' {
        before -= 1;
    }
    let after_jump = (before >= 5 && get_src()[(before - 5) as usize..before as usize] == b"break")
        || (before >= 8 && get_src()[(before - 8) as usize..before as usize] == b"continue");
    let label = word > start + 1 && word < pcx.lex_end && get_src()[word as usize] != b'\''
        && (get_src()[word as usize] == b':' || after_jump);
    if label {
        err_help(c"a label has no quote: `outer: loop { break :outer; }`", pcx);
        let line = label_line(start, pcx);
        err_try_fmt(str::from_utf8(line).unwrap(), pcx);
        // (0.18) the fix: the line so respelled (from its first word)
        let mut a = start;
        while a > 0 && get_src()[(a - 1) as usize] != b'\n' {
            a -= 1;
        }
        while a < start && (get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\t') {
            a += 1;
        }
        let mut eol = start;
        while eol < pcx.lex_end && get_src()[eol as usize] != b'\n' {
            eol += 1;
        }
        err_fix(a, eol, line, pcx);
    } else if e < pcx.lex_end && get_src()[e as usize] == b'\'' && e > start + 2 {
        err_help(c"a character literal is one byte; text is a string", pcx);
        err_try_fmt(format_args("\"{}\"",
            &str::from_utf8(get_src()[(start + 1) as usize..e as usize]).unwrap()), pcx);
    } else if word > start + 1 {
        err_help(c"labels and lifetimes have no quote: `outer: loop { break :outer; }`; vole has no lifetimes (`&'a T` is `*T`)", pcx);
    } else {
        // (0.18.1: `'\''` written in a shell's single quotes reaches
        // the compiler as a lone `'`)
        err_help(c"a lone quote: the quote byte is '\\'' (39), the backslash '\\\\'; inside a shell's single quotes, '\\'' arrives as ', so put the code in a file ('volec try --file F')", pcx);
    }
    err_end(pcx)
}

// The end of the identifier from `i` (i itself when none starts there).
fn ident_end(i: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut j = i;
    while j < pcx.lex_end
        && (get_src()[j as usize] == b'_'
            || get_src()[j as usize] >= b'a' && get_src()[j as usize] <= b'z'
            || get_src()[j as usize] >= b'A' && get_src()[j as usize] <= b'Z'
            || get_src()[j as usize] >= b'0' && get_src()[j as usize] <= b'9') {
        j += 1;
    }
    j
}

// The line of `start` with Rust's labels respelled: `'outer:` as
// `outer:`, `break 'outer` as `break :outer` (character literals kept).
fn label_line(start: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let mut eol = start;
    while eol < pcx.lex_end && get_src()[eol as usize] != b'\n' {
        eol += 1;
    }
    let b = buf_new();
    let mut i = start;
    while i > 0 && get_src()[(i - 1) as usize] != b'\n' {
        i -= 1;
    }
    while i < start && (get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\t') {
        i += 1;
    }
    while i < eol {
        let j = ident_end(i + 1, pcx);
        if get_src()[i as usize] == b'\'' && j > i + 1
            && (j == eol || get_src()[j as usize] != b'\'') {
            if j == eol || get_src()[j as usize] != b':' {
                buf_byte(b, b':');
            }
            buf_bytes(b, &get_src()[(i + 1) as usize..j as usize]);
            i = j;
            continue;
        }
        buf_byte(b, get_src()[i as usize]);
        i += 1;
    }
    // (b is not written again: its view lasts the process, buf_done)
    buf_done(b)
}
