// The lexer's strings and characters (0.15: split from front/lexer.vl,
// which calls them from lex_token): string, C string and f-string
// literals (lex_fstring: FHead, the holes' tokens, FMid, FTail), character
// literals and their escapes; STRS, the strings' table.

use crate::base::{
    BUFS, SRC, alloc_zeroed, buf_byte, buf_bytes, buf_clear, buf_new, buf_slice, elem_at, grow,
    memcpy,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_fix, err_fmt, err_help, err_str, err_try_fmt, error_at,
};
use crate::front::lexer::{
    STRS, STR_CAP, STR_COUNT, Tok, at_end, lex_token, peek_at, push_token,
    skip_whitespace_and_comments,
};
use crate::front::lexer::Tok::{CStr, Char, Str};
use crate::front::lexer::blocks::{at_ftext_block, ftext_line, in_ftext_block, open_ftext_block};

// ---- Strings and characters ----

pub fn add_string(bytes: [u8]) -> i64 {
    unsafe {
        STRS = grow(STRS, STR_COUNT, &STR_CAP);
        let n = bytes.len as i64;
        let copy = alloc_zeroed(n + 1);
        memcpy(copy, bytes.ptr, n as u64);
        *elem_at(STRS, STR_COUNT) = copy[0..n];
        STR_COUNT += 1;
        STR_COUNT - 1
    }
}

// After a backslash in a string: a line continuation (0.9) is skipped
// (the line break and the next line's leading whitespace are not part of
// the string), and true returned.
fn line_continuation(pcx: inout Ctx<Comp>) -> bool {
    if at_end(pcx)
        || !(peek_at(0, pcx) == '\n' || (peek_at(0, pcx) == '\r' && peek_at(1, pcx) == '\n')) {
        return false;
    }
    while !at_end(pcx)
        && (peek_at(0, pcx) == ' ' || peek_at(0, pcx) == '\t' || peek_at(0, pcx) == '\n'
            || peek_at(0, pcx) == '\r') {
        pcx.lex_pos += 1;
    }
    true
}

// `"..."` or `c"..."` starting at `start`.
pub fn lex_string(start: i64, is_c: bool, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.lex_pos += if is_c { 2 } else { 1 };
        buf_clear(pcx.lex_scratch);
        loop {
            plain_run(false, &pcx);
            if at_end(pcx) {
                error_at(start, c"unterminated string literal", &pcx);
            }
            let c = peek_at(0, pcx);
            pcx.lex_pos += 1;
            if c == '"' {
                break;
            }
            if c == '\n' {
                error_at(pcx.lex_pos - 1, c"newline in string literal", &pcx);
            }
            if c == '\\' && line_continuation(&pcx) {
                continue;
            }
            if c == '\\' {
                lex_escape(pcx.lex_scratch, in_char: false, pcx: &pcx);
            } else {
                buf_byte(pcx.lex_scratch, c);
            }
        }
        let bytes = BUFS[pcx.lex_scratch].data;
        let n = BUFS[pcx.lex_scratch].len;
        if is_c {
            for i in 0..n {
                if bytes[i] == 0 {
                    error_at(start, c"C string literal contains a NUL byte", &pcx);
                }
            }
        }
        let id = add_string(bytes[0..n]);
        push_token(if is_c { CStr } else { Str }, start, id as u64, 0, &pcx);
    }
}

// `f"..."` starting at `start` (0.15): FHead, then for each hole its
// tokens and an FMid, the last one an FTail (see Tok). A hole ends at the
// `}` that closes it, or at a `:` outside brackets, which starts its spec
// (the bytes up to the `}`).
pub fn lex_fstring(start: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.lex_pos += 2;
        var more = false;
        if at_ftext_block(start, pcx) {
            // (0.25.4) `f"""`: a text block with holes (lexer/blocks)
            buf_clear(pcx.lex_scratch);
            if !open_ftext_block(start, &pcx) {
                more = lex_fstring_text(start, &pcx);
            }
        } else {
            more = lex_fstring_text(start, &pcx);
        }
        let head = add_string(BUFS[pcx.lex_scratch].data[0..BUFS[pcx.lex_scratch].len]);
        push_token(Tok::FHead, start, head as u64, if more { 0 } else { 1 }, &pcx);
        while more {
            let hole = pcx.lex_pos;
            let first = pcx.toks.len() as i64;
            // (braces end the hole; any bracket protects a `:`; a string
            // literal in a hole is a token of it)
            var braces = 0;
            var depth = 0;
            loop {
                skip_whitespace_and_comments(&pcx);
                if at_end(pcx) {
                    error_at(start, c"unterminated f-string", &pcx);
                }
                let c = peek_at(0, pcx);
                if braces == 0 && c == '}' || depth == 0 && c == ':' && peek_at(1, pcx) != ':' {
                    break;
                }
                if c == 'f' && peek_at(1, pcx) == '"' {
                    error_at(pcx.lex_pos,
                        c"f-strings cannot be nested: compute the inner one in a 'let' first",
                        &pcx);
                }
                if c == '{' {
                    braces += 1;
                } else if c == '}' {
                    braces -= 1;
                }
                if c == '(' || c == '[' || c == '{' {
                    depth += 1;
                } else if (c == ')' || c == ']' || c == '}') && depth > 0 {
                    depth -= 1;
                }
                lex_token(&pcx);
            }
            if pcx.toks.len() as i64 == first {
                error_at(hole - 1,
                    c"an f-string hole needs an expression, as in '{x}'; write '{{' for a brace",
                    &pcx);
            }
            let piece = pcx.lex_pos;
            var spec = -1;
            if peek_at(0, pcx) == ':' {
                pcx.lex_pos += 1;
                let from = pcx.lex_pos;
                while !at_end(pcx) && peek_at(0, pcx) != '}' && peek_at(0, pcx) != '"'
                    && peek_at(0, pcx) != '\n' {
                    pcx.lex_pos += 1;
                }
                if peek_at(0, pcx) != '}' {
                    error_at(piece, c"unterminated format spec: expected '}'", &pcx);
                }
                spec = add_string(SRC[from..pcx.lex_pos]);
            }
            pcx.lex_pos += 1;
            more = lex_fstring_text(start, &pcx);
            let text = add_string(BUFS[pcx.lex_scratch].data[0..BUFS[pcx.lex_scratch].len]);
            push_token(if more { Tok::FMid } else { Tok::FTail }, piece, text as u64, spec, &pcx);
        }
    }
}

// The text of an f-string up to a hole (its `{` consumed: true) or the
// end (the closing quote consumed: false), in LEX_SCRATCH.
fn lex_fstring_text(start: i64, pcx: inout Ctx<Comp>) -> bool {
    buf_clear(pcx.lex_scratch);
    loop {
        plain_run(true, &pcx);
        if at_end(pcx) {
            error_at(start, c"unterminated string literal", &pcx);
        }
        let c = peek_at(0, pcx);
        pcx.lex_pos += 1;
        if c == '"' && !in_ftext_block(pcx) {
            return false;
        }
        if c == '{' && peek_at(0, pcx) != '{' {
            return true;
        }
        if c == '{' || c == '}' {
            if peek_at(0, pcx) != c {
                error_at(pcx.lex_pos - 1, c"a single '}' in an f-string: write '}}' for a brace",
                    &pcx);
            }
            pcx.lex_pos += 1;
            buf_byte(pcx.lex_scratch, c);
            continue;
        }
        if c == '\n' && in_ftext_block(pcx) {
            // (0.25.4) a line of an f-string text block ends: a CR
            // before it is not text, the next line's indentation is not
            // UNSAFE: SRC and BUFS are the front end's tables, raw pointers (base).
            // SAFETY: 2 <= LEX_POS and LEX_POS is within the file being lexed, inside
            // SRC; LEX_SCRATCH is a buffer of BUFS, made before the lexer runs.
            unsafe {
                if pcx.lex_pos >= 2 && SRC[pcx.lex_pos - 2] == '\r'
                    && BUFS[pcx.lex_scratch].len > 0 {
                    BUFS[pcx.lex_scratch].len -= 1;
                }
            }
            if ftext_line(pcx.lex_pos, &pcx) {
                return false;
            }
            buf_byte(pcx.lex_scratch, '\n');
            continue;
        }
        if c == '\n' {
            error_at(pcx.lex_pos - 1, c"newline in string literal", &pcx);
        }
        if c == '\\' && in_ftext_block(pcx)
            && (peek_at(0, pcx) == '\n' || peek_at(0, pcx) == '\r' && peek_at(1, pcx) == '\n') {
            // (a `\` at a line's end joins it to the next)
            let next = pcx.lex_pos + if peek_at(0, pcx) == '\r' { 2 } else { 1 };
            if ftext_line(next, &pcx) {
                return false;
            }
            continue;
        }
        if c == '\\' && line_continuation(&pcx) {
            continue;
        }
        if c == '\\' {
            lex_escape(pcx.lex_scratch, in_char: false, pcx: &pcx);
        } else {
            buf_byte(pcx.lex_scratch, c);
        }
    }
    false
}

// (0.25) The bytes of a string literal from LEX_POS that stand for
// themselves (not '"', '\\' or a newline; in an f-string, not '{' or '}'
// either), appended to LEX_SCRATCH at once; LEX_POS after them.
fn plain_run(braces: bool, pcx: inout Ctx<Comp>) {
    unsafe {
        let src = SRC.ptr;
        let end = pcx.lex_end;
        let from = pcx.lex_pos;
        var p = from;
        while p < end {
            let c = src[p];
            if c == '"' || c == '\\' || c == '\n' || braces && (c == '{' || c == '}') {
                break;
            }
            p += 1;
        }
        if p > from {
            buf_bytes(pcx.lex_scratch, src[from..p]);
            pcx.lex_pos = p;
        }
    }
}

pub fn hex_value(c: u8) -> i64 {
    if c >= '0' && c <= '9' { return (c - '0') as i64; }
    if c >= 'a' && c <= 'f' { return (c - 'a') as i64 + 10; }
    if c >= 'A' && c <= 'F' { return (c - 'A') as i64 + 10; }
    -1
}

fn lex_hex_digit(pcx: inout Ctx<Comp>) -> i64 {
    if at_end(pcx) {
        error_at(pcx.lex_pos, c"expected hex digit", &pcx);
    }
    let value = hex_value(peek_at(0, pcx));
    if value < 0 {
        error_at(pcx.lex_pos, c"expected hex digit", &pcx);
    }
    pcx.lex_pos += 1;
    value
}

// UTF-8 encoding of a code point.
fn buf_utf8(out: i64, cp: i64) {
    if cp < 0x80 {
        buf_byte(out, cp as u8);
    } else if cp < 0x800 {
        buf_byte(out, (0xc0 | (cp >> 6)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    } else if cp < 0x10000 {
        buf_byte(out, (0xe0 | (cp >> 12)) as u8);
        buf_byte(out, (0x80 | ((cp >> 6) & 0x3f)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    } else {
        buf_byte(out, (0xf0 | (cp >> 18)) as u8);
        buf_byte(out, (0x80 | ((cp >> 12) & 0x3f)) as u8);
        buf_byte(out, (0x80 | ((cp >> 6) & 0x3f)) as u8);
        buf_byte(out, (0x80 | (cp & 0x3f)) as u8);
    }
}

// An escape after '\'; appends its bytes to `out`.
pub fn lex_escape(out: i64, in_char: bool, pcx: inout Ctx<Comp>) {
    if at_end(pcx) {
        error_at(pcx.lex_pos, c"unterminated escape", &pcx);
    }
    let escape_at = pcx.lex_pos;
    let c = peek_at(0, pcx);
    pcx.lex_pos += 1;
    if c == 'n' { buf_byte(out, '\n'); return; }
    if c == 't' { buf_byte(out, '\t'); return; }
    if c == 'r' { buf_byte(out, '\r'); return; }
    if c == '0' { buf_byte(out, 0); return; }
    if c == '"' { buf_byte(out, '"'); return; }
    if c == '\'' { buf_byte(out, '\''); return; }
    if c == '\\' { buf_byte(out, '\\'); return; }
    if c == 'x' {
        let high = lex_hex_digit(&pcx);
        let low = lex_hex_digit(&pcx);
        buf_byte(out, ((high << 4) | low) as u8);
        return;
    }
    if c == 'u' {
        let cp = lex_unicode_escape(escape_at - 1, in_char, &pcx);
        buf_utf8(out, cp);
        return;
    }
    error_at(escape_at, c"unknown escape", &pcx);
}

fn lex_unicode_escape(backslash_at: i64, in_char: bool, pcx: inout Ctx<Comp>) -> i64 {
    if peek_at(0, pcx) != '{' || at_end(pcx) {
        error_at(pcx.lex_pos, c"expected '{' after '\\u'", &pcx);
    }
    pcx.lex_pos += 1;
    var value = 0;
    var digits = 0;
    while at_end(pcx) || peek_at(0, pcx) != '}' {
        if digits == 6 {
            error_at(pcx.lex_pos, c"too many digits in '\\u{...}' escape", &pcx);
        }
        value = value * 16 + lex_hex_digit(&pcx);
        digits += 1;
    }
    pcx.lex_pos += 1;
    if digits == 0 {
        error_at(pcx.lex_pos, c"empty '\\u{}' escape", &pcx);
    }
    if value > 0x10ffff || (value >= 0xd800 && value <= 0xdfff) {
        error_at(backslash_at, c"invalid unicode escape", &pcx);
    }
    if in_char && value >= 0x80 {
        error_at(backslash_at, c"character literal is not ASCII (a character is one byte, u8)",
            &pcx);
    }
    value
}

pub fn lex_char(pcx: inout Ctx<Comp>) {
    unsafe {
        let start = pcx.lex_pos;
        pcx.lex_pos += 1;
        buf_clear(pcx.lex_scratch);
        let c = peek_at(0, pcx);
        if at_end(pcx) || c == '\n' {
            unterminated_char(start, &pcx);
        }
        if c == '\'' {
            error_at(start, c"empty character literal", &pcx);
        }
        // (0.27.0) a lifetime or a label in the rust edition: `'a` not
        // followed by a quote (`'a'` is a character), front/rust
        if pcx.edition != 0 && (c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z')
            && peek_at(1, pcx) != '\'' && crate::front::rust::rust_at(start, &pcx) {
            let end = ident_end(start + 1, pcx);
            pcx.lex_pos = end;
            push_token(Tok::Lifetime, start, crate::base::intern(SRC[start + 1..end]) as u64, 0,
                &pcx);
            return;
        }
        if c == '\\' {
            pcx.lex_pos += 1;
            lex_escape(pcx.lex_scratch, in_char: true, pcx: &pcx);
        } else if c < 0x80 {
            pcx.lex_pos += 1;
            buf_byte(pcx.lex_scratch, c);
        } else {
            // The character's UTF-8 bytes: the lead byte and its continuations.
            var end = pcx.lex_pos + 1;
            while end < pcx.lex_end && (SRC[end] & 0xc0) == 0x80 {
                end += 1;
            }
            err_begin(start, &pcx);
            err_fmt(format_args("character literal '{}", SRC[pcx.lex_pos..end]), pcx);
            err_str(c"' is not ASCII (a character is one byte, u8)", pcx);
            err_end(&pcx);
        }
        if at_end(pcx) || peek_at(0, pcx) != '\'' {
            unterminated_char(start, &pcx);
        }
        pcx.lex_pos += 1;
        push_token(Char, start, BUFS[pcx.lex_scratch].data[0], 0, &pcx);
    }
}

// (0.17) An unterminated character literal at `start`: a Rust label or
// lifetime (`'outer:`, `'a`) has no quote in vole (a label: the line
// respelled, `outer: loop { break :outer; }`, is the try: line); several
// characters are a string (the try: line); a lone quote, often a shell's
// doing, says how to write one.
fn unterminated_char(start: i64, pcx: inout Ctx<Comp>) -> ! {
    err_begin(start, &pcx);
    err_str(c"unterminated character literal", pcx);
    var e = start + 1;
    while e < pcx.lex_end && SRC[e] != '\'' && SRC[e] != '\n' {
        e += 1;
    }
    let word = ident_end(start + 1, pcx);
    var before = start;
    while before > 0 && SRC[before - 1] == ' ' {
        before -= 1;
    }
    let after_jump = (before >= 5 && SRC[before - 5..before] == "break")
        || (before >= 8 && SRC[before - 8..before] == "continue");
    let label = word > start + 1 && word < pcx.lex_end && SRC[word] != '\''
        && (SRC[word] == ':' || after_jump);
    if label {
        err_help(c"a label has no quote: `outer: loop { break :outer; }`", pcx);
        let line = label_line(start, pcx);
        err_try_fmt(line, pcx);
        // (0.18) the fix: the line so respelled (from its first word)
        var a = start;
        while a > 0 && SRC[a - 1] != '\n' {
            a -= 1;
        }
        while a < start && (SRC[a] == ' ' || SRC[a] == '\t') {
            a += 1;
        }
        var eol = start;
        while eol < pcx.lex_end && SRC[eol] != '\n' {
            eol += 1;
        }
        err_fix(a, eol, line, &pcx);
    } else if e < pcx.lex_end && SRC[e] == '\'' && e > start + 2 {
        err_help(c"a character literal is one byte; text is a string", pcx);
        err_try_fmt(format_args("\"{}\"", SRC[start + 1..e]), pcx);
    } else if word > start + 1 {
        err_help(c"labels and lifetimes have no quote: `outer: loop { break :outer; }`; vole has no lifetimes (`&'a T` is `*T`)", pcx);
    } else {
        // (0.18.1: `'\''` written in a shell's single quotes reaches
        // the compiler as a lone `'`)
        err_help(c"a lone quote: the quote byte is '\\'' (39), the backslash '\\\\'; inside a shell's single quotes, '\\'' arrives as ', so put the code in a file ('volec try --file F')", pcx);
    }
    err_end(&pcx)
}

// The end of the identifier from `i` (i itself when none starts there).
fn ident_end(i: i64, pcx: Ctx<Comp>) -> i64 {
    var j = i;
    while j < pcx.lex_end && (SRC[j] == '_' || SRC[j] >= 'a' && SRC[j] <= 'z'
        || SRC[j] >= 'A' && SRC[j] <= 'Z' || SRC[j] >= '0' && SRC[j] <= '9') {
        j += 1;
    }
    j
}

// The line of `start` with Rust's labels respelled: `'outer:` as
// `outer:`, `break 'outer` as `break :outer` (character literals kept).
fn label_line(start: i64, pcx: Ctx<Comp>) -> [u8] {
    var eol = start;
    while eol < pcx.lex_end && SRC[eol] != '\n' {
        eol += 1;
    }
    let b = buf_new();
    var i = start;
    while i > 0 && SRC[i - 1] != '\n' {
        i -= 1;
    }
    while i < start && (SRC[i] == ' ' || SRC[i] == '\t') {
        i += 1;
    }
    while i < eol {
        let j = ident_end(i + 1, pcx);
        if SRC[i] == '\'' && j > i + 1 && (j == eol || SRC[j] != '\'') {
            if j == eol || SRC[j] != ':' {
                buf_byte(b, ':');
            }
            buf_bytes(b, SRC[i + 1..j]);
            i = j;
            continue;
        }
        buf_byte(b, SRC[i]);
        i += 1;
    }
    buf_slice(b)
}
