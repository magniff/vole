// Text blocks (0.25.3): string literals of several lines.
//
//     let s = """
//         line one
//           line two
//         """;
//
// `"""` ending its line opens one; a line whose first non-blank bytes are
// `"""` closes it. The closing line's indentation is removed from every
// line (a line indented less is lex.text-block-indent; a blank line may
// be shorter); the line break after the opening `"""` and the one before
// the closing line are not part of the value, and every line break in it
// is '\n' (a CRLF file's too). Escapes work as in "...", and a `\` at the
// end of a line joins it to the next. `r"""` opens a raw block: no
// escapes at all; `r#"""` .. `"""#` (any number of `#`s) one whose text
// may hold a line starting with `"""`. The token is a Str, as "...".
// (0.25.4) `f"""` is an f-string text block: the same lines and dedent,
// and an f-string's holes (lexer/strings: lex_fstring; open_ftext_block,
// ftext_line here).

use crate::base::{buf_byte, buf_bytes, buf_clear, buf_copy, buf_fmt, buf_new, buf_ptr, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fix, err_fmt, err_help, err_jump};
use crate::front::lexer::push_token;
use crate::front::lexer::Tok::Str;
use crate::front::lexer::strings::{add_string, lex_escape};

// The number of `#`s of a raw text block at LEX_POS (`r"""`: 0,
// `r##"""`: 2), or -1 when there is none there.
pub fn raw_block_hashes(pcx: &Ctx<Comp>) -> i64 {
    let src = src(pcx);
    let mut p = pcx.lex_pos + 1;
    while p < src.len() as i64 && src[p as usize] == b'#' {
        p += 1;
    }
    if quotes_at(src, p) {
        return p - pcx.lex_pos - 1;
    }
    -1
}

// The text being lexed, SRC up to LEX_END.
fn src(pcx: &Ctx<Comp>) -> &'static [u8] {
    &get_src()[0..pcx.lex_end as usize]
}

// Whether src[p..] starts with `"""`.
fn quotes_at(src: &[u8], p: i64) -> bool {
    p >= 0 && p + 2 < src.len() as i64 && src[p as usize] == b'"' && src[(p + 1) as usize] == b'"'
        && src[(p + 2) as usize] == b'"'
}

// Whether a plain text block starts at LEX_POS: `"""`.
pub fn at_text_block(pcx: &Ctx<Comp>) -> bool {
    quotes_at(src(pcx), pcx.lex_pos)
}

// A coded error of the lexer at `pos`: the message, the help (when not
// empty), its fix (SRC[pos..fix_end) replaced by `fix`, when fix_end >=
// pos: `volec fix --suggested`); fatal when `fatal`, else the lexing goes
// on.
fn block_error(code: *mut u8, pos: i64, message: &[u8], help: &[u8], fix_end: i64, fix: &[u8],
    fatal: bool, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = code;
    err_begin(pos, pcx);
    err_fmt(str::from_utf8(message).unwrap(), pcx);
    if help.len() > 0 {
        let h = buf_new();
        buf_bytes(h, help);
        buf_byte(h, 0);
        err_help(buf_ptr(h), pcx);
    }
    if fix_end >= pos {
        err_fix(pos, fix_end, fix, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
    if fatal {
        err_jump(pcx);
    }
}

// Whether SRC[p..) is the closing delimiter of a block with `hashes`
// `#`s: `"""` and the `#`s.
fn closes_at(src: &[u8], p: i64, hashes: i64) -> bool {
    if !quotes_at(src, p) {
        return false;
    }
    for k in 0..hashes {
        if p + 3 + k >= src.len() as i64 || src[(p + 3 + k) as usize] != b'#' {
            return false;
        }
    }
    true
}

// The closing line of a block whose text starts at `body`: the first line
// whose first non-blank bytes close it (`"""` and `hashes` `#`s): its
// start and where its delimiter is (its indentation between); (-1, -1)
// when there is none.
fn closing_line(src: &[u8], body: i64, hashes: i64) -> (i64, i64) {
    let end = src.len() as i64;
    let mut line = body;
    while line < end {
        let mut q = line;
        while q < end && (src[q as usize] == b' ' || src[q as usize] == b'\t') {
            q += 1;
        }
        if closes_at(src, q, hashes) {
            return (line, q);
        }
        while q < end && src[q as usize] != b'\n' {
            q += 1;
        }
        line = q + 1;
    }
    (-1, -1)
}

// The opening line of a block whose `"""` ends at p: blanks only, then
// the line break; where its text starts (the next line).
fn opening_line(start: i64, p0: i64, hashes: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let src = src(pcx);
    let end = src.len() as i64;
    let mut p = p0;
    while p < end && (src[p as usize] == b' ' || src[p as usize] == b'\t') {
        p += 1;
    }
    if p < end && src[p as usize] == b'\r' && p + 1 < end && src[(p + 1) as usize] == b'\n' {
        p += 1;
    }
    if p >= end || src[p as usize] != b'\n' {
        if p >= end {
            unterminated(start, hashes, pcx);
        }
        block_error(c"lex.text-block-open", p,
            b"a text block's text starts on the line after its opening '\"\"\"'",
            b"end the line after '\"\"\"'; a string of one line is \"...\"", -1, b"",
            fatal: true, pcx: pcx);
    }
    p + 1
}

// Where the text of a block's line [line, text_end) starts: past the
// closing line's `indent`; a blank line's past it, if anything; a line
// indented less is lex.text-block-indent (once a block: `reported`), its
// text from its first non-blank byte.
fn line_from(src: &[u8], line: i64, text_end: i64, indent: &[u8], reported: &mut bool,
    pcx: &mut Ctx<Comp>) -> i64 {
    let mut first = line;
    while first < text_end && (src[first as usize] == b' ' || src[first as usize] == b'\t') {
        first += 1;
    }
    let indented = text_end - line >= indent.len() as i64
        && src[line as usize..(line + indent.len() as i64) as usize] == indent;
    if first == text_end {
        // a blank line: what is past the indentation, if anything
        return if text_end - line <= indent.len() as i64 || !indented { text_end }
            else { line + indent.len() as i64 };
    }
    if !indented {
        if !*reported {
            short_line(line, first, indent, pcx);
            *reported = true;
        }
        return first;
    }
    line + indent.len() as i64
}

// The text block starting at `start` (its `"""`, or the `r` of a raw one
// with `hashes` `#`s): the value in LEX_SCRATCH, a Str token.
pub fn lex_text_block(start: i64, raw: bool, hashes: i64, pcx: &mut Ctx<Comp>) {
    // (SRC itself, not `src(pcx)`: the rust edition ties that view to pcx,
    // which this function writes while it reads the block)
    let src = &get_src()[0..pcx.lex_end as usize];
    // The rest of the opening line: blanks only.
    let body = opening_line(start, start + 3 + if raw { 1 + hashes } else { 0 }, hashes, pcx);
    let (close, indent_end) = closing_line(src, body, hashes);
    if close < 0 {
        unterminated(start, hashes, pcx);
    }
    let indent = &src[close as usize..indent_end as usize];
    buf_clear(pcx.lex_scratch);
    let mut line = body;
    let mut reported = false;
    while line < close {
        // [line, text_end) the line's text, '\n' at line_end
        let mut line_end = line;
        while src[line_end as usize] != b'\n' {
            line_end += 1;
        }
        let mut text_end = line_end;
        if text_end > line && src[(text_end - 1) as usize] == b'\r' {
            text_end -= 1;
        }
        let from = line_from(src, line, text_end, indent, &mut reported, pcx);
        let mut joined = false;
        if raw {
            buf_bytes(pcx.lex_scratch, &src[from as usize..text_end as usize]);
        } else {
            let mut i = from;
            while i < text_end {
                let c = src[i as usize];
                if c != b'\\' {
                    let mut j = i + 1;
                    while j < text_end && src[j as usize] != b'\\' {
                        j += 1;
                    }
                    buf_bytes(pcx.lex_scratch, &src[i as usize..j as usize]);
                    i = j;
                    continue;
                }
                if i + 1 == text_end {
                    joined = true;
                    break;
                }
                // (an escape stops at the line's end: its digits are not '\n')
                pcx.lex_pos = i + 1;
                lex_escape(pcx.lex_scratch, in_char: false, pcx: pcx);
                i = pcx.lex_pos;
            }
        }
        line = line_end + 1;
        if line < close && !joined {
            buf_byte(pcx.lex_scratch, b'\n');
        }
    }
    pcx.lex_pos = indent_end + 3 + hashes;
    let id = add_string(&buf_copy(pcx.lex_scratch), pcx);
    push_token(Str, start, id as u64, 0, pcx);
}

// (0.25.4) Whether an f-string text block opens at `start` (its `f`).
pub fn at_ftext_block(start: i64, pcx: &Ctx<Comp>) -> bool {
    quotes_at(src(pcx), start + 1)
}

// Whether an f-string text block is being lexed.
pub fn in_ftext_block(pcx: &Ctx<Comp>) -> bool {
    pcx.fb_close >= 0
}

// No f-string text block open (lex_range: one an error left open, as a
// fatal error in a hole does, is not the next text's).
pub fn ftext_reset(pcx: &mut Ctx<Comp>) {
    pcx.fb_close = -1;
}

// (0.25.4) Opens the f-string text block at `start`, its `f"""`: the
// opening line checked, the closing line found; LEX_POS at the text of
// its first line. True when it is already closed (no line of text).
pub fn open_ftext_block(start: i64, pcx: &mut Ctx<Comp>) -> bool {
    let body = opening_line(start, start + 4, 0, pcx);
    let (close, quote) = closing_line(src(pcx), body, 0);
    if close < 0 {
        unterminated(start, 0, pcx);
    }
    pcx.fb_close = close;
    pcx.fb_quote = quote;
    pcx.fb_reported = false;
    ftext_line(body, pcx)
}

// (0.25.4) In an open f-string text block, the next line starts at
// `line`: LEX_POS at its text, past the closing line's indentation, and
// false; or, at the closing line, LEX_POS past the delimiter, the block
// closed, and true.
pub fn ftext_line(line: i64, pcx: &mut Ctx<Comp>) -> bool {
    let src = src(pcx);
    if line >= pcx.fb_close {
        pcx.lex_pos = pcx.fb_quote + 3;
        pcx.fb_close = -1;
        return true;
    }
    let mut text_end = line;
    while src[text_end as usize] != b'\n' {
        text_end += 1;
    }
    if text_end > line && src[(text_end - 1) as usize] == b'\r' {
        text_end -= 1;
    }
    let mut pcx_fb_reported = pcx.fb_reported;
    pcx.lex_pos = line_from(src, line, text_end, &src[pcx.fb_close as usize..pcx.fb_quote as usize],
        &mut pcx_fb_reported, pcx);
    pcx.fb_reported = pcx_fb_reported;
    false
}

// An unterminated text block at `start`: the closing line it needs.
fn unterminated(start: i64, hashes: i64, pcx: &mut Ctx<Comp>) -> ! {
    let m = buf_new();
    buf_bytes(m, b"unterminated text block: no line starts with '\"\"\"");
    for _ in 0..hashes {
        buf_byte(m, b'#');
    }
    buf_bytes(m, b"' to close it");
    block_error(c"lex.text-block-unterminated", start, &buf_copy(m),
        b"a line holding only optional blanks and the closing delimiter ends a text block; its indentation is removed from every line",
        -1, b"", fatal: true, pcx: pcx);
    err_jump(pcx)
}

// A content line (from `line`, its text at `first`) indented less than the
// closing delimiter's `indent`.
fn short_line(line: i64, first: i64, indent: &[u8], pcx: &mut Ctx<Comp>) {
    let m = buf_new();
    let n = first - line;
    buf_fmt(m,
        format_args(
            "a text block's line is indented {n} byte{}; its closing '\"\"\"' is indented {}",
            if n == 1 { "" } else { "s" }, indent.len() as i64));
    let tabs = indent_has_tab(&src(pcx)[line as usize..first as usize]) != indent_has_tab(indent);
    block_error(c"lex.text-block-indent", line, &buf_copy(m),
        if tabs { b"the indentation mixes tabs and spaces: the closing line's indentation must begin every line, byte for byte" }
        else { b"the closing line's indentation is removed from every line: indent the line at least as much, or move the closing '\"\"\"' left" },
        first, indent, fatal: false, pcx: pcx);
}

fn indent_has_tab(s: &[u8]) -> bool {
    for &c in s {
        if c == b'\t' {
            return true;
        }
    }
    false
}
