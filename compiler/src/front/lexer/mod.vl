// Lexer: source text to tokens. Mirrors the reference lexer
// (seed/src/lexer, the Rust compiler) token for token; `volec --tokens`
// prints the same dump as `vole tokens`.

// ---- Token kinds ----

mod strings;
// (0.25.3) text blocks: """ ... """, r""" ... """
mod blocks;
// (0.26.0) embedded blocks: `embed wgsl NAME { WGSL }`
pub mod embedded;

// (Numbered as in 0.3: the keywords and the punctuation are kept in the
// ranges the token dump of the seed expects.)
use crate::base::{
    BUFS, SRC, alloc_array, buf_byte, buf_clear, buf_fmt, buf_hex, buf_new, buf_str, cstr, elem_at,
    intern, intern_c, strtod, sym_name, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_at;

use Tok::{
    Amp, AmpAmp, AmpEq, Arrow, As, At, Bang, BangEq, Break, CStr, Caret, CaretEq, Char, Colon,
    ColonColon, Comma, Const, Continue, Defer, Dot, DotDot, DotDotEq, Ellipsis, Else, Enum, Eof, Eq,
    EqEq, Extern, False, FatArrow, Float, Fn, For, Gt, GtEq, Hash, Ident, If, Impl, Import, In, Int,
    LBrace, LBracket, LParen, Let, Loop, Lt, LtEq, Match, Minus, MinusEq, Mod, Mut, Percent,
    PercentEq, Pipe, PipeEq, PipePipe, Plus, PlusEq, Pub, Question, RBrace, RBracket, RParen,
    Reserved, Return, Semi, Shl, ShlEq, Shr, ShrEq, Slash, SlashEq, Star, StarEq, Static, Str,
    Struct, Tilde, Trait, True, Union, Unsafe, Use, While,
};
use blocks::{at_text_block, lex_text_block, raw_block_hashes};
pub use strings::{add_string, hex_value, lex_char, lex_fstring, lex_string};

pub enum Tok {
    Eof = 0, Int = 1, Float = 2, Char = 3, Str = 4, CStr = 5, Ident = 6,
    // A reserved word (`trait`, `pub`, ...): an error wherever it is used.
    Reserved = 7,
    // Keywords.
    Fn = 10, Let = 11, Mut = 12, Struct = 13, If = 14, Else = 15, Loop = 16,
    While = 17, For = 18, In = 19, Break = 20, Continue = 21, True = 22,
    False = 23, As = 24, Return = 25, Extern = 26, Const = 27, Static = 28,
    Type = 29, Enum = 30, Match = 31, Impl = 32, Union = 33, Import = 34, Use = 35,
    Pub = 36, Mod = 37, Defer = 38, Unsafe = 39,
    // Punctuation.
    PlusEq = 40, MinusEq = 41, StarEq = 42, SlashEq = 43, PercentEq = 44,
    AmpEq = 45, PipeEq = 46, CaretEq = 47, BangEq = 48, EqEq = 49, GtEq = 50,
    LtEq = 51, AmpAmp = 52, PipePipe = 53, Arrow = 54, FatArrow = 55, Shl = 56,
    Shr = 57, ShlEq = 58, ShrEq = 59, DotDot = 60, DotDotEq = 61,
    Ellipsis = 62, ColonColon = 63, Eq = 64, Plus = 65, Minus = 66, Star = 67,
    Slash = 68, Percent = 69, Caret = 70, Amp = 71, Pipe = 72, Tilde = 73,
    Bang = 74, Lt = 75, Gt = 76, Dot = 77, Comma = 78, Semi = 79, Colon = 80,
    Hash = 81, Question = 82, At = 83, LParen = 84, RParen = 85, LBrace = 86,
    RBrace = 87, LBracket = 88, RBracket = 89,
    // Keywords of 0.9 (after the punctuation, which kept its numbers).
    Trait = 90,
    // Keywords of 0.14.
    Move = 91,
    // The pieces of an f-string (0.15), `f"a{x}b{y:>4}c"`: FHead `f"a{`,
    // the tokens of the hole `x`, FMid `}b{`, the tokens of `y`, FTail
    // `:>4}c"`. `value` is the text (a string id, `{{` and `}}` unescaped);
    // an FMid or FTail has the spec of the hole it closes in `suffix` (a
    // string id, -1: none); an FHead has `suffix` 1 when the f-string has
    // no hole (the token is the whole literal).
    FHead = 92, FMid = 93, FTail = 94,
    // Keywords of 0.21 (conventions.md D27; words by position in 0.20).
    Var = 95, Inout = 96, Sink = 97,
    // (0.26.0) The text of an embedded block, `embed wgsl NAME { .. }`
    // (lexer/embedded.vl): start..end its bytes, between the braces; no
    // value.
    Embedded = 98,
    // (0.27.0) A lifetime or a label of the rust edition, `'a`, `'static`,
    // `'outer` (front/rust): `value` the symbol of its name, without the
    // quote. Only in a rust-edition file (lexer/strings.vl lex_char).
    Lifetime = 99,
}

// Numeric literal suffixes (0: none).
pub const SUF_NONE: i64 = 0;
pub const SUF_I8: i64 = 1;
pub const SUF_I16: i64 = 2;
pub const SUF_I32: i64 = 3;
pub const SUF_I64: i64 = 4;
pub const SUF_ISIZE: i64 = 5;
pub const SUF_U8: i64 = 6;
pub const SUF_U16: i64 = 7;
pub const SUF_U32: i64 = 8;
pub const SUF_U64: i64 = 9;
pub const SUF_USIZE: i64 = 10;
pub const SUF_F32: i64 = 11;
pub const SUF_F64: i64 = 12;

// `value` is the integer value, the float's bits, the character, the
// string id (Tok::Str, Tok::CStr) or the symbol (Tok::Ident, Tok::Reserved).
pub struct Token {
    pub kind: Tok, pub start: i64, pub end: i64, pub value: u64, pub suffix: i64, joint: bool,
}

// String literals: their bytes, by id.
pub static var STRS: *[u8] = 0 as *[u8];
pub static var STR_COUNT: i64 = 0;
static var STR_CAP: i64 = 0;

// String literal id's bytes: STRS[id] by its address (0.17: `STRS[id]`
// would index the first slice).
pub fn str_at(id: i64) -> [u8] {
    unsafe { *elem_at(STRS, id) }
}

fn add_keyword(text: *u8, kind: Tok, pcx: inout Ctx<Comp>) {
    let sym = intern_c(text, &pcx);
    unsafe { pcx.sym_keyword[sym] = kind; }
}

fn add_reserved(text: *u8, pcx: inout Ctx<Comp>) {
    let sym = intern_c(text, &pcx);
    unsafe { pcx.sym_keyword[sym] = Reserved; }
}

// Interns the keywords first, so their symbols are small numbers.
pub fn init_lexer(pcx: inout Ctx<Comp>) {
    pcx.sym_keyword_count = 64;
    pcx.sym_keyword = alloc_array::<Tok>(pcx.sym_keyword_count);
    add_keyword(c"fn", Fn, &pcx);
    add_keyword(c"let", Let, &pcx);
    add_keyword(c"mut", Mut, &pcx);
    add_keyword(c"struct", Struct, &pcx);
    add_keyword(c"if", If, &pcx);
    add_keyword(c"else", Else, &pcx);
    add_keyword(c"loop", Loop, &pcx);
    add_keyword(c"while", While, &pcx);
    add_keyword(c"for", For, &pcx);
    add_keyword(c"in", In, &pcx);
    add_keyword(c"break", Break, &pcx);
    add_keyword(c"continue", Continue, &pcx);
    add_keyword(c"true", True, &pcx);
    add_keyword(c"false", False, &pcx);
    add_keyword(c"as", As, &pcx);
    add_keyword(c"return", Return, &pcx);
    add_keyword(c"extern", Extern, &pcx);
    add_keyword(c"const", Const, &pcx);
    add_keyword(c"static", Static, &pcx);
    add_keyword(c"type", Tok::Type, &pcx);
    add_keyword(c"enum", Enum, &pcx);
    add_keyword(c"match", Match, &pcx);
    add_keyword(c"impl", Impl, &pcx);
    add_keyword(c"union", Union, &pcx);
    add_keyword(c"import", Import, &pcx);
    add_keyword(c"use", Use, &pcx);
    add_keyword(c"pub", Pub, &pcx);
    add_keyword(c"mod", Mod, &pcx);
    add_keyword(c"defer", Defer, &pcx);
    add_keyword(c"unsafe", Unsafe, &pcx);
    add_keyword(c"trait", Trait, &pcx);
    add_reserved(c"where", &pcx);
    add_reserved(c"dyn", &pcx);
    add_keyword(c"move", Tok::Move, &pcx);
    add_keyword(c"var", Tok::Var, &pcx);
    add_keyword(c"inout", Tok::Inout, &pcx);
    add_keyword(c"sink", Tok::Sink, &pcx);
    init_suffixes(&pcx);
}

impl Tok {
    // The text of a keyword or punctuation token, for messages and the token
    // dump.
    fn text(self) -> *u8 {
        match self {
            Eof => c"EOF",
            Fn => c"fn",
            Let => c"let",
            Mut => c"mut",
            Struct => c"struct",
            If => c"if",
            Else => c"else",
            Loop => c"loop",
            While => c"while",
            For => c"for",
            In => c"in",
            Break => c"break",
            Continue => c"continue",
            True => c"true",
            False => c"false",
            As => c"as",
            Return => c"return",
            Extern => c"extern",
            Const => c"const",
            Static => c"static",
            Tok::Type => c"type",
            Enum => c"enum",
            Match => c"match",
            Impl => c"impl",
            Union => c"union",
            Import => c"import",
            Use => c"use",
            Pub => c"pub",
            Mod => c"mod",
            Defer => c"defer",
            Unsafe => c"unsafe",
            Trait => c"trait",
            Tok::Move => c"move",
            Tok::Var => c"var",
            Tok::Inout => c"inout",
            Tok::Sink => c"sink",
            Tok::Embedded => c"embedded",
            Tok::FHead => c"f\"",
            Tok::FMid => c"}",
            Tok::FTail => c"}",
            PlusEq => c"+=",
            MinusEq => c"-=",
            StarEq => c"*=",
            SlashEq => c"/=",
            PercentEq => c"%=",
            AmpEq => c"&=",
            PipeEq => c"|=",
            CaretEq => c"^=",
            BangEq => c"!=",
            EqEq => c"==",
            GtEq => c">=",
            LtEq => c"<=",
            AmpAmp => c"&&",
            PipePipe => c"||",
            Arrow => c"->",
            FatArrow => c"=>",
            Shl => c"<<",
            Shr => c">>",
            ShlEq => c"<<=",
            ShrEq => c">>=",
            DotDot => c"..",
            DotDotEq => c"..=",
            Ellipsis => c"...",
            ColonColon => c"::",
            Eq => c"=",
            Plus => c"+",
            Minus => c"-",
            Star => c"*",
            Slash => c"/",
            Percent => c"%",
            Caret => c"^",
            Amp => c"&",
            Pipe => c"|",
            Tilde => c"~",
            Bang => c"!",
            Lt => c"<",
            Gt => c">",
            Dot => c".",
            Comma => c",",
            Semi => c";",
            Colon => c":",
            Hash => c"#",
            Question => c"?",
            At => c"@",
            LParen => c"(",
            RParen => c")",
            LBrace => c"{",
            RBrace => c"}",
            LBracket => c"[",
            RBracket => c"]",
            // Tokens with a value: printed with it, by their users.
            _ => c"",
        }
    }

    // Keywords: printed as the identifier they are spelled with.
    fn is_keyword(self) -> bool {
        let k = self as i64;
        k >= Fn as i64 && k <= Mod as i64 || k >= Tok::Var as i64 && k <= Tok::Sink as i64
    }
}

fn init_suffixes(pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.suffix_name = alloc_array::<*u8>(13);
        pcx.suffix_name[SUF_I8] = c"i8";
        pcx.suffix_name[SUF_I16] = c"i16";
        pcx.suffix_name[SUF_I32] = c"i32";
        pcx.suffix_name[SUF_I64] = c"i64";
        pcx.suffix_name[SUF_ISIZE] = c"isize";
        pcx.suffix_name[SUF_U8] = c"u8";
        pcx.suffix_name[SUF_U16] = c"u16";
        pcx.suffix_name[SUF_U32] = c"u32";
        pcx.suffix_name[SUF_U64] = c"u64";
        pcx.suffix_name[SUF_USIZE] = c"usize";
        pcx.suffix_name[SUF_F32] = c"f32";
        pcx.suffix_name[SUF_F64] = c"f64";
        // (the symbols they had when the tools' cache restored the table)
        pcx.suffix_sym_base = intern_c(pcx.suffix_name[1], &pcx);
        for suffix in 2..13 {
            intern_c(pcx.suffix_name[suffix], &pcx);
        }
    }
}

// The suffix a symbol names, or SUF_NONE.
fn suffix_of_sym(sym: i64, pcx: Ctx<Comp>) -> i64 {
    if sym >= pcx.suffix_sym_base && sym < pcx.suffix_sym_base + 12 {
        return sym - pcx.suffix_sym_base + 1;
    }
    SUF_NONE
}

fn is_float_suffix(suffix: i64) -> bool {
    suffix == SUF_F32 || suffix == SUF_F64
}

pub fn keyword_of_sym(sym: i64, pcx: Ctx<Comp>) -> Tok {
    if sym < pcx.sym_keyword_count { unsafe { pcx.sym_keyword[sym] } } else { Eof }
}

// ---- The lexer ----

extern "C" {
    fn memchr(s: *u8, c: i32, n: u64) -> *u8;
}

// ' ', '\t', '\r', '\n'
const CL_SPACE: u8 = 1;
// '_', letters, digits
const CL_IDENT: u8 = 2;
// '_', letters: an identifier's first byte
const CL_ALPHA: u8 = 4;
const CL_DIGIT: u8 = 8;
// a byte that starts a two- or three-byte operator
const CL_OP: u8 = 16;

fn init_byte_classes(pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.byte_class = alloc_array::<u8>(256);
        pcx.single_tok = alloc_array::<Tok>(256);
        for b in 0..256 {
            let c = b as u8;
            var k: u8 = 0;
            if is_whitespace(c) {
                k |= CL_SPACE;
            }
            if is_ident_byte(c) {
                k |= CL_IDENT;
            }
            if c == '_' || is_alpha(c) {
                k |= CL_ALPHA;
            }
            if is_digit(c) {
                k |= CL_DIGIT;
            }
            pcx.byte_class[b] = k;
            // (the bytes no two- or three-byte operator starts with)
            if two_char_operator(c, '=') == Eof && c != '<' && c != '>' && c != '&' && c != '|'
                && c != '-' && c != '.' && c != ':' {
                pcx.single_tok[b] = one_char_operator(c);
            } else if one_char_operator(c) != Eof {
                pcx.byte_class[b] = k | CL_OP;
            }
        }
    }
}

pub fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

pub fn is_alpha(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

pub fn is_ident_byte(c: u8) -> bool {
    c == '_' || is_alpha(c) || is_digit(c)
}

fn is_whitespace(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// The byte at `offset` from the lexer position, 0 past the end.
fn peek_at(offset: i64, pcx: Ctx<Comp>) -> u8 {
    if pcx.lex_pos + offset < pcx.lex_end { SRC[pcx.lex_pos + offset] } else { 0 }
}

fn at_end(pcx: Ctx<Comp>) -> bool {
    pcx.lex_pos >= pcx.lex_end
}

fn push_token(kind: Tok, start: i64, value: u64, suffix: i64, pcx: inout Ctx<Comp>) {
    add_token(kind, start, pcx.lex_pos, value, suffix,
        joint_at(SRC.ptr, pcx.byte_class, pcx.lex_pos, pcx.lex_end), &pcx);
    pcx.lex_after_dot = kind == Dot;
}

fn add_token(kind: Tok, start: i64, end: i64, value: u64, suffix: i64, joint: bool,
    pcx: inout Ctx<Comp>) {
    pcx.toks.push(Token { kind, start, end, value, suffix, joint });
}

// Nothing separates the token that ends at `pos` from the next one.
fn joint_at(src: *u8, classes: *u8, pos: i64, end: i64) -> bool {
    unsafe {
        if pos >= end {
            return false;
        }
        let c = src[pos];
        if (classes[c as i64] & CL_SPACE) != 0 {
            return false;
        }
        if c == '/' && pos + 1 < end {
            let next = src[pos + 1];
            return !(next == '/' || next == '*');
        }
        true
    }
}

fn skip_whitespace_and_comments(pcx: inout Ctx<Comp>) {
    pcx.lex_pos = skip_blank(SRC.ptr, pcx.byte_class, pcx.lex_pos, pcx.lex_end, &pcx);
}

// The position of the first byte from `pos` that is neither whitespace nor
// in a comment (`end` when none is).
fn skip_blank(src: *u8, classes: *u8, pos: i64, end: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var p = pos;
        loop {
            while p < end && (classes[src[p] as i64] & CL_SPACE) != 0 {
                p += 1;
            }
            if p + 1 >= end || src[p] != '/' {
                return p;
            }
            let next = src[p + 1];
            if next == '/' {
                // (to the end of the line, by memchr)
                let nl = memchr(&src[p], 10, (end - p) as u64);
                p = if nl == 0 as *u8 { end } else { p + (nl as i64 - (&src[p]) as i64) };
            } else if next == '*' {
                pcx.lex_pos = p;
                skip_block_comment(&pcx);
                p = pcx.lex_pos;
            } else {
                return p;
            }
        }
        p
    }
}

// Block comments nest.
fn skip_block_comment(pcx: inout Ctx<Comp>) {
    let start = pcx.lex_pos;
    var depth = 0;
    while !at_end(pcx) {
        if peek_at(0, pcx) == '/' && peek_at(1, pcx) == '*' {
            depth += 1;
            pcx.lex_pos += 2;
        } else if peek_at(0, pcx) == '*' && peek_at(1, pcx) == '/' {
            depth -= 1;
            pcx.lex_pos += 2;
            if depth == 0 {
                return;
            }
        } else {
            pcx.lex_pos += 1;
        }
    }
    error_at(start, c"unterminated block comment", &pcx);
}

// Lexes SRC[start..end) and appends its tokens; `last` adds the EOF token.
pub fn lex_range(start: i64, end: i64, last: bool, pcx: inout Ctx<Comp>) {
    if pcx.lex_scratch < 0 {
        pcx.lex_scratch = buf_new();
        init_byte_classes(&pcx);
    }
    pcx.lex_pos = start;
    pcx.lex_end = end;
    pcx.lex_after_dot = false;
    pcx.lex_first = pcx.toks.len() as i64;
    crate::front::lexer::blocks::ftext_reset(&pcx);
    lex_loop(&pcx);
    if last {
        push_token(Eof, pcx.lex_pos, 0, 0, &pcx);
    }
}

// (0.27.0) Whether keyword kind is MVS's and no keyword of Rust's: in the
// rust edition the word is a name (`io::sink`, a field `var`).
fn mvs_only_keyword(kind: Tok) -> bool {
    kind == Tok::Var || kind == Tok::Inout || kind == Tok::Sink || kind == Defer
}

// (0.25) The tokens of SRC[LEX_POS..LEX_END), the position in a local:
// identifiers, keywords, punctuation and plain decimal integers here,
// the rest (strings, characters, other numbers, errors) by lex_token
// (LEX_POS set around it).
fn lex_loop(pcx: inout Ctx<Comp>) {
    unsafe {
        let src = SRC.ptr;
        let classes = pcx.byte_class;
        let singles = pcx.single_tok;
        let end = pcx.lex_end;
        var pos = pcx.lex_pos;
        while pos < end {
            var c = src[pos];
            var class = classes[c as i64];
            if (class & CL_SPACE) != 0 || c == '/' {
                pos = skip_blank(src, classes, pos, end, &pcx);
                if pos >= end {
                    break;
                }
                c = src[pos];
                class = classes[c as i64];
            }
            var kind = Eof;
            var p = pos + 1;
            var value: u64 = 0;
            if (class & CL_ALPHA) != 0 {
                let next = if p < end { src[p] } else { 0 };
                // (0.27.2: `b'x'`, a byte literal of the rust edition: lex_token's)
                if !((c == 'c' || c == 'f') && next == '"')
                    && !(c == 'r' && (next == '#' || next == '"'))
                    && !(c == 'b' && (next == '\'' || next == '"') && pcx.edition != 0
                        && crate::front::rust::rust_at(pos, &pcx)) {
                    while p < end && (classes[src[p] as i64] & CL_IDENT) != 0 {
                        p += 1;
                    }
                    let sym = intern(src[pos..p], &pcx);
                    kind = Ident;
                    if sym < pcx.sym_keyword_count && pcx.sym_keyword[sym] != Eof {
                        kind = pcx.sym_keyword[sym];
                        if pcx.edition != 0 && mvs_only_keyword(kind)
                            && crate::front::rust::rust_at(pos, &pcx) {
                            // (0.27.0: a name in the rust edition)
                            kind = Ident;
                        } else if kind == Union && pcx.edition != 0
                            && crate::front::rust::rust_at(pos, &pcx) {
                            // (0.27.0: as Rust's, `union` is a keyword only
                            // before a name, `union U {`; `fn union`,
                            // `a.union(b)` are the name)
                            var q = p;
                            while q < end && (classes[src[q] as i64] & CL_SPACE) != 0 {
                                q += 1;
                            }
                            if q >= end || (classes[src[q] as i64] & CL_ALPHA) == 0 {
                                kind = Ident;
                            }
                        }
                    }
                    value = sym as u64;
                }
            } else {
                kind = singles[c as i64];
                if kind == Eof && (class & CL_OP) != 0 {
                    // (lex_operator, here)
                    let b = if p < end { src[p] } else { 0 };
                    if pos + 2 < end && (c == '<' || c == '>' || c == '.') {
                        kind = three_char_operator(c, b, src[pos + 2]);
                        p = pos + 3;
                    }
                    if kind == Eof && pos + 1 < end {
                        kind = two_char_operator(c, b);
                        p = pos + 2;
                    }
                    if kind == Eof {
                        kind = one_char_operator(c);
                        p = pos + 1;
                    }
                } else if kind == Eof && (class & CL_DIGIT) != 0 {
                    let after = lex_plain_integer(src, classes, pos, end, &pcx);
                    if after > pos {
                        pos = after;
                        continue;
                    }
                }
            }
            if kind == Eof {
                pcx.lex_pos = pos;
                lex_token(&pcx);
                pos = pcx.lex_pos;
                continue;
            }
            // (joint_at, here)
            var joint = false;
            if p < end {
                let d = src[p];
                joint = (classes[d as i64] & CL_SPACE) == 0
                    && !(d == '/' && p + 1 < end && (src[p + 1] == '/' || src[p + 1] == '*'));
            }
            pcx.toks.push(Token { kind, start: pos, end: p, value, suffix: 0, joint });
            pcx.lex_after_dot = kind == Dot;
            // (0.26.0: `embed LANG NAME {`: its text is one token, lexing
            // resumes at its `}`)
            if kind == LBrace && embedded::at_embedded_open(&pcx) {
                p = embedded::lex_embedded(pos, &pcx);
            }
            pos = p;
        }
        pcx.lex_pos = pos;
    }
}

// A decimal integer without '_' or a suffix at `pos`, not a float (or a
// tuple index): its token added, its end returned; else `pos`, nothing
// added (lex_number then lexes it, and reports its errors).
fn lex_plain_integer(src: *u8, classes: *u8, pos: i64, end: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var p = pos;
        var value: u64 = 0;
        while p < end && (classes[src[p] as i64] & CL_DIGIT) != 0 {
            let digit = (src[p] - '0') as u64;
            if value > (0xffffffffffffffff - digit) / 10 {
                return pos;
            }
            value = value * 10 + digit;
            p += 1;
        }
        if p < end {
            let c = src[p];
            if (classes[c as i64] & CL_IDENT) != 0 {
                return pos;
            }
            if c == '.' && !pcx.lex_after_dot && p + 1 < end
                && (classes[src[p + 1] as i64] & CL_DIGIT) != 0 {
                return pos;
            }
        }
        add_token(Int, pos, p, value, 0, joint_at(src, classes, p, end), &pcx);
        pcx.lex_after_dot = false;
        p
    }
}

fn lex_token(pcx: inout Ctx<Comp>) {
    let c = peek_at(0, pcx);
    if c == '"' && at_text_block(pcx) {
        lex_text_block(pcx.lex_pos, raw: false, hashes: 0, pcx: &pcx);
    } else if c == '"' {
        lex_string(pcx.lex_pos, is_c: false, pcx: &pcx);
    } else if c == 'c' && peek_at(1, pcx) == '"' {
        lex_string(pcx.lex_pos, is_c: true, pcx: &pcx);
    } else if c == 'f' && peek_at(1, pcx) == '"' {
        lex_fstring(pcx.lex_pos, &pcx);
    } else if c == '\'' {
        lex_char(-1, &pcx);
    } else if c == 'b' && peek_at(1, pcx) == '"' && pcx.edition != 0
        && crate::front::rust::rust_at(pcx.lex_pos, &pcx) {
        // (0.27.3: a byte string of the rust edition, `b"..."`: lex_loop's)
        pcx.lex_pos += 1;
        lex_string(pcx.lex_pos - 1, is_c: false, pcx: &pcx);
    } else if c == 'b' && peek_at(1, pcx) == '\'' {
        // (0.27.2: a byte literal of the rust edition, lex_loop's)
        pcx.lex_pos += 1;
        lex_char(pcx.lex_pos - 1, &pcx);
    } else if is_digit(c) {
        lex_number(&pcx);
    }
    else if c == 'r' && (peek_at(1, pcx) == '"' || peek_at(1, pcx) == '#')
        && raw_block_hashes(pcx) >= 0 {
        lex_text_block(pcx.lex_pos, raw: true, hashes: raw_block_hashes(pcx), pcx: &pcx);
    }
    else if c == 'r' && peek_at(1, pcx) == '#'
        && (peek_at(2, pcx) == '_' || is_alpha(peek_at(2, pcx))) {
        lex_raw_ident(&pcx);
    } else if c == '_' || is_alpha(c) {
        lex_ident(&pcx);
    } else {
        lex_operator(&pcx);
    }
}

fn lex_ident(pcx: inout Ctx<Comp>) {
    let start = pcx.lex_pos;
    while !at_end(pcx) && is_ident_byte(peek_at(0, pcx)) {
        pcx.lex_pos += 1;
    }
    let sym = intern(SRC[start..pcx.lex_pos], &pcx);
    let keyword = keyword_of_sym(sym, pcx);
    if keyword == Eof {
        push_token(Ident, start, sym as u64, 0, &pcx);
    } else {
        push_token(keyword, start, sym as u64, 0, &pcx);
    }
}

// `r#name`: an identifier even when `name` is a keyword (C names imported
// by `import`, for instance a field named `type`).
fn lex_raw_ident(pcx: inout Ctx<Comp>) {
    let start = pcx.lex_pos;
    pcx.lex_pos += 2;
    let name_start = pcx.lex_pos;
    while !at_end(pcx) && is_ident_byte(peek_at(0, pcx)) {
        pcx.lex_pos += 1;
    }
    push_token(Ident, start, intern(SRC[name_start..pcx.lex_pos], &pcx) as u64, 0, &pcx);
}

// The operators spelled by the next bytes (Tok::Eof: none).
fn three_char_operator(a: u8, b: u8, c: u8) -> Tok {
    if a == '<' && b == '<' && c == '=' { return ShlEq; }
    if a == '>' && b == '>' && c == '=' { return ShrEq; }
    if a == '.' && b == '.' && c == '.' { return Ellipsis; }
    if a == '.' && b == '.' && c == '=' { return DotDotEq; }
    Eof
}

fn two_char_operator(a: u8, b: u8) -> Tok {
    if b == '=' {
        if a == '+' { return PlusEq; }
        if a == '-' { return MinusEq; }
        if a == '*' { return StarEq; }
        if a == '/' { return SlashEq; }
        if a == '%' { return PercentEq; }
        if a == '&' { return AmpEq; }
        if a == '|' { return PipeEq; }
        if a == '^' { return CaretEq; }
        if a == '!' { return BangEq; }
        if a == '=' { return EqEq; }
        if a == '>' { return GtEq; }
        if a == '<' { return LtEq; }
        return Eof;
    }
    if a == '<' && b == '<' { return Shl; }
    if a == '>' && b == '>' { return Shr; }
    if a == '&' && b == '&' { return AmpAmp; }
    if a == '|' && b == '|' { return PipePipe; }
    if a == '-' && b == '>' { return Arrow; }
    if a == '=' && b == '>' { return FatArrow; }
    if a == '.' && b == '.' { return DotDot; }
    if a == ':' && b == ':' { return ColonColon; }
    Eof
}

fn one_char_operator(c: u8) -> Tok {
    if c == '=' { return Eq; }
    if c == '+' { return Plus; }
    if c == '-' { return Minus; }
    if c == '*' { return Star; }
    if c == '/' { return Slash; }
    if c == '%' { return Percent; }
    if c == '^' { return Caret; }
    if c == '&' { return Amp; }
    if c == '|' { return Pipe; }
    if c == '~' { return Tilde; }
    if c == '!' { return Bang; }
    if c == '<' { return Lt; }
    if c == '>' { return Gt; }
    if c == '.' { return Dot; }
    if c == ',' { return Comma; }
    if c == ';' { return Semi; }
    if c == ':' { return Colon; }
    if c == '#' { return Hash; }
    if c == '?' { return Question; }
    if c == '@' { return At; }
    if c == '(' { return LParen; }
    if c == ')' { return RParen; }
    if c == '{' { return LBrace; }
    if c == '}' { return RBrace; }
    if c == '[' { return LBracket; }
    if c == ']' { return RBracket; }
    Eof
}

fn lex_operator(pcx: inout Ctx<Comp>) {
    let start = pcx.lex_pos;
    let end = pcx.lex_end;
    let src = SRC.ptr;
    let a = unsafe { src[start] };
    if start + 1 < end {
        let b = unsafe { src[start + 1] };
        if start + 2 < end {
            let kind = three_char_operator(a, b, unsafe { src[start + 2] });
            if kind != Eof {
                pcx.lex_pos = start + 3;
                push_token(kind, start, 0, 0, &pcx);
                return;
            }
        }
        let kind = two_char_operator(a, b);
        if kind != Eof {
            pcx.lex_pos = start + 2;
            push_token(kind, start, 0, 0, &pcx);
            return;
        }
    }
    let kind = one_char_operator(a);
    if kind == Eof {
        error_at(start, c"unexpected character", &pcx);
    }
    pcx.lex_pos += 1;
    push_token(kind, start, 0, 0, &pcx);
}

// ---- Numbers ----

// A '_' may end the digits only when a suffix follows (`1_u8`).
fn check_trailing_underscore(last_underscore: bool, pcx: inout Ctx<Comp>) {
    if last_underscore && !(!at_end(pcx) && is_alpha(peek_at(0, pcx))) {
        error_at(pcx.lex_pos - 1, c"trailing underscore in literal", &pcx);
    }
}

fn lex_number(pcx: inout Ctx<Comp>) {
    let start = pcx.lex_pos;
    let second = peek_at(1, pcx);
    if peek_at(0, pcx) == '0'
        && (second == 'x' || second == 'X' || second == 'b' || second == 'B') {
        let radix: u64 = if second == 'x' || second == 'X' { 16 } else { 2 };
        pcx.lex_pos += 2;
        let value = lex_radix_digits(radix, &pcx);
        lex_int_suffix(value, start, false, &pcx);
        return;
    }
    lex_decimal_or_float(start, &pcx);
}

fn digit_value(c: u8, radix: u64) -> i64 {
    let value = hex_value(c);
    if value < 0 || value as u64 >= radix { -1 } else { value }
}

fn lex_radix_digits(radix: u64, pcx: inout Ctx<Comp>) -> u64 {
    unsafe {
        if at_end(pcx) || digit_value(peek_at(0, pcx), radix) < 0 {
            error_at(pcx.lex_pos,
                if radix == 16 { c"expected hex digit after '0x'" }
                else { c"expected binary digit after '0b'" }, &pcx);
        }
        var value: u64 = 0;
        var last_underscore = false;
        let src = SRC.ptr;
        let end = pcx.lex_end;
        var p = pcx.lex_pos;
        while p < end {
            let c = src[p];
            if c == '_' {
                last_underscore = true;
                p += 1;
                continue;
            }
            let digit = digit_value(c, radix);
            if digit < 0 {
                break;
            }
            last_underscore = false;
            if value > (0xffffffffffffffff - digit as u64) / radix {
                error_at(p, c"literal overflow", &pcx);
            }
            value = value * radix + digit as u64;
            p += 1;
        }
        pcx.lex_pos = p;
        check_trailing_underscore(last_underscore, &pcx);
        value
    }
}

// An identifier glued to a literal: its symbol, or -1.
fn read_suffix(pcx: inout Ctx<Comp>) -> i64 {
    if at_end(pcx) || !is_ident_byte(peek_at(0, pcx)) {
        return -1;
    }
    let start = pcx.lex_pos;
    while !at_end(pcx) && is_ident_byte(peek_at(0, pcx)) {
        pcx.lex_pos += 1;
    }
    intern(SRC[start..pcx.lex_pos], &pcx)
}

fn bits_of_f64(value: f64) -> u64 {
    let copy = value;
    unsafe { *(&copy as *u64) }
}

fn lex_int_suffix(value: u64, start: i64, decimal: bool, pcx: inout Ctx<Comp>) {
    let suffix_at = pcx.lex_pos;
    let sym = read_suffix(&pcx);
    if sym < 0 {
        push_token(Int, start, value, 0, &pcx);
        return;
    }
    let suffix = suffix_of_sym(sym, pcx);
    if suffix != SUF_NONE && is_float_suffix(suffix) && decimal {
        push_token(Float, start, bits_of_f64(value as f64), suffix, &pcx);
        return;
    }
    if suffix != SUF_NONE && !is_float_suffix(suffix) {
        push_token(Int, start, value, suffix, &pcx);
        return;
    }
    error_at(suffix_at, c"invalid suffix on integer literal", &pcx);
}

// Decimal digits (without '_') appended to `out`.
fn read_decimal_digits(out: i64, pcx: inout Ctx<Comp>) {
    if at_end(pcx) || !is_digit(peek_at(0, pcx)) {
        error_at(pcx.lex_pos, c"expected digit", &pcx);
    }
    var last_underscore = false;
    while !at_end(pcx) {
        let c = peek_at(0, pcx);
        if c == '_' {
            last_underscore = true;
            pcx.lex_pos += 1;
            continue;
        }
        if !is_digit(c) {
            break;
        }
        last_underscore = false;
        buf_byte(out, c);
        pcx.lex_pos += 1;
    }
    check_trailing_underscore(last_underscore, &pcx);
}

// An exponent (`e5`, `E-3`) starts here.
fn at_exponent(pcx: Ctx<Comp>) -> bool {
    let e = peek_at(0, pcx);
    if at_end(pcx) || !(e == 'e' || e == 'E') || pcx.lex_pos + 1 >= pcx.lex_end {
        return false;
    }
    let sign = peek_at(1, pcx);
    if sign == '+' || sign == '-' {
        return pcx.lex_pos + 2 < pcx.lex_end && is_digit(peek_at(2, pcx));
    }
    is_digit(sign)
}

fn lex_decimal_or_float(start: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let text = pcx.lex_scratch;
        buf_clear(text);
        read_decimal_digits(text, &pcx);
        let has_fraction = peek_at(0, pcx) == '.' && pcx.lex_pos + 1 < pcx.lex_end
            && is_digit(peek_at(1, pcx));
        let has_exponent = at_exponent(pcx);
        if pcx.lex_after_dot || !(has_fraction || has_exponent) {
            var value: u64 = 0;
            for i in 0..BUFS[text].len {
                let digit = (BUFS[text].data[i] - '0') as u64;
                if value > (0xffffffffffffffff - digit) / 10 {
                    error_at(pcx.lex_pos, c"integer overflow", &pcx);
                }
                value = value * 10 + digit;
            }
            lex_int_suffix(value, start, !pcx.lex_after_dot, &pcx);
            return;
        }
        if has_fraction {
            pcx.lex_pos += 1;
            buf_byte(text, '.');
            read_decimal_digits(text, &pcx);
        }
        if !at_end(pcx) && (peek_at(0, pcx) == 'e' || peek_at(0, pcx) == 'E') {
            pcx.lex_pos += 1;
            buf_byte(text, 'e');
            if !at_end(pcx) && (peek_at(0, pcx) == '+' || peek_at(0, pcx) == '-') {
                buf_byte(text, peek_at(0, pcx));
                pcx.lex_pos += 1;
            }
            if at_end(pcx) || !is_digit(peek_at(0, pcx)) {
                error_at(pcx.lex_pos, c"expected digit in exponent", &pcx);
            }
            read_decimal_digits(text, &pcx);
        }
        buf_byte(text, 0);
        let value = strtod(BUFS[text].data, 0 as **u8);
        let suffix_at = pcx.lex_pos;
        let sym = read_suffix(&pcx);
        if sym < 0 {
            push_token(Float, start, bits_of_f64(value), 0, &pcx);
            return;
        }
        let suffix = suffix_of_sym(sym, pcx);
        if suffix == SUF_NONE || !is_float_suffix(suffix) {
            error_at(suffix_at, c"invalid suffix on float literal", &pcx);
        }
        push_token(Float, start, bits_of_f64(value), suffix, &pcx);
    }
}

// ---- The token dump (`--tokens`) ----

pub fn dump_tokens(out: i64, base: i64, pcx: Ctx<Comp>) {
    for i in 0..pcx.toks.len() as i64 {
        let tok = pcx.toks[i];
        buf_fmt(out, format_args("{} {} ", tok.start - base, tok.end - base));
        buf_byte(out, if tok.joint { '1' } else { '0' });
        buf_byte(out, ' ');
        dump_token_text(out, tok, pcx);
        buf_byte(out, '\n');
    }
}

fn dump_hex_bytes(out: i64, id: i64) {
    unsafe {
        for i in 0..str_at(id).len {
            buf_hex(out, str_at(id).ptr[i], 2);
        }
    }
}

fn dump_token_text(out: i64, tok: Token, pcx: Ctx<Comp>) {
    unsafe {
        let kind = tok.kind;
        let value = tok.value;
        if kind == Int {
            buf_fmt(out, format_args("int {value}"));
        } else if kind == Float {
            buf_str(out, c"float ");
            buf_hex(out, value, 16);
        } else if kind == Char {
            buf_fmt(out, format_args("char {value}"));
        } else if kind == Str {
            buf_str(out, c"str ");
            dump_hex_bytes(out, value as i64);
        } else if kind == CStr {
            buf_str(out, c"cstr ");
            dump_hex_bytes(out, value as i64);
        } else if kind == Tok::FHead || kind == Tok::FMid || kind == Tok::FTail {
            // (0.15: an f-string's pieces, the spec after the text)
            buf_str(out, if kind == Tok::FHead { c"fhead " } else if kind == Tok::FMid { c"fmid " }
                else { c"ftail " });
            dump_hex_bytes(out, value as i64);
            if kind != Tok::FHead && tok.suffix >= 0 {
                buf_str(out, c" spec ");
                dump_hex_bytes(out, tok.suffix);
            }
            return;
        } else if kind == Ident {
            buf_fmt(out, format_args("ident {}", sym_text(value as i64, pcx)));
        } else if kind == Reserved {
            buf_str(out, sym_name(value as i64, pcx));
        } else {
            buf_str(out, kind.text());
        }
        if tok.suffix != SUF_NONE {
            buf_fmt(out, format_args(" {}", cstr(pcx.suffix_name[tok.suffix])));
        }
    }
}
