// Lexer: source text to tokens. Mirrors the reference lexer
// (seed/src/lexer, the Rust compiler) token for token; `volec --tokens`
// prints the same dump as `vole tokens`.

// ---- Token kinds ----

use std::io::Sink; pub mod strings;
// (0.25.3) text blocks: """ ... """, r""" ... """
mod blocks;
// (0.26.0) embedded blocks: `embed wgsl NAME { WGSL }`
pub mod embedded;

// (Numbered as in 0.3: the keywords and the punctuation are kept in the
// ranges the token dump of the seed expects.)
use crate::base::{
    buf_at, buf_byte, buf_clear, buf_fmt, buf_hex, buf_len, buf_new, buf_slice, buf_str, elem_at,
    get_src, intern, intern_c, strtod, sym_name, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_at;

use Tok::{
    Amp, AmpAmp, AmpEq, Arrow, As, At, Bang, BangEq, Break, CStr, Caret, CaretEq, Char, Colon,
    ColonColon, Comma, Const, Continue, Defer, Dot, DotDot, DotDotEq, Ellipsis, Else, Enum, Eof, Eq,
    EqEq, Extern, False, FatArrow, Float, Fn, For, Gt, GtEq, Hash, Ident, If, Impl, Import, In, Int,
    LBrace, LBracket, LParen, Let, Loop, Lt, LtEq, Match, Minus, MinusEq, Mod, Mut, Percent,
    PercentEq, Pipe, PipeEq, PipePipe, Plus, PlusEq, Pub, Question, RBrace, RBracket, RParen,
    Reserved, Return, Semi, Shl, ShlEq, Shr, ShrEq, Slash, SlashEq, Star, StarEq, Static, Str,
    Struct, Tilde, Trait, True, Union, Unsafe, Use, While,
};
use blocks::{at_text_block, lex_text_block, raw_block_hashes};
pub use strings::{add_string, hex_value, lex_char, lex_fstring, lex_string};

#[derive(Clone, Copy, PartialEq, Eq)] pub enum Tok {
    Eof = 0, Int = 1, Float = 2, Char = 3, Str = 4, CStr = 5, Ident = 6,
    // A reserved word (`trait`, `pub`, ...): an error wherever it is used.
    Reserved = 7,
    // Keywords.
    Fn = 10, Let = 11, Mut = 12, Struct = 13, If = 14, Else = 15, Loop = 16,
    While = 17, For = 18, In = 19, Break = 20, Continue = 21, True = 22,
    False = 23, As = 24, Return = 25, Extern = 26, Const = 27, Static = 28,
    Type = 29, Enum = 30, Match = 31, Impl = 32, Union = 33, Import = 34, Use = 35,
    Pub = 36, Mod = 37, Defer = 38, Unsafe = 39,
    // Punctuation.
    PlusEq = 40, MinusEq = 41, StarEq = 42, SlashEq = 43, PercentEq = 44,
    AmpEq = 45, PipeEq = 46, CaretEq = 47, BangEq = 48, EqEq = 49, GtEq = 50,
    LtEq = 51, AmpAmp = 52, PipePipe = 53, Arrow = 54, FatArrow = 55, Shl = 56,
    Shr = 57, ShlEq = 58, ShrEq = 59, DotDot = 60, DotDotEq = 61,
    Ellipsis = 62, ColonColon = 63, Eq = 64, Plus = 65, Minus = 66, Star = 67,
    Slash = 68, Percent = 69, Caret = 70, Amp = 71, Pipe = 72, Tilde = 73,
    Bang = 74, Lt = 75, Gt = 76, Dot = 77, Comma = 78, Semi = 79, Colon = 80,
    Hash = 81, Question = 82, At = 83, LParen = 84, RParen = 85, LBrace = 86,
    RBrace = 87, LBracket = 88, RBracket = 89,
    // Keywords of 0.9 (after the punctuation, which kept its numbers).
    Trait = 90,
    // Keywords of 0.14.
    Move = 91,
    // The pieces of an f-string (0.15), `f"a{x}b{y:>4}c"`: FHead `f"a{`,
    // the tokens of the hole `x`, FMid `}b{`, the tokens of `y`, FTail
    // `:>4}c"`. `value` is the text (a string id, `{{` and `}}` unescaped);
    // an FMid or FTail has the spec of the hole it closes in `suffix` (a
    // string id, -1: none); an FHead has `suffix` 1 when the f-string has
    // no hole (the token is the whole literal).
    FHead = 92, FMid = 93, FTail = 94,
    // Keywords of 0.21 (conventions.md D27; words by position in 0.20).
    Var = 95, Inout = 96, Sink = 97,
    // (0.26.0) The text of an embedded block, `embed wgsl NAME { .. }`
    // (lexer/embedded.vl): start..end its bytes, between the braces; no
    // value.
    Embedded = 98,
    // (0.27.0) A lifetime or a label of the rust edition, `'a`, `'static`,
    // `'outer` (front/rust): `value` the symbol of its name, without the
    // quote. Only in a rust-edition file (lexer/strings.vl lex_char).
    Lifetime = 99,
}

// Numeric literal suffixes (0: none).
pub const SUF_NONE: i64 = 0;
pub const SUF_I8: i64 = 1;
pub const SUF_I16: i64 = 2;
pub const SUF_I32: i64 = 3;
pub const SUF_I64: i64 = 4;
pub const SUF_ISIZE: i64 = 5;
pub const SUF_U8: i64 = 6;
pub const SUF_U16: i64 = 7;
pub const SUF_U32: i64 = 8;
pub const SUF_U64: i64 = 9;
pub const SUF_USIZE: i64 = 10;
pub const SUF_F32: i64 = 11;
pub const SUF_F64: i64 = 12;

// `value` is the integer value, the float's bits, the character, the
// string id (Tok::Str, Tok::CStr) or the symbol (Tok::Ident, Tok::Reserved).
#[derive(Clone, Copy)] pub struct Token {
    pub kind: Tok, pub start: i64, pub end: i64, pub value: u64, pub suffix: i64, pub joint: bool,
}

// String literals: their bytes, by id.
static mut STRS: *mut &'static [u8] = 0 as *mut &'static [u8];
static mut STR_COUNT: i64 = 0;
static mut STR_CAP: i64 = 0;

// String literal id's bytes: STRS[id] by its address (0.17: `STRS[id]`
// would index the first slice).
pub fn str_at(id: i64) -> &'static [u8] {
    unsafe { *elem_at(get_strs(), id) }
}

// The symbols that can be keywords: the lexer interns its words first
// (init_lexer), so a keyword's symbol is under this.
pub const SYM_KEYWORDS: usize = 64;

// A numeric suffix's text (SUF_I8 .. SUF_F64; none: empty).
fn suffix_text(suffix: i64) -> &'static [u8] {
    let names: [&'static [u8]; 13] = [
        b"", b"i8", b"i16", b"i32", b"i64", b"isize", b"u8", b"u16", b"u32", b"u64", b"usize",
        b"f32", b"f64",
    ];
    names[suffix as usize]
}

fn add_keyword(text: *mut u8, kind: Tok, pcx: &mut Ctx<Comp>) {
    let sym = intern_c(text, pcx);
    pcx.sym_keyword[sym as usize] = kind;
}

fn add_reserved(text: *mut u8, pcx: &mut Ctx<Comp>) {
    let sym = intern_c(text, pcx);
    pcx.sym_keyword[sym as usize] = Reserved;
}

// Interns the keywords first, so their symbols are small numbers.
pub fn init_lexer(pcx: &mut Ctx<Comp>) {
    add_keyword(c"fn", Fn, pcx);
    add_keyword(c"let", Let, pcx);
    add_keyword(c"mut", Mut, pcx);
    add_keyword(c"struct", Struct, pcx);
    add_keyword(c"if", If, pcx);
    add_keyword(c"else", Else, pcx);
    add_keyword(c"loop", Loop, pcx);
    add_keyword(c"while", While, pcx);
    add_keyword(c"for", For, pcx);
    add_keyword(c"in", In, pcx);
    add_keyword(c"break", Break, pcx);
    add_keyword(c"continue", Continue, pcx);
    add_keyword(c"true", True, pcx);
    add_keyword(c"false", False, pcx);
    add_keyword(c"as", As, pcx);
    add_keyword(c"return", Return, pcx);
    add_keyword(c"extern", Extern, pcx);
    add_keyword(c"const", Const, pcx);
    add_keyword(c"static", Static, pcx);
    add_keyword(c"type", Tok::Type, pcx);
    add_keyword(c"enum", Enum, pcx);
    add_keyword(c"match", Match, pcx);
    add_keyword(c"impl", Impl, pcx);
    add_keyword(c"union", Union, pcx);
    add_keyword(c"import", Import, pcx);
    add_keyword(c"use", Use, pcx);
    add_keyword(c"pub", Pub, pcx);
    add_keyword(c"mod", Mod, pcx);
    add_keyword(c"defer", Defer, pcx);
    add_keyword(c"unsafe", Unsafe, pcx);
    add_keyword(c"trait", Trait, pcx);
    add_reserved(c"where", pcx);
    add_reserved(c"dyn", pcx);
    add_keyword(c"move", Tok::Move, pcx);
    add_keyword(c"var", Tok::Var, pcx);
    add_keyword(c"inout", Tok::Inout, pcx);
    add_keyword(c"sink", Tok::Sink, pcx);
    init_suffixes(pcx);
}

impl Tok {
    // The text of a keyword or punctuation token, for messages and the token
    // dump.
    pub fn text(self) -> *mut u8 {
        match self {
            Eof => c"EOF",
            Fn => c"fn",
            Let => c"let",
            Mut => c"mut",
            Struct => c"struct",
            If => c"if",
            Else => c"else",
            Loop => c"loop",
            While => c"while",
            For => c"for",
            In => c"in",
            Break => c"break",
            Continue => c"continue",
            True => c"true",
            False => c"false",
            As => c"as",
            Return => c"return",
            Extern => c"extern",
            Const => c"const",
            Static => c"static",
            Tok::Type => c"type",
            Enum => c"enum",
            Match => c"match",
            Impl => c"impl",
            Union => c"union",
            Import => c"import",
            Use => c"use",
            Pub => c"pub",
            Mod => c"mod",
            Defer => c"defer",
            Unsafe => c"unsafe",
            Trait => c"trait",
            Tok::Move => c"move",
            Tok::Var => c"var",
            Tok::Inout => c"inout",
            Tok::Sink => c"sink",
            Tok::Embedded => c"embedded",
            Tok::FHead => c"f\"",
            Tok::FMid => c"}",
            Tok::FTail => c"}",
            PlusEq => c"+=",
            MinusEq => c"-=",
            StarEq => c"*=",
            SlashEq => c"/=",
            PercentEq => c"%=",
            AmpEq => c"&=",
            PipeEq => c"|=",
            CaretEq => c"^=",
            BangEq => c"!=",
            EqEq => c"==",
            GtEq => c">=",
            LtEq => c"<=",
            AmpAmp => c"&&",
            PipePipe => c"||",
            Arrow => c"->",
            FatArrow => c"=>",
            Shl => c"<<",
            Shr => c">>",
            ShlEq => c"<<=",
            ShrEq => c">>=",
            DotDot => c"..",
            DotDotEq => c"..=",
            Ellipsis => c"...",
            ColonColon => c"::",
            Eq => c"=",
            Plus => c"+",
            Minus => c"-",
            Star => c"*",
            Slash => c"/",
            Percent => c"%",
            Caret => c"^",
            Amp => c"&",
            Pipe => c"|",
            Tilde => c"~",
            Bang => c"!",
            Lt => c"<",
            Gt => c">",
            Dot => c".",
            Comma => c",",
            Semi => c";",
            Colon => c":",
            Hash => c"#",
            Question => c"?",
            At => c"@",
            LParen => c"(",
            RParen => c")",
            LBrace => c"{",
            RBrace => c"}",
            LBracket => c"[",
            RBracket => c"]",
            // Tokens with a value: printed with it, by their users.
            _ => c"",
        }
    }

    // Keywords: printed as the identifier they are spelled with.
    pub fn is_keyword(self) -> bool {
        let k = self as i64;
        k >= Fn as i64 && k <= Mod as i64 || k >= Tok::Var as i64 && k <= Tok::Sink as i64
    }
}

fn init_suffixes(pcx: &mut Ctx<Comp>) {
    // (the symbols they had when the tools' cache restored the table)
    pcx.suffix_sym_base = intern(suffix_text(1), pcx);
    for suffix in 2..13 {
        intern(suffix_text(suffix), pcx);
    }
}

// The suffix a symbol names, or SUF_NONE.
fn suffix_of_sym(sym: i64, pcx: &Ctx<Comp>) -> i64 {
    if sym >= pcx.suffix_sym_base && sym < pcx.suffix_sym_base + 12 {
        return sym - pcx.suffix_sym_base + 1;
    }
    SUF_NONE
}

fn is_float_suffix(suffix: i64) -> bool {
    suffix == SUF_F32 || suffix == SUF_F64
}

pub fn keyword_of_sym(sym: i64, pcx: &Ctx<Comp>) -> Tok {
    if (sym as u64) < SYM_KEYWORDS as u64 { pcx.sym_keyword[sym as usize] } else { Eof }
}

// ---- The lexer ----

// UNSAFE: C's memchr, which finds the end of a comment's line many bytes at a time: a C
// function, which only an extern block can declare.
// SAFETY: the declaration is memchr's C prototype on the targets vole builds for (64-bit macOS
// and Linux: int is i32, size_t u64, long and long long i64, a pointer 8 bytes); what a call
// must hold (n readable bytes at s) is said at the call.
extern "C" {
    fn memchr(s: *mut u8, c: i32, n: u64) -> *mut u8;
}

// ' ', '\t', '\r', '\n'
const CL_SPACE: u8 = 1;
// '_', letters, digits
const CL_IDENT: u8 = 2;
// '_', letters: an identifier's first byte
const CL_ALPHA: u8 = 4;
const CL_DIGIT: u8 = 8;
// a byte that starts a two- or three-byte operator
const CL_OP: u8 = 16;

fn init_byte_classes(pcx: &mut Ctx<Comp>) {
    for b in 0..256usize {
        let c = b as u8;
        let mut k: u8 = 0;
        if is_whitespace(c) {
            k |= CL_SPACE;
        }
        if is_ident_byte(c) {
            k |= CL_IDENT;
        }
        if c == b'_' || is_alpha(c) {
            k |= CL_ALPHA;
        }
        if is_digit(c) {
            k |= CL_DIGIT;
        }
        pcx.byte_class[b] = k;
        // (the bytes no two- or three-byte operator starts with)
        if two_char_operator(c, b'=') == Eof && c != b'<' && c != b'>' && c != b'&' && c != b'|'
            && c != b'-' && c != b'.' && c != b':' {
            pcx.single_tok[b] = one_char_operator(c);
        } else if one_char_operator(c) != Eof {
            pcx.byte_class[b] = k | CL_OP;
        }
    }
}

pub fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

pub fn is_alpha(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')
}

pub fn is_ident_byte(c: u8) -> bool {
    c == b'_' || is_alpha(c) || is_digit(c)
}

fn is_whitespace(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n'
}

// The byte at `offset` from the lexer position, 0 past the end.
fn peek_at(offset: i64, pcx: &Ctx<Comp>) -> u8 {
    if pcx.lex_pos + offset < pcx.lex_end { get_src()[(pcx.lex_pos + offset) as usize] } else { 0 }
}

fn at_end(pcx: &Ctx<Comp>) -> bool {
    pcx.lex_pos >= pcx.lex_end
}

fn push_token(kind: Tok, start: i64, value: u64, suffix: i64, pcx: &mut Ctx<Comp>) {
    add_token(kind, start, pcx.lex_pos, value, suffix,
        joint_at(get_src(), &pcx.byte_class, pcx.lex_pos, pcx.lex_end), pcx);
    pcx.lex_after_dot = kind == Dot;
}

fn add_token(kind: Tok, start: i64, end: i64, value: u64, suffix: i64, joint: bool,
    pcx: &mut Ctx<Comp>) {
    pcx.toks.push(Token { kind, start, end, value, suffix, joint });
}

// Nothing separates the token that ends at `pos` from the next one.
fn joint_at(src: &[u8], classes: &[u8; 256], pos: i64, end: i64) -> bool {
    if pos >= end {
        return false;
    }
    let c = src[pos as usize];
    if (classes[c as usize] & CL_SPACE) != 0 {
        return false;
    }
    if c == b'/' && pos + 1 < end {
        let next = src[(pos + 1) as usize];
        return !(next == b'/' || next == b'*');
    }
    true
}

fn skip_whitespace_and_comments(pcx: &mut Ctx<Comp>) {
    pcx.lex_pos = skip_blank(get_src(), pcx.lex_pos, pcx.lex_end, pcx);
}

// The position of the first byte from `pos` that is neither whitespace nor
// in a comment (`end` when none is).
fn skip_blank(src: &[u8], pos: i64, end: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut p = pos;
    loop {
        while p < end && (pcx.byte_class[src[p as usize] as usize] & CL_SPACE) != 0 {
            p += 1;
        }
        if p + 1 >= end || src[p as usize] != b'/' {
            return p;
        }
        let next = src[(p + 1) as usize];
        if next == b'/' {
            // (to the end of the line, by memchr)
            p = match find_byte(&src[p as usize..end as usize], b'\n') {
                Some(at) => p + at as i64,
                None => end,
            };
        } else if next == b'*' {
            pcx.lex_pos = p;
            skip_block_comment(pcx);
            p = pcx.lex_pos;
        } else {
            return p;
        }
    }
    p
}

// Where byte b first is in hay.
pub fn find_byte(hay: &[u8], b: u8) -> Option<usize> {
    // UNSAFE: C's memchr, which searches many bytes at a time (a comment's
    // line, the instruction table's lines); a C call
    // SAFETY: hay.ptr points at hay.len() readable bytes, a slice's own
    // guarantee, and memchr reads no further; its result is null or a
    // pointer into those bytes, so the difference is under hay.len()
    let found = unsafe { memchr(hay.ptr, b as i32, hay.len() as u64) };
    if found == 0 as *mut u8 { None } else { Some(found as usize - hay.ptr as usize) }
}

// Block comments nest.
fn skip_block_comment(pcx: &mut Ctx<Comp>) {
    let start = pcx.lex_pos;
    let mut depth: i64 = 0;
    while !at_end(pcx) {
        if peek_at(0, pcx) == b'/' && peek_at(1, pcx) == b'*' {
            depth += 1;
            pcx.lex_pos += 2;
        } else if peek_at(0, pcx) == b'*' && peek_at(1, pcx) == b'/' {
            depth -= 1;
            pcx.lex_pos += 2;
            if depth == 0 {
                return;
            }
        } else {
            pcx.lex_pos += 1;
        }
    }
    error_at(start, c"unterminated block comment", pcx);
}

// Lexes SRC[start..end) and appends its tokens; `last` adds the EOF token.
pub fn lex_range(start: i64, end: i64, last: bool, pcx: &mut Ctx<Comp>) {
    if pcx.lex_scratch < 0 {
        pcx.lex_scratch = buf_new();
        init_byte_classes(pcx);
    }
    pcx.lex_pos = start;
    pcx.lex_end = end;
    pcx.lex_after_dot = false;
    pcx.lex_first = pcx.toks.len() as i64;
    crate::front::lexer::blocks::ftext_reset(pcx);
    lex_loop(pcx);
    if last {
        push_token(Eof, pcx.lex_pos, 0, 0, pcx);
    }
}

// RULE: Z5.2 (0.27.5) SRC[start..end), a run of std2's units, lexed as
// lex_range does, its last token's `joint` as when its whole text,
// SRC[..text_end), is lexed (std2lazy.vl: lex_units).
pub fn lex_span(start: i64, end: i64, text_end: i64, pcx: &mut Ctx<Comp>) {
    let first = pcx.toks.len() as i64;
    lex_range(start, end, last: false, pcx: pcx);
    let last = pcx.toks.len() as i64 - 1;
    if last >= first {
        pcx.toks[last as usize].joint = joint_at(get_src(), &pcx.byte_class,
            pcx.toks[last as usize].end, text_end);
    }
}

// (0.27.0) Whether keyword kind is MVS's and no keyword of Rust's: in the
// rust edition the word is a name (`io::sink`, a field `var`).
fn mvs_only_keyword(kind: Tok) -> bool {
    kind == Tok::Var || kind == Tok::Inout || kind == Tok::Sink || kind == Defer
}

// (0.27.6) Whether SRC[p] is the NUL after a file's newline that
// add_source keeps when it adds a file after it: no file's text.
fn source_gap(p: i64, pcx: &Ctx<Comp>) -> bool {
    for f in 0..pcx.files.len() as i64 {
        if pcx.files[f as usize].end + 1 == p {
            return true;
        }
    }
    false
}

// (0.25) The tokens of SRC[LEX_POS..LEX_END), the position in a local:
// identifiers, keywords, punctuation and plain decimal integers here,
// the rest (strings, characters, other numbers, errors) by lex_token
// (LEX_POS set around it).
fn lex_loop(pcx: &mut Ctx<Comp>) {
    let src = get_src();
    let end = pcx.lex_end;
    let mut pos = pcx.lex_pos;
    while pos < end {
        let mut c = src[pos as usize];
        let mut class = pcx.byte_class[c as usize];
        if (class & CL_SPACE) != 0 || c == b'/' {
            pos = skip_blank(src, pos, end, pcx);
            if pos >= end {
                break;
            }
            c = src[pos as usize];
            class = pcx.byte_class[c as usize];
        }
        // (0.27.6) the NUL that ends a file another was added after
        // (base::add_source): blank, as the newlines around it
        if c == 0 && source_gap(pos, pcx) {
            pos += 1;
            continue;
        }
        let mut kind = Eof;
        let mut p = pos + 1;
        let mut value: u64 = 0;
        if (class & CL_ALPHA) != 0 {
            let next = if p < end { src[p as usize] } else { 0 };
            // (0.27.2: `b'x'`, a byte literal of the rust edition: lex_token's)
            if !((c == b'c' || c == b'f') && next == b'"')
                && !(c == b'r' && (next == b'#' || next == b'"'))
                && !(c == b'b' && (next == b'\'' || next == b'"')) {
                while p < end && (pcx.byte_class[src[p as usize] as usize] & CL_IDENT) != 0 {
                    p += 1;
                }
                let sym = intern(&src[pos as usize..p as usize], pcx);
                kind = Ident;
                if (sym as u64) < SYM_KEYWORDS as u64 && pcx.sym_keyword[sym as usize] != Eof {
                    kind = pcx.sym_keyword[sym as usize];
                    if mvs_only_keyword(kind) {
                        // (0.27.0: a name in the rust edition)
                        kind = Ident;
                    } else if kind == Union {
                        // (0.27.0: as Rust's, `union` is a keyword only
                        // before a name, `union U {`; `fn union`,
                        // `a.union(b)` are the name)
                        let mut q = p;
                        while q < end
                            && (pcx.byte_class[src[q as usize] as usize] & CL_SPACE) != 0 {
                            q += 1;
                        }
                        if q >= end || (pcx.byte_class[src[q as usize] as usize] & CL_ALPHA) == 0 {
                            kind = Ident;
                        }
                    }
                }
                value = sym as u64;
            }
        } else {
            kind = pcx.single_tok[c as usize];
            if kind == Eof && (class & CL_OP) != 0 {
                // (lex_operator, here)
                let b = if p < end { src[p as usize] } else { 0 };
                if pos + 2 < end && (c == b'<' || c == b'>' || c == b'.') {
                    kind = three_char_operator(c, b, src[(pos + 2) as usize]);
                    p = pos + 3;
                }
                if kind == Eof && pos + 1 < end {
                    kind = two_char_operator(c, b);
                    p = pos + 2;
                }
                if kind == Eof {
                    kind = one_char_operator(c);
                    p = pos + 1;
                }
            } else if kind == Eof && (class & CL_DIGIT) != 0 {
                let after = lex_plain_integer(src, pos, end, pcx);
                if after > pos {
                    pos = after;
                    continue;
                }
            }
        }
        if kind == Eof {
            pcx.lex_pos = pos;
            lex_token(pcx);
            pos = pcx.lex_pos;
            continue;
        }
        // (joint_at, here)
        let mut joint = false;
        if p < end {
            let d = src[p as usize];
            joint = (pcx.byte_class[d as usize] & CL_SPACE) == 0
                && !(d == b'/' && p + 1 < end
                    && (src[(p + 1) as usize] == b'/' || src[(p + 1) as usize] == b'*'));
        }
        pcx.toks.push(Token { kind, start: pos, end: p, value, suffix: 0, joint });
        pcx.lex_after_dot = kind == Dot;
        // (0.26.0: `embed LANG NAME {`: its text is one token, lexing
        // resumes at its `}`)
        if kind == LBrace && embedded::at_embedded_open(pcx) {
            p = embedded::lex_embedded(pos, pcx);
        }
        pos = p;
    }
    pcx.lex_pos = pos;
}

// A decimal integer without '_' or a suffix at `pos`, not a float (or a
// tuple index): its token added, its end returned; else `pos`, nothing
// added (lex_number then lexes it, and reports its errors).
fn lex_plain_integer(src: &[u8], pos: i64, end: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut p = pos;
    let mut value: u64 = 0;
    while p < end && (pcx.byte_class[src[p as usize] as usize] & CL_DIGIT) != 0 {
        let digit = (src[p as usize] - b'0') as u64;
        if value > (0xffffffffffffffff - digit) / 10 {
            return pos;
        }
        value = value * 10 + digit;
        p += 1;
    }
    if p < end {
        let c = src[p as usize];
        if (pcx.byte_class[c as usize] & CL_IDENT) != 0 {
            return pos;
        }
        if c == b'.' && !pcx.lex_after_dot && p + 1 < end
            && (pcx.byte_class[src[(p + 1) as usize] as usize] & CL_DIGIT) != 0 {
            return pos;
        }
    }
    let joint = joint_at(src, &pcx.byte_class, p, end);
    add_token(Int, pos, p, value, 0, joint, pcx);
    pcx.lex_after_dot = false;
    p
}

fn lex_token(pcx: &mut Ctx<Comp>) {
    let c = peek_at(0, pcx);
    if c == b'"' && at_text_block(pcx) {
        lex_text_block(pcx.lex_pos, raw: false, hashes: 0, pcx: pcx);
    } else if c == b'"' {
        lex_string(pcx.lex_pos, is_c: false, pcx: pcx);
    } else if c == b'c' && peek_at(1, pcx) == b'"' {
        lex_string(pcx.lex_pos, is_c: true, pcx: pcx);
    } else if c == b'f' && peek_at(1, pcx) == b'"' {
        lex_fstring(pcx.lex_pos, pcx);
    } else if c == b'\'' {
        lex_char(-1, pcx);
    } else if c == b'b' && peek_at(1, pcx) == b'"' {
        // (0.27.3: a byte string of the rust edition, `b"..."`: lex_loop's)
        pcx.lex_pos += 1;
        lex_string(pcx.lex_pos - 1, is_c: false, pcx: pcx);
    } else if c == b'b' && peek_at(1, pcx) == b'\'' {
        // (0.27.2: a byte literal of the rust edition, lex_loop's)
        pcx.lex_pos += 1;
        lex_char(pcx.lex_pos - 1, pcx);
    } else if is_digit(c) {
        lex_number(pcx);
    }
    else if c == b'r' && (peek_at(1, pcx) == b'"' || peek_at(1, pcx) == b'#')
        && raw_block_hashes(pcx) >= 0 {
        lex_text_block(pcx.lex_pos, raw: true, hashes: raw_block_hashes(pcx), pcx: pcx);
    }
    else if c == b'r' && peek_at(1, pcx) == b'#'
        && (peek_at(2, pcx) == b'_' || is_alpha(peek_at(2, pcx))) {
        lex_raw_ident(pcx);
    } else if c == b'_' || is_alpha(c) {
        lex_ident(pcx);
    } else {
        lex_operator(pcx);
    }
}

fn lex_ident(pcx: &mut Ctx<Comp>) {
    let start = pcx.lex_pos;
    while !at_end(pcx) && is_ident_byte(peek_at(0, pcx)) {
        pcx.lex_pos += 1;
    }
    let sym = intern(&get_src()[start as usize..pcx.lex_pos as usize], pcx);
    let keyword = keyword_of_sym(sym, pcx);
    if keyword == Eof {
        push_token(Ident, start, sym as u64, 0, pcx);
    } else {
        push_token(keyword, start, sym as u64, 0, pcx);
    }
}

// `r#name`: an identifier even when `name` is a keyword (C names imported
// by `import`, for instance a field named `type`).
fn lex_raw_ident(pcx: &mut Ctx<Comp>) {
    let start = pcx.lex_pos;
    pcx.lex_pos += 2;
    let name_start = pcx.lex_pos;
    while !at_end(pcx) && is_ident_byte(peek_at(0, pcx)) {
        pcx.lex_pos += 1;
    }
    push_token(Ident, start,
        intern(&get_src()[name_start as usize..pcx.lex_pos as usize], pcx) as u64, 0, pcx);
}

// The operators spelled by the next bytes (Tok::Eof: none).
fn three_char_operator(a: u8, b: u8, c: u8) -> Tok {
    if a == b'<' && b == b'<' && c == b'=' { return ShlEq; }
    if a == b'>' && b == b'>' && c == b'=' { return ShrEq; }
    if a == b'.' && b == b'.' && c == b'.' { return Ellipsis; }
    if a == b'.' && b == b'.' && c == b'=' { return DotDotEq; }
    Eof
}

fn two_char_operator(a: u8, b: u8) -> Tok {
    if b == b'=' {
        if a == b'+' { return PlusEq; }
        if a == b'-' { return MinusEq; }
        if a == b'*' { return StarEq; }
        if a == b'/' { return SlashEq; }
        if a == b'%' { return PercentEq; }
        if a == b'&' { return AmpEq; }
        if a == b'|' { return PipeEq; }
        if a == b'^' { return CaretEq; }
        if a == b'!' { return BangEq; }
        if a == b'=' { return EqEq; }
        if a == b'>' { return GtEq; }
        if a == b'<' { return LtEq; }
        return Eof;
    }
    if a == b'<' && b == b'<' { return Shl; }
    if a == b'>' && b == b'>' { return Shr; }
    if a == b'&' && b == b'&' { return AmpAmp; }
    if a == b'|' && b == b'|' { return PipePipe; }
    if a == b'-' && b == b'>' { return Arrow; }
    if a == b'=' && b == b'>' { return FatArrow; }
    if a == b'.' && b == b'.' { return DotDot; }
    if a == b':' && b == b':' { return ColonColon; }
    Eof
}

fn one_char_operator(c: u8) -> Tok {
    if c == b'=' { return Eq; }
    if c == b'+' { return Plus; }
    if c == b'-' { return Minus; }
    if c == b'*' { return Star; }
    if c == b'/' { return Slash; }
    if c == b'%' { return Percent; }
    if c == b'^' { return Caret; }
    if c == b'&' { return Amp; }
    if c == b'|' { return Pipe; }
    if c == b'~' { return Tilde; }
    if c == b'!' { return Bang; }
    if c == b'<' { return Lt; }
    if c == b'>' { return Gt; }
    if c == b'.' { return Dot; }
    if c == b',' { return Comma; }
    if c == b';' { return Semi; }
    if c == b':' { return Colon; }
    if c == b'#' { return Hash; }
    if c == b'?' { return Question; }
    if c == b'@' { return At; }
    if c == b'(' { return LParen; }
    if c == b')' { return RParen; }
    if c == b'{' { return LBrace; }
    if c == b'}' { return RBrace; }
    if c == b'[' { return LBracket; }
    if c == b']' { return RBracket; }
    Eof
}

fn lex_operator(pcx: &mut Ctx<Comp>) {
    let start = pcx.lex_pos;
    let end = pcx.lex_end;
    let src = get_src();
    let a = src[start as usize];
    if start + 1 < end {
        let b = src[(start + 1) as usize];
        if start + 2 < end {
            let kind = three_char_operator(a, b, src[(start + 2) as usize]);
            if kind != Eof {
                pcx.lex_pos = start + 3;
                push_token(kind, start, 0, 0, pcx);
                return;
            }
        }
        let kind = two_char_operator(a, b);
        if kind != Eof {
            pcx.lex_pos = start + 2;
            push_token(kind, start, 0, 0, pcx);
            return;
        }
    }
    let kind = one_char_operator(a);
    if kind == Eof {
        error_at(start, c"unexpected character", pcx);
    }
    pcx.lex_pos += 1;
    push_token(kind, start, 0, 0, pcx);
}

// ---- Numbers ----

// A '_' may end the digits only when a suffix follows (`1_u8`).
fn check_trailing_underscore(last_underscore: bool, pcx: &mut Ctx<Comp>) {
    if last_underscore && !(!at_end(pcx) && is_alpha(peek_at(0, pcx))) {
        error_at(pcx.lex_pos - 1, c"trailing underscore in literal", pcx);
    }
}

fn lex_number(pcx: &mut Ctx<Comp>) {
    let start = pcx.lex_pos;
    let second = peek_at(1, pcx);
    if peek_at(0, pcx) == b'0'
        && (second == b'x' || second == b'X' || second == b'b' || second == b'B') {
        let radix: u64 = if second == b'x' || second == b'X' { 16 } else { 2 };
        pcx.lex_pos += 2;
        let value = lex_radix_digits(radix, pcx);
        lex_int_suffix(value, start, false, pcx);
        return;
    }
    // RULE: F23.5 (0.27.6: `0o644`, an octal literal of the rust edition)
    if peek_at(0, pcx) == b'0' && second == b'o' {
        pcx.lex_pos += 2;
        octal_digit_check(pcx);
        let value = lex_radix_digits(8, pcx);
        octal_digit_check(pcx);
        lex_int_suffix(value, start, false, pcx);
        return;
    }
    lex_decimal_or_float(start, pcx);
}

// A decimal digit an octal literal cannot hold, `8` or `9`, where its
// digits go: rustc's error, not an invalid suffix.
fn octal_digit_check(pcx: &mut Ctx<Comp>) {
    // RULE: F23.5
    if !at_end(pcx) && (peek_at(0, pcx) == b'8' || peek_at(0, pcx) == b'9') {
        error_at(pcx.lex_pos, c"invalid digit for a base 8 literal", pcx);
    }
}

fn digit_value(c: u8, radix: u64) -> i64 {
    let value = hex_value(c);
    if value < 0 || value as u64 >= radix { -1 } else { value }
}

fn lex_radix_digits(radix: u64, pcx: &mut Ctx<Comp>) -> u64 {
    unsafe {
        if at_end(pcx) || digit_value(peek_at(0, pcx), radix) < 0 {
            error_at(pcx.lex_pos,
                if radix == 16 { c"expected hex digit after '0x'" }
                else if radix == 8 { c"expected octal digit after '0o'" }
                else { c"expected binary digit after '0b'" }, pcx);
        }
        let mut value: u64 = 0;
        let mut last_underscore = false;
        let src = get_src();
        let end = pcx.lex_end;
        let mut p = pcx.lex_pos;
        while p < end {
            let c = src[p as usize];
            if c == b'_' {
                last_underscore = true;
                p += 1;
                continue;
            }
            let digit = digit_value(c, radix);
            if digit < 0 {
                break;
            }
            last_underscore = false;
            if value > (0xffffffffffffffff - digit as u64) / radix {
                error_at(p, c"literal overflow", pcx);
            }
            value = value * radix + digit as u64;
            p += 1;
        }
        pcx.lex_pos = p;
        check_trailing_underscore(last_underscore, pcx);
        value
    }
}

// An identifier glued to a literal: its symbol, or -1.
fn read_suffix(pcx: &mut Ctx<Comp>) -> i64 {
    if at_end(pcx) || !is_ident_byte(peek_at(0, pcx)) {
        return -1;
    }
    let start = pcx.lex_pos;
    while !at_end(pcx) && is_ident_byte(peek_at(0, pcx)) {
        pcx.lex_pos += 1;
    }
    intern(&get_src()[start as usize..pcx.lex_pos as usize], pcx)
}

fn bits_of_f64(value: f64) -> u64 {
    value.to_bits()
}

fn lex_int_suffix(value: u64, start: i64, decimal: bool, pcx: &mut Ctx<Comp>) {
    let suffix_at = pcx.lex_pos;
    let sym = read_suffix(pcx);
    if sym < 0 {
        push_token(Int, start, value, 0, pcx);
        return;
    }
    let suffix = suffix_of_sym(sym, pcx);
    if suffix != SUF_NONE && is_float_suffix(suffix) && decimal {
        push_token(Float, start, bits_of_f64(value as f64), suffix, pcx);
        return;
    }
    if suffix != SUF_NONE && !is_float_suffix(suffix) {
        push_token(Int, start, value, suffix, pcx);
        return;
    }
    error_at(suffix_at, c"invalid suffix on integer literal", pcx);
}

// Decimal digits (without '_') appended to `out`.
fn read_decimal_digits(out: i64, pcx: &mut Ctx<Comp>) {
    if at_end(pcx) || !is_digit(peek_at(0, pcx)) {
        error_at(pcx.lex_pos, c"expected digit", pcx);
    }
    let mut last_underscore = false;
    while !at_end(pcx) {
        let c = peek_at(0, pcx);
        if c == b'_' {
            last_underscore = true;
            pcx.lex_pos += 1;
            continue;
        }
        if !is_digit(c) {
            break;
        }
        last_underscore = false;
        buf_byte(out, c);
        pcx.lex_pos += 1;
    }
    check_trailing_underscore(last_underscore, pcx);
}

// An exponent (`e5`, `E-3`) starts here.
fn at_exponent(pcx: &Ctx<Comp>) -> bool {
    let e = peek_at(0, pcx);
    if at_end(pcx) || !(e == b'e' || e == b'E') || pcx.lex_pos + 1 >= pcx.lex_end {
        return false;
    }
    let sign = peek_at(1, pcx);
    if sign == b'+' || sign == b'-' {
        return pcx.lex_pos + 2 < pcx.lex_end && is_digit(peek_at(2, pcx));
    }
    is_digit(sign)
}

// The double C's strtod reads at the start of text, whose last byte is
// the NUL that ends it, and how many bytes it read.
pub fn c_double(text: &[u8]) -> (f64, usize) {
    assert(text.len() > 0 && text[text.len() - 1] == 0);
    let mut end = 0 as *mut u8;
    // UNSAFE: C's strtod, the correctly rounded conversion the float
    // literals have always had; a C call
    // SAFETY: text's last byte is 0 (checked above) and strtod reads no
    // further than the first NUL, so it reads text's bytes only; it writes
    // `end`, a local, with a pointer into those bytes
    let value = unsafe { strtod(text.ptr, &mut end) };
    (value, end as usize - text.ptr as usize)
}

fn lex_decimal_or_float(start: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let text = pcx.lex_scratch;
        buf_clear(text);
        read_decimal_digits(text, pcx);
        let has_fraction = peek_at(0, pcx) == b'.' && pcx.lex_pos + 1 < pcx.lex_end
            && is_digit(peek_at(1, pcx));
        let has_exponent = at_exponent(pcx);
        if pcx.lex_after_dot || !(has_fraction || has_exponent) {
            let mut value: u64 = 0;
            for i in 0..buf_len(text) {
                let digit = (buf_at(text, i) - b'0') as u64;
                if value > (0xffffffffffffffff - digit) / 10 {
                    error_at(pcx.lex_pos, c"integer overflow", pcx);
                }
                value = value * 10 + digit;
            }
            lex_int_suffix(value, start, !pcx.lex_after_dot, pcx);
            return;
        }
        if has_fraction {
            pcx.lex_pos += 1;
            buf_byte(text, b'.');
            read_decimal_digits(text, pcx);
        }
        if !at_end(pcx) && (peek_at(0, pcx) == b'e' || peek_at(0, pcx) == b'E') {
            pcx.lex_pos += 1;
            buf_byte(text, b'e');
            if !at_end(pcx) && (peek_at(0, pcx) == b'+' || peek_at(0, pcx) == b'-') {
                buf_byte(text, peek_at(0, pcx));
                pcx.lex_pos += 1;
            }
            if at_end(pcx) || !is_digit(peek_at(0, pcx)) {
                error_at(pcx.lex_pos, c"expected digit in exponent", pcx);
            }
            read_decimal_digits(text, pcx);
        }
        buf_byte(text, 0);
        let value = c_double(buf_slice(text)).0;
        let suffix_at = pcx.lex_pos;
        let sym = read_suffix(pcx);
        if sym < 0 {
            push_token(Float, start, bits_of_f64(value), 0, pcx);
            return;
        }
        let suffix = suffix_of_sym(sym, pcx);
        if suffix == SUF_NONE || !is_float_suffix(suffix) {
            error_at(suffix_at, c"invalid suffix on float literal", pcx);
        }
        push_token(Float, start, bits_of_f64(value), suffix, pcx);
    }
}

// ---- The token dump (`--tokens`) ----

pub fn dump_tokens(out: i64, base: i64, pcx: &Ctx<Comp>) {
    for i in 0..pcx.toks.len() as i64 {
        let tok = pcx.toks[i as usize];
        buf_fmt(out, format_args("{} {} ", tok.start - base, tok.end - base));
        buf_byte(out, if tok.joint { b'1' } else { b'0' });
        buf_byte(out, b' ');
        dump_token_text(out, tok, pcx);
        buf_byte(out, b'\n');
    }
}

fn dump_hex_bytes(out: i64, id: i64) {
    unsafe {
        for i in 0..str_at(id).len() {
            buf_hex(out, str_at(id)[i] as u64, 2);
        }
    }
}

fn dump_token_text(out: i64, tok: Token, pcx: &Ctx<Comp>) {
    unsafe {
        let kind = tok.kind;
        let value = tok.value;
        if kind == Int {
            buf_fmt(out, format_args("int {value}"));
        } else if kind == Float {
            buf_str(out, c"float ");
            buf_hex(out, value, 16);
        } else if kind == Char {
            buf_fmt(out, format_args("char {value}"));
        } else if kind == Str {
            buf_str(out, c"str ");
            dump_hex_bytes(out, value as i64);
        } else if kind == CStr {
            buf_str(out, c"cstr ");
            dump_hex_bytes(out, value as i64);
        } else if kind == Tok::FHead || kind == Tok::FMid || kind == Tok::FTail {
            // (0.15: an f-string's pieces, the spec after the text)
            buf_str(out, if kind == Tok::FHead { c"fhead " } else if kind == Tok::FMid { c"fmid " }
                else { c"ftail " });
            dump_hex_bytes(out, value as i64);
            if kind != Tok::FHead && tok.suffix >= 0 {
                buf_str(out, c" spec ");
                dump_hex_bytes(out, tok.suffix);
            }
            return;
        } else if kind == Ident {
            buf_fmt(out,
                format_args("ident {}", str::from_utf8(sym_text(value as i64, pcx)).unwrap()));
        } else if kind == Reserved {
            buf_str(out, sym_name(value as i64, pcx));
        } else {
            buf_str(out, kind.text());
        }
        if tok.suffix != SUF_NONE {
            buf_fmt(out,
                format_args(" {}", str::from_utf8(suffix_text(tok.suffix)).unwrap()));
        }
    }
}

// (0.28.0) STRS's accessors: every use of it is one of them.
pub fn get_strs() -> *mut &'static [u8] {
    // UNSAFE: the program's string table, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: a task reaches its only writer add_string only through
    // gen0::target::add_const_data from parallel::const_data's serial
    // branch (task_phase == 0); every task sets cx.task_phase non-zero
    // before it can make constant data (run_task: P_CLEANUP, P_SIMPLIFY;
    // run_component: P_COMPONENT; emit_task: P_DEFERRED, P_SLP, P_EMIT; the
    // cache's replays set the recorded phase), so add_const_data runs only
    // on the main thread outside phases (register_consts, after the phase)
    // and serial code
    unsafe { STRS }
}

pub fn set_strs(v: *mut &'static [u8]) {
    // UNSAFE: the program's string table, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: a task reaches its only writer add_string only through
    // gen0::target::add_const_data from parallel::const_data's serial
    // branch (task_phase == 0); every task sets cx.task_phase non-zero
    // before it can make constant data (run_task: P_CLEANUP, P_SIMPLIFY;
    // run_component: P_COMPONENT; emit_task: P_DEFERRED, P_SLP, P_EMIT; the
    // cache's replays set the recorded phase), so add_const_data runs only
    // on the main thread outside phases (register_consts, after the phase)
    // and serial code
    unsafe {
        STRS = v;
    }
}

// (0.28.0) STR_COUNT's accessors: every use of it is one of them.
pub fn get_str_count() -> i64 {
    // UNSAFE: the string table's count, a process-wide static mut; Rust has
    // no safe access to a static mut
    // SAFETY: written only by add_string, which no task runs (STRS); the
    // joining main thread reads it in give_id while tasks run, but no task
    // writes it, and the main thread's own writes (register_consts) come
    // after the phase
    unsafe { STR_COUNT }
}

pub fn set_str_count(v: i64) {
    // UNSAFE: the string table's count, a process-wide static mut; Rust has
    // no safe access to a static mut
    // SAFETY: written only by add_string, which no task runs (STRS); the
    // joining main thread reads it in give_id while tasks run, but no task
    // writes it, and the main thread's own writes (register_consts) come
    // after the phase
    unsafe {
        STR_COUNT = v;
    }
}

// (0.28.0) STR_CAP's accessors: every use of it is one of them.
fn get_str_cap() -> i64 {
    // UNSAFE: the string table's capacity, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: written only by add_string, which no task runs (see STRS:
    // const_data's serial branch only); the join does not reach add_string
    unsafe { STR_CAP }
}

fn set_str_cap(v: i64) {
    // UNSAFE: the string table's capacity, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: written only by add_string, which no task runs (see STRS:
    // const_data's serial branch only); the join does not reach add_string
    unsafe {
        STR_CAP = v;
    }
}
