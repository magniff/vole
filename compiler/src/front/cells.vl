// (0.26.1) Interior mutability (docs/grammar.md, "Interior mutability";
// docs/design/rust-surface-plan.md §1 g, §5): std::cell::UnsafeCell, the
// one type whose memory changes through a shared reference, and the facts
// that follow from it.
//
// - UnsafeCell is owned (front/own/kinds.vl: K_OWNED, no K_NEEDS_DROP), so
//   a `let` parameter of it, or of what holds it, is a `&T` to the
//   caller's place (front/conv.vl: param_type).
// - Freeze, an auto trait (std::Freeze, front/traits.vl: intrinsic): a type
//   is Freeze unless it holds an UnsafeCell by value, looking through
//   arrays, tuples, structs, enum payloads and closure environments, never
//   through `*T`, `&T` or `[T]` (`Vec<Cell<T>>` is Freeze, as in Rust).
//   Structural and memoized per type id.
// - A copy of a cell is another cell: where the own pass would make a bit
//   copy of a value that is not Freeze (std's copying getters), it is
//   own.interior_copy (interior_copy, below).

use crate::base::{
    SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, find_sym, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::report_error_once;
use crate::front::modules::{file_of_pos, within_std};
use crate::front::types::{
    ENUMS, TYPES, TyKind, buf_type, enum_variant, struct_field, type_elem, variant_field,
};
use crate::middle::lower::ssa::HMap;

static var SYM_UNSAFE_CELL: i64 = 0;

// Per type id + 1: the UnsafeCell type it holds + 1 (1: none, Freeze).
static var FREEZE_MEMO: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

// Whether struct s (an instance: its template's) is std::cell::UnsafeCell.
pub fn is_unsafe_cell_struct(s: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: STRUCTS is the checker's raw table of structs (*StructInfo).
    // SAFETY: s is a struct id below STRUCT_COUNT (a struct type's TYPES[t].a);
    // tmpl - 1, when set, is its template's id.
    unsafe {
        // (0.27.0: read, as a task may ask: find_cell_sym keeps it; a
        // name no symbol is names no struct)
        let cell = if SYM_UNSAFE_CELL != 0 { SYM_UNSAFE_CELL } else { find_sym("UnsafeCell") };
        let t = if pcx.structs[s].tmpl != 0 { pcx.structs[s].tmpl - 1 } else { s };
        cell >= 0 && pcx.structs[t].name == cell && within_std(pcx.structs[t].module, pcx)
    }
}

// (0.27.0) Keeps the symbol `UnsafeCell` for is_unsafe_cell_struct once it
// is one (after parsing, the main thread's: front::types::init_types,
// middle::parallel's prepare_tasks).
pub fn find_cell_sym() {
    if SYM_UNSAFE_CELL == 0 {
        let sym = find_sym("UnsafeCell");
        if sym >= 0 {
            SYM_UNSAFE_CELL = sym;
        }
    }
}

// Whether type t is an UnsafeCell<T>.
pub fn is_unsafe_cell(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && TYPES[t].kind == TyKind::Struct && is_unsafe_cell_struct(TYPES[t].a, pcx)
}

// Whether type t is std::cell::Cell<T>.
fn is_std_cell(t: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: STRUCTS is the checker's raw table of structs (*StructInfo).
    // SAFETY: a struct type's TYPES[t].a is a struct id; tmpl - 1 its template's.
    unsafe {
        if t <= 0 || TYPES[t].kind != TyKind::Struct {
            return false;
        }
        let s = TYPES[t].a;
        let b = if pcx.structs[s].tmpl != 0 { pcx.structs[s].tmpl - 1 } else { s };
        sym_text(pcx.structs[b].name) == "Cell" && within_std(pcx.structs[b].module, pcx)
    }
}

// Whether type t is Freeze: it holds no UnsafeCell by value.
pub fn is_freeze(t: i64, pcx: Ctx<Comp>) -> bool {
    interior_part(t, pcx) == 0
}

// The UnsafeCell type that type t holds by value, the first found; 0:
// none (t is Freeze).
pub fn interior_part(t: i64, pcx: Ctx<Comp>) -> i64 {
    if t <= 0 || t == pcx.ty_error {
        return 0;
    }
    let known = FREEZE_MEMO.get(t + 1);
    if known != 0 {
        return known - 1;
    }
    // (a type reached again while it is decided: Freeze there)
    FREEZE_MEMO.put(t + 1, 1);
    let r = interior_of(t, pcx);
    FREEZE_MEMO.put(t + 1, r + 1);
    r
}

fn interior_of(t: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: STRUCTS, ENUMS and VARIANTS are the checker's raw tables.
    // SAFETY: t > 0 is a type id; a struct type's TYPES[t].a is a struct id, an
    // enum type's an enum id, whose variants and fields are in range.
    unsafe {
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct {
            let s = TYPES[t].a;
            if is_unsafe_cell_struct(s, pcx) {
                return t;
            }
            for i in 0..pcx.structs[s].field_count {
                let r = interior_part((*struct_field(s, i, pcx)).ty, pcx);
                if r != 0 {
                    return r;
                }
            }
            return 0;
        }
        if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                let r = interior_part(type_elem(t, i), pcx);
                if r != 0 {
                    return r;
                }
            }
            return 0;
        }
        if kind == TyKind::Array || kind == TyKind::Distinct {
            return interior_part(TYPES[t].a, pcx);
        }
        if kind == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                for k in 0..pcx.variants[v].field_count {
                    let r = interior_part(variant_field(v, k, pcx), pcx);
                    if r != 0 {
                        return r;
                    }
                }
            }
        }
        0
    }
}

// Appends where type t holds its UnsafeCell, as a path from a value of t
// (`.value`, `.v`, `.0.value`, `[..].v`); nothing when t is one.
fn buf_interior_path(out: i64, t: i64, depth: i64, pcx: Ctx<Comp>) {
    // UNSAFE: STRUCTS, ENUMS and VARIANTS are the checker's raw tables.
    // SAFETY: as interior_of; only parts interior_part found are followed.
    unsafe {
        if t <= 0 || depth > 16 || is_unsafe_cell(t, pcx) {
            return;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct {
            let s = TYPES[t].a;
            for i in 0..pcx.structs[s].field_count {
                let f = struct_field(s, i, pcx);
                if interior_part((*f).ty, pcx) != 0 {
                    buf_str(out, c".");
                    buf_bytes(out, sym_text((*f).name));
                    buf_interior_path(out, (*f).ty, depth + 1, pcx);
                    return;
                }
            }
        } else if kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                if interior_part(type_elem(t, i), pcx) != 0 {
                    buf_str(out, c".");
                    buf_int(out, i);
                    buf_interior_path(out, type_elem(t, i), depth + 1, pcx);
                    return;
                }
            }
        } else if kind == TyKind::Array {
            buf_str(out, c"[..]");
            buf_interior_path(out, TYPES[t].a, depth + 1, pcx);
        } else if kind == TyKind::Distinct {
            buf_interior_path(out, TYPES[t].a, depth + 1, pcx);
        } else if kind == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].variant_count {
                let v = enum_variant(e, i);
                for k in 0..pcx.variants[v].field_count {
                    if interior_part(variant_field(v, k, pcx), pcx) != 0 {
                        buf_str(out, c" in ");
                        buf_bytes(out, sym_text(pcx.variants[v].name));
                        buf_str(out, c".");
                        buf_int(out, k);
                        buf_interior_path(out, variant_field(v, k, pcx), depth + 1, pcx);
                        return;
                    }
                }
            }
        }
    }
}

// Appends ` !Freeze (UnsafeCell<i64> at .value)` when type t is not
// Freeze, for `query own`'s kind column; nothing when it is.
pub fn buf_freeze_note(out: i64, t: i64, pcx: Ctx<Comp>) {
    let part = interior_part(t, pcx);
    if part == 0 {
        return;
    }
    buf_str(out, c" !Freeze (");
    buf_type(out, part, pcx);
    if part != t {
        buf_str(out, c" at ");
        buf_interior_path(out, t, 0, pcx);
    }
    buf_str(out, c")");
}

// ---- own.interior_copy ----

// The key of own.interior_copy's errors, once per position
// (base::diag::error_keyed).
const KEY_INTERIOR_COPY: i64 = 3100;

// Node n's source text.
fn text_of(n: i64, pcx: Ctx<Comp>) -> [u8] {
    SRC[pcx.nodes[n].start..pcx.nodes[n].end]
}

// The `edit patch FILE:LINE --old 'OLD' --new 'NEW'` arguments for an
// error at pos, into out; nothing in std or for text a shell word cannot
// hold.
fn buf_patch(out: i64, pos: i64, old: [u8], new: [u8], pcx: Ctx<Comp>) {
    // UNSAFE: FILES is the loader's raw table of source files.
    // SAFETY: f = file_of_pos(pos) is the file holding pos, below FILE_COUNT.
    unsafe {
        let f = file_of_pos(pos, pcx);
        let path = pcx.files[f].path;
        if path[0] == '<' || old.contains('\'') || new.contains('\'') || old.contains('\n')
            || new.contains('\n') {
            return;
        }
        var line = 1;
        for i in pcx.files[f].start..pos {
            if SRC[i] == '\n' {
                line += 1;
            }
        }
        buf_str(out, c"edit patch ");
        buf_str(out, if path[0] == '.' && path[1] == '/' { &path[2] } else { path });
        buf_bytes(out, ":");
        buf_int(out, line);
        buf_bytes(out, " --old '");
        buf_bytes(out, old);
        buf_bytes(out, "' --new '");
        buf_bytes(out, new);
        buf_bytes(out, "'");
    }
}

// own.interior_copy at expression e: a bit copy of an element its shared
// receiver keeps (std's copying getters, `v.get(i)`, `v.last()`; a
// borrowing iterator's items), of a type that is not Freeze. The copy is
// another cell, so a write through it would be lost. In the program's
// code only: std's own bodies use such copies to read.
pub fn interior_copy(e: i64, pcx: inout Ctx<Comp>) {
    // UNSAFE: FILES is the loader's raw table of source files.
    // SAFETY: file_of_pos(pos) is the file holding the node's start.
    unsafe {
        let t = pcx.nodes[e].ty;
        let pos = pcx.nodes[e].start;
        if pcx.files[file_of_pos(pos, pcx)].path[0] == '<' {
            return;
        }
        let msg = buf_new();
        buf_str(msg, c"a copy of a '");
        buf_type(msg, t, pcx);
        let part = interior_part(t, pcx);
        if part == t || is_std_cell(t, pcx) {
            buf_str(msg, c"' is another cell: a write through it is lost");
        } else {
            // (`Atomic<i64>`: its UnsafeCell<i64> at .v)
            buf_str(msg, c"' holds another cell (");
            buf_type(msg, part, pcx);
            buf_str(msg, c" at ");
            buf_interior_path(msg, t, 0, pcx);
            buf_str(msg, c"): a write through it is lost");
        }
        buf_byte(msg, 0);
        let fix = buf_new();
        let s = text_of(e, pcx);
        if s.len > 7
            && s[s.len as i64 - 1] == ')' {
            // (`v.get(i)`, written so: the element's place is `v[i]`)
            var k = 0;
            while k + 5 <= s.len as i64 && s[k..k + 5] != ".get(" {
                k += 1;
            }
            if k > 0 && k + 5 < s.len as i64 && !s[k + 5..s.len as i64 - 1].contains('(') {
                let new = buf_new();
                buf_bytes(new, s[0..k]);
                buf_byte(new, '[');
                buf_bytes(new, s[k + 5..s.len as i64 - 1]);
                buf_byte(new, ']');
                buf_patch(fix, pos, s, buf_slice(new), pcx);
            }
        }
        report_error_once(pos, KEY_INTERIOR_COPY, c"own.interior_copy", buf_slice(msg).ptr,
            c"reach the element where it is kept, a place: index it (`v[i].set(x)`), or loop over it (`for c in v.iter() { c.set(x); }`)",
            buf_slice(fix), &pcx);
    }
}

// own.interior_copy at call n of `map`, `for_each`, `filter_map` or
// `fold` on a borrowing iterator of type t whose items are not Freeze: its
// closure would be given copies, other cells.
pub fn interior_items(n: i64, t: i64, pcx: inout Ctx<Comp>) {
    // UNSAFE: FILES is the loader's raw table of source files.
    // SAFETY: file_of_pos(pos) is the file holding the node's start.
    unsafe {
        let pos = pcx.nodes[n].start;
        if pcx.files[file_of_pos(pos, pcx)].path[0] == '<' {
            return;
        }
        let msg = buf_new();
        buf_str(msg, c"the items of '");
        buf_type(msg, t, pcx);
        buf_str(msg, c"' are copies, other cells: a write through one is lost");
        buf_byte(msg, 0);
        report_error_once(pos, KEY_INTERIOR_COPY, c"own.interior_copy", buf_slice(msg).ptr,
            c"loop over the elements, places: `for c in v.iter() { c.set(x); }`", "", &pcx);
    }
}
