// (0.27.2.1) `impl Trait` in return position (docs/design/borrowck.md §21).
//
// `fn f(..) -> impl Tr₁ + .. + Trₘ` (a free function or an inherent method of
// a rust-edition file, the `impl` at the top of the result: the parser's
// parse_fn_result, a TyName with TY_OPAQUE, a = its text, h = the bounds)
// has an opaque result type O_f: a Distinct type (front/distinct.vl) whose
// b is f's result node, so one per function and instance, and whose a is
// the hidden type H_f once f's body is checked (0 until then).
//
// - D21.2: H_f is the type of f's body: every `return` and the tail one
//   type (else opaque.mismatch); H_f satisfies each bound (check_bounds).
//   A closure tail or `return` takes its parameter types from an `Fn*`
//   bound, as a closure argument does (D20.3).
// - D21.3: a caller sees O_f only: its methods are the bounds' (with their
//   supertraits', F2.2), it implements the bounds' traits and no other
//   (Send and Sync leak, AT4: decided on H_f), it converts to nothing; a
//   method or a call of it is H_f's (reveal_receiver, reveal_callee). The
//   code generators see H_f (erase_types, as for every distinct type).
// - A caller met before f's body is checked has it checked first, inside
//   its own check (check::check_nested); f met again while its own body is
//   checked is opaque.cycle (E0720).
// - Regions (the places IR, places/regions.vl sig_of): every slot of the
//   result is outlived by every input region of f's signature: Rust 2024's
//   capture rule, so a caller's argument loans stay live while the result
//   is (D21.3), and f's body may return what any input lends.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_end_soft, err_help, err_jump, err_str, err_sym};
use crate::front::ast::{
    FN_BODY_FAILED, FN_INTRINSIC, FN_SIG_FAILED, NodeKind, TY_OMEGA, TY_OPAQUE, child, list_begin,
    list_end, list_push, new_node,
};
use crate::front::traits::{bound_trait, trait_supers};
use crate::front::types::{ENUMS, TY_NEVER, TY_UNIT, TyKind, err_type, make_type, ref_to, type_elem};

pub fn is_opaque_node(n: i64, pcx: Ctx<Comp>) -> bool {
    n > 0 && pcx.nodes[n].kind == NodeKind::TyName && (pcx.nodes[n].p & TY_OPAQUE) != 0
}

// Whether t is an opaque result type.
pub fn is_opaque(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t].kind == TyKind::Distinct && is_opaque_node(pcx.types[t].b, pcx)
}

// RULE: D21.1 The opaque result type of function f (resolve_signature: its
// result node is TY_OPAQUE).
pub fn opaque_result(f: i64, pcx: inout Ctx<Comp>) -> i64 {
    let node = pcx.nodes[pcx.fns[f].node].b;
    pcx.any_distinct = true;
    let t = make_type(TyKind::Distinct, 0, node, pcx.tscratch.count, &pcx);
    pcx.opaque_fns.push(t);
    pcx.opaque_fns.push(f);
    t
}

// The function whose result opaque type t is, or -1.
pub fn opaque_fn(t: i64, pcx: Ctx<Comp>) -> i64 {
    var i = 0;
    while i + 1 < pcx.opaque_fns.count {
        if pcx.opaque_fns.get(i) == t {
            return pcx.opaque_fns.get(i + 1);
        }
        i += 2;
    }
    -1
}

// Whether function f's result is its own opaque type (not another's that
// a type argument names: `fn into_iter(self) -> I` with I an opaque type).
pub fn has_opaque_result(f: i64, pcx: Ctx<Comp>) -> bool {
    f >= 0 && is_opaque(pcx.fns[f].ret, pcx)
        && pcx.types[pcx.fns[f].ret].b == pcx.nodes[pcx.fns[f].node].b
}

fn active(f: i64, pcx: Ctx<Comp>) -> bool {
    for i in 0..pcx.opaque_active.count {
        if pcx.opaque_active.get(i) == f {
            return true;
        }
    }
    false
}

// RULE: D21.3, D21.4 The hidden type of opaque type t, which a use at pos
// needs: f's body checked first when it is not yet (check_nested); f's own
// body being checked is opaque.cycle.
pub fn hidden(t: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    if pcx.types[t].a != 0 {
        return pcx.types[t].a;
    }
    let f = opaque_fn(t, pcx);
    if f < 0 || active(f, pcx) {
        cycle_error(t, pos, &pcx);
    }
    crate::front::check::check_nested(pcx.fns[f].node, &pcx);
    if pcx.types[t].a == 0 {
        pcx.types[t].a = pcx.ty_error;
    }
    pcx.types[t].a
}

fn cycle_error(t: i64, pos: i64, pcx: inout Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"opaque.cycle";
    err_begin(pos, &pcx);
    err_str(c"cannot resolve opaque type '", pcx);
    err_type(t, pcx);
    err_str(c"': its hidden type is the function's own result", pcx);
    err_help(c"a recursive function with an `impl Trait` result needs a concrete type in the cycle: return a named type, or box the recursion", pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
    err_jump(&pcx)
}

// ---- The definition side (check/body.vl) ----

// Function f's body starts being checked: it is active (opaque.cycle).
pub fn body_begin(f: i64, pcx: inout Ctx<Comp>) {
    if has_opaque_result(f, pcx) {
        pcx.opaque_active.push(f);
    }
}

// Function f's check ended (also by an error): it is no longer active, its
// hidden type the error type when none was found.
pub fn body_end(f: i64, pcx: inout Ctx<Comp>) {
    if !has_opaque_result(f, pcx) {
        return;
    }
    var i = pcx.opaque_active.count - 1;
    while i >= 0 {
        if pcx.opaque_active.get(i) == f {
            pcx.opaque_active.count = i;
            break;
        }
        i -= 1;
    }
    let t = pcx.fns[f].ret;
    if pcx.types[t].a == 0 {
        pcx.types[t].a = pcx.ty_error;
    }
}

// The expected type of f's tail: its hidden type when a `return` found it,
// else none (0: the tail's own type is it).
pub fn tail_expected(f: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.types[pcx.fns[f].ret].a
}

// The `Fn*` bound of opaque result node n, or 0.
fn fn_bound(n: i64, pcx: Ctx<Comp>) -> i64 {
    let bounds = pcx.nodes[n].h;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let b = child(bounds, i, pcx);
        if pcx.nodes[b].kind == NodeKind::TyFn {
            return b;
        }
    }
    0
}

// RULE: D21.4, D20.3 A closure that is value e of the result of a function
// with opaque type t takes its parameters' types from t's `Fn*` bound:
// checked here, before e is (which then finds its type).
pub fn closure_value(e: i64, t: i64, pcx: inout Ctx<Comp>) {
    var v = e;
    while v > 0 && pcx.nodes[v].kind == NodeKind::Block && pcx.nodes[v].count == 0 {
        v = pcx.nodes[v].a;
    }
    if v <= 0 || pcx.nodes[v].kind != NodeKind::Closure || pcx.nodes[v].x != 0 {
        return;
    }
    let fnb = fn_bound(pcx.types[t].b, pcx);
    if fnb == 0 || pcx.nodes[fnb].count != pcx.nodes[v].count {
        return;
    }
    let mark = pcx.tscratch.count;
    for i in 0..pcx.nodes[v].count {
        let pt = resolve_quietly(child(fnb, i, pcx), &pcx);
        pcx.tscratch.push(pt);
    }
    let ret = if pcx.nodes[fnb].a != 0 { resolve_quietly(pcx.nodes[fnb].a, &pcx) } else { 0 };
    pcx.closure_bound = fnb;
    pcx.closure_bound_name = pcx.nodes[pcx.types[t].b].a;
    let _ = crate::front::closures::check_closure_sig(v, mark, ret, &pcx);
    pcx.closure_bound = 0;
}

fn resolve_quietly(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let mark = crate::base::diag::errors_mark(pcx);
    if crate::front::check::attempt(crate::front::check::Try::Type, n, &pcx) {
        return pcx.try_result;
    }
    crate::base::diag::errors_forget(mark, &pcx);
    0
}

// RULE: D21.2 Value e of type `got` leaves function f, whose result is
// opaque type t: the first one found is the hidden type; any other must be
// it (opaque.mismatch, rustc E0308).
pub fn result_value(e: i64, got: i64, t: i64, pcx: inout Ctx<Comp>) {
    if got == TY_NEVER || got == pcx.ty_error || got == 0 {
        return;
    }
    let h = pcx.types[t].a;
    if h == 0 {
        if mentions(got, t, 0, pcx) {
            cycle_error(t, pcx.nodes[e].start, &pcx);
        }
        pcx.types[t].a = got;
        return;
    }
    if h == got || h == pcx.ty_error {
        return;
    }
    let saved = pcx.err_kind;
    pcx.err_kind = c"opaque.mismatch";
    err_begin(pcx.nodes[e].start, &pcx);
    err_str(c"mismatched types: expected '", pcx);
    err_type(h, pcx);
    err_str(c"', found '", pcx);
    err_type(got, pcx);
    err_str(c"'", pcx);
    err_help(c"the function's `impl Trait` result is one type, the first value's: every `return` and the tail must have it (box them as `Box<dyn Trait>` in 0.29, or return an enum)", pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
    err_jump(&pcx)
}

// Whether type t is or holds opaque type o (o < 0: any Ω) (to a small
// depth).
fn mentions(t: i64, o: i64, depth: i64, pcx: Ctx<Comp>) -> bool {
    if t == o || o < 0 && t > 0 && is_omega(t, pcx) {
        return true;
    }
    if t <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice {
        return mentions(pcx.types[t].a, o, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t].count {
            if mentions(type_elem(t, i, pcx), o, depth + 1, pcx) {
                return true;
            }
        }
    }
    // (an instance's type arguments: `Option<O_f>`)
    if k == TyKind::Struct || k == TyKind::Enum {
        let (at, n) = if k == TyKind::Struct {
            (pcx.structs[pcx.types[t].a].targs, pcx.structs[pcx.types[t].a].targ_count)
        } else {
            // UNSAFE: ENUMS is the checker's static table of enums (front/types.vl).
            // SAFETY: t is an Enum type, so its a indexes ENUMS; read only.
            unsafe { (ENUMS[pcx.types[t].a].targs, ENUMS[pcx.types[t].a].targ_count) }
        };
        for i in 0..n {
            if mentions(pcx.tlists.get(at + i), o, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// RULE: D21.2 (H_f satisfies each bound) Function f's check ended with its
// hidden type: its bounds are checked against it, at the result's position.
pub fn check_hidden_bounds(f: i64, pcx: inout Ctx<Comp>) {
    let t = pcx.fns[f].ret;
    let h = pcx.types[t].a;
    if h == 0 || h == pcx.ty_error {
        return;
    }
    let node = pcx.types[t].b;
    let g = new_node(NodeKind::Generics, pcx.nodes[node].start, pcx.nodes[node].end, &pcx);
    let mark = list_begin(pcx);
    list_push(node, &pcx);
    list_end(g, mark, &pcx);
    let targs = pcx.tlists.count;
    pcx.tlists.push(h);
    let saved = pcx.nodes[node].p;
    pcx.nodes[node].p |= crate::front::ast::NODE_IMPLICIT;
    crate::front::traits::check_bounds(g, targs, 1, pcx.nodes[pcx.fns[f].node].a,
        pcx.nodes[node].start, &pcx);
    pcx.nodes[node].p = saved;
}

// ---- The caller side ----

// Whether trait b is tr or has it among its supertraits (F2.2).
fn entails(b: i64, tr: i64, depth: i64, pcx: inout Ctx<Comp>) -> bool {
    if b < 0 {
        return false;
    }
    if b == tr {
        return true;
    }
    let supers = trait_supers(b, pcx);
    if supers == 0 || depth > 8 {
        return false;
    }
    for i in 0..pcx.nodes[supers].count {
        if entails(bound_trait(child(supers, i, pcx), &pcx), tr, depth + 1, &pcx) {
            return true;
        }
    }
    false
}

// RULE: D21.3 Whether opaque type t implements trait tr: one of its bounds
// entails it.
pub fn implements(tr: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    let bounds = pcx.nodes[pcx.types[t].b].h;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        if entails(bound_trait(child(bounds, i, pcx), &pcx), tr, 0, &pcx) {
            return true;
        }
    }
    false
}

// RULE: D22.1 (0.27.3, FL11) Whether opaque type t implements generic trait
// tr with arguments targs (a TLISTS index): a bound of t names tr with
// those arguments (`S: AsRef<str>`, resolved in the template's scope; one
// it cannot resolve, or with fewer written, holds), or a bound's trait
// has tr among its supertraits.
pub fn implements_with(tr: i64, t: i64, targs: i64, pcx: inout Ctx<Comp>) -> bool {
    let bounds = pcx.nodes[pcx.types[t].b].h;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let b = child(bounds, i, pcx);
        let bt = bound_trait(b, &pcx);
        if bt != tr {
            if bt >= 0 && entails(bt, tr, 0, &pcx) {
                return true;
            }
            continue;
        }
        let g = pcx.nodes[b].g;
        var same = true;
        for k in 0..(if g > 0 { pcx.nodes[g].count } else { 0 }) {
            let saved = pcx.cur_mod;
            pcx.cur_mod = crate::front::modules::module_of(b, &pcx);
            let a = resolve_quietly(child(g, k, pcx), &pcx);
            pcx.cur_mod = saved;
            if a > 0 && a != pcx.ty_error && a != pcx.tlists.get(targs + k) {
                same = false;
            }
        }
        if same {
            return true;
        }
    }
    false
}

// Whether a bound of opaque type t declares method `name` (F2.2).
fn bound_method(t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    let bounds = pcx.nodes[pcx.types[t].b].h;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let tr = bound_trait(child(bounds, i, pcx), &pcx);
        if tr >= 0 && crate::front::traits::trait_declares_closure(tr, name, &pcx) {
            return true;
        }
    }
    false
}

// The opaque type receiver type rt is or points to, or 0.
fn opaque_in(rt: i64, pcx: Ctx<Comp>) -> i64 {
    if is_opaque(rt, pcx) {
        return rt;
    }
    if rt > 0 && pcx.types[rt].kind == TyKind::Ptr && pcx.types[rt].b != 0
        && is_opaque(pcx.types[rt].a, pcx) {
        return pcx.types[rt].a;
    }
    0
}

// rt with opaque type o (rt itself or what it points to) made h.
fn revealed(rt: i64, o: i64, h: i64, pcx: inout Ctx<Comp>) -> i64 {
    if rt == o { h } else { ref_to(h, pcx.types[rt].b, &pcx) }
}

// RULE: D21.3 Method call n, its receiver of type rt: of an opaque type (or
// a reference to one), the method must be a bound's (else `no method`, as
// rustc's E0599), and is the hidden type's: the receiver's type is it.
pub fn reveal_receiver(n: i64, receiver: i64, rt: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    let o = opaque_in(rt, pcx);
    if o == 0 {
        return rt;
    }
    // RULE: D22.1a, D22.3 (an Ω: a bound's method is its virtual function,
    // found as its method; else a blanket impl's; else none:
    // generic.unbounded_use, rustc E0599)
    if is_omega(o, pcx) {
        if virtual_fn(o, name, &pcx) >= 0
            || crate::front::check::calls::pattern_method_of(o, name, &pcx) >= 0 {
            return rt;
        }
        unbounded_method_error(n, o, name, &pcx);
    }
    if !bound_method(o, name, &pcx) {
        // (a blanket impl's method that the bounds entail, `impl<I:
        // Iterator> IntoIterator for I`: of the opaque type itself)
        if crate::front::check::calls::pattern_method_of(o, name, &pcx) >= 0 {
            return rt;
        }
        err_begin(pcx.nodes[n].start, &pcx);
        err_str(c"no method '", pcx);
        err_sym(name, pcx);
        err_str(c"' on type '", pcx);
        err_type(o, pcx);
        err_str(c"'", pcx);
        err_help(c"an `impl Trait` result has its bounds' methods only: add the trait that has it to the function's result, `-> impl Tr + Other`", pcx);
        err_end(&pcx);
    }
    let h = hidden(o, pcx.nodes[n].start, &pcx);
    let r = revealed(rt, o, h, &pcx);
    pcx.nodes[receiver].ty = r;
    r
}

// RULE: D21.3 A call of a value of type ct: of an opaque type with an `Fn*`
// bound (or a reference to one), the hidden closure's.
pub fn reveal_callee(callee: i64, ct: i64, pcx: inout Ctx<Comp>) -> i64 {
    let o = opaque_in(ct, pcx);
    if o == 0 || fn_bound(pcx.types[o].b, pcx) == 0 {
        return ct;
    }
    // RULE: D22.1a (an Ω's `Fn*` bound: a call of its signature)
    if is_omega(o, pcx) {
        let sig = fn_bound_sig(o, &pcx);
        if sig != 0 {
            // (through a reference: `pred(x)` with `pred: &mut F`, a
            // reference to the fn pointer, which fn_through_ref calls)
            let r = revealed(ct, o, sig, &pcx);
            pcx.nodes[callee].ty = r;
            return r;
        }
        return ct;
    }
    let h = hidden(o, pcx.nodes[callee].start, &pcx);
    let r = revealed(ct, o, h, &pcx);
    pcx.nodes[callee].ty = r;
    r
}

// RULE: D21.3 A `Fn*` bound on a value of type t: an opaque type with an
// `Fn*` bound of its own is checked as its hidden closure.
pub fn fn_bound_type(t: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    if is_omega(t, pcx) {
        let sig = fn_bound_sig(t, &pcx);
        return if sig != 0 { sig } else { t };
    }
    if is_opaque(t, pcx) && fn_bound(pcx.types[t].b, pcx) != 0 {
        return hidden(t, pos, &pcx);
    }
    t
}

// The fn type of Ω t's `Fn*` bound (its types in the scope it is used
// in), or 0.
fn fn_bound_sig(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let fnb = fn_bound(pcx.types[t].b, pcx);
    if fnb == 0 {
        return 0;
    }
    let mark = pcx.tscratch.count;
    for i in 0..pcx.nodes[fnb].count {
        let pt = resolve_quietly(child(fnb, i, pcx), &pcx);
        if pt == 0 {
            pcx.tscratch.count = mark;
            return 0;
        }
        pcx.tscratch.push(pt);
    }
    let ret = if pcx.nodes[fnb].a != 0 { resolve_quietly(pcx.nodes[fnb].a, &pcx) } else { TY_UNIT };
    if ret == 0 {
        pcx.tscratch.count = mark;
        return 0;
    }
    make_type(TyKind::Fn, ret, 0, mark, &pcx)
}

// RULE: D22.3 Method `name` on Ω type o that no bound gives: rustc's
// E0599, with the bound to add when one trait in scope declares it.
fn unbounded_method_error(n: i64, o: i64, name: i64, pcx: inout Ctx<Comp>) -> ! {
    let saved = pcx.err_kind;
    pcx.err_kind = c"generic.unbounded_use";
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"no method '", pcx);
    err_sym(name, pcx);
    err_str(c"' on type parameter '", pcx);
    err_type(o, pcx);
    err_str(c"': its bounds do not give it (rustc E0599)", pcx);
    for tr in 0..pcx.traits.len() as i64 {
        if crate::front::traits::trait_declares(tr, name, pcx) {
            err_help(c"add the bound: '", pcx);
            crate::base::diag::err_help_sym(pcx.nodes[pcx.types[o].b].a, pcx);
            err_help(c": ", pcx);
            crate::base::diag::err_help_sym(pcx.traits[tr].name, pcx);
            err_help(c"'", pcx);
            break;
        }
    }
    pcx.opaque_sure = sure_unbounded(o, pcx);
    err_end_soft(&pcx);
    pcx.opaque_sure = false;
    pcx.err_kind = saved;
    err_jump(&pcx)
}

// RULE: D22.3 Whether the bound-only error on Ω o is sure (reported): o
// is a parameter's own Ω, not `T::Item`'s, and the template has no `where`
// predicate (one on a projection may give it: 0.27.3).
fn sure_unbounded(o: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.cur_inst < 0 || pcx.fns[pcx.cur_inst].tmpl == 0 {
        return false;
    }
    let item = pcx.fns[pcx.fns[pcx.cur_inst].tmpl - 1].node;
    if crate::front::traits::wp_start(item, pcx) >= 0 {
        return false;
    }
    let g = pcx.nodes[item].g;
    for k in 0..(if g > 0 { pcx.nodes[g].count } else { 0 }) {
        if pcx.nodes[child(g, k, pcx)].a == pcx.nodes[pcx.types[o].b].a {
            return true;
        }
    }
    false
}

// ---- The opaque instance (§22) ----

// RULE: D22.1 Whether t is an opaque type parameter, an Ωᵢ.
pub fn is_omega(t: i64, pcx: Ctx<Comp>) -> bool {
    is_opaque(t, pcx) && (pcx.nodes[pcx.types[t].b].p & TY_OMEGA) != 0
}

// RULE: D22.2 Whether function f is an instance with a type argument that
// is or holds an Ω: an opaque instance, or one its check made; neither is
// lowered (finish_program), nor are their closures.
pub fn omega_instance(f: i64, pcx: Ctx<Comp>) -> bool {
    if f < 0 || pcx.fns[f].tmpl == 0 {
        return false;
    }
    // (or a virtual function's, its Self an Ω: `T::hash<DefaultHasher>`;
    // by its node, as the types are erased before code)
    let h = pcx.nodes[pcx.fns[f].node].h;
    if h > 0 && pcx.nodes[h].kind == NodeKind::TyName && (pcx.nodes[h].p & TY_OMEGA) != 0 {
        return true;
    }
    for i in 0..pcx.fns[f].targ_count {
        if mentions(pcx.tlists.get(pcx.fns[f].targs + i), -1, 0, pcx) {
            return true;
        }
    }
    false
}

// RULE: D22.1 The Ω standing for type parameter `param` (a TyName of a
// Generics node, its bounds in h): a distinct type over `()` whose node, a
// copy of the parameter's, names it in messages and resolves to it
// (resolve_type: z).
pub fn omega_of(param: i64, pcx: inout Ctx<Comp>) -> i64 {
    let node = new_node(NodeKind::TyName, pcx.nodes[param].start, pcx.nodes[param].end, &pcx);
    pcx.nodes[node].a = pcx.nodes[param].a;
    pcx.nodes[node].h = pcx.nodes[param].h;
    pcx.nodes[node].p |= TY_OPAQUE | TY_OMEGA;
    pcx.any_distinct = true;
    let t = make_type(TyKind::Distinct, TY_UNIT, node, pcx.tscratch.count, &pcx);
    pcx.nodes[node].z = t;
    t
}

// The trait of opaque type t's bounds (with their supertraits, F2.2) that
// declares function `name`, and the bound naming it: (trait, bound), or
// (-1, 0).
fn bound_declaring(t: i64, name: i64, pcx: inout Ctx<Comp>) -> (i64, i64) {
    let bounds = pcx.nodes[pcx.types[t].b].h;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let b = child(bounds, i, pcx);
        let tr = declaring(bound_trait(b, &pcx), name, 0, &pcx);
        if tr >= 0 {
            return (tr, b);
        }
    }
    (-1, 0)
}

fn declaring(tr: i64, name: i64, depth: i64, pcx: inout Ctx<Comp>) -> i64 {
    if tr < 0 || depth > 8 {
        return -1;
    }
    if crate::front::traits::trait_fn(tr, name, pcx) != 0 {
        return tr;
    }
    let supers = trait_supers(tr, pcx);
    for i in 0..(if supers > 0 { pcx.nodes[supers].count } else { 0 }) {
        let s = declaring(bound_trait(child(supers, i, pcx), &pcx), name, depth + 1, &pcx);
        if s >= 0 {
            return s;
        }
    }
    -1
}

// RULE: D22.1a The virtual function `Tr::name⟨Self := Ω⟩` of Ω type t, made
// once (a method of t, find_method): the trait's declaration of it without
// a body, its signature resolved with Self = t; -1 when no bound of t
// declares it.
pub fn virtual_fn(t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    let (tr, b) = bound_declaring(t, name, &pcx);
    // (0.27.3, FL11: a generic method of a generic trait, `contains<U>` of
    // RangeBounds<T>, is instantiated without the trait's arguments: a gap
    // of the model, its instance unsure)
    if tr >= 0 {
        let tg = pcx.nodes[pcx.traits[tr].node].g;
        let decl = crate::front::traits::trait_fn(tr, name, pcx);
        if tg > 0 && pcx.nodes[tg].count > 0 && decl != 0 && pcx.nodes[decl].g != 0
            && pcx.nodes[pcx.nodes[decl].g].count > 0 {
            pcx.opaque_unsure = true;
        }
    }
    let had = crate::front::types::find_method(t, name, pcx);
    if had >= 0 {
        return had;
    }
    if tr < 0 {
        return -1;
    }
    let targs = trait_args_of(tr, b, t, &pcx);
    let decl = crate::front::traits::trait_fn(tr, name, pcx);
    let item = crate::front::generics::instantiate::clone_node(decl, &pcx);
    pcx.nodes[item].c = 0;
    pcx.nodes[item].p |= FN_INTRINSIC;
    pcx.nodes[item].h = pcx.types[t].b;
    // (its lifetimes are the declaration's, for the borrow checker)
    crate::front::parser::rust::share_lifetimes(decl, item, &pcx);
    let sym = crate::front::modules::join_sym(pcx.nodes[pcx.types[t].b].a, c"::", name, &pcx);
    crate::front::check::collect::add_fn(item, sym, sym, &pcx);
    let f = pcx.fns.len() as i64 - 1;
    pcx.fns[f].module = pcx.traits[tr].module;
    pcx.fns[f].self_ty = t;
    if pcx.fns[f].generic == 0 {
        let (saved_mod, saved_self, saved_impl) = (pcx.cur_mod, pcx.self_type, pcx.self_impl);
        pcx.cur_mod = pcx.traits[tr].module;
        pcx.self_type = t;
        pcx.self_impl = -1;
        let tg = pcx.nodes[pcx.traits[tr].node].g;
        let count = if tg > 0 { pcx.nodes[tg].count } else { 0 };
        let env = crate::front::generics::env_enter(tg, targs, count, &pcx);
        crate::front::check::resolve::resolve_signature(f, &pcx);
        crate::front::generics::env_leave(env, &pcx);
        pcx.cur_mod = saved_mod;
        pcx.self_type = saved_self;
        pcx.self_impl = saved_impl;
    }
    crate::front::check::collect::meth_push(crate::front::types::MethodInfo {
        ty: t, name: name, f: f,
    }, &pcx);
    f
}

// RULE: D22.1 (0.27.3, FL11) Path n is `Ω::NAME` (t an Ω), NAME an
// associated constant a bound's trait declares (`A::FREES` with `A:
// Allocator`): its type, from the declaration with Self = t; n a literal
// of it (the opaque instance is never lowered: only its type counts), or
// of the error type when the constant is no integer or bool (what uses it
// is not checked). -1 when no bound declares NAME.
pub fn omega_const(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    let bounds = pcx.nodes[pcx.types[t].b].h;
    var decl = 0;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let bt = bound_trait(child(bounds, i, pcx), &pcx);
        let d = assoc_decl(bt, name, 0, &pcx);
        if d != 0 && (pcx.nodes[d].p & crate::front::ast::NODE_ASSOC_CONST) != 0 {
            decl = d;
            break;
        }
    }
    if decl == 0 {
        return -1;
    }
    let (saved_mod, saved_self) = (pcx.cur_mod, pcx.self_type);
    pcx.cur_mod = crate::front::modules::module_of(decl, &pcx);
    pcx.self_type = t;
    let ty = resolve_quietly(pcx.nodes[decl].b, &pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    let (start, end) = (pcx.nodes[n].start, pcx.nodes[n].end);
    pcx.nodes[n] = pcx.nodes[0];
    pcx.nodes[n].start = start;
    pcx.nodes[n].end = end;
    if ty == crate::front::types::TY_BOOL {
        pcx.nodes[n].kind = NodeKind::Bool;
    } else {
        pcx.nodes[n].kind = NodeKind::Int;
    }
    let r = if ty > 0 && (ty == crate::front::types::TY_BOOL || crate::front::types::is_integer(ty))
        { ty } else { pcx.ty_error };
    pcx.nodes[n].ty = r;
    pcx.nodes[n].p |= crate::front::ast::NODE_CHECKED;
    r
}

// RULE: D22.1a (0.27.3, FL11) The arguments of trait tr in the virtual
// signature of a method bound b of Ω t declares: b's own when b names tr
// (`T: Add<U>`: U's Ω, resolved in the template's scope), else each
// parameter's default with Self = t (`Rhs = Self`), else the error type,
// which reports nothing; a TLISTS index.
fn trait_args_of(tr: i64, b: i64, t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let tg = pcx.nodes[pcx.traits[tr].node].g;
    let count = if tg > 0 { pcx.nodes[tg].count } else { 0 };
    let written = if b > 0 && bound_trait(b, &pcx) == tr { pcx.nodes[b].g } else { 0 };
    let mark = pcx.tscratch.count;
    for k in 0..count {
        var a = 0;
        if written > 0 && k < pcx.nodes[written].count {
            a = resolve_quietly(child(written, k, pcx), &pcx);
        }
        let default = pcx.nodes[child(tg, k, pcx)].b;
        if a == 0 && default != 0 {
            let (saved_mod, saved_self) = (pcx.cur_mod, pcx.self_type);
            pcx.cur_mod = pcx.traits[tr].module;
            pcx.self_type = t;
            a = resolve_quietly(default, &pcx);
            pcx.cur_mod = saved_mod;
            pcx.self_type = saved_self;
        }
        pcx.tscratch.push(if a == 0 { pcx.ty_error } else { a });
    }
    crate::front::generics::take_targs(mark, &pcx)
}

// RULE: D22.1 `Ω::name` (`<Ω as Tr>::name`): the bound's equality when one
// of t's bounds has it (`Iterator<Item = X>`), else 0 (no such type).
pub fn omega_projection(t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    // (each once, under the instance's parameters: places asks again,
    // without them)
    var k = 0;
    while k + 2 < pcx.assoc_omegas.count {
        if pcx.assoc_omegas.get(k) == t && pcx.assoc_omegas.get(k + 1) == name {
            return pcx.assoc_omegas.get(k + 2);
        }
        k += 3;
    }
    let bounds = pcx.nodes[pcx.types[t].b].h;
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let b = child(bounds, i, pcx);
        let holder = pcx.nodes[b].h;
        if pcx.nodes[b].kind != NodeKind::TyName || holder <= 0 {
            continue;
        }
        for j in 0..pcx.nodes[holder].count {
            let c = child(holder, j, pcx);
            if pcx.nodes[c].kind == NodeKind::AssocType && pcx.nodes[c].a == name {
                // (0 while it is made: `Iterator<Item = Self::Item>` asks
                // again; `Self` there is the Ω whose associated type t is)
                let slot = pcx.assoc_omegas.count;
                pcx.assoc_omegas.push(t);
                pcx.assoc_omegas.push(name);
                pcx.assoc_omegas.push(0);
                let saved = pcx.cur_mod;
                let saved_self = pcx.self_type;
                pcx.cur_mod = crate::front::modules::module_of(c, &pcx);
                let owner = assoc_owner(t, pcx);
                if owner != 0 {
                    pcx.self_type = owner;
                }
                let r = crate::front::check::resolve_type_or_error(pcx.nodes[c].b, &pcx);
                pcx.cur_mod = saved;
                pcx.self_type = saved_self;
                pcx.assoc_omegas.set(slot + 2, r);
                return r;
            }
        }
    }
    // (none: a fresh Ω for `Ω::name`, with the declaration's bounds, F11.2)
    for i in 0..(if bounds > 0 { pcx.nodes[bounds].count } else { 0 }) {
        let decl = assoc_decl(bound_trait(child(bounds, i, pcx), &pcx), name, 0, &pcx);
        if decl != 0 {
            return assoc_omega(t, name, decl, &pcx);
        }
    }
    0
}

// The Ω whose associated type Ω t is (`T` of `T::Item`), or 0.
fn assoc_owner(t: i64, pcx: Ctx<Comp>) -> i64 {
    // (assoc_omega keeps it in the node's x)
    let node = pcx.types[t].b;
    if pcx.nodes[node].x > 0 { pcx.nodes[node].x - 1 } else { 0 }
}

// The AssocType node trait tr (or a supertrait) declares `name` with, or 0.
fn assoc_decl(tr: i64, name: i64, depth: i64, pcx: inout Ctx<Comp>) -> i64 {
    if tr < 0 || depth > 8 {
        return 0;
    }
    let h = pcx.nodes[pcx.traits[tr].node].b;
    for i in 0..(if h > 0 { pcx.nodes[h].count } else { 0 }) {
        let c = child(h, i, pcx);
        if pcx.nodes[c].kind == NodeKind::AssocType && pcx.nodes[c].a == name {
            return c;
        }
    }
    let supers = trait_supers(tr, pcx);
    for i in 0..(if supers > 0 { pcx.nodes[supers].count } else { 0 }) {
        let d = assoc_decl(bound_trait(child(supers, i, pcx), &pcx), name, depth + 1, &pcx);
        if d != 0 {
            return d;
        }
    }
    0
}

// RULE: D22.1 The Ω of `t::name` (t an Ω), made once: named `T::Item`,
// bounded by the declaration's bounds (its h, when a Generics holder).
fn assoc_omega(t: i64, name: i64, decl: i64, pcx: inout Ctx<Comp>) -> i64 {
    var i = 0;
    while i + 2 < pcx.assoc_omegas.count {
        if pcx.assoc_omegas.get(i) == t && pcx.assoc_omegas.get(i + 1) == name {
            return pcx.assoc_omegas.get(i + 2);
        }
        i += 3;
    }
    let node = new_node(NodeKind::TyName, pcx.nodes[decl].start, pcx.nodes[decl].end, &pcx);
    pcx.nodes[node].a = crate::front::modules::join_sym(pcx.nodes[pcx.types[t].b].a, c"::",
        name, &pcx);
    let h = pcx.nodes[decl].h;
    pcx.nodes[node].h = if h > 0 && pcx.nodes[h].kind == NodeKind::Generics { h } else { 0 };
    pcx.nodes[node].p |= TY_OPAQUE | TY_OMEGA;
    pcx.any_distinct = true;
    let r = make_type(TyKind::Distinct, TY_UNIT, node, pcx.tscratch.count, &pcx);
    pcx.nodes[node].z = r;
    pcx.nodes[node].x = t + 1;
    pcx.assoc_omegas.push(t);
    pcx.assoc_omegas.push(name);
    pcx.assoc_omegas.push(r);
    r
}

// RULE: D22.2 The opaque instances, after the concrete ones: one per
// generic template with a body of the program's own rust-edition files,
// type-checked (and so borrow-checked), never lowered: finish_program
// leaves out every instance and closure made from here on to the end of
// their checks.
pub fn build_opaque_instances(program: i64, pcx: inout Ctx<Comp>) {
    // (a rust program on std2 only: MVS's std, VOLE_STD2=0, has no traits
    // for a bound to name, `for` over an Ω)
    if !crate::front::known::on_std2(pcx) {
        return;
    }
    pcx.opaque_q0 = pcx.inst_queue.count;
    pcx.opaque_phase = true;
    var made_fns = Vec::<i64, Comp>::new_in(Comp {});
    var unsure_fns = Vec::<i64, Comp>::new_in(Comp {});
    for i in 0..pcx.nodes[program].count {
        let item = child(program, i, pcx);
        if pcx.nodes[item].kind != NodeKind::Fn || pcx.nodes[item].x == 0
            || (pcx.nodes[item].p & (FN_SIG_FAILED | FN_BODY_FAILED | FN_INTRINSIC
                | crate::front::ast::FN_DERIVED)) != 0
            || pcx.nodes[item].c == 0 {
            continue;
        }
        let f = pcx.nodes[item].x - 1;
        let g = pcx.nodes[item].g;
        if pcx.fns[f].generic == 0 || pcx.fns[f].tmpl != 0 || g == 0
            || !crate::front::conv::user_at(pcx.nodes[item].start, &pcx)
            || !crate::front::rust::rust_at(pcx.nodes[item].start, &pcx) {
            continue;
        }
        var plain = true;
        for k in 0..pcx.nodes[g].count {
            let p = child(g, k, pcx);
            // (0.27.3: not an `#[array_builtin(N)]` length parameter, a
            // value inside, which parse_generic_params makes zero-wide at
            // the attribute, length_param: F15.3)
            plain = plain && pcx.nodes[p].kind == NodeKind::TyName
                && crate::front::generics::instantiate::array_len_name(p, pcx) == 0
                && pcx.nodes[p].end > pcx.nodes[p].start;
        }
        if !plain {
            continue;
        }
        pcx.opaque_unsure = false;
        let made = crate::front::check::opaque_instance(f, item, &pcx);
        if made >= 0 {
            made_fns.push(made);
            // (a `where` predicate, one on a projection, may give an Ω what
            // the model does not: `X::Item: Show`)
            unsure_fns.push(if pcx.opaque_unsure || crate::front::traits::wp_start(item, pcx) >= 0 {
                1
            } else {
                0
            });
        }
    }
    // RULE: D22.2 (0.27.3, FL11) Each queued instance checked, as
    // check_queued_instances does; the errors of one that meets a gap of the
    // model (opaque_unsure: made so, or met while checked) are forgotten,
    // and so are those of the instances it makes.
    var unsure_at = Vec::<i64, Comp>::new_in(Comp {});
    var q = pcx.opaque_q0;
    while q < pcx.inst_queue.count {
        let inst = pcx.inst_queue.get(q);
        var unsure = q - pcx.opaque_q0 < unsure_at.len() as i64
            && unsure_at[(q - pcx.opaque_q0) as usize] != 0;
        for k in 0..made_fns.len() {
            if made_fns[k] == inst && unsure_fns[k] != 0 {
                unsure = true;
            }
        }
        pcx.opaque_unsure = unsure;
        let mark = crate::base::diag::errors_mark(pcx);
        let (s_mark, k_mark) = (pcx.suggested.count, pcx.suggested_kind.count);
        crate::front::check::check_function_recovering(pcx.fns[inst].node, &pcx);
        if pcx.opaque_unsure {
            crate::base::diag::errors_forget(mark, &pcx);
            pcx.suggested.count = s_mark;
            pcx.suggested_kind.count = k_mark;
        }
        let flag = if pcx.opaque_unsure { 1 } else { 0 };
        while (unsure_at.len() as i64) < pcx.inst_queue.count - pcx.opaque_q0 {
            unsure_at.push(if (unsure_at.len() as i64) > q - pcx.opaque_q0 { flag } else { 0 });
        }
        q += 1;
    }
    pcx.opaque_unsure = false;
    // (the templates whose instance checked: not one the model left out)
    for made in made_fns.as_slice() {
        if (pcx.nodes[pcx.fns[made].node].p & FN_BODY_FAILED) == 0 {
            pcx.opaque_count += 1;
        }
    }
    pcx.opaque_phase = false;
}
