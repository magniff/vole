// The guard walk (docs/design/arch.md §2.4): what each point of a checked
// body knows, and the calls and function values found there.
//
// The known set at a point is the build's features, the function's
// declared ones (#[target_feature]), and the atoms of every guard the
// point is under. A guard is a has("f")/detect("f") call, or several
// joined by `&&`; it is known
//   - in the `then` branch of `if G`,
//   - in the `else` branch of `if !G`,
//   - in the rest of a block after `if !G { DIVERGES }`,
//   - in the rest of a block after `assert(G)`.
// `||`, other negations and a bool kept in a local give nothing.
//
// The walk records each direct call (CALLS) and each function taken as a
// value (VALUES) with the set known there; infer.vl makes the
// requirements of them, check.vl the errors. It also records the set
// known at each has()/detect() call, which folds them (known_at).

use crate::arch::{ARCH_AARCH64, ARCH_X86_64, target_arch};
use crate::arch::features::{bit, feature_ambiguous, feature_bit_in, implied};
use crate::base::sym_text;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::check::Res;
use crate::front::features::feature_call_bit;
use crate::front::features::ctx::FeaturesCx;
use crate::front::lexer::{Tok, str_at};
use crate::front::modules::within_std;
use crate::front::types::TY_NEVER;

pub const CALL_WIDTH: i64 = 6;
pub const C_FN: i64 = 0;
pub const C_CALLEE: i64 = 1;
pub const C_KNOWN: i64 = 2;
pub const C_ALT: i64 = 3;
pub const C_NODE: i64 = 4;
pub const C_ALT_AT: i64 = 5;

pub const VALUE_WIDTH: i64 = 5;

const KNOWN_MARK: i64 = 1 << 48;

// The set known at has()/detect() call n, or -1 when the walk did not reach
// it.
pub fn walked_known(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = pcx.known_at.get(n + 1);
    if v == 0 { -1 } else { v & ~KNOWN_MARK }
}

pub fn regions_reset(fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    pcx.regions_calls.count = 0;
    fcx.values.count = 0;
    pcx.known_at.clear();
}

// Walks the body of function f, knowing `known` at its start (the build's
// and the declared features), with the ambiguous readings of its
// declaration (`alt`, at `alt_at`).
pub fn walk_function(f: i64, known: i64, alt: i64, alt_at: i64, fcx: &mut FeaturesCx,
    pcx: &mut Ctx<Comp>) {
    fcx.cur = f;
    fcx.known = known;
    fcx.alt = alt;
    fcx.alt_at = alt_at;
    walk(pcx.nodes[pcx.fns[f as usize].node as usize].c, fcx, pcx);
}

// ---- Guards ----

// The features guard g gives where it holds (0: none): its has()/detect()
// atoms, through `&&`. Notes its ambiguous names.
fn atoms(g: i64, fcx: &mut FeaturesCx, pcx: &Ctx<Comp>) -> i64 {
    if g == 0 {
        return 0;
    }
    let kind = pcx.nodes[g as usize].kind;
    if kind == NodeKind::Call {
        let b = feature_call_bit(g, pcx);
        if b < 0 {
            return 0;
        }
        note_ambiguous(g, fcx, pcx);
        return implied(bit(b));
    }
    if kind == NodeKind::Binary && pcx.nodes[g as usize].op == Tok::AmpAmp {
        return atoms(pcx.nodes[g as usize].b, fcx, pcx) | atoms(pcx.nodes[g as usize].c, fcx, pcx);
    }
    0
}

// An atom `has("aes")` whose name is of both architectures: what it would
// have meant on the other one.
fn note_ambiguous(g: i64, fcx: &mut FeaturesCx, pcx: &Ctx<Comp>) {
    let arg = child(g, 0, pcx);
    if pcx.nodes[arg as usize].kind != NodeKind::Str {
        return;
    }
    let name = str_at(pcx.nodes[arg as usize].a);
    if !feature_ambiguous(name) {
        return;
    }
    let other = if target_arch() == ARCH_X86_64 { ARCH_AARCH64 } else { ARCH_X86_64 };
    let b = feature_bit_in(name, other);
    if b >= 0 {
        fcx.alt |= bit(b);
        fcx.alt_at = arg + 1;
    }
}

// The operand of `!x`, or 0.
fn negated(c: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[c as usize].kind == NodeKind::Unary
        && pcx.nodes[c as usize].op == Tok::Bang { pcx.nodes[c as usize].b }
    else { 0 }
}

// Whether node n never completes: `return`, `break`, `continue`, a block
// ending in one, a call of a function returning `!` (panic, exit).
pub fn diverges(n: i64, pcx: &Ctx<Comp>) -> bool {
    if n == 0 {
        return false;
    }
    if pcx.nodes[n as usize].ty == TY_NEVER {
        return true;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::Return || kind == NodeKind::Break || kind == NodeKind::Continue {
        return true;
    }
    if kind == NodeKind::ExprStmt {
        return diverges(pcx.nodes[n as usize].a, pcx);
    }
    if kind == NodeKind::Block {
        if pcx.nodes[n as usize].a != 0 {
            return diverges(pcx.nodes[n as usize].a, pcx);
        }
        return pcx.nodes[n as usize].count > 0
            && diverges(child(n, pcx.nodes[n as usize].count - 1, pcx), pcx);
    }
    false
}

// Whether call n is std's assert.
fn is_assert(n: i64, pcx: &Ctx<Comp>) -> bool {
    let f = pcx.nodes[n as usize].x - 1;
    if f < 0 || !within_std(pcx.fns[f as usize].module, pcx) {
        return false;
    }
    let t = sym_text(pcx.fns[f as usize].display, pcx);
    // (0.18: `assert(c)` is checked as std::contract_check(c, ...))
    t == b"assert" || t == b"std::assert" || t == b"contract_check" || t == b"std::contract_check"
}

// What statement s makes known for the rest of its block: `if !G {
// DIVERGES }` and `assert(G)` give G's atoms.
fn narrows(s: i64, fcx: &mut FeaturesCx, pcx: &Ctx<Comp>) -> i64 {
    let e = if pcx.nodes[s as usize].kind == NodeKind::ExprStmt { pcx.nodes[s as usize].a }
        else { s };
    if e == 0 {
        return 0;
    }
    if pcx.nodes[e as usize].kind == NodeKind::If && pcx.nodes[e as usize].c == 0 {
        let g = negated(pcx.nodes[e as usize].a, pcx);
        if g != 0 && diverges(pcx.nodes[e as usize].b, pcx) {
            return atoms(g, fcx, pcx);
        }
        return 0;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Call && pcx.nodes[e as usize].count > 0
        && is_assert(e, pcx) {
        return atoms(child(e, 0, pcx), fcx, pcx);
    }
    0
}

// ---- The walk ----

fn walk_list(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        walk(child(n, i, pcx), fcx, pcx);
    }
}

fn walk(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    if n == 0 {
        return;
    }
    match { pcx.nodes[n as usize].kind } {
        NodeKind::Int | NodeKind::Str | NodeKind::CStr | NodeKind::Bool | NodeKind::Char
            | NodeKind::Float | NodeKind::Unit | NodeKind::Continue => {}
        NodeKind::Ident => walk_ident(n, fcx, pcx),
        NodeKind::Binary | NodeKind::Assign | NodeKind::While => {
            walk(pcx.nodes[n as usize].b, fcx, pcx);
            walk(pcx.nodes[n as usize].c, fcx, pcx);
        }
        NodeKind::Unary => walk(pcx.nodes[n as usize].b, fcx, pcx),
        NodeKind::Cast | NodeKind::TupleField | NodeKind::ExprStmt | NodeKind::Return
            | NodeKind::Defer | NodeKind::FieldAccess | NodeKind::EnumPanic => {
            walk(pcx.nodes[n as usize].a, fcx, pcx);
        }
        NodeKind::Call => walk_call(n, fcx, pcx),
        NodeKind::MethodCall | NodeKind::VecOp => {
            walk(pcx.nodes[n as usize].a, fcx, pcx);
            walk_list(n, fcx, pcx);
        }
        NodeKind::Index | NodeKind::Repeat | NodeKind::Range => {
            walk(pcx.nodes[n as usize].a, fcx, pcx);
            walk(pcx.nodes[n as usize].b, fcx, pcx);
        }
        NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
            walk_list(n, fcx, pcx);
        }
        NodeKind::FieldInit | NodeKind::Break
            | NodeKind::NamedArg => walk(pcx.nodes[n as usize].b, fcx, pcx),
        NodeKind::Let => walk(pcx.nodes[n as usize].c, fcx, pcx),
        NodeKind::Block => walk_block(n, fcx, pcx),
        NodeKind::If => walk_if(n, fcx, pcx),
        NodeKind::Loop => walk(pcx.nodes[n as usize].b, fcx, pcx),
        NodeKind::For => {
            walk(pcx.nodes[n as usize].c, fcx, pcx);
            walk(pcx.nodes[n as usize].d, fcx, pcx);
        }
        NodeKind::Match => {
            walk(pcx.nodes[n as usize].a, fcx, pcx);
            for i in 0..pcx.nodes[n as usize].count {
                let arm = child(n, i, pcx);
                walk(pcx.nodes[arm as usize].b, fcx, pcx);
                walk(pcx.nodes[arm as usize].c, fcx, pcx);
            }
        }
        NodeKind::Closure => walk_closure(n, fcx, pcx),
        NodeKind::Interp if pcx.nodes[n as usize].x > 0 => {
            let block = pcx.nodes[n as usize].y;
            for i in 0..pcx.nodes[block as usize].count {
                walk(pcx.nodes[child(block, i, pcx) as usize].c, fcx, pcx);
            }
            walk(pcx.nodes[block as usize].a, fcx, pcx);
        }
        NodeKind::Try | NodeKind::Interp => walk(pcx.nodes[n as usize].y, fcx, pcx),
        _ => {}
    }
}

fn walk_block(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    let known = fcx.known;
    let alt = fcx.alt;
    let alt_at = fcx.alt_at;
    for i in 0..pcx.nodes[n as usize].count {
        let s = child(n, i, pcx);
        walk(s, fcx, pcx);
        let more = narrows(s, fcx, pcx);
        if more != 0 {
            fcx.known = implied(fcx.known | more);
        }
    }
    walk(pcx.nodes[n as usize].a, fcx, pcx);
    fcx.known = known;
    fcx.alt = alt;
    fcx.alt_at = alt_at;
}

fn walk_if(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    let cond = pcx.nodes[n as usize].a;
    walk(cond, fcx, pcx);
    let known = fcx.known;
    let alt = fcx.alt;
    let alt_at = fcx.alt_at;
    fcx.known = implied(known | atoms(cond, fcx, pcx));
    walk(pcx.nodes[n as usize].b, fcx, pcx);
    fcx.known = known;
    fcx.alt = alt;
    fcx.alt_at = alt_at;
    let g = negated(cond, pcx);
    if g != 0 {
        fcx.known = implied(known | atoms(g, fcx, pcx));
    }
    walk(pcx.nodes[n as usize].c, fcx, pcx);
    fcx.known = known;
    fcx.alt = alt;
    fcx.alt_at = alt_at;
}

fn walk_call(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[n as usize].x - 1;
    if f < 0 {
        walk(pcx.nodes[n as usize].a, fcx, pcx);
        walk_list(n, fcx, pcx);
        return;
    }
    if feature_call_bit(n, pcx) >= 0 {
        pcx.known_at.put(n + 1, fcx.known | KNOWN_MARK);
    }
    pcx.regions_calls.push(fcx.cur);
    pcx.regions_calls.push(f);
    pcx.regions_calls.push(fcx.known);
    pcx.regions_calls.push(fcx.alt);
    pcx.regions_calls.push(n);
    pcx.regions_calls.push(fcx.alt_at);
    walk_list(n, fcx, pcx);
}

// A function named as a value (not called): a `fn` pointer.
fn walk_ident(n: i64, fcx: &mut FeaturesCx, pcx: &Ctx<Comp>) {
    if pcx.nodes[n as usize].res != Res::Fn || pcx.nodes[n as usize].y < 0 {
        return;
    }
    push_value(pcx.nodes[n as usize].y, n, 0, fcx);
}

// A closure: its function, made here (its body is walked as a function of
// its own, knowing the build's features).
fn walk_closure(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    let c = pcx.nodes[n as usize].x - 1;
    if c >= 0 && pcx.closures[c as usize].f >= 0 {
        // (coerced to a fn type: a plain fn value)
        let y = pcx.nodes[n as usize].y;
        let coerced = y != 0 && pcx.nodes[y as usize].kind == NodeKind::Ident;
        push_value(pcx.closures[c as usize].f, n, if coerced { 0 } else { 1 }, fcx);
        if coerced {
            return;
        }
    }
    walk(pcx.nodes[n as usize].y, fcx, pcx);
}

fn push_value(g: i64, n: i64, closure: i64, fcx: &mut FeaturesCx) {
    fcx.values.push(fcx.cur);
    fcx.values.push(g);
    fcx.values.push(fcx.known);
    fcx.values.push(n);
    fcx.values.push(closure);
}
