// What each function needs (docs/design/arch.md §2.4), inferred as the
// effects are:
//
//     needs(F) = ∪ over the calls c in F of (needs(callee(c)) \ known(c))
//     needs(intrinsic) = its table's features
//
// beyond the build's features, which every point knows. A declaration
// (#[target_feature]) pins a function's set to what it declares: its body
// can no longer change what its callers must know (check.vl checks the
// body against it). A worklist over the calls (regions.vl's CALLS), from
// the intrinsics and the declarations up to their callers: each set only
// grows, by at most the 33 feature bits.

use crate::arch::intrinsic_of_fn;
use crate::arch::features::implied;
use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::features::regions::{CALL_WIDTH, C_ALT, C_CALLEE, C_FN, C_KNOWN};

pub const DECLARED_MARK: i64 = 1 << 48;

// Function f's set when it is an intrinsic without a body (-1: not one).
pub fn intrinsic_needs(f: i64, build: i64, pcx: &Ctx<Comp>) -> i64 {
    let id = intrinsic_of_fn(f, pcx);
    if id < 0 || pcx.nodes[pcx.fns[f as usize].node as usize].c != 0 {
        return -1;
    }
    implied((pcx.intrs[id as usize]).features) & !build
}

// The requirements, from the walked calls (NEEDS holds the intrinsics' and
// the declared sets already).
pub fn infer_needs(n: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        // (the calls of each callee)
        let mut first_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        first_room.resize((n + 2) as usize, 0);
        let first = first_room.as_mut_slice();
        let total = pcx.regions_calls.len() as i64 / CALL_WIDTH;
        for r in 0..total {
            (first[((pcx.regions_calls[(r * CALL_WIDTH + C_CALLEE) as usize]) + 1) as usize]) += 1;
        }
        for g in 0..n {
            (first[(g + 1) as usize]) += (first[g as usize]);
        }
        let mut fill_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        fill_room.resize((n + 1) as usize, 0);
        let fill = fill_room.as_mut_slice();
        let mut order_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        order_room.resize((total + 1) as usize, 0);
        let order = order_room.as_mut_slice();
        for r in 0..total {
            let g = (pcx.regions_calls[(r * CALL_WIDTH + C_CALLEE) as usize]);
            (order[((first[g as usize]) + (fill[g as usize])) as usize]) = r;
            (fill[g as usize]) += 1;
        }
        let mut queued_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        queued_room.resize((n + 1) as usize, 0);
        let queued = queued_room.as_mut_slice();
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for g in 0..n {
            if (pcx.needs[g as usize]) != 0 {
                work.push(g);
                (queued[g as usize]) = 1;
            }
        }
        while work.len() as i64 > 0 {
            let g = work.pop();
            (queued[g as usize]) = 0;
            for k in (first[g as usize])..(first[(g + 1) as usize]) {
                let at = (order[k as usize]) * CALL_WIDTH;
                let f = (pcx.regions_calls[(at + C_FN) as usize]);
                if (pcx.declared[f as usize]) != 0 {
                    continue;
                }
                // (an ambiguous name's other reading is reported where it
                // is, check.vl, and not carried up to the callers)
                let add = (pcx.needs[g as usize])
                    & !((pcx.regions_calls[(at + C_KNOWN) as usize])
                        | (pcx.regions_calls[(at + C_ALT) as usize]));
                if (add & !(pcx.needs[f as usize])) != 0 {
                    (pcx.needs[f as usize]) |= add;
                    if (queued[f as usize]) == 0 {
                        (queued[f as usize]) = 1;
                        work.push(f);
                    }
                }
            }
        }
    }
}
