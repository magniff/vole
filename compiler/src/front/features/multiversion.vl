// #[multiversion("f", "g,h", ...)] (0.19, docs/design/arch.md §2.7): the
// function is compiled once per listed feature set of the target's
// architecture, each version declaring its set as #[target_feature] does
// (so has() folds per version, and the vectorizer and isel see the set),
// plus the baseline version; the function itself dispatches:
//
//     fn f(a: A) -> R { if detect("f") { f$mv0(a) } else if detect("g") && detect("h") { f$mv1(a) } else { <f's body> } }
//
// ordinary code (inlined, its tests hoisted out of a caller's loop by
// LICM), no indirect call. A set of another architecture makes no version;
// a set the build already has makes none either, nor do the ones after it
// (the baseline knows them). Made before the names are collected
// (check_program, before the contracts).
//
// The checks (check.vl): a call needing what a version lacks is
// arch.multiversion, naming the version; the dispatcher needs only the
// baseline (its NEEDS are pinned to nothing), so its address may be taken.

use crate::arch::features::{build_features, feature_is_foreign, has_bit, implied};
use crate::base::{buf_bytes, buf_new, buf_slice, buf_str, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_fmt, err_help_fmt};
use crate::front::ast::{FN_DERIVED, NodeKind, child, list_begin, list_end, list_push, new_node};
use crate::front::features::{
    AE_MULTIVERSION, FA_MULTIVERSION, FA_TARGET_FEATURE, FA_WIDTH, arch_error_begin, arch_error_end,
    features_of_string,
};
use crate::front::features::check::{put_feature, put_features};
use crate::front::features::ctx::FeaturesCx;
use crate::front::features::regions::{C_CALLEE, C_NODE};
use crate::front::generics::instantiate::clone_node;
use crate::front::lexer::{Tok, add_string, str_at};

pub const MV_WIDTH: i64 = 3;

// The versions of every #[multiversion] function, and its dispatcher.
pub fn expand_multiversion(fcx: &mut FeaturesCx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.feature_attrs.len() as i64 == 0 {
            return;
        }
        let program = pcx.program;
        let build = build_features(pcx);
        let made = list_begin(pcx);
        let mut attrs: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..pcx.nodes[program as usize].count {
            let f = child(program, i, pcx);
            if pcx.nodes[f as usize].kind != NodeKind::Fn || pcx.nodes[f as usize].c == 0 {
                continue;
            }
            let mut clones: Vec<i64, Comp> = Vec::new_in(Comp {});
            let mut conds: Vec<i64, Comp> = Vec::new_in(Comp {});
            let mut listed = false;
            let mut done = false;
            let mut a: i64 = 0;
            while a < pcx.feature_attrs.len() as i64 {
                if (pcx.feature_attrs[a as usize]) == f
                    && (pcx.feature_attrs[(a + 1) as usize]) == FA_MULTIVERSION {
                    listed = true;
                    let text = str_at((pcx.feature_attrs[(a + 2) as usize]), pcx);
                    let set = implied(features_of_string(text));
                    if !done && set != 0 && !foreign(set) {
                        if (set & !build) == 0 {
                            // (the baseline has it, and what comes after)
                            done = true;
                        } else {
                            let pos = (pcx.feature_attrs[(a + 3) as usize]);
                            let g = version_of(f, clones.len() as i64, pcx);
                            clones.push(g);
                            conds.push(condition(text, pos, pcx));
                            list_push(g, pcx);
                            attrs.push(g);
                            attrs.push(a);
                            fcx.versions.push(g);
                            fcx.versions.push(f);
                            fcx.versions.push(a);
                        }
                    }
                }
                a += FA_WIDTH;
            }
            if listed {
                fcx.versions.push(f);
                fcx.versions.push(f);
                fcx.versions.push(-1);
            }
            if clones.len() as i64 > 0 {
                dispatch(f, &clones, &conds, pcx);
            }
        }
        // Each version declares its set (after the walk over FEATURE_ATTRS).
        let mut k: i64 = 0;
        while k < attrs.len() as i64 {
            let a = (attrs[(k + 1) as usize]);
            pcx.feature_attrs.push((attrs[k as usize]));
            pcx.feature_attrs.push(FA_TARGET_FEATURE);
            pcx.feature_attrs.push((pcx.feature_attrs[(a + 2) as usize]));
            pcx.feature_attrs.push((pcx.feature_attrs[(a + 3) as usize]));
            k += 2;
        }
        let count = pcx.scratch.len() as i64 - made;
        if count == 0 {
            pcx.scratch.truncate(made as usize);
            return;
        }
        // The program's items, then the versions.
        let mut extra_room: Vec<i64, Comp> = Vec::new_in(Comp {});
        extra_room.resize((count) as usize, 0);
        let extra = extra_room.as_mut_slice();
        for j in 0..count {
            (extra[j as usize]) = (pcx.scratch[(made + j) as usize]);
        }
        pcx.scratch.truncate(made as usize);
        let all = list_begin(pcx);
        for i in 0..pcx.nodes[program as usize].count {
            list_push(child(program, i, pcx), pcx);
        }
        for j in 0..count {
            list_push((extra[j as usize]), pcx);
        }
        list_end(program, all, pcx);
    }
}

// Whether set names a feature of another architecture.
fn foreign(set: i64) -> bool {
    for b in 0..63 {
        if has_bit(set, b) && feature_is_foreign(b) {
            return true;
        }
    }
    false
}

// Version k of f: a copy named `f$mvK`, with its generics and parameters.
fn version_of(f: i64, k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let name = buf_new();
    buf_bytes(name, sym_text(pcx.nodes[f as usize].a, pcx));
    buf_str(name, c"$mv");
    crate::base::buf_fmt(name, format_args("{k}"));
    let g = new_node(NodeKind::Fn, pcx.nodes[f as usize].start, pcx.nodes[f as usize].end, pcx);
    pcx.nodes[g as usize] = pcx.nodes[f as usize];
    pcx.nodes[g as usize].a = intern(buf_slice(name), pcx);
    pcx.nodes[g as usize].b = clone_node(pcx.nodes[f as usize].b, pcx);
    pcx.nodes[g as usize].c = clone_node(pcx.nodes[f as usize].c, pcx);
    pcx.nodes[g as usize].g = clone_node(pcx.nodes[f as usize].g, pcx);
    pcx.nodes[g as usize].x = 0;
    pcx.nodes[g as usize].y = 0;
    pcx.nodes[g as usize].ty = 0;
    pcx.nodes[g as usize].p = pcx.nodes[f as usize].p | FN_DERIVED;
    let mark = list_begin(pcx);
    for i in 0..pcx.nodes[f as usize].count {
        list_push(clone_node(child(f, i, pcx), pcx), pcx);
    }
    list_end(g, mark, pcx);
    g
}

// `std::arch::detect("a") && std::arch::detect("b")` for the set "a,b".
fn condition(text: &[u8], pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut cond: i64 = 0;
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut j = i;
        while j < text.len() as i64 && text[j as usize] != b',' {
            j += 1;
        }
        let mut a = i;
        let mut b = j;
        while a < b && text[a as usize] == b' ' {
            a += 1;
        }
        while b > a && text[(b - 1) as usize] == b' ' {
            b -= 1;
        }
        if b > a {
            let test = detect_call(&text[a as usize..b as usize], pos, pcx);
            if cond == 0 {
                cond = test;
            } else {
                let and = new_node(NodeKind::Binary, pos, pos, pcx);
                pcx.nodes[and as usize].op = Tok::AmpAmp;
                pcx.nodes[and as usize].b = cond;
                pcx.nodes[and as usize].c = test;
                cond = and;
            }
        }
        i = j + 1;
    }
    cond
}

fn ident(sym: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Ident, pos, pos, pcx);
    pcx.nodes[n as usize].a = sym;
    n
}

// `std::arch::detect("name")`
fn detect_call(name: &[u8], pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let path = new_node(NodeKind::Path, pos, pos, pcx);
    pcx.nodes[path as usize].a = intern_c(c"arch", pcx);
    pcx.nodes[path as usize].b = intern_c(c"detect", pcx);
    let segs = list_begin(pcx);
    list_push(ident(intern_c(c"std", pcx), pos, pcx), pcx);
    list_push(ident(intern_c(c"arch", pcx), pos, pcx), pcx);
    list_push(ident(intern_c(c"detect", pcx), pos, pcx), pcx);
    list_end(path, segs, pcx);
    let lit = new_node(NodeKind::Str, pos, pos, pcx);
    pcx.nodes[lit as usize].a = add_string(name, pcx);
    let call = new_node(NodeKind::Call, pos, pos, pcx);
    pcx.nodes[call as usize].a = path;
    let args = list_begin(pcx);
    list_push(lit, pcx);
    list_end(call, args, pcx);
    call
}

// f's body becomes `if c0 { f$mv0(..) } else if c1 { .. } else { <body> }`.
fn dispatch(f: i64, clones: &[i64], conds: &[i64], pcx: &mut Ctx<Comp>) {
    let mut rest = pcx.nodes[f as usize].c;
    let mut k = clones.len() as i64 - 1;
    while k >= 0 {
        let pos = pcx.nodes[(conds[k as usize]) as usize].start;
        let then = new_node(NodeKind::Block, pos, pos, pcx);
        pcx.nodes[then as usize].a = call_version(f, (clones[k as usize]), pos, pcx);
        let none = list_begin(pcx);
        list_end(then, none, pcx);
        let test = new_node(NodeKind::If, pos, pos, pcx);
        pcx.nodes[test as usize].a = (conds[k as usize]);
        pcx.nodes[test as usize].b = then;
        pcx.nodes[test as usize].c = rest;
        let block = new_node(NodeKind::Block, pcx.nodes[pcx.nodes[f as usize].c as usize].start,
            pcx.nodes[pcx.nodes[f as usize].c as usize].end, pcx);
        pcx.nodes[block as usize].a = test;
        let empty = list_begin(pcx);
        list_end(block, empty, pcx);
        rest = block;
        k -= 1;
    }
    pcx.nodes[f as usize].c = rest;
}

// The call of version g with f's parameters (`Self::g(..)` in an impl), f's
// own type parameters written.
fn call_version(f: i64, g: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let call = new_node(NodeKind::Call, pos, pos, pcx);
    let mut own: i64 = 0;
    let gen = pcx.nodes[f as usize].g;
    if gen != 0 && pcx.nodes[gen as usize].count > pcx.nodes[gen as usize].a {
        own = new_node(NodeKind::Generics, pos, pos, pcx);
        let gm = list_begin(pcx);
        for i in pcx.nodes[gen as usize].a..pcx.nodes[gen as usize].count {
            let t = new_node(NodeKind::TyName, pos, pos, pcx);
            pcx.nodes[t as usize].a = pcx.nodes[child(gen, i, pcx) as usize].a;
            list_push(t, pcx);
        }
        list_end(own, gm, pcx);
    }
    if pcx.nodes[f as usize].h != 0 {
        let path = new_node(NodeKind::Path, pos, pos, pcx);
        pcx.nodes[path as usize].a = intern_c(c"Self", pcx);
        pcx.nodes[path as usize].b = pcx.nodes[g as usize].a;
        pcx.nodes[path as usize].h = own;
        pcx.nodes[call as usize].a = path;
    } else {
        let callee = ident(pcx.nodes[g as usize].a, pos, pcx);
        pcx.nodes[callee as usize].g = own;
        pcx.nodes[call as usize].a = callee;
    }
    let am = list_begin(pcx);
    for i in 0..pcx.nodes[f as usize].count {
        list_push(ident(pcx.nodes[child(f, i, pcx) as usize].a, pos, pcx), pcx);
    }
    list_end(call, am, pcx);
    call
}

// The VERSIONS row of function f (its template's, for an instance), or -1.
pub fn version_row(f: i64, fcx: &FeaturesCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if fcx.versions.len() as i64 == 0 {
        return -1;
    }
    let node = if pcx.fns[f as usize].tmpl
        > 0 { pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node }
        else { pcx.fns[f as usize].node };
    let mut r: i64 = 0;
    while r < fcx.versions.len() as i64 {
        if (fcx.versions[r as usize]) == node {
            return r;
        }
        r += MV_WIDTH;
    }
    -1
}

// Whether f is a #[multiversion] function's dispatcher (its NEEDS pinned
// to the baseline's).
pub fn is_dispatcher(f: i64, fcx: &FeaturesCx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let r = version_row(f, fcx, pcx);
    r >= 0 && (fcx.versions[(r + 2) as usize]) < 0
}

// error[arch.multiversion] at call record `at`, in version row r.
pub fn multiversion_error(at: i64, missing: i64, r: i64, fcx: &mut FeaturesCx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let n = (pcx.regions_calls[(at + C_NODE) as usize]);
    let pos = pcx.nodes[n as usize].start;
    for i in 0..fcx.reported.len() as i64 {
        if (fcx.reported[i as usize]) == pos {
            return;
        }
    }
    fcx.reported.push(pos);
    let g = (pcx.regions_calls[(at + C_CALLEE) as usize]);
    let origin = (fcx.versions[(r + 1) as usize]);
    let a = (fcx.versions[(r + 2) as usize]);
    let m = buf_new();
    buf_str(m, c"'");
    buf_bytes(m, sym_text(pcx.nodes[pcx.fns[g as usize].node as usize].a, pcx));
    buf_str(m, c"' needs ");
    put_features(m, missing, c", ", c"");
    buf_str(m, c", which the ");
    if a < 0 {
        buf_str(m, c"baseline");
    } else {
        buf_str(m, c"\"");
        buf_bytes(m, str_at((pcx.feature_attrs[(a + 2) as usize]), pcx));
        buf_str(m, c"\"");
    }
    buf_str(m, c" version of #[multiversion] '");
    buf_bytes(m, sym_text(pcx.nodes[origin as usize].a, pcx));
    buf_str(m, c"' lacks");
    arch_error_begin(pos, AE_MULTIVERSION, pcx);
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    let h = buf_new();
    buf_str(h, c"every version compiles the same body: test the feature around the call, `if std::arch::has(\"");
    let mut b: i64 = 0;
    while b < 63 && !has_bit(missing, b) {
        b += 1;
    }
    put_feature(h, b);
    buf_str(h, c"\") { ... } else { ... }`, true only in the versions that have it");
    err_help_fmt(str::from_utf8(buf_slice(h)).unwrap(), pcx);
    arch_error_end(pcx);
}
