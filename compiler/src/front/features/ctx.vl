// (0.26.4, statics P3) The target features' check state, made by check_program and passed
// down as `fcx` (tools/statics/front-features.group): what were its statics,
// the comment above a field naming the static it was.

use crate::base::IntVec;

pub struct FeaturesCx {
    // (front::features::check::MAIN)
    pub main: i64,
    // (front::features::check::TESTS)
    pub tests: *mut i64,
    // Positions of the arch.multiversion errors reported (a call is in every
    // version: reported once).
    // (front::features::multiversion::REPORTED)
    pub reported: IntVec,
    // The versions: (node, the multiversioned function's node, the
    // FEATURE_ATTRS index of its set, or -1 for the function itself: the
    // dispatcher, whose else branch is the baseline version), MV_WIDTH each.
    // (front::features::multiversion::VERSIONS)
    pub versions: IntVec,
    // (front::features::regions::ALT)
    pub alt: i64,
    // (front::features::regions::ALT_AT)
    pub alt_at: i64,
    // The walk's state: the function walked, the set known, the ambiguous
    // readings and where the last such name is.
    // (front::features::regions::CUR)
    pub cur: i64,
    // (front::features::regions::KNOWN)
    pub known: i64,
    // The functions taken as values, VALUE_WIDTH entries each: the function the
    // value is made in, the function it is, the set known there, the node (an
    // Ident, or a Closure), and whether it is a closure (1) or a plain `fn`
    // value (0).
    // (front::features::regions::VALUES)
    pub values: IntVec,
}

// A new context: every field at its static's first value.
pub fn features_cx_new() -> FeaturesCx {
    FeaturesCx {
        main: 0,
        tests: 0 as *mut i64,
        reported: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        versions: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        alt: 0,
        alt_at: 0,
        cur: 0,
        known: 0,
        values: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
    }
}

// Owned (a Drop of its own, which does nothing), so that a let
// parameter lends the context instead of copying it.
impl Drop for FeaturesCx {
    fn drop(&mut self) {}
}
