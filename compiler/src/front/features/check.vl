// The feature errors (docs/design/arch.md §2.4, §2.9), once the
// requirements are inferred:
//   arch.feature            a call whose callee needs what the point does
//                           not know, in an entry point (main, an `extern
//                           "C" fn`, a test): nothing above it can know it
//   arch.declared           the same in a #[target_feature] function: its
//                           declaration is too small
//   arch.feature_ambiguous  the same where an unqualified `aes` guards or
//                           declares it, meaning the target's architecture
//   arch.fn_pointer         a function that needs features taken as a
//                           `fn` value, or a closure made where its
//                           features are not known
// Each with `try:` lines: the call wrapped in a detect() branch (with the
// fallback of the same signature, when there is one), the build with the
// feature, `query features --why`.

use crate::arch::{ARCH_X86_64, intrinsic_of_fn, target_arch};
use crate::arch::features::{
    arch_options_given, bit, build_features, feature_ambiguous, feature_is_foreign, feature_name,
    has_bit, implied, own_features, push_arch_args,
};
use crate::base::{
    buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, get_src, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_fmt, err_help, err_help_fmt, err_try_tool};
use crate::base::target::{get_elf, get_x86};
use crate::front::features::{
    AE_DECLARED, AE_FEATURE, AE_FEATURE_AMBIGUOUS, AE_FN_POINTER, FA_TARGET_FEATURE, FA_WIDTH,
    arch_error_begin, arch_error_end,
};
use crate::front::features::ctx::FeaturesCx;
use crate::front::features::regions::{
    CALL_WIDTH, C_ALT, C_ALT_AT, C_CALLEE, C_FN, C_KNOWN, C_NODE, VALUE_WIDTH,
};
use crate::front::lexer::str_at;
use crate::front::types::TY_UNIT;

// The errors of the program's calls and function values.
pub fn check_requirements(n: i64, fcx: &mut FeaturesCx, pcx: &mut Ctx<Comp>) {
    unsafe {
        fcx.main = intern_c(c"main", pcx);
        fcx.tests = crate::base::alloc_array::<i64>(n + 1);
        for i in 0..pcx.test_item.len() as i64 {
            let f = pcx.nodes[(pcx.test_item[i as usize]) as usize].x - 1;
            if f >= 0 && f < n {
                (*fcx.tests.add(f as usize)) = 1;
            }
        }
        let total = pcx.regions_calls.len() as i64 / CALL_WIDTH;
        for r in 0..total {
            let at = r * CALL_WIDTH;
            let g = (pcx.regions_calls[(at + C_CALLEE) as usize]);
            let missing = (pcx.needs[g as usize])
                & !(pcx.regions_calls[(at + C_KNOWN) as usize]);
            if missing == 0 {
                continue;
            }
            let f = (pcx.regions_calls[(at + C_FN) as usize]);
            let version = crate::front::features::multiversion::version_row(f, fcx, pcx);
            if (missing & (pcx.regions_calls[(at + C_ALT) as usize])) != 0 {
                ambiguous_error(at, missing & (pcx.regions_calls[(at + C_ALT) as usize]),
                    pcx);
            } else if version >= 0 {
                crate::front::features::multiversion::multiversion_error(at, missing, version,
                    fcx, pcx);
            } else if (pcx.declared[f as usize]) != 0 {
                declared_error(at, missing, pcx);
            } else if is_entry(f, fcx, pcx) {
                feature_error(at, missing, pcx);
            }
        }
        let values = fcx.values.len() as i64 / VALUE_WIDTH;
        for r in 0..values {
            let at = r * VALUE_WIDTH;
            let f = (fcx.values[at as usize]);
            let g = (fcx.values[(at + 1) as usize]);
            let known = (fcx.values[(at + 2) as usize]);
            let node = (fcx.values[(at + 3) as usize]);
            let closure = (fcx.values[(at + 4) as usize]) != 0;
            // (a closure is called directly, where it is passed: the calls
            // carry its set; one coerced to a `fn` type is a plain value)
            let missing = (pcx.needs[g as usize]);
            if !closure && missing != 0 {
                pointer_error(f, g, node, closure, missing, pcx);
            }
        }
    }
}

// Whether nothing above function f can know features for it: main, an
// `extern "C" fn` of the program, a test.
pub fn is_entry(f: i64, fcx: &FeaturesCx, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        pcx.fns[f as usize].name == fcx.main || pcx.fns[f as usize].export
            || (*fcx.tests.add(f as usize)) != 0
    }
}

// ---- Names ----

// The features of set s worth naming: none implied by another of s (avx2,
// not avx2, avx, sse4.2, ...), the architecture's bit only alone.
pub fn top_features(s: i64) -> i64 {
    let mut out: i64 = 0;
    for b in 0..33 {
        if !has_bit(s, b) {
            continue;
        }
        let mut covered = false;
        for c in 0..33 {
            if c != b && has_bit(s, c) && has_bit(implied(bit(c)), b) {
                covered = true;
            }
        }
        if !covered {
            out |= bit(b);
        }
    }
    out
}

// Feature b's name as a program writes it here: qualified (`x86_64.aes`)
// when it is another architecture's and the plain name is the target's.
pub fn put_feature(out: i64, b: i64) {
    let name = feature_name(b);
    if feature_ambiguous(name) && feature_is_foreign(b) {
        buf_str(out, if target_arch() == ARCH_X86_64 { c"aarch64." } else { c"x86_64." });
    }
    buf_bytes(out, name);
}

// The names of set s's top features, `sep` between them, `pre` before each.
pub fn put_features(out: i64, s: i64, sep: *mut u8, pre: *mut u8) {
    let top = top_features(s);
    let mut first = true;
    for b in 0..33 {
        if has_bit(top, b) {
            if !first {
                buf_str(out, sep);
            }
            first = false;
            buf_str(out, pre);
            put_feature(out, b);
        }
    }
}

pub fn target_text() -> *mut u8 {
    if get_x86() {
        if get_elf() { c"x86_64-linux" } else { c"x86_64-macos" }
    } else {
        if get_elf() { c"aarch64-linux" } else { c"aarch64-macos" }
    }
}

// `FILE:LINE:COL` of position pos.
pub fn put_pos(out: i64, pos: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let mut file: i64 = 0;
        while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[(file + 1) as usize].start {
            file += 1;
        }
        let mut line: i64 = 1;
        let mut col: i64 = 1;
        let mut i = pcx.files[file as usize].start;
        while i < pos {
            if get_src()[i as usize] == b'\n' {
                line += 1;
                col = 1;
            } else {
                col += 1;
            }
            i += 1;
        }
        let path = pcx.files[file as usize].path;
        buf_str(out,
            if (*path.add(0)) == b'.' && (*path.add(1)) == b'/' { path.add(2) } else { path });
        buf_byte(out, b':');
        buf_int(out, line);
        buf_byte(out, b':');
        buf_int(out, col);
    }
}

// Function f's name in a message: an intrinsic's without its module.
fn fn_name(f: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let t = sym_text(pcx.fns[f as usize].display, pcx);
    if intrinsic_of_fn(f, pcx) < 0 {
        return t;
    }
    let mut i = t.len() as i64;
    while i > 1 && !(t[(i - 1) as usize] == b':' && t[(i - 2) as usize] == b':') {
        i -= 1;
    }
    if i > 1 { &t[i as usize..] } else { t }
}

// Whether function f is a closure's.
fn is_closure_fn(f: i64, pcx: &Ctx<Comp>) -> bool {
    for c in 0..pcx.closures.len() as i64 {
        if pcx.closures[c as usize].f == f {
            return true;
        }
    }
    false
}

// ---- Why ----

// The call that brings feature b into function f's set: the call node of
// the intrinsic at the end of the chain (0: none found), with the chain
// pushed on `chain` (the callees, f's first) when it is given.
pub fn source_of(f: i64, b: i64, mut chain: Option<&mut Vec<i64, Comp>>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut g = f;
        let mut steps: i64 = 0;
        while steps < 64 {
            steps += 1;
            let mut next: i64 = -1;
            let mut node: i64 = 0;
            for r in (pcx.call_first[g as usize])..(pcx.call_first[(g + 1) as usize]) {
                let at = r * CALL_WIDTH;
                let callee = (pcx.regions_calls[(at + C_CALLEE) as usize]);
                let known = (pcx.regions_calls[(at + C_KNOWN) as usize])
                    | (pcx.regions_calls[(at + C_ALT) as usize]);
                if next < 0 && has_bit((pcx.needs[callee as usize]) & !known, b) {
                    next = callee;
                    node = (pcx.regions_calls[(at + C_NODE) as usize]);
                }
            }
            if next < 0 {
                return 0;
            }
            if let Some(c) = &mut chain {
                c.push(node);
            }
            if intrinsic_of_fn(next, pcx) >= 0 || (pcx.declared[next as usize]) != 0 {
                return node;
            }
            g = next;
        }
        0
    }
}

// ` (from 'INTRINSIC' at FILE:L:C)` for a callee g that is not itself the
// intrinsic bringing the first feature of `missing`.
fn put_from(out: i64, g: i64, missing: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if intrinsic_of_fn(g, pcx) >= 0 {
            return;
        }
        let top = top_features(missing);
        let mut b: i64 = 0;
        while b < 33 && !has_bit(top, b) {
            b += 1;
        }
        let node = source_of(g, b, None, pcx);
        if node == 0 {
            return;
        }
        let callee = pcx.nodes[node as usize].x - 1;
        buf_str(out, c" (from '");
        buf_bytes(out, fn_name(callee, pcx));
        if (pcx.declared[callee as usize]) != 0 && intrinsic_of_fn(callee, pcx) < 0 {
            buf_str(out, c"', declared,");
        } else {
            buf_str(out, c"'");
        }
        buf_str(out, c" at ");
        put_pos(out, pcx.nodes[node as usize].start, pcx);
        buf_byte(out, b')');
    }
}

// ---- The errors ----

// error[arch.feature] at call record `at`, in an entry point.
fn feature_error(at: i64, missing: i64, pcx: &mut Ctx<Comp>) {
    let f = (pcx.regions_calls[(at + C_FN) as usize]);
    let g = (pcx.regions_calls[(at + C_CALLEE) as usize]);
    let n = (pcx.regions_calls[(at + C_NODE) as usize]);
    let m = buf_new();
    buf_byte(m, b'\'');
    buf_bytes(m, fn_name(g, pcx));
    buf_str(m, c"' needs ");
    put_features(m, missing, c", ", c"");
    put_from(m, g, missing, pcx);
    let foreign = (missing & !own_features()) != 0;
    if foreign {
        buf_str(m, c", of another architecture than ");
        buf_str(m, target_text());
        buf_str(m, c"'s: '");
        buf_bytes(m, fn_name(f, pcx));
        buf_str(m, c"' may call it only under has() or detect() of it, where it is dead code");
    } else {
        buf_str(m, c", which '");
        buf_bytes(m, fn_name(f, pcx));
        buf_str(m, c"' does not know here");
        if pcx.fns[f as usize].export {
            buf_str(m, c" (it is extern \"C\": its callers cannot know features)");
        }
        buf_str(m, c": ");
        put_build(m, pcx);
    }
    arch_error_begin(pcx.nodes[n as usize].start, AE_FEATURE, pcx);
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    let fallback = find_fallback(g, (pcx.regions_calls[(at + C_KNOWN) as usize]),
        pcx);
    let h = buf_new();
    if foreign {
        buf_str(h, c"put the call under `if std::arch::has(\"");
        put_features(h, missing, c"\") && std::arch::has(\"", c"");
        buf_str(h, c"\") { ... }`: checked here, generated only for its architecture");
    }
    else if fallback < 0 && !is_unit_call(n, pcx) && pcx.fns[g as usize].tmpl == 0
        && !is_closure_fn(g, pcx)
        && intrinsic_of_fn(g, pcx) < 0 {
        buf_str(h, c"test the CPU with `if std::arch::detect(\"");
        put_features(h, missing, c"\") && std::arch::detect(\"", c"");
        buf_str(h, c"\") { ... } else { ... }` and a fallback in the else branch (one of the same signature named `");
        buf_bytes(h, fn_name(g, pcx));
        buf_str(h, c"_portable`, `_scalar` or `_fallback` is offered here), declare #[target_feature] on the caller, or build for CPUs that have it");
    } else {
        buf_str(h, c"test the CPU and keep a fallback, declare #[target_feature] on the caller, or build only for CPUs that have it");
    }
    err_help_fmt(str::from_utf8(buf_slice(h)).unwrap(), pcx);
    try_wrap(n, missing, fallback, pcx);
    if !foreign {
        let a = buf_new();
        put_features(a, missing, c",", c"+");
        let args = buf_new();
        buf_str(args, c"-C target-feature=");
        buf_bytes(args, buf_slice(a));
        put_arch_options(args, pcx);
        put_output(args, pcx);
        err_try_tool(buf_slice(args), true, pcx);
    }
    try_why(g, missing, pcx);
    arch_error_end(pcx);
}

// `the build's features are ...` or `TARGET's baseline is ...`.
fn put_build(m: i64, pcx: &mut Ctx<Comp>) {
    if arch_options_given(pcx) {
        buf_str(m, c"the build's features are ");
    } else {
        buf_str(m, target_text());
        buf_str(m, c"'s baseline is ");
    }
    put_features(m, build_features(pcx) & own_features(), c", ", c"");
}

// `try: volec query features G --why F ROOT`, for a callee that is not
// itself the intrinsic (a generic function's instance: the function; not
// for a closure).
fn try_why(g: i64, missing: i64, pcx: &mut Ctx<Comp>) {
    if intrinsic_of_fn(g, pcx) >= 0 || is_closure_fn(g, pcx) {
        return;
    }
    let args = buf_new();
    buf_str(args, c"query features ");
    buf_bytes(args,
        fn_name(if pcx.fns[g as usize].tmpl > 0 { pcx.fns[g as usize].tmpl - 1 } else { g }, pcx));
    buf_str(args, c" --why ");
    let top = top_features(missing);
    let mut b: i64 = 0;
    while b < 33 && !has_bit(top, b) {
        b += 1;
    }
    put_feature(args, b);
    put_arch_options(args, pcx);
    err_try_tool(buf_slice(args), true, pcx);
}

// error[arch.declared] at call record `at` of a #[target_feature] function.
fn declared_error(at: i64, missing: i64, pcx: &mut Ctx<Comp>) {
    let f = (pcx.regions_calls[(at + C_FN) as usize]);
    let g = (pcx.regions_calls[(at + C_CALLEE) as usize]);
    let n = (pcx.regions_calls[(at + C_NODE) as usize]);
    let attr = declaration_of(f, pcx);
    let m = buf_new();
    buf_byte(m, b'\'');
    buf_bytes(m, fn_name(f, pcx));
    buf_str(m, c"' is #[target_feature(enable = \"");
    if attr >= 0 {
        buf_bytes(m, str_at((pcx.feature_attrs[(attr + 2) as usize])));
    }
    buf_str(m, c"\")], but '");
    buf_bytes(m, fn_name(g, pcx));
    buf_str(m, c"'");
    put_from(m, g, missing, pcx);
    buf_str(m, c" needs ");
    put_features(m, missing, c", ", c"");
    arch_error_begin(pcx.nodes[n as usize].start, AE_DECLARED, pcx);
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    err_help(c"a declaration is the function's whole requirement: add the feature to it, or test the CPU around the call", pcx);
    if attr >= 0 {
        let text = str_at((pcx.feature_attrs[(attr + 2) as usize]));
        let old = buf_new();
        buf_byte(old, b'"');
        buf_bytes(old, text);
        buf_byte(old, b'"');
        let new = buf_new();
        buf_byte(new, b'"');
        buf_bytes(new, text);
        put_features(new, missing, c"", c",");
        buf_byte(new, b'"');
        try_patch_at((pcx.feature_attrs[(attr + 3) as usize]), buf_slice(old),
            buf_slice(new), pcx);
    }
    arch_error_end(pcx);
}

// The FEATURE_ATTRS index of function f's #[target_feature] (its
// template's, for an instance), or -1.
pub fn declaration_of(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let node = if pcx.fns[f as usize].tmpl
        > 0 { pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node }
        else { pcx.fns[f as usize].node };
    let mut i: i64 = 0;
    while i < pcx.feature_attrs.len() as i64 {
        if (pcx.feature_attrs[i as usize]) == node
            && (pcx.feature_attrs[(i + 1) as usize]) == FA_TARGET_FEATURE {
            return i;
        }
        i += FA_WIDTH;
    }
    -1
}

// error[arch.feature_ambiguous] at call record `at`: an unqualified name
// meant the target's feature where the other architecture's is needed.
fn ambiguous_error(at: i64, which: i64, pcx: &mut Ctx<Comp>) {
    let g = (pcx.regions_calls[(at + C_CALLEE) as usize]);
    let n = (pcx.regions_calls[(at + C_NODE) as usize]);
    let where_ = (pcx.regions_calls[(at + C_ALT_AT) as usize]);
    let mut b: i64 = 0;
    while b < 33 && !has_bit(which, b) {
        b += 1;
    }
    let name = feature_name(b);
    let own = if target_arch() == ARCH_X86_64 { c"x86_64." } else { c"aarch64." };
    let other = if target_arch() == ARCH_X86_64 { c"aarch64." } else { c"x86_64." };
    let m = buf_new();
    buf_byte(m, b'\'');
    buf_bytes(m, name);
    buf_str(m, c"' means ");
    buf_str(m, own);
    buf_bytes(m, name);
    buf_str(m, c" on ");
    buf_str(m, target_text());
    buf_str(m, c", but '");
    buf_bytes(m, fn_name(g, pcx));
    buf_str(m, c"'");
    put_from(m, g, which, pcx);
    buf_str(m, c" needs ");
    buf_str(m, other);
    buf_bytes(m, name);
    arch_error_begin(pcx.nodes[n as usize].start, AE_FEATURE_AMBIGUOUS, pcx);
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    err_help(c"a feature of both architectures is the target's unless qualified: write `aarch64.aes` or `x86_64.aes`", pcx);
    let old = buf_new();
    let new = buf_new();
    if where_ > 0 {
        let s = where_ - 1;
        buf_bytes(old,
            &get_src()[
                pcx.nodes[s as usize].start as usize..pcx.nodes[s as usize].end as usize]);
        buf_byte(new, b'"');
        buf_str(new, other);
        buf_bytes(new, name);
        buf_byte(new, b'"');
        try_patch_at(pcx.nodes[s as usize].start, buf_slice(old), buf_slice(new), pcx);
    } else if where_ < 0 {
        let attr = -1 - where_;
        let text = str_at((pcx.feature_attrs[(attr + 2) as usize]));
        buf_byte(old, b'"');
        buf_bytes(old, text);
        buf_byte(old, b'"');
        buf_byte(new, b'"');
        put_qualified(new, text, name, other);
        buf_byte(new, b'"');
        try_patch_at((pcx.feature_attrs[(attr + 3) as usize]), buf_slice(old),
            buf_slice(new), pcx);
    }
    arch_error_end(pcx);
}

// The list `text` with each plain `name` qualified by `arch`.
fn put_qualified(out: i64, text: &[u8], name: &[u8], arch: *mut u8) {
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut j = i;
        while j < text.len() as i64 && text[j as usize] != b',' {
            j += 1;
        }
        let mut a = i;
        while a < j && text[a as usize] == b' ' {
            a += 1;
        }
        if &text[a as usize..j as usize] == name {
            buf_bytes(out, &text[i as usize..a as usize]);
            buf_str(out, arch);
            buf_bytes(out, name);
        } else {
            buf_bytes(out, &text[i as usize..j as usize]);
        }
        if j < text.len() as i64 {
            buf_byte(out, b',');
        }
        i = j + 1;
    }
}

// error[arch.fn_pointer]: function g, which needs `missing`, as a value at
// node n of function f.
fn pointer_error(f: i64, g: i64, n: i64, closure: bool, missing: i64, pcx: &mut Ctx<Comp>) {
    let m = buf_new();
    if closure {
        buf_str(m, c"this closure needs ");
        put_features(m, missing, c", ", c"");
        put_from(m, g, missing, pcx);
        buf_str(m, c", which '");
        buf_bytes(m, fn_name(f, pcx));
        buf_str(m, c"' does not know where it makes it");
    } else {
        buf_byte(m, b'\'');
        buf_bytes(m, fn_name(g, pcx));
        buf_str(m, c"' needs ");
        put_features(m, missing, c", ", c"");
        put_from(m, g, missing, pcx);
        buf_str(m, c": a `fn` value of it escapes the feature analysis, so its callers could call it where ");
        if (missing & !own_features()) != 0 {
            buf_str(m, c"it cannot run");
        } else {
            put_build(m, pcx);
        }
    }
    arch_error_begin(pcx.nodes[n as usize].start, AE_FN_POINTER, pcx);
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    if closure {
        err_help(c"make the closure inside the `if std::arch::detect(\"FEATURE\") { ... }` branch that uses it", pcx);
    } else {
        err_help(c"call it directly, under a detect() guard, or pass a closure made under the guard (`|x| f(x)`), which the analysis follows", pcx);
    }
    arch_error_end(pcx);
}

// ---- try: lines ----

// Whether call n's value is unit (a statement: its call can be skipped).
fn is_unit_call(n: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[n as usize].ty == TY_UNIT
}

// A function to call where the CPU lacks what g needs: in g's module, not
// generic, with g's parameter and result types, needing nothing beyond
// `known`, named as a fallback of g: its name or its stem (g's without its
// last `_part`: `sum_avx2` -> `sum`) alone or with `_portable`, `_scalar`,
// `_generic`, `_fallback`, `_soft`, `_sw`, `_baseline` or `_table`. -1:
// none.
fn find_fallback(g: i64, known: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.fns[g as usize].self_ty != 0 || intrinsic_of_fn(g, pcx) >= 0 {
            return -1;
        }
        let name = fn_name(g, pcx);
        let mut cut = name.len() as i64;
        while cut > 0 && name[(cut - 1) as usize] != b'_' {
            cut -= 1;
        }
        let stem = if cut <= 1 { name } else { &name[0..(cut - 1) as usize] };
        let mut best: i64 = -1;
        for h in 0..pcx.fns.len() as i64 {
            if h == g || pcx.fns[h as usize].module != pcx.fns[g as usize].module
                || pcx.fns[h as usize].generic > 0 || pcx.fns[h as usize].tmpl > 0
                || pcx.fns[h as usize].self_ty != 0 || pcx.fns[h as usize].node == 0
                || intrinsic_of_fn(h, pcx) >= 0
                || ((pcx.needs[h as usize]) & !known) != 0 {
                continue;
            }
            let hn = fn_name(h, pcx);
            let exact = hn == stem && cut > 1;
            if !(exact || fallback_named(hn, stem) || fallback_named(hn, name))
                || !same_signature(g, h, pcx) {
                continue;
            }
            if best < 0 || exact {
                best = h;
            }
        }
        best
    }
}

// Whether `hn` is `base_SUFFIX` with a fallback's suffix.
fn fallback_named(hn: &[u8], base: &[u8]) -> bool {
    let n = base.len() as i64;
    if hn.len() as i64 <= n + 1 || &hn[0..n as usize] != base || hn[n as usize] != b'_' {
        return false;
    }
    let rest = &hn[(n + 1) as usize..];
    rest == b"portable" || rest == b"scalar" || rest == b"generic" || rest == b"fallback"
        || rest == b"soft" || rest == b"sw" || rest == b"baseline" || rest == b"table"
}

fn same_signature(g: i64, h: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.fns[g as usize].param_count != pcx.fns[h as usize].param_count
        || pcx.fns[g as usize].ret != pcx.fns[h as usize].ret {
        return false;
    }
    for k in 0..pcx.fns[g as usize].param_count {
        if (pcx.tlists[(pcx.fns[g as usize].params + k) as usize])
            != (pcx.tlists[(pcx.fns[h as usize].params + k) as usize]) {
            return false;
        }
    }
    true
}

// `try: volec edit patch FILE:LINE --old 'LINE' --new 'LINE'` with call
// n wrapped in `if std::arch::detect("F") { CALL } else { FALLBACK(ARGS) }`
// (no else for a unit call without a fallback; nothing for a value without
// one, or a call over several lines).
fn try_wrap(n: i64, missing: i64, fallback: i64, pcx: &mut Ctx<Comp>) {
    if fallback < 0 && !is_unit_call(n, pcx) {
        return;
    }
    let pre = buf_new();
    buf_str(pre, c"if ");
    let top = top_features(missing);
    let mut first = true;
    for b in 0..33 {
        if has_bit(top, b) {
            if !first {
                buf_str(pre, c" && ");
            }
            first = false;
            buf_str(pre, c"std::arch::detect(\"");
            put_feature(pre, b);
            buf_str(pre, c"\")");
        }
    }
    buf_str(pre, c" { ");
    let post = buf_new();
    if fallback >= 0 {
        let callee = pcx.nodes[n as usize].a;
        let ctext = &get_src()[
            pcx.nodes[callee as usize].start as usize..pcx.nodes[callee as usize].end as usize];
        let gname = fn_name(pcx.nodes[n as usize].x - 1, pcx);
        buf_str(post, c" } else { ");
        if ctext.len() >= gname.len()
            && ctext[(ctext.len() as i64 - gname.len() as i64) as usize..] == gname {
            buf_bytes(post, &ctext[0..(ctext.len() as i64 - gname.len() as i64) as usize]);
        }
        buf_bytes(post, fn_name(fallback, pcx));
        buf_bytes(post,
            &get_src()[
                pcx.nodes[callee as usize].end as usize..pcx.nodes[n as usize].end as usize]);
        buf_str(post, c" }");
    } else {
        buf_str(post, c"; }");
    }
    try_line_edit(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, buf_slice(pre),
        buf_slice(post), pcx);
}

// `try: volec edit patch FILE:LINE --old 'LINE' --new 'LINE'`: the line
// of [start, end) with `pre` before and `post` after that text.
fn try_line_edit(start: i64, end: i64, pre: &[u8], post: &[u8], pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut file: i64 = 0;
        while file + 1 < pcx.files.len() as i64 && start >= pcx.files[(file + 1) as usize].start {
            file += 1;
        }
        let path = pcx.files[file as usize].path;
        if (*path.add(0)) == b'<' {
            return;
        }
        let mut ls = start;
        while ls > pcx.files[file as usize].start && get_src()[(ls - 1) as usize] != b'\n' {
            ls -= 1;
        }
        while ls < start && (get_src()[ls as usize] == b' ' || get_src()[ls as usize] == b'\t') {
            ls += 1;
        }
        let mut le = start;
        while get_src()[le as usize] != b'\n' && get_src()[le as usize] != 0 {
            le += 1;
        }
        if end > le {
            return;
        }
        let old = buf_new();
        buf_bytes(old, &get_src()[ls as usize..le as usize]);
        let new = buf_new();
        buf_bytes(new, &get_src()[ls as usize..start as usize]);
        buf_bytes(new, pre);
        buf_bytes(new, &get_src()[start as usize..end as usize]);
        buf_bytes(new, post);
        buf_bytes(new, &get_src()[end as usize..le as usize]);
        put_patch(start, buf_slice(old), buf_slice(new), pcx);
    }
}

// `try: volec edit patch FILE:LINE --old OLD --new NEW` for the text old
// on the line of pos.
fn try_patch_at(pos: i64, old: &[u8], new: &[u8], pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut file: i64 = 0;
        while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[(file + 1) as usize].start {
            file += 1;
        }
        if (*pcx.files[file as usize].path.add(0)) == b'<' {
            return;
        }
        put_patch(pos, old, new, pcx);
    }
}

fn put_patch(pos: i64, old: &[u8], new: &[u8], pcx: &mut Ctx<Comp>) {
    let args = buf_new();
    buf_str(args, c"edit patch ");
    let at = buf_new();
    put_pos(at, pos, pcx);
    // (FILE:LINE: the column dropped)
    let p = buf_slice(at);
    let mut cut = p.len() as i64;
    while cut > 0 && p[(cut - 1) as usize] != b':' {
        cut -= 1;
    }
    buf_bytes(args, &p[0..(cut - 1) as usize]);
    buf_str(args, c" --old ");
    quoted(args, old);
    buf_str(args, c" --new ");
    quoted(args, new);
    put_arch_options(args, pcx);
    err_try_tool(buf_slice(args), true, pcx);
}

// ` -C OPTION` for each -C option the command line gave (an edit's check
// then knows the same features).
fn put_arch_options(out: i64, pcx: &mut Ctx<Comp>) {
    let mut opts: Vec<i64, Comp> = Vec::new_in(Comp {});
    push_arch_args(&mut opts, pcx);
    for k in 0..opts.len() as i64 {
        buf_byte(out, b' ');
        buf_str(out, (opts[k as usize]) as *mut u8);
    }
}

// ` -o STEM`: the program the root file builds (`sum.vl` -> `sum`; a
// `main.vl`: its directory's name).
fn put_output(out: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let mut f: i64 = 0;
        while f < pcx.files.len() as i64 && (*pcx.files[f as usize].path.add(0)) == b'<' {
            f += 1;
        }
        if f >= pcx.files.len() as i64 {
            return;
        }
        let p = pcx.files[f as usize].path;
        let mut n: i64 = 0;
        while (*p.add(n as usize)) != 0 {
            n += 1;
        }
        let path = std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize);
        let mut end = n;
        end -= crate::base::source_ext_len(path);
        let mut start = end;
        while start > 0 && path[(start - 1) as usize] != b'/' {
            start -= 1;
        }
        if &path[start as usize..end as usize] == b"main" && start > 1 {
            end = start - 1;
            start = end;
            while start > 0 && path[(start - 1) as usize] != b'/' {
                start -= 1;
            }
        }
        if end > start {
            buf_str(out, c" -o ");
            buf_bytes(out, &path[start as usize..end as usize]);
        }
    }
}

// s in single quotes for a shell.
fn quoted(out: i64, s: &[u8]) {
    buf_byte(out, b'\'');
    for i in 0..s.len() {
        if s[i] == b'\'' {
            buf_str(out, c"'\\''");
        } else {
            buf_byte(out, s[i]);
        }
    }
    buf_byte(out, b'\'');
}
