// Associated types (0.14; docs/design/closures-iterators.md), restricted:
// `type Item;` in a trait, `type Item = T;` in its impls, the projection
// `X::Item` when X is concrete (always so in an instance) or `Self`, the
// built-in `F::Output` of a closure or fn type, and the constraints of a
// bound, `I: Iterator<Item = T>`, checked when an instance is made and
// used to infer T. Also lazy defaults: a trait default copied into a
// non-generic impl (FN_LAZY) is checked only when first used.
//
// An impl's definitions are resolved when a projection asks for them (in
// the impl's module, `Self` the type, a generic impl's parameters bound to
// the type's arguments); those of a non-generic impl once (cached in the
// AssocType node's `ty`).

use crate::base::{intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_end_soft, err_fmt, err_help_fmt, err_str};
use crate::front::ast::{FN_LAZY, NODE_ASSOC_CONST, NodeKind, child};
use crate::front::check::{has_error_type, resolve_type_or_error};
use crate::front::check::resolve::resolve_type;
use crate::front::closures::{closure_of_type, closure_sig};
use crate::front::generics::{env_enter, env_leave, env_lookup};
use crate::front::generics::instantiate::unify;
use crate::front::modules::{is_within, module_of, within_std};
use crate::front::traits::{bound_trait, implements};
use crate::front::types::{TyKind, err_type};

// The AssocType node named `name` in holder h (0: none), or 0.
fn assoc_in(h: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    if h == 0 {
        return 0;
    }
    for i in 0..pcx.nodes[h].count {
        if pcx.nodes[child(h, i, pcx)].a == name {
            return child(h, i, pcx);
        }
    }
    0
}

fn duplicate_names(h: i64, pcx: inout Ctx<Comp>) {
    if h == 0 {
        return;
    }
    for i in 0..pcx.nodes[h].count {
        let c = child(h, i, pcx);
        for j in 0..i {
            if pcx.nodes[child(h, j, pcx)].a == pcx.nodes[c].a {
                err_begin(pcx.nodes[c].start, &pcx);
                err_fmt(format_args("duplicate associated type '{}'",
                    sym_text(pcx.nodes[c].a, pcx)),
                    pcx);
                err_end_soft(&pcx);
                break;
            }
        }
    }
}

// The associated types trait `tr` (a TRAITS index) declares: its node's
// `b` (a holder of AssocType nodes, 0: none).
pub fn collect_trait_assoc(tr: i64, pcx: inout Ctx<Comp>) {
    duplicate_names(pcx.nodes[pcx.traits[tr].node].b, &pcx);
}

// The associated types impl `i` (an IMPLS index) defines: its node's `c`
// (a holder of AssocType nodes, 0: none); each name its trait declares
// must be defined.
pub fn collect_impl_assoc(i: i64, pcx: inout Ctx<Comp>) {
    let node = pcx.traits_impls[i].node;
    let holder = pcx.nodes[node].c;
    let tr = pcx.traits_impls[i].tr;
    let declared = pcx.nodes[pcx.traits[tr].node].b;
    duplicate_names(holder, &pcx);
    if holder != 0 {
        for k in 0..pcx.nodes[holder].count {
            let c = child(holder, k, pcx);
            if assoc_in(declared, pcx.nodes[c].a, pcx) == 0 {
                err_begin(pcx.nodes[c].start, &pcx);
                err_fmt(format_args("'{}' is not an associated type of trait '",
                    sym_text(pcx.nodes[c].a, pcx)), pcx);
                err_fmt(format_args("{}'", sym_text(pcx.traits[tr].name, pcx)), pcx);
                err_end_soft(&pcx);
            }
        }
    }
    if declared != 0 {
        for k in 0..pcx.nodes[declared].count {
            let d = child(declared, k, pcx);
            // (0.27.2: a constant with a default need not be defined, F3.1)
            if (pcx.nodes[d].p & NODE_ASSOC_CONST) != 0 && pcx.nodes[d].c != 0 {
                continue;
            }
            if assoc_in(holder, pcx.nodes[d].a, pcx) == 0 {
                err_begin(pcx.nodes[node].start, &pcx);
                err_fmt(format_args("the impl of trait '{}' is missing 'type ",
                    sym_text(pcx.traits[tr].name, pcx)), pcx);
                err_fmt(format_args("{}'", sym_text(pcx.nodes[d].a, pcx)), pcx);
                err_help_fmt(format_args("write it in the impl: 'type {} = ...;'",
                    sym_text(pcx.nodes[d].a, pcx)), pcx);
                err_end_soft(&pcx);
            }
        }
    }
}

// Whether impl i is for type t.
fn impl_covers(i: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    // RULE: F0.3 (0.27.2: with the impl's bounds, so that a blanket impl
    // whose bound fails does not give its associated types)
    crate::front::traits::impl_applies(i, t, &pcx) >= 0
}

// The AssocType node `name` of the impl of trait tr (of any trait when tr
// < 0) for type t, or 0; the impl in FOUND_IMPL. (0.27.2) Inside an
// impl, `Self::A` is that impl's own (pcx.self_impl, F5.4, F13.2); among
// the impls of one generic trait, the one with the arguments the
// declaration is read with (trait_args_agree, F13.1); a blanket impl's
// definition yields to a direct impl's (F11.4), so `Chars::Item` is
// Iterator's, not the blanket `IntoIterator for I`'s copy of it.
fn find_assoc(tr: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    var found = 0;
    pcx.found_impl = -1;
    pcx.found_other = -1;
    // (every preference below is the rust edition's: an MVS program's
    // diagnostics keep their order)
    let rust = pcx.edition != 0;
    let own = if rust { pcx.self_impl } else { -1 };
    if own >= 0 && (tr < 0 || pcx.traits_impls[own].tr == tr) {
        let c = assoc_in(pcx.nodes[pcx.traits_impls[own].node].c, name, pcx);
        if c != 0 && (pcx.traits_impls[own].ty == t || impl_covers(own, t, &pcx)) {
            pcx.found_impl = own;
            return c;
        }
    }
    // (0.27.2: the choice in locals: impl_covers searches impls again,
    // and its find_assoc sets pcx.found_impl)
    var found_impl = -1;
    var found_other = -1;
    for i in 0..pcx.traits_impls.len() as i64 {
        if tr >= 0 && pcx.traits_impls[i].tr != tr {
            continue;
        }
        let c = assoc_in(pcx.nodes[pcx.traits_impls[i].node].c, name, pcx);
        if c == 0 || (pcx.nodes[c].p & NODE_ASSOC_CONST) != 0 || !impl_covers(i, t, &pcx)
            || rust && !crate::front::traits::trait_args_agree(i, t, &pcx) {
            continue;
        }
        if found == 0 {
            found = c;
            found_impl = i;
        }
        else if pcx.traits_impls[i].tr != pcx.traits_impls[found_impl].tr {
            let blanket = rust && crate::front::traits::blanket_impl(i, pcx);
            if rust && crate::front::traits::blanket_impl(found_impl, pcx) && !blanket {
                found = c;
                found_impl = i;
                found_other = -1;
            } else if !blanket && found_other < 0 {
                found_other = i;
            }
        }
    }
    pcx.found_impl = found_impl;
    pcx.found_other = found_other;
    found
}

pub const MAX_ASSOC_DEPTH: i64 = 32;

// The type definition c (an AssocType node) of impl i gives type t.
fn assoc_value(i: i64, c: i64, t: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    assoc_value_with(i, c, t, pos, -1, &pcx)
}

// assoc_value with the impl's bindings `binds` (a TLISTS index; -1: the
// ones t gives, impl_bindings).
fn assoc_value_with(i: i64, c: i64, t: i64, pos: i64, binds: i64, pcx: inout Ctx<Comp>) -> i64 {
    let node = pcx.traits_impls[i].node;
    let params = pcx.nodes[node].g;
    let generic = params != 0 && pcx.nodes[params].count > 0;
    if !generic && pcx.nodes[c].ty != 0 {
        return pcx.nodes[c].ty;
    }
    if pcx.assoc_depth >= MAX_ASSOC_DEPTH {
        err_begin(pos, &pcx);
        err_fmt(format_args("the associated type '{}' of '", sym_text(pcx.nodes[c].a, pcx)), pcx);
        err_type(t, pcx);
        err_str(c"' is defined in terms of itself", pcx);
        err_end(&pcx);
    }
    pcx.assoc_depth += 1;
    let saved_mod = pcx.cur_mod;
    let saved_self = pcx.self_type;
    let saved_impl = pcx.self_impl;
    pcx.cur_mod = pcx.traits_impls[i].module;
    pcx.self_type = t;
    pcx.self_impl = i;
    // (a non-generic impl sees no type parameter: an empty frame)
    let saved = if generic {
        env_enter(params, if binds >= 0 { binds }
            else { crate::front::traits::impl_bindings(i, t, &pcx) },
            pcx.nodes[params].count, &pcx)
    }
        else { env_enter(0, 0, 0, &pcx) };
    let ty = resolve_type_or_error(pcx.nodes[c].b, &pcx);
    env_leave(saved, &pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    pcx.self_impl = saved_impl;
    pcx.assoc_depth -= 1;
    if !generic {
        pcx.nodes[c].ty = ty;
    }
    ty
}

// (0.27.2) Path n is `t::name` with `name` an associated constant of t
// (defined in an impl for t, else a trait's default): n becomes a copy
// of the constant's value expression, checked against its type in the
// impl's scope (Self = t, the impl's parameters bound); its type. -1
// when t has no such constant. RULE: F3.2
pub fn assoc_const_value(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    var c = 0;
    var i = -1;
    for k in 0..pcx.traits_impls.len() as i64 {
        let own = assoc_in(pcx.nodes[pcx.traits_impls[k].node].c, name, pcx);
        let decl = assoc_in(pcx.nodes[pcx.traits[pcx.traits_impls[k].tr].node].b, name, pcx);
        let d = if own != 0 { own } else { decl };
        if d == 0 || (pcx.nodes[d].p & NODE_ASSOC_CONST) == 0 || pcx.nodes[d].c == 0
            || !impl_covers(k, t, &pcx) {
            continue;
        }
        c = d;
        i = k;
    }
    if c == 0 {
        return -1;
    }
    let node = pcx.traits_impls[i].node;
    let params = pcx.nodes[node].g;
    let generic = params != 0 && pcx.nodes[params].count > 0;
    let saved_mod = pcx.cur_mod;
    let saved_self = pcx.self_type;
    let saved_impl = pcx.self_impl;
    pcx.cur_mod = module_of(c, &pcx);
    pcx.self_type = t;
    pcx.self_impl = i;
    let saved = if generic {
        env_enter(params, crate::front::traits::impl_bindings(i, t, &pcx),
            pcx.nodes[params].count, &pcx)
    } else { env_enter(0, 0, 0, &pcx) };
    let ty = resolve_type_or_error(pcx.nodes[c].b, &pcx);
    let e = crate::front::generics::instantiate::clone_node(pcx.nodes[c].c, &pcx);
    crate::front::check::check_mode::check_expr(e, ty, &pcx);
    env_leave(saved, &pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    pcx.self_impl = saved_impl;
    // (n becomes `{ e }`, as convert::become_value makes a call its value)
    let start = pcx.nodes[n].start;
    let end = pcx.nodes[n].end;
    pcx.nodes[n] = pcx.nodes[0];
    pcx.nodes[n].kind = NodeKind::Block;
    pcx.nodes[n].start = start;
    pcx.nodes[n].end = end;
    pcx.nodes[n].a = e;
    pcx.nodes[n].ty = ty;
    ty
}

// (0.27.2) Path n is `t::name` with `name` a constant of an inherent impl
// of t (`impl char { const MAX: char = ..; }`, `impl<T> W<T> { const N:
// usize = ..; }`, recorded by the parser in pcx.inherent_consts): n
// becomes a copy of its value expression, checked against its type in the
// impl's module with Self = t and a generic impl's parameters bound by its
// self type matching t; its type. -1 when t has none. RULE: F3.1, F3.2
pub fn inherent_const_value(n: i64, t: i64, name: i64, pcx: inout Ctx<Comp>) -> i64 {
    var c = 0;
    var c_params = 0;
    let mark = pcx.tscratch.count;
    for k in 0..pcx.inherent_consts.count / 3 {
        let d = pcx.inherent_consts.get(3 * k);
        let params = pcx.inherent_consts.get(3 * k + 2);
        if pcx.nodes[d].a != name || pcx.nodes[d].c == 0 || c != 0 {
            continue;
        }
        let saved_mod = pcx.cur_mod;
        pcx.cur_mod = module_of(d, &pcx);
        if params != 0 && pcx.nodes[params].count > 0 {
            // (a generic impl's: its self type matched against t binds
            // every parameter, as an impl header's, F0.3)
            let count = pcx.nodes[params].count;
            let bound = crate::base::alloc_array::<i64>(count);
            let ok = crate::front::generics::instantiate::match_type(params, bound, pcx.cur_mod,
                pcx.inherent_consts.get(3 * k + 1), t, &pcx);
            // UNSAFE: `bound` is the raw array match_type fills, count slots.
            // SAFETY: i < count; it is freed once read.
            unsafe {
                var all = ok;
                for i in 0..count {
                    all = all && bound[i] != 0;
                }
                if all {
                    c = d;
                    c_params = params;
                    for i in 0..count {
                        pcx.tscratch.push(bound[i]);
                    }
                }
                crate::base::free(bound as *u8);
            }
        } else if resolve_type(pcx.inherent_consts.get(3 * k + 1), &pcx) == t {
            c = d;
        }
        pcx.cur_mod = saved_mod;
    }
    if c == 0 {
        return -1;
    }
    let saved_mod = pcx.cur_mod;
    let saved_self = pcx.self_type;
    pcx.cur_mod = module_of(c, &pcx);
    pcx.self_type = t;
    // (the parameters bound for the constant's type and value)
    let targs = pcx.tlists.count;
    for i in mark..pcx.tscratch.count {
        pcx.tlists.push(pcx.tscratch.get(i));
    }
    let count = pcx.tscratch.count - mark;
    pcx.tscratch.count = mark;
    let env = if c_params != 0 { env_enter(c_params, targs, count, &pcx) } else { 0 };
    let ty = resolve_type_or_error(pcx.nodes[c].b, &pcx);
    let e = crate::front::generics::instantiate::clone_node(pcx.nodes[c].c, &pcx);
    crate::front::check::check_mode::check_expr(e, ty, &pcx);
    if c_params != 0 {
        env_leave(env, &pcx);
    }
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    let start = pcx.nodes[n].start;
    let end = pcx.nodes[n].end;
    pcx.nodes[n] = pcx.nodes[0];
    pcx.nodes[n].kind = NodeKind::Block;
    pcx.nodes[n].start = start;
    pcx.nodes[n].end = end;
    pcx.nodes[n].a = e;
    pcx.nodes[n].ty = ty;
    ty
}

// Whether some impl for t is of a trait declaring `name` (which then
// lacks it: an error reported with the impl).
fn declared_for(t: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    for i in 0..pcx.traits_impls.len() as i64 {
        if impl_covers(i, t, &pcx)
            && assoc_in(pcx.nodes[pcx.traits[pcx.traits_impls[i].tr].node].b, name, pcx) != 0 {
            return true;
        }
    }
    false
}

// The type `t::name` (an error at pos when there is none, or two traits
// of t define it).
pub fn projection(t: i64, name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    if has_error_type(t, pcx) {
        return pcx.ty_error;
    }
    // RULE: F18.6 (`?v::name` of a type variable: a variable standing for
    // it, solved with ?v)
    if pcx.infer_live {
        let r = crate::front::check::infer::resolve(t, &pcx);
        if crate::front::check::infer::is_free_var(r, pcx) {
            return crate::front::check::infer::dependent(r, name, pos, &pcx);
        }
        if r != t {
            return projection(r, name, pos, &pcx);
        }
    }
    // (built in: the result type of a closure or fn type)
    if name == intern_c(c"Output", &pcx) {
        let cl = closure_of_type(t, pcx);
        if cl != 0 {
            let sig = closure_sig(cl - 1, pcx);
            return if sig != 0 { pcx.types[sig].a } else { pcx.ty_error };
        }
        if pcx.types[t].kind == TyKind::Fn {
            return pcx.types[t].a;
        }
    }
    // RULE: D22.1 (`Ω::Item`: its bound's equality)
    if crate::front::opaque::is_omega(t, pcx) {
        let r = crate::front::opaque::omega_projection(t, name, &pcx);
        if r != 0 {
            return r;
        }
    }
    let c = find_assoc(-1, t, name, &pcx);
    if c == 0 {
        if declared_for(t, name, &pcx) {
            return pcx.ty_error;
        }
        err_begin(pos, &pcx);
        err_str(c"'", pcx);
        err_type(t, pcx);
        err_fmt(format_args("' has no associated type '{}'", sym_text(name, pcx)), pcx);
        err_end(&pcx);
    }
    if pcx.found_other >= 0 {
        err_begin(pos, &pcx);
        err_str(c"'", pcx);
        err_type(t, pcx);
        err_fmt(format_args("::{}' is ambiguous: traits '", sym_text(name, pcx)), pcx);
        err_fmt(format_args("{}' and '",
            sym_text(pcx.traits[pcx.traits_impls[pcx.found_impl].tr].name, pcx)), pcx);
        err_fmt(format_args("{}' both define it",
            sym_text(pcx.traits[pcx.traits_impls[pcx.found_other].tr].name, pcx)), pcx);
        err_end(&pcx);
    }
    assoc_value(pcx.found_impl, c, t, pos, &pcx)
}

// The associated type `name` trait tr gives type t, or 0 when t has no
// impl of tr defining it (no error).
pub fn trait_projection(tr: i64, t: i64, name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    // RULE: D22.1 (`<Ω as Tr>::Item`: its bound's equality, or none)
    if crate::front::opaque::is_omega(t, pcx) {
        return crate::front::opaque::omega_projection(t, name, &pcx);
    }
    let c = find_assoc(tr, t, name, &pcx);
    if c == 0 {
        return 0;
    }
    assoc_value(pcx.found_impl, c, t, pos, &pcx)
}

// (0.27.4) The associated type `name` of t's impl of tr written with the
// arguments TLISTS[bargs..] (`<I as SliceIndex<[i64]>>::Output`: the impl
// for `[T]`, not for str), its parameters only they fix completed from
// them, as projection_by_bounds reads a bound; 0 when none. RULE: F8.1, F14.1
pub fn trait_projection_with(tr: i64, t: i64, bargs: i64, name: i64, pos: i64,
    pcx: inout Ctx<Comp>) -> i64 {
    let saved_tr = pcx.assoc_trait;
    let saved_args = pcx.assoc_targs;
    pcx.assoc_trait = tr;
    pcx.assoc_targs = bargs;
    let c = find_assoc(tr, t, name, &pcx);
    pcx.assoc_trait = saved_tr;
    pcx.assoc_targs = saved_args;
    if c == 0 {
        return 0;
    }
    let i = pcx.found_impl;
    var binds = -1;
    if crate::front::convert::impl_targs(i, t, &pcx) < 0 {
        binds = crate::front::convert::complete_impl_bindings(i, t, bargs, &pcx);
    }
    assoc_value_with(i, c, t, pos, binds, &pcx)
}

// The type projection node n (a TyName, is_projection_node) stands for.
pub fn resolve_projection_node(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let first = pcx.nodes[child(n, 0, pcx)].a;
    let param = env_lookup(first, pcx);
    let base = if param != 0 { param } else { pcx.self_type };
    // RULE: F11.3 (0.27.2: `I::Output` under `I: SliceIndex<[T]>` is `<I as
    // SliceIndex<[T]>>::Output`, though usize has Add's Output too)
    if param != 0 && pcx.edition != 0 && !has_error_type(base, pcx) {
        let r = projection_by_bounds(first, base, n, &pcx);
        if r != 0 {
            return r;
        }
    }
    projection(base, pcx.nodes[n].a, pcx.nodes[n].start, &pcx)
}

// (0.27.2) `P::name` for the type parameter P (bound to t) through the
// traits of P's bounds: the definition of the first bound trait's impl for
// t, read with the bound's arguments (an impl parameter only they fix,
// `impl<T> SliceIndex<[T]> for usize`, completed from them); 0 when no
// bound gives one. RULE: F11.3, F14.1
fn projection_by_bounds(first: i64, t: i64, n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let p = crate::front::generics::env_param_node(first, pcx);
    if p <= 0 || pcx.nodes[p].h == 0 {
        return 0;
    }
    let name = pcx.nodes[n].a;
    let bounds = pcx.nodes[p].h;
    for k in 0..pcx.nodes[bounds].count {
        let b = child(bounds, k, pcx);
        if pcx.nodes[b].kind != NodeKind::TyName {
            continue;
        }
        let tr = crate::front::traits::bound_trait(b, &pcx);
        if tr < 0 {
            continue;
        }
        let bargs = if pcx.nodes[b].g != 0 { crate::front::convert::bound_args(b, &pcx) }
            else { -1 };
        let saved_tr = pcx.assoc_trait;
        let saved_args = pcx.assoc_targs;
        pcx.assoc_trait = tr;
        pcx.assoc_targs = bargs;
        let c = find_assoc(tr, t, name, &pcx);
        pcx.assoc_trait = saved_tr;
        pcx.assoc_targs = saved_args;
        if c == 0 {
            continue;
        }
        let i = pcx.found_impl;
        var binds = -1;
        if bargs >= 0 && crate::front::convert::impl_targs(i, t, &pcx) < 0 {
            binds = crate::front::convert::complete_impl_bindings(i, t, bargs, &pcx);
        }
        return assoc_value_with(i, c, t, pcx.nodes[n].start, binds, &pcx);
    }
    0
}

// Whether type node n is a projection, `T::Item` or `Self::Item` (not a
// type in a module, `a::T`).
pub fn is_projection_node(n: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.nodes[n].kind != NodeKind::TyName || pcx.nodes[n].count != 1 || pcx.nodes[n].g != 0 {
        return false;
    }
    // (0.27.2: `<X as Tr>::A`, F8.1)
    if (pcx.nodes[n].p & crate::front::ast::NODE_QPATH) != 0 {
        return true;
    }
    let first = pcx.nodes[child(n, 0, pcx)].a;
    (first == pcx.self_type_sym && pcx.self_type != 0) || env_lookup(first, pcx) != 0
}

// The type constraint c (an AssocType node of a bound) names, resolved in
// its own module (with the type parameters in scope: check_bounds binds
// those of the item being instantiated).
fn constraint_type(c: i64, pcx: inout Ctx<Comp>) -> i64 {
    let saved = pcx.cur_mod;
    pcx.cur_mod = module_of(c, &pcx);
    let t = resolve_type_or_error(pcx.nodes[c].b, &pcx);
    pcx.cur_mod = saved;
    t
}

// Whether type t meets the constraints of bound node `bound` (a TyName
// whose `h` holds AssocType nodes, `Item = T`). (A type that does not
// implement the bound's trait meets them: that is the bound's error.)
pub fn assoc_constraints_hold(bound: i64, t: i64, pcx: inout Ctx<Comp>) -> bool {
    let tr = bound_trait(bound, &pcx);
    if tr < 0 || has_error_type(t, pcx) || !implements(tr, t, &pcx) {
        return true;
    }
    let holder = pcx.nodes[bound].h;
    for i in 0..pcx.nodes[holder].count {
        let c = child(holder, i, pcx);
        let want = constraint_type(c, &pcx);
        let got = trait_projection(tr, t, pcx.nodes[c].a, pcx.nodes[c].start, &pcx);
        if got != 0 && !has_error_type(got, pcx) && !has_error_type(want, pcx) && got != want {
            return false;
        }
    }
    true
}

// The error for the first constraint of `bound` type t does not meet:
// `'Small::Item' is 'u8', but the bound 'I: Iterator<Item = i64>' of 'f'
// requires 'i64'` (param: the parameter's name, what: the item's).
pub fn constraint_error(bound: i64, t: i64, param: i64, what: i64, pos: i64, pcx: inout Ctx<Comp>) -> ! {
    let tr = bound_trait(bound, &pcx);
    let holder = pcx.nodes[bound].h;
    var c = child(holder, 0, pcx);
    var want = 0;
    var got = 0;
    for i in 0..pcx.nodes[holder].count {
        c = child(holder, i, pcx);
        want = constraint_type(c, &pcx);
        got = trait_projection(tr, t, pcx.nodes[c].a, pcx.nodes[c].start, &pcx);
        if got != 0 && got != want {
            break;
        }
    }
    err_begin(pos, &pcx);
    err_str(c"'", pcx);
    err_type(t, pcx);
    err_fmt(format_args("::{}' is '", sym_text(pcx.nodes[c].a, pcx)), pcx);
    err_type(got, pcx);
    err_fmt(format_args("', but the bound '{}: {}<", sym_text(param, pcx),
        sym_text(pcx.traits[tr].name, pcx)), pcx);
    err_fmt(format_args("{} = ", sym_text(pcx.nodes[c].a, pcx)), pcx);
    err_type(want, pcx);
    err_fmt(format_args(">' of '{}' requires '", sym_text(what, pcx)), pcx);
    err_type(want, pcx);
    err_str(c"'", pcx);
    err_end(&pcx)
}

// (0.27.2.1) trait_projection, else through tr's supertraits (to
// MAX_ASSOC_DEPTH): `I: DoubleEndedIterator<Item = &T>` names Iterator's
// Item. RULE: F2.2, F11.2
pub fn super_projection(tr: i64, t: i64, name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let got = trait_projection(tr, t, name, pos, &pcx);
    if got != 0 || pcx.assoc_depth >= MAX_ASSOC_DEPTH {
        return got;
    }
    let supers = crate::front::traits::trait_supers(tr, pcx);
    if supers == 0 {
        return 0;
    }
    pcx.assoc_depth += 1;
    var r = 0;
    for i in 0..pcx.nodes[supers].count {
        let saved_mod = pcx.cur_mod;
        pcx.cur_mod = pcx.traits[tr].module;
        let s = bound_trait(child(supers, i, pcx), &pcx);
        pcx.cur_mod = saved_mod;
        if r == 0 && s >= 0 {
            r = super_projection(s, t, name, pos, &pcx);
        }
    }
    pcx.assoc_depth -= 1;
    r
}

// After the arguments (infer_from's last pass): the parameters the
// constraints of parameter k's bounds name, bound from bound[k]'s
// associated types (`I: Iterator<Item = T>` binds T to I's Item; a
// mismatch is left to check_bounds).
pub fn infer_from_assoc(params: i64, bound: *i64, tmod: i64, k: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let t = bound[k];
        let bounds = pcx.nodes[child(params, k, pcx)].h;
        if t == 0 || bounds == 0 || has_error_type(t, pcx) {
            return;
        }
        for i in 0..pcx.nodes[bounds].count {
            let b = child(bounds, i, pcx);
            if pcx.nodes[b].kind != NodeKind::TyName || pcx.nodes[b].h == 0 {
                continue;
            }
            let tr = bound_trait(b, &pcx);
            if tr < 0 {
                continue;
            }
            let holder = pcx.nodes[b].h;
            for j in 0..pcx.nodes[holder].count {
                let c = child(holder, j, pcx);
                let got = super_projection(tr, t, pcx.nodes[c].a, pcx.nodes[c].start, &pcx);
                if got != 0 {
                    unify(params, bound, tmod, pcx.nodes[c].b, got, &pcx);
                }
            }
        }
    }
}

// (0.27.2) After infer_from: the parameters a `where Self: Tr<X = P>`
// predicate of item (a trait's default method, `fn copied<'a, T>(self)
// where Self: Iterator<Item = &'a T>`) names, bound from self_ty's
// associated types (`v.iter().copied()` binds T to i64). RULE: F18.1
pub fn infer_from_where(item: i64, params: i64, bound: *i64, tmod: i64, self_ty: i64,
    pcx: inout Ctx<Comp>) {
    if self_ty == 0 || has_error_type(self_ty, pcx) {
        return;
    }
    let self_sym = intern_c(c"Self", &pcx);
    var next = crate::front::traits::wp_start(item, pcx);
    while next >= 0 {
        let k = next;
        next = crate::front::traits::wp_after(k, pcx);
        let subject = pcx.where_preds[k].subject;
        if pcx.nodes[subject].kind != NodeKind::TyName || pcx.nodes[subject].count != 0
            || pcx.nodes[subject].g != 0 || pcx.nodes[subject].a != self_sym {
            continue;
        }
        let bounds = pcx.where_preds[k].bounds;
        for i in 0..pcx.nodes[bounds].count {
            let b = child(bounds, i, pcx);
            if pcx.nodes[b].kind != NodeKind::TyName || pcx.nodes[b].h == 0 {
                continue;
            }
            let tr = bound_trait(b, &pcx);
            if tr < 0 {
                continue;
            }
            let holder = pcx.nodes[b].h;
            for j in 0..pcx.nodes[holder].count {
                let c = child(holder, j, pcx);
                let got = trait_projection(tr, self_ty, pcx.nodes[c].a, pcx.nodes[c].start, &pcx);
                if got != 0 {
                    let _ = unify(params, bound, tmod, pcx.nodes[c].b, got, &pcx);
                }
            }
        }
    }
}

// Function f (a FNS index) is used: if it is a lazy default (FN_LAZY), it
// is checked with the instances (queued once on INST_QUEUE). It keeps
// FN_LAZY: finish_program takes it from the queue, as an instance, and
// drops the lazy defaults never used from the items.
pub fn ensure_checked(f: i64, origin: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if f < 0 || (pcx.nodes[pcx.fns[f].node].p & FN_LAZY) == 0 {
            return;
        }
        while pcx.lazy_queued.count <= f {
            pcx.lazy_queued.push(0);
        }
        if pcx.lazy_queued.data[f] != 0 {
            return;
        }
        pcx.lazy_queued.data[f] = 1;
        crate::front::traits::own_default_body(pcx.fns[f].node, &pcx);
        // (an error in it notes where it was first used, as an instance)
        pcx.fns[f].origin = origin;
        pcx.fns[f].parent = pcx.cur_inst + 1;
        pcx.fns[f].depth = if pcx.cur_inst >= 0 { pcx.fns[pcx.cur_inst].depth + 1 } else { 1 };
        pcx.inst_queue.push(f);
    }
}

// std's functions that are not generic are lazy (0.15), as the trait
// defaults copied into impls: checked and emitted only when a program
// uses them (std grew by its formatting; a program pays for what it
// calls, at every level: -O0 emits what is checked).
pub fn lazy_std(program: i64, pcx: inout Ctx<Comp>) {
    // (0.17: not when std is read from its files to be edited: every
    // function is checked; front/stdtree.vl)
    if pcx.std_module < 0 || pcx.std_tree != 0 as *u8 {
        return;
    }
    for i in 0..pcx.nodes[program].count {
        let item = child(program, i, pcx);
        if pcx.nodes[item].kind == NodeKind::Fn && pcx.nodes[item].g == 0
            && within_std(module_of(item, &pcx), pcx)
            // (0.20: std's modules, not std::arch's virtual ones, 0.19's)
            && !is_within(module_of(item, &pcx), pcx.arch_module, pcx) {
            pcx.nodes[item].p |= FN_LAZY;
        }
    }
}
