// The end of std's source (0.16): the implementation of Gpa, the
// general-purpose allocator, and `std::CHECK_ALLOC`. Normally Gpa is C's
// malloc (compiler/std/gpa.vl); with --check-alloc, which sets
// CHECK_ALLOC_MODE, it is the checking allocator (compiler/std/
// alloc_check.vl, std_check_gpa_source), CHECK_ALLOC is true, and
// CHECK_ALLOC_OS gives the checking allocator its system (std_check_index
// is the index of this text).

use crate::base::buf_str;
use crate::front::stdsrc::{std_check_gpa_source, std_gpa_source, std_sys_source};
use crate::front::stdsrc_rust::{std2_check_gpa_source, std2_gpa_source, std2_sys_source};

// --check-alloc (0.16): std's checking Gpa.
pub static var CHECK_ALLOC_MODE: bool = false;
// With it: whether the target is Linux (the checking Gpa's system
// constants: CHECK_ALLOC_OS), set before std is loaded.
pub static var CHECK_ALLOC_LINUX: bool = false;

// Appends the end of std's source to out (stdsrc.vl's std_source).
pub fn std_alloc_tail(out: i64) {
    if CHECK_ALLOC_MODE {
        std_check_gpa_source(out);
        buf_str(out, c"pub const CHECK_ALLOC: bool = true;\n");
        // (one digit: std_check_index holds for every target)
        buf_str(out, if CHECK_ALLOC_LINUX { c"const CHECK_ALLOC_OS: i64 = 1;\n" }
            else { c"const CHECK_ALLOC_OS: i64 = 0;\n" });
    } else {
        std_gpa_source(out);
        buf_str(out, c"pub const CHECK_ALLOC: bool = false;\n");
    }
    // (0.20) then the target's system: sys/linux.vl or sys/macos.vl
    // (std::TARGET_OS and what differs between the C libraries)
    std_sys_source(out, CHECK_ALLOC_LINUX);
}

// (0.27.2) The end of std2's text (Z5): what the compiler's lowerings of
// a rust program name that std2 does not export, as `std::__rt`: the
// sinks of the format functions (F16.3), print's io::Write as a
// fmt::Write and panic's message on the stack; then Gpa's implementation,
// `std::__gpa`, and `std::CHECK_ALLOC`. Not for programs to name.
pub fn std2_tail(out: i64) {
    buf_str(out, c"// ---- the compiler's tail (front/stdalloc.vl: std2_tail) ----\n");
    buf_str(out, c"pub mod __rt {\n");
    buf_str(out, c"    use crate::fmt::Write;\n");
    buf_str(out, c"\n");
    // RULE: F16.4 (0.27.4: format_args's value, front/check/interp.vl: expand)
    buf_str(out, c"    // format_args's value: its holes' values, and a closure that writes the\n");
    buf_str(out, c"    // text through the Formatter it is given.\n");
    buf_str(out, c"    pub struct Interp<F> {\n");
    buf_str(out, c"        pub f: F,\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out,
        c"    impl<F: Fn(&mut crate::fmt::Formatter<'_>)> crate::fmt::Display for Interp<F> {\n");
    buf_str(out,
        c"        fn fmt(&self, out: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n");
    buf_str(out, c"            (self.f)(out);\n");
    buf_str(out, c"            crate::result::Result::Ok(())\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    // print's sink: an io::Write written as a fmt::Write.\n");
    buf_str(out, c"    pub struct IoOut<'a, W: crate::io::Write + ?Sized> {\n");
    buf_str(out, c"        inner: &'a mut W,\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    // (0.27.2.1: declared, contracts-effects.md E3.6)
    buf_str(out, c"    #[effects()]\n");
    buf_str(out,
        c"    pub fn io_out<'a, W: crate::io::Write + ?Sized>(w: &'a mut W) -> IoOut<'a, W> {\n");
    buf_str(out, c"        IoOut { inner: w }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    impl<'a, W: crate::io::Write + ?Sized> Write for IoOut<'a, W> {\n");
    buf_str(out, c"        fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n");
    buf_str(out, c"            match self.inner.write_all(s.as_bytes()) {\n");
    buf_str(out,
        c"                crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n");
    buf_str(out, c"                crate::result::Result::Err(_) => crate::result::Result::Err(crate::fmt::Error {}),\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    // RULE: F16.3 (0.27.3: `write(w, ..)` on an io::Write, Rust's
    // io::Write::write_fmt: the first io error kept, the value io::Result)
    buf_str(out, c"    // write's sink on an io::Write: the first io error kept for finish.\n");
    buf_str(out, c"    pub struct IoFmt<'a, W: crate::io::Write + ?Sized> {\n");
    buf_str(out, c"        inner: &'a mut W,\n");
    buf_str(out, c"        error: crate::option::Option<crate::io::Error>,\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    #[effects()]\n");
    buf_str(out,
        c"    pub fn io_fmt<'a, W: crate::io::Write + ?Sized>(w: &'a mut W) -> IoFmt<'a, W> {\n");
    buf_str(out, c"        IoFmt { inner: w, error: crate::option::Option::None }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    impl<'a, W: crate::io::Write + ?Sized> IoFmt<'a, W> {\n");
    buf_str(out, c"        #[effects()]\n");
    buf_str(out,
        c"        pub fn finish(self, r: crate::fmt::Result) -> crate::io::Result<()> {\n");
    buf_str(out, c"            match r {\n");
    buf_str(out,
        c"                crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n");
    buf_str(out, c"                crate::result::Result::Err(_) => match self.error {\n");
    buf_str(out,
        c"                    crate::option::Option::Some(e) => crate::result::Result::Err(e),\n");
    buf_str(out, c"                    crate::option::Option::None => crate::result::Result::Err(crate::io::Error::other(\"formatter error\")),\n");
    buf_str(out, c"                },\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    impl<'a, W: crate::io::Write + ?Sized> Write for IoFmt<'a, W> {\n");
    buf_str(out, c"        fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n");
    buf_str(out, c"            match self.inner.write_all(s.as_bytes()) {\n");
    buf_str(out,
        c"                crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n");
    buf_str(out, c"                crate::result::Result::Err(e) => {\n");
    buf_str(out, c"                    if self.error.is_none() {\n");
    buf_str(out, c"                        self.error = crate::option::Option::Some(e);\n");
    buf_str(out, c"                    }\n");
    buf_str(out, c"                    crate::result::Result::Err(crate::fmt::Error {})\n");
    buf_str(out, c"                }\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    // panic's message with holes, written into 256 bytes on the stack and\n");
    buf_str(out, c"    // cut at a character there (MVS's __panic_fmt, decision 5).\n");
    buf_str(out, c"    pub struct PanicOut {\n");
    buf_str(out, c"        buf: [u8; 256],\n");
    buf_str(out, c"        len: usize,\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    impl PanicOut {\n");
    buf_str(out, c"        #[effects()]\n");
    buf_str(out, c"        pub fn new() -> PanicOut {\n");
    buf_str(out, c"            PanicOut { buf: [0; 256], len: 0 }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"\n");
    buf_str(out, c"        #[effects(io, panic, diverge)]\n");
    buf_str(out, c"        pub fn panic(&self) -> ! {\n");
    buf_str(out, c"            match crate::str::from_utf8(&self.buf[..self.len]) {\n");
    buf_str(out, c"                crate::result::Result::Ok(s) => crate::panic::panic(s),\n");
    buf_str(out, c"                crate::result::Result::Err(_) => crate::panic::panic(\"(a message that is not UTF-8)\"),\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"\n");
    buf_str(out, c"    impl Write for PanicOut {\n");
    buf_str(out, c"        fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n");
    buf_str(out, c"            let mut n = s.len();\n");
    buf_str(out, c"            if n > 256 - self.len {\n");
    buf_str(out, c"                n = 256 - self.len;\n");
    buf_str(out, c"                while n > 0 && !s.is_char_boundary(n) {\n");
    buf_str(out, c"                    n -= 1;\n");
    buf_str(out, c"                }\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            let b = s.as_bytes();\n");
    buf_str(out, c"            let mut i: usize = 0;\n");
    buf_str(out, c"            while i < n {\n");
    buf_str(out, c"                self.buf[self.len + i] = b[i];\n");
    buf_str(out, c"                i += 1;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            self.len += n;\n");
    buf_str(out, c"            crate::result::Result::Ok(())\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"\n");
    // RULE: Z5.1 Gpa's implementation as std::__gpa (alloc.vl's Gpa calls
    // it): C's malloc (std2/rt/gpa.vl), or with --check-alloc the checking
    // allocator (std2/rt/alloc_check.vl), its system's constants and the
    // static the program stores its allocating calls' sites in
    // (middle/checkalloc.vl: std.CHECK_ALLOC_SITE)
    if CHECK_ALLOC_MODE {
        buf_str(out, c"pub const CHECK_ALLOC: bool = true;\n");
        buf_str(out, c"pub static mut CHECK_ALLOC_SITE: *const u8 = 0 as *const u8;\n");
        buf_str(out, c"pub mod __gpa {\n");
        buf_str(out, if CHECK_ALLOC_LINUX { c"const CHECK_ALLOC_OS: i64 = 1;\n" }
            else { c"const CHECK_ALLOC_OS: i64 = 0;\n" });
        std2_check_gpa_source(out);
    } else {
        buf_str(out, c"pub const CHECK_ALLOC: bool = false;\n");
        buf_str(out, c"pub mod __gpa {\n");
        std2_gpa_source(out);
    }
    buf_str(out, c"}\n");
    // (0.27.2.1) the target's system, std2/rt/sys_macos.vl or sys_linux.vl
    // (std::env's argv)
    buf_str(out, c"pub mod __sys {\n");
    std2_sys_source(out, CHECK_ALLOC_LINUX);
    buf_str(out, c"}\n");
}
