// The support of `?` and `fn main() -> Result<(), E>` (0.15): std's
// Option and Result recognized, their variant patterns made, and main's
// body wrapped (main_result_wrapper). Part of front/convert.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_help, err_str};
use crate::front::ast::{
    ARM_SYNTHETIC, CLOSURE_MOVE, FN_SIG_FAILED, NodeKind, list_begin, list_end, list_push, new_node,
};
use crate::front::check::has_error_type;
use crate::front::lexer::SUF_NONE;
use crate::front::modules::within_std;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{ENUMS, TLISTS, TYPES, TY_I32, TY_UNIT, TyKind, buf_type, err_type};

// The name of std's generic enum (Option, Result) that t is an instance
// of, or 0; its type arguments in *targs (a TLISTS index).
pub fn std_enum_name(t: i64, targs: inout i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.std_module < 0 || t <= 0 || TYPES[t].kind != TyKind::Enum {
            return 0;
        }
        let e = TYPES[t].a;
        if ENUMS[e].tmpl == 0 {
            return 0;
        }
        let tmpl = ENUMS[e].tmpl - 1;
        if !within_std(ENUMS[tmpl].module, pcx) {
            return 0;
        }
        targs = ENUMS[e].targs;
        ENUMS[tmpl].name
    }
}

// A PatVariant `std::Enum::Variant(p)` (p a node; 0: `std::Enum::Variant`).
pub fn std_variant_pattern(enum_name: *u8, variant: *u8, p: i64, start: i64, end: i64,
    pcx: inout Ctx<Comp>) -> i64 {
    let pat = new_node(NodeKind::PatVariant, start, end, &pcx);
    let std_seg = new_node(NodeKind::Ident, start, end, &pcx);
    pcx.nodes[std_seg].a = intern_c(c"std");
    let prefix = new_node(NodeKind::Path, start, end, &pcx);
    let pmark = list_begin(pcx);
    list_push(std_seg, &pcx);
    list_end(prefix, pmark, &pcx);
    pcx.nodes[pat].h = prefix;
    pcx.nodes[pat].a = intern_c(enum_name);
    pcx.nodes[pat].b = intern_c(variant);
    pcx.nodes[pat].c = (p != 0) as i64;
    let mark = list_begin(pcx);
    if p != 0 {
        list_push(p, &pcx);
    }
    list_end(pat, mark, &pcx);
    pat
}

// `fn main() -> Result<(), E>` (called once the signatures are resolved):
// its body becomes
//     match (move || -> Result<(), E> { body })() {
//         std::Result::Ok(_) => 0,
//         std::Result::Err(e) => std::main_error(e),
//     }
// and it returns i32: on Err, `Error: {e:?}` on stderr and exit status 1.
pub fn main_result_wrapper(pcx: inout Ctx<Comp>) {
    unsafe {
        let main = intern_c(c"main");
        for f in 0..pcx.fn_count {
            let node = pcx.fns[f].node;
            if pcx.fns[f].name != main || pcx.nodes[node].kind != NodeKind::Fn
                || pcx.nodes[node].d != 0 || pcx.nodes[node].h != 0
                || (pcx.nodes[node].p & FN_SIG_FAILED) != 0
                || pcx.fns[f].generic != 0 || pcx.fns[f].tmpl != 0 {
                continue;
            }
            var targs = 0;
            let r = pcx.fns[f].ret;
            if r <= 0 || has_error_type(r, pcx)
                || std_enum_name(r, &targs, pcx) != intern_c(c"Result") {
                continue;
            }
            let ok = TLISTS.data[targs];
            let e = TLISTS.data[targs + 1];
            if ok != TY_UNIT {
                err_begin(pcx.nodes[pcx.nodes[node].b].start, &pcx);
                err_str(c"'main' returning a Result returns 'Result<(), E>', not '", pcx);
                err_type(r, pcx);
                err_str(c"'", pcx);
                err_help(c"return the value some other way, and 'Ok(())'", pcx);
                err_end_soft(&pcx);
                continue;
            }
            let debug = std_trait(c"Debug", &pcx);
            if debug >= 0 && !has_error_type(e, pcx) && !implements(debug, e, &pcx) {
                err_begin(pcx.nodes[pcx.nodes[node].b].start, &pcx);
                err_str(c"'main' returns 'Result<(), ", pcx);
                err_type(e, pcx);
                err_str(c">', and '", pcx);
                err_type(e, pcx);
                err_str(c"' has no Debug, to print the error with", pcx);
                // (0.25: derive only on the program's own types)
                let k = TYPES[e].kind;
                let own_type = (k == TyKind::Struct
                    && !within_std(pcx.structs[TYPES[e].a].module, pcx))
                    || (k == TyKind::Enum && ENUMS[TYPES[e].a].tmpl == 0
                        && !within_std(ENUMS[TYPES[e].a].module, pcx));
                if own_type {
                    err_help(c"derive it: '#[derive(Debug)]' before the type, or 'impl Debug for ",
                        pcx);
                    buf_type(pcx.err_help, e, pcx);
                    err_help(c" { fn fmt_debug(self, f: inout std::Fmt) { ... } }'", pcx);
                } else {
                    err_help(c"turn the error into a type that has Debug ('.map_err(|e| ...)' where it is made), or handle it in main and return 'Ok(())'", pcx);
                }
                err_end_soft(&pcx);
                continue;
            }
            let body = pcx.nodes[node].c;
            let (start, end) = (pcx.nodes[body].start, pcx.nodes[body].end);
            let closure = new_node(NodeKind::Closure, start, end, &pcx);
            pcx.nodes[closure].a = body;
            pcx.nodes[closure].b = pcx.nodes[node].b;
            pcx.nodes[closure].c = CLOSURE_MOVE;
            pcx.main_closure = closure;
            let empty = list_begin(pcx);
            list_end(closure, empty, &pcx);
            let call = new_node(NodeKind::Call, start, end, &pcx);
            pcx.nodes[call].a = closure;
            let none = list_begin(pcx);
            list_end(call, none, &pcx);
            let zero = new_node(NodeKind::Int, start, end, &pcx);
            pcx.nodes[zero].b = SUF_NONE;
            let ok_arm = new_node(NodeKind::Arm, start, end, &pcx);
            pcx.nodes[ok_arm].a = std_variant_pattern(c"Result", c"Ok",
                new_node(NodeKind::PatWild, start, end, &pcx), start, end, &pcx);
            pcx.nodes[ok_arm].c = zero;
            let sym = intern_c(c"?error");
            let bind = new_node(NodeKind::PatBind, start, end, &pcx);
            pcx.nodes[bind].a = sym;
            let value = new_node(NodeKind::Ident, start, end, &pcx);
            pcx.nodes[value].a = sym;
            let report = new_node(NodeKind::Path, start, end, &pcx);
            pcx.nodes[report].a = intern_c(c"std");
            pcx.nodes[report].b = intern_c(c"main_error");
            let report_call = new_node(NodeKind::Call, start, end, &pcx);
            pcx.nodes[report_call].a = report;
            let rmark = list_begin(pcx);
            list_push(value, &pcx);
            list_end(report_call, rmark, &pcx);
            let err_arm = new_node(NodeKind::Arm, start, end, &pcx);
            pcx.nodes[err_arm].a = std_variant_pattern(c"Result", c"Err", bind, start, end, &pcx);
            pcx.nodes[err_arm].c = report_call;
            pcx.nodes[err_arm].p = ARM_SYNTHETIC;
            let m = new_node(NodeKind::Match, start, end, &pcx);
            pcx.nodes[m].a = call;
            let amark = list_begin(pcx);
            list_push(ok_arm, &pcx);
            list_push(err_arm, &pcx);
            list_end(m, amark, &pcx);
            let block = new_node(NodeKind::Block, start, end, &pcx);
            pcx.nodes[block].a = m;
            let bmark = list_begin(pcx);
            list_end(block, bmark, &pcx);
            pcx.nodes[node].c = block;
            pcx.fns[f].ret = TY_I32;
        }
    }
}
