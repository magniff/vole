// The support of `?` and `fn main() -> Result<(), E>` (0.15): std's
// Option and Result recognized, their variant patterns made, and main's
// body wrapped (main_result_wrapper). Part of front/convert.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_help, err_str};
use crate::front::ast::{
    ARM_SYNTHETIC, CLOSURE_MOVE, FN_SIG_FAILED, NodeKind, list_begin, list_end, list_push, new_node,
};
use crate::front::check::has_error_type;
use crate::front::lexer::SUF_NONE;
use crate::front::modules::within_std;
use crate::front::traits::{implements, std_trait};
use crate::front::types::{TY_I32, TY_UNIT, TyKind, buf_type, err_type, get_enums};

// The name of std's generic enum (Option, Result) that t is an instance
// of, or 0; its type arguments in *targs (a TLISTS index).
pub fn std_enum_name(t: i64, targs: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.std_module < 0 || t <= 0 || pcx.types[t as usize].kind != TyKind::Enum {
            return 0;
        }
        let e = pcx.types[t as usize].a;
        if (*get_enums().add(e as usize)).tmpl == 0 {
            return 0;
        }
        let tmpl = (*get_enums().add(e as usize)).tmpl - 1;
        if !within_std((*get_enums().add(tmpl as usize)).module, pcx) {
            return 0;
        }
        *targs = (*get_enums().add(e as usize)).targs;
        (*get_enums().add(tmpl as usize)).name
    }
}

// A PatVariant `std::Enum::Variant(p)` (p a node; 0: `std::Enum::Variant`).
pub fn std_variant_pattern(enum_name: *mut u8, variant: *mut u8, p: i64, start: i64, end: i64,
    pcx: &mut Ctx<Comp>) -> i64 {
    let pat = new_node(NodeKind::PatVariant, start, end, pcx);
    let std_seg = new_node(NodeKind::Ident, start, end, pcx);
    pcx.nodes[std_seg as usize].a = intern_c(c"std", pcx);
    let prefix = new_node(NodeKind::Path, start, end, pcx);
    let pmark = list_begin(pcx);
    list_push(std_seg, pcx);
    // RULE: Z3.1 (0.27.2: std2 keeps them in its modules: `std::result::Result`)
    if crate::front::known::on_std2(pcx) {
        let module = crate::front::known::std2_module(crate::base::cstr(enum_name));
        if module.len() > 0 {
            let seg = new_node(NodeKind::Ident, start, end, pcx);
            pcx.nodes[seg as usize].a = crate::base::intern(module, pcx);
            list_push(seg, pcx);
        }
    }
    list_end(prefix, pmark, pcx);
    pcx.nodes[pat as usize].h = prefix;
    pcx.nodes[pat as usize].a = intern_c(enum_name, pcx);
    pcx.nodes[pat as usize].b = intern_c(variant, pcx);
    pcx.nodes[pat as usize].c = (p != 0) as i64;
    let mark = list_begin(pcx);
    if p != 0 {
        list_push(p, pcx);
    }
    list_end(pat, mark, pcx);
    pat
}

// `fn main() -> Result<(), E>` (called once the signatures are resolved):
// its body becomes
//     match (move || -> Result<(), E> { body })() {
//         std::Result::Ok(_) => 0,
//         std::Result::Err(e) => std::main_error(e),
//     }
// and it returns i32: on Err, `Error: {e:?}` on stderr and exit status 1.
pub fn main_result_wrapper(pcx: &mut Ctx<Comp>) {
    unsafe {
        let main = intern_c(c"main", pcx);
        for f in 0..pcx.fns.len() as i64 {
            let node = pcx.fns[f as usize].node;
            if pcx.fns[f as usize].name != main || pcx.nodes[node as usize].kind != NodeKind::Fn
                || pcx.nodes[node as usize].d != 0 || pcx.nodes[node as usize].h != 0
                || (pcx.nodes[node as usize].p & FN_SIG_FAILED) != 0
                || pcx.fns[f as usize].generic != 0 || pcx.fns[f as usize].tmpl != 0 {
                continue;
            }
            let mut targs: i64 = 0;
            let r = pcx.fns[f as usize].ret;
            if r <= 0 || has_error_type(r, pcx)
                || std_enum_name(r, &mut targs, pcx) != intern_c(c"Result", pcx) {
                continue;
            }
            let ok = (pcx.tlists[targs as usize]);
            let e = (pcx.tlists[(targs + 1) as usize]);
            if ok != TY_UNIT {
                err_begin(pcx.nodes[pcx.nodes[node as usize].b as usize].start, pcx);
                err_str(c"'main' returning a Result returns 'Result<(), E>', not '", pcx);
                err_type(r, pcx);
                err_str(c"'", pcx);
                err_help(c"return the value some other way, and 'Ok(())'", pcx);
                err_end_soft(pcx);
                continue;
            }
            let debug = std_trait(c"Debug", pcx);
            if debug >= 0 && !has_error_type(e, pcx) && !implements(debug, e, pcx) {
                err_begin(pcx.nodes[pcx.nodes[node as usize].b as usize].start, pcx);
                err_str(c"'main' returns 'Result<(), ", pcx);
                err_type(e, pcx);
                err_str(c">', and '", pcx);
                err_type(e, pcx);
                err_str(c"' has no Debug, to print the error with", pcx);
                // (0.25: derive only on the program's own types)
                let k = pcx.types[e as usize].kind;
                let own_type = (k == TyKind::Struct
                    && !within_std(pcx.structs[pcx.types[e as usize].a as usize].module, pcx))
                    || (k == TyKind::Enum
                        && (*get_enums().add(pcx.types[e as usize].a as usize)).tmpl == 0
                        && !within_std((*get_enums().add(pcx.types[e as usize].a as usize)).module,
                            pcx));
                if own_type {
                    err_help(c"derive it: '#[derive(Debug)]' before the type, or 'impl Debug for ",
                        pcx);
                    buf_type(pcx.err_help, e, pcx);
                    err_help(c" { fn fmt_debug(self, f: inout std::Fmt) { ... } }'", pcx);
                } else {
                    err_help(c"turn the error into a type that has Debug ('.map_err(|e| ...)' where it is made), or handle it in main and return 'Ok(())'", pcx);
                }
                err_end_soft(pcx);
                continue;
            }
            let body = pcx.nodes[node as usize].c;
            let (start, end) = (pcx.nodes[body as usize].start, pcx.nodes[body as usize].end);
            let closure = new_node(NodeKind::Closure, start, end, pcx);
            pcx.nodes[closure as usize].a = body;
            pcx.nodes[closure as usize].b = pcx.nodes[node as usize].b;
            pcx.nodes[closure as usize].c = CLOSURE_MOVE;
            pcx.main_closure = closure;
            let empty = list_begin(pcx);
            list_end(closure, empty, pcx);
            let call = new_node(NodeKind::Call, start, end, pcx);
            pcx.nodes[call as usize].a = closure;
            let none = list_begin(pcx);
            list_end(call, none, pcx);
            let zero = new_node(NodeKind::Int, start, end, pcx);
            pcx.nodes[zero as usize].b = SUF_NONE;
            let ok_arm = new_node(NodeKind::Arm, start, end, pcx);
            pcx.nodes[ok_arm as usize].a = std_variant_pattern(c"Result", c"Ok",
                new_node(NodeKind::PatWild, start, end, pcx), start, end, pcx);
            pcx.nodes[ok_arm as usize].c = zero;
            let sym = intern_c(c"?error", pcx);
            let bind = new_node(NodeKind::PatBind, start, end, pcx);
            pcx.nodes[bind as usize].a = sym;
            let value = new_node(NodeKind::Ident, start, end, pcx);
            pcx.nodes[value as usize].a = sym;
            let report = new_node(NodeKind::Path, start, end, pcx);
            pcx.nodes[report as usize].a = intern_c(c"std", pcx);
            pcx.nodes[report as usize].b = intern_c(c"main_error", pcx);
            let report_call = new_node(NodeKind::Call, start, end, pcx);
            pcx.nodes[report_call as usize].a = report;
            let rmark = list_begin(pcx);
            list_push(value, pcx);
            list_end(report_call, rmark, pcx);
            let err_arm = new_node(NodeKind::Arm, start, end, pcx);
            pcx.nodes[err_arm as usize].a = std_variant_pattern(c"Result", c"Err", bind, start, end,
                pcx);
            pcx.nodes[err_arm as usize].c = report_call;
            pcx.nodes[err_arm as usize].p = ARM_SYNTHETIC;
            let m = new_node(NodeKind::Match, start, end, pcx);
            pcx.nodes[m as usize].a = call;
            let amark = list_begin(pcx);
            list_push(ok_arm, pcx);
            list_push(err_arm, pcx);
            list_end(m, amark, pcx);
            let block = new_node(NodeKind::Block, start, end, pcx);
            pcx.nodes[block as usize].a = m;
            let bmark = list_begin(pcx);
            list_end(block, bmark, pcx);
            pcx.nodes[node as usize].c = block;
            pcx.fns[f as usize].ret = TY_I32;
        }
    }
}
