// Generic traits and conversions (0.15; docs/design/errors-formatting.md):
// traits with type parameters (`trait From<T>`), impls of them for
// several arguments (`impl From<IoError> for AppError`), bounds with
// arguments (`T: From<U>`), calls resolved among a type's generic-trait
// impls by the arguments' types (`AppError::from(e)`, `x.into()`), the
// intrinsic From of widening and Into, the conversion of `?`'s error, and
// `fn main() -> Result<(), E>`.
//
// The functions of a generic trait's impls are not in METHODS (two impls
// of From for one type both define `from`): collect_method gives each a
// symbol of its own (`T.from.N`, N the impl), and a call that finds no
// ordinary function asks generic_trait_call, which picks the impl whose
// function takes the arguments' types.

mod try_main;

use crate::base::{buf_bytes, buf_fmt, buf_new, buf_str, intern_buf, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_fmt, err_help, err_help_fmt, err_help_sym, err_int, err_str, err_sym,
};
use crate::front::assoc::{ensure_checked, trait_projection};
use crate::front::ast::{FN_SIG_FAILED, NodeKind, child, list_begin, list_end, list_push, new_node};
use crate::front::check::{Res, has_error_type, resolve_type_or_error};
use crate::front::check::calls::{method_of, synthetic_unary};
use crate::front::check::calls::paths::check_direct_call;
use crate::front::check::check_mode::check_expr;
use crate::front::check::resolve::resolve_type;
use crate::front::check::synth_mode::synth_expr;
use crate::front::check::unsafety::{U_METHOD, check_call_safety, is_borrow, unsafe_through};
use crate::front::check::widen::widens;
use crate::front::generics::{
    TPL_NONE, check_call_arg, env_enter, env_leave, hint_for, instance_of, mark_synthed,
    template_name,
};
use crate::front::generics::instantiate::instantiate_call;
use crate::front::lexer::{SUF_NONE, Tok};
use crate::front::modules::module_of;
use crate::front::traits::{bound_trait, implements, std_trait, trait_fn};
use crate::front::types::{
    REF_MUT, TY_NEVER, TyKind, buf_type, enum_variant, err_type, fn_param, is_float, is_integer,
    is_pointer, primitive_name, type_elem, variant_field,
};
use crate::middle::lower::ssa::HMap;

pub use try_main::{main_result_wrapper, std_enum_name, std_variant_pattern};

// ---- Generic traits ----

// The number of type parameters of trait tr (0: not generic).
pub fn trait_param_count(tr: i64, pcx: &Ctx<Comp>) -> i64 {
    if tr < 0 || pcx.traits[tr as usize].params == 0 {
        return 0;
    }
    pcx.nodes[pcx.traits[tr as usize].params as usize].count
}

// The type parameters of trait tr (a TRAITS index; called by add_trait,
// in the names phase): TraitInfo.params. A generic trait's functions have
// no default body (the default would be checked per argument).
pub fn collect_trait_params(tr: i64, pcx: &mut Ctx<Comp>) {
    let node = pcx.traits[tr as usize].node;
    pcx.traits[tr as usize].params = pcx.nodes[node as usize].g;
    if pcx.nodes[node as usize].g == 0 {
        return;
    }
    for i in 0..pcx.nodes[node as usize].count {
        let decl = child(node, i, pcx);
        // (0.27.2: the rust edition's generic traits have defaults, F12.1)
    }
}

// Type nodes `g` (a Generics holder) resolved in module m under the
// current environment, pushed to TLISTS: its index.
fn resolve_args(g: i64, m: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved = pcx.cur_mod;
    pcx.cur_mod = m;
    let mark = pcx.tscratch.len() as i64;
    for i in 0..pcx.nodes[g as usize].count {
        let t = resolve_type(child(g, i, pcx), pcx);
        pcx.tscratch.push(t);
    }
    pcx.cur_mod = saved;
    let targs = pcx.tlists.len() as i64;
    for i in mark..pcx.tscratch.len() as i64 {
        pcx.tlists.push((pcx.tscratch[i as usize]));
    }
    pcx.tscratch.truncate(mark as usize);
    targs
}

// One type as a TLISTS list.
pub fn list_of(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let at = pcx.tlists.len() as i64;
    pcx.tlists.push(t);
    at
}

// (0.27.0) In the rust edition, the trait arguments `written` (a Generics
// node, or 0) of an impl's trait name, of trait tr, with the defaults of
// the parameters it leaves out (`impl PartialEq for P`, `trait
// PartialEq<Rhs = Self>`): a new Generics node, `Self` the impl's type
// node self_node; 0 when one left out has no default.
fn default_trait_args(tr: i64, written: i64, self_node: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let params = pcx.traits[tr as usize].params;
    let got: i64 = if written == 0 { 0 } else { pcx.nodes[written as usize].count };
    for j in got..pcx.nodes[params as usize].count {
        if pcx.nodes[child(params, j, pcx) as usize].b == 0 {
            return 0;
        }
    }
    let n = new_node(NodeKind::Generics, pos, pos, pcx);
    let mark = list_begin(pcx);
    for j in 0..got {
        list_push(child(written, j, pcx), pcx);
    }
    for j in got..pcx.nodes[params as usize].count {
        let d = pcx.nodes[child(params, j, pcx) as usize].b;
        let is_self = pcx.nodes[d as usize].kind == NodeKind::TyName
            && pcx.nodes[d as usize].list == 0 && pcx.nodes[d as usize].g == 0
            && sym_text(pcx.nodes[d as usize].a, pcx) == b"Self";
        list_push(if is_self { self_node } else { d }, pcx);
    }
    list_end(n, mark, pcx);
    n
}

// The trait arguments of impl i (an IMPLS index; called by collect_impl
// before its coherence check): ImplInfo.targs, resolved in the impl's
// module; -1 for a generic impl (`impl<T> From<T> for W<T>`: resolved for
// each instance, impl_targs) or when they failed.
pub fn impl_trait_args(i: i64, pcx: &mut Ctx<Comp>) {
    let tr = pcx.traits_impls[i as usize].tr;
    let tname = pcx.nodes[pcx.traits_impls[i as usize].node as usize].a;
    let mut written = pcx.nodes[tname as usize].g;
    let count = trait_param_count(tr, pcx);
    if count == 0 {
        if written != 0 {
            err_begin(pcx.nodes[tname as usize].start, pcx);
            err_fmt(format_args("trait '{}' takes no type arguments",
                str::from_utf8(sym_text(pcx.traits[tr as usize].name, pcx)).unwrap()), pcx);
            err_end(pcx);
        }
        return;
    }
    pcx.traits_impls[i as usize].targs = -1;
    let mut got: i64 = if written == 0 { 0 } else { pcx.nodes[written as usize].count };
    if got < count {
        let impl_node = pcx.traits_impls[i as usize].node;
        let filled = default_trait_args(tr, written, pcx.nodes[impl_node as usize].b,
            pcx.nodes[tname as usize].end, pcx);
        if filled != 0 {
            pcx.nodes[tname as usize].g = filled;
            written = filled;
            got = count;
        }
    }
    if got != count {
        err_begin(pcx.nodes[tname as usize].start, pcx);
        err_fmt(format_args("trait '{}' takes ",
            str::from_utf8(sym_text(pcx.traits[tr as usize].name, pcx)).unwrap()), pcx);
        err_int_words(count, c" type argument", c" type arguments", pcx);
        err_fmt(format_args(", got {got}"), pcx);
        err_help_fmt(format_args("write them: '{}<T>'",
            str::from_utf8(sym_text(pcx.traits[tr as usize].name, pcx)).unwrap()),
            pcx);
        err_end(pcx);
    }
    let into = std_trait(c"Into", pcx);
    // RULE: Z3.1 (0.27.2: std2's Into is Rust's, with its blanket impl
    // over From: an impl of it is an impl)
    if tr == into && !(crate::front::known::on_std2(pcx)) {
        err_begin(pcx.nodes[tname as usize].start, pcx);
        err_str(
            c"Into is not implemented directly: it holds exactly when From does the other way",
            pcx);
        err_help(c"implement From instead: 'impl From<", pcx);
        buf_type(pcx.err_help, pcx.traits_impls[i as usize].ty, pcx);
        err_help(c"> for U { fn from(x: ", pcx);
        buf_type(pcx.err_help, pcx.traits_impls[i as usize].ty, pcx);
        err_help(c") -> U { ... } }' gives 'let u: U = x.into();'", pcx);
        err_end(pcx);
    }
    if pcx.traits_impls[i as usize].tpl != TPL_NONE {
        return;
    }
    pcx.traits_impls[i as usize].targs = resolve_args(written,
        pcx.traits_impls[i as usize].module, pcx);
    let from = std_trait(c"From", pcx);
    if tr == from
        && (pcx.tlists[pcx.traits_impls[i as usize].targs as usize])
        == pcx.traits_impls[i as usize].ty {
        err_begin(pcx.nodes[tname as usize].start, pcx);
        err_str(c"every type converts from itself already: 'impl From<", pcx);
        err_type(pcx.traits_impls[i as usize].ty, pcx);
        err_str(c"> for ", pcx);
        err_type(pcx.traits_impls[i as usize].ty, pcx);
        err_str(c"' conflicts with it", pcx);
        err_end(pcx);
    }
}

fn err_int_words(n: i64, one: *const u8, many: *const u8, pcx: &Ctx<Comp>) {
    err_int(n, pcx);
    err_str(if n == 1 { one } else { many }, pcx);
}

// Whether impls j and i (of the same generic trait, for overlapping
// types) have the same trait arguments: a conflict. Unknown (a generic
// impl's, resolved per instance) is no conflict here: a call they both
// fit is reported as ambiguous.
pub fn same_trait_args(j: i64, i: i64, pcx: &Ctx<Comp>) -> bool {
    let count = trait_param_count(pcx.traits_impls[i as usize].tr, pcx);
    if count == 0 {
        return true;
    }
    let a = pcx.traits_impls[j as usize].targs;
    let b = pcx.traits_impls[i as usize].targs;
    if a < 0 || b < 0 {
        return false;
    }
    same_list(a, b, count, pcx)
}

pub fn same_list(a: i64, b: i64, count: i64, pcx: &Ctx<Comp>) -> bool {
    for k in 0..count {
        if (pcx.tlists[(a + k) as usize])
            != (pcx.tlists[(b + k) as usize]) {
            return false;
        }
    }
    true
}

// The impl a function belongs to when that impl is of a generic trait
// (its functions are found by generic_trait_call, not by name); -1
// otherwise.
pub fn generic_trait_impl(i: i64, pcx: &Ctx<Comp>) -> i64 {
    if i < 0 || trait_param_count(pcx.traits_impls[i as usize].tr, pcx) == 0 {
        return -1;
    }
    i
}

// The symbol of function `sym` of generic-trait impl i: `T.from.N`.
pub fn impl_fn_symbol(sym: i64, i: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    // An inherent method has no impl (i = -1): `T.m.n1`, since a `-` is
    // not a symbol character to an assembler.
    if i
        < 0 {
        buf_fmt(out, format_args("{}.n{}", str::from_utf8(sym_text(sym, pcx)).unwrap(), -i));
    }
    else { buf_fmt(out, format_args("{}.{i}", str::from_utf8(sym_text(sym, pcx)).unwrap())); }
    intern_buf(out, pcx)
}

// Whether impl i is for type t (for a generic impl: t is an instance of
// its type, and the arguments satisfy the impl's bounds).
fn impl_covers(i: i64, t: i64, pcx: &mut Ctx<Comp>) -> bool {
    // RULE: F0.3 (0.27.2: through impl_applies, a pattern impl too)
    crate::front::traits::impl_applies(i, t, pcx) >= 0
}

// The trait arguments of impl i for type t (which it covers): a TLISTS
// index, -1 when unknown.
pub fn impl_targs(i: i64, t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.traits_impls[i as usize].tpl == TPL_NONE {
        return pcx.traits_impls[i as usize].targs;
    }
    let params = pcx.nodes[pcx.traits_impls[i as usize].node as usize].g;
    // (0.27.2: a pattern impl's bindings; one its header leaves unbound
    // is unknown here: takes completes it from the arguments, F14.1)
    let b = crate::front::traits::impl_bindings(i, t, pcx);
    if b < 0 {
        return -1;
    }
    for k in 0..pcx.nodes[params as usize].count {
        if ((pcx.tlists[(b + k) as usize])) == 0 {
            return -1;
        }
    }
    let saved = env_enter(params, b, pcx.nodes[params as usize].count, pcx);
    let r = resolve_args(
        pcx.nodes[pcx.nodes[pcx.traits_impls[i as usize].node as usize].a as usize].g,
        pcx.traits_impls[i as usize].module, pcx);
    env_leave(saved, pcx);
    r
}

// (0.27.2) impl_targs for a pattern impl whose header leaves a parameter
// unbound (`impl<T> SliceIndex<[T]> for usize`): the parameters are
// completed from the arguments of call n (types tys[..], 0 for a
// literal; `skip` 1 for a method call) against the declared parameter
// types of the impl's function f, then the trait arguments resolved; -1
// when a parameter stays unbound. RULE: F14.1
pub fn complete_impl_targs(i: i64, f: i64, n: i64, tys: &mut [i64], skip: i64,
    pcx: &mut Ctx<Comp>) -> i64 {
    let node = pcx.traits_impls[i as usize].node;
    let params = pcx.nodes[node as usize].g;
    // (a template impl with parameters its type does not fix, `impl<T:
    // PartialEq<U>, U> PartialEq<[U]> for [T]`, too)
    if pcx.traits_impls[i as usize].tpl == TPL_NONE {
        return -1;
    }
    let count = pcx.nodes[params as usize].count;
    let b = crate::front::traits::impl_bindings(i, pcx.self_type, pcx);
    let mut bound_room: Vec<i64, Comp> = Vec::new_in(Comp {});
    bound_room.resize((count) as usize, 0);
    let bound = bound_room.as_mut_slice();
    for k in 0..count {
        (bound[k as usize]) = if b >= 0 { (pcx.tlists[(b + k) as usize]) }
            else { 0 };
    }
    let item = pcx.fns[f as usize].node;
    let tmod = pcx.fns[f as usize].module;
    for k in 0..pcx.nodes[n as usize].count {
        if k + skip < pcx.nodes[item as usize].count && (tys[k as usize]) != 0 {
            crate::front::generics::instantiate::unify(params, bound, tmod,
                pcx.nodes[child(item, k + skip, pcx) as usize].b, (tys[k as usize]), pcx);
        }
    }
    // RULE: F14.1 (0.27.3: a parameter the arguments leave free, from the
    // call's expected type through the result: `r.start_bound()` of a
    // RangeFull taken as a `Bound<&i64>`)
    if pcx.hint_node == n && pcx.hint_ty > 0 && pcx.nodes[item as usize].b != 0 {
        crate::front::generics::instantiate::unify(params, bound, tmod,
            pcx.nodes[item as usize].b, pcx.hint_ty, pcx);
    }
    if skip == 1 {
        unify_recv_bound(i, n, params, bound, pcx);
    }
    let mut complete = true;
    let mark = pcx.tscratch.len() as i64;
    for k in 0..count {
        if (bound[k as usize]) == 0 {
            complete = false;
        }
        pcx.tscratch.push((bound[k as usize]));
    }
    let targs = crate::front::generics::take_targs(mark, pcx);
    if !complete {
        return -1;
    }
    let saved = env_enter(params, targs, count, pcx);
    let r = resolve_args(pcx.nodes[pcx.nodes[node as usize].a as usize].g,
        pcx.traits_impls[i as usize].module, pcx);
    env_leave(saved, pcx);
    r
}

// RULE: F14.1 (0.28.0) The parameters of pattern impl i that its type
// leaves free, from the bound of the receiver's type parameter that names
// the impl's trait, in an instance: `r.start_bound()` with `R:
// RangeBounds<K>`, R = RangeFull, is `impl<T> RangeBounds<T> for
// RangeFull` with T = K. n is the method call; `params` (the impl's, or
// its function's, which begin with them) and `bound` are unify's.
pub fn unify_recv_bound(i: i64, n: i64, params: i64, bound: &mut [i64], pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].kind != NodeKind::MethodCall {
        return;
    }
    let mut recv = pcx.nodes[n as usize].a;
    while pcx.nodes[recv as usize].kind == NodeKind::Unary
        && pcx.nodes[recv as usize].op == Tok::Star {
        recv = pcx.nodes[recv as usize].b;
    }
    if pcx.nodes[recv as usize].kind != NodeKind::Ident
        || pcx.nodes[recv as usize].res != Res::Local
        || pcx.nodes[recv as usize].y < 0
        || pcx.locals[pcx.nodes[recv as usize].y as usize].tparam == 0 {
        return;
    }
    let tr = pcx.traits_impls[i as usize].tr;
    let head = pcx.nodes[pcx.nodes[pcx.traits_impls[i as usize].node as usize].a as usize].g;
    let bounds = pcx.nodes[pcx.locals[pcx.nodes[recv as usize].y as usize].tparam as usize].h;
    if head == 0 {
        return;
    }
    for k in 0..pcx.nodes[bounds as usize].count {
        let b = child(bounds, k, pcx);
        if pcx.nodes[b as usize].kind != NodeKind::TyName || pcx.nodes[b as usize].g == 0
            || bound_trait(b, pcx) != tr {
            continue;
        }
        let args = pcx.nodes[b as usize].g;
        for j in 0..pcx.nodes[head as usize].count {
            if j < pcx.nodes[args as usize].count {
                let bt = resolve_type(child(args, j, pcx), pcx);
                if bt > 0 && !has_error_type(bt, pcx) {
                    crate::front::generics::instantiate::unify(params, bound,
                        pcx.traits_impls[i as usize].module, child(head, j, pcx), bt, pcx);
                }
            }
        }
    }
}

// (0.27.2) The bindings of a pattern impl whose header leaves a parameter
// unbound (`impl<T> SliceIndex<[T]> for usize`), against the trait
// arguments a bound asks for (targs, a TLISTS index): the parameters the
// self type t leaves are completed from them; a TLISTS index, -1 when one
// stays unbound. RULE: F14.1
pub fn complete_impl_bindings(i: i64, t: i64, targs: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.traits_impls[i as usize].tpl == TPL_NONE {
        return -1;
    }
    let node = pcx.traits_impls[i as usize].node;
    let params = pcx.nodes[node as usize].g;
    let args = pcx.nodes[pcx.nodes[node as usize].a as usize].g;
    if params == 0 || args == 0 {
        return -1;
    }
    let count = pcx.nodes[params as usize].count;
    let b = crate::front::traits::impl_bindings(i, t, pcx);
    if b < 0 {
        return -1;
    }
    let mut bound_room: Vec<i64, Comp> = Vec::new_in(Comp {});
    bound_room.resize((count) as usize, 0);
    let bound = bound_room.as_mut_slice();
    for k in 0..count {
        (bound[k as usize]) = (pcx.tlists[(b + k) as usize]);
    }
    let tmod = pcx.traits_impls[i as usize].module;
    for k in 0..pcx.nodes[args as usize].count {
        crate::front::generics::instantiate::unify(params, bound, tmod, child(args, k, pcx),
            (pcx.tlists[(targs + k) as usize]), pcx);
    }
    let mut complete = true;
    let mark = pcx.tscratch.len() as i64;
    for k in 0..count {
        if (bound[k as usize]) == 0 {
            complete = false;
        }
        pcx.tscratch.push((bound[k as usize]));
    }
    let full = crate::front::generics::take_targs(mark, pcx);
    if !complete {
        return -1;
    }
    full
}

// impl_targs for a pattern impl whose header leaves a parameter unbound,
// against the trait arguments a bound asks for: complete_impl_bindings's,
// then the trait arguments resolved; -1 when one stays unbound. RULE: F14.1
pub fn complete_impl_targs_by(i: i64, t: i64, targs: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let full = complete_impl_bindings(i, t, targs, pcx);
    if full < 0 {
        return -1;
    }
    let node = pcx.traits_impls[i as usize].node;
    let params = pcx.nodes[node as usize].g;
    let saved = env_enter(params, full, pcx.nodes[params as usize].count, pcx);
    let r = resolve_args(pcx.nodes[pcx.nodes[node as usize].a as usize].g,
        pcx.traits_impls[i as usize].module, pcx);
    env_leave(saved, pcx);
    r
}

// The trait arguments of bound b (a TyName with type arguments, `From<U>`)
// resolved in its module (with the parameters in scope that are bound
// now): a TLISTS index.
pub fn bound_args(b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    resolve_args(pcx.nodes[b as usize].g, module_of(b, pcx), pcx)
}

// From's intrinsic impls: every type from itself, an integer type from
// the ones that widen to it.
fn intrinsic_from(from: i64, to: i64) -> bool {
    from == to || widens(from, to)
}

// Whether type t implements generic trait tr with arguments targs (a
// TLISTS index): through an impl, or intrinsically (From of the type
// itself and of the types that widen to it; Into exactly when the other
// way From holds). tr < 0: a bound that named no trait (an error was
// reported), which holds.
pub fn implements_with(tr: i64, t: i64, targs: i64, pcx: &mut Ctx<Comp>) -> bool {
    if tr < 0 || has_error_type(t, pcx) || t == TY_NEVER {
        return true;
    }
    let count = trait_param_count(tr, pcx);
    if count == 0 {
        return implements(tr, t, pcx);
    }
    // RULE: D22.1 (0.27.3: an Ω, by its bounds, FL11)
    // (0.28.0: or by an impl that covers every type, as any type: std's
    // `impl<T> Borrow<T> for T` for `K: Borrow<K>` of HashMap::get)
    if crate::front::opaque::is_opaque(t, pcx) && crate::front::opaque::is_omega(t, pcx)
        && crate::front::opaque::implements_with(tr, t, targs, pcx) {
        return true;
    }
    for k in 0..count {
        if has_error_type((pcx.tlists[(targs + k) as usize]), pcx) {
            return true;
        }
    }
    let from = std_trait(c"From", pcx);
    if tr == std_trait(c"Into", pcx) {
        return from >= 0
            && implements_with(from, (pcx.tlists[targs as usize]), list_of(t, pcx),
                pcx);
    }
    if tr == from && intrinsic_from((pcx.tlists[targs as usize]), t) {
        return true;
    }
    // (0.27.2.1: the impls of tr only, by its chain)
    let mut next_impl = crate::front::traits::impls_start(tr, pcx);
    while next_impl >= 0 {
        let i = next_impl;
        next_impl = crate::front::traits::impls_after(i, pcx);
        if pcx.traits_impls[i as usize].tr != tr || !impl_covers(i, t, pcx) {
            continue;
        }
        let mut a = impl_targs(i, t, pcx);
        if a < 0 {
            a = complete_impl_targs_by(i, t, targs, pcx);
        }
        if a >= 0 && same_list(a, targs, count, pcx) {
            return true;
        }
    }
    false
}

// Bound b's trait with its arguments, for messages: `From<i64>`.
pub fn buf_bound(out: i64, tr: i64, targs: i64, pcx: &Ctx<Comp>) {
    buf_bytes(out, sym_text(pcx.traits[tr as usize].name, pcx));
    let count = trait_param_count(tr, pcx);
    // (0.27.2.1: a pattern impl whose arguments are unknown here,
    // `impl<A: PartialEq<B>, B> PartialEq<&B> for &A`: its trait alone)
    if count == 0 || targs < 0 {
        return;
    }
    buf_str(out, c"<");
    for k in 0..count {
        if k > 0 {
            buf_str(out, c", ");
        }
        let a = (pcx.tlists[(targs + k) as usize]);
        if a == 0 {
            buf_str(out, c"_");
        } else {
            buf_type(out, a, pcx);
        }
    }
    buf_str(out, c">");
}

pub fn err_bound(tr: i64, targs: i64, pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    buf_bound(out, tr, targs, pcx);
    err_sym(intern_buf(out, pcx), pcx);
}

// ---- Calls of a generic trait's functions ----

// The function `member` of impl i (an FNS index), -1 when it has none.
fn impl_fn(i: i64, member: i64, pcx: &Ctx<Comp>) -> i64 {
    let node = pcx.traits_impls[i as usize].node;
    for k in 0..pcx.nodes[node as usize].count {
        let f = child(node, k, pcx);
        if pcx.nodes[f as usize].a == member && pcx.nodes[f as usize].x != 0
            && (pcx.nodes[f as usize].p & FN_SIG_FAILED) == 0 {
            return pcx.nodes[f as usize].x - 1;
        }
    }
    // (0.27.2: a generic trait's default copied into the impl, F12.1:
    // collect_impl's impl_extra, not in the impl node's list)
    // (those of impl i named member, in order: traits::impl_extra_at)
    let mut k = crate::front::traits::impl_extra_at(i, member, pcx);
    while k >= 0 {
        let f = pcx.impl_extra[k as usize];
        k = crate::front::traits::impl_extra_after(k, pcx);
        if pcx.nodes[f as usize].a == member && pcx.nodes[f as usize].x != 0
            && (pcx.nodes[f as usize].p & FN_SIG_FAILED) == 0
            && crate::front::traits::impl_of_fn(pcx.nodes[f as usize].x - 1, pcx) == i {
            return pcx.nodes[f as usize].x - 1;
        }
    }
    -1
}

// Whether argument node a is a literal without a suffix, which takes the
// type it is checked against (0: no; 1: an integer; 2: a float).
fn literal_kind(a: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e = a;
    if pcx.nodes[e as usize].kind == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Minus {
        e = pcx.nodes[e as usize].b;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Int && pcx.nodes[e as usize].b == SUF_NONE {
        return 1;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Float && pcx.nodes[e as usize].b == SUF_NONE {
        return 2;
    }
    // RULE: F20.5 (0.27.2.1: a tuple of such literals, `g[(0, 1)]`'s
    // index: 3, each element taking its type from the parameter's)
    if pcx.nodes[e as usize].kind == NodeKind::Tuple && pcx.nodes[e as usize].count > 0
        && (0i64..pcx.nodes[e as usize].count).all(|i| {
            let c = child(e, i, pcx);
            (pcx.nodes[c as usize].kind == NodeKind::Int
                || pcx.nodes[c as usize].kind == NodeKind::Float)
                && pcx.nodes[c as usize].b == SUF_NONE
        }) {
            return 3;
        }
    0
}

// RULE: F20.5 Whether tuple a of unsuffixed literals (literal_kind 3)
// fits type p: a tuple of its arity, each element an integer type for an
// integer literal, a float type for a float one.
fn literal_tuple_fits(a: i64, p: i64, pcx: &Ctx<Comp>) -> bool {
    if p <= 0 || pcx.types[p as usize].kind != TyKind::Tuple
        || pcx.types[p as usize].count != pcx.nodes[a as usize].count {
        return false;
    }
    for i in 0..pcx.nodes[a as usize].count {
        let c = child(a, i, pcx);
        let t = type_elem(p, i, pcx);
        if pcx.nodes[c as usize].kind == NodeKind::Int && !is_integer(t)
            || pcx.nodes[c as usize].kind == NodeKind::Float && !is_float(t) {
            return false;
        }
    }
    true
}

// Parameter k of trait function decl (of trait tr) for impl i of type t:
// with the trait's parameters its arguments there and Self t.
fn decl_param(tr: i64, decl: i64, targs: i64, t: i64, k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    decl_type(tr, decl, targs, t, pcx.nodes[child(decl, k, pcx) as usize].b, pcx)
}

// The type node tn of trait function decl, resolved as decl_param does.
fn decl_type(tr: i64, decl: i64, targs: i64, t: i64, tn: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved_mod = pcx.cur_mod;
    let saved_self = pcx.self_type;
    let (saved_impl, saved_tr, saved_targs) = (pcx.self_impl, pcx.assoc_trait, pcx.assoc_targs);
    pcx.cur_mod = pcx.traits[tr as usize].module;
    pcx.self_type = t;
    // (0.27.2: `Self::Output` is the impl's with these trait arguments, F13.1)
    pcx.self_impl = -1;
    pcx.assoc_trait = tr;
    pcx.assoc_targs = targs;
    let saved = env_enter(pcx.traits[tr as usize].params, targs, trait_param_count(tr, pcx), pcx);
    // (0.27.2: the decl's own type parameters, `fn sum<I: Iterator<Item =
    // A>>(iter: I)`, are the error type here: a parameter of one takes any
    // argument, which the call's instance checks)
    let own = pcx.nodes[decl as usize].g;
    let own_count: i64 = if own != 0 { pcx.nodes[own as usize].count } else { 0 };
    // (in the trait's frame: env_enter would hide the trait's parameters)
    let frame_end = pcx.tp_names.len() as i64;
    for i in 0..own_count {
        pcx.tp_names.push(pcx.nodes[child(own, i, pcx) as usize].a);
        pcx.tp_types.push(pcx.ty_error);
    }
    let ty = resolve_type_or_error(tn, pcx);
    pcx.tp_names.truncate(frame_end as usize);
    pcx.tp_types.truncate(frame_end as usize);
    env_leave(saved, pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    pcx.self_impl = saved_impl;
    pcx.assoc_trait = saved_tr;
    pcx.assoc_targs = saved_targs;
    ty
}

// Whether argument type a misses a bound of parameter k of trait function
// decl when that parameter's type is one of decl's own parameters: a bound
// `I: IntoIterator<Item = T>` with T this impl's trait argument, and a's
// Item another type (Extend<T> and Extend<&T> for Vec<T>: the item type
// picks the impl). An unknown projection misses nothing.
fn own_bound_misses(tr: i64, decl: i64, targs: i64, t: i64, k: i64, a: i64,
    pcx: &mut Ctx<Comp>)
    -> bool {
    // RULE: F13.3 (an own parameter's bound picks among the impls)
    let own = pcx.nodes[decl as usize].g;
    let tn = pcx.nodes[child(decl, k, pcx) as usize].b;
    if own == 0 || pcx.nodes[tn as usize].kind != NodeKind::TyName
        || pcx.nodes[tn as usize].count != 0
        || pcx.nodes[tn as usize].g != 0 {
        return false;
    }
    for i in 0..pcx.nodes[own as usize].count {
        let p = child(own, i, pcx);
        if pcx.nodes[p as usize].a != pcx.nodes[tn as usize].a || pcx.nodes[p as usize].h == 0 {
            continue;
        }
        let bounds = pcx.nodes[p as usize].h;
        for j in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, j, pcx);
            if pcx.nodes[b as usize].kind != NodeKind::TyName || pcx.nodes[b as usize].h == 0 {
                continue;
            }
            let saved_mod = pcx.cur_mod;
            pcx.cur_mod = pcx.traits[tr as usize].module;
            let btr = bound_trait(b, pcx);
            pcx.cur_mod = saved_mod;
            if btr < 0 {
                continue;
            }
            let holder = pcx.nodes[b as usize].h;
            for m in 0..pcx.nodes[holder as usize].count {
                let c = child(holder, m, pcx);
                let got = trait_projection(btr, a, pcx.nodes[c as usize].a,
                    pcx.nodes[c as usize].start, pcx);
                if got == 0 || has_error_type(got, pcx) {
                    continue;
                }
                let want = decl_type(tr, decl, targs, t, pcx.nodes[c as usize].b, pcx);
                if want != got && !has_error_type(want, pcx) {
                    return true;
                }
            }
        }
        return false;
    }
    false
}

// Whether candidate c (an index of CANDS, a pair) takes the arguments of
// call n, of types tys[..] (0 for a literal, kinds[..] its kind); `skip`
// is 1 for a method call (its receiver is the decl's self).
fn takes(c: i64, n: i64, t: i64, tys: &mut [i64], kinds: &mut [i64], skip: i64, pcx: &mut Ctx<Comp>) -> bool {
    let i = (pcx.cands[c as usize]);
    let tr = pcx.traits_impls[i as usize].tr;
    let decl = trait_fn(tr,
        pcx.nodes[pcx.fns[(pcx.cands[(c + 1) as usize]) as usize].node as usize].a,
        pcx);
    let has_self = pcx.nodes[decl as usize].count > 0
        && pcx.nodes[child(decl, 0, pcx) as usize].a == pcx.self_sym;
    if skip == 1 && !has_self {
        return false;
    }
    let count = pcx.nodes[n as usize].count;
    if pcx.nodes[decl as usize].count - skip != count {
        return false;
    }
    let mut targs = impl_targs(i, t, pcx);
    if targs < 0 {
        // RULE: F14.1 (a pattern impl's parameter fixed by the arguments)
        let saved_self = pcx.self_type;
        pcx.self_type = t;
        targs = complete_impl_targs(i, (pcx.cands[(c + 1) as usize]), n, tys, skip,
            pcx);
        pcx.self_type = saved_self;
    }
    if targs < 0 {
        return false;
    }
    for k in 0..count {
        let p = decl_param(tr, decl, targs, t, k + skip, pcx);
        let a = (tys[k as usize]);
        if a == 0 {
            if (kinds[k as usize]) == 1 && !is_integer(p)
                || (kinds[k as usize]) == 2 && !is_float(p)
                || (kinds[k as usize]) == 3
                && !literal_tuple_fits(child(n, k, pcx), p, pcx) {
                return false;
            }
        } else if a != p && a != TY_NEVER && !has_error_type(p, pcx) {
            return false;
        } else if a != TY_NEVER && own_bound_misses(tr, decl, targs, t, k + skip, a, pcx) {
            return false;
        }
    }
    true
}

// Call n (`T::member(args)`, or `x.member(args)` with t the receiver's
// type) that found no ordinary function: resolved among t's generic-trait
// impls by the types of the arguments, and checked (n becomes a Call with
// x = f + 1, as synth_method makes); its type. -1 when t has no
// generic-trait impl with a function `member` (the caller reports it).
pub fn generic_trait_call(n: i64, t: i64, member: i64, pcx: &mut Ctx<Comp>) -> i64 {
    dispatch(n, t, member, 0, pcx)
}

// (0.27.0) Whether t has a generic-trait impl with a function `member`
// (front/check/rust.vl: Index<I>'s `index` on a type).
pub fn has_generic_trait_fn(t: i64, member: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t < 0 || has_error_type(t, pcx) {
        return false;
    }
    for i in 0..pcx.traits_impls.len() as i64 {
        if trait_param_count(pcx.traits_impls[i as usize].tr, pcx) != 0 && impl_covers(i, t, pcx)
            && impl_fn(i, member, pcx) >= 0 {
            return true;
        }
    }
    false
}

// (0.28.0) Whether exactly one generic-trait impl covering t has a
// function `member`: an operator's other operand is then of that impl's
// type, known before it is read (front/check/synth_mode.vl, F26.3).
pub fn one_generic_trait_fn(t: i64, member: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t < 0 || has_error_type(t, pcx) {
        return false;
    }
    let mut found: i64 = 0;
    for i in 0..pcx.traits_impls.len() as i64 {
        if trait_param_count(pcx.traits_impls[i as usize].tr, pcx) != 0 && impl_covers(i, t, pcx)
            && impl_fn(i, member, pcx) >= 0 {
            found += 1;
        }
    }
    found == 1
}

// `W::from(x)` with W a generic type written without its arguments (n a
// Call, tpl W's template): a generic-trait call on the instance expected
// there; its type. -1 when tpl has no generic-trait impl with a function
// `member` (the caller reports it).
pub fn template_trait_call(n: i64, tpl: i64, member: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let found = (0i64..pcx.traits_impls.len() as i64).any(|i| pcx.traits_impls[i as usize].tpl
        == tpl
        && trait_param_count(pcx.traits_impls[i as usize].tr, pcx) != 0
        && impl_fn(i, member, pcx) >= 0);
    if !found {
        return -1;
    }
    let hint = hint_for(n, pcx);
    if hint <= 0 || !instance_of(hint, tpl, pcx) {
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_fmt(format_args("'{}::{}",
            str::from_utf8(sym_text(template_name(tpl, pcx), pcx)).unwrap(),
            str::from_utf8(sym_text(member, pcx)).unwrap()), pcx);
        err_fmt(format_args("' needs the type arguments of '{}'",
            str::from_utf8(sym_text(template_name(tpl, pcx), pcx)).unwrap()), pcx);
        err_help_fmt(format_args("write them: '{}::<T>::{}",
            str::from_utf8(sym_text(template_name(tpl, pcx), pcx)).unwrap(),
            str::from_utf8(sym_text(member, pcx)).unwrap()), pcx);
        err_help_fmt(
            format_args("(...)', or the type expected: 'let w: {}<T> = ...'",
                str::from_utf8(sym_text(template_name(tpl, pcx), pcx)).unwrap()), pcx);
        err_end(pcx);
    }
    dispatch(n, hint, member, 0, pcx)
}

// Among the candidates of call n that take its arguments, the one whose
// result type is the expected type `hint`, or -1 when not exactly one is
// (a candidate whose result type is not known yet counts as one).
fn by_expected(n: i64, t: i64, mark: i64, tys: &mut [i64], kinds: &mut [i64], skip: i64, hint: i64,
    pcx: &mut Ctx<Comp>)
    -> i64 {
    // RULE: F13.2 (`let r: &i64 = w.borrow()` picks Borrow<i64>)
    let mut chosen: i64 = -1;
    let mut matches: i64 = 0;
    let mut c = mark;
    while c < pcx.cands.len() as i64 {
        if takes(c, n, t, tys, kinds, skip, pcx) {
            let i = (pcx.cands[c as usize]);
            let tr = pcx.traits_impls[i as usize].tr;
            let decl = trait_fn(tr,
                pcx.nodes[
                    pcx.fns[(pcx.cands[(c + 1) as usize]) as usize].node as usize].a,
                pcx);
            let targs = impl_targs(i, t, pcx);
            let r = if targs < 0 || pcx.nodes[decl as usize].b == 0 {
                pcx.ty_error
            } else {
                decl_type(tr, decl, targs, t, pcx.nodes[decl as usize].b, pcx)
            };
            if r == hint || has_error_type(r, pcx) {
                matches += 1;
                chosen = c;
            }
        }
        c += 2;
    }
    if matches == 1 { chosen } else { -1 }
}

// Among the candidates of method call n that take its arguments, in an
// instance whose receiver is a parameter of a bounded type parameter, the
// one whose trait arguments a bound names (`s.as_ref()` with `S:
// AsRef<str>`, S = String: AsRef<str>, as the generic body read it), or
// -1 when not exactly one is.
fn by_param_bound(n: i64, t: i64, mark: i64, tys: &mut [i64], kinds: &mut [i64],
    pcx: &mut Ctx<Comp>)
    -> i64 {
    // RULE: D22.3, F13.4 (the bound in the generic body picks the impl)
    let mut recv = pcx.nodes[n as usize].a;
    while pcx.nodes[recv as usize].kind == NodeKind::Unary
        && pcx.nodes[recv as usize].op == Tok::Star {
        recv = pcx.nodes[recv as usize].b;
    }
    if pcx.nodes[recv as usize].kind != NodeKind::Ident
        || pcx.nodes[recv as usize].res != Res::Local
        || pcx.nodes[recv as usize].y < 0
        || pcx.locals[pcx.nodes[recv as usize].y as usize].tparam == 0 {
        return -1;
    }
    let bounds = pcx.nodes[pcx.locals[pcx.nodes[recv as usize].y as usize].tparam as usize].h;
    let mut chosen: i64 = -1;
    let mut matches: i64 = 0;
    let mut c = mark;
    while c < pcx.cands.len() as i64 {
        if takes(c, n, t, tys, kinds, 1, pcx) {
            let i = (pcx.cands[c as usize]);
            let tr = pcx.traits_impls[i as usize].tr;
            let targs = impl_targs(i, t, pcx);
            let count = trait_param_count(tr, pcx);
            let mut hit = false;
            for k in 0..pcx.nodes[bounds as usize].count {
                let b = child(bounds, k, pcx);
                if hit || targs < 0 || pcx.nodes[b as usize].kind != NodeKind::TyName
                    || pcx.nodes[b as usize].g == 0 || bound_trait(b, pcx) != tr {
                    continue;
                }
                let bt = resolve_args(pcx.nodes[b as usize].g, pcx.cur_mod, pcx);
                hit = bt >= 0
                    && (0i64..count).all(|j| (pcx.tlists[(bt + j) as usize])
                        == (pcx.tlists[(targs + j) as usize]));
            }
            if hit {
                matches += 1;
                chosen = c;
            }
        }
        c += 2;
    }
    if matches == 1 { chosen } else { -1 }
}

// (0.27.2.1) Among the candidates of call n that take its one argument, a
// view (`[T]`, str: Z9.1, where `&[U]` and `&str` are the view too), the
// one candidate whose trait argument is not a reference, as `PartialEq<str>`
// and `PartialEq<&'a str>` for String both take it and compare alike; -1
// when not exactly one is. RULE: F26.3
fn by_view_rhs(n: i64, t: i64, mark: i64, tys: &mut [i64], kinds: &mut [i64], skip: i64,
    pcx: &mut Ctx<Comp>, any: bool)
    -> i64 {
    let a = (tys[0]);
    if pcx.nodes[n as usize].count != 1 || a <= 0
        || !any && !(pcx.types[a as usize].kind == TyKind::Slice && pcx.types[a as usize].b == 0
            || crate::front::distinct::is_view_distinct(a, pcx)) {
        return -1;
    }
    let mut chosen: i64 = -1;
    let mut matches: i64 = 0;
    let mut c = mark;
    while c < pcx.cands.len() as i64 {
        let i = (pcx.cands[c as usize]);
        let tn = pcx.nodes[pcx.traits_impls[i as usize].node as usize].a;
        let g: i64 = if tn > 0 { pcx.nodes[tn as usize].g } else { 0 };
        let by_ref = g != 0 && pcx.nodes[g as usize].count > 0
            && crate::base::get_src()[pcx.nodes[child(g, 0, pcx) as usize].start as usize]
            == b'&';
        if !by_ref && takes(c, n, t, tys, kinds, skip, pcx) {
            matches += 1;
            chosen = c;
        }
        c += 2;
    }
    if matches == 1 { chosen } else { -1 }
}

// RULE: Z9.1c (0.27.4) Whether an impl of a generic trait covering t has
// a function `member` (dispatch's candidates, before the arguments).
fn covers_member(t: i64, member: i64, pcx: &mut Ctx<Comp>) -> bool {
    for i in 0..pcx.traits_impls.len() as i64 {
        if trait_param_count(pcx.traits_impls[i as usize].tr, pcx) != 0 && impl_covers(i, t, pcx)
            && impl_fn(i, member, pcx) >= 0 {
            return true;
        }
    }
    false
}

// RULE: Z9.1c, F6.2 (0.27.4) Whether an impl of a generic trait covering
// the place `place` has a `&self` function `member` that takes call n's
// arguments (of types tys, kinds): at the by-value step on its view.
fn place_takes(n: i64, place: i64, member: i64, tys: &mut [i64], kinds: &mut [i64],
    pcx: &mut Ctx<Comp>) -> bool {
    let mark = pcx.cands.len() as i64;
    for i in 0..pcx.traits_impls.len() as i64 {
        if trait_param_count(pcx.traits_impls[i as usize].tr, pcx) == 0
            || !impl_covers(i, place, pcx) {
            continue;
        }
        let f = impl_fn(i, member, pcx);
        if f < 0 {
            continue;
        }
        let item = pcx.fns[f as usize].node;
        let tn: i64 = if item > 0 && pcx.nodes[item as usize].count > 0 {
            pcx.nodes[child(item, 0, pcx) as usize].b
        } else {
            0
        };
        if tn > 0 && pcx.nodes[child(item, 0, pcx) as usize].a == pcx.self_sym
            && pcx.nodes[tn as usize].kind == NodeKind::TyPtr
            && (pcx.nodes[tn as usize].p & crate::front::ast::NODE_REF) != 0 {
            pcx.cands.push(i);
            pcx.cands.push(f);
        }
    }
    let mut c = mark;
    let mut found = false;
    while c < pcx.cands.len() as i64 && !found {
        found = takes(c, n, place, tys, kinds, 1, pcx);
        c += 2;
    }
    pcx.cands.truncate(mark as usize);
    found
}

// (0.28.0) The impls that may have a function named member, in order:
// the first's index (-1: none), then impl_naming_after's. A superset of
// those impl_fn finds it in (their own functions and the trait defaults
// copied into them, whatever their flags), made again when an impl or a
// copy was added since.
fn impl_naming(member: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.name_impls != pcx.traits_impls.len() as i64
        || pcx.name_extra != pcx.impl_extra.len() as i64 {
        index_impl_names(pcx);
    }
    pcx.name_first.get(member + 1) - 1
}

// The cell after cell c (impl_naming's), -1 at the end; its impl:
// pcx.name_cells.get(c).
fn impl_naming_after(c: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.name_cells[(c + 1) as usize] - 1
}

// pcx.name_first, name_last and name_cells, for every impl: each name
// once an impl, the impls in their order.
fn index_impl_names(pcx: &mut Ctx<Comp>) {
    pcx.name_first.clear();
    pcx.name_last.clear();
    pcx.name_cells.clear();
    let n = pcx.traits_impls.len() as i64;
    // (the copied defaults by their impl: a chain per impl, extra_head)
    let mut extra_head = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut extra_next: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..pcx.impl_extra.len() as i64 {
        extra_next.push(0);
    }
    let mut k = pcx.impl_extra.len() as i64 - 1;
    while k >= 0 {
        let f = pcx.impl_extra[k as usize];
        if pcx.nodes[f as usize].x != 0 {
            let i = crate::front::traits::impl_of_fn(pcx.nodes[f as usize].x - 1, pcx);
            if i >= 0 {
                extra_next[k as usize] = extra_head.get(i + 1);
                extra_head.put(i + 1, k + 1);
            }
        }
        k -= 1;
    }
    for i in 0..n {
        let node = pcx.traits_impls[i as usize].node;
        for j in 0..pcx.nodes[node as usize].count {
            name_impl(pcx.nodes[child(node, j, pcx) as usize].a, i, pcx);
        }
        let mut e = extra_head.get(i + 1) - 1;
        while e >= 0 {
            name_impl(pcx.nodes[pcx.impl_extra[e as usize] as usize].a, i, pcx);
            e = extra_next[e as usize] - 1;
        }
    }
    pcx.name_impls = n;
    pcx.name_extra = pcx.impl_extra.len() as i64;
}

// Impl i onto name's list, once (the impls come in order).
fn name_impl(name: i64, i: i64, pcx: &mut Ctx<Comp>) {
    let last = pcx.name_last.get(name + 1) - 1;
    if last >= 0 && pcx.name_cells[last as usize] == i {
        return;
    }
    let c = pcx.name_cells.len() as i64;
    pcx.name_cells.push(i);
    pcx.name_cells.push(0);
    if last < 0 {
        pcx.name_first.put(name + 1, c + 1);
    } else {
        pcx.name_cells[(last + 1) as usize] = c + 1;
    }
    pcx.name_last.put(name + 1, c + 1);
}

// RULE: D22.3, F13.4 (0.28.0) The type `x.into()` (n) converts to when
// nothing expects one, in an instance: x a parameter of a bounded type
// parameter with exactly one bound `Into<U>` (`fn f<T: Into<M>>(x: T)`,
// `x.into().v`), U as the generic body read it; 0 when there is none.
fn into_bound_target(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let recv = pcx.nodes[n as usize].a;
    if pcx.nodes[recv as usize].kind != NodeKind::Ident
        || pcx.nodes[recv as usize].res != Res::Local
        || pcx.nodes[recv as usize].y < 0
        || pcx.locals[pcx.nodes[recv as usize].y as usize].tparam == 0 {
        return 0;
    }
    let into = std_trait(c"Into", pcx);
    let bounds = pcx.nodes[pcx.locals[pcx.nodes[recv as usize].y as usize].tparam as usize].h;
    let mut found: i64 = 0;
    let mut count: i64 = 0;
    for k in 0..pcx.nodes[bounds as usize].count {
        let b = child(bounds, k, pcx);
        if pcx.nodes[b as usize].kind != NodeKind::TyName || pcx.nodes[b as usize].g == 0
            || bound_trait(b, pcx) != into {
            continue;
        }
        let bt = resolve_args(pcx.nodes[b as usize].g, pcx.cur_mod, pcx);
        if bt >= 0 {
            found = (pcx.tlists[bt as usize]);
            count += 1;
        }
    }
    if count == 1 { found } else { 0 }
}

// generic_trait_call, the first `pre` arguments synthesized already.
fn dispatch(n: i64, t: i64, member: i64, pre: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if t < 0 || has_error_type(t, pcx) {
        return -1;
    }
    let method = pcx.nodes[n as usize].kind == NodeKind::MethodCall;
    let from = std_trait(c"From", pcx);
    let is_from = !method && from >= 0 && member == intern_c(c"from", pcx);
    if method && member == intern_c(c"into", pcx) && pcx.nodes[n as usize].count == 0
        && std_trait(c"Into", pcx) >= 0 {
        let to = into_bound_target(n, pcx);
        if to > 0 {
            let r = into_call(n, to, pcx);
            if r >= 0 {
                return r;
            }
        }
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_str(c"'into' needs the type it converts to: '", pcx);
        err_type(t, pcx);
        err_str(c"' into what?", pcx);
        err_help(c"write the type: 'let y: T = x.into();', or call 'T::from(x)'", pcx);
        err_end(pcx);
    }
    let hint = hint_for(n, pcx);
    let mark = pcx.cands.len() as i64;
    // (0.28.0: only the impls that may have a function named member,
    // in order, impl_naming; the others have no candidate)
    // (the impls there now: one an impl_covers adds is not tried)
    let impls_now = pcx.traits_impls.len() as i64;
    let mut c = impl_naming(member, pcx);
    while c >= 0 {
        let i = pcx.name_cells[c as usize];
        c = impl_naming_after(c, pcx);
        if i >= impls_now {
            break;
        }
        if trait_param_count(pcx.traits_impls[i as usize].tr, pcx) == 0
            || !impl_covers(i, t, pcx) {
            continue;
        }
        let f = impl_fn(i, member, pcx);
        if f >= 0 {
            pcx.cands.push(i);
            pcx.cands.push(f);
        }
    }
    if pcx.cands.len() as i64 == mark && !is_from {
        // RULE: Z9.1c (0.27.4: a view with no impl of its own: its place's,
        // `s.to_owned_in(a)`, `s.index(r)` of a `&[T]`)
        if method {
            let vt = if pcx.types[t as usize].kind == TyKind::Ptr
                && crate::front::types::place_of_view(pcx.types[t as usize].a, pcx) > 0 {
                pcx.types[t as usize].a
            } else {
                t
            };
            let place = crate::front::types::place_of_view(vt, pcx);
            if place > 0 && place != t && covers_member(place, member, pcx) {
                return dispatch(n, place, member, pre, pcx);
            }
        }
        return -1;
    }
    // The arguments' types; literals without a suffix are left for
    // last: they fit any type of their kind.
    let count = pcx.nodes[n as usize].count;
    let mut tys_room: Vec<i64, Comp> = Vec::new_in(Comp {});
    tys_room.resize((count + 1) as usize, 0);
    let tys = tys_room.as_mut_slice();
    let mut kinds_room: Vec<i64, Comp> = Vec::new_in(Comp {});
    kinds_room.resize((count + 1) as usize, 0);
    let kinds = kinds_room.as_mut_slice();
    let mut failed = false;
    for k in 0..count {
        let a = child(n, k, pcx);
        (kinds[k as usize]) = if k < pre { 0 } else { literal_kind(a, pcx) };
        // (a tuple of literals: the rust edition's, F20.5; MVS synthesizes it)
        if k < pre {
            (tys[k as usize]) = pcx.nodes[a as usize].ty;
        } else if (kinds[k as usize]) != 0 {
            (tys[k as usize]) = 0;
        } else {
            (tys[k as usize]) = synth_expr(a, pcx);
            mark_synthed(a, pcx);
        }
        if (tys[k as usize]) != 0 && has_error_type((tys[k as usize]), pcx) {
            failed = true;
        }
    }
    if failed {
        pcx.cands.truncate(mark as usize);
        return pcx.ty_error;
    }
    // RULE: Z9.1c, F6.2 (0.27.4: on a view the place's `&self` method is
    // at the by-value step, before the view's own `&self` ones at the `&`
    // step: `b.as_ref()` of a `&str` `<str as AsRef<[u8]>>`, not `impl
    // AsRef<U> for &T`; not a receiver of a parameter's type `k: K`, an
    // instance's, whose method is the bound's, K's)
    if method && !is_from {
        let place = crate::front::types::place_of_view(t, pcx);
        let recv = pcx.nodes[n as usize].a;
        // (`Tr::m(x)`: x is the `&self` itself, no autoref; in an instance
        // a receiver `x: &P` is P's, `x: P` or a field of type P the bound's)
        let param_local = recv > 0 && pcx.nodes[recv as usize].kind == NodeKind::Ident
            && pcx.nodes[recv as usize].res == Res::Local && pcx.nodes[recv as usize].y >= 0
            && pcx.locals[pcx.nodes[recv as usize].y as usize].tparam != 0;
        // (0.28.0: `Tr::m(x)` with x a reference to the view, `<K as
        // Borrow<Q>>::borrow(k)` of `k: &K`, K = &str: Self is the view)
        let via_ref = recv > 0 && pcx.nodes[recv as usize].ty > 0
            && pcx.nodes[recv as usize].ty != t
            && pcx.types[pcx.nodes[recv as usize].ty as usize].kind == TyKind::Ptr
            && pcx.types[pcx.nodes[recv as usize].ty as usize].a == t;
        let place_first = pcx.via_node == n && !via_ref || pcx.place_recv == n
            // (0.28.0: `x: &P` with P the place, the view x itself; not `k:
            // &K` with K = &str, a reference to the view: K's own impl,
            // `<&str as Borrow<&str>>` by the bound `K: Borrow<K>`)
            || (if param_local {
                pcx.locals[pcx.nodes[recv as usize].y as usize].borrow
                    && pcx.nodes[recv as usize].ty == t
            }
                else { pcx.cur_fn < 0 || pcx.fns[pcx.cur_fn as usize].tmpl == 0 });
        if place > 0 && place_first && place_takes(n, place, member, tys, kinds, pcx) {
            pcx.cands.truncate(mark as usize);
            return dispatch(n, place, member, count, pcx);
        }
    }
    let skip: i64 = if method { 1 } else { 0 };
    let mut chosen: i64 = -1;
    let mut matches: i64 = 0;
    let mut c = mark;
    while c < pcx.cands.len() as i64 {
        if takes(c, n, t, tys, kinds, skip, pcx) {
            matches += 1;
            chosen = c;
        }
        c += 2;
    }
    if matches > 1 && hint > 0 {
        let e = by_expected(n, t, mark, tys, kinds, skip, hint, pcx);
        if e >= 0 {
            matches = 1;
            chosen = e;
        }
    }
    if matches > 1 && method {
        let e = by_view_rhs(n, t, mark, tys, kinds, skip, pcx, false);
        if e >= 0 {
            matches = 1;
            chosen = e;
        }
    }
    if matches > 1 && method {
        let e = by_param_bound(n, t, mark, tys, kinds, pcx);
        if e >= 0 {
            matches = 1;
            chosen = e;
        }
    }
    // RULE: F26.3 (0.27.3: `impl Extend<T>` and `impl Extend<&'a T>` of
    // a `Vec<&str>`, where `&&str` is the `&str` view too: the one by
    // value, as both copy the view)
    if matches > 1 {
        let e = by_view_rhs(n, t, mark, tys, kinds, skip, pcx, true);
        if e >= 0 {
            matches = 1;
            chosen = e;
        }
    }
    if matches > 1 {
        ambiguous_call(n, t, member, mark, tys, kinds, skip, pcx);
    }
    if matches == 1 {
        let f = (pcx.cands[(chosen + 1) as usize]);
        pcx.cands.truncate(mark as usize);
        return if method { method_call(n, t, f, pcx) } else { path_call(n, t, f, pcx) };
    }
    // From's intrinsic impls: the type itself, a narrower integer.
    if is_from && count == 1 {
        let a = child(n, 0, pcx);
        let at = (tys[0]);
        if at == 0
            && ((kinds[0]) == 1 && is_integer(t) || (kinds[0]) == 2 && is_float(t))
            || at == t {
            pcx.cands.truncate(mark as usize);
            if at == 0 {
                check_expr(a, t, pcx);
            }
            become_value(n, a, t, pcx);
            return t;
        }
        if at != 0 && widens(at, t) {
            pcx.cands.truncate(mark as usize);
            become_cast(n, a, t, pcx);
            return t;
        }
    }
    // RULE: Z9.1c, F6.2 (0.27.4: on a view no impl of its own takes the
    // call: its place's, whose `&self` methods take the view, `a.eq(b)` of
    // two `&[u8]` `<[u8] as PartialEq>::eq`; a `let` binding's view is
    // the view. After the view's own: an instance's `k.borrow()` with K =
    // &str is `<&str as Borrow<&str>>`, as the bound `K: Borrow<Q>` says)
    if method && !is_from {
        let vt = if pcx.types[t as usize].kind == TyKind::Ptr
            && crate::front::types::place_of_view(pcx.types[t as usize].a, pcx) > 0 {
            pcx.types[t as usize].a
        } else {
            t
        };
        let place = crate::front::types::place_of_view(vt, pcx);
        if place > 0 && place != t && covers_member(place, member, pcx) {
            pcx.cands.truncate(mark as usize);
            return dispatch(n, place, member, count, pcx);
        }
    }
    // RULE: F6.2 (0.28.0: in an instance a receiver `*a` of `a: &T` is a
    // T: with T = `&u8` no impl of what T points to takes the call, and
    // T's own does, as the generic body resolved it by T's bound: `<&u8
    // as PartialEq<&u8>>::eq`, `a.eq(b)` and the derives' `PartialEq::eq(a,
    // b)` in `Option<&u8>::eq`)
    if method && !is_from && pcx.cur_fn >= 0 && pcx.fns[pcx.cur_fn as usize].tmpl != 0 {
        let rt = pcx.nodes[pcx.nodes[n as usize].a as usize].ty;
        if rt > 0 && rt != t && pcx.types[rt as usize].kind == TyKind::Ptr
            && pcx.types[rt as usize].b == crate::front::types::REF_SHARED
            && pcx.types[rt as usize].a == t && has_generic_trait_fn(rt, member, pcx) {
            pcx.cands.truncate(mark as usize);
            return dispatch(n, rt, member, count, pcx);
        }
    }
    no_impl_error(n, t, member, mark, tys, kinds, is_from, from, pcx);
}

// Call n of generic-trait function f (`T::from(x)`), checked.
fn path_call(n: i64, t: i64, f0: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut f = f0;
    if pcx.fns[f as usize].generic > 0 {
        let callee = pcx.nodes[n as usize].a;
        let written: i64 = if callee != 0
            && pcx.nodes[callee as usize].kind == NodeKind::Path { pcx.nodes[callee as usize].h }
            else { 0 };
        f = instantiate_call(f, n, 0, t, written, pcx);
    }
    pcx.nodes[n as usize].x = f + 1;
    check_direct_call(n, f, pcx)
}

// Method call n (`x.m(args)`, x of type t or a pointer to one) of
// generic-trait function f: a Call with the receiver (borrowed or
// dereferenced as f's self takes it) first, checked.
fn method_call(n: i64, t: i64, f0: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut f = f0;
    if pcx.fns[f as usize].generic > 0 {
        f = instantiate_call(f, n, 1, t, pcx.nodes[n as usize].g, pcx);
    }
    let receiver = pcx.nodes[n as usize].a;
    // RULE: Z9.1c (0.27.4: a method of the place `[T]`/`str` on its view:
    // the view is its `&self`, passed as it is)
    let rt = pcx.nodes[receiver as usize].ty;
    let place_receiver = crate::front::types::is_unsized_place(t, pcx)
        && (crate::front::types::place_of_view(rt, pcx) == t
            || pcx.types[rt as usize].kind == TyKind::Ptr
            && crate::front::types::place_of_view(pcx.types[rt as usize].a, pcx) == t);
    if place_receiver {
        let mark = list_begin(pcx);
        list_push(receiver, pcx);
        for k in 0..pcx.nodes[n as usize].count {
            list_push(child(n, k, pcx), pcx);
        }
        list_end(n, mark, pcx);
        pcx.nodes[n as usize].kind = NodeKind::Call;
        pcx.nodes[n as usize].a = 0;
        pcx.nodes[n as usize].x = f + 1;
        ensure_checked(f, n, pcx);
        for k in 0..pcx.nodes[n as usize].count {
            check_call_arg(child(n, k, pcx), f, k, pcx);
        }
        check_call_safety(n, f, 1, pcx);
        return pcx.fns[f as usize].ret;
    }
    let through = pcx.nodes[receiver as usize].ty != t;
    let self_ty = fn_param(f, 0, pcx);
    let mut arg = receiver;
    if through && !is_borrow(receiver, pcx)
        && !(pcx.types[self_ty as usize].kind == TyKind::Ptr && pcx.types[self_ty as usize].b == 0) {
        unsafe_through(n, receiver, U_METHOD,
            c"calling a method through a raw pointer is unsafe", pcx);
    }
    // RULE: F6.3 (0.27.3: a `&mut self` method of a generic trait,
    // `s.index_mut(r)`, needs the receiver place mutable as any other
    // `&mut self` method does: own.readonly, rustc E0596)
    if !through && pcx.types[self_ty as usize].kind == TyKind::Ptr
        && pcx.types[self_ty as usize].b == REF_MUT
        && pcx.types[self_ty as usize].a == t {
        // RULE: F20.6 (0.27.5: its indexes and derefs IndexMut's and
        // DerefMut's)
        crate::front::check::rust::place_to_mut(receiver, pcx);
        crate::front::check::assign::check_inout_place(receiver, n, pcx);
    }
    if self_ty == t && through {
        arg = synthetic_unary(Tok::Star, receiver, t, pcx);
    } else if is_pointer(self_ty, pcx) && pcx.types[self_ty as usize].a == t && !through {
        arg = synthetic_unary(Tok::Amp, receiver, self_ty, pcx);
    }
    mark_synthed(arg, pcx);
    let mark = list_begin(pcx);
    list_push(arg, pcx);
    for k in 0..pcx.nodes[n as usize].count {
        list_push(child(n, k, pcx), pcx);
    }
    list_end(n, mark, pcx);
    pcx.nodes[n as usize].kind = NodeKind::Call;
    pcx.nodes[n as usize].a = 0;
    pcx.nodes[n as usize].x = f + 1;
    // (as synth_method: the receiver is not an argument for the
    // safety of the call)
    ensure_checked(f, n, pcx);
    for k in 0..pcx.nodes[n as usize].count {
        check_call_arg(child(n, k, pcx), f, k, pcx);
    }
    check_call_safety(n, f, 1, pcx);
    pcx.fns[f as usize].ret
}

// Call n becomes its checked argument a (of type t): `{ a }`, so that the
// nodes that refer to a still do.
pub fn become_value(n: i64, a: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let (start, end) = (pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
    pcx.nodes[n as usize] = pcx.nodes[0];
    pcx.nodes[n as usize].kind = NodeKind::Block;
    pcx.nodes[n as usize].start = start;
    pcx.nodes[n as usize].end = end;
    pcx.nodes[n as usize].a = a;
    pcx.nodes[n as usize].ty = t;
}

// Call n becomes `a as t` (a checked, of an integer type that widens to t).
fn become_cast(n: i64, a: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let (start, end) = (pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
    let ty = new_node(NodeKind::TyName, start, end, pcx);
    pcx.nodes[ty as usize].a = intern_c(primitive_name(t), pcx);
    pcx.nodes[ty as usize].ty = t;
    pcx.nodes[n as usize] = pcx.nodes[0];
    pcx.nodes[n as usize].kind = NodeKind::Cast;
    pcx.nodes[n as usize].start = start;
    pcx.nodes[n as usize].end = end;
    pcx.nodes[n as usize].a = a;
    pcx.nodes[n as usize].b = ty;
    pcx.nodes[n as usize].ty = t;
}

// The arguments' types, for messages: `(i64, [u8])`.
fn err_arg_types(n: i64, tys: &mut [i64], kinds: &mut [i64], pcx: &Ctx<Comp>) {
    err_str(c"(", pcx);
    for k in 0..pcx.nodes[n as usize].count {
        if k > 0 {
            err_str(c", ", pcx);
        }
        if (tys[k as usize]) != 0 {
            err_type((tys[k as usize]), pcx);
        } else if (kinds[k as usize]) == 3 {
            // (a tuple of literals: its elements' kinds)
            let a = child(n, k, pcx);
            err_str(c"(", pcx);
            for i in 0..pcx.nodes[a as usize].count {
                err_str(if i > 0 { c", " } else { c"" }, pcx);
                err_str(if pcx.nodes[child(a, i, pcx) as usize].kind
                    == NodeKind::Int { c"{integer}" }
                    else { c"{float}" }, pcx);
            }
            err_str(c")", pcx);
        } else if (kinds[k as usize]) == 1 {
            err_str(c"{integer}", pcx);
        } else {
            err_str(c"{float}", pcx);
        }
    }
    err_str(c")", pcx);
}

// The candidates from mark on, for a help line: `From<i64>, From<[u8]>`.
fn help_candidates(mark: i64, t: i64, pcx: &mut Ctx<Comp>) {
    let mut c = mark;
    while c < pcx.cands.len() as i64 {
        if c > mark {
            err_help(c", ", pcx);
        }
        let i = (pcx.cands[c as usize]);
        let targs = impl_targs(i, t, pcx);
        if targs >= 0 {
            buf_bound(pcx.err_help, pcx.traits_impls[i as usize].tr, targs, pcx);
        } else {
            err_help_sym(pcx.traits[pcx.traits_impls[i as usize].tr as usize].name, pcx);
        }
        c += 2;
    }
}

fn ambiguous_call(n: i64, t: i64, member: i64, mark: i64, tys: &mut [i64], kinds: &mut [i64],
    skip: i64, pcx: &mut Ctx<Comp>)
    -> ! {
    err_begin(pcx.nodes[n as usize].start, pcx);
    err_str(c"'", pcx);
    err_type(t, pcx);
    err_fmt(format_args("::{}' is ambiguous for arguments ",
        str::from_utf8(sym_text(member, pcx)).unwrap()), pcx);
    err_arg_types(n, tys, kinds, pcx);
    err_help(c"more than one impl takes them: ", pcx);
    let mut c = mark;
    let mut first = true;
    while c < pcx.cands.len() as i64 {
        if takes(c, n, t, tys, kinds, skip, pcx) {
            if !first {
                err_help(c", ", pcx);
            }
            first = false;
            let i = (pcx.cands[c as usize]);
            let targs = impl_targs(i, t, pcx);
            buf_bound(pcx.err_help, pcx.traits_impls[i as usize].tr, targs, pcx);
        }
        c += 2;
    }
    if (0i64..pcx.nodes[n as usize].count).any(|k| (kinds[k as usize]) != 0) {
        err_help(c"; give the literal a type: '3i32', '3i64', '2.5f32'", pcx);
    }
    err_end(pcx)
}

fn no_impl_error(n: i64, t: i64, member: i64, mark: i64, tys: &mut [i64], kinds: &mut [i64],
    is_from: bool, from: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pcx.nodes[n as usize].start, pcx);
    if is_from && pcx.nodes[n as usize].count == 1 && (tys[0]) != 0 {
        err_str(c"cannot convert '", pcx);
        err_type((tys[0]), pcx);
        err_str(c"' into '", pcx);
        err_type(t, pcx);
        err_str(c"': no impl of 'From<", pcx);
        err_type((tys[0]), pcx);
        err_str(c">' for '", pcx);
        err_type(t, pcx);
        err_str(c"'", pcx);
        if crate::front::check::is_std_named(t, c"String", pcx) {
            // (0.28.0: std's String is built on an allocator, not From)
            err_help(c"a String is made on an allocator: `String::from_in(s, gpa)`, or `s.to_string_in(gpa)`", pcx);
        } else {
            help_from_impl((tys[0]), t, pcx);
        }
        if pcx.cands.len() as i64 > mark {
            err_help(c" (its impls: ", pcx);
            help_candidates(mark, t, pcx);
            err_help(c")", pcx);
        }
    } else {
        err_str(c"no impl of '", pcx);
        err_type(t, pcx);
        err_fmt(format_args("::{}' takes arguments ",
            str::from_utf8(sym_text(member, pcx)).unwrap()), pcx);
        err_arg_types(n, tys, kinds, pcx);
        if pcx.cands.len() as i64 > mark {
            err_help(c"its impls: ", pcx);
            help_candidates(mark, t, pcx);
        }
    }
    pcx.cands.truncate(mark as usize);
    err_end(pcx)
}

// help: the impl From<from> for to that would convert (a variant of `to`
// holding a `from` when it has one).
fn help_from_impl(from: i64, to: i64, pcx: &Ctx<Comp>) {
    err_help(c"implement it: 'impl From<", pcx);
    buf_type(pcx.err_help, from, pcx);
    err_help(c"> for ", pcx);
    buf_type(pcx.err_help, to, pcx);
    err_help(c" { fn from(e: ", pcx);
    buf_type(pcx.err_help, from, pcx);
    err_help(c") -> ", pcx);
    buf_type(pcx.err_help, to, pcx);
    err_help(c" { ", pcx);
    let v = variant_holding(to, from, pcx);
    buf_type(pcx.err_help, to, pcx);
    if v >= 0 {
        err_help_fmt(format_args("::{}(e)",
            str::from_utf8(sym_text(pcx.variants[v as usize].name, pcx)).unwrap()), pcx);
    } else if pcx.types[to as usize].kind == TyKind::Enum {
        err_help(c"::...(e)", pcx);
    } else {
        err_help(c" { ... }", pcx);
    }
    err_help(c" } }'", pcx);
}

// A variant of enum `to` with one field, of type `from`; -1 when none.
fn variant_holding(to: i64, from: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[to as usize].kind != TyKind::Enum {
        return -1;
    }
    let e = pcx.types[to as usize].a;
    for k in 0..(pcx.enums[e as usize]).variant_count {
        let v = enum_variant(e, k, pcx);
        if pcx.variants[v as usize].field_count == 1
            && variant_field(v, 0, pcx) == from {
            return v;
        }
    }
    -1
}

// `x.into()` (n, a MethodCall named `into` without arguments) checked
// against `expected`: `U::from(x)` with U = expected; its type. -1 when n
// is not such a call or `into` is a method of x's type (the caller checks
// it as any call).
pub fn into_call(n: i64, expected: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if expected == 0 || pcx.nodes[n as usize].g != 0 || std_trait(c"Into", pcx) < 0
        || std_trait(c"From", pcx) < 0 {
        return -1;
    }
    let into = intern_c(c"into", pcx);
    let receiver = pcx.nodes[n as usize].a;
    // (an ordinary method `into` of x's type is that method: the call
    // is checked as any other, x synthesized once more)
    let rt = synth_expr(receiver, pcx);
    let mut own = method_of(rt, into, pcx);
    if own < 0 && is_pointer(rt, pcx) {
        own = method_of(pcx.types[rt as usize].a, into, pcx);
    }
    if own >= 0 {
        return -1;
    }
    // RULE: D22.1 (0.28.0: a type parameter whose bound says `Into<U>`: the
    // bound's method, as any other of an Ω; no `From<Ω>` is there to find)
    if crate::front::opaque::is_opaque(rt, pcx) && crate::front::opaque::is_omega(rt, pcx)
        && implements_with(std_trait(c"Into", pcx), rt, list_of(expected, pcx), pcx) {
        return -1;
    }
    if has_error_type(rt, pcx) || has_error_type(expected, pcx) {
        return expected;
    }
    mark_synthed(receiver, pcx);
    let callee = new_node(NodeKind::Path, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    pcx.nodes[callee as usize].b = intern_c(c"from", pcx);
    pcx.nodes[callee as usize].y = expected;
    let mark = list_begin(pcx);
    list_push(receiver, pcx);
    list_end(n, mark, pcx);
    pcx.nodes[n as usize].kind = NodeKind::Call;
    pcx.nodes[n as usize].a = callee;
    pcx.nodes[n as usize].b = 0;
    let r = dispatch(n, expected, intern_c(c"from", pcx), 1, pcx);
    if r < 0 { expected } else { r }
}

// RULE: F8.2 (0.27.3) `x.try_into()` (n, a MethodCall named `try_into`
// without arguments) checked against `expected`, std's `Result<U, E>`:
// `U::try_from(x)`, TryInto's blanket impl over TryFrom; its type. -1 when
// expected is not a Result or `try_into` is a method of x's type.
pub fn try_into_call(n: i64, expected: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut targs: i64 = 0;
    if expected <= 0 || pcx.nodes[n as usize].g != 0 || std_trait(c"TryFrom", pcx) < 0
        || std_enum_name(expected, &mut targs, pcx) != intern_c(c"Result", pcx) {
        return -1;
    }
    let to = pcx.tlists[targs as usize];
    let name = intern_c(c"try_into", pcx);
    let receiver = pcx.nodes[n as usize].a;
    let rt = synth_expr(receiver, pcx);
    let mut own = method_of(rt, name, pcx);
    if own < 0 && is_pointer(rt, pcx) {
        own = method_of(pcx.types[rt as usize].a, name, pcx);
    }
    if own >= 0 || to <= 0 {
        return -1;
    }
    if has_error_type(rt, pcx) || has_error_type(to, pcx) {
        return expected;
    }
    mark_synthed(receiver, pcx);
    let callee = new_node(NodeKind::Path, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
        pcx);
    pcx.nodes[callee as usize].b = intern_c(c"try_from", pcx);
    pcx.nodes[callee as usize].y = to;
    let mark = list_begin(pcx);
    list_push(receiver, pcx);
    list_end(n, mark, pcx);
    pcx.nodes[n as usize].kind = NodeKind::Call;
    pcx.nodes[n as usize].a = callee;
    pcx.nodes[n as usize].b = 0;
    let r = dispatch(n, to, intern_c(c"try_from", pcx), 1, pcx);
    if r < 0 { expected } else { r }
}

// The error value `value` (of type `from`) that `?` returns from a
// function whose error type is `to`: the value itself when they are the
// same, a widening Cast, or `to::from(value)`; the node. An error at pos
// when there is no conversion.
pub fn error_conversion(value: i64, from: i64, to: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if from == to || has_error_type(from, pcx) || has_error_type(to, pcx) {
        return value;
    }
    let (start, end) = (pcx.nodes[value as usize].start, pcx.nodes[value as usize].end);
    if widens(from, to) {
        let c = new_node(NodeKind::Cast, start, end, pcx);
        let ty = new_node(NodeKind::TyName, start, end, pcx);
        pcx.nodes[ty as usize].a = intern_c(primitive_name(to), pcx);
        pcx.nodes[ty as usize].ty = to;
        pcx.nodes[c as usize].a = value;
        pcx.nodes[c as usize].b = ty;
        return c;
    }
    let tr = std_trait(c"From", pcx);
    if tr < 0 || !implements_with(tr, to, list_of(from, pcx), pcx) {
        err_begin(pos, pcx);
        err_str(c"'?' cannot convert the error '", pcx);
        err_type(from, pcx);
        err_str(c"' into '", pcx);
        err_type(to, pcx);
        err_str(c"', the function's error type", pcx);
        help_from_impl(from, to, pcx);
        err_end(pcx);
    }
    let callee = new_node(NodeKind::Path, start, end, pcx);
    pcx.nodes[callee as usize].b = intern_c(c"from", pcx);
    pcx.nodes[callee as usize].y = to;
    let call = new_node(NodeKind::Call, start, end, pcx);
    pcx.nodes[call as usize].a = callee;
    let mark = list_begin(pcx);
    list_push(value, pcx);
    list_end(call, mark, pcx);
    call
}
