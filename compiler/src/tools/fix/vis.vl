// `volec fix --only pub` (0.26.2): a restricted item or field used
// outside its restriction (`pub(super)`, `pub(in a)`) is widened to its
// crate, `pub(crate)`: a program is one crate, so every use the check
// found is inside it. (A private one gets plain `pub`, as before: until
// 0.26.3 compiler/src writes no `pub(crate)`, which 0.25.5 cannot read.)

use crate::base::{buf_new, buf_str};
use crate::front::ast::NODES;
use crate::front::modules::lookup::binding_value;
use crate::front::modules::vis::restriction_span;
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::item_node_of;
use crate::tools::fix::{PRIVATE, PRIVATE_FIELDS, note_fix, user_pos};
use crate::tools::query::refs::ref_in;

// The edits widening the restricted items and fields used outside their
// restriction; their number.
pub fn widen_edits() -> i64 {
    var fixes = 0;
    for i in 0..PRIVATE.count {
        fixes += widen(item_node_of(binding_value(PRIVATE.get(i))));
    }
    for i in 0..PRIVATE_FIELDS.count {
        fixes += widen(PRIVATE_FIELDS.get(i));
    }
    fixes
}

// Node n's restriction made `pub(crate)` (1), or nothing to do (0).
fn widen(n: i64) -> i64 {
    if n <= 0 || (NODES[n].p & ITEM_PUBLIC) == 0 || !user_pos(NODES[n].start)
        || !ref_in(NODES[n].start) {
        return 0;
    }
    let (start, end) = restriction_span(n);
    if start < 0 {
        return 0;
    }
    let text = buf_new();
    buf_str(text, c"pub(crate)");
    if crate::tools::fix::edit_replace(start, end, text) {
        note_fix(crate::tools::fix::last_replace(), 3, 1, -1);
        return 1;
    }
    0
}
