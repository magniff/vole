// `volec fix --only pub` (0.26.2): a restricted item or field used
// outside its restriction (`pub(super)`, `pub(in a)`) is widened to its
// crate, `pub(crate)`: a program is one crate, so every use the check
// found is inside it. (A private one gets plain `pub`, as before: until
// 0.26.3 compiler/src writes no `pub(crate)`, which 0.25.5 cannot read.)

use crate::base::{buf_new, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::lookup::binding_value;
use crate::front::modules::vis::restriction_span;
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::item_node_of;
use crate::tools::ctx::Tcx;
use crate::tools::fix::{note_fix, user_pos};
use crate::tools::query::refs::ref_in;

// The edits widening the restricted items and fields used outside their
// restriction; their number.
pub fn widen_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut fixes: i64 = 0;
    for i in 0..pcx.private.len() as i64 {
        fixes += widen(item_node_of(binding_value(pcx.private[i as usize]), pcx), tcx, pcx);
    }
    for i in 0..pcx.private_fields.len() as i64 {
        fixes += widen(pcx.private_fields[i as usize], tcx, pcx);
    }
    fixes
}

// Node n's restriction made `pub(crate)` (1), or nothing to do (0).
fn widen(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if n <= 0 || (pcx.nodes[n as usize].p & ITEM_PUBLIC) == 0
        || !user_pos(pcx.nodes[n as usize].start, pcx)
        || !ref_in(pcx.nodes[n as usize].start, pcx) {
        return 0;
    }
    let (start, end) = restriction_span(n, pcx);
    if start < 0 {
        return 0;
    }
    let text = buf_new();
    buf_str(text, c"pub(crate)");
    if crate::tools::fix::edit_replace(start, end, text, pcx) {
        note_fix(crate::tools::fix::last_replace(pcx), 3, 1, -1, tcx);
        return 1;
    }
    0
}
