// `volec fix [ROOT] [--only imports|unused|pub|unsafe] [--suggested [--at
// FILE:LINE]] [--in FILE|MODULE] [--dry-run]`
// (0.11; docs/refactor.md): every fix the compiler can make by itself, in
// one atomic edit (edit.vl), one summary line:
//
//   imports  the `use` lines the errors for unknown names ask for (`add
//            `use crate::m::name;``), merged into a `use` of that module
//            when there is one; and 0.8's wildcard migration (`use
//            a::*;` becomes the names it brings: fiximports.vl)
//   unused   imports nothing in their file names, removed
//   pub      `pub` on the items other modules use while they are private
//   unsafe   unsafe operations outside unsafe code, wrapped in unsafe
//            blocks (fixunsafe.vl)
//   std015   (0.15, only when asked for) the calls of 0.14 std functions
//            whose result became a Result, given the method that gives
//            the old value back (fixstd015.vl)
//   alloc016 (0.16, only when asked for) allocation made explicit: std's
//            0.15 forms (`Vec::new()`) become their `_in` forms, and the
//            allocator is passed down from `fn main(gpa: Gpa)` to them
//            (refactor_shape/alloc016.vl)
//   suggested (0.18, `--suggested`, only when asked for) the exact fixes of
//            the errors (base::diag's SUGGESTED: what an error's `try:
//            volec fix --suggested` line stands for), with the imports
//            and pubs; new errors on lines the edit did not write do not
//            refuse it, and the errors left are printed (edit/apply.vl,
//            LEFT_OK); `--at FILE:LINE`: the errors of that line only
//
// `volec --fix-imports ROOT` and `--fix-unsafe ROOT` (0.8, 0.9) are
// `fix --only imports` and `fix --only unsafe`, silent when there is
// nothing to do.

pub mod command;
pub mod verify;
pub mod unneeded;
// (0.26.2: `fix --only pub` widens `pub(super)`, `pub(in path)`)
mod vis;
// (0.26.2: `fix --only fstring`, f-strings to format literals)
pub mod fstring;
// (0.26.3: `fix --only casts`, a usize's `as i64` taken away)
pub mod casts;
// (0.26.3: `fix --only alloc`, the allocator rules)
pub mod alloc;
// (0.26.3: `fix --only buf`, Buf to String<A> or Vec<u8, A>)
pub mod buf;
// (0.26.4: `fix --only rawptr`, the raw pointer parameters decided)
pub mod rawptr;
// (0.26.4: `fix --only statics`, a group of statics into a context passed down)
pub mod statics;

use crate::base::{
    FILES, IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_tool_command, err_pos, fix_at_ok, name_failed, report_error_tries};
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{MODULES, file_of_pos, module_count, module_of, within_std};
use crate::front::modules::lookup::{B_PRIVATE, binding_kind, binding_value};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::item_node_of;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::{after_line, indent_of, node_head};
use crate::tools::fix::command::choose_path;
use crate::tools::fix::verify::{last_replace, note_fix, note_refused, refusal_of};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::sym_less;
use crate::tools::query::positions::{line_end, line_start};
use crate::tools::query::refs::ref_in;
use crate::tools::query::show::text_start;
use crate::tools::reexports::reached_through;
use crate::tools::tidyimports::{relative_style, styled_path};

// The unknown `name` in module m is item `name` of the module with path
// `path` (its help says `add `use PATH::name;``).
pub fn note_missing_use(m: i64, path: i64, name: i64, pcx: inout Ctx<Comp>) {
    // (0.18: `fix --suggested --at FILE:LINE`, the error at that line)
    if !fix_at_ok(err_pos(pcx), &pcx) {
        return;
    }
    var i = 0;
    while i < pcx.missing.count {
        if unsafe {
            pcx.missing.data[i] == m && pcx.missing.data[i + 1] == path
                && pcx.missing.data[i + 2] == name
        } {
            pcx.missing_at.push(i / 3);
            pcx.missing_at.push(err_pos(pcx));
            return;
        }
        i += 3;
    }
    pcx.missing_at.push(pcx.missing.count / 3);
    pcx.missing_at.push(err_pos(pcx));
    pcx.missing.push(m);
    pcx.missing.push(path);
    pcx.missing.push(name);
}

// Binding b (B_PRIVATE) was used where it is private.
pub fn note_private(b: i64, pcx: inout Ctx<Comp>) {
    if binding_kind(b) != B_PRIVATE {
        return;
    }
    for i in 0..pcx.private.count {
        if unsafe { pcx.private.data[i] == b } {
            return;
        }
    }
    pcx.private.push(b);
}

// Field f (a Field node) was used where it is private.
pub fn note_private_field(f: i64, pcx: inout Ctx<Comp>) {
    if f <= 0 {
        return;
    }
    for i in 0..pcx.private_fields.count {
        if pcx.private_fields.get(i) == f {
            return;
        }
    }
    pcx.private_fields.push(f);
}

// The attribute SRC[start..end) is obsolete.
pub fn note_obsolete_attr(start: i64, end: i64, pcx: inout Ctx<Comp>) {
    pcx.obsolete_attrs.push(start);
    pcx.obsolete_attrs.push(end);
}

// The edits deleting the obsolete attributes: the attribute's line when
// it is alone on it, else the attribute and the blanks after it; their
// number.
pub fn obsolete_attr_edits(pcx: inout Ctx<Comp>) -> i64 {
    var fixes = 0;
    var i = 0;
    while i + 1 < pcx.obsolete_attrs.count {
        var start = pcx.obsolete_attrs.get(i);
        var end = pcx.obsolete_attrs.get(i + 1);
        i += 2;
        if !user_pos(start) || !ref_in(start, &pcx) {
            continue;
        }
        let f = file_of_pos(start);
        let first = FILES[f].start;
        let last = FILES[f].end;
        var s = start;
        while s > first && (SRC[s - 1] == ' ' || SRC[s - 1] == '\t') {
            s -= 1;
        }
        var e = end;
        while e < last && (SRC[e] == ' ' || SRC[e] == '\t') {
            e += 1;
        }
        if (s == first || SRC[s - 1] == '\n') && e < last && SRC[e] == '\n' {
            // (alone on its line: the line)
            start = s;
            end = e + 1;
        } else {
            end = e;
        }
        if edit_replace(start, end, buf_new(), &pcx) {
            fixes += 1;
        }
    }
    fixes
}

// Whether module m passes --in: its file, or it or a module it is in (a
// child of the module given passes, as for ref_in; 0.13).
fn module_in(m: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if pcx.opt_in == 0 as *u8 {
            return true;
        }
        var a = m;
        while a >= 0 {
            if pcx.in_module.data[a] != 0 {
                return true;
            }
            a = if a > 0 { MODULES[a].parent } else { -1 };
        }
        for f in 0..crate::base::FILES.len() {
            if FILES[f].module == m && pcx.in_file.data[f] != 0 {
                return true;
            }
        }
        false
    }
}

// Whether module m's code is in a file of the program (not std's, the C
// headers').
fn user_module(m: i64, pcx: Ctx<Comp>) -> bool {
    m >= 0 && !within_std(m) && m != pcx.c_module
}

fn user_pos(pos: i64) -> bool {
    unsafe { FILES[file_of_pos(pos)].path[0] != '<' }
}

// ---- Missing imports ----

// The path of Use node u (its segments before the imported names), as a
// symbol: `crate::a::b`.
fn use_path(u: i64, pcx: Ctx<Comp>) -> i64 {
    let path = NODES[u].c;
    let out = buf_new();
    for i in 0..NODES[path].count {
        if i > 0 {
            buf_str(out, c"::");
        }
        buf_bytes(out, SYMS[NODES[child(path, i, pcx)].a].text);
    }
    intern(buf_slice(out))
}

// Whether Use node u, in module m, imports from the module of path p
// (`crate::a`; written `a` in the root module).
fn same_path(u: i64, m: i64, p: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    let up = use_path(u, pcx);
    if up == p || crate::tools::tidyimports::use_abs_path(u, m, &tcx, pcx) == p {
        return true;
    }
    let t = SYMS[p].text;
    let w = SYMS[up].text;
    m == 0 && t.len as i64 == w.len as i64 + 7
        && crate::tools::proc::same_bytes(t[7..t.len], w) && t[0] == 'c' && t[5] == ':'
}

// The Use items (not header imports, not `*`) of module m, by position.
fn module_uses(m: i64, out: inout IntVec, pcx: inout Ctx<Comp>) {
    for n in 1..NODES.len() as i64 {
        if NODES[n].kind == NodeKind::Use && NODES[n].d != 2 && module_of(n, &pcx) == m
            && user_pos(NODES[n].start) {
            out.push(n);
        }
    }
}

// The edits adding the missing imports; their number.
fn missing_use_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var fixes = 0;
        var done = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        // (0.16: the module, among several with the name: choose_path)
        var i = 0;
        while i < pcx.missing.count {
            let m = pcx.missing.data[i];
            if user_module(m, pcx) && module_in(m, pcx) {
                pcx.missing.data[i + 1] = choose_path(m, pcx.missing.data[i + 2],
                    pcx.missing.data[i + 1], &tcx, &pcx);
            }
            i += 3;
        }
        i = 0;
        while i < pcx.missing.count {
            let m = pcx.missing.data[i];
            let p = pcx.missing.data[i + 1];
            i += 3;
            if p < 0 || !user_module(m, pcx) || !module_in(m, pcx) {
                continue;
            }
            // (once per module and path, with all its names)
            var seen = false;
            var k = 0;
            while k < done.count {
                if done.data[k] == m && done.data[k + 1] == p {
                    seen = true;
                }
                k += 2;
            }
            if seen {
                continue;
            }
            done.push(m);
            done.push(p);
            var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var entries = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var j = 0;
            while j < pcx.missing.count {
                // (0.25.2.1: not a name a `use` of m imports already, nor
                // one a fix of a `use` line of m spells: imported twice)
                if pcx.missing.data[j] == m && pcx.missing.data[j + 1] == p
                    && !imported_in(m, pcx.missing.data[j + 2], &pcx) {
                    names.push(pcx.missing.data[j + 2]);
                    entries.push(j / 3);
                }
                j += 3;
            }
            if names.count == 0 {
                continue;
            }
            sort_syms(&names);
            if add_import(m, p, names, &tcx, &pcx) {
                fixes += names.count;
                let e = last_replace(pcx);
                for x in 0..entries.count {
                    var at = 0;
                    var first = x == 0;
                    while at + 1 < pcx.missing_at.count {
                        if pcx.missing_at.data[at] == entries.data[x] {
                            note_fix(e, 0, if first { names.count } else { 0 },
                                pcx.missing_at.data[at + 1], &tcx);
                            first = false;
                        }
                        at += 2;
                    }
                }
            }
        }
        fixes
    }
}

// (0.25.2.1) Whether a `use` of module m imports `name` already (it may
// not resolve: a wrong path), or a fix of one of its `use` lines writes
// it (a did-you-mean of the imported name): an import of it would be a
// second one.
fn imported_in(m: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    // UNSAFE: NODES is the parser's table of nodes, a raw pointer (front/ast); SUGGESTED a static var (base/diag).
    // SAFETY: u is a Use node module_uses found and it a child of it (0 <= n < NODE_COUNT); SUGGESTED is read in fours below its count.
    unsafe {
        var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        module_uses(m, &uses, &pcx);
        for k in 0..uses.count {
            let u = uses.data[k];
            for i in 0..NODES[u].count {
                let it = child(u, i, pcx);
                if (if NODES[it].b != 0 { NODES[it].b } else { NODES[it].a }) == name {
                    return true;
                }
            }
            var s = 0;
            while s + 3 < pcx.suggested.count {
                let at = pcx.suggested.data[s + 1];
                if at >= NODES[u].start && at < NODES[u].end
                    && crate::tools::proc::same_bytes(buf_slice(pcx.suggested.data[s + 3]),
                        SYMS[name].text) {
                    return true;
                }
                s += 4;
            }
        }
        false
    }
}

fn sort_syms(v: inout IntVec) {
    unsafe {
        for k in 1..v.count {
            var j = k;
            while j > 0 && sym_less(v.data[j], v.data[j - 1]) {
                let t = v.data[j];
                v.data[j] = v.data[j - 1];
                v.data[j - 1] = t;
                j -= 1;
            }
        }
    }
}

// The edit importing `names` from the module of path p into module m:
// into a `use` of that module, else a `use` line after m's last one (or
// before its first item).
fn add_import(m: i64, p: i64, names: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        module_uses(m, &uses, &pcx);
        for k in 0..uses.count {
            let u = uses.data[k];
            if NODES[u].b == 1 || !same_path(u, m, p, &tcx, pcx) || NODES[u].count == 0 {
                continue;
            }
            let last = child(u, NODES[u].count - 1, pcx);
            let braces = brace_after(NODES[NODES[u].c].end, NODES[u].end);
            let text = buf_new();
            if braces {
                // `use p::{a, b};` -> `use p::{a, b, NAME};`
                for x in 0..names.count {
                    buf_str(text, c", ");
                    buf_bytes(text, SYMS[names.data[x]].text);
                }
                return edit_replace(NODES[last].end, NODES[last].end, text, &pcx);
            }
            // `use p::a;` (or `use p::a as b;`) -> `use p::{a, NAME};`
            var semi = NODES[u].end;
            while semi > NODES[last].start && SRC[semi - 1] != ';' {
                semi -= 1;
            }
            buf_byte(text, '{');
            buf_bytes(text, SRC[NODES[last].start..semi - 1]);
            for x in 0..names.count {
                buf_str(text, c", ");
                buf_bytes(text, SYMS[names.data[x]].text);
            }
            buf_byte(text, '}');
            return edit_replace(NODES[last].start, semi - 1, text, &pcx);
        }
        // A new line.
        let line = buf_new();
        buf_str(line, c"use ");
        // (0.14: a child module's path as the module writes them)
        let styled = styled_path(p, m, relative_style(m, &tcx, &pcx), &tcx, pcx);
        buf_bytes(line, SYMS[styled].text);
        buf_str(line, c"::");
        if names.count > 1 {
            buf_byte(line, '{');
        }
        for x in 0..names.count {
            if x > 0 {
                buf_str(line, c", ");
            }
            buf_bytes(line, SYMS[names.data[x]].text);
        }
        if names.count > 1 {
            buf_byte(line, '}');
        }
        buf_byte(line, ';');
        if uses.count > 0 {
            let u = uses.data[uses.count - 1];
            let at = line_end(NODES[u].end - 1, pcx);
            let text = buf_new();
            buf_byte(text, '\n');
            buf_bytes(text, indent_of(NODES[u].start, pcx));
            buf_bytes(text, buf_slice(line));
            return edit_replace(at, at, text, &pcx);
        }
        // Before the module's first item (and its comments).
        var first = -1;
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d].module == m && pcx.defs[d].parent < 0 && user_pos(pcx.defs[d].start)
                && (first < 0 || pcx.defs[d].start < pcx.defs[first].start) {
                first = d;
            }
        }
        if first < 0 {
            return false;
        }
        let at = line_start(text_start(first, pcx), pcx);
        let text = buf_new();
        buf_bytes(text, indent_of(pcx.defs[first].start, pcx));
        buf_bytes(text, buf_slice(line));
        buf_str(text, c"\n\n");
        edit_replace(at, at, text, &pcx)
    }
}

// Whether a `{` is in SRC[from..to).
fn brace_after(from: i64, to: i64) -> bool {
    for p in from..to {
        if SRC[p] == '{' {
            return true;
        }
    }
    false
}

// ---- Unused imports ----

// Whether identifier `name` is written in the module of file f outside
// Use node u.
// (0.25.2: `check` reports unused imports; the times each file writes
// each imported name are counted in one pass over the tokens, which are
// not in position order: std's sections, derived impls and test code are
// lexed after the files.)
fn named_in_file(name: i64, f: i64, u: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.named_tokens != pcx.toks.len() as i64 || pcx.named_syms < SYMS.len() as i64 {
        count_imported_names(&pcx);
    }
    // (by module: a module may have several files, std's root its flat/
    // ones, a root given with other files)
    let total = pcx.named.get(named_key(name, file_at_index(f).module));
    // (the times u itself writes it: its path's words, its names)
    var inside = 0;
    let path = node_at(node_at(u).c);
    for i in 0..path.count {
        if node_at(child(node_at(u).c, i, pcx)).a == name {
            inside += 1;
        }
    }
    for k in 0..node_at(u).count {
        let id = node_at(child(u, k, pcx));
        if id.a == name {
            inside += 1;
        }
        if id.b == name {
            inside += 1;
        }
    }
    total > inside
}

fn named_key(name: i64, m: i64) -> i64 {
    name * 1048576 + m + 1
}

fn count_imported_names(pcx: inout Ctx<Comp>) {
    pcx.named = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    pcx.named_tokens = pcx.toks.len() as i64;
    pcx.named_syms = SYMS.len() as i64;
    // (the names imported: the only ones counted)
    var wanted = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for u in 1..NODES.len() as i64 {
        let n = node_at(u);
        if n.kind == NodeKind::Use && n.d != 2 {
            for k in 0..n.count {
                let id = node_at(child(u, k, pcx));
                wanted.put((if id.b != 0 { id.b } else { id.a }) + 1, 1);
            }
        }
    }
    // (the tokens come in runs, each in one file)
    var module = 0;
    var lo = 0;
    var hi = 0;
    for i in 0..pcx.toks.len() as i64 {
        let t = token_at_index(i, pcx);
        if t.kind != Tok::Ident || wanted.get(t.value as i64 + 1) == 0 {
            continue;
        }
        if t.start < lo || t.start >= hi {
            let file = file_at_index(file_of_pos(t.start));
            module = file.module;
            lo = file.start;
            hi = file.end;
        }
        let key = named_key(t.value as i64, module);
        pcx.named.put(key, pcx.named.get(key) + 1);
    }
    // (0.26.2: a name in a format literal's hole, `"{NAME}"`, one of the
    // Ident nodes front/check/format.vl made at its place in the text)
    for n in 1..NODES.len() as i64 {
        let interp = node_at(n);
        if interp.kind != NodeKind::Interp || SRC[interp.start] == 'f' {
            continue;
        }
        for k in 0..interp.count {
            let hole = node_at(child(n, k, pcx));
            if hole.kind != NodeKind::InterpHole {
                continue;
            }
            for x in [hole.a, hole.g, hole.h] {
                if x <= 0 || node_at(x).kind != NodeKind::Ident || wanted.get(node_at(x).a + 1) == 0
                    || node_at(x).start <= interp.start || node_at(x).start >= interp.end {
                    continue;
                }
                let key = named_key(node_at(x).a,
                    file_at_index(file_of_pos(node_at(x).start)).module);
                pcx.named.put(key, pcx.named.get(key) + 1);
            }
        }
    }
}

// Node n, token i, file f (copies).
fn node_at(n: i64) -> crate::front::ast::Node {
    NODES[n]
}

fn token_at_index(i: i64, pcx: Ctx<Comp>) -> crate::front::lexer::Token {
    // UNSAFE: TOKS is the lexer's table of tokens, a raw pointer.
    // SAFETY: 0 <= i < TOK_COUNT (the caller's loop), the tokens lexed.
    unsafe { pcx.toks[i] }
}

fn file_at_index(f: i64) -> crate::base::SourceFile {
    FILES[f]
}

// The edits removing the imports nothing in their file names (a name
// written anywhere in the file keeps its import: a local of that name
// too); their number. `pub use` items are kept (other modules may use
// what they bring).
fn unused_import_edits(only_report: *IntVec, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var fixes = 0;
        for u in 1..NODES.len() as i64 {
            if NODES[u].kind != NodeKind::Use || NODES[u].d == 2 || NODES[u].b == 1
                || (NODES[u].p & ITEM_PUBLIC) != 0 {
                continue;
            }
            if !user_pos(NODES[u].start) || !user_module(module_of(u, &pcx), pcx)
                || !ref_in(NODES[u].start, &pcx) {
                continue;
            }
            let f = file_of_pos(NODES[u].start);
            let n = NODES[u].count;
            var unused = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for k in 0..n {
                let id = child(u, k, pcx);
                let local = if NODES[id].b != 0 { NODES[id].b } else { NODES[id].a };
                // (an import other modules import or name through is used:
                // `use crate::name` reaching the root's import, 0.12)
                if !named_in_file(local, f, u, &pcx)
                    && !reached_through(module_of(u, &pcx), local, &pcx) {
                    unused.push(k);
                }
            }
            if unused.count == 0 {
                continue;
            }
            if only_report != 0 as *IntVec {
                for k in 0..unused.count {
                    only_report.push(child(u, unused.data[k], pcx));
                }
                continue;
            }
            fixes += remove_use_names(u, unused, &pcx);
        }
        fixes
    }
}

// The edits removing names `unused` (their indexes) of Use node u: the
// whole `use` when it is all of them, `use p::a;` for `use p::{a, b};`
// when one is left (0.17: also for rewrite). The number removed.
pub fn remove_use_names(u: i64, unused: IntVec, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let n = NODES[u].count;
        if unused.count == n {
            let head = node_head(NODES[u].start, pcx);
            if blank_before(head, pcx) && blank_after(NODES[u].end, pcx) {
                delete_lines(line_start(head, pcx), NODES[u].end, &pcx);
            } else {
                edit_replace(head, NODES[u].end, buf_new(), &pcx);
            }
            return n;
        }
        if n - unused.count == 1 && one_line_braces(u, pcx) {
            // (one name left: `use p::{a};` is `use p::a;`)
            var kept = 0;
            for k in 0..n {
                var gone = false;
                for x in 0..unused.count {
                    if unused.data[x] == k {
                        gone = true;
                    }
                }
                if !gone {
                    kept = child(u, k, pcx);
                }
            }
            var open = NODES[NODES[u].c].end;
            while SRC[open] != '{' {
                open += 1;
            }
            var close = NODES[u].end;
            while SRC[close] != '}' {
                close -= 1;
            }
            let text = buf_new();
            buf_bytes(text, SRC[NODES[kept].start..NODES[kept].end]);
            return if edit_replace(open, close + 1, text, &pcx) { unused.count } else { 0 };
        }
        var fixes = 0;
        for k in 0..unused.count {
            if remove_use_name(u, unused.data[k], &pcx) {
                fixes += 1;
            }
        }
        fixes
    }
}

// Whether Use node u lists its names between braces, on one line.
fn one_line_braces(u: i64, pcx: Ctx<Comp>) -> bool {
    brace_after(NODES[NODES[u].c].end, NODES[u].end) && same_line(NODES[u].start, NODES[u].end, pcx)
}

// Whether only blanks are before pos on its line.
fn blank_before(pos: i64, pcx: Ctx<Comp>) -> bool {
    var p = line_start(pos, pcx);
    while p < pos && (SRC[p] == ' ' || SRC[p] == '\t') {
        p += 1;
    }
    p == pos
}

// Whether only blanks (or a comment) are after pos on its line.
fn blank_after(pos: i64, pcx: Ctx<Comp>) -> bool {
    let e = line_end(pos, pcx);
    var p = pos;
    while p < e && (SRC[p] == ' ' || SRC[p] == '\t' || SRC[p] == '\r') {
        p += 1;
    }
    p == e || (p + 1 < e && SRC[p] == '/' && SRC[p + 1] == '/')
}

// The edit removing name k of Use node u (one of several between braces),
// with its separator: `a, b, c` loses `b, ` (its line, when it is alone
// on it), the last loses `, c`.
pub fn remove_use_name(u: i64, k: i64, pcx: inout Ctx<Comp>) -> bool {
    let id = child(u, k, pcx);
    let a = NODES[id].start;
    let b = NODES[id].end;
    let n = NODES[u].count;
    if k + 1 < n {
        let next = NODES[child(u, k + 1, pcx)].start;
        if blank_before(a, pcx) && !same_line(b, next, pcx) {
            // alone on its line: the line
            return edit_replace(line_start(a, pcx), after_line(b, pcx), buf_new(), &pcx);
        }
        if same_line(b, next, pcx) {
            return edit_replace(a, next, buf_new(), &pcx);
        }
        // last on its line: `, NAME` (from the end of the one before)
        if k > 0 && same_line(NODES[child(u, k - 1, pcx)].end, a, pcx) {
            return edit_replace(NODES[child(u, k - 1, pcx)].end, b, buf_new(), &pcx);
        }
        return edit_replace(a, next, buf_new(), &pcx);
    }
    // The last name: from the end of the one before.
    let prev = NODES[child(u, k - 1, pcx)].end;
    if blank_before(a, pcx) && !same_line(prev, a, pcx) {
        var e = b;
        if SRC[e] == ',' {
            e += 1;
        }
        if blank_after(e, pcx) {
            return edit_replace(line_start(a, pcx), after_line(b, pcx), buf_new(), &pcx);
        }
    }
    edit_replace(prev, b, buf_new(), &pcx)
}

fn same_line(a: i64, b: i64, pcx: Ctx<Comp>) -> bool {
    line_start(a, pcx) == line_start(b, pcx)
}

// ---- pub ----

// The edits making the private items used elsewhere public; their number.
fn pub_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var fixes = 0;
        for i in 0..pcx.private.count {
            let key = binding_value(pcx.private.data[i]);
            var node = item_node_of(key, pcx);
            if node == 0 {
                // a module: its `mod` item
                for m in 1..module_count(pcx) {
                    if MODULES[m].key == key && pcx.mod_def.data[m] >= 0 {
                        node = pcx.defs[pcx.mod_def.data[m]].node;
                    }
                }
            }
            if node == 0 || (NODES[node].p & ITEM_PUBLIC) != 0 || !user_pos(NODES[node].start)
                || !ref_in(NODES[node].start, &pcx) {
                continue;
            }
            let text = buf_new();
            // (0.26.2: `pub(self) fn` becomes `pub fn`)
            let (ss, se) = crate::front::modules::vis::self_span(NODES[node].start);
            buf_str(text, if ss >= 0 { c"pub" } else { c"pub " });
            if edit_replace(if ss >= 0 { ss } else { NODES[node].start },
                if ss >= 0 { se } else { NODES[node].start }, text, &pcx) {
                note_fix(last_replace(pcx), 3, 1, -1, &tcx);
                fixes += 1;
            }
        }
        // (0.26.0) the private fields used elsewhere
        for i in 0..pcx.private_fields.count {
            let f = pcx.private_fields.data[i];
            if (NODES[f].p & ITEM_PUBLIC) != 0 || !user_pos(NODES[f].start)
                || !ref_in(NODES[f].start, &pcx) {
                continue;
            }
            let text = buf_new();
            let (ss, se) = crate::front::modules::vis::self_span(NODES[f].start);
            buf_str(text, if ss >= 0 { c"pub" } else { c"pub " });
            if edit_replace(if ss >= 0 { ss } else { NODES[f].start },
                if ss >= 0 { se } else { NODES[f].start }, text, &pcx) {
                note_fix(last_replace(pcx), 3, 1, -1, &tcx);
                fixes += 1;
            }
        }
        // (0.26.2) the restricted ones used outside their restriction
        fixes += crate::tools::fix::vis::widen_edits(&tcx, &pcx);
        fixes
    }
}

// The imports nothing names (query unused): their Ident nodes, into out.
pub fn unused_imports(out: *IntVec, pcx: inout Ctx<Comp>) {
    unused_import_edits(out, &pcx);
}

// (0.25.2) `check` and a build: each import nothing in its file names is
// a warning, `use.unused` (an error with --deny-warnings), whose try:
// line removes them all; not std's, not a `pub use`, not one that failed
// (an error already).
pub fn report_unused_imports(pcx: inout Ctx<Comp>) {
    var ids = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    // (every one: a query's --in, not read yet when the program is
    // checked, is for its own answer)
    let opt_in = pcx.opt_in;
    pcx.opt_in = 0 as *u8;
    unused_import_edits(&ids, &pcx);
    pcx.opt_in = opt_in;
    if ids.count == 0 {
        return;
    }
    let tries = buf_new();
    buf_tool_command(tries, c_slice(c"fix --only unused"), true, pcx);
    for id in (&ids).items() {
        let n = node_at(id);
        let local = if n.b != 0 { n.b } else { n.a };
        if name_failed(local, pcx) {
            continue;
        }
        let msg = buf_new();
        buf_str(msg, c"unused import '");
        buf_bytes(msg, sym_text(local));
        buf_str(msg, c"': nothing in this file names it");
        buf_byte(msg, 0);
        report_error_tries(n.start, 7001, c"use.unused", buf_slice(msg).ptr,
            c"remove it (`volec fix` removes every unused import)", buf_slice(tries), true, &pcx);
    }
}

// ---- Suggested fixes (0.18) ----

// The edits of the errors' exact fixes (base::diag's SUGGESTED: a name
// a did-you-mean offers alone, a conversion, a path from the crate's
// root, a Rust spelling respelled...); their number. (0.25.2.1) Only
// those of errors with a code in CODES when it is set (`--codes`); a
// conversion that loses the value is not made (verify::refusal_of, a
// `note fix.refused`); each fix made is noted for verify_fixes.
pub fn suggested_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var fixes = 0;
        var i = 0;
        var k = 0;
        while i + 3 < pcx.suggested.count {
            let pos = pcx.suggested.data[i];
            let start = pcx.suggested.data[i + 1];
            let end = pcx.suggested.data[i + 2];
            let text = pcx.suggested.data[i + 3];
            let kind = if k < pcx.suggested_kind.count { pcx.suggested_kind.data[k] } else { -1 };
            i += 4;
            k += 1;
            if !user_pos(start) || (pcx.opt_in != 0 as *u8 && !ref_in(start, &pcx))
                || !code_taken(kind, tcx) {
                continue;
            }
            let why = refusal_of(start, end, text, pcx);
            if why.len > 0 {
                note_refused(pos, buf_slice(text), why, &tcx, pcx);
                continue;
            }
            if edit_replace(start, end, text, &pcx) {
                note_fix(last_replace(pcx), 10, 1, pos, &tcx);
                fixes += 1;
            }
        }
        fixes
    }
}

// Whether the fixes of errors of code `kind` (a symbol) are made.
fn code_taken(kind: i64, tcx: Tcx<Comp>) -> bool {
    if tcx.codes < 0 {
        return true;
    }
    if kind < 0 {
        return false;
    }
    let want = buf_new();
    buf_byte(want, ',');
    buf_bytes(want, SYMS[kind].text);
    buf_byte(want, ',');
    let all = buf_slice(tcx.codes);
    let w = buf_slice(want);
    var p = 0;
    while p + w.len as i64 <= all.len as i64 {
        if crate::tools::proc::same_bytes(all[p..p + w.len as i64], w) {
            return true;
        }
        p += 1;
    }
    false
}
