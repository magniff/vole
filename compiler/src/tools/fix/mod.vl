// `volec fix [ROOT] [--only imports|unused|pub|unsafe] [--suggested [--at
// FILE:LINE]] [--in FILE|MODULE] [--dry-run]`
// (0.11; docs/refactor.md): every fix the compiler can make by itself, in
// one atomic edit (edit.vl), one summary line:
//
//   imports  the `use` lines the errors for unknown names ask for (`add
//            `use crate::m::name;``), merged into a `use` of that module
//            when there is one; and 0.8's wildcard migration (`use
//            a::*;` becomes the names it brings: fiximports.vl)
//   unused   imports nothing in their file names, removed
//   pub      `pub` on the items other modules use while they are private
//   unsafe   unsafe operations outside unsafe code, wrapped in unsafe
//            blocks (fixunsafe.vl)
//   alloc016 (0.16, only when asked for) allocation made explicit: std's
//            0.15 forms (`Vec::new()`) become their `_in` forms, and the
//            allocator is passed down from `fn main(gpa: Gpa)` to them
//            (refactor_shape/alloc016.vl)
//   suggested (0.18, `--suggested`, only when asked for) the exact fixes of
//            the errors (base::diag's SUGGESTED: what an error's `try:
//            volec fix --suggested` line stands for), with the imports
//            and pubs; new errors on lines the edit did not write do not
//            refuse it, and the errors left are printed (edit/apply.vl,
//            LEFT_OK); `--at FILE:LINE`: the errors of that line only
//
// `volec --fix-imports ROOT` and `--fix-unsafe ROOT` (0.8, 0.9) are
// `fix --only imports` and `fix --only unsafe`, silent when there is
// nothing to do.

pub mod command;
pub mod verify;
pub mod unneeded;
// (0.26.2: `fix --only pub` widens `pub(super)`, `pub(in path)`)
mod vis;
// (0.26.3: `fix --only alloc`, the allocator rules)
pub mod alloc;
// (0.26.3: `fix --only buf`, Buf to String<A> or Vec<u8, A>)
pub mod buf;
// (0.26.4: `fix --only rawptr`, the raw pointer parameters decided)
pub mod rawptr;
// (0.26.4: `fix --only statics`, a group of statics into a context passed down)
pub mod statics;
// (0.27.2.1: `fix --only effects`, contracts-effects.md E3.6)
pub mod effects;

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_src, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_tool_command, err_pos, fix_at_ok, name_failed, report_error_tries};
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_count, module_of, within_std};
use crate::front::modules::lookup::{B_PRIVATE, binding_kind, binding_value};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::item_node_of;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::{after_line, indent_of, node_head};
use crate::tools::fix::command::choose_path;
use crate::tools::fix::verify::{last_replace, note_fix, note_refused, refusal_of};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::sym_less;
use crate::tools::query::positions::{line_end, line_start};
use crate::tools::query::refs::ref_in;
use crate::tools::query::show::text_start;
use crate::tools::reexports::reached_through;
use crate::tools::tidyimports::{relative_style, styled_path};

// The unknown `name` in module m is item `name` of the module with path
// `path` (its help says `add `use PATH::name;``).
pub fn note_missing_use(m: i64, path: i64, name: i64, pcx: &mut Ctx<Comp>) {
    // (0.18: `fix --suggested --at FILE:LINE`, the error at that line)
    if !fix_at_ok(err_pos(pcx), pcx) {
        return;
    }
    let mut i: i64 = 0;
    while i < pcx.missing.count {
        if unsafe {
            (*pcx.missing.data.add(i as usize)) == m
                && (*pcx.missing.data.add((i + 1) as usize)) == path
                && (*pcx.missing.data.add((i + 2) as usize)) == name
        } {
            pcx.missing_at.push(i / 3);
            pcx.missing_at.push(err_pos(pcx));
            return;
        }
        i += 3;
    }
    pcx.missing_at.push(pcx.missing.count / 3);
    pcx.missing_at.push(err_pos(pcx));
    pcx.missing.push(m);
    pcx.missing.push(path);
    pcx.missing.push(name);
}

// Binding b (B_PRIVATE) was used where it is private.
pub fn note_private(b: i64, pcx: &mut Ctx<Comp>) {
    if binding_kind(b) != B_PRIVATE {
        return;
    }
    for i in 0..pcx.private.count {
        if unsafe { (*pcx.private.data.add(i as usize)) == b } {
            return;
        }
    }
    pcx.private.push(b);
}

// Field f (a Field node) was used where it is private.
pub fn note_private_field(f: i64, pcx: &mut Ctx<Comp>) {
    if f <= 0 {
        return;
    }
    for i in 0..pcx.private_fields.count {
        if pcx.private_fields.get(i) == f {
            return;
        }
    }
    pcx.private_fields.push(f);
}

// The attribute SRC[start..end) is obsolete.
pub fn note_obsolete_attr(start: i64, end: i64, pcx: &mut Ctx<Comp>) {
    pcx.obsolete_attrs.push(start);
    pcx.obsolete_attrs.push(end);
}

// The edits deleting the obsolete attributes: the attribute's line when
// it is alone on it, else the attribute and the blanks after it; their
// number.
pub fn obsolete_attr_edits(pcx: &mut Ctx<Comp>) -> i64 {
    let mut fixes: i64 = 0;
    let mut i: i64 = 0;
    while i + 1 < pcx.obsolete_attrs.count {
        let mut start = pcx.obsolete_attrs.get(i);
        let mut end = pcx.obsolete_attrs.get(i + 1);
        i += 2;
        if !user_pos(start, pcx) || !ref_in(start, pcx) {
            continue;
        }
        let f = file_of_pos(start, pcx);
        let first = pcx.files[f as usize].start;
        let last = pcx.files[f as usize].end;
        let mut s = start;
        while s > first
            && (get_src()[(s - 1) as usize] == b' ' || get_src()[(s - 1) as usize] == b'\t') {
            s -= 1;
        }
        let mut e = end;
        while e < last && (get_src()[e as usize] == b' ' || get_src()[e as usize] == b'\t') {
            e += 1;
        }
        if (s == first || get_src()[(s - 1) as usize] == b'\n') && e < last
            && get_src()[e as usize] == b'\n' {
            // (alone on its line: the line)
            start = s;
            end = e + 1;
        } else {
            end = e;
        }
        if edit_replace(start, end, buf_new(), pcx) {
            fixes += 1;
        }
    }
    fixes
}

// Whether module m passes --in: its file, or it or a module it is in (a
// child of the module given passes, as for ref_in; 0.13).
fn module_in(m: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if pcx.opt_in == 0 as *mut u8 {
            return true;
        }
        let mut a = m;
        while a >= 0 {
            if (*pcx.in_module.data.add(a as usize)) != 0 {
                return true;
            }
            a = if a > 0 { pcx.modules[a as usize].parent } else { -1 };
        }
        for f in 0..pcx.files.len() {
            if pcx.files[f].module == m && (*pcx.in_file.data.add(f)) != 0 {
                return true;
            }
        }
        false
    }
}

// Whether module m's code is in a file of the program (not std's, the C
// headers').
fn user_module(m: i64, pcx: &Ctx<Comp>) -> bool {
    m >= 0 && !within_std(m, pcx) && m != pcx.c_module
}

fn user_pos(pos: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { (*pcx.files[file_of_pos(pos, pcx) as usize].path.add(0)) != b'<' }
}

// ---- Missing imports ----

// The path of Use node u (its segments before the imported names), as a
// symbol: `crate::a::b`.
fn use_path(u: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let path = pcx.nodes[u as usize].c;
    let out = buf_new();
    for i in 0..pcx.nodes[path as usize].count {
        if i > 0 {
            buf_str(out, c"::");
        }
        buf_bytes(out, sym_text(pcx.nodes[child(path, i, pcx) as usize].a, pcx));
    }
    intern(buf_slice(out), pcx)
}

// Whether Use node u, in module m, imports from the module of path p
// (`crate::a`; written `a` in the root module).
fn same_path(u: i64, m: i64, p: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let up = use_path(u, pcx);
    if up == p || crate::tools::tidyimports::use_abs_path(u, m, tcx, pcx) == p {
        return true;
    }
    let t = sym_text(p, pcx);
    let w = sym_text(up, pcx);
    m == 0 && t.len() as i64 == w.len() as i64 + 7
        && crate::tools::proc::same_bytes(&t[7..t.len()], w) && t[0] == b'c' && t[5] == b':'
}

// The Use items (not header imports, not `*`) of module m, by position.
fn module_uses(m: i64, out: &mut IntVec, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Use && pcx.nodes[n as usize].d != 2
            && module_of(n, pcx) == m
            && user_pos(pcx.nodes[n as usize].start, pcx) {
            out.push(n);
        }
    }
}

// The edits adding the missing imports; their number.
fn missing_use_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut fixes: i64 = 0;
        let mut done = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // (0.16: the module, among several with the name: choose_path)
        let mut i: i64 = 0;
        while i < pcx.missing.count {
            let m = (*pcx.missing.data.add(i as usize));
            if user_module(m, pcx) && module_in(m, pcx) {
                (*pcx.missing.data.add((i + 1) as usize)) = choose_path(m,
                    (*pcx.missing.data.add((i + 2) as usize)),
                    (*pcx.missing.data.add((i + 1) as usize)), tcx, pcx);
            }
            i += 3;
        }
        i = 0;
        while i < pcx.missing.count {
            let m = (*pcx.missing.data.add(i as usize));
            let p = (*pcx.missing.data.add((i + 1) as usize));
            i += 3;
            if p < 0 || !user_module(m, pcx) || !module_in(m, pcx) {
                continue;
            }
            // (once per module and path, with all its names)
            let mut seen = false;
            let mut k: i64 = 0;
            while k < done.count {
                if (*done.data.add(k as usize)) == m && (*done.data.add((k + 1) as usize)) == p {
                    seen = true;
                }
                k += 2;
            }
            if seen {
                continue;
            }
            done.push(m);
            done.push(p);
            let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut entries = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut j: i64 = 0;
            while j < pcx.missing.count {
                // (0.25.2.1: not a name a `use` of m imports already, nor
                // one a fix of a `use` line of m spells: imported twice)
                if (*pcx.missing.data.add(j as usize)) == m
                    && (*pcx.missing.data.add((j + 1) as usize)) == p
                    && !imported_in(m, (*pcx.missing.data.add((j + 2) as usize)), pcx) {
                    names.push((*pcx.missing.data.add((j + 2) as usize)));
                    entries.push(j / 3);
                }
                j += 3;
            }
            if names.count == 0 {
                continue;
            }
            sort_syms(&mut names, pcx);
            if add_import(m, p, names, tcx, pcx) {
                fixes += names.count;
                let e = last_replace(pcx);
                for x in 0..entries.count {
                    let mut at: i64 = 0;
                    let mut first = x == 0;
                    while at + 1 < pcx.missing_at.count {
                        if (*pcx.missing_at.data.add(at as usize))
                            == (*entries.data.add(x as usize)) {
                            note_fix(e, 0, if first { names.count } else { 0 },
                                (*pcx.missing_at.data.add((at + 1) as usize)), tcx);
                            first = false;
                        }
                        at += 2;
                    }
                }
            }
        }
        fixes
    }
}

// (0.25.2.1) Whether a `use` of module m imports `name` already (it may
// not resolve: a wrong path), or a fix of one of its `use` lines writes
// it (a did-you-mean of the imported name): an import of it would be a
// second one.
fn imported_in(m: i64, name: i64, pcx: &mut Ctx<Comp>) -> bool {
    // UNSAFE: NODES is the parser's table of nodes, a raw pointer (front/ast); SUGGESTED a static var (base/diag).
    // SAFETY: u is a Use node module_uses found and it a child of it (0 <= n < NODE_COUNT); SUGGESTED is read in fours below its count.
    unsafe {
        let mut uses = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        module_uses(m, &mut uses, pcx);
        for k in 0..uses.count {
            let u = (*uses.data.add(k as usize));
            for i in 0..pcx.nodes[u as usize].count {
                let it = child(u, i, pcx);
                if (if pcx.nodes[it as usize].b != 0 { pcx.nodes[it as usize].b }
                    else { pcx.nodes[it as usize].a }) == name {
                    return true;
                }
            }
            let mut s: i64 = 0;
            while s + 3 < pcx.suggested.count {
                let at = (*pcx.suggested.data.add((s + 1) as usize));
                if at >= pcx.nodes[u as usize].start && at < pcx.nodes[u as usize].end
                    && crate::tools::proc::same_bytes(
                        buf_slice((*pcx.suggested.data.add((s + 3) as usize))),
                        sym_text(name, pcx)) {
                    return true;
                }
                s += 4;
            }
        }
        false
    }
}

fn sort_syms(v: &mut IntVec, pcx: &Ctx<Comp>) {
    unsafe {
        for k in 1..v.count {
            let mut j = k;
            while j > 0
                && sym_less((*v.data.add(j as usize)), (*v.data.add((j - 1) as usize)), pcx) {
                let t = (*v.data.add(j as usize));
                (*v.data.add(j as usize)) = (*v.data.add((j - 1) as usize));
                (*v.data.add((j - 1) as usize)) = t;
                j -= 1;
            }
        }
    }
}

// The edit importing `names` from the module of path p into module m:
// into a `use` of that module, else a `use` line after m's last one (or
// before its first item).
fn add_import(m: i64, p: i64, names: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut uses = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        module_uses(m, &mut uses, pcx);
        for k in 0..uses.count {
            let u = (*uses.data.add(k as usize));
            if pcx.nodes[u as usize].b == 1 || !same_path(u, m, p, tcx, pcx)
                || pcx.nodes[u as usize].count == 0 {
                continue;
            }
            let last = child(u, pcx.nodes[u as usize].count - 1, pcx);
            let braces = brace_after(pcx.nodes[pcx.nodes[u as usize].c as usize].end,
                pcx.nodes[u as usize].end);
            let text = buf_new();
            if braces {
                // `use p::{a, b};` -> `use p::{a, b, NAME};`
                for x in 0..names.count {
                    buf_str(text, c", ");
                    buf_bytes(text, sym_text((*names.data.add(x as usize)), pcx));
                }
                return edit_replace(pcx.nodes[last as usize].end, pcx.nodes[last as usize].end,
                    text, pcx);
            }
            // `use p::a;` (or `use p::a as b;`) -> `use p::{a, NAME};`
            let mut semi = pcx.nodes[u as usize].end;
            while semi > pcx.nodes[last as usize].start && get_src()[(semi - 1) as usize] != b';' {
                semi -= 1;
            }
            buf_byte(text, b'{');
            buf_bytes(text,
                &get_src()[pcx.nodes[last as usize].start as usize..(semi - 1) as usize]);
            for x in 0..names.count {
                buf_str(text, c", ");
                buf_bytes(text, sym_text((*names.data.add(x as usize)), pcx));
            }
            buf_byte(text, b'}');
            return edit_replace(pcx.nodes[last as usize].start, semi - 1, text, pcx);
        }
        // A new line.
        let line = buf_new();
        buf_str(line, c"use ");
        // (0.14: a child module's path as the module writes them)
        let styled = styled_path(p, m, relative_style(m, tcx, pcx), tcx, pcx);
        buf_bytes(line, sym_text(styled, pcx));
        buf_str(line, c"::");
        if names.count > 1 {
            buf_byte(line, b'{');
        }
        for x in 0..names.count {
            if x > 0 {
                buf_str(line, c", ");
            }
            buf_bytes(line, sym_text((*names.data.add(x as usize)), pcx));
        }
        if names.count > 1 {
            buf_byte(line, b'}');
        }
        buf_byte(line, b';');
        if uses.count > 0 {
            let u = (*uses.data.add((uses.count - 1) as usize));
            let at = line_end(pcx.nodes[u as usize].end - 1, pcx);
            let text = buf_new();
            buf_byte(text, b'\n');
            buf_bytes(text, indent_of(pcx.nodes[u as usize].start, pcx));
            buf_bytes(text, buf_slice(line));
            return edit_replace(at, at, text, pcx);
        }
        // Before the module's first item (and its comments).
        let mut first: i64 = -1;
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].module == m && pcx.defs[d as usize].parent < 0
                && user_pos(pcx.defs[d as usize].start, pcx)
                && (first < 0 || pcx.defs[d as usize].start < pcx.defs[first as usize].start) {
                first = d;
            }
        }
        if first < 0 {
            return false;
        }
        let at = line_start(text_start(first, pcx), pcx);
        let text = buf_new();
        buf_bytes(text, indent_of(pcx.defs[first as usize].start, pcx));
        buf_bytes(text, buf_slice(line));
        buf_str(text, c"\n\n");
        edit_replace(at, at, text, pcx)
    }
}

// Whether a `{` is in SRC[from..to).
fn brace_after(from: i64, to: i64) -> bool {
    for p in from..to {
        if get_src()[p as usize] == b'{' {
            return true;
        }
    }
    false
}

// ---- Unused imports ----

// Whether identifier `name` is written in the module of file f outside
// Use node u.
// (0.25.2: `check` reports unused imports; the times each file writes
// each imported name are counted in one pass over the tokens, which are
// not in position order: std's sections, derived impls and test code are
// lexed after the files.)
fn named_in_file(name: i64, f: i64, u: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.named_tokens != pcx.toks.len() as i64 || pcx.named_syms < pcx.syms.len() as i64 {
        count_imported_names(pcx);
    }
    // (by module: a module may have several files, std's root its flat/
    // ones, a root given with other files)
    let total = pcx.named.get(named_key(name, file_at_index(f, pcx).module));
    // (the times u itself writes it: its path's words, its names)
    let mut inside: i64 = 0;
    let path = node_at(node_at(u, pcx).c, pcx);
    for i in 0..path.count {
        if node_at(child(node_at(u, pcx).c, i, pcx), pcx).a == name {
            inside += 1;
        }
    }
    for k in 0..node_at(u, pcx).count {
        let id = node_at(child(u, k, pcx), pcx);
        // (0.27.2: `use a::{self}` names `a` once, in its path: the
        // `self` entry, whose name is the path's last, writes no word)
        if id.end - id.start == 4
            && crate::base::get_src()[id.start as usize..id.end as usize] == b"self" {
            continue;
        }
        if id.a == name {
            inside += 1;
        }
        if id.b == name {
            inside += 1;
        }
    }
    total > inside
}

fn named_key(name: i64, m: i64) -> i64 {
    name * 1048576 + m + 1
}

fn count_imported_names(pcx: &mut Ctx<Comp>) {
    pcx.named = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    pcx.named_tokens = pcx.toks.len() as i64;
    pcx.named_syms = pcx.syms.len() as i64;
    // (the names imported: the only ones counted)
    let mut wanted = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for u in 1..pcx.nodes.len() as i64 {
        let n = node_at(u, pcx);
        if n.kind == NodeKind::Use && n.d != 2 {
            for k in 0..n.count {
                let id = node_at(child(u, k, pcx), pcx);
                wanted.put((if id.b != 0 { id.b } else { id.a }) + 1, 1);
            }
        }
    }
    // (the tokens come in runs, each in one file)
    let mut module: i64 = 0;
    let mut lo: i64 = 0;
    let mut hi: i64 = 0;
    for i in 0..pcx.toks.len() as i64 {
        let t = token_at_index(i, pcx);
        // (0.28.0: not std's text, whose imports are never reported:
        // its tokens count only for its own modules)
        if t.kind != Tok::Ident || t.start >= pcx.std_start && t.start < pcx.std_end
            || wanted.get(t.value as i64 + 1) == 0 {
            continue;
        }
        if t.start < lo || t.start >= hi {
            let file = file_at_index(file_of_pos(t.start, pcx), pcx);
            module = file.module;
            lo = file.start;
            hi = file.end;
        }
        let key = named_key(t.value as i64, module);
        pcx.named.put(key, pcx.named.get(key) + 1);
    }
    // (0.26.2: a name in a format literal's hole, `"{NAME}"`, one of the
    // Ident nodes front/check/format.vl made at its place in the text)
    for n in 1..pcx.nodes.len() as i64 {
        let interp = node_at(n, pcx);
        if interp.kind != NodeKind::Interp || get_src()[interp.start as usize] == b'f' {
            continue;
        }
        for k in 0..interp.count {
            let hole = node_at(child(n, k, pcx), pcx);
            if hole.kind != NodeKind::InterpHole {
                continue;
            }
            for x in [hole.a, hole.g, hole.h] {
                if x <= 0 || node_at(x, pcx).kind != NodeKind::Ident
                    || wanted.get(node_at(x, pcx).a + 1) == 0
                    || node_at(x, pcx).start <= interp.start
                    || node_at(x, pcx).start >= interp.end {
                    continue;
                }
                let key = named_key(node_at(x, pcx).a,
                    file_at_index(file_of_pos(node_at(x, pcx).start, pcx), pcx).module);
                pcx.named.put(key, pcx.named.get(key) + 1);
            }
        }
    }
}

// Node n, token i, file f (copies).
fn node_at(n: i64, pcx: &Ctx<Comp>) -> crate::front::ast::Node {
    pcx.nodes[n as usize]
}

fn token_at_index(i: i64, pcx: &Ctx<Comp>) -> crate::front::lexer::Token {
    // UNSAFE: TOKS is the lexer's table of tokens, a raw pointer.
    // SAFETY: 0 <= i < TOK_COUNT (the caller's loop), the tokens lexed.
    unsafe { pcx.toks[i as usize] }
}

fn file_at_index(f: i64, pcx: &Ctx<Comp>) -> crate::base::SourceFile {
    pcx.files[f as usize]
}

// (0.27.2) Whether import `local` of Use node u, in a rust-edition file,
// names a trait: it is used though no word names it, a method call
// through it (`w.write_all(..)` with `use std::io::Write`) or a blanket
// impl's or default method's needing it in scope (F9.2), which this
// count of words does not see; such an import is not reported.
fn rust_trait_import(u: i64, local: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.edition == 0 || !crate::front::rust::rust_at(pcx.nodes[u as usize].start, pcx) {
        return false;
    }
    let m = module_of(u, pcx);
    let b = crate::front::modules::lookup::lookup_item(m, local, m, pcx);
    if crate::front::modules::lookup::binding_kind(b) != crate::front::modules::lookup::B_ITEM {
        return false;
    }
    let item = crate::front::types::item_node_of(crate::front::modules::lookup::binding_value(b),
        pcx);
    item > 0 && pcx.nodes[item as usize].kind == NodeKind::Trait
}

// The edits removing the imports nothing in their file names (a name
// written anywhere in the file keeps its import: a local of that name
// too); their number. `pub use` items are kept (other modules may use
// what they bring).
fn unused_import_edits(only_report: *mut IntVec, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut fixes: i64 = 0;
        for u in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[u as usize].kind != NodeKind::Use || pcx.nodes[u as usize].d == 2
                || pcx.nodes[u as usize].b == 1
                || (pcx.nodes[u as usize].p & ITEM_PUBLIC) != 0 {
                continue;
            }
            if !user_pos(pcx.nodes[u as usize].start, pcx) || !user_module(module_of(u, pcx), pcx)
                || !ref_in(pcx.nodes[u as usize].start, pcx) {
                continue;
            }
            let f = file_of_pos(pcx.nodes[u as usize].start, pcx);
            let n = pcx.nodes[u as usize].count;
            let mut unused = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for k in 0..n {
                let id = child(u, k, pcx);
                let local = if pcx.nodes[id as usize].b != 0 { pcx.nodes[id as usize].b }
                    else { pcx.nodes[id as usize].a };
                // (an import other modules import or name through is used:
                // `use crate::name` reaching the root's import, 0.12)
                if !named_in_file(local, f, u, pcx)
                    && !reached_through(module_of(u, pcx), local, pcx)
                    && !rust_trait_import(u, local, pcx) {
                    unused.push(k);
                }
            }
            if unused.count == 0 {
                continue;
            }
            if only_report != 0 as *mut IntVec {
                for k in 0..unused.count {
                    only_report.push(child(u, (*unused.data.add(k as usize)), pcx));
                }
                continue;
            }
            fixes += remove_use_names(u, unused, pcx);
        }
        fixes
    }
}

// The edits removing names `unused` (their indexes) of Use node u: the
// whole `use` when it is all of them, `use p::a;` for `use p::{a, b};`
// when one is left (0.17: also for rewrite). The number removed.
pub fn remove_use_names(u: i64, unused: IntVec, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let n = pcx.nodes[u as usize].count;
        if unused.count == n {
            let head = node_head(pcx.nodes[u as usize].start, pcx);
            if blank_before(head, pcx) && blank_after(pcx.nodes[u as usize].end, pcx) {
                delete_lines(line_start(head, pcx), pcx.nodes[u as usize].end, pcx);
            } else {
                edit_replace(head, pcx.nodes[u as usize].end, buf_new(), pcx);
            }
            return n;
        }
        if n - unused.count == 1 && one_line_braces(u, pcx) {
            // (one name left: `use p::{a};` is `use p::a;`)
            let mut kept: i64 = 0;
            for k in 0..n {
                let mut gone = false;
                for x in 0..unused.count {
                    if (*unused.data.add(x as usize)) == k {
                        gone = true;
                    }
                }
                if !gone {
                    kept = child(u, k, pcx);
                }
            }
            let mut open = pcx.nodes[pcx.nodes[u as usize].c as usize].end;
            while get_src()[open as usize] != b'{' {
                open += 1;
            }
            let mut close = pcx.nodes[u as usize].end;
            while get_src()[close as usize] != b'}' {
                close -= 1;
            }
            let text = buf_new();
            buf_bytes(text,
                &get_src()[
                    pcx.nodes[kept as usize].start as usize..pcx.nodes[kept as usize].end as usize]);
            return if edit_replace(open, close + 1, text, pcx) { unused.count } else { 0 };
        }
        let mut fixes: i64 = 0;
        for k in 0..unused.count {
            if remove_use_name(u, (*unused.data.add(k as usize)), pcx) {
                fixes += 1;
            }
        }
        fixes
    }
}

// Whether Use node u lists its names between braces, on one line.
fn one_line_braces(u: i64, pcx: &Ctx<Comp>) -> bool {
    brace_after(pcx.nodes[pcx.nodes[u as usize].c as usize].end, pcx.nodes[u as usize].end)
        && same_line(pcx.nodes[u as usize].start, pcx.nodes[u as usize].end, pcx)
}

// Whether only blanks are before pos on its line.
fn blank_before(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let mut p = line_start(pos, pcx);
    while p < pos && (get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t') {
        p += 1;
    }
    p == pos
}

// Whether only blanks (or a comment) are after pos on its line.
fn blank_after(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let e = line_end(pos, pcx);
    let mut p = pos;
    while p < e
        && (get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t'
            || get_src()[p as usize] == b'\r') {
        p += 1;
    }
    p == e || (p + 1 < e && get_src()[p as usize] == b'/' && get_src()[(p + 1) as usize] == b'/')
}

// The edit removing name k of Use node u (one of several between braces),
// with its separator: `a, b, c` loses `b, ` (its line, when it is alone
// on it), the last loses `, c`.
pub fn remove_use_name(u: i64, k: i64, pcx: &mut Ctx<Comp>) -> bool {
    let id = child(u, k, pcx);
    let a = pcx.nodes[id as usize].start;
    let b = pcx.nodes[id as usize].end;
    let n = pcx.nodes[u as usize].count;
    if k + 1 < n {
        let next = pcx.nodes[child(u, k + 1, pcx) as usize].start;
        if blank_before(a, pcx) && !same_line(b, next, pcx) {
            // alone on its line: the line
            return edit_replace(line_start(a, pcx), after_line(b, pcx), buf_new(), pcx);
        }
        if same_line(b, next, pcx) {
            return edit_replace(a, next, buf_new(), pcx);
        }
        // last on its line: `, NAME` (from the end of the one before)
        if k > 0 && same_line(pcx.nodes[child(u, k - 1, pcx) as usize].end, a, pcx) {
            return edit_replace(pcx.nodes[child(u, k - 1, pcx) as usize].end, b, buf_new(), pcx);
        }
        return edit_replace(a, next, buf_new(), pcx);
    }
    // The last name: from the end of the one before.
    let prev = pcx.nodes[child(u, k - 1, pcx) as usize].end;
    if blank_before(a, pcx) && !same_line(prev, a, pcx) {
        let mut e = b;
        if get_src()[e as usize] == b',' {
            e += 1;
        }
        if blank_after(e, pcx) {
            return edit_replace(line_start(a, pcx), after_line(b, pcx), buf_new(), pcx);
        }
    }
    edit_replace(prev, b, buf_new(), pcx)
}

fn same_line(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    line_start(a, pcx) == line_start(b, pcx)
}

// ---- pub ----

// The edits making the private items used elsewhere public; their number.
fn pub_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut fixes: i64 = 0;
        for i in 0..pcx.private.count {
            let key = binding_value((*pcx.private.data.add(i as usize)));
            let mut node = item_node_of(key, pcx);
            if node == 0 {
                // a module: its `mod` item
                for m in 1..module_count(pcx) {
                    if pcx.modules[m as usize].key == key
                        && (*pcx.mod_def.data.add(m as usize)) >= 0 {
                        node = pcx.defs[(*pcx.mod_def.data.add(m as usize)) as usize].node;
                    }
                }
            }
            if node == 0 || (pcx.nodes[node as usize].p & ITEM_PUBLIC) != 0
                || !user_pos(pcx.nodes[node as usize].start, pcx)
                || !ref_in(pcx.nodes[node as usize].start, pcx) {
                continue;
            }
            let text = buf_new();
            // (0.26.2: `pub(self) fn` becomes `pub fn`)
            let (ss, se) = crate::front::modules::vis::self_span(pcx.nodes[node as usize].start);
            buf_str(text, if ss >= 0 { c"pub" } else { c"pub " });
            if edit_replace(if ss >= 0 { ss } else { pcx.nodes[node as usize].start },
                if ss >= 0 { se } else { pcx.nodes[node as usize].start }, text, pcx) {
                note_fix(last_replace(pcx), 3, 1, -1, tcx);
                fixes += 1;
            }
        }
        // (0.26.0) the private fields used elsewhere
        for i in 0..pcx.private_fields.count {
            let f = (*pcx.private_fields.data.add(i as usize));
            if (pcx.nodes[f as usize].p & ITEM_PUBLIC) != 0
                || !user_pos(pcx.nodes[f as usize].start, pcx)
                || !ref_in(pcx.nodes[f as usize].start, pcx) {
                continue;
            }
            let text = buf_new();
            let (ss, se) = crate::front::modules::vis::self_span(pcx.nodes[f as usize].start);
            buf_str(text, if ss >= 0 { c"pub" } else { c"pub " });
            if edit_replace(if ss >= 0 { ss } else { pcx.nodes[f as usize].start },
                if ss >= 0 { se } else { pcx.nodes[f as usize].start }, text, pcx) {
                note_fix(last_replace(pcx), 3, 1, -1, tcx);
                fixes += 1;
            }
        }
        // (0.26.2) the restricted ones used outside their restriction
        fixes += crate::tools::fix::vis::widen_edits(tcx, pcx);
        fixes
    }
}

// The imports nothing names (query unused): their Ident nodes, into out.
pub fn unused_imports(out: *mut IntVec, pcx: &mut Ctx<Comp>) {
    unused_import_edits(out, pcx);
}

// (0.25.2) `check` and a build: each import nothing in its file names is
// a warning, `use.unused` (an error with --deny-warnings), whose try:
// line removes them all; not std's, not a `pub use`, not one that failed
// (an error already).
pub fn report_unused_imports(pcx: &mut Ctx<Comp>) {
    let mut ids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    // (every one: a query's --in, not read yet when the program is
    // checked, is for its own answer)
    let opt_in = pcx.opt_in;
    pcx.opt_in = 0 as *mut u8;
    unused_import_edits(&mut ids, pcx);
    pcx.opt_in = opt_in;
    if ids.count == 0 {
        return;
    }
    let tries = buf_new();
    buf_tool_command(tries, c_slice(c"fix --only unused"), true, pcx);
    for id in (&mut ids).items() {
        let n = node_at(id, pcx);
        let local = if n.b != 0 { n.b } else { n.a };
        if name_failed(local, pcx) {
            continue;
        }
        let msg = buf_new();
        buf_str(msg, c"unused import '");
        buf_bytes(msg, sym_text(local, pcx));
        buf_str(msg, c"': nothing in this file names it");
        buf_byte(msg, 0);
        report_error_tries(n.start, 7001, c"use.unused", buf_slice(msg).ptr,
            c"remove it (`volec fix` removes every unused import)", buf_slice(tries), true, pcx);
    }
}

// ---- Suggested fixes (0.18) ----

// The edits of the errors' exact fixes (base::diag's SUGGESTED: a name
// a did-you-mean offers alone, a conversion, a path from the crate's
// root, a Rust spelling respelled...); their number. (0.25.2.1) Only
// those of errors with a code in CODES when it is set (`--codes`); a
// conversion that loses the value is not made (verify::refusal_of, a
// `note fix.refused`); each fix made is noted for verify_fixes.
pub fn suggested_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut fixes: i64 = 0;
        let mut i: i64 = 0;
        let mut k: i64 = 0;
        while i + 3 < pcx.suggested.count {
            let pos = (*pcx.suggested.data.add(i as usize));
            let start = (*pcx.suggested.data.add((i + 1) as usize));
            let end = (*pcx.suggested.data.add((i + 2) as usize));
            let text = (*pcx.suggested.data.add((i + 3) as usize));
            let kind: i64 = if k
                < pcx.suggested_kind.count { (*pcx.suggested_kind.data.add(k as usize)) }
                else { -1 };
            i += 4;
            k += 1;
            if !user_pos(start, pcx) || (pcx.opt_in != 0 as *mut u8 && !ref_in(start, pcx))
                || !code_taken(kind, tcx, pcx) {
                continue;
            }
            let why = refusal_of(start, end, text, pcx);
            if why.len() > 0 {
                note_refused(pos, buf_slice(text), why, tcx, pcx);
                continue;
            }
            if edit_replace(start, end, text, pcx) {
                note_fix(last_replace(pcx), 10, 1, pos, tcx);
                fixes += 1;
            }
        }
        fixes
    }
}

// Whether the fixes of errors of code `kind` (a symbol) are made.
fn code_taken(kind: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if tcx.codes < 0 {
        return true;
    }
    if kind < 0 {
        return false;
    }
    let want = buf_new();
    buf_byte(want, b',');
    buf_bytes(want, sym_text(kind, pcx));
    buf_byte(want, b',');
    let all = buf_slice(tcx.codes);
    let w = buf_slice(want);
    let mut p: i64 = 0;
    while p + w.len() as i64 <= all.len() as i64 {
        if crate::tools::proc::same_bytes(&all[p as usize..(p + w.len() as i64) as usize], w) {
            return true;
        }
        p += 1;
    }
    false
}
