// `volec fix --only rawptr` (0.26.4, the plan's item e): the legacy raw
// pointer parameters, `p: *T` and `p: sink *T` of the program's own safe
// functions, decided by what the function does with them:
//
//   read     only read through (`p.f`, `*p`, a let receiver): `p: T`, a
//            let parameter, the calls' `&x` becoming `x`;
//   write    written through (`p.f = v`, `*p = v`, an inout receiver,
//            passed on to a parameter that is written): `p: inout T`, the
//            calls' `&x` kept;
//   escape   the pointer itself is used: stored (a `let`, a field, an
//            aggregate), returned, cast, compared, indexed or offset
//            (`p[i]`, `&p[i]`), assigned, captured by a closure, passed to
//            C, to an `unsafe fn`, to a function value or on to a raw
//            parameter: it stays `*T`;
//   caller   read or written, but a call gives it something other than the
//            address of a place: a raw pointer value (a local, a field, a
//            call's result), null or a C string, or a place reached through
//            a raw pointer;
//   fixed    its signature cannot change here: an `unsafe fn`, an exported
//            or C function, one used as a value, `main`, a closure's, a
//            trait's or its impls', a `**T` / `*[T]`, an `inout *T`.
//
// The classes are a fixed point over the whole program, callees first: a
// parameter passed on to one that is written is written, to one that stays
// raw escapes. `--only rawptr-list` (a dry run) prints each parameter:
// FILE:LINE, its class, the first reason, the function, the parameter, the
// kind of T (u8, copy: a plain value of at most 16 bytes, big: a larger
// plain value, which a let parameter copies, owned: lent by a let).

use crate::base::{
    SRC, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{BLOCK_UNSAFE, FN_UNSAFE, NODE_REF_MUT, NodeKind, child};
use crate::front::check::Res;
use crate::front::conv::{CONV_IN_OUT, copyable, param_conv};
use crate::front::generics::instantiate::{node_field_a, node_field_b, node_field_c};
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::traits::impl_of_fn;
use crate::front::types::{REF_MUT, TY_U8, TyKind, fn_param, type_size};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::defs::{K_TRAIT_FN, def_of_node};
use crate::tools::query::diagnostics::diag;
use crate::tools::query::refs::ref_in;

// The flags of a parameter (per function node and index): written through;
// a reason it escapes (R_*); a reason a call gives it no place (C_*).
const F_WRITE: i64 = 1;
const R_BIND: i64 = 2;
const R_RETURN: i64 = 4;
const R_CAST: i64 = 8;
const R_COMPARE: i64 = 16;
const R_INDEX: i64 = 32;
const R_RAWCALL: i64 = 64;
const R_VALUE: i64 = 128;
const R_CLOSURE: i64 = 256;
const R_ASSIGN: i64 = 512;
const R_OTHER: i64 = 1024;
// (a call gives it null, a C string or the address of a place reached
// through a raw pointer, `&q.f`, `&TABLE[i]`: no access can be)
const R_GIVEN: i64 = 32768;
// (given to a call inside the arguments of another call that takes the
// same parameter, `f(&cx, g(&cx))`: two inout accesses would conflict,
// own.conflict; a raw one is no loan)
const R_NESTED: i64 = 65536;
const R_ALL: i64 = 2046 | R_GIVEN | R_NESTED;
const C_RAW: i64 = 2048;
const C_NULL: i64 = 4096;
const C_THROUGH: i64 = 8192;
const C_OTHER: i64 = 16384;
const C_ALL: i64 = 30720;

// The classes.
pub const RP_READ: i64 = 0;
pub const RP_WRITE: i64 = 1;
pub const RP_ESCAPE: i64 = 2;
pub const RP_CALLER: i64 = 3;
pub const RP_FIXED: i64 = 4;

// Why a signature is fixed (fixed_why).
const X_NONE: i64 = 0;
const X_UNSAFE: i64 = 1;
const X_EXPORT: i64 = 2;
const X_VALUE: i64 = 3;
const X_MAIN: i64 = 4;
const X_CLOSURE: i64 = 5;
const X_TRAIT: i64 = 6;
const X_NESTED: i64 = 7;
const X_INOUT: i64 = 8;
const X_SELF: i64 = 9;

// The kinds of T.
const T_U8: i64 = 0;
const T_COPY: i64 = 1;
const T_BIG: i64 = 2;
const T_OWNED: i64 = 3;

// Contexts of a use of a value.
const CX_READ: i64 = 0;
const CX_BIND: i64 = 1;
const CX_RET: i64 = 2;

// The phases: marking the flags, then the calls' arguments.
const PH_MARK: i64 = 0;
const PH_CALLS: i64 = 1;
const PH_EDIT: i64 = 2;

// ---- functions ----

fn f_node(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer (front::types).
    // SAFETY: f is below FN_COUNT, the table's length, wherever these are called.
    unsafe { pcx.fns[f].node }
}

fn f_tmpl(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f].tmpl }
}

fn f_params(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f].param_count }
}

fn f_generic(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f].generic }
}

fn f_extern(f: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f].is_extern }
}

fn f_export(f: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f].export }
}

fn f_unsafe(f: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { (pcx.fns[f].attrs & FN_UNSAFE) != 0 }
}

fn f_self_ty(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f].self_ty }
}

// The template's node of f (an instance's flags are its template's).
fn base_node(f: i64, pcx: Ctx<Comp>) -> i64 {
    let t = f_tmpl(f, pcx);
    if t > 0 { f_node(t - 1, pcx) } else { f_node(f, pcx) }
}

fn has_body(f: i64, pcx: Ctx<Comp>) -> bool {
    if f < 0 || f >= pcx.fn_count || f_extern(f, pcx) {
        return false;
    }
    let item = f_node(f, pcx);
    item > 0 && pcx.nodes[item].kind == NodeKind::Fn && pcx.nodes[item].c != 0
}

fn in_std(pos: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: file_of_pos gives the index of a loaded file, and every path is NUL-terminated.
    unsafe { pcx.files[file_of_pos(pos, pcx)].path[0] == '<' }
}

// Why f's signature cannot change (X_NONE: it can).
fn fixed_why(f: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if f_unsafe(f, pcx) {
        return X_UNSAFE;
    }
    if f_export(f, pcx) {
        return X_EXPORT;
    }
    let node = base_node(f, pcx);
    if tcx.rawptr_as_value.get(node + 1) != 0 {
        return X_VALUE;
    }
    let name = sym_text(pcx.nodes[node].a, pcx);
    if name == "main" && f_self_ty(f, pcx) == 0 {
        return X_MAIN;
    }
    let d = def_of_node(node, tcx, pcx);
    if d < 0 {
        return X_CLOSURE;
    }
    if pcx.defs[d].kind == K_TRAIT_FN {
        return X_TRAIT;
    }
    let im = impl_of_fn(f, pcx);
    // UNSAFE: IMPLS is the checker's table of impl blocks, a raw pointer (front::traits).
    // SAFETY: impl_of_fn gives an index into it, or -1, tested first.
    if im >= 0 && unsafe { pcx.traits_impls[im].tr } >= 0 {
        return X_TRAIT;
    }
    X_NONE
}

// Whether parameter i of f is a raw `*T` (by its type): 0 no, 1 one this
// fix may decide, or the X_* reason it cannot (a pointer to a pointer, a
// slice or a function; an `inout *T`).
fn ptr_param(f: i64, i: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if i >= f_params(f, pcx) || i >= 63 {
        return 0;
    }
    let item = f_node(f, pcx);
    if item <= 0 || i >= pcx.nodes[item].count {
        return 0;
    }
    let t = fn_param(f, i, pcx);
    if t <= 0 || pcx.types[t].kind != TyKind::Ptr || pcx.types[t].b != 0 {
        return 0;
    }
    let pn = child(item, i, pcx);
    if param_conv(pn, pcx) == CONV_IN_OUT {
        return X_INOUT;
    }
    if pcx.nodes[pn].a == tcx.self_sym {
        return X_SELF;
    }
    let a = pcx.types[t].a;
    if a <= 0 || pcx.types[a].kind == TyKind::Ptr || pcx.types[a].kind == TyKind::Slice
        || pcx.types[a].kind == TyKind::Fn {
        return X_NESTED;
    }
    1
}

fn key(f: i64, i: i64, pcx: Ctx<Comp>) -> i64 {
    base_node(f, pcx) * 64 + i + 1
}

fn flags(f: i64, i: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    tcx.rawptr_flags.get(key(f, i, pcx))
}

fn mark(f: i64, i: i64, bits: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let old = tcx.rawptr_flags.get(key(f, i, pcx));
    if (old | bits) != old {
        tcx.rawptr_flags.put(key(f, i, pcx), old | bits);
        tcx.rawptr_changed = true;
    }
}

fn mark_cur(p: i64, bits: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if tcx.rawptr_phase == PH_MARK && p >= 0 {
        mark(tcx.rawptr_cur_f, p, bits, &tcx, pcx);
    }
}

// Whether parameter i of f may be decided (read, write or caller).
fn decidable(f: i64, i: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    has_body(f, pcx) && !in_std(pcx.nodes[f_node(f, pcx)].start, pcx)
        && fixed_why(f, tcx, pcx) == X_NONE && ptr_param(f, i, tcx, pcx) == 1
        && (flags(f, i, tcx, pcx) & R_ALL) == 0
}

// Whether parameter i of f stays a raw pointer for its callers: C's, std's,
// a fixed signature, or one that escapes.
fn callee_raw(f: i64, i: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    !decidable(f, i, tcx, pcx)
}

// Whether raw parameter i of f is used as an address, not as one T: C's,
// std's, a fixed signature's, a `*u8`, or one indexed, cast, compared,
// walked (assigned) or passed on to such a parameter. A decided parameter
// passed to it escapes; passed to another raw one, it is given as `&p`,
// the address of the place it designates (and is inout).
fn callee_array(f: i64, i: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if !has_body(f, pcx) || in_std(pcx.nodes[f_node(f, pcx)].start, pcx)
        || fixed_why(f, tcx, pcx) != X_NONE
        || ptr_param(f, i, tcx, pcx) != 1 || pcx.types[fn_param(f, i, pcx)].a == TY_U8 {
        return true;
    }
    (flags(f, i, tcx, pcx) & (R_INDEX | R_CAST | R_COMPARE | R_ASSIGN | R_RAWCALL)) != 0
}

fn callee_writes(f: i64, i: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    (flags(f, i, tcx, pcx) & F_WRITE) != 0
}

// ---- the walk ----

// The parameter index of local l of the function walked, or -1.
fn param_of_local(l: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if l < 0 {
        return -1;
    }
    let item = tcx.cur_node;
    for i in 0..pcx.nodes[item].count {
        if pcx.nodes[child(item, i, pcx)].x == l {
            return i;
        }
    }
    -1
}

// The raw-pointer parameter expression n is (a bare name), or -1.
fn param_ident(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if n <= 0 || pcx.nodes[n].kind != NodeKind::Ident || pcx.nodes[n].res != Res::Local {
        return -1;
    }
    let p = param_of_local(pcx.nodes[n].y, tcx, pcx);
    if p >= 0 && ptr_param(tcx.rawptr_cur_f, p, tcx, pcx) != 0 { p } else { -1 }
}

// The root of place n (through fields, indexes, derefs).
fn place_root(n: i64, pcx: Ctx<Comp>) -> i64 {
    var e = n;
    while e > 0 {
        let k = pcx.nodes[e].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
            e = pcx.nodes[e].a;
        } else if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
            e = pcx.nodes[e].b;
        } else {
            return e;
        }
    }
    e
}

// The root a write to place n writes: through a method's receiver when the
// place is its result (`v.get_mut(k)[0] = x`).
fn write_root(n: i64, pcx: Ctx<Comp>) -> i64 {
    var r = place_root(n, pcx);
    var steps = 0;
    while r > 0 && pcx.nodes[r].kind == NodeKind::Call && pcx.nodes[r].count > 0 && steps < 8 {
        var a = child(r, 0, pcx);
        if pcx.nodes[a].kind == NodeKind::Unary && pcx.nodes[a].op == Tok::Amp {
            a = pcx.nodes[a].b;
        }
        r = place_root(a, pcx);
        steps += 1;
    }
    r
}

// The expressions inside place n that are evaluated (indexes, a root that
// is no name); an index of a parameter (`p[i]`, pointer arithmetic) is
// an escape.
fn place_parts(n: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    var e = n;
    while e > 0 {
        let k = pcx.nodes[e].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            e = pcx.nodes[e].a;
        } else if k == NodeKind::Index {
            scan(pcx.nodes[e].b, CX_READ, &tcx, &pcx);
            let q = param_ident(pcx.nodes[e].a, tcx, pcx);
            if q >= 0 {
                mark_cur(q, R_INDEX, &tcx, pcx);
            }
            e = pcx.nodes[e].a;
        } else if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
            deref_edit(e, &tcx, &pcx);
            e = pcx.nodes[e].b;
        } else {
            if k != NodeKind::Ident {
                scan(e, CX_READ, &tcx, &pcx);
            }
            return;
        }
    }
}

// A use of the pointer itself, in context ctx.
fn bare_use(p: i64, ctx: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if tcx.rawptr_in_hole > 0 {
        mark_cur(p, R_OTHER, &tcx, pcx);
    } else if ctx == CX_BIND {
        mark_cur(p, R_BIND, &tcx, pcx);
    } else if ctx == CX_RET {
        mark_cur(p, R_RETURN, &tcx, pcx);
    } else {
        mark_cur(p, R_OTHER, &tcx, pcx);
    }
}

// Every parameter named inside closure n escapes (a capture).
fn mark_closure(n: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if n <= 0 || tcx.rawptr_phase != PH_MARK || !tcx.first {
        return;
    }
    let s = pcx.nodes[n].start;
    let e = pcx.nodes[n].end;
    for m in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[m].start >= s && pcx.nodes[m].end <= e
            && pcx.nodes[m].kind == NodeKind::Ident {
            let p = param_ident(m, tcx, pcx);
            if p >= 0 {
                mark_cur(p, R_CLOSURE, &tcx, pcx);
            }
        }
    }
}

fn scan_list(n: i64, ctx: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    for i in 0..pcx.nodes[n].count {
        scan(child(n, i, pcx), ctx, &tcx, &pcx);
    }
}

// Walks expression n of the current function.
fn scan(n: i64, ctx: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if n <= 0 {
        return;
    }
    match pcx.nodes[n].kind {
        NodeKind::Ident => {
            let p = param_ident(n, tcx, pcx);
            if p >= 0 {
                bare_use(p, ctx, &tcx, pcx);
            }
        }
        NodeKind::FieldAccess | NodeKind::TupleField
            | NodeKind::Index => place_parts(n, &tcx, &pcx),
        NodeKind::Unary => {
            let op = pcx.nodes[n].op;
            if op == Tok::Star {
                deref_edit(n, &tcx, &pcx);
                place_parts(n, &tcx, &pcx);
            } else if op == Tok::Amp {
                borrow(n, -1, -1, &tcx, &pcx);
            } else {
                scan(pcx.nodes[n].b, CX_READ, &tcx, &pcx);
            }
        }
        NodeKind::Cast => {
            let p = param_ident(pcx.nodes[n].a, tcx, pcx);
            if p >= 0 {
                mark_cur(p, R_CAST, &tcx, pcx);
            } else {
                scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx);
            }
        }
        NodeKind::Binary => {
            for side in [pcx.nodes[n].b, pcx.nodes[n].c] {
                let p = param_ident(side, tcx, pcx);
                if p >= 0 {
                    mark_cur(p, R_COMPARE, &tcx, pcx);
                } else {
                    scan(side, CX_READ, &tcx, &pcx);
                }
            }
        }
        NodeKind::Assign => {
            let target = pcx.nodes[n].b;
            scan(pcx.nodes[n].c, if pcx.nodes[n].op == Tok::Eq { CX_BIND } else { CX_READ }, &tcx,
                &pcx);
            let p = param_ident(target, tcx, pcx);
            if p >= 0 {
                mark_cur(p, R_ASSIGN, &tcx, pcx);
                return;
            }
            place_parts(target, &tcx, &pcx);
            let w = param_ident(write_root(target, pcx), tcx, pcx);
            if w >= 0 {
                mark_cur(w, F_WRITE, &tcx, pcx);
            }
        }
        NodeKind::Call => scan_call(n, &tcx, &pcx),
        NodeKind::MethodCall => {
            // (not resolved by the checker: its receiver is used as it is)
            scan(pcx.nodes[n].a, CX_BIND, &tcx, &pcx);
            scan_list(n, CX_BIND, &tcx, &pcx);
        }
        NodeKind::Block => {
            let unsafe_block = (pcx.nodes[n].p & BLOCK_UNSAFE) != 0;
            if unsafe_block {
                tcx.in_unsafe += 1;
            }
            for i in 0..pcx.nodes[n].count {
                let s = child(n, i, pcx);
                let k = pcx.nodes[s].kind;
                if k == NodeKind::Let {
                    scan(pcx.nodes[s].c, CX_BIND, &tcx, &pcx);
                } else if k == NodeKind::Defer || k == NodeKind::ExprStmt {
                    scan(pcx.nodes[s].a, CX_READ, &tcx, &pcx);
                } else {
                    scan(s, CX_READ, &tcx, &pcx);
                }
            }
            scan(pcx.nodes[n].a, ctx, &tcx, &pcx);
            if unsafe_block {
                tcx.in_unsafe -= 1;
            }
        }
        NodeKind::If => {
            scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx);
            scan(pcx.nodes[n].b, ctx, &tcx, &pcx);
            scan(pcx.nodes[n].c, ctx, &tcx, &pcx);
        }
        NodeKind::Match => {
            scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx);
            for i in 0..pcx.nodes[n].count {
                let arm = child(n, i, pcx);
                scan(pcx.nodes[arm].b, CX_READ, &tcx, &pcx);
                scan(pcx.nodes[arm].c, ctx, &tcx, &pcx);
            }
        }
        NodeKind::Loop => scan(pcx.nodes[n].b, CX_READ, &tcx, &pcx),
        NodeKind::While => {
            scan(pcx.nodes[n].b, CX_READ, &tcx, &pcx);
            scan(pcx.nodes[n].c, CX_READ, &tcx, &pcx);
        }
        NodeKind::For => {
            scan(pcx.nodes[n].c, CX_READ, &tcx, &pcx);
            scan(pcx.nodes[n].d, CX_READ, &tcx, &pcx);
        }
        NodeKind::Break => scan(pcx.nodes[n].b, CX_BIND, &tcx, &pcx),
        NodeKind::Return => scan(pcx.nodes[n].a, CX_RET, &tcx, &pcx),
        NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
            scan_list(n, CX_BIND, &tcx, &pcx);
        }
        NodeKind::FieldInit | NodeKind::NamedArg => scan(pcx.nodes[n].b, ctx, &tcx, &pcx),
        NodeKind::Repeat => scan(pcx.nodes[n].a, CX_BIND, &tcx, &pcx),
        NodeKind::Range => {
            scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx);
            scan(pcx.nodes[n].b, CX_READ, &tcx, &pcx);
        }
        NodeKind::Closure => {
            // (an f-string's closure displays the locals its holes were
            // bound to, which the walk reads: no capture)
            if tcx.rawptr_fstring_closures.get(n + 1) == 0 {
                mark_closure(n, &tcx, pcx);
            }
        }
        NodeKind::Try => scan(pcx.nodes[n].y, ctx, &tcx, &pcx),
        NodeKind::Interp => {
            tcx.rawptr_in_hole += 1;
            scan(pcx.nodes[n].y, ctx, &tcx, &pcx);
            tcx.rawptr_in_hole -= 1;
        }
        NodeKind::EnumPanic => scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx),
        NodeKind::VecOp => {
            scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx);
            scan_list(n, CX_READ, &tcx, &pcx);
        }
        _ => {}
    }
}

// `&place` (node n), argument i of a call of f (i: -1, not an argument).
fn borrow(n: i64, f: i64, i: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let operand = pcx.nodes[n].b;
    place_parts(operand, &tcx, &pcx);
    let p = param_ident(place_root(operand, pcx), tcx, pcx);
    if p < 0 {
        return;
    }
    if place_root(operand, pcx) == operand || tcx.rawptr_in_hole > 0 {
        // (`&p`: the address of the pointer itself)
        mark_cur(p, R_OTHER, &tcx, pcx);
        return;
    }
    // (a pointer into *p kept, or given to a parameter that may write
    // through it or keep it: p is passed by address, inout)
    if (pcx.nodes[n].p & NODE_REF_MUT) != 0 || f < 0 || i < 0 || i >= f_params(f, pcx) {
        mark_cur(p, F_WRITE, &tcx, pcx);
        return;
    }
    let t = fn_param(f, i, pcx);
    if t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b != 0
        && pcx.types[t].b != REF_MUT {
        // (lent to a let parameter: read)
        return;
    }
    if t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == 0
        && !callee_raw(f, i, tcx, pcx)
        && !callee_writes(f, i, tcx, pcx) {
        return;
    }
    mark_cur(p, F_WRITE, &tcx, pcx);
}

// Call n: each argument by what its parameter does with it.
fn scan_call(n: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let f = pcx.nodes[n].x - 1;
    if f < 0 {
        scan(pcx.nodes[n].a, CX_READ, &tcx, &pcx);
    }
    if tcx.rawptr_phase == PH_MARK {
        nested_calls(n, &tcx, pcx);
    }
    for i in 0..pcx.nodes[n].count {
        var arg = child(n, i, pcx);
        if pcx.nodes[arg].kind == NodeKind::NamedArg {
            arg = pcx.nodes[arg].b;
        }
        argument(f, i, arg, n, &tcx, &pcx);
    }
}

// The argument arg of a call, without its `name:`, a cast and its `&`.
fn arg_core(arg: i64, pcx: Ctx<Comp>) -> i64 {
    var a = arg;
    if pcx.nodes[a].kind == NodeKind::NamedArg {
        a = pcx.nodes[a].b;
    }
    // (`unsafe { &*q }`, this fix's own boundary)
    if pcx.nodes[a].kind == NodeKind::Block && pcx.nodes[a].count == 0 && pcx.nodes[a].a > 0 {
        a = pcx.nodes[a].a;
    }
    if pcx.nodes[a].kind == NodeKind::Cast {
        a = pcx.nodes[a].a;
    }
    if pcx.nodes[a].kind == NodeKind::Unary && pcx.nodes[a].op == Tok::Amp {
        a = pcx.nodes[a].b;
    }
    a
}

// The local (+ 1) argument arg names at its root (`p`, `&p.f`), or -1: a
// parameter, raw or an access, or a local.
fn arg_local(arg: i64, pcx: Ctx<Comp>) -> i64 {
    let r = place_root(arg_core(arg, pcx), pcx);
    if r <= 0 || pcx.nodes[r].kind != NodeKind::Ident || pcx.nodes[r].res != Res::Local
        || pcx.nodes[r].y < 0 {
        return -1;
    }
    pcx.nodes[r].y + 1
}

// Whether argument arg is the local itself (`p`, `&p`), not a part of it.
fn arg_bare(arg: i64, pcx: Ctx<Comp>) -> bool {
    var a = arg_core(arg, pcx);
    // (an inout parameter's access, `&cx`, is read through the checker's
    // `*cx`)
    if pcx.nodes[a].kind == NodeKind::Unary && pcx.nodes[a].op == Tok::Star {
        a = pcx.nodes[a].b;
    }
    pcx.nodes[a].kind == NodeKind::Ident
}

// Call n of f: a call inside one of its arguments that is given a local n
// is given too (`f(&cx, g(&cx))`) keeps g's parameter raw (R_NESTED);
// another argument that borrows a part of it (`f(&cx, &cx.cap)`), or a
// call that cannot keep it raw, keeps f's raw. (By local, not by raw
// parameter: the rewritten program is decided again the same way.)
fn nested_calls(n: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let f = pcx.nodes[n].x - 1;
    for i in 0..pcx.nodes[n].count {
        let p = arg_local(child(n, i, pcx), pcx);
        if p < 0 {
            continue;
        }
        var clash = false;
        for j in 0..pcx.nodes[n].count {
            if j != i && nested_in(child(n, j, pcx), p, true, &tcx, pcx) {
                clash = true;
            }
        }
        let receiver = i == 0 && pcx.nodes[child(n, 0, pcx)].start == pcx.nodes[n].start;
        if clash && !receiver && arg_bare(child(n, i, pcx), pcx) && f >= 0 && f < pcx.fn_count
            && decidable(f, i, tcx, pcx) {
            mark(f, i, R_NESTED, &tcx, pcx);
        }
    }
}

// The calls inside expression e (an argument when top) given parameter p,
// not into closures, marked; whether e borrows a part of p (`&p.f`) or a
// call that cannot be marked is given it.
fn nested_in(e: i64, p: i64, top: bool, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if e <= 0 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Closure {
        return false;
    }
    if top && k == NodeKind::Unary && pcx.nodes[e].op == Tok::Amp && arg_local(e, pcx) == p {
        return true;
    }
    var clash = false;
    if k == NodeKind::Call {
        let g = pcx.nodes[e].x - 1;
        for j in 0..pcx.nodes[e].count {
            if arg_local(child(e, j, pcx), pcx) == p {
                if g >= 0 && g < pcx.fn_count && decidable(g, j, tcx, pcx) {
                    mark(g, j, R_NESTED, &tcx, pcx);
                }
                else if !arg_bare(child(e, j, pcx), pcx) || g < 0
                    || ptr_param(g, j, tcx, pcx) == 0 {
                    // (a part of p, `&p.f`; a reference or an inout
                    // parameter's, std's)
                    clash = true;
                }
            }
        }
    }
    if node_field_a(k) && nested_in(pcx.nodes[e].a, p, false, &tcx, pcx) {
        clash = true;
    }
    if node_field_b(k) && nested_in(pcx.nodes[e].b, p, false, &tcx, pcx) {
        clash = true;
    }
    if node_field_c(k) && nested_in(pcx.nodes[e].c, p, false, &tcx, pcx) {
        clash = true;
    }
    for j in 0..pcx.nodes[e].count {
        if nested_in(child(e, j, pcx), p, false, &tcx, pcx) {
            clash = true;
        }
    }
    clash
}

// Argument arg of a call of f (-1: a function value's), at parameter i.
fn argument(f: i64, i: i64, arg: i64, call: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let receiver = i == 0 && pcx.nodes[arg].start == pcx.nodes[call].start;
    if tcx.rawptr_phase != PH_MARK && f >= 0 && f < pcx.fn_count && decidable(f, i, tcx, pcx)
        && !receiver
        && !in_std(pcx.nodes[arg].start, pcx) {
        caller_arg(f, i, arg, &tcx, &pcx);
    }
    let k = pcx.nodes[arg].kind;
    if k == NodeKind::Unary && pcx.nodes[arg].op == Tok::Amp {
        borrow(arg, f, i, &tcx, &pcx);
        return;
    }
    let p = param_ident(arg, tcx, pcx);
    if p < 0 {
        scan(arg, CX_READ, &tcx, &pcx);
        return;
    }
    if tcx.rawptr_in_hole > 0 {
        mark_cur(p, R_OTHER, &tcx, pcx);
        return;
    }
    if f < 0 || i >= f_params(f, pcx) {
        mark_cur(p, R_VALUE, &tcx, pcx);
        return;
    }
    let t = fn_param(f, i, pcx);
    if t <= 0 || pcx.types[t].kind != TyKind::Ptr {
        // (a pointer given as a value of another type: a generic T)
        mark_cur(p, R_BIND, &tcx, pcx);
    } else if pcx.types[t].b == REF_MUT {
        mark_cur(p, F_WRITE, &tcx, pcx);
        if !receiver {
            mark_arg(arg, p, &tcx, &pcx);
        }
    } else if pcx.types[t].b != 0 {
        // (a let receiver of an owned T, lent)
    } else if callee_raw(f, i, tcx, pcx) && callee_array(f, i, tcx, pcx) {
        if tcx.rawptr_phase == PH_MARK && tcx.who.get(key(tcx.rawptr_cur_f, p, pcx)) == 0 {
            tcx.who.put(key(tcx.rawptr_cur_f, p, pcx), f + 1);
        }
        mark_cur(p, R_RAWCALL, &tcx, pcx);
    } else if callee_raw(f, i, tcx, pcx) {
        mark_cur(p, F_WRITE, &tcx, pcx);
        if !receiver {
            mark_arg(arg, p, &tcx, &pcx);
        }
    } else if callee_writes(f, i, tcx, pcx) {
        mark_cur(p, F_WRITE, &tcx, pcx);
    }
}

// Whether place n is reached through a raw pointer that stays one: a
// field, an index or a deref of a `*T` (`&q.f`, `&TABLE[i]`).
fn through_raw(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    var e = n;
    while e > 0 {
        let k = pcx.nodes[e].kind;
        var base = 0;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
            base = pcx.nodes[e].a;
        } else if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
            base = pcx.nodes[e].b;
        } else {
            return false;
        }
        let t = pcx.nodes[base].ty;
        if t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == 0 {
            let p = param_ident(base, tcx, pcx);
            if p < 0 || !decidable(tcx.rawptr_cur_f, p, tcx, pcx) {
                return true;
            }
        }
        e = base;
    }
    false
}

// What a call gives decidable parameter i of f: the address of a place, a
// parameter that is decided too, or else (C_*: the parameter's class is
// caller, and the call needs `*q` / `&*q` in unsafe code).
fn caller_arg(f: i64, i: i64, arg: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let k = pcx.nodes[arg].kind;
    if tcx.rawptr_phase == PH_EDIT {
        edit_arg(f, i, arg, &tcx, &pcx);
        return;
    }
    var bits = 0;
    if k == NodeKind::Unary && pcx.nodes[arg].op == Tok::Amp {
        if through_raw(pcx.nodes[arg].b, tcx, pcx) {
            bits = C_THROUGH;
        }
    } else {
        let p = param_ident(arg, tcx, pcx);
        if p >= 0 {
            if !decidable(tcx.rawptr_cur_f, p, tcx, pcx) {
                bits = C_RAW;
            }
        } else if k == NodeKind::CStr || k == NodeKind::Cast {
            bits = C_NULL;
        } else {
            let t = pcx.nodes[arg].ty;
            bits = if t > 0 && pcx.types[t].kind == TyKind::Ptr { C_RAW } else { C_OTHER };
        }
    }
    if (bits & (C_NULL | C_THROUGH)) != 0 {
        bits = bits | R_GIVEN;
        tcx.given_changed = true;
    }
    if bits != 0 {
        tcx.rawptr_flags.put(key(f, i, pcx), flags(f, i, tcx, pcx) | bits);
        if tcx.who.get(key(f, i, pcx)) == 0 {
            tcx.who.put(key(f, i, pcx), tcx.rawptr_cur_f + 1);
        }
        tcx.caller_sites += 1;
    }
}

// Walks every function with a body in phase ph (std's too: its writes
// count).
fn walk_all(ph: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    tcx.rawptr_phase = ph;
    for f in 0..pcx.fn_count {
        if !has_body(f, pcx) || f_generic(f, pcx) > 0 && f_tmpl(f, pcx) == 0 {
            continue;
        }
        tcx.rawptr_cur_f = f;
        tcx.cur_node = f_node(f, pcx);
        tcx.rawptr_in_hole = 0;
        tcx.in_unsafe = 0;
        if ph == PH_EDIT {
            if in_std(pcx.nodes[tcx.cur_node].start, pcx) {
                continue;
            }
            edit_params(f, &tcx, &pcx);
        }
        scan(pcx.nodes[tcx.cur_node].c, CX_RET, &tcx, &pcx);
    }
}

// The functions used as values (an Ident or Path naming one that is not a
// call's callee), and the f-strings' closures.
fn find_values(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    var callees = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() {
        if pcx.nodes[n].kind == NodeKind::Call && pcx.nodes[n].a > 0 {
            callees.put(pcx.nodes[n].a + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if (k == NodeKind::Ident || k == NodeKind::Path) && pcx.nodes[n].res == Res::Fn
            && pcx.nodes[n].y >= 0 && callees.get(n + 1) == 0 {
            tcx.rawptr_as_value.put(base_node(pcx.nodes[n].y, pcx) + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() {
        let y = pcx.nodes[n].y;
        if pcx.nodes[n].kind == NodeKind::Interp && y > 0 && pcx.nodes[y].kind == NodeKind::Block {
            let lit = pcx.nodes[y].a;
            if lit > 0 && pcx.nodes[lit].kind == NodeKind::StructLit && pcx.nodes[lit].count > 0 {
                let c = pcx.nodes[child(lit, 0, pcx)].b;
                if c > 0 && pcx.nodes[c].kind == NodeKind::Closure {
                    tcx.rawptr_fstring_closures.put(c + 1, 1);
                }
            }
        }
    }
}

// ---- the edits ----

// Whether decided parameter i of f becomes inout: written through, or a
// value a let parameter would copy whole (a plain T over 16 bytes).
fn to_inout(f: i64, i: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    (flags(f, i, tcx, pcx) & F_WRITE) != 0 || kind_of(f, i, &pcx) == T_BIG
}

// Whether parameter p of the function walked is decided, and its own
// edits are made (PH_EDIT).
fn editing(p: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    tcx.rawptr_phase == PH_EDIT && p >= 0 && decidable(tcx.rawptr_cur_f, p, tcx, pcx)
}

fn replace_text(a: i64, b: i64, text: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    if tcx.rawptr_edited.get(a + 1) != 0 {
        return false;
    }
    let t = buf_new();
    buf_str(t, text);
    if edit_replace(a, b, t, &pcx) {
        tcx.rawptr_edited.put(a + 1, 1);
        return true;
    }
    false
}

// `*p` of a decided parameter: `p` (`(*p).f`: `p.f`; the node of a
// parenthesized `(*p)` spans its parentheses).
fn deref_edit(n: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let p = param_ident(pcx.nodes[n].b, tcx, pcx);
    let s = pcx.nodes[n].start;
    if !editing(p, tcx, pcx) || SRC[s] != '*' && SRC[s] != '(' {
        return;
    }
    let name = pcx.nodes[n].b;
    let e = pcx.nodes[n].end;
    if SRC[s] == '(' {
        if SRC[e - 1] == ')' && replace_text(s, pcx.nodes[name].start, c"", &tcx, &pcx)
            && replace_text(pcx.nodes[name].end, e, c"", &tcx, &pcx) {
            tcx.rawptr_edits[4] += 1;
        }
    } else if replace_text(s, pcx.nodes[name].start, c"", &tcx, &pcx) {
        tcx.rawptr_edits[4] += 1;
    }
}

// A decided parameter p passed on as `p` where an inout access or a raw
// pointer to its place goes: `&p`.
fn mark_arg(arg: i64, p: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if editing(p, tcx, pcx) && to_inout(tcx.rawptr_cur_f, p, tcx, &pcx)
        && replace_text(pcx.nodes[arg].start, pcx.nodes[arg].start, c"&", &tcx, &pcx) {
        tcx.rawptr_edits[2] += 1;
    }
}

// Argument arg of a call of f at decided parameter i.
fn edit_arg(f: i64, i: i64, arg: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let k = pcx.nodes[arg].kind;
    let inout_ = to_inout(f, i, tcx, &pcx);
    let s = pcx.nodes[arg].start;
    if k == NodeKind::Unary && pcx.nodes[arg].op == Tok::Amp {
        if !inout_ && replace_text(s, pcx.nodes[pcx.nodes[arg].b].start, c"", &tcx, &pcx) {
            tcx.rawptr_edits[3] += 1;
        }
        return;
    }
    let p = param_ident(arg, tcx, pcx);
    if p >= 0 && decidable(tcx.rawptr_cur_f, p, tcx, pcx) {
        if inout_ && replace_text(s, s, c"&", &tcx, &pcx) {
            tcx.rawptr_edits[2] += 1;
        }
        return;
    }
    // (a raw pointer given: the place it points to, in unsafe code)
    let plain = k == NodeKind::Ident || k == NodeKind::FieldAccess || k == NodeKind::Call
        || k == NodeKind::Index || k == NodeKind::TupleField;
    let wrap = tcx.in_unsafe == 0;
    let t = buf_new();
    if wrap {
        buf_str(t, c"unsafe { ");
    }
    buf_str(t, if inout_ { c"&*" } else { c"*" });
    if !plain {
        buf_byte(t, '(');
    }
    buf_bytes(t, SRC[s..pcx.nodes[arg].end]);
    if !plain {
        buf_byte(t, ')');
    }
    if wrap {
        buf_str(t, c" }");
    }
    if tcx.rawptr_edited.get(s + 1) == 0 && edit_replace(s, pcx.nodes[arg].end, t, &pcx) {
        tcx.rawptr_edited.put(s + 1, 1);
        tcx.rawptr_edits[5] += 1;
        if wrap {
            tcx.rawptr_edits[6] += 1;
            justify(s, &tcx, &pcx);
        }
    }
}

// The UNSAFE:/SAFETY: comments of a new `unsafe { &*q }` at position s,
// above its line (once a line).
fn justify(s: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    var ls = s;
    while ls > 0 && SRC[ls - 1] != '\n' {
        ls -= 1;
    }
    var ie = ls;
    while SRC[ie] == ' ' {
        ie += 1;
    }
    if tcx.rawptr_edited.get(ie + 1) != 0 {
        return;
    }
    let t = buf_new();
    buf_str(t, c"// UNSAFE: a raw pointer given to an inout parameter (fix --only rawptr).");
    buf_byte(t, '\n');
    buf_bytes(t, SRC[ls..ie]);
    buf_str(t,
        c"// SAFETY: it points to one live value for the whole call, as the raw parameter took it.");
    buf_byte(t, '\n');
    buf_bytes(t, SRC[ls..ie]);
    if edit_replace(ie, ie, t, &pcx) {
        tcx.rawptr_edited.put(ie + 1, 1);
    }
}

// The decided parameters' types of f: `p: *T` and `p: sink *T` to `p:
// inout T` or `p: T`.
fn edit_params(f: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let item = f_node(f, pcx);
    for i in 0..f_params(f, pcx) {
        if !decidable(f, i, tcx, pcx) {
            continue;
        }
        let tn = pcx.nodes[child(item, i, pcx)].b;
        let s = pcx.nodes[tn].start;
        if SRC[s] != '*' {
            continue;
        }
        // (back over `sink `)
        var a = s;
        var k = s - 1;
        while k > 0 && SRC[k] == ' ' {
            k -= 1;
        }
        if k >= 4 && SRC[k - 3] == 's' && SRC[k - 2] == 'i' && SRC[k - 1] == 'n' && SRC[k] == 'k'
            && (SRC[k - 4] == ' ' || SRC[k - 4] == ':') {
            a = k - 3;
        }
        let inout_ = to_inout(f, i, tcx, &pcx);
        if replace_text(a, s + 1, if inout_ { c"inout " } else { c"" }, &tcx, &pcx) {
            tcx.rawptr_edits[if inout_ { 0 } else { 1 }] += 1;
        }
    }
}

// ---- the census ----

pub fn class_name(c: i64) -> *u8 {
    if c == RP_READ { c"read" }
    else if c == RP_WRITE { c"write" }
    else if c == RP_ESCAPE { c"escape" }
    else if c == RP_CALLER { c"caller" }
    else { c"fixed" }
}

fn reason_name(bits: i64) -> *u8 {
    if (bits & R_INDEX) != 0 { c"indexed" }
    else if (bits & R_BIND) != 0 { c"stored" }
    else if (bits & R_RETURN) != 0 { c"returned" }
    else if (bits & R_CAST) != 0 { c"cast" }
    else if (bits & R_COMPARE) != 0 { c"compared" }
    else if (bits & R_INDEX) != 0 { c"indexed" }
    else if (bits & R_RAWCALL) != 0 { c"to-raw" }
    else if (bits & R_VALUE) != 0 { c"to-fn-value" }
    else if (bits & R_CLOSURE) != 0 { c"captured" }
    else if (bits & R_ASSIGN) != 0 { c"assigned" }
    else if (bits & R_OTHER) != 0 { c"other" }
    else if (bits & R_GIVEN) != 0 { c"given-raw" }
    else if (bits & R_NESTED) != 0 { c"nested-call" }
    else if (bits & C_RAW) != 0 { c"raw-arg" }
    else if (bits & C_NULL) != 0 { c"null-arg" }
    else if (bits & C_THROUGH) != 0 { c"through-raw-arg" }
    else if (bits & C_OTHER) != 0 { c"other-arg" }
    else { c"-" }
}

fn fixed_name(x: i64) -> *u8 {
    if x == X_UNSAFE { c"unsafe-fn" }
    else if x == X_EXPORT { c"exported" }
    else if x == X_VALUE { c"fn-value" }
    else if x == X_MAIN { c"main" }
    else if x == X_CLOSURE { c"closure" }
    else if x == X_TRAIT { c"trait" }
    else if x == X_NESTED { c"nested" }
    else if x == X_SELF { c"receiver" }
    else { c"inout-ptr" }
}

fn kind_of(f: i64, i: i64, pcx: inout Ctx<Comp>) -> i64 {
    let a = pcx.types[fn_param(f, i, pcx)].a;
    if a <= 0 {
        return T_COPY;
    }
    if a == TY_U8 {
        return T_U8;
    }
    if !copyable(a, &pcx) {
        return T_OWNED;
    }
    if f_generic(f, pcx) > 0 || f_tmpl(f, pcx) > 0 {
        return T_COPY;
    }
    if type_size(a, pcx) <= 16 { T_COPY } else { T_BIG }
}

fn kind_name(k: i64) -> *u8 {
    if k == T_U8 { c"u8" } else if k == T_COPY { c"copy" } else if k == T_BIG { c"big" }
    else { c"owned" }
}

// The class of parameter i of f, and the reason (bits or X_*) in why.
fn classify(f: i64, i: i64, why: inout i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let pp = ptr_param(f, i, tcx, pcx);
    let x = fixed_why(f, tcx, pcx);
    if pp != 1 || x != X_NONE {
        why = if pp != 1 { pp } else { x };
        return RP_FIXED;
    }
    let fl = flags(f, i, tcx, pcx);
    why = fl;
    if (fl & R_ALL) != 0 {
        return RP_ESCAPE;
    }
    if (fl & C_ALL) != 0 {
        return RP_CALLER;
    }
    if (fl & F_WRITE) != 0 { RP_WRITE } else { RP_READ }
}

fn put_line(out: i64, f: i64, i: i64, class: i64, why: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let item = f_node(f, pcx);
    let pn = child(item, i, pcx);
    let pos = pcx.nodes[pn].start;
    let file = file_of_pos(pos, pcx);
    buf_str(out, pcx.files[file].path);
    buf_byte(out, ':');
    var line = 1;
    for k in pcx.files[file].start..pos {
        if SRC[k] == '\n' {
            line += 1;
        }
    }
    buf_int(out, line);
    buf_byte(out, '\t');
    buf_str(out, class_name(class));
    buf_byte(out, '\t');
    buf_str(out, if class == RP_FIXED { fixed_name(why) } else { reason_name(why) });
    buf_byte(out, '\t');
    buf_bytes(out, sym_text(pcx.nodes[item].a, pcx));
    buf_byte(out, '\t');
    buf_bytes(out, SRC[pcx.nodes[pn].start..pcx.nodes[pn].end]);
    buf_byte(out, '\t');
    buf_str(out,
        if class == RP_FIXED && why == X_NESTED { c"-" } else { kind_name(kind_of(f, i, &pcx)) });
    let who = tcx.who.get(key(f, i, pcx));
    if who > 0 && class != RP_FIXED {
        buf_byte(out, '\t');
        buf_bytes(out, sym_text(pcx.nodes[f_node(who - 1, pcx)].a, pcx));
    }
    buf_byte(out, '\n');
}

// The census (and, later, the edits) of `fix --only rawptr`; the number of
// parameters decided.
pub fn rawptr_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    tcx.self_sym = intern("self", &pcx);
    find_values(&tcx, pcx);
    // (the flags to a fixed point; then the calls, and again while one
    // keeps a parameter raw)
    var rounds = 0;
    tcx.given_changed = true;
    while tcx.given_changed && rounds < 64 {
        tcx.rawptr_changed = true;
        while tcx.rawptr_changed {
            tcx.rawptr_changed = false;
            walk_all(PH_MARK, &tcx, &pcx);
            tcx.first = false;
        }
        tcx.given_changed = false;
        tcx.caller_sites = 0;
        walk_all(PH_CALLS, &tcx, &pcx);
        rounds += 1;
    }
    walk_all(PH_EDIT, &tcx, &pcx);
    let out = buf_new();
    var decided = 0;
    for f in 0..pcx.fn_count {
        // (a closure's parameters, the format literals' too, are its
        // caller's to choose)
        if !has_body(f, pcx) || f_tmpl(f, pcx) > 0 || !ref_in(pcx.nodes[f_node(f, pcx)].start, &pcx)
            || fixed_why(f, tcx, pcx) == X_CLOSURE {
            continue;
        }
        let std = in_std(pcx.nodes[f_node(f, pcx)].start, pcx);
        for i in 0..f_params(f, pcx) {
            if ptr_param(f, i, tcx, pcx) == 0 {
                continue;
            }
            var why = 0;
            let c = classify(f, i, &why, tcx, pcx);
            tcx.rawptr_counts[(if std { 5 } else { 0 }) + c] += 1;
            if std {
                continue;
            }
            if c == RP_FIXED {
                tcx.fixed_why[why] += 1;
            } else {
                for b in 0..17 {
                    if (why & (1 << b)) != 0 {
                        tcx.reasons[b] += 1;
                    }
                }
            }
            if c == RP_READ {
                tcx.read_kinds[kind_of(f, i, &pcx)] += 1;
                decided += 1;
            } else if c == RP_WRITE {
                tcx.write_kinds[kind_of(f, i, &pcx)] += 1;
                decided += 1;
            } else if c == RP_CALLER {
                decided += 1;
            }
            if tcx.rawptr_list {
                put_line(out, f, i, c, why, tcx, &pcx);
            }
        }
    }
    if tcx.rawptr_list {
        buf_write_fd(out, STDOUT);
    }
    decided
}

// The census after a run: `note fix.rawptr: ...`.
pub fn rawptr_report(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let d = diag(c"note", c"fix.rawptr", &tcx);
    buf_str(d, c"raw pointer parameters:");
    for c in 0..5 {
        buf_byte(d, ' ');
        buf_str(d, class_name(c));
        buf_byte(d, ' ');
        buf_int(d, tcx.rawptr_counts[c]);
    }
    buf_str(d, c"; read by kind");
    for k in 0..4 {
        buf_byte(d, ' ');
        buf_str(d, kind_name(k));
        buf_byte(d, ' ');
        buf_int(d, tcx.read_kinds[k]);
    }
    buf_str(d, c"; write by kind");
    for k in 0..4 {
        buf_byte(d, ' ');
        buf_str(d, kind_name(k));
        buf_byte(d, ' ');
        buf_int(d, tcx.write_kinds[k]);
    }
    buf_str(d, c"; reasons");
    for b in 1..17 {
        buf_byte(d, ' ');
        buf_str(d, reason_name(1 << b));
        buf_byte(d, ' ');
        buf_int(d, tcx.reasons[b]);
    }
    buf_str(d, c"; fixed");
    for x in 1..10 {
        buf_byte(d, ' ');
        buf_str(d, fixed_name(x));
        buf_byte(d, ' ');
        buf_int(d, tcx.fixed_why[x]);
    }
    buf_str(d, c"; calls giving no place ");
    buf_int(d, tcx.caller_sites);
    buf_str(d, c"; edits: to inout ");
    buf_int(d, tcx.rawptr_edits[0]);
    buf_str(d, c", to let ");
    buf_int(d, tcx.rawptr_edits[1]);
    buf_str(d, c", `&p` ");
    buf_int(d, tcx.rawptr_edits[2]);
    buf_str(d, c", `&x` to `x` ");
    buf_int(d, tcx.rawptr_edits[3]);
    buf_str(d, c", `*p` to `p` ");
    buf_int(d, tcx.rawptr_edits[4]);
    buf_str(d, c", `&*q` ");
    buf_int(d, tcx.rawptr_edits[5]);
    buf_str(d, c" (in a new unsafe block ");
    buf_int(d, tcx.rawptr_edits[6]);
    buf_byte(d, ')');
    // (std's, with `--in std`: never edited)
    if pcx.opt_in != 0 as *u8 && tcx.rawptr_counts[5] + tcx.rawptr_counts[6]
        + tcx.rawptr_counts[7] + tcx.rawptr_counts[8] + tcx.rawptr_counts[9] > 0 {
        buf_str(d, c"; std:");
        for c in 0..5 {
            buf_byte(d, ' ');
            buf_str(d, class_name(c));
            buf_byte(d, ' ');
            buf_int(d, tcx.rawptr_counts[5 + c]);
        }
    }
    buf_byte(d, '\n');
}
