// (0.26.3) `volec fix --only alloc`: allocation as a capability
// (front/check/alloc_rules.vl, docs/grammar.md "Allocators"). The exact
// fixes of the allocator rules' errors, in rounds (a fix lets the checker
// see the next: a struct made generic over its allocator, then its uses):
//
//   alloc.default    `Vec<u8>` becomes `Vec<u8, Gpa>`, what the 0.26.2
//                    default meant; refused in an item generic over an
//                    allocator (`A` may be meant); a declared default
//                    (`A: Allocator = Gpa`) is taken out
//
// The errors without a fix are left, each with its reason.

use crate::base::{buf_new, buf_str};

// The codes whose exact fixes `--only alloc` makes, as `--codes` takes
// them (`,C,` pieces).
pub fn alloc_codes() -> i64 {
    let b = buf_new();
    buf_str(b, c",alloc.default,");
    b
}
