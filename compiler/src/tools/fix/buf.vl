// `volec fix --only buf` (0.26.3; explain fix.buf-refused): std's `Buf`
// becomes `String<A>` where it holds text and `Vec<u8, A>` where it holds
// bytes, binding by binding, by the evidence of its writes:
//
//   text:  a format write (push_fmt, push_int), Buf::from_in of a `str`,
//          a Buf printed (`{b}`), given a String or passed where std
//          takes one; and, weakly, a push_str of a `str` (a string literal
//          is one) and a push of a constant byte below 0x80: the same
//          bytes in a Vec<u8, A>, so they decide text only when nothing
//          says bytes (0.26.3, the mass run);
//   bytes: a push of a byte that is not a constant, a push of a constant
//          at or above 0x80, a push_str of a `[u8]` (a `[u8]` constant
//          too), as_mut_slice, an index (`b[i]`); and a binding with no
//          write at all, which a Vec<u8, A> holds as the Buf did;
//   mixed (text the weak rule does not cover, and bytes): refused, with
//          the binding and the writes on each side named; so is a binding
//          written through a by-value parameter (a Buf is a handle there,
//          a String or a Vec a copy). It never guesses.
//
// A binding is a local or a parameter, a field, a function's result or a
// constructor call (`Buf::new_in(gpa)`); bindings a value flows between
// (`let b = c`, `b = c`, an argument and its parameter, a returned value
// and the result, a field's initializer) are one, decided together; so
// are a value and what holds it (an `Option<Buf<A>>`, a `Vec<Buf<A>, A>`:
// a variant's payload, a pattern's binding, a std generic's argument and
// result, an enum variant's `Buf` field), and a use a closure captured
// and its local. A binding passed to a std function whose parameter is
// written `Buf` is refused too (std keeps the Buf there). The methods map through TABLE, which the run
// prints; a method with no form on the side decided refuses its binding.
//
// The checker's view is read before std's `str` is erased to `[u8]`
// (collect, from check_program, when RECORD is set); the edits are made
// after (buf_edits, from fix/command.vl).

use crate::base::{IntVec, SRC, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_str};
use crate::front::ast::{CONV_INOUT, CONV_SINK, NODES, NODE_CAPTURE, NODE_IMPLICIT, NodeKind, child};
use crate::front::check::{LOCALS, LOCAL_COUNT, Res};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, within_std};
use crate::front::types::{ENUMS, FNS, STRUCTS, TLISTS, TYPES, TyKind, VARIANTS, buf_type};
use crate::middle::lower::ssa::HMap;
use crate::tools::edit::edit_replace;
use crate::tools::fix::user_pos;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::{find_name, line_of, line_start};
use crate::tools::query::refs::{file_text, ref_in};
use crate::tools::refactor_mod::local::load_decls;

// Set by `fix --only buf`: check_program calls collect.
pub static var RECORD: bool = false;

// Kinds of binding, the low two bits of a key (the rest: a position).
const K_LOCAL: i64 = 0;
const K_FIELD: i64 = 1;
const K_RESULT: i64 = 2;
const K_CTOR: i64 = 3;

// The sides.
const TEXT: i64 = 1;
const BYTES: i64 = 2;

// The bindings, by id: key + 1 -> id + 1 in IDS; a union-find forest
// (PARENT); its type as written (TYPE_NODE: 0 none); whether it is a Buf
// for sure (ANCHOR: a Buf type, a constructor, a Buf method's receiver);
// the first write on each side (its position and what it is: WHY_*),
// -1: none; and where it is passed to std (EXTERN_AT, EXTERN_FN).
static var IDS: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static var KEY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var PARENT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var TYPE_NODE: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var ANCHOR: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var TEXT_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var TEXT_WHY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var BYTES_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var BYTES_WHY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var EXTERN_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var EXTERN_FN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The first text write that decides text against bytes (strong_text), as
// TEXT_AT and TEXT_WHY; whether a binding is a by-value parameter
// (LET_PARAM) and the first write through it (LETW_AT, -1: none).
static var STRONG_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var STRONG_WHY: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var LET_PARAM: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var LETW_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// Every declaration of a local, by its index l: l + 1 -> entry + 1
// (DECL_HEAD), the entry's name position (DECL_AT) and the entry before it
// of the same index (DECL_NEXT, -1: none).
static var DECL_HEAD: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
static var DECL_AT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var DECL_NEXT: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var DECL_NAME: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The method calls on a binding (call node, binding id, the method's
// symbol, the name's position), in fours.
static var CALLS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The user functions whose result is a Buf, for their `return`s.
static var RESULT_FNS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// A constructor binding's id + 1 -> its call node + 1.
static var CTOR_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The method calls on a String the checker did not resolve (MethodCall
// nodes: `s.free()` of a format_in's result, a Buf before 0.26.3).
static var STRING_CALLS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The pushes of bytes on a String (`ppm.push(px[i])` on a format_in's
// result, a Buf before 0.26.3, now a code point each): the call and its
// receiver's binding, in pairs; refused, each named.
static var STRING_BYTES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The refused bindings' count, for fix's exit status and its summary.
pub static var BUF_REFUSED: i64 = 0;

// The writes, what they are.
const WHY_STR: i64 = 1;
const WHY_FMT: i64 = 2;
const WHY_ASCII: i64 = 3;
const WHY_FROM_STR: i64 = 4;
const WHY_BYTE_VAR: i64 = 5;
const WHY_BYTE_HIGH: i64 = 6;
const WHY_BYTES_STR: i64 = 7;
const WHY_MUT_SLICE: i64 = 8;
const WHY_FROM_BYTES: i64 = 9;
const WHY_STRING: i64 = 10;
const WHY_STD_STRING: i64 = 11;
const WHY_PRINTED: i64 = 12;
const WHY_INDEX: i64 = 13;

// Whether write `why` on the text side decides text even against bytes:
// not a push_str of a str or a constant ASCII byte, which a Vec<u8, A>
// takes as the same bytes.
fn strong_text(why: i64) -> bool {
    why != WHY_STR && why != WHY_ASCII
}

fn why_text(w: i64) -> [u8] {
    if w == WHY_STR { "push_str of a str" }
    else if w == WHY_FMT { "a format write" }
    else if w == WHY_ASCII { "push of a constant byte below 0x80" }
    else if w == WHY_FROM_STR { "Buf::from_in of a str" }
    else if w == WHY_BYTE_VAR { "push of a byte that is not a constant" }
    else if w == WHY_BYTE_HIGH { "push of a constant byte at or above 0x80" }
    else if w == WHY_BYTES_STR { "push_str of a [u8]" }
    else if w == WHY_MUT_SLICE { "as_mut_slice" }
    else if w == WHY_FROM_BYTES { "Buf::from_in of a [u8]" }
    else if w == WHY_STRING { "given a String (format_in's, 0.26.3)" }
    else if w == WHY_PRINTED { "printed as text" }
    else if w == WHY_STD_STRING { "passed where std takes a String (read_line, 0.26.3)" }
    else if w == WHY_INDEX { "indexed (`b[i]`: a String has no index)" }
    else { "a write" }
}

// The method table: Buf's method, its String<A> form, its Vec<u8, A>
// form ("": none, the binding is refused).
const TABLE_COUNT: i64 = 18;
static TABLE: [[[u8]; 3]; 18] = [
    ["new_in", "String::new_in", "Vec::<u8>::new_in"],
    ["with_capacity_in", "String::with_capacity_in", "Vec::<u8>::with_capacity_in"],
    ["from_in", "String::from_in", ""],
    ["len", "len", "len"],
    ["push", "push", "push"],
    ["push_str", "push_str", "extend_from_slice"],
    ["push_fmt", "push_fmt", ""],
    ["push_int", "push_fmt", ""],
    ["push_cstr", "", ""],
    ["as_slice", "as_slice", "as_slice"],
    ["as_mut_slice", "", "as_mut_slice"],
    ["clear", "clear", "clear"],
    ["free", "free", "free"],
    ["take", "", "take"],
    ["capacity", "capacity", "capacity"],
    ["reserve", "reserve", "reserve"],
    ["allocator", "allocator", "allocator"],
    ["clone", "clone", "clone"],
];

// The row of method `name` in TABLE, or -1.
fn row_of(name: [u8]) -> i64 {
    for i in 0..TABLE_COUNT {
        if TABLE[i][0] == name {
            return i;
        }
    }
    -1
}

fn get(v: IntVec, i: i64) -> i64 {
    // UNSAFE: an IntVec's data is a raw pointer (base).
    // SAFETY: every caller's i is an id or an index below v.count (the
    // tables of ids grow together in id_of).
    unsafe { v.data[i] }
}

fn set(v: inout IntVec, i: i64, x: i64) {
    // UNSAFE: as get's.
    // SAFETY: as get's: i is below v.count.
    unsafe {
        v.data[i] = x;
    }
}

// The id of the binding with key `key`, made if new.
fn id_of(key: i64) -> i64 {
    let had = IDS.get(key + 1);
    if had != 0 {
        return had - 1;
    }
    let id = KEY.count;
    IDS.put(key + 1, id + 1);
    KEY.push(key);
    PARENT.push(id);
    TYPE_NODE.push(0);
    ANCHOR.push(0);
    TEXT_AT.push(-1);
    TEXT_WHY.push(0);
    BYTES_AT.push(-1);
    BYTES_WHY.push(0);
    EXTERN_AT.push(-1);
    EXTERN_FN.push(-1);
    STRONG_AT.push(-1);
    STRONG_WHY.push(0);
    LET_PARAM.push(0);
    LETW_AT.push(-1);
    id
}

fn root(id: i64) -> i64 {
    var r = id;
    while get(PARENT, r) != r {
        r = get(PARENT, r);
    }
    r
}

fn join(a: i64, b: i64) {
    if a < 0 || b < 0 {
        return;
    }
    let ra = root(a);
    let rb = root(b);
    if ra != rb {
        set(&PARENT, rb, ra);
    }
}

fn anchor(id: i64) {
    if id >= 0 {
        set(&ANCHOR, id, 1);
    }
}

fn note_write(id: i64, side: i64, why: i64, pos: i64) {
    if id < 0 {
        return;
    }
    if side == TEXT {
        if get(TEXT_AT, id) < 0 {
            set(&TEXT_AT, id, pos);
            set(&TEXT_WHY, id, why);
        }
        if strong_text(why) && get(STRONG_AT, id) < 0 {
            set(&STRONG_AT, id, pos);
            set(&STRONG_WHY, id, why);
        }
    } else if side == BYTES && get(BYTES_AT, id) < 0 {
        set(&BYTES_AT, id, pos);
        set(&BYTES_WHY, id, why);
    }
}

fn sym_is(sym: i64, s: [u8]) -> bool {
    // UNSAFE: SYMS is the symbol table, a raw pointer (base).
    // SAFETY: sym is a node's name, a symbol below the table's count.
    sym > 0 && unsafe { SYMS[sym].text } == s
}

// Whether type t is std's Buf (through a pointer).
fn is_buf_type(t0: i64) -> bool {
    // UNSAFE: TYPES and STRUCTS are the type tables, raw pointers (front/types).
    // SAFETY: t0 is a checked node's type, a TYPES index (0: none); a struct
    // type's a is its STRUCTS index, an instance's tmpl - 1 its template's.
    unsafe {
        if t0 <= 0 {
            return false;
        }
        let t = if TYPES[t0].kind == TyKind::Ptr { TYPES[t0].a } else { t0 };
        if t <= 0 || TYPES[t].kind != TyKind::Struct {
            return false;
        }
        var s = TYPES[t].a;
        if STRUCTS[s].tmpl != 0 {
            s = STRUCTS[s].tmpl - 1;
        }
        sym_is(STRUCTS[s].name, "Buf") && within_std(STRUCTS[s].module)
    }
}

// Whether type t is std's String (through a pointer): what format_in
// makes and read_line fills since 0.26.3.
fn is_string_type(t0: i64) -> bool {
    // UNSAFE: as is_buf_type's.
    // SAFETY: as is_buf_type's.
    unsafe {
        if t0 <= 0 {
            return false;
        }
        let t = if TYPES[t0].kind == TyKind::Ptr { TYPES[t0].a } else { t0 };
        if t <= 0 || TYPES[t].kind != TyKind::Struct {
            return false;
        }
        var s = TYPES[t].a;
        if STRUCTS[s].tmpl != 0 {
            s = STRUCTS[s].tmpl - 1;
        }
        sym_is(STRUCTS[s].name, "String") && within_std(STRUCTS[s].module)
    }
}

// Whether type t is a Buf or holds one through its type arguments, a
// pointer, a slice or an array (`Option<Buf<A>>`, `Vec<Buf<A>, A>`).
fn has_buf(t: i64) -> bool {
    has_buf_at(t, 0)
}

fn has_buf_at(t: i64, depth: i64) -> bool {
    if t <= 0 || depth > 6 {
        return false;
    }
    if is_buf_type(t) {
        return true;
    }
    // UNSAFE: TYPES, STRUCTS, ENUMS and TLISTS are the type tables, raw
    // pointers (front/types).
    // SAFETY: t is a checked node's type, a TYPES index; a struct's or an
    // enum's a is its table's index, its targs a run of targ_count TLISTS.
    unsafe {
        let k = TYPES[t].kind;
        if k == TyKind::Ptr || k == TyKind::Slice || k == TyKind::Array {
            return has_buf_at(TYPES[t].a, depth + 1);
        }
        if k == TyKind::Struct {
            let s = TYPES[t].a;
            if STRUCTS[s].closure != 0 {
                return false;
            }
            for i in 0..STRUCTS[s].targ_count {
                if has_buf_at(TLISTS.data[STRUCTS[s].targs + i], depth + 1) {
                    return true;
                }
            }
        } else if k == TyKind::Enum {
            let e = TYPES[t].a;
            for i in 0..ENUMS[e].targ_count {
                if has_buf_at(TLISTS.data[ENUMS[e].targs + i], depth + 1) {
                    return true;
                }
            }
        }
    }
    false
}

// Whether type node n is written with a `Buf` in it (`Buf<A>`,
// `Option<Buf<A>>`, `inout Vec<Buf<A>, A>`): rewrite_type's `Buf`s.
fn mentions_buf(n: i64) -> bool {
    if n <= 0 {
        return false;
    }
    var i = NODES[n].start;
    let end = NODES[n].end;
    while i + 3 <= end {
        if SRC[i] == 'B' && SRC[i + 1] == 'u' && SRC[i + 2] == 'f'
            && (i == 0 || !ident_byte(SRC[i - 1]))
            && (i + 3 >= SRC.len as i64 || !ident_byte(SRC[i + 3])) {
            return true;
        }
        i += 1;
    }
    false
}

// Value v given to binding id (its initializer, a value assigned or
// returned, an argument): a String is text evidence (a program written
// before format_in made one).
fn note_given(id: i64, v: i64) {
    if id >= 0 && v > 0 && is_string_type(NODES[v].ty) {
        note_write(id, TEXT, WHY_STRING, NODES[v].start);
    }
}

// Value v flows into binding id: a binding joined, a String noted, the
// branches of an `if` or a `match` and a block's tail each.
fn flow(id: i64, v: i64) {
    if id < 0 || v <= 0 {
        return;
    }
    let k = NODES[v].kind;
    if k == NodeKind::Block {
        flow(id, NODES[v].a);
    } else if k == NodeKind::If {
        flow(id, NODES[v].b);
        flow(id, NODES[v].c);
    } else if k == NodeKind::Match {
        for i in 0..NODES[v].count {
            flow(id, NODES[child(v, i)].c);
        }
    } else if k == NodeKind::VariantLit && vfield_binding(NODES[v].a, 0) < 0 {
        // (std's `Some(b)`, `Err(b)`: the payload is the holder's; a
        // program's variant's Buf fields are bindings of their own,
        // collect's VariantLit)
        for i in 0..NODES[v].count {
            flow(id, child(v, i));
        }
    } else if has_buf(NODES[v].ty) {
        join(id, binding(v));
    } else {
        note_given(id, v);
        // (a String local: one binding with it, its byte pushes count)
        if is_string_type(NODES[v].ty) {
            join(id, binding(v));
        }
    }
}

// Whether e is a `[u8]` constant of a literal (`const HEAD: [u8] = "..";`):
// the checker makes its use a Str node, its name left in the source. Bytes,
// as its type says.
fn bytes_const(e: i64) -> bool {
    if e <= 0 || NODES[e].kind != NodeKind::Str || is_str_type(NODES[e].ty) {
        return false;
    }
    let at = NODES[e].start;
    ident_byte(SRC[at]) && !(SRC[at] == 'r' && (SRC[at + 1] == '"' || SRC[at + 1] == '#'))
}

// Whether e is a local declared `str` (its use given to Buf's push_str is
// typed as the parameter, `[u8]`), through a `&` or a `*`.
fn str_local(e: i64) -> bool {
    if e <= 0 {
        return false;
    }
    if NODES[e].kind == NodeKind::Unary {
        return str_local(NODES[e].b);
    }
    if NODES[e].kind != NodeKind::Ident || NODES[e].res != Res::Local {
        return false;
    }
    let l = NODES[e].y;
    // UNSAFE: LOCALS is the checker's table of locals, a raw pointer.
    // SAFETY: l is checked below LOCAL_COUNT first.
    l >= 0 && l < LOCAL_COUNT
        && unsafe { LOCALS[l].name == NODES[e].a && is_str_type(LOCALS[l].ty) }
}

// Whether type t is std's `str`.
fn is_str_type(t: i64) -> bool {
    if t <= 0 {
        return false;
    }
    let b = buf_new();
    buf_type(b, t);
    crate::base::buf_slice(b) == "str"
}

// Whether type node n is written `Buf`, `std::Buf<A>`, or a pointer to one.
fn buf_type_node(n: i64) -> bool {
    if n <= 0 {
        return false;
    }
    let k = NODES[n].kind;
    if k == NodeKind::TyPtr {
        return buf_type_node(NODES[n].a);
    }
    k == NodeKind::TyName && sym_is(NODES[n].a, "Buf")
}

// The function a call or a name resolved to (its template), or -1.
fn template(f: i64) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: f is a resolved call's function, below FN_COUNT; tmpl - 1 is
    // its template's index.
    unsafe {
        if FNS[f].tmpl != 0 { FNS[f].tmpl - 1 } else { f }
    }
}

fn fn_node(f: i64) -> i64 {
    // UNSAFE: as template's.
    // SAFETY: f is a function's index, below FN_COUNT.
    unsafe { FNS[f].node }
}

// Whether function f is one of std's Buf's (an impl of Buf's).
fn is_buf_fn(f: i64) -> bool {
    let t = template(f);
    // UNSAFE: as template's.
    // SAFETY: t is a function's index, below FN_COUNT.
    let m = unsafe { FNS[t].module };
    let node = fn_node(t);
    node > 0 && NODES[node].kind == NodeKind::Fn && sym_is(NODES[node].d, "Buf") && within_std(m)
}

// Whether function f is std's String::push (a code point since 0.20).
fn is_string_push(f: i64) -> bool {
    let t = template(f);
    // UNSAFE: as template's.
    // SAFETY: t is a function's index, below FN_COUNT.
    let m = unsafe { FNS[t].module };
    let node = fn_node(t);
    node > 0 && NODES[node].kind == NodeKind::Fn && sym_is(NODES[node].d, "String")
        && sym_is(NODES[node].a, "push") && within_std(m)
}

// Whether parameter i of function f (its template's) is a Buf.
fn param_is_buf(f: i64, i: i64) -> bool {
    // (the instance's own types first: a generic impl's template
    // writes `Buf<A>`, which is not yet a struct type)
    for t in [f, template(f)] {
        // UNSAFE: FNS and TLISTS are the checker's tables, raw pointers.
        // SAFETY: i is below the function's param_count (checked), so
        // params + i is in its TLISTS run.
        let yes = unsafe {
            i < FNS[t].param_count && is_buf_type(TLISTS.data[FNS[t].params + i])
        };
        if yes {
            return true;
        }
    }
    false
}

// Whether parameter i of function f (its template's) is a String.
fn param_is_string(f: i64, i: i64) -> bool {
    let t = template(f);
    // UNSAFE: FNS and TLISTS are the checker's tables, raw pointers.
    // SAFETY: as param_is_buf's.
    unsafe {
        if i >= FNS[t].param_count {
            return false;
        }
        is_string_type(TLISTS.data[FNS[t].params + i])
    }
}

// Whether function f is one of std's printers (print, println, eprint,
// eprintln, format_in, panic): what it is given is text.
fn printer(f: i64) -> bool {
    let t = template(f);
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: t is a function's index, below FN_COUNT.
    let m = unsafe { FNS[t].module };
    let node = fn_node(t);
    if node <= 0 || !within_std(m) {
        return false;
    }
    let a = NODES[node].a;
    sym_is(a, "print") || sym_is(a, "println") || sym_is(a, "eprint") || sym_is(a, "eprintln")
        || sym_is(a, "format_in") || sym_is(a, "panic")
}

// The struct item of struct type t (through a pointer), or 0.
fn struct_node(t0: i64) -> i64 {
    // UNSAFE: as is_buf_type's.
    // SAFETY: as is_buf_type's.
    unsafe {
        if t0 <= 0 {
            return 0;
        }
        let t = if TYPES[t0].kind == TyKind::Ptr { TYPES[t0].a } else { t0 };
        if t <= 0 || TYPES[t].kind != TyKind::Struct || STRUCTS[TYPES[t].a].closure != 0 {
            return 0;
        }
        STRUCTS[TYPES[t].a].node
    }
}

fn field_of(s: i64, i: i64, name: i64) -> i64 {
    if s <= 0 || i < 0 || i >= NODES[s].count || NODES[child(s, i)].a != name {
        return 0;
    }
    child(s, i)
}

// The binding of field node f (a program's).
fn field_binding(f: i64) -> i64 {
    if f <= 0 || !user_pos(NODES[f].start) {
        return -1;
    }
    let id = id_of(NODES[f].start * 4 + K_FIELD);
    if mentions_buf(NODES[f].b) {
        set(&TYPE_NODE, id, NODES[f].b);
        anchor(id);
    }
    id
}

// The binding of field i of enum variant v (VARIANTS), a program's that
// is written with a `Buf` (its type node's position, as a field's), or -1.
fn vfield_binding(v: i64, i: i64) -> i64 {
    if v < 0 {
        return -1;
    }
    // UNSAFE: VARIANTS is the table of variants, a raw pointer (front/types).
    // SAFETY: v is a checked VariantLit's or PatVariant's variant, below
    // VARIANT_COUNT.
    let vn = unsafe { VARIANTS[v].node };
    if vn <= 0 || NODES[vn].kind != NodeKind::Variant || i < 0 || i >= NODES[vn].count {
        return -1;
    }
    let t = child(vn, i);
    if t <= 0 || !user_pos(NODES[t].start) || !mentions_buf(t) {
        return -1;
    }
    let id = id_of(NODES[t].start * 4 + K_FIELD);
    set(&TYPE_NODE, id, t);
    anchor(id);
    id
}

// Pattern pat matched against a value of binding sid (-1: none): each of
// its bindings that holds a Buf is one with it (`Some(b)` of an
// `Option<Buf<A>>`), or with a program's variant's Buf field (`Msg::Text(t)`).
fn bind_pattern(pat: i64, sid: i64) {
    if pat <= 0 {
        return;
    }
    let k = NODES[pat].kind;
    if k == NodeKind::PatBind {
        let id = decl_binding(pat);
        if sid >= 0 && id >= 0 && (NODES[pat].ty <= 0 || has_buf(NODES[pat].ty)) {
            join(sid, id);
        }
    } else if k == NodeKind::PatVariant {
        for i in 0..NODES[pat].count {
            let fid = vfield_binding(NODES[pat].x, i);
            bind_pattern(child(pat, i), if fid >= 0 { fid } else { sid });
        }
    } else if k == NodeKind::PatTuple || k == NodeKind::PatOr {
        for i in 0..NODES[pat].count {
            bind_pattern(child(pat, i), sid);
        }
    }
}

// Fills DECL_HEAD, DECL_AT, DECL_NAME and DECL_NEXT: every declaration of
// a local.
fn load_local_decls() {
    if DECL_AT.count > 0 {
        return;
    }
    for n in 1..NODES.len() as i64 {
        let p = decl_pos(n);
        if p >= 0 {
            let l = NODES[n].x;
            let e = DECL_AT.count;
            DECL_AT.push(p);
            DECL_NAME.push(NODES[n].a);
            DECL_NEXT.push(DECL_HEAD.get(l + 1) - 1);
            DECL_HEAD.put(l + 1, e + 1);
        }
    }
}

// The position of the declaration of the local use e names (an Ident, or
// a use a closure captured), or -1: of the declarations of its local's
// index (with its name), the nearest before it. (The checker numbers each
// function's locals from 0 and a generic one's body is checked after, so
// an index names a local of each function, and LOCALS holds the last
// one's: use_decl and decl_name_pos, which check LOCALS, miss the others.)
fn local_decl(e: i64) -> i64 {
    let captured = (NODES[e].p & NODE_CAPTURE) != 0 && NODES[e].d > 0;
    if !captured && (NODES[e].kind != NodeKind::Ident || NODES[e].res != Res::Local) {
        return -1;
    }
    let l = if captured { NODES[e].d - 1 } else { NODES[e].y };
    let at = NODES[e].start;
    var best = -1;
    var i = DECL_HEAD.get(l + 1) - 1;
    while i >= 0 {
        let p = get(DECL_AT, i);
        if p <= at && p > best && (captured || get(DECL_NAME, i) == NODES[e].a) {
            best = p;
        }
        i = get(DECL_NEXT, i);
    }
    best
}

// The position of the name the PatBind or Param node n declares, in a
// file of the program, or -1 (decl_name_pos without its LOCALS check).
fn decl_pos(n: i64) -> i64 {
    let k = NODES[n].kind;
    if k != NodeKind::PatBind && k != NodeKind::Param || NODES[n].x < 0
        || NODES[n].end <= NODES[n].start || !user_pos(NODES[n].start) {
        return -1;
    }
    find_name(NODES[n].start, NODES[n].end, NODES[n].a, false)
}

// The binding of local `l`'s declaration (a PatBind or Param node d).
fn decl_binding(d: i64) -> i64 {
    let p = decl_pos(d);
    if p < 0 { -1 } else { id_of(p * 4 + K_LOCAL) }
}

// The binding expression e denotes, or -1.
fn binding(e: i64) -> i64 {
    if e <= 0 {
        return -1;
    }
    if (NODES[e].p & NODE_CAPTURE) != 0 && NODES[e].d > 0 {
        // (a use a closure captured, now `*(*env).x`: its local's)
        let p = local_decl(e);
        return if p < 0 { -1 } else { id_of(p * 4 + K_LOCAL) };
    }
    let k = NODES[e].kind;
    if k == NodeKind::Unary && (NODES[e].op == Tok::Amp || NODES[e].op == Tok::Star) {
        return binding(NODES[e].b);
    }
    if k == NodeKind::Block {
        return if NODES[e].a != 0 { binding(NODES[e].a) } else { -1 };
    }
    if k == NodeKind::Try {
        return binding(NODES[e].a);
    }
    if k == NodeKind::Ident && NODES[e].res == Res::Local {
        let p = local_decl(e);
        return if p < 0 { -1 } else { id_of(p * 4 + K_LOCAL) };
    }
    if k == NodeKind::Index && !is_buf_type(NODES[NODES[e].a].ty) && has_buf(NODES[NODES[e].a].ty) {
        // (`v[i]` of a Vec<Buf<A>, A>: the holder's)
        return binding(NODES[e].a);
    }
    if k == NodeKind::FieldAccess && NODES[e].y != 2 {
        let s = struct_node(NODES[NODES[e].a].ty);
        return field_binding(field_of(s, NODES[e].x, NODES[e].b));
    }
    if k == NodeKind::Call && NODES[e].x > 0 {
        let f = NODES[e].x - 1;
        if is_buf_fn(f) && NODES[e].a != 0 {
            let id = id_of(NODES[e].start * 4 + K_CTOR);
            anchor(id);
            CTOR_OF.put(id + 1, e + 1);
            return id;
        }
        if is_buf_fn(f) && NODES[e].count > 0 && is_buf_type(NODES[e].ty) {
            // (`b.clone()`, `b.take()`: the receiver's)
            return binding(child(e, 0));
        }
        let def = fn_node(template(f));
        if def > 0 && user_pos(NODES[def].start) && has_buf(NODES[e].ty)
            && mentions_buf(NODES[def].b) {
            return id_of(NODES[def].start * 4 + K_RESULT);
        }
        if def > 0 && !user_pos(NODES[def].start) && has_buf(NODES[e].ty)
            && !mentions_buf(NODES[def].b) {
            // (a std generic's result, `v.get(0)`, `o.unwrap()`,
            // `std::replace(&s.f, b)`: its first argument's that holds one)
            for i in 0..NODES[e].count {
                let arg = child(e, i);
                if NODES[arg].kind != NodeKind::NamedArg && has_buf(NODES[arg].ty) {
                    return binding(arg);
                }
            }
        }
    }
    -1
}

// The start of the name after the `.` at or after pos (a method's), or -1.
fn name_after_dot(pos: i64, end: i64) -> i64 {
    var i = pos;
    while i < end && SRC[i] != '.' {
        i += 1;
    }
    if i >= end {
        return -1;
    }
    i += 1;
    while i < end && (SRC[i] == ' ' || SRC[i] == '\n' || SRC[i] == '\t' || SRC[i] == '\r') {
        i += 1;
    }
    i
}

// Method call n (receiver recv) of Buf's function f: its write's evidence,
// and the call kept for its rename.
fn note_method(n: i64, f: i64, recv: i64) {
    let id = binding(recv);
    if id < 0 {
        return;
    }
    anchor(id);
    let def = fn_node(template(f));
    let name = NODES[def].a;
    // UNSAFE: SYMS is the symbol table, a raw pointer (base).
    // SAFETY: name is a function's name, a symbol below the table's count.
    let text = unsafe { SYMS[name].text };
    CALLS.push(n);
    CALLS.push(id);
    CALLS.push(name);
    CALLS.push(name_after_dot(NODES[recv].end, NODES[n].end));
    let pos = NODES[n].start;
    if get(LET_PARAM, id) != 0 && get(LETW_AT, id) < 0 && text != "len" && text != "as_slice"
        && text != "capacity" && text != "allocator" && text != "clone" {
        set(&LETW_AT, id, pos);
    }
    if (text == "as_slice" || text == "as_mut_slice") && NODES[n].end > NODES[n].start
        && SRC[NODES[n].end - 1] == ']' {
        // (`b[..]`, `b[i]`: the checker's as_slice call in its place)
        note_write(id, BYTES, WHY_INDEX, pos);
    }
    if text == "push_fmt" || text == "push_int" {
        note_write(id, TEXT, WHY_FMT, pos);
    } else if text == "as_mut_slice" {
        note_write(id, BYTES, WHY_MUT_SLICE, pos);
    } else if (text == "push" || text == "push_str") && NODES[n].kind == NodeKind::Call
        && NODES[n].count > 1 {
        let arg = child(n, 1);
        if text == "push_str" {
            if bytes_const(arg) {
                note_write(id, BYTES, WHY_BYTES_STR, pos);
            }
            else if NODES[arg].kind == NodeKind::Str || is_str_type(NODES[arg].ty)
                || str_local(arg) {
                note_write(id, TEXT, WHY_STR, pos);
            } else {
                note_write(id, BYTES, WHY_BYTES_STR, pos);
            }
        } else if NODES[arg].kind == NodeKind::Int || NODES[arg].kind == NodeKind::Char {
            if NODES[arg].a < 0x80 {
                note_write(id, TEXT, WHY_ASCII, pos);
            } else {
                note_write(id, BYTES, WHY_BYTE_HIGH, pos);
            }
        } else {
            note_write(id, BYTES, WHY_BYTE_VAR, pos);
        }
    }
}

// Constructor call n of Buf's function f (`Buf::from_in(s, a)`): its
// evidence.
fn note_ctor(n: i64, f: i64) {
    let id = binding(n);
    let def = fn_node(template(f));
    if sym_is(NODES[def].a, "from_in") && NODES[n].count > 0 {
        let arg = child(n, 0);
        if !bytes_const(arg) && (NODES[arg].kind == NodeKind::Str || is_str_type(NODES[arg].ty)) {
            note_write(id, TEXT, WHY_FROM_STR, NODES[n].start);
        } else {
            note_write(id, BYTES, WHY_FROM_BYTES, NODES[n].start);
        }
    }
}

// Call n (not of Buf's): its Buf arguments flow to the parameters of a
// program's function; one passed to std's is kept a Buf.
fn note_args(n: i64, f: i64) {
    let def = fn_node(template(f));
    let user = def > 0 && user_pos(NODES[def].start);
    for i in 0..NODES[n].count {
        let arg = child(n, i);
        if NODES[arg].kind == NodeKind::NamedArg {
            continue;
        }
        if user && i < NODES[def].count && is_string_type(NODES[arg].ty) {
            // (a String given to a Buf parameter)
            let p = child(def, i);
            if buf_type_node(NODES[p].b) {
                let pid = decl_binding(p);
                if pid >= 0 {
                    set(&TYPE_NODE, pid, NODES[p].b);
                    anchor(pid);
                }
                note_given(pid, arg);
            }
            continue;
        }
        if !has_buf(NODES[arg].ty) {
            continue;
        }
        let id = binding(arg);
        if id < 0 {
            continue;
        }
        anchor(id);
        if user && i < NODES[def].count {
            let p = child(def, i);
            let pid = decl_binding(p);
            if pid >= 0 && mentions_buf(NODES[p].b) {
                set(&TYPE_NODE, pid, NODES[p].b);
                anchor(pid);
            }
            join(id, pid);
        } else if !is_buf_type(NODES[arg].ty) || !user && def > 0 && i < NODES[def].count
            && NODES[child(def, i)].kind == NodeKind::Param && !mentions_buf(NODES[child(def, i)].b)
            && !param_is_string(f, i) && !printer(f) {
            // (a holder given to std, or a Buf given to a std generic,
            // `names.push(b)`, `std::replace(&s.f, b)`: one with the
            // other arguments that hold one)
            for j in 0..NODES[n].count {
                let other = child(n, j);
                if j != i && NODES[other].kind != NodeKind::NamedArg && has_buf(NODES[other].ty) {
                    join(id, binding(other));
                }
            }
        } else if !user && param_is_string(f, i) {
            note_write(id, TEXT, WHY_STD_STRING, NODES[arg].start);
        } else if !user && printer(f) {
            note_write(id, TEXT, WHY_PRINTED, NODES[arg].start);
        } else if !user && param_is_buf(f, i) && get(EXTERN_AT, id) < 0 {
            set(&EXTERN_AT, id, NODES[arg].start);
            set(&EXTERN_FN, id, f);
        }
    }
}

// (From check_program, before std's `str` is erased, when RECORD is set)
// The bindings, their flows and writes.
pub fn collect() {
    load_decls();
    load_local_decls();
    for n in 1..NODES.len() as i64 {
        let k = NODES[n].kind;
        if (NODES[n].p & NODE_IMPLICIT) != 0 || !user_pos(NODES[n].start) {
            continue;
        }
        if k == NodeKind::Let {
            let pat = NODES[n].a;
            let id = if pat > 0 { decl_binding(pat) } else { -1 };
            if id >= 0 && mentions_buf(NODES[n].b) {
                set(&TYPE_NODE, id, NODES[n].b);
                anchor(id);
            }
            let init = NODES[n].c;
            if id >= 0 && init > 0 && has_buf(NODES[init].ty) {
                anchor(id);
            }
            if id >= 0 && get(ANCHOR, id) != 0 {
                flow(id, init);
            }
            if pat > 0 && NODES[pat].kind != NodeKind::PatBind && init > 0 {
                // (`let Some(b) = e else { .. }`)
                bind_pattern(pat, if has_buf(NODES[init].ty) { binding(init) } else { -1 });
            }
        } else if k == NodeKind::Param {
            let id = decl_binding(n);
            if id >= 0 && mentions_buf(NODES[n].b) {
                set(&TYPE_NODE, id, NODES[n].b);
                anchor(id);
                // (a by-value parameter: a Buf written through it writes
                // the caller's, a String or a Vec a copy)
                if NODES[NODES[n].b].kind != NodeKind::TyPtr
                    && (NODES[n].p & (CONV_INOUT | CONV_SINK)) == 0 {
                    set(&LET_PARAM, id, 1);
                }
            }
        } else if k == NodeKind::Field {
            field_binding(n);
        } else if k == NodeKind::VariantLit {
            // (a program's variant's Buf fields: `Msg::Text(b)`)
            for i in 0..NODES[n].count {
                let fid = vfield_binding(NODES[n].a, i);
                if fid >= 0 {
                    flow(fid, child(n, i));
                }
            }
        } else if k == NodeKind::Match && NODES[n].a > 0 {
            let s = NODES[n].a;
            let sid = if has_buf(NODES[s].ty) { binding(s) } else { -1 };
            for i in 0..NODES[n].count {
                bind_pattern(NODES[child(n, i)].a, sid);
            }
        } else if k == NodeKind::Index && NODES[n].a > 0 && is_buf_type(NODES[NODES[n].a].ty) {
            note_write(binding(NODES[n].a), BYTES, WHY_INDEX, NODES[n].start);
        } else if k == NodeKind::Fn && mentions_buf(NODES[n].b) {
            let id = id_of(NODES[n].start * 4 + K_RESULT);
            set(&TYPE_NODE, id, NODES[n].b);
            anchor(id);
            RESULT_FNS.push(n);
            let body = NODES[n].c;
            if body > 0 && NODES[body].kind == NodeKind::Block && NODES[body].a != 0 {
                flow(id, NODES[body].a);
            }
        } else if k == NodeKind::Assign && NODES[n].c > 0 && has_buf(NODES[NODES[n].c].ty) {
            let target = binding(NODES[n].b);
            if target >= 0 {
                flow(target, NODES[n].c);
            }
        } else if k == NodeKind::Assign && NODES[n].c > 0 && is_buf_type(NODES[NODES[n].b].ty) {
            note_given(binding(NODES[n].b), NODES[n].c);
        } else if k == NodeKind::StructLit {
            let s = struct_node(NODES[n].ty);
            for i in 0..NODES[n].count {
                let init = child(n, i);
                let v = NODES[init].b;
                if v > 0 && has_buf(NODES[v].ty) {
                    let fid = field_binding(field_of(s, NODES[init].x, NODES[init].a));
                    if fid >= 0 {
                        flow(fid, v);
                    }
                } else if v > 0 {
                    note_given(field_binding(field_of(s, NODES[init].x, NODES[init].a)), v);
                }
            }
        } else if k == NodeKind::Call && NODES[n].x > 0 {
            let f = NODES[n].x - 1;
            if is_string_push(f) && NODES[n].a == 0 && NODES[n].count > 1 {
                let arg = child(n, 1);
                let constant = NODES[arg].kind == NodeKind::Int
                    || NODES[arg].kind == NodeKind::Char;
                if !constant || NODES[arg].a >= 0x80 {
                    let id = binding(child(n, 0));
                    STRING_BYTES.push(n);
                    STRING_BYTES.push(id);
                    note_write(id, BYTES, if constant { WHY_BYTE_HIGH } else { WHY_BYTE_VAR },
                        NODES[n].start);
                }
            }
            if is_buf_fn(f) {
                if NODES[n].a != 0 {
                    note_ctor(n, f);
                } else if NODES[n].count > 0 {
                    note_method(n, f, child(n, 0));
                }
            } else {
                note_args(n, f);
            }
        } else if k == NodeKind::Call && NODES[n].count > 0 && NODES[n].a > 0
            && NODES[NODES[n].a].kind == NodeKind::Ident && NODES[NODES[n].a].res != Res::Local
            && sym_is(NODES[NODES[n].a].a, "read_line") && is_buf_type(NODES[child(n, 0)].ty) {
            // (`read_line(&b)` of a Buf, which the checker could not
            // finish: std's read_line fills a String since 0.26.3)
            note_write(binding(child(n, 0)), TEXT, WHY_STD_STRING, NODES[child(n, 0)].start);
        } else if k == NodeKind::Call && NODES[n].a > 0 && NODES[NODES[n].a].kind == NodeKind::Ident
            && NODES[NODES[n].a].res == Res::Fn {
            // (a call the checker could not finish, `read_line(&b)` of a
            // Buf since 0.26.3: its function as the name resolved)
            note_args(n, NODES[NODES[n].a].y);
        } else if k == NodeKind::InterpHole && NODES[n].a > 0 && is_buf_type(NODES[NODES[n].a].ty) {
            // (a Buf printed, `{b}`: text)
            note_write(binding(NODES[n].a), TEXT, WHY_PRINTED, NODES[NODES[n].a].start);
        } else if k == NodeKind::MethodCall && NODES[n].a > 0
            && is_string_type(NODES[NODES[n].a].ty) {
            // (a String, format_in's since 0.26.3, given a method of
            // Buf's: renamed by the table)
            STRING_CALLS.push(n);
        } else if k == NodeKind::Interp && NODES[n].x > 0 && is_buf_fn(NODES[n].x - 1)
            && NODES[n].y > 0 && NODES[NODES[n].y].count > 0 {
            // (a `b.push_fmt("..")` the checker wrote in place: its
            // receiver is the block's first `let`'s, `__r`)
            // (`b.push_fmt("{}", x)`: its arguments' lets may come first)
            for i in 0..NODES[NODES[n].y].count {
                let s = child(NODES[n].y, i);
                if NODES[s].kind == NodeKind::Let && NODES[s].c > 0
                    && is_buf_type(NODES[NODES[s].c].ty) {
                    note_method(n, NODES[n].x - 1, NODES[s].c);
                    break;
                }
            }
        }
    }
    // The `return`s of the functions whose result is a Buf.
    for n in 1..NODES.len() as i64 {
        if NODES[n].kind != NodeKind::Return || NODES[n].a == 0 || !user_pos(NODES[n].start) {
            continue;
        }
        var best = 0;
        for i in 0..RESULT_FNS.count {
            let f = get(RESULT_FNS, i);
            if NODES[f].start <= NODES[n].start && NODES[n].end <= NODES[f].end
                && (best == 0 || NODES[f].start > NODES[best].start) {
                best = f;
            }
        }
        if best != 0 {
            flow(id_of(NODES[best].start * 4 + K_RESULT), NODES[n].a);
        }
    }
}

// ---- The edits ----

fn put_place(out: i64, pos: i64) {
    buf_bytes(out, file_text(file_of_pos(pos)));
    buf_byte(out, ':');
    buf_int(out, line_of(pos));
    buf_byte(out, ':');
    buf_int(out, pos - line_start(pos) + 1);
}

// Binding id's name, for a message: `b`, `S.f`, `f's result`, `Buf::new_in`.
fn put_binding(out: i64, id: i64) {
    let key = get(KEY, id);
    let kind = key & 3;
    let pos = key >> 2;
    buf_byte(out, '\'');
    if kind == K_LOCAL || kind == K_FIELD {
        var p = pos;
        // (a field's `pub`, `pub(crate)` before its name)
        if kind == K_FIELD && p + 3 < SRC.len as i64 && SRC[p..p + 3] == "pub"
            && !ident_byte(SRC[p + 3]) {
            p += 3;
            if SRC[p] == '(' {
                while p < SRC.len as i64 && SRC[p] != ')' {
                    p += 1;
                }
                p += 1;
            }
            while p < SRC.len as i64 && SRC[p] == ' ' {
                p += 1;
            }
        }
        var e = p;
        while e < SRC.len as i64 && (SRC[e] == '_' || SRC[e] >= 'a' && SRC[e] <= 'z'
            || SRC[e] >= 'A' && SRC[e] <= 'Z' || SRC[e] >= '0' && SRC[e] <= '9') {
            e += 1;
        }
        buf_bytes(out, SRC[p..e]);
    } else if kind == K_RESULT {
        buf_str(out, c"the result of ");
        // UNSAFE: SYMS is the symbol table, a raw pointer (base).
        // SAFETY: a function node's name is a symbol below the table's count.
        buf_bytes(out, unsafe { SYMS[NODES[fn_at(pos)].a].text });
    } else {
        buf_str(out, c"a Buf constructor");
    }
    buf_str(out, c"' at ");
    put_place(out, pos);
}

// The Fn node starting at pos (a result binding's), or 0.
fn fn_at(pos: i64) -> i64 {
    for i in 0..RESULT_FNS.count {
        let f = get(RESULT_FNS, i);
        if NODES[f].start == pos {
            return f;
        }
    }
    0
}

// Whether SRC[i] can be in an identifier.
fn ident_byte(c: u8) -> bool {
    c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
}

// Type node t's `Buf` (each, through `*`) written as the side's type:
// `Buf` -> `String<Gpa>`, `Buf<A>` -> `String<A>` or `Vec<u8, A>`,
// `std::Buf` -> `std::string::String` or `std::Vec`. The number of edits.
fn rewrite_type(t: i64, side: i64) -> i64 {
    var edits = 0;
    var i = NODES[t].start;
    let end = NODES[t].end;
    while i + 3 <= end {
        if SRC[i] == 'B' && SRC[i + 1] == 'u' && SRC[i + 2] == 'f'
            && (i == 0 || !ident_byte(SRC[i - 1]))
            && (i + 3 >= SRC.len as i64 || !ident_byte(SRC[i + 3])) {
            var start = i;
            let std_path = i >= 5 && SRC[i - 5..i] == "std::";
            if std_path {
                start = i - 5;
            }
            var stop = i + 3;
            var args: [u8] = "Gpa";
            var j = stop;
            while j < end && SRC[j] == ' ' {
                j += 1;
            }
            if j < end && SRC[j] == '<' {
                var depth = 0;
                var k = j;
                while k < end {
                    if SRC[k] == '<' {
                        depth += 1;
                    } else if SRC[k] == '>' {
                        depth -= 1;
                        if depth == 0 {
                            break;
                        }
                    }
                    k += 1;
                }
                if k < end {
                    args = SRC[j + 1..k];
                    stop = k + 1;
                }
            }
            let text = buf_new();
            if side == TEXT {
                buf_str(text, if std_path { c"std::string::String<" } else { c"String<" });
            } else {
                buf_str(text, if std_path { c"std::Vec<u8, " } else { c"Vec<u8, " });
            }
            buf_bytes(text, args);
            buf_byte(text, '>');
            if ref_in(start) && edit_replace(start, stop, text) {
                edits += 1;
            }
            i = stop;
            continue;
        }
        i += 1;
    }
    edits
}

// Constructor call n's `Buf` (its path's) written as the side's type.
fn rewrite_ctor(n: i64, side: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    let callee = NODES[n].a;
    if callee <= 0 {
        return 0;
    }
    var i = NODES[callee].start;
    let end = NODES[callee].end;
    while i + 3 <= end {
        if SRC[i] == 'B' && SRC[i + 1] == 'u' && SRC[i + 2] == 'f'
            && (i == 0 || !ident_byte(SRC[i - 1])) && !ident_byte(SRC[i + 3]) {
            var start = i;
            let std_path = i >= 5 && SRC[i - 5..i] == "std::";
            if std_path {
                start = i - 5;
            }
            let text = buf_new();
            if side == TEXT {
                buf_str(text, if std_path { c"std::string::String" } else { c"String" });
            } else {
                // (0.26.3: `Vec::<u8, Gpa>`: the allocator, its last argument's type)
                buf_str(text, if std_path { c"std::Vec::<u8" } else { c"Vec::<u8" });
                let last = if NODES[n].count > 0 { child(n, NODES[n].count - 1) } else { 0 };
                if last > 0 && NODES[last].ty > 0 {
                    buf_str(text, c", ");
                    buf_type(text, NODES[last].ty);
                }
                buf_byte(text, '>');
            }
            return if ref_in(start) && edit_replace(start, i + 3, text) { 1 } else { 0 };
        }
        i += 1;
    }
    0
}

// The method table, printed.
fn put_table() {
    let d = diag(c"note", c"fix.buf-table");
    buf_str(d, c"Buf's methods, as String<A> (text) and Vec<u8, A> (bytes); '-': none, the binding is refused\n");
    for i in 0..TABLE_COUNT {
        buf_str(d, c"  ");
        buf_bytes(d, TABLE[i][0]);
        buf_str(d, c" -> ");
        buf_bytes(d, if TABLE[i][1].len as i64 > 0 { TABLE[i][1] } else { "-" });
        buf_str(d, c" | ");
        buf_bytes(d, if TABLE[i][2].len as i64 > 0 { TABLE[i][2] } else { "-" });
        buf_byte(d, '\n');
    }
}

// A refusal of the bindings of component r (its first anchored binding
// named), why.
fn refuse(first: i64, why: i64) -> i64 {
    BUF_REFUSED += 1;
    let d = diag(c"note", c"fix.buf-refused");
    put_binding(d, first);
    buf_str(d, c": ");
    buf_bytes(d, crate::base::buf_slice(why));
    buf_byte(d, '\n');
    0
}

// The edits of every binding decided; their number. Refused ones are
// listed (fix.buf-refused), with the table.
pub fn buf_edits() -> i64 {
    let count = KEY.count;
    // Per component root: its side (0: not seen; -1: refused).
    var side = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var edits = 0;
    var refused = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for id in 0..count {
        let r = root(id);
        if side.get(r + 1) != 0 {
            continue;
        }
        // The component's evidence, its anchors, its extern use.
        var anchored = -1;
        var text_id = -1;
        var bytes_id = -1;
        var extern_id = -1;
        var strong_id = -1;
        var letw_id = -1;
        for m in 0..count {
            if root(m) != r {
                continue;
            }
            if get(ANCHOR, m) != 0 && anchored < 0 {
                anchored = m;
            }
            if get(TEXT_AT, m) >= 0 && text_id < 0 {
                text_id = m;
            }
            if get(STRONG_AT, m) >= 0 && strong_id < 0 {
                strong_id = m;
            }
            if get(LETW_AT, m) >= 0 && letw_id < 0 {
                letw_id = m;
            }
            if get(BYTES_AT, m) >= 0 && bytes_id < 0 {
                bytes_id = m;
            }
            if get(EXTERN_AT, m) >= 0 && extern_id < 0 {
                extern_id = m;
            }
        }
        if anchored < 0 {
            side.put(r + 1, -1);
            continue;
        }
        let why = buf_new();
        var s = 0;
        if extern_id >= 0 {
            buf_str(why, c"passed to std's '");
            // UNSAFE: FNS and SYMS are the checker's tables, raw pointers.
            // SAFETY: EXTERN_FN holds a resolved call's function, below
            // FN_COUNT; its display name is a symbol.
            buf_bytes(why, unsafe { SYMS[FNS[get(EXTERN_FN, extern_id)].display].text });
            buf_str(why, c"' at ");
            put_place(why, get(EXTERN_AT, extern_id));
            buf_str(why, c", which takes a Buf");
        } else if strong_id >= 0 && bytes_id >= 0 {
            buf_str(why, c"mixed: text (");
            buf_bytes(why, why_text(get(STRONG_WHY, strong_id)));
            buf_str(why, c" at ");
            put_place(why, get(STRONG_AT, strong_id));
            buf_str(why, c") and bytes (");
            buf_bytes(why, why_text(get(BYTES_WHY, bytes_id)));
            buf_str(why, c" at ");
            put_place(why, get(BYTES_AT, bytes_id));
            buf_str(why, c")");
        } else if letw_id >= 0 {
            if letw_id != anchored {
                put_binding(why, letw_id);
                buf_str(why, c", ");
            }
            buf_str(why, c"a by-value parameter, written at ");
            put_place(why, get(LETW_AT, letw_id));
            buf_str(why,
                c" (a Buf there is the caller's, a String or a Vec a copy): make it `inout` first (refactor signature)");
        } else {
            // (bytes win over the weak text writes; no write at all: a
            // Vec<u8, A>, the bytes the Buf held)
            s = if text_id >= 0 && bytes_id < 0 { TEXT } else { BYTES };
            // (a constructor with no form on that side: Buf::from_in as bytes)
            for m in 0..count {
                let c = CTOR_OF.get(m + 1) - 1;
                if s == BYTES && c > 0 && root(m) == r && NODES[c].x > 0
                    && sym_is(NODES[fn_node(template(NODES[c].x - 1))].a, "from_in") {
                    buf_str(why, c"bytes, but its Buf::from_in at ");
                    put_place(why, NODES[c].start);
                    buf_str(why, c" has no Vec<u8, A> form");
                    s = 0;
                    break;
                }
            }
            // (a method with no form on that side)
            var k = 0;
            while s != 0 && k < CALLS.count {
                if root(get(CALLS, k + 1)) == r {
                    // UNSAFE: SYMS is the symbol table, a raw pointer (base).
                    // SAFETY: CALLS holds methods' names, symbols.
                    let name = unsafe { SYMS[get(CALLS, k + 2)].text };
                    let row = row_of(name);
                    if row < 0 || TABLE[row][s].len as i64 == 0 {
                        buf_str(why, if s == TEXT { c"text" } else { c"bytes" });
                        buf_str(why, c", but its '");
                        buf_bytes(why, name);
                        buf_str(why, c"' at ");
                        put_place(why, NODES[get(CALLS, k)].start);
                        buf_str(why, if s == TEXT { c" has no String<A> form" }
                            else { c" has no Vec<u8, A> form" });
                        s = 0;
                        break;
                    }
                }
                k += 4;
            }
        }
        if s == 0 {
            side.put(r + 1, -1);
            refused.put(r + 1, 1);
            refuse(anchored, why);
            continue;
        }
        side.put(r + 1, s);
    }
    // The rewrites of the decided components.
    for id in 0..count {
        let s = side.get(root(id) + 1);
        if s <= 0 {
            continue;
        }
        let t = get(TYPE_NODE, id);
        if t > 0 {
            edits += rewrite_type(t, s);
        }
        if (get(KEY, id) & 3) == K_CTOR {
            edits += rewrite_ctor(CTOR_OF.get(id + 1) - 1, s);
        }
    }
    var k = 0;
    while k < CALLS.count {
        let s = side.get(root(get(CALLS, k + 1)) + 1);
        let at = get(CALLS, k + 3);
        if s > 0 && at >= 0 {
            // UNSAFE: SYMS is the symbol table, a raw pointer (base).
            // SAFETY: CALLS holds methods' names, symbols.
            let name = unsafe { SYMS[get(CALLS, k + 2)].text };
            let row = row_of(name);
            if row >= 0 && TABLE[row][s] != name && SRC[at..at + name.len as i64] == name {
                let text = buf_new();
                buf_bytes(text, TABLE[row][s]);
                if ref_in(at) && edit_replace(at, at + name.len as i64, text) {
                    edits += 1;
                }
            }
        }
        k += 4;
    }
    // (a String's calls of Buf's methods, by the text side of the table)
    for i in 0..STRING_CALLS.count {
        let n = get(STRING_CALLS, i);
        // UNSAFE: SYMS is the symbol table, a raw pointer (base).
        // SAFETY: a MethodCall's b is the method's name, a symbol.
        let name = unsafe { SYMS[NODES[n].b].text };
        let row = row_of(name);
        let at = name_after_dot(NODES[NODES[n].a].end, NODES[n].end);
        if row >= 0 && at >= 0 && TABLE[row][TEXT].len as i64 > 0 && TABLE[row][TEXT] != name
            && SRC[at..at + name.len as i64] == name {
            let text = buf_new();
            buf_bytes(text, TABLE[row][TEXT]);
            if ref_in(at) && edit_replace(at, at + name.len as i64, text) {
                edits += 1;
            }
        }
    }
    // (a String given bytes: refused, with the form that keeps them)
    var j = 0;
    while j + 1 < STRING_BYTES.count {
        let n = get(STRING_BYTES, j);
        let id = get(STRING_BYTES, j + 1);
        j += 2;
        if !ref_in(NODES[n].start) || id >= 0 && refused.get(root(id) + 1) != 0 {
            continue;
        }
        if id >= 0 {
            // (once a binding)
            refused.put(root(id) + 1, 1);
        }
        BUF_REFUSED += 1;
        let d = diag(c"note", c"fix.buf-refused");
        if id >= 0 {
            put_binding(d, id);
        } else {
            buf_str(d, c"a String");
        }
        buf_str(d, c": a String given a byte (a push at ");
        put_place(d, NODES[n].start);
        buf_str(d,
            c", a code point since 0.20): for bytes, `format_in(..).into_bytes()`, a Vec<u8, A>\n");
    }
    if edits > 0 || BUF_REFUSED > 0 {
        put_table();
    }
    edits
}
