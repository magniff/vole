// `volec fix --only buf` (0.26.3; explain fix.buf-refused): std's `Buf`
// becomes `String<A>` where it holds text and `Vec<u8, A>` where it holds
// bytes, binding by binding, by the evidence of its writes:
//
//   text:  Buf::from_in of a `str`, a Buf printed (`{b}`), given a String
//          or passed where std takes one; and, weakly, a push_str of a
//          `str` (a string literal is one), a push of a constant byte
//          below 0x80 and a format write (push_fmt, push_int; on a Vec,
//          `extend_from_slice(format_in(.., v.allocator()).as_bytes())`):
//          the same bytes in a Vec<u8, A>, so they decide text only when
//          nothing says bytes (0.26.3, the mass run);
//   bytes: a push of a byte that is not a constant, a push of a constant
//          at or above 0x80, a push_str of a `[u8]` (a `[u8]` constant
//          too), as_mut_slice, an index (`b[i]`); and a binding with no
//          write at all, which a Vec<u8, A> holds as the Buf did;
//   mixed (text the weak rule does not cover, and bytes): refused, with
//          the binding and the writes on each side named; so is a binding
//          written through a by-value parameter (a Buf is a handle there,
//          a String or a Vec a copy). It never guesses.
//
// A binding is a local or a parameter, a field, a function's result or a
// constructor call (`Buf::new_in(gpa)`); bindings a value flows between
// (`let b = c`, `b = c`, an argument and its parameter, a returned value
// and the result, a field's initializer) are one, decided together; so
// are a value and what holds it (an `Option<Buf<A>>`, a `Vec<Buf<A>, A>`:
// a variant's payload, a pattern's binding, a std generic's argument and
// result, an enum variant's `Buf` field), and a use a closure captured
// and its local. A binding passed to a std function whose parameter is
// written `Buf` is refused too (std keeps the Buf there). The methods map through TABLE, which the run
// prints; a method with no form on the side decided refuses its binding.
//
// The checker's view is read before std's `str` is erased to `[u8]`
// (collect, from check_program, when RECORD is set); the edits are made
// after (buf_edits, from fix/command.vl).

use crate::base::{IntVec, SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{CONV_INOUT, CONV_SINK, NODE_CAPTURE, NODE_IMPLICIT, NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, within_std};
use crate::front::types::{ENUMS, TyKind, buf_type};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::fix::user_pos;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::{find_name, line_of, line_start};
use crate::tools::query::refs::{file_text, ref_in};
use crate::tools::refactor_mod::local::load_decls;

// Kinds of binding, the low two bits of a key (the rest: a position).
const K_LOCAL: i64 = 0;
const K_FIELD: i64 = 1;
const K_RESULT: i64 = 2;
const K_CTOR: i64 = 3;

// The sides.
const TEXT: i64 = 1;
const BYTES: i64 = 2;

// The writes, what they are.
const WHY_STR: i64 = 1;
const WHY_FMT: i64 = 2;
const WHY_ASCII: i64 = 3;
const WHY_FROM_STR: i64 = 4;
const WHY_BYTE_VAR: i64 = 5;
const WHY_BYTE_HIGH: i64 = 6;
const WHY_BYTES_STR: i64 = 7;
const WHY_MUT_SLICE: i64 = 8;
const WHY_FROM_BYTES: i64 = 9;
const WHY_STRING: i64 = 10;
const WHY_STD_STRING: i64 = 11;
const WHY_PRINTED: i64 = 12;
const WHY_INDEX: i64 = 13;

// Whether write `why` on the text side decides text even against bytes:
// not a push_str of a str or a constant ASCII byte, which a Vec<u8, A>
// takes as the same bytes.
fn strong_text(why: i64) -> bool {
    why != WHY_STR && why != WHY_ASCII && why != WHY_FMT
}

fn why_text(w: i64) -> [u8] {
    if w == WHY_STR { "push_str of a str" }
    else if w == WHY_FMT { "a format write" }
    else if w == WHY_ASCII { "push of a constant byte below 0x80" }
    else if w == WHY_FROM_STR { "Buf::from_in of a str" }
    else if w == WHY_BYTE_VAR { "push of a byte that is not a constant" }
    else if w == WHY_BYTE_HIGH { "push of a constant byte at or above 0x80" }
    else if w == WHY_BYTES_STR { "push_str of a [u8]" }
    else if w == WHY_MUT_SLICE { "as_mut_slice" }
    else if w == WHY_FROM_BYTES { "Buf::from_in of a [u8]" }
    else if w == WHY_STRING { "given a String (format_in's, 0.26.3)" }
    else if w == WHY_PRINTED { "printed as text" }
    else if w == WHY_STD_STRING { "passed where std takes a String (read_line, 0.26.3)" }
    else if w == WHY_INDEX { "indexed (`b[i]`: a String has no index)" }
    else { "a write" }
}

// The method table: Buf's method, its String<A> form, its Vec<u8, A>
// form ("": none, the binding is refused).
const TABLE_COUNT: i64 = 18;
static TABLE: [[[u8]; 3]; 18] = [
    ["new_in", "String::new_in", "Vec::<u8>::new_in"],
    ["with_capacity_in", "String::with_capacity_in", "Vec::<u8>::with_capacity_in"],
    ["from_in", "String::from_in", ""],
    ["len", "len", "len"],
    ["push", "push", "push"],
    ["push_str", "push_str", "extend_from_slice"],
    ["push_fmt", "push_fmt", "extend_from_slice(format_in(.., v.allocator()).as_bytes())"],
    ["push_int", "push_fmt", "extend_from_slice(format_in(\"{}\", .., v.allocator()).as_bytes())"],
    ["push_cstr", "", ""],
    ["as_slice", "as_slice", "as_slice"],
    ["as_mut_slice", "", "as_mut_slice"],
    ["clear", "clear", "clear"],
    ["free", "free", "free"],
    ["take", "", "take"],
    ["capacity", "capacity", "capacity"],
    ["reserve", "reserve", "reserve"],
    ["allocator", "allocator", "allocator"],
    ["clone", "clone", "clone"],
];

// The row of method `name` in TABLE, or -1.
fn row_of(name: [u8]) -> i64 {
    for i in 0..TABLE_COUNT {
        if TABLE[i][0] == name {
            return i;
        }
    }
    -1
}

fn get(v: IntVec, i: i64) -> i64 {
    // UNSAFE: an IntVec's data is a raw pointer (base).
    // SAFETY: every caller's i is an id or an index below v.count (the
    // tables of ids grow together in id_of).
    unsafe { v.data[i] }
}

fn set(v: inout IntVec, i: i64, x: i64) {
    // UNSAFE: as get's.
    // SAFETY: as get's: i is below v.count.
    unsafe {
        v.data[i] = x;
    }
}

// The id of the binding with key `key`, made if new.
fn id_of(key: i64, pcx: inout Ctx<Comp>) -> i64 {
    let had = pcx.ids.get(key + 1);
    if had != 0 {
        return had - 1;
    }
    let id = pcx.key.count;
    pcx.ids.put(key + 1, id + 1);
    pcx.key.push(key);
    pcx.parent.push(id);
    pcx.type_node.push(0);
    pcx.anchor.push(0);
    pcx.text_at.push(-1);
    pcx.text_why.push(0);
    pcx.bytes_at.push(-1);
    pcx.bytes_why.push(0);
    pcx.extern_at.push(-1);
    pcx.extern_fn.push(-1);
    pcx.strong_at.push(-1);
    pcx.strong_why.push(0);
    pcx.let_param.push(0);
    pcx.letw_at.push(-1);
    id
}

fn root(id: i64, pcx: Ctx<Comp>) -> i64 {
    var r = id;
    while get(pcx.parent, r) != r {
        r = get(pcx.parent, r);
    }
    r
}

fn join(a: i64, b: i64, pcx: inout Ctx<Comp>) {
    if a < 0 || b < 0 {
        return;
    }
    let ra = root(a, pcx);
    let rb = root(b, pcx);
    if ra != rb {
        set(&pcx.parent, rb, ra);
    }
}

fn anchor(id: i64, pcx: inout Ctx<Comp>) {
    if id >= 0 {
        set(&pcx.anchor, id, 1);
    }
}

fn note_write(id: i64, side: i64, why: i64, pos: i64, pcx: inout Ctx<Comp>) {
    if id < 0 {
        return;
    }
    if side == TEXT {
        if get(pcx.text_at, id) < 0 {
            set(&pcx.text_at, id, pos);
            set(&pcx.text_why, id, why);
        }
        if strong_text(why) && get(pcx.strong_at, id) < 0 {
            set(&pcx.strong_at, id, pos);
            set(&pcx.strong_why, id, why);
        }
    } else if side == BYTES && get(pcx.bytes_at, id) < 0 {
        set(&pcx.bytes_at, id, pos);
        set(&pcx.bytes_why, id, why);
    }
}

fn sym_is(sym: i64, s: [u8], pcx: Ctx<Comp>) -> bool {
    // UNSAFE: SYMS is the symbol table, a raw pointer (base).
    // SAFETY: sym is a node's name, a symbol below the table's count.
    sym > 0 && unsafe { sym_text(sym, pcx) } == s
}

// Whether type t is std's Buf (through a pointer).
fn is_buf_type(t0: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: TYPES and STRUCTS are the type tables, raw pointers (front/types).
    // SAFETY: t0 is a checked node's type, a TYPES index (0: none); a struct
    // type's a is its STRUCTS index, an instance's tmpl - 1 its template's.
    unsafe {
        if t0 <= 0 {
            return false;
        }
        let t = if pcx.types[t0].kind == TyKind::Ptr { pcx.types[t0].a } else { t0 };
        if t <= 0 || pcx.types[t].kind != TyKind::Struct {
            return false;
        }
        var s = pcx.types[t].a;
        if pcx.structs[s].tmpl != 0 {
            s = pcx.structs[s].tmpl - 1;
        }
        sym_is(pcx.structs[s].name, "Buf", pcx) && within_std(pcx.structs[s].module, pcx)
    }
}

// Whether type t is std's String (through a pointer): what format_in
// makes and read_line fills since 0.26.3.
fn is_string_type(t0: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: as is_buf_type's.
    // SAFETY: as is_buf_type's.
    unsafe {
        if t0 <= 0 {
            return false;
        }
        let t = if pcx.types[t0].kind == TyKind::Ptr { pcx.types[t0].a } else { t0 };
        if t <= 0 || pcx.types[t].kind != TyKind::Struct {
            return false;
        }
        var s = pcx.types[t].a;
        if pcx.structs[s].tmpl != 0 {
            s = pcx.structs[s].tmpl - 1;
        }
        sym_is(pcx.structs[s].name, "String", pcx) && within_std(pcx.structs[s].module, pcx)
    }
}

// Whether type t is a Buf or holds one through its type arguments, a
// pointer, a slice or an array (`Option<Buf<A>>`, `Vec<Buf<A>, A>`).
fn has_buf(t: i64, pcx: Ctx<Comp>) -> bool {
    has_buf_at(t, 0, pcx)
}

fn has_buf_at(t: i64, depth: i64, pcx: Ctx<Comp>) -> bool {
    if t <= 0 || depth > 6 {
        return false;
    }
    if is_buf_type(t, pcx) {
        return true;
    }
    // UNSAFE: TYPES, STRUCTS, ENUMS and TLISTS are the type tables, raw
    // pointers (front/types).
    // SAFETY: t is a checked node's type, a TYPES index; a struct's or an
    // enum's a is its table's index, its targs a run of targ_count TLISTS.
    unsafe {
        let k = pcx.types[t].kind;
        if k == TyKind::Ptr || k == TyKind::Slice || k == TyKind::Array {
            return has_buf_at(pcx.types[t].a, depth + 1, pcx);
        }
        if k == TyKind::Struct {
            let s = pcx.types[t].a;
            if pcx.structs[s].closure != 0 {
                return false;
            }
            for i in 0..pcx.structs[s].targ_count {
                if has_buf_at(pcx.tlists.data[pcx.structs[s].targs + i], depth + 1, pcx) {
                    return true;
                }
            }
        } else if k == TyKind::Enum {
            let e = pcx.types[t].a;
            for i in 0..ENUMS[e].targ_count {
                if has_buf_at(pcx.tlists.data[ENUMS[e].targs + i], depth + 1, pcx) {
                    return true;
                }
            }
        }
    }
    false
}

// Whether type node n is written with a `Buf` in it (`Buf<A>`,
// `Option<Buf<A>>`, `inout Vec<Buf<A>, A>`): rewrite_type's `Buf`s.
fn mentions_buf(n: i64, pcx: Ctx<Comp>) -> bool {
    if n <= 0 {
        return false;
    }
    var i = pcx.nodes[n].start;
    let end = pcx.nodes[n].end;
    while i + 3 <= end {
        if SRC[i] == 'B' && SRC[i + 1] == 'u' && SRC[i + 2] == 'f'
            && (i == 0 || !ident_byte(SRC[i - 1]))
            && (i + 3 >= SRC.len as i64 || !ident_byte(SRC[i + 3])) {
            return true;
        }
        i += 1;
    }
    false
}

// Value v given to binding id (its initializer, a value assigned or
// returned, an argument): a String is text evidence (a program written
// before format_in made one).
fn note_given(id: i64, v: i64, pcx: inout Ctx<Comp>) {
    if id >= 0 && v > 0 && is_string_type(pcx.nodes[v].ty, pcx) {
        note_write(id, TEXT, WHY_STRING, pcx.nodes[v].start, &pcx);
    }
}

// Value v flows into binding id: a binding joined, a String noted, the
// branches of an `if` or a `match` and a block's tail each.
fn flow(id: i64, v: i64, pcx: inout Ctx<Comp>) {
    if id < 0 || v <= 0 {
        return;
    }
    let k = pcx.nodes[v].kind;
    if k == NodeKind::Block {
        flow(id, pcx.nodes[v].a, &pcx);
    } else if k == NodeKind::If {
        flow(id, pcx.nodes[v].b, &pcx);
        flow(id, pcx.nodes[v].c, &pcx);
    } else if k == NodeKind::Match {
        for i in 0..pcx.nodes[v].count {
            flow(id, pcx.nodes[child(v, i, pcx)].c, &pcx);
        }
    } else if k == NodeKind::VariantLit && vfield_binding(pcx.nodes[v].a, 0, &pcx) < 0 {
        // (std's `Some(b)`, `Err(b)`: the payload is the holder's; a
        // program's variant's Buf fields are bindings of their own,
        // collect's VariantLit)
        for i in 0..pcx.nodes[v].count {
            flow(id, child(v, i, pcx), &pcx);
        }
    } else if has_buf(pcx.nodes[v].ty, pcx) {
        join(id, binding(v, &pcx), &pcx);
    } else {
        note_given(id, v, &pcx);
        // (a String local: one binding with it, its byte pushes count)
        if is_string_type(pcx.nodes[v].ty, pcx) {
            join(id, binding(v, &pcx), &pcx);
        }
    }
}

// Whether e is a `[u8]` constant of a literal (`const HEAD: [u8] = "..";`):
// the checker makes its use a Str node, its name left in the source. Bytes,
// as its type says.
fn bytes_const(e: i64, pcx: Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e].kind != NodeKind::Str || is_str_type(pcx.nodes[e].ty, pcx) {
        return false;
    }
    let at = pcx.nodes[e].start;
    ident_byte(SRC[at]) && !(SRC[at] == 'r' && (SRC[at + 1] == '"' || SRC[at + 1] == '#'))
}

// Whether e is a local declared `str` (its use given to Buf's push_str is
// typed as the parameter, `[u8]`), through a `&` or a `*`.
fn str_local(e: i64, pcx: Ctx<Comp>) -> bool {
    if e <= 0 {
        return false;
    }
    if pcx.nodes[e].kind == NodeKind::Unary {
        return str_local(pcx.nodes[e].b, pcx);
    }
    if pcx.nodes[e].kind != NodeKind::Ident || pcx.nodes[e].res != Res::Local {
        return false;
    }
    let l = pcx.nodes[e].y;
    // UNSAFE: LOCALS is the checker's table of locals, a raw pointer.
    // SAFETY: l is checked below LOCAL_COUNT first.
    l >= 0 && l < pcx.locals.len() as i64
        && unsafe { pcx.locals[l].name == pcx.nodes[e].a && is_str_type(pcx.locals[l].ty, pcx) }
}

// Whether type t is std's `str`.
fn is_str_type(t: i64, pcx: Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let b = buf_new();
    buf_type(b, t, pcx);
    crate::base::buf_slice(b) == "str"
}

// Whether type node n is written `Buf`, `std::Buf<A>`, or a pointer to one.
fn buf_type_node(n: i64, pcx: Ctx<Comp>) -> bool {
    if n <= 0 {
        return false;
    }
    let k = pcx.nodes[n].kind;
    if k == NodeKind::TyPtr {
        return buf_type_node(pcx.nodes[n].a, pcx);
    }
    k == NodeKind::TyName && sym_is(pcx.nodes[n].a, "Buf", pcx)
}

// The function a call or a name resolved to (its template), or -1.
fn template(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: f is a resolved call's function, below FN_COUNT; tmpl - 1 is
    // its template's index.
    unsafe {
        if pcx.fns[f].tmpl != 0 { pcx.fns[f].tmpl - 1 } else { f }
    }
}

fn fn_node(f: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: as template's.
    // SAFETY: f is a function's index, below FN_COUNT.
    unsafe { pcx.fns[f].node }
}

// Whether function f is one of std's Buf's (an impl of Buf's).
fn is_buf_fn(f: i64, pcx: Ctx<Comp>) -> bool {
    let t = template(f, pcx);
    // UNSAFE: as template's.
    // SAFETY: t is a function's index, below FN_COUNT.
    let m = unsafe { pcx.fns[t].module };
    let node = fn_node(t, pcx);
    node > 0 && pcx.nodes[node].kind == NodeKind::Fn && sym_is(pcx.nodes[node].d, "Buf", pcx)
        && within_std(m, pcx)
}

// Whether function f is std's String::push (a code point since 0.20).
fn is_string_push(f: i64, pcx: Ctx<Comp>) -> bool {
    let t = template(f, pcx);
    // UNSAFE: as template's.
    // SAFETY: t is a function's index, below FN_COUNT.
    let m = unsafe { pcx.fns[t].module };
    let node = fn_node(t, pcx);
    node > 0 && pcx.nodes[node].kind == NodeKind::Fn && sym_is(pcx.nodes[node].d, "String", pcx)
        && sym_is(pcx.nodes[node].a, "push", pcx) && within_std(m, pcx)
}

// Whether parameter i of function f (its template's) is a Buf.
fn param_is_buf(f: i64, i: i64, pcx: Ctx<Comp>) -> bool {
    // (the instance's own types first: a generic impl's template
    // writes `Buf<A>`, which is not yet a struct type)
    for t in [f, template(f, pcx)] {
        // UNSAFE: FNS and TLISTS are the checker's tables, raw pointers.
        // SAFETY: i is below the function's param_count (checked), so
        // params + i is in its TLISTS run.
        let yes = unsafe {
            i < pcx.fns[t].param_count && is_buf_type(pcx.tlists.data[pcx.fns[t].params + i], pcx)
        };
        if yes {
            return true;
        }
    }
    false
}

// Whether parameter i of function f (its template's) is a String.
fn param_is_string(f: i64, i: i64, pcx: Ctx<Comp>) -> bool {
    let t = template(f, pcx);
    // UNSAFE: FNS and TLISTS are the checker's tables, raw pointers.
    // SAFETY: as param_is_buf's.
    unsafe {
        if i >= pcx.fns[t].param_count {
            return false;
        }
        is_string_type(pcx.tlists.data[pcx.fns[t].params + i], pcx)
    }
}

// Whether function f is one of std's printers (print, println, eprint,
// eprintln, format_in, panic): what it is given is text.
fn printer(f: i64, pcx: Ctx<Comp>) -> bool {
    let t = template(f, pcx);
    // UNSAFE: FNS is the table of functions, a raw pointer (front/types).
    // SAFETY: t is a function's index, below FN_COUNT.
    let m = unsafe { pcx.fns[t].module };
    let node = fn_node(t, pcx);
    if node <= 0 || !within_std(m, pcx) {
        return false;
    }
    let a = pcx.nodes[node].a;
    sym_is(a, "print", pcx) || sym_is(a, "println", pcx) || sym_is(a, "eprint", pcx)
        || sym_is(a, "eprintln", pcx) || sym_is(a, "format_in", pcx) || sym_is(a, "panic", pcx)
}

// The struct item of struct type t (through a pointer), or 0.
fn struct_node(t0: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: as is_buf_type's.
    // SAFETY: as is_buf_type's.
    unsafe {
        if t0 <= 0 {
            return 0;
        }
        let t = if pcx.types[t0].kind == TyKind::Ptr { pcx.types[t0].a } else { t0 };
        if t <= 0 || pcx.types[t].kind != TyKind::Struct
            || pcx.structs[pcx.types[t].a].closure != 0 {
            return 0;
        }
        pcx.structs[pcx.types[t].a].node
    }
}

fn field_of(s: i64, i: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    if s <= 0 || i < 0 || i >= pcx.nodes[s].count || pcx.nodes[child(s, i, pcx)].a != name {
        return 0;
    }
    child(s, i, pcx)
}

// The binding of field node f (a program's).
fn field_binding(f: i64, pcx: inout Ctx<Comp>) -> i64 {
    if f <= 0 || !user_pos(pcx.nodes[f].start, pcx) {
        return -1;
    }
    let id = id_of(pcx.nodes[f].start * 4 + K_FIELD, &pcx);
    if mentions_buf(pcx.nodes[f].b, pcx) {
        set(&pcx.type_node, id, pcx.nodes[f].b);
        anchor(id, &pcx);
    }
    id
}

// The binding of field i of enum variant v (VARIANTS), a program's that
// is written with a `Buf` (its type node's position, as a field's), or -1.
fn vfield_binding(v: i64, i: i64, pcx: inout Ctx<Comp>) -> i64 {
    if v < 0 {
        return -1;
    }
    // UNSAFE: VARIANTS is the table of variants, a raw pointer (front/types).
    // SAFETY: v is a checked VariantLit's or PatVariant's variant, below
    // VARIANT_COUNT.
    let vn = unsafe { pcx.variants[v].node };
    if vn <= 0 || pcx.nodes[vn].kind != NodeKind::Variant || i < 0 || i >= pcx.nodes[vn].count {
        return -1;
    }
    let t = child(vn, i, pcx);
    if t <= 0 || !user_pos(pcx.nodes[t].start, pcx) || !mentions_buf(t, pcx) {
        return -1;
    }
    let id = id_of(pcx.nodes[t].start * 4 + K_FIELD, &pcx);
    set(&pcx.type_node, id, t);
    anchor(id, &pcx);
    id
}

// Pattern pat matched against a value of binding sid (-1: none): each of
// its bindings that holds a Buf is one with it (`Some(b)` of an
// `Option<Buf<A>>`), or with a program's variant's Buf field (`Msg::Text(t)`).
fn bind_pattern(pat: i64, sid: i64, pcx: inout Ctx<Comp>) {
    if pat <= 0 {
        return;
    }
    let k = pcx.nodes[pat].kind;
    if k == NodeKind::PatBind {
        let id = decl_binding(pat, &pcx);
        if sid >= 0 && id >= 0 && (pcx.nodes[pat].ty <= 0 || has_buf(pcx.nodes[pat].ty, pcx)) {
            join(sid, id, &pcx);
        }
    } else if k == NodeKind::PatVariant {
        for i in 0..pcx.nodes[pat].count {
            let fid = vfield_binding(pcx.nodes[pat].x, i, &pcx);
            bind_pattern(child(pat, i, pcx), if fid >= 0 { fid } else { sid }, &pcx);
        }
    } else if k == NodeKind::PatTuple || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[pat].count {
            bind_pattern(child(pat, i, pcx), sid, &pcx);
        }
    }
}

// Fills DECL_HEAD, DECL_AT, DECL_NAME and DECL_NEXT: every declaration of
// a local.
fn load_local_decls(pcx: inout Ctx<Comp>) {
    if pcx.decl_at.count > 0 {
        return;
    }
    for n in 1..pcx.nodes.len() as i64 {
        let p = decl_pos(n, pcx);
        if p >= 0 {
            let l = pcx.nodes[n].x;
            let e = pcx.decl_at.count;
            pcx.decl_at.push(p);
            pcx.decl_name.push(pcx.nodes[n].a);
            pcx.decl_next.push(pcx.decl_head.get(l + 1) - 1);
            pcx.decl_head.put(l + 1, e + 1);
        }
    }
}

// The position of the declaration of the local use e names (an Ident, or
// a use a closure captured), or -1: of the declarations of its local's
// index (with its name), the nearest before it. (The checker numbers each
// function's locals from 0 and a generic one's body is checked after, so
// an index names a local of each function, and LOCALS holds the last
// one's: use_decl and decl_name_pos, which check LOCALS, miss the others.)
fn local_decl(e: i64, pcx: Ctx<Comp>) -> i64 {
    let captured = (pcx.nodes[e].p & NODE_CAPTURE) != 0 && pcx.nodes[e].d > 0;
    if !captured && (pcx.nodes[e].kind != NodeKind::Ident || pcx.nodes[e].res != Res::Local) {
        return -1;
    }
    let l = if captured { pcx.nodes[e].d - 1 } else { pcx.nodes[e].y };
    let at = pcx.nodes[e].start;
    var best = -1;
    var i = pcx.decl_head.get(l + 1) - 1;
    while i >= 0 {
        let p = get(pcx.decl_at, i);
        if p <= at && p > best && (captured || get(pcx.decl_name, i) == pcx.nodes[e].a) {
            best = p;
        }
        i = get(pcx.decl_next, i);
    }
    best
}

// The position of the name the PatBind or Param node n declares, in a
// file of the program, or -1 (decl_name_pos without its LOCALS check).
fn decl_pos(n: i64, pcx: Ctx<Comp>) -> i64 {
    let k = pcx.nodes[n].kind;
    if k != NodeKind::PatBind && k != NodeKind::Param || pcx.nodes[n].x < 0
        || pcx.nodes[n].end <= pcx.nodes[n].start || !user_pos(pcx.nodes[n].start, pcx) {
        return -1;
    }
    find_name(pcx.nodes[n].start, pcx.nodes[n].end, pcx.nodes[n].a, false, pcx)
}

// The binding of local `l`'s declaration (a PatBind or Param node d).
fn decl_binding(d: i64, pcx: inout Ctx<Comp>) -> i64 {
    let p = decl_pos(d, pcx);
    if p < 0 { -1 } else { id_of(p * 4 + K_LOCAL, &pcx) }
}

// The binding expression e denotes, or -1.
fn binding(e: i64, pcx: inout Ctx<Comp>) -> i64 {
    if e <= 0 {
        return -1;
    }
    if (pcx.nodes[e].p & NODE_CAPTURE) != 0 && pcx.nodes[e].d > 0 {
        // (a use a closure captured, now `*(*env).x`: its local's)
        let p = local_decl(e, pcx);
        return if p < 0 { -1 } else { id_of(p * 4 + K_LOCAL, &pcx) };
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Unary && (pcx.nodes[e].op == Tok::Amp || pcx.nodes[e].op == Tok::Star) {
        return binding(pcx.nodes[e].b, &pcx);
    }
    if k == NodeKind::Block {
        return if pcx.nodes[e].a != 0 { binding(pcx.nodes[e].a, &pcx) } else { -1 };
    }
    if k == NodeKind::Try {
        return binding(pcx.nodes[e].a, &pcx);
    }
    if k == NodeKind::Ident && pcx.nodes[e].res == Res::Local {
        let p = local_decl(e, pcx);
        return if p < 0 { -1 } else { id_of(p * 4 + K_LOCAL, &pcx) };
    }
    if k == NodeKind::Index && !is_buf_type(pcx.nodes[pcx.nodes[e].a].ty, pcx)
        && has_buf(pcx.nodes[pcx.nodes[e].a].ty, pcx) {
        // (`v[i]` of a Vec<Buf<A>, A>: the holder's)
        return binding(pcx.nodes[e].a, &pcx);
    }
    if k == NodeKind::FieldAccess && pcx.nodes[e].y != 2 {
        let s = struct_node(pcx.nodes[pcx.nodes[e].a].ty, pcx);
        return field_binding(field_of(s, pcx.nodes[e].x, pcx.nodes[e].b, pcx), &pcx);
    }
    if k == NodeKind::Call && pcx.nodes[e].x > 0 {
        let f = pcx.nodes[e].x - 1;
        if is_buf_fn(f, pcx) && pcx.nodes[e].a != 0 {
            let id = id_of(pcx.nodes[e].start * 4 + K_CTOR, &pcx);
            anchor(id, &pcx);
            pcx.ctor_of.put(id + 1, e + 1);
            return id;
        }
        if is_buf_fn(f, pcx) && pcx.nodes[e].count > 0 && is_buf_type(pcx.nodes[e].ty, pcx) {
            // (`b.clone()`, `b.take()`: the receiver's)
            return binding(child(e, 0, pcx), &pcx);
        }
        let def = fn_node(template(f, pcx), pcx);
        if def > 0 && user_pos(pcx.nodes[def].start, pcx) && has_buf(pcx.nodes[e].ty, pcx)
            && mentions_buf(pcx.nodes[def].b, pcx) {
            return id_of(pcx.nodes[def].start * 4 + K_RESULT, &pcx);
        }
        if def > 0 && !user_pos(pcx.nodes[def].start, pcx) && has_buf(pcx.nodes[e].ty, pcx)
            && !mentions_buf(pcx.nodes[def].b, pcx) {
            // (a std generic's result, `v.get(0)`, `o.unwrap()`,
            // `std::replace(&s.f, b)`: its first argument's that holds one)
            for i in 0..pcx.nodes[e].count {
                let arg = child(e, i, pcx);
                if pcx.nodes[arg].kind != NodeKind::NamedArg && has_buf(pcx.nodes[arg].ty, pcx) {
                    return binding(arg, &pcx);
                }
            }
        }
    }
    -1
}

// The start of the name after the `.` at or after pos (a method's), or -1.
fn name_after_dot(pos: i64, end: i64) -> i64 {
    var i = pos;
    while i < end && SRC[i] != '.' {
        i += 1;
    }
    if i >= end {
        return -1;
    }
    i += 1;
    while i < end && (SRC[i] == ' ' || SRC[i] == '\n' || SRC[i] == '\t' || SRC[i] == '\r') {
        i += 1;
    }
    i
}

// Method call n (receiver recv) of Buf's function f: its write's evidence,
// and the call kept for its rename.
fn note_method(n: i64, f: i64, recv: i64, pcx: inout Ctx<Comp>) {
    let id = binding(recv, &pcx);
    if id < 0 {
        return;
    }
    anchor(id, &pcx);
    let def = fn_node(template(f, pcx), pcx);
    let name = pcx.nodes[def].a;
    // UNSAFE: SYMS is the symbol table, a raw pointer (base).
    // SAFETY: name is a function's name, a symbol below the table's count.
    let text = unsafe { sym_text(name, pcx) };
    pcx.buf_calls.push(n);
    pcx.buf_calls.push(id);
    pcx.buf_calls.push(name);
    pcx.buf_calls.push(name_after_dot(pcx.nodes[recv].end, pcx.nodes[n].end));
    let pos = pcx.nodes[n].start;
    if get(pcx.let_param, id) != 0 && get(pcx.letw_at, id) < 0 && text != "len"
        && text != "as_slice"
        && text != "capacity" && text != "allocator" && text != "clone" {
        set(&pcx.letw_at, id, pos);
    }
    if (text == "as_slice" || text == "as_mut_slice") && pcx.nodes[n].end > pcx.nodes[n].start
        && SRC[pcx.nodes[n].end - 1] == ']' {
        // (`b[..]`, `b[i]`: the checker's as_slice call in its place)
        note_write(id, BYTES, WHY_INDEX, pos, &pcx);
    }
    if text == "push_fmt" || text == "push_int" {
        note_write(id, TEXT, WHY_FMT, pos, &pcx);
    } else if text == "as_mut_slice" {
        note_write(id, BYTES, WHY_MUT_SLICE, pos, &pcx);
    } else if (text == "push" || text == "push_str") && pcx.nodes[n].kind == NodeKind::Call
        && pcx.nodes[n].count > 1 {
        let arg = child(n, 1, pcx);
        if text == "push_str" {
            if bytes_const(arg, pcx) {
                note_write(id, BYTES, WHY_BYTES_STR, pos, &pcx);
            }
            else if pcx.nodes[arg].kind == NodeKind::Str || is_str_type(pcx.nodes[arg].ty, pcx)
                || str_local(arg, pcx) {
                note_write(id, TEXT, WHY_STR, pos, &pcx);
            } else {
                note_write(id, BYTES, WHY_BYTES_STR, pos, &pcx);
            }
        } else if pcx.nodes[arg].kind == NodeKind::Int || pcx.nodes[arg].kind == NodeKind::Char {
            if pcx.nodes[arg].a < 0x80 {
                note_write(id, TEXT, WHY_ASCII, pos, &pcx);
            } else {
                note_write(id, BYTES, WHY_BYTE_HIGH, pos, &pcx);
            }
        } else {
            note_write(id, BYTES, WHY_BYTE_VAR, pos, &pcx);
        }
    }
}

// Constructor call n of Buf's function f (`Buf::from_in(s, a)`): its
// evidence.
fn note_ctor(n: i64, f: i64, pcx: inout Ctx<Comp>) {
    let id = binding(n, &pcx);
    let def = fn_node(template(f, pcx), pcx);
    if sym_is(pcx.nodes[def].a, "from_in", pcx) && pcx.nodes[n].count > 0 {
        let arg = child(n, 0, pcx);
        if !bytes_const(arg, pcx)
            && (pcx.nodes[arg].kind == NodeKind::Str || is_str_type(pcx.nodes[arg].ty, pcx)) {
            note_write(id, TEXT, WHY_FROM_STR, pcx.nodes[n].start, &pcx);
        } else {
            note_write(id, BYTES, WHY_FROM_BYTES, pcx.nodes[n].start, &pcx);
        }
    }
}

// Call n (not of Buf's): its Buf arguments flow to the parameters of a
// program's function; one passed to std's is kept a Buf.
fn note_args(n: i64, f: i64, pcx: inout Ctx<Comp>) {
    let def = fn_node(template(f, pcx), pcx);
    let user = def > 0 && user_pos(pcx.nodes[def].start, pcx);
    for i in 0..pcx.nodes[n].count {
        let arg = child(n, i, pcx);
        if pcx.nodes[arg].kind == NodeKind::NamedArg {
            continue;
        }
        if user && i < pcx.nodes[def].count && is_string_type(pcx.nodes[arg].ty, pcx) {
            // (a String given to a Buf parameter)
            let p = child(def, i, pcx);
            if buf_type_node(pcx.nodes[p].b, pcx) {
                let pid = decl_binding(p, &pcx);
                if pid >= 0 {
                    set(&pcx.type_node, pid, pcx.nodes[p].b);
                    anchor(pid, &pcx);
                }
                note_given(pid, arg, &pcx);
            }
            continue;
        }
        if !has_buf(pcx.nodes[arg].ty, pcx) {
            continue;
        }
        let id = binding(arg, &pcx);
        if id < 0 {
            continue;
        }
        anchor(id, &pcx);
        if user && i < pcx.nodes[def].count {
            let p = child(def, i, pcx);
            let pid = decl_binding(p, &pcx);
            if pid >= 0 && mentions_buf(pcx.nodes[p].b, pcx) {
                set(&pcx.type_node, pid, pcx.nodes[p].b);
                anchor(pid, &pcx);
            }
            join(id, pid, &pcx);
        }
        else if !is_buf_type(pcx.nodes[arg].ty, pcx) || !user && def > 0 && i < pcx.nodes[def].count
            && pcx.nodes[child(def, i, pcx)].kind == NodeKind::Param
            && !mentions_buf(pcx.nodes[child(def, i, pcx)].b, pcx)
            && !param_is_string(f, i, pcx) && !printer(f, pcx) {
            // (a holder given to std, or a Buf given to a std generic,
            // `names.push(b)`, `std::replace(&s.f, b)`: one with the
            // other arguments that hold one)
            for j in 0..pcx.nodes[n].count {
                let other = child(n, j, pcx);
                if j != i && pcx.nodes[other].kind != NodeKind::NamedArg
                    && has_buf(pcx.nodes[other].ty, pcx) {
                    join(id, binding(other, &pcx), &pcx);
                }
            }
        } else if !user && param_is_string(f, i, pcx) {
            note_write(id, TEXT, WHY_STD_STRING, pcx.nodes[arg].start, &pcx);
        } else if !user && printer(f, pcx) {
            note_write(id, TEXT, WHY_PRINTED, pcx.nodes[arg].start, &pcx);
        } else if !user && param_is_buf(f, i, pcx) && get(pcx.extern_at, id) < 0 {
            set(&pcx.extern_at, id, pcx.nodes[arg].start);
            set(&pcx.extern_fn, id, f);
        }
    }
}

// (From check_program, before std's `str` is erased, when RECORD is set)
// The bindings, their flows and writes.
pub fn collect(pcx: inout Ctx<Comp>) {
    load_decls(&pcx);
    load_local_decls(&pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if (pcx.nodes[n].p & NODE_IMPLICIT) != 0 || !user_pos(pcx.nodes[n].start, pcx) {
            continue;
        }
        if k == NodeKind::Let {
            let pat = pcx.nodes[n].a;
            let id = if pat > 0 { decl_binding(pat, &pcx) } else { -1 };
            if id >= 0 && mentions_buf(pcx.nodes[n].b, pcx) {
                set(&pcx.type_node, id, pcx.nodes[n].b);
                anchor(id, &pcx);
            }
            let init = pcx.nodes[n].c;
            if id >= 0 && init > 0 && has_buf(pcx.nodes[init].ty, pcx) {
                anchor(id, &pcx);
            }
            if id >= 0 && get(pcx.anchor, id) != 0 {
                flow(id, init, &pcx);
            }
            if pat > 0 && pcx.nodes[pat].kind != NodeKind::PatBind && init > 0 {
                // (`let Some(b) = e else { .. }`)
                bind_pattern(pat,
                    if has_buf(pcx.nodes[init].ty, pcx) { binding(init, &pcx) } else { -1 }, &pcx);
            }
        } else if k == NodeKind::Param {
            let id = decl_binding(n, &pcx);
            if id >= 0 && mentions_buf(pcx.nodes[n].b, pcx) {
                set(&pcx.type_node, id, pcx.nodes[n].b);
                anchor(id, &pcx);
                // (a by-value parameter: a Buf written through it writes
                // the caller's, a String or a Vec a copy)
                if pcx.nodes[pcx.nodes[n].b].kind != NodeKind::TyPtr
                    && (pcx.nodes[n].p & (CONV_INOUT | CONV_SINK)) == 0 {
                    set(&pcx.let_param, id, 1);
                }
            }
        } else if k == NodeKind::Field {
            field_binding(n, &pcx);
        } else if k == NodeKind::VariantLit {
            // (a program's variant's Buf fields: `Msg::Text(b)`)
            for i in 0..pcx.nodes[n].count {
                let fid = vfield_binding(pcx.nodes[n].a, i, &pcx);
                if fid >= 0 {
                    flow(fid, child(n, i, pcx), &pcx);
                }
            }
        } else if k == NodeKind::Match && pcx.nodes[n].a > 0 {
            let s = pcx.nodes[n].a;
            let sid = if has_buf(pcx.nodes[s].ty, pcx) { binding(s, &pcx) } else { -1 };
            for i in 0..pcx.nodes[n].count {
                bind_pattern(pcx.nodes[child(n, i, pcx)].a, sid, &pcx);
            }
        }
        else if k == NodeKind::Index && pcx.nodes[n].a > 0
            && is_buf_type(pcx.nodes[pcx.nodes[n].a].ty, pcx) {
            note_write(binding(pcx.nodes[n].a, &pcx), BYTES, WHY_INDEX, pcx.nodes[n].start, &pcx);
        } else if k == NodeKind::Fn && mentions_buf(pcx.nodes[n].b, pcx) {
            let id = id_of(pcx.nodes[n].start * 4 + K_RESULT, &pcx);
            set(&pcx.type_node, id, pcx.nodes[n].b);
            anchor(id, &pcx);
            pcx.result_fns.push(n);
            let body = pcx.nodes[n].c;
            if body > 0 && pcx.nodes[body].kind == NodeKind::Block && pcx.nodes[body].a != 0 {
                flow(id, pcx.nodes[body].a, &pcx);
            }
        }
        else if k == NodeKind::Assign && pcx.nodes[n].c > 0
            && has_buf(pcx.nodes[pcx.nodes[n].c].ty, pcx) {
            let target = binding(pcx.nodes[n].b, &pcx);
            if target >= 0 {
                flow(target, pcx.nodes[n].c, &pcx);
            }
        }
        else if k == NodeKind::Assign && pcx.nodes[n].c > 0
            && is_buf_type(pcx.nodes[pcx.nodes[n].b].ty, pcx) {
            note_given(binding(pcx.nodes[n].b, &pcx), pcx.nodes[n].c, &pcx);
        } else if k == NodeKind::StructLit {
            let s = struct_node(pcx.nodes[n].ty, pcx);
            for i in 0..pcx.nodes[n].count {
                let init = child(n, i, pcx);
                let v = pcx.nodes[init].b;
                if v > 0 && has_buf(pcx.nodes[v].ty, pcx) {
                    let fid = field_binding(field_of(s, pcx.nodes[init].x, pcx.nodes[init].a, pcx),
                        &pcx);
                    if fid >= 0 {
                        flow(fid, v, &pcx);
                    }
                } else if v > 0 {
                    note_given(field_binding(field_of(s, pcx.nodes[init].x, pcx.nodes[init].a, pcx),
                        &pcx),
                        v, &pcx);
                }
            }
        } else if k == NodeKind::Call && pcx.nodes[n].x > 0 {
            let f = pcx.nodes[n].x - 1;
            if is_string_push(f, pcx) && pcx.nodes[n].a == 0 && pcx.nodes[n].count > 1 {
                let arg = child(n, 1, pcx);
                let constant = pcx.nodes[arg].kind == NodeKind::Int
                    || pcx.nodes[arg].kind == NodeKind::Char;
                if !constant || pcx.nodes[arg].a >= 0x80 {
                    let id = binding(child(n, 0, pcx), &pcx);
                    pcx.string_bytes.push(n);
                    pcx.string_bytes.push(id);
                    note_write(id, BYTES, if constant { WHY_BYTE_HIGH } else { WHY_BYTE_VAR },
                        pcx.nodes[n].start, &pcx);
                }
            }
            if is_buf_fn(f, pcx) {
                if pcx.nodes[n].a != 0 {
                    note_ctor(n, f, &pcx);
                } else if pcx.nodes[n].count > 0 {
                    note_method(n, f, child(n, 0, pcx), &pcx);
                }
            } else {
                note_args(n, f, &pcx);
            }
        } else if k == NodeKind::Call && pcx.nodes[n].count > 0 && pcx.nodes[n].a > 0
            && pcx.nodes[pcx.nodes[n].a].kind == NodeKind::Ident
            && pcx.nodes[pcx.nodes[n].a].res != Res::Local
            && sym_is(pcx.nodes[pcx.nodes[n].a].a, "read_line", pcx)
            && is_buf_type(pcx.nodes[child(n, 0, pcx)].ty, pcx) {
            // (`read_line(&b)` of a Buf, which the checker could not
            // finish: std's read_line fills a String since 0.26.3)
            note_write(binding(child(n, 0, pcx), &pcx), TEXT, WHY_STD_STRING,
                pcx.nodes[child(n, 0, pcx)].start, &pcx);
        }
        else if k == NodeKind::Call && pcx.nodes[n].a > 0
            && pcx.nodes[pcx.nodes[n].a].kind == NodeKind::Ident
            && pcx.nodes[pcx.nodes[n].a].res == Res::Fn {
            // (a call the checker could not finish, `read_line(&b)` of a
            // Buf since 0.26.3: its function as the name resolved)
            note_args(n, pcx.nodes[pcx.nodes[n].a].y, &pcx);
        }
        else if k == NodeKind::InterpHole && pcx.nodes[n].a > 0
            && is_buf_type(pcx.nodes[pcx.nodes[n].a].ty, pcx) {
            // (a Buf printed, `{b}`: text)
            note_write(binding(pcx.nodes[n].a, &pcx), TEXT, WHY_PRINTED,
                pcx.nodes[pcx.nodes[n].a].start, &pcx);
        } else if k == NodeKind::MethodCall && pcx.nodes[n].a > 0
            && is_string_type(pcx.nodes[pcx.nodes[n].a].ty, pcx) {
            // (a String, format_in's since 0.26.3, given a method of
            // Buf's: renamed by the table)
            pcx.string_calls.push(n);
        } else if k == NodeKind::Interp && pcx.nodes[n].x > 0 && is_buf_fn(pcx.nodes[n].x - 1, pcx)
            && pcx.nodes[n].y > 0 && pcx.nodes[pcx.nodes[n].y].count > 0 {
            // (a `b.push_fmt("..")` the checker wrote in place: its
            // receiver is the block's first `let`'s, `__r`)
            // (`b.push_fmt("{}", x)`: its arguments' lets may come first)
            for i in 0..pcx.nodes[pcx.nodes[n].y].count {
                let s = child(pcx.nodes[n].y, i, pcx);
                if pcx.nodes[s].kind == NodeKind::Let && pcx.nodes[s].c > 0
                    && is_buf_type(pcx.nodes[pcx.nodes[s].c].ty, pcx) {
                    note_method(n, pcx.nodes[n].x - 1, pcx.nodes[s].c, &pcx);
                    break;
                }
            }
        }
    }
    // The `return`s of the functions whose result is a Buf.
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Return || pcx.nodes[n].a == 0
            || !user_pos(pcx.nodes[n].start, pcx) {
            continue;
        }
        var best = 0;
        for i in 0..pcx.result_fns.count {
            let f = get(pcx.result_fns, i);
            if pcx.nodes[f].start <= pcx.nodes[n].start && pcx.nodes[n].end <= pcx.nodes[f].end
                && (best == 0 || pcx.nodes[f].start > pcx.nodes[best].start) {
                best = f;
            }
        }
        if best != 0 {
            flow(id_of(pcx.nodes[best].start * 4 + K_RESULT, &pcx), pcx.nodes[n].a, &pcx);
        }
    }
}

// ---- The edits ----

fn put_place(out: i64, pos: i64, pcx: Ctx<Comp>) {
    buf_bytes(out, file_text(file_of_pos(pos, pcx), pcx));
    buf_byte(out, ':');
    buf_int(out, line_of(pos, pcx));
    buf_byte(out, ':');
    buf_int(out, pos - line_start(pos, pcx) + 1);
}

// Binding id's name, for a message: `b`, `S.f`, `f's result`, `Buf::new_in`.
fn put_binding(out: i64, id: i64, pcx: Ctx<Comp>) {
    let key = get(pcx.key, id);
    let kind = key & 3;
    let pos = key >> 2;
    buf_byte(out, '\'');
    if kind == K_LOCAL || kind == K_FIELD {
        var p = pos;
        // (a field's `pub`, `pub(crate)` before its name)
        if kind == K_FIELD && p + 3 < SRC.len as i64 && SRC[p..p + 3] == "pub"
            && !ident_byte(SRC[p + 3]) {
            p += 3;
            if SRC[p] == '(' {
                while p < SRC.len as i64 && SRC[p] != ')' {
                    p += 1;
                }
                p += 1;
            }
            while p < SRC.len as i64 && SRC[p] == ' ' {
                p += 1;
            }
        }
        var e = p;
        while e < SRC.len as i64 && (SRC[e] == '_' || SRC[e] >= 'a' && SRC[e] <= 'z'
            || SRC[e] >= 'A' && SRC[e] <= 'Z' || SRC[e] >= '0' && SRC[e] <= '9') {
            e += 1;
        }
        buf_bytes(out, SRC[p..e]);
    } else if kind == K_RESULT {
        buf_str(out, c"the result of ");
        // UNSAFE: SYMS is the symbol table, a raw pointer (base).
        // SAFETY: a function node's name is a symbol below the table's count.
        buf_bytes(out, unsafe { sym_text(pcx.nodes[fn_at(pos, pcx)].a, pcx) });
    } else {
        buf_str(out, c"a Buf constructor");
    }
    buf_str(out, c"' at ");
    put_place(out, pos, pcx);
}

// The Fn node starting at pos (a result binding's), or 0.
fn fn_at(pos: i64, pcx: Ctx<Comp>) -> i64 {
    for i in 0..pcx.result_fns.count {
        let f = get(pcx.result_fns, i);
        if pcx.nodes[f].start == pos {
            return f;
        }
    }
    0
}

// Whether SRC[i] can be in an identifier.
fn ident_byte(c: u8) -> bool {
    c == '_' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
}

// Type node t's `Buf` (each, through `*`) written as the side's type:
// `Buf` -> `String<Gpa>`, `Buf<A>` -> `String<A>` or `Vec<u8, A>`,
// `std::Buf` -> `std::string::String` or `std::Vec`. The number of edits.
fn rewrite_type(t: i64, side: i64, pcx: inout Ctx<Comp>) -> i64 {
    var edits = 0;
    var i = pcx.nodes[t].start;
    let end = pcx.nodes[t].end;
    while i + 3 <= end {
        if SRC[i] == 'B' && SRC[i + 1] == 'u' && SRC[i + 2] == 'f'
            && (i == 0 || !ident_byte(SRC[i - 1]))
            && (i + 3 >= SRC.len as i64 || !ident_byte(SRC[i + 3])) {
            var start = i;
            let std_path = i >= 5 && SRC[i - 5..i] == "std::";
            if std_path {
                start = i - 5;
            }
            var stop = i + 3;
            var args: [u8] = "Gpa";
            var j = stop;
            while j < end && SRC[j] == ' ' {
                j += 1;
            }
            if j < end && SRC[j] == '<' {
                var depth = 0;
                var k = j;
                while k < end {
                    if SRC[k] == '<' {
                        depth += 1;
                    } else if SRC[k] == '>' {
                        depth -= 1;
                        if depth == 0 {
                            break;
                        }
                    }
                    k += 1;
                }
                if k < end {
                    args = SRC[j + 1..k];
                    stop = k + 1;
                }
            }
            let text = buf_new();
            if side == TEXT {
                buf_str(text, if std_path { c"std::string::String<" } else { c"String<" });
            } else {
                buf_str(text, if std_path { c"std::Vec<u8, " } else { c"Vec<u8, " });
            }
            buf_bytes(text, args);
            buf_byte(text, '>');
            if ref_in(start, &pcx) && edit_replace(start, stop, text, &pcx) {
                edits += 1;
            }
            i = stop;
            continue;
        }
        i += 1;
    }
    edits
}

// Constructor call n's `Buf` (its path's) written as the side's type.
fn rewrite_ctor(n: i64, side: i64, pcx: inout Ctx<Comp>) -> i64 {
    if n <= 0 {
        return 0;
    }
    let callee = pcx.nodes[n].a;
    if callee <= 0 {
        return 0;
    }
    var i = pcx.nodes[callee].start;
    let end = pcx.nodes[callee].end;
    while i + 3 <= end {
        if SRC[i] == 'B' && SRC[i + 1] == 'u' && SRC[i + 2] == 'f'
            && (i == 0 || !ident_byte(SRC[i - 1])) && !ident_byte(SRC[i + 3]) {
            var start = i;
            let std_path = i >= 5 && SRC[i - 5..i] == "std::";
            if std_path {
                start = i - 5;
            }
            let text = buf_new();
            if side == TEXT {
                buf_str(text, if std_path { c"std::string::String" } else { c"String" });
            } else {
                // (0.26.3: `Vec::<u8, Gpa>`: the allocator, its last argument's type)
                buf_str(text, if std_path { c"std::Vec::<u8" } else { c"Vec::<u8" });
                let last = if pcx.nodes[n].count > 0 { child(n, pcx.nodes[n].count - 1, pcx) }
                    else { 0 };
                if last > 0 && pcx.nodes[last].ty > 0 {
                    buf_str(text, c", ");
                    buf_type(text, pcx.nodes[last].ty, pcx);
                }
                buf_byte(text, '>');
            }
            return if ref_in(start, &pcx) && edit_replace(start, i + 3, text, &pcx) { 1 }
                else { 0 };
        }
        i += 1;
    }
    0
}

// Call n's `name(ARGS)` at `at` (push_fmt, push_int on a binding decided
// bytes) written as a Vec<u8, A>'s `extend_from_slice(format_in(ARGS,
// R.allocator()).as_bytes())`, R its receiver as written: the same bytes.
// The number of edits.
fn fmt_into_bytes(n: i64, at: i64, name: [u8], pcx: inout Ctx<Comp>) -> i64 {
    let end = pcx.nodes[n].end;
    var dot = at - 1;
    while dot > pcx.nodes[n].start && SRC[dot] != '.' {
        dot -= 1;
    }
    var p = at + name.len as i64;
    while p < end && SRC[p] == ' ' {
        p += 1;
    }
    if dot <= pcx.nodes[n].start || p >= end || SRC[p] != '(' || SRC[end - 1] != ')' {
        return 0;
    }
    let text = buf_new();
    buf_str(text, c"extend_from_slice(format_in(");
    if name == "push_int" {
        buf_str(text, c"\"{}\", ");
    }
    buf_bytes(text, SRC[p + 1..end - 1]);
    buf_str(text, c", ");
    buf_bytes(text, SRC[pcx.nodes[n].start..dot]);
    buf_str(text, c".allocator()).as_bytes())");
    if ref_in(at, &pcx) && edit_replace(at, end, text, &pcx) { 1 } else { 0 }
}

// The method table, printed.
fn put_table(tcx: inout Tcx<Comp>) {
    let d = diag(c"note", c"fix.buf-table", &tcx);
    buf_str(d, c"Buf's methods, as String<A> (text) and Vec<u8, A> (bytes); '-': none, the binding is refused\n");
    for i in 0..TABLE_COUNT {
        buf_str(d, c"  ");
        buf_bytes(d, TABLE[i][0]);
        buf_str(d, c" -> ");
        buf_bytes(d, if TABLE[i][1].len as i64 > 0 { TABLE[i][1] } else { "-" });
        buf_str(d, c" | ");
        buf_bytes(d, if TABLE[i][2].len as i64 > 0 { TABLE[i][2] } else { "-" });
        buf_byte(d, '\n');
    }
}

// A refusal of the bindings of component r (its first anchored binding
// named), why.
fn refuse(first: i64, why: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    pcx.buf_refused += 1;
    let d = diag(c"note", c"fix.buf-refused", &tcx);
    put_binding(d, first, pcx);
    buf_str(d, c": ");
    buf_bytes(d, crate::base::buf_slice(why));
    buf_byte(d, '\n');
    0
}

// The edits of every binding decided; their number. Refused ones are
// listed (fix.buf-refused), with the table.
pub fn buf_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let count = pcx.key.count;
    // Per component root: its side (0: not seen; -1: refused).
    var side = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var edits = 0;
    var refused = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for id in 0..count {
        let r = root(id, pcx);
        if side.get(r + 1) != 0 {
            continue;
        }
        // The component's evidence, its anchors, its extern use.
        var anchored = -1;
        var text_id = -1;
        var bytes_id = -1;
        var extern_id = -1;
        var strong_id = -1;
        var letw_id = -1;
        for m in 0..count {
            if root(m, pcx) != r {
                continue;
            }
            if get(pcx.anchor, m) != 0 && anchored < 0 {
                anchored = m;
            }
            if get(pcx.text_at, m) >= 0 && text_id < 0 {
                text_id = m;
            }
            if get(pcx.strong_at, m) >= 0 && strong_id < 0 {
                strong_id = m;
            }
            if get(pcx.letw_at, m) >= 0 && letw_id < 0 {
                letw_id = m;
            }
            if get(pcx.bytes_at, m) >= 0 && bytes_id < 0 {
                bytes_id = m;
            }
            if get(pcx.extern_at, m) >= 0 && extern_id < 0 {
                extern_id = m;
            }
        }
        if anchored < 0 {
            side.put(r + 1, -1);
            continue;
        }
        let why = buf_new();
        var s = 0;
        if extern_id >= 0 {
            buf_str(why, c"passed to std's '");
            // UNSAFE: FNS and SYMS are the checker's tables, raw pointers.
            // SAFETY: EXTERN_FN holds a resolved call's function, below
            // FN_COUNT; its display name is a symbol.
            buf_bytes(why,
                unsafe { sym_text(pcx.fns[get(pcx.extern_fn, extern_id)].display, pcx) });
            buf_str(why, c"' at ");
            put_place(why, get(pcx.extern_at, extern_id), pcx);
            buf_str(why, c", which takes a Buf");
        } else if strong_id >= 0 && bytes_id >= 0 {
            buf_str(why, c"mixed: text (");
            buf_bytes(why, why_text(get(pcx.strong_why, strong_id)));
            buf_str(why, c" at ");
            put_place(why, get(pcx.strong_at, strong_id), pcx);
            buf_str(why, c") and bytes (");
            buf_bytes(why, why_text(get(pcx.bytes_why, bytes_id)));
            buf_str(why, c" at ");
            put_place(why, get(pcx.bytes_at, bytes_id), pcx);
            buf_str(why, c")");
        } else if letw_id >= 0 {
            if letw_id != anchored {
                put_binding(why, letw_id, pcx);
                buf_str(why, c", ");
            }
            buf_str(why, c"a by-value parameter, written at ");
            put_place(why, get(pcx.letw_at, letw_id), pcx);
            buf_str(why,
                c" (a Buf there is the caller's, a String or a Vec a copy): make it `inout` first (refactor signature)");
        } else {
            // (bytes win over the weak text writes; no write at all: a
            // Vec<u8, A>, the bytes the Buf held)
            s = if text_id >= 0 && bytes_id < 0 { TEXT } else { BYTES };
            // (a constructor with no form on that side: Buf::from_in as bytes)
            for m in 0..count {
                let c = pcx.ctor_of.get(m + 1) - 1;
                if s == BYTES && c > 0 && root(m, pcx) == r && pcx.nodes[c].x > 0
                    && sym_is(pcx.nodes[fn_node(template(pcx.nodes[c].x - 1, pcx), pcx)].a,
                        "from_in", pcx) {
                    buf_str(why, c"bytes, but its Buf::from_in at ");
                    put_place(why, pcx.nodes[c].start, pcx);
                    buf_str(why, c" has no Vec<u8, A> form");
                    s = 0;
                    break;
                }
            }
            // (a method with no form on that side)
            var k = 0;
            while s != 0 && k < pcx.buf_calls.count {
                if root(get(pcx.buf_calls, k + 1), pcx) == r {
                    // UNSAFE: SYMS is the symbol table, a raw pointer (base).
                    // SAFETY: CALLS holds methods' names, symbols.
                    let name = unsafe { sym_text(get(pcx.buf_calls, k + 2), pcx) };
                    let row = row_of(name);
                    if row < 0 || TABLE[row][s].len as i64 == 0 {
                        buf_str(why, if s == TEXT { c"text" } else { c"bytes" });
                        buf_str(why, c", but its '");
                        buf_bytes(why, name);
                        buf_str(why, c"' at ");
                        put_place(why, pcx.nodes[get(pcx.buf_calls, k)].start, pcx);
                        buf_str(why, if s == TEXT { c" has no String<A> form" }
                            else { c" has no Vec<u8, A> form" });
                        s = 0;
                        break;
                    }
                }
                k += 4;
            }
        }
        if s == 0 {
            side.put(r + 1, -1);
            refused.put(r + 1, 1);
            refuse(anchored, why, &tcx, &pcx);
            continue;
        }
        side.put(r + 1, s);
    }
    // The rewrites of the decided components.
    for id in 0..count {
        let s = side.get(root(id, pcx) + 1);
        if s <= 0 {
            continue;
        }
        let t = get(pcx.type_node, id);
        if t > 0 {
            edits += rewrite_type(t, s, &pcx);
        }
        if (get(pcx.key, id) & 3) == K_CTOR {
            edits += rewrite_ctor(pcx.ctor_of.get(id + 1) - 1, s, &pcx);
        }
    }
    var k = 0;
    while k < pcx.buf_calls.count {
        let s = side.get(root(get(pcx.buf_calls, k + 1), pcx) + 1);
        let at = get(pcx.buf_calls, k + 3);
        if s > 0 && at >= 0 {
            // UNSAFE: SYMS is the symbol table, a raw pointer (base).
            // SAFETY: CALLS holds methods' names, symbols.
            let name = unsafe { sym_text(get(pcx.buf_calls, k + 2), pcx) };
            let row = row_of(name);
            if s == BYTES && (name == "push_fmt" || name == "push_int")
                && SRC[at..at + name.len as i64] == name {
                edits += fmt_into_bytes(get(pcx.buf_calls, k), at, name, &pcx);
            } else if row >= 0 && TABLE[row][s] != name && SRC[at..at + name.len as i64] == name {
                let text = buf_new();
                buf_bytes(text, TABLE[row][s]);
                if ref_in(at, &pcx) && edit_replace(at, at + name.len as i64, text, &pcx) {
                    edits += 1;
                }
            }
        }
        k += 4;
    }
    // (a String's calls of Buf's methods, by the text side of the table)
    for i in 0..pcx.string_calls.count {
        let n = get(pcx.string_calls, i);
        // UNSAFE: SYMS is the symbol table, a raw pointer (base).
        // SAFETY: a MethodCall's b is the method's name, a symbol.
        let name = unsafe { sym_text(pcx.nodes[n].b, pcx) };
        let row = row_of(name);
        let at = name_after_dot(pcx.nodes[pcx.nodes[n].a].end, pcx.nodes[n].end);
        if row >= 0 && at >= 0 && TABLE[row][TEXT].len as i64 > 0 && TABLE[row][TEXT] != name
            && SRC[at..at + name.len as i64] == name {
            let text = buf_new();
            buf_bytes(text, TABLE[row][TEXT]);
            if ref_in(at, &pcx) && edit_replace(at, at + name.len as i64, text, &pcx) {
                edits += 1;
            }
        }
    }
    // (a String given bytes: refused, with the form that keeps them)
    var j = 0;
    while j + 1 < pcx.string_bytes.count {
        let n = get(pcx.string_bytes, j);
        let id = get(pcx.string_bytes, j + 1);
        j += 2;
        if !ref_in(pcx.nodes[n].start, &pcx) || id >= 0 && refused.get(root(id, pcx) + 1) != 0 {
            continue;
        }
        if id >= 0 {
            // (once a binding)
            refused.put(root(id, pcx) + 1, 1);
        }
        pcx.buf_refused += 1;
        let d = diag(c"note", c"fix.buf-refused", &tcx);
        if id >= 0 {
            put_binding(d, id, pcx);
        } else {
            buf_str(d, c"a String");
        }
        buf_str(d, c": a String given a byte (a push at ");
        put_place(d, pcx.nodes[n].start, pcx);
        buf_str(d,
            c", a code point since 0.20): for bytes, `format_in(..).into_bytes()`, a Vec<u8, A>\n");
    }
    if edits > 0 || pcx.buf_refused > 0 {
        put_table(&tcx);
    }
    edits
}
