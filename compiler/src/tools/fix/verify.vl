// (0.25.2.1) `fix --suggested` makes only the fixes that are safe. The
// 0.25.2 GPU eval: in 4 runs of 10 a fix the hook applied was wrong (a
// float's `x.abs()` became `std::abs(x as i64)`, which truncates, and the
// program's own checks then passed falsely; a cast chain became a double
// cast; a `use` of std's internals for a local not yet written; an import
// a second time). So:
//
// - before the edit (refusal_of), a conversion is made only when it keeps
//   the value: never float to int, f64 to f32, to a narrower or other-
//   signed int, nor of an expression that is a cast already (the cast, or
//   the type of the place it goes to, is what to change);
// - after it (verify_fixes), the edited program is checked: a fix whose
//   own lines have an error the program had not, or whose error's place
//   has a new one (the fix changed what is there to another type, an
//   import brought something else than the name meant), is taken out and
//   the rest checked again; each fix taken out is a `note fix.refused`
//   with the error it made. A round of fix on the edited program checks
//   its own fixes so too, so a later round never builds on a wrong fix.
//
// The imports a fix adds are not made twice (fix/mod.vl's
// missing_use_edits): not for a name a `use` of the module imports
// already, nor for one a fix of a `use` line spells.

use crate::base::{
    get_bufs, IntVec, get_src, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NODE_IMPLICIT, NodeKind};
use crate::front::modules::{file_of_pos, within_std};
use crate::front::types::{buf_type, fn_param, is_numeric};
use crate::tools::ctx::Tcx;
use crate::tools::edit::{drop_replaces, replace_at, replace_count};
use crate::tools::edit::apply::{check_edited, prepare_edit, undo_copies, write_round_copies};
use crate::tools::edit::breaks::{changed_index, hunks};
use crate::tools::edit::diff::file_by_path;
use crate::tools::proc::same_bytes;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::{line_of, line_start};
use crate::tools::query::refs::file_text;

// The fix just added as replacement `edit` (edit_replace) is `n` fixes of
// kind `cat` (fix's counts), for the error at `pos`.
pub fn note_fix(edit: i64, cat: i64, n: i64, pos: i64, tcx: &mut Tcx<Comp>) {
    tcx.fix_edits.push(edit);
    tcx.fix_edits.push(cat);
    tcx.fix_edits.push(n);
    tcx.fix_edits.push(pos);
}

// The index of the last replacement made (after an edit_replace that
// returned true).
pub fn last_replace(pcx: &Ctx<Comp>) -> i64 {
    replace_count(pcx) - 1
}

// ---- Before: conversions that keep the value ----

// Whether a did-you-mean replacing the called name SRC[start..end) by t
// names the innermost function holding it (`readback(x)` respelled
// `read_back(x)` inside `fn read_back`): it type-checks and recurses.
fn renames_to_self(start: i64, end: i64, t: &[u8], pcx: &Ctx<Comp>) -> bool {
    if t.len() == 0 || end <= start {
        return false;
    }
    for i in 0..t.len() {
        let c = t[i];
        if !(c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')
            || (c >= b'0' && c <= b'9')) {
            return false;
        }
    }
    let mut q = end;
    let fe = pcx.files[file_of_pos(start, pcx) as usize].end;
    while q < fe && (get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t') {
        q += 1;
    }
    if q >= fe || get_src()[q as usize] != b'(' {
        return false;
    }
    let mut best: i64 = 0;
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Fn && pcx.nodes[n as usize].start <= start
            && start < pcx.nodes[n as usize].end
            && (best == 0 || pcx.nodes[n as usize].start >= pcx.nodes[best as usize].start) {
            best = n;
        }
    }
    if best == 0 {
        return false;
    }
    // (its name: the word after `fn `)
    let mut p = pcx.nodes[best as usize].start;
    while p + 3 < start && !(get_src()[p as usize] == b'f' && get_src()[(p + 1) as usize] == b'n' && get_src()[(p + 2) as usize] == b' ') {
        p += 1;
    }
    p += 3;
    while get_src()[p as usize] == b' ' {
        p += 1;
    }
    let s = p;
    while p < start && get_src()[p as usize] != b'(' && get_src()[p as usize] != b'<' && get_src()[p as usize] != b' ' {
        p += 1;
    }
    same_bytes(&get_src()[s as usize..p as usize], t)
}

// (0.25.2.1) Why a method call respelled as std's function (SRC[start..
// end), `x.abs()`, by text t, `std::abs(x)`) changes the value's type, or
// "": the function takes a number of another type than the receiver's,
// which converts to it (ocean's `(a - b).abs()` of i32s: an i64 after it).
fn type_change<'a>(start: i64, end: i64, t: &'a [u8], pcx: &'a Ctx<Comp>) -> &'a [u8] {
    let mut p: i64 = if t.len() > 5 && same_bytes(&t[0..5], b"std::") { 5 } else { 0 };
    let s = p;
    while p < t.len() as i64 && t[p as usize] != b'(' {
        p += 1;
    }
    if p >= t.len() as i64 || p == s {
        return b"";
    }
    let name = &t[s as usize..p as usize];
    // UNSAFE: NODES (front/ast), FNS and SYMS (front/types, base) are the
    // compiler's raw tables.
    // SAFETY: i < NODE_COUNT, f < FN_COUNT; recv is a node of the call
    // found (its receiver); display is an interned symbol.
    unsafe {
        let mut rt: i64 = 0;
        for i in 1..pcx.nodes.len() {
            if pcx.nodes[i].kind == NodeKind::MethodCall && pcx.nodes[i].start == start
                && pcx.nodes[i].end == end
                && pcx.nodes[i].a > 0 {
                rt = pcx.nodes[pcx.nodes[i].a as usize].ty;
            }
        }
        if rt <= 0 || !is_numeric(rt) {
            return b"";
        }
        for f in 0..pcx.fns.len() as i64 {
            if pcx.fns[f as usize].tmpl != 0 || pcx.fns[f as usize].self_ty != 0 || pcx.fns[f as usize].param_count < 1
                || !within_std(pcx.fns[f as usize].module, pcx) {
                continue;
            }
            let d = sym_text(pcx.fns[f as usize].display, pcx);
            let named = same_bytes(d, name)
                || (d.len() as i64 > name.len() as i64 + 2
                    && same_bytes(&d[(d.len() as i64 - name.len() as i64) as usize..], name)
                    && d[(d.len() as i64 - name.len() as i64 - 1) as usize] == b':');
            let pt = fn_param(f, 0, pcx);
            if named && is_numeric(pt) && pt != rt {
                let b = buf_new();
                buf_str(b, c"std's `");
                buf_bytes(b, name);
                buf_str(b, c"` takes ");
                buf_type(b, pt, pcx);
                buf_str(b, c" and the value is ");
                buf_type(b, rt, pcx);
                buf_str(b, c": what it gives has another type");
                return buf_slice(b);
            }
        }
        b""
    }
}

// Why the fix replacing SRC[start..end) by buffer `text` is not to be made,
// or "" when nothing is against it: a conversion (`X as T`, `(X) as T` of
// the text X there) that loses the value, or of a cast; a did-you-mean
// that makes a call call the function it is in; std's function for a
// method that takes another type than the value's (type_change).
pub fn refusal_of(start: i64, end: i64, text: i64, pcx: &Ctx<Comp>) -> &[u8] {
    let t = buf_slice(text);
    let x = &get_src()[start as usize..end as usize];
    if renames_to_self(start, end, t, pcx) {
        return b"the name it puts there is the function the call is in: the call would call itself";
    }
    let changed = type_change(start, end, t, pcx);
    if changed.len() > 0 {
        return changed;
    }
    let mut k: i64 = -1;
    if t.len() as i64 > x.len() as i64 + 4 && same_bytes(&t[0..x.len()], x)
        && same_bytes(&t[x.len() as i64 as usize..(x.len() as i64 + 4) as usize], b" as ") {
        k = x.len() as i64 + 4;
    }
    else if t.len() as i64 > x.len() as i64 + 6 && t[0] == b'(' && same_bytes(&t[1..(x.len() as i64 + 1) as usize], x)
        && same_bytes(&t[(x.len() as i64 + 1) as usize..(x.len() as i64 + 6) as usize], b") as ") {
        k = x.len() as i64 + 6;
    }
    if k < 0 {
        // (fix --only usize) a conversion at the length or index, not a
        // type for the variable it came from: that changes its other uses
        if pcx.usize_lengths {
            return b"fix --only usize writes conversions only: `x as usize`, `x as i64`";
        }
        return b"";
    }
    let to = &t[k as usize..];
    let mut n: i64 = 0;
    let mut cast = false;
    for i in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[i as usize].start != start || pcx.nodes[i as usize].end != end {
            continue;
        }
        if pcx.nodes[i as usize].kind == NodeKind::Cast && (pcx.nodes[i as usize].p & NODE_IMPLICIT) == 0 {
            cast = true;
        }
        if n == 0 && (pcx.nodes[i as usize].p & NODE_IMPLICIT) == 0 && pcx.nodes[i as usize].ty > 0 {
            n = i;
        }
    }
    if cast {
        return b"it converts what a cast gives: the cast's type, or the type of the place it goes to, is what to change";
    }
    if n == 0 {
        return b"";
    }
    let b = buf_new();
    buf_type(b, pcx.nodes[n as usize].ty, pcx);
    let from = buf_slice(b);
    lossy(from, to, pcx)
}

// Whether error line `line` is such a cascade (ALLOC_ROUNDS).
pub fn alloc_cascade(line: &[u8], tcx: &Tcx<Comp>) -> bool {
    let t = "error[alloc.";
    if !tcx.alloc_rounds {
        return false;
    }
    let mut i: i64 = 0;
    while i + t.len() as i64 <= line.len() as i64 {
        if &line[i as usize..(i + t.len() as i64) as usize] == t.as_bytes() {
            return true;
        }
        i += 1;
    }
    false
}

// Why converting a `from` to a `to` (type names) loses the value, or "".
fn lossy(from: &[u8], to: &[u8], pcx: &Ctx<Comp>) -> &'static [u8] {
    let fb = float_bits(from);
    let tb = float_bits(to);
    let fi = int_bits(from);
    let ti = int_bits(to);
    if fb > 0 && ti > 0 {
        return b"a float to an integer drops the fraction and wraps out of range";
    }
    if fb == 64 && tb == 32 {
        return b"f64 to f32 rounds";
    }
    // (fix --only usize) lengths and indices, to and from usize: the value
    // is kept below 2^63; no other conversion (a test of one stays)
    if pcx.usize_lengths && !same_bytes(from, b"usize") && !same_bytes(to, b"usize") {
        return b"fix --only usize converts to and from usize only";
    }
    if pcx.usize_lengths && fi == 64 && ti == 64 {
        return b"";
    }
    if fi > 0 && ti > 0 {
        let fs = from[0] == b'i';
        let ts = to[0] == b'i';
        if (fs == ts && ti < fi) || (fs && !ts) || (!fs && ts && ti <= fi) {
            return b"the integer type it goes to does not hold every value: it wraps";
        }
    }
    if fi > 16 && tb == 32 {
        return b"an integer this wide to f32 rounds past 2^24";
    }
    b""
}

fn float_bits(t: &[u8]) -> i64 {
    if t == b"f32" { 32 } else if t == b"f64" { 64 } else { 0 }
}

fn int_bits(t: &[u8]) -> i64 {
    if t == b"i8" || t == b"u8" {
        8
    } else if t == b"i16" || t == b"u16" {
        16
    } else if t == b"i32" || t == b"u32" {
        32
    } else if t == b"i64" || t == b"u64" || t == b"isize" || t == b"usize" {
        64
    } else {
        0
    }
}

// `note fix.refused: PLACE: not applied: `TEXT`: WHY`, PLACE the fix's
// error (else where it is).
pub fn note_refused(pos: i64, text: &[u8], why: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let d = diag(c"note", c"fix.refused", tcx);
    put_place(d, pos, pcx);
    buf_str(d, c": not applied: `");
    put_trimmed(d, text);
    buf_str(d, c"`: ");
    buf_bytes(d, why);
    buf_byte(d, b'\n');
}

fn put_place(out: i64, pos: i64, pcx: &Ctx<Comp>) {
    buf_bytes(out, file_text(file_of_pos(pos, pcx), pcx));
    buf_byte(out, b':');
    buf_int(out, line_of(pos, pcx));
    buf_byte(out, b':');
    buf_int(out, pos - line_start(pos, pcx) + 1);
}

// Text without its leading and trailing blank lines and spaces, its other
// newlines as ` `.
fn put_trimmed(out: i64, t: &[u8]) {
    let mut a: i64 = 0;
    let mut b = t.len() as i64;
    while a < b && (t[a as usize] == b' ' || t[a as usize] == b'\n' || t[a as usize] == b'\t') {
        a += 1;
    }
    while b > a && (t[(b - 1) as usize] == b' ' || t[(b - 1) as usize] == b'\n' || t[(b - 1) as usize] == b'\t') {
        b -= 1;
    }
    for i in a..b {
        buf_byte(out, if t[i as usize] == b'\n' { b' ' } else { t[i as usize] });
    }
}

// ---- After: the edited program checked ----

// Checks the edited program (its copies written: prepare_edit, or
// write_round_copies in a round) and takes out each fix it finds wrong
// (see the head), writing the copies again; at most 4 times. counts:
// fix's, less the fixes taken out. Whether a replacement is left.
pub fn verify_fixes(root: *mut u8, counts: &mut [i64; 11], round: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    // UNSAFE: FIX_EDITS and LINES are static vars (this module's, positions'); replace_at reads the edit's.
    // SAFETY: the indices are below their vectors' counts; the line table is made from SRC before any use.
    unsafe {
        // (the line table: a program the lexer stopped in has none yet)
        if pcx.lines.count == 0 {
            crate::tools::query::positions::init_positions(tcx, pcx);
        }
        for _ in 0..4 {
            let mut added = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            if !check_edited(root, &mut added, tcx, pcx) || added.count == 0 {
                return true;
            }
            let mut bad = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut why = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for i in 0..added.count {
                let line = buf_slice((*added.data.add(i as usize)));
                let mut l: i64 = 0;
                let mut c: i64 = 0;
                let f = place_in(line, &mut l, &mut c, tcx, pcx);
                // (fix --only usize) a cascade: the next run converts it
                if f >= 0 && !(pcx.usize_lengths && crate::tools::edit::apply::usize_mismatch(line))
                    && !alloc_cascade(line, tcx) {
                    blame(f, l, c, (*added.data.add(i as usize)), &mut bad, &mut why, tcx, pcx);
                }
            }
            if bad.count == 0 {
                return true;
            }
            sort_pairs(&mut bad, &mut why);
            for k in 0..bad.count {
                let e = (*bad.data.add(k as usize));
                let (s, _, text) = replace_at(e, pcx);
                let mut pos = s;
                let mut j: i64 = 0;
                while j < tcx.fix_edits.count {
                    if (*tcx.fix_edits.data.add(j as usize)) == e {
                        if (*tcx.fix_edits.data.add((j + 3) as usize)) >= 0 && pos == s {
                            pos = (*tcx.fix_edits.data.add((j + 3) as usize));
                        }
                        counts[(*tcx.fix_edits.data.add((j + 1) as usize)) as usize] -= (*tcx.fix_edits.data.add((j + 2) as usize));
                    }
                    j += 4;
                }
                let w = buf_new();
                buf_str(w, c"the edited program has a new error with it: ");
                // (the error's place, code and message: not its help)
                let y = buf_slice((*why.data.add(k as usize)));
                let mut cut: i64 = 0;
                while cut < y.len() as i64
                    && !(cut + 3 <= y.len() as i64 && same_bytes(&y[cut as usize..(cut + 3) as usize], b" | ")) {
                    cut += 1;
                }
                buf_bytes(w, &y[0..cut as usize]);
                note_refused(pos, buf_slice(text), buf_slice(w), tcx, pcx);
            }
            renumber(bad, tcx);
            undo_copies(tcx, pcx);
            drop_replaces(bad, tcx, pcx);
            if replace_count(pcx) == 0 {
                return false;
            }
            if round {
                if !write_round_copies(tcx, pcx) {
                    return false;
                }
            } else if prepare_edit(tcx, pcx) >= 0 {
                return false;
            }
        }
        true
    }
}

// The file, line and column of a short diagnostic line (`PATH:L:C: error[`).
fn place_in(line: &[u8], l: &mut i64, c: &mut i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut at: i64 = -1;
    let mut i: i64 = 0;
    while i + 8 <= line.len() as i64 {
        if line[i as usize] == b':' && line[(i + 1) as usize] == b' ' && same_bytes(&line[(i + 2) as usize..(i + 8) as usize], b"error[") {
            at = i;
            break;
        }
        i += 1;
    }
    if at < 0 {
        return -1;
    }
    // PATH:L:C: the two numbers before `at`
    let mut c2 = at - 1;
    while c2 > 0 && line[c2 as usize] != b':' {
        c2 -= 1;
    }
    let mut c1 = c2 - 1;
    while c1 > 0 && line[c1 as usize] != b':' {
        c1 -= 1;
    }
    if c1 <= 0 {
        return -1;
    }
    *l = digits(&line[(c1 + 1) as usize..c2 as usize]);
    *c = digits(&line[(c2 + 1) as usize..at as usize]);
    if *l <= 0 || *c <= 0 {
        return -1;
    }
    file_by_path(&line[0..c1 as usize], tcx, pcx)
}

fn digits(s: &[u8]) -> i64 {
    let mut n: i64 = 0;
    for i in 0..s.len() {
        if s[i] < b'0' || s[i] > b'9' {
            return -1;
        }
        n = n * 10 + (s[i] - b'0') as i64;
    }
    n
}

// The replacements to blame for a new error at line l, column c of file f
// (the edited text's) into bad (once each), the error's line in why: one
// whose text holds that place (its own code has the error; a text of
// several lines, or one the formatter laid out again: any line of its
// hunk), and a fix whose error was at that place before (what it put
// there, or what its import brought, is not what the place takes).
// Another new error on a line a fix wrote (a second error of the line
// the checker reaches now) blames nothing: a later round fixes it.
fn blame(f: i64, l: i64, c: i64, line: i64, bad: &mut IntVec, why: &mut IntVec,
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    // UNSAFE: BUFS (the buffers) and FIX_EDITS are static vars, IntVec data raw pointers.
    // SAFETY: e < replace_count(); FIX_EDITS is read in fours below its count; h's hunks in fours below h.count.
    unsafe {
        let ci = changed_index(f, tcx);
        let mut h = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if ci >= 0 {
            hunks(ci, &mut h, tcx, pcx);
        }
        for e in 0..replace_count(pcx) {
            let (s, en, text) = replace_at(e, pcx);
            if file_of_pos(s, pcx) != f {
                continue;
            }
            let mut hit = false;
            let t = buf_slice(text);
            let mut nl = false;
            for i in 0..t.len() {
                if t[i] == b'\n' {
                    nl = true;
                }
            }
            let mut c0: i64 = 0;
            let l0 = new_place(h, f, s, e, &mut c0, pcx);
            if !nl && l0 > 0 {
                hit = l == l0 && c >= c0 && (c < c0 + t.len() as i64 || c == c0);
            } else {
                // (the hunk holding the replacement's old lines)
                let l1 = line_of(s, pcx);
                let l2 = if en > s { line_of(en - 1, pcx) } else { l1 };
                let mut k: i64 = 0;
                while k < h.count {
                    let a = (*h.data.add(k as usize));
                    let b = (*h.data.add((k + 1) as usize));
                    let hc = (*h.data.add((k + 2) as usize));
                    let hd = (*h.data.add((k + 3) as usize));
                    let holds = if b > 0 { l1 <= a + b - 1 && l2 >= a }
                        else { l1 == a || l1 == a + 1 };
                    if holds && l >= hc && l < hc + hd {
                        hit = true;
                    }
                    k += 4;
                }
            }
            let mut j: i64 = 0;
            while !hit && j < tcx.fix_edits.count {
                let p = (*tcx.fix_edits.data.add((j + 3) as usize));
                if (*tcx.fix_edits.data.add(j as usize)) == e && p >= 0 && file_of_pos(p, pcx) == f {
                    let mut pc: i64 = 0;
                    let pl = new_place(h, f, p, -1, &mut pc, pcx);
                    hit = pl > 0 && pl == l && pc == c;
                }
                j += 4;
            }
            if hit {
                let mut seen = false;
                for x in 0..bad.count {
                    if (*bad.data.add(x as usize)) == e {
                        seen = true;
                    }
                }
                if !seen {
                    bad.push(e);
                    why.push(line);
                }
            }
        }
    }
}

// Where position pos of file f (hunks h of its diff) is in the edited
// text: its line (0 when the formatter laid its lines out again: a hunk
// whose old and new lines differ in number), its column in *col, moved by
// the replacements before it on its line (not `self`, the replacement
// that starts there).
fn new_place(h: IntVec, f: i64, pos: i64, self_: i64, col: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: BUFS is a static var (the buffers); h's data a raw pointer.
    // SAFETY: k + 3 < h.count (hunks in fours); e < replace_count(), text a buffer replace_at gave.
    unsafe {
        let l = line_of(pos, pcx);
        let mut nl: i64 = -1;
        let mut delta: i64 = 0;
        let mut k: i64 = 0;
        while k < h.count {
            let a = (*h.data.add(k as usize));
            let b = (*h.data.add((k + 1) as usize));
            let hc = (*h.data.add((k + 2) as usize));
            let hd = (*h.data.add((k + 3) as usize));
            if b > 0 && l >= a && l < a + b {
                if b != hd {
                    return 0;
                }
                nl = hc + (l - a);
                break;
            }
            if (b > 0 && l < a) || (b == 0 && l <= a) {
                break;
            }
            delta += hd - b;
            k += 4;
        }
        if nl < 0 {
            nl = l + delta;
        }
        let mut c = pos - line_start(pos, pcx) + 1;
        for e in 0..replace_count(pcx) {
            if e == self_ {
                continue;
            }
            let (s, en, text) = replace_at(e, pcx);
            if file_of_pos(s, pcx) != f || line_of(s, pcx) != l || s > pos || (s == pos && en > s)
                || en > pos {
                continue;
            }
            c += (*get_bufs().add(text as usize)).len - (en - s);
        }
        *col = c;
        nl
    }
}

// bad in increasing order, why along with it.
fn sort_pairs(bad: &mut IntVec, why: &mut IntVec) {
    // UNSAFE: bad and why are IntVecs, their data raw pointers.
    // SAFETY: i, j < bad.count == why.count (blame pushes them together).
    unsafe {
        for i in 1..bad.count {
            let mut j = i;
            while j > 0 && (*bad.data.add(j as usize)) < (*bad.data.add((j - 1) as usize)) {
                let t = (*bad.data.add(j as usize));
                (*bad.data.add(j as usize)) = (*bad.data.add((j - 1) as usize));
                (*bad.data.add((j - 1) as usize)) = t;
                let w = (*why.data.add(j as usize));
                (*why.data.add(j as usize)) = (*why.data.add((j - 1) as usize));
                (*why.data.add((j - 1) as usize)) = w;
                j -= 1;
            }
        }
    }
}

// FIX_EDITS after the replacements `gone` (sorted) are taken out: theirs
// dropped, the others' indices moved down.
fn renumber(gone: IntVec, tcx: &mut Tcx<Comp>) {
    // UNSAFE: FIX_EDITS is a static var, its data a raw pointer.
    // SAFETY: j < FIX_EDITS.count; gone is read below its count.
    unsafe {
        let mut k: i64 = 0;
        let mut j: i64 = 0;
        while j < tcx.fix_edits.count {
            let e = (*tcx.fix_edits.data.add(j as usize));
            let mut out = false;
            let mut below: i64 = 0;
            for g in 0..gone.count {
                if (*gone.data.add(g as usize)) == e {
                    out = true;
                }
                if (*gone.data.add(g as usize)) < e {
                    below += 1;
                }
            }
            if !out {
                (*tcx.fix_edits.data.add(k as usize)) = e - below;
                (*tcx.fix_edits.data.add((k + 1) as usize)) = (*tcx.fix_edits.data.add((j + 1) as usize));
                (*tcx.fix_edits.data.add((k + 2) as usize)) = (*tcx.fix_edits.data.add((j + 2) as usize));
                (*tcx.fix_edits.data.add((k + 3) as usize)) = (*tcx.fix_edits.data.add((j + 3) as usize));
                k += 4;
            }
            j += 4;
        }
        tcx.fix_edits.count = k;
    }
}
