// (0.25.4) `volec fix --only unneeded-unsafe`: the unsafe blocks with nothing
// unsafe inside (`volec query unsafe`'s `none (unneeded)`) taken away, the
// code in them kept, so that the program means what it meant:
//
//   - a block on lines of its own (`unsafe {`, its lines, `}`) becomes its
//     lines, one level less indented;
//   - a block on one line becomes its code: `unsafe { f(x); }` is `f(x);`,
//     `let c = unsafe { V.get(k) };` is `let c = V.get(k);`; an expression
//     whose operators could bind otherwise where it stands gets parentheses.
//
// The code keeps its scope: a block is opened only when it is the last
// statement of the block around it, or declares nothing (`let`, `var`,
// `inout`, `defer`) at its own level. Left as they are, and counted
// (UNNEEDED_LEFT): those that declare and are not last; a block holding a
// string or comment written over several lines (a new indentation would
// change it); a block spread over lines in another shape (`let x = unsafe
// {`); a block whose comments above say `UNSAFE:` or `SAFETY:` (0.25.5:
// unless asked, `--only unneeded-justified`); a block of a generated file
// (`// Generated by ...`: its script writes it); and a block inside one
// taken away in the same run (the next run takes it).
//
// (0.25.5) `--only unneeded-justified` also takes the justified ones away,
// with their comments: the `//` lines right above the block's line, from the
// first that says `UNSAFE:` or `SAFETY:` down (they say why a block that is
// no longer needed was). Left: one whose line holds another `unsafe` (the
// comments may be its too), and one whose comments are not right above its
// line (`let x =` on the line before).

use crate::base::{buf_byte, buf_bytes, buf_new};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::fmt::generated;
use crate::tools::query::refs::ref_in;
use crate::tools::query::unsafe_audit::{
    comment_end, site_file_start, site_text, string_end, unneeded_blocks,
};

// What code holds at its own level (outside the brackets in it), scan's bits:
// a `let`, `var`, `inout` or `defer`
const S_DECL: i64 = 1;
// a `;`
const S_SEMI: i64 = 2;
// a blank or an operator: more than one path, call, index or field
const S_OPS: i64 = 4;
// (anywhere) a string or a comment over several lines
const S_LINES: i64 = 8;
// brackets that do not match
const S_BAD: i64 = 16;

fn is_blank_byte(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n'
}

fn is_word(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

fn line_start(t: &[u8], p: i64) -> i64 {
    let mut i = p;
    while i > 0 && t[(i - 1) as usize] != b'\n' {
        i -= 1;
    }
    i
}

fn line_end(t: &[u8], p: i64) -> i64 {
    let mut i = p;
    while i < t.len() as i64 && t[i as usize] != b'\n' {
        i += 1;
    }
    i
}

// Whether t[from..to) is blanks only.
fn blank(t: &[u8], from: i64, to: i64) -> bool {
    for i in from..to {
        if !is_blank_byte(t[i as usize]) {
            return false;
        }
    }
    true
}

fn has_newline(t: &[u8], from: i64, to: i64) -> bool {
    for i in from..to {
        if t[i as usize] == b'\n' {
            return true;
        }
    }
    false
}

// The end of the char literal whose quote is at i (`'a'`, `'\n'`, `'\''`),
// or i + 1 when that quote starts none.
fn char_end(t: &[u8], i: i64) -> i64 {
    if i + 2 < t.len() as i64 && t[(i + 1) as usize] != b'\\' && t[(i + 2) as usize] == b'\'' {
        return i + 3;
    }
    if i + 3 < t.len() as i64 && t[(i + 1) as usize] == b'\\' {
        let mut j = i + 3;
        while j < t.len() as i64 && j < i + 12 && t[j as usize] != b'\'' {
            j += 1;
        }
        if j < t.len() as i64 && t[j as usize] == b'\'' {
            return j + 1;
        }
    }
    i + 1
}

// The first byte from i on that is neither blank nor in a comment.
fn next_code(t: &[u8], i: i64) -> i64 {
    let mut j = i;
    while j < t.len() as i64 {
        if is_blank_byte(t[j as usize]) {
            j += 1;
        } else if t[j as usize] == b'/' && j + 1 < t.len() as i64 && (t[(j + 1) as usize] == b'/' || t[(j + 1) as usize] == b'*') {
            j = comment_end(t, j);
        } else {
            break;
        }
    }
    j
}

// The S_* bits of the code t[from..to).
fn scan(t: &[u8], from: i64, to: i64) -> i64 {
    let mut bits: i64 = 0;
    let mut depth: i64 = 0;
    let mut i = from;
    while i < to {
        let c = t[i as usize];
        if c == b'"' {
            let e = string_end(t, i + 1, i > 0 && t[(i - 1) as usize] == b'f');
            if has_newline(t, i, e) {
                bits |= S_LINES;
            }
            i = e;
        } else if c == b'\'' {
            i = char_end(t, i);
        } else if c == b'/' && i + 1 < to && (t[(i + 1) as usize] == b'/' || t[(i + 1) as usize] == b'*') {
            let e = comment_end(t, i);
            if t[(i + 1) as usize] == b'*' && has_newline(t, i, e) {
                bits |= S_LINES;
            }
            if depth == 0 {
                bits |= S_OPS;
            }
            i = e;
        } else if is_word(c) {
            let mut j = i;
            while j < to && is_word(t[j as usize]) {
                j += 1;
            }
            let w = &t[i as usize..j as usize];
            if depth == 0 && (w == b"let" || w == b"var" || w == b"inout" || w == b"defer") {
                bits |= S_DECL;
            }
            i = j;
        } else {
            if c == b'{' || c == b'(' || c == b'[' {
                depth += 1;
            } else if c == b'}' || c == b')' || c == b']' {
                depth -= 1;
                if depth < 0 {
                    bits |= S_BAD;
                }
            } else if depth == 0 && c == b';' {
                bits |= S_SEMI;
            } else if depth == 0 && c != b'.' && c != b':' {
                bits |= S_OPS;
            }
            i += 1;
        }
    }
    if depth != 0 {
        bits |= S_BAD;
    }
    bits
}

// Whether an expression put in place of t[p..e) needs no parentheses: it
// fills a whole slot (`= _;`, `(_)`, `_,`, `if _ {`, `return _;`).
fn slot(t: &[u8], p: i64, e: i64) -> bool {
    let mut q = p;
    while q > 0 && is_blank_byte(t[(q - 1) as usize]) {
        q -= 1;
    }
    let mut n = e;
    while n < t.len() as i64 && is_blank_byte(t[n as usize]) {
        n += 1;
    }
    if q == 0 || n >= t.len() as i64 {
        return false;
    }
    let pc = t[(q - 1) as usize];
    let nc = t[n as usize];
    let mut w = q;
    while w > 0 && is_word(t[(w - 1) as usize]) {
        w -= 1;
    }
    let word = &t[w as usize..q as usize];
    let opens = word == b"if" || word == b"while" || word == b"match" || word == b"in";
    let before = opens || word == b"return" || pc == b'(' || pc == b',' || pc == b'{'
        || (pc == b'=' && !(q >= 2 && (t[(q - 2) as usize] == b'=' || t[(q - 2) as usize] == b'<' || t[(q - 2) as usize] == b'>'
            || t[(q - 2) as usize] == b'!')))
        || (pc == b'>' && q >= 2 && t[(q - 2) as usize] == b'=');
    let after = nc == b';' || nc == b')' || nc == b',' || nc == b'}' || (nc == b'{' && opens);
    before && after
}

// The edit taking away the block on lines of its own whose `unsafe` line
// starts at ls, whose `{` is at b and which ends at e (after its `}`): its
// lines, one level less indented. last: it is the last statement of its
// block. False when it has another shape (nothing is added).
fn unwrap_lines(t: &[u8], start: i64, ls: i64, b: i64, e: i64, last: bool, pcx: &mut Ctx<Comp>) -> bool {
    let first = line_end(t, b) + 1;
    let close = line_start(t, e - 1);
    if first >= close || blank(t, line_start(t, close - 1), close - 1) {
        return false;
    }
    let text = buf_new();
    let mut p = first;
    let mut last_from = first;
    while p < close {
        let le = line_end(t, p);
        if !blank(t, p, le) {
            if le - p < 4 || t[p as usize] != b' ' || t[(p + 1) as usize] != b' ' || t[(p + 2) as usize] != b' ' || t[(p + 3) as usize] != b' ' {
                return false;
            }
            buf_bytes(text, &t[(p + 4) as usize..le as usize]);
            last_from = p;
        }
        if le + 1 < close {
            buf_byte(text, b'\n');
        }
        p = le + 1;
    }
    if !last {
        // (a statement in the middle of a block: its last line ends it)
        let mut x = line_end(t, last_from);
        while x > last_from && is_blank_byte(t[(x - 1) as usize]) {
            x -= 1;
        }
        let tail = &t[last_from as usize..x as usize];
        for i in 0..tail.len() as i64 {
            if tail[i as usize] == b'/' && i + 1 < tail.len() as i64 && tail[(i + 1) as usize] == b'/' {
                return false;
            }
        }
        if x > last_from && t[(x - 1) as usize] != b';' && t[(x - 1) as usize] != b'}' {
            buf_byte(text, b';');
        }
    }
    edit_replace(start + ls, start + line_end(t, e - 1), text, pcx)
}

// The edit taking away the unsafe block t[p..e) (`unsafe` to after its
// `}`) of the file starting at start in the program's text; whether one
// was added.
fn remove_block(t: &[u8], start: i64, p: i64, e: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut b = p + 6;
    while b < e && is_blank_byte(t[b as usize]) {
        b += 1;
    }
    if b >= e || t[b as usize] != b'{' || t[(e - 1) as usize] != b'}' {
        return false;
    }
    let inner = scan(t, b + 1, e - 1);
    if (inner & (S_BAD | S_LINES)) != 0 {
        return false;
    }
    let after = next_code(t, e);
    let last = after < t.len() as i64 && t[after as usize] == b'}';
    if (inner & S_DECL) != 0 && !last {
        return false;
    }
    let ls = line_start(t, p);
    let alone = blank(t, ls, p);
    // (nothing but blanks and comments after it on its line)
    let ends_line = after >= t.len() as i64 || has_newline(t, e, after);
    if alone && line_end(t, b) < e && blank(t, b + 1, line_end(t, b))
        && blank(t, line_start(t, e - 1), e - 1) && blank(t, e, line_end(t, e)) {
        return unwrap_lines(t, start, ls, b, e, last, pcx);
    }
    if has_newline(t, p, e) {
        return false;
    }
    // On one line: its code, trimmed.
    let mut s = b + 1;
    while s < e - 1 && is_blank_byte(t[s as usize]) {
        s += 1;
    }
    let mut x = e - 1;
    while x > s && is_blank_byte(t[(x - 1) as usize]) {
        x -= 1;
    }
    if s >= x {
        return false;
    }
    let text = buf_new();
    if alone && ends_line {
        // a statement
        buf_bytes(text, &t[s as usize..x as usize]);
        if !last && t[(x - 1) as usize] != b';' && t[(x - 1) as usize] != b'}' {
            buf_byte(text, b';');
        }
    } else {
        // an expression
        if (inner & (S_SEMI | S_DECL)) != 0 {
            return false;
        }
        let parens = (inner & S_OPS) != 0 && !slot(t, p, e);
        if parens {
            buf_byte(text, b'(');
        }
        buf_bytes(text, &t[s as usize..x as usize]);
        if parens {
            buf_byte(text, b')');
        }
    }
    edit_replace(start + p, start + e, text, pcx)
}

// Whether t[from..to) holds the bytes w.
fn holds(t: &[u8], from: i64, to: i64, w: &str) -> bool {
    let b = w.as_bytes();
    let mut i = from;
    while i + b.len() as i64 <= to {
        if &t[i as usize..(i + b.len() as i64) as usize] == b {
            return true;
        }
        i += 1;
    }
    false
}

// (UNNEEDED_JUSTIFIED) Where the comments justifying the unsafe block
// t[p..e) start: the `//` lines right above the block's line, from the
// first that says `UNSAFE:` or `SAFETY:`; -1 when none does, or when the
// block's line holds another `unsafe` (they may be its comments too).
fn justification_start(t: &[u8], p: i64, e: i64) -> i64 {
    let ls = line_start(t, p);
    if holds(t, ls, p, "unsafe") || holds(t, e, line_end(t, e), "unsafe") {
        return -1;
    }
    let mut from: i64 = -1;
    let mut q = ls;
    while q > 0 {
        // the line t[pls..q - 1)
        let pls = line_start(t, q - 1);
        let mut i = pls;
        while i < q - 1 && (t[i as usize] == b' ' || t[i as usize] == b'\t') {
            i += 1;
        }
        if i + 1 >= q - 1 || t[i as usize] != b'/' || t[(i + 1) as usize] != b'/' {
            break;
        }
        if holds(t, i, q - 1, "UNSAFE:") || holds(t, i, q - 1, "SAFETY:") {
            from = pls;
        }
        q = pls;
    }
    from
}

// The edits taking the unneeded unsafe blocks away (to the edit engine,
// edit.vl); returns how many.
pub fn unneeded_unsafe_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut sites: Vec<i64, Comp> = Vec::new_in(Comp {});
    unneeded_blocks(&mut sites, tcx.unneeded_justified, tcx, pcx);
    let mut made: i64 = 0;
    let mut left: i64 = 0;
    let mut kept_file: i64 = -1;
    let mut kept_end: i64 = 0;
    let mut k: i64 = 0;
    while k + 3 < sites.len() as i64 {
        let f = sites[k as usize];
        let p = sites[(k + 1) as usize];
        let e = sites[(k + 2) as usize];
        let justified = sites[(k + 3) as usize] != 0;
        k += 4;
        let start = site_file_start(f, pcx);
        if !ref_in(start + p, pcx) {
            continue;
        }
        let t = site_text(f, pcx);
        let comments: i64 = if justified { justification_start(t, p, e) } else { 0 };
        if f == kept_file && p < kept_end || generated(t) || comments < 0 {
            left += 1;
        } else if remove_block(t, start, p, e, pcx) {
            if justified {
                edit_replace(start + comments, start + line_start(t, p), buf_new(), pcx);
            }
            made += 1;
            kept_file = f;
            kept_end = e;
        } else {
            left += 1;
        }
    }
    tcx.unneeded_left = left;
    made
}
