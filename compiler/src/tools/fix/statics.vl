// `volec fix --only statics --group FILE` (0.26.4, the plan's item f): a
// group of statics moved into a context struct passed down. The group
// file names the statics, the context's field each becomes, the
// parameter's name and type, and its owners (the functions that make the
// context as a local and pass it on):
//
//   param body                          the parameter's name
//   type Body<Comp>                     its type, as written
//   init body_new()                     an owner's `var body = INIT;`
//   owner crate::places::run_places     (one line each)
//   static crate::places::ir::P_STMTS stmts
//
// A function that names one of the statics uses the context; so does a
// function calling one that does, up to the owners. Each of those takes the
// parameter last (before parameters with a default): `body: inout T` when
// it, or one it calls, writes the context (an assignment to it, `&X`, a
// method of it whose receiver is not a let), `body: T` otherwise. Each
// static's use becomes `body.field`, each call gives `&body` (inout) or
// `body`, and each owner begins with `var body = INIT;`. A second run
// changes nothing: the statics are no longer used.
//
// Refused, and listed: a function needing the context that no owner
// reaches (`main`, a C entry, a function used as a value, a trait's
// method), or one with a local of the parameter's name: the group needs
// another owner. `--only statics-list` (a dry run) lists each function:
// FILE:LINE, inout, let, owner or the refusal, its name, an inout one's
// first write (`writes at LINE push`), and why it needs the context: the
// field it uses (`uses table`), else the callee that made it a caller
// (`via add`).
//
// The context passed last lets a call inside another call's arguments take
// it too (`two(add(1, &body), 2, &body)`); left to the checker: a method on
// one of the context's fields whose argument changes the context.

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_src, intern, read_file, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{FN_CLOSURE, FN_DERIVED, NODE_IMPLICIT, NodeKind, child};
use crate::front::check::Res;
use crate::front::generics::instantiate::{node_field_a, node_field_b, node_field_c};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{REF_SHARED, TyKind, fn_param};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::{after_line, item_tail};
use crate::tools::fix::remove_use_names;
use crate::tools::query::defs::{def_of_node, mod_fqn_text};
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::line_start;
use crate::tools::query::show::text_start;

// Per function, keyed by its item's start + 1: an item node of it; set
// when it uses a static of the group (F_USES), writes one (F_WRITES), is
// an owner, takes the parameter, takes it inout, is called, is used as a
// value, is a trait's.
const F_USES: i64 = 1;
const F_WRITES: i64 = 2;
const F_OWNER: i64 = 4;
const F_MEMBER: i64 = 8;
const F_INOUT: i64 = 16;
const F_CALLED: i64 = 32;
const F_VALUE: i64 = 64;
const F_TRAIT: i64 = 128;
const F_ENTRY: i64 = 256;
const F_CLASH: i64 = 512;
// (0.26.5) It has the parameter already (a context given before: `NAME:
// TYPE`), inout; it has a local of the name (an owner's, made before).
const F_HAS: i64 = 1024;
const F_HAS_INOUT: i64 = 2048;
const F_LOCAL: i64 = 4096;
// (0.26.5) It is in a generated file (its first line `// Generated by`).
const F_GEN: i64 = 8192;
// (0.26.5) A view: a function that gives its calls the context as the
// group file's expression (`view PATH EXPR`: a thread's task loop, which
// reaches the context through the pool's pointer), let only.
const F_VIEW: i64 = 16384;

fn flags(pos: i64, tcx: &Tcx<Comp>) -> i64 {
    tcx.statics_flags.get(pos + 1)
}

fn set(pos: i64, bits: i64, tcx: &mut Tcx<Comp>) {
    tcx.statics_flags.put(pos + 1, flags(pos, tcx) | bits);
}

fn has(pos: i64, bits: i64, tcx: &Tcx<Comp>) -> bool {
    (flags(pos, tcx) & bits) != 0
}

// "crate::a::b" and "a::b" are the same path.
fn trimmed(s: &[u8]) -> &[u8] {
    if s.len() >= 7 && s[0..7] == b"crate::" { &s[7..] } else { s }
}

fn path_is(sym: i64, want: i64, pcx: &Ctx<Comp>) -> bool {
    sym >= 0 && trimmed(sym_text(sym, pcx)) == trimmed(sym_text(want, pcx))
}

fn is_space(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n'
}

// ---- The group file ----

// Reads GROUP_FILE; false (with an error) when it is not a group.
fn read_group(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let b = buf_new();
    read_file(tcx.group_file, b, pcx);
    let s = buf_slice(b);
    let mut k: usize = 0;
    let mut ok = true;
    while k < s.len() {
        let mut e: usize = k;
        while e < s.len() && s[e] != b'\n' {
            e += 1;
        }
        let line = &s[k..e];
        k = e + 1;
        let mut a: usize = 0;
        while a < line.len() && is_space(line[a]) {
            a += 1;
        }
        if a == line.len() || line[a] == b'#' {
            continue;
        }
        let mut w: usize = a;
        while w < line.len() && !is_space(line[w]) {
            w += 1;
        }
        let word = &line[a..w];
        let mut r: usize = w;
        while r < line.len() && is_space(line[r]) {
            r += 1;
        }
        let mut z: usize = line.len();
        while z > r && is_space(line[z - 1]) {
            z -= 1;
        }
        let rest = &line[r..z];
        if word == b"param" {
            tcx.g_param = intern(rest, pcx);
        } else if word == b"type" {
            tcx.g_type = intern(rest, pcx);
        } else if word == b"init" {
            tcx.g_init = intern(rest, pcx);
        } else if word == b"owner" {
            tcx.g_owners.push(intern(rest, pcx));
        } else if word == b"use" {
            tcx.g_uses.push(intern(rest, pcx));
        } else if word == b"view" {
            let mut m: usize = 0;
            while m < rest.len() && !is_space(rest[m]) {
                m += 1;
            }
            let mut f: usize = m;
            while f < rest.len() && is_space(rest[f]) {
                f += 1;
            }
            if f == rest.len() {
                ok = false;
            } else {
                tcx.g_views.push(intern(&rest[0..m], pcx));
                tcx.g_view_exprs.push(intern(&rest[f..], pcx));
            }
        } else if word == b"owner-use" {
            tcx.g_owner_uses.push(intern(rest, pcx));
        } else if word == b"static" {
            let mut m: usize = 0;
            while m < rest.len() && !is_space(rest[m]) {
                m += 1;
            }
            let mut f: usize = m;
            while f < rest.len() && is_space(rest[f]) {
                f += 1;
            }
            if f == rest.len() {
                ok = false;
            } else {
                tcx.g_paths.push(intern(&rest[0..m], pcx));
                tcx.g_fields.push(intern(&rest[f..], pcx));
            }
        } else {
            ok = false;
        }
    }
    if !ok || tcx.g_param < 0 || tcx.g_type < 0 || tcx.g_init < 0 || tcx.g_paths.count == 0 {
        let d = diag(c"error", c"fix.statics", tcx);
        buf_str(d, c"--group takes a file of `param NAME`, `type TYPE`, `init EXPR`, `owner PATH`, `use PATH`, `owner-use PATH` and `static PATH FIELD` lines\n");
        return false;
    }
    true
}

// The group's statics, by their ids (those --prune dropped left out).
fn resolve_group(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    // UNSAFE: STATICS is the checker's table of statics, a raw pointer (front::types).
    // SAFETY: s is below STATIC_COUNT, the table's length.
    unsafe {
        for s in 0..pcx.statics.len() as i64 {
            let d = def_of_node(pcx.statics[s as usize].node, tcx, pcx);
            if d < 0 {
                continue;
            }
            for i in 0..tcx.g_paths.count {
                if tcx.g_dropped.get(i + 1) == 0
                    && path_is(pcx.defs[d as usize].fqn, tcx.g_paths.get(i), pcx) {
                    tcx.field_of.put(s + 1, i + 1);
                    tcx.statics_counts[0] += 1;
                }
            }
        }
    }
}

// ---- The walk ----

fn f_node(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer (front::types).
    // SAFETY: f is below FN_COUNT, the table's length, wherever this is called.
    unsafe { pcx.fns[f as usize].node }
}

fn f_extern(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { pcx.fns[f as usize].is_extern }
}

// Whether f is a function of the program with a body to edit (not std's,
// not a closure's or a derived one).
fn editable(f: i64, pcx: &Ctx<Comp>) -> bool {
    if f < 0 || f >= pcx.fns.len() as i64 || f_extern(f, pcx) {
        return false;
    }
    let item = f_node(f, pcx);
    if item <= 0 || pcx.nodes[item as usize].kind != NodeKind::Fn
        || pcx.nodes[item as usize].c == 0 {
        return false;
    }
    if (pcx.nodes[item as usize].p & (FN_CLOSURE | FN_DERIVED)) != 0 {
        return false;
    }
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: file_of_pos gives the index of a loaded file, and every path is NUL-terminated.
    unsafe {
        (*pcx.files[file_of_pos(pcx.nodes[item as usize].start, pcx) as usize].path.add(0)) != b'<'
    }
}

// The root of a place: through fields, indexes, tuple fields and `&` (a
// receiver's, the checker's own).
fn place_root(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut t = n;
    while t > 0 {
        let k = pcx.nodes[t as usize].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::Index || k == NodeKind::TupleField {
            t = pcx.nodes[t as usize].a;
        } else if k == NodeKind::Unary && pcx.nodes[t as usize].op == Tok::Amp {
            t = pcx.nodes[t as usize].b;
        } else {
            break;
        }
    }
    t
}

// The static of the group a place is rooted at (through fields, indexes
// and tuple fields): its Ident node, or 0.
fn group_root(n: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let t = place_root(n, pcx);
    if t > 0 && pcx.nodes[t as usize].kind == NodeKind::Ident
        && pcx.nodes[t as usize].res == Res::Static
        && tcx.field_of.get(pcx.nodes[t as usize].y + 1) != 0 {
        return t;
    }
    0
}

// Whether method g changes its receiver: the program's, by its checked
// type (an inout one or a raw pointer); std's, whose `self` is a
// reference in std's spelling whatever the method does, by its name (the
// ones that only read: `len`, `get`, `iter`, ...).
fn receiver_writes(g: i64, pcx: &Ctx<Comp>) -> bool {
    if in_std(g, pcx) {
        let name = sym_text(pcx.nodes[f_node(g, pcx) as usize].a, pcx);
        return !(name == b"len" || name == b"is_empty" || name == b"get" || name == b"as_slice"
            || name == b"iter" || name == b"contains" || name == b"first" || name == b"last"
            || name == b"capacity" || name == b"as_ptr" || name == b"clone"
            || name == b"starts_with" || name == b"ends_with" || name == b"to_vec" || name == b"eq"
            || name == b"slice" || name == b"as_bytes" || name == b"as_str" || name == b"index"
            || name == b"ne" || name == b"fmt" || name == b"hash");
    }
    let t = fn_param(g, 0, pcx);
    if t <= 0 {
        return true;
    }
    pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != REF_SHARED
}

// Whether function g is std's.
fn in_std(g: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: file_of_pos gives the index of a loaded file, and every path is NUL-terminated.
    unsafe { (
        *pcx.files[file_of_pos(pcx.nodes[f_node(g, pcx) as usize].start, pcx) as usize].path.add(0))
        == b'<' }
}

// Node n writes the context in the function walked.
fn wrote(n: i64, tcx: &mut Tcx<Comp>) {
    set(tcx.statics_cur, F_WRITES, tcx);
    if tcx.write_at.get(tcx.statics_cur + 1) == 0 {
        tcx.write_at.put(tcx.statics_cur + 1, n + 1);
    }
}

fn walk(n: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if n <= 0 {
        return;
    }
    let kind = pcx.nodes[n as usize].kind;
    let saved_stmt = tcx.statics_stmt;
    let saved_call = tcx.statics_call;
    let saved_interp = tcx.statics_interp;
    if kind == NodeKind::Interp && saved_interp == 0 {
        tcx.statics_interp = n;
    }
    if kind == NodeKind::ExprStmt || kind == NodeKind::Let {
        note_statement(n, tcx, pcx);
        tcx.statics_stmt = n;
    }
    // (a name the parameter would shadow or be shadowed by; the parameter
    // itself, given before, of the group's type)
    if (kind == NodeKind::PatBind || kind == NodeKind::Param)
        && pcx.nodes[n as usize].a == tcx.g_param {
        let mut io = false;
        if kind == NodeKind::Param && param_of_group(n, &mut io, tcx, pcx) {
            set(tcx.statics_cur, if io { F_HAS | F_HAS_INOUT | F_INOUT } else { F_HAS }, tcx);
        } else if kind == NodeKind::PatBind {
            set(tcx.statics_cur, F_LOCAL, tcx);
        } else {
            set(tcx.statics_cur, F_CLASH, tcx);
        }
    }
    if kind == NodeKind::Ident {
        let y = pcx.nodes[n as usize].y;
        if pcx.nodes[n as usize].res == Res::Static && tcx.field_of.get(y + 1) != 0 {
            tcx.u_node.push(n);
            tcx.u_field.push(tcx.field_of.get(y + 1) - 1);
            tcx.u_fn.push(tcx.statics_cur);
            let i = tcx.statics_interp;
            let hole = i > 0 && pcx.nodes[n as usize].start >= pcx.nodes[i as usize].start
                && pcx.nodes[n as usize].end <= pcx.nodes[i as usize].end && hole_at(n, pcx);
            tcx.u_call.push(if hole { i } else { 0 });
            if tcx.first_use.get(tcx.statics_cur + 1) == 0 {
                tcx.first_use.put(tcx.statics_cur + 1, tcx.field_of.get(y + 1));
            }
            set(tcx.statics_cur, F_USES, tcx);
        }
        else if pcx.nodes[n as usize].res == Res::Fn && tcx.statics_callees.get(n + 1) == 0
            && editable(y, pcx) {
            set(pcx.nodes[f_node(y, pcx) as usize].start, F_VALUE, tcx);
        }
    } else if kind == NodeKind::Assign {
        if group_root(pcx.nodes[n as usize].b, tcx, pcx) != 0 {
            wrote(n, tcx);
        }
    }
    else if kind == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Amp
        && get_src()[pcx.nodes[n as usize].start as usize] == b'&' {
        // (a `&` written: the checker's own, a receiver's, are not)
        if group_root(pcx.nodes[n as usize].b, tcx, pcx) != 0 {
            wrote(n, tcx);
            // (lent to the innermost call: lend_all)
            if tcx.statics_call != 0 && tcx.statics_interp == 0 {
                tcx.b_call.push(tcx.statics_call);
                tcx.b_arg.push(n);
                tcx.b_fn.push(tcx.statics_cur);
                tcx.b_stmt.push(tcx.statics_stmt);
            }
        }
    } else if kind == NodeKind::Call {
        let g = pcx.nodes[n as usize].x - 1;
        if pcx.nodes[n as usize].a != 0 {
            tcx.statics_callees.put(pcx.nodes[n as usize].a + 1, 1);
        } else if pcx.nodes[n as usize].count > 0 && group_root(child(n, 0, pcx), tcx, pcx) != 0 {
            // (a method of the context's field: a write unless its receiver is a let)
            if receiver_writes(g, pcx) {
                wrote(n, tcx);
            }
        }
        if editable(g, pcx) {
            tcx.statics_e_from.push(tcx.statics_cur);
            tcx.statics_e_to.push(pcx.nodes[f_node(g, pcx) as usize].start);
            tcx.e_node.push(n);
        }
        if tcx.statics_interp == 0 {
            tcx.statics_call = n;
        }
    }
    if node_field_a(kind) {
        walk(pcx.nodes[n as usize].a, tcx, pcx);
    }
    if node_field_b(kind) {
        walk(pcx.nodes[n as usize].b, tcx, pcx);
    }
    if node_field_c(kind) {
        walk(pcx.nodes[n as usize].c, tcx, pcx);
    }
    if kind == NodeKind::For || kind == NodeKind::Param {
        walk(pcx.nodes[n as usize].d, tcx, pcx);
    }
    // (a format literal's and a `?`'s checked form: the calls in it are
    // resolved there; a static in a literal's hole is named by the call
    // the literal is given to)
    if kind == NodeKind::Interp || kind == NodeKind::Try {
        walk(pcx.nodes[n as usize].y, tcx, pcx);
    }
    for i in 0..pcx.nodes[n as usize].count {
        walk(child(n, i, pcx), tcx, pcx);
    }
    tcx.statics_call = saved_call;
    tcx.statics_stmt = saved_stmt;
    tcx.statics_interp = saved_interp;
}

// Whether Ident n is a format literal's hole, `{NAME}` or `{NAME:..}`.
fn hole_at(n: i64, pcx: &Ctx<Comp>) -> bool {
    let a = pcx.nodes[n as usize].start;
    let b = pcx.nodes[n as usize].end;
    a > 0 && get_src()[(a - 1) as usize] == b'{' && b < get_src().len() as i64
        && (get_src()[b as usize] == b'}' || get_src()[b as usize] == b':')
}

// Whether Param node n is `NAME: TYPE` or `NAME: inout TYPE`, TYPE the
// group's (a context given before); IO: whether it is inout.
fn param_of_group(n: i64, io: &mut bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let at = param_type_at(n, pcx);
    *io = false;
    if at < 0 {
        return false;
    }
    let mut k = at;
    if k + 6 <= pcx.nodes[n as usize].end && get_src()[k as usize..(k + 6) as usize] == b"inout " {
        *io = true;
        k += 6;
    }
    let mut e = pcx.nodes[n as usize].end;
    while e > k && is_space(get_src()[(e - 1) as usize]) {
        e -= 1;
    }
    &get_src()[k as usize..e as usize] == sym_text(tcx.g_type, pcx)
}

// The position of Param node n's type (after its `:`), or -1.
fn param_type_at(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut k = pcx.nodes[n as usize].start;
    while k < pcx.nodes[n as usize].end && get_src()[k as usize] != b':' {
        k += 1;
    }
    if k >= pcx.nodes[n as usize].end {
        return -1;
    }
    k += 1;
    while k < pcx.nodes[n as usize].end && is_space(get_src()[k as usize]) {
        k += 1;
    }
    k
}

// Every function of the program (each instance of a generic one: its
// checked copy), walked.
fn walk_all(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if !editable(f, pcx) {
            continue;
        }
        let item = f_node(f, pcx);
        let pos = pcx.nodes[item as usize].start;
        if tcx.item.get(pos + 1) == 0 {
            tcx.item.put(pos + 1, item);
            tcx.statics_items.push(pos);
            let d = def_of_node(item, tcx, pcx);
            if d >= 0 {
                for i in 0..tcx.g_owners.count {
                    if path_is(pcx.defs[d as usize].fqn, tcx.g_owners.get(i), pcx) {
                        set(pos, F_OWNER, tcx);
                    }
                }
                for i in 0..tcx.g_views.count {
                    if path_is(pcx.defs[d as usize].fqn, tcx.g_views.get(i), pcx) {
                        set(pos, F_OWNER | F_VIEW, tcx);
                        tcx.view_of.put(pos + 1, i + 1);
                    }
                }
                if pcx.defs[d as usize].tr >= 0 {
                    set(pos, F_TRAIT, tcx);
                }
                if trimmed(sym_text(pcx.defs[d as usize].fqn, pcx)) == b"main"
                    || pcx.nodes[item as usize].y == 1 {
                    set(pos, F_ENTRY, tcx);
                }
                let fs = pcx.files[file_of_pos(pos, pcx) as usize].start;
                if fs + 15 <= get_src().len() as i64
                    && get_src()[fs as usize..(fs + 15) as usize] == b"// Generated by" {
                    set(pos, F_GEN, tcx);
                }
            }
        }
        tcx.statics_cur = pos;
        for j in 0..pcx.nodes[item as usize].count {
            walk(child(item, j, pcx), tcx, pcx);
        }
        walk(pcx.nodes[item as usize].c, tcx, pcx);
    }
}

// The functions that take the parameter: the users and, up the calls,
// their callers, the owners left out; then which take it inout. VIA: for
// a caller, the callee that made it one (its item's start + 1), for the
// list's `via NAME`.
fn close(tcx: &mut Tcx<Comp>) {
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        if has(p, F_USES, tcx) && !has(p, F_OWNER, tcx) {
            set(p, F_MEMBER, tcx);
        }
        if has(p, F_WRITES, tcx) {
            set(p, F_INOUT, tcx);
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        for e in 0..tcx.statics_e_from.count {
            let c = tcx.statics_e_from.get(e);
            let g = tcx.statics_e_to.get(e);
            if !has(g, F_MEMBER, tcx) {
                continue;
            }
            set(g, F_CALLED, tcx);
            if !has(c, F_MEMBER, tcx) && !has(c, F_OWNER, tcx) {
                set(c, F_MEMBER, tcx);
                tcx.via.put(c + 1, g + 1);
                changed = true;
            }
            if has(g, F_INOUT, tcx) && !has(c, F_INOUT, tcx) {
                set(c, F_INOUT, tcx);
                changed = true;
            }
        }
    }
}

// Whether member p is refused: nothing calls it, or it is a value, a
// trait's method or a generated file's (when it is to take the parameter,
// or a given one is to become inout), or a name is in the way; a view
// whose callee changes the context.
fn refused(p: i64, tcx: &Tcx<Comp>) -> bool {
    if has(p, F_VIEW, tcx) {
        return has(p, F_USES, tcx) || view_writes(p, tcx) >= 0;
    }
    if !has(p, F_MEMBER, tcx) {
        return false;
    }
    if has(p, F_CLASH, tcx) || (has(p, F_LOCAL, tcx) && !has(p, F_HAS, tcx)) {
        return true;
    }
    let changes = !has(p, F_HAS, tcx) || upgraded(p, tcx);
    changes && (has(p, F_ENTRY, tcx) || has(p, F_VALUE, tcx) || has(p, F_TRAIT, tcx)
        || has(p, F_GEN, tcx))
}

// View p's callee that takes the context inout, or -1.
fn view_writes(p: i64, tcx: &Tcx<Comp>) -> i64 {
    for e in 0..tcx.statics_e_from.count {
        let g = tcx.statics_e_to.get(e);
        if tcx.statics_e_from.get(e) == p && has(g, F_MEMBER, tcx) && has(g, F_INOUT, tcx) {
            return g;
        }
    }
    -1
}

// Drops, for view p, a field each function below it that takes the
// context inout writes (down the inout callees: the written field, or the
// first static used where no write is found); the number dropped.
fn view_drop_written(p: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut todo: Vec<i64, Comp> = Vec::new_in(Comp {});
    todo.push(p);
    seen.put(p + 1, 1);
    let mut dropped: i64 = 0;
    let mut k: i64 = 0;
    while k < todo.len() as i64 {
        let q = todo[k as usize];
        k += 1;
        let mut down = false;
        for e in 0..tcx.statics_e_from.count {
            let g = tcx.statics_e_to.get(e);
            if tcx.statics_e_from.get(e) == q && has(g, F_MEMBER, tcx) && has(g, F_INOUT, tcx) {
                down = true;
                if seen.get(g + 1) == 0 {
                    seen.put(g + 1, 1);
                    todo.push(g);
                }
            }
        }
        if q == p {
            continue;
        }
        let mut f: i64 = -1;
        let w = tcx.write_at.get(q + 1);
        if has(q, F_WRITES, tcx) && w > 0 {
            let wn = w - 1;
            let place = if pcx.nodes[wn as usize].kind == NodeKind::Call { child(wn, 0, pcx) }
                else { pcx.nodes[wn as usize].b };
            let root = group_root(place, tcx, pcx);
            if root > 0 {
                f = tcx.field_of.get(pcx.nodes[root as usize].y + 1) - 1;
            }
        }
        if f < 0 && !down {
            f = tcx.first_use.get(q + 1) - 1;
        }
        if f >= 0 && tcx.g_dropped.get(f + 1) == 0 {
            tcx.g_dropped.put(f + 1, p + 1);
            dropped += 1;
        }
    }
    dropped
}

// Whether p takes the context let already and now needs it inout.
fn upgraded(p: i64, tcx: &Tcx<Comp>) -> bool {
    has(p, F_HAS, tcx) && has(p, F_INOUT, tcx) && !has(p, F_HAS_INOUT, tcx)
}

// Function item's Param node named NAME, or 0.
fn param_named(item: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    for j in 0..pcx.nodes[item as usize].count {
        let p = child(item, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param && pcx.nodes[p as usize].a == name {
            return p;
        }
    }
    0
}

// The index among function item's parameters of the one named by the
// identifier at s (a named argument's), or -1.
fn named_index(item: i64, s: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e = s;
    while e < get_src().len() as i64
        && (get_src()[e as usize] == b'_'
            || (get_src()[e as usize] >= b'a' && get_src()[e as usize] <= b'z')
            || (get_src()[e as usize] >= b'A' && get_src()[e as usize] <= b'Z')
            || (get_src()[e as usize] >= b'0' && get_src()[e as usize] <= b'9')) {
        e += 1;
    }
    let mut k: i64 = 0;
    for j in 0..pcx.nodes[item as usize].count {
        let p = child(item, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param {
            if sym_text(pcx.nodes[p as usize].a, pcx) == &get_src()[s as usize..e as usize] {
                return k;
            }
            k += 1;
        }
    }
    -1
}

// ---- The edits ----

// The index the parameter takes in function item's parameters: before the
// first with a default, else last; and the Param nodes' count.
fn param_index(item: i64, count: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    let mut k: i64 = -1;
    *count = 0;
    for j in 0..pcx.nodes[item as usize].count {
        let p = child(item, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param {
            continue;
        }
        if pcx.nodes[p as usize].h != 0 && k < 0 {
            k = *count;
        }
        *count += 1;
    }
    if k < 0 { *count } else { k }
}

fn param_at(item: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut k: i64 = 0;
    for j in 0..pcx.nodes[item as usize].count {
        let p = child(item, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param {
            if k == i {
                return p;
            }
            k += 1;
        }
    }
    0
}

// The position after the first `(` at or after pos.
fn after_paren(pos: i64) -> i64 {
    let mut k = pos;
    while k < get_src().len() as i64 && get_src()[k as usize] != b'(' {
        k += 1;
    }
    k + 1
}

fn put_edit(a: i64, b: i64, text: i64, tcx: &mut Tcx<Comp>) {
    tcx.x_start.push(a);
    tcx.x_end.push(b);
    tcx.statics_x_text.push(text);
}

fn insert(pos: i64, text: i64, tcx: &mut Tcx<Comp>) {
    put_edit(pos, pos, text, tcx);
}

// SRC[a..b] with the recorded edits inside it made (in position order,
// insertions at one position in their order), into out; those edits are
// taken.
fn render(out: i64, a: i64, b: i64, tcx: &mut Tcx<Comp>) {
    let mut at = a;
    loop {
        // (the next edit at or after `at`: the first recorded among those
        // starting first)
        let mut best: i64 = -1;
        for i in 0..tcx.x_start.count {
            let s = tcx.x_start.get(i);
            if tcx.statics_x_text.get(i) < 0 || s < at || tcx.x_end.get(i) > b || s > b {
                continue;
            }
            if best < 0 || s < tcx.x_start.get(best) {
                best = i;
            }
        }
        if best < 0 {
            break;
        }
        let s = tcx.x_start.get(best);
        buf_bytes(out, &get_src()[at as usize..s as usize]);
        buf_bytes(out, buf_slice(tcx.statics_x_text.get(best)));
        at = tcx.x_end.get(best);
        tcx.statics_x_text.set(best, -1);
    }
    buf_bytes(out, &get_src()[at as usize..b as usize]);
}

// render, an insertion at b left out (it follows the text: a call's
// argument added after its last one).
fn render_inside(out: i64, a: i64, b: i64, tcx: &mut Tcx<Comp>) {
    let mut held = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..tcx.x_start.count {
        let t = tcx.statics_x_text.get(i);
        if t >= 0 && tcx.x_start.get(i) == b && tcx.x_end.get(i) == b {
            held.push(i);
            tcx.statics_x_text.set(i, -(t + 2));
        }
    }
    render(out, a, b, tcx);
    for k in 0..held.count {
        let i = held.get(k);
        tcx.statics_x_text.set(i, -tcx.statics_x_text.get(i) - 2);
    }
}

fn flush_edits(tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..tcx.x_start.count {
        if tcx.statics_x_text.get(i) >= 0 {
            edit_replace(tcx.x_start.get(i), tcx.x_end.get(i), tcx.statics_x_text.get(i), pcx);
        }
    }
}

// The parameter's text: `NAME: inout TYPE` or `NAME: TYPE`.
fn param_text(b: i64, inout_: bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    buf_bytes(b, sym_text(tcx.g_param, pcx));
    buf_str(b, if inout_ { c": inout " } else { c": " });
    buf_bytes(b, sym_text(tcx.g_type, pcx));
}

fn edit_params(pos: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let item = tcx.item.get(pos + 1);
    if has(pos, F_HAS, tcx) {
        // (given before: `inout` when it now changes the context)
        if upgraded(pos, tcx) {
            let p = param_named(item, tcx.g_param, pcx);
            let b = buf_new();
            buf_str(b, c"inout ");
            insert(param_type_at(p, pcx), b, tcx);
            tcx.statics_counts[7] += 1;
        }
        return;
    }
    let mut count: i64 = 0;
    let k = param_index(item, &mut count, pcx);
    let b = buf_new();
    let inout_ = has(pos, F_INOUT, tcx);
    if k < count {
        param_text(b, inout_, tcx, pcx);
        buf_str(b, c", ");
        insert(pcx.nodes[param_at(item, k, pcx) as usize].start, b, tcx);
    } else if count > 0 {
        buf_str(b, c", ");
        param_text(b, inout_, tcx, pcx);
        insert(pcx.nodes[param_at(item, count - 1, pcx) as usize].end, b, tcx);
    } else {
        param_text(b, inout_, tcx, pcx);
        // (the `(` after the name)
        let name = sym_text(pcx.nodes[item as usize].a, pcx);
        let mut at = pcx.nodes[item as usize].start;
        while at + name.len() as i64 <= get_src().len() as i64
            && get_src()[at as usize..(at + name.len() as i64) as usize] != name {
            at += 1;
        }
        insert(after_paren(at + name.len() as i64), b, tcx);
    }
    tcx.statics_counts[7] += 1;
}

// The argument a call of g gives in the function edited (statics_cur):
// `&NAME` or `NAME`; a view's expression in a view.
fn arg_text(b: i64, g: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let c = tcx.statics_cur;
    if has(c, F_VIEW, tcx) {
        buf_bytes(b, sym_text(tcx.g_view_exprs.get(tcx.view_of.get(c + 1) - 1), pcx));
        return;
    }
    if has(g, F_INOUT, tcx) {
        buf_byte(b, b'&');
    }
    buf_bytes(b, sym_text(tcx.g_param, pcx));
}

// Past a string or character literal starting at k (its quote).
fn skip_literal(k: i64) -> i64 {
    let q = get_src()[k as usize];
    let mut i = k + 1;
    while i < get_src().len() as i64 && get_src()[i as usize] != q {
        if get_src()[i as usize] == b'\\' {
            i += 1;
        }
        i += 1;
    }
    i + 1
}

fn push_segment(a: i64, b: i64, tcx: &mut Tcx<Comp>) {
    let mut s = a;
    let mut e = b;
    while s < e && is_space(get_src()[s as usize]) {
        s += 1;
    }
    while e > s && is_space(get_src()[(e - 1) as usize]) {
        e -= 1;
    }
    if s < e {
        tcx.seg_start.push(s);
        tcx.seg_end.push(e);
    }
}

// The segments of the argument list opening at open (after its `(`); the
// position of its `)`, or -1.
fn split_args(open: i64, tcx: &mut Tcx<Comp>) -> i64 {
    tcx.seg_start.count = 0;
    tcx.seg_end.count = 0;
    let mut depth: i64 = 0;
    let mut seg = open;
    let mut k = open;
    while k < get_src().len() as i64 {
        let c = get_src()[k as usize];
        if c == b'"' || (c == b'\'' && k + 2 < get_src().len() as i64
            && (get_src()[(k + 2) as usize] == b'\'' || get_src()[(k + 1) as usize] == b'\\')) {
            k = skip_literal(k);
            continue;
        }
        if c == b'/' && k + 1 < get_src().len() as i64 && get_src()[(k + 1) as usize] == b'/' {
            while k < get_src().len() as i64 && get_src()[k as usize] != b'\n' {
                k += 1;
            }
            continue;
        }
        if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            if depth == 0 {
                push_segment(seg, k, tcx);
                return k;
            }
            depth -= 1;
        } else if c == b',' && depth == 0 {
            push_segment(seg, k, tcx);
            seg = k + 1;
        }
        k += 1;
    }
    -1
}

// Whether the segment at s is a named argument (`name: value`).
fn named_at(s: i64) -> bool {
    let mut k = s;
    while k < get_src().len() as i64
        && (get_src()[k as usize] == b'_'
            || (get_src()[k as usize] >= b'a' && get_src()[k as usize] <= b'z')
            || (get_src()[k as usize] >= b'A' && get_src()[k as usize] <= b'Z')
            || (get_src()[k as usize] >= b'0' && get_src()[k as usize] <= b'9')) {
        k += 1;
    }
    if k == s {
        return false;
    }
    while k < get_src().len() as i64 && get_src()[k as usize] == b' ' {
        k += 1;
    }
    k + 1 < get_src().len() as i64 && get_src()[k as usize] == b':'
        && get_src()[(k + 1) as usize] != b':'
}

fn edit_call(n: i64, g: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let key = pcx.nodes[n as usize].start * 4096 + (
        pcx.nodes[n as usize].end - pcx.nodes[n as usize].start) % 4096;
    if tcx.statics_done.get(key + 1) != 0 {
        return;
    }
    tcx.statics_done.put(key + 1, 1);
    let method = pcx.nodes[n as usize].a == 0;
    let from = if method { pcx.nodes[child(n, 0, pcx) as usize].end }
        else { pcx.nodes[pcx.nodes[n as usize].a as usize].end };
    let open = after_paren(from);
    if split_args(open, tcx) < 0 {
        tcx.statics_counts[8] += 1;
        return;
    }
    let segs = tcx.seg_start.count;
    let name = sym_text(tcx.g_param, pcx);
    if has(g, F_HAS, tcx) {
        // (it takes the context already: given `&NAME` when it now changes it)
        if upgraded(g, tcx) {
            for s in 0..segs {
                let mut v = tcx.seg_start.get(s);
                if named_at(v) {
                    while get_src()[v as usize] != b':' {
                        v += 1;
                    }
                    v += 1;
                    while is_space(get_src()[v as usize]) {
                        v += 1;
                    }
                }
                if &get_src()[v as usize..tcx.seg_end.get(s) as usize] == name {
                    let b = buf_new();
                    buf_byte(b, b'&');
                    insert(v, b, tcx);
                    tcx.statics_counts[6] += 1;
                }
            }
        }
        return;
    }
    let mut count: i64 = 0;
    let item = tcx.item.get(g + 1);
    let k = param_index(item, &mut count, pcx);
    // (the index among the arguments written in the parentheses)
    let at = if method { k - 1 } else { k };
    let mut positional: i64 = 0;
    while positional < segs && !named_at(tcx.seg_start.get(positional)) {
        positional += 1;
    }
    let b = buf_new();
    if segs == 0 {
        arg_text(b, g, tcx, pcx);
        insert(open, b, tcx);
    } else if at < positional {
        arg_text(b, g, tcx, pcx);
        buf_str(b, c", ");
        insert(tcx.seg_start.get(at), b, tcx);
    } else if positional < segs {
        // (named arguments follow the parameters' order: the context
        // named, before the first whose parameter comes after it)
        let mut before: i64 = -1;
        for s in positional..segs {
            if before < 0 && named_index(item, tcx.seg_start.get(s), pcx) >= k {
                before = s;
            }
        }
        if before < 0 {
            buf_str(b, c", ");
        }
        buf_bytes(b, name);
        buf_str(b, c": ");
        arg_text(b, g, tcx, pcx);
        if before >= 0 {
            buf_str(b, c", ");
            insert(tcx.seg_start.get(before), b, tcx);
        } else {
            insert(tcx.seg_end.get(segs - 1), b, tcx);
        }
    } else {
        buf_str(b, c", ");
        arg_text(b, g, tcx, pcx);
        insert(tcx.seg_end.get(segs - 1), b, tcx);
    }
    tcx.statics_counts[6] += 1;
}

// Use i (u_node) as the context's field: `NAME.field`; in a format
// literal's hole, `{field}` and the named argument `field = NAME.field`
// given to the literal's call (once per call and field).
fn edit_use(i: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let n = tcx.u_node.get(i);
    let field = tcx.u_field.get(i);
    let lit = tcx.u_call.get(i);
    let key = pcx.nodes[n as usize].start;
    if tcx.statics_done.get(-(key + 1)) != 0 {
        return;
    }
    tcx.statics_done.put(-(key + 1), 1);
    let fname = sym_text(tcx.g_fields.get(field), pcx);
    let b = buf_new();
    if lit > 0 {
        buf_bytes(b, fname);
        put_edit(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, b, tcx);
        // (the call the literal is given to: its `(` before the literal, at
        // depth 0, and its `)`)
        let mut open = pcx.nodes[n as usize].start - 1;
        while open > 0
            && !(get_src()[open as usize] == b'"' && get_src()[(open - 1) as usize] != b'\\') {
            open -= 1;
        }
        open -= 1;
        let mut depth: i64 = 0;
        while open > 0 && !(depth == 0 && get_src()[open as usize] == b'(') {
            if get_src()[open as usize] == b')' || get_src()[open as usize] == b']' {
                depth += 1;
            } else if get_src()[open as usize] == b'(' || get_src()[open as usize] == b'[' {
                depth -= 1;
            }
            open -= 1;
        }
        let close = split_args(open + 1, tcx);
        let k2 = open * 4096 + field + (1 << 41);
        if close > 0 && tcx.statics_done.get(-(k2 + 1)) == 0 {
            tcx.statics_done.put(-(k2 + 1), 1);
            let a = buf_new();
            buf_str(a, c", ");
            buf_bytes(a, fname);
            buf_str(a, c" = ");
            buf_bytes(a, sym_text(tcx.g_param, pcx));
            buf_byte(a, b'.');
            buf_bytes(a, fname);
            insert(close, a, tcx);
            tcx.statics_counts[14] += 1;
        }
    } else {
        buf_bytes(b, sym_text(tcx.g_param, pcx));
        buf_byte(b, b'.');
        buf_bytes(b, fname);
        put_edit(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, b, tcx);
    }
    tcx.statics_counts[1] += 1;
}

// An owner's local, at the start of its body.
fn edit_owner(pos: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let item = tcx.item.get(pos + 1);
    let body = pcx.nodes[item as usize].c;
    let b = buf_new();
    buf_str(b, c"\n    var ");
    buf_bytes(b, sym_text(tcx.g_param, pcx));
    buf_str(b, c" = ");
    buf_bytes(b, sym_text(tcx.g_init, pcx));
    buf_byte(b, b';');
    insert(pcx.nodes[body as usize].start + 1, b, tcx);
    tcx.statics_counts[5] += 1;
}

// ---- The list ----

fn put_fn(out: i64, pos: i64, what: *mut u8, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let file = file_of_pos(pos, pcx);
    buf_str(out, pcx.files[file as usize].path);
    buf_byte(out, b':');
    buf_int(out, line_of(pos, pcx));
    buf_byte(out, b'\t');
    buf_str(out, what);
    buf_byte(out, b'\t');
    put_name(out, pos, tcx, pcx);
    // (why it is inout: the first write in it)
    let w = tcx.write_at.get(pos + 1);
    if w > 0 {
        buf_str(out, c"\twrites at ");
        buf_int(out, line_of(pcx.nodes[(w - 1) as usize].start, pcx));
        buf_byte(out, b' ');
        let wn = w - 1;
        if pcx.nodes[wn as usize].kind == NodeKind::Call && pcx.nodes[wn as usize].x > 0 {
            buf_bytes(out,
                sym_text(pcx.nodes[f_node(pcx.nodes[wn as usize].x - 1, pcx) as usize].a, pcx));
        } else {
            buf_bytes(out,
                &get_src()[
                    pcx.nodes[wn as usize].start as usize..pcx.nodes[wn as usize].end as usize]);
        }
    }
    let u = tcx.first_use.get(pos + 1);
    if u > 0 {
        buf_str(out, c"\tuses ");
        buf_bytes(out, sym_text(tcx.g_fields.get(u - 1), pcx));
    } else if tcx.via.get(pos + 1) > 0 {
        buf_str(out, c"\tvia ");
        put_name(out, tcx.via.get(pos + 1) - 1, tcx, pcx);
    }
    buf_byte(out, b'\n');
}

// The line of position pos in its file.
fn line_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let file = file_of_pos(pos, pcx);
    let mut line: i64 = 1;
    for k in pcx.files[file as usize].start..pos {
        if get_src()[k as usize] == b'\n' {
            line += 1;
        }
    }
    line
}

fn put_name(out: i64, pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let d = def_of_node(tcx.item.get(pos + 1), tcx, pcx);
    if d >= 0 {
        buf_bytes(out, trimmed(sym_text(pcx.defs[d as usize].fqn, pcx)));
    }
}

fn what_of(p: i64, tcx: &Tcx<Comp>) -> *mut u8 {
    if has(p, F_VIEW, tcx) {
        if refused(p, tcx) { c"refused-view" } else { c"view" }
    } else if has(p, F_OWNER, tcx) {
        c"owner"
    } else if has(p, F_TRAIT, tcx) && refused(p, tcx) {
        c"refused-trait"
    } else if has(p, F_VALUE, tcx) && refused(p, tcx) {
        c"refused-value"
    } else if has(p, F_CLASH, tcx) || (has(p, F_LOCAL, tcx) && !has(p, F_HAS, tcx)) {
        c"refused-name"
    } else if has(p, F_GEN, tcx) && refused(p, tcx) {
        c"refused-generated"
    } else if has(p, F_ENTRY, tcx) && refused(p, tcx) {
        c"refused-entry"
    } else if upgraded(p, tcx) {
        c"given-let-to-inout"
    } else if has(p, F_HAS, tcx) {
        if has(p, F_INOUT, tcx) { c"given-inout" } else { c"given-let" }
    } else if has(p, F_INOUT, tcx) {
        c"inout"
    } else {
        c"let"
    }
}

// `fix --only statics`: the group moved; the number of functions given
// the parameter (0 when the group is refused).
pub fn statics_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if tcx.group_file == 0 as *mut u8 {
        let d = diag(c"error", c"fix.statics", tcx);
        buf_str(d, c"--only statics takes --group FILE (the statics, their fields, the parameter and its owners)\n");
        return 0;
    }
    if !read_group(tcx, pcx) {
        return 0;
    }
    if tcx.statics_prune {
        prune(tcx, pcx);
        return 0;
    }
    resolve_group(tcx, pcx);
    walk_all(tcx, pcx);
    close(tcx);
    let mut any_refused = false;
    let out = buf_new();
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        let member = has(p, F_MEMBER, tcx);
        if has(p, F_USES, tcx) {
            tcx.statics_counts[2] += 1;
        }
        if member && !has(p, F_HAS, tcx) {
            tcx.statics_counts[3] += 1;
            if has(p, F_INOUT, tcx) {
                tcx.statics_counts[4] += 1;
            }
        }
        if refused(p, tcx) {
            if !any_refused {
                let d = diag(c"error", c"fix.statics", tcx);
                buf_str(d, c"'");
                put_name(d, p, tcx, pcx);
                buf_str(d, c"' needs the group's context, and no owner gives it (");
                buf_str(d, what_of(p, tcx));
                buf_str(d, c"): nothing is changed\n  help: name an owner above it in the group file, or leave out the statics that reach it (--prune)\n  try: volec fix --only statics-list --group ");
                buf_str(d, tcx.group_file);
                buf_byte(d, b'\n');
            }
            any_refused = true;
        }
        if tcx.statics_list && (member || has(p, F_OWNER, tcx)) {
            put_fn(out, p, what_of(p, tcx), tcx, pcx);
        }
    }
    if tcx.statics_list {
        buf_write_fd(out, STDOUT);
    }
    tcx.statics_refused = any_refused;
    if any_refused {
        return 0;
    }
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        if has(p, F_MEMBER, tcx) {
            edit_params(p, tcx, pcx);
        } else if owner_used(p, tcx) && !has(p, F_LOCAL, tcx) && !has(p, F_VIEW, tcx) {
            edit_owner(p, tcx, pcx);
        }
    }
    for e in 0..tcx.statics_e_from.count {
        let c = tcx.statics_e_from.get(e);
        let g = tcx.statics_e_to.get(e);
        if has(g, F_MEMBER, tcx) && (has(c, F_MEMBER, tcx) || has(c, F_OWNER, tcx))
            && (pcx.nodes[tcx.e_node.get(e) as usize].p & NODE_IMPLICIT) == 0 {
            tcx.statics_cur = c;
            edit_call(tcx.e_node.get(e), g, tcx, pcx);
        }
    }
    for i in 0..tcx.u_node.count {
        edit_use(i, tcx, pcx);
    }
    lend_all(tcx, pcx);
    hoist_all(tcx, pcx);
    flush_edits(tcx, pcx);
    if tcx.statics_counts[0] > 0 {
        delete_statics(tcx, pcx);
        unimport_statics(tcx, pcx);
        import_context(tcx, pcx);
    }
    tcx.statics_counts[3]
}

// Whether owner p makes the context: it uses a static of the group or
// calls a function taking the context.
fn owner_used(p: i64, tcx: &Tcx<Comp>) -> bool {
    if !has(p, F_OWNER, tcx) || tcx.statics_counts[0] == 0 {
        return false;
    }
    if has(p, F_USES, tcx) {
        return true;
    }
    for e in 0..tcx.statics_e_from.count {
        if tcx.statics_e_from.get(e) == p && has(tcx.statics_e_to.get(e), F_MEMBER, tcx) {
            return true;
        }
    }
    false
}

// The end of statement stmt, past its `;`.
fn stmt_end(stmt: i64, pcx: &Ctx<Comp>) -> i64 {
    let e = pcx.nodes[stmt as usize].end;
    if e > 0 && get_src()[(e - 1) as usize] == b';' {
        return e;
    }
    let mut k = e;
    while k < get_src().len() as i64
        && (get_src()[k as usize] == b' ' || get_src()[k as usize] == b'\t') {
        k += 1;
    }
    if k < get_src().len() as i64 && get_src()[k as usize] == b';' { k + 1 } else { e }
}

// Whether function gp, or one it calls up the members, uses field f of the
// context.
fn uses_field(gp: i64, f: i64, used: HMap, head: HMap, next: IntVec, tcx: &Tcx<Comp>) -> bool {
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    stack.push(gp);
    seen.put(gp + 1, 1);
    while stack.count > 0 {
        let p = stack.pop();
        if used.get(p * 4096 + f + 1) != 0 {
            return true;
        }
        let mut e = head.get(p + 1) - 1;
        while e >= 0 {
            let g = tcx.statics_e_to.get(e);
            if has(g, F_MEMBER, tcx) && seen.get(g + 1) == 0 {
                seen.put(g + 1, 1);
                stack.push(g);
            }
            e = next.get(e) - 1;
        }
    }
    false
}

// `f(&X, &NAME)`: X, a static of the group, lent to a call that is to take
// the context too, which is own.conflict once X is `NAME.x`. When f, and
// what it calls, does not use x through the context, the statement takes
// the place's static into a local and puts it back after it (`var NAME_x
// = NAME.x;`, `f(&NAME_x[0], &NAME);`, `NAME.x = NAME_x;`: the whole
// static, as a pointer to an element may reach the others); otherwise,
// or outside a statement, it is left and counted.
fn lend_all(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.b_call.count == 0 {
        return;
    }
    let mut used = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for i in 0..tcx.u_node.count {
        used.put(tcx.u_fn.get(i) * 4096 + tcx.u_field.get(i) + 1, 1);
    }
    let mut head = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut next = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for e in 0..tcx.statics_e_from.count {
        let c = tcx.statics_e_from.get(e);
        next.push(head.get(c + 1));
        head.put(c + 1, e + 1);
    }
    let name = sym_text(tcx.g_param, pcx);
    for i in 0..tcx.b_call.count {
        let call = tcx.b_call.get(i);
        let amp = tcx.b_arg.get(i);
        let c = tcx.b_fn.get(i);
        let stmt = tcx.b_stmt.get(i);
        let g = pcx.nodes[call as usize].x - 1;
        if !editable(g, pcx) {
            continue;
        }
        let gp = pcx.nodes[f_node(g, pcx) as usize].start;
        if !has(gp, F_MEMBER, tcx) || !(has(c, F_MEMBER, tcx) || has(c, F_OWNER, tcx)) {
            continue;
        }
        let key = pcx.nodes[amp as usize].start + (1 << 42);
        if tcx.statics_done.get(-(key + 1)) != 0 {
            continue;
        }
        tcx.statics_done.put(-(key + 1), 1);
        let root = group_root(pcx.nodes[amp as usize].b, tcx, pcx);
        let field = tcx.field_of.get(pcx.nodes[root as usize].y + 1) - 1;
        if stmt == 0 || uses_field(gp, field, used, head, next, tcx) {
            tcx.statics_counts[15] += 1;
            let d = diag(c"note", c"fix.statics", tcx);
            put_fn_at(d, pcx.nodes[amp as usize].start, pcx);
            buf_str(d, c": a static of the group lent beside the context, left (it is used through it, or not in a statement)\n");
            continue;
        }
        // (the whole static is taken, not the lent element or field: a
        // raw pointer to one, `&X[0]` given as `*T`, may reach the rest)
        let place = buf_new();
        let pn = pcx.nodes[amp as usize].b;
        render_inside(place, pcx.nodes[root as usize].start, pcx.nodes[root as usize].end, tcx);
        let rest = buf_new();
        render_inside(rest, pcx.nodes[root as usize].end, pcx.nodes[pn as usize].end, tcx);
        let temp = buf_new();
        buf_bytes(temp, name);
        buf_byte(temp, b'_');
        buf_bytes(temp, sym_text(tcx.g_fields.get(field), pcx));
        let arg = buf_new();
        buf_byte(arg, b'&');
        buf_bytes(arg, buf_slice(temp));
        buf_bytes(arg, buf_slice(rest));
        put_edit(pcx.nodes[amp as usize].start, pcx.nodes[amp as usize].end, arg, tcx);
        let mut line = pcx.nodes[stmt as usize].start;
        while line > 0 && get_src()[(line - 1) as usize] == b' ' {
            line -= 1;
        }
        let before = buf_new();
        buf_str(before, c"var ");
        buf_bytes(before, buf_slice(temp));
        buf_str(before, c" = ");
        buf_bytes(before, buf_slice(place));
        buf_str(before, c";\n");
        buf_bytes(before, &get_src()[line as usize..pcx.nodes[stmt as usize].start as usize]);
        insert(pcx.nodes[stmt as usize].start, before, tcx);
        let after = buf_new();
        buf_byte(after, b'\n');
        buf_bytes(after, &get_src()[line as usize..pcx.nodes[stmt as usize].start as usize]);
        buf_bytes(after, buf_slice(place));
        buf_str(after, c" = ");
        buf_bytes(after, buf_slice(temp));
        buf_byte(after, b';');
        insert(stmt_end(stmt, pcx), after, tcx);
        tcx.statics_counts[13] += 1;
    }
}

// FILE:LINE of position pos, into out.
fn put_fn_at(out: i64, pos: i64, pcx: &Ctx<Comp>) {
    buf_str(out, pcx.files[file_of_pos(pos, pcx) as usize].path);
    buf_byte(out, b':');
    buf_int(out, line_of(pos, pcx));
}

// The group's statics' declarations deleted (their comments with them);
// declarations on adjacent lines in one deletion, so that no blank lines
// are left together.
fn delete_statics(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut heads = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut tails = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    // UNSAFE: STATICS is the checker's table of statics, a raw pointer (front::types).
    // SAFETY: s is below STATIC_COUNT, the table's length.
    unsafe {
        for s in 0..pcx.statics.len() as i64 {
            if tcx.field_of.get(s + 1) == 0 {
                continue;
            }
            let d = def_of_node(pcx.statics[s as usize].node, tcx, pcx);
            if d < 0 {
                continue;
            }
            // (in position order)
            let h = line_start(text_start(d, pcx), pcx);
            let mut k = heads.count;
            heads.push(h);
            tails.push(item_tail(d, tcx, pcx));
            while k > 0 && heads.get(k - 1) > h {
                { let at_arg2 = heads.get(k - 1); heads.set(k, at_arg2) };
                { let at_arg2 = tails.get(k - 1); tails.set(k, at_arg2) };
                k -= 1;
            }
            heads.set(k, h);
            tails.set(k, item_tail(d, tcx, pcx));
        }
    }
    let mut i: i64 = 0;
    while i < heads.count {
        let mut tail = tails.get(i);
        let mut j = i + 1;
        while j < heads.count && heads.get(j) == after_line(tail - 1, pcx) {
            tail = tails.get(j);
            j += 1;
        }
        if delete_lines(heads.get(i), tail, pcx) {
            tcx.statics_counts[10] += j - i;
        }
        i = j;
    }
}

// The module path a Use node's path names (`crate::` taken away; `self`
// and `super` from its module; another first segment, a module of the
// crate's root, or with RELATIVE one of its own module's), into buffer out.
fn use_prefix(out: i64, u: i64, relative: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let path = pcx.nodes[u as usize].c;
    let mut m = trimmed(mod_fqn_text(module_of(u, pcx), tcx, pcx));
    let mut first: i64 = 0;
    if pcx.nodes[path as usize].count > 0 {
        let s0 = sym_text(pcx.nodes[child(path, 0, pcx) as usize].a, pcx);
        if s0 == b"crate" {
            m = b"";
            first = 1;
        } else if s0 == b"self" {
            first = 1;
        } else if s0 == b"super" {
            while first < pcx.nodes[path as usize].count
                && sym_text(pcx.nodes[child(path, first, pcx) as usize].a, pcx) == b"super" {
                let mut e = m.len();
                while e > 0 && m[e - 1] != b':' {
                    e -= 1;
                }
                m = if e >= 2 { &m[0..e - 2] } else { b"" };
                first += 1;
            }
        } else if !relative {
            m = b"";
        }
    }
    buf_bytes(out, m);
    for k in first..pcx.nodes[path as usize].count {
        if buf_slice(out).len() > 0 {
            buf_str(out, c"::");
        }
        buf_bytes(out, sym_text(pcx.nodes[child(path, k, pcx) as usize].a, pcx));
    }
}

// The imports of the group's statics taken out of the `use` lines, a
// `pub use` of one too and the imports through it.
fn unimport_statics(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut moved = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for i in 0..tcx.g_paths.count {
        if tcx.g_dropped.get(i + 1) == 0 {
            moved.put(intern(trimmed(sym_text(tcx.g_paths.get(i), pcx)), pcx) + 1, 1);
        }
    }
    let mut uses = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for u in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[u as usize].kind == NodeKind::Use && pcx.nodes[u as usize].b != 1
            && pcx.nodes[u as usize].count > 0
            && user_file(file_of_pos(pcx.nodes[u as usize].start, pcx), pcx) {
            uses.push(u);
        }
    }
    // (a re-export's path is a path of the static too: `pub use a::X` in m)
    let mut grew = true;
    while grew {
        grew = false;
        for i in 0..uses.count {
            let u = uses.get(i);
            if (pcx.nodes[u as usize].p & ITEM_PUBLIC) == 0 {
                continue;
            }
            for k in 0..pcx.nodes[u as usize].count {
                if imports_moved(u, k, moved, tcx, pcx) {
                    let id = child(u, k, pcx);
                    let local = if pcx.nodes[id as usize].b != 0 { pcx.nodes[id as usize].b }
                        else { pcx.nodes[id as usize].a };
                    let alias = buf_new();
                    buf_bytes(alias, trimmed(mod_fqn_text(module_of(u, pcx), tcx, pcx)));
                    buf_str(alias, c"::");
                    buf_bytes(alias, sym_text(local, pcx));
                    let s = intern(buf_slice(alias), pcx);
                    if moved.get(s + 1) == 0 {
                        moved.put(s + 1, 1);
                        grew = true;
                    }
                }
            }
        }
    }
    for i in 0..uses.count {
        let u = uses.get(i);
        let mut gone = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..pcx.nodes[u as usize].count {
            if imports_moved(u, k, moved, tcx, pcx) {
                gone.push(k);
            }
        }
        if gone.count == pcx.nodes[u as usize].count {
            // (gone whole: add_use puts no line next to it)
            tcx.statics_done.put(-(u + (1 << 44) + 1), 1);
        }
        if gone.count == pcx.nodes[u as usize].count {
            tcx.statics_counts[11] += remove_use_names(u, gone, pcx);
        } else if gone.count > 0 {
            // (the names left, written again: two names next to each other
            // are one edit; `volec fmt` lays the line out)
            let text = buf_new();
            buf_bytes(text,
                &get_src()[
                    pcx.nodes[u as usize].start as usize..pcx.nodes[
                        pcx.nodes[u as usize].c as usize].end as usize]);
            let left = pcx.nodes[u as usize].count - gone.count;
            if left > 1 {
                buf_byte(text, b'{');
            }
            let mut w: i64 = 0;
            for k in 0..pcx.nodes[u as usize].count {
                let mut out_ = false;
                for g in 0..gone.count {
                    if gone.get(g) == k {
                        out_ = true;
                    }
                }
                if !out_ {
                    if w > 0 {
                        buf_str(text, c", ");
                    }
                    let id = child(u, k, pcx);
                    buf_bytes(text,
                        &get_src()[
                            pcx.nodes[id as usize].start as usize..pcx.nodes[id as usize].end as usize]);
                    w += 1;
                }
            }
            if left > 1 {
                buf_byte(text, b'}');
            }
            buf_byte(text, b';');
            if edit_replace(pcx.nodes[u as usize].start, pcx.nodes[u as usize].end, text, pcx) {
                tcx.statics_counts[11] += gone.count;
            }
        }
    }
}

// Whether name k of Use node u imports a path in MOVED (as the crate's or
// as its module's).
fn imports_moved(u: i64, k: i64, moved: HMap, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    for r in 0..2 {
        let full = buf_new();
        use_prefix(full, u, r == 1, tcx, pcx);
        buf_str(full, c"::");
        buf_bytes(full, sym_text(pcx.nodes[child(u, k, pcx) as usize].a, pcx));
        if moved.get(intern(buf_slice(full), pcx) + 1) != 0 {
            return true;
        }
    }
    false
}

// Whether file f is the program's (not std's, not a generated one).
fn user_file(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: f is the index of a loaded file, and every path is NUL-terminated.
    unsafe { f >= 0 && (*pcx.files[f as usize].path.add(0)) != b'<' }
}

// The group's `use PATH` lines added to each file that gives a function
// the parameter or (and `owner-use PATH`) an owner the local, where the
// file does not import the name already nor defines it.
fn import_context(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if tcx.g_uses.count == 0 && tcx.g_owner_uses.count == 0 {
        return;
    }
    // (per file + 1: 1 a member's, 2 an owner's)
    let mut files = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        let f = file_of_pos(p, pcx);
        let want: i64 = if (has(p, F_MEMBER, tcx) && !has(p, F_HAS, tcx))
            || has(p, F_VIEW, tcx) { 1 }
            else if owner_used(p, tcx) && !has(p, F_LOCAL, tcx) { 2 } else { 0 };
        if want == 0 {
            continue;
        }
        if files.get(f + 1) == 0 {
            order.push(f);
        }
        files.put(f + 1, files.get(f + 1) | want);
    }
    let mut uses = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for u in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[u as usize].kind == NodeKind::Use {
            uses.push(u);
        }
    }
    for i in 0..order.count {
        let f = order.get(i);
        let want = files.get(f + 1);
        for j in 0..tcx.g_uses.count + tcx.g_owner_uses.count {
            let owner_only = j >= tcx.g_uses.count;
            if owner_only && (want & 2) == 0 {
                continue;
            }
            let path = if owner_only { tcx.g_owner_uses.get(j - tcx.g_uses.count) }
                else { tcx.g_uses.get(j) };
            add_use(f, path, uses, tcx, pcx);
        }
    }
}

// `use PATH;` added to file f, after its last `use` (else before its
// first item), unless f imports PATH's name or its module defines it.
fn add_use(f: i64, path: i64, uses: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mt = buf_new();
    buf_bytes(mt, trimmed(mod_fqn_text(pcx.files[f as usize].module, tcx, pcx)));
    let p = trimmed(sym_text(path, pcx));
    let mut e = p.len();
    while e > 0 && p[e - 1] != b':' {
        e -= 1;
    }
    let name = &p[e..];
    let module = if e >= 2 { &p[0..e - 2] } else { b"" };
    if buf_slice(mt) == module {
        return;
    }
    let mut last: i64 = -1;
    let mut gone_end: i64 = -1;
    for i in 0..uses.count {
        let u = uses.get(i);
        if file_of_pos(pcx.nodes[u as usize].start, pcx) != f {
            continue;
        }
        for k in 0..pcx.nodes[u as usize].count {
            let id = child(u, k, pcx);
            let local = if pcx.nodes[id as usize].b != 0 { pcx.nodes[id as usize].b }
                else { pcx.nodes[id as usize].a };
            if sym_text(local, pcx) == name {
                return;
            }
        }
        if tcx.statics_done.get(-(u + (1 << 44) + 1)) != 0 && pcx.nodes[u as usize].end > gone_end {
            gone_end = pcx.nodes[u as usize].end;
        }
        if line_start(pcx.nodes[u as usize].start, pcx) == pcx.nodes[u as usize].start
            && pcx.nodes[u as usize].end > last
            && tcx.statics_done.get(-(u + (1 << 44) + 1)) == 0 {
            last = pcx.nodes[u as usize].end;
        }
    }
    let key = f * 1000003 + path + (1 << 43);
    if tcx.statics_done.get(-(key + 1)) != 0 {
        return;
    }
    tcx.statics_done.put(-(key + 1), 1);
    let b = buf_new();
    if last >= 0 {
        buf_str(b, c"\nuse ");
        buf_bytes(b, sym_text(path, pcx));
        buf_byte(b, b';');
        edit_replace(last, last, b, pcx);
    } else {
        // (the first line that is no comment, not blank and no `use` taken
        // out)
        let mut at = if gone_end > 0 { after_line(gone_end - 1, pcx) }
            else { pcx.files[f as usize].start };
        loop {
            let mut k = at;
            while k < pcx.files[f as usize].end
                && (get_src()[k as usize] == b' ' || get_src()[k as usize] == b'\t') {
                k += 1;
            }
            if k < pcx.files[f as usize].end && (get_src()[k as usize] == b'\n'
                || (k + 1 < pcx.files[f as usize].end && get_src()[k as usize] == b'/'
                    && get_src()[(k + 1) as usize] == b'/')
                || (k + 4 < pcx.files[f as usize].end
                    && get_src()[k as usize..(k + 4) as usize] == b"use ")) {
                while k < pcx.files[f as usize].end && get_src()[k as usize] != b'\n' {
                    k += 1;
                }
                at = k + 1;
                continue;
            }
            break;
        }
        buf_str(b, c"use ");
        buf_bytes(b, sym_text(path, pcx));
        buf_str(b, c";\n\n");
        edit_replace(at, at, b, pcx);
    }
    tcx.statics_counts[12] += 1;
}

// The walk's state, for another round.
fn reset_walk(tcx: &mut Tcx<Comp>) {
    tcx.field_of.clear();
    tcx.statics_flags.clear();
    tcx.item.clear();
    tcx.statics_callees.clear();
    tcx.first_use.clear();
    tcx.via.clear();
    tcx.write_at.clear();
    tcx.view_of.clear();
    tcx.statics_items.count = 0;
    tcx.statics_e_from.count = 0;
    tcx.statics_e_to.count = 0;
    tcx.e_node.count = 0;
    tcx.u_node.count = 0;
    tcx.u_field.count = 0;
    tcx.u_fn.count = 0;
    tcx.u_call.count = 0;
    tcx.b_call.count = 0;
    tcx.b_arg.count = 0;
    tcx.b_fn.count = 0;
    tcx.b_stmt.count = 0;
    tcx.h_stmt.count = 0;
    tcx.h_call.count = 0;
    for k in 0..16 {
        tcx.statics_counts[k as usize] = 0;
    }
}

// Whether member p is under one of --prune's prefixes.
fn inside(p: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let d = def_of_node(tcx.item.get(p + 1), tcx, pcx);
    if d < 0 {
        return true;
    }
    let t = trimmed(sym_text(pcx.defs[d as usize].fqn, pcx));
    for i in 0..tcx.prune_prefixes.count {
        let x = trimmed(sym_text(tcx.prune_prefixes.get(i), pcx));
        if x == b"crate" || x.len() == 0 {
            return true;
        }
        if t.len() >= x.len() && t[0..x.len()] == x
            && (t.len() == x.len() || t[x.len()] == b':') {
            return true;
        }
    }
    false
}

// `--prune PREFIX,...`: the group without the statics that make a
// function outside the prefixes, or one refused, take the context. In
// rounds: each such function is followed down its `via`s to the function
// using a static, whose first static is dropped. The group that is left
// is printed, as a group file, the dropped as comments.
fn prune(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut rounds: i64 = 0;
    loop {
        reset_walk(tcx);
        resolve_group(tcx, pcx);
        walk_all(tcx, pcx);
        close(tcx);
        rounds += 1;
        let mut dropped: i64 = 0;
        for i in 0..tcx.statics_items.count {
            let p = tcx.statics_items.get(i);
            if has(p, F_VIEW, tcx) {
                // (a view gives the context let: what is written below it goes)
                if refused(p, tcx) {
                    let f: i64 = if has(p, F_USES, tcx) { tcx.first_use.get(p + 1) - 1 }
                        else { -1 };
                    if f >= 0 && tcx.g_dropped.get(f + 1) == 0 {
                        tcx.g_dropped.put(f + 1, p + 1);
                        dropped += 1;
                    }
                    dropped += view_drop_written(p, tcx, pcx);
                }
                continue;
            }
            if !has(p, F_MEMBER, tcx) || (!refused(p, tcx) && inside(p, tcx, pcx)) {
                continue;
            }
            let mut q = p;
            let mut steps: i64 = 0;
            while tcx.first_use.get(q + 1) == 0 && tcx.via.get(q + 1) > 0 && steps < 100000 {
                q = tcx.via.get(q + 1) - 1;
                steps += 1;
            }
            let f = tcx.first_use.get(q + 1) - 1;
            if f >= 0 && tcx.g_dropped.get(f + 1) == 0 {
                tcx.g_dropped.put(f + 1, p + 1);
                dropped += 1;
            }
        }
        if dropped == 0 {
            break;
        }
    }
    let out = buf_new();
    buf_str(out, c"param ");
    buf_bytes(out, sym_text(tcx.g_param, pcx));
    buf_str(out, c"\ntype ");
    buf_bytes(out, sym_text(tcx.g_type, pcx));
    buf_str(out, c"\ninit ");
    buf_bytes(out, sym_text(tcx.g_init, pcx));
    buf_byte(out, b'\n');
    for i in 0..tcx.g_owners.count {
        buf_str(out, c"owner ");
        buf_bytes(out, sym_text(tcx.g_owners.get(i), pcx));
        buf_byte(out, b'\n');
    }
    for i in 0..tcx.g_views.count {
        buf_str(out, c"view ");
        buf_bytes(out, sym_text(tcx.g_views.get(i), pcx));
        buf_byte(out, b' ');
        buf_bytes(out, sym_text(tcx.g_view_exprs.get(i), pcx));
        buf_byte(out, b'\n');
    }
    for i in 0..tcx.g_uses.count {
        buf_str(out, c"use ");
        buf_bytes(out, sym_text(tcx.g_uses.get(i), pcx));
        buf_byte(out, b'\n');
    }
    for i in 0..tcx.g_owner_uses.count {
        buf_str(out, c"owner-use ");
        buf_bytes(out, sym_text(tcx.g_owner_uses.get(i), pcx));
        buf_byte(out, b'\n');
    }
    let mut kept: i64 = 0;
    for i in 0..tcx.g_paths.count {
        let why = tcx.g_dropped.get(i + 1);
        if why != 0 {
            buf_str(out, c"# dropped ");
        } else {
            kept += 1;
        }
        buf_str(out, c"static ");
        buf_bytes(out, sym_text(tcx.g_paths.get(i), pcx));
        buf_byte(out, b' ');
        buf_bytes(out, sym_text(tcx.g_fields.get(i), pcx));
        if why != 0 {
            buf_str(out, c"\t(reaches ");
            put_name(out, why - 1, tcx, pcx);
            buf_byte(out, b')');
        }
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
    let d = diag(c"note", c"fix.statics", tcx);
    buf_str(d, c"pruned in ");
    buf_int(d, rounds);
    buf_str(d, c" rounds: ");
    buf_int(d, kept);
    buf_str(d, c" of ");
    buf_int(d, tcx.g_paths.count);
    buf_str(d, c" statics kept\n");
    tcx.statics_refused = false;
}

// ---- The arguments taken out ----

fn note_statement(n: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let kind = pcx.nodes[n as usize].kind;
    let e: i64 = if kind == NodeKind::ExprStmt { pcx.nodes[n as usize].a }
        else if kind == NodeKind::Let { pcx.nodes[n as usize].c } else { 0 };
    if e > 0 && pcx.nodes[e as usize].kind == NodeKind::Call && pcx.nodes[e as usize].a == 0
        && pcx.nodes[e as usize].count > 1 {
        tcx.h_stmt.push(n);
        tcx.h_call.push(e);
    }
}

// Whether SRC[a..b] holds `&NAME` (NAME the parameter, a whole word).
fn lends_param(a: i64, b: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let name = sym_text(tcx.g_param, pcx);
    let n = name.len() as i64;
    let mut k = a;
    while k + n < b {
        if get_src()[k as usize] == b'&'
            && get_src()[(k + 1) as usize..(k + 1 + n) as usize] == name {
            let after = if k + 1 + n < get_src().len() as i64 { get_src()[(k + 1 + n) as usize] }
                else { b' ' };
            if !(after == b'_' || (after >= b'a' && after <= b'z')
                || (after >= b'A' && after <= b'Z') || (after >= b'0' && after <= b'9')) {
                return true;
            }
        }
        k += 1;
    }
    false
}

// Whether SRC[a..b] holds a call that will take the context inout (a
// call edited to give `&NAME`).
fn lends_context(a: i64, b: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for e in 0..tcx.statics_e_from.count {
        let n = tcx.e_node.get(e);
        let g = tcx.statics_e_to.get(e);
        if pcx.nodes[n as usize].start >= a && pcx.nodes[n as usize].end <= b
            && has(g, F_MEMBER, tcx) && has(g, F_INOUT, tcx)
            && (has(tcx.statics_e_from.get(e), F_MEMBER, tcx)
                || has(tcx.statics_e_from.get(e), F_OWNER, tcx)) {
            return true;
        }
    }
    false
}

// `P_TARGETS.push(new_block());`: the receiver, a part of the context, is
// lent after the arguments, and an argument changes the context
// (own.conflict, once it is `pbody.targets.push(new_block(&pbody))`): the
// arguments up to the last that changes it become `let`s before the
// statement, in order (`let pbody_arg = new_block(&pbody);`). The
// statement is written whole, with the other edits inside it.
fn hoist_all(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let name = sym_text(tcx.g_param, pcx);
    for i in 0..tcx.h_stmt.count {
        let stmt = tcx.h_stmt.get(i);
        let call = tcx.h_call.get(i);
        let mut recv = child(call, 0, pcx);
        while pcx.nodes[recv as usize].kind == NodeKind::Unary
            && pcx.nodes[recv as usize].op == Tok::Amp {
            recv = pcx.nodes[recv as usize].b;
        }
        let root = place_root(recv, pcx);
        if root <= 0 || pcx.nodes[root as usize].kind != NodeKind::Ident {
            continue;
        }
        let static_ = pcx.nodes[root as usize].res == Res::Static
            && tcx.field_of.get(pcx.nodes[root as usize].y + 1) != 0;
        let local = root != recv && pcx.nodes[root as usize].res == Res::Local
            && sym_text(pcx.nodes[root as usize].a, pcx) == name;
        if !static_ && !local {
            continue;
        }
        // (the arguments as written: within the call)
        let mut last: i64 = 0;
        for k in 1..pcx.nodes[call as usize].count {
            let arg = child(call, k, pcx);
            if pcx.nodes[arg as usize].start < pcx.nodes[recv as usize].end
                || pcx.nodes[arg as usize].end > pcx.nodes[call as usize].end {
                continue;
            }
            let a = pcx.nodes[arg as usize].start;
            let b = pcx.nodes[arg as usize].end;
            if (static_ && (lends_context(a, b, tcx, pcx) || lends_param(a, b, tcx, pcx)))
                || (local && lends_param(a, b, tcx, pcx)) {
                last = k;
            }
        }
        if last == 0 {
            continue;
        }
        let key = pcx.nodes[stmt as usize].start + (1 << 40);
        if tcx.statics_done.get(-(key + 1)) != 0 {
            continue;
        }
        tcx.statics_done.put(-(key + 1), 1);
        // (the statement's indentation)
        let mut line = pcx.nodes[stmt as usize].start;
        while line > 0 && get_src()[(line - 1) as usize] == b' ' {
            line -= 1;
        }
        let text = buf_new();
        let mut at = pcx.nodes[stmt as usize].start;
        let rest = buf_new();
        for k in 1..last + 1 {
            let arg = child(call, k, pcx);
            if pcx.nodes[arg as usize].start < pcx.nodes[recv as usize].end
                || pcx.nodes[arg as usize].end > pcx.nodes[call as usize].end {
                continue;
            }
            let temp = buf_new();
            buf_bytes(temp, name);
            buf_str(temp, c"_arg");
            if k > 1 {
                buf_int(temp, k - 1);
            }
            buf_str(text, c"let ");
            buf_bytes(text, buf_slice(temp));
            buf_str(text, c" = ");
            render(text, pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].end, tcx);
            buf_str(text, c";\n");
            buf_bytes(text, &get_src()[line as usize..pcx.nodes[stmt as usize].start as usize]);
            render(rest, at, pcx.nodes[arg as usize].start, tcx);
            buf_bytes(rest, buf_slice(temp));
            at = pcx.nodes[arg as usize].end;
        }
        render(rest, at, pcx.nodes[stmt as usize].end, tcx);
        buf_bytes(text, buf_slice(rest));
        put_edit(pcx.nodes[stmt as usize].start, pcx.nodes[stmt as usize].end, text, tcx);
        tcx.statics_counts[9] += 1;
    }
}

// The census after a run: `note fix.statics: ...`.
pub fn statics_report(tcx: &mut Tcx<Comp>) {
    if tcx.statics_prune {
        return;
    }
    let d = diag(c"note", c"fix.statics", tcx);
    buf_str(d, c"statics ");
    buf_int(d, tcx.statics_counts[0]);
    buf_str(d, c"; functions using them ");
    buf_int(d, tcx.statics_counts[2]);
    buf_str(d, c", given the parameter ");
    buf_int(d, tcx.statics_counts[3]);
    buf_str(d, c" (inout ");
    buf_int(d, tcx.statics_counts[4]);
    buf_str(d, c"), owners ");
    buf_int(d, tcx.statics_counts[5]);
    buf_str(d, c"; edits: uses ");
    buf_int(d, tcx.statics_counts[1]);
    buf_str(d, c", calls ");
    buf_int(d, tcx.statics_counts[6]);
    buf_str(d, c", parameters ");
    buf_int(d, tcx.statics_counts[7]);
    buf_str(d, c", statements given their arguments as lets ");
    buf_int(d, tcx.statics_counts[9]);
    if tcx.statics_counts[10] + tcx.statics_counts[11] + tcx.statics_counts[12] > 0 {
        buf_str(d, c"; declarations deleted ");
        buf_int(d, tcx.statics_counts[10]);
        buf_str(d, c", imports taken out ");
        buf_int(d, tcx.statics_counts[11]);
        buf_str(d, c", use lines added ");
        buf_int(d, tcx.statics_counts[12]);
    }
    if tcx.statics_counts[14] > 0 {
        buf_str(d, c"; format arguments for holes ");
        buf_int(d, tcx.statics_counts[14]);
    }
    if tcx.statics_counts[13] + tcx.statics_counts[15] > 0 {
        buf_str(d, c"; lent beside the context: taken into locals ");
        buf_int(d, tcx.statics_counts[13]);
        buf_str(d, c", left ");
        buf_int(d, tcx.statics_counts[15]);
    }
    if tcx.statics_counts[8] > 0 {
        buf_str(d, c"; calls left (no argument list found) ");
        buf_int(d, tcx.statics_counts[8]);
    }
    buf_byte(d, b'\n');
}
