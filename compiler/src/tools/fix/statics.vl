// `volec fix --only statics --group FILE` (0.26.4, the plan's item f): a
// group of statics moved into a context struct passed down. The group
// file names the statics, the context's field each becomes, the
// parameter's name and type, and its owners (the functions that make the
// context as a local and pass it on):
//
//   param body                          the parameter's name
//   type Body<Comp>                     its type, as written
//   init body_new()                     an owner's `var body = INIT;`
//   owner crate::places::run_places     (one line each)
//   static crate::places::ir::P_STMTS stmts
//
// A function that names one of the statics uses the context; so does a
// function calling one that does, up to the owners. Each of those takes the
// parameter last (before parameters with a default): `body: inout T` when
// it, or one it calls, writes the context (an assignment to it, `&X`, a
// method of it whose receiver is not a let), `body: T` otherwise. Each
// static's use becomes `body.field`, each call gives `&body` (inout) or
// `body`, and each owner begins with `var body = INIT;`. A second run
// changes nothing: the statics are no longer used.
//
// Refused, and listed: a function needing the context that no owner
// reaches (`main`, a C entry, a function used as a value, a trait's
// method), or one with a local of the parameter's name: the group needs
// another owner. `--only statics-list` (a dry run) lists each function:
// FILE:LINE, inout, let, owner or the refusal, its name, an inout one's
// first write (`writes at LINE push`), and why it needs the context: the
// field it uses (`uses table`), else the callee that made it a caller
// (`via add`).
//
// The context passed last lets a call inside another call's arguments take
// it too (`two(add(1, &body), 2, &body)`); left to the checker: a method on
// one of the context's fields whose argument changes the context.

use crate::base::{
    FILES, IntVec, SRC, STDOUT, SYMS, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, intern, read_file,
};
use crate::base::comp::Comp;
use crate::front::ast::{FN_CLOSURE, FN_DERIVED, NODES, NODE_IMPLICIT, NodeKind, child};
use crate::front::check::Res;
use crate::front::generics::instantiate::{node_field_a, node_field_b, node_field_c};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_of};
use crate::front::types::{
    FNS, FN_COUNT, REF_SHARED, STATICS, STATIC_COUNT, TYPES, TyKind, fn_param,
};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::{after_line, item_tail};
use crate::tools::fix::remove_use_names;
use crate::tools::query::defs::{DEFS, def_of_node, mod_fqn_text};
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::line_start;
use crate::tools::query::show::text_start;

// Per function, keyed by its item's start + 1: an item node of it; set
// when it uses a static of the group (F_USES), writes one (F_WRITES), is
// an owner, takes the parameter, takes it inout, is called, is used as a
// value, is a trait's.
const F_USES: i64 = 1;
const F_WRITES: i64 = 2;
const F_OWNER: i64 = 4;
const F_MEMBER: i64 = 8;
const F_INOUT: i64 = 16;
const F_CALLED: i64 = 32;
const F_VALUE: i64 = 64;
const F_TRAIT: i64 = 128;
const F_ENTRY: i64 = 256;
const F_CLASH: i64 = 512;
// (0.26.5) It has the parameter already (a context given before: `NAME:
// TYPE`), inout; it has a local of the name (an owner's, made before).
const F_HAS: i64 = 1024;
const F_HAS_INOUT: i64 = 2048;
const F_LOCAL: i64 = 4096;
// (0.26.5) It is in a generated file (its first line `// Generated by`).
const F_GEN: i64 = 8192;

fn flags(pos: i64, tcx: Tcx<Comp>) -> i64 {
    tcx.statics_flags.get(pos + 1)
}

fn set(pos: i64, bits: i64, tcx: inout Tcx<Comp>) {
    tcx.statics_flags.put(pos + 1, flags(pos, tcx) | bits);
}

fn has(pos: i64, bits: i64, tcx: Tcx<Comp>) -> bool {
    (flags(pos, tcx) & bits) != 0
}

// "crate::a::b" and "a::b" are the same path.
fn trimmed(s: [u8]) -> [u8] {
    if s.len() >= 7 && s[0..7] == "crate::" { s[7..] } else { s }
}

fn path_is(sym: i64, want: i64) -> bool {
    sym >= 0 && trimmed(SYMS[sym].text) == trimmed(SYMS[want].text)
}

fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// ---- The group file ----

// Reads GROUP_FILE; false (with an error) when it is not a group.
fn read_group(tcx: inout Tcx<Comp>) -> bool {
    let b = buf_new();
    read_file(tcx.group_file, b);
    let s = buf_slice(b);
    var k: usize = 0;
    var ok = true;
    while k < s.len() {
        var e: usize = k;
        while e < s.len() && s[e] != '\n' {
            e += 1;
        }
        let line = s[k..e];
        k = e + 1;
        var a: usize = 0;
        while a < line.len() && is_space(line[a]) {
            a += 1;
        }
        if a == line.len() || line[a] == '#' {
            continue;
        }
        var w: usize = a;
        while w < line.len() && !is_space(line[w]) {
            w += 1;
        }
        let word = line[a..w];
        var r: usize = w;
        while r < line.len() && is_space(line[r]) {
            r += 1;
        }
        var z: usize = line.len();
        while z > r && is_space(line[z - 1]) {
            z -= 1;
        }
        let rest = line[r..z];
        if word == "param" {
            tcx.g_param = intern(rest);
        } else if word == "type" {
            tcx.g_type = intern(rest);
        } else if word == "init" {
            tcx.g_init = intern(rest);
        } else if word == "owner" {
            tcx.g_owners.push(intern(rest));
        } else if word == "use" {
            tcx.g_uses.push(intern(rest));
        } else if word == "owner-use" {
            tcx.g_owner_uses.push(intern(rest));
        } else if word == "static" {
            var m: usize = 0;
            while m < rest.len() && !is_space(rest[m]) {
                m += 1;
            }
            var f: usize = m;
            while f < rest.len() && is_space(rest[f]) {
                f += 1;
            }
            if f == rest.len() {
                ok = false;
            } else {
                tcx.g_paths.push(intern(rest[0..m]));
                tcx.g_fields.push(intern(rest[f..]));
            }
        } else {
            ok = false;
        }
    }
    if !ok || tcx.g_param < 0 || tcx.g_type < 0 || tcx.g_init < 0 || tcx.g_paths.count == 0 {
        let d = diag(c"error", c"fix.statics", &tcx);
        buf_str(d, c"--group takes a file of `param NAME`, `type TYPE`, `init EXPR`, `owner PATH`, `use PATH`, `owner-use PATH` and `static PATH FIELD` lines\n");
        return false;
    }
    true
}

// The group's statics, by their ids (those --prune dropped left out).
fn resolve_group(tcx: inout Tcx<Comp>) {
    // UNSAFE: STATICS is the checker's table of statics, a raw pointer (front::types).
    // SAFETY: s is below STATIC_COUNT, the table's length.
    unsafe {
        for s in 0..STATIC_COUNT {
            let d = def_of_node(STATICS[s].node, tcx);
            if d < 0 {
                continue;
            }
            for i in 0..tcx.g_paths.count {
                if tcx.g_dropped.get(i + 1) == 0 && path_is(DEFS[d].fqn, tcx.g_paths.get(i)) {
                    tcx.field_of.put(s + 1, i + 1);
                    tcx.statics_counts[0] += 1;
                }
            }
        }
    }
}

// ---- The walk ----

fn f_node(f: i64) -> i64 {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer (front::types).
    // SAFETY: f is below FN_COUNT, the table's length, wherever this is called.
    unsafe { FNS[f].node }
}

fn f_extern(f: i64) -> bool {
    // UNSAFE: FNS is the checker's table of functions, a raw pointer.
    // SAFETY: f is below FN_COUNT, the table's length.
    unsafe { FNS[f].is_extern }
}

// Whether f is a function of the program with a body to edit (not std's,
// not a closure's or a derived one).
fn editable(f: i64) -> bool {
    if f < 0 || f >= FN_COUNT || f_extern(f) {
        return false;
    }
    let item = f_node(f);
    if item <= 0 || NODES[item].kind != NodeKind::Fn || NODES[item].c == 0 {
        return false;
    }
    if (NODES[item].p & (FN_CLOSURE | FN_DERIVED)) != 0 {
        return false;
    }
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: file_of_pos gives the index of a loaded file, and every path is NUL-terminated.
    unsafe { FILES[file_of_pos(NODES[item].start)].path[0] != '<' }
}

// The root of a place: through fields, indexes, tuple fields and `&` (a
// receiver's, the checker's own).
fn place_root(n: i64) -> i64 {
    var t = n;
    while t > 0 {
        let k = NODES[t].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::Index || k == NodeKind::TupleField {
            t = NODES[t].a;
        } else if k == NodeKind::Unary && NODES[t].op == Tok::Amp {
            t = NODES[t].b;
        } else {
            break;
        }
    }
    t
}

// The static of the group a place is rooted at (through fields, indexes
// and tuple fields): its Ident node, or 0.
fn group_root(n: i64, tcx: Tcx<Comp>) -> i64 {
    let t = place_root(n);
    if t > 0 && NODES[t].kind == NodeKind::Ident && NODES[t].res == Res::Static
        && tcx.field_of.get(NODES[t].y + 1) != 0 {
        return t;
    }
    0
}

// Whether method g changes its receiver: the program's, by its checked
// type (an inout one or a raw pointer); std's, whose `self` is a
// reference in std's spelling whatever the method does, by its name (the
// ones that only read: `len`, `get`, `iter`, ...).
fn receiver_writes(g: i64) -> bool {
    if in_std(g) {
        let name = SYMS[NODES[f_node(g)].a].text;
        return !(name == "len" || name == "is_empty" || name == "get" || name == "as_slice"
            || name == "iter" || name == "contains" || name == "first" || name == "last"
            || name == "capacity" || name == "as_ptr" || name == "clone" || name == "starts_with"
            || name == "ends_with" || name == "to_vec" || name == "eq" || name == "slice"
            || name == "as_bytes" || name == "as_str" || name == "index" || name == "ne"
            || name == "fmt" || name == "hash");
    }
    let t = fn_param(g, 0);
    if t <= 0 {
        return true;
    }
    TYPES[t].kind == TyKind::Ptr && TYPES[t].b != REF_SHARED
}

// Whether function g is std's.
fn in_std(g: i64) -> bool {
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: file_of_pos gives the index of a loaded file, and every path is NUL-terminated.
    unsafe { FILES[file_of_pos(NODES[f_node(g)].start)].path[0] == '<' }
}

// Node n writes the context in the function walked.
fn wrote(n: i64, tcx: inout Tcx<Comp>) {
    set(tcx.statics_cur, F_WRITES, &tcx);
    if tcx.write_at.get(tcx.statics_cur + 1) == 0 {
        tcx.write_at.put(tcx.statics_cur + 1, n + 1);
    }
}

fn walk(n: i64, tcx: inout Tcx<Comp>) {
    if n <= 0 {
        return;
    }
    let kind = NODES[n].kind;
    let saved_stmt = tcx.statics_stmt;
    let saved_call = tcx.statics_call;
    let saved_interp = tcx.statics_interp;
    if kind == NodeKind::Interp && saved_interp == 0 {
        tcx.statics_interp = n;
    }
    if kind == NodeKind::ExprStmt || kind == NodeKind::Let {
        note_statement(n, &tcx);
        tcx.statics_stmt = n;
    }
    // (a name the parameter would shadow or be shadowed by; the parameter
    // itself, given before, of the group's type)
    if (kind == NodeKind::PatBind || kind == NodeKind::Param) && NODES[n].a == tcx.g_param {
        var io = false;
        if kind == NodeKind::Param && param_of_group(n, &io, tcx) {
            set(tcx.statics_cur, if io { F_HAS | F_HAS_INOUT | F_INOUT } else { F_HAS }, &tcx);
        } else if kind == NodeKind::PatBind {
            set(tcx.statics_cur, F_LOCAL, &tcx);
        } else {
            set(tcx.statics_cur, F_CLASH, &tcx);
        }
    }
    if kind == NodeKind::Ident {
        let y = NODES[n].y;
        if NODES[n].res == Res::Static && tcx.field_of.get(y + 1) != 0 {
            tcx.u_node.push(n);
            tcx.u_field.push(tcx.field_of.get(y + 1) - 1);
            tcx.u_fn.push(tcx.statics_cur);
            let i = tcx.statics_interp;
            let hole = i > 0 && NODES[n].start >= NODES[i].start && NODES[n].end <= NODES[i].end
                && hole_at(n);
            tcx.u_call.push(if hole { i } else { 0 });
            if tcx.first_use.get(tcx.statics_cur + 1) == 0 {
                tcx.first_use.put(tcx.statics_cur + 1, tcx.field_of.get(y + 1));
            }
            set(tcx.statics_cur, F_USES, &tcx);
        } else if NODES[n].res == Res::Fn && tcx.statics_callees.get(n + 1) == 0 && editable(y) {
            set(NODES[f_node(y)].start, F_VALUE, &tcx);
        }
    } else if kind == NodeKind::Assign {
        if group_root(NODES[n].b, tcx) != 0 {
            wrote(n, &tcx);
        }
    } else if kind == NodeKind::Unary && NODES[n].op == Tok::Amp && SRC[NODES[n].start] == '&' {
        // (a `&` written: the checker's own, a receiver's, are not)
        if group_root(NODES[n].b, tcx) != 0 {
            wrote(n, &tcx);
            // (lent to the innermost call: lend_all)
            if tcx.statics_call != 0 && tcx.statics_interp == 0 {
                tcx.b_call.push(tcx.statics_call);
                tcx.b_arg.push(n);
                tcx.b_fn.push(tcx.statics_cur);
                tcx.b_stmt.push(tcx.statics_stmt);
            }
        }
    } else if kind == NodeKind::Call {
        let g = NODES[n].x - 1;
        if NODES[n].a != 0 {
            tcx.statics_callees.put(NODES[n].a + 1, 1);
        } else if NODES[n].count > 0 && group_root(child(n, 0), tcx) != 0 {
            // (a method of the context's field: a write unless its receiver is a let)
            if receiver_writes(g) {
                wrote(n, &tcx);
            }
        }
        if editable(g) {
            tcx.statics_e_from.push(tcx.statics_cur);
            tcx.statics_e_to.push(NODES[f_node(g)].start);
            tcx.e_node.push(n);
        }
        if tcx.statics_interp == 0 {
            tcx.statics_call = n;
        }
    }
    if node_field_a(kind) {
        walk(NODES[n].a, &tcx);
    }
    if node_field_b(kind) {
        walk(NODES[n].b, &tcx);
    }
    if node_field_c(kind) {
        walk(NODES[n].c, &tcx);
    }
    if kind == NodeKind::For || kind == NodeKind::Param {
        walk(NODES[n].d, &tcx);
    }
    // (a format literal's and a `?`'s checked form: the calls in it are
    // resolved there; a static in a literal's hole is named by the call
    // the literal is given to)
    if kind == NodeKind::Interp || kind == NodeKind::Try {
        walk(NODES[n].y, &tcx);
    }
    for i in 0..NODES[n].count {
        walk(child(n, i), &tcx);
    }
    tcx.statics_call = saved_call;
    tcx.statics_stmt = saved_stmt;
    tcx.statics_interp = saved_interp;
}

// Whether Ident n is a format literal's hole, `{NAME}` or `{NAME:..}`.
fn hole_at(n: i64) -> bool {
    let a = NODES[n].start;
    let b = NODES[n].end;
    a > 0 && SRC[a - 1] == '{' && b < SRC.len() as i64 && (SRC[b] == '}' || SRC[b] == ':')
}

// Whether Param node n is `NAME: TYPE` or `NAME: inout TYPE`, TYPE the
// group's (a context given before); IO: whether it is inout.
fn param_of_group(n: i64, io: inout bool, tcx: Tcx<Comp>) -> bool {
    let at = param_type_at(n);
    io = false;
    if at < 0 {
        return false;
    }
    var k = at;
    if k + 6 <= NODES[n].end && SRC[k..k + 6] == "inout " {
        io = true;
        k += 6;
    }
    var e = NODES[n].end;
    while e > k && is_space(SRC[e - 1]) {
        e -= 1;
    }
    SRC[k..e] == SYMS[tcx.g_type].text
}

// The position of Param node n's type (after its `:`), or -1.
fn param_type_at(n: i64) -> i64 {
    var k = NODES[n].start;
    while k < NODES[n].end && SRC[k] != ':' {
        k += 1;
    }
    if k >= NODES[n].end {
        return -1;
    }
    k += 1;
    while k < NODES[n].end && is_space(SRC[k]) {
        k += 1;
    }
    k
}

// Every function of the program (each instance of a generic one: its
// checked copy), walked.
fn walk_all(tcx: inout Tcx<Comp>) {
    for f in 0..FN_COUNT {
        if !editable(f) {
            continue;
        }
        let item = f_node(f);
        let pos = NODES[item].start;
        if tcx.item.get(pos + 1) == 0 {
            tcx.item.put(pos + 1, item);
            tcx.statics_items.push(pos);
            let d = def_of_node(item, tcx);
            if d >= 0 {
                for i in 0..tcx.g_owners.count {
                    if path_is(DEFS[d].fqn, tcx.g_owners.get(i)) {
                        set(pos, F_OWNER, &tcx);
                    }
                }
                if DEFS[d].tr >= 0 {
                    set(pos, F_TRAIT, &tcx);
                }
                if trimmed(SYMS[DEFS[d].fqn].text) == "main" || NODES[item].y == 1 {
                    set(pos, F_ENTRY, &tcx);
                }
                let fs = FILES[file_of_pos(pos)].start;
                if fs + 15 <= SRC.len() as i64 && SRC[fs..fs + 15] == "// Generated by" {
                    set(pos, F_GEN, &tcx);
                }
            }
        }
        tcx.statics_cur = pos;
        for j in 0..NODES[item].count {
            walk(child(item, j), &tcx);
        }
        walk(NODES[item].c, &tcx);
    }
}

// The functions that take the parameter: the users and, up the calls,
// their callers, the owners left out; then which take it inout. VIA: for
// a caller, the callee that made it one (its item's start + 1), for the
// list's `via NAME`.
fn close(tcx: inout Tcx<Comp>) {
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        if has(p, F_USES, tcx) && !has(p, F_OWNER, tcx) {
            set(p, F_MEMBER, &tcx);
        }
        if has(p, F_WRITES, tcx) {
            set(p, F_INOUT, &tcx);
        }
    }
    var changed = true;
    while changed {
        changed = false;
        for e in 0..tcx.statics_e_from.count {
            let c = tcx.statics_e_from.get(e);
            let g = tcx.statics_e_to.get(e);
            if !has(g, F_MEMBER, tcx) {
                continue;
            }
            set(g, F_CALLED, &tcx);
            if !has(c, F_MEMBER, tcx) && !has(c, F_OWNER, tcx) {
                set(c, F_MEMBER, &tcx);
                tcx.via.put(c + 1, g + 1);
                changed = true;
            }
            if has(g, F_INOUT, tcx) && !has(c, F_INOUT, tcx) {
                set(c, F_INOUT, &tcx);
                changed = true;
            }
        }
    }
}

// Whether member p is refused: nothing calls it, or it is a value, a
// trait's method or a generated file's (when it is to take the parameter, or a given one is
// to become inout), or a name is in the way.
fn refused(p: i64, tcx: Tcx<Comp>) -> bool {
    if !has(p, F_MEMBER, tcx) {
        return false;
    }
    if has(p, F_CLASH, tcx) || (has(p, F_LOCAL, tcx) && !has(p, F_HAS, tcx)) {
        return true;
    }
    let changes = !has(p, F_HAS, tcx) || upgraded(p, tcx);
    changes && (has(p, F_ENTRY, tcx) || has(p, F_VALUE, tcx) || has(p, F_TRAIT, tcx)
        || has(p, F_GEN, tcx))
}

// Whether p takes the context let already and now needs it inout.
fn upgraded(p: i64, tcx: Tcx<Comp>) -> bool {
    has(p, F_HAS, tcx) && has(p, F_INOUT, tcx) && !has(p, F_HAS_INOUT, tcx)
}

// Function item's Param node named NAME, or 0.
fn param_named(item: i64, name: i64) -> i64 {
    for j in 0..NODES[item].count {
        let p = child(item, j);
        if NODES[p].kind == NodeKind::Param && NODES[p].a == name {
            return p;
        }
    }
    0
}

// The index among function item's parameters of the one named by the
// identifier at s (a named argument's), or -1.
fn named_index(item: i64, s: i64) -> i64 {
    var e = s;
    while e < SRC.len() as i64 && (SRC[e] == '_' || (SRC[e] >= 'a' && SRC[e] <= 'z')
        || (SRC[e] >= 'A' && SRC[e] <= 'Z') || (SRC[e] >= '0' && SRC[e] <= '9')) {
        e += 1;
    }
    var k = 0;
    for j in 0..NODES[item].count {
        let p = child(item, j);
        if NODES[p].kind == NodeKind::Param {
            if SYMS[NODES[p].a].text == SRC[s..e] {
                return k;
            }
            k += 1;
        }
    }
    -1
}

// ---- The edits ----

// The index the parameter takes in function item's parameters: before the
// first with a default, else last; and the Param nodes' count.
fn param_index(item: i64, count: inout i64) -> i64 {
    var k = -1;
    count = 0;
    for j in 0..NODES[item].count {
        let p = child(item, j);
        if NODES[p].kind != NodeKind::Param {
            continue;
        }
        if NODES[p].h != 0 && k < 0 {
            k = count;
        }
        count += 1;
    }
    if k < 0 { count } else { k }
}

fn param_at(item: i64, i: i64) -> i64 {
    var k = 0;
    for j in 0..NODES[item].count {
        let p = child(item, j);
        if NODES[p].kind == NodeKind::Param {
            if k == i {
                return p;
            }
            k += 1;
        }
    }
    0
}

// The position after the first `(` at or after pos.
fn after_paren(pos: i64) -> i64 {
    var k = pos;
    while k < SRC.len() as i64 && SRC[k] != '(' {
        k += 1;
    }
    k + 1
}

fn put_edit(a: i64, b: i64, text: i64, tcx: inout Tcx<Comp>) {
    tcx.x_start.push(a);
    tcx.x_end.push(b);
    tcx.statics_x_text.push(text);
}

fn insert(pos: i64, text: i64, tcx: inout Tcx<Comp>) {
    put_edit(pos, pos, text, &tcx);
}

// SRC[a..b] with the recorded edits inside it made (in position order,
// insertions at one position in their order), into out; those edits are
// taken.
fn render(out: i64, a: i64, b: i64, tcx: inout Tcx<Comp>) {
    var at = a;
    loop {
        // (the next edit at or after `at`: the first recorded among those
        // starting first)
        var best = -1;
        for i in 0..tcx.x_start.count {
            let s = tcx.x_start.get(i);
            if tcx.statics_x_text.get(i) < 0 || s < at || tcx.x_end.get(i) > b || s > b {
                continue;
            }
            if best < 0 || s < tcx.x_start.get(best) {
                best = i;
            }
        }
        if best < 0 {
            break;
        }
        let s = tcx.x_start.get(best);
        buf_bytes(out, SRC[at..s]);
        buf_bytes(out, buf_slice(tcx.statics_x_text.get(best)));
        at = tcx.x_end.get(best);
        tcx.statics_x_text.set(best, -1);
    }
    buf_bytes(out, SRC[at..b]);
}

fn flush_edits(tcx: Tcx<Comp>) {
    for i in 0..tcx.x_start.count {
        if tcx.statics_x_text.get(i) >= 0 {
            edit_replace(tcx.x_start.get(i), tcx.x_end.get(i), tcx.statics_x_text.get(i));
        }
    }
}

// The parameter's text: `NAME: inout TYPE` or `NAME: TYPE`.
fn param_text(b: i64, inout_: bool, tcx: Tcx<Comp>) {
    buf_bytes(b, SYMS[tcx.g_param].text);
    buf_str(b, if inout_ { c": inout " } else { c": " });
    buf_bytes(b, SYMS[tcx.g_type].text);
}

fn edit_params(pos: i64, tcx: inout Tcx<Comp>) {
    let item = tcx.item.get(pos + 1);
    if has(pos, F_HAS, tcx) {
        // (given before: `inout` when it now changes the context)
        if upgraded(pos, tcx) {
            let p = param_named(item, tcx.g_param);
            let b = buf_new();
            buf_str(b, c"inout ");
            insert(param_type_at(p), b, &tcx);
            tcx.statics_counts[7] += 1;
        }
        return;
    }
    var count = 0;
    let k = param_index(item, &count);
    let b = buf_new();
    let inout_ = has(pos, F_INOUT, tcx);
    if k < count {
        param_text(b, inout_, tcx);
        buf_str(b, c", ");
        insert(NODES[param_at(item, k)].start, b, &tcx);
    } else if count > 0 {
        buf_str(b, c", ");
        param_text(b, inout_, tcx);
        insert(NODES[param_at(item, count - 1)].end, b, &tcx);
    } else {
        param_text(b, inout_, tcx);
        // (the `(` after the name)
        let name = SYMS[NODES[item].a].text;
        var at = NODES[item].start;
        while at + name.len() as i64 <= SRC.len() as i64
            && SRC[at..at + name.len() as i64] != name {
            at += 1;
        }
        insert(after_paren(at + name.len() as i64), b, &tcx);
    }
    tcx.statics_counts[7] += 1;
}

// The argument a call of g gives in function c: `&NAME` or `NAME`.
fn arg_text(b: i64, g: i64, tcx: Tcx<Comp>) {
    if has(g, F_INOUT, tcx) {
        buf_byte(b, '&');
    }
    buf_bytes(b, SYMS[tcx.g_param].text);
}

// Past a string or character literal starting at k (its quote).
fn skip_literal(k: i64) -> i64 {
    let q = SRC[k];
    var i = k + 1;
    while i < SRC.len() as i64 && SRC[i] != q {
        if SRC[i] == '\\' {
            i += 1;
        }
        i += 1;
    }
    i + 1
}

fn push_segment(a: i64, b: i64, tcx: inout Tcx<Comp>) {
    var s = a;
    var e = b;
    while s < e && is_space(SRC[s]) {
        s += 1;
    }
    while e > s && is_space(SRC[e - 1]) {
        e -= 1;
    }
    if s < e {
        tcx.seg_start.push(s);
        tcx.seg_end.push(e);
    }
}

// The segments of the argument list opening at open (after its `(`); the
// position of its `)`, or -1.
fn split_args(open: i64, tcx: inout Tcx<Comp>) -> i64 {
    tcx.seg_start.count = 0;
    tcx.seg_end.count = 0;
    var depth = 0;
    var seg = open;
    var k = open;
    while k < SRC.len() as i64 {
        let c = SRC[k];
        if c == '"' || (c == '\'' && k + 2 < SRC.len() as i64
            && (SRC[k + 2] == '\'' || SRC[k + 1] == '\\')) {
            k = skip_literal(k);
            continue;
        }
        if c == '/' && k + 1 < SRC.len() as i64 && SRC[k + 1] == '/' {
            while k < SRC.len() as i64 && SRC[k] != '\n' {
                k += 1;
            }
            continue;
        }
        if c == '(' || c == '[' || c == '{' {
            depth += 1;
        } else if c == ')' || c == ']' || c == '}' {
            if depth == 0 {
                push_segment(seg, k, &tcx);
                return k;
            }
            depth -= 1;
        } else if c == ',' && depth == 0 {
            push_segment(seg, k, &tcx);
            seg = k + 1;
        }
        k += 1;
    }
    -1
}

// Whether the segment at s is a named argument (`name: value`).
fn named_at(s: i64) -> bool {
    var k = s;
    while k < SRC.len() as i64 && (SRC[k] == '_' || (SRC[k] >= 'a' && SRC[k] <= 'z')
        || (SRC[k] >= 'A' && SRC[k] <= 'Z') || (SRC[k] >= '0' && SRC[k] <= '9')) {
        k += 1;
    }
    if k == s {
        return false;
    }
    while k < SRC.len() as i64 && SRC[k] == ' ' {
        k += 1;
    }
    k + 1 < SRC.len() as i64 && SRC[k] == ':' && SRC[k + 1] != ':'
}

fn edit_call(n: i64, g: i64, tcx: inout Tcx<Comp>) {
    let key = NODES[n].start * 4096 + (NODES[n].end - NODES[n].start) % 4096;
    if tcx.statics_done.get(key + 1) != 0 {
        return;
    }
    tcx.statics_done.put(key + 1, 1);
    let method = NODES[n].a == 0;
    let from = if method { NODES[child(n, 0)].end } else { NODES[NODES[n].a].end };
    let open = after_paren(from);
    if split_args(open, &tcx) < 0 {
        tcx.statics_counts[8] += 1;
        return;
    }
    let segs = tcx.seg_start.count;
    let name = SYMS[tcx.g_param].text;
    if has(g, F_HAS, tcx) {
        // (it takes the context already: given `&NAME` when it now changes it)
        if upgraded(g, tcx) {
            for s in 0..segs {
                var v = tcx.seg_start.get(s);
                if named_at(v) {
                    while SRC[v] != ':' {
                        v += 1;
                    }
                    v += 1;
                    while is_space(SRC[v]) {
                        v += 1;
                    }
                }
                if SRC[v..tcx.seg_end.get(s)] == name {
                    let b = buf_new();
                    buf_byte(b, '&');
                    insert(v, b, &tcx);
                    tcx.statics_counts[6] += 1;
                }
            }
        }
        return;
    }
    var count = 0;
    let item = tcx.item.get(g + 1);
    let k = param_index(item, &count);
    // (the index among the arguments written in the parentheses)
    let at = if method { k - 1 } else { k };
    var positional = 0;
    while positional < segs && !named_at(tcx.seg_start.get(positional)) {
        positional += 1;
    }
    let b = buf_new();
    if segs == 0 {
        arg_text(b, g, tcx);
        insert(open, b, &tcx);
    } else if at < positional {
        arg_text(b, g, tcx);
        buf_str(b, c", ");
        insert(tcx.seg_start.get(at), b, &tcx);
    } else if positional < segs {
        // (named arguments follow the parameters' order: the context
        // named, before the first whose parameter comes after it)
        var before = -1;
        for s in positional..segs {
            if before < 0 && named_index(item, tcx.seg_start.get(s)) >= k {
                before = s;
            }
        }
        if before < 0 {
            buf_str(b, c", ");
        }
        buf_bytes(b, name);
        buf_str(b, c": ");
        arg_text(b, g, tcx);
        if before >= 0 {
            buf_str(b, c", ");
            insert(tcx.seg_start.get(before), b, &tcx);
        } else {
            insert(tcx.seg_end.get(segs - 1), b, &tcx);
        }
    } else {
        buf_str(b, c", ");
        arg_text(b, g, tcx);
        insert(tcx.seg_end.get(segs - 1), b, &tcx);
    }
    tcx.statics_counts[6] += 1;
}

// Use i (u_node) as the context's field: `NAME.field`; in a format
// literal's hole, `{field}` and the named argument `field = NAME.field`
// given to the literal's call (once per call and field).
fn edit_use(i: i64, tcx: inout Tcx<Comp>) {
    let n = tcx.u_node.get(i);
    let field = tcx.u_field.get(i);
    let lit = tcx.u_call.get(i);
    let key = NODES[n].start;
    if tcx.statics_done.get(-(key + 1)) != 0 {
        return;
    }
    tcx.statics_done.put(-(key + 1), 1);
    let fname = SYMS[tcx.g_fields.get(field)].text;
    let b = buf_new();
    if lit > 0 {
        buf_bytes(b, fname);
        put_edit(NODES[n].start, NODES[n].end, b, &tcx);
        // (the call the literal is given to: its `(` before the literal, at
        // depth 0, and its `)`)
        var open = NODES[n].start - 1;
        while open > 0 && !(SRC[open] == '"' && SRC[open - 1] != '\\') {
            open -= 1;
        }
        open -= 1;
        var depth = 0;
        while open > 0 && !(depth == 0 && SRC[open] == '(') {
            if SRC[open] == ')' || SRC[open] == ']' {
                depth += 1;
            } else if SRC[open] == '(' || SRC[open] == '[' {
                depth -= 1;
            }
            open -= 1;
        }
        let close = split_args(open + 1, &tcx);
        let k2 = open * 4096 + field + (1 << 41);
        if close > 0 && tcx.statics_done.get(-(k2 + 1)) == 0 {
            tcx.statics_done.put(-(k2 + 1), 1);
            let a = buf_new();
            buf_str(a, c", ");
            buf_bytes(a, fname);
            buf_str(a, c" = ");
            buf_bytes(a, SYMS[tcx.g_param].text);
            buf_byte(a, '.');
            buf_bytes(a, fname);
            insert(close, a, &tcx);
            tcx.statics_counts[14] += 1;
        }
    } else {
        buf_bytes(b, SYMS[tcx.g_param].text);
        buf_byte(b, '.');
        buf_bytes(b, fname);
        put_edit(NODES[n].start, NODES[n].end, b, &tcx);
    }
    tcx.statics_counts[1] += 1;
}

// An owner's local, at the start of its body.
fn edit_owner(pos: i64, tcx: inout Tcx<Comp>) {
    let item = tcx.item.get(pos + 1);
    let body = NODES[item].c;
    let b = buf_new();
    buf_str(b, c"\n    var ");
    buf_bytes(b, SYMS[tcx.g_param].text);
    buf_str(b, c" = ");
    buf_bytes(b, SYMS[tcx.g_init].text);
    buf_byte(b, ';');
    insert(NODES[body].start + 1, b, &tcx);
    tcx.statics_counts[5] += 1;
}

// ---- The list ----

fn put_fn(out: i64, pos: i64, what: *u8, tcx: Tcx<Comp>) {
    let file = file_of_pos(pos);
    buf_str(out, FILES[file].path);
    buf_byte(out, ':');
    buf_int(out, line_of(pos));
    buf_byte(out, '\t');
    buf_str(out, what);
    buf_byte(out, '\t');
    put_name(out, pos, tcx);
    // (why it is inout: the first write in it)
    let w = tcx.write_at.get(pos + 1);
    if w > 0 {
        buf_str(out, c"\twrites at ");
        buf_int(out, line_of(NODES[w - 1].start));
        buf_byte(out, ' ');
        let wn = w - 1;
        if NODES[wn].kind == NodeKind::Call && NODES[wn].x > 0 {
            buf_bytes(out, SYMS[NODES[f_node(NODES[wn].x - 1)].a].text);
        } else {
            buf_bytes(out, SRC[NODES[wn].start..NODES[wn].end]);
        }
    }
    let u = tcx.first_use.get(pos + 1);
    if u > 0 {
        buf_str(out, c"\tuses ");
        buf_bytes(out, SYMS[tcx.g_fields.get(u - 1)].text);
    } else if tcx.via.get(pos + 1) > 0 {
        buf_str(out, c"\tvia ");
        put_name(out, tcx.via.get(pos + 1) - 1, tcx);
    }
    buf_byte(out, '\n');
}

// The line of position pos in its file.
fn line_of(pos: i64) -> i64 {
    let file = file_of_pos(pos);
    var line = 1;
    for k in FILES[file].start..pos {
        if SRC[k] == '\n' {
            line += 1;
        }
    }
    line
}

fn put_name(out: i64, pos: i64, tcx: Tcx<Comp>) {
    let d = def_of_node(tcx.item.get(pos + 1), tcx);
    if d >= 0 {
        buf_bytes(out, trimmed(SYMS[DEFS[d].fqn].text));
    }
}

fn what_of(p: i64, tcx: Tcx<Comp>) -> *u8 {
    if has(p, F_OWNER, tcx) {
        c"owner"
    } else if has(p, F_TRAIT, tcx) && refused(p, tcx) {
        c"refused-trait"
    } else if has(p, F_VALUE, tcx) && refused(p, tcx) {
        c"refused-value"
    } else if has(p, F_CLASH, tcx) || (has(p, F_LOCAL, tcx) && !has(p, F_HAS, tcx)) {
        c"refused-name"
    } else if has(p, F_GEN, tcx) && refused(p, tcx) {
        c"refused-generated"
    } else if has(p, F_ENTRY, tcx) && refused(p, tcx) {
        c"refused-entry"
    } else if upgraded(p, tcx) {
        c"given-let-to-inout"
    } else if has(p, F_HAS, tcx) {
        if has(p, F_INOUT, tcx) { c"given-inout" } else { c"given-let" }
    } else if has(p, F_INOUT, tcx) {
        c"inout"
    } else {
        c"let"
    }
}

// `fix --only statics`: the group moved; the number of functions given
// the parameter (0 when the group is refused).
pub fn statics_edits(tcx: inout Tcx<Comp>) -> i64 {
    if tcx.group_file == 0 as *u8 {
        let d = diag(c"error", c"fix.statics", &tcx);
        buf_str(d, c"--only statics takes --group FILE (the statics, their fields, the parameter and its owners)\n");
        return 0;
    }
    if !read_group(&tcx) {
        return 0;
    }
    if tcx.statics_prune {
        prune(&tcx);
        return 0;
    }
    resolve_group(&tcx);
    walk_all(&tcx);
    close(&tcx);
    var any_refused = false;
    let out = buf_new();
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        let member = has(p, F_MEMBER, tcx);
        if has(p, F_USES, tcx) {
            tcx.statics_counts[2] += 1;
        }
        if member && !has(p, F_HAS, tcx) {
            tcx.statics_counts[3] += 1;
            if has(p, F_INOUT, tcx) {
                tcx.statics_counts[4] += 1;
            }
        }
        if refused(p, tcx) {
            if !any_refused {
                let d = diag(c"error", c"fix.statics", &tcx);
                buf_str(d, c"'");
                put_name(d, p, tcx);
                buf_str(d, c"' needs the group's context, and no owner gives it (");
                buf_str(d, what_of(p, tcx));
                buf_str(d, c"): nothing is changed\n  help: name an owner above it in the group file, or leave out the statics that reach it (--prune)\n  try: volec fix --only statics-list --group ");
                buf_str(d, tcx.group_file);
                buf_byte(d, '\n');
            }
            any_refused = true;
        }
        if tcx.statics_list && (member || has(p, F_OWNER, tcx)) {
            put_fn(out, p, what_of(p, tcx), tcx);
        }
    }
    if tcx.statics_list {
        buf_write_fd(out, STDOUT);
    }
    tcx.statics_refused = any_refused;
    if any_refused {
        return 0;
    }
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        if has(p, F_MEMBER, tcx) {
            edit_params(p, &tcx);
        } else if owner_used(p, tcx) && !has(p, F_LOCAL, tcx) {
            edit_owner(p, &tcx);
        }
    }
    for e in 0..tcx.statics_e_from.count {
        let c = tcx.statics_e_from.get(e);
        let g = tcx.statics_e_to.get(e);
        if has(g, F_MEMBER, tcx) && (has(c, F_MEMBER, tcx) || has(c, F_OWNER, tcx))
            && (NODES[tcx.e_node.get(e)].p & NODE_IMPLICIT) == 0 {
            edit_call(tcx.e_node.get(e), g, &tcx);
        }
    }
    for i in 0..tcx.u_node.count {
        edit_use(i, &tcx);
    }
    lend_all(&tcx);
    hoist_all(&tcx);
    flush_edits(tcx);
    if tcx.statics_counts[0] > 0 {
        delete_statics(&tcx);
        unimport_statics(&tcx);
        import_context(&tcx);
    }
    tcx.statics_counts[3]
}

// Whether owner p makes the context: it uses a static of the group or
// calls a function taking the context.
fn owner_used(p: i64, tcx: Tcx<Comp>) -> bool {
    if !has(p, F_OWNER, tcx) || tcx.statics_counts[0] == 0 {
        return false;
    }
    if has(p, F_USES, tcx) {
        return true;
    }
    for e in 0..tcx.statics_e_from.count {
        if tcx.statics_e_from.get(e) == p && has(tcx.statics_e_to.get(e), F_MEMBER, tcx) {
            return true;
        }
    }
    false
}

// The end of statement stmt, past its `;`.
fn stmt_end(stmt: i64) -> i64 {
    let e = NODES[stmt].end;
    if e > 0 && SRC[e - 1] == ';' {
        return e;
    }
    var k = e;
    while k < SRC.len() as i64 && (SRC[k] == ' ' || SRC[k] == '\t') {
        k += 1;
    }
    if k < SRC.len() as i64 && SRC[k] == ';' { k + 1 } else { e }
}

// Whether function gp, or one it calls up the members, uses field f of the
// context.
fn uses_field(gp: i64, f: i64, used: HMap, head: HMap, next: IntVec, tcx: Tcx<Comp>) -> bool {
    var seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    stack.push(gp);
    seen.put(gp + 1, 1);
    while stack.count > 0 {
        let p = stack.pop();
        if used.get(p * 4096 + f + 1) != 0 {
            return true;
        }
        var e = head.get(p + 1) - 1;
        while e >= 0 {
            let g = tcx.statics_e_to.get(e);
            if has(g, F_MEMBER, tcx) && seen.get(g + 1) == 0 {
                seen.put(g + 1, 1);
                stack.push(g);
            }
            e = next.get(e) - 1;
        }
    }
    false
}

// `f(&X, &NAME)`: X, a static of the group, lent to a call that is to take
// the context too, which is own.conflict once X is `NAME.x`. When f, and
// what it calls, does not use x through the context, the statement takes
// the place into a local and puts it back after it (`var NAME_x =
// NAME.x;`, `f(&NAME_x, &NAME);`, `NAME.x = NAME_x;`); otherwise, or
// outside a statement, it is left and counted.
fn lend_all(tcx: inout Tcx<Comp>) {
    if tcx.b_call.count == 0 {
        return;
    }
    var used = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for i in 0..tcx.u_node.count {
        used.put(tcx.u_fn.get(i) * 4096 + tcx.u_field.get(i) + 1, 1);
    }
    var head = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var next = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for e in 0..tcx.statics_e_from.count {
        let c = tcx.statics_e_from.get(e);
        next.push(head.get(c + 1));
        head.put(c + 1, e + 1);
    }
    let name = SYMS[tcx.g_param].text;
    for i in 0..tcx.b_call.count {
        let call = tcx.b_call.get(i);
        let amp = tcx.b_arg.get(i);
        let c = tcx.b_fn.get(i);
        let stmt = tcx.b_stmt.get(i);
        let g = NODES[call].x - 1;
        if !editable(g) {
            continue;
        }
        let gp = NODES[f_node(g)].start;
        if !has(gp, F_MEMBER, tcx) || !(has(c, F_MEMBER, tcx) || has(c, F_OWNER, tcx)) {
            continue;
        }
        let key = NODES[amp].start + (1 << 42);
        if tcx.statics_done.get(-(key + 1)) != 0 {
            continue;
        }
        tcx.statics_done.put(-(key + 1), 1);
        let root = group_root(NODES[amp].b, tcx);
        let field = tcx.field_of.get(NODES[root].y + 1) - 1;
        if stmt == 0 || uses_field(gp, field, used, head, next, tcx) {
            tcx.statics_counts[15] += 1;
            let d = diag(c"note", c"fix.statics", &tcx);
            put_fn_at(d, NODES[amp].start);
            buf_str(d, c": a static of the group lent beside the context, left (it is used through it, or not in a statement)\n");
            continue;
        }
        let place = buf_new();
        let pn = NODES[amp].b;
        render(place, NODES[pn].start, NODES[pn].end, &tcx);
        let temp = buf_new();
        buf_bytes(temp, name);
        buf_byte(temp, '_');
        buf_bytes(temp, SYMS[tcx.g_fields.get(field)].text);
        let arg = buf_new();
        buf_byte(arg, '&');
        buf_bytes(arg, buf_slice(temp));
        put_edit(NODES[amp].start, NODES[amp].end, arg, &tcx);
        var line = NODES[stmt].start;
        while line > 0 && SRC[line - 1] == ' ' {
            line -= 1;
        }
        let before = buf_new();
        buf_str(before, c"var ");
        buf_bytes(before, buf_slice(temp));
        buf_str(before, c" = ");
        buf_bytes(before, buf_slice(place));
        buf_str(before, c";\n");
        buf_bytes(before, SRC[line..NODES[stmt].start]);
        insert(NODES[stmt].start, before, &tcx);
        let after = buf_new();
        buf_byte(after, '\n');
        buf_bytes(after, SRC[line..NODES[stmt].start]);
        buf_bytes(after, buf_slice(place));
        buf_str(after, c" = ");
        buf_bytes(after, buf_slice(temp));
        buf_byte(after, ';');
        insert(stmt_end(stmt), after, &tcx);
        tcx.statics_counts[13] += 1;
    }
}

// FILE:LINE of position pos, into out.
fn put_fn_at(out: i64, pos: i64) {
    buf_str(out, FILES[file_of_pos(pos)].path);
    buf_byte(out, ':');
    buf_int(out, line_of(pos));
}

// The group's statics' declarations deleted (their comments with them);
// declarations on adjacent lines in one deletion, so that no blank lines
// are left together.
fn delete_statics(tcx: inout Tcx<Comp>) {
    var heads = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var tails = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    // UNSAFE: STATICS is the checker's table of statics, a raw pointer (front::types).
    // SAFETY: s is below STATIC_COUNT, the table's length.
    unsafe {
        for s in 0..STATIC_COUNT {
            if tcx.field_of.get(s + 1) == 0 {
                continue;
            }
            let d = def_of_node(STATICS[s].node, tcx);
            if d < 0 {
                continue;
            }
            // (in position order)
            let h = line_start(text_start(d));
            var k = heads.count;
            heads.push(h);
            tails.push(item_tail(d, tcx));
            while k > 0 && heads.get(k - 1) > h {
                heads.set(k, heads.get(k - 1));
                tails.set(k, tails.get(k - 1));
                k -= 1;
            }
            heads.set(k, h);
            tails.set(k, item_tail(d, tcx));
        }
    }
    var i = 0;
    while i < heads.count {
        var tail = tails.get(i);
        var j = i + 1;
        while j < heads.count && heads.get(j) == after_line(tail - 1) {
            tail = tails.get(j);
            j += 1;
        }
        if delete_lines(heads.get(i), tail) {
            tcx.statics_counts[10] += j - i;
        }
        i = j;
    }
}

// The module path a Use node's path names (`crate::` taken away; `self`
// and `super` from its module), into buffer out.
fn use_prefix(out: i64, u: i64, tcx: inout Tcx<Comp>) {
    let path = NODES[u].c;
    var m = trimmed(mod_fqn_text(module_of(u), &tcx));
    var first = 0;
    if NODES[path].count > 0 {
        let s0 = SYMS[NODES[child(path, 0)].a].text;
        if s0 == "crate" {
            m = "";
            first = 1;
        } else if s0 == "self" {
            first = 1;
        } else if s0 == "super" {
            while first < NODES[path].count && SYMS[NODES[child(path, first)].a].text == "super" {
                var e = m.len();
                while e > 0 && m[e - 1] != ':' {
                    e -= 1;
                }
                m = if e >= 2 { m[0..e - 2] } else { "" };
                first += 1;
            }
        } else {
            m = "";
        }
    }
    buf_bytes(out, m);
    for k in first..NODES[path].count {
        if buf_slice(out).len() > 0 {
            buf_str(out, c"::");
        }
        buf_bytes(out, SYMS[NODES[child(path, k)].a].text);
    }
}

// The imports of the group's statics taken out of the `use` lines.
fn unimport_statics(tcx: inout Tcx<Comp>) {
    var moved = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for i in 0..tcx.g_paths.count {
        if tcx.g_dropped.get(i + 1) == 0 {
            moved.put(intern(trimmed(SYMS[tcx.g_paths.get(i)].text)) + 1, 1);
        }
    }
    for u in 1..NODES.len() as i64 {
        if NODES[u].kind != NodeKind::Use || NODES[u].b == 1 || NODES[u].count == 0
            || !user_file(file_of_pos(NODES[u].start)) {
            continue;
        }
        let prefix = buf_new();
        use_prefix(prefix, u, &tcx);
        var gone = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..NODES[u].count {
            let full = buf_new();
            buf_bytes(full, buf_slice(prefix));
            buf_str(full, c"::");
            buf_bytes(full, SYMS[NODES[child(u, k)].a].text);
            if moved.get(intern(buf_slice(full)) + 1) != 0 {
                gone.push(k);
            }
        }
        if gone.count > 0 {
            tcx.statics_counts[11] += remove_use_names(u, gone);
        }
    }
}

// Whether file f is the program's (not std's, not a generated one).
fn user_file(f: i64) -> bool {
    // UNSAFE: a file's path is a C string, a raw pointer (base::SourceFile).
    // SAFETY: f is the index of a loaded file, and every path is NUL-terminated.
    unsafe { f >= 0 && FILES[f].path[0] != '<' }
}

// The group's `use PATH` lines added to each file that gives a function
// the parameter or (and `owner-use PATH`) an owner the local, where the
// file does not import the name already nor defines it.
fn import_context(tcx: inout Tcx<Comp>) {
    if tcx.g_uses.count == 0 && tcx.g_owner_uses.count == 0 {
        return;
    }
    // (per file + 1: 1 a member's, 2 an owner's)
    var files = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..tcx.statics_items.count {
        let p = tcx.statics_items.get(i);
        let f = file_of_pos(p);
        let want = if has(p, F_MEMBER, tcx) && !has(p, F_HAS, tcx) { 1 }
            else if owner_used(p, tcx) && !has(p, F_LOCAL, tcx) { 2 } else { 0 };
        if want == 0 {
            continue;
        }
        if files.get(f + 1) == 0 {
            order.push(f);
        }
        files.put(f + 1, files.get(f + 1) | want);
    }
    var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for u in 1..NODES.len() as i64 {
        if NODES[u].kind == NodeKind::Use {
            uses.push(u);
        }
    }
    for i in 0..order.count {
        let f = order.get(i);
        let want = files.get(f + 1);
        for j in 0..tcx.g_uses.count + tcx.g_owner_uses.count {
            let owner_only = j >= tcx.g_uses.count;
            if owner_only && (want & 2) == 0 {
                continue;
            }
            let path = if owner_only { tcx.g_owner_uses.get(j - tcx.g_uses.count) }
                else { tcx.g_uses.get(j) };
            add_use(f, path, uses, &tcx);
        }
    }
}

// `use PATH;` added to file f, after its last `use` (else before its
// first item), unless f imports PATH's name or its module defines it.
fn add_use(f: i64, path: i64, uses: IntVec, tcx: inout Tcx<Comp>) {
    let mt = buf_new();
    buf_bytes(mt, trimmed(mod_fqn_text(FILES[f].module, &tcx)));
    let p = trimmed(SYMS[path].text);
    var e = p.len();
    while e > 0 && p[e - 1] != ':' {
        e -= 1;
    }
    let name = p[e..];
    let module = if e >= 2 { p[0..e - 2] } else { "" };
    if buf_slice(mt) == module {
        return;
    }
    var last = -1;
    for i in 0..uses.count {
        let u = uses.get(i);
        if file_of_pos(NODES[u].start) != f {
            continue;
        }
        for k in 0..NODES[u].count {
            let id = child(u, k);
            let local = if NODES[id].b != 0 { NODES[id].b } else { NODES[id].a };
            if SYMS[local].text == name {
                return;
            }
        }
        if line_start(NODES[u].start) == NODES[u].start && NODES[u].end > last {
            last = NODES[u].end;
        }
    }
    let key = f * 1000003 + path + (1 << 43);
    if tcx.statics_done.get(-(key + 1)) != 0 {
        return;
    }
    tcx.statics_done.put(-(key + 1), 1);
    let b = buf_new();
    if last >= 0 {
        buf_str(b, c"\nuse ");
        buf_bytes(b, SYMS[path].text);
        buf_byte(b, ';');
        edit_replace(last, last, b);
    } else {
        // (the first line that is no comment and not blank)
        var at = FILES[f].start;
        loop {
            var k = at;
            while k < FILES[f].end && (SRC[k] == ' ' || SRC[k] == '\t') {
                k += 1;
            }
            if k < FILES[f].end && (SRC[k] == '\n'
                || (k + 1 < FILES[f].end && SRC[k] == '/' && SRC[k + 1] == '/')) {
                while k < FILES[f].end && SRC[k] != '\n' {
                    k += 1;
                }
                at = k + 1;
                continue;
            }
            break;
        }
        buf_str(b, c"use ");
        buf_bytes(b, SYMS[path].text);
        buf_str(b, c";\n\n");
        edit_replace(at, at, b);
    }
    tcx.statics_counts[12] += 1;
}

// The walk's state, for another round.
fn reset_walk(tcx: inout Tcx<Comp>) {
    tcx.field_of.clear();
    tcx.statics_flags.clear();
    tcx.item.clear();
    tcx.statics_callees.clear();
    tcx.first_use.clear();
    tcx.via.clear();
    tcx.write_at.clear();
    tcx.statics_items.count = 0;
    tcx.statics_e_from.count = 0;
    tcx.statics_e_to.count = 0;
    tcx.e_node.count = 0;
    tcx.u_node.count = 0;
    tcx.u_field.count = 0;
    tcx.u_fn.count = 0;
    tcx.u_call.count = 0;
    tcx.b_call.count = 0;
    tcx.b_arg.count = 0;
    tcx.b_fn.count = 0;
    tcx.b_stmt.count = 0;
    tcx.h_stmt.count = 0;
    tcx.h_call.count = 0;
    for k in 0..16 {
        tcx.statics_counts[k] = 0;
    }
}

// Whether member p is under one of --prune's prefixes.
fn inside(p: i64, tcx: Tcx<Comp>) -> bool {
    let d = def_of_node(tcx.item.get(p + 1), tcx);
    if d < 0 {
        return true;
    }
    let t = trimmed(SYMS[DEFS[d].fqn].text);
    for i in 0..tcx.prune_prefixes.count {
        let x = trimmed(SYMS[tcx.prune_prefixes.get(i)].text);
        if x == "crate" || x.len() == 0 {
            return true;
        }
        if t.len() >= x.len() && t[0..x.len()] == x
            && (t.len() == x.len() || t[x.len()] == ':') {
            return true;
        }
    }
    false
}

// `--prune PREFIX,...`: the group without the statics that make a
// function outside the prefixes, or one refused, take the context. In
// rounds: each such function is followed down its `via`s to the function
// using a static, whose first static is dropped. The group that is left
// is printed, as a group file, the dropped as comments.
fn prune(tcx: inout Tcx<Comp>) {
    var rounds = 0;
    loop {
        reset_walk(&tcx);
        resolve_group(&tcx);
        walk_all(&tcx);
        close(&tcx);
        rounds += 1;
        var dropped = 0;
        for i in 0..tcx.statics_items.count {
            let p = tcx.statics_items.get(i);
            if !has(p, F_MEMBER, tcx) || (!refused(p, tcx) && inside(p, tcx)) {
                continue;
            }
            var q = p;
            var steps = 0;
            while tcx.first_use.get(q + 1) == 0 && tcx.via.get(q + 1) > 0 && steps < 100000 {
                q = tcx.via.get(q + 1) - 1;
                steps += 1;
            }
            let f = tcx.first_use.get(q + 1) - 1;
            if f >= 0 && tcx.g_dropped.get(f + 1) == 0 {
                tcx.g_dropped.put(f + 1, p + 1);
                dropped += 1;
            }
        }
        if dropped == 0 {
            break;
        }
    }
    let out = buf_new();
    buf_str(out, c"param ");
    buf_bytes(out, SYMS[tcx.g_param].text);
    buf_str(out, c"\ntype ");
    buf_bytes(out, SYMS[tcx.g_type].text);
    buf_str(out, c"\ninit ");
    buf_bytes(out, SYMS[tcx.g_init].text);
    buf_byte(out, '\n');
    for i in 0..tcx.g_owners.count {
        buf_str(out, c"owner ");
        buf_bytes(out, SYMS[tcx.g_owners.get(i)].text);
        buf_byte(out, '\n');
    }
    for i in 0..tcx.g_uses.count {
        buf_str(out, c"use ");
        buf_bytes(out, SYMS[tcx.g_uses.get(i)].text);
        buf_byte(out, '\n');
    }
    for i in 0..tcx.g_owner_uses.count {
        buf_str(out, c"owner-use ");
        buf_bytes(out, SYMS[tcx.g_owner_uses.get(i)].text);
        buf_byte(out, '\n');
    }
    var kept = 0;
    for i in 0..tcx.g_paths.count {
        let why = tcx.g_dropped.get(i + 1);
        if why != 0 {
            buf_str(out, c"# dropped ");
        } else {
            kept += 1;
        }
        buf_str(out, c"static ");
        buf_bytes(out, SYMS[tcx.g_paths.get(i)].text);
        buf_byte(out, ' ');
        buf_bytes(out, SYMS[tcx.g_fields.get(i)].text);
        if why != 0 {
            buf_str(out, c"\t(reaches ");
            put_name(out, why - 1, tcx);
            buf_byte(out, ')');
        }
        buf_byte(out, '\n');
    }
    buf_write_fd(out, STDOUT);
    let d = diag(c"note", c"fix.statics", &tcx);
    buf_str(d, c"pruned in ");
    buf_int(d, rounds);
    buf_str(d, c" rounds: ");
    buf_int(d, kept);
    buf_str(d, c" of ");
    buf_int(d, tcx.g_paths.count);
    buf_str(d, c" statics kept\n");
    tcx.statics_refused = false;
}

// ---- The arguments taken out ----

fn note_statement(n: i64, tcx: inout Tcx<Comp>) {
    let kind = NODES[n].kind;
    let e = if kind == NodeKind::ExprStmt { NODES[n].a }
        else if kind == NodeKind::Let { NODES[n].c } else { 0 };
    if e > 0 && NODES[e].kind == NodeKind::Call && NODES[e].a == 0 && NODES[e].count > 1 {
        tcx.h_stmt.push(n);
        tcx.h_call.push(e);
    }
}

// Whether SRC[a..b] holds `&NAME` (NAME the parameter, a whole word).
fn lends_param(a: i64, b: i64, tcx: Tcx<Comp>) -> bool {
    let name = SYMS[tcx.g_param].text;
    let n = name.len() as i64;
    var k = a;
    while k + n < b {
        if SRC[k] == '&' && SRC[k + 1..k + 1 + n] == name {
            let after = if k + 1 + n < SRC.len() as i64 { SRC[k + 1 + n] } else { ' ' };
            if !(after == '_' || (after >= 'a' && after <= 'z') || (after >= 'A' && after <= 'Z')
                || (after >= '0' && after <= '9')) {
                return true;
            }
        }
        k += 1;
    }
    false
}

// Whether SRC[a..b] holds a call that will take the context inout (a
// call edited to give `&NAME`).
fn lends_context(a: i64, b: i64, tcx: Tcx<Comp>) -> bool {
    for e in 0..tcx.statics_e_from.count {
        let n = tcx.e_node.get(e);
        let g = tcx.statics_e_to.get(e);
        if NODES[n].start >= a && NODES[n].end <= b && has(g, F_MEMBER, tcx) && has(g, F_INOUT, tcx)
            && (has(tcx.statics_e_from.get(e), F_MEMBER, tcx)
                || has(tcx.statics_e_from.get(e), F_OWNER, tcx)) {
            return true;
        }
    }
    false
}

// `P_TARGETS.push(new_block());`: the receiver, a part of the context, is
// lent after the arguments, and an argument changes the context
// (own.conflict, once it is `pbody.targets.push(new_block(&pbody))`): the
// arguments up to the last that changes it become `let`s before the
// statement, in order (`let pbody_arg = new_block(&pbody);`). The
// statement is written whole, with the other edits inside it.
fn hoist_all(tcx: inout Tcx<Comp>) {
    let name = SYMS[tcx.g_param].text;
    for i in 0..tcx.h_stmt.count {
        let stmt = tcx.h_stmt.get(i);
        let call = tcx.h_call.get(i);
        var recv = child(call, 0);
        while NODES[recv].kind == NodeKind::Unary && NODES[recv].op == Tok::Amp {
            recv = NODES[recv].b;
        }
        let root = place_root(recv);
        if root <= 0 || NODES[root].kind != NodeKind::Ident {
            continue;
        }
        let static_ = NODES[root].res == Res::Static && tcx.field_of.get(NODES[root].y + 1) != 0;
        let local = root != recv && NODES[root].res == Res::Local
            && SYMS[NODES[root].a].text == name;
        if !static_ && !local {
            continue;
        }
        // (the arguments as written: within the call)
        var last = 0;
        for k in 1..NODES[call].count {
            let arg = child(call, k);
            if NODES[arg].start < NODES[recv].end || NODES[arg].end > NODES[call].end {
                continue;
            }
            let a = NODES[arg].start;
            let b = NODES[arg].end;
            if (static_ && lends_context(a, b, tcx)) || (local && lends_param(a, b, tcx)) {
                last = k;
            }
        }
        if last == 0 {
            continue;
        }
        let key = NODES[stmt].start + (1 << 40);
        if tcx.statics_done.get(-(key + 1)) != 0 {
            continue;
        }
        tcx.statics_done.put(-(key + 1), 1);
        // (the statement's indentation)
        var line = NODES[stmt].start;
        while line > 0 && SRC[line - 1] == ' ' {
            line -= 1;
        }
        let text = buf_new();
        var at = NODES[stmt].start;
        let rest = buf_new();
        for k in 1..last + 1 {
            let arg = child(call, k);
            if NODES[arg].start < NODES[recv].end || NODES[arg].end > NODES[call].end {
                continue;
            }
            let temp = buf_new();
            buf_bytes(temp, name);
            buf_str(temp, c"_arg");
            if k > 1 {
                buf_int(temp, k - 1);
            }
            buf_str(text, c"let ");
            buf_bytes(text, buf_slice(temp));
            buf_str(text, c" = ");
            render(text, NODES[arg].start, NODES[arg].end, &tcx);
            buf_str(text, c";\n");
            buf_bytes(text, SRC[line..NODES[stmt].start]);
            render(rest, at, NODES[arg].start, &tcx);
            buf_bytes(rest, buf_slice(temp));
            at = NODES[arg].end;
        }
        render(rest, at, NODES[stmt].end, &tcx);
        buf_bytes(text, buf_slice(rest));
        put_edit(NODES[stmt].start, NODES[stmt].end, text, &tcx);
        tcx.statics_counts[9] += 1;
    }
}

// The census after a run: `note fix.statics: ...`.
pub fn statics_report(tcx: inout Tcx<Comp>) {
    if tcx.statics_prune {
        return;
    }
    let d = diag(c"note", c"fix.statics", &tcx);
    buf_str(d, c"statics ");
    buf_int(d, tcx.statics_counts[0]);
    buf_str(d, c"; functions using them ");
    buf_int(d, tcx.statics_counts[2]);
    buf_str(d, c", given the parameter ");
    buf_int(d, tcx.statics_counts[3]);
    buf_str(d, c" (inout ");
    buf_int(d, tcx.statics_counts[4]);
    buf_str(d, c"), owners ");
    buf_int(d, tcx.statics_counts[5]);
    buf_str(d, c"; edits: uses ");
    buf_int(d, tcx.statics_counts[1]);
    buf_str(d, c", calls ");
    buf_int(d, tcx.statics_counts[6]);
    buf_str(d, c", parameters ");
    buf_int(d, tcx.statics_counts[7]);
    buf_str(d, c", statements given their arguments as lets ");
    buf_int(d, tcx.statics_counts[9]);
    if tcx.statics_counts[10] + tcx.statics_counts[11] + tcx.statics_counts[12] > 0 {
        buf_str(d, c"; declarations deleted ");
        buf_int(d, tcx.statics_counts[10]);
        buf_str(d, c", imports taken out ");
        buf_int(d, tcx.statics_counts[11]);
        buf_str(d, c", use lines added ");
        buf_int(d, tcx.statics_counts[12]);
    }
    if tcx.statics_counts[14] > 0 {
        buf_str(d, c"; format arguments for holes ");
        buf_int(d, tcx.statics_counts[14]);
    }
    if tcx.statics_counts[13] + tcx.statics_counts[15] > 0 {
        buf_str(d, c"; lent beside the context: taken into locals ");
        buf_int(d, tcx.statics_counts[13]);
        buf_str(d, c", left ");
        buf_int(d, tcx.statics_counts[15]);
    }
    if tcx.statics_counts[8] > 0 {
        buf_str(d, c"; calls left (no argument list found) ");
        buf_int(d, tcx.statics_counts[8]);
    }
    buf_byte(d, '\n');
}
