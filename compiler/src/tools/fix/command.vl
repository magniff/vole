// `volec fix`'s command line: the kinds of fix (--only), the
// import paths chosen for a missing name, and the rounds of fixes until
// nothing is left (split from fix).

use std::Arena;

use crate::base::{
    BUFS, IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
