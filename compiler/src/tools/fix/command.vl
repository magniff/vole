const F_IMPORTS: i64 = 1;
const F_UNUSED: i64 = 2;
const F_PUB: i64 = 4;
const F_UNSAFE: i64 = 8;
// (0.12; not in the default: --only tidy-imports, --only reexports)
const F_TIDY: i64 = 16;
const F_REEXPORTS: i64 = 32;
// (0.15: only when asked for, as tidy-imports and reexports: fixstd015.vl)
const F_STD015: i64 = 64;
// (0.18: --suggested, `--only suggested`) the errors' exact fixes
// (fix::suggested_edits), with the imports and pubs the errors ask for
const F_SUGGESTED: i64 = 256;
// (0.17: --values, fixvalues.vl)
const F_VALUES: i64 = 512;
// (0.20: `--only conventions`, fixconv.vl; `conventions-spelling`: the
// part the checker of Phase 0 means as 0.19 did)
const F_CONV: i64 = 1024;
const F_CONV_SPELLING: i64 = 2048;
// (0.25.4: `--only unneeded-unsafe`, fix/unneeded.vl) the unsafe blocks with
// nothing unsafe inside, taken away
const F_UNNEEDED: i64 = 4096;
// (0.25.5: `--only unneeded-justified`) the same, the justified blocks too,
// with their comments (UNNEEDED_JUSTIFIED); a word, not a bit of `only`
const F_UNNEEDED_J: i64 = 8192;
// (0.26.0: `--only obsolete-attr`) the obsolete attributes (`#[sealed]`),
// deleted (fix::obsolete_attr_edits)
const F_OBSOLETE: i64 = 16384;
// (0.26.2: `--only usize`) the conversions the errors name where a usize
// meets an i64 (`s.len as i64`): the suggested fixes, with usize to i64
// allowed (verify::USIZE_LENGTHS: lengths are below 2^63)
const F_USIZE: i64 = 32768;
// (0.26.2: `--only fstring`) f-strings to format literals (fix/fstring.vl)
const F_FSTRING: i64 = 65536;
// (0.26.3: `--only casts`) a usize's `as i64` taken away where the value
// means the same as a usize (fix/casts.vl); `casts-list` also lists each
const F_CASTS: i64 = 131072;
// (0.26.3: allocation as a capability, fix/alloc.vl)
const F_ALLOC: i64 = 262144;
// (0.26.3: `--only buf`) std's Buf to String<A> or Vec<u8, A> (fix/buf.vl)
const F_BUF: i64 = 1048576;
// (0.26.4: `--only rawptr`) the raw pointer parameters decided into let,
// inout or raw (fix/rawptr.vl); `rawptr-list` also lists each
const F_RAWPTR: i64 = 2097152;
// (0.26.4: `--only statics --group FILE`) a group of statics into a context
// passed down (fix/statics.vl); `statics-list` also lists each function
const F_STATICS: i64 = 4194304;
const F_SUGGESTS: i64 = F_IMPORTS | F_PUB | F_SUGGESTED;
const F_ALL: i64 = 15;

// ---- Which module a missing import comes from (0.16) ----

// `--use PATH::NAME` into CHOSEN. False when it has no `::`.
fn take_use(v: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    var cut = -1;
    for i in 1..v.len as i64 {
        if v[i] == ':' && v[i - 1] == ':' {
            cut = i - 1;
        }
    }
    if cut <= 0 || cut + 2 >= v.len as i64 {
        return false;
    }
    tcx.chosen.push(intern(v[0..cut], &pcx));
    tcx.chosen.push(intern(v[cut + 2..], &pcx));
    true
}

// The module whose path is symbol p (`crate::a::b`, `std`), or -1 (std's
// path when std is not read).
fn module_of_path(p: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    for m in 0..module_count(pcx) {
        if m != pcx.c_module && mod_fqn(m, &tcx, &pcx) == p {
            return m;
        }
    }
    -1
}

// 1 for a value (a function, constant or static), 2 for a type, else 0.
fn key_kind(key: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.sym_fn[key] != 0 || pcx.sym_const[key] != 0 || pcx.sym_static[key] != 0 {
            1
        } else if pcx.sym_struct[key] != 0 || pcx.sym_enum[key] != 0 || pcx.sym_alias[key] != 0
            || template_of_key(key, pcx) != TPL_NONE {
            2
        } else {
            0
        }
    }
}

// Whether module a is module m or holds it.
fn holds(a: i64, m: i64, pcx: Ctx<Comp>) -> bool {
    var x = m;
    loop {
        if x == a {
            return true;
        }
        if x <= 0 {
            return false;
        }
        x = pcx.modules[x].parent;
    }
}

// Whether module m can name module c's items: each module on c's path is
// public, or its parent holds m.
fn reachable(c: i64, m: i64, pcx: Ctx<Comp>) -> bool {
    if within_std(c, pcx) {
        return true;
    }
    var x = c;
    while x > 0 {
        let p = pcx.modules[x].parent;
        if !pcx.modules[x].public && !holds(p, m, pcx) {
            return false;
        }
        x = p;
    }
    true
}

// How near module c is to module m: the depth of the innermost module
// holding both (std: -1, farther than any of the program's), and the
// number of segments of c's path.
fn nearness(c: i64, m: i64, shared: inout i64, segments: inout i64, pcx: Ctx<Comp>) {
    var n = 0;
    var x = c;
    while x > 0 {
        n += 1;
        x = pcx.modules[x].parent;
    }
    segments = if within_std(c, pcx) { 1 } else { n + 1 };
    if within_std(c, pcx) {
        shared = -1;
        return;
    }
    var a = c;
    while !holds(a, m, pcx) {
        a = pcx.modules[a].parent;
    }
    var d = 0;
    while a > 0 {
        d += 1;
        a = pcx.modules[a].parent;
    }
    shared = d;
}

// Whether module a is nearer to m than module b.
fn nearer(a: i64, b: i64, m: i64, pcx: Ctx<Comp>) -> bool {
    var sa = 0;
    var na = 0;
    var sb = 0;
    var nb = 0;
    nearness(a, m, &sa, &na, pcx);
    nearness(b, m, &sb, &nb, pcx);
    sa > sb || (sa == sb && na < nb)
}

// The path (a symbol) to import `name` from into module m, which the
// checker's help gave as p: when other modules m can name have a public
// item `name` of the same kind, the one --use names, else the nearest
// (the innermost module holding both, then the fewest segments) when no
// other is as near; else -1, after fix.ambiguous.
pub fn choose_path(m: i64, name: i64, p: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let pm = module_of_path(p, &tcx, &pcx);
        if pm < 0 {
            return p;
        }
        // (0.25.2.2) The kind of the item p names: std's re-export followed
        // to its item (the checker's help says `std` for an item of std's
        // modules that std re-exports; std's root has no key for it); no
        // item known, p as it is (key_kind(-1) read before the tables, a
        // crash when that page was unmapped)
        let pkey = if pm == pcx.std_module { std_item_key(name, &pcx) }
            else { item_key_if_known(pm, name, &pcx) };
        if pkey < 0 {
            return p;
        }
        let kind = key_kind(pkey, pcx);
        var cands = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var keys = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for c in 0..module_count(pcx) {
            if c == m || c == pcx.c_module {
                continue;
            }
            let key = item_key_if_known(c, name, &pcx);
            if key < 0 {
                continue;
            }
            let item = item_node_of(key, pcx);
            if item == 0 || (pcx.nodes[item].p & ITEM_PUBLIC) == 0 || key_kind(key, pcx) != kind
                || !reachable(c, m, pcx) {
                continue;
            }
            cands.push(c);
            keys.push(key);
        }
        if cands.count <= 1 {
            return p;
        }
        for i in 0..tcx.chosen.count / 2 {
            if tcx.chosen.data[2 * i + 1] != name {
                continue;
            }
            for k in 0..cands.count {
                if mod_fqn(cands.data[k], &tcx, &pcx) == tcx.chosen.data[2 * i] {
                    return tcx.chosen.data[2 * i];
                }
            }
        }
        // The nearest; those as near that are another item.
        var best = 0;
        for k in 1..cands.count {
            if nearer(cands.data[k], cands.data[best], m, pcx) {
                best = k;
            }
        }
        var tied = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        tied.push(cands.data[best]);
        for k in 0..cands.count {
            if k != best && keys.data[k] != keys.data[best]
                && !nearer(cands.data[best], cands.data[k], m, pcx) {
                tied.push(cands.data[k]);
            }
        }
        if tied.count == 1 {
            return mod_fqn(cands.data[best], &tcx, &pcx);
        }
        tcx.ambiguous = true;
        let d = diag(c"error", c"fix.ambiguous", &tcx);
        buf_bytes(d, mod_fqn_text(m, &tcx, &pcx));
        buf_str(d, c" uses '");
        buf_bytes(d, sym_text(name, pcx));
        buf_str(d, c"', which ");
        buf_int(d, tied.count);
        buf_str(d, c" modules as near have: ");
        for k in 0..tied.count {
            if k > 0 {
                buf_str(d, c", ");
            }
            buf_bytes(d, mod_fqn_text(tied.data[k], &tcx, &pcx));
        }
        buf_str(d, c"; nothing is imported for it: name one with --use\n");
        for k in 0..tied.count {
            if k == 5 {
                break;
            }
            let out = try_begin(c"fix", c_slice(c""), false, &tcx, pcx);
            buf_str(out, c" --only imports --use");
            let path = buf_new();
            buf_bytes(path, mod_fqn_text(tied.data[k], &tcx, &pcx));
            buf_str(path, c"::");
            buf_bytes(path, sym_text(name, pcx));
            put_word(out, buf_slice(path));
            if pcx.opt_in != 0 as *u8 {
                buf_str(out, c" --in");
                put_word(out, c_slice(pcx.opt_in));
            }
            try_end(out);
        }
        -1
    }
}

// ---- The command ----

// `N noun` (plural when N is not 1), after a comma when the summary has
// something already.
fn put_count(out: i64, n: i64, one: *u8, many: *u8) {
    unsafe {
        if n == 0 {
            return;
        }
        if BUFS[out].len > 6 {
            buf_str(out, c",");
        }
        buf_byte(out, ' ');
        buf_int(out, n);
        buf_byte(out, ' ');
        buf_str(out, if n == 1 { one } else { many });
    }
}

// `fix`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn fix_leaf(gpa: Gpa) -> Leaf<Gpa> {
    var table = edit_opts(gpa);
    table.push(flag("round", "(the hook's round)"));
    table.push(flag("suggested", "the errors' exact fixes"));
    table.push(flag("values", "parameters to references (0.17)"));
    table.push(flag("list-left", "each place a migration leaves"));
    table.push(flag("tidy-edited", "the imports of the files edited, tidied"));
    table.push(flag("fix-imports", "(0.8's spelling of --only imports)"));
    table.push(flag("fix-unsafe", "(0.9's spelling of --only unsafe)"));
    table.push(option("at", "FILE:LINE", "--suggested: one line's errors"));
    table.push(option("codes", "CODE,...",
        "--suggested: only the fixes of errors with these codes"));
    table.push(flag("diff", "the diff of what is written, after the summary"));
    table.push(flag("keep-braces", "--only fstring: plain literals left as they are"));
    table.push(option("in", "FILE|MODULE", "only there"));
    table.push(option("group", "FILE", "--only statics: the statics, their context, its owners"));
    table.push(option("prune", "PREFIX,...",
        "--only statics-list: the group without the statics that reach a refused function or one outside the PREFIXes"));
    table.push(option("use", "PATH::NAME", "the module to import NAME from"));
    table.push(option("only", "KINDS", "imports,unused,pub,unsafe,suggested,..."));
    table.push(pair("overlay", "PATH COPY", "PATH read from COPY"));
    Leaf::new(table, "file")
}

pub fn run_fix(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>, wgx: inout WgslCx<Arena>) -> i64 {
    let status = run_fix_inner(c, 0, &tcx, &pcx, &wgx);
    write_diags(tcx);
    status
}

// `volec --fix-imports ROOT`, `--fix-unsafe ROOT` (`only`: F_IMPORTS,
// F_UNSAFE): fix, quiet when there is nothing to do.
pub fn run_fix_alias(c: Call<Gpa>, only: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>,
    wgx: inout WgslCx<Arena>) -> i64 {
    let status = run_fix_inner(c, only, &tcx, &pcx, &wgx);
    write_diags(tcx);
    status
}

fn run_fix_inner(c: Call<Gpa>, alias: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>,
    wgx: inout WgslCx<Arena>) -> i64 {
    set_command(c.line, &tcx);
    pcx.prog = c.prog();
    tcx.tool = 0 as *u8;
    var only = if alias != 0 { alias } else { F_ALL };
    var only_arg = if alias == F_IMPORTS { c"imports" }
        else if alias == F_UNSAFE { c"unsafe" } else { 0 as *u8 };
    var round = false;
    var suggested = false;
    var at = 0 as *u8;
    var root = 0 as *u8;
    var path = 0 as *u8;
    for e in c.evs.iter() {
        var ev = e;
        let a = ev.value;
        let flag_is = ev.kind == EV_FLAG;
        let opt_is = ev.kind == EV_OPTION;
        if flag_is && (ev.name == "fix-imports" || ev.name == "fix-unsafe") {
            if alias != 0 {
                continue;
            }
        } else if flag_is && ev.name == "round" {
            round = true;
            continue;
        } else if flag_is && ev.name == "suggested" {
            suggested = true;
            continue;
        } else if flag_is && ev.name == "values" {
            only = if only_arg == 0 as *u8 { F_VALUES } else { only | F_VALUES };
            only_arg = c"values";
            continue;
        } else if opt_is && ev.name == "at" {
            at = a;
            let s = c_slice(at);
            var line_no = 0;
            let n = file_line(s, &line_no);
            if n <= 0 || line_no <= 0 {
                let d = diag(c"error", c"fix.usage", &tcx);
                buf_str(d, c"--at takes FILE:LINE, the line of an error\n");
                return 2;
            }
            let f = buf_new();
            buf_bytes(f, s[0..n]);
            pcx.fix_at_file = buf_cstr(f);
            pcx.fix_at_line = line_no;
            continue;
        } else if opt_is && ev.name == "codes" {
            // (0.25.2.1: the check hook makes the mechanical fixes alone)
            let b = buf_new();
            buf_byte(b, ',');
            buf_str(b, a);
            buf_byte(b, ',');
            tcx.codes = b;
            tcx.codes_arg = a;
            suggested = true;
            continue;
        } else if flag_is && ev.name == "diff" {
            tcx.show_diff = true;
            continue;
        } else if flag_is && ev.name == "keep-braces" {
            tcx.keep_braces = true;
            continue;
        } else if flag_is && ev.name == "list-left" {
            tcx.conv_list_left = true;
            continue;
        } else if flag_is && ev.name == "tidy-edited" {
            tcx.tidy_edited = true;
            continue;
        } else if opt_is && ev.name == "group" {
            tcx.group_file = a;
            continue;
        } else if opt_is && ev.name == "prune" {
            // (0.26.5: a comma-separated list of path prefixes)
            tcx.statics_prune = true;
            let pb = ev.text.as_bytes();
            var pk: usize = 0;
            while pk < pb.len() {
                var pe = pk;
                while pe < pb.len() && pb[pe] != ',' {
                    pe += 1;
                }
                tcx.prune_prefixes.push(intern(pb[pk..pe], &pcx));
                pk = pe + 1;
            }
            continue;
        } else if opt_is && ev.name == "in" {
            pcx.opt_in = a;
            continue;
        } else if opt_is && ev.name == "use" {
            if !take_use(c_slice(a), &tcx, &pcx) {
                let d = diag(c"error", c"fix.usage", &tcx);
                buf_str(d, c"--use takes the path of an item, 'crate::a::b::name'\n");
                return 2;
            }
            continue;
        } else if opt_is && ev.name == "overlay" {
            // (its PATH, then its COPY: two values)
            if path == 0 as *u8 {
                path = a;
            } else {
                pcx.overlay.push(path as i64);
                pcx.overlay.push(a as i64);
                path = 0 as *u8;
            }
            continue;
        } else if opt_is && ev.name == "only" {
            only = 0;
            let v = a;
            only_arg = v;
            let vb = ev.text.as_bytes();
            var k = 0;
            // (a comma-separated list)
            while k < vb.len as i64 {
                var e = k;
                while e < vb.len as i64 && vb[e] != ',' {
                    e += 1;
                }
                let w = vb[k..e];
                let bit = if word_is(w, c"imports") { F_IMPORTS }
                    else if word_is(w, c"unused") { F_UNUSED }
                    else if word_is(w, c"pub") { F_PUB }
                    else if word_is(w, c"unsafe") { F_UNSAFE }
                    else if word_is(w, c"tidy-imports") { F_TIDY }
                    else if word_is(w, c"reexports") { F_REEXPORTS }
                    else if word_is(w, c"std015") { F_STD015 }
                    else if word_is(w, c"values") { F_VALUES }
                    else if word_is(w, c"conventions") { F_CONV }
                    else if word_is(w, c"conventions-spelling") { F_CONV_SPELLING }
                    else if word_is(w, c"unneeded-unsafe") { F_UNNEEDED }
                    else if word_is(w, c"unneeded-justified") { F_UNNEEDED_J }
                    else if word_is(w, c"obsolete-attr") { F_OBSOLETE }
                    else if word_is(w, c"usize") { F_USIZE }
                    else if word_is(w, c"fstring") { F_FSTRING }
                    else if word_is(w, c"casts") { F_CASTS }
                    else if word_is(w, c"casts-list") {
                        // (a dry run: the sites, the diff)
                        tcx.cast_list = true;
                        tcx.dry_run = true;
                        F_CASTS
                    }
                    else if word_is(w, c"alloc") { F_ALLOC }
                    else if word_is(w, c"buf") { F_BUF }
                    else if word_is(w, c"rawptr") { F_RAWPTR }
                    else if word_is(w, c"rawptr-list") {
                        // (a dry run: the parameters, the diff)
                        tcx.rawptr_list = true;
                        tcx.dry_run = true;
                        F_RAWPTR
                    }
                    else if word_is(w, c"statics") { F_STATICS }
                    else if word_is(w, c"statics-list") {
                        // (a dry run: the functions, the diff)
                        tcx.statics_list = true;
                        tcx.dry_run = true;
                        F_STATICS
                    }
                    else if word_is(w, c"suggested") { F_SUGGESTS } else { 0 };
                if bit == 0 {
                    let d = diag(c"error", c"fix.usage", &tcx);
                    buf_str(d, c"--only takes imports, unused, pub, unsafe, suggested, tidy-imports, reexports, std015, values, conventions, conventions-spelling, unneeded-unsafe, unneeded-justified, obsolete-attr, usize, fstring, casts, casts-list, alloc, buf, rawptr, rawptr-list, statics or statics-list, not '");
                    buf_bytes(d, w);
                    buf_str(d, c"'\n");
                    return 2;
                }
                if bit == F_UNNEEDED_J {
                    tcx.unneeded_justified = true;
                    only |= F_UNNEEDED;
                } else {
                    only |= bit;
                }
                k = if e < vb.len as i64 && vb[e] == ',' { e + 1 } else { e };
            }
            continue;
        } else if ev.kind == EV_MISSING && (ev.name == "at" || ev.name == "in"
            || ev.name == "use" || ev.name == "only" || ev.name == "group" || ev.name == "prune"
            || ev.name == "overlay" || ev.name == "codes") {
            ev.kind = EV_UNKNOWN;
        } else if take_edit_event(&ev, &root, &tcx, &pcx) {
            continue;
        }
        if ev.kind != EV_WORD || ev.text.starts_with("-") {
            let d = diag(c"error", c"fix.usage", &tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"'\n");
            let out = try_begin(c"fix", c_slice(c""), false, &tcx, pcx);
            try_end(out);
            return 2;
        }
        if root != 0 as *u8 {
            let d = diag(c"error", c"fix.usage", &tcx);
            buf_str(d, c"one ROOT (the program's root file), not '");
            buf_str(d, a);
            buf_str(d, c"'\n");
            return 2;
        }
        root = a;
    }
    if suggested {
        only = if only_arg == 0 as *u8 { F_SUGGESTS } else { only | F_SUGGESTS };
    }
    if (only & F_USIZE) != 0 {
        pcx.usize_lengths = true;
        only = (only & ~F_USIZE) | F_SUGGESTED;
    }
    if (only & F_ALLOC) != 0 {
        // (the allocator rules' exact fixes, by their codes)
        tcx.codes = crate::tools::fix::alloc::alloc_codes();
        tcx.alloc_rounds = true;
        only = F_SUGGESTED;
    }
    if tcx.codes >= 0 {
        // (0.25.2.1: --codes: those errors' exact fixes alone, no
        // import, no pub)
        only = F_SUGGESTED;
    }
    // (0.20) The migrations read 0.19's spelling: the program is read
    // mixed (front/conv), whatever the default
    if (only & (F_STD015 | F_VALUES | F_CONV | F_CONV_SPELLING)) != 0 {
        crate::front::conv::set_mixed(&pcx);
    }
    if (only & (F_STD015 | F_VALUES)) != 0 {
        tcx.write_019 = true;
    }
    if (only & F_SUGGESTED) != 0 {
        tcx.left_ok = true;
    } else if at != 0 as *u8 {
        let d = diag(c"error", c"fix.usage", &tcx);
        buf_str(d, c"--at is for --suggested: the fixes of the errors at a line\n");
        return 2;
    }
    tcx.root_given = root;
    // (0.25.2: std's files edited: fixed with them, as check reads them)
    crate::tools::edit::cli::std_tree_if_edited(&tcx, &pcx);
    root = root_or_diag(root, c"fix", c_slice(c""), false, &tcx, pcx);
    if root == 0 as *u8 {
        return 2;
    }
    pcx.fix_imports = (only & F_IMPORTS) != 0;
    pcx.fix_unsafe = (only & F_UNSAFE) != 0;
    // (std015 reads the calls as written)
    if (only & F_STD015) != 0 {
        pcx.keep_parsed = true;
    }
    // (0.20: conventions reads the program as 0.19 meant it, mixed; the
    // edited one is checked in 0.20's spelling, but by
    // conventions-spelling's, which keeps 0.19's meaning)
    if (only & (F_CONV | F_CONV_SPELLING)) != 0 {
        tcx.conv_spelling = (only & F_CONV) == 0;
        tcx.check_strict = !tcx.conv_spelling;
        crate::front::conv::set_mixed(&pcx);
    }
    // (0.25.4: unneeded-unsafe asks the checker which unsafe blocks hold
    // an unsafe operation, as `query unsafe` does)
    if (only & F_UNNEEDED) != 0 {
        pcx.audit_unsafe = true;
    }
    // (0.26.2: fstring asks the checker for the format positions)
    pcx.record_sites = (only & F_FSTRING) != 0;
    // (0.26.3: and reads them with no syntax.fstring, front/parser/exprs.vl)
    pcx.fstrings_read = (only & F_FSTRING) != 0;
    // (0.26.3: buf reads the checker's view before std's str is erased)
    pcx.record = (only & F_BUF) != 0;
    // (and its edits are checked by the errors' codes and items: it rewords
    // the errors a program has, edit/apply.vl KEY_BY_ITEM)
    tcx.key_by_item = (only & (F_FSTRING | F_BUF)) != 0;
    if !load_program(root, tcx.target, &tcx, &pcx, &wgx) {
        // (0.18) a program that does not parse: its errors' exact
        // fixes alone (a Rust label respelled)
        if (only & F_SUGGESTED) == 0 || pcx.suggested.count == 0 || pcx.opt_in != 0 as *u8 {
            program_errors(c"error", root, true, &tcx, &pcx);
            return 1;
        }
        only = F_SUGGESTED;
    }
    if pcx.opt_in != 0 as *u8 && !resolve_in_list(c_slice(pcx.opt_in), &tcx, &pcx) {
        let d = diag(c"error", c"fix.bad-in", &tcx);
        put_bad_in(d, pcx.opt_in, tcx);
        return 1;
    }
    // The fixes (an edit overlapping one made before is left for the
    // next run).
    let wild = if (only & F_IMPORTS) != 0 && pcx.legacy_imports { fix_imports_edits(&pcx) }
        else { 0 };
    let imports = if (only & F_IMPORTS) != 0 { missing_use_edits(&tcx, &pcx) } else { 0 };
    let unused = if (only & F_UNUSED) != 0 { unused_import_edits(0 as *IntVec, &pcx) } else { 0 };
    let public = if (only & F_PUB) != 0 { pub_edits(&tcx, &pcx) } else { 0 };
    tcx.whole_bodies = alias == 0;
    let wrapped = if (only & F_UNSAFE) != 0 { fix_unsafe_edits(tcx, &pcx) } else { 0 };
    var dropped = 0;
    let through = if (only & F_REEXPORTS) != 0 { reexport_edits(&dropped, &tcx, &pcx) } else { 0 };
    let tidied = if (only & F_TIDY) != 0 { tidy_import_edits(&tcx, &pcx) } else { 0 };
    let migrated = if (only & F_STD015) != 0 { std015_edits(tcx, &pcx) } else { 0 };
    // (0.16's alloc016, removed in 0.26.3 with std's ambient functions: fix --only alloc)
    let explicit = 0;
    let exact = if (only & F_SUGGESTED) != 0 { suggested_edits(&tcx, &pcx) } else { 0 };
    let valued = if (only & F_VALUES) != 0 { values_edits(&tcx, &pcx) } else { 0 };
    let conv = if (only & (F_CONV | F_CONV_SPELLING)) != 0 { conventions_edits(&tcx, &pcx) }
        else { 0 };
    let unneeded = if (only & F_UNNEEDED) != 0 { unneeded_unsafe_edits(&tcx, &pcx) } else { 0 };
    let obsolete = if (only & F_OBSOLETE) != 0 { obsolete_attr_edits(&pcx) } else { 0 };
    let formats = if (only & F_FSTRING)
        != 0 { crate::tools::fix::fstring::fstring_edits(tcx, &pcx) }
        else { 0 };
    let casts = if (only & F_CASTS) != 0 { crate::tools::fix::casts::cast_edits(&tcx, &pcx) }
        else { 0 };
    if (only & F_CASTS) != 0 && !round {
        crate::tools::fix::casts::cast_report(&tcx);
    }
    let bufs = if (only & F_BUF) != 0 { crate::tools::fix::buf::buf_edits(&tcx, &pcx) } else { 0 };
    let rawptrs = if (only & F_RAWPTR) != 0 { crate::tools::fix::rawptr::rawptr_edits(&tcx, &pcx) }
        else { 0 };
    if (only & F_RAWPTR) != 0 && !round {
        crate::tools::fix::rawptr::rawptr_report(&tcx, pcx);
    }
    let moved = if (only & F_STATICS) != 0 { crate::tools::fix::statics::statics_edits(&tcx, &pcx) }
        else { 0 };
    if (only & F_STATICS) != 0 && !round {
        crate::tools::fix::statics::statics_report(&tcx);
    }
    if (only & (F_CONV | F_CONV_SPELLING)) != 0 {
        conventions_report(&tcx, pcx);
    }
    var counts = [imports, wild, unused, public, wrapped, through, dropped, tidied,
        migrated, explicit, exact];
    if round {
        // (a later round, on the edited program: what it fixed, the
        // copies it rewrote)
        if edit_count(tcx, pcx) == 0 {
            return 0;
        }
        // (0.25.2.1: the round's fixes checked on its copies first,
        // fix/verify.vl)
        if !write_round_copies(&tcx, &pcx) {
            return 1;
        }
        if (only & F_SUGGESTED) != 0 && !tcx.no_check
            && !verify_fixes(root, &counts, true, &tcx, &pcx) {
            return 0;
        }
        let out = buf_new();
        buf_str(out, c"count");
        for k in 0..11 {
            buf_byte(out, '\t');
            buf_int(out, counts[k]);
        }
        buf_byte(out, '\n');
        buf_write_fd(out, STDOUT);
        print_round_files(tcx, pcx);
        return 0;
    }
    if edit_count(tcx, pcx) == 0 {
        if tcx.ambiguous || tcx.shape_left > 0 || pcx.buf_refused > 0
            || tcx.statics_refused {
            return 1;
        }
        if alias == 0 && !tcx.statics_prune {
            let d = diag(c"note", c"fix.none", &tcx);
            buf_str(d, c"nothing to fix\n");
        }
        return 0;
    }
    let status = prepare_edit(&tcx, &pcx);
    if status >= 0 {
        return status;
    }
    // (0.25.2.1) The fixes checked on the edited program: a wrong one
    // is taken out (fix/verify.vl)
    if (only & F_SUGGESTED) != 0 && !tcx.no_check
        && !verify_fixes(root, &counts, false, &tcx, &pcx) {
        let d = diag(c"note", c"fix.none", &tcx);
        buf_str(d, c"nothing to fix: every fix was refused (above)\n");
        return 1;
    }
    // More rounds, on the edited program: a fix may let the checker
    // see more (the next unknown name of a statement). (--values: its
    // own fixed point, one round)
    let one_round = only == F_VALUES || only == F_CONV || only == F_CONV_SPELLING
        || only == F_UNNEEDED || only == F_OBSOLETE || (only & F_FSTRING) != 0
        || (only & F_CASTS) != 0 || (only & F_BUF) != 0 || (only & F_RAWPTR) != 0
        || (only & F_STATICS) != 0;
    for _ in 0..if one_round { 0 } else { 4 } {
        if !more_round(root, only_arg, suggested, at, &counts, &tcx, pcx) {
            break;
        }
    }
    if only == F_VALUES {
        // (0.19.1) then a read-only `[T]` given to a `&mut [T]`
        // parameter (own.readonly) made exclusive, `&mut a[..]`,
        // `v.as_mut_slice()`, `v.sort()`: the errors' exact fixes
        more_round(root, c"suggested", true, at, &counts, &tcx, pcx);
    }
    let what = buf_new();
    buf_str(what, c"fixed");
    put_count(what, counts[0], c"missing import", c"missing imports");
    put_count(what, counts[1], c"wildcard import", c"wildcard imports");
    put_count(what, counts[2], c"unused import", c"unused imports");
    put_count(what, counts[3], c"pub", c"pubs");
    put_count(what, counts[4], c"unsafe block", c"unsafe blocks");
    put_count(what, counts[5], c"import through a re-export", c"imports through re-exports");
    put_count(what, counts[6], c"unused re-export", c"unused re-exports");
    put_count(what, counts[7], c"untidy use line", c"untidy use lines");
    put_count(what, counts[8], c"call of 0.14's std", c"calls of 0.14's std");
    put_count(what, counts[9], c"allocation made explicit", c"allocations made explicit");
    put_count(what, counts[10], c"suggested fix", c"suggested fixes");
    put_count(what, unneeded, c"unneeded unsafe block", c"unneeded unsafe blocks");
    put_count(what, obsolete, c"obsolete attribute", c"obsolete attributes");
    put_count(what, formats, c"f-string or format literal", c"f-strings and format literals");
    put_count(what, casts, c"usize cast", c"usize casts");
    put_count(what, bufs, c"Buf site", c"Buf sites");
    // (0.27.0: a run that takes nested calls into lets decides no parameter)
    if tcx.rawptr_hoisted > 0 {
        put_count(what, tcx.rawptr_hoisted, c"nested call taken into a let (run it again)",
            c"nested calls taken into lets (run it again)");
    } else {
        put_count(what, rawptrs, c"raw pointer parameter", c"raw pointer parameters");
    }
    put_count(what, tcx.unneeded_left, c"left as it is (query unsafe lists it)",
        c"left as they are (query unsafe lists them)");
    if valued > 0 {
        put_count(what, tcx.values_counts[0], c"parameter to &mut T", c"parameters to &mut T");
        put_count(what, tcx.values_counts[1], c"parameter to &T", c"parameters to &T");
        put_count(what, tcx.values_counts[2], c"slice parameter to &mut [T]",
            c"slice parameters to &mut [T]");
        put_count(what, tcx.values_counts[3], c"owned parameter to &T (only read)",
            c"owned parameters to &T (only read)");
        put_count(what, tcx.values_counts[4], c"argument", c"arguments");
    }
    if conv > 0 {
        put_count(what, tcx.conv_counts[CC_PARAM_LET], c"parameter to let", c"parameters to let");
        put_count(what, tcx.conv_counts[CC_PARAM_INOUT], c"parameter to inout",
            c"parameters to inout");
        put_count(what, tcx.conv_counts[CC_PARAM_SINK], c"parameter to sink",
            c"parameters to sink");
        put_count(what, tcx.conv_counts[CC_RECEIVER], c"receiver", c"receivers");
        put_count(what, tcx.conv_counts[CC_MARKER], c"'&mut e' to '&e'", c"'&mut e's to '&e'");
        put_count(what, tcx.conv_counts[CC_UNMARKED], c"'&e' to a let", c"'&e's to a let");
        put_count(what, tcx.conv_counts[CC_DEREF], c"'*r' of an access", c"'*r's of accesses");
        put_count(what, tcx.conv_counts[CC_VAR], c"'let mut' / 'mut x' to var",
            c"'let mut's / 'mut x's to var");
        put_count(what, tcx.conv_counts[CC_INOUT_LOCAL], c"inout local", c"inout locals");
        put_count(what, tcx.conv_counts[CC_STATIC], c"static var", c"static vars");
        put_count(what, tcx.conv_counts[CC_SINK_CLOSURE], c"sink closure", c"sink closures");
        put_count(what, tcx.conv_counts[CC_TYPE], c"access type", c"access types");
    }
    let status = finish_edit(buf_slice(what), root, &tcx, &pcx);
    if tcx.ambiguous || tcx.shape_left > 0 || pcx.buf_refused > 0
        || tcx.statics_refused { 1 }
    else { status }
}

// (0.20) --in A,B,...: each resolved (query's --in, the matches adding up);
// whether each matched.
fn resolve_in_list(x: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    var start = 0;
    for i in 0..x.len as i64 + 1 {
        if i == x.len as i64 || x[i] == ',' {
            if i > start && !resolve_in(x[start..i], &tcx, &pcx) {
                return false;
            }
            start = i + 1;
        }
    }
    true
}

// A round of fix on the edited program (`PROG fix --round ... --overlay
// FILE COPY... ROOT`): adds what it fixed to counts. Whether it fixed
// anything.
fn more_round(root: *u8, only_arg: *u8, suggested: bool, at: *u8, counts: inout [i64; 11],
    tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    args.push(pcx.prog as i64);
    args.push(c"fix" as i64);
    args.push(c"--round" as i64);
    if only_arg != 0 as *u8 {
        args.push(c"--only" as i64);
        args.push(only_arg as i64);
    }
    if pcx.opt_in != 0 as *u8 {
        args.push(c"--in" as i64);
        args.push(pcx.opt_in as i64);
    }
    if suggested {
        args.push(c"--suggested" as i64);
    }
    if tcx.codes_arg != 0 as *u8 {
        args.push(c"--codes" as i64);
        args.push(tcx.codes_arg as i64);
    }
    if at != 0 as *u8 {
        args.push(c"--at" as i64);
        args.push(at as i64);
    }
    if tcx.tidy_edited {
        args.push(c"--tidy-edited" as i64);
    }
    if tcx.target_name != 0 as *u8 {
        args.push(c"--target" as i64);
        args.push(tcx.target_name as i64);
    }
    overlay_args(&args, tcx, pcx);
    args.push(root as i64);
    args.push(0);
    let out = buf_new();
    if crate::tools::proc::run_capture(args.data as **u8, out) != 0 {
        return false;
    }
    let t = buf_slice(out);
    var any = false;
    var i = 0;
    while i < t.len as i64 {
        var e = i;
        while e < t.len as i64 && t[e] != '\n' {
            e += 1;
        }
        let line = t[i..e];
        if line.len > 5 && line[0] == 'f' && line[4] == '\t' {
            if copy_rewritten(line[5..line.len], &tcx, pcx) {
                any = true;
            }
        } else if line.len > 6 && line[0] == 'c' && line[5] == '\t' {
            var k = 0;
            var p = 6;
            while p < line.len as i64 && k < 11 {
                var n = 0;
                while p < line.len as i64 && line[p] >= '0' && line[p] <= '9' {
                    n = n * 10 + (line[p] - '0') as i64;
                    p += 1;
                }
                counts[k] += n;
                k += 1;
                p += 1;
            }
        }
        i = e + 1;
    }
    any
}

fn word_is(w: [u8], s: *u8) -> bool {
    crate::tools::proc::same_bytes(w, c_slice(s))
}
