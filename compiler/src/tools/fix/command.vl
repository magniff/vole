    Call, EV_FLAG, EV_MISSING, EV_OPTION, EV_UNKNOWN, EV_WORD, Leaf, flag, option, pair,
};
use crate::front::embed::wgsl::WgslCx;
use crate::front::generics::{TPL_NONE, template_of_key};
use crate::front::modules::{item_key_if_known, module_count, within_std};
use crate::front::modules::lookup::std_item_key;
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::item_node_of;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_count;
use crate::tools::edit::apply::{
    copy_rewritten, finish_edit, overlay_args, prepare_edit, print_round_files, set_command,
    write_round_copies,
};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::fix::{
    missing_use_edits, obsolete_attr_edits, pub_edits, suggested_edits, unused_import_edits,
};
use crate::tools::fix::unneeded::unneeded_unsafe_edits;
use crate::tools::fix::verify::verify_fixes;
use crate::tools::fixconv::{
    CC_DEREF, CC_INOUT_LOCAL, CC_MARKER, CC_PARAM_INOUT, CC_PARAM_LET, CC_PARAM_SINK, CC_RECEIVER,
    CC_SINK_CLOSURE, CC_STATIC, CC_TYPE, CC_UNMARKED, CC_VAR, conventions_edits, conventions_report,
};
use crate::tools::fiximports::fix_imports_edits;
use crate::tools::fixstd015::std015_edits;
use crate::tools::fixunsafe::fix_unsafe_edits;
use crate::tools::fixvalues::values_edits;
use crate::tools::proc::buf_cstr;
