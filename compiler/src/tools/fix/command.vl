// `volec fix`'s command line: the kinds of fix (--only), the
// import paths chosen for a missing name, and the rounds of fixes until
// nothing is left (split from fix).

use std::alloc::Arena;

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_bufs, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{
    Call, EV_FLAG, EV_MISSING, EV_OPTION, EV_UNKNOWN, EV_WORD, Leaf, flag, option, pair,
};
use crate::front::embed::wgsl::WgslCx;
use crate::front::generics::{TPL_NONE, template_of_key};
use crate::front::modules::{item_key_if_known, module_count, within_std};
use crate::front::modules::lookup::std_item_key;
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::item_node_of;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_count;
use crate::tools::edit::apply::{
    copy_rewritten, finish_edit, overlay_args, prepare_edit, print_round_files, set_command,
    write_round_copies,
};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::fix::{
    missing_use_edits, obsolete_attr_edits, pub_edits, suggested_edits, unused_import_edits,
};
use crate::tools::fix::unneeded::unneeded_unsafe_edits;
use crate::tools::fix::verify::verify_fixes;
use crate::tools::fiximports::fix_imports_edits;
use crate::tools::fixunsafe::fix_unsafe_edits;
use crate::tools::proc::buf_cstr;
use crate::tools::query::{c_slice, file_line, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{mod_fqn, mod_fqn_text};
use crate::tools::query::diagnostics::{
    diag, program_errors, put_word, try_begin, try_end, write_diags,
};
use crate::tools::query::refs::{put_bad_in, resolve_in};
use crate::tools::reexports::reexport_edits;
use crate::tools::tidyimports::tidy_import_edits;

const F_IMPORTS: i64 = 1;
const F_UNUSED: i64 = 2;
const F_PUB: i64 = 4;
const F_UNSAFE: i64 = 8;
// (0.12; not in the default: --only tidy-imports, --only reexports)
const F_TIDY: i64 = 16;
const F_REEXPORTS: i64 = 32;
// (0.18: --suggested, `--only suggested`) the errors' exact fixes
// (fix::suggested_edits), with the imports and pubs the errors ask for
const F_SUGGESTED: i64 = 256;
// (0.25.4: `--only unneeded-unsafe`, fix/unneeded.vl) the unsafe blocks with
// nothing unsafe inside, taken away
const F_UNNEEDED: i64 = 4096;
// (0.25.5: `--only unneeded-justified`) the same, the justified blocks too,
// with their comments (UNNEEDED_JUSTIFIED); a word, not a bit of `only`
const F_UNNEEDED_J: i64 = 8192;
// (0.26.0: `--only obsolete-attr`) the obsolete attributes (`#[sealed]`),
// deleted (fix::obsolete_attr_edits)
const F_OBSOLETE: i64 = 16384;
// (0.26.3: allocation as a capability, fix/alloc.vl)
const F_ALLOC: i64 = 262144;
// (0.27.2.1: `--only effects`, contracts-effects.md E3.6) the rust
// edition's undeclared `pub` functions declared (fix/effects.vl);
// `effects-std` prints std's, edits nothing
const F_EFFECTS: i64 = 8388608;
const F_SUGGESTS: i64 = F_IMPORTS | F_PUB | F_SUGGESTED;
const F_ALL: i64 = 15;

// ---- Which module a missing import comes from (0.16) ----

// `--use PATH::NAME` into CHOSEN. False when it has no `::`.
fn take_use(v: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut cut: i64 = -1;
    for i in 1..v.len() as i64 {
        if v[i as usize] == b':' && v[(i - 1) as usize] == b':' {
            cut = i - 1;
        }
    }
    if cut <= 0 || cut + 2 >= v.len() as i64 {
        return false;
    }
    tcx.chosen.push(intern(&v[0..cut as usize], pcx));
    tcx.chosen.push(intern(&v[(cut + 2) as usize..], pcx));
    true
}

// The module whose path is symbol p (`crate::a::b`, `std`), or -1 (std's
// path when std is not read).
fn module_of_path(p: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    for m in 0..module_count(pcx) {
        if m != pcx.c_module && mod_fqn(m, tcx, pcx) == p {
            return m;
        }
    }
    -1
}

// 1 for a value (a function, constant or static), 2 for a type, else 0.
fn key_kind(key: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (pcx.sym_fn[key as usize]) != 0 || (pcx.sym_const[key as usize]) != 0
            || (pcx.sym_static[key as usize]) != 0 {
            1
        }
        else if (pcx.sym_struct[key as usize]) != 0 || (pcx.sym_enum[key as usize]) != 0
            || (pcx.sym_alias[key as usize]) != 0
            || template_of_key(key, pcx) != TPL_NONE {
            2
        } else {
            0
        }
    }
}

// Whether module a is module m or holds it.
fn holds(a: i64, m: i64, pcx: &Ctx<Comp>) -> bool {
    let mut x = m;
    loop {
        if x == a {
            return true;
        }
        if x <= 0 {
            return false;
        }
        x = pcx.modules[x as usize].parent;
    }
}

// Whether module m can name module c's items: each module on c's path is
// public, or its parent holds m.
fn reachable(c: i64, m: i64, pcx: &Ctx<Comp>) -> bool {
    if within_std(c, pcx) {
        // (0.28.0) std's modules: each one on the path below std's root is
        // public (`mod script;` of std::window is not: its `pub fn size` is
        // no item a program can import)
        let mut s = c;
        while s > 0 && s != pcx.std_module && within_std(s, pcx) {
            if !pcx.modules[s as usize].public {
                return false;
            }
            s = pcx.modules[s as usize].parent;
        }
        return true;
    }
    let mut x = c;
    while x > 0 {
        let p = pcx.modules[x as usize].parent;
        if !pcx.modules[x as usize].public && !holds(p, m, pcx) {
            return false;
        }
        x = p;
    }
    true
}

// How near module c is to module m: the depth of the innermost module
// holding both (std: -1, farther than any of the program's), and the
// number of segments of c's path.
fn nearness(c: i64, m: i64, shared: &mut i64, segments: &mut i64, pcx: &Ctx<Comp>) {
    let mut n: i64 = 0;
    let mut x = c;
    while x > 0 {
        n += 1;
        x = pcx.modules[x as usize].parent;
    }
    *segments = if within_std(c, pcx) { 1 } else { n + 1 };
    if within_std(c, pcx) {
        *shared = -1;
        return;
    }
    let mut a = c;
    while !holds(a, m, pcx) {
        a = pcx.modules[a as usize].parent;
    }
    let mut d: i64 = 0;
    while a > 0 {
        d += 1;
        a = pcx.modules[a as usize].parent;
    }
    *shared = d;
}

// Whether module a is nearer to m than module b.
fn nearer(a: i64, b: i64, m: i64, pcx: &Ctx<Comp>) -> bool {
    let mut sa: i64 = 0;
    let mut na: i64 = 0;
    let mut sb: i64 = 0;
    let mut nb: i64 = 0;
    nearness(a, m, &mut sa, &mut na, pcx);
    nearness(b, m, &mut sb, &mut nb, pcx);
    sa > sb || (sa == sb && na < nb)
}

// The path (a symbol) to import `name` from into module m, which the
// checker's help gave as p: when other modules m can name have a public
// item `name` of the same kind, the one --use names, else the nearest
// (the innermost module holding both, then the fewest segments) when no
// other is as near; else -1, after fix.ambiguous.
pub fn choose_path(m: i64, name: i64, p: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let pm = module_of_path(p, tcx, pcx);
    if pm < 0 {
        return p;
    }
    // (0.28.0) a module of std the program cannot name: no import
    if within_std(pm, pcx) && !reachable(pm, m, pcx) {
        return -1;
    }
    // (0.25.2.2) The kind of the item p names: std's re-export followed
    // to its item (the checker's help says `std` for an item of std's
    // modules that std re-exports; std's root has no key for it); no
    // item known, p as it is (key_kind(-1) read before the tables, a
    // crash when that page was unmapped)
    let pkey = if pm == pcx.std_module { std_item_key(name, pcx) }
        else { item_key_if_known(pm, name, pcx) };
    if pkey < 0 {
        return p;
    }
    let kind = key_kind(pkey, pcx);
    let mut cands = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut keys = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for c in 0..module_count(pcx) {
        if c == m || c == pcx.c_module {
            continue;
        }
        let key = item_key_if_known(c, name, pcx);
        if key < 0 {
            continue;
        }
        let item = item_node_of(key, pcx);
        if item == 0 || (pcx.nodes[item as usize].p & ITEM_PUBLIC) == 0
            || key_kind(key, pcx) != kind
            || !reachable(c, m, pcx) {
            continue;
        }
        cands.push(c);
        keys.push(key);
    }
    if cands.len() as i64 <= 1 {
        return p;
    }
    for i in 0..tcx.chosen.len() as i64 / 2 {
        if (tcx.chosen[(2 * i + 1) as usize]) != name {
            continue;
        }
        for k in 0..cands.len() as i64 {
            if mod_fqn((cands[k as usize]), tcx, pcx)
                == (tcx.chosen[(2 * i) as usize]) {
                return (tcx.chosen[(2 * i) as usize]);
            }
        }
    }
    // The nearest; those as near that are another item.
    let mut best: i64 = 0;
    for k in 1..cands.len() as i64 {
        if nearer((cands[k as usize]), (cands[best as usize]), m, pcx) {
            best = k;
        }
    }
    let mut tied = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    tied.push((cands[best as usize]));
    for k in 0..cands.len() as i64 {
        if k != best && (keys[k as usize]) != (keys[best as usize])
            && !nearer((cands[best as usize]), (cands[k as usize]), m, pcx) {
            tied.push((cands[k as usize]));
        }
    }
    if tied.len() as i64 == 1 {
        return mod_fqn((cands[best as usize]), tcx, pcx);
    }
    tcx.ambiguous = true;
    let d = diag(c"error", c"fix.ambiguous", tcx);
    buf_bytes(d, mod_fqn_text(m, tcx, pcx));
    buf_str(d, c" uses '");
    buf_bytes(d, sym_text(name, pcx));
    buf_str(d, c"', which ");
    buf_int(d, tied.len() as i64);
    buf_str(d, c" modules as near have: ");
    for k in 0..tied.len() as i64 {
        if k > 0 {
            buf_str(d, c", ");
        }
        buf_bytes(d, mod_fqn_text((tied[k as usize]), tcx, pcx));
    }
    buf_str(d, c"; nothing is imported for it: name one with --use\n");
    for k in 0..tied.len() as i64 {
        if k == 5 {
            break;
        }
        let out = try_begin(c"fix", c_slice(c""), false, tcx, pcx);
        buf_str(out, c" --only imports --use");
        let path = buf_new();
        buf_bytes(path, mod_fqn_text((tied[k as usize]), tcx, pcx));
        buf_str(path, c"::");
        buf_bytes(path, sym_text(name, pcx));
        put_word(out, buf_slice(path));
        if pcx.opt_in != 0 as *mut u8 {
            buf_str(out, c" --in");
            put_word(out, c_slice(pcx.opt_in));
        }
        try_end(out);
    }
    -1
}

// ---- The command ----

// `N noun` (plural when N is not 1), after a comma when the summary has
// something already.
fn put_count(out: i64, n: i64, one: *mut u8, many: *mut u8) {
    unsafe {
        if n == 0 {
            return;
        }
        if (*get_bufs().add(out as usize)).len > 6 {
            buf_str(out, c",");
        }
        buf_byte(out, b' ');
        buf_int(out, n);
        buf_byte(out, b' ');
        buf_str(out, if n == 1 { one } else { many });
    }
}

// `fix`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn fix_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    table.push(flag("round", "(the hook's round)"));
    table.push(flag("suggested", "the errors' exact fixes"));
    table.push(flag("tidy-edited", "the imports of the files edited, tidied"));
    table.push(flag("fix-imports", "(0.8's spelling of --only imports)"));
    table.push(flag("fix-unsafe", "(0.9's spelling of --only unsafe)"));
    table.push(option("at", "FILE:LINE", "--suggested: one line's errors"));
    table.push(option("codes", "CODE,...",
        "--suggested: only the fixes of errors with these codes"));
    table.push(flag("diff", "the diff of what is written, after the summary"));
    table.push(flag("check-alloc",
        "--only effects-std: std read as built with --check-alloc (the std2 cases)"));
    table.push(option("in", "FILE|MODULE", "only there"));
    table.push(option("use", "PATH::NAME", "the module to import NAME from"));
    table.push(option("only", "KINDS", "imports,unused,pub,unsafe,suggested,..."));
    // (read by main, front/rust: set_edition; accepted here until the flag
    // goes, in 0.29)
    table.push(option("edition", "rust",
        "deprecated and ignored: there is one edition (goes in 0.29)"));
    table.push(pair("overlay", "PATH COPY", "PATH read from COPY"));
    Leaf::new(table, "file")
}

pub fn run_fix(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = run_fix_inner(c, 0, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

// `volec --fix-imports ROOT`, `--fix-unsafe ROOT` (`only`: F_IMPORTS,
// F_UNSAFE): fix, quiet when there is nothing to do.
pub fn run_fix_alias(c: &Call<'_, Gpa>, only: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = run_fix_inner(c, only, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

fn run_fix_inner(c: &Call<'_, Gpa>, alias: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let mut only = if alias != 0 { alias } else { F_ALL };
    let mut only_arg = if alias == F_IMPORTS { c"imports" }
        else if alias == F_UNSAFE { c"unsafe" } else { 0 as *mut u8 };
    let mut round = false;
    let mut suggested = false;
    let mut at = 0 as *mut u8;
    let mut root = 0 as *mut u8;
    let mut path = 0 as *mut u8;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        let a = ev.value;
        let flag_is = ev.kind == EV_FLAG;
        let opt_is = ev.kind == EV_OPTION;
        if flag_is && (ev.name == "fix-imports" || ev.name == "fix-unsafe") {
            if alias != 0 {
                continue;
            }
        } else if flag_is && ev.name == "round" {
            round = true;
            continue;
        } else if flag_is && ev.name == "suggested" {
            suggested = true;
            continue;
        } else if opt_is && ev.name == "at" {
            at = a;
            let s = c_slice(at);
            let mut line_no: i64 = 0;
            let n = file_line(s, &mut line_no);
            if n <= 0 || line_no <= 0 {
                let d = diag(c"error", c"fix.usage", tcx);
                buf_str(d, c"--at takes FILE:LINE, the line of an error\n");
                return 2;
            }
            let f = buf_new();
            buf_bytes(f, &s[0..n as usize]);
            pcx.fix_at_file = buf_cstr(f);
            pcx.fix_at_line = line_no;
            continue;
        } else if opt_is && ev.name == "codes" {
            // (0.25.2.1: the check hook makes the mechanical fixes alone)
            let b = buf_new();
            buf_byte(b, b',');
            buf_str(b, a);
            buf_byte(b, b',');
            tcx.codes = b;
            tcx.codes_arg = a;
            suggested = true;
            continue;
        } else if flag_is && ev.name == "check-alloc" {
            // (0.28.0: std2's cases are built with --check-alloc, its
            // checking Gpa: effects-std prints the declarations they need)
            crate::front::stdalloc::set_check_alloc_mode(true);
            continue;
        } else if flag_is && ev.name == "diff" {
            tcx.show_diff = true;
            continue;
        } else if flag_is && ev.name == "tidy-edited" {
            tcx.tidy_edited = true;
            continue;
        } else if opt_is && ev.name == "in" {
            pcx.opt_in = a;
            continue;
        } else if opt_is && ev.name == "use" {
            if !take_use(c_slice(a), tcx, pcx) {
                let d = diag(c"error", c"fix.usage", tcx);
                buf_str(d, c"--use takes the path of an item, 'crate::a::b::name'\n");
                return 2;
            }
            continue;
        } else if opt_is && ev.name == "overlay" {
            // (its PATH, then its COPY: two values)
            if path == 0 as *mut u8 {
                path = a;
            } else {
                pcx.overlay.push(path as i64);
                pcx.overlay.push(a as i64);
                path = 0 as *mut u8;
            }
            continue;
        } else if opt_is && ev.name == "only" {
            only = 0;
            let v = a;
            only_arg = v;
            let vb = ev.text.as_bytes();
            let mut k: i64 = 0;
            // (a comma-separated list)
            while k < vb.len() as i64 {
                let mut e = k;
                while e < vb.len() as i64 && vb[e as usize] != b',' {
                    e += 1;
                }
                let w = &vb[k as usize..e as usize];
                let bit = if word_is(w, c"imports") { F_IMPORTS }
                    else if word_is(w, c"unused") { F_UNUSED }
                    else if word_is(w, c"pub") { F_PUB }
                    else if word_is(w, c"unsafe") { F_UNSAFE }
                    else if word_is(w, c"tidy-imports") { F_TIDY }
                    else if word_is(w, c"reexports") { F_REEXPORTS }
                    else if word_is(w, c"unneeded-unsafe") { F_UNNEEDED }
                    else if word_is(w, c"unneeded-justified") { F_UNNEEDED_J }
                    else if word_is(w, c"obsolete-attr") { F_OBSOLETE }
                    else if word_is(w, c"alloc") { F_ALLOC }
                    else if word_is(w, c"effects") { F_EFFECTS }
                    else if word_is(w, c"effects-std") || word_is(w, c"effects-std-all") {
                        // (-all: every std2 body checked, as --std2-check)
                        tcx.effects_std = true;
                        if word_is(w, c"effects-std-all") {
                            crate::places::borrowck::std2::set_std2_check(true);
                        }
                        F_EFFECTS
                    }
                    else if word_is(w, c"suggested") { F_SUGGESTS } else { 0 };
                if bit == 0 {
                    let d = diag(c"error", c"fix.usage", tcx);
                    buf_str(d, c"--only takes imports, unused, pub, unsafe, suggested, tidy-imports, reexports, unneeded-unsafe, unneeded-justified, obsolete-attr, alloc, effects, effects-std or effects-std-all, not '");
                    buf_bytes(d, w);
                    buf_str(d, c"'\n");
                    return 2;
                }
                if bit == F_UNNEEDED_J {
                    tcx.unneeded_justified = true;
                    only |= F_UNNEEDED;
                } else {
                    only |= bit;
                }
                k = if e < vb.len() as i64 && vb[e as usize] == b',' { e + 1 } else { e };
            }
            continue;
        } else if ev.kind == EV_MISSING && (ev.name == "at" || ev.name == "in"
            || ev.name == "use" || ev.name == "only"
            || ev.name == "overlay" || ev.name == "codes") {
            ev.kind = EV_UNKNOWN;
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
            continue;
        }
        if ev.kind != EV_WORD || ev.text.starts_with("-") {
            let d = diag(c"error", c"fix.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"'\n");
            let out = try_begin(c"fix", c_slice(c""), false, tcx, pcx);
            try_end(out);
            return 2;
        }
        if root != 0 as *mut u8 {
            let d = diag(c"error", c"fix.usage", tcx);
            buf_str(d, c"one ROOT (the program's root file), not '");
            buf_str(d, a);
            buf_str(d, c"'\n");
            return 2;
        }
        root = a;
    }
    if suggested {
        only = if only_arg == 0 as *mut u8 { F_SUGGESTS } else { only | F_SUGGESTS };
    }
    if (only & F_ALLOC) != 0 {
        // (the allocator rules' exact fixes, by their codes)
        tcx.codes = crate::tools::fix::alloc::alloc_codes();
        tcx.alloc_rounds = true;
        only = F_SUGGESTED;
    }
    if tcx.codes >= 0 {
        // (0.25.2.1: --codes: those errors' exact fixes alone, no
        // import, no pub)
        only = F_SUGGESTED;
    }
    if (only & F_SUGGESTED) != 0 {
        tcx.left_ok = true;
    } else if at != 0 as *mut u8 {
        let d = diag(c"error", c"fix.usage", tcx);
        buf_str(d, c"--at is for --suggested: the fixes of the errors at a line\n");
        return 2;
    }
    tcx.root_given = root;
    // (0.25.2: std's files edited: fixed with them, as check reads them)
    crate::tools::edit::cli::std_tree_if_edited(tcx, pcx);
    root = root_or_diag(root, c"fix", c_slice(c""), false, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    pcx.fix_imports = (only & F_IMPORTS) != 0;
    pcx.fix_unsafe = (only & F_UNSAFE) != 0;
    // (0.25.4: unneeded-unsafe asks the checker which unsafe blocks hold
    // an unsafe operation, as `query unsafe` does)
    if (only & F_UNNEEDED) != 0 {
        pcx.audit_unsafe = true;
    }
    // (0.27.2.1: effects reads the inferred sets: inferred at every -O)
    if (only & F_EFFECTS) != 0 {
        pcx.effects_wanted = true;
    }
    if !load_program(root, tcx.target, tcx, pcx, wgx) {
        // (0.18) a program that does not parse: its errors' exact
        // fixes alone (a Rust label respelled)
        if (only & F_SUGGESTED) == 0 || pcx.suggested.len() as i64 == 0
            || pcx.opt_in != 0 as *mut u8 {
            program_errors(c"error", root, true, tcx, pcx);
            return 1;
        }
        only = F_SUGGESTED;
    }
    if pcx.opt_in != 0 as *mut u8 && !resolve_in_list(c_slice(pcx.opt_in), tcx, pcx) {
        let d = diag(c"error", c"fix.bad-in", tcx);
        put_bad_in(d, pcx.opt_in, tcx);
        return 1;
    }
    // The fixes (an edit overlapping one made before is left for the
    // next run).
    let wild: i64 = if (only & F_IMPORTS) != 0 && pcx.legacy_imports { fix_imports_edits(pcx) }
        else { 0 };
    let imports: i64 = if (only & F_IMPORTS) != 0 { missing_use_edits(tcx, pcx) } else { 0 };
    let unused: i64 = if (only & F_UNUSED) != 0 { unused_import_edits(0 as *mut IntVec, pcx) }
        else { 0 };
    let public: i64 = if (only & F_PUB) != 0 { pub_edits(tcx, pcx) } else { 0 };
    tcx.whole_bodies = alias == 0;
    let wrapped: i64 = if (only & F_UNSAFE) != 0 { fix_unsafe_edits(tcx, pcx) } else { 0 };
    let mut dropped: i64 = 0;
    let through: i64 = if (only & F_REEXPORTS) != 0 { reexport_edits(&mut dropped, tcx, pcx) }
        else { 0 };
    let tidied: i64 = if (only & F_TIDY) != 0 { tidy_import_edits(tcx, pcx) } else { 0 };
    // (0.15's std015, removed in 0.28.0 with the old std)
    let migrated: i64 = 0;
    // (0.16's alloc016, removed in 0.26.3 with std's ambient functions: fix --only alloc)
    let explicit: i64 = 0;
    let exact: i64 = if (only & F_SUGGESTED) != 0 { suggested_edits(tcx, pcx) } else { 0 };
    let unneeded: i64 = if (only & F_UNNEEDED) != 0 { unneeded_unsafe_edits(tcx, pcx) } else { 0 };
    let obsolete: i64 = if (only & F_OBSOLETE) != 0 { obsolete_attr_edits(pcx) } else { 0 };
    let declared: i64 = if (only & F_EFFECTS) != 0 {
        crate::tools::fix::effects::effects_edits(tcx.effects_std, pcx)
    } else {
        0
    };
    if (only & F_EFFECTS) != 0 && !round {
        let d = diag(c"note", c"fix.effects", tcx);
        buf_int(d, declared);
        buf_str(d, if tcx.effects_std { c" std declarations printed\n" }
            else { c" effect declarations\n" });
        if tcx.effects_std {
            return 0;
        }
    }
    let mut counts = [imports, wild, unused, public, wrapped, through, dropped, tidied,
        migrated, explicit, exact];
    if round {
        // (a later round, on the edited program: what it fixed, the
        // copies it rewrote)
        if edit_count(tcx, pcx) == 0 {
            return 0;
        }
        // (0.25.2.1: the round's fixes checked on its copies first,
        // fix/verify.vl)
        if !write_round_copies(tcx, pcx) {
            return 1;
        }
        if (only & F_SUGGESTED) != 0 && !tcx.no_check
            && !verify_fixes(root, &mut counts, true, tcx, pcx) {
            return 0;
        }
        let out = buf_new();
        buf_str(out, c"count");
        for k in 0..11 {
            buf_byte(out, b'\t');
            buf_int(out, counts[k as usize]);
        }
        buf_byte(out, b'\n');
        buf_write_fd(out, STDOUT);
        print_round_files(tcx, pcx);
        return 0;
    }
    if edit_count(tcx, pcx) == 0 {
        if tcx.ambiguous || tcx.shape_left > 0 {
            return 1;
        }
        if alias == 0 {
            let d = diag(c"note", c"fix.none", tcx);
            buf_str(d, c"nothing to fix\n");
        }
        return 0;
    }
    let status = prepare_edit(tcx, pcx);
    if status >= 0 {
        return status;
    }
    // (0.25.2.1) The fixes checked on the edited program: a wrong one
    // is taken out (fix/verify.vl)
    if (only & F_SUGGESTED) != 0 && !tcx.no_check
        && !verify_fixes(root, &mut counts, false, tcx, pcx) {
        let d = diag(c"note", c"fix.none", tcx);
        buf_str(d, c"nothing to fix: every fix was refused (above)\n");
        return 1;
    }
    // More rounds, on the edited program: a fix may let the checker
    // see more (the next unknown name of a statement).
    let one_round = only == F_UNNEEDED || only == F_OBSOLETE || (only & F_EFFECTS) != 0;
    for _ in 0..if one_round { 0 } else { 4 } {
        if !more_round(root, only_arg, suggested, at, &mut counts, tcx, pcx) {
            break;
        }
    }
    let what = buf_new();
    buf_str(what, c"fixed");
    put_count(what, counts[0], c"missing import", c"missing imports");
    put_count(what, counts[1], c"wildcard import", c"wildcard imports");
    put_count(what, counts[2], c"unused import", c"unused imports");
    put_count(what, counts[3], c"pub", c"pubs");
    put_count(what, counts[4], c"unsafe block", c"unsafe blocks");
    put_count(what, counts[5], c"import through a re-export", c"imports through re-exports");
    put_count(what, counts[6], c"unused re-export", c"unused re-exports");
    put_count(what, counts[7], c"untidy use line", c"untidy use lines");
    put_count(what, counts[8], c"call of 0.14's std", c"calls of 0.14's std");
    put_count(what, counts[9], c"allocation made explicit", c"allocations made explicit");
    put_count(what, counts[10], c"suggested fix", c"suggested fixes");
    put_count(what, unneeded, c"unneeded unsafe block", c"unneeded unsafe blocks");
    put_count(what, obsolete, c"obsolete attribute", c"obsolete attributes");
    put_count(what, tcx.unneeded_left, c"left as it is (query unsafe lists it)",
        c"left as they are (query unsafe lists them)");
    let status = finish_edit(buf_slice(what), root, tcx, pcx);
    if tcx.ambiguous || tcx.shape_left > 0 { 1 }
    else { status }
}

// (0.20) --in A,B,...: each resolved (query's --in, the matches adding up);
// whether each matched.
fn resolve_in_list(x: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut start: i64 = 0;
    for i in 0..x.len() as i64 + 1 {
        if i == x.len() as i64 || x[i as usize] == b',' {
            if i > start && !resolve_in(&x[start as usize..i as usize], tcx, pcx) {
                return false;
            }
            start = i + 1;
        }
    }
    true
}

// A round of fix on the edited program (`PROG fix --round ... --overlay
// FILE COPY... ROOT`): adds what it fixed to counts. Whether it fixed
// anything.
fn more_round(root: *mut u8, only_arg: *mut u8, suggested: bool, at: *mut u8,
    counts: &mut [i64; 11], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    args.push(pcx.prog as i64);
    args.push(c"fix" as i64);
    args.push(c"--round" as i64);
    if only_arg != 0 as *mut u8 {
        args.push(c"--only" as i64);
        args.push(only_arg as i64);
    }
    if pcx.opt_in != 0 as *mut u8 {
        args.push(c"--in" as i64);
        args.push(pcx.opt_in as i64);
    }
    if suggested {
        args.push(c"--suggested" as i64);
    }
    if tcx.codes_arg != 0 as *mut u8 {
        args.push(c"--codes" as i64);
        args.push(tcx.codes_arg as i64);
    }
    if at != 0 as *mut u8 {
        args.push(c"--at" as i64);
        args.push(at as i64);
    }
    if tcx.tidy_edited {
        args.push(c"--tidy-edited" as i64);
    }
    if tcx.target_name != 0 as *mut u8 {
        args.push(c"--target" as i64);
        args.push(tcx.target_name as i64);
    }
    overlay_args(&mut args, tcx, pcx);
    args.push(root as i64);
    args.push(0);
    let out = buf_new();
    if crate::tools::proc::run_capture(args.data as *mut *mut u8, out) != 0 {
        return false;
    }
    let t = buf_slice(out);
    let mut any = false;
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        let mut e = i;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        let line = &t[i as usize..e as usize];
        if line.len() > 5 && line[0] == b'f' && line[4] == b'\t' {
            if copy_rewritten(&line[5..line.len()], tcx, pcx) {
                any = true;
            }
        } else if line.len() > 6 && line[0] == b'c' && line[5] == b'\t' {
            let mut k: i64 = 0;
            let mut p: i64 = 6;
            while p < line.len() as i64 && k < 11 {
                let mut n: i64 = 0;
                while p < line.len() as i64 && line[p as usize] >= b'0'
                    && line[p as usize] <= b'9' {
                    n = n * 10 + (line[p as usize] - b'0') as i64;
                    p += 1;
                }
                counts[k as usize] += n;
                k += 1;
                p += 1;
            }
        }
        i = e + 1;
    }
    any
}

fn word_is(w: &[u8], s: *mut u8) -> bool {
    crate::tools::proc::same_bytes(w, c_slice(s))
}
