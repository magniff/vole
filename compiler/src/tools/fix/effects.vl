// `fix --only effects` (0.27.2.1, docs/design/contracts-effects.md E3.6):
// every undeclared `pub` function and inherent `pub` method of the rust
// edition (front/effects/check.vl: declarable) gets `#[effects(..)]`, the
// list of its set on the line above it. A non-generic one's is its
// inferred set; a generic one's the union, over the program's instances,
// of what each does itself and through callees not made for a type
// argument (front/effects/infer.vl: own_effects), with an allocator that
// is a type argument written `alloc(P)` and each parameter an edge was
// made for listed (E3.3a). `--only effects-std` prints std's instead, a
// line each, `<std>:LINE<TAB>THE LINE TO INSERT`, for
// tools/std2-effects.py to write into compiler/std (std is built in).

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::child;
use crate::front::effects::{
    ALLOC_ANY, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_IO, EFF_PANIC, EFF_SYNC, EFF_THREAD,
    EFF_TLS, EFF_UNKNOWN, EFF_UNSAFE, Effects, fn_effects,
};
use crate::front::effects::check::declarable;
use crate::front::effects::infer::{body_walked, own_effects};
use crate::front::modules::{file_of_pos, within_std};
use crate::front::types::buf_type;
use crate::tools::edit::edit_replace;

// The declarations made: one for each declarable function with an
// instance (or a walked body); with std, printed rather than edited.
// RULE: E3.6
pub fn effects_edits(std: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let n = pcx.fn_effects_count;
    if n == 0 {
        return 0;
    }
    // (per template: 0 none, else 1 + its gathered entry, four words in
    // GOT: the template, its bits, its allocators, its parameters, and
    // the allocator parameters in a fifth)
    let mut slot = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for _ in 0..n {
        slot.push(0);
    }
    let mut got = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for f in 0..n {
        let t = if pcx.fns[f as usize].tmpl != 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
        if t >= n || pcx.fns[f as usize].generic > 0 || !body_walked(f, pcx)
            || crate::front::effects::infer::error_instance(f, pcx)
            || within_std(pcx.fns[t as usize].module, pcx) != std || !declarable(t, pcx) {
            continue;
        }
        if (fn_effects(f, pcx).bits & EFF_UNKNOWN) != 0 {
            continue;
        }
        let (own, params) = own_effects(f, pcx);
        let mut fx = own;
        let mut alloc_params: i64 = 0;
        let count: i64 = if pcx.fns[f as usize].targ_count < 63 { pcx.fns[f as usize].targ_count }
            else { 63 };
        for j in 0..count {
            let bit = known_allocator_bit(type_arg(f, j, pcx), pcx);
            if bit != 0 && (fx.allocs & ALLOC_ANY) == 0 && (fx.allocs & bit) != 0 {
                alloc_params |= 1 << j;
                fx.allocs &= !bit;
            }
        }
        if slot.get(t) == 0 {
            slot.set(t, got.count / 5 + 1);
            got.push(t);
            got.push(0);
            got.push(0);
            got.push(0);
            got.push(0);
        }
        let at = (slot.get(t) - 1) * 5;
        got.set(at + 1, got.get(at + 1) | fx.bits);
        got.set(at + 2, got.get(at + 2) | fx.allocs);
        got.set(at + 3, got.get(at + 3) | params);
        got.set(at + 4, got.get(at + 4) | alloc_params);
    }
    let printed = buf_new();
    let mut made: i64 = 0;
    let mut k: i64 = 0;
    while k < got.count {
        let t = got.get(k);
        let e = Effects { bits: got.get(k + 1), allocs: got.get(k + 2) };
        let line = buf_new();
        let start = line_start(pcx.nodes[pcx.fns[t as usize].node as usize].start);
        let mut i = start;
        while get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\t' {
            buf_byte(line, get_src()[i as usize]);
            i += 1;
        }
        put_declaration(line, t, e, got.get(k + 3), got.get(k + 4), pcx);
        buf_byte(line, b'\n');
        if std {
            let file = file_of_pos(start, pcx);
            buf_str(printed, c"<std>:");
            buf_int(printed, line_number(pcx.files[file as usize].start, start));
            buf_byte(printed, b'\t');
            buf_bytes(printed, crate::base::buf_slice(line));
            made += 1;
        } else if edit_replace(start, start, line, pcx) {
            made += 1;
        }
        k += 5;
    }
    if std {
        buf_write_fd(printed, STDOUT);
    }
    made
}

// The bit of type t in ALLOCATORS when it is one already (0: not an
// allocator any set names).
fn known_allocator_bit(t: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: ALLOCATORS' words, by index.
    // SAFETY: i < its count.
    unsafe {
        for i in 0..pcx.allocators.count {
            if (*pcx.allocators.data.add(i as usize)) == t && i < 63 {
                return 1 << i;
            }
        }
    }
    0
}

// Type argument j of instance f.
fn type_arg(f: i64, j: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: TLISTS' word, by index.
    // SAFETY: j < f's targ_count (the callers' loop), so targs + j is in it.
    unsafe { (*pcx.tlists.data.add((pcx.fns[f as usize].targs + j) as usize)) }
}

// The name of template t's type parameter j, or -1.
fn param_name(t: i64, j: i64, pcx: &Ctx<Comp>) -> i64 {
    let g = pcx.nodes[pcx.fns[t as usize].node as usize].g;
    if g <= 0 || j >= pcx.nodes[g as usize].count { -1 }
    else { pcx.nodes[child(g, j, pcx) as usize].a }
}

// Type t, or what it points to when it is a reference or a pointer.
fn pointee(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if t > 0
        && pcx.types[t as usize].kind
        == crate::front::types::TyKind::Ptr { pcx.types[t as usize].a } else { t }
}

// `#[effects(alloc(P, Gpa, extern), io, static, tls, thread, sync, panic,
// diverge, unsafe, T, F)]`: set e, the allocator parameters alloc_params
// and the parameters params (bit j: template t's parameter j).
fn put_declaration(out: i64, t: i64, e: Effects, params: i64, alloc_params: i64,
    pcx: &Ctx<Comp>) {
    buf_str(out, c"#[effects(");
    let mut first = true;
    if e.allocs != 0 || alloc_params != 0 || (e.bits & EFF_ALLOC_EXTERN) != 0 {
        buf_str(out, c"alloc");
        if (e.allocs & ALLOC_ANY) == 0 {
            buf_byte(out, b'(');
            let mut n: i64 = 0;
            for j in 0..63 {
                if (alloc_params & (1 << j)) != 0 && param_name(t, j, pcx) >= 0 {
                    if n > 0 {
                        buf_str(out, c", ");
                    }
                    buf_bytes(out, sym_text(param_name(t, j, pcx), pcx));
                    n += 1;
                }
            }
            // UNSAFE: ALLOCATORS' words, by index.
            // SAFETY: i < its count.
            unsafe {
                for i in 0..pcx.allocators.count {
                    if i < 63 && (e.allocs & (1 << i)) != 0 {
                        // (alloc(&A) is alloc(A), E2: the pointee, once)
                        let t = pointee((*pcx.allocators.data.add(i as usize)), pcx);
                        let mut seen = false;
                        for k in 0..i {
                            if (e.allocs & (1 << k)) != 0
                                && pointee((*pcx.allocators.data.add(k as usize)), pcx) == t {
                                seen = true;
                            }
                        }
                        if seen {
                            continue;
                        }
                        if n > 0 {
                            buf_str(out, c", ");
                        }
                        buf_type(out, t, pcx);
                        n += 1;
                    }
                }
            }
            if (e.bits & EFF_ALLOC_EXTERN) != 0 {
                if n > 0 {
                    buf_str(out, c", ");
                }
                buf_str(out, c"extern");
            }
            buf_byte(out, b')');
        }
        first = false;
    }
    let names: [*mut u8; 9] = [c"io", c"static", c"tls", c"thread", c"sync", c"panic", c"diverge",
        c"unsafe", c""];
    let bits: [i64; 9] = [EFF_IO, EFF_GLOBAL, EFF_TLS, EFF_THREAD, EFF_SYNC, EFF_PANIC,
        EFF_DIVERGE, EFF_UNSAFE, 0];
    for k in 0..8 {
        if (e.bits & bits[k as usize]) != 0 {
            if !first {
                buf_str(out, c", ");
            }
            buf_str(out, names[k as usize]);
            first = false;
        }
    }
    for j in 0..63 {
        if (params & (1 << j)) != 0 && param_name(t, j, pcx) >= 0 {
            if !first {
                buf_str(out, c", ");
            }
            buf_bytes(out, sym_text(param_name(t, j, pcx), pcx));
            first = false;
        }
    }
    buf_str(out, c")]");
}

// The start of the line position pos is on.
fn line_start(pos: i64) -> i64 {
    let mut s = pos;
    while s > 0 && get_src()[(s - 1) as usize] != b'\n' {
        s -= 1;
    }
    s
}

// The line number of position pos in the file starting at from.
fn line_number(from: i64, pos: i64) -> i64 {
    let mut line: i64 = 1;
    for i in from..pos {
        if get_src()[i as usize] == b'\n' {
            line += 1;
        }
    }
    line
}
