// `volec fix --only casts` (0.26.3): the `as i64` conversions of a usize
// (a length, `s.len as i64`, `v.len() as i64`) taken away where the value
// means the same as a usize: so that a length stays a usize.
//
// A cast goes when every place its value reaches takes a usize and does
// the same with it (the value is a length, below 2^63, never negative):
//
//   (1) an index, `a[n as i64]`, or an end of a slicing, `a[i..n as i64]`
//       whose other end is a usize too (or absent, or a literal); and the
//       end of `a[i..a.len as i64]` (`a.len()`), a slicing to a's own end
//       whatever i is: it becomes `a[i..]` (a is a name or its fields);
//   (2) a comparison with a usize: another length, a literal at least 0,
//       a usize expression, or a value this fix makes a usize; never `< 0`
//       or `>= 0`, whose answer depends on the sign;
//   (3) the end of a `for i in A..n as i64` whose other end is a usize,
//       and whose counter i reaches only (1), (2), (3), (4) or a cast;
//   (4) the value of a `let x = n as i64;` (not `var`, no type written)
//       whose x reaches only (1), (2), (3), (4) or a cast.
//
// Everything else keeps its cast, and is counted by where the value goes:
// arithmetic (`-` may go below 0; the others are counted apart), a value
// stored as an i64 (a field, an argument, a returned value, an assignment),
// a comparison with an i64, or another use. So is a cast copied by the
// checker (a generic function's instances, a contract's check), and one
// whose value a closure reaches. Each decision is the fixed point of the
// rules above, over the whole program; the edited program is then checked
// (a fix whose result does not check is refused, as every fix's).

use crate::base::{SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{CONV_NEW, NODE_IMPLICIT, NodeKind, child};
use crate::front::check::Res;
use crate::front::generics::instantiate::{node_field_a, node_field_b, node_field_c};
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::types::{TY_I64, TY_USIZE};
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::refs::ref_in;

// Where a cast's value goes (the census, CAST_COUNTS); CK_INDEX to CK_LET
// and CK_SLICE_END are removed when the fixed point keeps them.
pub const CK_INDEX: i64 = 0;
pub const CK_COMPARE: i64 = 1;
pub const CK_LOOP: i64 = 2;
pub const CK_LET: i64 = 3;
// (kept) `-`, or `-=`
pub const CK_SUB: i64 = 4;
// (kept) `+ * / % & | ^ << >>`
pub const CK_ARITH: i64 = 5;
// (kept) a comparison with an i64 (a counter `var i = 0`), or by its sign
pub const CK_CMP_I64: i64 = 6;
// (kept) a field, a struct literal, an argument, a returned value, an
// assignment, a `var`, a `let` with a type
pub const CK_STORED: i64 = 7;
// (kept) anything else: a match, a format argument, a method's receiver
pub const CK_OTHER: i64 = 8;
// (kept) a candidate of (1)-(4) whose fixed point refused it: a counter or
// a local that reaches something else
pub const CK_REFUSED: i64 = 9;
// (kept) copied by the checker (a node with two parents: a generic
// instance's, a contract's, a tail value's), or reached by a closure
pub const CK_COPIED: i64 = 10;
// `a[i..a.len as i64]` to `a[i..]` (removed)
pub const CK_SLICE_END: i64 = 11;
// (not counted above) `x as i64` of an i64: no conversion at all
pub const CK_NOOP: i64 = 12;
// (not counted above) a conversion of another type (u8, bool, an enum, a
// pointer)
pub const CK_NOT_USIZE: i64 = 13;
const CK_N: i64 = 14;

const MULTI: i64 = -1;
const ST_OK: i64 = 1;
const ST_NO: i64 = 2;

// Whether pos is in a file of the program (std's paths start with `<`).
fn user_pos(pos: i64, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: FILES is the loader's table of source files, a raw pointer (base).
    // SAFETY: file_of_pos gives the index of a loaded file, and every path is NUL-terminated.
    unsafe { pcx.files[file_of_pos(pos, pcx)].path[0] != '<' }
}

fn parent(n: i64, tcx: Tcx<Comp>) -> i64 {
    let p = tcx.casts_parent.get(n + 1);
    if p <= 0 { -1 } else { p - 1 }
}

fn set_parent(c: i64, n: i64, tcx: inout Tcx<Comp>) {
    if c <= 0 {
        return;
    }
    let old = tcx.casts_parent.get(c + 1);
    if old == 0 {
        tcx.casts_parent.put(c + 1, n + 1);
    } else if old != n + 1 {
        tcx.casts_parent.put(c + 1, MULTI);
    }
}

fn is_blank(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

// Where the ` as i64` of cast n starts (the end of its operand's text), or
// -1 when n is not written so (a cast the checker made).
fn as_start(n: i64, pcx: Ctx<Comp>) -> i64 {
    let e = pcx.nodes[n].end;
    let s = pcx.nodes[n].start;
    if e - s < 7 || e > SRC.len as i64 || SRC[e - 3] != 'i' || SRC[e - 2] != '6'
        || SRC[e - 1] != '4' {
        return -1;
    }
    var p = e - 3;
    if !is_blank(SRC[p - 1]) {
        return -1;
    }
    while p > s && is_blank(SRC[p - 1]) {
        p -= 1;
    }
    if p - 2 <= s || SRC[p - 1] != 's' || SRC[p - 2] != 'a' || !is_blank(SRC[p - 3]) {
        return -1;
    }
    p -= 2;
    while p > s && is_blank(SRC[p - 1]) {
        p -= 1;
    }
    p
}

// Whether n is an integer literal at least 0 with no suffix.
fn plain_literal(n: i64, pcx: Ctx<Comp>) -> bool {
    n > 0 && pcx.nodes[n].kind == NodeKind::Int && pcx.nodes[n].a >= 0 && pcx.nodes[n].b == 0
}

// The candidate expression n stands for: a cast candidate, or a use of a
// local candidate (its PatBind); -1.
fn unit_of(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if n <= 0 {
        return -1;
    }
    if pcx.nodes[n].kind == NodeKind::Cast && tcx.state.get(n + 1) != 0 {
        return n;
    }
    if pcx.nodes[n].kind == NodeKind::Ident && pcx.nodes[n].res == Res::Local {
        let b = tcx.local_bind.get(pcx.nodes[n].y + 1);
        if b > 0 && tcx.state.get(b) != 0 {
            return b - 1;
        }
    }
    -1
}

fn ok(u: i64, tcx: Tcx<Comp>) -> bool {
    tcx.state.get(u + 1) == ST_OK
}

// Whether partner o of a comparison or a range is a usize as it is, or
// will be: a literal, a usize, a candidate kept so far.
fn usize_partner(o: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if plain_literal(o, pcx) || o > 0 && pcx.nodes[o].ty == TY_USIZE {
        return true;
    }
    let u = unit_of(o, tcx, pcx);
    u >= 0 && ok(u, tcx)
}

fn is_compare(op: Tok) -> bool {
    op == Tok::EqEq || op == Tok::BangEq || op == Tok::Lt || op == Tok::LtEq || op == Tok::Gt
        || op == Tok::GtEq
}

// A local candidate for the binding of `let` (or the counter of `for`) p:
// its PatBind, when it may become one (not `var`, no type, no closure),
// else -1.
fn local_unit(pat: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if pat <= 0 || pcx.nodes[pat].kind != NodeKind::PatBind || pcx.nodes[pat].b != 0
        || pcx.nodes[pat].x < 0 || pcx.nodes[pat].count != 0 {
        return -1;
    }
    if tcx.state.get(pat + 1) == 0 {
        tcx.state.put(pat + 1, ST_OK);
        tcx.local_bind.put(pcx.nodes[pat].x + 1, pat + 1);
        tcx.local_units.push(pat);
    }
    pat
}

// Where the value of expression e goes (CK_*), for a candidate e (a cast,
// or a use of a local candidate); with what it needs kept in *needs (a
// candidate, or -1) and whether the rule holds now in *holds.
fn context(e: i64, holds: inout bool, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    holds = false;
    let p = parent(e, tcx);
    if p < 0 {
        return CK_COPIED;
    }
    let k = pcx.nodes[p].kind;
    if k == NodeKind::Index {
        if pcx.nodes[p].b == e {
            holds = true;
            return CK_INDEX;
        }
        return CK_OTHER;
    }
    if k == NodeKind::Range {
        let other = if pcx.nodes[p].a == e { pcx.nodes[p].b } else { pcx.nodes[p].a };
        let other_ok = other <= 0 || usize_partner(other, tcx, pcx);
        let q = parent(p, tcx);
        if q >= 0 && pcx.nodes[q].kind == NodeKind::Index && pcx.nodes[q].b == p {
            if !other_ok && pcx.nodes[p].b == e && pcx.nodes[p].c == 0
                && own_end(pcx.nodes[q].a, e, pcx) {
                holds = true;
                return CK_SLICE_END;
            }
            holds = other_ok;
            return CK_INDEX;
        }
        if q >= 0 && pcx.nodes[q].kind == NodeKind::For && pcx.nodes[q].c == p
            && pcx.nodes[p].b == e {
            let l = local_unit(pcx.nodes[q].b, &tcx, pcx);
            holds = other_ok && other > 0 && l >= 0 && ok(l, tcx);
            return CK_LOOP;
        }
        return CK_OTHER;
    }
    if k == NodeKind::Binary {
        let op = pcx.nodes[p].op;
        let left = pcx.nodes[p].b == e;
        let other = if left { pcx.nodes[p].c } else { pcx.nodes[p].b };
        if is_compare(op) {
            // (by its sign: `n < 0`, `n >= 0`, `0 > n`, `0 <= n`)
            let zero = plain_literal(other, pcx) && pcx.nodes[other].a == 0;
            if zero && (left && (op == Tok::Lt || op == Tok::GtEq)
                || !left && (op == Tok::Gt || op == Tok::LtEq)) {
                return CK_CMP_I64;
            }
            if usize_partner(other, tcx, pcx) {
                holds = true;
                return CK_COMPARE;
            }
            return CK_CMP_I64;
        }
        if op == Tok::Minus {
            return CK_SUB;
        }
        return CK_ARITH;
    }
    if k == NodeKind::Let && pcx.nodes[p].c == e {
        if pcx.nodes[p].b != 0 || (pcx.nodes[p].p & CONV_NEW) != 0 {
            return CK_STORED;
        }
        let l = local_unit(pcx.nodes[p].a, &tcx, pcx);
        if l < 0 {
            return CK_STORED;
        }
        holds = ok(l, tcx);
        return CK_LET;
    }
    if k == NodeKind::Cast && pcx.nodes[p].a == e && pcx.nodes[e].kind == NodeKind::Ident {
        // (a local's use converted again: the same value either way)
        holds = true;
        return CK_OTHER;
    }
    if k == NodeKind::Assign {
        return if pcx.nodes[p].op == Tok::MinusEq { CK_SUB } else { CK_STORED };
    }
    if k == NodeKind::FieldInit || k == NodeKind::Return || k == NodeKind::Call
        || k == NodeKind::MethodCall || k == NodeKind::StructLit || k == NodeKind::NamedArg {
        return CK_STORED;
    }
    CK_OTHER
}

// Whether n's text is a name or a name's fields (`a`, `self.b.c`).
fn pure_path(n: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[n].kind;
    if k != NodeKind::Ident && k != NodeKind::FieldAccess {
        return false;
    }
    for i in pcx.nodes[n].start..pcx.nodes[n].end {
        let c = SRC[i];
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '_' || c == '.') {
            return false;
        }
    }
    true
}

// Whether cast e (`X.len as i64`, `X.len() as i64`) is the length of
// base, the slice or Vec it slices: X's text is base's, a pure path.
fn own_end(base: i64, e: i64, pcx: Ctx<Comp>) -> bool {
    if base <= 0 || !pure_path(base, pcx) {
        return false;
    }
    let b = SRC[pcx.nodes[base].start..pcx.nodes[base].end];
    let s = pcx.nodes[e].start;
    let w = pcx.nodes[pcx.nodes[e].a].end;
    let x = SRC[s..w];
    let n = b.len as i64;
    if x.len as i64 == n + 4 && x[n..n + 4] == ".len" || x.len as i64 == n + 6
        && x[n..n + 6] == ".len()" {
        return x[0..n] == b;
    }
    false
}

// Where the `..` of the slicing whose end is e ends, or -1.
fn dots_end(e: i64, pcx: Ctx<Comp>) -> i64 {
    var p = pcx.nodes[e].start;
    while p > 0 && is_blank(SRC[p - 1]) {
        p -= 1;
    }
    if p >= 2 && SRC[p - 1] == '.' && SRC[p - 2] == '.' { p } else { -1 }
}

// Whether node n is in a closure (by its position).
fn in_closure(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    let pos = pcx.nodes[n].start;
    var i = 0;
    while i + 1 < tcx.closures.count {
        if pos >= tcx.closures.get(i) && pos < tcx.closures.get(i + 1) {
            return true;
        }
        i += 2;
    }
    false
}

// Whether candidate u holds now: a cast by its context, a local by all its
// uses.
fn holds_now(u: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if pcx.nodes[u].kind == NodeKind::Cast {
        if tcx.casts_spans.get(pcx.nodes[u].start + 1) > 1 || in_closure(u, tcx, pcx) {
            return false;
        }
        var h = false;
        context(u, &h, &tcx, pcx);
        return h;
    }
    // a local: every use
    var x = tcx.use_head.get(pcx.nodes[u].x + 1);
    while x > 0 {
        let id = x - 1;
        if in_closure(id, tcx, pcx) {
            return false;
        }
        var h = false;
        context(id, &h, &tcx, pcx);
        if !h {
            return false;
        }
        x = tcx.use_next.get(x);
    }
    true
}

// The edits; their number.
pub fn cast_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    for i in 0..CK_N {
        tcx.cast_counts[i] = 0;
    }
    let total = pcx.nodes.len() as i64;
    // parents, uses, candidates
    for n in 1..total {
        let kind = pcx.nodes[n].kind;
        if kind == NodeKind::None {
            continue;
        }
        if node_field_a(kind) {
            set_parent(pcx.nodes[n].a, n, &tcx);
        }
        if node_field_b(kind) {
            set_parent(pcx.nodes[n].b, n, &tcx);
        }
        if node_field_c(kind) {
            set_parent(pcx.nodes[n].c, n, &tcx);
        }
        if kind == NodeKind::For || kind == NodeKind::Param {
            set_parent(pcx.nodes[n].d, n, &tcx);
        }
        if kind == NodeKind::Fn {
            set_parent(pcx.nodes[n].c, n, &tcx);
        }
        for i in 0..pcx.nodes[n].count {
            set_parent(child(n, i, pcx), n, &tcx);
        }
        if kind == NodeKind::Closure && user_pos(pcx.nodes[n].start, pcx) {
            tcx.closures.push(pcx.nodes[n].start);
            tcx.closures.push(pcx.nodes[n].end);
        }
        if kind == NodeKind::Ident && pcx.nodes[n].res == Res::Local && pcx.nodes[n].y >= 0 {
            let head = tcx.use_head.get(pcx.nodes[n].y + 1);
            if head > 0 {
                tcx.use_next.put(n + 1, head);
            }
            tcx.use_head.put(pcx.nodes[n].y + 1, n + 1);
        }
        if kind == NodeKind::Cast && (pcx.nodes[n].p & NODE_IMPLICIT) == 0
            && pcx.nodes[n].ty == TY_I64 && user_pos(pcx.nodes[n].start, pcx)
            && ref_in(pcx.nodes[n].start, &pcx)
            && as_start(n, pcx) >= 0 {
            tcx.casts_spans.put(pcx.nodes[n].start + 1,
                tcx.casts_spans.get(pcx.nodes[n].start + 1) + 1);
            let from = pcx.nodes[pcx.nodes[n].a].ty;
            if from == TY_USIZE {
                tcx.state.put(n + 1, ST_OK);
                tcx.casts.push(n);
            } else if from == TY_I64 {
                tcx.cast_counts[CK_NOOP] += 1;
            } else {
                tcx.cast_counts[CK_NOT_USIZE] += 1;
            }
        }
    }
    // the contexts, once, to make the local candidates
    for i in 0..tcx.casts.count {
        var h = false;
        context(tcx.casts.get(i), &h, &tcx, pcx);
    }
    // the fixed point: refuse what does not hold, until nothing changes
    var changed = true;
    while changed {
        changed = false;
        for i in 0..tcx.casts.count {
            let u = tcx.casts.get(i);
            if ok(u, tcx) && !holds_now(u, &tcx, pcx) {
                tcx.state.put(u + 1, ST_NO);
                changed = true;
            }
        }
        var j = 0;
        while j < tcx.local_units.count {
            let u = tcx.local_units.get(j);
            if ok(u, tcx) && !holds_now(u, &tcx, pcx) {
                tcx.state.put(u + 1, ST_NO);
                changed = true;
            }
            j += 1;
        }
    }
    // the edits, and the census
    var fixes = 0;
    let list = buf_new();
    for i in 0..tcx.casts.count {
        let u = tcx.casts.get(i);
        var h = false;
        let first = context(u, &h, &tcx, pcx);
        var class = first;
        if tcx.casts_spans.get(pcx.nodes[u].start + 1) > 1 || in_closure(u, tcx, pcx) {
            class = CK_COPIED;
        } else if !ok(u, tcx) && (class <= CK_LET || class == CK_SLICE_END) {
            class = CK_REFUSED;
        }
        tcx.cast_counts[class] += 1;
        if tcx.cast_list {
            put_site(list, u, class, first, pcx);
        }
        if ok(u, tcx) && class == CK_SLICE_END {
            let d = dots_end(u, pcx);
            if d > 0 && edit_replace(d, pcx.nodes[u].end, buf_new(), &pcx) {
                fixes += 1;
            }
        }
        else if ok(u, tcx) && class <= CK_LET
            && edit_replace(as_start(u, pcx), pcx.nodes[u].end, buf_new(), &pcx) {
            fixes += 1;
        }
    }
    if tcx.cast_list {
        crate::base::buf_write_fd(list, crate::base::STDOUT);
    }
    fixes
}

// `FILE:LINE CLASS CONTEXT TEXT` of cast u: what was decided, where its
// value goes first.
fn put_site(out: i64, u: i64, class: i64, first: i64, pcx: Ctx<Comp>) {
    // UNSAFE: FILES is the loader's table of source files, a raw pointer (base).
    // SAFETY: file_of_pos gives the index of a loaded file; pos is in it, so start..pos is in SRC.
    unsafe {
        let pos = pcx.nodes[u].start;
        let f = file_of_pos(pos, pcx);
        buf_str(out, pcx.files[f].path);
        buf_byte(out, ':');
        var line = 1;
        for i in pcx.files[f].start..pos {
            if SRC[i] == '\n' {
                line += 1;
            }
        }
        buf_int(out, line);
        buf_byte(out, '\t');
        buf_str(out, class_name(class));
        buf_byte(out, '\t');
        buf_str(out, class_name(first));
        buf_byte(out, '\t');
        buf_bytes(out, SRC[pcx.nodes[u].start..pcx.nodes[u].end]);
        buf_byte(out, '\n');
    }
}

pub fn class_name(c: i64) -> *u8 {
    if c == CK_INDEX { c"index" }
    else if c == CK_COMPARE { c"compare" }
    else if c == CK_LOOP { c"loop" }
    else if c == CK_LET { c"let" }
    else if c == CK_SUB { c"sub" }
    else if c == CK_ARITH { c"arith" }
    else if c == CK_CMP_I64 { c"cmp-i64" }
    else if c == CK_STORED { c"stored" }
    else if c == CK_OTHER { c"other" }
    else if c == CK_REFUSED { c"refused" }
    else if c == CK_COPIED { c"copied" }
    else if c == CK_SLICE_END { c"slice-end" }
    else if c == CK_NOOP { c"noop" }
    else { c"not-usize" }
}

// The census after a run: `note fix.casts: ...`.
pub fn cast_report(tcx: inout Tcx<Comp>) {
    let d = diag(c"note", c"fix.casts", &tcx);
    buf_str(d, c"usize to i64 casts: removed");
    let order = [CK_INDEX, CK_SLICE_END, CK_COMPARE, CK_LOOP, CK_LET, CK_SUB, CK_ARITH,
        CK_CMP_I64, CK_STORED, CK_OTHER, CK_REFUSED, CK_COPIED, CK_NOOP, CK_NOT_USIZE];
    for i in 0..14 {
        let c = order[i];
        if c == CK_SUB {
            buf_str(d, c"; kept");
        }
        if c == CK_NOOP {
            buf_str(d, c"; other casts to i64");
        }
        buf_byte(d, ' ');
        buf_str(d, class_name(c));
        buf_byte(d, ' ');
        buf_int(d, tcx.cast_counts[c]);
    }
    buf_byte(d, '\n');
}
