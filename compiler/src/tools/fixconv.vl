// `volec fix --only conventions` (0.20, docs/design/conventions.md §9.2):
// a program in 0.19's spelling rewritten in 0.20's, whole-program and by
// types: what the checker resolved (each call's callee, each expression's
// type) decides each rewrite, not the text.
//
// - Rule 1, parameters: `x: &T` → `x: T` (let, the default), `x: &mut T` →
//   `x: inout T`, `x: &[T]` → `x: [T]`, `x: &mut [T]` → `x: inout [T]`.
// - Rule 2, receivers: `self: &Self` → `self`, `self: &mut Self` → `inout
//   self`, `self: Self` → `sink self` (an owned Self; `self` for a plain
//   one), `mut self: T` → `sink self`.
// - Rule 3, by-value parameters: an owned or move-only one (holding a Vec,
//   a Buf, a `&mut`; or a type parameter, which an instance may make owned)
//   → `x: sink T`, as 0.19 moved it; `mut x: T` → `x: sink T`; a plain or
//   copyable one stays (let copies it). A method of a program's trait
//   follows the trait's declaration, so that they match.
// - Rule 4, call sites: `&mut e` → `&e`; `&e` given to a shared reference
//   parameter (let now) or a `&T` field → `e`; `&e` to a raw `*T` stays.
// - Rule 5: `*r` on a reference (an access now, used as its value) → `r`,
//   `(*p).f` → `p.f`.
// - Rule 6, locals: `let mut` → `var`, `let r = &mut e;` → `inout r = &e;`
//   (a local of type `&mut T` from a call: `inout r = e;`).
// - Rule 7: `static mut` → `static var`, `mut x` in a pattern → `var x`,
//   `move ||` → `sink ||`, `&T` / `&mut T` elsewhere (fields, results, type
//   arguments, annotations) → `let T` / `inout T`, `&[T]` → `[T]`.
// Left to hand, and reported (`--list-left` prints each): `let r = &e;` (a
// shared reference local), a reference local that is re-pointed (`let mut
// r = &..`), an `&e` with no let parameter or field to take it, `&&T`,
// by-value owned parameters of function types and closures, identifiers
// named `var`, `inout` or `sink` (D27: keywords in 0.21).
//
// `--only conventions-spelling` makes only the rewrites whose meaning the
// checker of Phase 0 already gives (the new forms are 0.19's references
// underneath until T1): rules 1 to 4 and 6, 7 with `x: &T` → `x: let T`
// and a plain `self: T` and the `&e` given to let parameters left as they
// are, and no rule 5. Its result checks, and runs, as the program did; a
// later `fix --only conventions` finishes it.
//
// std is never rewritten, but under `--std-tree DIR` (its files then).

use crate::base::{get_src, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    CLOSURE_MOVE, CONV_NEW, FIELD_SHORTHAND, NODE_REF, NODE_REF_MUT, NodeKind, child,
};
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::own::kinds::{K_OWNED, type_kind};
use crate::front::traits::{impl_of_fn, trait_fn};
use crate::front::types::{REF_MUT, REF_SHARED, TyKind, fn_param, struct_field, type_elem};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::diagnostics::diag;

// What was rewritten (fix's summary).
pub const CC_PARAM_LET: i64 = 0;
pub const CC_PARAM_INOUT: i64 = 1;
pub const CC_PARAM_SINK: i64 = 2;
pub const CC_RECEIVER: i64 = 3;
pub const CC_MARKER: i64 = 4;
pub const CC_UNMARKED: i64 = 5;
pub const CC_DEREF: i64 = 6;
pub const CC_VAR: i64 = 7;
pub const CC_INOUT_LOCAL: i64 = 8;
pub const CC_STATIC: i64 = 9;
pub const CC_SINK_CLOSURE: i64 = 10;
pub const CC_TYPE: i64 = 11;
pub const CC_COUNT: i64 = 12;

// What is left to hand (reported).
const CL_SHARED_LOCAL: i64 = 0;
const CL_REPOINTED: i64 = 1;
const CL_AMP: i64 = 2;
const CL_AMPAMP: i64 = 3;
const CL_FN_TYPE: i64 = 4;
const CL_WORD: i64 = 5;
const CL_GUESSED: i64 = 6;
const CL_COUNT: i64 = 7;

// ---- Text ----

fn editable(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    // (`--in FILE|MODULE`: only there, as for the other fixes; a merge
    // migrates the files it brought, `--std-tree DIR --in std::fs`)
    unsafe {
        pos >= 0 && (*pcx.files[file_of_pos(pos, pcx) as usize].path.add(0)) != b'<'
            && (pcx.opt_in == 0 as *mut u8
                || crate::tools::query::refs::ref_in(pos, pcx))
    }
}

fn is_ws(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\n' || c == b'\r'
}

fn ident_char(c: u8) -> bool {
    c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_'
}

fn skip_ws(p: i64) -> i64 {
    let mut q = p;
    while is_ws(get_src()[q as usize]) {
        q += 1;
    }
    q
}

// Whether the word w is at p (not a prefix of a longer identifier).
fn word_here(p: i64, w: &[u8]) -> bool {
    for i in 0..w.len() as i64 {
        if get_src()[(p + i) as usize] != w[i as usize] {
            return false;
        }
    }
    !ident_char(get_src()[(p + w.len() as i64) as usize])
}

// The end of `mut` and the blanks after it at p, or p.
fn after_mut(p: i64) -> i64 {
    if word_here(p, b"mut") { skip_ws(p + 3) } else { p }
}

// SRC[a..b) replaced by text, once per place; whether it was made.
fn put(a: i64, b: i64, text: &[u8], what: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if !editable(a, pcx) || tcx.fixconv_done.get(a + 1) != 0 {
        return false;
    }
    let t = buf_new();
    buf_bytes(t, text);
    if !edit_replace(a, b, t, pcx) {
        return false;
    }
    tcx.fixconv_done.put(a + 1, 1);
    if what >= 0 {
        tcx.conv_counts[what as usize] += 1;
    }
    true
}

fn left(pos: i64, what: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if !editable(pos, pcx) || tcx.fixconv_done.get(pos + 1) != 0 {
        return;
    }
    tcx.fixconv_done.put(pos + 1, 2);
    tcx.conv_left[what as usize] += 1;
    tcx.left_at.push(pos);
    tcx.left_at.push(what);
}

// ---- Types ----

// Whether type t holds an exclusive reference (a move-only view).
fn holds_mut(t: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if t <= 0 || depth > 6 {
            return false;
        }
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Ptr {
            return pcx.types[t as usize].b == REF_MUT;
        }
        if k == TyKind::Slice {
            return pcx.types[t as usize].b == REF_MUT;
        }
        if k == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if holds_mut(type_elem(t, i, pcx), depth + 1, pcx) {
                    return true;
                }
            }
            return false;
        }
        if k == TyKind::Array {
            return holds_mut(pcx.types[t as usize].a, depth + 1, pcx);
        }
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            for i in 0..pcx.structs[s as usize].field_count {
                if holds_mut((*struct_field(s, i, pcx)).ty, depth + 1, pcx) {
                    return true;
                }
            }
        }
        false
    }
}

// Whether a by-value parameter of type t is taken sink: owned or
// move-only.
fn sink_type(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    t > 0 && ((type_kind(t, pcx) & K_OWNED) != 0 || holds_mut(t, 0, pcx))
}

fn is_ref_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != 0
}

fn is_shared_ref(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == REF_SHARED
}

// Whether name is one of generics node g's parameters.
fn generic_name(g: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    if g <= 0 {
        return false;
    }
    for i in 0..pcx.nodes[g as usize].count {
        if pcx.nodes[child(g, i, pcx) as usize].a == name {
            return true;
        }
    }
    false
}

// Whether type parameter name of generics node g is bounded by `Fn(..)` or
// `FnMut(..)`: a closure, called and not kept (most are views, which a let
// copies), so taken let.
fn fn_bounded(g: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    if g <= 0 {
        return false;
    }
    for i in 0..pcx.nodes[g as usize].count {
        let p = child(g, i, pcx);
        let h = pcx.nodes[p as usize].h;
        if pcx.nodes[p as usize].a != name || h <= 0 || pcx.nodes[h as usize].kind != NodeKind::Generics {
            continue;
        }
        for j in 0..pcx.nodes[h as usize].count {
            let b = child(h, j, pcx);
            if pcx.nodes[b as usize].kind == NodeKind::TyFn && pcx.nodes[b as usize].d >= 2 {
                return true;
            }
        }
    }
    false
}

fn std_owned_name(name: i64, pcx: &Ctx<Comp>) -> bool {
    let s = sym_text(name, pcx);
    s == b"Vec" || s == b"Buf" || s == b"HashMap" || s == b"HashSet" || s == b"String"
        || s == b"Box" || s == b"Rc" || s == b"Arc" || s == b"Arena" || s == b"BTreeMap"
        || s == b"Deque" || s == b"VecDeque"
}

// By its text: whether type node tn of a parameter of function node fnode
// is taken sink (a type parameter, `Self` of a trait or a generic impl, an
// owned std container), with the trait's Self unknown when self_unknown.
fn sink_by_name(tn: i64, fnode: i64, self_unknown: bool, depth: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if tn <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[tn as usize].kind;
    if k == NodeKind::TyPtr || k == NodeKind::TySlice || k == NodeKind::TyFn {
        return false;
    }
    if k == NodeKind::TyTuple {
        for i in 0..pcx.nodes[tn as usize].count {
            if sink_by_name(child(tn, i, pcx), fnode, self_unknown, depth + 1, tcx, pcx) {
                return true;
            }
        }
        return false;
    }
    if k == NodeKind::TyArray {
        return sink_by_name(pcx.nodes[tn as usize].a, fnode, self_unknown, depth + 1, tcx, pcx);
    }
    if k != NodeKind::TyName {
        return false;
    }
    let name = pcx.nodes[tn as usize].a;
    if name == tcx.fixconv_sym_self && pcx.nodes[tn as usize].list == 0 {
        if self_unknown {
            return true;
        }
        let h = pcx.nodes[fnode as usize].h;
        return h > 0 && h != tn && sink_by_name(h, fnode, false, depth + 1, tcx, pcx);
    }
    if pcx.nodes[tn as usize].list == 0 && generic_name(pcx.nodes[fnode as usize].g, name, pcx) {
        return !fn_bounded(pcx.nodes[fnode as usize].g, name, pcx);
    }
    if std_owned_name(name, pcx) {
        return true;
    }
    let g = pcx.nodes[tn as usize].g;
    if g > 0 {
        for i in 0..pcx.nodes[g as usize].count {
            if sink_by_name(child(g, i, pcx), fnode, self_unknown, depth + 1, tcx, pcx) {
                return true;
            }
        }
    }
    false
}

// ---- The parameters' decisions ----

// The FNS index of function node n, or -1 (a trait's declaration).
fn fn_of(n: i64, tcx: &Tcx<Comp>) -> i64 {
    tcx.fn_of_node.get(n + 1) - 1
}

// Whether function node n is a method: in an impl (d: the impl's type
// name), or a trait's.
fn is_method(n: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[n as usize].d != 0 || tcx.trait_fns.get(n + 1) != 0
}

// Whether type node tn (or what a `&` of it points to) names a type
// parameter of function node n's own (not its impl's): `fn copy_clone<T>(self:
// &T)`, a function std binds to a trait, whose `self` is no receiver.
fn own_type_param(n: i64, tn: i64, pcx: &Ctx<Comp>) -> bool {
    let mut t = tn;
    if pcx.nodes[t as usize].kind == NodeKind::TyPtr {
        t = pcx.nodes[t as usize].a;
    }
    let g = pcx.nodes[n as usize].g;
    if t <= 0 || pcx.nodes[t as usize].kind != NodeKind::TyName || g <= 0 {
        return false;
    }
    for i in pcx.nodes[g as usize].a..pcx.nodes[g as usize].count {
        if pcx.nodes[child(g, i, pcx) as usize].a == pcx.nodes[t as usize].a {
            return true;
        }
    }
    false
}

// The declaration (a Fn node) of the program's trait function that node
// n (function f) implements, or 0.
fn trait_decl(f: i64, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if f < 0 {
        return 0;
    }
    let im = impl_of_fn(f, pcx);
    if im < 0 || pcx.traits_impls[im as usize].tr < 0 {
        return 0;
    }
    let d = trait_fn(pcx.traits_impls[im as usize].tr, pcx.nodes[n as usize].a, pcx);
    if d > 0 && d != n && editable(pcx.nodes[d as usize].start, pcx) { d } else { 0 }
}

// Whether by-value parameter i (Param node p) of function node n is
// taken sink.
fn param_sinks(n: i64, i: i64, p: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let f = fn_of(n, tcx);
    let d = trait_decl(f, n, pcx);
    if d > 0 && i < pcx.nodes[d as usize].count {
        return param_sinks(d, i, child(d, i, pcx), tcx, pcx);
    }
    let key = n * 64 + i + 1;
    let known = tcx.decided.get(key);
    if known != 0 {
        return known == 2;
    }
    let tn = pcx.nodes[p as usize].b;
    let mut sinks = false;
    if f >= 0 && pcx.fns[f as usize].generic == 0 && i < pcx.fns[f as usize].param_count {
        sinks = sink_type(fn_param(f, i, pcx), pcx);
    } else {
        // (a template, or a trait's declaration: by the text, and by
        // the instances the program makes)
        sinks = sink_by_name(tn, n, f < 0, 0, tcx, pcx);
        let mut instances: i64 = 0;
        let closure = pcx.nodes[tn as usize].kind == NodeKind::TyName && pcx.nodes[tn as usize].list == 0
            && fn_bounded(pcx.nodes[n as usize].g, pcx.nodes[tn as usize].a, pcx);
        if f >= 0 && !closure {
            for g in 0..pcx.fns.len() as i64 {
                if pcx.fns[g as usize].tmpl == f + 1 && i < pcx.fns[g as usize].param_count {
                    instances += 1;
                    if sink_type(fn_param(g, i, pcx), pcx) {
                        sinks = true;
                    }
                }
            }
        }
        if !sinks && instances == 0 && f >= 0 && pcx.nodes[tn as usize].kind == NodeKind::TyName
            && !generic_name(pcx.nodes[n as usize].g, pcx.nodes[tn as usize].a, pcx) {
            left(pcx.nodes[tn as usize].start, CL_GUESSED, tcx, pcx);
        }
    }
    tcx.decided.put(key, if sinks { 2 } else { 1 });
    sinks
}

// ---- Rules 1 to 3: signatures ----

// Function node n's parameters (its list's Param nodes).
fn edit_signature(n: i64, closure: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param {
            continue;
        }
        edit_param(n, i, p, closure, tcx, pcx);
        i += 1;
    }
}

fn edit_param(n: i64, i: i64, p: i64, closure: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let tn = pcx.nodes[p as usize].b;
    if closure && tn <= 0 && !tcx.conv_spelling && pcx.nodes[p as usize].a > 0
        && editable(pcx.nodes[p as usize].start, pcx) {
        // (an unwritten closure parameter: given `&T` by a bound that
        // becomes `let T`, an access in 0.20, its `*a` goes: edit_deref)
        tcx.closure_refs.push(pcx.nodes[n as usize].start);
        tcx.closure_refs.push(pcx.nodes[n as usize].end);
        tcx.closure_refs.push(pcx.nodes[p as usize].a);
        return;
    }
    if tn <= 0 || !editable(pcx.nodes[p as usize].start, pcx) {
        return;
    }
    if (pcx.nodes[p as usize].p & CONV_NEW) != 0 {
        // (`x: let T`, conventions-spelling's, is `x: T`: let is the
        // default)
        let ts = pcx.nodes[tn as usize].start;
        if !tcx.conv_spelling && !closure && pcx.nodes[tn as usize].kind == NodeKind::TyPtr
            && (pcx.nodes[tn as usize].p & NODE_REF_MUT) == 0 && word_here(ts, b"let") {
            tcx.type_done.put(tn + 1, 1);
            put(ts, skip_ws(ts + 3), b"", CC_PARAM_LET, tcx, pcx);
        }
        return;
    }
    let ps = pcx.nodes[p as usize].start;
    let tk = pcx.nodes[tn as usize].kind;
    let ts = pcx.nodes[tn as usize].start;
    let mutable = pcx.nodes[p as usize].c != 0;
    // (a method's receiver: not a free function's `self: &T` parameter, nor
    // a slice's, `self: &mut [T]` (`inout self` is `&mut Self` until T1;
    // the long form `self: inout [T]` keeps the slice))
    if pcx.nodes[p as usize].a == tcx.fixconv_sym_self && !closure && is_method(n, tcx, pcx)
        && tk != NodeKind::TySlice
        && !own_type_param(n, tn, pcx) {
        tcx.type_done.put(tn + 1, 1);
        let end = pcx.nodes[tn as usize].end;
        if tk == NodeKind::TyPtr && (pcx.nodes[tn as usize].p & NODE_REF) != 0 && get_src()[ts as usize] == b'&' {
            if get_src()[(ts + 1) as usize] == b'&' {
                left(ts, CL_AMPAMP, tcx, pcx);
                return;
            }
            let mut_ref = (pcx.nodes[tn as usize].p & NODE_REF_MUT) != 0;
            put(ps, end, if mut_ref { b"inout self" } else { b"self" }, CC_RECEIVER, tcx, pcx);
        } else if tk == NodeKind::TySlice && get_src()[ts as usize] == b'&' {
            let mut_ref = (pcx.nodes[tn as usize].p & NODE_REF_MUT) != 0;
            put(ps, end, if mut_ref { b"inout self" } else { b"self" }, CC_RECEIVER, tcx, pcx);
        } else if tk == NodeKind::TyPtr {
            // (`self: *Self`: raw, as it is)
        } else if mutable || param_sinks(n, i, p, tcx, pcx) {
            put(ps, end, b"sink self", CC_RECEIVER, tcx, pcx);
        } else if !tcx.conv_spelling {
            put(ps, end, b"self", CC_RECEIVER, tcx, pcx);
        }
        return;
    }
    if tk == NodeKind::TyPtr && (pcx.nodes[tn as usize].p & NODE_REF) != 0 && get_src()[ts as usize] == b'&' {
        tcx.type_done.put(tn + 1, 1);
        if get_src()[(ts + 1) as usize] == b'&' {
            left(ts, CL_AMPAMP, tcx, pcx);
            return;
        }
        let inner = pcx.nodes[pcx.nodes[tn as usize].a as usize].start;
        if tcx.raw_params.get(p + 1) != 0 {
            // (used as a pointer: a raw one)
            put(ts, inner, b"*", CC_PARAM_INOUT, tcx, pcx);
            return;
        }
        if (pcx.nodes[tn as usize].p & NODE_REF_MUT) != 0 {
            put(ts, inner, b"inout ", CC_PARAM_INOUT, tcx, pcx);
        } else {
            put(ts, inner, if tcx.conv_spelling { b"let " } else { b"" }, CC_PARAM_LET, tcx, pcx);
        }
        if closure && !tcx.conv_spelling {
            // (Phase M: a closure given to a generic function is checked
            // as a copy of its nodes, so its `*a` may carry no type here:
            // edit_deref knows it by the parameter's name)
            tcx.closure_refs.push(pcx.nodes[n as usize].start);
            tcx.closure_refs.push(pcx.nodes[n as usize].end);
            tcx.closure_refs.push(pcx.nodes[p as usize].a);
        }
        return;
    }
    if tk == NodeKind::TySlice && get_src()[ts as usize] == b'&' {
        tcx.type_done.put(tn + 1, 1);
        let inner = skip_ws(after_mut(skip_ws(ts + 1)));
        if (pcx.nodes[tn as usize].p & NODE_REF_MUT) != 0 {
            put(ts, inner, b"inout ", CC_PARAM_INOUT, tcx, pcx);
        } else {
            put(ts, inner, b"", CC_PARAM_LET, tcx, pcx);
        }
        return;
    }
    if tk == NodeKind::TyPtr || tk == NodeKind::TySlice {
        // (`mut p: *T`: a raw pointer the callee changes, `p: sink *T`)
        if mutable && word_here(ps, b"mut") && put(ps, skip_ws(ps + 3), b"", -1, tcx, pcx) {
            put(ts, ts, b"sink ", CC_PARAM_SINK, tcx, pcx);
        }
        return;
    }
    if mutable && word_here(ps, b"mut") {
        if put(ps, skip_ws(ps + 3), b"", -1, tcx, pcx) {
            put(ts, ts, b"sink ", CC_PARAM_SINK, tcx, pcx);
        }
        return;
    }
    if closure {
        // (a closure's by-value owned parameter: its type is not known
        // here)
        if sink_by_name(tn, n, false, 0, tcx, pcx) {
            left(ts, CL_FN_TYPE, tcx, pcx);
        }
        return;
    }
    if param_sinks(n, i, p, tcx, pcx) {
        put(ts, ts, b"sink ", CC_PARAM_SINK, tcx, pcx);
    }
}

// ---- Rule 4: `&` ----

// The type parameter i of the function that call node c calls takes, or
// 0 (not known).
fn arg_param_type(c: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = pcx.nodes[c as usize].x - 1;
    if f >= 0 && f < pcx.fns.len() as i64 {
        if i < pcx.fns[f as usize].param_count {
            return fn_param(f, i, pcx);
        }
        return 0;
    }
    // (a call of a function value: its type's parameters)
    let callee = pcx.nodes[c as usize].a;
    let t: i64 = if callee > 0 { pcx.nodes[callee as usize].ty } else { 0 };
    if t > 0 && pcx.types[t as usize].kind == TyKind::Fn && i < pcx.types[t as usize].count {
        return type_elem(t, i, pcx);
    }
    0
}

// The argument node of NamedArg a, or a.
fn arg_value(a: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[a as usize].kind == NodeKind::NamedArg { pcx.nodes[a as usize].b } else { a }
}

// Whether n is a `&e` (in a file of the program, `&` flags CONV_NEW in any
// spelling: the text tells `&mut e` from `&e`, amp_mut).
fn is_amp(n: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[n as usize].kind == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Amp
        && get_src()[pcx.nodes[n as usize].start as usize] == b'&'
}

// Whether `&` node n is written `&mut e`.
fn amp_mut(n: i64, pcx: &Ctx<Comp>) -> bool {
    word_here(skip_ws(pcx.nodes[n as usize].start + 1), b"mut")
}

// The position of the `&` (of `&e[a..b]` or `&mut e[a..b]`) the checker
// dropped before the slicing that starts at pos, or -1.
fn slice_amp_before(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let v = pcx.slice_amps;
        let mut i: i64 = 0;
        while i + 1 < v.count {
            if (*v.data.add((i + 1) as usize)) == pos {
                return (*v.data.add(i as usize));
            }
            i += 2;
        }
        -1
    }
}

// The sequence e of a `for` loop (the checker's `let __for_seq = e;`): a
// shared `&v` is `v` (the loop lends each element; `&v` marks a `for
// inout` in 0.20).
fn for_amp(e: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if e > 0 && is_amp(e, pcx) && !amp_mut(e, pcx) && get_src()[(pcx.nodes[e as usize].start + 1) as usize] != b'&'
        && tcx.amp_seen.get(e + 1) == 0 && !tcx.conv_spelling {
        tcx.amp_seen.put(e + 1, 1);
        put(pcx.nodes[e as usize].start, skip_ws(pcx.nodes[e as usize].start + 1), b"", CC_UNMARKED, tcx, pcx);
    }
}

// The `&e[a..b]`s the checker read as the slice: `e[a..b]` (a `&mut` is the
// marker `&`, the last rule's).
fn slice_amps(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let v = pcx.slice_amps;
        let mut i: i64 = 0;
        while i + 1 < v.count {
            let s = (*v.data.add(i as usize));
            if s > 0 && editable(s, pcx) && get_src()[s as usize] == b'&' && get_src()[(s + 1) as usize] != b'&'
                && !word_here(skip_ws(s + 1), b"mut") {
                put(s, skip_ws(s + 1), b"", CC_UNMARKED, tcx, pcx);
            }
            i += 2;
        }
    }
}

// `&mut e` → `&e`; `&e` → `e` when given to a let (with drop).
fn edit_amp(n: i64, drop: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    tcx.amp_seen.put(n + 1, 1);
    if get_src()[(s + 1) as usize] == b'&' {
        left(s, CL_AMPAMP, tcx, pcx);
        return;
    }
    if amp_mut(n, pcx) {
        let e = skip_ws(after_mut(skip_ws(s + 1)));
        put(s, e, b"&", CC_MARKER, tcx, pcx);
        return;
    }
    if drop && !tcx.conv_spelling && (pcx.nodes[n as usize].p & NODE_REF_MUT) == 0 {
        put(s, skip_ws(s + 1), b"", CC_UNMARKED, tcx, pcx);
    }
}

fn edit_call(c: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[c as usize].count {
        let arg = arg_value(child(c, i, pcx), pcx);
        if arg <= 0 {
            continue;
        }
        // (a method's receiver, `x.m()`, is lent by the checker)
        if i == 0 && pcx.nodes[arg as usize].start == pcx.nodes[c as usize].start {
            continue;
        }
        let t = arg_param_type(c, i, pcx);
        if t <= 0 {
            continue;
        }
        if raw_param_at(c, i, tcx, pcx) || raw_ref(arg, tcx, pcx) {
            // (a raw parameter's: `&mut e` is `&e`, which converts)
            if is_amp(arg, pcx) && (pcx.nodes[arg as usize].p & NODE_REF_MUT) != 0 {
                edit_amp(arg, false, tcx, pcx);
            } else if is_amp(arg, pcx) {
                tcx.amp_seen.put(arg + 1, 1);
            }
            continue;
        }
        if !is_amp(arg, pcx) {
            // (an exclusive reference passed on, `g(r)`: a named access
            // is used as its place, so it is lent again, `g(&r)`)
            if pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == REF_MUT {
                reborrow(arg, tcx, pcx);
            }
            continue;
        }
        if (pcx.nodes[arg as usize].p & NODE_REF_MUT) != 0 {
            // (conventions-spelling: not to an instance of a generic
            // function, where Phase 0 does not make `&x` exclusive)
            let f = pcx.nodes[c as usize].x - 1;
            if tcx.conv_spelling
                && (f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f as usize].tmpl > 0) {
                tcx.amp_seen.put(arg + 1, 1);
                continue;
            }
            if !tcx.conv_spelling && (is_shared_ref(t, pcx) || let_param_at(c, i, pcx))
                && get_src()[(pcx.nodes[arg as usize].start + 1) as usize] != b'&' {
                // (Phase M: `&mut x` to a let parameter, which 0.19
                // read through: `x`)
                tcx.amp_seen.put(arg + 1, 1);
                let s = pcx.nodes[arg as usize].start;
                put(s, skip_ws(after_mut(skip_ws(s + 1))), b"", CC_UNMARKED, tcx, pcx);
                continue;
            }
            edit_amp(arg, false, tcx, pcx);
        } else if is_shared_ref(t, pcx) || let_param_at(c, i, pcx) {
            // (a let parameter of 0.20: the place itself, `f(x)`; a
            // generic `x: T` too, whose instance may copy)
            edit_amp(arg, true, tcx, pcx);
        } else if pcx.types[t as usize].kind == TyKind::Ptr {
            // (to a raw `*T`: `&e` converts to it, as it is)
            tcx.amp_seen.put(arg + 1, 1);
        } else {
            // (Phase M: to a value, which 0.18.1 read through it, or a
            // slice, which it is: the value itself)
            edit_amp(arg, true, tcx, pcx);
        }
    }
}

// Rule 4: a place of type `&mut T` (an inout binding, parameter or
// field) given where `&mut T` is wanted: `&` lends it on.
fn reborrow(arg: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[arg as usize].kind;
    if tcx.conv_spelling || !(k == NodeKind::Ident || k == NodeKind::FieldAccess)
        || pcx.nodes[arg as usize].ty <= 0 || pcx.types[pcx.nodes[arg as usize].ty as usize].kind != TyKind::Ptr
        || pcx.types[pcx.nodes[arg as usize].ty as usize].b != REF_MUT {
        return;
    }
    let s = pcx.nodes[arg as usize].start;
    if get_src()[s as usize] == b'&' || get_src()[s as usize] == b'*' {
        return;
    }
    put(s, s, b"&", CC_MARKER, tcx, pcx);
}

fn edit_struct_lit(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        let fi = child(n, i, pcx);
        if pcx.nodes[fi as usize].kind != NodeKind::FieldInit {
            continue;
        }
        let v = pcx.nodes[fi as usize].b;
        if v > 0 && is_amp(v, pcx) {
            edit_amp(v, (pcx.nodes[v as usize].p & NODE_REF_MUT) == 0 && is_shared_ref(pcx.nodes[v as usize].ty, pcx),
                tcx, pcx);
        } else if v > 0 && !tcx.conv_spelling && pcx.nodes[v as usize].ty > 0
            && pcx.types[pcx.nodes[v as usize].ty as usize].kind == TyKind::Ptr
            && pcx.types[pcx.nodes[v as usize].ty as usize].b == REF_MUT {
            if (pcx.nodes[fi as usize].p & FIELD_SHORTHAND) != 0 && pcx.nodes[v as usize].kind == NodeKind::Ident {
                // `S { q }` → `S { q: &q }`
                let name = sym_text(pcx.nodes[v as usize].a, pcx);
                let t = buf_new();
                buf_bytes(t, name);
                buf_bytes(t, b": &");
                buf_bytes(t, name);
                put(pcx.nodes[v as usize].start, pcx.nodes[v as usize].end, buf_slice(t), CC_MARKER, tcx, pcx);
            } else {
                reborrow(v, tcx, pcx);
            }
        }
    }
}

// ---- Rule 6: locals ----

fn edit_let(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    // (the checker's `for` loop: `let __for_seq = e;` at the `for`)
    if word_here(s, b"for") {
        for_amp(pcx.nodes[n as usize].c, tcx, pcx);
        return;
    }
    if (pcx.nodes[n as usize].p & CONV_NEW) != 0 || !word_here(s, b"let") {
        return;
    }
    let pat = pcx.nodes[n as usize].a;
    let init = pcx.nodes[n as usize].c;
    let ann = pcx.nodes[n as usize].b;
    if pat > 0 && pcx.nodes[pat as usize].kind != NodeKind::PatBind && init > 0 && is_amp(init, pcx)
        && !amp_mut(init, pcx) && get_src()[(pcx.nodes[init as usize].start + 1) as usize] != b'&' && !tcx.conv_spelling {
        // (Phase M: `let (a, b) = &e;` of a copyable e: `let (a, b) = e;`,
        // which copies its parts)
        let e = pcx.nodes[init as usize].b;
        if e > 0 && pcx.nodes[e as usize].ty > 0 && crate::front::conv::copyable(pcx.nodes[e as usize].ty, pcx) {
            tcx.amp_seen.put(init + 1, 1);
            put(pcx.nodes[init as usize].start, skip_ws(pcx.nodes[init as usize].start + 1), b"", CC_UNMARKED, tcx,
                pcx);
        }
        return;
    }
    if pat <= 0 || pcx.nodes[pat as usize].kind != NodeKind::PatBind {
        return;
    }
    let ps = pcx.nodes[pat as usize].start;
    let t: i64 = if init > 0 { pcx.nodes[init as usize].ty } else { 0 };
    if pcx.nodes[pat as usize].b != 0 {
        if word_here(ps, b"mut") && put(s, skip_ws(ps + 3), b"var ", CC_VAR, tcx, pcx) {
            tcx.fixconv_done.put(ps + 1, 1);
        }
        if is_ref_type(t, pcx) {
            left(pcx.nodes[pat as usize].start + 1, CL_REPOINTED, tcx, pcx);
        }
        return;
    }
    if init > 0 && slice_amp_before(pcx.nodes[init as usize].start, pcx) >= 0
        && word_here(skip_ws(slice_amp_before(pcx.nodes[init as usize].start, pcx) + 1), b"mut") {
        // (Phase M: `let s = &mut v[a..b];` is `inout s = &v[a..b];`)
        if put(s, s + 3, b"inout", CC_INOUT_LOCAL, tcx, pcx) {
            if ann > 0 && get_src()[pcx.nodes[ann as usize].start as usize] == b'&' {
                tcx.type_done.put(ann + 1, 1);
                put(pcx.nodes[ann as usize].start, skip_ws(after_mut(skip_ws(pcx.nodes[ann as usize].start + 1))), b"",
                    -1, tcx, pcx);
            }
        }
        return;
    }
    if init > 0 && is_amp(init, pcx) && (pcx.nodes[init as usize].p & NODE_REF_MUT) != 0
        || init > 0 && t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == REF_MUT
        && !is_amp(init, pcx) {
        if put(s, s + 3, b"inout", CC_INOUT_LOCAL, tcx, pcx) {
            if ann > 0 && pcx.nodes[ann as usize].kind == NodeKind::TyPtr
                && get_src()[pcx.nodes[ann as usize].start as usize] == b'&' {
                tcx.type_done.put(ann + 1, 1);
                put(pcx.nodes[ann as usize].start, pcx.nodes[pcx.nodes[ann as usize].a as usize].start, b"", -1, tcx, pcx);
            }
            if is_amp(init, pcx) {
                edit_amp(init, false, tcx, pcx);
            }
        }
        return;
    }
    if init > 0 && is_amp(init, pcx) && (pcx.nodes[init as usize].p & NODE_REF_MUT) == 0 {
        tcx.amp_seen.put(init + 1, 1);
        if tcx.raw_lets.get(n + 1) != 0 {
            // (Phase M: p used as a raw pointer: `let p = &e as *T;`, as
            // the uses through it meant)
            if !tcx.conv_spelling && t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && ann <= 0 {
                let b = buf_new();
                crate::base::buf_str(b, c" as *");
                crate::front::types::buf_type(b, pcx.types[t as usize].a, pcx);
                put(pcx.nodes[init as usize].end, pcx.nodes[init as usize].end, crate::base::buf_slice(b), CC_MARKER,
                    tcx, pcx);
            }
            return;
        }
        // (Phase M: `let r = &e;` of a temporary, a copyable value or a
        // part (an element, a field) is `let r = e;`: it owns the
        // temporary, copies the value, borrows the part (D13); a whole
        // owned local would move, which is left to hand)
        let e = pcx.nodes[init as usize].b;
        let et: i64 = if e > 0 { pcx.nodes[e as usize].ty } else { 0 };
        let whole_local = e > 0 && pcx.nodes[e as usize].kind == NodeKind::Ident;
        if !tcx.conv_spelling && e > 0 && get_src()[(pcx.nodes[init as usize].start + 1) as usize] != b'&'
            && is_ref_type(t, pcx)
            && (!whole_local || et > 0 && crate::front::conv::copyable(et, pcx)) {
            put(pcx.nodes[init as usize].start, skip_ws(pcx.nodes[init as usize].start + 1), b"", CC_UNMARKED, tcx,
                pcx);
            if ann > 0 && pcx.nodes[ann as usize].kind == NodeKind::TyPtr
                && get_src()[pcx.nodes[ann as usize].start as usize] == b'&' {
                tcx.type_done.put(ann + 1, 1);
                put(pcx.nodes[ann as usize].start, pcx.nodes[pcx.nodes[ann as usize].a as usize].start, b"", -1, tcx, pcx);
            }
            return;
        }
        left(s, CL_SHARED_LOCAL, tcx, pcx);
    }
}

// ---- The walk ----

fn edit_node(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[n as usize].kind;
    let s = pcx.nodes[n as usize].start;
    if !editable(s, pcx) {
        return;
    }
    if k == NodeKind::Call {
        edit_call(n, tcx, pcx);
    } else if k == NodeKind::StructLit {
        edit_struct_lit(n, tcx, pcx);
    } else if k == NodeKind::Let {
        edit_let(n, tcx, pcx);
    } else if k == NodeKind::PatBind {
        if pcx.nodes[n as usize].b != 0 && word_here(s, b"mut") {
            put(s, s + 3, b"var", CC_VAR, tcx, pcx);
        }
    } else if k == NodeKind::Static {
        if pcx.nodes[n as usize].d != 0 && (pcx.nodes[n as usize].p & CONV_NEW) == 0 {
            let mut q = s;
            while q < pcx.nodes[n as usize].end && !word_here(q, b"static") {
                q += 1;
            }
            let m = skip_ws(q + 6);
            if q < pcx.nodes[n as usize].end && word_here(m, b"mut") {
                put(m, m + 3, b"var", CC_STATIC, tcx, pcx);
            }
        }
    } else if k == NodeKind::Closure {
        if (pcx.nodes[n as usize].c & CLOSURE_MOVE) != 0 && (pcx.nodes[n as usize].p & CONV_NEW) == 0
            && word_here(s, b"move") {
            put(s, s + 4, b"sink", CC_SINK_CLOSURE, tcx, pcx);
        }
    } else if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Star && !tcx.conv_spelling {
        edit_deref(n, tcx, pcx);
    }
}

// Rule 5: `*r` on a reference.
fn edit_deref(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut s = pcx.nodes[n as usize].start;
    let operand = pcx.nodes[n as usize].b;
    // (`(*p)`: the node may start at its parenthesis)
    let paren = get_src()[s as usize] == b'(';
    if paren {
        s = skip_ws(s + 1);
    }
    if get_src()[s as usize] != b'*' || operand <= 0 || raw_ref(operand, tcx, pcx)
        || !is_ref_type(pcx.nodes[operand as usize].ty, pcx) && !closure_ref(operand, tcx, pcx) {
        return;
    }
    let os = pcx.nodes[operand as usize].start;
    let oe = pcx.nodes[operand as usize].end;
    // (`(*p).f`: the parentheses go too)
    let mut a = s - 1;
    while a > 0 && is_ws(get_src()[a as usize]) {
        a -= 1;
    }
    let close = skip_ws(oe);
    if get_src()[a as usize] == b'(' && get_src()[close as usize] == b')' && (get_src()[(close + 1) as usize] == b'.' || get_src()[(close + 1) as usize] == b'[') {
        if put(a, os, b"", CC_DEREF, tcx, pcx) {
            put(close, close + 1, b"", -1, tcx, pcx);
        }
        return;
    }
    put(s, os, b"", CC_DEREF, tcx, pcx);
}

// Whether e names a closure's reference parameter inside that closure.
fn closure_ref(e: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if pcx.nodes[e as usize].kind != NodeKind::Ident {
            return false;
        }
        let mut i: i64 = 0;
        while i + 2 < tcx.closure_refs.count + 1 && i < tcx.closure_refs.count {
            if pcx.nodes[e as usize].a == (*tcx.closure_refs.data.add((i + 2) as usize))
                && pcx.nodes[e as usize].start >= (*tcx.closure_refs.data.add(i as usize))
                && pcx.nodes[e as usize].end <= (*tcx.closure_refs.data.add((i + 1) as usize)) {
                return true;
            }
            i += 3;
        }
        false
    }
}

// The innermost function node whose span holds position pos, or 0.
fn enclosing_fn(pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut best: i64 = 0;
        for i in 0..tcx.fn_nodes.count {
            let f = (*tcx.fn_nodes.data.add(i as usize));
            if pcx.nodes[f as usize].start <= pos && pos < pcx.nodes[f as usize].end
                && (best == 0 || pcx.nodes[f as usize].start >= pcx.nodes[best as usize].start) {
                best = f;
            }
        }
        best
    }
}

// Function node f's parameter named name, written with a `&` type, or 0.
fn ref_param_named(f: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    for j in 0..pcx.nodes[f as usize].count {
        let p = child(f, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param && pcx.nodes[p as usize].a == name {
            let tn = pcx.nodes[p as usize].b;
            if tn > 0 && pcx.nodes[tn as usize].kind == NodeKind::TyPtr && (pcx.nodes[tn as usize].p & NODE_REF) != 0
                && get_src()[pcx.nodes[tn as usize].start as usize] == b'&' {
                return p;
            }
            return 0;
        }
    }
    0
}

fn find_raw_params(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Fn && pcx.nodes[n as usize].c > 0 {
            tcx.fn_nodes.push(n);
        }
    }
    // (Phase M: `let p = &e;` whose p is used as a raw pointer: kept)
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Let && pcx.nodes[n as usize].a > 0
            && pcx.nodes[pcx.nodes[n as usize].a as usize].kind == NodeKind::PatBind && pcx.nodes[n as usize].c > 0
            && is_amp(pcx.nodes[n as usize].c, pcx) && (pcx.nodes[pcx.nodes[n as usize].c as usize].p & NODE_REF_MUT) == 0 {
            let t = pcx.nodes[pcx.nodes[n as usize].c as usize].ty;
            let pointee: i64 = if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr { pcx.types[t as usize].a }
                else { 0 };
            let f = enclosing_fn(pcx.nodes[n as usize].start, tcx, pcx);
            if f > 0 && raw_local(f, pcx.nodes[n as usize].end, pcx.nodes[pcx.nodes[n as usize].a as usize].a, pointee, pcx) {
                tcx.raw_lets.put(n + 1, 1);
                tcx.raw_spans.push(pcx.nodes[n as usize].end);
                tcx.raw_spans.push(pcx.nodes[f as usize].end);
                tcx.raw_spans.push(pcx.nodes[pcx.nodes[n as usize].a as usize].a);
            }
        }
    }
    for n in 1..pcx.nodes.len() {
        // (Phase M: a reference parameter cast, `p as u64`, `p as *u8`:
        // its address, so a raw pointer, as indexing one is)
        let cast = pcx.nodes[n].kind == NodeKind::Cast;
        if pcx.nodes[n].kind != NodeKind::Index && !cast {
            continue;
        }
        let base = pcx.nodes[n].a;
        if base <= 0 || pcx.nodes[base as usize].kind != NodeKind::Ident {
            continue;
        }
        let t = pcx.nodes[base as usize].ty;
        if t <= 0 || pcx.types[t as usize].kind != TyKind::Ptr || pcx.types[t as usize].b == 0 {
            continue;
        }
        let pointee = pcx.types[t as usize].a;
        let pk = pcx.types[pointee as usize].kind;
        if !cast && (pk == TyKind::Slice || pk == TyKind::Array || pk == TyKind::Struct) {
            continue;
        }
        let f = enclosing_fn(pcx.nodes[n].start, tcx, pcx);
        if f == 0 {
            continue;
        }
        let p = ref_param_named(f, pcx.nodes[base as usize].a, pcx);
        if p > 0 && tcx.raw_params.get(p + 1) == 0 {
            tcx.raw_params.put(p + 1, 1);
            tcx.raw_spans.push(pcx.nodes[f as usize].start);
            tcx.raw_spans.push(pcx.nodes[f as usize].end);
            tcx.raw_spans.push(pcx.nodes[p as usize].a);
        }
    }
}

// Whether the local name, bound at position from in function f by `let name
// = &e;` (e of type pointee), is used as a raw pointer: cast, indexed as an
// address (pointee not a slice, an array or a struct), or written through.
fn raw_local(f: i64, from: i64, name: i64, pointee: i64, pcx: &Ctx<Comp>) -> bool {
    let pk = if pointee > 0 { pcx.types[pointee as usize].kind } else { TyKind::Slice };
    let index_raw = pk != TyKind::Slice && pk != TyKind::Array && pk != TyKind::Struct;
    for m in 1..pcx.nodes.len() {
        if pcx.nodes[m].start < from || pcx.nodes[m].end > pcx.nodes[f as usize].end {
            continue;
        }
        let k = pcx.nodes[m].kind;
        let mut base: i64 = 0;
        if k == NodeKind::Cast || k == NodeKind::Index && index_raw {
            base = pcx.nodes[m].a;
        } else if k == NodeKind::Unary && pcx.nodes[m].op == Tok::Amp {
            // (`&p`: the reference's own address, a `**T`)
            base = pcx.nodes[m].b;
        } else if k == NodeKind::Assign {
            base = pcx.nodes[m].b;
            let mut through = false;
            while base > 0 {
                let bk = pcx.nodes[base as usize].kind;
                if bk == NodeKind::FieldAccess || bk == NodeKind::TupleField
                    || bk == NodeKind::Index {
                    base = pcx.nodes[base as usize].a;
                    through = true;
                } else if bk == NodeKind::Unary && pcx.nodes[base as usize].op == Tok::Star {
                    base = pcx.nodes[base as usize].b;
                    through = true;
                } else {
                    break;
                }
            }
            if !through {
                base = 0;
            }
        }
        if base > 0 && pcx.nodes[base as usize].kind == NodeKind::Ident && pcx.nodes[base as usize].a == name {
            return true;
        }
    }
    false
}

// Whether e names a raw parameter (RAW_SPANS) inside its function.
fn raw_ref(e: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if pcx.nodes[e as usize].kind != NodeKind::Ident {
            return false;
        }
        let mut i: i64 = 0;
        while i < tcx.raw_spans.count {
            if pcx.nodes[e as usize].a == (*tcx.raw_spans.data.add((i + 2) as usize))
                && pcx.nodes[e as usize].start >= (*tcx.raw_spans.data.add(i as usize))
                && pcx.nodes[e as usize].end <= (*tcx.raw_spans.data.add((i + 1) as usize)) {
                return true;
            }
            i += 3;
        }
        false
    }
}

// Whether call c's parameter i is a raw parameter (RAW_PARAMS).
fn raw_param_at(c: i64, i: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let p = crate::front::conv::param_node(f, i, pcx);
    p > 0 && tcx.raw_params.get(p + 1) != 0
}

// Whether call c's parameter i is a let parameter in 0.20's spelling (std's
// `fn display<T>(inout self, x: T)`): an `&e` given to it goes.
fn let_param_at(c: i64, i: i64, pcx: &Ctx<Comp>) -> bool {
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let p = crate::front::conv::param_node(f, i, pcx);
    if p <= 0 || crate::front::conv::param_conv(p, pcx) != crate::front::conv::CONV_LET {
        return false;
    }
    // (a raw `*T` written: `&e` is its address)
    let tn = pcx.nodes[p as usize].b;
    !(tn > 0 && pcx.nodes[tn as usize].kind == NodeKind::TyPtr && (pcx.nodes[tn as usize].p & NODE_REF) == 0)
}

// The references converted to raw pointers by the checker
// (check_mode::RAW_FROM_REF): a parameter that becomes an access is its
// value, so its address is written `&x`.
fn raw_addresses(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        // (a reference parameter given to a C function, variadic too: its
        // address, `&p`)
        for n in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[n as usize].kind != NodeKind::Call || pcx.nodes[n as usize].x <= 0
                || pcx.nodes[n as usize].x - 1 >= pcx.fns.len() as i64
                || !pcx.fns[(pcx.nodes[n as usize].x - 1) as usize].is_extern {
                continue;
            }
            for i in 0..pcx.nodes[n as usize].count {
                let e = arg_value(child(n, i, pcx), pcx);
                if e <= 0 || pcx.nodes[e as usize].kind != NodeKind::Ident
                    || !editable(pcx.nodes[e as usize].start, pcx)
                    || raw_ref(e, tcx, pcx) {
                    continue;
                }
                let f = enclosing_fn(pcx.nodes[e as usize].start, tcx, pcx);
                if f > 0 && ref_param_named(f, pcx.nodes[e as usize].a, pcx) > 0 {
                    put(pcx.nodes[e as usize].start, pcx.nodes[e as usize].start, b"&", CC_MARKER, tcx, pcx);
                }
            }
        }
        // (`p as *T` of a reference parameter: `&p as *T`)
        for n in 1..pcx.nodes.len() {
            if pcx.nodes[n].kind != NodeKind::Cast || pcx.nodes[n].a <= 0 {
                continue;
            }
            let e = pcx.nodes[n].a;
            let t = pcx.nodes[e as usize].ty;
            if pcx.nodes[e as usize].kind == NodeKind::Ident && t > 0 && pcx.types[t as usize].kind == TyKind::Ptr
                && pcx.types[t as usize].b != 0 && editable(pcx.nodes[e as usize].start, pcx)
                && !raw_ref(e, tcx, pcx) {
                let f = enclosing_fn(pcx.nodes[e as usize].start, tcx, pcx);
                if f > 0 && ref_param_named(f, pcx.nodes[e as usize].a, pcx) > 0 {
                    put(pcx.nodes[e as usize].start, pcx.nodes[e as usize].start, b"&", CC_MARKER, tcx, pcx);
                }
            }
        }
        let v = pcx.raw_from_ref;
        for i in 0..v.count {
            let n = (*v.data.add(i as usize));
            if pcx.nodes[n as usize].kind != NodeKind::Ident || !editable(pcx.nodes[n as usize].start, pcx)
                || raw_ref(n, tcx, pcx) {
                continue;
            }
            let f = enclosing_fn(pcx.nodes[n as usize].start, tcx, pcx);
            if f > 0 && ref_param_named(f, pcx.nodes[n as usize].a, pcx) > 0 {
                put(pcx.nodes[n as usize].start, pcx.nodes[n as usize].start, b"&", CC_MARKER, tcx, pcx);
            }
        }
    }
}

// The `&e`s of 0.19 code the checker read as the value given to a let
// parameter (front/conv: legacy_let_args): the `&` goes.
fn stripped_amps(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let v = pcx.let_stripped;
        let mut i: i64 = 0;
        while i + 1 < v.count {
            let s = (*v.data.add(i as usize));
            // (`&s` of a String where a `str` goes is `s` too: 0.20 lends the
            // owner as its view, check_mode::coerce_text)
            if s > 0 && editable(s, pcx) && get_src()[s as usize] == b'&' && get_src()[(s + 1) as usize] != b'&'
                && !word_here(skip_ws(s + 1), b"mut") {
                put(s, skip_ws(s + 1), b"", CC_UNMARKED, tcx, pcx);
            }
            i += 2;
        }
    }
}

// Whether position pos is inside an f-string's hole.
fn in_hole(pos: i64, pcx: &Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() {
        if pcx.nodes[n].kind == NodeKind::InterpHole {
            let e = pcx.nodes[n].a;
            if e > 0 && pcx.nodes[e as usize].start <= pos && pos < pcx.nodes[e as usize].end {
                return true;
            }
        }
    }
    false
}

// Whether `&e` node n is the scrutinee of a match whose `&` 0.20 drops: e
// of a copyable type, a part (an element, a field: matched through a
// borrow, check_match), or a reference (an access in 0.20). A whole owned
// local keeps it: `match &v` is the inout marker, binding inout accesses.
fn copied_scrutinee(n: i64, pcx: &mut Ctx<Comp>) -> bool {
    let e = pcx.nodes[n as usize].b;
    if e <= 0 {
        return false;
    }
    let t = pcx.nodes[e as usize].ty;
    let dropped = pcx.nodes[e as usize].kind != NodeKind::Ident
        || t > 0 && (crate::front::conv::copyable(t, pcx) || is_ref_type(t, pcx));
    if !dropped {
        return false;
    }
    for m in 1..pcx.nodes.len() {
        if pcx.nodes[m].kind == NodeKind::Match && pcx.nodes[m].a == n {
            return true;
        }
    }
    false
}

// The type rule (rule 7): every `&T` / `&mut T` / `&[T]` / `&mut [T]` type
// node the signatures' rules did not take.
fn edit_type(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[n as usize].kind;
    let s = pcx.nodes[n as usize].start;
    if k != NodeKind::TyPtr && k != NodeKind::TySlice || (pcx.nodes[n as usize].p & CONV_NEW) != 0
        || get_src()[s as usize] != b'&' || tcx.type_done.get(n + 1) != 0 || !editable(s, pcx) {
        return;
    }
    if get_src()[(s + 1) as usize] == b'&' {
        left(s, CL_AMPAMP, tcx, pcx);
        return;
    }
    let mut_ref = (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0;
    if k == NodeKind::TySlice {
        let inner = skip_ws(after_mut(skip_ws(s + 1)));
        put(s, inner, if mut_ref { b"inout " } else { b"" }, CC_TYPE, tcx, pcx);
        return;
    }
    if (pcx.nodes[n as usize].p & NODE_REF) == 0 {
        return;
    }
    put(s, pcx.nodes[pcx.nodes[n as usize].a as usize].start, if mut_ref { b"inout " } else { b"let " }, CC_TYPE, tcx,
        pcx);
}

// The parameter types of a function type node (TyFn): `fn(&T)` → `fn(T)`.
fn edit_fn_type(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if !editable(pcx.nodes[n as usize].start, pcx) {
        return;
    }
    for i in 0..pcx.nodes[n as usize].count {
        let tn = child(n, i, pcx);
        let k = pcx.nodes[tn as usize].kind;
        let s = pcx.nodes[tn as usize].start;
        if (k == NodeKind::TyPtr || k == NodeKind::TySlice) && get_src()[s as usize] == b'&'
            && (pcx.nodes[tn as usize].p & CONV_NEW) == 0 && get_src()[(s + 1) as usize] != b'&'
            && (pcx.nodes[tn as usize].p & NODE_REF_MUT) == 0 && (k == NodeKind::TySlice
                || (pcx.nodes[tn as usize].p & NODE_REF) != 0) {
            tcx.type_done.put(tn + 1, 1);
            let inner = if k == NodeKind::TySlice { skip_ws(s + 1) }
                else { pcx.nodes[pcx.nodes[tn as usize].a as usize].start };
            // (Phase M: in a function type an unwritten parameter is
            // taken by value, as 0.19's; a let one is written `let T`)
            put(s, inner, if k == NodeKind::TyPtr { b"let " } else { b"" }, CC_PARAM_LET, tcx, pcx);
        } else if k == NodeKind::TyName && sink_by_name(tn, n, false, 0, tcx, pcx) {
            left(s, CL_FN_TYPE, tcx, pcx);
        }
    }
}

fn postfix_kind(k: NodeKind) -> bool {
    k == NodeKind::Ident || k == NodeKind::FieldAccess || k == NodeKind::Index
        || k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::TupleField
        || k == NodeKind::Path
}

// Whether token k (`*`, `&`) is a prefix operator: what is before it
// does not end an operand.
fn prefix_token(k: i64, pcx: &Ctx<Comp>) -> bool {
    if k == 0 {
        return true;
    }
    let p = pcx.toks[(k - 1) as usize].kind;
    !(p == Tok::Ident || p == Tok::Int || p == Tok::Float || p == Tok::Char || p == Tok::Str
        || p == Tok::CStr || p == Tok::RParen || p == Tok::RBracket || p == Tok::True
        || p == Tok::False || p == Tok::FTail || p == Tok::Question)
}

// Rules 4 and 5 by the tokens, where the checker made the `&mut e` or
// `*r` node another (`&mut a[..]` a slicing, `(*p).f` a field of p): a
// prefix `&mut` is `&`; a prefix `*` before an expression of a reference
// type goes (with the parentheses of `(*p).f`).
fn token_rules(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        let s = pcx.nodes[n as usize].start;
        if !postfix_kind(k) || pcx.nodes[n as usize].ty <= 0 || !editable(s, pcx) {
            continue;
        }
        let have = tcx.postfix_at.get(s + 1);
        if have == 0 || pcx.nodes[have as usize].end < pcx.nodes[n as usize].end {
            tcx.postfix_at.put(s + 1, n);
        }
    }
    for k in 0..pcx.toks.len() as i64 - 1 {
        let kind = pcx.toks[k as usize].kind;
        let s = pcx.toks[k as usize].start;
        if kind != Tok::Amp && kind != Tok::Star || !editable(s, pcx)
            || tcx.fixconv_done.get(s + 1) != 0
            || !prefix_token(k, pcx) {
            continue;
        }
        if kind == Tok::Amp {
            if pcx.toks[(k + 1) as usize].kind == Tok::Mut {
                put(s, pcx.toks[(k + 2) as usize].start, b"&", CC_MARKER, tcx, pcx);
            }
            continue;
        }
        let operand = tcx.postfix_at.get(pcx.toks[(k + 1) as usize].start + 1);
        if operand <= 0 || !is_ref_type(pcx.nodes[operand as usize].ty, pcx) {
            continue;
        }
        let oe = pcx.nodes[operand as usize].end;
        let close = skip_ws(oe);
        if k > 0 && pcx.toks[(k - 1) as usize].kind == Tok::LParen && get_src()[close as usize] == b')'
            && (get_src()[(close + 1) as usize] == b'.' || get_src()[(close + 1) as usize] == b'[') {
            if put(pcx.toks[(k - 1) as usize].start, pcx.toks[(k + 1) as usize].start, b"", CC_DEREF, tcx, pcx) {
                put(close, close + 1, b"", -1, tcx, pcx);
            }
        } else {
            put(s, pcx.toks[(k + 1) as usize].start, b"", CC_DEREF, tcx, pcx);
        }
    }
}

// `&x as *u8`, `&x` to a C function (variadic too): a raw pointer's
// address, as it is (D23); not reported.
fn raw_amps(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Cast && pcx.nodes[n as usize].a > 0 && is_amp(pcx.nodes[n as usize].a, pcx) {
            tcx.amp_seen.put(pcx.nodes[n as usize].a + 1, 1);
        }
        else if k == NodeKind::Call && pcx.nodes[n as usize].x > 0
            && pcx.nodes[n as usize].x - 1 < pcx.fns.len() as i64
            && pcx.fns[(pcx.nodes[n as usize].x - 1) as usize].is_extern {
            for i in 0..pcx.nodes[n as usize].count {
                let a = arg_value(child(n, i, pcx), pcx);
                if a > 0 && is_amp(a, pcx) && !amp_mut(a, pcx) {
                    tcx.amp_seen.put(a + 1, 1);
                }
            }
        }
    }
}

// Identifiers that are 0.20's words (D27: renamed by hand for 0.21).
fn find_words(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let var_sym = intern(b"var", pcx);
    let inout_sym = intern(b"inout", pcx);
    let sink_sym = intern(b"sink", pcx);
    for n in 1..pcx.nodes.len() {
        let k = pcx.nodes[n].kind;
        if k != NodeKind::PatBind && k != NodeKind::Param && k != NodeKind::Field
            && k != NodeKind::Fn {
            continue;
        }
        let a = pcx.nodes[n].a;
        if (a == var_sym || a == inout_sym || a == sink_sym) && (pcx.nodes[n].p & CONV_NEW) == 0 {
            left(pcx.nodes[n].start, CL_WORD, tcx, pcx);
        }
    }
}

// The edits of `fix --only conventions`; the number of rewrites.
pub fn conventions_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    tcx.fixconv_sym_self = intern(b"self", pcx);
    let mut clones = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for f in 0..pcx.fns.len() as i64 {
        let node = pcx.fns[f as usize].node;
        if node > 0 && pcx.nodes[node as usize].kind == NodeKind::Fn {
            if pcx.fns[f as usize].tmpl == 0 {
                tcx.fn_of_node.put(node + 1, f + 1);
            } else {
                clones.put(node + 1, 1);
            }
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Trait {
            for j in 0..pcx.nodes[n as usize].count {
                tcx.trait_fns.put(child(n, j, pcx) + 1, 1);
            }
        }
    }
    find_raw_params(tcx, pcx);
    // The signatures, first (their type nodes are theirs).
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Fn && editable(pcx.nodes[n as usize].start, pcx) && pcx.nodes[n as usize].y == 0
            && clones.get(n + 1) == 0 {
            edit_signature(n, false, tcx, pcx);
        } else if k == NodeKind::Closure && editable(pcx.nodes[n as usize].start, pcx) {
            edit_signature(n, true, tcx, pcx);
        } else if k == NodeKind::TyFn && pcx.nodes[n as usize].d == 0 {
            edit_fn_type(n, tcx, pcx);
        }
    }
    raw_amps(tcx, pcx);
    raw_addresses(tcx, pcx);
    if !tcx.conv_spelling {
        stripped_amps(tcx, pcx);
        slice_amps(tcx, pcx);
    }
    for n in 1..pcx.nodes.len() as i64 {
        edit_node(n, tcx, pcx);
    }
    for n in 1..pcx.nodes.len() as i64 {
        edit_type(n, tcx, pcx);
    }
    // `&mut e` anywhere else; `&e` left
    for n in 1..pcx.nodes.len() as i64 {
        if is_amp(n, pcx) && tcx.amp_seen.get(n + 1) == 0
            && editable(pcx.nodes[n as usize].start, pcx) {
            if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0 {
                if !tcx.conv_spelling {
                    edit_amp(n, false, tcx, pcx);
                }
            } else if !tcx.conv_spelling && get_src()[(pcx.nodes[n as usize].start + 1) as usize] != b'&' {
                if in_hole(pcx.nodes[n as usize].start, pcx) || copied_scrutinee(n, pcx) {
                    // (Phase M: a shared `&e` in an f-string's hole (a
                    // read: the checker checks a copy of the hole), or
                    // the `match &e` of a copyable value: `e`)
                    put(pcx.nodes[n as usize].start, skip_ws(pcx.nodes[n as usize].start + 1), b"", CC_UNMARKED,
                        tcx, pcx);
                } else {
                    left(pcx.nodes[n as usize].start, CL_AMP, tcx, pcx);
                }
            }
        }
    }
    // (`&mut a[..]`, `&mut v[i]`: the checker makes the `&` of a slicing
    // or an element another node, which starts at it)
    for n in 1..pcx.nodes.len() {
        let k = pcx.nodes[n].kind;
        let s = pcx.nodes[n].start;
        if tcx.conv_spelling || k == NodeKind::TyPtr || k == NodeKind::TySlice
            || k == NodeKind::Param || k == NodeKind::Field || k == NodeKind::TyFn
            || k == NodeKind::TyName || s <= 0 || !editable(s, pcx) || get_src()[s as usize] != b'&'
            || get_src()[(s + 1) as usize] == b'&' || !word_here(skip_ws(s + 1), b"mut") {
            continue;
        }
        put(s, skip_ws(after_mut(skip_ws(s + 1))), b"&", CC_MARKER, tcx, pcx);
    }
    if !tcx.conv_spelling {
        token_rules(tcx, pcx);
    }
    find_words(tcx, pcx);
    let mut total: i64 = 0;
    for i in 0..CC_COUNT {
        total += tcx.conv_counts[i as usize];
    }
    total
}

fn left_word(what: i64) -> *mut u8 {
    if what == CL_SHARED_LOCAL {
        c"a shared reference local ('let r = &e;'): use 'e' itself, or a let parameter"
    } else if what == CL_REPOINTED {
        c"a reference local that may be re-pointed ('let mut r = &..'): an access cannot be; use an index or a new binding"
    } else if what == CL_AMP {
        c"'&e' with no let parameter or field to take it: drop it to read, or write 'inout r = &e;'"
    } else if what == CL_AMPAMP {
        c"'&&': a reference to a reference"
    } else if what == CL_FN_TYPE {
        c"a by-value owned parameter of a function type or closure: 'sink T' if it is consumed"
    } else if what == CL_WORD {
        c"an identifier named 'var', 'inout' or 'sink' (keywords from 0.21): rename it"
    } else {
        c"a template's by-value parameter of a type the program never instantiates it with: let assumed; 'sink T' if it is consumed"
    }
}

// The notes of what was left to hand: a count of each, and with
// --list-left each place.
pub fn conventions_report(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        for w in 0..CL_COUNT {
            if tcx.conv_left[w as usize] == 0 {
                continue;
            }
            let d = diag(c"note", c"fix.conv_left", tcx);
            buf_int(d, tcx.conv_left[w as usize]);
            buf_str(d, c" left to hand: ");
            buf_str(d, left_word(w));
            buf_str(d, c"\n");
        }
        if !tcx.conv_list_left {
            return;
        }
        let mut i: i64 = 0;
        while i < tcx.left_at.count {
            let pos = (*tcx.left_at.data.add(i as usize));
            let f = file_of_pos(pos, pcx);
            let mut line: i64 = 1;
            let mut col: i64 = 1;
            for q in pcx.files[f as usize].start..pos {
                if get_src()[q as usize] == b'\n' {
                    line += 1;
                    col = 1;
                } else {
                    col += 1;
                }
            }
            let out = buf_new();
            buf_str(out, pcx.files[f as usize].path);
            buf_str(out, c":");
            buf_int(out, line);
            buf_str(out, c":");
            buf_int(out, col);
            buf_str(out, c": ");
            buf_str(out, left_word((*tcx.left_at.data.add((i + 1) as usize))));
            buf_str(out, c"\n");
            crate::base::buf_write_fd(out, crate::base::STDERR);
            i += 2;
        }
    }
}

// ---- The tools' printer of conventions (T2.a) ----

// Whether the tools write 0.20's spelling: in any crate but the legacy one
// (compiler/src during 0.20), which is written in 0.19's, and but for the
// migrations to 0.19's own forms (`fix --values`, alloc016, std015: their
// output is 0.19 code, which `fix --only conventions` takes on, Phase M).
pub fn new_spelling(tcx: &Tcx<Comp>) -> bool {
    !tcx.write_019
}

// Type t as a tool writes it, into out: in 0.20's spelling an access is
// `inout T` / `let T` (`T` alone as a parameter's, param), `&mut [T]`
// `inout [T]`; in the legacy crate as the checker prints it (`&T`).
pub fn put_type_conv(out: i64, t: i64, param: bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let b = buf_new();
    crate::front::types::buf_type(b, t, pcx);
    if !new_spelling(tcx) {
        buf_bytes(out, crate::base::buf_slice(b));
        return;
    }
    put_type_text_conv(out, crate::base::buf_slice(b), param);
}

// A type's text in 0.19's spelling respelled in 0.20's (put_type_conv).
pub fn put_type_text_conv(out: i64, s: &[u8], param: bool) {
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        if s[i as usize] == b'&' && i + 1 < s.len() as i64 && s[(i + 1) as usize] == b'&' {
            buf_bytes(out, if i == 0 && param { b"let " } else { b"let let " });
            i += 2;
            continue;
        }
        if s[i as usize] == b'&' {
            let mut j = i + 1;
            let mutable = j + 3 < s.len() as i64 && s[j as usize] == b'm' && s[(j + 1) as usize] == b'u' && s[(j + 2) as usize] == b't'
                && s[(j + 3) as usize] == b' ';
            if mutable {
                j += 4;
            }
            let slice = j < s.len() as i64 && s[j as usize] == b'[';
            if mutable {
                buf_bytes(out, b"inout ");
            } else if !(i == 0 && param) && !slice {
                buf_bytes(out, b"let ");
            }
            i = j;
            continue;
        }
        buf_bytes(out, &s[i as usize..(i + 1) as usize]);
        i += 1;
    }
}
