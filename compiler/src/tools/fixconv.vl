// The tools' printer of conventions (0.20, T2.a): what `refactor
// extract-function`, its bodies and `probe` write for a binding and a
// type in the program's spelling. (`fix --only conventions`, 0.19's
// spelling rewritten in 0.20's, was here until 0.28.0.)

use crate::base::{buf_bytes, buf_new, buf_slice};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;

// Whether the tools write 0.20's spelling (MVS's): not in a rust program.
pub fn new_spelling(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    // (0.28.0: a rust-edition program is written in Rust's spelling, which
    // 0.19's is: `mut x: T`, `&mut T` and `&mut x`)
    false
}

// Type t as a tool writes it, into out: in 0.20's spelling an access is
// `inout T` / `let T` (`T` alone as a parameter's, param), `&mut [T]`
// `inout [T]`; in the legacy crate as the checker prints it (`&T`).
pub fn put_type_conv(out: i64, t: i64, param: bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let b = buf_new();
    crate::front::types::buf_type(b, t, pcx);
    {
        // (0.28.0: a raw pointer's type does not say const or mut, and the
        // checker prints `*T`: code written for a rust-edition program
        // says `*mut T`, which every raw pointer converts to)
        let s = crate::base::buf_slice(b);
        for i in 0..s.len() {
            crate::base::buf_byte(out, s[i]);
            if s[i] == b'*' {
                buf_bytes(out, b"mut ");
            }
        }
        return;
    }
    if !new_spelling(tcx, pcx) {
        buf_bytes(out, crate::base::buf_slice(b));
        return;
    }
    put_type_text_conv(out, crate::base::buf_slice(b), param);
}

// A type's text in 0.19's spelling respelled in 0.20's (put_type_conv).
pub fn put_type_text_conv(out: i64, s: &[u8], param: bool) {
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        if s[i as usize] == b'&' && i + 1 < s.len() as i64 && s[(i + 1) as usize] == b'&' {
            buf_bytes(out, if i == 0 && param { b"let " } else { b"let let " });
            i += 2;
            continue;
        }
        if s[i as usize] == b'&' {
            let mut j = i + 1;
            let mutable = j + 3 < s.len() as i64 && s[j as usize] == b'm'
                && s[(j + 1) as usize] == b'u' && s[(j + 2) as usize] == b't'
                && s[(j + 3) as usize] == b' ';
            if mutable {
                j += 4;
            }
            let slice = j < s.len() as i64 && s[j as usize] == b'[';
            if mutable {
                buf_bytes(out, b"inout ");
            } else if !(i == 0 && param) && !slice {
                buf_bytes(out, b"let ");
            }
            i = j;
            continue;
        }
        buf_bytes(out, &s[i as usize..(i + 1) as usize]);
        i += 1;
    }
}
