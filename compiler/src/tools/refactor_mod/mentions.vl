// The mentions of a renamed name in comments (0.14, docs/refactor.md,
// "rename"). Only text between backquotes on a `//` line is a mention,
// and only in these forms:
//
// - an item (a function, type, trait, constant, static, module): `old`,
//   `a::b::old`, `old()`, when no other definition is named old; a bare
//   `old` is left alone in a function that has a local or parameter named
//   old, and in the comment above it (it may be about that local);
// - a member (a field, method, variant, trait function): `Owner.old`,
//   `Owner::old`, `Owner::old()`, `a::Owner::old`, Owner the name of its
//   struct, enum, trait or impl type; never a bare `old` (a parameter or
//   local of that name is as likely);
// - a local (refactor_mod/local.vl): `old`, in its scope.
//
// Words outside backquotes are never changed.

use crate::base::{IntVec, SOURCE_VOLE, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;
use crate::tools::query::c_slice;
use crate::tools::query::defs::{
    K_FIELD, K_IMPL_METHOD, K_METHOD, K_TRAIT_FN, K_VARIANT, bytes_eq, mod_fqn_text,
};
use crate::tools::query::positions::{enclosing, token_at};
use crate::tools::query::show::text_start;
use crate::tools::refactor_mod::{put_edit, text_of};
use crate::tools::refactor_mod::cli::is_ident;
use crate::tools::refactor_mod::local::{decl_name_pos, load_decls};

pub const MENTION_ITEM: i64 = 0;
pub const MENTION_MEMBER: i64 = 1;
pub const MENTION_LOCAL: i64 = 2;

// The mentions of the old name of the definitions of group (renamed to
// new) in the comments of the program's files.
pub fn doc_mentions(group: IntVec, old: i64, new: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let d = (*group.data.add(0));
        let k = pcx.defs[d as usize].kind;
        let o = sym_text(old, pcx);
        let member = k == K_FIELD || k == K_VARIANT || k == K_METHOD || k == K_IMPL_METHOD
            || k == K_TRAIT_FN;
        let mut owner = &o[0..0];
        tcx.item_module = if member { -1 } else { pcx.defs[d as usize].module };
        tcx.item_unique = true;
        if member {
            owner = owner_name(d, pcx);
            if owner.len() == 0 {
                return;
            }
        } else {
            for e in 0..pcx.defs.len() as i64 {
                if pcx.defs[e as usize].name != old {
                    continue;
                }
                let mut mine = false;
                for i in 0..group.count {
                    if (*group.data.add(i as usize)) == e {
                        mine = true;
                    }
                }
                if !mine {
                    // (0.17: another item has the name: only the path
                    // mentions that name its module)
                    tcx.item_unique = false;
                }
            }
            // (the functions with a local of that name)
            load_decls(pcx);
            tcx.keep_bare.count = 0;
            for n in 1..pcx.nodes.len() as i64 {
                if pcx.nodes[n as usize].a != old {
                    continue;
                }
                let p = decl_name_pos(n, pcx);
                let f: i64 = if p >= 0 { enclosing(p, tcx, pcx) } else { -1 };
                if f >= 0 {
                    tcx.keep_bare.push(text_start(f, pcx));
                    tcx.keep_bare.push(pcx.defs[f as usize].end);
                }
            }
        }
        for f in 0..pcx.files.len() {
            if (*pcx.files[f].path.add(0)) == b'<' || pcx.files[f].kind != SOURCE_VOLE {
                continue;
            }
            scan_mentions(pcx.files[f].start, pcx.files[f].end, o, new,
                if member { MENTION_MEMBER } else { MENTION_ITEM }, owner, tcx, pcx);
        }
    }
}

// The name of the struct, enum or trait member d belongs to, or of its
// impl's type (its path's last segment); empty when unknown.
fn owner_name(d: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    if pcx.defs[d as usize].parent >= 0 {
        return sym_text(pcx.defs[pcx.defs[d as usize].parent as usize].name, pcx);
    }
    if pcx.defs[d as usize].owner <= 0 {
        return b"";
    }
    let t = sym_text(pcx.defs[d as usize].owner, pcx);
    let mut e: i64 = 0;
    while e < t.len() as i64 && t[e as usize] != b'<' {
        e += 1;
    }
    let mut s = e;
    while s > 0 && t[(s - 1) as usize] != b':' {
        s -= 1;
    }
    &t[s as usize..e as usize]
}

// The mentions in the comments of SRC[a..b) (a, b in one file, outside
// tokens): the gaps between its tokens hold the comments.
pub fn scan_mentions(a: i64, b: i64, old: &[u8], new: &[u8], mode: i64, owner: &[u8],
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut from = a;
    let mut i = token_at(a, pcx);
    loop {
        let to = if i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < b { pcx.toks[i as usize].start }
            else { b };
        mentions_in(from, to, old, new, mode, owner, tcx, pcx);
        if to >= b {
            break;
        }
        from = pcx.toks[i as usize].end;
        i += 1;
    }
}

// The mentions in the comments of SRC[from..to) (no token in it).
fn mentions_in(from: i64, to: i64, old: &[u8], new: &[u8], mode: i64, owner: &[u8],
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut p = from;
    while p + 1 < to {
        if get_src()[p as usize] != b'/' || get_src()[(p + 1) as usize] != b'/' {
            p += 1;
            continue;
        }
        // A comment: its backquoted spans.
        let mut q = p + 2;
        while q < to && get_src()[q as usize] != b'\n' {
            if get_src()[q as usize] != b'`' {
                q += 1;
                continue;
            }
            let mut e = q + 1;
            while e < to && get_src()[e as usize] != b'`' && get_src()[e as usize] != b'\n' {
                e += 1;
            }
            if e >= to || get_src()[e as usize] != b'`' {
                break;
            }
            let s = &get_src()[(q + 1) as usize..e as usize];
            let mut at: i64 = -1;
            if mode == MENTION_LOCAL {
                if bytes_eq(s, old) {
                    at = 0;
                }
            } else if mode == MENTION_MEMBER {
                at = member_mention(s, old, owner);
            } else {
                at = mention(s, old, tcx, pcx);
                if at == 0 && s.len() == old.len() && keeps_bare(q, tcx) {
                    at = -1;
                }
            }
            if at >= 0 {
                put_edit(q + 1 + at, q + 1 + at + old.len() as i64, text_of(new), tcx, pcx);
            }
            q = e + 1;
        }
        p = q;
    }
}

// Whether position p is in one of the KEEP_BARE ranges.
fn keeps_bare(p: i64, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i + 1 < tcx.keep_bare.count {
            if p >= (*tcx.keep_bare.data.add(i as usize)) && p < (*tcx.keep_bare.data.add((i + 1) as usize)) {
                return true;
            }
            i += 2;
        }
        false
    }
}

// Where old is in s when s is `old`, `a::b::old` or `old()`, else -1.
fn mention(s: &[u8], old: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut t = s;
    if t.len() > 2 && t[(t.len() as i64 - 2) as usize] == b'(' && t[(t.len() as i64 - 1) as usize] == b')' {
        t = &t[0..(t.len() as i64 - 2) as usize];
    }
    if t.len() < old.len()
        || !bytes_eq(&t[(t.len() as i64 - old.len() as i64) as usize..], old) {
        return -1;
    }
    let at = t.len() as i64 - old.len() as i64;
    if at == 0 {
        return if tcx.item_unique { 0 } else { -1 };
    }
    if at < 3 || t[(at - 1) as usize] != b':' || t[(at - 2) as usize] != b':' {
        return -1;
    }
    if path_prefix(&t[0..(at - 2) as usize]) && names_item_module(&t[0..(at - 2) as usize], tcx, pcx) { at } else { -1 }
}

// Where old is in s when s is `Owner.old`, `Owner::old`, `Owner::old()`
// or `a::Owner::old`, else -1.
fn member_mention(s: &[u8], old: &[u8], owner: &[u8]) -> i64 {
    let mut t = s;
    if t.len() > 2 && t[(t.len() as i64 - 2) as usize] == b'(' && t[(t.len() as i64 - 1) as usize] == b')' {
        t = &t[0..(t.len() as i64 - 2) as usize];
    }
    if t.len() as i64 < old.len() as i64 + 2
        || !bytes_eq(&t[(t.len() as i64 - old.len() as i64) as usize..], old) {
        return -1;
    }
    let at = t.len() as i64 - old.len() as i64;
    let mut end = at - 1;
    if t[(at - 1) as usize] == b':' {
        if t[(at - 2) as usize] != b':' {
            return -1;
        }
        end = at - 2;
    } else if t[(at - 1) as usize] != b'.' {
        return -1;
    }
    if end < owner.len() as i64 || !bytes_eq(&t[(end - owner.len() as i64) as usize..end as usize], owner) {
        return -1;
    }
    let start = end - owner.len() as i64;
    if start == 0 {
        return at;
    }
    if start < 3 || t[(start - 1) as usize] != b':' || t[(start - 2) as usize] != b':' {
        return -1;
    }
    if path_prefix(&t[0..(start - 2) as usize]) { at } else { -1 }
}

// Whether s is a path: identifiers (`crate`, `super`) joined by `::`.
fn path_prefix(s: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let mut e = i;
        while e < s.len() as i64 && s[e as usize] != b':' {
            e += 1;
        }
        if !is_ident(&s[i as usize..e as usize]) && !bytes_eq(&s[i as usize..e as usize], c_slice(c"crate"))
            && !bytes_eq(&s[i as usize..e as usize], c_slice(c"super")) {
            return false;
        }
        i = e + 2;
    }
    true
}

// (0.17) Whether path prefix s can name module ITEM_MODULE: its path ends
// with s by whole segments (`crate` is the root); with `self` or `super`
// in it, yes.
fn names_item_module(s: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if tcx.item_module < 0 {
        return true;
    }
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let mut e = i;
        while e < s.len() as i64 && s[e as usize] != b':' {
            e += 1;
        }
        if bytes_eq(&s[i as usize..e as usize], c_slice(c"self")) || bytes_eq(&s[i as usize..e as usize], c_slice(c"super")) {
            return tcx.item_unique;
        }
        i = e + 2;
    }
    let m = mod_fqn_text(tcx.item_module, tcx, pcx);
    bytes_eq(m, s)
        || (m.len() as i64 > s.len() as i64 + 2
            && bytes_eq(&m[(m.len() as i64 - s.len() as i64) as usize..], s)
            && m[(m.len() as i64 - s.len() as i64 - 1) as usize] == b':')
}
