// The command line of the module refactorings and rename (made by
// `refactor split crate::refactor_mod --auto`, then renamed).

use crate::base::{IntVec, SYMS, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_FLAG, EV_OPTION, EV_WORD, Leaf, flag, option};
use crate::front::ast::NodeKind;
use crate::front::modules::{child_module, file_of_pos};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::apply::{apply_edit, finish_edit, prepare_edit, set_command};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::query::{c_slice, parse_count, resolve_name, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{K_IMPL_METHOD, K_MOD, K_TRAIT_FN, bytes_eq, mod_fqn_text, trait_of};
use crate::tools::query::diagnostics::{
    diag, program_errors, put_word, try_begin, try_end, write_diags,
};
use crate::tools::query::names::canonical_name;
use crate::tools::query::show::find_modules;
use crate::tools::refactor_mod::{
    emit_regions, load_refs, make_module, own_file, relocate_module, rename_collides, rename_refs,
    within,
};
use crate::tools::refactor_mod::local::{def_at_column, local_rename};
use crate::tools::refactor_mod::mentions::doc_mentions;
use crate::tools::refactor_move::{run_move, run_split};
use crate::tools::tidyimports::tidy_round;

// Whether node u is a `use` of names (not a `*`, not a C header's import),
// in a file of the program.
pub fn is_name_use(u: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[u].kind == NodeKind::Use && pcx.nodes[u].d != 2 && pcx.nodes[u].b != 1
        && user_pos(pcx.nodes[u].start, pcx)
}

pub fn user_pos(pos: i64, pcx: Ctx<Comp>) -> bool {
    unsafe { pcx.files[file_of_pos(pos, pcx)].path[0] != '<' }
}

// The edit, applied: summary `what`; refused when its edits overlap.
pub fn finish(what: i64, root: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    if tcx.cli_edit_failed {
        let d = diag(c"error", c"refactor.internal", &tcx);
        buf_str(d,
            c"the edits overlap (a case the refactoring does not handle); nothing written\n");
        return 1;
    }
    if !tcx.tidy_after || tcx.opt_no_tidy {
        return apply_edit(buf_slice(what), root, &tcx, &pcx);
    }
    // (move and split: the imports of the files edited, tidied)
    let status = prepare_edit(&tcx, &pcx);
    if status >= 0 {
        return status;
    }
    tidy_round(root, &tcx, pcx);
    finish_edit(buf_slice(what), root, &tcx, &pcx)
}

pub fn usage(message: *u8, example: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"refactor.usage", &tcx);
    buf_str(d, message);
    buf_byte(d, '\n');
    if example != 0 as *u8 {
        let out = try_begin(example, c_slice(c""), false, &tcx, pcx);
        try_end(out);
    }
    2
}

// A path that names no module.
pub fn no_module(name: [u8], cmd: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"refactor.no-module", &tcx);
    buf_str(d, c"no module '");
    buf_bytes(d, name);
    buf_str(d, c"'\n");
    if cmd != 0 as *u8 {
        let out = try_begin(cmd, name, true, &tcx, pcx);
        try_end(out);
    } else {
        let out = try_begin(c"items", c_slice(c""), false, &tcx, pcx);
        try_end(out);
    }
    1
}

// Keeps the definitions in the program's files (std's and the C headers'
// aside), unless there are none.
pub fn keep_source(matches: inout IntVec, pcx: Ctx<Comp>) {
    unsafe {
        var kept = 0;
        for i in 0..matches.count {
            let d = matches.data[i];
            if user_pos(pcx.defs[d].start, pcx) {
                matches.data[kept] = d;
                kept += 1;
            }
        }
        if kept > 0 {
            matches.count = kept;
        }
    }
}

// NAME names several definitions: the first ones, as the command to run.
pub fn ambiguous(cmd: *u8, name: [u8], rest: [u8], matches: IntVec, tcx: inout Tcx<Comp>,
    pcx: Ctx<Comp>) {
    unsafe {
        let n = matches.count;
        let d = diag(c"error", c"query.ambiguous", &tcx);
        buf_int_n(d, n);
        buf_str(d, c" definitions match '");
        buf_bytes(d, name);
        buf_str(d, c"'; name one\n");
        for i in 0..n {
            if i == 3 || (i == 2 && n > 3) {
                break;
            }
            let out = try_begin(cmd, SYMS[pcx.defs[matches.data[i]].fqn].text, true, &tcx, pcx);
            if rest.len > 0 {
                put_word(out, rest);
            }
            try_end(out);
        }
        if n > 3 {
            let out = try_begin(c"def", name, true, &tcx, pcx);
            try_end(out);
        }
    }
}

fn buf_int_n(out: i64, n: i64) {
    crate::base::buf_int(out, n);
}

// The one definition NAME names in the program's files (for command cmd,
// `rest` its other words), or -1 after the diagnostic.
pub fn one_definition(cmd: *u8, name: [u8], rest: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !resolve_name(c"def", name, &matches, &tcx, &pcx) {
            return -1;
        }
        keep_source(&matches, pcx);
        if matches.count > 1 {
            ambiguous(cmd, name, rest, matches, &tcx, pcx);
            return -1;
        }
        let d = matches.data[0];
        if !user_pos(pcx.defs[d].start, pcx) {
            let e = diag(c"error", c"edit.not-source", &tcx);
            buf_bytes(e, SYMS[pcx.defs[d].fqn].text);
            buf_str(e, c" is not in a file of the program\n");
            return -1;
        }
        d
    }
}

// Whether s is an identifier (and not a keyword).
pub fn is_ident(s: [u8]) -> bool {
    if s.len == 0 || (s[0] >= '0' && s[0] <= '9') {
        return false;
    }
    for i in 0..s.len {
        let c = s[i];
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_') {
            return false;
        }
    }
    let words = c"fn let mut struct if else loop while for in break continue true false as return extern const static type enum match impl union import use pub mod defer unsafe trait crate super self Self ";
    let w = c_slice(words);
    var i = 0;
    while i < w.len as i64 {
        var e = i;
        while w[e] != ' ' {
            e += 1;
        }
        if bytes_eq(w[i..e], s) {
            return false;
        }
        i = e + 1;
    }
    true
}

// The module a path names (`crate`, `crate::a::b`, or its end), or -1.
pub fn module_named(name: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(name, false, &found, &tcx, pcx);
        var best = -1;
        for i in 0..found.count {
            let m = found.data[i];
            if bytes_eq(mod_fqn_text(m, &tcx, pcx), name) {
                return m;
            }
            best = if best < 0 { m } else { -2 };
        }
        if best >= 0 { best } else { -1 }
    }
}

// The segments of path `crate::a::b` (symbols, `crate` left out), or
// false when it is not such a path. (0.15: `a::b` is `crate::a::b`, and
// any spelling a tool prints, `a::mod`, is taken: canonical_name.)
pub fn path_segments(path0: [u8], out: inout IntVec) -> bool {
    var path = canonical_name(path0);
    if !(path == "crate" || (path.len > 7 && path[0..7] == "crate::")) {
        let full = buf_new();
        buf_str(full, c"crate::");
        buf_bytes(full, path);
        path = buf_slice(full);
    }
    var i = 5;
    while i < path.len as i64 {
        if i + 2 > path.len as i64 || path[i] != ':' || path[i + 1] != ':' {
            return false;
        }
        i += 2;
        var e = i;
        while e < path.len as i64 && path[e] != ':' {
            e += 1;
        }
        if !is_ident(path[i..e]) {
            return false;
        }
        out.push(intern(path[i..e]));
        i = e;
    }
    true
}

pub fn run_refactor_mod(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let status = run_inner(c, &tcx, &pcx);
    write_diags(tcx);
    status
}

// `refactor rename|move|new-module|move-module|split`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn refactor_mod_leaf(gpa: Gpa) -> Leaf<Gpa> {
    var table = edit_opts(gpa);
    table.push(option("to", "MODULE", "move: the module to move to"));
    table.push(option("into", "MODULE", "split: the new module"));
    table.push(option("items", "A,B", "split: the items to move"));
    table.push(option("max-lines", "N", "split: the size to plan for"));
    table.push(option("names", "A,B", "split: the new modules' names"));
    table.push(option("after", "ITEM", "move: after ITEM"));
    table.push(option("before", "ITEM", "move: before ITEM"));
    table.push(option("header", "TEXT", "split: the new files' header comment"));
    table.push(flag("plan", "split: the plan only"));
    table.push(flag("auto", "split: by the plan"));
    table.push(flag("dir", "new-module: a folder (mod.vl)"));
    table.push(flag("file", "new-module: a file"));
    table.push(flag("keep-impls", "move: the impls stay"));
    table.push(flag("group-impls", "split: impls with their types"));
    table.push(flag("reexport", "split: pub use of what moved"));
    table.push(flag("no-tidy", "the imports left as they are"));
    Leaf::new(table, "word")
}

fn run_inner(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    set_command(c.line, &tcx);
    let cmd = c.line.c(2);
    let sub = c.word(2);
    var root = 0 as *u8;
    var words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for e in c.evs.iter() {
        var ev = e;
        let v = ev.value;
        if ev.kind == EV_OPTION && ev.name == "to" {
            tcx.opt_to = v;
        } else if ev.kind == EV_OPTION && ev.name == "into" {
            tcx.opt_into = v;
        } else if ev.kind == EV_OPTION && ev.name == "items" {
            tcx.opt_items = v;
        } else if ev.kind == EV_OPTION && ev.name == "max-lines" {
            tcx.opt_max_lines = parse_count(v);
            if tcx.opt_max_lines <= 0 {
                return usage(c"--max-lines takes a number of lines", 0 as *u8, &tcx, pcx);
            }
        } else if ev.kind == EV_FLAG && ev.name == "plan" {
            tcx.opt_plan = true;
        } else if ev.kind == EV_FLAG && ev.name == "auto" {
            tcx.opt_auto = true;
        } else if ev.kind == EV_FLAG && ev.name == "dir" {
            tcx.opt_dir = true;
        } else if ev.kind == EV_FLAG && ev.name == "file" {
            tcx.opt_dir = false;
        } else if ev.kind == EV_FLAG && ev.name == "keep-impls" {
            tcx.opt_keep_impls = true;
        } else if ev.kind == EV_FLAG && ev.name == "group-impls" {
            tcx.opt_group_impls = true;
        } else if ev.kind == EV_FLAG && ev.name == "reexport" {
            tcx.opt_reexport = true;
        } else if ev.kind == EV_FLAG && ev.name == "no-tidy" {
            tcx.opt_no_tidy = true;
        } else if ev.kind == EV_OPTION && ev.name == "names" {
            tcx.cli_opt_names = v;
        } else if ev.kind == EV_OPTION && ev.name == "after" {
            tcx.opt_after = v;
        } else if ev.kind == EV_OPTION && ev.name == "before" {
            tcx.opt_before = v;
        } else if ev.kind == EV_OPTION && ev.name == "header" {
            tcx.opt_header = v;
        } else if take_edit_event(&ev, &root, &tcx, &pcx) {
        } else if ev.kind != EV_WORD {
            let d = diag(c"error", c"refactor.usage", &tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"'\n");
            return 2;
        } else {
            words.push(ev.value as i64);
        }
    }
    unsafe {
        if root == 0 as *u8 && words.count > 0
            && crate::base::is_source_path(words.data[words.count - 1] as *u8) {
            root = words.data[words.count - 1] as *u8;
            words.count -= 1;
        }
        tcx.root_given = root;
        let n = words.count;
        let w0 = if n > 0 { c_slice(words.data[0] as *u8) } else { c_slice(c"") };
        let w1 = if n > 1 { c_slice(words.data[1] as *u8) } else { c_slice(c"") };
        // The command's words, checked before the program is read.
        if sub == "rename" && n != 2 {
            return usage(c"rename takes PATH and the NEW name", c"rename crate::m::old new", &tcx,
                pcx);
        }
        if sub == "rename" && !is_ident(w1) {
            return usage(c"the new name must be an identifier (not a keyword)", 0 as *u8, &tcx,
                pcx);
        }
        if sub == "move" && (n == 0 || (tcx.opt_to == 0 as *u8 && n < 2)) {
            return usage(c"move takes PATH... and the MODULE (`--to MODULE`)",
                c"move crate::m::item --to crate::other", &tcx, pcx);
        }
        if (sub == "new-module" && n != 1) || (sub == "move-module" && n != 2) {
            return usage(if n == 0
                || sub == "move-module" { c"a module path is needed (crate::a::b)" }
                else { c"one module at a time" },
                if sub == "new-module" { c"new-module crate::a::b" }
                else { c"move-module crate::a crate::b::a" }, &tcx, pcx);
        }
        if sub == "split"
            && (n != 1
                || (!tcx.opt_plan && !tcx.opt_auto
                    && (tcx.opt_into == 0 as *u8 || tcx.opt_items == 0 as *u8))) {
            return usage(
                c"split takes MODULE and --into NEWMOD --items a,b,c, or --plan, or --auto",
                c"split crate::m --plan", &tcx, pcx);
        }
        root = root_or_diag(root, cmd, w0, true, &tcx, pcx);
        if root == 0 as *u8 {
            return 2;
        }
        if !load_program(root, tcx.target, &tcx, &pcx) {
            program_errors(c"error", root, true, &tcx, &pcx);
            return 1;
        }
        if sub == "rename" {
            return run_rename(w0, w1, root, &tcx, &pcx);
        }
        if sub == "new-module" {
            return run_new_module(w0, root, &tcx, &pcx);
        }
        if sub == "move-module" {
            return run_move_module(w0, w1, root, &tcx, &pcx);
        }
        if sub == "move" {
            if tcx.opt_to == 0 as *u8 {
                tcx.opt_to = words.data[n - 1] as *u8;
                words.count -= 1;
            }
            return run_move(words, tcx.opt_to, root, &tcx, &pcx);
        }
        run_split(w0, root, &tcx, &pcx)
    }
}

// `refactor rename PATH NEW`: the definition and every reference to it
// (its uses, imports and paths) get the new name; a module's file (or
// directory) is renamed too. A trait impl's function is renamed with the
// trait's: the trait's function and every impl's. At FILE:LINE:COL (0.14):
// the local there (local.vl), else the definition referred to or
// defined there. Backquoted mentions in comments: mentions.vl.
fn run_rename(name: [u8], new: [u8], root: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let local = local_rename(name, new, root, &tcx, &pcx);
        if local >= 0 {
            return local;
        }
        load_refs(&tcx, &pcx);
        var d = def_at_column(name, &tcx, pcx);
        if d == -2 {
            return 1;
        }
        if d < 0 {
            d = one_definition(c"rename", name, new, &tcx, &pcx);
        }
        if d < 0 {
            return 1;
        }
        if pcx.defs[d].kind == K_IMPL_METHOD {
            let t = trait_of(d, tcx, pcx);
            var tf = -1;
            if t >= 0 {
                for e in 0..pcx.defs.len() as i64 {
                    if pcx.defs[e].parent == t && pcx.defs[e].name == pcx.defs[d].name {
                        tf = e;
                    }
                }
            }
            if tf < 0 || !user_pos(pcx.defs[tf].start, pcx) {
                let e = diag(c"error", c"edit.not-source", &tcx);
                buf_bytes(e, SYMS[pcx.defs[d].fqn].text);
                buf_str(e,
                    c" implements a function of a trait that is not in a file of the program\n");
                return 1;
            }
            d = tf;
        }
        let old = pcx.defs[d].name;
        let newsym = intern(new);
        if old == newsym {
            let e = diag(c"note", c"edit.unchanged", &tcx);
            buf_str(e, c"nothing to change\n");
            return 0;
        }
        // The definitions renamed together: a trait's function and its impls'.
        var group = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        group.push(d);
        if pcx.defs[d].kind == K_TRAIT_FN {
            for e in 0..pcx.defs.len() as i64 {
                if pcx.defs[e].kind == K_IMPL_METHOD && pcx.defs[e].name == old
                    && trait_of(e, tcx, pcx) == pcx.defs[d].parent {
                    group.push(e);
                }
            }
        }
        if rename_collides(d, group, newsym, &tcx, &pcx) {
            return 1;
        }
        let m = if pcx.defs[d].kind == K_MOD { child_module(pcx.defs[d].module, old, pcx) }
            else { -1 };
        if m >= 0 && own_file(m, pcx) >= 0 {
            // (a module of its own file: the file is renamed too)
            let status = relocate_module(m, pcx.modules[m].parent, newsym, &tcx, &pcx);
            if status >= 0 {
                return status;
            }
        } else {
            rename_refs(group, old, new, &tcx, &pcx);
        }
        doc_mentions(group, old, new, &tcx, &pcx);
        finish_rename(d, new, root, &tcx, &pcx)
    }
}

fn finish_rename(d: i64, new: [u8], root: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let what = buf_new();
    buf_str(what, c"renamed ");
    buf_bytes(what, SYMS[pcx.defs[d].fqn].text);
    buf_str(what, c" to ");
    buf_bytes(what, new);
    finish(what, root, &tcx, &pcx)
}

// `refactor new-module crate::a::b [--file|--dir]`: makes the module's
// file (`a/b.vl`, or `a/b/mod.vl`) and its `mod b;` line in its
// parent, making the modules of the path that do not exist (as dir
// modules); a file module that gains a child becomes a dir module
// (`a.vl` -> `a/mod.vl`).
fn run_new_module(path: [u8], root: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    var segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    if !path_segments(path, &segs) || segs.count == 0 {
        return usage(c"a module path is needed (crate::a::b)", c"new-module crate::a::b", &tcx,
            pcx);
    }
    load_refs(&tcx, &pcx);
    var converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    let r = make_path(segs, segs.count, tcx.opt_dir, &converts, &tcx, pcx);
    if r == -2 {
        let d = diag(c"error", c"refactor.exists", &tcx);
        buf_str(d, c"module ");
        buf_bytes(d, path);
        buf_str(d, c" exists\n");
        let out = try_begin(c"items", path, true, &tcx, pcx);
        try_end(out);
        return 1;
    }
    if r < 0 {
        return 1;
    }
    emit_regions(&tcx, &pcx);
    let what = buf_new();
    buf_str(what, c"made module ");
    buf_bytes(what, path);
    finish(what, root, &tcx, &pcx)
}

// The region of the module with path segs[0..n) (after `crate`), made
// when it does not exist (and the modules before it); the last one a dir
// module when `dir`. -2 when it exists and `n` is all of segs and none is
// made, -1 after a diagnostic.
pub fn make_path(segs: IntVec, n: i64, dir: bool, converts: inout HMap, tcx: inout Tcx<Comp>,
    pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var m = 0;
        var k = 0;
        while k < n {
            let c = child_module(m, segs.data[k], pcx);
            if c < 0 {
                break;
            }
            m = c;
            k += 1;
        }
        if k == n {
            return -2;
        }
        var r = m;
        while k < n {
            let name = segs.data[k];
            let last = k == n - 1;
            r = make_module(r, name, if last { dir } else { true }, &converts, &tcx, pcx);
            if r < 0 {
                return -1;
            }
            k += 1;
        }
        r
    }
}

pub fn inline_module(m: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"refactor.inline", &tcx);
    buf_bytes(d, mod_fqn_text(m, &tcx, pcx));
    buf_str(d, c" is an inline module (`mod m { }`); the module refactorings work on modules of their own files\n");
    1
}

// `refactor move-module crate::a crate::x::b`: module a, its file (or
// directory) and its children's, becomes crate::x::b: the modules of the
// path that do not exist are made (dir modules), its `mod` line moves to
// its new parent, every path and `use` naming it is rewritten, and the
// `super::` paths inside it that lead out of it are written from `crate`.
fn run_move_module(from: [u8], to: [u8], root: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let m = module_named(from, &tcx, pcx);
        if m <= 0 {
            return no_module(from, 0 as *u8, &tcx, pcx);
        }
        if own_file(m, pcx) < 0 {
            return inline_module(m, &tcx, pcx);
        }
        var segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !path_segments(to, &segs) || segs.count == 0 {
            return usage(c"the new path of the module is needed (crate::x::b)",
                c"move-module crate::a crate::x::a", &tcx, pcx);
        }
        load_refs(&tcx, &pcx);
        var converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        // The new parent (made when it does not exist).
        let n = segs.count;
        var parent = 0;
        if n > 1 {
            parent = make_path(segs, n - 1, true, &converts, &tcx, pcx);
            if parent == -2 {
                // (it exists)
                parent = 0;
                for k in 0..n - 1 {
                    parent = child_module(parent, segs.data[k], pcx);
                }
            }
            if parent < 0 {
                return 1;
            }
        }
        if within(parent, m, tcx, pcx) {
            return usage(c"a module cannot move into itself", 0 as *u8, &tcx, pcx);
        }
        let name = segs.data[n - 1];
        if parent == pcx.modules[m].parent && name == pcx.modules[m].name {
            let e = diag(c"note", c"edit.unchanged", &tcx);
            buf_str(e, c"nothing to change\n");
            return 0;
        }
        let status = relocate_module(m, parent, name, &tcx, &pcx);
        if status >= 0 {
            return status;
        }
        crate::tools::refactor_move::imports::emit_use_edits(&tcx, &pcx);
        emit_regions(&tcx, &pcx);
        let what = buf_new();
        buf_str(what, c"moved module ");
        buf_bytes(what, mod_fqn_text(m, &tcx, pcx));
        buf_str(what, c" to ");
        buf_bytes(what, to);
        finish(what, root, &tcx, &pcx)
    }
}
