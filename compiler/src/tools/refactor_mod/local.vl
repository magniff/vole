// Renaming a local (0.14): `refactor rename FILE:LINE:COL NEW` at a local
// variable or a parameter (its declaration or a use), or `refactor rename
// FN::local NEW`. A local is what the checker resolved: each `let`,
// pattern binding and parameter declares one of its own, so another local
// of the same name (one it shadows, or one shadowing it) keeps its name.
// Its declaration and every use are renamed, and the backquoted mentions
// `old` in the comments of its scope (for a parameter: of its function,
// the comment above it included). Refused when the new name is already a
// name in that scope: another local declared there, or a name used there
// that is not this local.

use crate::base::{
    IntVec, get_src, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NODE_CAPTURE, NodeKind};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{c_slice, parse_digits, trailing_number};
use crate::tools::query::defs::{K_FN, K_IMPL_METHOD, K_METHOD, K_TRAIT_FN, bytes_eq, find_defs};
use crate::tools::query::diagnostics::{diag, put_word, try_begin, try_end};
use crate::tools::query::positions::{
    enclosing, find_name, line_end, line_index, put_loc, shorthand_at, shorthand_text, token_at,
};
use crate::tools::query::show::text_start;
use crate::tools::query::typeat::file_named;
use crate::tools::refactor_mod::{put_edit, text_of};
use crate::tools::refactor_mod::cli::{finish, user_pos};
use crate::tools::refactor_mod::mentions::{MENTION_LOCAL, scan_mentions};
use crate::tools::refactor_shape::body::{load_body, parent};

// The position of the name the PatBind or Param node n declares, or -1
// (n declares no local in a file of the program).
pub fn decl_name_pos(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = pcx.nodes[n as usize].kind;
    if k != NodeKind::PatBind && k != NodeKind::Param {
        return -1;
    }
    let l = pcx.nodes[n as usize].x;
    if l < 0 || l >= pcx.locals.len() as i64 || pcx.locals[l as usize].name != pcx.nodes[n as usize].a
        || pcx.nodes[n as usize].end <= pcx.nodes[n as usize].start || !user_pos(pcx.nodes[n as usize].start, pcx) {
        return -1;
    }
    find_name(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx.nodes[n as usize].a, false, pcx)
}

// Fills DECL_POS.
pub fn load_decls(pcx: &mut Ctx<Comp>) {
    if pcx.decl_pos.count > 0 {
        return;
    }
    for n in 1..pcx.nodes.len() as i64 {
        let p = decl_name_pos(n, pcx);
        if p >= 0 && pcx.decl_pos.get(pcx.nodes[n as usize].x + 1) == 0 {
            pcx.decl_pos.put(pcx.nodes[n as usize].x + 1, p + 1);
        }
    }
}

// The position of the declaration of the local node n names (an Ident),
// or -1 (0.14: also a use a closure captured, rewritten to the closure's
// environment and flagged NODE_CAPTURE: its local).
pub fn use_decl(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if (pcx.nodes[n as usize].p & NODE_CAPTURE) != 0 && pcx.nodes[n as usize].d > 0 {
        return pcx.decl_pos.get(pcx.nodes[n as usize].d) - 1;
    }
    if pcx.nodes[n as usize].kind != NodeKind::Ident || pcx.nodes[n as usize].res != Res::Local {
        return -1;
    }
    let l = pcx.nodes[n as usize].y;
    if l < 0 || l >= pcx.locals.len() as i64 || pcx.locals[l as usize].name != pcx.nodes[n as usize].a {
        return -1;
    }
    pcx.decl_pos.get(l + 1) - 1
}

// The start of the identifier at `FILE:LINE:COL` (the column anywhere in
// it), or -1: NAME is not of that form, or no identifier is there.
pub fn ident_at_column(name: &[u8], pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let a = trailing_number(name);
        if a <= 0 || name[(a - 1) as usize] != b':' || (a >= 2 && name[(a - 2) as usize] == b':') {
            return -1;
        }
        let col = parse_digits(&name[a as usize..]);
        let rest = &name[0..(a - 1) as usize];
        let b = trailing_number(rest);
        if b <= 0 || rest[(b - 1) as usize] != b':' || (b >= 2 && rest[(b - 2) as usize] == b':') {
            return -1;
        }
        let line = parse_digits(&rest[b as usize..]);
        let f = file_named(&rest[0..(b - 1) as usize], pcx);
        if f < 0 || line < 1 || col < 1 {
            return -1;
        }
        let idx = line_index(pcx.files[f as usize].start, pcx) + line - 1;
        if idx >= pcx.lines.count || (*pcx.lines.data.add(idx as usize)) >= pcx.files[f as usize].end {
            return -1;
        }
        let pos = (*pcx.lines.data.add(idx as usize)) + col - 1;
        if pos >= line_end((*pcx.lines.data.add(idx as usize)), pcx) {
            return -1;
        }
        let mut t = token_at(pos, pcx);
        if t >= pcx.toks.len() as i64 || pcx.toks[t as usize].start > pos {
            t -= 1;
        }
        if t < 0 || pcx.toks[t as usize].kind != Tok::Ident || pcx.toks[t as usize].start > pos
            || pcx.toks[t as usize].end <= pos {
            return -1;
        }
        pcx.toks[t as usize].start
    }
}

// The declaration of the local at position at (its declaration's name, or
// a use), or -1.
pub fn local_at(at: i64, pcx: &Ctx<Comp>) -> i64 {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].start > at || pcx.nodes[n as usize].end <= at {
            continue;
        }
        if decl_name_pos(n, pcx) == at {
            return at;
        }
        if pcx.nodes[n as usize].start == at {
            let d = use_decl(n, pcx);
            if d >= 0 {
                return d;
            }
        }
    }
    -1
}

// `FILE:LINE:COL` at a reference or a definition's name (refs loaded):
// that definition; -1 when NAME is not a position at one (rename takes
// the innermost item holding the line), -2 after a diagnostic (one not in
// a file of the program).
pub fn def_at_column(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let at = ident_at_column(name, pcx);
        if at < 0 {
            return -1;
        }
        let mut d: i64 = -1;
        for k in 0..tcx.refs.count {
            let r = (*tcx.refs.data.add(k as usize));
            if (*tcx.r_pos.data.add(r as usize)) == at {
                d = (*tcx.r_def.data.add(r as usize));
                break;
            }
        }
        if d < 0 {
            for e in 0..pcx.defs.len() as i64 {
                if pcx.defs[e as usize].name_pos == at {
                    d = e;
                    break;
                }
            }
        }
        if d >= 0 && !user_pos(pcx.defs[d as usize].start, pcx) {
            let e = diag(c"error", c"edit.not-source", tcx);
            buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
            buf_str(e, c" is not in a file of the program\n");
            return -2;
        }
        d
    }
}

// Whether definition d is a function with a body.
fn is_function(d: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    (k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN)
        && user_pos(pcx.defs[d as usize].start, pcx)
}

// `FN::local`: the declarations of the locals named by NAME's last segment
// in the functions its other segments name, into out (their positions);
// false when NAME is not of that form or names no function.
pub fn locals_named(name: &[u8], out: &mut IntVec, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut i = name.len() as i64;
        while i >= 2 && !(name[(i - 1) as usize] == b':' && name[(i - 2) as usize] == b':') {
            i -= 1;
        }
        if i < 3 || i >= name.len() as i64 {
            return false;
        }
        let mut whole = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_defs(name, false, &mut whole, tcx, pcx);
        if whole.count > 0 {
            return false;
        }
        let mut fns = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_defs(&name[0..(i - 2) as usize], false, &mut fns, tcx, pcx);
        let sym = intern(&name[i as usize..], pcx);
        let mut any = false;
        let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for k in 0..fns.count {
            let d = (*fns.data.add(k as usize));
            if !is_function(d, pcx) {
                continue;
            }
            any = true;
            for n in 1..pcx.nodes.len() as i64 {
                if pcx.nodes[n as usize].a != sym || pcx.nodes[n as usize].start < pcx.defs[d as usize].start
                    || pcx.nodes[n as usize].start >= pcx.defs[d as usize].end {
                    continue;
                }
                let p = decl_name_pos(n, pcx);
                if p >= 0 && seen.get(p + 1) == 0 {
                    seen.put(p + 1, 1);
                    out.push(p);
                }
            }
        }
        any
    }
}

// `refactor rename` of a local, when NAME names one: the command's status;
// -1 when NAME is not a local (a definition, or nothing: rename goes on).
pub fn local_rename(name: &[u8], new: &[u8], root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        load_decls(pcx);
        let at = ident_at_column(name, pcx);
        let mut decl: i64 = -1;
        if at >= 0 {
            decl = local_at(at, pcx);
        } else {
            let mut found = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            if !locals_named(name, &mut found, tcx, pcx) {
                return -1;
            }
            if found.count == 0 {
                let e = diag(c"error", c"query.no-match", tcx);
                buf_str(e, c"no definition or local '");
                buf_bytes(e, name);
                buf_str(e, c"'\n");
                let mut i = name.len() as i64;
                while i >= 2 && !(name[(i - 1) as usize] == b':' && name[(i - 2) as usize] == b':') {
                    i -= 1;
                }
                try_end(try_begin(c"show", &name[0..(i - 2) as usize], true, tcx, pcx));
                return 1;
            }
            if found.count > 1 {
                let e = diag(c"error", c"refactor.ambiguous-local", tcx);
                buf_bytes(e, name);
                buf_str(e, c" is several locals (shadowing); name one by its position\n");
                for k in 0..found.count {
                    if k == 3 {
                        break;
                    }
                    let loc = buf_new();
                    put_loc(loc, (*found.data.add(k as usize)), pcx);
                    let out = try_begin(c"rename", buf_slice(loc), true, tcx, pcx);
                    put_word(out, new);
                    try_end(out);
                }
                return 1;
            }
            decl = (*found.data.add(0));
        }
        if decl < 0 {
            return -1;
        }
        rename_local_at(decl, new, root, tcx, pcx)
    }
}

// The scope of the local declared at decl, in function f, from *from to
// the position returned: for a parameter, the function; for a `let`, from
// the end of the statement (its value is not in it) to the end of the
// block holding it; for another pattern, from the declaration to the end
// of its match arm or loop.
fn scope_of(f: i64, decl: i64, is_param: bool, from: &mut i64, tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) -> i64 {
    *from = if is_param { pcx.defs[f as usize].start } else { decl };
    if is_param {
        return pcx.defs[f as usize].end;
    }
    load_body(pcx.defs[f as usize].node, tcx, pcx);
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::PatBind || decl_name_pos(n, pcx) != decl {
            continue;
        }
        let mut p = parent(n, tcx);
        if p > 0 && pcx.nodes[p as usize].kind == NodeKind::Let {
            *from = pcx.nodes[p as usize].end;
        }
        while p > 0 {
            let k = pcx.nodes[p as usize].kind;
            if k == NodeKind::Block || k == NodeKind::Arm || k == NodeKind::For
                || k == NodeKind::While || k == NodeKind::Loop {
                return pcx.nodes[p as usize].end;
            }
            p = parent(p, tcx);
        }
    }
    pcx.defs[f as usize].end
}

// Renames the local declared at decl to new.
fn rename_local_at(decl: i64, new: &[u8], root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let t = token_at(decl, pcx);
    let old = pcx.toks[t as usize].value as i64;
    let o = sym_text(old, pcx);
    let newsym = intern(new, pcx);
    let f = enclosing(decl, tcx, pcx);
    if f < 0 || !is_function(f, pcx) {
        return -1;
    }
    let loc = buf_new();
    put_loc(loc, decl, pcx);
    if bytes_eq(o, new) {
        let e = diag(c"note", c"edit.unchanged", tcx);
        buf_str(e, c"nothing to change\n");
        return 0;
    }
    if bytes_eq(o, c_slice(c"self")) || bytes_eq(new, c_slice(c"self")) {
        let e = diag(c"error", c"refactor.usage", tcx);
        buf_str(e, c"self keeps its name (a method's first parameter is self)\n");
        return 2;
    }
    // The scope: a parameter's is its function, comment included.
    let mut is_param = false;
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Param && decl_name_pos(n, pcx) == decl {
            is_param = true;
            break;
        }
    }
    let mut from: i64 = 0;
    let to = scope_of(f, decl, is_param, &mut from, tcx, pcx);
    // The new name must not be one in the scope already.
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].a != newsym || pcx.nodes[n as usize].start < from || pcx.nodes[n as usize].start >= to {
            continue;
        }
        let other_decl = decl_name_pos(n, pcx) >= 0;
        let other_use = pcx.nodes[n as usize].kind == NodeKind::Ident && use_decl(n, pcx) != decl;
        if other_decl || other_use {
            let e = diag(c"error", c"refactor.collision", tcx);
            buf_byte(e, b'\'');
            buf_bytes(e, new);
            buf_str(e, c"' is already a name in the scope of local ");
            buf_bytes(e, o);
            buf_str(e, c" (at ");
            put_loc(e, pcx.nodes[n as usize].start, pcx);
            buf_str(e, c"); nothing written\n");
            let out = try_begin(c"show", buf_slice(loc), true, tcx, pcx);
            try_end(out);
            return 1;
        }
    }
    // The declaration and the uses.
    let mut done = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    done.put(decl + 1, 1);
    put_edit(decl, decl + o.len() as i64, text_of(new), tcx, pcx);
    let mut uses: i64 = 0;
    for n in 1..pcx.nodes.len() as i64 {
        let p = pcx.nodes[n as usize].start;
        if use_decl(n, pcx) != decl || done.get(p + 1) != 0
            || !bytes_eq(&get_src()[p as usize..(p + o.len() as i64) as usize], o) {
            continue;
        }
        done.put(p + 1, 1);
        // (0.15: `S { x }` becomes `S { x: y }`)
        put_edit(p, p + o.len() as i64,
            if shorthand_at(p, tcx, pcx) { shorthand_text(o, new) } else { text_of(new) }, tcx,
            pcx);
        uses += 1;
    }
    scan_mentions(if is_param { text_start(f, pcx) } else { decl }, to, o, new, MENTION_LOCAL,
        &o[0..0], tcx, pcx);
    let what = buf_new();
    buf_str(what, if is_param { c"renamed parameter " } else { c"renamed local " });
    buf_bytes(what, o);
    buf_str(what, c" to ");
    buf_bytes(what, new);
    buf_str(what, c" in ");
    buf_bytes(what, sym_text(pcx.defs[f as usize].fqn, pcx));
    buf_str(what, c", ");
    buf_int(what, uses);
    buf_str(what, if uses == 1 { c" use" } else { c" uses" });
    finish(what, root, tcx, pcx)
}
