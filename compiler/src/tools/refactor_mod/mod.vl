// The module-structure refactorings (0.11, phase 2a; docs/refactor.md):
//
//   volec refactor rename PATH NEW            an item, method, field, variant or
//                                                module, and every reference to it
//   volec refactor move PATH... --to MODULE   items into another module
//   volec refactor new-module crate::a::b [--file|--dir]
//   volec refactor move-module crate::a crate::x::a
//   volec refactor split MODULE --into NEWMOD --items a,b,c
//   volec refactor split MODULE --plan|--auto [--max-lines N]
//
// Each is one edit of the edit engine (edit.vl): checked before it is
// written (nothing is written when it adds an error), journaled for
// `undo`, printed as a diff with --dry-run, one summary line. The moves
// and splits are in refactor_move.vl; this file has the command line,
// what they share (every reference of the program, the modules an edit
// makes, module files), rename, new-module and move-module.

pub mod cli;

pub mod local;
pub mod mentions;

use crate::base::{
    SOURCE_VOLE, buf_append, buf_byte, buf_bytes, buf_copy, buf_new, buf_str, get_src, intern,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::child;
use crate::front::cpp::directives::{file_exists, path_dir};
use crate::front::lexer::Tok;
use crate::front::modules::{file_made, file_of_pos, module_at, module_count, module_of};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::{edit_move_file, edit_new_file, edit_replace};
use crate::tools::edit::cli::delete_lines;
use crate::tools::proc::{buf_cstr, same_bytes};
use crate::tools::query::{QF_DEF, QF_USE, c_slice};
use crate::tools::query::defs::{
    K_FIELD, K_IMPL_METHOD, K_METHOD, K_MOD, K_TRAIT_FN, K_VARIANT, bytes_eq, kind_name,
    mod_fqn_text,
};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::positions::{line_end, line_start, shorthand_at, shorthand_text, token_at};
use crate::tools::query::refs::{collect_refs, set_targets, sorted_refs};
use crate::tools::query::show::text_start;
use crate::tools::refactor_mod::cli::{inline_module, is_name_use, user_pos};

// ---- The program's references ----

fn bind_key(m: i64, name: i64) -> i64 {
    (m + 1) * 4294967296 + name + 1
}

// Collects the references of the whole program, and the names of its
// modules.
pub fn load_refs(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    for d in 0..pcx.defs.len() as i64 {
        all.push(d);
        let k = pcx.defs[d as usize].kind;
        if pcx.defs[d as usize].parent < 0 && k != K_METHOD && k != K_IMPL_METHOD {
            tcx.item_bind.put(bind_key(pcx.defs[d as usize].module, pcx.defs[d as usize].name),
                d + 1);
        }
    }
    set_targets(all.as_slice(), tcx, pcx);
    collect_refs(tcx, pcx);
    let mut refs: Vec<i64, Comp> = Vec::new_in(Comp {});
    std::mem::swap(&mut refs, &mut tcx.refs);
    sorted_refs(&mut refs, tcx, pcx);
    tcx.refs = refs;
    for k in 0..tcx.refs.len() as i64 {
        let r = (tcx.refs[k as usize]);
        if ((tcx.r_flags[r as usize]) & QF_USE) != 0 {
            pcx.use_at.put((tcx.r_pos[r as usize]) + 1,
                (tcx.r_def[r as usize]) + 1);
        }
    }
    for u in 1..pcx.nodes.len() as i64 {
        if !is_name_use(u, pcx) {
            continue;
        }
        let m = module_of(u, pcx);
        for k in 0..pcx.nodes[u as usize].count {
            let id = child(u, k, pcx);
            tcx.use_id.put(pcx.nodes[id as usize].start + 1, id);
            tcx.use_of.put(id, u);
            if pcx.use_at.get(pcx.nodes[id as usize].start + 1) > 0 {
                pcx.use_bind.put(bind_key(m, use_local(id, pcx)), id);
            }
        }
    }
}

// The name a `use` gives (its alias, or the name), of its Ident node id.
pub fn use_local(id: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[id as usize].b != 0 { pcx.nodes[id as usize].b } else { pcx.nodes[id as usize].a }
}

// The Ident node of the `use` name at pos (0: none), and its Use node.
pub fn use_id_at(pos: i64, tcx: &Tcx<Comp>) -> i64 {
    tcx.use_id.get(pos + 1)
}

pub fn use_node_of(id: i64, tcx: &Tcx<Comp>) -> i64 {
    tcx.use_of.get(id)
}

// What the `use` name of Ident node id imports (its definition; -1:
// nothing the checker resolved).
pub fn use_def(id: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.use_at.get(pcx.nodes[id as usize].start + 1) - 1
}

// What name `name` is in module m: an item (or a module declared there),
// an import; -1 for none.
pub fn item_binding(m: i64, name: i64, tcx: &Tcx<Comp>) -> i64 {
    tcx.item_bind.get(bind_key(m, name)) - 1
}

pub fn use_binding(m: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let id = pcx.use_bind.get(bind_key(m, name));
    if id == 0 { -1 } else { pcx.use_at.get(pcx.nodes[id as usize].start + 1) - 1 }
}

// The Ident node of the import of `name` in module m (0: none).
pub fn use_binding_id(m: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.use_bind.get(bind_key(m, name))
}

pub fn binding_of(m: i64, name: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = item_binding(m, name, tcx);
    if d >= 0 { d } else { use_binding(m, name, pcx) }
}

// Whether the token at pos is identifier `name`.
pub fn ref_named(pos: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    let i = token_at(pos, pcx);
    i < pcx.toks.len() as i64 && pcx.toks[i as usize].start == pos
        && pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == name
}

// (0.26.2) Whether pos is identifier `name` written in a format literal's
// hole, `"{LIMIT}"`: inside a string literal's token, the name and no
// identifier byte after it (the reference is the checker's, so the
// literal is a format one).
pub fn hole_named(pos: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    let i = token_at(pos, pcx);
    if i <= 0 {
        return false;
    }
    let t = pcx.toks[(i - 1) as usize];
    let text = sym_text(name, pcx);
    if t.kind != Tok::Str || pos <= t.start || pos + text.len() as i64 >= t.end
        || &get_src()[pos as usize..(pos + text.len() as i64) as usize] != text {
        return false;
    }
    let c = get_src()[(pos + text.len() as i64) as usize];
    !(c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_')
}

// Whether the name at pos follows a `::` (a path's later segment).
pub fn qualified(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let i = token_at(pos, pcx);
    i > 0 && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon
}

// The start of the path whose segment is at pos: back over `NAME::`.
pub fn path_start(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = token_at(pos, pcx);
    while i >= 2 && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon
        && pcx.toks[(i - 2) as usize].kind == Tok::Ident {
        i -= 2;
    }
    pcx.toks[i as usize].start
}

// ---- Regions: the modules, and the ones the edit makes ----
//
// A region is a module of the program (0 .. module_count()) or a module the
// edit makes (module_count() + k): its name, parent region, file, whether
// it is a dir module (`name/mod.vl`), whether it is declared `pub`, and
// its text: the `mod` lines of the modules made in it, its imports, the
// items moved into it.

pub fn new_region(parent: i64, name: i64, path: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    tcx.nm_name.push(name);
    tcx.nm_parent.push(parent);
    tcx.nm_path.push(path as i64);
    tcx.nm_pub.push(0);
    tcx.nm_mods.push(buf_new());
    tcx.nm_uses.push(buf_new());
    tcx.nm_body.push(buf_new());
    tcx.nm_head.push(buf_new());
    module_count(pcx) + tcx.nm_name.len() as i64 - 1
}

pub fn is_new(r: i64, pcx: &Ctx<Comp>) -> bool {
    r >= module_count(pcx)
}

pub fn region_parent(r: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if r < 0 {
        return -1;
    }
    if r < module_count(pcx) { pcx.modules[r as usize].parent }
    else { (tcx.nm_parent[(r - module_count(pcx)) as usize]) }
}

pub fn region_name(r: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if r < module_count(pcx) { pcx.modules[r as usize].name }
    else { (tcx.nm_name[(r - module_count(pcx)) as usize]) }
}

// Whether region `inner` is `outer` or inside it.
pub fn within(inner: i64, outer: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut m = inner;
    while m >= 0 {
        if m == outer {
            return true;
        }
        m = region_parent(m, tcx, pcx);
    }
    false
}

pub fn region_public(r: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if r == 0 {
        return true;
    }
    if r < module_count(pcx) { pcx.modules[r as usize].public }
    else { (tcx.nm_pub[(r - module_count(pcx)) as usize]) != 0 }
}

// The path of region r: `crate`, `crate::a::b`.
pub fn put_region_path(out: i64, r: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if r < module_count(pcx) {
        buf_bytes(out, mod_fqn_text(r, tcx, pcx));
        return;
    }
    put_region_path(out, region_parent(r, tcx, pcx), tcx, pcx);
    buf_str(out, c"::");
    buf_bytes(out, sym_text((tcx.nm_name[(r - module_count(pcx)) as usize]), pcx));
}

// ---- Module files ----

// The file of module m (not an inline module's), or -1.
pub fn own_file(m: i64, pcx: &Ctx<Comp>) -> i64 {
    for f in 0..pcx.files.len() as i64 {
        if pcx.files[f as usize].module == m && !file_made(f, pcx)
            && pcx.files[f as usize].kind == SOURCE_VOLE {
            return f;
        }
    }
    -1
}

// The last component of a path.
pub fn base_name(path: *const u8) -> &'static [u8] {
    let p = crate::base::c_kept(path);
    let mut i = p.len() as i64;
    while i > 0 && p[(i - 1) as usize] != b'/' {
        i -= 1;
    }
    &p[i as usize..]
}

pub fn is_mod_file(path: *const u8) -> bool {
    bytes_eq(base_name(path), b"mod.vl")
        || bytes_eq(base_name(path), b"mod.vl")
}

// (0.20) Whether module m finds its children's files next to its own, as
// the program's root does: the root, and std's root (std is a crate of
// its own: compiler/std/NAME.vl is std::NAME).
pub fn root_like(m: i64, pcx: &Ctx<Comp>) -> bool {
    m == 0 || (m == pcx.std_module)
}

// The file of module `name`, a child of the module whose file is `path`
// (`root`: the root module's), as the module loader finds it: next to the
// file for the root or a `mod.vl`, else in the directory named after it;
// `name.vl`, or `name/mod.vl` for a dir module (0.21: ext, `.vl` too).
pub fn child_path(path: *const u8, root: bool, name: &[u8], dir: bool, ext: *const u8) -> *mut u8 {
    let out = buf_new();
    buf_str(out, path_dir(path));
    buf_byte(out, b'/');
    let mod_file = is_mod_file(path);
    let base = base_name(path);
    if !root && !mod_file {
        buf_bytes(out, &base[0..(base.len() as i64 - crate::base::source_ext_len(base)) as usize]);
        buf_byte(out, b'/');
    }
    buf_bytes(out, name);
    buf_str(out, if dir { c"/mod" } else { c"" });
    buf_str(out, ext);
    buf_cstr(out)
}

// `x/a.vl` as a dir module's file: `x/a/mod.vl`.
pub fn dir_form(path: *const u8) -> *mut u8 {
    let p = c_slice(path);
    let b = buf_new();
    // (the file's extension, either)
    let e = crate::base::source_ext_len(&p);
    buf_bytes(b, &p[0..(p.len() as i64 - e) as usize]);
    buf_str(b, c"/mod");
    buf_bytes(b, &p[(p.len() as i64 - e) as usize..]);
    buf_cstr(b)
}

// The file module m's text will be in after the edit, and moves it to its
// dir form (`a.vl` -> `a/mod.vl`) when it gains a child: the path its
// children are found from. 0 for an inline module.
pub fn parent_file_path(m: i64, converts: &mut HMap, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> *const u8 {
    let f = own_file(m, pcx);
    if f < 0 {
        return 0 as *mut u8;
    }
    if root_like(m, pcx) || is_mod_file(pcx.files[f as usize].path) {
        return pcx.files[f as usize].path;
    }
    let p = dir_form(pcx.files[f as usize].path);
    if converts.get(f + 1) == 0 {
        converts.put(f + 1, p as i64);
        edit_move_file(f, p, tcx);
    }
    converts.get(f + 1) as *mut u8
}

// Moves the files of module m (its file, and its children's) so that its
// file is `path`.
pub fn move_tree(m: i64, path: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let f = own_file(m, pcx);
    let p = c_slice(pcx.files[f as usize].path);
    let np = c_slice(path);
    let old = buf_new();
    let new = buf_new();
    // (either extension, by its length)
    let e = crate::base::source_ext_len(&p);
    let ne = crate::base::source_ext_len(&np);
    if is_mod_file(pcx.files[f as usize].path) {
        buf_bytes(old, &p[0..(p.len() as i64 - 3 - e) as usize]);
        buf_bytes(new, &np[0..(np.len() as i64 - 3 - ne) as usize]);
    } else {
        buf_bytes(old, &p[0..(p.len() as i64 - e) as usize]);
        buf_byte(old, b'/');
        buf_bytes(new, &np[0..(np.len() as i64 - ne) as usize]);
        buf_byte(new, b'/');
        edit_move_file(f, path, tcx);
    }
    let o = buf_copy(old);
    for g in 0..pcx.files.len() as i64 {
        let q = c_slice(pcx.files[g as usize].path);
        if q.len() > o.len() && same_bytes(&q[0..o.len()], &o) {
            let b = buf_new();
            buf_append(b, new);
            buf_bytes(b, &q[o.len()..q.len()]);
            edit_move_file(g, buf_cstr(b), tcx);
        }
    }
}

// Adds line `text` (`mod NAME;`) to file f: after its last `mod NAME;`
// line, else before its first item (after the comment at its top).
pub fn add_mod_line(f: i64, text: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut last: i64 = -1;
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d as usize].kind == K_MOD && file_of_pos(pcx.defs[d as usize].start, pcx) == f
            && get_src()[(pcx.defs[d as usize].end - 1) as usize] == b';'
            && (last < 0 || pcx.defs[d as usize].start > pcx.defs[last as usize].start) {
            last = d;
        }
    }
    let b = buf_new();
    if last >= 0 {
        buf_byte(b, b'\n');
        buf_bytes(b, text);
        let at = line_end(pcx.defs[last as usize].end - 1, pcx);
        put_edit(at, at, b, tcx, pcx);
        return;
    }
    let at = first_item_line(f, pcx);
    buf_bytes(b, text);
    buf_byte(b, b'\n');
    if at < pcx.files[f as usize].end {
        buf_byte(b, b'\n');
    }
    put_edit(at, at, b, tcx, pcx);
}

// The start of the line where file f's first item (or `use`) starts, with
// the comment lines directly above it; the file's end when it has none.
pub fn first_item_line(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let i = token_at(pcx.files[f as usize].start, pcx);
    if i >= pcx.toks.len() as i64 || pcx.toks[i as usize].start >= pcx.files[f as usize].end {
        return pcx.files[f as usize].end;
    }
    let mut at = line_start(pcx.toks[i as usize].start, pcx);
    while at > pcx.files[f as usize].start {
        let prev = line_start(at - 1, pcx);
        if !comment_line(prev) {
            break;
        }
        at = prev;
    }
    // (a comment from the top of the file is the file's)
    if at == pcx.files[f as usize].start { line_start(pcx.toks[i as usize].start, pcx) } else { at }
}

// Whether the line at pos (a line's start) is a `//` comment.
pub fn comment_line(pos: i64) -> bool {
    let mut p = pos;
    while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
        p += 1;
    }
    get_src()[p as usize] == b'/' && get_src()[(p + 1) as usize] == b'/'
}

// ---- Edits ----

pub fn put_edit(a: i64, b: i64, text: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if !edit_replace(a, b, text, pcx) {
        tcx.cli_edit_failed = true;
    }
}

pub fn text_of(s: &[u8]) -> i64 {
    let b = buf_new();
    buf_bytes(b, s);
    b
}

// ---- Diagnostics ----

// `name` would be two things in region r: d is the other (a definition,
// or what an import of that name brings).
pub fn collision(name: &[u8], r: i64, d: i64, imported: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    let e = diag(c"error", c"refactor.collision", tcx);
    buf_byte(e, b'\'');
    buf_bytes(e, name);
    buf_str(e, c"' is already a name in ");
    put_region_path(e, r, tcx, pcx);
    if d >= 0 {
        buf_str(e, if imported { c" (an import of " } else { c" (" });
        buf_str(e, kind_name(pcx.defs[d as usize].kind));
        buf_byte(e, b' ');
        buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_byte(e, b')');
    }
    buf_str(e, c"; nothing written\n");
    if d >= 0 {
        let out = try_begin(if imported { c"refs" } else { c"def" },
            sym_text(pcx.defs[d as usize].fqn, pcx), true, tcx, pcx);
        if imported && r < module_count(pcx) {
            buf_str(out, c" --in ");
            buf_bytes(out, mod_fqn_text(r, tcx, pcx));
        }
        try_end(out);
    }
    1
}

// ---- rename ----

// Every reference to the definitions of group, written `old`, becomes new.
fn rename_refs(group: &[i64], old: i64, new: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut in_group = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for i in 0..group.len() as i64 {
        in_group.put((group[i as usize]) + 1, 1);
    }
    let mut done = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let n = sym_text(old, pcx).len() as i64;
    for k in 0..tcx.refs.len() as i64 {
        let r = (tcx.refs[k as usize]);
        let p = (tcx.r_pos[r as usize]);
        if in_group.get((tcx.r_def[r as usize]) + 1) == 0 || !user_pos(p, pcx)
            || done.get(p + 1) != 0
            || !ref_named(p, old, pcx) && !hole_named(p, old, pcx) {
            continue;
        }
        done.put(p + 1, 1);
        if shorthand_at(p, tcx, pcx) {
            // (0.15: `S { x }`: the field renamed, `y: x`; the value, `x: y`)
            let o = sym_text(old, pcx);
            let field = pcx.defs[(tcx.r_def[r as usize]) as usize].kind == K_FIELD;
            put_edit(p, p + n,
                if field { shorthand_text(new, o) } else { shorthand_text(o, new) }, tcx,
                pcx);
            continue;
        }
        put_edit(p, p + n, text_of(new), tcx, pcx);
    }
}

// Whether the new name is taken where the definitions of group are named
// (diagnosed).
fn rename_collides(d: i64, group: &[i64], new: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    let text = sym_text(new, pcx);
    let m = pcx.defs[d as usize].module;
    if k == K_FIELD || k == K_VARIANT || k == K_TRAIT_FN {
        for e in 0..pcx.defs.len() as i64 {
            if pcx.defs[e as usize].parent == pcx.defs[d as usize].parent
                && pcx.defs[e as usize].name == new {
                collision(text, m, e, false, tcx, pcx);
                return true;
            }
        }
    }
    if k == K_METHOD || k == K_TRAIT_FN {
        for i in 0..group.len() as i64 {
            let g = (group[i as usize]);
            for e in 0..pcx.defs.len() as i64 {
                if (pcx.defs[e as usize].kind == K_METHOD
                    || pcx.defs[e as usize].kind == K_IMPL_METHOD)
                    && pcx.defs[e as usize].owner == pcx.defs[g as usize].owner
                    && pcx.defs[e as usize].name == new
                    && (k == K_METHOD || pcx.defs[g as usize].kind == K_IMPL_METHOD) {
                    collision(text, m, e, false, tcx, pcx);
                    return true;
                }
            }
        }
    }
    if pcx.defs[d as usize].parent >= 0 || k == K_METHOD || k == K_IMPL_METHOD {
        return false;
    }
    // An item: its module's names, and those of the modules importing it.
    let b = binding_of(m, new, tcx, pcx);
    if b >= 0 {
        collision(text, m, b, item_binding(m, new, tcx) < 0, tcx, pcx);
        return true;
    }
    for x in 0..tcx.refs.len() as i64 {
        let r = (tcx.refs[x as usize]);
        if (tcx.r_def[r as usize]) != d
            || ((tcx.r_flags[r as usize]) & QF_USE) == 0 {
            continue;
        }
        let id = use_id_at((tcx.r_pos[r as usize]), tcx);
        if id == 0 || pcx.nodes[id as usize].b != 0 {
            continue;
        }
        let u = module_at((tcx.r_pos[r as usize]), pcx);
        let c = binding_of(u, new, tcx, pcx);
        if c >= 0 {
            collision(text, u, c, item_binding(u, new, tcx) < 0, tcx, pcx);
            return true;
        }
    }
    false
}

// ---- new-module ----

// Makes module `name` in region parent (its `mod` line goes there when the
// edit is emitted): its region, or -1 after a diagnostic.
pub fn make_module(parent: i64, name: i64, dir: bool, converts: &mut HMap, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    let mut ppath = 0 as *const u8;
    let mut proot = false;
    if is_new(parent, pcx) {
        ppath = (tcx.nm_path[(parent - module_count(pcx)) as usize]) as *mut u8;
    } else {
        let b = binding_of(parent, name, tcx, pcx);
        if b >= 0 {
            collision(sym_text(name, pcx), parent, b, item_binding(parent, name, tcx) < 0, tcx,
                pcx);
            return -1;
        }
        ppath = parent_file_path(parent, converts, tcx, pcx);
        proot = root_like(parent, pcx);
        if ppath == 0 as *mut u8 {
            return inline_module(parent, tcx, pcx);
        }
    }
    let path = child_path(ppath, proot, sym_text(name, pcx), dir, c".vl");
    let other = child_path(ppath, proot, sym_text(name, pcx), !dir, c".vl");
    if file_exists(path, pcx) || file_exists(other, pcx) {
        let d = diag(c"error", c"refactor.exists", tcx);
        buf_str(d, c"'");
        buf_str(d, if file_exists(path, pcx) { path } else { other });
        buf_str(d, c"' exists already; nothing written\n");
        return -1;
    }
    let r = new_region(parent, name, path, tcx, pcx);
    // (0.20) std's modules are its interface: `pub mod`
    if pcx.std_module >= 0 && within(parent, pcx.std_module, tcx, pcx) {
        (tcx.nm_pub[(r - module_count(pcx)) as usize]) = 1;
    }
    r
}

// The texts of the modules the edit makes: their files, and their `mod`
// lines in the modules of the program.
pub fn emit_regions(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mc = module_count(pcx);
    // (the lines for one module of the program together)
    let mut lines = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut parents: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..tcx.nm_name.len() as i64 {
        let line = buf_new();
        if (tcx.nm_pub[k as usize]) != 0 {
            buf_str(line, c"pub ");
        }
        buf_str(line, c"mod ");
        buf_bytes(line, sym_text((tcx.nm_name[k as usize]), pcx));
        buf_byte(line, b';');
        let parent = (tcx.nm_parent[k as usize]);
        if parent < mc {
            let mut b = lines.get(parent + 1);
            if b == 0 {
                b = buf_new();
                lines.put(parent + 1, b);
                parents.push(parent);
            } else {
                buf_byte(b, b'\n');
            }
            buf_append(b, line);
        } else {
            buf_append((tcx.nm_mods[(parent - mc) as usize]), line);
            buf_byte((tcx.nm_mods[(parent - mc) as usize]), b'\n');
        }
    }
    for i in 0..parents.len() as i64 {
        add_mod_line(own_file((parents[i as usize]), pcx),
            &buf_copy(lines.get((parents[i as usize]) + 1)), tcx, pcx);
    }
    for k in 0..tcx.nm_name.len() as i64 {
        let text = buf_new();
        let parts = [(tcx.nm_head[k as usize]), (tcx.nm_mods[k as usize]),
            (tcx.nm_uses[k as usize]), (tcx.nm_body[k as usize])];
        for j in 0..4 {
            if crate::base::buf_len(parts[j as usize]) == 0 {
                continue;
            }
            if crate::base::buf_len(text) > 0 {
                buf_byte(text, b'\n');
            }
            buf_append(text, parts[j as usize]);
        }
        edit_new_file((tcx.nm_path[k as usize]) as *mut u8, text, tcx, pcx);
    }
}

// ---- move-module ----

// The edits making module m (of its own file) module `name` of region
// parent: its files, its `mod` line, the references to it. -1 when they
// are made, else the exit status (after a diagnostic).
fn relocate_module(m: i64, parent: i64, name: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let dm = (pcx.mod_def[m as usize]);
    let same = parent == pcx.modules[m as usize].parent;
    let mut converts = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    // Its new file.
    let mut ppath = 0 as *const u8;
    if is_new(parent, pcx) {
        ppath = (tcx.nm_path[(parent - module_count(pcx)) as usize]) as *mut u8;
    } else {
        let b = binding_of(parent, name, tcx, pcx);
        if b >= 0 {
            return collision(sym_text(name, pcx), parent, b,
                item_binding(parent, name, tcx) < 0, tcx, pcx);
        }
        ppath = if same { pcx.files[own_file(parent, pcx) as usize].path }
            else { parent_file_path(parent, &mut converts, tcx, pcx) };
        if ppath == 0 as *mut u8 {
            return inline_module(parent, tcx, pcx);
        }
    }
    let dir = is_mod_file(pcx.files[own_file(m, pcx) as usize].path);
    let path = child_path(ppath, root_like(parent, pcx), sym_text(name, pcx), dir, c".vl");
    let other = child_path(ppath, root_like(parent, pcx), sym_text(name, pcx), !dir, c".vl");
    if file_exists(path, pcx) || file_exists(other, pcx) {
        let d = diag(c"error", c"refactor.collision", tcx);
        buf_str(d, c"'");
        buf_str(d, if file_exists(path, pcx) { path } else { other });
        buf_str(d, c"' exists already; nothing written\n");
        return 1;
    }
    move_tree(m, path, tcx, pcx);
    // The references.
    let newpath = buf_new();
    put_region_path(newpath, parent, tcx, pcx);
    buf_str(newpath, c"::");
    buf_bytes(newpath, sym_text(name, pcx));
    let old = pcx.modules[m as usize].name;
    let mut at = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut public = pcx.modules[m as usize].public;
    for k in 0..tcx.refs.len() as i64 {
        let r = (tcx.refs[k as usize]);
        if (tcx.r_def[r as usize]) == dm
            && user_pos((tcx.r_pos[r as usize]), pcx) {
            at.put((tcx.r_pos[r as usize]) + 1, 1);
        }
    }
    for k in 0..tcx.refs.len() as i64 {
        let r = (tcx.refs[k as usize]);
        let p = (tcx.r_pos[r as usize]);
        if (tcx.r_def[r as usize]) != dm || !user_pos(p, pcx)
            || !ref_named(p, old, pcx) {
            continue;
        }
        let flags = (tcx.r_flags[r as usize]);
        if same {
            // (a rename: the name, where it is written)
            put_edit(p, p + sym_text(old, pcx).len() as i64, text_of(sym_text(name, pcx)), tcx,
                pcx);
            continue;
        }
        if (flags & QF_DEF) != 0 {
            continue;
        }
        let from = module_at(p, pcx);
        if !within(from, parent, tcx, pcx) {
            public = true;
        }
        chain_public(from, parent, tcx, pcx);
        if (flags & QF_USE) != 0 {
            use_of_module(p, &buf_copy(newpath), old, name, tcx, pcx);
        } else if qualified(p, pcx) {
            put_edit(path_start(p, pcx), p + sym_text(old, pcx).len() as i64,
                text_of(&buf_copy(newpath)), tcx, pcx);
        } else if use_binding(from, old, pcx) != dm {
            // (a path from its old parent: `a::f`)
            put_edit(p, p + sym_text(old, pcx).len() as i64, text_of(&buf_copy(newpath)), tcx,
                pcx);
        }
    }
    if same {
        if public && !pcx.modules[m as usize].public {
            put_edit(pcx.defs[dm as usize].start, pcx.defs[dm as usize].start,
                text_of(b"pub "), tcx, pcx);
        }
        return -1;
    }
    // The `super::` paths of its files that lead out of it.
    for f in 0..pcx.files.len() as i64 {
        if !file_made(f, pcx)
            && pcx.files[f as usize].kind == SOURCE_VOLE
            && within(pcx.files[f as usize].module, m, tcx, pcx) {
            escaping_supers(f, m, at, tcx, pcx);
        }
    }
    // Its `mod` line, from its old parent to its new one.
    let line = buf_new();
    let ts = line_start(text_start(dm, pcx), pcx);
    let kw = pcx.defs[dm as usize].start;
    buf_bytes(line, &get_src()[ts as usize..line_start(kw, pcx) as usize]);
    if public {
        buf_str(line, c"pub ");
    }
    buf_str(line, c"mod ");
    buf_bytes(line, sym_text(name, pcx));
    buf_byte(line, b';');
    delete_lines(ts, pcx.defs[dm as usize].end, pcx);
    if is_new(parent, pcx) {
        buf_append((tcx.nm_mods[(parent - module_count(pcx)) as usize]), line);
        buf_byte((tcx.nm_mods[(parent - module_count(pcx)) as usize]), b'\n');
    } else {
        add_mod_line(own_file(parent, pcx), &buf_copy(line), tcx, pcx);
    }
    -1
}

// The modules of the path of region r that the code of region from cannot
// see while they are private: made `pub`.
pub fn chain_public(from: i64, r: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut x = r;
    while x > 0 {
        let p = region_parent(x, tcx, pcx);
        if !region_public(x, tcx, pcx) && !within(from, p, tcx, pcx) {
            if is_new(x, pcx) {
                (tcx.nm_pub[(x - module_count(pcx)) as usize]) = 1;
            }
            else if (pcx.mod_def[x as usize]) >= 0
                && !pcx.modules[x as usize].public {
                let dx = (pcx.mod_def[x as usize]);
                pcx.modules[x as usize].public = true;
                put_edit(pcx.defs[dx as usize].start, pcx.defs[dx as usize].start,
                    text_of(b"pub "), tcx, pcx);
            }
        }
        x = p;
    }
}

// The import of the module (`use a::m;`) at pos: its path becomes newpath
// (`as old` when its name changes); in a list, the name leaves it for a
// `use` line of its own.
fn use_of_module(pos: i64, newpath: &[u8], old: i64, name: i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let id = use_id_at(pos, tcx);
    let u = use_node_of(id, tcx);
    if id == 0 || u == 0 {
        return;
    }
    let text = buf_new();
    buf_bytes(text, newpath);
    if pcx.nodes[id as usize].b == 0 && old != name {
        buf_str(text, c" as ");
        buf_bytes(text, sym_text(old, pcx));
    }
    if pcx.nodes[u as usize].count == 1 && !braced(u, pcx) {
        put_edit(pcx.nodes[pcx.nodes[u as usize].c as usize].start,
            pcx.nodes[id as usize].start + sym_text(old, pcx).len() as i64, text, tcx, pcx);
        return;
    }
    crate::tools::refactor_move::imports::remove_use_names(u, id, tcx);
    let line = buf_new();
    buf_str(line, c"\nuse ");
    buf_append(line, text);
    if pcx.nodes[id as usize].b != 0 {
        buf_str(line, c" as ");
        buf_bytes(line, sym_text(pcx.nodes[id as usize].b, pcx));
    }
    buf_byte(line, b';');
    let at = line_end(pcx.nodes[u as usize].end - 1, pcx);
    put_edit(at, at, line, tcx, pcx);
}

// Whether Use node u lists its names between braces.
pub fn braced(u: i64, pcx: &Ctx<Comp>) -> bool {
    for p in pcx.nodes[pcx.nodes[u as usize].c as usize].end..pcx.nodes[u as usize].end {
        if get_src()[p as usize] == b'{' {
            return true;
        }
    }
    false
}

// The paths of file f (of module m or one of its children) that start
// with `super::` and lead out of m: written from `crate`. A path that
// goes on to name m itself is left to the reference's rewriting.
fn escaping_supers(f: i64, m: i64, refs_at: HMap, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let q = pcx.files[f as usize].module;
    let mut depth: i64 = 0;
    let mut x = q;
    while x != m && x >= 0 {
        depth += 1;
        x = pcx.modules[x as usize].parent;
    }
    let sup = intern(b"super", pcx);
    let mut i = token_at(pcx.files[f as usize].start, pcx);
    while i + 1 < pcx.toks.len() as i64 && pcx.toks[i as usize].start < pcx.files[f as usize].end {
        if pcx.toks[i as usize].kind != Tok::Ident || pcx.toks[i as usize].value as i64 != sup
            || pcx.toks[(i + 1) as usize].kind != Tok::ColonColon
            || (i > 0 && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon) {
            i += 1;
            continue;
        }
        let first = i;
        let mut k: i64 = 0;
        let mut target = module_at(pcx.toks[i as usize].start, pcx);
        while i + 1 < pcx.toks.len() as i64 && pcx.toks[i as usize].kind == Tok::Ident
            && pcx.toks[i as usize].value as i64 == sup
            && pcx.toks[(i + 1) as usize].kind == Tok::ColonColon {
            k += 1;
            target = if target >= 0 { pcx.modules[target as usize].parent } else { -1 };
            i += 2;
        }
        if k <= depth || target < 0 {
            continue;
        }
        // (the rest of the path naming m: left to the reference)
        let mut j = i;
        let mut names_m = false;
        while j + 1 < pcx.toks.len() as i64 && pcx.toks[j as usize].kind == Tok::Ident {
            if refs_at.get(pcx.toks[j as usize].start + 1) != 0 {
                names_m = true;
            }
            if pcx.toks[(j + 1) as usize].kind != Tok::ColonColon {
                break;
            }
            j += 2;
        }
        if names_m {
            continue;
        }
        let text = buf_new();
        buf_bytes(text, mod_fqn_text(target, tcx, pcx));
        buf_str(text, c"::");
        put_edit(pcx.toks[first as usize].start, pcx.toks[i as usize].start, text, tcx, pcx);
    }
}
