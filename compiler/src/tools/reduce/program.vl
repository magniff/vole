// `volec reduce` over programs (0.18, T3; docs/design/
// contracts-verification.md §2.9): a program made small while it stays
// interesting:
//   reduce PROG.vl --differs [--input F]   its -O0 and -O2 runs disagree
//                                            (stdout, exit status, first
//                                            line of stderr)
//   reduce PROG.vl --fails 'TEXT'          its build or run prints TEXT
//   reduce PROG.vl --test NAME [--differs] its test NAME fails as it does
//                                            now (or disagrees between the
//                                            levels)
// The program is cut by its layout (volec fmt's): whole items, then
// the statements inside them, each with the lines indented under it, by
// halves first, then one by one, to a fixpoint. A candidate is the
// program's file with lines left out, written next to it (so that its
// `mod` lines find their files) as NAME.reduce.vl; one that does not
// build is not interesting (for --differs and --test). The result is
// NAME.min.vl.

use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Ev, Opt, flag, is_flag, is_opt, option};
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, read_file_if, remove_file, write_file_if};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::diag;
use crate::tools::testrun::program::{add_job, argv_of, file_text, first_line, run_jobs};

// The options of the program modes, for reduce's table (0.25, on
// std::cli: cli/line.vl).
pub fn program_opts(opts: &mut Vec<Opt<'_>, Gpa>) {
    opts.push(flag("differs", "the program's -O0 and -O2 runs disagree"));
    opts.push(option("fails", "TEXT", "its build or run prints TEXT"));
    opts.push(option("test", "NAME", "its test NAME fails as it does now"));
    opts.push(option("input", "F", "--differs: the runs' stdin"));
}

// Takes ev when it is one of program_opts' (a value given): whether it was.
pub fn program_option(ev: Ev<'_>, tcx: &mut Tcx<Comp>) -> bool {
    if is_flag(ev, "differs") {
        tcx.differs = true;
    } else if is_opt(ev, "fails") {
        tcx.fails = ev.value;
    } else if is_opt(ev, "test") {
        tcx.test = ev.value;
    } else if is_opt(ev, "input") {
        tcx.program_input = ev.value;
    } else {
        return false;
    }
    true
}

pub fn program_mode(tcx: &Tcx<Comp>) -> bool {
    tcx.differs || tcx.fails != 0 as *mut u8 || tcx.test != 0 as *mut u8
}

fn with_suffix(file: *mut u8, suffix: &[u8]) -> *mut u8 {
    let s = c_slice(file);
    let b = buf_new();
    buf_bytes(b, &s[0..(s.len() as i64 - crate::base::source_ext_len(s)) as usize]);
    buf_bytes(b, suffix);
    buf_cstr(b)
}

fn words(a: *mut u8, b: *mut u8, c: *mut u8, d: *mut u8, e: *mut u8, f: *mut u8) -> Vec<i64, Comp> {
    let mut w: Vec<i64, Comp> = Vec::new_in(Comp {});
    let list = [a, b, c, d, e, f];
    for k in 0..6 {
        if list[k as usize] != 0 as *mut u8 {
            w.push(list[k as usize] as i64);
        }
    }
    w
}

// Runs words (stdin from input, 0: none) with a time limit: the job.
fn run(w: &[i64], input: *mut u8, out: *mut u8, err: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    let j = add_job(argv_of(w), input, out, err, tcx);
    run_jobs(j, tcx);
    j
}

// What a build and run of `path` at `level` shows: "B" + the build's
// output when it does not build, else "R" + exit status, stdout and the
// first line of stderr.
fn outcome<'a>(path: *mut u8, level: *mut u8, test: bool, tcx: &mut Tcx<Comp>, pcx: &'a Ctx<Comp>) -> &'a [u8] {
    let bin = with_suffix(path, if streq(level, c"-O0") { b".o0" } else { b".o2" });
    let log = with_suffix(path, b".log");
    let mut w = words(pcx.prog, path, c"-o", bin, level,
        if test { c"--test-build" } else { 0 as *mut u8 });
    // (0.26.3: both levels with the overflow checks on, as volec test)
    w.push(c"--overflow-checks=on" as i64);
    let built = run(w.as_slice(), 0 as *mut u8, log, log, tcx);
    let b = buf_new();
    if (tcx.jobs[built as usize]).status != 0 {
        buf_byte(b, b'B');
        buf_bytes(b, file_text(log));
        return buf_slice(b);
    }
    let mut r = words(bin, 0 as *mut u8, 0 as *mut u8, 0 as *mut u8, 0 as *mut u8,
        0 as *mut u8);
    if test {
        r.push(c"--vole-test" as i64);
        r.push(tcx.test as i64);
    }
    let out = with_suffix(path, b".out");
    let err = with_suffix(path, b".err");
    let ran = run(r.as_slice(), tcx.program_input, out, err, tcx);
    buf_byte(b, b'R');
    buf_int(b, (tcx.jobs[ran as usize]).status);
    buf_byte(b, b'\n');
    buf_bytes(b, file_text(out));
    buf_bytes(b, b"\n--\n");
    buf_bytes(b, first_line(file_text(err)));
    remove_file(bin);
    buf_slice(b)
}

fn contains(hay: &[u8], needle: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + needle.len() as i64 <= hay.len() as i64 {
        if &hay[i as usize..(i + needle.len() as i64) as usize] == needle {
            return true;
        }
        i += 1;
    }
    false
}

// Whether the program at path is interesting.
fn interesting(path: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    tcx.program_runs += 1;
    let test = tcx.test != 0 as *mut u8;
    if tcx.differs {
        let a = outcome(path, c"-O0", test, tcx, pcx);
        if a[0] != b'R' {
            return false;
        }
        let b = outcome(path, c"-O2", test, tcx, pcx);
        return b[0] == b'R' && a != b;
    }
    if tcx.fails != 0 as *mut u8 {
        return contains(outcome(path, c"-O2", false, tcx, pcx), c_slice(tcx.fails));
    }
    let o = outcome(path, c"-O2", true, tcx, pcx);
    o[0] == b'R' && tcx.reduce_want >= 0 && o == buf_slice(tcx.reduce_want)
}

// The lines of text: start and end (with its newline) of each, into
// lines; their indentation into indent (-1: blank).
fn split_lines(text: &[u8], lines: &mut Vec<i64, Comp>, indent: &mut Vec<i64, Comp>) {
    let mut s: i64 = 0;
    let mut k: i64 = 0;
    while k <= text.len() as i64 {
        if k == text.len() as i64 || text[k as usize] == b'\n' {
            if k > s || k < text.len() as i64 {
                lines.push(s);
                lines.push(if k < text.len() as i64 { k + 1 } else { k });
                let mut d: i64 = 0;
                while s + d < k && text[(s + d) as usize] == b' ' {
                    d += 1;
                }
                indent.push(if s + d == k { -1 } else { d });
            }
            s = k + 1;
        }
        k += 1;
    }
}

// The lines of the unit that starts at line l (of those kept): it and the
// lines indented under it, with a closing `}` (or `} else {` and what it
// opens) at its own level; the end (exclusive) in keep's order.
fn unit_end(text: &[u8], lines: &[i64], indent: &[i64], keep: &[i64], at: i64) -> i64 {
    let d = (indent[(keep[at as usize]) as usize]);
    let mut j = at + 1;
    while j < keep.len() as i64 {
        let l = (keep[j as usize]);
        let e = (indent[l as usize]);
        if e == -1 || e > d {
            j += 1;
            continue;
        }
        let first = text[((lines[(2 * l) as usize]) + e) as usize];
        if e == d && (first == b'}' || first == b')' || first == b']') {
            j += 1;
            continue;
        }
        break;
    }
    // (trailing blank lines stay with what follows)
    while j > at + 1 && (indent[(keep[(j - 1) as usize]) as usize]) == -1 {
        j -= 1;
    }
    j
}

fn write_candidate(text: &[u8], lines: &[i64], keep: &[i64], path: *mut u8) {
    let b = buf_new();
    for k in 0..keep.len() as i64 {
        let l = (keep[k as usize]);
        buf_bytes(b,
            &text[
                (lines[(2 * l) as usize]) as usize..(lines[(2 * l + 1) as usize]) as usize]);
    }
    write_file_if(path, buf_slice(b));
}

// keep without its entries from..to.
fn without(keep: &[i64], from: i64, to: i64) -> Vec<i64, Comp> {
    let mut rest: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..keep.len() as i64 {
        if k < from || k >= to {
            rest.push((keep[k as usize]));
        }
    }
    rest
}

// The units of keep at indentation `depth` (their starts, in keep's
// order) and their ends.
fn units(text: &[u8], lines: &[i64], indent: &[i64], keep: &[i64], depth: i64,
    starts: &mut Vec<i64, Comp>, ends: &mut Vec<i64, Comp>) {
    starts.clear();
    ends.clear();
    let mut k: i64 = 0;
    while k < keep.len() as i64 {
        let l = (keep[k as usize]);
        let d = (indent[l as usize]);
        if d == depth {
            let first = text[((lines[(2 * l) as usize]) + d) as usize];
            if first != b'}' && first != b')' && first != b']' {
                let e = unit_end(text, lines, indent, keep, k);
                starts.push(k);
                ends.push(e);
                k = if depth == 0 { e } else { k + 1 };
                continue;
            }
        }
        k += 1;
    }
}

// One pass at a depth: the units left out, a run of them at a time
// (halves, quarters, ... then one), from the last; whether one went.
fn pass(text: &[u8], lines: &[i64], indent: &[i64], keep: &mut Vec<i64, Comp>, depth: i64,
    path: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut any = false;
    let mut starts: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut ends: Vec<i64, Comp> = Vec::new_in(Comp {});
    units(text, lines, indent, (*keep).as_slice(), depth, &mut starts, &mut ends);
    let mut size = starts.len() as i64 / 2;
    if size < 1 {
        size = 1;
    }
    while size >= 1 && tcx.program_runs < tcx.program_max_runs {
        let mut i = starts.len() as i64 - size;
        while i >= 0 && tcx.program_runs < tcx.program_max_runs {
            units(text, lines, indent, (*keep).as_slice(), depth, &mut starts, &mut ends);
            if i + size > starts.len() as i64 {
                i = starts.len() as i64 - size;
                if i < 0 {
                    break;
                }
            }
            // (a run of units: next to each other, in one block)
            let mut apart = false;
            for u in i..i + size - 1 {
                if (ends[u as usize]) != (starts[(u + 1) as usize]) {
                    apart = true;
                }
            }
            if apart && depth > 0 {
                i -= size;
                continue;
            }
            let from = (starts[i as usize]);
            let mut to = (ends[(i + size - 1) as usize]);
            for u in i..i + size {
                if (ends[u as usize]) > to {
                    to = (ends[u as usize]);
                }
            }
            let rest = without(keep.as_slice(), from, to);
            if rest.len() as i64 > 0 {
                write_candidate(text, lines, rest.as_slice(), path);
                if interesting(path, tcx, pcx) {
                    *keep = rest;
                    any = true;
                }
            }
            i -= size;
        }
        if size == 1 {
            break;
        }
        size = size / 2;
    }
    any
}

// keep without blank lines at its start and end, nor two in a row.
fn tidy(text: &[u8], indent: &[i64], keep: &mut Vec<i64, Comp>) {
    let mut rest: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..keep.len() as i64 {
        let l = (keep[k as usize]);
        let blank = (indent[l as usize]) == -1;
        if blank
            && (rest.len() as i64 == 0
                || (indent[(rest[(rest.len() as i64 - 1) as usize]) as usize])
                == -1) {
            continue;
        }
        rest.push(l);
    }
    while rest.len() as i64 > 0
        && (indent[(rest[(rest.len() as i64 - 1) as usize]) as usize]) == -1 {
        rest.pop().unwrap();
    }
    *keep = rest;
}

pub fn reduce_program(file: *mut u8, out_file: *mut u8, max_runs: i64, tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) -> i64 {
    if max_runs > 0 {
        tcx.program_max_runs = max_runs;
    }
    let original = buf_new();
    if !read_file_if(file, original) {
        let d = diag(c"error", c"reduce.no-file", tcx);
        buf_str(d, c"cannot read '");
        buf_str(d, file);
        buf_str(d, c"'\n");
        return 2;
    }
    let text = buf_slice(original);
    let mut lines: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut indent: Vec<i64, Comp> = Vec::new_in(Comp {});
    split_lines(text, &mut lines, &mut indent);
    let n_lines = lines.len() as i64 / 2;
    let mut keep: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..n_lines {
        keep.push(k);
    }
    // (absolute: the builds run by their path, not $PATH)
    let path = with_suffix(crate::tools::proc::absolute_path(file), b".reduce.vl");
    write_candidate(text, lines.as_slice(), keep.as_slice(), path);
    if tcx.test != 0 as *mut u8 && !tcx.differs {
        let o = outcome(path, c"-O2", true, tcx, pcx);
        let b = buf_new();
        buf_bytes(b, o);
        tcx.reduce_want = b;
        if o[0] != b'R' || o.len() > 3 && o[1] == b'0' && o[2] == b'\n' {
            remove_file(path);
            let d = diag(c"error", c"reduce.not-failing", tcx);
            buf_str(d, c"test '");
            buf_str(d, tcx.test);
            buf_str(d, c"' of ");
            buf_str(d, file);
            buf_str(d,
                if o[0] != b'R' { c"' does not build\n" }
                else { c" passes: nothing to keep failing\n" });
            return 1;
        }
    } else if !interesting(path, tcx, pcx) {
        remove_file(path);
        let d = diag(c"error", c"reduce.not-failing", tcx);
        buf_str(d, file);
        buf_str(d, if tcx.differs { c": -O0 and -O2 agree on it as it is" }
            else { c": its build and run do not print the text as it is" });
        buf_str(d, c" (nothing to keep)\n");
        return 1;
    }
    // items first, then deeper and deeper, to a fixpoint
    let mut changed = true;
    while changed && tcx.program_runs < tcx.program_max_runs {
        changed = false;
        let mut depth: i64 = 0;
        while depth <= 40 && tcx.program_runs < tcx.program_max_runs {
            if pass(text, lines.as_slice(), indent.as_slice(), &mut keep, depth, path, tcx, pcx) {
                changed = true;
            }
            depth += 4;
        }
    }
    tidy(text, indent.as_slice(), &mut keep);
    let target = if out_file != 0 as *mut u8 { out_file }
        else { with_suffix(file, b".min.vl") };
    write_candidate(text, lines.as_slice(), keep.as_slice(), target);
    remove_file(path);
    remove_file(with_suffix(path, b".log"));
    remove_file(with_suffix(path, b".out"));
    remove_file(with_suffix(path, b".err"));
    let o = buf_new();
    buf_bytes(o, b"reduced ");
    buf_str(o, file);
    buf_bytes(o, b": ");
    buf_int(o, n_lines);
    buf_bytes(o, b" lines to ");
    buf_int(o, keep.len() as i64);
    buf_bytes(o, b" in ");
    buf_int(o, tcx.program_runs);
    buf_bytes(o, b" runs");
    if tcx.program_runs >= tcx.program_max_runs {
        buf_bytes(o, b" (--max-runs reached: not minimal)");
    }
    buf_bytes(o, b"; written to ");
    buf_str(o, target);
    buf_byte(o, b'\n');
    if keep.len() as i64 <= 30 {
        let r = buf_new();
        for k in 0..keep.len() as i64 {
            let l = (keep[k as usize]);
            buf_bytes(r,
                &text[
                    (lines[(2 * l) as usize]) as usize..(lines[(2 * l + 1) as usize]) as usize]);
        }
        buf_bytes(o, buf_slice(r));
    }
    buf_write_fd(o, STDOUT);
    0
}
