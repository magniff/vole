// `query deps MODULE`: for each item of a module, its lines, what of the
// module it uses and what uses it; then a grouping of the items into parts
// of at most N lines (average-linkage clustering of the references between
// them, then packing), which `refactor split --plan` starts from.

use crate::base::{STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{file_of_pos, module_at};
use crate::tools::ctx::{Tcx, zeros};
use crate::tools::plan::{def_lines, sort_desc, user_file};
use crate::tools::proc::same_bytes;
use crate::tools::query::QF_DEF;
use crate::tools::query::defs::{K_MOD, mod_fqn_text};
use crate::tools::query::positions::{enclosing, sort_by_position};
use crate::tools::query::refs::{collect_refs, file_text, put_short, set_targets, sorted_refs};
use crate::tools::query::show::{find_modules, module_file};

// ---- deps ----

// The item a definition belongs to (a field's struct, a variant's enum, a
// trait's function's trait), or -1.
fn item_of(d: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut x = d;
    while x >= 0 && pcx.defs[x as usize].parent >= 0 {
        x = pcx.defs[x as usize].parent;
    }
    x
}

// The name of item d in its module: its path without the module's.
pub fn put_local(out: i64, d: i64, m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let p = sym_text(pcx.defs[d as usize].fqn, pcx);
    let mp = mod_fqn_text(m, tcx, pcx);
    if p.len() as i64 > mp.len() as i64 + 2 && same_bytes(&p[0..mp.len()], mp)
        && p[mp.len()] == b':' {
        buf_bytes(out, &p[(mp.len() as i64 + 2) as usize..]);
    } else {
        put_short(out, pcx.defs[d as usize].fqn, pcx);
    }
}

// `query deps MODULE`: per item (in order), its lines, the items of the
// module it uses, the ones that use it, and the references from other
// modules; then groups of at most --max-lines lines (connected items
// together), and the references between groups.
pub fn query_deps(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
        find_modules(name, false, &mut modules, tcx, pcx);
        if modules.len() as i64 == 0 {
            crate::tools::query::diagnostics::no_module(name, tcx, pcx);
            return 1;
        }
        let m = (modules[0]);
        // The module's items (and their fields, variants, functions) are
        // the targets.
        let mut items: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut targets: Vec<i64, Comp> = Vec::new_in(Comp {});
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].module == m && pcx.defs[d as usize].kind != K_MOD
                && user_file(file_of_pos(pcx.defs[d as usize].start, pcx), pcx) {
                targets.push(d);
                if pcx.defs[d as usize].parent < 0 {
                    items.push(d);
                }
            }
        }
        sort_by_position(&mut items, tcx, pcx);
        let n = items.len() as i64;
        // index of each item in `items` (+1), by definition
        let mut index = zeros(pcx.defs.len() as i64 + 1);
        for i in 0..n {
            (index[(items[i as usize]) as usize]) = i + 1;
        }
        set_targets(targets.as_slice(), tcx, pcx);
        collect_refs(tcx, pcx);
        let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
        sorted_refs(&mut order, tcx, pcx);
        // weight[a * n + b]: the references from item a to item b.
        let mut weight = zeros(n * n + 1);
        let mut outside = zeros(n + 1);
        for k in 0..order.len() as i64 {
            let r = (order[k as usize]);
            if ((tcx.r_flags[r as usize]) & QF_DEF) != 0 {
                continue;
            }
            let t = item_of((tcx.r_def[r as usize]), pcx);
            if t < 0 || (index[t as usize]) == 0 {
                continue;
            }
            let e = enclosing((tcx.r_pos[r as usize]), tcx, pcx);
            let s: i64 = if e >= 0 { item_of(e, pcx) } else { -1 };
            if s < 0 || (index[s as usize]) == 0 {
                if module_at((tcx.r_pos[r as usize]), pcx) != m {
                    (outside[((index[t as usize]) - 1) as usize]) += 1;
                }
                continue;
            }
            if s != t {
                (weight[(((index[s as usize]) - 1) * n + (index[t as usize]) - 1) as usize]) += 1;
            }
        }
        let mut lines = zeros(n + 1);
        let mut total: i64 = 0;
        for i in 0..n {
            (lines[i as usize]) = def_lines((items[i as usize]), pcx);
            total += (lines[i as usize]);
        }
        let out = buf_new();
        buf_str(out, c"# ");
        buf_bytes(out, mod_fqn_text(m, tcx, pcx));
        let file = module_file(m, pcx);
        if file >= 0 {
            buf_byte(out, b'\t');
            buf_bytes(out, file_text(file, pcx));
        }
        buf_byte(out, b'\t');
        buf_int(out, total);
        buf_str(out, c" lines\t");
        buf_int(out, n);
        buf_str(out, c" items\n");
        for i in 0..n {
            put_local(out, (items[i as usize]), m, tcx, pcx);
            buf_byte(out, b'\t');
            buf_int(out, (lines[i as usize]));
            buf_byte(out, b'\t');
            put_names(out, items.as_slice(), m, &weight, n, i, true, tcx, pcx);
            buf_byte(out, b'\t');
            put_names(out, items.as_slice(), m, &weight, n, i, false, tcx, pcx);
            buf_byte(out, b'\t');
            buf_int(out, (outside[i as usize]));
            buf_byte(out, b'\n');
        }
        put_groups(out, items.as_slice(), m, &weight, &lines, n, tcx, pcx);
        buf_write_fd(out, STDOUT);
        0
    }
}

// The items item i uses (or, !uses, that use it), space-separated; `-`
// for none.
fn put_names(out: i64, items: &[i64], m: i64, weight: &[i64], n: i64, i: i64, uses: bool,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut any = false;
        for j in 0..n {
            let w = if uses { (weight[(i * n + j) as usize]) }
                else { (weight[(j * n + i) as usize]) };
            if w == 0 {
                continue;
            }
            if any {
                buf_byte(out, b' ');
            }
            put_local(out, (items[j as usize]), m, tcx, pcx);
            any = true;
        }
        if !any {
            buf_byte(out, b'-');
        }
    }
}

// The grouping of the items into parts of at most OPT_MAX_LINES lines
// (cluster), printed as
// `groups<TAB>N<TAB>at most MAX lines<TAB>CUT references between them`,
// then `group K<TAB>LINES<TAB>ITEMS` each.
fn put_groups(out: i64, items: &[i64], m: i64, weight: &[i64], lines: &[i64], n: i64,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let max = tcx.opt_max_lines;
        let mut group = zeros(n + 1);
        let mut size = zeros(n + 1);
        cluster(weight, lines, n, max, &mut group, &mut size);
        let groups = n;
        // The references between groups.
        let mut cut: i64 = 0;
        for i in 0..n {
            for j in 0..n {
                if (group[i as usize]) != (group[j as usize]) {
                    cut += (weight[(i * n + j) as usize]);
                }
            }
        }
        // The groups, largest first.
        let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
        for g in 0..groups {
            if (size[g as usize]) >= 0 {
                order.push(g);
            }
        }
        sort_desc(&mut order, &size);
        buf_str(out, c"groups\t");
        buf_int(out, order.len() as i64);
        buf_str(out, c"\tat most ");
        buf_int(out, max);
        buf_str(out, c" lines\t");
        buf_int(out, cut);
        buf_str(out,
            if cut == 1 { c" reference between them\n" } else { c" references between them\n" });
        for k in 0..order.len() as i64 {
            let g = (order[k as usize]);
            buf_str(out, c"group ");
            buf_int(out, k + 1);
            buf_byte(out, b'\t');
            buf_int(out, (size[g as usize]));
            buf_byte(out, b'\t');
            let mut first = true;
            for i in 0..n {
                if (group[i as usize]) != g {
                    continue;
                }
                if !first {
                    buf_byte(out, b' ');
                }
                put_local(out, (items[i as usize]), m, tcx, pcx);
                first = false;
            }
            if (size[g as usize]) > max {
                buf_str(out, c"\tover");
            }
            buf_byte(out, b'\n');
        }
    }
}

// The grouping of n items (weight[a * n + b]: the references from item a
// to item b; lines[i]: item i's lines) into parts of at most max lines:
// agglomerative, by average linkage: from one part per item, the two
// parts with the most references between them per pair of their items
// are merged while they fit together; then the parts with no references
// between them are packed (first fit, largest first). group[i] is item
// i's part (the index of one of its items), size[g] the lines of part g
// (-1 for an index that is no part's).
pub fn cluster(weight: &[i64], lines: &[i64], n: i64, max: i64, group: &mut [i64],
    size: &mut [i64]) {
    unsafe {
        let mut count = zeros(n + 1);
        // (the references between parts, both ways)
        let mut w = zeros(n * n + 1);
        for i in 0..n {
            (group[i as usize]) = i;
            (size[i as usize]) = (lines[i as usize]);
            (count[i as usize]) = 1;
            for j in 0..n {
                (w[(i * n + j) as usize]) = if i == j { 0 }
                    else { (weight[(i * n + j) as usize]) + (weight[(j * n + i) as usize]) };
            }
        }
        loop {
            let mut ga: i64 = -1;
            let mut gb: i64 = -1;
            let mut best_w: i64 = 0;
            let mut best_c: i64 = 1;
            for a in 0..n {
                if (size[a as usize]) < 0 {
                    continue;
                }
                for b in a + 1..n {
                    if (size[b as usize]) < 0 || (w[(a * n + b) as usize]) == 0
                        || (size[a as usize]) + (size[b as usize]) > max {
                        continue;
                    }
                    // (w / (count a * count b), compared without division)
                    let c = (count[a as usize]) * (count[b as usize]);
                    let better = (w[(a * n + b) as usize]) * best_c > best_w * c
                        || ((w[(a * n + b) as usize]) * best_c == best_w * c && ga >= 0
                            && (size[a as usize]) + (size[b as usize])
                            < (size[ga as usize]) + (size[gb as usize]));
                    if ga < 0 || better {
                        ga = a;
                        gb = b;
                        best_w = (w[(a * n + b) as usize]);
                        best_c = c;
                    }
                }
            }
            if ga < 0 {
                break;
            }
            merge_group(group, size, &mut count, &mut w, n, ga, gb);
        }
        // Packing what has no references between: first fit, largest first.
        let mut parts: Vec<i64, Comp> = Vec::new_in(Comp {});
        for g in 0..n {
            if (size[g as usize]) >= 0 {
                parts.push(g);
            }
        }
        sort_desc(&mut parts, size);
        let mut bins: Vec<i64, Comp> = Vec::new_in(Comp {});
        for k in 0..parts.len() as i64 {
            let g = (parts[k as usize]);
            let mut placed = false;
            for x in 0..bins.len() as i64 {
                let b = (bins[x as usize]);
                if (size[b as usize]) + (size[g as usize]) <= max {
                    merge_group(group, size, &mut count, &mut w, n, b, g);
                    placed = true;
                    break;
                }
            }
            if !placed {
                bins.push(g);
            }
        }
    }
}

// Merges part b into part a (their items, sizes, references).
fn merge_group(group: &mut [i64], size: &mut [i64], count: &mut [i64], w: &mut [i64], n: i64,
    a: i64, b: i64) {
    unsafe {
        for i in 0..n {
            if (group[i as usize]) == b {
                (group[i as usize]) = a;
            }
        }
        (size[a as usize]) += (size[b as usize]);
        (size[b as usize]) = -1;
        (count[a as usize]) += (count[b as usize]);
        for x in 0..n {
            (w[(a * n + x) as usize]) += (w[(b * n + x) as usize]);
            (w[(x * n + a) as usize]) += (w[(x * n + b) as usize]);
        }
        (w[(a * n + a) as usize]) = 0;
    }
}
