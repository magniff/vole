// `query deps MODULE`: for each item of a module, its lines, what of the
// module it uses and what uses it; then a grouping of the items into parts
// of at most N lines (average-linkage clustering of the references between
// them, then packing), which `refactor split --plan` starts from.

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{file_of_pos, module_at};
use crate::tools::ctx::Tcx;
use crate::tools::plan::{def_lines, sort_desc, user_file};
use crate::tools::proc::same_bytes;
use crate::tools::query::QF_DEF;
use crate::tools::query::defs::{K_MOD, mod_fqn_text};
use crate::tools::query::positions::{enclosing, sort_by_position};
use crate::tools::query::refs::{collect_refs, file_text, put_short, set_targets, sorted_refs};
use crate::tools::query::show::{find_modules, module_file};

// ---- deps ----

// The item a definition belongs to (a field's struct, a variant's enum, a
// trait's function's trait), or -1.
fn item_of(d: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut x = d;
    while x >= 0 && pcx.defs[x as usize].parent >= 0 {
        x = pcx.defs[x as usize].parent;
    }
    x
}

// The name of item d in its module: its path without the module's.
pub fn put_local(out: i64, d: i64, m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let p = sym_text(pcx.defs[d as usize].fqn, pcx);
    let mp = mod_fqn_text(m, tcx, pcx);
    if p.len() as i64 > mp.len() as i64 + 2 && same_bytes(&p[0..mp.len()], mp)
        && p[mp.len()] == b':' {
        buf_bytes(out, &p[(mp.len() as i64 + 2) as usize..]);
    } else {
        put_short(out, pcx.defs[d as usize].fqn, pcx);
    }
}

// `query deps MODULE`: per item (in order), its lines, the items of the
// module it uses, the ones that use it, and the references from other
// modules; then groups of at most --max-lines lines (connected items
// together), and the references between groups.
pub fn query_deps(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut modules = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_modules(name, false, &mut modules, tcx, pcx);
        if modules.count == 0 {
            crate::tools::query::diagnostics::no_module(name, tcx, pcx);
            return 1;
        }
        let m = (*modules.data.add(0));
        // The module's items (and their fields, variants, functions) are
        // the targets.
        let mut items = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut targets = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].module == m && pcx.defs[d as usize].kind != K_MOD
                && user_file(file_of_pos(pcx.defs[d as usize].start, pcx), pcx) {
                targets.push(d);
                if pcx.defs[d as usize].parent < 0 {
                    items.push(d);
                }
            }
        }
        sort_by_position(items, tcx, pcx);
        let n = items.count;
        // index of each item in `items` (+1), by definition
        let index = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        for i in 0..n {
            (*index.add((*items.data.add(i as usize)) as usize)) = i + 1;
        }
        set_targets(targets, tcx, pcx);
        collect_refs(tcx, pcx);
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        sorted_refs(&mut order, tcx, pcx);
        // weight[a * n + b]: the references from item a to item b.
        let weight = alloc_array::<i64>(n * n + 1);
        let outside = alloc_array::<i64>(n + 1);
        for k in 0..order.count {
            let r = (*order.data.add(k as usize));
            if ((*tcx.r_flags.data.add(r as usize)) & QF_DEF) != 0 {
                continue;
            }
            let t = item_of((*tcx.r_def.data.add(r as usize)), pcx);
            if t < 0 || (*index.add(t as usize)) == 0 {
                continue;
            }
            let e = enclosing((*tcx.r_pos.data.add(r as usize)), tcx, pcx);
            let s: i64 = if e >= 0 { item_of(e, pcx) } else { -1 };
            if s < 0 || (*index.add(s as usize)) == 0 {
                if module_at((*tcx.r_pos.data.add(r as usize)), pcx) != m {
                    (*outside.add(((*index.add(t as usize)) - 1) as usize)) += 1;
                }
                continue;
            }
            if s != t {
                (*weight.add((((*index.add(s as usize)) - 1) * n + (*index.add(t as usize)) - 1) as usize)) += 1;
            }
        }
        let lines = alloc_array::<i64>(n + 1);
        let mut total: i64 = 0;
        for i in 0..n {
            (*lines.add(i as usize)) = def_lines((*items.data.add(i as usize)), pcx);
            total += (*lines.add(i as usize));
        }
        let out = buf_new();
        buf_str(out, c"# ");
        buf_bytes(out, mod_fqn_text(m, tcx, pcx));
        let file = module_file(m, pcx);
        if file >= 0 {
            buf_byte(out, b'\t');
            buf_bytes(out, file_text(file, pcx));
        }
        buf_byte(out, b'\t');
        buf_int(out, total);
        buf_str(out, c" lines\t");
        buf_int(out, n);
        buf_str(out, c" items\n");
        for i in 0..n {
            put_local(out, (*items.data.add(i as usize)), m, tcx, pcx);
            buf_byte(out, b'\t');
            buf_int(out, (*lines.add(i as usize)));
            buf_byte(out, b'\t');
            put_names(out, items, m, weight, n, i, true, tcx, pcx);
            buf_byte(out, b'\t');
            put_names(out, items, m, weight, n, i, false, tcx, pcx);
            buf_byte(out, b'\t');
            buf_int(out, (*outside.add(i as usize)));
            buf_byte(out, b'\n');
        }
        put_groups(out, items, m, weight, lines, n, tcx, pcx);
        buf_write_fd(out, STDOUT);
        0
    }
}

// The items item i uses (or, !uses, that use it), space-separated; `-`
// for none.
fn put_names(out: i64, items: IntVec, m: i64, weight: *mut i64, n: i64, i: i64, uses: bool,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut any = false;
        for j in 0..n {
            let w = if uses { (*weight.add((i * n + j) as usize)) } else { (*weight.add((j * n + i) as usize)) };
            if w == 0 {
                continue;
            }
            if any {
                buf_byte(out, b' ');
            }
            put_local(out, (*items.data.add(j as usize)), m, tcx, pcx);
            any = true;
        }
        if !any {
            buf_byte(out, b'-');
        }
    }
}

// The grouping of the items into parts of at most OPT_MAX_LINES lines
// (cluster), printed as
// `groups<TAB>N<TAB>at most MAX lines<TAB>CUT references between them`,
// then `group K<TAB>LINES<TAB>ITEMS` each.
fn put_groups(out: i64, items: IntVec, m: i64, weight: *mut i64, lines: *mut i64, n: i64,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let max = tcx.opt_max_lines;
        let group = alloc_array::<i64>(n + 1);
        let size = alloc_array::<i64>(n + 1);
        cluster(weight, lines, n, max, group, size);
        let groups = n;
        // The references between groups.
        let mut cut: i64 = 0;
        for i in 0..n {
            for j in 0..n {
                if (*group.add(i as usize)) != (*group.add(j as usize)) {
                    cut += (*weight.add((i * n + j) as usize));
                }
            }
        }
        // The groups, largest first.
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for g in 0..groups {
            if (*size.add(g as usize)) >= 0 {
                order.push(g);
            }
        }
        sort_desc(order, size);
        buf_str(out, c"groups\t");
        buf_int(out, order.count);
        buf_str(out, c"\tat most ");
        buf_int(out, max);
        buf_str(out, c" lines\t");
        buf_int(out, cut);
        buf_str(out,
            if cut == 1 { c" reference between them\n" } else { c" references between them\n" });
        for k in 0..order.count {
            let g = (*order.data.add(k as usize));
            buf_str(out, c"group ");
            buf_int(out, k + 1);
            buf_byte(out, b'\t');
            buf_int(out, (*size.add(g as usize)));
            buf_byte(out, b'\t');
            let mut first = true;
            for i in 0..n {
                if (*group.add(i as usize)) != g {
                    continue;
                }
                if !first {
                    buf_byte(out, b' ');
                }
                put_local(out, (*items.data.add(i as usize)), m, tcx, pcx);
                first = false;
            }
            if (*size.add(g as usize)) > max {
                buf_str(out, c"\tover");
            }
            buf_byte(out, b'\n');
        }
    }
}

// The grouping of n items (weight[a * n + b]: the references from item a
// to item b; lines[i]: item i's lines) into parts of at most max lines:
// agglomerative, by average linkage: from one part per item, the two
// parts with the most references between them per pair of their items
// are merged while they fit together; then the parts with no references
// between them are packed (first fit, largest first). group[i] is item
// i's part (the index of one of its items), size[g] the lines of part g
// (-1 for an index that is no part's).
pub fn cluster(weight: *mut i64, lines: *mut i64, n: i64, max: i64, group: *mut i64, size: *mut i64) {
    unsafe {
        let count = alloc_array::<i64>(n + 1);
        // (the references between parts, both ways)
        let w = alloc_array::<i64>(n * n + 1);
        for i in 0..n {
            (*group.add(i as usize)) = i;
            (*size.add(i as usize)) = (*lines.add(i as usize));
            (*count.add(i as usize)) = 1;
            for j in 0..n {
                (*w.add((i * n + j) as usize)) = if i == j { 0 } else { (*weight.add((i * n + j) as usize)) + (*weight.add((j * n + i) as usize)) };
            }
        }
        loop {
            let mut ga: i64 = -1;
            let mut gb: i64 = -1;
            let mut best_w: i64 = 0;
            let mut best_c: i64 = 1;
            for a in 0..n {
                if (*size.add(a as usize)) < 0 {
                    continue;
                }
                for b in a + 1..n {
                    if (*size.add(b as usize)) < 0 || (*w.add((a * n + b) as usize)) == 0 || (*size.add(a as usize)) + (*size.add(b as usize)) > max {
                        continue;
                    }
                    // (w / (count a * count b), compared without division)
                    let c = (*count.add(a as usize)) * (*count.add(b as usize));
                    let better = (*w.add((a * n + b) as usize)) * best_c > best_w * c
                        || ((*w.add((a * n + b) as usize)) * best_c == best_w * c && ga >= 0
                            && (*size.add(a as usize)) + (*size.add(b as usize)) < (*size.add(ga as usize)) + (*size.add(gb as usize)));
                    if ga < 0 || better {
                        ga = a;
                        gb = b;
                        best_w = (*w.add((a * n + b) as usize));
                        best_c = c;
                    }
                }
            }
            if ga < 0 {
                break;
            }
            merge_group(group, size, count, w, n, ga, gb);
        }
        // Packing what has no references between: first fit, largest first.
        let mut parts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for g in 0..n {
            if (*size.add(g as usize)) >= 0 {
                parts.push(g);
            }
        }
        sort_desc(parts, size);
        let mut bins = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..parts.count {
            let g = (*parts.data.add(k as usize));
            let mut placed = false;
            for x in 0..bins.count {
                let b = (*bins.data.add(x as usize));
                if (*size.add(b as usize)) + (*size.add(g as usize)) <= max {
                    merge_group(group, size, count, w, n, b, g);
                    placed = true;
                    break;
                }
            }
            if !placed {
                bins.push(g);
            }
        }
    }
}

// Merges part b into part a (their items, sizes, references).
fn merge_group(group: *mut i64, size: *mut i64, count: *mut i64, w: *mut i64, n: i64, a: i64, b: i64) {
    unsafe {
        for i in 0..n {
            if (*group.add(i as usize)) == b {
                (*group.add(i as usize)) = a;
            }
        }
        (*size.add(a as usize)) += (*size.add(b as usize));
        (*size.add(b as usize)) = -1;
        (*count.add(a as usize)) += (*count.add(b as usize));
        for x in 0..n {
            (*w.add((a * n + x) as usize)) += (*w.add((b * n + x) as usize));
            (*w.add((x * n + a) as usize)) += (*w.add((x * n + b) as usize));
        }
        (*w.add((a * n + a) as usize)) = 0;
    }
}
