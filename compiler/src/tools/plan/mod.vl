// Planning queries (0.11; docs/refactor.md): the facts for deciding how to
// change a program, from the same front end as the other queries.
//
//   query stats [MODULE|FILE] [--over N]   lines per file (or per item),
//                                          largest first
//   query deps MODULE [--max-lines N]      what each item of a module uses
//                                          of it and is used by, and a
//                                          grouping into parts of at most
//                                          N lines
//   query unused [MODULE]                  items, fields, variants and
//                                          imports nothing uses
//   query impact NAME                      what a change of NAME's
//                                          signature touches
//   volec lint --max-lines N [ROOT]     the files over N lines
//
// Lines of an item are its text's: from its comments and attributes to
// its last line (as `query show` prints it).
//
// `query deps` and the clustering it shares with `refactor split --plan`
// are in deps; the other queries and lint are here.

pub mod deps;

use std::alloc::Arena;

use crate::base::{
    SOURCE_VOLE, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, get_src,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_WORD, Leaf, is_opt, option, table};
use crate::front::ast::NodeKind;
use crate::front::embed::wgsl::WgslCx;
use crate::front::modules::{file_made, file_of_pos, module_at, within_std};
use crate::tools::ctx::{Tcx, falses, zeros};
use crate::tools::fix::unused_imports;
use crate::tools::fmt::generated;
use crate::tools::proc::same_bytes;
use crate::tools::query::{QF_CALL, QF_DEF, QF_USE, c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{K_IMPL_METHOD, K_MOD, K_TRAIT_FN, kind_name, mod_fqn, mod_fqn_text};
use crate::tools::query::diagnostics::{
    diag, program_errors, try_begin, try_end, try_query, write_diags,
};
use crate::tools::query::positions::{enclosing, line_of, put_loc, sort_by_position};
use crate::tools::query::refs::{
    REFS_BUDGET, collect_refs, file_text, put_short, set_targets, sorted_refs,
};
use crate::tools::query::show::{find_modules, module_file, text_start};

use deps::put_local;

// ---- Sizes ----

// The number of lines of file f.
fn file_lines(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    for p in pcx.files[f as usize].start..pcx.files[f as usize].end {
        if get_src()[p as usize] == b'\n' {
            n += 1;
        }
    }
    if pcx.files[f as usize].end > pcx.files[f as usize].start
        && get_src()[(pcx.files[f as usize].end - 1) as usize] != b'\n' {
        n += 1;
    }
    n
}

// The lines of definition d's text.
fn def_lines(d: i64, pcx: &Ctx<Comp>) -> i64 {
    let last = if pcx.defs[d as usize].end
        > pcx.defs[d as usize].start { pcx.defs[d as usize].end - 1 }
        else { pcx.defs[d as usize].start };
    line_of(last, pcx) - line_of(text_start(d, pcx), pcx) + 1
}

// Whether file f is one of the program's own vole files (not std's, the
// C headers', 0.26.2: not an embedded block's .wgsl).
fn user_file(f: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        !file_made(f, pcx) && pcx.files[f as usize].kind == SOURCE_VOLE
    }
}

// Whether definition d is an item: not a field or variant, not a module,
// in a file of the program.
fn is_item(d: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.defs[d as usize].parent < 0 && pcx.defs[d as usize].kind != K_MOD
        && user_file(file_of_pos(pcx.defs[d as usize].start, pcx), pcx)
}

// Whether text names a file (it has a `/`, ends in .vl, or is `<std>`).
fn is_file_name(t: &[u8]) -> bool {
    if t.len() > 0 && t[0] == b'<' {
        return true;
    }
    for i in 0..t.len() {
        if t[i] == b'/' {
            return true;
        }
    }
    crate::base::source_ext_len(t) > 0
}

// The files whose path is t or ends with it (by whole components).
fn files_named(t: &[u8], out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for f in 0..pcx.files.len() as i64 {
        let p = file_text(f, pcx);
        if same_bytes(p, t)
            || (p.len() > t.len()
                && same_bytes(&p[(p.len() as i64 - t.len() as i64) as usize..], t)
                && p[(p.len() as i64 - t.len() as i64 - 1) as usize] == b'/') {
            out.push(f);
        }
    }
}

// Sorts v by key[v[i]], largest first (stable).
fn sort_desc(v: &mut Vec<i64, Comp>, key: &[i64]) {
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 && key[v[j] as usize] > key[v[j - 1] as usize] {
            let t = v[j];
            v[j] = v[j - 1];
            v[j - 1] = t;
            j -= 1;
        }
    }
}

// `query stats`: per file, its lines and items, largest first (`over` after
// a file of more than --over lines); `query stats MODULE|FILE`: per item.
pub fn query_stats(name: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        if name == 0 as *mut u8 {
            let mut lines = zeros(pcx.files.len() as i64 + 1);
            let mut items = zeros(pcx.files.len() as i64 + 1);
            let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
            for f in 0..pcx.files.len() as i64 {
                if user_file(f, pcx) {
                    files.push(f);
                    (lines[f as usize]) = file_lines(f, pcx);
                }
            }
            for d in 0..pcx.defs.len() as i64 {
                if is_item(d, pcx) {
                    (items[file_of_pos(pcx.defs[d as usize].start, pcx) as usize]) += 1;
                }
            }
            sort_desc(&mut files, &lines);
            let mut total: i64 = 0;
            let mut total_items: i64 = 0;
            let mut over: i64 = 0;
            let mut biggest: i64 = -1;
            for i in 0..files.len() as i64 {
                let f = (files[i as usize]);
                buf_int(out, (lines[f as usize]));
                buf_byte(out, b'\t');
                buf_int(out, (items[f as usize]));
                buf_byte(out, b'\t');
                buf_bytes(out, file_text(f, pcx));
                if (lines[f as usize]) > tcx.opt_over {
                    buf_str(out, c"\tover");
                    over += 1;
                    if biggest < 0 {
                        biggest = f;
                    }
                }
                buf_byte(out, b'\n');
                total += (lines[f as usize]);
                total_items += (items[f as usize]);
            }
            buf_int(out, total);
            buf_byte(out, b'\t');
            buf_int(out, total_items);
            buf_str(out, c"\ttotal\n");
            buf_write_fd(out, STDOUT);
            if over > 0 {
                let d = diag(c"note", c"query.over", tcx);
                buf_int(d, over);
                buf_str(d, if over == 1 { c" file over " } else { c" files over " });
                buf_int(d, tcx.opt_over);
                buf_str(d, c" lines\n");
                try_deps(pcx.files[biggest as usize].module, tcx.opt_over, tcx, pcx);
            }
            return 0;
        }
        // The items of a module or a file.
        let t = c_slice(name);
        let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
        if is_file_name(t) {
            files_named(t, &mut files, pcx);
        } else {
            find_modules(t, false, &mut modules, tcx, pcx);
        }
        if files.len() as i64 == 0 && modules.len() as i64 == 0 {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_str(d, if is_file_name(t) { c"no file '" } else { c"no module '" });
            buf_bytes(d, t);
            buf_str(d, c"' in the program\n");
            let o = try_begin(c"stats", t, false, tcx, pcx);
            try_end(o);
            return 1;
        }
        let mut status: i64 = 0;
        for i in 0..files.len() as i64 {
            status = stats_of(out, (files[i as usize]), -1, tcx, pcx);
        }
        for i in 0..modules.len() as i64 {
            status = stats_of(out, -1, (modules[i as usize]), tcx, pcx);
        }
        buf_write_fd(out, STDOUT);
        status
    }
}

// The items of file f (or module m), largest first: `LINES<TAB>KIND<TAB>PATH`
// under `# PATH<TAB>FILE<TAB>N lines<TAB>N items`.
fn stats_of(out: i64, f: i64, m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut items: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut lines = zeros(pcx.defs.len() as i64 + 1);
        for d in 0..pcx.defs.len() as i64 {
            if !is_item(d, pcx) {
                continue;
            }
            if (f >= 0 && file_of_pos(pcx.defs[d as usize].start, pcx) == f)
                || (m >= 0 && pcx.defs[d as usize].module == m) {
                items.push(d);
                (lines[d as usize]) = def_lines(d, pcx);
            }
        }
        sort_desc(&mut items, &lines);
        let file = if f >= 0 { f } else { module_file(m, pcx) };
        buf_str(out, c"# ");
        if m >= 0 {
            buf_bytes(out, mod_fqn_text(m, tcx, pcx));
            buf_byte(out, b'\t');
        }
        if file >= 0 {
            buf_bytes(out, file_text(file, pcx));
            buf_byte(out, b'\t');
            buf_int(out, file_lines(file, pcx));
            buf_str(out, c" lines\t");
        }
        buf_int(out, items.len() as i64);
        buf_str(out, c" items\n");
        let shown = if !tcx.opt_all && items.len() as i64 > REFS_BUDGET { REFS_BUDGET }
            else { items.len() as i64 };
        for i in 0..shown {
            let d = (items[i as usize]);
            buf_int(out, (lines[d as usize]));
            buf_byte(out, b'\t');
            buf_str(out, kind_name(pcx.defs[d as usize].kind));
            buf_byte(out, b'\t');
            put_local(out, d, pcx.defs[d as usize].module, tcx, pcx);
            buf_byte(out, b'\n');
        }
        if shown < items.len() as i64 {
            let d = diag(c"note", c"query.truncated", tcx);
            buf_str(d, c"showing the ");
            buf_int(d, shown);
            buf_str(d, c" largest of ");
            buf_int(d, items.len() as i64);
            buf_str(d, c" items\n");
            let o = try_begin(c"stats",
                if m >= 0 { mod_fqn_text(m, tcx, pcx) } else { file_text(f, pcx) }, true, tcx,
                pcx);
            buf_str(o, c" --all");
            try_end(o);
        }
        0
    }
}

// `try: PROG query deps MODULE --max-lines N`.
fn try_deps(m: i64, n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let o = try_begin(c"deps", mod_fqn_text(m, tcx, pcx), true, tcx, pcx);
    buf_str(o, c" --max-lines ");
    buf_int(o, n);
    try_end(o);
}

// ---- unused ----

// Whether definition d is one `unused` leaves out: main, C's (extern "C"
// declarations and `extern "C" fn` definitions), trait impls' functions
// (called through the trait), trait functions, modules, std's and the C
// headers'.
fn always_used(d: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    if k == K_MOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
        || !user_file(file_of_pos(pcx.defs[d as usize].start, pcx), pcx) {
        return true;
    }
    let m = pcx.defs[d as usize].module;
    if within_std(m, pcx) || m == pcx.c_module {
        return true;
    }
    let node = pcx.defs[d as usize].node;
    if pcx.nodes[node as usize].kind == NodeKind::ExternFn {
        return true;
    }
    if pcx.nodes[node as usize].kind == NodeKind::Fn {
        if pcx.defs[d as usize].name == pcx.main_sym && pcx.defs[d as usize].parent < 0 && m == 0 {
            return true;
        }
        let f = pcx.nodes[node as usize].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 && pcx.fns[f as usize].export {
            return true;
        }
    }
    if pcx.defs[d as usize].parent >= 0 && always_used(pcx.defs[d as usize].parent, pcx)
        && pcx.defs[pcx.defs[d as usize].parent as usize].kind == K_TRAIT_FN {
        return true;
    }
    false
}

// `query unused [MODULE]`: the definitions nothing refers to (but their
// own `use` lines, and themselves), and the imports nothing in their file
// names: `PATH<TAB>FILE:LINE:COL<TAB>KIND`, in order.
pub fn query_unused(name: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
        if name != 0 as *mut u8 {
            let t = c_slice(name);
            if is_file_name(t) {
                files_named(t, &mut files, pcx);
            } else {
                find_modules(t, false, &mut modules, tcx, pcx);
            }
            if modules.len() as i64 == 0 && files.len() as i64 == 0 {
                let d = diag(c"error", c"query.no-match", tcx);
                buf_str(d, if is_file_name(t) { c"no file '" } else { c"no module '" });
                buf_bytes(d, t);
                buf_str(d, c"' in the program\n");
                let o = try_begin(c"unused", t, false, tcx, pcx);
                try_end(o);
                return 1;
            }
        }
        let mut targets: Vec<i64, Comp> = Vec::new_in(Comp {});
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].fqn < 0 || always_used(d, pcx)
                || !selected(pcx.defs[d as usize].start, modules.as_slice(), files.as_slice(), pcx) {
                continue;
            }
            targets.push(d);
        }
        set_targets(targets.as_slice(), tcx, pcx);
        collect_refs(tcx, pcx);
        let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
        sorted_refs(&mut order, tcx, pcx);
        let mut used = falses(pcx.defs.len() as i64 + 1);
        for k in 0..order.len() as i64 {
            let r = (order[k as usize]);
            let flags = (tcx.r_flags[r as usize]);
            if (flags & QF_DEF) != 0
                || ((flags & QF_USE) != 0 && (flags & QF_CALL) == 0
                    && is_use_ref((tcx.r_pos[r as usize]), tcx, pcx)) {
                continue;
            }
            let d = (tcx.r_def[r as usize]);
            // (a function calling itself does not use itself)
            let e = enclosing((tcx.r_pos[r as usize]), tcx, pcx);
            if e == d {
                continue;
            }
            (used[d as usize]) = true;
        }
        // The results: definitions, then imports, by position.
        let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..targets.len() as i64 {
            let d = (targets[i as usize]);
            // (a field or variant of an unused item is not listed again)
            if !(used[d as usize])
                && !(pcx.defs[d as usize].parent >= 0
                    && !(used[pcx.defs[d as usize].parent as usize])
                    && is_target(pcx.defs[d as usize].parent, tcx)) {
                found.push(d);
            }
        }
        sort_by_position(&mut found, tcx, pcx);
        let mut imports: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut all_imports: Vec<i64, Comp> = Vec::new_in(Comp {});
        unused_imports(&mut all_imports, pcx);
        for i in 0..all_imports.len() as i64 {
            let id = (all_imports[i as usize]);
            if selected(pcx.nodes[id as usize].start, modules.as_slice(), files.as_slice(), pcx) {
                imports.push(id);
            }
        }
        let total = found.len() as i64 + imports.len() as i64;
        let out = buf_new();
        if total > REFS_BUDGET && !tcx.opt_all {
            // Per file: how many.
            let mut per = zeros(pcx.files.len() as i64 + 1);
            for i in 0..found.len() as i64 {
                (per[file_of_pos(pcx.defs[(found[i as usize]) as usize].start, pcx) as usize]) += 1;
            }
            for i in 0..imports.len() as i64 {
                (per[file_of_pos(pcx.nodes[(imports[i as usize]) as usize].start,
                    pcx) as usize]) += 1;
            }
            let mut biggest: i64 = -1;
            for f in 0..pcx.files.len() as i64 {
                if (per[f as usize]) > 0 {
                    buf_bytes(out, file_text(f, pcx));
                    buf_byte(out, b'\t');
                    buf_int(out, (per[f as usize]));
                    buf_byte(out, b'\n');
                    if biggest < 0 || (per[f as usize]) > (per[biggest as usize]) {
                        biggest = f;
                    }
                }
            }
            buf_write_fd(out, STDOUT);
            let d = diag(c"note", c"query.truncated", tcx);
            buf_int(d, total);
            buf_str(d, c" unused\n");
            try_query(c"unused", file_text(biggest, pcx), tcx, pcx);
            let o = try_begin(c"unused",
                if name != 0 as *mut u8 { c_slice(name) } else { b"" },
                name != 0 as *mut u8, tcx, pcx);
            buf_str(o, c" --all");
            try_end(o);
            return 0;
        }
        let mut i: i64 = 0;
        let mut j: i64 = 0;
        while i < found.len() as i64 || j < imports.len() as i64 {
            let take_def = j >= imports.len() as i64
                || (i < found.len() as i64
                    && pcx.defs[(found[i as usize]) as usize].name_pos
                    < pcx.nodes[(imports[j as usize]) as usize].start);
            if take_def {
                let d = (found[i as usize]);
                buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
                buf_byte(out, b'\t');
                put_loc(out, pcx.defs[d as usize].name_pos, pcx);
                buf_byte(out, b'\t');
                buf_str(out, kind_name(pcx.defs[d as usize].kind));
                i += 1;
            } else {
                let id = (imports[j as usize]);
                put_import(out, id, pcx);
                buf_byte(out, b'\t');
                put_loc(out, pcx.nodes[id as usize].start, pcx);
                buf_str(out, c"\timport");
                j += 1;
            }
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        if total == 0 {
            let d = diag(c"note", c"query.empty", tcx);
            buf_str(d, c"nothing unused\n");
        }
        0
    }
}

fn is_target(d: i64, tcx: &Tcx<Comp>) -> bool {
    tcx.refs_group.get(d + 1) != 0
}

// Whether the code at pos is in one of `modules` (0.17: or a child of
// one) or `files` (all when both are empty).
fn selected(pos: i64, modules: &[i64], files: &[i64], pcx: &mut Ctx<Comp>) -> bool {
    if modules.len() as i64 == 0 && files.len() as i64 == 0 {
        return true;
    }
    let mut m = module_at(pos, pcx);
    while m >= 0 {
        for i in 0..modules.len() as i64 {
            if (modules[i as usize]) == m {
                return true;
            }
        }
        m = if m > 0 { pcx.modules[m as usize].parent } else { -1 };
    }
    let f = file_of_pos(pos, pcx);
    for i in 0..files.len() as i64 {
        if (files[i as usize]) == f {
            return true;
        }
    }
    false
}

// Whether the reference at pos is in a `use` item.
fn is_use_ref(pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    enclosing(pos, tcx, pcx) < 0
}

// The path an import (Ident node id of a `use`) brings: `use PATH::NAME`.
fn put_import(out: i64, id: i64, pcx: &Ctx<Comp>) {
    // (the Use node holding id: the nearest one before it)
    let mut u = id - 1;
    while u > 0 && pcx.nodes[u as usize].kind != NodeKind::Use {
        u -= 1;
    }
    let path = pcx.nodes[u as usize].c;
    for i in 0..pcx.nodes[path as usize].count {
        buf_bytes(out, sym_text(pcx.nodes[crate::front::ast::child(path, i, pcx) as usize].a, pcx));
        buf_str(out, c"::");
    }
    buf_bytes(out, sym_text(pcx.nodes[id as usize].a, pcx));
    if pcx.nodes[id as usize].b != 0 {
        buf_str(out, c" as ");
        buf_bytes(out, sym_text(pcx.nodes[id as usize].b, pcx));
    }
}

// ---- impact ----

// `query impact NAME`: what a change of NAME's signature touches: its
// definition line, then per file the calls and other references to it
// and the functions they are in, its generic instances, and a total.
pub fn query_impact(matches: &[i64], name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    let mut calls: i64 = 0;
    let mut other: i64 = 0;
    let mut files: i64 = 0;
    for i in 0..matches.len() as i64 {
        let d = (matches[i as usize]);
        crate::tools::query::show::query_def_one(out, d, tcx, pcx);
    }
    set_targets(matches, tcx, pcx);
    collect_refs(tcx, pcx);
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    sorted_refs(&mut order, tcx, pcx);
    let mut k: i64 = 0;
    while k < order.len() as i64 {
        let f = file_of_pos((tcx.r_pos[(order[k as usize]) as usize]), pcx);
        let mut c: i64 = 0;
        let mut o: i64 = 0;
        let mut fns: Vec<i64, Comp> = Vec::new_in(Comp {});
        while k < order.len() as i64
            && file_of_pos((tcx.r_pos[(order[k as usize]) as usize]), pcx)
            == f {
            let r = (order[k as usize]);
            k += 1;
            if ((tcx.r_flags[r as usize]) & QF_DEF) != 0 {
                continue;
            }
            if ((tcx.r_flags[r as usize]) & QF_CALL) != 0 { c += 1; } else { o += 1; }
            let e = enclosing((tcx.r_pos[r as usize]), tcx, pcx);
            let sym = if e >= 0 { pcx.defs[e as usize].fqn }
                else { mod_fqn(module_at((tcx.r_pos[r as usize]), pcx), tcx, pcx) };
            crate::tools::query::diagnostics::push_once(&mut fns, sym);
        }
        if c + o == 0 {
            continue;
        }
        files += 1;
        calls += c;
        other += o;
        buf_bytes(out, file_text(f, pcx));
        buf_byte(out, b'\t');
        buf_int(out, c);
        buf_byte(out, b'\t');
        buf_int(out, o);
        buf_byte(out, b'\t');
        for x in 0..fns.len() as i64 {
            if x == 10 {
                buf_str(out, c" +");
                buf_int(out, fns.len() as i64 - 10);
                break;
            }
            if x > 0 {
                buf_byte(out, b' ');
            }
            put_short(out, (fns[x as usize]), pcx);
        }
        buf_byte(out, b'\n');
    }
    // Generic instances, and the functions implementing a trait's.
    let mut instances: i64 = 0;
    for i in 0..matches.len() as i64 {
        let d = (matches[i as usize]);
        let node = pcx.defs[d as usize].node;
        if pcx.nodes[node as usize].kind != NodeKind::Fn || pcx.nodes[node as usize].x <= 0 {
            continue;
        }
        let tf = pcx.nodes[node as usize].x - 1;
        let mut list: Vec<i64, Comp> = Vec::new_in(Comp {});
        for f in 0..pcx.fns.len() as i64 {
            if pcx.fns[f as usize].tmpl == tf + 1 {
                crate::tools::query::diagnostics::push_once(&mut list,
                    pcx.fns[f as usize].display);
            }
        }
        if list.len() as i64 == 0 {
            continue;
        }
        instances += list.len() as i64;
        buf_str(out, c"instances\t");
        buf_int(out, list.len() as i64);
        buf_byte(out, b'\t');
        for x in 0..list.len() as i64 {
            if x == 20 {
                buf_str(out, c" +");
                buf_int(out, list.len() as i64 - 20);
                break;
            }
            if x > 0 {
                buf_byte(out, b' ');
            }
            buf_bytes(out, sym_text((list[x as usize]), pcx));
        }
        buf_byte(out, b'\n');
    }
    let mut impls: i64 = 0;
    for x in 0..pcx.defs.len() as i64 {
        let g = tcx.refs_group.get(x + 1) - 1;
        if g >= 0 && (tcx.refs_targets[g as usize]) != x {
            if impls == 0 {
                buf_str(out, c"impls\t");
            } else {
                buf_byte(out, b' ');
            }
            put_short(out, pcx.defs[x as usize].fqn, pcx);
            impls += 1;
        }
    }
    if impls > 0 {
        buf_byte(out, b'\n');
    }
    buf_str(out, c"total\t");
    buf_int(out, calls);
    buf_byte(out, b'\t');
    buf_int(out, other);
    buf_byte(out, b'\t');
    buf_int(out, files);
    buf_str(out, if files == 1 { c" file" } else { c" files" });
    if instances > 0 {
        buf_str(out, c", ");
        buf_int(out, instances);
        buf_str(out, if instances == 1 { c" instance" } else { c" instances" });
    }
    if impls > 0 {
        buf_str(out, c", ");
        buf_int(out, impls);
        buf_str(out, if impls == 1 { c" impl" } else { c" impls" });
    }
    buf_byte(out, b'\n');
    buf_write_fd(out, STDOUT);
    let _ = name;
    0
}

// ---- lint ----

// `volec lint --max-lines N [ROOT]`: one error per file of more than N
// lines (`error lint.max-lines`, `try:` the deps of its module); exit 1
// when there is one.
pub fn run_lint(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = run_lint_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

// `lint`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn lint_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(option("max-lines", "N", "the most lines a file may have"));
    opts.push(option("root", "ROOT", "the program's root file"));
    Leaf::new(opts, "path")
}

fn run_lint_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let mut max: i64 = -1;
    let mut root = 0 as *mut u8;
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if is_opt(ev, "max-lines") {
            max = crate::tools::query::parse_count(a);
            continue;
        }
        if is_opt(ev, "root") {
            root = a;
            continue;
        }
        let dashed = ev.text.starts_with("-");
        if ev.kind != EV_WORD || dashed || root != 0 as *mut u8 {
            let d = diag(c"error", c"lint.usage", tcx);
            buf_str(d,
                if ev.kind != EV_WORD || dashed { c"unknown option '" }
                else { c"unexpected argument '" });
            buf_str(d, a);
            buf_str(d, c"'\n");
            let o = try_begin(c"lint --max-lines 1000", b"", false, tcx, pcx);
            try_end(o);
            return 2;
        }
        root = a;
    }
    unsafe {
        if max < 0 {
            let d = diag(c"error", c"lint.usage", tcx);
            buf_str(d, c"lint needs --max-lines N\n");
            let o = try_begin(c"lint --max-lines 1000", b"", false, tcx, pcx);
            try_end(o);
            return 2;
        }
        tcx.root_given = root;
        root = root_or_diag(root, c"lint", b"", false, tcx, pcx);
        if root == 0 as *mut u8 {
            return 2;
        }
        if !load_program(root, 0, tcx, pcx, wgx) {
            program_errors(c"error", root, true, tcx, pcx);
            return 1;
        }
        let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut lines = zeros(pcx.files.len() as i64 + 1);
        for f in 0..pcx.files.len() as i64 {
            // (a generated file, `// Generated by`, is its generator's: not linted)
            if user_file(f, pcx)
                && !generated(
                    &get_src()[
                        pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize]) {
                (lines[f as usize]) = file_lines(f, pcx);
                if (lines[f as usize]) > max {
                    files.push(f);
                }
            }
        }
        sort_desc(&mut files, &lines);
        for k in 0..files.len() as i64 {
            let f = (files[k as usize]);
            let d = diag(c"error", c"lint.max-lines", tcx);
            buf_bytes(d, file_text(f, pcx));
            buf_str(d, c": ");
            buf_int(d, (lines[f as usize]));
            buf_str(d, c" lines (at most ");
            buf_int(d, max);
            buf_str(d, c")\n");
            try_deps(pcx.files[f as usize].module, max, tcx, pcx);
        }
        if files.len() as i64 > 0 { 1 } else { 0 }
    }
}
