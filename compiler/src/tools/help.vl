volec refactor split MODULE --plan                a module into files (--auto, --into M --items a,b)\n\
volec refactor signature FN --add 'x: i64 = 0'    a parameter, every call (--remove, --rename-param, --reorder, --type)\n\
volec refactor field STRUCT --add 'g: i64 = 0'    a field, every literal (--remove, --rename, --type)\n\
volec refactor variant ENUM --add 'X(i64)' --arm 'EXPR'   a variant, every match (--remove, --rename)\n\
volec refactor extract-function FN --lines A-B --to NEW   lines into a new function\n\
