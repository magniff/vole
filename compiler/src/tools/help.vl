// `--help` on every command (0.15): `volec CMD [SUB] --help` prints
// the rows of the tools table (AGENTS.md, docs/query.md) for that
// command, at most 15 lines; `volec --help` lists the commands. The
// language is in `volec guide`, a diagnostic code in `volec
// explain CODE`.

use crate::base::{STDOUT, buf_bytes, buf_new, buf_write_fd};
use crate::cli::line::Line;

// One command's help: `cmd` is `edit` or `edit patch`.
struct Help { cmd: [u8], text: [u8] }

const HELP_COUNT: i64 = 42;

static HELP: [Help; 42] = [
    Help { cmd: "", text: "volec FILE.vl -o prog        compile (cc links); -c object, -S assembly\n\
volec FILE.vl x.c -lm -o prog  C files, objects, -l, -L: linked along\n\
volec run [DIR] [-- ARGS]        build DIR/main.vl (when it changed) and run it\n\
volec check [ROOT]               the front end's errors, one line each\n\
volec try 'STATEMENTS'           run a snippet with std: its value and output\n\
volec test [FILTER...]           build what changed, run the tests: counts, then the failures\n\
volec probe FILE:LINE EXPR...    values at a line as it runs; reduce: a smaller input (guide debug)\n\
volec query CMD NAME...          read a program by name (def, show, context, refs, grep...)\n\
volec edit CMD NAME ...          change items by name (patch, replace, insert, delete...); undo\n\
volec refactor CMD ...           rename, move, signature, field, variant, extract, inline\n\
volec rewrite 'OLD' 'NEW'        typed search and replace\n\
volec fix                        missing imports, unused, pub, unsafe blocks\n\
volec fmt FILE|MODULE|--all      lay code out\n\
volec guide [TOPIC|--find WORDS] the language; volec explain CODE: a diagnostic\n\
volec lsp: an editor's language server; lint, same-output, --version; CMD --help for each\n" },
    Help { cmd: "query", text: "volec query def|show NAME...            where it is defined | its source (--with-comments)\n\
volec query context NAME [--budget N]   source, calls, types, callers in one answer\n\
volec query refs|callers NAME           every use | every call (--count, --in FILE|MODULE|ITEM, --kind)\n\
volec query grep TEXT                   text that is not a name (--comments, --strings, --code, --word)\n\
volec query items [MODULE]              a module's items with signatures (--find W, --kind K, --names, --comments)\n\
volec query type FILE:LINE:COL          the type of an expression\n\
volec query text FILE:A-B               lines of any file (std:A-B: std's source)\n\
volec query stats|deps|unused|impact    sizes, dependencies, what nothing uses, what a change touches\n\
volec query diff                        what the last edit changed\n\
volec query similar NAME                the items like NAME, nearest first: templates for a new one\n\
volec query examples [KIND]             the items to start from when adding an X (guide how)\n\
volec query unsafe [FILE|std]           the unsafe sites: what each does, its class, its comments\n\
NAME: f, m::f, Type::method, Enum::Variant, Struct.field, FILE:LINE[:COL], std::f\n\
--budget N: answers cut to about N tokens (default 8000; context 2000); --root ROOT\n" },
    Help { cmd: "query unsafe", text: "volec query unsafe [FILE...|DIR|std]   every unsafe block, unsafe fn and extern block, one line each:\n\
  FILE:LINE, kind, item, class, justification, operations (std's too; --no-std: not)\n\
  class: ffi, alloc, intrinsic, transmute/cast, raw-pointer, static-mut, other; none (unneeded): nothing unsafe inside\n\
  (volec fix --only unneeded-unsafe takes those away)\n\
  --unjustified: the sites without // UNSAFE: and // SAFETY: right above; --summary: counts by class,\n\
  module, file; --json: one object a site. volec check warns: unsafe.unjustified\n" },
    Help { cmd: "edit", text: "volec edit patch NAME --old 'TEXT' --new 'TEXT'   change lines inside an item (pairs repeat)\n\
volec edit insert --in NAME --after 'ANCHOR' < text   add statements inside an item\n\
volec edit replace NAME < new.vl                  replace an item\n\
volec edit insert --after|--before NAME < item.vl  add an item\n\
volec edit delete NAME                              remove an item\n\
volec edit wrap NAME --in unsafe [--lines A-B]      wrap a body or lines in a block\n\
volec edit new-file PATH < text                     a new file with its mod line\n\
volec edit apply items.vl                         several items (several files), one checked edit\n\
--show: the diff after; --dry-run: the diff only; --no-check: write despite new errors\n" },
    Help { cmd: "edit patch", text: "volec edit patch NAME|FILE:LINE --old 'TEXT' --new 'TEXT' [--old ... --new ...]\n\
  several lines: --pairs FILE (or stdin), blocks <<<<<<< OLD / ======= / >>>>>>> NEW\n\
  dependent steps, one checked call: --in OTHER (a const too) before its pairs; @@ NAME or @@ FILE in --pairs\n\
  (with --old/--new too); an empty OLD inserts NEW above a FILE:LINE target's line\n\
  --loose: other indentation; --nth N, --all: an OLD that occurs several times; --show, --dry-run, --no-check\n\
  for hunks: an OLD of a few lines, found once (several lines at other indentation: matched as --loose,\n\
  note patch.loose); the same change everywhere: --all; a whole item: edit replace NAME < item.vl\n" },
    Help { cmd: "edit insert", text: "volec edit insert --after|--before NAME < item.vl     add an item\n\
volec edit insert --in NAME --after|--before 'ANCHOR' < text   add statements inside an item\n" },
    Help {
        cmd: "edit replace",
        text: "volec edit replace NAME < new.vl   replace an item (MODULE::use, MODULE::header too)\n",
    },
    Help { cmd: "edit delete", text: "volec edit delete NAME   remove an item\n" },
    Help { cmd: "edit wrap", text: "volec edit wrap NAME --in unsafe|loop [--lines A-B]   wrap a body or lines in a block, re-indented\n" },
    Help { cmd: "edit apply", text: "volec edit apply [FILE]   several items' new text in one checked edit (stdin without FILE)\n\
  blocks: @@ NAME (its new text), @@ new after|before NAME, @@ new in MODULE, @@ delete NAME,\n\
  @@ MODULE::use, @@ MODULE::header; or query show's output, changed\n\
