  --remove x, --rename-param a b, --reorder b,a, --type x T --default '$x as T'\n\
  --type x '&mut T' (0.17): the calls' &v become &mut v, a value v becomes &mut v (&T: &v; &mut [T]: v.as_mut_slice())\n\
  --convention x let|inout|sink (0.20): the parameter's convention, and each call's marker (inout: &v; let, sink: v);\n\
    --type x 'inout T' marks the calls too (0.19's spelling in a crate read in it: &T, &mut T, &mut v)\n" },
    Help { cmd: "refactor field", text: "volec refactor field STRUCT --add 'g: i64 = 0'   with every literal (--remove g, --rename g h, --type g T [--default '$g.as_slice()'])\n" },
    Help { cmd: "refactor variant", text: "volec refactor variant ENUM --add 'X(i64)' --arm 'EXPR'   an arm in each match (--arm-in FN 'EXPR'; --remove V; --rename V W)\n" },
    Help { cmd: "refactor extension", text: "volec refactor extension .vl .vl [ROOT|DIR|--all]   a program's (a folder's, the tree's) files renamed, as git mv\n\
