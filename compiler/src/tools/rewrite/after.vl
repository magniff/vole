// What a rewrite does after its sites (0.17): the imports it leaves
// unused removed, and the --where per type a refused rewrite suggests.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, get_bufs, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::tools::ctx::Tcx;
use crate::tools::edit::apply::put_command;
use crate::tools::fix::remove_use_names;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::put_word;
use crate::tools::query::positions::token_at;
use crate::tools::reexports::reached_through;
use crate::tools::refactor_mod::use_local;
use crate::tools::refactor_mod::cli::is_name_use;
use crate::tools::rewrite::parsed::pk;
use crate::tools::rewrite::pattern::checked_type;

// (0.17) The imports the rewritten sites leave unused (starts, ends:
// their spans; texts: their new text): a name of a `use` (not `pub use`)
// of a file with a site, written in that file outside the `use` before
// the rewrite but not after it (outside the sites, nor in their new
// text), is removed. The number removed.
pub fn drop_unused_imports(starts: IntVec, ends: IntVec, texts: IntVec, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut removed: i64 = 0;
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) || (pcx.nodes[u as usize].p & ITEM_PUBLIC) != 0 {
                continue;
            }
            let f = file_of_pos(pcx.nodes[u as usize].start, pcx);
            let mut here = false;
            for x in 0..starts.len() as i64 {
                if file_of_pos((starts[x as usize]), pcx) == f {
                    here = true;
                }
            }
            if !here {
                continue;
            }
            let mut unused = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for k in 0..pcx.nodes[u as usize].count {
                let name = use_local(child(u, k, pcx), pcx);
                let mut before: i64 = 0;
                let mut after: i64 = 0;
                let mut i = token_at(pcx.files[f as usize].start, pcx);
                while i < pcx.toks.len() as i64
                    && pcx.toks[i as usize].start < pcx.files[f as usize].end {
                    let s = pcx.toks[i as usize].start;
                    if pcx.toks[i as usize].kind == Tok::Ident
                        && pcx.toks[i as usize].value as i64 == name
                        && (s < pcx.nodes[u as usize].start || s >= pcx.nodes[u as usize].end) {
                        before += 1;
                        if !in_spans(s, starts, ends) {
                            after += 1;
                        }
                    }
                    i += 1;
                }
                if before == 0 || after > 0 || reached_through(module_of(u, pcx), name, pcx) {
                    continue;
                }
                let mut named = false;
                for x in 0..starts.len() as i64 {
                    if file_of_pos((starts[x as usize]), pcx) == f
                        && has_word(buf_slice((texts[x as usize])), sym_text(name, pcx)) {
                        named = true;
                    }
                }
                if !named {
                    unused.push(k);
                }
            }
            if unused.len() as i64 > 0 {
                removed += remove_use_names(u, unused, pcx);
            }
        }
        removed
    }
}

// The types of the holes of the site just matched, into SITE_TYPES.
pub fn note_site_types(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        for h in 0..tcx.h_sym.len() as i64 {
            let n = (tcx.b_node[h as usize]);
            if (tcx.h_type[h as usize]) >= 0 || n <= 0 || pk(n, pcx) == NodeKind::TyName
                || pk(n, pcx) == NodeKind::PatBind {
                continue;
            }
            let t = checked_type(n, tcx, pcx);
            if t <= 0 {
                continue;
            }
            // (0.28.0: as a type is written, `&mut String<Gpa>`; --where takes
            // it with or without its spaces)
            let key = buf_new();
            crate::front::types::buf_type(key, t, pcx);
            let mut k: i64 = 0;
            let mut seen = false;
            while k < tcx.site_types.len() as i64 {
                if (tcx.site_types[k as usize]) == h
                    && bytes_eq(buf_slice((tcx.site_types[(k + 1) as usize])),
                        buf_slice(key)) {
                    (tcx.site_types[(k + 2) as usize]) += 1;
                    seen = true;
                }
                k += 3;
            }
            if !seen {
                tcx.site_types.push(h);
                tcx.site_types.push(key);
                tcx.site_types.push(1);
            }
        }
    }
}

// For edit.breaks (BREAK_HINTS): a hole of several types at the sites
// gets a note and a `try:` with `--where` per type (3 at most): the
// replacement may fit the sites of one type only.
pub fn where_hints(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        for h in 0..tcx.h_sym.len() as i64 {
            let mut types: i64 = 0;
            let mut k: i64 = 0;
            while k < tcx.site_types.len() as i64 {
                if (tcx.site_types[k as usize]) == h {
                    types += 1;
                }
                k += 3;
            }
            if types < 2 {
                continue;
            }
            let name = buf_slice((tcx.h_name[h as usize]));
            buf_str(out, c"note ");
            buf_str(out, c"rewrite.where");
            buf_str(out, c": ");
            buf_bytes(out, name);
            buf_str(out, c" has ");
            buf_int(out, types);
            buf_str(out, c" types at the sites:");
            k = 0;
            let mut first = true;
            while k < tcx.site_types.len() as i64 {
                if (tcx.site_types[k as usize]) == h {
                    buf_str(out, if first { c" " } else { c", " });
                    first = false;
                    buf_bytes(out, buf_slice((tcx.site_types[(k + 1) as usize])));
                    buf_str(out, c" (");
                    buf_int(out, (tcx.site_types[(k + 2) as usize]));
                    buf_str(out,
                        if (tcx.site_types[(k + 2) as usize]) == 1 { c" site)" }
                        else { c" sites)" });
                }
                k += 3;
            }
            buf_str(out, c"; --where takes the ones the replacement fits\n");
            k = 0;
            let mut shown: i64 = 0;
            while k < tcx.site_types.len() as i64 {
                if (tcx.site_types[k as usize]) == h && shown < 3 {
                    put_command(out, tcx, pcx);
                    buf_str(out, c" --where");
                    let w = buf_new();
                    buf_bytes(w, name);
                    buf_str(w, c": ");
                    buf_bytes(w, buf_slice((tcx.site_types[(k + 1) as usize])));
                    put_word(out, buf_slice(w));
                    buf_byte(out, b'\n');
                    shown += 1;
                }
                k += 3;
            }
        }
        if (*get_bufs().add(out as usize)).len > 0 {
            tcx.break_hints = out;
        }
    }
}

// Whether pos is in one of the spans [starts[i], ends[i]).
fn in_spans(pos: i64, starts: IntVec, ends: IntVec) -> bool {
    unsafe {
        for i in 0..starts.len() as i64 {
            if (starts[i as usize]) <= pos && pos < (ends[i as usize]) {
                return true;
            }
        }
        false
    }
}

// Whether text has word w (not part of a longer identifier).
fn has_word(text: &[u8], w: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + w.len() as i64 <= text.len() as i64 {
        if bytes_eq(&text[i as usize..(i + w.len() as i64) as usize], w)
            && (i == 0 || !ident_byte(text[(i - 1) as usize]))
            && (i + w.len() as i64 == text.len() as i64
                || !ident_byte(text[(i + w.len() as i64) as usize])) {
            return true;
        }
        i += 1;
    }
    false
}

fn ident_byte(c: u8) -> bool {
    c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
}
