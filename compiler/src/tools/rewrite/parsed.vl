// Reading the program's nodes as the parser made them (rewrite and the
// shape refactorings work on them): their fields, their tokens, and how
// tightly an expression binds (where a replacement needs parentheses).

use crate::base::get_src;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, parsed_child};
use crate::front::lexer::Tok;
use crate::front::parser::exprs::{infix_left_bp, is_comparison};
use crate::tools::ctx::zeros;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::positions::token_at;

// ---- The program as parsed ----
//
// PARSED_NODES holds every node as the parser made it (the program's,
// then the pattern's and the replacement's): these read it.

pub fn pk(n: i64, pcx: &Ctx<Comp>) -> NodeKind {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).kind }
}

pub fn pa(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).a }
}

pub fn pb(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).b }
}

pub fn pc(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).c }
}

pub fn pd(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).d }
}

pub fn pg(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).g }
}

pub fn ph(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).h }
}

pub fn pflags(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).p }
}

pub fn pop(n: i64, pcx: &Ctx<Comp>) -> Tok {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).op }
}

pub fn pcount(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).count }
}

pub fn pchild(n: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    parsed_child(n, i, pcx)
}

pub fn pstart(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).start }
}

pub fn pend(n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.parsed_nodes.add(n as usize)).end }
}

// Whether SRC[a0..a1) and SRC[b0..b1) have the same tokens (comments and
// spacing aside).
pub fn same_tokens(a0: i64, a1: i64, b0: i64, b1: i64, pcx: &Ctx<Comp>) -> bool {
    let mut i = token_at(a0, pcx);
    let mut j = token_at(b0, pcx);
    loop {
        let more_a = i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Tok::Eof
            && pcx.toks[i as usize].start < a1;
        let more_b = j < pcx.toks.len() as i64 && pcx.toks[j as usize].kind != Tok::Eof
            && pcx.toks[j as usize].start < b1;
        if !more_a || !more_b {
            return more_a == more_b;
        }
        if pcx.toks[i as usize].kind != pcx.toks[j as usize].kind
            || !bytes_eq(
                &get_src()[pcx.toks[i as usize].start as usize..pcx.toks[i as usize].end as usize],
                &get_src()[pcx.toks[j as usize].start as usize..pcx.toks[j as usize].end as usize]) {
            return false;
        }
        i += 1;
        j += 1;
    }
}

// Whether node n's text is in parentheses of its own: `(a + b)` (the
// parser widens a parenthesized expression's span to its parentheses).
pub fn parenthesized(n: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pk(n, pcx);
    if k == NodeKind::Tuple || k == NodeKind::Unit {
        return false;
    }
    let s = pstart(n, pcx);
    let e = pend(n, pcx);
    if e - s < 2 || get_src()[s as usize] != b'(' || get_src()[(e - 1) as usize] != b')' {
        return false;
    }
    let mut i = token_at(s, pcx);
    let mut depth: i64 = 0;
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < e {
        let t = pcx.toks[i as usize].kind;
        if t == Tok::LParen || t == Tok::LBracket || t == Tok::LBrace {
            depth += 1;
        } else if t == Tok::RParen || t == Tok::RBracket || t == Tok::RBrace {
            depth -= 1;
            if depth == 0 {
                return pcx.toks[i as usize].start == e - 1;
            }
        }
        i += 1;
    }
    false
}

// How tightly expression n binds (the binding power levels of
// docs/grammar.md): 1 an assignment, 2 a range, 3 to 11 the binary
// operators, 12 a cast, 13 a prefix operator, 99 a postfix expression,
// a primary or anything in parentheses; 0 `return`, `break`, a closure.
pub fn binding_level(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = pk(n, pcx);
    if parenthesized(n, pcx) {
        return 99;
    }
    if k == NodeKind::Binary {
        return infix_left_bp(pop(n, pcx)) / 2;
    }
    if k == NodeKind::Assign {
        return 1;
    }
    if k == NodeKind::Range {
        return 2;
    }
    if k == NodeKind::Cast {
        return 12;
    }
    if k == NodeKind::Unary {
        return 13;
    }
    // (0.14: a closure's body takes all that follows, as `return`'s value)
    if k == NodeKind::Return || k == NodeKind::Break || k == NodeKind::Continue
        || k == NodeKind::Closure {
        return 0;
    }
    99
}

// The expressions inside node n, each with the binding level an
// expression needs there to stand without parentheses.
pub fn expr_slots(n: i64, kids: &mut Vec<i64, Comp>, levels: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let k = pk(n, pcx);
    if k == NodeKind::Binary {
        let lv = infix_left_bp(pop(n, pcx)) / 2;
        kids.push(pb(n, pcx));
        levels.push(if is_comparison(pop(n, pcx)) { lv + 1 } else { lv });
        kids.push(pc(n, pcx));
        levels.push(lv + 1);
    } else if k == NodeKind::Assign {
        kids.push(pb(n, pcx));
        levels.push(13);
        kids.push(pc(n, pcx));
        levels.push(1);
    } else if k == NodeKind::Range {
        kids.push(pa(n, pcx));
        levels.push(3);
        kids.push(pb(n, pcx));
        levels.push(3);
    } else if k == NodeKind::Unary {
        kids.push(pb(n, pcx));
        levels.push(13);
    } else if k == NodeKind::Cast {
        kids.push(pa(n, pcx));
        levels.push(12);
    } else if k == NodeKind::Call || k == NodeKind::MethodCall {
        kids.push(pa(n, pcx));
        levels.push(99);
        for i in 0..pcount(n, pcx) {
            kids.push(pchild(n, i, pcx));
            levels.push(0);
        }
    } else if k == NodeKind::Index {
        kids.push(pa(n, pcx));
        levels.push(99);
        kids.push(pb(n, pcx));
        levels.push(0);
    } else if k == NodeKind::FieldAccess || k == NodeKind::TupleField
        || k == NodeKind::Try {
        kids.push(pa(n, pcx));
        levels.push(99);
    } else if k == NodeKind::NamedArg {
        // (0.15, as Try)
        kids.push(pb(n, pcx));
        levels.push(0);
    } else if k == NodeKind::Interp {
        for i in 0..pcount(n, pcx) {
            if pk(pchild(n, i, pcx), pcx) == NodeKind::InterpHole {
                kids.push(pa(pchild(n, i, pcx), pcx));
                levels.push(0);
            }
        }
    }
    else if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
        || k == NodeKind::Match {
        if k == NodeKind::Match {
            kids.push(pa(n, pcx));
            levels.push(0);
        }
        for i in 0..pcount(n, pcx) {
            kids.push(pchild(n, i, pcx));
            levels.push(0);
        }
    } else if k == NodeKind::Block {
        for i in 0..pcount(n, pcx) {
            kids.push(pchild(n, i, pcx));
            levels.push(0);
        }
        kids.push(pa(n, pcx));
        levels.push(0);
    } else if k == NodeKind::Closure {
        // (0.14: its body; its parameters are patterns)
        kids.push(pa(n, pcx));
        levels.push(0);
    } else if k == NodeKind::FieldInit || k == NodeKind::ExprStmt || k == NodeKind::Defer {
        kids.push(if k == NodeKind::FieldInit { pb(n, pcx) } else { pa(n, pcx) });
        levels.push(0);
    }
    else if k == NodeKind::Repeat || k == NodeKind::If || k == NodeKind::Let
        || k == NodeKind::Arm || k == NodeKind::While || k == NodeKind::For
        || k == NodeKind::Loop
        || k == NodeKind::Return
        || k == NodeKind::Break {
        // (a, b, c, d: the expressions of each, in order; a Let's
        // pattern and type, a loop's label are not)
        if k == NodeKind::Repeat || k == NodeKind::If || k == NodeKind::Return {
            kids.push(pa(n, pcx));
            levels.push(0);
        }
        if k == NodeKind::Repeat || k == NodeKind::If || k == NodeKind::Arm
            || k == NodeKind::While
            || k == NodeKind::Loop || k == NodeKind::Break {
            kids.push(pb(n, pcx));
            levels.push(0);
        }
        if k == NodeKind::If || k == NodeKind::Let || k == NodeKind::Arm || k == NodeKind::While
            || k == NodeKind::For {
            kids.push(pc(n, pcx));
            levels.push(0);
        }
        if k == NodeKind::For {
            kids.push(pd(n, pcx));
            levels.push(0);
        }
    }
}

// The level each node of first..last needs where it is (0 when it is in
// no expression of them), indexed by node.
pub fn slot_levels(first: i64, last: i64, pcx: &Ctx<Comp>) -> Vec<i64, Comp> {
    unsafe {
        let mut levels = zeros(pcx.parsed_count + 1);
        let mut kids: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut lv: Vec<i64, Comp> = Vec::new_in(Comp {});
        for n in first..last {
            kids.clear();
            lv.clear();
            expr_slots(n, &mut kids, &mut lv, pcx);
            for i in 0..kids.len() as i64 {
                let c = (kids[i as usize]);
                if c > 0 && c < pcx.parsed_count {
                    (levels[c as usize]) = (lv[i as usize]);
                }
            }
        }
        levels
    }
}
