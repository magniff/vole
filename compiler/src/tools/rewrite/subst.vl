// A rewrite's substitutions and new names (0.16; docs/refactor-shape.md):
//
//   --subst 'PATTERN' 'REPLACEMENT'   (repeated: in order)
//
// replaces each match of PATTERN inside the code a hole of the main
// pattern matched (the statements of a `$s...` above all) by REPLACEMENT,
// at each site the main replacement keeps that hole: PATTERN's holes
// already bound at the site must match the same code (`$v.data[$i]`
// matches only the site's $v and $i), its others bind afresh at each
// match, and --where types and names hold for them too. A hole of the
// main replacement that the pattern lacks is a new name, bound where the
// replacement binds it (`for $x in`, `let $x =`): its own name (`$x` is
// `x`), with a number when the site's item already has that name.
// `--list` prints a line per site instead of rewriting.

use crate::base::{SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::query::positions::{enclosing, line_of, line_start};
use crate::tools::query::refs::file_text;
use crate::tools::rewrite::parsed::{binding_level, parenthesized, pend, pk, pstart};
use crate::tools::rewrite::pattern::{hole_of, match_node, types_match};

// Substitution k's replacement node, its holes found in first..last.
pub fn note_subst_holes(k: i64, first: i64, last: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let r = tcx.s_rep.data[k];
        tcx.s_hfirst.push(tcx.s_holes.count);
        var n = 0;
        for q in first..last {
            if hole_of(q, tcx, pcx) >= 0 && pstart(q, pcx) >= pstart(r, pcx)
                && pend(q, pcx) <= pend(r, pcx) {
                // (by position)
                var j = tcx.s_holes.count;
                tcx.s_holes.push(q);
                while j > tcx.s_hfirst.data[k]
                    && pstart(tcx.s_holes.data[j - 1], pcx) > pstart(q, pcx) {
                    tcx.s_holes.data[j] = tcx.s_holes.data[j - 1];
                    j -= 1;
                }
                tcx.s_holes.data[j] = q;
                n += 1;
            }
        }
        tcx.s_hcount.push(n);
    }
}

// Whether the name sym is written in SRC[from..to).
fn name_in(sym: i64, from: i64, to: i64, pcx: Ctx<Comp>) -> bool {
    var i = crate::tools::query::positions::token_at(from, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i].start < to {
        if pcx.toks[i].kind == Tok::Ident && pcx.toks[i].value as i64 == sym {
            return true;
        }
        i += 1;
    }
    false
}

// The new names of the site from..to: each fresh hole's own name, or
// with 2, 3... added, so as not to be a name of the item holding it.
pub fn choose_fresh(from: i64, to: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let d = enclosing(from, tcx, pcx);
        let a = if d >= 0 { pcx.defs[d].start } else { from };
        let b = if d >= 0 { pcx.defs[d].end } else { to };
        for h in 0..tcx.h_sym.count {
            if tcx.h_fresh.data[h] == 0 {
                continue;
            }
            let base = buf_slice(tcx.h_name.data[h]);
            var k = 1;
            loop {
                let text = buf_new();
                buf_bytes(text, base[1..base.len]);
                if k > 1 {
                    buf_int(text, k);
                }
                var taken = name_in(intern(buf_slice(text)), a, b, pcx);
                for g in 0..h {
                    if tcx.h_fresh.data[g] != 0
                        && crate::tools::query::defs::bytes_eq(buf_slice(tcx.fresh_text.data[g]),
                            buf_slice(text)) {
                        taken = true;
                    }
                }
                if !taken {
                    tcx.fresh_text.data[h] = text;
                    break;
                }
                k += 1;
            }
        }
    }
}

// Substitution k's replacement at the match just made, into a buffer:
// its holes' texts, parenthesized where it needs.
fn subst_text(k: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let r = tcx.s_rep.data[k];
        let out = buf_new();
        var cur = pstart(r, pcx);
        for i in 0..tcx.s_hcount.data[k] {
            let q = tcx.s_holes.data[tcx.s_hfirst.data[k] + i];
            let h = hole_of(q, tcx, pcx);
            buf_bytes(out, SRC[cur..pstart(q, pcx)]);
            cur = pend(q, pcx);
            if tcx.h_fresh.data[h] != 0 {
                buf_bytes(out, buf_slice(tcx.fresh_text.data[h]));
                continue;
            }
            if tcx.b_node.data[h] == -3 {
                continue;
            }
            let wrap = tcx.h_rest.data[h] == 0 && tcx.b_node.data[h] >= 0
                && binding_level(tcx.b_node.data[h], pcx) < tcx.r_levels[q];
            if wrap {
                buf_byte(out, '(');
            }
            buf_bytes(out, SRC[tcx.pattern_b_start.data[h]..tcx.b_end.data[h]]);
            if wrap {
                buf_byte(out, ')');
            }
        }
        buf_bytes(out, SRC[cur..pend(r, pcx)]);
        out
    }
}

// The level substitution k's replacement has where it stands.
fn subst_level(k: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let r = tcx.s_rep.data[k];
        let h = hole_of(r, tcx, pcx);
        if h >= 0 {
            if tcx.h_fresh.data[h] != 0 || tcx.b_node.data[h] < 0 {
                return 99;
            }
            return binding_level(tcx.b_node.data[h], pcx);
        }
        binding_level(r, pcx)
    }
}

// The substitutions at the site just matched (SUB_START, SUB_END,
// SUB_TEXT): in the code of each hole the replacement keeps, every match
// of each --subst pattern, outermost first.
pub fn find_substs(program_end: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        tcx.sub_start.count = 0;
        tcx.sub_end.count = 0;
        tcx.sub_text.count = 0;
        if tcx.s_pat.count == 0 {
            return;
        }
        let misses = tcx.type_misses;
        let untyped = tcx.untyped;
        for h in 0..tcx.s_local {
            if tcx.r_kept.data[h] == 0 || tcx.h_fresh.data[h] != 0 || tcx.b_node.data[h] == -3
                || tcx.pattern_b_start.data[h] < 0 {
                continue;
            }
            let a = tcx.pattern_b_start.data[h];
            let b = tcx.b_end.data[h];
            for k in 0..tcx.s_pat.count {
                let p = tcx.s_pat.data[k];
                let kind = pk(p, pcx);
                for m in 1..program_end {
                    if pk(m, pcx) != kind || pstart(m, pcx) < a || pend(m, pcx) > b {
                        continue;
                    }
                    for g in tcx.s_local..tcx.h_sym.count {
                        if tcx.h_fresh.data[g] == 0 {
                            tcx.b_node.data[g] = -1;
                        }
                    }
                    if !match_node(p, m, &tcx, pcx) || !types_match(&tcx, pcx) {
                        continue;
                    }
                    var from = pstart(m, pcx);
                    var to = pend(m, pcx);
                    var text = subst_text(k, tcx, pcx);
                    if parenthesized(m, pcx) {
                        from += 1;
                        to -= 1;
                    } else if subst_level(k, tcx, pcx) < tcx.p_levels[m] {
                        let w = buf_new();
                        buf_byte(w, '(');
                        buf_bytes(w, buf_slice(text));
                        buf_byte(w, ')');
                        text = w;
                    }
                    add_sub(from, to, text, &tcx);
                }
            }
        }
        for g in tcx.s_local..tcx.h_sym.count {
            if tcx.h_fresh.data[g] == 0 {
                tcx.b_node.data[g] = -1;
            }
        }
        tcx.type_misses = misses;
        tcx.untyped = untyped;
    }
}

// A substitution of from..to by text, unless one already holds it; one
// it holds goes (outermost first).
fn add_sub(from: i64, to: i64, text: i64, tcx: inout Tcx<Comp>) {
    unsafe {
        var i = 0;
        while i < tcx.sub_start.count {
            let s = tcx.sub_start.data[i];
            let e = tcx.sub_end.data[i];
            if s <= from && to <= e {
                return;
            }
            if from <= s && e <= to {
                tcx.sub_start.data[i] = tcx.sub_start.data[tcx.sub_start.count - 1];
                tcx.sub_end.data[i] = tcx.sub_end.data[tcx.sub_end.count - 1];
                tcx.sub_text.data[i] = tcx.sub_text.data[tcx.sub_text.count - 1];
                tcx.sub_start.count -= 1;
                tcx.sub_end.count -= 1;
                tcx.sub_text.count -= 1;
                continue;
            }
            i += 1;
        }
        // (by position)
        tcx.sub_start.push(from);
        tcx.sub_end.push(to);
        tcx.sub_text.push(text);
        var j = tcx.sub_start.count - 1;
        while j > 0 && tcx.sub_start.data[j - 1] > from {
            tcx.sub_start.data[j] = tcx.sub_start.data[j - 1];
            tcx.sub_end.data[j] = tcx.sub_end.data[j - 1];
            tcx.sub_text.data[j] = tcx.sub_text.data[j - 1];
            j -= 1;
        }
        tcx.sub_start.data[j] = from;
        tcx.sub_end.data[j] = to;
        tcx.sub_text.data[j] = text;
    }
}

// `--list`: the line of the site at pos: `FILE:LINE:COL`, then each hole
// of the pattern and what it matched (`$x=text`, spaces and lines made
// one space, cut at 60 bytes), TAB-separated.
pub fn put_site(out: i64, pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        buf_bytes(out, file_text(file_of_pos(pos)));
        buf_byte(out, ':');
        buf_int(out, line_of(pos, pcx));
        buf_byte(out, ':');
        buf_int(out, pos - line_start(pos, pcx) + 1);
        for h in 0..tcx.s_local {
            if tcx.h_fresh.data[h] != 0 || tcx.b_node.data[h] == -1 {
                continue;
            }
            buf_byte(out, '\t');
            buf_bytes(out, buf_slice(tcx.h_name.data[h]));
            if tcx.h_rest.data[h] != 0 {
                buf_str(out, c"...");
            }
            buf_byte(out, '=');
            if tcx.b_node.data[h] == -3 {
                continue;
            }
            let t = SRC[tcx.pattern_b_start.data[h]..tcx.b_end.data[h]];
            var n = 0;
            var space = false;
            for i in 0..t.len {
                let c = t[i];
                if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
                    space = true;
                    continue;
                }
                if n >= 60 {
                    buf_byte(out, 226 as u8);
                    buf_byte(out, 128 as u8);
                    buf_byte(out, 166 as u8);
                    break;
                }
                if space && n > 0 {
                    buf_byte(out, ' ');
                    n += 1;
                }
                space = false;
                buf_byte(out, c);
                n += 1;
            }
        }
        buf_byte(out, '\n');
    }
}
