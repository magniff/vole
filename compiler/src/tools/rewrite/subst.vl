// A rewrite's substitutions and new names (0.16; docs/refactor-shape.md):
//
//   --subst 'PATTERN' 'REPLACEMENT'   (repeated: in order)
//
// replaces each match of PATTERN inside the code a hole of the main
// pattern matched (the statements of a `$s...` above all) by REPLACEMENT,
// at each site the main replacement keeps that hole: PATTERN's holes
// already bound at the site must match the same code (`$v.data[$i]`
// matches only the site's $v and $i), its others bind afresh at each
// match, and --where types and names hold for them too. A hole of the
// main replacement that the pattern lacks is a new name, bound where the
// replacement binds it (`for $x in`, `let $x =`): its own name (`$x` is
// `x`), with a number when the site's item already has that name.
// `--list` prints a line per site instead of rewriting.

use crate::base::{get_src, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::query::positions::{enclosing, line_of, line_start};
use crate::tools::query::refs::file_text;
use crate::tools::rewrite::parsed::{binding_level, parenthesized, pend, pk, pstart};
use crate::tools::rewrite::pattern::{hole_of, match_node, types_match};

// Substitution k's replacement node, its holes found in first..last.
pub fn note_subst_holes(k: i64, first: i64, last: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let r = (*tcx.s_rep.data.add(k as usize));
        tcx.s_hfirst.push(tcx.s_holes.count);
        let mut n: i64 = 0;
        for q in first..last {
            if hole_of(q, tcx, pcx) >= 0 && pstart(q, pcx) >= pstart(r, pcx)
                && pend(q, pcx) <= pend(r, pcx) {
                // (by position)
                let mut j = tcx.s_holes.count;
                tcx.s_holes.push(q);
                while j > (*tcx.s_hfirst.data.add(k as usize))
                    && pstart((*tcx.s_holes.data.add((j - 1) as usize)), pcx) > pstart(q, pcx) {
                    (*tcx.s_holes.data.add(j as usize)) = (*tcx.s_holes.data.add((j - 1) as usize));
                    j -= 1;
                }
                (*tcx.s_holes.data.add(j as usize)) = q;
                n += 1;
            }
        }
        tcx.s_hcount.push(n);
    }
}

// Whether the name sym is written in SRC[from..to).
fn name_in(sym: i64, from: i64, to: i64, pcx: &Ctx<Comp>) -> bool {
    let mut i = crate::tools::query::positions::token_at(from, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < to {
        if pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == sym {
            return true;
        }
        i += 1;
    }
    false
}

// The new names of the site from..to: each fresh hole's own name, or
// with 2, 3... added, so as not to be a name of the item holding it.
pub fn choose_fresh(from: i64, to: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let d = enclosing(from, tcx, pcx);
        let a = if d >= 0 { pcx.defs[d as usize].start } else { from };
        let b = if d >= 0 { pcx.defs[d as usize].end } else { to };
        for h in 0..tcx.h_sym.count {
            if (*tcx.h_fresh.data.add(h as usize)) == 0 {
                continue;
            }
            let base = buf_slice((*tcx.h_name.data.add(h as usize)));
            let mut k: i64 = 1;
            loop {
                let text = buf_new();
                buf_bytes(text, &base[1..base.len()]);
                if k > 1 {
                    buf_int(text, k);
                }
                let mut taken = name_in(intern(buf_slice(text), pcx), a, b, pcx);
                for g in 0..h {
                    if (*tcx.h_fresh.data.add(g as usize)) != 0
                        && crate::tools::query::defs::bytes_eq(buf_slice((*tcx.fresh_text.data.add(g as usize))),
                            buf_slice(text)) {
                        taken = true;
                    }
                }
                if !taken {
                    (*tcx.fresh_text.data.add(h as usize)) = text;
                    break;
                }
                k += 1;
            }
        }
    }
}

// Substitution k's replacement at the match just made, into a buffer:
// its holes' texts, parenthesized where it needs.
fn subst_text(k: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let r = (*tcx.s_rep.data.add(k as usize));
        let out = buf_new();
        let mut cur = pstart(r, pcx);
        for i in 0..(*tcx.s_hcount.data.add(k as usize)) {
            let q = (*tcx.s_holes.data.add(((*tcx.s_hfirst.data.add(k as usize)) + i) as usize));
            let h = hole_of(q, tcx, pcx);
            buf_bytes(out, &get_src()[cur as usize..pstart(q, pcx) as usize]);
            cur = pend(q, pcx);
            if (*tcx.h_fresh.data.add(h as usize)) != 0 {
                buf_bytes(out, buf_slice((*tcx.fresh_text.data.add(h as usize))));
                continue;
            }
            if (*tcx.b_node.data.add(h as usize)) == -3 {
                continue;
            }
            let wrap = (*tcx.h_rest.data.add(h as usize)) == 0 && (*tcx.b_node.data.add(h as usize)) >= 0
                && binding_level((*tcx.b_node.data.add(h as usize)), pcx) < (*tcx.r_levels.add(q as usize));
            if wrap {
                buf_byte(out, b'(');
            }
            buf_bytes(out, &get_src()[(*tcx.pattern_b_start.data.add(h as usize)) as usize..(*tcx.b_end.data.add(h as usize)) as usize]);
            if wrap {
                buf_byte(out, b')');
            }
        }
        buf_bytes(out, &get_src()[cur as usize..pend(r, pcx) as usize]);
        out
    }
}

// The level substitution k's replacement has where it stands.
fn subst_level(k: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let r = (*tcx.s_rep.data.add(k as usize));
        let h = hole_of(r, tcx, pcx);
        if h >= 0 {
            if (*tcx.h_fresh.data.add(h as usize)) != 0 || (*tcx.b_node.data.add(h as usize)) < 0 {
                return 99;
            }
            return binding_level((*tcx.b_node.data.add(h as usize)), pcx);
        }
        binding_level(r, pcx)
    }
}

// The substitutions at the site just matched (SUB_START, SUB_END,
// SUB_TEXT): in the code of each hole the replacement keeps, every match
// of each --subst pattern, outermost first.
pub fn find_substs(program_end: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        tcx.sub_start.count = 0;
        tcx.sub_end.count = 0;
        tcx.sub_text.count = 0;
        if tcx.s_pat.count == 0 {
            return;
        }
        let misses = tcx.type_misses;
        let untyped = tcx.untyped;
        for h in 0..tcx.s_local {
            if (*tcx.r_kept.data.add(h as usize)) == 0 || (*tcx.h_fresh.data.add(h as usize)) != 0 || (*tcx.b_node.data.add(h as usize)) == -3
                || (*tcx.pattern_b_start.data.add(h as usize)) < 0 {
                continue;
            }
            let a = (*tcx.pattern_b_start.data.add(h as usize));
            let b = (*tcx.b_end.data.add(h as usize));
            for k in 0..tcx.s_pat.count {
                let p = (*tcx.s_pat.data.add(k as usize));
                let kind = pk(p, pcx);
                for m in 1..program_end {
                    if pk(m, pcx) != kind || pstart(m, pcx) < a || pend(m, pcx) > b {
                        continue;
                    }
                    for g in tcx.s_local..tcx.h_sym.count {
                        if (*tcx.h_fresh.data.add(g as usize)) == 0 {
                            (*tcx.b_node.data.add(g as usize)) = -1;
                        }
                    }
                    if !match_node(p, m, tcx, pcx) || !types_match(tcx, pcx) {
                        continue;
                    }
                    let mut from = pstart(m, pcx);
                    let mut to = pend(m, pcx);
                    let mut text = subst_text(k, tcx, pcx);
                    if parenthesized(m, pcx) {
                        from += 1;
                        to -= 1;
                    } else if subst_level(k, tcx, pcx) < (*tcx.p_levels.add(m as usize)) {
                        let w = buf_new();
                        buf_byte(w, b'(');
                        buf_bytes(w, buf_slice(text));
                        buf_byte(w, b')');
                        text = w;
                    }
                    add_sub(from, to, text, tcx);
                }
            }
        }
        for g in tcx.s_local..tcx.h_sym.count {
            if (*tcx.h_fresh.data.add(g as usize)) == 0 {
                (*tcx.b_node.data.add(g as usize)) = -1;
            }
        }
        tcx.type_misses = misses;
        tcx.untyped = untyped;
    }
}

// A substitution of from..to by text, unless one already holds it; one
// it holds goes (outermost first).
fn add_sub(from: i64, to: i64, text: i64, tcx: &mut Tcx<Comp>) {
    unsafe {
        let mut i: i64 = 0;
        while i < tcx.sub_start.count {
            let s = (*tcx.sub_start.data.add(i as usize));
            let e = (*tcx.sub_end.data.add(i as usize));
            if s <= from && to <= e {
                return;
            }
            if from <= s && e <= to {
                (*tcx.sub_start.data.add(i as usize)) = (*tcx.sub_start.data.add((tcx.sub_start.count - 1) as usize));
                (*tcx.sub_end.data.add(i as usize)) = (*tcx.sub_end.data.add((tcx.sub_end.count - 1) as usize));
                (*tcx.sub_text.data.add(i as usize)) = (*tcx.sub_text.data.add((tcx.sub_text.count - 1) as usize));
                tcx.sub_start.count -= 1;
                tcx.sub_end.count -= 1;
                tcx.sub_text.count -= 1;
                continue;
            }
            i += 1;
        }
        // (by position)
        tcx.sub_start.push(from);
        tcx.sub_end.push(to);
        tcx.sub_text.push(text);
        let mut j = tcx.sub_start.count - 1;
        while j > 0 && (*tcx.sub_start.data.add((j - 1) as usize)) > from {
            (*tcx.sub_start.data.add(j as usize)) = (*tcx.sub_start.data.add((j - 1) as usize));
            (*tcx.sub_end.data.add(j as usize)) = (*tcx.sub_end.data.add((j - 1) as usize));
            (*tcx.sub_text.data.add(j as usize)) = (*tcx.sub_text.data.add((j - 1) as usize));
            j -= 1;
        }
        (*tcx.sub_start.data.add(j as usize)) = from;
        (*tcx.sub_end.data.add(j as usize)) = to;
        (*tcx.sub_text.data.add(j as usize)) = text;
    }
}

// `--list`: the line of the site at pos: `FILE:LINE:COL`, then each hole
// of the pattern and what it matched (`$x=text`, spaces and lines made
// one space, cut at 60 bytes), TAB-separated.
pub fn put_site(out: i64, pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        buf_bytes(out, file_text(file_of_pos(pos, pcx), pcx));
        buf_byte(out, b':');
        buf_int(out, line_of(pos, pcx));
        buf_byte(out, b':');
        buf_int(out, pos - line_start(pos, pcx) + 1);
        for h in 0..tcx.s_local {
            if (*tcx.h_fresh.data.add(h as usize)) != 0 || (*tcx.b_node.data.add(h as usize)) == -1 {
                continue;
            }
            buf_byte(out, b'\t');
            buf_bytes(out, buf_slice((*tcx.h_name.data.add(h as usize))));
            if (*tcx.h_rest.data.add(h as usize)) != 0 {
                buf_str(out, c"...");
            }
            buf_byte(out, b'=');
            if (*tcx.b_node.data.add(h as usize)) == -3 {
                continue;
            }
            let t = &get_src()[(*tcx.pattern_b_start.data.add(h as usize)) as usize..(*tcx.b_end.data.add(h as usize)) as usize];
            let mut n: i64 = 0;
            let mut space = false;
            for i in 0..t.len() {
                let c = t[i];
                if c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' {
                    space = true;
                    continue;
                }
                if n >= 60 {
                    buf_byte(out, 226 as u8);
                    buf_byte(out, 128 as u8);
                    buf_byte(out, 166 as u8);
                    break;
                }
                if space && n > 0 {
                    buf_byte(out, b' ');
                    n += 1;
                }
                space = false;
                buf_byte(out, c);
                n += 1;
            }
        }
        buf_byte(out, b'\n');
    }
}
