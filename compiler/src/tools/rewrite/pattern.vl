// A rewrite's pattern and replacement: their holes (`$x`, `$x...`, the
// --where types), parsed as vole; the matching of the pattern against a
// node, with the types the checker gave; and a site's replacement text.

use crate::base::{
    BUFS, SRC, _setjmp, add_source, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{errors_forget, errors_mark, recover_enter, recover_leave};
use crate::front::ast::{NODES, NodeKind, keep_parsed};
use crate::front::lexer::lex_range;
use crate::front::parser::parse_fragment;
use crate::front::types::buf_type;
use crate::tools::ctx::Tcx;
use crate::tools::query::c_slice;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::is_space;
use crate::tools::rewrite::parsed::{
    binding_level, pa, pb, pc, pchild, pcount, pd, pend, pflags, pg, ph, pk, pop, pstart,
    same_tokens,
};
use crate::tools::rewrite::regex::{re_search, re_valid};

// ---- Holes ----

pub fn is_name_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

pub fn hole_named(name: [u8], rest: bool, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        for h in 0..tcx.h_sym.count {
            if bytes_eq(buf_slice(tcx.h_name.data[h]), name) && (tcx.h_rest.data[h] != 0) == rest {
                return h;
            }
        }
        -1
    }
}

// Writes `text` into buffer `out` with each hole an identifier; the
// pattern's holes are added (`add`), the replacement's must be the
// pattern's. False after the diagnostic.
pub fn holes_to_idents(text: *u8, out: i64, add: bool, tcx: inout Tcx<Comp>) -> bool {
    unsafe {
        let s = c_slice(text);
        var i = 0;
        while i < s.len as i64 {
            let c = s[i];
            if c == '"' || c == '\'' {
                // (a string or a character: as it is)
                buf_byte(out, c);
                i += 1;
                while i < s.len as i64 && s[i] != c {
                    if s[i] == '\\' && i + 1 < s.len as i64 {
                        buf_byte(out, s[i]);
                        i += 1;
                    }
                    buf_byte(out, s[i]);
                    i += 1;
                }
                if i < s.len as i64 {
                    buf_byte(out, s[i]);
                    i += 1;
                }
                continue;
            }
            if c != '$' {
                buf_byte(out, c);
                i += 1;
                continue;
            }
            var e = i + 1;
            while e < s.len as i64 && is_name_byte(s[e]) {
                e += 1;
            }
            if e == i + 1 {
                let d = diag(c"error", c"rewrite.pattern", &tcx);
                buf_str(d, c"'$' without a name in '");
                buf_bytes(d, s);
                buf_str(d, c"': holes are $name, or $name... for arguments\n");
                return false;
            }
            let name = s[i..e];
            let rest = e + 3 <= s.len as i64 && s[e] == '.' && s[e + 1] == '.' && s[e + 2] == '.';
            // (0.16: `$x~/re/`, a name matching re)
            var re = -1;
            var after_re = e;
            if !rest && e + 1 < s.len as i64 && s[e] == '~' && s[e + 1] == '/' {
                var j = e + 2;
                let text = buf_new();
                while j < s.len as i64 && s[j] != '/' {
                    if s[j] == '\\' && j + 1 < s.len as i64 && s[j + 1] == '/' {
                        j += 1;
                    }
                    buf_byte(text, s[j]);
                    j += 1;
                }
                if j >= s.len as i64 || !add || !re_valid(buf_slice(text)) {
                    let d = diag(c"error", c"rewrite.pattern", &tcx);
                    buf_bytes(d, name);
                    buf_str(d,
                        if !add { c"~/re/: a name hole's expression goes in the pattern\n" }
                        else { c"~/re/: write a regular expression between the slashes (^ $ . * + ? [a-z] \\d \\w)\n" });
                    return false;
                }
                re = text;
                after_re = j + 1;
            }
            let ident = buf_new();
            buf_str(ident, if rest { c"__vole_rest_" } else { c"__vole_hole_" });
            buf_bytes(ident, s[i + 1..e]);
            var h = hole_named(name, rest, tcx);
            if h < 0 {
                if hole_named(name, !rest, tcx) >= 0 {
                    let d = diag(c"error", c"rewrite.pattern", &tcx);
                    buf_bytes(d, name);
                    buf_str(d, c" is written both with and without '...'\n");
                    return false;
                }
                if !add && (!tcx.fresh_ok || rest) {
                    let d = diag(c"error", c"rewrite.unbound", &tcx);
                    buf_str(d, c"the replacement's ");
                    buf_bytes(d, name);
                    if rest {
                        buf_str(d, c"...");
                    }
                    buf_str(d, c" is not in the pattern\n");
                    return false;
                }
                h = tcx.h_sym.count;
                tcx.h_sym.push(intern(buf_slice(ident)));
                let nb = buf_new();
                buf_bytes(nb, name);
                tcx.h_name.push(nb);
                tcx.h_rest.push(rest as i64);
                tcx.h_type.push(-1);
                tcx.h_nameonly.push(0);
                tcx.h_re.push(-1);
                tcx.h_fresh.push(if add { 0 } else { 1 });
                tcx.fresh_text.push(-1);
            }
            if re >= 0 {
                tcx.h_nameonly.data[h] = 1;
                tcx.h_re.data[h] = re;
            }
            buf_bytes(out, buf_slice(ident));
            i = if rest { e + 3 } else { e };
            if re >= 0 {
                i = after_re;
            }
        }
        true
    }
}

// The hole node n is (an identifier, a type name or a binding of a
// hole), or -1.
pub fn hole_of(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if n <= 0 {
            return -1;
        }
        let k = pk(n, pcx);
        if k != NodeKind::Ident && k != NodeKind::TyName && k != NodeKind::PatBind {
            return -1;
        }
        if k == NodeKind::Ident && pg(n, pcx) != 0 {
            return -1;
        }
        let sym = pa(n, pcx);
        for h in 0..tcx.h_sym.count {
            if tcx.h_sym.data[h] == sym {
                return h;
            }
        }
        -1
    }
}

// (0.15) The elements of node n's list as matched: a block's statements
// and then its tail expression, when it has one; another node's list.
pub fn seq_len(n: i64, pcx: Ctx<Comp>) -> i64 {
    if pk(n, pcx) == NodeKind::Block && pa(n, pcx) != 0 { pcount(n, pcx) + 1 }
    else { pcount(n, pcx) }
}

pub fn seq_at(n: i64, i: i64, pcx: Ctx<Comp>) -> i64 {
    if i < pcount(n, pcx) { pchild(n, i, pcx) } else { pa(n, pcx) }
}

// The `$x...` hole element e of a list is (in a block, written as a
// statement `$s...;` or as the tail `$s...`), or -1.
pub fn rest_hole_of(e: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let x = if e > 0 && pk(e, pcx) == NodeKind::ExprStmt { pa(e, pcx) } else { e };
    let h = hole_of(x, tcx, pcx);
    if h >= 0 && unsafe { tcx.h_rest.data[h] } != 0 { h } else { -1 }
}

// Parses buffer `text` (the statements, `stmts`) after the program: its
// node, or 0 after the diagnostic (`what`: the pattern or the
// replacement).
pub fn parse_text(text: i64, stmts: bool, what: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let start = add_source(c"<rewrite>", text, &pcx);
        let first = pcx.toks.len() as i64;
        let mark = errors_mark(pcx);
        let depth = pcx.recover_depth;
        var n = 0;
        if _setjmp(recover_enter(&pcx)) == 0 {
            lex_range(start, start + BUFS[text].len, true, &pcx);
            n = parse_fragment(first, stmts, &pcx);
        } else {
            n = 0;
            let d = diag(c"error", c"rewrite.pattern", &tcx);
            buf_str(d, c"the ");
            buf_str(d, what);
            buf_str(d, c" is no vole ");
            buf_str(d, if stmts { c"statement" } else { c"expression" });
            buf_str(d, c": ");
            buf_bytes(d, buf_slice(pcx.err));
            buf_byte(d, '\n');
        }
        recover_leave(depth, &pcx);
        errors_forget(mark, &pcx);
        keep_parsed(&pcx);
        n
    }
}

// ---- Matching ----

fn has_hole(p: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        for i in 0..tcx.pat_holes.count {
            let h = tcx.pat_holes.data[i];
            if pstart(p, pcx) <= pstart(h, pcx) && pend(h, pcx) <= pend(p, pcx) {
                return true;
            }
        }
        false
    }
}

// The type of checked node n as written in --where (no spaces), into a
// new buffer.
pub fn type_key(t: i64) -> i64 {
    let out = buf_new();
    let text = buf_new();
    buf_type(text, t);
    let s = buf_slice(text);
    for i in 0..s.len {
        if s[i] != ' ' {
            buf_byte(out, s[i]);
        }
    }
    out
}

fn span_key(start: i64, end: i64, kind: NodeKind) -> i64 {
    ((start * 128 + kind as i64) * 65536 + (end - start) % 65536) + 1
}

pub fn note_clones(first: i64, last: i64, tcx: inout Tcx<Comp>) {
    for n in first..last {
        let key = span_key(NODES[n].start, NODES[n].end, NODES[n].kind);
        if NODES[n].ty > 0 && tcx.clones.get(key) == 0 {
            tcx.clones.put(key, n + 1);
        }
    }
}

// The type the checker gave node n (as parsed): its own, or in a generic
// function, its first instance's; 0 when it was not checked.
pub fn checked_type(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if NODES[n].ty > 0 {
        return NODES[n].ty;
    }
    var c = tcx.clones.get(span_key(pstart(n, pcx), pend(n, pcx), pk(n, pcx))) - 1;
    if c < 0 && pk(n, pcx) == NodeKind::MethodCall {
        c = tcx.clones.get(span_key(pstart(n, pcx), pend(n, pcx), NodeKind::Call)) - 1;
    }
    if c < 0 { 0 } else { NODES[c].ty }
}

// Hole h matches node n (a repeated hole: the same tokens as before).
// Its --where type is checked once the whole pattern matched
// (`types_match`).
fn bind(h: i64, n: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if tcx.h_rest.data[h] != 0 {
            return false;
        }
        if tcx.b_node.data[h] != -1 {
            return tcx.b_node.data[h] >= 0
                && same_tokens(tcx.pattern_b_start.data[h], tcx.b_end.data[h], pstart(n, pcx),
                    pend(n, pcx), pcx);
        }
        // (0.16: a name hole: an identifier or a path, its text matching
        // the hole's expression)
        if tcx.h_nameonly.data[h] != 0 {
            let k = pk(n, pcx);
            if k != NodeKind::Ident && k != NodeKind::Path && k != NodeKind::TyName
                && k != NodeKind::PatBind {
                return false;
            }
            if tcx.h_re.data[h] >= 0
                && !re_search(buf_slice(tcx.h_re.data[h]), SRC[pstart(n, pcx)..pend(n, pcx)]) {
                return false;
            }
        }
        tcx.b_node.data[h] = n;
        tcx.pattern_b_start.data[h] = pstart(n, pcx);
        tcx.b_end.data[h] = pend(n, pcx);
        true
    }
}

// Whether the holes of the site just matched have their --where types
// (counting the sites left out, for the notes).
pub fn types_match(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        for h in 0..tcx.h_sym.count {
            let n = tcx.b_node.data[h];
            if tcx.h_type.data[h] < 0 || n <= 0 || pk(n, pcx) == NodeKind::TyName
                || pk(n, pcx) == NodeKind::PatBind {
                continue;
            }
            let t = checked_type(n, tcx, pcx);
            if t <= 0 {
                tcx.untyped += 1;
                return false;
            }
            let key = type_key(t);
            if !bytes_eq(buf_slice(key), buf_slice(tcx.h_type.data[h])) {
                if tcx.type_misses == 0 {
                    tcx.miss_node = n;
                    tcx.miss_hole = h;
                    tcx.miss_type = t;
                }
                tcx.type_misses += 1;
                return false;
            }
        }
        true
    }
}

// Hole h (`$x...`) matches the elements from..to of node n's list. In a
// block (0.15) its text is all between the elements around them, the
// comments too, spaces trimmed.
fn bind_rest(h: i64, n: i64, from: i64, to: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var s = if from < to { pstart(seq_at(n, from, pcx), pcx) } else { -1 };
        var e = if from < to { pend(seq_at(n, to - 1, pcx), pcx) } else { -1 };
        if from < to && pk(n, pcx) == NodeKind::Block {
            s = if from > 0 { pend(seq_at(n, from - 1, pcx), pcx) } else { block_open(n, pcx) + 1 };
            e = if to < seq_len(n, pcx) { pstart(seq_at(n, to, pcx), pcx) }
                else { pend(n, pcx) - 1 };
            while s < e && is_space(SRC[s]) {
                s += 1;
            }
            while e > s && is_space(SRC[e - 1]) {
                e -= 1;
            }
        }
        if tcx.b_node.data[h] != -1 {
            if tcx.b_node.data[h] == -3 || from == to {
                return tcx.b_node.data[h] == -3 && from == to;
            }
            return same_tokens(tcx.pattern_b_start.data[h], tcx.b_end.data[h], s, e, pcx);
        }
        tcx.b_node.data[h] = if from < to { -2 } else { -3 };
        tcx.pattern_b_start.data[h] = s;
        tcx.b_end.data[h] = e;
        tcx.b_list.data[h] = n;
        true
    }
}

// The position of block n's `{` (after `unsafe`).
pub fn block_open(n: i64, pcx: Ctx<Comp>) -> i64 {
    var i = pstart(n, pcx);
    while i < pend(n, pcx) && (SRC[i]) != '{' {
        i += 1;
    }
    i
}

fn match_list(p: i64, n: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    let np = seq_len(p, pcx);
    let nn = seq_len(n, pcx);
    var v = -1;
    var vh = -1;
    for i in 0..np {
        let h = rest_hole_of(seq_at(p, i, pcx), tcx, pcx);
        if h >= 0 {
            v = i;
            vh = h;
            break;
        }
    }
    if v < 0 {
        if np != nn {
            return false;
        }
        for i in 0..np {
            if !match_node(seq_at(p, i, pcx), seq_at(n, i, pcx), &tcx, pcx) {
                return false;
            }
        }
        return true;
    }
    let after = np - v - 1;
    if nn < np - 1 {
        return false;
    }
    for i in 0..v {
        if !match_node(seq_at(p, i, pcx), seq_at(n, i, pcx), &tcx, pcx) {
            return false;
        }
    }
    for j in 0..after {
        if !match_node(seq_at(p, v + 1 + j, pcx), seq_at(n, nn - after + j, pcx), &tcx, pcx) {
            return false;
        }
    }
    bind_rest(vh, n, v, nn - after, &tcx, pcx)
}

// Whether pattern node p matches program node n (binding the holes).
pub fn match_node(p: i64, n: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if p == 0 || n == 0 {
        return p == n;
    }
    let h = hole_of(p, tcx, pcx);
    if h >= 0 {
        return bind(h, n, &tcx, pcx);
    }
    if !has_hole(p, tcx, pcx) {
        return same_tokens(pstart(p, pcx), pend(p, pcx), pstart(n, pcx), pend(n, pcx), pcx);
    }
    let k = pk(p, pcx);
    if k != pk(n, pcx) {
        return false;
    }
    if k == NodeKind::Binary || k == NodeKind::Assign {
        return pop(p, pcx) == pop(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx)
            && match_node(pc(p, pcx), pc(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Unary {
        return pop(p, pcx) == pop(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Cast || k == NodeKind::Index || k == NodeKind::Repeat {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx)
            && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Call {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx) && match_list(p, n, &tcx, pcx);
    }
    if k == NodeKind::MethodCall {
        return pb(p, pcx) == pb(n, pcx) && same_part(pg(p, pcx), pg(n, pcx), pcx)
            && match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx) && match_list(p, n, &tcx, pcx);
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return pb(p, pcx) == pb(n, pcx) && match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Tuple || k == NodeKind::Array {
        return match_list(p, n, &tcx, pcx);
    }
    if k == NodeKind::Range {
        return pc(p, pcx) == pc(n, pcx) && match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx)
            && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Return || k == NodeKind::Defer {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Break {
        return pa(p, pcx) == pa(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::StructLit {
        if pa(p, pcx) != pa(n, pcx) || !same_part(ph(p, pcx), ph(n, pcx), pcx)
            || !same_part(pg(p, pcx), pg(n, pcx), pcx)
            || pcount(p, pcx) != pcount(n, pcx) {
            return false;
        }
        for i in 0..pcount(p, pcx) {
            let a = pchild(p, i, pcx);
            let b = pchild(n, i, pcx);
            if pa(a, pcx) != pa(b, pcx) || !match_node(pb(a, pcx), pb(b, pcx), &tcx, pcx) {
                return false;
            }
        }
        return true;
    }
    if k == NodeKind::If {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx)
            && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx)
            && match_node(pc(p, pcx), pc(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::While {
        return pa(p, pcx) == pa(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx)
            && match_node(pc(p, pcx), pc(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Loop {
        return pa(p, pcx) == pa(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Block {
        // (its tail is the last element of match_list's)
        return pflags(p, pcx) == pflags(n, pcx) && match_list(p, n, &tcx, pcx);
    }
    if k == NodeKind::ExprStmt {
        return pb(p, pcx) == pb(n, pcx) && match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Let {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx)
            && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx)
            && match_node(pc(p, pcx), pc(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Closure {
        // (0.14: the same parameters, result type and `move`, as written;
        // the body matched)
        if pc(p, pcx) != pc(n, pcx) || pcount(p, pcx) != pcount(n, pcx)
            || !same_part(pb(p, pcx), pb(n, pcx), pcx) {
            return false;
        }
        for i in 0..pcount(p, pcx) {
            if !same_part(pchild(p, i, pcx), pchild(n, i, pcx), pcx) {
                return false;
            }
        }
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx);
    }
    // (0.15: loops over iterators, matches, `?`, named arguments,
    // f-strings, patterns with holes)
    if k == NodeKind::For {
        return pa(p, pcx) == pa(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx)
            && match_node(pc(p, pcx), pc(n, pcx), &tcx, pcx)
            && match_node(pd(p, pcx), pd(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Match || k == NodeKind::Interp {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx) && match_list(p, n, &tcx, pcx);
    }
    if k == NodeKind::Arm {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx)
            && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx)
            && match_node(pc(p, pcx), pc(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::Try {
        return match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::NamedArg {
        return pa(p, pcx) == pa(n, pcx) && match_node(pb(p, pcx), pb(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::InterpHole {
        return pb(p, pcx) == pb(n, pcx) && pc(p, pcx) == pc(n, pcx) && pd(p, pcx) == pd(n, pcx)
            && pflags(p, pcx) == pflags(n, pcx) && match_node(pa(p, pcx), pa(n, pcx), &tcx, pcx);
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatOr {
        return match_list(p, n, &tcx, pcx);
    }
    if k == NodeKind::PatVariant {
        return pa(p, pcx) == pa(n, pcx) && pb(p, pcx) == pb(n, pcx) && pc(p, pcx) == pc(n, pcx)
            && match_list(p, n, &tcx, pcx);
    }
    false
}

// Optional parts without holes (type arguments, a path's prefix, a let's
// pattern): both absent, or the same tokens.
fn same_part(p: i64, n: i64, pcx: Ctx<Comp>) -> bool {
    if p == 0 || n == 0 {
        return p == n;
    }
    same_tokens(pstart(p, pcx), pend(p, pcx), pstart(n, pcx), pend(n, pcx), pcx)
}

// ---- Replacing ----

// Whether position pos is inside a substitution of the site.
fn in_sub(pos: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        for i in 0..tcx.sub_start.count {
            if tcx.sub_start.data[i] <= pos && pos < tcx.sub_end.data[i] {
                return true;
            }
        }
        false
    }
}

// The text hole h stands for at the site, into out: a new name's, else
// what it matched with the substitutions made in it.
fn put_bound(out: i64, h: i64, tcx: Tcx<Comp>) {
    unsafe {
        if tcx.h_fresh.data[h] != 0 {
            buf_bytes(out, buf_slice(tcx.fresh_text.data[h]));
            return;
        }
        var cur = tcx.pattern_b_start.data[h];
        let end = tcx.b_end.data[h];
        for i in 0..tcx.sub_start.count {
            let s = tcx.sub_start.data[i];
            if s < cur || tcx.sub_end.data[i] > end {
                continue;
            }
            buf_bytes(out, SRC[cur..s]);
            buf_bytes(out, buf_slice(tcx.sub_text.data[i]));
            cur = tcx.sub_end.data[i];
        }
        buf_bytes(out, SRC[cur..end]);
    }
}

// The replacement's lines: the indentation they share after the first
// (R_BASE_INDENT; -1 when it has one line).
pub fn note_base_indent(tcx: inout Tcx<Comp>) {
    tcx.r_base_indent = -1;
    var i = tcx.pattern_r_start;
    while i < tcx.pattern_r_end {
        if SRC[i] == '\n' {
            var j = i + 1;
            while j < tcx.pattern_r_end && SRC[j] == ' ' {
                j += 1;
            }
            if j < tcx.pattern_r_end && SRC[j] != '\n'
                && (tcx.r_base_indent < 0 || j - i - 1 < tcx.r_base_indent) {
                tcx.r_base_indent = j - i - 1;
            }
        }
        i += 1;
    }
}

// Copies the replacement's source from..to into out; on several lines,
// each line after the first indented from the site's line instead of
// R_BASE_INDENT.
fn copy_source(out: i64, from: i64, to: i64, tcx: Tcx<Comp>) {
    if tcx.r_base_indent < 0 {
        buf_bytes(out, SRC[from..to]);
        return;
    }
    var i = from;
    while i < to {
        buf_byte(out, SRC[i]);
        if SRC[i] == '\n' {
            var j = i + 1;
            var skipped = 0;
            while j < to && SRC[j] == ' ' && skipped < tcx.r_base_indent {
                j += 1;
                skipped += 1;
            }
            if j < to && SRC[j] != '\n' {
                put_indent(out, tcx.site_start);
            }
            i = j;
            continue;
        }
        i += 1;
    }
}

// The list node holding replacement node q as an element, and its index
// (-1 when none).
fn list_of(q: i64, index: inout i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    for n in 1..pcx.parsed_count {
        if pstart(n, pcx) < tcx.pattern_r_start || pend(n, pcx) > tcx.pattern_r_end {
            continue;
        }
        let k = pk(n, pcx);
        if k != NodeKind::Call && k != NodeKind::MethodCall && k != NodeKind::Tuple
            && k != NodeKind::Array {
            continue;
        }
        for i in 0..pcount(n, pcx) {
            if pchild(n, i, pcx) == q {
                index = i;
                return n;
            }
        }
    }
    -1
}

// The level of what hole h matched (99: arguments).
fn bound_level(h: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let n = tcx.b_node.data[h];
        if n < 0 { 99 } else { binding_level(n, pcx) }
    }
}

// The text replacing the site, from the holes' bindings, into a buffer.
pub fn replacement_text(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        tcx.break_next = 0;
        var cur = tcx.pattern_r_start;
        for i in 0..tcx.r_holes.count {
            let q = tcx.r_holes.data[i];
            let h = hole_of(q, tcx, pcx);
            let at = tcx.r_hole_span.data[i];
            var from = pstart(at, pcx);
            var to = pend(at, pcx);
            if tcx.h_rest.data[h] != 0 && tcx.b_node.data[h] == -3 {
                // (no arguments: the hole goes, with a comma next to it)
                var k = 0;
                let list = list_of(q, &k, tcx, pcx);
                if list >= 0 && pcount(list, pcx) > 1 {
                    if k > 0 {
                        from = pend(pchild(list, k - 1, pcx), pcx);
                    } else {
                        to = pstart(pchild(list, 1, pcx), pcx);
                    }
                }
                if from < cur {
                    from = cur;
                }
                copy_laid(out, cur, from, false, &tcx, pcx);
                cur = to;
                continue;
            }
            copy_laid(out, cur, from, true, &tcx, pcx);
            let wrap = tcx.h_rest.data[h] == 0 && bound_level(h, tcx, pcx) < tcx.r_levels[q];
            if wrap {
                buf_byte(out, '(');
            }
            let at_text = BUFS[out].len;
            put_bound(out, h, tcx);
            let empty = BUFS[out].len == at_text;
            let last = if empty { ' ' } else { BUFS[out].data[BUFS[out].len - 1] };
            if wrap {
                buf_byte(out, ')');
            }
            if at != q && !empty && last != ';' && last != '}' {
                // (`$s...;` for statements ending in a tail expression)
                buf_byte(out, ';');
            }
            cur = to;
        }
        copy_laid(out, cur, tcx.pattern_r_end, true, &tcx, pcx);
        out
    }
}

// The breaks of the replacement's nodes first..last.
pub fn note_breaks(first: i64, last: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        for n in first..last {
            if pk(n, pcx) != NodeKind::Block {
                continue;
            }
            var h = -1;
            for i in 0..seq_len(n, pcx) {
                let e = rest_hole_of(seq_at(n, i, pcx), tcx, pcx);
                if e >= 0 {
                    h = e;
                }
            }
            // (0.16: a block written on lines keeps them; one on a line
            // takes the site's lines: with a `$s...`, its block's, else
            // the site's, by its depth in the replacement)
            if has_newline(block_open(n, pcx), pend(n, pcx)) || (h < 0 && seq_len(n, pcx) == 0) {
                continue;
            }
            if h < 0 {
                var depth = 1;
                for m in first..last {
                    if m != n && pk(m, pcx) == NodeKind::Block && pstart(m, pcx) <= pstart(n, pcx)
                        && pend(n, pcx) <= pend(m, pcx) {
                        depth += 1;
                    }
                }
                h = -1 - depth;
            }
            for i in 0..seq_len(n, pcx) + 1 {
                let close = i == seq_len(n, pcx);
                tcx.r_breaks.push(if close { pend(n, pcx) - 1 }
                    else { pstart(seq_at(n, i, pcx), pcx) });
                tcx.r_breaks.push(h);
                tcx.r_breaks.push(close as i64);
                tcx.r_breaks.push(seq_len(n, pcx));
            }
        }
        // (by position: blocks inside blocks)
        let d = tcx.r_breaks.data;
        var i = 4;
        while i < tcx.r_breaks.count {
            var j = i;
            while j > 0 && d[j] < d[j - 4] {
                for f in 0..4 {
                    let t = d[j + f];
                    d[j + f] = d[j - 4 + f];
                    d[j - 4 + f] = t;
                }
                j -= 4;
            }
            i += 4;
        }
    }
}

// Copies the replacement's text from..to into out, its lines broken (see
// R_BREAKS) where the site's block had lines; a break at `to` too when
// `at_end`.
fn copy_laid(out: i64, from: i64, to: i64, at_end: bool, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        var cur = from;
        while tcx.break_next < tcx.r_breaks.count {
            let k = tcx.break_next;
            let at = tcx.r_breaks.data[k];
            if at > to || (at == to && !at_end) {
                break;
            }
            tcx.break_next += 4;
            let h = tcx.r_breaks.data[k + 1];
            if h < 0 {
                // (a block without `$s...`: the site's lines)
                if at < from || !tcx.site_multi {
                    continue;
                }
                copy_source(out, cur, at, tcx);
                cur = at;
                while BUFS[out].len > 0 && BUFS[out].data[BUFS[out].len - 1] == ' ' {
                    BUFS[out].len -= 1;
                }
                buf_byte(out, '\n');
                put_indent(out, tcx.site_start);
                let levels = -1 - h - tcx.r_breaks.data[k + 2];
                for _ in 0..levels {
                    buf_str(out, c"    ");
                }
                continue;
            }
            let block = tcx.b_list.data[h];
            if at < from || block <= 0 || !has_newline(block_open(block, pcx), pend(block, pcx))
                || (tcx.b_node.data[h] == -3 && tcx.r_breaks.data[k + 3] == 1) {
                continue;
            }
            copy_source(out, cur, at, tcx);
            cur = at;
            while BUFS[out].len > 0 && BUFS[out].data[BUFS[out].len - 1] == ' ' {
                BUFS[out].len -= 1;
            }
            buf_byte(out, '\n');
            if tcx.r_breaks.data[k + 2] != 0 {
                put_indent(out, pend(block, pcx) - 1);
            } else if seq_len(block, pcx) > 0 {
                put_indent(out, pstart(seq_at(block, 0, pcx), pcx));
            } else {
                put_indent(out, pend(block, pcx) - 1);
                buf_str(out, c"    ");
            }
        }
        copy_source(out, cur, to, tcx);
    }
}

// Whether SRC[from..to) has a line break.
pub fn has_newline(from: i64, to: i64) -> bool {
    for i in from..to {
        if (SRC[i]) == '\n' {
            return true;
        }
    }
    false
}

// Writes the indentation of the line of position pos into buffer out.
fn put_indent(out: i64, pos: i64) {
    var a = pos;
    while a > 0 && SRC[a - 1] != '\n' {
        a -= 1;
    }
    var b = a;
    while b < pos && (SRC[b] == ' ' || SRC[b] == '\t') {
        b += 1;
    }
    buf_bytes(out, SRC[a..b]);
}

// (0.15) At the site just matched: an identifier inside what a hole the
// replacement keeps matched, naming the binding (`for $i`, `let $x`) a
// hole it drops matched; 0 when there is none (else its hole in *hole).
// Such a site would lose the binding its code uses.
pub fn dropped_use(program_end: i64, hole: inout i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        for h in 0..tcx.h_sym.count {
            let b = tcx.b_node.data[h];
            if tcx.r_kept.data[h] != 0 || b <= 0 || pk(b, pcx) != NodeKind::PatBind {
                continue;
            }
            let sym = pa(b, pcx);
            for n in 1..program_end {
                if pk(n, pcx) != NodeKind::Ident || pa(n, pcx) != sym
                    || in_sub(pstart(n, pcx), tcx) {
                    continue;
                }
                for k in 0..tcx.h_sym.count {
                    if tcx.r_kept.data[k] != 0 && tcx.b_node.data[k] != -3
                        && tcx.pattern_b_start.data[k] <= pstart(n, pcx)
                        && pend(n, pcx) <= tcx.b_end.data[k] {
                        hole = h;
                        return n;
                    }
                }
            }
        }
        0
    }
}

// The level of the replacement as a whole, at the site being replaced.
pub fn replacement_level(tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let h = hole_of(tcx.r_root, tcx, pcx);
    if h >= 0 {
        return bound_level(h, tcx, pcx);
    }
    binding_level(tcx.r_root, pcx)
}
