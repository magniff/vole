// The regular expressions of the tools: a rewrite's name holes (0.16:
// `$x~/re/`, `--where '$x: name ~ re'`), `rewrite --text --regex` (0.21,
// in a line) and its exclusions' `GLOB:/RE/`.
//
// The dialect (0.30: groups, alternatives, `\s`, `\t`; said in `rewrite
// --help`): a byte is itself; `.` any byte; `[a-z_]` and `[^...]` classes;
// `\d` a digit, `\w` a name's byte, `\s` a space or a tab, `\t` a tab,
// `\x` the byte x (so `\(`, `\.`, `\$` are those bytes); `*`, `+`, `?`
// after any of them or after a group (the longest first); `( )` a group,
// `|` between alternatives (the first that matches); `^` at the start of
// the expression or of an alternative is the text's start, `$` at the
// end of one its end (elsewhere they are bytes). A match is anywhere in
// the text unless anchored. The groups, 1 to 9 by their `(`, are what
// `rewrite --text --regex` writes for `\1` (or `$1`) in NEW; `\0` is the
// whole match.
//
// The expression is parsed into nodes and matched by backtracking, a
// continuation at a time (the cells), for the short texts of names and
// lines; a match that takes more than STEP_LIMIT steps is no match.

use std::alloc::Allocator;

use crate::base::comp::Comp;

const N_BYTE: i64 = 1;
const N_ANY: i64 = 2;
const N_CLASS: i64 = 3;
const N_ESC: i64 = 4;
const N_CAT: i64 = 5;
const N_ALT: i64 = 6;
const N_STAR: i64 = 7;
const N_PLUS: i64 = 8;
const N_OPT: i64 = 9;
const N_GROUP: i64 = 10;
// (the node after a group's: where the group ends)
const N_GROUP_END: i64 = 11;
const N_BOL: i64 = 12;
const N_EOL: i64 = 13;
const N_EMPTY: i64 = 14;

const STEP_LIMIT: i64 = 2000000;

// A parsed expression: its text; its nodes (kind, a, b: three numbers a
// node); the continuation cells of the match being made (node, next cell,
// the position a repeat was entered at or -1); the groups' starts and
// ends in the text of the last match (two a group, group 0 the match; -1:
// not matched); why it is malformed (empty: it is not).
pub struct Regex<A: Allocator> {
    re: Vec<u8, A>,
    nodes: Vec<i64, A>,
    cells: Vec<i64, A>,
    pub caps: Vec<i64, A>,
    pub groups: i64,
    root: i64,
    steps: i64,
    pub error: &'static [u8],
}

fn node(rx: &mut Regex<Comp>, kind: i64, a: i64, b: i64) -> i64 {
    rx.nodes.push(kind);
    rx.nodes.push(a);
    rx.nodes.push(b);
    (rx.nodes.len() as i64) / 3 - 1
}

fn kind_of(rx: &Regex<Comp>, n: i64) -> i64 {
    rx.nodes[(n * 3) as usize]
}

fn a_of(rx: &Regex<Comp>, n: i64) -> i64 {
    rx.nodes[(n * 3 + 1) as usize]
}

fn b_of(rx: &Regex<Comp>, n: i64) -> i64 {
    rx.nodes[(n * 3 + 2) as usize]
}

// ---- Parsing ----

// The expression `re`, parsed; its `error` says why it is malformed.
pub fn re_compile(re: &[u8]) -> Regex<Comp> {
    let mut rx: Regex<Comp> = Regex {
        re: Vec::new_in(Comp {}), nodes: Vec::new_in(Comp {}), cells: Vec::new_in(Comp {}),
        caps: Vec::new_in(Comp {}), groups: 0, root: 0, steps: 0, error: "".as_bytes(),
    };
    for i in 0..re.len() {
        rx.re.push(re[i]);
    }
    let mut p: i64 = 0;
    rx.root = parse_alt(&mut rx, &mut p, 0);
    if rx.error.len() == 0 && p < re.len() as i64 {
        rx.error = "a `)` without its `(` (a parenthesis as a byte is `\\)`)".as_bytes();
    }
    for _ in 0..(rx.groups + 1) * 2 {
        rx.caps.push(-1);
    }
    rx
}

fn parse_alt(rx: &mut Regex<Comp>, p: &mut i64, depth: i64) -> i64 {
    let mut left = parse_seq(rx, p, depth);
    while rx.error.len() == 0 && *p < rx.re.len() as i64 && rx.re[*p as usize] == b'|' {
        *p += 1;
        let right = parse_seq(rx, p, depth);
        left = node(rx, N_ALT, left, right);
    }
    left
}

fn parse_seq(rx: &mut Regex<Comp>, p: &mut i64, depth: i64) -> i64 {
    let mut seq: i64 = -1;
    let start = *p;
    while rx.error.len() == 0 && *p < rx.re.len() as i64 {
        let c = rx.re[*p as usize];
        if c == b'|' || (c == b')' && depth > 0) {
            break;
        }
        if c == b')' {
            // (re_compile says so)
            break;
        }
        let piece = parse_piece(rx, p, depth, *p == start);
        seq = if seq < 0 { piece } else { node(rx, N_CAT, seq, piece) };
    }
    if seq < 0 { node(rx, N_EMPTY, 0, 0) } else { seq }
}

fn parse_piece(rx: &mut Regex<Comp>, p: &mut i64, depth: i64, first: bool) -> i64 {
    let n = rx.re.len() as i64;
    let c = rx.re[*p as usize];
    let mut atom: i64 = -1;
    if c == b'*' || c == b'+' || c == b'?' {
        rx.error = "a `*`, `+` or `?` with nothing to repeat (as a byte: `\\*`)".as_bytes();
        return node(rx, N_EMPTY, 0, 0);
    }
    if c == b'(' {
        *p += 1;
        rx.groups += 1;
        let g = rx.groups;
        if g > 9 {
            rx.error = "more than 9 groups".as_bytes();
            return node(rx, N_EMPTY, 0, 0);
        }
        let inner = parse_alt(rx, p, depth + 1);
        if rx.error.len() > 0 {
            return inner;
        }
        if *p >= n || rx.re[*p as usize] != b')' {
            rx.error = "a `(` that is not closed (a parenthesis as a byte is `\\(`)".as_bytes();
            return inner;
        }
        *p += 1;
        atom = node(rx, N_GROUP, inner, g);
        node(rx, N_GROUP_END, 0, g);
    } else if c == b'[' {
        let e = class_end(rx.re.as_slice(), *p);
        if e < 0 {
            rx.error = "a `[` that is not closed (as a byte: `\\[`)".as_bytes();
            return node(rx, N_EMPTY, 0, 0);
        }
        atom = node(rx, N_CLASS, *p, e);
        *p = e;
    } else if c == b'\\' {
        if *p + 1 >= n {
            rx.error = "a `\\` at the end".as_bytes();
            return node(rx, N_EMPTY, 0, 0);
        }
        atom = node(rx, N_ESC, rx.re[(*p + 1) as usize] as i64, 0);
        *p += 2;
    } else if c == b'.' {
        atom = node(rx, N_ANY, 0, 0);
        *p += 1;
    } else if c == b'^' && first {
        atom = node(rx, N_BOL, 0, 0);
        *p += 1;
    } else if c == b'$'
        && (*p + 1 == n || rx.re[(*p + 1) as usize] == b'|'
            || (rx.re[(*p + 1) as usize] == b')' && depth > 0)) {
        atom = node(rx, N_EOL, 0, 0);
        *p += 1;
    } else {
        atom = node(rx, N_BYTE, c as i64, 0);
        *p += 1;
    }
    if *p < n {
        let q = rx.re[*p as usize];
        if q == b'*' || q == b'+' || q == b'?' {
            *p += 1;
            let k = if q == b'*' { N_STAR } else if q == b'+' { N_PLUS } else { N_OPT };
            return node(rx, k, atom, 0);
        }
    }
    atom
}

// The end of the class at re[r] (a `[`), or -1.
fn class_end(re: &[u8], r: i64) -> i64 {
    let mut i = r + 1;
    if i < re.len() as i64 && re[i as usize] == b'^' {
        i += 1;
    }
    // (a `]` first is a byte of the class)
    if i < re.len() as i64 && re[i as usize] == b']' {
        i += 1;
    }
    while i < re.len() as i64 && re[i as usize] != b']' {
        if re[i as usize] == b'\\' {
            i += 1;
        }
        i += 1;
    }
    if i < re.len() as i64 { i + 1 } else { -1 }
}

// ---- Matching ----

fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

fn is_word(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || is_digit(c) || c == b'_'
}

// Whether `\x` matches byte c.
fn escape_matches(x: u8, c: u8) -> bool {
    if x == b'd' {
        is_digit(c)
    } else if x == b'w' {
        is_word(c)
    } else if x == b's' {
        c == b' ' || c == b'\t'
    } else if x == b't' {
        c == b'\t'
    } else {
        c == x
    }
}

// Whether the class re[r..e) matches byte c.
fn class_matches(re: &[u8], r: i64, e: i64, c: u8) -> bool {
    let mut i = r + 1;
    let negated = re[i as usize] == b'^';
    if negated {
        i += 1;
    }
    let mut found = false;
    let mut first = true;
    while i < e - 1 && (first || re[i as usize] != b']') {
        first = false;
        if re[i as usize] == b'\\' && i + 1 < e - 1 {
            if escape_matches(re[(i + 1) as usize], c) {
                found = true;
            }
            i += 2;
        } else if i + 2 < e - 1 && re[(i + 1) as usize] == b'-' {
            if c >= re[i as usize] && c <= re[(i + 2) as usize] {
                found = true;
            }
            i += 3;
        } else {
            if re[i as usize] == c {
                found = true;
            }
            i += 1;
        }
    }
    found != negated
}

// Whether node n, which matches one byte, matches c.
fn byte_matches(rx: &Regex<Comp>, n: i64, c: u8) -> bool {
    let k = kind_of(rx, n);
    if k == N_ANY {
        return true;
    }
    if k == N_BYTE {
        return a_of(rx, n) == c as i64;
    }
    if k == N_ESC {
        return escape_matches(a_of(rx, n) as u8, c);
    }
    class_matches(rx.re.as_slice(), a_of(rx, n), b_of(rx, n), c)
}

fn cell(rx: &mut Regex<Comp>, n: i64, next: i64, pos: i64) -> i64 {
    rx.cells.push(n);
    rx.cells.push(next);
    rx.cells.push(pos);
    (rx.cells.len() as i64) / 3 - 1
}

// What is left to match (cell `cont`; -1: nothing) matches t from i on:
// where the match ends, or -1.
fn rest(rx: &mut Regex<Comp>, t: &[u8], i: i64, cont: i64) -> i64 {
    if cont < 0 {
        return i;
    }
    let n = rx.cells[(cont * 3) as usize];
    let next = rx.cells[(cont * 3 + 1) as usize];
    let pos = rx.cells[(cont * 3 + 2) as usize];
    if pos >= 0 {
        return again(rx, n, t, i, next, pos);
    }
    matches(rx, n, t, i, next)
}

// The repeat n (a `*` or `+` of a group), entered at `last`, once more
// from i when the last turn moved, else on to the rest.
fn again(rx: &mut Regex<Comp>, n: i64, t: &[u8], i: i64, cont: i64, last: i64) -> i64 {
    if i != last {
        let mark = rx.cells.len();
        let c = cell(rx, n, cont, i);
        let inner = a_of(rx, n);
        let r = matches(rx, inner, t, i, c);
        rx.cells.truncate(mark);
        if r >= 0 {
            return r;
        }
    }
    rest(rx, t, i, cont)
}

// Node n, then what is left (`cont`), matches t from i on: where the match
// ends, or -1.
fn matches(rx: &mut Regex<Comp>, n: i64, t: &[u8], i: i64, cont: i64) -> i64 {
    rx.steps += 1;
    if rx.steps > STEP_LIMIT {
        return -1;
    }
    let k = kind_of(rx, n);
    let len = t.len() as i64;
    if k <= N_ESC {
        if i < len && byte_matches(rx, n, t[i as usize]) {
            return rest(rx, t, i + 1, cont);
        }
        return -1;
    }
    if k == N_CAT {
        let mark = rx.cells.len();
        let c = cell(rx, b_of(rx, n), cont, -1);
        let first = a_of(rx, n);
        let r = matches(rx, first, t, i, c);
        rx.cells.truncate(mark);
        return r;
    }
    if k == N_ALT {
        let first = a_of(rx, n);
        let r = matches(rx, first, t, i, cont);
        if r >= 0 {
            return r;
        }
        let second = b_of(rx, n);
        return matches(rx, second, t, i, cont);
    }
    if k == N_STAR || k == N_PLUS || k == N_OPT {
        let inner = a_of(rx, n);
        if kind_of(rx, inner) <= N_ESC {
            // (a byte repeated: the longest run first, without a call a
            // byte)
            let least: i64 = if k == N_PLUS { 1 } else { 0 };
            let most: i64 = if k == N_OPT { 1 } else { len - i };
            let mut count: i64 = 0;
            while count < most && i + count < len
                && byte_matches(rx, inner, t[(i + count) as usize]) {
                count += 1;
            }
            while count >= least {
                let r = rest(rx, t, i + count, cont);
                if r >= 0 {
                    return r;
                }
                count -= 1;
            }
            return -1;
        }
        if k == N_OPT {
            let r = matches(rx, inner, t, i, cont);
            if r >= 0 {
                return r;
            }
            return rest(rx, t, i, cont);
        }
        if k == N_STAR {
            return again(rx, n, t, i, cont, -1);
        }
        let mark = rx.cells.len();
        let c = cell(rx, n, cont, i);
        let r = matches(rx, inner, t, i, c);
        rx.cells.truncate(mark);
        return r;
    }
    if k == N_GROUP {
        let g = (b_of(rx, n) * 2) as usize;
        let old = rx.caps[g];
        rx.caps[g] = i;
        let mark = rx.cells.len();
        let c = cell(rx, n + 1, cont, -1);
        let inner = a_of(rx, n);
        let r = matches(rx, inner, t, i, c);
        rx.cells.truncate(mark);
        if r < 0 {
            rx.caps[g] = old;
        }
        return r;
    }
    if k == N_GROUP_END {
        let g = (b_of(rx, n) * 2 + 1) as usize;
        let old = rx.caps[g];
        rx.caps[g] = i;
        let r = rest(rx, t, i, cont);
        if r < 0 {
            rx.caps[g] = old;
        }
        return r;
    }
    if k == N_BOL {
        return if i == 0 { rest(rx, t, i, cont) } else { -1 };
    }
    if k == N_EOL {
        return if i == len { rest(rx, t, i, cont) } else { -1 };
    }
    rest(rx, t, i, cont)
}

// The first match of the expression in text starting at or after `from`:
// its start, its end in `end`, the groups in `caps` (positions in text);
// -1 when there is none (or the expression is malformed).
pub fn rx_find(rx: &mut Regex<Comp>, text: &[u8], from: i64, end: &mut i64) -> i64 {
    if rx.error.len() > 0 {
        return -1;
    }
    let mut i = from;
    while i <= text.len() as i64 {
        for g in 0..rx.caps.len() {
            rx.caps[g] = -1;
        }
        rx.cells.clear();
        rx.steps = 0;
        let root = rx.root;
        let e = matches(rx, root, text, i, -1);
        if e >= 0 {
            rx.caps[0] = i;
            rx.caps[1] = e;
            *end = e;
            return i;
        }
        i += 1;
    }
    -1
}

// Whether re is well formed.
pub fn re_valid(re: &[u8]) -> bool {
    re_compile(re).error.len() == 0
}

// Why re is malformed (empty: it is not).
pub fn re_error(re: &[u8]) -> &'static [u8] {
    re_compile(re).error
}

// Whether re matches somewhere in text.
pub fn re_search(re: &[u8], text: &[u8]) -> bool {
    let mut rx = re_compile(re);
    let mut end: i64 = 0;
    rx_find(&mut rx, text, 0, &mut end) >= 0
}

// (0.21, rewrite --text --regex) The first match of re in text (a line)
// starting at or after `from`: its start, and its end in `end`; -1 when
// there is none.
pub fn re_find(re: &[u8], text: &[u8], from: i64, end: &mut i64) -> i64 {
    let mut rx = re_compile(re);
    rx_find(&mut rx, text, from, end)
}
