// `volec rewrite 'PATTERN' 'REPLACEMENT' [--where '$v: TYPE']...
// [--in FILE|MODULE] [--dry-run]` (0.11; docs/refactor.md): typed
// structural search and replace over the program's expressions and
// statements, in one atomic edit (edit.vl).
//
// PATTERN and REPLACEMENT are vole expressions (statements, when the
// pattern ends with `;` or starts with `let`) with holes: `$x` matches
// any expression (or type), `$x...` any number of arguments of a call, a
// tuple or an array (0.15: or statements of a block, laid out as the
// site's were); a hole written twice matches equal code (the same
// tokens). `--where '$x: T'` keeps the sites where the checker gave $x
// type T. Both are parsed by the compiler's parser (each hole an
// identifier, `__vole_hole_x`), and the pattern is matched against
// the program's nodes as parsed (ast.vl's PARSED_NODES: the checker
// changes nodes in place), node by node; a part of the pattern without
// holes matches code with the same tokens. A site's replacement is
// REPLACEMENT with each hole replaced by the exact text it matched,
// parenthesized where the operators around it need it (and the whole
// replacement too, for the operators around the site). Sites inside a
// rewritten site are left for another run.
//
// Output: `rewrote N sites in M files<TAB>FILES<TAB>+A -R lines`, or with
// --dry-run the diff.
//
// This file holds the command; the reading of the nodes as parsed is in
// parsed, the holes, the matching and the replacement text in pattern.

pub mod parsed;
mod pattern;
pub mod regex;
mod subst;
mod after;

use std::alloc::Arena;

use crate::base::{
    STDOUT, buf_at, buf_byte, buf_bytes, buf_int, buf_len, buf_new, buf_slice, buf_str,
    buf_truncate, buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{
    Call, EV_FLAG, EV_MISSING, EV_OPTION, EV_UNKNOWN, EV_WORD, Leaf, flag, is_opt, option, pair,
};
use crate::front::ast::NodeKind;
use crate::front::embed::wgsl::WgslCx;
use crate::front::modules::{file_made, file_of_pos};
use crate::front::types::buf_type;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::diagnostics::{
    diag, diags, program_errors, put_cword, put_root, put_word, try_end, write_diags,
};
use crate::tools::query::positions::{line_of, put_loc, put_path};
use crate::tools::query::refs::{put_bad_in, ref_in, resolve_in};

use after::{drop_unused_imports, note_site_types, where_hints};
use parsed::{pa, parenthesized, pb, pchild, pcount, pend, pk, pstart, slot_levels};
use pattern::{
    dropped_use, has_newline, hole_named, hole_of, holes_to_idents, is_name_byte, match_node,
    note_base_indent, note_breaks, note_clones, parse_text, replacement_level, replacement_text,
    rest_hole_of, seq_at, seq_len, types_match,
};
use regex::re_valid;
use subst::{choose_fresh, find_substs, note_subst_holes, put_site};

// ---- The command ----

pub fn run_rewrite(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    // (0.21: --text, a text edit of the tree's files, textual/rewrite;
    // its leaf is text_rewrite_leaf, cli/tree.vl)
    if c.line.has("--text") {
        return crate::tools::textual::rewrite::run_text_rewrite(c, tcx, pcx, wgx);
    }
    let status = run_rewrite_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

fn usage(message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"rewrite.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = try_rewrite(c"grow($v, $n)", c"$v.reserve($n)", tcx, pcx);
    buf_str(out, c" --where '$v: IntVec' --dry-run");
    put_root(out, tcx);
    try_end(out);
    2
}

// Starts a `try:` line `PROG rewrite PATTERN REPLACEMENT`; options and
// put_root follow.
fn try_rewrite(pattern: *mut u8, replacement: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" rewrite");
    put_word(out, c_slice(pattern));
    if replacement != 0 as *mut u8 {
        put_word(out, c_slice(replacement));
    }
    out
}

// Whether text (trimmed) is statements: it ends with `;` or starts with
// `let `.
fn is_statement(text: *mut u8) -> bool {
    let s = c_slice(text);
    let mut a: i64 = 0;
    let mut b = s.len() as i64;
    while a < b && (s[a as usize] == b' ' || s[a as usize] == b'\n' || s[a as usize] == b'\t') {
        a += 1;
    }
    while b > a
        && (s[(b - 1) as usize] == b' ' || s[(b - 1) as usize] == b'\n'
            || s[(b - 1) as usize] == b'\t') {
        b -= 1;
    }
    (b > a && s[(b - 1) as usize] == b';')
        || (b - a > 4 && s[a as usize] == b'l' && s[(a + 1) as usize] == b'e'
            && s[(a + 2) as usize] == b't' && s[(a + 3) as usize] == b' ')
}

// --where `$x: T` (several: `$x: T, $y: U`): the holes' types. False
// after the diagnostic.
fn take_where(w: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let s = c_slice(w);
        let mut i: i64 = 0;
        while i < s.len() as i64 {
            while i < s.len() as i64 && (s[i as usize] == b' ' || s[i as usize] == b',') {
                i += 1;
            }
            if i >= s.len() as i64 {
                break;
            }
            if s[i as usize] != b'$' {
                usage(c"--where takes '$x: TYPE' (several: '$x: T, $y: U')", tcx, pcx);
                return false;
            }
            let mut e = i + 1;
            while e < s.len() as i64 && is_name_byte(s[e as usize]) {
                e += 1;
            }
            let name = &s[i as usize..e as usize];
            let mut c = e;
            while c < s.len() as i64 && s[c as usize] == b' ' {
                c += 1;
            }
            if c >= s.len() as i64 || s[c as usize] != b':' {
                usage(c"--where takes '$x: TYPE' (several: '$x: T, $y: U')", tcx, pcx);
                return false;
            }
            let h = hole_named(name, false, tcx);
            // (0.16: `name`, `name ~ RE`: a name hole)
            let mut q = c + 1;
            while q < s.len() as i64 && s[q as usize] == b' ' {
                q += 1;
            }
            if h >= 0 && q + 4 <= s.len() as i64 && s[q as usize] == b'n'
                && s[(q + 1) as usize] == b'a' && s[(q + 2) as usize] == b'm'
                && s[(q + 3) as usize] == b'e'
                && (q + 4 == s.len() as i64 || s[(q + 4) as usize] == b' '
                    || s[(q + 4) as usize] == b'~' || s[(q + 4) as usize] == b',') {
                q += 4;
                while q < s.len() as i64 && s[q as usize] == b' ' {
                    q += 1;
                }
                (tcx.h_nameonly[h as usize]) = 1;
                if q < s.len() as i64 && s[q as usize] == b'~' {
                    q += 1;
                    while q < s.len() as i64 && s[q as usize] == b' ' {
                        q += 1;
                    }
                    let re = buf_new();
                    while q < s.len() as i64 && !(s[q as usize] == b',' && next_is_hole(s, q + 1)) {
                        buf_byte(re, s[q as usize]);
                        q += 1;
                    }
                    while buf_len(re) > 0
                        && buf_at(re, buf_len(re) - 1) == b' ' {
                        buf_truncate(re, buf_len(re) - 1);
                    }
                    if !re_valid(buf_slice(re)) {
                        usage(c"--where '$x: name ~ RE' takes a regular expression (^ $ . * + ? [a-z] \\d \\w)", tcx, pcx);
                        return false;
                    }
                    (tcx.h_re[h as usize]) = re;
                }
                i = q;
                continue;
            }
            // (the type: to the next `, $`, spaces dropped)
            let mut t = c + 1;
            let ty = buf_new();
            while t < s.len() as i64 && !(s[t as usize] == b',' && next_is_hole(s, t + 1)) {
                if s[t as usize] != b' ' {
                    buf_byte(ty, s[t as usize]);
                }
                t += 1;
            }
            if h < 0 {
                let d = diag(c"error", c"rewrite.usage", tcx);
                buf_str(d, c"--where names ");
                buf_bytes(d, name);
                buf_str(d, c", which the pattern has not (or has as '");
                buf_bytes(d, name);
                buf_str(d, c"...')\n");
                return false;
            }
            (tcx.h_type[h as usize]) = ty;
            i = t;
        }
        true
    }
}

fn next_is_hole(s: &[u8], from: i64) -> bool {
    let mut i = from;
    while i < s.len() as i64 && s[i as usize] == b' ' {
        i += 1;
    }
    i < s.len() as i64 && s[i as usize] == b'$'
}

// `rewrite`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn rewrite_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    table.push(option("where", "'$v: TYPE'", "a hole's type or name"));
    table.push(pair("subst", "PATTERN REPLACEMENT", "inside the code the holes keep"));
    table.push(flag("list", "a line per site"));
    table.push(option("in", "FILE|MODULE|ITEM", "only there (repeated: the scopes add up)"));
    Leaf::new(table, "word")
}

fn run_rewrite_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let mut root = 0 as *mut u8;
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut wheres: Vec<i64, Comp> = Vec::new_in(Comp {});
    // (0.16: --subst PATTERN REPLACEMENT, in pairs; --list)
    let mut substs: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut list = false;
    let mut ins: Vec<i64, Comp> = Vec::new_in(Comp {});
    let line = c.evs.clone();
    let mut k: i64 = 0;
    while k < line.len() as i64 {
        let mut ev = line[k as usize].clone();
        k += 1;
        let a = ev.value;
        if ev.kind == EV_OPTION && ev.name == "where" {
            wheres.push(a as i64);
            continue;
        }
        if ev.name == "subst" && (ev.kind == EV_MISSING || ev.kind == EV_OPTION) {
            if ev.kind == EV_MISSING || k >= line.len() as i64
                || !is_opt(line[k as usize], "subst") {
                return usage(c"--subst takes a PATTERN and its REPLACEMENT", tcx, pcx);
            }
            substs.push(a as i64);
            substs.push(line[k as usize].value as i64);
            k += 1;
            continue;
        }
        if ev.kind == EV_FLAG && ev.name == "list" {
            list = true;
            continue;
        }
        if ev.kind == EV_OPTION && ev.name == "in" {
            // (0.17: repeated, the scopes add up)
            pcx.opt_in = a;
            ins.push(a as i64);
            continue;
        }
        if ev.kind == EV_MISSING && (ev.name == "where" || ev.name == "in") {
            ev.kind = EV_UNKNOWN;
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
            continue;
        }
        if ev.kind != EV_WORD {
            let d = diag(c"error", c"rewrite.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' (--where, --subst, --list, --in, --dry-run, --no-check, --root)\n");
            return 2;
        }
        words.push(ev.value as i64);
    }
    unsafe {
        if words.len() as i64 >= 2 && root == 0 as *mut u8
            && crate::base::is_source_path((words[(words.len() as i64 - 1) as usize]) as *mut u8)
            && (words.len() as i64 == 3 || list) {
            root = (words[(words.len() as i64 - 1) as usize]) as *mut u8;
            words.pop().unwrap();
        }
        if words.len() as i64 != 2 && !(list && words.len() as i64 == 1) {
            return usage(if words.len() as i64
                < 2 { c"a PATTERN and a REPLACEMENT are needed (--list: a PATTERN)" }
                else { c"one PATTERN and one REPLACEMENT" }, tcx, pcx);
        }
        if substs.len() as i64 > 0 && words.len() as i64 < 2 {
            return usage(c"--subst changes what the REPLACEMENT keeps: give one", tcx, pcx);
        }
        let pattern = (words[0]) as *mut u8;
        let replacement = if words.len() as i64 == 2 { (words[1]) as *mut u8 }
            else { 0 as *mut u8 };
        tcx.root_given = root;
        root = root_or_diag(root, c"rewrite", c_slice(pattern), true, tcx, pcx);
        if root == 0 as *mut u8 {
            return 2;
        }
        pcx.keep_parsed = true;
        // (0.15: the imports names of the replacement need, as edit
        // replace adds them)
        tcx.add_imports = true;
        if !load_program(root, tcx.target, tcx, pcx, wgx) {
            program_errors(c"error", root, true, tcx, pcx);
            return 1;
        }
        for k in 0..ins.len() as i64 {
            if !resolve_in(c_slice((ins[k as usize]) as *mut u8), tcx, pcx) {
                let d = diag(c"error", c"rewrite.bad-in", tcx);
                put_bad_in(d, (ins[k as usize]) as *mut u8, tcx);
                return 1;
            }
        }
        let program_end = pcx.parsed_nodes.len() as i64;
        note_clones(program_end, pcx.nodes.len() as i64, tcx, pcx);
        // The pattern, then the replacement.
        tcx.stmts = is_statement(pattern);
        let ptext = buf_new();
        if !holes_to_idents(pattern, ptext, true, tcx, pcx) {
            return 2;
        }
        tcx.s_local = tcx.h_sym.len() as i64;
        let mut stexts: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut k: i64 = 0;
        while k < substs.len() as i64 {
            let t = buf_new();
            if !holes_to_idents((substs[k as usize]) as *mut u8, t, true, tcx, pcx) {
                return 2;
            }
            stexts.push(t);
            k += 2;
        }
        let rtext = buf_new();
        // (0.16: a hole the pattern lacks is a new name)
        tcx.fresh_ok = true;
        if replacement != 0 as *mut u8 && !holes_to_idents(replacement, rtext, false, tcx, pcx) {
            return 2;
        }
        tcx.fresh_ok = false;
        k = 1;
        while k < substs.len() as i64 {
            let t = buf_new();
            if !holes_to_idents((substs[k as usize]) as *mut u8, t, false, tcx, pcx) {
                return 2;
            }
            stexts.push(t);
            k += 2;
        }
        for w in 0..wheres.len() as i64 {
            if !take_where((wheres[w as usize]) as *mut u8, tcx, pcx) {
                return 2;
            }
        }
        let pfirst = pcx.parsed_nodes.len() as i64;
        let mut proot = parse_text(ptext, tcx.stmts, c"pattern", tcx, pcx);
        if proot == 0 {
            return 2;
        }
        if tcx.stmts {
            // (one statement)
            if pcount(proot, pcx) != 1 {
                let d = diag(c"error", c"rewrite.pattern", tcx);
                buf_str(d, c"the pattern is one statement, or an expression\n");
                return 2;
            }
            proot = pchild(proot, 0, pcx);
        }
        let plast = pcx.parsed_nodes.len() as i64;
        for n in pfirst..plast {
            if hole_of(n, tcx, pcx) >= 0 {
                tcx.pat_holes.push(n);
            }
        }
        if hole_of(proot, tcx, pcx) >= 0 {
            let d = diag(c"error", c"rewrite.pattern", tcx);
            buf_str(d, c"the pattern is a hole alone: it would match every expression\n");
            return 2;
        }
        if !rest_holes_in_lists(pfirst, plast, tcx, pcx) {
            return 2;
        }
        // (0.16: the --subst patterns, expressions)
        let nsubst = substs.len() as i64 / 2;
        for s in 0..nsubst {
            let first = pcx.parsed_nodes.len() as i64;
            let sp = parse_text((stexts[s as usize]), false, c"--subst pattern", tcx,
                pcx);
            if sp == 0 {
                return 2;
            }
            for n in first..pcx.parsed_nodes.len() as i64 {
                if hole_of(n, tcx, pcx) >= 0 {
                    tcx.pat_holes.push(n);
                }
            }
            if hole_of(sp, tcx, pcx) >= 0 {
                let d = diag(c"error", c"rewrite.pattern", tcx);
                buf_str(d, c"a --subst pattern is a hole alone: it would match every expression\n");
                return 2;
            }
            if !rest_holes_in_lists(first, pcx.parsed_nodes.len() as i64, tcx, pcx) {
                return 2;
            }
            tcx.s_pat.push(sp);
        }
        if replacement == 0 as *mut u8 {
            return list_sites(proot, program_end, pattern, tcx, pcx);
        }
        let rfirst = pcx.parsed_nodes.len() as i64;
        tcx.r_root = parse_text(rtext, tcx.stmts, c"replacement", tcx, pcx);
        if tcx.r_root == 0 {
            return 2;
        }
        let rlast = pcx.parsed_nodes.len() as i64;
        if !rest_holes_in_lists(rfirst, rlast, tcx, pcx) {
            return 2;
        }
        // (a new name is bound by the replacement)
        for h in 0..tcx.h_sym.len() as i64 {
            if (tcx.h_fresh[h as usize]) == 0 {
                continue;
            }
            let mut bound = false;
            for n in rfirst..rlast {
                if pk(n, pcx) == NodeKind::PatBind && hole_of(n, tcx, pcx) == h {
                    bound = true;
                }
            }
            if !bound {
                let d = diag(c"error", c"rewrite.unbound", tcx);
                buf_str(d, c"the replacement's ");
                buf_bytes(d, buf_slice((tcx.h_name[h as usize])));
                buf_str(d, c" is not in the pattern, and the replacement binds no name with it (`for $x in`, `let $x =`)\n");
                return 2;
            }
        }
        for s in 0..nsubst {
            let first = pcx.parsed_nodes.len() as i64;
            let sr = parse_text((stexts[(nsubst + s) as usize]), false,
                c"--subst replacement", tcx, pcx);
            if sr == 0 {
                return 2;
            }
            tcx.s_rep.push(sr);
            note_subst_holes(s, first, pcx.parsed_nodes.len() as i64, tcx, pcx);
        }
        // (the replacement's text: its source, trimmed)
        tcx.pattern_r_start = pstart(tcx.r_root, pcx);
        tcx.pattern_r_end = pend(tcx.r_root, pcx);
        if tcx.stmts {
            tcx.pattern_r_start = if pcount(tcx.r_root, pcx)
                > 0 { pstart(pchild(tcx.r_root, 0, pcx), pcx) }
                else { tcx.pattern_r_end };
        }
        for n in rfirst..rlast {
            if hole_of(n, tcx, pcx) >= 0 && pstart(n, pcx) >= tcx.pattern_r_start
                && pend(n, pcx) <= tcx.pattern_r_end {
                tcx.r_holes.push(n);
            }
        }
        sort_by_start(&mut tcx.r_holes, pcx);
        for _ in 0..tcx.h_sym.len() as i64 {
            tcx.r_kept.push(0);
        }
        for i in 0..tcx.r_holes.len() as i64 {
            let q = (tcx.r_holes[i as usize]);
            let kept_at = hole_of(q, tcx, pcx) as usize;
            tcx.r_kept[kept_at] = 1;
            // (`$s...;`: the statement is what its text replaces)
            let mut at = q;
            for n in rfirst..rlast {
                if pk(n, pcx) == NodeKind::ExprStmt && pa(n, pcx) == q && pb(n, pcx) == 1
                    && rest_hole_of(n, tcx, pcx) >= 0 {
                    at = n;
                }
            }
            tcx.r_hole_span.push(at);
        }
        note_breaks(rfirst, rlast, tcx, pcx);
        note_base_indent(tcx);
        tcx.r_levels = slot_levels(rfirst, pcx.parsed_nodes.len() as i64, pcx);
        tcx.p_levels = slot_levels(1, program_end, pcx);
        for _ in 0..tcx.h_sym.len() as i64 {
            tcx.b_node.push(-1);
            tcx.pattern_b_start.push(-1);
            tcx.b_end.push(-1);
            tcx.b_list.push(0);
        }
        // The sites: start, end and replacement of each.
        let mut s_start: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut s_end: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut s_text: Vec<i64, Comp> = Vec::new_in(Comp {});
        let pkind = pk(proot, pcx);
        for n in 1..program_end {
            if pk(n, pcx) != pkind {
                continue;
            }
            let f = file_of_pos(pstart(n, pcx), pcx);
            if file_made(f, pcx) || !ref_in(pstart(n, pcx), pcx) {
                continue;
            }
            for h in 0..tcx.h_sym.len() as i64 {
                (tcx.b_node[h as usize]) = -1;
            }
            if !match_node(proot, n, tcx, pcx) || !types_match(tcx, pcx) {
                continue;
            }
            // (0.16: the site's new names and substitutions)
            tcx.site_start = pstart(n, pcx);
            tcx.site_multi = has_newline(pstart(n, pcx), pend(n, pcx));
            choose_fresh(pstart(n, pcx), pend(n, pcx), tcx, pcx);
            find_substs(program_end, tcx, pcx);
            let mut dropped: i64 = 0;
            let used = dropped_use(program_end, &mut dropped, tcx, pcx);
            if used > 0 {
                if tcx.pattern_dropped == 0 {
                    tcx.drop_use = used;
                    tcx.drop_hole = dropped;
                }
                tcx.pattern_dropped += 1;
                continue;
            }
            if list {
                let line = buf_new();
                put_site(line, pstart(n, pcx), tcx, pcx);
                s_start.push(pstart(n, pcx));
                s_end.push(pstart(n, pcx));
                s_text.push(line);
                continue;
            }
            note_site_types(tcx, pcx);
            let mut text = replacement_text(tcx, pcx);
            let mut from = pstart(n, pcx);
            let mut to = pend(n, pcx);
            if !tcx.stmts {
                if parenthesized(n, pcx) {
                    from += 1;
                    to -= 1;
                } else if replacement_level(tcx, pcx) < (tcx.p_levels[n as usize]) {
                    let wrapped = buf_new();
                    buf_byte(wrapped, b'(');
                    buf_bytes(wrapped, buf_slice(text));
                    buf_byte(wrapped, b')');
                    text = wrapped;
                }
            }
            s_start.push(from);
            s_end.push(to);
            s_text.push(text);
        }
        if list {
            return print_sites(&mut s_start, &mut s_text, pattern, replacement, tcx,
                pcx);
        }
        // Outermost first; a site inside another is left.
        let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
        for k in 0..s_start.len() as i64 {
            order.push(k);
        }
        for a in 1..order.len() as i64 {
            let mut j = a;
            while j > 0
                && ((s_start[(order[j as usize]) as usize])
                    < (s_start[(order[(j - 1) as usize]) as usize])
                    || ((s_start[(order[j as usize]) as usize])
                        == (s_start[(order[(j - 1) as usize]) as usize])
                        && (s_end[(order[j as usize]) as usize])
                        > (s_end[(order[(j - 1) as usize]) as usize]))) {
                let t = (order[j as usize]);
                (order[j as usize]) = (order[(j - 1) as usize]);
                (order[(j - 1) as usize]) = t;
                j -= 1;
            }
        }
        let mut sites: i64 = 0;
        let mut nested: i64 = 0;
        let mut files: i64 = 0;
        let mut last_end: i64 = -1;
        let mut last_file: i64 = -1;
        let mut done_start: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut done_end: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut done_text: Vec<i64, Comp> = Vec::new_in(Comp {});
        for a in 0..order.len() as i64 {
            let k = (order[a as usize]);
            if (s_start[k as usize]) < last_end {
                nested += 1;
                continue;
            }
            edit_replace((s_start[k as usize]), (s_end[k as usize]),
                (s_text[k as usize]), pcx);
            done_start.push((s_start[k as usize]));
            done_end.push((s_end[k as usize]));
            done_text.push((s_text[k as usize]));
            last_end = (s_end[k as usize]);
            sites += 1;
            let f = file_of_pos((s_start[k as usize]), pcx);
            if f != last_file {
                files += 1;
                last_file = f;
            }
        }
        if sites == 0 {
            let d = diag(c"note", c"rewrite.none", tcx);
            buf_str(d, c"nothing matches '");
            buf_str(d, pattern);
            buf_str(d, c"'\n");
            notes(pattern, replacement, tcx, pcx);
            return 0;
        }
        if nested > 0 {
            let d = diag(c"note", c"rewrite.nested", tcx);
            buf_int(d, nested);
            buf_str(d,
                if nested == 1 { c" site inside a rewritten one is" }
                else { c" sites inside rewritten ones are" });
            buf_str(d, c" left; run the rewrite again\n");
        }
        notes(pattern, replacement, tcx, pcx);
        // (0.17: the imports it leaves unused go)
        let dropped = drop_unused_imports(done_start.as_slice(), done_end.as_slice(),
            done_text.as_slice(), pcx);
        if dropped > 0 {
            let d = diag(c"note", c"rewrite.imports", tcx);
            buf_str(d, c"removed ");
            buf_int(d, dropped);
            buf_str(d, if dropped == 1 { c" import" } else { c" imports" });
            buf_str(d, c" the rewrite left unused\n");
        }
        where_hints(tcx, pcx);
        let what = buf_new();
        buf_str(what, c"rewrote ");
        buf_int(what, sites);
        buf_str(what, if sites == 1 { c" site in " } else { c" sites in " });
        buf_int(what, files);
        buf_str(what, if files == 1 { c" file" } else { c" files" });
        apply_edit(buf_slice(what), root, tcx, pcx)
    }
}

// `--list` without a REPLACEMENT (0.16): the sites PATTERN (proot)
// matches with their --where types and names, a line each.
fn list_sites(proot: i64, program_end: i64, pattern: *mut u8, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        for _ in 0..tcx.h_sym.len() as i64 {
            tcx.b_node.push(-1);
            tcx.pattern_b_start.push(-1);
            tcx.b_end.push(-1);
            tcx.b_list.push(0);
            tcx.r_kept.push(0);
        }
        let mut starts: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut lines: Vec<i64, Comp> = Vec::new_in(Comp {});
        let pkind = pk(proot, pcx);
        for n in 1..program_end {
            if pk(n, pcx) != pkind {
                continue;
            }
            let f = file_of_pos(pstart(n, pcx), pcx);
            if file_made(f, pcx) || !ref_in(pstart(n, pcx), pcx) {
                continue;
            }
            for h in 0..tcx.h_sym.len() as i64 {
                (tcx.b_node[h as usize]) = -1;
            }
            if !match_node(proot, n, tcx, pcx) || !types_match(tcx, pcx) {
                continue;
            }
            let line = buf_new();
            put_site(line, pstart(n, pcx), tcx, pcx);
            starts.push(pstart(n, pcx));
            lines.push(line);
        }
        print_sites(&mut starts, &mut lines, pattern, 0 as *mut u8, tcx, pcx)
    }
}

// --list: the sites' lines (`lines`, buffers), by position (`starts`),
// then the notes. The status.
fn print_sites(starts: &mut Vec<i64, Comp>, lines: &mut Vec<i64, Comp>, pattern: *mut u8,
    replacement: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    for a in 1..starts.len() {
        let mut j = a;
        while j > 0 && starts[j] < starts[j - 1] {
            let t = starts[j];
            starts[j] = starts[j - 1];
            starts[j - 1] = t;
            let u = lines[j];
            lines[j] = lines[j - 1];
            lines[j - 1] = u;
            j -= 1;
        }
    }
    let out = buf_new();
    for i in 0..lines.len() {
        buf_bytes(out, buf_slice(lines[i]));
    }
    buf_write_fd(out, STDOUT);
    if lines.len() == 0 {
        let d = diag(c"note", c"rewrite.none", tcx);
        buf_str(d, c"nothing matches '");
        buf_str(d, pattern);
        buf_str(d, c"'\n");
    }
    notes(pattern, replacement, tcx, pcx);
    0
}

// The notes on sites left out: for their types (with the command that
// takes the first one's type), for code the checker did not see.
fn notes(pattern: *mut u8, replacement: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if tcx.type_misses > 0 {
            let d = diag(c"note", c"rewrite.types", tcx);
            buf_int(d, tcx.type_misses);
            buf_str(d, if tcx.type_misses == 1 { c" site matches" } else { c" sites match" });
            buf_str(d, c" but for --where; first: ");
            buf_bytes(d, buf_slice((tcx.h_name[tcx.miss_hole as usize])));
            buf_str(d, c" is ");
            buf_type(d, tcx.miss_type, pcx);
            buf_str(d, c" at ");
            put_loc(d, pstart(tcx.miss_node, pcx), pcx);
            buf_byte(d, b'\n');
            let out = try_rewrite(pattern, replacement, tcx, pcx);
            // (the --where of that type)
            let w = buf_new();
            for h in 0..tcx.h_sym.len() as i64 {
                if (tcx.h_type[h as usize]) < 0 {
                    continue;
                }
                if buf_len(w) > 0 {
                    buf_str(w, c", ");
                }
                buf_bytes(w, buf_slice((tcx.h_name[h as usize])));
                buf_str(w, c": ");
                if h == tcx.miss_hole {
                    buf_type(w, tcx.miss_type, pcx);
                } else {
                    buf_bytes(w, buf_slice((tcx.h_type[h as usize])));
                }
            }
            buf_str(out, c" --where");
            put_word(out, buf_slice(w));
            if pcx.opt_in != 0 as *mut u8 {
                buf_str(out, c" --in");
                put_word(out, c_slice(pcx.opt_in));
            }
            buf_str(out, if replacement == 0 as *mut u8 { c" --list" } else { c" --dry-run" });
            put_root(out, tcx);
            try_end(out);
        }
        if tcx.pattern_dropped > 0 {
            // (0.15)
            let d = diag(c"note", c"rewrite.dropped", tcx);
            buf_int(d, tcx.pattern_dropped);
            buf_str(d, if tcx.pattern_dropped == 1 { c" site is" } else { c" sites are" });
            buf_str(d, c" left: the replacement drops ");
            buf_bytes(d, buf_slice((tcx.h_name[tcx.drop_hole as usize])));
            buf_str(d, c", which the code it keeps uses; first: ");
            put_loc(d, pstart(tcx.drop_use, pcx), pcx);
            buf_byte(d, b'\n');
            let out = diags(tcx);
            buf_str(out, c"try:");
            put_cword(out, pcx.prog);
            buf_str(out, c" query show ");
            put_path(out, file_of_pos(pstart(tcx.drop_use, pcx), pcx), pcx);
            buf_byte(out, b':');
            buf_int(out, line_of(pstart(tcx.drop_use, pcx), pcx));
            put_root(out, tcx);
            try_end(out);
        }
        if tcx.untyped > 0 {
            let d = diag(c"note", c"rewrite.untyped", tcx);
            buf_int(d, tcx.untyped);
            buf_str(d, if tcx.untyped == 1 { c" site is" } else { c" sites are" });
            buf_str(d,
                c" left: the checker gave no type there (a generic function never instantiated)\n");
        }
    }
}

// Each `$x...` of nodes first..last is an element of a list (the
// arguments of a call, a tuple, an array; 0.15: the statements of a
// block), one per list. False after the diagnostic.
fn rest_holes_in_lists(first: i64, last: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut rests: i64 = 0;
    let mut listed: i64 = 0;
    for n in first..last {
        let h = hole_of(n, tcx, pcx);
        if h >= 0 && (tcx.h_rest[h as usize]) != 0 {
            rests += 1;
        }
        let k = pk(n, pcx);
        if k != NodeKind::Call && k != NodeKind::MethodCall && k != NodeKind::Tuple
            && k != NodeKind::Array && k != NodeKind::Block {
            continue;
        }
        let mut here: i64 = 0;
        for i in 0..seq_len(n, pcx) {
            if rest_hole_of(seq_at(n, i, pcx), tcx, pcx) >= 0 {
                here += 1;
            }
        }
        if here > 1 {
            let d = diag(c"error", c"rewrite.pattern", tcx);
            buf_str(d, c"one $x... per list of arguments or block\n");
            return false;
        }
        listed += here;
    }
    if rests != listed {
        let d = diag(c"error", c"rewrite.pattern", tcx);
        buf_str(d,
            c"$x... stands for arguments or statements: write it in the arguments of a call, a tuple or an array, or among a block's statements\n");
        return false;
    }
    true
}

// Sorts nodes by position.
pub fn sort_by_start(v: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 && pstart(v[j], pcx) < pstart(v[j - 1], pcx) {
            let t = v[j];
            v[j] = v[j - 1];
            v[j - 1] = t;
            j -= 1;
        }
    }
}
