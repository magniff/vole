// `volec fix --values` (0.17, docs/design/value-semantics.md §5): the
// parameters rewritten for references, with every call.
//
// - Rule 2: a non-`mut` `p: *T` (`self: *T`) of a safe function becomes
//   `&mut T` when the function writes through it, else `&T`; the calls'
//   `&x` become `&mut x` for a `&mut` parameter (a receiver `x.m()` is
//   referenced by itself), a raw pointer passed on becomes `&mut *p`.
//   (0.18.1) A raw pointer stays `*T`: a parameter passed on to C's, an
//   unsafe fn's or a `mut` one, given `c"..."` or null, compared, indexed
//   (`p[i]`, `&p[i]`), cast or stored (`let`, an aggregate), and one passed
//   on to such a parameter (F_RAW).
// - Rule 3: a slice parameter that is written becomes `&mut [T]`; the
//   calls' `a[..]` become `&mut a[..]`, `v.as_slice()` `v.as_mut_slice()`.
// - Rule 4, the move migration: a by-value parameter of an owned type
//   (holding a Vec, Buf, HashMap) that the function only reads becomes
//   `&T`, the calls' `v` `&v`, its own `&v` `v`.
//
// "Writes" and "only reads" are computed over the whole program, callees
// first, to a fixed point: passing `p` (or `&p.f`) on to a parameter that
// is written writes `p`; passing `v` by value to a parameter that keeps it
// moves `v`. std's functions are read (their `*T` receivers count by their
// bodies) and never rewritten. A method of a trait of the program changes
// with its trait: the declaration and every impl together, `&mut T` when
// one of them writes (an impl of a trait that declares `&T`, std's Eq,
// Ord, Hash, is spelled so). A function used as a value, an `unsafe fn`,
// C's and `main` keep their signatures.
// A call whose argument cannot be rewritten (a temporary to a `&T`, a
// slice local to a `&mut [T]`) keeps its parameter as it is, and the fixed
// point runs again. Left to hand (§5 rule 7): conflicts, views of statics,
// trait methods taking `self: Self`. Rule 1: `defer x.free();` of a Vec,
// Buf or HashMap local of the same block is deleted, once the container
// has a Drop (std's, T4): its drop frees it.

use crate::base::{buf_byte, buf_bytes, buf_new, buf_str, get_src, intern, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{FN_UNSAFE, NODE_RAW, NODE_REF_MUT, NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::own::kinds::is_owned_type;
use crate::front::traits::{impl_of_fn, trait_fn};
use crate::front::types::{REF_MUT, TyKind, fn_param};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::defs::{K_IMPL_METHOD, K_TRAIT_FN, def_of_node};

// The classes of parameters (pclass).
const PC_NONE: i64 = 0;
const PC_PTR: i64 = 1;
const PC_SLICE: i64 = 2;
const PC_OWNED: i64 = 3;

// The flags of a parameter (per function node and index).
const F_WRITE: i64 = 1;
const F_MOVE: i64 = 2;
const F_FORCED: i64 = 4;

// (a raw pointer: indexed, `p[1]`, or passed on to a raw parameter, C's,
// an unsafe fn's, a `mut` one or another raw one: it stays `*T`, and so
// does a parameter passed on to it)
const F_RAW: i64 = 8;

// The conversions (conv).
const CV_NONE: i64 = 0;
const CV_MUT: i64 = 1;
const CV_SHARED: i64 = 2;
const CV_MUT_SLICE: i64 = 3;
const CV_OWNED_REF: i64 = 4;

// Contexts of a use.
const CX_READ: i64 = 0;
const CX_MOVE: i64 = 1;
// (moved into a local: `let q = p;`, `q = p;`)
const CX_BIND: i64 = 2;

// The phases of a walk of a body: marking the flags, finding the calls
// that cannot be rewritten, making the edits.
const PH_MARK: i64 = 0;
const PH_VERIFY: i64 = 1;
const PH_EDIT: i64 = 2;

// The template's node of function f (an instance's flags are its
// template's).
fn base_node(f: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.fns[f as usize].tmpl > 0 { pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node }
    else { pcx.fns[f as usize].node }
}

// The declaration of the program trait method f implements or is (a
// default body), or 0.
fn group_of(f: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    tcx.fixvalues_group.get(base_node(f, pcx) + 1)
}

// Whether parameter i of the trait declaration decl is a non-`mut` `*T`
// of a T that is neither a pointer nor a slice (by its text: a
// declaration without a body has no function of its own).
fn decl_ptr(decl: i64, i: i64, pcx: &Ctx<Comp>) -> bool {
    if i >= pcx.nodes[decl as usize].count || (pcx.nodes[decl as usize].p & 64) != 0 {
        return false;
    }
    let pn = child(decl, i, pcx);
    let tn = pcx.nodes[pn as usize].b;
    if pcx.nodes[pn as usize].c != 0 || tn <= 0
        || get_src()[pcx.nodes[tn as usize].start as usize] != b'*' {
        return false;
    }
    let mut s = pcx.nodes[tn as usize].start + 1;
    while get_src()[s as usize] == b' ' {
        s += 1;
    }
    get_src()[s as usize] != b'*' && get_src()[s as usize] != b'['
}

// The flags of parameter i over every member of decl's group.
fn group_flags(decl: i64, i: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut fl: i64 = 0;
        let mut k: i64 = 0;
        while k < tcx.members.count {
            if (*tcx.members.data.add(k as usize)) == decl {
                fl = fl | flags((*tcx.members.data.add((k + 1) as usize)), i, tcx, pcx);
            }
            k += 2;
        }
        fl
    }
}

// The conversion parameter i of trait method decl gets, the same for the
// declaration and every member: `&mut T` when one of them writes through
// it, else `&T`; none when one of them cannot change (a raw parameter, a
// function used as a value, an `unsafe fn`, a call that keeps it).
fn group_conv(decl: i64, i: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if !decl_ptr(decl, i, pcx) || tcx.fixvalues_as_value.get(decl + 1) != 0 {
            return CV_NONE;
        }
        let mut k: i64 = 0;
        while k < tcx.members.count {
            if (*tcx.members.data.add(k as usize)) == decl {
                let f = (*tcx.members.data.add((k + 1) as usize));
                if pcx.fns[f as usize].export || (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0
                    || tcx.fixvalues_as_value.get(base_node(f, pcx) + 1) != 0
                    || pclass(f, i, pcx) != PC_PTR {
                    return CV_NONE;
                }
            }
            k += 2;
        }
        let fl = group_flags(decl, i, tcx, pcx);
        if (fl & F_FORCED) != 0 {
            return CV_NONE;
        }
        if (fl & F_WRITE) != 0 { CV_MUT } else { CV_SHARED }
    }
}

// The members of the program's traits (MEMBERS, GROUP).
fn find_groups(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if !has_body(f, pcx) || pcx.fns[f as usize].tmpl > 0 {
            continue;
        }
        let node = pcx.fns[f as usize].node;
        if in_std(pcx.nodes[node as usize].start, pcx) || tcx.fixvalues_group.get(node + 1) != 0 {
            continue;
        }
        let mut decl: i64 = 0;
        let im = impl_of_fn(f, pcx);
        if im >= 0 && pcx.traits_impls[im as usize].tr >= 0 {
            decl = trait_fn(pcx.traits_impls[im as usize].tr, pcx.nodes[node as usize].a, pcx);
        } else {
            let d = def_of_node(node, tcx, pcx);
            if d >= 0 && pcx.defs[d as usize].kind == K_TRAIT_FN {
                decl = node;
            }
        }
        if decl <= 0 || in_std(pcx.nodes[decl as usize].start, pcx) {
            continue;
        }
        tcx.fixvalues_group.put(node + 1, decl);
        tcx.members.push(decl);
        tcx.members.push(f);
    }
}

fn key(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    base_node(f, pcx) * 64 + i + 1
}

fn flags(f: i64, i: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    tcx.fixvalues_flags.get(key(f, i, pcx))
}

fn mark(f: i64, i: i64, bits: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let old = tcx.fixvalues_flags.get(key(f, i, pcx));
    if (old | bits) != old {
        tcx.fixvalues_flags.put(key(f, i, pcx), old | bits);
        tcx.fixvalues_changed = true;
    }
}

fn has_body(f: i64, pcx: &Ctx<Comp>) -> bool {
    let item = pcx.fns[f as usize].node;
    f >= 0 && !pcx.fns[f as usize].is_extern && item > 0
        && pcx.nodes[item as usize].kind == NodeKind::Fn && pcx.nodes[item as usize].c != 0
}

fn in_std(pos: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { (*pcx.files[file_of_pos(pos, pcx) as usize].path.add(0)) == b'<' }
}

// Whether f's signature may change: a safe function of the program, not
// C's, a trait's or an impl's of one, not used as a value, not main.
fn eligible(f: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if !has_body(f, pcx) || pcx.fns[f as usize].export
        || (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 {
        return false;
    }
    let node = base_node(f, pcx);
    if in_std(pcx.nodes[node as usize].start, pcx) || tcx.fixvalues_as_value.get(node + 1) != 0 {
        return false;
    }
    let name = sym_text(pcx.nodes[node as usize].a, pcx);
    if name.len() == 4 && name[0] == b'm' && name[1] == b'a' && name[2] == b'i'
        && name[3] == b'n'
        && pcx.fns[f as usize].self_ty == 0 {
        return false;
    }
    let d = def_of_node(node, tcx, pcx);
    // (a closure's function has no definition: its type is its
    // caller's to choose)
    d >= 0 && pcx.defs[d as usize].kind != K_IMPL_METHOD && pcx.defs[d as usize].kind != K_TRAIT_FN
}

// The class of parameter i of f, by its type and how it is written.
fn pclass(f: i64, i: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if i >= pcx.fns[f as usize].param_count || i >= 63 {
        return PC_NONE;
    }
    let item = pcx.fns[f as usize].node;
    if item <= 0 || i >= pcx.nodes[item as usize].count {
        return PC_NONE;
    }
    let pn = child(item, i, pcx);
    let tn = pcx.nodes[pn as usize].b;
    let t = fn_param(f, i, pcx);
    if t <= 0 || tn <= 0 {
        return PC_NONE;
    }
    let k = pcx.types[t as usize].kind;
    // (not `**T` nor `*[T]`: a reference to a pointer or a slice is
    // left to hand)
    if k == TyKind::Ptr && pcx.types[t as usize].b == 0 && pcx.nodes[pn as usize].c == 0
        && get_src()[pcx.nodes[tn as usize].start as usize] == b'*' && pcx.types[t as usize].a > 0
        && pcx.types[pcx.types[t as usize].a as usize].kind != TyKind::Ptr
        && pcx.types[pcx.types[t as usize].a as usize].kind != TyKind::Slice {
        return PC_PTR;
    }
    if k == TyKind::Slice && pcx.types[t as usize].b != REF_MUT
        && get_src()[pcx.nodes[tn as usize].start as usize] == b'[' {
        return PC_SLICE;
    }
    if k != TyKind::Ptr && k != TyKind::Slice && pcx.fns[f as usize].generic == 0
        && pcx.fns[f as usize].tmpl == 0
        && get_src()[pcx.nodes[tn as usize].start as usize] != b'&' && is_owned_type(t, pcx) {
        return PC_OWNED;
    }
    PC_NONE
}

// The conversion parameter i of f gets.
fn conv(f: i64, i: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if f < 0 {
        return CV_NONE;
    }
    // (a trait method: its group's)
    let g = group_of(f, tcx, pcx);
    if g > 0 {
        return group_conv(g, i, tcx, pcx);
    }
    if !eligible(f, tcx, pcx) {
        return CV_NONE;
    }
    let c = pclass(f, i, pcx);
    let fl = flags(f, i, tcx, pcx);
    if c == PC_NONE || (fl & F_FORCED) != 0 {
        return CV_NONE;
    }
    if c == PC_PTR {
        return if (fl & F_WRITE) != 0 { CV_MUT } else { CV_SHARED };
    }
    if c == PC_SLICE {
        return if (fl & F_WRITE) != 0 { CV_MUT_SLICE } else { CV_NONE };
    }
    if (fl & (F_WRITE | F_MOVE)) != 0 { CV_NONE } else { CV_OWNED_REF }
}

// Whether a call of f may write through (or into) what its parameter i
// gets.
fn callee_writes(f: i64, i: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if f < 0 || pcx.fns[f as usize].is_extern || i >= pcx.fns[f as usize].param_count {
        return true;
    }
    let t = fn_param(f, i, pcx);
    if t <= 0 {
        return true;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Slice {
        if pcx.types[t as usize].b == REF_MUT {
            return true;
        }
    } else if k == TyKind::Ptr {
        if pcx.types[t as usize].b == REF_MUT {
            return true;
        }
        if pcx.types[t as usize].b != 0 {
            return false;
        }
        let item = pcx.fns[f as usize].node;
        if (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 || item <= 0
            || i >= pcx.nodes[item as usize].count
            || pcx.nodes[child(item, i, pcx) as usize].c != 0 {
            return true;
        }
    } else {
        return false;
    }
    if !has_body(f, pcx) {
        return true;
    }
    let g = group_of(f, tcx, pcx);
    let fl = if g > 0 { group_flags(g, i, tcx, pcx) } else { flags(f, i, tcx, pcx) };
    (fl & F_WRITE) != 0 || (fl & F_FORCED) != 0 && k == TyKind::Ptr
}

// Whether parameter i of f is a raw pointer that stays one: C's, an
// `unsafe fn`'s, a `mut p: *T`, or one the walk found raw (F_RAW).
fn callee_raw(f: i64, i: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if f < 0 || i >= pcx.fns[f as usize].param_count {
        return false;
    }
    let t = fn_param(f, i, pcx);
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Ptr || pcx.types[t as usize].b != 0 {
        return false;
    }
    if pcx.fns[f as usize].is_extern || (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 {
        return true;
    }
    let item = pcx.fns[f as usize].node;
    if item > 0 && i < pcx.nodes[item as usize].count
        && pcx.nodes[child(item, i, pcx) as usize].c != 0 {
        return true;
    }
    group_of(f, tcx, pcx) <= 0 && has_body(f, pcx) && (flags(f, i, tcx, pcx) & F_RAW) != 0
}

// Whether a call of f keeps (moves) the value its by-value parameter i
// gets: unless the parameter becomes `&T`.
fn callee_consumes(f: i64, i: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    conv(f, i, tcx, pcx) != CV_OWNED_REF
}

// The parameter index of local l of the function walked, or -1.
fn param_of_local(l: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        if l < 0 {
            return -1;
        }
        for i in 0..tcx.cur_locals.count {
            if (*tcx.cur_locals.data.add(i as usize)) == l {
                return i;
            }
        }
        -1
    }
}

// The parameter expression n is (a bare name), or -1.
fn param_ident(n: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 || pcx.nodes[n as usize].kind != NodeKind::Ident
        || pcx.nodes[n as usize].res != Res::Local {
        return -1;
    }
    param_of_local(pcx.nodes[n as usize].y, tcx)
}

// The root of place n (through fields, indexes, derefs); its node.
fn place_root(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e = n;
    while e > 0 {
        let k = pcx.nodes[e as usize].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
            e = pcx.nodes[e as usize].a;
        } else if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star {
            e = pcx.nodes[e as usize].b;
        } else {
            return e;
        }
    }
    e
}

// Whether place n is reached through a raw pointer: a field, an index or
// a deref of a `*T` that stays raw (`&t.blocks[i].preds`, blocks a `*T`).
fn through_raw(n: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut e = n;
    while e > 0 {
        let k = pcx.nodes[e as usize].kind;
        let mut base: i64 = 0;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index {
            base = pcx.nodes[e as usize].a;
        } else if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star {
            base = pcx.nodes[e as usize].b;
        } else {
            return false;
        }
        let t = pcx.nodes[base as usize].ty;
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0 {
            let p = param_ident(base, tcx, pcx);
            if p < 0 || conv(tcx.fixvalues_cur_f, p, tcx, pcx) == CV_NONE {
                return true;
            }
        }
        e = base;
    }
    false
}

// The root a write to place n writes: place_root, and through a method's
// receiver when the place is its result (`v[i] = x` on a borrowed Vec is
// `v.as_slice()[i] = x`).
fn write_root(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut r = place_root(n, pcx);
    let mut steps: i64 = 0;
    while r > 0 && pcx.nodes[r as usize].kind == NodeKind::Call && pcx.nodes[r as usize].count > 0
        && steps < 8 {
        let mut a = child(r, 0, pcx);
        if pcx.nodes[a as usize].kind == NodeKind::Unary && pcx.nodes[a as usize].op == Tok::Amp {
            a = pcx.nodes[a as usize].b;
        }
        r = place_root(a, pcx);
        steps += 1;
    }
    r
}

// Whether place n goes through a deref or an index (it is not its root).
fn deeper(n: i64, pcx: &Ctx<Comp>) -> bool {
    place_root(n, pcx) != n
}

// The expressions inside place n that are evaluated (indexes), and its
// root when it is no name.
fn place_parts(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut e = n;
    while e > 0 {
        let k = pcx.nodes[e as usize].kind;
        if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
            e = pcx.nodes[e as usize].a;
        } else if k == NodeKind::Index {
            scan(pcx.nodes[e as usize].b, CX_READ, tcx, pcx);
            e = pcx.nodes[e as usize].a;
        } else if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star {
            e = pcx.nodes[e as usize].b;
        } else {
            if k != NodeKind::Ident {
                scan(e, CX_READ, tcx, pcx);
            }
            return;
        }
    }
}

fn mark_cur(p: i64, bits: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.fixvalues_phase == PH_MARK && p >= 0 {
        mark(tcx.fixvalues_cur_f, p, bits, tcx, pcx);
    }
}

// A use of parameter p the walk knows nothing more about: a pointer kept
// somewhere may be written through; an owned value used as a value is not
// only read. (A slice kept, `let rest = s[1..]`, counts as read: a write
// through the copy is left to the checker, own.readonly.)
fn bare_use(p: i64, ctx: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let c = pclass(tcx.fixvalues_cur_f, p, pcx);
    if c == PC_OWNED {
        mark_cur(p, F_MOVE, tcx, pcx);
    } else if c == PC_PTR && ctx == CX_BIND && tcx.fixvalues_in_hole == 0 {
        // (a local made from it would be a reference, and a raw walk
        // `q = (*q).next` would no longer check: kept raw, `argv[0] = w0`)
        mark_cur(p, F_WRITE | F_FORCED | F_RAW, tcx, pcx);
    } else if c == PC_PTR && ctx == CX_MOVE && tcx.fixvalues_in_hole == 0 {
        mark_cur(p, F_WRITE, tcx, pcx);
    }
}

// Place n read (ctx: moved out when its value is owned).
fn place_read(n: i64, ctx: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    place_parts(n, tcx, pcx);
    let p = param_ident(place_root(n, pcx), tcx, pcx);
    if p < 0 {
        return;
    }
    if !deeper(n, pcx) {
        bare_use(p, ctx, tcx, pcx);
        return;
    }
    if pclass(tcx.fixvalues_cur_f, p, pcx) == PC_OWNED && (tcx.fixvalues_in_hole > 0
        || ctx != CX_READ && is_owned_type(pcx.nodes[n as usize].ty, pcx)) {
        mark_cur(p, F_MOVE, tcx, pcx);
    }
}

// Every parameter named inside n is used in ways unknown (a closure's
// captures).
fn mark_all(n: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if n <= 0 || tcx.fixvalues_phase != PH_MARK {
        return;
    }
    let s = pcx.nodes[n as usize].start;
    let e = pcx.nodes[n as usize].end;
    for m in n..pcx.nodes.len() as i64 {
        if pcx.nodes[m as usize].start >= s && pcx.nodes[m as usize].end <= e {
            let p = param_ident(m, tcx, pcx);
            if p >= 0 {
                mark_cur(p, F_WRITE | F_MOVE, tcx, pcx);
            }
        }
    }
    // (a capture's node can come before the closure's)
    for m in 1..n {
        if pcx.nodes[m as usize].start >= s && pcx.nodes[m as usize].end <= e
            && pcx.nodes[m as usize].kind == NodeKind::Ident {
            let p = param_ident(m, tcx, pcx);
            if p >= 0 {
                mark_cur(p, F_WRITE | F_MOVE, tcx, pcx);
            }
        }
    }
}

// Whether closure n is the one an f-string's Interp makes: the field `f`
// of the `std::Interp { f: ... }` its block ends with.
fn fstring_closure(n: i64, tcx: &Tcx<Comp>) -> bool {
    tcx.fixvalues_fstring_closures.get(n + 1) != 0
}

fn scan_list(n: i64, ctx: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        scan(child(n, i, pcx), ctx, tcx, pcx);
    }
}

// Whether `let` s is a `for`'s sequence (`__for_seq`, made by the checker)
// over a parameter.
fn for_sequence(s: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let pat = pcx.nodes[s as usize].a;
    if pat <= 0 || pcx.nodes[pat as usize].kind != NodeKind::PatBind {
        return false;
    }
    let name = sym_text(pcx.nodes[pat as usize].a, pcx);
    name.len() > 5 && name[0] == b'_' && name[1] == b'_' && name[2] == b'f' && name[3] == b'o'
        && name[4] == b'r' && param_ident(pcx.nodes[s as usize].c, tcx, pcx) >= 0
}

// Walks expression n of the current function.
fn scan(n: i64, ctx: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if n <= 0 {
        return;
    }
    match pcx.nodes[n as usize].kind {
        NodeKind::Ident => {
            let p = param_ident(n, tcx, pcx);
            if p >= 0 {
                bare_use(p, ctx, tcx, pcx);
            }
        }
        NodeKind::FieldAccess | NodeKind::TupleField => place_read(n, ctx, tcx, pcx),
        NodeKind::Unary => {
            let op = pcx.nodes[n as usize].op;
            if op == Tok::Star {
                place_read(n, ctx, tcx, pcx);
            } else if op == Tok::Amp {
                borrow(n, -1, -1, tcx, pcx);
            } else {
                scan(pcx.nodes[n as usize].b, CX_READ, tcx, pcx);
            }
        }
        NodeKind::Index => {
            if pcx.nodes[pcx.nodes[n as usize].b as usize].kind == NodeKind::Range {
                scan(pcx.nodes[n as usize].b, CX_READ, tcx, pcx);
                let p = param_ident(pcx.nodes[n as usize].a, tcx, pcx);
                if p >= 0 && pclass(tcx.fixvalues_cur_f, p, pcx) == PC_SLICE {
                    bare_use(p, ctx, tcx, pcx);
                } else {
                    place_parts(pcx.nodes[n as usize].a, tcx, pcx);
                }
            } else {
                // (pointer arithmetic on a `*T` parameter, `p[1]` in
                // unsafe code: it stays a raw pointer)
                let p = param_ident(pcx.nodes[n as usize].a, tcx, pcx);
                if p >= 0 && (pcx.nodes[n as usize].p & NODE_RAW) != 0 {
                    mark(tcx.fixvalues_cur_f, p, F_FORCED | F_RAW, tcx, pcx);
                }
                place_read(n, ctx, tcx, pcx);
            }
        }
        NodeKind::Cast => {
            // (`p as i64`, `p as *u8`: an address, a raw pointer)
            let p = param_ident(pcx.nodes[n as usize].a, tcx, pcx);
            if p >= 0 && pclass(tcx.fixvalues_cur_f, p, pcx) == PC_PTR {
                mark_cur(p, F_WRITE | F_FORCED | F_RAW, tcx, pcx);
            }
            scan(pcx.nodes[n as usize].a, CX_READ, tcx, pcx);
        }
        NodeKind::Binary => {
            // (`p == 0 as *T`, `p != q`: an address compared, a raw
            // pointer; a reference's `==` would compare the values)
            for side in [pcx.nodes[n as usize].b, pcx.nodes[n as usize].c] {
                let p = param_ident(side, tcx, pcx);
                if p >= 0 && pclass(tcx.fixvalues_cur_f, p, pcx) == PC_PTR {
                    mark_cur(p, F_WRITE | F_FORCED | F_RAW, tcx, pcx);
                }
            }
            scan(pcx.nodes[n as usize].b, CX_READ, tcx, pcx);
            scan(pcx.nodes[n as usize].c, CX_READ, tcx, pcx);
        }
        NodeKind::Assign => {
            let target = pcx.nodes[n as usize].b;
            scan(pcx.nodes[n as usize].c,
                if pcx.nodes[n as usize].op == Tok::Eq { CX_BIND } else { CX_READ }, tcx, pcx);
            place_parts(target, tcx, pcx);
            let p = param_ident(write_root(target, pcx), tcx, pcx);
            if p >= 0 {
                mark_cur(p, F_WRITE, tcx, pcx);
            }
        }
        NodeKind::Call => scan_call(n, tcx, pcx),
        NodeKind::Block => {
            for i in 0..pcx.nodes[n as usize].count {
                let s = child(n, i, pcx);
                let k = pcx.nodes[s as usize].kind;
                if k == NodeKind::Let && for_sequence(s, tcx, pcx) {
                    // (a `for` over a parameter reads it: by reference
                    // from 0.17)
                } else if k == NodeKind::Let {
                    scan(pcx.nodes[s as usize].c, CX_BIND, tcx, pcx);
                } else if k == NodeKind::Defer || k == NodeKind::ExprStmt {
                    scan(pcx.nodes[s as usize].a, CX_READ, tcx, pcx);
                } else {
                    scan(s, CX_READ, tcx, pcx);
                }
            }
            scan(pcx.nodes[n as usize].a, ctx, tcx, pcx);
        }
        NodeKind::If => {
            scan(pcx.nodes[n as usize].a, CX_READ, tcx, pcx);
            scan(pcx.nodes[n as usize].b, ctx, tcx, pcx);
            scan(pcx.nodes[n as usize].c, ctx, tcx, pcx);
        }
        NodeKind::Match => {
            scan(pcx.nodes[n as usize].a, CX_MOVE, tcx, pcx);
            for i in 0..pcx.nodes[n as usize].count {
                let arm = child(n, i, pcx);
                scan(pcx.nodes[arm as usize].b, CX_READ, tcx, pcx);
                scan(pcx.nodes[arm as usize].c, ctx, tcx, pcx);
            }
        }
        NodeKind::Loop => scan(pcx.nodes[n as usize].b, CX_READ, tcx, pcx),
        NodeKind::While => {
            scan(pcx.nodes[n as usize].b, CX_READ, tcx, pcx);
            scan(pcx.nodes[n as usize].c, CX_READ, tcx, pcx);
        }
        NodeKind::For => {
            // (`for x in v` reads v, by reference from 0.17)
            if param_ident(pcx.nodes[n as usize].c, tcx, pcx) < 0 {
                scan(pcx.nodes[n as usize].c, CX_READ, tcx, pcx);
            }
            scan(pcx.nodes[n as usize].d, CX_READ, tcx, pcx);
        }
        NodeKind::Break => scan(pcx.nodes[n as usize].b, CX_MOVE, tcx, pcx),
        NodeKind::Return => scan(pcx.nodes[n as usize].a, CX_MOVE, tcx, pcx),
        // (a pointer parameter kept in an aggregate: as by `let`)
        NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
            scan_list(n, CX_BIND, tcx, pcx);
        }
        NodeKind::FieldInit | NodeKind::NamedArg => scan(pcx.nodes[n as usize].b, ctx, tcx, pcx),
        NodeKind::Repeat => scan(pcx.nodes[n as usize].a, CX_MOVE, tcx, pcx),
        NodeKind::Range => {
            scan(pcx.nodes[n as usize].a, CX_READ, tcx, pcx);
            scan(pcx.nodes[n as usize].b, CX_READ, tcx, pcx);
        }
        NodeKind::Closure => {
            // (an f-string's closure, `std::Interp { f: |out| ... }`,
            // displays the locals its holes were bound to, `let __f0 =
            // e0`, which the walk reads: it spans the holes' source,
            // and is no capture of them)
            if !fstring_closure(n, tcx) {
                mark_all(pcx.nodes[n as usize].y, tcx, pcx);
            }
        }
        NodeKind::Try => scan(pcx.nodes[n as usize].y, ctx, tcx, pcx),
        NodeKind::Interp => {
            tcx.fixvalues_in_hole += 1;
            scan(pcx.nodes[n as usize].y, ctx, tcx, pcx);
            tcx.fixvalues_in_hole -= 1;
        }
        NodeKind::EnumPanic => scan(pcx.nodes[n as usize].a, CX_READ, tcx, pcx),
        NodeKind::VecOp => {
            scan(pcx.nodes[n as usize].a, CX_READ, tcx, pcx);
            scan_list(n, CX_READ, tcx, pcx);
        }
        _ => {}
    }
}

// `&place` (node n), passed as argument i of a call of f (f, i: -1, not
// an argument).
fn borrow(n: i64, f: i64, i: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let operand = pcx.nodes[n as usize].b;
    // (`&p[i]` of a `*T` parameter: pointer arithmetic, a raw pointer)
    if pcx.nodes[operand as usize].kind == NodeKind::Index
        && (pcx.nodes[operand as usize].p & NODE_RAW) != 0 {
        let q = param_ident(pcx.nodes[operand as usize].a, tcx, pcx);
        if q >= 0 && pclass(tcx.fixvalues_cur_f, q, pcx) == PC_PTR {
            mark_cur(q, F_WRITE | F_FORCED | F_RAW, tcx, pcx);
        }
    }
    place_parts(operand, tcx, pcx);
    let p = param_ident(place_root(operand, pcx), tcx, pcx);
    if p < 0 || tcx.fixvalues_in_hole > 0 {
        return;
    }
    let mutable = (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0;
    let receiver = i == 0 && pcx.nodes[n as usize].start == pcx.nodes[operand as usize].start;
    let c = pclass(tcx.fixvalues_cur_f, p, pcx);
    if mutable || (i >= 0 && callee_writes(f, i, tcx, pcx))
        || i < 0 && c == PC_PTR && deeper(operand, pcx) {
        mark_cur(p, F_WRITE, tcx, pcx);
    }
    // (an owned parameter's own `&v` becomes `v` once it is `&T`)
    if c == PC_OWNED && !receiver && !deeper(operand, pcx) && tcx.fixvalues_phase == PH_EDIT
        && conv(tcx.fixvalues_cur_f, p, tcx, pcx) == CV_OWNED_REF {
        replace_text(pcx.nodes[n as usize].start, pcx.nodes[operand as usize].start, c"", tcx, pcx);
    }
}

// Call n: each argument by what its parameter does with it.
fn scan_call(n: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[n as usize].x - 1;
    if f < 0 {
        scan(pcx.nodes[n as usize].a, CX_READ, tcx, pcx);
    }
    for i in 0..pcx.nodes[n as usize].count {
        let mut arg = child(n, i, pcx);
        if pcx.nodes[arg as usize].kind == NodeKind::NamedArg {
            arg = pcx.nodes[arg as usize].b;
        }
        argument(f, i, arg, n, tcx, pcx);
    }
}

// Argument arg of a call of f, at parameter i.
fn argument(f: i64, i: i64, arg: i64, call: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[arg as usize].kind;
    // (a method's receiver, `x.m()`, is referenced or dereferenced
    // by the checker: nothing to write)
    let receiver = i == 0 && pcx.nodes[arg as usize].start == pcx.nodes[call as usize].start;
    if tcx.fixvalues_phase != PH_MARK && f >= 0 && conv(f, i, tcx, pcx) != CV_NONE
        && !in_std(pcx.nodes[arg as usize].start, pcx)
        && !receiver {
        rewrite_argument(f, i, arg, tcx, pcx);
    }
    if k == NodeKind::Unary && pcx.nodes[arg as usize].op == Tok::Amp {
        borrow(arg, f, i, tcx, pcx);
        return;
    }
    let p = param_ident(arg, tcx, pcx);
    let slicing = k == NodeKind::Index
        && pcx.nodes[pcx.nodes[arg as usize].b as usize].kind == NodeKind::Range;
    let q = if slicing { param_ident(place_root(pcx.nodes[arg as usize].a, pcx), tcx, pcx) }
        else { p };
    if q >= 0 && !slicing && pclass(tcx.fixvalues_cur_f, q, pcx) == PC_PTR
        && callee_raw(f, i, tcx, pcx) {
        mark_cur(q, F_WRITE | F_FORCED | F_RAW, tcx, pcx);
        return;
    }
    if q >= 0 && tcx.fixvalues_in_hole == 0 {
        let c = pclass(tcx.fixvalues_cur_f, q, pcx);
        if slicing {
            scan(pcx.nodes[arg as usize].b, CX_READ, tcx, pcx);
        }
        if c == PC_PTR || c == PC_SLICE {
            if callee_writes(f, i, tcx, pcx) {
                mark_cur(q, F_WRITE, tcx, pcx);
            }
            return;
        }
        if c == PC_OWNED && !slicing {
            if f < 0 || callee_consumes(f, i, tcx, pcx) {
                mark_cur(q, F_MOVE, tcx, pcx);
            }
            return;
        }
    }
    // (a view of a parameter passed on, `v.as_slice()`, to a parameter
    // that is written: sort_by)
    // (a slice's `s.ptr` passed on, to C's memcpy: the pointer of a view,
    // read only as the view is; a write through it wants `&mut [T]`)
    let w = param_ident(write_root(arg, pcx), tcx, pcx);
    let view_ptr = k == NodeKind::FieldAccess
        && param_ident(pcx.nodes[arg as usize].a, tcx, pcx) == w && w >= 0
        && pclass(tcx.fixvalues_cur_f, w, pcx) == PC_SLICE;
    if w >= 0 && tcx.fixvalues_in_hole == 0 && pclass(tcx.fixvalues_cur_f, w, pcx) != PC_NONE
        && !view_ptr
        && callee_writes(f, i, tcx, pcx) {
        mark_cur(w, F_WRITE, tcx, pcx);
    }
    let by_value = f < 0 || i >= pcx.fns[f as usize].param_count || fn_param(f, i, pcx) <= 0
        || pcx.types[fn_param(f, i, pcx) as usize].kind != TyKind::Ptr;
    scan(arg, if by_value { CX_MOVE } else { CX_READ }, tcx, pcx);
}

// ---- the edits ----

fn replace_text(a: i64, b: i64, text: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if tcx.fixvalues_edited.get(a + 1) != 0 {
        return;
    }
    let t = buf_new();
    buf_str(t, text);
    if edit_replace(a, b, t, pcx) {
        tcx.fixvalues_edited.put(a + 1, 1);
    }
}

fn force(f: i64, i: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    mark(f, i, F_FORCED, tcx, pcx);
}

fn plain_expr(n: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[n as usize].kind;
    k == NodeKind::Ident || k == NodeKind::FieldAccess || k == NodeKind::TupleField
        || k == NodeKind::Call || k == NodeKind::Index
}

// Argument arg of a call of f at parameter i, whose type changes (conv):
// rewritten (PH_EDIT), or the parameter kept (forced) when it cannot be.
fn rewrite_argument(f: i64, i: i64, arg: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let cv = conv(f, i, tcx, pcx);
    let k = pcx.nodes[arg as usize].kind;
    let t = pcx.nodes[arg as usize].ty;
    let p = param_ident(arg, tcx, pcx);
    let caller = if p >= 0 { conv(tcx.fixvalues_cur_f, p, tcx, pcx) } else { CV_NONE };
    let edit = tcx.fixvalues_phase == PH_EDIT;
    if cv == CV_MUT || cv == CV_SHARED {
        if k == NodeKind::Unary && pcx.nodes[arg as usize].op == Tok::Amp {
            let operand = pcx.nodes[arg as usize].b;
            if i == 0 && pcx.nodes[arg as usize].start == pcx.nodes[operand as usize].start {
                return;
            }
            // (`&` of a place reached through a raw pointer stays raw)
            if through_raw(operand, tcx, pcx) {
                force(f, i, tcx, pcx);
                return;
            }
            if cv == CV_MUT && (pcx.nodes[arg as usize].p & NODE_REF_MUT) == 0 && edit {
                replace_text(pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].start + 1,
                    c"&mut ", tcx, pcx);
                tcx.values_counts[4] += 1;
            }
            return;
        }
        if p >= 0 && (caller == CV_MUT || caller == CV_SHARED) {
            if caller == CV_SHARED && cv == CV_MUT {
                force(f, i, tcx, pcx);
            }
            return;
        }
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != 0 {
            if pcx.types[t as usize].b != REF_MUT && cv == CV_MUT {
                force(f, i, tcx, pcx);
            }
            return;
        }
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            // (a C string, `c"..."`, or null, `0 as *T`, passed: a
            // raw pointer, which no reference can be)
            if k == NodeKind::CStr || k == NodeKind::Cast {
                mark(f, i, F_FORCED | F_RAW, tcx, pcx);
                return;
            }
            if edit {
                wrap(arg, if cv == CV_MUT { c"&mut *" } else { c"&*" }, tcx, pcx);
                tcx.values_counts[4] += 1;
            }
            return;
        }
        force(f, i, tcx, pcx);
        return;
    }
    if cv == CV_MUT_SLICE {
        if p >= 0 && caller == CV_MUT_SLICE {
            return;
        }
        if t > 0 && pcx.types[t as usize].kind == TyKind::Slice
            && pcx.types[t as usize].b == REF_MUT {
            return;
        }
        if k == NodeKind::Index
            && pcx.nodes[pcx.nodes[arg as usize].b as usize].kind == NodeKind::Range {
            if edit {
                replace_text(pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].start, c"&mut ",
                    tcx, pcx);
                tcx.values_counts[4] += 1;
            }
            return;
        }
        let s = &get_src()[
            pcx.nodes[arg as usize].start as usize..pcx.nodes[arg as usize].end as usize];
        let tail = ".as_slice()";
        if tcx.has_as_mut_slice && s.len() > tail.len()
            && same(&s[(s.len() as i64 - tail.len() as i64) as usize..], tail.as_bytes()) {
            if edit {
                replace_text(pcx.nodes[arg as usize].end - tail.len() as i64,
                    pcx.nodes[arg as usize].end, c".as_mut_slice()", tcx, pcx);
                tcx.values_counts[4] += 1;
            }
            return;
        }
        force(f, i, tcx, pcx);
        return;
    }
    if cv == CV_OWNED_REF {
        if p >= 0 && caller == CV_OWNED_REF {
            return;
        }
        let root = place_root(arg, pcx);
        if (k == NodeKind::Ident || k == NodeKind::FieldAccess || k == NodeKind::TupleField)
            && pcx.nodes[root as usize].kind == NodeKind::Ident
            && (pcx.nodes[root as usize].res == Res::Local
                || pcx.nodes[root as usize].res == Res::Static) {
            if edit {
                replace_text(pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].start, c"&",
                    tcx, pcx);
                tcx.values_counts[4] += 1;
            }
            return;
        }
        force(f, i, tcx, pcx);
    }
}

// Wraps arg: PREFIX(arg), parentheses unless it is a name, a field, a
// call or an index.
fn wrap(arg: i64, prefix: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let a = pcx.nodes[arg as usize].start;
    let b = pcx.nodes[arg as usize].end;
    if tcx.fixvalues_edited.get(a + 1) != 0 {
        return;
    }
    let t = buf_new();
    buf_str(t, prefix);
    let plain = plain_expr(arg, pcx);
    if !plain {
        buf_byte(t, b'(');
    }
    buf_bytes(t, &get_src()[a as usize..b as usize]);
    if !plain {
        buf_byte(t, b')');
    }
    if edit_replace(a, b, t, pcx) {
        tcx.fixvalues_edited.put(a + 1, 1);
    }
}

fn same(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// The parameters' types of function f, rewritten (PH_EDIT).
fn edit_params(f: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let item = pcx.fns[f as usize].node;
    for i in 0..pcx.fns[f as usize].param_count {
        let cv = conv(f, i, tcx, pcx);
        if cv == CV_NONE || i >= pcx.nodes[item as usize].count {
            continue;
        }
        let tn = pcx.nodes[child(item, i, pcx) as usize].b;
        let s = pcx.nodes[tn as usize].start;
        if tcx.fixvalues_edited.get(s + 1) != 0 {
            continue;
        }
        if cv == CV_MUT {
            replace_text(s, s + 1, c"&mut ", tcx, pcx);
            tcx.values_counts[0] += 1;
        } else if cv == CV_SHARED {
            replace_text(s, s + 1, c"&", tcx, pcx);
            tcx.values_counts[1] += 1;
        } else if cv == CV_MUT_SLICE {
            replace_text(s, s, c"&mut ", tcx, pcx);
            tcx.values_counts[2] += 1;
        } else {
            replace_text(s, s, c"&", tcx, pcx);
            tcx.values_counts[3] += 1;
        }
    }
}

// Walks the body of every function with a body (std's too: their writes
// count) in phase ph.
fn walk_all(ph: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    tcx.fixvalues_phase = ph;
    for f in 0..pcx.fns.len() as i64 {
        if !has_body(f, pcx) || pcx.fns[f as usize].generic > 0 && pcx.fns[f as usize].tmpl == 0 {
            continue;
        }
        let item = pcx.fns[f as usize].node;
        if ph != PH_MARK && in_std(pcx.nodes[item as usize].start, pcx) {
            continue;
        }
        tcx.fixvalues_cur_f = f;
        tcx.cur_locals.count = 0;
        for i in 0..pcx.nodes[item as usize].count {
            tcx.cur_locals.push(pcx.nodes[child(item, i, pcx) as usize].x);
        }
        tcx.fixvalues_in_hole = 0;
        if ph == PH_EDIT && (eligible(f, tcx, pcx) || group_of(f, tcx, pcx) > 0) {
            edit_params(f, tcx, pcx);
        }
        scan(pcx.nodes[item as usize].c, CX_MOVE, tcx, pcx);
    }
}

// The trait declarations of the groups, rewritten as their members are
// (PH_EDIT: a declaration without a body is no function walk_all sees).
fn edit_decls(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut k: i64 = 0;
        while k < tcx.members.count {
            let decl = (*tcx.members.data.add(k as usize));
            k += 2;
            for i in 0..pcx.nodes[decl as usize].count {
                let cv = group_conv(decl, i, tcx, pcx);
                let s = pcx.nodes[pcx.nodes[child(decl, i, pcx) as usize].b as usize].start;
                if cv == CV_NONE || tcx.fixvalues_edited.get(s + 1) != 0 {
                    continue;
                }
                if cv == CV_MUT {
                    replace_text(s, s + 1, c"&mut ", tcx, pcx);
                    tcx.values_counts[0] += 1;
                } else {
                    replace_text(s, s + 1, c"&", tcx, pcx);
                    tcx.values_counts[1] += 1;
                }
            }
        }
    }
}

// (0.17) An impl's `*T` parameter where its trait declares `&T` or `&mut
// T` (std's Eq, Ord, Hash, Drop; a trait already rewritten) is the
// trait's type already (front::traits::check_impl_signatures): it is
// spelled so, and no call changes.
fn respell_impls(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if !has_body(f, pcx) || pcx.fns[f as usize].tmpl > 0 {
            continue;
        }
        let node = pcx.fns[f as usize].node;
        let im = impl_of_fn(f, pcx);
        if in_std(pcx.nodes[node as usize].start, pcx) || im < 0
            || pcx.traits_impls[im as usize].tr < 0 {
            continue;
        }
        let decl = trait_fn(pcx.traits_impls[im as usize].tr, pcx.nodes[node as usize].a, pcx);
        if decl <= 0 || decl == node {
            continue;
        }
        let mut i: i64 = 0;
        while i < pcx.nodes[node as usize].count && i < pcx.nodes[decl as usize].count {
            let pn = child(node, i, pcx);
            let tn = pcx.nodes[pn as usize].b;
            let dp = child(decl, i, pcx);
            let dn = pcx.nodes[dp as usize].b;
            i += 1;
            if pcx.nodes[pn as usize].c != 0 || tn <= 0
                || get_src()[pcx.nodes[tn as usize].start as usize] != b'*'
                || tcx.fixvalues_edited.get(pcx.nodes[tn as usize].start + 1) != 0 {
                continue;
            }
            let s = pcx.nodes[tn as usize].start;
            // (0.20: a trait in 0.20's spelling, std's `fn cmp(self, other:
            // Self)`: a let parameter is `&T` in 0.19's, an inout one
            // `&mut T`)
            let conv = crate::front::conv::param_conv(dp, pcx);
            if (dn <= 0 || get_src()[pcx.nodes[dn as usize].start as usize] != b'&')
                && (conv == crate::front::conv::CONV_LET
                    || conv == crate::front::conv::CONV_IN_OUT)
                && (pcx.nodes[dp as usize].p & crate::front::ast::CONV_NEW) != 0 {
                if conv == crate::front::conv::CONV_IN_OUT {
                    replace_text(s, s + 1, c"&mut ", tcx, pcx);
                    tcx.values_counts[0] += 1;
                } else {
                    replace_text(s, s + 1, c"&", tcx, pcx);
                    tcx.values_counts[1] += 1;
                }
                continue;
            }
            if dn <= 0 || get_src()[pcx.nodes[dn as usize].start as usize] != b'&' {
                continue;
            }
            let mut d = pcx.nodes[dn as usize].start + 1;
            while get_src()[d as usize] == b' ' {
                d += 1;
            }
            if get_src()[d as usize] == b'm' && get_src()[(d + 1) as usize] == b'u'
                && get_src()[(d + 2) as usize] == b't' && get_src()[(d + 3) as usize] == b' ' {
                replace_text(s, s + 1, c"&mut ", tcx, pcx);
                tcx.values_counts[0] += 1;
            } else {
                replace_text(s, s + 1, c"&", tcx, pcx);
                tcx.values_counts[1] += 1;
            }
        }
    }
}

// The functions used as values (an Ident or Path naming one that is not a
// call's callee).
fn find_values(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut callees = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() {
        if pcx.nodes[n].kind == NodeKind::Call && pcx.nodes[n].a > 0 {
            callees.put(pcx.nodes[n].a + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if (k == NodeKind::Ident || k == NodeKind::Path) && pcx.nodes[n as usize].res == Res::Fn
            && pcx.nodes[n as usize].y >= 0 && callees.get(n + 1) == 0 {
            tcx.fixvalues_as_value.put(base_node(pcx.nodes[n as usize].y, pcx) + 1, 1);
        }
    }
    // (an Interp's y: `{ let __f0 = e0; ...; std::Interp { f: closure } }`)
    for n in 1..pcx.nodes.len() {
        let y = pcx.nodes[n].y;
        if pcx.nodes[n].kind == NodeKind::Interp && y > 0
            && pcx.nodes[y as usize].kind == NodeKind::Block {
            let lit = pcx.nodes[y as usize].a;
            if lit > 0 && pcx.nodes[lit as usize].kind == NodeKind::StructLit
                && pcx.nodes[lit as usize].count > 0 {
                let f = pcx.nodes[child(lit, 0, pcx) as usize].b;
                if f > 0 && pcx.nodes[f as usize].kind == NodeKind::Closure {
                    tcx.fixvalues_fstring_closures.put(f + 1, 1);
                }
            }
        }
    }
    let sym = intern(b"as_mut_slice", pcx);
    for d in 0..pcx.defs.len() {
        if pcx.defs[d].name == sym {
            tcx.has_as_mut_slice = true;
        }
    }
}

// The edits of `fix --values`; the number of parameters changed.
pub fn values_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    find_values(tcx, pcx);
    find_groups(tcx, pcx);
    // (the flags to a fixed point; then the calls checked, and again
    // while one forces a parameter to stay)
    let mut rounds: i64 = 0;
    while rounds < 64 {
        tcx.fixvalues_changed = true;
        while tcx.fixvalues_changed {
            tcx.fixvalues_changed = false;
            walk_all(PH_MARK, tcx, pcx);
        }
        tcx.fixvalues_changed = false;
        walk_all(PH_VERIFY, tcx, pcx);
        if !tcx.fixvalues_changed {
            break;
        }
        rounds += 1;
    }
    walk_all(PH_EDIT, tcx, pcx);
    edit_decls(tcx, pcx);
    respell_impls(tcx, pcx);
    tcx.values_counts[0] + tcx.values_counts[1] + tcx.values_counts[2] + tcx.values_counts[3]
}
