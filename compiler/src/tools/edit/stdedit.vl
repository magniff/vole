// Editing std by name (0.17). In the vole repository, an edit whose
// target is a std item (`edit patch std::trim`, `edit insert --after
// Vec::push`, `edit replace std::split`, a block of `edit apply`) runs
// again with `--std-tree compiler/std`: std then comes from its files
// (front/stdtree.vl), so the edit is made in compiler/std/FILE.vl and
// checked with the edited std; after it, compiler/std/embed.sh makes
// compiler/src/front/stdsrc.vl, the text built into the compiler, from
// the files again (`note edit.std`). Outside the repository std is the
// compiler's own text and such an edit is refused (`edit.not-source`).

use crate::base::{buf_copy, buf_new, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Line, c_words};
use crate::front::stdtree::{find_std_tree, tree_path};
use crate::tools::ctx::Tcx;
use crate::tools::proc::{exec_words, read_file_if, run_capture, run_with_stdin};
use crate::tools::query::diagnostics::diag;

// Whether std_rerun asked for the command to run again.
pub fn rerun_wanted(tcx: &Tcx<Comp>) -> bool {
    tcx.rerun
}

// The command (its line) again with `--std-tree DIR`, given what this
// process read of stdin; then, when it wrote std's files, embed.sh. Its
// status.
pub fn rerun_in_std_tree(line: Line<'_>, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let dir = find_std_tree(pcx);
    let mut words = c_words(line);
    words.push(c"--std-tree" as i64);
    words.push(dir as i64);
    let status = run_with_stdin(exec_words(words.as_slice()).as_slice(), tcx.stdin_read);
    if status == 0 && !tcx.dry_run {
        embed_std(dir, tcx);
    }
    status
}

// compiler/std/embed.sh, when stdsrc.vl is not std's files' text: the
// note saying it ran (or the warning that it failed).
pub fn embed_std(dir: *const u8, tcx: &mut Tcx<Comp>) {
    let script = tree_path(dir, c"embed.sh");
    let out = buf_new();
    let check = [c"sh", script, c"-c", 0 as *mut u8];
    if run_capture(&check, out) == 0 {
        return;
    }
    let run = [c"sh", script, 0 as *mut u8];
    if run_capture(&run, out) != 0 {
        let d = diag(c"warning", c"edit.std", tcx);
        buf_str(d, script);
        buf_str(d, c" failed: compiler/src/front/stdsrc.vl is not std's new text\n");
        return;
    }
    let d = diag(c"note", c"edit.std", tcx);
    buf_str(d, c"ran ");
    buf_str(d, script);
    buf_str(d, c": compiler/src/front/stdsrc.vl has std's new text; rebuild to use it (bootstrap/bootstrap.sh --dev)\n");
}

// (0.30) After `edit.not-source` for an item of std, at pos: when the
// repository holds std's text in its files, the edit that does work, a
// `try:` line (std's file patched as text: tools/textfile.vl).
pub fn try_std_file(pos: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let f = crate::front::modules::file_of_pos(pos, pcx);
    let mut path = 0 as *const u8;
    let mut line: i64 = 0;
    if !crate::front::stdtree::std_file_line(f, pos, &mut path, &mut line, pcx) {
        return;
    }
    let out = crate::tools::query::diagnostics::diags(tcx);
    buf_str(out, c"try:");
    crate::tools::query::diagnostics::put_cword(out, pcx.prog);
    buf_str(out, c" edit patch");
    crate::tools::query::diagnostics::put_cword(out, path);
    buf_str(out, c" --old 'TEXT' --new 'TEXT'");
    crate::tools::query::diagnostics::try_end(out);
    let d = diag(c"note", c"edit.std", tcx);
    buf_str(d, c"the item is at ");
    buf_str(d, path);
    buf_str(d, c":");
    crate::base::buf_int(d, line);
    buf_str(d, c"; std's files are patched as text (OLD exact, once in the file), then: sh compiler/std/embed.sh\n");
}

// (0.30) `fix --suggested`, the exact fixes of errors in std's own code
// (base::diag: err_fix records one when the error and its fix are both in
// std's text and the repository holds that text in its files): each is
// made in std's file, as text; the files are written as one edit (`volec
// undo` takes it back; embed.sh runs after it) and the result names them
// and says `run: sh compiler/std/embed.sh`. -1 when there is none (the
// program's own fixes follow), else the exit status: the program's fixes
// are left for the next run, on std as fixed.
pub fn fix_std_suggested(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let sf = pcx.std_file;
    if sf < 0 {
        return -1;
    }
    // the fixes in std's text, by start; one overlapping another is left
    let mut at: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut i: i64 = 0;
    while i + 3 < pcx.suggested.len() as i64 {
        let pos = pcx.suggested[i as usize];
        let start = pcx.suggested[(i + 1) as usize];
        let end = pcx.suggested[(i + 2) as usize];
        let text = pcx.suggested[(i + 3) as usize];
        i += 4;
        // (an error that was taken back, a trial's, left its fix in the
        // list: only the fixes of the errors reported)
        if !crate::base::diag::error_recorded_at(pos, pcx) || start < pcx.files[sf as usize].start
            || end > pcx.files[sf as usize].end
            || crate::tools::fix::verify::refusal_of(start, end, text, pcx).len() > 0 {
            continue;
        }
        let mut k = at.len() as i64;
        at.push(i - 4);
        while k > 0 && pcx.suggested[(at[(k - 1) as usize] + 1) as usize] > start {
            let t = at[k as usize];
            at[k as usize] = at[(k - 1) as usize];
            at[(k - 1) as usize] = t;
            k -= 1;
        }
    }
    let out = buf_new();
    let mut fixes: i64 = 0;
    let mut cur = 0 as *const u8;
    let mut after: i64 = -1;
    let mut from: i64 = 0;
    let mut file_end: i64 = 0;
    for j in 0..at.len() as i64 {
        let s = at[j as usize];
        let start = pcx.suggested[(s + 1) as usize];
        let end = pcx.suggested[(s + 2) as usize];
        let text = buf_copy(pcx.suggested[(s + 3) as usize]);
        let mut path = 0 as *const u8;
        let mut line: i64 = 0;
        if !crate::front::stdtree::std_file_line(sf, start, &mut path, &mut line, pcx) {
            continue;
        }
        if path != cur {
            if after >= 0 {
                crate::base::buf_bytes(after,
                    &crate::base::get_src()[from as usize..file_end as usize]);
            }
            let mut a: i64 = 0;
            let mut b: i64 = 0;
            if !crate::front::stdtree::std_file_range(&crate::base::cstr(path), &mut a, &mut b, pcx) {
                after = -1;
                cur = 0 as *const u8;
                continue;
            }
            cur = path;
            from = a;
            file_end = b;
            after = buf_new();
            let before = buf_new();
            crate::base::buf_bytes(before, &crate::base::get_src()[a as usize..b as usize]);
            tcx.w_path.push(path as i64);
            tcx.w_before.push(before);
            tcx.w_after.push(after);
        }
        if start < from || end > file_end {
            continue;
        }
        buf_str(out, if tcx.dry_run { c"would fix " } else { c"fixed " });
        buf_str(out, path);
        buf_str(out, c":");
        crate::base::buf_int(out, line);
        buf_str(out, c": ");
        crate::base::buf_bytes(out, &crate::base::get_src()[start as usize..end as usize]);
        buf_str(out, c" -> ");
        crate::base::buf_bytes(out, &text);
        buf_str(out, c"\n");
        crate::base::buf_bytes(after, &crate::base::get_src()[from as usize..start as usize]);
        crate::base::buf_bytes(after, &text);
        from = end;
        fixes += 1;
    }
    if after >= 0 {
        crate::base::buf_bytes(after, &crate::base::get_src()[from as usize..file_end as usize]);
    }
    if fixes == 0 {
        tcx.w_path.clear();
        tcx.w_before.clear();
        tcx.w_after.clear();
        return -1;
    }
    if !tcx.dry_run {
        let summary = buf_new();
        buf_str(summary, c"fixed std's files");
        if !crate::tools::textual::write_edit(&buf_copy(summary), c".", tcx, pcx) {
            return 1;
        }
        crate::tools::textfile::put_std_run(out, &crate::base::cstr(cur));
    }
    buf_str(out,
        if tcx.dry_run {
            c"note: std's errors come first: the program's own fixes follow once std's are made\n"
        }
        else { c"note: the program's own fixes, if any: run fix --suggested again (std is read from its files)\n" });
    crate::base::buf_write_fd(out, crate::base::STDOUT);
    0
}

// Whether path is one of std's files (compiler/std/NAME.vl): undoing an
// edit of it runs embed.sh.
pub fn is_std_file(path: &[u8]) -> bool {
    let dir = "compiler/std/";
    // (either extension, by its length: 0.24 renames them)
    let e = crate::base::source_ext_len(path);
    if e == 0 || path.len() as i64 <= dir.len() as i64 + e {
        return false;
    }
    for i in 0..path.len() as i64 - dir.len() as i64 {
        if &path[i as usize..(i + dir.len() as i64) as usize] == dir.as_bytes() {
            return true;
        }
    }
    false
}

// Whether an argument of the command (from word 3) names one of std's
// files, alone or with a line (`compiler/std/io.vl:102`), and the
// repository has them: the command then runs on std's files (STD_TREE).
pub fn names_std_file(line: Line<'_>, pcx: &Ctx<Comp>) -> bool {
    if pcx.std_tree != 0 as *mut u8 || find_std_tree(pcx) == 0 as *mut u8 {
        return false;
    }
    for i in 3..line.len() {
        // (run again with --std-tree: not again)
        if line.word(i) == "--std-tree" {
            return false;
        }
    }
    for i in 3..line.len() {
        let a = line.word(i).as_bytes();
        let mut end: i64 = 0;
        while end < a.len() as i64 && a[end as usize] != b':' {
            end += 1;
        }
        if is_std_file(&a[0..end as usize]) {
            return true;
        }
    }
    false
}

// (0.20) Whether a refactoring's arguments name std's modules or items
// (`refactor new-module std::collections`, `refactor move std::sort --to
// std::slice`), or its script does (`refactor --script FILE`), and the
// repository has std's files: it then runs on them (STD_TREE).
pub fn names_std_path(line: Line<'_>, pcx: &Ctx<Comp>) -> bool {
    if pcx.std_tree != 0 as *mut u8 || find_std_tree(pcx) == 0 as *mut u8 {
        return false;
    }
    for i in 2..line.len() {
        if line.word(i) == "--std-tree" {
            return false;
        }
    }
    for i in 3..line.len() {
        let a = line.word(i).as_bytes();
        if a.len() > 5 && a[0..5] == b"std::" || is_std_file(a) {
            return true;
        }
        if line.word(i - 1) == "--script" {
            let text = buf_new();
            if read_file_if(line.c(i), text) {
                let t = buf_copy(text);
                for k in 0..t.len() as i64 - 4 {
                    if &t[k as usize..(k + 5) as usize] == b"std::"
                        && (k == 0 || t[(k - 1) as usize] == b' ' || t[(k - 1) as usize] == b'\n') {
                        return true;
                    }
                }
            }
        }
    }
    false
}
