// Editing std by name (0.17). In the vole repository, an edit whose
// target is a std item (`edit patch std::trim`, `edit insert --after
// Vec::push`, `edit replace std::split`, a block of `edit apply`) runs
// again with `--std-tree compiler/std`: std then comes from its files
// (front/stdtree.vl), so the edit is made in compiler/std/FILE.vl and
// checked with the edited std; after it, compiler/std/embed.sh makes
// compiler/src/front/stdsrc.vl, the text built into the compiler, from
// the files again (`note edit.std`). Outside the repository std is the
// compiler's own text and such an edit is refused (`edit.not-source`).

use crate::base::{FILES, buf_new, buf_slice, buf_str};
use crate::cli::line::{Line, c_words};
use crate::front::stdtree::{STD_TREE, find_std_tree, tree_path};
use crate::tools::edit::DRY_RUN;
use crate::tools::proc::{STDIN_READ, exec_words, read_file_if, run_capture, run_with_stdin};
use crate::tools::query::diagnostics::diag;

// The command asks for a run in std's files (std_rerun said so).
static var RERUN: bool = false;

// Whether the item an edit targets, in file f, is std's built-in text that
// std's files can stand in for: then the command runs again in them
// (rerun_in_std_tree) instead of reporting edit.not-source.
pub fn std_rerun(f: i64) -> bool {
    unsafe {
        let p = FILES[f].path;
        if STD_TREE != 0 as *u8 || !(p[0] == '<' && p[1] == 's' && p[2] == 't' && p[3] == 'd'
            && p[4] == '>' && p[5] == 0) || find_std_tree() == 0 as *u8 {
            return false;
        }
        RERUN = true;
        true
    }
}

// Whether std_rerun asked for the command to run again.
pub fn rerun_wanted() -> bool {
    RERUN
}

// The command (its line) again with `--std-tree DIR`, given what this
// process read of stdin; then, when it wrote std's files, embed.sh. Its
// status.
pub fn rerun_in_std_tree(line: Line) -> i64 {
    let dir = find_std_tree();
    var words = c_words(line);
    words.push(c"--std-tree" as i64);
    words.push(dir as i64);
    let status = run_with_stdin(exec_words(words), STDIN_READ);
    if status == 0 && !DRY_RUN {
        embed_std(dir);
    }
    status
}

// compiler/std/embed.sh, when stdsrc.vl is not std's files' text: the
// note saying it ran (or the warning that it failed).
pub fn embed_std(dir: *u8) {
    let script = tree_path(dir, c"embed.sh");
    let out = buf_new();
    let check = [c"sh", script, c"-c", 0 as *u8];
    if run_capture(&check[0], out) == 0 {
        return;
    }
    let run = [c"sh", script, 0 as *u8];
    if run_capture(&run[0], out) != 0 {
        let d = diag(c"warning", c"edit.std");
        buf_str(d, script);
        buf_str(d, c" failed: compiler/src/front/stdsrc.vl is not std's new text\n");
        return;
    }
    let d = diag(c"note", c"edit.std");
    buf_str(d, c"ran ");
    buf_str(d, script);
    buf_str(d, c": compiler/src/front/stdsrc.vl has std's new text; rebuild to use it (bootstrap/bootstrap.sh --dev)\n");
}

// Whether path is one of std's files (compiler/std/NAME.vl): undoing an
// edit of it runs embed.sh.
pub fn is_std_file(path: [u8]) -> bool {
    let dir = "compiler/std/";
    // (either extension, by its length: 0.24 renames them)
    let e = crate::base::source_ext_len(path);
    if e == 0 || path.len <= dir.len + e {
        return false;
    }
    for i in 0..path.len - dir.len {
        if path[i..i + dir.len] == dir {
            return true;
        }
    }
    false
}

// Whether an argument of the command (from word 3) names one of std's
// files, alone or with a line (`compiler/std/io.vl:102`), and the
// repository has them: the command then runs on std's files (STD_TREE).
pub fn names_std_file(line: Line) -> bool {
    if STD_TREE != 0 as *u8 || find_std_tree() == 0 as *u8 {
        return false;
    }
    for i in 3..line.len() {
        // (run again with --std-tree: not again)
        if line.word(i) == "--std-tree" {
            return false;
        }
    }
    for i in 3..line.len() {
        let a = line.word(i).as_bytes();
        var end = 0;
        while end < a.len && a[end] != ':' {
            end += 1;
        }
        if is_std_file(a[0..end]) {
            return true;
        }
    }
    false
}

// (0.20) Whether a refactoring's arguments name std's modules or items
// (`refactor new-module std::collections`, `refactor move std::sort --to
// std::slice`), or its script does (`refactor --script FILE`), and the
// repository has std's files: it then runs on them (STD_TREE).
pub fn names_std_path(line: Line) -> bool {
    if STD_TREE != 0 as *u8 || find_std_tree() == 0 as *u8 {
        return false;
    }
    for i in 2..line.len() {
        if line.word(i) == "--std-tree" {
            return false;
        }
    }
    for i in 3..line.len() {
        let a = line.word(i).as_bytes();
        if a.len > 5 && a[0..5] == "std::" || is_std_file(a) {
            return true;
        }
        if line.word(i - 1) == "--script" {
            let text = buf_new();
            if read_file_if(line.c(i), text) {
                let t = buf_slice(text);
                for k in 0..t.len - 4 {
                    if t[k..k + 5] == "std::"
                        && (k == 0 || t[k - 1] == ' ' || t[k - 1] == '\n') {
                        return true;
                    }
                }
            }
        }
    }
    false
}
