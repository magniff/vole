// Changing a program by name, atomically (0.11; docs/refactor.md):
//
//   volec edit replace NAME [ROOT] < TEXT   the item's text becomes TEXT
//   volec edit insert --after|--before NAME [ROOT] < TEXT
//   volec edit delete NAME [ROOT]
//   volec edit patch TARGET --old TEXT --new TEXT   (patch.vl)
//   volec edit wrap TARGET --in HEAD [--body | --lines A-B]   (wrap)
//   volec edit new-file PATH [--pub] < TEXT  (newfile)
//   volec undo                              the last edit, undone
//   volec check [ROOT]                      the front end's errors
//
// Every change goes through the edit engine: a set of replacements of
// byte ranges of the program's files, computed from the compiler's spans.
// It is applied atomically:
//   1. each changed file's new text is written to a copy next to it
//      (`FILE.vole-edit~`);
//   2. the front end runs again on the edited program (`volec check`,
//      reading the copies in place of the files: --overlay);
//   3. an error the edited program has and the program had not is a new
//      error: then the copies are removed, nothing is written, and the
//      new errors are reported (short form, `try:` the same command with
//      --no-check);
//   4. otherwise the copies are renamed onto the files, the edit is
//      journaled (.git/vole-edits, for `undo`), and one line says what
//      changed: `replaced crate::gvn::run_gvn<TAB>compiler/src/gvn.vl<TAB>+3 -5 lines`.
// `--dry-run` does all but write: it prints the edit as a unified diff
// with no context lines (and says when the edit would add errors).
// Nothing outside the replaced ranges changes, byte for byte.
//
// This file holds the engine's edits and the files they make, move and
// remove; the diff is in diff, the check and the writing of an edit in
// apply, the journal and `undo` in undo, an item's lines and text in
// items, and the `edit` commands in cli (`edit wrap` in wrap, `edit
// new-file` in newfile).

pub mod diff;
pub mod apply;
pub mod undo;
pub mod items;
pub mod cli;
pub mod wrap;
pub mod newfile;
pub mod applyfile;
pub mod breaks;
pub mod stdedit;

use crate::base::{IntVec, SOURCE_VOLE, buf_bytes, buf_new, buf_slice, buf_str, get_bufs, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::format_ranges;
use crate::tools::proc::{buf_cstr, remove_dir, same_bytes};
use crate::tools::query::c_slice;

// ---- The edit engine ----

// Replaces SRC[start..end) by buffer text (an insertion when start ==
// end). False, and nothing added, when the range overlaps one already
// added (insertions at one position keep their order, before a
// replacement starting there).
pub fn edit_replace(start: i64, end: i64, text: i64, pcx: &mut Ctx<Comp>) -> bool {
    for i in 0..pcx.e_start.len() as i64 {
        let s = (pcx.e_start[i as usize]);
        let e = (pcx.e_end[i as usize]);
        if start < e && s < end {
            return false;
        }
        // (an insertion strictly inside a replacement)
        if start == end && s < start && start < e {
            return false;
        }
        if s == e && start < s && s < end {
            return false;
        }
    }
    pcx.e_start.push(start);
    pcx.e_end.push(end);
    pcx.e_text.push(text);
    true
}

// Makes file `path` (new) with the text of buffer `text`.
pub fn edit_new_file(path: *mut u8, text: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        // (laid out by fmt, as every edit is)
        let mut whole = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        whole.push(0);
        whole.push((*get_bufs().add(text as usize)).len);
        let formatted: i64 = if tcx.format_edits {
            format_ranges(buf_slice(text), &mut whole, tcx, pcx)
        }
            else { -1 };
        tcx.new_path.push(path as i64);
        tcx.new_text.push(if formatted >= 0 { formatted } else { text });
    }
}

// Moves file f (an index into FILES) to `path` (new), with its edits.
pub fn edit_move_file(f: i64, path: *mut u8, tcx: &mut Tcx<Comp>) {
    tcx.rn_file.push(f);
    tcx.rn_path.push(path as i64);
}

pub fn edit_count(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    pcx.e_start.len() as i64 + tcx.new_path.len() as i64 + tcx.rn_file.len() as i64
}

// (0.25.2.1, fix --suggested's check of each fix: fix/verify.vl) The
// number of replacements, one's range and text, and the edit without some
// of them (indices `gone`, sorted): the new texts made again by the next
// prepare_edit or write_round.
pub fn replace_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.e_start.len() as i64
}

pub fn replace_at(i: i64, pcx: &Ctx<Comp>) -> (i64, i64, i64) {
    ((pcx.e_start[i as usize]), (pcx.e_end[i as usize]),
        (pcx.e_text[i as usize]))
}

pub fn drop_replaces(gone: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut k: i64 = 0;
    let mut g: i64 = 0;
    for i in 0..pcx.e_start.len() as i64 {
        if g < gone.len() as i64 && (gone[g as usize]) == i {
            g += 1;
            continue;
        }
        (pcx.e_start[k as usize]) = (pcx.e_start[i as usize]);
        (pcx.e_end[k as usize]) = (pcx.e_end[i as usize]);
        (pcx.e_text[k as usize]) = (pcx.e_text[i as usize]);
        k += 1;
    }
    pcx.e_start.truncate(k);
    pcx.e_end.truncate(k);
    pcx.e_text.truncate(k);
    tcx.ch_file.clear();
    tcx.ch_text.clear();
    tcx.added = 0;
    tcx.edit_removed = 0;
}

// The moved files, once their new texts are made: each is a new file and
// a removed one.
fn move_files(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..tcx.rn_file.len() as i64 {
        let f = (tcx.rn_file[i as usize]);
        let mut text: i64 = -1;
        let mut k: i64 = 0;
        while k < tcx.ch_file.len() as i64 {
            if (tcx.ch_file[k as usize]) == f {
                text = (tcx.ch_text[k as usize]);
                (tcx.ch_file[k as usize]) = (
                    tcx.ch_file[(tcx.ch_file.len() as i64 - 1) as usize]);
                (tcx.ch_text[k as usize]) = (
                    tcx.ch_text[(tcx.ch_text.len() as i64 - 1) as usize]);
                tcx.ch_file.pop();
                tcx.ch_text.pop();
                break;
            }
            k += 1;
        }
        if text < 0 {
            text = buf_new();
            buf_bytes(text,
                &get_src()[
                    pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize]);
        }
        tcx.new_path.push((tcx.rn_path[i as usize]));
        tcx.new_text.push(text);
        tcx.del_file.push(f);
        tcx.del_to.push(tcx.new_path.len() as i64 - 1);
    }
}

// The path a removed file is read from in the check: one that never
// exists.
pub fn gone_path(path: *mut u8) -> *mut u8 {
    let b = buf_new();
    buf_str(b, path);
    buf_str(b, c".vole-gone~");
    buf_cstr(b)
}

// Removes file `path` of the program (a script's step moved it): false
// when it is none of the program's files.
pub fn edit_remove_file(path: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for f in 0..pcx.files.len() as i64 {
        if same_bytes(c_slice(pcx.files[f as usize].path), path) {
            tcx.del_file.push(f);
            tcx.del_to.push(-1);
            return true;
        }
    }
    false
}

// Removes the directories of path that are left empty (up from its own).
pub fn remove_empty_dirs(path: *mut u8) {
    unsafe {
        let b = buf_new();
        buf_str(b, path);
        loop {
            while (*get_bufs().add(b as usize)).len > 0
                && (
                    *(*get_bufs().add(b as usize)).data.add(
                        ((*get_bufs().add(b as usize)).len - 1) as usize)) != b'/' {
                (*get_bufs().add(b as usize)).len -= 1;
            }
            if (*get_bufs().add(b as usize)).len <= 1 {
                return;
            }
            (*get_bufs().add(b as usize)).len -= 1;
            if !remove_dir(buf_cstr(b)) {
                return;
            }
        }
    }
}

// The edits in order of position (a stable insertion sort; insertions
// before the replacement that starts where they are).
fn sorted_edits(out: &mut IntVec, pcx: &Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.e_start.len() as i64 {
            out.push(i);
        }
        let v = out.data;
        for i in 1..out.len() as i64 {
            let mut j = i;
            while j > 0 && edit_before((*v.add(j as usize)), (*v.add((j - 1) as usize)), pcx) {
                let t = (*v.add(j as usize));
                (*v.add(j as usize)) = (*v.add((j - 1) as usize));
                (*v.add((j - 1) as usize)) = t;
                j -= 1;
            }
        }
    }
}

fn edit_before(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let sa = (pcx.e_start[a as usize]);
    let sb = (pcx.e_start[b as usize]);
    if sa != sb {
        return sa < sb;
    }
    // (at one position: an insertion first; of two insertions, a `mod`
    // line first: a split's `mod part;` above the imports it adds)
    if (pcx.e_end[a as usize]) == sa && (pcx.e_end[b as usize]) == sb {
        return mod_line((pcx.e_text[a as usize]))
            && !mod_line((pcx.e_text[b as usize]));
    }
    (pcx.e_end[a as usize]) == sa && (pcx.e_end[b as usize]) != sb
}

// Whether buffer t starts with a `mod` line.
fn mod_line(t: i64) -> bool {
    let s = buf_slice(t);
    let mut i: i64 = 0;
    if s.len() > 4 && s[0] == b'p' && s[1] == b'u' && s[2] == b'b' && s[3] == b' ' {
        i = 4;
    }
    i + 4 <= s.len() as i64 && s[i as usize] == b'm' && s[(i + 1) as usize] == b'o'
        && s[(i + 2) as usize] == b'd' && s[(i + 3) as usize] == b' '
}

// The new texts of the changed files, into CH_FILE / CH_TEXT.
fn new_texts(order: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let n = order.len() as i64;
        let mut k: i64 = 0;
        for f in 0..pcx.files.len() as i64 {
            if k >= n {
                break;
            }
            let first = (order[k as usize]);
            if (pcx.e_start[first as usize]) > pcx.files[f as usize].end {
                continue;
            }
            let mut out = buf_new();
            let mut cur = pcx.files[f as usize].start;
            // (the replaced parts in the new text, which fmt lays out)
            let mut ranges = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            while k < n
                && (pcx.e_start[(order[k as usize]) as usize])
                <= pcx.files[f as usize].end {
                let e = (order[k as usize]);
                buf_bytes(out,
                    &get_src()[cur as usize..(pcx.e_start[e as usize]) as usize]);
                ranges.push((*get_bufs().add(out as usize)).len);
                buf_bytes(out, buf_slice((pcx.e_text[e as usize])));
                ranges.push((*get_bufs().add(out as usize)).len);
                cur = (pcx.e_end[e as usize]);
                k += 1;
            }
            buf_bytes(out, &get_src()[cur as usize..pcx.files[f as usize].end as usize]);
            let formatted: i64 = if tcx.format_edits
                && pcx.files[f as usize].kind
                == SOURCE_VOLE { format_ranges(buf_slice(out), &mut ranges, tcx, pcx) }
                else { -1 };
            if formatted >= 0 {
                out = formatted;
            }
            if !same_bytes(buf_slice(out),
                &get_src()[
                    pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize]) {
                tcx.ch_file.push(f);
                tcx.ch_text.push(out);
            }
        }
    }
}
