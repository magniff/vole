// `volec edit apply [FILE] [--dry-run] [--show] [--no-check] [ROOT]`
// (0.15; docs/refactor.md, "edit apply"): the new text of several items in
// one file (stdin without FILE), each block introduced by a header line,
// made one edit: checked once, written all or not at all, one `undo`.
//
//   // PATH<TAB>FILE:A-B     (a header of `query show`) the item PATH
//                            becomes the text below it
//   @@ NAME                  NAME becomes the text below it; a NAME no
//                            definition has, whose text defines it, is
//                            added at the end of its module
//   @@ new after NAME        the text goes after NAME (`new before NAME`)
//   @@ new in MODULE         the text goes at the end of MODULE's file
//   @@ delete NAME           NAME goes (no text)
//
// So `query show A B` (or the items of `query context`), changed and
// given back, is a round trip. Each block is the edit `edit replace`,
// `insert` or `delete` would make (cli's item_edit, region_edit for
// `MODULE::use` and `MODULE::header`); the imports the new text needs are
// added, as for edit replace.

use std::alloc::Arena;

use crate::base::{
    SOURCE_VOLE, buf_append, buf_byte, buf_bytes, buf_copy, buf_int, buf_len, buf_new, buf_str,
    get_src,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_WORD, Leaf};
use crate::front::embed::wgsl::WgslCx;
use crate::front::modules::file_made;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::cli::{edit_opts, item_edit, region_edit, source_only, take_edit_event};
use crate::tools::edit::items::item_text;
use crate::tools::edit::stdedit::{rerun_in_std_tree, rerun_wanted};
use crate::tools::proc::{read_file_if, read_stdin};
use crate::tools::query::{c_slice, file_line, resolve_name, root_or_diag};
use crate::tools::query::cache::cache_restore;
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{bytes_eq, find_defs, last_segment, mod_fqn};
use crate::tools::query::diagnostics::{diag, program_errors, try_begin, try_end};
use crate::tools::query::show::find_modules;
use crate::tools::query_text::{region_target, root_stem};

// `edit apply`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn apply_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let opts = edit_opts(gpa);
    Leaf::new(opts, "file")
}

pub fn run_apply(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    let mut root = 0 as *mut u8;
    let mut file = 0 as *mut u8;
    let mut dash = false;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        let a = ev.value;
        if take_edit_event(&mut ev, &mut root, tcx, pcx) {
        } else if ev.kind != EV_WORD {
            let d = diag(c"error", c"edit.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' of edit apply (--dry-run, --show, --no-check, --root, --target)\n");
            return 2;
        } else if file == 0 as *mut u8 {
            file = a;
            dash = ev.text == "-";
        } else if root == 0 as *mut u8 && crate::base::is_source_path(a) {
            root = a;
        } else {
            return usage(c"one FILE of blocks (or none: stdin)", tcx, pcx);
        }
    }
    let input = buf_new();
    if file == 0 as *mut u8 || dash {
        tcx.source = c"stdin";
        if !read_stdin(input, tcx) || buf_len(input) == 0 {
            let d = diag(c"error", c"edit.no-text", tcx);
            buf_str(d, c"the blocks are read from FILE or stdin; none was given\n");
            let out = try_begin(c"apply", b"items.vl", true, tcx, pcx);
            try_end(out);
            return 2;
        }
    } else {
        tcx.source = file;
        if !read_file_if(file, input) {
            let d = diag(c"error", c"edit.no-text", tcx);
            buf_str(d, c"cannot read '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 2;
        }
    }
    if !read_blocks(&buf_copy(input), tcx, pcx) {
        return 2;
    }
    tcx.root_given = root;
    root = root_or_diag(root, c"apply", &c_slice(tcx.source), true, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    if !cache_restore(root, tcx.target, false, tcx, pcx)
        && !load_program(root, tcx.target, tcx, pcx, wgx) {
        program_errors(c"error", root, true, tcx, pcx);
        return 1;
    }
    let summary = buf_new();
    if tcx.b_how.len() as i64 > 1 {
        buf_str(summary, c"applied ");
        buf_int(summary, tcx.b_how.len() as i64);
        buf_str(summary, c" blocks: ");
    }
    let mut skip: Vec<i64, Comp> = Vec::new_in(Comp {});
    chain_blocks(&mut skip, tcx, pcx);
    for k in 0..tcx.b_how.len() as i64 {
        if k > 0 {
            buf_str(summary, c"; ");
        }
        if (skip[k as usize]) != 0 {
            buf_str(summary,
                if (tcx.b_how[k as usize]) == b'a' as i64 { c"inserted after " }
                else { c"inserted before " });
            buf_append(summary, (tcx.applyfile_b_name[k as usize]));
            continue;
        }
        if !apply_block(k, summary, tcx, pcx) {
            return if rerun_wanted(tcx) { rerun_in_std_tree(c.line, tcx, pcx) } else { 1 };
        }
        if (tcx.b_how[k as usize]) != b'd' as i64 {
            tcx.add_imports = true;
        }
    }
    apply_edit(&buf_copy(summary), root, tcx, pcx)
}

// (0.17) Blocks `@@ new after|before X` where X is an item an earlier
// block adds (not in the program yet): their text goes with that block's
// (after or before it); skip[k] is 1 for them.
fn chain_blocks(skip: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut owner: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut orig: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..tcx.b_how.len() as i64 {
        skip.push(0);
        owner.push(k);
        orig.push((tcx.b_text[k as usize]));
    }
    for k in 0..tcx.b_how.len() as i64 {
        let how = (tcx.b_how[k as usize]);
        if how != b'a' as i64 && how != b'b' as i64 {
            continue;
        }
        let name = buf_copy((tcx.applyfile_b_name[k as usize]));
        let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
        find_defs(&name, false, &mut found, tcx, pcx);
        if found.len() as i64 > 0 {
            continue;
        }
        let seg = last_segment(&name);
        for j in 0..k {
            let hj = (tcx.b_how[j as usize]);
            if hj == b'd' as i64 || !defines(&buf_copy((orig[j as usize])), seg) {
                continue;
            }
            let o = (owner[j as usize]);
            let merged = buf_new();
            let first = if how == b'a' as i64 { (tcx.b_text[o as usize]) }
                else { (tcx.b_text[k as usize]) };
            let second = if how == b'a' as i64 { (tcx.b_text[k as usize]) }
                else { (tcx.b_text[o as usize]) };
            let t = buf_copy(first);
            let mut e = t.len() as i64;
            while e > 0 && t[(e - 1) as usize] == b'\n' {
                e -= 1;
            }
            buf_bytes(merged, &t[0..e as usize]);
            buf_str(merged, c"\n\n");
            buf_append(merged, second);
            (tcx.b_text[o as usize]) = merged;
            (owner[k as usize]) = o;
            (skip[k as usize]) = 1;
            break;
        }
    }
}

fn usage(message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"edit.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = try_begin(c"apply items.vl --dry-run", b"", false, tcx, pcx);
    try_end(out);
    2
}

fn is_blank(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n'
}

fn trimmed(t: &[u8]) -> &[u8] {
    let mut a: i64 = 0;
    let mut b = t.len() as i64;
    while a < b && is_blank(t[a as usize]) {
        a += 1;
    }
    while b > a && is_blank(t[(b - 1) as usize]) {
        b -= 1;
    }
    &t[a as usize..b as usize]
}

fn starts_with(t: &[u8], p: *mut u8) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while (*p.add(i as usize)) != 0 {
            if i >= t.len() as i64 || t[i as usize] != (*p.add(i as usize)) {
                return false;
            }
            i += 1;
        }
        true
    }
}

// Whether line is a header (`@@ ...`, or `// PATH<TAB>FILE:A-B ...`): its
// kind into *how, its NAME into buffer name.
fn block_header(line: &[u8], how: &mut u8, name: i64) -> bool {
    if line.len() >= 2 && line[0] == b'@' && line[1] == b'@' {
        let rest = trimmed(&line[2..line.len()]);
        *how = b'r';
        let mut from: i64 = 0;
        if starts_with(rest, c"new after ") {
            *how = b'a';
            from = 10;
        } else if starts_with(rest, c"new before ") {
            *how = b'b';
            from = 11;
        } else if starts_with(rest, c"new in ") {
            *how = b'n';
            from = 7;
        } else if starts_with(rest, c"delete ") {
            *how = b'd';
            from = 7;
        }
        buf_bytes(name, trimmed(&rest[from as usize..]));
        return true;
    }
    // `// PATH<TAB>FILE:A-B`, as query show prints an item's header
    if line.len() > 4 && line[0] == b'/' && line[1] == b'/' && line[2] == b' ' {
        let mut tab: i64 = 3;
        while tab < line.len() as i64 && line[tab as usize] != b'\t' {
            if line[tab as usize] == b' ' {
                return false;
            }
            tab += 1;
        }
        if tab >= line.len() as i64 || tab == 3 {
            return false;
        }
        // (FILE:A-B, maybe more words after it: query context's)
        let mut place = trimmed(&line[(tab + 1) as usize..]);
        let mut w: i64 = 0;
        while w < place.len() as i64 && place[w as usize] != b' ' && place[w as usize] != b'\t' {
            w += 1;
        }
        place = &place[0..w as usize];
        let mut colon = false;
        for i in 0..place.len() {
            if place[i] == b':' {
                colon = true;
            }
        }
        if !colon || place.len() == 0 || place[(place.len() as i64 - 1) as usize] < b'0'
            || place[(place.len() as i64 - 1) as usize] > b'9' {
            return false;
        }
        *how = b'r';
        buf_bytes(name, &line[3..tab as usize]);
        return true;
    }
    false
}

// The blocks of the input. False after the diagnostic.
fn read_blocks(input: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut text: i64 = -1;
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < input.len() as i64 {
        let mut e = i;
        while e < input.len() as i64 && input[e as usize] != b'\n' {
            e += 1;
        }
        let line = &input[i as usize..e as usize];
        n += 1;
        let mut how = b' ';
        let name = buf_new();
        if block_header(line, &mut how, name) {
            if buf_len(name) == 0 {
                return format_error(n, c"a header names no item", tcx, pcx);
            }
            text = buf_new();
            tcx.b_how.push(how as i64);
            tcx.applyfile_b_name.push(name);
            tcx.b_text.push(text);
            tcx.b_line.push(n);
        } else if text < 0 {
            if trimmed(line).len() > 0 {
                return format_error(n, c"text before the first header", tcx, pcx);
            }
        } else {
            buf_bytes(text, line);
            buf_byte(text, b'\n');
        }
        i = e + 1;
    }
    if tcx.b_how.len() as i64 == 0 {
        return format_error(n, c"no block", tcx, pcx);
    }
    for k in 0..tcx.b_how.len() as i64 {
        let empty = trimmed(&buf_copy((tcx.b_text[k as usize]))).len() == 0;
        if (tcx.b_how[k as usize]) == b'd' as i64 && !empty {
            return format_error((tcx.b_line[k as usize]),
                c"a delete block has no text", tcx, pcx);
        }
        if (tcx.b_how[k as usize]) != b'd' as i64 && empty {
            return format_error((tcx.b_line[k as usize]),
                c"the block has no text (`@@ delete NAME` deletes an item)", tcx, pcx);
        }
    }
    true
}

fn format_error(line: i64, message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let d = diag(c"error", c"edit.format", tcx);
    buf_str(d, tcx.source);
    buf_str(d, c" line ");
    buf_int(d, line);
    buf_str(d, c": ");
    buf_str(d, message);
    buf_str(d, c"; a block starts with `@@ NAME`, `@@ new after NAME`, `@@ new in MODULE`, `@@ delete NAME` or a header of query show\n");
    let out = try_begin(c"show", b"NAME", true, tcx, pcx);
    try_end(out);
    false
}

// `how` as an edit of item_edit and region_edit.
fn item_how(how: i64) -> u8 {
    if how == b'r' as i64 { b'r' } else if how == b'a' as i64 { b'a' }
    else if how == b'b' as i64 { b'b' } else { b'd' }
}

// Block k, added to the engine's edits; its words in summary. False after
// the diagnostic.
fn apply_block(k: i64, summary: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let name = buf_copy((tcx.applyfile_b_name[k as usize]));
    let how = (tcx.b_how[k as usize]);
    let text = (tcx.b_text[k as usize]);
    if how == b'n' as i64 {
        return add_to_module(&name, text, summary, &name[0..0], tcx, pcx);
    }
    // A module's use lines or header (0.12).
    let mut rf: i64 = 0;
    let mut rk: i64 = 0;
    let mut spans: Vec<i64, Comp> = Vec::new_in(Comp {});
    let r = region_target(&name, c"show", &mut rf, &mut rk, &mut spans, tcx, pcx);
    if r == 1 {
        return false;
    }
    if r == 0 {
        return region_edit(rf, rk, spans.as_slice(), item_how(how), text, summary, tcx, pcx)
            < 0;
    }
    // A new item named by its path: at the end of its module.
    let mut line: i64 = 0;
    if how == b'r' as i64 && file_line(&name, &mut line) < 0 {
        let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
        find_defs(&name, false, &mut found, tcx, pcx);
        let seg = last_segment(&name);
        if found.len() as i64 == 0 && seg.len() < name.len()
            && defines(&buf_copy(text), seg) {
            return add_to_module(&name[0..(name.len() as i64 - seg.len() as i64 - 2) as usize],
                text, summary, seg, tcx, pcx);
        }
    }
    let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
    if !resolve_name(c"show", &name, &mut matches, tcx, pcx) {
        return false;
    }
    source_only(&mut matches, pcx);
    if matches.len() as i64 > 1 {
        let d = diag(c"error", c"query.ambiguous", tcx);
        buf_int(d, matches.len() as i64);
        buf_str(d, c" definitions match '");
        buf_bytes(d, &name);
        buf_str(d, c"' (");
        buf_str(d, tcx.source);
        buf_str(d, c" line ");
        buf_int(d, (tcx.b_line[k as usize]));
        buf_str(d, c"); name one by its path in the header\n");
        let out = try_begin(c"def", &name, true, tcx, pcx);
        try_end(out);
        return false;
    }
    let d = (matches[0]);
    let f = crate::front::modules::file_of_pos(pcx.defs[d as usize].start, pcx);
    if file_made(f, pcx) {
        // (0.17: std, in the repository: run_apply runs again in its
        // files; stdedit.vl)
        if crate::tools::edit::stdedit::std_rerun(f, tcx, pcx) {
            return false;
        }
        let e = diag(c"error", c"edit.not-source", tcx);
        buf_bytes(e, crate::base::sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(e, c" is in ");
        buf_str(e, pcx.files[f as usize].path);
        buf_str(e, c", not in a file of the program\n");
        return false;
    }
    item_edit(item_how(how), d, text, summary, tcx, pcx)
}

// Whether text defines an item named `name`: the word after its first
// keyword (`fn`, `struct`, `enum`, `const`, `static`, `trait`, `type`,
// `mod`) is name.
fn defines(text: &[u8], name: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        while i < text.len() as i64 && is_blank(text[i as usize]) {
            i += 1;
        }
        let mut e = i;
        while e < text.len() as i64 && !is_blank(text[e as usize]) && text[e as usize] != b'('
            && text[e as usize] != b'<'
            && text[e as usize] != b'{' && text[e as usize] != b':' && text[e as usize] != b';' {
            e += 1;
        }
        let w = &text[i as usize..e as usize];
        if w.len() >= 2 && w[0] == b'/' && w[1] == b'/' {
            while e < text.len() as i64 && text[e as usize] != b'\n' {
                e += 1;
            }
        } else if keyword(w) {
            let mut a = e;
            while a < text.len() as i64 && is_blank(text[a as usize]) {
                a += 1;
            }
            let mut b = a;
            while b < text.len() as i64
                && (text[b as usize] == b'_'
                    || (text[b as usize] >= b'a' && text[b as usize] <= b'z')
                    || (text[b as usize] >= b'A' && text[b as usize] <= b'Z')
                    || (text[b as usize] >= b'0' && text[b as usize] <= b'9')) {
                b += 1;
            }
            return bytes_eq(&text[a as usize..b as usize], name);
        }
        if e == i {
            e += 1;
        }
        i = e;
    }
    false
}

fn keyword(w: &[u8]) -> bool {
    bytes_eq(w, b"fn") || bytes_eq(w, b"struct") || bytes_eq(w, b"enum") || bytes_eq(w, b"const")
        || bytes_eq(w, b"static") || bytes_eq(w, b"trait") || bytes_eq(w, b"type")
        || bytes_eq(w, b"mod")
}

// The text of buffer `text` at the end of module `module`'s file (`item`:
// the new item's name, when the block's header gave it). False after the diagnostic.
fn add_to_module(module: &[u8], text: i64, summary: i64, item: &[u8], tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
    find_modules(module, false, &mut modules, tcx, pcx);
    if modules.len() as i64 == 0 && root_stem(module, pcx) {
        modules.push(0);
    }
    let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..modules.len() as i64 {
        for f in 0..pcx.files.len() as i64 {
            if pcx.files[f as usize].module == (modules[i as usize])
                && !file_made(f, pcx)
                && pcx.files[f as usize].kind == SOURCE_VOLE {
                files.push(f);
            }
        }
    }
    if files.len() as i64 != 1 {
        let d = diag(c"error",
            if files.len() as i64 == 0 { c"edit.no-module" } else { c"query.ambiguous" }, tcx);
        if files.len() as i64 == 0 {
            buf_str(d, c"no module '");
            buf_bytes(d, module);
            buf_str(d, c"' with a file of its own; name an item to put the text after (`@@ new after NAME`)\n");
        } else {
            buf_bytes(d, module);
            buf_str(d, c" names ");
            buf_int(d, files.len() as i64);
            buf_str(d, c" modules; give more of its path\n");
        }
        let out = try_begin(c"items", module, true, tcx, pcx);
        try_end(out);
        return false;
    }
    let f = (files[0]);
    let t = item_text(&buf_copy(text), &get_src()[0..0]);
    let out = buf_new();
    let end = pcx.files[f as usize].end;
    if end > pcx.files[f as usize].start && get_src()[(end - 1) as usize] != b'\n' {
        buf_byte(out, b'\n');
    }
    if end > pcx.files[f as usize].start {
        buf_byte(out, b'\n');
    }
    buf_append(out, t);
    buf_byte(out, b'\n');
    edit_replace(end, end, out, pcx);
    if item.len() > 0 {
        buf_str(summary, c"added ");
        let fqn = mod_fqn(pcx.files[f as usize].module, tcx, pcx);
        buf_bytes(summary, crate::base::sym_text(fqn, pcx));
        buf_str(summary, c"::");
        buf_bytes(summary, item);
    } else {
        buf_str(summary, c"inserted in ");
        let fqn = mod_fqn(pcx.files[f as usize].module, tcx, pcx);
        buf_bytes(summary, crate::base::sym_text(fqn, pcx));
    }
    true
}
