// `volec edit apply [FILE] [--dry-run] [--show] [--no-check] [ROOT]`
// (0.15; docs/refactor.md, "edit apply"): the new text of several items in
// one file (stdin without FILE), each block introduced by a header line,
// made one edit: checked once, written all or not at all, one `undo`.
//
//   // PATH<TAB>FILE:A-B     (a header of `query show`) the item PATH
//                            becomes the text below it
//   @@ NAME                  NAME becomes the text below it; a NAME no
//                            definition has, whose text defines it, is
//                            added at the end of its module
//   @@ new after NAME        the text goes after NAME (`new before NAME`)
//   @@ new in MODULE         the text goes at the end of MODULE's file
//   @@ delete NAME           NAME goes (no text)
//
// So `query show A B` (or the items of `query context`), changed and
// given back, is a round trip. Each block is the edit `edit replace`,
// `insert` or `delete` would make (cli's item_edit, region_edit for
// `MODULE::use` and `MODULE::header`); the imports the new text needs are
// added, as for edit replace.

use std::Arena;

use crate::base::{
    BUFS, IntVec, SOURCE_VOLE, SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_WORD, Leaf};
use crate::front::embed::wgsl::WgslCx;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::cli::{edit_opts, item_edit, region_edit, source_only, take_edit_event};
use crate::tools::edit::items::item_text;
use crate::tools::edit::stdedit::{rerun_in_std_tree, rerun_wanted};
use crate::tools::proc::{read_file_if, read_stdin};
use crate::tools::query::{c_slice, file_line, resolve_name, root_or_diag};
use crate::tools::query::cache::cache_restore;
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{bytes_eq, find_defs, last_segment, mod_fqn};
use crate::tools::query::diagnostics::{diag, program_errors, try_begin, try_end};
use crate::tools::query::show::find_modules;
use crate::tools::query_text::{region_target, root_stem};

// `edit apply`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn apply_leaf(gpa: Gpa) -> Leaf<Gpa> {
    let opts = edit_opts(gpa);
    Leaf::new(opts, "file")
}

pub fn run_apply(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>, wgx: inout WgslCx<Arena>) -> i64 {
    set_command(c.line, &tcx);
    var root = 0 as *u8;
    var file = 0 as *u8;
    var dash = false;
    for e in c.evs.iter() {
        var ev = e;
        let a = ev.value;
        if take_edit_event(&ev, &root, &tcx, &pcx) {
        } else if ev.kind != EV_WORD {
            let d = diag(c"error", c"edit.usage", &tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' of edit apply (--dry-run, --show, --no-check, --root, --target)\n");
            return 2;
        } else if file == 0 as *u8 {
            file = a;
            dash = ev.text == "-";
        } else if root == 0 as *u8 && crate::base::is_source_path(a) {
            root = a;
        } else {
            return usage(c"one FILE of blocks (or none: stdin)", &tcx, pcx);
        }
    }
    unsafe {
        let input = buf_new();
        if file == 0 as *u8 || dash {
            tcx.source = c"stdin";
            if !read_stdin(input, &tcx) || BUFS[input].len == 0 {
                let d = diag(c"error", c"edit.no-text", &tcx);
                buf_str(d, c"the blocks are read from FILE or stdin; none was given\n");
                let out = try_begin(c"apply", c_slice(c"items.vl"), true, &tcx, pcx);
                try_end(out);
                return 2;
            }
        } else {
            tcx.source = file;
            if !read_file_if(file, input) {
                let d = diag(c"error", c"edit.no-text", &tcx);
                buf_str(d, c"cannot read '");
                buf_str(d, file);
                buf_str(d, c"'\n");
                return 2;
            }
        }
        if !read_blocks(buf_slice(input), &tcx, pcx) {
            return 2;
        }
        tcx.root_given = root;
        root = root_or_diag(root, c"apply", c_slice(tcx.source), true, &tcx, pcx);
        if root == 0 as *u8 {
            return 2;
        }
        if !cache_restore(root, tcx.target, false, &tcx, &pcx)
            && !load_program(root, tcx.target, &tcx, &pcx, &wgx) {
            program_errors(c"error", root, true, &tcx, &pcx);
            return 1;
        }
        let summary = buf_new();
        if tcx.b_how.count > 1 {
            buf_str(summary, c"applied ");
            buf_int(summary, tcx.b_how.count);
            buf_str(summary, c" blocks: ");
        }
        var skip = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        chain_blocks(&skip, &tcx, pcx);
        for k in 0..tcx.b_how.count {
            if k > 0 {
                buf_str(summary, c"; ");
            }
            if skip.data[k] != 0 {
                buf_str(summary, if tcx.b_how.data[k] == 'a' { c"inserted after " }
                    else { c"inserted before " });
                buf_bytes(summary, buf_slice(tcx.applyfile_b_name.data[k]));
                continue;
            }
            if !apply_block(k, summary, &tcx, &pcx) {
                return if rerun_wanted(tcx) { rerun_in_std_tree(c.line, &tcx, pcx) } else { 1 };
            }
            if tcx.b_how.data[k] != 'd' {
                tcx.add_imports = true;
            }
        }
        apply_edit(buf_slice(summary), root, &tcx, &pcx)
    }
}

// (0.17) Blocks `@@ new after|before X` where X is an item an earlier
// block adds (not in the program yet): their text goes with that block's
// (after or before it); skip[k] is 1 for them.
fn chain_blocks(skip: inout IntVec, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        var owner = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var orig = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..tcx.b_how.count {
            skip.push(0);
            owner.push(k);
            orig.push(tcx.b_text.data[k]);
        }
        for k in 0..tcx.b_how.count {
            let how = tcx.b_how.data[k];
            if how != 'a' && how != 'b' {
                continue;
            }
            let name = buf_slice(tcx.applyfile_b_name.data[k]);
            var found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            find_defs(name, false, &found, tcx, pcx);
            if found.count > 0 {
                continue;
            }
            let seg = last_segment(name);
            for j in 0..k {
                let hj = tcx.b_how.data[j];
                if hj == 'd' || !defines(buf_slice(orig.data[j]), seg) {
                    continue;
                }
                let o = owner.data[j];
                let merged = buf_new();
                let first = if how == 'a' { tcx.b_text.data[o] } else { tcx.b_text.data[k] };
                let second = if how == 'a' { tcx.b_text.data[k] } else { tcx.b_text.data[o] };
                let t = buf_slice(first);
                var e = t.len as i64;
                while e > 0 && t[e - 1] == '\n' {
                    e -= 1;
                }
                buf_bytes(merged, t[0..e]);
                buf_str(merged, c"\n\n");
                buf_bytes(merged, buf_slice(second));
                tcx.b_text.data[o] = merged;
                owner.data[k] = o;
                skip.data[k] = 1;
                break;
            }
        }
    }
}

fn usage(message: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"edit.usage", &tcx);
    buf_str(d, message);
    buf_byte(d, '\n');
    let out = try_begin(c"apply items.vl --dry-run", c_slice(c""), false, &tcx, pcx);
    try_end(out);
    2
}

fn is_blank(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

fn trimmed(t: [u8]) -> [u8] {
    var a = 0;
    var b = t.len as i64;
    while a < b && is_blank(t[a]) {
        a += 1;
    }
    while b > a && is_blank(t[b - 1]) {
        b -= 1;
    }
    t[a..b]
}

fn starts_with(t: [u8], p: *u8) -> bool {
    unsafe {
        var i = 0;
        while p[i] != 0 {
            if i >= t.len as i64 || t[i] != p[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

// Whether line is a header (`@@ ...`, or `// PATH<TAB>FILE:A-B ...`): its
// kind into *how, its NAME into buffer name.
fn block_header(line: [u8], how: inout u8, name: i64) -> bool {
    if line.len >= 2 && line[0] == '@' && line[1] == '@' {
        let rest = trimmed(line[2..line.len]);
        how = 'r';
        var from = 0;
        if starts_with(rest, c"new after ") {
            how = 'a';
            from = 10;
        } else if starts_with(rest, c"new before ") {
            how = 'b';
            from = 11;
        } else if starts_with(rest, c"new in ") {
            how = 'n';
            from = 7;
        } else if starts_with(rest, c"delete ") {
            how = 'd';
            from = 7;
        }
        buf_bytes(name, trimmed(rest[from..]));
        return true;
    }
    // `// PATH<TAB>FILE:A-B`, as query show prints an item's header
    if line.len > 4 && line[0] == '/' && line[1] == '/' && line[2] == ' ' {
        var tab = 3;
        while tab < line.len as i64 && line[tab] != '\t' {
            if line[tab] == ' ' {
                return false;
            }
            tab += 1;
        }
        if tab >= line.len as i64 || tab == 3 {
            return false;
        }
        // (FILE:A-B, maybe more words after it: query context's)
        var place = trimmed(line[tab + 1..]);
        var w = 0;
        while w < place.len as i64 && place[w] != ' ' && place[w] != '\t' {
            w += 1;
        }
        place = place[0..w];
        var colon = false;
        for i in 0..place.len {
            if place[i] == ':' {
                colon = true;
            }
        }
        if !colon || place.len == 0 || place[place.len as i64 - 1] < '0'
            || place[place.len as i64 - 1] > '9' {
            return false;
        }
        how = 'r';
        buf_bytes(name, line[3..tab]);
        return true;
    }
    false
}

// The blocks of the input. False after the diagnostic.
fn read_blocks(input: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var text = -1;
        var n = 0;
        var i = 0;
        while i < input.len as i64 {
            var e = i;
            while e < input.len as i64 && input[e] != '\n' {
                e += 1;
            }
            let line = input[i..e];
            n += 1;
            var how = ' ';
            let name = buf_new();
            if block_header(line, &how, name) {
                if BUFS[name].len == 0 {
                    return format_error(n, c"a header names no item", &tcx, pcx);
                }
                text = buf_new();
                tcx.b_how.push(how as i64);
                tcx.applyfile_b_name.push(name);
                tcx.b_text.push(text);
                tcx.b_line.push(n);
            } else if text < 0 {
                if trimmed(line).len > 0 {
                    return format_error(n, c"text before the first header", &tcx, pcx);
                }
            } else {
                buf_bytes(text, line);
                buf_byte(text, '\n');
            }
            i = e + 1;
        }
        if tcx.b_how.count == 0 {
            return format_error(n, c"no block", &tcx, pcx);
        }
        for k in 0..tcx.b_how.count {
            let empty = trimmed(buf_slice(tcx.b_text.data[k])).len == 0;
            if tcx.b_how.data[k] == 'd' && !empty {
                return format_error(tcx.b_line.data[k], c"a delete block has no text", &tcx, pcx);
            }
            if tcx.b_how.data[k] != 'd' && empty {
                return format_error(tcx.b_line.data[k],
                    c"the block has no text (`@@ delete NAME` deletes an item)", &tcx, pcx);
            }
        }
        true
    }
}

fn format_error(line: i64, message: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    let d = diag(c"error", c"edit.format", &tcx);
    buf_str(d, tcx.source);
    buf_str(d, c" line ");
    buf_int(d, line);
    buf_str(d, c": ");
    buf_str(d, message);
    buf_str(d, c"; a block starts with `@@ NAME`, `@@ new after NAME`, `@@ new in MODULE`, `@@ delete NAME` or a header of query show\n");
    let out = try_begin(c"show", c_slice(c"NAME"), true, &tcx, pcx);
    try_end(out);
    false
}

// `how` as an edit of item_edit and region_edit.
fn item_how(how: i64) -> u8 {
    if how == 'r' { 'r' } else if how == 'a' { 'a' } else if how == 'b' { 'b' } else { 'd' }
}

// Block k, added to the engine's edits; its words in summary. False after
// the diagnostic.
fn apply_block(k: i64, summary: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let name = buf_slice(tcx.applyfile_b_name.data[k]);
        let how = tcx.b_how.data[k];
        let text = tcx.b_text.data[k];
        if how == 'n' {
            return add_to_module(name, text, summary, name[0..0], &tcx, &pcx);
        }
        // A module's use lines or header (0.12).
        var rf = 0;
        var rk = 0;
        var spans = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let r = region_target(name, c"show", &rf, &rk, &spans, &tcx, pcx);
        if r == 1 {
            return false;
        }
        if r == 0 {
            return region_edit(rf, rk, spans, item_how(how), text, summary, &tcx, &pcx) < 0;
        }
        // A new item named by its path: at the end of its module.
        var line = 0;
        if how == 'r' && file_line(name, &line) < 0 {
            var found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            find_defs(name, false, &found, tcx, pcx);
            let seg = last_segment(name);
            if found.count == 0 && seg.len < name.len
                && defines(buf_slice(text), seg) {
                return add_to_module(name[0..name.len as i64 - seg.len as i64 - 2], text, summary,
                    seg, &tcx, &pcx);
            }
        }
        var matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !resolve_name(c"show", name, &matches, &tcx, &pcx) {
            return false;
        }
        source_only(&matches, pcx);
        if matches.count > 1 {
            let d = diag(c"error", c"query.ambiguous", &tcx);
            buf_int(d, matches.count);
            buf_str(d, c" definitions match '");
            buf_bytes(d, name);
            buf_str(d, c"' (");
            buf_str(d, tcx.source);
            buf_str(d, c" line ");
            buf_int(d, tcx.b_line.data[k]);
            buf_str(d, c"); name one by its path in the header\n");
            let out = try_begin(c"def", name, true, &tcx, pcx);
            try_end(out);
            return false;
        }
        let d = matches.data[0];
        let f = crate::front::modules::file_of_pos(pcx.defs[d].start, pcx);
        if pcx.files[f].path[0] == '<' {
            // (0.17: std, in the repository: run_apply runs again in its
            // files; stdedit.vl)
            if crate::tools::edit::stdedit::std_rerun(f, &tcx, pcx) {
                return false;
            }
            let e = diag(c"error", c"edit.not-source", &tcx);
            buf_bytes(e, crate::base::sym_text(pcx.defs[d].fqn));
            buf_str(e, c" is in ");
            buf_str(e, pcx.files[f].path);
            buf_str(e, c", not in a file of the program\n");
            return false;
        }
        item_edit(item_how(how), d, text, summary, &tcx, &pcx)
    }
}

// Whether text defines an item named `name`: the word after its first
// keyword (`fn`, `struct`, `enum`, `const`, `static`, `trait`, `type`,
// `mod`) is name.
fn defines(text: [u8], name: [u8]) -> bool {
    var i = 0;
    while i < text.len as i64 {
        while i < text.len as i64 && is_blank(text[i]) {
            i += 1;
        }
        var e = i;
        while e < text.len as i64 && !is_blank(text[e]) && text[e] != '(' && text[e] != '<'
            && text[e] != '{' && text[e] != ':' && text[e] != ';' {
            e += 1;
        }
        let w = text[i..e];
        if w.len >= 2 && w[0] == '/' && w[1] == '/' {
            while e < text.len as i64 && text[e] != '\n' {
                e += 1;
            }
        } else if keyword(w) {
            var a = e;
            while a < text.len as i64 && is_blank(text[a]) {
                a += 1;
            }
            var b = a;
            while b < text.len as i64 && (text[b] == '_' || (text[b] >= 'a' && text[b] <= 'z')
                || (text[b] >= 'A' && text[b] <= 'Z') || (text[b] >= '0' && text[b] <= '9')) {
                b += 1;
            }
            return bytes_eq(text[a..b], name);
        }
        if e == i {
            e += 1;
        }
        i = e;
    }
    false
}

fn keyword(w: [u8]) -> bool {
    bytes_eq(w, "fn") || bytes_eq(w, "struct") || bytes_eq(w, "enum") || bytes_eq(w, "const")
        || bytes_eq(w, "static") || bytes_eq(w, "trait") || bytes_eq(w, "type")
        || bytes_eq(w, "mod")
}

// The text of buffer `text` at the end of module `module`'s file (`item`:
// the new item's name, when the block's header gave it). False after the diagnostic.
fn add_to_module(module: [u8], text: i64, summary: i64, item: [u8], tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(module, false, &modules, &tcx, pcx);
        if modules.count == 0 && root_stem(module, pcx) {
            modules.push(0);
        }
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..modules.count {
            for f in 0..pcx.files.len() as i64 {
                if pcx.files[f].module == modules.data[i] && pcx.files[f].path[0] != '<'
                    && pcx.files[f].kind == SOURCE_VOLE {
                    files.push(f);
                }
            }
        }
        if files.count != 1 {
            let d = diag(c"error",
                if files.count == 0 { c"edit.no-module" } else { c"query.ambiguous" }, &tcx);
            if files.count == 0 {
                buf_str(d, c"no module '");
                buf_bytes(d, module);
                buf_str(d, c"' with a file of its own; name an item to put the text after (`@@ new after NAME`)\n");
            } else {
                buf_bytes(d, module);
                buf_str(d, c" names ");
                buf_int(d, files.count);
                buf_str(d, c" modules; give more of its path\n");
            }
            let out = try_begin(c"items", module, true, &tcx, pcx);
            try_end(out);
            return false;
        }
        let f = files.data[0];
        let t = item_text(buf_slice(text), SRC[0..0]);
        let out = buf_new();
        let end = pcx.files[f].end;
        if end > pcx.files[f].start && SRC[end - 1] != '\n' {
            buf_byte(out, '\n');
        }
        if end > pcx.files[f].start {
            buf_byte(out, '\n');
        }
        buf_bytes(out, buf_slice(t));
        buf_byte(out, '\n');
        edit_replace(end, end, out, &pcx);
        if item.len > 0 {
            buf_str(summary, c"added ");
            let fqn = mod_fqn(pcx.files[f].module, &tcx, pcx);
            buf_bytes(summary, crate::base::sym_text(fqn));
            buf_str(summary, c"::");
            buf_bytes(summary, item);
        } else {
            buf_str(summary, c"inserted in ");
            let fqn = mod_fqn(pcx.files[f].module, &tcx, pcx);
            buf_bytes(summary, crate::base::sym_text(fqn));
        }
        true
    }
}
