// `edit wrap` (0.13; docs/refactor.md): lines of an item put in a block,
//
//   volec edit wrap TARGET --in HEAD [--body | --lines A-B] [ROOT]
//
// `HEAD { ... }` (`unsafe`, `loop`, `if c`; '' for a bare block) around a
// function's body (`--body`, the default: its braces on lines of their
// own) or around lines A to B of TARGET (the file's line numbers), every
// line of them one level (4 spaces) deeper; one edit of the engine,
// checked, journaled, undone by `undo`.

use std::alloc::Arena;

use crate::base::{
    buf_byte, buf_bytes, buf_copy, buf_int, buf_new, buf_str, get_src, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_FLAG, EV_MISSING, EV_OPTION, EV_WORD, Leaf, flag, option};
use crate::front::ast::NodeKind;
use crate::front::embed::wgsl::WgslCx;
use crate::front::modules::{file_made, file_of_pos};
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::apply_edit;
use crate::tools::edit::cli::{ambiguous, edit_opts, source_only, take_edit_event};
use crate::tools::edit::items::{after_line, item_tail};
use crate::tools::edit::stdedit::{rerun_in_std_tree, std_rerun};
use crate::tools::query::{c_slice, resolve_name, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::diagnostics::{diag, program_errors, try_begin, try_end};
use crate::tools::query::positions::{line_end, line_index, line_of, line_start};
use crate::tools::query::show::text_start;

// `edit wrap`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn wrap_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    table.push(option("in", "HEAD",
        "the block's head: unsafe, loop, 'if c' ('' for a bare one)"));
    table.push(option("lines", "A-B", "these lines, not the body"));
    table.push(flag("body", "the body"));
    Leaf::new(table, "name")
}

pub fn run_wrap(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let mut root = 0 as *mut u8;
    let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut head = 0 as *mut u8;
    let mut lines = 0 as *mut u8;
    let mut body = false;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        if ev.kind == EV_MISSING && (ev.name == "in" || ev.name == "lines") {
            return usage(ev.value, c" needs a value", tcx, pcx);
        }
        if ev.kind == EV_OPTION && ev.name == "in" {
            head = ev.value;
        } else if ev.kind == EV_OPTION && ev.name == "lines" {
            lines = ev.value;
        } else if ev.kind == EV_FLAG && ev.name == "body" {
            body = true;
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
        } else if ev.kind != EV_WORD {
            return usage(ev.value, c": an unknown option", tcx, pcx);
        } else {
            names.push(ev.value as i64);
        }
    }
    // UNSAFE: strlen is C's; a file's path is a C string in the front end's
    // table, read through its raw pointer.
    // SAFETY: head is checked not null before this point (--in is needed),
    // a C string of the command line; a path has at least its 0 byte.
    unsafe {
        if names.len() as i64 == 2 && root == 0 as *mut u8
            && crate::base::is_source_path((names[1]) as *mut u8) {
            root = (names[1]) as *mut u8;
            names.truncate(1 as usize);
        }
        if names.len() as i64 != 1 {
            return usage(c"wrap",
                if names.len() as i64 == 0 { c": a TARGET is needed" }
                else { c": one TARGET at a time" },
                tcx, pcx);
        }
        if head == 0 as *mut u8 {
            return usage(c"wrap",
                c": --in HEAD is needed (unsafe, loop, 'if c'; '' for a bare block)", tcx, pcx);
        }
        if body && lines != 0 as *mut u8 {
            return usage(c"wrap", c": --body or --lines A-B, not both", tcx, pcx);
        }
        let mut la: i64 = 0;
        let mut lb: i64 = 0;
        if lines != 0 as *mut u8 && !line_range(c_slice(lines), &mut la, &mut lb) {
            return usage(lines, c": --lines takes A-B, the first and last line (or one line, A)",
                tcx, pcx);
        }
        let name = c_slice((names[0]) as *mut u8);
        tcx.root_given = root;
        root = root_or_diag(root, c"wrap", name, true, tcx, pcx);
        if root == 0 as *mut u8 {
            return 2;
        }
        if !load_program(root, tcx.target, tcx, pcx, wgx) {
            program_errors(c"error", root, true, tcx, pcx);
            return 1;
        }
        let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
        if !resolve_name(c"wrap", name, &mut matches, tcx, pcx) {
            return 1;
        }
        source_only(&mut matches, pcx);
        if matches.len() as i64 > 1 {
            ambiguous(c"wrap", name, matches.as_slice(), tcx, pcx);
            return 1;
        }
        let d = (matches[0]);
        let f = file_of_pos(pcx.defs[d as usize].start, pcx);
        let fqn = sym_text(pcx.defs[d as usize].fqn, pcx);
        if file_made(f, pcx) {
            // (0.17: std, in the repository: in its files; stdedit.vl)
            if std_rerun(f, tcx, pcx) {
                return rerun_in_std_tree(c.line, tcx, pcx);
            }
            let e = diag(c"error", c"edit.not-source", tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" is in ");
            buf_str(e, pcx.files[f as usize].path);
            buf_str(e, c", not in a file of the program\n");
            return 1;
        }
        // The lines: [first, last), whole lines.
        let mut first: i64 = 0;
        let mut last: i64 = 0;
        if lines == 0 as *mut u8 {
            let n = pcx.defs[d as usize].node;
            if n <= 0 || pcx.nodes[n as usize].kind != NodeKind::Fn
                || pcx.nodes[n as usize].c <= 0 {
                let e = diag(c"error", c"edit.wrap", tcx);
                buf_bytes(e, fqn);
                buf_str(e, c" is not a function with a body; wrap lines of it with --lines A-B\n");
                try_end(try_begin(c"show", fqn, true, tcx, pcx));
                return 1;
            }
            let b = pcx.nodes[n as usize].c;
            let s = pcx.nodes[b as usize].start;
            let e = pcx.nodes[b as usize].end;
            if get_src()[s as usize] != b'{' || get_src()[(e - 1) as usize] != b'}'
                || line_of(s, pcx) == line_of(e - 1, pcx) || !blank(s + 1, line_end(s, pcx))
                || !blank(line_start(e - 1, pcx), e - 1) {
                let x = diag(c"error", c"edit.layout", tcx);
                buf_str(x, c"the braces of ");
                buf_bytes(x, fqn);
                buf_str(x,
                    c"'s body share their lines with code; wrap lines of it with --lines A-B\n");
                try_end(try_begin(c"show", fqn, true, tcx, pcx));
                return 1;
            }
            first = after_line(s, pcx);
            last = line_start(e - 1, pcx);
        } else {
            let top = line_of(line_start(text_start(d, pcx), pcx), pcx);
            let bottom = line_of(item_tail(d, tcx, pcx) - 1, pcx);
            if la < top || lb > bottom {
                let x = diag(c"error", c"edit.wrap", tcx);
                buf_str(x, c"lines ");
                put_range(x, la, lb);
                buf_str(x, c" are not all in ");
                buf_bytes(x, fqn);
                buf_str(x, c" (lines ");
                put_range(x, top, bottom);
                buf_str(x, c")\n");
                try_end(try_begin(c"show", fqn, true, tcx, pcx));
                return 1;
            }
            let base = line_index(pcx.files[f as usize].start, pcx);
            first = (pcx.lines[(base + la - 1) as usize]);
            last = after_line((pcx.lines[(base + lb - 1) as usize]), pcx);
        }
        // Their least indentation: the block's.
        let mut least: i64 = -1;
        let mut p = first;
        while p < last {
            let e = line_end(p, pcx);
            let mut a = p;
            while a < e && (get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\t') {
                a += 1;
            }
            if a < e && (least < 0 || a - p < least) {
                least = a - p;
            }
            p = e + 1;
        }
        if least < 0 {
            let x = diag(c"error", c"edit.wrap", tcx);
            buf_str(x, c"the lines to wrap are blank\n");
            return 1;
        }
        let text = buf_new();
        buf_bytes(text, &get_src()[first as usize..(first + least) as usize]);
        buf_str(text, head);
        if strlen(head) > 0 {
            buf_byte(text, b' ');
        }
        buf_str(text, c"{\n");
        p = first;
        while p < last {
            let e = line_end(p, pcx);
            if !blank(p, e) {
                buf_str(text, c"    ");
                buf_bytes(text, &get_src()[p as usize..e as usize]);
            }
            buf_byte(text, b'\n');
            p = e + 1;
        }
        buf_bytes(text, &get_src()[first as usize..(first + least) as usize]);
        buf_str(text, c"}\n");
        edit_replace(first, last, text, pcx);
        let what = buf_new();
        buf_str(what, c"wrapped ");
        if lines == 0 as *mut u8 {
            buf_str(what, c"the body of ");
        } else {
            buf_str(what, c"lines ");
            put_range(what, la, lb);
            buf_str(what, c" of ");
        }
        buf_bytes(what, fqn);
        buf_str(what, c" in ");
        buf_str(what, if strlen(head) > 0 { head } else { c"a block" });
        apply_edit(&buf_copy(what), root, tcx, pcx)
    }
}

fn usage(what: *mut u8, message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"edit.usage", tcx);
    buf_str(d, what);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = try_begin(c"wrap NAME --in unsafe --lines 12-20", b"", false, tcx, pcx);
    try_end(out);
    2
}

// `A-B` or `A`: the lines, A <= B, both from 1. Whether it is one.
fn line_range(s: &[u8], a: &mut i64, b: &mut i64) -> bool {
    let mut i: i64 = 0;
    let mut x: i64 = 0;
    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
        x = x * 10 + (s[i as usize] - b'0') as i64;
        i += 1;
    }
    if i == 0 {
        return false;
    }
    let mut y = x;
    if i < s.len() as i64 {
        if s[i as usize] != b'-' {
            return false;
        }
        i += 1;
        let from = i;
        y = 0;
        while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
            y = y * 10 + (s[i as usize] - b'0') as i64;
            i += 1;
        }
        if i == from || i < s.len() as i64 {
            return false;
        }
    }
    *a = x;
    *b = y;
    x >= 1 && x <= y
}

fn put_range(out: i64, a: i64, b: i64) {
    buf_int(out, a);
    if b > a {
        buf_byte(out, b'-');
        buf_int(out, b);
    }
}

// Whether SRC[from..to) is blanks without a newline.
fn blank(from: i64, to: i64) -> bool {
    for p in from..to {
        if get_src()[p as usize] != b' ' && get_src()[p as usize] != b'\t'
            && get_src()[p as usize] != b'\r' {
            return false;
        }
    }
    true
}
