// What an edit that adds errors broke (0.15; docs/refactor.md, "When an
// edit breaks the program"): each new error tagged with the item it is in,
// edited or not (`[edited: crate::f]`, `[in crate::main]`); then `edit.breaks`
// counting both, and `try:` lines chosen by what broke:
//
//   - an edited item's shape changed (a function's name or parameters, a
//     struct's fields, an enum's variants) and other items use it: the
//     refactoring that changes the uses with it (`refactor signature F
//     --add 'x: T = VALUE'`, `--remove`, `--rename-param`, `--type`,
//     `--reorder`; `refactor rename`; `refactor field`, `refactor variant`),
//     computed from the item's old and new text;
//   - errors in items the edit does not change: their text (`query show`),
//     to change them in the same edit (`edit apply`, `edit patch` with
//     `@@ NAME` blocks);
//   - last, the command with --no-check.
//
// The edited program's lines are mapped to the program's through the
// edit's diff (its hunks: old lines A..A+B are new lines C..C+D).

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;
use crate::tools::edit::apply::{command_is, try_again};
use crate::tools::edit::diff::{diff_texts, file_by_path};
use crate::tools::edit::items::item_tail;
use crate::tools::query::{c_slice, def_at_line};
use crate::tools::query::defs::{
    K_ENUM, K_FN, K_IMPL_METHOD, K_METHOD, K_STRUCT, K_TRAIT_FN, bytes_eq, find_in,
};
use crate::tools::query::diagnostics::{diag, diags, put_cword, put_root, put_word, try_end};
use crate::tools::query::positions::line_of;
use crate::tools::query::refs::file_text;
use crate::tools::query::show::text_start;

// The new errors (lines, in buffers) of an edit: printed, tagged; then
// `edit.breaks` and its `try:` lines (`refused`: nothing was written).
pub fn report_breaks(added: IntVec, refused: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        tcx.e_def.count = 0;
        tcx.e_edited.count = 0;
        let lines = buf_new();
        let mut in_edit: i64 = 0;
        for i in 0..added.count {
            let line = buf_slice((*added.data.add(i as usize)));
            let mut edited = false;
            let d = error_item(line, &mut edited, tcx, pcx);
            tcx.e_def.push(d);
            tcx.e_edited.push(if edited { 1 } else { 0 });
            buf_bytes(lines, line);
            if edited {
                in_edit += 1;
                buf_str(lines, c"  [edited");
                if d >= 0 {
                    buf_str(lines, c": ");
                    buf_bytes(lines, sym_text(pcx.defs[d as usize].fqn, pcx));
                }
                buf_byte(lines, b']');
            } else if d >= 0 {
                buf_str(lines, c"  [in ");
                buf_bytes(lines, sym_text(pcx.defs[d as usize].fqn, pcx));
                buf_byte(lines, b']');
            }
            buf_byte(lines, b'\n');
        }
        buf_write_fd(lines, STDOUT);
        // The items not edited that have errors, once each.
        let mut others = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..tcx.e_def.count {
            let d = (*tcx.e_def.data.add(i as usize));
            if (*tcx.e_edited.data.add(i as usize)) == 0 && d >= 0 && !has(others, d) {
                others.push(d);
            }
        }
        let n = added.count;
        let d = diag(if refused { c"error" } else { c"warning" }, c"edit.breaks", tcx);
        buf_int(d, n);
        buf_str(d, if n == 1 { c" new error" } else { c" new errors" });
        if others.count > 0 {
            buf_str(d, c" (");
            if in_edit > 0 {
                buf_int(d, in_edit);
                buf_str(d, c" in the edited text, ");
            }
            buf_int(d, n - in_edit);
            buf_str(d, c" in ");
            put_names(d, others, pcx);
            buf_str(d, c", which the edit does not change)");
        }
        buf_str(d,
            if refused { c"; nothing written" } else if tcx.dry_run { c" (dry run)" }
            else { c"; written anyway (--no-check)" });
        // (0.25.5, feedbacks/opt254.md #3, bugs254.md #7: the cause, in the
        // line that a view of the last lines keeps; the first in the edited
        // text, the likeliest cause, when there is one)
        let mut first: i64 = 0;
        while first < n && (*tcx.e_edited.data.add(first as usize)) == 0 {
            first += 1;
        }
        if first == n {
            first = 0;
        }
        buf_str(d, if n == 1 { c"; the error: " } else if in_edit > 0 && in_edit < n {
            c"; the first in the edited text: " } else { c"; the first: " });
        put_first_error(d, buf_slice((*added.data.add(first as usize))));
        buf_byte(d, b'\n');
        if !refused {
            if !tcx.dry_run {
                let out = diags(tcx);
                buf_str(out, c"try:");
                put_cword(out, pcx.prog);
                buf_str(out, c" check");
                put_root(out, tcx);
                try_end(out);
            }
            return;
        }
        // The refactorings that fit, for the edited items whose uses broke
        // (errors outside the edited text: a `use` line too); with errors
        // in the edited text only, a parameter renamed.
        let outside = n - in_edit;
        {
            let mut seen = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for i in 0..tcx.e_def.count {
                let e = (*tcx.e_def.data.add(i as usize));
                if (*tcx.e_edited.data.add(i as usize)) != 0 && e >= 0 && !has(seen, e) {
                    seen.push(e);
                }
            }
            // (an edited item whose own text has no error: from the hunks)
            edited_items(&mut seen, tcx, pcx);
            let tries = buf_new();
            let mut n_try: i64 = 0;
            let mut first: i64 = -1;
            for i in 0..seen.count {
                if n_try < 4 {
                    let m = shape_tries(tries, (*seen.data.add(i as usize)), 4 - n_try,
                        outside == 0, tcx, pcx);
                    if m > 0 && first < 0 {
                        first = (*seen.data.add(i as usize));
                    }
                    n_try += m;
                }
            }
            if n_try > 0 {
                let r = diag(c"note", c"edit.refactor", tcx);
                buf_str(r, c"the uses of ");
                buf_bytes(r, sym_text(pcx.defs[first as usize].fqn, pcx));
                buf_str(r, c" no longer fit its new shape: a refactoring changes them with it");
                let t = buf_slice(tries);
                if find_in(t, c"VALUE", 0) >= 0 || find_in(t, c"EXPR", 0) >= 0 {
                    buf_str(r, c" (VALUE, EXPR: to fill in)");
                }
                buf_str(r, c", then the rest of the edit\n");
                buf_bytes(diags(tcx), buf_slice(tries));
            }
        }
        if others.count > 0 {
            let t = diag(c"note", c"edit.together", tcx);
            buf_str(t, c"change ");
            put_names(t, others, pcx);
            buf_str(t,
                c" in the same edit: one `edit apply FILE` with a block per item, or `edit patch --pairs FILE` with `@@ NAME` blocks\n");
            let out = diags(tcx);
            buf_str(out, c"try:");
            put_cword(out, pcx.prog);
            buf_str(out, c" query show");
            for i in 0..others.count {
                if i < 5 {
                    put_word(out,
                        sym_text(pcx.defs[(*others.data.add(i as usize)) as usize].fqn, pcx));
                }
            }
            put_root(out, tcx);
            try_end(out);
        }
        if tcx.break_hints >= 0 {
            buf_bytes(diags(tcx), buf_slice(tcx.break_hints));
        }
        // (only errors a later step would answer: a name not yet defined,
        // a type not yet changed; an effect or ownership error is not)
        let mut steps = refused;
        for i in 0..added.count {
            let line = buf_slice((*added.data.add(i as usize)));
            let mut typed = false;
            for j in 0..line.len() as i64 {
                if j + 18 <= line.len() as i64
                    && line[j as usize..(j + 18) as usize] == b"error[type error] " {
                    typed = true;
                }
            }
            if !typed {
                steps = false;
            }
        }
        if steps && others.count == 0 && command_is(b"edit", b"patch", tcx) {
            // (0.25.2.1: an agent refused at each step of a change of
            // several, the 0.25.2 eval)
            let t = diag(c"note", c"edit.together", tcx);
            buf_str(t,
                c"several steps are one call, checked at its end: `edit patch NAME --old A --new B --old C --new D` (`--in OTHER` before another item's pairs), `edit apply FILE`; or this step alone with --no-check\n");
        }
        try_again(c"--no-check", tcx, pcx);
    }
}

// An error's line, short (`FILE:L:C: error[KIND] MESSAGE | help: ...`), as
// `FILE:L:C: MESSAGE` into out: its kind and its help left out.
fn put_first_error(out: i64, line: &[u8]) {
    let mut i: i64 = 0;
    let mut from: i64 = 0;
    let mut place: i64 = 0;
    while i + 8 <= line.len() as i64 {
        if line[i as usize] == b':' && line[(i + 1) as usize] == b' '
            && line[i as usize..(i + 8) as usize] == b": error[" {
            place = i;
            let mut j = i + 8;
            while j < line.len() as i64 && line[j as usize] != b']' {
                j += 1;
            }
            from = if j + 2 <= line.len() as i64 { j + 2 } else { line.len() as i64 };
            break;
        }
        i += 1;
    }
    let mut to = line.len() as i64;
    let mut k = from;
    while k + 3 <= line.len() as i64 {
        if &line[k as usize..(k + 3) as usize] == b" | " {
            to = k;
            break;
        }
        k += 1;
    }
    if place > 0 {
        buf_bytes(out, &line[0..place as usize]);
        buf_str(out, c": ");
    }
    buf_bytes(out, &line[from as usize..to as usize]);
}

fn has(v: IntVec, x: i64) -> bool {
    unsafe {
        for i in 0..v.count {
            if (*v.data.add(i as usize)) == x {
                return true;
            }
        }
        false
    }
}

// The paths of the definitions of v, `a, b and 2 more`.
fn put_names(out: i64, v: IntVec, pcx: &Ctx<Comp>) {
    unsafe {
        let n = v.count;
        for i in 0..n {
            if i == 3 {
                buf_str(out, c" and ");
                buf_int(out, n - 3);
                buf_str(out, c" more");
                return;
            }
            if i > 0 {
                buf_str(out, if i == n - 1 { c" and " } else { c", " });
            }
            buf_bytes(out, sym_text(pcx.defs[(*v.data.add(i as usize)) as usize].fqn, pcx));
        }
    }
}

// ---- Lines of the edited program ----

// The index in CH_FILE of file f, or -1 when the edit leaves it.
pub fn changed_index(f: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        for i in 0..tcx.ch_file.count {
            if (*tcx.ch_file.data.add(i as usize)) == f {
                return i;
            }
        }
        -1
    }
}

// The file and line of a short diagnostic line (`PATH:LINE:COL: error[...]
// ...`): as file_by_path, the line in *line.
fn error_place(line: &[u8], at_line: &mut i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut at: i64 = -1;
    let mut i: i64 = 0;
    while i + 8 <= line.len() as i64 {
        if line[i as usize] == b':' && line[(i + 1) as usize] == b' '
            && line[(i + 2) as usize] == b'e' && line[(i + 3) as usize] == b'r'
            && line[(i + 4) as usize] == b'r' && line[(i + 7) as usize] == b'[' {
            at = i;
            break;
        }
        i += 1;
    }
    if at < 0 {
        return -1;
    }
    let p = &line[0..at as usize];
    let mut c2 = p.len() as i64 - 1;
    while c2 > 0 && p[c2 as usize] != b':' {
        c2 -= 1;
    }
    let mut c1 = c2 - 1;
    while c1 > 0 && p[c1 as usize] != b':' {
        c1 -= 1;
    }
    if c1 <= 0 {
        return -1;
    }
    let mut n: i64 = 0;
    for k in c1 + 1..c2 {
        if p[k as usize] < b'0' || p[k as usize] > b'9' {
            return -1;
        }
        n = n * 10 + (p[k as usize] - b'0') as i64;
    }
    *at_line = n;
    file_by_path(&p[0..c1 as usize], tcx, pcx)
}

// The hunks of the diff of changed file i (CH_FILE's index): A, B, C, D
// in fours (old lines A.. (B of them), new lines C.. (D of them)).
pub fn hunks(i: i64, out: &mut IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let a0 = tcx.added;
        let r0 = tcx.edit_removed;
        let f = (*tcx.ch_file.data.add(i as usize));
        let b = buf_new();
        diff_texts(b, file_text(f, pcx),
            &get_src()[pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize],
            buf_slice((*tcx.ch_text.data.add(i as usize))), tcx);
        tcx.added = a0;
        tcx.edit_removed = r0;
        let t = buf_slice(b);
        let mut p: i64 = 0;
        while p < t.len() as i64 {
            let mut e = p;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            let l = &t[p as usize..e as usize];
            if l.len() > 4 && l[0] == b'@' && l[1] == b'@' && l[3] == b'-' {
                let mut k: i64 = 4;
                let a = number(l, &mut k);
                let mut nb: i64 = 1;
                if k < l.len() as i64 && l[k as usize] == b',' {
                    k += 1;
                    nb = number(l, &mut k);
                }
                k += 2;
                let c = number(l, &mut k);
                let mut nd: i64 = 1;
                if k < l.len() as i64 && l[k as usize] == b',' {
                    k += 1;
                    nd = number(l, &mut k);
                }
                out.push(a);
                out.push(nb);
                out.push(c);
                out.push(nd);
            }
            p = e + 1;
        }
    }
}

fn number(l: &[u8], k: &mut i64) -> i64 {
    let mut n: i64 = 0;
    while *k < l.len() as i64 && l[*k as usize] >= b'0' && l[*k as usize] <= b'9' {
        n = n * 10 + (l[*k as usize] - b'0') as i64;
        *k += 1;
    }
    n
}

// New line `line` of a file whose hunks are h: its old line, or -1 when
// the edit wrote it (then *anchor is the hunk's first old line, *insert
// whether the hunk only adds lines, after line *anchor).
pub fn old_line(h: IntVec, line: i64, anchor: &mut i64, insert: &mut bool) -> i64 {
    unsafe {
        let mut delta: i64 = 0;
        let mut k: i64 = 0;
        while k < h.count {
            let a = (*h.data.add(k as usize));
            let b = (*h.data.add((k + 1) as usize));
            let c = (*h.data.add((k + 2) as usize));
            let d = (*h.data.add((k + 3) as usize));
            if d > 0 && line >= c && line < c + d {
                *anchor = a;
                *insert = b == 0;
                return -1;
            }
            if (d > 0 && line < c) || (d == 0 && line <= c) {
                return line - delta;
            }
            delta += d - b;
            k += 4;
        }
        line - delta
    }
}

// Old line `line`'s new line (`end`: as the last line of a range).
fn new_line(h: IntVec, line: i64, end: bool) -> i64 {
    unsafe {
        let mut delta: i64 = 0;
        let mut k: i64 = 0;
        while k < h.count {
            let a = (*h.data.add(k as usize));
            let b = (*h.data.add((k + 1) as usize));
            let c = (*h.data.add((k + 2) as usize));
            let d = (*h.data.add((k + 3) as usize));
            if b > 0 && line >= a && line < a + b {
                if end {
                    return if d > 0 { c + d - 1 } else { c };
                }
                return if d > 0 { c } else { c + 1 };
            }
            if (b > 0 && line < a) || (b == 0 && line <= a) {
                return line + delta;
            }
            delta += d - b;
            k += 4;
        }
        line + delta
    }
}

// The first and last lines of definition d's text.
fn def_lines(d: i64, first: &mut i64, last: &mut i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    *first = line_of(text_start(d, pcx), pcx);
    *last = line_of(item_tail(d, tcx, pcx) - 1, pcx);
}

// Whether the hunks h change a line of definition d's text (or add lines
// inside it).
fn touched(h: IntVec, d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut s: i64 = 0;
        let mut e: i64 = 0;
        def_lines(d, &mut s, &mut e, tcx, pcx);
        let mut k: i64 = 0;
        while k < h.count {
            let a = (*h.data.add(k as usize));
            let b = (*h.data.add((k + 1) as usize));
            if b > 0 && a <= e && a + b - 1 >= s {
                return true;
            }
            if b == 0 && a >= s && a < e {
                return true;
            }
            k += 4;
        }
        false
    }
}

// The definition a new error is in (-1: none), and whether the edit
// changed it (*edited).
fn error_item(line: &[u8], edited: &mut bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut at: i64 = 0;
    let f = error_place(line, &mut at, tcx, pcx);
    if f == -2 {
        *edited = true;
        return -1;
    }
    if f < 0 {
        *edited = false;
        return -1;
    }
    let i = changed_index(f, tcx);
    if i < 0 {
        *edited = false;
        return def_at_line(f, at, pcx);
    }
    let mut h = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    hunks(i, &mut h, tcx, pcx);
    let mut anchor: i64 = 0;
    let mut insert = false;
    let old = old_line(h, at, &mut anchor, &mut insert);
    if old < 0 {
        *edited = true;
        let d = def_at_line(f, anchor, pcx);
        if insert && d >= 0 && def_at_line(f, anchor + 1, pcx) != d {
            return -1;
        }
        return d;
    }
    let d = def_at_line(f, old, pcx);
    *edited = d >= 0 && touched(h, d, tcx, pcx);
    d
}

// (0.18) Whether the error of short diagnostic line `line` is on a line
// the edit wrote (`fix --suggested`: an error on no such line is one the
// fixes let the checker reach, not one they made).
pub fn on_changed_line(line: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut at: i64 = 0;
    let f = error_place(line, &mut at, tcx, pcx);
    if f == -2 {
        return true;
    }
    if f < 0 {
        return false;
    }
    let i = changed_index(f, tcx);
    if i < 0 {
        return false;
    }
    let mut h = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    hunks(i, &mut h, tcx, pcx);
    let mut anchor: i64 = 0;
    let mut insert = false;
    old_line(h, at, &mut anchor, &mut insert) < 0
}

// The definitions the edit changes (from its hunks), added to v.
fn edited_items(v: &mut IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        for i in 0..tcx.ch_file.count {
            let f = (*tcx.ch_file.data.add(i as usize));
            let mut h = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            hunks(i, &mut h, tcx, pcx);
            let mut k: i64 = 0;
            while k < h.count {
                let a = (*h.data.add(k as usize));
                let b = (*h.data.add((k + 1) as usize));
                let mut l = a;
                while l < a + (if b > 0 { b } else { 1 }) {
                    let d = def_at_line(f, l, pcx);
                    if d >= 0 && (b > 0 || def_at_line(f, l + 1, pcx) == d) && !has(*v, d) {
                        v.push(d);
                    }
                    l += 1;
                }
                k += 4;
            }
        }
    }
}

// ---- Shapes: a function's parameters, a struct's fields, an enum's variants ----

fn is_blank(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\n' || c == b'\r'
}

fn is_word(c: u8) -> bool {
    c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
}

fn trimmed(t: &[u8]) -> &[u8] {
    let mut a: i64 = 0;
    let mut b = t.len() as i64;
    while a < b && is_blank(t[a as usize]) {
        a += 1;
    }
    while b > a && is_blank(t[(b - 1) as usize]) {
        b -= 1;
    }
    &t[a as usize..b as usize]
}

// text without its comments (`// ...` to the end of the line), a buffer.
fn uncommented(t: &[u8]) -> &[u8] {
    let out = buf_new();
    let mut i: i64 = 0;
    let mut quote = 0 as u8;
    while i < t.len() as i64 {
        let c = t[i as usize];
        if quote != 0 {
            buf_byte(out, c);
            if c == b'\\' && i + 1 < t.len() as i64 {
                buf_byte(out, t[(i + 1) as usize]);
                i += 2;
                continue;
            }
            if c == quote {
                quote = 0;
            }
        } else if c == b'"' {
            quote = c;
            buf_byte(out, c);
        } else if c == b'/' && i + 1 < t.len() as i64 && t[(i + 1) as usize] == b'/' {
            while i < t.len() as i64 && t[i as usize] != b'\n' {
                i += 1;
            }
            continue;
        } else {
            buf_byte(out, c);
        }
        i += 1;
    }
    buf_slice(out)
}

// The position of the item's keyword word `kw` (fn, struct, enum, ...) in
// t, and the name after it into *name_s, *name_e; -1 when there is none.
fn keyword_at(t: &[u8], kw: *mut u8, name_s: &mut i64, name_e: &mut i64) -> i64 {
    let k = c_slice(kw);
    let mut i: i64 = 0;
    while i + k.len() as i64 < t.len() as i64 {
        if (i == 0 || !is_word(t[(i - 1) as usize]))
            && bytes_eq(&t[i as usize..(i + k.len() as i64) as usize], k)
            && is_blank(t[(i + k.len() as i64) as usize]) {
            let mut a = i + k.len() as i64;
            while a < t.len() as i64 && is_blank(t[a as usize]) {
                a += 1;
            }
            let mut b = a;
            while b < t.len() as i64 && is_word(t[b as usize]) {
                b += 1;
            }
            if b > a {
                *name_s = a;
                *name_e = b;
                return i;
            }
        }
        i += 1;
    }
    -1
}

// The group opened at t[from] (or after it): its inside, between `open` and
// its matching `close` (nesting by ()[]{}<>, as far as the text shows).
fn group(t: &[u8], from: i64, open: u8, inside_s: &mut i64, inside_e: &mut i64) -> bool {
    let mut i = from;
    while i < t.len() as i64 && t[i as usize] != open {
        if open == b'(' && (t[i as usize] == b'{' || t[i as usize] == b';') {
            return false;
        }
        i += 1;
    }
    if i >= t.len() as i64 {
        return false;
    }
    let mut depth: i64 = 0;
    let s = i + 1;
    while i < t.len() as i64 {
        let c = t[i as usize];
        if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            depth -= 1;
            if depth == 0 {
                *inside_s = s;
                *inside_e = i;
                return true;
            }
        }
        i += 1;
    }
    false
}

// The parts of t between top-level commas, trimmed (start, end pairs into
// out); empty parts are left out.
fn parts(t: &[u8], out: &mut IntVec) {
    let mut depth: i64 = 0;
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i <= t.len() as i64 {
        if i == t.len() as i64 || (t[i as usize] == b',' && depth == 0) {
            let mut a = s;
            let mut b = i;
            while a < b && is_blank(t[a as usize]) {
                a += 1;
            }
            while b > a && is_blank(t[(b - 1) as usize]) {
                b -= 1;
            }
            if b > a {
                out.push(a);
                out.push(b);
            }
            s = i + 1;
        }
        else if t[i as usize] == b'(' || t[i as usize] == b'[' || t[i as usize] == b'{'
            || t[i as usize] == b'<' {
            depth += 1;
        }
        else if t[i as usize] == b')' || t[i as usize] == b']' || t[i as usize] == b'}'
            || (t[i as usize] == b'>' && i > 0 && t[(i - 1) as usize] != b'-') {
            depth -= 1;
        }
        i += 1;
    }
}

// A part `NAME: TYPE` (`mut`, `pub`, `pub(crate)` before NAME left out;
// `self` in any form is named `self`): its name and type.
fn name_type(p: &[u8]) -> (&[u8], &[u8]) {
    let mut s = trimmed(p);
    if s.len() > 4 && bytes_eq(&s[0..4], b"pub ") {
        s = trimmed(&s[4..s.len()]);
    } else if s.len() > 4 && bytes_eq(&s[0..4], b"pub(") {
        let mut i: i64 = 4;
        while i < s.len() as i64 && s[i as usize] != b')' {
            i += 1;
        }
        s = trimmed(&s[(i + 1) as usize..]);
    }
    if s.len() > 4 && bytes_eq(&s[0..4], b"mut ") {
        s = trimmed(&s[4..s.len()]);
    }
    let mut c: i64 = 0;
    while c < s.len() as i64 && s[c as usize] != b':' {
        c += 1;
    }
    if c >= s.len() as i64 {
        // (`self`, `&self`, `*mut self`)
        let name = if s.len() >= 4
            && bytes_eq(&s[(s.len() as i64 - 4) as usize..], b"self") { b"self" } else { s };
        return (name, &s[0..0]);
    }
    (trimmed(&s[0..c as usize]), trimmed(&s[(c + 1) as usize..]))
}

// A variant `NAME(...)`, `NAME { ... }`, `NAME = N`: its name and the rest.
fn variant_parts(p: &[u8]) -> (&[u8], &[u8]) {
    let s = trimmed(p);
    let mut i: i64 = 0;
    while i < s.len() as i64 && is_word(s[i as usize]) {
        i += 1;
    }
    (&s[0..i as usize], trimmed(&s[i as usize..]))
}

// The elements of an item's text: a function's parameters ('f'), a
// struct's fields ('s'), an enum's variants ('e'): names and types (or a
// variant's payload) as slices of t, into names and types (pairs of
// start and length in t); the item's name into *name. False when the text
// does not show them.
fn elements<'a>(t: &'a [u8], what: u8, name: *mut &'a [u8], names: &mut IntVec, types: &mut IntVec) -> bool {
    unsafe {
        let kw = if what == b'f' { c"fn" } else if what == b's' { c"struct" } else { c"enum" };
        let mut ns: i64 = 0;
        let mut ne: i64 = 0;
        let at = keyword_at(t, kw, &mut ns, &mut ne);
        if at < 0 {
            return false;
        }
        *name = &t[ns as usize..ne as usize];
        let mut a: i64 = 0;
        let mut b: i64 = 0;
        if !group(t, ne, if what == b'f' { b'(' } else { b'{' }, &mut a, &mut b) {
            return false;
        }
        let mut ps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        parts(&t[a as usize..b as usize], &mut ps);
        let mut k: i64 = 0;
        while k < ps.count {
            let p = &t[
                (a + (*ps.data.add(k as usize))) as usize..(a + (*ps.data.add((k + 1) as usize))) as usize];
            let (n, ty) = if what == b'e' { variant_parts(p) } else { name_type(p) };
            names.push(n.ptr as i64);
            names.push(n.len() as i64);
            types.push(ty.ptr as i64);
            types.push(ty.len() as i64);
            k += 2;
        }
        true
    }
}

// Element k of v (as elements makes them).
fn el(v: IntVec, k: i64) -> &'static [u8] {
    unsafe { std::slice::from_raw_parts(
        ((*v.data.add((2 * k) as usize)) as *mut u8).add((0) as usize),
        ((*v.data.add((2 * k + 1) as usize)) - (0)) as usize) }
}

fn el_count(v: IntVec) -> i64 {
    v.count / 2
}

// The index of the element named n in names, or -1.
fn el_index(names: IntVec, n: &[u8]) -> i64 {
    for k in 0..el_count(names) {
        if bytes_eq(el(names, k), n) {
            return k;
        }
    }
    -1
}

// The new text of definition d (the edited file's lines its old lines
// became), or an empty slice.
fn new_text<'a>(d: i64, tcx: &mut Tcx<Comp>, pcx: &'a Ctx<Comp>) -> &'a [u8] {
    unsafe {
        let f = crate::front::modules::file_of_pos(pcx.defs[d as usize].start, pcx);
        let i = changed_index(f, tcx);
        if i < 0 {
            return &get_src()[0..0];
        }
        let mut h = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        hunks(i, &mut h, tcx, pcx);
        let mut s: i64 = 0;
        let mut e: i64 = 0;
        def_lines(d, &mut s, &mut e, tcx, pcx);
        let a = new_line(h, s, false);
        let b = new_line(h, e, true);
        let t = buf_slice((*tcx.ch_text.data.add(i as usize)));
        let mut line: i64 = 1;
        let mut p: i64 = 0;
        let mut from: i64 = if a == 1 { 0 } else { -1 };
        while p < t.len() as i64 {
            if t[p as usize] == b'\n' {
                if line == b {
                    return if from >= 0 { &t[from as usize..(p + 1) as usize] } else { &t[0..0] };
                }
                line += 1;
                if line == a {
                    from = p + 1;
                }
            }
            p += 1;
        }
        if from >= 0 { &t[from as usize..] } else { &t[0..0] }
    }
}

// (0.15) A parameter's type text without its default (`i64 = 1`: `i64`).
fn without_default(s: &[u8]) -> &[u8] {
    let mut depth: i64 = 0;
    for i in 0..s.len() as i64 {
        let c = s[i as usize];
        if c == b'(' || c == b'[' || c == b'<' {
            depth += 1;
        } else if c == b')' || c == b']' || (c == b'>' && i > 0 && s[(i - 1) as usize] != b'-') {
            depth -= 1;
        } else if c == b'=' && depth == 0 {
            let mut e = i;
            while e > 0 && s[(e - 1) as usize] == b' ' {
                e -= 1;
            }
            return &s[0..e as usize];
        }
    }
    s
}

// The `try:` lines of the refactorings that change definition d's uses
// with it, at most `max`, appended to buffer out: their number.
fn shape_tries(out: i64, d: i64, max: i64, renames_only: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let k = pcx.defs[d as usize].kind;
    let what = if k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN { b'f' }
        else if k == K_STRUCT { b's' } else if k == K_ENUM { b'e' } else { b' ' };
    if what == b' ' {
        return 0;
    }
    let nt = new_text(d, tcx, pcx);
    if nt.len() == 0 {
        return 0;
    }
    let old = uncommented(&get_src()[text_start(d, pcx) as usize..item_tail(d, tcx, pcx) as usize]);
    let new = uncommented(nt);
    let mut old_name = &old[0..0];
    let mut new_name = &old[0..0];
    let mut on = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut ot = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut nn = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut ntt = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    if !elements(old, what, &mut old_name, &mut on, &mut ot)
        || !elements(new, what, &mut new_name, &mut nn, &mut ntt) {
        return 0;
    }
    let path = sym_text(pcx.defs[d as usize].fqn, pcx);
    let mut n: i64 = 0;
    if !bytes_eq(old_name, new_name) && !renames_only {
        put_try_head(out, c"refactor rename", path, pcx);
        put_word(out, new_name);
        put_root(out, tcx);
        try_end(out);
        n += 1;
    }
    let cmd = if what == b'f' { c"refactor signature" } else if what == b's' { c"refactor field" }
        else { c"refactor variant" };
    let oc = el_count(on);
    let nc = el_count(nn);
    // Renamed in place: as many, the same types, other names.
    let mut renamed = oc == nc && oc > 0;
    let mut any_rename = false;
    if renamed {
        for x in 0..oc {
            if !bytes_eq(el(ot, x), el(ntt, x)) {
                renamed = false;
            }
            if !bytes_eq(el(on, x), el(nn, x)) {
                any_rename = true;
                if el_index(nn, el(on, x)) >= 0 {
                    // (a name moved: a reorder)
                    renamed = false;
                }
            }
        }
    }
    if renamed && any_rename {
        for x in 0..oc {
            if n < max && !bytes_eq(el(on, x), el(nn, x)) {
                put_try_head(out, cmd, path, pcx);
                buf_str(out, if what == b'f' { c" --rename-param" } else { c" --rename" });
                put_word(out, el(on, x));
                put_word(out, el(nn, x));
                put_root(out, tcx);
                try_end(out);
                n += 1;
            }
        }
        return n;
    }
    if renames_only {
        return n;
    }
    // Added (in the new text only), removed (in the old only), retyped.
    for x in 0..nc {
        let o = el_index(on, el(nn, x));
        if n >= max {
            break;
        }
        if o < 0 {
            put_try_head(out, cmd, path, pcx);
            buf_str(out, c" --add");
            let part = buf_new();
            buf_bytes(part, el(nn, x));
            if what == b'e' {
                buf_bytes(part, el(ntt, x));
                put_word(out, buf_slice(part));
                buf_str(out, c" --arm 'EXPR'");
            } else {
                buf_str(part, c": ");
                buf_bytes(part, el(ntt, x));
                // (0.15: a default written is the value)
                if without_default(el(ntt, x)).len() == el(ntt, x).len() {
                    buf_str(part, c" = VALUE");
                }
                put_word(out, buf_slice(part));
                if what == b'f' && x < nc - 1 {
                    buf_str(out, c" --at ");
                    buf_int(out, x);
                }
            }
            put_root(out, tcx);
            try_end(out);
            n += 1;
        } else if what != b'e'
            && !bytes_eq(without_default(el(ot, o)), without_default(el(ntt, x)))
            && !bytes_eq(el(nn, x), b"self") {
            put_try_head(out, cmd, path, pcx);
            buf_str(out, c" --type");
            put_word(out, el(nn, x));
            put_word(out, without_default(el(ntt, x)));
            if what == b'f' {
                // (each call's argument: converted, or to fill in)
                buf_str(out, c" --default");
                let conv = buf_new();
                if numeric(el(ot, o)) && numeric(el(ntt, x)) {
                    buf_byte(conv, b'$');
                    buf_bytes(conv, el(nn, x));
                    buf_str(conv, c" as ");
                    buf_bytes(conv, el(ntt, x));
                } else {
                    buf_str(conv, c"EXPR");
                }
                put_word(out, buf_slice(conv));
            }
            put_root(out, tcx);
            try_end(out);
            n += 1;
        }
    }
    for x in 0..oc {
        if n >= max {
            break;
        }
        if el_index(nn, el(on, x)) < 0 {
            if what == b's' {
                // (a field still used is not removed: its uses)
                buf_str(out, c"try:");
                put_cword(out, pcx.prog);
                buf_str(out, c" query refs");
                let p = buf_new();
                buf_bytes(p, path);
                buf_byte(p, b'.');
                buf_bytes(p, el(on, x));
                put_word(out, buf_slice(p));
                put_root(out, tcx);
                try_end(out);
            } else {
                put_try_head(out, cmd, path, pcx);
                buf_str(out, c" --remove");
                put_word(out, el(on, x));
                put_root(out, tcx);
                try_end(out);
            }
            n += 1;
        }
    }
    // The same elements in another order (a function's).
    if n == 0 && what == b'f' && oc == nc && oc > 1 {
        let mut same = true;
        let mut moved = false;
        for x in 0..oc {
            let o = el_index(on, el(nn, x));
            if o < 0 {
                same = false;
            } else if o != x {
                moved = true;
            }
        }
        if same && moved {
            put_try_head(out, cmd, path, pcx);
            buf_str(out, c" --reorder ");
            let mut first = true;
            for x in 0..nc {
                if !bytes_eq(el(nn, x), b"self") {
                    if !first {
                        buf_byte(out, b',');
                    }
                    buf_bytes(out, el(nn, x));
                    first = false;
                }
            }
            put_root(out, tcx);
            try_end(out);
            n += 1;
        }
    }
    n
}

// Whether type t is a number's (an integer's or a float's).
fn numeric(t: &[u8]) -> bool {
    (t.len() >= 2 && t.len() <= 3 && (t[0] == b'i' || t[0] == b'u' || t[0] == b'f')
        && t[1] >= b'0' && t[1] <= b'9') || bytes_eq(t, b"usize") || bytes_eq(t, b"isize")
}

// `try: PROG CMD PATH` into out (more words follow, then put_root and
// try_end).
fn put_try_head(out: i64, cmd: *mut u8, path: &[u8], pcx: &Ctx<Comp>) {
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_byte(out, b' ');
    buf_str(out, cmd);
    put_word(out, path);
}
