// An item's lines and text, for the edits that replace, insert and delete
// items and for the refactorings that move them.

use crate::base::{buf_byte, buf_bytes, buf_new, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::query::defs::{K_FIELD, K_VARIANT};
use crate::tools::query::positions::{line_end, line_start, token_at};

// ---- Items as text ----
//
// An item's text (what replace, insert and delete work on) is whole lines
// when it has its lines to itself: from the line of its first token (its
// attributes, `pub`, its keyword) to the line of its last (its `}` or
// `;`; a field's or variant's `,`), with any comment after it on that
// line. Above it, the comment and attribute lines directly over it (what
// `query show` prints) belong to it for delete, and for replace when the
// new text starts with a comment or an attribute. An item that shares a
// line with other code (a field of a one-line struct) is its exact bytes.

// The start of the item of definition d: its node's start, or before it
// its `pub` and its attributes.
pub fn item_head(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.restored { (*tcx.c_head.data.add(d as usize)) }
        else { node_head(pcx.defs[d as usize].start, pcx) }
    }
}

// The start of an item whose node starts at `start`: there, or before it
// at its `pub` and its attributes.
pub fn node_head(start: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = token_at(start, pcx);
    loop {
        if i > 0 && pcx.toks[(i - 1) as usize].kind == Tok::Pub {
            i -= 1;
            continue;
        }
        if i > 1 && pcx.toks[(i - 1) as usize].kind == Tok::RBracket {
            // `#[...]`
            let mut j = i - 1;
            let mut depth: i64 = 0;
            while j > 0 {
                if pcx.toks[j as usize].kind == Tok::RBracket {
                    depth += 1;
                } else if pcx.toks[j as usize].kind == Tok::LBracket {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                j -= 1;
            }
            if j > 0 && pcx.toks[(j - 1) as usize].kind == Tok::Hash {
                i = j - 1;
                continue;
            }
        }
        break;
    }
    pcx.toks[i as usize].start
}

// The end of the item of definition d: its node's end, and the `;` or (a
// field, a variant) the `,` right after it.
pub fn item_tail(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.restored {
            return (*tcx.c_tail.data.add(d as usize));
        }
        let end = pcx.defs[d as usize].end;
        let i = token_at(end, pcx);
        if i < pcx.toks.len() as i64
            && (pcx.toks[i as usize].kind == Tok::Semi || pcx.toks[i as usize].kind == Tok::Comma)
            && pcx.toks[i as usize].start >= end
            && file_of_pos(pcx.toks[i as usize].start, pcx) == file_of_pos(end, pcx) {
            let mut between = true;
            for p in end..pcx.toks[i as usize].start {
                if get_src()[p as usize] != b' ' && get_src()[p as usize] != b'\t'
                    && get_src()[p as usize] != b'\n' && get_src()[p as usize] != b'\r' {
                    between = false;
                }
            }
            if between
                && (pcx.toks[i as usize].kind == Tok::Semi || pcx.defs[d as usize].kind == K_FIELD
                    || pcx.defs[d as usize].kind == K_VARIANT) {
                return pcx.toks[i as usize].end;
            }
        }
        end
    }
}

// Whether only blanks are in SRC[from..to).
fn blank(from: i64, to: i64) -> bool {
    for p in from..to {
        if get_src()[p as usize] != b' ' && get_src()[p as usize] != b'\t'
            && get_src()[p as usize] != b'\r' {
            return false;
        }
    }
    true
}

// Whether SRC[from..to) is blanks and maybe a `//` comment.
fn blank_or_comment(from: i64, to: i64) -> bool {
    let mut p = from;
    while p < to
        && (get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t'
            || get_src()[p as usize] == b'\r') {
        p += 1;
    }
    p == to || (p + 1 < to && get_src()[p as usize] == b'/' && get_src()[(p + 1) as usize] == b'/')
}

// Whether definition d has its lines to itself.
pub fn whole_lines(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let head = item_head(d, tcx, pcx);
    let tail = item_tail(d, tcx, pcx);
    blank(line_start(head, pcx), head) && blank_or_comment(tail, line_end(tail - 1, pcx))
}

// The indentation of the line of pos.
pub fn indent_of(pos: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let a = line_start(pos, pcx);
    let mut b = a;
    while get_src()[b as usize] == b' ' || get_src()[b as usize] == b'\t' {
        b += 1;
    }
    &get_src()[a as usize..b as usize]
}

// The text of TEXT (stdin) as an item: without a `query show` header line
// (`// PATH<TAB>FILE:A-B`), blank lines first and last, and trailing
// blanks; indented by `indent` when it is not indented at all.
pub fn item_text(input: &[u8], indent: &[u8]) -> i64 {
    let mut a: i64 = 0;
    // (a show header)
    if input.len() > 3 && input[0] == b'/' && input[1] == b'/' && input[2] == b' ' {
        let mut e: i64 = 0;
        let mut tab = false;
        while e < input.len() as i64 && input[e as usize] != b'\n' {
            if input[e as usize] == b'\t' {
                tab = true;
            }
            e += 1;
        }
        if tab {
            a = e + 1;
        }
    }
    // (blank lines first)
    let mut p = a;
    while p < input.len() as i64 {
        let mut e = p;
        while e < input.len() as i64
            && (input[e as usize] == b' ' || input[e as usize] == b'\t'
                || input[e as usize] == b'\r') {
            e += 1;
        }
        if e < input.len() as i64 && input[e as usize] == b'\n' {
            p = e + 1;
            a = p;
        } else {
            break;
        }
    }
    let mut b = input.len() as i64;
    while b > a
        && (input[(b - 1) as usize] == b'\n' || input[(b - 1) as usize] == b' '
            || input[(b - 1) as usize] == b'\t' || input[(b - 1) as usize] == b'\r') {
        b -= 1;
    }
    let text = &input[a as usize..b as usize];
    // The least indentation of its lines.
    let mut least: i64 = 1000000;
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut j = i;
        while j < text.len() as i64 && (text[j as usize] == b' ' || text[j as usize] == b'\t') {
            j += 1;
        }
        if j < text.len() as i64 && text[j as usize] != b'\n' && j - i < least {
            least = j - i;
        }
        while i < text.len() as i64 && text[i as usize] != b'\n' {
            i += 1;
        }
        i += 1;
    }
    let out = buf_new();
    let reindent = least == 0 && indent.len() > 0;
    i = 0;
    while i < text.len() as i64 {
        let mut e = i;
        while e < text.len() as i64 && text[e as usize] != b'\n' {
            e += 1;
        }
        if reindent && e > i {
            buf_bytes(out, indent);
        }
        buf_bytes(out, &text[i as usize..e as usize]);
        if e < text.len() as i64 {
            buf_byte(out, b'\n');
        }
        i = e + 1;
    }
    out
}

// What text (an item's) starts with: a comment ('/'), an attribute
// ('#'), or the item (0).
pub fn leading(text: &[u8]) -> u8 {
    let mut i: i64 = 0;
    while i < text.len() as i64 && (text[i as usize] == b' ' || text[i as usize] == b'\t') {
        i += 1;
    }
    if i + 1 < text.len() as i64 && text[i as usize] == b'/' && text[(i + 1) as usize] == b'/' {
        return b'/';
    }
    if i + 1 < text.len() as i64 && text[i as usize] == b'#' && text[(i + 1) as usize] == b'[' {
        return b'#';
    }
    0
}

// The start of definition d's item without its attributes: its `pub`, or
// its keyword.
pub fn keyword_head(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.restored {
            return (*tcx.c_keyword.data.add(d as usize));
        }
        let i = token_at(pcx.defs[d as usize].start, pcx);
        if i > 0 && pcx.toks[(i - 1) as usize].kind == Tok::Pub { pcx.toks[(i - 1) as usize].start }
        else { pcx.toks[i as usize].start }
    }
}

// The position after the newline of the line of pos (its file's end for
// the last line).
pub fn after_line(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let e = line_end(pos, pcx);
    let f = file_of_pos(pos, pcx);
    if e >= pcx.files[f as usize].end { pcx.files[f as usize].end } else { e + 1 }
}

// Whether the line starting at pos is blank (pos: a line's start).
pub fn blank_line(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let f = file_of_pos(pos, pcx);
    pos < pcx.files[f as usize].end && blank(pos, line_end(pos, pcx))
}
