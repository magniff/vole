// Applying an edit of the engine: the edited files' copies, the check of
// the edited program (an error it has and the program had not refuses the
// edit), then the copies renamed onto the files, the journal and the
// summary line; or with --dry-run the diff. A script's step writes its
// copies unchecked (STEP_REPORT).

use crate::base::{
    STDOUT, buf_append, buf_byte, buf_bytes, buf_copy, buf_int, buf_new, buf_str, buf_write_fd,
    get_src, streq, strlen,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::errors_short;
use crate::cli::line::{Line, c_word_at, c_words};
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::{Tcx, falses};
use crate::tools::edit::{
    edit_new_file, gone_path, move_files, new_texts, remove_empty_dirs, sorted_edits,
};
use crate::tools::edit::breaks::{on_changed_line, report_breaks};
use crate::tools::edit::diff::{diff_moved, diff_texts, shown_path};
use crate::tools::edit::undo::journal;
use crate::tools::proc::{
    buf_cstr, exec_words, make_dirs, read_file_if, remove_file, rename_file, run_capture,
    same_bytes, write_file_if,
};
use crate::tools::query::c_slice;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::{diag, diags, put_cword, put_word, try_end};
use crate::tools::query::refs::file_text;

// ---- Checking the edited program ----

// The path of an edited file's copy: `FILE.vole-edit~`, or (0.25.5)
// `FILE.vole-edit-TAG~`, TAG the first volec's pid of this process tree
// (base::diag::EDIT_TAG, which its children inherit), so that two edits
// in one tree at once do not read or remove each other's copies.
pub fn copy_path(path: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    let b = buf_new();
    buf_str(b, path);
    if pcx.edit_tag != 0 as *mut u8 {
        buf_str(b, c".vole-edit-");
        buf_str(b, pcx.edit_tag);
        buf_byte(b, b'~');
    } else {
        buf_str(b, c".vole-edit~");
    }
    buf_cstr(b)
}

// The key of a short diagnostic line: its file and message, without its
// line and column (which an edit moves); empty for a line that is not an
// error.
fn error_key(line: &[u8], out: i64) -> bool {
    let mut i: i64 = 0;
    while i + 8 <= line.len() as i64 {
        if line[i as usize] == b':' && line[(i + 1) as usize] == b' '
            && line[(i + 2) as usize] == b'e' && line[(i + 3) as usize] == b'r'
            && line[(i + 4) as usize] == b'r' && line[(i + 5) as usize] == b'o'
            && line[(i + 6) as usize] == b'r'
            && line[(i + 7) as usize] == b'[' {
            let mut f: i64 = 0;
            while f < i && line[f as usize] != b':' {
                f += 1;
            }
            buf_bytes(out, &line[0..f as usize]);
            buf_bytes(out, &line[(i + 1) as usize..]);
            return true;
        }
        i += 1;
    }
    if line.len() >= 6 && line[0] == b'e' && line[5] == b'[' {
        buf_bytes(out, line);
        return true;
    }
    false
}

// The error lines of text (one diagnostic per line): their keys and the
// lines, in pairs of buffers.
pub fn error_lines(text: &[u8], out: &mut Vec<i64, Comp>) {
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut e = i;
        while e < text.len() as i64 && text[e as usize] != b'\n' {
            e += 1;
        }
        let key = buf_new();
        if error_key(&text[i as usize..e as usize], key) {
            let line = buf_new();
            buf_bytes(line, &text[i as usize..e as usize]);
            out.push(key);
            out.push(line);
        }
        i = e + 1;
    }
}

// The errors of the edited program that the program had not (each old
// error matches one new error of the same key): their lines, into `added`.
// Whether the check could run.
pub fn check_edited(root: *mut u8, added: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let before = buf_new();
    errors_short(before, pcx);
    let mut old: Vec<i64, Comp> = Vec::new_in(Comp {});
    error_lines(&buf_copy(before), &mut old);
    let out = buf_new();
    let status = check_run(root, true, out, tcx, pcx);
    if status != 0 && status != 1 {
        return false;
    }
    tcx.edited_errors = out;
    let mut now: Vec<i64, Comp> = Vec::new_in(Comp {});
    error_lines(&buf_copy(out), &mut now);
    let mut used = falses(old.len() as i64 / 2 + 1);
    let mut i: i64 = 0;
    while i < now.len() as i64 {
        let mut found = false;
        let mut j: i64 = 0;
        while j < old.len() as i64 {
            if !(used[(j / 2) as usize])
                && same_bytes(&buf_copy((old[j as usize])),
                    &buf_copy((now[i as usize]))) {
                (used[(j / 2) as usize]) = true;
                found = true;
                break;
            }
            j += 2;
        }
        if !found {
            added.push((now[(i + 1) as usize]));
        }
        i += 2;
    }
    true
}

// `PROG check --diagnostics=short [--target T] [--overlay FILE COPY...]
// ROOT` (the overlays: the edited program), its output into out; the
// status.
fn check_run(root: *mut u8, edited: bool, out: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut args: Vec<i64, Comp> = Vec::new_in(Comp {});
    args.push(pcx.prog as i64);
    args.push(c"check" as i64);
    args.push(c"--diagnostics=short" as i64);
    if tcx.target_name != 0 as *mut u8 {
        args.push(c"--target" as i64);
        args.push(tcx.target_name as i64);
    }
    let mut arch: Vec<i64, Comp> = Vec::new_in(Comp {});
    crate::arch::features::push_arch_args(&mut arch, pcx);
    args.extend_from_slice(arch.as_slice());
    if pcx.std_tree != 0 as *mut u8 {
        args.push(c"--std-tree" as i64);
        args.push(pcx.std_tree as i64);
    }
    if edited {
        overlay_args(&mut args, tcx, pcx);
    }
    args.push(root as i64);
    args.push(0);
    run_capture(exec_words(args.as_slice()).as_slice(), out)
}

// The errors left in the edited program, one per line, then `note
// fix.left`; nothing when it checks clean.
fn errors_left(tcx: &mut Tcx<Comp>) {
    if tcx.edited_errors < 0 {
        return;
    }
    let mut lines: Vec<i64, Comp> = Vec::new_in(Comp {});
    error_lines(&buf_copy(tcx.edited_errors), &mut lines);
    let n = lines.len() as i64 / 2;
    if n == 0 {
        return;
    }
    let out = buf_new();
    for i in 0..n {
        buf_append(out, (lines[(2 * i + 1) as usize]));
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
    let d = diag(c"note", c"fix.left", tcx);
    buf_int(d, n);
    buf_str(d, if n == 1 { c" error left (above)\n" } else { c" errors left (above)\n" });
}

// The command being run (its line), for the `try:` lines.
pub fn set_command(line: Line<'_>, tcx: &mut Tcx<Comp>) {
    tcx.command = c_words(line);
}

// Word i of the command (a C string).
fn command_word(i: i64, tcx: &Tcx<Comp>) -> *mut u8 {
    c_word_at(tcx.command.as_slice(), i)
}

// (0.25.2.1) Whether the command is `a b` (`edit patch`).
pub fn command_is(a: &[u8], b: &[u8], tcx: &Tcx<Comp>) -> bool {
    tcx.command.len() as i64 > 2 && crate::base::c_eq(command_word(1, tcx), a)
        && crate::base::c_eq(command_word(2, tcx), b)
}

// The command as it was run, with one more option (for a `try:` line).
pub fn try_again(option: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    for i in 1..tcx.command.len() as i64 {
        if !std_tree_arg(i, tcx) {
            put_cword(out, command_word(i, tcx));
        }
    }
    if option != 0 as *mut u8 {
        buf_byte(out, b' ');
        buf_str(out, option);
    }
    try_end(out);
}

// (0.17) `try: PROG ARGS...`, the command as it was run, into out (the
// line not ended: the caller adds to it).
pub fn put_command(out: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    for i in 1..tcx.command.len() as i64 {
        if !std_tree_arg(i, tcx) {
            put_cword(out, command_word(i, tcx));
        }
    }
}

// (0.17) Whether word i is `--std-tree` or its value, which a std edit
// runs again with (stdedit.vl): not in the command a `try:` line shows.
fn std_tree_arg(i: i64, tcx: &Tcx<Comp>) -> bool {
    (i + 1 < tcx.command.len() as i64 && crate::base::c_eq(command_word(i, tcx), b"--std-tree"))
        || (i > 1 && crate::base::c_eq(command_word(i - 1, tcx), b"--std-tree"))
}

// (0.17) The command as it was run with its words `name` replaced by
// `new` (for a `try:` line naming one of several definitions): false,
// writing nothing, when no word of it is `name`.
pub fn try_replaced(name: &[u8], new: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut found = false;
    for i in 1..tcx.command.len() as i64 {
        if bytes_eq(&c_slice(command_word(i, tcx)), name) {
            found = true;
        }
    }
    if !found {
        return false;
    }
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    for i in 1..tcx.command.len() as i64 {
        if bytes_eq(&c_slice(command_word(i, tcx)), name) {
            put_word(out, new);
        } else {
            put_cword(out, command_word(i, tcx));
        }
    }
    try_end(out);
    true
}

// ---- Applying ----

// Applies the edit: checks it, writes it (or with --dry-run prints it),
// journals it, and prints `what` with the files and the lines changed.
// The exit status: 0 done, 1 refused (nothing written).
pub fn apply_edit(what: &[u8], root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let status = prepare_edit(tcx, pcx);
    if status >= 0 {
        return status;
    }
    finish_edit(what, root, tcx, pcx)
}

// Step 1: the new texts, and their copies. -1 when they are ready, else
// the exit status (0: nothing to change).
pub fn prepare_edit(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    sorted_edits(&mut order, pcx);
    new_texts(order.as_slice(), tcx, pcx);
    move_files(tcx, pcx);
    if tcx.ch_file.len() as i64 == 0 && tcx.new_path.len() as i64 == 0 {
        let d = diag(c"note", c"edit.unchanged", tcx);
        buf_str(d, c"nothing to change\n");
        return 0;
    }
    for i in 0..tcx.ch_file.len() as i64 {
        let f = (tcx.ch_file[i as usize]);
        if !not_generated(file_text(f, pcx),
            &get_src()[
                pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize], tcx,
            pcx) {
            return 1;
        }
    }
    let mut ok = true;
    for i in 0..tcx.ch_file.len() as i64 {
        let path = pcx.files[(tcx.ch_file[i as usize]) as usize].path;
        if !write_file_if(copy_path(path, pcx), &buf_copy((tcx.ch_text[i as usize]))) {
            ok = false;
            cannot_write(path, tcx);
        }
    }
    for i in 0..tcx.new_path.len() as i64 {
        let path = (tcx.new_path[i as usize]) as *mut u8;
        if file_exists(path, pcx) {
            let d = diag(c"error", c"edit.exists", tcx);
            buf_str(d, c"'");
            buf_str(d, path);
            buf_str(d, c"' exists already\n");
            ok = false;
        }
        else if !make_parent(path)
            || !write_file_if(copy_path(path, pcx),
                &buf_copy((tcx.new_text[i as usize]))) {
            ok = false;
            cannot_write(path, tcx);
        }
    }
    if !ok {
        remove_copies(tcx, pcx);
        return 1;
    }
    -1
}

// (0.25.5, feedbacks/mod254.md #2) Whether an edit may change file `path`
// of text `text`: not a generated one (its first line `// Generated by
// SCRIPT ...`, as fmt finds it), whose generator would write it again,
// unless --force. False after `edit.generated`, naming the script.
pub fn not_generated(path: &[u8], text: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if tcx.force || !crate::tools::fmt::generated(text) {
        return true;
    }
    let d = diag(c"error", c"edit.generated", tcx);
    buf_bytes(d, path);
    buf_str(d, c" is generated by ");
    buf_bytes(d, generator(text));
    buf_str(d, c" (its first line says so): change what the script makes it from and run it; nothing written\n");
    try_again(c"--force", tcx, pcx);
    false
}

// The script a generated text names, `// Generated by SCRIPT ...`: its
// word after `by`, without a `,`, `:` or `.` after it.
fn generator(text: &[u8]) -> &[u8] {
    let from = "// Generated by ".len() as i64;
    let mut e = from;
    while e < text.len() as i64 && text[e as usize] != b' ' && text[e as usize] != b'\n'
        && text[e as usize] != b'\t' {
        e += 1;
    }
    while e > from
        && (text[(e - 1) as usize] == b',' || text[(e - 1) as usize] == b':'
            || text[(e - 1) as usize] == b'.' || text[(e - 1) as usize] == b';') {
        e -= 1;
    }
    if from > text.len() as i64 { &text[0..0] } else { &text[from as usize..e as usize] }
}

// The `--overlay FILE COPY` arguments of the edited files (for a command
// that runs on the edited program), and of the files this program was
// read with in place of others (a step of a script: the edits of the
// steps before).
pub fn overlay_args(args: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut k: i64 = 0;
    while k < pcx.overlay.len() as i64 {
        let p = (pcx.overlay[k as usize]) as *mut u8;
        if !edited_path(p, tcx, pcx) {
            args.push(c"--overlay" as i64);
            args.push(p as i64);
            args.push((pcx.overlay[(k + 1) as usize]));
        }
        k += 2;
    }
    for i in 0..tcx.ch_file.len() as i64 {
        args.push(c"--overlay" as i64);
        args.push(pcx.files[(tcx.ch_file[i as usize]) as usize].path as i64);
        args.push(
            copy_path(pcx.files[(tcx.ch_file[i as usize]) as usize].path, pcx) as i64);
    }
    for i in 0..tcx.new_path.len() as i64 {
        args.push(c"--overlay" as i64);
        args.push((tcx.new_path[i as usize]));
        args.push(copy_path((tcx.new_path[i as usize]) as *mut u8, pcx) as i64);
    }
    for i in 0..tcx.del_file.len() as i64 {
        args.push(c"--overlay" as i64);
        args.push(pcx.files[(tcx.del_file[i as usize]) as usize].path as i64);
        args.push(
            gone_path(pcx.files[(tcx.del_file[i as usize]) as usize].path) as i64);
    }
}

// Whether the edit changes or makes file `path`.
fn edited_path(path: *mut u8, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for i in 0..tcx.ch_file.len() as i64 {
        if streq(pcx.files[(tcx.ch_file[i as usize]) as usize].path, path) {
            return true;
        }
    }
    for i in 0..tcx.new_path.len() as i64 {
        if streq((tcx.new_path[i as usize]) as *mut u8, path) {
            return true;
        }
    }
    false
}

// A file the steps of a script made (script.vl): its text is its copy's.
pub fn copy_made(path: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let text = buf_new();
    if !read_file_if(copy_path(path, pcx), text) {
        return false;
    }
    edit_new_file(path, text, tcx, pcx);
    true
}

// File `path`'s copy was rewritten (by a later round of fix): its new
// text is the copy's. False when path is no file of the program, nor
// one the edit makes.
pub fn copy_rewritten(path: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for f in 0..pcx.files.len() as i64 {
        if !same_bytes(&c_slice(pcx.files[f as usize].path), path) {
            continue;
        }
        let text = buf_new();
        if !read_file_if(copy_path(pcx.files[f as usize].path, pcx), text) {
            return false;
        }
        for i in 0..tcx.ch_file.len() as i64 {
            if (tcx.ch_file[i as usize]) == f {
                (tcx.ch_text[i as usize]) = text;
                return true;
            }
        }
        tcx.ch_file.push(f);
        tcx.ch_text.push(text);
        return true;
    }
    // (a file the edit makes: refactor split's parts, tidied)
    for i in 0..tcx.new_path.len() as i64 {
        if same_bytes(&c_slice((tcx.new_path[i as usize]) as *mut u8), path) {
            let text = buf_new();
            if !read_file_if(copy_path((tcx.new_path[i as usize]) as *mut u8, pcx),
                text) {
                return false;
            }
            (tcx.new_text[i as usize]) = text;
            return true;
        }
    }
    false
}

// The new texts of the edit as copies, without a check (a round of fix
// run on an edited program: `fix --round`): prints `file<TAB>PATH` per
// copy written.
pub fn write_round(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if !write_round_copies(tcx, pcx) {
        return 1;
    }
    print_round_files(tcx, pcx);
    0
}

// (0.25.2.1) write_round's copies, not yet printed (fix --suggested checks
// its fixes on them first, fix/verify.vl): false when one cannot be
// written.
pub fn write_round_copies(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    sorted_edits(&mut order, pcx);
    new_texts(order.as_slice(), tcx, pcx);
    for i in 0..tcx.ch_file.len() as i64 {
        let path = pcx.files[(tcx.ch_file[i as usize]) as usize].path;
        if !write_file_if(copy_path(path, pcx), &buf_copy((tcx.ch_text[i as usize]))) {
            cannot_write(path, tcx);
            return false;
        }
    }
    true
}

// write_round's `file<TAB>PATH` lines.
pub fn print_round_files(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = buf_new();
    for i in 0..tcx.ch_file.len() as i64 {
        buf_str(out, c"file\t");
        buf_str(out, pcx.files[(tcx.ch_file[i as usize]) as usize].path);
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
}

// (0.25.2.1, fix/verify.vl) The copies of the edited files undone, before
// the edit is made again without some of its replacements: a copy this
// program was read from (a round's: the rounds before's edit) gets its
// text back, any other is removed.
pub fn undo_copies(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..tcx.ch_file.len() as i64 {
        let f = (tcx.ch_file[i as usize]);
        let copy = copy_path(pcx.files[f as usize].path, pcx);
        let mut read_from = false;
        let mut k: i64 = 0;
        while k + 1 < pcx.overlay.len() as i64 {
            if streq((pcx.overlay[(k + 1) as usize]) as *mut u8, copy) {
                read_from = true;
            }
            k += 2;
        }
        if read_from {
            write_file_if(copy,
                &get_src()[
                    pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize]);
        } else {
            remove_file(copy);
        }
    }
}

// Steps 2 to 4, once the copies are written (prepare_edit): the check,
// then the files written (or the diff printed), the journal, the summary.
pub fn finish_edit(what: &[u8], root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    // (0.14: edit replace, insert and patch, a step of a script: the
    // imports the new text needs; unchecked, as the step is; a round
    // per error the checker reports at a time)
    if tcx.step_report != 0 as *mut u8 && tcx.add_imports {
        let mut rounds: i64 = 0;
        while rounds < MAX_IMPORT_ROUNDS && imports_round(root, tcx, pcx) {
            rounds += 1;
        }
        imports_note(rounds, tcx);
    }
    // The diff (printed with --dry-run; it counts the lines).
    let mut diff = edit_diff(tcx, pcx);
    if tcx.step_report != 0 as *mut u8 {
        return step_done(what, tcx, pcx);
    }
    let mut ok = true;
    // 2, 3. The check.
    let mut added: Vec<i64, Comp> = Vec::new_in(Comp {});
    let checked = tcx.skip_check || check_edited(root, &mut added, tcx, pcx);
    // (0.14: edit replace, insert and patch: new errors, maybe names
    // the new text uses from other modules; the imports `fix --only
    // imports` adds, then the check again; not with --no-check, which
    // asks for the errors)
    if checked && added.len() as i64 > 0 && tcx.add_imports && !tcx.skip_check
        && !tcx.no_check {
        let mut rounds: i64 = 0;
        let mut tried = false;
        while added.len() as i64 > 0 && rounds < MAX_IMPORT_ROUNDS {
            // (0.25.5: a round whose import does not resolve, `use
            // std::size` for an undefined `size`, is taken back: the
            // error it hid is the one to report)
            let mut kept: Vec<i64, Comp> = Vec::new_in(Comp {});
            keep_texts(&mut kept, tcx);
            let kept_errors = tcx.edited_errors;
            if !imports_round(root, tcx, pcx) {
                break;
            }
            tried = true;
            let mut now: Vec<i64, Comp> = Vec::new_in(Comp {});
            check_edited(root, &mut now, tcx, pcx);
            if unresolved_imports(now.as_slice()) > unresolved_imports(added.as_slice()) {
                restore_texts(kept.as_slice(), tcx, pcx);
                tcx.edited_errors = kept_errors;
                break;
            }
            added = now;
            rounds += 1;
        }
        if tried {
            diff = edit_diff(tcx, pcx);
        }
        imports_note(rounds, tcx);
    }
    // (0.18: fix --suggested) new errors only on lines the edit did
    // not write: the fixes let the checker reach them
    if tcx.left_ok && checked && added.len() as i64 > 0 && !tcx.no_check {
        let mut caused: i64 = 0;
        for i in 0..added.len() as i64 {
            if on_changed_line(&buf_copy((added[i as usize])), tcx, pcx)
                && !crate::tools::fix::verify::alloc_cascade(
                    &buf_copy((added[i as usize])), tcx) {
                caused += 1;
            }
        }
        if caused == 0 {
            added.clear();
        }
    }
    if !checked {
        let d = diag(c"warning", c"edit.unchecked", tcx);
        buf_str(d, c"the edited program could not be checked (");
        buf_str(d, pcx.prog);
        buf_str(d, c" check did not run)\n");
    }
    if tcx.dry_run || (added.len() as i64 > 0 && !tcx.no_check) {
        remove_copies(tcx, pcx);
    }
    if tcx.dry_run {
        buf_write_fd(diff, STDOUT);
    }
    if added.len() as i64 > 0 {
        // (0.15: tagged with their items, and the refactoring that fits)
        report_breaks(added.as_slice(), !tcx.no_check && !tcx.dry_run, tcx, pcx);
    }
    if tcx.dry_run {
        return if added.len() as i64 == 0 { 0 } else { 1 };
    }
    if added.len() as i64 > 0 && !tcx.no_check {
        return 1;
    }
    // 4. Journal, then rename.
    let summary = buf_new();
    put_summary(summary, what, tcx, pcx);
    journal(root, &buf_copy(summary), tcx, pcx);
    for i in 0..tcx.ch_file.len() as i64 {
        let path = pcx.files[(tcx.ch_file[i as usize]) as usize].path;
        if !rename_file(copy_path(path, pcx), path) {
            cannot_write(path, tcx);
            ok = false;
        }
    }
    for i in 0..tcx.new_path.len() as i64 {
        let path = (tcx.new_path[i as usize]) as *mut u8;
        if !rename_file(copy_path(path, pcx), path) {
            cannot_write(path, tcx);
            ok = false;
        }
    }
    for i in 0..tcx.del_file.len() as i64 {
        let path = pcx.files[(tcx.del_file[i as usize]) as usize].path;
        remove_file(path);
        remove_empty_dirs(path);
    }
    buf_byte(summary, b'\n');
    buf_write_fd(summary, STDOUT);
    if tcx.show {
        show_changes(&buf_copy(diff));
    }
    if tcx.show_diff {
        // (0.25.2.1: fix --diff, for the check hook to show each fix)
        buf_write_fd(diff, STDOUT);
    }
    if tcx.left_ok && checked {
        errors_left(tcx);
    }
    if ok { 0 } else { 1 }
}

// The rounds of imports_round an edit runs at most (the checker reports
// one unknown name of a function at a time).
const MAX_IMPORT_ROUNDS: i64 = 4;

// After `rounds` rounds of imports_round that added imports: the note,
// once per command (0.16: a script's steps, a rewrite's rounds, say it
// once).
fn imports_note(rounds: i64, tcx: &mut Tcx<Comp>) {
    if rounds > 0 && !tcx.imports_noted {
        tcx.imports_noted = true;
        let d = diag(c"note", c"edit.imports", tcx);
        buf_str(d, c"added the imports the new text needs (fix --only imports)\n");
    }
}

// The round of `fix --round --only imports --in FILE,...` on the edited
// program, over the files the edit changed: the copies of the files it
// fixed have their new texts. Whether it added an import.
fn imports_round(root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // (0.25.5, feedbacks/table254.md #1: one process for all the files,
        // `--in A,B,...`, not one per file: a refactoring of 40 files ran
        // 40 checks a round)
        let mut paths: Vec<i64, Comp> = Vec::new_in(Comp {});
        let n = tcx.ch_file.len() as i64;
        let files = buf_new();
        for i in 0..n + tcx.new_path.len() as i64 {
            // (0.17: the files the edit makes too, edit new-file's; as --in
            // takes them: without `./`)
            let mut path = if i < n { pcx.files[(tcx.ch_file[i as usize]) as usize].path }
                else { (tcx.new_path[(i - n) as usize]) as *mut u8 };
            while (*path.add(0)) == b'.' && (*path.add(1)) == b'/' {
                path = path.add(2);
            }
            paths.push(path as i64);
            if i > 0 {
                buf_byte(files, b',');
            }
            buf_str(files, path);
        }
        if paths.len() as i64 == 0 {
            return false;
        }
        let all = imports_child(root, buf_cstr(files), tcx, pcx);
        if all >= 0 || paths.len() as i64 == 1 {
            return all > 0;
        }
        // (the round failed for all of them at once, a file --in does not
        // take: file by file, as before 0.25.5)
        let mut any = false;
        for i in 0..paths.len() as i64 {
            if imports_child(root, (paths[i as usize]) as *mut u8, tcx, pcx) > 0 {
                any = true;
            }
        }
        any
    }
}

// One `fix --round --only imports --in IN` on the edited program: 1 when
// it rewrote a copy, 0 when it did not, -1 when it failed.
fn imports_child(root: *mut u8, files: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut args: Vec<i64, Comp> = Vec::new_in(Comp {});
    args.push(pcx.prog as i64);
    args.push(c"fix" as i64);
    args.push(c"--round" as i64);
    args.push(c"--only" as i64);
    args.push(c"imports" as i64);
    args.push(c"--in" as i64);
    args.push(files as i64);
    if tcx.target_name != 0 as *mut u8 {
        args.push(c"--target" as i64);
        args.push(tcx.target_name as i64);
    }
    overlay_args(&mut args, tcx, pcx);
    args.push(root as i64);
    args.push(0);
    let out = buf_new();
    if run_capture(exec_words(args.as_slice()).as_slice(), out) != 0 {
        return -1;
    }
    let mut any: i64 = 0;
    let t = buf_copy(out);
    let mut p: i64 = 0;
    while p < t.len() as i64 {
        let mut e = p;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        let line = &t[p as usize..e as usize];
        if line.len() > 5 && line[0] == b'f' && line[4] == b'\t'
            && copy_rewritten(&line[5..line.len()], tcx, pcx) {
            any = 1;
        }
        p = e + 1;
    }
    any
}

// (0.25.5) The edit's new texts before a round of imports: the number of
// files it changes, then each one's text (a buffer), then each new file's.
fn keep_texts(kept: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>) {
    kept.push(tcx.ch_file.len() as i64);
    for i in 0..tcx.ch_file.len() as i64 {
        kept.push(tcx.ch_text[i as usize]);
    }
    for i in 0..tcx.new_path.len() as i64 {
        kept.push(tcx.new_text[i as usize]);
    }
}

// The texts keep_texts kept, back, and their copies: a file the round
// added to the edit gets its copy removed (or, when the program was read
// from it, a step of a script's, the text it was read with).
fn restore_texts(kept: &[i64], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let n = kept[0 as usize];
    for i in n..tcx.ch_file.len() as i64 {
        let f = tcx.ch_file[i as usize];
        let (path, text) = (pcx.files[f as usize].path,
            &get_src()[pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize]);
        let copy = copy_path(path, pcx);
        let mut read_from = false;
        let mut k: i64 = 0;
        while k + 1 < pcx.overlay.len() as i64 {
            if streq(c_at(pcx.overlay.as_slice(), k + 1), copy) {
                read_from = true;
            }
            k += 2;
        }
        if read_from {
            write_file_if(copy, text);
        } else {
            remove_file(copy);
        }
    }
    tcx.ch_file.truncate(n as usize);
    tcx.ch_text.truncate(n as usize);
    for i in 0..n {
        if tcx.ch_text[i as usize] != kept[(1 + i) as usize] {
            tcx.ch_text[i as usize] = kept[(1 + i) as usize];
            write_file_if(copy_path(file_path(tcx.ch_file[i as usize], pcx), pcx),
                &buf_copy(tcx.ch_text[i as usize]));
        }
    }
    for i in 0..tcx.new_path.len() as i64 {
        if tcx.new_text[i as usize] != kept[(1 + n + i) as usize] {
            tcx.new_text[i as usize] = kept[(1 + n + i) as usize];
            write_file_if(copy_path(c_at(tcx.new_path.as_slice(), i), pcx),
                &buf_copy(tcx.new_text[i as usize]));
        }
    }
}

// Entry i of v, a C string kept as an integer (OVERLAY, NEW_PATH).
fn c_at(v: &[i64], i: i64) -> *mut u8 {
    v[i as usize] as *mut u8
}

// The path of file f (a C string).
fn file_path(f: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    pcx.files[f as usize].path
}

// How many of the error lines (check_edited's) are `unresolved import`.
fn unresolved_imports(errors: &[i64]) -> i64 {
    let mut n: i64 = 0;
    let word = "unresolved import";
    for i in 0..errors.len() as i64 {
        let l = buf_copy(errors[i as usize]);
        let mut j: i64 = 0;
        while j + word.len() as i64 <= l.len() as i64 {
            if &l[j as usize..(j + word.len() as i64) as usize] == word.as_bytes() {
                n += 1;
                break;
            }
            j += 1;
        }
    }
    n
}

// The diff of the edit (its new texts against the files), counting the
// lines added and removed (ADDED, REMOVED): a buffer.
fn edit_diff(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    // (counted again: an edit may be diffed after a round of imports)
    tcx.added = 0;
    tcx.edit_removed = 0;
    let diff = buf_new();
    for i in 0..tcx.ch_file.len() as i64 {
        let f = (tcx.ch_file[i as usize]);
        diff_texts(diff, file_text(f, pcx),
            &get_src()[
                pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize],
            &buf_copy((tcx.ch_text[i as usize])), tcx);
    }
    for i in 0..tcx.new_path.len() as i64 {
        let mut from: i64 = -1;
        for k in 0..tcx.del_file.len() as i64 {
            if (tcx.del_to[k as usize]) == i {
                from = (tcx.del_file[k as usize]);
            }
        }
        if from >= 0 {
            diff_moved(diff, file_text(from, pcx),
                shown_path((tcx.new_path[i as usize]) as *mut u8),
                &get_src()[
                    pcx.files[from as usize].start as usize..pcx.files[from as usize].end as usize],
                &buf_copy((tcx.new_text[i as usize])), tcx);
        } else {
            diff_texts(diff, shown_path((tcx.new_path[i as usize]) as *mut u8),
                &get_src()[0..0], &buf_copy((tcx.new_text[i as usize])), tcx);
        }
    }
    for k in 0..tcx.del_file.len() as i64 {
        let f = (tcx.del_file[k as usize]);
        if (tcx.del_to[k as usize]) < 0 {
            diff_texts(diff, file_text(f, pcx),
                &get_src()[
                    pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize],
                &get_src()[0..0], tcx);
        }
    }
    diff
}

// --show (0.12): after an edit, the regions it changed, as their new lines
// numbered (from the edit's diff): `// FILE:A-B` then `LINE<TAB>TEXT`;
// lines only removed: `// FILE:A: N lines removed after line A`.
fn show_changes(diff: &[u8]) {
    let out = buf_new();
    let mut file = &diff[0..0];
    let mut line: i64 = 0;
    let mut header = false;
    let mut i: i64 = 0;
    while i < diff.len() as i64 {
        let mut e = i;
        while e < diff.len() as i64 && diff[e as usize] != b'\n' {
            e += 1;
        }
        let l = &diff[i as usize..e as usize];
        if header && l.len() >= 6 && l[0] == b'+' && l[1] == b'+' && l[2] == b'+' {
            file = &l[6..l.len()];
            header = false;
        } else if l.len() >= 6 && l[0] == b'-' && l[1] == b'-' && l[2] == b'-' && l[3] == b' ' {
            header = true;
        } else if l.len() > 2 && l[0] == b'@' && l[1] == b'@' {
            // `@@ -A[,B] +C[,D] @@`
            let mut p: i64 = 4;
            let mut removed: i64 = 1;
            while p < l.len() as i64 && l[p as usize] >= b'0' && l[p as usize] <= b'9' {
                p += 1;
            }
            if p < l.len() as i64 && l[p as usize] == b',' {
                p += 1;
                removed = 0;
                while p < l.len() as i64 && l[p as usize] >= b'0' && l[p as usize] <= b'9' {
                    removed = removed * 10 + (l[p as usize] - b'0') as i64;
                    p += 1;
                }
            }
            p += 2;
            let mut c: i64 = 0;
            while p < l.len() as i64 && l[p as usize] >= b'0' && l[p as usize] <= b'9' {
                c = c * 10 + (l[p as usize] - b'0') as i64;
                p += 1;
            }
            let mut d: i64 = 1;
            if p < l.len() as i64 && l[p as usize] == b',' {
                p += 1;
                d = 0;
                while p < l.len() as i64 && l[p as usize] >= b'0' && l[p as usize] <= b'9' {
                    d = d * 10 + (l[p as usize] - b'0') as i64;
                    p += 1;
                }
            }
            line = c;
            buf_str(out, c"// ");
            buf_bytes(out, file);
            buf_byte(out, b':');
            buf_int(out, c);
            if d == 0 {
                buf_str(out, c": ");
                buf_int(out, removed);
                buf_str(out,
                    if removed == 1 { c" line removed after line " }
                    else { c" lines removed after line " });
                buf_int(out, c);
            } else if d > 1 {
                buf_byte(out, b'-');
                buf_int(out, c + d - 1);
            }
            buf_byte(out, b'\n');
        } else if l.len() > 0 && l[0] == b'+' {
            buf_int(out, line);
            buf_byte(out, b'\t');
            buf_bytes(out, &l[1..l.len()]);
            buf_byte(out, b'\n');
            line += 1;
        }
        i = e + 1;
    }
    buf_write_fd(out, STDOUT);
}

fn step_done(what: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let report = buf_new();
    for i in 0..tcx.ch_file.len() as i64 {
        buf_str(report, c"file\t");
        buf_str(report, pcx.files[(tcx.ch_file[i as usize]) as usize].path);
        buf_byte(report, b'\n');
    }
    for i in 0..tcx.new_path.len() as i64 {
        buf_str(report, c"new\t");
        buf_str(report, (tcx.new_path[i as usize]) as *mut u8);
        buf_byte(report, b'\n');
    }
    if tcx.imports_noted {
        buf_str(report, c"imports\n");
    }
    // (the files it moved away: `gone PATH`)
    for i in 0..tcx.del_file.len() as i64 {
        buf_str(report, c"gone\t");
        buf_str(report, pcx.files[(tcx.del_file[i as usize]) as usize].path);
        buf_byte(report, b'\n');
    }
    if !write_file_if(tcx.step_report, &buf_copy(report)) {
        cannot_write(tcx.step_report, tcx);
        remove_copies(tcx, pcx);
        return 1;
    }
    let summary = buf_new();
    put_summary(summary, what, tcx, pcx);
    buf_byte(summary, b'\n');
    buf_write_fd(summary, STDOUT);
    0
}

// `WHAT<TAB>FILE<TAB>+A -R lines` (or `N files`).
fn put_summary(out: i64, what: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    buf_bytes(out, what);
    buf_byte(out, b'\t');
    let mut files = tcx.ch_file.len() as i64 + tcx.new_path.len() as i64;
    for k in 0..tcx.del_file.len() as i64 {
        if (tcx.del_to[k as usize]) < 0 {
            files += 1;
        }
    }
    if files == 1 {
        if tcx.ch_file.len() as i64 == 1 {
            buf_bytes(out, file_text((tcx.ch_file[0]), pcx));
        } else {
            buf_bytes(out, shown_path((tcx.new_path[0]) as *mut u8));
        }
    } else {
        buf_int(out, files);
        buf_str(out, c" files");
    }
    buf_str(out, c"\t+");
    buf_int(out, tcx.added);
    buf_str(out, c" -");
    buf_int(out, tcx.edit_removed);
    buf_str(out, c" lines");
}

fn remove_copies(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..tcx.ch_file.len() as i64 {
        remove_file(copy_path(pcx.files[(tcx.ch_file[i as usize]) as usize].path,
            pcx));
    }
    for i in 0..tcx.new_path.len() as i64 {
        remove_file(copy_path((tcx.new_path[i as usize]) as *mut u8, pcx));
        remove_empty_dirs((tcx.new_path[i as usize]) as *mut u8);
    }
}

pub fn cannot_write(path: *mut u8, tcx: &mut Tcx<Comp>) {
    let d = diag(c"error", c"edit.write", tcx);
    buf_str(d, c"cannot write '");
    buf_str(d, path);
    buf_str(d, c"'\n");
}

// Makes the directory of path (for a new file).
pub fn make_parent(path: *mut u8) -> bool {
    // UNSAFE: strlen is C's; the path is a C string, read through its raw
    // pointer and seen as a slice.
    // SAFETY: path is a C string of the caller's, read below its strlen; the
    // slice covers its first i bytes (0 < i < n), copied into b at once.
    unsafe {
        let n = strlen(path) as i64;
        let mut i = n - 1;
        while i > 0 && (*path.add(i as usize)) != b'/' {
            i -= 1;
        }
        if i <= 0 {
            return true;
        }
        let b = buf_new();
        buf_bytes(b, std::slice::from_raw_parts(path.add((0) as usize), (i - (0)) as usize));
        make_dirs(buf_cstr(b))
    }
}
