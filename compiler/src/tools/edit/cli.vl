// ---- The commands ----

pub fn run_edit(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = run_edit_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    timer_report(pcx);
    status
}

fn usage(message: *const u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"edit.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = try_begin(c"replace NAME < new.vl", b"", false, tcx, pcx);
    try_end(out);
    2
}

// (0.25, on std::cli: cli/line.vl) The options the editing commands
// share, for their tables: --dry-run, --show, --time-passes, --no-check,
// --exact, -C, --root R, --target T, --std-tree DIR.
pub fn edit_opts(gpa: Gpa) -> Vec<Opt<'static>, Gpa> {
    let mut o: Vec<Opt<'_>, Gpa> = Vec::new_in(gpa);
    o.push(flag("dry-run", "the diff only, nothing written"));
    o.push(flag("show", "the diff after"));
    o.push(flag("no-check", "write despite new errors"));
    o.push(flag("exact", "the NAME as written, not its end"));
    o.push(flag("force", "edit a generated file too"));
    o.push(option("root", "ROOT", "the program's root file"));
    o.push(option("target", "T", "the target the program is checked for"));
    o.push(option("std-tree", "DIR", "std from its files in DIR"));
    o.push(short_option("C", "OPTION", "target-cpu=, target-feature=: which calls are legal"));
    o.push(flag("time-passes", "the time of each phase (stderr)"));
    // (0.25.3: `edit`'s global options, cli/tree.vl)
    for i in 0..o.len() {
        o[i].shared = true;
    }
    o
}

// Takes ev when it is one of edit_opts' (as take_edit_option): whether it
// was. Their missing values are unknown options, as before (and `-C`
// without a valid value is a word).
pub fn take_edit_event(ev: &mut Ev<'_>, root: &mut *const u8, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    if ev.kind == EV_MISSING {
        if ev.name == "C" {
            ev.kind = EV_WORD;
        } else if ev.name == "root" || ev.name == "target" || ev.name == "std-tree" {
            ev.kind = EV_UNKNOWN;
        }
        return false;
    }
    if ev.kind == EV_FLAG {
        if ev.name == "dry-run" {
            tcx.dry_run = true;
        } else if ev.name == "show" {
            tcx.show = true;
        } else if ev.name == "time-passes" {
            pcx.time_passes = true;
        } else if ev.name == "no-check" {
            tcx.no_check = true;
        } else if ev.name == "exact" {
            tcx.opt_exact = true;
        } else if ev.name == "force" {
            tcx.force = true;
        } else {
            return false;
        }
        return true;
    }
    if ev.kind != EV_OPTION {
        return false;
    }
    if ev.name == "C" {
        // (0.19: -C target-cpu=, -C target-feature=: which calls are
        // legal)
        if crate::arch::features::arch_option(ev.value, pcx) {
            return true;
        }
        ev.kind = EV_WORD;
        ev.text = "-C";
        ev.value = c"-C";
        return false;
    }
    if ev.name == "root" {
        *root = ev.value;
    } else if ev.name == "std-tree" {
        // (0.17: std from its files, stdtree.vl; stdedit.vl)
        pcx.std_tree = ev.value;
    } else if ev.name == "target" {
        tcx.target_name = ev.value;
        tcx.target = target_of_name(tcx.target_name);
    } else {
        return false;
    }
    true
}

// `edit replace|insert|delete ...` (`patch`, `insert --in`: patch.vl).
fn run_edit_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = c"edit";
    set_command(c.line, tcx);
    if c.line.len() < 3 {
        return usage(c"no command (patch, apply, replace, insert, delete)", tcx, pcx);
    }
    let cmd = c.line.c(2);
    let word = c.word(2);
    // (0.17: a std file named, `edit patch compiler/std/io.vl:102`:
    // the edit runs on std's files; stdedit.vl)
    if names_std_file(c.line, pcx) {
        return rerun_in_std_tree(c.line, tcx, pcx);
    }
    // (the leaf of `edit insert --in` is patch's: cli/tree.vl)
    if word == "patch" || (word == "insert" && c.line.has("--in")) {
        return run_patch(c, tcx, pcx, wgx);
    }
    if word == "resolve" {
        return run_resolve(c, tcx, pcx);
    }
    if word == "wrap" {
        return run_wrap(c, tcx, pcx, wgx);
    }
    if word == "new-file" {
        return run_new_file(c, tcx, pcx, wgx);
    }
    if word == "apply" {
        return run_apply(c, tcx, pcx, wgx);
    }
    let replace = word == "replace";
    let insert = word == "insert";
    let delete = word == "delete";
    if !replace && !insert && !delete {
        let d = diag(c"error", c"edit.usage", tcx);
        buf_str(d, c"unknown command '");
        buf_str(d, cmd);
        buf_str(d, c"' (patch, apply, replace, insert, delete, wrap, new-file, resolve)\n");
        return 2;
    }
    let mut after = false;
    let mut before = false;
    let mut root = 0 as *const u8;
    let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
    for e in c.evs.iter().copied() {
        let mut ev = e;
        if ev.kind == EV_FLAG && ev.name == "after" {
            after = true;
        } else if ev.kind == EV_FLAG && ev.name == "before" {
            before = true;
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
        } else if ev.kind == EV_WORD {
            names.push(ev.value as i64);
        } else {
            let d = diag(c"error", c"edit.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"'\n");
            return 2;
        }
    }
    if names.len() as i64 == 2 && root == 0 as *mut u8
        && crate::base::is_source_path((names[1]) as *mut u8) {
        root = (names[1]) as *mut u8;
        names.truncate(1 as usize);
    }
    if names.len() as i64 != 1 {
        return usage(if names.len() as i64 == 0 { c"a NAME is needed" }
            else { c"one NAME at a time" }, tcx, pcx);
    }
    if insert && after == before {
        return usage(c"insert needs --after or --before", tcx, pcx);
    }
    let name = c_slice((names[0]) as *mut u8);
    let what = if insert { if after { c"insert --after" } else { c"insert --before" } }
        else { cmd };
    tcx.root_given = root;
    // The new text, first: nothing is read when there is none.
    let input = buf_new();
    if !delete && (!read_stdin(input, tcx) || buf_len(input) == 0) {
        let d = diag(c"error", c"edit.no-text", tcx);
        buf_str(d, c"the new text is read from stdin; none was given\n");
        let out = try_begin(what, &name, true, tcx, pcx);
        buf_str(out, c" < new.vl");
        try_end(out);
        return 2;
    }
    root = root_or_diag(root, what, &name, true, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    if !cache_restore(root, tcx.target, false, tcx, pcx)
        && !load_program(root, tcx.target, tcx, pcx, wgx) {
        program_errors(c"error", root, true, tcx, pcx);
        return 1;
    }
    // A module's use lines or header comment (0.12).
    let mut rf: i64 = 0;
    let mut rk: i64 = 0;
    let mut spans: Vec<i64, Comp> = Vec::new_in(Comp {});
    let r = region_target(&name, what, &mut rf, &mut rk, &mut spans, tcx, pcx);
    if r == 1 {
        return 1;
    }
    let how = if replace { b'r' } else if insert { if after { b'a' } else { b'b' } }
        else { b'd' };
    if r == 0 {
        return edit_region(rf, rk, spans.as_slice(), how, input, root, tcx, pcx);
    }
    // (0.17) `edit replace FILE.vl < text`: the whole file.
    if replace && crate::base::is_source_path((names[0]) as *mut u8) {
        let f = file_named(&name, pcx);
        if f >= 0 && !file_made(f, pcx) {
            let text = buf_new();
            buf_append(text, input);
            if buf_len(text) > 0
                && buf_at(text, buf_len(text) - 1) != b'\n' {
                buf_byte(text, b'\n');
            }
            edit_replace(pcx.files[f as usize].start, pcx.files[f as usize].end, text, pcx);
            let summary = buf_new();
            buf_str(summary, c"replaced ");
            buf_bytes(summary, file_text(f, pcx));
            return apply_edit(&buf_copy(summary), root, tcx, pcx);
        }
    }
    let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
    if !resolve_name(what, &name, &mut matches, tcx, pcx) {
        return 1;
    }
    source_only(&mut matches, pcx);
    if matches.len() as i64 > 1 {
        ambiguous(what, &name, matches.as_slice(), tcx, pcx);
        return 1;
    }
    let d = (matches[0]);
    let f = file_of_pos(pcx.defs[d as usize].start, pcx);
    if file_made(f, pcx) {
        // (0.17: std, in the repository: in its files; stdedit.vl)
        if std_rerun(f, tcx, pcx) {
            return rerun_in_std_tree(c.line, tcx, pcx);
        }
        let e = diag(c"error", c"edit.not-source", tcx);
        buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(e, c" is in ");
        buf_str(e, pcx.files[f as usize].path);
        buf_str(e, c", not in a file of the program\n");
        return 1;
    }
    let summary = buf_new();
    // (0.14: the imports the new text needs, when it has new errors)
    tcx.add_imports = !delete;
    if !item_edit(how, d, input, summary, tcx, pcx) {
        return 1;
    }
    apply_edit(&buf_copy(summary), root, tcx, pcx)
}

// The edit of item d (0.15: for edit apply too): `how` 'r' replace it by
// the text of buffer input, 'a' or 'b' insert that text after or before
// it, 'd' delete it (see Items as text); its words in summary (`replaced
// crate::f`). False after the diagnostic.
pub fn item_edit(how: u8, d: i64, input: i64, summary: i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let whole = whole_lines(d, tcx, pcx);
    let head = item_head(d, tcx, pcx);
    let tail = item_tail(d, tcx, pcx);
    let member = pcx.defs[d as usize].kind == K_FIELD || pcx.defs[d as usize].kind == K_VARIANT;
    let mut added = true;
    if how == b'r' {
        let text = item_text(&buf_copy(input),
            if whole { indent_of(head, pcx) } else { &get_src()[0..0] });
        if whole {
            // (what the text has, it replaces: comments, attributes)
            let lead = leading(&buf_copy(text));
            let from = if lead == b'/' { line_start(text_start(d, pcx), pcx) }
                else if lead == b'#' { line_start(head, pcx) }
                else { line_start(keyword_head(d, tcx, pcx), pcx) };
            added = edit_replace(from, line_end(tail - 1, pcx), text, pcx);
        } else {
            added = edit_replace(head, tail, text, pcx);
        }
        buf_str(summary, c"replaced ");
    } else if how == b'a' || how == b'b' {
        if !whole {
            let e = diag(c"error", c"edit.layout", tcx);
            buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
            buf_str(e,
                c" shares its line with other code; insert needs an item on lines of its own\n");
            return false;
        }
        let text = item_text(&buf_copy(input), indent_of(head, pcx));
        // (0.17: a one-line const or static next to one joins its run)
        let t = buf_copy(text);
        let mut lines: i64 = 0;
        for i in 0..t.len() as i64 {
            if t[i as usize] == b'\n' && i + 1 < t.len() as i64 {
                lines += 1;
            }
        }
        let run = (pcx.defs[d as usize].kind == K_CONST || pcx.defs[d as usize].kind == K_STATIC)
            && lines == 0 && line_of(text_start(d, pcx), pcx) == line_of(tail - 1, pcx)
            && const_or_static(&t);
        let sep = if member || run { c"\n" } else { c"\n\n" };
        let out = buf_new();
        if how == b'a' {
            buf_str(out, sep);
            buf_append(out, text);
            added = edit_replace(line_end(tail - 1, pcx), line_end(tail - 1, pcx), out, pcx);
            buf_str(summary, c"inserted after ");
        } else {
            buf_append(out, text);
            buf_str(out, sep);
            let at = line_start(text_start(d, pcx), pcx);
            added = edit_replace(at, at, out, pcx);
            buf_str(summary, c"inserted before ");
        }
    } else {
        added = delete_item(d, whole, head, tail, tcx, pcx);
        buf_str(summary, c"deleted ");
    }
    buf_bytes(summary, sym_text(pcx.defs[d as usize].fqn, pcx));
    if !added {
        let e = diag(c"error", c"edit.overlap", tcx);
        buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(e, c" is changed twice in one edit; give each item one block\n");
        return false;
    }
    true
}

// (0.17) Whether text t (an item's) is a const or a static.
fn const_or_static(t: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < t.len() as i64 && (t[i as usize] == b' ' || t[i as usize] == b'\t') {
        i += 1;
    }
    let mut s = &t[i as usize..];
    if s.len() > 4 && bytes_eq(&s[0..4], b"pub ") {
        s = &s[4..s.len()];
    }
    (s.len() > 6 && bytes_eq(&s[0..6], b"const "))
        || (s.len() > 7 && bytes_eq(&s[0..7], b"static "))
}

// The edit deleting definition d (its text, see Items as text).
fn delete_item(d: i64, whole: bool, head: i64, tail: i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let f = file_of_pos(head, pcx);
    if !whole {
        // Its bytes, and the `, ` after it (or the `,` before it).
        let mut a = head;
        let mut b = tail;
        if get_src()[(tail - 1) as usize] != b',' {
            let mut n = tail;
            while n < pcx.files[f as usize].end
                && (get_src()[n as usize] == b' ' || get_src()[n as usize] == b'\t') {
                n += 1;
            }
            let mut p = head;
            while p > pcx.files[f as usize].start
                && (get_src()[(p - 1) as usize] == b' ' || get_src()[(p - 1) as usize] == b'\t') {
                p -= 1;
            }
            if n < pcx.files[f as usize].end && get_src()[n as usize] == b',' {
                b = n + 1;
            } else if p > pcx.files[f as usize].start && get_src()[(p - 1) as usize] == b',' {
                a = p - 1;
            }
        }
        if a == head {
            while b < pcx.files[f as usize].end
                && (get_src()[b as usize] == b' ' || get_src()[b as usize] == b'\t') {
                b += 1;
            }
        }
        return edit_replace(a, b, buf_new(), pcx);
    }
    if !delete_lines(line_start(text_start(d, pcx), pcx), tail, pcx) {
        return false;
    }
    // (0.17) A module's files go with its `mod` line: its own file
    // and its children's.
    if pcx.defs[d as usize].kind == K_MOD {
        let m = sym_text(pcx.defs[d as usize].fqn, pcx);
        for g in 0..pcx.files.len() {
            let t = mod_fqn_text(pcx.files[g].module, tcx, pcx);
            if !file_made(g as i64, pcx) && pcx.files[g].kind == SOURCE_VOLE
                && (pcx.files[g].start < pcx.defs[d as usize].start
                    || pcx.files[g].start >= pcx.defs[d as usize].end)
                && (bytes_eq(t, m)
                    || (t.len() as i64 > m.len() as i64 + 2 && bytes_eq(&t[0..m.len()], m)
                        && t[m.len()] == b':' && t[(m.len() as i64 + 1) as usize] == b':')) {
                edit_remove_file(&c_slice(pcx.files[g].path), tcx, pcx);
            }
        }
    }
    true
}

// An edit of a module's use lines or its header comment, file f's regions
// of kind `kind` (1 use, 2 header; byte ranges in spans), `how`: 'r'
// replace (the first region becomes TEXT, the others go; with none, TEXT
// goes at the top of the file, after its header for use lines), 'a' or
// 'b' insert (after the last use line, before the first), 'd' delete.
fn edit_region(f: i64, kind: i64, spans: &[i64], how: u8, input: i64, root: *const u8,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let summary = buf_new();
    let status = region_edit(f, kind, spans, how, input, summary, tcx, pcx);
    if status >= 0 {
        return status;
    }
    apply_edit(&buf_copy(summary), root, tcx, pcx)
}

// The edit of edit_region, its words in summary (`replaced crate::m::use`):
// -1 when it is made, else the exit status (after the diagnostic).
pub fn region_edit(f: i64, kind: i64, spans: &[i64], how: u8, input: i64, summary: i64,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let n = spans.len() as i64;
    let text = if how == b'd' { buf_new() }
        else { item_text(&buf_copy(input), &get_src()[0..0]) };
    if (how == b'a' || how == b'b') && kind == 2 {
        let e = diag(c"error", c"edit.layout", tcx);
        buf_str(e, c"a header comment is replaced, not inserted next to\n");
        let out = try_begin(c"replace", mod_fqn_text(pcx.files[f as usize].module, tcx, pcx),
            true, tcx, pcx);
        buf_str(out, c"::header < header.txt");
        try_end(out);
        return 1;
    }
    if how == b'd' && n == 0 {
        let e = diag(c"note", c"edit.unchanged", tcx);
        buf_str(e, c"nothing to delete\n");
        return 0;
    }
    if how == b'd' {
        let mut k: i64 = 0;
        while k < n {
            delete_lines((spans[k as usize]), (spans[(k + 1) as usize]),
                pcx);
            k += 2;
        }
        buf_str(summary, c"deleted ");
    } else if n == 0 {
        // (none yet: at the top, after the header for use lines)
        let mut at = pcx.files[f as usize].start;
        if kind != 2 {
            while at < pcx.files[f as usize].end && (blank_line(at, pcx) || comment_at(at)) {
                at = after_line(at, pcx);
            }
        }
        if kind == 3 {
            // (extern blocks: after the use lines)
            let mut uses: Vec<i64, Comp> = Vec::new_in(Comp {});
            region_spans(f, 1, &mut uses, pcx);
            if uses.len() as i64 > 0 {
                at = pcx.files[f as usize].start;
                for _ in 0..(uses[(uses.len() as i64 - 1) as usize]) + 1 {
                    at = after_line(at, pcx);
                }
                while at < pcx.files[f as usize].end && blank_line(at, pcx) {
                    at = after_line(at, pcx);
                }
            }
        }
        let out = buf_new();
        buf_append(out, text);
        buf_str(out, if at < pcx.files[f as usize].end { c"\n\n" } else { c"\n" });
        edit_replace(at, at, out, pcx);
        buf_str(summary, if how == b'r' { c"replaced " } else { c"inserted " });
    } else if how == b'r' {
        edit_replace((spans[0]), line_end((spans[1]) - 1, pcx), text, pcx);
        let mut k: i64 = 2;
        while k < n {
            delete_lines((spans[k as usize]), (spans[(k + 1) as usize]),
                pcx);
            k += 2;
        }
        buf_str(summary, c"replaced ");
    } else {
        let out = buf_new();
        if how == b'a' {
            let at = line_end((spans[(n - 1) as usize]) - 1, pcx);
            buf_byte(out, b'\n');
            buf_append(out, text);
            edit_replace(at, at, out, pcx);
            buf_str(summary, c"inserted after ");
        } else {
            buf_append(out, text);
            buf_byte(out, b'\n');
            edit_replace((spans[0]), (spans[0]), out, pcx);
            buf_str(summary, c"inserted before ");
        }
    }
    buf_bytes(summary, mod_fqn_text(pcx.files[f as usize].module, tcx, pcx));
    buf_str(summary, if kind == 1 { c"::use" } else if kind == 2 { c"::header" }
        else { c"::extern" });
    -1
}

// Whether the line at pos is a comment (blanks before `//`).
fn comment_at(pos: i64) -> bool {
    let mut p = pos;
    while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
        p += 1;
    }
    get_src()[p as usize] == b'/' && get_src()[(p + 1) as usize] == b'/'
}

// The edit deleting the lines from `first` (a line's start) through the
// line of tail - 1, and one blank line next to them, so that no two are
// left together (nor one after an opening brace, or before a closing
// one).
pub fn delete_lines(first: i64, tail: i64, pcx: &mut Ctx<Comp>) -> bool {
    let f = file_of_pos(first, pcx);
    let mut a = first;
    let mut b = after_line(tail - 1, pcx);
    let prev: i64 = if a > pcx.files[f as usize].start { line_start(a - 1, pcx) } else { -1 };
    let prev_blank = prev >= 0 && blank_line(prev, pcx);
    let opens = prev >= 0 && !prev_blank && ends_with_brace(prev, a - 1);
    if b < pcx.files[f as usize].end && blank_line(b, pcx) && (prev < 0 || prev_blank || opens) {
        b = after_line(b, pcx);
    } else if prev_blank && (b >= pcx.files[f as usize].end || starts_with_brace(b)) {
        a = prev;
    }
    edit_replace(a, b, buf_new(), pcx)
}

// Whether the line from..to ends with `{` (blanks aside).
fn ends_with_brace(from: i64, to: i64) -> bool {
    let mut e = to;
    while e > from
        && (get_src()[(e - 1) as usize] == b' ' || get_src()[(e - 1) as usize] == b'\t'
            || get_src()[(e - 1) as usize] == b'\r') {
        e -= 1;
    }
    e > from && get_src()[(e - 1) as usize] == b'{'
}

// Whether the line at pos starts with `}` (blanks aside).
fn starts_with_brace(pos: i64) -> bool {
    let mut p = pos;
    while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
        p += 1;
    }
    get_src()[p as usize] == b'}'
}

// Leaves out of matches the definitions that are not in a file of the
// program (std's, the C headers'), unless all are.
pub fn source_only(matches: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let mut kept: i64 = 0;
    for i in 0..matches.len() as i64 {
        let d = (matches[i as usize]);
        if !file_made(file_of_pos(pcx.defs[d as usize].start, pcx), pcx) {
            (matches[kept as usize]) = d;
            kept += 1;
        }
    }
    if kept > 0 {
        matches.truncate(kept as usize);
    }
}

// NAME matches several definitions: refused, with the first three paths
// (and the query listing them all, when there are more).
pub fn ambiguous(what: *const u8, name: &[u8], matches: &[i64], tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) {
    let n = matches.len() as i64;
    let d = diag(c"error", c"query.ambiguous", tcx);
    buf_int(d, n);
    buf_str(d, c" definitions match '");
    buf_bytes(d, name);
    buf_str(d, c"'; name one\n");
    for i in 0..n {
        if i == 3 || (i == 2 && n > 3) {
            break;
        }
        // (0.17: the command as run, the name replaced)
        let fqn = sym_text(pcx.defs[(matches[i as usize]) as usize].fqn, pcx);
        if !try_replaced(name, fqn, tcx, pcx) {
            try_end(try_begin(what, fqn, true, tcx, pcx));
        }
    }
    if n > 3 {
        let out = try_begin(c"def", name, true, tcx, pcx);
        try_end(out);
    }
}

// `edit replace|insert|delete`'s arguments (0.25.2: a leaf of volec's
// Command tree, cli/tree.vl).
pub fn edit_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = edit_opts(gpa);
    opts.push(flag("after", "insert after NAME"));
    opts.push(flag("before", "insert before NAME"));
    Leaf::new(opts, "name")
}

// `undo`'s arguments (another option is ignored).
pub fn undo_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(flag("force", "take it back even when the files changed since"));
    Leaf::new(opts, "root")
}

// `volec undo [--force] [ROOT]`.
pub fn run_undo_command(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    let mut force = false;
    let mut from = 0 as *const u8;
    for ev in c.evs.iter().copied() {
        if is_flag(ev, "force") {
            force = true;
        } else if ev.kind == EV_WORD && !ev.text.starts_with("-") {
            from = ev.value;
        }
    }
    let status = run_undo(force, from, tcx, pcx);
    write_diags(tcx);
    status
}

// `check`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn check_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = edit_opts(gpa);
    opts.push(pair("overlay", "PATH COPY", "PATH read from COPY"));
    opts.push(option("diagnostics", "FORM", "--diagnostics=short|human"));
    // (0.25.3) the warnings as errors (unsafe.unjustified, use.unused)
    opts.push(flag("deny-warnings", "make warnings errors"));
    // (0.25.2) `-I DIR` (or -IDIR): where `import "header.h"` looks first,
    // as for a build
    opts.push(short_option("I", "DIR", "where import \"header.h\" looks first"));
    // (0.29) every program touched since the base, and their layout
    opts.push(flag("changed",
        "the programs of the files changed since the branch's base, and fmt --check of them"));
    opts.push(option("since", "REV", "--changed, since REV"));
    Leaf::new(opts, "file")
}

// (0.29) What `check` read, after the root in its `ok:` line: ` (N files,
// M shaders)`, the program's own files (not std's, not C headers') and
// the shaders it embeds (a `wgsl` block, an `embed wgsl NAME from
// "x.wgsl"`), all validated by the check. A reader who edited a shader
// sees that the program checked is the one that embeds it.
fn checked_counts(what: i64, pcx: &Ctx<Comp>) {
    let mut files: i64 = 0;
    let mut shader_files: i64 = 0;
    for f in 0..pcx.files.len() as i64 {
        let p = c_slice(pcx.files[f as usize].path);
        if p.len() == 0 || p[0] == b'<' {
            continue;
        }
        if p.len() > 5 && &p[p.len() - 5..] == b".wgsl" {
            shader_files += 1;
        } else {
            files += 1;
        }
    }
    let blocks = pcx.block_node.len() as i64;
    let shaders = if blocks > shader_files { blocks } else { shader_files };
    buf_fmt(what,
        format_args(" ({files} file{}, {shaders} shader{})", if files == 1 { "" } else { "s" },
            if shaders == 1 { "" } else { "s" }));
}

// (0.17) std's files in the repository edited since this compiler was
// built: the program is read with them (STD_TREE), as the next build will
// read them, with a note; not for an edit's check (--overlay). (0.25.2:
// `fix` too, so that `fix --suggested` makes the fixes of the errors
// `check` shows in std's files.)
pub fn std_tree_if_edited(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.std_tree != 0 as *mut u8 || pcx.overlay.len() as i64 != 0 {
        return;
    }
    let tree = find_std_tree(pcx);
    if tree != 0 as *mut u8 && std_files_differ(tree, pcx) {
        pcx.std_tree = tree;
        let d = diag(c"note", c"check.std-files", tcx);
        buf_str(d, c"std's files differ from this compiler's std: checked with ");
        buf_str(d, tree);
        buf_str(d, c" (bootstrap/bootstrap.sh --dev builds them in)\n");
    }
}

// `volec check [ROOT] [--target T] [-I DIR] [--diagnostics=human]`: the front
// end (parse, resolve, check, unsafe check), every error, one per line;
// exit 1 when there is one. (`--overlay FILE COPY` reads COPY for FILE:
// how an edit is checked before it is written.)
pub fn run_check(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    pcx.prog = c.prog();
    // (0.25.3: on a terminal, base::term's form)
    pcx.diag_short = !pcx.rich;
    pcx.check_tests = true;
    let mut root = 0 as *const u8;
    let mut path = 0 as *const u8;
    let mut bad = 0 as *const u8;
    let mut changed = false;
    let mut since = 0 as *const u8;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        let token = c.word(ev.at);
        if is_opt(ev, "I") {
            tcx.c_include_dirs.push(ev.value as i64);
        } else if ev.kind == EV_OPTION && ev.name == "overlay" && path == 0 as *mut u8 {
            path = ev.value;
        } else if ev.kind == EV_OPTION && ev.name == "overlay" {
            // (its PATH, then its COPY: two values)
            pcx.overlay.push(path as i64);
            pcx.overlay.push(ev.value as i64);
            path = 0 as *mut u8;
        } else if ev.kind == EV_FLAG && ev.name == "changed" {
            changed = true;
        } else if is_opt(ev, "since") {
            changed = true;
            since = ev.value;
        } else if ev.kind == EV_FLAG && ev.name == "deny-warnings" {
            pcx.deny_warnings = true;
        } else if ev.kind == EV_OPTION && ev.name == "diagnostics" {
            if token == "--diagnostics=human" || token == "--diagnostics=short" {
                pcx.diag_short = token == "--diagnostics=short";
            } else {
                bad = if token.starts_with("-") { c.line.c(ev.at) } else { c.line.c(ev.at - 1) };
            }
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
        } else if ev.kind == EV_WORD && !ev.text.starts_with("-") {
            root = ev.value;
        } else {
            bad = ev.value;
        }
        if bad != 0 as *mut u8 {
            let d = diag(c"error", c"check.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, bad);
            buf_str(d, c"'\n");
            write_diags(tcx);
            return 2;
        }
    }
    if changed {
        // (0.29) every program touched, each by this compiler run again
        // (tools/changed.vl)
        if root != 0 as *mut u8 {
            let d = diag(c"error", c"check.usage", tcx);
            buf_str(d, c"--changed finds the programs itself: no ROOT '");
            buf_str(d, root);
            buf_str(d, c"'\n");
            write_diags(tcx);
            return 2;
        }
        return crate::tools::changed::run_check_changed(c.prog(), since, tcx, pcx);
    }
    // UNSAFE: the front end's fatal errors return through setjmp/longjmp (a
    // C call) to the block pcx.err_bail names.
    // SAFETY: the jmp_buf is a new block of 512 bytes, more than a jmp_buf
    // on the targets vole builds for, set before front_end runs and taken
    // away after; no local of this frame changes between the two returns.
    unsafe {
        // (0.17: std's files edited: checked with them, front/stdtree.vl)
        std_tree_if_edited(tcx, pcx);
        tcx.root_given = root;
        root = root_or_diag(root, c"check", b"", false, tcx, pcx);
        if root == 0 as *mut u8 {
            write_diags(tcx);
            return 2;
        }
        // (0.13: the errors from the tools' cache, when it holds for the
        // program; else the front end, with the queries' notes and index
        // for the cache)
        // (0.25.2: -I: the cache knows no include directories)
        let dirs = tcx.c_include_dirs.len() as i64 > 0;
        // (0.25.3: --deny-warnings: the warnings recorded as errors, not
        // cached)
        let mut lexed = false;
        if arch_options_given(pcx) || dirs || pcx.deny_warnings
            || !cache_restore(root, tcx.target, false, tcx, pcx) {
            lexed = true;
            let cached = cache_on(pcx) && !arch_options_given(pcx) && !dirs && !pcx.deny_warnings;
            pcx.query = cached;
            pcx.err_bail = alloc_zeroed(512);
            if _setjmp(pcx.err_bail) == 0 {
                front_end(root, tcx.target, tcx, pcx, wgx);
            }
            pcx.recover_depth = 0;
            pcx.err_bail = 0 as *mut u8;
            pcx.query = false;
            if cached && tcx.parsed {
                index_program(tcx, pcx);
                cache_save(root, tcx.target, tcx, pcx);
            }
        }
        // (0.25.3) the unsafe sites without their justification
        // (tools/query/unsafe_audit.vl): after the cache, which keeps
        // what every command shares
        // (not with errors: they come first)
        if tcx.parsed && error_count(pcx) == 0 {
            crate::tools::query::unsafe_audit::report_unjustified(lexed, tcx, pcx);
        }
        if error_count(pcx) > 0 {
            write_errors(pcx);
            check_summary(root, error_count(pcx), pcx.warnings_shown, pcx);
            timer_report(pcx);
            return 1;
        }
        let warned = warning_count(pcx);
        flush_warnings(pcx);
        timer_report(pcx);
        // (0.18.1) the success line: `ok: 0 errors in ROOT`; (0.29) and
        // what was read, ` (N files, M shaders)`
        let what = buf_new();
        buf_str(what, c"0 errors");
        if warned > 0 {
            buf_fmt(what, format_args(", {warned} warning{}", if warned == 1 { "" } else { "s" }));
        }
        buf_str(what, c" in ");
        buf_str(what, root);
        checked_counts(what, pcx);
        if pcx.rich {
            check_summary(root, 0, warned, pcx);
        } else {
            print_ok(&buf_copy(what), pcx);
        }
        0
    }
}
