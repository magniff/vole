// The journal of edits, `undo` (the last edit taken back) and `query diff`
// (the last edit's diff).

use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd, cstr, get_bufs,
    get_src,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::front::stdtree::find_std_tree;
use crate::tools::ctx::Tcx;
use crate::tools::edit::remove_empty_dirs;
use crate::tools::edit::apply::{cannot_write, copy_path, make_parent};
use crate::tools::edit::diff::diff_texts;
use crate::tools::edit::stdedit::{embed_std, is_std_file};
use crate::tools::proc::{
    absolute_path, buf_cstr, make_dirs, read_file_if, remove_dir, remove_file, rename_file,
    same_bytes, write_file_if,
};
use crate::tools::query::{c_slice, find_root};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};

// ---- The journal ----
//
// .git/vole-edits (the git directory of the root's checkout), or, for
// a program in no git checkout (0.14), .volec/edits next to its root
// (and found from below it): `head` holds the number N of the last edit; directory N/ holds its `summary`
// line, its `files` (one `ABSOLUTE-PATH<TAB>NEW` per changed file, NEW 1
// for a file the edit made) and each file's text before (`K.before`) and
// after (`K.after`) the edit. `volec undo` restores the last one.

// The journal's directory: in the git directory of the checkout around
// `from`; outside one (0.14), `.volec/edits` in the nearest directory
// up from `from` that has one, else in from's directory.
pub fn journal_dir(from: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    unsafe {
        let start = absolute_path(from);
        let dir = buf_new();
        buf_str(dir, start);
        // (from a file: its directory)
        if !is_dir(buf_cstr(dir), pcx) {
            while (*get_bufs().add(dir as usize)).len > 0
                && (
                    *(*get_bufs().add(dir as usize)).data.add(
                        ((*get_bufs().add(dir as usize)).len - 1) as usize)) != b'/' {
                (*get_bufs().add(dir as usize)).len -= 1;
            }
            if (*get_bufs().add(dir as usize)).len > 1 {
                (*get_bufs().add(dir as usize)).len -= 1;
            }
        }
        let own = buf_new();
        buf_bytes(own, buf_slice(dir));
        buf_str(own, c"/.volec/edits");
        let fallback = buf_cstr(own);
        loop {
            let git = buf_new();
            buf_bytes(git, buf_slice(dir));
            buf_str(git, c"/.git");
            let gp = buf_cstr(git);
            let head = buf_new();
            buf_str(head, gp);
            buf_str(head, c"/HEAD");
            if file_exists(buf_cstr(head), pcx) {
                buf_str(git, c"/vole-edits");
                return buf_cstr(git);
            }
            let text = buf_new();
            if file_exists(gp, pcx) && read_file_if(gp, text) {
                // A worktree: `gitdir: PATH`.
                let t = buf_slice(text);
                if t.len() > 8 && t[0] == b'g' && t[6] == b':' {
                    let mut a: i64 = 7;
                    while a < t.len() as i64 && t[a as usize] == b' ' {
                        a += 1;
                    }
                    let mut b = t.len() as i64;
                    while b > a
                        && (t[(b - 1) as usize] == b'\n' || t[(b - 1) as usize] == b' '
                            || t[(b - 1) as usize] == b'\r') {
                        b -= 1;
                    }
                    let out = buf_new();
                    if t[a as usize] != b'/' {
                        buf_bytes(out, buf_slice(dir));
                        buf_byte(out, b'/');
                    }
                    buf_bytes(out, &t[a as usize..b as usize]);
                    buf_str(out, c"/vole-edits");
                    return buf_cstr(out);
                }
            }
            let mine = buf_new();
            buf_bytes(mine, buf_slice(dir));
            buf_str(mine, c"/.volec/edits");
            if is_dir(buf_cstr(mine), pcx) {
                return buf_cstr(mine);
            }
            if (*get_bufs().add(dir as usize)).len <= 1 {
                return fallback;
            }
            while (*get_bufs().add(dir as usize)).len > 1
                && (
                    *(*get_bufs().add(dir as usize)).data.add(
                        ((*get_bufs().add(dir as usize)).len - 1) as usize)) != b'/' {
                (*get_bufs().add(dir as usize)).len -= 1;
            }
            if (*get_bufs().add(dir as usize)).len > 1 {
                (*get_bufs().add(dir as usize)).len -= 1;
            }
        }
    }
}

fn is_dir(path: *mut u8, pcx: &Ctx<Comp>) -> bool {
    let b = buf_new();
    buf_str(b, path);
    buf_str(b, c"/.");
    file_exists(buf_cstr(b), pcx)
}

// `DIR/NAME`.
fn path_in(dir: *mut u8, name: *mut u8) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    buf_byte(b, b'/');
    buf_str(b, name);
    buf_cstr(b)
}

// `DIR/N/K.SUFFIX` (K < 0: `DIR/N/SUFFIX`).
fn entry_path(dir: *mut u8, n: i64, k: i64, suffix: *mut u8) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    buf_byte(b, b'/');
    buf_int(b, n);
    buf_byte(b, b'/');
    if k >= 0 {
        buf_int(b, k);
        buf_byte(b, b'.');
    }
    buf_str(b, suffix);
    buf_cstr(b)
}

// The number in file `path` (0 when there is none).
fn read_number(path: *mut u8) -> i64 {
    let b = buf_new();
    if !read_file_if(path, b) {
        return 0;
    }
    let t = buf_slice(b);
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < t.len() as i64 && t[i as usize] >= b'0' && t[i as usize] <= b'9' {
        n = n * 10 + (t[i as usize] - b'0') as i64;
        i += 1;
    }
    n
}

fn write_number(path: *mut u8, n: i64) -> bool {
    let b = buf_new();
    buf_int(b, n);
    buf_byte(b, b'\n');
    write_file_if(path, buf_slice(b))
}

// Records the edit about to be written.
pub fn journal(root: *mut u8, summary: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let dir = journal_dir(root, pcx);
    if dir == 0 as *mut u8 {
        return;
    }
    let n = read_number(path_in(dir, c"head")) + 1;
    let entry = buf_new();
    buf_str(entry, dir);
    buf_byte(entry, b'/');
    buf_int(entry, n);
    let mut ok = make_dirs(buf_cstr(entry));
    let files = buf_new();
    let mut k: i64 = 0;
    for i in 0..tcx.ch_file.len() as i64 {
        let f = (tcx.ch_file[i as usize]);
        buf_str(files, absolute_path(pcx.files[f as usize].path));
        buf_str(files, c"\t0\n");
        ok = ok
            && write_file_if(entry_path(dir, n, k, c"before"),
                &get_src()[
                    pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize])
            && write_file_if(entry_path(dir, n, k, c"after"),
                buf_slice((tcx.ch_text[i as usize])));
        k += 1;
    }
    for i in 0..tcx.new_path.len() as i64 {
        buf_str(files, absolute_path((tcx.new_path[i as usize]) as *mut u8));
        buf_str(files, c"\t1\n");
        ok = ok
            && write_file_if(entry_path(dir, n, k, c"after"),
                buf_slice((tcx.new_text[i as usize])));
        k += 1;
    }
    // (a removed file: its text before; none after)
    for i in 0..tcx.del_file.len() as i64 {
        let f = (tcx.del_file[i as usize]);
        buf_str(files, absolute_path(pcx.files[f as usize].path));
        buf_str(files, c"\t2\n");
        ok = ok
            && write_file_if(entry_path(dir, n, k, c"before"),
                &get_src()[
                    pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize])
            && write_file_if(entry_path(dir, n, k, c"after"), &get_src()[0..0]);
        k += 1;
    }
    ok = ok && write_file_if(entry_path(dir, n, -1, c"files"), buf_slice(files))
        && write_file_if(entry_path(dir, n, -1, c"summary"), summary)
        && write_number(path_in(dir, c"head"), n);
    if !ok {
        let d = diag(c"warning", c"edit.journal", tcx);
        buf_str(d, c"cannot write the journal in ");
        buf_str(d, dir);
        buf_str(d, c"; undo will not know this edit\n");
    }
}

// (0.15) Records an edit of files read as text, not as a program (`edit
// resolve`: a tree with conflict markers does not parse): per file, its
// path (a C string) and its texts before and after (buffers).
pub fn journal_texts(from: *mut u8, paths: &[i64], befores: &[i64], afters: &[i64], summary: &[u8],
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let dir = journal_dir(from, pcx);
    if dir == 0 as *mut u8 {
        return;
    }
    let n = read_number(path_in(dir, c"head")) + 1;
    let entry = buf_new();
    buf_str(entry, dir);
    buf_byte(entry, b'/');
    buf_int(entry, n);
    let mut ok = make_dirs(buf_cstr(entry));
    let files = buf_new();
    for k in 0..paths.len() as i64 {
        buf_str(files, absolute_path((paths[k as usize]) as *mut u8));
        buf_str(files, c"\t0\n");
        ok = ok
            && write_file_if(entry_path(dir, n, k, c"before"),
                buf_slice((befores[k as usize])))
            && write_file_if(entry_path(dir, n, k, c"after"),
                buf_slice((afters[k as usize])));
    }
    ok = ok && write_file_if(entry_path(dir, n, -1, c"files"), buf_slice(files))
        && write_file_if(entry_path(dir, n, -1, c"summary"), summary)
        && write_number(path_in(dir, c"head"), n);
    if !ok {
        let d = diag(c"warning", c"edit.journal", tcx);
        buf_str(d, c"cannot write the journal in ");
        buf_str(d, dir);
        buf_str(d, c"; undo will not know this edit\n");
    }
}

// (0.21) The absolute form of path p (relative to the current directory),
// whether or not it exists.
fn absolute_of(p: *mut u8) -> *mut u8 {
    unsafe {
        if (*p.add(0)) == b'/' {
            return p;
        }
        let b = buf_new();
        buf_str(b, absolute_path(c"."));
        buf_byte(b, b'/');
        buf_str(b, p);
        buf_cstr(b)
    }
}

// (0.21, rewrite --text, refactor extension) Records an edit of files read
// as text that also moves files: the moves (`TO<TAB>3<TAB>FROM`, undone by
// moving each back, last first), then per changed file its path as it is
// after the moves and its texts before and after (buffers).
pub fn journal_moves(from: *mut u8, paths: &[i64], befores: &[i64], afters: &[i64], mfrom: &[i64],
    mto: &[i64], summary: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let dir = journal_dir(from, pcx);
    if dir == 0 as *mut u8 {
        return;
    }
    let n = read_number(path_in(dir, c"head")) + 1;
    let entry = buf_new();
    buf_str(entry, dir);
    buf_byte(entry, b'/');
    buf_int(entry, n);
    let mut ok = make_dirs(buf_cstr(entry));
    let files = buf_new();
    let mut k: i64 = 0;
    for i in 0..mfrom.len() as i64 {
        buf_str(files, absolute_of((mto[i as usize]) as *mut u8));
        buf_str(files, c"\t3\t");
        buf_str(files, absolute_of((mfrom[i as usize]) as *mut u8));
        buf_byte(files, b'\n');
        k += 1;
    }
    for i in 0..paths.len() as i64 {
        buf_str(files, absolute_of((paths[i as usize]) as *mut u8));
        buf_str(files, c"\t0\n");
        ok = ok
            && write_file_if(entry_path(dir, n, k, c"before"),
                buf_slice((befores[i as usize])))
            && write_file_if(entry_path(dir, n, k, c"after"),
                buf_slice((afters[i as usize])));
        k += 1;
    }
    ok = ok && write_file_if(entry_path(dir, n, -1, c"files"), buf_slice(files))
        && write_file_if(entry_path(dir, n, -1, c"summary"), summary)
        && write_number(path_in(dir, c"head"), n);
    if !ok {
        let d = diag(c"warning", c"edit.journal", tcx);
        buf_str(d, c"cannot write the journal in ");
        buf_str(d, dir);
        buf_str(d, c"; undo will not know this edit\n");
    }
}

// Where undo and query diff look for the journal: ROOT when given, else
// the program's default root (./main.vl...), else the current directory.
fn default_from(from: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    if from != 0 as *mut u8 {
        return from;
    }
    let root = find_root(0 as *mut u8, pcx);
    if root != 0 as *mut u8 { root } else { c"." }
}

// (0.21) The lines of a journal entry's `files`: `PATH<TAB>KIND`, or
// `PATH<TAB>3<TAB>FROM` for a file the edit moved to PATH; into paths,
// kinds and froms (C strings, empty when not moved).
fn read_entries(t: &[u8], paths: &mut Vec<i64, Comp>, kinds: &mut Vec<i64, Comp>,
    froms: &mut Vec<i64, Comp>) {
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        let mut tab = i;
        while tab < t.len() as i64 && t[tab as usize] != b'\t' {
            tab += 1;
        }
        let mut e = tab;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        let p = buf_new();
        buf_bytes(p, &t[i as usize..tab as usize]);
        paths.push(buf_cstr(p) as i64);
        let kind = if tab + 1 < e { t[(tab + 1) as usize] } else { b'0' };
        kinds.push(if kind == b'1' { 1 } else if kind == b'2' { 2 } else if kind == b'3' { 3 }
            else { 0 });
        let m = buf_new();
        if kind == b'3' && tab + 3 < e {
            buf_bytes(m, &t[(tab + 3) as usize..e as usize]);
        }
        froms.push(buf_cstr(m) as i64);
        i = e + 1;
    }
}

// (0.21) The copy of path keeps its executable bit (true: for a chain of
// conditions).
fn keep_mode_ok(path: *mut u8, pcx: &Ctx<Comp>) -> bool {
    crate::tools::proc::keep_mode(path, copy_path(path, pcx));
    true
}

// `volec undo [--force] [ROOT]`: restores the files of the last edit
// (refused when one changed since, unless --force); (0.21) moves the files
// it moved back, last first, after their texts.
pub fn run_undo(force: bool, from: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let dir = journal_dir(default_from(from, pcx), pcx);
        let n: i64 = if dir == 0 as *mut u8 { 0 } else { read_number(path_in(dir, c"head")) };
        let files = buf_new();
        if n <= 0 || !read_file_if(entry_path(dir, n, -1, c"files"), files) {
            let d = diag(c"error", c"undo.empty", tcx);
            buf_str(d, c"no edit to undo\n");
            return 1;
        }
        // The files: path, whether the edit made it (1), removed it (2) or
        // moved it here (3, from `moved`).
        let mut paths: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut made: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut moved: Vec<i64, Comp> = Vec::new_in(Comp {});
        read_entries(buf_slice(files), &mut paths, &mut made, &mut moved);
        // Each file must be as the edit left it.
        if !force {
            for k in 0..paths.len() as i64 {
                let now = buf_new();
                let after = buf_new();
                let have = read_file_if((paths[k as usize]) as *mut u8, now);
                // (a file the edit removed must still be gone; one it moved
                // must be there, and not where it was)
                let changed = if (made[k as usize]) == 2 {
                    have
                } else if (made[k as usize]) == 3 {
                    !have || file_exists((moved[k as usize]) as *mut u8, pcx)
                } else {
                    !have || !read_file_if(entry_path(dir, n, k, c"after"), after)
                        || !same_bytes(buf_slice(now), buf_slice(after))
                };
                if changed {
                    let d = diag(c"error", c"undo.changed", tcx);
                    buf_str(d, c"'");
                    buf_str(d, (paths[k as usize]) as *mut u8);
                    buf_str(d, c"' changed since the edit; nothing undone\n");
                    let out = try_begin(c"undo --force", c_slice(c""), false, tcx, pcx);
                    try_end(out);
                    return 1;
                }
            }
        }
        let mut ok = true;
        for k in 0..paths.len() as i64 {
            let path = (paths[k as usize]) as *mut u8;
            if (made[k as usize]) == 3 {
                continue;
            }
            if (made[k as usize]) == 1 {
                remove_file(path);
                remove_empty_dirs(path);
                continue;
            }
            let before = buf_new();
            if !read_file_if(entry_path(dir, n, k, c"before"), before) || !make_parent(path)
                || !write_file_if(copy_path(path, pcx), buf_slice(before))
                || !keep_mode_ok(path, pcx) || !rename_file(copy_path(path, pcx), path) {
                cannot_write(path, tcx);
                ok = false;
            }
        }
        // (the moves back, last first)
        let mut back_from: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut back_to: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut k = paths.len() as i64 - 1;
        while k >= 0 {
            if (made[k as usize]) == 3 {
                back_from.push((paths[k as usize]));
                back_to.push((moved[k as usize]));
            }
            k -= 1;
        }
        if back_from.len() as i64 > 0
            && !crate::tools::textual::move_files(back_from.as_slice(), back_to.as_slice(), tcx,
                pcx) {
            ok = false;
        }
        let summary = buf_new();
        read_file_if(entry_path(dir, n, -1, c"summary"), summary);
        for k in 0..paths.len() as i64 {
            remove_file(entry_path(dir, n, k, c"before"));
            remove_file(entry_path(dir, n, k, c"after"));
        }
        remove_file(entry_path(dir, n, -1, c"files"));
        remove_file(entry_path(dir, n, -1, c"summary"));
        let entry = buf_new();
        buf_str(entry, dir);
        buf_byte(entry, b'/');
        buf_int(entry, n);
        remove_dir(buf_cstr(entry));
        write_number(path_in(dir, c"head"), n - 1);
        let out = buf_new();
        buf_str(out, c"undid ");
        buf_bytes(out, buf_slice(summary));
        if (*get_bufs().add(out as usize)).len == 0
            || (
                *(*get_bufs().add(out as usize)).data.add(
                    ((*get_bufs().add(out as usize)).len - 1) as usize)) != b'\n' {
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        // (0.17: a std edit undone: std's built-in text follows; stdedit.vl)
        if (0i64..paths.len() as i64).any(|k| is_std_file(cstr((paths[k as usize]) as *mut u8))) {
            let tree = find_std_tree(pcx);
            if tree != 0 as *mut u8 {
                embed_std(tree, tcx);
            }
        }
        if ok { 0 } else { 1 }
    }
}

// `volec query diff [ROOT]` (0.12): the last edit of the journal (what
// `undo` would take back), its summary line, then its diff with no
// context lines; nothing changes.
pub fn run_query_diff(from: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let dir = journal_dir(default_from(from, pcx), pcx);
        let n: i64 = if dir == 0 as *mut u8 { 0 } else { read_number(path_in(dir, c"head")) };
        let files = buf_new();
        if n <= 0 || !read_file_if(entry_path(dir, n, -1, c"files"), files) {
            let d = diag(c"error", c"undo.empty", tcx);
            buf_str(d, c"no edit in the journal\n");
            return 1;
        }
        let out = buf_new();
        let summary = buf_new();
        read_file_if(entry_path(dir, n, -1, c"summary"), summary);
        buf_str(out, c"# ");
        buf_bytes(out, buf_slice(summary));
        if (
            *(*get_bufs().add(out as usize)).data.add(
                ((*get_bufs().add(out as usize)).len - 1) as usize)) != b'\n' {
            buf_byte(out, b'\n');
        }
        let t = buf_slice(files);
        let mut i: i64 = 0;
        let mut k: i64 = 0;
        while i < t.len() as i64 {
            let mut tab = i;
            while tab < t.len() as i64 && t[tab as usize] != b'\t' {
                tab += 1;
            }
            let p = buf_new();
            buf_bytes(p, &t[i as usize..tab as usize]);
            let before = buf_new();
            let after = buf_new();
            read_file_if(entry_path(dir, n, k, c"before"), before);
            read_file_if(entry_path(dir, n, k, c"after"), after);
            // (relative to the current directory when under it)
            let path = buf_slice(p);
            let here = c_slice(absolute_path(c"."));
            let mut shown = path;
            if path.len() as i64 > here.len() as i64 + 1 && path[here.len()] == b'/'
                && same_bytes(&path[0..here.len()], here) {
                shown = &path[(here.len() as i64 + 1) as usize..];
            }
            // (0.21: a file the edit moved, `TO<TAB>3<TAB>FROM`)
            if tab + 2 < t.len() as i64 && t[(tab + 1) as usize] == b'3'
                && t[(tab + 2) as usize] == b'\t' {
                let mut e = tab + 3;
                while e < t.len() as i64 && t[e as usize] != b'\n' {
                    e += 1;
                }
                buf_str(out, c"moved ");
                buf_bytes(out, &t[(tab + 3) as usize..e as usize]);
                buf_str(out, c" -> ");
                buf_bytes(out, path);
                buf_byte(out, b'\n');
            } else {
                diff_texts(out, shown, buf_slice(before), buf_slice(after), tcx);
            }
            while i < t.len() as i64 && t[i as usize] != b'\n' {
                i += 1;
            }
            i += 1;
            k += 1;
        }
        buf_write_fd(out, STDOUT);
        0
    }
}
