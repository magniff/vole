// Spans that are no single definition (0.30; docs/refactor.md, "Items as
// text"): an impl block, addressed by the FILE:LINE of its header (an
// impl has no name of its own, and that line once resolved to the type
// it is for), and a range of adjacent items, `NAME --to LAST`, replaced
// or deleted in one checked step.

use crate::base::{buf_append, buf_bytes, buf_copy, buf_new, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::{indent_of, item_head, item_tail, item_text, leading, whole_lines};
use crate::tools::query::{file_line, file_named};
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::{line_end, line_index, line_start};
use crate::tools::query::show::text_start;
use crate::tools::query::unsafe_audit::{comment_end, string_end};

fn starts_with(t: &[u8], w: &[u8]) -> bool {
    t.len() >= w.len() && &t[0..w.len()] == w
}

// Whether the line's text (its blanks skipped) opens an impl block.
fn impl_header(t: &[u8]) -> bool {
    let mut a: usize = 0;
    while a < t.len() && (t[a] == b' ' || t[a] == b'\t') {
        a += 1;
    }
    let mut r = &t[a..];
    if starts_with(r, b"unsafe ") {
        r = &r[7..];
    }
    starts_with(r, b"impl ") || starts_with(r, b"impl<")
}

// `name` as the FILE:LINE of an impl block's header: the block's span,
// [*from, *to) (from: the start of the comment and attribute lines right
// above the header; to: after its closing brace), and the header line's
// start in *head. False when it is not one.
pub fn impl_span(name: &[u8], from: &mut i64, head: &mut i64, to: &mut i64, pcx: &Ctx<Comp>) -> bool {
    let mut line: i64 = 0;
    let n = file_line(name, &mut line);
    let f: i64 = if n > 0 { file_named(&name[0..n as usize], pcx) } else { -1 };
    if f < 0 || line <= 0 {
        return false;
    }
    let start = pcx.files[f as usize].start;
    let end = pcx.files[f as usize].end;
    let idx = line_index(start, pcx) + line - 1;
    if idx >= pcx.lines.len() as i64 || pcx.lines[idx as usize] >= end {
        return false;
    }
    let src = get_src();
    let ls = pcx.lines[idx as usize];
    let mut le = ls;
    while le < end && src[le as usize] != b'\n' {
        le += 1;
    }
    if !impl_header(&src[ls as usize..le as usize]) {
        return false;
    }
    // its `{`, then the `}` that closes it: comments and strings skipped
    let mut p = ls;
    let mut depth: i64 = 0;
    let mut close: i64 = -1;
    while p < end {
        let c = src[p as usize];
        if c == b'/' && p + 1 < end
            && (src[(p + 1) as usize] == b'/' || src[(p + 1) as usize] == b'*') {
            p = start + comment_end(&src[start as usize..end as usize], p - start);
            continue;
        }
        if c == b'"' {
            p = start + string_end(&src[start as usize..end as usize], p - start + 1, false);
            continue;
        }
        if c == b'\'' {
            // a char literal ('x', '\n', '{'); a lifetime has no closing quote
            if p + 2 < end && src[(p + 1) as usize] == b'\\' {
                p += 2;
                while p < end && src[p as usize] != b'\'' && src[p as usize] != b'\n' {
                    p += 1;
                }
                p += 1;
                continue;
            }
            if p + 2 < end && src[(p + 2) as usize] == b'\'' {
                p += 3;
                continue;
            }
        }
        if c == b';' && depth == 0 {
            return false;
        }
        if c == b'{' {
            depth += 1;
        } else if c == b'}' {
            depth -= 1;
            if depth == 0 {
                close = p;
                break;
            }
        }
        p += 1;
    }
    if close < 0 {
        return false;
    }
    // the comment and attribute lines right above the header
    let mut top = ls;
    while top > start {
        let ps = line_start(top - 1, pcx);
        let mut a = ps;
        while a < top - 1 && (src[a as usize] == b' ' || src[a as usize] == b'\t') {
            a += 1;
        }
        let t = &src[a as usize..(top - 1) as usize];
        if !(starts_with(t, b"//") || starts_with(t, b"#[")) {
            break;
        }
        top = ps;
    }
    *from = top;
    *head = ls;
    *to = close + 1;
    true
}

// The edit of the span [from, to) whose first code line starts at head
// (an impl block; a range of items): `how` as cli's item_edit. False when
// it overlaps an edit made before.
pub fn span_edit(how: u8, from: i64, head: i64, to: i64, input: i64, pcx: &mut Ctx<Comp>) -> bool {
    if how == b'd' {
        return delete_lines(from, to, pcx);
    }
    let text = item_text(&buf_copy(input), indent_of(head, pcx));
    if how == b'r' {
        // (what the text has, it replaces: its own comment lines, or the
        // ones there stay)
        let lead = leading(&buf_copy(text));
        let at = if lead == b'/' || lead == b'#' { from } else { head };
        return edit_replace(at, line_end(to - 1, pcx), text, pcx);
    }
    let out = buf_new();
    if how == b'a' {
        buf_str(out, c"\n\n");
        buf_append(out, text);
        let at = line_end(to - 1, pcx);
        return edit_replace(at, at, out, pcx);
    }
    buf_append(out, text);
    buf_str(out, c"\n\n");
    edit_replace(from, from, out, pcx)
}

// The span of the adjacent items d1 through d2 (`NAME --to LAST`): d2
// after d1 in d1's file, both on lines of their own at one indentation.
// False after the diagnostic.
pub fn range_span(d1: i64, d2: i64, from: &mut i64, head: &mut i64, to: &mut i64,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let h1 = item_head(d1, tcx, pcx);
    let h2 = item_head(d2, tcx, pcx);
    let why: &[u8] = if file_of_pos(h1, pcx) != file_of_pos(h2, pcx) { &b" are in two files"[..] }
        else if h2 <= h1 { &b": the second is not after the first"[..] }
        else if !whole_lines(d1, tcx, pcx) || !whole_lines(d2, tcx, pcx) {
            &b" share a line with other code"[..]
        }
        else if indent_of(h1, pcx) != indent_of(h2, pcx) {
            &b" are not at one level (an item and one inside another)"[..]
        }
        else { &b""[..] };
    if why.len() > 0 {
        let e = diag(c"error", c"edit.layout", tcx);
        buf_bytes(e, sym_text(pcx.defs[d1 as usize].fqn, pcx));
        buf_str(e, c" and ");
        buf_bytes(e, sym_text(pcx.defs[d2 as usize].fqn, pcx));
        buf_bytes(e, why);
        buf_str(e, c"; --to names the last of a run of adjacent items\n");
        return false;
    }
    *from = line_start(text_start(d1, pcx), pcx);
    *head = line_start(h1, pcx);
    *to = item_tail(d2, tcx, pcx);
    true
}
