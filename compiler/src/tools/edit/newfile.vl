// `edit new-file` (0.13; docs/refactor.md): a file of the program made
// with its `mod` line,
//
//   volec edit new-file PATH [--pub] [ROOT] < TEXT
//
// PATH (`a/b.vl`, or `a/b/mod.vl`) is made with TEXT, and `mod b;`
// (`pub mod b;` with --pub) goes into the file of the module whose child
// it is, as the module loader finds children (next to the root or a
// `mod.vl`, else in the directory named after the parent's file): one
// edit of the engine, checked, so the new module is at once a TARGET of
// `edit patch` and the other commands.

use std::alloc::Arena;

use crate::base::{
    SOURCE_VOLE, buf_byte, buf_bytes, buf_len, buf_new, buf_slice, buf_str, buf_truncate, get_bufs,
    get_src, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_FLAG, EV_WORD, Leaf, flag};
use crate::front::cpp::directives::file_exists;
use crate::front::embed::wgsl::WgslCx;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_new_file;
use crate::tools::edit::apply::apply_edit;
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::proc::{absolute_path, read_stdin};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::mod_fqn_text;
use crate::tools::query::diagnostics::{diag, program_errors, try_begin, try_end};
use crate::tools::refactor_mod::{add_mod_line, base_name, child_path, is_mod_file, root_like};
use crate::tools::refactor_mod::cli::is_ident;

// `edit new-file`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn new_file_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    table.push(flag("pub", "its mod line `pub mod`"));
    Leaf::new(table, "path")
}

pub fn run_new_file(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let mut root = 0 as *mut u8;
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut public = false;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        if ev.kind == EV_FLAG && ev.name == "pub" {
            public = true;
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
        } else if ev.kind != EV_WORD {
            return usage(ev.value, c": an unknown option", tcx, pcx);
        } else {
            words.push(ev.value as i64);
        }
    }
    unsafe {
        if words.len() as i64 == 2 && root == 0 as *mut u8
            && crate::base::is_source_path((words[1]) as *mut u8) {
            root = (words[1]) as *mut u8;
            words.truncate(1 as usize);
        }
        if words.len() as i64 != 1 {
            return usage(c"new-file",
                if words.len() as i64 == 0 { c": a PATH is needed" }
                else { c": one PATH at a time" },
                tcx, pcx);
        }
        let path = (words[0]) as *mut u8;
        if !crate::base::is_source_path(path) {
            return usage(path, c": PATH is a .vl (or .vl) file", tcx, pcx);
        }
        // The module's name: the file's, or its directory's for a mod.vl.
        let dir = is_mod_file(path);
        let mut name = base_name(path);
        let ext_len = crate::base::source_ext_len(name);
        let ext = if ext_len == 3 { c".vl" } else { c".vl" };
        name = &name[0..(name.len() as i64 - ext_len) as usize];
        if dir {
            let p = c_slice(path);
            let e: i64 = if p.len() as i64 > 4 + ext_len { p.len() as i64 - 4 - ext_len }
                else { 0 };
            let mut s = e;
            while s > 0 && p[(s - 1) as usize] != b'/' {
                s -= 1;
            }
            name = &p[s as usize..e as usize];
        }
        if !is_ident(name) {
            return usage(path, c": the module's name is not a name", tcx, pcx);
        }
        let input = buf_new();
        if !read_stdin(input, tcx) || buf_len(input) == 0 {
            let d = diag(c"error", c"edit.no-text", tcx);
            buf_str(d, c"the file's text is read from stdin; none was given\n");
            let out = try_begin(c"new-file", c_slice(path), true, tcx, pcx);
            buf_str(out, c" < new.vl");
            try_end(out);
            return 2;
        }
        tcx.root_given = root;
        root = root_or_diag(root, c"new-file", c_slice(path), true, tcx, pcx);
        if root == 0 as *mut u8 {
            return 2;
        }
        if !load_program(root, tcx.target, tcx, pcx, wgx) {
            program_errors(c"error", root, true, tcx, pcx);
            return 1;
        }
        if file_exists(path, pcx) {
            let d = diag(c"error", c"edit.exists", tcx);
            buf_str(d, c"'");
            buf_str(d, path);
            buf_str(d, c"' exists already; nothing written\n");
            return 1;
        }
        // The parent: the file of the program whose child's file is PATH.
        let want = absolute_path(path);
        // (the file is made as the program spells it: the overlay of the
        // check is found by that name)
        let mut parent: i64 = -1;
        let mut spelled = path;
        for g in 0..pcx.files.len() as i64 {
            if (*pcx.files[g as usize].path.add(0)) == b'<'
                || pcx.files[g as usize].kind != SOURCE_VOLE {
                continue;
            }
            let c = child_path(pcx.files[g as usize].path,
                root_like(pcx.files[g as usize].module, pcx), name, dir, ext: ext);
            if streq(c, path) || streq(absolute_path(c), want) {
                parent = g;
                spelled = c;
                break;
            }
        }
        if parent < 0 {
            let d = diag(c"error", c"edit.no-parent", tcx);
            buf_str(d, c"no file of the program has ");
            buf_str(d, path);
            buf_str(d, c" as a child's file (a mod.vl or the root next to it, or the file its directory is named after)\n");
            try_end(try_begin(c"items", c_slice(c""), false, tcx, pcx));
            return 1;
        }
        let line = buf_new();
        buf_str(line, if public { c"pub mod " } else { c"mod " });
        buf_bytes(line, name);
        buf_byte(line, b';');
        // (0.17: a `mod NAME;` already there, the file missing, as the
        // compiler's `cannot find the file of module` says: only the file)
        if !declares_module(parent, name, pcx) {
            add_mod_line(parent, buf_slice(line), tcx, pcx);
        }
        let text = buf_new();
        buf_bytes(text, buf_slice(input));
        while buf_len(text) > 0
            && (
                (*(*get_bufs().add(text as usize)).data.add(
                    (buf_len(text) - 1) as usize)) == b'\n'
                    || (
                        *(*get_bufs().add(text as usize)).data.add(
                            (buf_len(text) - 1) as usize)) == b' ') {
            buf_truncate(text, buf_len(text) - 1);
        }
        buf_byte(text, b'\n');
        edit_new_file(spelled, text, tcx, pcx);
        let what = buf_new();
        buf_str(what, c"made ");
        buf_bytes(what, mod_fqn_text(pcx.files[parent as usize].module, tcx, pcx));
        buf_str(what, c"::");
        buf_bytes(what, name);
        // (0.17: the imports the new text needs, as edit insert adds them)
        tcx.add_imports = true;
        apply_edit(buf_slice(what), root, tcx, pcx)
    }
}

// (0.17) Whether file f has a line `mod NAME;` (or `pub mod NAME;`).
fn declares_module(f: i64, name: &[u8], pcx: &Ctx<Comp>) -> bool {
    let text = &get_src()[pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize];
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut s = i;
        while s < text.len() as i64 && (text[s as usize] == b' ' || text[s as usize] == b'\t') {
            s += 1;
        }
        let mut e = s;
        while e < text.len() as i64 && text[e as usize] != b'\n' {
            e += 1;
        }
        let mut l = &text[s as usize..e as usize];
        if l.len() > 4 && l[0..4] == b"pub " {
            l = &l[4..l.len()];
        }
        if l.len() as i64 == name.len() as i64 + 5 && l[0..4] == b"mod "
            && l[4..(4 + name.len() as i64) as usize] == name
            && l[(l.len() as i64 - 1) as usize] == b';' {
            return true;
        }
        i = e + 1;
    }
    false
}

fn usage(what: *mut u8, message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"edit.usage", tcx);
    buf_str(d, what);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = try_begin(c"new-file a/b.vl < b.vl", c_slice(c""), false, tcx, pcx);
    try_end(out);
    2
}
