// The pieces of a text for `volec fmt` (0.13): its tokens, as the
// compiler's lexer makes them, and its comments, in order. A piece is a
// byte range of the text, its kind (a Tok as i64, or LINE_COMMENT,
// BLOCK_COMMENT) and the number of line breaks before it (the first
// piece's counts as one). The text is lexed in place of SRC, with a
// recovery point: a text that does not lex is reported, never fatal.
// Then the brackets are matched (MATCH), and a formatted text is checked
// against its original: the same pieces, byte for byte.

use crate::base::{IntVec, SRC, _setjmp, buf_slice};
use crate::base::comp::Comp;
use crate::base::diag::{
    ERR, ERR_KIND, RECOVER_DEPTH, errors_forget, errors_mark, recover_enter, recover_leave,
};
use crate::front::lexer::{TOKS, Tok, lex_range};
use crate::tools::ctx::Tcx;

pub const LINE_COMMENT: i64 = -1;
pub const BLOCK_COMMENT: i64 = -2;

// The text being formatted, and its pieces.
pub static var FT: [u8] = "";

// Why the text could not be read: the message and its byte offset.
pub static var BAD_MESSAGE: [u8] = "";

fn clear(v: inout IntVec) {
    v.count = 0;
}

fn push_piece(start: i64, end: i64, kind: i64, nl: i64, tcx: inout Tcx<Comp>) {
    tcx.p_start.push(start);
    tcx.p_end.push(end);
    tcx.p_kind.push(kind);
    tcx.p_nl.push(nl);
}

// The comments in text[from..to) (blanks and comments only), as pieces;
// `nl` counts the line breaks before the first. Returns the line breaks
// after the last.
fn gap_pieces(from: i64, to: i64, nl: i64, tcx: inout Tcx<Comp>) -> i64 {
    let t = FT;
    var breaks = nl;
    var i = from;
    while i < to {
        let c = t[i];
        if c == '\n' {
            breaks += 1;
            i += 1;
        } else if c == '/' && i + 1 < to && t[i + 1] == '/' {
            let s = i;
            while i < to && t[i] != '\n' {
                i += 1;
            }
            // (as written, trailing blanks too: a test directive may end with one)
            push_piece(s, i, LINE_COMMENT, breaks, &tcx);
            breaks = 0;
        } else if c == '/' && i + 1 < to && t[i + 1] == '*' {
            let s = i;
            var depth = 0;
            while i < to {
                if t[i] == '/' && i + 1 < to && t[i + 1] == '*' {
                    depth += 1;
                    i += 2;
                } else if t[i] == '*' && i + 1 < to && t[i + 1] == '/' {
                    depth -= 1;
                    i += 2;
                    if depth == 0 {
                        break;
                    }
                } else {
                    i += 1;
                }
            }
            push_piece(s, i, BLOCK_COMMENT, breaks, &tcx);
            breaks = 0;
        } else {
            i += 1;
        }
    }
    breaks
}

// Reads `text` into pieces (FT, P_*); false when it does not lex
// (BAD_MESSAGE, BAD_AT say why).
pub fn read_pieces(text: [u8], tcx: inout Tcx<Comp>) -> bool {
    unsafe {
        // (0.25: a static holds only views of static data; the text
        // outlives every use of FT, the caller's)
        let p = text.ptr;
        FT = p[0..text.len];
        clear(&tcx.p_start);
        clear(&tcx.p_end);
        clear(&tcx.p_kind);
        clear(&tcx.p_nl);
        clear(&tcx.match_);
        let first = TOKS.len() as i64;
        let saved = SRC;
        let mark = errors_mark();
        let depth = RECOVER_DEPTH;
        var ok = true;
        let error_kind = ERR_KIND;
        ERR_KIND = c"tokenizer error";
        // (the lexer reads SRC, up to the length it is given; SRC views text
        // during the lexing only, set back to saved below on both paths, the
        // lexer's errors returning here through _setjmp: through p, as FT)
        SRC = p[0..text.len];
        if _setjmp(recover_enter()) == 0 {
            lex_range(0, text.len as i64, false);
        } else {
            ok = false;
        }
        recover_leave(depth);
        SRC = saved;
        ERR_KIND = error_kind;
        if !ok {
            BAD_MESSAGE = buf_slice(ERR);
            tcx.bad_at = if TOKS.len() as i64 > first { TOKS[TOKS.len() as i64 - 1].end }
                else { 0 };
            errors_forget(mark);
            TOKS.truncate(first as usize);
            return false;
        }
        var at = 0;
        var nl = 1;
        for k in first..TOKS.len() as i64 {
            nl = gap_pieces(at, TOKS[k].start, nl, &tcx);
            push_piece(TOKS[k].start, TOKS[k].end, TOKS[k].kind as i64, nl, &tcx);
            nl = 0;
            at = TOKS[k].end;
        }
        gap_pieces(at, text.len as i64, nl, &tcx);
        TOKS.truncate(first as usize);
        match_brackets(&tcx)
    }
}

// MATCH; false when the brackets do not balance (BAD_MESSAGE, BAD_AT).
fn match_brackets(tcx: inout Tcx<Comp>) -> bool {
    unsafe {
        var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        clear(&tcx.in_f);
        var in_f = 0;
        for i in 0..tcx.p_kind.count {
            tcx.match_.push(-1);
            let k = tcx.p_kind.data[i];
            // (0.15: an f-string's holes, up to its tail)
            tcx.in_f.push(in_f);
            if k == Tok::FHead as i64 && tcx.p_end.data[i] > tcx.p_start.data[i]
                && FT[tcx.p_end.data[i] - 1] == '{' {
                in_f = 1;
            } else if k == Tok::FTail as i64 {
                in_f = 0;
            }
            if is_open(k) {
                stack.push(i);
            } else if is_close(k) {
                if stack.count == 0 || tcx.p_kind.data[stack.data[stack.count - 1]] != k - 1 {
                    BAD_MESSAGE = "unbalanced brackets";
                    tcx.bad_at = tcx.p_start.data[i];
                    return false;
                }
                let o = stack.pop();
                tcx.match_.data[o] = i;
                tcx.match_.data[i] = o;
            }
        }
        if stack.count > 0 {
            BAD_MESSAGE = "unclosed bracket";
            tcx.bad_at = tcx.p_start.data[stack.data[stack.count - 1]];
            return false;
        }
        true
    }
}

pub fn is_open(k: i64) -> bool {
    k == Tok::LParen as i64 || k == Tok::LBrace as i64 || k == Tok::LBracket as i64
}

pub fn is_close(k: i64) -> bool {
    k == Tok::RParen as i64 || k == Tok::RBrace as i64 || k == Tok::RBracket as i64
}

pub fn is_comment(k: i64) -> bool {
    k < 0
}

// The text of piece i.
pub fn piece(i: i64, tcx: Tcx<Comp>) -> [u8] {
    unsafe { FT[tcx.p_start.data[i]..tcx.p_end.data[i]] }
}

pub fn kind(i: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe { tcx.p_kind.data[i] }
}

// Whether two texts have the same pieces (the formatter's check: only
// blanks changed, and 0.25.1, trailing commas: a `,` before a closing
// bracket). Reads both; the pieces left are `after`'s.
pub fn same_pieces(before: [u8], after: [u8], tcx: inout Tcx<Comp>) -> bool {
    unsafe {
        if !read_pieces(before, &tcx) {
            return false;
        }
        let n = tcx.p_kind.count;
        let starts = tcx.p_start;
        let ends = tcx.p_end;
        let kinds = tcx.p_kind;
        tcx.p_start = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        tcx.p_end = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        tcx.p_kind = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !read_pieces(after, &tcx) {
            return false;
        }
        let m = tcx.p_kind.count;
        var i = 0;
        var j = 0;
        while i < n || j < m {
            if i < n && trailing_comma(kinds, i) && !(j < m && trailing_comma(tcx.p_kind, j)) {
                i += 1;
                continue;
            }
            if j < m && trailing_comma(tcx.p_kind, j) && !(i < n && trailing_comma(kinds, i)) {
                j += 1;
                continue;
            }
            if i >= n || j >= m {
                return false;
            }
            let a = before[starts.data[i]..ends.data[i]];
            let b = piece(j, tcx);
            if kinds.data[i] != tcx.p_kind.data[j] || a.len != b.len {
                return false;
            }
            for x in 0..a.len {
                if a[x] != b[x] {
                    return false;
                }
            }
            i += 1;
            j += 1;
        }
        true
    }
}

// Whether piece i of kinds is a `,` before a closing bracket (comments
// between them aside).
fn trailing_comma(kinds: IntVec, i: i64) -> bool {
    unsafe {
        if kinds.data[i] != Tok::Comma as i64 {
            return false;
        }
        var j = i + 1;
        while j < kinds.count && is_comment(kinds.data[j]) {
            j += 1;
        }
        j < kinds.count && is_close(kinds.data[j])
    }
}

// The line (1-based) of byte offset `at` of text.
pub fn line_of(text: [u8], at: i64) -> i64 {
    var line = 1;
    var i = 0;
    while i < at && i < text.len as i64 {
        if text[i] == '\n' {
            line += 1;
        }
        i += 1;
    }
    line
}
