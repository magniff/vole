// The pieces of a text for `volec fmt` (0.13): its tokens, as the
// compiler's lexer makes them, and its comments, in order. A piece is a
// byte range of the text, its kind (a Tok as i64, or LINE_COMMENT,
// BLOCK_COMMENT) and the number of line breaks before it (the first
// piece's counts as one). The text is lexed in place of SRC, with a
// recovery point: a text that does not lex is reported, never fatal.
// Then the brackets are matched (MATCH), and a formatted text is checked
// against its original: the same pieces, byte for byte.

use crate::base::{IntVec, _setjmp, buf_bytes, buf_clear, buf_new, buf_slice, get_src, set_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{errors_forget, errors_mark, recover_enter, recover_leave};
use crate::front::lexer::{Tok, lex_range};
use crate::tools::ctx::Tcx;

pub const LINE_COMMENT: i64 = -1;
pub const BLOCK_COMMENT: i64 = -2;

// (0.27.0) Why the text could not be read, kept in tcx (a copy of m).
pub fn set_bad_message(m: &[u8], tcx: &mut Tcx<Comp>) {
    if tcx.bad_message < 0 {
        tcx.bad_message = buf_new();
    }
    buf_clear(tcx.bad_message);
    buf_bytes(tcx.bad_message, m);
}

// (0.27.0) Why the text could not be read ("" when nothing was said).
pub fn bad_message(tcx: &Tcx<Comp>) -> &[u8] {
    if tcx.bad_message < 0 { b"" } else { buf_slice(tcx.bad_message) }
}

fn clear(v: &mut IntVec) {
    v.clear();
}

fn push_piece(start: i64, end: i64, kind: i64, nl: i64, tcx: &mut Tcx<Comp>) {
    tcx.p_start.push(start);
    tcx.p_end.push(end);
    tcx.p_kind.push(kind);
    tcx.p_nl.push(nl);
}

// The comments in text, [from..to) (blanks and comments only), as pieces;
// `nl` counts the line breaks before the first. Returns the line breaks
// after the last.
fn gap_pieces(from: i64, to: i64, nl: i64, tcx: &mut Tcx<Comp>) -> i64 {
    let mut breaks = nl;
    let mut i = from;
    while i < to {
        let c = tcx.fmt_text[i as usize];
        if c == b'\n' {
            breaks += 1;
            i += 1;
        } else if c == b'/' && i + 1 < to && tcx.fmt_text[(i + 1) as usize] == b'/' {
            let s = i;
            while i < to && tcx.fmt_text[i as usize] != b'\n' {
                i += 1;
            }
            // (as written, trailing blanks too: a test directive may end with one)
            push_piece(s, i, LINE_COMMENT, breaks, tcx);
            breaks = 0;
        } else if c == b'/' && i + 1 < to && tcx.fmt_text[(i + 1) as usize] == b'*' {
            let s = i;
            let mut depth: i64 = 0;
            while i < to {
                if tcx.fmt_text[i as usize] == b'/' && i + 1 < to
                    && tcx.fmt_text[(i + 1) as usize] == b'*' {
                    depth += 1;
                    i += 2;
                }
                else if tcx.fmt_text[i as usize] == b'*' && i + 1 < to
                    && tcx.fmt_text[(i + 1) as usize] == b'/' {
                    depth -= 1;
                    i += 2;
                    if depth == 0 {
                        break;
                    }
                } else {
                    i += 1;
                }
            }
            push_piece(s, i, BLOCK_COMMENT, breaks, tcx);
            breaks = 0;
        } else {
            i += 1;
        }
    }
    breaks
}

// Reads `text` into pieces (a copy in tcx.fmt_text, P_*); false when it
// does not lex (bad_message, BAD_AT say why).
pub fn read_pieces(text: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        // (0.27.0: the pieces are offsets in a copy of the text, tcx's)
        tcx.fmt_text.clear();
        tcx.fmt_text.extend_from_slice(text);
        clear(&mut tcx.p_start);
        clear(&mut tcx.p_end);
        clear(&mut tcx.p_kind);
        clear(&mut tcx.p_nl);
        clear(&mut tcx.match_);
        let first = pcx.toks.len() as i64;
        let saved = get_src();
        let mark = errors_mark(pcx);
        let depth = pcx.recover_depth;
        let mut ok = true;
        let error_kind = pcx.err_kind;
        pcx.err_kind = c"tokenizer error";
        // (the lexer reads SRC, up to the length it is given; SRC views a
        // copy of text during the lexing only, set back to saved below on
        // both paths, the lexer's errors returning here through _setjmp;
        // 0.27.6: the copy is a region of its own, base::src_copy, which is
        // never unmapped nor written again, as every SRC)
        set_src(crate::base::src_copy(text));
        if _setjmp(recover_enter(pcx)) == 0 {
            lex_range(0, text.len() as i64, false, pcx);
        } else {
            ok = false;
        }
        recover_leave(depth, pcx);
        set_src(saved);
        pcx.err_kind = error_kind;
        if !ok {
            set_bad_message(buf_slice(pcx.err), tcx);
            tcx.bad_at = if pcx.toks.len() as i64
                > first { pcx.toks[(pcx.toks.len() as i64 - 1) as usize].end }
                else { 0 };
            errors_forget(mark, pcx);
            pcx.toks.truncate(first as usize);
            return false;
        }
        let mut at: i64 = 0;
        let mut nl: i64 = 1;
        for k in first..pcx.toks.len() as i64 {
            nl = gap_pieces(at, pcx.toks[k as usize].start, nl, tcx);
            push_piece(pcx.toks[k as usize].start, pcx.toks[k as usize].end,
                pcx.toks[k as usize].kind as i64, nl, tcx);
            nl = 0;
            at = pcx.toks[k as usize].end;
        }
        gap_pieces(at, text.len() as i64, nl, tcx);
        pcx.toks.truncate(first as usize);
        match_brackets(tcx)
    }
}

// MATCH; false when the brackets do not balance (bad_message, BAD_AT).
fn match_brackets(tcx: &mut Tcx<Comp>) -> bool {
    unsafe {
        let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        clear(&mut tcx.in_f);
        let mut in_f: i64 = 0;
        for i in 0..tcx.p_kind.len() as i64 {
            tcx.match_.push(-1);
            let k = (tcx.p_kind[i as usize]);
            // (0.15: an f-string's holes, up to its tail)
            tcx.in_f.push(in_f);
            if k == Tok::FHead as i64
                && (tcx.p_end[i as usize]) > (tcx.p_start[i as usize])
                && tcx.fmt_text[((tcx.p_end[i as usize]) - 1) as usize] == b'{' {
                in_f = 1;
            } else if k == Tok::FTail as i64 {
                in_f = 0;
            }
            if is_open(k) {
                stack.push(i);
            } else if is_close(k) {
                if stack.len() as i64 == 0
                    || (tcx.p_kind[(stack[(stack.len() as i64 - 1) as usize]) as usize])
                    != k - 1 {
                    set_bad_message(b"unbalanced brackets", tcx);
                    tcx.bad_at = (tcx.p_start[i as usize]);
                    return false;
                }
                let o = stack.pop();
                (tcx.match_[o as usize]) = i;
                (tcx.match_[i as usize]) = o;
            }
        }
        if stack.len() as i64 > 0 {
            set_bad_message(b"unclosed bracket", tcx);
            tcx.bad_at = (tcx.p_start[(stack[(stack.len() as i64 - 1) as usize]) as usize]);
            return false;
        }
        true
    }
}

pub fn is_open(k: i64) -> bool {
    k == Tok::LParen as i64 || k == Tok::LBrace as i64 || k == Tok::LBracket as i64
}

pub fn is_close(k: i64) -> bool {
    k == Tok::RParen as i64 || k == Tok::RBrace as i64 || k == Tok::RBracket as i64
}

pub fn is_comment(k: i64) -> bool {
    k < 0
}

// The text of piece i.
pub fn piece(i: i64, tcx: &Tcx<Comp>) -> &[u8] {
    unsafe { &tcx.fmt_text[
        (tcx.p_start[i as usize]) as usize..(tcx.p_end[i as usize]) as usize] }
}

pub fn kind(i: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe { (tcx.p_kind[i as usize]) }
}

// Whether two texts have the same pieces (the formatter's check: only
// blanks changed, and 0.25.1, trailing commas: a `,` before a closing
// bracket). Reads both; the pieces left are `after`'s.
pub fn same_pieces(before: &[u8], after: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if !read_pieces(before, tcx, pcx) {
            return false;
        }
        let n = tcx.p_kind.len() as i64;
        let starts = tcx.p_start;
        let ends = tcx.p_end;
        let kinds = tcx.p_kind;
        tcx.p_start = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        tcx.p_end = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        tcx.p_kind = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if !read_pieces(after, tcx, pcx) {
            return false;
        }
        let m = tcx.p_kind.len() as i64;
        let mut i: i64 = 0;
        let mut j: i64 = 0;
        while i < n || j < m {
            if i < n && trailing_comma(kinds, i) && !(j < m && trailing_comma(tcx.p_kind, j)) {
                i += 1;
                continue;
            }
            if j < m && trailing_comma(tcx.p_kind, j) && !(i < n && trailing_comma(kinds, i)) {
                j += 1;
                continue;
            }
            if i >= n || j >= m {
                return false;
            }
            let a = &before[
                (starts[i as usize]) as usize..(ends[i as usize]) as usize];
            let b = piece(j, tcx);
            if (kinds[i as usize]) != (tcx.p_kind[j as usize])
                || a.len() != b.len() {
                return false;
            }
            for x in 0..a.len() {
                if a[x] != b[x] {
                    return false;
                }
            }
            i += 1;
            j += 1;
        }
        true
    }
}

// Whether piece i of kinds is a `,` before a closing bracket (comments
// between them aside).
fn trailing_comma(kinds: IntVec, i: i64) -> bool {
    unsafe {
        if (kinds[i as usize]) != Tok::Comma as i64 {
            return false;
        }
        let mut j = i + 1;
        while j < kinds.len() as i64 && is_comment((kinds[j as usize])) {
            j += 1;
        }
        j < kinds.len() as i64 && is_close((kinds[j as usize]))
    }
}

// The line (1-based) of byte offset `at` of text.
pub fn line_of(text: &[u8], at: i64) -> i64 {
    let mut line: i64 = 1;
    let mut i: i64 = 0;
    while i < at && i < text.len() as i64 {
        if text[i as usize] == b'\n' {
            line += 1;
        }
        i += 1;
    }
    line
}
