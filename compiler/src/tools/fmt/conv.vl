// (0.20) fmt's respellings of conventions (docs/design/conventions.md D9,
// §2.1): a receiver in its short form, `self: inout Self` → `inout self`,
// `self: let Self` → `self`, `self: sink Self` → `sink self` (one meaning
// in every spelling); and with `--syntax=0.20`, where a parameter is let
// unless it says otherwise, a written `let` dropped from a parameter's or
// a function type's convention (`x: let T` → `x: T`, `fn(let T)` →
// `fn(T)`). Only these tokens change: the layout is laid on the result.

use crate::base::{IntVec, buf_bytes, buf_new};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::pieces::{is_comment, piece};

// The next piece after i that is no comment nor blank (P_KIND.count: none).
fn next_tok(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut j = i + 1;
    while j < tcx.p_kind.len() as i64
        && (is_comment((tcx.p_kind[j as usize]))
            || (tcx.p_kind[j as usize]) == 0) {
        j += 1;
    }
    j
}

fn prev_tok(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut j = i - 1;
    while j >= 0
        && (is_comment((tcx.p_kind[j as usize]))
            || (tcx.p_kind[j as usize]) == 0) {
        j -= 1;
    }
    j
}

fn is(i: i64, w: &[u8], tcx: &Tcx<Comp>) -> bool {
    i >= 0 && i < tcx.p_kind.len() as i64 && piece(i, tcx) == w
}

// Whether `(` piece i opens a parameter list: of `fn name(`, `fn
// name<..>(`, or a function type's `fn(` (0.22: `fn(let T)` is `fn(T)`).
fn params_open(i: i64, tcx: &Tcx<Comp>) -> bool {
    let p = prev_tok(i, tcx);
    if is(p, b"fn", tcx) {
        return true;
    }
    if is(p, b">", tcx) {
        // (`fn name<T: A>(`: back to the `<` the `>` closes)
        let mut depth: i64 = 0;
        let mut j = p;
        while j >= 0 {
            if is(j, b">", tcx) {
                depth += 1;
            } else if is(j, b"<", tcx) {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            j -= 1;
        }
        let name = prev_tok(j, tcx);
        return name >= 0 && is(prev_tok(name, tcx), b"fn", tcx);
    }
    p >= 0 && is(prev_tok(p, tcx), b"fn", tcx) && (tcx.p_kind[p as usize]) > 0
}

// The text respelled into a buffer, or -1 when nothing changes. The
// pieces of text are read (read_pieces).
pub fn respell_conventions(text: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = buf_new();
    let mut at: i64 = 0;
    let mut changed = false;
    // (the closing pieces of the parameter lists the walk is in)
    let mut closes = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let strict = pcx.strict;
    let mut i: i64 = 0;
    while i < tcx.p_kind.len() as i64 {
        if closes.len() as i64 > 0 && i == (closes[(closes.len() as i64 - 1) as usize]) {
            closes.pop();
        }
        if is(i, b"(", tcx) && params_open(i, tcx) && i < tcx.match_.len() as i64
            && (tcx.match_[i as usize]) > i {
            closes.push((tcx.match_[i as usize]));
        }
        // `self: inout Self` / `self: let Self` / `self: sink Self`
        if is(i, b"self", tcx) && is(next_tok(i, tcx), b":", tcx) {
            let c = next_tok(next_tok(i, tcx), tcx);
            let s = next_tok(c, tcx);
            let after = next_tok(s, tcx);
            if (is(c, b"inout", tcx) || is(c, b"let", tcx) || is(c, b"sink", tcx))
                && is(s, b"Self", tcx) && (is(after, b",", tcx) || is(after, b")", tcx))
                && !is(prev_tok(i, tcx), b"inout", tcx)
                && !is(prev_tok(i, tcx), b"sink", tcx) {
                buf_bytes(out,
                    &text[at as usize..(tcx.p_start[i as usize]) as usize]);
                buf_bytes(out, if is(c, b"inout", tcx) { b"inout self" }
                    else if is(c, b"sink", tcx) { b"sink self" } else { b"self" });
                at = (tcx.p_end[s as usize]);
                changed = true;
                i = s + 1;
                continue;
            }
        }
        // `x: let T` in a parameter list, `fn(let T)`: let is the default
        if strict && closes.len() as i64 > 0 && is(i, b"let", tcx) {
            let p = prev_tok(i, tcx);
            let depth_ok = enclosing_open(i, tcx) >= 0
                && (tcx.match_[enclosing_open(i, tcx) as usize])
                == (closes[(closes.len() as i64 - 1) as usize]);
            // (0.25.3: not `(let y: T`, a mode before a parameter's name,
            // conv.mode_order: the error's fix, not fmt's, moves it)
            let named = is(next_tok(next_tok(i, tcx), tcx), b":", tcx);
            if depth_ok
                && (is(p, b":", tcx) || (is(p, b"(", tcx) || is(p, b",", tcx)) && !named) {
                buf_bytes(out,
                    &text[at as usize..(tcx.p_start[i as usize]) as usize]);
                at = (tcx.p_start[next_tok(i, tcx) as usize]);
                changed = true;
                i += 1;
                continue;
            }
        }
        i += 1;
    }
    if !changed {
        return -1;
    }
    buf_bytes(out, &text[at as usize..]);
    out
}

// The bracket piece that piece i is directly in, or -1.
fn enclosing_open(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut j = i - 1;
    while j >= 0 {
        if j < tcx.match_.len() as i64 && (tcx.match_[j as usize]) > i
            && (is(j, b"(", tcx) || is(j, b"[", tcx) || is(j, b"{", tcx)
                || is(j, b"<", tcx)) {
            return j;
        }
        if j < tcx.match_.len() as i64 && (tcx.match_[j as usize]) >= 0
            && (tcx.match_[j as usize]) < j {
            // (a closing bracket: past its opening one)
            j = (tcx.match_[j as usize]);
        }
        j -= 1;
    }
    -1
}
