// (0.20) fmt's respellings of conventions (docs/design/conventions.md D9,
// §2.1): a receiver in its short form, `self: inout Self` → `inout self`,
// `self: let Self` → `self`, `self: sink Self` → `sink self` (one meaning
// in every spelling); and with `--syntax=0.20`, where a parameter is let
// unless it says otherwise, a written `let` dropped from a parameter's or
// a function type's convention (`x: let T` → `x: T`, `fn(let T)` →
// `fn(T)`). Only these tokens change: the layout is laid on the result.

use crate::base::{IntVec, buf_bytes, buf_new};
use crate::base::comp::Comp;
use crate::front::conv::STRICT;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::pieces::{is_comment, piece};

// The next piece after i that is no comment nor blank (P_KIND.count: none).
fn next_tok(i: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var j = i + 1;
        while j < tcx.p_kind.count && (is_comment(tcx.p_kind.data[j]) || tcx.p_kind.data[j] == 0) {
            j += 1;
        }
        j
    }
}

fn prev_tok(i: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var j = i - 1;
        while j >= 0 && (is_comment(tcx.p_kind.data[j]) || tcx.p_kind.data[j] == 0) {
            j -= 1;
        }
        j
    }
}

fn is(i: i64, w: [u8], tcx: Tcx<Comp>) -> bool {
    i >= 0 && i < tcx.p_kind.count && piece(i, tcx) == w
}

// Whether `(` piece i opens a parameter list: of `fn name(`, `fn
// name<..>(`, or a function type's `fn(` (0.22: `fn(let T)` is `fn(T)`).
fn params_open(i: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        let p = prev_tok(i, tcx);
        if is(p, "fn", tcx) {
            return true;
        }
        if is(p, ">", tcx) {
            // (`fn name<T: A>(`: back to the `<` the `>` closes)
            var depth = 0;
            var j = p;
            while j >= 0 {
                if is(j, ">", tcx) {
                    depth += 1;
                } else if is(j, "<", tcx) {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                j -= 1;
            }
            let name = prev_tok(j, tcx);
            return name >= 0 && is(prev_tok(name, tcx), "fn", tcx);
        }
        p >= 0 && is(prev_tok(p, tcx), "fn", tcx) && tcx.p_kind.data[p] > 0
    }
}

// The text respelled into a buffer, or -1 when nothing changes. The
// pieces of text are read (read_pieces).
pub fn respell_conventions(text: [u8], tcx: Tcx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        var at = 0;
        var changed = false;
        // (the closing pieces of the parameter lists the walk is in)
        var closes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let strict = STRICT;
        var i = 0;
        while i < tcx.p_kind.count {
            if closes.count > 0 && i == closes.data[closes.count - 1] {
                closes.count -= 1;
            }
            if is(i, "(", tcx) && params_open(i, tcx) && i < tcx.match_.count
                && tcx.match_.data[i] > i {
                closes.push(tcx.match_.data[i]);
            }
            // `self: inout Self` / `self: let Self` / `self: sink Self`
            if is(i, "self", tcx) && is(next_tok(i, tcx), ":", tcx) {
                let c = next_tok(next_tok(i, tcx), tcx);
                let s = next_tok(c, tcx);
                let after = next_tok(s, tcx);
                if (is(c, "inout", tcx) || is(c, "let", tcx) || is(c, "sink", tcx))
                    && is(s, "Self", tcx) && (is(after, ",", tcx) || is(after, ")", tcx))
                    && !is(prev_tok(i, tcx), "inout", tcx)
                    && !is(prev_tok(i, tcx), "sink", tcx) {
                    buf_bytes(out, text[at..tcx.p_start.data[i]]);
                    buf_bytes(out, if is(c, "inout", tcx) { "inout self" }
                        else if is(c, "sink", tcx) { "sink self" } else { "self" });
                    at = tcx.p_end.data[s];
                    changed = true;
                    i = s + 1;
                    continue;
                }
            }
            // `x: let T` in a parameter list, `fn(let T)`: let is the default
            if strict && closes.count > 0 && is(i, "let", tcx) {
                let p = prev_tok(i, tcx);
                let depth_ok = enclosing_open(i, tcx) >= 0
                    && tcx.match_.data[enclosing_open(i, tcx)] == closes.data[closes.count - 1];
                // (0.25.3: not `(let y: T`, a mode before a parameter's name,
                // conv.mode_order: the error's fix, not fmt's, moves it)
                let named = is(next_tok(next_tok(i, tcx), tcx), ":", tcx);
                if depth_ok && (is(p, ":", tcx) || (is(p, "(", tcx) || is(p, ",", tcx)) && !named) {
                    buf_bytes(out, text[at..tcx.p_start.data[i]]);
                    at = tcx.p_start.data[next_tok(i, tcx)];
                    changed = true;
                    i += 1;
                    continue;
                }
            }
            i += 1;
        }
        if !changed {
            return -1;
        }
        buf_bytes(out, text[at..]);
        out
    }
}

// The bracket piece that piece i is directly in, or -1.
fn enclosing_open(i: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var j = i - 1;
        while j >= 0 {
            if j < tcx.match_.count && tcx.match_.data[j] > i
                && (is(j, "(", tcx) || is(j, "[", tcx) || is(j, "{", tcx)
                    || is(j, "<", tcx)) {
                return j;
            }
            if j < tcx.match_.count && tcx.match_.data[j] >= 0 && tcx.match_.data[j] < j {
                // (a closing bracket: past its opening one)
                j = tcx.match_.data[j];
            }
            j -= 1;
        }
        -1
    }
}
