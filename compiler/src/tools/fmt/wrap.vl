// Wrapping a line of more than WIDTH columns (`volec fmt`, 0.13). The
// line is broken where it overflows, in the brackets around that point
// (the line itself, or a bracket opened on it and still open there),
// shallowest first, at the first of these (the last of them before the
// overflow, so that as much as fits stays on the first line):
//
//   1. after a `,` or `;` (the others follow, one level deeper);
//   2. before an `else`;
//   3. before a binary operator, loosest first (op_rank);
//   4. before each `.` of a chain of method calls (0.14: `xs.iter()`,
//      then `.map(|x| x * 2)` and `.sum()` on lines of their own);
//   5. after the shallowest `(` or `[` holding the overflow;
//   6. after the shallowest `{` (and before its `}`).
//
// In a `{ }` opened on the line, the contents go on lines of their own
// instead (a `match`: an arm a line). Before a break, the lines after the
// line that continue it the same way are joined to it (reflow), to be
// filled again. A part that is still too long is wrapped in the next
// pass. A line with a token too long for a line of its own (a long
// string) is left as it is, and so is a line with a piece of several
// lines.

use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::front::lexer::Tok;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::layout::{WIDTH, bar, generic, is_unary, line_end_piece, space};
use crate::tools::fmt::pieces::{LINE_COMMENT, is_close, is_comment, is_open, kind, piece};

// The binding of binary operator piece i, loosest first (docs/grammar.md,
// "Binding powers"): 0 `||`, 1 `&&`, 2 a comparison, 3 `|`, 4 `^`, 5
// `&`, 6 a shift, 7 `+` `-`, 8 `*` `/` `%`; -1 for any other piece (a
// prefix `-`, `*` or `&`, the `<` and `>` of type arguments, the bars of
// a closure).
fn op_rank(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let k = kind(i, tcx);
    // (a closure's bars are no operators)
    if bar(i, tcx) != 0 {
        return -1;
    }
    if k == Tok::PipePipe as i64 {
        return 0;
    }
    if k == Tok::AmpAmp as i64 {
        return if is_unary(i, tcx) { -1 } else { 1 };
    }
    if k == Tok::EqEq as i64 || k == Tok::BangEq as i64 || k == Tok::LtEq as i64
        || k == Tok::GtEq as i64
        || ((k == Tok::Lt as i64 || k == Tok::Gt as i64) && !generic(i, tcx)) {
        return 2;
    }
    if k == Tok::Pipe as i64 {
        return 3;
    }
    if k == Tok::Caret as i64 {
        return 4;
    }
    if k == Tok::Amp as i64 {
        return if is_unary(i, tcx) { -1 } else { 5 };
    }
    if k == Tok::Shl as i64 || (k == Tok::Shr as i64 && !generic(i, tcx)) {
        return 6;
    }
    if k == Tok::Plus as i64 || k == Tok::Minus as i64 {
        return if is_unary(i, tcx) { -1 } else { 7 };
    }
    if k == Tok::Star as i64 {
        return if is_unary(i, tcx) { -1 } else { 8 };
    }
    if k == Tok::Slash as i64 || k == Tok::Percent as i64 { 8 } else { -1 }
}

// The break class of a method chain (after the binary operators).
const CHAIN: i64 = 11;

// Whether piece k is the `.` of a method call (`.map(`, `.collect::<`).
fn method_dot(k: i64, tcx: &Tcx<Comp>) -> bool {
    k + 2 < tcx.p_kind.len() as i64 && kind(k, tcx) == Tok::Dot as i64
        && kind(k + 1, tcx) == Tok::Ident as i64
        && (kind(k + 2, tcx) == Tok::LParen as i64 || kind(k + 2, tcx) == Tok::ColonColon as i64)
}

// Whether piece k can be part of a method chain outside its brackets: a
// name, a path, a `.`, a `?`, a literal receiver, type arguments.
fn in_chain(k: i64, tcx: &Tcx<Comp>) -> bool {
    let kk = kind(k, tcx);
    kk == Tok::Ident as i64 || kk == Tok::Dot as i64 || kk == Tok::ColonColon as i64
        || kk == Tok::Question as i64
        || kk == Tok::Int as i64 || kk == Tok::Str as i64 || generic(k, tcx)
}

// The method `.`s of the chain holding method `.` k (0.14: `.iter().map(..)`),
// pieces i..last of a line, into out; the call brackets are skipped.
fn chain_dots(k: i64, i: i64, last: i64, out: &mut IntVec, tcx: &Tcx<Comp>) {
    let mut p = k - 1;
    while p >= i {
        let kp = kind(p, tcx);
        if (kp == Tok::RParen as i64 || kp == Tok::RBracket as i64)
            && (tcx.match_[p as usize]) >= i
            && (tcx.match_[p as usize]) < p {
            p = (tcx.match_[p as usize]) - 1;
        } else if in_chain(p, tcx) {
            if method_dot(p, tcx) {
                out.push(p);
            }
            p -= 1;
        } else {
            break;
        }
    }
    p = k;
    while p < last {
        let kp = kind(p, tcx);
        if (kp == Tok::LParen as i64 || kp == Tok::LBracket as i64)
            && (tcx.match_[p as usize]) > p
            && (tcx.match_[p as usize]) < last {
            p = (tcx.match_[p as usize]) + 1;
        } else if in_chain(p, tcx) {
            if method_dot(p, tcx) {
                out.push(p);
            }
            p += 1;
        } else {
            break;
        }
    }
}

fn has_newline(s: &[u8]) -> bool {
    for j in 0..s.len() {
        if s[j] == b'\n' {
            return true;
        }
    }
    false
}

// Breaks the line of pieces i..e when it is too long; whether it did.
pub fn wrap_line(i: i64, e: i64, tcx: &mut Tcx<Comp>) -> bool {
    let mut last = e;
    if last - 1 > i && kind(last - 1, tcx) == LINE_COMMENT {
        last -= 1;
    }
    tcx.col.clear();
    tcx.grp.clear();
    tcx.dep.clear();
    let mut col = 4 * (tcx.ind[i as usize]);
    let mut open = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    // (0.16: type arguments and parameters count as a level, so that a
    // long `fn f<F: Fn(i64) -> i64 + effects(panic)>(..)` breaks its
    // parameters first)
    let mut angles: i64 = 0;
    for k in i..last {
        let p = piece(k, tcx);
        if has_newline(p)
            || 4 * ((tcx.ind[i as usize]) + 1) + p.len() as i64 > WIDTH {
            return false;
        }
        if k > i {
            col += space(k - 1, k, tcx);
        }
        col += p.len() as i64;
        tcx.col.push(col);
        if is_close(kind(k, tcx)) && open.len() as i64 > 0
            && (open[(open.len() as i64 - 1) as usize])
            == (tcx.match_[k as usize]) {
            open.pop();
        }
        if generic(k, tcx)
            && (kind(k, tcx) == Tok::Gt as i64 || kind(k, tcx) == Tok::Shr as i64) {
            angles -= if kind(k, tcx) == Tok::Shr as i64 { 2 } else { 1 };
            if angles < 0 {
                angles = 0;
            }
        }
        tcx.grp.push(if open.len() as i64 > 0 { (open[(open.len() as i64 - 1) as usize]) }
            else { -1 });
        tcx.dep.push(open.len() as i64 + angles);
        if generic(k, tcx) && kind(k, tcx) == Tok::Lt as i64 {
            angles += 1;
        }
        if is_open(kind(k, tcx)) {
            open.push(k);
        }
    }
    if col <= WIDTH {
        return false;
    }
    let mut o = i;
    while (tcx.col[(o - i) as usize]) <= WIDTH {
        o += 1;
    }
    // (closing brackets and a `;` or `,` after them overflow with what they close)
    while o > i + 1
        && (is_close(kind(o, tcx)) || kind(o, tcx) == Tok::Semi as i64
            || kind(o, tcx) == Tok::Comma as i64) {
        o -= 1;
    }
    // The best break: the shallowest of a bracket holding the overflow
    // (opened before it, closed after), by class (a `,` or `;`, an
    // `else`, a binary operator, loosest first), the last of them
    // (any before the overflow leaves a first line that fits).
    let mut best: i64 = -1;
    let mut best_dep: i64 = 1000;
    let mut best_class: i64 = 99;
    let mut open_at: i64 = -1;
    let mut open_dep: i64 = 1000;
    let mut brace_at: i64 = -1;
    let mut brace_dep: i64 = 1000;
    for k in i + 1..last {
        // (0.15: no break inside an f-string)
        if is_open(kind(k, tcx)) && k < o && (tcx.match_[k as usize]) >= o
            && k + 1 < last
            && (tcx.in_f[(k + 1) as usize]) == 0 {
            if kind(k, tcx) == Tok::LBrace as i64 {
                if (tcx.dep[(k - i) as usize]) < brace_dep {
                    brace_at = k;
                    brace_dep = (tcx.dep[(k - i) as usize]);
                }
            } else if (tcx.dep[(k - i) as usize]) < open_dep {
                open_at = k + 1;
                open_dep = (tcx.dep[(k - i) as usize]);
            }
        }
        if k > o || is_comment(kind(k, tcx)) || (tcx.in_f[k as usize]) != 0 {
            continue;
        }
        let pk = kind(k - 1, tcx);
        let mut at = k;
        let mut class: i64 = 99;
        // (not between a closure's bars)
        if (pk == Tok::Comma as i64 && bar(k - 1, tcx) != 3) || pk == Tok::Semi as i64 {
            at = k - 1;
            class = 0;
        } else if kind(k, tcx) == Tok::Else as i64 {
            class = 1;
        } else if op_rank(k, tcx) >= 0 {
            class = 2 + op_rank(k, tcx);
        } else if method_dot(k, tcx) {
            // (a chain of two method calls or more)
            let mut dots = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            chain_dots(k, i, last, &mut dots, tcx);
            if dots.len() as i64 >= 2 {
                class = CHAIN;
            }
        }
        let g = (tcx.grp[(at - i) as usize]);
        let d = (tcx.dep[(at - i) as usize]);
        // (class 9 and 10, `+` and `*`, are not breaks: as in 0.13)
        if (class < 9 || class == CHAIN) && (g < 0 || (tcx.match_[g as usize]) >= o)
            && (d < best_dep || (d == best_dep && class <= best_class)) {
            best = k;
            best_dep = d;
            best_class = class;
        }
    }
    // (a `{ }` opened on the line around the break: its contents on lines
    // of their own first)
    if brace_at >= 0 && best >= 0 && brace_dep < best_dep {
        return expand(brace_at, last, tcx);
    }
    // (a chain: a line for each call, `.iter()` too)
    if best >= 0 && best_class == CHAIN {
        let mut dots = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        chain_dots(best, i, last, &mut dots, tcx);
        let mut changed = false;
        for j in 0..dots.len() as i64 {
            if (dots[j as usize]) > i
                && (tcx.brk[(dots[j as usize]) as usize]) == 0 {
                (tcx.brk[(dots[j as usize]) as usize]) = 1;
                changed = true;
            }
        }
        return changed;
    }
    if best >= 0 {
        let at = if best_class == 0 { best - 1 } else { best };
        let g = (tcx.grp[(at - i) as usize]);
        if reflow(i, e, best_class, g, tcx) {
            return true;
        }
        (tcx.brk[best as usize]) = 1;
        return true;
    }
    // After the shallowest `(` or `[`, else the contents of a `{ }`.
    if open_at >= 0 {
        (tcx.brk[open_at as usize]) = 1;
        return true;
    }
    if brace_at >= 0 {
        return expand(brace_at, last, tcx);
    }
    false
}

// Before breaking line i..e at a break of `class` (0 a comma, 1 an
// `else`, 2 + its op_rank: a binary operator) in bracket g (-1: the
// bracket the line is in), the lines after it that continue it the same
// way are joined to it, to be filled again: lines of that bracket, with
// no blank line or comment, that start after a `,` (a `(` or `[`'s), or
// with an `else`, `&&` or `||`, or a binary operator, and close every
// bracket they open (but the bracket's own `)`). Whether one was joined.
fn reflow(i: i64, e: i64, class: i64, g: i64, tcx: &mut Tcx<Comp>) -> bool {
    let group = if g >= 0 { g } else { (tcx.lopen[i as usize]) };
    if class == 0 && (group < 0 || kind(group, tcx) == Tok::LBrace as i64) {
        return false;
    }
    let n = tcx.p_kind.len() as i64;
    let mut joined = false;
    let mut j = e;
    while j < n && (tcx.p_nl[j as usize]) == 1
        && (tcx.lopen[j as usize]) == group && !is_comment(kind(j, tcx))
        && !is_comment(kind(j - 1, tcx)) {
        let k = kind(j, tcx);
        let starts = if class == 0 { kind(j - 1, tcx) == Tok::Comma as i64 }
            else if class == 1 { k == Tok::Else as i64 }
            else { op_rank(j, tcx) == class - 2 };
        if !starts {
            break;
        }
        let next = line_end_piece(j, tcx);
        let mut depth: i64 = 0;
        let mut closes = false;
        let mut ok = true;
        for p in j..next {
            if is_comment(kind(p, tcx)) || has_newline(piece(p, tcx)) {
                ok = false;
            } else if group >= 0 && p == (tcx.match_[group as usize]) {
                closes = true;
            } else if !closes && is_open(kind(p, tcx)) {
                depth += 1;
            } else if !closes && is_close(kind(p, tcx)) {
                depth -= 1;
                if depth < 0 {
                    ok = false;
                }
            }
        }
        if !ok || (depth != 0 && !closes) {
            break;
        }
        (tcx.brk[j as usize]) = 0;
        joined = true;
        if closes {
            break;
        }
        j = next;
    }
    joined
}

// Breaks after `{` piece g and before its `}` when it is on the line
// (which ends before `last`), and, for a `match`, after each arm's `,`;
// whether a break was added.
fn expand(g: i64, last: i64, tcx: &mut Tcx<Comp>) -> bool {
    let c = (tcx.match_[g as usize]);
    if c == g + 1 {
        return false;
    }
    let mut changed = (tcx.brk[(g + 1) as usize]) == 0;
    (tcx.brk[(g + 1) as usize]) = 1;
    // (its `}` too when on a later line, but not one copied as it is)
    if (tcx.brk[c as usize]) == 0
        && (c < last || (tcx.ranged[c as usize]) != 0) {
        (tcx.brk[c as usize]) = 1;
        changed = true;
    }
    if match_body(g, tcx) {
        let mut p = g + 1;
        while p < c && p < last {
            if is_open(kind(p, tcx)) {
                p = (tcx.match_[p as usize]);
            }
            else if kind(p, tcx) == Tok::Comma as i64 && p + 1 < c
                && !is_comment(kind(p + 1, tcx))
                && (tcx.brk[(p + 1) as usize]) == 0 {
                (tcx.brk[(p + 1) as usize]) = 1;
            }
            p += 1;
        }
    }
    changed
}

// Whether `{` piece g is a `match`'s (its arms).
fn match_body(g: i64, tcx: &Tcx<Comp>) -> bool {
    let mut j = g - 1;
    while j >= 0 {
        let k = kind(j, tcx);
        if k == Tok::Match as i64 {
            return true;
        }
        if is_close(k) {
            j = (tcx.match_[j as usize]);
        }
        else if is_open(k) || k == Tok::Semi as i64 || k == Tok::Comma as i64
            || k == Tok::FatArrow as i64
            || k == Tok::Eq as i64 {
            return false;
        }
        j -= 1;
    }
    false
}
