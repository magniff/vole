// The layout of 0.18's syntax (docs/design/contracts-verification.md
// §2.14, phase 0): clauses after a signature are continuation lines and
// the body's `{` on a line of its own is at the signature's level; the
// line after an `invariant` starts a new item; `distinct *T` is a type,
// its `*` a prefix. T9 owns the rest of the clauses' layout.

use crate::base::comp::Comp;
use crate::front::lexer::Tok;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::pieces::{is_comment, kind, piece};

// Whether piece i is the identifier `word`.
fn is_ident(i: i64, word: &[u8], tcx: &Tcx<Comp>) -> bool {
    i >= 0 && kind(i, tcx) == Tok::Ident as i64 && piece(i, tcx) == word
}

// The code piece after i (comments skipped), or -1.
fn next_code(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut j = i + 1;
    while j < tcx.p_kind.count && is_comment(kind(j, tcx)) {
        j += 1;
    }
    if j < tcx.p_kind.count { j } else { -1 }
}

// Whether a line whose first code piece is f is a clause of a signature:
// `requires`, `ensures`, `debug requires`, `debug ensures`.
pub fn starts_clause(f: i64, tcx: &Tcx<Comp>) -> bool {
    if is_ident(f, b"debug", tcx) {
        let g = next_code(f, tcx);
        return is_ident(g, b"requires", tcx) || is_ident(g, b"ensures", tcx);
    }
    is_ident(f, b"requires", tcx) || is_ident(f, b"ensures", tcx)
}

// Whether a line whose first code piece is f is a type's invariant:
// `invariant ...` or `debug invariant ...`.
pub fn starts_invariant(f: i64, tcx: &Tcx<Comp>) -> bool {
    if is_ident(f, b"debug", tcx) {
        return is_ident(next_code(f, tcx), b"invariant", tcx);
    }
    is_ident(f, b"invariant", tcx)
}

// Whether piece j, before a `*`, makes it a prefix: `distinct *T`. (The
// conventions, `x: sink *T`, are keywords from 0.21: no operand ends there.)
pub fn before_prefix_star(j: i64, tcx: &Tcx<Comp>) -> bool {
    is_ident(j, b"distinct", tcx)
}

// (0.26.2) Whether piece i is `where` (a reserved word: its kind is
// Reserved), which starts a signature's bounds: the lines up to the body's
// `{` (or the `;`) continue the signature, as clauses do.
pub fn is_where(i: i64, tcx: &Tcx<Comp>) -> bool {
    i >= 0 && kind(i, tcx) == Tok::Reserved as i64 && piece(i, tcx) == b"where"
}
