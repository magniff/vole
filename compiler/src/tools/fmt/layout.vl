// The layout of `volec fmt` (0.13): where lines start, how far each
// is indented, the blank lines between them and the spaces between the
// pieces of a line. Line breaks are the source's (a line is never
// joined), plus the ones wrap adds to lines of more than WIDTH columns.
//
// Indentation is four spaces a level, from the brackets:
//
//   - a line of a bracket's contents is one level deeper than the
//     bracket's base, and a line starting with its closing bracket is at
//     its base;
//   - a `(` or `[` has the base of the line it is on; a `{` has the base
//     of its line when that line starts a statement (or is an `else`),
//     else the base of the statement the line continues (so the body of
//     `if a\n    && b {` is one level deeper than the `if`);
//   - a line that continues a statement (the line before does not end it
//     with `;`, `{`, `}`, `,`, an opening bracket or an attribute) is one
//     level deeper than the statement's first line; an `else` continues
//     an expression, but is at the level of an `if` statement;
//   - a line of comments is at the level of the line after it (inside the
//     block, before a closing bracket).
//
// Blank lines: at most one in a row, none at the start of the file,
// after an opening bracket or before a closing one; between two items of
// a file, impl, trait, module or extern block, one when either is a
// function, type, impl, trait or block of several lines.
//
// Trailing commas (0.25.1): a list whose closing bracket starts a line
// has a `,` after its last element; one whose closing bracket is on the
// line of its last element has none (mark_commas).
//
// With ranges (an edit's lines, edit/), only the lines in them are laid
// out; the others are copied as they are.

use crate::base::{IntVec, buf_byte, buf_bytes};
use crate::base::comp::Comp;
use crate::front::lexer::Tok;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::clauses::{before_prefix_star, is_where, starts_clause, starts_invariant};
use crate::tools::fmt::pieces::{
    BLOCK_COMMENT, LINE_COMMENT, is_close, is_comment, is_open, kind, piece,
};
use crate::tools::fmt::wrap::wrap_line;

pub const WIDTH: i64 = 100;

fn set(v: inout IntVec, n: i64, value: i64) {
    v.count = 0;
    for i in 0..n {
        v.push(value);
    }
}

// The end of the line starting at piece i (the next line's start).
pub fn line_end_piece(i: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var e = i + 1;
        while e < tcx.p_kind.count && tcx.brk.data[e] == 0 {
            e += 1;
        }
        e
    }
}

// The line's first piece of code, or -1 (a line of comments).
fn first_code(i: i64, e: i64, tcx: Tcx<Comp>) -> i64 {
    for k in i..e {
        if !is_comment(kind(k, tcx)) {
            return k;
        }
    }
    -1
}

// Whether a token ends a statement or a list element, for the line after
// it: `;`, `,`, a brace or an opening bracket.
fn ends_element(k: i64) -> bool {
    k == Tok::Semi as i64 || k == Tok::Comma as i64 || k == Tok::LBrace as i64
        || k == Tok::RBrace as i64 || k == Tok::LParen as i64 || k == Tok::LBracket as i64
}

// Whether an item of this keyword is a block of lines that gets a blank
// line around it.
fn block_item(k: i64) -> bool {
    k == Tok::Fn as i64 || k == Tok::Struct as i64 || k == Tok::Enum as i64
        || k == Tok::Union as i64 || k == Tok::Impl as i64 || k == Tok::Trait as i64
        || k == Tok::Mod as i64 || k == Tok::Extern as i64
}

fn push_frame(base: i64, stmt: i64, attr: bool, items: bool, open: i64, tcx: inout Tcx<Comp>) {
    tcx.fr_base.push(base);
    tcx.fr_stmt.push(stmt);
    tcx.fr_first.push(-1);
    tcx.fr_attr.push(if attr { 1 } else { 0 });
    tcx.fr_items.push(if items { 1 } else { 0 });
    tcx.fr_kw.push(-1);
    tcx.fr_item.push(-1);
    tcx.fr_open.push(open);
}

fn pop_frame(tcx: inout Tcx<Comp>) {
    tcx.fr_base.pop();
    tcx.fr_stmt.pop();
    tcx.fr_first.pop();
    tcx.fr_attr.pop();
    tcx.fr_items.pop();
    tcx.fr_kw.pop();
    tcx.fr_item.pop();
    tcx.fr_open.pop();
}

// IND of every line; with `items`, the items too (IT_*).
pub fn indent_lines(items: bool, tcx: inout Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        set(&tcx.ind, n, 0);
        set(&tcx.lopen, n, -1);
        set(&tcx.fr_base, 0, 0);
        set(&tcx.fr_stmt, 0, 0);
        set(&tcx.fr_first, 0, 0);
        set(&tcx.fr_attr, 0, 0);
        set(&tcx.fr_items, 0, 0);
        set(&tcx.fr_kw, 0, 0);
        set(&tcx.fr_item, 0, 0);
        set(&tcx.fr_open, 0, 0);
        set(&tcx.it_first, 0, 0);
        set(&tcx.it_lines, 0, 0);
        set(&tcx.it_prev, 0, 0);
        set(&tcx.it_kw, 0, 0);
        push_frame(-1, 0, false, true, -1, &tcx);
        var pending = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var prev = -1;
        var after_attr = false;
        // (0.16: type parameters open at the line's start: a long `<..>`
        // broken after a `,` continues the line)
        var angles = 0;
        // (0.18) the first code piece of the line before
        var last_first = -1;
        // (0.26.2) after a signature's `where`, before its body's `{`
        var in_where = false;
        // (and the `where` starts a line: its predicates go one level in)
        var where_own = false;
        var i = 0;
        while i < n {
            let e = line_end_piece(i, tcx);
            let f = first_code(i, e, tcx);
            if f < 0 {
                pending.push(i);
                i = e;
                continue;
            }
            let top = tcx.fr_base.count - 1;
            tcx.lopen.data[i] = tcx.fr_open.data[top];
            let kf = kind(f, tcx);
            let closer = is_close(kf);
            var cont = false;
            var ind = 0;
            if closer {
                ind = tcx.fr_base.data[top];
            } else {
                cont = (prev >= 0 && !ends_element(kind(prev, tcx)) && !after_attr)
                    || kf == Tok::Else as i64 || angles > 0 || in_where || is_where(f, tcx);
                // (0.18) an item starts after an `invariant` line
                if cont && last_first >= 0 && starts_invariant(last_first, tcx) {
                    cont = false;
                }
                if kf == Tok::Else as i64 && prev >= 0 && kind(prev, tcx) == Tok::RBrace as i64
                    && tcx.fr_first.data[top] == Tok::If as i64 {
                    ind = tcx.fr_stmt.data[top];
                } else if cont {
                    ind = tcx.fr_stmt.data[top] + 1;
                    // (0.18) a body's `{` after clauses: at the signature's level
                    if kf == Tok::LBrace as i64 && last_first >= 0
                        && (starts_clause(last_first, tcx) || in_where) {
                        ind = tcx.fr_stmt.data[top];
                    } else if in_where && where_own && !is_where(f, tcx) {
                        ind = tcx.fr_stmt.data[top] + 2;
                    }
                } else {
                    ind = tcx.fr_base.data[top] + 1;
                    tcx.fr_stmt.data[top] = ind;
                    tcx.fr_first.data[top] = kf;
                    tcx.fr_kw.data[top] = -1;
                }
            }
            for p in 0..pending.count {
                tcx.ind.data[pending.data[p]] = if closer { tcx.fr_base.data[top] + 1 }
                    else { ind };
            }
            tcx.ind.data[i] = ind;
            // The item this line starts or continues, in the innermost
            // block of items around it.
            var g = if closer { top - 1 } else { top };
            while g > 0 && tcx.fr_items.data[g] == 0 {
                g -= 1;
            }
            if items {
                if g == top && !closer && !cont && !after_attr {
                    tcx.it_first.push(if pending.count > 0 { pending.data[0] } else { i });
                    tcx.it_lines.push(1);
                    tcx.it_prev.push(tcx.fr_item.data[g]);
                    tcx.it_kw.push(-1);
                    tcx.fr_item.data[g] = tcx.it_first.count - 1;
                } else if tcx.fr_item.data[g] >= 0 {
                    tcx.it_lines.data[tcx.fr_item.data[g]] += 1;
                }
            }
            pending.count = 0;
            let start_open = tcx.fr_open.data[top];
            for k in i..e {
                let kk = kind(k, tcx);
                if is_comment(kk) {
                    continue;
                }
                if generic(k, tcx) {
                    if kk == Tok::Lt as i64 {
                        angles += 1;
                    } else {
                        angles -= if kk == Tok::Shr as i64 { 2 } else { 1 };
                        if angles < 0 {
                            angles = 0;
                        }
                    }
                }
                if is_where(k, tcx) {
                    in_where = true;
                    where_own = k == f;
                } else if kk == Tok::LBrace as i64 || kk == Tok::Semi as i64 {
                    in_where = false;
                }
                let cur = tcx.fr_base.count - 1;
                if tcx.fr_kw.data[cur] == -1 && kk != Tok::Pub as i64 && kk != Tok::Unsafe as i64
                    && kk != Tok::Hash as i64 {
                    tcx.fr_kw.data[cur] = kk;
                }
                if is_open(kk) {
                    var base = ind;
                    if kk == Tok::LBrace as i64 && !closer
                        && !(tcx.fr_open.data[cur] == start_open
                            && (!cont || kf == Tok::Else as i64)) {
                        base = tcx.fr_stmt.data[cur];
                    }
                    let attr = kk == Tok::LBracket as i64 && prev >= 0
                        && kind(prev, tcx) == Tok::Hash as i64;
                    let kw = tcx.fr_kw.data[cur];
                    let holds = tcx.fr_items.data[cur] != 0 && kk == Tok::LBrace as i64
                        && (kw == Tok::Impl as i64 || kw == Tok::Trait as i64
                            || kw == Tok::Mod as i64
                            || (kw == Tok::Extern as i64 && prev >= 0
                                && kind(prev, tcx) == Tok::Str as i64));
                    push_frame(base, ind, attr, holds, k, &tcx);
                    after_attr = false;
                } else if is_close(kk) {
                    after_attr = tcx.fr_attr.data[cur] != 0;
                    if tcx.fr_base.count > 1 {
                        pop_frame(&tcx);
                    }
                } else {
                    after_attr = false;
                }
                prev = k;
            }
            if items && g < tcx.fr_base.count && tcx.fr_item.data[g] >= 0
                && tcx.it_kw.data[tcx.fr_item.data[g]] == -1 {
                tcx.it_kw.data[tcx.fr_item.data[g]] = tcx.fr_kw.data[g];
            }
            last_first = f;
            i = e;
        }
        for p in 0..pending.count {
            tcx.ind.data[pending.data[p]] = 0;
        }
    }
}

// BLANK, from the source and the rules (laid out lines only).
fn blank_lines(tcx: inout Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        set(&tcx.blank, n, 0);
        var i = 0;
        while i < n {
            let e = line_end_piece(i, tcx);
            if i > 0 && tcx.p_nl.data[i] >= 2 {
                tcx.blank.data[i] = 1;
            }
            if tcx.ranged.data[i] != 0 && i > 0 {
                let f = first_code(i, e, tcx);
                var j = i - 1;
                if kind(j, tcx) == LINE_COMMENT && j > 0 && tcx.brk.data[j] == 0 {
                    j -= 1;
                }
                if (f == i && is_close(kind(f, tcx))) || is_open(kind(j, tcx)) {
                    tcx.blank.data[i] = 0;
                }
            }
            i = e;
        }
        for y in 0..tcx.it_first.count {
            let x = tcx.it_prev.data[y];
            if x < 0 {
                continue;
            }
            let p = tcx.it_first.data[y];
            if tcx.ranged.data[p] != 0
                && ((block_item(tcx.it_kw.data[x]) && tcx.it_lines.data[x] > 1)
                    || (block_item(tcx.it_kw.data[y]) && tcx.it_lines.data[y] > 1)) {
                tcx.blank.data[p] = 1;
            }
        }
    }
}

// Whether a `<` at piece i opens type arguments or parameters (not a
// comparison): after `::` (`max::<u8>`) or `impl`, after the name an
// item declares (`fn grow<T>`, `struct Pair<T>`), or after a type's name
// (`Vec<i64>`: a capital, then a small letter or nothing).
fn opens_generics(i: i64, tcx: Tcx<Comp>) -> bool {
    if i == 0 {
        return false;
    }
    let k = kind(i - 1, tcx);
    if k == Tok::ColonColon as i64 || k == Tok::Impl as i64 {
        return true;
    }
    // (0.27.0: the rust edition's `fn union<'a>`, a method named so; `<T as
    // Tr>::X`, a qualified path)
    if k == Tok::Union as i64 && i > 1 && kind(i - 2, tcx) == Tok::Fn as i64
        || qualified_at(i, tcx) {
        return true;
    }
    if k != Tok::Ident as i64 {
        return false;
    }
    if i > 1 {
        let d = kind(i - 2, tcx);
        if d == Tok::Fn as i64 || d == Tok::Struct as i64 || d == Tok::Enum as i64
            || d == Tok::Union as i64
            || d == Tok::Type as i64 || d == Tok::Trait as i64 {
            return true;
        }
    }
    let name = piece(i - 1, tcx);
    if name[0] < 'A' || name[0] > 'Z' {
        return false;
    }
    if name.len == 1 {
        return true;
    }
    for j in 1..name.len {
        if name[j] >= 'a' && name[j] <= 'z' {
            return true;
        }
    }
    false
}

// (0.27.0) Whether the `<` at piece i opens a qualified path, `<T as Tr>`,
// `<I::Item as IntoIterator>`: a path, then `as`.
fn qualified_at(i: i64, tcx: Tcx<Comp>) -> bool {
    var j = i + 1;
    while j < tcx.p_kind.count && (kind(j, tcx) == Tok::Ident as i64
        || kind(j, tcx) == Tok::ColonColon as i64) {
        j += 1;
    }
    j > i + 1 && j < tcx.p_kind.count && kind(j, tcx) == Tok::As as i64
}

// GEN: the `<`, `>` and `>>` pieces of type arguments (a `>>` closing
// two). A `;` or a brace closes any left open.
fn mark_generics(tcx: inout Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        set(&tcx.gen, n, 0);
        var open = 0;
        // (the `[` opened inside them: `Vec<[i64; 2]>`'s `;` is the array's)
        var brackets = 0;
        for i in 0..n {
            let k = kind(i, tcx);
            if open > 0 && k == Tok::LBracket as i64 {
                brackets += 1;
            } else if open > 0 && k == Tok::RBracket as i64 && brackets > 0 {
                brackets -= 1;
            }
            // (as written: `Vec<T>` is tight, `E::A < E::B` compares; 0.16:
            // within type arguments, as `U = Vec< T >` in a default, any)
            if k == Tok::Lt as i64 && opens_generics(i, tcx) && i + 1 < n
                && (tcx.p_start.data[i + 1] == tcx.p_end.data[i] || open > 0) {
                tcx.gen.data[i] = 1;
                open += 1;
            }
            else if k == Tok::Shl as i64 && i + 1 < n
                && tcx.p_start.data[i + 1] == tcx.p_end.data[i]
                && (open > 0 || opens_generics(i, tcx)) {
                // (0.27.0: `Option<<I as Tr>::X>`, two opened at once)
                tcx.gen.data[i] = 1;
                open += 2;
            } else if k == Tok::Gt as i64 && open > 0 {
                tcx.gen.data[i] = 1;
                open -= 1;
            } else if k == Tok::Shr as i64 && open > 1 {
                tcx.gen.data[i] = 1;
                open -= 2;
            } else if k == Tok::Semi as i64 && brackets > 0 {
                // (an array type's length)
            } else if k == Tok::Semi as i64 || k == Tok::LBrace as i64 || k == Tok::RBrace as i64 {
                open = 0;
                brackets = 0;
            }
        }
    }
}

// Whether piece i is a `<`, `>` or `>>` of type arguments.
pub fn generic(i: i64, tcx: Tcx<Comp>) -> bool {
    unsafe { tcx.gen.data[i] != 0 }
}

// Whether a `|` or `||` at piece i starts a closure (0.14): it is where
// an operand starts (not after one), or after `move`.
fn opens_closure(i: i64, tcx: Tcx<Comp>) -> bool {
    var j = i - 1;
    while j >= 0 && is_comment(kind(j, tcx)) {
        j -= 1;
    }
    if j < 0 {
        return true;
    }
    let k = kind(j, tcx);
    k == Tok::Move as i64 || !(ends_operand(k) || k == Tok::RBrace as i64 || generic(j, tcx))
}

// BAR: the bars of closures (0.14), 1 at a `|` or `||` opening the
// parameters, 2 at the `|` closing them (the next `|` outside brackets;
// none before a `;` or a brace: not a closure), 3 at a `,` between them.
fn mark_bars(tcx: inout Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        set(&tcx.bar, n, 0);
        for i in 0..n {
            let k = kind(i, tcx);
            if (k != Tok::Pipe as i64 && k != Tok::PipePipe as i64) || tcx.bar.data[i] != 0
                || !opens_closure(i, tcx) {
                continue;
            }
            if k == Tok::PipePipe as i64 {
                tcx.bar.data[i] = 1;
                continue;
            }
            var j = i + 1;
            while j < n {
                let kj = kind(j, tcx);
                if kj == Tok::Pipe as i64 {
                    tcx.bar.data[i] = 1;
                    tcx.bar.data[j] = 2;
                    for p in i + 1..j {
                        if kind(p, tcx) == Tok::Comma as i64 {
                            tcx.bar.data[p] = 3;
                        }
                    }
                    break;
                }
                if is_open(kj) && tcx.match_.data[j] > j {
                    j = tcx.match_.data[j];
                } else if is_close(kj) || kj == Tok::Semi as i64 || kj == Tok::LBrace as i64
                    || kj == Tok::PipePipe as i64 {
                    break;
                }
                j += 1;
            }
        }
    }
}

// Whether piece i is a closure's bar: 1 opening, 2 closing, 3 a `,`
// between them, else 0.
pub fn bar(i: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe { tcx.bar.data[i] }
}

// (0.26.0) The lines holding an embedded block's text (a Tok::Embedded
// piece, `embed wgsl K { .. }`) are kept as they are, from the line of its
// `{` to the line of its `}`: fmt never touches another language's text.
pub fn keep_embedded(tcx: inout Tcx<Comp>) {
    let n = tcx.p_kind.count;
    var k = 0;
    while k < n {
        if tcx.p_kind.get(k) != Tok::Embedded as i64 {
            k += 1;
            continue;
        }
        var i = k;
        while i > 0 && tcx.p_nl.get(i) == 0 {
            i -= 1;
        }
        var e = k + 1;
        while e < n && tcx.p_nl.get(e) == 0 {
            e += 1;
        }
        for j in i..e {
            tcx.ranged.set(j, 0);
        }
        k = e;
    }
}

// Lays the pieces out: line starts (wrapping), levels, blank lines.
pub fn lay_out(tcx: inout Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        mark_generics(&tcx);
        mark_bars(&tcx);
        set(&tcx.brk, n, 0);
        for i in 0..n {
            if i == 0 || tcx.p_nl.data[i] > 0 {
                tcx.brk.data[i] = 1;
            }
        }
        var pass = 0;
        while pass < 40 {
            indent_lines(false, &tcx);
            var changed = false;
            var i = 0;
            while i < n {
                let e = line_end_piece(i, tcx);
                if tcx.ranged.data[i] != 0 && wrap_line(i, e, &tcx) {
                    changed = true;
                }
                // (past the lines a reflow joined)
                i = e;
                while i < n && tcx.brk.data[i] == 0 {
                    i += 1;
                }
            }
            if !changed {
                break;
            }
            pass += 1;
        }
        indent_lines(true, &tcx);
        blank_lines(&tcx);
        mark_commas(&tcx);
    }
}

// The commas of the list in brackets o..c, at its level (not a closure's,
// not in type arguments); -1 when it is no list: a `;` at its level (a
// block, `[x; n]`).
fn list_commas(o: i64, c: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var commas = 0;
        var angles = 0;
        var p = o + 1;
        while p < c {
            let k = kind(p, tcx);
            if is_open(k) {
                p = tcx.match_.data[p] + 1;
                continue;
            }
            if generic(p, tcx) {
                if k == Tok::Lt as i64 {
                    angles += 1;
                } else {
                    angles -= if k == Tok::Shr as i64 { 2 } else { 1 };
                    if angles < 0 {
                        angles = 0;
                    }
                }
            } else if k == Tok::Semi as i64 {
                return -1;
            } else if k == Tok::Comma as i64 && angles == 0 && bar(p, tcx) != 3 {
                commas += 1;
            }
            p += 1;
        }
        commas
    }
}

// The code piece before i, or -1.
fn code_before(i: i64, tcx: Tcx<Comp>) -> i64 {
    var j = i - 1;
    while j >= 0 && is_comment(kind(j, tcx)) {
        j -= 1;
    }
    j
}

// Whether `(` piece o is a call's or a declaration's parameters (after a
// name, a call, an index or type arguments): `f(x,)` is `f(x)`, where
// `(x,)` is a tuple.
fn call_paren(o: i64, tcx: Tcx<Comp>) -> bool {
    let j = code_before(o, tcx);
    if j < 0 {
        return false;
    }
    let k = kind(j, tcx);
    k == Tok::Ident as i64 || k == Tok::RParen as i64 || k == Tok::RBracket as i64
        || (generic(j, tcx) && (k == Tok::Gt as i64 || k == Tok::Shr as i64))
}

// Whether the last element of the list in brackets o..c (from its last
// comma at its level) starts with `..` or `...` (a struct literal's base,
// a rest pattern, C's varargs): no comma after it.
fn rest_last(o: i64, c: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        var start = o + 1;
        var p = o + 1;
        while p < c {
            let k = kind(p, tcx);
            if is_open(k) {
                p = tcx.match_.data[p] + 1;
                continue;
            }
            if k == Tok::Comma as i64 && bar(p, tcx) != 3 {
                start = p + 1;
            }
            p += 1;
        }
        while start < c && is_comment(kind(start, tcx)) {
            start += 1;
        }
        start < c
            && (kind(start, tcx) == Tok::DotDot as i64 || kind(start, tcx) == Tok::Ellipsis as i64)
    }
}

// ADDC and DROPC: a list (in `(`, `[` or `{`, with a `,` at its level; a
// call's in `(` with none) whose closing bracket starts a line gets a `,`
// after its last element; one whose closing bracket follows its `,` on
// the line loses it (not a tuple's of one: `(x,)`). Not in an attribute's
// `#[..]`, an f-string, or after a `}` in braces (a block, an arm's).
fn mark_commas(tcx: inout Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        set(&tcx.addc, n, 0);
        set(&tcx.dropc, n, 0);
        tcx.commas_changed = false;
        for c in 0..n {
            let kc = kind(c, tcx);
            if !is_close(kc) || tcx.ranged.data[c] == 0 || tcx.in_f.data[c] != 0 {
                continue;
            }
            let o = tcx.match_.data[c];
            let l = code_before(c, tcx);
            if l <= o || tcx.ranged.data[l] == 0 {
                continue;
            }
            if kc == Tok::RBracket as i64 && o > 0 && kind(o - 1, tcx) == Tok::Hash as i64 {
                continue;
            }
            let commas = list_commas(o, c, tcx);
            if commas < 0 {
                continue;
            }
            let kl = kind(l, tcx);
            if tcx.brk.data[c] != 0 {
                if kl == Tok::Comma as i64 || kl == Tok::LBrace as i64 || rest_last(o, c, tcx) {
                    continue;
                }
                let list = if kc == Tok::RParen as i64 { commas > 0 || call_paren(o, tcx) }
                    else if kc == Tok::RBracket as i64 { commas > 0 }
                    else { commas > 0 && kl != Tok::RBrace as i64 };
                if list {
                    tcx.addc.data[l] = 1;
                    tcx.commas_changed = true;
                }
            } else if kl == Tok::Comma as i64 && l == c - 1 && bar(l, tcx) != 3
                && (kc != Tok::RParen as i64 || commas > 1 || call_paren(o, tcx)) {
                tcx.dropc.data[l] = 1;
                tcx.commas_changed = true;
            }
        }
    }
}

// ---- Spaces ----

fn in2(k: i64, a: Tok, b: Tok) -> bool {
    k == a as i64 || k == b as i64
}

// Whether a token can end an operand (so that a `-`, `*` or `&` after it
// is binary).
fn ends_operand(k: i64) -> bool {
    k == Tok::Ident as i64 || k == Tok::Int as i64 || k == Tok::Float as i64
        || k == Tok::Char as i64 || k == Tok::Str as i64 || k == Tok::CStr as i64
        || k == Tok::True as i64 || k == Tok::False as i64 || k == Tok::RParen as i64
        || k == Tok::RBracket as i64 || k == Tok::Question as i64 || k == Tok::Reserved as i64
}

// Whether piece i is a prefix `-`, `*`, `&` or `&&` (0.17: `&&x`, `&&T`;
// not after an operand; a `}` on the same line counts as one).
pub fn is_unary(i: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        let k = kind(i, tcx);
        if k != Tok::Minus as i64 && k != Tok::Star as i64 && k != Tok::Amp as i64
            && k != Tok::AmpAmp as i64 {
            return false;
        }
        var j = i - 1;
        while j >= 0 && is_comment(kind(j, tcx)) {
            j -= 1;
        }
        if j < 0 {
            return true;
        }
        if kind(j, tcx) == Tok::RBrace as i64 {
            return !(j == i - 1 && tcx.brk.data[i] == 0);
        }
        // (0.18: `distinct *T`)
        !ends_operand(kind(j, tcx)) || before_prefix_star(j, tcx)
    }
}

// Whether brace piece i is the brace of a `use` list (`::{`).
fn tight(i: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        let o = if kind(i, tcx) == Tok::LBrace as i64 { i } else { tcx.match_.data[i] };
        o > 0 && kind(o - 1, tcx) == Tok::ColonColon as i64
    }
}

// Whether the two texts written together would lex as other tokens.
fn would_join(a: [u8], b: [u8]) -> bool {
    let x = a[a.len as i64 - 1];
    let y = b[0];
    if y == '='
        && (x == '+' || x == '-' || x == '*' || x == '/' || x == '%' || x == '&' || x == '|'
            || x == '^' || x == '!' || x == '=' || x == '<' || x == '>' || x == '.') {
        return true;
    }
    if x == '/' && (y == '/' || y == '*') {
        return true;
    }
    (x == y && (x == '<' || x == '>' || x == '&' || x == '|' || x == '.' || x == ':'))
        || (y == '>' && (x == '-' || x == '='))
}

// Whether there was a blank between pieces a and b in the source.
fn spaced(a: i64, b: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe { if tcx.p_start.data[b] > tcx.p_end.data[a] { 1 } else { 0 } }
}

// The spaces between pieces a and b of one line (0 or 1).
pub fn space(a: i64, b: i64, tcx: Tcx<Comp>) -> i64 {
    let s = space_rule(a, b, tcx);
    // (closers of type arguments stay together: `Vec<Vec<i64>>>` lexes as
    // `>>` and `>`, as written)
    if s == 0 && !is_comment(kind(a, tcx)) && !is_comment(kind(b, tcx))
        && would_join(piece(a, tcx), piece(b, tcx))
        && !(generic(a, tcx) && generic(b, tcx) && is_close_angle(kind(a, tcx))
            && is_close_angle(kind(b, tcx))) {
        return 1;
    }
    s
}

// (0.27.0) Whether generic piece a, a `>`, closes the parameters of an
// `impl<..>` (its `<` right after `impl`).
fn closes_impl_generics(a: i64, tcx: Tcx<Comp>) -> bool {
    if kind(a, tcx) != Tok::Gt as i64 {
        return false;
    }
    var depth = 0;
    var j = a;
    while j > 0 {
        let k = kind(j, tcx);
        if generic(j, tcx) && is_close_angle(k) {
            depth += if k == Tok::Shr as i64 { 2 } else { 1 };
        } else if generic(j, tcx) && (k == Tok::Lt as i64 || k == Tok::Shl as i64) {
            depth -= if k == Tok::Shl as i64 { 2 } else { 1 };
            if depth <= 0 {
                return kind(j - 1, tcx) == Tok::Impl as i64;
            }
        }
        j -= 1;
    }
    false
}

// A `>` or `>>`.
fn is_close_angle(k: i64) -> bool {
    k == Tok::Gt as i64 || k == Tok::Shr as i64
}

fn space_rule(a: i64, b: i64, tcx: Tcx<Comp>) -> i64 {
    let ka = kind(a, tcx);
    let kb = kind(b, tcx);
    if kb == LINE_COMMENT {
        return 1;
    }
    if ka == BLOCK_COMMENT || kb == BLOCK_COMMENT {
        return spaced(a, b, tcx);
    }
    // (0.15: an f-string's hole, `{x}`, has no space inside its braces)
    if in2(ka, Tok::FHead, Tok::FMid) || in2(kb, Tok::FMid, Tok::FTail) {
        return 0;
    }
    // (type arguments: `Vec<i64>`, `max::<u8>(x)`; else `<` and `>` compare)
    // (closures: `|x, y| x + y`, no space inside the bars)
    if bar(a, tcx) == 1 && ka == Tok::Pipe as i64 || bar(b, tcx) == 2 {
        return 0;
    }
    // (0.27.0: a qualified path's `<`, `<T as Tr>::X`: as written)
    if kb == Tok::Lt as i64 && generic(b, tcx) && qualified_at(b, tcx) {
        return spaced(a, b, tcx);
    }
    if (generic(a, tcx) && (ka == Tok::Lt as i64 || ka == Tok::Shl as i64)) || generic(b, tcx) {
        return 0;
    }
    if generic(a, tcx) && (kb == Tok::LParen as i64 || kb == Tok::LBracket as i64) {
        // (0.27.0: `impl<T> [T]`, the type after an impl's parameters, as
        // written: Rust's spacing, or MVS's `impl<T>[T]`)
        return if kb == Tok::LBracket as i64 && closes_impl_generics(a, tcx) { spaced(a, b, tcx) }
            else { 0 };
    }
    // (0.26.2: `pub(crate)`, `pub(super)`, `pub(self)`, `pub(in a)`)
    if ka == Tok::Pub as i64 && kb == Tok::LParen as i64 {
        return 0;
    }
    // (0.27.0: `T: ?Sized`, `A + ?Sized`: a bound's `?`, not the operator)
    if kb == Tok::Question as i64 && in2(ka, Tok::Colon, Tok::Plus) {
        return 1;
    }
    if ka == Tok::Question as i64 && a > 0 && in2(kind(a - 1, tcx), Tok::Colon, Tok::Plus) {
        return 0;
    }
    if in2(kb, Tok::Comma, Tok::Semi) || in2(kb, Tok::RParen, Tok::RBracket)
        || in2(kb, Tok::Dot, Tok::Question)
        || kb == Tok::ColonColon as i64 {
        return 0;
    }
    if kb == Tok::Colon as i64 {
        return if in2(ka, Tok::Break, Tok::Continue) { 1 } else { 0 };
    }
    if in2(ka, Tok::Comma, Tok::Semi) {
        return 1;
    }
    if ka == Tok::Colon as i64 {
        return if a > 0 && in2(kind(a - 1, tcx), Tok::Break, Tok::Continue) { 0 } else { 1 };
    }
    if in2(ka, Tok::LParen, Tok::LBracket) || in2(ka, Tok::Dot, Tok::ColonColon)
        || ka == Tok::Hash as i64 {
        return 0;
    }
    if in2(ka, Tok::Bang, Tok::Tilde) {
        return if kb == Tok::LBrace as i64 { 1 } else { 0 };
    }
    // (0.25.3: `include_str!(..)`, Rust's spelling of the call, joint)
    if ka == Tok::Ident as i64 && kb == Tok::Bang as i64
        && (piece(a, tcx) == "include_str" || piece(a, tcx) == "include_bytes") {
        return 0;
    }
    if is_unary(a, tcx) {
        return 0;
    }
    if in2(ka, Tok::DotDot, Tok::DotDotEq) {
        // (0.27.2: `for i in 5.. {`, an open range before a block)
        return if kb == Tok::RBrace as i64 || kb == Tok::LBrace as i64 { 1 } else { 0 };
    }
    if in2(kb, Tok::DotDot, Tok::DotDotEq) {
        return if ends_operand(ka) { 0 } else { 1 };
    }
    // (0.18: `= distinct [T; N]`, `= distinct (A, B)`: a type after the word)
    if in2(kb, Tok::LBracket, Tok::LParen) && before_prefix_star(a, tcx) && a > 0
        && kind(a - 1, tcx) == Tok::Eq as i64 {
        return 1;
    }
    if kb == Tok::LBracket as i64 {
        return if ends_operand(ka) && !in2(ka, Tok::True, Tok::False) { 0 } else { 1 };
    }
    if kb == Tok::LParen as i64 && a > 0 && kind(a - 1, tcx) == Tok::ColonColon as i64 {
        // (0.21: a keyword after `::` is a name, `env::var(..)`)
        return 0;
    }
    if kb == Tok::LParen as i64 {
        return if in2(ka, Tok::Ident, Tok::Fn) || in2(ka, Tok::RParen, Tok::RBracket) { 0 }
            else { 1 };
    }
    if kb == Tok::LBrace as i64 {
        return 1;
    }
    if ka == Tok::LBrace as i64 {
        return if kb == Tok::RBrace as i64 || tight(a, tcx) { 0 } else { 1 };
    }
    if kb == Tok::RBrace as i64 {
        return if tight(b, tcx) { 0 } else { 1 };
    }
    1
}

// ---- Writing ----

// The bytes of the source line(s) holding pieces i..e, as they are.
fn source_lines(i: i64, e: i64, tcx: Tcx<Comp>) -> [u8] {
    unsafe {
        let t = tcx.fmt_text.as_slice();
        var s = tcx.p_start.data[i];
        while s > 0 && t[s - 1] != '\n' {
            s -= 1;
        }
        var x = tcx.p_end.data[e - 1];
        while x < t.len as i64 && t[x] != '\n' {
            x += 1;
        }
        t[s..x]
    }
}

// The laid out text, into buffer out.
pub fn write_layout(out: i64, tcx: Tcx<Comp>) {
    unsafe {
        let n = tcx.p_kind.count;
        var i = 0;
        while i < n {
            let e = line_end_piece(i, tcx);
            if tcx.ranged.data[i] == 0 {
                if i > 0 {
                    for b in 1..tcx.p_nl.data[i] {
                        buf_byte(out, '\n');
                    }
                }
                buf_bytes(out, source_lines(i, e, tcx));
                buf_byte(out, '\n');
                i = e;
                continue;
            }
            if tcx.blank.data[i] != 0 {
                buf_byte(out, '\n');
            }
            for s in 0..tcx.ind.data[i] {
                buf_bytes(out, "    ");
            }
            for k in i..e {
                if tcx.dropc.data[k] != 0 {
                    continue;
                }
                if k > i && space(k - 1, k, tcx) > 0 {
                    buf_byte(out, ' ');
                }
                buf_bytes(out, piece(k, tcx));
                if tcx.addc.data[k] != 0 {
                    buf_byte(out, ',');
                }
            }
            buf_byte(out, '\n');
            i = e;
        }
    }
}
