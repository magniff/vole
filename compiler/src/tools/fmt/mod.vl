// `volec fmt` (0.13; docs/refactor.md): one layout for vole
// source, with no options:
//
//   volec fmt [FILE|DIR]... [--check] [--dry-run] [--show]
//   volec fmt [MODULE] [--root ROOT] ...     the program's files (MODULE's)
//   volec fmt --all ...                      compiler/, tests/, examples/, bench/, tools/
//
// Indentation, spaces, blank lines and wrapping at 100 columns (layout,
// wrap), and the `use` lines tidied as `fix --only tidy-imports` writes
// them (uses). Formatting changes blanks only: the formatted text is
// read again and must have the same tokens and comments, byte for byte,
// or the file is left as it is. A file that does not lex, or whose
// brackets do not balance, is left as it is too.
//
// The files are written as an edit (the engine's journal: `undo` takes
// it back), with no check of the program (only blanks changed). `--check`
// writes nothing: the files that are not formatted, one per line, and
// exit 1 when there are some. The edit engine formats the lines every
// edit writes (format_ranges).

pub mod pieces;
mod layout;
mod wrap;
mod uses;
// (0.18: clauses, invariants, `distinct *T`)
mod clauses;
mod conv;

use std::Arena;

use crate::base::{
    IntVec, SOURCE_VOLE, SRC, STDOUT, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice,
    buf_str, buf_write_fd, load_sources,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_FLAG, EV_WORD, Leaf, flag, is_opt, option};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::init_lexer;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::fmt::layout::{keep_embedded, lay_out, write_layout};
use crate::tools::fmt::pieces::{BAD_MESSAGE, FT, line_of, read_pieces, same_pieces};
use crate::tools::fmt::uses::tidy_uses;
use crate::tools::proc::{buf_cstr, run_capture, same_bytes};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::diagnostics::{
    diag, program_errors, put_word, try_begin, try_end, write_diags,
};
use crate::tools::query::refs::{file_text, put_bad_in, ref_in, resolve_in};

extern "C" {
    fn opendir(path: *u8) -> *u8;
    fn closedir(dir: *u8) -> i32;
}

// The offset of a merge conflict's marker line in text (`<<<<<<<`,
// `=======`, `>>>>>>>` at a line's start), or -1: such a text is left as
// it is (it lexes, but its markers are no code).
fn conflict_marker(text: [u8]) -> i64 {
    var i = 0;
    while i + 7 <= text.len as i64 {
        if i == 0 || text[i - 1] == '\n' {
            let c = text[i];
            if c == '<' || c == '=' || c == '>' {
                var k = 1;
                while k < 7 && text[i + k] == c {
                    k += 1;
                }
                if k == 7
                    && (i + 7 == text.len as i64 || text[i + 7] == ' ' || text[i + 7] == '\n') {
                    return i;
                }
            }
        }
        i += 1;
    }
    -1
}

// The text formatted, into buffer out; false (out unspecified) when it
// cannot be (pieces::BAD_MESSAGE, BAD_AT say why). With ranges (pairs of
// byte offsets of text), only the lines they touch are laid out, and the
// `use` runs they touch tidied.
pub fn format_text(text: [u8], ranges: *IntVec, out: i64, tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>) -> bool {
    // (0.27.0: a rust-edition file, by its `// EDITION: rust` line)
    crate::front::rust::edition_for_text(text, &pcx);
    unsafe {
        let marker = conflict_marker(text);
        if marker >= 0 {
            BAD_MESSAGE = "merge conflict markers";
            tcx.bad_at = marker;
            return false;
        }
        if !read_pieces(text, &tcx, &pcx) {
            return false;
        }
        let whole = ranges == 0 as *IntVec || (*ranges).count == 0;
        var src = text;
        // (the `use` runs: all of them, or the ones the ranges touch, then
        // the ranges moved to the tidied text)
        var mapped = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var lines = ranges;
        let tidy = tidy_uses(if whole { 0 as *IntVec } else { ranges }, &mapped, &tcx);
        if tidy >= 0 {
            src = buf_slice(tidy);
            if !whole {
                lines = &mapped;
            }
            if !read_pieces(src, &tcx, &pcx) {
                return false;
            }
        }
        // (0.20: the receivers' short form; with --syntax=0.20, no written
        // let in a parameter list: fmt/conv.vl; a whole file only)
        if whole {
            let respelled = crate::tools::fmt::conv::respell_conventions(src, tcx, pcx);
            if respelled >= 0 {
                src = buf_slice(respelled);
                if !read_pieces(src, &tcx, &pcx) {
                    return false;
                }
            }
        }
        tcx.ranged.count = 0;
        for i in 0..tcx.p_kind.count {
            tcx.ranged.push(if whole
                || touched(src, tcx.p_start.data[i], tcx.p_end.data[i], *lines) { 1 }
                else { 0 });
        }
        keep_embedded(&tcx);
        lay_out(&tcx);
        write_layout(out, tcx);
        // (0.25.1: trailing commas written or dropped change the lines'
        // lengths: a whole file is laid out again, to its fixpoint)
        var pass = 0;
        while whole && tcx.commas_changed && pass < 3 {
            let again = buf_new();
            buf_bytes(again, buf_slice(out));
            if !read_pieces(buf_slice(again), &tcx, &pcx) {
                return false;
            }
            tcx.ranged.count = 0;
            for i in 0..tcx.p_kind.count {
                tcx.ranged.push(1);
            }
            keep_embedded(&tcx);
            lay_out(&tcx);
            buf_clear(out);
            write_layout(out, tcx);
            pass += 1;
        }
        if !same_pieces(src, buf_slice(out), &tcx, &pcx) {
            BAD_MESSAGE = "formatting would change its tokens (a bug of fmt)";
            tcx.bad_at = 0;
            return false;
        }
        true
    }
}

// Whether the lines of text[s..e) meet a range.
fn touched(text: [u8], s: i64, e: i64, ranges: IntVec) -> bool {
    unsafe {
        var a = s;
        while a > 0 && text[a - 1] != '\n' {
            a -= 1;
        }
        var b = e;
        while b < text.len as i64 && text[b] != '\n' {
            b += 1;
        }
        var k = 0;
        while k + 1 < ranges.count {
            let lo = ranges.data[k];
            let hi = ranges.data[k + 1];
            let last = if hi > lo { hi - 1 } else { lo };
            if a <= last && lo <= b {
                return true;
            }
            k += 2;
        }
        false
    }
}

// Whether a text is generated (it starts `// Generated by`, as
// compiler/src/front/stdsrc.vl does): fmt leaves it as its generator
// writes it.
pub fn generated(text: [u8]) -> bool {
    let mark = "// Generated by";
    if text.len < mark.len {
        return false;
    }
    for i in 0..mark.len {
        if text[i] != mark[i] {
            return false;
        }
    }
    true
}

// The new text of an edited file (`text`, of which `ranges` are the
// edited parts) with those lines formatted; -1 when it cannot be or
// nothing changes.
pub fn format_ranges(text: [u8], ranges: *IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let saved = FT;
        let out = buf_new();
        let ok = (*ranges).count > 0 && !generated(text)
            && format_text(text, ranges, out, &tcx, &pcx);
        FT = saved;
        if !ok || same_bytes(buf_slice(out), text) {
            return -1;
        }
        out
    }
}

// (0.25.1) A whole text formatted, for a caller in the process (the
// language server's format-on-save): a new buffer with the formatted
// text, or -1 when the text is formatted already, is generated, or
// cannot be formatted (does not lex, unbalanced brackets; BAD_MESSAGE,
// BAD_AT say why). The caller's FT is kept.
pub fn format_source(text: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let saved = FT;
    let out = buf_new();
    let ok = !generated(text) && format_text(text, 0 as *IntVec, out, &tcx, &pcx);
    FT = saved;
    if !ok || same_bytes(buf_slice(out), text) {
        return -1;
    }
    out
}

pub fn run_fmt(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>, wgx: inout WgslCx<Arena>) -> i64 {
    let status = run_fmt_inner(c, &tcx, &pcx, &wgx);
    write_diags(tcx);
    status
}

fn usage(message: *u8, arg: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"fmt.usage", &tcx);
    buf_str(d, message);
    if arg != 0 as *u8 {
        buf_str(d, c" '");
        buf_str(d, arg);
        buf_byte(d, '\'');
    }
    buf_byte(d, '\n');
    try_end(try_begin(c"fmt --check --all", c_slice(c""), false, &tcx, pcx));
    2
}

pub fn is_dir(path: *u8) -> bool {
    unsafe {
        let d = opendir(path);
        if d == 0 as *u8 {
            return false;
        }
        closedir(d);
        true
    }
}

// Whether an argument is a path (it has a `/`), not a module.
fn has_slash(a: *u8) -> bool {
    unsafe {
        var i = 0;
        while a[i] != 0 {
            if a[i] == '/' {
                return true;
            }
            i += 1;
        }
        false
    }
}

fn cstr_less(a: *u8, b: *u8) -> bool {
    unsafe {
        var i = 0;
        while a[i] != 0 && a[i] == b[i] {
            i += 1;
        }
        a[i] < b[i]
    }
}

// The .vl files (0.21: and .vl) under directory dir, into out.
fn tach_files(dir: *u8, out: inout IntVec) -> bool {
    unsafe {
        let args = crate::base::alloc_array::<*u8>(12);
        args[0] = c"find";
        args[1] = dir;
        args[2] = c"-type";
        args[3] = c"f";
        args[4] = c"(";
        args[5] = c"-name";
        args[6] = c"*.vl";
        args[7] = c"-o";
        args[8] = c"-name";
        args[9] = c"*.vl";
        args[10] = c")";
        args[11] = 0 as *u8;
        let listing = buf_new();
        if run_capture(args, listing) != 0 {
            return false;
        }
        let t = buf_slice(listing);
        var i = 0;
        while i < t.len as i64 {
            var e = i;
            while e < t.len as i64 && t[e] != '\n' {
                e += 1;
            }
            if e > i {
                let b = buf_new();
                buf_bytes(b, t[i..e]);
                out.push(buf_cstr(b) as i64);
            }
            i = e + 1;
        }
        true
    }
}

fn fixture(path: *u8) -> bool {
    unsafe {
        let a = c"tests/query/";
        let b = c"tests/refactor/";
        var i = 0;
        while a[i] != 0 && path[i] == a[i] {
            i += 1;
        }
        if a[i] == 0 {
            return true;
        }
        i = 0;
        while b[i] != 0 && path[i] == b[i] {
            i += 1;
        }
        b[i] == 0
    }
}

// `fmt PATH...`: the files and the files under the directories, sorted,
// read into SRC; false after the diagnostic.
fn read_paths(paths: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..paths.count {
            let p = paths.data[k] as *u8;
            let before = files.count;
            if crate::base::is_source_path(p) && !is_dir(p) {
                if crate::front::cpp::directives::file_exists(p, pcx) {
                    files.push(p as i64);
                }
            } else if is_dir(p) {
                tach_files(p, &files);
                var kept = before;
                for j in before..files.count {
                    if !(tcx.fmt_all && fixture(files.data[j] as *u8)) {
                        files.data[kept] = files.data[j];
                        kept += 1;
                    }
                }
                files.count = kept;
            }
            if files.count == before {
                let d = diag(c"error", c"fmt.no-file", &tcx);
                buf_str(d, c"no .vl file at '");
                buf_str(d, p);
                buf_str(d, c"'\n");
                return false;
            }
        }
        for k in 1..files.count {
            var j = k;
            while j > 0 && cstr_less(files.data[j] as *u8, files.data[j - 1] as *u8) {
                let t = files.data[j];
                files.data[j] = files.data[j - 1];
                files.data[j - 1] = t;
                j -= 1;
            }
        }
        init_lexer(&pcx);
        load_sources(files.data as **u8, files.count, &pcx);
        true
    }
}

// Where formatting file f failed: `FILE:LINE: why`.
fn put_failure(d: i64, f: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    buf_bytes(d, file_text(f, pcx));
    buf_byte(d, ':');
    buf_int(d, line_of(SRC[pcx.files[f].start..pcx.files[f].end], tcx.bad_at));
    buf_str(d, c": ");
    buf_bytes(d, BAD_MESSAGE);
}

fn try_fmt(option: *u8, f: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let o = try_begin(c"fmt", c_slice(c""), false, &tcx, pcx);
    if option != 0 as *u8 {
        buf_byte(o, ' ');
        buf_str(o, option);
    }
    put_word(o, file_text(f, pcx));
    try_end(o);
}

// (0.25.2, feedbacks/galaga.md #8) `fmt --changed`: the .vl files changed
// since git's HEAD (in the work tree or the index) and the new ones git
// does not track (and does not ignore); `--since REV`: changed since REV.
// So a focused branch formats what it touched, not the files `--all`
// would find untidy elsewhere. Paths relative to the current directory,
// into paths, the transcript tests' programs left out (as by --all);
// false after the diagnostic when git cannot tell.
fn changed_vl_files(rev: *u8, paths: inout IntVec, tcx: inout Tcx<Comp>) -> bool {
    let listing = buf_new();
    let others = buf_new();
    if git_paths(rev, listing) != 0 || git_paths(0 as *u8, others) != 0 {
        let d = diag(c"error", c"fmt.no-git", &tcx);
        buf_str(d, c"git cannot tell which files changed since ");
        buf_str(d, rev);
        buf_str(d, c": no checkout here, or no such revision\n");
        return false;
    }
    add_vl_paths(buf_slice(listing), &paths);
    add_vl_paths(buf_slice(others), &paths);
    true
}

// `git diff --name-only --relative REV` (not the deleted files), or with
// rev 0 `git ls-files --others --exclude-standard`, NUL-separated, into
// out; git's exit status.
fn git_paths(rev: *u8, out: i64) -> i64 {
    let args = crate::base::alloc_array::<*u8>(9);
    let words: [*u8; 8] = if rev != 0 as *u8 {
        [c"git", c"diff", c"--name-only", c"--relative", c"--diff-filter=d", c"-z", rev, c"--"]
    } else {
        [c"git", c"ls-files", c"-z", c"--others", c"--exclude-standard", c"--", 0 as *u8,
            0 as *u8]
    };
    for k in 0..8 {
        // UNSAFE: run_capture takes a C argv, a raw array of C strings that a
        // null ends.
        // SAFETY: args has 9 zeroed slots; k < 8 is written, slot 8 stays
        // null.
        unsafe { args[k] = words[k]; }
    }
    crate::tools::proc::run_capture(args, out)
}

// The .vl paths of NUL-separated listing t, but the transcript tests'.
fn add_vl_paths(t: [u8], paths: inout IntVec) {
    var i = 0;
    while i < t.len as i64 {
        var e = i;
        while e < t.len as i64 && t[e] != 0 {
            e += 1;
        }
        let p = t[i..e];
        if p.len > 3 && p[p.len as i64 - 3..] == ".vl" {
            let b = buf_new();
            buf_bytes(b, p);
            let c = crate::tools::proc::buf_cstr(b);
            if !fixture(c) {
                paths.push(c as i64);
            }
        }
        i = e + 1;
    }
}

// `fmt`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn fmt_leaf(gpa: Gpa) -> Leaf<Gpa> {
    var table = edit_opts(gpa);
    table.push(flag("check", "only say which files are not laid out"));
    table.push(flag("all", "the tree: compiler, tests, examples, bench"));
    table.push(flag("changed", "the .vl files changed since git's HEAD"));
    table.push(option("since", "REV", "the .vl files changed since REV"));
    Leaf::new(table, "path")
}

fn run_fmt_inner(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>, wgx: inout WgslCx<Arena>) -> i64 {
    set_command(c.line, &tcx);
    pcx.prog = c.prog();
    tcx.tool = 0 as *u8;
    tcx.format_edits = false;
    var root = 0 as *u8;
    var check = false;
    var paths = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var module = 0 as *u8;
    for e in c.evs.iter() {
        var ev = e;
        let a = ev.value;
        if ev.kind == EV_FLAG && ev.name == "check" {
            check = true;
        } else if ev.kind == EV_FLAG && ev.name == "all" {
            tcx.fmt_all = true;
            let dirs = [c"compiler", c"tests", c"examples", c"bench", c"tools"];
            for k in 0..5 {
                if is_dir(dirs[k]) {
                    paths.push(dirs[k] as i64);
                }
            }
        } else if (ev.kind == EV_FLAG && ev.name == "changed") || is_opt(ev, "since") {
            // (0.25.2) what git says changed, since HEAD or REV
            let rev = if ev.kind == EV_FLAG { c"HEAD" } else { a };
            if !changed_vl_files(rev, &paths, &tcx) {
                return 1;
            }
            if paths.count == 0 {
                let d = diag(c"note", c"fmt.none", &tcx);
                buf_str(d, c"no .vl file changed since ");
                buf_str(d, rev);
                buf_byte(d, '\n');
                return 0;
            }
        } else if take_edit_event(&ev, &root, &tcx, &pcx) {
            // (--dry-run, --show, --root ROOT)
        } else if ev.kind != EV_WORD || ev.text.starts_with("-") {
            return usage(c"unknown option", ev.value, &tcx, pcx);
        } else if crate::base::is_source_path(a) || is_dir(a) || has_slash(a) {
            paths.push(a as i64);
        } else if module == 0 as *u8 {
            module = a;
        } else {
            return usage(c"one MODULE (or FILEs and DIRs), not also", a, &tcx, pcx);
        }
    }
    unsafe {
        if paths.count > 0 && module != 0 as *u8 {
            return usage(
                c"FILEs and DIRs, or a MODULE of the program, not both: no file or directory",
                module, &tcx, pcx);
        }
        var chosen = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if paths.count > 0 {
            if !read_paths(paths, &tcx, &pcx) {
                return 1;
            }
            for f in 0..pcx.files.len() as i64 {
                chosen.push(f);
            }
        } else {
            tcx.root_given = root;
            root = root_or_diag(root, c"fmt", c_slice(c""), false, &tcx, pcx);
            if root == 0 as *u8 {
                return 2;
            }
            if !load_program(root, tcx.target, &tcx, &pcx, &wgx) {
                program_errors(c"error", root, true, &tcx, &pcx);
                return 1;
            }
            if module != 0 as *u8 {
                pcx.opt_in = module;
                if !resolve_in(c_slice(module), &tcx, &pcx) {
                    let d = diag(c"error", c"fmt.bad-in", &tcx);
                    put_bad_in(d, module, tcx);
                    try_end(try_begin(c"fmt", c_slice(c""), false, &tcx, pcx));
                    return 1;
                }
            }
            for f in 0..pcx.files.len() as i64 {
                if pcx.files[f].path[0] != '<' && pcx.files[f].kind == SOURCE_VOLE
                    && ref_in(pcx.files[f].start, &pcx) {
                    chosen.push(f);
                }
            }
        }
        return format_files(chosen, check, &tcx, &pcx);
    }
}

// Formats the chosen files (or, `check`, lists those that are not).
fn format_files(chosen: IntVec, check: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var changed = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var failed = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var first_bad = buf_new();
        for k in 0..chosen.count {
            let f = chosen.data[k];
            let text = SRC[pcx.files[f].start..pcx.files[f].end];
            if generated(text) {
                continue;
            }
            let out = buf_new();
            if !format_text(text, 0 as *IntVec, out, &tcx, &pcx) {
                if failed.count == 0 {
                    put_failure(first_bad, f, tcx, pcx);
                }
                failed.push(f);
                continue;
            }
            if !same_bytes(buf_slice(out), text) {
                changed.push(f);
                if !check {
                    edit_replace(pcx.files[f].start, pcx.files[f].end, out, &pcx);
                }
            }
        }
        let n = chosen.count;
        if failed.count > 0 && n == 1 {
            let d = diag(c"error", c"fmt.unreadable", &tcx);
            buf_bytes(d, buf_slice(first_bad));
            buf_str(d, c"; left as it is\n");
            return 1;
        }
        if failed.count > 0 {
            let d = diag(c"note", c"fmt.skipped", &tcx);
            buf_int(d, failed.count);
            buf_str(d, if failed.count == 1 { c" file" } else { c" files" });
            buf_str(d, c" left as they are (not lexed, or unbalanced brackets); first: ");
            buf_bytes(d, buf_slice(first_bad));
            buf_byte(d, '\n');
        }
        if check {
            let list = buf_new();
            for k in 0..changed.count {
                buf_bytes(list, file_text(changed.data[k], pcx));
                buf_byte(list, '\n');
            }
            buf_write_fd(list, STDOUT);
            if changed.count == 0 {
                return 0;
            }
            let d = diag(c"error", c"fmt.unformatted", &tcx);
            buf_int(d, changed.count);
            buf_str(d, c" of ");
            buf_int(d, n);
            buf_str(d,
                if n == 1 { c" file is not formatted\n" } else { c" files are not formatted\n" });
            try_fmt(c"--dry-run", changed.data[0], &tcx, pcx);
            try_fmt(0 as *u8, changed.data[0], &tcx, pcx);
            return 1;
        }
        if changed.count == 0 {
            let d = diag(c"note", c"fmt.none", &tcx);
            buf_int(d, n - failed.count);
            buf_str(d,
                if n - failed.count == 1 { c" file formatted already\n" }
                else { c" files formatted already\n" });
            return 0;
        }
        tcx.skip_check = true;
        apply_edit(c_slice(c"formatted"), pcx.files[changed.data[0]].path, &tcx, &pcx)
    }
}
