// The `use` lines of `volec fmt` (0.13): each run of `use` items (on
// lines of their own, 0.25.1: blank lines between them too, but no
// comment) is written as `fix --only tidy-imports` writes a module's: the
// items with one path (and one `pub`) merged, their names sorted, wrapped
// at 100 columns (tidyimports::put_use_text); and the run's items in
// groups (0.25.1), `std` first, then `crate`, then the rest (`super`,
// `self`, a child module), a blank line between two groups, each sorted
// by path, segment by segment (a `pub use` after a `use` of its path).

use crate::base::{BUFS, IntVec, buf_byte, buf_bytes, buf_new, buf_slice, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::tools::ctx::Tcx;
use crate::tools::fmt::pieces::{FT, kind, piece};
use crate::tools::proc::same_bytes;
use crate::tools::tidyimports::put_use_text;

fn is(i: i64, k: Tok, tcx: Tcx<Comp>) -> bool {
    unsafe { i < tcx.p_kind.count && tcx.p_kind.data[i] == k as i64 }
}

// A `use` item at piece i that has its lines to itself: the piece after
// its `;`, or -1. Its parts go to the U_ vectors.
fn read_use(i: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var j = i;
        let public = is(j, Tok::Pub, tcx);
        if public {
            j += 1;
        }
        if !is(j, Tok::Use, tcx) || !is(j + 1, Tok::Ident, tcx) {
            return -1;
        }
        j += 1;
        let path = j;
        // `a::b::...::`: the path ends at the last `::`
        while is(j, Tok::Ident, tcx) && is(j + 1, Tok::ColonColon, tcx) {
            j += 2;
        }
        if j == path {
            return -1;
        }
        let path_end = j - 1;
        let names = buf_new();
        var list = false;
        if is(j, Tok::LBrace, tcx) {
            list = true;
            j += 1;
        }
        loop {
            if !is(j, Tok::Ident, tcx) {
                return -1;
            }
            let name = j;
            j += 1;
            var alias = -1;
            if is(j, Tok::As, tcx) {
                if !is(j + 1, Tok::Ident, tcx) {
                    return -1;
                }
                alias = j + 1;
                j += 2;
            }
            put_name(names, name, alias, tcx, &pcx);
            if !list {
                break;
            }
            if is(j, Tok::Comma, tcx) {
                j += 1;
            }
            if is(j, Tok::RBrace, tcx) {
                j += 1;
                break;
            }
        }
        if !is(j, Tok::Semi, tcx) {
            return -1;
        }
        j += 1;
        if j < tcx.p_kind.count && tcx.p_nl.data[j] == 0 {
            return -1;
        }
        tcx.uses_u_first.push(i);
        tcx.u_pub.push(if public { 1 } else { 0 });
        tcx.u_path.push(path);
        tcx.u_path_end.push(path_end);
        tcx.u_names.push(names);
        j
    }
}

// A name (and its alias, or -1) as two symbols in buffer b.
fn put_name(b: i64, name: i64, alias: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let n = intern(piece(name, tcx), &pcx);
    let a = if alias >= 0 { intern(piece(alias, tcx), &pcx) } else { 0 };
    for s in 0..8 {
        buf_byte(b, (n >> (8 * s)) as u8);
    }
    for s in 0..8 {
        buf_byte(b, (a >> (8 * s)) as u8);
    }
}

fn word_at(b: [u8], k: i64) -> i64 {
    var v = 0;
    for s in 0..8 {
        v = v | ((b[k + s] as i64) << (8 * s));
    }
    v
}

// The path of item u, as written (`crate::a::b`).
fn path_text(u: i64, tcx: Tcx<Comp>) -> [u8] {
    unsafe { FT[tcx.p_start.data[tcx.u_path.data[u]]..tcx.p_end.data[tcx.u_path_end.data[u] - 1]] }
}

// The group of item u (0.25.1): 0 for a path of `std`, 1 of `crate`, 2
// for the others.
fn use_group(u: i64, tcx: Tcx<Comp>) -> i64 {
    let p = path_text(u, tcx);
    var e = 0;
    while e < p.len as i64 && p[e] != ':' {
        e += 1;
    }
    let root = p[0..e];
    if same_bytes(root, "std") {
        0
    } else if same_bytes(root, "crate") {
        1
    } else {
        2
    }
}

// Whether item u sorts before v: by group, then path, by segments (`::`
// lowest), then a `use` before a `pub use`.
fn use_less(u: i64, v: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        let gu = use_group(u, tcx);
        let gv = use_group(v, tcx);
        if gu != gv {
            return gu < gv;
        }
        let a = path_text(u, tcx);
        let b = path_text(v, tcx);
        let n = if a.len < b.len { a.len as i64 } else { b.len as i64 };
        for i in 0..n {
            let x = if a[i] == ':' { 1 } else { a[i] as i64 };
            let y = if b[i] == ':' { 1 } else { b[i] as i64 };
            if x != y {
                return x < y;
            }
        }
        if a.len != b.len {
            return a.len < b.len;
        }
        tcx.u_pub.data[u] < tcx.u_pub.data[v]
    }
}

fn same_group(u: i64, v: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        tcx.u_pub.data[u] == tcx.u_pub.data[v] && same_bytes(path_text(u, tcx), path_text(v, tcx))
    }
}

// The run's text, tidied, into out (no newline after it).
fn put_run(out: i64, indent: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let n = tcx.uses_u_first.count;
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for u in 0..n {
            order.push(u);
        }
        for k in 1..n {
            var j = k;
            while j > 0 && use_less(order.data[j], order.data[j - 1], tcx) {
                let t = order.data[j];
                order.data[j] = order.data[j - 1];
                order.data[j - 1] = t;
                j -= 1;
            }
        }
        var lines = 0;
        var last_group = -1;
        var k = 0;
        while k < n {
            let u = order.data[k];
            var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var aliased = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            while k < n && same_group(u, order.data[k], tcx) {
                let b = buf_slice(tcx.u_names.data[order.data[k]]);
                var x = 0;
                while x < b.len as i64 {
                    let name = word_at(b, x);
                    let alias = word_at(b, x + 8);
                    if alias != 0 {
                        aliased.push(name);
                        aliased.push(alias);
                    } else {
                        names.push(name);
                    }
                    x += 16;
                }
                k += 1;
            }
            if lines > 0 {
                buf_byte(out, '\n');
                // (a blank line between two groups)
                if use_group(u, tcx) != last_group {
                    buf_byte(out, '\n');
                }
            }
            last_group = use_group(u, tcx);
            put_use_text(out, indent, tcx.u_pub.data[u] != 0, path_text(u, tcx), &names, &aliased,
                pcx);
            lines += 1;
        }
    }
}

// The text with its `use` runs tidied (a new buffer), or -1 when they
// are tidy. Reads the pieces of FT (pieces::read_pieces). With ranges
// (byte offsets of FT, an edit's: format_ranges), only the runs whose
// lines they touch, and `mapped` gets the ranges in the new text, and
// the runs rewritten.
pub fn tidy_uses(ranges: *IntVec, mapped: inout IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let n = tcx.p_kind.count;
        let out = buf_new();
        var copied = 0;
        var depth = 0;
        var old = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var i = 0;
        while i < n {
            let k = kind(i, tcx);
            if (i == 0 || tcx.p_nl.data[i] > 0) && (k == Tok::Use as i64 || k == Tok::Pub as i64) {
                tcx.uses_u_first.count = 0;
                tcx.u_pub.count = 0;
                tcx.u_path.count = 0;
                tcx.u_path_end.count = 0;
                tcx.u_names.count = 0;
                var j = read_use(i, &tcx, &pcx);
                var end = i;
                while j >= 0 {
                    end = j;
                    // (0.25.1: a blank line between two items continues the run)
                    if j >= n || tcx.p_nl.data[j] == 0 {
                        break;
                    }
                    j = read_use(j, &tcx, &pcx);
                }
                if end > i {
                    var s = tcx.p_start.data[i];
                    while s > 0 && FT[s - 1] != '\n' {
                        s -= 1;
                    }
                    let e = tcx.p_end.data[end - 1];
                    let text = buf_new();
                    let indent = buf_new();
                    for d in 0..depth {
                        buf_bytes(indent, "    ");
                    }
                    put_run(text, buf_slice(indent), tcx, pcx);
                    if !same_bytes(buf_slice(text), FT[s..e]) && touches(s, e, ranges) {
                        buf_bytes(out, FT[copied..s]);
                        old.push(s);
                        old.push(e);
                        old.push(BUFS[out].len);
                        buf_bytes(out, buf_slice(text));
                        old.push(BUFS[out].len);
                        copied = e;
                    }
                    i = end;
                    continue;
                }
            }
            if k == Tok::LBrace as i64 {
                depth += 1;
            } else if k == Tok::RBrace as i64 {
                depth -= 1;
            }
            i += 1;
        }
        if old.count == 0 {
            return -1;
        }
        buf_bytes(out, FT[copied..]);
        if ranges != 0 as *IntVec {
            for r in 0..(*ranges).count {
                mapped.push(moved((*ranges).data[r], old));
            }
            var x = 0;
            while x < old.count {
                mapped.push(old.data[x + 2]);
                mapped.push(old.data[x + 3]);
                x += 4;
            }
        }
        out
    }
}

// Whether the lines of FT[s..e) meet a range (all do without ranges).
fn touches(s: i64, e: i64, ranges: *IntVec) -> bool {
    unsafe {
        if ranges == 0 as *IntVec {
            return true;
        }
        var k = 0;
        while k + 1 < (*ranges).count {
            let lo = (*ranges).data[k];
            let hi = (*ranges).data[k + 1];
            let last = if hi > lo { hi - 1 } else { lo };
            if s <= last && lo <= e {
                return true;
            }
            k += 2;
        }
        false
    }
}

// Offset p of FT in the tidied text; `old` holds the runs rewritten (old
// start, old end, new start, new end), in order. A point in a run is its
// new start.
fn moved(p: i64, old: IntVec) -> i64 {
    unsafe {
        var delta = 0;
        var x = 0;
        while x < old.count {
            let os = old.data[x];
            let oe = old.data[x + 1];
            if p >= oe {
                delta = old.data[x + 3] - oe;
            } else if p >= os {
                return old.data[x + 2];
            }
            x += 4;
        }
        p + delta
    }
}
