// `volec same-output OLD [--corpus DIR|FILE]... [-j N] [--work DIR]`
// (0.11; docs/refactor.md): a pure refactoring of the compiler proven to
// change nothing. Every program of the corpus is compiled by OLD and by
// this compiler, for every target both have, at -O0, -O1 and -O2, and the
// outputs are compared byte for byte: the assembly, what the compiler
// printed, and its exit status (tests/compare.sh does this and more, in
// sh).
//
// The corpus: tests/run, examples, bench and compiler/src by default. A
// directory holds programs: its main.vl when that is a module tree's
// root (it has `mod` items), else each of its .vl files and each
// SUB/main.vl. Each comparison runs in a copy of this process (a
// worker), up to -j at once; its outputs go to WORK/N/ and are kept when
// they differ.

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, get_bufs,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{target_name, target_of_name};
use crate::cli::line::{Call, EV_WORD, Leaf, is_opt, option, short_option, table};
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{
    buf_cstr, fork_worker, make_dirs, read_file_if, remove_dir, remove_file, run_capture,
    same_bytes, spawn_to_file, wait_any, worker_exit,
};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::{diag, diags, put_cword, try_end, write_diags};

// `DIR/NAME`.
fn join_path(dir: *mut u8, name: &[u8]) -> *mut u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        if (*get_bufs().add(b as usize)).len > 0
            && (
                *(*get_bufs().add(b as usize)).data.add(
                    ((*get_bufs().add(b as usize)).len - 1) as usize)) != b'/' {
            buf_byte(b, b'/');
        }
        buf_bytes(b, name);
        buf_cstr(b)
    }
}

// Whether file `path` is the root of a module tree (it has a `mod` item).
fn is_tree_root(path: *mut u8) -> bool {
    let text = buf_new();
    if !read_file_if(path, text) {
        return false;
    }
    let t = buf_slice(text);
    let mut i: i64 = 0;
    while i + 4 < t.len() as i64 {
        if (i == 0 || t[(i - 1) as usize] == b'\n') && t[i as usize] == b'm'
            && t[(i + 1) as usize] == b'o' && t[(i + 2) as usize] == b'd'
            && t[(i + 3) as usize] == b' ' {
            return true;
        }
        i += 1;
    }
    false
}

// The programs of corpus entry `entry` (a file, or a directory), into out.
fn add_programs(entry: *mut u8, out: &mut IntVec, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if crate::base::is_source_path(entry) {
            if !file_exists(entry, pcx) {
                return false;
            }
            out.push(entry as i64);
            return true;
        }
        let root = join_path(entry, c_slice(c"main.vl"));
        if file_exists(root, pcx) && is_tree_root(root) {
            out.push(root as i64);
            return true;
        }
        // `ls -1 DIR`: its .vl files, and its directories with a main.vl.
        let args = alloc_array::<*mut u8>(4i64);
        (*args.add(0)) = c"ls";
        (*args.add(1)) = c"-1";
        (*args.add(2)) = entry;
        (*args.add(3)) = 0 as *mut u8;
        let listing = buf_new();
        if run_capture(args, listing) != 0 {
            return false;
        }
        let t = buf_slice(listing);
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            let name = &t[i as usize..e as usize];
            i = e + 1;
            if name.len() == 0 {
                continue;
            }
            let path = join_path(entry, name);
            if crate::base::is_source_path(path) {
                out.push(path as i64);
            } else {
                let sub = join_path(path, c_slice(c"main.vl"));
                if file_exists(sub, pcx) {
                    out.push(sub as i64);
                }
            }
        }
        true
    }
}

// The number of processors (4 when it cannot be told).
fn processors() -> i64 {
    unsafe {
        let args = alloc_array::<*mut u8>(3i64);
        (*args.add(0)) = c"getconf";
        (*args.add(1)) = c"_NPROCESSORS_ONLN";
        (*args.add(2)) = 0 as *mut u8;
        let out = buf_new();
        if run_capture(args, out) != 0 {
            return 4;
        }
        let t = buf_slice(out);
        let mut n: i64 = 0;
        let mut i: i64 = 0;
        while i < t.len() as i64 && t[i as usize] >= b'0' && t[i as usize] <= b'9' {
            n = n * 10 + (t[i as usize] - b'0') as i64;
            i += 1;
        }
        if n < 1 { 4 } else { n }
    }
}

// Whether compiler `cc` has target t (`cc --target T --version` works).
fn has_target(cc: *mut u8, t: i64) -> bool {
    unsafe {
        let args = alloc_array::<*mut u8>(5i64);
        (*args.add(0)) = cc;
        (*args.add(1)) = c"--target";
        (*args.add(2)) = target_name(t);
        (*args.add(3)) = c"--version";
        (*args.add(4)) = 0 as *mut u8;
        let out = buf_new();
        run_capture(args, out) == 0
    }
}

// The directory of compilation j: `WORK/j`.
fn job_dir(j: i64, tcx: &Tcx<Comp>) -> *mut u8 {
    let b = buf_new();
    buf_str(b, tcx.work);
    buf_byte(b, b'/');
    buf_int(b, j);
    buf_cstr(b)
}

fn level_flag(level: i64) -> *mut u8 {
    if level == 0 { c"-O0" } else if level == 1 { c"-O1" } else { c"-O2" }
}

// Compiler `cc` on compilation j, its output in DIR/WHO.s and what it
// printed in DIR/WHO.out; its exit status.
fn compile_one(cc: *mut u8, j: i64, dir: *mut u8, who: *mut u8, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let asm = buf_new();
        buf_str(asm, dir);
        buf_byte(asm, b'/');
        buf_str(asm, who);
        buf_str(asm, c"/out.s");
        let printed = buf_new();
        buf_str(printed, dir);
        buf_byte(printed, b'/');
        buf_str(printed, who);
        buf_str(printed, c".out");
        let sub = buf_new();
        buf_str(sub, dir);
        buf_byte(sub, b'/');
        buf_str(sub, who);
        make_dirs(buf_cstr(sub));
        let args = alloc_array::<*mut u8>(9i64);
        (*args.add(0)) = cc;
        (*args.add(1)) = c"--target";
        (*args.add(2)) = target_name((tcx.j_target[j as usize]));
        (*args.add(3)) = level_flag((tcx.j_level[j as usize]));
        (*args.add(4)) = (tcx.j_prog[j as usize]) as *mut u8;
        (*args.add(5)) = c"-o";
        (*args.add(6)) = buf_cstr(asm);
        // (0.15: one form of the errors, whatever the default of each:
        // a build whose stderr is not a terminal prints the short form)
        (*args.add(7)) = c"--diagnostics=human";
        (*args.add(8)) = 0 as *mut u8;
        let pid = spawn_to_file(args, buf_cstr(printed));
        if pid < 0 {
            return 127;
        }
        let mut status: i64 = 0;
        while wait_any(&mut status) != pid {
        }
        status
    }
}

// In a worker: compilation j by both compilers, compared. Exit 0: the
// same, 1: different (the outputs stay in WORK/j), 2: not run.
fn run_job(j: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> ! {
    let dir = job_dir(j, tcx);
    make_dirs(dir);
    let a = compile_one(tcx.old, j, dir, c"old", tcx);
    let b = compile_one(pcx.prog, j, dir, c"new", tcx);
    let same = a == b && same_file(dir, c"old/out.s", c"new/out.s")
        && same_printed(dir, tcx, pcx);
    if same {
        remove_file(join_path(dir, c_slice(c"old/out.s")));
        remove_file(join_path(dir, c_slice(c"new/out.s")));
        remove_file(join_path(dir, c_slice(c"old.out")));
        remove_file(join_path(dir, c_slice(c"new.out")));
        remove_dir(join_path(dir, c_slice(c"old")));
        remove_dir(join_path(dir, c_slice(c"new")));
        remove_dir(dir);
        worker_exit(0);
    }
    // (the exit statuses, for the report)
    let st = buf_new();
    buf_int(st, a);
    buf_byte(st, b' ');
    buf_int(st, b);
    buf_byte(st, b'\n');
    crate::tools::proc::write_file_if(join_path(dir, c_slice(c"status")), buf_slice(st));
    worker_exit(1)
}

// Whether DIR/A and DIR/B have the same bytes (both missing: the same).
fn same_file(dir: *mut u8, a: *mut u8, b: *mut u8) -> bool {
    let x = buf_new();
    let y = buf_new();
    let hx = read_file_if(join_path(dir, c_slice(a)), x);
    let hy = read_file_if(join_path(dir, c_slice(b)), y);
    hx == hy && same_bytes(buf_slice(x), buf_slice(y))
}

// (0.25.5, feedbacks/table254.md #3) Whether the two compilers printed the
// same, each one's own path (in a `try:` line, `try: OLD edit patch ...`)
// taken as the other's: DIR/old.out with OLD's path written as this
// compiler's is DIR/new.out.
fn same_printed(dir: *mut u8, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let x = buf_new();
    let y = buf_new();
    let hx = read_file_if(join_path(dir, c_slice(c"old.out")), x);
    let hy = read_file_if(join_path(dir, c_slice(c"new.out")), y);
    if hx != hy {
        return false;
    }
    let old = c_slice(tcx.old);
    let new = c_slice(pcx.prog);
    let t = buf_slice(x);
    if old.len() == 0 || same_bytes(old, new) {
        return same_bytes(t, buf_slice(y));
    }
    let z = buf_new();
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        if i + old.len() as i64 <= t.len() as i64
            && same_bytes(&t[i as usize..(i + old.len() as i64) as usize], old) {
            buf_bytes(z, new);
            i += old.len() as i64;
        } else {
            buf_byte(z, t[i as usize]);
            i += 1;
        }
    }
    same_bytes(buf_slice(z), buf_slice(y))
}

pub fn run_same_output(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let status = run_inner(c, tcx, pcx);
    write_diags(tcx);
    status
}

fn usage(message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"same-output.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let o = diags(tcx);
    buf_str(o, c"try:");
    put_cword(o, pcx.prog);
    buf_str(o, c" same-output path/to/old/volec");
    try_end(o);
    2
}

// OLD as the shell finds it (0.16): a name without a `/` and no file
// here, in the directories of $PATH; else as it is.
fn find_compiler(name: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    unsafe {
        let mut k: i64 = 0;
        while (*name.add(k as usize)) != 0 {
            if (*name.add(k as usize)) == b'/' {
                return name;
            }
            k += 1;
        }
        if file_exists(name, pcx) {
            return name;
        }
        let found = crate::tools::proc::find_in_path(
            std::slice::from_raw_parts(name.add((0) as usize), (k - (0)) as usize), pcx);
        if found == 0 as *mut u8 { name } else { found }
    }
}

// `same-output`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn same_output_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(option("corpus", "DIR", "the programs to compile, again for more"));
    opts.push(short_option("j", "N", "N compilations at once"));
    opts.push(option("work", "DIR", "where the outputs go"));
    Leaf::new(opts, "old")
}

fn run_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    let mut corpus = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut jobs: i64 = 0;
    tcx.work = c"target/same-output";
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if is_opt(ev, "corpus") {
            corpus.push(a as i64);
        } else if is_opt(ev, "j") {
            jobs = crate::tools::query::parse_count(a);
        } else if is_opt(ev, "work") {
            tcx.work = a;
        } else if ev.kind != EV_WORD || ev.text.starts_with("-") {
            return usage(c"unknown option", tcx, pcx);
        } else if tcx.old != 0 as *mut u8 {
            return usage(c"one OLD compiler", tcx, pcx);
        } else {
            tcx.old = find_compiler(a, pcx);
        }
    }
    unsafe {
        if tcx.old == 0 as *mut u8 {
            return usage(c"same-output needs the OLD compiler to compare with", tcx, pcx);
        }
        if !file_exists(tcx.old, pcx) {
            let d = diag(c"error", c"same-output.no-compiler", tcx);
            buf_str(d, c"cannot run '");
            buf_str(d, tcx.old);
            buf_str(d, c"'\n");
            return 2;
        }
        let explicit = corpus.len() as i64 > 0;
        if !explicit {
            corpus.push(c"tests/run" as i64);
            corpus.push(c"examples" as i64);
            corpus.push(c"bench" as i64);
            corpus.push(c"compiler/src" as i64);
        }
        let mut programs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..corpus.len() as i64 {
            let e = (corpus[k as usize]) as *mut u8;
            if !add_programs(e, &mut programs, pcx) && explicit {
                let d = diag(c"error", c"same-output.no-corpus", tcx);
                buf_str(d, c"cannot read '");
                buf_str(d, e);
                buf_str(d, c"'\n");
                return 2;
            }
        }
        if programs.len() as i64 == 0 {
            let d = diag(c"error", c"same-output.no-corpus", tcx);
            buf_str(d,
                c"no programs (tests/run, examples, bench, compiler/src; or --corpus DIR)\n");
            return 2;
        }
        // The targets: this compiler's, the ones OLD has too.
        let mut targets = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for t in 1..16 {
            if target_of_name(target_name(t)) != t {
                continue;
            }
            if has_target(tcx.old, t) {
                targets.push(t);
            } else {
                let d = diag(c"note", c"same-output.target", tcx);
                buf_str(d, tcx.old);
                buf_str(d, c" has no target ");
                buf_str(d, target_name(t));
                buf_str(d, c"; not compared\n");
            }
        }
        if targets.len() as i64 == 0 {
            let d = diag(c"error", c"same-output.no-compiler", tcx);
            buf_str(d, tcx.old);
            buf_str(d, c" compiles for none of this compiler's targets\n");
            return 2;
        }
        for p in 0..programs.len() as i64 {
            for t in 0..targets.len() as i64 {
                for level in 0..3 {
                    tcx.j_prog.push((programs[p as usize]));
                    tcx.j_target.push((targets[t as usize]));
                    tcx.j_level.push(level);
                    tcx.j_result.push(-1);
                }
            }
        }
        if !make_dirs(tcx.work) {
            let d = diag(c"error", c"same-output.work", tcx);
            buf_str(d, c"cannot make '");
            buf_str(d, tcx.work);
            buf_str(d, c"'\n");
            return 2;
        }
        if jobs <= 0 {
            jobs = processors();
        }
        // The workers: up to `jobs` at once.
        let total = tcx.j_prog.len() as i64;
        let pids = alloc_array::<i64>(total + 1);
        let mut next: i64 = 0;
        let mut running: i64 = 0;
        while next < total || running > 0 {
            while next < total && running < jobs {
                let pid = fork_worker();
                if pid == 0 {
                    run_job(next, tcx, pcx);
                }
                if pid < 0 {
                    (tcx.j_result[next as usize]) = 2;
                } else {
                    (*pids.add(next as usize)) = pid;
                    running += 1;
                }
                next += 1;
            }
            let mut status: i64 = 0;
            let pid = wait_any(&mut status);
            if pid < 0 {
                break;
            }
            running -= 1;
            for j in 0..next {
                if (*pids.add(j as usize)) == pid && (tcx.j_result[j as usize]) < 0 {
                    (tcx.j_result[j as usize]) = status;
                    break;
                }
            }
        }
        report(programs.len() as i64, targets.len() as i64, tcx, pcx)
    }
}

// The summary: `identical<TAB>N compilations...`, or the differences (each
// `PROGRAM<TAB>TARGET<TAB>-ON<TAB>WHAT`, at most 10), the first one's
// first differing line, and the error.
fn report(programs: i64, targets: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let total = tcx.j_prog.len() as i64;
    let out = buf_new();
    let mut differ = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut failed: i64 = 0;
    for j in 0..total {
        if (tcx.j_result[j as usize]) == 1 {
            differ.push(j);
        } else if (tcx.j_result[j as usize]) != 0 {
            failed += 1;
        }
    }
    if differ.len() as i64 == 0 && failed == 0 {
        buf_str(out, c"identical\t");
        buf_int(out, total);
        buf_str(out, c" compilations\t");
        buf_int(out, programs);
        buf_str(out, c" programs\t");
        buf_int(out, targets);
        buf_str(out, if targets == 1 { c" target" } else { c" targets" });
        buf_str(out, c"\t-O0 -O1 -O2\n");
        buf_write_fd(out, STDOUT);
        return 0;
    }
    for k in 0..differ.len() as i64 {
        if k == 10 {
            break;
        }
        let j = (differ[k as usize]);
        buf_str(out, (tcx.j_prog[j as usize]) as *mut u8);
        buf_byte(out, b'\t');
        buf_str(out, target_name((tcx.j_target[j as usize])));
        buf_byte(out, b'\t');
        buf_str(out, level_flag((tcx.j_level[j as usize])));
        buf_byte(out, b'\t');
        put_difference(out, j, k == 0, tcx);
    }
    buf_write_fd(out, STDOUT);
    if failed > 0 {
        let d = diag(c"warning", c"same-output.not-run", tcx);
        buf_int(d, failed);
        buf_str(d, c" compilations could not be run\n");
    }
    if differ.len() as i64 == 0 {
        return 1;
    }
    let first = (differ[0]);
    let d = diag(c"error", c"same-output.differs", tcx);
    buf_int(d, differ.len() as i64);
    buf_str(d, c" of ");
    buf_int(d, total);
    buf_str(d, c" compilations differ (kept in ");
    buf_str(d, tcx.work);
    buf_str(d, c")\n");
    let dir = job_dir(first, tcx);
    let o = diags(tcx);
    let asm_differs = !same_file(dir, c"old/out.s", c"new/out.s");
    buf_str(o, c"try: diff");
    put_cword(o, join_path(dir, c_slice(if asm_differs { c"old/out.s" } else { c"old.out" })));
    put_cword(o, join_path(dir, c_slice(if asm_differs { c"new/out.s" } else { c"new.out" })));
    try_end(o);
    let o2 = diags(tcx);
    buf_str(o2, c"try:");
    put_cword(o2, pcx.prog);
    buf_str(o2, c" --target ");
    buf_str(o2, target_name((tcx.j_target[first as usize])));
    buf_byte(o2, b' ');
    buf_str(o2, level_flag((tcx.j_level[first as usize])));
    put_cword(o2, (tcx.j_prog[first as usize]) as *mut u8);
    buf_str(o2, c" -o new.s");
    try_end(o2);
    1
}

// What differs in compilation j (`exit A B`, `output`, `asm line N`), and
// for the first one the two lines (`-<TAB>old`, `+<TAB>new`).
fn put_difference(out: i64, j: i64, lines: bool, tcx: &Tcx<Comp>) {
    let dir = job_dir(j, tcx);
    let st = buf_new();
    read_file_if(join_path(dir, c_slice(c"status")), st);
    let s = buf_slice(st);
    let mut k: i64 = 0;
    while k < s.len() as i64 && s[k as usize] != b' ' {
        k += 1;
    }
    let same_status = k < s.len() as i64
        && same_bytes(&s[0..k as usize], &s[(k + 1) as usize..(s.len() as i64 - 1) as usize]);
    if !same_status {
        buf_str(out, c"exit ");
        buf_bytes(out, if s.len() > 0 { &s[0..(s.len() as i64 - 1) as usize] } else { s });
        buf_byte(out, b'\n');
        return;
    }
    let asm = !same_file(dir, c"old/out.s", c"new/out.s");
    let a = buf_new();
    let b = buf_new();
    read_file_if(join_path(dir, c_slice(if asm { c"old/out.s" } else { c"old.out" })), a);
    read_file_if(join_path(dir, c_slice(if asm { c"new/out.s" } else { c"new.out" })), b);
    let x = buf_slice(a);
    let y = buf_slice(b);
    // The first differing line.
    let mut i: i64 = 0;
    let mut line: i64 = 1;
    let mut start: i64 = 0;
    while i < x.len() as i64 && i < y.len() as i64 && x[i as usize] == y[i as usize] {
        if x[i as usize] == b'\n' {
            line += 1;
            start = i + 1;
        }
        i += 1;
    }
    buf_str(out, if asm { c"asm line " } else { c"output line " });
    buf_int(out, line);
    buf_byte(out, b'\n');
    if lines {
        buf_str(out, c"-\t");
        put_line_at(out, x, start);
        buf_str(out, c"+\t");
        put_line_at(out, y, start);
    }
}

// The line of text starting at `start` (cut to 100 bytes), and a newline.
fn put_line_at(out: i64, text: &[u8], start: i64) {
    if start >= text.len() as i64 {
        buf_str(out, c"(end of file)\n");
        return;
    }
    let mut e = start;
    while e < text.len() as i64 && text[e as usize] != b'\n' && e - start < 100 {
        e += 1;
    }
    buf_bytes(out, &text[start as usize..e as usize]);
    buf_byte(out, b'\n');
}
