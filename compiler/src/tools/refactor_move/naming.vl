// The names of a split's parts (0.13): each part is named after what its
// items share, the reason printed by `split --plan`:
//
//   banner   the banner most of its lines are under (`// ---- Scaling
//            ----`: scaling)
//   type     the type most of its lines operate on: a struct, enum or
//            trait of the part (with its impl blocks), or the type of the
//            first parameter of its functions (`Liveness`: liveness)
//   prefix   the first word most of its items' names start with (emit_)
//   suffix   the last word most of its items' names end with (_imports)
//
// The candidate covering the most of the part's lines wins (at least a
// third of them; on a tie, in that order), when its name is an
// identifier MODULE does not have and no part before took; else `partK`.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, get_bufs, get_src, intern,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::modules::{child_module, module_at, module_count};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::items::after_line;
use crate::tools::query::c_slice;
use crate::tools::query::defs::{K_ENUM, K_FN, K_STRUCT, K_TRAIT, mod_fqn_text};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::refactor_mod::{comment_line, item_binding, region_name, use_binding};
use crate::tools::refactor_mod::cli::is_ident;

const C_BANNER: i64 = 1;
const C_TYPE: i64 = 2;
const C_PREFIX: i64 = 3;
const C_SUFFIX: i64 = 4;

// A name for part g of module m (the k-th part), the reason into buffer
// why: items holds the units of the module's items, lines their lines
// (with their impl blocks), group the part of each.
pub fn part_name(m: i64, g: i64, group: *mut i64, items: IntVec, lines: *mut i64, n: i64,
    taken: IntVec, k: i64, why: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        collect(g, group, items, lines, n, tcx, pcx);
        let best = best_candidate(m, taken, tcx, pcx);
        if best < 0 {
            let b = buf_new();
            buf_str(b, c"part");
            buf_int(b, k + 1);
            buf_str(why, c"no banner, type, prefix or suffix shared by a third of its lines");
            return intern(buf_slice(b), pcx);
        }
        let kind = (*tcx.c_kind.data.add(best as usize));
        let from = (*tcx.c_from.data.add(best as usize));
        if kind == C_BANNER {
            buf_str(why, c"banner '");
            buf_bytes(why, banner_line(from, pcx));
            buf_str(why, c"'");
        } else if kind == C_TYPE {
            buf_str(why, c"type ");
            buf_bytes(why, sym_text(from, pcx));
        } else if kind == C_PREFIX {
            buf_str(why, c"prefix ");
            buf_bytes(why, sym_text(from, pcx));
            buf_byte(why, b'_');
        } else {
            buf_str(why, c"suffix _");
            buf_bytes(why, sym_text(from, pcx));
        }
        buf_str(why, c": ");
        buf_int(why, (*tcx.c_items.data.add(best as usize)));
        buf_str(why, c" of ");
        buf_int(why, tcx.c_count);
        buf_str(why, if tcx.c_count == 1 { c" item, " } else { c" items, " });
        buf_int(why, (*tcx.c_lines.data.add(best as usize)));
        buf_str(why, c" of ");
        buf_int(why, tcx.c_total);
        buf_str(why, c" lines");
        (*tcx.c_name.data.add(best as usize))
    }
}

// How well part g can be named (per mille of its lines its best name
// covers, names taken or not): the parts are named best first, so that a
// part does not take the name another fits better.
pub fn part_score(m: i64, g: i64, group: *mut i64, items: IntVec, lines: *mut i64, n: i64,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        collect(g, group, items, lines, n, tcx, pcx);
        let none = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let best = best_candidate(m, none, tcx, pcx);
        if best < 0 || tcx.c_total == 0 { 0 }
        else { (*tcx.c_lines.data.add(best as usize)) * 1000 / tcx.c_total }
    }
}

// The candidates of part g, with its lines (C_TOTAL) and items (C_COUNT).
fn collect(g: i64, group: *mut i64, items: IntVec, lines: *mut i64, n: i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        tcx.c_kind.clear();
        tcx.c_name.clear();
        tcx.c_from.clear();
        tcx.c_lines.clear();
        tcx.c_items.clear();
        tcx.c_total = 0;
        tcx.c_count = 0;
        for i in 0..n {
            if (*group.add(i as usize)) != g {
                continue;
            }
            let u = (*items.data.add(i as usize));
            let d = (*tcx.un_def.data.add(u as usize));
            let l = (*lines.add(i as usize));
            tcx.c_total += l;
            tcx.c_count += 1;
            let b = group_banner(u, tcx);
            if b >= 0 {
                let name = banner_name(b, pcx);
                if name >= 0 {
                    add_candidate(C_BANNER, name, b, l, tcx);
                }
            }
            let t = operand_type(d, tcx, pcx);
            if t >= 0 {
                add_candidate(C_TYPE, snake(sym_text(t, pcx), pcx), t, l, tcx);
            }
            let s = sym_text(pcx.defs[d as usize].name, pcx);
            let first = word_at(s, true, pcx);
            if first >= 0 {
                add_candidate(C_PREFIX, first, first, l, tcx);
            }
            let last = word_at(s, false, pcx);
            if last >= 0 && last != first {
                add_candidate(C_SUFFIX, last, last, l, tcx);
            }
        }
    }
}

// The best candidate whose name is free: the most lines (at least a third
// of the part's), then the kind's order; a prefix or suffix of two items
// or more. -1 for none.
fn best_candidate(m: i64, taken: IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut best: i64 = -1;
        for c in 0..tcx.c_kind.count {
            if (*tcx.c_lines.data.add(c as usize)) * 3 < tcx.c_total
                || !free_name(m, (*tcx.c_name.data.add(c as usize)), taken, tcx, pcx) {
                continue;
            }
            if ((*tcx.c_kind.data.add(c as usize)) == C_PREFIX
                || (*tcx.c_kind.data.add(c as usize)) == C_SUFFIX)
                && (*tcx.c_items.data.add(c as usize)) < 2 {
                continue;
            }
            if best < 0
                || (*tcx.c_lines.data.add(c as usize)) > (*tcx.c_lines.data.add(best as usize))
                || ((*tcx.c_lines.data.add(c as usize)) == (*tcx.c_lines.data.add(best as usize))
                    && (*tcx.c_kind.data.add(c as usize)) < (*tcx.c_kind.data.add(best as usize))) {
                best = c;
            }
        }
        best
    }
}

// The names of --names (a,b,c) into out, for the `parts` parts that
// leave m, in order (fewer: the others are found); false after a
// diagnostic.
pub fn names_given(m: i64, out: &mut IntVec, parts: i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let s = c_slice(tcx.cli_opt_names);
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let mut e = i;
        while e < s.len() as i64 && s[e as usize] != b',' {
            e += 1;
        }
        let w = &s[i as usize..e as usize];
        i = e + 1;
        if w.len() == 0 {
            continue;
        }
        let name = intern(w, pcx);
        if !free_name(m, name, *out, tcx, pcx) {
            let d = diag(c"error", c"refactor.collision", tcx);
            buf_str(d, c"--names: '");
            buf_bytes(d, w);
            buf_str(d, c"' is not an identifier, or a name ");
            buf_bytes(d, mod_fqn_text(m, tcx, pcx));
            buf_str(d, c" or another part has\n");
            return false;
        }
        out.push(name);
    }
    if out.count > parts {
        let d = diag(c"error", c"refactor.usage", tcx);
        buf_str(d, c"--names gives ");
        buf_int(d, out.count);
        buf_str(d, c" names for ");
        buf_int(d, parts);
        buf_str(d, if parts == 1 { c" part\n" } else { c" parts\n" });
        let t = try_begin(c"split", mod_fqn_text(m, tcx, pcx), true, tcx, pcx);
        buf_str(t, c" --plan --max-lines ");
        buf_int(t, tcx.opt_max_lines);
        try_end(t);
        return false;
    }
    true
}

// Whether `name` can name a new child of m: an identifier, not a name m
// has (nor m's own: `gen::gen`), nor one a part before took.
pub fn free_name(m: i64, name: i64, taken: IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !is_ident(sym_text(name, pcx)) || item_binding(m, name, tcx) >= 0
            || use_binding(m, name, pcx) >= 0
            || child_module(m, name, pcx) >= 0 || name == region_name(m, tcx, pcx) {
            return false;
        }
        for j in 0..taken.count {
            if (*taken.data.add(j as usize)) == name {
                return false;
            }
        }
        true
    }
}

// Adds l lines of an item to candidate (kind, name).
fn add_candidate(kind: i64, name: i64, from: i64, l: i64, tcx: &mut Tcx<Comp>) {
    unsafe {
        for c in 0..tcx.c_kind.count {
            if (*tcx.c_kind.data.add(c as usize)) == kind
                && (*tcx.c_from.data.add(c as usize)) == from {
                (*tcx.c_lines.data.add(c as usize)) += l;
                (*tcx.c_items.data.add(c as usize)) += 1;
                return;
            }
        }
        tcx.c_kind.push(kind);
        tcx.c_name.push(name);
        tcx.c_from.push(from);
        tcx.c_lines.push(l);
        tcx.c_items.push(1);
    }
}

// The banner heading the group of unit u: its start, or -1.
fn group_banner(u: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let f = (*tcx.un_file.data.add(u as usize));
        let mut v = u;
        while v >= 0 && (*tcx.un_file.data.add(v as usize)) == f {
            if (*tcx.un_banner.data.add(v as usize)) >= 0 {
                return (*tcx.un_banner.data.add(v as usize));
            }
            v -= 1;
        }
        -1
    }
}

// The first line of the banner at b, as written (without its indentation
// and line end).
fn banner_line(b: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let mut a = b;
    while get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\t' {
        a += 1;
    }
    let mut e = after_line(a, pcx);
    while e > a
        && (get_src()[(e - 1) as usize] == b'\n' || get_src()[(e - 1) as usize] == b'\r'
            || get_src()[(e - 1) as usize] == b' ') {
        e -= 1;
    }
    &get_src()[a as usize..e as usize]
}

// A name from the banner at b: the words of its first line (its rules
// dropped, up to a `:`, `.`, `(` or `;`) but the small ones, the first
// two joined by `_` (`// ---- Pattern matching ----`: pattern_matching);
// -1 for none.
fn banner_name(b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !comment_line(b) {
        return -1;
    }
    let s = banner_line(b, pcx);
    let out = buf_new();
    let mut words: i64 = 0;
    let mut i: i64 = 2;
    while i < s.len() as i64 && words < 2 {
        let c = s[i as usize];
        if c == b':' || c == b'.' || c == b'(' || c == b';' || c == b',' {
            break;
        }
        if !is_alnum(c) {
            i += 1;
            continue;
        }
        let mut e = i;
        while e < s.len() as i64 && is_alnum(s[e as usize]) {
            e += 1;
        }
        let w = &s[i as usize..e as usize];
        // (`the type's`: the word is `type`)
        if e < s.len() as i64 && s[e as usize] == b'\'' {
            e += 1;
            while e < s.len() as i64 && is_alnum(s[e as usize]) {
                e += 1;
            }
        }
        i = e;
        if w.len() < 2 || small_word(w) || (w[0] >= b'0' && w[0] <= b'9') {
            continue;
        }
        if words > 0 {
            buf_byte(out, b'_');
        }
        for x in 0..w.len() {
            buf_byte(out, lower(w[x]));
        }
        words += 1;
    }
    if words == 0 {
        return -1;
    }
    intern(buf_slice(out), pcx)
}

// The type item d operates on: a struct, enum or trait itself, or the
// named type of a function's first parameter (behind pointers, slices
// and arrays) that is not a primitive nor a one-letter generic; -1.
fn operand_type(d: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let k = pcx.defs[d as usize].kind;
    if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
        return pcx.defs[d as usize].name;
    }
    if k != K_FN {
        return -1;
    }
    let f = pcx.defs[d as usize].node;
    if f <= 0 || pcx.nodes[f as usize].kind != NodeKind::Fn || pcx.nodes[f as usize].count == 0 {
        return -1;
    }
    let mut t = pcx.nodes[child(f, 0, pcx) as usize].b;
    while t > 0
        && (pcx.nodes[t as usize].kind == NodeKind::TyPtr
            || pcx.nodes[t as usize].kind == NodeKind::TySlice
            || pcx.nodes[t as usize].kind == NodeKind::TyArray) {
        t = pcx.nodes[t as usize].a;
    }
    if t <= 0 || pcx.nodes[t as usize].kind != NodeKind::TyName {
        return -1;
    }
    let name = pcx.nodes[t as usize].a;
    let s = sym_text(name, pcx);
    if s.len() < 2 || primitive(s) || general_type(name, tcx, pcx) {
        return -1;
    }
    name
}

// Whether the type named `name` is a general one (a vector, a map: used
// in more than a quarter of the program's modules, and in five or more),
// which names no part: what the items have in common is elsewhere.
fn general_type(name: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let known = tcx.general.get(name + 1);
        if known != 0 {
            return known == 2;
        }
        let mut modules = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut count: i64 = 0;
        for k in 0..tcx.refs.count {
            let r = (*tcx.refs.data.add(k as usize));
            let d = (*tcx.r_def.data.add(r as usize));
            let kind = pcx.defs[d as usize].kind;
            if pcx.defs[d as usize].name != name
                || (kind != K_STRUCT && kind != K_ENUM && kind != K_TRAIT) {
                continue;
            }
            let m = module_at((*tcx.r_pos.data.add(r as usize)), pcx);
            if modules.get(m + 1) == 0 {
                modules.put(m + 1, 1);
                count += 1;
            }
        }
        let general = count >= 5 && count * 4 > module_count(pcx);
        tcx.general.put(name + 1, if general { 2 } else { 1 });
        general
    }
}

// The first (or last) word of a name, lower case: between underscores,
// or at a capital after a small letter; -1 when it is the whole name, a
// small word or shorter than 3.
fn word_at(s: &[u8], first: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let mut a: i64 = 0;
    let mut e = s.len() as i64;
    if first {
        e = 1;
        while e < s.len() as i64 && s[e as usize] != b'_'
            && !(is_upper(s[e as usize]) && !is_upper(s[(e - 1) as usize])) {
            e += 1;
        }
    } else {
        a = s.len() as i64 - 1;
        while a > 0 && s[(a - 1) as usize] != b'_'
            && !(is_upper(s[a as usize]) && !is_upper(s[(a - 1) as usize])) {
            a -= 1;
        }
    }
    if e - a == s.len() as i64 || e - a < 3 {
        return -1;
    }
    let w = &s[a as usize..e as usize];
    if small_word(w) {
        return -1;
    }
    let out = buf_new();
    for x in 0..w.len() {
        if w[x] != b'_' {
            buf_byte(out, lower(w[x]));
        }
    }
    unsafe {
        if (*get_bufs().add(out as usize)).len < 3 {
            return -1;
        }
    }
    intern(buf_slice(out), pcx)
}

// A type's name in snake case: `IntVec` is int_vec, `HMap` hmap.
fn snake(s: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    for i in 0..s.len() as i64 {
        if i > 0 && is_upper(s[i as usize]) && !is_upper(s[(i - 1) as usize])
            && s[(i - 1) as usize] != b'_' {
            buf_byte(out, b'_');
        }
        buf_byte(out, lower(s[i as usize]));
    }
    intern(buf_slice(out), pcx)
}

fn is_alnum(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

fn is_upper(c: u8) -> bool {
    c >= b'A' && c <= b'Z'
}

fn lower(c: u8) -> u8 {
    if is_upper(c) { c + 32 } else { c }
}

// Whether w is a word too small to name a part (case ignored).
fn small_word(w: &[u8]) -> bool {
    in_list(w, c" a an the and or of for from with into to in on at by its it is are be as get put set new run add has all one two this that these those what how when which ")
}

fn primitive(w: &[u8]) -> bool {
    in_list(w, c" i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bool Self ")
}

// Whether w (case ignored) is one of the words of list (` a b `).
fn in_list(w: &[u8], list: *mut u8) -> bool {
    let words = c_slice(list);
    let mut i: i64 = 1;
    while i < words.len() as i64 {
        let mut e = i;
        while e < words.len() as i64 && words[e as usize] != b' ' {
            e += 1;
        }
        if e - i == w.len() as i64 {
            let mut same = true;
            for x in 0..w.len() as i64 {
                if lower(w[x as usize]) != words[(i + x) as usize]
                    && w[x as usize] != words[(i + x) as usize] {
                    same = false;
                }
            }
            if same {
                return true;
            }
        }
        i = e + 1;
    }
    false
}
