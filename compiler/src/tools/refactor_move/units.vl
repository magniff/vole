// The top-level pieces of a file (units), what moves of them (blocks),
// and the plan of a split (made by `refactor split crate::refactor_move
// --auto`, then renamed).

use crate::base::{
    IntVec, get_src, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_at, module_of};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::items::{after_line, blank_line, node_head};
use crate::tools::plan::deps::cluster;
use crate::tools::query::QF_DEF;
use crate::tools::query::defs::{
    K_ENUM, K_IMPL_METHOD, K_METHOD, K_MOD, K_STRUCT, K_TRAIT, mod_fqn_text,
};
use crate::tools::query::diagnostics::{diag, put_cword, try_begin, try_end};
use crate::tools::query::positions::{line_end, line_start, token_at};
use crate::tools::refactor_mod::{
    comment_line, emit_regions, is_new, item_binding, make_module, own_file,
};
use crate::tools::refactor_mod::cli::finish;
use crate::tools::refactor_move::{add_block, in_block, move_edits};
use crate::tools::refactor_move::naming::{names_given, part_name, part_score};
use crate::tools::refactor_move::place::place_ends_group;

// ---- Units: the top-level pieces of a file ----

const U_ITEM: i64 = 1;

const U_IMPL: i64 = 2;

const U_EXTERN: i64 = 3;

pub const U_OTHER: i64 = 4;

pub fn closing(i: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = i;
    while j < pcx.toks.len() as i64 && pcx.toks[j as usize].kind != Tok::Eof {
        let k = pcx.toks[j as usize].kind;
        if k == Tok::LBrace || k == Tok::LParen || k == Tok::LBracket {
            depth += 1;
        } else if k == Tok::RBrace || k == Tok::RParen || k == Tok::RBracket {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
        j += 1;
    }
    j - 1
}

// The units of file f, in order.
pub fn units_of(f: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if tcx.units_done.get(f + 1) != 0 {
        return;
    }
    tcx.units_done.put(f + 1, 1);
    if tcx.def_tok.count == 0 {
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].parent < 0 && pcx.defs[d as usize].kind != K_METHOD
                && pcx.defs[d as usize].kind != K_IMPL_METHOD {
                tcx.def_tok.put(token_at(pcx.defs[d as usize].start, pcx) + 1, d + 1);
            }
        }
    }
    let first_unit = tcx.un_start.count;
    let mut i = token_at(pcx.files[f as usize].start, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Tok::Eof
        && pcx.toks[i as usize].start < pcx.files[f as usize].end {
        let head = i;
        while pcx.toks[i as usize].kind == Tok::Hash && pcx.toks[(i + 1) as usize].kind == Tok::LBracket {
            i = closing(i + 1, pcx) + 1;
        }
        if pcx.toks[i as usize].kind == Tok::Pub {
            i += 1;
        }
        let kw = pcx.toks[i as usize].kind;
        let braced = kw == Tok::Fn || kw == Tok::Struct || kw == Tok::Enum || kw == Tok::Union
            || kw == Tok::Impl || kw == Tok::Trait || kw == Tok::Extern || kw == Tok::Mod
            || kw == Tok::Unsafe;
        let mut j = i;
        let mut depth: i64 = 0;
        loop {
            let k = pcx.toks[j as usize].kind;
            if k == Tok::Eof || pcx.toks[j as usize].start >= pcx.files[f as usize].end {
                j -= 1;
                break;
            }
            if k == Tok::LBrace || k == Tok::LParen || k == Tok::LBracket {
                depth += 1;
            } else if k == Tok::RBrace || k == Tok::RParen || k == Tok::RBracket {
                depth -= 1;
                if depth == 0 && k == Tok::RBrace && braced {
                    break;
                }
            } else if k == Tok::Semi && depth == 0 {
                break;
            }
            j += 1;
        }
        let u = tcx.un_start.count;
        tcx.un_start.push(unit_text_start(f, pcx.toks[head as usize].start, pcx));
        tcx.un_end.push(after_line(pcx.toks[j as usize].end - 1, pcx));
        tcx.un_first.push(head);
        tcx.un_last.push(j);
        tcx.un_file.push(f);
        tcx.un_banner.push(-1);
        tcx.un_dest.push(-1);
        tcx.un_trait.push(-1);
        let m = module_at(pcx.toks[i as usize].start, pcx);
        if kw == Tok::Impl {
            tcx.un_kind.push(U_IMPL);
            impl_names(i, m, tcx, pcx);
        }
        else if kw == Tok::Extern && pcx.toks[(i + 1) as usize].kind == Tok::Str
            && pcx.toks[(i + 2) as usize].kind == Tok::LBrace {
            tcx.un_kind.push(U_EXTERN);
            tcx.un_def.push(-1);
        } else if kw == Tok::Use || kw == Tok::Import || kw == Tok::Mod {
            tcx.un_kind.push(U_OTHER);
            tcx.un_def.push(-1);
        } else {
            let mut d: i64 = -1;
            let mut t = i;
            while t <= j && t <= i + 3 && d < 0 {
                d = tcx.def_tok.get(t + 1) - 1;
                t += 1;
            }
            tcx.un_kind.push(if d >= 0 { U_ITEM } else { U_OTHER });
            tcx.un_def.push(d);
            if d >= 0 {
                tcx.unit_of.put(d + 1, u + 1);
            }
        }
        i = j + 1;
    }
    banners(f, first_unit, tcx, pcx);
}

// The start of the text of an item whose first token is at pos: its line,
// and the comment and attribute lines directly above.
fn unit_text_start(f: i64, pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut first = line_start(pos, pcx);
    while first > pcx.files[f as usize].start {
        let prev = line_start(first - 1, pcx);
        let mut a = prev;
        while a < first - 1 && (get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\t') {
            a += 1;
        }
        let comment = a + 1 < first && get_src()[a as usize] == b'/' && get_src()[(a + 1) as usize] == b'/';
        let attribute = a + 1 < first && get_src()[a as usize] == b'#' && get_src()[(a + 1) as usize] == b'[';
        if !comment && !attribute {
            break;
        }
        first = prev;
    }
    first
}

// The type and the trait of the impl block at token i (`impl`), when they
// are items of module m: UN_DEF and UN_TRAIT.
fn impl_names(i: i64, m: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let mut t = i + 1;
        if pcx.toks[t as usize].kind == Tok::Lt {
            let mut depth: i64 = 0;
            loop {
                let k = pcx.toks[t as usize].kind;
                if k == Tok::Lt {
                    depth += 1;
                } else if k == Tok::Gt {
                    depth -= 1;
                } else if k == Tok::Shr {
                    depth -= 2;
                }
                t += 1;
                if depth <= 0 || k == Tok::LBrace || k == Tok::Eof {
                    break;
                }
            }
        }
        let mut angle: i64 = 0;
        let mut last: i64 = -1;
        let mut tr: i64 = -1;
        while pcx.toks[t as usize].kind != Tok::LBrace && pcx.toks[t as usize].kind != Tok::Eof {
            let k = pcx.toks[t as usize].kind;
            if k == Tok::Lt {
                angle += 1;
            } else if k == Tok::Gt {
                angle -= 1;
            } else if k == Tok::Shr {
                angle -= 2;
            } else if k == Tok::For && angle == 0 {
                tr = last;
                last = -1;
            } else if k == Tok::Ident && angle == 0 {
                last = t;
            }
            t += 1;
        }
        let mut ty: i64 = -1;
        if last >= 0 {
            let d = item_binding(m, pcx.toks[last as usize].value as i64, tcx);
            if d >= 0 && (pcx.defs[d as usize].kind == K_STRUCT || pcx.defs[d as usize].kind == K_ENUM) {
                ty = d;
            }
        }
        tcx.un_def.push(ty);
        if tr >= 0 {
            let d = item_binding(m, pcx.toks[tr as usize].value as i64, tcx);
            if d >= 0 && pcx.defs[d as usize].kind == K_TRAIT {
                (*tcx.un_trait.data.add((tcx.un_trait.count - 1) as usize)) = d;
            }
        }
    }
}

// The banners above the units of file f (from unit `first`): a block of
// comment lines, a blank line after it and one before it (or code), with
// code somewhere before it in the file (the comment at the top of a file
// is the file's).
fn banners(f: i64, first: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let code_start = if first < tcx.un_start.count { pcx.toks[(*tcx.un_first.data.add(first as usize)) as usize].start }
            else { pcx.files[f as usize].end };
        for u in first..tcx.un_start.count {
            let a = (*tcx.un_start.data.add(u as usize));
            if a <= pcx.files[f as usize].start {
                continue;
            }
            let mut q = line_start(a - 1, pcx);
            if !blank_line(q, pcx) {
                continue;
            }
            while q > pcx.files[f as usize].start && blank_line(q, pcx) {
                q = line_start(q - 1, pcx);
            }
            if !comment_line(q) {
                continue;
            }
            let mut cs = q;
            while cs > pcx.files[f as usize].start && comment_line(line_start(cs - 1, pcx)) {
                cs = line_start(cs - 1, pcx);
            }
            if cs < code_start || (u > first && cs < (*tcx.un_end.data.add((u - 1) as usize))) {
                continue;
            }
            (*tcx.un_banner.data.add(u as usize)) = cs;
        }
    }
}

// The unit holding position pos (of a file whose units are made), or -1.
pub fn unit_at(pos: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        for u in 0..tcx.un_start.count {
            if (*tcx.un_start.data.add(u as usize)) <= pos && pos < (*tcx.un_end.data.add(u as usize)) {
                return u;
            }
        }
        -1
    }
}

// The banner above the unit at pos (0.12: a part's header): the start of
// the banner of the group holding it, -1 for none; *end, the end of its
// comment lines.
pub fn banner_above(pos: i64, end: &mut i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut u = unit_at(pos, tcx);
        if u < 0 {
            return -1;
        }
        let f = (*tcx.un_file.data.add(u as usize));
        while u >= 0 && (*tcx.un_file.data.add(u as usize)) == f {
            let b = (*tcx.un_banner.data.add(u as usize));
            if b >= 0 {
                let mut e = b;
                while e < pcx.files[f as usize].end && comment_line(e) {
                    e = after_line(e, pcx);
                }
                *end = e;
                return b;
            }
            u -= 1;
        }
        -1
    }
}

// The blocks of the moves: each item's unit (or its line in an extern
// block), the impl blocks that go with it, the banners. False after a
// diagnostic.
pub fn make_blocks(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for i in 0..tcx.mv_def.count {
            let d = (*tcx.mv_def.data.add(i as usize));
            let f = file_of_pos(pcx.defs[d as usize].start, pcx);
            units_of(f, tcx, pcx);
            let u = tcx.unit_of.get(d + 1) - 1;
            if u >= 0 {
                (*tcx.un_dest.data.add(u as usize)) = (*tcx.mv_dest.data.add(i as usize));
                continue;
            }
            // A function of an extern block.
            let x = unit_at(pcx.defs[d as usize].start, tcx);
            if x < 0 || (*tcx.un_kind.data.add(x as usize)) != U_EXTERN {
                let e = diag(c"error", c"refactor.not-movable", tcx);
                buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
                buf_str(e, c" is not an item of its file that the refactorings know how to move\n");
                return false;
            }
            seen.put(d + 1, (*tcx.mv_dest.data.add(i as usize)) + 1);
        }
        // The extern blocks: whole when all their functions go to one
        // place, else function by function.
        for x in 0..tcx.un_start.count {
            if (*tcx.un_kind.data.add(x as usize)) != U_EXTERN {
                continue;
            }
            let mut dest: i64 = -2;
            let mut all = true;
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d as usize].parent >= 0
                    || pcx.defs[d as usize].start < pcx.toks[(*tcx.un_first.data.add(x as usize)) as usize].start
                    || pcx.defs[d as usize].start > pcx.toks[(*tcx.un_last.data.add(x as usize)) as usize].start {
                    continue;
                }
                let g = seen.get(d + 1) - 1;
                if g < 0 {
                    all = false;
                } else if dest == -2 {
                    dest = g;
                } else if dest != g {
                    all = false;
                }
            }
            if dest == -2 {
                continue;
            }
            if all {
                (*tcx.un_dest.data.add(x as usize)) = dest;
                continue;
            }
            for d in 0..pcx.defs.len() as i64 {
                let g = seen.get(d + 1) - 1;
                if g >= 0 && pcx.defs[d as usize].start >= pcx.toks[(*tcx.un_first.data.add(x as usize)) as usize].start
                    && pcx.defs[d as usize].start <= pcx.toks[(*tcx.un_last.data.add(x as usize)) as usize].start {
                    let f = (*tcx.un_file.data.add(x as usize));
                    let tail = pcx.toks[token_at(pcx.defs[d as usize].end - 1, pcx) as usize].end;
                    add_block(unit_text_start(f, node_head(pcx.defs[d as usize].start, pcx), pcx),
                        after_line(tail - 1, pcx), g, x, -1, tcx);
                }
            }
        }
        // The impl blocks go with their type (or their trait).
        for x in 0..tcx.un_start.count {
            if (*tcx.un_kind.data.add(x as usize)) != U_IMPL || (*tcx.un_dest.data.add(x as usize)) >= 0 {
                continue;
            }
            let ty = (*tcx.un_def.data.add(x as usize));
            let tr = (*tcx.un_trait.data.add(x as usize));
            if tcx.opt_group_impls {
                (*tcx.un_dest.data.add(x as usize)) = group_dest(x, tcx);
            } else if ty >= 0 && !tcx.opt_keep_impls {
                let tu = tcx.unit_of.get(ty + 1) - 1;
                if tu >= 0 && (*tcx.un_dest.data.add(tu as usize)) >= 0 {
                    (*tcx.un_dest.data.add(x as usize)) = (*tcx.un_dest.data.add(tu as usize));
                }
            } else if ty < 0 && tr >= 0 {
                let tu = tcx.unit_of.get(tr + 1) - 1;
                if tu >= 0 && (*tcx.un_dest.data.add(tu as usize)) >= 0 {
                    (*tcx.un_dest.data.add(x as usize)) = (*tcx.un_dest.data.add(tu as usize));
                }
            }
        }
        // The banners (0.12): each goes where most of its group's lines go
        // (it stays when most of them do), with the block of the group's
        // first unit. 0.13: with its whole group (into a new module, the
        // part of a split: most of it, its first unit too), and into the
        // middle of a module (move --after, --before) only where a group
        // ends (it would head the units of another group there): so a move
        // and the move back leave it where it was. 0.14: into a new module
        // without its first unit, when most of the group's units go there
        // too (above the first of them).
        let mut with_unit = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for u in 0..tcx.un_start.count {
            if (*tcx.un_banner.data.add(u as usize)) < 0 {
                continue;
            }
            let mut dests = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut lines = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut units = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let mut v = u;
            while v < tcx.un_start.count && (*tcx.un_file.data.add(v as usize)) == (*tcx.un_file.data.add(u as usize))
                && (v == u || (*tcx.un_banner.data.add(v as usize)) < 0) {
                let mut j: i64 = 0;
                while j < dests.count && (*dests.data.add(j as usize)) != (*tcx.un_dest.data.add(v as usize)) {
                    j += 1;
                }
                if j == dests.count {
                    dests.push((*tcx.un_dest.data.add(v as usize)));
                    lines.push(0);
                    units.push(0);
                }
                (*lines.data.add(j as usize)) += lines_of((*tcx.un_start.data.add(v as usize)), (*tcx.un_end.data.add(v as usize)));
                (*units.data.add(j as usize)) += 1;
                v += 1;
            }
            let mut best: i64 = 0;
            for j in 1..dests.count {
                if (*lines.data.add(j as usize)) > (*lines.data.add(best as usize))
                    || ((*lines.data.add(j as usize)) == (*lines.data.add(best as usize)) && (*dests.data.add(j as usize)) < 0) {
                    best = j;
                }
            }
            let to = (*dests.data.add(best as usize));
            if to < 0 || (dests.count > 1 && !is_new(to, pcx)) || !place_ends_group(tcx, pcx) {
                continue;
            }
            let mut e = (*tcx.un_banner.data.add(u as usize));
            while comment_line(e) {
                e = after_line(e, pcx);
            }
            if (*tcx.un_dest.data.add(u as usize)) == to {
                with_unit.put(u + 1, e + 1);
            } else if is_new(to, pcx) && 2 * (*units.data.add(best as usize)) > v - u {
                add_block((*tcx.un_banner.data.add(u as usize)), e, to, -2, e, tcx);
            }
        }
        // The units that move.
        for u in 0..tcx.un_start.count {
            if (*tcx.un_dest.data.add(u as usize)) < 0 {
                continue;
            }
            let e = with_unit.get(u + 1) - 1;
            let start = if e >= 0 { (*tcx.un_banner.data.add(u as usize)) } else { (*tcx.un_start.data.add(u as usize)) };
            add_block(start, (*tcx.un_end.data.add(u as usize)), (*tcx.un_dest.data.add(u as usize)), -1, e, tcx);
        }
        true
    }
}

// (0.20) --group-impls: where the items of unit x's banner group go (the
// first of them that moves), or -1.
fn group_dest(x: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let mut g = x;
        while g > 0 && (*tcx.un_banner.data.add(g as usize)) < 0 && (*tcx.un_file.data.add((g - 1) as usize)) == (*tcx.un_file.data.add(x as usize)) {
            g -= 1;
        }
        let mut v = g;
        while v < tcx.un_start.count && (*tcx.un_file.data.add(v as usize)) == (*tcx.un_file.data.add(x as usize))
            && (v == g || (*tcx.un_banner.data.add(v as usize)) < 0) {
            if (*tcx.un_kind.data.add(v as usize)) != U_IMPL && (*tcx.un_dest.data.add(v as usize)) >= 0 {
                return (*tcx.un_dest.data.add(v as usize));
            }
            v += 1;
        }
        -1
    }
}

// Where imports go in module m's file: after its last `use` that stays
// (true), or before its first unit that stays.
pub fn import_anchor(m: i64, after: &mut bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let f = own_file(m, pcx);
        let mut last: i64 = -1;
        for u in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[u as usize].kind != NodeKind::Use || module_of(u, pcx) != m
                || file_of_pos(pcx.nodes[u as usize].start, pcx) != f {
                continue;
            }
            let mut gone: i64 = 0;
            for k in 0..pcx.nodes[u as usize].count {
                if tcx.imports_dropped.get(child(u, k, pcx)) != 0 {
                    gone += 1;
                }
            }
            if pcx.nodes[u as usize].count > 0 && gone == pcx.nodes[u as usize].count {
                continue;
            }
            if last < 0 || pcx.nodes[u as usize].start > pcx.nodes[last as usize].start {
                last = u;
            }
        }
        if last >= 0 {
            *after = true;
            return line_end(pcx.nodes[last as usize].end - 1, pcx);
        }
        *after = false;
        units_of(f, tcx, pcx);
        for u in 0..tcx.un_start.count {
            if (*tcx.un_file.data.add(u as usize)) == f && !in_block((*tcx.un_start.data.add(u as usize)), tcx) {
                return if (*tcx.un_banner.data.add(u as usize)) >= 0 { (*tcx.un_banner.data.add(u as usize)) }
                    else { (*tcx.un_start.data.add(u as usize)) };
            }
        }
        pcx.files[f as usize].end
    }
}

// The lines of SRC[a..b).
pub fn lines_of(a: i64, b: i64) -> i64 {
    let mut n: i64 = 0;
    for p in a..b {
        if get_src()[p as usize] == b'\n' {
            n += 1;
        }
    }
    n
}

// The split of module m (file f) into parts: printed as commands
// (--plan), or made (--auto).
pub fn split_plan(m: i64, f: i64, root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let total = lines_of(pcx.files[f as usize].start, pcx.files[f as usize].end);
        let max = tcx.opt_max_lines;
        if total <= max {
            let e = diag(c"note", c"refactor.fits", tcx);
            buf_bytes(e, mod_fqn_text(m, tcx, pcx));
            buf_str(e, c" has ");
            buf_int(e, total);
            buf_str(e, c" lines (at most ");
            buf_int(e, max);
            buf_str(e, c"); nothing to split\n");
            return 0;
        }
        // The items that can move (an impl block counts with its type, or
        // its trait), their lines; what stays (the rest) and its lines.
        let mut items = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let owner = alloc_array::<i64>(tcx.un_start.count + 1);
        for u in 0..tcx.un_start.count {
            (*owner.add(u as usize)) = -1;
            if (*tcx.un_file.data.add(u as usize)) == f && (*tcx.un_kind.data.add(u as usize)) == U_ITEM
                && pcx.defs[(*tcx.un_def.data.add(u as usize)) as usize].kind != K_MOD {
                (*owner.add(u as usize)) = items.count;
                items.push(u);
            }
        }
        let n = items.count;
        let lines = alloc_array::<i64>(n + 1);
        let mut pinned = total;
        for u in 0..tcx.un_start.count {
            if (*tcx.un_file.data.add(u as usize)) != f {
                continue;
            }
            if (*tcx.un_kind.data.add(u as usize)) == U_IMPL {
                let ty = (*tcx.un_def.data.add(u as usize));
                let tr = (*tcx.un_trait.data.add(u as usize));
                let tu: i64 = if ty >= 0 { tcx.unit_of.get(ty + 1) - 1 }
                    else if tr >= 0 { tcx.unit_of.get(tr + 1) - 1 } else { -1 };
                if tu >= 0 && (*owner.add(tu as usize)) >= 0 {
                    (*owner.add(u as usize)) = (*owner.add(tu as usize));
                }
            }
            if (*owner.add(u as usize)) >= 0 {
                let l = lines_of((*tcx.un_start.data.add(u as usize)), (*tcx.un_end.data.add(u as usize)));
                (*lines.add((*owner.add(u as usize)) as usize)) += l;
                pinned -= l;
            }
        }
        // The references between items, and from other modules.
        let weight = alloc_array::<i64>(n * n + 1);
        let outside = alloc_array::<i64>(n + 1);
        for k in 0..tcx.refs.count {
            let r = (*tcx.refs.data.add(k as usize));
            if ((*tcx.r_flags.data.add(r as usize)) & QF_DEF) != 0 {
                continue;
            }
            let tu = unit_at(pcx.defs[(*tcx.r_def.data.add(r as usize)) as usize].start, tcx);
            if tu < 0 || (*owner.add(tu as usize)) < 0 {
                continue;
            }
            let t = (*owner.add(tu as usize));
            let p = (*tcx.r_pos.data.add(r as usize));
            if file_of_pos(p, pcx) != f {
                if module_at(p, pcx) != m {
                    (*outside.add(t as usize)) += 1;
                }
                continue;
            }
            let su = unit_at(p, tcx);
            if su >= 0 && (*owner.add(su as usize)) >= 0 && (*owner.add(su as usize)) != t {
                (*weight.add(((*owner.add(su as usize)) * n + t) as usize)) += 1;
            }
        }
        let mut budget = max - pinned - 20;
        if budget < max / 2 {
            budget = max / 2;
        }
        let group = alloc_array::<i64>(n + 1);
        let size = alloc_array::<i64>(n + 1);
        cluster(weight, lines, n, budget, group, size);
        // The parts, largest first; the one most used from outside stays.
        let mut parts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for g in 0..n {
            if (*size.add(g as usize)) >= 0 {
                let mut k = parts.count;
                parts.push(g);
                while k > 0 && (*size.add((*parts.data.add((k - 1) as usize)) as usize)) < (*size.add(g as usize)) {
                    (*parts.data.add(k as usize)) = (*parts.data.add((k - 1) as usize));
                    k -= 1;
                }
                (*parts.data.add(k as usize)) = g;
            }
        }
        let mut stay: i64 = -1;
        let mut best: i64 = -1;
        for k in 0..parts.count {
            let g = (*parts.data.add(k as usize));
            let mut o: i64 = 0;
            for i in 0..n {
                if (*group.add(i as usize)) == g {
                    o += (*outside.add(i as usize));
                }
            }
            if o > best {
                best = o;
                stay = g;
            }
        }
        // Their names (0.13): --names, else from what their items share.
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut whys = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut given = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if tcx.cli_opt_names != 0 as *mut u8 && !names_given(m, &mut given, parts.count - 1, tcx, pcx) {
            return 2;
        }
        // (the parts --names does not name: the best named first)
        let mut j: i64 = 0;
        let score = alloc_array::<i64>(parts.count + 1);
        for k in 0..parts.count {
            let g = (*parts.data.add(k as usize));
            whys.push(buf_new());
            names.push(-1);
            (*score.add(k as usize)) = -1;
            if g != stay && j < given.count {
                (*names.data.add(k as usize)) = (*given.data.add(j as usize));
                buf_str((*whys.data.add(k as usize)), c"--names");
                j += 1;
            } else if g != stay {
                (*score.add(k as usize)) = part_score(m, g, group, items, lines, n, tcx, pcx);
            }
        }
        loop {
            let mut next: i64 = -1;
            for k in 0..parts.count {
                if (*score.add(k as usize)) >= 0 && (next < 0 || (*score.add(k as usize)) > (*score.add(next as usize))) {
                    next = k;
                }
            }
            if next < 0 {
                break;
            }
            (*score.add(next as usize)) = -1;
            (*names.data.add(next as usize)) = part_name(m, (*parts.data.add(next as usize)), group, items, lines, n, names, next,
                (*whys.data.add(next as usize)), tcx, pcx);
        }
        if tcx.opt_plan {
            let out = buf_new();
            buf_str(out, c"# ");
            buf_bytes(out, mod_fqn_text(m, tcx, pcx));
            buf_byte(out, b'\t');
            buf_int(out, total);
            buf_str(out, c" lines\t");
            buf_int(out, parts.count);
            buf_str(out, c" parts of at most ");
            buf_int(out, max);
            buf_str(out, c" lines\n");
            for k in 0..parts.count {
                let g = (*parts.data.add(k as usize));
                if g == stay {
                    buf_str(out, c" # stays in ");
                    buf_bytes(out, mod_fqn_text(m, tcx, pcx));
                    buf_str(out, c": the part most used from other modules\n");
                    continue;
                }
                buf_str(out, c" # ");
                buf_bytes(out, sym_text((*names.data.add(k as usize)), pcx));
                buf_str(out, c": ");
                buf_bytes(out, buf_slice((*whys.data.add(k as usize))));
                buf_byte(out, b'\n');
                put_cword(out, pcx.prog);
                buf_str(out, c" refactor split ");
                buf_bytes(out, mod_fqn_text(m, tcx, pcx));
                buf_str(out, c" --into ");
                buf_bytes(out, mod_fqn_text(m, tcx, pcx));
                buf_str(out, c"::");
                buf_bytes(out, sym_text((*names.data.add(k as usize)), pcx));
                buf_str(out, c" --items ");
                let mut first = true;
                for i in 0..n {
                    if (*group.add(i as usize)) != g {
                        continue;
                    }
                    if !first {
                        buf_byte(out, b',');
                    }
                    first = false;
                    buf_bytes(out, sym_text(pcx.defs[(*tcx.un_def.data.add((*items.data.add(i as usize)) as usize)) as usize].name, pcx));
                }
                if tcx.root_given != 0 as *mut u8 {
                    crate::tools::query::diagnostics::put_root(out, tcx);
                }
                buf_byte(out, b'\n');
            }
            // (the out buffer starts with a space before each command)
            buf_write_fd(trim_lines(out), STDOUT);
            let e = diag(c"note", c"refactor.plan", tcx);
            buf_str(e, c"the same in one edit: --auto (other names: --names a,b)\n");
            let t = try_begin(c"split", mod_fqn_text(m, tcx, pcx), true, tcx, pcx);
            buf_str(t, c" --auto --max-lines ");
            buf_int(t, max);
            try_end(t);
            return 0;
        }
        // --auto: the parts, made.
        let mut converts = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut made: i64 = 0;
        for k in 0..parts.count {
            let g = (*parts.data.add(k as usize));
            if g == stay {
                continue;
            }
            let r = make_module(m, (*names.data.add(k as usize)), false, &mut converts, tcx, pcx);
            if r < 0 {
                return 1;
            }
            made += 1;
            for i in 0..n {
                if (*group.add(i as usize)) == g {
                    tcx.mv_def.push((*tcx.un_def.data.add((*items.data.add(i as usize)) as usize)));
                    tcx.mv_dest.push(r);
                }
            }
        }
        if !move_edits(tcx, pcx) {
            return 1;
        }
        emit_regions(tcx, pcx);
        let what = buf_new();
        buf_str(what, c"split ");
        buf_bytes(what, mod_fqn_text(m, tcx, pcx));
        buf_str(what, c" into ");
        buf_int(what, made);
        buf_str(what, if made == 1 { c" module" } else { c" modules" });
        finish(what, root, tcx, pcx)
    }
}

// The lines of buffer b without the space put_cword puts first.
fn trim_lines(b: i64) -> i64 {
    let s = buf_slice(b);
    let out = buf_new();
    let mut i: i64 = 0;
    let mut start = true;
    while i < s.len() as i64 {
        if !(start && s[i as usize] == b' ') {
            buf_byte(out, s[i as usize]);
        }
        start = s[i as usize] == b'\n';
        i += 1;
    }
    out
}
