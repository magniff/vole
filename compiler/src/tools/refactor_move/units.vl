// The top-level pieces of a file (units), what moves of them (blocks),
// and the plan of a split (made by `refactor split crate::refactor_move
// --auto`, then renamed).

use crate::base::{
    IntVec, SRC, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_at, module_of};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::items::{after_line, blank_line, node_head};
use crate::tools::plan::deps::cluster;
use crate::tools::query::QF_DEF;
use crate::tools::query::defs::{
    K_ENUM, K_IMPL_METHOD, K_METHOD, K_MOD, K_STRUCT, K_TRAIT, mod_fqn_text,
};
use crate::tools::query::diagnostics::{diag, put_cword, try_begin, try_end};
use crate::tools::query::positions::{line_end, line_start, token_at};
use crate::tools::refactor_mod::{
    comment_line, emit_regions, is_new, item_binding, make_module, own_file,
};
use crate::tools::refactor_mod::cli::finish;
use crate::tools::refactor_move::{add_block, in_block, move_edits};
use crate::tools::refactor_move::naming::{names_given, part_name, part_score};
use crate::tools::refactor_move::place::place_ends_group;

// ---- Units: the top-level pieces of a file ----

const U_ITEM: i64 = 1;

const U_IMPL: i64 = 2;

const U_EXTERN: i64 = 3;

pub const U_OTHER: i64 = 4;

pub fn closing(i: i64, pcx: Ctx<Comp>) -> i64 {
    var depth = 0;
    var j = i;
    while j < pcx.toks.len() as i64 && pcx.toks[j].kind != Tok::Eof {
        let k = pcx.toks[j].kind;
        if k == Tok::LBrace || k == Tok::LParen || k == Tok::LBracket {
            depth += 1;
        } else if k == Tok::RBrace || k == Tok::RParen || k == Tok::RBracket {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
        j += 1;
    }
    j - 1
}

// The units of file f, in order.
pub fn units_of(f: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if tcx.units_done.get(f + 1) != 0 {
        return;
    }
    tcx.units_done.put(f + 1, 1);
    if tcx.def_tok.count == 0 {
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d].parent < 0 && pcx.defs[d].kind != K_METHOD
                && pcx.defs[d].kind != K_IMPL_METHOD {
                tcx.def_tok.put(token_at(pcx.defs[d].start, pcx) + 1, d + 1);
            }
        }
    }
    let first_unit = tcx.un_start.count;
    var i = token_at(pcx.files[f].start, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i].kind != Tok::Eof
        && pcx.toks[i].start < pcx.files[f].end {
        let head = i;
        while pcx.toks[i].kind == Tok::Hash && pcx.toks[i + 1].kind == Tok::LBracket {
            i = closing(i + 1, pcx) + 1;
        }
        if pcx.toks[i].kind == Tok::Pub {
            i += 1;
        }
        let kw = pcx.toks[i].kind;
        let braced = kw == Tok::Fn || kw == Tok::Struct || kw == Tok::Enum || kw == Tok::Union
            || kw == Tok::Impl || kw == Tok::Trait || kw == Tok::Extern || kw == Tok::Mod
            || kw == Tok::Unsafe;
        var j = i;
        var depth = 0;
        loop {
            let k = pcx.toks[j].kind;
            if k == Tok::Eof || pcx.toks[j].start >= pcx.files[f].end {
                j -= 1;
                break;
            }
            if k == Tok::LBrace || k == Tok::LParen || k == Tok::LBracket {
                depth += 1;
            } else if k == Tok::RBrace || k == Tok::RParen || k == Tok::RBracket {
                depth -= 1;
                if depth == 0 && k == Tok::RBrace && braced {
                    break;
                }
            } else if k == Tok::Semi && depth == 0 {
                break;
            }
            j += 1;
        }
        let u = tcx.un_start.count;
        tcx.un_start.push(unit_text_start(f, pcx.toks[head].start, pcx));
        tcx.un_end.push(after_line(pcx.toks[j].end - 1, pcx));
        tcx.un_first.push(head);
        tcx.un_last.push(j);
        tcx.un_file.push(f);
        tcx.un_banner.push(-1);
        tcx.un_dest.push(-1);
        tcx.un_trait.push(-1);
        let m = module_at(pcx.toks[i].start, &pcx);
        if kw == Tok::Impl {
            tcx.un_kind.push(U_IMPL);
            impl_names(i, m, &tcx, pcx);
        }
        else if kw == Tok::Extern && pcx.toks[i + 1].kind == Tok::Str
            && pcx.toks[i + 2].kind == Tok::LBrace {
            tcx.un_kind.push(U_EXTERN);
            tcx.un_def.push(-1);
        } else if kw == Tok::Use || kw == Tok::Import || kw == Tok::Mod {
            tcx.un_kind.push(U_OTHER);
            tcx.un_def.push(-1);
        } else {
            var d = -1;
            var t = i;
            while t <= j && t <= i + 3 && d < 0 {
                d = tcx.def_tok.get(t + 1) - 1;
                t += 1;
            }
            tcx.un_kind.push(if d >= 0 { U_ITEM } else { U_OTHER });
            tcx.un_def.push(d);
            if d >= 0 {
                tcx.unit_of.put(d + 1, u + 1);
            }
        }
        i = j + 1;
    }
    banners(f, first_unit, &tcx, pcx);
}

// The start of the text of an item whose first token is at pos: its line,
// and the comment and attribute lines directly above.
fn unit_text_start(f: i64, pos: i64, pcx: Ctx<Comp>) -> i64 {
    var first = line_start(pos, pcx);
    while first > pcx.files[f].start {
        let prev = line_start(first - 1, pcx);
        var a = prev;
        while a < first - 1 && (SRC[a] == ' ' || SRC[a] == '\t') {
            a += 1;
        }
        let comment = a + 1 < first && SRC[a] == '/' && SRC[a + 1] == '/';
        let attribute = a + 1 < first && SRC[a] == '#' && SRC[a + 1] == '[';
        if !comment && !attribute {
            break;
        }
        first = prev;
    }
    first
}

// The type and the trait of the impl block at token i (`impl`), when they
// are items of module m: UN_DEF and UN_TRAIT.
fn impl_names(i: i64, m: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        var t = i + 1;
        if pcx.toks[t].kind == Tok::Lt {
            var depth = 0;
            loop {
                let k = pcx.toks[t].kind;
                if k == Tok::Lt {
                    depth += 1;
                } else if k == Tok::Gt {
                    depth -= 1;
                } else if k == Tok::Shr {
                    depth -= 2;
                }
                t += 1;
                if depth <= 0 || k == Tok::LBrace || k == Tok::Eof {
                    break;
                }
            }
        }
        var angle = 0;
        var last = -1;
        var tr = -1;
        while pcx.toks[t].kind != Tok::LBrace && pcx.toks[t].kind != Tok::Eof {
            let k = pcx.toks[t].kind;
            if k == Tok::Lt {
                angle += 1;
            } else if k == Tok::Gt {
                angle -= 1;
            } else if k == Tok::Shr {
                angle -= 2;
            } else if k == Tok::For && angle == 0 {
                tr = last;
                last = -1;
            } else if k == Tok::Ident && angle == 0 {
                last = t;
            }
            t += 1;
        }
        var ty = -1;
        if last >= 0 {
            let d = item_binding(m, pcx.toks[last].value as i64, tcx);
            if d >= 0 && (pcx.defs[d].kind == K_STRUCT || pcx.defs[d].kind == K_ENUM) {
                ty = d;
            }
        }
        tcx.un_def.push(ty);
        if tr >= 0 {
            let d = item_binding(m, pcx.toks[tr].value as i64, tcx);
            if d >= 0 && pcx.defs[d].kind == K_TRAIT {
                tcx.un_trait.data[tcx.un_trait.count - 1] = d;
            }
        }
    }
}

// The banners above the units of file f (from unit `first`): a block of
// comment lines, a blank line after it and one before it (or code), with
// code somewhere before it in the file (the comment at the top of a file
// is the file's).
fn banners(f: i64, first: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let code_start = if first < tcx.un_start.count { pcx.toks[tcx.un_first.data[first]].start }
            else { pcx.files[f].end };
        for u in first..tcx.un_start.count {
            let a = tcx.un_start.data[u];
            if a <= pcx.files[f].start {
                continue;
            }
            var q = line_start(a - 1, pcx);
            if !blank_line(q, pcx) {
                continue;
            }
            while q > pcx.files[f].start && blank_line(q, pcx) {
                q = line_start(q - 1, pcx);
            }
            if !comment_line(q) {
                continue;
            }
            var cs = q;
            while cs > pcx.files[f].start && comment_line(line_start(cs - 1, pcx)) {
                cs = line_start(cs - 1, pcx);
            }
            if cs < code_start || (u > first && cs < tcx.un_end.data[u - 1]) {
                continue;
            }
            tcx.un_banner.data[u] = cs;
        }
    }
}

// The unit holding position pos (of a file whose units are made), or -1.
pub fn unit_at(pos: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        for u in 0..tcx.un_start.count {
            if tcx.un_start.data[u] <= pos && pos < tcx.un_end.data[u] {
                return u;
            }
        }
        -1
    }
}

// The banner above the unit at pos (0.12: a part's header): the start of
// the banner of the group holding it, -1 for none; *end, the end of its
// comment lines.
pub fn banner_above(pos: i64, end: inout i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var u = unit_at(pos, tcx);
        if u < 0 {
            return -1;
        }
        let f = tcx.un_file.data[u];
        while u >= 0 && tcx.un_file.data[u] == f {
            let b = tcx.un_banner.data[u];
            if b >= 0 {
                var e = b;
                while e < pcx.files[f].end && comment_line(e) {
                    e = after_line(e, pcx);
                }
                end = e;
                return b;
            }
            u -= 1;
        }
        -1
    }
}

// The blocks of the moves: each item's unit (or its line in an extern
// block), the impl blocks that go with it, the banners. False after a
// diagnostic.
pub fn make_blocks(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for i in 0..tcx.mv_def.count {
            let d = tcx.mv_def.data[i];
            let f = file_of_pos(pcx.defs[d].start, pcx);
            units_of(f, &tcx, &pcx);
            let u = tcx.unit_of.get(d + 1) - 1;
            if u >= 0 {
                tcx.un_dest.data[u] = tcx.mv_dest.data[i];
                continue;
            }
            // A function of an extern block.
            let x = unit_at(pcx.defs[d].start, tcx);
            if x < 0 || tcx.un_kind.data[x] != U_EXTERN {
                let e = diag(c"error", c"refactor.not-movable", &tcx);
                buf_bytes(e, sym_text(pcx.defs[d].fqn));
                buf_str(e, c" is not an item of its file that the refactorings know how to move\n");
                return false;
            }
            seen.put(d + 1, tcx.mv_dest.data[i] + 1);
        }
        // The extern blocks: whole when all their functions go to one
        // place, else function by function.
        for x in 0..tcx.un_start.count {
            if tcx.un_kind.data[x] != U_EXTERN {
                continue;
            }
            var dest = -2;
            var all = true;
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d].parent >= 0
                    || pcx.defs[d].start < pcx.toks[tcx.un_first.data[x]].start
                    || pcx.defs[d].start > pcx.toks[tcx.un_last.data[x]].start {
                    continue;
                }
                let g = seen.get(d + 1) - 1;
                if g < 0 {
                    all = false;
                } else if dest == -2 {
                    dest = g;
                } else if dest != g {
                    all = false;
                }
            }
            if dest == -2 {
                continue;
            }
            if all {
                tcx.un_dest.data[x] = dest;
                continue;
            }
            for d in 0..pcx.defs.len() as i64 {
                let g = seen.get(d + 1) - 1;
                if g >= 0 && pcx.defs[d].start >= pcx.toks[tcx.un_first.data[x]].start
                    && pcx.defs[d].start <= pcx.toks[tcx.un_last.data[x]].start {
                    let f = tcx.un_file.data[x];
                    let tail = pcx.toks[token_at(pcx.defs[d].end - 1, pcx)].end;
                    add_block(unit_text_start(f, node_head(pcx.defs[d].start, pcx), pcx),
                        after_line(tail - 1, pcx), g, x, -1, &tcx);
                }
            }
        }
        // The impl blocks go with their type (or their trait).
        for x in 0..tcx.un_start.count {
            if tcx.un_kind.data[x] != U_IMPL || tcx.un_dest.data[x] >= 0 {
                continue;
            }
            let ty = tcx.un_def.data[x];
            let tr = tcx.un_trait.data[x];
            if tcx.opt_group_impls {
                tcx.un_dest.data[x] = group_dest(x, tcx);
            } else if ty >= 0 && !tcx.opt_keep_impls {
                let tu = tcx.unit_of.get(ty + 1) - 1;
                if tu >= 0 && tcx.un_dest.data[tu] >= 0 {
                    tcx.un_dest.data[x] = tcx.un_dest.data[tu];
                }
            } else if ty < 0 && tr >= 0 {
                let tu = tcx.unit_of.get(tr + 1) - 1;
                if tu >= 0 && tcx.un_dest.data[tu] >= 0 {
                    tcx.un_dest.data[x] = tcx.un_dest.data[tu];
                }
            }
        }
        // The banners (0.12): each goes where most of its group's lines go
        // (it stays when most of them do), with the block of the group's
        // first unit. 0.13: with its whole group (into a new module, the
        // part of a split: most of it, its first unit too), and into the
        // middle of a module (move --after, --before) only where a group
        // ends (it would head the units of another group there): so a move
        // and the move back leave it where it was. 0.14: into a new module
        // without its first unit, when most of the group's units go there
        // too (above the first of them).
        var with_unit = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for u in 0..tcx.un_start.count {
            if tcx.un_banner.data[u] < 0 {
                continue;
            }
            var dests = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var lines = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var units = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var v = u;
            while v < tcx.un_start.count && tcx.un_file.data[v] == tcx.un_file.data[u]
                && (v == u || tcx.un_banner.data[v] < 0) {
                var j = 0;
                while j < dests.count && dests.data[j] != tcx.un_dest.data[v] {
                    j += 1;
                }
                if j == dests.count {
                    dests.push(tcx.un_dest.data[v]);
                    lines.push(0);
                    units.push(0);
                }
                lines.data[j] += lines_of(tcx.un_start.data[v], tcx.un_end.data[v]);
                units.data[j] += 1;
                v += 1;
            }
            var best = 0;
            for j in 1..dests.count {
                if lines.data[j] > lines.data[best]
                    || (lines.data[j] == lines.data[best] && dests.data[j] < 0) {
                    best = j;
                }
            }
            let to = dests.data[best];
            if to < 0 || (dests.count > 1 && !is_new(to, pcx)) || !place_ends_group(tcx, pcx) {
                continue;
            }
            var e = tcx.un_banner.data[u];
            while comment_line(e) {
                e = after_line(e, pcx);
            }
            if tcx.un_dest.data[u] == to {
                with_unit.put(u + 1, e + 1);
            } else if is_new(to, pcx) && 2 * units.data[best] > v - u {
                add_block(tcx.un_banner.data[u], e, to, -2, e, &tcx);
            }
        }
        // The units that move.
        for u in 0..tcx.un_start.count {
            if tcx.un_dest.data[u] < 0 {
                continue;
            }
            let e = with_unit.get(u + 1) - 1;
            let start = if e >= 0 { tcx.un_banner.data[u] } else { tcx.un_start.data[u] };
            add_block(start, tcx.un_end.data[u], tcx.un_dest.data[u], -1, e, &tcx);
        }
        true
    }
}

// (0.20) --group-impls: where the items of unit x's banner group go (the
// first of them that moves), or -1.
fn group_dest(x: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var g = x;
        while g > 0 && tcx.un_banner.data[g] < 0 && tcx.un_file.data[g - 1] == tcx.un_file.data[x] {
            g -= 1;
        }
        var v = g;
        while v < tcx.un_start.count && tcx.un_file.data[v] == tcx.un_file.data[x]
            && (v == g || tcx.un_banner.data[v] < 0) {
            if tcx.un_kind.data[v] != U_IMPL && tcx.un_dest.data[v] >= 0 {
                return tcx.un_dest.data[v];
            }
            v += 1;
        }
        -1
    }
}

// Where imports go in module m's file: after its last `use` that stays
// (true), or before its first unit that stays.
pub fn import_anchor(m: i64, after: inout bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let f = own_file(m, pcx);
        var last = -1;
        for u in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[u].kind != NodeKind::Use || module_of(u, &pcx) != m
                || file_of_pos(pcx.nodes[u].start, pcx) != f {
                continue;
            }
            var gone = 0;
            for k in 0..pcx.nodes[u].count {
                if tcx.imports_dropped.get(child(u, k, pcx)) != 0 {
                    gone += 1;
                }
            }
            if pcx.nodes[u].count > 0 && gone == pcx.nodes[u].count {
                continue;
            }
            if last < 0 || pcx.nodes[u].start > pcx.nodes[last].start {
                last = u;
            }
        }
        if last >= 0 {
            after = true;
            return line_end(pcx.nodes[last].end - 1, pcx);
        }
        after = false;
        units_of(f, &tcx, &pcx);
        for u in 0..tcx.un_start.count {
            if tcx.un_file.data[u] == f && !in_block(tcx.un_start.data[u], tcx) {
                return if tcx.un_banner.data[u] >= 0 { tcx.un_banner.data[u] }
                    else { tcx.un_start.data[u] };
            }
        }
        pcx.files[f].end
    }
}

// The lines of SRC[a..b).
pub fn lines_of(a: i64, b: i64) -> i64 {
    var n = 0;
    for p in a..b {
        if SRC[p] == '\n' {
            n += 1;
        }
    }
    n
}

// The split of module m (file f) into parts: printed as commands
// (--plan), or made (--auto).
pub fn split_plan(m: i64, f: i64, root: *u8, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let total = lines_of(pcx.files[f].start, pcx.files[f].end);
        let max = tcx.opt_max_lines;
        if total <= max {
            let e = diag(c"note", c"refactor.fits", &tcx);
            buf_bytes(e, mod_fqn_text(m, &tcx, pcx));
            buf_str(e, c" has ");
            buf_int(e, total);
            buf_str(e, c" lines (at most ");
            buf_int(e, max);
            buf_str(e, c"); nothing to split\n");
            return 0;
        }
        // The items that can move (an impl block counts with its type, or
        // its trait), their lines; what stays (the rest) and its lines.
        var items = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let owner = alloc_array::<i64>(tcx.un_start.count + 1);
        for u in 0..tcx.un_start.count {
            owner[u] = -1;
            if tcx.un_file.data[u] == f && tcx.un_kind.data[u] == U_ITEM
                && pcx.defs[tcx.un_def.data[u]].kind != K_MOD {
                owner[u] = items.count;
                items.push(u);
            }
        }
        let n = items.count;
        let lines = alloc_array::<i64>(n + 1);
        var pinned = total;
        for u in 0..tcx.un_start.count {
            if tcx.un_file.data[u] != f {
                continue;
            }
            if tcx.un_kind.data[u] == U_IMPL {
                let ty = tcx.un_def.data[u];
                let tr = tcx.un_trait.data[u];
                let tu = if ty >= 0 { tcx.unit_of.get(ty + 1) - 1 }
                    else if tr >= 0 { tcx.unit_of.get(tr + 1) - 1 } else { -1 };
                if tu >= 0 && owner[tu] >= 0 {
                    owner[u] = owner[tu];
                }
            }
            if owner[u] >= 0 {
                let l = lines_of(tcx.un_start.data[u], tcx.un_end.data[u]);
                lines[owner[u]] += l;
                pinned -= l;
            }
        }
        // The references between items, and from other modules.
        let weight = alloc_array::<i64>(n * n + 1);
        let outside = alloc_array::<i64>(n + 1);
        for k in 0..tcx.refs.count {
            let r = tcx.refs.data[k];
            if (tcx.r_flags.data[r] & QF_DEF) != 0 {
                continue;
            }
            let tu = unit_at(pcx.defs[tcx.r_def.data[r]].start, tcx);
            if tu < 0 || owner[tu] < 0 {
                continue;
            }
            let t = owner[tu];
            let p = tcx.r_pos.data[r];
            if file_of_pos(p, pcx) != f {
                if module_at(p, &pcx) != m {
                    outside[t] += 1;
                }
                continue;
            }
            let su = unit_at(p, tcx);
            if su >= 0 && owner[su] >= 0 && owner[su] != t {
                weight[owner[su] * n + t] += 1;
            }
        }
        var budget = max - pinned - 20;
        if budget < max / 2 {
            budget = max / 2;
        }
        let group = alloc_array::<i64>(n + 1);
        let size = alloc_array::<i64>(n + 1);
        cluster(weight, lines, n, budget, group, size);
        // The parts, largest first; the one most used from outside stays.
        var parts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for g in 0..n {
            if size[g] >= 0 {
                var k = parts.count;
                parts.push(g);
                while k > 0 && size[parts.data[k - 1]] < size[g] {
                    parts.data[k] = parts.data[k - 1];
                    k -= 1;
                }
                parts.data[k] = g;
            }
        }
        var stay = -1;
        var best = -1;
        for k in 0..parts.count {
            let g = parts.data[k];
            var o = 0;
            for i in 0..n {
                if group[i] == g {
                    o += outside[i];
                }
            }
            if o > best {
                best = o;
                stay = g;
            }
        }
        // Their names (0.13): --names, else from what their items share.
        var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var whys = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var given = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if tcx.cli_opt_names != 0 as *u8 && !names_given(m, &given, parts.count - 1, &tcx, pcx) {
            return 2;
        }
        // (the parts --names does not name: the best named first)
        var j = 0;
        let score = alloc_array::<i64>(parts.count + 1);
        for k in 0..parts.count {
            let g = parts.data[k];
            whys.push(buf_new());
            names.push(-1);
            score[k] = -1;
            if g != stay && j < given.count {
                names.data[k] = given.data[j];
                buf_str(whys.data[k], c"--names");
                j += 1;
            } else if g != stay {
                score[k] = part_score(m, g, group, items, lines, n, &tcx, &pcx);
            }
        }
        loop {
            var next = -1;
            for k in 0..parts.count {
                if score[k] >= 0 && (next < 0 || score[k] > score[next]) {
                    next = k;
                }
            }
            if next < 0 {
                break;
            }
            score[next] = -1;
            names.data[next] = part_name(m, parts.data[next], group, items, lines, n, names, next,
                whys.data[next], &tcx, &pcx);
        }
        if tcx.opt_plan {
            let out = buf_new();
            buf_str(out, c"# ");
            buf_bytes(out, mod_fqn_text(m, &tcx, pcx));
            buf_byte(out, '\t');
            buf_int(out, total);
            buf_str(out, c" lines\t");
            buf_int(out, parts.count);
            buf_str(out, c" parts of at most ");
            buf_int(out, max);
            buf_str(out, c" lines\n");
            for k in 0..parts.count {
                let g = parts.data[k];
                if g == stay {
                    buf_str(out, c" # stays in ");
                    buf_bytes(out, mod_fqn_text(m, &tcx, pcx));
                    buf_str(out, c": the part most used from other modules\n");
                    continue;
                }
                buf_str(out, c" # ");
                buf_bytes(out, sym_text(names.data[k]));
                buf_str(out, c": ");
                buf_bytes(out, buf_slice(whys.data[k]));
                buf_byte(out, '\n');
                put_cword(out, pcx.prog);
                buf_str(out, c" refactor split ");
                buf_bytes(out, mod_fqn_text(m, &tcx, pcx));
                buf_str(out, c" --into ");
                buf_bytes(out, mod_fqn_text(m, &tcx, pcx));
                buf_str(out, c"::");
                buf_bytes(out, sym_text(names.data[k]));
                buf_str(out, c" --items ");
                var first = true;
                for i in 0..n {
                    if group[i] != g {
                        continue;
                    }
                    if !first {
                        buf_byte(out, ',');
                    }
                    first = false;
                    buf_bytes(out, sym_text(pcx.defs[tcx.un_def.data[items.data[i]]].name));
                }
                if tcx.root_given != 0 as *u8 {
                    crate::tools::query::diagnostics::put_root(out, tcx);
                }
                buf_byte(out, '\n');
            }
            // (the out buffer starts with a space before each command)
            buf_write_fd(trim_lines(out), STDOUT);
            let e = diag(c"note", c"refactor.plan", &tcx);
            buf_str(e, c"the same in one edit: --auto (other names: --names a,b)\n");
            let t = try_begin(c"split", mod_fqn_text(m, &tcx, pcx), true, &tcx, pcx);
            buf_str(t, c" --auto --max-lines ");
            buf_int(t, max);
            try_end(t);
            return 0;
        }
        // --auto: the parts, made.
        var converts = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        var made = 0;
        for k in 0..parts.count {
            let g = parts.data[k];
            if g == stay {
                continue;
            }
            let r = make_module(m, names.data[k], false, &converts, &tcx, pcx);
            if r < 0 {
                return 1;
            }
            made += 1;
            for i in 0..n {
                if group[i] == g {
                    tcx.mv_def.push(tcx.un_def.data[items.data[i]]);
                    tcx.mv_dest.push(r);
                }
            }
        }
        if !move_edits(&tcx, &pcx) {
            return 1;
        }
        emit_regions(&tcx, &pcx);
        let what = buf_new();
        buf_str(what, c"split ");
        buf_bytes(what, mod_fqn_text(m, &tcx, pcx));
        buf_str(what, c" into ");
        buf_int(what, made);
        buf_str(what, if made == 1 { c" module" } else { c" modules" });
        finish(what, root, &tcx, &pcx)
    }
}

// The lines of buffer b without the space put_cword puts first.
fn trim_lines(b: i64) -> i64 {
    let s = buf_slice(b);
    let out = buf_new();
    var i = 0;
    var start = true;
    while i < s.len as i64 {
        if !(start && s[i] == ' ') {
            buf_byte(out, s[i]);
        }
        start = s[i] == '\n';
        i += 1;
    }
    out
}
