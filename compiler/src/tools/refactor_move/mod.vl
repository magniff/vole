// Moving items between modules, and splitting a module (0.11, phase 2a;
// docs/refactor.md):
//
//   volec refactor move PATH... --to MODULE
//   volec refactor split MODULE --into NEWMOD --items a,b,c
//   volec refactor split MODULE --plan|--auto [--max-lines N]
//
// What moves with an item: its text (its lines, with the comment and
// attribute lines directly above it); the impl blocks of a type moved
// (inherent and trait impls in its module; --keep-impls leaves them), and
// the trait impls in its module of a trait moved for a type that is not an
// item of that module; the banner of a group of items (a comment block
// with blank lines around it, after some code: it heads the items up to
// the next banner) when every item of the group moves to one module. Then
// the references: paths naming a moved item are written from `crate`, the
// `use` lines importing it import it from its new module, the code that
// named it bare gets an import, the moved code gets the imports it needs
// (what its old module imported, and the old module's items), `super::`
// and `self::` paths in it are written from `crate`, items used from
// where they are private become `pub` (and the modules on the way), and
// the imports of the old module that nothing names any more are removed.
// Nothing else changes, byte for byte.

pub mod naming;
mod units;
pub mod imports;
mod place;

use crate::base::{
    get_bufs, IntVec, get_src, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::child;
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_at, module_count};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::cli::delete_lines;
use crate::tools::proc::{buf_cstr, remove_file, run_inherit, write_file_if};
use crate::tools::query::c_slice;
use crate::tools::query::defs::{K_IMPL_METHOD, K_METHOD, K_MOD, bytes_eq, mod_fqn_text};
use crate::tools::query::diagnostics::{diag, try_begin, try_end, write_diags};
use crate::tools::query::positions::token_at;
use crate::tools::refactor_mod::{
    binding_of, collision, emit_regions, is_new, item_binding, load_refs, own_file, put_edit,
};
use crate::tools::refactor_mod::cli::{
    finish, inline_module, make_path, module_named, no_module, one_definition, path_segments,
};
use crate::tools::refactor_move::imports::{
    analyze, emit_use_edits, reexport_lines, region_uses, remove_use_names, rewrite_imports,
};
use crate::tools::refactor_move::place::{anchor_unit, delete_moved, place_moved, run_key_at};
use crate::tools::refactor_move::units::{
    banner_above, import_anchor, make_blocks, split_plan, units_of,
};

// ---- Blocks: the text that moves ----

// The region the code at pos is in after the edit.
fn region_at(pos: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut lo: i64 = 0;
        let mut hi = tcx.bl_start.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if (*tcx.bl_start.data.add(mid as usize)) <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo > 0 && pos < (*tcx.bl_end.data.add((lo - 1) as usize)) {
            return (*tcx.bl_dest.data.add((lo - 1) as usize));
        }
        module_at(pos, pcx)
    }
}

// Block [start, end) of a moved text goes to region dest (wrap: the
// unit of the extern block of a function moved alone; -2: a banner moved
// alone, above the group's first unit going there); banner: the end of
// the banner it starts with (its comment lines), -1 for none.
fn add_block(start: i64, end: i64, dest: i64, wrap: i64, banner: i64, tcx: &mut Tcx<Comp>) {
    unsafe {
        // (in order of position)
        let mut k = tcx.bl_start.count;
        tcx.bl_start.push(0);
        tcx.bl_end.push(0);
        tcx.bl_dest.push(0);
        tcx.bl_wrap.push(0);
        tcx.bl_banner.push(0);
        while k > 0 && (*tcx.bl_start.data.add((k - 1) as usize)) > start {
            (*tcx.bl_start.data.add(k as usize)) = (*tcx.bl_start.data.add((k - 1) as usize));
            (*tcx.bl_end.data.add(k as usize)) = (*tcx.bl_end.data.add((k - 1) as usize));
            (*tcx.bl_dest.data.add(k as usize)) = (*tcx.bl_dest.data.add((k - 1) as usize));
            (*tcx.bl_wrap.data.add(k as usize)) = (*tcx.bl_wrap.data.add((k - 1) as usize));
            (*tcx.bl_banner.data.add(k as usize)) = (*tcx.bl_banner.data.add((k - 1) as usize));
            k -= 1;
        }
        (*tcx.bl_start.data.add(k as usize)) = start;
        (*tcx.bl_end.data.add(k as usize)) = end;
        (*tcx.bl_dest.data.add(k as usize)) = dest;
        (*tcx.bl_wrap.data.add(k as usize)) = wrap;
        (*tcx.bl_banner.data.add(k as usize)) = banner;
    }
}

// Whether item d can move (diagnosed when not).
fn movable(d: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    let mut why = 0 as *mut u8;
    if k == K_METHOD || k == K_IMPL_METHOD {
        why = c" is a method: it moves with its type's impl block";
    } else if pcx.defs[d as usize].parent >= 0 {
        why = c" is part of an item: move the item";
    } else if k == K_MOD {
        why = c" is a module: use move-module";
    }
    if why != 0 as *mut u8 {
        let e = diag(c"error", c"refactor.not-movable", tcx);
        buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(e, why);
        buf_byte(e, b'\n');
        if k == K_MOD {
            let out = try_begin(c"move-module", sym_text(pcx.defs[d as usize].fqn, pcx), true, tcx, pcx);
            buf_str(out, c" crate::NEW::PATH");
            try_end(out);
        }
        return false;
    }
    let f = file_of_pos(pcx.defs[d as usize].start, pcx);
    if module_at(pcx.defs[d as usize].start, pcx) != pcx.files[f as usize].module {
        inline_module(module_at(pcx.defs[d as usize].start, pcx), tcx, pcx);
        return false;
    }
    true
}

// ---- Edits inside moved text ----
//
// Every edit that may fall in moved text goes here first: at the end, the
// ones inside a block are made in its copy, the others in the files.

fn later_edit(a: i64, b: i64, text: i64, tcx: &mut Tcx<Comp>) {
    // (one edit per position)
    if tcx.l_at.get(a + 1) != 0 {
        return;
    }
    tcx.l_at.put(a + 1, 1);
    tcx.refactor_move_l_start.push(a);
    tcx.refactor_move_l_end.push(b);
    tcx.l_text.push(text);
}

// Block k's text, with the edits inside it, ending with a newline.
fn block_text(k: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let a = (*tcx.bl_start.data.add(k as usize));
        let b = (*tcx.bl_end.data.add(k as usize));
        let mut inner = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for e in 0..tcx.refactor_move_l_start.count {
            if (*tcx.refactor_move_l_start.data.add(e as usize)) >= a && (*tcx.refactor_move_l_end.data.add(e as usize)) <= b
                && !((*tcx.refactor_move_l_start.data.add(e as usize)) == b && (*tcx.refactor_move_l_end.data.add(e as usize)) == b) {
                inner.push(e);
            }
        }
        // (by position)
        for i in 1..inner.count {
            let mut j = i;
            while j > 0
                && (*tcx.refactor_move_l_start.data.add((*inner.data.add(j as usize)) as usize))
                < (*tcx.refactor_move_l_start.data.add((*inner.data.add((j - 1) as usize)) as usize)) {
                let t = (*inner.data.add(j as usize));
                (*inner.data.add(j as usize)) = (*inner.data.add((j - 1) as usize));
                (*inner.data.add((j - 1) as usize)) = t;
                j -= 1;
            }
        }
        let out = buf_new();
        let mut cur = a;
        for i in 0..inner.count {
            let e = (*inner.data.add(i as usize));
            buf_bytes(out, &get_src()[cur as usize..(*tcx.refactor_move_l_start.data.add(e as usize)) as usize]);
            buf_bytes(out, buf_slice((*tcx.l_text.data.add(e as usize))));
            cur = (*tcx.refactor_move_l_end.data.add(e as usize));
        }
        buf_bytes(out, &get_src()[cur as usize..b as usize]);
        if (*get_bufs().add(out as usize)).len > 0 && (*(*get_bufs().add(out as usize)).data.add(((*get_bufs().add(out as usize)).len - 1) as usize)) != b'\n' {
            buf_byte(out, b'\n');
        }
        out
    }
}

fn in_block(pos: i64, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        for k in 0..tcx.bl_start.count {
            if (*tcx.bl_start.data.add(k as usize)) <= pos && pos < (*tcx.bl_end.data.add(k as usize)) {
                return true;
            }
        }
        false
    }
}

// ---- The analysis ----

// The `super::` and `self::` paths of the moved code, written from `crate`.
fn moved_relative_paths(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let sup = intern(c_slice(c"super"), pcx);
        let slf = intern(c_slice(c"self"), pcx);
        for k in 0..tcx.bl_start.count {
            let mut i = token_at((*tcx.bl_start.data.add(k as usize)), pcx);
            while i + 1 < pcx.toks.len() as i64 && pcx.toks[i as usize].start < (*tcx.bl_end.data.add(k as usize)) {
                let v = pcx.toks[i as usize].value as i64;
                if pcx.toks[i as usize].kind != Tok::Ident || (v != sup && v != slf)
                    || pcx.toks[(i + 1) as usize].kind != Tok::ColonColon
                    || (i > 0 && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon) {
                    i += 1;
                    continue;
                }
                let first = i;
                let mut m = module_at(pcx.toks[i as usize].start, pcx);
                if v == slf {
                    i += 2;
                } else {
                    while i + 1 < pcx.toks.len() as i64 && pcx.toks[i as usize].kind == Tok::Ident
                        && pcx.toks[i as usize].value as i64 == sup
                        && pcx.toks[(i + 1) as usize].kind == Tok::ColonColon {
                        m = crate::tools::refactor_mod::region_parent(m, tcx, pcx);
                        i += 2;
                    }
                }
                if m < 0 {
                    continue;
                }
                let b = buf_new();
                buf_bytes(b, mod_fqn_text(m, tcx, pcx));
                buf_str(b, c"::");
                later_edit(pcx.toks[first as usize].start, pcx.toks[i as usize].start, b, tcx);
            }
        }
    }
}

// The imports of the modules the moved code leaves that nothing there
// names any more.
fn unused_imports(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..tcx.bl_start.count {
            let f = file_of_pos((*tcx.bl_start.data.add(k as usize)), pcx);
            let mut seen = false;
            for i in 0..files.count {
                if (*files.data.add(i as usize)) == f {
                    seen = true;
                }
            }
            if !seen {
                files.push(f);
            }
        }
        for u in 1..pcx.nodes.len() as i64 {
            if !crate::tools::refactor_mod::cli::is_name_use(u, pcx)
                || (pcx.nodes[u as usize].p & crate::front::parser::items::ITEM_PUBLIC) != 0 {
                continue;
            }
            let f = file_of_pos(pcx.nodes[u as usize].start, pcx);
            let mut mine = false;
            for i in 0..files.count {
                if (*files.data.add(i as usize)) == f {
                    mine = true;
                }
            }
            if !mine || in_block(pcx.nodes[u as usize].start, tcx) {
                continue;
            }
            for k in 0..pcx.nodes[u as usize].count {
                let id = child(u, k, pcx);
                let name = crate::tools::refactor_mod::use_local(id, pcx);
                let mut before: i64 = 0;
                let mut after: i64 = 0;
                let mut i = token_at(pcx.files[f as usize].start, pcx);
                while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < pcx.files[f as usize].end {
                    let s = pcx.toks[i as usize].start;
                    if pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == name
                        && (s < pcx.nodes[u as usize].start || s >= pcx.nodes[u as usize].end) {
                        before += 1;
                        if !in_block(s, tcx) {
                            after += 1;
                        }
                    }
                    i += 1;
                }
                if before > 0 && after == 0 {
                    remove_use_names(u, id, tcx);
                }
            }
        }
    }
}

// ---- The edit ----

// Makes the moves of MV_DEF / MV_DEST (the references collected): false
// after a diagnostic.
pub fn move_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        // Names taken where the items go.
        for i in 0..tcx.mv_def.count {
            let d = (*tcx.mv_def.data.add(i as usize));
            let r = (*tcx.mv_dest.data.add(i as usize));
            for j in 0..i {
                if (*tcx.mv_dest.data.add(j as usize)) == r
                    && pcx.defs[(*tcx.mv_def.data.add(j as usize)) as usize].name == pcx.defs[d as usize].name {
                    collision(sym_text(pcx.defs[d as usize].name, pcx), r, (*tcx.mv_def.data.add(j as usize)), false, tcx,
                        pcx);
                    return false;
                }
            }
            if !is_new(r, pcx) {
                let b = binding_of(r, pcx.defs[d as usize].name, tcx, pcx);
                if b >= 0 && b != d {
                    collision(sym_text(pcx.defs[d as usize].name, pcx), r, b,
                        item_binding(r, pcx.defs[d as usize].name, tcx) < 0, tcx, pcx);
                    return false;
                }
            }
        }
        if !make_blocks(tcx, pcx) {
            return false;
        }
        if !analyze(tcx, pcx) {
            return false;
        }
        rewrite_imports(tcx, pcx);
        if tcx.refused {
            return false;
        }
        moved_relative_paths(tcx, pcx);
        unused_imports(tcx, pcx);
        // The moved text, from where it was.
        let mut texts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..tcx.bl_start.count {
            texts.push(block_text(k, tcx));
        }
        let mut k: i64 = 0;
        while k < tcx.bl_start.count {
            // (blocks with only blank lines between: one deletion)
            let mut j = k;
            while j + 1 < tcx.bl_start.count
                && file_of_pos((*tcx.bl_start.data.add((j + 1) as usize)), pcx)
                == file_of_pos((*tcx.bl_start.data.add(k as usize)), pcx)
                && only_blank((*tcx.bl_end.data.add(j as usize)), (*tcx.bl_start.data.add((j + 1) as usize))) {
                j += 1;
            }
            if (*tcx.bl_wrap.data.add(k as usize)) >= 0 || (*tcx.bl_wrap.data.add(j as usize)) >= 0 {
                delete_lines((*tcx.bl_start.data.add(k as usize)), (*tcx.bl_end.data.add(j as usize)), pcx);
            } else {
                let last: i64 = if (*tcx.bl_wrap.data.add(j as usize))
                    == -1 { run_key_at((*tcx.bl_start.data.add(j as usize)), tcx, pcx) }
                    else { 0 };
                delete_moved((*tcx.bl_start.data.add(k as usize)), (*tcx.bl_end.data.add(j as usize)),
                    if (*tcx.bl_wrap.data.add(k as usize)) == -1 { run_key_at((*tcx.bl_start.data.add(k as usize)), tcx, pcx) }
                    else { 0 }, last, tcx, pcx);
            }
            k = j + 1;
        }
        // The other edits.
        for e in 0..tcx.refactor_move_l_start.count {
            if !in_block((*tcx.refactor_move_l_start.data.add(e as usize)), tcx) {
                put_edit((*tcx.refactor_move_l_start.data.add(e as usize)), (*tcx.refactor_move_l_end.data.add(e as usize)),
                    (*tcx.l_text.data.add(e as usize)), tcx, pcx);
            }
        }
        emit_use_edits(tcx, pcx);
        // The imports, where they go (and split --reexport's re-exports).
        let reex = reexport_lines(tcx, pcx);
        let mut regions = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..tcx.im_region.count {
            if (*tcx.im_region.data.add(i as usize)) >= 0 {
                push_once(&mut regions, (*tcx.im_region.data.add(i as usize)));
            }
        }
        if (*get_bufs().add(reex as usize)).len > 0 {
            push_once(&mut regions, tcx.split_from);
        }
        for i in 0..regions.count {
            let r = (*regions.data.add(i as usize));
            let lines = region_uses(r, tcx, pcx);
            if r == tcx.split_from {
                buf_bytes(lines, buf_slice(reex));
            }
            if is_new(r, pcx) {
                buf_bytes((*tcx.nm_uses.data.add((r - module_count(pcx)) as usize)), buf_slice(lines));
                continue;
            }
            let mut after = false;
            let at = import_anchor(r, &mut after, tcx, pcx);
            let text = buf_new();
            if after {
                buf_byte(text, b'\n');
                let s = buf_slice(lines);
                buf_bytes(text, &s[0..(s.len() as i64 - 1) as usize]);
            } else {
                buf_bytes(text, buf_slice(lines));
                if at < pcx.files[own_file(r, pcx) as usize].end {
                    buf_byte(text, b'\n');
                }
            }
            put_edit(at, at, text, tcx, pcx);
        }
        // The moved text, where it goes.
        let mut dests = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..tcx.bl_start.count {
            push_once(&mut dests, (*tcx.bl_dest.data.add(k as usize)));
        }
        for i in 0..dests.count {
            let r = (*dests.data.add(i as usize));
            let body = buf_new();
            let mut k: i64 = 0;
            // (the block before, to keep the blank lines between blocks
            // that had only blank lines between them: a run of constants
            // stays one, 0.12; as many blank lines as there were, 0.13)
            let mut prev: i64 = -1;
            let mut first_key: i64 = -1;
            let mut last_key: i64 = 0;
            while k < tcx.bl_start.count {
                if (*tcx.bl_dest.data.add(k as usize)) != r {
                    k += 1;
                    continue;
                }
                let mut text = buf_slice((*texts.data.add(k as usize)));
                if prev < 0 && is_new(r, pcx)
                    && (*get_bufs().add((*tcx.nm_head.data.add((r - module_count(pcx)) as usize)) as usize)).len == 0 {
                    // A part's header: --header, or the banner it starts
                    // with (then not repeated), or the banner above its
                    // first block where it was.
                    let head = (*tcx.nm_head.data.add((r - module_count(pcx)) as usize));
                    if tcx.opt_header != 0 as *mut u8 {
                        put_header(head, c_slice(tcx.opt_header));
                    } else if (*tcx.bl_banner.data.add(k as usize)) >= 0 {
                        put_header(head, &get_src()[(*tcx.bl_start.data.add(k as usize)) as usize..(*tcx.bl_banner.data.add(k as usize)) as usize]);
                        text = after_blank_lines(text,
                            (*tcx.bl_banner.data.add(k as usize)) - (*tcx.bl_start.data.add(k as usize)));
                    } else {
                        let mut e: i64 = 0;
                        let b = banner_above((*tcx.bl_start.data.add(k as usize)), &mut e, tcx, pcx);
                        if b >= 0 {
                            put_header(head, &get_src()[b as usize..e as usize]);
                        }
                    }
                }
                if (*tcx.bl_wrap.data.add(k as usize)) == -2 {
                    // (a banner moved alone: one blank line after it)
                    while text.len() > 1 && text[(text.len() as i64 - 1) as usize] == b'\n'
                        && text[(text.len() as i64 - 2) as usize] == b'\n' {
                        text = &text[0..(text.len() as i64 - 1) as usize];
                    }
                }
                let mut gap: i64 = 1;
                let mut exact = false;
                if prev >= 0 && (*tcx.bl_wrap.data.add(k as usize)) < 0 && (*tcx.bl_wrap.data.add(prev as usize)) == -1
                    && (*tcx.bl_end.data.add(prev as usize)) <= (*tcx.bl_start.data.add(k as usize))
                    && file_of_pos((*tcx.bl_start.data.add(prev as usize)), pcx)
                    == file_of_pos((*tcx.bl_start.data.add(k as usize)), pcx)
                    && only_blank((*tcx.bl_end.data.add(prev as usize)), (*tcx.bl_start.data.add(k as usize))) {
                    gap = 0;
                    exact = true;
                    for p in (*tcx.bl_end.data.add(prev as usize))..(*tcx.bl_start.data.add(k as usize)) {
                        if get_src()[p as usize] == b'\n' {
                            gap += 1;
                        }
                    }
                }
                if (*get_bufs().add(body as usize)).len > 0 && text.len() > 0 {
                    for _ in 0..gap {
                        buf_byte(body, b'\n');
                    }
                }
                let x = (*tcx.bl_wrap.data.add(k as usize));
                let key: i64 = if x == -1 { run_key_at((*tcx.bl_start.data.add(k as usize)), tcx, pcx) } else { 0 };
                if first_key < 0 {
                    first_key = key;
                } else if key > 0 && key == last_key && exact {
                    tcx.run_key = key;
                    tcx.run_gap = gap;
                }
                last_key = key;
                if x < 0 {
                    buf_bytes(body, text);
                    prev = k;
                    k += 1;
                    continue;
                }
                prev = k;
                // Functions of an extern block: in one like it.
                let t = (*tcx.un_first.data.add(x as usize));
                let mut lb = t;
                while pcx.toks[lb as usize].kind != Tok::LBrace {
                    lb += 1;
                }
                buf_bytes(body, &get_src()[pcx.toks[t as usize].start as usize..pcx.toks[lb as usize].end as usize]);
                buf_byte(body, b'\n');
                while k < tcx.bl_start.count && (*tcx.bl_dest.data.add(k as usize)) == r
                    && (*tcx.bl_wrap.data.add(k as usize)) == x {
                    buf_bytes(body, buf_slice((*texts.data.add(k as usize))));
                    k += 1;
                }
                buf_str(body, c"}\n");
            }
            if is_new(r, pcx) {
                buf_bytes((*tcx.nm_body.data.add((r - module_count(pcx)) as usize)), buf_slice(body));
                continue;
            }
            if tcx.place_at >= 0 && r == (*tcx.mv_dest.data.add(0)) {
                place_moved(tcx.place_at, tcx.place_before, buf_slice(body), first_key, last_key,
                    tcx, pcx);
                continue;
            }
            let f = own_file(r, pcx);
            let end = pcx.files[f as usize].end;
            let text = buf_new();
            if end > pcx.files[f as usize].start && get_src()[(end - 1) as usize] != b'\n' {
                buf_str(text, c"\n\n");
            }
            else if end > pcx.files[f as usize].start
                && !(end - 1 > pcx.files[f as usize].start && get_src()[(end - 2) as usize] == b'\n') {
                buf_byte(text, b'\n');
            }
            buf_bytes(text, buf_slice(body));
            put_edit(end, end, text, tcx, pcx);
        }
        true
    }
}

fn push_once(v: &mut IntVec, x: i64) {
    unsafe {
        for i in 0..v.count {
            if (*v.data.add(i as usize)) == x {
                return;
            }
        }
        v.push(x);
    }
}

fn only_blank(a: i64, b: i64) -> bool {
    for p in a..b {
        if get_src()[p as usize] != b' ' && get_src()[p as usize] != b'\t' && get_src()[p as usize] != b'\n' && get_src()[p as usize] != b'\r' {
            return false;
        }
    }
    true
}

// The header comment of a part made from text (a banner, or --header):
// its lines as comments, without the rules of a banner (`// ---- Name
// ----` is `// Name`), into buffer out.
fn put_header(out: i64, text: &[u8]) {
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut e = i;
        while e < text.len() as i64 && text[e as usize] != b'\n' {
            e += 1;
        }
        let mut a = i;
        while a < e && (text[a as usize] == b' ' || text[a as usize] == b'\t') {
            a += 1;
        }
        if a + 1 < e && text[a as usize] == b'/' && text[(a + 1) as usize] == b'/' {
            a += 2;
        }
        while a < e && (text[a as usize] == b' ' || text[a as usize] == b'-' || text[a as usize] == b'=' || text[a as usize] == b'*') {
            a += 1;
        }
        let mut b = e;
        while b > a
            && (text[(b - 1) as usize] == b' ' || text[(b - 1) as usize] == b'-' || text[(b - 1) as usize] == b'='
                || text[(b - 1) as usize] == b'*' || text[(b - 1) as usize] == b'\r') {
            b -= 1;
        }
        if b > a {
            buf_str(out, c"// ");
            buf_bytes(out, &text[a as usize..b as usize]);
            buf_byte(out, b'\n');
        }
        i = e + 1;
    }
}

// text after its first n bytes and the blank lines that follow them.
fn after_blank_lines(text: &[u8], n: i64) -> &[u8] {
    let mut p = n;
    while p < text.len() as i64 && text[p as usize] == b'\n' {
        p += 1;
    }
    &text[p as usize..]
}

// ---- move ----

// `refactor move PATH... --to MODULE`.
pub fn run_move(words: IntVec, to: *mut u8, root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        tcx.tidy_after = true;
        let t = module_named(c_slice(to), tcx, pcx);
        if t == -1 {
            return move_to_new(words, c_slice(to), root, tcx, pcx);
        }
        if t < 0 {
            return no_module(c_slice(to), c"new-module", tcx, pcx);
        }
        if own_file(t, pcx) < 0 {
            return inline_module(t, tcx, pcx);
        }
        load_refs(tcx, pcx);
        for i in 0..words.count {
            let name = c_slice((*words.data.add(i as usize)) as *mut u8);
            let d = one_definition(c"move", name, c_slice(c""), tcx, pcx);
            if d < 0 || !movable(d, tcx, pcx) {
                return 1;
            }
            if pcx.defs[d as usize].module == t {
                continue;
            }
            tcx.mv_def.push(d);
            tcx.mv_dest.push(t);
        }
        if tcx.mv_def.count == 0 {
            let e = diag(c"note", c"edit.unchanged", tcx);
            buf_str(e, c"nothing to change\n");
            return 0;
        }
        if (tcx.opt_after != 0 as *mut u8 || tcx.opt_before != 0 as *mut u8)
            && !find_anchor(t, tcx, pcx) {
            return 1;
        }
        if !move_edits(tcx, pcx) {
            return 1;
        }
        emit_regions(tcx, pcx);
        let what = buf_new();
        buf_str(what, c"moved ");
        if tcx.mv_def.count == 1 {
            buf_bytes(what, sym_text(pcx.defs[(*tcx.mv_def.data.add(0)) as usize].fqn, pcx));
        } else {
            buf_int(what, tcx.mv_def.count);
            buf_str(what, c" items");
        }
        buf_str(what, c" to ");
        buf_bytes(what, mod_fqn_text(t, tcx, pcx));
        finish(what, root, tcx, pcx)
    }
}

// (0.17) `refactor move PATH... --to MODULE` when MODULE does not exist:
// a script of two steps, `refactor new-module MODULE` and the move, run
// as one edit by a copy of this program (stdout and stderr its own).
fn move_to_new(words: IntVec, to: &[u8], root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let path = buf_new();
        if !bytes_eq(to, c_slice(c"crate"))
            && !(to.len() > 7 && bytes_eq(&to[0..7], c_slice(c"crate::")))
            && !(to.len() > 5 && bytes_eq(&to[0..5], c_slice(c"std::"))) {
            buf_str(path, c"crate::");
        }
        buf_bytes(path, to);
        let script = buf_new();
        buf_str(script, c"refactor new-module ");
        buf_bytes(script, buf_slice(path));
        if tcx.opt_dir {
            buf_str(script, c" --dir");
        }
        buf_str(script, c"\nrefactor move");
        for i in 0..words.count {
            buf_byte(script, b' ');
            buf_str(script, (*words.data.add(i as usize)) as *mut u8);
        }
        buf_str(script, c" --to ");
        buf_bytes(script, buf_slice(path));
        if tcx.opt_after != 0 as *mut u8 {
            buf_str(script, c" --after ");
            buf_str(script, tcx.opt_after);
        }
        if tcx.opt_before != 0 as *mut u8 {
            buf_str(script, c" --before ");
            buf_str(script, tcx.opt_before);
        }
        if tcx.opt_no_tidy {
            buf_str(script, c" --no-tidy");
        }
        buf_byte(script, b'\n');
        let file_buf = buf_new();
        buf_str(file_buf, root);
        buf_str(file_buf, c".vole-move~");
        let file = buf_cstr(file_buf);
        if !write_file_if(file, buf_slice(script)) {
            let d = diag(c"error", c"refactor.script", tcx);
            buf_str(d, c"cannot write '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 2;
        }
        let label = buf_new();
        buf_str(label, c"moved ");
        if words.count == 1 {
            buf_str(label, (*words.data.add(0)) as *mut u8);
        } else {
            buf_int(label, words.count);
            buf_str(label, c" items");
        }
        buf_str(label, c" to ");
        buf_bytes(label, buf_slice(path));
        buf_str(label, c", a new module");
        let args = alloc_array::<*mut u8>(16i64);
        (*args.add(0)) = pcx.prog;
        (*args.add(1)) = c"refactor";
        (*args.add(2)) = c"--script";
        (*args.add(3)) = file;
        (*args.add(4)) = c"--root";
        (*args.add(5)) = root;
        (*args.add(6)) = c"--label";
        (*args.add(7)) = buf_cstr(label);
        let mut n: i64 = 8;
        if tcx.dry_run {
            (*args.add(n as usize)) = c"--dry-run";
            n += 1;
        }
        if tcx.no_check {
            (*args.add(n as usize)) = c"--no-check";
            n += 1;
        }
        if tcx.show {
            (*args.add(n as usize)) = c"--show";
            n += 1;
        }
        if tcx.target_name != 0 as *mut u8 {
            (*args.add(n as usize)) = c"--target";
            (*args.add((n + 1) as usize)) = tcx.target_name;
            n += 2;
        }
        // (0.20: a move in std's files)
        if pcx.std_tree != 0 as *mut u8 {
            (*args.add(n as usize)) = c"--std-tree";
            (*args.add((n + 1) as usize)) = pcx.std_tree;
            n += 2;
        }
        (*args.add(n as usize)) = 0 as *mut u8;
        write_diags(tcx);
        let status = run_inherit(args);
        remove_file(file);
        if status == 0 {
            let d = diag(c"note", c"refactor.made-module", tcx);
            buf_str(d, c"there was no module ");
            buf_bytes(d, buf_slice(path));
            buf_str(d, c"; it was made for the move (refactor new-module)\n");
        }
        status
    }
}

// Finds the item of --after or --before in module t (by its name there,
// or its path): false after a diagnostic.
fn find_anchor(t: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        tcx.place_before = tcx.opt_after == 0 as *mut u8;
        let name = c_slice(if tcx.place_before { tcx.opt_before } else { tcx.opt_after });
        // (a name of module t, or a path)
        let mut d: i64 = -1;
        if has_colons(name) {
            d = one_definition(c"move", name, c_slice(c""), tcx, pcx);
            if d < 0 {
                return false;
            }
        } else {
            d = item_binding(t, intern(name, pcx), tcx);
        }
        let mut moved = false;
        for i in 0..tcx.mv_def.count {
            if (*tcx.mv_def.data.add(i as usize)) == d {
                moved = true;
            }
        }
        let u: i64 = if d >= 0 && pcx.defs[d as usize].module == t && !moved { anchor_unit(d, tcx, pcx) }
            else { -1 };
        if u < 0 {
            let e = diag(c"error", c"refactor.anchor", tcx);
            buf_str(e, if tcx.place_before { c"--before " } else { c"--after " });
            buf_bytes(e, name);
            buf_str(e, c": not an item of ");
            buf_bytes(e, mod_fqn_text(t, tcx, pcx));
            buf_str(e,
                if moved { c" that stays there\n" }
                else { c" with lines of its own (a function, type, constant, static)\n" });
            let tr = try_begin(c"items", mod_fqn_text(t, tcx, pcx), true, tcx, pcx);
            try_end(tr);
            return false;
        }
        tcx.place_at = u;
        true
    }
}

// ---- split ----

// `refactor split MODULE --into NEWMOD --items a,b,c`: the items move to
// NEWMOD (made when it does not exist: a child of MODULE makes MODULE a
// dir module). `--plan`: the split of MODULE into parts of at most
// --max-lines lines (query deps's clustering, on its items with their impl
// blocks), as the commands that make it; `--auto`: that split, made in one
// edit.
pub fn run_split(name: &[u8], root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    tcx.tidy_after = true;
    let m = module_named(name, tcx, pcx);
    if m < 0 {
        return no_module(name, 0 as *mut u8, tcx, pcx);
    }
    if tcx.opt_reexport {
        tcx.split_from = m;
    }
    let f = own_file(m, pcx);
    if f < 0 {
        return inline_module(m, tcx, pcx);
    }
    load_refs(tcx, pcx);
    units_of(f, tcx, pcx);
    if tcx.opt_plan || tcx.opt_auto {
        return split_plan(m, f, root, tcx, pcx);
    }
    let mut segs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let into = c_slice(tcx.opt_into);
    if !path_segments(into, &mut segs, pcx) || segs.count == 0 {
        return crate::tools::refactor_mod::cli::usage(
            c"--into takes a module path (crate::a::b)", 0 as *mut u8, tcx, pcx);
    }
    let mut converts = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut t = make_path(segs, segs.count, false, &mut converts, tcx, pcx);
    if t == -2 {
        t = module_named(into, tcx, pcx);
    }
    if t < 0 {
        return 1;
    }
    if !is_new(t, pcx) && own_file(t, pcx) < 0 {
        return inline_module(t, tcx, pcx);
    }
    // The items, by their names in MODULE (or their paths).
    let items = c_slice(tcx.opt_items);
    let mut i: i64 = 0;
    while i < items.len() as i64 {
        let mut e = i;
        while e < items.len() as i64 && items[e as usize] != b',' {
            e += 1;
        }
        let w = &items[i as usize..e as usize];
        i = e + 1;
        if w.len() == 0 {
            continue;
        }
        let full = buf_new();
        if !has_colons(w) {
            buf_bytes(full, mod_fqn_text(m, tcx, pcx));
            buf_str(full, c"::");
        }
        buf_bytes(full, w);
        let d = one_definition(c"move", buf_slice(full), c_slice(c""), tcx, pcx);
        if d < 0 || !movable(d, tcx, pcx) {
            return 1;
        }
        tcx.mv_def.push(d);
        tcx.mv_dest.push(t);
    }
    if tcx.mv_def.count == 0 {
        return crate::tools::refactor_mod::cli::usage(c"--items names no item", 0 as *mut u8, tcx,
            pcx);
    }
    if !move_edits(tcx, pcx) {
        return 1;
    }
    emit_regions(tcx, pcx);
    let what = buf_new();
    buf_str(what, c"split ");
    buf_bytes(what, mod_fqn_text(m, tcx, pcx));
    buf_str(what, c": ");
    buf_int(what, tcx.mv_def.count);
    buf_str(what, if tcx.mv_def.count == 1 { c" item into " } else { c" items into " });
    buf_bytes(what, into);
    finish(what, root, tcx, pcx)
}

fn has_colons(s: &[u8]) -> bool {
    for i in 0..s.len() {
        if s[i] == b':' {
            return true;
        }
    }
    false
}
