// What the references need once items move: the imports to add and to
// remove, the `use` paths to rewrite (made by `refactor split
// crate::refactor_move --auto`, then renamed).

use crate::base::{
    buf_byte, buf_bytes, buf_len, buf_new, buf_slice, buf_str, get_src, intern, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::{module_at, module_of, within_std};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::node_head;
use crate::tools::query::{QF_DEF, QF_USE};
use crate::tools::query::defs::{K_IMPL_METHOD, K_METHOD, K_VARIANT, bytes_eq};
use crate::tools::query::diagnostics::sym_less;
use crate::tools::query::positions::{line_end, line_start, token_at};
use crate::tools::refactor_mod::{
    chain_public, collision, is_new, item_binding, path_start, put_edit, put_region_path, qualified,
    text_of, use_binding, use_id_at, use_node_of, within,
};
use crate::tools::refactor_mod::cli::user_pos;
use crate::tools::refactor_move::{later_edit, region_at};
use crate::tools::tidyimports::{put_use_text, relative_style};

// ---- Imports ----

fn reexport(d: i64, tcx: &mut Tcx<Comp>) {
    for i in 0..tcx.reex.len() as i64 {
        if (tcx.reex[i as usize]) == d {
            return;
        }
    }
    tcx.reex.push(d);
}

// The `pub use` lines of the module split with --reexport (a buffer, one
// line per part, each ending with a newline): what code outside uses of
// its parts, and what it imports of them itself (those imports are the
// re-exports).
pub fn reexport_lines(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    if tcx.split_from < 0 {
        return out;
    }
    for i in 0..tcx.im_region.len() as i64 {
        let d = (tcx.im_def[i as usize]);
        // (0.20: an item that was private is imported, not re-exported)
        if (tcx.im_region[i as usize]) == tcx.split_from
            && (tcx.im_name[i as usize]) == pcx.defs[d as usize].name
            && home(d, tcx, pcx) != tcx.split_from && pcx.defs[d as usize].public {
            reexport(d, tcx);
            (tcx.im_region[i as usize]) = -1;
        }
    }
    // (0.20) std's users are not in the program: a split of a module of
    // std's with --reexport keeps every `pub` item it moves at its path.
    if within_std(tcx.split_from, pcx) {
        for i in 0..tcx.mv_def.len() as i64 {
            if pcx.defs[(tcx.mv_def[i as usize]) as usize].public {
                reexport((tcx.mv_def[i as usize]), tcx);
            }
        }
    }
    let mut parts: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..tcx.reex.len() as i64 {
        let h = home((tcx.reex[i as usize]), tcx, pcx);
        let mut seen = false;
        for j in 0..parts.len() as i64 {
            if (parts[j as usize]) == h {
                seen = true;
            }
        }
        if !seen {
            parts.push(h);
        }
    }
    for j in 0..parts.len() as i64 {
        let p = (parts[j as usize]);
        let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut none: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..tcx.reex.len() as i64 {
            if home((tcx.reex[i as usize]), tcx, pcx) == p {
                names.push(pcx.defs[(tcx.reex[i as usize]) as usize].name);
            }
        }
        let path = buf_new();
        if crate::tools::refactor_mod::region_parent(p, tcx, pcx) == tcx.split_from {
            buf_bytes(path,
                sym_text(crate::tools::refactor_mod::region_name(p, tcx, pcx), pcx));
        } else {
            put_region_path(path, p, tcx, pcx);
        }
        put_use_text(out, &get_src()[0..0], true, buf_slice(path), names.as_slice(),
            none.as_slice(), pcx);
        buf_byte(out, b'\n');
    }
    out
}

// Name id of Use node u is removed.
pub fn remove_use_names(u: i64, id: i64, tcx: &mut Tcx<Comp>) {
    if tcx.imports_dropped.get(id) != 0 {
        return;
    }
    tcx.imports_dropped.put(id, 1);
    let mut seen = false;
    for i in 0..tcx.drop_uses.len() as i64 {
        if (tcx.drop_uses[i as usize]) == u {
            seen = true;
        }
    }
    if !seen {
        tcx.drop_uses.push(u);
    }
}

// The path definition d is imported from once the edit is made (its
// module's, or for a variant its enum's): `crate::a::b`.
fn import_path(out: i64, d: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let it = if pcx.defs[d as usize].kind == K_VARIANT { pcx.defs[d as usize].parent } else { d };
    let h = home(it, tcx, pcx);
    put_region_path(out, h, tcx, pcx);
    if it != d {
        buf_str(out, c"::");
        buf_bytes(out, sym_text(pcx.defs[it as usize].name, pcx));
    }
}

// (0.14) import_path as region r writes it: relative to r (`a::b`, not
// `crate::m::a::b`) when the module is inside r and r writes the paths of
// its child modules so (tidyimports::relative_style).
fn import_path_in(out: i64, d: i64, r: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let it = if pcx.defs[d as usize].kind == K_VARIANT { pcx.defs[d as usize].parent }
            else { d };
        let h = home(it, tcx, pcx);
        if r >= 0 && !is_new(r, pcx) && h != r && within(h, r, tcx, pcx)
            && relative_style(r, tcx, pcx) {
            let full = buf_new();
            put_region_path(full, h, tcx, pcx);
            let own = buf_new();
            put_region_path(own, r, tcx, pcx);
            let t = buf_slice(full);
            buf_bytes(out, &t[(buf_len(own) + 2) as usize..]);
            if it != d {
                buf_str(out, c"::");
                buf_bytes(out, sym_text(pcx.defs[it as usize].name, pcx));
            }
            return;
        }
        import_path(out, d, tcx, pcx);
    }
}

// The region an item is in after the edit.
fn home(d: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if !user_pos(pcx.defs[d as usize].start, pcx) {
        return module_at(pcx.defs[d as usize].start, pcx);
    }
    region_at(pcx.defs[d as usize].start, tcx, pcx)
}

// Region r needs definition d under name `name` (`again`: its import
// there is removed).
fn need_import(r: i64, d: i64, name: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    add_import(r, d, name, false, tcx, pcx);
}

fn add_import(r: i64, d: i64, name: i64, again: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..tcx.im_region.len() as i64 {
        if (tcx.im_region[i as usize]) == r
            && (tcx.im_name[i as usize]) == name {
            if (tcx.im_def[i as usize]) != d && !tcx.refused {
                tcx.refused = true;
                collision(sym_text(name, pcx), r, (tcx.im_def[i as usize]), true, tcx,
                    pcx);
            }
            return;
        }
    }
    if !is_new(r, pcx) {
        // What the name is there now: d (nothing to do), something
        // else that stays (a collision), or what leaves.
        let ib = item_binding(r, name, tcx);
        let uid = crate::tools::refactor_mod::use_binding_id(r, name, pcx);
        let ub = use_binding(r, name, pcx);
        if ib >= 0 && home(ib, tcx, pcx) == r {
            if ib != d && !tcx.refused {
                tcx.refused = true;
                collision(sym_text(name, pcx), r, ib, false, tcx, pcx);
            }
            return;
        }
        if ib < 0 && uid != 0 && tcx.imports_dropped.get(uid) == 0 {
            if ub != d && !tcx.refused {
                tcx.refused = true;
                collision(sym_text(name, pcx), r, ub, true, tcx, pcx);
            }
            if ub != d || !again {
                return;
            }
        }
    }
    // (an item moved there with that name)
    for i in 0..tcx.mv_def.len() as i64 {
        let x = (tcx.mv_def[i as usize]);
        if (tcx.mv_dest[i as usize]) == r && pcx.defs[x as usize].name == name
            && x != d && !tcx.refused {
            tcx.refused = true;
            collision(sym_text(name, pcx), r, x, false, tcx, pcx);
            return;
        }
    }
    tcx.im_region.push(r);
    tcx.im_def.push(d);
    tcx.im_name.push(name);
}

// The `use` line text of the imports of region r with path p (a buffer):
// `use p::a;`, `use p::{a, b};` (wrapped at 100 columns), and a line of
// its own for each name imported under another name.
fn put_use_lines(out: i64, p: &[u8], names: &[i64], defs: &[i64], pcx: &Ctx<Comp>) {
    unsafe {
        let mut plain: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..names.len() as i64 {
            let n = (names[i as usize]);
            let d = (defs[i as usize]);
            if n != pcx.defs[d as usize].name {
                buf_str(out, c"use ");
                buf_bytes(out, p);
                buf_str(out, c"::");
                buf_bytes(out, sym_text(pcx.defs[d as usize].name, pcx));
                buf_str(out, c" as ");
                buf_bytes(out, sym_text(n, pcx));
                buf_str(out, c";\n");
            } else {
                plain.push(n);
            }
        }
        if plain.len() as i64 == 0 {
            return;
        }
        let line = buf_new();
        buf_str(line, c"use ");
        buf_bytes(line, p);
        buf_str(line, c"::");
        if plain.len() as i64 == 1 {
            buf_bytes(line, sym_text((plain[0]), pcx));
            buf_str(line, c";\n");
            buf_bytes(out, buf_slice(line));
            return;
        }
        buf_byte(line, b'{');
        for i in 0..plain.len() as i64 {
            if i > 0 {
                buf_str(line, c", ");
            }
            buf_bytes(line, sym_text((plain[i as usize]), pcx));
        }
        buf_str(line, c"};\n");
        if buf_len(line) <= 101 {
            buf_bytes(out, buf_slice(line));
            return;
        }
        buf_str(out, c"use ");
        buf_bytes(out, p);
        buf_str(out, c"::{\n");
        let mut col: i64 = 0;
        for i in 0..plain.len() as i64 {
            let w = sym_text((plain[i as usize]), pcx);
            if col > 0 && col + 2 + w.len() as i64 + 1 > 100 {
                buf_str(out, c",\n");
                col = 0;
            } else if col > 0 {
                buf_str(out, c", ");
                col += 2;
            }
            if col == 0 {
                buf_str(out, c"    ");
                col = 4;
            }
            buf_bytes(out, w);
            col += w.len() as i64;
        }
        buf_str(out, c",\n};\n");
    }
}

// The import lines of region r (sorted by path, then name).
pub fn region_uses(r: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut idx: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut paths: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..tcx.im_region.len() as i64 {
        if (tcx.im_region[i as usize]) == r {
            idx.push(i);
            let b = buf_new();
            import_path_in(b, (tcx.im_def[i as usize]), r, tcx, pcx);
            paths.push(intern(buf_slice(b), pcx));
        }
    }
    // (by path, then name)
    for i in 1..idx.len() as i64 {
        let mut j = i;
        while j > 0
            && (sym_less((paths[j as usize]), (paths[(j - 1) as usize]),
                pcx)
                || ((paths[j as usize]) == (paths[(j - 1) as usize])
                    && sym_less((tcx.im_name[(idx[j as usize]) as usize]),
                        (tcx.im_name[(idx[(j - 1) as usize]) as usize]),
                        pcx))) {
            let t = (idx[j as usize]);
            (idx[j as usize]) = (idx[(j - 1) as usize]);
            (idx[(j - 1) as usize]) = t;
            let s = (paths[j as usize]);
            (paths[j as usize]) = (paths[(j - 1) as usize]);
            (paths[(j - 1) as usize]) = s;
            j -= 1;
        }
    }
    let out = buf_new();
    let mut i: i64 = 0;
    while i < idx.len() as i64 {
        let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut defs: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut j = i;
        while j < idx.len() as i64 && (paths[j as usize]) == (paths[i as usize]) {
            names.push((tcx.im_name[(idx[j as usize]) as usize]));
            defs.push((tcx.im_def[(idx[j as usize]) as usize]));
            j += 1;
        }
        put_use_lines(out, sym_text((paths[i as usize]), pcx), names.as_slice(), defs.as_slice(),
            pcx);
        i = j;
    }
    out
}

// The references of the program, in turn: what each needs once the moves
// are made. False after a diagnostic.
pub fn analyze(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut pubbed = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for k in 0..tcx.refs.len() as i64 {
        let r = (tcx.refs[k as usize]);
        let p = (tcx.r_pos[r as usize]);
        let d = (tcx.r_def[r as usize]);
        let flags = (tcx.r_flags[r as usize]);
        if (flags & QF_DEF) != 0 || !user_pos(p, pcx) {
            continue;
        }
        let kd = pcx.defs[d as usize].kind;
        let mut it = d;
        if kd == K_VARIANT {
            it = pcx.defs[d as usize].parent;
        } else if pcx.defs[d as usize].parent >= 0 || kd == K_METHOD || kd == K_IMPL_METHOD {
            continue;
        }
        let old_home = module_at(pcx.defs[it as usize].start, pcx);
        let new_home = home(it, tcx, pcx);
        let old_reg = module_at(p, pcx);
        let new_reg = region_at(p, tcx, pcx);
        let moved_item = old_home != new_home;
        let moved_code = old_reg != new_reg;
        if !moved_item && !moved_code {
            continue;
        }
        if tcx.split_from >= 0 && moved_item && !within(old_reg, tcx.split_from, tcx, pcx) {
            // (split --reexport: code outside the module is left as it
            // is, the module re-exports the item)
            if user_pos(pcx.defs[it as usize].start, pcx) && !pcx.defs[it as usize].public
                && pubbed.get(it + 1) == 0 {
                pubbed.put(it + 1, 1);
                later_edit(pcx.defs[it as usize].start, pcx.defs[it as usize].start,
                    text_of(b"pub "), tcx);
            }
            reexport(it, tcx);
            continue;
        }
        let ti = token_at(p, pcx);
        if ti >= pcx.toks.len() as i64 || pcx.toks[ti as usize].start != p
            || pcx.toks[ti as usize].kind != Tok::Ident {
            continue;
        }
        let name = pcx.toks[ti as usize].value as i64;
        let use_ref = (flags & QF_USE) != 0;
        // Visible from where it is used.
        let from = if use_ref { old_reg } else { new_reg };
        if user_pos(pcx.defs[it as usize].start, pcx) && !pcx.defs[it as usize].public
            && !within(from, new_home, tcx, pcx)
            && pubbed.get(it + 1) == 0 {
            pubbed.put(it + 1, 1);
            later_edit(pcx.defs[it as usize].start, pcx.defs[it as usize].start,
                text_of(b"pub "), tcx);
        }
        chain_public(from, new_home, tcx, pcx);
        if use_ref {
            if moved_item {
                let id = use_id_at(p, tcx);
                if id != 0 {
                    if old_reg == new_home && d == it && pcx.nodes[id as usize].b == 0 {
                        remove_use_names(use_node_of(id, tcx), id, tcx);
                    } else {
                        tcx.mu_id.push(id);
                        tcx.mu_def.push(d);
                        let b = buf_new();
                        import_path_in(b, d, module_of(use_node_of(id, tcx), pcx), tcx, pcx);
                        tcx.mu_path.push(b);
                    }
                }
            }
            continue;
        }
        if qualified(p, pcx) {
            if moved_item && d == it {
                let b = buf_new();
                put_region_path(b, new_home, tcx, pcx);
                buf_str(b, c"::");
                later_edit(path_start(p, pcx), p, b, tcx);
            }
            continue;
        }
        let via_import = use_binding(old_reg, name, pcx) == d;
        let was_local = old_home == old_reg && d == it && name == pcx.defs[d as usize].name
            && !via_import;
        if new_home == new_reg && d == it {
            continue;
        }
        if !moved_code {
            if was_local {
                need_import(new_reg, d, name, tcx, pcx);
            }
            continue;
        }
        if via_import || was_local {
            need_import(new_reg, d, name, tcx, pcx);
        }
    }
    !tcx.refused
}

// The imports of moved items: a `use` whose names all move to one module
// gets that module's path; else the names leave it for `use` lines of
// their own.
pub fn rewrite_imports(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..tcx.mu_id.len() as i64 {
        let id = (tcx.mu_id[i as usize]);
        let u = use_node_of(id, tcx);
        if tcx.repath.get(u) != 0 || tcx.imports_dropped.get(id) != 0 {
            continue;
        }
        // Every name of u moves, to one place?
        let mut all = true;
        for k in 0..pcx.nodes[u as usize].count {
            let c = child(u, k, pcx);
            let mut found = false;
            for j in 0..tcx.mu_id.len() as i64 {
                if (tcx.mu_id[j as usize]) == c
                    && same_bytes_buf((tcx.mu_path[j as usize]),
                        (tcx.mu_path[i as usize])) {
                    found = true;
                }
            }
            if !found || tcx.imports_dropped.get(c) != 0 {
                all = false;
            }
        }
        if all {
            tcx.repath.put(u, (tcx.mu_path[i as usize]));
            continue;
        }
    }
    for i in 0..tcx.mu_id.len() as i64 {
        let id = (tcx.mu_id[i as usize]);
        let u = use_node_of(id, tcx);
        if tcx.repath.get(u) != 0 {
            continue;
        }
        remove_use_names(u, id, tcx);
        add_import(module_of(u, pcx), (tcx.mu_def[i as usize]),
            crate::tools::refactor_mod::use_local(id, pcx), true, tcx, pcx);
    }
}

fn same_bytes_buf(a: i64, b: i64) -> bool {
    bytes_eq(buf_slice(a), buf_slice(b))
}

// Whether only blanks are before pos on its line, and after end (or a
// comment).
fn alone_on_lines(pos: i64, end: i64, pcx: &Ctx<Comp>) -> bool {
    let mut p = line_start(pos, pcx);
    while p < pos && (get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t') {
        p += 1;
    }
    if p != pos {
        return false;
    }
    let e = line_end(end, pcx);
    let mut q = end;
    while q < e
        && (get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t'
            || get_src()[q as usize] == b'\r') {
        q += 1;
    }
    q == e || (q + 1 < e && get_src()[q as usize] == b'/' && get_src()[(q + 1) as usize] == b'/')
}

// The edits of the `use` items: the names removed, the paths rewritten.
pub fn emit_use_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..tcx.drop_uses.len() as i64 {
        let u = (tcx.drop_uses[i as usize]);
        let n = pcx.nodes[u as usize].count;
        let mut gone: i64 = 0;
        for k in 0..n {
            if tcx.imports_dropped.get(child(u, k, pcx)) != 0 {
                gone += 1;
            }
        }
        if gone == n {
            let head = node_head(pcx.nodes[u as usize].start, pcx);
            if alone_on_lines(head, pcx.nodes[u as usize].end, pcx) {
                delete_lines(line_start(head, pcx), pcx.nodes[u as usize].end, pcx);
            } else {
                put_edit(head, pcx.nodes[u as usize].end, buf_new(), tcx, pcx);
            }
            continue;
        }
        // (each name with what follows it up to the next; the last ones
        // from the end of the one before)
        let mut last_kept: i64 = -1;
        for k in 0..n {
            if tcx.imports_dropped.get(child(u, k, pcx)) == 0 {
                last_kept = k;
            }
        }
        if n - gone == 1 && crate::tools::refactor_mod::braced(u, pcx)
            && line_start(pcx.nodes[u as usize].start, pcx)
            == line_start(pcx.nodes[u as usize].end, pcx) {
            // (one name left: `use p::{a};` is `use p::a;`)
            let mut open = pcx.nodes[pcx.nodes[u as usize].c as usize].end;
            while get_src()[open as usize] != b'{' {
                open += 1;
            }
            let mut close = pcx.nodes[u as usize].end;
            while get_src()[close as usize] != b'}' {
                close -= 1;
            }
            let kept = child(u, last_kept, pcx);
            put_edit(open, close + 1,
                text_of(
                    &get_src()[
                        pcx.nodes[kept as usize].start as usize..pcx.nodes[kept as usize].end as usize]), tcx, pcx);
            continue;
        }
        for k in 0..n {
            if tcx.imports_dropped.get(child(u, k, pcx)) == 0 {
                continue;
            }
            if k < last_kept {
                put_edit(pcx.nodes[child(u, k, pcx) as usize].start,
                    pcx.nodes[child(u, k + 1, pcx) as usize].start, buf_new(), tcx, pcx);
            } else {
                put_edit(pcx.nodes[child(u, last_kept, pcx) as usize].end,
                    pcx.nodes[child(u, n - 1, pcx) as usize].end, buf_new(), tcx, pcx);
                break;
            }
        }
    }
    for u in 1..pcx.nodes.len() as i64 {
        let t = tcx.repath.get(u);
        if t != 0 && pcx.nodes[u as usize].kind == NodeKind::Use {
            // (the path's segments: its node goes on to the names)
            let c = pcx.nodes[u as usize].c;
            put_edit(pcx.nodes[c as usize].start,
                pcx.nodes[child(c, pcx.nodes[c as usize].count - 1, pcx) as usize].end, t, tcx,
                pcx);
        }
    }
}
