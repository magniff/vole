// Where moved text goes: move --after, --before (0.13)

use crate::base::{SRC, buf_byte, buf_bytes, buf_new};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::edit::items::{after_line, blank_line};
use crate::tools::query::positions::line_start;
use crate::tools::refactor_mod::{comment_line, put_edit};
use crate::tools::refactor_move::units::{U_OTHER, closing, lines_of, unit_at, units_of};

// Whether a banner moved with the text may head it where it goes: at a
// module's end; else (move --after, --before) where a banner group ends
// (after an item followed by a banner, or by nothing).
pub fn place_ends_group(tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if tcx.place_at < 0 {
            return true;
        }
        let f = tcx.un_file.data[tcx.place_at];
        if !tcx.place_before {
            var e = tcx.un_end.data[tcx.place_at];
            while e < pcx.files[f].end && blank_line(e, pcx) {
                e = after_line(e, pcx);
            }
            if e >= pcx.files[f].end || (unit_starting(f, e, tcx) < 0 && comment_line(e)) {
                return true;
            }
        }
        false
    }
}

// The unit of item d (its file's units made), -1 when it has none of its
// own (a method, a function of an extern block).
pub fn anchor_unit(d: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    units_of(file_of_pos(pcx.defs[d].start, pcx), &tcx, &pcx);
    tcx.unit_of.get(d + 1) - 1
}

// The run key of the unit at pos: its keyword (after attributes and
// `pub`) + 1 when its code is one line (a constant, a static, a `use`),
// else 0. Items of one key are written in runs, without blank lines.
pub fn run_key_at(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let u = unit_at(pos, tcx);
    if u < 0 {
        return 0;
    }
    run_key(u, tcx, pcx)
}

fn run_key(u: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if u < 0 {
            return 0;
        }
        var i = tcx.un_first.data[u];
        while pcx.toks[i].kind == Tok::Hash && pcx.toks[i + 1].kind == Tok::LBracket {
            i = closing(i + 1, pcx) + 1;
        }
        if pcx.toks[i].kind == Tok::Pub {
            i += 1;
        }
        if line_start(pcx.toks[i].start, pcx)
            != line_start(pcx.toks[tcx.un_last.data[u]].start, pcx) {
            return 0;
        }
        pcx.toks[i].kind as i64 + 1
    }
}

// The blank lines of SRC[a..b).
fn newlines(a: i64, b: i64) -> i64 {
    lines_of(a, b)
}

// The unit of file f ending at pos (-1), starting at pos (-1).
fn unit_ending(f: i64, pos: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        for u in 0..tcx.un_start.count {
            if tcx.un_file.data[u] == f && tcx.un_end.data[u] == pos {
                return u;
            }
        }
        -1
    }
}

fn unit_starting(f: i64, pos: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        for u in 0..tcx.un_start.count {
            if tcx.un_file.data[u] == f && tcx.un_start.data[u] == pos {
                return u;
            }
        }
        -1
    }
}

// The blank lines a run of key k is written with here, from the units
// around the gap (p before it, q after it, g blank lines between; g < 0:
// p and q are not next to each other): p and q themselves, else p and
// the one before it, else q and the one after, else the moved text's own
// run (RUN_KEY, RUN_GAP); 0 when none tells.
fn run_gap(k: i64, p: i64, q: i64, g: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if g >= 0 && p >= 0 && q >= 0 && run_key(p, tcx, pcx) == k && run_key(q, tcx, pcx) == k {
            return g;
        }
        if p > 0 && tcx.un_file.data[p - 1] == tcx.un_file.data[p] && run_key(p - 1, tcx, pcx) == k
            && run_key(p, tcx, pcx) == k
            && tcx.un_banner.data[p] < 0 {
            return newlines(tcx.un_end.data[p - 1], tcx.un_start.data[p]);
        }
        if q >= 0 && q + 1 < tcx.un_start.count && tcx.un_file.data[q + 1] == tcx.un_file.data[q]
            && run_key(q, tcx, pcx) == k
            && run_key(q + 1, tcx, pcx) == k && tcx.un_banner.data[q + 1] < 0 {
            return newlines(tcx.un_end.data[q], tcx.un_start.data[q + 1]);
        }
        if tcx.run_key == k {
            return tcx.run_gap;
        }
        0
    }
}

// The moved text `body` (whole lines; its first and last units' run keys)
// put next to unit a: after it, or before it (`before`), into the blank
// lines between a and its neighbour. The blank lines there stay with the
// unit after them; the text gets one blank line before it (none at the
// file's start), or joins a run of one-line items of its kind (constants,
// statics) as the run is written there. After a `use` line, a banner or a
// header, the blank lines there stay before the text (other edits may
// change what is above). So delete_moved, then this, put the lines back
// as they were when the text had one blank line before it (or was in a
// run).
pub fn place_moved(a: i64, before: bool, body: [u8], first_key: i64, last_key: i64,
    tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let f = tcx.un_file.data[a];
        var gs = tcx.un_end.data[a];
        var ge = gs;
        if before {
            ge = tcx.un_start.data[a];
            gs = ge;
            while gs > pcx.files[f].start && blank_line(line_start(gs - 1, pcx), pcx) {
                gs = line_start(gs - 1, pcx);
            }
        } else {
            while ge < pcx.files[f].end && blank_line(ge, pcx) {
                ge = after_line(ge, pcx);
            }
        }
        var p = if before { unit_ending(f, gs, tcx) } else { a };
        // (after a and a banner that heads nothing, before another banner
        // or the file's end: under that banner)
        if !before && ge < pcx.files[f].end && unit_starting(f, ge, tcx) < 0 && comment_line(ge) {
            var be = ge;
            while be < pcx.files[f].end && comment_line(be) {
                be = after_line(be, pcx);
            }
            var ne = be;
            while ne < pcx.files[f].end && blank_line(ne, pcx) {
                ne = after_line(ne, pcx);
            }
            if ne >= pcx.files[f].end || (unit_starting(f, ne, tcx) < 0 && comment_line(ne)) {
                gs = be;
                ge = ne;
                p = -1;
            }
        }
        let q = if before { a } else { unit_starting(f, ge, tcx) };
        let g = newlines(gs, ge);
        let rp = first_key > 0 && run_key(p, tcx, pcx) == first_key;
        let rq = last_key > 0 && run_key(q, tcx, pcx) == last_key;
        let text = buf_new();
        if gs == pcx.files[f].end && gs > pcx.files[f].start && SRC[gs - 1] != '\n' {
            buf_byte(text, '\n');
        }
        var g1 = if gs == pcx.files[f].start { 0 }
            else if rp { run_gap(first_key, p, q, g, tcx, pcx) } else if rq { g } else { 1 };
        let g2 = if ge >= pcx.files[f].end { g } else if rq { run_gap(last_key, p, q, g, tcx, pcx) }
            else if g == 0 { 1 } else { g };
        if !rp && (p < 0 || tcx.un_kind.data[p] == U_OTHER) && ge < pcx.files[f].end && g > 0 {
            gs = ge;
            g1 = 0;
        }
        for _ in 0..g1 {
            buf_byte(text, '\n');
        }
        buf_bytes(text, body);
        for _ in 0..g2 {
            buf_byte(text, '\n');
        }
        put_edit(gs, ge, text, &tcx, &pcx);
    }
}

// The edit removing the moved lines SRC[a..b) (whole lines, at the top
// level of a file; the run keys of their first and last units), with the
// blank lines on one side: the ones after them stay, for the unit after
// them; the ones before, when the lines start a run of one-line items
// that goes on after them (or are at the file's start). Lines that were
// inside a run of another kind (a function between two constants) leave
// it joined, as the run is written there; lines that started in a run
// and ended out of it, the blank lines before them. (After a `use` line, a banner
// or a header, the blank lines after them go: those before stay with what
// is above, which other edits may remove.)
pub fn delete_moved(a: i64, b: i64, first_key: i64, last_key: i64, tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>) {
    unsafe {
        let f = file_of_pos(a, pcx);
        var gs = a;
        while gs > pcx.files[f].start && blank_line(line_start(gs - 1, pcx), pcx) {
            gs = line_start(gs - 1, pcx);
        }
        var ge = b;
        while ge < pcx.files[f].end && blank_line(ge, pcx) {
            ge = after_line(ge, pcx);
        }
        let p = unit_ending(f, gs, tcx);
        let q = unit_starting(f, ge, tcx);
        let rp = first_key > 0 && run_key(p, tcx, pcx) == first_key;
        let rq = last_key > 0 && run_key(q, tcx, pcx) == last_key;
        let k = run_key(p, tcx, pcx);
        let joined = k > 0 && run_key(q, tcx, pcx) == k;
        if !rp && !rq && joined && gs > pcx.files[f].start {
            let text = buf_new();
            for _ in 0..run_gap(k, p, q, -1, tcx, pcx) {
                buf_byte(text, '\n');
            }
            put_edit(gs, ge, text, &tcx, &pcx);
        }
        else if gs == pcx.files[f].start || (rq && !rp) || (rp && !rq && joined)
            || ((p < 0 || tcx.un_kind.data[p] == U_OTHER) && ge < pcx.files[f].end) {
            put_edit(a, ge, buf_new(), &tcx, &pcx);
        } else {
            put_edit(gs, b, buf_new(), &tcx, &pcx);
        }
    }
}
