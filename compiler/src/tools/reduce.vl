// `volec reduce` (0.17): a failing input made small, line by line.
//
//     volec reduce FILE --until 'CMD' [--out FILE] [--max-runs N]
//
// CMD (run by `sh -c`, `{}` replaced by the candidate's path) exits with 0
// while the candidate still shows the failure: `./prog < {} | grep -q
// wrong`, `./prog < {}; test $? = 101`, `volec {} -o /dev/null 2>&1 |
// grep -q 'internal'`. Delta debugging on the lines: chunks of the lines
// left out while CMD still holds, halving the chunks when none can go.
// FILE is not changed; the result is written to FILE.min (--out), and
// printed when short. The candidate keeps FILE's name, in .volec/reduce/
// next to it (a program's root named the same).

mod program;

use crate::base::{
    STDOUT, buf_append, buf_byte, buf_bytes, buf_copy, buf_int, buf_new, buf_str, buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_MISSING, EV_WORD, Leaf, is_opt, option, table};
use crate::tools::ctx::{Tcx, cptrs};
use crate::tools::proc::{buf_cstr, read_file_if, remove_file, scratch_dir, write_file_if};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::diagnostics::{diag, write_diags};
use crate::tools::reduce::program::{program_mode, program_option, program_opts, reduce_program};

// UNSAFE: POSIX's process, signal and descriptor functions: the reducer's
// command runs in a process group of its own, killed past its time limit.
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn fork() -> i32;
    fn execvp(file: *const u8, argv: *const *const u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn setpgid(pid: i32, group: i32) -> i32;
    fn kill(pid: i32, sig: i32) -> i32;
    fn usleep(us: u32) -> i32;
    fn open(path: *const u8, flags: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn _exit(code: i32) -> !;
}

pub fn run_reduce(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let status = reduce_inner(c, tcx, pcx);
    write_diags(tcx);
    status
}

fn usage(why: *const u8, word: *const u8, tcx: &mut Tcx<Comp>) -> i64 {
    let d = diag(c"error", c"reduce.usage", tcx);
    buf_str(d, why);
    if word != 0 as *mut u8 {
        buf_str(d, c" '");
        buf_str(d, word);
        buf_byte(d, b'\'');
    }
    buf_str(d, c"; usage: volec reduce FILE --until 'CMD' [--out FILE] [--max-runs N] [--timeout S] ({} in CMD: the candidate; exit 0: it still fails); volec reduce PROG.vl --differs [--input F] | --fails 'TEXT' | --test NAME [--differs] (a program made small)\n");
    2
}

// The candidate's path: NAME (FILE's) in the scratch directory of FILE
// (0.25.2: out of its source tree, proc::scratch_dir; removed after the
// run).
fn candidate_path(file: *const u8, pcx: &Ctx<Comp>) -> *mut u8 {
    let s = crate::tools::query::c_slice(file);
    let mut slash = s.len() as i64;
    while slash > 0 && s[(slash - 1) as usize] != b'/' {
        slash -= 1;
    }
    let b = buf_new();
    buf_str(b, scratch_dir(file, b"reduce", pcx));
    buf_byte(b, b'/');
    buf_bytes(b, &s[slash as usize..]);
    buf_cstr(b)
}

// CMD with each `{}` replaced by path.
fn command_for(cmd: *const u8, path: *mut u8) -> *mut u8 {
    let s = c_slice(cmd);
    let b = buf_new();
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        if i + 1 < s.len() as i64 && s[i as usize] == b'{' && s[(i + 1) as usize] == b'}' {
            buf_byte(b, b'\'');
            buf_str(b, path);
            buf_byte(b, b'\'');
            i += 2;
        } else {
            buf_byte(b, s[i as usize]);
            i += 1;
        }
    }
    buf_cstr(b)
}

// Runs `sh -c cmd` (its output dropped) in a process group of its own,
// killed with it after TIMEOUT seconds: whether it exited with 0.
fn run_limited(cmd: *mut u8, tcx: &mut Tcx<Comp>) -> bool {
    // UNSAFE: fork, setpgid, open, dup2, close, execvp, _exit, waitpid, kill
    // and usleep are C's: the command runs in a process group of its own.
    // SAFETY: cmd is a C string of the caller's; argv is a list of three C
    // strings and a null, made in the child and alive until exec; pid > 0
    // is the child just forked, and the group killed (-pid) is the one the
    // child made for itself with setpgid(0, 0); status is a local.
    unsafe {
        let pid = fork();
        if pid < 0 {
            return false;
        }
        if pid == 0 {
            setpgid(0, 0);
            let null = open(c"/dev/null", 1);
            if null >= 0 {
                dup2(null, 1);
                dup2(null, 2);
                close(null);
            }
            let mut argv = cptrs(4i64);
            (argv[0]) = c"sh";
            (argv[1]) = c"-c";
            (argv[2]) = cmd;
            (argv[3]) = 0 as *mut u8;
            execvp(c"sh", argv.as_mut_ptr());
            _exit(127);
        }
        let mut status = 0 as i32;
        let mut waited: i64 = 0;
        loop {
            let r = waitpid(pid, &mut status, 1);
            if r == pid {
                break;
            }
            if r < 0 || waited >= tcx.reduce_timeout * 100 {
                kill(0 - pid, 9);
                waitpid(pid, &mut status, 0);
                tcx.timed_out += 1;
                return false;
            }
            usleep(10000);
            waited += 1;
        }
        // (the group's other processes: gone with it)
        kill(0 - pid, 9);
        let s = status as i64;
        (s & 127) == 0 && ((s >> 8) & 255) == 0
    }
}

// Whether CMD holds (exits 0) on the lines `keep` of `lines` (each a
// slice's start and end in text), written to path.
fn holds(text: &[u8], lines: &[i64], keep: &[i64], path: *mut u8, cmd: *mut u8, tcx: &mut Tcx<Comp>) -> bool {
    let b = buf_new();
    for i in 0..keep.len() as i64 {
        let l = (keep[i as usize]);
        buf_bytes(b,
            &text[
                (lines[(2 * l) as usize]) as usize..(lines[(2 * l + 1) as usize]) as usize]);
    }
    write_file_if(path, &buf_copy(b));
    tcx.reduce_runs += 1;
    run_limited(cmd, tcx)
}

// `reduce`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn reduce_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    // (0.18 T3: --differs, --fails, --test, --input over a program;
    // tools/reduce/program.vl)
    program_opts(&mut opts);
    opts.push(option("until", "CMD", "the command that holds (exits 0) on the file"));
    opts.push(option("out", "FILE", "where the result goes (FILE.min)"));
    opts.push(option("max-runs", "N", "at most N runs"));
    opts.push(option("timeout", "S", "a run stopped after S seconds"));
    Leaf::new(opts, "file")
}

fn reduce_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let mut file = 0 as *const u8;
    let mut until = 0 as *const u8;
    let mut out = 0 as *const u8;
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if program_option(ev, tcx) {
            continue;
        }
        if ev.kind == EV_MISSING && ev.name != "input" {
            return usage(c"a value is needed after", a, tcx);
        }
        if is_opt(ev, "until") {
            until = a;
        } else if is_opt(ev, "out") {
            out = a;
        } else if is_opt(ev, "timeout") {
            tcx.reduce_timeout = parse_count(a);
            if tcx.reduce_timeout <= 0 {
                return usage(c"--timeout takes a number of seconds, not", a, tcx);
            }
        } else if is_opt(ev, "max-runs") {
            tcx.reduce_max_runs = parse_count(a);
            if tcx.reduce_max_runs <= 0 {
                return usage(c"--max-runs takes a number, not", a, tcx);
            }
        } else if ev.kind != EV_WORD || (ev.text.starts_with("-") && ev.text.len() > 1) {
            return usage(c"unknown option", a, tcx);
        } else if file != 0 as *mut u8 {
            return usage(c"one FILE at most; a second", a, tcx);
        } else {
            file = a;
        }
    }
    if program_mode(tcx) {
        if file == 0 as *mut u8 {
            return usage(c"the program's root file is needed", 0 as *mut u8, tcx);
        }
        return reduce_program(file, out,
            if tcx.reduce_max_runs != 500 { tcx.reduce_max_runs } else { 0 }, tcx, pcx);
    }
    if file == 0 as *mut u8 || until == 0 as *mut u8 {
        return usage(c"FILE and --until 'CMD' are needed", 0 as *mut u8, tcx);
    }
    let original = buf_new();
    if !read_file_if(file, original) {
        let d = diag(c"error", c"reduce.no-file", tcx);
        buf_str(d, c"cannot read '");
        buf_str(d, file);
        buf_str(d, c"'\n");
        return 2;
    }
    let text = buf_copy(original);
    // The lines: start and end (with its newline) of each.
    let mut lines: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut s: i64 = 0;
    for k in 0..text.len() as i64 {
        if text[k as usize] == b'\n' {
            lines.push(s);
            lines.push(k + 1);
            s = k + 1;
        }
    }
    if s < text.len() as i64 {
        lines.push(s);
        lines.push(text.len() as i64);
    }
    let n_lines = lines.len() as i64 / 2;
    let mut keep: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..n_lines {
        keep.push(k);
    }
    let path = candidate_path(file, pcx);
    let cmd = command_for(until, path);
    if !holds(&text, lines.as_slice(), keep.as_slice(), path, cmd, tcx) {
        remove_file(path);
        let d = diag(c"error", c"reduce.not-failing", tcx);
        buf_str(d, c"the command does not hold (exit 0) on ");
        buf_str(d, file);
        buf_str(d, c" as it is: ");
        buf_str(d, cmd);
        buf_byte(d, b'\n');
        return 1;
    }
    // Delta debugging: chunks of the lines left out.
    let mut parts: i64 = 2;
    while keep.len() as i64 >= 2 && tcx.reduce_runs < tcx.reduce_max_runs {
        let size = (keep.len() as i64 + parts - 1) / parts;
        let mut gone = false;
        let mut start: i64 = 0;
        while start < keep.len() as i64 && tcx.reduce_runs < tcx.reduce_max_runs {
            let mut rest: Vec<i64, Comp> = Vec::new_in(Comp {});
            for k in 0..keep.len() as i64 {
                if k < start || k >= start + size {
                    rest.push((keep[k as usize]));
                }
            }
            if rest.len() as i64 > 0
                && holds(&text, lines.as_slice(), rest.as_slice(), path, cmd, tcx) {
                keep = rest;
                gone = true;
                // (the same chunk position holds new lines now)
            } else {
                start += size;
            }
        }
        if gone {
            parts = if parts > 2 { parts - 1 } else { 2 };
        } else {
            if parts >= keep.len() as i64 {
                break;
            }
            parts = if parts * 2 < keep.len() as i64 { parts * 2 } else { keep.len() as i64 };
        }
    }
    // The result, written and shown.
    let result = buf_new();
    for k in 0..keep.len() as i64 {
        let l = (keep[k as usize]);
        buf_bytes(result,
            &text[
                (lines[(2 * l) as usize]) as usize..(lines[(2 * l + 1) as usize]) as usize]);
    }
    let target = if out != 0 as *mut u8 { out } else {
        let b = buf_new();
        buf_str(b, file);
        buf_bytes(b, b".min");
        buf_cstr(b)
    };
    write_file_if(target, &buf_copy(result));
    remove_file(path);
    let o = buf_new();
    buf_bytes(o, b"reduced ");
    buf_str(o, file);
    buf_bytes(o, b": ");
    buf_int(o, n_lines);
    buf_bytes(o, b" lines to ");
    buf_int(o, keep.len() as i64);
    buf_bytes(o, b" in ");
    buf_int(o, tcx.reduce_runs);
    buf_bytes(o, b" runs");
    if tcx.reduce_runs >= tcx.reduce_max_runs {
        buf_bytes(o, b" (--max-runs reached: not minimal)");
    }
    if tcx.timed_out > 0 {
        buf_bytes(o, b" (");
        buf_int(o, tcx.timed_out);
        buf_bytes(o, b" stopped after --timeout S: taken as not failing)");
    }
    buf_bytes(o, b"; written to ");
    buf_str(o, target);
    buf_byte(o, b'\n');
    if keep.len() as i64 <= 30 {
        buf_append(o, result);
        let r = buf_copy(result);
        if r.len() > 0 && r[(r.len() as i64 - 1) as usize] != b'\n' {
            buf_byte(o, b'\n');
        }
    }
    buf_write_fd(o, STDOUT);
    0
}
