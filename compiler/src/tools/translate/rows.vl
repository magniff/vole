// (0.27.3) The translator's std calls (mod.vl, pass 5): each call of an
// MVS std item with a row in compiler/std2/rewrite.tsv (table.vl's
// rewrite_rows) is rewritten by the first row whose condition holds,
// chosen by type: the receiver's element, key or value type (`T: Copy`),
// what the call's value is used for (`use=read`), its pattern's type.
// The calls are taken innermost first, and a row's `$r`, `$1`, ... are
// its operands' rewritten text (the edits inside the call, made by the
// passes before, are folded into the one edit of the call). A row `!`
// is left to hand, and reported; `-` takes the statement away.

use crate::base::{IntVec, SRC, buf_byte, buf_bytes, buf_new, buf_slice, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::types::{TyKind, buf_type};
use crate::tools::edit::edit_replace;
use crate::tools::translate::{
    TC_STD, TL_ROW, Tr, editable, is_ref, own_node, parent_of, token_at, word_here,
};

// ---- The text so far ----

// SRC[a..b) with the edits made inside it applied (an insertion at a only
// when with_start).
fn render(a: i64, b: i64, with_start: bool, out: i64, pcx: Ctx<Comp>) {
    var idx = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let e = pcx.e_end.get(i);
        if s >= a && e <= b && (s > a || with_start || e > s) {
            idx.push(i);
        }
    }
    // (in position order; an insertion before a replacement at its start,
    // insertions in the order they were made)
    var k: i64 = 1;
    while k < idx.count {
        var j = k;
        while j > 0 && before(idx.get(j), idx.get(j - 1), pcx) {
            let t = idx.get(j);
            idx.set(j, idx.get(j - 1));
            idx.set(j - 1, t);
            j -= 1;
        }
        k += 1;
    }
    var p = a;
    for q in 0..idx.count {
        let i = idx.get(q);
        let s = pcx.e_start.get(i);
        if s > p {
            buf_bytes(out, SRC[p..s]);
        }
        buf_bytes(out, buf_slice(pcx.e_text.get(i)));
        p = if pcx.e_end.get(i) > p { pcx.e_end.get(i) } else { p };
    }
    if p < b {
        buf_bytes(out, SRC[p..b]);
    }
}

fn before(x: i64, y: i64, pcx: Ctx<Comp>) -> bool {
    let sx = pcx.e_start.get(x);
    let sy = pcx.e_start.get(y);
    if sx != sy {
        return sx < sy;
    }
    let ix = pcx.e_end.get(x) == sx;
    let iy = pcx.e_end.get(y) == sy;
    ix && !iy
}

// The edits strictly inside [a, b) taken back (the call's edit holds them).
fn drop_inside(a: i64, b: i64, pcx: inout Ctx<Comp>) {
    var w: i64 = 0;
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let e = pcx.e_end.get(i);
        let inside = s >= a && e <= b && !(s == e && (s == a || s == b));
        if !inside {
            pcx.e_start.set(w, s);
            pcx.e_end.set(w, e);
            pcx.e_text.set(w, pcx.e_text.get(i));
            w += 1;
        }
    }
    pcx.e_start.count = w;
    pcx.e_end.count = w;
    pcx.e_text.count = w;
}

// ---- The call ----

// The name of the MVS item type t is (its template's: `Vec`, `Option`),
// `[T]` for a slice, `str`; "" for another.
fn owner_name(t0: i64, pcx: Ctx<Comp>) -> [u8] {
    var t = t0;
    if t > 0 && pcx.types[t].kind == TyKind::Ptr {
        t = pcx.types[t].a;
    }
    if t <= 0 {
        return "";
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Slice {
        return "[T]";
    }
    if k == TyKind::Struct {
        let s = pcx.types[t].a;
        let si = if pcx.structs[s].tmpl > 0 { pcx.structs[s].tmpl - 1 } else { s };
        return base_name(sym_text(pcx.structs[si].name, pcx));
    }
    if k == TyKind::Enum {
        // UNSAFE: ENUMS is the checker's table, a raw pointer (front/types.vl)
        // SAFETY: an Enum type's index, and its template's, are below the count
        unsafe {
            let e = crate::front::types::ENUMS[pcx.types[t].a];
            let ei = if e.tmpl > 0 { crate::front::types::ENUMS[e.tmpl - 1] } else { e };
            return base_name(sym_text(ei.name, pcx));
        }
    }
    if k == TyKind::Distinct {
        return "str";
    }
    ""
}

// `Vec<i64, Gpa>` -> `Vec`.
fn base_name(n: [u8]) -> [u8] {
    var k: usize = 0;
    while k < n.len && n[k] != '<' {
        k += 1;
    }
    n[0..k]
}

// Type argument i of type t (a struct's or an enum's instance; a slice's
// element for 0), or 0.
fn type_arg(t0: i64, i: i64, pcx: Ctx<Comp>) -> i64 {
    var t = t0;
    if t > 0 && pcx.types[t].kind == TyKind::Ptr {
        t = pcx.types[t].a;
    }
    if t <= 0 {
        return 0;
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Slice || k == TyKind::Array {
        return if i == 0 { pcx.types[t].a } else { 0 };
    }
    if k == TyKind::Struct {
        let s = pcx.types[t].a;
        if i < pcx.structs[s].targ_count {
            // UNSAFE: TLISTS is the checker's list table
            // SAFETY: i is below the instance's argument count
            unsafe {
                return pcx.tlists.data[pcx.structs[s].targs + i];
            }
        }
        return 0;
    }
    if k == TyKind::Enum {
        // UNSAFE: ENUMS and TLISTS are the checker's tables
        // SAFETY: an Enum type's index; i below its argument count
        unsafe {
            let e = crate::front::types::ENUMS[pcx.types[t].a];
            if i < e.targ_count {
                return pcx.tlists.data[e.targs + i];
            }
        }
    }
    0
}

// The index of a row's type variable for owner o.
fn var_index(o: [u8], v: u8) -> i64 {
    if v == 'A' {
        if o == "HashMap" {
            return 2;
        }
        if o == "String" || o == "Buf" {
            return 0;
        }
        return 1;
    }
    if v == 'V' || v == 'E' {
        return 1;
    }
    0
}

// Whether a value of type t can be printed with `{:?}`: the primitives,
// std's types, the program's that derive or implement Debug.
fn has_debug(t: i64, pcx: Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t].kind != TyKind::Struct && pcx.types[t].kind != TyKind::Enum {
        return true;
    }
    var node = 0;
    if pcx.types[t].kind == TyKind::Struct {
        let s = pcx.types[t].a;
        node = pcx.structs[if pcx.structs[s].tmpl > 0 { pcx.structs[s].tmpl - 1 } else { s }].node;
    }
    if node <= 0 {
        return true;
    }
    let h = pcx.nodes[node].h;
    if h > 0 {
        for j in 0..pcx.nodes[h].count {
            if SRC[pcx.nodes[child(h, j, pcx)].start..pcx.nodes[child(h, j, pcx)].end] == "Debug" {
                return true;
            }
        }
    }
    false
}

// What call c's value is used for: read (and dropped) or not.
fn used_for_read(c: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    let p = parent_of(c, tr);
    if p <= 0 {
        return false;
    }
    let k = pcx.nodes[p].kind;
    if k == NodeKind::Binary || k == NodeKind::Cast || k == NodeKind::InterpHole
        || k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index
        || k == NodeKind::If && pcx.nodes[p].a == c || k == NodeKind::While && pcx.nodes[p].b == c
        || k == NodeKind::Match && pcx.nodes[p].a == c {
        return true;
    }
    if k == NodeKind::Unary {
        return pcx.nodes[p].op != crate::front::lexer::Tok::Star;
    }
    if (k == NodeKind::Call || k == NodeKind::MethodCall) && pcx.nodes[p].count > 0
        && child(p, 0, pcx) == c && pcx.nodes[p].start == pcx.nodes[c].start {
        return true;
    }
    false
}

// Whether the row's condition w holds for call c (receiver type rt, owner
// o, argument 1 a1).
fn holds(w: [u8], c: i64, rt: i64, o: [u8], a1: i64, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    if w == "-" {
        return true;
    }
    var i: usize = 0;
    while i < w.len {
        var e = i;
        while e < w.len && w[e] != ',' {
            e += 1;
        }
        var s = i;
        while s < e && w[s] == ' ' {
            s += 1;
        }
        let term = w[s..e];
        if !holds_term(term, c, rt, o, a1, tr, &pcx) {
            return false;
        }
        i = e + 1;
    }
    true
}

fn holds_term(term: [u8], c: i64, rt: i64, o: [u8], a1: i64, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    if term == "use=read" {
        return used_for_read(c, tr, pcx);
    }
    if term == "use=move" || term == "use=store" {
        return !used_for_read(c, tr, pcx);
    }
    if term.len > 9 && term[0..9] == "pattern: " {
        let at = if a1 > 0 { pcx.nodes[a1].ty } else { 0 };
        let want = term[9..term.len];
        return want == "u8" && at == crate::front::types::TY_U8
            || want == "u32" && at == crate::front::types::TY_U32;
    }
    if term.len >= 4 && term[1] == ':' {
        let t = type_arg(rt, var_index(o, term[0]), pcx);
        let what = term[3..term.len];
        if t <= 0 {
            return false;
        }
        if what == "Copy" {
            return crate::front::conv::copyable(t, &pcx) && !is_ref(t, pcx);
        }
        if what == "!Copy" {
            return !crate::front::conv::copyable(t, &pcx) || is_ref(t, pcx);
        }
        if what == "Debug" {
            return has_debug(t, pcx);
        }
        if what == "!Debug" {
            return !has_debug(t, pcx);
        }
        if what == "Clone" {
            return true;
        }
    }
    false
}

// Whether type t is an allocator (an `$a` argument).
fn allocator_type(t0: i64, pcx: Ctx<Comp>) -> bool {
    let o = owner_name(t0, pcx);
    o == "Gpa" || o == "Arena" || o == "ScopedArena" || o == "FixedBuf" || o == "AnyAlloc"
}

// The row of call c (its index in Tr.rows, a multiple of 4), or -1; with
// the call's parts.
fn find_row(name: [u8], owner: [u8], trait_name: [u8], free: bool, c: i64, rt: i64, a1: i64,
    tr: Tr, pcx: inout Ctx<Comp>) -> i64 {
    for w in 0..4 {
        // (the owner's row, the trait's, Iterator's for a method of an
        // adapter, a free function's)
        let o = if w == 0 { owner } else if w == 1 { trait_name } else if w == 2 { "Iterator" }
            else { "" };
        if w < 3 && o.len == 0 || w == 3 && !free || w == 2 && (free || trait_name.len > 0) {
            continue;
        }
        let want = buf_new();
        if o.len > 0 {
            buf_bytes(want, o);
            buf_bytes(want, "::");
        }
        buf_bytes(want, name);
        var r: i64 = 0;
        while r + 3 < tr.rows.count {
            if buf_slice(tr.rows.get(r)) == buf_slice(want)
                && holds(buf_slice(tr.rows.get(r + 1)), c, rt, o, a1, tr, &pcx) {
                return r;
            }
            r += 4;
        }
    }
    -1
}

// A closure literal k called in place by a row, `$1(a, b)` with its
// arguments' text at t[open + 1..] (open: the `(`): its body with each
// parameter bound to its argument, `({ let x = a; let y = b; BODY })`, as
// rustc and the front infer a closure's parameters from where it goes,
// not from a call of it. The index in t after the call's `)`, or -1 (a
// parameter with a type or a pattern, a count that differs: not done).
fn inline_closure(k: i64, t: [u8], open: usize, out: i64, pcx: Ctx<Comp>) -> i64 {
    var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var depth: i64 = 0;
    var q = open + 1;
    var from = q;
    while q < t.len {
        let ch = t[q];
        if ch == '(' || ch == '[' || ch == '{' {
            depth += 1;
        } else if (ch == ')' || ch == ']' || ch == '}') && depth > 0 {
            depth -= 1;
        } else if ch == ',' && depth == 0 || ch == ')' && depth == 0 {
            args.push(from as i64);
            args.push(q as i64);
            from = q + 1;
            if ch == ')' {
                break;
            }
        }
        q += 1;
    }
    if q >= t.len || args.count / 2 != pcx.nodes[k].count {
        return -1;
    }
    for j in 0..pcx.nodes[k].count {
        let p = child(k, j, pcx);
        if pcx.nodes[p].kind != NodeKind::Param || pcx.nodes[p].b > 0 || pcx.nodes[p].a <= 0 {
            return -1;
        }
    }
    let body = pcx.nodes[k].a;
    if body <= 0 {
        return -1;
    }
    buf_bytes(out, "({ ");
    for j in 0..pcx.nodes[k].count {
        buf_bytes(out, "let ");
        buf_bytes(out, sym_text(pcx.nodes[child(k, j, pcx)].a, pcx));
        buf_bytes(out, " = ");
        let a = args.get(2 * j) as usize;
        let b = args.get(2 * j + 1) as usize;
        var s = a;
        while s < b && t[s] == ' ' {
            s += 1;
        }
        buf_bytes(out, t[s..b]);
        buf_bytes(out, "; ");
    }
    render(pcx.nodes[body].start, pcx.nodes[body].end, true, out, pcx);
    buf_bytes(out, " })");
    (q + 1) as i64
}

// The text of a row's rust column t with the call's operands: recv the
// receiver's (-1: none), args the arguments' nodes (the receiver not among
// them), alloc the allocator's index in args (-1: none). Empty when an
// operand it names is missing.
fn expand(t: [u8], c: i64, recv: i64, args: IntVec, alloc: i64, out: i64, pcx: Ctx<Comp>) -> bool {
    var trailing = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var in_str = false;
    var i: usize = 0;
    while i < t.len {
        let ch = t[i];
        if ch == '"' {
            buf_byte(out, ch);
            if in_str {
                // (the holes `{$1}` written as `{}`: their values after it)
                for q in 0..trailing.count {
                    buf_bytes(out, ", ");
                    operand(trailing.get(q), pcx.nodes[c].start, out, pcx);
                }
                trailing.count = 0;
            }
            in_str = !in_str;
            i += 1;
            continue;
        }
        if ch == '$' && i + 1 < t.len {
            let nx = t[i + 1];
            var node = -1;
            var used = 2;
            if nx == 'r' {
                node = recv;
            } else if nx == 'a' {
                node = if alloc >= 0 { args.get(alloc) } else { -1 };
            } else if nx == 'T' {
                if pcx.nodes[c].ty <= 0 {
                    return false;
                }
                buf_type(out, pcx.nodes[c].ty, pcx);
                i += 2;
                continue;
            } else if nx >= '1' && nx <= '9' {
                let k = (nx - '1') as i64;
                node = if k < args.count { args.get(k) } else { -1 };
            } else {
                used = 0;
            }
            if used > 0 {
                if node <= 0 {
                    return false;
                }
                if in_str {
                    trailing.push(node);
                } else if nx == '1' && pcx.nodes[node].kind == NodeKind::Interp
                    || nx == '1' && pcx.nodes[node].kind == NodeKind::Str && args.count > 1 {
                    // (a format literal: with its values, the text from it to
                    // the allocator, or to the call's `)`)
                    format_text(node, c, if alloc >= 0 { args.get(alloc) } else { -1 }, out, pcx);
                } else if pcx.nodes[node].kind == NodeKind::Closure && i + 2 < t.len
                    && t[i + 2] == '(' {
                    // (a closure called in place: its body, the parameters
                    // bound; else `(|a, b| ..)(a, b)`)
                    let after = inline_closure(node, t, i + 2, out, pcx);
                    if after >= 0 {
                        i = after as usize;
                        continue;
                    }
                    buf_byte(out, '(');
                    operand(node, pcx.nodes[c].start, out, pcx);
                    buf_byte(out, ')');
                } else {
                    operand(node, pcx.nodes[c].start, out, pcx);
                }
                i += 2;
                continue;
            }
        }
        buf_byte(out, ch);
        i += 1;
    }
    true
}

// An operand's rewritten text (parenthesized when it is not one term).
fn operand(n: i64, call_start: i64, out: i64, pcx: Ctx<Comp>) {
    let k = pcx.nodes[n].kind;
    let simple = k == NodeKind::Ident || k == NodeKind::Call || k == NodeKind::FieldAccess
        || k == NodeKind::Index || k == NodeKind::Int || k == NodeKind::Str || k == NodeKind::Char
        || k == NodeKind::TupleField || k == NodeKind::Path || k == NodeKind::Unary
        || k == NodeKind::Closure || k == NodeKind::Bool || k == NodeKind::MethodCall
        || k == NodeKind::Interp || k == NodeKind::Float || k == NodeKind::Tuple
        || k == NodeKind::Array || k == NodeKind::Block;
    if !simple {
        buf_bytes(out, "(");
    }
    // (an insertion where the call starts is the call's context's)
    render(pcx.nodes[n].start, pcx.nodes[n].end, pcx.nodes[n].start != call_start, out, pcx);
    if !simple {
        buf_bytes(out, ")");
    }
}

// Whether call c's name is written where it is: `r.name(`, `T::name(`,
// `name(`.
fn written_call(c: i64, callee: i64, method: bool, name: [u8], pcx: Ctx<Comp>) -> bool {
    if method {
        let r = child(c, 0, pcx);
        let q = crate::tools::translate::skip_ws(pcx.nodes[r].end);
        return q < SRC.len() as i64 && SRC[q] == '.'
            && word_here(crate::tools::translate::skip_ws(q + 1), name);
    }
    let e = pcx.nodes[callee].end;
    let s = e - name.len as i64;
    s >= pcx.nodes[callee].start && token_at(s, pcx) >= 0 && word_here(s, name)
}

// Call c, rewritten by its row.
fn edit_call(c: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let f = pcx.nodes[c].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let fnode = pcx.fns[f].node;
    if fnode > 0 && editable(pcx.nodes[fnode].start, &pcx) {
        return;
    }
    let callee = pcx.nodes[c].a;
    var name_sym = 0;
    var owner = SRC[0..0];
    var method = false;
    var free = false;
    if callee == 0 && pcx.nodes[c].count > 0 && pcx.nodes[c].b > 0 {
        method = true;
        name_sym = pcx.nodes[c].b;
        owner = owner_name(pcx.nodes[child(c, 0, pcx)].ty, pcx);
    } else if callee > 0 && pcx.nodes[callee].kind == NodeKind::Path {
        name_sym = pcx.nodes[callee].b;
        owner = sym_text(pcx.nodes[callee].a, pcx);
        // (a module's function, `std::print_int(x)`: a free function's row)
        if owner.len > 0 && owner[0] >= 'a' && owner[0] <= 'z' {
            owner = SRC[0..0];
            free = true;
        }
    } else if callee > 0 && pcx.nodes[callee].kind == NodeKind::Ident {
        // (a path written `std::print_int`: b its last name)
        name_sym = if pcx.nodes[callee].b > 0 { pcx.nodes[callee].b } else { pcx.nodes[callee].a };
        free = true;
    } else {
        return;
    }
    if name_sym <= 0 {
        return;
    }
    let name = sym_text(name_sym, pcx);
    // (a call the checker made, a format literal's pieces or an operator's
    // method, is not written: its text is the expression's)
    if !written_call(c, callee, method, name, pcx) {
        return;
    }
    var trait_name = SRC[0..0];
    let im = crate::front::traits::impl_of_fn(f, pcx);
    if im >= 0 && im < pcx.traits_impls.len() as i64 {
        let ti = pcx.traits_impls[im].tr;
        if ti >= 0 && ti < pcx.traits.len() as i64 {
            trait_name = sym_text(pcx.traits[ti].name, pcx);
        }
    }
    var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var recv = -1;
    for i in 0..pcx.nodes[c].count {
        var a = child(c, i, pcx);
        if pcx.nodes[a].kind == NodeKind::NamedArg {
            a = pcx.nodes[a].b;
        }
        // (the checker's borrow of an argument: what it borrows)
        if pcx.nodes[a].kind == NodeKind::Unary && SRC[pcx.nodes[a].start] != '&'
            && SRC[pcx.nodes[a].start] != '*' && pcx.nodes[a].b > 0 {
            a = pcx.nodes[a].b;
        }
        if method && i == 0 {
            recv = a;
        } else if pcx.nodes[a].start > pcx.nodes[c].start || !method && i == 0 {
            args.push(a);
        }
    }
    if method && recv <= 0 {
        return;
    }
    let rt = if recv > 0 { pcx.nodes[recv].ty } else { 0 };
    let a1 = if args.count > 0 { args.get(0) } else { 0 };
    let r = find_row(name, owner, trait_name, free, c, rt, a1, tr, &pcx);
    if r < 0 {
        return;
    }
    var rust = buf_slice(tr.rows.get(r + 2));
    // (a program whose bytes are text: a String's text is a &str)
    if tr.text_mode && buf_slice(tr.rows.get(r)) == "String::as_slice" {
        rust = "$r.as_str()";
    }
    if rust == "!" || rust.len > 0 && rust[0] == '!' {
        row_left(c, r, &tr, &pcx);
        return;
    }
    if rust.len > 5 && (rust[0..5] == "type " || rust[0..5] == "impl ") || rust.len > 3
        && rust[0..3] == "fn " {
        return;
    }
    var alloc = -1;
    for i in 0..args.count {
        if allocator_type(pcx.nodes[args.get(i)].ty, pcx) {
            alloc = i;
        }
    }
    let out = buf_new();
    if rust == "-" {
        // (a statement that goes: the call and its `;`)
        let p = parent_of(c, tr);
        if p > 0 && pcx.nodes[p].kind == NodeKind::ExprStmt {
            put_call(pcx.nodes[p].start, pcx.nodes[p].end, "", &tr, &pcx);
        }
        return;
    }
    // (MVS's `f.write(fmt, args..)` writes a format literal with its
    // values: Rust's `write(f, fmt, args..)?`)
    if trait_name.len == 0 && owner == "Fmt" && name == "write" && recv > 0 {
        buf_bytes(out, "write(");
        operand(recv, pcx.nodes[c].start, out, pcx);
        if args.count > 0 {
            buf_bytes(out, ", ");
            format_text(args.get(0), c, -1, out, pcx);
        }
        buf_bytes(out, ")?");
    } else if !expand(rust, c, recv, args, alloc, out, pcx) {
        row_left(c, r, &tr, &pcx);
        return;
    }
    put_call(pcx.nodes[c].start, pcx.nodes[c].end, buf_slice(out), &tr, &pcx);
}

// Call c left to hand by row r: its MVS item, its rust form, its note.
fn row_left(c: i64, r: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let b = buf_new();
    buf_bytes(b, buf_slice(tr.rows.get(r)));
    buf_bytes(b, " -> ");
    buf_bytes(b, buf_slice(tr.rows.get(r + 2)));
    buf_bytes(b, " (");
    buf_bytes(b, buf_slice(tr.rows.get(r + 3)));
    buf_bytes(b, ")");
    crate::tools::translate::left_note(pcx.nodes[c].start, TL_ROW, b, &tr, &pcx);
}

// [a, b) replaced by text, the edits inside it folded in (render).
fn put_call(a: i64, b: i64, text: [u8], tr: inout Tr, pcx: inout Ctx<Comp>) {
    let key = a * 64 + 62 + 2;
    if tr.done.get(key) != 0 {
        return;
    }
    tr.done.put(key, 1);
    drop_inside(a, b, &pcx);
    let t = buf_new();
    buf_bytes(t, text);
    if edit_replace(a, b, t, &pcx) {
        tr.counts[TC_STD] += 1;
    }
}

pub fn row_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    // (innermost first: by span, the shortest first)
    var calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Call && own_node(n, tr, &pcx)
            && crate::tools::translate::token_at(pcx.nodes[n].start, pcx) >= 0 {
            calls.push(n);
        }
    }
    var spans = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..calls.count {
        let n = calls.get(i);
        spans.push(pcx.nodes[n].end - pcx.nodes[n].start);
    }
    sort_by_key(&calls, &spans);
    for i in 0..calls.count {
        edit_call(calls.get(i), &tr, &pcx);
    }
}

// v sorted by keys (a shell sort; the keys move with it).
fn sort_by_key(v: inout IntVec, keys: inout IntVec) {
    var gap = v.count / 2;
    while gap > 0 {
        for i in gap..v.count {
            let tv = v.get(i);
            let tk = keys.get(i);
            var j = i;
            while j >= gap && keys.get(j - gap) > tk {
                v.set(j, v.get(j - gap));
                keys.set(j, keys.get(j - gap));
                j -= gap;
            }
            v.set(j, tv);
            keys.set(j, tk);
        }
        gap /= 2;
    }
}

// A format literal (node lit, of call c) with its values: the call's text
// from it to the allocator argument alloc (-1: to the call's `)`).
fn format_text(lit: i64, c: i64, alloc: i64, out: i64, pcx: Ctx<Comp>) {
    var stop = pcx.nodes[c].end - 1;
    if alloc > 0 && pcx.nodes[alloc].start > pcx.nodes[lit].start {
        stop = pcx.nodes[alloc].start;
    }
    while stop > pcx.nodes[lit].end && (crate::tools::translate::is_ws(SRC[stop - 1])
        || SRC[stop - 1] == ',') {
        stop -= 1;
    }
    if stop < pcx.nodes[lit].end {
        stop = pcx.nodes[lit].end;
    }
    render(pcx.nodes[lit].start, stop, true, out, pcx);
}
