// (0.27.3) The translator's std calls (mod.vl, pass 5): each call of an
// MVS std item with a row in compiler/std2/rewrite.tsv (table.vl's
// rewrite_rows) is rewritten by the first row whose condition holds,
// chosen by type: the receiver's element, key or value type (`T: Copy`),
// what the call's value is used for (`use=read`), its pattern's type.
// The calls are taken innermost first, and a row's `$r`, `$1`, ... are
// its operands' rewritten text (the edits inside the call, made by the
// passes before, are folded into the one edit of the call). A row `!`
// is left to hand, and reported; `-` takes the statement away.

use crate::base::{IntVec, get_src, buf_byte, buf_bytes, buf_new, buf_slice, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::types::{TyKind, buf_type};
use crate::tools::edit::edit_replace;
use crate::tools::translate::{
    D_MUT, TC_STD, TL_ROW, Tr, editable, enclosing_fn, is_ref, left, own_node, parent_of, token_at,
    word_here,
};

// ---- The text so far ----

// SRC[a..b) with the edits made inside it applied (an insertion at a only
// when with_start).
pub fn render(a: i64, b: i64, with_start: bool, out: i64, pcx: &Ctx<Comp>) {
    let mut idx = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let e = pcx.e_end.get(i);
        if s >= a && e <= b && (s > a || with_start || e > s) {
            idx.push(i);
        }
    }
    // (in position order; an insertion before a replacement at its start,
    // insertions in the order they were made)
    let mut k: i64 = 1;
    while k < idx.count {
        let mut j = k;
        while j > 0 && before(idx.get(j), idx.get(j - 1), pcx) {
            let t = idx.get(j);
            { let at_arg2 = idx.get(j - 1); idx.set(j, at_arg2) };
            idx.set(j - 1, t);
            j -= 1;
        }
        k += 1;
    }
    let mut p = a;
    for q in 0..idx.count {
        let i = idx.get(q);
        let s = pcx.e_start.get(i);
        if s > p {
            buf_bytes(out, &get_src()[p as usize..s as usize]);
        }
        buf_bytes(out, buf_slice(pcx.e_text.get(i)));
        p = if pcx.e_end.get(i) > p { pcx.e_end.get(i) } else { p };
    }
    if p < b {
        buf_bytes(out, &get_src()[p as usize..b as usize]);
    }
}

fn before(x: i64, y: i64, pcx: &Ctx<Comp>) -> bool {
    let sx = pcx.e_start.get(x);
    let sy = pcx.e_start.get(y);
    if sx != sy {
        return sx < sy;
    }
    let ix = pcx.e_end.get(x) == sx;
    let iy = pcx.e_end.get(y) == sy;
    ix && !iy
}

// The edits strictly inside [a, b) taken back (the call's edit holds them).
pub fn drop_inside(a: i64, b: i64, pcx: &mut Ctx<Comp>) {
    let mut w: i64 = 0;
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let e = pcx.e_end.get(i);
        let inside = s >= a && e <= b && !(s == e && (s == a || s == b));
        if !inside {
            pcx.e_start.set(w, s);
            pcx.e_end.set(w, e);
            pcx.e_text.set(w, pcx.e_text.get(i));
            w += 1;
        }
    }
    pcx.e_start.count = w;
    pcx.e_end.count = w;
    pcx.e_text.count = w;
}

// (0.27.6) The insertion of text at position p taken back.
fn drop_insert_at(p: i64, text: &[u8], pcx: &mut Ctx<Comp>) {
    let mut w: i64 = 0;
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let e = pcx.e_end.get(i);
        let gone = s == p && e == p && pcx.e_text.get(i) >= 0
            && buf_slice(pcx.e_text.get(i)) == text;
        if !gone {
            pcx.e_start.set(w, s);
            pcx.e_end.set(w, e);
            pcx.e_text.set(w, pcx.e_text.get(i));
            w += 1;
        }
    }
    pcx.e_start.count = w;
    pcx.e_end.count = w;
    pcx.e_text.count = w;
}

// ---- The call ----

// The name of the MVS item type t is (its template's: `Vec`, `Option`),
// `[T]` for a slice, `str`; "" for another.
fn owner_name(t0: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let mut t = t0;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        t = pcx.types[t as usize].a;
    }
    if t <= 0 {
        return b"";
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Slice {
        return b"[T]";
    }
    if k == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        let si = if pcx.structs[s as usize].tmpl > 0 { pcx.structs[s as usize].tmpl - 1 } else { s };
        return base_name(sym_text(pcx.structs[si as usize].name, pcx));
    }
    if k == TyKind::Enum {
        // UNSAFE: ENUMS is the checker's table, a raw pointer (front/types.vl)
        // SAFETY: an Enum type's index, and its template's, are below the count
        unsafe {
            let e = (*crate::front::types::get_enums().add(pcx.types[t as usize].a as usize));
            let ei = if e.tmpl > 0 { (*crate::front::types::get_enums().add((e.tmpl - 1) as usize)) } else { e };
            return base_name(sym_text(ei.name, pcx));
        }
    }
    if k == TyKind::Distinct {
        return b"str";
    }
    b""
}

// `Vec<i64, Gpa>` -> `Vec`.
fn base_name(n: &[u8]) -> &[u8] {
    let mut k: usize = 0;
    while k < n.len() && n[k] != b'<' {
        k += 1;
    }
    &n[0..k]
}

// Type argument i of type t (a struct's or an enum's instance; a slice's
// element for 0), or 0.
pub fn type_arg(t0: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut t = t0;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        t = pcx.types[t as usize].a;
    }
    if t <= 0 {
        return 0;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Slice || k == TyKind::Array {
        return if i == 0 { pcx.types[t as usize].a } else { 0 };
    }
    if k == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        if i < pcx.structs[s as usize].targ_count {
            // UNSAFE: TLISTS is the checker's list table
            // SAFETY: i is below the instance's argument count
            unsafe {
                return (*pcx.tlists.data.add((pcx.structs[s as usize].targs + i) as usize));
            }
        }
        return 0;
    }
    if k == TyKind::Enum {
        // UNSAFE: ENUMS and TLISTS are the checker's tables
        // SAFETY: an Enum type's index; i below its argument count
        unsafe {
            let e = (*crate::front::types::get_enums().add(pcx.types[t as usize].a as usize));
            if i < e.targ_count {
                return (*pcx.tlists.data.add((e.targs + i) as usize));
            }
        }
    }
    0
}

// The index of a row's type variable for owner o.
fn var_index(o: &[u8], v: u8) -> i64 {
    if v == b'A' {
        if o == b"HashMap" {
            return 2;
        }
        if o == b"String" || o == b"Buf" {
            return 0;
        }
        return 1;
    }
    if v == b'V' || v == b'E' {
        return 1;
    }
    0
}

// Whether a value of type t can be printed with `{:?}`: the primitives,
// std's types, the program's that derive or implement Debug.
fn has_debug(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct && pcx.types[t as usize].kind != TyKind::Enum {
        return true;
    }
    let mut node: i64 = 0;
    if pcx.types[t as usize].kind == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        node = pcx.structs[(if pcx.structs[s as usize].tmpl > 0 { pcx.structs[s as usize].tmpl - 1 } else { s }) as usize].node;
    }
    if node <= 0 {
        return true;
    }
    let h = pcx.nodes[node as usize].h;
    if h > 0 {
        for j in 0..pcx.nodes[h as usize].count {
            if &get_src()[pcx.nodes[child(h, j, pcx) as usize].start as usize..pcx.nodes[child(h, j, pcx) as usize].end as usize] == b"Debug" {
                return true;
            }
        }
    }
    false
}

// What call c's value is used for: read (and dropped) or not.
fn used_for_read(c: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let p = parent_of(c, tr);
    if p <= 0 {
        return false;
    }
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::Binary || k == NodeKind::Cast || k == NodeKind::InterpHole
        || k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index
        || k == NodeKind::If && pcx.nodes[p as usize].a == c || k == NodeKind::While && pcx.nodes[p as usize].b == c
        || k == NodeKind::Match && pcx.nodes[p as usize].a == c {
        return true;
    }
    if k == NodeKind::Unary {
        return pcx.nodes[p as usize].op != crate::front::lexer::Tok::Star;
    }
    if (k == NodeKind::Call || k == NodeKind::MethodCall) && pcx.nodes[p as usize].count > 0
        && child(p, 0, pcx) == c && pcx.nodes[p as usize].start == pcx.nodes[c as usize].start {
        return true;
    }
    false
}

// (0.28.0) Whether call c's value goes where its type is written: a let's
// annotation, a function's result (its body's value or a `return`), through
// the blocks, `if` branches and match arms that give it there. A call
// generic only in its result (`collect_in`) then needs no turbofish.
fn typed_context(c: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let mut e = c;
    for _ in 0..32 {
        let p = parent_of(e, tr);
        if p <= 0 {
            return false;
        }
        let k = pcx.nodes[p as usize].kind;
        if k == NodeKind::Let {
            return pcx.nodes[p as usize].c == e && pcx.nodes[p as usize].b > 0;
        }
        if k == NodeKind::Return {
            let f = enclosing_fn(pcx.nodes[e as usize].start, pcx);
            return f > 0 && pcx.nodes[f as usize].b > 0;
        }
        if k == NodeKind::Block {
            if pcx.nodes[p as usize].a != e {
                return false;
            }
            let q = parent_of(p, tr);
            if q > 0 && pcx.nodes[q as usize].kind == NodeKind::Fn {
                return pcx.nodes[q as usize].b > 0;
            }
        } else if k == NodeKind::If {
            if pcx.nodes[p as usize].a == e {
                return false;
            }
        } else if k == NodeKind::Arm {
            if pcx.nodes[p as usize].c != e {
                return false;
            }
        } else if k != NodeKind::Match {
            return false;
        }
        e = p;
    }
    false
}

// Whether the row's condition w holds for call c (receiver type rt, owner
// o, argument 1 a1).
fn holds(w: &[u8], c: i64, rt: i64, o: &[u8], a1: i64, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    if w == b"-" {
        return true;
    }
    let mut i: usize = 0;
    while i < w.len() {
        let mut e = i;
        while e < w.len() && w[e] != b',' {
            e += 1;
        }
        let mut s = i;
        while s < e && w[s] == b' ' {
            s += 1;
        }
        let term = &w[s..e];
        if !holds_term(term, c, rt, o, a1, tr, pcx) {
            return false;
        }
        i = e + 1;
    }
    true
}

fn holds_term(term: &[u8], c: i64, rt: i64, o: &[u8], a1: i64, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    if term == b"use=read" {
        return used_for_read(c, tr, pcx);
    }
    if term == b"use=move" || term == b"use=store" {
        return !used_for_read(c, tr, pcx);
    }
    if term == b"use=typed" {
        return typed_context(c, tr, pcx);
    }
    // (a receiver that is an element of a container, `v[i].free()` of a Vec
    // or a String: Rust moves nothing out of an index)
    if term == b"$r=index" {
        let mut e: i64 = if pcx.nodes[c as usize].count > 0 { child(c, 0, pcx) } else { 0 };
        if e > 0 && pcx.nodes[e as usize].kind == NodeKind::Unary && get_src()[pcx.nodes[e as usize].start as usize] != b'&' {
            e = pcx.nodes[e as usize].b;
        }
        if e <= 0 || pcx.nodes[e as usize].kind != NodeKind::Index || pcx.nodes[e as usize].b <= 0
            || pcx.nodes[pcx.nodes[e as usize].b as usize].kind == NodeKind::Range {
            return false;
        }
        let w = owner_name(pcx.nodes[e as usize].ty, pcx);
        return w == b"Vec" || w == b"String";
    }
    if term.len() > 9 && term[0..9] == b"pattern: " {
        let at: i64 = if a1 > 0 { pcx.nodes[a1 as usize].ty } else { 0 };
        let want = &term[9..term.len()];
        return want == b"u8" && at == crate::front::types::TY_U8
            || want == b"u32" && at == crate::front::types::TY_U32;
    }
    if term.len() >= 4 && term[1] == b':' {
        let t = type_arg(rt, var_index(o, term[0]), pcx);
        let what = &term[3..term.len()];
        if t <= 0 {
            return false;
        }
        if what == b"Copy" {
            return crate::front::conv::copyable(t, pcx) && !is_ref(t, pcx);
        }
        if what == b"!Copy" {
            return !crate::front::conv::copyable(t, pcx) || is_ref(t, pcx);
        }
        if what == b"Debug" {
            return has_debug(t, pcx);
        }
        if what == b"!Debug" {
            return !has_debug(t, pcx);
        }
        if what == b"Clone" {
            return true;
        }
    }
    false
}

// Whether type t is an allocator (an `$a` argument).
fn allocator_type(t0: i64, pcx: &Ctx<Comp>) -> bool {
    let o = owner_name(t0, pcx);
    o == b"Gpa" || o == b"Arena" || o == b"ScopedArena" || o == b"FixedBuf" || o == b"AnyAlloc"
}

// (0.27.5) The last segment of the module of call c's function, std's
// (`fs` of std::fs), or "".
fn callee_module(c: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return b"";
    }
    let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let m = pcx.fns[g as usize].module;
    if m < 0 || m >= pcx.modules.len() as i64 {
        return b"";
    }
    let k = sym_text(pcx.modules[m as usize].key, pcx);
    let mut i = k.len();
    while i > 0 && k[i - 1] != b':' {
        i -= 1;
    }
    &k[i..k.len()]
}

// The row of call c (its index in Tr.rows, a multiple of 4), or -1; with
// the call's parts.
fn find_row(name: &[u8], owner: &[u8], trait_name: &[u8], free: bool, c: i64, rt: i64, a1: i64,
    tr: Tr, pcx: &mut Ctx<Comp>) -> i64 {
    for w in 0..5 {
        // (the owner's row, the trait's, Iterator's for a method of an
        // adapter, a free function's by its module, `fs::copy` (0.27.5: not
        // io::copy), a free function's)
        let o = if w == 0 { owner } else if w == 1 { trait_name } else if w == 2 { b"Iterator" }
            else { b"" };
        if w < 3 && o.len() == 0 || w >= 3 && !free || w == 2 && (free || trait_name.len() > 0) {
            continue;
        }
        let want = buf_new();
        if w == 3 {
            // (the module's name is copied: no view of pcx is kept)
            let m = callee_module(c, pcx);
            if m.len() == 0 {
                continue;
            }
            buf_bytes(want, m);
            buf_bytes(want, b"::");
        } else if o.len() > 0 {
            buf_bytes(want, o);
            buf_bytes(want, b"::");
        }
        buf_bytes(want, name);
        let mut r: i64 = 0;
        while r + 3 < tr.rows.count {
            if buf_slice(tr.rows.get(r)) == buf_slice(want)
                && holds(buf_slice(tr.rows.get(r + 1)), c, rt, o, a1, tr, pcx) {
                return r;
            }
            r += 4;
        }
    }
    -1
}

// A closure literal k called in place by a row, `$1(a, b)` with its
// arguments' text at t[open + 1..] (open: the `(`): its body with each
// parameter bound to its argument, `({ let x = a; let y = b; BODY })`, as
// rustc and the front infer a closure's parameters from where it goes,
// not from a call of it. The index in t after the call's `)`, or -1 (a
// parameter with a type or a pattern, a count that differs: not done).
fn inline_closure(k: i64, t: &[u8], open: usize, out: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut depth: i64 = 0;
    let mut q = open + 1;
    let mut from = q;
    while q < t.len() {
        let ch = t[q];
        if ch == b'(' || ch == b'[' || ch == b'{' {
            depth += 1;
        } else if (ch == b')' || ch == b']' || ch == b'}') && depth > 0 {
            depth -= 1;
        } else if ch == b',' && depth == 0 || ch == b')' && depth == 0 {
            args.push(from as i64);
            args.push(q as i64);
            from = q + 1;
            if ch == b')' {
                break;
            }
        }
        q += 1;
    }
    if q >= t.len() || args.count / 2 != pcx.nodes[k as usize].count {
        return -1;
    }
    for j in 0..pcx.nodes[k as usize].count {
        let p = child(k, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param || pcx.nodes[p as usize].b > 0 || pcx.nodes[p as usize].a <= 0 {
            return -1;
        }
    }
    let body = pcx.nodes[k as usize].a;
    if body <= 0 {
        return -1;
    }
    buf_bytes(out, b"({ ");
    for j in 0..pcx.nodes[k as usize].count {
        buf_bytes(out, b"let ");
        buf_bytes(out, sym_text(pcx.nodes[child(k, j, pcx) as usize].a, pcx));
        buf_bytes(out, b" = ");
        let a = args.get(2 * j) as usize;
        let b = args.get(2 * j + 1) as usize;
        let mut s = a;
        while s < b && t[s] == b' ' {
            s += 1;
        }
        buf_bytes(out, &t[s..b]);
        buf_bytes(out, b"; ");
    }
    render(pcx.nodes[body as usize].start, pcx.nodes[body as usize].end, true, out, pcx);
    buf_bytes(out, b" })");
    (q + 1) as i64
}

// (0.27.5) Whether the program has `impl Allocator for S` of struct name
// sym s (by the impl's written names).
fn allocator_struct(s: i64, pcx: &Ctx<Comp>) -> bool {
    let name = sym_text(s, pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let t = pcx.nodes[n as usize].a;
        let b = pcx.nodes[n as usize].b;
        if pcx.nodes[n as usize].kind == NodeKind::Impl && t > 0 && b > 0
            && get_src()[pcx.nodes[t as usize].start as usize..pcx.nodes[t as usize].end as usize] == b"Allocator"
            && get_src()[pcx.nodes[b as usize].start as usize..pcx.nodes[b as usize].end as usize] == name {
            return true;
        }
    }
    false
}

// The allocator in scope at call c, for a row's `$a` when the call has
// none (MVS's `thread::spawn(f)` allocated from C): the `Gpa` parameter
// of the innermost function around it that has one, by position (main's
// is not in its list once checked), or an allocator the function makes
// before it, or "".
fn scope_allocator(c: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    let pos = pcx.nodes[c as usize].start;
    let mut outer = get_src().len() as i64;
    for f in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[f as usize].kind == NodeKind::Fn && pcx.nodes[f as usize].start <= pos && pos < pcx.nodes[f as usize].end
            && pcx.nodes[f as usize].start < outer {
            outer = pcx.nodes[f as usize].start;
        }
    }
    let mut best: i64 = -1;
    for p in 1..pcx.nodes.len() as i64 {
        let t = pcx.nodes[p as usize].b;
        if pcx.nodes[p as usize].kind == NodeKind::Param && pcx.nodes[p as usize].start >= outer
            && pcx.nodes[p as usize].start < pos && (best < 0 || pcx.nodes[p as usize].start > pcx.nodes[best as usize].start)
            && t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyName
            && get_src()[pcx.nodes[t as usize].start as usize..pcx.nodes[t as usize].end as usize] == b"Gpa" && pcx.nodes[p as usize].a > 0 {
            best = p;
        }
    }
    if best > 0 {
        return sym_text(pcx.nodes[best as usize].a, pcx);
    }
    // (0.27.5) else an allocator the function makes before the call, a
    // literal of a struct of the program's that implements Allocator:
    // `Vec::new_in(Comp {})` and then MVS's `Command::new(p)`, std's Gpa
    // (front/modules/std2lazy.vl's rerun_eager, which has no gpa)
    for s in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[s as usize].kind == NodeKind::StructLit && pcx.nodes[s as usize].start >= outer
            && pcx.nodes[s as usize].end <= pos && pcx.nodes[s as usize].count == 0
            && allocator_struct(pcx.nodes[s as usize].a, pcx) {
            return &get_src()[pcx.nodes[s as usize].start as usize..pcx.nodes[s as usize].end as usize];
        }
    }
    b""
}

// (0.27.5) Whether n names a parameter the rust edition takes `&mut T`
// (D_MUT), through the checker's access to it: `&mut $r` of such a
// receiver is `&mut *out` (a reborrow), not `&mut out`, a borrow of the
// reference.
fn mut_param(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let mut x = n;
    while x > 0 && pcx.nodes[x as usize].kind == NodeKind::Unary && pcx.nodes[x as usize].b > 0
        && (pcx.nodes[x as usize].op == Tok::Star && get_src()[pcx.nodes[x as usize].start as usize] != b'*'
            || pcx.nodes[x as usize].op == Tok::Amp && get_src()[pcx.nodes[x as usize].start as usize] != b'&') {
        x = pcx.nodes[x as usize].b;
    }
    if x <= 0 || pcx.nodes[x as usize].kind != NodeKind::Ident {
        return false;
    }
    let f = enclosing_fn(pcx.nodes[x as usize].start, pcx);
    for i in 0..if f > 0 { pcx.nodes[f as usize].count } else { 0 } {
        let p = child(f, i, pcx);
        if p > 0 && pcx.nodes[p as usize].kind == NodeKind::Param && pcx.nodes[p as usize].a == pcx.nodes[x as usize].a {
            return tr.decided.get(p + 1) == D_MUT;
        }
    }
    false
}

// (0.27.6) For each of args, 1 when it is text where it is declared
// (body::declared_str, or any view of a program of text only: a `&str` in
// the rust edition), else 0: a `$b1`'s
// `.as_bytes()`.
fn text_args(args: IntVec, d: crate::tools::translate::body::TextDecls, tr: Tr,
    pcx: &mut Ctx<Comp>) -> IntVec {
    let mut out = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..args.count {
        let a = args.get(i);
        // (a program of text only, text_mode: every `[u8]` view is a `&str`)
        let view = a > 0 && pcx.nodes[a as usize].ty > 0 && pcx.types[pcx.nodes[a as usize].ty as usize].kind == TyKind::Slice;
        out.push(if a > 0 && (tr.text_mode && view
            || crate::tools::translate::body::declared_str(a, 0, d, tr, pcx)) { 1 } else { 0 });
    }
    out
}

// The text of a row's rust column t with the call's operands: recv the
// receiver's (-1: none), args the arguments' nodes (the receiver not among
// them), alloc the allocator's index in args (-1: none: `$a` is the
// allocator in scope). Empty when an operand it names is missing.
fn expand(t: &[u8], c: i64, recv: i64, args: IntVec, texts: IntVec, alloc: i64, out: i64, tr: Tr,
    pcx: &Ctx<Comp>) -> bool {
    let mut trailing = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut in_str = false;
    let mut i: usize = 0;
    while i < t.len() {
        let ch = t[i];
        if ch == b'"' {
            buf_byte(out, ch);
            if in_str {
                // (the holes `{$1}` written as `{}`: their values after it)
                for q in 0..trailing.count {
                    buf_bytes(out, b", ");
                    operand(trailing.get(q), pcx.nodes[c as usize].start, out, pcx);
                }
                trailing.count = 0;
            }
            in_str = !in_str;
            i += 1;
            continue;
        }
        if ch == b'$' && i + 1 < t.len() {
            let nx = t[i + 1];
            let mut node: i64 = -1;
            let mut used: i64 = 2;
            if nx == b'r' {
                node = recv;
            } else if nx == b'a' {
                node = if alloc >= 0 { args.get(alloc) } else { -1 };
                // (none given: the allocator in scope, by its name)
                let s = if node < 0 { scope_allocator(c, pcx) } else { b"" };
                if s.len() > 0 {
                    buf_bytes(out, s);
                    i += 2;
                    continue;
                }
            } else if nx == b'T' {
                if pcx.nodes[c as usize].ty <= 0 {
                    return false;
                }
                buf_type(out, pcx.nodes[c as usize].ty, pcx);
                i += 2;
                continue;
            } else if nx >= b'1' && nx <= b'9' {
                let k = (nx - b'1') as i64;
                node = if k < args.count { args.get(k) } else { -1 };
            } else if nx == b'b' && i + 2 < t.len() && t[i + 2] >= b'1' && t[i + 2] <= b'9' {
                // (0.27.6) `$b1`: the argument where bytes go, a text
                // literal `b".."` (`"..".as_bytes()` when not ASCII):
                // `extend_from_slice(b"ref to ")`
                let k = (t[i + 2] - b'1') as i64;
                let lit: i64 = if k < args.count { args.get(k) } else { -1 };
                if lit <= 0 {
                    return false;
                }
                let text = pcx.nodes[lit as usize].kind == NodeKind::Str && get_src()[pcx.nodes[lit as usize].start as usize] == b'"';
                let mut ascii = true;
                for q in pcx.nodes[lit as usize].start..pcx.nodes[lit as usize].end {
                    if get_src()[q as usize] >= 128 || get_src()[q as usize] == b'\\' && q + 1 < pcx.nodes[lit as usize].end
                        && get_src()[(q + 1) as usize] == b'u' {
                        ascii = false;
                    }
                }
                if text && ascii {
                    buf_byte(out, b'b');
                }
                operand(lit, pcx.nodes[c as usize].start, out, pcx);
                if text && !ascii || !text && texts.get(k) != 0 {
                    buf_bytes(out, b".as_bytes()");
                }
                i += 3;
                continue;
            } else {
                used = 0;
            }
            if used > 0 {
                if node <= 0 {
                    return false;
                }
                // (`&mut $1` of an argument written `&x`, MVS's inout marker:
                // the row's borrow, of x)
                let o = buf_slice(out);
                if (o.len() >= 5 && o[o.len() - 5..o.len()] == b"&mut "
                    || o.len() >= 1 && o[o.len() - 1] == b'&')
                    && pcx.nodes[node as usize].kind == NodeKind::Unary && pcx.nodes[node as usize].op == Tok::Amp
                    && get_src()[pcx.nodes[node as usize].start as usize] == b'&' && pcx.nodes[node as usize].b > 0 {
                    // (without what was put where x starts: `&x`'s `mut `)
                    let x = pcx.nodes[node as usize].b;
                    let k = pcx.nodes[x as usize].kind;
                    let term = k == NodeKind::Ident || k == NodeKind::FieldAccess
                        || k == NodeKind::Index || k == NodeKind::TupleField;
                    if !term {
                        buf_byte(out, b'(');
                    }
                    render(pcx.nodes[x as usize].start, pcx.nodes[x as usize].end, false, out, pcx);
                    if !term {
                        buf_byte(out, b')');
                    }
                    i += 2;
                    continue;
                }
                if !in_str && o.len() >= 5 && o[o.len() - 5..o.len()] == b"&mut "
                    && mut_param(node, tr, pcx) {
                    buf_byte(out, b'*');
                }
                if in_str {
                    trailing.push(node);
                } else if nx == b'1' && pcx.nodes[node as usize].kind == NodeKind::Interp
                    || nx == b'1' && pcx.nodes[node as usize].kind == NodeKind::Str && args.count > 1 {
                    // (a format literal: with its values, the text from it to
                    // the allocator, or to the call's `)`)
                    format_text(node, c, if alloc >= 0 { args.get(alloc) } else { -1 }, out, pcx);
                } else if pcx.nodes[node as usize].kind == NodeKind::Closure && i + 2 < t.len()
                    && t[i + 2] == b'(' {
                    // (a closure called in place: its body, the parameters
                    // bound; else `(|a, b| ..)(a, b)`)
                    let after = inline_closure(node, t, i + 2, out, pcx);
                    if after >= 0 {
                        i = after as usize;
                        continue;
                    }
                    buf_byte(out, b'(');
                    operand(node, pcx.nodes[c as usize].start, out, pcx);
                    buf_byte(out, b')');
                } else if i + 2 < t.len() && t[i + 2] == b'.' {
                    // (0.27.6: a receiver, whose text may start with what
                    // the edits put there: `(&s[a..b]).parse::<f64>()`)
                    let w = buf_new();
                    operand(node, pcx.nodes[c as usize].start, w, pcx);
                    let s = buf_slice(w);
                    let wrap = s.len() > 0 && (s[0] == b'&' || s[0] == b'*');
                    if wrap {
                        buf_byte(out, b'(');
                    }
                    buf_bytes(out, s);
                    if wrap {
                        buf_byte(out, b')');
                    }
                } else {
                    operand(node, pcx.nodes[c as usize].start, out, pcx);
                }
                i += 2;
                continue;
            }
        }
        buf_byte(out, ch);
        i += 1;
    }
    true
}

// An operand's rewritten text (parenthesized when it is not one term).
fn operand(n: i64, call_start: i64, out: i64, pcx: &Ctx<Comp>) {
    let k = pcx.nodes[n as usize].kind;
    let simple = k == NodeKind::Ident || k == NodeKind::Call || k == NodeKind::FieldAccess
        || k == NodeKind::Index || k == NodeKind::Int || k == NodeKind::Str || k == NodeKind::Char
        || k == NodeKind::TupleField || k == NodeKind::Path || k == NodeKind::Unary
        || k == NodeKind::Closure || k == NodeKind::Bool || k == NodeKind::MethodCall
        || k == NodeKind::Interp || k == NodeKind::Float || k == NodeKind::Tuple
        || k == NodeKind::Array || k == NodeKind::Block;
    if !simple {
        buf_bytes(out, b"(");
    }
    // (an insertion where the call starts is the call's context's)
    render(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, pcx.nodes[n as usize].start != call_start, out, pcx);
    if !simple {
        buf_bytes(out, b")");
    }
}

// Whether call c's name is written where it is: `r.name(`, `T::name(`,
// `name(`.
fn written_call(c: i64, callee: i64, method: bool, name: &[u8], pcx: &Ctx<Comp>) -> bool {
    if method {
        let r = child(c, 0, pcx);
        let q = crate::tools::translate::skip_ws(pcx.nodes[r as usize].end);
        return q < get_src().len() as i64 && get_src()[q as usize] == b'.'
            && word_here(crate::tools::translate::skip_ws(q + 1), name);
    }
    let e = pcx.nodes[callee as usize].end;
    let s = e - name.len() as i64;
    s >= pcx.nodes[callee as usize].start && token_at(s, pcx) >= 0 && word_here(s, name)
}

// Call c, rewritten by its row.
fn edit_call(c: i64, decls: crate::tools::translate::body::TextDecls, tr: &mut Tr,
    pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let fnode = pcx.fns[f as usize].node;
    if fnode > 0 && editable(pcx.nodes[fnode as usize].start, pcx) {
        return;
    }
    let callee = pcx.nodes[c as usize].a;
    let mut name_sym: i64 = 0;
    let mut owner = &get_src()[0..0];
    let mut method = false;
    let mut free = false;
    if callee == 0 && pcx.nodes[c as usize].count > 0 && pcx.nodes[c as usize].b > 0 {
        method = true;
        name_sym = pcx.nodes[c as usize].b;
        owner = owner_name(pcx.nodes[child(c, 0, pcx) as usize].ty, pcx);
    } else if callee > 0 && pcx.nodes[callee as usize].kind == NodeKind::Path {
        name_sym = pcx.nodes[callee as usize].b;
        owner = sym_text(pcx.nodes[callee as usize].a, pcx);
        // (a module's function, `std::print_int(x)`: a free function's row)
        if owner.len() > 0 && owner[0] >= b'a' && owner[0] <= b'z' {
            owner = &get_src()[0..0];
            free = true;
        }
    } else if callee > 0 && pcx.nodes[callee as usize].kind == NodeKind::Ident {
        // (a path written `std::print_int`: b its last name)
        name_sym = if pcx.nodes[callee as usize].b > 0 { pcx.nodes[callee as usize].b } else { pcx.nodes[callee as usize].a };
        free = true;
    } else {
        return;
    }
    if name_sym <= 0 {
        return;
    }
    let name = sym_text(name_sym, pcx);
    // (a call the checker made, a format literal's pieces or an operator's
    // method, is not written: its text is the expression's)
    if !written_call(c, callee, method, name, pcx) {
        return;
    }
    let mut trait_name = &get_src()[0..0];
    let im = crate::front::traits::impl_of_fn(f, pcx);
    if im >= 0 && im < pcx.traits_impls.len() as i64 {
        let ti = pcx.traits_impls[im as usize].tr;
        if ti >= 0 && ti < pcx.traits.len() as i64 {
            trait_name = sym_text(pcx.traits[ti as usize].name, pcx);
        }
    }
    let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut recv: i64 = -1;
    for i in 0..pcx.nodes[c as usize].count {
        let mut a = child(c, i, pcx);
        if pcx.nodes[a as usize].kind == NodeKind::NamedArg {
            a = pcx.nodes[a as usize].b;
        }
        // (the checker's borrow of an argument: what it borrows)
        if pcx.nodes[a as usize].kind == NodeKind::Unary && get_src()[pcx.nodes[a as usize].start as usize] != b'&'
            && get_src()[pcx.nodes[a as usize].start as usize] != b'*' && pcx.nodes[a as usize].b > 0 {
            a = pcx.nodes[a as usize].b;
        }
        if method && i == 0 {
            recv = a;
        } else if pcx.nodes[a as usize].start > pcx.nodes[c as usize].start || !method && i == 0 {
            args.push(a);
        }
    }
    if method && recv <= 0 {
        return;
    }
    let rt: i64 = if recv > 0 { pcx.nodes[recv as usize].ty } else { 0 };
    let a1: i64 = if args.count > 0 { args.get(0) } else { 0 };
    let mut r = find_row(name, owner, trait_name, free, c, rt, a1, *tr, pcx);
    // (0.27.5) a receiver declared `str`, whose checker type is the erased
    // `[u8]`, or a text literal: str's row (`line.split(' ')`, a byte
    // pattern a char one)
    if r < 0 && owner == b"[T]"
        && (pcx.nodes[recv as usize].kind == NodeKind::Str && get_src()[pcx.nodes[recv as usize].start as usize] == b'"'
            || crate::tools::translate::body::declared_text(recv, 0, decls, pcx)) {
        r = find_row(name, b"str", trait_name, free, c, rt, a1, *tr, pcx);
    }
    if r < 0 {
        return;
    }
    let mut rust = buf_slice(tr.rows.get(r + 2));
    // (a program whose bytes are text: a String's text is a &str)
    if tr.text_mode && buf_slice(tr.rows.get(r)) == b"String::as_slice" {
        rust = b"$r.as_str()";
    }
    if rust == b"!" || rust.len() > 0 && rust[0] == b'!' {
        row_left(c, r, tr, pcx);
        return;
    }
    if rust.len() > 5 && (&rust[0..5] == b"type " || &rust[0..5] == b"impl ") || rust.len() > 3
        && rust[0..3] == b"fn " {
        return;
    }
    let mut alloc: i64 = -1;
    for i in 0..args.count {
        if allocator_type(pcx.nodes[args.get(i) as usize].ty, pcx) {
            alloc = i;
        }
    }
    let out = buf_new();
    if rust == b"-" {
        // (a statement that goes: the call and its `;`)
        let p = parent_of(c, *tr);
        if p > 0 && pcx.nodes[p as usize].kind == NodeKind::ExprStmt {
            put_call(pcx.nodes[p as usize].start, pcx.nodes[p as usize].end, b"", tr, pcx);
        }
        return;
    }
    // (MVS's `f.write(fmt, args..)` writes a format literal with its
    // values: Rust's `write(f, fmt, args..)?`)
    if trait_name.len() == 0 && owner == b"Fmt" && name == b"write" && recv > 0 {
        buf_bytes(out, b"write(");
        operand(recv, pcx.nodes[c as usize].start, out, pcx);
        if args.count > 0 {
            buf_bytes(out, b", ");
            format_text(args.get(0), c, -1, out, pcx);
        }
        buf_bytes(out, b")?");
    } else if !expand(rust, c, recv, args, text_args(args, decls, *tr, pcx), alloc, out, *tr, pcx) {
        row_left(c, r, tr, pcx);
        return;
    }
    let text = char_casts_dropped(buf_slice(out));
    // (a row whose cast of a char literal went, and so leaves the call as
    // written, `s.split('|')`: no edit)
    if text.len() != buf_slice(out).len()
        && text == &get_src()[pcx.nodes[c as usize].start as usize..pcx.nodes[c as usize].end as usize] {
        return;
    }
    put_call(pcx.nodes[c as usize].start, pcx.nodes[c as usize].end, text, tr, pcx);
}

// Call c left to hand by row r: its MVS item, its rust form, its note.
fn row_left(c: i64, r: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_bytes(b, buf_slice(tr.rows.get(r)));
    buf_bytes(b, b" -> ");
    buf_bytes(b, buf_slice(tr.rows.get(r + 2)));
    buf_bytes(b, b" (");
    buf_bytes(b, buf_slice(tr.rows.get(r + 3)));
    buf_bytes(b, b")");
    crate::tools::translate::left_note(pcx.nodes[c as usize].start, TL_ROW, b, tr, pcx);
}

// [a, b) replaced by text, the edits inside it folded in (render).
fn put_call(a: i64, b: i64, text: &[u8], tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // (by both ends: `v.as_mut_slice().sort()` and its receiver start at
    // one place, and each is a row's)
    let key = -(a * 4194304 + (b - a) + 1);
    if tr.done.get(key) != 0 {
        return;
    }
    tr.done.put(key, 1);
    drop_inside(a, b, pcx);
    // (0.27.6: a method written without its parentheses, `f.emsg.len` of
    // a Buf: the row's text has them, edit_len's `()` after it goes)
    if b > a && crate::tools::translate::ident_char(get_src()[(b - 1) as usize])
        && get_src()[crate::tools::translate::skip_ws(b) as usize] != b'(' && text.len() >= 2
        && text[text.len() - 2..text.len()] == b"()" {
        drop_insert_at(b, b"()", pcx);
    }
    let t = buf_new();
    buf_bytes(t, text);
    if edit_replace(a, b, t, pcx) {
        tr.counts[TC_STD as usize] += 1;
        note_row_names(a, text, tr, pcx);
    }
}

// (0.27.5) A row's text with `'c' as char` written `'c'`: a byte row's
// cast of a literal that is already a char (a text program keeps `'|'`
// a char, or a receiver read as str: `s.split('|' as char)`); a byte
// literal's, `b'|' as char`, stays.
fn char_casts_dropped(t: &[u8]) -> &[u8] {
    let out = buf_new();
    let mut i: usize = 0;
    let mut changed = false;
    while i < t.len() {
        if t[i] == b'\''
            && (i == 0 || t[i - 1] != b'b' && !crate::tools::translate::ident_char(t[i - 1])) {
            // (the literal's end: `'c'` or `'\n'`)
            let mut e = i + 1;
            if e < t.len() && t[e] == b'\\' {
                e += 1;
            }
            e += 1;
            if e < t.len() && t[e] == b'\'' && e + 9 <= t.len() && t[e + 1..e + 9] == b" as char" {
                buf_bytes(out, &t[i..e + 1]);
                i = e + 9;
                changed = true;
                continue;
            }
        }
        buf_byte(out, t[i]);
        i += 1;
    }
    if changed { buf_slice(out) } else { t }
}

// The capitalized names a row's text brings at position at (`Layout`,
// `NonNull`) and the modules its paths start with (`mem::`): Tr.row_names, (symbol, position) pairs, for the imports
// (paths.vl). A path's later segment or a method is not one.
pub fn note_row_names(at: i64, text: &[u8], tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut i: usize = 0;
    while i < text.len() {
        let c = text[i];
        let first = i == 0
            || !crate::tools::translate::ident_char(text[i - 1]) && text[i - 1] != b'.'
            && text[i - 1] != b':';
        let mut j = i;
        while j < text.len() && crate::tools::translate::ident_char(text[j]) {
            j += 1;
        }
        // (a module a path starts with, `mem::replace`: row_imports' module)
        let module = c >= b'a' && c <= b'z' && j + 1 < text.len() && text[j] == b':'
            && text[j + 1] == b':';
        if !first || !(c >= b'A' && c <= b'Z' || module) {
            i = if j > i { j } else { i + 1 };
            continue;
        }
        tr.row_names.push(crate::base::intern(&text[i..j], pcx));
        tr.row_names.push(at);
        i = j;
    }
}

// (0.27.5) Whether type node n names an MVS std type whose type row
// writes a region, `'_` (`Command` to `Command<'_, $1>`, `Arg` to
// `Arg<'_>`): an item with views, as a program's struct with a view is,
// whose `'_` takes the region the signature gives the node (static_res).
pub fn type_row_region(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    if n <= 0 || pcx.nodes[n as usize].kind != NodeKind::TyName {
        return false;
    }
    let s = pcx.nodes[n as usize].start;
    let mut ne = s;
    while ne < pcx.nodes[n as usize].end && get_src()[ne as usize] != b'<' {
        ne += 1;
    }
    let mut q = ne;
    while q > s && (crate::tools::translate::ident_char(get_src()[(q - 1) as usize])) {
        q -= 1;
    }
    if q == ne {
        return false;
    }
    let name = &get_src()[q as usize..ne as usize];
    let mut i: i64 = 0;
    while i + 3 < tr.rows.count {
        let t = buf_slice(tr.rows.get(i + 2));
        if t.len() > 5 && t[0..5] == b"type " && buf_slice(tr.rows.get(i)) == name {
            for k in 5..t.len() {
                if k + 1 < t.len() && t[k] == b'\'' && t[k + 1] == b'_' {
                    return true;
                }
            }
            return false;
        }
        i += 4;
    }
    false
}

// (0.27.4) The type rows (rewrite.tsv's `type ..`): an MVS std type's name
// written in a type, `Arena`, `Fmt`, `Buf<A>`, is the row's type (`Arena<Gpa>`,
// `Formatter<'_>`, `Vec<u8, A>`). Its arguments keep their text (and the
// edits in it): the row's text between its `$1`, `$2`, ... replaces the
// name, the separators and the end, which a row with its arguments in
// order and each once allows; another row is left to hand. A name the
// program declares itself is its own.
pub fn type_row_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut own = crate::middle::lower::ssa::HMap {
        keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0,
    };
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if (k == NodeKind::Struct || k == NodeKind::Enum || k == NodeKind::TypeAlias
            || k == NodeKind::Trait) && editable(pcx.nodes[n as usize].start, pcx) {
            own.put(pcx.nodes[n as usize].a + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::TyName || !own_node(n, *tr, pcx)
            || own.get(pcx.nodes[n as usize].a + 1) != 0 {
            continue;
        }
        let s = pcx.nodes[n as usize].start;
        let e = pcx.nodes[n as usize].end;
        // (its name, up to its arguments)
        let mut ne = s;
        while ne < e && get_src()[ne as usize] != b'<' {
            ne += 1;
        }
        // (a std path, `std::Arena`, `thread::JoinHandle`: its last
        // segment; the row's names are imported)
        let mut name = &get_src()[s as usize..ne as usize];
        if word_here(s, b"crate") || word_here(s, b"super") || word_here(s, b"self") {
            continue;
        }
        let mut q0: usize = 0;
        while q0 + 1 < name.len() {
            if name[q0] == b':' && name[q0 + 1] == b':' {
                name = &name[q0 + 2..name.len()];
                q0 = 0;
            } else {
                q0 += 1;
            }
        }
        let mut r: i64 = -1;
        let mut i: i64 = 0;
        while i + 3 < tr.rows.count && r < 0 {
            let t = buf_slice(tr.rows.get(i + 2));
            if buf_slice(tr.rows.get(i)) == name && t.len() > 5 && t[0..5] == b"type " {
                r = i;
            }
            i += 4;
        }
        if r < 0 {
            continue;
        }
        let row = buf_slice(tr.rows.get(r + 2));
        let mut t = &row[5..row.len()];
        // (a renamed type written by its MVS name is that name, which the
        // path pass imports as an alias, `use std::fmt::Formatter as Fmt;`:
        // `Fmt<'_>`, not `Formatter<'_>`; 0.27.6: only a name std2 has a
        // path for, not Buf, which is gone: `Vec<u8, A>`, not `Buf<u8, A>`)
        if name.len() as i64 == ne - s
            && crate::tools::translate::paths::std2_path(crate::base::intern(name, pcx),
                &get_src()[0..0], *tr) != 0 {
            let mut b: usize = 0;
            while b < t.len() && (t[b] == b'&' || t[b] == b' ') {
                b += 1;
            }
            let mut be = b;
            while be < t.len() && (crate::tools::translate::ident_char(t[be])
                || t[be] == b':' && be + 1 < t.len() && t[be + 1] == b':') {
                be += if t[be] == b':' { 2 } else { 1 };
            }
            if &t[b..be] != name {
                let w = buf_new();
                buf_bytes(w, &t[0..b]);
                buf_bytes(w, name);
                buf_bytes(w, &t[be..t.len()]);
                t = buf_slice(w);
            }
        }
        // (0.27.5) its `'_` the region the signature gave the node: a
        // result's `'static` with no parameter to borrow from, or the
        // function's `'a` (sig.vl's mark_region, name_region)
        let region = tr.static_res.get(n + 1);
        if region == 1 || region == 2 {
            let w = buf_new();
            let mut k: usize = 0;
            while k < t.len() {
                if k + 1 < t.len() && t[k] == b'\'' && t[k + 1] == b'_' {
                    buf_bytes(w, if region == 1 { b"'static" } else { b"'a" });
                    k += 2;
                } else {
                    buf_byte(w, t[k]);
                    k += 1;
                }
            }
            t = buf_slice(w);
        }
        // (the row's text cut at its `$k`s: pieces[k] before `$k+1`)
        let mut cuts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ok = true;
        let mut q: usize = 0;
        while q < t.len() {
            if t[q] == b'$' && q + 1 < t.len() && t[q + 1] >= b'1' && t[q + 1] <= b'9' {
                if (t[q + 1] - b'0') as i64 != cuts.count / 2 + 1 {
                    ok = false;
                }
                cuts.push(q as i64);
                cuts.push(q as i64 + 2);
                q += 2;
            } else {
                q += 1;
            }
        }
        let m = cuts.count / 2;
        // (its type arguments: the Generics node g holds them)
        let g = pcx.nodes[n as usize].g;
        let args: i64 = if g > 0 { pcx.nodes[g as usize].count } else { 0 };
        if !ok || m != args {
            left(s, TL_ROW, tr, pcx);
            continue;
        }
        note_row_names(s, t, tr, pcx);
        let mut from = s;
        let mut piece: i64 = 0;
        for k in 0..m + 1 {
            let to = if k < m { pcx.nodes[child(g, k, pcx) as usize].start } else { e };
            let a: i64 = if k == 0 { 0 } else { cuts.get(2 * k - 1) };
            let b = if k < m { cuts.get(2 * k) } else { t.len() as i64 };
            let text = &t[a as usize..b as usize];
            if &get_src()[from as usize..to as usize] != text {
                let w = buf_new();
                buf_bytes(w, text);
                if editable(from, pcx) && edit_replace(from, to, w, pcx) {
                    piece += 1;
                }
            }
            if k < m {
                from = pcx.nodes[child(g, k, pcx) as usize].end;
            }
        }
        if piece > 0 {
            tr.counts[crate::tools::translate::TC_TYPE as usize] += 1;
        }
    }
}

pub fn row_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // (innermost first: by span, the shortest first)
    let mut calls = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Call && own_node(n, *tr, pcx)
            && crate::tools::translate::token_at(pcx.nodes[n as usize].start, pcx) >= 0 {
            calls.push(n);
        }
    }
    let mut spans = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..calls.count {
        let n = calls.get(i);
        spans.push(pcx.nodes[n as usize].end - pcx.nodes[n as usize].start);
    }
    sort_by_key(&mut calls, &mut spans);
    let decls = crate::tools::translate::body::text_decls(*tr, pcx);
    for i in 0..calls.count {
        edit_call(calls.get(i), decls, tr, pcx);
    }
}

// v sorted by keys (a shell sort; the keys move with it).
fn sort_by_key(v: &mut IntVec, keys: &mut IntVec) {
    let mut gap = v.count / 2;
    while gap > 0 {
        for i in gap..v.count {
            let tv = v.get(i);
            let tk = keys.get(i);
            let mut j = i;
            while j >= gap && keys.get(j - gap) > tk {
                { let at_arg2 = v.get(j - gap); v.set(j, at_arg2) };
                { let at_arg2 = keys.get(j - gap); keys.set(j, at_arg2) };
                j -= gap;
            }
            v.set(j, tv);
            keys.set(j, tk);
        }
        gap /= 2;
    }
}

// A format literal (node lit, of call c) with its values: the call's text
// from it to the allocator argument alloc (-1: to the call's `)`).
fn format_text(lit: i64, c: i64, alloc: i64, out: i64, pcx: &Ctx<Comp>) {
    let mut stop = pcx.nodes[c as usize].end - 1;
    if alloc > 0 && pcx.nodes[alloc as usize].start > pcx.nodes[lit as usize].start {
        stop = pcx.nodes[alloc as usize].start;
    }
    while stop > pcx.nodes[lit as usize].end && (crate::tools::translate::is_ws(get_src()[(stop - 1) as usize])
        || get_src()[(stop - 1) as usize] == b',') {
        stop -= 1;
    }
    if stop < pcx.nodes[lit as usize].end {
        stop = pcx.nodes[lit as usize].end;
    }
    render(pcx.nodes[lit as usize].start, stop, true, out, pcx);
}
