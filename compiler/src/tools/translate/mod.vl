// (0.27.3) `volec fix --edition rust FILE|DIR`, the translator
// (docs/design/rust-surface-plan.md §6, "The translator"): an MVS program
// rewritten into a rust-edition program that type-checks against std2 and
// means the same. It is type-directed: the MVS front checks the program,
// and what it resolved (each parameter's convention, each call's callee,
// each expression's type, the accesses and borrows it made of the names)
// decides each rewrite, not the text.
//
// The passes, in order (translate_edits):
// 1. the tree: each node's parent (the checked nodes: a method call is a
//    Call, an access to a let or inout name a `*` the checker made, a
//    borrow for a let parameter a `&` it made); the reference bindings
//    (a let parameter that borrows, an inout parameter or local);
// 2. signatures (sig.vl): `x: T` (let) is `x: &T` where MVS borrows
//    (`T` for a copy), `x: inout T` is `x: &mut T`, `x: sink T` is `x: T`,
//    a view `[T]` is `&[T]`; receivers `&self`, `&mut self`, `self`;
// 3. bodies (body.vl): `var` is `let mut`, `inout r = &e` is `let r = &mut
//    e`, the inout marker `&x` is `&mut x`, a borrow MVS makes for a let
//    parameter is written `&x`, an access to a reference binding that Rust
//    does not dereference by itself is written `*r`, `v.len` is
//    `v.len()`, `println(x)` is `println("{}", x)`, an integer literal
//    MVS types as i64 by default is annotated;
// 4. the file: `// EDITION: rust` at the root's top, the imports std2
//    wants (`use std::alloc::Allocator;`).
// What it cannot decide it leaves as written and reports (`--list-left`),
// and the rust check's errors on the result follow, with their `try:`
// lines: the translation is written as a step (`--dry-run`: the diff).

pub mod body;
pub mod mutable;
pub mod paths;
pub mod regions;
pub mod rows;
pub mod sig;
pub mod statics;
pub mod table;

use crate::base::{
    IntVec, SRC, STDOUT, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::types::{REF_MUT, REF_SHARED, TyKind, buf_type};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::diagnostics::diag;

// What was rewritten (the summary's counts).
pub const TC_LET: i64 = 0;
pub const TC_INOUT: i64 = 1;
pub const TC_SINK: i64 = 2;
pub const TC_RECEIVER: i64 = 3;
pub const TC_VIEW: i64 = 4;
pub const TC_MUT_MARKER: i64 = 5;
pub const TC_BORROW: i64 = 6;
pub const TC_DEREF: i64 = 7;
pub const TC_VAR: i64 = 8;
pub const TC_INOUT_LOCAL: i64 = 9;
pub const TC_LEN: i64 = 10;
pub const TC_PRINT: i64 = 11;
pub const TC_INT: i64 = 12;
pub const TC_STATIC: i64 = 13;
pub const TC_IMPORT: i64 = 14;
pub const TC_BYTES: i64 = 15;
pub const TC_TYPE: i64 = 16;
pub const TC_DERIVE: i64 = 17;
pub const TC_STD: i64 = 18;
pub const TC_TEXT: i64 = 19;
// (0.27.3) a static mut use put in unsafe { } (statics.vl)
pub const TC_UNSAFE: i64 = 20;
// (0.27.3) an i64 index cast to usize (body.vl)
pub const TC_USIZE: i64 = 21;
// (0.27.4) a `[u8]` printed as text given str::from_utf8 (body.vl)
pub const TC_UTF8: i64 = 22;
pub const TC_COUNT: i64 = 23;

// How a parameter is taken (Tr.decided).
pub const D_VALUE: i64 = 1;
pub const D_REF: i64 = 2;
pub const D_MUT: i64 = 3;

// What is left to hand (the report's reasons).
pub const TL_AMPAMP: i64 = 0;
pub const TL_SHARED_LOCAL: i64 = 1;
pub const TL_PRINT: i64 = 2;
pub const TL_ROW: i64 = 3;
pub const TL_BYTES: i64 = 4;
pub const TL_COUNT: i64 = 5;

// The translator's state, for one run.
pub struct Tr {
    // (a place written once per rule: start * 64 + rule + 1)
    pub done: HMap,
    // type node + 1 -> 1: rewritten by a signature's rule
    pub typed: HMap,
    // Param node + 1 -> how the rust edition takes it: D_REF, D_MUT,
    // D_VALUE (the calls of the program's functions follow it)
    pub decided: HMap,
    // node + 1 -> 1: a node of a generic function's instance (a copy of
    // its template's nodes, at their positions: the template is rewritten)
    pub cloned: HMap,
    // the tables (paths.vl: load_tables)
    pub paths: IntVec,
    pub prelude: HMap,
    pub rows: IntVec,
    pub row_free: HMap,
    // (sig.vl: an impl of PartialEq's or Ord's method, whose operand is
    // `&Self` in Rust)
    pub force_ref: bool,
    // (body.vl: text_program) `[u8]` is `&str`: the program's bytes are text
    pub text_mode: bool,
    // node + 1 -> its parent (the checked tree)
    pub parent: HMap,
    // the reference bindings: (from, to, name) triples, a name that is a
    // reference (`&T`, `&mut T`) in the rust edition within [from, to)
    pub refs: IntVec,
    pub counts: [i64; 23],
    pub left: [i64; 5],
    // (pos, reason, note) triples
    pub left_at: IntVec,
    pub sym_self: i64,
    pub sym_len: i64,
    pub sym_allocator: i64,
    // (sig.vl) the result types, views, of the functions that take no
    // reference: `&'static` (node + 1 -> 1)
    pub static_res: HMap,
    // (regions.vl) the structs and enums that hold a view: name + 1 -> node
    pub view_items: HMap,
    // (rows.vl) the capitalized names rows wrote: (symbol, position) pairs
    pub row_names: IntVec,
}

fn tr_new() -> Tr {
    Tr {
        done: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        typed: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        decided: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        cloned: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        paths: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        prelude: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        rows: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        row_free: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        force_ref: false,
        text_mode: false,
        parent: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        refs: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        counts: [0; 23],
        left: [0; 5],
        left_at: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        sym_self: 0,
        sym_len: 0,
        sym_allocator: 0,
        static_res: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        view_items: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        row_names: IntVec { data: 0 as *i64, count: 0, cap: 0 },
    }
}

// ---- Text ----

// Whether position pos is in a file of the program (not std's, not a
// generated one), and inside `--in` when it was given.
pub fn editable(pos: i64, pcx: inout Ctx<Comp>) -> bool {
    // UNSAFE: a file's path is a C string (SourceFile.path, *u8)
    // SAFETY: a file's path is NUL-terminated and not empty: its first byte
    // is read, of the file the position is in (file_of_pos)
    unsafe {
        pos >= 0 && pcx.files[file_of_pos(pos, pcx)].path[0] != '<'
            && (pcx.opt_in == 0 as *u8 || crate::tools::query::refs::ref_in(pos, &pcx))
    }
}

pub fn is_ws(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

pub fn ident_char(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

pub fn skip_ws(p: i64) -> i64 {
    var q = p;
    while is_ws(SRC[q]) {
        q += 1;
    }
    q
}

// Whether the word w is at p (not a prefix of a longer identifier).
pub fn word_here(p: i64, w: [u8]) -> bool {
    for i in 0..w.len as i64 {
        if SRC[p + i] != w[i] {
            return false;
        }
    }
    !ident_char(SRC[p + w.len as i64])
}

// SRC[a..b) replaced by text, once per place and rule; whether it was made.
pub fn put(a: i64, b: i64, text: [u8], what: i64, tr: inout Tr, pcx: inout Ctx<Comp>) -> bool {
    let key = a * 64 + what + 2;
    if !editable(a, &pcx) || tr.done.get(key) != 0 {
        return false;
    }
    let t = buf_new();
    buf_bytes(t, text);
    if !edit_replace(a, b, t, &pcx) {
        return false;
    }
    tr.done.put(key, 1);
    if what >= 0 && what < TC_COUNT {
        tr.counts[what] += 1;
    }
    true
}

// Text inserted at pos before the insertions made there already (put's
// come after them): the closing of what wraps an expression, inside
// what was put after it (`unsafe { Z }) as usize`), or an import before
// an item's new attribute. Whether it was made.
pub fn put_first(pos: i64, text: [u8], tr: inout Tr, pcx: inout Ctx<Comp>) -> bool {
    let t = buf_new();
    buf_bytes(t, text);
    if !editable(pos, &pcx) || !edit_replace(pos, pos, t, &pcx) {
        return false;
    }
    let last = pcx.e_start.count - 1;
    var i: i64 = 0;
    while i < last && !(pcx.e_start.get(i) == pos && pcx.e_end.get(i) == pos) {
        i += 1;
    }
    var j = last;
    while j > i {
        pcx.e_start.set(j, pcx.e_start.get(j - 1));
        pcx.e_end.set(j, pcx.e_end.get(j - 1));
        pcx.e_text.set(j, pcx.e_text.get(j - 1));
        j -= 1;
    }
    if i < last {
        pcx.e_start.set(i, pos);
        pcx.e_end.set(i, pos);
        pcx.e_text.set(i, t);
    }
    true
}

// A place left to hand, once.
pub fn left(pos: i64, why: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    left_note(pos, why, 0, &tr, &pcx);
}

// A place left to hand, once, with a note (a buffer; 0: none).
pub fn left_note(pos: i64, why: i64, note: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let key = pos * 64 + 63 + 2;
    if !editable(pos, &pcx) || tr.done.get(key) != 0 {
        return;
    }
    tr.done.put(key, 1);
    tr.left[why] += 1;
    tr.left_at.push(pos);
    tr.left_at.push(why);
    tr.left_at.push(note);
}

// The token that starts at pos, or -1 (pos inside a token, a string's
// text: a hole of a format literal).
pub fn token_at(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var lo: i64 = 0;
    var hi = pcx.toks.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if pcx.toks[mid].start < pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < pcx.toks.len() as i64 && pcx.toks[lo].start == pos { lo } else { -1 }
}

// Whether node n is written as a name of the program's text (an
// identifier token there, not a hole of a format literal).
pub fn written_name(n: i64, pcx: Ctx<Comp>) -> bool {
    let k = token_at(pcx.nodes[n].start, pcx);
    k >= 0 && pcx.toks[k].kind == Tok::Ident && pcx.toks[k].end == pcx.nodes[n].end
}

// ---- Types ----

pub fn is_ref(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b != 0
}

pub fn is_mut_ref(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == REF_MUT
}

pub fn is_shared_ref(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == REF_SHARED
}

pub fn is_int(t: i64) -> bool {
    crate::front::types::is_integer(t)
}

// ---- The tree ----

// The children of n in the checked tree (its expressions, statements and
// patterns).
pub fn kids_of(n: i64, out: inout IntVec, pcx: Ctx<Comp>) {
    out.count = 0;
    let k = pcx.nodes[n].kind;
    let a = pcx.nodes[n].a;
    let b = pcx.nodes[n].b;
    let c = pcx.nodes[n].c;
    let d = pcx.nodes[n].d;
    if k == NodeKind::Cast || k == NodeKind::Return || k == NodeKind::ExprStmt
        || k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Try
        || k == NodeKind::Closure || k == NodeKind::Defer {
        out.push(a);
    } else if k == NodeKind::Index || k == NodeKind::Repeat || k == NodeKind::Range {
        out.push(a);
        out.push(b);
    } else if k == NodeKind::If {
        out.push(a);
        out.push(b);
        out.push(c);
    } else if k == NodeKind::Loop || k == NodeKind::Break || k == NodeKind::Unary
        || k == NodeKind::FieldInit || k == NodeKind::NamedArg {
        out.push(b);
    } else if k == NodeKind::While || k == NodeKind::Assign || k == NodeKind::Binary {
        out.push(b);
        out.push(c);
    } else if k == NodeKind::Let {
        out.push(a);
        out.push(c);
    } else if k == NodeKind::Arm {
        out.push(a);
        out.push(b);
        out.push(c);
    } else if k == NodeKind::For {
        out.push(b);
        out.push(c);
        out.push(d);
    } else if k == NodeKind::Match || k == NodeKind::Call || k == NodeKind::MethodCall
        || k == NodeKind::Block {
        out.push(a);
    } else if k == NodeKind::Fn || k == NodeKind::Static || k == NodeKind::Const {
        out.push(c);
    }
    if k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::Block
        || k == NodeKind::Match || k == NodeKind::Tuple || k == NodeKind::Array
        || k == NodeKind::StructLit || k == NodeKind::VariantLit || k == NodeKind::PatTuple
        || k == NodeKind::PatVariant || k == NodeKind::PatOr || k == NodeKind::Fn {
        for i in 0..pcx.nodes[n].count {
            out.push(child(n, i, pcx));
        }
    }
}

pub fn parent_of(n: i64, tr: Tr) -> i64 {
    tr.parent.get(n + 1)
}

fn build_parents(tr: inout Tr, pcx: Ctx<Comp>) {
    var kids = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        kids_of(n, &kids, pcx);
        for i in 0..kids.count {
            let k = kids.get(i);
            if k > 0 && k < pcx.nodes.len() as i64 && tr.parent.get(k + 1) == 0 {
                tr.parent.put(k + 1, n);
            }
        }
    }
}

// Every node of an instance's copy of its template (FnInfo.tmpl: the
// instance's node is the copy).
fn mark_clones(tr: inout Tr, pcx: Ctx<Comp>) {
    var stack = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var kids = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    // (a template no instance is checked in place of, as one with a
    // closure's type argument: its first instance's copy is the one read)
    var in_place = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for f in 0..pcx.fns.len() as i64 {
        let t = pcx.fns[f].tmpl;
        if t > 0 && pcx.fns[f].node > 0 && pcx.fns[f].node == pcx.fns[t - 1].node {
            in_place.put(t, 1);
        }
    }
    for f in 0..pcx.fns.len() as i64 {
        let node = pcx.fns[f].node;
        let t = pcx.fns[f].tmpl;
        if t > 0 && node > 0 && node != pcx.fns[t - 1].node {
            if in_place.get(t) == 0 {
                in_place.put(t, 2);
                continue;
            }
            stack.push(node);
        }
    }
    while stack.count > 0 {
        let n = stack.pop();
        if n <= 0 || n >= pcx.nodes.len() as i64 || tr.cloned.get(n + 1) != 0 {
            continue;
        }
        tr.cloned.put(n + 1, 1);
        kids_of(n, &kids, pcx);
        for i in 0..kids.count {
            stack.push(kids.get(i));
        }
        let k = pcx.nodes[n].kind;
        if k == NodeKind::Fn || k == NodeKind::Closure || k == NodeKind::Param {
            for i in 0..pcx.nodes[n].count {
                stack.push(child(n, i, pcx));
            }
            stack.push(pcx.nodes[n].b);
        }
    }
}

// Whether node n is one the rules read: in the program's text, not of an
// instance's copy.
pub fn own_node(n: i64, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    editable(pcx.nodes[n].start, &pcx) && tr.cloned.get(n + 1) == 0
}

// The Fn node around position pos (the innermost), or 0.
pub fn enclosing_fn(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var best = 0;
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Fn && pcx.nodes[n].start <= pos
            && pos < pcx.nodes[n].end
            && (best == 0 || pcx.nodes[n].start >= pcx.nodes[best].start) {
            best = n;
        }
    }
    best
}

// A name that is a reference in [from, to).
pub fn add_ref(from: i64, to: i64, name: i64, tr: inout Tr) {
    tr.refs.push(from);
    tr.refs.push(to);
    tr.refs.push(name);
}

// Whether the name at pos is a reference binding (the innermost one
// declared before pos).
pub fn ref_binding(name: i64, pos: i64, tr: Tr) -> bool {
    var i: i64 = 0;
    while i + 2 < tr.refs.count {
        if tr.refs.get(i + 2) == name && tr.refs.get(i) <= pos && pos < tr.refs.get(i + 1) {
            return true;
        }
        i += 3;
    }
    false
}

// ---- The file ----

// `// EDITION: rust` in the root.
fn file_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    if pcx.files.len() == 0 {
        return;
    }
    let root_start = pcx.files[0].start;
    let text = SRC[root_start..pcx.files[0].end];
    // (the directive is any line of the root: at its end, so that no line
    // moves, and a position the program prints, an assertion's, stays)
    if !crate::front::rust::has_directive(text) {
        let end = pcx.files[0].end;
        let nl = end > root_start && SRC[end - 1] == '\n';
        put(end, end, if nl { "// EDITION: rust\n" } else { "\n// EDITION: rust\n" }, -1, &tr,
            &pcx);
    }
}

// The position after the comment lines and blank lines at the top of a
// file [s, e).
fn after_comments(s: i64, e: i64) -> i64 {
    var p = s;
    while p < e {
        if SRC[p] == '/' && p + 1 < e && SRC[p + 1] == '/' {
            while p < e && SRC[p] != '\n' {
                p += 1;
            }
            p += 1;
        } else if SRC[p] == '\n' {
            p += 1;
        } else {
            break;
        }
    }
    if p > e { e } else { p }
}

// ---- The run ----

// (a probe while the translator is written: VOLE_TR_DUMP=1 prints the
// checked nodes)
pub fn dump_nodes(pcx: Ctx<Comp>) {
    // UNSAFE: a file's path is a C string (SourceFile.path, *u8)
    // SAFETY: only its first byte is read, of a file the node is in; a
    // path is NUL-terminated and not empty
    unsafe {
        let out = buf_new();
        for n in 1..pcx.nodes.len() as i64 {
            let s = pcx.nodes[n].start;
            let e = pcx.nodes[n].end;
            if s < 0 || e <= s || pcx.files[file_of_pos(s, pcx)].path[0] == '<' {
                continue;
            }
            buf_int(out, n);
            buf_str(out, c" ");
            buf_int(out, pcx.nodes[n].kind as i64);
            buf_str(out, c" op=");
            buf_int(out, pcx.nodes[n].op as i64);
            buf_str(out, c" a=");
            buf_int(out, pcx.nodes[n].a);
            buf_str(out, c" b=");
            buf_int(out, pcx.nodes[n].b);
            buf_str(out, c" c=");
            buf_int(out, pcx.nodes[n].c);
            buf_str(out, c" x=");
            buf_int(out, pcx.nodes[n].x);
            buf_str(out, c" y=");
            buf_int(out, pcx.nodes[n].y);
            buf_str(out, c" p=");
            buf_int(out, pcx.nodes[n].p);
            buf_str(out, c" g=");
            buf_int(out, pcx.nodes[n].g);
            buf_str(out, c" h=");
            buf_int(out, pcx.nodes[n].h);
            buf_str(out, c" n=");
            buf_int(out, pcx.nodes[n].count);
            buf_str(out, c" ty=");
            if pcx.nodes[n].ty > 0 {
                buf_type(out, pcx.nodes[n].ty, pcx);
            }
            buf_str(out, c" `");
            let stop = if e - s > 40 { s + 40 } else { e };
            for i in s..stop {
                let ch = SRC[i];
                buf_bytes(out, if ch == '\n' { " " } else { SRC[i..i + 1] });
            }
            buf_str(out, c"`\n");
        }
        buf_write_fd(out, STDOUT);
    }
}

// FILE:LINE:COL of position pos.
pub fn put_pos(out: i64, pos: i64, pcx: Ctx<Comp>) {
    let f = file_of_pos(pos, pcx);
    var line = 1;
    var col = 1;
    for q in pcx.files[f].start..pos {
        if SRC[q] == '\n' {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
    }
    buf_str(out, pcx.files[f].path);
    buf_bytes(out, ":");
    buf_int(out, line);
    buf_bytes(out, ":");
    buf_int(out, col);
}

fn put_count(out: i64, n: i64, one: [u8], many: [u8]) {
    if n == 0 {
        return;
    }
    buf_bytes(out, ", ");
    buf_int(out, n);
    buf_bytes(out, " ");
    buf_bytes(out, if n == 1 { one } else { many });
}

fn left_reason(why: i64) -> [u8] {
    if why == TL_AMPAMP {
        "a reference to a reference ('&&'): by hand"
    } else if why == TL_SHARED_LOCAL {
        "a shared reference local ('let r = &e;'): check the borrow"
    } else if why == TL_PRINT {
        "a print of a value that is not a format literal's: by hand"
    } else if why == TL_ROW {
        "a std call rewrite.tsv leaves to hand (its note says how)"
    } else {
        "bytes used both as text and as bytes: [u8] kept as &[u8] (str::from_utf8 where it prints)"
    }
}

fn report_left(tr: Tr, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    var total = 0;
    for i in 0..TL_COUNT {
        total += tr.left[i];
    }
    if total == 0 {
        return;
    }
    if tcx.conv_list_left {
        var i: i64 = 0;
        while i + 2 < tr.left_at.count {
            let pos = tr.left_at.get(i);
            let d = diag(c"note", c"fix.edition_left", &tcx);
            put_pos(d, pos, pcx);
            buf_bytes(d, ": ");
            buf_bytes(d, left_reason(tr.left_at.get(i + 1)));
            if tr.left_at.get(i + 2) != 0 {
                buf_bytes(d, ": ");
                buf_bytes(d, buf_slice(tr.left_at.get(i + 2)));
            }
            buf_bytes(d, "\n");
            i += 3;
        }
    }
    let d = diag(c"note", c"fix.edition_left", &tcx);
    buf_int(d, total);
    buf_bytes(d, " left to hand (--list-left lists them):");
    for i in 0..TL_COUNT {
        if tr.left[i] > 0 {
            buf_bytes(d, " ");
            buf_int(d, tr.left[i]);
            buf_bytes(d, " ");
            buf_bytes(d, left_reason(i));
            buf_bytes(d, ";");
        }
    }
    buf_bytes(d, "\n");
}

// The edits of `fix --edition rust`; the number of rewrites.
pub fn translate_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    // UNSAFE: getenv is C's (the probe's switch, VOLE_TR_DUMP)
    // SAFETY: a NUL-terminated literal; only the result's nullness is read
    unsafe {
        let d = crate::base::getenv(c"VOLE_TR_DUMP");
        if d != 0 as *u8 {
            dump_nodes(pcx);
        }
    }
    var tr = tr_new();
    tr.sym_self = crate::base::intern("self", &pcx);
    tr.sym_len = crate::base::intern("len", &pcx);
    tr.sym_allocator = crate::base::intern("Allocator", &pcx);
    crate::tools::translate::paths::load_tables(&tr, &pcx);
    build_parents(&tr, pcx);
    mark_clones(&tr, pcx);
    tr.text_mode = crate::tools::translate::body::text_program(tr, &pcx);
    crate::tools::translate::sig::signature_edits(&tr, &pcx);
    crate::tools::translate::body::body_edits(&tr, &pcx);
    crate::tools::translate::statics::static_edits(&tr, &pcx);
    crate::tools::translate::mutable::mutable_edits(&tr, &pcx);
    crate::tools::translate::body::ptr_slice_edits(&tr, &pcx);
    file_edits(&tr, &pcx);
    crate::tools::translate::paths::path_edits(&tr, &pcx);
    crate::tools::translate::rows::row_edits(&tr, &pcx);
    crate::tools::translate::paths::row_imports(&tr, &pcx);
    report_left(tr, &tcx, pcx);
    var total = 0;
    for i in 0..TC_COUNT {
        total += tr.counts[i];
    }
    let out = buf_new();
    put_count(out, tr.counts[TC_LET], "parameter to &T", "parameters to &T");
    put_count(out, tr.counts[TC_INOUT], "parameter to &mut T", "parameters to &mut T");
    put_count(out, tr.counts[TC_SINK], "sink parameter to T", "sink parameters to T");
    put_count(out, tr.counts[TC_RECEIVER], "receiver", "receivers");
    put_count(out, tr.counts[TC_VIEW], "view to &[T]", "views to &[T]");
    put_count(out, tr.counts[TC_MUT_MARKER], "'&x' to '&mut x'", "'&x's to '&mut x'");
    put_count(out, tr.counts[TC_BORROW], "borrow written '&x'", "borrows written '&x'");
    put_count(out, tr.counts[TC_DEREF], "access written '*r'", "accesses written '*r'");
    put_count(out, tr.counts[TC_VAR], "var to 'let mut'", "vars to 'let mut'");
    put_count(out, tr.counts[TC_INOUT_LOCAL], "inout local", "inout locals");
    put_count(out, tr.counts[TC_LEN], "'.len' to '.len()'", "'.len's to '.len()'");
    put_count(out, tr.counts[TC_PRINT], "print given its format", "prints given their format");
    put_count(out, tr.counts[TC_INT], "integer annotated", "integers annotated");
    put_count(out, tr.counts[TC_STATIC], "static var to 'static mut'",
        "static vars to 'static mut'");
    put_count(out, tr.counts[TC_IMPORT], "import", "imports");
    put_count(out, tr.counts[TC_BYTES], "text literal to bytes", "text literals to bytes");
    put_count(out, tr.counts[TC_TYPE], "type", "types");
    put_count(out, tr.counts[TC_STD], "std call by rewrite.tsv", "std calls by rewrite.tsv");
    put_count(out, tr.counts[TC_TEXT], "text view to &str", "text views to &str");
    put_count(out, tr.counts[TC_UNSAFE], "static mut use put in unsafe",
        "static mut uses put in unsafe");
    put_count(out, tr.counts[TC_USIZE], "index cast to usize", "indexes cast to usize");
    put_count(out, tr.counts[TC_UTF8], "byte view printed as text by str::from_utf8",
        "byte views printed as text by str::from_utf8");
    put_count(out, tr.counts[TC_DERIVE], "copy type derived Clone, Copy",
        "copy types derived Clone, Copy");
    tcx.tr_summary = out;
    total
}

// The summary's counts (fix's line: `fixed ...`).
pub fn put_counts(what: i64, tcx: Tcx<Comp>) {
    if tcx.tr_summary != 0 {
        buf_bytes(what, buf_slice(tcx.tr_summary));
    }
}

// (the name of symbol s, for the rules' messages)
pub fn name_of(s: i64, pcx: Ctx<Comp>) -> [u8] {
    sym_text(s, pcx)
}
