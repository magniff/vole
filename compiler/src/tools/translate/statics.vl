// (0.27.3) The translator's statics (mod.vl, pass 3b): a `static var` is
// `static mut`, and its every read or write is unsafe in the rust edition
// (F19.6, rustc E0133). Each use outside unsafe code is put in an `unsafe
// { }` block: the place it is (`V[i]`, `s.f`), or the assignment, method
// call or operator it is the operand of (`unsafe { M += 1; }`, `unsafe {
// V.push(x) }`); one in a format literal's hole (`"{M}"`) is read into a
// local before its statement (`let m_now = unsafe { M }; .. "{m_now}"`).

use crate::base::{IntVec, SRC, buf_byte, buf_bytes, buf_new};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{BLOCK_UNSAFE, NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::types::TyKind;
use crate::middle::lower::ssa::HMap;
use crate::tools::edit::edit_replace;
use crate::tools::translate::{
    TC_UNSAFE, Tr, editable, enclosing_fn, ident_char, parent_of, put, put_first, token_at,
    word_here,
};

// Whether position pos is in unsafe code: an `unsafe { }` block of the
// program, or the body of an `unsafe fn`.
fn in_unsafe(pos: i64, blocks: IntVec, pcx: Ctx<Comp>) -> bool {
    var i: i64 = 0;
    while i + 1 < blocks.count {
        if blocks.get(i) <= pos && pos < blocks.get(i + 1) {
            return true;
        }
        i += 2;
    }
    let f = enclosing_fn(pos, pcx);
    if f == 0 {
        return false;
    }
    var q = pcx.nodes[f].start;
    while q < pcx.nodes[f].end && SRC[q] != '(' {
        // (the word, not a name ending in it: `fn query_unsafe(`)
        if !ident_char(SRC[q - 1]) && word_here(q, "unsafe") {
            return true;
        }
        q += 1;
    }
    false
}

// The node the use n of a static is wrapped as: the place it is the base
// of, or the assignment (its statement), method call or operator that
// place is the target or operand of.
fn wrap_target(n: i64, tr: Tr, pcx: Ctx<Comp>) -> i64 {
    var p = n;
    loop {
        let q = parent_of(p, tr);
        let k = if q > 0 { pcx.nodes[q].kind } else { NodeKind::None };
        if q > 0 && pcx.nodes[q].a == p
            && (k == NodeKind::Index || k == NodeKind::FieldAccess || k == NodeKind::TupleField) {
            p = q;
        } else {
            break;
        }
    }
    let q = parent_of(p, tr);
    if q == 0 {
        return p;
    }
    // (the receiver borrow the checker makes, not written: `V.push(x)` is
    // `push(&mut V, x)`; the call is wrapped, not a copy of V)
    if pcx.nodes[q].kind == NodeKind::Unary && pcx.nodes[q].b == p
        && pcx.nodes[q].start == pcx.nodes[p].start {
        let c = parent_of(q, tr);
        if c > 0
            && (pcx.nodes[c].kind == NodeKind::Call || pcx.nodes[c].kind == NodeKind::MethodCall)
            && pcx.nodes[c].count > 0 && child(c, 0, pcx) == q
            && pcx.nodes[c].start == pcx.nodes[p].start {
            return c;
        }
    }
    let k = pcx.nodes[q].kind;
    if k == NodeKind::Assign && pcx.nodes[q].b == p {
        let s = parent_of(q, tr);
        return if s > 0 && pcx.nodes[s].kind == NodeKind::ExprStmt { s } else { q };
    }
    if (k == NodeKind::Call || k == NodeKind::MethodCall) && pcx.nodes[q].count > 0
        && child(q, 0, pcx) == p && pcx.nodes[q].start == pcx.nodes[p].start {
        return q;
    }
    if k == NodeKind::Unary && pcx.nodes[q].b == p {
        return q;
    }
    p
}

// The statement around position pos of the innermost block written around
// it (where a read is put before it), or -1.
fn statement_at(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var best: i64 = -1;
    for n in 1..pcx.nodes.len() as i64 {
        let s = pcx.nodes[n].start;
        if pcx.nodes[n].kind != NodeKind::Block || s >= pos || pos >= pcx.nodes[n].end
            || SRC[s] != '{' {
            continue;
        }
        for i in 0..pcx.nodes[n].count + 1 {
            let t = if i < pcx.nodes[n].count { child(n, i, pcx) } else { pcx.nodes[n].a };
            if t > 0 && pcx.nodes[t].start > s && pcx.nodes[t].start <= pos
                && pos < pcx.nodes[t].end && pcx.nodes[t].start > best {
                best = pcx.nodes[t].start;
            }
        }
    }
    best
}

// The local a hole reads the static at SRC[a..b) into: its name in lower
// case, then `_now`.
fn local_name(a: i64, b: i64, out: i64) {
    for q in a..b {
        let c = SRC[q];
        buf_byte(out, if c >= 'A' && c <= 'Z' { c + 32 } else { c });
    }
    buf_bytes(out, "_now");
}

// An insertion at pos (one of several there, kept in order: not put's
// once-per-place key); whether it was made.
fn insert(pos: i64, text: i64, tr: inout Tr, pcx: inout Ctx<Comp>) -> bool {
    if !editable(pos, &pcx) || !edit_replace(pos, pos, text, &pcx) {
        return false;
    }
    tr.counts[TC_UNSAFE] += 1;
    true
}

// Whether the block written around node t starts a statement and is an
// operand there (`unsafe { V }.m()`, `unsafe { S[i] } == c`): a block
// first in a statement ends the statement in the rust edition (as in
// Rust), so it is written `(unsafe { .. })`.
fn operand_at_statement_start(t: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    var e = pcx.nodes[t].end;
    while e < SRC.len() as i64 && (SRC[e] == ' ' || SRC[e] == '\n' || SRC[e] == '\t') {
        e += 1;
    }
    if SRC[e] == ';' || SRC[e] == '}' || SRC[e] == ')' || SRC[e] == ',' || SRC[e] == ']' {
        return false;
    }
    var p = t;
    loop {
        let q = parent_of(p, tr);
        if q == 0 {
            return false;
        }
        if pcx.nodes[q].kind == NodeKind::Block {
            // (t a statement itself, `unsafe { M += 1; }`: none)
            return p != t
                && (SRC[pcx.nodes[q].start] == '{' || word_here(pcx.nodes[q].start, "unsafe"));
        }
        if pcx.nodes[q].start != pcx.nodes[t].start {
            return false;
        }
        p = q;
    }
}

// How the place rooted at static use n is borrowed: 0 not, 1 shared
// (`&V`, a `&self` receiver), 2 exclusive (`&mut V`, `V.push(x)`'s
// receiver), 3 its raw address written `&V` (given to a `*T`). Rust 2024 makes no reference to a `static mut` (D6.2.5):
// such a root is read through its raw address, `(*(&raw mut V))`.
fn borrowed_root(n: i64, tr: Tr, pcx: Ctx<Comp>) -> i64 {
    var p = n;
    loop {
        let q = parent_of(p, tr);
        let k = if q > 0 { pcx.nodes[q].kind } else { NodeKind::None };
        if q > 0 && pcx.nodes[q].a == p
            && (k == NodeKind::FieldAccess || k == NodeKind::TupleField) {
            p = q;
        } else {
            break;
        }
    }
    let q = parent_of(p, tr);
    // (a method called on the place, `V.total()`: Rust borrows its
    // receiver; a shared borrow reads a copy's receiver as well)
    if q > 0 && (pcx.nodes[q].kind == NodeKind::Call || pcx.nodes[q].kind == NodeKind::MethodCall)
        && pcx.nodes[q].count > 0 && child(q, 0, pcx) == p
        && pcx.nodes[q].start == pcx.nodes[p].start {
        // (a primitive's method takes it by value: `N.max(3)` copies)
        let pt = pcx.nodes[p].ty;
        return if pt >= crate::front::types::TY_I8 && pt <= crate::front::types::TY_ISIZE { 0 }
            else { 1 };
    }
    if q <= 0 || pcx.nodes[q].kind != NodeKind::Unary || pcx.nodes[q].op != Tok::Amp
        || pcx.nodes[q].b != p {
        return 0;
    }
    let t = pcx.nodes[q].ty;
    if t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == 0 {
        // (a raw address MVS takes, `&V` given to a `*T`: `&raw mut V`)
        return if SRC[pcx.nodes[q].start] == '&' && p == n { 3 } else { 0 };
    }
    if crate::tools::translate::is_mut_ref(t, pcx) { 2 } else { 1 }
}

pub fn static_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    var blocks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Block && (pcx.nodes[n].p & BLOCK_UNSAFE) != 0
            && (SRC[pcx.nodes[n].start] == '{' || word_here(pcx.nodes[n].start, "unsafe")) {
            blocks.push(pcx.nodes[n].start);
            blocks.push(pcx.nodes[n].end);
        }
    }
    var targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var marked = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    var read = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Ident || pcx.nodes[n].res != Res::Static
            || !editable(pcx.nodes[n].start, &pcx) {
            continue;
        }
        let y = pcx.nodes[n].y;
        if y < 0 || y >= pcx.statics.len() as i64 || !pcx.statics[y].mutable {
            continue;
        }
        let a = pcx.nodes[n].start;
        let b = pcx.nodes[n].end;
        if token_at(a, pcx) >= 0 {
            // (a borrowed root: read through its raw address, D6.2.5)
            let how = borrowed_root(n, tr, pcx);
            if how == 3 {
                let q = parent_of(n, tr);
                let w = buf_new();
                buf_bytes(w, "&raw mut ");
                edit_replace(pcx.nodes[q].start, a, w, &pcx);
            } else if how > 0 {
                let w = buf_new();
                buf_bytes(w, if how == 2 { "(*(&raw mut " } else { "(*(&raw const " });
                buf_bytes(w, SRC[a..b]);
                buf_bytes(w, "))");
                edit_replace(a, b, w, &pcx);
            }
        }
        if in_unsafe(pcx.nodes[n].start, blocks, pcx) {
            continue;
        }
        if token_at(a, pcx) < 0 {
            // (a hole of a format literal: the local, read before)
            let at = statement_at(a, pcx);
            if at < 0 {
                continue;
            }
            let name = buf_new();
            local_name(a, b, name);
            if read.get(at * 4096 + y + 1) == 0 {
                read.put(at * 4096 + y + 1, 1);
                let t = buf_new();
                buf_bytes(t, "let ");
                buf_bytes(t, crate::base::buf_slice(name));
                buf_bytes(t, " = unsafe { ");
                buf_bytes(t, SRC[a..b]);
                buf_bytes(t, " }; ");
                insert(at, t, &tr, &pcx);
            }
            put(a, b, crate::base::buf_slice(name), TC_UNSAFE, &tr, &pcx);
            continue;
        }
        let t = wrap_target(n, tr, pcx);
        if marked.get(t + 1) == 0 {
            marked.put(t + 1, 1);
            targets.push(t);
        }
    }
    for i in 0..targets.count {
        let t = targets.get(i);
        // (one inside another's block is unsafe code already)
        var q = parent_of(t, tr);
        var inside = false;
        while q > 0 && !inside {
            inside = marked.get(q + 1) != 0;
            q = parent_of(q, tr);
        }
        if inside {
            continue;
        }
        let paren = operand_at_statement_start(t, tr, pcx);
        let open = buf_new();
        buf_bytes(open, if paren { "(unsafe { " } else { "unsafe { " });
        if insert(pcx.nodes[t].start, open, &tr, &pcx) {
            let close = if paren { " })" } else { " }" };
            if pcx.nodes[t].kind == NodeKind::FieldAccess && pcx.nodes[t].b == tr.sym_len {
                // (after the `()` body.vl gave `.len`: `unsafe { S.len() }`)
                let c = buf_new();
                buf_bytes(c, close);
                edit_replace(pcx.nodes[t].end, pcx.nodes[t].end, c, &pcx);
            } else {
                // (inside what was put after the place: `(unsafe { Z }) as usize`)
                put_first(pcx.nodes[t].end, close, &tr, &pcx);
            }
        }
    }
}
