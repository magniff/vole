// (0.27.3) The translator's signatures and types (mod.vl, pass 2): a
// parameter's convention written as Rust's type, a receiver as Rust's
// self, a view `[T]` as `&[T]`.

use crate::base::{IntVec, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::conv::{CONV_IN_OUT, CONV_LET, CONV_SINK_K, param_conv};
use crate::front::lexer::Tok;
use crate::front::own::summary::{S_L1_P, S_L1_STAR, S_L2_P, S_L2_STAR, summary_of};
use crate::front::types::fn_param;
use crate::middle::lower::ssa::HMap;
use crate::tools::translate::{
    D_MUT, D_REF, D_VALUE, TC_DERIVE, TC_INOUT, TC_LET, TC_RECEIVER, TC_SINK, TC_TEXT, TC_TYPE,
    TC_VIEW, Tr, add_ref, editable, ident_char, is_ref, is_ws, own_node, parent_of, put, skip_ws,
    word_here,
};

// The operator traits, whose methods take self and their operand by value
// in Rust (table rows `impl ... fn add(self, rhs: Self)`).
fn by_value_trait(name: &[u8]) -> bool {
    name == b"Add" || name == b"Sub" || name == b"Mul" || name == b"Div" || name == b"Rem"
        || name == b"Neg" || name == b"Not" || name == b"BitAnd" || name == b"BitOr"
        || name == b"BitXor" || name == b"Shl" || name == b"Shr"
}

// Whether a type written as the node tn is a primitive's name (taken by
// value by a let parameter: a copy).
fn primitive_name(tn: i64, pcx: &Ctx<Comp>) -> bool {
    if tn <= 0 || pcx.nodes[tn as usize].kind != NodeKind::TyName {
        return false;
    }
    let w = &get_src()[pcx.nodes[tn as usize].start as usize..pcx.nodes[tn as usize].end as usize];
    w == b"i8" || w == b"i16" || w == b"i32" || w == b"i64" || w == b"u8" || w == b"u16"
        || w == b"u32" || w == b"u64" || w == b"usize" || w == b"isize" || w == b"f32"
        || w == b"f64" || w == b"bool" || w == b"char"
}

// The trait name of the impl that function node n is in ("" for none).
fn impl_trait(n: i64, impls: HMap, pcx: &Ctx<Comp>) -> &'static [u8] {
    let im = impls.get(n + 1);
    if im <= 0 {
        return b"";
    }
    let t = pcx.nodes[im as usize].a;
    if t <= 0 {
        return b"";
    }
    crate::base::sym_text(pcx.nodes[t as usize].a, pcx)
}

// A receiver: `self` is `&self` (`self` in an operator trait's impl),
// `inout self` `&mut self`, `sink self` `self`; `self: *T` (a raw pointer)
// is `self: *mut T`.
fn edit_receiver(p: i64, by_value: bool, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[p as usize].start;
    let c = param_conv(p, pcx);
    if c == CONV_IN_OUT && word_here(s, b"inout") {
        put(s, skip_ws(s + 5), b"&mut ", TC_RECEIVER, tr, pcx);
    } else if c == CONV_SINK_K && word_here(s, b"sink") {
        put(s, skip_ws(s + 4), b"", TC_RECEIVER, tr, pcx);
    }
    else if c == CONV_LET && word_here(s, b"self") && !by_value
        && get_src()[skip_ws(s + 4) as usize] != b':' {
        // (a typed one, `self: *T`, keeps its type: `self: *mut T`)
        put(s, s, b"&", TC_RECEIVER, tr, pcx);
    }
}

// Parameter i (node p) of function node n (function f; -1: a trait's
// declaration, which has no checked signature).
fn edit_param(n: i64, f: i64, i: i64, p: i64, by_value: bool, gen: i64, tr: &mut Tr,
    pcx: &mut Ctx<Comp>) {
    let tn = pcx.nodes[p as usize].b;
    let name = pcx.nodes[p as usize].a;
    if name == tr.sym_self {
        edit_receiver(p, by_value, tr, pcx);
        if param_conv(p, pcx) == CONV_IN_OUT {
            tr.decided.put(p + 1, D_MUT);
            add_ref(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, name, tr);
        } else if param_conv(p, pcx) == CONV_LET && !by_value {
            tr.decided.put(p + 1, D_REF);
            add_ref(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, name, tr);
        } else {
            tr.decided.put(p + 1, D_VALUE);
        }
        return;
    }
    if tn <= 0 {
        return;
    }
    let ts = pcx.nodes[tn as usize].start;
    let c = param_conv(p, pcx);
    if c == CONV_IN_OUT {
        if word_here(ts, b"inout") {
            put(ts, skip_ws(ts + 5), b"&mut ", TC_INOUT, tr, pcx);
            tr.typed.put(tn + 1, 1);
        }
        tr.decided.put(p + 1, D_MUT);
        add_ref(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, name, tr);
        return;
    }
    if c == CONV_SINK_K {
        tr.decided.put(p + 1, D_VALUE);
        if word_here(ts, b"sink") {
            put(ts, skip_ws(ts + 4), b"", TC_SINK, tr, pcx);
        } else {
            // (the word before the type node: `d: sink D`)
            let mut q = ts - 1;
            while q > pcx.nodes[p as usize].start
                && (get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t') {
                q -= 1;
            }
            if q >= 3 && get_src()[(q - 3) as usize..(q + 1) as usize] == b"sink" {
                put(q - 3, ts, b"", TC_SINK, tr, pcx);
            }
        }
        return;
    }
    if c != CONV_LET {
        return;
    }
    // (a written `let T`: the word goes, the reference decides below)
    let mut at = ts;
    if word_here(ts, b"let") {
        at = skip_ws(ts + 3);
        put(ts, at, b"", -1, tr, pcx);
    }
    let tk = pcx.nodes[tn as usize].kind;
    if tk == NodeKind::TySlice && get_src()[at as usize] == b'[' {
        view_put(tn, at, tr, pcx);
        tr.typed.put(tn + 1, 1);
        tr.decided.put(p + 1, D_VALUE);
        return;
    }
    tr.decided.put(p + 1, D_VALUE);
    if by_value {
        return;
    }
    // (a type parameter: by value, as Rust takes `f: F` and `x: T`; `mut f`
    // for a closure it calls through FnMut)
    let bound = type_param_bound(n, tn, gen, pcx);
    if bound >= 2 {
        if bound == 3 {
            put(pcx.nodes[p as usize].start, pcx.nodes[p as usize].start, b"mut ", -1, tr, pcx);
        }
        return;
    }
    if bound == 0 {
        // (a type parameter T: `&T`, MVS's borrow, unless the function
        // gives the parameter back, which a reference could not)
        if !returns_name(pcx.nodes[n as usize].c, name, pcx) {
            put(at, at, b"&", TC_LET, tr, pcx);
            tr.decided.put(p + 1, D_REF);
        }
        return;
    }
    let borrows = if tr.force_ref && !is_ref_type_node(tn, pcx) { true }
        else if f >= 0 && i < pcx.fns[f as usize].param_count { is_ref(fn_param(f, i, pcx), pcx) }
        else { !primitive_name(tn, pcx) && tk != NodeKind::TyPtr && tk != NodeKind::TyFn };
    if borrows {
        put(at, at, b"&", TC_LET, tr, pcx);
        tr.decided.put(p + 1, D_REF);
        add_ref(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, name, tr);
    }
}

// A view's `&` for region v of Tr.static_res (0: elided, 1: `'static`, 2:
// the function's `'a`).
fn region_amp(v: i64) -> &'static [u8] {
    if v == 1 { b"&'static " } else if v == 2 { b"&'a " } else { b"&" }
}

// A view type node tn, `[T]` at `at`: `&[T]`; `&str` for `[u8]` in a
// program that uses its bytes as text only (body.vl: text_program).
fn view_put(tn: i64, at: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let e = pcx.nodes[tn as usize].a;
    let st = tr.static_res.get(tn + 1);
    if tr.text_mode && e > 0 && pcx.nodes[e as usize].kind == NodeKind::TyName
        && get_src()[pcx.nodes[e as usize].start as usize..pcx.nodes[e as usize].end as usize]
        == b"u8" {
        put(at, pcx.nodes[tn as usize].end,
            if st == 1 { b"&'static str" } else if st == 2 { b"&'a str" } else { b"&str" }, TC_TEXT,
            tr, pcx);
        tr.typed.put(e + 1, 1);
    } else {
        put(at, at, region_amp(st), TC_VIEW, tr, pcx);
    }
}

// Whether type node t (and its arguments) names symbol s.
fn names_in(t: i64, s: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    for q in pcx.nodes[t as usize].start..pcx.nodes[t as usize].end {
        if (q == pcx.nodes[t as usize].start
            || !crate::tools::translate::ident_char(get_src()[(q - 1) as usize]))
            && get_src()[q as usize] >= b'A' && get_src()[q as usize] <= b'Z' {
            let mut e = q;
            while e < pcx.nodes[t as usize].end
                && crate::tools::translate::ident_char(get_src()[e as usize]) {
                e += 1;
            }
            if &get_src()[q as usize..e as usize] == crate::base::sym_text(s, pcx) {
                return true;
            }
        }
    }
    false
}

// Whether the body b gives back the name s: its tail, a `return s`, the
// tail of an if's or a match's branch.
fn returns_name(b: i64, s: i64, pcx: &Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Ident || pcx.nodes[n as usize].a != s
            || pcx.nodes[n as usize].start < pcx.nodes[b as usize].start
            || pcx.nodes[n as usize].end > pcx.nodes[b as usize].end {
            continue;
        }
        // (followed by `}` or `;` after a `return`, or `}` alone: a tail)
        let after = crate::tools::translate::skip_ws(pcx.nodes[n as usize].end);
        let mut q = pcx.nodes[n as usize].start - 1;
        while q > 0 && crate::tools::translate::is_ws(get_src()[q as usize]) {
            q -= 1;
        }
        let before_ok = get_src()[q as usize] == b'{' || get_src()[q as usize] == b';'
            || get_src()[q as usize] == b'>' && get_src()[(q - 1) as usize] == b'='
            || q >= 5 && get_src()[(q - 5) as usize..(q + 1) as usize] == b"return";
        if before_ok
            && (get_src()[after as usize] == b'}' || get_src()[after as usize] == b';'
                || get_src()[after as usize] == b',') {
            return true;
        }
    }
    false
}

fn is_ref_type_node(tn: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[tn as usize].kind == NodeKind::TyPtr
        || pcx.nodes[tn as usize].kind == NodeKind::TySlice
}

// Whether type node tn names a type parameter of function node n or of
// its impl (gen, the impl's generics): -1 when it does not, else its Fn
// bound's kind (0: none, 2: Fn or Allocator, by value, 3: FnMut).
fn type_param_bound(n: i64, tn: i64, gen: i64, pcx: &Ctx<Comp>) -> i64 {
    if tn <= 0 || pcx.nodes[tn as usize].kind != NodeKind::TyName
        || pcx.nodes[tn as usize].count > 0 {
        return -1;
    }
    let name = pcx.nodes[tn as usize].a;
    for w in 0..2 {
        let g = if w == 0 { pcx.nodes[n as usize].g } else { gen };
        if g <= 0 || pcx.nodes[g as usize].kind != NodeKind::Generics {
            continue;
        }
        for i in 0..pcx.nodes[g as usize].count {
            let tp = child(g, i, pcx);
            if pcx.nodes[tp as usize].a != name {
                continue;
            }
            let h = pcx.nodes[tp as usize].h;
            if h > 0 && pcx.nodes[h as usize].kind == NodeKind::Generics {
                for j in 0..pcx.nodes[h as usize].count {
                    let b = child(h, j, pcx);
                    if pcx.nodes[b as usize].kind == NodeKind::TyFn
                        && pcx.nodes[b as usize].d >= 2 {
                        return pcx.nodes[b as usize].d;
                    }
                    // (an allocator, which MVS copies: by value, as Gpa)
                    if pcx.nodes[b as usize].kind == NodeKind::TyName
                        && word_here(pcx.nodes[b as usize].start, b"Allocator") {
                        return 2;
                    }
                }
            }
            return 0;
        }
    }
    -1
}

// Whether function node n takes a parameter by reference in the rust
// edition (as decided, or a view or reference written).
fn borrows_param(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param {
            continue;
        }
        let d = tr.decided.get(p + 1);
        if d == D_REF || d == D_MUT {
            return true;
        }
        let tn = pcx.nodes[p as usize].b;
        if tn <= 0 {
            continue;
        }
        let k = pcx.nodes[tn as usize].kind;
        let s = pcx.nodes[tn as usize].start;
        if k == NodeKind::TySlice || k == NodeKind::TyName && word_here(s, b"str")
            || k == NodeKind::TyPtr && get_src()[s as usize] != b'*' || k == NodeKind::TyFn
            || crate::tools::translate::regions::names_view_item(tn, tr, pcx) {
            return true;
        }
    }
    false
}

// The parameters of function node n the rust edition takes by a shared
// or exclusive reference to more than a primitive (an `&mut i64` out
// parameter is none a result could borrow from), and whether it has a
// `self` receiver (elision's own case).
fn borrowing_params(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> (i64, bool) {
    let mut count: i64 = 0;
    let mut receiver = false;
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param {
            continue;
        }
        let tn = pcx.nodes[p as usize].b;
        if pcx.nodes[p as usize].a == tr.sym_self {
            receiver = receiver || tr.decided.get(p + 1) != D_VALUE;
            continue;
        }
        let d = tr.decided.get(p + 1);
        // (`inout i64`: its referent's name)
        let named = if tn > 0 && pcx.nodes[tn as usize].kind == NodeKind::TyPtr
            && get_src()[pcx.nodes[tn as usize].start as usize] != b'*' {
            pcx.nodes[tn as usize].a
        } else {
            tn
        };
        if (d == D_REF || d == D_MUT) && (named <= 0 || !primitive_name(named, pcx)) {
            count += 1;
        } else if tn > 0 && d != D_REF && d != D_MUT {
            let k = pcx.nodes[tn as usize].kind;
            let s = pcx.nodes[tn as usize].start;
            if k == NodeKind::TySlice || k == NodeKind::TyName && word_here(s, b"str")
                || k == NodeKind::TyPtr && get_src()[s as usize] != b'*'
                || crate::tools::translate::regions::names_view_item(tn, tr, pcx)
                || crate::tools::translate::rows::type_row_region(tn, tr, pcx) {
                count += 1;
            }
        }
    }
    (count, receiver)
}

// Type node t and the types inside it marked region v in Tr.static_res
// (1: `'static`, 2: the function's `'a`).
fn mark_region(t: i64, v: i64, depth: i64, tr: &mut Tr, pcx: &Ctx<Comp>) {
    if t <= 0 || depth > 8 {
        return;
    }
    tr.static_res.put(t + 1, v);
    let k = pcx.nodes[t as usize].kind;
    if k == NodeKind::TyName {
        let g = pcx.nodes[t as usize].g;
        for i in 0..if g > 0 { pcx.nodes[g as usize].count } else { 0 } {
            mark_region(child(g, i, pcx), v, depth + 1, tr, pcx);
        }
    } else if k == NodeKind::TySlice || k == NodeKind::TyPtr || k == NodeKind::TyArray {
        mark_region(pcx.nodes[t as usize].a, v, depth + 1, tr, pcx);
    } else {
        for i in 0..pcx.nodes[t as usize].count {
            mark_region(child(t, i, pcx), v, depth + 1, tr, pcx);
        }
    }
}

// Whether type node t has a view in it (a slice, `str`, an item that holds
// one).
fn has_view(t: i64, depth: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[t as usize].kind;
    let s = pcx.nodes[t as usize].start;
    if k == NodeKind::TySlice && get_src()[s as usize] == b'['
        || k == NodeKind::TyName && word_here(s, b"str")
        && get_src()[(pcx.nodes[t as usize].end - 1) as usize] == b'r'
        || k == NodeKind::TyName && crate::tools::translate::regions::names_view_item(t, tr, pcx)
        || crate::tools::translate::rows::type_row_region(t, tr, pcx) {
        return true;
    }
    if k == NodeKind::TyName {
        let g = pcx.nodes[t as usize].g;
        for i in 0..if g > 0 { pcx.nodes[g as usize].count } else { 0 } {
            if has_view(child(g, i, pcx), depth + 1, tr, pcx) {
                return true;
            }
        }
        return false;
    }
    if k == NodeKind::TyArray || k == NodeKind::TyPtr && get_src()[s as usize] == b'*' {
        return has_view(pcx.nodes[t as usize].a, depth + 1, tr, pcx);
    }
    false
}

// (0.27.5) Whether function node n is one whose result view is `'static`
// in the rust edition: a list, not a pattern (a view built from a raw
// pointer may be of a buffer that grows), each row with the evidence that
// the storage it views is never freed or moved. A function not listed
// keeps elision, but for static_returns's (0.27.6: one whose every
// result is a listed one's, a literal, or a range of one or of SRC). Rows: a suffix of the file's path, the name.
fn static_result(n: i64, pcx: &Ctx<Comp>) -> bool {
    let name = crate::base::sym_text(pcx.nodes[n as usize].a, pcx);
    let mut file: &[u8] = b"";
    let at = pcx.nodes[n as usize].start;
    for f in 0..pcx.files.len() as i64 {
        if pcx.files[f as usize].start <= at && at < pcx.files[f as usize].end {
            file = crate::base::cstr(pcx.files[f as usize].path);
        }
    }
    // a Sym's text: intern's own copy (alloc_zeroed, malloc) or the tools'
    // cache's read buffer (restore_sym), neither freed nor written again
    // (base has no buf_free); Ctx.syms is only pushed to
    ends_with_text(file, b"base/mod.vl") && name == b"sym_text"
        // (0.28.0) a copy into a src_reserve mapping of its own, never
        // unmapped (no munmap in the compiler) nor written again, held by
        // nothing else: read_pieces' SRC while it lexes
        || ends_with_text(file, b"base/mod.vl") && name == b"src_copy"
        // TARGET as given: argv, the process's own
        || ends_with_text(file, b"tools/patch/mod.vl") && name == b"target"
        // a fresh buf_new() buffer, written once here, never again or freed
        || ends_with_text(file, b"tools/testrun/mod.vl") && name == b"build_key"
        // RULE: src-buffer.md "Views of other storage" (0.27.7) a frozen
        // buffer's slice: buf_freeze makes every write to it stop the
        // compiler, and BUFS buffers are never freed nor their ids reused
        || ends_with_text(file, b"base/mod.vl") && name == b"buf_done"
        // the intrinsics table, BUFS[pcx.table_buf]: load_table fills it
        // once and freezes it before any reader runs
        || ends_with_text(file, b"arch/table.vl") && name == b"text"
        || ends_with_text(file, b"arch/mod.vl") && name == b"intr_text"
        // tcx.rd, the tools' cache's read buffer: restore freezes it before
        // read_words (rd's only writer) points rd at it; a second restore
        // reads into a fresh buffer
        || ends_with_text(file, b"tools/query/cache.vl") && name == b"get_str"
        // (0.28.0) a copy of text in a region of its own (src_reserve),
        // never unmapped nor written again: SRC while fmt lexes it
        // (src-buffer.md), given to set_src, whose view is static
        || ends_with_text(file, b"base/mod.vl") && name == b"src_copy"
}

// (0.27.6) Whether the program is one whose base/mod.vl holds SRC, the
// compiler's (static_src's evidence is that region's, not any static's of
// the name).
fn base_src(pcx: &Ctx<Comp>) -> bool {
    for f in 0..pcx.files.len() as i64 {
        if ends_with_text(crate::base::cstr(pcx.files[f as usize].path), b"base/mod.vl") {
            return true;
        }
    }
    false
}

// (0.27.6) Whether every value function node n returns is a static
// value (static_value): its body's tail and each `return`'s. A forwarder,
// `fn sym_text(sym: i64, pcx: Ctx<Comp>) -> [u8] {
// crate::base::sym_text(sym, pcx) }`, is one; so is a function whose
// results are parts of SRC, base's region (docs/design/src-buffer.md),
// never moved, unmapped or written again where SRC has been given it.
fn static_returns(n: i64, depth: i64, budget: &mut i64, pcx: &Ctx<Comp>) -> bool {
    let body: i64 = if n > 0 { pcx.nodes[n as usize].c } else { 0 };
    if depth > 8 || body <= 0 || pcx.nodes[body as usize].kind != NodeKind::Block
        || pcx.nodes[body as usize].a <= 0
        || !static_value(pcx.nodes[body as usize].a, body, depth, budget, pcx) {
        return false;
    }
    returns_static(body, body, depth, budget, pcx)
}

// Whether every `return` in node e (not a closure's) gives a static_value.
fn returns_static(e: i64, body: i64, depth: i64, budget: &mut i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return true;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Return
        && !(pcx.nodes[e as usize].a > 0
            && static_value(pcx.nodes[e as usize].a, body, depth, budget, pcx)) {
        return false;
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for i in 0..kids.count {
        if !returns_static(kids.get(i), body, depth, budget, pcx) {
            return false;
        }
    }
    true
}

// Whether expression e (in function body `body`) is a value valid for
// the rest of the process: a text literal; a call of a function whose
// result is `'static` (static_result, static_returns); a local each of
// whose `let`s is one; a range of one, or of SRC (static_storage); an
// `if` or a block of them.
fn static_value(e0: i64, body: i64, depth: i64, budget: &mut i64, pcx: &Ctx<Comp>) -> bool {
    let mut e = e0;
    // (the checker's own borrow, not written)
    while e > 0 && pcx.nodes[e as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[e as usize].start as usize] != b'&'
        && get_src()[pcx.nodes[e as usize].start as usize] != b'*' {
        e = pcx.nodes[e as usize].b;
    }
    *budget -= 1;
    if e <= 0 || *budget < 0 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Str {
        return true;
    }
    if k == NodeKind::Block {
        return pcx.nodes[e as usize].a > 0
            && static_value(pcx.nodes[e as usize].a, body, depth, budget, pcx);
    }
    if k == NodeKind::If {
        return pcx.nodes[e as usize].c > 0
            && static_value(pcx.nodes[e as usize].b, body, depth, budget, pcx)
            && static_value(pcx.nodes[e as usize].c, body, depth, budget, pcx);
    }
    if k == NodeKind::Call {
        let f = pcx.nodes[e as usize].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return false;
        }
        let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
        let fnode = pcx.fns[g as usize].node;
        return fnode > 0
            && (static_result(fnode, pcx) || static_returns(fnode, depth + 1, budget, pcx)
                || forwarded_static(e, fnode, body, depth, budget, pcx));
    }
    if k == NodeKind::Ident {
        // (a local each of whose `let`s in the body is such a value)
        let mut found: i64 = 0;
        return lets_static(body, pcx.nodes[e as usize].a, body, depth, &mut found, budget, pcx)
            && found > 0;
    }
    if k != NodeKind::Index || pcx.nodes[e as usize].b <= 0
        || pcx.nodes[pcx.nodes[e as usize].b as usize].kind != NodeKind::Range {
        return false;
    }
    let base = pcx.nodes[e as usize].a;
    static_storage(base, pcx) || static_value(base, body, depth, budget, pcx)
}

// (0.27.7) Whether call c is of a function every result of which is a
// part of one view parameter, `base_name(n: [u8]) -> [u8] { .. n[0..k] }`
// (view_root), with a static value given there: its result is that
// value's part, static too.
fn forwarded_static(c: i64, fnode: i64, body: i64, depth: i64, budget: &mut i64,
    pcx: &Ctx<Comp>) -> bool {
    let fbody = pcx.nodes[fnode as usize].c;
    if depth > 8 || fbody <= 0 || pcx.nodes[fbody as usize].kind != NodeKind::Block
        || pcx.nodes[fbody as usize].a <= 0 {
        return false;
    }
    let p = view_root(pcx.nodes[fbody as usize].a, fnode, 0, pcx);
    if p <= 0 || !returns_root(fbody, fnode, p, pcx) {
        return false;
    }
    // (p's place among the parameters, the argument's among the call's)
    let mut j: i64 = -1;
    let mut at: i64 = 0;
    for i in 0..pcx.nodes[fnode as usize].count {
        let q = child(fnode, i, pcx);
        if q > 0 && pcx.nodes[q as usize].kind == NodeKind::Param {
            if q == p {
                j = at;
            }
            at += 1;
        }
    }
    j >= 0 && j < pcx.nodes[c as usize].count
        && static_value(child(c, j, pcx), body, depth + 1, budget, pcx)
}

// Whether every `return` in node e (not a closure's) of function node n
// gives a part of its parameter p.
fn returns_root(e: i64, n: i64, p: i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return true;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Return
        && !(pcx.nodes[e as usize].a > 0 && view_root(pcx.nodes[e as usize].a, n, 0, pcx) == p) {
        return false;
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for i in 0..kids.count {
        if !returns_root(kids.get(i), n, p, pcx) {
            return false;
        }
    }
    true
}

// Whether part i of tuple value e is a static_value: of a tuple literal,
// an `if` or a block of them (`let (text, m) = if .. { ("len()", ..) }`).
fn static_part(e: i64, i: i64, body: i64, depth: i64, budget: &mut i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Tuple {
        return i < pcx.nodes[e as usize].count
            && static_value(child(e, i, pcx), body, depth, budget, pcx);
    }
    if k == NodeKind::Block {
        return pcx.nodes[e as usize].a > 0
            && static_part(pcx.nodes[e as usize].a, i, body, depth + 1, budget, pcx);
    }
    if k == NodeKind::If {
        return pcx.nodes[e as usize].c > 0
            && static_part(pcx.nodes[e as usize].b, i, body, depth + 1, budget, pcx)
            && static_part(pcx.nodes[e as usize].c, i, body, depth + 1, budget, pcx);
    }
    false
}

// Whether node e names storage a range of which is static: SRC, base's
// region (static_returns), in the program whose base that is.
fn static_storage(e0: i64, pcx: &Ctx<Comp>) -> bool {
    let mut e = e0;
    while e > 0 && pcx.nodes[e as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[e as usize].start as usize] != b'&'
        && get_src()[pcx.nodes[e as usize].start as usize] != b'*' {
        e = pcx.nodes[e as usize].b;
    }
    if e <= 0 {
        return false;
    }
    let text = &get_src()[pcx.nodes[e as usize].start as usize..pcx.nodes[e as usize].end as usize];
    (text == b"SRC" || text == b"crate::base::SRC" || text == b"base::SRC") && base_src(pcx)
}

// Whether each `let` of name in node e (not a closure's) is immutable and
// bound to a static_value; found counts them.
fn lets_static(e: i64, name: i64, body: i64, depth: i64, found: &mut i64, budget: &mut i64,
    pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return true;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Let {
        let pat = pcx.nodes[e as usize].a;
        if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind
            && pcx.nodes[pat as usize].a == name {
            if !word_here(pcx.nodes[e as usize].start, b"let") || pcx.nodes[e as usize].c <= 0
                || !static_value(pcx.nodes[e as usize].c, body, depth, budget, pcx) {
                return false;
            }
            *found += 1;
        }
        // (a part of a tuple pattern, `let (text, method) = if .. { ("len()", m) }`)
        if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatTuple {
            for i in 0..pcx.nodes[pat as usize].count {
                let q = child(pat, i, pcx);
                if q > 0 && pcx.nodes[q as usize].kind == NodeKind::PatBind
                    && pcx.nodes[q as usize].a == name {
                    if !word_here(pcx.nodes[e as usize].start, b"let")
                        || pcx.nodes[e as usize].c <= 0
                        || !static_part(pcx.nodes[e as usize].c, i, body, depth, budget, pcx) {
                        return false;
                    }
                    *found += 1;
                }
            }
        }
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for i in 0..kids.count {
        if !lets_static(kids.get(i), name, body, depth, found, budget, pcx) {
            return false;
        }
    }
    true
}

// Whether s ends with t.
fn ends_with_text(s: &[u8], t: &[u8]) -> bool {
    s.len() >= t.len() && s[s.len() - t.len()..s.len()] == t
}

// (0.27.5) Whether function node n takes an item with views by a shared
// reference, `line: &Line<'_>`: two lifetimes, which elision does not
// choose between.
fn ref_view_item(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param && pcx.nodes[p as usize].a != tr.sym_self
            && tr.decided.get(p + 1) == D_REF && pcx.nodes[p as usize].b > 0
            && pcx.nodes[pcx.nodes[p as usize].b as usize].kind == NodeKind::TyName
            && (crate::tools::translate::regions::names_view_item(pcx.nodes[p as usize].b, tr, pcx)
                || crate::tools::translate::rows::type_row_region(pcx.nodes[p as usize].b, tr, pcx)) {
            return true;
        }
    }
    false
}

// (a result with a view that elision cannot tie: two or more parameters
// it could borrow from, or one item with views by reference, and no
// `self`) The function's `'a`: on the result's
// views and on each parameter taken by a shared reference, `fn f<'a>(t:
// &'a [u8], pcx: &'a Ctx) -> &'a [u8]`; an exclusive one keeps its own.
// (0.27.5) With MVS's view summary of function fi (inferred or declared,
// not assumed): an item with views taken by reference has it on the
// item's own region, `&Leaf<'a>`, not the reference's, and a reference to
// a struct without views the result does not view keeps elision, so a
// temporary given to one (`&leaf_of(..)`) need not live as long as the
// result. A view, an item or a container of views by value (`Vec<Ev<'_>>`)
// has it always: the summary may miss a view a moved value carries.
// (0.27.6) fn_region false: the `'a` an impl names (impl_region), the
// result marked with it even when no parameter is.
fn name_region(n: i64, fi: i64, r: i64, fn_region: bool, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut known = false;
    let mut own_mask: i64 = 0;
    let mut through_mask: i64 = 0;
    if fi >= 0 {
        let s = summary_of(fi, pcx);
        // (a summary with no parameter in it, a view made from a raw
        // pointer, says nothing: every parameter, as before)
        known = !s.top && (s.ret[0] | s.ret[1] | s.ret[2] | s.ret[3]) != 0;
        own_mask = s.ret[S_L1_P as usize] | s.ret[S_L2_P as usize];
        through_mask = s.ret[S_L1_STAR as usize] | s.ret[S_L2_STAR as usize];
    }
    let mut named: i64 = 0;
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param || pcx.nodes[p as usize].a == tr.sym_self {
            continue;
        }
        let tn = pcx.nodes[p as usize].b;
        if tn <= 0 || tr.decided.get(p + 1) == D_MUT {
            continue;
        }
        let bit: i64 = if j >= 63 { -1 } else { 1 << j };
        let ts = pcx.nodes[tn as usize].start;
        let at = if word_here(ts, b"let") { skip_ws(ts + 3) } else { ts };
        let k = pcx.nodes[tn as usize].kind;
        let item = k == NodeKind::TyName
            && (crate::tools::translate::regions::names_view_item(tn, *tr, pcx)
                || crate::tools::translate::rows::type_row_region(tn, *tr, pcx));
        if tr.decided.get(p + 1) == D_REF && !primitive_name(tn, pcx) {
            if known && item {
                // (a view item's views are its region's, `leaf.last` of a
                // `&Leaf<'a>`, whatever the reference's)
                mark_region(tn, 2, 0, tr, pcx);
                named += 1;
                continue;
            }
            // (a reference to a struct without views the result does not
            // view: elided; MVS's summary misses no view a reference's
            // referent owns, but may one that a moved value carries, so
            // views and items by value keep the region)
            if known && (own_mask & bit) == 0 && (through_mask & bit) == 0 {
                continue;
            }
            // (after the `&` edit_param put at the same place; no rule's
            // key: view_put's is TC_VIEW's at this place)
            put(at, at, b"'a ", -1, tr, pcx);
            named += 1;
        } else if k == NodeKind::TySlice && get_src()[at as usize] == b'[' {
            put(at, at, b"'a ", -1, tr, pcx);
            named += 1;
        } else if k == NodeKind::TyName && word_here(ts, b"str") || item {
            tr.static_res.put(tn + 1, 2);
            named += 1;
        } else if k == NodeKind::TyName && has_view(tn, 0, *tr, pcx) {
            // (a container of views by value, `errs: Vec<Ev<'_>, Gpa>`)
            mark_region(tn, 2, 0, tr, pcx);
            named += 1;
        }
    }
    if named == 0 && fn_region {
        return;
    }
    mark_region(r, 2, 0, tr, pcx);
    // (the impl's `'a`, impl_region: named there)
    if fn_region {
        put_fn_region(n, tr, pcx);
    }
}

// (0.27.6, flip28's T2) A pointer to views a function takes as an out
// parameter, `message: *[u8]`, and sets to a part of a view it takes,
// `*message = line[m..n]`: the two are tied, `fn f<'a>(line: &'a [u8],
// .., message: *mut &'a [u8])`; elided, the pointer's views would be of
// a region of their own, which the part of `line` does not outlive.
fn out_view_tie(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let body = pcx.nodes[n as usize].c;
    if body <= 0 {
        return;
    }
    let mut tied = false;
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if p <= 0 || pcx.nodes[p as usize].kind != NodeKind::Param {
            continue;
        }
        let tn = pcx.nodes[p as usize].b;
        if tn <= 0 || pcx.nodes[tn as usize].kind != NodeKind::TyPtr
            || get_src()[pcx.nodes[tn as usize].start as usize] != b'*' {
            continue;
        }
        let a = pcx.nodes[tn as usize].a;
        if a <= 0 || pcx.nodes[a as usize].kind != NodeKind::TySlice
            || get_src()[pcx.nodes[a as usize].start as usize] != b'[' {
            continue;
        }
        let v = view_set_from(body, pcx.nodes[p as usize].a, n, pcx);
        if v > 0 {
            tr.static_res.put(a + 1, 2);
            tr.static_res.put(pcx.nodes[v as usize].b + 1, 2);
            tied = true;
        }
    }
    if tied {
        put_fn_region(n, tr, pcx);
    }
}

// The view parameter of function node n (a Param) a part of which node e
// (not a closure's) assigns to `*out`, or 0.
fn view_set_from(e: i64, out: i64, n: i64, pcx: &Ctx<Comp>) -> i64 {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return 0;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Assign {
        let t = pcx.nodes[e as usize].b;
        if t > 0 && pcx.nodes[t as usize].kind == NodeKind::Unary
            && pcx.nodes[t as usize].op == Tok::Star && pcx.nodes[t as usize].b > 0
            && pcx.nodes[pcx.nodes[t as usize].b as usize].kind == NodeKind::Ident
            && pcx.nodes[pcx.nodes[t as usize].b as usize].a == out {
            let p = view_root(pcx.nodes[e as usize].c, n, 0, pcx);
            if p > 0 {
                return p;
            }
        }
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for i in 0..kids.count {
        let p = view_set_from(kids.get(i), out, n, pcx);
        if p > 0 {
            return p;
        }
    }
    0
}

// The view parameter of function node n (a Param) value e is a part of,
// or 0: a range of one, an `if` or a block of such parts, a local each of
// whose `let`s and assignments in n's body is one of the same.
fn view_root(e0: i64, n: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e = e0;
    while e > 0 && (pcx.nodes[e as usize].kind == NodeKind::Index && pcx.nodes[e as usize].b > 0
        && pcx.nodes[pcx.nodes[e as usize].b as usize].kind == NodeKind::Range
        || pcx.nodes[e as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[e as usize].start as usize] != b'&'
        && get_src()[pcx.nodes[e as usize].start as usize] != b'*') {
        e = if pcx.nodes[e as usize].kind == NodeKind::Index { pcx.nodes[e as usize].a }
            else { pcx.nodes[e as usize].b };
    }
    if e <= 0 || depth > 6 {
        return 0;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Block {
        return view_root(pcx.nodes[e as usize].a, n, depth + 1, pcx);
    }
    if k == NodeKind::If {
        let a = view_root(pcx.nodes[e as usize].b, n, depth + 1, pcx);
        return if a > 0 && pcx.nodes[e as usize].c > 0
            && view_root(pcx.nodes[e as usize].c, n, depth + 1, pcx) == a {
            a
        } else {
            0
        };
    }
    if k != NodeKind::Ident {
        return 0;
    }
    let name = pcx.nodes[e as usize].a;
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        let tn: i64 = if p > 0
            && pcx.nodes[p as usize].kind == NodeKind::Param { pcx.nodes[p as usize].b } else { 0 };
        if tn > 0 && pcx.nodes[p as usize].a == name {
            return if pcx.nodes[tn as usize].kind == NodeKind::TySlice
                && get_src()[pcx.nodes[tn as usize].start as usize] == b'[' {
                p
            } else {
                0
            };
        }
    }
    // (a local: every value given to it, the same parameter's part)
    let mut values = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    local_values(pcx.nodes[n as usize].c, name, &mut values, pcx);
    let mut root: i64 = 0;
    for i in 0..values.count {
        let v = values.get(i);
        // (a part of itself, `text = text[0..q]`, keeps its root)
        let mut w = v;
        while w > 0 && pcx.nodes[w as usize].kind == NodeKind::Index && pcx.nodes[w as usize].b > 0
            && pcx.nodes[pcx.nodes[w as usize].b as usize].kind == NodeKind::Range {
            w = pcx.nodes[w as usize].a;
        }
        if w > 0 && pcx.nodes[w as usize].kind == NodeKind::Ident
            && pcx.nodes[w as usize].a == name {
            continue;
        }
        let r = view_root(v, n, depth + 1, pcx);
        if r <= 0 || root > 0 && r != root {
            return 0;
        }
        root = r;
    }
    root
}

// The values node e (not a closure's) gives the local name: its `let`s'
// and assignments'.
fn local_values(e: i64, name: i64, out: &mut IntVec, pcx: &Ctx<Comp>) {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Let {
        let pat = pcx.nodes[e as usize].a;
        if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind
            && pcx.nodes[pat as usize].a == name {
            out.push(pcx.nodes[e as usize].c);
        }
    } else if k == NodeKind::Assign {
        let t = pcx.nodes[e as usize].b;
        if t > 0 && pcx.nodes[t as usize].kind == NodeKind::Ident
            && pcx.nodes[t as usize].a == name {
            out.push(pcx.nodes[e as usize].c);
        }
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for i in 0..kids.count {
        local_values(kids.get(i), name, out, pcx);
    }
}

// Function node n's own `<'a>`, after its name (or first in its
// parameters, `<'a, T>`).
fn put_fn_region(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let g = pcx.nodes[n as usize].g;
    if g > 0 && get_src()[pcx.nodes[g as usize].start as usize] == b'<' {
        put(pcx.nodes[g as usize].start + 1, pcx.nodes[g as usize].start + 1, b"'a, ", TC_VIEW, tr,
            pcx);
        return;
    }
    let mut q = pcx.nodes[n as usize].start;
    while q < pcx.nodes[n as usize].end && !word_here(q, b"fn") {
        q += 1;
    }
    q = skip_ws(q + 2);
    while q < pcx.nodes[n as usize].end && ident_char(get_src()[q as usize]) {
        q += 1;
    }
    put(q, q, b"<'a>", TC_VIEW, tr, pcx);
}

// (0.27.6, flip28's T5) Whether method n is in an inherent impl of a
// struct with views, `impl Line`: the impl names the struct's region,
// `impl<'a> Line<'a>`, and a method's result that has views and no
// reference to borrow from, `fn word(self, k) -> &'a str`, `fn new(..,
// word: &'a str) -> Leaf<'a, A>`, names it too (name_region), as Rust's
// elision would not (a receiver by value, a view by value it stores).
fn impl_region(n: i64, tname: &[u8], tr: &mut Tr, pcx: &mut Ctx<Comp>) -> bool {
    let h = pcx.nodes[n as usize].h;
    if tname.len() != 0 || h <= 0 || pcx.nodes[h as usize].kind != NodeKind::TyName
        || !editable(pcx.nodes[h as usize].start, pcx)
        || !crate::tools::translate::regions::names_view_item(h, *tr, pcx) {
        return false;
    }
    // (the impl's `impl`, before its parameters and the type)
    let mut q = pcx.nodes[h as usize].start - 4;
    let low: i64 = if q > 200 { q - 200 } else { 0 };
    while q >= low
        && !(word_here(q, b"impl") && (q == 0 || !ident_char(get_src()[(q - 1) as usize]))) {
        q -= 1;
    }
    if q < low {
        return false;
    }
    tr.static_res.put(h + 1, 2);
    if get_src()[(q + 4) as usize] == b'<' {
        put(q + 5, q + 5, b"'a, ", TC_VIEW, tr, pcx);
    } else {
        put(q + 4, q + 4, b"<'a>", TC_VIEW, tr, pcx);
    }
    true
}

// Function node n's parameters and result.
fn edit_signature(n: i64, impls: HMap, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[n as usize].x - 1;
    let mut fi: i64 = if f >= 0 && f < pcx.fns.len() as i64 && pcx.fns[f as usize].node == n
        && pcx.fns[f as usize].generic == 0 { f } else { -1 };
    if fi < 0 {
        // (a generic function's template: an instance's checked signature,
        // its clone at the same place; a type parameter's is decided apart)
        for g in 0..pcx.fns.len() as i64 {
            let gn = pcx.fns[g as usize].node;
            if fi < 0 && gn > 0 && gn != n && pcx.nodes[gn as usize].kind == NodeKind::Fn
                && pcx.nodes[gn as usize].start == pcx.nodes[n as usize].start
                && pcx.nodes[gn as usize].end == pcx.nodes[n as usize].end {
                fi = g;
            }
        }
    }
    let by_value = by_value_trait(impl_trait(n, impls, pcx));
    let tname = impl_trait(n, impls, pcx);
    tr.force_ref = tname == b"Eq" || tname == b"Ord" || tname == b"PartialEq"
        || tname == b"PartialOrd";
    let im = impls.get(n + 1);
    // (before the parameters: the regions their views take)
    let impl_a = impl_region(n, tname, tr, pcx);
    if !impl_a {
        out_view_tie(n, tr, pcx);
    }
    let gen: i64 = if im > 0 { pcx.nodes[im as usize].g } else { 0 };
    let mut i: i64 = 0;
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param {
            continue;
        }
        // (an inherent method's `self` of a type MVS copies and passes by
        // value, `Op`: `self`, as Rust takes a Copy receiver; `&self` would
        // make `self == Call` and `self as i64` a reference's)
        let mut st: i64 = if fi >= 0
            && i < pcx.fns[fi as usize].param_count { fn_param(fi, i, pcx) } else { 0 };
        if st > 0 && is_ref(st, pcx) {
            st = pcx.types[st as usize].a;
        }
        let copy_self = pcx.nodes[p as usize].a == tr.sym_self && tname.len() == 0 && st > 0
            && (pcx.types[st as usize].kind == crate::front::types::TyKind::Enum
                || pcx.types[st as usize].kind == crate::front::types::TyKind::Struct)
            && crate::front::conv::copyable(st, pcx);
        edit_param(n, fi, i, p, by_value || copy_self, gen, tr, pcx);
        i += 1;
    }
    // (a result that is a view: `-> &[T]`; `&'static [T]` when no
    // parameter is a reference, which Rust's elision would name)
    let r = pcx.nodes[n as usize].b;
    let (borrowed, receiver) = borrowing_params(n, *tr, pcx);
    // (static_returns's work: the nodes it may look at)
    let mut budget: i64 = 4096;
    if r > 0 && (static_result(n, pcx) || static_returns(n, 0, &mut budget, pcx)) {
        mark_region(r, 1, 0, tr, pcx);
    } else if r > 0 && impl_a && !receiver && has_view(r, 0, *tr, pcx) {
        name_region(n, fi, r, false, tr, pcx);
    } else if r > 0 && borrowed == 0 && !receiver {
        // (every view in it: `[&'static str; 21]`, `Vec<Opt<'static>>`)
        mark_region(r, 1, 0, tr, pcx);
    } else if r > 0 && (borrowed >= 2 || borrowed == 1 && ref_view_item(n, *tr, pcx)) && !receiver
        && has_view(r, 0, *tr, pcx) {
        name_region(n, fi, r, true, tr, pcx);
    }
    if r > 0 && pcx.nodes[r as usize].kind == NodeKind::TySlice
        && get_src()[pcx.nodes[r as usize].start as usize] == b'[' {
        view_put(r, pcx.nodes[r as usize].start, tr, pcx);
        tr.typed.put(r + 1, 1);
    }
}

// A closure's parameters: as a function's, without a checked signature
// (their types come from where the closure goes).
fn edit_closure(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for j in 0..pcx.nodes[n as usize].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param || pcx.nodes[p as usize].b <= 0 {
            continue;
        }
        edit_param(n, -1, j, p, false, 0, tr, pcx);
    }
}

// Every other view type `[T]` (a let's, a type argument's) is `&[T]`, an
// `inout [T]` `&mut [T]`. (A struct's field: its region, sig's regions.)
fn edit_types(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut fields = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut params = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Field && pcx.nodes[n as usize].b > 0 {
            fields.put(pcx.nodes[n as usize].b + 1, 1);
        }
        if pcx.nodes[n as usize].kind == NodeKind::Param && pcx.nodes[n as usize].b > 0 {
            params.put(pcx.nodes[n as usize].b + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        // (MVS's raw pointer `*T` is `*mut T`: C's `const` is not in its
        // types, and a `c"..."` literal is accepted as either)
        if k == NodeKind::TyPtr && get_src()[pcx.nodes[n as usize].start as usize] == b'*'
            && editable(pcx.nodes[n as usize].start, pcx) {
            let s = pcx.nodes[n as usize].start;
            put(s, s + 1, b"*mut ", TC_TYPE, tr, pcx);
            // (a pointer to views, `*[u8]` (STRS, an out parameter): its
            // elements are views, `*mut &[u8]`; `&'static` but in a
            // parameter's own type)
            let a = pcx.nodes[n as usize].a;
            if a > 0 && pcx.nodes[a as usize].kind == NodeKind::TySlice
                && get_src()[pcx.nodes[a as usize].start as usize] == b'[' {
                put(pcx.nodes[a as usize].start, pcx.nodes[a as usize].start,
                    if params.get(n + 1) != 0 { region_amp(tr.static_res.get(a + 1)) }
                    else { b"&'static " },
                    TC_VIEW, tr, pcx);
            }
            continue;
        }
        if k != NodeKind::TySlice && k != NodeKind::TyPtr || tr.typed.get(n + 1) != 0
            || fields.get(n + 1) != 0 || !editable(pcx.nodes[n as usize].start, pcx) {
            continue;
        }
        let s = pcx.nodes[n as usize].start;
        if word_here(s, b"inout") {
            put(s, skip_ws(s + 5), b"&mut ", TC_TYPE, tr, pcx);
        } else if word_here(s, b"let") {
            put(s, skip_ws(s + 3), b"&", TC_TYPE, tr, pcx);
        }
        else if k == NodeKind::TySlice && get_src()[s as usize] == b'['
            && (s == 0 || get_src()[(s - 1) as usize] != b'*') {
            view_put(n, s, tr, pcx);
        }
    }
    // (`str`, a view of text, is `&str`; a function type's let parameter
    // of a type it does not copy `&T`)
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        let s = pcx.nodes[n as usize].start;
        if k == NodeKind::TyName && fields.get(n + 1) == 0 && tr.typed.get(n + 1) == 0
            && editable(s, pcx)
            && word_here(s, b"str") && get_src()[(pcx.nodes[n as usize].end - 1) as usize] == b'r'
            && !after_amp(s) {
            put(s, s, region_amp(tr.static_res.get(n + 1)), TC_VIEW, tr, pcx);
        } else if k == NodeKind::TyFn && editable(s, pcx) {
            for i in 0..pcx.nodes[n as usize].count {
                let tn = child(n, i, pcx);
                let tk = pcx.nodes[tn as usize].kind;
                let ts = pcx.nodes[tn as usize].start;
                if tk == NodeKind::TyName && !primitive_name(tn, pcx) && !word_here(ts, b"str")
                    && !after_amp(ts) && get_src()[ts as usize] >= b'A'
                    && get_src()[ts as usize] <= b'Z' {
                    put(ts, ts, b"&", TC_LET, tr, pcx);
                }
            }
        }
    }
}

// Whether the type at s follows a `&` or a `*` (a reference or a raw
// pointer's pointee already).
fn after_amp(s: i64) -> bool {
    let mut q = s - 1;
    while q > 0 && (get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t') {
        q -= 1;
    }
    get_src()[q as usize] == b'&' || get_src()[q as usize] == b'*' || word_here_back(q, b"mut")
}

fn word_here_back(q: i64, w: &[u8]) -> bool {
    let n = w.len() as i64;
    q - n + 1 >= 0 && get_src()[(q - n + 1) as usize..(q + 1) as usize] == w
}

// ---- Impls ----

// (0.27.4) An impl of MVS's Allocator is std2's: `try_alloc(size, align)
// -> *u8` (null: none) is `allocate(&self, layout) -> Result<NonNull<u8>,
// AllocError>`, `try_resize(p, old_size, new_size, align)` is `grow` (and
// `shrink`, which calls it: realloc does both), `free(p, size, align)` is
// `deallocate(&self, p, layout)`. Each body is kept: its parameters are
// bound from the layouts first, and a pointer it gives is the Result.
fn allocator_impl_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Impl
            || !editable(pcx.nodes[n as usize].start, pcx) || pcx.nodes[n as usize].a <= 0
            || pcx.nodes[n as usize].b <= 0
            || crate::base::sym_text(pcx.nodes[pcx.nodes[n as usize].a as usize].a, pcx)
            != b"Allocator" {
            continue;
        }
        for i in 0..pcx.nodes[n as usize].count {
            let f = child(n, i, pcx);
            if pcx.nodes[f as usize].kind != NodeKind::Fn || pcx.nodes[f as usize].c <= 0 {
                continue;
            }
            let m = crate::base::sym_text(pcx.nodes[f as usize].a, pcx);
            let mut ps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for j in 0..pcx.nodes[f as usize].count {
                let p = child(f, j, pcx);
                if pcx.nodes[p as usize].kind == NodeKind::Param {
                    ps.push(pcx.nodes[p as usize].a);
                }
            }
            let want: i64 = if m == b"try_alloc" { 3 } else if m == b"try_resize" { 5 }
                else if m == b"free" { 4 } else { 0 };
            if want == 0 || ps.count != want {
                continue;
            }
            let body = pcx.nodes[f as usize].c;
            let mut q = pcx.nodes[f as usize].start;
            while q < pcx.nodes[body as usize].start && !word_here(q, b"fn") {
                q += 1;
            }
            // `unsafe` written before `fn` stays: the signature then has none.
            let mut unsafe_written = false;
            for x in pcx.nodes[f as usize].start..q {
                if word_here(x, b"unsafe") {
                    unsafe_written = true;
                }
            }
            let bs = pcx.nodes[body as usize].start;
            let be = pcx.nodes[body as usize].end - 1;
            if q >= bs || get_src()[bs as usize] != b'{' || get_src()[be as usize] != b'}' {
                continue;
            }
            let sig = crate::base::buf_new();
            let open = crate::base::buf_new();
            let close = crate::base::buf_new();
            if m == b"try_alloc" {
                crate::base::buf_bytes(sig,
                    b"fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> ");
                bind(open, crate::base::sym_text(ps.get(1), pcx), b"__layout.size() as i64");
                bind(open, crate::base::sym_text(ps.get(2), pcx), b"__layout.align() as i64");
            } else if m == b"try_resize" {
                if !unsafe_written {
                    crate::base::buf_bytes(sig, b"unsafe ");
                }
                crate::base::buf_bytes(sig, b"fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>, AllocError> ");
                bind(open, crate::base::sym_text(ps.get(1), pcx), b"__p.as_ptr()");
                bind(open, crate::base::sym_text(ps.get(2), pcx), b"__old.size() as i64");
                bind(open, crate::base::sym_text(ps.get(3), pcx), b"__new.size() as i64");
                bind(open, crate::base::sym_text(ps.get(4), pcx), b"__new.align() as i64");
            } else {
                if !unsafe_written {
                    crate::base::buf_bytes(sig, b"unsafe ");
                }
                crate::base::buf_bytes(sig,
                    b"fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) ");
                bind(open, crate::base::sym_text(ps.get(1), pcx), b"__p.as_ptr()");
                bind(open, crate::base::sym_text(ps.get(2), pcx), b"__layout.size() as i64");
                bind(open, crate::base::sym_text(ps.get(3), pcx), b"__layout.align() as i64");
            }
            if m != b"free" {
                crate::base::buf_bytes(open, b"\n        NonNull::new({");
                crate::base::buf_bytes(close, b"}).ok_or(AllocError) ");
            }
            crate::tools::translate::rows::drop_inside(q, bs, pcx);
            if !crate::tools::edit::edit_replace(q, bs, sig, pcx) {
                continue;
            }
            tr.counts[TC_TYPE as usize] += 1;
            crate::tools::translate::rows::note_row_names(q, crate::base::buf_slice(sig), tr,
                pcx);
            crate::tools::edit::edit_replace(bs + 1, bs + 1, open, pcx);
            if m != b"free" {
                crate::tools::edit::edit_replace(be, be, close, pcx);
                // A `return E` in the body gives E as the Result too.
                for r in 1..pcx.nodes.len() as i64 {
                    let e = pcx.nodes[r as usize].a;
                    if pcx.nodes[r as usize].kind == NodeKind::Return && e > 0
                        && pcx.nodes[r as usize].start > bs && pcx.nodes[r as usize].end <= be {
                        let o = crate::base::buf_new();
                        crate::base::buf_bytes(o, b"NonNull::new(");
                        let c = crate::base::buf_new();
                        crate::base::buf_bytes(c, b").ok_or(AllocError)");
                        crate::tools::edit::edit_replace(pcx.nodes[e as usize].start,
                            pcx.nodes[e as usize].start, o, pcx);
                        crate::tools::edit::edit_replace(pcx.nodes[e as usize].end,
                            pcx.nodes[e as usize].end, c, pcx);
                    }
                }
            }
            if m == b"try_resize" {
                let sh = crate::base::buf_new();
                // (shrink is grow: realloc does both; its comments say so, for
                // the unsafe fn of the trait and for the call in it)
                crate::base::buf_bytes(sh, b"\n\n    // UNSAFE: shrink is an unsafe fn of the unsafe trait Allocator\n    // SAFETY: its caller keeps Allocator's contract for p, old and new\n    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>, AllocError> {\n        // UNSAFE: grow is an unsafe fn of Allocator\n        // SAFETY: the caller of shrink keeps the same contract, and\n        // realloc makes a block smaller as it makes one larger\n        unsafe { self.grow(p, old, new) }\n    }");
                crate::tools::edit::edit_replace(pcx.nodes[f as usize].end,
                    pcx.nodes[f as usize].end, sh, pcx);
            }
        }
    }
}

// A line `let NAME = VALUE;` into out.
fn bind(out: i64, name: &[u8], value: &[u8]) {
    crate::base::buf_bytes(out, b"\n        let ");
    crate::base::buf_bytes(out, name);
    crate::base::buf_bytes(out, b" = ");
    crate::base::buf_bytes(out, value);
    crate::base::buf_bytes(out, b";");
}

// (0.27.4) An impl of Iterator drops MVS's loop hints, `exact_len` (the
// items left) and `at(k)` (the k-th left, read without advancing): Rust's
// Iterator has neither (`nth` advances; ExactSizeIterator's `len` needs
// an exact size_hint), and a `for` reads `next` alone. With an
// `#[inline]` before one.
fn iterator_impl_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Impl
            || !editable(pcx.nodes[n as usize].start, pcx) || pcx.nodes[n as usize].a <= 0
            || pcx.nodes[n as usize].b <= 0
            || crate::base::sym_text(pcx.nodes[pcx.nodes[n as usize].a as usize].a, pcx)
            != b"Iterator" {
            continue;
        }
        for i in 0..pcx.nodes[n as usize].count {
            let f = child(n, i, pcx);
            if pcx.nodes[f as usize].kind != NodeKind::Fn {
                continue;
            }
            let m = crate::base::sym_text(pcx.nodes[f as usize].a, pcx);
            if m != b"exact_len" && m != b"at" {
                continue;
            }
            let mut s = pcx.nodes[f as usize].start;
            let mut q = s - 1;
            while q > 0 && is_ws(get_src()[q as usize]) {
                q -= 1;
            }
            if q >= 8 && get_src()[(q - 8) as usize..(q + 1) as usize] == b"#[inline]" {
                s = q - 8;
            }
            crate::tools::translate::rows::drop_inside(s, pcx.nodes[f as usize].end, pcx);
            let t = crate::base::buf_new();
            if crate::tools::edit::edit_replace(s, pcx.nodes[f as usize].end, t, pcx) {
                tr.counts[TC_TYPE as usize] += 1;
            }
        }
    }
}

// An impl of an operator trait gets its `type Output = Self;` (MVS's had
// none); an impl of MVS's Eq is Rust's PartialEq, and Eq's empty impl
// after it.
fn impl_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Impl
            || !editable(pcx.nodes[n as usize].start, pcx) || pcx.nodes[n as usize].a <= 0
            || pcx.nodes[n as usize].b <= 0
            || !word_here(pcx.nodes[n as usize].start, b"impl") {
            // (an impl the checker made of a derive: the derive's)
            continue;
        }
        let t = pcx.nodes[n as usize].a;
        let name = crate::base::sym_text(pcx.nodes[t as usize].a, pcx);
        let self_ty = &get_src()[
            pcx.nodes[pcx.nodes[n as usize].b as usize].start as usize..pcx.nodes[
                pcx.nodes[n as usize].b as usize].end as usize];
        if by_value_trait(name) && !has_output(n, pcx) {
            let mut q = pcx.nodes[pcx.nodes[n as usize].b as usize].end;
            while q < pcx.nodes[n as usize].end && get_src()[q as usize] != b'{' {
                q += 1;
            }
            if q < pcx.nodes[n as usize].end {
                let b = crate::base::buf_new();
                crate::base::buf_bytes(b, b" type Output = ");
                crate::base::buf_bytes(b, self_ty);
                crate::base::buf_bytes(b, b";");
                put(q + 1, q + 1, crate::base::buf_slice(b), TC_TYPE, tr, pcx);
            }
        } else if name == b"Display" || name == b"Debug" {
            fmt_impl(n, name == b"Debug", tr, pcx);
        } else if name == b"Ord" && word_here(pcx.nodes[t as usize].start, b"Ord") {
            ord_impl(n, t, self_ty, tr, pcx);
        } else if name == b"Eq" && word_here(pcx.nodes[t as usize].start, b"Eq") {
            put(pcx.nodes[t as usize].start, pcx.nodes[t as usize].start + 2, b"PartialEq", TC_TYPE,
                tr, pcx);
            let b = crate::base::buf_new();
            crate::base::buf_bytes(b, b" ");
            crate::base::buf_bytes(b,
                &get_src()[
                    pcx.nodes[n as usize].start as usize..pcx.nodes[t as usize].start as usize]);
            crate::base::buf_bytes(b, b"Eq for ");
            crate::base::buf_bytes(b, self_ty);
            crate::base::buf_bytes(b, b" {}");
            put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, crate::base::buf_slice(b), -1,
                tr, pcx);
        }
    }
    allocator_impl_edits(tr, pcx);
    iterator_impl_edits(tr, pcx);
}

// An impl of MVS's Ord, whose `cmp` gives an i64 (negative, zero,
// positive): Rust's, `-> Ordering`, the body's value compared with 0, and
// the PartialOrd it needs after it (with PartialEq and Eq from cmp when the
// type has no Eq of its own).
fn ord_impl(n: i64, t: i64, self_ty: &[u8], tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut f: i64 = 0;
    for j in 0..pcx.nodes[n as usize].count {
        let c = child(n, j, pcx);
        if pcx.nodes[c as usize].kind == NodeKind::Fn
            && word_here(skip_ws(pcx.nodes[c as usize].start + 2), b"cmp") {
            f = c;
        }
    }
    let r: i64 = if f > 0 { pcx.nodes[f as usize].b } else { 0 };
    let body: i64 = if f > 0 { pcx.nodes[f as usize].c } else { 0 };
    if r <= 0 || body <= 0 || !word_here(pcx.nodes[r as usize].start, b"i64") {
        return;
    }
    put(pcx.nodes[r as usize].start, pcx.nodes[r as usize].end, b"std::cmp::Ordering", TC_TYPE, tr,
        pcx);
    put(pcx.nodes[body as usize].start, pcx.nodes[body as usize].start, b"{ (", -1, tr, pcx);
    put(pcx.nodes[body as usize].end, pcx.nodes[body as usize].end, b").cmp(&0) }", -1, tr, pcx);
    let head = &get_src()[
        pcx.nodes[n as usize].start as usize..pcx.nodes[t as usize].start as usize];
    let b = crate::base::buf_new();
    crate::base::buf_bytes(b, b" ");
    crate::base::buf_bytes(b, head);
    crate::base::buf_bytes(b, b"PartialOrd for ");
    crate::base::buf_bytes(b, self_ty);
    crate::base::buf_bytes(b,
        b" { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(self.cmp(o)) } }");
    if !has_eq(n, self_ty, pcx) {
        crate::base::buf_bytes(b, b" ");
        crate::base::buf_bytes(b, head);
        crate::base::buf_bytes(b, b"PartialEq for ");
        crate::base::buf_bytes(b, self_ty);
        crate::base::buf_bytes(b,
            b" { fn eq(&self, o: &Self) -> bool { self.cmp(o) == std::cmp::Ordering::Equal } } ");
        crate::base::buf_bytes(b, head);
        crate::base::buf_bytes(b, b"Eq for ");
        crate::base::buf_bytes(b, self_ty);
        crate::base::buf_bytes(b, b" {}");
    }
    put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, crate::base::buf_slice(b), -1, tr,
        pcx);
}

// Whether the type impl n is of (written self_ty) has an Eq: an impl of
// Eq or PartialEq, or a derive's.
fn has_eq(n: i64, self_ty: &[u8], pcx: &Ctx<Comp>) -> bool {
    let tb = pcx.nodes[n as usize].b;
    let sym: i64 = if tb > 0 { pcx.nodes[tb as usize].a } else { 0 };
    for m in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[m as usize].kind;
        if k == NodeKind::Impl && m != n && pcx.nodes[m as usize].a > 0
            && pcx.nodes[m as usize].b > 0 {
            let tn = crate::base::sym_text(pcx.nodes[pcx.nodes[m as usize].a as usize].a, pcx);
            let st = &get_src()[
                pcx.nodes[pcx.nodes[m as usize].b as usize].start as usize..pcx.nodes[
                    pcx.nodes[m as usize].b as usize].end as usize];
            if (tn == b"Eq" || tn == b"PartialEq") && st == self_ty {
                return true;
            }
        }
        if (k == NodeKind::Struct || k == NodeKind::Enum) && pcx.nodes[m as usize].a == sym
            && pcx.nodes[m as usize].h > 0 {
            let h = pcx.nodes[m as usize].h;
            for j in 0..pcx.nodes[h as usize].count {
                if word_here(pcx.nodes[child(h, j, pcx) as usize].start, b"Eq") {
                    return true;
                }
            }
        }
    }
    false
}

// (0.27.5) Whether fn node f writes through a Fmt parameter and returns
// nothing: a Display or Debug impl's fmt, or MVS's helper of one, `fn
// put_name(f: inout Fmt, o: Opt)`, whose writes rewrite.tsv's rows `?`.
fn fmt_fn(f: i64, pcx: &Ctx<Comp>) -> bool {
    if f <= 0 || pcx.nodes[f as usize].kind != NodeKind::Fn || pcx.nodes[f as usize].b != 0
        || pcx.nodes[f as usize].c <= 0 {
        return false;
    }
    for i in 0..pcx.nodes[f as usize].count {
        let p = child(f, i, pcx);
        let mut t: i64 = if p > 0
            && pcx.nodes[p as usize].kind == NodeKind::Param { pcx.nodes[p as usize].b } else { 0 };
        // (`inout Fmt` is the parser's TyPtr of it)
        if t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyPtr {
            t = pcx.nodes[t as usize].a;
        }
        if t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyName
            && get_src()[pcx.nodes[t as usize].start as usize..pcx.nodes[t as usize].end as usize]
            == b"Fmt" {
            return true;
        }
    }
    false
}

// (0.27.5) fn node f's result `-> std::fmt::Result` and its body's end
// `Ok(())`: an impl's fmt (fmt_impl), a helper of one (fmt_helpers).
fn fmt_result(f: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let body = pcx.nodes[f as usize].c;
    if pcx.nodes[f as usize].b == 0 {
        // (the result, after the parameters' `)`)
        let mut q = pcx.nodes[body as usize].start - 1;
        while q > pcx.nodes[f as usize].start && get_src()[q as usize] != b')' {
            q -= 1;
        }
        put(q + 1, q + 1, b" -> std::fmt::Result", TC_TYPE, tr, pcx);
    }
    let tail = pcx.nodes[body as usize].a;
    if tail > 0 {
        put(pcx.nodes[tail as usize].end, pcx.nodes[tail as usize].end, b"; Ok(())", -1, tr, pcx);
    } else {
        let mut q = pcx.nodes[body as usize].end - 1;
        while q > pcx.nodes[body as usize].start && get_src()[q as usize] != b'}' {
            q -= 1;
        }
        put(q, q, b" Ok(()) ", -1, tr, pcx);
    }
}

// (0.27.5) The Fn node node n is in, by the tree (enclosing_fn's search
// by position may find a copy the checker made at the same place), or 0.
fn parent_fn(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> i64 {
    let mut p = parent_of(n, tr);
    let mut steps: i64 = 0;
    while p > 0 && pcx.nodes[p as usize].kind != NodeKind::Fn && steps < 10000 {
        p = parent_of(p, tr);
        steps += 1;
    }
    p
}

// (0.27.5) In the rust edition a Display body's writes are `?`'d, so a
// function that writes through a Fmt and returns nothing returns
// std::fmt::Result: MVS's helpers of a fmt get the result and `Ok(())`
// (an impl's fmt has them from fmt_impl), a call of one its `?` (in a
// function that returns no Result, `.unwrap()`), and an empty `return;`
// in either is `return Ok(());`.
fn fmt_helpers(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if !own_node(n, *tr, pcx) {
            continue;
        }
        if k == NodeKind::Fn && fmt_fn(n, pcx) {
            let nm = crate::base::sym_text(pcx.nodes[n as usize].a, pcx);
            if nm != b"fmt" && nm != b"fmt_debug" {
                fmt_result(n, tr, pcx);
            }
        }
        else if k == NodeKind::Return && pcx.nodes[n as usize].a <= 0
            && word_here(pcx.nodes[n as usize].start, b"return")
            && fmt_fn(parent_fn(n, *tr, pcx), pcx) {
            put(pcx.nodes[n as usize].start + 6, pcx.nodes[n as usize].start + 6, b" Ok(())", -1,
                tr, pcx);
        } else if k == NodeKind::Call && pcx.nodes[n as usize].end > pcx.nodes[n as usize].start {
            let f = pcx.nodes[n as usize].x - 1;
            if f < 0 || f >= pcx.fns.len() as i64 {
                continue;
            }
            let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
            let fnode = pcx.fns[g as usize].node;
            if !fmt_fn(fnode, pcx) || !editable(pcx.nodes[fnode as usize].start, pcx) {
                continue;
            }
            let nm = crate::base::sym_text(pcx.nodes[fnode as usize].a, pcx);
            if nm == b"fmt" || nm == b"fmt_debug" {
                continue;
            }
            let e = pcx.nodes[n as usize].end;
            put(e, e,
                if fmt_fn(parent_fn(n, *tr, pcx), pcx) { b"?" } else { b".unwrap()" },
                -1, tr, pcx);
        }
    }
}

// An impl of Display or Debug (rewrite.tsv's Display::fmt, Debug::fmt_debug
// rows): `fn fmt(&self, f: &mut Fmt) -> std::fmt::Result`, its body ending
// in `Ok(())` (its writes are `?`'d by their rows).
fn fmt_impl(n: i64, debug: bool, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for j in 0..pcx.nodes[n as usize].count {
        let f = child(n, j, pcx);
        if pcx.nodes[f as usize].kind != NodeKind::Fn || pcx.nodes[f as usize].c <= 0 {
            continue;
        }
        let nm = crate::base::sym_text(pcx.nodes[f as usize].a, pcx);
        if nm != b"fmt" && nm != b"fmt_debug" {
            continue;
        }
        if nm == b"fmt_debug" {
            let mut q = pcx.nodes[f as usize].start;
            while q < pcx.nodes[f as usize].end && !word_here(q, b"fmt_debug") {
                q += 1;
            }
            put(q, q + 9, b"fmt", TC_TYPE, tr, pcx);
        }
        fmt_result(f, tr, pcx);
    }
}

// Whether impl n has `type Output`.
fn has_output(n: i64, pcx: &Ctx<Comp>) -> bool {
    let h = pcx.nodes[n as usize].c;
    if h <= 0 {
        return false;
    }
    for j in 0..pcx.nodes[h as usize].count {
        let at = child(h, j, pcx);
        if crate::base::sym_text(pcx.nodes[at as usize].a, pcx) == b"Output" {
            return true;
        }
    }
    false
}

// ---- Copy types ----

// (MVS copies a value that owns nothing; Rust copies a type that derives
// Copy) Each struct and enum of the program every instance of which MVS
// copies derives Clone and Copy (an enum without fields PartialEq and Eq
// too, as MVS compares them); MVS's derive names are Rust's (`Eq`:
// PartialEq and Eq, `Ord`: PartialOrd and Ord).
fn derive_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // node + 1 -> 1: every instance copied, 2: one is not
    let mut copied = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for t in 1..pcx.types.len() as i64 {
        let k = pcx.types[t as usize].kind;
        let mut node: i64 = 0;
        if k == crate::front::types::TyKind::Struct {
            let si = pcx.types[t as usize].a;
            if pcx.structs[si as usize].closure != 0 {
                continue;
            }
            node = pcx.structs[si as usize].node;
            if pcx.structs[si as usize].tmpl > 0 {
                node = pcx.structs[(pcx.structs[si as usize].tmpl - 1) as usize].node;
            } else if pcx.structs[si as usize].generic > 0 {
                continue;
            }
        } else if k == crate::front::types::TyKind::Enum {
            let ei = pcx.types[t as usize].a;
            // UNSAFE: ENUMS is the checker's table, a raw pointer (front/types.vl)
            // SAFETY: ei is an Enum type's index, below pcx.enum_count; a
            // template's index (tmpl - 1) is one too
            unsafe {
                let e = (*crate::front::types::get_enums().add(ei as usize));
                node = e.node;
                if e.tmpl > 0 {
                    node = (*crate::front::types::get_enums().add((e.tmpl - 1) as usize)).node;
                } else if e.generic > 0 {
                    continue;
                }
            }
        } else {
            continue;
        }
        if node <= 0 || !editable(pcx.nodes[node as usize].start, pcx) {
            continue;
        }
        let was = copied.get(node + 1);
        if !crate::front::conv::copyable(t, pcx) {
            copied.put(node + 1, 2);
        } else if was == 0 {
            copied.put(node + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if k != NodeKind::Struct && k != NodeKind::Enum
            || !editable(pcx.nodes[n as usize].start, pcx) {
            continue;
        }
        // (a union: the rust edition derives nothing for one)
        let mut q = pcx.nodes[n as usize].start;
        while q < pcx.nodes[n as usize].end && get_src()[q as usize] != b'{'
            && !word_here(q, b"union") {
            q += 1;
        }
        if q < pcx.nodes[n as usize].end && get_src()[q as usize] != b'{' {
            continue;
        }
        let mut fieldless = k == NodeKind::Enum;
        if k == NodeKind::Enum {
            for j in 0..pcx.nodes[n as usize].count {
                if pcx.nodes[child(n, j, pcx) as usize].count > 0 {
                    fieldless = false;
                }
            }
        }
        // (0.27.5: an enum without fields too, which MVS copies even with
        // its own `#[derive(Clone)]`, as a struct of it that is Copy needs)
        let copy = copied.get(n + 1) == 1 || fieldless;
        let h = pcx.nodes[n as usize].h;
        let mut has_clone = false;
        let mut has_copy = false;
        let mut has_eq = false;
        let mut has_ord = false;
        if h > 0 {
            for j in 0..pcx.nodes[h as usize].count {
                let d = child(h, j, pcx);
                let ds = pcx.nodes[d as usize].start;
                if word_here(ds, b"Eq") {
                    put(ds, ds, b"PartialEq, ", TC_DERIVE, tr, pcx);
                    has_eq = true;
                } else if word_here(ds, b"Ord") {
                    put(ds, ds, b"PartialOrd, ", TC_DERIVE, tr, pcx);
                    has_ord = true;
                } else if word_here(ds, b"Clone") {
                    has_clone = true;
                } else if word_here(ds, b"Copy") {
                    has_copy = true;
                }
            }
        }
        let add = crate::base::buf_new();
        let view_enum = k == NodeKind::Enum && tr.view_items.get(pcx.nodes[n as usize].a + 1) == n
            && pcx.nodes[n as usize].g <= 0;
        if copy && !has_clone && view_enum {
            hand_clone(n, tr, pcx);
        } else if copy && !has_clone {
            crate::base::buf_bytes(add, b"Clone, ");
        }
        if copy && !has_copy {
            crate::base::buf_bytes(add, b"Copy, ");
        }
        // (Rust's Ord needs PartialEq and Eq, which MVS's derive(Ord) gave)
        if (fieldless || has_ord) && !has_eq {
            crate::base::buf_bytes(add, b"PartialEq, Eq, ");
        }
        let text = crate::base::buf_slice(add);
        if text.len() == 0 {
            continue;
        }
        if h > 0 && pcx.nodes[h as usize].count > 0 {
            // (after the last name: the first may have its `PartialEq, `
            // already, `#[derive(Eq, Clone)]`, which a second insertion
            // there would not join)
            let at = pcx.nodes[child(h, pcx.nodes[h as usize].count - 1, pcx) as usize].end;
            let more = crate::base::buf_new();
            crate::base::buf_bytes(more, b", ");
            crate::base::buf_bytes(more, &text[0..text.len() - 2]);
            put(at, at, crate::base::buf_slice(more), TC_DERIVE, tr, pcx);
        } else {
            // (a new attribute on the item's line)
            // (before the item's `pub`)
            let mut at = pcx.nodes[n as usize].start;
            let mut q = at - 1;
            while q > 0 && crate::tools::translate::is_ws(get_src()[q as usize]) {
                q -= 1;
            }
            if q >= 2 && get_src()[(q - 2) as usize..(q + 1) as usize] == b"pub" {
                at = q - 2;
            }
            // (before the item's other attributes, `#[repr(C)]`: the rust
            // edition takes a derive first)
            q = at - 1;
            while q > 0 && crate::tools::translate::is_ws(get_src()[q as usize]) {
                q -= 1;
            }
            while q > 0 && get_src()[q as usize] == b']' {
                let mut o = q;
                while o > 0
                    && !(get_src()[o as usize] == b'#' && get_src()[(o + 1) as usize] == b'[') {
                    o -= 1;
                }
                at = o;
                q = o - 1;
                while q > 0 && crate::tools::translate::is_ws(get_src()[q as usize]) {
                    q -= 1;
                }
            }
            let line = crate::base::buf_new();
            crate::base::buf_bytes(line, b"#[derive(");
            crate::base::buf_bytes(line, &text[0..text.len() - 2]);
            crate::base::buf_bytes(line, b")] ");
            put(at, at, crate::base::buf_slice(line), TC_DERIVE, tr, pcx);
        }
    }
}

// (a workaround, until the rust edition's derive clones an enum's
// reference payload: front's) A copy enum holding a view gets Clone
// written after it, `*self`, and derives only Copy.
fn hand_clone(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let im = crate::base::buf_new();
    crate::base::buf_bytes(im, b" impl Clone for ");
    crate::base::buf_bytes(im, crate::base::sym_text(pcx.nodes[n as usize].a, pcx));
    crate::base::buf_bytes(im, b"<'_> { fn clone(&self) -> Self { *self } }");
    let e = pcx.nodes[n as usize].end;
    put(e, e, crate::base::buf_slice(im), TC_DERIVE, tr, pcx);
}

pub fn signature_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut impls = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Impl {
            for j in 0..pcx.nodes[n as usize].count {
                impls.put(child(n, j, pcx) + 1, n);
            }
        }
    }
    crate::tools::translate::regions::find_view_items(tr, pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if !crate::tools::translate::own_node(n, *tr, pcx) {
            continue;
        }
        if k == NodeKind::Fn && pcx.nodes[n as usize].y == 0 {
            edit_signature(n, impls, tr, pcx);
        } else if k == NodeKind::Closure {
            edit_closure(n, tr, pcx);
        }
    }
    tr.force_ref = false;
    crate::tools::translate::regions::region_edits(tr, pcx);
    edit_types(tr, pcx);
    derive_edits(tr, pcx);
    impl_edits(tr, pcx);
    fmt_helpers(tr, pcx);
    crate::tools::translate::rows::type_row_edits(tr, pcx);
}
