// (0.27.3) The translator's signatures and types (mod.vl, pass 2): a
// parameter's convention written as Rust's type, a receiver as Rust's
// self, a view `[T]` as `&[T]`.

use crate::base::{IntVec, SRC};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::conv::{CONV_IN_OUT, CONV_LET, CONV_SINK_K, param_conv};
use crate::front::types::fn_param;
use crate::middle::lower::ssa::HMap;
use crate::tools::translate::{
    D_MUT, D_REF, D_VALUE, TC_DERIVE, TC_INOUT, TC_LET, TC_RECEIVER, TC_SINK, TC_TEXT, TC_TYPE,
    TC_VIEW, Tr, add_ref, editable, is_ref, is_ws, put, skip_ws, word_here,
};

// The operator traits, whose methods take self and their operand by value
// in Rust (table rows `impl ... fn add(self, rhs: Self)`).
fn by_value_trait(name: [u8]) -> bool {
    name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Rem"
        || name == "Neg" || name == "Not" || name == "BitAnd" || name == "BitOr"
        || name == "BitXor" || name == "Shl" || name == "Shr"
}

// Whether a type written as the node tn is a primitive's name (taken by
// value by a let parameter: a copy).
fn primitive_name(tn: i64, pcx: Ctx<Comp>) -> bool {
    if tn <= 0 || pcx.nodes[tn].kind != NodeKind::TyName {
        return false;
    }
    let w = SRC[pcx.nodes[tn].start..pcx.nodes[tn].end];
    w == "i8" || w == "i16" || w == "i32" || w == "i64" || w == "u8" || w == "u16"
        || w == "u32" || w == "u64" || w == "usize" || w == "isize" || w == "f32"
        || w == "f64" || w == "bool" || w == "char"
}

// The trait name of the impl that function node n is in ("" for none).
fn impl_trait(n: i64, impls: HMap, pcx: Ctx<Comp>) -> [u8] {
    let im = impls.get(n + 1);
    if im <= 0 {
        return "";
    }
    let t = pcx.nodes[im].a;
    if t <= 0 {
        return "";
    }
    crate::base::sym_text(pcx.nodes[t].a, pcx)
}

// A receiver: `self` is `&self` (`self` in an operator trait's impl),
// `inout self` `&mut self`, `sink self` `self`; `self: *T` (a raw pointer)
// is `self: *mut T`.
fn edit_receiver(p: i64, by_value: bool, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[p].start;
    let c = param_conv(p, pcx);
    if c == CONV_IN_OUT && word_here(s, "inout") {
        put(s, skip_ws(s + 5), "&mut ", TC_RECEIVER, &tr, &pcx);
    } else if c == CONV_SINK_K && word_here(s, "sink") {
        put(s, skip_ws(s + 4), "", TC_RECEIVER, &tr, &pcx);
    } else if c == CONV_LET && word_here(s, "self") && !by_value && SRC[skip_ws(s + 4)] != ':' {
        // (a typed one, `self: *T`, keeps its type: `self: *mut T`)
        put(s, s, "&", TC_RECEIVER, &tr, &pcx);
    }
}

// Parameter i (node p) of function node n (function f; -1: a trait's
// declaration, which has no checked signature).
fn edit_param(n: i64, f: i64, i: i64, p: i64, by_value: bool, gen: i64, tr: inout Tr,
    pcx: inout Ctx<Comp>) {
    let tn = pcx.nodes[p].b;
    let name = pcx.nodes[p].a;
    if name == tr.sym_self {
        edit_receiver(p, by_value, &tr, &pcx);
        if param_conv(p, pcx) == CONV_IN_OUT {
            tr.decided.put(p + 1, D_MUT);
            add_ref(pcx.nodes[n].start, pcx.nodes[n].end, name, &tr);
        } else if param_conv(p, pcx) == CONV_LET && !by_value {
            tr.decided.put(p + 1, D_REF);
            add_ref(pcx.nodes[n].start, pcx.nodes[n].end, name, &tr);
        } else {
            tr.decided.put(p + 1, D_VALUE);
        }
        return;
    }
    if tn <= 0 {
        return;
    }
    let ts = pcx.nodes[tn].start;
    let c = param_conv(p, pcx);
    if c == CONV_IN_OUT {
        if word_here(ts, "inout") {
            put(ts, skip_ws(ts + 5), "&mut ", TC_INOUT, &tr, &pcx);
            tr.typed.put(tn + 1, 1);
        }
        tr.decided.put(p + 1, D_MUT);
        add_ref(pcx.nodes[n].start, pcx.nodes[n].end, name, &tr);
        return;
    }
    if c == CONV_SINK_K {
        tr.decided.put(p + 1, D_VALUE);
        if word_here(ts, "sink") {
            put(ts, skip_ws(ts + 4), "", TC_SINK, &tr, &pcx);
        } else {
            // (the word before the type node: `d: sink D`)
            var q = ts - 1;
            while q > pcx.nodes[p].start && (SRC[q] == ' ' || SRC[q] == '\t') {
                q -= 1;
            }
            if q >= 3 && SRC[q - 3..q + 1] == "sink" {
                put(q - 3, ts, "", TC_SINK, &tr, &pcx);
            }
        }
        return;
    }
    if c != CONV_LET {
        return;
    }
    // (a written `let T`: the word goes, the reference decides below)
    var at = ts;
    if word_here(ts, "let") {
        at = skip_ws(ts + 3);
        put(ts, at, "", -1, &tr, &pcx);
    }
    let tk = pcx.nodes[tn].kind;
    if tk == NodeKind::TySlice && SRC[at] == '[' {
        view_put(tn, at, &tr, &pcx);
        tr.typed.put(tn + 1, 1);
        tr.decided.put(p + 1, D_VALUE);
        return;
    }
    tr.decided.put(p + 1, D_VALUE);
    if by_value {
        return;
    }
    // (a type parameter: by value, as Rust takes `f: F` and `x: T`; `mut f`
    // for a closure it calls through FnMut)
    let bound = type_param_bound(n, tn, gen, pcx);
    if bound >= 2 {
        if bound == 3 {
            put(pcx.nodes[p].start, pcx.nodes[p].start, "mut ", -1, &tr, &pcx);
        }
        return;
    }
    if bound == 0 {
        // (a type parameter T: `&T`, MVS's borrow, unless the function
        // gives the parameter back, which a reference could not)
        if !returns_name(pcx.nodes[n].c, name, pcx) {
            put(at, at, "&", TC_LET, &tr, &pcx);
            tr.decided.put(p + 1, D_REF);
        }
        return;
    }
    let borrows = if tr.force_ref && !is_ref_type_node(tn, pcx) { true }
        else if f >= 0 && i < pcx.fns[f].param_count { is_ref(fn_param(f, i, pcx), pcx) }
        else { !primitive_name(tn, pcx) && tk != NodeKind::TyPtr && tk != NodeKind::TyFn };
    if borrows {
        put(at, at, "&", TC_LET, &tr, &pcx);
        tr.decided.put(p + 1, D_REF);
        add_ref(pcx.nodes[n].start, pcx.nodes[n].end, name, &tr);
    }
}

// A view type node tn, `[T]` at `at`: `&[T]`; `&str` for `[u8]` in a
// program that uses its bytes as text only (body.vl: text_program).
fn view_put(tn: i64, at: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let e = pcx.nodes[tn].a;
    let st = tr.static_res.get(tn + 1) != 0;
    if tr.text_mode && e > 0 && pcx.nodes[e].kind == NodeKind::TyName
        && SRC[pcx.nodes[e].start..pcx.nodes[e].end] == "u8" {
        put(at, pcx.nodes[tn].end, if st { "&'static str" } else { "&str" }, TC_TEXT, &tr, &pcx);
        tr.typed.put(e + 1, 1);
    } else {
        put(at, at, if st { "&'static " } else { "&" }, TC_VIEW, &tr, &pcx);
    }
}

// Whether type node t (and its arguments) names symbol s.
fn names_in(t: i64, s: i64, pcx: Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    for q in pcx.nodes[t].start..pcx.nodes[t].end {
        if (q == pcx.nodes[t].start || !crate::tools::translate::ident_char(SRC[q - 1]))
            && SRC[q] >= 'A' && SRC[q] <= 'Z' {
            var e = q;
            while e < pcx.nodes[t].end && crate::tools::translate::ident_char(SRC[e]) {
                e += 1;
            }
            if SRC[q..e] == crate::base::sym_text(s, pcx) {
                return true;
            }
        }
    }
    false
}

// Whether the body b gives back the name s: its tail, a `return s`, the
// tail of an if's or a match's branch.
fn returns_name(b: i64, s: i64, pcx: Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Ident || pcx.nodes[n].a != s
            || pcx.nodes[n].start < pcx.nodes[b].start || pcx.nodes[n].end > pcx.nodes[b].end {
            continue;
        }
        // (followed by `}` or `;` after a `return`, or `}` alone: a tail)
        let after = crate::tools::translate::skip_ws(pcx.nodes[n].end);
        var q = pcx.nodes[n].start - 1;
        while q > 0 && crate::tools::translate::is_ws(SRC[q]) {
            q -= 1;
        }
        let before_ok = SRC[q] == '{' || SRC[q] == ';' || SRC[q] == '>' && SRC[q - 1] == '='
            || q >= 5 && SRC[q - 5..q + 1] == "return";
        if before_ok && (SRC[after] == '}' || SRC[after] == ';' || SRC[after] == ',') {
            return true;
        }
    }
    false
}

fn is_ref_type_node(tn: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[tn].kind == NodeKind::TyPtr || pcx.nodes[tn].kind == NodeKind::TySlice
}

// Whether type node tn names a type parameter of function node n or of
// its impl (gen, the impl's generics): -1 when it does not, else its Fn
// bound's kind (0: none, 2: Fn or Allocator, by value, 3: FnMut).
fn type_param_bound(n: i64, tn: i64, gen: i64, pcx: Ctx<Comp>) -> i64 {
    if tn <= 0 || pcx.nodes[tn].kind != NodeKind::TyName || pcx.nodes[tn].count > 0 {
        return -1;
    }
    let name = pcx.nodes[tn].a;
    for w in 0..2 {
        let g = if w == 0 { pcx.nodes[n].g } else { gen };
        if g <= 0 || pcx.nodes[g].kind != NodeKind::Generics {
            continue;
        }
        for i in 0..pcx.nodes[g].count {
            let tp = child(g, i, pcx);
            if pcx.nodes[tp].a != name {
                continue;
            }
            let h = pcx.nodes[tp].h;
            if h > 0 && pcx.nodes[h].kind == NodeKind::Generics {
                for j in 0..pcx.nodes[h].count {
                    let b = child(h, j, pcx);
                    if pcx.nodes[b].kind == NodeKind::TyFn && pcx.nodes[b].d >= 2 {
                        return pcx.nodes[b].d;
                    }
                    // (an allocator, which MVS copies: by value, as Gpa)
                    if pcx.nodes[b].kind == NodeKind::TyName
                        && word_here(pcx.nodes[b].start, "Allocator") {
                        return 2;
                    }
                }
            }
            return 0;
        }
    }
    -1
}

// Whether function node n takes a parameter by reference in the rust
// edition (as decided, or a view or reference written).
fn borrows_param(n: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    for j in 0..pcx.nodes[n].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p].kind != NodeKind::Param {
            continue;
        }
        let d = tr.decided.get(p + 1);
        if d == D_REF || d == D_MUT {
            return true;
        }
        let tn = pcx.nodes[p].b;
        if tn <= 0 {
            continue;
        }
        let k = pcx.nodes[tn].kind;
        let s = pcx.nodes[tn].start;
        if k == NodeKind::TySlice || k == NodeKind::TyName && word_here(s, "str")
            || k == NodeKind::TyPtr && SRC[s] != '*' || k == NodeKind::TyFn
            || crate::tools::translate::regions::names_view_item(tn, tr, pcx) {
            return true;
        }
    }
    false
}

// Function node n's parameters and result.
fn edit_signature(n: i64, impls: HMap, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let f = pcx.nodes[n].x - 1;
    var fi = if f >= 0 && f < pcx.fns.len() as i64 && pcx.fns[f].node == n
        && pcx.fns[f].generic == 0 { f } else { -1 };
    if fi < 0 {
        // (a generic function's template: an instance's checked signature,
        // its clone at the same place; a type parameter's is decided apart)
        for g in 0..pcx.fns.len() as i64 {
            let gn = pcx.fns[g].node;
            if fi < 0 && gn > 0 && gn != n && pcx.nodes[gn].kind == NodeKind::Fn
                && pcx.nodes[gn].start == pcx.nodes[n].start
                && pcx.nodes[gn].end == pcx.nodes[n].end {
                fi = g;
            }
        }
    }
    let by_value = by_value_trait(impl_trait(n, impls, pcx));
    let tname = impl_trait(n, impls, pcx);
    tr.force_ref = tname == "Eq" || tname == "Ord" || tname == "PartialEq" || tname == "PartialOrd";
    let im = impls.get(n + 1);
    let gen = if im > 0 { pcx.nodes[im].g } else { 0 };
    var i: i64 = 0;
    for j in 0..pcx.nodes[n].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p].kind != NodeKind::Param {
            continue;
        }
        edit_param(n, fi, i, p, by_value, gen, &tr, &pcx);
        i += 1;
    }
    // (a result that is a view: `-> &[T]`; `&'static [T]` when no
    // parameter is a reference, which Rust's elision would name)
    let r = pcx.nodes[n].b;
    if r > 0 && !borrows_param(n, tr, pcx) {
        tr.static_res.put(r + 1, 1);
    }
    if r > 0 && pcx.nodes[r].kind == NodeKind::TySlice && SRC[pcx.nodes[r].start] == '[' {
        view_put(r, pcx.nodes[r].start, &tr, &pcx);
        tr.typed.put(r + 1, 1);
    }
}

// A closure's parameters: as a function's, without a checked signature
// (their types come from where the closure goes).
fn edit_closure(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    for j in 0..pcx.nodes[n].count {
        let p = child(n, j, pcx);
        if pcx.nodes[p].kind != NodeKind::Param || pcx.nodes[p].b <= 0 {
            continue;
        }
        edit_param(n, -1, j, p, false, 0, &tr, &pcx);
    }
}

// Every other view type `[T]` (a let's, a type argument's) is `&[T]`, an
// `inout [T]` `&mut [T]`. (A struct's field: its region, sig's regions.)
fn edit_types(tr: inout Tr, pcx: inout Ctx<Comp>) {
    var fields = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Field && pcx.nodes[n].b > 0 {
            fields.put(pcx.nodes[n].b + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        // (MVS's raw pointer `*T` is `*mut T`: C's `const` is not in its
        // types, and a `c"..."` literal is accepted as either)
        if k == NodeKind::TyPtr && SRC[pcx.nodes[n].start] == '*'
            && editable(pcx.nodes[n].start, &pcx) {
            let s = pcx.nodes[n].start;
            put(s, s + 1, "*mut ", TC_TYPE, &tr, &pcx);
            continue;
        }
        if k != NodeKind::TySlice && k != NodeKind::TyPtr || tr.typed.get(n + 1) != 0
            || fields.get(n + 1) != 0 || !editable(pcx.nodes[n].start, &pcx) {
            continue;
        }
        let s = pcx.nodes[n].start;
        if word_here(s, "inout") {
            put(s, skip_ws(s + 5), "&mut ", TC_TYPE, &tr, &pcx);
        } else if word_here(s, "let") {
            put(s, skip_ws(s + 3), "&", TC_TYPE, &tr, &pcx);
        } else if k == NodeKind::TySlice && SRC[s] == '[' && (s == 0 || SRC[s - 1] != '*') {
            view_put(n, s, &tr, &pcx);
        }
    }
    // (`str`, a view of text, is `&str`; a function type's let parameter
    // of a type it does not copy `&T`)
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        let s = pcx.nodes[n].start;
        if k == NodeKind::TyName && fields.get(n + 1) == 0 && tr.typed.get(n + 1) == 0
            && editable(s, &pcx)
            && word_here(s, "str") && SRC[pcx.nodes[n].end - 1] == 'r' && !after_amp(s) {
            put(s, s, if tr.static_res.get(n + 1) != 0 { "&'static " } else { "&" }, TC_VIEW, &tr,
                &pcx);
        } else if k == NodeKind::TyFn && editable(s, &pcx) {
            for i in 0..pcx.nodes[n].count {
                let tn = child(n, i, pcx);
                let tk = pcx.nodes[tn].kind;
                let ts = pcx.nodes[tn].start;
                if tk == NodeKind::TyName && !primitive_name(tn, pcx) && !word_here(ts, "str")
                    && !after_amp(ts) && SRC[ts] >= 'A' && SRC[ts] <= 'Z' {
                    put(ts, ts, "&", TC_LET, &tr, &pcx);
                }
            }
        }
    }
}

// Whether the type at s follows a `&` or a `*` (a reference or a raw
// pointer's pointee already).
fn after_amp(s: i64) -> bool {
    var q = s - 1;
    while q > 0 && (SRC[q] == ' ' || SRC[q] == '\t') {
        q -= 1;
    }
    SRC[q] == '&' || SRC[q] == '*' || word_here_back(q, "mut")
}

fn word_here_back(q: i64, w: [u8]) -> bool {
    let n = w.len as i64;
    q - n + 1 >= 0 && SRC[q - n + 1..q + 1] == w
}

// ---- Impls ----

// (0.27.4) An impl of MVS's Allocator is std2's: `try_alloc(size, align)
// -> *u8` (null: none) is `allocate(&self, layout) -> Result<NonNull<u8>,
// AllocError>`, `try_resize(p, old_size, new_size, align)` is `grow` (and
// `shrink`, which calls it: realloc does both), `free(p, size, align)` is
// `deallocate(&self, p, layout)`. Each body is kept: its parameters are
// bound from the layouts first, and a pointer it gives is the Result.
fn allocator_impl_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Impl || !editable(pcx.nodes[n].start, &pcx)
            || pcx.nodes[n].a <= 0 || pcx.nodes[n].b <= 0
            || crate::base::sym_text(pcx.nodes[pcx.nodes[n].a].a, pcx) != "Allocator" {
            continue;
        }
        for i in 0..pcx.nodes[n].count {
            let f = child(n, i, pcx);
            if pcx.nodes[f].kind != NodeKind::Fn || pcx.nodes[f].c <= 0 {
                continue;
            }
            let m = crate::base::sym_text(pcx.nodes[f].a, pcx);
            var ps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for j in 0..pcx.nodes[f].count {
                let p = child(f, j, pcx);
                if pcx.nodes[p].kind == NodeKind::Param {
                    ps.push(pcx.nodes[p].a);
                }
            }
            let want = if m == "try_alloc" { 3 } else if m == "try_resize" { 5 }
                else if m == "free" { 4 } else { 0 };
            if want == 0 || ps.count != want {
                continue;
            }
            let body = pcx.nodes[f].c;
            var q = pcx.nodes[f].start;
            while q < pcx.nodes[body].start && !word_here(q, "fn") {
                q += 1;
            }
            let bs = pcx.nodes[body].start;
            let be = pcx.nodes[body].end - 1;
            if q >= bs || SRC[bs] != '{' || SRC[be] != '}' {
                continue;
            }
            let sig = crate::base::buf_new();
            let open = crate::base::buf_new();
            let close = crate::base::buf_new();
            if m == "try_alloc" {
                crate::base::buf_bytes(sig,
                    "fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> ");
                bind(open, crate::base::sym_text(ps.get(1), pcx), "__layout.size() as i64");
                bind(open, crate::base::sym_text(ps.get(2), pcx), "__layout.align() as i64");
            } else if m == "try_resize" {
                crate::base::buf_bytes(sig, "unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>, AllocError> ");
                bind(open, crate::base::sym_text(ps.get(1), pcx), "__p.as_ptr()");
                bind(open, crate::base::sym_text(ps.get(2), pcx), "__old.size() as i64");
                bind(open, crate::base::sym_text(ps.get(3), pcx), "__new.size() as i64");
                bind(open, crate::base::sym_text(ps.get(4), pcx), "__new.align() as i64");
            } else {
                crate::base::buf_bytes(sig,
                    "unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) ");
                bind(open, crate::base::sym_text(ps.get(1), pcx), "__p.as_ptr()");
                bind(open, crate::base::sym_text(ps.get(2), pcx), "__layout.size() as i64");
                bind(open, crate::base::sym_text(ps.get(3), pcx), "__layout.align() as i64");
            }
            if m != "free" {
                crate::base::buf_bytes(open, " NonNull::new({");
                crate::base::buf_bytes(close, "}).ok_or(AllocError) ");
            }
            crate::tools::translate::rows::drop_inside(q, bs, &pcx);
            if !crate::tools::edit::edit_replace(q, bs, sig, &pcx) {
                continue;
            }
            tr.counts[TC_TYPE] += 1;
            crate::tools::translate::rows::note_row_names(q, crate::base::buf_slice(sig), &tr,
                &pcx);
            crate::tools::edit::edit_replace(bs + 1, bs + 1, open, &pcx);
            if m != "free" {
                crate::tools::edit::edit_replace(be, be, close, &pcx);
            }
            if m == "try_resize" {
                let sh = crate::base::buf_new();
                crate::base::buf_bytes(sh, " unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>, AllocError> { unsafe { self.grow(p, old, new) } }");
                crate::tools::edit::edit_replace(pcx.nodes[f].end, pcx.nodes[f].end, sh, &pcx);
            }
        }
    }
}

// ` let NAME = VALUE;` into out.
fn bind(out: i64, name: [u8], value: [u8]) {
    crate::base::buf_bytes(out, " let ");
    crate::base::buf_bytes(out, name);
    crate::base::buf_bytes(out, " = ");
    crate::base::buf_bytes(out, value);
    crate::base::buf_bytes(out, ";");
}

// (0.27.4) An impl of Iterator drops MVS's loop hints, `exact_len` (the
// items left) and `at(k)` (the k-th left, read without advancing): Rust's
// Iterator has neither (`nth` advances; ExactSizeIterator's `len` needs
// an exact size_hint), and a `for` reads `next` alone. With an
// `#[inline]` before one.
fn iterator_impl_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Impl || !editable(pcx.nodes[n].start, &pcx)
            || pcx.nodes[n].a <= 0 || pcx.nodes[n].b <= 0
            || crate::base::sym_text(pcx.nodes[pcx.nodes[n].a].a, pcx) != "Iterator" {
            continue;
        }
        for i in 0..pcx.nodes[n].count {
            let f = child(n, i, pcx);
            if pcx.nodes[f].kind != NodeKind::Fn {
                continue;
            }
            let m = crate::base::sym_text(pcx.nodes[f].a, pcx);
            if m != "exact_len" && m != "at" {
                continue;
            }
            var s = pcx.nodes[f].start;
            var q = s - 1;
            while q > 0 && is_ws(SRC[q]) {
                q -= 1;
            }
            if q >= 8 && SRC[q - 8..q + 1] == "#[inline]" {
                s = q - 8;
            }
            crate::tools::translate::rows::drop_inside(s, pcx.nodes[f].end, &pcx);
            let t = crate::base::buf_new();
            if crate::tools::edit::edit_replace(s, pcx.nodes[f].end, t, &pcx) {
                tr.counts[TC_TYPE] += 1;
            }
        }
    }
}

// An impl of an operator trait gets its `type Output = Self;` (MVS's had
// none); an impl of MVS's Eq is Rust's PartialEq, and Eq's empty impl
// after it.
fn impl_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Impl || !editable(pcx.nodes[n].start, &pcx)
            || pcx.nodes[n].a <= 0 || pcx.nodes[n].b <= 0
            || !word_here(pcx.nodes[n].start, "impl") {
            // (an impl the checker made of a derive: the derive's)
            continue;
        }
        let t = pcx.nodes[n].a;
        let name = crate::base::sym_text(pcx.nodes[t].a, pcx);
        let self_ty = SRC[pcx.nodes[pcx.nodes[n].b].start..pcx.nodes[pcx.nodes[n].b].end];
        if by_value_trait(name) && !has_output(n, pcx) {
            var q = pcx.nodes[pcx.nodes[n].b].end;
            while q < pcx.nodes[n].end && SRC[q] != '{' {
                q += 1;
            }
            if q < pcx.nodes[n].end {
                let b = crate::base::buf_new();
                crate::base::buf_bytes(b, " type Output = ");
                crate::base::buf_bytes(b, self_ty);
                crate::base::buf_bytes(b, ";");
                put(q + 1, q + 1, crate::base::buf_slice(b), TC_TYPE, &tr, &pcx);
            }
        } else if name == "Display" || name == "Debug" {
            fmt_impl(n, name == "Debug", &tr, &pcx);
        } else if name == "Ord" && word_here(pcx.nodes[t].start, "Ord") {
            ord_impl(n, t, self_ty, &tr, &pcx);
        } else if name == "Eq" && word_here(pcx.nodes[t].start, "Eq") {
            put(pcx.nodes[t].start, pcx.nodes[t].start + 2, "PartialEq", TC_TYPE, &tr, &pcx);
            let b = crate::base::buf_new();
            crate::base::buf_bytes(b, " ");
            crate::base::buf_bytes(b, SRC[pcx.nodes[n].start..pcx.nodes[t].start]);
            crate::base::buf_bytes(b, "Eq for ");
            crate::base::buf_bytes(b, self_ty);
            crate::base::buf_bytes(b, " {}");
            put(pcx.nodes[n].end, pcx.nodes[n].end, crate::base::buf_slice(b), -1, &tr, &pcx);
        }
    }
    allocator_impl_edits(&tr, &pcx);
    iterator_impl_edits(&tr, &pcx);
}

// An impl of MVS's Ord, whose `cmp` gives an i64 (negative, zero,
// positive): Rust's, `-> Ordering`, the body's value compared with 0, and
// the PartialOrd it needs after it (with PartialEq and Eq from cmp when the
// type has no Eq of its own).
fn ord_impl(n: i64, t: i64, self_ty: [u8], tr: inout Tr, pcx: inout Ctx<Comp>) {
    var f = 0;
    for j in 0..pcx.nodes[n].count {
        let c = child(n, j, pcx);
        if pcx.nodes[c].kind == NodeKind::Fn && word_here(skip_ws(pcx.nodes[c].start + 2), "cmp") {
            f = c;
        }
    }
    let r = if f > 0 { pcx.nodes[f].b } else { 0 };
    let body = if f > 0 { pcx.nodes[f].c } else { 0 };
    if r <= 0 || body <= 0 || !word_here(pcx.nodes[r].start, "i64") {
        return;
    }
    put(pcx.nodes[r].start, pcx.nodes[r].end, "std::cmp::Ordering", TC_TYPE, &tr, &pcx);
    put(pcx.nodes[body].start, pcx.nodes[body].start, "{ (", -1, &tr, &pcx);
    put(pcx.nodes[body].end, pcx.nodes[body].end, ").cmp(&0) }", -1, &tr, &pcx);
    let head = SRC[pcx.nodes[n].start..pcx.nodes[t].start];
    let b = crate::base::buf_new();
    crate::base::buf_bytes(b, " ");
    crate::base::buf_bytes(b, head);
    crate::base::buf_bytes(b, "PartialOrd for ");
    crate::base::buf_bytes(b, self_ty);
    crate::base::buf_bytes(b,
        " { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(self.cmp(o)) } }");
    if !has_eq(n, self_ty, pcx) {
        crate::base::buf_bytes(b, " ");
        crate::base::buf_bytes(b, head);
        crate::base::buf_bytes(b, "PartialEq for ");
        crate::base::buf_bytes(b, self_ty);
        crate::base::buf_bytes(b,
            " { fn eq(&self, o: &Self) -> bool { self.cmp(o) == std::cmp::Ordering::Equal } } ");
        crate::base::buf_bytes(b, head);
        crate::base::buf_bytes(b, "Eq for ");
        crate::base::buf_bytes(b, self_ty);
        crate::base::buf_bytes(b, " {}");
    }
    put(pcx.nodes[n].end, pcx.nodes[n].end, crate::base::buf_slice(b), -1, &tr, &pcx);
}

// Whether the type impl n is of (written self_ty) has an Eq: an impl of
// Eq or PartialEq, or a derive's.
fn has_eq(n: i64, self_ty: [u8], pcx: Ctx<Comp>) -> bool {
    let tb = pcx.nodes[n].b;
    let sym = if tb > 0 { pcx.nodes[tb].a } else { 0 };
    for m in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[m].kind;
        if k == NodeKind::Impl && m != n && pcx.nodes[m].a > 0 && pcx.nodes[m].b > 0 {
            let tn = crate::base::sym_text(pcx.nodes[pcx.nodes[m].a].a, pcx);
            let st = SRC[pcx.nodes[pcx.nodes[m].b].start..pcx.nodes[pcx.nodes[m].b].end];
            if (tn == "Eq" || tn == "PartialEq") && st == self_ty {
                return true;
            }
        }
        if (k == NodeKind::Struct || k == NodeKind::Enum) && pcx.nodes[m].a == sym
            && pcx.nodes[m].h > 0 {
            let h = pcx.nodes[m].h;
            for j in 0..pcx.nodes[h].count {
                if word_here(pcx.nodes[child(h, j, pcx)].start, "Eq") {
                    return true;
                }
            }
        }
    }
    false
}

// An impl of Display or Debug (rewrite.tsv's Display::fmt, Debug::fmt_debug
// rows): `fn fmt(&self, f: &mut Fmt) -> std::fmt::Result`, its body ending
// in `Ok(())` (its writes are `?`'d by their rows).
fn fmt_impl(n: i64, debug: bool, tr: inout Tr, pcx: inout Ctx<Comp>) {
    for j in 0..pcx.nodes[n].count {
        let f = child(n, j, pcx);
        if pcx.nodes[f].kind != NodeKind::Fn || pcx.nodes[f].c <= 0 {
            continue;
        }
        let nm = crate::base::sym_text(pcx.nodes[f].a, pcx);
        if nm != "fmt" && nm != "fmt_debug" {
            continue;
        }
        if nm == "fmt_debug" {
            var q = pcx.nodes[f].start;
            while q < pcx.nodes[f].end && !word_here(q, "fmt_debug") {
                q += 1;
            }
            put(q, q + 9, "fmt", TC_TYPE, &tr, &pcx);
        }
        let body = pcx.nodes[f].c;
        if pcx.nodes[f].b == 0 {
            // (the result, after the parameters' `)`)
            var q = pcx.nodes[body].start - 1;
            while q > pcx.nodes[f].start && SRC[q] != ')' {
                q -= 1;
            }
            put(q + 1, q + 1, " -> std::fmt::Result", TC_TYPE, &tr, &pcx);
        }
        let tail = pcx.nodes[body].a;
        if tail > 0 {
            put(pcx.nodes[tail].end, pcx.nodes[tail].end, "; Ok(())", -1, &tr, &pcx);
        } else {
            var q = pcx.nodes[body].end - 1;
            while q > pcx.nodes[body].start && SRC[q] != '}' {
                q -= 1;
            }
            put(q, q, " Ok(()) ", -1, &tr, &pcx);
        }
    }
}

// Whether impl n has `type Output`.
fn has_output(n: i64, pcx: Ctx<Comp>) -> bool {
    let h = pcx.nodes[n].c;
    if h <= 0 {
        return false;
    }
    for j in 0..pcx.nodes[h].count {
        let at = child(h, j, pcx);
        if crate::base::sym_text(pcx.nodes[at].a, pcx) == "Output" {
            return true;
        }
    }
    false
}

// ---- Copy types ----

// (MVS copies a value that owns nothing; Rust copies a type that derives
// Copy) Each struct and enum of the program every instance of which MVS
// copies derives Clone and Copy (an enum without fields PartialEq and Eq
// too, as MVS compares them); MVS's derive names are Rust's (`Eq`:
// PartialEq and Eq, `Ord`: PartialOrd and Ord).
fn derive_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    // node + 1 -> 1: every instance copied, 2: one is not
    var copied = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for t in 1..pcx.types.len() as i64 {
        let k = pcx.types[t].kind;
        var node = 0;
        if k == crate::front::types::TyKind::Struct {
            let si = pcx.types[t].a;
            if pcx.structs[si].closure != 0 {
                continue;
            }
            node = pcx.structs[si].node;
            if pcx.structs[si].tmpl > 0 {
                node = pcx.structs[pcx.structs[si].tmpl - 1].node;
            } else if pcx.structs[si].generic > 0 {
                continue;
            }
        } else if k == crate::front::types::TyKind::Enum {
            let ei = pcx.types[t].a;
            // UNSAFE: ENUMS is the checker's table, a raw pointer (front/types.vl)
            // SAFETY: ei is an Enum type's index, below pcx.enum_count; a
            // template's index (tmpl - 1) is one too
            unsafe {
                let e = crate::front::types::ENUMS[ei];
                node = e.node;
                if e.tmpl > 0 {
                    node = crate::front::types::ENUMS[e.tmpl - 1].node;
                } else if e.generic > 0 {
                    continue;
                }
            }
        } else {
            continue;
        }
        if node <= 0 || !editable(pcx.nodes[node].start, &pcx) {
            continue;
        }
        let was = copied.get(node + 1);
        if !crate::front::conv::copyable(t, &pcx) {
            copied.put(node + 1, 2);
        } else if was == 0 {
            copied.put(node + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if k != NodeKind::Struct && k != NodeKind::Enum || !editable(pcx.nodes[n].start, &pcx) {
            continue;
        }
        // (a union: the rust edition derives nothing for one)
        var q = pcx.nodes[n].start;
        while q < pcx.nodes[n].end && SRC[q] != '{' && !word_here(q, "union") {
            q += 1;
        }
        if q < pcx.nodes[n].end && SRC[q] != '{' {
            continue;
        }
        let copy = copied.get(n + 1) == 1;
        var fieldless = k == NodeKind::Enum;
        if k == NodeKind::Enum {
            for j in 0..pcx.nodes[n].count {
                if pcx.nodes[child(n, j, pcx)].count > 0 {
                    fieldless = false;
                }
            }
        }
        let h = pcx.nodes[n].h;
        var has_clone = false;
        var has_copy = false;
        var has_eq = false;
        var has_ord = false;
        if h > 0 {
            for j in 0..pcx.nodes[h].count {
                let d = child(h, j, pcx);
                let ds = pcx.nodes[d].start;
                if word_here(ds, "Eq") {
                    put(ds, ds, "PartialEq, ", TC_DERIVE, &tr, &pcx);
                    has_eq = true;
                } else if word_here(ds, "Ord") {
                    put(ds, ds, "PartialOrd, ", TC_DERIVE, &tr, &pcx);
                    has_ord = true;
                } else if word_here(ds, "Clone") {
                    has_clone = true;
                } else if word_here(ds, "Copy") {
                    has_copy = true;
                }
            }
        }
        let add = crate::base::buf_new();
        let view_enum = k == NodeKind::Enum && tr.view_items.get(pcx.nodes[n].a + 1) == n
            && pcx.nodes[n].g <= 0;
        if copy && !has_clone && view_enum {
            hand_clone(n, &tr, &pcx);
        } else if copy && !has_clone {
            crate::base::buf_bytes(add, "Clone, ");
        }
        if copy && !has_copy {
            crate::base::buf_bytes(add, "Copy, ");
        }
        // (Rust's Ord needs PartialEq and Eq, which MVS's derive(Ord) gave)
        if (fieldless || has_ord) && !has_eq {
            crate::base::buf_bytes(add, "PartialEq, Eq, ");
        }
        let text = crate::base::buf_slice(add);
        if text.len == 0 {
            continue;
        }
        if h > 0 && pcx.nodes[h].count > 0 {
            let at = pcx.nodes[child(h, 0, pcx)].start;
            put(at, at, text, TC_DERIVE, &tr, &pcx);
        } else {
            // (a new attribute on the item's line)
            // (before the item's `pub`)
            var at = pcx.nodes[n].start;
            var q = at - 1;
            while q > 0 && crate::tools::translate::is_ws(SRC[q]) {
                q -= 1;
            }
            if q >= 2 && SRC[q - 2..q + 1] == "pub" {
                at = q - 2;
            }
            // (before the item's other attributes, `#[repr(C)]`: the rust
            // edition takes a derive first)
            q = at - 1;
            while q > 0 && crate::tools::translate::is_ws(SRC[q]) {
                q -= 1;
            }
            while q > 0 && SRC[q] == ']' {
                var o = q;
                while o > 0 && !(SRC[o] == '#' && SRC[o + 1] == '[') {
                    o -= 1;
                }
                at = o;
                q = o - 1;
                while q > 0 && crate::tools::translate::is_ws(SRC[q]) {
                    q -= 1;
                }
            }
            let line = crate::base::buf_new();
            crate::base::buf_bytes(line, "#[derive(");
            crate::base::buf_bytes(line, text[0..text.len - 2]);
            crate::base::buf_bytes(line, ")] ");
            put(at, at, crate::base::buf_slice(line), TC_DERIVE, &tr, &pcx);
        }
    }
}

// (a workaround, until the rust edition's derive clones an enum's
// reference payload: front's) A copy enum holding a view gets Clone
// written after it, `*self`, and derives only Copy.
fn hand_clone(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let im = crate::base::buf_new();
    crate::base::buf_bytes(im, " impl Clone for ");
    crate::base::buf_bytes(im, crate::base::sym_text(pcx.nodes[n].a, pcx));
    crate::base::buf_bytes(im, "<'_> { fn clone(&self) -> Self { *self } }");
    let e = pcx.nodes[n].end;
    put(e, e, crate::base::buf_slice(im), TC_DERIVE, &tr, &pcx);
}

pub fn signature_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    var impls = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Impl {
            for j in 0..pcx.nodes[n].count {
                impls.put(child(n, j, pcx) + 1, n);
            }
        }
    }
    crate::tools::translate::regions::find_view_items(&tr, &pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if !crate::tools::translate::own_node(n, tr, &pcx) {
            continue;
        }
        if k == NodeKind::Fn && pcx.nodes[n].y == 0 {
            edit_signature(n, impls, &tr, &pcx);
        } else if k == NodeKind::Closure {
            edit_closure(n, &tr, &pcx);
        }
    }
    tr.force_ref = false;
    crate::tools::translate::regions::region_edits(&tr, &pcx);
    edit_types(&tr, &pcx);
    derive_edits(&tr, &pcx);
    impl_edits(&tr, &pcx);
    crate::tools::translate::rows::type_row_edits(&tr, &pcx);
}
