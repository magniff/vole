// (0.27.3) The translator's paths (mod.vl, pass 4): MVS's std is flat
// (`std::HashMap`, `std::Fmt`), std2 is Rust's tree (`std::collections::
// HashMap`, `std::fmt::Formatter`). Each `use std::...` of the program is
// written with std2's paths (table.vl's path_rows, from checklist.tsv),
// an item std2's prelude holds is not imported, an item renamed is
// imported under its MVS name (`use std::fmt::Formatter as Fmt;`: the
// type rows rename its uses), and a type or trait MVS's prelude gave that
// std2's does not (Display, HashMap, Add) is imported where it is used.

use crate::base::{IntVec, buf_bytes, buf_new, buf_slice, get_src, intern, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::NodeKind;
use crate::front::lexer::Tok;
use crate::middle::lower::ssa::HMap;
use crate::tools::translate::{TC_IMPORT, Tr, editable, ident_char, put};

// The rows of a table function's buffer, each split at its tabs into
// buffers: cols buffers per row, pushed to out.
pub fn split_rows(b: i64, cols: i64, out: &mut IntVec) {
    let t = buf_slice(b);
    let mut i: usize = 0;
    while i < t.len() {
        let mut e = i;
        while e < t.len() && t[e] != b'\n' {
            e += 1;
        }
        let mut c = i;
        let mut k: i64 = 0;
        while k < cols {
            let mut ce = c;
            while ce < e && t[ce] != b'\t' {
                ce += 1;
            }
            let cb = buf_new();
            buf_bytes(cb, &t[c..ce]);
            out.push(cb);
            c = if ce < e { ce + 1 } else { e };
            k += 1;
        }
        i = e + 1;
    }
}

// (0.27.5) Std2 path buffer p as a program names it: an item of std::iter's
// private modules (`mod sources;`, `mod adapters;`) by the re-export,
// `std::iter::Repeat` for std::iter::sources::Repeat.
fn public_path(p: i64) -> i64 {
    let s = buf_slice(p);
    let pre: i64 = if s.len() > 20 && s[0..20] == b"std::iter::sources::" { 20 }
        else if s.len() > 21 && s[0..21] == b"std::iter::adapters::" { 21 } else { 0 };
    if pre == 0 {
        return p;
    }
    let out = buf_new();
    buf_bytes(out, b"std::iter::");
    buf_bytes(out, &s[pre as usize..s.len()]);
    out
}

// Whether a row's rust text calls name itself (`name(` not after a letter,
// a digit, `_`, `.` or `:`): its import is then still needed.
fn names_call(text: &[u8], name: &[u8]) -> bool {
    let mut i: usize = 0;
    while i + name.len() < text.len() {
        if &text[i..i + name.len()] == name && text[i + name.len()] == b'('
            && (i == 0 || !(ident_char(text[i - 1]) || text[i - 1] == b'.' || text[i - 1] == b':')) {
            return true;
        }
        i += 1;
    }
    false
}

// The tables, read once: Tr.paths (mvs name's symbol, std2 path buffer)
// pairs, Tr.prelude (symbol + 1 -> 1), Tr.rows (rewrite.tsv: mvs, when,
// rust, note buffers) and Tr.row_free (a free function with a row: symbol
// -> 1).
pub fn load_tables(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let pb = buf_new();
    crate::tools::translate::table::path_rows(pb);
    let mut cells = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    split_rows(pb, 2, &mut cells);
    let mut i: i64 = 0;
    while i + 1 < cells.count {
        tr.paths.push(intern(buf_slice(cells.get(i)), pcx));
        tr.paths.push(public_path(cells.get(i + 1)));
        i += 2;
    }
    let lb = buf_new();
    crate::tools::translate::table::prelude_rows(lb);
    let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    split_rows(lb, 1, &mut names);
    for j in 0..names.count {
        tr.prelude.put(intern(buf_slice(names.get(j)), pcx) + 1, 1);
    }
    let rb = buf_new();
    crate::tools::translate::table::rewrite_rows(rb);
    split_rows(rb, 4, &mut tr.rows);
    let mut r: i64 = 0;
    while r + 3 < tr.rows.count {
        let m = buf_slice(tr.rows.get(r));
        let mut colon = false;
        let mut last: usize = 0;
        for q in 0..m.len() {
            if m[q] == b':' {
                colon = true;
                last = q + 1;
            }
        }
        // (0.27.5: `fs::copy`, a module's free function, by its name)
        if !colon || m.len() > 0 && m[0] >= b'a' && m[0] <= b'z' {
            // (2: a row for every call, when `-`; its name is then never
            // imported: import_one)
            // (a function: a type row, `Arena`, keeps its import)
            let always = buf_slice(tr.rows.get(r + 1)) == b"-" && last < m.len() && m[last] >= b'a'
                && m[last] <= b'z' && !names_call(buf_slice(tr.rows.get(r + 2)), &m[last..m.len()]);
            let key = intern(&m[last..m.len()], pcx) + 1;
            if tr.row_free.get(key) != 1 {
                tr.row_free.put(key, if always { 2 } else { 1 });
            }
        }
        r += 4;
    }
}

// The last segment of path p's text.
fn last_segment(p: &[u8]) -> &[u8] {
    let mut k = p.len();
    while k > 0 && p[k - 1] != b':' {
        k -= 1;
    }
    &p[k..p.len()]
}

// The module part of path p's text (`std::fmt` of `std::fmt::Formatter`).
fn module_part(p: &[u8]) -> &[u8] {
    let mut k = p.len();
    while k > 0 && p[k - 1] != b':' {
        k -= 1;
    }
    if k >= 2 { &p[0..k - 2] } else { &p[0..0] }
}

// The std2 path of MVS item `name` imported from MVS module `module` (its
// text, `std` or `std::io`): the candidate in that module, else (from
// `std`) the first;
// 0 for none.
pub fn std2_path(name: i64, module: &[u8], tr: Tr) -> i64 {
    let mut first: i64 = 0;
    let mut i: i64 = 0;
    while i + 1 < tr.paths.count {
        if tr.paths.get(i) == name {
            let p = buf_slice(tr.paths.get(i + 1));
            if module.len() > 3 && module_part(p) == module {
                return tr.paths.get(i + 1);
            }
            // (0.27.5: an item of one of std's modules is not one of another
            // module's of the same name, `std::cli::Command` std::process's:
            // the first candidate only for `std`'s own)
            if first == 0 && module.len() <= 3 {
                first = tr.paths.get(i + 1);
            }
        }
        i += 2;
    }
    first
}

// The path a use writes for std2's item at path p (a buffer): Rust's
// short path for the collections (`std::collections::HashMap`).
fn written_path(p: i64, out: i64) {
    let t = buf_slice(p);
    let m = module_part(t);
    if m == b"std::collections::hash_map" || m == b"std::collections::hash_set"
        || m == b"std::collections::btree_map" {
        let last = last_segment(t);
        if last == b"HashMap" || last == b"HashSet" || last == b"BTreeMap" {
            buf_bytes(out, b"std::collections::");
            buf_bytes(out, last);
            return;
        }
    }
    buf_bytes(out, t);
}

// One imported item, `use` of MVS path text mvs (its last segment
// name): its std2 `use` into out (nothing: the prelude has it, or a row
// rewrites its calls); whether it was decided.
fn import_one(mvs: &[u8], alias: &[u8], out: i64, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    let name = last_segment(mvs);
    let sym = intern(name, pcx);
    let module = module_part(mvs);
    let p = std2_path(sym, module, tr);
    if p == 0 {
        // (MVS's `str`, std::string's: the primitive, no use)
        if name == b"str" && alias.len() == 0 || tr.row_free.get(sym + 1) != 0 {
            // (a free function whose calls a row rewrites)
            return true;
        }
        // (0.27.6: a variant of a prelude enum the prelude has itself,
        // `use std::Option::Some;`: no use)
        let owner = last_segment(module);
        if tr.prelude.get(sym + 1) != 0 && owner.len() > 0 && alias.len() == 0
            && tr.prelude.get(intern(owner, pcx) + 1) != 0 {
            return true;
        }
        // (a module, or an item std2 has under the same path)
        buf_bytes(out, b"use ");
        buf_bytes(out, mvs);
        if alias.len() > 0 {
            buf_bytes(out, b" as ");
            buf_bytes(out, alias);
        }
        buf_bytes(out, b"; ");
        return true;
    }
    // (0.28.0: std2 has it, but a row rewrites its every call into other
    // names, `arena_scope(g, f)` into `Arena::new_in(g).scope(..)`: no use,
    // else an unused import)
    if tr.row_free.get(sym + 1) == 2 && alias.len() == 0 {
        return true;
    }
    let std2 = buf_slice(p);
    let last = last_segment(std2);
    if tr.prelude.get(intern(last, pcx) + 1) != 0 && last == name && alias.len() == 0 {
        return true;
    }
    buf_bytes(out, b"use ");
    written_path(p, out);
    if alias.len() > 0 {
        buf_bytes(out, b" as ");
        buf_bytes(out, alias);
    } else if last != name {
        buf_bytes(out, b" as ");
        buf_bytes(out, name);
    }
    buf_bytes(out, b"; ");
    true
}

// A `use std::...;` at token k (the `use`) to its `;`: rewritten with
// std2's paths, on its line. A use of nested braces, a glob or `self` is
// left as written.
fn edit_use(k: i64, names: &mut HMap, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let n = pcx.toks.len() as i64;
    if k + 2 >= n || pcx.toks[(k + 1) as usize].kind != Tok::Ident
        || &get_src()[
            pcx.toks[(k + 1) as usize].start as usize..pcx.toks[(k + 1) as usize].end as usize]
        != b"std" {
        return;
    }
    let mut semi = k + 1;
    let mut braces: i64 = 0;
    let mut nested = false;
    let mut open: i64 = -1;
    while semi < n && pcx.toks[semi as usize].kind != Tok::Semi {
        let tk = pcx.toks[semi as usize].kind;
        if tk == Tok::LBrace {
            braces += 1;
            if braces > 1 {
                nested = true;
            }
            open = semi;
        } else if tk == Tok::RBrace {
            braces -= 1;
        } else if tk == Tok::Star {
            nested = true;
        }
        else if tk == Tok::Ident
            && get_src()[
                pcx.toks[semi as usize].start as usize..pcx.toks[semi as usize].end as usize]
            == b"self" {
            nested = true;
        }
        semi += 1;
    }
    if semi >= n || nested {
        return;
    }
    let out = buf_new();
    if open < 0 {
        // (one item: `use std::a::b;`, `use std::a::b as c;`)
        let mut end = semi;
        let mut alias = &get_src()[0..0];
        if semi - 2 > k && pcx.toks[(semi - 2) as usize].kind == Tok::As {
            end = semi - 2;
            alias = &get_src()[
                pcx.toks[(semi - 1) as usize].start as usize..pcx.toks[(semi - 1) as usize].end as usize];
        }
        let mvs = &get_src()[
            pcx.toks[(k + 1) as usize].start as usize..pcx.toks[(end - 1) as usize].end as usize];
        import_one(mvs, alias, out, *tr, pcx);
        note_name(pcx.toks[(end - 1) as usize].value as i64, alias, names, pcx);
    } else {
        // (`use std::a::{x, y as z, m::w};`)
        let prefix = &get_src()[
            pcx.toks[(k + 1) as usize].start as usize..pcx.toks[open as usize].start as usize];
        let mut j = open + 1;
        while j < semi && pcx.toks[j as usize].kind != Tok::RBrace {
            let mut e = j;
            while e < semi && pcx.toks[e as usize].kind != Tok::Comma
                && pcx.toks[e as usize].kind != Tok::RBrace {
                e += 1;
            }
            if e > j {
                let mut end = e;
                let mut alias = &get_src()[0..0];
                if e - 2 >= j && pcx.toks[(e - 2) as usize].kind == Tok::As {
                    end = e - 2;
                    alias = &get_src()[
                        pcx.toks[(e - 1) as usize].start as usize..pcx.toks[(e - 1) as usize].end as usize];
                }
                let path = buf_new();
                buf_bytes(path, prefix);
                buf_bytes(path,
                    &get_src()[
                        pcx.toks[j as usize].start as usize..pcx.toks[(end - 1) as usize].end as usize]);
                import_one(buf_slice(path), alias, out, *tr, pcx);
                note_name(pcx.toks[(end - 1) as usize].value as i64, alias, names, pcx);
            }
            j = if e < semi && pcx.toks[e as usize].kind == Tok::Comma { e + 1 } else { e };
        }
    }
    let mut text = buf_slice(out);
    // (the trailing blank of the last)
    if text.len() > 0 {
        text = &text[0..text.len() - 1];
    }
    let whole = &get_src()[
        pcx.toks[k as usize].start as usize..pcx.toks[semi as usize].end as usize];
    if text != whole {
        put(pcx.toks[k as usize].start, pcx.toks[semi as usize].end, text, TC_IMPORT, tr, pcx);
    }
}

// A path `std::a::b::X` in the program's code (not a use's) at token k:
// std2's path of X.
fn edit_path(k: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let n = pcx.toks.len() as i64;
    let mut j = k;
    // (to the type, `std::HashMap` of `std::HashMap::new_in`, else the end)
    while j + 2 < n && pcx.toks[(j + 1) as usize].kind == Tok::ColonColon
        && pcx.toks[(j + 2) as usize].kind == Tok::Ident
        && !(get_src()[pcx.toks[j as usize].start as usize] >= b'A'
            && get_src()[pcx.toks[j as usize].start as usize] <= b'Z') {
        j += 2;
    }
    if j == k {
        return;
    }
    let text = &get_src()[pcx.toks[k as usize].start as usize..pcx.toks[j as usize].end as usize];
    let p = std2_path(pcx.toks[j as usize].value as i64, module_part(text), *tr);
    if p == 0 {
        return;
    }
    let out = buf_new();
    written_path(p, out);
    if buf_slice(out) != text {
        put(pcx.toks[k as usize].start, pcx.toks[j as usize].end, buf_slice(out), TC_IMPORT, tr,
            pcx);
    }
}

// A name a use of the file brings (the alias's, else the item's).
fn note_name(item: i64, alias: &[u8], names: &mut HMap, pcx: &mut Ctx<Comp>) {
    let s = if alias.len() > 0 { intern(alias, pcx) } else { item };
    names.put(s + 1, 1);
}

// The program's own item names (symbol + 1 -> 1): they are not std's.
fn own_names(out: &mut HMap, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if (k == NodeKind::Struct || k == NodeKind::Enum || k == NodeKind::Trait
            || k == NodeKind::TypeAlias || k == NodeKind::Const || k == NodeKind::Static
            || k == NodeKind::Fn) && editable(pcx.nodes[n as usize].start, pcx) {
            out.put(pcx.nodes[n as usize].a + 1, 1);
        }
    }
}

// Whether the use at token k (the `use`) is MVS's `str` alone, `use
// std::string::str;` (or `std::str`, `crate::std::..`): the rust edition's
// `str` is the primitive, std2 has no such item, and the use goes; so does
// `use std::str::memchr;`.
fn drop_str_use(k: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) -> bool {
    let n = pcx.toks.len() as i64;
    let mut j = k + 1;
    if j + 1 < n && pcx.toks[j as usize].kind == Tok::Ident
        && get_src()[pcx.toks[j as usize].start as usize..pcx.toks[j as usize].end as usize]
        == b"crate"
        && pcx.toks[(j + 1) as usize].kind == Tok::ColonColon {
        j += 2;
    }
    if j + 2 >= n || pcx.toks[j as usize].kind != Tok::Ident
        || &get_src()[pcx.toks[j as usize].start as usize..pcx.toks[j as usize].end as usize]
        != b"std"
        || pcx.toks[(j + 1) as usize].kind != Tok::ColonColon {
        return false;
    }
    j += 2;
    if j + 2 < n && pcx.toks[j as usize].kind == Tok::Ident
        && get_src()[pcx.toks[j as usize].start as usize..pcx.toks[j as usize].end as usize]
        == b"string"
        && pcx.toks[(j + 1) as usize].kind == Tok::ColonColon {
        j += 2;
    }
    if j + 1 >= n || pcx.toks[j as usize].kind != Tok::Ident
        || &get_src()[pcx.toks[j as usize].start as usize..pcx.toks[j as usize].end as usize]
        != b"str" {
        return false;
    }
    // (`std::str::memchr`, which rewrite.tsv writes as an iterator's
    // position: std2 has no such function either)
    if j + 3 < n && pcx.toks[(j + 1) as usize].kind == Tok::ColonColon
        && pcx.toks[(j + 2) as usize].kind == Tok::Ident
        && get_src()[
            pcx.toks[(j + 2) as usize].start as usize..pcx.toks[(j + 2) as usize].end as usize]
        == b"memchr"
        && pcx.toks[(j + 3) as usize].kind == Tok::Semi {
        return put(pcx.toks[k as usize].start, pcx.toks[(j + 3) as usize].end, b"", TC_IMPORT, tr,
            pcx);
    }
    if pcx.toks[(j + 1) as usize].kind != Tok::Semi {
        return false;
    }
    put(pcx.toks[k as usize].start, pcx.toks[(j + 1) as usize].end, b"", TC_IMPORT, tr, pcx)
}

// The uses of every file of the program, and the imports a file needs.
pub fn path_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut own = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    own_names(&mut own, pcx);
    for f in 0..pcx.files.len() as i64 {
        let s = pcx.files[f as usize].start;
        let e = pcx.files[f as usize].end;
        if !editable(s, pcx) {
            continue;
        }
        let mut names = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut first: i64 = -1;
        let mut last: i64 = -1;
        let mut in_use = false;
        for k in 0..pcx.toks.len() as i64 {
            let t = pcx.toks[k as usize];
            if t.start < s || t.start >= e {
                continue;
            }
            if first < 0 {
                first = k;
            }
            last = k;
            if t.kind == Tok::Use {
                if !drop_str_use(k, tr, pcx) {
                    edit_use(k, &mut names, tr, pcx);
                }
                in_use = true;
            } else if t.kind == Tok::Semi {
                in_use = false;
            } else if in_use && t.kind == Tok::Ident && k + 1 < pcx.toks.len() as i64
                && (pcx.toks[(k + 1) as usize].kind == Tok::Comma
                    || pcx.toks[(k + 1) as usize].kind == Tok::RBrace
                    || pcx.toks[(k + 1) as usize].kind == Tok::Semi) {
                // (a name any use of the file binds, `use crate::lexer::Tok::{Hash}`
                // too: std2's item of that name is not imported beside it)
                names.put(t.value as i64 + 1, 1);
            }
            else if !in_use && t.kind == Tok::Ident
                && get_src()[t.start as usize..t.end as usize] == b"std"
                && (k == 0 || pcx.toks[(k - 1) as usize].kind != Tok::ColonColon) {
                edit_path(k, tr, pcx);
            }
        }
        if first < 0 {
            continue;
        }
        // (the types and traits MVS's prelude gave: a capitalized name std2
        // has outside its prelude, not the program's, not imported, not a
        // path's segment or a field)
        let add = buf_new();
        let mut added = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for k in first..last + 1 {
            let t = pcx.toks[k as usize];
            if t.kind != Tok::Ident || get_src()[t.start as usize] < b'A'
                || get_src()[t.start as usize] > b'Z' {
                continue;
            }
            let sym = t.value as i64;
            if names.get(sym + 1) != 0 || own.get(sym + 1) != 0 || added.get(sym + 1) != 0
                || tr.prelude.get(sym + 1) != 0 {
                continue;
            }
            if k > 0
                && (pcx.toks[(k - 1) as usize].kind == Tok::ColonColon
                    || pcx.toks[(k - 1) as usize].kind == Tok::Dot) {
                continue;
            }
            let p = std2_path(sym, &get_src()[0..0], *tr);
            if p == 0 {
                continue;
            }
            added.put(sym + 1, 1);
            let std2 = buf_slice(p);
            let last_seg = last_segment(std2);
            if tr.prelude.get(intern(last_seg, pcx) + 1) != 0
                && last_seg == &get_src()[t.start as usize..t.end as usize] {
                continue;
            }
            buf_bytes(add, b"use ");
            written_path(p, add);
            if last_seg != &get_src()[t.start as usize..t.end as usize] {
                buf_bytes(add, b" as ");
                buf_bytes(add, &get_src()[t.start as usize..t.end as usize]);
            }
            buf_bytes(add, b"; ");
        }
        if buf_slice(add).len() > 0 {
            // (on the line of the file's first item, after its leading
            // comments: no line moves)
            let at = import_at(pcx.toks[first as usize].start, e);
            // (before an attribute put there, a derive)
            if crate::tools::translate::put_first(at, buf_slice(add), tr, pcx) {
                tr.counts[TC_IMPORT as usize] += 1;
            }
        }
    }
}

// The std2 module a row's path names by its first segment (`mem` in
// `mem::replace`), its path to import, or "": a module that needs a `use`
// (`str::`, a primitive's, needs none).
fn std2_module(name: &[u8]) -> &'static [u8] {
    if name == b"mem" {
        b"std::mem"
    } else if name == b"slice" {
        b"std::slice"
    } else if name == b"ptr" {
        b"std::ptr"
    } else if name == b"fmt" {
        b"std::fmt"
    } else if name == b"io" {
        b"std::io"
    } else if name == b"thread" {
        b"std::thread"
    } else if name == b"cmp" {
        b"std::cmp"
    } else if name == b"hash_map" {
        b"std::collections::hash_map"
    } else if name == b"hash_set" {
        b"std::collections::hash_set"
    } else {
        b""
    }
}

// (after the rows) The imports of the names the rows wrote (`Layout`,
// `NonNull`: Tr.row_names), each file's: one std2 has outside its
// prelude, that the file does not name itself (then path_edits saw it).
// An item of the program elsewhere with the same name (compiler/src's
// own `Layout`) does not count: only what the file writes binds a name.
pub fn row_imports(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.files.len() as i64 {
        let s = pcx.files[f as usize].start;
        let e = pcx.files[f as usize].end;
        if !editable(s, pcx) {
            continue;
        }
        let mut written = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut first: i64 = -1;
        for k in 0..pcx.toks.len() as i64 {
            let t = pcx.toks[k as usize];
            if t.start >= s && t.start < e {
                if first < 0 {
                    first = k;
                }
                // (a path's later segment, `thread::JoinHandle`, names no item here)
                if t.kind == Tok::Ident
                    && (k == 0 || pcx.toks[(k - 1) as usize].kind != Tok::ColonColon
                        || pcx.toks[(k - 1) as usize].start < s) {
                    written.put(t.value as i64 + 1, 1);
                }
            }
        }
        if first < 0 {
            continue;
        }
        let add = buf_new();
        let mut r: i64 = 0;
        while r + 1 < tr.row_names.count {
            let sym = tr.row_names.get(r);
            let at = tr.row_names.get(r + 1);
            r += 2;
            if at < s || at >= e || written.get(sym + 1) != 0
                || tr.prelude.get(sym + 1) != 0 {
                continue;
            }
            let m = std2_module(sym_text(sym, pcx));
            if m.len() > 0 {
                // (a module a row's path starts with: `use std::mem;`)
                written.put(sym + 1, 1);
                buf_bytes(add, b"use ");
                buf_bytes(add, m);
                buf_bytes(add, b"; ");
                continue;
            }
            let p = std2_path(sym, &get_src()[0..0], *tr);
            if p == 0 || last_segment(buf_slice(p)) != sym_text(sym, pcx) {
                continue;
            }
            written.put(sym + 1, 1);
            buf_bytes(add, b"use ");
            written_path(p, add);
            buf_bytes(add, b"; ");
        }
        if buf_slice(add).len() > 0
            && crate::tools::translate::put_first(import_at(pcx.toks[first as usize].start, e),
                buf_slice(add), tr, pcx) {
            tr.counts[TC_IMPORT as usize] += 1;
        }
    }
}

// Where a file's imports go (path_edits, row_imports): at its first item,
// after its leading comments, on that item's line (no line moves); past
// the `embed` items that start the file, as fmt reads an embedded block's
// text as it is only when its item starts the line. at: the first token;
// e: the file's end. at itself when the file has nothing after them.
fn import_at(at: i64, e: i64) -> i64 {
    let src = get_src();
    let mut p = at;
    loop {
        let mut q = p;
        if crate::tools::translate::word_here(q, b"pub") {
            q += 3;
            while q < e && crate::tools::translate::is_ws(src[q as usize]) {
                q += 1;
            }
        }
        if !crate::tools::translate::word_here(q, b"embed") {
            return p;
        }
        // (to the item's end: its block's matching `}`, or `;` for `from`)
        while q < e && src[q as usize] != b'{' && src[q as usize] != b';' {
            q += 1;
        }
        if q < e && src[q as usize] == b'{' {
            let mut d: i64 = 0;
            while q < e {
                if src[q as usize] == b'/' && q + 1 < e && src[(q + 1) as usize] == b'/' {
                    while q < e && src[q as usize] != b'\n' {
                        q += 1;
                    }
                    continue;
                }
                if src[q as usize] == b'{' {
                    d += 1;
                } else if src[q as usize] == b'}' {
                    d -= 1;
                    if d == 0 {
                        break;
                    }
                }
                q += 1;
            }
        }
        if q >= e {
            return at;
        }
        q += 1;
        // (and the blank lines and comments after it)
        loop {
            while q < e && crate::tools::translate::is_ws(src[q as usize]) {
                q += 1;
            }
            if q + 1 < e && src[q as usize] == b'/' && src[(q + 1) as usize] == b'/' {
                while q < e && src[q as usize] != b'\n' {
                    q += 1;
                }
            } else {
                break;
            }
        }
        if q >= e {
            return at;
        }
        p = q;
    }
}
