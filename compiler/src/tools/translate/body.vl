// (0.27.3) The translator's bodies (mod.vl, pass 3): locals, the borrows
// and accesses MVS makes of names written as Rust's `&x`, `&mut x`, `*r`,
// and the spellings that differ (`v.len`, `println(x)`, `static var`, an
// i64 literal's annotation).

use crate::base::{IntVec, buf_bytes, buf_new, buf_slice, buf_str, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{CONV_NEW, NodeKind, child};
use crate::front::check::is_std_named;
use crate::front::lexer::Tok;
use crate::front::types::{REF_MUT, TY_I64, TY_I8, TY_ISIZE, TY_U64, TY_U8, TyKind};
use crate::middle::lower::ssa::HMap;
use crate::tools::translate::{
    D_REF, TC_BORROW, TC_BYTES, TC_CHAR, TC_DEREF, TC_INOUT_LOCAL, TC_INT, TC_LEN, TC_MUT_MARKER,
    TC_PRINT, TC_STATIC, TC_USIZE, TC_UTF8, TC_VAR, TC_VIEW, TC_WIDEN, TL_BYTES, Tr, add_ref,
    editable, enclosing_fn, ident_char, is_mut_ref, is_ref, is_ws, left, own_node, parent_of, put,
    put_first, ref_binding, skip_ws, token_at, word_here, written_name,
};

// The symbol of the name node n is written as (its token's), or 0.
fn name_sym(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = token_at(pcx.nodes[n as usize].start, pcx);
    if k < 0 || pcx.toks[k as usize].kind != Tok::Ident
        || pcx.toks[k as usize].end != pcx.nodes[n as usize].end {
        return 0;
    }
    pcx.toks[k as usize].value as i64
}

// Whether node n is a name that is a reference binding where it is.
fn names_ref(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let s = name_sym(n, pcx);
    s != 0 && ref_binding(s, pcx.nodes[n as usize].start, tr)
}

// Whether node n is argument 0 of a call that starts where it does (the
// receiver of a method call: Rust borrows and dereferences it itself).
fn receiver_of(n: i64, p: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[p as usize].kind;
    (k == NodeKind::Call || k == NodeKind::MethodCall) && pcx.nodes[p as usize].count > 0
        && child(p, 0, pcx) == n && pcx.nodes[p as usize].start == pcx.nodes[n as usize].start
}

// ---- Locals ----

// `var x = e;` is `let mut x = e;`, `inout r = &e;` is `let r = &mut e;`
// (r a reference binding for the rest of its function); an unannotated
// binding of an i64 literal gets `: i64` (the rust edition's literal
// default is i32, FL6).
fn edit_let(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    let pat = pcx.nodes[n as usize].a;
    if word_here(s, b"var") {
        put(s, s + 3, b"let mut", TC_VAR, tr, pcx);
    } else if word_here(s, b"inout") {
        put(s, s + 5, b"let", TC_INOUT_LOCAL, tr, pcx);
        if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind {
            let f = enclosing_fn(s, pcx);
            let to = if f > 0 { pcx.nodes[f as usize].end } else { pcx.nodes[n as usize].end };
            add_ref(pcx.nodes[n as usize].end, to, pcx.nodes[pat as usize].a, tr);
        }
    } else if !word_here(s, b"let") {
        return;
    }
    let init = pcx.nodes[n as usize].c;
    // (0.27.6) `let f = fs[i];` of an element that is not Copy: MVS's copy
    // of a view, which nothing writes, is a reference, `&fs[i]` (Rust's
    // index moves out of the Vec: borrowck.move_out)
    // (through the checker's own borrow of the element, not written)
    let mut el = init;
    while el > 0 && pcx.nodes[el as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[el as usize].start as usize] != b'&'
        && get_src()[pcx.nodes[el as usize].start as usize] != b'*' {
        el = pcx.nodes[el as usize].b;
    }
    if word_here(s, b"let") && pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind
        && pcx.nodes[n as usize].b == 0 && el > 0 && pcx.nodes[el as usize].kind == NodeKind::Index
        && pcx.nodes[el as usize].ty > 0
        && pcx.types[pcx.nodes[el as usize].ty as usize].kind != TyKind::Slice
        && !crate::front::conv::copyable(pcx.nodes[el as usize].ty, pcx) {
        put(pcx.nodes[el as usize].start, pcx.nodes[el as usize].start, b"&", TC_BORROW, tr, pcx);
    }
    if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind && pcx.nodes[n as usize].b == 0
        && init > 0
        && pcx.nodes[init as usize].ty == TY_I64 && literal_only(init, 0, pcx) {
        put(pcx.nodes[pat as usize].end, pcx.nodes[pat as usize].end, b": i64", TC_INT, tr, pcx);
    }
}

// Whether expression n is made of integer literals alone (its type comes
// from them), or an `if` with a branch that is.
fn literal_only(n: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if n <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Int {
        return pcx.nodes[n as usize].b == 0;
    }
    if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Minus {
        return literal_only(pcx.nodes[n as usize].b, depth + 1, pcx);
    }
    if k == NodeKind::Binary {
        return literal_only(pcx.nodes[n as usize].b, depth + 1, pcx)
            && literal_only(pcx.nodes[n as usize].c, depth + 1, pcx);
    }
    // (an `if` one branch of which is, `if c { 1 } else { n }`: the rust
    // edition does not yet take its type from a later use, as rustc does)
    if k == NodeKind::If {
        return pcx.nodes[n as usize].c > 0 && (literal_only(pcx.nodes[n as usize].b, depth + 1, pcx)
            || literal_only(pcx.nodes[n as usize].c, depth + 1, pcx));
    }
    if k == NodeKind::Block {
        return pcx.nodes[n as usize].a > 0 && literal_only(pcx.nodes[n as usize].a, depth + 1, pcx);
    }
    false
}

// `var x` in a pattern is `mut x`.
fn edit_pat_bind(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    if pcx.nodes[n as usize].b != 0 && word_here(s, b"var") {
        put(s, s + 3, b"mut", TC_VAR, tr, pcx);
    }
}

// `for inout x in e` is `for x in &mut e`: x a reference binding in the
// loop.
fn edit_for(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    if !word_here(s, b"for") {
        return;
    }
    let w = skip_ws(s + 3);
    if !word_here(w, b"inout") {
        return;
    }
    let pat = pcx.nodes[n as usize].b;
    let p = skip_ws(w + 5);
    // (the `in` after the pattern)
    let mut q = if pat > 0 { pcx.nodes[pat as usize].end } else { p };
    while q < pcx.nodes[n as usize].end
        && !(word_here(q, b"in") && !ident_char(get_src()[(q - 1) as usize])) {
        q += 1;
    }
    if q >= pcx.nodes[n as usize].end {
        return;
    }
    let e = skip_ws(q + 2);
    if put(w, p, b"", TC_INOUT_LOCAL, tr, pcx) {
        put(e, e, b"&mut ", -1, tr, pcx);
        if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind {
            add_ref(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
                pcx.nodes[pat as usize].a, tr);
        }
    }
}

// `for x in v` over a view or a reference (`xs: [i64]`, a let `v: Vec`),
// whose items Rust gives as `&T`: a copy item is `for &x in v`, as MVS
// copies it; (0.27.5) the same over a call that gives a view, `for v in
// m.values("cache")` (`&[&str]`: `&&str` items without the `&`), a Vec's
// view of its items among them (`for t in omegas.as_slice()`). (The
// checker lowers the loop: its pattern and its iterable, a name or a
// call, which a method call's lowering may make a block, are found by
// their places.)
fn edit_for_copy(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    if !word_here(s, b"for") || token_at(s, pcx) < 0 {
        return;
    }
    let ps = skip_ws(s + 3);
    if word_here(ps, b"inout") || word_here(ps, b"var") {
        return;
    }
    let mut pe = ps;
    while ident_char(get_src()[pe as usize]) {
        pe += 1;
    }
    let is = skip_ws(pe);
    if pe == ps || !word_here(is, b"in") {
        return;
    }
    let vs = skip_ws(is + 2);
    let mut ve = vs;
    while ident_char(get_src()[ve as usize]) {
        ve += 1;
    }
    if ve == vs {
        return;
    }
    // (a name, or a call: the text up to the body's `{` outside brackets)
    let mut call = false;
    if get_src()[skip_ws(ve) as usize] != b'{' {
        let mut depth: i64 = 0;
        let mut q = ve;
        while q < get_src().len() as i64 && !(depth == 0 && get_src()[q as usize] == b'{') {
            if get_src()[q as usize] == b'(' || get_src()[q as usize] == b'[' {
                depth += 1;
            } else if get_src()[q as usize] == b')' || get_src()[q as usize] == b']' {
                depth -= 1;
            }
            else if depth == 0 && (get_src()[q as usize] == b';' || get_src()[q as usize] == b'}') {
                return;
            }
            q += 1;
        }
        while q > ve
            && (get_src()[(q - 1) as usize] == b' ' || get_src()[(q - 1) as usize] == b'\n') {
            q -= 1;
        }
        if q <= ve || get_src()[(q - 1) as usize] != b')' {
            return;
        }
        ve = q;
        call = true;
    }
    let mut pat: i64 = 0;
    let mut it: i64 = 0;
    for m in n + 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[m as usize].kind;
        if pat == 0 && k == NodeKind::PatBind && pcx.nodes[m as usize].start == ps
            && pcx.nodes[m as usize].end == pe {
            pat = m;
        }
        if it == 0
            && (!call && k == NodeKind::Ident
                || call
                && (k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::Block))
            && pcx.nodes[m as usize].start == vs && pcx.nodes[m as usize].end == ve {
            it = m;
        }
        if pat > 0 && it > 0
            || pcx.nodes[m as usize].start > pcx.nodes[n as usize].end && m > n + 64 {
            break;
        }
    }
    if pat == 0 || it == 0 {
        return;
    }
    let et = pcx.nodes[pat as usize].ty;
    let t = pcx.nodes[it as usize].ty;
    if et <= 0 || !crate::front::conv::copyable(et, pcx) || is_ref(et, pcx) || t <= 0 {
        return;
    }
    if call && pcx.types[t as usize].kind == TyKind::Slice
        || !call
        && (pcx.types[t as usize].kind == TyKind::Slice || is_ref(t, pcx)
            || names_ref(it, *tr, pcx)) {
        put(ps, ps, b"&", TC_BORROW, tr, pcx);
    }
}

// ---- Borrows and accesses ----

// Whether place e's root is a local bound by `let` (not `var`): its
// address is a shared one.
fn let_root(e: i64, pcx: &Ctx<Comp>) -> bool {
    let d = root_decl(e, pcx);
    d > 0 && pcx.nodes[d as usize].kind == NodeKind::Let
        && pcx.nodes[pcx.nodes[d as usize].a as usize].b == 0
        && !word_here(pcx.nodes[d as usize].start, b"var")
}

// Whether place e's root is a local bound by `var`.
fn var_root(e: i64, pcx: &Ctx<Comp>) -> bool {
    let d = root_decl(e, pcx);
    d > 0 && pcx.nodes[d as usize].kind == NodeKind::Let
        && word_here(pcx.nodes[d as usize].start, b"var")
}

// Whether place e can be lent `&mut` in the rust edition: a `var`
// local's, or a part of what a raw pointer or a `&mut` points to (an
// inout parameter's, `cx.inst_cap`; `*af`; `cc.rel` of a `let cc: *C`),
// not a `let`'s, a parameter's own or a static's.
fn place_mut(e: i64, pcx: &Ctx<Comp>) -> bool {
    let mut r = e;
    while r > 0 {
        let k = pcx.nodes[r as usize].kind;
        if k == NodeKind::Unary && pcx.nodes[r as usize].op == Tok::Star {
            let b = pcx.nodes[r as usize].b;
            let t: i64 = if b > 0 { pcx.nodes[b as usize].ty } else { 0 };
            return t > 0 && pcx.types[t as usize].kind == TyKind::Ptr
                && (pcx.types[t as usize].b == 0 || pcx.types[t as usize].b == REF_MUT);
        }
        if k == NodeKind::FieldAccess || k == NodeKind::Index || k == NodeKind::TupleField {
            let b = pcx.nodes[r as usize].a;
            let t: i64 = if b > 0 { pcx.nodes[b as usize].ty } else { 0 };
            if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
                return pcx.types[t as usize].b == 0 || pcx.types[t as usize].b == REF_MUT;
            }
            r = b;
            continue;
        }
        if k == NodeKind::Ident {
            return var_root(r, pcx);
        }
        return false;
    }
    false
}

// Whether e is an element of a raw pointer, `p[i]`, whose address
// `&p[i]` the translation writes `p.add(i)` (edit_ptr_index).
fn ptr_element(e: i64, pcx: &Ctx<Comp>) -> bool {
    let b: i64 = if pcx.nodes[e as usize].kind == NodeKind::Index { pcx.nodes[e as usize].a }
        else { 0 };
    let t: i64 = if b > 0 { pcx.nodes[b as usize].ty } else { 0 };
    t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0
}

// Whether place e is a part of a `let` local or a by-value parameter
// itself (not through a pointer or a reference), and its binding is made
// `mut` for a `&mut` of it: `let mut k`, `fn f(mut x: T)`.
fn owned_binding(e: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) -> bool {
    let mut r = e;
    while r > 0 && (pcx.nodes[r as usize].kind == NodeKind::FieldAccess
        || pcx.nodes[r as usize].kind == NodeKind::Index
        || pcx.nodes[r as usize].kind == NodeKind::TupleField) {
        let b = pcx.nodes[r as usize].a;
        let t: i64 = if b > 0 { pcx.nodes[b as usize].ty } else { 0 };
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            return false;
        }
        r = b;
    }
    if r <= 0 || pcx.nodes[r as usize].kind != NodeKind::Ident {
        return false;
    }
    let d = root_decl(r, pcx);
    if d <= 0 {
        return false;
    }
    if pcx.nodes[d as usize].kind == NodeKind::Let {
        let pat = pcx.nodes[d as usize].a;
        if pat <= 0 || pcx.nodes[pat as usize].kind != NodeKind::PatBind
            || !word_here(pcx.nodes[d as usize].start, b"let")
            || pcx.nodes[r as usize].ty <= 0
            || pcx.types[pcx.nodes[r as usize].ty as usize].kind == TyKind::Ptr {
            return false;
        }
        put(pcx.nodes[pat as usize].start, pcx.nodes[pat as usize].start, b"mut ", TC_VAR, tr, pcx);
        return true;
    }
    // (a parameter by value, written with its name first)
    let tn = pcx.nodes[d as usize].b;
    let name = crate::base::sym_text(pcx.nodes[d as usize].a, pcx);
    if pcx.nodes[d as usize].kind != NodeKind::Param || tn <= 0
        || pcx.nodes[tn as usize].kind == NodeKind::TyPtr
        || !word_here(pcx.nodes[d as usize].start, name) || pcx.nodes[r as usize].ty <= 0
        || pcx.types[pcx.nodes[r as usize].ty as usize].kind == TyKind::Ptr {
        return false;
    }
    put(pcx.nodes[d as usize].start, pcx.nodes[d as usize].start, b"mut ", TC_VAR, tr, pcx);
    true
}

// The declaration of place e's root in its function, a Param or a Let
// (the nearest before it), or 0 (a static, a constant).
fn root_decl(e: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut r = e;
    while r > 0 && (pcx.nodes[r as usize].kind == NodeKind::FieldAccess
        || pcx.nodes[r as usize].kind == NodeKind::Index
        || pcx.nodes[r as usize].kind == NodeKind::TupleField) {
        r = pcx.nodes[r as usize].a;
    }
    if r <= 0 || pcx.nodes[r as usize].kind != NodeKind::Ident {
        return 0;
    }
    let pos = pcx.nodes[r as usize].start;
    let f = enclosing_fn(pos, pcx);
    if f <= 0 {
        return 0;
    }
    let mut best: i64 = 0;
    for n in 1..pcx.nodes.len() as i64 {
        let s = pcx.nodes[n as usize].start;
        if s < pcx.nodes[f as usize].start || s >= pos
            || best > 0 && s <= pcx.nodes[best as usize].start {
            continue;
        }
        let k = pcx.nodes[n as usize].kind;
        let named = k == NodeKind::Param && pcx.nodes[n as usize].a == pcx.nodes[r as usize].a
            || k == NodeKind::Let && pcx.nodes[n as usize].a > 0
            && pcx.nodes[pcx.nodes[n as usize].a as usize].kind == NodeKind::PatBind
            && pcx.nodes[pcx.nodes[n as usize].a as usize].a == pcx.nodes[r as usize].a;
        if named {
            best = n;
        }
    }
    best
}

// Whether place e's root is a parameter of its function (immutable in
// Rust unless written `mut`).
fn root_is_param(e: i64, pcx: &Ctx<Comp>) -> bool {
    let mut r = e;
    while r > 0 && (pcx.nodes[r as usize].kind == NodeKind::FieldAccess
        || pcx.nodes[r as usize].kind == NodeKind::Index
        || pcx.nodes[r as usize].kind == NodeKind::TupleField) {
        r = pcx.nodes[r as usize].a;
    }
    if r <= 0 || pcx.nodes[r as usize].kind != NodeKind::Ident {
        return false;
    }
    let f = enclosing_fn(pcx.nodes[r as usize].start, pcx);
    if f <= 0 {
        return false;
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Param
            && pcx.nodes[n as usize].a == pcx.nodes[r as usize].a
            && pcx.nodes[n as usize].start > pcx.nodes[f as usize].start
            && pcx.nodes[n as usize].start < pcx.nodes[r as usize].start
            && enclosing_fn(pcx.nodes[n as usize].start, pcx) == f {
            return true;
        }
    }
    false
}

// Whether Index node e is an array's element (not a raw pointer's, a
// view's or a Vec's): `&w[0]` is a place in the array itself.
fn array_element(e: i64, pcx: &Ctx<Comp>) -> bool {
    let a = pcx.nodes[e as usize].a;
    let b = pcx.nodes[e as usize].b;
    a > 0 && b > 0 && pcx.nodes[b as usize].kind != NodeKind::Range && pcx.nodes[a as usize].ty > 0
        && pcx.types[pcx.nodes[a as usize].ty as usize].kind == TyKind::Array
}

// A written Unary `&` (`&x`, MVS's inout marker): `&mut x`, or `x` when x
// is a reference already (lent on: a reborrow); `x` too when it is given
// to a raw pointer.
fn edit_amp(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].ty;
    let operand = pcx.nodes[n as usize].b;
    // (a parenthesized one, `(&w[0]) as *u8`, starts at its `(`)
    let mut s = pcx.nodes[n as usize].start;
    while operand > 0 && s < pcx.nodes[operand as usize].start
        && (get_src()[s as usize] == b'(' || get_src()[s as usize] == b' ') {
        s += 1;
    }
    let inner = skip_ws(s + 1);
    // (an array's address cast to a raw pointer, `&a as *u8`: its first
    // element's, `a.as_mut_ptr() as *mut u8`; Rust casts no `&[T; N]` to
    // an element pointer)
    let c = parent_of(n, *tr);
    if get_src()[s as usize] == b'&' && get_src()[(s + 1) as usize] != b'&' && c > 0
        && pcx.nodes[c as usize].kind == NodeKind::Cast && pcx.nodes[c as usize].a == n
        && operand > 0 && pcx.nodes[operand as usize].ty > 0
        && pcx.types[pcx.nodes[operand as usize].ty as usize].kind == TyKind::Array
        && pcx.nodes[c as usize].ty > 0
        && pcx.types[pcx.nodes[c as usize].ty as usize].kind == TyKind::Ptr
        && pcx.types[pcx.nodes[c as usize].ty as usize].b == 0 {
        let after = if word_here(inner, b"mut") { skip_ws(inner + 3) } else { inner };
        if put(s, after, b"", TC_MUT_MARKER, tr, pcx) {
            put(pcx.nodes[operand as usize].end, pcx.nodes[operand as usize].end,
                if let_root(operand, pcx) { b".as_ptr()" } else { b".as_mut_ptr()" }, TC_MUT_MARKER,
                tr, pcx);
        }
        return;
    }
    // (a local's address cast to another pointee, `&x as *f64` of an i64:
    // `&raw const x as *mut f64`, `&raw mut` for a `var`; Rust casts no
    // `&mut i64` to a `*mut f64`)
    if get_src()[s as usize] == b'&' && get_src()[(s + 1) as usize] != b'&' && c > 0
        && pcx.nodes[c as usize].kind == NodeKind::Cast && pcx.nodes[c as usize].a == n
        && operand > 0 && pcx.nodes[operand as usize].ty > 0
        && (pcx.nodes[operand as usize].kind == NodeKind::Ident
            || pcx.nodes[operand as usize].kind == NodeKind::FieldAccess
            || pcx.nodes[operand as usize].kind == NodeKind::Index && array_element(operand, pcx))
        && pcx.nodes[c as usize].ty > 0
        && pcx.types[pcx.nodes[c as usize].ty as usize].kind == TyKind::Ptr
        && pcx.types[pcx.nodes[c as usize].ty as usize].b == 0
        && pcx.types[pcx.nodes[c as usize].ty as usize].a != pcx.nodes[operand as usize].ty
        && !access_to_ref(operand, *tr, pcx) {
        let after = if word_here(inner, b"mut") { skip_ws(inner + 3) } else { inner };
        let shared = let_root(operand, pcx) || root_is_param(operand, pcx);
        put(s, after, if shared { b"&raw const " } else { b"&raw mut " }, TC_MUT_MARKER, tr, pcx);
        return;
    }
    // (the address of a reference's referent, MVS's `&cx` given to a `*T`
    // when cx is inout: the `&mut` itself, which Rust coerces to `*mut T`)
    if get_src()[s as usize] == b'&' && get_src()[(s + 1) as usize] != b'&' && t > 0
        && pcx.types[t as usize].kind == TyKind::Ptr
        && pcx.types[t as usize].b == 0 && operand > 0 && access_to_ref(operand, *tr, pcx) {
        put(s, inner, b"", TC_MUT_MARKER, tr, pcx);
        return;
    }
    // (0.27.7) a mutable place's address given where a raw pointer goes,
    // MVS's `&m` to a `*[u8]` out parameter, `&cx.inst_cap` of an inout cx:
    // `&mut m`, which Rust coerces to `*mut T` (rustc coerces a `&T` only
    // to a `*const T`, E0308; place_mut). A `let`'s or a parameter's own
    // place (not through a pointer) is `&mut x` too, its binding made
    // `mut` (owned_binding): the callee may write through the pointer, and
    // a write through one made from `&raw const x` is undefined. A static's,
    // or a place behind a shared reference, keeps its `&` (a `static
    // mut`'s reference is Rust 2024's error)
    if get_src()[s as usize] == b'&' && get_src()[(s + 1) as usize] != b'&' && t > 0
        && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0 && operand > 0
        && !word_here(inner, b"mut")
        && !(c > 0 && pcx.nodes[c as usize].kind == NodeKind::Cast) && !ptr_element(operand, pcx) {
        if place_mut(operand, pcx) {
            // (before a deref put there, `&mut (*p.add(i)).f`)
            put_first(s + 1, b"mut ", tr, pcx);
            return;
        }
        if !access_to_ref(operand, *tr, pcx) && owned_binding(operand, tr, pcx) {
            put_first(s + 1, b"mut ", tr, pcx);
            return;
        }
    }
    if get_src()[s as usize] != b'&' || get_src()[(s + 1) as usize] == b'&'
        || !is_mut_ref(t, pcx) && !mut_slice(t, pcx) {
        return;
    }
    if operand > 0 && access_to_ref(operand, *tr, pcx) {
        put(s, inner, b"", TC_MUT_MARKER, tr, pcx);
    } else if !word_here(inner, b"mut") {
        put(s + 1, s + 1, b"mut ", TC_MUT_MARKER, tr, pcx);
    }
}

fn mut_slice(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t as usize].kind == TyKind::Slice
        && pcx.types[t as usize].b == crate::front::types::REF_MUT
}

// (0.27.6) Whether parameter type t is taken `&mut`: written `inout`
// (`inout [u32]`, `inout T`), `&mut` (std::arch's `vst1q_u32(s: &mut
// [u32], ..)`), or a `&T` reference type.
fn mut_param_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let s = pcx.nodes[t as usize].start;
    word_here(s, b"inout") || get_src()[s as usize] == b'&' && word_here(skip_ws(s + 1), b"mut")
        || pcx.nodes[t as usize].kind == NodeKind::TyPtr && get_src()[s as usize] != b'*'
}

// Whether n is a reference in the rust edition already: the checker's
// access to a reference (a name: a let parameter that borrows, an inout
// parameter or local, a closure's reference parameter, a binding of a
// pattern on a reference), or an expression of a view type.
fn access_to_ref(n: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    if n <= 0 {
        return false;
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Star
        && get_src()[pcx.nodes[n as usize].start as usize] != b'*' {
        let o = pcx.nodes[n as usize].b;
        if names_ref(n, tr, pcx) {
            return true;
        }
        return o > 0 && pcx.nodes[o as usize].kind == NodeKind::Ident
            && is_ref(pcx.nodes[o as usize].ty, pcx) && written_name(n, pcx);
    }
    if k == NodeKind::Ident {
        return is_ref(pcx.nodes[n as usize].ty, pcx) || names_ref(n, tr, pcx);
    }
    false
}

// The place block b of an `if` gives, `{ bck.live }` (a name, a field or
// an element): 0 for another.
fn if_branch_place(b: i64, pcx: &Ctx<Comp>) -> i64 {
    if b <= 0 || pcx.nodes[b as usize].kind != NodeKind::Block || pcx.nodes[b as usize].count != 0 {
        return 0;
    }
    // (the checker's borrow of it: what it borrows)
    let mut t = pcx.nodes[b as usize].a;
    if t > 0 && pcx.nodes[t as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[t as usize].start as usize] != b'&' {
        t = pcx.nodes[t as usize].b;
    }
    if t > 0
        && (pcx.nodes[t as usize].kind == NodeKind::Ident
            || pcx.nodes[t as usize].kind == NodeKind::FieldAccess
            || pcx.nodes[t as usize].kind == NodeKind::Index) {
        t
    } else {
        0
    }
}

// A call of the program's function: each argument its parameter takes by
// reference (D_REF: a let parameter of a type MVS does not copy) is
// written `&e`, unless it is one already.
fn edit_call_args(c: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // (0.28.0: a call of a local, a closure or a function value, `f(x)`
    // of an `f: F` or an `f: fn(..)`)
    let callee: i64 = if pcx.nodes[c as usize].kind == NodeKind::Call { pcx.nodes[c as usize].a }
        else { 0 };
    let value = callee > 0 && pcx.nodes[callee as usize].kind == NodeKind::Ident
        && pcx.nodes[callee as usize].res != crate::front::check::Res::Fn
        && (pcx.nodes[callee as usize].res == crate::front::check::Res::Local
            || callee_fn_type(c, *tr, pcx) > 0);
    let mut f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        if value {
            value_call_args(c, tr, pcx);
        }
        return;
    }
    if pcx.fns[f as usize].tmpl > 0 {
        f = pcx.fns[f as usize].tmpl - 1;
    }
    let fnode = pcx.fns[f as usize].node;
    if fnode <= 0 || !editable(pcx.nodes[fnode as usize].start, pcx) {
        if value {
            value_call_args(c, tr, pcx);
        }
        return;
    }
    // (0.28.0: a closure's call, of the function the checker made of it,
    // whose body is the closure's: the closure's parameters)
    let body = pcx.nodes[fnode as usize].c;
    let up: i64 = if body > 0 { parent_of(body, *tr) } else { 0 };
    let owner = if up > 0 && pcx.nodes[up as usize].kind == NodeKind::Closure { up } else { fnode };
    let mut params = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for j in 0..pcx.nodes[owner as usize].count {
        let p = child(owner, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param {
            params.push(p);
        }
    }
    for i in 0..pcx.nodes[c as usize].count {
        if i >= params.count {
            break;
        }
        let mut arg = child(c, i, pcx);
        if pcx.nodes[arg as usize].kind == NodeKind::NamedArg {
            arg = pcx.nodes[arg as usize].b;
        }
        // (a closure's parameter written `let T`: `&T`, sig.vl's types)
        let p = params.get(i);
        let by_ref = if owner != fnode {
            pcx.nodes[p as usize].b > 0
                && word_here(pcx.nodes[pcx.nodes[p as usize].b as usize].start, b"let")
        } else { tr.decided.get(p + 1) == D_REF };
        if arg <= 0 || !by_ref {
            continue;
        }
        borrow_arg(c, arg, tr, pcx);
    }
}

// (0.28.0) The arguments of a call of a function value, a parameter typed
// `fn(let T)` or a generic `F: Fn(let T)` (no function of the program the
// checker names): one the type writes `let T` (`&T` in the translation) is
// borrowed as a function's is, `f(1)` -> `f(&1)`; so is one the checker
// borrows.
fn value_call_args(c: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let ft = callee_fn_type(c, *tr, pcx);
    for i in 0..pcx.nodes[c as usize].count {
        let mut arg = child(c, i, pcx);
        if arg > 0 && pcx.nodes[arg as usize].kind == NodeKind::NamedArg {
            arg = pcx.nodes[arg as usize].b;
        }
        let q: i64 = if ft > 0 && i < pcx.nodes[ft as usize].count { child(ft, i, pcx) } else { 0 };
        if arg > 0
            && (q > 0
                && (word_here(pcx.nodes[q as usize].start, b"let")
                    || let_before(pcx.nodes[q as usize].start))
                || pcx.nodes[arg as usize].kind == NodeKind::Unary
                && pcx.nodes[arg as usize].op == Tok::Amp
                && get_src()[pcx.nodes[arg as usize].start as usize] != b'&'
                && pcx.nodes[arg as usize].b > 0) {
            borrow_arg(c, arg, tr, pcx);
        }
    }
}

// Whether the word before position s is `let` (a fn type's parameter
// `let T`, whose node starts at T).
fn let_before(s: i64) -> bool {
    let mut q = s - 1;
    while q > 0 && is_ws(get_src()[q as usize]) {
        q -= 1;
    }
    word_back(q, b"let")
}

// (0.28.0) The fn type written for call c's callee, a parameter of the
// function around it: `f: fn(let T) -> U`, or `f: F` with `F: Fn(let T)` in
// its generics; 0 when none is.
fn callee_fn_type(c: i64, tr: Tr, pcx: &Ctx<Comp>) -> i64 {
    let callee = pcx.nodes[c as usize].a;
    if callee <= 0 || pcx.nodes[callee as usize].kind != NodeKind::Ident {
        return 0;
    }
    // (the function the call is written in, by its parents: an instance
    // the checker made of a generic one has no generics)
    let mut f = parent_of(c, tr);
    while f > 0 && pcx.nodes[f as usize].kind != NodeKind::Fn {
        f = parent_of(f, tr);
    }
    if f <= 0 {
        return 0;
    }
    for j in 0..pcx.nodes[f as usize].count {
        let p = child(f, j, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param
            || pcx.nodes[p as usize].a != pcx.nodes[callee as usize].a {
            continue;
        }
        let tn = pcx.nodes[p as usize].b;
        if tn <= 0 {
            return 0;
        }
        if pcx.nodes[tn as usize].kind == NodeKind::TyFn {
            return tn;
        }
        let g = pcx.nodes[f as usize].g;
        if pcx.nodes[tn as usize].kind != NodeKind::TyName || g <= 0
            || pcx.nodes[g as usize].kind != NodeKind::Generics {
            return 0;
        }
        for i in 0..pcx.nodes[g as usize].count {
            let tp = child(g, i, pcx);
            let h = pcx.nodes[tp as usize].h;
            if pcx.nodes[tp as usize].a != pcx.nodes[tn as usize].a || h <= 0
                || pcx.nodes[h as usize].kind != NodeKind::Generics {
                continue;
            }
            for k in 0..pcx.nodes[h as usize].count {
                let b = child(h, k, pcx);
                if pcx.nodes[b as usize].kind == NodeKind::TyFn {
                    return b;
                }
            }
        }
        return 0;
    }
    0
}

// Argument arg of call c, to a `&T` parameter: written `&arg`, unless it is
// a reference already.
fn borrow_arg(c: i64, arg: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // (a method's receiver: Rust borrows it itself; an argument the
    // checker made, a contract's check's, at the call)
    if pcx.nodes[arg as usize].start <= pcx.nodes[c as usize].start
        || pcx.nodes[arg as usize].end > pcx.nodes[c as usize].end {
        return;
    }
    // (the checker's borrow: what it borrows)
    let mut e = arg;
    if pcx.nodes[e as usize].kind == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Amp
        && get_src()[pcx.nodes[e as usize].start as usize] != b'&' {
        e = pcx.nodes[e as usize].b;
    }
    if e <= 0 || access_to_ref(e, *tr, pcx) || pcx.nodes[e as usize].kind == NodeKind::Closure
        || is_ref(pcx.nodes[e as usize].ty, pcx)
        && get_src()[pcx.nodes[e as usize].start as usize] == b'&'
        || token_at(pcx.nodes[arg as usize].start, pcx) < 0 {
        return;
    }
    // (an `if` of two places, `if c { bck.dlive } else { bck.live }`:
    // each branch borrowed, `&if ..` would move out of them)
    if pcx.nodes[e as usize].kind == NodeKind::If
        && if_branch_place(pcx.nodes[e as usize].b, pcx) > 0
        && if_branch_place(pcx.nodes[e as usize].c, pcx) > 0 {
        let x = if_branch_place(pcx.nodes[e as usize].b, pcx);
        let y = if_branch_place(pcx.nodes[e as usize].c, pcx);
        put(pcx.nodes[x as usize].start, pcx.nodes[x as usize].start, b"&", TC_BORROW, tr, pcx);
        put(pcx.nodes[y as usize].start, pcx.nodes[y as usize].start, b"&", TC_BORROW, tr, pcx);
        return;
    }
    put(pcx.nodes[arg as usize].start, pcx.nodes[arg as usize].start, b"&", TC_BORROW, tr, pcx);
}

// The checker's access to a reference r, used as its value: `*r` where
// Rust does not dereference it itself (an assignment's target, a copy's
// read), as it is in a field, an index, a method's receiver. (0.28.0) A
// field of a reference type too, MVS's `n: inout i64` (`&'a mut i64`):
// `c.n += 1` -> `*c.n += 1`.
fn edit_deref(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    if get_src()[s as usize] == b'*'
        || !(written_name(n, pcx) && access_to_ref(n, *tr, pcx) || ref_field(n, pcx)) {
        return;
    }
    let p = parent_of(n, *tr);
    if p > 0 {
        let pk = pcx.nodes[p as usize].kind;
        if pk == NodeKind::FieldAccess && pcx.nodes[p as usize].a == n
            || pk == NodeKind::TupleField && pcx.nodes[p as usize].a == n
            || pk == NodeKind::Index && pcx.nodes[p as usize].a == n || receiver_of(n, p, pcx)
            || pk == NodeKind::Unary && pcx.nodes[p as usize].op == Tok::Amp {
            return;
        }
        if pk == NodeKind::Assign && pcx.nodes[p as usize].b == n {
            put(s, s, b"*", TC_DEREF, tr, pcx);
            return;
        }
    }
    let t = pcx.nodes[n as usize].ty;
    if t > 0 && crate::front::conv::copyable(t, pcx) && !is_ref(t, pcx)
        && pcx.types[t as usize].kind != TyKind::Slice {
        put(s, s, b"*", TC_DEREF, tr, pcx);
    }
}

// (0.28.0) Whether n is the checker's access to a field of a reference
// type, written `x.f` (its deref, no `*` in the text, of a field access
// that ends at the field's name).
fn ref_field(n: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[n as usize].kind != NodeKind::Unary || pcx.nodes[n as usize].op != Tok::Star {
        return false;
    }
    let o = pcx.nodes[n as usize].b;
    if o <= 0 || pcx.nodes[o as usize].kind != NodeKind::FieldAccess
        || !is_ref(pcx.nodes[o as usize].ty, pcx)
        || pcx.nodes[o as usize].start != pcx.nodes[n as usize].start
        || pcx.nodes[o as usize].end != pcx.nodes[n as usize].end {
        return false;
    }
    let k = token_at(pcx.nodes[o as usize].end - 1, pcx);
    k >= 0 && pcx.toks[k as usize].kind == Tok::Ident
        && pcx.toks[k as usize].end == pcx.nodes[o as usize].end
}

// A view of a part, `v[a..b]` (MVS: a `[T]` of v's elements), is `&v[a..b]`
// (`&mut` for an inout one), unless written so.
fn edit_view(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].ty;
    let b = pcx.nodes[n as usize].b;
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Slice || b <= 0
        || pcx.nodes[b as usize].kind != NodeKind::Range
        || token_at(pcx.nodes[n as usize].start, pcx) < 0 {
        return;
    }
    let s = pcx.nodes[n as usize].start;
    let mut q = s - 1;
    while q > 0 && is_ws(get_src()[q as usize]) {
        q -= 1;
    }
    let p = parent_of(n, *tr);
    let pk = if p > 0 { pcx.nodes[p as usize].kind } else { NodeKind::Unit };
    if get_src()[q as usize] == b'&' && !word_back(q, b"mut") && mut_slice(t, pcx)
        && (pk == NodeKind::Block || pk == NodeKind::Return || pk == NodeKind::Let
            || pk == NodeKind::If || pk == NodeKind::Arm) {
        // (0.28.0) MVS's `&v[a..b]` of an inout view given as a value (a
        // function's `-> inout [T]` result, a let's): `&mut v[a..b]`; an
        // argument's is the inout marker, edit_inout_args'
        put(q + 1, q + 1, b"mut ", TC_VIEW, tr, pcx);
        return;
    }
    if get_src()[q as usize] == b'&' || word_back(q, b"mut") {
        return;
    }
    // (a method's receiver, `.len` too: Rust borrows it itself)
    if p > 0 && (receiver_of(n, p, pcx) || (pcx.nodes[p as usize].kind == NodeKind::Index
        || pcx.nodes[p as usize].kind == NodeKind::FieldAccess) && pcx.nodes[p as usize].a == n) {
        return;
    }
    put(s, s, if mut_slice(t, pcx) { b"&mut " } else { b"&" }, TC_VIEW, tr, pcx);
}

// Whether Index node n is a raw pointer's part, `p[a..b]` (MVS slices a
// `*T`): ptr_slice_edits rewrites it once the passes inside it are done.
fn ptr_slice_node(n: i64, pcx: &Ctx<Comp>) -> bool {
    let a = pcx.nodes[n as usize].a;
    let r = pcx.nodes[n as usize].b;
    if a <= 0 || r <= 0 || pcx.nodes[r as usize].kind != NodeKind::Range
        || pcx.nodes[r as usize].b <= 0
        || token_at(pcx.nodes[n as usize].start, pcx) < 0 {
        return false;
    }
    let t = pcx.nodes[a as usize].ty;
    t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0
}

// (0.27.5) Whether SRC[a..b) names w as a whole word.
fn mentions_word(a: i64, b: i64, w: &[u8]) -> bool {
    let mut i = a;
    while i + (w.len() as i64) <= b {
        if &get_src()[i as usize..(i + w.len() as i64) as usize] == w
            && (i == a || !ident_char(get_src()[(i - 1) as usize]))
            && (i + w.len() as i64 == b || !ident_char(get_src()[(i + w.len() as i64) as usize])) {
            return true;
        }
        i += 1;
    }
    false
}

// (0.27.5) An assignment to an element of a container whose index reads
// the container's root, `pcx.files[pcx.files.len() - 1].module = m` or
// `pcx.nodes[child(own, i, pcx)].a = ..`: Rust's IndexMut borrows the
// container mutably before the index is read (rustc E0502), so the index
// is computed first, `{ let at_ix = I; pcx.files[at_ix].module = m }`.
// Run after every other pass: the index moves with its edits.
pub fn hoist_index_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Assign
            || pcx.nodes[n as usize].end <= pcx.nodes[n as usize].start
            || !own_node(n, *tr, pcx) || !editable(pcx.nodes[n as usize].start, pcx) {
            continue;
        }
        let mut t = pcx.nodes[n as usize].b;
        while t > 0 && pcx.nodes[t as usize].kind == NodeKind::FieldAccess {
            t = pcx.nodes[t as usize].a;
        }
        if t <= 0 || pcx.nodes[t as usize].kind != NodeKind::Index {
            continue;
        }
        let mut base = pcx.nodes[t as usize].a;
        let ix = pcx.nodes[t as usize].b;
        // (the checker's view of a Vec indexed, a call around it at its place)
        if base > 0 && pcx.nodes[base as usize].kind == NodeKind::Call
            && pcx.nodes[base as usize].count == 1 {
            let v = child(base, 0, pcx);
            if v > 0 && pcx.nodes[v as usize].start == pcx.nodes[base as usize].start
                && pcx.nodes[v as usize].end == pcx.nodes[base as usize].end {
                base = v;
            }
        }
        if base <= 0 || ix <= 0 || pcx.nodes[ix as usize].kind == NodeKind::Range
            || pcx.nodes[ix as usize].end <= pcx.nodes[ix as usize].start {
            continue;
        }
        // (a struct's IndexMut, a Vec's: not an array's or a slice's)
        let mut bt = pcx.nodes[base as usize].ty;
        if bt > 0 && pcx.types[bt as usize].kind == TyKind::Ptr {
            bt = pcx.types[bt as usize].a;
        }
        if bt <= 0 || pcx.types[bt as usize].kind != TyKind::Struct {
            continue;
        }
        let mut r = base;
        while r > 0 && (pcx.nodes[r as usize].kind == NodeKind::FieldAccess
            || pcx.nodes[r as usize].kind == NodeKind::Index
            || pcx.nodes[r as usize].kind == NodeKind::Unary) {
            // (a borrow the checker made, `&mut p.files`, is its operand's)
            r = if pcx.nodes[r as usize].kind == NodeKind::Unary { pcx.nodes[r as usize].b }
                else { pcx.nodes[r as usize].a };
        }
        if r <= 0 || pcx.nodes[r as usize].kind != NodeKind::Ident {
            continue;
        }
        let a = pcx.nodes[ix as usize].start;
        let b = pcx.nodes[ix as usize].end;
        if !mentions_word(a, b,
            &get_src()[pcx.nodes[r as usize].start as usize..pcx.nodes[r as usize].end as usize]) {
            continue;
        }
        // (no edit that crosses the index, or holds the assignment whole)
        let mut crossed = false;
        for i in 0..pcx.e_start.count {
            let s = pcx.e_start.get(i);
            let e = pcx.e_end.get(i);
            let within = s >= a && e <= b;
            if !within && s < b && a < e
                || s < pcx.nodes[n as usize].start && e > pcx.nodes[n as usize].end {
                crossed = true;
            }
        }
        if crossed {
            continue;
        }
        let text = buf_new();
        buf_bytes(text, b"{ let at_ix = ");
        crate::tools::translate::rows::render(a, b, true, text, pcx);
        buf_bytes(text, b"; ");
        let mut w: i64 = 0;
        for i in 0..pcx.e_start.count {
            let s = pcx.e_start.get(i);
            let e = pcx.e_end.get(i);
            if !(s >= a && e <= b) {
                pcx.e_start.set(w, s);
                pcx.e_end.set(w, e);
                pcx.e_text.set(w, pcx.e_text.get(i));
                w += 1;
            }
        }
        pcx.e_start.count = w;
        pcx.e_end.count = w;
        pcx.e_text.count = w;
        let name = buf_new();
        buf_bytes(name, b"at_ix");
        if crate::tools::edit::edit_replace(a, b, name, pcx) {
            put_first(pcx.nodes[n as usize].start, buf_slice(text), tr, pcx);
            put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, b" }", -1, tr, pcx);
        }
    }
}

// (0.27.6, flip28's T3) A read of an element of a container whose index
// calls a function that takes the container's root `&mut`,
// `pcx.types[place_ty(l, p, pbody, pcx)].kind`: Rust's Index borrows the
// container before the index is computed (rustc E0502), so the index is
// computed first, `{ let at_ix = place_ty(l, p, pbody, pcx);
// pcx.types[at_ix].kind }`, around the first copied value of the
// element (a field of it, or itself), not a place written or borrowed.
// Run after every other pass, with hoist_index_edits.
pub fn hoist_read_index_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Index
            && pcx.nodes[n as usize].end > pcx.nodes[n as usize].start
            && own_node(n, *tr, pcx) && editable(pcx.nodes[n as usize].start, pcx) {
            hoist_read_index(n, tr, pcx);
        }
    }
}

// hoist_read_index_edits' rule on index n.
fn hoist_read_index(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut base = pcx.nodes[n as usize].a;
    let ix = pcx.nodes[n as usize].b;
    // (the checker's view of a Vec indexed, a call around it at its place)
    if base > 0 && pcx.nodes[base as usize].kind == NodeKind::Call
        && pcx.nodes[base as usize].count == 1 {
        let v = child(base, 0, pcx);
        if v > 0 && pcx.nodes[v as usize].start == pcx.nodes[base as usize].start
            && pcx.nodes[v as usize].end == pcx.nodes[base as usize].end {
            base = v;
        }
    }
    if base <= 0 || ix <= 0 || pcx.nodes[ix as usize].kind == NodeKind::Range
        || pcx.nodes[ix as usize].end <= pcx.nodes[ix as usize].start {
        return;
    }
    // (a struct's Index, a Vec's: not an array's or a slice's)
    let mut bt = pcx.nodes[base as usize].ty;
    if bt > 0 && pcx.types[bt as usize].kind == TyKind::Ptr {
        bt = pcx.types[bt as usize].a;
    }
    if bt <= 0 || pcx.types[bt as usize].kind != TyKind::Struct {
        return;
    }
    let mut r = base;
    while r > 0 && (pcx.nodes[r as usize].kind == NodeKind::FieldAccess
        || pcx.nodes[r as usize].kind == NodeKind::Index
        || pcx.nodes[r as usize].kind == NodeKind::Unary) {
        r = if pcx.nodes[r as usize].kind == NodeKind::Unary { pcx.nodes[r as usize].b }
            else { pcx.nodes[r as usize].a };
    }
    if r <= 0 || pcx.nodes[r as usize].kind != NodeKind::Ident
        || !calls_mut_with(ix,
            &get_src()[pcx.nodes[r as usize].start as usize..pcx.nodes[r as usize].end as usize],
            pcx) {
        return;
    }
    // (out to the first value copied: the element, or a field of it)
    let mut e = n;
    let mut p = parent_of(n, *tr);
    while p > 0 && (pcx.nodes[p as usize].kind == NodeKind::FieldAccess
        || pcx.nodes[p as usize].kind == NodeKind::TupleField) && pcx.nodes[p as usize].a == e
        && (pcx.nodes[e as usize].ty <= 0
            || !crate::front::conv::copyable(pcx.nodes[e as usize].ty, pcx)) {
        e = p;
        p = parent_of(p, *tr);
    }
    if pcx.nodes[e as usize].ty <= 0
        || !crate::front::conv::copyable(pcx.nodes[e as usize].ty, pcx) {
        return;
    }
    // (not a place written, borrowed or a method's receiver)
    if p > 0 && (pcx.nodes[p as usize].kind == NodeKind::Assign && pcx.nodes[p as usize].b == e
        || pcx.nodes[p as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[p as usize].start as usize] == b'&'
        || pcx.nodes[p as usize].kind == NodeKind::MethodCall && pcx.nodes[p as usize].a == e) {
        return;
    }
    let a = pcx.nodes[ix as usize].start;
    let b = pcx.nodes[ix as usize].end;
    let s0 = pcx.nodes[e as usize].start;
    let e0 = pcx.nodes[e as usize].end;
    // (no edit that crosses the index, or holds the value whole)
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let t = pcx.e_end.get(i);
        if !(s >= a && t <= b) && s < b && a < t || s < s0 && t > e0 {
            return;
        }
    }
    let text = buf_new();
    let paren = leads_statement(e, *tr, pcx);
    buf_bytes(text, if paren { b"({ let at_ix = " } else { b"{ let at_ix = " });
    crate::tools::translate::rows::render(a, b, true, text, pcx);
    buf_bytes(text, b"; ");
    let mut w: i64 = 0;
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let t = pcx.e_end.get(i);
        if !(s >= a && t <= b) {
            pcx.e_start.set(w, s);
            pcx.e_end.set(w, t);
            pcx.e_text.set(w, pcx.e_text.get(i));
            w += 1;
        }
    }
    pcx.e_start.count = w;
    pcx.e_end.count = w;
    pcx.e_text.count = w;
    let name = buf_new();
    buf_bytes(name, b"at_ix");
    if crate::tools::edit::edit_replace(a, b, name, pcx) {
        put_first(s0, buf_slice(text), tr, pcx);
        put_first(e0, if paren { b" })" } else { b" }" }, tr, pcx);
    }
}

// Whether node e holds a call (not a closure's) that gives the name r to
// a `&mut` parameter.
fn calls_mut_with(e: i64, r: &[u8], pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return false;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Call {
        let f = pcx.nodes[e as usize].x - 1;
        for k in 0..pcx.nodes[e as usize].count {
            let x = arg_behind(child(e, k, pcx), pcx);
            if f >= 0 && f < pcx.fns.len() as i64 && k < pcx.fns[f as usize].param_count && x > 0
                && pcx.nodes[x as usize].kind == NodeKind::Ident
                && get_src()[
                    pcx.nodes[x as usize].start as usize..pcx.nodes[x as usize].end as usize] == r
                && is_mut_ref(crate::front::types::fn_param(f, k, pcx), pcx) {
                return true;
            }
        }
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for k in 0..kids.count {
        if calls_mut_with(kids.get(k), r, pcx) {
            return true;
        }
    }
    false
}

// Whether expression e is the first part of a larger expression that
// starts a statement or a block's value (`f(..) && x`), where a block
// written at e would be a statement of its own: one is parenthesized.
fn leads_statement(e: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let mut c = e;
    let mut p = parent_of(e, tr);
    while p > 0 && pcx.nodes[p as usize].start == pcx.nodes[e as usize].start
        && pcx.nodes[p as usize].kind != NodeKind::Block
        && pcx.nodes[p as usize].kind != NodeKind::ExprStmt {
        c = p;
        p = parent_of(p, tr);
    }
    c != e && p > 0
        && (pcx.nodes[p as usize].kind == NodeKind::Block
            || pcx.nodes[p as usize].kind == NodeKind::ExprStmt)
}

// (0.27.6) A call that takes root r `&mut` (an inout parameter) and
// another argument after it that calls a function with r too, `is_const(cx,
// ir_val(cx, v))`: Rust's reborrow of r for the first argument lives through
// the call's arguments, so the inner call's r is a second mutable borrow
// (rustc E0499, also when the inner parameter is a raw pointer, D3.6).
// Such an argument is computed first, `{ let at_arg1 = ir_val(cx, v);
// is_const(cx, at_arg1) }`, rustc's own suggestion; only when each
// argument before it is plain (a name, a literal, a field of a name), so
// that MVS's left-to-right order is kept. Innermost calls first; run after
// every other pass: the argument moves with its edits.
pub fn hoist_arg_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut calls = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut spans = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Call
            && pcx.nodes[n as usize].end > pcx.nodes[n as usize].start
            && own_node(n, *tr, pcx) && editable(pcx.nodes[n as usize].start, pcx) {
            calls.push(n);
            spans.push(pcx.nodes[n as usize].end - pcx.nodes[n as usize].start);
        }
    }
    // (the shortest first: an inner call's arguments before an outer's)
    let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..calls.count {
        order.push(i);
    }
    let mut i: i64 = 1;
    while i < order.count {
        let mut j = i;
        while j > 0 && spans.get(order.get(j - 1)) > spans.get(order.get(j)) {
            let t = order.get(j - 1);
            order.set(j - 1, order.get(j));
            order.set(j, t);
            j -= 1;
        }
        i += 1;
    }
    for q in 0..order.count {
        hoist_args(calls.get(order.get(q)), tr, pcx);
    }
}

// The argument node behind a borrow (the checker's, or MVS's inout
// marker `&x`) and behind the checker's own deref of a reference
// parameter (`cx` of `cx: inout C` is `*cx`): `x`.
fn arg_behind(a: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e = a;
    if e > 0 && pcx.nodes[e as usize].kind == NodeKind::NamedArg {
        e = pcx.nodes[e as usize].b;
    }
    while e > 0 && pcx.nodes[e as usize].kind == NodeKind::Unary && pcx.nodes[e as usize].b > 0
        && (pcx.nodes[e as usize].op == Tok::Amp
            || pcx.nodes[e as usize].op == Tok::Star
            && get_src()[pcx.nodes[e as usize].start as usize] != b'*') {
        e = pcx.nodes[e as usize].b;
    }
    e
}

// Whether node e is a call (not a closure's) one of whose arguments is
// the name r.
fn calls_with(e: i64, r: &[u8], pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e as usize].kind == NodeKind::Closure {
        return false;
    }
    if pcx.nodes[e as usize].kind == NodeKind::Call
        || pcx.nodes[e as usize].kind == NodeKind::MethodCall {
        for k in 0..pcx.nodes[e as usize].count {
            let x = arg_behind(child(e, k, pcx), pcx);
            if x > 0 && pcx.nodes[x as usize].kind == NodeKind::Ident
                && get_src()[
                    pcx.nodes[x as usize].start as usize..pcx.nodes[x as usize].end as usize] == r {
                return true;
            }
        }
    }
    let mut kids = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    crate::tools::translate::kids_of(e, &mut kids, pcx);
    for k in 0..kids.count {
        if calls_with(kids.get(k), r, pcx) {
            return true;
        }
    }
    false
}

// Whether argument a reads the name r for a value that is copied (not a
// closure, which would capture it): `sym_name(&mut l, l.imports[i])` is
// rustc's E0503 (l used while mutably borrowed), and its value can be
// read first.
fn reads_root(a: i64, r: &[u8], pcx: &mut Ctx<Comp>) -> bool {
    let e = arg_behind(a, pcx);
    r.len() > 0 && e > 0 && pcx.nodes[e as usize].kind != NodeKind::Closure
        && pcx.nodes[e as usize].ty > 0 && pcx.nodes[e as usize].kind != NodeKind::Str
        && mentions_word(pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, r)
        && crate::front::conv::copyable(pcx.nodes[e as usize].ty, pcx)
}

// Whether argument e is plain: its evaluation reads names only (a name,
// a literal, a field of one, a borrow of one).
fn plain_arg(a: i64, pcx: &Ctx<Comp>) -> bool {
    let mut e = arg_behind(a, pcx);
    while e > 0 && (pcx.nodes[e as usize].kind == NodeKind::FieldAccess
        || pcx.nodes[e as usize].kind == NodeKind::TupleField) {
        e = pcx.nodes[e as usize].a;
    }
    if e <= 0 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    k == NodeKind::Ident || k == NodeKind::Int || k == NodeKind::Str || k == NodeKind::Char
        || k == NodeKind::Bool || k == NodeKind::Float || k == NodeKind::Path
}

// hoist_arg_edits' rule on call c.
fn hoist_args(c: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let count = pcx.nodes[c as usize].count;
    // (the first argument a name given to an inout parameter: its root)
    let mut root = &get_src()[0..0];
    let mut at: i64 = -1;
    for k in 0..count {
        let a = child(c, k, pcx);
        if a <= 0 || pcx.nodes[a as usize].kind == NodeKind::NamedArg
            || k >= pcx.fns[f as usize].param_count {
            return;
        }
        let x = arg_behind(a, pcx);
        if at < 0 && x > 0 && pcx.nodes[x as usize].kind == NodeKind::Ident
            && pcx.nodes[x as usize].end > pcx.nodes[x as usize].start
            && is_mut_ref(crate::front::types::fn_param(f, k, pcx), pcx) {
            root = &get_src()[
                pcx.nodes[x as usize].start as usize..pcx.nodes[x as usize].end as usize];
            at = k;
        }
    }
    if at < 0 {
        return;
    }
    // (the arguments after it that call with the root, or read it (in a
    // call of the program's own function, not a lowered print), and the
    // last)
    // (a call of the program's own function, whose root is written
    // `&mut r`: rustc's two-phase reborrow of a reference `r` lets a later
    // argument read it)
    let mut own_fn = pcx.fns[f as usize].node > 0
        && editable(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx);
    if own_fn {
        let ra = child(c, at, pcx);
        let written = buf_new();
        crate::tools::translate::rows::render(pcx.nodes[ra as usize].start,
            pcx.nodes[ra as usize].end, true, written, pcx);
        let w = buf_slice(written);
        own_fn = w.len() >= 5 && w[0..5] == b"&mut ";
    }
    let mut hoist = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for k in at + 1..count {
        let a = child(c, k, pcx);
        if pcx.nodes[a as usize].end > pcx.nodes[a as usize].start
            && (calls_with(a, root, pcx) || own_fn && reads_root(a, root, pcx)) {
            hoist.push(k);
        }
    }
    if hoist.count == 0 {
        return;
    }
    let last = hoist.get(hoist.count - 1);
    let mut h: i64 = 0;
    for k in 0..last {
        if h < hoist.count && hoist.get(h) == k {
            h += 1;
        } else if !plain_arg(child(c, k, pcx), pcx) {
            return;
        }
    }
    // (no edit that crosses an argument hoisted, or holds the call whole)
    let s0 = pcx.nodes[c as usize].start;
    let e0 = pcx.nodes[c as usize].end;
    for i in 0..pcx.e_start.count {
        let s = pcx.e_start.get(i);
        let e = pcx.e_end.get(i);
        if s < s0 && e > e0 {
            return;
        }
        for q in 0..hoist.count {
            let a = child(c, hoist.get(q), pcx);
            let x = pcx.nodes[a as usize].start;
            let y = pcx.nodes[a as usize].end;
            if !(s >= x && e <= y) && s < y && x < e {
                return;
            }
        }
    }
    let text = buf_new();
    let paren = leads_statement(c, *tr, pcx);
    buf_bytes(text, if paren { b"({ " } else { b"{ " });
    for q in 0..hoist.count {
        let k = hoist.get(q);
        let a = child(c, k, pcx);
        let x = pcx.nodes[a as usize].start;
        let y = pcx.nodes[a as usize].end;
        let name = buf_new();
        buf_bytes(name, b"at_arg");
        crate::base::buf_int(name, k);
        buf_bytes(text, b"let ");
        buf_bytes(text, buf_slice(name));
        buf_bytes(text, b" = ");
        crate::tools::translate::rows::render(x, y, true, text, pcx);
        buf_bytes(text, b"; ");
        let mut w: i64 = 0;
        for i in 0..pcx.e_start.count {
            let s = pcx.e_start.get(i);
            let e = pcx.e_end.get(i);
            if !(s >= x && e <= y) {
                pcx.e_start.set(w, s);
                pcx.e_end.set(w, e);
                pcx.e_text.set(w, pcx.e_text.get(i));
                w += 1;
            }
        }
        pcx.e_start.count = w;
        pcx.e_end.count = w;
        pcx.e_text.count = w;
        crate::tools::edit::edit_replace(x, y, name, pcx);
    }
    put_first(s0, buf_slice(text), tr, pcx);
    // (right after the call, before what was put after it: a cast)
    put_first(e0, if paren { b" })" } else { b" }" }, tr, pcx);
}

// (after the statics, mod.vl) A raw pointer's part, `p[a..b]`, is
// `std::slice::from_raw_parts(p.add(a), b - a)` (`_mut` for an inout one,
// `&p[a..b]`, whose `&` it replaces), made of its operands' rewritten text:
// the edits inside it (a `(*q.add(i))`, an `unsafe { }` of a static) are
// folded into the one edit. The innermost first.
pub fn ptr_slice_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut todo = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Index && own_node(n, *tr, pcx)
            && ptr_slice_node(n, pcx) {
            todo.push(n);
        }
    }
    let mut k: i64 = 1;
    while k < todo.count {
        let mut j = k;
        while j > 0 && pcx.nodes[todo.get(j) as usize].end - pcx.nodes[todo.get(j) as usize].start
            < pcx.nodes[todo.get(j - 1) as usize].end - pcx.nodes[todo.get(j - 1) as usize].start {
            let t = todo.get(j);
            { let at_arg2 = todo.get(j - 1); todo.set(j, at_arg2) };
            todo.set(j - 1, t);
            j -= 1;
        }
        k += 1;
    }
    for i in 0..todo.count {
        let n = todo.get(i);
        let a = pcx.nodes[n as usize].a;
        let r = pcx.nodes[n as usize].b;
        let lo = pcx.nodes[r as usize].a;
        let hi = pcx.nodes[r as usize].b;
        let mut s = pcx.nodes[n as usize].start;
        let mut q = s - 1;
        while q > 0 && is_ws(get_src()[q as usize]) {
            q -= 1;
        }
        let lent = get_src()[q as usize] == b'&';
        if lent {
            s = q;
        }
        let lo_text = buf_new();
        if lo > 0 {
            crate::tools::translate::rows::render(pcx.nodes[lo as usize].start,
                pcx.nodes[lo as usize].end, true, lo_text, pcx);
        } else {
            buf_bytes(lo_text, b"0");
        }
        let text = buf_new();
        buf_bytes(text, if lent { b"std::slice::from_raw_parts_mut(" }
            else { b"std::slice::from_raw_parts(" });
        // (of the insertions where p starts, edit_ptr_index's `(*` are p's,
        // moved inside; the others, an `unsafe { ` or a printed view's
        // `str::from_utf8(`, are the context's)
        let mut opens: i64 = 0;
        if pcx.nodes[a as usize].start == s {
            let mut w: i64 = 0;
            for e in 0..pcx.e_start.count {
                let at = pcx.e_start.get(e) == s && pcx.e_end.get(e) == s
                    && buf_slice(pcx.e_text.get(e)) == b"(*";
                if at && editable(s, pcx) {
                    opens += 1;
                } else {
                    pcx.e_start.set(w, pcx.e_start.get(e));
                    pcx.e_end.set(w, pcx.e_end.get(e));
                    pcx.e_text.set(w, pcx.e_text.get(e));
                    w += 1;
                }
            }
            pcx.e_start.count = w;
            pcx.e_end.count = w;
            pcx.e_text.count = w;
        }
        for _ in 0..opens {
            buf_bytes(text, b"(*");
        }
        crate::tools::translate::rows::render(pcx.nodes[a as usize].start,
            pcx.nodes[a as usize].end, pcx.nodes[a as usize].start != s, text, pcx);
        buf_bytes(text, b".add((");
        buf_bytes(text, buf_slice(lo_text));
        buf_bytes(text, b") as usize), (");
        crate::tools::translate::rows::render(pcx.nodes[hi as usize].start,
            pcx.nodes[hi as usize].end, true, text, pcx);
        buf_bytes(text, b" - (");
        buf_bytes(text, buf_slice(lo_text));
        buf_bytes(text, b")) as usize)");
        if !editable(s, pcx) {
            continue;
        }
        crate::tools::translate::rows::drop_inside(s, pcx.nodes[n as usize].end, pcx);
        if crate::tools::edit::edit_replace(s, pcx.nodes[n as usize].end, text, pcx) {
            tr.counts[TC_USIZE as usize] += 1;
        }
    }
}

// (0.28.0) Whether node n is an integer literal tree (literals and
// operators on them): its type the rust edition infers from where it
// goes, not fixes.
fn literal_tree(n: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Int {
        return true;
    }
    if k == NodeKind::Unary {
        return pcx.nodes[n as usize].op == Tok::Minus && literal_tree(pcx.nodes[n as usize].b, pcx);
    }
    if k == NodeKind::Binary {
        return literal_tree(pcx.nodes[n as usize].b, pcx)
            && literal_tree(pcx.nodes[n as usize].c, pcx);
    }
    false
}

// (0.28.0) An integer MVS widened implicitly (a Cast the checker made,
// NODE_IMPLICIT) from a value whose type the rust edition fixes as well
// (a byte read, a call's u32, a u8 local): `as T` written, as rustc
// wants (E0308): `h ^= bytes[i] as u64`, `f(x + y)` -> `f((x + y) as
// i64)`. Not a literal tree (the rust edition infers it), nor an index
// (cast to usize already).
pub fn widen_cast_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Cast
            || (pcx.nodes[n as usize].p & crate::front::ast::NODE_IMPLICIT) == 0 {
            continue;
        }
        let v = pcx.nodes[n as usize].a;
        let from = pcx.nodes[v as usize].ty;
        let to = pcx.nodes[n as usize].ty;
        let ints = from >= crate::front::types::TY_I8 && from <= crate::front::types::TY_ISIZE
            && to >= crate::front::types::TY_I8 && to <= crate::front::types::TY_ISIZE;
        if !ints || from == to || literal_tree(v, pcx) {
            continue;
        }
        let a = pcx.nodes[v as usize].start;
        let b = pcx.nodes[v as usize].end;
        if a >= b || token_at(a, pcx) < 0 || !editable(a, pcx) {
            continue;
        }
        let q = parent_of(n, *tr);
        if q > 0 && pcx.nodes[q as usize].kind == NodeKind::Index && pcx.nodes[q as usize].b == n {
            continue;
        }
        let k = pcx.nodes[v as usize].kind;
        let paren = k == NodeKind::Binary || k == NodeKind::Unary;
        let t = buf_new();
        if paren {
            buf_bytes(t, b")");
        }
        buf_bytes(t, b" as ");
        buf_str(t, crate::front::types::primitive_name(to));
        if put(b, b, buf_slice(t), TC_WIDEN, tr, pcx) && paren {
            put_first(a, b"(", tr, pcx);
        }
    }
}

// Whether node u is the operand of a cast to a raw pointer, `(&x) as *u8`.
fn raw_cast_parent(u: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let c = parent_of(u, tr);
    c > 0 && pcx.nodes[c as usize].kind == NodeKind::Cast && pcx.nodes[c as usize].a == u
        && pcx.nodes[c as usize].ty > 0
        && pcx.types[pcx.nodes[c as usize].ty as usize].kind == TyKind::Ptr
        && pcx.types[pcx.nodes[c as usize].ty as usize].b == 0
}

// A raw pointer's element, `p[i]` (MVS indexes a `*T`), is `(*p.add(i))`
// (rustc E0608: a raw pointer is not indexed), a place as well as a value.
fn edit_ptr_index(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let a = pcx.nodes[n as usize].a;
    let b = pcx.nodes[n as usize].b;
    if a <= 0 || b <= 0 || pcx.nodes[b as usize].kind == NodeKind::Range
        || token_at(pcx.nodes[n as usize].start, pcx) < 0 {
        return;
    }
    let t = pcx.nodes[a as usize].ty;
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Ptr || pcx.types[t as usize].b != 0 {
        return;
    }
    let mut q = pcx.nodes[a as usize].end;
    while q < pcx.nodes[b as usize].start && get_src()[q as usize] != b'[' {
        q += 1;
    }
    let e = pcx.nodes[n as usize].end - 1;
    if q >= pcx.nodes[b as usize].start || get_src()[e as usize] != b']' {
        return;
    }
    // (its address, MVS's `&p[i]` of type `*T`: `p.add(i)`, not a reference)
    // (a parenthesized one starts at its `(`)
    let u = parent_of(n, *tr);
    let mut amp: i64 = if u > 0 { pcx.nodes[u as usize].start } else { 0 };
    while u > 0 && amp < pcx.nodes[n as usize].start
        && (get_src()[amp as usize] == b'(' || get_src()[amp as usize] == b' ') {
        amp += 1;
    }
    if u > 0 && pcx.nodes[u as usize].kind == NodeKind::Unary
        && pcx.nodes[u as usize].op == Tok::Amp && pcx.nodes[u as usize].b == n
        && get_src()[amp as usize] == b'&' && get_src()[(amp + 1) as usize] != b'&'
        && pcx.nodes[u as usize].ty > 0
        && pcx.types[pcx.nodes[u as usize].ty as usize].kind == TyKind::Ptr
        && (pcx.types[pcx.nodes[u as usize].ty as usize].b == 0 || raw_cast_parent(u, *tr, pcx))
        && !word_here(skip_ws(amp + 1), b"mut") {
        // (`(&p[i]) as *u8` too: a borrow MVS casts to a raw pointer)
        if put(amp, skip_ws(amp + 1), b"", TC_USIZE, tr, pcx) {
            put(q, q + 1, b".add(", TC_USIZE, tr, pcx);
            put(e, e + 1, b")", -1, tr, pcx);
        }
        return;
    }
    if put(q, q + 1, b".add(", TC_USIZE, tr, pcx) {
        // (no once-per-place key: `pp[i][j]` opens two at one place)
        let open = crate::base::buf_new();
        crate::base::buf_bytes(open, b"(*");
        crate::tools::edit::edit_replace(pcx.nodes[n as usize].start, pcx.nodes[n as usize].start,
            open, pcx);
        // (not TC_USIZE's key: an index's ` as usize` may end where `]` is)
        put(e, e + 1, b"))", -1, tr, pcx);
    }
}

// An integer index (i64, u64, ..) is `i as usize` (Rust indexes with a usize; until the
// rust edition infers it, FL6), a range's ends too; a literal is left.
fn edit_index(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let b = pcx.nodes[n as usize].b;
    if b <= 0 || token_at(pcx.nodes[n as usize].start, pcx) < 0 {
        return;
    }
    if pcx.nodes[b as usize].kind == NodeKind::Range {
        cast_usize(pcx.nodes[b as usize].a, tr, pcx);
        cast_usize(pcx.nodes[b as usize].b, tr, pcx);
    } else {
        cast_usize(b, tr, pcx);
    }
}

fn cast_usize(e: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // (any integer but usize: MVS indexes with each, `u64` keys of a table)
    let ty: i64 = if e > 0 { pcx.nodes[e as usize].ty } else { 0 };
    if e <= 0 || !(ty >= TY_I8 && ty <= TY_U64 || ty == TY_ISIZE)
        || pcx.nodes[e as usize].kind == NodeKind::Int {
        return;
    }
    let k = pcx.nodes[e as usize].kind;
    let simple = k == NodeKind::Ident || k == NodeKind::Call || k == NodeKind::FieldAccess
        || k == NodeKind::Index || k == NodeKind::TupleField || k == NodeKind::MethodCall
        || k == NodeKind::Path || k == NodeKind::Unary || k == NodeKind::Cast
        || k == NodeKind::Block;
    let s = pcx.nodes[e as usize].start;
    let t = pcx.nodes[e as usize].end;
    if simple {
        put(t, t, b" as usize", TC_USIZE, tr, pcx);
    } else if put(s, s, b"(", TC_USIZE, tr, pcx) {
        put(t, t, b") as usize", TC_USIZE, tr, pcx);
        tr.counts[TC_USIZE as usize] -= 1;
    }
}

fn word_back(q: i64, w: &[u8]) -> bool {
    let n = w.len() as i64;
    q - n + 1 >= 0 && get_src()[(q - n + 1) as usize..(q + 1) as usize] == w
}

// ---- Spellings ----

// `v.len` (a read of std's len, which MVS lets be written without its
// parentheses) is `v.len()`.
fn edit_len(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let e = pcx.nodes[n as usize].end;
    if e < 4 || get_src()[(e - 3) as usize] != b'l' || get_src()[(e - 2) as usize] != b'e'
        || get_src()[(e - 1) as usize] != b'n' || get_src()[(e - 4) as usize] != b'.'
        || get_src()[skip_ws(e) as usize] == b'(' {
        return;
    }
    if pcx.nodes[n as usize].kind == NodeKind::Call {
        // (std's len, not a field of the program's struct)
        // (and a call of len: a call the checker made that ends there, a
        // contract's check of `i < self.len`, is not)
        let f = pcx.nodes[n as usize].x - 1;
        if pcx.nodes[n as usize].a != 0 || pcx.nodes[n as usize].b != tr.sym_len
            || f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f as usize].node > 0
            && editable(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx) {
            return;
        }
    } else {
        // (a slice's or a str's `.len`, MVS's field)
        let b = pcx.nodes[n as usize].a;
        let mut t: i64 = if b > 0 { pcx.nodes[b as usize].ty } else { 0 };
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            t = pcx.types[t as usize].a;
        }
        if t <= 0 || pcx.nodes[n as usize].b != tr.sym_len
            || pcx.types[t as usize].kind != TyKind::Slice
            && pcx.types[t as usize].kind != TyKind::Distinct
            && pcx.types[t as usize].kind != TyKind::Array {
            return;
        }
    }
    put(e, e, b"()", TC_LEN, tr, pcx);
}

// `println(x)` of a value is `println("{}", x)` (print, eprint, eprintln
// too): the rust edition's prints take a format literal first.
fn edit_prints(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for k in 0..pcx.toks.len() as i64 - 2 {
        let t = pcx.toks[k as usize];
        if t.kind != Tok::Ident || pcx.toks[(k + 1) as usize].kind != Tok::LParen
            || !editable(t.start, pcx) {
            continue;
        }
        let w = &get_src()[t.start as usize..t.end as usize];
        if w != b"println" && w != b"print" && w != b"eprintln" && w != b"eprint" {
            continue;
        }
        if k > 0
            && (pcx.toks[(k - 1) as usize].kind == Tok::Dot
                || pcx.toks[(k - 1) as usize].kind == Tok::Fn) {
            continue;
        }
        let next = pcx.toks[(k + 2) as usize].kind;
        if next == Tok::Str || next == Tok::RParen {
            continue;
        }
        put(pcx.toks[(k + 2) as usize].start, pcx.toks[(k + 2) as usize].start, b"\"{}\", ",
            TC_PRINT, tr, pcx);
    }
}

// `static var` is `static mut`.
fn edit_static(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if (pcx.nodes[n as usize].p & CONV_NEW) == 0
        || crate::tools::translate::statics::accessed_decl(n, *tr, pcx) {
        return;
    }
    let mut q = pcx.nodes[n as usize].start;
    while q < pcx.nodes[n as usize].end && !word_here(q, b"static") {
        q += 1;
    }
    let m = skip_ws(q + 6);
    if q < pcx.nodes[n as usize].end && word_here(m, b"var") {
        put(m, m + 3, b"mut", TC_STATIC, tr, pcx);
    }
}

// The parameter of fnode that call c's argument n is given to, or 0.
fn param_of(fnode: i64, c: i64, n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i: i64 = -1;
    for k in 0..pcx.nodes[c as usize].count {
        let a = child(c, k, pcx);
        if a == n
            || a > 0 && pcx.nodes[a as usize].kind == NodeKind::NamedArg
            && pcx.nodes[a as usize].b == n {
            i = k;
        }
    }
    if i < 0 {
        return 0;
    }
    let mut j: i64 = 0;
    for k in 0..pcx.nodes[fnode as usize].count {
        let p = child(fnode, k, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param {
            if j == i {
                return p;
            }
            j += 1;
        }
    }
    0
}

// Whether call c's argument n is given to a parameter of fnode written
// `[T]` (a `str` parameter takes a text literal as it is).
fn param_is_slice(fnode: i64, c: i64, n: i64, pcx: &Ctx<Comp>) -> bool {
    let p = param_of(fnode, c, n, pcx);
    let t: i64 = if p > 0 { pcx.nodes[p as usize].b } else { 0 };
    t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice
}

// Whether call c's argument n is given to a parameter of fnode whose type
// is a type parameter bounded by Display (`x: T`, `T: Display`).
fn param_is_display(fnode: i64, c: i64, n: i64, pcx: &Ctx<Comp>) -> bool {
    let p = param_of(fnode, c, n, pcx);
    let tn: i64 = if p > 0 { pcx.nodes[p as usize].b } else { 0 };
    let g = pcx.nodes[fnode as usize].g;
    if tn <= 0 || pcx.nodes[tn as usize].kind != NodeKind::TyName
        || pcx.nodes[tn as usize].count > 0 || g <= 0
        || pcx.nodes[g as usize].kind != NodeKind::Generics {
        return false;
    }
    for i in 0..pcx.nodes[g as usize].count {
        let tp = child(g, i, pcx);
        let h = pcx.nodes[tp as usize].h;
        if pcx.nodes[tp as usize].a != pcx.nodes[tn as usize].a || h <= 0
            || pcx.nodes[h as usize].kind != NodeKind::Generics {
            continue;
        }
        for j in 0..pcx.nodes[h as usize].count {
            let b = child(h, j, pcx);
            if pcx.nodes[b as usize].kind == NodeKind::TyName
                && word_back(pcx.nodes[b as usize].end - 1, b"Display") {
                return true;
            }
        }
    }
    false
}

// (0.27.5) Whether type node t is written `[u8]` (a slice whose element
// is neither text nor a slice): where a text literal's value is bytes.
fn bytes_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice
        && !str_type_node(pcx.nodes[t as usize].a, pcx)
        && (pcx.nodes[t as usize].a <= 0
            || pcx.nodes[pcx.nodes[t as usize].a as usize].kind != NodeKind::TySlice)
}

// (0.27.5) The type node written where the value of expression e goes, 0
// when none is: a let's, a static's or a constant's annotation, a
// function's result, a parameter's (of a function of the program, or of
// std's method on a receiver declared bytes, `name.ends_with("_in")`), a
// field's; an element of an array or a tuple takes its part of the type
// its literal goes to; a borrow, an `if`'s branch, a match's arm and a
// block's value the type theirs goes to.
fn ctx_type(e: i64, depth: i64, d: TextDecls, tr: Tr, pcx: &mut Ctx<Comp>) -> i64 {
    if e <= 0 || depth > 32 {
        return 0;
    }
    let p = parent_of(e, tr);
    if p <= 0 {
        return 0;
    }
    let pk = pcx.nodes[p as usize].kind;
    if pk == NodeKind::Let || pk == NodeKind::Static || pk == NodeKind::Const {
        return if pcx.nodes[p as usize].c == e { pcx.nodes[p as usize].b } else { 0 };
    }
    if pk == NodeKind::Array {
        let t = ctx_type(p, depth + 1, d, tr, pcx);
        return if t > 0
            && (pcx.nodes[t as usize].kind == NodeKind::TyArray
                || pcx.nodes[t as usize].kind == NodeKind::TySlice) {
            pcx.nodes[t as usize].a
        } else { 0 };
    }
    if pk == NodeKind::Tuple {
        let t = ctx_type(p, depth + 1, d, tr, pcx);
        if t <= 0 || pcx.nodes[t as usize].kind != NodeKind::TyTuple {
            return 0;
        }
        for i in 0..pcx.nodes[p as usize].count {
            if child(p, i, pcx) == e {
                return if i < pcx.nodes[t as usize].count { child(t, i, pcx) } else { 0 };
            }
        }
        return 0;
    }
    if pk == NodeKind::Unary && pcx.nodes[p as usize].op == Tok::Amp {
        return ctx_type(p, depth + 1, d, tr, pcx);
    }
    if pk == NodeKind::Index {
        // (an array given as a slice, `[..]` of it, the checker's)
        let r = pcx.nodes[p as usize].b;
        return if pcx.nodes[p as usize].a == e
            && (r <= 0 || pcx.nodes[r as usize].kind == NodeKind::Range) {
            ctx_type(p, depth + 1, d, tr, pcx)
        } else { 0 };
    }
    if pk == NodeKind::Block {
        if pcx.nodes[p as usize].a != e {
            return 0;
        }
        let q = parent_of(p, tr);
        if q > 0 && pcx.nodes[q as usize].kind == NodeKind::Fn {
            return pcx.nodes[q as usize].b;
        }
        return ctx_type(p, depth + 1, d, tr, pcx);
    }
    if pk == NodeKind::If {
        return if pcx.nodes[p as usize].a != e { ctx_type(p, depth + 1, d, tr, pcx) } else { 0 };
    }
    if pk == NodeKind::Arm {
        return if pcx.nodes[p as usize].c == e { ctx_type(parent_of(p, tr), depth + 1, d, tr, pcx) }
            else { 0 };
    }
    if pk == NodeKind::Return {
        let f = enclosing_fn(pcx.nodes[e as usize].start, pcx);
        return if f > 0 { pcx.nodes[f as usize].b } else { 0 };
    }
    if pk == NodeKind::FieldInit {
        return if pcx.nodes[p as usize].b
            == e { field_type_node(parent_of(p, tr), pcx.nodes[p as usize].a, pcx) }
            else { 0 };
    }
    let c = if pk == NodeKind::NamedArg { parent_of(p, tr) } else { p };
    // (not a call the checker made, which has no width: a print's hole
    // given to std's writer of bytes)
    if c > 0 && pcx.nodes[c as usize].kind == NodeKind::Call
        && pcx.nodes[c as usize].end > pcx.nodes[c as usize].start {
        let mut f = pcx.nodes[c as usize].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return 0;
        }
        if pcx.fns[f as usize].tmpl > 0 {
            f = pcx.fns[f as usize].tmpl - 1;
        }
        let fnode = pcx.fns[f as usize].node;
        let q: i64 = if fnode > 0 { param_of(fnode, c, e, pcx) } else { 0 };
        if q <= 0 {
            return 0;
        }
        // (std's method on bytes, `name.ends_with("_in")`: its receiver is
        // declared bytes, as on a `str` the same method takes text; or on a
        // Vec, `b.extend_from_slice("hey")` of a Vec<u8>: not another
        // struct's, whose call a row may make Rust's, `f.str("--")` of a
        // Fmt to `f.write_str("--")`)
        let r: i64 = if pcx.nodes[c as usize].count > 1 { child(c, 0, pcx) } else { 0 };
        let mut rt: i64 = if r > 0 { pcx.nodes[r as usize].ty } else { 0 };
        if rt > 0 && pcx.types[rt as usize].kind == TyKind::Ptr {
            rt = pcx.types[rt as usize].a;
        }
        let method = r > 0 && r != e && pcx.nodes[r as usize].start == pcx.nodes[c as usize].start
            && pcx.nodes[r as usize].end < pcx.nodes[c as usize].end
            && get_src()[pcx.nodes[r as usize].end as usize] == b'.';
        if editable(pcx.nodes[fnode as usize].start, pcx)
            || method
            && (declared_bytes(r, 0, d, pcx) || rt > 0 && is_std_named(rt, c"Vec", pcx)) {
            return pcx.nodes[q as usize].b;
        }
    }
    0
}

// (0.27.5) The type node of field name of the struct that struct literal
// s makes, 0 when unknown.
fn field_type_node(s: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    if s <= 0 || pcx.nodes[s as usize].kind != NodeKind::StructLit {
        return 0;
    }
    let t = pcx.nodes[s as usize].ty;
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct {
        return 0;
    }
    let si = pcx.types[t as usize].a;
    let sn = pcx.structs[(if pcx.structs[si as usize].tmpl > 0 { pcx.structs[si as usize].tmpl - 1 }
        else { si }) as usize].node;
    for i in 0..if sn > 0 { pcx.nodes[sn as usize].count } else { 0 } {
        let f = child(sn, i, pcx);
        if pcx.nodes[f as usize].kind == NodeKind::Field && pcx.nodes[f as usize].a == name {
            return pcx.nodes[f as usize].b;
        }
    }
    0
}

// (0.27.5) Whether e is an argument of std's Vec method given as its
// element T (`words.push("-c")` of a Vec<[u8]>), checked as `[u8]`: the
// element is bytes where the Vec is declared.
fn vec_element_bytes(e: i64, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    let c = parent_of(e, tr);
    let t: i64 = if e > 0 { pcx.nodes[e as usize].ty } else { 0 };
    if c <= 0 || pcx.nodes[c as usize].kind != NodeKind::Call
        || pcx.nodes[c as usize].end <= pcx.nodes[c as usize].start
        || pcx.nodes[c as usize].count < 2 || t <= 0 || pcx.types[t as usize].kind != TyKind::Slice
        || pcx.types[t as usize].a != TY_U8 {
        return false;
    }
    let mut f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    if pcx.fns[f as usize].tmpl > 0 {
        f = pcx.fns[f as usize].tmpl - 1;
    }
    let fnode = pcx.fns[f as usize].node;
    let q: i64 = if fnode > 0 { param_of(fnode, c, e, pcx) } else { 0 };
    let r = child(c, 0, pcx);
    if q <= 0 || r == e || pcx.nodes[q as usize].b <= 0
        || pcx.nodes[pcx.nodes[q as usize].b as usize].kind != NodeKind::TyName
        || &get_src()[
            pcx.nodes[pcx.nodes[q as usize].b as usize].start as usize..pcx.nodes[
                pcx.nodes[q as usize].b as usize].end as usize] != b"T" {
        return false;
    }
    let mut rt = pcx.nodes[r as usize].ty;
    if rt > 0 && pcx.types[rt as usize].kind == TyKind::Ptr {
        rt = pcx.types[rt as usize].a;
    }
    // (the Vec's element `[u8]`, not `str`, which the argument's erased
    // type does not tell)
    let el: i64 = if rt > 0 { crate::tools::translate::rows::type_arg(rt, 0, pcx) } else { 0 };
    rt > 0 && is_std_named(rt, c"Vec", pcx)
        && pcx.nodes[r as usize].start == pcx.nodes[c as usize].start
        && pcx.nodes[r as usize].end < pcx.nodes[c as usize].end
        && get_src()[pcx.nodes[r as usize].end as usize] == b'.' && el > 0
        && pcx.types[el as usize].kind == TyKind::Slice && pcx.types[el as usize].a == TY_U8
}

// (0.27.5) Whether the value of expression e goes where bytes are
// declared: a place whose type is written `[u8]` (ctx_type), an
// assignment to declared bytes, the other side of `==` or `!=` from them,
// an `if` another branch of which is; through a borrow, an `if`'s
// branches, a match's arms and a block's value. F0.6: `&str` is no
// `&[u8]` in the rust edition (rustc E0308). up: e's place was asked
// already, below.
fn bytes_go(e: i64, up: i64, depth: i64, d: TextDecls, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    if up == 0 && (bytes_type(ctx_type(e, 0, d, tr, pcx), pcx) || vec_element_bytes(e, tr, pcx)) {
        return true;
    }
    if e <= 0 || depth > 32 {
        return false;
    }
    let p = parent_of(e, tr);
    if p <= 0 {
        return false;
    }
    let pk = pcx.nodes[p as usize].kind;
    if pk == NodeKind::Let && pcx.nodes[p as usize].b == 0
        && pcx.nodes[p as usize].start == pcx.nodes[p as usize].end {
        // (the checker's `{ let l = a; let r = b; .. }` of `a == b` on views,
        // equality.vl, rewritten in place: the other side's value)
        let q = parent_of(p, tr);
        if pcx.nodes[p as usize].c != e || q <= 0 || pcx.nodes[q as usize].kind != NodeKind::Block
            || pcx.nodes[q as usize].count < 2 {
            return false;
        }
        let o: i64 = if child(q, 0, pcx) == p { child(q, 1, pcx) }
            else if child(q, 1, pcx) == p { child(q, 0, pcx) } else { 0 };
        if o <= 0 || pcx.nodes[o as usize].kind != NodeKind::Let || pcx.nodes[o as usize].c <= 0 {
            return false;
        }
        // (a print's lowering has such lets too: `==` or `!=` between the two)
        let a = pcx.nodes[pcx.nodes[child(q, 0, pcx) as usize].c as usize].end;
        let b = pcx.nodes[pcx.nodes[child(q, 1, pcx) as usize].c as usize].start;
        let mut i = a;
        while i < b
            && (get_src()[i as usize] == b' ' || get_src()[i as usize] == b'\n'
                || get_src()[i as usize] == b')') {
            i += 1;
        }
        return i + 1 < b && (get_src()[i as usize] == b'=' || get_src()[i as usize] == b'!')
            && get_src()[(i + 1) as usize] == b'='
            && declared_bytes(pcx.nodes[o as usize].c, 0, d, pcx);
    }
    if pk == NodeKind::Unary && pcx.nodes[p as usize].op == Tok::Amp {
        return bytes_go(p, 1, depth + 1, d, tr, pcx);
    }
    if pk == NodeKind::Block {
        return pcx.nodes[p as usize].a == e && bytes_go(p, 1, depth + 1, d, tr, pcx);
    }
    if pk == NodeKind::If {
        if pcx.nodes[p as usize].a == e {
            return false;
        }
        let o = if pcx.nodes[p as usize].b == e { pcx.nodes[p as usize].c }
            else { pcx.nodes[p as usize].b };
        return o > 0 && declared_bytes(o, 0, d, pcx) || bytes_go(p, 1, depth + 1, d, tr, pcx);
    }
    if pk == NodeKind::Arm {
        return pcx.nodes[p as usize].c == e && bytes_go(parent_of(p, tr), 1, depth + 1, d, tr, pcx);
    }
    if pk == NodeKind::Binary
        && (pcx.nodes[p as usize].op == Tok::EqEq || pcx.nodes[p as usize].op == Tok::BangEq) {
        let o = if pcx.nodes[p as usize].b == e { pcx.nodes[p as usize].c }
            else { pcx.nodes[p as usize].b };
        return declared_bytes(o, 0, d, pcx);
    }
    if pk == NodeKind::Assign {
        return pcx.nodes[p as usize].c == e && declared_bytes(pcx.nodes[p as usize].b, 0, d, pcx);
    }
    false
}

// (0.27.5) Whether pattern binding b is the payload of `Some(spec)` (or
// `Ok(spec)`) in an arm of a match on a call whose result is written
// `Option<str>` (`Result<str, ..>`): `w.strip_prefix("--")` of std's str.
fn arm_str_binding(b: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let p = parent_of(b, tr);
    if p <= 0 || pcx.nodes[p as usize].kind != NodeKind::PatVariant
        || pcx.nodes[p as usize].count != 1 {
        return false;
    }
    let arm = parent_of(p, tr);
    if arm <= 0 || pcx.nodes[arm as usize].kind != NodeKind::Arm || pcx.nodes[arm as usize].a != p {
        return false;
    }
    let m = parent_of(arm, tr);
    if m <= 0 || pcx.nodes[m as usize].kind != NodeKind::Match {
        return false;
    }
    let s = pcx.nodes[m as usize].a;
    if s <= 0 || pcx.nodes[s as usize].kind != NodeKind::Call {
        return false;
    }
    let f = pcx.nodes[s as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let fnode = pcx.fns[g as usize].node;
    let r: i64 = if fnode > 0 { pcx.nodes[fnode as usize].b } else { 0 };
    if r <= 0 {
        return false;
    }
    let t = &get_src()[pcx.nodes[r as usize].start as usize..pcx.nodes[r as usize].end as usize];
    t == b"Option<str>" || t.len() > 11 && t[0..11] == b"Result<str,"
}

// (0.27.5) Whether expression e is text where it is declared, positively:
// a binding or parameter written `str` (or initialized from such a
// value), a field declared `str` alone, a call of a function whose result
// is written `str`, a part or a borrow of one; a text literal edit_str
// leaves text (`let m = if w { "7" } else { "15" };`), an `if`, a block or
// a match all of whose values are.
pub fn declared_str(e: i64, depth: i64, d: TextDecls, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    if e <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        let best = bound_at(e, d, pcx);
        if best < 0 {
            return false;
        }
        let b = d.binds.get(best + 3);
        if pcx.nodes[b as usize].kind == NodeKind::PatBind {
            return d.tuples.get(b + 1) == 2 || arm_str_binding(b, tr, pcx);
        }
        if pcx.nodes[b as usize].kind == NodeKind::Param || pcx.nodes[b as usize].b > 0 {
            return str_type_node(pcx.nodes[b as usize].b, pcx);
        }
        return declared_str(pcx.nodes[b as usize].c, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::FieldAccess {
        return d.fields.get(pcx.nodes[e as usize].b + 1) == 1;
    }
    if k == NodeKind::Call {
        let f = pcx.nodes[e as usize].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return false;
        }
        let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
        let fnode = pcx.fns[g as usize].node;
        if fnode <= 0 {
            return false;
        }
        if editable(pcx.nodes[fnode as usize].start, pcx) {
            return str_type_node(pcx.nodes[fnode as usize].b, pcx);
        }
        // (std's method on text, a view of it: `tok.strip_prefix("--")
        // .unwrap()` of a `tok: str`; not its bytes, `as_bytes`)
        let r: i64 = if pcx.nodes[e as usize].count > 0 { child(e, 0, pcx) } else { 0 };
        return r > 0 && pcx.nodes[r as usize].start == pcx.nodes[e as usize].start
            && pcx.nodes[r as usize].end < pcx.nodes[e as usize].end
            && get_src()[pcx.nodes[r as usize].end as usize] == b'.'
            && crate::base::sym_text(pcx.nodes[fnode as usize].a, pcx) != b"as_bytes"
            && declared_str(r, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::Str {
        return get_src()[pcx.nodes[e as usize].start as usize] == b'"'
            && !bytes_go(e, 0, 0, d, tr, pcx);
    }
    if k == NodeKind::If {
        return pcx.nodes[e as usize].c > 0
            && declared_str(pcx.nodes[e as usize].b, depth + 1, d, tr, pcx)
            && declared_str(pcx.nodes[e as usize].c, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::Block {
        return pcx.nodes[e as usize].a > 0
            && declared_str(pcx.nodes[e as usize].a, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::Match {
        let mut arms: i64 = 0;
        for i in 0..pcx.nodes[e as usize].count {
            let arm = child(e, i, pcx);
            if arm <= 0 || pcx.nodes[arm as usize].kind != NodeKind::Arm
                || !declared_str(pcx.nodes[arm as usize].c, depth + 1, d, tr, pcx) {
                return false;
            }
            arms += 1;
        }
        return arms > 0;
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Amp {
        return declared_str(pcx.nodes[e as usize].b, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::Index {
        let r = pcx.nodes[e as usize].b;
        if r > 0 && pcx.nodes[r as usize].kind == NodeKind::Range {
            return declared_str(pcx.nodes[e as usize].a, depth + 1, d, tr, pcx);
        }
        // (an element of a local array of text, `let kws = ["fn ", ..];`
        // then `kws[k]`, or of one written `[str; N]`)
        return elements_str(pcx.nodes[e as usize].a, depth + 1, d, tr, pcx);
    }
    false
}

// (0.27.5) Whether expression a is an array or a slice whose elements are
// text where it is declared: a binding written `[str; N]` or `[str]`, or
// initialized with an array literal of text (`let kws = ["fn ", ..];`), a
// part or a borrow of one (`let names = all[..];`).
fn elements_str(a: i64, depth: i64, d: TextDecls, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    if a <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[a as usize].kind;
    if k == NodeKind::Unary && get_src()[pcx.nodes[a as usize].start as usize] == b'&' {
        return elements_str(pcx.nodes[a as usize].b, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::Index {
        let r = pcx.nodes[a as usize].b;
        return r > 0 && pcx.nodes[r as usize].kind == NodeKind::Range
            && elements_str(pcx.nodes[a as usize].a, depth + 1, d, tr, pcx);
    }
    if k == NodeKind::Array {
        if pcx.nodes[a as usize].count == 0 {
            return false;
        }
        for i in 0..pcx.nodes[a as usize].count {
            if !declared_str(child(a, i, pcx), depth + 1, d, tr, pcx) {
                return false;
            }
        }
        return true;
    }
    if k != NodeKind::Ident {
        return false;
    }
    let best = bound_at(a, d, pcx);
    if best < 0 {
        return false;
    }
    let b = d.binds.get(best + 3);
    if pcx.nodes[b as usize].kind == NodeKind::PatBind {
        return false;
    }
    let t = pcx.nodes[b as usize].b;
    if pcx.nodes[b as usize].kind == NodeKind::Param || t > 0 {
        return t > 0
            && (pcx.nodes[t as usize].kind == NodeKind::TyArray
                || pcx.nodes[t as usize].kind == NodeKind::TySlice)
            && str_type_node(pcx.nodes[t as usize].a, pcx);
    }
    elements_str(pcx.nodes[b as usize].c, depth + 1, d, tr, pcx)
}

// (0.27.5) Whether fn node f's module is std's `name` (`std::fs`).
fn in_std_module(g: i64, name: &[u8], pcx: &Ctx<Comp>) -> bool {
    let m = pcx.fns[g as usize].module;
    m >= 0 && m < pcx.modules.len() as i64 && pcx.modules[m as usize].key >= 0
        && crate::base::sym_text(pcx.modules[m as usize].key, pcx) == name
}

// (0.27.5) A match on a copy value read from a place, with a guard
// (`match pcx.nodes[n].kind { K if f(&mut pcx) => .. }`): Rust keeps the
// scrutinee's place borrowed through the guards (rustc E0502 against the
// guard's `&mut`), so the value is matched, `match { pcx.nodes[n].kind }`.
fn edit_match_copy(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].a;
    if s <= 0 || pcx.nodes[s as usize].end <= pcx.nodes[s as usize].start
        || !editable(pcx.nodes[s as usize].start, pcx) {
        return;
    }
    let k = pcx.nodes[s as usize].kind;
    if k != NodeKind::FieldAccess && k != NodeKind::Index {
        return;
    }
    let t = pcx.nodes[s as usize].ty;
    if t <= 0 || is_ref(t, pcx) || !crate::front::conv::copyable(t, pcx) {
        return;
    }
    let mut guarded = false;
    for i in 0..pcx.nodes[n as usize].count {
        let arm = child(n, i, pcx);
        if arm > 0 && pcx.nodes[arm as usize].kind == NodeKind::Arm
            && pcx.nodes[arm as usize].b > 0 {
            guarded = true;
        }
    }
    if guarded && put_first(pcx.nodes[s as usize].start, b"{ ", tr, pcx) {
        put(pcx.nodes[s as usize].end, pcx.nodes[s as usize].end, b" }", -1, tr, pcx);
    }
}

// (0.27.5) An argument MVS marks `&` for a parameter taken inout whose
// `&` the checker took into its view of an array (`first(&a)`,
// `first(&[1, 2, 3][..])` to `v: inout [i64]`): `&mut`, as Rust's
// `&mut [T]` takes (rustc E0308: types differ in mutability). A written
// Unary `&` is edit_amp's.
fn edit_inout_args(c: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[c as usize].end <= pcx.nodes[c as usize].start {
        return;
    }
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let fnode = pcx.fns[g as usize].node;
    if fnode <= 0 {
        return;
    }
    for i in 0..pcx.nodes[c as usize].count {
        let a = child(c, i, pcx);
        if a <= 0 || pcx.nodes[a as usize].kind == NodeKind::Unary
            || pcx.nodes[a as usize].end <= pcx.nodes[a as usize].start {
            continue;
        }
        let p = param_of(fnode, c, a, pcx);
        let t: i64 = if p > 0 { pcx.nodes[p as usize].b } else { 0 };
        // (`inout [i64]`, a slice type written with its mode; `inout T`;
        // std::arch's `&mut [u32]`)
        if !mut_param_type(t, pcx) {
            continue;
        }
        // (the view starts after the marker: `&` just before it, itself an
        // argument's start, after `(` or `,`; not a `&` operator's)
        let q = pcx.nodes[a as usize].start - 1;
        let mut w = q - 1;
        while w > 0 && get_src()[w as usize] == b' ' {
            w -= 1;
        }
        if q > 0 && get_src()[q as usize] == b'&'
            && (get_src()[w as usize] == b'(' || get_src()[w as usize] == b',') {
            put(q + 1, q + 1, b"mut ", TC_MUT_MARKER, tr, pcx);
        }
    }
}

// (0.27.5) A path given to std::fs as bytes, a value declared `[u8]`
// (MVS's fs takes `path: [u8]`): std2's takes a `&str` until std::path,
// so it is `str::from_utf8(p).unwrap()`. A literal is text already. The
// same for std::process's program and arguments (std2's are &str), and
// for std::num's `parse_f64(s)` and the others (0.27.6: `str::parse`).
fn edit_std_path(c: i64, d: TextDecls, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if tr.text_mode || pcx.nodes[c as usize].end <= pcx.nodes[c as usize].start {
        return;
    }
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let fnode = pcx.fns[g as usize].node;
    let num = in_std_module(g, b"std::num", pcx);
    if fnode <= 0 || editable(pcx.nodes[fnode as usize].start, pcx)
        || !in_std_module(g, b"std::fs", pcx)
        && !in_std_module(g, b"std::process", pcx) && !num {
        return;
    }
    for i in 0..pcx.nodes[c as usize].count {
        let a = child(c, i, pcx);
        let p: i64 = if a > 0 { param_of(fnode, c, a, pcx) } else { 0 };
        if p <= 0 || pcx.nodes[p as usize].b <= 0
            || pcx.nodes[pcx.nodes[p as usize].b as usize].kind != NodeKind::TySlice {
            continue;
        }
        let nm = crate::base::sym_text(pcx.nodes[p as usize].a, pcx);
        let fs = in_std_module(g, b"std::fs", pcx);
        if fs && nm != b"path" && nm != b"from" && nm != b"to" && nm != b"dir"
            || num && nm != b"s" || !fs && !num && nm != b"prog" && nm != b"a" && nm != b"name" {
            continue;
        }
        // (std::process: Command::new, arg and env_remove, whose bytes are
        // any value not written as text: a Vec<[u8]> element, an args_os item)
        if fs && declared_bytes(a, 0, d, pcx)
            || !fs && pcx.nodes[a as usize].kind != NodeKind::Str
            && !declared_str(a, 0, d, *tr, pcx) {
            // (before the view's `&`: `str::from_utf8(&s[a..b])`)
            if num {
                put_first(pcx.nodes[a as usize].start, b"str::from_utf8(", tr, pcx);
            } else {
                put(pcx.nodes[a as usize].start, pcx.nodes[a as usize].start, b"str::from_utf8(",
                    TC_UTF8, tr, pcx);
            }
            put(pcx.nodes[a as usize].end, pcx.nodes[a as usize].end, b").unwrap()", TC_UTF8, tr,
                pcx);
        }
    }
}

// (0.27.5) A value declared `str` given where bytes are declared,
// `int_method(out, p, ..)` of a `p: str` to a `[u8]` parameter: its
// bytes, `p.as_bytes()` (F0.6, rustc E0308).
fn edit_text_to_bytes(n: i64, d: TextDecls, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].ty;
    if tr.text_mode || t <= 0 || pcx.types[t as usize].kind != TyKind::Slice
        || pcx.types[t as usize].a != TY_U8
        || !declared_str(n, 0, d, *tr, pcx) || !bytes_go(n, 0, 0, d, *tr, pcx) {
        return;
    }
    put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, b".as_bytes()", TC_BYTES, tr, pcx);
}

// A text literal MVS types as bytes, `[u8]`, given where the program
// takes bytes (a parameter, the type written for a let, a static or a
// constant, or for its array's elements, a result of `[u8]`) is
// `b".."` (a literal is a str in the rust edition); so is a branch of an
// `if` whose other branch is written or declared bytes, and any literal
// whose value goes where bytes are declared (bytes_go: `s == ".vl"` of
// an `s: [u8]`, a branch, an element, a field, an assignment).
fn edit_str(n: i64, d: TextDecls, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if tr.text_mode {
        return;
    }
    let t = pcx.nodes[n as usize].ty;
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Slice || pcx.types[t as usize].a != TY_U8
        || get_src()[pcx.nodes[n as usize].start as usize] != b'"' {
        return;
    }
    let p = parent_of(n, *tr);
    if p <= 0 {
        return;
    }
    let pk = pcx.nodes[p as usize].kind;
    let mut bytes = false;
    if pk == NodeKind::Call {
        let mut f = pcx.nodes[p as usize].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 {
            if pcx.fns[f as usize].tmpl > 0 {
                f = pcx.fns[f as usize].tmpl - 1;
            }
            let fnode = pcx.fns[f as usize].node;
            bytes = fnode > 0 && editable(pcx.nodes[fnode as usize].start, pcx)
                && param_is_slice(fnode, p, n, pcx);
        }
    } else if pk == NodeKind::Let || pk == NodeKind::Static || pk == NodeKind::Const {
        let ann = pcx.nodes[p as usize].b;
        bytes = ann > 0 && pcx.nodes[ann as usize].kind == NodeKind::TySlice;
    } else if pk == NodeKind::Array {
        // (an element of a static or constant written `[[u8]; N]`)
        let q = parent_of(p, *tr);
        let ann: i64 = if q > 0 && (pcx.nodes[q as usize].kind == NodeKind::Static
            || pcx.nodes[q as usize].kind == NodeKind::Const) { pcx.nodes[q as usize].b }
            else { 0 };
        bytes = ann > 0 && pcx.nodes[ann as usize].kind == NodeKind::TyArray
            && pcx.nodes[ann as usize].a > 0
            && pcx.nodes[pcx.nodes[ann as usize].a as usize].kind == NodeKind::TySlice;
    } else if pk == NodeKind::Block && pcx.nodes[p as usize].a == n && if_other(p, *tr, pcx) > 0 {
        // (a branch of an `if` the other branch of which is bytes,
        // `if c { "" } else { sym_text(s) }`)
        let o = if_other(p, *tr, pcx);
        bytes = written_bytes(if pcx.nodes[o as usize].kind
            == NodeKind::Block { pcx.nodes[o as usize].a } else { o },
            pcx) || declared_bytes(o, 0, d, pcx);
        if !bytes {
            let f = enclosing_fn(pcx.nodes[n as usize].start, pcx);
            let r: i64 = if f > 0 { pcx.nodes[f as usize].b } else { 0 };
            bytes = r > 0 && pcx.nodes[r as usize].kind == NodeKind::TySlice;
        }
    } else if pk == NodeKind::Block && pcx.nodes[p as usize].a == n || pk == NodeKind::Return {
        let f = enclosing_fn(pcx.nodes[n as usize].start, pcx);
        let r: i64 = if f > 0 { pcx.nodes[f as usize].b } else { 0 };
        bytes = r > 0 && pcx.nodes[r as usize].kind == NodeKind::TySlice;
    }
    if !bytes {
        bytes = bytes_go(n, 0, 0, d, *tr, pcx);
    }
    if !bytes {
        return;
    }
    // (0.27.3, FL12: `b".."`, a literal of ASCII; else `"..".as_bytes()`)
    let mut ascii = true;
    for q in pcx.nodes[n as usize].start..pcx.nodes[n as usize].end {
        if get_src()[q as usize] >= 128
            || get_src()[q as usize] == b'\\' && q + 1 < pcx.nodes[n as usize].end
            && get_src()[(q + 1) as usize] == b'u' {
            ascii = false;
        }
    }
    if ascii {
        put(pcx.nodes[n as usize].start, pcx.nodes[n as usize].start, b"b", TC_BYTES, tr, pcx);
    } else {
        put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, b".as_bytes()", TC_BYTES, tr,
            pcx);
    }
}

// (0.27.5) Whether character literal n is the pattern of std's method on
// text, `s.split('|')` of an `s: str`: a char in Rust (a Pattern), not
// the byte MVS types it as.
fn char_pattern(n: i64, d: TextDecls, tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    let c = parent_of(n, tr);
    if c <= 0 || pcx.nodes[c as usize].kind != NodeKind::Call || pcx.nodes[c as usize].count < 2 {
        return false;
    }
    let r = child(c, 0, pcx);
    if r == n || pcx.nodes[r as usize].start != pcx.nodes[c as usize].start
        || pcx.nodes[r as usize].end >= pcx.nodes[c as usize].end
        || get_src()[pcx.nodes[r as usize].end as usize] != b'.' {
        return false;
    }
    let f = pcx.nodes[c as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let fnode = pcx.fns[g as usize].node;
    fnode > 0 && !editable(pcx.nodes[fnode as usize].start, pcx) && declared_str(r, 0, d, tr, pcx)
}

// A character literal MVS types as a byte, `'a'`, is `b'a'`; as a code
// point (u32) `'a' as u32` (a char in the rust edition); as another
// integer `b'a' as i64`; a pattern of std's method on text, `s.split('|')`,
// stays a char.
fn edit_char(n: i64, d: TextDecls, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let s = pcx.nodes[n as usize].start;
    let t = pcx.nodes[n as usize].ty;
    if get_src()[s as usize] != b'\'' || token_at(s, pcx) < 0 {
        return;
    }
    if t == TY_U8 {
        if char_pattern(n, d, *tr, pcx) {
            return;
        }
        put(s, s, b"b", TC_BYTES, tr, pcx);
    } else if t == crate::front::types::TY_U32 {
        put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, b" as u32", TC_BYTES, tr, pcx);
    } else if t >= TY_I8 && t <= TY_U64 || t == TY_ISIZE || t == crate::front::types::TY_USIZE {
        // (another integer's, `c == 'a'` of an i64: the byte, cast)
        let w = buf_new();
        buf_bytes(w, b" as ");
        crate::front::types::buf_type(w, t, pcx);
        // (a code point past ASCII, `'é'`, or `\u{..}`: the char, cast)
        let ascii = get_src()[(s + 1) as usize] < 128
            && !(get_src()[(s + 1) as usize] == b'\\' && get_src()[(s + 2) as usize] == b'u');
        if !ascii || put(s, s, b"b", TC_BYTES, tr, pcx) {
            put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, buf_slice(w), TC_BYTES, tr,
                pcx);
        }
    }
}

// An integer literal MVS types by its context as another type than i64,
// given to a std function (a generic one, `assert_eq(v.len(), 2)`): its
// type as a suffix, `2usize` (the rust edition infers no further).
fn edit_int(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].ty;
    if pcx.nodes[n as usize].b != 0 || t <= 0 || t == TY_I64 || !crate::front::types::is_integer(t)
        || token_at(pcx.nodes[n as usize].start, pcx) < 0 {
        return;
    }
    let k = token_at(pcx.nodes[n as usize].start, pcx);
    if pcx.toks[k as usize].kind != Tok::Int
        || pcx.toks[k as usize].end != pcx.nodes[n as usize].end {
        return;
    }
    let mut p = parent_of(n, *tr);
    if p > 0 && pcx.nodes[p as usize].kind == NodeKind::Unary
        && get_src()[pcx.nodes[p as usize].start as usize] != b'-' {
        p = parent_of(p, *tr);
    }
    if p <= 0 || pcx.nodes[p as usize].kind != NodeKind::Call {
        return;
    }
    let f = pcx.nodes[p as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f as usize].node > 0
        && editable(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx) {
        return;
    }
    let b = crate::base::buf_new();
    crate::front::types::buf_type(b, t, pcx);
    put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, crate::base::buf_slice(b), TC_INT, tr,
        pcx);
}

// An i64 literal outside i32 cast to another type, `0xffffffffffffffff as
// u64`: the rust edition's literal is i32 under a cast (rustc's
// overflowing_literals), so it gets a suffix, `i64`, or `u64` when it is
// written above i64::MAX (MVS's bits, -1 here, which the cast keeps).
fn edit_int_cast(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].b != 0 || pcx.nodes[n as usize].ty != TY_I64
        || token_at(pcx.nodes[n as usize].start, pcx) < 0 {
        return;
    }
    let v = pcx.nodes[n as usize].a;
    if v >= 0 && v <= 2147483647 {
        return;
    }
    let p = parent_of(n, *tr);
    if p <= 0 || pcx.nodes[p as usize].kind != NodeKind::Cast || pcx.nodes[p as usize].a != n {
        return;
    }
    let k = token_at(pcx.nodes[n as usize].start, pcx);
    if pcx.toks[k as usize].kind != Tok::Int
        || pcx.toks[k as usize].end != pcx.nodes[n as usize].end {
        return;
    }
    put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, if v < 0 { b"u64" } else { b"i64" },
        TC_INT, tr, pcx);
}

// (FL6) An i64 literal at a generic position, which the rust edition
// would type by its own default or a later use, gets MVS's i64 as a
// suffix, `1i64`: a value given to a type parameter (`Some(4)`,
// `fold(0, ..)`, `Vec::from_in([1, 2], a)`), a generic struct's field
// (`W { x: 7 }`), a range or literal receiver (`(0..n).map(..)`). (0.27.7,
// T6) Also through a shift's left operand and an operator's left operand
// whose right one is a literal tree, to a receiver: `(1 << n).wrapping_sub(1)`
// is `(1i64 << n)..`, rustc's E0689 (and vole's type.infer) otherwise.
fn edit_int_generic(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if pcx.nodes[n as usize].b != 0 || pcx.nodes[n as usize].ty != TY_I64 {
        return;
    }
    let k = token_at(pcx.nodes[n as usize].start, pcx);
    if k < 0 || pcx.toks[k as usize].kind != Tok::Int
        || pcx.toks[k as usize].end != pcx.nodes[n as usize].end {
        return;
    }
    // (through a sign, an array, a tuple or a range to what takes them)
    let mut c = n;
    let mut p = parent_of(n, *tr);
    while p > 0
        && (pcx.nodes[p as usize].kind == NodeKind::Unary
            && get_src()[pcx.nodes[p as usize].start as usize] == b'-'
            || pcx.nodes[p as usize].kind == NodeKind::Array
            || pcx.nodes[p as usize].kind == NodeKind::Tuple
            || pcx.nodes[p as usize].kind == NodeKind::Range || int_operand(c, p, pcx)) {
        c = p;
        p = parent_of(p, *tr);
    }
    if p <= 0 || !generic_place(c, p, *tr, pcx) {
        return;
    }
    put(pcx.nodes[n as usize].end, pcx.nodes[n as usize].end, b"i64", TC_INT, tr, pcx);
}

// (FL6) An array of literals MVS types as i64 elements, `[1, 2, 3]` or
// `[0; 4]`: its first element's suffix, `[1i64, 2, 3]`, which types them
// all (the rust edition, slicing or lending it, would take i32).
fn edit_int_array(n: i64, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].ty;
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Array || pcx.types[t as usize].a != TY_I64
        || token_at(pcx.nodes[n as usize].start, pcx) < 0
        || get_src()[pcx.nodes[n as usize].start as usize] != b'[' {
        return;
    }
    let first: i64 = if pcx.nodes[n as usize].kind == NodeKind::Repeat { pcx.nodes[n as usize].a }
        else if pcx.nodes[n as usize].count > 0 { child(n, 0, pcx) } else { 0 };
    if first <= 0 || pcx.nodes[first as usize].kind != NodeKind::Int
        || pcx.nodes[first as usize].b != 0 {
        return;
    }
    let k = token_at(pcx.nodes[first as usize].start, pcx);
    if k < 0 || pcx.toks[k as usize].kind != Tok::Int
        || pcx.toks[k as usize].end != pcx.nodes[first as usize].end {
        return;
    }
    put(pcx.nodes[first as usize].end, pcx.nodes[first as usize].end, b"i64", TC_INT, tr, pcx);
}

// Whether field `name` of the generic struct type t is declared with one
// of its type parameters (`struct W<T> { x: T }`: x), which a literal
// there would fix.
fn generic_field(t: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    let si = pcx.types[t as usize].a;
    if pcx.structs[si as usize].tmpl <= 0 {
        return false;
    }
    let sn = pcx.structs[(pcx.structs[si as usize].tmpl - 1) as usize].node;
    let g: i64 = if sn > 0 { pcx.nodes[sn as usize].g } else { 0 };
    if g <= 0 {
        return false;
    }
    for i in 0..pcx.nodes[sn as usize].count {
        let f = child(sn, i, pcx);
        if pcx.nodes[f as usize].kind == NodeKind::Field && pcx.nodes[f as usize].a == name
            && pcx.nodes[f as usize].b > 0 {
            let ft = pcx.nodes[f as usize].b;
            for j in 0..pcx.nodes[g as usize].count {
                if pcx.nodes[ft as usize].kind == NodeKind::TyName
                    && pcx.nodes[child(g, j, pcx) as usize].a == pcx.nodes[ft as usize].a {
                    return true;
                }
            }
        }
    }
    false
}

// (edit_int_generic, T6) Whether c is the left operand of binary p whose
// type it decides: a shift's, or an arithmetic operator's whose right
// operand is a tree of literals.
fn int_operand(c: i64, p: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[p as usize].kind != NodeKind::Binary || pcx.nodes[p as usize].b != c {
        return false;
    }
    let op = pcx.nodes[p as usize].op;
    if op == Tok::Shl || op == Tok::Shr {
        return true;
    }
    int_arith(op) && int_tree(pcx.nodes[p as usize].c, pcx)
}

// Whether e is unsuffixed integer literals under signs and operators (a
// shift by its left operand).
fn int_tree(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Int {
        return pcx.nodes[e as usize].b == 0;
    }
    if k == NodeKind::Unary {
        return get_src()[pcx.nodes[e as usize].start as usize] == b'-'
            && int_tree(pcx.nodes[e as usize].b, pcx);
    }
    if k != NodeKind::Binary {
        return false;
    }
    let op = pcx.nodes[e as usize].op;
    if op == Tok::Shl || op == Tok::Shr {
        return int_tree(pcx.nodes[e as usize].b, pcx);
    }
    int_arith(op) && int_tree(pcx.nodes[e as usize].b, pcx)
        && int_tree(pcx.nodes[e as usize].c, pcx)
}

fn int_arith(op: Tok) -> bool {
    op == Tok::Plus || op == Tok::Minus || op == Tok::Star || op == Tok::Slash
        || op == Tok::Percent || op == Tok::Amp || op == Tok::Pipe || op == Tok::Caret
}

// Whether c, a part of p, is at a generic position of p.
fn generic_place(c: i64, p: i64, tr: Tr, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::VariantLit {
        return true;
    }
    if k == NodeKind::FieldInit {
        let s = parent_of(p, tr);
        let t: i64 = if s > 0 { pcx.nodes[s as usize].ty } else { 0 };
        return t > 0 && pcx.types[t as usize].kind == TyKind::Struct
            && generic_field(t, pcx.nodes[p as usize].a, pcx);
    }
    if k != NodeKind::Call || pcx.nodes[p as usize].a == c {
        return false;
    }
    // (a receiver: `(0..n).map(..)`, `5.max(x)`)
    if pcx.nodes[p as usize].a == 0 && pcx.nodes[p as usize].count > 0 && child(p, 0, pcx) == c {
        return true;
    }
    let f = pcx.nodes[p as usize].x - 1;
    if f < 0 {
        // (a variant's constructor, `Some(4)`)
        return true;
    }
    if f >= pcx.fns.len() as i64 || pcx.fns[f as usize].tmpl <= 0 {
        return false;
    }
    let tn = pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node;
    if tn <= 0 {
        return false;
    }
    // (type parameters of its own, or an impl's that no receiver fixes)
    let g = pcx.nodes[tn as usize].g;
    let own: i64 = if g > 0 { pcx.nodes[g as usize].count - pcx.nodes[g as usize].a } else { 0 };
    let first: i64 = if pcx.nodes[tn as usize].count > 0 { child(tn, 0, pcx) } else { 0 };
    let receiver = first > 0 && pcx.nodes[first as usize].kind == NodeKind::Param
        && pcx.nodes[first as usize].a == tr.sym_self;
    own > 0 || !receiver && g > 0
}

// ---- Text or bytes ----

fn byte_slice(t0: i64, pcx: &Ctx<Comp>) -> bool {
    let mut t = t0;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        t = pcx.types[t as usize].a;
    }
    t > 0 && pcx.types[t as usize].kind == TyKind::Slice && pcx.types[t as usize].a == TY_U8
}

// Whether type t holds bytes as a container: a Vec<u8, A>, a Buf, an array
// of u8.
fn byte_container(t0: i64, pcx: &Ctx<Comp>) -> bool {
    let mut t = t0;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        t = pcx.types[t as usize].a;
    }
    if t <= 0 {
        return false;
    }
    if pcx.types[t as usize].kind == TyKind::Array {
        return pcx.types[t as usize].a == TY_U8;
    }
    crate::front::conv::container_elem(t, pcx) == TY_U8
}

// (the approved rule: `[u8]` is `&str` only when every use agrees) Whether
// the program uses its `[u8]` values as text alone: no byte read by index,
// no loop over one, no view of a byte container (a Vec<u8>'s, an array's),
// no byte method (`iter`, `as_ptr`, `extend_from_slice`).
pub fn text_program(tr: Tr, pcx: &mut Ctx<Comp>) -> bool {
    let mut any = false;
    for n in 1..pcx.nodes.len() as i64 {
        if !own_node(n, tr, pcx) {
            continue;
        }
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::TySlice {
            let e = pcx.nodes[n as usize].a;
            if e > 0
                && get_src()[
                    pcx.nodes[e as usize].start as usize..pcx.nodes[e as usize].end as usize]
                == b"u8" {
                any = true;
            }
        } else if k == NodeKind::Index {
            let b = pcx.nodes[n as usize].a;
            let i = pcx.nodes[n as usize].b;
            let range = i > 0 && pcx.nodes[i as usize].kind == NodeKind::Range;
            if b > 0 && !range && byte_slice(pcx.nodes[b as usize].ty, pcx) {
                return false;
            }
            if b > 0 && range && byte_container(pcx.nodes[b as usize].ty, pcx) {
                return false;
            }
        } else if k == NodeKind::For {
            let c = pcx.nodes[n as usize].c;
            if c > 0 && (byte_slice(pcx.nodes[c as usize].ty, pcx)
                || pcx.nodes[c as usize].kind == NodeKind::Let && pcx.nodes[c as usize].c > 0
                && byte_slice(pcx.nodes[pcx.nodes[c as usize].c as usize].ty, pcx)) {
                return false;
            }
        }
        else if k == NodeKind::Call && pcx.nodes[n as usize].a == 0
            && pcx.nodes[n as usize].count > 0
            && pcx.nodes[n as usize].b > 0 {
            let m = crate::base::sym_text(pcx.nodes[n as usize].b, pcx);
            let r = child(n, 0, pcx);
            if byte_slice(pcx.nodes[r as usize].ty, pcx)
                && (m == b"iter" || m == b"as_ptr" || m == b"to_vec_in"
                    || m == b"get" || m == b"first" || m == b"last") {
                return false;
            }
            if m == b"extend_from_slice"
                || m == b"as_slice" && byte_container(pcx.nodes[r as usize].ty, pcx) {
                return false;
            }
        }
        // (0.27.5) bytes std2 gives as bytes: args_os's items (`&[u8]`),
        // which no `&str` takes
        if k == NodeKind::Call && pcx.nodes[n as usize].x > 0
            && pcx.nodes[n as usize].x <= pcx.fns.len() as i64
            && crate::base::sym_text(pcx.fns[(pcx.nodes[n as usize].x - 1) as usize].name, pcx)
            == b"std.env.args_os" {
            return false;
        }
    }
    any
}

// Whether type node tn is written `str` (a text view: `&str` in the rust
// edition; the checker's type, erased, is `[u8]`).
fn str_type_node(tn: i64, pcx: &Ctx<Comp>) -> bool {
    tn > 0 && pcx.nodes[tn as usize].kind == NodeKind::TyName
        && get_src()[pcx.nodes[tn as usize].start as usize..pcx.nodes[tn as usize].end as usize]
        == b"str"
}

// The program's bindings and fields declared `str` or `[u8]` (what an
// expression's erased `[u8]` type was written as): binds holds from, to,
// name and the Param, Let or PatBind node of each binding, in [from, to) its
// scope (its block or function); fields the field names declared `str`
// (1), `[u8]` (2) or both (3); statics the statics and constants written
// `[u8]` (1) or `[[u8]; N]` (2); tuples a tuple pattern's PatBinds whose
// part of the function's result is written `[u8]` (1) or `str` (2).
#[derive(Clone, Copy)] pub struct TextDecls {
    binds: IntVec, fields: HMap, statics: HMap, tuples: HMap,
}

// (0.27.5) Whether part i of the tuple e makes is a text literal in every
// branch: `if c { ("len()", m) } else { ("", 0) }`, which a tuple pattern
// binds as text.
fn tuple_part_text(e: i64, i: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || depth > 32 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Tuple {
        let c: i64 = if i < pcx.nodes[e as usize].count { child(e, i, pcx) } else { 0 };
        return c > 0 && pcx.nodes[c as usize].kind == NodeKind::Str
            && get_src()[pcx.nodes[c as usize].start as usize] == b'"';
    }
    if k == NodeKind::If {
        return pcx.nodes[e as usize].c > 0
            && tuple_part_text(pcx.nodes[e as usize].b, i, depth + 1, pcx)
            && tuple_part_text(pcx.nodes[e as usize].c, i, depth + 1, pcx);
    }
    if k == NodeKind::Block {
        return tuple_part_text(pcx.nodes[e as usize].a, i, depth + 1, pcx);
    }
    false
}

// (0.27.5) The bindings of let n's tuple pattern pat, `let (word, end) =
// word_at(text, q);`, into d: each with its PatBind node, and in
// d.tuples as the function's result writes its part, `[u8]` (1) or `str`
// (2), or as text (2) when the value is a tuple of text literals there.
fn tuple_decls(n: i64, pat: i64, d: &mut TextDecls, tr: Tr, pcx: &mut Ctx<Comp>) {
    let scope = parent_of(n, tr);
    if scope <= 0 {
        return;
    }
    let init = pcx.nodes[n as usize].c;
    let mut rt: i64 = 0;
    if init > 0 && pcx.nodes[init as usize].kind == NodeKind::Call {
        let f = pcx.nodes[init as usize].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 {
            let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
            let fnode = pcx.fns[g as usize].node;
            let t: i64 = if fnode > 0 { pcx.nodes[fnode as usize].b } else { 0 };
            if t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyTuple {
                rt = t;
            }
        }
    }
    for i in 0..pcx.nodes[pat as usize].count {
        let b = child(pat, i, pcx);
        if b <= 0 || pcx.nodes[b as usize].kind != NodeKind::PatBind {
            continue;
        }
        d.binds.push(pcx.nodes[n as usize].start);
        d.binds.push(pcx.nodes[scope as usize].end);
        d.binds.push(pcx.nodes[b as usize].a);
        d.binds.push(b);
        let part: i64 = if rt > 0 && i < pcx.nodes[rt as usize].count { child(rt, i, pcx) }
            else { 0 };
        if str_type_node(part, pcx) || rt == 0 && tuple_part_text(init, i, 0, pcx) {
            d.tuples.put(b + 1, 2);
        } else if part > 0 && pcx.nodes[part as usize].kind == NodeKind::TySlice {
            d.tuples.put(b + 1, 1);
        }
    }
}

pub fn text_decls(tr: Tr, pcx: &mut Ctx<Comp>) -> TextDecls {
    let mut d = TextDecls {
        binds: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        fields: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        statics: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        tuples: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
    };
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Field {
            let t = pcx.nodes[n as usize].b;
            let w: i64 = if str_type_node(t, pcx) {
                1
            } else if t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice { 2 } else { 0 };
            if w > 0 {
                let key = pcx.nodes[n as usize].a + 1;
                d.fields.put(key, d.fields.get(key) | w);
            }
            continue;
        }
        if k == NodeKind::Static || k == NodeKind::Const {
            // (`SRC[a..b]`, `KNOWN[i]`)
            let t = pcx.nodes[n as usize].b;
            if t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice {
                d.statics.put(pcx.nodes[n as usize].a + 1, 1);
            }
            else if t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyArray
                && pcx.nodes[t as usize].a > 0
                && pcx.nodes[pcx.nodes[t as usize].a as usize].kind == NodeKind::TySlice {
                d.statics.put(pcx.nodes[n as usize].a + 1, 2);
            }
            continue;
        }
        if !own_node(n, tr, pcx) {
            continue;
        }
        let mut name: i64 = -1;
        if k == NodeKind::Param {
            name = pcx.nodes[n as usize].a;
        } else if k == NodeKind::Let {
            let pat = pcx.nodes[n as usize].a;
            if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind {
                name = pcx.nodes[pat as usize].a;
            } else if pat > 0 && pcx.nodes[pat as usize].kind == NodeKind::PatTuple {
                tuple_decls(n, pat, &mut d, tr, pcx);
            }
        } else if k == NodeKind::Arm {
            // (`Some(spec) =>` of a match on an Option<str>: text, in the arm)
            let p = pcx.nodes[n as usize].a;
            let b: i64 = if p > 0 && pcx.nodes[p as usize].kind == NodeKind::PatVariant
                && pcx.nodes[p as usize].count == 1 { child(p, 0, pcx) } else { 0 };
            if b > 0 && pcx.nodes[b as usize].kind == NodeKind::PatBind
                && arm_str_binding(b, tr, pcx) {
                d.binds.push(pcx.nodes[n as usize].start);
                d.binds.push(pcx.nodes[n as usize].end);
                d.binds.push(pcx.nodes[b as usize].a);
                d.binds.push(b);
                d.tuples.put(b + 1, 2);
            }
            continue;
        }
        let scope = parent_of(n, tr);
        if name < 0 || scope <= 0 {
            continue;
        }
        d.binds.push(pcx.nodes[n as usize].start);
        d.binds.push(pcx.nodes[scope as usize].end);
        d.binds.push(name);
        d.binds.push(n);
    }
    d
}

// Whether expression e of the erased type `[u8]` was not written `[u8]`
// where it is declared (a `str`, which is `&str` in the rust edition, or a
// type parameter whose instance has it): a binding (its type, or its
// initializer's), a field, a function's result.
pub fn declared_text(e: i64, depth: i64, d: TextDecls, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || depth > 4 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        let pos = pcx.nodes[e as usize].start;
        let mut best: i64 = -1;
        let mut i: i64 = 0;
        while i + 3 < d.binds.count {
            if d.binds.get(i + 2) == pcx.nodes[e as usize].a && d.binds.get(i) <= pos
                && pos < d.binds.get(i + 1) && (best < 0 || d.binds.get(i) > d.binds.get(best)) {
                best = i;
            }
            i += 4;
        }
        if best < 0 {
            return false;
        }
        let b = d.binds.get(best + 3);
        if pcx.nodes[b as usize].kind == NodeKind::PatBind {
            return d.tuples.get(b + 1) == 2;
        }
        if pcx.nodes[b as usize].kind == NodeKind::Param || pcx.nodes[b as usize].b > 0 {
            let t = pcx.nodes[b as usize].b;
            return t <= 0 || pcx.nodes[t as usize].kind != NodeKind::TySlice;
        }
        return declared_text(pcx.nodes[b as usize].c, depth + 1, d, pcx);
    }
    if k == NodeKind::FieldAccess {
        let name = pcx.nodes[e as usize].b;
        let w = d.fields.get(name + 1);
        if w != 3 {
            return w != 2;
        }
        // (a name declared both ways: the receiver's struct's field)
        let mut t = pcx.nodes[pcx.nodes[e as usize].a as usize].ty;
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
            t = pcx.types[t as usize].a;
        }
        if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct {
            return false;
        }
        let s = pcx.types[t as usize].a;
        let sn = pcx.structs[(if pcx.structs[s as usize].tmpl
            > 0 { pcx.structs[s as usize].tmpl - 1 } else { s }) as usize].node;
        for i in 0..if sn > 0 { pcx.nodes[sn as usize].count } else { 0 } {
            let f = child(sn, i, pcx);
            if pcx.nodes[f as usize].kind == NodeKind::Field && pcx.nodes[f as usize].a == name {
                let t = pcx.nodes[f as usize].b;
                return t <= 0 || pcx.nodes[t as usize].kind != NodeKind::TySlice;
            }
        }
        return false;
    }
    if k == NodeKind::Call {
        let f = pcx.nodes[e as usize].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 {
            let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
            let fnode = pcx.fns[g as usize].node;
            let t: i64 = if fnode > 0 { pcx.nodes[fnode as usize].b } else { 0 };
            return t > 0 && pcx.nodes[t as usize].kind != NodeKind::TySlice;
        }
    }
    false
}

// (0.27.5) The binding in d that Ident e names, its index in d.binds
// (the innermost one whose scope holds e), or -1: a static, a function.
fn bound_at(e: i64, d: TextDecls, pcx: &Ctx<Comp>) -> i64 {
    let pos = pcx.nodes[e as usize].start;
    let mut best: i64 = -1;
    let mut i: i64 = 0;
    while i + 3 < d.binds.count {
        if d.binds.get(i + 2) == pcx.nodes[e as usize].a && d.binds.get(i) <= pos
            && pos < d.binds.get(i + 1) && (best < 0 || d.binds.get(i) > d.binds.get(best)) {
            best = i;
        }
        i += 4;
    }
    best
}

// (0.27.5) Whether branch b of an `if` is a text literal edit_str writes
// `b".."`: its other branch o is a call written `[u8]`
// (`if c { "" } else { sym_text(s) }`) or declared bytes.
fn byte_literal_branch(b: i64, o: i64, depth: i64, d: TextDecls, pcx: &Ctx<Comp>) -> bool {
    if b <= 0 || o <= 0 || pcx.nodes[b as usize].kind != NodeKind::Block {
        return false;
    }
    let t = pcx.nodes[b as usize].a;
    if t <= 0 || get_src()[pcx.nodes[t as usize].start as usize] != b'"' {
        return false;
    }
    written_bytes(if pcx.nodes[o as usize].kind == NodeKind::Block { pcx.nodes[o as usize].a }
        else { o }, pcx)
        || declared_bytes(o, depth + 1, d, pcx)
}

// (0.27.5) Whether expression e of the erased type `[u8]` is bytes where
// it is declared, positively: a binding written `[u8]` (or initialized
// so), a field declared `[u8]`, a call of a function whose result is
// written `[u8]` (or of a function value), a part of such a value or of a
// Vec or a buffer, a block's value that is, a static or constant written
// `[u8]` or an element of one written `[[u8]; N]`, a borrow of such a
// value, an `if` both of whose branches are (or one is and the other a
// literal edit_str writes `b".."`). Not a literal, a pattern's binding
// or an element of a local array of views: they may be text, and `str::from_utf8("..")` is no Rust (0.27.4's gate 2: 230 of
// the rustc twin's rejections).
fn declared_bytes(e: i64, depth: i64, d: TextDecls, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        let best = bound_at(e, d, pcx);
        if best < 0 {
            return d.statics.get(pcx.nodes[e as usize].a + 1) == 1;
        }
        let b = d.binds.get(best + 3);
        if pcx.nodes[b as usize].kind == NodeKind::PatBind {
            return d.tuples.get(b + 1) == 1;
        }
        if pcx.nodes[b as usize].kind == NodeKind::Param || pcx.nodes[b as usize].b > 0 {
            let t = pcx.nodes[b as usize].b;
            return t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice;
        }
        return declared_bytes(pcx.nodes[b as usize].c, depth + 1, d, pcx);
    }
    if k == NodeKind::FieldAccess {
        let w = d.fields.get(pcx.nodes[e as usize].b + 1);
        if w == 2 {
            return true;
        }
        return w == 3 && !declared_text(e, depth, d, pcx);
    }
    if k == NodeKind::Call {
        // (a function value's call, `h(e)`: no declaration to read, bytes as
        // its type says)
        let f = pcx.nodes[e as usize].x - 1;
        return f < 0 || f >= pcx.fns.len() as i64 || written_bytes(e, pcx)
            || vec_element_call(e, pcx);
    }
    if k == NodeKind::Block {
        // (the checker's form of a call such as `nm(e).unwrap()`: its tail;
        // 0.28.0: or what it unwraps, a call of a function written
        // `-> Option<[u8]>`)
        if get_src()[pcx.nodes[e as usize].start as usize] != b'{' {
            for i in 0..pcx.nodes[e as usize].count {
                let s = child(e, i, pcx);
                if s > 0 && pcx.nodes[s as usize].kind == NodeKind::Let
                    && wrapped_bytes(pcx.nodes[s as usize].c, pcx) {
                    return true;
                }
            }
        }
        return pcx.nodes[e as usize].a > 0
            && declared_bytes(pcx.nodes[e as usize].a, depth + 1, d, pcx);
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Amp {
        return declared_bytes(pcx.nodes[e as usize].b, depth + 1, d, pcx);
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star {
        // (what a raw pointer written `*[u8]` points to, `*message`)
        let o = pcx.nodes[e as usize].b;
        let best: i64 = if o > 0
            && pcx.nodes[o as usize].kind == NodeKind::Ident { bound_at(o, d, pcx) }
            else { -1 };
        let b: i64 = if best >= 0 { d.binds.get(best + 3) } else { 0 };
        let t: i64 = if b > 0
            && pcx.nodes[b as usize].kind != NodeKind::PatBind { pcx.nodes[b as usize].b }
            else { 0 };
        return t > 0 && pcx.nodes[t as usize].kind == NodeKind::TyPtr && pcx.nodes[t as usize].a > 0
            && pcx.nodes[pcx.nodes[t as usize].a as usize].kind == NodeKind::TySlice;
    }
    if k == NodeKind::If {
        // (both branches, `if c { &s[1..] } else { s }`, a literal one only
        // where edit_str writes it `b".."`)
        let b = pcx.nodes[e as usize].b;
        let c = pcx.nodes[e as usize].c;
        return c > 0
            && (declared_bytes(b, depth + 1, d, pcx) || byte_literal_branch(b, c, depth, d, pcx))
            && (declared_bytes(c, depth + 1, d, pcx) || byte_literal_branch(c, b, depth, d, pcx));
    }
    if k == NodeKind::Index {
        let a = pcx.nodes[e as usize].a;
        let r = pcx.nodes[e as usize].b;
        if a > 0 && r > 0 && pcx.nodes[r as usize].kind != NodeKind::Range {
            // (an element of a static or constant written `[[u8]; N]`)
            return pcx.nodes[a as usize].kind == NodeKind::Ident && bound_at(a, d, pcx) < 0
                && d.statics.get(pcx.nodes[a as usize].a + 1) == 2;
        }
        if a <= 0 || r <= 0 {
            return false;
        }
        let at = pcx.nodes[a as usize].ty;
        return at > 0 && pcx.types[at as usize].kind != TyKind::Slice
            || declared_bytes(a, depth + 1, d, pcx);
    }
    false
}

// (0.28.0) Whether call e is std's method taking an element out of a Vec,
// `keep.get(i)` (`keep[i]` in the translation), as an index of one is
// (declared_bytes's Index).
fn vec_element_call(e: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.nodes[e as usize].count < 1 || pcx.nodes[e as usize].a != 0 {
        return false;
    }
    let r = child(e, 0, pcx);
    if r <= 0 || pcx.nodes[r as usize].start != pcx.nodes[e as usize].start
        || pcx.nodes[r as usize].end >= pcx.nodes[e as usize].end
        || get_src()[pcx.nodes[r as usize].end as usize] != b'.' {
        return false;
    }
    let m = pcx.nodes[r as usize].end + 1;
    if !(word_here(m, b"get") || word_here(m, b"first") || word_here(m, b"last")
        || word_here(m, b"pop")) {
        return false;
    }
    let mut rt = pcx.nodes[r as usize].ty;
    if rt > 0 && pcx.types[rt as usize].kind == TyKind::Ptr {
        rt = pcx.types[rt as usize].a;
    }
    rt > 0 && is_std_named(rt, c"Vec", pcx)
}

// (0.28.0) Whether e is a call of the program's function whose result is
// written `Option<[u8]>` (or another type whose first argument is `[u8]`).
fn wrapped_bytes(e: i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 || pcx.nodes[e as usize].kind != NodeKind::Call {
        return false;
    }
    let f = pcx.nodes[e as usize].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let fnode = pcx.fns[g as usize].node;
    let t: i64 = if fnode > 0 { pcx.nodes[fnode as usize].b } else { 0 };
    if t <= 0 || pcx.nodes[t as usize].kind != NodeKind::TyName || pcx.nodes[t as usize].g <= 0
        || pcx.nodes[pcx.nodes[t as usize].g as usize].count < 1 {
        return false;
    }
    let a = child(pcx.nodes[t as usize].g, 0, pcx);
    a > 0 && pcx.nodes[a as usize].kind == NodeKind::TySlice
}

// Whether expression e is positively bytes where it is declared: a call of
// a function whose result is written `[u8]`, or a parameter written so.
fn written_bytes(e: i64, pcx: &Ctx<Comp>) -> bool {
    if e <= 0 {
        return false;
    }
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Call {
        let f = pcx.nodes[e as usize].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return false;
        }
        let g = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
        let fnode = pcx.fns[g as usize].node;
        let t: i64 = if fnode > 0 { pcx.nodes[fnode as usize].b } else { 0 };
        return t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice;
    }
    if k != NodeKind::Ident {
        return false;
    }
    let f = enclosing_fn(pcx.nodes[e as usize].start, pcx);
    if f <= 0 {
        return false;
    }
    for j in 0..pcx.nodes[f as usize].count {
        let p = child(f, j, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param
            && pcx.nodes[p as usize].a == pcx.nodes[e as usize].a {
            let t = pcx.nodes[p as usize].b;
            return t > 0 && pcx.nodes[t as usize].kind == NodeKind::TySlice;
        }
    }
    false
}

// The other branch of the `if` that block b is a branch of (0: none).
fn if_other(b: i64, tr: Tr, pcx: &Ctx<Comp>) -> i64 {
    let q = parent_of(b, tr);
    if q <= 0 || pcx.nodes[q as usize].kind != NodeKind::If || pcx.nodes[q as usize].c <= 0 {
        return 0;
    }
    if pcx.nodes[q as usize].b == b {
        pcx.nodes[q as usize].c
    } else if pcx.nodes[q as usize].c == b {
        pcx.nodes[q as usize].b
    } else {
        0
    }
}

// (0.28.0) MVS's `{x:c}`, a byte written as a character: the rust edition
// has no `c` (it prints the number), so the hole is `{x}` and its value
// `x as char` (`x as u8 as char` of a wider integer), as rustc's
// `{}` of a char prints it: a positional argument after the literal is
// wrapped, a name in the literal is `{x_c}` with the named argument
// `x_c = x as char` at the end of its print's call (a `{x}` of the
// same literal prints the number). Another call's (a function's, which
// takes no named argument) or a hole whose value the checker binds
// (`{0:c}` twice) is left as it is.
fn edit_char_holes(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    let mut named = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut calls = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for c in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[c as usize].kind;
        if (k == NodeKind::Call || k == NodeKind::MethodCall) && own_node(c, *tr, pcx) {
            let at = calls.get(pcx.nodes[c as usize].end);
            if at == 0 || pcx.nodes[c as usize].start + 1 < at {
                calls.put(pcx.nodes[c as usize].end, pcx.nodes[c as usize].start + 1);
            }
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::InterpHole
            || (pcx.nodes[n as usize].p & crate::front::ast::FMT_CHAR) == 0
            || !own_node(n, *tr, pcx) {
            continue;
        }
        // (the hole: its name, `x` of `{x:c}`, or the text of a positional
        // one, `:c` of `{:c}`; t its closing brace)
        let s = pcx.nodes[n as usize].start;
        let mut t = pcx.nodes[n as usize].end;
        while t < get_src().len() as i64 && get_src()[t as usize] != b'}'
            && get_src()[t as usize] != b'"' {
            t += 1;
        }
        let e = pcx.nodes[n as usize].a;
        if t >= get_src().len() as i64 || get_src()[t as usize] != b'}' || t - s < 2
            || get_src()[(t - 1) as usize] != b'c' || e <= 0
            || !editable(s, pcx) {
            continue;
        }
        let cut = if get_src()[(t - 2) as usize] == b':' { t - 2 } else { t - 1 };
        let ty = pcx.nodes[e as usize].ty;
        let conv = if ty == TY_U8 { " as char" } else { " as u8 as char" };
        if token_at(pcx.nodes[e as usize].start, pcx) >= 0 {
            // (a positional argument)
            let k = pcx.nodes[e as usize].kind;
            let term = k == NodeKind::Ident || k == NodeKind::Int || k == NodeKind::Char
                || k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Index
                || k == NodeKind::Call || k == NodeKind::MethodCall;
            if put(cut, t, b"", TC_CHAR, tr, pcx) {
                if !term {
                    put_first(pcx.nodes[e as usize].start, b"(", tr, pcx);
                }
                put_first(pcx.nodes[e as usize].end,
                    if term { conv.as_bytes() } else if ty == TY_U8 { b") as char" }
                    else { b") as u8 as char" }, tr, pcx);
            }
            continue;
        }
        // (a name written in the hole, `{x:c}`)
        let mut q = s;
        while q < t && ident_char(get_src()[q as usize]) {
            q += 1;
        }
        if q == s || get_src()[q as usize] != b':' {
            continue;
        }
        let close = literal_call_close(t);
        let s0: i64 = if close >= 0 { calls.get(close + 1) - 1 } else { -1 };
        if s0 < 0 || !(word_here(s0, b"println") || word_here(s0, b"print")
            || word_here(s0, b"eprintln") || word_here(s0, b"eprint")) || !editable(close, pcx) {
            continue;
        }
        // (its own name, `{x_c}`: the hole `{x}` of the same literal prints
        // the number)
        if !put(cut, t, b"_c", TC_CHAR, tr, pcx) {
            continue;
        }
        // (once per name and call)
        let mut key = close;
        for r in s..q {
            key = key * 31 + get_src()[r as usize] as i64;
        }
        if named.get(key) != 0 {
            continue;
        }
        named.put(key, 1);
        let w = buf_new();
        buf_bytes(w, b", ");
        buf_bytes(w, &get_src()[s as usize..q as usize]);
        buf_bytes(w, b"_c = ");
        buf_bytes(w, &get_src()[s as usize..q as usize]);
        buf_bytes(w, conv.as_bytes());
        crate::tools::edit::edit_replace(close, close, w, pcx);
    }
}

// The `)` closing the call whose format literal holds position pos (in
// the literal), or -1: the literal's end, then its call's `)` at depth 0.
fn literal_call_close(pos: i64) -> i64 {
    let n = get_src().len() as i64;
    let mut q = pos;
    while q < n && get_src()[q as usize] != b'"' {
        q += if get_src()[q as usize] == b'\\' { 2 } else { 1 };
    }
    q += 1;
    let mut depth: i64 = 0;
    while q < n {
        let c = get_src()[q as usize];
        if c == b'"' {
            q += 1;
            while q < n && get_src()[q as usize] != b'"' {
                q += if get_src()[q as usize] == b'\\' { 2 } else { 1 };
            }
        }
        else if c == b'\'' && q + 2 < n
            && (get_src()[(q + 2) as usize] == b'\'' || get_src()[(q + 1) as usize] == b'\\') {
            q += if get_src()[(q + 1) as usize] == b'\\' { 3 } else { 2 };
        } else if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            if depth == 0 {
                return if c == b')' { q } else { -1 };
            }
            depth -= 1;
        } else if c == b';' {
            return -1;
        }
        q += 1;
    }
    -1
}

// Whether SRC[a..b) is the one argument of a print of a value,
// `println(x)` (edit_prints gives it its "{}").
fn printed_value(a: i64, b: i64) -> bool {
    let mut e = b;
    while is_ws(get_src()[e as usize]) {
        e += 1;
    }
    let mut q = a - 1;
    while q > 0 && is_ws(get_src()[q as usize]) {
        q -= 1;
    }
    if get_src()[e as usize] != b')' || q < 1 || get_src()[q as usize] != b'(' {
        return false;
    }
    let w = q - 1;
    let len: i64 = if word_back(w, b"eprintln") {
        8
    } else if word_back(w, b"println") {
        7
    } else if word_back(w, b"eprint") {
        6
    } else if word_back(w, b"print") { 5 } else { 0 };
    let s = w - len;
    len > 0 && (s < 0 || !ident_char(get_src()[s as usize]) && get_src()[s as usize] != b'.')
}

// (0.27.5) Whether hole n is an argument only evaluated (HOLE_EVAL, a
// call with named arguments: `format_args("{} {lv}", name(), lv = 2)`)
// that a Display hole of the same literal reads (its alias). The checker
// makes the evaluated arguments' holes in order, then the literal's
// (front/check/format.vl's build), so they are found by node number.
fn eval_hole_display(n: i64, pcx: &Ctx<Comp>) -> bool {
    let eval = crate::front::check::format::HOLE_EVAL;
    if pcx.nodes[n as usize].kind != NodeKind::InterpHole || pcx.nodes[n as usize].b != eval {
        return false;
    }
    let mut v: i64 = 0;
    while n - v - 1 > 0 && pcx.nodes[(n - v - 1) as usize].kind == NodeKind::InterpHole
        && pcx.nodes[(n - v - 1) as usize].b == eval {
        v += 1;
    }
    let mut aliases = false;
    let mut j = n + 1;
    while j < pcx.nodes.len() as i64 && j < n + 256 {
        if pcx.nodes[j as usize].kind == NodeKind::InterpHole {
            let b = pcx.nodes[j as usize].b;
            if b == eval {
                if aliases {
                    return false;
                }
            } else if b >= 1024 {
                aliases = true;
                if b / 1024 - 1 == v && (b & 1) == 0 {
                    return true;
                }
            } else {
                return false;
            }
        }
        j += 1;
    }
    false
}

// (0.27.4) A `[u8]` value a program that uses bytes as bytes too prints
// as text (a Display hole, `{x}` or `{}`): Rust's [u8] has no Display, so
// the hole is given `str::from_utf8(x).unwrap()` (MVS's text is UTF-8;
// a byte sequence that is not panics where MVS wrote it), when it is
// bytes where it is declared (declared_bytes: not a literal). A name in the
// literal gets the named argument `x = ..` at the end of the literal's
// call; an argument after the literal is wrapped. One declared `str` is
// a `&str` already; any other is left to hand (TL_BYTES).
fn edit_byte_holes(decls: TextDecls, tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    if tr.text_mode {
        return;
    }
    let mut named = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    // (0.27.6: each call's start + 1 by its end, the outermost's)
    let mut calls = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for c in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[c as usize].kind;
        if (k == NodeKind::Call || k == NodeKind::MethodCall) && own_node(c, *tr, pcx) {
            let at = calls.get(pcx.nodes[c as usize].end);
            if at == 0 || pcx.nodes[c as usize].start + 1 < at {
                calls.put(pcx.nodes[c as usize].end, pcx.nodes[c as usize].start + 1);
            }
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        // (a hole, or the value of `println(x)`, which is `println("{}", x)`)
        let hole = pcx.nodes[n as usize].kind == NodeKind::InterpHole
            && pcx.nodes[n as usize].b == 0
            || eval_hole_display(n, pcx);
        if !hole
            && !(pcx.nodes[n as usize].ty > 0
                && get_src()[pcx.nodes[n as usize].start as usize] != b'"'
                && token_at(pcx.nodes[n as usize].start, pcx) >= 0
                && printed_value(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end))
            || !own_node(n, *tr, pcx) {
            continue;
        }
        let e = if hole { pcx.nodes[n as usize].a } else { n };
        if e <= 0 || !byte_slice(pcx.nodes[e as usize].ty, pcx)
            || !editable(pcx.nodes[e as usize].start, pcx)
            || !declared_bytes(e, 0, decls, pcx) {
            continue;
        }
        let a = pcx.nodes[e as usize].start;
        let b = pcx.nodes[e as usize].end;
        if token_at(a, pcx) >= 0 {
            if put(a, a, b"str::from_utf8(", TC_UTF8, tr, pcx) {
                put_first(b, b").unwrap()", tr, pcx);
            }
            continue;
        }
        let close: i64 = if pcx.nodes[e as usize].kind == NodeKind::Ident { literal_call_close(b) }
            else { -1 };
        if close < 0 {
            left(a, TL_BYTES, tr, pcx);
            continue;
        }
        // (once per name and call)
        let mut key = close;
        for q in a..b {
            key = key * 31 + get_src()[q as usize] as i64;
        }
        if named.get(key) != 0 {
            continue;
        }
        named.put(key, 1);
        // (0.27.6) a function's or a method's call, `write(&mut out,
        // "{what}")`, takes no named argument (only print's and its kind
        // do): `{ let what = str::from_utf8(what).unwrap(); CALL }`
        let s0 = calls.get(close + 1) - 1;
        if s0 >= 0 && !word_here(s0, b"println") && !word_here(s0, b"print")
            && !word_here(s0, b"eprintln") && !word_here(s0, b"eprint") {
            let open = buf_new();
            buf_bytes(open, b"{ let ");
            buf_bytes(open, &get_src()[a as usize..b as usize]);
            buf_bytes(open, b" = str::from_utf8(");
            buf_bytes(open, &get_src()[a as usize..b as usize]);
            buf_bytes(open, b").unwrap(); ");
            let shut = buf_new();
            buf_bytes(shut, b" }");
            if editable(s0, pcx) && crate::tools::edit::edit_replace(s0, s0, open, pcx)
                && crate::tools::edit::edit_replace(close + 1, close + 1, shut, pcx) {
                tr.counts[TC_UTF8 as usize] += 1;
            }
            continue;
        }
        let t = buf_new();
        buf_bytes(t, b", ");
        buf_bytes(t, &get_src()[a as usize..b as usize]);
        buf_bytes(t, b" = str::from_utf8(");
        buf_bytes(t, &get_src()[a as usize..b as usize]);
        buf_bytes(t, b").unwrap()");
        // (after what was put there, a positional argument's `).unwrap()`)
        if editable(close, pcx) && crate::tools::edit::edit_replace(close, close, t, pcx) {
            tr.counts[TC_UTF8 as usize] += 1;
        }
    }
    // (an argument given to a parameter of a type bounded by Display:
    // `err_fmt(s)`, `fn err_fmt<T: Display>(x: T)`)
    for c in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[c as usize].kind != NodeKind::Call || !own_node(c, *tr, pcx) {
            continue;
        }
        let mut f = pcx.nodes[c as usize].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            continue;
        }
        if pcx.fns[f as usize].tmpl > 0 {
            f = pcx.fns[f as usize].tmpl - 1;
        }
        let fnode = pcx.fns[f as usize].node;
        if fnode <= 0 || pcx.nodes[fnode as usize].g <= 0 {
            continue;
        }
        for i in 0..pcx.nodes[c as usize].count {
            let arg = child(c, i, pcx);
            let e = if arg > 0
                && pcx.nodes[arg as usize].kind == NodeKind::NamedArg { pcx.nodes[arg as usize].b }
                else { arg };
            if e <= 0 || !byte_slice(pcx.nodes[e as usize].ty, pcx)
                || token_at(pcx.nodes[e as usize].start, pcx) < 0
                || pcx.nodes[e as usize].start <= pcx.nodes[c as usize].start
                || !declared_bytes(e, 0, decls, pcx)
                || !param_is_display(fnode, c, e, pcx) {
                continue;
            }
            if put(pcx.nodes[e as usize].start, pcx.nodes[e as usize].start, b"str::from_utf8(",
                TC_UTF8, tr, pcx) {
                put_first(pcx.nodes[e as usize].end, b").unwrap()", tr, pcx);
            }
        }
    }
}

pub fn body_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    // (first the bindings, which the accesses read)
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if !own_node(n, *tr, pcx) {
            continue;
        }
        if k == NodeKind::Let {
            edit_let(n, tr, pcx);
        } else if k == NodeKind::For {
            edit_for(n, tr, pcx);
            edit_for_copy(n, tr, pcx);
        } else if k == NodeKind::Block {
            // (a `for` the checker lowered)
            edit_for_copy(n, tr, pcx);
        } else if k == NodeKind::PatBind {
            edit_pat_bind(n, tr, pcx);
        } else if k == NodeKind::Static {
            edit_static(n, tr, pcx);
        }
    }
    let decls = text_decls(*tr, pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n as usize].kind;
        if !own_node(n, *tr, pcx) {
            continue;
        }
        if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Amp {
            edit_amp(n, tr, pcx);
        } else if k == NodeKind::Match {
            edit_match_copy(n, tr, pcx);
        } else if k == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Star {
            edit_deref(n, tr, pcx);
        } else if k == NodeKind::Call || k == NodeKind::FieldAccess {
            edit_len(n, tr, pcx);
            edit_call_args(n, tr, pcx);
            edit_text_to_bytes(n, decls, tr, pcx);
            if k == NodeKind::Call {
                edit_std_path(n, decls, tr, pcx);
                edit_inout_args(n, tr, pcx);
            }
        } else if k == NodeKind::Index {
            // (a raw pointer's part: ptr_slice_edits, after the statics)
            if !ptr_slice_node(n, pcx) {
                edit_view(n, tr, pcx);
                edit_index(n, tr, pcx);
                edit_ptr_index(n, tr, pcx);
                edit_text_to_bytes(n, decls, tr, pcx);
            }
        } else if k == NodeKind::Ident {
            edit_text_to_bytes(n, decls, tr, pcx);
        } else if k == NodeKind::Str {
            edit_str(n, decls, tr, pcx);
        } else if k == NodeKind::Char {
            edit_char(n, decls, tr, pcx);
        } else if k == NodeKind::Int {
            edit_int(n, tr, pcx);
            edit_int_generic(n, tr, pcx);
            edit_int_cast(n, tr, pcx);
        } else if k == NodeKind::Array || k == NodeKind::Repeat {
            edit_int_array(n, tr, pcx);
        } else if k == NodeKind::Closure {
            let s = pcx.nodes[n as usize].start;
            if (pcx.nodes[n as usize].p & CONV_NEW) != 0 && word_here(s, b"sink") {
                put(s, s + 4, b"move", TC_VAR, tr, pcx);
            }
        }
    }
    edit_prints(tr, pcx);
    edit_byte_holes(decls, tr, pcx);
    edit_char_holes(tr, pcx);
}
