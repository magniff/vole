// (0.27.3) The translator's bodies (mod.vl, pass 3): locals, the borrows
// and accesses MVS makes of names written as Rust's `&x`, `&mut x`, `*r`,
// and the spellings that differ (`v.len`, `println(x)`, `static var`, an
// i64 literal's annotation).

use crate::base::{IntVec, SRC, buf_bytes, buf_new, buf_slice};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{CONV_NEW, NodeKind, child};
use crate::front::check::is_std_named;
use crate::front::lexer::Tok;
use crate::front::types::{TY_I64, TY_I8, TY_ISIZE, TY_U64, TY_U8, TyKind};
use crate::middle::lower::ssa::HMap;
use crate::tools::translate::{
    D_REF, TC_BORROW, TC_BYTES, TC_DEREF, TC_INOUT_LOCAL, TC_INT, TC_LEN, TC_MUT_MARKER, TC_PRINT,
    TC_STATIC, TC_USIZE, TC_UTF8, TC_VAR, TC_VIEW, TL_BYTES, Tr, add_ref, editable, enclosing_fn,
    ident_char, is_mut_ref, is_ref, is_ws, left, own_node, parent_of, put, put_first, ref_binding,
    skip_ws, token_at, word_here, written_name,
};

// The symbol of the name node n is written as (its token's), or 0.
fn name_sym(n: i64, pcx: Ctx<Comp>) -> i64 {
    let k = token_at(pcx.nodes[n].start, pcx);
    if k < 0 || pcx.toks[k].kind != Tok::Ident || pcx.toks[k].end != pcx.nodes[n].end {
        return 0;
    }
    pcx.toks[k].value as i64
}

// Whether node n is a name that is a reference binding where it is.
fn names_ref(n: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    let s = name_sym(n, pcx);
    s != 0 && ref_binding(s, pcx.nodes[n].start, tr)
}

// Whether node n is argument 0 of a call that starts where it does (the
// receiver of a method call: Rust borrows and dereferences it itself).
fn receiver_of(n: i64, p: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[p].kind;
    (k == NodeKind::Call || k == NodeKind::MethodCall) && pcx.nodes[p].count > 0
        && child(p, 0, pcx) == n && pcx.nodes[p].start == pcx.nodes[n].start
}

// ---- Locals ----

// `var x = e;` is `let mut x = e;`, `inout r = &e;` is `let r = &mut e;`
// (r a reference binding for the rest of its function); an unannotated
// binding of an i64 literal gets `: i64` (the rust edition's literal
// default is i32, FL6).
fn edit_let(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    let pat = pcx.nodes[n].a;
    if word_here(s, "var") {
        put(s, s + 3, "let mut", TC_VAR, &tr, &pcx);
    } else if word_here(s, "inout") {
        put(s, s + 5, "let", TC_INOUT_LOCAL, &tr, &pcx);
        if pat > 0 && pcx.nodes[pat].kind == NodeKind::PatBind {
            let f = enclosing_fn(s, pcx);
            let to = if f > 0 { pcx.nodes[f].end } else { pcx.nodes[n].end };
            add_ref(pcx.nodes[n].end, to, pcx.nodes[pat].a, &tr);
        }
    } else if !word_here(s, "let") {
        return;
    }
    let init = pcx.nodes[n].c;
    if pat > 0 && pcx.nodes[pat].kind == NodeKind::PatBind && pcx.nodes[n].b == 0 && init > 0
        && pcx.nodes[init].ty == TY_I64 && literal_only(init, 0, pcx) {
        put(pcx.nodes[pat].end, pcx.nodes[pat].end, ": i64", TC_INT, &tr, &pcx);
    }
}

// Whether expression n is made of integer literals alone (its type comes
// from them), or an `if` with a branch that is.
fn literal_only(n: i64, depth: i64, pcx: Ctx<Comp>) -> bool {
    if n <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[n].kind;
    if k == NodeKind::Int {
        return pcx.nodes[n].b == 0;
    }
    if k == NodeKind::Unary && pcx.nodes[n].op == Tok::Minus {
        return literal_only(pcx.nodes[n].b, depth + 1, pcx);
    }
    if k == NodeKind::Binary {
        return literal_only(pcx.nodes[n].b, depth + 1, pcx)
            && literal_only(pcx.nodes[n].c, depth + 1, pcx);
    }
    // (an `if` one branch of which is, `if c { 1 } else { n }`: the rust
    // edition does not yet take its type from a later use, as rustc does)
    if k == NodeKind::If {
        return pcx.nodes[n].c > 0 && (literal_only(pcx.nodes[n].b, depth + 1, pcx)
            || literal_only(pcx.nodes[n].c, depth + 1, pcx));
    }
    if k == NodeKind::Block {
        return pcx.nodes[n].a > 0 && literal_only(pcx.nodes[n].a, depth + 1, pcx);
    }
    false
}

// `var x` in a pattern is `mut x`.
fn edit_pat_bind(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    if pcx.nodes[n].b != 0 && word_here(s, "var") {
        put(s, s + 3, "mut", TC_VAR, &tr, &pcx);
    }
}

// `for inout x in e` is `for x in &mut e`: x a reference binding in the
// loop.
fn edit_for(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    if !word_here(s, "for") {
        return;
    }
    let w = skip_ws(s + 3);
    if !word_here(w, "inout") {
        return;
    }
    let pat = pcx.nodes[n].b;
    let p = skip_ws(w + 5);
    // (the `in` after the pattern)
    var q = if pat > 0 { pcx.nodes[pat].end } else { p };
    while q < pcx.nodes[n].end && !(word_here(q, "in") && !ident_char(SRC[q - 1])) {
        q += 1;
    }
    if q >= pcx.nodes[n].end {
        return;
    }
    let e = skip_ws(q + 2);
    if put(w, p, "", TC_INOUT_LOCAL, &tr, &pcx) {
        put(e, e, "&mut ", -1, &tr, &pcx);
        if pat > 0 && pcx.nodes[pat].kind == NodeKind::PatBind {
            add_ref(pcx.nodes[n].start, pcx.nodes[n].end, pcx.nodes[pat].a, &tr);
        }
    }
}

// `for x in v` over a view or a reference (`xs: [i64]`, a let `v: Vec`),
// whose items Rust gives as `&T`: a copy item is `for &x in v`, as MVS
// copies it; (0.27.5) the same over a call that gives a view, `for v in
// m.values("cache")` (`&[&str]`: `&&str` items without the `&`), a Vec's
// view of its items among them (`for t in omegas.as_slice()`). (The
// checker lowers the loop: its pattern and its iterable, a name or a
// call, which a method call's lowering may make a block, are found by
// their places.)
fn edit_for_copy(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    if !word_here(s, "for") || token_at(s, pcx) < 0 {
        return;
    }
    let ps = skip_ws(s + 3);
    if word_here(ps, "inout") || word_here(ps, "var") {
        return;
    }
    var pe = ps;
    while ident_char(SRC[pe]) {
        pe += 1;
    }
    let is = skip_ws(pe);
    if pe == ps || !word_here(is, "in") {
        return;
    }
    let vs = skip_ws(is + 2);
    var ve = vs;
    while ident_char(SRC[ve]) {
        ve += 1;
    }
    if ve == vs {
        return;
    }
    // (a name, or a call: the text up to the body's `{` outside brackets)
    var call = false;
    if SRC[skip_ws(ve)] != '{' {
        var depth: i64 = 0;
        var q = ve;
        while q < SRC.len as i64 && !(depth == 0 && SRC[q] == '{') {
            if SRC[q] == '(' || SRC[q] == '[' {
                depth += 1;
            } else if SRC[q] == ')' || SRC[q] == ']' {
                depth -= 1;
            } else if depth == 0 && (SRC[q] == ';' || SRC[q] == '}') {
                return;
            }
            q += 1;
        }
        while q > ve && (SRC[q - 1] == ' ' || SRC[q - 1] == '\n') {
            q -= 1;
        }
        if q <= ve || SRC[q - 1] != ')' {
            return;
        }
        ve = q;
        call = true;
    }
    var pat = 0;
    var it = 0;
    for m in n + 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[m].kind;
        if pat == 0 && k == NodeKind::PatBind && pcx.nodes[m].start == ps
            && pcx.nodes[m].end == pe {
            pat = m;
        }
        if it == 0
            && (!call && k == NodeKind::Ident
                || call
                && (k == NodeKind::Call || k == NodeKind::MethodCall || k == NodeKind::Block))
            && pcx.nodes[m].start == vs && pcx.nodes[m].end == ve {
            it = m;
        }
        if pat > 0 && it > 0 || pcx.nodes[m].start > pcx.nodes[n].end && m > n + 64 {
            break;
        }
    }
    if pat == 0 || it == 0 {
        return;
    }
    let et = pcx.nodes[pat].ty;
    let t = pcx.nodes[it].ty;
    if et <= 0 || !crate::front::conv::copyable(et, &pcx) || is_ref(et, pcx) || t <= 0 {
        return;
    }
    if call && pcx.types[t].kind == TyKind::Slice
        || !call
        && (pcx.types[t].kind == TyKind::Slice || is_ref(t, pcx) || names_ref(it, tr, pcx)) {
        put(ps, ps, "&", TC_BORROW, &tr, &pcx);
    }
}

// ---- Borrows and accesses ----

// Whether place e's root is a local bound by `let` (not `var`): its
// address is a shared one.
fn let_root(e: i64, pcx: Ctx<Comp>) -> bool {
    var r = e;
    while r > 0 && (pcx.nodes[r].kind == NodeKind::FieldAccess
        || pcx.nodes[r].kind == NodeKind::Index || pcx.nodes[r].kind == NodeKind::TupleField) {
        r = pcx.nodes[r].a;
    }
    if r <= 0 || pcx.nodes[r].kind != NodeKind::Ident {
        return false;
    }
    let pos = pcx.nodes[r].start;
    let f = enclosing_fn(pos, pcx);
    if f <= 0 {
        return false;
    }
    var best = 0;
    for n in 1..pcx.nodes.len() as i64 {
        let s = pcx.nodes[n].start;
        if s < pcx.nodes[f].start || s >= pos || best > 0 && s <= pcx.nodes[best].start {
            continue;
        }
        let k = pcx.nodes[n].kind;
        let named = k == NodeKind::Param && pcx.nodes[n].a == pcx.nodes[r].a
            || k == NodeKind::Let && pcx.nodes[n].a > 0
            && pcx.nodes[pcx.nodes[n].a].kind == NodeKind::PatBind
            && pcx.nodes[pcx.nodes[n].a].a == pcx.nodes[r].a;
        if named {
            best = n;
        }
    }
    best > 0 && pcx.nodes[best].kind == NodeKind::Let
        && pcx.nodes[pcx.nodes[best].a].b == 0 && !word_here(pcx.nodes[best].start, "var")
}

// Whether place e's root is a parameter of its function (immutable in
// Rust unless written `mut`).
fn root_is_param(e: i64, pcx: Ctx<Comp>) -> bool {
    var r = e;
    while r > 0 && (pcx.nodes[r].kind == NodeKind::FieldAccess
        || pcx.nodes[r].kind == NodeKind::Index || pcx.nodes[r].kind == NodeKind::TupleField) {
        r = pcx.nodes[r].a;
    }
    if r <= 0 || pcx.nodes[r].kind != NodeKind::Ident {
        return false;
    }
    let f = enclosing_fn(pcx.nodes[r].start, pcx);
    if f <= 0 {
        return false;
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Param && pcx.nodes[n].a == pcx.nodes[r].a
            && pcx.nodes[n].start > pcx.nodes[f].start && pcx.nodes[n].start < pcx.nodes[r].start
            && enclosing_fn(pcx.nodes[n].start, pcx) == f {
            return true;
        }
    }
    false
}

// Whether Index node e is an array's element (not a raw pointer's, a
// view's or a Vec's): `&w[0]` is a place in the array itself.
fn array_element(e: i64, pcx: Ctx<Comp>) -> bool {
    let a = pcx.nodes[e].a;
    let b = pcx.nodes[e].b;
    a > 0 && b > 0 && pcx.nodes[b].kind != NodeKind::Range && pcx.nodes[a].ty > 0
        && pcx.types[pcx.nodes[a].ty].kind == TyKind::Array
}

// A written Unary `&` (`&x`, MVS's inout marker): `&mut x`, or `x` when x
// is a reference already (lent on: a reborrow); `x` too when it is given
// to a raw pointer.
fn edit_amp(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let t = pcx.nodes[n].ty;
    let operand = pcx.nodes[n].b;
    // (a parenthesized one, `(&w[0]) as *u8`, starts at its `(`)
    var s = pcx.nodes[n].start;
    while operand > 0 && s < pcx.nodes[operand].start && (SRC[s] == '(' || SRC[s] == ' ') {
        s += 1;
    }
    let inner = skip_ws(s + 1);
    // (an array's address cast to a raw pointer, `&a as *u8`: its first
    // element's, `a.as_mut_ptr() as *mut u8`; Rust casts no `&[T; N]` to
    // an element pointer)
    let c = parent_of(n, tr);
    if SRC[s] == '&' && SRC[s + 1] != '&' && c > 0 && pcx.nodes[c].kind == NodeKind::Cast
        && pcx.nodes[c].a == n && operand > 0 && pcx.nodes[operand].ty > 0
        && pcx.types[pcx.nodes[operand].ty].kind == TyKind::Array && pcx.nodes[c].ty > 0
        && pcx.types[pcx.nodes[c].ty].kind == TyKind::Ptr && pcx.types[pcx.nodes[c].ty].b == 0 {
        let after = if word_here(inner, "mut") { skip_ws(inner + 3) } else { inner };
        if put(s, after, "", TC_MUT_MARKER, &tr, &pcx) {
            put(pcx.nodes[operand].end, pcx.nodes[operand].end,
                if let_root(operand, pcx) { ".as_ptr()" } else { ".as_mut_ptr()" }, TC_MUT_MARKER,
                &tr, &pcx);
        }
        return;
    }
    // (a local's address cast to another pointee, `&x as *f64` of an i64:
    // `&raw const x as *mut f64`, `&raw mut` for a `var`; Rust casts no
    // `&mut i64` to a `*mut f64`)
    if SRC[s] == '&' && SRC[s + 1] != '&' && c > 0 && pcx.nodes[c].kind == NodeKind::Cast
        && pcx.nodes[c].a == n && operand > 0 && pcx.nodes[operand].ty > 0
        && (pcx.nodes[operand].kind == NodeKind::Ident
            || pcx.nodes[operand].kind == NodeKind::FieldAccess
            || pcx.nodes[operand].kind == NodeKind::Index && array_element(operand, pcx))
        && pcx.nodes[c].ty > 0 && pcx.types[pcx.nodes[c].ty].kind == TyKind::Ptr
        && pcx.types[pcx.nodes[c].ty].b == 0
        && pcx.types[pcx.nodes[c].ty].a != pcx.nodes[operand].ty
        && !access_to_ref(operand, tr, pcx) {
        let after = if word_here(inner, "mut") { skip_ws(inner + 3) } else { inner };
        let shared = let_root(operand, pcx) || root_is_param(operand, pcx);
        put(s, after, if shared { "&raw const " } else { "&raw mut " }, TC_MUT_MARKER, &tr, &pcx);
        return;
    }
    // (the address of a reference's referent, MVS's `&cx` given to a `*T`
    // when cx is inout: the `&mut` itself, which Rust coerces to `*mut T`)
    if SRC[s] == '&' && SRC[s + 1] != '&' && t > 0 && pcx.types[t].kind == TyKind::Ptr
        && pcx.types[t].b == 0 && operand > 0 && access_to_ref(operand, tr, pcx) {
        put(s, inner, "", TC_MUT_MARKER, &tr, &pcx);
        return;
    }
    if SRC[s] != '&' || SRC[s + 1] == '&' || !is_mut_ref(t, pcx) && !mut_slice(t, pcx) {
        return;
    }
    if operand > 0 && access_to_ref(operand, tr, pcx) {
        put(s, inner, "", TC_MUT_MARKER, &tr, &pcx);
    } else if !word_here(inner, "mut") {
        put(s + 1, s + 1, "mut ", TC_MUT_MARKER, &tr, &pcx);
    }
}

fn mut_slice(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.types[t].kind == TyKind::Slice && pcx.types[t].b == crate::front::types::REF_MUT
}

// Whether n is a reference in the rust edition already: the checker's
// access to a reference (a name: a let parameter that borrows, an inout
// parameter or local, a closure's reference parameter, a binding of a
// pattern on a reference), or an expression of a view type.
fn access_to_ref(n: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    if n <= 0 {
        return false;
    }
    let k = pcx.nodes[n].kind;
    if k == NodeKind::Unary && pcx.nodes[n].op == Tok::Star && SRC[pcx.nodes[n].start] != '*' {
        let o = pcx.nodes[n].b;
        if names_ref(n, tr, pcx) {
            return true;
        }
        return o > 0 && pcx.nodes[o].kind == NodeKind::Ident && is_ref(pcx.nodes[o].ty, pcx)
            && written_name(n, pcx);
    }
    if k == NodeKind::Ident {
        return is_ref(pcx.nodes[n].ty, pcx) || names_ref(n, tr, pcx);
    }
    false
}

// The place block b of an `if` gives, `{ bck.live }` (a name, a field or
// an element): 0 for another.
fn if_branch_place(b: i64, pcx: Ctx<Comp>) -> i64 {
    if b <= 0 || pcx.nodes[b].kind != NodeKind::Block || pcx.nodes[b].count != 0 {
        return 0;
    }
    // (the checker's borrow of it: what it borrows)
    var t = pcx.nodes[b].a;
    if t > 0 && pcx.nodes[t].kind == NodeKind::Unary && SRC[pcx.nodes[t].start] != '&' {
        t = pcx.nodes[t].b;
    }
    if t > 0
        && (pcx.nodes[t].kind == NodeKind::Ident || pcx.nodes[t].kind == NodeKind::FieldAccess
            || pcx.nodes[t].kind == NodeKind::Index) {
        t
    } else {
        0
    }
}

// A call of the program's function: each argument its parameter takes by
// reference (D_REF: a let parameter of a type MVS does not copy) is
// written `&e`, unless it is one already.
fn edit_call_args(c: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    var f = pcx.nodes[c].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    if pcx.fns[f].tmpl > 0 {
        f = pcx.fns[f].tmpl - 1;
    }
    let fnode = pcx.fns[f].node;
    if fnode <= 0 || !editable(pcx.nodes[fnode].start, &pcx) {
        return;
    }
    var params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for j in 0..pcx.nodes[fnode].count {
        let p = child(fnode, j, pcx);
        if pcx.nodes[p].kind == NodeKind::Param {
            params.push(p);
        }
    }
    for i in 0..pcx.nodes[c].count {
        if i >= params.count {
            break;
        }
        var arg = child(c, i, pcx);
        if pcx.nodes[arg].kind == NodeKind::NamedArg {
            arg = pcx.nodes[arg].b;
        }
        if arg <= 0 || tr.decided.get(params.get(i) + 1) != D_REF {
            continue;
        }
        // (a method's receiver: Rust borrows it itself; an argument the
        // checker made, a contract's check's, at the call)
        if pcx.nodes[arg].start <= pcx.nodes[c].start || pcx.nodes[arg].end > pcx.nodes[c].end {
            continue;
        }
        // (the checker's borrow: what it borrows)
        var e = arg;
        if pcx.nodes[e].kind == NodeKind::Unary && pcx.nodes[e].op == Tok::Amp
            && SRC[pcx.nodes[e].start] != '&' {
            e = pcx.nodes[e].b;
        }
        if e <= 0 || access_to_ref(e, tr, pcx) || pcx.nodes[e].kind == NodeKind::Closure
            || is_ref(pcx.nodes[e].ty, pcx) && SRC[pcx.nodes[e].start] == '&'
            || token_at(pcx.nodes[arg].start, pcx) < 0 {
            continue;
        }
        // (an `if` of two places, `if c { bck.dlive } else { bck.live }`:
        // each branch borrowed, `&if ..` would move out of them)
        if pcx.nodes[e].kind == NodeKind::If && if_branch_place(pcx.nodes[e].b, pcx) > 0
            && if_branch_place(pcx.nodes[e].c, pcx) > 0 {
            let x = if_branch_place(pcx.nodes[e].b, pcx);
            let y = if_branch_place(pcx.nodes[e].c, pcx);
            put(pcx.nodes[x].start, pcx.nodes[x].start, "&", TC_BORROW, &tr, &pcx);
            put(pcx.nodes[y].start, pcx.nodes[y].start, "&", TC_BORROW, &tr, &pcx);
            continue;
        }
        put(pcx.nodes[arg].start, pcx.nodes[arg].start, "&", TC_BORROW, &tr, &pcx);
    }
}

// The checker's access to a reference r, used as its value: `*r` where
// Rust does not dereference it itself (an assignment's target, a copy's
// read), as it is in a field, an index, a method's receiver.
fn edit_deref(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    if SRC[s] == '*' || !written_name(n, pcx) || !access_to_ref(n, tr, pcx) {
        return;
    }
    let p = parent_of(n, tr);
    if p > 0 {
        let pk = pcx.nodes[p].kind;
        if pk == NodeKind::FieldAccess && pcx.nodes[p].a == n
            || pk == NodeKind::TupleField && pcx.nodes[p].a == n
            || pk == NodeKind::Index && pcx.nodes[p].a == n || receiver_of(n, p, pcx)
            || pk == NodeKind::Unary && pcx.nodes[p].op == Tok::Amp {
            return;
        }
        if pk == NodeKind::Assign && pcx.nodes[p].b == n {
            put(s, s, "*", TC_DEREF, &tr, &pcx);
            return;
        }
    }
    let t = pcx.nodes[n].ty;
    if t > 0 && crate::front::conv::copyable(t, &pcx) && !is_ref(t, pcx)
        && pcx.types[t].kind != TyKind::Slice {
        put(s, s, "*", TC_DEREF, &tr, &pcx);
    }
}

// A view of a part, `v[a..b]` (MVS: a `[T]` of v's elements), is `&v[a..b]`
// (`&mut` for an inout one), unless written so.
fn edit_view(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let t = pcx.nodes[n].ty;
    let b = pcx.nodes[n].b;
    if t <= 0 || pcx.types[t].kind != TyKind::Slice || b <= 0
        || pcx.nodes[b].kind != NodeKind::Range || token_at(pcx.nodes[n].start, pcx) < 0 {
        return;
    }
    let s = pcx.nodes[n].start;
    var q = s - 1;
    while q > 0 && is_ws(SRC[q]) {
        q -= 1;
    }
    if SRC[q] == '&' || word_back(q, "mut") {
        return;
    }
    let p = parent_of(n, tr);
    // (a method's receiver, `.len` too: Rust borrows it itself)
    if p > 0 && (receiver_of(n, p, pcx) || (pcx.nodes[p].kind == NodeKind::Index
        || pcx.nodes[p].kind == NodeKind::FieldAccess) && pcx.nodes[p].a == n) {
        return;
    }
    put(s, s, if mut_slice(t, pcx) { "&mut " } else { "&" }, TC_VIEW, &tr, &pcx);
}

// Whether Index node n is a raw pointer's part, `p[a..b]` (MVS slices a
// `*T`): ptr_slice_edits rewrites it once the passes inside it are done.
fn ptr_slice_node(n: i64, pcx: Ctx<Comp>) -> bool {
    let a = pcx.nodes[n].a;
    let r = pcx.nodes[n].b;
    if a <= 0 || r <= 0 || pcx.nodes[r].kind != NodeKind::Range || pcx.nodes[r].b <= 0
        || token_at(pcx.nodes[n].start, pcx) < 0 {
        return false;
    }
    let t = pcx.nodes[a].ty;
    t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == 0
}

// (0.27.5) Whether SRC[a..b) names w as a whole word.
fn mentions_word(a: i64, b: i64, w: [u8]) -> bool {
    var i = a;
    while i + (w.len as i64) <= b {
        if SRC[i..i + w.len as i64] == w && (i == a || !ident_char(SRC[i - 1]))
            && (i + w.len as i64 == b || !ident_char(SRC[i + w.len as i64])) {
            return true;
        }
        i += 1;
    }
    false
}

// (0.27.5) An assignment to an element of a container whose index reads
// the container's root, `pcx.files[pcx.files.len() - 1].module = m` or
// `pcx.nodes[child(own, i, pcx)].a = ..`: Rust's IndexMut borrows the
// container mutably before the index is read (rustc E0502), so the index
// is computed first, `{ let at_ix = I; pcx.files[at_ix].module = m }`.
// Run after every other pass: the index moves with its edits.
pub fn hoist_index_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Assign || pcx.nodes[n].end <= pcx.nodes[n].start
            || !own_node(n, tr, &pcx) || !editable(pcx.nodes[n].start, &pcx) {
            continue;
        }
        var t = pcx.nodes[n].b;
        while t > 0 && pcx.nodes[t].kind == NodeKind::FieldAccess {
            t = pcx.nodes[t].a;
        }
        if t <= 0 || pcx.nodes[t].kind != NodeKind::Index {
            continue;
        }
        var base = pcx.nodes[t].a;
        let ix = pcx.nodes[t].b;
        // (the checker's view of a Vec indexed, a call around it at its place)
        if base > 0 && pcx.nodes[base].kind == NodeKind::Call && pcx.nodes[base].count == 1 {
            let v = child(base, 0, pcx);
            if v > 0 && pcx.nodes[v].start == pcx.nodes[base].start
                && pcx.nodes[v].end == pcx.nodes[base].end {
                base = v;
            }
        }
        if base <= 0 || ix <= 0 || pcx.nodes[ix].kind == NodeKind::Range
            || pcx.nodes[ix].end <= pcx.nodes[ix].start {
            continue;
        }
        // (a struct's IndexMut, a Vec's: not an array's or a slice's)
        var bt = pcx.nodes[base].ty;
        if bt > 0 && pcx.types[bt].kind == TyKind::Ptr {
            bt = pcx.types[bt].a;
        }
        if bt <= 0 || pcx.types[bt].kind != TyKind::Struct {
            continue;
        }
        var r = base;
        while r > 0 && (pcx.nodes[r].kind == NodeKind::FieldAccess
            || pcx.nodes[r].kind == NodeKind::Index || pcx.nodes[r].kind == NodeKind::Unary) {
            // (a borrow the checker made, `&mut p.files`, is its operand's)
            r = if pcx.nodes[r].kind == NodeKind::Unary { pcx.nodes[r].b } else { pcx.nodes[r].a };
        }
        if r <= 0 || pcx.nodes[r].kind != NodeKind::Ident {
            continue;
        }
        let a = pcx.nodes[ix].start;
        let b = pcx.nodes[ix].end;
        if !mentions_word(a, b, SRC[pcx.nodes[r].start..pcx.nodes[r].end]) {
            continue;
        }
        // (no edit that crosses the index, or holds the assignment whole)
        var crossed = false;
        for i in 0..pcx.e_start.count {
            let s = pcx.e_start.get(i);
            let e = pcx.e_end.get(i);
            let within = s >= a && e <= b;
            if !within && s < b && a < e || s < pcx.nodes[n].start && e > pcx.nodes[n].end {
                crossed = true;
            }
        }
        if crossed {
            continue;
        }
        let text = buf_new();
        buf_bytes(text, "{ let at_ix = ");
        crate::tools::translate::rows::render(a, b, true, text, pcx);
        buf_bytes(text, "; ");
        var w: i64 = 0;
        for i in 0..pcx.e_start.count {
            let s = pcx.e_start.get(i);
            let e = pcx.e_end.get(i);
            if !(s >= a && e <= b) {
                pcx.e_start.set(w, s);
                pcx.e_end.set(w, e);
                pcx.e_text.set(w, pcx.e_text.get(i));
                w += 1;
            }
        }
        pcx.e_start.count = w;
        pcx.e_end.count = w;
        pcx.e_text.count = w;
        let name = buf_new();
        buf_bytes(name, "at_ix");
        if crate::tools::edit::edit_replace(a, b, name, &pcx) {
            put_first(pcx.nodes[n].start, buf_slice(text), &tr, &pcx);
            put(pcx.nodes[n].end, pcx.nodes[n].end, " }", -1, &tr, &pcx);
        }
    }
}

// (after the statics, mod.vl) A raw pointer's part, `p[a..b]`, is
// `std::slice::from_raw_parts(p.add(a), b - a)` (`_mut` for an inout one,
// `&p[a..b]`, whose `&` it replaces), made of its operands' rewritten text:
// the edits inside it (a `(*q.add(i))`, an `unsafe { }` of a static) are
// folded into the one edit. The innermost first.
pub fn ptr_slice_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    var todo = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Index && own_node(n, tr, &pcx) && ptr_slice_node(n, pcx) {
            todo.push(n);
        }
    }
    var k: i64 = 1;
    while k < todo.count {
        var j = k;
        while j > 0 && pcx.nodes[todo.get(j)].end - pcx.nodes[todo.get(j)].start
            < pcx.nodes[todo.get(j - 1)].end - pcx.nodes[todo.get(j - 1)].start {
            let t = todo.get(j);
            todo.set(j, todo.get(j - 1));
            todo.set(j - 1, t);
            j -= 1;
        }
        k += 1;
    }
    for i in 0..todo.count {
        let n = todo.get(i);
        let a = pcx.nodes[n].a;
        let r = pcx.nodes[n].b;
        let lo = pcx.nodes[r].a;
        let hi = pcx.nodes[r].b;
        var s = pcx.nodes[n].start;
        var q = s - 1;
        while q > 0 && is_ws(SRC[q]) {
            q -= 1;
        }
        let lent = SRC[q] == '&';
        if lent {
            s = q;
        }
        let lo_text = buf_new();
        if lo > 0 {
            crate::tools::translate::rows::render(pcx.nodes[lo].start, pcx.nodes[lo].end, true,
                lo_text, pcx);
        } else {
            buf_bytes(lo_text, "0");
        }
        let text = buf_new();
        buf_bytes(text, if lent { "std::slice::from_raw_parts_mut(" }
            else { "std::slice::from_raw_parts(" });
        // (of the insertions where p starts, edit_ptr_index's `(*` are p's,
        // moved inside; the others, an `unsafe { ` or a printed view's
        // `str::from_utf8(`, are the context's)
        var opens = 0;
        if pcx.nodes[a].start == s {
            var w: i64 = 0;
            for e in 0..pcx.e_start.count {
                let at = pcx.e_start.get(e) == s && pcx.e_end.get(e) == s
                    && buf_slice(pcx.e_text.get(e)) == "(*";
                if at && editable(s, &pcx) {
                    opens += 1;
                } else {
                    pcx.e_start.set(w, pcx.e_start.get(e));
                    pcx.e_end.set(w, pcx.e_end.get(e));
                    pcx.e_text.set(w, pcx.e_text.get(e));
                    w += 1;
                }
            }
            pcx.e_start.count = w;
            pcx.e_end.count = w;
            pcx.e_text.count = w;
        }
        for _ in 0..opens {
            buf_bytes(text, "(*");
        }
        crate::tools::translate::rows::render(pcx.nodes[a].start, pcx.nodes[a].end,
            pcx.nodes[a].start != s, text, pcx);
        buf_bytes(text, ".add((");
        buf_bytes(text, buf_slice(lo_text));
        buf_bytes(text, ") as usize), (");
        crate::tools::translate::rows::render(pcx.nodes[hi].start, pcx.nodes[hi].end, true, text,
            pcx);
        buf_bytes(text, " - (");
        buf_bytes(text, buf_slice(lo_text));
        buf_bytes(text, ")) as usize)");
        if !editable(s, &pcx) {
            continue;
        }
        crate::tools::translate::rows::drop_inside(s, pcx.nodes[n].end, &pcx);
        if crate::tools::edit::edit_replace(s, pcx.nodes[n].end, text, &pcx) {
            tr.counts[TC_USIZE] += 1;
        }
    }
}

// Whether node u is the operand of a cast to a raw pointer, `(&x) as *u8`.
fn raw_cast_parent(u: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    let c = parent_of(u, tr);
    c > 0 && pcx.nodes[c].kind == NodeKind::Cast && pcx.nodes[c].a == u && pcx.nodes[c].ty > 0
        && pcx.types[pcx.nodes[c].ty].kind == TyKind::Ptr && pcx.types[pcx.nodes[c].ty].b == 0
}

// A raw pointer's element, `p[i]` (MVS indexes a `*T`), is `(*p.add(i))`
// (rustc E0608: a raw pointer is not indexed), a place as well as a value.
fn edit_ptr_index(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let a = pcx.nodes[n].a;
    let b = pcx.nodes[n].b;
    if a <= 0 || b <= 0 || pcx.nodes[b].kind == NodeKind::Range
        || token_at(pcx.nodes[n].start, pcx) < 0 {
        return;
    }
    let t = pcx.nodes[a].ty;
    if t <= 0 || pcx.types[t].kind != TyKind::Ptr || pcx.types[t].b != 0 {
        return;
    }
    var q = pcx.nodes[a].end;
    while q < pcx.nodes[b].start && SRC[q] != '[' {
        q += 1;
    }
    let e = pcx.nodes[n].end - 1;
    if q >= pcx.nodes[b].start || SRC[e] != ']' {
        return;
    }
    // (its address, MVS's `&p[i]` of type `*T`: `p.add(i)`, not a reference)
    // (a parenthesized one starts at its `(`)
    let u = parent_of(n, tr);
    var amp = if u > 0 { pcx.nodes[u].start } else { 0 };
    while u > 0 && amp < pcx.nodes[n].start && (SRC[amp] == '(' || SRC[amp] == ' ') {
        amp += 1;
    }
    if u > 0 && pcx.nodes[u].kind == NodeKind::Unary && pcx.nodes[u].op == Tok::Amp
        && pcx.nodes[u].b == n && SRC[amp] == '&'
        && SRC[amp + 1] != '&' && pcx.nodes[u].ty > 0
        && pcx.types[pcx.nodes[u].ty].kind == TyKind::Ptr
        && (pcx.types[pcx.nodes[u].ty].b == 0 || raw_cast_parent(u, tr, pcx))
        && !word_here(skip_ws(amp + 1), "mut") {
        // (`(&p[i]) as *u8` too: a borrow MVS casts to a raw pointer)
        if put(amp, skip_ws(amp + 1), "", TC_USIZE, &tr, &pcx) {
            put(q, q + 1, ".add(", TC_USIZE, &tr, &pcx);
            put(e, e + 1, ")", -1, &tr, &pcx);
        }
        return;
    }
    if put(q, q + 1, ".add(", TC_USIZE, &tr, &pcx) {
        // (no once-per-place key: `pp[i][j]` opens two at one place)
        let open = crate::base::buf_new();
        crate::base::buf_bytes(open, "(*");
        crate::tools::edit::edit_replace(pcx.nodes[n].start, pcx.nodes[n].start, open, &pcx);
        // (not TC_USIZE's key: an index's ` as usize` may end where `]` is)
        put(e, e + 1, "))", -1, &tr, &pcx);
    }
}

// An integer index (i64, u64, ..) is `i as usize` (Rust indexes with a usize; until the
// rust edition infers it, FL6), a range's ends too; a literal is left.
fn edit_index(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let b = pcx.nodes[n].b;
    if b <= 0 || token_at(pcx.nodes[n].start, pcx) < 0 {
        return;
    }
    if pcx.nodes[b].kind == NodeKind::Range {
        cast_usize(pcx.nodes[b].a, &tr, &pcx);
        cast_usize(pcx.nodes[b].b, &tr, &pcx);
    } else {
        cast_usize(b, &tr, &pcx);
    }
}

fn cast_usize(e: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    // (any integer but usize: MVS indexes with each, `u64` keys of a table)
    let ty = if e > 0 { pcx.nodes[e].ty } else { 0 };
    if e <= 0 || !(ty >= TY_I8 && ty <= TY_U64 || ty == TY_ISIZE)
        || pcx.nodes[e].kind == NodeKind::Int {
        return;
    }
    let k = pcx.nodes[e].kind;
    let simple = k == NodeKind::Ident || k == NodeKind::Call || k == NodeKind::FieldAccess
        || k == NodeKind::Index || k == NodeKind::TupleField || k == NodeKind::MethodCall
        || k == NodeKind::Path || k == NodeKind::Unary || k == NodeKind::Cast
        || k == NodeKind::Block;
    let s = pcx.nodes[e].start;
    let t = pcx.nodes[e].end;
    if simple {
        put(t, t, " as usize", TC_USIZE, &tr, &pcx);
    } else if put(s, s, "(", TC_USIZE, &tr, &pcx) {
        put(t, t, ") as usize", TC_USIZE, &tr, &pcx);
        tr.counts[TC_USIZE] -= 1;
    }
}

fn word_back(q: i64, w: [u8]) -> bool {
    let n = w.len as i64;
    q - n + 1 >= 0 && SRC[q - n + 1..q + 1] == w
}

// ---- Spellings ----

// `v.len` (a read of std's len, which MVS lets be written without its
// parentheses) is `v.len()`.
fn edit_len(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let e = pcx.nodes[n].end;
    if e < 4 || SRC[e - 3] != 'l' || SRC[e - 2] != 'e' || SRC[e - 1] != 'n' || SRC[e - 4] != '.'
        || SRC[skip_ws(e)] == '(' {
        return;
    }
    if pcx.nodes[n].kind == NodeKind::Call {
        // (std's len, not a field of the program's struct)
        // (and a call of len: a call the checker made that ends there, a
        // contract's check of `i < self.len`, is not)
        let f = pcx.nodes[n].x - 1;
        if pcx.nodes[n].a != 0 || pcx.nodes[n].b != tr.sym_len
            || f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f].node > 0
            && editable(pcx.nodes[pcx.fns[f].node].start, &pcx) {
            return;
        }
    } else {
        // (a slice's or a str's `.len`, MVS's field)
        let b = pcx.nodes[n].a;
        var t = if b > 0 { pcx.nodes[b].ty } else { 0 };
        if t > 0 && pcx.types[t].kind == TyKind::Ptr {
            t = pcx.types[t].a;
        }
        if t <= 0 || pcx.nodes[n].b != tr.sym_len || pcx.types[t].kind != TyKind::Slice
            && pcx.types[t].kind != TyKind::Distinct && pcx.types[t].kind != TyKind::Array {
            return;
        }
    }
    put(e, e, "()", TC_LEN, &tr, &pcx);
}

// `println(x)` of a value is `println("{}", x)` (print, eprint, eprintln
// too): the rust edition's prints take a format literal first.
fn edit_prints(tr: inout Tr, pcx: inout Ctx<Comp>) {
    for k in 0..pcx.toks.len() as i64 - 2 {
        let t = pcx.toks[k];
        if t.kind != Tok::Ident || pcx.toks[k + 1].kind != Tok::LParen
            || !editable(t.start, &pcx) {
            continue;
        }
        let w = SRC[t.start..t.end];
        if w != "println" && w != "print" && w != "eprintln" && w != "eprint" {
            continue;
        }
        if k > 0 && (pcx.toks[k - 1].kind == Tok::Dot || pcx.toks[k - 1].kind == Tok::Fn) {
            continue;
        }
        let next = pcx.toks[k + 2].kind;
        if next == Tok::Str || next == Tok::RParen {
            continue;
        }
        put(pcx.toks[k + 2].start, pcx.toks[k + 2].start, "\"{}\", ", TC_PRINT, &tr, &pcx);
    }
}

// `static var` is `static mut`.
fn edit_static(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if (pcx.nodes[n].p & CONV_NEW) == 0 {
        return;
    }
    var q = pcx.nodes[n].start;
    while q < pcx.nodes[n].end && !word_here(q, "static") {
        q += 1;
    }
    let m = skip_ws(q + 6);
    if q < pcx.nodes[n].end && word_here(m, "var") {
        put(m, m + 3, "mut", TC_STATIC, &tr, &pcx);
    }
}

// The parameter of fnode that call c's argument n is given to, or 0.
fn param_of(fnode: i64, c: i64, n: i64, pcx: Ctx<Comp>) -> i64 {
    var i: i64 = -1;
    for k in 0..pcx.nodes[c].count {
        let a = child(c, k, pcx);
        if a == n || a > 0 && pcx.nodes[a].kind == NodeKind::NamedArg && pcx.nodes[a].b == n {
            i = k;
        }
    }
    if i < 0 {
        return 0;
    }
    var j: i64 = 0;
    for k in 0..pcx.nodes[fnode].count {
        let p = child(fnode, k, pcx);
        if pcx.nodes[p].kind == NodeKind::Param {
            if j == i {
                return p;
            }
            j += 1;
        }
    }
    0
}

// Whether call c's argument n is given to a parameter of fnode written
// `[T]` (a `str` parameter takes a text literal as it is).
fn param_is_slice(fnode: i64, c: i64, n: i64, pcx: Ctx<Comp>) -> bool {
    let p = param_of(fnode, c, n, pcx);
    let t = if p > 0 { pcx.nodes[p].b } else { 0 };
    t > 0 && pcx.nodes[t].kind == NodeKind::TySlice
}

// Whether call c's argument n is given to a parameter of fnode whose type
// is a type parameter bounded by Display (`x: T`, `T: Display`).
fn param_is_display(fnode: i64, c: i64, n: i64, pcx: Ctx<Comp>) -> bool {
    let p = param_of(fnode, c, n, pcx);
    let tn = if p > 0 { pcx.nodes[p].b } else { 0 };
    let g = pcx.nodes[fnode].g;
    if tn <= 0 || pcx.nodes[tn].kind != NodeKind::TyName || pcx.nodes[tn].count > 0 || g <= 0
        || pcx.nodes[g].kind != NodeKind::Generics {
        return false;
    }
    for i in 0..pcx.nodes[g].count {
        let tp = child(g, i, pcx);
        let h = pcx.nodes[tp].h;
        if pcx.nodes[tp].a != pcx.nodes[tn].a || h <= 0 || pcx.nodes[h].kind != NodeKind::Generics {
            continue;
        }
        for j in 0..pcx.nodes[h].count {
            let b = child(h, j, pcx);
            if pcx.nodes[b].kind == NodeKind::TyName && word_back(pcx.nodes[b].end - 1, "Display") {
                return true;
            }
        }
    }
    false
}

// (0.27.5) Whether type node t is written `[u8]` (a slice whose element
// is neither text nor a slice): where a text literal's value is bytes.
fn bytes_type(t: i64, pcx: Ctx<Comp>) -> bool {
    t > 0 && pcx.nodes[t].kind == NodeKind::TySlice && !str_type_node(pcx.nodes[t].a, pcx)
        && (pcx.nodes[t].a <= 0 || pcx.nodes[pcx.nodes[t].a].kind != NodeKind::TySlice)
}

// (0.27.5) The type node written where the value of expression e goes, 0
// when none is: a let's, a static's or a constant's annotation, a
// function's result, a parameter's (of a function of the program, or of
// std's method on a receiver declared bytes, `name.ends_with("_in")`), a
// field's; an element of an array or a tuple takes its part of the type
// its literal goes to; a borrow, an `if`'s branch, a match's arm and a
// block's value the type theirs goes to.
fn ctx_type(e: i64, depth: i64, d: TextDecls, tr: Tr, pcx: inout Ctx<Comp>) -> i64 {
    if e <= 0 || depth > 32 {
        return 0;
    }
    let p = parent_of(e, tr);
    if p <= 0 {
        return 0;
    }
    let pk = pcx.nodes[p].kind;
    if pk == NodeKind::Let || pk == NodeKind::Static || pk == NodeKind::Const {
        return if pcx.nodes[p].c == e { pcx.nodes[p].b } else { 0 };
    }
    if pk == NodeKind::Array {
        let t = ctx_type(p, depth + 1, d, tr, &pcx);
        return if t > 0
            && (pcx.nodes[t].kind == NodeKind::TyArray || pcx.nodes[t].kind == NodeKind::TySlice) {
            pcx.nodes[t].a
        } else { 0 };
    }
    if pk == NodeKind::Tuple {
        let t = ctx_type(p, depth + 1, d, tr, &pcx);
        if t <= 0 || pcx.nodes[t].kind != NodeKind::TyTuple {
            return 0;
        }
        for i in 0..pcx.nodes[p].count {
            if child(p, i, pcx) == e {
                return if i < pcx.nodes[t].count { child(t, i, pcx) } else { 0 };
            }
        }
        return 0;
    }
    if pk == NodeKind::Unary && pcx.nodes[p].op == Tok::Amp {
        return ctx_type(p, depth + 1, d, tr, &pcx);
    }
    if pk == NodeKind::Index {
        // (an array given as a slice, `[..]` of it, the checker's)
        let r = pcx.nodes[p].b;
        return if pcx.nodes[p].a == e && (r <= 0 || pcx.nodes[r].kind == NodeKind::Range) {
            ctx_type(p, depth + 1, d, tr, &pcx)
        } else { 0 };
    }
    if pk == NodeKind::Block {
        if pcx.nodes[p].a != e {
            return 0;
        }
        let q = parent_of(p, tr);
        if q > 0 && pcx.nodes[q].kind == NodeKind::Fn {
            return pcx.nodes[q].b;
        }
        return ctx_type(p, depth + 1, d, tr, &pcx);
    }
    if pk == NodeKind::If {
        return if pcx.nodes[p].a != e { ctx_type(p, depth + 1, d, tr, &pcx) } else { 0 };
    }
    if pk == NodeKind::Arm {
        return if pcx.nodes[p].c == e { ctx_type(parent_of(p, tr), depth + 1, d, tr, &pcx) }
            else { 0 };
    }
    if pk == NodeKind::Return {
        let f = enclosing_fn(pcx.nodes[e].start, pcx);
        return if f > 0 { pcx.nodes[f].b } else { 0 };
    }
    if pk == NodeKind::FieldInit {
        return if pcx.nodes[p].b == e { field_type_node(parent_of(p, tr), pcx.nodes[p].a, pcx) }
            else { 0 };
    }
    let c = if pk == NodeKind::NamedArg { parent_of(p, tr) } else { p };
    // (not a call the checker made, which has no width: a print's hole
    // given to std's writer of bytes)
    if c > 0 && pcx.nodes[c].kind == NodeKind::Call && pcx.nodes[c].end > pcx.nodes[c].start {
        var f = pcx.nodes[c].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return 0;
        }
        if pcx.fns[f].tmpl > 0 {
            f = pcx.fns[f].tmpl - 1;
        }
        let fnode = pcx.fns[f].node;
        let q = if fnode > 0 { param_of(fnode, c, e, pcx) } else { 0 };
        if q <= 0 {
            return 0;
        }
        // (std's method on bytes, `name.ends_with("_in")`: its receiver is
        // declared bytes, as on a `str` the same method takes text; or on a
        // Vec, `b.extend_from_slice("hey")` of a Vec<u8>: not another
        // struct's, whose call a row may make Rust's, `f.str("--")` of a
        // Fmt to `f.write_str("--")`)
        let r = if pcx.nodes[c].count > 1 { child(c, 0, pcx) } else { 0 };
        var rt = if r > 0 { pcx.nodes[r].ty } else { 0 };
        if rt > 0 && pcx.types[rt].kind == TyKind::Ptr {
            rt = pcx.types[rt].a;
        }
        let method = r > 0 && r != e && pcx.nodes[r].start == pcx.nodes[c].start
            && pcx.nodes[r].end < pcx.nodes[c].end && SRC[pcx.nodes[r].end] == '.';
        if editable(pcx.nodes[fnode].start, &pcx)
            || method
            && (declared_bytes(r, 0, d, pcx) || rt > 0 && is_std_named(rt, c"Vec", pcx)) {
            return pcx.nodes[q].b;
        }
    }
    0
}

// (0.27.5) The type node of field name of the struct that struct literal
// s makes, 0 when unknown.
fn field_type_node(s: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    if s <= 0 || pcx.nodes[s].kind != NodeKind::StructLit {
        return 0;
    }
    let t = pcx.nodes[s].ty;
    if t <= 0 || pcx.types[t].kind != TyKind::Struct {
        return 0;
    }
    let si = pcx.types[t].a;
    let sn = pcx.structs[if pcx.structs[si].tmpl > 0 { pcx.structs[si].tmpl - 1 } else { si }].node;
    for i in 0..if sn > 0 { pcx.nodes[sn].count } else { 0 } {
        let f = child(sn, i, pcx);
        if pcx.nodes[f].kind == NodeKind::Field && pcx.nodes[f].a == name {
            return pcx.nodes[f].b;
        }
    }
    0
}

// (0.27.5) Whether e is an argument of std's Vec method given as its
// element T (`words.push("-c")` of a Vec<[u8]>), checked as `[u8]`: the
// element is bytes where the Vec is declared.
fn vec_element_bytes(e: i64, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    let c = parent_of(e, tr);
    let t = if e > 0 { pcx.nodes[e].ty } else { 0 };
    if c <= 0 || pcx.nodes[c].kind != NodeKind::Call || pcx.nodes[c].end <= pcx.nodes[c].start
        || pcx.nodes[c].count < 2 || t <= 0 || pcx.types[t].kind != TyKind::Slice
        || pcx.types[t].a != TY_U8 {
        return false;
    }
    var f = pcx.nodes[c].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    if pcx.fns[f].tmpl > 0 {
        f = pcx.fns[f].tmpl - 1;
    }
    let fnode = pcx.fns[f].node;
    let q = if fnode > 0 { param_of(fnode, c, e, pcx) } else { 0 };
    let r = child(c, 0, pcx);
    if q <= 0 || r == e || pcx.nodes[q].b <= 0 || pcx.nodes[pcx.nodes[q].b].kind != NodeKind::TyName
        || SRC[pcx.nodes[pcx.nodes[q].b].start..pcx.nodes[pcx.nodes[q].b].end] != "T" {
        return false;
    }
    var rt = pcx.nodes[r].ty;
    if rt > 0 && pcx.types[rt].kind == TyKind::Ptr {
        rt = pcx.types[rt].a;
    }
    // (the Vec's element `[u8]`, not `str`, which the argument's erased
    // type does not tell)
    let el = if rt > 0 { crate::tools::translate::rows::type_arg(rt, 0, pcx) } else { 0 };
    rt > 0 && is_std_named(rt, c"Vec", pcx) && pcx.nodes[r].start == pcx.nodes[c].start
        && pcx.nodes[r].end < pcx.nodes[c].end && SRC[pcx.nodes[r].end] == '.'
        && el > 0 && pcx.types[el].kind == TyKind::Slice && pcx.types[el].a == TY_U8
}

// (0.27.5) Whether the value of expression e goes where bytes are
// declared: a place whose type is written `[u8]` (ctx_type), an
// assignment to declared bytes, the other side of `==` or `!=` from them,
// an `if` another branch of which is; through a borrow, an `if`'s
// branches, a match's arms and a block's value. F0.6: `&str` is no
// `&[u8]` in the rust edition (rustc E0308). up: e's place was asked
// already, below.
fn bytes_go(e: i64, up: i64, depth: i64, d: TextDecls, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    if up == 0 && (bytes_type(ctx_type(e, 0, d, tr, &pcx), pcx) || vec_element_bytes(e, tr, &pcx)) {
        return true;
    }
    if e <= 0 || depth > 32 {
        return false;
    }
    let p = parent_of(e, tr);
    if p <= 0 {
        return false;
    }
    let pk = pcx.nodes[p].kind;
    if pk == NodeKind::Let && pcx.nodes[p].b == 0 && pcx.nodes[p].start == pcx.nodes[p].end {
        // (the checker's `{ let l = a; let r = b; .. }` of `a == b` on views,
        // equality.vl, rewritten in place: the other side's value)
        let q = parent_of(p, tr);
        if pcx.nodes[p].c != e || q <= 0 || pcx.nodes[q].kind != NodeKind::Block
            || pcx.nodes[q].count < 2 {
            return false;
        }
        let o = if child(q, 0, pcx) == p { child(q, 1, pcx) }
            else if child(q, 1, pcx) == p { child(q, 0, pcx) } else { 0 };
        if o <= 0 || pcx.nodes[o].kind != NodeKind::Let || pcx.nodes[o].c <= 0 {
            return false;
        }
        // (a print's lowering has such lets too: `==` or `!=` between the two)
        let a = pcx.nodes[pcx.nodes[child(q, 0, pcx)].c].end;
        let b = pcx.nodes[pcx.nodes[child(q, 1, pcx)].c].start;
        var i = a;
        while i < b && (SRC[i] == ' ' || SRC[i] == '\n' || SRC[i] == ')') {
            i += 1;
        }
        return i + 1 < b && (SRC[i] == '=' || SRC[i] == '!') && SRC[i + 1] == '='
            && declared_bytes(pcx.nodes[o].c, 0, d, pcx);
    }
    if pk == NodeKind::Unary && pcx.nodes[p].op == Tok::Amp {
        return bytes_go(p, 1, depth + 1, d, tr, &pcx);
    }
    if pk == NodeKind::Block {
        return pcx.nodes[p].a == e && bytes_go(p, 1, depth + 1, d, tr, &pcx);
    }
    if pk == NodeKind::If {
        if pcx.nodes[p].a == e {
            return false;
        }
        let o = if pcx.nodes[p].b == e { pcx.nodes[p].c } else { pcx.nodes[p].b };
        return o > 0 && declared_bytes(o, 0, d, pcx) || bytes_go(p, 1, depth + 1, d, tr, &pcx);
    }
    if pk == NodeKind::Arm {
        return pcx.nodes[p].c == e && bytes_go(parent_of(p, tr), 1, depth + 1, d, tr, &pcx);
    }
    if pk == NodeKind::Binary && (pcx.nodes[p].op == Tok::EqEq || pcx.nodes[p].op == Tok::BangEq) {
        let o = if pcx.nodes[p].b == e { pcx.nodes[p].c } else { pcx.nodes[p].b };
        return declared_bytes(o, 0, d, pcx);
    }
    if pk == NodeKind::Assign {
        return pcx.nodes[p].c == e && declared_bytes(pcx.nodes[p].b, 0, d, pcx);
    }
    false
}

// (0.27.5) Whether pattern binding b is the payload of `Some(spec)` (or
// `Ok(spec)`) in an arm of a match on a call whose result is written
// `Option<str>` (`Result<str, ..>`): `w.strip_prefix("--")` of std's str.
fn arm_str_binding(b: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    let p = parent_of(b, tr);
    if p <= 0 || pcx.nodes[p].kind != NodeKind::PatVariant || pcx.nodes[p].count != 1 {
        return false;
    }
    let arm = parent_of(p, tr);
    if arm <= 0 || pcx.nodes[arm].kind != NodeKind::Arm || pcx.nodes[arm].a != p {
        return false;
    }
    let m = parent_of(arm, tr);
    if m <= 0 || pcx.nodes[m].kind != NodeKind::Match {
        return false;
    }
    let s = pcx.nodes[m].a;
    if s <= 0 || pcx.nodes[s].kind != NodeKind::Call {
        return false;
    }
    let f = pcx.nodes[s].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
    let fnode = pcx.fns[g].node;
    let r = if fnode > 0 { pcx.nodes[fnode].b } else { 0 };
    if r <= 0 {
        return false;
    }
    let t = SRC[pcx.nodes[r].start..pcx.nodes[r].end];
    t == "Option<str>" || t.len > 11 && t[0..11] == "Result<str,"
}

// (0.27.5) Whether expression e is text where it is declared, positively:
// a binding or parameter written `str` (or initialized from such a
// value), a field declared `str` alone, a call of a function whose result
// is written `str`, a part or a borrow of one; a text literal edit_str
// leaves text (`let m = if w { "7" } else { "15" };`), an `if`, a block or
// a match all of whose values are.
fn declared_str(e: i64, depth: i64, d: TextDecls, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    if e <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident {
        let best = bound_at(e, d, pcx);
        if best < 0 {
            return false;
        }
        let b = d.binds.get(best + 3);
        if pcx.nodes[b].kind == NodeKind::PatBind {
            return d.tuples.get(b + 1) == 2 || arm_str_binding(b, tr, pcx);
        }
        if pcx.nodes[b].kind == NodeKind::Param || pcx.nodes[b].b > 0 {
            return str_type_node(pcx.nodes[b].b, pcx);
        }
        return declared_str(pcx.nodes[b].c, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::FieldAccess {
        return d.fields.get(pcx.nodes[e].b + 1) == 1;
    }
    if k == NodeKind::Call {
        let f = pcx.nodes[e].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return false;
        }
        let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
        let fnode = pcx.fns[g].node;
        if fnode <= 0 {
            return false;
        }
        if editable(pcx.nodes[fnode].start, &pcx) {
            return str_type_node(pcx.nodes[fnode].b, pcx);
        }
        // (std's method on text, a view of it: `tok.strip_prefix("--")
        // .unwrap()` of a `tok: str`; not its bytes, `as_bytes`)
        let r = if pcx.nodes[e].count > 0 { child(e, 0, pcx) } else { 0 };
        return r > 0 && pcx.nodes[r].start == pcx.nodes[e].start
            && pcx.nodes[r].end < pcx.nodes[e].end && SRC[pcx.nodes[r].end] == '.'
            && crate::base::sym_text(pcx.nodes[fnode].a, pcx) != "as_bytes"
            && declared_str(r, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::Str {
        return SRC[pcx.nodes[e].start] == '"' && !bytes_go(e, 0, 0, d, tr, &pcx);
    }
    if k == NodeKind::If {
        return pcx.nodes[e].c > 0 && declared_str(pcx.nodes[e].b, depth + 1, d, tr, &pcx)
            && declared_str(pcx.nodes[e].c, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::Block {
        return pcx.nodes[e].a > 0 && declared_str(pcx.nodes[e].a, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::Match {
        var arms: i64 = 0;
        for i in 0..pcx.nodes[e].count {
            let arm = child(e, i, pcx);
            if arm <= 0 || pcx.nodes[arm].kind != NodeKind::Arm
                || !declared_str(pcx.nodes[arm].c, depth + 1, d, tr, &pcx) {
                return false;
            }
            arms += 1;
        }
        return arms > 0;
    }
    if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Amp {
        return declared_str(pcx.nodes[e].b, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::Index {
        let r = pcx.nodes[e].b;
        if r > 0 && pcx.nodes[r].kind == NodeKind::Range {
            return declared_str(pcx.nodes[e].a, depth + 1, d, tr, &pcx);
        }
        // (an element of a local array of text, `let kws = ["fn ", ..];`
        // then `kws[k]`, or of one written `[str; N]`)
        return elements_str(pcx.nodes[e].a, depth + 1, d, tr, &pcx);
    }
    false
}

// (0.27.5) Whether expression a is an array or a slice whose elements are
// text where it is declared: a binding written `[str; N]` or `[str]`, or
// initialized with an array literal of text (`let kws = ["fn ", ..];`), a
// part or a borrow of one (`let names = all[..];`).
fn elements_str(a: i64, depth: i64, d: TextDecls, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    if a <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[a].kind;
    if k == NodeKind::Unary && SRC[pcx.nodes[a].start] == '&' {
        return elements_str(pcx.nodes[a].b, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::Index {
        let r = pcx.nodes[a].b;
        return r > 0 && pcx.nodes[r].kind == NodeKind::Range
            && elements_str(pcx.nodes[a].a, depth + 1, d, tr, &pcx);
    }
    if k == NodeKind::Array {
        if pcx.nodes[a].count == 0 {
            return false;
        }
        for i in 0..pcx.nodes[a].count {
            if !declared_str(child(a, i, pcx), depth + 1, d, tr, &pcx) {
                return false;
            }
        }
        return true;
    }
    if k != NodeKind::Ident {
        return false;
    }
    let best = bound_at(a, d, pcx);
    if best < 0 {
        return false;
    }
    let b = d.binds.get(best + 3);
    if pcx.nodes[b].kind == NodeKind::PatBind {
        return false;
    }
    let t = pcx.nodes[b].b;
    if pcx.nodes[b].kind == NodeKind::Param || t > 0 {
        return t > 0
            && (pcx.nodes[t].kind == NodeKind::TyArray || pcx.nodes[t].kind == NodeKind::TySlice)
            && str_type_node(pcx.nodes[t].a, pcx);
    }
    elements_str(pcx.nodes[b].c, depth + 1, d, tr, &pcx)
}

// (0.27.5) Whether fn node f's module is std's `name` (`std::fs`).
fn in_std_module(g: i64, name: [u8], pcx: Ctx<Comp>) -> bool {
    let m = pcx.fns[g].module;
    m >= 0 && m < pcx.modules.len() as i64 && crate::base::sym_text(pcx.modules[m].key, pcx) == name
}

// (0.27.5) A match on a copy value read from a place, with a guard
// (`match pcx.nodes[n].kind { K if f(&mut pcx) => .. }`): Rust keeps the
// scrutinee's place borrowed through the guards (rustc E0502 against the
// guard's `&mut`), so the value is matched, `match { pcx.nodes[n].kind }`.
fn edit_match_copy(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].a;
    if s <= 0 || pcx.nodes[s].end <= pcx.nodes[s].start || !editable(pcx.nodes[s].start, &pcx) {
        return;
    }
    let k = pcx.nodes[s].kind;
    if k != NodeKind::FieldAccess && k != NodeKind::Index {
        return;
    }
    let t = pcx.nodes[s].ty;
    if t <= 0 || is_ref(t, pcx) || !crate::front::conv::copyable(t, &pcx) {
        return;
    }
    var guarded = false;
    for i in 0..pcx.nodes[n].count {
        let arm = child(n, i, pcx);
        if arm > 0 && pcx.nodes[arm].kind == NodeKind::Arm && pcx.nodes[arm].b > 0 {
            guarded = true;
        }
    }
    if guarded && put_first(pcx.nodes[s].start, "{ ", &tr, &pcx) {
        put(pcx.nodes[s].end, pcx.nodes[s].end, " }", -1, &tr, &pcx);
    }
}

// (0.27.5) An argument MVS marks `&` for a parameter taken inout whose
// `&` the checker took into its view of an array (`first(&a)`,
// `first(&[1, 2, 3][..])` to `v: inout [i64]`): `&mut`, as Rust's
// `&mut [T]` takes (rustc E0308: types differ in mutability). A written
// Unary `&` is edit_amp's.
fn edit_inout_args(c: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if pcx.nodes[c].end <= pcx.nodes[c].start {
        return;
    }
    let f = pcx.nodes[c].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
    let fnode = pcx.fns[g].node;
    if fnode <= 0 {
        return;
    }
    for i in 0..pcx.nodes[c].count {
        let a = child(c, i, pcx);
        if a <= 0 || pcx.nodes[a].kind == NodeKind::Unary
            || pcx.nodes[a].end <= pcx.nodes[a].start {
            continue;
        }
        let p = param_of(fnode, c, a, pcx);
        let t = if p > 0 { pcx.nodes[p].b } else { 0 };
        // (`inout [i64]`, a slice type written with its mode; `inout T`)
        if t <= 0 || !word_here(pcx.nodes[t].start, "inout")
            && (pcx.nodes[t].kind != NodeKind::TyPtr || SRC[pcx.nodes[t].start] == '*') {
            continue;
        }
        // (the view starts after the marker: `&` just before it, itself an
        // argument's start, after `(` or `,`; not a `&` operator's)
        let q = pcx.nodes[a].start - 1;
        var w = q - 1;
        while w > 0 && SRC[w] == ' ' {
            w -= 1;
        }
        if q > 0 && SRC[q] == '&' && (SRC[w] == '(' || SRC[w] == ',') {
            put(q + 1, q + 1, "mut ", TC_MUT_MARKER, &tr, &pcx);
        }
    }
}

// (0.27.5) A path given to std::fs as bytes, a value declared `[u8]`
// (MVS's fs takes `path: [u8]`): std2's takes a `&str` until std::path,
// so it is `str::from_utf8(p).unwrap()`. A literal is text already. The
// same for std::process's program and arguments (std2's are &str).
fn edit_std_path(c: i64, d: TextDecls, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if tr.text_mode || pcx.nodes[c].end <= pcx.nodes[c].start {
        return;
    }
    let f = pcx.nodes[c].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return;
    }
    let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
    let fnode = pcx.fns[g].node;
    if fnode <= 0 || editable(pcx.nodes[fnode].start, &pcx) || !in_std_module(g, "std::fs", pcx)
        && !in_std_module(g, "std::process", pcx) {
        return;
    }
    for i in 0..pcx.nodes[c].count {
        let a = child(c, i, pcx);
        let p = if a > 0 { param_of(fnode, c, a, pcx) } else { 0 };
        if p <= 0 || pcx.nodes[p].b <= 0 || pcx.nodes[pcx.nodes[p].b].kind != NodeKind::TySlice {
            continue;
        }
        let nm = crate::base::sym_text(pcx.nodes[p].a, pcx);
        let fs = in_std_module(g, "std::fs", pcx);
        if fs && nm != "path" && nm != "from" && nm != "to" && nm != "dir"
            || !fs && nm != "prog" && nm != "a" && nm != "name" {
            continue;
        }
        // (std::process: Command::new, arg and env_remove, whose bytes are
        // any value not written as text: a Vec<[u8]> element, an args_os item)
        if fs && declared_bytes(a, 0, d, pcx)
            || !fs && pcx.nodes[a].kind != NodeKind::Str && !declared_str(a, 0, d, tr, &pcx) {
            put(pcx.nodes[a].start, pcx.nodes[a].start, "str::from_utf8(", TC_UTF8, &tr, &pcx);
            put(pcx.nodes[a].end, pcx.nodes[a].end, ").unwrap()", TC_UTF8, &tr, &pcx);
        }
    }
}

// (0.27.5) A value declared `str` given where bytes are declared,
// `int_method(out, p, ..)` of a `p: str` to a `[u8]` parameter: its
// bytes, `p.as_bytes()` (F0.6, rustc E0308).
fn edit_text_to_bytes(n: i64, d: TextDecls, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let t = pcx.nodes[n].ty;
    if tr.text_mode || t <= 0 || pcx.types[t].kind != TyKind::Slice || pcx.types[t].a != TY_U8
        || !declared_str(n, 0, d, tr, &pcx) || !bytes_go(n, 0, 0, d, tr, &pcx) {
        return;
    }
    put(pcx.nodes[n].end, pcx.nodes[n].end, ".as_bytes()", TC_BYTES, &tr, &pcx);
}

// A text literal MVS types as bytes, `[u8]`, given where the program
// takes bytes (a parameter, the type written for a let, a static or a
// constant, or for its array's elements, a result of `[u8]`) is
// `b".."` (a literal is a str in the rust edition); so is a branch of an
// `if` whose other branch is written or declared bytes, and any literal
// whose value goes where bytes are declared (bytes_go: `s == ".vl"` of
// an `s: [u8]`, a branch, an element, a field, an assignment).
fn edit_str(n: i64, d: TextDecls, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if tr.text_mode {
        return;
    }
    let t = pcx.nodes[n].ty;
    if t <= 0 || pcx.types[t].kind != TyKind::Slice || pcx.types[t].a != TY_U8
        || SRC[pcx.nodes[n].start] != '"' {
        return;
    }
    let p = parent_of(n, tr);
    if p <= 0 {
        return;
    }
    let pk = pcx.nodes[p].kind;
    var bytes = false;
    if pk == NodeKind::Call {
        var f = pcx.nodes[p].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 {
            if pcx.fns[f].tmpl > 0 {
                f = pcx.fns[f].tmpl - 1;
            }
            let fnode = pcx.fns[f].node;
            bytes = fnode > 0 && editable(pcx.nodes[fnode].start, &pcx)
                && param_is_slice(fnode, p, n, pcx);
        }
    } else if pk == NodeKind::Let || pk == NodeKind::Static || pk == NodeKind::Const {
        let ann = pcx.nodes[p].b;
        bytes = ann > 0 && pcx.nodes[ann].kind == NodeKind::TySlice;
    } else if pk == NodeKind::Array {
        // (an element of a static or constant written `[[u8]; N]`)
        let q = parent_of(p, tr);
        let ann = if q > 0 && (pcx.nodes[q].kind == NodeKind::Static
            || pcx.nodes[q].kind == NodeKind::Const) { pcx.nodes[q].b } else { 0 };
        bytes = ann > 0 && pcx.nodes[ann].kind == NodeKind::TyArray && pcx.nodes[ann].a > 0
            && pcx.nodes[pcx.nodes[ann].a].kind == NodeKind::TySlice;
    } else if pk == NodeKind::Block && pcx.nodes[p].a == n && if_other(p, tr, pcx) > 0 {
        // (a branch of an `if` the other branch of which is bytes,
        // `if c { "" } else { sym_text(s) }`)
        let o = if_other(p, tr, pcx);
        bytes = written_bytes(if pcx.nodes[o].kind == NodeKind::Block { pcx.nodes[o].a } else { o },
            pcx) || declared_bytes(o, 0, d, pcx);
        if !bytes {
            let f = enclosing_fn(pcx.nodes[n].start, pcx);
            let r = if f > 0 { pcx.nodes[f].b } else { 0 };
            bytes = r > 0 && pcx.nodes[r].kind == NodeKind::TySlice;
        }
    } else if pk == NodeKind::Block && pcx.nodes[p].a == n || pk == NodeKind::Return {
        let f = enclosing_fn(pcx.nodes[n].start, pcx);
        let r = if f > 0 { pcx.nodes[f].b } else { 0 };
        bytes = r > 0 && pcx.nodes[r].kind == NodeKind::TySlice;
    }
    if !bytes {
        bytes = bytes_go(n, 0, 0, d, tr, &pcx);
    }
    if !bytes {
        return;
    }
    // (0.27.3, FL12: `b".."`, a literal of ASCII; else `"..".as_bytes()`)
    var ascii = true;
    for q in pcx.nodes[n].start..pcx.nodes[n].end {
        if SRC[q] >= 128 || SRC[q] == '\\' && q + 1 < pcx.nodes[n].end && SRC[q + 1] == 'u' {
            ascii = false;
        }
    }
    if ascii {
        put(pcx.nodes[n].start, pcx.nodes[n].start, "b", TC_BYTES, &tr, &pcx);
    } else {
        put(pcx.nodes[n].end, pcx.nodes[n].end, ".as_bytes()", TC_BYTES, &tr, &pcx);
    }
}

// (0.27.5) Whether character literal n is the pattern of std's method on
// text, `s.split('|')` of an `s: str`: a char in Rust (a Pattern), not
// the byte MVS types it as.
fn char_pattern(n: i64, d: TextDecls, tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    let c = parent_of(n, tr);
    if c <= 0 || pcx.nodes[c].kind != NodeKind::Call || pcx.nodes[c].count < 2 {
        return false;
    }
    let r = child(c, 0, pcx);
    if r == n || pcx.nodes[r].start != pcx.nodes[c].start || pcx.nodes[r].end >= pcx.nodes[c].end
        || SRC[pcx.nodes[r].end] != '.' {
        return false;
    }
    let f = pcx.nodes[c].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 {
        return false;
    }
    let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
    let fnode = pcx.fns[g].node;
    fnode > 0 && !editable(pcx.nodes[fnode].start, &pcx) && declared_str(r, 0, d, tr, &pcx)
}

// A character literal MVS types as a byte, `'a'`, is `b'a'`; as a code
// point (u32) `'a' as u32` (a char in the rust edition); as another
// integer `b'a' as i64`; a pattern of std's method on text, `s.split('|')`,
// stays a char.
fn edit_char(n: i64, d: TextDecls, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let s = pcx.nodes[n].start;
    let t = pcx.nodes[n].ty;
    if SRC[s] != '\'' || token_at(s, pcx) < 0 {
        return;
    }
    if t == TY_U8 {
        if char_pattern(n, d, tr, &pcx) {
            return;
        }
        put(s, s, "b", TC_BYTES, &tr, &pcx);
    } else if t == crate::front::types::TY_U32 {
        put(pcx.nodes[n].end, pcx.nodes[n].end, " as u32", TC_BYTES, &tr, &pcx);
    } else if t >= TY_I8 && t <= TY_U64 || t == TY_ISIZE || t == crate::front::types::TY_USIZE {
        // (another integer's, `c == 'a'` of an i64: the byte, cast)
        let w = buf_new();
        buf_bytes(w, " as ");
        crate::front::types::buf_type(w, t, pcx);
        // (a code point past ASCII, `'é'`, or `\u{..}`: the char, cast)
        let ascii = SRC[s + 1] < 128 && !(SRC[s + 1] == '\\' && SRC[s + 2] == 'u');
        if !ascii || put(s, s, "b", TC_BYTES, &tr, &pcx) {
            put(pcx.nodes[n].end, pcx.nodes[n].end, buf_slice(w), TC_BYTES, &tr, &pcx);
        }
    }
}

// An integer literal MVS types by its context as another type than i64,
// given to a std function (a generic one, `assert_eq(v.len(), 2)`): its
// type as a suffix, `2usize` (the rust edition infers no further).
fn edit_int(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let t = pcx.nodes[n].ty;
    if pcx.nodes[n].b != 0 || t <= 0 || t == TY_I64 || !crate::front::types::is_integer(t)
        || token_at(pcx.nodes[n].start, pcx) < 0 {
        return;
    }
    let k = token_at(pcx.nodes[n].start, pcx);
    if pcx.toks[k].kind != Tok::Int || pcx.toks[k].end != pcx.nodes[n].end {
        return;
    }
    var p = parent_of(n, tr);
    if p > 0 && pcx.nodes[p].kind == NodeKind::Unary && SRC[pcx.nodes[p].start] != '-' {
        p = parent_of(p, tr);
    }
    if p <= 0 || pcx.nodes[p].kind != NodeKind::Call {
        return;
    }
    let f = pcx.nodes[p].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 || pcx.fns[f].node > 0
        && editable(pcx.nodes[pcx.fns[f].node].start, &pcx) {
        return;
    }
    let b = crate::base::buf_new();
    crate::front::types::buf_type(b, t, pcx);
    put(pcx.nodes[n].end, pcx.nodes[n].end, crate::base::buf_slice(b), TC_INT, &tr, &pcx);
}

// An i64 literal outside i32 cast to another type, `0xffffffffffffffff as
// u64`: the rust edition's literal is i32 under a cast (rustc's
// overflowing_literals), so it gets a suffix, `i64`, or `u64` when it is
// written above i64::MAX (MVS's bits, -1 here, which the cast keeps).
fn edit_int_cast(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if pcx.nodes[n].b != 0 || pcx.nodes[n].ty != TY_I64 || token_at(pcx.nodes[n].start, pcx) < 0 {
        return;
    }
    let v = pcx.nodes[n].a;
    if v >= 0 && v <= 2147483647 {
        return;
    }
    let p = parent_of(n, tr);
    if p <= 0 || pcx.nodes[p].kind != NodeKind::Cast || pcx.nodes[p].a != n {
        return;
    }
    let k = token_at(pcx.nodes[n].start, pcx);
    if pcx.toks[k].kind != Tok::Int || pcx.toks[k].end != pcx.nodes[n].end {
        return;
    }
    put(pcx.nodes[n].end, pcx.nodes[n].end, if v < 0 { "u64" } else { "i64" }, TC_INT, &tr,
        &pcx);
}

// (FL6) An i64 literal at a generic position, which the rust edition
// would type by its own default or a later use, gets MVS's i64 as a
// suffix, `1i64`: a value given to a type parameter (`Some(4)`,
// `fold(0, ..)`, `Vec::from_in([1, 2], a)`), a generic struct's field
// (`W { x: 7 }`), a range or literal receiver (`(0..n).map(..)`).
fn edit_int_generic(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if pcx.nodes[n].b != 0 || pcx.nodes[n].ty != TY_I64 {
        return;
    }
    let k = token_at(pcx.nodes[n].start, pcx);
    if k < 0 || pcx.toks[k].kind != Tok::Int || pcx.toks[k].end != pcx.nodes[n].end {
        return;
    }
    // (through a sign, an array, a tuple or a range to what takes them)
    var c = n;
    var p = parent_of(n, tr);
    while p > 0 && (pcx.nodes[p].kind == NodeKind::Unary && SRC[pcx.nodes[p].start] == '-'
        || pcx.nodes[p].kind == NodeKind::Array || pcx.nodes[p].kind == NodeKind::Tuple
        || pcx.nodes[p].kind == NodeKind::Range) {
        c = p;
        p = parent_of(p, tr);
    }
    if p <= 0 || !generic_place(c, p, tr, pcx) {
        return;
    }
    put(pcx.nodes[n].end, pcx.nodes[n].end, "i64", TC_INT, &tr, &pcx);
}

// (FL6) An array of literals MVS types as i64 elements, `[1, 2, 3]` or
// `[0; 4]`: its first element's suffix, `[1i64, 2, 3]`, which types them
// all (the rust edition, slicing or lending it, would take i32).
fn edit_int_array(n: i64, tr: inout Tr, pcx: inout Ctx<Comp>) {
    let t = pcx.nodes[n].ty;
    if t <= 0 || pcx.types[t].kind != TyKind::Array || pcx.types[t].a != TY_I64
        || token_at(pcx.nodes[n].start, pcx) < 0 || SRC[pcx.nodes[n].start] != '[' {
        return;
    }
    let first = if pcx.nodes[n].kind == NodeKind::Repeat { pcx.nodes[n].a }
        else if pcx.nodes[n].count > 0 { child(n, 0, pcx) } else { 0 };
    if first <= 0 || pcx.nodes[first].kind != NodeKind::Int || pcx.nodes[first].b != 0 {
        return;
    }
    let k = token_at(pcx.nodes[first].start, pcx);
    if k < 0 || pcx.toks[k].kind != Tok::Int || pcx.toks[k].end != pcx.nodes[first].end {
        return;
    }
    put(pcx.nodes[first].end, pcx.nodes[first].end, "i64", TC_INT, &tr, &pcx);
}

// Whether field `name` of the generic struct type t is declared with one
// of its type parameters (`struct W<T> { x: T }`: x), which a literal
// there would fix.
fn generic_field(t: i64, name: i64, pcx: Ctx<Comp>) -> bool {
    let si = pcx.types[t].a;
    if pcx.structs[si].tmpl <= 0 {
        return false;
    }
    let sn = pcx.structs[pcx.structs[si].tmpl - 1].node;
    let g = if sn > 0 { pcx.nodes[sn].g } else { 0 };
    if g <= 0 {
        return false;
    }
    for i in 0..pcx.nodes[sn].count {
        let f = child(sn, i, pcx);
        if pcx.nodes[f].kind == NodeKind::Field && pcx.nodes[f].a == name && pcx.nodes[f].b > 0 {
            let ft = pcx.nodes[f].b;
            for j in 0..pcx.nodes[g].count {
                if pcx.nodes[ft].kind == NodeKind::TyName
                    && pcx.nodes[child(g, j, pcx)].a == pcx.nodes[ft].a {
                    return true;
                }
            }
        }
    }
    false
}

// Whether c, a part of p, is at a generic position of p.
fn generic_place(c: i64, p: i64, tr: Tr, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[p].kind;
    if k == NodeKind::VariantLit {
        return true;
    }
    if k == NodeKind::FieldInit {
        let s = parent_of(p, tr);
        let t = if s > 0 { pcx.nodes[s].ty } else { 0 };
        return t > 0 && pcx.types[t].kind == TyKind::Struct
            && generic_field(t, pcx.nodes[p].a, pcx);
    }
    if k != NodeKind::Call || pcx.nodes[p].a == c {
        return false;
    }
    // (a receiver: `(0..n).map(..)`, `5.max(x)`)
    if pcx.nodes[p].a == 0 && pcx.nodes[p].count > 0 && child(p, 0, pcx) == c {
        return true;
    }
    let f = pcx.nodes[p].x - 1;
    if f < 0 {
        // (a variant's constructor, `Some(4)`)
        return true;
    }
    if f >= pcx.fns.len() as i64 || pcx.fns[f].tmpl <= 0 {
        return false;
    }
    let tn = pcx.fns[pcx.fns[f].tmpl - 1].node;
    if tn <= 0 {
        return false;
    }
    // (type parameters of its own, or an impl's that no receiver fixes)
    let g = pcx.nodes[tn].g;
    let own = if g > 0 { pcx.nodes[g].count - pcx.nodes[g].a } else { 0 };
    let first = if pcx.nodes[tn].count > 0 { child(tn, 0, pcx) } else { 0 };
    let receiver = first > 0 && pcx.nodes[first].kind == NodeKind::Param
        && pcx.nodes[first].a == tr.sym_self;
    own > 0 || !receiver && g > 0
}

// ---- Text or bytes ----

fn byte_slice(t0: i64, pcx: Ctx<Comp>) -> bool {
    var t = t0;
    if t > 0 && pcx.types[t].kind == TyKind::Ptr {
        t = pcx.types[t].a;
    }
    t > 0 && pcx.types[t].kind == TyKind::Slice && pcx.types[t].a == TY_U8
}

// Whether type t holds bytes as a container: a Vec<u8, A>, a Buf, an array
// of u8.
fn byte_container(t0: i64, pcx: Ctx<Comp>) -> bool {
    var t = t0;
    if t > 0 && pcx.types[t].kind == TyKind::Ptr {
        t = pcx.types[t].a;
    }
    if t <= 0 {
        return false;
    }
    if pcx.types[t].kind == TyKind::Array {
        return pcx.types[t].a == TY_U8;
    }
    crate::front::conv::container_elem(t, pcx) == TY_U8
}

// (the approved rule: `[u8]` is `&str` only when every use agrees) Whether
// the program uses its `[u8]` values as text alone: no byte read by index,
// no loop over one, no view of a byte container (a Vec<u8>'s, an array's),
// no byte method (`iter`, `as_ptr`, `extend_from_slice`).
pub fn text_program(tr: Tr, pcx: inout Ctx<Comp>) -> bool {
    var any = false;
    for n in 1..pcx.nodes.len() as i64 {
        if !own_node(n, tr, &pcx) {
            continue;
        }
        let k = pcx.nodes[n].kind;
        if k == NodeKind::TySlice {
            let e = pcx.nodes[n].a;
            if e > 0 && SRC[pcx.nodes[e].start..pcx.nodes[e].end] == "u8" {
                any = true;
            }
        } else if k == NodeKind::Index {
            let b = pcx.nodes[n].a;
            let i = pcx.nodes[n].b;
            let range = i > 0 && pcx.nodes[i].kind == NodeKind::Range;
            if b > 0 && !range && byte_slice(pcx.nodes[b].ty, pcx) {
                return false;
            }
            if b > 0 && range && byte_container(pcx.nodes[b].ty, pcx) {
                return false;
            }
        } else if k == NodeKind::For {
            let c = pcx.nodes[n].c;
            if c > 0 && (byte_slice(pcx.nodes[c].ty, pcx)
                || pcx.nodes[c].kind == NodeKind::Let && pcx.nodes[c].c > 0
                && byte_slice(pcx.nodes[pcx.nodes[c].c].ty, pcx)) {
                return false;
            }
        } else if k == NodeKind::Call && pcx.nodes[n].a == 0 && pcx.nodes[n].count > 0
            && pcx.nodes[n].b > 0 {
            let m = crate::base::sym_text(pcx.nodes[n].b, pcx);
            let r = child(n, 0, pcx);
            if byte_slice(pcx.nodes[r].ty, pcx) && (m == "iter" || m == "as_ptr" || m == "to_vec_in"
                || m == "get" || m == "first" || m == "last") {
                return false;
            }
            if m == "extend_from_slice" || m == "as_slice" && byte_container(pcx.nodes[r].ty, pcx) {
                return false;
            }
        }
        // (0.27.5) bytes std2 gives as bytes: args_os's items (`&[u8]`),
        // which no `&str` takes
        if k == NodeKind::Call && pcx.nodes[n].x > 0 && pcx.nodes[n].x <= pcx.fns.len() as i64
            && crate::base::sym_text(pcx.fns[pcx.nodes[n].x - 1].name, pcx) == "std.env.args_os" {
            return false;
        }
    }
    any
}

// Whether type node tn is written `str` (a text view: `&str` in the rust
// edition; the checker's type, erased, is `[u8]`).
fn str_type_node(tn: i64, pcx: Ctx<Comp>) -> bool {
    tn > 0 && pcx.nodes[tn].kind == NodeKind::TyName
        && SRC[pcx.nodes[tn].start..pcx.nodes[tn].end] == "str"
}

// The program's bindings and fields declared `str` or `[u8]` (what an
// expression's erased `[u8]` type was written as): binds holds from, to,
// name and the Param, Let or PatBind node of each binding, in [from, to) its
// scope (its block or function); fields the field names declared `str`
// (1), `[u8]` (2) or both (3); statics the statics and constants written
// `[u8]` (1) or `[[u8]; N]` (2); tuples a tuple pattern's PatBinds whose
// part of the function's result is written `[u8]` (1) or `str` (2).
pub struct TextDecls { binds: IntVec, fields: HMap, statics: HMap, tuples: HMap }

// (0.27.5) Whether part i of the tuple e makes is a text literal in every
// branch: `if c { ("len()", m) } else { ("", 0) }`, which a tuple pattern
// binds as text.
fn tuple_part_text(e: i64, i: i64, depth: i64, pcx: Ctx<Comp>) -> bool {
    if e <= 0 || depth > 32 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Tuple {
        let c = if i < pcx.nodes[e].count { child(e, i, pcx) } else { 0 };
        return c > 0 && pcx.nodes[c].kind == NodeKind::Str && SRC[pcx.nodes[c].start] == '"';
    }
    if k == NodeKind::If {
        return pcx.nodes[e].c > 0 && tuple_part_text(pcx.nodes[e].b, i, depth + 1, pcx)
            && tuple_part_text(pcx.nodes[e].c, i, depth + 1, pcx);
    }
    if k == NodeKind::Block {
        return tuple_part_text(pcx.nodes[e].a, i, depth + 1, pcx);
    }
    false
}

// (0.27.5) The bindings of let n's tuple pattern pat, `let (word, end) =
// word_at(text, q);`, into d: each with its PatBind node, and in
// d.tuples as the function's result writes its part, `[u8]` (1) or `str`
// (2), or as text (2) when the value is a tuple of text literals there.
fn tuple_decls(n: i64, pat: i64, d: inout TextDecls, tr: Tr, pcx: inout Ctx<Comp>) {
    let scope = parent_of(n, tr);
    if scope <= 0 {
        return;
    }
    let init = pcx.nodes[n].c;
    var rt: i64 = 0;
    if init > 0 && pcx.nodes[init].kind == NodeKind::Call {
        let f = pcx.nodes[init].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 {
            let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
            let fnode = pcx.fns[g].node;
            let t = if fnode > 0 { pcx.nodes[fnode].b } else { 0 };
            if t > 0 && pcx.nodes[t].kind == NodeKind::TyTuple {
                rt = t;
            }
        }
    }
    for i in 0..pcx.nodes[pat].count {
        let b = child(pat, i, pcx);
        if b <= 0 || pcx.nodes[b].kind != NodeKind::PatBind {
            continue;
        }
        d.binds.push(pcx.nodes[n].start);
        d.binds.push(pcx.nodes[scope].end);
        d.binds.push(pcx.nodes[b].a);
        d.binds.push(b);
        let part = if rt > 0 && i < pcx.nodes[rt].count { child(rt, i, pcx) } else { 0 };
        if str_type_node(part, pcx) || rt == 0 && tuple_part_text(init, i, 0, pcx) {
            d.tuples.put(b + 1, 2);
        } else if part > 0 && pcx.nodes[part].kind == NodeKind::TySlice {
            d.tuples.put(b + 1, 1);
        }
    }
}

pub fn text_decls(tr: Tr, pcx: inout Ctx<Comp>) -> TextDecls {
    var d = TextDecls {
        binds: IntVec { data: 0 as *i64, count: 0, cap: 0 },
        fields: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        statics: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
        tuples: HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 },
    };
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if k == NodeKind::Field {
            let t = pcx.nodes[n].b;
            let w = if str_type_node(t, pcx) {
                1
            } else if t > 0 && pcx.nodes[t].kind == NodeKind::TySlice { 2 } else { 0 };
            if w > 0 {
                let key = pcx.nodes[n].a + 1;
                d.fields.put(key, d.fields.get(key) | w);
            }
            continue;
        }
        if k == NodeKind::Static || k == NodeKind::Const {
            // (`SRC[a..b]`, `KNOWN[i]`)
            let t = pcx.nodes[n].b;
            if t > 0 && pcx.nodes[t].kind == NodeKind::TySlice {
                d.statics.put(pcx.nodes[n].a + 1, 1);
            } else if t > 0 && pcx.nodes[t].kind == NodeKind::TyArray && pcx.nodes[t].a > 0
                && pcx.nodes[pcx.nodes[t].a].kind == NodeKind::TySlice {
                d.statics.put(pcx.nodes[n].a + 1, 2);
            }
            continue;
        }
        if !own_node(n, tr, &pcx) {
            continue;
        }
        var name: i64 = -1;
        if k == NodeKind::Param {
            name = pcx.nodes[n].a;
        } else if k == NodeKind::Let {
            let pat = pcx.nodes[n].a;
            if pat > 0 && pcx.nodes[pat].kind == NodeKind::PatBind {
                name = pcx.nodes[pat].a;
            } else if pat > 0 && pcx.nodes[pat].kind == NodeKind::PatTuple {
                tuple_decls(n, pat, &d, tr, &pcx);
            }
        } else if k == NodeKind::Arm {
            // (`Some(spec) =>` of a match on an Option<str>: text, in the arm)
            let p = pcx.nodes[n].a;
            let b = if p > 0 && pcx.nodes[p].kind == NodeKind::PatVariant
                && pcx.nodes[p].count == 1 { child(p, 0, pcx) } else { 0 };
            if b > 0 && pcx.nodes[b].kind == NodeKind::PatBind && arm_str_binding(b, tr, pcx) {
                d.binds.push(pcx.nodes[n].start);
                d.binds.push(pcx.nodes[n].end);
                d.binds.push(pcx.nodes[b].a);
                d.binds.push(b);
                d.tuples.put(b + 1, 2);
            }
            continue;
        }
        let scope = parent_of(n, tr);
        if name < 0 || scope <= 0 {
            continue;
        }
        d.binds.push(pcx.nodes[n].start);
        d.binds.push(pcx.nodes[scope].end);
        d.binds.push(name);
        d.binds.push(n);
    }
    d
}

// Whether expression e of the erased type `[u8]` was not written `[u8]`
// where it is declared (a `str`, which is `&str` in the rust edition, or a
// type parameter whose instance has it): a binding (its type, or its
// initializer's), a field, a function's result.
pub fn declared_text(e: i64, depth: i64, d: TextDecls, pcx: Ctx<Comp>) -> bool {
    if e <= 0 || depth > 4 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident {
        let pos = pcx.nodes[e].start;
        var best: i64 = -1;
        var i: i64 = 0;
        while i + 3 < d.binds.count {
            if d.binds.get(i + 2) == pcx.nodes[e].a && d.binds.get(i) <= pos
                && pos < d.binds.get(i + 1) && (best < 0 || d.binds.get(i) > d.binds.get(best)) {
                best = i;
            }
            i += 4;
        }
        if best < 0 {
            return false;
        }
        let b = d.binds.get(best + 3);
        if pcx.nodes[b].kind == NodeKind::PatBind {
            return d.tuples.get(b + 1) == 2;
        }
        if pcx.nodes[b].kind == NodeKind::Param || pcx.nodes[b].b > 0 {
            let t = pcx.nodes[b].b;
            return t <= 0 || pcx.nodes[t].kind != NodeKind::TySlice;
        }
        return declared_text(pcx.nodes[b].c, depth + 1, d, pcx);
    }
    if k == NodeKind::FieldAccess {
        let name = pcx.nodes[e].b;
        let w = d.fields.get(name + 1);
        if w != 3 {
            return w != 2;
        }
        // (a name declared both ways: the receiver's struct's field)
        var t = pcx.nodes[pcx.nodes[e].a].ty;
        if t > 0 && pcx.types[t].kind == TyKind::Ptr {
            t = pcx.types[t].a;
        }
        if t <= 0 || pcx.types[t].kind != TyKind::Struct {
            return false;
        }
        let s = pcx.types[t].a;
        let sn = pcx.structs[if pcx.structs[s].tmpl > 0 { pcx.structs[s].tmpl - 1 } else { s }].node;
        for i in 0..if sn > 0 { pcx.nodes[sn].count } else { 0 } {
            let f = child(sn, i, pcx);
            if pcx.nodes[f].kind == NodeKind::Field && pcx.nodes[f].a == name {
                let t = pcx.nodes[f].b;
                return t <= 0 || pcx.nodes[t].kind != NodeKind::TySlice;
            }
        }
        return false;
    }
    if k == NodeKind::Call {
        let f = pcx.nodes[e].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 {
            let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
            let fnode = pcx.fns[g].node;
            let t = if fnode > 0 { pcx.nodes[fnode].b } else { 0 };
            return t > 0 && pcx.nodes[t].kind != NodeKind::TySlice;
        }
    }
    false
}

// (0.27.5) The binding in d that Ident e names, its index in d.binds
// (the innermost one whose scope holds e), or -1: a static, a function.
fn bound_at(e: i64, d: TextDecls, pcx: Ctx<Comp>) -> i64 {
    let pos = pcx.nodes[e].start;
    var best: i64 = -1;
    var i: i64 = 0;
    while i + 3 < d.binds.count {
        if d.binds.get(i + 2) == pcx.nodes[e].a && d.binds.get(i) <= pos
            && pos < d.binds.get(i + 1) && (best < 0 || d.binds.get(i) > d.binds.get(best)) {
            best = i;
        }
        i += 4;
    }
    best
}

// (0.27.5) Whether branch b of an `if` is a text literal edit_str writes
// `b".."`: its other branch o is a call written `[u8]`
// (`if c { "" } else { sym_text(s) }`) or declared bytes.
fn byte_literal_branch(b: i64, o: i64, depth: i64, d: TextDecls, pcx: Ctx<Comp>) -> bool {
    if b <= 0 || o <= 0 || pcx.nodes[b].kind != NodeKind::Block {
        return false;
    }
    let t = pcx.nodes[b].a;
    if t <= 0 || SRC[pcx.nodes[t].start] != '"' {
        return false;
    }
    written_bytes(if pcx.nodes[o].kind == NodeKind::Block { pcx.nodes[o].a } else { o }, pcx)
        || declared_bytes(o, depth + 1, d, pcx)
}

// (0.27.5) Whether expression e of the erased type `[u8]` is bytes where
// it is declared, positively: a binding written `[u8]` (or initialized
// so), a field declared `[u8]`, a call of a function whose result is
// written `[u8]` (or of a function value), a part of such a value or of a
// Vec or a buffer, a block's value that is, a static or constant written
// `[u8]` or an element of one written `[[u8]; N]`, a borrow of such a
// value, an `if` both of whose branches are (or one is and the other a
// literal edit_str writes `b".."`). Not a literal, a pattern's binding
// or an element of a local array of views: they may be text, and `str::from_utf8("..")` is no Rust (0.27.4's gate 2: 230 of
// the rustc twin's rejections).
fn declared_bytes(e: i64, depth: i64, d: TextDecls, pcx: Ctx<Comp>) -> bool {
    if e <= 0 || depth > 8 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Ident {
        let best = bound_at(e, d, pcx);
        if best < 0 {
            return d.statics.get(pcx.nodes[e].a + 1) == 1;
        }
        let b = d.binds.get(best + 3);
        if pcx.nodes[b].kind == NodeKind::PatBind {
            return d.tuples.get(b + 1) == 1;
        }
        if pcx.nodes[b].kind == NodeKind::Param || pcx.nodes[b].b > 0 {
            let t = pcx.nodes[b].b;
            return t > 0 && pcx.nodes[t].kind == NodeKind::TySlice;
        }
        return declared_bytes(pcx.nodes[b].c, depth + 1, d, pcx);
    }
    if k == NodeKind::FieldAccess {
        let w = d.fields.get(pcx.nodes[e].b + 1);
        if w == 2 {
            return true;
        }
        return w == 3 && !declared_text(e, depth, d, pcx);
    }
    if k == NodeKind::Call {
        // (a function value's call, `h(e)`: no declaration to read, bytes as
        // its type says)
        let f = pcx.nodes[e].x - 1;
        return f < 0 || f >= pcx.fns.len() as i64 || written_bytes(e, pcx);
    }
    if k == NodeKind::Block {
        // (the checker's form of a call such as `nm(e).unwrap()`: its tail)
        return pcx.nodes[e].a > 0 && declared_bytes(pcx.nodes[e].a, depth + 1, d, pcx);
    }
    if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Amp {
        return declared_bytes(pcx.nodes[e].b, depth + 1, d, pcx);
    }
    if k == NodeKind::Unary && pcx.nodes[e].op == Tok::Star {
        // (what a raw pointer written `*[u8]` points to, `*message`)
        let o = pcx.nodes[e].b;
        let best = if o > 0 && pcx.nodes[o].kind == NodeKind::Ident { bound_at(o, d, pcx) }
            else { -1 };
        let b = if best >= 0 { d.binds.get(best + 3) } else { 0 };
        let t = if b > 0 && pcx.nodes[b].kind != NodeKind::PatBind { pcx.nodes[b].b } else { 0 };
        return t > 0 && pcx.nodes[t].kind == NodeKind::TyPtr && pcx.nodes[t].a > 0
            && pcx.nodes[pcx.nodes[t].a].kind == NodeKind::TySlice;
    }
    if k == NodeKind::If {
        // (both branches, `if c { &s[1..] } else { s }`, a literal one only
        // where edit_str writes it `b".."`)
        let b = pcx.nodes[e].b;
        let c = pcx.nodes[e].c;
        return c > 0
            && (declared_bytes(b, depth + 1, d, pcx) || byte_literal_branch(b, c, depth, d, pcx))
            && (declared_bytes(c, depth + 1, d, pcx) || byte_literal_branch(c, b, depth, d, pcx));
    }
    if k == NodeKind::Index {
        let a = pcx.nodes[e].a;
        let r = pcx.nodes[e].b;
        if a > 0 && r > 0 && pcx.nodes[r].kind != NodeKind::Range {
            // (an element of a static or constant written `[[u8]; N]`)
            return pcx.nodes[a].kind == NodeKind::Ident && bound_at(a, d, pcx) < 0
                && d.statics.get(pcx.nodes[a].a + 1) == 2;
        }
        if a <= 0 || r <= 0 {
            return false;
        }
        let at = pcx.nodes[a].ty;
        return at > 0 && pcx.types[at].kind != TyKind::Slice
            || declared_bytes(a, depth + 1, d, pcx);
    }
    false
}

// Whether expression e is positively bytes where it is declared: a call of
// a function whose result is written `[u8]`, or a parameter written so.
fn written_bytes(e: i64, pcx: Ctx<Comp>) -> bool {
    if e <= 0 {
        return false;
    }
    let k = pcx.nodes[e].kind;
    if k == NodeKind::Call {
        let f = pcx.nodes[e].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            return false;
        }
        let g = if pcx.fns[f].tmpl > 0 { pcx.fns[f].tmpl - 1 } else { f };
        let fnode = pcx.fns[g].node;
        let t = if fnode > 0 { pcx.nodes[fnode].b } else { 0 };
        return t > 0 && pcx.nodes[t].kind == NodeKind::TySlice;
    }
    if k != NodeKind::Ident {
        return false;
    }
    let f = enclosing_fn(pcx.nodes[e].start, pcx);
    if f <= 0 {
        return false;
    }
    for j in 0..pcx.nodes[f].count {
        let p = child(f, j, pcx);
        if pcx.nodes[p].kind == NodeKind::Param && pcx.nodes[p].a == pcx.nodes[e].a {
            let t = pcx.nodes[p].b;
            return t > 0 && pcx.nodes[t].kind == NodeKind::TySlice;
        }
    }
    false
}

// The other branch of the `if` that block b is a branch of (0: none).
fn if_other(b: i64, tr: Tr, pcx: Ctx<Comp>) -> i64 {
    let q = parent_of(b, tr);
    if q <= 0 || pcx.nodes[q].kind != NodeKind::If || pcx.nodes[q].c <= 0 {
        return 0;
    }
    if pcx.nodes[q].b == b {
        pcx.nodes[q].c
    } else if pcx.nodes[q].c == b {
        pcx.nodes[q].b
    } else {
        0
    }
}

// The `)` closing the call whose format literal holds position pos (in
// the literal), or -1: the literal's end, then its call's `)` at depth 0.
fn literal_call_close(pos: i64) -> i64 {
    let n = SRC.len() as i64;
    var q = pos;
    while q < n && SRC[q] != '"' {
        q += if SRC[q] == '\\' { 2 } else { 1 };
    }
    q += 1;
    var depth = 0;
    while q < n {
        let c = SRC[q];
        if c == '"' {
            q += 1;
            while q < n && SRC[q] != '"' {
                q += if SRC[q] == '\\' { 2 } else { 1 };
            }
        } else if c == '\'' && q + 2 < n && (SRC[q + 2] == '\'' || SRC[q + 1] == '\\') {
            q += if SRC[q + 1] == '\\' { 3 } else { 2 };
        } else if c == '(' || c == '[' || c == '{' {
            depth += 1;
        } else if c == ')' || c == ']' || c == '}' {
            if depth == 0 {
                return if c == ')' { q } else { -1 };
            }
            depth -= 1;
        } else if c == ';' {
            return -1;
        }
        q += 1;
    }
    -1
}

// Whether SRC[a..b) is the one argument of a print of a value,
// `println(x)` (edit_prints gives it its "{}").
fn printed_value(a: i64, b: i64) -> bool {
    var e = b;
    while is_ws(SRC[e]) {
        e += 1;
    }
    var q = a - 1;
    while q > 0 && is_ws(SRC[q]) {
        q -= 1;
    }
    if SRC[e] != ')' || q < 1 || SRC[q] != '(' {
        return false;
    }
    let w = q - 1;
    let len = if word_back(w, "eprintln") {
        8
    } else if word_back(w, "println") {
        7
    } else if word_back(w, "eprint") {
        6
    } else if word_back(w, "print") { 5 } else { 0 };
    let s = w - len;
    len > 0 && (s < 0 || !ident_char(SRC[s]) && SRC[s] != '.')
}

// (0.27.5) Whether hole n is an argument only evaluated (HOLE_EVAL, a
// call with named arguments: `format_args("{} {lv}", name(), lv = 2)`)
// that a Display hole of the same literal reads (its alias). The checker
// makes the evaluated arguments' holes in order, then the literal's
// (front/check/format.vl's build), so they are found by node number.
fn eval_hole_display(n: i64, pcx: Ctx<Comp>) -> bool {
    let eval = crate::front::check::format::HOLE_EVAL;
    if pcx.nodes[n].kind != NodeKind::InterpHole || pcx.nodes[n].b != eval {
        return false;
    }
    var v: i64 = 0;
    while n - v - 1 > 0 && pcx.nodes[n - v - 1].kind == NodeKind::InterpHole
        && pcx.nodes[n - v - 1].b == eval {
        v += 1;
    }
    var aliases = false;
    var j = n + 1;
    while j < pcx.nodes.len() as i64 && j < n + 256 {
        if pcx.nodes[j].kind == NodeKind::InterpHole {
            let b = pcx.nodes[j].b;
            if b == eval {
                if aliases {
                    return false;
                }
            } else if b >= 1024 {
                aliases = true;
                if b / 1024 - 1 == v && (b & 1) == 0 {
                    return true;
                }
            } else {
                return false;
            }
        }
        j += 1;
    }
    false
}

// (0.27.4) A `[u8]` value a program that uses bytes as bytes too prints
// as text (a Display hole, `{x}` or `{}`): Rust's [u8] has no Display, so
// the hole is given `str::from_utf8(x).unwrap()` (MVS's text is UTF-8;
// a byte sequence that is not panics where MVS wrote it), when it is
// bytes where it is declared (declared_bytes: not a literal). A name in the
// literal gets the named argument `x = ..` at the end of the literal's
// call; an argument after the literal is wrapped. One declared `str` is
// a `&str` already; any other is left to hand (TL_BYTES).
fn edit_byte_holes(decls: TextDecls, tr: inout Tr, pcx: inout Ctx<Comp>) {
    if tr.text_mode {
        return;
    }
    var named = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        // (a hole, or the value of `println(x)`, which is `println("{}", x)`)
        let hole = pcx.nodes[n].kind == NodeKind::InterpHole && pcx.nodes[n].b == 0
            || eval_hole_display(n, pcx);
        if !hole && !(pcx.nodes[n].ty > 0 && SRC[pcx.nodes[n].start] != '"'
            && token_at(pcx.nodes[n].start, pcx) >= 0
            && printed_value(pcx.nodes[n].start, pcx.nodes[n].end)) || !own_node(n, tr, &pcx) {
            continue;
        }
        let e = if hole { pcx.nodes[n].a } else { n };
        if e <= 0 || !byte_slice(pcx.nodes[e].ty, pcx) || !editable(pcx.nodes[e].start, &pcx)
            || !declared_bytes(e, 0, decls, pcx) {
            continue;
        }
        let a = pcx.nodes[e].start;
        let b = pcx.nodes[e].end;
        if token_at(a, pcx) >= 0 {
            if put(a, a, "str::from_utf8(", TC_UTF8, &tr, &pcx) {
                put_first(b, ").unwrap()", &tr, &pcx);
            }
            continue;
        }
        let close = if pcx.nodes[e].kind == NodeKind::Ident { literal_call_close(b) } else { -1 };
        if close < 0 {
            left(a, TL_BYTES, &tr, &pcx);
            continue;
        }
        // (once per name and call)
        var key = close;
        for q in a..b {
            key = key * 31 + SRC[q] as i64;
        }
        if named.get(key) != 0 {
            continue;
        }
        named.put(key, 1);
        let t = buf_new();
        buf_bytes(t, ", ");
        buf_bytes(t, SRC[a..b]);
        buf_bytes(t, " = str::from_utf8(");
        buf_bytes(t, SRC[a..b]);
        buf_bytes(t, ").unwrap()");
        // (after what was put there, a positional argument's `).unwrap()`)
        if editable(close, &pcx) && crate::tools::edit::edit_replace(close, close, t, &pcx) {
            tr.counts[TC_UTF8] += 1;
        }
    }
    // (an argument given to a parameter of a type bounded by Display:
    // `err_fmt(s)`, `fn err_fmt<T: Display>(x: T)`)
    for c in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[c].kind != NodeKind::Call || !own_node(c, tr, &pcx) {
            continue;
        }
        var f = pcx.nodes[c].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 {
            continue;
        }
        if pcx.fns[f].tmpl > 0 {
            f = pcx.fns[f].tmpl - 1;
        }
        let fnode = pcx.fns[f].node;
        if fnode <= 0 || pcx.nodes[fnode].g <= 0 {
            continue;
        }
        for i in 0..pcx.nodes[c].count {
            let arg = child(c, i, pcx);
            let e = if arg > 0 && pcx.nodes[arg].kind == NodeKind::NamedArg { pcx.nodes[arg].b }
                else { arg };
            if e <= 0 || !byte_slice(pcx.nodes[e].ty, pcx) || token_at(pcx.nodes[e].start, pcx) < 0
                || pcx.nodes[e].start <= pcx.nodes[c].start || !declared_bytes(e, 0, decls, pcx)
                || !param_is_display(fnode, c, e, pcx) {
                continue;
            }
            if put(pcx.nodes[e].start, pcx.nodes[e].start, "str::from_utf8(", TC_UTF8, &tr, &pcx) {
                put_first(pcx.nodes[e].end, ").unwrap()", &tr, &pcx);
            }
        }
    }
}

pub fn body_edits(tr: inout Tr, pcx: inout Ctx<Comp>) {
    // (first the bindings, which the accesses read)
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if !own_node(n, tr, &pcx) {
            continue;
        }
        if k == NodeKind::Let {
            edit_let(n, &tr, &pcx);
        } else if k == NodeKind::For {
            edit_for(n, &tr, &pcx);
            edit_for_copy(n, &tr, &pcx);
        } else if k == NodeKind::Block {
            // (a `for` the checker lowered)
            edit_for_copy(n, &tr, &pcx);
        } else if k == NodeKind::PatBind {
            edit_pat_bind(n, &tr, &pcx);
        } else if k == NodeKind::Static {
            edit_static(n, &tr, &pcx);
        }
    }
    let decls = text_decls(tr, &pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if !own_node(n, tr, &pcx) {
            continue;
        }
        if k == NodeKind::Unary && pcx.nodes[n].op == Tok::Amp {
            edit_amp(n, &tr, &pcx);
        } else if k == NodeKind::Match {
            edit_match_copy(n, &tr, &pcx);
        } else if k == NodeKind::Unary && pcx.nodes[n].op == Tok::Star {
            edit_deref(n, &tr, &pcx);
        } else if k == NodeKind::Call || k == NodeKind::FieldAccess {
            edit_len(n, &tr, &pcx);
            edit_call_args(n, &tr, &pcx);
            edit_text_to_bytes(n, decls, &tr, &pcx);
            if k == NodeKind::Call {
                edit_std_path(n, decls, &tr, &pcx);
                edit_inout_args(n, &tr, &pcx);
            }
        } else if k == NodeKind::Index {
            // (a raw pointer's part: ptr_slice_edits, after the statics)
            if !ptr_slice_node(n, pcx) {
                edit_view(n, &tr, &pcx);
                edit_index(n, &tr, &pcx);
                edit_ptr_index(n, &tr, &pcx);
                edit_text_to_bytes(n, decls, &tr, &pcx);
            }
        } else if k == NodeKind::Ident {
            edit_text_to_bytes(n, decls, &tr, &pcx);
        } else if k == NodeKind::Str {
            edit_str(n, decls, &tr, &pcx);
        } else if k == NodeKind::Char {
            edit_char(n, decls, &tr, &pcx);
        } else if k == NodeKind::Int {
            edit_int(n, &tr, &pcx);
            edit_int_generic(n, &tr, &pcx);
            edit_int_cast(n, &tr, &pcx);
        } else if k == NodeKind::Array || k == NodeKind::Repeat {
            edit_int_array(n, &tr, &pcx);
        } else if k == NodeKind::Closure {
            let s = pcx.nodes[n].start;
            if (pcx.nodes[n].p & CONV_NEW) != 0 && word_here(s, "sink") {
                put(s, s + 4, "move", TC_VAR, &tr, &pcx);
            }
        }
    }
    edit_prints(&tr, &pcx);
    edit_byte_holes(decls, &tr, &pcx);
}
