// (0.27.3) The translator's mutable parameters (mod.vl, pass 3c): MVS's
// sink parameter is the function's own value, which its body may change;
// Rust's by-value parameter is changed only when it is `mut` (rustc
// E0384, E0596). A sink parameter, or `sink self`, that the body assigns
// to, lends inout (`&p`, `for inout x in p`) or calls an `inout self`
// method of is written `mut p` (`mut self`).

use crate::base::get_src;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{CONV_SINK, NodeKind, child};
use crate::front::conv::{CONV_IN_OUT, param_conv};
use crate::tools::translate::{TC_SINK, Tr, own_node, put, token_at, word_here};

// The name a place is written on: the identifier at the base of `p.f[i]`,
// or 0.
fn base_name(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut p = n;
    loop {
        let k = pcx.nodes[p as usize].kind;
        if k == NodeKind::Index || k == NodeKind::FieldAccess || k == NodeKind::TupleField
            || k == NodeKind::Unary && get_src()[pcx.nodes[p as usize].start as usize] != b'&'
            && get_src()[pcx.nodes[p as usize].start as usize] != b'*' && get_src()[pcx.nodes[p as usize].start as usize] != b'-'
            && get_src()[pcx.nodes[p as usize].start as usize] != b'!' {
            p = if k == NodeKind::Unary { pcx.nodes[p as usize].b } else { pcx.nodes[p as usize].a };
            if p <= 0 {
                return 0;
            }
        } else {
            break;
        }
    }
    if pcx.nodes[p as usize].kind != NodeKind::Ident || token_at(pcx.nodes[p as usize].start, pcx) < 0 {
        return 0;
    }
    pcx.nodes[p as usize].a
}

// Whether node n, in a body, changes the place named `name`.
fn changes(n: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Assign {
        return base_name(pcx.nodes[n as usize].b, pcx) == name;
    }
    if k == NodeKind::Unary && get_src()[pcx.nodes[n as usize].start as usize] == b'&' {
        // (the inout marker: an access lent to an inout parameter)
        let t = pcx.nodes[n as usize].ty;
        return t > 0 && crate::tools::translate::is_mut_ref(t, pcx)
            && base_name(pcx.nodes[n as usize].b, pcx) == name;
    }
    if k == NodeKind::For && word_here(crate::tools::translate::skip_ws(pcx.nodes[n as usize].start + 3),
        b"inout") {
        return base_name(pcx.nodes[n as usize].c, pcx) == name;
    }
    if k == NodeKind::Call && pcx.nodes[n as usize].a == 0 && pcx.nodes[n as usize].count > 0 {
        // (a method of `inout self`)
        let f = pcx.nodes[n as usize].x - 1;
        if f < 0 || f >= pcx.fns.len() as i64 || base_name(child(n, 0, pcx), pcx) != name {
            return false;
        }
        let fnode = pcx.fns[f as usize].node;
        return fnode > 0 && pcx.nodes[fnode as usize].count > 0
            && param_conv(child(fnode, 0, pcx), pcx) == CONV_IN_OUT;
    }
    false
}

// Whether the name is bound again inside [a, b) (a `let`, a pattern): then
// a use of it may be the new binding's, and the parameter is left.
fn bound_in(name: i64, a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::PatBind && pcx.nodes[n as usize].a == name
            && a <= pcx.nodes[n as usize].start && pcx.nodes[n as usize].start < b {
            return true;
        }
    }
    false
}

pub fn mutable_edits(tr: &mut Tr, pcx: &mut Ctx<Comp>) {
    for f in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[f as usize].kind != NodeKind::Fn || !own_node(f, *tr, pcx) || pcx.nodes[f as usize].c <= 0 {
            continue;
        }
        let body = pcx.nodes[f as usize].c;
        let a = pcx.nodes[body as usize].start;
        let b = pcx.nodes[body as usize].end;
        for i in 0..pcx.nodes[f as usize].count {
            let p = child(f, i, pcx);
            if pcx.nodes[p as usize].kind != NodeKind::Param || (pcx.nodes[p as usize].p & CONV_SINK) == 0 {
                continue;
            }
            let name = pcx.nodes[p as usize].a;
            if bound_in(name, a, b, pcx) {
                continue;
            }
            let mut changed = false;
            let mut n: i64 = 1;
            while n < pcx.nodes.len() as i64 && !changed {
                if a <= pcx.nodes[n as usize].start && pcx.nodes[n as usize].start < b {
                    changed = changes(n, name, pcx);
                }
                n += 1;
            }
            if changed {
                let s = pcx.nodes[p as usize].start;
                put(s, s, b"mut ", TC_SINK, tr, pcx);
            }
        }
    }
}
