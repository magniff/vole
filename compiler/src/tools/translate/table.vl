pub fn path_rows(out: i64) {
    buf_bytes(out, "contract_check\tstd::contract_check\n");
    buf_bytes(out, "AllocError\tstd::alloc::AllocError\n");
    buf_bytes(out, "Allocator\tstd::alloc::Allocator\n");
    buf_bytes(out, "Gpa\tstd::alloc::Gpa\n");
