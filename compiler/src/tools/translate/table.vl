    buf_bytes(out, "Allocator::free\t-\t$r.deallocate(NonNull::new($1).unwrap(), Layout::from_size_align($2 as usize, $3 as usize).unwrap())\t! raw allocation: by hand\n");
    buf_bytes(out, "Allocator::try_alloc\t-\t!\traw allocation: by hand (allocate, a Result)\n");
    buf_bytes(out, "Allocator::try_resize\t-\t!\traw allocation: by hand (grow or shrink)\n");
    buf_bytes(out, "Allocator::resize\t-\t!\traw allocation: by hand (grow or shrink)\n");
    buf_bytes(out, "Cell::update\t-\t$r.update($1)\tFnOnce, returns nothing (MVS: the same)\n");
    buf_bytes(out, "Cell::swap\t-\t$r.swap(&$1)\ttakes &Cell<T>\n");
    buf_bytes(out, "Cell::as_ptr\t-\t$r.as_ptr()\t*mut T\n");
    buf_bytes(out, "UnsafeCell::get\t-\t$r.get()\t*mut T\n");
    buf_bytes(out, "NonNull::new\t-\tNonNull::new($1)\t*mut T\n");
    buf_bytes(out, "NonNull::as_ptr\t-\t$r.as_ptr()\t*mut T\n");
    buf_bytes(out, "Fmt\t-\ttype Formatter<'_>\trenamed; a Display impl's `f: inout Fmt` is `f: &mut Formatter<'_>`\n");
    buf_bytes(out, "Buf\t-\ttype Vec<u8, $1>\tBuf is gone\n");
    buf_bytes(out, "Arena\t-\ttype Arena<Gpa>\tgeneric over its parent; Gpa is MVS's only parent\n");
    buf_bytes(out, "ScopedArena\t-\ttype &ArenaScope<'_, Gpa>\trenamed; a scope's closure parameter, by reference\n");
    buf_bytes(out, "FixedBuf\t-\ttype FixedBuf<'_>\tthe lent memory's region\n");
    buf_bytes(out, "SliceIter\t-\ttype slice::Iter<'_, $1>\tyields &T; `.copied()` at the call (Vec::iter's rows)\n");
    buf_bytes(out, "SliceRefIter\t-\ttype slice::Iter<'_, $1>\t-\n");
    buf_bytes(out, "HashMapIter\t-\ttype hash_map::Iter<'_, $1, $2>\trenamed; yields (&K, &V)\n");
    buf_bytes(out, "HashSetIter\t-\ttype hash_set::Iter<'_, $1>\trenamed\n");
    buf_bytes(out, "Keys\t-\ttype hash_map::Keys<'_, $1, $2>\ta region\n");
    buf_bytes(out, "Values\t-\ttype hash_map::Values<'_, $1, $2>\ta region\n");
    buf_bytes(out, "StrGraphemes\t-\ttype str::Graphemes<'_>\trenamed\n");
    buf_bytes(out, "RevRange\t-\ttype Rev<Range<$1>>\tIterator::rev\n");
    buf_bytes(out, "RevRangeInclusive\t-\ttype Rev<RangeInclusive<$1>>\tIterator::rev\n");
    buf_bytes(out, "IoError\t-\ttype io::Error\tio's\n");
    buf_bytes(out, "JoinHandle\t-\ttype JoinHandle<$1, Gpa>\tan allocator parameter (spawn_in's)\n");
    buf_bytes(out, "ScopedJoinHandle\t-\ttype ScopedJoinHandle<'_, $1>\ta region\n");
    buf_bytes(out, "Scope\t-\ttype &Scope<'_, '_>\ta scope's closure parameter, by reference\n");
    buf_bytes(out, "NonNull\t-\ttype NonNull<$1>\ta struct now: `p.as_ptr()` where MVS cast it\n");
    buf_bytes(out, "Clone::clone\t-\timpl fn clone(&self) -> Self\t&self\n");
    buf_bytes(out, "Add\t-\timpl type Output = Self; fn add(self, rhs: Self) -> Self\tRust's shape\n");
    buf_bytes(out, "Sub\t-\timpl type Output = Self; fn sub(self, rhs: Self) -> Self\tRust's shape\n");
    buf_bytes(out, "Mul\t-\timpl type Output = Self; fn mul(self, rhs: Self) -> Self\tRust's shape\n");
    buf_bytes(out, "Div\t-\timpl type Output = Self; fn div(self, rhs: Self) -> Self\tRust's shape\n");
    buf_bytes(out, "Neg\t-\timpl type Output = Self; fn neg(self) -> Self\tRust's shape\n");
    buf_bytes(out, "Buf::len\t-\t$r.len()\tas Vec<u8, A>'s\n");
    buf_bytes(out, "Buf::capacity\t-\t$r.capacity()\tas Vec<u8, A>'s\n");
    buf_bytes(out, "Buf::clear\t-\t$r.clear()\tas Vec<u8, A>'s\n");
    buf_bytes(out, "Buf::reserve\t-\t$r.reserve($1)\tas Vec<u8, A>'s\n");
    buf_bytes(out, "Buf::take\t-\t$r.take()\tas Vec<u8, A>'s\n");
    buf_bytes(out, "Buf::allocator\t-\t$r.allocator().clone()\t&A\n");
    buf_bytes(out, "Buf::as_mut_slice\t-\t$r.as_mut_slice()\tas Vec<u8, A>'s\n");
    buf_bytes(out, "Buf::from_in\t-\t$1.to_vec_in($2)\ta Vec<u8, A> of the bytes\n");
    buf_bytes(out, "Vec::retain\t-\t$r.retain($1)\tthe closure's parameter is &T: its pattern `|&x|` for a Copy T, else a deref in the body\n");
    buf_bytes(out, "Utf8Error::valid_up_to\t-\t$r.valid_up_to() as i64\tusize\n");
    buf_bytes(out, "Utf8Error::error_len\t-\t$r.error_len().map(|n| n as i64)\tOption<usize>\n");
    buf_bytes(out, "Read::read_to_end\t-\t$r.read_to_end(&mut $1).map(|n| n as i64)\tusize\n");
    buf_bytes(out, "Read::read_to_string\t-\t$r.read_to_string(&mut $1).map(|n| n as i64)\tusize\n");
    buf_bytes(out, "BufRead::consume\t-\t$r.consume($1 as usize)\tusize\n");
    buf_bytes(out, "Error::new\t-\tio::Error::new($1, \"\")\ta message now\n");
    buf_bytes(out, "ScopedArena::used\t-\t$r.used() as i64\tusize\n");
    buf_bytes(out, "ScopedArena::scope\t-\t$r.scope(|s| $1(s))\tFnOnce(&ArenaScope)\n");
    buf_bytes(out, "signum\t-\t$1.signum()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "copysign\t-\t$1.copysign($2)\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "is_nan\t-\t$1.is_nan()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "is_finite\t-\t$1.is_finite()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "is_infinite\t-\t$1.is_infinite()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "floor\t-\t$1.floor()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "ceil\t-\t$1.ceil()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "round\t-\t$1.round()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "round_ties_even\t-\t$1.round_ties_even()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "trunc\t-\t$1.trunc()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "fract\t-\t$1.fract()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "to_radians\t-\t$1.to_radians()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "to_degrees\t-\t$1.to_degrees()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "sqrt\t-\t$1.sqrt()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "cbrt\t-\t$1.cbrt()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "hypot\t-\t$1.hypot($2)\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "sin\t-\t$1.sin()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "cos\t-\t$1.cos()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "tan\t-\t$1.tan()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "sin_cos\t-\t$1.sin_cos()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "asin\t-\t$1.asin()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "acos\t-\t$1.acos()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "atan\t-\t$1.atan()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "exp\t-\t$1.exp()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "exp2\t-\t$1.exp2()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "ln\t-\t$1.ln()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "log2\t-\t$1.log2()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "log10\t-\t$1.log10()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "powf\t-\t$1.powf($2)\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "powi\t-\t$1.powi($2)\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "next_up\t-\t$1.next_up()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "next_down\t-\t$1.next_down()\tstd::math's function is f64's (f32's) method\n");
    buf_bytes(out, "atan2\t-\t$1.atan2($2)\ty.atan2(x), as math::atan2(y, x)\n");
    buf_bytes(out, "pow\t-\t$1.powf($2)\tC's pow is powf\n");
    buf_bytes(out, "f64_to_bits\t-\t$1.to_bits()\tan f64 method\n");
    buf_bytes(out, "f64_from_bits\t-\tf64::from_bits($1)\tan associated function\n");
    buf_bytes(out, "f32_to_bits\t-\t$1.to_bits()\tan f32 method\n");
    buf_bytes(out, "f32_from_bits\t-\tf32::from_bits($1)\tan associated function\n");
    buf_bytes(out, "is_alphabetic\t-\tchar::from_u32($1).map_or(false, |c| c.is_alphabetic())\tstd::unicode's code point test is char's method; `$1.is_alphabetic()` when $1 is a char\n");
    buf_bytes(out, "is_numeric\t-\tchar::from_u32($1).map_or(false, |c| c.is_numeric())\tstd::unicode's code point test is char's method; `$1.is_numeric()` when $1 is a char\n");
    buf_bytes(out, "is_alphanumeric\t-\tchar::from_u32($1).map_or(false, |c| c.is_alphanumeric())\tstd::unicode's code point test is char's method; `$1.is_alphanumeric()` when $1 is a char\n");
    buf_bytes(out, "is_whitespace\t-\tchar::from_u32($1).map_or(false, |c| c.is_whitespace())\tstd::unicode's code point test is char's method; `$1.is_whitespace()` when $1 is a char\n");
    buf_bytes(out, "is_lowercase\t-\tchar::from_u32($1).map_or(false, |c| c.is_lowercase())\tstd::unicode's code point test is char's method; `$1.is_lowercase()` when $1 is a char\n");
    buf_bytes(out, "is_uppercase\t-\tchar::from_u32($1).map_or(false, |c| c.is_uppercase())\tstd::unicode's code point test is char's method; `$1.is_uppercase()` when $1 is a char\n");
    buf_bytes(out, "is_control\t-\tchar::from_u32($1).map_or(false, |c| c.is_control())\tstd::unicode's code point test is char's method; `$1.is_control()` when $1 is a char\n");
    buf_bytes(out, "to_lower\t-\t!\tchar::to_lowercase yields chars (an iterator), not [u32; 3]\n");
    buf_bytes(out, "to_upper\t-\t!\tchar::to_uppercase yields chars (an iterator), not [u32; 3]\n");
    buf_bytes(out, "vars_in\t-\tstd::env::vars_in($1).collect_in($1)\tVars is an iterator: a Vec as MVS's; `for` over it needs no collect\n");
    buf_bytes(out, "current_dir_in\t-\tstd::env::current_dir_in($1)\tio::Result<String<A>>: std2 has no PathBuf yet\n");
    buf_bytes(out, "set_current_dir\t-\tstd::env::set_current_dir($1)\tthe path is a &str\n");
    buf_bytes(out, "parse_int\t-\t$1.parse::<i64>()\tstr::parse (FromStr); std2's ParseIntError has kind() (IntErrorKind), not MVS's variants: a match on them is a hand fix; $1 a &str (MVS: bytes)\n");
    buf_bytes(out, "parse_i64_radix\t-\t!\tno from_str_radix in std2 yet; radix 10 is `$1.parse::<i64>()`\n");
    buf_bytes(out, "parse_u64_radix\t-\t!\tno from_str_radix in std2 yet; radix 10 is `$1.parse::<u64>()`\n");
    buf_bytes(out, "parse_f64\t-\t$1.parse::<f64>()\tstr::parse (FromStr), Rust's rounding\n");
    buf_bytes(out, "parse_f32\t-\t$1.parse::<f32>()\tstr::parse (FromStr)\n");
}

