    buf_bytes(out, "Display\tstd::fmt::Display\n");
    buf_bytes(out, "Debug\tstd::fmt::Debug\n");
    buf_bytes(out, "Write\tstd::fmt::Write\n");
    buf_bytes(out, "Fmt\tstd::fmt::Formatter\n");
    buf_bytes(out, "print\tstd::fmt::print\n");
    buf_bytes(out, "println\tstd::fmt::println\n");
    buf_bytes(out, "eprint\tstd::fmt::eprint\n");
    buf_bytes(out, "eprintln\tstd::fmt::eprintln\n");
    buf_bytes(out, "format_in\tstd::fmt::format_in\n");
