    buf_bytes(out, "Arg\tstd::cli::Arg\n");
    buf_bytes(out, "Command\tstd::cli::Command\n");
    buf_bytes(out, "CliErrorKind\tstd::cli::CliErrorKind\n");
    buf_bytes(out, "CliError\tstd::cli::CliError\n");
    buf_bytes(out, "Matches\tstd::cli::Matches\n");
    buf_bytes(out, "Clone\tstd::clone::Clone\n");
    buf_bytes(out, "Eq\tstd::cmp::PartialEq\n");
    buf_bytes(out, "Eq\tstd::cmp::Eq\n");
    buf_bytes(out, "Ordering\tstd::cmp::Ordering\n");
    buf_bytes(out, "Ord\tstd::cmp::Ord\n");
    buf_bytes(out, "min\tstd::cmp::min\n");
    buf_bytes(out, "max\tstd::cmp::max\n");
    buf_bytes(out, "HashMap\tstd::collections::hash_map::HashMap\n");
    buf_bytes(out, "Entry\tstd::collections::hash_map::Entry\n");
    buf_bytes(out, "HashMapIter\tstd::collections::hash_map::Iter\n");
    buf_bytes(out, "Keys\tstd::collections::hash_map::Keys\n");
    buf_bytes(out, "Values\tstd::collections::hash_map::Values\n");
