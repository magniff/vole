// `volec refactor --script FILE [--dry-run] [--no-check] [--root R]`
// (0.11; docs/refactor.md): the commands of FILE (refactor, rewrite,
// edit, fix: one per line, as typed after `volec`, quoted as in sh;
// `#` comments; `< PATH` gives a command its stdin, 0.14: `<<WORD` the
// lines after it up to a line WORD), applied in turn and checked once, at
// the end: all or nothing.
//
// Each command runs in a copy of this process (fork), on the program as
// the commands before it left it: their copies (`FILE.vole-edit~`)
// read in place of the files (--overlay). It is a step (edit.vl's
// STEP_REPORT): it prints its summary line and writes its copies, unchecked,
// and lists their files. A command that fails ends the script: the
// copies are removed, nothing is written. After the last one, the edit
// engine runs on the copies as one edit (finish_edit): the check, then
// the files written and journaled as one edit (one `undo`), or with
// --dry-run the diff; and a total line.
//
// The commands come from commands.vl's table (run_tool), so a command
// added there runs in scripts too.

use std::alloc::Arena;

use crate::base::{
    IntVec, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_OPTION, EV_WORD, Leaf, Line, option, word_of};
use crate::front::embed::wgsl::WgslCx;
use crate::tools::commands::{is_tool, run_tool};
use crate::tools::ctx::Tcx;
use crate::tools::edit::{edit_remove_file, gone_path, remove_empty_dirs};
use crate::tools::edit::apply::{copy_made, copy_path, copy_rewritten, finish_edit, set_command};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::proc::{
    buf_cstr, fork_worker, read_file_if, remove_file, wait_any, worker_exit, write_file_if,
};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::{diag, program_errors, put_root, write_diags};

extern "C" {
    fn open(path: *mut u8, flags: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
}

pub fn run_script(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = script_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

fn usage(message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"refactor.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = crate::tools::query::diagnostics::diags(tcx);
    buf_str(out, c"try:");
    crate::tools::query::diagnostics::put_cword(out, pcx.prog);
    buf_str(out, c" refactor --script steps.txt --dry-run");
    put_root(out, tcx);
    crate::tools::query::diagnostics::try_end(out);
    2
}

// The words of a line, as sh splits them (`'...'`, `"..."` with `\"` and
// `\\`; a word starting with `#` starts a comment), into `words` (C
// strings). False when a quote is not closed.
fn split_words(line: &[u8], words: *mut IntVec) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i < line.len() as i64 {
            while i < line.len() as i64
                && (line[i as usize] == b' ' || line[i as usize] == b'\t'
                    || line[i as usize] == b'\r') {
                i += 1;
            }
            if i >= line.len() as i64 || line[i as usize] == b'#' {
                break;
            }
            let w = buf_new();
            while i < line.len() as i64 && line[i as usize] != b' ' && line[i as usize] != b'\t'
                && line[i as usize] != b'\r' {
                let c = line[i as usize];
                if c == b'\'' || c == b'"' {
                    i += 1;
                    while i < line.len() as i64 && line[i as usize] != c {
                        if c == b'"' && line[i as usize] == b'\\' && i + 1 < line.len() as i64
                            && (line[(i + 1) as usize] == b'"' || line[(i + 1) as usize] == b'\\') {
                            i += 1;
                        }
                        buf_byte(w, line[i as usize]);
                        i += 1;
                    }
                    if i >= line.len() as i64 {
                        return false;
                    }
                    i += 1;
                } else {
                    buf_byte(w, c);
                    i += 1;
                }
            }
            words.push(buf_cstr(w) as i64);
        }
        true
    }
}

fn note_file(path: &[u8], state: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..tcx.script_changed.len() as i64 {
        if crate::tools::proc::same_bytes(
            c_slice((tcx.script_changed[i as usize]) as *mut u8), path) {
            let was = (tcx.made[i as usize]);
            if state == 2 {
                // (moved away: a file made by a step before is none)
                (tcx.made[i as usize]) = if was == 1 { 3 } else { 2 };
                remove_file(copy_path((tcx.script_changed[i as usize]) as *mut u8,
                    pcx));
            } else if state == 1 && was == 2 {
                (tcx.made[i as usize]) = 0;
            } else if state == 1 && was == 3 {
                (tcx.made[i as usize]) = 1;
            }
            return;
        }
    }
    let b = buf_new();
    buf_bytes(b, path);
    tcx.script_changed.push(buf_cstr(b) as i64);
    tcx.made.push(state);
}

// The files a step listed (`file PATH`, `new PATH`).
fn read_report(path: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let b = buf_new();
    if !read_file_if(path, b) {
        return;
    }
    let t = buf_slice(b);
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        let mut e = i;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        let line = &t[i as usize..e as usize];
        if line.len() > 5 && line[0] == b'f' && line[4] == b'\t' {
            note_file(&line[5..line.len()], 0, tcx, pcx);
        } else if line.len() > 4 && line[0] == b'n' && line[3] == b'\t' {
            note_file(&line[4..line.len()], 1, tcx, pcx);
        } else if line.len() > 5 && line[0] == b'g' && line[4] == b'\t' {
            note_file(&line[5..line.len()], 2, tcx, pcx);
        } else if line.len() == 7 && line[0] == b'i' && line[6] == b's' {
            // (0.16: the step said edit.imports)
            tcx.imports_noted = true;
        }
        i = e + 1;
    }
}

fn remove_all_copies(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..tcx.script_changed.len() as i64 {
        remove_file(copy_path((tcx.script_changed[i as usize]) as *mut u8, pcx));
        if (tcx.made[i as usize]) == 1 {
            remove_empty_dirs((tcx.script_changed[i as usize]) as *mut u8);
        }
    }
}

// Runs step `words` (stdin from `input`, when not 0) in a copy of this
// process: its exit status.
fn run_step(words: *mut IntVec, input: *mut u8, root: *mut u8, report: *mut u8, gpa: Gpa,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    unsafe {
        let pid = fork_worker();
        if pid < 0 {
            return 1;
        }
        if pid == 0 {
            // The copy: the program as the steps before left it.
            for i in 0..tcx.script_changed.len() as i64 {
                let p = (tcx.script_changed[i as usize]) as *mut u8;
                pcx.overlay.push(p as i64);
                pcx.overlay.push(if (tcx.made[i as usize]) >= 2 { gone_path(p) }
                    else { copy_path(p, pcx) } as i64);
            }
            tcx.step_report = report;
            tcx.dry_run = false;
            tcx.no_check = false;
            if input != 0 as *mut u8 {
                let fd = open(input, 0);
                if fd < 0 {
                    let d = diag(c"error", c"refactor.script", tcx);
                    buf_str(d, c"cannot read '");
                    buf_str(d, input);
                    buf_str(d, c"'\n");
                    write_diags(tcx);
                    worker_exit(1);
                }
                dup2(fd, 0);
                close(fd);
            }
            let n = (*words).len() as i64;
            let mut w: Vec<&str, Gpa> = Vec::new_in(gpa);
            w.push(word_of(pcx.prog));
            for i in 0..n {
                w.push(word_of((*words).get(i) as *mut u8));
            }
            w.push("--root");
            w.push(word_of(root));
            if tcx.target_name != 0 as *mut u8 {
                w.push("--target");
                w.push(word_of(tcx.target_name));
            }
            let status = run_tool(Line { words: w.as_slice() }, gpa, tcx, pcx, wgx);
            worker_exit(status);
        }
        let mut status: i64 = 0;
        wait_any(&mut status);
        status
    }
}

// `refactor --script`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn script_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    table.push(option("label", "WORDS", "the edit's words, for a command run as a script"));
    Leaf::new(table, "file")
}

fn script_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let gpa = c.gpa;
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    let mut root = 0 as *mut u8;
    let mut file = 0 as *mut u8;
    let mut label = 0 as *mut u8;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        let a = ev.value;
        if take_edit_event(&mut ev, &mut root, tcx, pcx) {
            continue;
        }
        // (0.17: the edit's words, for a command run as a script)
        if ev.kind == EV_OPTION && ev.name == "label" {
            label = a;
            continue;
        }
        if ev.kind != EV_WORD {
            let d = diag(c"error", c"refactor.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' of refactor --script (--dry-run, --no-check, --root, --target)\n");
            return 2;
        }
        if file == 0 as *mut u8 {
            file = a;
        } else if root == 0 as *mut u8 && crate::base::is_source_path(a) {
            root = a;
        } else {
            return usage(c"one FILE of commands", tcx, pcx);
        }
    }
    unsafe {
        if file == 0 as *mut u8 {
            return usage(c"a FILE of commands is needed", tcx, pcx);
        }
        tcx.root_given = root;
        root = root_or_diag(root, c"--script", c_slice(file), true, tcx, pcx);
        if root == 0 as *mut u8 {
            return 2;
        }
        let text = buf_new();
        if !read_file_if(file, text) {
            let d = diag(c"error", c"refactor.script", tcx);
            buf_str(d, c"cannot read '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 2;
        }
        // The steps: the words of each line, its stdin, its line number.
        let mut steps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut inputs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut bodies = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut numbers = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if !read_commands(buf_slice(text), file, c"refactor.script", &mut steps, &mut inputs,
            &mut bodies, &mut numbers, tcx) {
            return 2;
        }
        for k in 0..steps.len() as i64 {
            let w = (steps[k as usize]) as *mut IntVec;
            let first = ((*w)[0]) as *mut u8;
            if !is_tool(word_of(first))
                || ((*w).len() as i64 > 1 && streq(first, c"refactor")
                    && streq(((*w)[1]) as *mut u8, c"--script")) {
                return line_error(file, (numbers[k as usize]),
                    c"not a command a script runs (refactor, rewrite, edit, fix)", tcx);
            }
            for x in 1..(*w).len() as i64 {
                if streq(((*w)[x as usize]) as *mut u8, c"--root")
                    || streq(((*w)[x as usize]) as *mut u8, c"--target") {
                    return line_error(file, (numbers[k as usize]),
                        c"--root and --target are the script's, not a line's", tcx);
                }
            }
        }
        if steps.len() as i64 == 0 {
            let d = diag(c"note", c"refactor.script", tcx);
            buf_str(d, c"no commands in '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 0;
        }
        // The steps, in turn.
        let report_buf = buf_new();
        buf_str(report_buf, root);
        // (0.25.5: tagged as the edit copies are, apply.vl copy_path)
        buf_str(report_buf, c".vole-script-");
        buf_str(report_buf, pcx.edit_tag);
        buf_byte(report_buf, b'~');
        let report = buf_cstr(report_buf);
        let dry = tcx.dry_run;
        let no_check = tcx.no_check;
        for k in 0..steps.len() as i64 {
            remove_file(report);
            write_diags(tcx);
            // (a text after `<<WORD`: in a file next to the report, while
            // the command runs)
            let mut input = (inputs[k as usize]) as *mut u8;
            let stdin_buf = buf_new();
            buf_str(stdin_buf, root);
            buf_str(stdin_buf, c".vole-stdin-");
            buf_str(stdin_buf, pcx.edit_tag);
            buf_byte(stdin_buf, b'~');
            let stdin_path = buf_cstr(stdin_buf);
            if (bodies[k as usize]) >= 0 {
                if !write_file_if(stdin_path, buf_slice((bodies[k as usize]))) {
                    remove_all_copies(tcx, pcx);
                    return line_error(file, (numbers[k as usize]),
                        c"cannot write the text after <<", tcx);
                }
                input = stdin_path;
            }
            let status = run_step((steps[k as usize]) as *mut IntVec, input, root, report,
                gpa, tcx, pcx, wgx);
            if (bodies[k as usize]) >= 0 {
                remove_file(stdin_path);
            }
            if status != 0 {
                read_report(report, tcx, pcx);
                remove_file(report);
                remove_all_copies(tcx, pcx);
                let d = diag(c"error", c"refactor.script", tcx);
                buf_str(d, file);
                buf_byte(d, b':');
                buf_int(d, (numbers[k as usize]));
                buf_str(d, c": the command failed (exit ");
                buf_int(d, status);
                buf_str(d, c"):");
                let w = (steps[k as usize]) as *mut IntVec;
                for x in 0..(*w).len() as i64 {
                    crate::tools::query::diagnostics::put_word(d,
                        c_slice(((*w)[x as usize]) as *mut u8));
                }
                buf_str(d, c"; nothing written\n");
                return 1;
            }
            read_report(report, tcx, pcx);
        }
        remove_file(report);
        tcx.dry_run = dry;
        tcx.no_check = no_check;
        if tcx.script_changed.len() as i64 == 0 {
            let d = diag(c"note", c"edit.unchanged", tcx);
            buf_str(d, c"nothing to change\n");
            return 0;
        }
        // One edit: the copies, checked once.
        if !load_program(root, tcx.target, tcx, pcx, wgx) {
            program_errors(c"error", root, true, tcx, pcx);
            remove_all_copies(tcx, pcx);
            return 1;
        }
        for k in 0..tcx.script_changed.len() as i64 {
            let path = (tcx.script_changed[k as usize]) as *mut u8;
            let state = (tcx.made[k as usize]);
            if state == 3 {
                continue;
            }
            let ok = if state == 2 { edit_remove_file(c_slice(path), tcx, pcx) }
                else if state == 1 { copy_made(path, tcx, pcx) }
                else { copy_rewritten(c_slice(path), tcx, pcx) };
            if !ok {
                remove_all_copies(tcx, pcx);
                let d = diag(c"error", c"edit.write", tcx);
                buf_str(d, c"cannot read the copy of '");
                buf_str(d, path);
                buf_str(d, c"'\n");
                return 1;
            }
        }
        let what = buf_new();
        if label != 0 as *mut u8 {
            buf_str(what, label);
        } else {
            buf_str(what, c"script ");
            buf_str(what, file);
            buf_str(what, c": ");
            buf_int(what, steps.len() as i64);
            buf_str(what, if steps.len() as i64 == 1 { c" command" } else { c" commands" });
        }
        finish_edit(buf_slice(what), root, tcx, pcx)
    }
}

fn line_error(file: *mut u8, line: i64, message: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    format_error(c"refactor.script", file, line, message, tcx);
    2
}

// The commands of text t (of FILE, for messages), one per line, as typed
// after `volec` (0.15: refactor --script's and batch's): per command
// its words (an IntVec of C strings, as split_words splits them), its
// stdin (`< PATH`: the path; `<<WORD`: WORD), the text after `<<WORD` (a
// buffer, else -1) and its line. False after the diagnostic (`code`:
// refactor.script, batch.format).
pub fn read_commands(t: &[u8], file: *mut u8, code: *mut u8, steps: &mut IntVec,
    inputs: &mut IntVec, bodies: &mut IntVec, numbers: &mut IntVec, tcx: &mut Tcx<Comp>) -> bool {
    unsafe {
        let mut p: i64 = 0;
        let mut line_no: i64 = 0;
        while p < t.len() as i64 {
            let mut e = p;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            line_no += 1;
            let words = alloc_array::<IntVec>(1i64);
            (*words.add(0)) = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let ok = split_words(&t[p as usize..e as usize], words.add(0));
            p = e + 1;
            let w = words.add(0) as *mut IntVec;
            if !ok {
                format_error(code, file, line_no, c"a quote is not closed", tcx);
                return false;
            }
            if (*w).len() as i64 == 0 {
                continue;
            }
            // (`< PATH`: stdin; 0.14: `<<WORD`, the lines after it up to
            // a line WORD)
            let cmd_line = line_no;
            let mut input = 0 as *mut u8;
            let mut body: i64 = -1;
            let n = (*w).len() as i64;
            let last = ((*w)[(n - 1) as usize]) as *mut u8;
            let mut word = 0 as *mut u8;
            if n >= 2 && streq(((*w)[(n - 2) as usize]) as *mut u8, c"<<") {
                word = last;
                (*w).truncate(n - 2);
            } else if (*last.add(0)) == b'<' && (*last.add(1)) == b'<' && (*last.add(2)) != 0 {
                word = last.add(2);
                (*w).truncate(n - 1);
            }
            if word != 0 as *mut u8 {
                input = word;
                body = buf_new();
                let mut found = false;
                while p < t.len() as i64 && !found {
                    let mut e2 = p;
                    while e2 < t.len() as i64 && t[e2 as usize] != b'\n' {
                        e2 += 1;
                    }
                    line_no += 1;
                    let mut b = e2;
                    while b > p
                        && (t[(b - 1) as usize] == b' ' || t[(b - 1) as usize] == b'\t'
                            || t[(b - 1) as usize] == b'\r') {
                        b -= 1;
                    }
                    if bytes_eq(&t[p as usize..b as usize], c_slice(word)) {
                        found = true;
                    } else {
                        buf_bytes(body, &t[p as usize..e2 as usize]);
                        buf_byte(body, b'\n');
                    }
                    p = e2 + 1;
                }
                if !found {
                    let d = diag(c"error", code, tcx);
                    buf_str(d, file);
                    buf_byte(d, b':');
                    buf_int(d, cmd_line);
                    buf_str(d, c": no line '");
                    buf_str(d, word);
                    buf_str(d, c"' ends the text of <<");
                    buf_str(d, word);
                    buf_byte(d, b'\n');
                    return false;
                }
            } else if n >= 2 && streq(((*w)[(n - 2) as usize]) as *mut u8, c"<") {
                input = ((*w)[(n - 1) as usize]) as *mut u8;
                (*w).truncate(n - 2);
            }
            else if ((*w)[(n - 1) as usize]) as *mut u8 != 0 as *mut u8
                && (*(((*w)[(n - 1) as usize]) as *mut u8).add(0)) == b'<' {
                input = (((*w)[(n - 1) as usize]) as *mut u8).add(1);
                (*w).truncate(n - 1);
            }
            if (*w).len() as i64 == 0 {
                format_error(code, file, cmd_line, c"stdin is given, but no command", tcx);
                return false;
            }
            steps.push(w as i64);
            inputs.push(input as i64);
            bodies.push(body);
            numbers.push(cmd_line);
        }
        true
    }
}

// `CODE: FILE:LINE: MESSAGE; nothing run`.
pub fn format_error(code: *mut u8, file: *mut u8, line: i64, message: *mut u8, tcx: &mut Tcx<Comp>) {
    let d = diag(c"error", code, tcx);
    buf_str(d, file);
    buf_byte(d, b':');
    buf_int(d, line);
    buf_str(d, c": ");
    buf_str(d, message);
    buf_str(d, c"; nothing run\n");
}
