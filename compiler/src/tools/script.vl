// `volec refactor --script FILE [--dry-run] [--no-check] [--root R]`
// (0.11; docs/refactor.md): the commands of FILE (refactor, rewrite,
// edit, fix: one per line, as typed after `volec`, quoted as in sh;
// `#` comments; `< PATH` gives a command its stdin, 0.14: `<<WORD` the
// lines after it up to a line WORD), applied in turn and checked once, at
// the end: all or nothing.
//
// Each command runs in a copy of this process (fork), on the program as
// the commands before it left it: their copies (`FILE.vole-edit~`)
// read in place of the files (--overlay). It is a step (edit.vl's
// STEP_REPORT): it prints its summary line and writes its copies, unchecked,
// and lists their files. A command that fails ends the script: the
// copies are removed, nothing is written. After the last one, the edit
// engine runs on the copies as one edit (finish_edit): the check, then
// the files written and journaled as one edit (one `undo`), or with
// --dry-run the diff; and a total line.
//
// The commands come from commands.vl's table (run_tool), so a command
// added there runs in scripts too.

use crate::base::{
    IntVec, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_OPTION, EV_WORD, Leaf, Line, option, word_of};
use crate::tools::commands::{is_tool, run_tool};
use crate::tools::ctx::Tcx;
use crate::tools::edit::{edit_remove_file, gone_path, remove_empty_dirs};
use crate::tools::edit::apply::{copy_made, copy_path, copy_rewritten, finish_edit, set_command};
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::proc::{
    buf_cstr, fork_worker, read_file_if, remove_file, wait_any, worker_exit, write_file_if,
};
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::{diag, program_errors, put_root, write_diags};

extern "C" {
    fn open(path: *u8, flags: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
}

pub fn run_script(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let status = script_inner(c, &tcx, &pcx);
    write_diags(tcx);
    status
}

fn usage(message: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"refactor.usage", &tcx);
    buf_str(d, message);
    buf_byte(d, '\n');
    let out = crate::tools::query::diagnostics::diags(&tcx);
    buf_str(out, c"try:");
    crate::tools::query::diagnostics::put_cword(out, pcx.prog);
    buf_str(out, c" refactor --script steps.txt --dry-run");
    put_root(out, tcx);
    crate::tools::query::diagnostics::try_end(out);
    2
}

// The words of a line, as sh splits them (`'...'`, `"..."` with `\"` and
// `\\`; a word starting with `#` starts a comment), into `words` (C
// strings). False when a quote is not closed.
fn split_words(line: [u8], words: *IntVec) -> bool {
    unsafe {
        var i = 0;
        while i < line.len as i64 {
            while i < line.len as i64 && (line[i] == ' ' || line[i] == '\t' || line[i] == '\r') {
                i += 1;
            }
            if i >= line.len as i64 || line[i] == '#' {
                break;
            }
            let w = buf_new();
            while i < line.len as i64 && line[i] != ' ' && line[i] != '\t' && line[i] != '\r' {
                let c = line[i];
                if c == '\'' || c == '"' {
                    i += 1;
                    while i < line.len as i64 && line[i] != c {
                        if c == '"' && line[i] == '\\' && i + 1 < line.len as i64
                            && (line[i + 1] == '"' || line[i + 1] == '\\') {
                            i += 1;
                        }
                        buf_byte(w, line[i]);
                        i += 1;
                    }
                    if i >= line.len as i64 {
                        return false;
                    }
                    i += 1;
                } else {
                    buf_byte(w, c);
                    i += 1;
                }
            }
            words.push(buf_cstr(w) as i64);
        }
        true
    }
}

fn note_file(path: [u8], state: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        for i in 0..tcx.script_changed.count {
            if crate::tools::proc::same_bytes(c_slice(tcx.script_changed.data[i] as *u8), path) {
                let was = tcx.made.data[i];
                if state == 2 {
                    // (moved away: a file made by a step before is none)
                    tcx.made.data[i] = if was == 1 { 3 } else { 2 };
                    remove_file(copy_path(tcx.script_changed.data[i] as *u8, pcx));
                } else if state == 1 && was == 2 {
                    tcx.made.data[i] = 0;
                } else if state == 1 && was == 3 {
                    tcx.made.data[i] = 1;
                }
                return;
            }
        }
        let b = buf_new();
        buf_bytes(b, path);
        tcx.script_changed.push(buf_cstr(b) as i64);
        tcx.made.push(state);
    }
}

// The files a step listed (`file PATH`, `new PATH`).
fn read_report(path: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let b = buf_new();
    if !read_file_if(path, b) {
        return;
    }
    let t = buf_slice(b);
    var i = 0;
    while i < t.len as i64 {
        var e = i;
        while e < t.len as i64 && t[e] != '\n' {
            e += 1;
        }
        let line = t[i..e];
        if line.len > 5 && line[0] == 'f' && line[4] == '\t' {
            note_file(line[5..line.len], 0, &tcx, pcx);
        } else if line.len > 4 && line[0] == 'n' && line[3] == '\t' {
            note_file(line[4..line.len], 1, &tcx, pcx);
        } else if line.len > 5 && line[0] == 'g' && line[4] == '\t' {
            note_file(line[5..line.len], 2, &tcx, pcx);
        } else if line.len == 7 && line[0] == 'i' && line[6] == 's' {
            // (0.16: the step said edit.imports)
            tcx.imports_noted = true;
        }
        i = e + 1;
    }
}

fn remove_all_copies(tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        for i in 0..tcx.script_changed.count {
            remove_file(copy_path(tcx.script_changed.data[i] as *u8, pcx));
            if tcx.made.data[i] == 1 {
                remove_empty_dirs(tcx.script_changed.data[i] as *u8);
            }
        }
    }
}

// Runs step `words` (stdin from `input`, when not 0) in a copy of this
// process: its exit status.
fn run_step(words: *IntVec, input: *u8, root: *u8, report: *u8, gpa: Gpa, tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let pid = fork_worker();
        if pid < 0 {
            return 1;
        }
        if pid == 0 {
            // The copy: the program as the steps before left it.
            for i in 0..tcx.script_changed.count {
                let p = tcx.script_changed.data[i] as *u8;
                pcx.overlay.push(p as i64);
                pcx.overlay.push(if tcx.made.data[i] >= 2 { gone_path(p) }
                    else { copy_path(p, pcx) } as i64);
            }
            tcx.step_report = report;
            tcx.dry_run = false;
            tcx.no_check = false;
            if input != 0 as *u8 {
                let fd = open(input, 0);
                if fd < 0 {
                    let d = diag(c"error", c"refactor.script", &tcx);
                    buf_str(d, c"cannot read '");
                    buf_str(d, input);
                    buf_str(d, c"'\n");
                    write_diags(tcx);
                    worker_exit(1);
                }
                dup2(fd, 0);
                close(fd);
            }
            let n = (*words).count;
            var w: Vec<str, Gpa> = Vec::new_in(gpa);
            w.push(word_of(pcx.prog));
            for i in 0..n {
                w.push(word_of((*words).get(i) as *u8));
            }
            w.push("--root");
            w.push(word_of(root));
            if tcx.target_name != 0 as *u8 {
                w.push("--target");
                w.push(word_of(tcx.target_name));
            }
            let status = run_tool(Line { words: w.as_slice() }, gpa, &tcx, &pcx);
            worker_exit(status);
        }
        var status = 0;
        wait_any(&status);
        status
    }
}

// `refactor --script`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn script_leaf(gpa: Gpa) -> Leaf<Gpa> {
    var table = edit_opts(gpa);
    table.push(option("label", "WORDS", "the edit's words, for a command run as a script"));
    Leaf::new(table, "file")
}

fn script_inner(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let gpa = c.gpa;
    set_command(c.line, &tcx);
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    var root = 0 as *u8;
    var file = 0 as *u8;
    var label = 0 as *u8;
    for e in c.evs.iter() {
        var ev = e;
        let a = ev.value;
        if take_edit_event(&ev, &root, &tcx, &pcx) {
            continue;
        }
        // (0.17: the edit's words, for a command run as a script)
        if ev.kind == EV_OPTION && ev.name == "label" {
            label = a;
            continue;
        }
        if ev.kind != EV_WORD {
            let d = diag(c"error", c"refactor.usage", &tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' of refactor --script (--dry-run, --no-check, --root, --target)\n");
            return 2;
        }
        if file == 0 as *u8 {
            file = a;
        } else if root == 0 as *u8 && crate::base::is_source_path(a) {
            root = a;
        } else {
            return usage(c"one FILE of commands", &tcx, pcx);
        }
    }
    unsafe {
        if file == 0 as *u8 {
            return usage(c"a FILE of commands is needed", &tcx, pcx);
        }
        tcx.root_given = root;
        root = root_or_diag(root, c"--script", c_slice(file), true, &tcx, pcx);
        if root == 0 as *u8 {
            return 2;
        }
        let text = buf_new();
        if !read_file_if(file, text) {
            let d = diag(c"error", c"refactor.script", &tcx);
            buf_str(d, c"cannot read '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 2;
        }
        // The steps: the words of each line, its stdin, its line number.
        var steps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var inputs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var bodies = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var numbers = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if !read_commands(buf_slice(text), file, c"refactor.script", &steps, &inputs,
            &bodies, &numbers, &tcx) {
            return 2;
        }
        for k in 0..steps.count {
            let w = steps.data[k] as *IntVec;
            let first = (*w).data[0] as *u8;
            if !is_tool(word_of(first))
                || ((*w).count > 1 && streq(first, c"refactor")
                    && streq((*w).data[1] as *u8, c"--script")) {
                return line_error(file, numbers.data[k],
                    c"not a command a script runs (refactor, rewrite, edit, fix)", &tcx);
            }
            for x in 1..(*w).count {
                if streq((*w).data[x] as *u8, c"--root")
                    || streq((*w).data[x] as *u8, c"--target") {
                    return line_error(file, numbers.data[k],
                        c"--root and --target are the script's, not a line's", &tcx);
                }
            }
        }
        if steps.count == 0 {
            let d = diag(c"note", c"refactor.script", &tcx);
            buf_str(d, c"no commands in '");
            buf_str(d, file);
            buf_str(d, c"'\n");
            return 0;
        }
        // The steps, in turn.
        let report_buf = buf_new();
        buf_str(report_buf, root);
        // (0.25.5: tagged as the edit copies are, apply.vl copy_path)
        buf_str(report_buf, c".vole-script-");
        buf_str(report_buf, pcx.edit_tag);
        buf_byte(report_buf, '~');
        let report = buf_cstr(report_buf);
        let dry = tcx.dry_run;
        let no_check = tcx.no_check;
        for k in 0..steps.count {
            remove_file(report);
            write_diags(tcx);
            // (a text after `<<WORD`: in a file next to the report, while
            // the command runs)
            var input = inputs.data[k] as *u8;
            let stdin_buf = buf_new();
            buf_str(stdin_buf, root);
            buf_str(stdin_buf, c".vole-stdin-");
            buf_str(stdin_buf, pcx.edit_tag);
            buf_byte(stdin_buf, '~');
            let stdin_path = buf_cstr(stdin_buf);
            if bodies.data[k] >= 0 {
                if !write_file_if(stdin_path, buf_slice(bodies.data[k])) {
                    remove_all_copies(tcx, pcx);
                    return line_error(file, numbers.data[k], c"cannot write the text after <<",
                        &tcx);
                }
                input = stdin_path;
            }
            let status = run_step(steps.data[k] as *IntVec, input, root, report, gpa, &tcx, &pcx);
            if bodies.data[k] >= 0 {
                remove_file(stdin_path);
            }
            if status != 0 {
                read_report(report, &tcx, pcx);
                remove_file(report);
                remove_all_copies(tcx, pcx);
                let d = diag(c"error", c"refactor.script", &tcx);
                buf_str(d, file);
                buf_byte(d, ':');
                buf_int(d, numbers.data[k]);
                buf_str(d, c": the command failed (exit ");
                buf_int(d, status);
                buf_str(d, c"):");
                let w = steps.data[k] as *IntVec;
                for x in 0..(*w).count {
                    crate::tools::query::diagnostics::put_word(d, c_slice((*w).data[x] as *u8));
                }
                buf_str(d, c"; nothing written\n");
                return 1;
            }
            read_report(report, &tcx, pcx);
        }
        remove_file(report);
        tcx.dry_run = dry;
        tcx.no_check = no_check;
        if tcx.script_changed.count == 0 {
            let d = diag(c"note", c"edit.unchanged", &tcx);
            buf_str(d, c"nothing to change\n");
            return 0;
        }
        // One edit: the copies, checked once.
        if !load_program(root, tcx.target, &tcx, &pcx) {
            program_errors(c"error", root, true, &tcx, &pcx);
            remove_all_copies(tcx, pcx);
            return 1;
        }
        for k in 0..tcx.script_changed.count {
            let path = tcx.script_changed.data[k] as *u8;
            let state = tcx.made.data[k];
            if state == 3 {
                continue;
            }
            let ok = if state == 2 { edit_remove_file(c_slice(path), &tcx) }
                else if state == 1 { copy_made(path, &tcx, &pcx) }
                else { copy_rewritten(c_slice(path), &tcx, pcx) };
            if !ok {
                remove_all_copies(tcx, pcx);
                let d = diag(c"error", c"edit.write", &tcx);
                buf_str(d, c"cannot read the copy of '");
                buf_str(d, path);
                buf_str(d, c"'\n");
                return 1;
            }
        }
        let what = buf_new();
        if label != 0 as *u8 {
            buf_str(what, label);
        } else {
            buf_str(what, c"script ");
            buf_str(what, file);
            buf_str(what, c": ");
            buf_int(what, steps.count);
            buf_str(what, if steps.count == 1 { c" command" } else { c" commands" });
        }
        finish_edit(buf_slice(what), root, &tcx, &pcx)
    }
}

fn line_error(file: *u8, line: i64, message: *u8, tcx: inout Tcx<Comp>) -> i64 {
    format_error(c"refactor.script", file, line, message, &tcx);
    2
}

// The commands of text t (of FILE, for messages), one per line, as typed
// after `volec` (0.15: refactor --script's and batch's): per command
// its words (an IntVec of C strings, as split_words splits them), its
// stdin (`< PATH`: the path; `<<WORD`: WORD), the text after `<<WORD` (a
// buffer, else -1) and its line. False after the diagnostic (`code`:
// refactor.script, batch.format).
pub fn read_commands(t: [u8], file: *u8, code: *u8, steps: inout IntVec, inputs: inout IntVec,
    bodies: inout IntVec, numbers: inout IntVec, tcx: inout Tcx<Comp>) -> bool {
    unsafe {
        var p = 0;
        var line_no = 0;
        while p < t.len as i64 {
            var e = p;
            while e < t.len as i64 && t[e] != '\n' {
                e += 1;
            }
            line_no += 1;
            let words = alloc_array::<IntVec>(1);
            words[0] = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let ok = split_words(t[p..e], &words[0]);
            p = e + 1;
            let w = &words[0] as *IntVec;
            if !ok {
                format_error(code, file, line_no, c"a quote is not closed", &tcx);
                return false;
            }
            if (*w).count == 0 {
                continue;
            }
            // (`< PATH`: stdin; 0.14: `<<WORD`, the lines after it up to
            // a line WORD)
            let cmd_line = line_no;
            var input = 0 as *u8;
            var body = -1;
            let n = (*w).count;
            let last = (*w).data[n - 1] as *u8;
            var word = 0 as *u8;
            if n >= 2 && streq((*w).data[n - 2] as *u8, c"<<") {
                word = last;
                (*w).count = n - 2;
            } else if last[0] == '<' && last[1] == '<' && last[2] != 0 {
                word = &last[2];
                (*w).count = n - 1;
            }
            if word != 0 as *u8 {
                input = word;
                body = buf_new();
                var found = false;
                while p < t.len as i64 && !found {
                    var e2 = p;
                    while e2 < t.len as i64 && t[e2] != '\n' {
                        e2 += 1;
                    }
                    line_no += 1;
                    var b = e2;
                    while b > p && (t[b - 1] == ' ' || t[b - 1] == '\t' || t[b - 1] == '\r') {
                        b -= 1;
                    }
                    if bytes_eq(t[p..b], c_slice(word)) {
                        found = true;
                    } else {
                        buf_bytes(body, t[p..e2]);
                        buf_byte(body, '\n');
                    }
                    p = e2 + 1;
                }
                if !found {
                    let d = diag(c"error", code, &tcx);
                    buf_str(d, file);
                    buf_byte(d, ':');
                    buf_int(d, cmd_line);
                    buf_str(d, c": no line '");
                    buf_str(d, word);
                    buf_str(d, c"' ends the text of <<");
                    buf_str(d, word);
                    buf_byte(d, '\n');
                    return false;
                }
            } else if n >= 2 && streq((*w).data[n - 2] as *u8, c"<") {
                input = (*w).data[n - 1] as *u8;
                (*w).count = n - 2;
            } else if (*w).data[n - 1] as *u8 != 0 as *u8 && ((*w).data[n - 1] as *u8)[0] == '<' {
                input = &((*w).data[n - 1] as *u8)[1];
                (*w).count = n - 1;
            }
            if (*w).count == 0 {
                format_error(code, file, cmd_line, c"stdin is given, but no command", &tcx);
                return false;
            }
            steps.push(w as i64);
            inputs.push(input as i64);
            bodies.push(body);
            numbers.push(cmd_line);
        }
        true
    }
}

// `CODE: FILE:LINE: MESSAGE; nothing run`.
pub fn format_error(code: *u8, file: *u8, line: i64, message: *u8, tcx: inout Tcx<Comp>) {
    let d = diag(c"error", code, &tcx);
    buf_str(d, file);
    buf_byte(d, ':');
    buf_int(d, line);
    buf_str(d, c": ");
    buf_str(d, message);
    buf_str(d, c"; nothing run\n");
}
