// `volec assemble [--target T] FILE.s -o FILE.o` (0.19): the compiler's
// own assembler (back/objfile, enc_x86, enc_arm64) on a file of assembly,
// as `cc -c` would assemble it. A developer's tool, for the encoding tests
// (tests/arch/enc.sh: every instruction of the tables with extreme
// registers and memory forms, compared byte for byte with cc's).

use crate::arch::table::load_insns;
use crate::back::objfile::write_object;
use crate::base::{buf_at, buf_byte, buf_len, die, read_file};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{set_target, target_of_name};
use crate::cli::line::{Call, Leaf, is_opt, option, short_option, table};
use crate::middle::ctx::main_cx;

// `assemble`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn assemble_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    // (0.25: on std::cli; any other argument is the input)
    let mut opts = table(gpa);
    opts.push(option("target", "T", "the target (default: the host)"));
    opts.push(short_option("o", "FILE.o", "the object written"));
    Leaf::new(opts, "file")
}

pub fn run_assemble(c: &Call<'_, Gpa>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut target: i64 = 0;
    let mut input = 0 as *const u8;
    let mut output = 0 as *const u8;
    for ev in c.evs.iter().copied() {
        if is_opt(ev, "target") {
            target = target_of_name(ev.value);
            if target == 0 {
                die(c"assemble: unknown target");
            }
        } else if is_opt(ev, "o") {
            output = ev.value;
        } else {
            input = ev.value;
        }
    }
    // UNSAFE: the main function context, reached through its raw pointer (main_cx)
    // SAFETY: main_cx returns the context made once for the process and never freed; `volec
    // assemble` runs on one thread, and the `&mut` made of it here is the only reference to it
    // in use
    unsafe {
        if input == 0 as *mut u8 || output == 0 as *mut u8 {
            die(c"usage: volec assemble [--target T] FILE.s -o FILE.o");
        }
        set_target(if target == 0 { crate::host_target() } else { target }, pcx);
        load_insns();
        let cx = main_cx(pcx);
        read_file(input, cx.asm, pcx);
        if buf_len(cx.asm) > 0
            && buf_at(cx.asm, buf_len(cx.asm) - 1) != b'\n' {
            buf_byte(cx.asm, b'\n');
        }
        write_object(&mut *cx, output, pcx);
        0
    }
}
