// `volec fix --only reexports` (0.12; docs/refactor.md): the imports
// and paths that reach an item through a re-export (a `pub use` of
// another module, or an import of an ancestor module: `use crate::f`
// where the root imports f) are written from the module that defines the
// item; then the re-exports nothing uses any more go (a name still used
// in its own file stays, as a private import).
//
// A re-export with a comment line `// api: ...` right above it is the
// module's interface: it stays, and so do the imports through it. With
// `--in FILE|MODULE`, only the imports and paths there are rewritten, and
// only the re-exports there removed.
//
// A module that a path goes through is found from the path's words
// (`crate`, `self`, `super`, child modules, a module imported by name);
// what the path names is the checker's (the program's references).

use crate::base::{IntVec, SRC, alloc_zeroed, buf_bytes, buf_new, buf_str, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::child;
use crate::front::lexer::Tok;
use crate::front::modules::{child_module, file_of_pos, module_at, module_count, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::tools::ctx::Tcx;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::node_head;
use crate::tools::query::{QF_DEF, QF_USE};
use crate::tools::query::defs::{K_IMPL_METHOD, K_METHOD, K_MOD, K_VARIANT, mod_fqn, mod_fqn_text};
use crate::tools::query::positions::{line_start, token_at};
use crate::tools::query::refs::ref_in;
use crate::tools::refactor_mod::{
    chain_public, load_refs, path_start, put_edit, qualified, use_binding, use_binding_id, use_def,
    use_local, use_node_of,
};
use crate::tools::refactor_mod::cli::is_name_use;
use crate::tools::tidyimports::{put_use_text, use_path_sym};

// The module that segment `name` of a path leads to from module `cur`
// (the first segment: from module `from`, the path's own); -1 when it is
// no module (an item, an enum, std's).
fn step(cur: i64, name: i64, first: bool, from: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.sym_self < 0 {
            pcx.sym_self = intern_c(c"self", &pcx);
        }
        if cur < 0 {
            return -1;
        }
        if first && name == pcx.sym_crate {
            return 0;
        }
        if first && name == pcx.sym_self {
            return from;
        }
        if name == pcx.sym_super {
            return if cur > 0 { pcx.modules[cur].parent } else { -1 };
        }
        let c = child_module(cur, name, pcx);
        if c >= 0 || !first {
            return c;
        }
        // (a module imported by name: `use crate::a::b;` then `b::f`)
        let d = use_binding(from, name, pcx);
        if d >= 0 && pcx.defs[d].kind == K_MOD {
            for m in 1..module_count(pcx) {
                if pcx.mod_def.data[m] == d {
                    return m;
                }
            }
        }
        -1
    }
}

// The module the path of Use item u leads to (-1: none).
fn use_via(u: i64, pcx: inout Ctx<Comp>) -> i64 {
    let path = pcx.nodes[u].c;
    let from = module_of(u, &pcx);
    var cur = from;
    for i in 0..pcx.nodes[path].count {
        cur = step(cur, pcx.nodes[child(path, i, pcx)].a, i == 0, from, &pcx);
    }
    if pcx.nodes[path].count == 0 { -1 } else { cur }
}

// The module the path before the name at pos leads to (`a::b::NAME`), or
// -1.
fn path_via(pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let from = module_at(pos, &pcx);
    var i = token_at(path_start(pos, pcx), pcx);
    let end = token_at(pos, pcx);
    var cur = from;
    var first = true;
    while i < end {
        if pcx.toks[i].kind == Tok::Ident {
            cur = step(cur, pcx.toks[i].value as i64, first, from, &pcx);
            first = false;
        }
        i += 1;
    }
    cur
}

// Whether definition d is an item imports and paths name (not a module, a
// method, a variant, a field).
fn plain_item(d: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.defs[d].kind;
    pcx.defs[d].parent < 0 && k != K_MOD && k != K_METHOD && k != K_IMPL_METHOD && k != K_VARIANT
}

// Whether Use item u is marked as the module's interface: a comment line
// `// api: ...` in the comment lines right above it.
fn api_marked(u: i64, pcx: Ctx<Comp>) -> bool {
    let f = file_of_pos(pcx.nodes[u].start, pcx);
    var ls = line_start(node_head(pcx.nodes[u].start, pcx), pcx);
    while ls > pcx.files[f].start {
        let prev = line_start(ls - 1, pcx);
        var p = prev;
        while SRC[p] == ' ' || SRC[p] == '\t' {
            p += 1;
        }
        if SRC[p] != '/' || SRC[p + 1] != '/' {
            return false;
        }
        p += 2;
        while SRC[p] == ' ' {
            p += 1;
        }
        if SRC[p] == 'a' && SRC[p + 1] == 'p' && SRC[p + 2] == 'i' && SRC[p + 3] == ':' {
            return true;
        }
        ls = prev;
    }
    false
}

// Whether identifier `name` is written in file f outside SRC[a..b).
fn named_in_file(name: i64, f: i64, a: i64, b: i64, pcx: Ctx<Comp>) -> bool {
    var i = token_at(pcx.files[f].start, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i].start < pcx.files[f].end {
        if pcx.toks[i].kind == Tok::Ident && pcx.toks[i].value as i64 == name
            && (pcx.toks[i].start < a || pcx.toks[i].start >= b) {
            return true;
        }
        i += 1;
    }
    false
}

// Whether something goes through the import (or re-export) of `name` in
// module m: an import or a path of another module whose words lead to m
// (`use crate::m::name`, `m::name(...)`, `m::name::Variant`), that the
// fix does not rewrite. So it is not unused although its own file does
// not name it (`fix --only unused`, `query unused`).
pub fn reached_through(m: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) || module_of(u, &pcx) == m {
                continue;
            }
            let path = pcx.nodes[u].c;
            let from = module_of(u, &pcx);
            var cur = from;
            for i in 0..pcx.nodes[path].count {
                let a = pcx.nodes[child(path, i, pcx)].a;
                if i > 0 && cur == m && a == name {
                    return true;
                }
                cur = step(cur, a, i == 0, from, &pcx);
            }
            if cur != m {
                continue;
            }
            for k in 0..pcx.nodes[u].count {
                let c = child(u, k, pcx);
                if pcx.nodes[c].a == name && pcx.new_home.get(c) == 0 {
                    return true;
                }
            }
        }
        for i in 2..pcx.toks.len() as i64 {
            if pcx.toks[i].kind == Tok::Ident && pcx.toks[i].value as i64 == name
                && pcx.toks[i - 1].kind == Tok::ColonColon
                && pcx.rewritten.get(pcx.toks[i].start + 1) == 0
                && module_at(pcx.toks[i].start, &pcx) != m
                && pcx.files[file_of_pos(pcx.toks[i].start, pcx)].path[0] != '<'
                && path_via(pcx.toks[i].start, &pcx) == m {
                return true;
            }
        }
        false
    }
}

// The re-export (an Ident node of a `use` of module via) that importing
// `name` from via goes through, when it is not the interface (`// api:`);
// 0 for none.
fn reexport_of(via: i64, name: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let r = use_binding_id(via, name, pcx);
    if r == 0 || api_marked(use_node_of(r, tcx), pcx) {
        return 0;
    }
    r
}

// The edits of `fix --only reexports`: how many imports and paths are
// rewritten; *dropped, how many re-exports go (or become private).
pub fn reexport_edits(dropped: inout i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        load_refs(&tcx, &pcx);
        var fixes = 0;
        // The imports through a re-export.
        var touched = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) {
                continue;
            }
            let via = use_via(u, &pcx);
            if via < 0 {
                continue;
            }
            var any = false;
            for k in 0..pcx.nodes[u].count {
                let id = child(u, k, pcx);
                let d = use_def(id, pcx);
                if d < 0 || !plain_item(d, pcx) || pcx.defs[d].module == via {
                    continue;
                }
                let r = reexport_of(via, pcx.nodes[id].a, tcx, pcx);
                if r == 0 {
                    continue;
                }
                if !ref_in(pcx.nodes[u].start, &pcx) {
                    continue;
                }
                pcx.new_home.put(id, pcx.defs[d].module + 1);
                chain_public(module_of(u, &pcx), pcx.defs[d].module, &tcx, &pcx);
                any = true;
                fixes += 1;
            }
            if any {
                touched.push(u);
            }
        }
        // The paths through one: `a::reexported(...)`.
        for k in 0..tcx.refs.count {
            let r = tcx.refs.data[k];
            let p = tcx.r_pos.data[r];
            let d = tcx.r_def.data[r];
            if (tcx.r_flags.data[r] & (QF_DEF | QF_USE)) != 0 || !plain_item(d, pcx)
                || !qualified(p, pcx)
                || pcx.files[file_of_pos(p, pcx)].path[0] == '<' {
                continue;
            }
            let ti = token_at(p, pcx);
            if ti >= pcx.toks.len() as i64 || pcx.toks[ti].start != p
                || pcx.toks[ti].kind != Tok::Ident {
                continue;
            }
            let via = path_via(p, &pcx);
            if via < 0 || via == pcx.defs[d].module {
                continue;
            }
            if reexport_of(via, pcx.toks[ti].value as i64, tcx, pcx) == 0 || !ref_in(p, &pcx)
                || pcx.toks[token_at(path_start(p, pcx), pcx) - 1].kind == Tok::Use {
                continue;
            }
            pcx.rewritten.put(p + 1, 1);
            let b = buf_new();
            buf_bytes(b, mod_fqn_text(pcx.defs[d].module, &tcx, &pcx));
            buf_str(b, c"::");
            buf_bytes(b, sym_text(pcx.defs[d].name, pcx));
            put_edit(path_start(p, pcx), pcx.toks[ti].end, b, &tcx, &pcx);
            chain_public(module_at(p, &pcx), pcx.defs[d].module, &tcx, &pcx);
            fixes += 1;
        }
        // The re-exports nothing goes through any more.
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) || (pcx.nodes[u].p & ITEM_PUBLIC) == 0
                || !ref_in(pcx.nodes[u].start, &pcx)
                || api_marked(u, pcx) {
                continue;
            }
            let f = file_of_pos(pcx.nodes[u].start, pcx);
            var any = false;
            for k in 0..pcx.nodes[u].count {
                let id = child(u, k, pcx);
                if reached_through(module_of(u, &pcx), use_local(id, pcx), &pcx) {
                    continue;
                }
                if named_in_file(use_local(id, pcx), f, pcx.nodes[u].start, pcx.nodes[u].end, pcx) {
                    tcx.demote.put(id, 1);
                } else {
                    tcx.drop.put(id, 1);
                }
                dropped += 1;
                any = true;
            }
            if any {
                var seen = false;
                for i in 0..touched.count {
                    if touched.data[i] == u {
                        seen = true;
                    }
                }
                if !seen {
                    touched.push(u);
                }
            }
        }
        for i in 0..touched.count {
            rewrite_use(touched.data[i], &tcx, &pcx);
        }
        fixes
    }
}

// Use item u's new text: its names under their paths (its own, or their
// new modules'), `pub` as it was (or not, made private), the dropped ones
// gone; its lines removed when none is left.
fn rewrite_use(u: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let public = (pcx.nodes[u].p & ITEM_PUBLIC) != 0;
        let head = node_head(pcx.nodes[u].start, pcx);
        let from = line_start(head, pcx);
        var blank = true;
        for p in from..head {
            if SRC[p] != ' ' && SRC[p] != '\t' {
                blank = false;
            }
        }
        // The groups: (path symbol, pub) in order of first name.
        var g_path = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var g_pub = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var g_names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var g_alias = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let own = use_path_sym(u, &pcx);
        // (the names that keep its path first, then the others)
        for x in 0..2 * pcx.nodes[u].count {
            let k = x % pcx.nodes[u].count;
            let id = child(u, k, pcx);
            if tcx.drop.get(id) != 0 || (pcx.new_home.get(id) != 0) != (x >= pcx.nodes[u].count) {
                continue;
            }
            let h = pcx.new_home.get(id) - 1;
            let path = if h >= 0 { mod_fqn(h, &tcx, &pcx) } else { own };
            let pb = public && tcx.demote.get(id) == 0;
            var g = -1;
            for j in 0..g_path.count {
                if g_path.data[j] == path && (g_pub.data[j] != 0) == pb {
                    g = j;
                }
            }
            if g < 0 {
                g = g_path.count;
                g_path.push(path);
                g_pub.push(if pb { 1 } else { 0 });
                let names = alloc_vec();
                let alias = alloc_vec();
                g_names.push(names);
                g_alias.push(alias);
            }
            // (the name it is defined with, under the name it had here)
            let d = use_def(id, pcx);
            let real = if h >= 0 && d >= 0 { pcx.defs[d].name } else { pcx.nodes[id].a };
            let local = use_local(id, pcx);
            if real == local {
                (g_names.data[g] as *IntVec).push(real);
            } else {
                (g_alias.data[g] as *IntVec).push(real);
                (g_alias.data[g] as *IntVec).push(local);
            }
        }
        if g_path.count == 0 {
            if blank {
                delete_lines(from, pcx.nodes[u].end, &pcx);
            } else {
                put_edit(head, pcx.nodes[u].end, buf_new(), &tcx, &pcx);
            }
            return;
        }
        let text = buf_new();
        let indent = if blank { SRC[from..head] } else { SRC[from..from] };
        for j in 0..g_path.count {
            if j > 0 {
                buf_str(text, c"\n");
            }
            put_use_text(text, indent, g_pub.data[j] != 0, sym_text(g_path.data[j], pcx),
                g_names.data[j] as *IntVec, g_alias.data[j] as *IntVec, pcx);
        }
        put_edit(if blank { from } else { head }, pcx.nodes[u].end, text, &tcx, &pcx);
    }
}

// A new, empty IntVec (its address, as an i64).
fn alloc_vec() -> i64 {
    alloc_zeroed(24) as i64
}
