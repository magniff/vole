// `volec fix --only reexports` (0.12; docs/refactor.md): the imports
// and paths that reach an item through a re-export (a `pub use` of
// another module, or an import of an ancestor module: `use crate::f`
// where the root imports f) are written from the module that defines the
// item; then the re-exports nothing uses any more go (a name still used
// in its own file stays, as a private import).
//
// A re-export with a comment line `// api: ...` right above it is the
// module's interface: it stays, and so do the imports through it. With
// `--in FILE|MODULE`, only the imports and paths there are rewritten, and
// only the re-exports there removed.
//
// A module that a path goes through is found from the path's words
// (`crate`, `self`, `super`, child modules, a module imported by name);
// what the path names is the checker's (the program's references).

use crate::base::{IntVec, get_src, alloc_zeroed, buf_bytes, buf_new, buf_str, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::child;
use crate::front::lexer::Tok;
use crate::front::modules::{child_module, file_of_pos, module_at, module_count, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::tools::ctx::Tcx;
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::node_head;
use crate::tools::query::{QF_DEF, QF_USE};
use crate::tools::query::defs::{K_IMPL_METHOD, K_METHOD, K_MOD, K_VARIANT, mod_fqn, mod_fqn_text};
use crate::tools::query::positions::{line_start, token_at};
use crate::tools::query::refs::ref_in;
use crate::tools::refactor_mod::{
    chain_public, load_refs, path_start, put_edit, qualified, use_binding, use_binding_id, use_def,
    use_local, use_node_of,
};
use crate::tools::refactor_mod::cli::is_name_use;
use crate::tools::tidyimports::{put_use_text, use_path_sym};

// The module that segment `name` of a path leads to from module `cur`
// (the first segment: from module `from`, the path's own); -1 when it is
// no module (an item, an enum, std's).
fn step(cur: i64, name: i64, first: bool, from: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.sym_self < 0 {
            pcx.sym_self = intern_c(c"self", pcx);
        }
        if cur < 0 {
            return -1;
        }
        if first && name == pcx.sym_crate {
            return 0;
        }
        if first && name == pcx.sym_self {
            return from;
        }
        if name == pcx.sym_super {
            return if cur > 0 { pcx.modules[cur as usize].parent } else { -1 };
        }
        let c = child_module(cur, name, pcx);
        if c >= 0 || !first {
            return c;
        }
        // (a module imported by name: `use crate::a::b;` then `b::f`)
        let d = use_binding(from, name, pcx);
        if d >= 0 && pcx.defs[d as usize].kind == K_MOD {
            for m in 1..module_count(pcx) {
                if (*pcx.mod_def.data.add(m as usize)) == d {
                    return m;
                }
            }
        }
        -1
    }
}

// The module the path of Use item u leads to (-1: none).
fn use_via(u: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let path = pcx.nodes[u as usize].c;
    let from = module_of(u, pcx);
    let mut cur = from;
    for i in 0..pcx.nodes[path as usize].count {
        cur = step(cur, pcx.nodes[child(path, i, pcx) as usize].a, i == 0, from, pcx);
    }
    if pcx.nodes[path as usize].count == 0 { -1 } else { cur }
}

// The module the path before the name at pos leads to (`a::b::NAME`), or
// -1.
fn path_via(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let from = module_at(pos, pcx);
    let mut i = token_at(path_start(pos, pcx), pcx);
    let end = token_at(pos, pcx);
    let mut cur = from;
    let mut first = true;
    while i < end {
        if pcx.toks[i as usize].kind == Tok::Ident {
            cur = step(cur, pcx.toks[i as usize].value as i64, first, from, pcx);
            first = false;
        }
        i += 1;
    }
    cur
}

// Whether definition d is an item imports and paths name (not a module, a
// method, a variant, a field).
fn plain_item(d: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    pcx.defs[d as usize].parent < 0 && k != K_MOD && k != K_METHOD && k != K_IMPL_METHOD && k != K_VARIANT
}

// Whether Use item u is marked as the module's interface: a comment line
// `// api: ...` in the comment lines right above it.
fn api_marked(u: i64, pcx: &Ctx<Comp>) -> bool {
    let f = file_of_pos(pcx.nodes[u as usize].start, pcx);
    let mut ls = line_start(node_head(pcx.nodes[u as usize].start, pcx), pcx);
    while ls > pcx.files[f as usize].start {
        let prev = line_start(ls - 1, pcx);
        let mut p = prev;
        while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
            p += 1;
        }
        if get_src()[p as usize] != b'/' || get_src()[(p + 1) as usize] != b'/' {
            return false;
        }
        p += 2;
        while get_src()[p as usize] == b' ' {
            p += 1;
        }
        if get_src()[p as usize] == b'a' && get_src()[(p + 1) as usize] == b'p' && get_src()[(p + 2) as usize] == b'i' && get_src()[(p + 3) as usize] == b':' {
            return true;
        }
        ls = prev;
    }
    false
}

// Whether identifier `name` is written in file f outside SRC[a..b).
fn named_in_file(name: i64, f: i64, a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let mut i = token_at(pcx.files[f as usize].start, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < pcx.files[f as usize].end {
        if pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == name
            && (pcx.toks[i as usize].start < a || pcx.toks[i as usize].start >= b) {
            return true;
        }
        i += 1;
    }
    false
}

// Whether something goes through the import (or re-export) of `name` in
// module m: an import or a path of another module whose words lead to m
// (`use crate::m::name`, `m::name(...)`, `m::name::Variant`), that the
// fix does not rewrite. So it is not unused although its own file does
// not name it (`fix --only unused`, `query unused`).
pub fn reached_through(m: i64, name: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) || module_of(u, pcx) == m {
                continue;
            }
            let path = pcx.nodes[u as usize].c;
            let from = module_of(u, pcx);
            let mut cur = from;
            for i in 0..pcx.nodes[path as usize].count {
                let a = pcx.nodes[child(path, i, pcx) as usize].a;
                if i > 0 && cur == m && a == name {
                    return true;
                }
                cur = step(cur, a, i == 0, from, pcx);
            }
            if cur != m {
                continue;
            }
            for k in 0..pcx.nodes[u as usize].count {
                let c = child(u, k, pcx);
                if pcx.nodes[c as usize].a == name && pcx.new_home.get(c) == 0 {
                    return true;
                }
            }
        }
        for i in 2..pcx.toks.len() as i64 {
            if pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == name
                && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon
                && pcx.rewritten.get(pcx.toks[i as usize].start + 1) == 0
                && module_at(pcx.toks[i as usize].start, pcx) != m
                && (*pcx.files[file_of_pos(pcx.toks[i as usize].start, pcx) as usize].path.add(0)) != b'<'
                && path_via(pcx.toks[i as usize].start, pcx) == m {
                return true;
            }
        }
        false
    }
}

// The re-export (an Ident node of a `use` of module via) that importing
// `name` from via goes through, when it is not the interface (`// api:`);
// 0 for none.
fn reexport_of(via: i64, name: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let r = use_binding_id(via, name, pcx);
    if r == 0 || api_marked(use_node_of(r, tcx), pcx) {
        return 0;
    }
    r
}

// The edits of `fix --only reexports`: how many imports and paths are
// rewritten; *dropped, how many re-exports go (or become private).
pub fn reexport_edits(dropped: &mut i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        load_refs(tcx, pcx);
        let mut fixes: i64 = 0;
        // The imports through a re-export.
        let mut touched = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) {
                continue;
            }
            let via = use_via(u, pcx);
            if via < 0 {
                continue;
            }
            let mut any = false;
            for k in 0..pcx.nodes[u as usize].count {
                let id = child(u, k, pcx);
                let d = use_def(id, pcx);
                if d < 0 || !plain_item(d, pcx) || pcx.defs[d as usize].module == via {
                    continue;
                }
                let r = reexport_of(via, pcx.nodes[id as usize].a, tcx, pcx);
                if r == 0 {
                    continue;
                }
                if !ref_in(pcx.nodes[u as usize].start, pcx) {
                    continue;
                }
                pcx.new_home.put(id, pcx.defs[d as usize].module + 1);
                chain_public(module_of(u, pcx), pcx.defs[d as usize].module, tcx, pcx);
                any = true;
                fixes += 1;
            }
            if any {
                touched.push(u);
            }
        }
        // The paths through one: `a::reexported(...)`.
        for k in 0..tcx.refs.count {
            let r = (*tcx.refs.data.add(k as usize));
            let p = (*tcx.r_pos.data.add(r as usize));
            let d = (*tcx.r_def.data.add(r as usize));
            if ((*tcx.r_flags.data.add(r as usize)) & (QF_DEF | QF_USE)) != 0 || !plain_item(d, pcx)
                || !qualified(p, pcx)
                || (*pcx.files[file_of_pos(p, pcx) as usize].path.add(0)) == b'<' {
                continue;
            }
            let ti = token_at(p, pcx);
            if ti >= pcx.toks.len() as i64 || pcx.toks[ti as usize].start != p
                || pcx.toks[ti as usize].kind != Tok::Ident {
                continue;
            }
            let via = path_via(p, pcx);
            if via < 0 || via == pcx.defs[d as usize].module {
                continue;
            }
            if reexport_of(via, pcx.toks[ti as usize].value as i64, tcx, pcx) == 0 || !ref_in(p, pcx)
                || pcx.toks[(token_at(path_start(p, pcx), pcx) - 1) as usize].kind == Tok::Use {
                continue;
            }
            pcx.rewritten.put(p + 1, 1);
            let b = buf_new();
            buf_bytes(b, mod_fqn_text(pcx.defs[d as usize].module, tcx, pcx));
            buf_str(b, c"::");
            buf_bytes(b, sym_text(pcx.defs[d as usize].name, pcx));
            put_edit(path_start(p, pcx), pcx.toks[ti as usize].end, b, tcx, pcx);
            chain_public(module_at(p, pcx), pcx.defs[d as usize].module, tcx, pcx);
            fixes += 1;
        }
        // The re-exports nothing goes through any more.
        for u in 1..pcx.nodes.len() as i64 {
            if !is_name_use(u, pcx) || (pcx.nodes[u as usize].p & ITEM_PUBLIC) == 0
                || !ref_in(pcx.nodes[u as usize].start, pcx)
                || api_marked(u, pcx) {
                continue;
            }
            let f = file_of_pos(pcx.nodes[u as usize].start, pcx);
            let mut any = false;
            for k in 0..pcx.nodes[u as usize].count {
                let id = child(u, k, pcx);
                if reached_through(module_of(u, pcx), use_local(id, pcx), pcx) {
                    continue;
                }
                if named_in_file(use_local(id, pcx), f, pcx.nodes[u as usize].start, pcx.nodes[u as usize].end, pcx) {
                    tcx.demote.put(id, 1);
                } else {
                    tcx.drop.put(id, 1);
                }
                *dropped += 1;
                any = true;
            }
            if any {
                let mut seen = false;
                for i in 0..touched.count {
                    if (*touched.data.add(i as usize)) == u {
                        seen = true;
                    }
                }
                if !seen {
                    touched.push(u);
                }
            }
        }
        for i in 0..touched.count {
            rewrite_use((*touched.data.add(i as usize)), tcx, pcx);
        }
        fixes
    }
}

// Use item u's new text: its names under their paths (its own, or their
// new modules'), `pub` as it was (or not, made private), the dropped ones
// gone; its lines removed when none is left.
fn rewrite_use(u: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let public = (pcx.nodes[u as usize].p & ITEM_PUBLIC) != 0;
        let head = node_head(pcx.nodes[u as usize].start, pcx);
        let from = line_start(head, pcx);
        let mut blank = true;
        for p in from..head {
            if get_src()[p as usize] != b' ' && get_src()[p as usize] != b'\t' {
                blank = false;
            }
        }
        // The groups: (path symbol, pub) in order of first name.
        let mut g_path = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut g_pub = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut g_names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut g_alias = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let own = use_path_sym(u, pcx);
        // (the names that keep its path first, then the others)
        for x in 0..2 * pcx.nodes[u as usize].count {
            let k = x % pcx.nodes[u as usize].count;
            let id = child(u, k, pcx);
            if tcx.drop.get(id) != 0 || (pcx.new_home.get(id) != 0) != (x >= pcx.nodes[u as usize].count) {
                continue;
            }
            let h = pcx.new_home.get(id) - 1;
            let path = if h >= 0 { mod_fqn(h, tcx, pcx) } else { own };
            let pb = public && tcx.demote.get(id) == 0;
            let mut g: i64 = -1;
            for j in 0..g_path.count {
                if (*g_path.data.add(j as usize)) == path && ((*g_pub.data.add(j as usize)) != 0) == pb {
                    g = j;
                }
            }
            if g < 0 {
                g = g_path.count;
                g_path.push(path);
                g_pub.push(if pb { 1 } else { 0 });
                let names = alloc_vec();
                let alias = alloc_vec();
                g_names.push(names);
                g_alias.push(alias);
            }
            // (the name it is defined with, under the name it had here)
            let d = use_def(id, pcx);
            let real = if h >= 0 && d >= 0 { pcx.defs[d as usize].name } else { pcx.nodes[id as usize].a };
            let local = use_local(id, pcx);
            if real == local {
                ((*g_names.data.add(g as usize)) as *mut IntVec).push(real);
            } else {
                ((*g_alias.data.add(g as usize)) as *mut IntVec).push(real);
                ((*g_alias.data.add(g as usize)) as *mut IntVec).push(local);
            }
        }
        if g_path.count == 0 {
            if blank {
                delete_lines(from, pcx.nodes[u as usize].end, pcx);
            } else {
                put_edit(head, pcx.nodes[u as usize].end, buf_new(), tcx, pcx);
            }
            return;
        }
        let text = buf_new();
        let indent = if blank { &get_src()[from as usize..head as usize] } else { &get_src()[from as usize..from as usize] };
        for j in 0..g_path.count {
            if j > 0 {
                buf_str(text, c"\n");
            }
            put_use_text(text, indent, (*g_pub.data.add(j as usize)) != 0, sym_text((*g_path.data.add(j as usize)), pcx),
                (*g_names.data.add(j as usize)) as *mut IntVec, (*g_alias.data.add(j as usize)) as *mut IntVec, pcx);
        }
        put_edit(if blank { from } else { head }, pcx.nodes[u as usize].end, text, tcx, pcx);
    }
}

// A new, empty IntVec (its address, as an i64).
fn alloc_vec() -> i64 {
    alloc_zeroed(24) as i64
}
