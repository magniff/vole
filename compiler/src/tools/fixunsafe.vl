// `volec --fix-unsafe FILE...` (0.9): rewrites a program, in place, so
// that its unsafe operations are inside unsafe blocks (see "Unsafe code"
// in check.vl), for 0.10, where an unsafe operation outside unsafe
// code is an error.
//
// The checker notes, for each unsafe operation outside unsafe code, the
// innermost unit around it that can be wrapped: a statement, a block's
// tail, a condition (`if`, `while`, `match`, `for x in`) or a match arm's
// body. Each is wrapped once, the outermost of nested ones:
//
//   - a statement `e;` becomes `unsafe { e; }`, and consecutive such
//     statements share one block, one statement per line;
//   - `let p = e;` becomes `let p = unsafe { e };` (so that the binding
//     stays in scope);
//   - an expression (a tail, a condition, an arm, a deferred statement)
//     becomes `unsafe { e }`.
//
// What is not wrapped is left as it is, byte for byte; a second run finds
// nothing to do.

use crate::base::{get_src, buf_byte, buf_bytes, buf_new, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::NodeKind;
use crate::front::modules::{file_of_pos, within_std};
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::positions::enclosing;
use crate::tools::query::refs::ref_in;

pub fn note_unsafe_site(node: i64, pcx: &mut Ctx<Comp>) {
    if node == 0 {
        return;
    }
    for i in 0..pcx.sites.len() {
        if pcx.sites[i] == node {
            return;
        }
    }
    pcx.sites.push(node);
}

// The widest line kept on one line.
const LINE_WIDTH: i64 = 100;

// Kinds of ranges: statements ending with `;`, or an expression.
const R_STMT: i64 = 1;
const R_EXPR: i64 = 2;

fn line_start(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pos, pcx);
    let mut i = pos;
    while i > pcx.files[f as usize].start && get_src()[(i - 1) as usize] != b'\n' {
        i -= 1;
    }
    i
}

fn line_end(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pos, pcx);
    let mut i = pos;
    while i < pcx.files[f as usize].end && get_src()[i as usize] != b'\n' {
        i += 1;
    }
    i
}

fn blank(from: i64, to: i64) -> bool {
    for i in from..to {
        if get_src()[i as usize] != b' ' && get_src()[i as usize] != b'\t' && get_src()[i as usize] != b'\r' && get_src()[i as usize] != b'\n' {
            return false;
        }
    }
    true
}

fn has_newline(from: i64, to: i64) -> bool {
    for i in from..to {
        if get_src()[i as usize] == b'\n' {
            return true;
        }
    }
    false
}

// The text of [from, to) with every line after the first indented by
// four more spaces (blank lines stay empty).
fn push_indented(out: i64, from: i64, to: i64) {
    let mut at_line_start = false;
    for i in from..to {
        let c = get_src()[i as usize];
        if at_line_start && c != b'\n' {
            buf_str(out, c"    ");
        }
        buf_byte(out, c);
        at_line_start = c == b'\n';
    }
}

// Appends an edit: replace [pos, pos + del) by buffer text.
fn add_edit(edits: &mut Vec<i64, Comp>, pos: i64, del: i64, text: i64) {
    edits.push(pos);
    edits.push(del);
    edits.push(text);
}

// The edit wrapping [s, e) (a range of kind `kind`).
fn wrap_edit(s: i64, e: i64, kind: i64, edits: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let ls = line_start(s, pcx);
    let le = line_end(e, pcx);
    let alone = blank(ls, s) && blank(e, le);
    let multi = has_newline(s, e);
    if alone && (multi || (kind == R_STMT && (le - ls) + 12 > LINE_WIDTH)) {
        // On lines of their own:
        //     unsafe {
        //         ...
        //     }
        let indent = &get_src()[ls as usize..s as usize];
        let text = buf_new();
        buf_bytes(text, indent);
        buf_str(text, c"unsafe {\n");
        buf_bytes(text, indent);
        buf_str(text, c"    ");
        push_indented(text, s, e);
        buf_byte(text, b'\n');
        buf_bytes(text, indent);
        buf_byte(text, b'}');
        add_edit(edits, ls, e - ls, text);
        return;
    }
    let open = buf_new();
    buf_str(open, c"unsafe { ");
    add_edit(edits, s, 0, open);
    let close = buf_new();
    buf_str(close, c" }");
    add_edit(edits, e, 0, close);
}

// The body (a block node) of the function holding pos, or -1.
fn body_of(pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = enclosing(pos, tcx, pcx);
    if d < 0 {
        return -1;
    }
    let n = pcx.defs[d as usize].node;
    if n <= 0 || pcx.nodes[n as usize].kind != NodeKind::Fn {
        return -1;
    }
    let b = pcx.nodes[n as usize].c;
    if b <= 0 || pos < pcx.nodes[b as usize].start || pos >= pcx.nodes[b as usize].end {
        return -1;
    }
    b
}

// How many of the ranges (start, end, kind) are in body b.
fn sites_in(ranges: &Vec<i64, Comp>, b: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < ranges.len() as i64 {
        if body_of(ranges[i as usize], tcx, pcx) == b {
            n += 1;
        }
        i += 3;
    }
    n
}

// Whether body b's braces have lines of their own: `{` last on its line,
// `}` first on its.
fn wrappable(b: i64, pcx: &Ctx<Comp>) -> bool {
    let s = pcx.nodes[b as usize].start;
    let e = pcx.nodes[b as usize].end;
    get_src()[s as usize] == b'{' && get_src()[(e - 1) as usize] == b'}' && has_newline(s, e) && blank(s + 1, line_end(s, pcx))
        && blank(line_start(e - 1, pcx), e - 1)
}

// The edit putting body b's lines in an unsafe block, indented one
// level more.
fn wrap_body(b: i64, edits: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let first = line_end(pcx.nodes[b as usize].start, pcx) + 1;
    let last = line_start(pcx.nodes[b as usize].end - 1, pcx);
    let indent = &get_src()[last as usize..(pcx.nodes[b as usize].end - 1) as usize];
    let text = buf_new();
    buf_bytes(text, indent);
    buf_str(text, c"    unsafe {\n");
    let mut p = first;
    while p < last {
        let e = line_end(p, pcx);
        if !blank(p, e) {
            buf_str(text, c"    ");
            buf_bytes(text, &get_src()[p as usize..e as usize]);
        }
        buf_byte(text, b'\n');
        p = e + 1;
    }
    buf_bytes(text, indent);
    buf_str(text, c"    }\n");
    add_edit(edits, first, last - first, text);
}

// The edits wrapping the unsafe operations (to the edit engine,
// edit.vl); returns the number of unsafe blocks made.
pub fn fix_unsafe_edits(tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    // The ranges: start, end, kind.
    let mut ranges: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..pcx.sites.len() {
        let w = pcx.sites[i];
        let kind = pcx.nodes[w as usize].kind;
        let mut s = pcx.nodes[w as usize].start;
        let mut e = pcx.nodes[w as usize].end;
        let mut k = R_EXPR;
        if kind == NodeKind::Let {
            s = pcx.nodes[pcx.nodes[w as usize].c as usize].start;
            e = pcx.nodes[pcx.nodes[w as usize].c as usize].end;
        } else if kind == NodeKind::Defer {
            s = pcx.nodes[pcx.nodes[w as usize].a as usize].start;
            e = pcx.nodes[pcx.nodes[w as usize].a as usize].end;
        } else if kind == NodeKind::ExprStmt {
            if pcx.nodes[w as usize].b == 1 {
                k = R_STMT;
            } else {
                s = pcx.nodes[pcx.nodes[w as usize].a as usize].start;
                e = pcx.nodes[pcx.nodes[w as usize].a as usize].end;
            }
        }
        let f = file_of_pos(s, pcx);
        if within_std(pcx.files[f as usize].module, pcx) || pcx.files[f as usize].module == pcx.c_module
            || !ref_in(s, pcx) {
            continue;
        }
        ranges.push(s);
        ranges.push(e);
        ranges.push(k);
    }
    // By start, the outer of nested ranges first (an insertion sort).
    let n = ranges.len() as i64 / 3;
    for a in 1..n {
        let mut j = a;
        while j > 0 && (ranges[(3 * j) as usize] < ranges[(3 * (j - 1)) as usize]
            || (ranges[(3 * j) as usize] == ranges[(3 * (j - 1)) as usize]
                && ranges[(3 * j + 1) as usize] > ranges[(3 * (j - 1) + 1) as usize])) {
            for x in 0..3 {
                let t = ranges[(3 * j + x) as usize];
                ranges[(3 * j + x) as usize] = ranges[(3 * (j - 1) + x) as usize];
                ranges[(3 * (j - 1) + x) as usize] = t;
            }
            j -= 1;
        }
    }
    // The outermost ones, consecutive statements merged.
    let mut kept: Vec<i64, Comp> = Vec::new_in(Comp {});
    for a in 0..n {
        let s = ranges[(3 * a) as usize];
        let e = ranges[(3 * a + 1) as usize];
        let k = ranges[(3 * a + 2) as usize];
        if kept.len() > 0 {
            let ps = kept[(kept.len() as i64 - 3) as usize];
            let pe = kept[(kept.len() as i64 - 2) as usize];
            let pk = kept[(kept.len() as i64 - 1) as usize];
            if s >= ps && e <= pe {
                continue;
            }
            if k == R_STMT && pk == R_STMT && s >= pe && blank(pe, s)
                && file_of_pos(s, pcx) == file_of_pos(ps, pcx) {
                { let at_ix = (kept.len() as i64 - 2) as usize; kept[at_ix] = e };
                continue;
            }
        }
        kept.push(s);
        kept.push(e);
        kept.push(k);
    }
    // A function with several unsafe operations: its whole body in
    // one unsafe block (the codebase's style, 0.12), when its braces
    // have lines of their own.
    let mut bodies: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut rest: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut a: i64 = 0;
    while a < kept.len() as i64 {
        let b = body_of(kept[a as usize], tcx, pcx);
        if tcx.whole_bodies && b >= 0 && sites_in(&ranges, b, tcx, pcx) >= 2 && wrappable(b, pcx) {
            let mut seen = false;
            for x in 0..bodies.len() {
                if bodies[x] == b {
                    seen = true;
                }
            }
            if !seen {
                bodies.push(b);
            }
        } else {
            rest.push(kept[a as usize]);
            rest.push(kept[(a + 1) as usize]);
            rest.push(kept[(a + 2) as usize]);
        }
        a += 3;
    }
    let mut edits: Vec<i64, Comp> = Vec::new_in(Comp {});
    a = 0;
    while a < rest.len() as i64 {
        wrap_edit(rest[a as usize], rest[(a + 1) as usize], rest[(a + 2) as usize], &mut edits, pcx);
        a += 3;
    }
    for x in 0..bodies.len() {
        wrap_body(bodies[x], &mut edits, pcx);
    }
    // (in order of position; edits at one position keep their order)
    let m = edits.len() as i64 / 3;
    for x in 1..m {
        let mut j = x;
        while j > 0 && edits[(3 * j) as usize] < edits[(3 * (j - 1)) as usize] {
            for y in 0..3 {
                let t = edits[(3 * j + y) as usize];
                edits[(3 * j + y) as usize] = edits[(3 * (j - 1) + y) as usize];
                edits[(3 * (j - 1) + y) as usize] = t;
            }
            j -= 1;
        }
    }
    let mut k: i64 = 0;
    while k < edits.len() as i64 {
        edit_replace(edits[k as usize], edits[k as usize] + edits[(k + 1) as usize], edits[(k + 2) as usize], pcx);
        k += 3;
    }
    rest.len() as i64 / 3 + bodies.len() as i64
}
