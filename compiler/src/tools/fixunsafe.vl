// `volec --fix-unsafe FILE...` (0.9): rewrites a program, in place, so
// that its unsafe operations are inside unsafe blocks (see "Unsafe code"
// in check.vl), for 0.10, where an unsafe operation outside unsafe
// code is an error.
//
// The checker notes, for each unsafe operation outside unsafe code, the
// innermost unit around it that can be wrapped: a statement, a block's
// tail, a condition (`if`, `while`, `match`, `for x in`) or a match arm's
// body. Each is wrapped once, the outermost of nested ones:
//
//   - a statement `e;` becomes `unsafe { e; }`, and consecutive such
//     statements share one block, one statement per line;
//   - `let p = e;` becomes `let p = unsafe { e };` (so that the binding
//     stays in scope);
//   - an expression (a tail, a condition, an arm, a deferred statement)
//     becomes `unsafe { e }`.
//
// What is not wrapped is left as it is, byte for byte; a second run finds
// nothing to do.

use crate::base::{FILES, SRC, buf_byte, buf_bytes, buf_new, buf_str};
use crate::base::comp::Comp;
use crate::front::ast::{NODES, NodeKind};
use crate::front::modules::{C_MODULE, file_of_pos, within_std};
use crate::tools::edit::edit_replace;
use crate::tools::query::defs::DEFS;
use crate::tools::query::positions::enclosing;
use crate::tools::query::refs::ref_in;

pub static var FIX_UNSAFE: bool = false;
// `volec fix` (0.12): a function with several unsafe operations gets
// its whole body in one block (`--fix-unsafe` keeps 0.9's units).
pub static var WHOLE_BODIES: bool = false;

// The units to wrap (nodes), each once.
static var SITES: Vec<i64, Comp> = Vec::new_in(Comp {});

pub fn note_unsafe_site(node: i64) {
    if node == 0 {
        return;
    }
    for i in 0..SITES.len() as i64 {
        if SITES[i] == node {
            return;
        }
    }
    SITES.push(node);
}

// The widest line kept on one line.
const LINE_WIDTH: i64 = 100;

// Kinds of ranges: statements ending with `;`, or an expression.
const R_STMT: i64 = 1;
const R_EXPR: i64 = 2;

fn line_start(pos: i64) -> i64 {
    let f = file_of_pos(pos);
    var i = pos;
    while i > FILES[f].start && SRC[i - 1] != '\n' {
        i -= 1;
    }
    i
}

fn line_end(pos: i64) -> i64 {
    let f = file_of_pos(pos);
    var i = pos;
    while i < FILES[f].end && SRC[i] != '\n' {
        i += 1;
    }
    i
}

fn blank(from: i64, to: i64) -> bool {
    for i in from..to {
        if SRC[i] != ' ' && SRC[i] != '\t' && SRC[i] != '\r' && SRC[i] != '\n' {
            return false;
        }
    }
    true
}

fn has_newline(from: i64, to: i64) -> bool {
    for i in from..to {
        if SRC[i] == '\n' {
            return true;
        }
    }
    false
}

// The text of [from, to) with every line after the first indented by
// four more spaces (blank lines stay empty).
fn push_indented(out: i64, from: i64, to: i64) {
    var at_line_start = false;
    for i in from..to {
        let c = SRC[i];
        if at_line_start && c != '\n' {
            buf_str(out, c"    ");
        }
        buf_byte(out, c);
        at_line_start = c == '\n';
    }
}

// Appends an edit: replace [pos, pos + del) by buffer text.
fn add_edit(edits: inout Vec<i64, Comp>, pos: i64, del: i64, text: i64) {
    edits.push(pos);
    edits.push(del);
    edits.push(text);
}

// The edit wrapping [s, e) (a range of kind `kind`).
fn wrap_edit(s: i64, e: i64, kind: i64, edits: inout Vec<i64, Comp>) {
    let ls = line_start(s);
    let le = line_end(e);
    let alone = blank(ls, s) && blank(e, le);
    let multi = has_newline(s, e);
    if alone && (multi || (kind == R_STMT && (le - ls) + 12 > LINE_WIDTH)) {
        // On lines of their own:
        //     unsafe {
        //         ...
        //     }
        let indent = SRC[ls..s];
        let text = buf_new();
        buf_bytes(text, indent);
        buf_str(text, c"unsafe {\n");
        buf_bytes(text, indent);
        buf_str(text, c"    ");
        push_indented(text, s, e);
        buf_byte(text, '\n');
        buf_bytes(text, indent);
        buf_byte(text, '}');
        add_edit(&edits, ls, e - ls, text);
        return;
    }
    let open = buf_new();
    buf_str(open, c"unsafe { ");
    add_edit(&edits, s, 0, open);
    let close = buf_new();
    buf_str(close, c" }");
    add_edit(&edits, e, 0, close);
}

// The body (a block node) of the function holding pos, or -1.
fn body_of(pos: i64) -> i64 {
    let d = enclosing(pos);
    if d < 0 {
        return -1;
    }
    let n = DEFS[d].node;
    if n <= 0 || NODES[n].kind != NodeKind::Fn {
        return -1;
    }
    let b = NODES[n].c;
    if b <= 0 || pos < NODES[b].start || pos >= NODES[b].end {
        return -1;
    }
    b
}

// How many of the ranges (start, end, kind) are in body b.
fn sites_in(ranges: Vec<i64, Comp>, b: i64) -> i64 {
    var n = 0;
    var i = 0;
    while i < ranges.len() as i64 {
        if body_of(ranges[i]) == b {
            n += 1;
        }
        i += 3;
    }
    n
}

// Whether body b's braces have lines of their own: `{` last on its line,
// `}` first on its.
fn wrappable(b: i64) -> bool {
    let s = NODES[b].start;
    let e = NODES[b].end;
    SRC[s] == '{' && SRC[e - 1] == '}' && has_newline(s, e) && blank(s + 1, line_end(s))
        && blank(line_start(e - 1), e - 1)
}

// The edit putting body b's lines in an unsafe block, indented one
// level more.
fn wrap_body(b: i64, edits: inout Vec<i64, Comp>) {
    let first = line_end(NODES[b].start) + 1;
    let last = line_start(NODES[b].end - 1);
    let indent = SRC[last..NODES[b].end - 1];
    let text = buf_new();
    buf_bytes(text, indent);
    buf_str(text, c"    unsafe {\n");
    var p = first;
    while p < last {
        let e = line_end(p);
        if !blank(p, e) {
            buf_str(text, c"    ");
            buf_bytes(text, SRC[p..e]);
        }
        buf_byte(text, '\n');
        p = e + 1;
    }
    buf_bytes(text, indent);
    buf_str(text, c"    }\n");
    add_edit(&edits, first, last - first, text);
}

// The edits wrapping the unsafe operations (to the edit engine,
// edit.vl); returns the number of unsafe blocks made.
pub fn fix_unsafe_edits() -> i64 {
    // The ranges: start, end, kind.
    var ranges: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..SITES.len() as i64 {
        let w = SITES[i];
        let kind = NODES[w].kind;
        var s = NODES[w].start;
        var e = NODES[w].end;
        var k = R_EXPR;
        if kind == NodeKind::Let {
            s = NODES[NODES[w].c].start;
            e = NODES[NODES[w].c].end;
        } else if kind == NodeKind::Defer {
            s = NODES[NODES[w].a].start;
            e = NODES[NODES[w].a].end;
        } else if kind == NodeKind::ExprStmt {
            if NODES[w].b == 1 {
                k = R_STMT;
            } else {
                s = NODES[NODES[w].a].start;
                e = NODES[NODES[w].a].end;
            }
        }
        let f = file_of_pos(s);
        if within_std(FILES[f].module) || FILES[f].module == C_MODULE || !ref_in(s) {
            continue;
        }
        ranges.push(s);
        ranges.push(e);
        ranges.push(k);
    }
    // By start, the outer of nested ranges first (an insertion sort).
    let n = ranges.len() as i64 / 3;
    for a in 1..n {
        var j = a;
        while j > 0 && (ranges[3 * j] < ranges[3 * (j - 1)]
            || (ranges[3 * j] == ranges[3 * (j - 1)]
                && ranges[3 * j + 1] > ranges[3 * (j - 1) + 1])) {
            for x in 0..3 {
                let t = ranges[3 * j + x];
                ranges[3 * j + x] = ranges[3 * (j - 1) + x];
                ranges[3 * (j - 1) + x] = t;
            }
            j -= 1;
        }
    }
    // The outermost ones, consecutive statements merged.
    var kept: Vec<i64, Comp> = Vec::new_in(Comp {});
    for a in 0..n {
        let s = ranges[3 * a];
        let e = ranges[3 * a + 1];
        let k = ranges[3 * a + 2];
        if kept.len() as i64 > 0 {
            let ps = kept[kept.len() as i64 - 3];
            let pe = kept[kept.len() as i64 - 2];
            let pk = kept[kept.len() as i64 - 1];
            if s >= ps && e <= pe {
                continue;
            }
            if k == R_STMT && pk == R_STMT && s >= pe && blank(pe, s)
                && file_of_pos(s) == file_of_pos(ps) {
                kept[kept.len() as i64 - 2] = e;
                continue;
            }
        }
        kept.push(s);
        kept.push(e);
        kept.push(k);
    }
    // A function with several unsafe operations: its whole body in
    // one unsafe block (the codebase's style, 0.12), when its braces
    // have lines of their own.
    var bodies: Vec<i64, Comp> = Vec::new_in(Comp {});
    var rest: Vec<i64, Comp> = Vec::new_in(Comp {});
    var a = 0;
    while a < kept.len() as i64 {
        let b = body_of(kept[a]);
        if WHOLE_BODIES && b >= 0 && sites_in(ranges, b) >= 2 && wrappable(b) {
            var seen = false;
            for x in 0..bodies.len() as i64 {
                if bodies[x] == b {
                    seen = true;
                }
            }
            if !seen {
                bodies.push(b);
            }
        } else {
            rest.push(kept[a]);
            rest.push(kept[a + 1]);
            rest.push(kept[a + 2]);
        }
        a += 3;
    }
    var edits: Vec<i64, Comp> = Vec::new_in(Comp {});
    a = 0;
    while a < rest.len() as i64 {
        wrap_edit(rest[a], rest[a + 1], rest[a + 2], &edits);
        a += 3;
    }
    for x in 0..bodies.len() as i64 {
        wrap_body(bodies[x], &edits);
    }
    // (in order of position; edits at one position keep their order)
    let m = edits.len() as i64 / 3;
    for x in 1..m {
        var j = x;
        while j > 0 && edits[3 * j] < edits[3 * (j - 1)] {
            for y in 0..3 {
                let t = edits[3 * j + y];
                edits[3 * j + y] = edits[3 * (j - 1) + y];
                edits[3 * (j - 1) + y] = t;
            }
            j -= 1;
        }
    }
    var k = 0;
    while k < edits.len() as i64 {
        edit_replace(edits[k], edits[k] + edits[k + 1], edits[k + 2]);
        k += 3;
    }
    rest.len() as i64 / 3 + bodies.len() as i64
}
