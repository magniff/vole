// Source as text, for what is not an item (0.12; docs/query.md):
//
//   volec query text FILE[:A[-B]]...   lines A to B, numbered; any file,
//                                         no program read
//   volec query show FILE.vl...      a whole file, when small
//   volec query show MODULE::use       its `use` lines (::header: the
//                                         comment at the top of its file;
//                                         ::extern: its extern blocks)
//   volec query show NAME --with-comments
//                                         with the section comment above
//
// At most TEXT_MAX lines are printed: past them, `note query.truncated`
// (text) or `error query.too-long` (show), with `try:` lines narrowing.

use crate::base::{
    IntVec, SOURCE_VOLE, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, get_src,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::front::modules::file_of_pos;
use crate::front::stdsrc::std_source;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, read_file_if};
use crate::tools::query::c_slice;
use crate::tools::query::defs::mod_fqn_text;
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::positions::{line_start, put_path};
use crate::tools::query::show::find_modules;

pub const TEXT_MAX: i64 = 200;

// ---- query text ----

// `query text FILE[:A[-B]]...`: the exit status.
pub fn run_text(args: IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if args.count == 0 {
            let d = diag(c"error", c"query.usage", tcx);
            buf_str(d, c"text needs a FILE (FILE:A-B for lines A to B)\n");
            try_end(try_begin(c"text", c_slice(c"main.vl:1-40"), true, tcx, pcx));
            return 2;
        }
        let mut status: i64 = 0;
        for i in 0..args.count {
            if text_one(c_slice((*args.data.add(i as usize)) as *mut u8), tcx, pcx) != 0 {
                status = 1;
            }
        }
        status
    }
}

// Splits `FILE[:A[-B]]`: the file (a buffer, a C string), and A, B (-1
// when not given).
fn split_range(arg: &[u8], file: &mut i64, a: &mut i64, b: &mut i64) {
    *a = -1;
    *b = -1;
    let mut end = arg.len() as i64;
    // (the last `:` followed by digits, and maybe `-digits`)
    let mut k = arg.len() as i64;
    while k > 0
        && ((arg[(k - 1) as usize] >= b'0' && arg[(k - 1) as usize] <= b'9')
            || arg[(k - 1) as usize] == b'-') {
        k -= 1;
    }
    if k > 0 && k < arg.len() as i64 && arg[(k - 1) as usize] == b':' && arg[k as usize] != b'-' {
        let mut p = k;
        let mut x: i64 = 0;
        while p < arg.len() as i64 && arg[p as usize] != b'-' {
            x = x * 10 + (arg[p as usize] - b'0') as i64;
            p += 1;
        }
        *a = x;
        if p < arg.len() as i64 {
            p += 1;
            let mut y: i64 = 0;
            let mut digits = false;
            while p < arg.len() as i64 && arg[p as usize] >= b'0' && arg[p as usize] <= b'9' {
                y = y * 10 + (arg[p as usize] - b'0') as i64;
                p += 1;
                digits = true;
            }
            *b = if digits { y } else { -1 };
        } else {
            *b = x;
        }
        end = k - 1;
    }
    let f = buf_new();
    buf_bytes(f, &arg[0..end as usize]);
    *file = f;
}

// The starts of text's lines (a last line without its newline counts).
fn line_starts(text: &[u8], out: &mut IntVec) {
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        out.push(i);
        while i < text.len() as i64 && text[i as usize] != b'\n' {
            i += 1;
        }
        i += 1;
    }
}

// Line k (0-based) of text, without its newline.
fn line_at(text: &[u8], starts: IntVec, k: i64) -> &[u8] {
    unsafe {
        let a = (*starts.data.add(k as usize));
        let mut e = a;
        while e < text.len() as i64 && text[e as usize] != b'\n' {
            e += 1;
        }
        &text[a as usize..e as usize]
    }
}

fn cannot_read(file: &[u8], tcx: &mut Tcx<Comp>) -> i64 {
    let d = diag(c"error", c"query.no-file", tcx);
    buf_str(d, c"cannot read '");
    buf_bytes(d, file);
    buf_str(d, c"'\n");
    1
}

// One FILE[:A[-B]] of `query text`.
fn text_one(arg: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut fb: i64 = 0;
    let mut a: i64 = 0;
    let mut b: i64 = 0;
    split_range(arg, &mut fb, &mut a, &mut b);
    let file = buf_slice(fb);
    let path = buf_cstr(fb);
    let content = buf_new();
    if !file_exists(path, pcx) && (file == b"std" || file == b"<std>") {
        // (0.15: std's source, as the compiler has it: `<std>` in
        // the answers of the other queries)
        std_source(content);
    } else if !file_exists(path, pcx) || !read_file_if(path, content) {
        return cannot_read(file, tcx);
    }
    let text = buf_slice(content);
    let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    line_starts(text, &mut starts);
    let n = starts.count;
    if a < 0 {
        a = 1;
        b = n;
    }
    if b < 0 || b > n {
        b = n;
    }
    if a < 1 || a > n || b < a {
        let d = diag(c"error", c"query.no-match", tcx);
        buf_bytes(d, file);
        buf_str(d, c" has ");
        buf_int(d, n);
        buf_str(d, c" lines; no lines ");
        buf_bytes(d, &arg[(file.len() as i64 + 1) as usize..]);
        buf_byte(d, b'\n');
        try_text(file, if n > TEXT_MAX { n - TEXT_MAX + 1 } else { 1 }, n, tcx, pcx);
        return 1;
    }
    let shown_last = if b - a + 1 > TEXT_MAX { a + TEXT_MAX - 1 } else { b };
    let out = buf_new();
    buf_str(out, c"// ");
    buf_bytes(out, file);
    buf_byte(out, b':');
    buf_int(out, a);
    buf_byte(out, b'-');
    buf_int(out, shown_last);
    buf_byte(out, b'\n');
    for k in a - 1..shown_last {
        buf_int(out, k + 1);
        buf_byte(out, b'\t');
        buf_bytes(out, line_at(text, starts, k));
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
    if shown_last < b {
        let d = diag(c"note", c"query.truncated", tcx);
        buf_str(d, c"lines ");
        buf_int(d, a);
        buf_byte(d, b'-');
        buf_int(d, b);
        buf_str(d, c" are ");
        buf_int(d, b - a + 1);
        buf_str(d, c" lines; showing ");
        buf_int(d, a);
        buf_byte(d, b'-');
        buf_int(d, shown_last);
        buf_byte(d, b'\n');
        let next_last = if b - shown_last > TEXT_MAX { shown_last + TEXT_MAX } else { b };
        try_text(file, shown_last + 1, next_last, tcx, pcx);
        if has_part(file, c"compiler/src/") {
            try_end(try_begin(c"stats", file, true, tcx, pcx));
        }
    }
    0
}

// `try: query text FILE:A-B`.
fn try_text(file: &[u8], a: i64, b: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let w = buf_new();
    buf_bytes(w, file);
    buf_byte(w, b':');
    buf_int(w, a);
    buf_byte(w, b'-');
    buf_int(w, b);
    try_end(try_begin(c"text", buf_slice(w), true, tcx, pcx));
}

// Whether s contains part.
fn has_part(s: &[u8], part: *mut u8) -> bool {
    let t = c_slice(part);
    let mut i: i64 = 0;
    while i + t.len() as i64 <= s.len() as i64 {
        let mut ok = true;
        for j in 0..t.len() as i64 {
            if s[(i + j) as usize] != t[j as usize] {
                ok = false;
                break;
            }
        }
        if ok {
            return true;
        }
        i += 1;
    }
    false
}

// ---- query show FILE ----

// Whether every argument is a file to show whole (ends in .vl, no
// line).
pub fn all_files(args: IntVec) -> bool {
    unsafe {
        if args.count == 0 {
            return false;
        }
        for i in 0..args.count {
            if !crate::base::is_source_path((*args.data.add(i as usize)) as *mut u8) {
                return false;
            }
        }
        true
    }
}

// `query show FILE.vl...`: each file whole, or refused when longer than
// TEXT_MAX lines.
pub fn show_files(args: IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut status: i64 = 0;
        for i in 0..args.count {
            let path = (*args.data.add(i as usize)) as *mut u8;
            let file = c_slice(path);
            let content = buf_new();
            if !file_exists(path, pcx) || !read_file_if(path, content) {
                status = cannot_read(file, tcx);
                continue;
            }
            let text = buf_slice(content);
            let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            line_starts(text, &mut starts);
            let n = starts.count;
            if n > TEXT_MAX {
                let d = diag(c"error", c"query.too-long", tcx);
                buf_bytes(d, file);
                buf_str(d, c" has ");
                buf_int(d, n);
                buf_str(d, c" lines (show prints a file of at most ");
                buf_int(d, TEXT_MAX);
                buf_str(d, c")\n");
                if has_part(file, c"compiler/src/") {
                    try_end(try_begin(c"stats", file, true, tcx, pcx));
                }
                try_text(file, 1, TEXT_MAX, tcx, pcx);
                status = 1;
                continue;
            }
            let out = buf_new();
            buf_str(out, c"// ");
            buf_bytes(out, file);
            buf_str(out, c":1-");
            buf_int(out, n);
            buf_byte(out, b'\n');
            buf_bytes(out, text);
            if text.len() > 0 && text[(text.len() as i64 - 1) as usize] != b'\n' {
                buf_byte(out, b'\n');
            }
            buf_write_fd(out, STDOUT);
        }
        status
    }
}

// ---- Named regions of a module ----

// `query show MODULE::use|header|extern`: its exit status, or -1 when
// name is not one (or MODULE is no module: then it is a NAME).
pub fn show_region(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut kind: i64 = 0;
        let mut cut: i64 = 0;
        if ends_with_bytes(name, c"::use") {
            kind = 1;
            cut = 5;
        } else if ends_with_bytes(name, c"::header") {
            kind = 2;
            cut = 8;
        } else if ends_with_bytes(name, c"::extern") {
            kind = 3;
            cut = 8;
        }
        if kind == 0 || name.len() as i64 <= cut {
            return -1;
        }
        let module = &name[0..(name.len() as i64 - cut) as usize];
        let mut modules = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_modules(module, false, &mut modules, tcx, pcx);
        if modules.count == 0 && root_stem(module, pcx) {
            modules.push(0);
        }
        // (the files of those modules)
        let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..modules.count {
            for f in 0..pcx.files.len() as i64 {
                if pcx.files[f as usize].module == (*modules.data.add(i as usize))
                    && (*pcx.files[f as usize].path.add(0)) != b'<'
                    && pcx.files[f as usize].kind == SOURCE_VOLE {
                    files.push(f);
                }
            }
        }
        if files.count == 0 {
            return -1;
        }
        let out = buf_new();
        let mut found: i64 = 0;
        for i in 0..files.count {
            let f = (*files.data.add(i as usize));
            let label = buf_new();
            buf_bytes(label, mod_fqn_text(pcx.files[f as usize].module, tcx, pcx));
            buf_str(label,
                if kind == 1 { c"::use" } else if kind == 2 { c"::header" } else { c"::extern" });
            found += region_lines(out, f, kind, buf_slice(label), pcx);
        }
        buf_write_fd(out, STDOUT);
        if found == 0 {
            let d = diag(c"note", c"query.empty", tcx);
            buf_str(d, c"no ");
            buf_str(d,
                if kind == 1 { c"use lines" } else if kind == 2 { c"header comment" }
                else { c"extern blocks" });
            buf_str(d, c" in ");
            buf_bytes(d, module);
            buf_byte(d, b'\n');
        }
        0
    }
}

fn ends_with_bytes(s: &[u8], suffix: *mut u8) -> bool {
    let t = c_slice(suffix);
    if s.len() < t.len() {
        return false;
    }
    for i in 0..t.len() as i64 {
        if s[(s.len() as i64 - t.len() as i64 + i) as usize] != t[i as usize] {
            return false;
        }
    }
    true
}

// Whether text starts with word s.
fn starts_with(text: &[u8], s: *mut u8) -> bool {
    let t = c_slice(s);
    if text.len() < t.len() {
        return false;
    }
    for i in 0..t.len() {
        if text[i] != t[i] {
            return false;
        }
    }
    true
}

fn is_comment_line(line: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < line.len() as i64 && (line[i as usize] == b' ' || line[i as usize] == b'\t') {
        i += 1;
    }
    i + 1 < line.len() as i64 && line[i as usize] == b'/' && line[(i + 1) as usize] == b'/'
}

fn is_blank_line(line: &[u8]) -> bool {
    for i in 0..line.len() {
        if line[i] != b' ' && line[i] != b'\t' && line[i] != b'\r' {
            return false;
        }
    }
    true
}

// The regions of kind `kind` of file f, printed to out (each as `query
// show` prints an item: `// LABEL<TAB>FILE:A-B`, its lines); how many.
fn region_lines(out: i64, f: i64, kind: i64, label: &[u8], pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let text = &get_src()[
            pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize];
        let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        line_starts(text, &mut starts);
        let mut spans = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        region_spans(f, kind, &mut spans, pcx);
        let mut k: i64 = 0;
        while k < spans.count {
            put_region(out, f, label, text, starts, (*spans.data.add(k as usize)),
                (*spans.data.add((k + 1) as usize)), pcx);
            k += 2;
        }
        spans.count / 2
    }
}

// The regions of kind `kind` (1 use lines, 2 the header comment, 3 extern
// blocks) of file f: their first and last lines (0-based), in pairs, into
// out. The header is the comment lines at the top (blank lines among
// them), but for those right above the first item (its own comment, when
// it is not a mod or use line);
// consecutive use lines are one region.
pub fn region_spans(f: i64, kind: i64, out: &mut IntVec, pcx: &Ctx<Comp>) {
    let text = &get_src()[pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize];
    let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    line_starts(text, &mut starts);
    let n = starts.count;
    if kind == 2 {
        let mut last: i64 = -1;
        let mut k: i64 = 0;
        while k < n {
            let line = line_at(text, starts, k);
            if is_comment_line(line) {
                last = k;
            } else if !is_blank_line(line) {
                break;
            }
            k += 1;
        }
        let first = if k < n { line_at(text, starts, k) } else { &text[0..0] };
        let decl = starts_with(first, c"mod ") || starts_with(first, c"pub mod ")
            || starts_with(first, c"use ") || starts_with(first, c"pub use ")
            || starts_with(first, c"import ");
        if k < n && last == k - 1 && !decl {
            // (the comment lines right above the first item are its
            // own: the header ends at the blank line before them; not
            // above a mod or use line)
            while last >= 0 && is_comment_line(line_at(text, starts, last)) {
                last -= 1;
            }
            while last >= 0 && is_blank_line(line_at(text, starts, last)) {
                last -= 1;
            }
        }
        if last >= 0 {
            out.push(0);
            out.push(last);
        }
        return;
    }
    let mut k: i64 = 0;
    while k < n {
        let line = line_at(text, starts, k);
        let opens = if kind
            == 1 { starts_with(line, c"use ") || starts_with(line, c"pub use ") }
            else {
                starts_with(line, c"extern \"C\"") || starts_with(line, c"pub extern \"C\"")
            };
        if !opens {
            k += 1;
            continue;
        }
        // To the `;` (use) or the matching `}` (extern).
        let first = k;
        let mut last = k;
        if kind == 1 {
            loop {
                while last < n && !has_byte(line_at(text, starts, last), b';') {
                    last += 1;
                }
                if last + 1 < n && (starts_with(line_at(text, starts, last + 1), c"use ")
                    || starts_with(line_at(text, starts, last + 1), c"pub use ")) {
                    last += 1;
                } else {
                    break;
                }
            }
        } else {
            let mut depth: i64 = 0;
            let mut seen = false;
            loop {
                let l = line_at(text, starts, last);
                for j in 0..l.len() {
                    if l[j] == b'{' {
                        depth += 1;
                        seen = true;
                    } else if l[j] == b'}' {
                        depth -= 1;
                    }
                }
                if (seen && depth <= 0) || last + 1 >= n {
                    break;
                }
                last += 1;
            }
        }
        if last >= n {
            last = n - 1;
        }
        out.push(first);
        out.push(last);
        k = last + 1;
    }
}

// `MODULE::use`, `MODULE::header` (0.12) or `MODULE::extern` (0.17) as the
// TARGET of an edit: -1 when name is not one (or names no module: then it
// is a NAME), 1 after a diagnostic (several modules), else 0 with its
// file, its kind (1 use, 2 header, 3 extern) and the byte ranges of its
// regions in SRC (whole lines, in
// pairs: start, end after the last line's newline) in spans.
pub fn region_target(name: &[u8], what: *mut u8, file: &mut i64, kind: &mut i64, spans: &mut IntVec,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut cut: i64 = 0;
        if ends_with_bytes(name, c"::use") {
            *kind = 1;
            cut = 5;
        } else if ends_with_bytes(name, c"::header") {
            *kind = 2;
            cut = 8;
        } else if ends_with_bytes(name, c"::extern") {
            *kind = 3;
            cut = 8;
        }
        if cut == 0 || name.len() as i64 <= cut {
            return -1;
        }
        let module = &name[0..(name.len() as i64 - cut) as usize];
        let mut modules = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_modules(module, false, &mut modules, tcx, pcx);
        if modules.count == 0 && root_stem(module, pcx) {
            modules.push(0);
        }
        let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..modules.count {
            for f in 0..pcx.files.len() as i64 {
                if pcx.files[f as usize].module == (*modules.data.add(i as usize))
                    && (*pcx.files[f as usize].path.add(0)) != b'<'
                    && pcx.files[f as usize].kind == SOURCE_VOLE {
                    files.push(f);
                }
            }
        }
        if files.count == 0 {
            return -1;
        }
        if files.count > 1 {
            let d = diag(c"error", c"query.ambiguous", tcx);
            buf_bytes(d, module);
            buf_str(d, c" names ");
            buf_int(d, files.count);
            buf_str(d, c" modules; give more of its path\n");
            for i in 0..files.count {
                if i < 3 {
                    let label = buf_new();
                    buf_bytes(label,
                        mod_fqn_text(pcx.files[(*files.data.add(i as usize)) as usize].module, tcx,
                            pcx));
                    buf_bytes(label, &name[(name.len() as i64 - cut) as usize..]);
                    try_end(try_begin(what, buf_slice(label), true, tcx, pcx));
                }
            }
            return 1;
        }
        let f = (*files.data.add(0));
        *file = f;
        let mut lines = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        region_spans(f, *kind, &mut lines, pcx);
        let text = &get_src()[
            pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize];
        let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        line_starts(text, &mut starts);
        let mut k: i64 = 0;
        while k < lines.count {
            let last = (*lines.data.add((k + 1) as usize));
            spans.push(
                pcx.files[f as usize].start + (
                    *starts.data.add((*lines.data.add(k as usize)) as usize)));
            spans.push(if last + 1
                < starts.count { pcx.files[f as usize].start + (
                    *starts.data.add((last + 1) as usize)) }
                else { pcx.files[f as usize].end });
            k += 2;
        }
        0
    }
}

// Whether name is the root file's name without `.vl` (`main::header`
// for `crate::header`).
pub fn root_stem(name: &[u8], pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut root: i64 = -1;
        for f in 0..pcx.files.len() as i64 {
            if pcx.files[f as usize].module == 0 && (*pcx.files[f as usize].path.add(0)) != b'<'
                && pcx.files[f as usize].kind == SOURCE_VOLE {
                root = f;
            }
        }
        if root < 0 {
            return false;
        }
        let p = c_slice(pcx.files[root as usize].path);
        let mut s = p.len() as i64;
        while s > 0 && p[(s - 1) as usize] != b'/' {
            s -= 1;
        }
        let e = crate::base::source_ext_len(p);
        e > 0 && p.len() as i64 - s == name.len() as i64 + e
            && crate::tools::proc::same_bytes(&p[s as usize..(s + name.len() as i64) as usize],
                name)
    }
}

fn has_byte(s: &[u8], c: u8) -> bool {
    for i in 0..s.len() {
        if s[i] == c {
            return true;
        }
    }
    false
}

fn put_region(out: i64, f: i64, label: &[u8], text: &[u8], starts: IntVec, first: i64, last: i64,
    pcx: &Ctx<Comp>) {
    buf_str(out, c"// ");
    buf_bytes(out, label);
    buf_byte(out, b'\t');
    put_path(out, f, pcx);
    buf_byte(out, b':');
    buf_int(out, first + 1);
    buf_byte(out, b'-');
    buf_int(out, last + 1);
    buf_byte(out, b'\n');
    for k in first..last + 1 {
        buf_bytes(out, line_at(text, starts, k));
        buf_byte(out, b'\n');
    }
}

// ---- --with-comments ----

// The start of the text query show prints from `first` (an item's first
// line), with --with-comments: the comment block above it after blank
// lines (a section comment), when there is one.
pub fn section_start(first: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if !tcx.with_comments {
        return first;
    }
    let file_start = pcx.files[file_of_pos(first, pcx) as usize].start;
    let mut p = first;
    // (blank lines)
    while p > file_start {
        let prev = line_start(p - 1, pcx);
        if !is_blank_line(&get_src()[prev as usize..(p - 1) as usize]) {
            break;
        }
        p = prev;
    }
    let mut top: i64 = -1;
    while p > file_start {
        let prev = line_start(p - 1, pcx);
        if !is_comment_line(&get_src()[prev as usize..(p - 1) as usize]) {
            break;
        }
        p = prev;
        top = p;
    }
    if top < 0 { first } else { top }
}
