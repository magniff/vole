// `volec fuzz NAME [ROOT.vl] [--time S]` (0.18, T3; docs/design/
// contracts-verification.md §2.8): a #[fuzz] function (or a #[property])
// run on inputs the test binary mutates, built with --coverage at -O1: an
// input that reaches new code joins the corpus, .volec/fuzz/NAME/
// (corpus-HASH files, with tests/fuzz/NAME/'s inputs as seeds); a failing
// one is shrunk, saved there as crash-HASH and reported as a property's
// failure is. `volec test` replays the crashes and tests/fuzz/NAME/
// (--accept copies the crashes there).

use crate::base::{
    STDOUT, buf_append, buf_bytes, buf_copy, buf_eq, buf_int, buf_new, buf_str, buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_WORD, Leaf, is_missing, is_opt, option, table};
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{absolute_path, make_dirs, run_capture};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::diagnostics::{diag, put_cword, try_begin, try_end, write_diags};
use crate::tools::testrun::{dir_of, join, line_end, put_cut, shown_path, starts, work_dir};
use crate::tools::testrun::program::{
    add_job, argv_of, build, file_text, first_line, level_dir, list_tests, run_jobs, runtime_line,
};

// The files in dir whose names start with prefix ("": all), as paths
// (pushed to `out`, C strings).
pub fn files_in(dir: *mut u8, prefix: &[u8], out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    if !file_exists(dir, pcx) {
        return;
    }
    let w: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut words = w;
    words.push(c"ls" as i64);
    words.push(c"-1" as i64);
    words.push(dir as i64);
    let listing = buf_new();
    if run_capture(argv_of(words.as_slice()).as_slice(), listing) != 0 {
        return;
    }
    let t = buf_copy(listing);
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        let e = line_end(&t, i);
        let f = &t[i as usize..e as usize];
        i = e + 1;
        if f.len() > 0 && starts(f, prefix) {
            out.push(join(dir, f) as i64);
        }
    }
}

// The directory of NAME's saved inputs: .volec/fuzz/NAME next to the
// program's root.
pub fn fuzz_dir(src_dir: *mut u8, name: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_bytes(b, b".volec/fuzz/");
    buf_bytes(b, name);
    join(src_dir, &buf_copy(b))
}

fn fuzz_usage(why: *mut u8, word: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    let d = diag(c"error", c"fuzz.usage", tcx);
    buf_str(d, why);
    if word != 0 as *mut u8 {
        buf_str(d, c" '");
        buf_str(d, word);
        buf_str(d, c"'");
    }
    buf_str(d, c"; usage: volec fuzz NAME [ROOT.vl] [--time S]\n");
    write_diags(tcx);
    2
}

// `fuzz`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn fuzz_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(option("time", "S", "fuzz for S seconds (10)"));
    Leaf::new(opts, "name")
}

pub fn fuzz_command(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let mut name = 0 as *mut u8;
    let mut root = 0 as *mut u8;
    let mut seconds: i64 = 10;
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if is_missing(ev, "time") {
            return fuzz_usage(c"a number of seconds is needed after", a, tcx);
        }
        if is_opt(ev, "time") {
            seconds = parse_count(a);
            if seconds <= 0 {
                return fuzz_usage(c"--time takes a number of seconds, not", a, tcx);
            }
        } else if ev.kind != EV_WORD || ev.text.starts_with("-") {
            return fuzz_usage(c"unknown option", a, tcx);
        } else if crate::base::is_source_path(a) {
            root = a;
        } else if name == 0 as *mut u8 {
            name = a;
        } else {
            return fuzz_usage(c"one target at a time; a second", a, tcx);
        }
    }
    if name == 0 as *mut u8 {
        return fuzz_usage(c"the #[fuzz] function to fuzz is needed", 0 as *mut u8, tcx);
    }
    if root == 0 as *mut u8 {
        root = c"main.vl";
    }
    if !file_exists(root, pcx) {
        let d = diag(c"error", c"test.no-root", tcx);
        buf_str(d, c"no file '");
        buf_str(d, root);
        buf_str(d, c"' (name the program's root: volec fuzz NAME path/to/main.vl)\n");
        write_diags(tcx);
        return 2;
    }
    let out = buf_new();
    let root_abs = absolute_path(root);
    let src_dir = dir_of(root_abs);
    let work = work_dir(root_abs, src_dir);
    let tbin = join(level_dir(work, c"-O1"), b"fuzz");
    if !build(root, src_dir, crate::base::c_first(work), tbin, c"-O1", true, out, tcx, pcx: pcx,
        coverage: true) {
        buf_write_fd(out, STDOUT);
        return 1;
    }
    // the target
    let mut kinds: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut positions: Vec<i64, Comp> = Vec::new_in(Comp {});
    list_tests(tbin, &mut kinds, &mut names, &mut positions, tcx);
    let target = c_slice(name);
    let mut found = false;
    for k in 0..names.len() as i64 {
        if buf_eq((names[k as usize]), &target)
            && (kinds[k as usize]) != 1 {
            found = true;
        }
    }
    if !found {
        let d = diag(c"error", c"fuzz.unknown", tcx);
        buf_str(d, c"no #[fuzz] or #[property] function '");
        buf_str(d, name);
        buf_str(d, c"' in ");
        buf_str(d, root);
        let mut first: i64 = -1;
        let mut n: i64 = 0;
        for k in 0..names.len() as i64 {
            if (kinds[k as usize]) == 3 || (kinds[k as usize]) == 2 {
                buf_str(d, if n == 0 { c"; its targets: " } else { c", " });
                buf_append(d, (names[k as usize]));
                if first < 0 {
                    first = k;
                }
                n += 1;
            }
        }
        buf_str(d, c"\n");
        if first >= 0 {
            let t = try_begin(c"fuzz", &buf_copy((names[first as usize])), true, tcx,
                pcx);
            put_cword(t, root);
            try_end(t);
        }
        write_diags(tcx);
        return 2;
    }
    // its inputs: the corpus so far, tests/fuzz/NAME/
    let dir = fuzz_dir(src_dir, &target);
    make_dirs(dir);
    let mut seeds: Vec<i64, Comp> = Vec::new_in(Comp {});
    files_in(dir, b"corpus-", &mut seeds, pcx);
    let tb = buf_new();
    buf_bytes(tb, b"tests/fuzz/");
    buf_bytes(tb, &target);
    files_in(join(src_dir, &buf_copy(tb)), b"", &mut seeds, pcx);
    let w: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut words = w;
    words.push(tbin as i64);
    words.push(c"--vole-test" as i64);
    words.push(name as i64);
    words.push(c"--fuzz-time" as i64);
    let sb = buf_new();
    buf_int(sb, seconds);
    words.push(crate::tools::proc::buf_cstr(sb) as i64);
    words.push(c"--fuzz-dir" as i64);
    words.push(shown_path(dir) as i64);
    let mut k: i64 = 0;
    while k < seeds.len() as i64 && k < 200 {
        words.push(c"--replay" as i64);
        words.push(shown_path((seeds[k as usize]) as *mut u8) as i64);
        k += 1;
    }
    tcx.testrun_timeout = seconds + 60;
    let job = add_job(argv_of(words.as_slice()), 0 as *mut u8, join(dir, b"fuzz.out"),
        join(dir, b"fuzz.err"), tcx);
    run_jobs(job, tcx);
    let got = file_text((tcx.jobs[job as usize]).out);
    let err = file_text((tcx.jobs[job as usize]).err);
    let status = (tcx.jobs[job as usize]).status;
    let shown = shown_path(dir);
    if status == 0 {
        buf_bytes(out, b"fuzz ");
        buf_str(out, name);
        buf_bytes(out, b": ");
        let summary = runtime_line(got, b"fuzz", 0);
        buf_bytes(out, if summary.len() > 0 { summary } else { b"ran" });
        buf_bytes(out, b" in ");
        buf_int(out, seconds);
        buf_bytes(out, b" s (");
        buf_str(out, shown);
        buf_bytes(out, b"/); no failure\n");
        buf_write_fd(out, STDOUT);
        return 0;
    }
    buf_bytes(out, b"FAIL ");
    buf_str(out, name);
    let prop = runtime_line(got, b"property", 0);
    if prop.len() > 0 {
        buf_bytes(out, b" (fuzz, ");
        buf_bytes(out, prop);
        buf_bytes(out, b")");
    }
    buf_bytes(out, b": ");
    if status == -1 {
        buf_bytes(out, b"no exit (a time limit)\n");
    } else if err.len() > 0 {
        put_cut(out, b"", first_line(err), tcx);
    } else {
        buf_bytes(out, b"exit ");
        buf_int(out, status);
        buf_bytes(out, b"\n");
    }
    let mut n: i64 = 0;
    while runtime_line(got, b"input", n).len() > 0 {
        put_cut(out, b"  input: ", runtime_line(got, b"input", n), tcx);
        n += 1;
    }
    let saved = runtime_line(got, b"saved", 0);
    if saved.len() > 0 {
        buf_bytes(out, b"  saved: ");
        buf_bytes(out, saved);
        buf_bytes(out, b" (volec test replays it; test --accept keeps it in tests/fuzz/");
        buf_str(out, name);
        buf_bytes(out, b"/)\n");
    }
    buf_bytes(out, b"  try: ");
    buf_str(out, pcx.prog);
    buf_bytes(out, b" test ");
    buf_str(out, name);
    buf_bytes(out, b" ");
    buf_str(out, root);
    buf_bytes(out, b"\n");
    buf_write_fd(out, STDOUT);
    1
}
