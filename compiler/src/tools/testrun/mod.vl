// `volec test [FILTER...] [ROOT.vl]` (0.17; docs/query.md, "test"):
// one command that builds what changed, runs the tests and ends with a
// compact summary: the counts on the first line, then only the failing
// cases, each with a short difference, within --budget tokens (1000;
// `--full`: every failure, longer differences, no budget unless given).
//
// A program (ROOT, default ./main.vl): its cases are tests/NAME.in
// (stdin; none: empty) with tests/NAME.out (the expected stdout) in
// ROOT's directory (--dir DIR: another), and tests/NAME.exit, when there,
// the expected exit status (default 0). Output is compared as the agent
// eval grades it: `\r\n` as `\n`, trailing whitespace at the end left out.
// The program is built into $TMPDIR/volec-test/KEY/prog (KEY: the
// root, the level and the compiler) when it is not there or a .vl file
// under ROOT's directory is newer; the outputs stay there (NAME.got,
// NAME.err). Each case may run --timeout seconds (10). Without cases: the
// build alone, or a run on --input FILE (`-`: stdin).
//
// The vole repository (./compiler/src/main.vl and ./tests/run.sh, no
// ROOT given): std embedded again when compiler/std is newer than its
// embedding (compiler/std/embed.sh); target/volec rebuilt when a .vl
// file of compiler/src or compiler/std is newer (one build, by
// target/tools/volec when there; bootstrap/bootstrap.sh --dev checks
// the fixpoint); then `tests/run.sh [-O N] FILTER` once per FILTER (none:
// the whole suite), its FAIL blocks and totals summarized.
//
// Exit status: 0 when every case passed, 1 a failure or a build error, 2
// a usage error or no case to run.

mod repo;
pub mod program;
// (0.18 T3: volec fuzz)
pub mod fuzz;

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_hex, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq, strlen,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{
    Call, EV_MISSING, EV_WORD, Leaf, flag, is_flag, is_opt, long_of, option, short_option, table,
};
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{
    absolute_path, buf_cstr, make_dirs, read_file_if, read_stdin, run_capture, write_file_if,
};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::diagnostics::{diag, put_cword, try_begin, try_end, write_diags};
use crate::tools::testrun::program::run_all;
use crate::tools::testrun::repo::run_repo;
use crate::tools::v018::not_yet;

extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
    fn fork() -> i32;
    fn execvp(file: *mut u8, argv: *mut *mut u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn open(path: *mut u8, flags: i32) -> i32;
    fn creat(path: *mut u8, mode: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn alarm(seconds: u32) -> u32;
    fn _exit(code: i32) -> !;
    fn chmod(path: *mut u8, mode: i32) -> i32;
    fn gettimeofday(tv: *mut i64, tz: *mut u8) -> i32;
}

// Lines of difference (or stderr) shown per failing case, and columns.
fn detail_lines(tcx: &Tcx<Comp>) -> i64 {
    if tcx.full { 40 } else { 4 }
}

// Lines of stderr shown for a case that failed or ran out of time: its
// message and (0.17) the trace after it.
fn stderr_lines(tcx: &Tcx<Comp>) -> i64 {
    if tcx.full { 40 } else { 12 }
}

// Whether the program is built with --trace.
fn traced(tcx: &Tcx<Comp>) -> bool {
    tcx.traced && !(tcx.testrun_opt != 0 as *mut u8 && streq(tcx.testrun_opt, c"-O0"))
}

fn columns(tcx: &Tcx<Comp>) -> i64 {
    if tcx.full { 400 } else { 160 }
}

// (0.25.3) Lines of a test's own output shown per stream: under its
// failure, and with --show-output under its name.
fn output_lines(tcx: &Tcx<Comp>) -> i64 {
    if tcx.full { 400 } else if tcx.show_output { 50 } else { 8 }
}

pub fn run_test(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let status = test_inner(c, tcx, pcx);
    write_diags(tcx);
    status
}

fn usage(why: *mut u8, word: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    let d = diag(c"error", c"test.usage", tcx);
    buf_str(d, why);
    if word != 0 as *mut u8 {
        buf_str(d, c" '");
        buf_str(d, word);
        buf_byte(d, b'\'');
    }
    buf_str(d, c"; usage: volec test [FILTER...] [ROOT.vl] [--dir DIR] [--input FILE] [--budget N] [--full] [--timeout S] [-O N] [--no-trace] [--against VOLEC] [--accept] [--cases N] [--seed S] [--no-contracts] [--no-check-alloc]\n");
    2
}

// `test`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn test_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    // (0.25: on std::cli) ARGS: the options that the
    // runs' command lines repeat, in their order.
    let mut opts = table(gpa);
    // (0.18: the language's tests, tools/testrun/program.vl)
    opts.push(flag("accept", "keep the outputs (and fuzz finds) as expected"));
    opts.push(flag("no-contracts", "build without the contracts' checks"));
    opts.push(flag("no-check-alloc", "build without --check-alloc"));
    opts.push(option("cases", "N", "N cases per property"));
    opts.push(option("seed", "S", "the properties' seed"));
    // (0.18 T3: --fuzz S; --gen: tools/v018.vl)
    opts.push(flag("fuzz", "(0.18 T3, not yet)"));
    opts.push(flag("gen", "(0.18 T2, not yet)"));
    opts.push(flag("full", "every failure, whole"));
    // (0.25.3) each test's output; a failing test's is shown anyway
    opts.push(flag("show-output", "each test's stdout and stderr, under its name"));
    opts.push(flag("nocapture", "the same as --show-output (Rust's name)"));
    opts.push(option("against", "VOLEC", "the repository's tests with another volec"));
    opts.push(flag("no-trace", "no trace of a crash"));
    opts.push(option("budget", "TOKENS", "the report cut to about N tokens"));
    opts.push(option("timeout", "S",
        "a test stopped after S seconds (10; $VOLE_TEST_CASE_TIMEOUT)"));
    opts.push(option("dir", "DIR", "the tests' directory"));
    opts.push(option("input", "FILE", "the program's stdin"));
    opts.push(option("root", "ROOT", "the program's root file"));
    opts.push(short_option("O", "N", "the level the tests are built at"));
    Leaf::new(opts, "filter")
}

fn test_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    tcx.testrun_args = buf_new();
    // (0.25.5) $VOLE_TEST_CASE_TIMEOUT: the time limit's default, in
    // seconds (--timeout overrides it): a runner gives the tests more time
    // on a loaded machine, as its other time budgets get (tests/book)
    match std::env::var_in("VOLE_TEST_CASE_TIMEOUT", c.gpa) {
        Ok(v) => {
            let b = buf_new();
            buf_bytes(b, v.as_bytes());
            let n = parse_count(buf_cstr(b));
            if n > 0 {
                tcx.testrun_timeout = n;
            }
        }
        Err(_) => {}
    }
    let mut root = 0 as *mut u8;
    // ARGS: the options that the runs' command lines repeat, in their
    // order.
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        // the option, for ARGS (`--cases` of `--cases 5`)
        let spelled = long_of(ev);
        if ev.kind == EV_MISSING {
            return usage(c"a value is needed after", a, tcx);
        }
        if is_flag(ev, "accept") || is_flag(ev, "no-contracts")
            || is_flag(ev, "no-check-alloc") {
            if ev.name == "accept" {
                tcx.accept = true;
            } else if ev.name == "no-contracts" {
                tcx.no_contracts = true;
            } else {
                tcx.no_check_alloc = true;
            }
            put_cword(tcx.testrun_args, a);
        } else if is_opt(ev, "cases") || is_opt(ev, "seed") {
            if ev.name == "cases" {
                let n = parse_count(a);
                if n <= 0 {
                    return usage(c"--cases takes a number, not", a, tcx);
                }
                tcx.cases = n;
            } else {
                tcx.seed = a;
            }
            put_cword(tcx.testrun_args, spelled);
            put_cword(tcx.testrun_args, a);
        } else if is_flag(ev, "fuzz") || is_flag(ev, "gen") {
            return not_yet(c"test.not-yet", a, if ev.name == "fuzz" { c"T3" } else { c"T2" }, tcx);
        } else if is_flag(ev, "full") {
            tcx.full = true;
        } else if is_flag(ev, "show-output") || is_flag(ev, "nocapture") {
            tcx.show_output = true;
            put_cword(tcx.testrun_args, a);
        } else if is_opt(ev, "against") {
            tcx.against = a;
        } else if is_flag(ev, "no-trace") {
            tcx.traced = false;
            put_cword(tcx.testrun_args, a);
        } else if is_opt(ev, "budget") {
            let n = parse_count(a);
            if n <= 0 {
                return usage(c"--budget takes a number of tokens, not", a, tcx);
            }
            tcx.budget = n * 4;
            tcx.budget_given = true;
        } else if is_opt(ev, "timeout") {
            let n = parse_count(a);
            if n <= 0 {
                return usage(c"--timeout takes a number of seconds, not", a, tcx);
            }
            tcx.testrun_timeout = n;
            put_cword(tcx.testrun_args, spelled);
            put_cword(tcx.testrun_args, a);
        } else if is_opt(ev, "dir") || is_opt(ev, "input") || is_opt(ev, "root") {
            if ev.name == "dir" {
                tcx.testrun_dir = a;
            } else if ev.name == "input" {
                tcx.testrun_input = a;
            } else {
                root = a;
            }
            put_cword(tcx.testrun_args, spelled);
            put_cword(tcx.testrun_args, a);
        } else if is_opt(ev, "O") {
            let level = ev.text.as_bytes();
            if !(level.len() == 1 && level[0] >= b'0' && level[0] <= b'2') {
                return usage(c"-O takes 0, 1 or 2, not", a, tcx);
            }
            let b = buf_new();
            buf_str(b, c"-O");
            buf_str(b, a);
            tcx.testrun_opt = buf_cstr(b);
            put_cword(tcx.testrun_args, tcx.testrun_opt);
        } else if ev.kind != EV_WORD || (ev.text.starts_with("-") && ev.text.len() > 1) {
            return usage(c"unknown option", a, tcx);
        } else if crate::base::is_source_path(a) {
            if root != 0 as *mut u8 {
                // (0.25.2.2, eval 0.25.2.1: terrain) `volec test a.vl b.vl`:
                // the root pulls in the rest
                let d = diag(c"error", c"test.usage", tcx);
                buf_str(d, c"one ROOT at most; a second '");
                buf_str(d, a);
                buf_str(d,
                    c"': test takes the program's root, whose `mod` lines pull in its other files and their #[test] fns\n");
                let named = crate::tools::query::roots::root_named(root, pcx);
                let t = try_begin(c"test", c_slice(named), true, tcx, pcx);
                try_end(t);
                return 2;
            }
            root = a;
            put_cword(tcx.testrun_args, a);
        } else {
            tcx.filters.push(a as i64);
            put_cword(tcx.testrun_args, a);
        }
    }
    if tcx.full && !tcx.budget_given {
        tcx.budget = 1 << 40;
    }
    if root == 0 as *mut u8 && file_exists(c"compiler/src/main.vl", pcx)
        && file_exists(c"tests/run.sh", pcx) {
        return run_repo(tcx, pcx);
    }
    if root == 0 as *mut u8 {
        if !file_exists(c"main.vl", pcx) {
            let d = diag(c"error", c"test.no-root", tcx);
            buf_str(d, c"no main.vl here: name the program's root\n");
            let t = try_begin(c"test path/to/main.vl", c_slice(c""), false, tcx, pcx);
            try_end(t);
            return 2;
        }
        root = c"main.vl";
    }
    // (0.25.2: a directory, or a module file: its program's main.vl)
    root = crate::tools::query::roots::root_named(root, pcx);
    if !file_exists(root, pcx) {
        let d = diag(c"error", c"test.no-root", tcx);
        buf_str(d, c"no file '");
        buf_str(d, root);
        buf_str(d, c"'\n");
        return 2;
    }
    run_program(root, tcx, pcx)
}

// ---- Helpers ----

// Wall-clock milliseconds.
fn now_ms() -> i64 {
    unsafe {
        let tv = alloc_array::<i64>(2i64);
        (*tv.add(0)) = 0;
        (*tv.add(1)) = 0;
        gettimeofday(tv, 0 as *mut u8);
        // (tv_usec: a 32-bit int on macOS, a long on Linux; little-endian)
        (*tv.add(0)) * 1000 + ((*tv.add(1)) & 4294967295) / 1000
    }
}

fn put_secs(out: i64, ms: i64) {
    buf_int(out, ms / 1000);
    buf_byte(out, b'.');
    let c = (ms % 1000) / 10;
    if c < 10 {
        buf_byte(out, b'0');
    }
    buf_int(out, c);
    buf_bytes(out, b" s");
}

fn join(dir: *mut u8, name: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    let s = buf_slice(b);
    if s.len() > 0 && s[(s.len() as i64 - 1) as usize] != b'/' {
        buf_byte(b, b'/');
    }
    buf_bytes(b, name);
    buf_cstr(b)
}

// The directory part of path (`.` when it has none), as a C string.
fn dir_of(path: *mut u8) -> *mut u8 {
    let s = c_slice(path);
    let mut i = s.len() as i64 - 1;
    while i > 0 && s[i as usize] != b'/' {
        i -= 1;
    }
    let b = buf_new();
    if i <= 0 {
        buf_bytes(b, if s.len() > 0 && s[0] == b'/' { b"/" } else { b"." });
    } else {
        buf_bytes(b, &s[0..i as usize]);
    }
    buf_cstr(b)
}

// path as the user would type it from here: relative under the current
// directory.
fn shown_path(path: *mut u8) -> *mut u8 {
    unsafe {
        let here = absolute_path(c".");
        let n = strlen(here) as i64;
        if strlen(path) as i64 > n + 1 && c_slice(path)[0..n as usize] == c_slice(here) && (*path.add(n as usize)) == b'/' {
            return path.add((n + 1) as usize);
        }
        path
    }
}

pub fn contains(hay: &[u8], needle: &[u8]) -> bool {
    if needle.len() == 0 {
        return true;
    }
    let mut i: i64 = 0;
    while i + needle.len() as i64 <= hay.len() as i64 {
        if &hay[i as usize..(i + needle.len() as i64) as usize] == needle {
            return true;
        }
        i += 1;
    }
    false
}

fn starts(s: &[u8], p: &[u8]) -> bool {
    s.len() >= p.len() && s[0..p.len()] == p
}

fn fnv(h0: u64, s: &[u8]) -> u64 {
    let mut h = h0;
    for i in 0..s.len() {
        h = (h ^ s[i] as u64).wrapping_mul(1099511628211u64);
    }
    h
}

// Whether a name passes the filters (any of them is part of it; none:
// every name).
fn selected(name: &[u8], tcx: &Tcx<Comp>) -> bool {
    unsafe {
        if tcx.filters.count == 0 {
            return true;
        }
        for k in 0..tcx.filters.count {
            if contains(name, c_slice((*tcx.filters.data.add(k as usize)) as *mut u8)) {
                return true;
            }
        }
        false
    }
}

// Runs argv (ending with 0), stdout and stderr into out: its exit status.
fn run_words(w0: *mut u8, w1: *mut u8, w2: *mut u8, w3: *mut u8, w4: *mut u8, w5: *mut u8, w6: *mut u8, out: i64) -> i64 {
    unsafe {
        let argv = alloc_array::<*mut u8>(8i64);
        (*argv.add(0)) = w0;
        (*argv.add(1)) = w1;
        (*argv.add(2)) = w2;
        (*argv.add(3)) = w3;
        (*argv.add(4)) = w4;
        (*argv.add(5)) = w5;
        (*argv.add(6)) = w6;
        (*argv.add(7)) = 0 as *mut u8;
        // (a 0 ends the list: the words after the first 0 are left out)
        run_capture(argv, out)
    }
}

// Whether `find DIRS -name '*.vl' -newer FILE` finds a file.
fn newer_tach(dir1: *mut u8, dir2: *mut u8, file: *mut u8) -> bool {
    unsafe {
        let out = buf_new();
        if dir2 == 0 as *mut u8 {
            run_words(c"find", dir1, c"-name", c"*.vl", c"-newer", file, 0 as *mut u8, out);
        } else {
            let argv = alloc_array::<*mut u8>(8i64);
            (*argv.add(0)) = c"find";
            (*argv.add(1)) = dir1;
            (*argv.add(2)) = dir2;
            (*argv.add(3)) = c"-name";
            (*argv.add(4)) = c"*.vl";
            (*argv.add(5)) = c"-newer";
            (*argv.add(6)) = file;
            (*argv.add(7)) = 0 as *mut u8;
            run_capture(argv, out);
        }
        buf_slice(out).len() > 0
    }
}

// Appends line (cut at the column limit) after prefix, and a newline.
fn put_cut(out: i64, prefix: &[u8], line: &[u8], tcx: &Tcx<Comp>) {
    buf_bytes(out, prefix);
    let max = columns(tcx);
    if line.len() as i64 > max {
        buf_bytes(out, &line[0..max as usize]);
        buf_bytes(out, b"...");
    } else {
        buf_bytes(out, line);
    }
    buf_byte(out, b'\n');
}

// The end of the line starting at i (its '\n', or s.len).
fn line_end(s: &[u8], i: i64) -> i64 {
    let mut e = i;
    while e < s.len() as i64 && s[e as usize] != b'\n' {
        e += 1;
    }
    e
}

fn line_count(s: &[u8]) -> i64 {
    if s.len() == 0 {
        return 0;
    }
    let mut n: i64 = 1;
    for i in 0..s.len() {
        if s[i] == b'\n' {
            n += 1;
        }
    }
    if s[(s.len() as i64 - 1) as usize] == b'\n' { n - 1 } else { n }
}

// `N line` or `N lines`.
fn put_lines_count(out: i64, n: i64) {
    buf_int(out, n);
    buf_bytes(out, if n == 1 { b" line" } else { b" lines" });
}

// Up to max lines of s from line index `from`, each after prefix.
fn put_lines(out: i64, s: &[u8], from: i64, max: i64, prefix: &[u8], tcx: &Tcx<Comp>) -> i64 {
    let mut i: i64 = 0;
    let mut ln: i64 = 0;
    let mut shown: i64 = 0;
    while i < s.len() as i64 && shown < max {
        let e = line_end(s, i);
        if ln >= from {
            put_cut(out, prefix, &s[i as usize..e as usize], tcx);
            shown += 1;
        }
        ln += 1;
        i = e + 1;
    }
    shown
}

// The text as the eval compares it: `\r\n` as `\n`, trailing whitespace
// at the end left out.
fn normal(s: &[u8]) -> &[u8] {
    let b = buf_new();
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        if !(s[i as usize] == b'\r' && i + 1 < s.len() as i64 && s[(i + 1) as usize] == b'\n') {
            buf_byte(b, s[i as usize]);
        }
        i += 1;
    }
    let t = buf_slice(b);
    let mut e = t.len() as i64;
    while e > 0 && (t[(e - 1) as usize] == b' ' || t[(e - 1) as usize] == b'\t' || t[(e - 1) as usize] == b'\n' || t[(e - 1) as usize] == b'\r') {
        e -= 1;
    }
    &t[0..e as usize]
}

// The failures, as many as the budget holds (one at least), then the
// names of the rest and the command that prints them.
fn put_failures(out: i64, blocks: IntVec, names: IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let mut shown: i64 = 0;
        while shown < blocks.count {
            let b = buf_slice((*blocks.data.add(shown as usize)));
            if shown > 0 && buf_slice(out).len() as i64 + b.len() as i64 > tcx.budget {
                break;
            }
            buf_bytes(out, b);
            shown += 1;
        }
        if shown < blocks.count {
            buf_byte(out, b'(');
            buf_int(out, blocks.count - shown);
            buf_bytes(out, b" more failing: ");
            let mut k = shown;
            while k < blocks.count && k < shown + 12 {
                if k > shown {
                    buf_bytes(out, b", ");
                }
                buf_bytes(out, buf_slice((*names.data.add(k as usize))));
                k += 1;
            }
            if k < blocks.count {
                buf_bytes(out, b", ...");
            }
            buf_bytes(out, b"; all of them:");
            put_cword(out, pcx.prog);
            buf_bytes(out, b" test");
            buf_bytes(out, buf_slice(tcx.testrun_args));
            buf_bytes(out, b" --full)\n");
        }
    }
}

// ---- A program ----

// The directory of the program's build and outputs: .volec/test next
// to its root (as the edit journal's .volec/ outside git), else, when
// that cannot be made, $TMPDIR/volec-test/KEY (KEY: the root's path).
fn work_dir(root_abs: *mut u8, src_dir: *mut u8) -> *mut u8 {
    unsafe {
        let local = join(src_dir, b".volec/test");
        if make_dirs(local) {
            return local;
        }
        let h = fnv(14695981039346656037, c_slice(root_abs));
        let b = buf_new();
        let tmp = getenv(c"TMPDIR");
        buf_str(b, if tmp != 0 as *mut u8 && (*tmp.add(0)) != 0 { tmp } else { c"/tmp" });
        let s = buf_slice(b);
        if s[(s.len() as i64 - 1) as usize] != b'/' {
            buf_byte(b, b'/');
        }
        buf_bytes(b, b"volec-test/");
        buf_hex(b, h, 16);
        let dir = buf_cstr(b);
        make_dirs(dir);
        dir
    }
}

// What the build was made with (the options, the compiler's bytes), kept
// next to it: another compiler or level builds anew.
fn build_key(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    unsafe {
        let mut h = fnv(14695981039346656037, b"volec test");
        if tcx.testrun_opt != 0 as *mut u8 {
            h = fnv(h, c_slice(tcx.testrun_opt));
        }
        if traced(tcx) {
            h = fnv(h, b"--trace");
        }
        let mut slash = false;
        for i in 0..strlen(pcx.prog) as i64 {
            slash = slash || (*pcx.prog.add(i as usize)) == b'/';
        }
        let exe = buf_new();
        if slash && read_file_if(pcx.prog, exe) {
            h = fnv(h, buf_slice(exe));
        } else {
            h = fnv(h, c_slice(pcx.prog));
        }
        let b = buf_new();
        buf_hex(b, h, 16);
        buf_byte(b, b'\n');
        buf_slice(b)
    }
}

// (0.18) build_key at another level than OPT.
fn build_key_for(level: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    let was = tcx.testrun_opt;
    tcx.testrun_opt = level;
    let key = build_key(tcx, pcx);
    tcx.testrun_opt = was;
    key
}

// Builds the program into prog when a source is newer (or there is none):
// false, with its errors printed, when it does not build.
fn build_program(root: *mut u8, src_dir: *mut u8, work: *mut u8, prog: *mut u8, out: i64, tcx: &Tcx<Comp>,
    pcx: &Ctx<Comp>) -> bool {
    let key_file = join(work, b"key");
    let key = build_key(tcx, pcx);
    if program::up_to_date(prog, key_file, key, src_dir, pcx) {
        return true;
    }
    let built = join(work, b"build");
    let log = buf_new();
    let trace = if traced(tcx) { c"--trace" } else { 0 as *mut u8 };
    let rc = if tcx.testrun_opt == 0 as *mut u8 {
        run_words(pcx.prog, root, c"-o", built, c"--diagnostics=short", trace, 0 as *mut u8, log)
    } else {
        run_words(pcx.prog, root, c"-o", built, c"--diagnostics=short", tcx.testrun_opt, trace, log)
    };
    if rc != 0 {
        let l = buf_slice(log);
        let mut errors: i64 = 0;
        let mut i: i64 = 0;
        while i < l.len() as i64 {
            let e = line_end(l, i);
            if contains(&l[i as usize..e as usize], b": error") || starts(&l[i as usize..e as usize], b"error") {
                errors += 1;
            }
            i = e + 1;
        }
        buf_bytes(out, b"test ");
        buf_str(out, root);
        buf_bytes(out, b": does not build");
        if errors > 0 {
            buf_bytes(out, b" (");
            buf_int(out, errors);
            buf_bytes(out, if errors == 1 { b" error)" } else { b" errors)" });
        }
        buf_byte(out, b'\n');
        let mut i: i64 = 0;
        while i < l.len() as i64 {
            let e = line_end(l, i);
            if e > i {
                if buf_slice(out).len() as i64 + (e - i) > tcx.budget {
                    buf_bytes(out, b"(more: ");
                    buf_str(out, pcx.prog);
                    buf_bytes(out, b" check ");
                    buf_str(out, root);
                    buf_bytes(out, b")\n");
                    break;
                }
                put_cut(out, b"", &l[i as usize..e as usize], tcx);
            }
            i = e + 1;
        }
        return false;
    }
    program::install(built, prog, key_file, key);
    true
}

// Runs prog with stdin from input (0: none), stdout and stderr into the
// files: its exit status, 128 + a signal, -1 past the time limit.
fn run_case(prog: *mut u8, input: *mut u8, out_path: *mut u8, err_path: *mut u8, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let argv = alloc_array::<*mut u8>(2i64);
        (*argv.add(0)) = prog;
        (*argv.add(1)) = 0 as *mut u8;
        let from = if input != 0 as *mut u8 { input } else { c"/dev/null" };
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            let fd = open(from, 0);
            if fd >= 0 {
                dup2(fd, 0);
                close(fd);
            }
            let o = creat(out_path, 420);
            if o >= 0 {
                dup2(o, 1);
                close(o);
            }
            let e = creat(err_path, 420);
            if e >= 0 {
                dup2(e, 2);
                close(e);
            }
            alarm(tcx.testrun_timeout as u32);
            execvp(prog, argv);
            _exit(127);
        }
        let mut status = 0 as i32;
        waitpid(pid, &mut status, 0);
        let s = status as i64;
        if (s & 127) == 14 {
            return -1;
        }
        if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
    }
}

// The names of the cases in dir: each NAME with a NAME.out or NAME.in,
// once, as the filters select them; false when dir cannot be listed.
fn list_cases(dir: *mut u8, names: &mut IntVec, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let listing = buf_new();
        if run_words(c"ls", c"-1", dir, 0 as *mut u8, 0 as *mut u8, 0 as *mut u8, 0 as *mut u8, listing) != 0 {
            return false;
        }
        let t = buf_slice(listing);
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let e = line_end(t, i);
            let f = &t[i as usize..e as usize];
            i = e + 1;
            let mut n: i64 = -1;
            if f.len() > 4 && f[(f.len() as i64 - 4) as usize..] == b".out" {
                n = f.len() as i64 - 4;
            } else if f.len() > 3 && f[(f.len() as i64 - 3) as usize..] == b".in" {
                n = f.len() as i64 - 3;
            }
            if n <= 0 || !selected(&f[0..n as usize], tcx) {
                continue;
            }
            let mut seen = false;
            for k in 0..names.count {
                seen = seen || buf_slice((*names.data.add(k as usize))) == &f[0..n as usize];
            }
            if !seen {
                let b = buf_new();
                buf_bytes(b, &f[0..n as usize]);
                names.push(b);
            }
        }
        true
    }
}

fn case_file(dir: *mut u8, name: &[u8], ext: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_bytes(b, name);
    buf_bytes(b, ext);
    join(dir, buf_slice(b))
}

// The expected exit status: NAME.exit's number, else 0.
fn expected_exit(path: *mut u8) -> i64 {
    let b = buf_new();
    if !read_file_if(path, b) {
        return 0;
    }
    let s = buf_slice(b);
    let mut n: i64 = 0;
    for i in 0..s.len() {
        if s[i] >= b'0' && s[i] <= b'9' {
            n = n * 10 + (s[i] - b'0') as i64;
        }
    }
    n
}

// Why the output differs, into block: from the first line that differs,
// a few expected lines (`-`) and the lines it printed (`+`).
fn put_difference(block: i64, want: &[u8], got: &[u8], tcx: &Tcx<Comp>) {
    let mut i: i64 = 0;
    let mut j: i64 = 0;
    let mut ln: i64 = 0;
    while i < want.len() as i64 && j < got.len() as i64 {
        let a = line_end(want, i);
        let b = line_end(got, j);
        if &want[i as usize..a as usize] != &got[j as usize..b as usize] {
            break;
        }
        i = a + 1;
        j = b + 1;
        ln += 1;
    }
    buf_bytes(block, b"stdout differs at line ");
    buf_int(block, ln + 1);
    buf_bytes(block, b" (");
    put_lines_count(block, line_count(want));
    buf_bytes(block, b" expected, ");
    buf_int(block, line_count(got));
    buf_bytes(block, b" printed)\n");
    let half = (detail_lines(tcx) + 1) / 2;
    if put_lines(block, want, ln, half, b"  - ", tcx) == 0 {
        buf_bytes(block, b"  - (end of output)\n");
    }
    if put_lines(block, got, ln, half, b"  + ", tcx) == 0 {
        buf_bytes(block, b"  + (end of output)\n");
    }
}

// The program at root: its cases and tests (0.18: tools/testrun/program.vl),
// or one run on --input.
fn run_program(root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = buf_new();
    let root_abs = absolute_path(root);
    let src_dir = dir_of(root_abs);
    let dir_shown = if tcx.testrun_dir != 0 as *mut u8 { tcx.testrun_dir }
        else { join(dir_of(root), b"tests") };
    let shown = if streq(dir_shown, c"./tests") { c"tests" } else { dir_shown };
    let tests = absolute_path(dir_shown);
    let work = work_dir(root_abs, src_dir);
    if !file_exists(work, pcx) {
        let d = diag(c"error", c"test.no-root", tcx);
        buf_str(d, c"cannot make the build directory '");
        buf_str(d, work);
        buf_str(d, c"' (set TMPDIR)\n");
        return 2;
    }
    if tcx.testrun_input != 0 as *mut u8 {
        let prog = join(work, b"prog");
        if !build_program(root, src_dir, work, prog, out, tcx, pcx) {
            buf_write_fd(out, STDOUT);
            return 1;
        }
        return run_on_input(root, prog, work, out, tcx, pcx);
    }
    run_all(root, src_dir, tests, shown, work, out, tcx, pcx)
}

// `--input FILE`: one run, its output and exit status.
fn run_on_input(root: *mut u8, prog: *mut u8, work: *mut u8, out: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut input = tcx.testrun_input;
    if streq(tcx.testrun_input, c"-") {
        let b = buf_new();
        read_stdin(b, tcx);
        input = join(work, b"stdin.in");
        write_file_if(input, buf_slice(b));
    } else if !file_exists(tcx.testrun_input, pcx) {
        let d = diag(c"error", c"test.usage", tcx);
        buf_str(d, c"no file '");
        buf_str(d, tcx.testrun_input);
        buf_str(d, c"' (--input FILE)\n");
        return 2;
    }
    let got_path = join(work, b"input.got");
    let err_path = join(work, b"input.err");
    let status = run_case(prog, input, got_path, err_path, tcx);
    let got_b = buf_new();
    read_file_if(got_path, got_b);
    let got = normal(buf_slice(got_b));
    let err_b = buf_new();
    read_file_if(err_path, err_b);
    let err = normal(buf_slice(err_b));
    buf_bytes(out, b"test ");
    buf_str(out, root);
    buf_bytes(out, b": ran on ");
    buf_str(out, tcx.testrun_input);
    buf_bytes(out, b": ");
    if status == -1 {
        buf_bytes(out, b"no exit after ");
        buf_int(out, tcx.testrun_timeout);
        buf_bytes(out, b" s");
    } else {
        buf_bytes(out, b"exit ");
        buf_int(out, status);
    }
    buf_bytes(out, b", ");
    put_lines_count(out, line_count(got));
    buf_bytes(out, b" of output\n");
    let mut i: i64 = 0;
    while i < got.len() as i64 {
        let e = line_end(got, i);
        if buf_slice(out).len() as i64 + (e - i) > tcx.budget {
            buf_bytes(out, b"(the rest: ");
            buf_str(out, got_path);
            buf_bytes(out, b")\n");
            break;
        }
        put_cut(out, b"", &got[i as usize..e as usize], tcx);
        i = e + 1;
    }
    put_lines(out, err, 0, stderr_lines(tcx), b"stderr: ", tcx);
    buf_write_fd(out, STDOUT);
    if status == 0 { 0 } else { 1 }
}
