// `volec test [FILTER...]` in the vole tree (0.17; testrun/mod.vl):
// std embedded and target/volec rebuilt when a source is newer, then
// tests/run.sh once per FILTER, its FAIL blocks and totals summarized.
use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, read_file_if, rename_file, same_bytes};
use crate::tools::query::diagnostics::put_cword;
use crate::tools::testrun::{
    contains, detail_lines, line_end, newer_tach, now_ms, put_cut, put_failures, put_lines,
    put_secs, run_words, starts,
};

// ---- The vole repository ----

pub fn run_repo(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let t0 = now_ms();
        let out = buf_new();
        let notes = buf_new();
        // std's embedding, then the dev compiler, when older than a source.
        if newer_tach(c"compiler/std", 0 as *mut u8, c"compiler/src/front/stdsrc_rust.vl") {
            let log = buf_new();
            if run_words(c"sh", c"compiler/std/embed.sh", 0 as *mut u8, 0 as *mut u8, 0 as *mut u8,
                0 as *mut u8, 0 as *mut u8, log) != 0 {
                buf_bytes(out, b"test: compiler/std/embed.sh failed\n");
                put_lines(out, buf_slice(log), 0, 20, b"", tcx);
                buf_write_fd(out, STDOUT);
                return 1;
            }
            buf_bytes(notes, b"; std embedded");
        }
        if !file_exists(c"target/volec", pcx)
            || newer_tach(c"compiler/src", c"compiler/std", c"target/volec") {
            let t1 = now_ms();
            let builder = if file_exists(c"target/tools/volec", pcx) {
                c"target/tools/volec"
            } else if file_exists(c"target/volec", pcx) {
                c"target/volec"
            } else {
                pcx.prog
            };
            let log = buf_new();
            let rc = run_words(builder, c"compiler/src/main.vl", c"-o", c"target/volec.test~",
                c"--diagnostics=short", 0 as *mut u8, 0 as *mut u8, log);
            if rc != 0 || !rename_file(c"target/volec.test~", c"target/volec") {
                buf_bytes(out, b"test: target/volec does not build (with ");
                buf_str(out, builder);
                buf_bytes(out, b")\n");
                let l = buf_slice(log);
                let mut i: i64 = 0;
                while i < l.len() as i64 {
                    let e = line_end(l, i);
                    if e > i {
                        if buf_slice(out).len() as i64 + (e - i) > tcx.budget {
                            buf_bytes(out, b"(more: ");
                            buf_str(out, builder);
                            buf_bytes(out, b" check)\n");
                            break;
                        }
                        put_cut(out, b"", &l[i as usize..e as usize], tcx);
                    }
                    i = e + 1;
                }
                buf_write_fd(out, STDOUT);
                return 1;
            }
            buf_bytes(notes, b"; target/volec rebuilt in ");
            put_secs(notes, now_ms() - t1);
        }
        let mut blocks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let totals = alloc_array::<i64>(3i64);
        (*totals.add(0)) = 0;
        (*totals.add(1)) = 0;
        (*totals.add(2)) = 0;
        let mut ran = false;
        let unmatched = buf_new();
        let runs: i64 = if tcx.filters.len() as i64 == 0 { 1 } else { tcx.filters.len() as i64 };
        for k in 0..runs {
            let filter = if tcx.filters.len() as i64 == 0 { 0 as *mut u8 }
                else { (tcx.filters[k as usize]) as *mut u8 };
            let log = buf_new();
            let rc = if tcx.testrun_opt != 0 as *mut u8 {
                let level = buf_new();
                buf_byte(level, (*tcx.testrun_opt.add(2)));
                run_words(c"sh", c"tests/run.sh", c"-O", buf_cstr(level), filter, 0 as *mut u8,
                    0 as *mut u8, log)
            } else {
                run_words(c"sh", c"tests/run.sh", filter, 0 as *mut u8, 0 as *mut u8, 0 as *mut u8,
                    0 as *mut u8, log)
            };
            if parse_run(buf_slice(log), totals, &mut blocks, &mut names, tcx) {
                ran = true;
            } else if rc == 2 && contains(buf_slice(log), b"no cases match") {
                buf_bytes(unmatched,
                    if buf_slice(unmatched).len() == 0 { b" (no case matches" } else { b"," });
                put_cword(unmatched, filter);
            } else {
                // (no table: no case matched, or run.sh could not run)
                let b = buf_new();
                buf_bytes(b, b"tests/run.sh");
                if filter != 0 as *mut u8 {
                    put_cword(b, filter);
                }
                buf_bytes(b, b": exit ");
                buf_int(b, rc);
                buf_byte(b, b'\n');
                let l = buf_slice(log);
                let mut lines: i64 = 0;
                let mut i: i64 = 0;
                while i < l.len() as i64 {
                    let e = line_end(l, i);
                    lines += 1;
                    i = e + 1;
                }
                put_lines(b, l, if lines > 3 { lines - 3 } else { 0 }, 3, b"  ", tcx);
                blocks.push(b);
                let n = buf_new();
                buf_bytes(n, b"run.sh");
                names.push(n);
            }
        }
        // (0.17) The failures run again with the last passing build.
        let counts = alloc_array::<i64>(2i64);
        (*counts.add(0)) = 0;
        (*counts.add(1)) = 0;
        let base = if names.len() as i64 > 0 { baseline_compiler(tcx, pcx) } else { 0 as *mut u8 };
        if base != 0 as *mut u8 {
            mark_baseline(base, blocks, names, counts, tcx);
        }
        buf_bytes(out, b"test");
        for k in 0..tcx.filters.len() as i64 {
            put_cword(out, (tcx.filters[k as usize]) as *mut u8);
        }
        if tcx.filters.len() as i64 == 0 {
            buf_bytes(out, b" (the whole suite)");
        }
        if buf_slice(unmatched).len() > 0 {
            buf_bytes(out, buf_slice(unmatched));
            buf_byte(out, b')');
        }
        buf_bytes(out, b": ");
        if !ran && blocks.len() as i64 == 0 {
            buf_bytes(out, b"nothing run\n");
            buf_write_fd(out, STDOUT);
            return 2;
        }
        buf_int(out, (*totals.add(0)));
        buf_bytes(out, b" passed, ");
        buf_int(out, (*totals.add(2)));
        buf_bytes(out, b" failed");
        if (*totals.add(1)) > 0 {
            buf_bytes(out, b", ");
            buf_int(out, (*totals.add(1)));
            buf_bytes(out, b" xfail");
        }
        buf_bytes(out, b" (tests/run.sh");
        if tcx.testrun_opt != 0 as *mut u8 {
            buf_byte(out, b' ');
            buf_str(out, tcx.testrun_opt);
        }
        buf_bytes(out, buf_slice(notes));
        if (*counts.add(0)) + (*counts.add(1)) > 0 {
            buf_bytes(out, b"; with ");
            buf_str(out, base);
            buf_bytes(out, b": ");
            buf_int(out, (*counts.add(0)));
            buf_bytes(out, b" new, ");
            buf_int(out, (*counts.add(1)));
            buf_bytes(out, b" failing too");
        }
        buf_bytes(out, b"; ");
        put_secs(out, now_ms() - t0);
        buf_bytes(out, b")\n");
        put_failures(out, blocks, names, tcx, pcx);
        buf_write_fd(out, STDOUT);
        if !ran {
            return 2;
        }
        if blocks.len() as i64 > 0 || (*totals.add(2)) > 0 { 1 } else { 0 }
    }
}

// (0.17) The compiler the failures are run again with: --against's, else
// target/tools/volec (the last build whose suite passed) when its bytes
// differ from target/volec's; 0: none (`--against none`).
fn baseline_compiler(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    if tcx.against != 0 as *mut u8 {
        return if streq(tcx.against, c"none") { 0 as *mut u8 } else { tcx.against };
    }
    let tools = c"target/tools/volec";
    if !file_exists(tools, pcx) {
        return 0 as *mut u8;
    }
    let a = buf_new();
    let b = buf_new();
    if read_file_if(tools, a) && read_file_if(c"target/volec", b)
        && same_bytes(buf_slice(a), buf_slice(b)) {
        return 0 as *mut u8;
    }
    tools
}

// Whether case `name` fails with compiler `base` too: 1 it fails, 0 it
// passes, -1 unknown (run.sh made no table).
fn fails_with(base: *mut u8, name: &[u8], tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let filter = buf_new();
        buf_bytes(filter, name);
        let log = buf_new();
        if tcx.testrun_opt != 0 as *mut u8 {
            let level = buf_new();
            buf_byte(level, (*tcx.testrun_opt.add(2)));
            run_words(c"sh", c"tests/run.sh", c"-c", base, c"-O", buf_cstr(level),
                buf_cstr(filter), log);
        } else {
            run_words(c"sh", c"tests/run.sh", c"-c", base, buf_cstr(filter), 0 as *mut u8,
                0 as *mut u8, log);
        }
        let totals = alloc_array::<i64>(3i64);
        (*totals.add(0)) = 0;
        (*totals.add(1)) = 0;
        (*totals.add(2)) = 0;
        let mut blocks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if !parse_run(buf_slice(log), totals, &mut blocks, &mut names, tcx) {
            return -1;
        }
        for k in 0..names.len() as i64 {
            if buf_slice((names[k as usize])) == name {
                return 1;
            }
        }
        0
    }
}

// Each failure run again with the baseline compiler: its block says whether
// it fails there too (the environment, or a cause older than the change)
// or is new; `counts` gets (new, old).
fn mark_baseline(base: *mut u8, blocks: IntVec, names: IntVec, counts: *mut i64, tcx: &Tcx<Comp>) {
    unsafe {
        for k in 0..names.len() as i64 {
            let name = buf_slice((names[k as usize]));
            if name == b"run.sh" {
                continue;
            }
            let f = fails_with(base, name, tcx);
            if f < 0 {
                continue;
            }
            let b = (blocks[k as usize]);
            if f == 1 {
                buf_bytes(b, b"  (fails with ");
                buf_str(b, base);
                buf_bytes(b, b" too: not from this change)\n");
                (*counts.add(1)) = (*counts.add(1)) + 1;
            } else {
                buf_bytes(b, b"  (new: passes with ");
                buf_str(b, base);
                buf_bytes(b, b")\n");
                (*counts.add(0)) = (*counts.add(0)) + 1;
            }
        }
    }
}

// Reads run.sh's report: its FAIL and XPASS blocks into blocks (their
// first lines and a few more) and names, its totals (pass, xfail, fail)
// added; false when it has no table.
fn parse_run(log: &[u8], totals: *mut i64, blocks: &mut IntVec, names: &mut IntVec, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let mut block: i64 = -1;
        let mut lines: i64 = 0;
        let mut extra: i64 = 0;
        let mut table = false;
        let mut i: i64 = 0;
        while i <= log.len() as i64 {
            let e = line_end(log, i);
            let l = if i < log.len() as i64 { &log[i as usize..e as usize] } else { &log[0..0] };
            i = e + 1;
            let fail = starts(l, b"FAIL ");
            let xpass = starts(l, b"XPASS ");
            let end = l.len() == 0 || fail || xpass || starts(l, b"tests for ");
            if end && block >= 0 {
                if extra > 0 {
                    buf_bytes(block, b"  (");
                    buf_int(block, extra);
                    buf_bytes(block, b" more lines)\n");
                }
                block = -1;
            }
            if fail || xpass {
                let start: i64 = if fail { 5 } else { 6 };
                let mut n = start;
                while n < l.len() as i64 && l[n as usize] != b':' && l[n as usize] != b' ' {
                    n += 1;
                }
                let mut dup = false;
                for k in 0..names.len() as i64 {
                    dup = dup
                        || buf_slice((names[k as usize]))
                        == &l[start as usize..n as usize];
                }
                if dup {
                    continue;
                }
                let name = buf_new();
                buf_bytes(name, &l[start as usize..n as usize]);
                names.push(name);
                let b = buf_new();
                put_cut(b, b"", l, tcx);
                blocks.push(b);
                block = if fail { b } else { -1 };
                lines = 0;
                extra = 0;
                continue;
            }
            if block >= 0 {
                let mut s: i64 = 0;
                while s < 4 && s < l.len() as i64 && l[s as usize] == b' ' {
                    s += 1;
                }
                if lines < 2 * detail_lines(tcx) {
                    put_cut(block, b"  ", &l[s as usize..], tcx);
                } else {
                    extra += 1;
                }
                lines += 1;
                continue;
            }
            if starts(l, b"  total ") {
                let mut k: i64 = 0;
                let mut p: i64 = 8;
                while k < 3 && p < l.len() as i64 {
                    while p < l.len() as i64 && l[p as usize] == b' ' {
                        p += 1;
                    }
                    let mut n: i64 = 0;
                    while p < l.len() as i64 && l[p as usize] >= b'0' && l[p as usize] <= b'9' {
                        n = n * 10 + (l[p as usize] - b'0') as i64;
                        p += 1;
                    }
                    (*totals.add(k as usize)) = (*totals.add(k as usize)) + n;
                    k += 1;
                }
                table = true;
            }
        }
        table
    }
}
