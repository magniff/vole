// `volec test` on a program (0.18, T2; docs/design/contracts-verification.md
// §2.6, §2.9): its I/O cases (tests/NAME.in, .out, .exit) and its tests in
// the language (#[test], #[property], #[fuzz] regressions, functions with an
// `ensures`), from a test build (`--test-build`, front/tests: a main that
// runs the test its arguments name). Each runs in its own process, several
// at once, at -O0 and at -O2: the levels must agree on stdout, the exit
// status and the first line of stderr, else the difference is the
// compiler's bug (the program has no undefined behaviour to blame). The
// summary comes first, then one line per failure.

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, getenv, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_AARCH64_MACOS, T_X86_64_MACOS};
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, read_file_if, rename_file, write_file_if};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::{diag, put_cword, try_begin, try_end};
use crate::tools::testrun::{
    build_key_for, case_file, contains, expected_exit, join, line_count, line_end, list_cases,
    normal, output_lines, put_cut, put_difference, put_failures, put_lines, put_lines_count,
    selected, shown_path, starts, traced,
};

extern "C" {
    fn fork() -> i32;
    fn execvp(file: *mut u8, argv: *mut *mut u8) -> i32;
    fn wait4(pid: i32, status: *mut i32, options: i32, usage: *mut i64) -> i32;
    fn open(path: *mut u8, flags: i32) -> i32;
    fn creat(path: *mut u8, mode: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn alarm(seconds: u32) -> u32;
    fn _exit(code: i32) -> !;
    fn chmod(path: *mut u8, mode: i32) -> i32;
    fn getenv(name: *mut u8) -> *mut u8;
}

// What an item is.
const CASE: i64 = 0;
const TEST: i64 = 1;
const PROPERTY: i64 = 2;
const FUZZ: i64 = 3;
const CONTRACT: i64 = 4;

// The cases of a property both levels run (-O0 runs only these).
const LEVEL_CASES: i64 = 20;

// A process to run: argv, stdin from `input` (0: /dev/null), stdout and
// stderr into files; its exit status (128 + a signal, -1 past the time
// limit); reruns: the times it was run again after its time limit passed
// while it was waiting, not running (run_jobs).
#[derive(Clone, Copy)] pub struct Job {
    argv: *mut *mut u8, input: *mut u8, pub out: *mut u8, pub err: *mut u8, pid: i32,
    pub status: i64, reruns: i64,
}

pub fn add_job(argv: *mut *mut u8, input: *mut u8, out: *mut u8, err: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    unsafe {
        if tcx.job_count == tcx.job_cap {
            let cap: i64 = if tcx.job_cap == 0 { 64 } else { tcx.job_cap * 2 };
            let bigger = alloc_array::<Job>(cap);
            for i in 0..tcx.job_count {
                (*bigger.add(i as usize)) = (*tcx.jobs.add(i as usize));
            }
            tcx.jobs = bigger;
            tcx.job_cap = cap;
        }
        { let at_ix = tcx.job_count as usize;
            (*tcx.jobs.add(at_ix)) = Job { argv, input, out, err, pid: 0, status: 0, reruns: 0 } };
        tcx.job_count += 1;
        tcx.job_count - 1
    }
}

fn start_job(j: i64, tcx: &mut Tcx<Comp>) {
    unsafe {
        let job = (*tcx.jobs.add(j as usize));
        let pid = fork();
        if pid == 0 {
            let fd = open(if job.input != 0 as *mut u8 { job.input } else { c"/dev/null" }, 0);
            if fd >= 0 {
                dup2(fd, 0);
                close(fd);
            }
            let o = creat(job.out, 420);
            if o >= 0 {
                dup2(o, 1);
                close(o);
            }
            let e = creat(job.err, 420);
            if e >= 0 {
                dup2(e, 2);
                close(e);
            }
            alarm(tcx.testrun_timeout as u32);
            execvp((*job.argv.add(0)), job.argv);
            _exit(127);
        }
        (*tcx.jobs.add(j as usize)).pid = pid;
        if pid < 0 {
            (*tcx.jobs.add(j as usize)).status = 127;
        }
    }
}

// Runs jobs from..JOB_COUNT, as many at once as there are processors.
// (0.25.2) A job stopped by its time limit having run for less than half
// of it (its user and system time, from wait4) spent the limit waiting,
// not running: other processes had the processors (a loaded machine), or
// it was stalled behind a disk or swap. It is run again, at most twice, and judged by its
// last run; a program that loops is stopped once, as before.
pub fn run_jobs(from: i64, tcx: &mut Tcx<Comp>) {
    let host = crate::host_target();
    let most = crate::middle::threads::processors(host == T_AARCH64_MACOS
        || host == T_X86_64_MACOS);
    // (struct rusage, 144 bytes on both: ru_utime and ru_stime first, each
    // a struct timeval of an i64 tv_sec and a tv_usec in the low 32 bits)
    let usage = alloc_array::<i64>(18i64);
    unsafe {
        let mut next = from;
        let mut running: i64 = 0;
        while next < tcx.job_count || running > 0 {
            while next < tcx.job_count && running < most {
                start_job(next, tcx);
                if (*tcx.jobs.add(next as usize)).pid > 0 {
                    running += 1;
                }
                next += 1;
            }
            if running == 0 {
                break;
            }
            let mut status = 0 as i32;
            // UNSAFE: wait4 is C's; no std function gives a child's resource usage.
            // SAFETY: usage holds 18 i64s, the 144 bytes of struct rusage on
            // macOS and Linux (64-bit); status is a local i32.
            let pid = wait4(-1, &mut status, 0, usage);
            if pid <= 0 {
                break;
            }
            for j in from..next {
                if (*tcx.jobs.add(j as usize)).pid == pid {
                    let s = status as i64;
                    (*tcx.jobs.add(j as usize)).status = if (s & 127) == 14 { -1 }
                        else if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) };
                    (*tcx.jobs.add(j as usize)).pid = 0;
                    running -= 1;
                    let ran_us = ((*usage.add(0)) + (*usage.add(2))) * 1000000 + ((*usage.add(1))
                        & 0xffffffff) + (
                            (*usage.add(3)) & 0xffffffff);
                    if (*tcx.jobs.add(j as usize)).status == -1
                        && (*tcx.jobs.add(j as usize)).reruns < 2
                        && ran_us * 2 < tcx.testrun_timeout * 1000000 {
                        (*tcx.jobs.add(j as usize)).reruns += 1;
                        start_job(j, tcx);
                        if (*tcx.jobs.add(j as usize)).pid > 0 {
                            running += 1;
                        }
                    }
                }
            }
        }
    }
}

pub fn argv_of(words: IntVec) -> *mut *mut u8 {
    unsafe {
        let argv = alloc_array::<*mut u8>(words.len() as i64 + 1);
        for i in 0..words.len() as i64 {
            (*argv.add(i as usize)) = (words[i as usize]) as *mut u8;
        }
        (*argv.add(words.len() as i64 as usize)) = 0 as *mut u8;
        argv
    }
}

pub fn file_text(path: *mut u8) -> &'static [u8] {
    let b = buf_new();
    read_file_if(path, b);
    buf_slice(b)
}

// The first line of s (without its newline).
pub fn first_line(s: &[u8]) -> &[u8] {
    &s[0..line_end(s, 0) as usize]
}

// The lines of s that are not `vole-test:` lines (the runtime's, to
// this runner).
fn program_lines(s: &[u8]) -> &[u8] {
    let b = buf_new();
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let e = line_end(s, i);
        if !starts(&s[i as usize..e as usize], b"vole-test: ") {
            buf_bytes(b, &s[i as usize..e as usize]);
            buf_byte(b, b'\n');
        }
        i = e + 1;
    }
    normal(buf_slice(b))
}

// (0.25.3) Where the runtime's report of a failure starts in the stderr of
// a test that failed: the line before its trace (the notes between them
// left out), else its first `check-alloc:` line, else (last: true) its last
// line, else its end. The lines before it are the program's own.
fn failure_start(err: &[u8], last: bool) -> i64 {
    let mut prev: i64 = -1;
    let mut final = err.len() as i64;
    let mut alloc: i64 = -1;
    let mut i: i64 = 0;
    while i < err.len() as i64 {
        let e = line_end(err, i);
        let line = &err[i as usize..e as usize];
        if starts(line, b"trace, ") {
            return if prev >= 0 { prev } else { i };
        }
        if alloc < 0 && starts(line, b"check-alloc: ") {
            alloc = i;
        }
        if line.len() > 0 && !starts(line, b"note: ") {
            prev = i;
            if alloc < 0 && last {
                final = i;
            }
        }
        i = e + 1;
    }
    if alloc >= 0 { alloc } else { final }
}

// (0.25.3) The program's own stdout of a job (a test's: not the runtime's
// `vole-test:` lines) and its own stderr (a failed test's: before the
// runtime's report, failure_start).
fn own_stdout(kind: i64, job: Job) -> &'static [u8] {
    let got = file_text(job.out);
    if kind == CASE { normal(got) } else { program_lines(got) }
}

fn own_stderr(kind: i64, job: Job) -> &'static [u8] {
    let err = normal(file_text(job.err));
    if job.status == 0 || job.status == -1 {
        return err;
    }
    normal(&err[0..failure_start(err, kind != CASE) as usize])
}

// (0.25.3) Lines of output s, each after label (`  stdout: `), at most
// output_lines() of them, then how many more and the file they are in.
fn put_output(block: i64, label: &[u8], s: &[u8], path: *mut u8, tcx: &Tcx<Comp>) {
    let n = line_count(s);
    let max = output_lines(tcx);
    put_lines(block, s, 0, max, label, tcx);
    if n > max {
        buf_bytes(block, label);
        buf_byte(block, b'(');
        buf_int(block, n - max);
        buf_bytes(block, b" more: ");
        buf_str(block, shown_path(path));
        buf_bytes(block, b")\n");
    }
}

// (0.25.3) --show-output: `OUTPUT NAME` and the stdout and stderr of an
// item at its first level (job a), and at the other (job b, when
// two_levels) when it printed something else there, each block then named
// with its level.
fn put_shown_output(out: i64, kind: i64, name: &[u8], a: Job, b: Job, two_levels: bool, la: *mut u8,
    lb: *mut u8, tcx: &Tcx<Comp>) {
    let o = own_stdout(kind, a);
    let e = own_stderr(kind, a);
    let differs = two_levels && (own_stdout(kind, b) != o || own_stderr(kind, b) != e);
    put_output_block(out, kind, name, if differs { la } else { 0 as *mut u8 }, a, o, e, tcx);
    if differs {
        put_output_block(out, kind, name, lb, b, own_stdout(kind, b), own_stderr(kind, b), tcx);
    }
}

fn put_output_block(out: i64, kind: i64, name: &[u8], level: *mut u8, job: Job, o: &[u8], e: &[u8],
    tcx: &Tcx<Comp>) {
    buf_bytes(out, b"OUTPUT ");
    buf_bytes(out, name);
    if level != 0 as *mut u8 {
        buf_bytes(out, b" (");
        buf_str(out, level);
        buf_byte(out, b')');
    }
    if o.len() == 0 && e.len() == 0 {
        // (a property's cases run with their output thrown away; the
        // failing case, replayed, prints under its failure)
        buf_bytes(out, if kind == CASE || kind == TEST { b": none\n" }
            else {
                b": none (its generated cases run quiet; a failing one prints under its failure)\n"
            });
        return;
    }
    buf_byte(out, b'\n');
    put_output(out, b"  stdout: ", o, job.out, tcx);
    put_output(out, b"  stderr: ", e, job.err, tcx);
}

// The rest of the `vole-test: WORD ` line of s, or "".
pub fn runtime_line<'a>(s: &'a [u8], word: &'a [u8], nth: i64) -> &'a [u8] {
    let mut i: i64 = 0;
    let mut seen: i64 = 0;
    let prefix = buf_new();
    buf_bytes(prefix, b"vole-test: ");
    buf_bytes(prefix, word);
    buf_byte(prefix, b' ');
    let p = buf_slice(prefix);
    while i < s.len() as i64 {
        let e = line_end(s, i);
        if starts(&s[i as usize..e as usize], p) {
            if seen == nth {
                return &s[(i + p.len() as i64) as usize..e as usize];
            }
            seen += 1;
        }
        i = e + 1;
    }
    b""
}

// Whether a source file under dir has a test: `#[test]`, `#[property]`,
// `#[fuzz]` or `ensures`.
fn has_tests(dir: *mut u8) -> bool {
    let words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut w = words;
    w.push(c"grep" as i64);
    w.push(c"-rlE" as i64);
    w.push(c"--include=*.vl" as i64);
    w.push(c"--include=*.vl" as i64);
    w.push(c"#\\[(test|property|fuzz)\\]|ensures" as i64);
    w.push(dir as i64);
    let out = buf_new();
    crate::tools::proc::run_capture(argv_of(w), out);
    buf_slice(out).len() > 0
}

// (0.25.4) Whether program prog is up to date: there, built as `key`
// says (its key file, key_path) and no .vl file under src_dir is newer
// (`volec test`'s builds, `volec run`'s, cli/run.vl).
pub fn up_to_date(prog: *mut u8, key_path: *mut u8, key: &[u8], src_dir: *mut u8, pcx: &Ctx<Comp>) -> bool {
    let old = buf_new();
    file_exists(prog, pcx) && read_file_if(key_path, old) && buf_slice(old) == key
        && !super::newer_tach(src_dir, 0 as *mut u8, prog)
}

// (0.25.4) The program a build wrote at `built` as prog, executable, with
// its key: written over prog in place (macOS checks a new executable file
// the first time it runs, not one written over), or renamed onto it when
// that fails (Linux refuses to write a program that runs: ETXTBSY).
pub fn install(built: *mut u8, prog: *mut u8, key_path: *mut u8, key: &[u8]) {
    let bytes = buf_new();
    if !read_file_if(built, bytes) || !write_file_if(prog, buf_slice(bytes)) {
        rename_file(built, prog);
    }
    // UNSAFE: chmod is C's: std has no function that sets a file's mode.
    // SAFETY: prog is a NUL-terminated path (buf_cstr's); chmod reads only
    // it, and a failure leaves the file as it was.
    unsafe { chmod(prog, 493); }
    write_file_if(key_path, key);
}

// Builds root at `level` into `prog` (for tests: `test` true), unless it is
// newer than the sources and was built the same way; false, with the
// errors in out, when it does not build.
pub fn build(root: *mut u8, src_dir: *mut u8, work: u8, prog: *mut u8, level: *mut u8, test: bool,
    out: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>, coverage: bool) -> bool {
    unsafe {
        let key_file = buf_new();
        buf_str(key_file, prog);
        buf_bytes(key_file, b".key");
        let key_path = buf_cstr(key_file);
        let k = buf_new();
        buf_bytes(k, build_key_for(level, tcx, pcx));
        if test {
            buf_bytes(k,
                if tcx.no_check_alloc || coverage { b"test" } else { b"test check-alloc" });
        }
        if coverage {
            buf_bytes(k, b" coverage");
        }
        // (0.26.3) both levels with the overflow checks on (decision 6
        // turns them off at -O2): the levels then agree on an overflow
        buf_bytes(k, b" overflow-checks");
        if getenv(c"VOLE_PLANT_MISCOMPILE") != 0 as *mut u8 {
            // (front/tests' test-only switch changes what is built)
            buf_bytes(k, b" planted");
        }
        let key = buf_slice(k);
        if up_to_date(prog, key_path, key, src_dir, pcx) {
            return true;
        }
        let built = buf_new();
        buf_str(built, prog);
        buf_bytes(built, b".build");
        let built_path = buf_cstr(built);
        let words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut w = words;
        w.push(pcx.prog as i64);
        w.push(root as i64);
        w.push(c"-o" as i64);
        w.push(built_path as i64);
        w.push(c"--diagnostics=short" as i64);
        w.push(level as i64);
        w.push(c"--overflow-checks=on" as i64);
        if !streq(level, c"-O0") && traced(tcx) {
            w.push(c"--trace" as i64);
        }
        if test {
            w.push(c"--test-build" as i64);
            if coverage {
                // (volec fuzz: the counters, and the speed of -O1)
                w.push(c"--coverage" as i64);
            } else if !tcx.no_check_alloc {
                w.push(c"--check-alloc" as i64);
            }
        }
        let log = buf_new();
        let rc = crate::tools::proc::run_capture(argv_of(w), log);
        if rc != 0 {
            let l = buf_slice(log);
            let mut errors: i64 = 0;
            let mut i: i64 = 0;
            while i < l.len() as i64 {
                let e = line_end(l, i);
                if contains(&l[i as usize..e as usize], b": error")
                    || starts(&l[i as usize..e as usize], b"error") {
                    errors += 1;
                }
                i = e + 1;
            }
            buf_bytes(out, b"test ");
            buf_str(out, root);
            buf_bytes(out, if test { b": its tests do not build" } else { b": does not build" });
            if errors > 0 {
                buf_bytes(out, b" (");
                buf_int(out, errors);
                buf_bytes(out, if errors == 1 { b" error)" } else { b" errors)" });
            }
            buf_byte(out, b'\n');
            i = 0;
            while i < l.len() as i64 {
                let e = line_end(l, i);
                if e > i {
                    if buf_slice(out).len() as i64 + (e - i) > tcx.budget {
                        buf_bytes(out, b"(more: ");
                        buf_str(out, pcx.prog);
                        buf_bytes(out, b" check ");
                        buf_str(out, root);
                        buf_bytes(out, b")\n");
                        break;
                    }
                    put_cut(out, b"", &l[i as usize..e as usize], tcx);
                }
                i = e + 1;
            }
            return false;
        }
        install(built_path, prog, key_path, key);
        true
    }
}

// The items of a test binary (`--vole-list`): kinds, names (buffers)
// and positions (buffers).
pub fn list_tests(tbin: *mut u8, kinds: &mut IntVec, names: &mut IntVec, positions: &mut IntVec,
    tcx: &Tcx<Comp>) {
    let words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut w = words;
    w.push(tbin as i64);
    w.push(c"--vole-list" as i64);
    let out = buf_new();
    crate::tools::proc::run_capture(argv_of(w), out);
    let s = buf_slice(out);
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let e = line_end(s, i);
        let line = &s[i as usize..e as usize];
        i = e + 1;
        if !starts(line, b"vole-test: ") {
            continue;
        }
        let rest = &line["vole-test: ".len()..line.len()];
        let sp1 = line_end_at(rest, 0, b' ');
        let sp2 = line_end_at(rest, sp1 + 1, b' ');
        if sp2 >= rest.len() as i64 {
            continue;
        }
        let word = &rest[0..sp1 as usize];
        let kind = if word == b"test" { TEST } else if word == b"property" { PROPERTY }
            else if word == b"fuzz" { FUZZ } else { CONTRACT };
        let name = &rest[(sp1 + 1) as usize..sp2 as usize];
        if !selected(name, tcx) || kind == CONTRACT && tcx.no_contracts {
            continue;
        }
        kinds.push(kind);
        let nb = buf_new();
        buf_bytes(nb, name);
        names.push(nb);
        let pb = buf_new();
        buf_bytes(pb, &rest[(sp2 + 1) as usize..]);
        positions.push(pb);
    }
}

fn line_end_at(s: &[u8], from: i64, c: u8) -> i64 {
    let mut e = from;
    while e < s.len() as i64 && s[e as usize] != c {
        e += 1;
    }
    e
}

pub fn level_dir(work: *mut u8, level: *mut u8) -> *mut u8 {
    let d = join(work, &c_slice(level)[1..3]);
    crate::tools::proc::make_dirs(d);
    d
}

// A fuzz target's saved inputs, as `--replay FILE` words: tests/fuzz/NAME/
// and the crashes `volec fuzz` saved (--accept copies those into
// tests/fuzz/NAME/).
fn put_replays(words: &mut IntVec, src_dir: *mut u8, tests: *mut u8, name: &[u8], tcx: &Tcx<Comp>,
    pcx: &Ctx<Comp>) {
    unsafe {
        let mut crashes = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        crate::tools::testrun::fuzz::files_in(crate::tools::testrun::fuzz::fuzz_dir(src_dir, name),
            b"crash-", &mut crashes, pcx);
        let b = buf_new();
        buf_bytes(b, b"fuzz/");
        buf_bytes(b, name);
        let kept = join(tests, buf_slice(b));
        if tcx.accept && crashes.len() as i64 > 0 {
            crate::tools::proc::make_dirs(kept);
            for k in 0..crashes.len() as i64 {
                let path = (crashes[k as usize]) as *mut u8;
                let s = c_slice(path);
                let mut base = s.len() as i64;
                while base > 0 && s[(base - 1) as usize] != b'/' {
                    base -= 1;
                }
                write_file_if(join(kept, &s[base as usize..]), file_text(path));
            }
        }
        let mut inputs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        crate::tools::testrun::fuzz::files_in(kept, b"", &mut inputs, pcx);
        for k in 0..crashes.len() as i64 {
            inputs.push((crashes[k as usize]));
        }
        for k in 0..inputs.len() as i64 {
            if k < 200 {
                words.push(c"--replay" as i64);
                words.push(shown_path((inputs[k as usize]) as *mut u8) as i64);
            }
        }
    }
}

// `volec test` on the program at root: the summary, then the failures
// (at most BUDGET bytes); exit 1 when one failed.
pub fn run_all(root: *mut u8, src_dir: *mut u8, tests: *mut u8, shown: *mut u8, work: *mut u8,
    out: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let levels = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut lv = levels;
        if tcx.testrun_opt != 0 as *mut u8 {
            lv.push(tcx.testrun_opt as i64);
        } else {
            // (-O2 first: it writes the new snapshots -O0 then compares)
            lv.push(c"-O2" as i64);
            lv.push(c"-O0" as i64);
        }
        let mut cases = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let listed = list_cases(tests, &mut cases, tcx);
        let with_tests = has_tests(src_dir);
        // the builds
        let progs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut pv = progs;
        let tbins = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut tv = tbins;
        for l in 0..lv.len() as i64 {
            let level = (lv[l as usize]) as *mut u8;
            let dir = level_dir(work, level);
            let prog = join(dir, b"prog");
            let tbin = join(dir, b"tests");
            pv.push(prog as i64);
            tv.push(tbin as i64);
            if (cases.len() as i64 > 0 || !with_tests)
                && !build(root, src_dir, *work, prog, level, false, out, tcx, pcx, false) {
                buf_write_fd(out, STDOUT);
                return 1;
            }
            if with_tests && !build(root, src_dir, *work, tbin, level, true, out, tcx, pcx, false) {
                buf_write_fd(out, STDOUT);
                return 1;
            }
        }
        // the items: the cases, then the tests
        let mut kinds = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut positions = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..cases.len() as i64 {
            kinds.push(CASE);
            names.push((cases[k as usize]));
            positions.push(buf_new());
        }
        if with_tests {
            list_tests((tv[0]) as *mut u8, &mut kinds, &mut names, &mut positions, tcx);
        }
        if kinds.len() as i64 == 0 {
            if tcx.filters.len() as i64 > 0 && (listed || with_tests) {
                let d = diag(c"error", c"test.no-root", tcx);
                buf_bytes(d, b"no case in ");
                buf_str(d, shown);
                buf_bytes(d, if with_tests { b"/ and no test match the filters\n" }
                    else { b"/ matches the filters\n" });
                let t = try_begin(c"test", c_slice(c""), false, tcx, pcx);
                put_cword(t, root);
                try_end(t);
                return 2;
            }
            buf_bytes(out, b"test ");
            buf_str(out, root);
            buf_bytes(out, b": builds; no tests in ");
            buf_str(out, shown);
            buf_bytes(out, b"/ (a case: NAME.in, its stdin, and NAME.out, the expected stdout; a #[test] fn in the program; --input FILE: one run)\n");
            buf_write_fd(out, STDOUT);
            return 0;
        }
        // the runs: each level's, all at once (one level after the other)
        let first_job = tcx.job_count;
        let n = kinds.len() as i64;
        for l in 0..lv.len() as i64 {
            let level = (lv[l as usize]) as *mut u8;
            let dir = level_dir(work, level);
            let from = tcx.job_count;
            for k in 0..n {
                let name = buf_slice((names[k as usize]));
                let w = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
                let mut words = w;
                let mut input = 0 as *mut u8;
                if (kinds[k as usize]) == CASE {
                    words.push((pv[l as usize]));
                    let path = case_file(tests, name, b".in");
                    if file_exists(path, pcx) {
                        input = path;
                    }
                } else {
                    words.push((tv[l as usize]));
                    words.push(c"--vole-test" as i64);
                    words.push(buf_cstr((names[k as usize])) as i64);
                    words.push(c"--snapshots" as i64);
                    words.push(tests as i64);
                    let quick = lv.len() as i64 > 1 && streq(level, c"-O0");
                    if quick || tcx.cases > 0 {
                        let b = buf_new();
                        buf_int(b,
                            if quick && (tcx.cases == 0 || tcx.cases > LEVEL_CASES) { LEVEL_CASES }
                            else { tcx.cases });
                        words.push(c"--cases" as i64);
                        words.push(buf_cstr(b) as i64);
                    }
                    if tcx.seed != 0 as *mut u8 {
                        words.push(c"--seed" as i64);
                        words.push(tcx.seed as i64);
                    }
                    if tcx.accept {
                        words.push(c"--accept" as i64);
                    }
                    if (kinds[k as usize]) == FUZZ {
                        put_replays(&mut words, src_dir, tests, name, tcx, pcx);
                    }
                }
                let base = buf_new();
                buf_bytes(base,
                    if (kinds[k as usize]) == CASE { b"case-" } else { b"test-" });
                buf_bytes(base, name);
                let b = buf_slice(base);
                add_job(argv_of(words), input, case_file(dir, b, b".got"),
                    case_file(dir, b, b".err"), tcx);
            }
            run_jobs(from, tcx);
        }
        // the results
        let mut blocks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut failed = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut passed: i64 = 0;
        let mut diffs: i64 = 0;
        let mut new_snaps: i64 = 0;
        let mut counts = [0i64, 0, 0, 0, 0];
        let mut passed_first = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..n {
            counts[(kinds[k as usize]) as usize] += 1;
            let main_job = first_job + k;
            let block = buf_new();
            let ok = judge(block, (kinds[k as usize]),
                buf_slice((names[k as usize])), main_job, tests, shown, root, tcx, pcx);
            passed_first.push(if ok { 1 } else { 0 });
            // the snapshots made new (at the first level)
            let got = file_text((*tcx.jobs.add(main_job as usize)).out);
            let mut s: i64 = 0;
            while runtime_line(got, b"snapshot", s).len() > 0 {
                if starts(runtime_line(got, b"snapshot", s), b"new ") {
                    new_snaps += 1;
                }
                s += 1;
            }
            let mut agree = true;
            if lv.len() as i64 > 1 {
                let other = first_job + n + k;
                agree = put_level_difference(block, (kinds[k as usize]),
                    buf_slice((names[k as usize])), main_job, other,
                    (lv[0]) as *mut u8, (lv[1]) as *mut u8, root, tests, shown,
                    tcx, pcx);
                if !agree {
                    diffs += 1;
                }
            }
            if ok && agree {
                passed += 1;
            } else {
                blocks.push(block);
                failed.push((names[k as usize]));
            }
        }
        // the summary
        buf_bytes(out, b"test ");
        buf_str(out, root);
        buf_bytes(out, b": ");
        buf_int(out, passed);
        buf_bytes(out, b" passed");
        if blocks.len() as i64 > 0 {
            buf_bytes(out, b", ");
            buf_int(out, blocks.len() as i64);
            buf_bytes(out, b" failed");
        }
        if new_snaps > 0 {
            buf_bytes(out, b", ");
            buf_int(out, new_snaps);
            buf_bytes(out, if new_snaps == 1 { b" new snapshot" } else { b" new snapshots" });
        }
        buf_bytes(out, b" (");
        let labels = ["case", "#[test]", "#[property]", "#[fuzz] target", "contract"];
        let mut any = false;
        for c in 0..5 {
            if counts[c as usize] > 0 {
                if any {
                    buf_bytes(out, b", ");
                }
                any = true;
                buf_int(out, counts[c as usize]);
                buf_byte(out, b' ');
                buf_bytes(out, labels[c as usize].as_bytes());
                if counts[c as usize] > 1 && (c == 0 || c == 4) {
                    buf_byte(out, b's');
                }
            }
        }
        if lv.len() as i64 > 1 {
            if diffs == 0 {
                buf_bytes(out, b"; -O0 and -O2 agree)\n");
            } else {
                buf_bytes(out, b"; -O0 and -O2 differ on ");
                buf_int(out, diffs);
                buf_bytes(out, b")\n");
            }
        } else {
            buf_bytes(out, b"; ");
            buf_str(out, (lv[0]) as *mut u8);
            buf_bytes(out, b" only)\n");
        }
        if blocks.len() as i64 > 0 {
            put_failures(out, blocks, failed, tcx, pcx);
        }
        // (0.25.3) --show-output: what each item printed (a failed one's
        // is under its failure)
        if tcx.show_output {
            let two = lv.len() as i64 > 1;
            for k in 0..n {
                if (passed_first[k as usize]) != 0 {
                    let other = if two { first_job + n + k } else { first_job + k };
                    put_shown_output(out, (kinds[k as usize]),
                        buf_slice((names[k as usize])),
                        (*tcx.jobs.add((first_job + k) as usize)), (*tcx.jobs.add(other as usize)),
                        two, (lv[0]) as *mut u8,
                        if two { (lv[1]) as *mut u8 } else { 0 as *mut u8 }, tcx);
                }
            }
        }
        if blocks.len() as i64 > 0 {
            buf_bytes(out, b"(outputs: ");
            buf_str(out, shown_path(level_dir(work, (lv[0]) as *mut u8)));
            buf_bytes(out, b"/case-NAME.got, .err; test-NAME.got, .err)\n");
        }
        buf_write_fd(out, STDOUT);
        if blocks.len() as i64 > 0 { 1 } else { 0 }
    }
}

// The stderr lines after the first: a --trace's frames, on one line.
fn put_trace(block: i64, err: &[u8], tcx: &Tcx<Comp>) {
    let first = line_end(err, 0);
    if first >= err.len() as i64 {
        return;
    }
    let rest = &err[(first + 1) as usize..];
    let mut i: i64 = 0;
    let t = buf_new();
    let mut frames: i64 = 0;
    while i < rest.len() as i64 && frames < 8 {
        let e = line_end(rest, i);
        let line = &rest[i as usize..e as usize];
        i = e + 1;
        if starts(line, b"check-alloc: ") {
            // (what a failed test left allocated: not its trace)
            break;
        }
        if starts(line, b"note: ") || starts(line, b"trace, ") || line.len() == 0 {
            continue;
        }
        if frames > 0 {
            buf_bytes(t, b" < ");
        }
        // (the frame's words, one space between them)
        let mut space = false;
        for a in 0..line.len() {
            if line[a] == b' ' {
                space = buf_slice(t).len() > 0 && frames >= 0;
            } else {
                if space && buf_slice(t)[(buf_slice(t).len() as i64 - 1) as usize] != b' ' {
                    buf_byte(t, b' ');
                }
                space = false;
                buf_byte(t, line[a]);
            }
        }
        frames += 1;
    }
    if frames > 0 {
        put_cut(block, b"  trace: ", buf_slice(t), tcx);
    }
}

// Whether item k passed at its first level (job j); else why, into block.
// (0.25.3) Under a failure, what the item printed (its own lines; the
// runtime's report of the failure is the reason): stdout, then stderr.
fn judge(block: i64, kind: i64, name: &[u8], j: i64, tests: *mut u8, shown: *mut u8, root: *mut u8,
    tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let job = (*tcx.jobs.add(j as usize));
        let status = job.status;
        let got = file_text(job.out);
        let err = normal(file_text(job.err));
        if kind == CASE {
            let want_b = buf_new();
            let has_want = read_file_if(case_file(tests, name, b".out"), want_b);
            let want = normal(buf_slice(want_b));
            let want_exit = expected_exit(case_file(tests, name, b".exit"));
            let g = normal(got);
            if status == want_exit && has_want && g == want {
                return true;
            }
            if tcx.accept && status != -1 {
                // (--accept: the case's .out, and .exit, as it ran)
                let b = buf_new();
                buf_bytes(b, g);
                if g.len() > 0 {
                    buf_byte(b, b'\n');
                }
                write_file_if(case_file(tests, name, b".out"), buf_slice(b));
                if status != 0 {
                    let e = buf_new();
                    buf_int(e, status);
                    buf_byte(e, b'\n');
                    write_file_if(case_file(tests, name, b".exit"), buf_slice(e));
                }
                return true;
            }
            buf_bytes(block, b"FAIL ");
            buf_bytes(block, name);
            buf_bytes(block, b": ");
            if status == -1 || status != want_exit {
                // (a crash's report: from the line before its trace)
                let cut = if status == -1 { err.len() as i64 } else { failure_start(err, false) };
                let report = if cut < err.len() as i64 { &err[cut as usize..] } else { err };
                if status == -1 {
                    buf_bytes(block, b"no exit after ");
                    buf_int(block, tcx.testrun_timeout);
                    buf_bytes(block, b" s (--timeout S)");
                } else {
                    buf_bytes(block, b"exit ");
                    buf_int(block, status);
                    buf_bytes(block, b" (expected ");
                    buf_int(block, want_exit);
                    buf_bytes(block, b")");
                }
                if report.len() > 0 {
                    buf_bytes(block, b": ");
                    buf_bytes(block, first_line(report));
                }
                buf_byte(block, b'\n');
                put_trace(block, report, tcx);
                put_output(block, b"  stdout: ", g, job.out, tcx);
                if cut < err.len() as i64 {
                    put_output(block, b"  stderr: ", normal(&err[0..cut as usize]), job.err, tcx);
                }
            } else if !has_want {
                buf_bytes(block, b"no ");
                buf_str(block, shown);
                buf_byte(block, b'/');
                buf_bytes(block, name);
                buf_bytes(block, b".out to compare with; it printed ");
                put_lines_count(block, line_count(g));
                buf_bytes(block, b" (--accept writes it)\n");
                put_lines(block, g, 0, 4, b"  + ", tcx);
                put_output(block, b"  stderr: ", err, job.err, tcx);
            } else {
                put_difference(block, want, g, tcx);
                put_output(block, b"  stderr: ", err, job.err, tcx);
            }
            return false;
        }
        if status == 0 {
            return true;
        }
        // (0.25.3) the runtime's report, after what the test printed
        let cut = if status == -1 { err.len() as i64 } else { failure_start(err, true) };
        let report = &err[cut as usize..];
        let tries = buf_new();
        buf_bytes(block, b"FAIL ");
        buf_bytes(block, name);
        let prop = runtime_line(got, b"property", 0);
        if kind != TEST && prop.len() > 0 {
            // `case 11 of 100, shrunk in 14 steps, seed H`
            let seed_at = find(prop, b", seed ");
            buf_bytes(block, b" (");
            buf_bytes(block,
                if kind == CONTRACT { b"contract, " } else if kind == FUZZ { b"fuzz, " }
                else { b"property, " });
            buf_bytes(block, if seed_at >= 0 { &prop[0..seed_at as usize] } else { prop });
            buf_byte(block, b')');
        }
        buf_bytes(block, b": ");
        if status == -1 {
            buf_bytes(block, b"no exit after ");
            buf_int(block, tcx.testrun_timeout);
            buf_bytes(block, b" s (--timeout S)\n");
        } else if report.len() == 0 {
            buf_bytes(block, b"exit ");
            buf_int(block, status);
            buf_byte(block, b'\n');
        } else if starts(report, b"check-alloc: ") {
            // a leak: the count, then where the first block was allocated
            buf_bytes(block, first_line(report));
            let second = line_end(report, 0) + 1;
            if second < report.len() as i64 {
                let line = &report[second as usize..line_end(report, second) as usize];
                let mut a: i64 = 0;
                while a < line.len() as i64 && line[a as usize] == b' ' {
                    a += 1;
                }
                buf_byte(block, b' ');
                buf_bytes(block, &line[a as usize..]);
            }
            buf_byte(block, b'\n');
        } else {
            put_cut(block, b"", first_line(report), tcx);
            put_trace(block, report, tcx);
            if starts(report, b"snapshot differs: ") {
                buf_bytes(tries, b"  try: ");
                buf_str(tries, pcx.prog);
                buf_bytes(tries, b" test ");
                buf_bytes(tries, name);
                buf_bytes(tries, b" --accept ");
                buf_str(tries, root);
                buf_byte(tries, b'\n');
            }
        }
        let mut k: i64 = 0;
        while runtime_line(got, b"input", k).len() > 0 {
            put_cut(block, b"  input: ", runtime_line(got, b"input", k), tcx);
            k += 1;
        }
        if kind != TEST && prop.len() > 0 {
            let seed_at = find(prop, b", seed ");
            if seed_at >= 0 {
                buf_bytes(tries, b"  try: ");
                buf_str(tries, pcx.prog);
                buf_bytes(tries, b" test ");
                buf_bytes(tries, name);
                buf_bytes(tries, b" --seed 0x");
                buf_bytes(tries, &prop[(seed_at + 7) as usize..]);
                buf_byte(tries, b' ');
                buf_str(tries, root);
                buf_byte(tries, b'\n');
            }
        }
        put_output(block, b"  stdout: ", program_lines(got), job.out, tcx);
        put_output(block, b"  stderr: ", normal(&err[0..cut as usize]), job.err, tcx);
        buf_bytes(block, buf_slice(tries));
        false
    }
}

fn find(s: &[u8], p: &[u8]) -> i64 {
    let mut i: i64 = 0;
    while i + p.len() as i64 <= s.len() as i64 {
        if &s[i as usize..(i + p.len() as i64) as usize] == p {
            return i;
        }
        i += 1;
    }
    -1
}

fn quoted(block: i64, s: &[u8]) {
    buf_byte(block, b'\'');
    if s.len() > 60 {
        buf_bytes(block, &s[0..60]);
        buf_bytes(block, b"...");
    } else {
        buf_bytes(block, s);
    }
    buf_byte(block, b'\'');
}

// Whether jobs a (level la) and b (level lb) agree: stdout (without the
// runtime's lines), the exit status and the first line of stderr. A
// property's cases agree when both ran them (lb runs the first 20).
// Else a DIFF line into block.
fn put_level_difference(block: i64, kind: i64, name: &[u8], a: i64, b: i64, la: *mut u8,
    lb: *mut u8, root: *mut u8, tests: *mut u8, shown: *mut u8, tcx: &Tcx<Comp>,
    pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let ga = file_text((*tcx.jobs.add(a as usize)).out);
        let gb = file_text((*tcx.jobs.add(b as usize)).out);
        let ea = first_line(normal(file_text((*tcx.jobs.add(a as usize)).err)));
        let eb = first_line(normal(file_text((*tcx.jobs.add(b as usize)).err)));
        let sa = (*tcx.jobs.add(a as usize)).status;
        let sb = (*tcx.jobs.add(b as usize)).status;
        if sa == -1 || sb == -1 {
            // (a time limit: the levels need not stop at the same place)
            return true;
        }
        if kind != CASE && kind != TEST {
            // (a failure beyond the cases lb ran is not a difference)
            let pa = runtime_line(ga, b"property", 0);
            if sa != 0 && sb == 0 && pa.len() > 0 && case_number(pa) > LEVEL_CASES {
                return true;
            }
            // (0.25) nor are discards: their share of lb's first 20 cases
            // (the smallest values) is not that of la's, which judge
            // judges (a requires the small values rarely meet)
            if runtime_line(ga, b"discarded", 0).len() > 0
                || runtime_line(gb, b"discarded", 0).len() > 0 {
                return true;
            }
        }
        let oa = program_lines(ga);
        let ob = program_lines(gb);
        if sa == sb && oa == ob && ea == eb {
            return true;
        }
        buf_bytes(block, b"DIFF ");
        buf_bytes(block, name);
        buf_bytes(block, b": ");
        buf_str(block, lb);
        buf_bytes(block, b" and ");
        buf_str(block, la);
        buf_bytes(block, b" differ ");
        if oa != ob {
            let mut i: i64 = 0;
            let mut j: i64 = 0;
            let mut ln: i64 = 1;
            while i < oa.len() as i64 && j < ob.len() as i64
                && oa[i as usize..line_end(oa, i) as usize]
                == &ob[j as usize..line_end(ob, j) as usize] {
                i = line_end(oa, i) + 1;
                j = line_end(ob, j) + 1;
                ln += 1;
            }
            buf_bytes(block, b"at stdout line ");
            buf_int(block, ln);
            buf_bytes(block, b": ");
            quoted(block,
                if j < ob.len() as i64 { &ob[j as usize..line_end(ob, j) as usize] }
                else { b"(end)" });
            buf_bytes(block, b" against ");
            quoted(block,
                if i < oa.len() as i64 { &oa[i as usize..line_end(oa, i) as usize] }
                else { b"(end)" });
        } else if sa != sb {
            buf_bytes(block, b"in the exit status: ");
            buf_int(block, sb);
            buf_bytes(block, b" against ");
            buf_int(block, sa);
        } else {
            buf_bytes(block, b"on stderr: ");
            quoted(block, eb);
            buf_bytes(block, b" against ");
            quoted(block, ea);
        }
        buf_bytes(block, b". A compiler bug, not this program's\n");
        buf_bytes(block, b"  try: ");
        buf_str(block, pcx.prog);
        buf_bytes(block, b" reduce ");
        buf_str(block, root);
        buf_bytes(block, b" --differs");
        if kind == CASE {
            if file_exists(case_file(tests, name, b".in"), pcx) {
                buf_bytes(block, b" --input ");
                buf_str(block, shown);
                buf_byte(block, b'/');
                buf_bytes(block, name);
                buf_bytes(block, b".in");
            }
        } else {
            buf_bytes(block, b" --test ");
            buf_bytes(block, name);
        }
        buf_byte(block, b'\n');
        false
    }
}

// `case K of N, ...`: K.
fn case_number(p: &[u8]) -> i64 {
    let mut i: i64 = 0;
    while i < p.len() as i64 && (p[i as usize] < b'0' || p[i as usize] > b'9') {
        i += 1;
    }
    let mut n: i64 = 0;
    while i < p.len() as i64 && p[i as usize] >= b'0' && p[i as usize] <= b'9' {
        n = n * 10 + (p[i as usize] - b'0') as i64;
        i += 1;
    }
    n
}
