// Processes and files for the tools of 0.11 (edit, fix, check,
// same-output): running a program and collecting its output, waiting for
// several at once, and the file operations an edit needs (a file written
// whole and renamed into place, directories, absolute paths).

use crate::base::{
    buf_byte, buf_bytes, buf_new, buf_reserve, buf_slice, buf_str, buf_write_fd, cstr, fclose,
    fopen, fread, fwrite, get_bufs, getenv, strlen,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;

// UNSAFE: POSIX's process, pipe, descriptor and file functions: the tools
// run other programs with their output captured, and move, link and make
// files and directories; std's process and fs do not cover these.
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn fork() -> i32;
    fn execvp(file: *mut u8, argv: *mut *mut u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn pipe(fds: *mut i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn read(fd: i32, buf: *mut u8, n: u64) -> i64;
    fn _exit(code: i32) -> !;
    fn rename(from: *mut u8, to: *mut u8) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn mkdir(path: *mut u8, mode: i32) -> i32;
    fn rmdir(path: *mut u8) -> i32;
    fn creat(path: *mut u8, mode: i32) -> i32;
    fn getcwd(buf: *mut u8, size: u64) -> *mut u8;
    fn realpath(path: *mut u8, resolved: *mut u8) -> *mut u8;
    fn isatty(fd: i32) -> i32;
    // (0.21: a rewritten script stays executable, keep_mode)
    fn chmod(path: *mut u8, mode: i32) -> i32;
    #[link_name = "access"]
    fn proc_access(path: *mut u8, mode: i32) -> i32;
    // (0.24: a renamed symbolic link keeps pointing at its renamed file)
    fn readlink(path: *mut u8, buf: *mut u8, size: u64) -> i64;
    fn symlink(target: *mut u8, path: *mut u8) -> i32;
    // (0.25.4: volec run leaves ^C to the program it runs)
    fn signal(sig: i32, handler: *mut u8) -> *mut u8;
}

// words (C strings) as the list exec takes: their pointers, then a null.
pub fn exec_words(words: &[i64]) -> Vec<*mut u8, Comp> {
    let mut argv: Vec<*mut u8, Comp> = Vec::new_in(Comp {});
    for &w in words {
        argv.push(w as *mut u8);
    }
    argv.push(0 as *mut u8);
    argv
}

// The status of a process as waitpid gives it: its exit code, or 128 +
// the signal that ended it.
fn exit_code(status: i32) -> i64 {
    let s = status as i64;
    if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
}

// Runs argv (argv[0] found as a shell finds it; argv ends with 0), its
// stdout and stderr into buffer `out`; returns its exit status (127 when
// it could not be run).
pub fn run_capture(argv: &[*mut u8], out: i64) -> i64 {
    // UNSAFE: pipe, fork, dup2, close, execvp, read and waitpid are C's: a
    // child with its output on a pipe; the bytes are read into the buffer's
    // own block (BUFS, base's raw table).
    // SAFETY: fds is a local of two i32s that pipe fills; argv is a list of C
    // strings ending with a null (exec_words, argv_of, cptrs), borrowed for
    // the call; the child calls only dup2, close, execvp and _exit;
    // buf_reserve made room for 65536 bytes past the buffer's len before each
    // read, and len grows by what read returned; status is a local.
    unsafe {
        let mut fds = [0 as i32, 0 as i32];
        if pipe(&mut fds[0]) != 0 {
            return 127;
        }
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            dup2((fds[1]), 1);
            dup2((fds[1]), 2);
            close((fds[0]));
            close((fds[1]));
            execvp(argv[0], argv.as_ptr() as *mut *mut u8);
            _exit(127);
        }
        close((fds[1]));
        loop {
            buf_reserve(out, 65536);
            let got = read((fds[0]),
                (*get_bufs().add(out as usize)).data.add(
                    (*get_bufs().add(out as usize)).len as usize), 65536);
            if got <= 0 {
                break;
            }
            (*get_bufs().add(out as usize)).len += got;
        }
        close((fds[0]));
        let mut status = 0 as i32;
        waitpid(pid, &mut status, 0);
        exit_code(status)
    }
}

// Starts argv with its stdout and stderr into file `path` (made anew);
// returns its process id, or -1.
pub fn spawn_to_file(argv: &[*mut u8], path: *mut u8) -> i64 {
    // UNSAFE: fork, creat, dup2, close, execvp and _exit are C's: a child
    // with its output on a file.
    // SAFETY: path is a C string of the caller's; argv is a list of C strings
    // ending with a null, borrowed for the call; the child calls only these
    // functions before exec, and _exit ends it when exec fails.
    unsafe {
        let pid = fork();
        if pid < 0 {
            return -1;
        }
        if pid == 0 {
            let fd = creat(path, 420);
            if fd >= 0 {
                dup2(fd, 1);
                dup2(fd, 2);
                close(fd);
            }
            execvp(argv[0], argv.as_ptr() as *mut *mut u8);
            _exit(127);
        }
        pid as i64
    }
}

// Runs argv (argv[0] found as a shell finds it; argv ends with 0) with
// this process's stdin, stdout and stderr: its exit status (127 when it
// could not be run).
pub fn run_inherit(argv: &[*mut u8]) -> i64 {
    // UNSAFE: fork, execvp, _exit and waitpid are C's.
    // SAFETY: argv is a list of C strings ending with a null, borrowed for the
    // call; the child calls only execvp and _exit; status is a local that
    // waitpid writes.
    unsafe {
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            execvp(argv[0], argv.as_ptr() as *mut *mut u8);
            _exit(127);
        }
        let mut status = 0 as i32;
        waitpid(pid, &mut status, 0);
        exit_code(status)
    }
}

// (0.25.4) Runs argv (argv[0] a path; argv ends with 0) as a shell runs a
// command in the foreground (`volec run`): with this process's stdin,
// stdout and stderr, volec ignoring ^C and ^\ (SIGINT, SIGQUIT) meanwhile,
// which the program gets from the terminal as before. Its exit status, 128
// + N when signal N ended it, 127 when it could not be run.
pub fn run_foreground(argv: &[*mut u8]) -> i64 {
    // UNSAFE: fork, execvp, waitpid and signal are C's (POSIX): std::process
    // takes at most 32 arguments and cannot leave a signal to the child.
    // SAFETY: argv is exec_words' null-ended array of NUL-terminated
    // strings; the child calls only execvp and _exit before it is replaced;
    // status is a local that waitpid writes; SIG_IGN (1) is a valid
    // disposition, and the ones before are restored after the wait.
    unsafe {
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            execvp(argv[0], argv.as_ptr() as *mut *mut u8);
            _exit(127);
        }
        let int_was = signal(2, 1 as *mut u8);
        let quit_was = signal(3, 1 as *mut u8);
        let mut status = 0 as i32;
        waitpid(pid, &mut status, 0);
        signal(2, int_was);
        signal(3, quit_was);
        exit_code(status)
    }
}

// run_inherit, with stdin the bytes of buffer b when b >= 0 (a pipe).
pub fn run_with_stdin(argv: &[*mut u8], b: i64) -> i64 {
    // UNSAFE: pipe, fork, close, dup2, execvp, _exit and waitpid are C's: a
    // child with its stdin on a pipe.
    // SAFETY: fds is a local of two i32s that pipe fills; argv is a list of C
    // strings ending with a null, borrowed for the call; the child calls only
    // close, dup2, execvp and _exit; each end of the pipe is closed once;
    // status is a local.
    unsafe {
        if b < 0 {
            return run_inherit(argv);
        }
        let mut fds = [0 as i32, 0 as i32];
        if pipe(&mut fds[0]) != 0 {
            return 127;
        }
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            close(fds[1]);
            dup2(fds[0], 0);
            close(fds[0]);
            execvp(argv[0], argv.as_ptr() as *mut *mut u8);
            _exit(127);
        }
        close(fds[0]);
        buf_write_fd(b, fds[1]);
        close(fds[1]);
        let mut status = 0 as i32;
        waitpid(pid, &mut status, 0);
        exit_code(status)
    }
}

// Starts a copy of this process (fork): 0 in the copy, its process id in
// the caller, -1 on failure.
pub fn fork_worker() -> i64 {
    // UNSAFE: fork is C's.
    // SAFETY: it takes no argument; the copy goes on as this program and
    // ends with worker_exit.
    unsafe { fork() as i64 }
}

// Ends a copy made by fork_worker.
pub fn worker_exit(code: i64) -> ! {
    // UNSAFE: _exit is C's: a forked copy ends without running the exit
    // handlers it shares with its parent.
    // SAFETY: it takes an int and does not return.
    unsafe { _exit(code as i32) }
}

// Waits for any child: its process id (-1: none left), its exit status in
// *status.
pub fn wait_any(status: &mut i64) -> i64 {
    // UNSAFE: waitpid is C's.
    // SAFETY: st is a local i32 that waitpid writes.
    unsafe {
        let mut st = 0 as i32;
        let pid = waitpid(-1, &mut st, 0);
        *status = exit_code(st);
        pid as i64
    }
}

// Reads file `path` into buffer `out`; false when it cannot be read.
pub fn read_file_if(path: *mut u8, out: i64) -> bool {
    // UNSAFE: fopen, fread and fclose are C's, and the bytes are read into
    // the buffer's own block (BUFS, base's raw table).
    // SAFETY: path is a C string of the caller's; file is checked not null
    // and closed once; buf_reserve made room for 65536 bytes past the
    // buffer's len before each fread, and len grows by what fread returned.
    unsafe {
        let file = fopen(path, c"rb");
        if file == 0 as *mut u8 {
            return false;
        }
        loop {
            buf_reserve(out, 65536);
            let got = fread(
                (*get_bufs().add(out as usize)).data.add(
                    (*get_bufs().add(out as usize)).len as usize), 1, 65536, file);
            (*get_bufs().add(out as usize)).len += got as i64;
            if got == 0 {
                break;
            }
        }
        fclose(file);
        true
    }
}

// Writes bytes to file `path` (made anew); false when it cannot.
pub fn write_file_if(path: *mut u8, bytes: &[u8]) -> bool {
    // UNSAFE: fopen, fwrite and fclose are C's.
    // SAFETY: path is a C string of the caller's; file is checked not null
    // and closed once; fwrite reads bytes.len() bytes from the slice's
    // pointer, and is not called for an empty slice.
    unsafe {
        let file = fopen(path, c"wb");
        if file == 0 as *mut u8 {
            return false;
        }
        let n: i64 = if bytes.len() > 0 { fwrite(bytes.ptr, 1, bytes.len() as u64, file) as i64 }
            else { 0 };
        fclose(file) == 0 && n == bytes.len() as i64
    }
}

// Moves `from` over `to`. (0.26.2) When `to` is a symlink, the file it
// names is replaced and the link kept: an edit of a linked source writes
// the source, not a copy where the link was.
pub fn rename_file(from: *mut u8, to: *mut u8) -> bool {
    // UNSAFE: realpath(3) and rename(2) are C's; there is no safe std call for either.
    // SAFETY: `from` and `to` are NUL-terminated paths the caller owns for the
    // call; realpath with a null buffer returns a fresh NUL-terminated string
    // or null, checked before use.
    unsafe {
        let real = realpath(to, 0 as *mut u8);
        if real != 0 as *mut u8 && rename(from, real) == 0 {
            return true;
        }
        rename(from, to) == 0
    }
}

// (0.21) Gives file `onto` (a copy written to replace `of`) the
// executable bit of `of`, as git tracks it: 755 when `of` can be run.
pub fn keep_mode(of: *mut u8, onto: *mut u8) {
    // UNSAFE: access and chmod are C's.
    // SAFETY: `of` and `onto` are C strings of the caller's.
    unsafe {
        if proc_access(of, 1) == 0 {
            chmod(onto, 493);
        }
    }
}

// (0.24) The target of symbolic link `path`, a new buffer; -1 when path
// is no link.
pub fn link_target(path: *mut u8) -> i64 {
    // UNSAFE: readlink is C's, and writes into the buffer's own block (BUFS,
    // base's raw table).
    // SAFETY: path is a C string of the caller's; buf_reserve made room for
    // 4096 bytes in the new buffer b, readlink writes at most 4096, and len
    // is set to what it wrote (checked not negative).
    unsafe {
        let b = buf_new();
        buf_reserve(b, 4096);
        let n = readlink(path, (*get_bufs().add(b as usize)).data, 4096);
        if n < 0 {
            return -1;
        }
        (*get_bufs().add(b as usize)).len = n;
        b
    }
}

// (0.24) Makes `path` a symbolic link to `target` (path must not exist).
pub fn make_link(target: *mut u8, path: *mut u8) -> bool {
    // UNSAFE: symlink is C's.
    // SAFETY: target and path are C strings of the caller's.
    unsafe { symlink(target, path) == 0 }
}

pub fn remove_file(path: *mut u8) -> bool {
    // UNSAFE: unlink is C's.
    // SAFETY: path is a C string of the caller's.
    unsafe { unlink(path) == 0 }
}

pub fn remove_dir(path: *mut u8) -> bool {
    // UNSAFE: rmdir is C's.
    // SAFETY: path is a C string of the caller's.
    unsafe { rmdir(path) == 0 }
}

// Makes directory `path` and its parents (`mkdir -p`); whether it exists.
pub fn make_dirs(path: *mut u8) -> bool {
    // UNSAFE: strlen, mkdir and realpath are C's; path is a C string, read
    // byte by byte, and mkdir is given the buffer's own block (BUFS).
    // SAFETY: path is a C string of the caller's, read below its strlen; b
    // ends with a 0 byte (buf_byte) each time its block is passed as a C
    // string, and len is taken back by the one byte just written; realpath
    // with a null buffer returns a new string or null, compared only.
    unsafe {
        let n = strlen(path) as i64;
        let b = buf_new();
        for i in 0..n {
            if (*path.add(i as usize)) == b'/' && i > 0 {
                buf_byte(b, 0);
                mkdir((*get_bufs().add(b as usize)).data, 493);
                (*get_bufs().add(b as usize)).len -= 1;
            }
            buf_byte(b, (*path.add(i as usize)));
        }
        buf_byte(b, 0);
        mkdir((*get_bufs().add(b as usize)).data, 493);
        let probe = buf_new();
        buf_str(probe, path);
        buf_str(probe, c"/.");
        buf_byte(probe, 0);
        realpath((*get_bufs().add(probe as usize)).data, 0 as *mut u8) != 0 as *mut u8
    }
}

// The absolute path of `path`, which exists (its directory, when it does
// not); the path itself when neither does.
pub fn absolute_path(path: *mut u8) -> *mut u8 {
    // UNSAFE: realpath and strlen are C's; path is a C string, read byte by
    // byte and returned as one.
    // SAFETY: path is a C string of the caller's, read below its strlen (i
    // is -1 or the index of a '/' in it); from_raw_parts covers its first i
    // bytes, i >= 0 there; dir and out end with a 0 byte before their blocks
    // are used as C strings; out is not freed here, and its block is what
    // is returned.
    unsafe {
        let r = realpath(path, 0 as *mut u8);
        if r != 0 as *mut u8 {
            return r;
        }
        let n = strlen(path) as i64;
        let mut i = n - 1;
        while i >= 0 && (*path.add(i as usize)) != b'/' {
            i -= 1;
        }
        let dir = buf_new();
        if i < 0 {
            buf_str(dir, c".");
        } else {
            buf_bytes(dir, std::slice::from_raw_parts(path.add((0) as usize), (i - (0)) as usize));
        }
        buf_byte(dir, 0);
        let d = realpath((*get_bufs().add(dir as usize)).data, 0 as *mut u8);
        if d == 0 as *mut u8 {
            return path;
        }
        let out = buf_new();
        buf_str(out, d);
        buf_byte(out, b'/');
        buf_str(out, path.add((i + 1) as usize));
        buf_byte(out, 0);
        (*get_bufs().add(out as usize)).data
    }
}

// The file the shell runs for a command named `name` without a `/`
// (0.25.3): the first DIR/name of $PATH that exists (an empty DIR is the
// current directory); 0 when there is none.
pub fn find_in_path(name: &[u8], pcx: &Ctx<Comp>) -> *mut u8 {
    // UNSAFE: getenv is C's (std's env::get_in needs a std allocator; the
    // compiler has none).
    // SAFETY: its argument is a NUL-terminated literal; it returns null or
    // a NUL-terminated string, which stays valid while the environment is
    // not changed: nothing below changes it.
    let pv = unsafe { getenv(c"PATH") };
    if pv == 0 as *mut u8 {
        return 0 as *mut u8;
    }
    let path = cstr(pv);
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    while i <= path.len() as i64 {
        if i == path.len() as i64 || path[i as usize] == b':' {
            let b = buf_new();
            if i == start {
                buf_byte(b, b'.');
            } else {
                buf_bytes(b, &path[start as usize..i as usize]);
            }
            buf_byte(b, b'/');
            buf_bytes(b, name);
            let file = buf_cstr(b);
            if crate::front::cpp::directives::file_exists(file, pcx) {
                return file;
            }
            start = i + 1;
        }
        i += 1;
    }
    0 as *mut u8
}

// (0.25.2) The directory of a tool's scratch files for the program whose
// root is `anchor` (the copies of its sources a probe builds, a reduce's
// candidates), never in the program's source tree: in a git checkout
// TOP/target/scratch/KIND/NAME, NAME the root's path from TOP with `-` for
// `/`; elsewhere $TMPDIR/volec-KIND/NAME, NAME its absolute path's. Made,
// and given from the current directory when it is below it.
pub fn scratch_dir(anchor: *mut u8, kind: &[u8], pcx: &Ctx<Comp>) -> *mut u8 {
    let abs = crate::tools::query::c_slice(absolute_path(anchor));
    // (the checkout: the nearest directory up with a .git)
    let mut top = abs.len() as i64;
    let mut found = false;
    while !found && top > 1 {
        while top > 0 && abs[(top - 1) as usize] != b'/' {
            top -= 1;
        }
        if top == 0 {
            break;
        }
        top -= 1;
        let g = buf_new();
        buf_bytes(g, &abs[0..top as usize]);
        buf_str(g, c"/.git");
        found = crate::front::cpp::directives::file_exists(buf_cstr(g), pcx);
    }
    let dir = buf_new();
    if found {
        buf_bytes(dir, &abs[0..top as usize]);
        buf_bytes(dir, b"/target/scratch/");
        buf_bytes(dir, kind);
        buf_byte(dir, b'/');
    } else {
        top = 0;
        // UNSAFE: getenv is C's
        // SAFETY: a C string's name; the result is copied before any setenv
        let tmp = unsafe { getenv(c"TMPDIR") };
        let t = if tmp == 0 as *mut u8 { b"/tmp" } else { crate::tools::query::c_slice(tmp) };
        buf_bytes(dir, if t.len() == 0 { b"/tmp" } else { t });
        let s = buf_slice(dir);
        if s[(s.len() as i64 - 1) as usize] != b'/' {
            buf_byte(dir, b'/');
        }
        buf_bytes(dir, b"volec-");
        buf_bytes(dir, kind);
        buf_byte(dir, b'/');
    }
    for i in top..abs.len() as i64 {
        if i > top || abs[i as usize] != b'/' {
            buf_byte(dir, if abs[i as usize] == b'/' { b'-' } else { abs[i as usize] });
        }
    }
    let path = buf_cstr(dir);
    make_dirs(path);
    // (from the current directory, when below it)
    let here = crate::tools::query::c_slice(absolute_path(c"."));
    let p = buf_slice(dir);
    if p.len() as i64 > here.len() as i64 + 1 && p[0..here.len()] == here
        && p[here.len()] == b'/' {
        let r = buf_new();
        buf_bytes(r, &p[(here.len() as i64 + 1) as usize..]);
        return buf_cstr(r);
    }
    path
}

// Reads all of stdin into `out`; false when stdin is a terminal (nothing
// was piped in).
pub fn read_stdin(out: i64, tcx: &mut Tcx<Comp>) -> bool {
    // UNSAFE: isatty and read are C's, and the bytes are read into the
    // buffer's own block (BUFS, base's raw table).
    // SAFETY: buf_reserve made room for 65536 bytes past the buffer's len
    // before each read, and len grows by what read returned (checked
    // positive).
    unsafe {
        if isatty(0) != 0 {
            return false;
        }
        loop {
            buf_reserve(out, 65536);
            let got = read(0,
                (*get_bufs().add(out as usize)).data.add(
                    (*get_bufs().add(out as usize)).len as usize), 65536);
            if got <= 0 {
                break;
            }
            (*get_bufs().add(out as usize)).len += got;
        }
        tcx.stdin_read = out;
        true
    }
}

// The bytes of buffer b as a C string (b gets a NUL after its bytes, not
// counted in its length).
pub fn buf_cstr(b: i64) -> *mut u8 {
    unsafe {
        buf_byte(b, 0);
        (*get_bufs().add(b as usize)).len -= 1;
        (*get_bufs().add(b as usize)).data
    }
}

// Whether the bytes of buffers a and b are the same.
pub fn same_bytes(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}
