// Indentation of edit texts: a text's indents, a new text re-indented
// as the old one, the lines of a text trimmed (split from patch).

use crate::base::{buf_byte, buf_bytes, buf_new};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::edit::items::indent_of;
use crate::tools::patch::is_blank;

// The width of the indentation of each line of text: the first line's
// (`first`), and the least of its non-blank lines (`least`).
pub fn indents(text: &[u8], first: &mut i64, least: &mut i64) {
    *first = -1;
    *least = 1000000;
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut j = i;
        while j < text.len() as i64 && (text[j as usize] == b' ' || text[j as usize] == b'\t') {
            j += 1;
        }
        if j < text.len() as i64 && text[j as usize] != b'\n' && text[j as usize] != b'\r' {
            if *first < 0 {
                *first = j - i;
            }
            if j - i < *least {
                *least = j - i;
            }
        }
        while i < text.len() as i64 && text[i as usize] != b'\n' {
            i += 1;
        }
        i += 1;
    }
    if *first < 0 {
        *first = 0;
        *least = 0;
    }
}

// NEW indented like the text OLD matched at s (--loose): its first line
// goes where OLD's started, the others keep their indentation relative to
// NEW's least, on top of the indentation OLD's least indented lines have
// in the file.
pub fn reindented(new: &[u8], s: i64, old: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let mut old_first: i64 = 0;
    let mut old_least: i64 = 0;
    indents(old, &mut old_first, &mut old_least);
    let mut new_first: i64 = 0;
    let mut new_least: i64 = 0;
    let t = trimmed_lines(new);
    indents(t, &mut new_first, &mut new_least);
    let line = indent_of(s, pcx);
    let mut base = line.len() as i64 - (old_first - old_least);
    if base < 0 {
        base = 0;
    }
    let out = buf_new();
    let mut i: i64 = 0;
    let mut first = true;
    while i < t.len() as i64 {
        let mut e = i;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        let mut a = i;
        while a < e && (t[a as usize] == b' ' || t[a as usize] == b'\t') {
            a += 1;
        }
        if !first {
            buf_byte(out, b'\n');
            if a < e {
                buf_bytes(out, &line[0..base as usize]);
                let keep = i + new_least;
                buf_bytes(out, &t[(if keep < a { keep } else { a }) as usize..e as usize]);
            }
        } else {
            buf_bytes(out, &t[a as usize..e as usize]);
        }
        first = false;
        i = e + 1;
    }
    out
}

// text without its blank lines first and last, and its last blanks.
pub fn trimmed_lines(text: &[u8]) -> &[u8] {
    let mut a: i64 = 0;
    let mut p: i64 = 0;
    while p < text.len() as i64 {
        let mut e = p;
        while e < text.len() as i64
            && (text[e as usize] == b' ' || text[e as usize] == b'\t' || text[e as usize] == b'\r') {
            e += 1;
        }
        if e < text.len() as i64 && text[e as usize] == b'\n' {
            p = e + 1;
            a = p;
        } else {
            break;
        }
    }
    let mut b = text.len() as i64;
    while b > a && is_blank(text[(b - 1) as usize]) {
        b -= 1;
    }
    &text[a as usize..b as usize]
}
