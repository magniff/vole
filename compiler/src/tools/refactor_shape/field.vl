// `refactor field STRUCT`: a field added, removed, renamed or retyped, in
// the struct, its literals and its field accesses; and the member lookups
// and renames refactor variant shares.

use std::alloc::Arena;

use crate::base::{buf_append, buf_byte, buf_bytes, buf_copy, buf_new, buf_str, get_src, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::Call;
use crate::front::ast::{NodeKind, REPR_C};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::Tok;
use crate::front::types::TyKind;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::query::{QF_DEF, c_slice, root_or_diag};
use crate::tools::query::defs::K_STRUCT;
use crate::tools::query::diagnostics::{diag, write_diags};
use crate::tools::query::positions::{put_loc, shorthand_at, shorthand_text, token_at};
use crate::tools::refactor_mod::mentions::doc_mentions;
use crate::tools::refactor_shape::{
    find_byte, leading_name, list_insert, list_of_node, list_remove, load_and_find, opt, orig_of,
    put_count, refs_of, replace_name, shape_options, split_default, sym_text, take_args, text_buf,
    try_query_name, usage_error,
};
use crate::tools::refactor_shape::signature::with_argument;
use crate::tools::rewrite::sort_by_start;
use crate::tools::rewrite::parsed::{pa, pb, pc, pchild, pcount, pend, pk, pstart};

// ---- refactor field ----

pub fn run_field(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = field_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

// The struct item of checked type t (through a pointer), or 0.
fn struct_node_of(t0: i64, pcx: &Ctx<Comp>) -> i64 {
    if t0 <= 0 {
        return 0;
    }
    let t = if pcx.types[t0 as usize].kind == TyKind::Ptr { pcx.types[t0 as usize].a } else { t0 };
    // (0.14: a closure's environment is no item)
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct
        || pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        return 0;
    }
    pcx.structs[pcx.types[t as usize].a as usize].node
}

// The literals of struct node s, as written, each once.
fn literals_of(s: i64, out: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::StructLit
            || struct_node_of(pcx.nodes[n as usize].ty, pcx) != s {
            continue;
        }
        let o = orig_of(n, NodeKind::StructLit, tcx, pcx);
        if o < 0 || seen.get(o + 1) != 0 {
            continue;
        }
        seen.put(o + 1, 1);
        out.push(o);
    }
    sort_by_start(&mut *out, pcx);
}

// The field of struct node s named `name`: its index, or -1.
fn field_index(s: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    for i in 0..pcount(s, pcx) {
        if pa(pchild(s, i, pcx), pcx) == name {
            return i;
        }
    }
    -1
}

fn put_fields(out: i64, s: i64, pcx: &Ctx<Comp>) {
    buf_byte(out, b'{');
    for i in 0..pcount(s, pcx) {
        buf_str(out, if i > 0 { c", " } else { c" " });
        buf_bytes(out, sym_text(pa(pchild(s, i, pcx), pcx), pcx));
    }
    buf_str(out, c" }");
}

pub fn no_member(d: i64, s: i64, name: *mut u8, what: *const u8, tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) -> i64 {
    let e = diag(c"error", c"refactor.no-member", tcx);
    buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
    buf_str(e, c" has no ");
    buf_str(e, what);
    buf_str(e, c" '");
    buf_str(e, name);
    buf_str(e, c"': ");
    put_fields(e, s, pcx);
    buf_byte(e, b'\n');
    try_query_name(c"show", sym_text(pcx.defs[d as usize].fqn, pcx), tcx, pcx);
    1
}

// The definition of member `name` (a field, a variant) of d.
pub fn member_def(d: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    for x in 0..pcx.defs.len() as i64 {
        if pcx.defs[x as usize].parent == d && pcx.defs[x as usize].name == name {
            return x;
        }
    }
    -1
}

// Renames each reference (R_POS) to `old` as `new`.
pub fn rename_refs(old: i64, new: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for r in 0..tcx.r_pos.len() as i64 {
        let pos = (tcx.r_pos[r as usize]);
        let t = token_at(pos, pcx);
        if seen.get(pos + 1) != 0 || t >= pcx.toks.len() as i64
            || pcx.toks[t as usize].start != pos || pcx.toks[t as usize].kind != Tok::Ident
            || pcx.toks[t as usize].value as i64 != old {
            continue;
        }
        seen.put(pos + 1, 1);
        if shorthand_at(pos, tcx, pcx) {
            // (0.15: `S { x }` becomes `S { y: x }`)
            edit_replace(pos, pos + sym_text(old, pcx).len() as i64,
                shorthand_text(sym_text(new, pcx), sym_text(old, pcx)), pcx);
            n += 1;
            continue;
        }
        replace_name(pos, old, new, pcx);
        n += 1;
    }
    n
}

fn field_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    tcx.sub = c"field";
    let mut root = 0 as *const u8;
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut opts: Vec<i64, Comp> = Vec::new_in(Comp {});
    let example = c"STRUCT --add 'g: i64 = 0' --dry-run";
    if !take_args(c, shape_options("field"), &mut root, &mut words, &mut opts, tcx, pcx) {
        return 2;
    }
    if words.len() as i64 != 1 {
        return usage_error(if words.len() as i64 == 0 { c"a STRUCT is needed" }
            else { c"one STRUCT at a time" }, example, tcx, pcx);
    }
    let add = opt(opts.as_slice(), c"--add", false);
    let remove = opt(opts.as_slice(), c"--remove", false);
    let rename = opt(opts.as_slice(), c"--rename", false);
    let retype = opt(opts.as_slice(), c"--type", false);
    let actions = (add != 0 as *mut u8) as i64 + (remove != 0 as *mut u8) as i64 + (rename
        != 0 as *mut u8) as i64
        + (retype != 0 as *mut u8) as i64;
    if actions != 1 {
        return usage_error(c"one of --add, --remove, --rename, --type", example, tcx, pcx);
    }
    let default = opt(opts.as_slice(), c"--default", false);
    if default != 0 as *mut u8 && retype == 0 as *mut u8 {
        return usage_error(c"--default goes with --type (the literals' new value)",
            c"STRUCT --type f T --default EXPR", tcx, pcx);
    }
    let name = c_slice((words[0]) as *mut u8);
    tcx.root_given = root;
    root = root_or_diag(root, tcx.sub, &name, true, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    let mut status: i64 = 0;
    let d = load_and_find(root, &name, 1 << K_STRUCT, c"struct", &mut status, tcx, pcx, wgx);
    if d < 0 {
        return status;
    }
    let s = pcx.defs[d as usize].node;
    let fqn = sym_text(pcx.defs[d as usize].fqn, pcx);
    let mut lits: Vec<i64, Comp> = Vec::new_in(Comp {});
    literals_of(s, &mut lits, tcx, pcx);
    let what = buf_new();
    let layout = (pc(s, pcx) & REPR_C) != 0 && rename == 0 as *mut u8;
    if add != 0 as *mut u8 {
        let text = c_slice(add);
        let mut vstart: i64 = -1;
        let dend = split_default(&text, &mut vstart);
        let decl = &text[0..dend as usize];
        let fname = leading_name(decl, pcx);
        if fname < 0 || find_byte(decl, b':') < 0 {
            return usage_error(c"--add takes 'NAME: TYPE = VALUE' (VALUE: the literals' value)",
                example, tcx, pcx);
        }
        if field_index(s, fname, pcx) >= 0 {
            let e = diag(c"error", c"refactor.clash", tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" has a field '");
            buf_bytes(e, sym_text(fname, pcx));
            buf_str(e, c"' already\n");
            return 1;
        }
        if vstart < 0 && lits.len() as i64 > 0 {
            let e = diag(c"error", c"refactor.no-default", tcx);
            buf_str(e, c"the literals of ");
            buf_bytes(e, fqn);
            buf_str(e, c" need a value for ");
            buf_bytes(e, sym_text(fname, pcx));
            buf_str(e, c": --add 'NAME: TYPE = VALUE'\n");
            return 2;
        }
        list_of_node(s, tcx, pcx);
        list_insert(pcount(s, pcx), decl, tcx, pcx);
        let init = buf_new();
        buf_bytes(init, sym_text(fname, pcx));
        buf_str(init, c": ");
        if vstart >= 0 {
            buf_bytes(init, &text[vstart as usize..]);
        }
        for i in 0..lits.len() as i64 {
            list_of_node((lits[i as usize]), tcx, pcx);
            list_insert(pcount((lits[i as usize]), pcx), &buf_copy(init), tcx, pcx);
        }
        buf_str(what, c"added field ");
        buf_bytes(what, decl);
        buf_str(what, c" to ");
        buf_bytes(what, fqn);
        buf_str(what, c", ");
        put_count(what, lits.len() as i64, c"literal", c"literals");
    } else if remove != 0 as *mut u8 {
        let fname = intern(&c_slice(remove), pcx);
        let k = field_index(s, fname, pcx);
        if k < 0 {
            return no_member(d, s, remove, c"field", tcx, pcx);
        }
        // Its uses: the references but its definition and the
        // literals' fields.
        let fd = member_def(d, fname, pcx);
        let mut targets: Vec<i64, Comp> = Vec::new_in(Comp {});
        targets.push(fd);
        refs_of(targets.as_slice(), tcx, pcx);
        let mut inits = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for i in 0..lits.len() as i64 {
            for j in 0..pcount((lits[i as usize]), pcx) {
                inits.put(pstart(pchild((lits[i as usize]), j, pcx), pcx) + 1, 1);
            }
        }
        let mut used: i64 = 0;
        let mut first: i64 = -1;
        for r in 0..tcx.r_pos.len() as i64 {
            if ((tcx.r_flags[r as usize]) & QF_DEF) != 0
                || inits.get((tcx.r_pos[r as usize]) + 1) != 0 {
                continue;
            }
            if first < 0 {
                first = (tcx.r_pos[r as usize]);
            }
            used += 1;
        }
        if used > 0 {
            let e = diag(c"error", c"refactor.used", tcx);
            buf_bytes(e, sym_text(pcx.defs[fd as usize].fqn, pcx));
            buf_str(e, c" is used: ");
            put_count(e, used, c"reference", c"references");
            buf_str(e, c" (first: ");
            put_loc(e, first, pcx);
            buf_str(e, c")\n");
            try_query_name(c"refs", sym_text(pcx.defs[fd as usize].fqn, pcx), tcx, pcx);
            return 1;
        }
        list_of_node(s, tcx, pcx);
        list_remove(k, tcx, pcx);
        for i in 0..lits.len() as i64 {
            let l = (lits[i as usize]);
            list_of_node(l, tcx, pcx);
            for j in 0..pcount(l, pcx) {
                if pa(pchild(l, j, pcx), pcx) == fname {
                    list_remove(j, tcx, pcx);
                }
            }
        }
        buf_str(what, c"removed field ");
        buf_bytes(what, sym_text(fname, pcx));
        buf_str(what, c" of ");
        buf_bytes(what, fqn);
        buf_str(what, c", ");
        put_count(what, lits.len() as i64, c"literal", c"literals");
    } else if rename != 0 as *mut u8 {
        let old = intern(&c_slice(rename), pcx);
        let new = intern(&c_slice(opt(opts.as_slice(), c"--rename", true)), pcx);
        if field_index(s, old, pcx) < 0 {
            return no_member(d, s, rename, c"field", tcx, pcx);
        }
        if field_index(s, new, pcx) >= 0 {
            let e = diag(c"error", c"refactor.clash", tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" has a field '");
            buf_bytes(e, sym_text(new, pcx));
            buf_str(e, c"' already\n");
            return 1;
        }
        let mut targets: Vec<i64, Comp> = Vec::new_in(Comp {});
        targets.push(member_def(d, old, pcx));
        refs_of(targets.as_slice(), tcx, pcx);
        let n = rename_refs(old, new, tcx, pcx);
        doc_mentions(targets.as_slice(), old, sym_text(new, pcx), tcx, pcx);
        buf_str(what, c"renamed field ");
        buf_bytes(what, sym_text(old, pcx));
        buf_str(what, c" to ");
        buf_bytes(what, sym_text(new, pcx));
        buf_str(what, c" of ");
        buf_bytes(what, fqn);
        buf_str(what, c", ");
        put_count(what, n - 1, c"use", c"uses");
    } else {
        let fname = intern(&c_slice(retype), pcx);
        let k = field_index(s, fname, pcx);
        if k < 0 {
            return no_member(d, s, retype, c"field", tcx, pcx);
        }
        let ty = c_slice(opt(opts.as_slice(), c"--type", true));
        let t = pb(pchild(s, k, pcx), pcx);
        edit_replace(pstart(t, pcx), pend(t, pcx), text_buf(&ty), pcx);
        // (0.17: --default EXPR, each literal's value of the field
        // becomes EXPR, `$NAME` the old value)
        let mut changed: i64 = 0;
        if default != 0 as *mut u8 {
            for i in 0..lits.len() as i64 {
                let l = (lits[i as usize]);
                for j in 0..pcount(l, pcx) {
                    let fi = pchild(l, j, pcx);
                    if pk(fi, pcx) != NodeKind::FieldInit || pa(fi, pcx) != fname {
                        continue;
                    }
                    let v = pb(fi, pcx);
                    let value = with_argument(&c_slice(default), sym_text(fname, pcx),
                        &get_src()[pstart(v, pcx) as usize..pend(v, pcx) as usize]);
                    let init = buf_new();
                    buf_bytes(init, sym_text(fname, pcx));
                    buf_str(init, c": ");
                    buf_append(init, value);
                    edit_replace(pstart(fi, pcx), pend(fi, pcx), init, pcx);
                    changed += 1;
                }
            }
        }
        buf_str(what, c"changed field ");
        buf_bytes(what, sym_text(fname, pcx));
        buf_str(what, c" to ");
        buf_bytes(what, &ty);
        buf_str(what, c" in ");
        buf_bytes(what, fqn);
        if default != 0 as *mut u8 {
            buf_str(what, c", ");
            put_count(what, changed, c"literal", c"literals");
        }
    }
    if layout {
        let e = diag(c"warning", c"refactor.layout", tcx);
        buf_bytes(e, fqn);
        buf_str(e, c" is #[repr(C)]: its layout changes (C code sharing it must change too)\n");
    }
    apply_edit(&buf_copy(what), root, tcx, pcx)
}
