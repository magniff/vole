// The text of inline: names, lines and indentation of the code it copies,
// and the paths and words it reads.

use crate::base::{buf_byte, buf_bytes, buf_done, buf_int, buf_new, buf_ptr, intern, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::tools::ctx::Tcx;
use crate::tools::query::c_slice;
use crate::tools::query::positions::token_at;
use crate::tools::rewrite::parsed::{pend, pstart};

// s from its first character that is not a blank.
pub fn skip_indent(s: &[u8]) -> &[u8] {
    let mut i: i64 = 0;
    while i < s.len() as i64 && (s[i as usize] == b' ' || s[i as usize] == b'\t') {
        i += 1;
    }
    &s[i as usize..]
}

// Whether text is a place written with names, `.` and digits (`a.b.0`).
pub fn place_path(s: &[u8]) -> bool {
    for i in 0..s.len() {
        let c = s[i];
        if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
            || c == b'_' || c == b'.') {
            return false;
        }
    }
    s.len() > 0
}

// Whether `name` is a word of an argument's text.
pub fn named_in_args(args: &[i64], name: &[u8], pcx: &Ctx<Comp>) -> bool {
    for i in 0..args.len() as i64 {
        let a = (args[i as usize]);
        let mut t = token_at(pstart(a, pcx), pcx);
        while t < pcx.toks.len() as i64 && pcx.toks[t as usize].start < pend(a, pcx) {
            if pcx.toks[t as usize].kind == Tok::Ident
                && bytes_eq_sym(pcx.toks[t as usize].value as i64, name, pcx) {
                return true;
            }
            t += 1;
        }
    }
    false
}

fn bytes_eq_sym(sym: i64, s: &[u8], pcx: &Ctx<Comp>) -> bool {
    let t = sym_text(sym, pcx);
    if t.len() != s.len() {
        return false;
    }
    for i in 0..s.len() {
        if t[i] != s[i] {
            return false;
        }
    }
    true
}

// `NAME_2`, `NAME_3`... the first that no argument, body local or other
// name of the body has (`self`: `this`, then `this_2`...).
pub fn fresh_name<'a>(name: &'a [u8], args: &[i64], tcx: &'a Tcx<Comp>, pcx: &mut Ctx<Comp>) -> &'a [u8] {
    let base = if bytes_is(name, c"self", pcx) { b"this" } else { name };
    let mut k: i64 = 1;
    loop {
        let b = buf_new();
        buf_bytes(b, base);
        if k > 1 {
            buf_byte(b, b'_');
            buf_int(b, k);
        }
        let s = buf_done(b);
        let sym = intern(s, pcx);
        let mut taken = named_in_args(args, s, pcx);
        for i in 0..tcx.body_locals.len() as i64 {
            if (tcx.body_locals[i as usize]) == sym {
                taken = true;
            }
        }
        for i in 0..tcx.body_free.len() as i64 {
            if (tcx.body_free[i as usize]) == sym {
                taken = true;
            }
        }
        for i in 0..tcx.p_name.len() as i64 {
            if (tcx.p_name[i as usize]) == sym {
                taken = true;
            }
        }
        if !taken {
            return s;
        }
        k += 1;
    }
}

// The lines of text s after its first, their first `from` columns of
// indentation replaced by `to` (the first line as it is), into out.
pub fn shift_lines(out: i64, s: &[u8], from: i64, to: &[u8]) {
    let mut i: i64 = 0;
    let mut first = true;
    while i < s.len() as i64 {
        let mut e = i;
        while e < s.len() as i64 && s[e as usize] != b'\n' {
            e += 1;
        }
        if first {
            buf_bytes(out, &s[i as usize..e as usize]);
        } else {
            let mut a = i;
            while a < e && a - i < from && (s[a as usize] == b' ' || s[a as usize] == b'\t') {
                a += 1;
            }
            if a < e {
                buf_bytes(out, to);
            }
            buf_bytes(out, &s[a as usize..e as usize]);
        }
        if e < s.len() as i64 {
            buf_byte(out, b'\n');
        }
        first = false;
        i = e + 1;
    }
}

// s without its first and last blank lines.
pub fn trim_blank_lines(s: &[u8]) -> &[u8] {
    let mut a: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len() as i64
        && (s[i as usize] == b' ' || s[i as usize] == b'\t' || s[i as usize] == b'\n'
            || s[i as usize] == b'\r') {
        if s[i as usize] == b'\n' {
            a = i + 1;
        }
        i += 1;
    }
    let mut b = s.len() as i64;
    while b > a
        && (s[(b - 1) as usize] == b' ' || s[(b - 1) as usize] == b'\t'
            || s[(b - 1) as usize] == b'\n' || s[(b - 1) as usize] == b'\r') {
        b -= 1;
    }
    &s[a as usize..b as usize]
}

// FILE:LINE into *file (a C string) and *line.
pub fn file_line(s: &[u8], file: *mut *mut u8, line: &mut i64) -> bool {
    unsafe {
        let mut c = s.len() as i64 - 1;
        while c > 0 && s[c as usize] != b':' {
            c -= 1;
        }
        if c <= 0 || c == s.len() as i64 - 1 {
            return false;
        }
        let mut n: i64 = 0;
        for i in c + 1..s.len() as i64 {
            if s[i as usize] < b'0' || s[i as usize] > b'9' {
                return false;
            }
            n = n * 10 + (s[i as usize] - b'0') as i64;
        }
        let b = buf_new();
        buf_bytes(b, &s[0..c as usize]);
        buf_byte(b, 0);
        *file = buf_ptr(b);
        *line = n;
        n > 0
    }
}

// Whether path ends with suffix (at a `/`, or whole): `src/calc.vl`
// ends with `calc.vl`, `./calc.vl` too.
pub fn ends_with(path: *mut u8, suffix: &[u8]) -> bool {
    let p = c_slice(path);
    let mut s = suffix;
    while s.len() > 2 && s[0] == b'.' && s[1] == b'/' {
        s = &s[2..s.len()];
    }
    if p.len() < s.len() {
        return false;
    }
    let off = p.len() as i64 - s.len() as i64;
    for i in 0..s.len() as i64 {
        if p[(off + i) as usize] != s[i as usize] {
            return false;
        }
    }
    off == 0 || p[(off - 1) as usize] == b'/'
}

pub fn contains(v: &[i64], x: i64) -> bool {
    for i in 0..v.len() as i64 {
        if (v[i as usize]) == x {
            return true;
        }
    }
    false
}

pub fn bytes_is(s: &[u8], c: *mut u8, pcx: &mut Ctx<Comp>) -> bool {
    bytes_eq_sym(intern(&c_slice(c), pcx), s, pcx)
}
