// `refactor inline FN [--at FILE:LINE] [--keep]` (0.13): the calls of
// function FN replaced by its body; with --at, the call on that line
// only. Then FN, with no other use left, is deleted with its imports
// (--keep: kept).
//
// An argument is put in for its parameter where the body uses it when it
// is a name or a literal (and the body has no local of that name), or
// when the body is one expression that uses the parameter once and the
// argument is the only one that is neither; else it is bound first, in
// order (`let x = ARG;`, `let mut x` when the body changes it; renamed
// when its name is in an argument). The body becomes the call's value: an
// expression in parentheses when it binds looser than the call's place,
// else a block (`{ let x = ...; ...; tail }`). A method's receiver is
// `self` (the receiver itself when the body uses `self` only as `self.f`
// or `self.m(...)`).
//
// Refused: a body with a `return` (refactor.escapes), a call of FN in its
// own body (refactor.recursive), a generic FN or an extern "C" one
// (refactor.generic, refactor.extern), a body naming something that a
// local hides where it is called (refactor.clash). Imports and `pub` the
// moved code needs in another module are added (a round of `fix --only
// imports,pub` on the edited program).

mod text;

use std::Arena;

use crate::base::{BUFS, IntVec, SRC, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::Call;
use crate::front::ast::{NodeKind, child};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_at};
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{finish_edit, prepare_edit, set_command};
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::{after_line, indent_of, item_head, item_tail, node_head};
use crate::tools::fix::remove_use_name;
use crate::tools::query::{QF_DEF, QF_USE, c_slice, root_or_diag};
use crate::tools::query::defs::{K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, def_of_node};
use crate::tools::query::diagnostics::{
    diag, diags, put_cword, put_root, put_word, try_end, write_diags,
};
use crate::tools::query::positions::{
    enclosing, line_of, line_start, put_path, shorthand_at, shorthand_text, token_at,
};
use crate::tools::query::show::text_start;
use crate::tools::refactor_mod::{item_binding, load_refs, own_file, use_binding_id, use_node_of};
use crate::tools::refactor_shape::{
    load_and_find, opt, orig_of, refs_of, shape_options, sym_text, take_args, try_query_name,
    usage_error,
};
use crate::tools::refactor_shape::body::{
    USE_FIELD_READ, USE_VALUE, closure_around, fix_round, in_body, load_body, local_of, reindent,
    text_with, use_kind,
};
use crate::tools::refactor_shape::inline::text::{
    bytes_is, contains, ends_with, file_line, fresh_name, named_in_args, place_path, shift_lines,
    skip_indent, trim_blank_lines,
};
use crate::tools::rewrite::parsed::{
    binding_level, expr_slots, pa, pb, pchild, pcount, pend, ph, pk, pstart,
};
use crate::tools::tidyimports::tidy_round;

pub fn run_inline(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>,
    wgx: inout WgslCx<Arena>) -> i64 {
    let status = inline_inner(c, &tcx, &pcx, &wgx);
    write_diags(tcx);
    status
}

fn inline_inner(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>, wgx: inout WgslCx<Arena>) -> i64 {
    unsafe {
        set_command(c.line, &tcx);
        pcx.prog = c.prog();
        tcx.tool = c"refactor";
        tcx.sub = c"inline";
        var root = 0 as *u8;
        var words = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var opts = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let example = c"FN [--at FILE:LINE] --dry-run";
        if !take_args(c, shape_options("inline"), &root, &words, &opts, &tcx, &pcx) {
            return 2;
        }
        if words.count != 1 {
            return usage_error(if words.count == 0 { c"a function FN is needed" }
                else { c"one FN at a time" }, example, &tcx, pcx);
        }
        let at = opt(opts, c"--at", false);
        var keep = at != 0 as *u8;
        for i in 0..opts.count {
            if bytes_is(c_slice(opts.data[i] as *u8), c"--keep") {
                keep = true;
            }
        }
        var at_file = 0 as *u8;
        var at_line = 0;
        if at != 0 as *u8 && !file_line(c_slice(at), &at_file, &at_line) {
            return usage_error(c"--at takes FILE:LINE, the line of a call", example, &tcx, pcx);
        }
        let name = c_slice(words.data[0] as *u8);
        tcx.root_given = root;
        root = root_or_diag(root, tcx.sub, name, true, &tcx, pcx);
        if root == 0 as *u8 {
            return 2;
        }
        var status = 0;
        let d = load_and_find(root, name, (1 << K_FN) | (1 << K_METHOD), c"function", &status,
            &tcx, &pcx, &wgx);
        if d < 0 {
            return status;
        }
        let f = pcx.defs[d].node;
        let body = pcx.nodes[f].c;
        let fqn = sym_text(pcx.defs[d].fqn);
        if pcx.nodes[f].y == 1 {
            let e = diag(c"error", c"refactor.extern", &tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" is an extern \"C\" function: C code may call it\n");
            return 1;
        }
        if body <= 0 || pcx.nodes[f].g != 0
            || (pcx.nodes[f].h != 0 && pcx.nodes[pcx.nodes[f].h].g != 0) {
            let e = diag(c"error", c"refactor.generic", &tcx);
            buf_bytes(e, fqn);
            buf_str(e,
                if body <= 0 { c" has no body\n" }
                else { c" is generic: its body is checked once per instance\n" });
            return 1;
        }
        if !load_callee(d, f, fqn, &tcx, &pcx) {
            return 1;
        }
        // The calls (as written), each once; with --at, the one on that line.
        var calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var checked = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for n in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[n].kind != NodeKind::Call || pcx.nodes[n].x <= 0
                || def_of_node(pcx.fns[pcx.nodes[n].x - 1].node, tcx, pcx) != d {
                continue;
            }
            var o = orig_of(n, NodeKind::Call, tcx, pcx);
            if o < 0 {
                o = orig_of(n, NodeKind::MethodCall, tcx, pcx);
            }
            if o < 0 || contains(calls, o) {
                continue;
            }
            if at != 0 as *u8
                && !(line_of(pstart(o, pcx), pcx) == at_line
                    && ends_with(pcx.files[file_of_pos(pstart(o, pcx), pcx)].path,
                        c_slice(at_file))) {
                continue;
            }
            calls.push(o);
            checked.push(n);
        }
        if calls.count == 0 {
            let e = diag(c"error", c"refactor.no-call", &tcx);
            buf_bytes(e, fqn);
            buf_str(e, if at != 0 as *u8 { c" is not called on " } else { c" is not called\n" });
            if at != 0 as *u8 {
                buf_str(e, at);
                buf_byte(e, '\n');
            }
            try_query_name(c"refs", fqn, &tcx, pcx);
            return 1;
        }
        if at != 0 as *u8 && calls.count > 1 {
            let e = diag(c"error", c"refactor.ambiguous", &tcx);
            buf_str(e, at);
            buf_str(e, c" has ");
            buf_int(e, calls.count);
            buf_str(e, c" calls of ");
            buf_bytes(e, fqn);
            buf_str(e, c"; inline them all, or put one on a line of its own\n");
            return 1;
        }
        // (a call inside another's arguments: the outer one only)
        var nested = 0;
        var done = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..calls.count {
            let o = calls.data[i];
            var inner = false;
            for j in 0..calls.count {
                let q = calls.data[j];
                if j != i && pstart(q, pcx) <= pstart(o, pcx) && pend(o, pcx) <= pend(q, pcx)
                    && (pstart(q, pcx) < pstart(o, pcx) || pend(o, pcx) < pend(q, pcx)) {
                    inner = true;
                }
            }
            if inner {
                nested += 1;
                continue;
            }
            if !inline_call(d, o, checked.data[i], fqn, &tcx, &pcx) {
                return 1;
            }
            done.push(o);
        }
        // FN, when nothing else uses it: deleted, with its imports.
        var deleted = false;
        if !keep && nested == 0 {
            deleted = delete_unused(d, done, &tcx, &pcx);
        }
        let status = prepare_edit(&tcx, &pcx);
        if status >= 0 {
            return status;
        }
        fix_round(root, c"imports,pub", &tcx, pcx);
        tidy_round(root, &tcx, pcx);
        let what = buf_new();
        buf_str(what, c"inlined ");
        buf_bytes(what, fqn);
        buf_str(what, c" at ");
        buf_int(what, done.count);
        buf_str(what, if done.count == 1 { c" call" } else { c" calls" });
        if deleted {
            buf_str(what, c", deleted it");
        }
        if nested > 0 {
            let e = diag(c"note", c"refactor.nested", &tcx);
            buf_int(e, nested);
            buf_str(e, if nested == 1 { c" call is" } else { c" calls are" });
            buf_str(e, c" in the arguments of another: inline again for them\n");
        }
        finish_edit(buf_slice(what), root, &tcx, &pcx)
    }
}

// What inlining needs of FN's body (node f): its parameters and their
// uses, its locals' names, the other names it uses. False after a
// diagnostic (a `return`, a call of itself).
fn load_callee(d: i64, f: i64, fqn: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        load_free_defs(pcx.nodes[f].c, &tcx, &pcx);
        load_body(f, &tcx, pcx);
        for n in 1..pcx.nodes.len() as i64 {
            if !in_body(n, tcx) {
                continue;
            }
            let k = pcx.nodes[n].kind;
            // (0.14: a closure's `return` leaves the closure)
            // (0.15: `e?` may return, as a `return` does)
            if (k == NodeKind::Return || k == NodeKind::Try) && closure_around(n, tcx, pcx) < 0 {
                let e = diag(c"error", c"refactor.escapes", &tcx);
                buf_bytes(e, fqn);
                buf_str(e, if k == NodeKind::Try { c" may return early (`?`), on line " }
                    else { c" returns early, on line " });
                buf_int(e, line_of(pcx.nodes[n].start, pcx));
                buf_str(e, c": inline takes a function that ends with its value\n");
                try_at(pcx.nodes[n].start, &tcx, pcx);
                return false;
            }
            if k == NodeKind::Call && pcx.nodes[n].x > 0
                && def_of_node(pcx.fns[pcx.nodes[n].x - 1].node, tcx, pcx) == d {
                let e = diag(c"error", c"refactor.recursive", &tcx);
                buf_bytes(e, fqn);
                buf_str(e, c" calls itself, on line ");
                buf_int(e, line_of(pcx.nodes[n].start, pcx));
                buf_byte(e, '\n');
                return false;
            }
            if k == NodeKind::PatBind || (k == NodeKind::Param && pcx.nodes[n].a != 0) {
                tcx.body_locals.push(pcx.nodes[n].a);
            }
            if k == NodeKind::Ident && local_of(n, pcx) < 0 {
                tcx.body_free.push(pcx.nodes[n].a);
            }
        }
        for i in 0..pcx.nodes[f].count {
            let p = child(f, i, pcx);
            tcx.p_local.push(pcx.nodes[p].x);
            tcx.p_name.push(pcx.nodes[p].a);
            tcx.p_uses.push(0);
            tcx.p_changed.push(0);
        }
        for n in 1..pcx.nodes.len() as i64 {
            let l = local_of(n, pcx);
            if l < 0 || !in_body(n, tcx) {
                continue;
            }
            for j in 0..tcx.p_local.count {
                if tcx.p_local.data[j] != l {
                    continue;
                }
                tcx.u_start.push(pcx.nodes[n].start);
                tcx.u_end.push(pcx.nodes[n].end);
                tcx.u_param.push(j);
                tcx.p_uses.data[j] += 1;
                let k = use_kind(n, tcx, pcx);
                if k != USE_VALUE && k != USE_FIELD_READ {
                    tcx.p_changed.data[j] = 1;
                }
            }
        }
        true
    }
}

// The items FN's body (node body) names (FREE_DEF: functions, types,
// constants, statics; not a variant, a field, a method): from every
// reference the checker resolved (load_refs, which copy_imports needs too).
fn load_free_defs(body: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        load_refs(&tcx, &pcx);
        for r in 0..tcx.r_pos.count {
            let pos = tcx.r_pos.data[r];
            let x = tcx.r_def.data[r];
            let k = pcx.defs[x].kind;
            if (tcx.r_flags.data[r] & QF_DEF) == 0 && pos >= pcx.nodes[body].start
                && pos < pcx.nodes[body].end && pcx.defs[x].parent < 0 && k != K_METHOD
                && k != K_IMPL_METHOD && k != K_MOD
                && !contains(tcx.free_def, x) {
                tcx.free_def.push(x);
            }
        }
    }
}

// The items the body names that are private in another module than the
// caller's (module m): made `pub` (once each), so that the imports the
// fix round adds reach them.
fn publish_free_defs(m: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        for i in 0..tcx.free_def.count {
            let x = tcx.free_def.data[i];
            if pcx.defs[x].module == m || pcx.defs[x].public || contains(tcx.pubbed, x)
                || pcx.files[file_of_pos(pcx.defs[x].start, pcx)].path[0] == '<' {
                continue;
            }
            tcx.pubbed.push(x);
            let at = item_head(x, tcx, pcx);
            edit_replace(at, at, text_of_c(c"pub "), &pcx);
        }
    }
}

// The imports of FN's module (m) its body names that the caller's
// module (cm) lacks, added there: `use PATH::NAME;` after its last `use`
// (a variant, `use crate::ir::Op::Const`, which fix cannot find).
fn copy_imports(m: i64, cm: i64, body: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if m == cm {
        return;
    }
    let f = own_file(cm, pcx);
    if f < 0 {
        return;
    }
    var t = token_at(pcx.nodes[body].start, pcx);
    while t < pcx.toks.len() as i64 && pcx.toks[t].start < pcx.nodes[body].end {
        let s = pcx.toks[t].value as i64;
        let after_dot = t > 0
            && (pcx.toks[t - 1].kind == Tok::Dot || pcx.toks[t - 1].kind == Tok::ColonColon);
        if pcx.toks[t].kind != Tok::Ident || after_dot || contains(tcx.body_locals, s)
            || contains(tcx.p_name, s)
            || contains(tcx.copied, cm * 1000003 + s) {
            t += 1;
            continue;
        }
        let id = use_binding_id(m, s, pcx);
        if id == 0 || item_binding(cm, s, tcx) >= 0 || use_binding_id(cm, s, pcx) != 0 {
            t += 1;
            continue;
        }
        let u = use_node_of(id, tcx);
        var path = SRC[pcx.nodes[pcx.nodes[u].c].start..pcx.nodes[pcx.nodes[u].c].end];
        if path.len > 2 && path[path.len as i64 - 1] == ':' {
            path = path[0..path.len as i64 - 2];
        }
        if !(path.len > 7 && bytes_is(path[0..7], c"crate::"))
            && !(path.len > 5 && bytes_is(path[0..5], c"std::")) {
            t += 1;
            continue;
        }
        tcx.copied.push(cm * 1000003 + s);
        let line = buf_new();
        buf_str(line, c"use ");
        buf_bytes(line, path);
        buf_str(line, c"::");
        buf_bytes(line, sym_text(pcx.nodes[id].a));
        if pcx.nodes[id].b != 0 {
            buf_str(line, c" as ");
            buf_bytes(line, sym_text(pcx.nodes[id].b));
        }
        buf_str(line, c";\n");
        // (after the module's last `use`, else before its first line
        // of code)
        var at = -1;
        for v in 1..pcx.nodes.len() {
            if pcx.nodes[v].kind == NodeKind::Use && file_of_pos(pcx.nodes[v].start, pcx) == f
                && after_line(pcx.nodes[v].end - 1, pcx) > at {
                at = after_line(pcx.nodes[v].end - 1, pcx);
            }
        }
        if at < 0 {
            at = line_start(pcx.toks[token_at(pcx.files[f].start, pcx)].start, pcx);
            buf_byte(line, '\n');
        }
        edit_replace(at, at, line, &pcx);
        t += 1;
    }
}

fn text_of_c(s: *u8) -> i64 {
    let b = buf_new();
    buf_str(b, s);
    b
}

// The call o (as written; n, as checked) of FN replaced by its body:
// false after a diagnostic.
fn inline_call(d: i64, o: i64, n: i64, fqn: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let f = pcx.defs[d].node;
        let body = pcx.nodes[f].c;
        // The arguments, the receiver first.
        var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        if pk(o, pcx) == NodeKind::MethodCall {
            args.push(pa(o, pcx));
        }
        for i in 0..pcount(o, pcx) {
            args.push(pchild(o, i, pcx));
        }
        // (0.15: by the parameters' order: a labelled argument's value,
        // and a parameter's default where the call leaves it out)
        if args.count <= tcx.p_local.count {
            let first = args.count - pcount(o, pcx);
            var by_param = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for j in 0..tcx.p_local.count {
                by_param.push(if j < first { args.data[j] } else { 0 });
            }
            var ok = true;
            for i in 0..pcount(o, pcx) {
                let a = pchild(o, i, pcx);
                var j = first + i;
                if pk(a, pcx) == NodeKind::NamedArg {
                    j = -1;
                    for k in 0..tcx.p_name.count {
                        if tcx.p_name.data[k] == pa(a, pcx) {
                            j = k;
                        }
                    }
                }
                if j < 0 || j >= by_param.count {
                    ok = false;
                } else {
                    by_param.data[j] = if pk(a, pcx) == NodeKind::NamedArg { pb(a, pcx) }
                        else { a };
                }
            }
            for j in 0..by_param.count {
                if by_param.data[j] == 0 {
                    let dflt = ph(pchild(f, j, pcx), pcx);
                    if dflt == 0 {
                        ok = false;
                    }
                    by_param.data[j] = dflt;
                }
            }
            if ok {
                args = by_param;
            }
        }
        if args.count != tcx.p_local.count {
            let e = diag(c"error", c"refactor.internal", &tcx);
            buf_str(e, c"the call on line ");
            buf_int(e, line_of(pstart(o, pcx), pcx));
            buf_str(e, c" has an argument per parameter of its own; nothing written\n");
            return false;
        }
        // The names the caller's locals hide.
        let c = enclosing(pstart(o, pcx), tcx, pcx);
        let cf = if c >= 0 { pcx.defs[c].node } else { -1 };
        for i in 0..tcx.body_free.count {
            let name = tcx.body_free.data[i];
            if cf > 0 && local_named(cf, name, pcx) {
                let e = diag(c"error", c"refactor.clash", &tcx);
                buf_bytes(e, fqn);
                buf_str(e, c" names ");
                buf_bytes(e, sym_text(name));
                buf_str(e, c", a local of ");
                buf_bytes(e, sym_text(pcx.defs[c].fqn));
                buf_str(e, c" where it is called (line ");
                buf_int(e, line_of(pstart(o, pcx), pcx));
                buf_str(e, c"): rename the local first\n");
                try_at(pstart(o, pcx), &tcx, pcx);
                return false;
            }
        }
        publish_free_defs(module_at(pstart(o, pcx), &pcx), &tcx, &pcx);
        copy_imports(pcx.defs[d].module, module_at(pstart(o, pcx), &pcx), body, &tcx, &pcx);
        // Each parameter: the argument put in for it, or bound first.
        let single = pcx.nodes[body].count == 0 && pcx.nodes[body].a > 0;
        var complex = 0;
        for j in 0..args.count {
            if !simple_arg(args.data[j], tcx, pcx) {
                complex += 1;
            }
        }
        let binds = buf_new();
        var u_text = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var sub = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for j in 0..args.count {
            let a = args.data[j];
            let text = SRC[pstart(a, pcx)..pend(a, pcx)];
            let t = buf_new();
            if j == 0 && pk(o, pcx) == NodeKind::MethodCall && autoref(n, pcx) {
                // (the receiver, a place the method took the address of)
                if !self_as_base(f, pcx) || !place_path(text) {
                    let e = diag(c"error", c"refactor.receiver", &tcx);
                    buf_str(e, c"the receiver on line ");
                    buf_int(e, line_of(pstart(o, pcx), pcx));
                    buf_str(e, c" is borrowed, and ");
                    buf_bytes(e, fqn);
                    buf_str(e, c" uses self other than as self.f or self.m(...): bind it to a local first\n");
                    try_at(pstart(o, pcx), &tcx, pcx);
                    return false;
                }
                buf_bytes(t, text);
                sub.push(1);
            }
            else if tcx.p_changed.data[j] == 0 && tcx.p_uses.data[j] > 0
                && simple_arg(a, tcx, pcx) {
                buf_bytes(t, text);
                sub.push(1);
            }
            else if tcx.p_changed.data[j] == 0 && tcx.p_uses.data[j] == 1 && single
                && complex == 1 {
                if binding_level(a, pcx) < 99 {
                    buf_byte(t, '(');
                    buf_bytes(t, text);
                    buf_byte(t, ')');
                } else {
                    buf_bytes(t, text);
                }
                sub.push(1);
            } else {
                // `let [mut] NAME = ARG;`, NAME renamed when an argument
                // has it
                var name = sym_text(tcx.p_name.data[j]);
                if bytes_is(name, c"self") || named_in_args(args, name, pcx) {
                    name = fresh_name(name, args, tcx, pcx);
                }
                buf_bytes(t, name);
                buf_str(binds, c"let ");
                if tcx.p_changed.data[j] != 0 {
                    buf_str(binds, c"mut ");
                }
                buf_bytes(binds, name);
                buf_str(binds, c" = ");
                buf_bytes(binds, text);
                buf_str(binds, c";\n");
                sub.push(0);
            }
            u_text.push(t);
        }
        // The uses of the parameters, replaced.
        var rs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var re = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var rt = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..tcx.u_start.count {
            let j = tcx.u_param.data[i];
            rs.push(tcx.u_start.data[i]);
            re.push(tcx.u_end.data[i]);
            if shorthand_at(tcx.u_start.data[i], &tcx, pcx) {
                // (0.15: `S { x }` becomes `S { x: ARG }`)
                rt.push(shorthand_text(sym_text(tcx.p_name.data[j]), buf_slice(u_text.data[j])));
            } else {
                rt.push(u_text.data[j]);
            }
        }
        let call_indent = indent_of(pstart(o, pcx), pcx);
        let out = buf_new();
        let stmt = statement_of(o, tcx, pcx);
        if stmt >= 0 && BUFS[binds].len == 0 && tcx.body_locals.count == 0 {
            // A statement of its own (`f(x);`), with no local to keep
            // apart: the body's statements in its place.
            let text = text_with(pcx.nodes[body].start + 1, pcx.nodes[body].end - 1, rs, re, rt);
            let lines = buf_new();
            reindent(lines, trim_blank_lines(buf_slice(text)), call_indent);
            let s = buf_slice(lines);
            let tail = pcx.nodes[body].a;
            buf_bytes(out, skip_indent(trim_blank_lines(s)));
            if tail > 0 && !block_like(tail, pcx) {
                buf_byte(out, ';');
            }
            edit_replace(pstart(o, pcx), statement_end(o, stmt, pcx), out, &pcx);
            return true;
        }
        if single && BUFS[binds].len == 0 {
            // An expression: the tail, in parentheses when it binds
            // looser than the call's place.
            let tail = pcx.nodes[body].a;
            let text = text_with(pcx.nodes[tail].start, pcx.nodes[tail].end, rs, re, rt);
            let parens = expr_level(tail, pcx) < slot_level(o, tcx, pcx);
            if parens {
                buf_byte(out, '(');
            }
            shift_lines(out, buf_slice(text), indent_of(pcx.nodes[tail].start, pcx).len as i64,
                call_indent);
            if parens {
                buf_byte(out, ')');
            }
        } else {
            // A block: the bindings, then the body's lines.
            let inner = buf_new();
            buf_bytes(inner, call_indent);
            buf_str(inner, c"    ");
            buf_str(out, c"{\n");
            reindent(out, buf_slice(binds), buf_slice(inner));
            let text = text_with(pcx.nodes[body].start + 1, pcx.nodes[body].end - 1, rs, re, rt);
            reindent(out, trim_blank_lines(buf_slice(text)), buf_slice(inner));
            buf_bytes(out, call_indent);
            buf_byte(out, '}');
        }
        edit_replace(pstart(o, pcx), pend(o, pcx),
            if in_fstring(o, tcx, pcx) { one_line(out) } else { out }, &pcx);
        true
    }
}

// The statement call o is the whole of (`f(x);`, as written; not a
// block's value), or -1.
fn statement_of(o: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    for p in 1..tcx.program_end {
        if pk(p, pcx) == NodeKind::ExprStmt && pa(p, pcx) == o {
            // (with its `;`)
            var e = pend(o, pcx);
            while SRC[e] == ' ' || SRC[e] == '\t' || SRC[e] == '\n' {
                e += 1;
            }
            return if SRC[e] == ';' { p } else { -1 };
        }
    }
    -1
}

// (0.17) Whether call o is inside an f-string's hole: its text there is
// written on one line.
fn in_fstring(o: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    for p in 1..tcx.program_end {
        if pk(p, pcx) == NodeKind::Interp && pstart(p, pcx) <= pstart(o, pcx)
            && pend(o, pcx) <= pend(p, pcx) {
            return true;
        }
    }
    false
}

// (0.17) Text t on one line: each line break and the indentation after it
// a space; t itself when it has a `//` comment.
fn one_line(t: i64) -> i64 {
    let s = buf_slice(t);
    for i in 1..s.len as i64 {
        if s[i - 1] == '/' && s[i] == '/' {
            return t;
        }
    }
    let out = buf_new();
    var i = 0;
    while i < s.len as i64 {
        if s[i] == '\n' {
            while i + 1 < s.len as i64 && (s[i + 1] == ' ' || s[i + 1] == '\t') {
                i += 1;
            }
            buf_byte(out, ' ');
        } else {
            buf_byte(out, s[i]);
        }
        i += 1;
    }
    out
}

// The end of statement stmt of call o: after its `;`.
fn statement_end(o: i64, stmt: i64, pcx: Ctx<Comp>) -> i64 {
    var e = pend(o, pcx);
    while e < pend(stmt, pcx) && SRC[e] != ';' {
        e += 1;
    }
    if e < pend(stmt, pcx) && SRC[e] == ';' {
        return e + 1;
    }
    e = pend(o, pcx);
    while SRC[e] == ' ' || SRC[e] == '\t' {
        e += 1;
    }
    if SRC[e] == ';' { e + 1 } else { pend(o, pcx) }
}

// Whether checked node n is an expression that stands as a statement
// without `;` (if, match, a block, a loop).
fn block_like(n: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[n].kind;
    k == NodeKind::If || k == NodeKind::Match || k == NodeKind::Block || k == NodeKind::Loop
        || k == NodeKind::While || k == NodeKind::For
}

// FN deleted when nothing but the calls inlined (calls) uses it: its
// text, and the names of the `use` lines importing it. Whether it is.
fn delete_unused(d: i64, calls: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var targets = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        targets.push(d);
        refs_of(targets, &tcx, pcx);
        var imports = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for r in 0..tcx.r_pos.count {
            let pos = tcx.r_pos.data[r];
            if tcx.r_def.data[r] != d || (tcx.r_flags.data[r] & QF_DEF) != 0 {
                continue;
            }
            var inlined = false;
            for i in 0..calls.count {
                let o = calls.data[i];
                if pstart(o, pcx) <= pos && pos < pend(o, pcx) {
                    inlined = true;
                }
            }
            if inlined {
                continue;
            }
            if (tcx.r_flags.data[r] & QF_USE) == 0 {
                return false;
            }
            imports.push(pos);
        }
        delete_lines(line_start(text_start(d, pcx), pcx), item_tail(d, tcx, pcx), &pcx);
        for i in 0..imports.count {
            let pos = imports.data[i];
            for u in 1..pcx.nodes.len() as i64 {
                if pcx.nodes[u].kind != NodeKind::Use || pcx.nodes[u].start > pos
                    || pcx.nodes[u].end <= pos {
                    continue;
                }
                for k in 0..pcx.nodes[u].count {
                    let id = child(u, k, pcx);
                    if pcx.nodes[id].start <= pos && pos < pcx.nodes[id].end {
                        if pcx.nodes[u].count == 1 {
                            delete_lines(line_start(node_head(pcx.nodes[u].start, pcx), pcx),
                                pcx.nodes[u].end, &pcx);
                        } else {
                            remove_use_name(u, k, &pcx);
                        }
                    }
                }
            }
        }
        true
    }
}

// Whether a local of function node cf (a parameter, a binding) is named
// `name`.
fn local_named(cf: i64, name: i64, pcx: Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() {
        let k = pcx.nodes[n].kind;
        if (k == NodeKind::PatBind || k == NodeKind::Param) && pcx.nodes[n].a == name
            && pcx.nodes[n].start >= pcx.nodes[cf].start
            && pcx.nodes[n].end <= pcx.nodes[cf].end {
            return true;
        }
    }
    false
}

// An argument put in as it is: a name (not one the body declares), a
// literal.
fn simple_arg(a: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let k = pk(a, pcx);
        if k == NodeKind::Ident {
            for i in 0..tcx.body_locals.count {
                if tcx.body_locals.data[i] == pa(a, pcx) {
                    return false;
                }
            }
            return true;
        }
        k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Bool
            || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Unit
    }
}

// Whether the checked call n takes the address of its receiver (`v.m()`
// with `self: *T`, v a value).
fn autoref(n: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.nodes[n].count == 0 {
        return false;
    }
    let r = child(n, 0, pcx);
    pcx.nodes[r].kind == NodeKind::Unary && pcx.nodes[r].op == Tok::Amp
        && pcx.nodes[r].start == pcx.nodes[pcx.nodes[r].b].start
        && pcx.nodes[r].end == pcx.nodes[pcx.nodes[r].b].end
}

// Whether every `self` of FN's body (node f) is followed by `.`.
fn self_as_base(f: i64, pcx: Ctx<Comp>) -> bool {
    let body = pcx.nodes[f].c;
    var i = token_at(pcx.nodes[body].start, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i].start < pcx.nodes[body].end {
        if pcx.toks[i].kind == Tok::Ident && bytes_is(sym_text(pcx.toks[i].value as i64), c"self")
            && pcx.toks[i + 1].kind != Tok::Dot {
            return false;
        }
        i += 1;
    }
    true
}

// How tightly the body's value (checked node n) binds: a block-like
// expression (if, match, a block, a loop) as loosely as a binary one, so
// that it stays apart from an operator after it.
fn expr_level(n: i64, pcx: Ctx<Comp>) -> i64 {
    let k = pcx.nodes[n].kind;
    if k == NodeKind::If || k == NodeKind::Match || k == NodeKind::Block || k == NodeKind::Loop
        || k == NodeKind::While
        || k == NodeKind::For {
        return 1;
    }
    binding_level(n, pcx)
}

// The binding level the place of call o needs (0: an argument, a
// statement, a `let`'s value).
fn slot_level(o: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var best = -1;
        var level = 0;
        for p in 1..tcx.program_end {
            if p == o || pstart(p, pcx) > pstart(o, pcx) || pend(p, pcx) < pend(o, pcx) {
                continue;
            }
            if best >= 0 && pend(p, pcx) - pstart(p, pcx) >= pend(best, pcx) - pstart(best, pcx) {
                continue;
            }
            var kids = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var levels = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            expr_slots(p, &kids, &levels, pcx);
            for i in 0..kids.count {
                if kids.data[i] == o {
                    best = p;
                    level = levels.data[i];
                }
            }
        }
        level
    }
}

// `try: PROG query show FILE:LINE` of pos.
fn try_at(pos: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let out = diags(&tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" query show");
    let b = buf_new();
    put_path(b, file_of_pos(pos, pcx), pcx);
    buf_byte(b, ':');
    buf_int(b, line_of(pos, pcx));
    put_word(out, buf_slice(b));
    put_root(out, tcx);
    try_end(out);
}
