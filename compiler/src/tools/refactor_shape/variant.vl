// `refactor variant ENUM`: a variant added (with an arm in each match that
// needs one), removed (with its arms, alternatives and imports) or
// renamed, in the enum and every construction and pattern of it.

use std::alloc::Arena;

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_src, intern, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::Call;
use crate::front::ast::{ARM_SYNTHETIC, NodeKind};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::types::{TyKind, get_enums};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::items::{after_line, indent_of};
use crate::tools::fix::remove_use_name;
use crate::tools::query::{QF_DEF, c_slice, file_line, file_named, resolve_name, root_or_diag};
use crate::tools::query::defs::K_ENUM;
use crate::tools::query::diagnostics::{
    diag, diags, put_cword, put_root, put_word, try_end, write_diags,
};
use crate::tools::query::positions::{enclosing, line_of, line_start, put_loc, put_path, token_at};
use crate::tools::query::refs::put_short;
use crate::tools::refactor_mod::mentions::doc_mentions;
use crate::tools::refactor_shape::{
    comment_head, find_byte, leading_name, list_insert, list_of_node, list_remove, load_and_find,
    newline_in, opt, option_values, orig_of, put_count, refs_of, rest_blank, shape_options,
    starts_line, sym_text, take_args, text_buf, try_query_name, try_refactor, try_show_at,
    usage_error,
};
use crate::tools::refactor_shape::field::{member_def, no_member, rename_refs};
use crate::tools::rewrite::sort_by_start;
use crate::tools::rewrite::parsed::{pa, pb, pchild, pcount, pend, pflags, pk, pstart};

// ---- refactor variant ----

pub fn run_variant(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = variant_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

// Whether checked type t is enum node e's (an instance's of it too).
fn is_enum_of(t: i64, e: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        t > 0 && pcx.types[t as usize].kind == TyKind::Enum
            && (*get_enums().add(pcx.types[t as usize].a as usize)).node == e
    }
}

// The variant names of enum node e: whether `name` is one.
fn variant_named(e: i64, name: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcount(e, pcx) {
        if pa(pchild(e, i, pcx), pcx) == name {
            return true;
        }
    }
    false
}

// Whether pattern p (checked) matches every value: `_`, a binding, an or
// of one.
fn catch_all(p: i64, e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::PatWild {
        return true;
    }
    if k == NodeKind::PatBind {
        // (unchecked: a name of a variant brought by `use` is no binding)
        return pcx.nodes[p as usize].ty != 0 || !variant_named(e, pcx.nodes[p as usize].a, pcx);
    }
    if k == NodeKind::PatOr {
        for i in 0..pcount(p, pcx) {
            if catch_all(pchild(p, i, pcx), e, pcx) {
                return true;
            }
        }
    }
    false
}

// Whether pattern p (as written) names enum node e: `E::V(..)`, a variant
// of e.
fn names_enum(p: i64, e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pk(p, pcx);
    if k == NodeKind::PatVariant {
        return pa(p, pcx) == pcx.nodes[e as usize].a
            || (pa(p, pcx) == 0 && variant_named(e, pb(p, pcx), pcx));
    }
    if k == NodeKind::PatOr {
        for i in 0..pcount(p, pcx) {
            if names_enum(pchild(p, i, pcx), e, pcx) {
                return true;
            }
        }
    }
    false
}

// The matches on enum node e, as written: each once.
fn matches_on(e: i64, out: &mut IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for n in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[n as usize].kind != NodeKind::Match {
                continue;
            }
            let o = orig_of(n, NodeKind::Match, tcx, pcx);
            if o < 0 || seen.get(o + 1) != 0
                || (*pcx.files[file_of_pos(pstart(o, pcx), pcx) as usize].path.add(0)) == b'<' {
                continue;
            }
            let t = pcx.nodes[pcx.nodes[n as usize].a as usize].ty;
            let mut on = is_enum_of(t, e, pcx);
            if t <= 0 {
                for i in 0..pcount(o, pcx) {
                    if names_enum(pa(pchild(o, i, pcx), pcx), e, pcx) {
                        on = true;
                    }
                }
            }
            if on {
                seen.put(o + 1, 1);
                out.push(o);
            }
        }
        sort_by_start(*out, pcx);
    }
}

// The text written before the variant's name in a pattern of match m
// (`Kind::`, `crate::ast::Kind::`), or 0 when its arms name variants
// alone.
fn variant_prefix(m: i64, pcx: &Ctx<Comp>) -> i64 {
    for i in 0..pcount(m, pcx) {
        let mut p = pa(pchild(m, i, pcx), pcx);
        if pk(p, pcx) == NodeKind::PatOr && pcount(p, pcx) > 0 {
            p = pchild(p, 0, pcx);
        }
        if pk(p, pcx) != NodeKind::PatVariant || pa(p, pcx) == 0 {
            continue;
        }
        // (the name after the last `::` before a `(`)
        let mut t = token_at(pstart(p, pcx), pcx);
        let mut name_at: i64 = -1;
        while t < pcx.toks.len() as i64 && pcx.toks[t as usize].start < pend(p, pcx)
            && pcx.toks[t as usize].kind != Tok::LParen {
            if pcx.toks[t as usize].kind == Tok::ColonColon {
                name_at = pcx.toks[t as usize].end;
            }
            t += 1;
        }
        if name_at > pstart(p, pcx) {
            return text_buf(&get_src()[pstart(p, pcx) as usize..name_at as usize]);
        }
    }
    0
}

fn variant_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    unsafe {
        set_command(c.line, tcx);
        pcx.prog = c.prog();
        tcx.tool = c"refactor";
        tcx.sub = c"variant";
        let mut root = 0 as *mut u8;
        let mut words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut opts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let example = c"ENUM --add 'X(i64)' --arm 'EXPR' --dry-run";
        if !take_args(c, shape_options("variant"), &mut root, &mut words, &mut opts, tcx, pcx) {
            return 2;
        }
        if words.len() as i64 != 1 {
            return usage_error(if words.len() as i64 == 0 { c"an ENUM is needed" }
                else { c"one ENUM at a time" }, example, tcx, pcx);
        }
        let add = opt(opts, c"--add", false);
        let arm = opt(opts, c"--arm", false);
        let remove = opt(opts, c"--remove", false);
        let rename = opt(opts, c"--rename", false);
        let actions = (add != 0 as *mut u8) as i64 + (remove != 0 as *mut u8) as i64 + (rename
            != 0 as *mut u8) as i64;
        if actions != 1 {
            return usage_error(c"one of --add, --remove, --rename", example, tcx, pcx);
        }
        if (arm != 0 as *mut u8 || opt(opts, c"--arm-in", false) != 0 as *mut u8)
            && add == 0 as *mut u8 {
            return usage_error(c"--arm and --arm-in go with --add", example, tcx, pcx);
        }
        let name = c_slice((words[0]) as *mut u8);
        tcx.root_given = root;
        root = root_or_diag(root, tcx.sub, name, true, tcx, pcx);
        if root == 0 as *mut u8 {
            return 2;
        }
        let mut status: i64 = 0;
        let d = load_and_find(root, name, 1 << K_ENUM, c"enum", &mut status, tcx, pcx, wgx);
        if d < 0 {
            return status;
        }
        let e = pcx.defs[d as usize].node;
        let fqn = sym_text(pcx.defs[d as usize].fqn, pcx);
        let what = buf_new();
        if add != 0 as *mut u8 {
            let text = c_slice(add);
            let vname = leading_name(text, pcx);
            if vname < 0 {
                return usage_error(c"--add takes the variant: 'X', 'X(T, ...)', 'X { a: T, ... }'",
                    example, tcx, pcx);
            }
            if variant_named(e, vname, pcx) {
                let x = diag(c"error", c"refactor.clash", tcx);
                buf_bytes(x, fqn);
                buf_str(x, c" has a variant '");
                buf_bytes(x, sym_text(vname, pcx));
                buf_str(x, c"' already\n");
                return 1;
            }
            // (its fields: the commas between its parentheses, plus one)
            let mut fields: i64 = 0;
            let open = find_byte(text, b'(');
            // (0.17) `X { a: T }`: its arms match it as `X { .. }`
            let brace = find_byte(text, b'{');
            let named = brace >= 0 && (open < 0 || brace < open);
            if open >= 0 && !named {
                fields = 1;
                let mut depth: i64 = 0;
                for i in open + 1..text.len() as i64 {
                    let c = text[i as usize];
                    if c == b'(' || c == b'[' || c == b'<' {
                        depth += 1;
                    } else if c == b')' || c == b']' || c == b'>' {
                        depth -= 1;
                    } else if c == b',' && depth == 0 {
                        fields += 1;
                    }
                }
            }
            let mut ms = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            matches_on(e, &mut ms, tcx, pcx);
            let mut open_ms = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for i in 0..ms.len() as i64 {
                let m = (ms[i as usize]);
                let mut covered = false;
                for j in 0..pcount(m, pcx) {
                    let a = pchild(m, j, pcx);
                    if pb(a, pcx) == 0 && catch_all(pa(a, pcx), e, pcx) {
                        covered = true;
                    }
                }
                if !covered {
                    open_ms.push(m);
                }
            }
            // (0.14) Each match's arm: the first --arm-in naming it (the
            // function it is in, or FILE:LINE of a line of it), else --arm.
            let mut arms = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for i in 0..open_ms.len() as i64 {
                arms.push(0);
            }
            if !site_arms(opts, open_ms, &mut arms, fqn, tcx, pcx) {
                return 1;
            }
            let mut missing = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for i in 0..open_ms.len() as i64 {
                if (arms[i as usize]) == 0 {
                    (arms[i as usize]) = arm as i64;
                }
                if (arms[i as usize]) == 0 {
                    missing.push((open_ms[i as usize]));
                }
            }
            if missing.len() as i64 > 0 {
                let x = diag(c"error", c"refactor.non-exhaustive", tcx);
                put_count(x, missing.len() as i64, c"match", c"matches");
                buf_str(x, c" on ");
                buf_bytes(x, fqn);
                buf_str(x, c" would not cover ");
                buf_bytes(x, sym_text(vname, pcx));
                buf_str(x, c"; nothing written\n");
                return non_exhaustive(fqn, text, missing, opts, tcx, pcx);
            }
            list_of_node(e, tcx, pcx);
            list_insert(pcount(e, pcx), text, tcx, pcx);
            for i in 0..open_ms.len() as i64 {
                let m = (open_ms[i as usize]);
                let pat = buf_new();
                let prefix = variant_prefix(m, pcx);
                if prefix != 0 {
                    buf_bytes(pat, buf_slice(prefix));
                } else {
                    buf_bytes(pat, fqn);
                    buf_str(pat, c"::");
                }
                buf_bytes(pat, sym_text(vname, pcx));
                if named {
                    buf_str(pat, c" { .. }");
                } else if fields > 0 {
                    buf_byte(pat, b'(');
                    for k in 0..fields {
                        buf_str(pat, if k > 0 { c", _" } else { c"_" });
                    }
                    buf_byte(pat, b')');
                }
                buf_str(pat, c" => ");
                buf_str(pat, (arms[i as usize]) as *mut u8);
                insert_arm(m, buf_slice(pat), pcx);
            }
            buf_str(what, c"added variant ");
            buf_bytes(what, text);
            buf_str(what, c" to ");
            buf_bytes(what, fqn);
            if open_ms.len() as i64 > 0 {
                buf_str(what, c", an arm in ");
                put_count(what, open_ms.len() as i64, c"match", c"matches");
            }
        } else if remove != 0 as *mut u8 {
            let vname = intern(c_slice(remove), pcx);
            let mut k: i64 = -1;
            for i in 0..pcount(e, pcx) {
                if pa(pchild(e, i, pcx), pcx) == vname {
                    k = i;
                }
            }
            if k < 0 {
                return no_member(d, e, remove, c"variant", tcx, pcx);
            }
            let vnode = pchild(e, k, pcx);
            let vd = member_def(d, vname, pcx);
            // Constructed: refused.
            for n in 1..pcx.nodes.len() {
                if pcx.nodes[n].kind == NodeKind::VariantLit
                    && pcx.variants[pcx.nodes[n].a as usize].node == vnode {
                    let x = diag(c"error", c"refactor.constructed", tcx);
                    buf_bytes(x, sym_text(pcx.defs[vd as usize].fqn, pcx));
                    buf_str(x, c" is constructed at ");
                    put_loc(x, pcx.nodes[n].start, pcx);
                    buf_str(x, c"; change those first\n");
                    try_query_name(c"refs", sym_text(pcx.defs[vd as usize].fqn, pcx), tcx, pcx);
                    return 1;
                }
            }
            // Matched: its arms go (an or loses it).
            let mut arms: i64 = 0;
            let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
            for n in 1..pcx.nodes.len() as i64 {
                if pcx.nodes[n as usize].kind != NodeKind::PatVariant || pcx.nodes[n as usize].x < 0
                    || pcx.nodes[n as usize].ty == 0
                    || pcx.variants[pcx.nodes[n as usize].x as usize].node != vnode {
                    continue;
                }
                let mut p = orig_of(n, NodeKind::PatVariant, tcx, pcx);
                if p < 0 {
                    p = orig_of(n, NodeKind::PatBind, tcx, pcx);
                }
                if p < 0 || seen.get(p + 1) != 0 {
                    continue;
                }
                seen.put(p + 1, 1);
                let r = remove_pattern(p, tcx, pcx);
                if r != 0 {
                    let x = diag(c"error",
                        if r == 1 { c"refactor.nested" } else { c"refactor.if-let" }, tcx);
                    buf_bytes(x, sym_text(pcx.defs[vd as usize].fqn, pcx));
                    buf_str(x,
                        if r == 1 { c" is matched inside another pattern at " }
                        else { c" is matched by an `if let` or `while let` at " });
                    put_loc(x, pstart(p, pcx), pcx);
                    buf_str(x, c"; change it first\n");
                    try_show_at(pstart(p, pcx), tcx, pcx);
                    return 1;
                }
                arms += 1;
            }
            // Imported: the name goes from its `use`.
            let mut targets = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            targets.push(vd);
            refs_of(targets, tcx, pcx);
            for r in 0..tcx.r_pos.len() as i64 {
                if ((tcx.r_flags[r as usize]) & QF_DEF) != 0
                    || enclosing((tcx.r_pos[r as usize]), tcx, pcx) >= 0 {
                    continue;
                }
                remove_import((tcx.r_pos[r as usize]), tcx, pcx);
            }
            list_of_node(e, tcx, pcx);
            list_remove(k, tcx, pcx);
            if pcount(e, pcx) > k + 1 && fieldless_cast(e, pcx) {
                let x = diag(c"warning", c"refactor.discriminant", tcx);
                buf_bytes(x, fqn);
                buf_str(x, c" is cast to an integer somewhere: the variants after ");
                buf_bytes(x, sym_text(vname, pcx));
                buf_str(x, c" change their numbers\n");
            }
            buf_str(what, c"removed variant ");
            buf_bytes(what, sym_text(vname, pcx));
            buf_str(what, c" of ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, arms, c"arm", c"arms");
        } else {
            let old = intern(c_slice(rename), pcx);
            let new = intern(c_slice(opt(opts, c"--rename", true)), pcx);
            if !variant_named(e, old, pcx) {
                return no_member(d, e, rename, c"variant", tcx, pcx);
            }
            if variant_named(e, new, pcx) {
                let x = diag(c"error", c"refactor.clash", tcx);
                buf_bytes(x, fqn);
                buf_str(x, c" has a variant '");
                buf_bytes(x, sym_text(new, pcx));
                buf_str(x, c"' already\n");
                return 1;
            }
            let mut targets = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            targets.push(member_def(d, old, pcx));
            refs_of(targets, tcx, pcx);
            let n = rename_refs(old, new, tcx, pcx);
            doc_mentions(targets, old, sym_text(new, pcx), tcx, pcx);
            buf_str(what, c"renamed variant ");
            buf_bytes(what, sym_text(old, pcx));
            buf_str(what, c" to ");
            buf_bytes(what, sym_text(new, pcx));
            buf_str(what, c" of ");
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, n - 1, c"use", c"uses");
        }
        apply_edit(buf_slice(what), root, tcx, pcx)
    }
}

// (0.14) The arms of `--arm-in SITE EXPR` options: each match of ms that
// SITE names (the function, or any item, it is in; or `FILE:LINE` of a
// line of it) gets EXPR in arms (the first that names it). False after a
// diagnostic: SITE names nothing, or no match of ms.
fn site_arms(opts: IntVec, ms: IntVec, arms: &mut IntVec, fqn: &[u8], tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i < opts.len() as i64 {
            let a = (opts[i as usize]) as *mut u8;
            let n = option_values(shape_options("variant"), a);
            if !streq(a, c"--arm-in") {
                i += n + 1;
                continue;
            }
            let site = c_slice((opts[(i + 1) as usize]) as *mut u8);
            let expr = (opts[(i + 2) as usize]);
            i += 3;
            let mut line: i64 = 0;
            let fl = file_line(site, &mut line);
            let mut file: i64 = -1;
            let mut defs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            if fl >= 0 {
                file = file_named(&site[0..fl as usize], pcx);
            } else if !resolve_name(tcx.sub, site, &mut defs, tcx, pcx) {
                return false;
            }
            let mut hit = false;
            for k in 0..ms.len() as i64 {
                let m = (ms[k as usize]);
                let mut named = false;
                if fl >= 0 {
                    named = file >= 0 && file_of_pos(pstart(m, pcx), pcx) == file
                        && line >= line_of(pstart(m, pcx), pcx)
                        && line <= line_of(pend(m, pcx) - 1, pcx);
                }
                for j in 0..defs.len() as i64 {
                    let d = (defs[j as usize]);
                    if pcx.defs[d as usize].start <= pstart(m, pcx)
                        && pstart(m, pcx) < pcx.defs[d as usize].end {
                        named = true;
                    }
                }
                if named {
                    hit = true;
                    if (arms[k as usize]) == 0 {
                        (arms[k as usize]) = expr;
                    }
                }
            }
            if !hit {
                let x = diag(c"error", c"refactor.no-site", tcx);
                buf_str(x, c"--arm-in ");
                buf_bytes(x, site);
                buf_str(x, c" names no match on ");
                buf_bytes(x, fqn);
                buf_str(x, c" that needs an arm; nothing written\n");
                put_sites(ms, tcx, pcx);
                return false;
            }
        }
        true
    }
}

// The matches of ms, one per line on stdout: `FILE:LINE:COL<TAB>ITEM`.
fn put_sites(ms: IntVec, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        for i in 0..ms.len() as i64 {
            let m = (ms[i as usize]);
            put_loc(out, pstart(m, pcx), pcx);
            buf_byte(out, b'\t');
            let x = enclosing(pstart(m, pcx), tcx, pcx);
            if x >= 0 {
                put_short(out, pcx.defs[x as usize].fqn, pcx);
            }
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
    }
}

// The site of match m for `--arm-in`: the item it is in (as `query refs`
// writes it) when that holds no other match of ms and is a plain path,
// else `FILE:LINE`.
fn put_site(out: i64, m: i64, ms: IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let x = enclosing(pstart(m, pcx), tcx, pcx);
        let mut alone = x >= 0;
        for i in 0..ms.len() as i64 {
            let o = (ms[i as usize]);
            if o != m && enclosing(pstart(o, pcx), tcx, pcx) == x {
                alone = false;
            }
        }
        if alone {
            let b = buf_new();
            put_short(b, pcx.defs[x as usize].fqn, pcx);
            let s = buf_slice(b);
            if find_byte(s, b'<') < 0 && find_byte(s, b' ') < 0 {
                put_word(out, s);
                return;
            }
        }
        let b = buf_new();
        put_path(b, file_of_pos(pstart(m, pcx), pcx), pcx);
        buf_byte(b, b':');
        buf_int(b, line_of(pstart(m, pcx), pcx));
        put_word(out, buf_slice(b));
    }
}

// After `error refactor.non-exhaustive`: the matches without an arm (on
// stdout), and the commands that give them one: `--arm` (when no
// `--arm-in` was given), and the command given with an `--arm-in` for
// each. The exit status.
fn non_exhaustive(fqn: &[u8], text: &[u8], missing: IntVec, opts: IntVec, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        put_sites(missing, tcx, pcx);
        // (0.17: one query showing them all)
        let shows = diags(tcx);
        buf_str(shows, c"try:");
        put_cword(shows, pcx.prog);
        buf_str(shows, c" query show");
        for i in 0..missing.len() as i64 {
            let at = buf_new();
            put_loc(at, pstart((missing[i as usize]), pcx), pcx);
            let s = buf_slice(at);
            let mut e = s.len() as i64;
            while e > 0 && s[(e - 1) as usize] != b':' {
                e -= 1;
            }
            buf_byte(shows, b' ');
            buf_bytes(shows, &s[0..(e - 1) as usize]);
        }
        put_root(shows, tcx);
        try_end(shows);
        let given = opt(opts, c"--arm-in", false) != 0 as *mut u8;
        if !given {
            let out = try_refactor(fqn, tcx, pcx);
            buf_str(out, c" --add");
            put_word(out, text);
            buf_str(out, c" --arm 'EXPR' --dry-run");
            put_root(out, tcx);
            try_end(out);
        }
        let out = try_refactor(fqn, tcx, pcx);
        buf_str(out, c" --add");
        put_word(out, text);
        let mut i: i64 = 0;
        while i < opts.len() as i64 {
            let a = (opts[i as usize]) as *mut u8;
            let n = option_values(shape_options("variant"), a);
            if streq(a, c"--arm-in") {
                buf_str(out, c" --arm-in");
                put_word(out, c_slice((opts[(i + 1) as usize]) as *mut u8));
                put_word(out, c_slice((opts[(i + 2) as usize]) as *mut u8));
            }
            i += n + 1;
        }
        for i in 0..missing.len() as i64 {
            buf_str(out, c" --arm-in");
            put_site(out, (missing[i as usize]), missing, tcx, pcx);
            buf_str(out, c" 'EXPR'");
        }
        buf_str(out, c" --dry-run");
        put_root(out, tcx);
        try_end(out);
        1
    }
}

// The arm `text` (`PATTERN => EXPR`) after the last arm of match m.
fn insert_arm(m: i64, text: &[u8], pcx: &mut Ctx<Comp>) {
    let n = pcount(m, pcx);
    if n == 0 {
        return;
    }
    let last = pchild(m, n - 1, pcx);
    let e = pend(last, pcx);
    let ends = get_src()[(e - 1) as usize] == b',' || get_src()[(e - 1) as usize] == b'}';
    let b = buf_new();
    if starts_line(pstart(last, pcx)) && newline_in(e, pend(m, pcx) - 1) {
        if !ends {
            edit_replace(e, e, text_buf(c_slice(c",")), pcx);
        }
        buf_bytes(b, indent_of(pstart(last, pcx), pcx));
        buf_bytes(b, text);
        buf_str(b, c",\n");
        let at = after_line(e, pcx);
        edit_replace(at, at, b, pcx);
        return;
    }
    // (on the line of the last: with a comma after it when it has one)
    buf_str(b, if ends { c" " } else { c", " });
    buf_bytes(b, text);
    if ends {
        buf_byte(b, b',');
    }
    edit_replace(e, e, b, pcx);
}

// Removes pattern p (as written) from its arm: the arm, or the
// alternative of an or. 0 done, 1 p is inside another pattern, 2 the
// match is an `if let`'s.
fn remove_pattern(p: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    for m in 1..tcx.program_end {
        if pk(m, pcx) != NodeKind::Match {
            continue;
        }
        for i in 0..pcount(m, pcx) {
            let a = pchild(m, i, pcx);
            let pat = pa(a, pcx);
            let direct = pat == p;
            let mut alt: i64 = -1;
            if pk(pat, pcx) == NodeKind::PatOr {
                for j in 0..pcount(pat, pcx) {
                    if pchild(pat, j, pcx) == p {
                        alt = j;
                    }
                }
            }
            if !direct && alt < 0 {
                continue;
            }
            for j in 0..pcount(m, pcx) {
                if (pflags(pchild(m, j, pcx), pcx) & ARM_SYNTHETIC) != 0 {
                    return 2;
                }
            }
            if alt >= 0 && pcount(pat, pcx) > 1 {
                // `A | V | B`: V and a `|` next to it
                if alt + 1 < pcount(pat, pcx) {
                    edit_replace(pstart(p, pcx), pstart(pchild(pat, alt + 1, pcx), pcx), buf_new(),
                        pcx);
                } else {
                    edit_replace(pend(pchild(pat, alt - 1, pcx), pcx), pend(p, pcx), buf_new(),
                        pcx);
                }
                return 0;
            }
            // The arm: its lines, or its text and what separates it.
            let s = pstart(a, pcx);
            let e = pend(a, pcx);
            if starts_line(s) && rest_blank(e) {
                edit_replace(comment_head(s, pcx), after_line(e, pcx), buf_new(), pcx);
            } else if i + 1 < pcount(m, pcx) {
                edit_replace(s, pstart(pchild(m, i + 1, pcx), pcx), buf_new(), pcx);
            } else if i > 0 {
                edit_replace(pend(pchild(m, i - 1, pcx), pcx), e, buf_new(), pcx);
            } else {
                edit_replace(s, e, buf_new(), pcx);
            }
            return 0;
        }
    }
    1
}

// Removes the import at pos (a name of a `use`).
fn remove_import(pos: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for u in 1..tcx.program_end {
        if pk(u, pcx) != NodeKind::Use || pos < pstart(u, pcx) || pos >= pend(u, pcx) {
            continue;
        }
        for k in 0..pcount(u, pcx) {
            let id = pchild(u, k, pcx);
            if pstart(id, pcx) <= pos && pos < pend(id, pcx) {
                if pcount(u, pcx) == 1 {
                    edit_replace(line_start(pstart(u, pcx), pcx), after_line(pend(u, pcx), pcx),
                        buf_new(), pcx);
                } else {
                    remove_use_name(u, k, pcx);
                }
                return;
            }
        }
    }
}

// Whether a value of enum node e is cast (`as`) somewhere.
fn fieldless_cast(e: i64, pcx: &Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() {
        if pcx.nodes[n].kind == NodeKind::Cast
            && is_enum_of(pcx.nodes[pcx.nodes[n].a as usize].ty, e, pcx) {
            return true;
        }
    }
    false
}
