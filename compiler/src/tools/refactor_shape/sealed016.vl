// `fix --only alloc016`, the fields: 0.16 seals std's Vec, Buf and
// HashMap (#[sealed]: their fields are private to std), so a 0.15
// program's reads of their fields become the methods that return the
// same (`v.len` -> `v.len()`, `v.cap` -> `v.capacity()`, `v.ptr` ->
// `v.as_slice().ptr`, `m.len` -> `m.len()`). A write (`v.len = 0`,
// `v.len += 1`), or a field with no such method, is left: `error
// fix.alloc016-manual`, with where it is.

use crate::base::{buf_bytes, buf_str, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::check::collect::find_generic_method;
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, within_std};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::types::{TyKind, find_method, struct_type};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::{put_loc, token_at};
use crate::tools::refactor_shape::{orig_of, sym_text, text_buf, try_show_at};
use crate::tools::rewrite::parsed::{pa, pend, pstart};

// Whether token k assigns to what is before it (`=`, `+=`, ...).
fn assigns(k: i64, pcx: &Ctx<Comp>) -> bool {
    if k >= pcx.toks.len() as i64 {
        return false;
    }
    let t = pcx.toks[k as usize].kind;
    t == Tok::Eq || t == Tok::PlusEq || t == Tok::MinusEq || t == Tok::StarEq
        || t == Tok::SlashEq || t == Tok::PercentEq || t == Tok::AmpEq || t == Tok::PipeEq
        || t == Tok::CaretEq || t == Tok::ShlEq || t == Tok::ShrEq
}

// What a read of field `name` of std's sealed struct s is now: the method
// call's text (after the dot), or an empty slice when there is none.
fn method_for(s: i64, name: i64, pcx: &mut Ctx<Comp>) -> &'static [u8] {
    let (text, method) = if name == intern_c(c"len", pcx) { ("len()", intern_c(c"len", pcx)) }
        else if name == intern_c(c"cap", pcx) { ("capacity()", intern_c(c"capacity", pcx)) }
        else if name
        == intern_c(c"ptr", pcx) { ("as_slice().ptr", intern_c(c"as_slice", pcx)) }
        else { ("", 0) };
    if method == 0 {
        return b"";
    }
    let has = find_method(struct_type(s, pcx), method, pcx) >= 0
        || (pcx.structs[s as usize].tmpl != 0
            && find_generic_method(pcx.structs[s as usize].tmpl, method, pcx) >= 0);
    if has { text.as_bytes() } else { b"" }
}

// The edits of the field reads; their number. The writes and the fields
// with no method are errors left (alloc016's `left`).
pub fn sealed_field_edits(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut fixes: i64 = 0;
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        // (y: 0 a struct's field, 1 through a pointer, 2 a slice's)
        if pcx.nodes[n as usize].kind != NodeKind::FieldAccess || pcx.nodes[n as usize].y > 1 {
            continue;
        }
        let mut t = pcx.nodes[pcx.nodes[n as usize].a as usize].ty;
        if t <= 0 {
            continue;
        }
        if pcx.nodes[n as usize].y == 1 && pcx.types[t as usize].kind == TyKind::Ptr {
            t = pcx.types[t as usize].a;
        }
        if pcx.types[t as usize].kind != TyKind::Struct {
            continue;
        }
        let s = pcx.types[t as usize].a;
        let s0 = if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl - 1 }
            else { s };
        // (0.26.0: a field std keeps private, not marked `pub`)
        if !within_std(pcx.structs[s0 as usize].module, pcx) || pcx.std_module < 0
            || pcx.nodes[n as usize].x < 0
            || pcx.nodes[n as usize].x >= pcx.nodes[pcx.structs[s0 as usize].node as usize].count
            || (
                pcx.nodes[
                    child(pcx.structs[s0 as usize].node, pcx.nodes[n as usize].x, pcx) as usize].p
                    & ITEM_PUBLIC)
            != 0 {
            continue;
        }
        let o = orig_of(n, NodeKind::FieldAccess, tcx, pcx);
        if o < 0 || seen.get(o + 1) != 0 || in_std(pstart(o, pcx), pcx) {
            continue;
        }
        seen.put(o + 1, 1);
        let name = pcx.nodes[n as usize].b;
        // (the name: the last such identifier between the base and o's end)
        let mut k: i64 = -1;
        let mut i = token_at(pend(pa(o, pcx), pcx), pcx);
        while i >= 0 && i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < pend(o, pcx) {
            if pcx.toks[i as usize].kind == Tok::Ident
                && pcx.toks[i as usize].value as i64 == name {
                k = i;
            }
            i += 1;
        }
        if k < 0 {
            continue;
        }
        let text = method_for(s, name, pcx);
        if assigns(k + 1, pcx) || text.len() == 0 {
            let e = left(c"fix.alloc016-manual", tcx);
            buf_str(e,
                if text.len() == 0 { c"a read of field '" }
                else { c"a write of field '" });
            buf_bytes(e, sym_text(name, pcx));
            buf_str(e, c"' at ");
            put_loc(e, pcx.toks[k as usize].start, pcx);
            buf_str(e, c": std's ");
            buf_bytes(e,
                sym_text(pcx.structs[(if pcx.structs[s as usize].tmpl
                    != 0 { pcx.structs[s as usize].tmpl - 1 }
                    else { s }) as usize].name, pcx));
            buf_str(e,
                c" keeps its fields private (0.16): they change only through its methods (push, clear, truncate, reserve, ...)\n");
            try_show_at(pcx.toks[k as usize].start, tcx, pcx);
            continue;
        }
        edit_replace(pcx.toks[k as usize].start, pcx.toks[k as usize].end, text_buf(text), pcx);
        fixes += 1;
    }
    fixes
}

// Starts an error of the fix (a function or site it left).
pub fn left(code: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    tcx.shape_left += 1;
    diag(c"error", code, tcx)
}

pub fn in_std(pos: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: a file's path is the loader's C string (*u8).
    // SAFETY: file_of_pos(pos) is the file holding pos, a FILES index; its path
    // is a NUL-terminated string of at least its NUL, so byte 0 is in bounds.
    unsafe { (*pcx.files[file_of_pos(pos, pcx) as usize].path.add(0)) == b'<' }
}
