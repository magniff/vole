// `refactor table X [--count X_COUNT] [--cap X_CAP] [--alloc PATH]`
// (0.25.4, docs/design/modernize-0254.md step 3): a table kept as a raw
// pointer, a count and a capacity,
//
//   static var X: *T = 0 as *T;  static var X_COUNT: i64 = 0;  static var X_CAP: i64 = 0;
//
// grown by base::grow, becomes `static var X: Vec<T, Comp> =
// Vec::new_in(Comp {});`. Every use the checker resolved is placed:
//
//   X = grow(X, X_COUNT, &X_CAP);       gone (a Vec grows itself)
//   X[X_COUNT] = v; ... X_COUNT += 1;   X.push(v); ...  (a `let n = X_COUNT;`
//                                       between the grow and the store stays;
//                                       a read of X_COUNT between the store and
//                                       the increment is `X.len() as i64 - 1`)
//   X_COUNT (read)                      X.len() as i64 (0.26.2: a length is a usize)
//   X_COUNT = 0                         X.clear()
//   X_COUNT -= k                        X.truncate(X.len() - k as usize)
//   let m = X_COUNT; ... X_COUNT = m    let m = X.len() as i64; ... X.truncate(m as usize) (0.25.5)
//   X[i], X[i].f, X[i] = v, X[a..b]     as they are
//
// and X_COUNT's and X_CAP's statics and their imports go. A use it cannot
// place (`&X[i]`, a raw pointer into the table; X passed or assigned;
// X_CAP read; any other write of X_COUNT; a call between a store and its
// increment that reads X_COUNT; 0.25.5: a call in an index of X that may
// grow X) is listed, and nothing is changed.
//
// (0.27.0) X may be a struct's field, `cx.x: *T` with `cx.x_count` (or
// the singular's: `structs`, `struct_count`) and `cx.x_cap` in the same
// struct (the compilation context's tables, base::ctx::Ctx): it becomes
// `x: Vec<T, A>`, A the struct's last type parameter, and
// `Vec::new_in(Comp {})` in the struct's literals; the count's and the
// capacity's fields go with their comments and initializers, and every
// use is placed as a static's, `cx.` kept (tests/refactor/table270.t).

use std::alloc::Arena;

use crate::base::{buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_src, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::Call;
use crate::front::ast::{BLOCK_UNSAFE, Node, NodeKind};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::parser::exprs::infix_left_bp;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::items::after_line;
use crate::tools::query::{QF_DEF, QF_INIT, QF_USE, c_slice, root_or_diag};
use crate::tools::query::defs::{
    Def, K_FIELD, K_FN, K_IMPL_METHOD, K_METHOD, K_STATIC, K_TRAIT_FN, bytes_eq,
};
use crate::tools::query::diagnostics::{
    diag, diags, put_cword, put_root, put_word, try_end, write_diags,
};
use crate::tools::query::positions::{line_start, put_loc};
use crate::tools::refactor_move::imports::{emit_use_edits, remove_use_names};
use crate::tools::refactor_shape::{
    load_and_find, opt, put_count, refs_of, shape_options, starts_line, sym_text, take_args,
    text_buf, usage_error,
};
use crate::tools::rewrite::parsed::{
    binding_level, expr_slots, pa, pb, pc, pchild, pcount, pd, pend, pflags, pk, pop, pstart,
};

// ---- What is read ----
//
// Each accessor reads one of the compiler's raw tables at an index the
// loaded program gave (a node, token, definition or position of it).

fn src_text(a: i64, b: i64) -> &'static [u8] {
    &get_src()[a as usize..b as usize]
}

fn src_byte(p: i64) -> u8 {
    get_src()[p as usize]
}

fn def_of(d: i64, pcx: &Ctx<Comp>) -> Def {
    pcx.defs[d as usize]
}

fn def_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.defs.len() as i64
}

fn checked(n: i64, pcx: &Ctx<Comp>) -> Node {
    pcx.nodes[n as usize]
}

fn node_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.nodes.len() as i64
}

fn fn_node(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a Call node's resolution (x - 1), an index of FNS.
    unsafe { pcx.fns[f as usize].node }
}

// ---- The table being changed ----

// A use refused: where, why (a C string; X, X_COUNT and X_CAP are
// the table's names), the code shown (node; 0: none).
fn refuse(pos: i64, why: *mut u8, node: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if node > 0 {
        refuse_span(pos, why, pstart(node, pcx), pend(node, pcx), tcx);
    } else {
        refuse_span(pos, why, 0, 0, tcx);
    }
}

// A use refused, the code shown SRC[a..b) (none when b <= a); a
// problem region_problem found shows its own code.
fn refuse_span(pos: i64, why: *mut u8, a: i64, b: i64, tcx: &mut Tcx<Comp>) {
    tcx.rf_pos.push(if tcx.prob_b > tcx.prob_a { tcx.prob_a } else { pos });
    tcx.rf_why.push(why);
    tcx.rf_a.push(if tcx.prob_b > tcx.prob_a { tcx.prob_a } else { a });
    tcx.rf_b.push(if tcx.prob_b > tcx.prob_a { tcx.prob_b } else { b });
    tcx.prob_a = 0;
    tcx.prob_b = 0;
}

fn edit(a: i64, b: i64, text: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if !edit_replace(a, b, text_buf(text), pcx) {
        tcx.table_edit_failed = true;
    }
}

fn parent(n: i64, tcx: &Tcx<Comp>) -> i64 {
    if n <= 0 || n >= tcx.table_parent.len() as i64 { 0 } else { tcx.table_parent[n as usize] }
}

// The parents of the program's parsed nodes, from the expressions inside
// each (rewrite's expr_slots: statements, blocks, operands, arguments).
fn build_parents(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    tcx.table_parent.clear();
    for _ in 0..tcx.program_end + 1 {
        tcx.table_parent.push(0);
    }
    let mut kids = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut levels = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for n in 1..tcx.program_end {
        kids.count = 0;
        levels.count = 0;
        expr_slots(n, &mut kids, &mut levels, pcx);
        for i in 0..kids.count {
            let c = kids.get(i);
            if c > 0 && c < tcx.program_end {
                tcx.table_parent[c as usize] = n;
            }
        }
        // (a function's body; a path's segments)
        if pk(n, pcx) == NodeKind::Fn && pc(n, pcx) > 0 && pc(n, pcx) < tcx.program_end {
            tcx.table_parent[pc(n, pcx) as usize] = n;
        }
        if pk(n, pcx) == NodeKind::Path {
            for i in 0..pcount(n, pcx) {
                let c = pchild(n, i, pcx);
                if c > 0 && c < tcx.program_end {
                    tcx.table_parent[c as usize] = n;
                }
            }
        }
        if pk(n, pcx) == NodeKind::Ident {
            tcx.ident_at.put(pstart(n, pcx) + 1, n + 1);
        }
        // (0.27.0: a field's name, where a reference to it is)
        if pk(n, pcx) == NodeKind::FieldAccess {
            tcx.ident_at.put(name_pos(n, pcx) + 1, n + 1);
        }
    }
}

// The parsed Ident naming `sym` at pos, or (0.27.0, a field's table) the
// FieldAccess whose name is there; -1 when none.
fn ident_at(pos: i64, sym: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let n = tcx.ident_at.get(pos + 1) - 1;
    if n > 0 && name_sym(n, pcx) == sym { n } else { -1 }
}

// The symbol name node n says: an Ident's, or a FieldAccess's field.
fn name_sym(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if pk(n, pcx) == NodeKind::FieldAccess { pb(n, pcx) } else { pa(n, pcx) }
}

// The name node n ends with: n (an Ident, or 0.27.0 a field `cx.x`), a
// path's last segment (`crate::m::X`), or -1.
fn last_seg(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 {
        return -1;
    }
    if pk(n, pcx) == NodeKind::Ident || pk(n, pcx) == NodeKind::FieldAccess {
        return n;
    }
    if pk(n, pcx) == NodeKind::Path && pcount(n, pcx) > 0
        && pk(pchild(n, pcount(n, pcx) - 1, pcx), pcx) == NodeKind::Ident {
        return pchild(n, pcount(n, pcx) - 1, pcx);
    }
    -1
}

// Whether parsed node n names sym (an Ident, a path ending in it, or a
// field of that name).
fn is_name(n: i64, sym: i64, pcx: &Ctx<Comp>) -> bool {
    let s = last_seg(n, pcx);
    s > 0 && name_sym(s, pcx) == sym
}

// The expression the name at Ident id is: id, or the path it ends.
fn expr_of(id: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let p = parent(id, tcx);
    if p > 0 && pk(p, pcx) == NodeKind::Path && last_seg(p, pcx) == id { p } else { id }
}

// The position of the name expression e names X_COUNT or X by (a
// field's: its name, after the `.`).
fn name_pos(e: i64, pcx: &Ctx<Comp>) -> i64 {
    let s = last_seg(e, pcx);
    if pk(s, pcx) == NodeKind::FieldAccess {
        return pend(s, pcx) - sym_text(pb(s, pcx), pcx).len() as i64;
    }
    pstart(s, pcx)
}

// Into t: X as name expression e writes it (`crate::m::X` for a path).
fn put_x(t: i64, e: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    buf_bytes(t, src_text(pstart(e, pcx), name_pos(e, pcx)));
    buf_bytes(t, sym_text(tcx.x_sym, pcx));
}

fn is_int(n: i64, v: i64, pcx: &Ctx<Comp>) -> bool {
    n > 0 && pk(n, pcx) == NodeKind::Int && pa(n, pcx) == v
}

// `X = grow(X, X_COUNT, &X_CAP)` (Assign node a).
fn is_grow(a: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if pk(a, pcx) != NodeKind::Assign || pop(a, pcx) != Tok::Eq
        || !is_name(pb(a, pcx), tcx.x_sym, pcx) {
        return false;
    }
    let call = pc(a, pcx);
    if pk(call, pcx) != NodeKind::Call
        || !is_name(pa(call, pcx), intern("grow".as_bytes(), pcx), pcx)
        || pcount(call, pcx) != 3 {
        return false;
    }
    let cap = pchild(call, 2, pcx);
    is_name(pchild(call, 0, pcx), tcx.x_sym, pcx) && is_name(pchild(call, 1, pcx), tcx.c_sym, pcx)
        && pk(cap, pcx) == NodeKind::Unary && pop(cap, pcx) == Tok::Amp
        && is_name(pb(cap, pcx), tcx.k_sym, pcx)
}

// The statement node e is the expression of (an ExprStmt with its `;`),
// and its block and index there; false when it is none.
fn stmt_of(e: i64, stmt: &mut i64, block: &mut i64, index: &mut i64, tcx: &Tcx<Comp>,
    pcx: &Ctx<Comp>) -> bool {
    let s = parent(e, tcx);
    if s <= 0 || pk(s, pcx) != NodeKind::ExprStmt || pa(s, pcx) != e {
        return false;
    }
    let b = parent(s, tcx);
    if b <= 0 || pk(b, pcx) != NodeKind::Block {
        return false;
    }
    for i in 0..pcount(b, pcx) {
        if pchild(b, i, pcx) == s {
            *stmt = s;
            *block = b;
            *index = i;
            return true;
        }
    }
    false
}

// The assignment statement s is (`a = b;`, `a += b;`), or 0.
fn assign_of(s: i64, pcx: &Ctx<Comp>) -> i64 {
    if pk(s, pcx) != NodeKind::ExprStmt || pk(pa(s, pcx), pcx) != NodeKind::Assign {
        return 0;
    }
    pa(s, pcx)
}

// `X_COUNT += 1;` (statement s).
fn is_increment(s: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let a = assign_of(s, pcx);
    a > 0 && pop(a, pcx) == Tok::PlusEq && is_name(pb(a, pcx), tcx.c_sym, pcx)
        && is_int(pc(a, pcx), 1, pcx)
}

// A local statement s sets to X_COUNT (`let n = X_COUNT;`, `n =
// X_COUNT;`): its name, or -1.
fn count_local(s: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if pk(s, pcx) == NodeKind::Let && pk(pa(s, pcx), pcx) == NodeKind::PatBind
        && is_name(pc(s, pcx), tcx.c_sym, pcx) {
        return pa(pa(s, pcx), pcx);
    }
    let a = assign_of(s, pcx);
    if a > 0 && pop(a, pcx) == Tok::Eq && pk(pb(a, pcx), pcx) == NodeKind::Ident
        && is_name(pc(a, pcx), tcx.c_sym, pcx) {
        return pa(pb(a, pcx), pcx);
    }
    -1
}

// Whether statement s is the store `X[I] = v;`, I X_COUNT (when
// `count_ok`) or one of the locals.
fn is_store(s: i64, locals: &Vec<i64, Comp>, count_ok: bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let a = assign_of(s, pcx);
    if a <= 0 || pop(a, pcx) != Tok::Eq || pk(pb(a, pcx), pcx) != NodeKind::Index
        || !is_name(pa(pb(a, pcx), pcx), tcx.x_sym, pcx) {
        return false;
    }
    let ix = pb(pb(a, pcx), pcx);
    if count_ok && is_name(ix, tcx.c_sym, pcx) {
        return true;
    }
    for l in locals.iter().copied() {
        if pk(ix, pcx) == NodeKind::Ident && pa(ix, pcx) == l {
            return true;
        }
    }
    false
}

// The increment after statement k of block b: in b, or after the `unsafe`
// block b is a statement of; -1.
fn increment_after(b: i64, k: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    for i in k + 1..pcount(b, pcx) {
        if is_increment(pchild(b, i, pcx), tcx, pcx) {
            return pchild(b, i, pcx);
        }
    }
    if (pflags(b, pcx) & BLOCK_UNSAFE) == 0 {
        return -1;
    }
    let mut stmt: i64 = 0;
    let mut outer: i64 = 0;
    let mut index: i64 = 0;
    if !stmt_of(b, &mut stmt, &mut outer, &mut index, tcx, pcx) {
        return -1;
    }
    for i in index + 1..pcount(outer, pcx) {
        if is_increment(pchild(outer, i, pcx), tcx, pcx) {
            return pchild(outer, i, pcx);
        }
    }
    -1
}

// The deletion of statement s: its lines when it has them to itself.
fn delete_stmt(s: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let a = pstart(s, pcx);
    let e = pend(s, pcx);
    let mut p = e;
    while src_byte(p) == b' ' || src_byte(p) == b'\t' {
        p += 1;
    }
    let alone = starts_line(a) && (src_byte(p) == b'\n' || src_byte(p) == 0);
    if alone {
        edit(line_start(a, pcx), after_line(e, pcx), "".as_bytes(), tcx, pcx);
    } else {
        edit(a, p, "".as_bytes(), tcx, pcx);
    }
}

// ---- The functions that read X_COUNT ----
//
// A call between a store and its increment saw the old count; with
// push, the new length. The functions whose code names X_COUNT (and
// those that call them, through every call the checker resolved) are
// the ones where that differs.

// The functions' spans, sorted by start (keys: start * 2^20 + def).
fn collect_fns(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    tcx.fn_keys.clear();
    for d in 0..def_count(pcx) {
        let df = def_of(d, pcx);
        if df.kind == K_FN || df.kind == K_METHOD || df.kind == K_IMPL_METHOD
            || df.kind == K_TRAIT_FN {
            tcx.fn_keys.push(df.start * 1048576 + d);
            if tcx.fn_ends.get(df.start + 1) < df.end + 1 {
                tcx.fn_ends.put(df.start + 1, df.end + 1);
            }
        }
    }
    tcx.fn_keys.sort_unstable();
}

// The start of the function whose text holds pos, or -1.
fn fn_at(pos: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = tcx.fn_keys.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if tcx.fn_keys[mid as usize] / 1048576 <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return -1;
    }
    let start = tcx.fn_keys[(lo - 1) as usize] / 1048576;
    if pos < tcx.fn_ends.get(start + 1) - 1 { start } else { -1 }
}

fn call_edges(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for n in 1..node_count(pcx) {
        let nd = checked(n, pcx);
        if nd.kind != NodeKind::Call || nd.x <= 0 {
            continue;
        }
        let from = fn_at(nd.start, tcx);
        let to = fn_at(checked(fn_node(nd.x - 1, pcx), pcx).start, tcx);
        if from >= 0 && to >= 0 && from != to {
            tcx.callers.push(from);
            tcx.table_callees.push(to);
        }
    }
}

// READS: the functions naming X_COUNT, then their callers, to a fixpoint.
fn reading_fns(count_refs: &Vec<i64, Comp>, tcx: &mut Tcx<Comp>) {
    for p in count_refs.iter().copied() {
        let f = fn_at(p, tcx);
        if f >= 0 {
            tcx.reads.put(f + 1, 1);
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..tcx.callers.len() {
            if tcx.reads.get(tcx.table_callees[i] + 1) != 0
                && tcx.reads.get(tcx.callers[i] + 1) == 0 {
                tcx.reads.put(tcx.callers[i] + 1, 1);
                changed = true;
            }
        }
    }
}

// (0.25.5) GROWS: the functions writing X itself (`X = grow(..)`, `X =
// reserve(..)`) or X_COUNT (`+= 1`, `= 0`, `-= k`), at write positions
// (parsed: the left of an assignment), then their callers, to a fixpoint.
fn growing_fns(writes: &Vec<i64, Comp>, tcx: &mut Tcx<Comp>) {
    for p in writes.iter().copied() {
        let f = fn_at(p, tcx);
        if f >= 0 {
            tcx.grows.put(f + 1, 1);
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..tcx.callers.len() {
            if tcx.grows.get(tcx.table_callees[i] + 1) != 0
                && tcx.grows.get(tcx.callers[i] + 1) == 0 {
                tcx.grows.put(tcx.callers[i] + 1, 1);
                changed = true;
            }
        }
    }
}

// (0.25.5) Whether parsed name expression e (of X or X_COUNT) is written:
// the left of an assignment.
fn written(e: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let par = parent(e, tcx);
    par > 0 && pk(par, pcx) == NodeKind::Assign && pb(par, pcx) == e
}

// (0.25.5) A call in SRC[a..b) that may grow X: one to a function of GROWS,
// or one the checker did not resolve. Its start, or -1; PROB_A, PROB_B: the
// call.
fn growing_call(a: i64, b: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    for n in 1..node_count(pcx) {
        let nd = checked(n, pcx);
        if nd.kind != NodeKind::Call || nd.start < a || nd.start >= b {
            continue;
        }
        let grows = if nd.x <= 0 { true } else {
            let to = fn_at(checked(fn_node(nd.x - 1, pcx), pcx).start, tcx);
            to >= 0 && tcx.grows.get(to + 1) != 0
        };
        if grows {
            tcx.prob_a = nd.start;
            tcx.prob_b = nd.end;
            return nd.start;
        }
    }
    -1
}

// Whether a `break` or `continue` at parsed node n leaves SRC[a..):
// unlabelled, its loop starts there.
fn leaves(n: i64, a: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if pa(n, pcx) != 0 {
        return true;
    }
    let mut p = parent(n, tcx);
    while p > 0 {
        let k = pk(p, pcx);
        if k == NodeKind::Loop || k == NodeKind::While || k == NodeKind::For {
            return pstart(p, pcx) < a;
        }
        if k == NodeKind::Closure || k == NodeKind::Fn {
            return true;
        }
        p = parent(p, tcx);
    }
    true
}

// What in SRC[a..b) makes the push differ from the store and the
// increment it replaces: leaving the span (`return`, `?`, a `break` or
// `continue` out of it; when `exits`), a call that reaches code naming
// X_COUNT (it sees the count changed at a different time). The reason, or
// 0; at: where.
fn region_problem(a: i64, b: i64, exits: bool, at: &mut i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    if exits {
        for n in 1..tcx.program_end {
            let s = pstart(n, pcx);
            if s < a || s >= b {
                continue;
            }
            let k = pk(n, pcx);
            if k == NodeKind::Return || k == NodeKind::Try
                || ((k == NodeKind::Break || k == NodeKind::Continue) && leaves(n, a, tcx, pcx)) {
                *at = s;
                tcx.prob_a = s;
                tcx.prob_b = pend(n, pcx);
                return c"a return, ? or break between the store and `X_COUNT += 1` (the push and the count would part)";
            }
        }
    }
    for n in 1..node_count(pcx) {
        let nd = checked(n, pcx);
        if nd.kind != NodeKind::Call || nd.start < a || nd.start >= b {
            continue;
        }
        if nd.x <= 0 {
            *at = nd.start;
            tcx.prob_a = nd.start;
            tcx.prob_b = nd.end;
            return c"a call the tool cannot follow between the store and `X_COUNT += 1` (if it reads X_COUNT it sees another value)";
        }
        let to = fn_at(checked(fn_node(nd.x - 1, pcx), pcx).start, tcx);
        if to >= 0 && tcx.reads.get(to + 1) != 0 {
            *at = nd.start;
            tcx.prob_a = nd.start;
            tcx.prob_b = nd.end;
            return c"a call between the store and `X_COUNT += 1` reaches code naming X_COUNT (it would see the count changed): move the `+= 1` next to the store first";
        }
    }
    0 as *mut u8
}

// ---- The sequences ----
//
// A grow, the store `X[I] = v;` and the increment `X_COUNT += 1;`, in one
// block (the increment may follow the unsafe block the store is in): I is
// X_COUNT, or a local set to it before (`let n = X_COUNT;`, `n =
// X_COUNT;`). The increment may come before the store, I then a local;
// between them a read of X_COUNT is `X.len() + 1`; between the store and
// a later increment, `X.len() - 1`.

fn region_add(pos: i64, tcx: &Tcx<Comp>) -> i64 {
    for i in 0..tcx.rg_start.len() {
        if pos >= tcx.rg_start[i] && pos < tcx.rg_end[i] {
            return tcx.rg_add[i];
        }
    }
    0
}

// The sequence of block b from statement k (the grow when `grow`, else
// the store) on: its edits, true; false with why and at.
fn take_seq(b: i64, k: i64, grow: bool, why: &mut *mut u8, at: &mut i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let mut locals: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut local_end: i64 = -1;
    for i in 0..k {
        let l = count_local(pchild(b, i, pcx), tcx, pcx);
        if l >= 0 {
            locals.push(l);
            local_end = pend(pchild(b, i, pcx), pcx);
        }
    }
    let mut inc: i64 = -1;
    let mut store: i64 = -1;
    let mut j = if grow { k + 1 } else { k };
    while j < pcount(b, pcx) {
        let s = pchild(b, j, pcx);
        if is_store(s, &locals, inc < 0, tcx, pcx) {
            store = s;
            break;
        }
        if inc < 0 && grow && is_increment(s, tcx, pcx) {
            inc = s;
        } else if inc < 0 {
            let l = count_local(s, tcx, pcx);
            if l >= 0 {
                locals.push(l);
                local_end = pend(s, pcx);
            }
        }
        j += 1;
    }
    if store < 0 {
        *why = if inc >= 0 {
            c"a grow and `X_COUNT += 1` with no store `X[n] = v;` after them (n set to X_COUNT before the increment)"
        } else {
            c"a grow not followed by `X[X_COUNT] = v;` in its block (or `let n = X_COUNT;` and `X[n] = v;`)"
        };
        return false;
    }
    // (the store's names are this sequence's, placed or refused)
    let target = pb(pa(store, pcx), pcx);
    tcx.table_done.put(name_pos(pa(target, pcx), pcx) + 1, 1);
    if is_name(pb(target, pcx), tcx.c_sym, pcx) {
        tcx.table_done.put(name_pos(pb(target, pcx), pcx) + 1, 1);
    }
    let mut add: i64 = -1;
    let mut ra: i64 = 0;
    let mut rb: i64 = 0;
    if inc >= 0 {
        // (the increment first: up to the end of the store, whose value
        // read the raised count)
        ra = pend(inc, pcx);
        rb = pend(store, pcx);
        add = 1;
    } else {
        inc = increment_after(b, j, tcx, pcx);
        if inc < 0 {
            *why = c"a store at X_COUNT with no `X_COUNT += 1;` after it (in its block, or after the unsafe block it is in)";
            *at = pstart(store, pcx);
            return false;
        }
        ra = pend(store, pcx);
        rb = pstart(inc, pcx);
    }
    tcx.table_done.put(name_pos(pb(pa(inc, pcx), pcx), pcx) + 1, 1);
    let problem = region_problem(ra, rb, true, at, tcx, pcx);
    if problem != 0 as *mut u8 {
        *why = problem;
        return false;
    }
    // (a local's value is the count until the store: nothing between may
    // push or read the table's count)
    if local_end >= 0 {
        let p = region_problem(local_end, pstart(store, pcx), false, at, tcx, pcx);
        if p != 0 as *mut u8 {
            *why = p;
            return false;
        }
    }
    // (a local index: set only to X_COUNT in the block before the store)
    let ix = pb(pb(pa(store, pcx), pcx), pcx);
    if pk(ix, pcx) == NodeKind::Ident && !is_name(ix, tcx.c_sym, pcx) {
        for n in 1..tcx.program_end {
            if pk(n, pcx) == NodeKind::Assign && pstart(n, pcx) >= pstart(b, pcx)
                && pstart(n, pcx) < pstart(store, pcx)
                && is_name(pb(n, pcx), pa(ix, pcx), pcx)
                && !(pop(n, pcx) == Tok::Eq && is_name(pc(n, pcx), tcx.c_sym, pcx)) {
                *at = pstart(n, pcx);
                *why = c"the store's index is changed between its `= X_COUNT` and the store";
                return false;
            }
        }
    }
    // X[I] = v  ->  X.push(v)
    let a = pa(store, pcx);
    let value = pc(a, pcx);
    let open = buf_new();
    put_x(open, pa(target, pcx), tcx, pcx);
    buf_str(open, c".push(");
    edit(pstart(a, pcx), pstart(value, pcx), buf_slice(open), tcx, pcx);
    edit(pend(value, pcx), pend(value, pcx), ")".as_bytes(), tcx, pcx);
    delete_stmt(inc, tcx, pcx);
    tcx.rg_start.push(ra);
    tcx.rg_end.push(rb);
    tcx.rg_add.push(add);
    tcx.n_push += 1;
    true
}

// The imports of base::grow (base::reserve) in the files where no call of
// it is left.
fn drop_grow_imports(path: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if tcx.grows_gone.count == 0 {
        return;
    }
    let sym = intern(path, pcx);
    let mut g: i64 = -1;
    for d in 0..def_count(pcx) {
        if def_of(d, pcx).fqn == sym {
            g = d;
        }
    }
    if g < 0 {
        return;
    }
    let mut targets = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    targets.push(g);
    refs_of(targets, tcx, pcx);
    // (file + 1 -> 1: a call of grow is left there)
    let mut used = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for r in 0..tcx.r_pos.count {
        let p = tcx.r_pos.get(r);
        if tcx.r_def.get(r) == g && (tcx.r_flags.get(r) & (QF_DEF | QF_USE)) == 0
            && tcx.grows_gone.get(p + 1) == 0 {
            used.put(file_of_pos(p, pcx) + 1, 1);
        }
    }
    let mut gone_in = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for r in 0..tcx.r_pos.count {
        let p = tcx.r_pos.get(r);
        if tcx.r_def.get(r) == g && (tcx.r_flags.get(r) & QF_USE) != 0
            && used.get(file_of_pos(p, pcx) + 1) == 0
            && gone_in.get(p + 1) == 0 {
            gone_in.put(p + 1, 1);
            drop_use(p, tcx, pcx);
        }
    }
}

// The grow guard around a grow (Assign a): `if X_COUNT >= X_CAP { X =
// grow(..); }`, the If node, or 0.
fn guard_of(a: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut stmt: i64 = 0;
    let mut b: i64 = 0;
    let mut k: i64 = 0;
    if !stmt_of(a, &mut stmt, &mut b, &mut k, tcx, pcx) || pcount(b, pcx) != 1 || pa(b, pcx) != 0 {
        return 0;
    }
    let f = parent(b, tcx);
    if f <= 0 || pk(f, pcx) != NodeKind::If || pb(f, pcx) != b || pc(f, pcx) != 0 {
        return 0;
    }
    let cond = pa(f, pcx);
    if pk(cond, pcx) == NodeKind::Binary && pop(cond, pcx) == Tok::GtEq
        && is_name(pb(cond, pcx), tcx.c_sym, pcx)
        && is_name(pc(cond, pcx), tcx.k_sym, pcx) {
        return f;
    }
    0
}

// The grow whose target is X at name expression e, with the store after
// it.
fn take_grow(e: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let a = parent(e, tcx);
    if a <= 0 || !is_grow(a, tcx, pcx) || pb(a, pcx) != e {
        return;
    }
    let call = pc(a, pcx);
    // (its names are this grow's, refused or not)
    tcx.table_done.put(name_pos(e, pcx) + 1, 1);
    tcx.table_done.put(name_pos(pchild(call, 0, pcx), pcx) + 1, 1);
    tcx.table_done.put(name_pos(pchild(call, 1, pcx), pcx) + 1, 1);
    tcx.table_done.put(name_pos(pb(pchild(call, 2, pcx), pcx), pcx) + 1, 1);
    let guard = guard_of(a, tcx, pcx);
    if guard > 0 {
        tcx.table_done.put(name_pos(pb(pa(guard, pcx), pcx), pcx) + 1, 1);
        tcx.table_done.put(name_pos(pc(pa(guard, pcx), pcx), pcx) + 1, 1);
    }
    let mut stmt: i64 = 0;
    let mut b: i64 = 0;
    let mut k: i64 = 0;
    if !stmt_of(if guard > 0 { guard } else { a }, &mut stmt, &mut b, &mut k, tcx, pcx) {
        refuse(pstart(a, pcx), c"a grow that is not a statement of its own", a, tcx, pcx);
        return;
    }
    let mut why = 0 as *mut u8;
    let mut at = pstart(a, pcx);
    if !take_seq(b, k, true, &mut why, &mut at, tcx, pcx) {
        refuse(at, why, a, tcx, pcx);
        return;
    }
    delete_stmt(stmt, tcx, pcx);
    tcx.grows_gone.put(pstart(pa(call, pcx), pcx) + 1, 1);
}

// `X = reserve(X, &X_CAP, n)` (base::reserve: room for n in all) at
// name expression e: `X.reserve((n - X.len() as i64).max(0) as usize)`
// (Vec's: room for so many more; none when that is not above 0).
fn take_reserve(e: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let a = parent(e, tcx);
    if a <= 0 || pk(a, pcx) != NodeKind::Assign || pop(a, pcx) != Tok::Eq || pb(a, pcx) != e {
        return;
    }
    let call = pc(a, pcx);
    if pk(call, pcx) != NodeKind::Call
        || !is_name(pa(call, pcx), intern("reserve".as_bytes(), pcx), pcx)
        || pcount(call, pcx) != 3 {
        return;
    }
    let cap = pchild(call, 1, pcx);
    let n = pchild(call, 2, pcx);
    if !is_name(pchild(call, 0, pcx), tcx.x_sym, pcx) || pk(cap, pcx) != NodeKind::Unary
        || pop(cap, pcx) != Tok::Amp
        || !is_name(pb(cap, pcx), tcx.k_sym, pcx) {
        return;
    }
    tcx.table_done.put(name_pos(e, pcx) + 1, 1);
    tcx.table_done.put(name_pos(pchild(call, 0, pcx), pcx) + 1, 1);
    tcx.table_done.put(name_pos(pb(cap, pcx), pcx) + 1, 1);
    let t = buf_new();
    put_x(t, e, tcx, pcx);
    // (n is an i64: what is missing, none below 0, as a usize)
    buf_str(t, c".reserve((");
    edit(pstart(a, pcx), pstart(n, pcx), buf_slice(t), tcx, pcx);
    let rest = buf_new();
    buf_str(rest, c" - ");
    put_x(rest, e, tcx, pcx);
    buf_str(rest, c".len() as i64).max(0) as usize)");
    if binding_level(n, pcx) < infix_left_bp(Tok::Minus) / 2 {
        edit(pstart(n, pcx), pstart(n, pcx), "(".as_bytes(), tcx, pcx);
        edit(pend(n, pcx), pend(n, pcx), ")".as_bytes(), tcx, pcx);
    }
    edit(pend(n, pcx), pend(a, pcx), buf_slice(rest), tcx, pcx);
    tcx.grows_gone.put(pstart(pa(call, pcx), pcx) + 1, 1);
    tcx.n_reserve += 1;
}

// A store `X[X_COUNT] = v` with no grow before it (a table allocated
// once): a push too, when its increment follows.
fn take_store(e: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let ix = parent(e, tcx);
    if ix <= 0 || pk(ix, pcx) != NodeKind::Index || pa(ix, pcx) != e
        || !is_name(pb(ix, pcx), tcx.c_sym, pcx) {
        return;
    }
    let a = parent(ix, tcx);
    if a <= 0 || pk(a, pcx) != NodeKind::Assign || pop(a, pcx) != Tok::Eq || pb(a, pcx) != ix {
        return;
    }
    let mut stmt: i64 = 0;
    let mut b: i64 = 0;
    let mut k: i64 = 0;
    if !stmt_of(a, &mut stmt, &mut b, &mut k, tcx, pcx) {
        return;
    }
    let mut why = 0 as *mut u8;
    let mut at = pstart(a, pcx);
    if !take_seq(b, k, false, &mut why, &mut at, tcx, pcx) {
        refuse(at, why, a, tcx, pcx);
        tcx.table_done.put(name_pos(e, pcx) + 1, 1);
        tcx.table_done.put(name_pos(pb(ix, pcx), pcx) + 1, 1);
    }
}

// ---- Each other use ----

// X at name expression e: an index (`X[i]`, `X[i].f`, `X[i] = v`, a
// slice) stays; a pointer into it or X itself is refused.
fn place_x(e: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let ix = parent(e, tcx);
    if ix <= 0 || pk(ix, pcx) != NodeKind::Index || pa(ix, pcx) != e {
        refuse(name_pos(e, pcx),
            c"the table itself used (passed, assigned, compared, freed): a Vec is not its pointer",
            if ix > 0 { ix } else { e }, tcx, pcx);
        return;
    }
    // (0.25.5) a call in the index that may grow X (GROWS)
    if growing_call(pstart(pb(ix, pcx), pcx), pend(pb(ix, pcx), pcx), tcx, pcx) >= 0 {
        refuse(pstart(ix, pcx),
            c"a call in X[i]'s index that may grow X (X's buffer and length are read before it): take the index into a `let` first",
            ix, tcx, pcx);
        return;
    }
    // (the place an element starts: up through fields and indices)
    let mut place = ix;
    let mut up = parent(place, tcx);
    while up > 0 && (pk(up, pcx) == NodeKind::FieldAccess || pk(up, pcx) == NodeKind::TupleField
        || pk(up, pcx) == NodeKind::Index) && pa(up, pcx) == place {
        place = up;
        up = parent(place, tcx);
    }
    if up > 0 && pk(up, pcx) == NodeKind::Unary && pop(up, pcx) == Tok::Amp
        && pb(up, pcx) == place {
        refuse(pstart(up, pcx),
            c"a pointer into the table (`&X[i]`): kept past a push it dangles; take the index, or the element by value",
            up, tcx, pcx);
    }
}

// (0.25.5) Whether the local `name` is a mark of X_COUNT for the assignment
// `X_COUNT = name` (parsed node asg): its one binding in asg's function is
// `let name = X_COUNT;` before it, and nothing assigns it. The rollback
// (`let first = TOK_COUNT; ... TOK_COUNT = first;`) is then a truncate:
// the count only grows from the mark, by pushes, until it is set back.
fn is_mark(asg: i64, name: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let f = fn_at(pstart(asg, pcx), tcx);
    if f < 0 {
        return false;
    }
    let end = tcx.fn_ends.get(f + 1) - 1;
    let mut found = false;
    for n in 1..tcx.program_end {
        let s = pstart(n, pcx);
        if s < f || s >= end {
            continue;
        }
        let k = pk(n, pcx);
        if k == NodeKind::Let && pk(pa(n, pcx), pcx) == NodeKind::PatBind
            && pa(pa(n, pcx), pcx) == name {
            if s >= pstart(asg, pcx) || !is_name(pc(n, pcx), tcx.c_sym, pcx) || found {
                return false;
            }
            found = true;
        } else if k == NodeKind::PatBind && pa(n, pcx) == name && parent(n, tcx) > 0
            && pk(parent(n, tcx), pcx) != NodeKind::Let {
            // (bound by a pattern elsewhere: a match arm, a for)
            return false;
        }
        else if k == NodeKind::Assign && pk(pb(n, pcx), pcx) == NodeKind::Ident
            && pa(pb(n, pcx), pcx) == name {
            return false;
        }
    }
    found
}

// X_COUNT at name expression e: a read is `X.len()` (one more or less in
// a sequence's span), `= 0` clear, `-= k` truncate, `= mark` (a local
// set to X_COUNT before, is_mark) truncate(mark); other writes refused.
fn place_count(e: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let par = parent(e, tcx);
    if par > 0 && pk(par, pcx) == NodeKind::Assign && pb(par, pcx) == e {
        let op = pop(par, pcx);
        let v = pc(par, pcx);
        if op == Tok::Eq && is_int(v, 0, pcx) {
            let t = buf_new();
            put_x(t, e, tcx, pcx);
            buf_str(t, c".clear()");
            edit(pstart(par, pcx), pend(par, pcx), buf_slice(t), tcx, pcx);
            tcx.n_clear += 1;
            return;
        }
        if op == Tok::MinusEq {
            // (the count is an i64, a Vec's length a usize: k converts)
            let paren = binding_level(v, pcx) < 12;
            let t = buf_new();
            put_x(t, e, tcx, pcx);
            buf_str(t, c".truncate(");
            put_x(t, e, tcx, pcx);
            buf_str(t, if paren { c".len() - (" } else { c".len() - " });
            edit(pstart(par, pcx), pstart(v, pcx), buf_slice(t), tcx, pcx);
            edit(pend(v, pcx), pend(v, pcx),
                if paren { ") as usize)".as_bytes() } else { " as usize)".as_bytes() }, tcx, pcx);
            tcx.n_trunc += 1;
            return;
        }
        if op == Tok::Eq && pk(v, pcx) == NodeKind::Ident && is_mark(par, pa(v, pcx), tcx, pcx) {
            // (0.25.5) a rollback to a mark read before: a truncate
            let t = buf_new();
            put_x(t, e, tcx, pcx);
            buf_str(t, c".truncate(");
            buf_bytes(t, src_text(pstart(v, pcx), pend(v, pcx)));
            buf_str(t, c" as usize)");
            edit(pstart(par, pcx), pend(par, pcx), buf_slice(t), tcx, pcx);
            tcx.n_trunc += 1;
            return;
        }
        refuse(name_pos(e, pcx), if op == Tok::PlusEq && is_int(v, 1, pcx) {
            c"`X_COUNT += 1` with no store at X_COUNT next to it (a push needs the element)"
        } else {
            c"X_COUNT written (a Vec's length changes by push, clear and truncate only)"
        }, par, tcx, pcx);
        return;
    }
    if par > 0 && pk(par, pcx) == NodeKind::Unary && pop(par, pcx) == Tok::Amp {
        refuse(pstart(par, pcx), c"&X_COUNT: the count's address (a Vec's length has none)", par,
            tcx, pcx);
        return;
    }
    tcx.n_len += 1;
    // (the count is an i64, a Vec's length a usize: the read converts,
    // in parentheses where its place binds tighter than `as`)
    let mut need: i64 = 0;
    if par > 0 {
        let mut kids = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut levels = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        expr_slots(par, &mut kids, &mut levels, pcx);
        for i in 0..kids.count {
            if kids.get(i) == e {
                need = levels.get(i);
            }
        }
    }
    let t = buf_new();
    put_x(t, e, tcx, pcx);
    buf_str(t, c".len() as i64");
    let add = region_add(name_pos(e, pcx), tcx);
    if add == 0 {
        if need > 12 {
            let p = buf_new();
            buf_byte(p, b'(');
            buf_bytes(p, buf_slice(t));
            buf_byte(p, b')');
            edit(pstart(e, pcx), pend(e, pcx), buf_slice(p), tcx, pcx);
        } else {
            edit(pstart(e, pcx), pend(e, pcx), buf_slice(t), tcx, pcx);
        }
        return;
    }
    // (`X_COUNT + 1` after the push, `X_COUNT - 1` after the increment:
    // the length)
    let undo = if add < 0 { Tok::Plus } else { Tok::Minus };
    if par > 0 && pk(par, pcx) == NodeKind::Binary && pop(par, pcx) == undo && pb(par, pcx) == e
        && is_int(pc(par, pcx), 1, pcx) {
        edit(pstart(par, pcx), pend(par, pcx), buf_slice(t), tcx, pcx);
        return;
    }
    buf_str(t, if add < 0 { c" - 1" } else { c" + 1" });
    if need > infix_left_bp(Tok::Minus) / 2 {
        let p = buf_new();
        buf_byte(p, b'(');
        buf_bytes(p, buf_slice(t));
        buf_byte(p, b')');
        edit(pstart(e, pcx), pend(e, pcx), buf_slice(p), tcx, pcx);
    } else {
        edit(pstart(e, pcx), pend(e, pcx), buf_slice(t), tcx, pcx);
    }
}

// The `use` naming a static at pos: its name dropped from its list.
fn drop_use(pos: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for u in 1..tcx.program_end {
        let nd = checked(u, pcx);
        if nd.kind != NodeKind::Use || pos < nd.start || pos >= nd.end {
            continue;
        }
        for k in 0..nd.count {
            let id = crate::front::ast::child(u, k, pcx);
            let c = checked(id, pcx);
            if pos >= c.start && pos < c.end {
                remove_use_names(u, id, tcx);
                return true;
            }
        }
    }
    false
}

// The static item d (X_COUNT, X_CAP) deleted, with its lines.
fn delete_static(d: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let df = def_of(d, pcx);
    let mut e = df.end;
    while src_byte(e) == b' ' || src_byte(e) == b'\t' {
        e += 1;
    }
    if src_byte(e) == b';' {
        e += 1;
    }
    edit(line_start(df.start, pcx), after_line(e - 1, pcx), "".as_bytes(), tcx, pcx);
}

// (0.27.0) The field d (x_count, x_cap) deleted, with its lines: its
// declaration and the comment lines right above it, and its initializer
// in each literal of the struct.
fn delete_field(d: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let df = def_of(d, pcx);
    let mut a = line_start(df.start, pcx);
    while a > 0 {
        let prev = line_start(a - 1, pcx);
        let mut p = prev;
        while src_byte(p) == b' ' || src_byte(p) == b'\t' {
            p += 1;
        }
        if src_byte(p) != b'/' || src_byte(p + 1) != b'/' {
            break;
        }
        a = prev;
    }
    let mut e = df.end;
    while src_byte(e) == b' ' || src_byte(e) == b'\t' {
        e += 1;
    }
    if src_byte(e) == b',' {
        e += 1;
    }
    edit(a, after_line(e - 1, pcx), "".as_bytes(), tcx, pcx);
    let mut inits: Vec<i64, Comp> = Vec::new_in(Comp {});
    field_inits(d, &mut inits, tcx, pcx);
    for fi in inits.iter().copied() {
        let mut p = pend(fi, pcx);
        while src_byte(p) == b' ' || src_byte(p) == b'\t' {
            p += 1;
        }
        if src_byte(p) == b',' {
            p += 1;
        }
        if starts_line(pstart(fi, pcx)) {
            edit(line_start(pstart(fi, pcx), pcx), after_line(p - 1, pcx), "".as_bytes(), tcx,
                pcx);
        } else {
            edit(pstart(fi, pcx), p, "".as_bytes(), tcx, pcx);
        }
    }
}

// (0.27.0) The initializers of field d in the literals of its struct
// (parsed FieldInit nodes), into out.
fn field_inits(d: i64, out: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let df = def_of(d, pcx);
    if df.parent < 0 {
        return;
    }
    let st = def_of(df.parent, pcx).name;
    for n in 1..tcx.program_end {
        if pk(n, pcx) != NodeKind::StructLit || pa(n, pcx) != st {
            continue;
        }
        for i in 0..pcount(n, pcx) {
            let fi = pchild(n, i, pcx);
            if pk(fi, pcx) == NodeKind::FieldInit && pa(fi, pcx) == df.name {
                out.push(fi);
            }
        }
    }
}

// (0.27.0) The allocator a field's Vec names: its struct's last type
// parameter (`A` of `Ctx<A: Allocator>`), or alloc when it has none.
fn field_alloc<'a>(alloc: &'a [u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> &'a [u8] {
    let df = def_of(tcx.x_def, pcx);
    if df.parent < 0 {
        return alloc;
    }
    let g = checked(def_of(df.parent, pcx).node, pcx).g;
    if g <= 0 || checked(g, pcx).count == 0 {
        return alloc;
    }
    let last = crate::front::ast::child(g, checked(g, pcx).count - 1, pcx);
    sym_text(checked(last, pcx).a, pcx)
}

// The references to X, X_COUNT and X_CAP (deduplicated: a generic
// function's instances share their positions), each with its flags, in
// the lists of its definition.
fn refs_all(xpos: &mut Vec<i64, Comp>, xflags: &mut Vec<i64, Comp>, cpos: &mut Vec<i64, Comp>,
    cflags: &mut Vec<i64, Comp>, kpos: &mut Vec<i64, Comp>, kflags: &mut Vec<i64, Comp>,
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut targets = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    targets.push(tcx.x_def);
    targets.push(tcx.c_def);
    if tcx.k_def >= 0 {
        targets.push(tcx.k_def);
    }
    refs_of(targets, tcx, pcx);
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for r in 0..tcx.r_pos.count {
        let p = tcx.r_pos.get(r);
        let d = tcx.r_def.get(r);
        let key = p * 4 + if d == tcx.x_def { 1 } else if d == tcx.c_def { 2 } else { 3 };
        // (0.27.0: a field's initializers in its struct's literals are the
        // final edits', field_inits)
        if seen.get(key) != 0 || tcx.table_field && (tcx.r_flags.get(r) & QF_INIT) != 0 {
            continue;
        }
        seen.put(key, 1);
        if d == tcx.x_def {
            xpos.push(p);
            xflags.push(tcx.r_flags.get(r));
        } else if d == tcx.c_def {
            cpos.push(p);
            cflags.push(tcx.r_flags.get(r));
        } else if d == tcx.k_def {
            kpos.push(p);
            kflags.push(tcx.r_flags.get(r));
        }
    }
}

// The static named `name` in X's module (or the path given); else the
// one static of that name in the modules below X's (a table's capacity
// kept in the submodule that grows it); or -1.
fn sibling(name: &[u8], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let fqn = sym_text(def_of(tcx.x_def, pcx).fqn, pcx);
    let mut e = fqn.len() as i64;
    // (0.27.0: a field's sibling is its struct's: `m::Ctx.x_count`)
    let sep = if tcx.table_field { b'.' } else { b':' };
    while e > 0 && fqn[(e - 1) as usize] != sep {
        e -= 1;
    }
    let want = buf_new();
    if !has_path(name) {
        buf_bytes(want, &fqn[0..e as usize]);
    }
    buf_bytes(want, name);
    let sym = intern(buf_slice(want), pcx);
    for d in 0..def_count(pcx) {
        let df = def_of(d, pcx);
        if df.kind == (if tcx.table_field { K_FIELD } else { K_STATIC }) && df.fqn == sym {
            return d;
        }
    }
    if has_path(name) || tcx.table_field {
        return -1;
    }
    let short = intern(name, pcx);
    let mut found: i64 = -1;
    for d in 0..def_count(pcx) {
        let df = def_of(d, pcx);
        let path = sym_text(df.fqn, pcx);
        if df.kind == K_STATIC && df.name == short && path.len() as i64 > e
            && bytes_eq(&path[0..e as usize], &fqn[0..e as usize]) {
            if found >= 0 {
                return -1;
            }
            found = d;
        }
    }
    found
}

fn has_path(s: &[u8]) -> bool {
    for i in 1..s.len() as i64 {
        if s[i as usize] == b':' && s[(i - 1) as usize] == b':' {
            return true;
        }
    }
    false
}

// X's name without a trailing S (NODES: NODE), then with: X_COUNT's
// default is the first that names a static (0.27.0: a field's, without
// a trailing s, `structs`: `struct_count`, of the same struct).
fn default_sibling(suffix: &[u8], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let x = sym_text(tcx.x_sym, pcx);
    let last = if x.len() > 1 { x[(x.len() as i64 - 1) as usize] } else { 0 };
    if last == b'S' || tcx.table_field && last == b's' {
        let b = buf_new();
        buf_bytes(b, &x[0..(x.len() as i64 - 1) as usize]);
        buf_bytes(b, suffix);
        let d = sibling(buf_slice(b), tcx, pcx);
        if d >= 0 {
            return d;
        }
    }
    let b = buf_new();
    buf_bytes(b, x);
    buf_bytes(b, suffix);
    sibling(buf_slice(b), tcx, pcx)
}

fn last_segment(s: &[u8]) -> &[u8] {
    let mut i = s.len() as i64;
    while i > 0 && s[(i - 1) as usize] != b':' {
        i -= 1;
    }
    &s[i as usize..]
}

// Whether static node s is `static var NAME: i64 = 0`.
fn zero_i64(s: i64, pcx: &Ctx<Comp>) -> bool {
    let t = pb(s, pcx);
    pd(s, pcx) != 0 && pk(t, pcx) == NodeKind::TyName
        && bytes_eq(sym_text(pa(t, pcx), pcx), "i64".as_bytes()) && is_int(pc(s, pcx), 0, pcx)
}

fn shape_error(d: i64, what: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let e = diag(c"error", c"refactor.table-shape", tcx);
    buf_bytes(e, sym_text(def_of(d, pcx).fqn, pcx));
    buf_str(e, c" is not ");
    buf_str(e, what);
    buf_byte(e, b'\n');
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" query show");
    put_word(out, sym_text(def_of(d, pcx).fqn, pcx));
    put_root(out, tcx);
    try_end(out);
    1
}

// The refusals, one line each, sorted by position.
fn report_refusals(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..tcx.rf_pos.len() as i64 {
        order.push(tcx.rf_pos[i as usize] * 65536 + i);
    }
    order.sort_unstable();
    let e = diag(c"error", c"refactor.table-use", tcx);
    buf_bytes(e, sym_text(def_of(tcx.x_def, pcx).fqn, pcx));
    buf_str(e, c": ");
    put_count(e, tcx.rf_pos.len() as i64, c"use", c"uses");
    buf_str(e, c" refactor table cannot place; nothing changed\n");
    let out = diags(tcx);
    let mut shown: i64 = 0;
    for key in order.iter().copied() {
        let i = key % 65536;
        shown += 1;
        if shown > 200 {
            buf_str(out, c"... and ");
            buf_int_of(out, tcx.rf_pos.len() as i64 - 200);
            buf_str(out, c" more\n");
            break;
        }
        put_loc(out, tcx.rf_pos[i as usize], pcx);
        buf_str(out, c": ");
        if tcx.rf_b[i as usize] > tcx.rf_a[i as usize] {
            put_snippet(out, tcx.rf_a[i as usize], tcx.rf_b[i as usize]);
            buf_str(out, c": ");
        }
        put_reason(out, tcx.rf_why[i as usize], tcx, pcx);
        buf_byte(out, b'\n');
    }
    // (by reason, when there are several)
    if tcx.rf_pos.len() > 3 {
        let mut whys: Vec<*mut u8, Comp> = Vec::new_in(Comp {});
        let mut counts: Vec<i64, Comp> = Vec::new_in(Comp {});
        for w in tcx.rf_why.iter().copied() {
            let mut found = false;
            for k in 0..whys.len() {
                if whys[k] == w {
                    counts[k] += 1;
                    found = true;
                }
            }
            if !found {
                whys.push(w);
                counts.push(1);
            }
        }
        for k in 0..whys.len() {
            diag(c"note", c"refactor.table-why", tcx);
            buf_int_of(out, counts[k]);
            buf_str(out, c": ");
            put_reason(out, whys[k], tcx, pcx);
            buf_byte(out, b'\n');
        }
    }
    buf_str(out, c"help: change these by hand (or with rewrite), then run refactor table again\n");
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" query refs");
    put_word(out, sym_text(def_of(tcx.x_def, pcx).fqn, pcx));
    put_root(out, tcx);
    try_end(out);
    1
}

fn buf_int_of(out: i64, n: i64) {
    crate::base::buf_int(out, n);
}

fn word_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// A reason, its words X, X_COUNT and X_CAP the table's names.
fn put_reason(out: i64, why: *mut u8, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let s = c_slice(why);
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let start_ok = i == 0 || !word_byte(s[(i - 1) as usize]);
        let mut w: i64 = 0;
        if start_ok && s[i as usize] == b'X' {
            let mut e = i + 1;
            while e < s.len() as i64 && word_byte(s[e as usize]) {
                e += 1;
            }
            let word = &s[i as usize..e as usize];
            if bytes_eq(word, "X".as_bytes()) {
                buf_bytes(out, sym_text(tcx.x_sym, pcx));
                w = 1;
            } else if bytes_eq(word, "X_COUNT".as_bytes()) {
                buf_bytes(out, sym_text(tcx.c_sym, pcx));
                w = 7;
            } else if bytes_eq(word, "X_CAP".as_bytes()) && tcx.k_sym >= 0 {
                buf_bytes(out, sym_text(tcx.k_sym, pcx));
                w = 5;
            }
        }
        if w == 0 {
            buf_byte(out, s[i as usize]);
            w = 1;
        }
        i += w;
    }
}

// SRC[a..b) on one line, at most 60 bytes.
fn put_snippet(out: i64, a: i64, b: i64) {
    let s = src_text(a, b);
    buf_byte(out, b'`');
    let mut col: i64 = 0;
    let mut space = false;
    for c in s.iter().copied() {
        if col >= 60 {
            buf_str(out, c"...");
            break;
        }
        if c == b'\n' || c == b' ' || c == b'\t' {
            space = true;
            continue;
        }
        if space && col > 0 {
            buf_byte(out, b' ');
            col += 1;
        }
        space = false;
        buf_byte(out, c);
        col += 1;
    }
    buf_byte(out, b'`');
}

// ---- refactor table ----

pub fn run_table(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = table_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

fn table_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    tcx.sub = c"table";
    let mut root = 0 as *mut u8;
    let mut words = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut opts = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let example = c"NODES --dry-run";
    if !take_args(c, shape_options("table"), &mut root, &mut words, &mut opts, tcx, pcx) {
        return 2;
    }
    if words.count != 1 {
        return usage_error(if words.count == 0 { c"a TABLE (a static var X: *T) is needed" }
            else { c"one TABLE at a time" }, example, tcx, pcx);
    }
    // UNSAFE: take_args keeps the words as C strings cast to i64 (an IntVec).
    // SAFETY: words.get(0) is such a pointer, to an argument of the command
    // line, which lives until the run ends.
    let name = c_slice(unsafe { words.get(0) as *mut u8 });
    tcx.root_given = root;
    root = root_or_diag(root, tcx.sub, name, true, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    let mut status: i64 = 0;
    tcx.x_def = load_and_find(root, name, 1 << K_STATIC | 1 << K_FIELD, c"static or field",
        &mut status, tcx, pcx, wgx);
    if tcx.x_def < 0 {
        return status;
    }
    let xd = def_of(tcx.x_def, pcx);
    tcx.x_sym = xd.name;
    let s = xd.node;
    // (0.27.0) a struct's field `x: *T`, its count `x_count` (or the
    // singular's, `structs`: `struct_count`) and capacity `x_cap` fields of
    // the same struct, made `x: Vec<T, A>` (A the struct's allocator
    // parameter) and `Vec::new_in(ALLOC {})` in its literals
    tcx.table_field = xd.kind == K_FIELD;
    if tcx.table_field {
        if pk(s, pcx) != NodeKind::Field || pk(pb(s, pcx), pcx) != NodeKind::TyPtr {
            return shape_error(tcx.x_def, c"a struct's field `x: *T` (a table's pointer)", tcx,
                pcx);
        }
    }
    else if pk(s, pcx) != NodeKind::Static || pd(s, pcx) == 0
        || pk(pb(s, pcx), pcx) != NodeKind::TyPtr
        || checked(s, pcx).y != 0 {
        return shape_error(tcx.x_def, c"a `static var X: *T` of the program (a table's pointer)",
            tcx, pcx);
    }
    let count_opt = opt(opts, c"--count", false);
    let cap_opt = opt(opts, c"--cap", false);
    tcx.c_def = if count_opt != 0 as *mut u8 { sibling(c_slice(count_opt), tcx, pcx) }
        else {
            default_sibling(if tcx.table_field { "_count".as_bytes() } else { "_COUNT".as_bytes() },
                tcx, pcx)
        };
    tcx.k_def = if cap_opt != 0 as *mut u8 { sibling(c_slice(cap_opt), tcx, pcx) }
        else {
            default_sibling(if tcx.table_field { "_cap".as_bytes() } else { "_CAP".as_bytes() },
                tcx, pcx)
        };
    if tcx.c_def < 0 {
        let e = diag(c"error", c"refactor.table-count", tcx);
        buf_bytes(e, sym_text(xd.fqn, pcx));
        buf_str(e, c" has no count static (");
        buf_str(e, if count_opt != 0 as *mut u8 { count_opt } else { c"X_COUNT or XS_COUNT" });
        buf_str(e, c" not found in its module)\n");
        let out = diags(tcx);
        buf_str(out, c"try:");
        put_cword(out, pcx.prog);
        buf_str(out, c" refactor table");
        put_word(out, sym_text(xd.fqn, pcx));
        buf_str(out, c" --count NAME --dry-run");
        put_root(out, tcx);
        try_end(out);
        return 1;
    }
    if cap_opt != 0 as *mut u8 && tcx.k_def < 0 {
        let e = diag(c"error", c"refactor.table-count", tcx);
        buf_str(e, c"no static ");
        buf_str(e, cap_opt);
        buf_str(e, c" in the module of ");
        buf_bytes(e, sym_text(xd.fqn, pcx));
        buf_byte(e, b'\n');
        return 1;
    }
    if !tcx.table_field && !zero_i64(def_of(tcx.c_def, pcx).node, pcx) {
        return shape_error(tcx.c_def, c"a `static var X_COUNT: i64 = 0` (the table's count)", tcx,
            pcx);
    }
    if !tcx.table_field && tcx.k_def >= 0 && !zero_i64(def_of(tcx.k_def, pcx).node, pcx) {
        return shape_error(tcx.k_def, c"a `static var X_CAP: i64 = 0` (the table's capacity)",
            tcx, pcx);
    }
    tcx.c_sym = def_of(tcx.c_def, pcx).name;
    tcx.k_sym = if tcx.k_def >= 0 { def_of(tcx.k_def, pcx).name } else { -1 };
    let alloc_opt = opt(opts, c"--alloc", false);
    let alloc = last_segment(if alloc_opt != 0 as *mut u8 { c_slice(alloc_opt) }
        else { "Comp".as_bytes() });

    build_parents(tcx, pcx);
    collect_fns(tcx, pcx);
    let mut xpos: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut xflags: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut cpos: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut cflags: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut kpos: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut kflags: Vec<i64, Comp> = Vec::new_in(Comp {});
    refs_all(&mut xpos, &mut xflags, &mut cpos, &mut cflags, &mut kpos, &mut kflags, tcx, pcx);
    let mut count_reads: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..cpos.len() {
        if (cflags[i] & (QF_DEF | QF_USE)) == 0 {
            count_reads.push(cpos[i]);
        }
    }
    call_edges(tcx, pcx);
    reading_fns(&count_reads, tcx);
    let mut writes: Vec<i64, Comp> = Vec::new_in(Comp {});
    for p in xpos.iter().copied() {
        let id = ident_at(p, tcx.x_sym, tcx, pcx);
        if id > 0 && written(expr_of(id, tcx, pcx), tcx, pcx) {
            writes.push(p);
        }
    }
    for p in cpos.iter().copied() {
        let id = ident_at(p, tcx.c_sym, tcx, pcx);
        if id > 0 && written(expr_of(id, tcx, pcx), tcx, pcx) {
            writes.push(p);
        }
    }
    growing_fns(&writes, tcx);

    // 1. The grows and the stores after them; 2. the stores without one.
    for i in 0..xpos.len() {
        if (xflags[i] & (QF_DEF | QF_USE)) == 0 {
            let id = ident_at(xpos[i], tcx.x_sym, tcx, pcx);
            if id > 0 {
                take_grow(expr_of(id, tcx, pcx), tcx, pcx);
                take_reserve(expr_of(id, tcx, pcx), tcx, pcx);
            }
        }
    }
    for i in 0..xpos.len() {
        if (xflags[i] & (QF_DEF | QF_USE)) == 0 && tcx.table_done.get(xpos[i] + 1) == 0 {
            let id = ident_at(xpos[i], tcx.x_sym, tcx, pcx);
            if id > 0 {
                take_store(expr_of(id, tcx, pcx), tcx, pcx);
            }
        }
    }
    // 3. Every other use.
    for i in 0..xpos.len() {
        let p = xpos[i];
        if (xflags[i] & (QF_DEF | QF_USE)) != 0 || tcx.table_done.get(p + 1) != 0 {
            continue;
        }
        let id = ident_at(p, tcx.x_sym, tcx, pcx);
        if id < 0 {
            refuse(p, c"X named by a path the tool cannot read (not a plain name)", 0, tcx, pcx);
            continue;
        }
        place_x(expr_of(id, tcx, pcx), tcx, pcx);
    }
    for i in 0..cpos.len() {
        let p = cpos[i];
        if (cflags[i] & QF_DEF) != 0 || tcx.table_done.get(p + 1) != 0 {
            continue;
        }
        if (cflags[i] & QF_USE) != 0 {
            if !drop_use(p, tcx, pcx) {
                refuse(p, c"a use of X_COUNT the tool cannot remove", 0, tcx, pcx);
            }
            continue;
        }
        let id = ident_at(p, tcx.c_sym, tcx, pcx);
        if id < 0 {
            refuse(p, c"X_COUNT named by a path the tool cannot read (not a plain name)", 0, tcx,
                pcx);
            continue;
        }
        place_count(expr_of(id, tcx, pcx), tcx, pcx);
    }
    for i in 0..kpos.len() {
        let p = kpos[i];
        if (kflags[i] & QF_DEF) != 0 || tcx.table_done.get(p + 1) != 0 {
            continue;
        }
        if (kflags[i] & QF_USE) != 0 {
            if !drop_use(p, tcx, pcx) {
                refuse(p, c"a use of X_CAP the tool cannot remove", 0, tcx, pcx);
            }
            continue;
        }
        let id = ident_at(p, tcx.k_sym, tcx, pcx);
        refuse(p, c"X_CAP read outside the grow (a Vec's capacity is its own)",
            if id > 0 { parent(expr_of(id, tcx, pcx), tcx) } else { 0 }, tcx, pcx);
    }
    if tcx.rf_pos.len() > 0 {
        return report_refusals(tcx, pcx);
    }

    // The statics: X a Vec; X_COUNT and X_CAP gone.
    let ty = pb(s, pcx);
    let tt = buf_new();
    buf_str(tt, c"Vec<");
    buf_bytes(tt, src_text(pstart(pa(ty, pcx), pcx), pend(pa(ty, pcx), pcx)));
    buf_str(tt, c", ");
    buf_bytes(tt, if tcx.table_field { field_alloc(alloc, tcx, pcx) } else { alloc });
    buf_byte(tt, b'>');
    edit(pstart(ty, pcx), pend(ty, pcx), buf_slice(tt), tcx, pcx);
    let vt = buf_new();
    buf_str(vt, c"Vec::new_in(");
    buf_bytes(vt, alloc);
    buf_str(vt, c" {})");
    if tcx.table_field {
        let mut inits: Vec<i64, Comp> = Vec::new_in(Comp {});
        field_inits(tcx.x_def, &mut inits, tcx, pcx);
        for fi in inits.iter().copied() {
            edit(pstart(pb(fi, pcx), pcx), pend(pb(fi, pcx), pcx), buf_slice(vt), tcx, pcx);
        }
        delete_field(tcx.c_def, tcx, pcx);
        if tcx.k_def >= 0 {
            delete_field(tcx.k_def, tcx, pcx);
        }
    } else {
        edit(pstart(pc(s, pcx), pcx), pend(pc(s, pcx), pcx), buf_slice(vt), tcx, pcx);
        delete_static(tcx.c_def, tcx, pcx);
        if tcx.k_def >= 0 {
            delete_static(tcx.k_def, tcx, pcx);
        }
    }
    drop_grow_imports("crate::base::grow".as_bytes(), tcx, pcx);
    drop_grow_imports("crate::base::reserve".as_bytes(), tcx, pcx);
    emit_use_edits(tcx, pcx);
    if tcx.table_edit_failed {
        let d = diag(c"error", c"refactor.internal", tcx);
        buf_str(d, c"the edits overlap (a case refactor table does not handle); nothing written\n");
        return 1;
    }
    let what = buf_new();
    buf_str(what, c"made ");
    buf_bytes(what, sym_text(xd.fqn, pcx));
    buf_str(what, c" a Vec<");
    buf_bytes(what, src_text(pstart(pa(ty, pcx), pcx), pend(pa(ty, pcx), pcx)));
    buf_str(what, c", ");
    buf_bytes(what, if tcx.table_field { field_alloc(alloc, tcx, pcx) } else { alloc });
    buf_str(what, c">: ");
    put_count(what, tcx.n_push, c"push", c"pushes");
    buf_str(what, c", ");
    put_count(what, tcx.n_len, c"len()", c"len()s");
    if tcx.n_clear > 0 {
        buf_str(what, c", ");
        put_count(what, tcx.n_clear, c"clear()", c"clear()s");
    }
    if tcx.n_trunc > 0 {
        buf_str(what, c", ");
        put_count(what, tcx.n_trunc, c"truncate()", c"truncate()s");
    }
    if tcx.n_reserve > 0 {
        buf_str(what, c", ");
        put_count(what, tcx.n_reserve, c"reserve()", c"reserve()s");
    }
    tcx.add_imports = true;
    let status = apply_edit(buf_slice(what), root, tcx, pcx);
    if status == 0 && !tcx.dry_run {
        // The unsafe blocks only the table's raw indexing needed.
        let out = diags(tcx);
        let d = diag(c"note", c"refactor.table-unsafe", tcx);
        buf_str(d, c"the unsafe blocks around its indexing may be unneeded now\n");
        buf_str(out, c"try:");
        put_cword(out, pcx.prog);
        buf_str(out, c" fix --only unneeded-unsafe");
        put_root(out, tcx);
        try_end(out);
    }
    status
}
