// The refactorings that change a definition's shape (0.11, phase 2;
// docs/refactor.md), each one atomic edit (edit.vl) of the definition
// and of every use the checker resolved:
//
//   refactor signature FN --add 'x: T = VALUE' [--at N] | --remove x
//            | --rename-param a b | --reorder b,a,c | --type x T
//       the function (with a trait's function: the trait's declaration
//       and every impl's) and its calls (`f(..)`, `x.f(..)`, `T::f(..)`,
//       in generic instances too); a function used as a value is refused
//       for a change of its type
//   refactor field STRUCT --add 'g: T = VALUE' | --remove g | --rename g h
//            | --type g T
//       the struct, its literals, its field accesses
//   refactor variant ENUM --add 'X(T)' [--arm EXPR] | --remove V
//            | --rename V W
//       the enum, its constructions, the matches on it
//   refactor extract-function FN --lines A-B --to NEW   (0.13, extract.vl)
//   refactor inline FN [--at FILE:LINE] [--keep]         (0.13, inline.vl)
//       statements of a function into a new one; a body at its calls
//       (body.vl: the code of a body, its locals and their uses)
//
// Changes are computed on the program as parsed (ast.vl's
// PARSED_NODES), from the checked nodes' resolutions; a generic
// function's instances are clones of its nodes (generics.vl), mapped
// back to the nodes as written by their span. Lists (parameters,
// arguments, fields, variants, arms) keep their layout: an element on
// lines of its own is added or removed with its lines.
//
// This file holds what the three share: the command line, finding the
// definition, the nodes as written, lines and lists; each refactoring is
// a part: signature, field, variant.

pub mod signature;
pub mod field;
pub mod variant;
pub mod body;
pub mod extract;
pub mod inline;
pub mod sealed016;

use std::alloc::Arena;

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, get_src, intern, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{
    Call, EV_MISSING, EV_UNKNOWN, EV_WORD, Leaf, flag, is_opt, long_of, option, pair, word_of,
};
use crate::front::ast::NodeKind;
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::cli::{ambiguous, edit_opts, source_only, take_edit_event};
use crate::tools::edit::items::{after_line, indent_of};
use crate::tools::query::{c_slice, resolve_name};
use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::bytes_eq;
use crate::tools::query::diagnostics::{
    diag, diags, program_errors, put_cword, put_root, put_word, try_end,
};
use crate::tools::query::positions::{line_start, put_loc, token_at};
use crate::tools::query::refs::{collect_refs, set_targets};
use crate::tools::rewrite::parsed::{pchild, pcount, pend, pk, pstart};

// ---- Common ----

fn text_buf(s: &[u8]) -> i64 {
    let b = buf_new();
    buf_bytes(b, s);
    b
}

fn sym_text(sym: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    crate::base::sym_text(sym, pcx)
}

fn usage_error(message: *mut u8, example: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"refactor.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" refactor ");
    buf_str(out, tcx.sub);
    buf_byte(out, b' ');
    buf_str(out, example);
    put_root(out, tcx);
    try_end(out);
    2
}

// Starts a `try:` line `PROG refactor SUB NAME`; words and put_root
// follow.
fn try_refactor(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" refactor ");
    buf_str(out, tcx.sub);
    put_word(out, name);
    out
}

// Starts a `try:` line `PROG query CMD NAME`, ending it.
fn try_query_name(cmd: *mut u8, name: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" query ");
    buf_str(out, cmd);
    put_word(out, name);
    put_root(out, tcx);
    try_end(out);
}

// `try: PROG query show FILE:LINE` of the code at pos.
fn try_show_at(pos: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" query show ");
    let at = buf_new();
    put_loc(at, pos, pcx);
    // (FILE:LINE: the column dropped)
    let s = buf_slice(at);
    let mut e = s.len() as i64;
    while e > 0 && s[(e - 1) as usize] != b':' {
        e -= 1;
    }
    buf_bytes(out, &s[0..(e - 1) as usize]);
    put_root(out, tcx);
    try_end(out);
}

// The options of `refactor SUB` (signature, field, variant,
// extract-function, inline) and their numbers of values: `--add=1
// --rename=2 --keep=0`, a flag (0), an option (1) and an option of two
// values (2).
pub fn shape_options(sub: &str) -> *mut u8 {
    if sub == "signature" {
        c"--add=1 --at=1 --remove=1 --rename-param=2 --reorder=1 --type=2 --default=1 --fill-calls=0"
    } else if sub == "field" {
        c"--add=1 --remove=1 --rename=2 --type=2 --default=1"
    } else if sub == "variant" {
        c"--add=1 --arm=1 --arm-in=2 --remove=1 --rename=2"
    } else if sub == "extract-function" {
        c"--lines=1 --to=1"
    } else {
        c"--at=1 --keep=0"
    }
}

// `refactor SUB`'s arguments, for shape_options(SUB) (0.25.2: a leaf of
// volec's Command tree, cli/tree.vl): the edit options and these.
pub fn shape_leaf(options: *mut u8, gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    for w in word_of(options).split(' ') {
        match w.strip_prefix("--") {
            Option::Some(spec) => match spec.split_once('=') {
                Option::Some((name, n)) => {
                    if n == "0" {
                        table.push(flag(name, ""));
                    } else if n == "2" {
                        table.push(pair(name, "VALUE VALUE", ""));
                    } else {
                        table.push(option(name, "VALUE", ""));
                    }
                }
                Option::None => {}
            },
            Option::None => {}
        }
    }
    Leaf::new(table, "word")
}

// The options and words of `refactor SUB NAME ...`: the edit options are
// taken, `--x` options with `values` values each go to `opts` (the option,
// then its values), the rest to `words`. False after a usage error.
fn take_args(c: &Call<'_, Gpa>, options: *mut u8, root: &mut *mut u8, words: &mut IntVec,
    opts: &mut IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>)
    -> bool {
    let evs = c.evs.clone();
    // (the second word: the root when it is a source file)
    let mut second = 0 as *mut u8;
    let mut k: i64 = 0;
    while k < evs.len() as i64 {
        let mut ev = evs[k as usize].clone();
        k += 1;
        if take_edit_event(&mut ev, root, tcx, pcx) {
            continue;
        }
        if ev.kind == EV_WORD {
            if words.count == 1 {
                second = ev.value;
            }
            words.push(ev.value as i64);
            continue;
        }
        if ev.kind == EV_UNKNOWN {
            let d = diag(c"error", c"refactor.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' of refactor ");
            buf_str(d, tcx.sub);
            buf_byte(d, b'\n');
            return false;
        }
        let name = long_of(ev);
        let n = option_values(options, name);
        if ev.kind == EV_MISSING
            || n == 2 && (k >= evs.len() as i64 || !is_opt(evs[k as usize], ev.name)) {
            let d = diag(c"error", c"refactor.usage", tcx);
            buf_str(d, if ev.kind == EV_MISSING { ev.value } else { name });
            buf_str(d, if n == 1 { c" needs a value\n" } else { c" needs two values\n" });
            return false;
        }
        opts.push(name as i64);
        if n >= 1 {
            opts.push(ev.value as i64);
        }
        if n == 2 {
            opts.push(evs[k as usize].value as i64);
            k += 1;
        }
    }
    if words.count == 2 && *root == 0 as *mut u8 && crate::base::is_source_path(second) {
        *root = second;
        words.truncate(1);
    }
    true
}

// The number of values of option `a` in `options` (`--add=1 --at=1 ...`),
// or -1 when it is none.
fn option_values(options: *mut u8, a: *mut u8) -> i64 {
    let s = c_slice(options);
    let w = c_slice(a);
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let mut e = i;
        while e < s.len() as i64 && s[e as usize] != b'=' {
            e += 1;
        }
        if bytes_eq(&s[i as usize..e as usize], w) {
            return (s[(e + 1) as usize] - b'0') as i64;
        }
        while e < s.len() as i64 && s[e as usize] != b' ' {
            e += 1;
        }
        i = e + 1;
    }
    -1
}

// The value of option `name` in opts (its first value; `second`: its
// second), or 0.
fn opt(opts: IntVec, name: *mut u8, second: bool) -> *mut u8 {
    unsafe {
        let mut i: i64 = 0;
        while i < opts.count {
            if streq((*opts.data.add(i as usize)) as *mut u8, name) {
                return (*opts.data.add((if second { i + 2 } else { i + 1 }) as usize)) as *mut u8;
            }
            i += 1;
        }
        0 as *mut u8
    }
}

// Loads the program and finds NAME, a definition of kind k1 or k2...
// (as a mask of 1 << K_*): the definition, or -1 after the diagnostic
// (*status: the exit status).
fn load_and_find(root: *mut u8, name: &[u8], kinds: i64, what: *mut u8, status: &mut i64,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    unsafe {
        pcx.keep_parsed = true;
        if !load_program(root, tcx.target, tcx, pcx, wgx) {
            program_errors(c"error", root, true, tcx, pcx);
            *status = 1;
            return -1;
        }
        tcx.program_end = pcx.parsed_count;
        let mut matches = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        tcx.tool = c"refactor";
        if !resolve_name(tcx.sub, name, &mut matches, tcx, pcx) {
            *status = 1;
            return -1;
        }
        source_only(&mut matches, pcx);
        // (only the definitions of the kinds asked for, when some are)
        let mut kept: i64 = 0;
        for i in 0..matches.count {
            let d = (*matches.data.add(i as usize));
            if (kinds & (1 << pcx.defs[d as usize].kind)) != 0 {
                (*matches.data.add(kept as usize)) = d;
                kept += 1;
            }
        }
        if kept == 0 {
            let d = (*matches.data.add(0));
            let e = diag(c"error", c"refactor.kind", tcx);
            buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
            buf_str(e, c" is a ");
            buf_str(e, crate::tools::query::defs::kind_name(pcx.defs[d as usize].kind));
            buf_str(e, c", not a ");
            buf_str(e, what);
            buf_byte(e, b'\n');
            try_query_name(c"def", name, tcx, pcx);
            *status = 1;
            return -1;
        }
        matches.truncate(kept);
        if matches.count > 1 {
            ambiguous(tcx.sub, name, matches, tcx, pcx);
            *status = 1;
            return -1;
        }
        let d = (*matches.data.add(0));
        if (*pcx.files[file_of_pos(pcx.defs[d as usize].start, pcx) as usize].path.add(0)) == b'<' {
            let e = diag(c"error", c"edit.not-source", tcx);
            buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
            buf_str(e, c" is in ");
            buf_str(e, pcx.files[file_of_pos(pcx.defs[d as usize].start, pcx) as usize].path);
            buf_str(e, c", not in a file of the program\n");
            *status = 1;
            return -1;
        }
        // The nodes as written, by span and kind.
        for n in 1..tcx.program_end {
            let key = orig_key(pstart(n, pcx), pend(n, pcx), pk(n, pcx));
            if tcx.orig.get(key) == 0 {
                tcx.orig.put(key, n + 1);
            }
        }
        d
    }
}

fn orig_key(start: i64, end: i64, kind: NodeKind) -> i64 {
    ((start * 128 + kind as i64) * 65536 + (end - start) % 65536) + 1
}

// The node as written of checked node n, of kind `kind` as parsed: n
// itself, or for a clone (an instance's body), the node it copies; -1.
fn orig_of(n: i64, kind: NodeKind, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if n < tcx.program_end {
        return if pk(n, pcx) == kind { n } else { -1 };
    }
    tcx.orig.get(orig_key(pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, kind)) - 1
}

// Whether only spaces are between pos and the start of its line.
fn starts_line(pos: i64) -> bool {
    let mut p = pos;
    while p > 0 && (get_src()[(p - 1) as usize] == b' ' || get_src()[(p - 1) as usize] == b'\t') {
        p -= 1;
    }
    p == 0 || get_src()[(p - 1) as usize] == b'\n'
}

// Whether a newline is in SRC[a..b).
fn newline_in(a: i64, b: i64) -> bool {
    for p in a..b {
        if get_src()[p as usize] == b'\n' {
            return true;
        }
    }
    false
}

// Whether the rest of the line after pos is blank, but for a `,` and a
// comment.
fn rest_blank(pos: i64) -> bool {
    let mut p = pos;
    while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
        p += 1;
    }
    if get_src()[p as usize] == b',' {
        p += 1;
    }
    while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
        p += 1;
    }
    if get_src()[p as usize] == b'/' && get_src()[(p + 1) as usize] == b'/' {
        return true;
    }
    get_src()[p as usize] == b'\n' || get_src()[p as usize] == 0
}

// The start of the comment lines directly above the line of pos (that
// line's start when there are none).
fn comment_head(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pos, pcx);
    let mut p = line_start(pos, pcx);
    while p > pcx.files[f as usize].start {
        let prev = line_start(p - 1, pcx);
        let mut q = prev;
        while get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t' {
            q += 1;
        }
        if get_src()[q as usize] == b'/' && get_src()[(q + 1) as usize] == b'/' {
            p = prev;
        } else {
            break;
        }
    }
    p
}

// The token index of the bracket matching the one at token i: back from
// a closing one (`back`), forward from an opening one; -1.
fn matching(i0: i64, back: bool, pcx: &Ctx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut i = i0;
    while i >= 0 && i < pcx.toks.len() as i64 {
        let k = pcx.toks[i as usize].kind;
        let close = k == Tok::RParen || k == Tok::RBracket || k == Tok::RBrace;
        let open = k == Tok::LParen || k == Tok::LBracket || k == Tok::LBrace;
        if (close && back) || (open && !back) {
            depth += 1;
        } else if open || close {
            depth -= 1;
        }
        if depth == 0 {
            return i;
        }
        i = if back { i - 1 } else { i + 1 };
    }
    -1
}

// ---- Lists ----
//
// The list being changed: the position after its opening bracket, the
// position of its closing one, its elements' spans.

// The list of node n's elements (its list as parsed), between the
// bracket closing at n's end and the one it matches.
fn list_of_node(n: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let close = token_at(pend(n, pcx) - 1, pcx);
    let open = matching(close, true, pcx);
    tcx.l_open = pcx.toks[open as usize].end;
    tcx.l_close = pcx.toks[close as usize].start;
    tcx.refactor_shape_l_start.clear();
    tcx.refactor_shape_l_end.clear();
    for i in 0..pcount(n, pcx) {
        let c = pchild(n, i, pcx);
        tcx.refactor_shape_l_start.push(pstart(c, pcx));
        tcx.refactor_shape_l_end.push(pend(c, pcx));
    }
}

// The parameter list of function node f: after the `(` following its
// name.
fn list_of_params(f: i64, name_pos: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut i = token_at(name_pos, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Tok::LParen {
        i += 1;
    }
    let close = matching(i, false, pcx);
    tcx.l_open = pcx.toks[i as usize].end;
    tcx.l_close = pcx.toks[close as usize].start;
    tcx.refactor_shape_l_start.clear();
    tcx.refactor_shape_l_end.clear();
    for k in 0..pcount(f, pcx) {
        let c = pchild(f, k, pcx);
        tcx.refactor_shape_l_start.push(pstart(c, pcx));
        tcx.refactor_shape_l_end.push(pend(c, pcx));
    }
}

// Inserts `text` as element k (k == count: at the end).
fn list_insert(k: i64, text: &[u8], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let n = tcx.refactor_shape_l_start.count;
        let brace = get_src()[(tcx.l_open - 1) as usize] == b'{';
        if n == 0 {
            let b = buf_new();
            if brace {
                buf_byte(b, b' ');
            }
            buf_bytes(b, text);
            if brace {
                buf_byte(b, b' ');
            }
            edit_replace(tcx.l_open, tcx.l_close, b, pcx);
            return;
        }
        if k < n {
            let s = (*tcx.refactor_shape_l_start.data.add(k as usize));
            let b = buf_new();
            if starts_line(s) {
                buf_bytes(b, indent_of(s, pcx));
                buf_bytes(b, text);
                buf_str(b, c",\n");
                let at = comment_head(s, pcx);
                edit_replace(at, at, b, pcx);
            } else {
                buf_bytes(b, text);
                buf_str(b, c", ");
                edit_replace(s, s, b, pcx);
            }
            return;
        }
        let last = (*tcx.refactor_shape_l_start.data.add((n - 1) as usize));
        let e = (*tcx.refactor_shape_l_end.data.add((n - 1) as usize));
        if starts_line(last) && newline_in(e, tcx.l_close) {
            // (on a line of its own, after the last one's; with a comma
            // when the last one has one)
            let mut p = e;
            while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
                p += 1;
            }
            let comma = get_src()[p as usize] == b',' || get_src()[(e - 1) as usize] == b',';
            if !comma {
                edit_replace(e, e, text_buf(c_slice(c",")), pcx);
            }
            let b = buf_new();
            buf_bytes(b, indent_of(last, pcx));
            buf_bytes(b, text);
            if comma {
                buf_byte(b, b',');
            }
            buf_byte(b, b'\n');
            let at = after_line(e, pcx);
            edit_replace(at, at, b, pcx);
            return;
        }
        let b = buf_new();
        buf_str(b, if get_src()[(e - 1) as usize] == b',' { c" " } else { c", " });
        buf_bytes(b, text);
        edit_replace(e, e, b, pcx);
    }
}

// Removes element k with its separator (its lines, when it has lines of
// its own).
fn list_remove(k: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let n = tcx.refactor_shape_l_start.count;
        let s = (*tcx.refactor_shape_l_start.data.add(k as usize));
        let e = (*tcx.refactor_shape_l_end.data.add(k as usize));
        if starts_line(s) && rest_blank(e) && newline_in(e, tcx.l_close) {
            edit_replace(comment_head(s, pcx), after_line(e, pcx), buf_new(), pcx);
            if k == n - 1 && k > 0 && get_src()[(e - 1) as usize] != b',' && !has_comma_after(e) {
                // (the one before is the last now: like this one, without
                // a comma)
                let pe = (*tcx.refactor_shape_l_end.data.add((k - 1) as usize));
                if has_comma_after(pe) {
                    let mut p = pe;
                    while get_src()[p as usize] != b',' {
                        p += 1;
                    }
                    edit_replace(p, p + 1, buf_new(), pcx);
                }
            }
            return;
        }
        if n == 1 {
            edit_replace(tcx.l_open, tcx.l_close, buf_new(), pcx);
        } else if k < n - 1 {
            edit_replace(s, (*tcx.refactor_shape_l_start.data.add((k + 1) as usize)), buf_new(),
                pcx);
        } else {
            edit_replace((*tcx.refactor_shape_l_end.data.add((k - 1) as usize)), e, buf_new(), pcx);
        }
    }
}

fn has_comma_after(e: i64) -> bool {
    let mut p = e;
    while get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t' {
        p += 1;
    }
    get_src()[p as usize] == b','
}

// Element j becomes element perm[j] (each its text, layout kept).
fn list_permute(perm: IntVec, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        for j in 0..perm.count {
            let from = (*perm.data.add(j as usize));
            if from != j {
                edit_replace((*tcx.refactor_shape_l_start.data.add(j as usize)),
                    (*tcx.refactor_shape_l_end.data.add(j as usize)),
                    text_buf(
                        &get_src()[
                            (*tcx.refactor_shape_l_start.data.add(from as usize)) as usize..(
                                *tcx.refactor_shape_l_end.data.add(
                                    from as usize)) as usize]), pcx);
            }
        }
    }
}

// Whether SRC[a..b) has a call (an argument whose removal, or move,
// changes what the program does).
fn has_call(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let mut i = token_at(a, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < b {
        if pcx.toks[i as usize].kind == Tok::LParen && i > 0
            && pcx.toks[(i - 1) as usize].kind == Tok::Ident {
            return true;
        }
        i += 1;
    }
    false
}

// `NAME: T = VALUE` (or `NAME: T`): the end of the declaration, the
// start of VALUE (-1 for none) in s.
fn split_default(s: &[u8], value: &mut i64) -> i64 {
    let mut depth: i64 = 0;
    for i in 0..s.len() as i64 {
        let c = s[i as usize];
        if c == b'(' || c == b'[' || c == b'{' || c == b'<' {
            depth += 1;
        }
        else if c == b')' || c == b']' || c == b'}'
            || (c == b'>' && i > 0 && s[(i - 1) as usize] != b'-') {
            depth -= 1;
        }
        else if c == b'=' && depth == 0
            && (i + 1 >= s.len() as i64
                || (s[(i + 1) as usize] != b'=' && s[(i + 1) as usize] != b'>'))
            && (i == 0
                || (s[(i - 1) as usize] != b'=' && s[(i - 1) as usize] != b'!'
                    && s[(i - 1) as usize] != b'<' && s[(i - 1) as usize] != b'>')) {
            let mut e = i;
            while e > 0 && s[(e - 1) as usize] == b' ' {
                e -= 1;
            }
            let mut v = i + 1;
            while v < s.len() as i64 && s[v as usize] == b' ' {
                v += 1;
            }
            *value = v;
            return e;
        }
    }
    *value = -1;
    let mut e = s.len() as i64;
    while e > 0 && s[(e - 1) as usize] == b' ' {
        e -= 1;
    }
    e
}

// The name a declaration `[pub] [mut] NAME ...` starts with, as a symbol
// (-1: none).
fn leading_name(s: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let mut i: i64 = 0;
    while i < s.len() as i64 && s[i as usize] == b' ' {
        i += 1;
    }
    let mut word = word_at(s, i);
    if (word == 3 && s[i as usize] == b'p' && s[(i + 1) as usize] == b'u'
        && s[(i + 2) as usize] == b'b')
        || (word == 3 && s[i as usize] == b'm' && s[(i + 1) as usize] == b'u'
            && s[(i + 2) as usize] == b't') {
        i += word;
        while i < s.len() as i64 && s[i as usize] == b' ' {
            i += 1;
        }
        word = word_at(s, i);
    }
    if word == 0 {
        return -1;
    }
    intern(&s[i as usize..(i + word) as usize], pcx)
}

fn word_at(s: &[u8], i: i64) -> i64 {
    let mut e = i;
    while e < s.len() as i64
        && ((s[e as usize] >= b'a' && s[e as usize] <= b'z')
            || (s[e as usize] >= b'A' && s[e as usize] <= b'Z') || s[e as usize] == b'_'
            || (e > i && s[e as usize] >= b'0' && s[e as usize] <= b'9')) {
        e += 1;
    }
    e - i
}

// The position of the name token `name` at or after pos (a parameter's
// name after `mut`), or -1.
fn name_token(pos: i64, end: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut i = token_at(pos, pcx);
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < end {
        if pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == name {
            return pcx.toks[i as usize].start;
        }
        i += 1;
    }
    -1
}

fn replace_name(pos: i64, old: i64, new: i64, pcx: &mut Ctx<Comp>) {
    edit_replace(pos, pos + sym_text(old, pcx).len() as i64, text_buf(sym_text(new, pcx)), pcx);
}

// The references to the definitions of `targets` (query's refs): into
// R_POS, R_FLAGS.
fn refs_of(targets: IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    set_targets(targets, tcx, pcx);
    collect_refs(tcx, pcx);
}

fn put_count(out: i64, n: i64, one: *mut u8, many: *mut u8) {
    buf_int(out, n);
    buf_byte(out, b' ');
    buf_str(out, if n == 1 { one } else { many });
}

// The index of the first byte c of s, or -1.
fn find_byte(s: &[u8], c: u8) -> i64 {
    for i in 0..s.len() as i64 {
        if s[i as usize] == c {
            return i;
        }
    }
    -1
}
