// `refactor extract-function FN --lines A-B --to NEW` (0.13): the
// statements of lines A to B of function FN become a new function NEW,
// after FN, called where they were.
//
// Its parameters are the locals of FN the lines use and do not declare,
// in the order they are first used: by value; `mut` and given back when
// the lines assign them; by reference (`x: &mut T`, called with `&mut x`,
// the lines' `&x` then `x`) when the lines only take their address or write
// their fields (`v.push(1)`, `p.x = 0`). Its result: the one local the
// lines declare and FN uses after them (`let x = NEW(...);`), or several
// as a tuple (`let (a, b) = NEW(...);`), or a local declared before them
// that they assign (`x = NEW(...);`), or the value the lines end the
// block with. Inside unsafe code its body is an unsafe block; in a method
// using `self`, it is a method of the same impl (`self.NEW(...)`).
//
// Refused: lines that are not whole statements of one block
// (refactor.range), control flow leaving them (`return`, a `break` or
// `continue` of a loop around them, a `defer`: refactor.escapes), results
// it cannot give back (refactor.results), a generic function
// (refactor.generic).

use std::alloc::Arena;

use crate::base::{
    buf_byte, buf_bytes, buf_int, buf_len, buf_new, buf_slice, buf_str, get_src, intern,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::Call;
use crate::front::ast::{NodeKind, child};
use crate::front::embed::wgsl::WgslCx;
use crate::front::modules::file_of_pos;
use crate::front::types::{TY_NEVER, TY_UNIT, is_pointer};
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::edit::items::{after_line, indent_of};
use crate::tools::fixconv::put_type_conv;
use crate::tools::query::{c_slice, root_or_diag};
use crate::tools::query::defs::{K_FN, K_IMPL_METHOD, K_METHOD};
use crate::tools::query::diagnostics::{
    diag, diags, put_cword, put_root, put_word, try_end, write_diags,
};
use crate::tools::query::positions::{line_index, line_of, put_path};
use crate::tools::refactor_mod::cli::is_ident;
use crate::tools::refactor_shape::{
    load_and_find, opt, shape_options, sym_text, take_args, usage_error,
};
use crate::tools::refactor_shape::body::{
    USE_ADDR, USE_ASSIGN, USE_AUTOREF, USE_FIELD_READ, USE_FIELD_WRITE, USE_VALUE, captured_by_move,
    closure_around, decl_of, has_closure, in_body, in_unsafe, load_body, local_mut, local_name,
    local_of, parent, put_local_type, reindent, text_with, use_kind,
};

// How a local the lines use is passed (mode of each parameter).
const BY_VALUE: i64 = 0;
const BY_POINTER: i64 = 1;
const GIVEN_BACK: i64 = 2;

pub fn run_extract(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = extract_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

fn extract_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    tcx.sub = c"extract-function";
    let mut root = 0 as *mut u8;
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut opts: Vec<i64, Comp> = Vec::new_in(Comp {});
    let example = c"FN --lines 12-18 --to NEW --dry-run";
    if !take_args(c, shape_options("extract-function"), &mut root, &mut words, &mut opts, tcx,
        pcx) {
        return 2;
    }
    if words.len() as i64 != 1 {
        return usage_error(if words.len() as i64 == 0 { c"a function FN is needed" }
            else { c"one FN at a time" }, example, tcx, pcx);
    }
    let lines = opt(opts.as_slice(), c"--lines", false);
    let to = opt(opts.as_slice(), c"--to", false);
    if lines == 0 as *mut u8 || to == 0 as *mut u8 {
        return usage_error(c"--lines A-B (lines of FN's file) and --to NEW are needed",
            example, tcx, pcx);
    }
    let mut la: i64 = 0;
    let mut lb: i64 = 0;
    if !line_range(c_slice(lines), &mut la, &mut lb) {
        return usage_error(c"--lines takes A-B, line numbers of FN's file (A-A: one line)",
            example, tcx, pcx);
    }
    let new_name = c_slice(to);
    if !is_ident(new_name) {
        return usage_error(c"NEW must be an identifier (not a keyword)", example, tcx, pcx);
    }
    let name = c_slice((words[0]) as *mut u8);
    tcx.root_given = root;
    root = root_or_diag(root, tcx.sub, name, true, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    let mut status: i64 = 0;
    let d = load_and_find(root, name, (1 << K_FN) | (1 << K_METHOD) | (1 << K_IMPL_METHOD),
        c"function", &mut status, tcx, pcx, wgx);
    if d < 0 {
        return status;
    }
    let f = pcx.defs[d as usize].node;
    let body = pcx.nodes[f as usize].c;
    let fqn = sym_text(pcx.defs[d as usize].fqn, pcx);
    if body <= 0 {
        let e = diag(c"error", c"refactor.kind", tcx);
        buf_bytes(e, fqn);
        buf_str(e, c" has no body\n");
        return 1;
    }
    if pcx.nodes[f as usize].g != 0
        || pcx.nodes[f as usize].h != 0 && pcx.nodes[pcx.nodes[f as usize].h as usize].g != 0 {
        let e = diag(c"error", c"refactor.generic", tcx);
        buf_bytes(e, fqn);
        buf_str(e, c" is generic: its body is checked once per instance; extract by hand\n");
        return 1;
    }
    let file = file_of_pos(pcx.defs[d as usize].start, pcx);
    let first_line = line_index(pcx.files[file as usize].start, pcx);
    let file_lines = line_index(pcx.files[file as usize].end - 1, pcx) - first_line + 1;
    // (0.17: past the file's end, the body's lines are the help)
    let past = lb > file_lines;
    let ra: i64 = if past { 0 } else { (pcx.lines[(first_line + la - 1) as usize]) };
    let rb: i64 = if past { 0 }
        else { after_line((pcx.lines[(first_line + lb - 1) as usize]), pcx) };
    if past || ra <= pcx.nodes[body as usize].start || rb > pcx.nodes[body as usize].end {
        let e = diag(c"error", c"refactor.range", tcx);
        buf_str(e, c"lines ");
        put_range(e, la, lb);
        buf_str(e, c" are not inside the body of ");
        buf_bytes(e, fqn);
        buf_str(e, c" (lines ");
        put_range(e, line_of(pcx.nodes[body as usize].start, pcx),
            line_of(pcx.nodes[body as usize].end - 1, pcx));
        buf_str(e, c")\n");
        try_show(fqn, tcx, pcx);
        return 1;
    }
    load_body(f, tcx, pcx);
    // The innermost block around the lines, and its statements in them.
    let mut blk: i64 = -1;
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::Block && in_body(n, tcx)
            && pcx.nodes[n as usize].start < ra && pcx.nodes[n as usize].end >= rb
            && (blk < 0
                || pcx.nodes[n as usize].end - pcx.nodes[n as usize].start
                < pcx.nodes[blk as usize].end - pcx.nodes[blk as usize].start) {
            blk = n;
        }
    }
    if blk < 0 {
        blk = body;
    }
    let mut stmts: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut tail: i64 = -1;
    let nst = pcx.nodes[blk as usize].count;
    for i in 0..nst + 1 {
        let s = if i < nst { child(blk, i, pcx) } else { pcx.nodes[blk as usize].a };
        if s <= 0 || pcx.nodes[s as usize].end <= ra || pcx.nodes[s as usize].start >= rb {
            continue;
        }
        if pcx.nodes[s as usize].start < ra || pcx.nodes[s as usize].end > rb {
            return cut_statement(fqn, name, new_name, la, lb, s, tcx, pcx);
        }
        // (a value of type () ending the block is a statement here)
        if i < nst || pcx.nodes[s as usize].ty == TY_UNIT
            || pcx.nodes[s as usize].ty == TY_NEVER {
            stmts.push(s);
        } else {
            tail = s;
        }
    }
    if stmts.len() as i64 == 0 && tail < 0 {
        let e = diag(c"error", c"refactor.range", tcx);
        buf_str(e, c"no statement of ");
        buf_bytes(e, fqn);
        buf_str(e, c" is in lines ");
        put_range(e, la, lb);
        buf_byte(e, b'\n');
        try_show(fqn, tcx, pcx);
        return 1;
    }
    let sa = if stmts.len() as i64 > 0 { pcx.nodes[(stmts[0]) as usize].start }
        else { pcx.nodes[tail as usize].start };
    let sb = if tail >= 0 { pcx.nodes[tail as usize].end }
        else { pcx.nodes[(stmts[(stmts.len() as i64 - 1) as usize]) as usize].end };
    // (code of the lines outside the statements: a brace of the block)
    let mut p = ra;
    while p < rb {
        let c = get_src()[p as usize];
        if (p < sa || p >= sb) && c != b' ' && c != b'\t' && c != b'\n' && c != b'\r'
            && !(c == b';' && p == sb) {
            if c == b'/' && get_src()[(p + 1) as usize] == b'/' {
                p = after_line(p, pcx);
                continue;
            }
            let e = diag(c"error", c"refactor.range", tcx);
            buf_str(e, c"line ");
            buf_int(e, line_of(p, pcx));
            buf_str(e, c" has code outside the statements of lines ");
            put_range(e, line_of(sa, pcx), line_of(sb - 1, pcx));
            buf_byte(e, b'\n');
            try_extract(name, new_name, line_of(sa, pcx), line_of(sb - 1, pcx), tcx, pcx);
            return 1;
        }
        p += 1;
    }
    // Control flow leaving the lines.
    for n in 1..pcx.nodes.len() as i64 {
        if !in_body(n, tcx) || pcx.nodes[n as usize].start < sa
            || pcx.nodes[n as usize].end > sb {
            continue;
        }
        let k = pcx.nodes[n as usize].kind;
        // (0.14: control flow inside a closure of the lines stays in it)
        let c = closure_around(n, tcx, pcx);
        if c >= 0 && pcx.nodes[c as usize].start >= sa {
            continue;
        }
        let mut what = 0 as *mut u8;
        if k == NodeKind::Return {
            what = c"returns from ";
        } else if k == NodeKind::Try {
            // (0.15: `e?` returns from the function when e is None or Err)
            what = c"may return (`?`) from ";
        }
        else if (k == NodeKind::Break || k == NodeKind::Continue)
            && !loop_inside(n, sa, sb, tcx, pcx) {
            what = if k == NodeKind::Break { c"breaks out of a loop of " }
                else { c"continues a loop of " };
        }
        if what != 0 as *mut u8 {
            let e = diag(c"error", c"refactor.escapes", tcx);
            buf_str(e, c"line ");
            buf_int(e, line_of(pcx.nodes[n as usize].start, pcx));
            buf_byte(e, b' ');
            buf_str(e, what);
            buf_bytes(e, fqn);
            buf_str(e, c": out of lines ");
            put_range(e, la, lb);
            buf_str(e, c", which NEW cannot do for its caller\n");
            let before = statements_before(stmts.as_slice(), pcx.nodes[n as usize].start, pcx);
            if before >= la {
                try_extract(name, new_name, la, before, tcx, pcx);
            } else {
                try_show_at(file, line_of(pcx.nodes[n as usize].start, pcx), tcx, pcx);
            }
            return 1;
        }
    }
    // The locals: the parameters (declared before the lines), the
    // results (declared in them and used after, or assigned in them).
    let mut params: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut modes: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut results: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut self_local: i64 = -1;
    let mut amp_s: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut amp_e: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut amp_t: Vec<i64, Comp> = Vec::new_in(Comp {});
    for n in 1..pcx.nodes.len() as i64 {
        let l = local_of(n, pcx);
        if l < 0 || !in_body(n, tcx) || pcx.nodes[n as usize].start < sa
            || pcx.nodes[n as usize].end > sb {
            continue;
        }
        let dn = decl_of(l, tcx);
        if dn >= 0 && pcx.nodes[dn as usize].start >= sa && pcx.nodes[dn as usize].start < sb {
            continue;
        }
        if bytes_is(local_name(l, pcx), c"self") {
            self_local = l;
            continue;
        }
        if contains(params.as_slice(), l) {
            continue;
        }
        params.push(l);
        modes.push(mode_of(l, sa, sb, tcx, pcx));
    }
    // (the locals declared in the lines and used after them, in order)
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind == NodeKind::PatBind && in_body(n, tcx)
            && pcx.nodes[n as usize].start >= sa && pcx.nodes[n as usize].end <= sb
            && used_after(pcx.nodes[n as usize].x, sb, tcx, pcx)
            && !contains(results.as_slice(), pcx.nodes[n as usize].x) {
            results.push(pcx.nodes[n as usize].x);
        }
    }
    // (in the order of first use: they were found in node order)
    sort_by_first_use(&mut params, &mut modes, sa, sb, tcx, pcx);
    // (0.14: a closure's type has no name: NEW cannot take or give one)
    for i in 0..params.len() as i64 + results.len() as i64 + 1 {
        let mut l: i64 = -1;
        let mut t: i64 = 0;
        if i < params.len() as i64 {
            l = (params[i as usize]);
            t = pcx.locals[l as usize].ty;
        } else if i < params.len() as i64 + results.len() as i64 {
            l = (results[(i - params.len() as i64) as usize]);
            t = pcx.locals[l as usize].ty;
        } else if tail >= 0 {
            t = pcx.nodes[tail as usize].ty;
        }
        if !has_closure(t, 0, pcx) {
            continue;
        }
        let e = diag(c"error", c"refactor.closure", tcx);
        buf_str(e, c"lines ");
        put_range(e, la, lb);
        if i < params.len() as i64 {
            buf_str(e, c" use '");
            buf_bytes(e, local_name(l, pcx));
            buf_str(e, c"', a closure made before them");
        } else if l >= 0 {
            buf_str(e, c" make '");
            buf_bytes(e, local_name(l, pcx));
            buf_str(e, c"', a closure used after them");
        } else {
            buf_str(e, c" end the block with a closure");
        }
        buf_str(e, c"; a closure's type has no name for NEW's signature\n");
        let dn: i64 = if i < params.len() as i64 { decl_of(l, tcx) } else { -1 };
        // (made by a `let` of the same block: extract from there)
        if dn >= 0 && parent(dn, tcx) >= 0 && parent(parent(dn, tcx), tcx) == blk {
            try_extract(name, new_name, line_of(pcx.nodes[dn as usize].start, pcx), lb, tcx,
                pcx);
        } else {
            try_show_at(file, la, tcx, pcx);
        }
        return 1;
    }
    let mut back: i64 = 0;
    for i in 0..params.len() as i64 {
        if (modes[i as usize]) == GIVEN_BACK {
            back += 1;
            results.push((params[i as usize]));
        }
        if (modes[i as usize]) == BY_POINTER {
            // (`&x` in the lines is `x`, a pointer there)
            for n in 1..pcx.nodes.len() as i64 {
                if local_of(n, pcx) == (params[i as usize]) && in_body(n, tcx)
                    && pcx.nodes[n as usize].start >= sa && pcx.nodes[n as usize].end <= sb
                    && use_kind(n, tcx, pcx) == USE_ADDR {
                    let u = parent(n, tcx);
                    amp_s.push(pcx.nodes[u as usize].start);
                    amp_e.push(pcx.nodes[n as usize].start);
                    amp_t.push(buf_new());
                }
            }
        }
    }
    if (back > 0 && results.len() as i64 > 1) || (tail >= 0 && results.len() as i64 > 0) {
        let e = diag(c"error", c"refactor.results", tcx);
        buf_str(e, c"lines ");
        put_range(e, la, lb);
        buf_str(e,
            if tail >= 0 { c" end the block with its value and set " } else { c" set " });
        for i in 0..results.len() as i64 {
            buf_str(e, if i == 0 { c"" } else { c", " });
            buf_bytes(e, local_name((results[i as usize]), pcx));
        }
        buf_str(e,
            c", used after them; NEW gives back one local it assigns, or the ones it declares\n");
        try_show_at(file, la, tcx, pcx);
        return 1;
    }
    let kind = pcx.defs[d as usize].kind;
    if self_local >= 0 && kind != K_METHOD {
        let e = diag(c"error", c"refactor.self", tcx);
        buf_str(e, c"lines ");
        put_range(e, la, lb);
        buf_str(e, c" use self in a trait impl's function: NEW cannot be a method there\n");
        return 1;
    }
    if taken_name(d, intern(new_name, pcx), self_local >= 0, pcx) {
        let e = diag(c"error", c"refactor.collision", tcx);
        buf_str(e, c"'");
        buf_bytes(e, new_name);
        buf_str(e, c"' is already a name there\n");
        try_query(c"def", new_name, tcx, pcx);
        return 1;
    }
    // NEW's text, after FN (a method: in its impl, else after it).
    let method = self_local >= 0;
    let outer = if kind == K_FN || method { f } else { pcx.defs[d as usize].impl_node };
    let base = if method { indent_of(pcx.nodes[f as usize].start, pcx) }
        else { indent_of(pcx.nodes[outer as usize].start, pcx) };
    let text = buf_new();
    buf_byte(text, b'\n');
    buf_bytes(text, base);
    buf_str(text, c"fn ");
    buf_bytes(text, new_name);
    buf_byte(text, b'(');
    if method {
        let sp = decl_of(self_local, tcx);
        // (0.20: the receiver as written, `self`, `inout self`;
        // 0.28.0, the rust edition's `&self`, `&mut self`)
        buf_bytes(text,
            &get_src()[
                pcx.nodes[sp as usize].start as usize..pcx.nodes[sp as usize].end as usize]);
    }
    for i in 0..params.len() as i64 {
        if i > 0 || method {
            buf_str(text, c", ");
        }
        // (0.20: in 0.20's spelling, but in the crate read in 0.19's,
        // fixconv::new_spelling: `x: sink T`, `x: inout T`)
        if (modes[i as usize]) == GIVEN_BACK {
            buf_str(text, c"mut ");
        }
        buf_bytes(text, local_name((params[i as usize]), pcx));
        buf_str(text, c": ");
        if (modes[i as usize]) == BY_POINTER {
            // (0.18.1: a reference; a `*T` is raw)
            buf_str(text, c"&mut ");
        }
        put_local_type(text, (params[i as usize]), tcx, pcx);
    }
    buf_byte(text, b')');
    let result_type = buf_new();
    if results.len() as i64 == 1 {
        put_local_type(result_type, (results[0]), tcx, pcx);
    } else if results.len() as i64 > 1 {
        buf_byte(result_type, b'(');
        for i in 0..results.len() as i64 {
            buf_str(result_type, if i == 0 { c"" } else { c", " });
            put_local_type(result_type, (results[i as usize]), tcx, pcx);
        }
        buf_byte(result_type, b')');
    }
    else if tail >= 0 && pcx.nodes[tail as usize].ty != TY_UNIT
        && pcx.nodes[tail as usize].ty != TY_NEVER
        && pcx.nodes[tail as usize].ty != 0 {
        put_type_conv(result_type, pcx.nodes[tail as usize].ty, false, tcx, pcx);
    }
    if buf_len(result_type) > 0 {
        buf_str(text, c" -> ");
        buf_bytes(text, buf_slice(result_type));
    }
    buf_str(text, c" {\n");
    let inner = buf_new();
    buf_bytes(inner, base);
    buf_str(inner, c"    ");
    let unsafe_wrap = in_unsafe(f, if stmts.len() as i64 > 0 { (stmts[0]) } else { tail },
        tcx, pcx);
    if unsafe_wrap {
        buf_bytes(text, buf_slice(inner));
        buf_str(text, c"unsafe {\n");
        buf_str(inner, c"    ");
    }
    let lines_text = text_with(ra, rb, amp_s.as_slice(), amp_e.as_slice(), amp_t.as_slice());
    reindent(text, buf_slice(lines_text), buf_slice(inner));
    if results.len() as i64 > 0 {
        buf_bytes(text, buf_slice(inner));
        put_results(text, results.as_slice(), false, 0, tcx, pcx);
        buf_byte(text, b'\n');
    }
    if unsafe_wrap {
        buf_bytes(text, base);
        buf_str(text, c"    }\n");
    }
    buf_bytes(text, base);
    buf_str(text, c"}\n");
    // The call, where the lines were.
    let call = buf_new();
    buf_bytes(call, indent_of(sa, pcx));
    if results.len() as i64 == 1 && back == 1 {
        buf_bytes(call, local_name((results[0]), pcx));
        buf_str(call, c" = ");
    } else if results.len() as i64 > 0 {
        let pat = buf_new();
        put_results(pat, results.as_slice(), true, sb, tcx, pcx);
        let ps = buf_slice(pat);
        buf_str(call, c"let ");
        buf_bytes(call, ps);
        buf_str(call, c" = ");
    }
    if method {
        buf_str(call, c"self.");
    }
    buf_bytes(call, new_name);
    buf_byte(call, b'(');
    for i in 0..params.len() as i64 {
        buf_str(call, if i == 0 { c"" } else { c", " });
        if (modes[i as usize]) == BY_POINTER {
            buf_str(call, c"&mut ");
        }
        buf_bytes(call, local_name((params[i as usize]), pcx));
    }
    buf_byte(call, b')');
    if tail < 0 {
        buf_byte(call, b';');
    }
    buf_byte(call, b'\n');
    edit_replace(ra, rb, call, pcx);
    let at = after_line(pcx.nodes[outer as usize].end - 1, pcx);
    edit_replace(at, at, text, pcx);
    let what = buf_new();
    buf_str(what, c"extracted lines ");
    put_range(what, la, lb);
    buf_str(what, c" of ");
    buf_bytes(what, fqn);
    buf_str(what, c" into ");
    buf_bytes(what, new_name);
    buf_byte(what, b'(');
    for i in 0..params.len() as i64 {
        buf_str(what, if i == 0 { c"" } else { c", " });
        buf_bytes(what, local_name((params[i as usize]), pcx));
    }
    buf_byte(what, b')');
    if buf_len(result_type) > 0 {
        buf_str(what, c" -> ");
        buf_bytes(what, buf_slice(result_type));
    }
    apply_edit(buf_slice(what), root, tcx, pcx)
}

// `A-B` (or `A`) into *a, *b: line numbers, 1 <= A <= B.
fn line_range(s: &[u8], a: &mut i64, b: &mut i64) -> bool {
    let mut i: i64 = 0;
    let mut x: i64 = 0;
    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
        x = x * 10 + (s[i as usize] - b'0') as i64;
        i += 1;
    }
    let mut y = x;
    if i < s.len() as i64 && s[i as usize] == b'-' {
        i += 1;
        let from = i;
        y = 0;
        while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
            y = y * 10 + (s[i as usize] - b'0') as i64;
            i += 1;
        }
        if i == from {
            return false;
        }
    }
    *a = x;
    *b = y;
    i == s.len() as i64 && x >= 1 && y >= x
}

fn put_range(out: i64, a: i64, b: i64) {
    buf_int(out, a);
    buf_byte(out, b'-');
    buf_int(out, b);
}

// How the lines [sa, sb) use local l, declared before them: given back
// when they assign it (or use its value and take its address), by
// pointer when they only take its address or write its fields, else by
// value.
fn mode_of(l: i64, sa: i64, sb: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut assign = false;
    let mut address = false;
    let mut value = false;
    // (an array indexed: by pointer, `a[i]` would index the pointer)
    let mut indexed = false;
    for n in 1..pcx.nodes.len() as i64 {
        if local_of(n, pcx) != l || !in_body(n, tcx) || pcx.nodes[n as usize].start < sa
            || pcx.nodes[n as usize].end > sb {
            continue;
        }
        let p = parent(n, tcx);
        if p >= 0 && pcx.nodes[p as usize].kind == NodeKind::Index && pcx.nodes[p as usize].a == n
            && !is_pointer(pcx.nodes[n as usize].ty, pcx) {
            indexed = true;
        }
        // (0.14: a `move` closure changes its own copy)
        let k = if captured_by_move(n, tcx, pcx) { USE_VALUE } else { use_kind(n, tcx, pcx) };
        if k == USE_ASSIGN {
            assign = true;
        } else if k == USE_ADDR || k == USE_AUTOREF || k == USE_FIELD_WRITE {
            address = true;
        } else if k == USE_VALUE {
            value = true;
        }
    }
    if assign || (address && (value || indexed)) {
        GIVEN_BACK
    } else if address {
        BY_POINTER
    } else {
        BY_VALUE
    }
}

// Whether local l is used at or after position pos.
fn used_after(l: i64, pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() as i64 {
        if local_of(n, pcx) == l && in_body(n, tcx) && pcx.nodes[n as usize].start >= pos {
            return true;
        }
    }
    false
}

// Whether the loop break or continue n leaves is inside [sa, sb).
fn loop_inside(n: i64, sa: i64, sb: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let label = pcx.nodes[n as usize].a;
    let mut q = parent(n, tcx);
    while q >= 0 {
        let k = pcx.nodes[q as usize].kind;
        if (k == NodeKind::Loop || k == NodeKind::While || k == NodeKind::For)
            && (label == 0 || pcx.nodes[q as usize].a == label) {
            return pcx.nodes[q as usize].start >= sa && pcx.nodes[q as usize].end <= sb;
        }
        q = parent(q, tcx);
    }
    false
}

// The last line of the statements of stmts before the one holding pos;
// -1 when that is the first.
fn statements_before(stmts: &[i64], pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut last: i64 = -1;
    for i in 0..stmts.len() as i64 {
        let s = (stmts[i as usize]);
        if pcx.nodes[s as usize].end <= pos
            && !(pcx.nodes[s as usize].start <= pos && pos < pcx.nodes[s as usize].end) {
            last = line_of(pcx.nodes[s as usize].end - 1, pcx);
        }
    }
    last
}

fn contains(v: &[i64], x: i64) -> bool {
    for i in 0..v.len() as i64 {
        if (v[i as usize]) == x {
            return true;
        }
    }
    false
}

fn bytes_is(s: &[u8], c: *mut u8) -> bool {
    let t = c_slice(c);
    if s.len() != t.len() {
        return false;
    }
    for i in 0..s.len() {
        if s[i] != t[i] {
            return false;
        }
    }
    true
}

// The first use in [sa, sb) of local l.
fn first_use(l: i64, sa: i64, sb: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut first = sb;
    for n in 1..pcx.nodes.len() as i64 {
        if local_of(n, pcx) == l && in_body(n, tcx) && pcx.nodes[n as usize].start >= sa
            && pcx.nodes[n as usize].start < first {
            first = pcx.nodes[n as usize].start;
        }
    }
    first
}

fn sort_by_first_use(params: &mut Vec<i64, Comp>, modes: &mut Vec<i64, Comp>, sa: i64, sb: i64,
    tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let n = params.len() as i64;
    for i in 1..n {
        let mut j = i;
        while j > 0
            && first_use((params[j as usize]), sa, sb, tcx, pcx)
            < first_use((params[(j - 1) as usize]), sa, sb, tcx, pcx) {
            let t = (params[j as usize]);
            (params[j as usize]) = (params[(j - 1) as usize]);
            (params[(j - 1) as usize]) = t;
            let m = (modes[j as usize]);
            (modes[j as usize]) = (modes[(j - 1) as usize]);
            (modes[(j - 1) as usize]) = m;
            j -= 1;
        }
    }
}

// Whether `name` is taken where NEW goes: an item of FN's module, or a
// method of its type (method).
fn taken_name(d: i64, name: i64, method: bool, pcx: &Ctx<Comp>) -> bool {
    for x in 0..pcx.defs.len() {
        if pcx.defs[x].name != name {
            continue;
        }
        let k = pcx.defs[x].kind;
        if method && k == K_METHOD && pcx.defs[x].owner == pcx.defs[d as usize].owner {
            return true;
        }
        if !method && pcx.defs[x].module == pcx.defs[d as usize].module && k != K_METHOD
            && k != K_IMPL_METHOD
            && pcx.defs[x].parent < 0 {
            return true;
        }
    }
    false
}

// The results: `x`, or `(a, b)`; as a pattern, with `mut` where they
// were declared so and are changed at or after `after`.
fn put_results(out: i64, results: &[i64], pattern: bool, after: i64, tcx: &Tcx<Comp>,
    pcx: &Ctx<Comp>) {
    let n = results.len() as i64;
    if n > 1 {
        buf_byte(out, b'(');
    }
    for i in 0..n {
        let l = (results[i as usize]);
        buf_str(out, if i == 0 { c"" } else { c", " });
        if pattern && local_mut(l, pcx) && changed_after(l, after, tcx, pcx) {
            buf_str(out, c"mut ");
        }
        buf_bytes(out, local_name(l, pcx));
    }
    if n > 1 {
        buf_byte(out, b')');
    }
}

// Whether local l is assigned (or its address taken, a field of it
// written) at or after position pos.
fn changed_after(l: i64, pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for n in 1..pcx.nodes.len() as i64 {
        if local_of(n, pcx) == l && in_body(n, tcx) && pcx.nodes[n as usize].start >= pos
            && use_kind(n, tcx, pcx) != USE_VALUE
            && use_kind(n, tcx, pcx) != USE_FIELD_READ {
            return true;
        }
    }
    false
}

// The lines A-B cut statement s: the range of whole statements, to try.
fn cut_statement(fqn: &[u8], name: &[u8], new_name: &[u8], la: i64, lb: i64, s: i64,
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let sa = line_of(pcx.nodes[s as usize].start, pcx);
    let sb = line_of(pcx.nodes[s as usize].end - 1, pcx);
    let e = diag(c"error", c"refactor.range", tcx);
    buf_str(e, c"lines ");
    put_range(e, la, lb);
    buf_str(e, c" cut a statement of ");
    buf_bytes(e, fqn);
    buf_str(e, c" (lines ");
    put_range(e, sa, sb);
    buf_str(e, c"); NEW takes whole statements of one block\n");
    try_extract(name, new_name, if sa < la { sa } else { la }, if sb > lb { sb } else { lb }, tcx,
        pcx);
    1
}

fn try_extract(name: &[u8], new_name: &[u8], a: i64, b: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" refactor extract-function");
    put_word(out, name);
    buf_str(out, c" --lines ");
    put_range(out, a, b);
    buf_str(out, c" --to");
    put_word(out, new_name);
    put_root(out, tcx);
    try_end(out);
}

fn try_query(cmd: *mut u8, what: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    buf_str(out, c" query ");
    buf_str(out, cmd);
    put_word(out, what);
    put_root(out, tcx);
    try_end(out);
}

fn try_show(fqn: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    try_query(c"show", fqn, tcx, pcx);
}

fn try_show_at(file: i64, line: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let b = buf_new();
    put_path(b, file, pcx);
    buf_byte(b, b':');
    buf_int(b, line);
    try_query(c"show", buf_slice(b), tcx, pcx);
}
