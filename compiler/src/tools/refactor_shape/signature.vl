// `refactor signature FN`: a parameter added, removed, renamed, reordered
// or retyped, in the function (with a trait's function, the trait's
// declaration and every impl's) and in every call the checker resolved.

use std::alloc::Arena;

use crate::base::{
    buf_byte, buf_bytes, buf_copy, buf_int, buf_new, buf_str, get_src, intern, intern_c, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::Call;
use crate::front::ast::NodeKind;
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::Tok;
use crate::front::modules::{file_made, file_of_pos};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{apply_edit, set_command};
use crate::tools::query::{QF_CALL, QF_DEF, c_slice, root_or_diag};
use crate::tools::query::defs::{
    K_FN, K_IMPL_METHOD, K_METHOD, K_TRAIT_FN, bytes_eq, def_of_node, trait_of,
};
use crate::tools::query::diagnostics::{diag, put_root, put_word, try_end, write_diags};
use crate::tools::query::positions::{enclosing, put_loc, shorthand_at, shorthand_text, token_at};
use crate::tools::refactor_shape::{
    find_byte, has_call, leading_name, list_insert, list_of_node, list_of_params, list_permute,
    list_remove, load_and_find, name_token, opt, orig_of, put_count, refs_of, replace_name,
    shape_options, split_default, sym_text, take_args, text_buf, try_query_name, try_refactor,
    try_show_at, usage_error,
};
use crate::tools::rewrite::sort_by_start;
use crate::tools::rewrite::parsed::{pa, pb, pc, pchild, pcount, pend, pk, pstart};

// ---- refactor signature ----

pub fn run_signature(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = signature_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

// The definitions changed with d: a trait's function and its impls' (d
// is either), else d alone; d first.
pub fn signature_group(d: i64, group: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    group.push(d);
    let mut t: i64 = -1;
    if pcx.defs[d as usize].kind == K_TRAIT_FN {
        t = d;
    } else if pcx.defs[d as usize].kind == K_IMPL_METHOD {
        let td = trait_of(d, tcx, pcx);
        for x in 0..pcx.defs.len() as i64 {
            if td >= 0 && pcx.defs[x as usize].kind == K_TRAIT_FN
                && pcx.defs[x as usize].parent == td
                && pcx.defs[x as usize].name == pcx.defs[d as usize].name {
                t = x;
            }
        }
    }
    if t < 0 {
        return;
    }
    if t != d {
        group.push(t);
    }
    for x in 0..pcx.defs.len() as i64 {
        if x != d && pcx.defs[x as usize].kind == K_IMPL_METHOD
            && pcx.defs[x as usize].name == pcx.defs[t as usize].name
            && trait_of(x, tcx, pcx) == pcx.defs[t as usize].parent {
            group.push(x);
        }
    }
}

fn in_group(group: &[i64], d: i64) -> bool {
    for i in 0..group.len() as i64 {
        if (group[i as usize]) == d {
            return true;
        }
    }
    false
}

// The calls of the functions of `group`, as written (Call or MethodCall
// nodes; an operator's: its Binary, Unary, Index node), each once.
fn calls_of(group: &[i64], out: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n as usize].kind != NodeKind::Call || pcx.nodes[n as usize].x <= 0 {
            continue;
        }
        let d = def_of_node(pcx.fns[(pcx.nodes[n as usize].x - 1) as usize].node, tcx, pcx);
        if d < 0 || !in_group(group, d) {
            continue;
        }
        let mut o = orig_of(n, NodeKind::Call, tcx, pcx);
        if o < 0 {
            o = orig_of(n, NodeKind::MethodCall, tcx, pcx);
        }
        if o < 0 {
            o = orig_of(n, NodeKind::Binary, tcx, pcx);
        }
        if o < 0 {
            o = orig_of(n, NodeKind::Unary, tcx, pcx);
        }
        if o < 0 {
            o = orig_of(n, NodeKind::Index, tcx, pcx);
        }
        if o < 0 {
            o = orig_of(n, NodeKind::Assign, tcx, pcx);
        }
        if o < 0 || seen.get(o + 1) != 0 {
            continue;
        }
        seen.put(o + 1, 1);
        out.push(o);
    }
    sort_by_start(&mut *out, pcx);
}

// The index of the parameter named `name` of function node f, or -1.
fn param_index(f: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    for i in 0..pcount(f, pcx) {
        if pa(pchild(f, i, pcx), pcx) == name {
            return i;
        }
    }
    -1
}

// Whether flag `name` (an option without a value) is in opts.
fn has_flag(opts: &[i64], name: *mut u8) -> bool {
    for i in 0..opts.len() as i64 {
        if streq((opts[i as usize]) as *mut u8, name) {
            return true;
        }
    }
    false
}

// (0.15) The parameter of f (its index, self counted) that argument i of
// call c gives as written: by its position, or by its label (`name:
// value`; -1 for a name f has not). off: 1 for a method call's self.
fn arg_param(f: i64, c: i64, i: i64, off: i64, pcx: &Ctx<Comp>) -> i64 {
    let a = pchild(c, i, pcx);
    if pk(a, pcx) == NodeKind::NamedArg { param_index(f, pa(a, pcx), pcx) } else { i + off }
}

// (0.15) The argument of call c (its index in the list as written) that
// gives parameter k of f, or -1: none, it is left to its default.
fn arg_for(f: i64, c: i64, k: i64, off: i64, pcx: &Ctx<Comp>) -> i64 {
    for i in 0..pcount(c, pcx) {
        if arg_param(f, c, i, off, pcx) == k {
            return i;
        }
    }
    -1
}

// (0.15) Whether call c of f has a labelled argument or leaves a
// parameter to its default.
fn named_or_short(f: i64, c: i64, off: i64, pcx: &Ctx<Comp>) -> bool {
    if pcount(c, pcx) + off != pcount(f, pcx) {
        return true;
    }
    for i in 0..pcount(c, pcx) {
        if pk(pchild(c, i, pcx), pcx) == NodeKind::NamedArg {
            return true;
        }
    }
    false
}

// (0.15) Argument `value` for new parameter k (named pname) inserted into
// call c (its list read: list_of_node): by its position when every
// parameter before it is given by position, else by its label, among the
// labelled ones in the parameters' order.
pub fn insert_argument(f: i64, c: i64, k: i64, off: i64, value: &[u8], pname: i64, tcx: &Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let mut positional: i64 = 0;
    while positional < pcount(c, pcx) && pk(pchild(c, positional, pcx), pcx) != NodeKind::NamedArg {
        positional += 1;
    }
    if k - off <= positional {
        list_insert(k - off, value, tcx, pcx);
        return;
    }
    let b = buf_new();
    buf_bytes(b, sym_text(pname, pcx));
    buf_bytes(b, b": ");
    buf_bytes(b, value);
    let mut at = pcount(c, pcx);
    for i in positional..pcount(c, pcx) {
        if arg_param(f, c, i, off, pcx) >= k && at == pcount(c, pcx) {
            at = i;
        }
    }
    list_insert(at, &buf_copy(b), tcx, pcx);
}

// (0.15) Call c of f written again with its arguments in the parameters'
// new order perm (the old index of each; self first for a method): a
// parameter left to its default stays so, and every argument after one,
// or after a labelled one, is labelled. Whether two or more of them call
// functions (their order of evaluation changes).
fn reorder_named(f: i64, c: i64, off: i64, perm: &[i64], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let b = buf_new();
    let mut named = false;
    let mut first = true;
    let mut effects: i64 = 0;
    for j in off..perm.len() as i64 {
        let p = (perm[j as usize]);
        let i = arg_for(f, c, p, off, pcx);
        if i < 0 {
            named = true;
            continue;
        }
        let a = pchild(c, i, pcx);
        let v = if pk(a, pcx) == NodeKind::NamedArg { pb(a, pcx) } else { a };
        if has_call(pstart(v, pcx), pend(v, pcx), pcx) {
            effects += 1;
        }
        if !first {
            buf_bytes(b, b", ");
        }
        first = false;
        if pk(a, pcx) == NodeKind::NamedArg || named {
            named = true;
            buf_bytes(b, sym_text(pa(pchild(f, p, pcx), pcx), pcx));
            buf_bytes(b, b": ");
        }
        buf_bytes(b, &get_src()[pstart(v, pcx) as usize..pend(v, pcx) as usize]);
    }
    edit_replace(tcx.l_open, tcx.l_close, b, pcx);
    effects > 1
}

pub fn has_self(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    pcount(f, pcx) > 0 && pa(pchild(f, 0, pcx), pcx) == intern_c(c"self", pcx)
}

// The parameters of f, `(a, b)`, for messages.
fn put_params(out: i64, f: i64, pcx: &Ctx<Comp>) {
    buf_byte(out, b'(');
    for i in 0..pcount(f, pcx) {
        if i > 0 {
            buf_str(out, c", ");
        }
        buf_bytes(out, sym_text(pa(pchild(f, i, pcx), pcx), pcx));
    }
    buf_byte(out, b')');
}

fn no_param(d: i64, f: i64, name: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let e = diag(c"error", c"refactor.no-param", tcx);
    buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
    buf_str(e, c" has no parameter '");
    buf_str(e, name);
    buf_str(e, c"': ");
    put_params(e, f, pcx);
    buf_byte(e, b'\n');
    try_query_name(c"def", sym_text(pcx.defs[d as usize].fqn, pcx), tcx, pcx);
    1
}

// The uses of the names `name` in the body of function node f, as
// written (an identifier, not a path's segment); the first's position
// into *first.
fn name_uses(f: i64, name: i64, out: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let body = pc(f, pcx);
    if body == 0 {
        return;
    }
    for n in 1..tcx.program_end {
        if pk(n, pcx) != NodeKind::Ident || pa(n, pcx) != name || pstart(n, pcx) < pstart(body, pcx)
            || pend(n, pcx) > pend(body, pcx) {
            continue;
        }
        // (`name::x` is a path)
        let t = token_at(pend(n, pcx), pcx);
        if t < pcx.toks.len() as i64 && pcx.toks[t as usize].kind == Tok::ColonColon {
            continue;
        }
        out.push(n);
    }
}

// Whether `name` is bound in the body of f (a let, a pattern).
fn bound_in(f: i64, name: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let body = pc(f, pcx);
    if body == 0 {
        return -1;
    }
    for n in 1..tcx.program_end {
        if pk(n, pcx) == NodeKind::PatBind && pa(n, pcx) == name
            && pstart(n, pcx) >= pstart(body, pcx)
            && pend(n, pcx) <= pend(body, pcx) {
            return pstart(n, pcx);
        }
    }
    -1
}

fn signature_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    set_command(c.line, tcx);
    pcx.prog = c.prog();
    tcx.tool = c"refactor";
    tcx.sub = c"signature";
    let mut root = 0 as *mut u8;
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut opts: Vec<i64, Comp> = Vec::new_in(Comp {});
    let example = c"NAME --add 'x: i64 = 0' --dry-run";
    if !take_args(c, shape_options("signature"), &mut root, &mut words, &mut opts, tcx, pcx) {
        return 2;
    }
    if words.len() as i64 != 1 {
        return usage_error(if words.len() as i64 == 0 { c"a function NAME is needed" }
            else { c"one NAME at a time" }, example, tcx, pcx);
    }
    let add = opt(opts.as_slice(), c"--add", false);
    let at = opt(opts.as_slice(), c"--at", false);
    let remove = opt(opts.as_slice(), c"--remove", false);
    let rename = opt(opts.as_slice(), c"--rename-param", false);
    let reorder = opt(opts.as_slice(), c"--reorder", false);
    let retype = opt(opts.as_slice(), c"--type", false);
    let actions = (add != 0 as *mut u8) as i64 + (remove != 0 as *mut u8) as i64 + (rename
        != 0 as *mut u8) as i64
        + (reorder != 0 as *mut u8) as i64 + (retype != 0 as *mut u8) as i64;
    if actions != 1 {
        return usage_error(c"one of --add, --remove, --rename-param, --reorder, --type",
            example, tcx, pcx);
    }
    if at != 0 as *mut u8 && add == 0 as *mut u8 {
        return usage_error(c"--at goes with --add", example, tcx, pcx);
    }
    // (0.28.0: no parameter has a default value, so `--add 'x: T = VALUE'`
    // writes VALUE into every call, what --fill-calls asked for before;
    // the flag is still taken)
    if has_flag(opts.as_slice(), c"--fill-calls") && add == 0 as *mut u8 {
        return usage_error(c"--fill-calls goes with --add", example, tcx, pcx);
    }
    let default = opt(opts.as_slice(), c"--default", false);
    if default != 0 as *mut u8 && retype == 0 as *mut u8 {
        return usage_error(c"--default goes with --type (the calls' new argument)",
            c"NAME --type x T --default EXPR", tcx, pcx);
    }
    let name = c_slice((words[0]) as *mut u8);
    tcx.root_given = root;
    root = root_or_diag(root, tcx.sub, &name, true, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    let mut status: i64 = 0;
    let fn_kinds = (1 << K_FN) | (1 << K_METHOD) | (1 << K_IMPL_METHOD) | (1 << K_TRAIT_FN);
    let d = load_and_find(root, &name, fn_kinds, c"function", &mut status, tcx, pcx, wgx);
    if d < 0 {
        return status;
    }
    let f = pcx.defs[d as usize].node;
    let mut fqn = sym_text(pcx.defs[d as usize].fqn, pcx);
    if pk(f, pcx) == NodeKind::ExternFn || pcx.nodes[f as usize].y == 1 {
        let e = diag(c"error", c"refactor.extern", tcx);
        buf_bytes(e, fqn);
        buf_str(e,
            if pk(f, pcx) == NodeKind::ExternFn { c" is a C function: its signature is C's\n" }
            else { c" is an extern \"C\" fn: C code calls it\n" });
        return 1;
    }
    let mut group: Vec<i64, Comp> = Vec::new_in(Comp {});
    signature_group(d, &mut group, tcx, pcx);
    for i in 1..group.len() as i64 {
        if pcount(pcx.defs[(group[i as usize]) as usize].node, pcx)
            != pcount(f, pcx) {
            let e = diag(c"error", c"refactor.trait", tcx);
            buf_bytes(e, sym_text(pcx.defs[(group[i as usize]) as usize].fqn, pcx));
            buf_str(e, c" has not the parameters of ");
            buf_bytes(e, fqn);
            buf_byte(e, b'\n');
            return 1;
        }
    }
    let mut calls: Vec<i64, Comp> = Vec::new_in(Comp {});
    calls_of(group.as_slice(), &mut calls, tcx, pcx);
    // The references that are no calls: a function used as a value
    // (its type is its signature's).
    if rename == 0 as *mut u8 {
        refs_of(group.as_slice(), tcx, pcx);
        for r in 0..tcx.r_pos.len() as i64 {
            if ((tcx.r_flags[r as usize]) & (QF_CALL | QF_DEF)) != 0
                || enclosing((tcx.r_pos[r as usize]), tcx, pcx) < 0 {
                continue;
            }
            let e = diag(c"error", c"refactor.fn-value", tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" is used as a value at ");
            put_loc(e, (tcx.r_pos[r as usize]), pcx);
            buf_str(e, c": its type would change; change that use first\n");
            try_query_name(c"refs", fqn, tcx, pcx);
            return 1;
        }
    }
    for i in 0..calls.len() as i64 {
        let c = (calls[i as usize]);
        if pk(c, pcx) != NodeKind::Call && pk(c, pcx) != NodeKind::MethodCall
            && rename == 0 as *mut u8 {
            let e = diag(c"error", c"refactor.operator", tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" is called by an operator at ");
            put_loc(e, pstart(c, pcx), pcx);
            buf_str(e, c": its arguments are the operator's\n");
            return 1;
        }
    }
    let unchecked = unchecked_calls(pcx.defs[d as usize].name, calls.as_slice(), tcx, pcx);
    let self_param = has_self(f, pcx);
    let what = buf_new();
    if add != 0 as *mut u8 {
        let text = c_slice(add);
        let mut vstart: i64 = -1;
        let dend = split_default(&text, &mut vstart);
        let decl = &text[0..dend as usize];
        let pname = leading_name(decl, pcx);
        if pname < 0 || find_byte(decl, b':') < 0 {
            return usage_error(c"--add takes 'NAME: TYPE = VALUE' (VALUE: the calls' argument)",
                example, tcx, pcx);
        }
        if param_index(f, pname, pcx) >= 0 {
            let e = diag(c"error", c"refactor.clash", tcx);
            buf_bytes(e, fqn);
            buf_str(e, c" has a parameter '");
            buf_bytes(e, sym_text(pname, pcx));
            buf_str(e, c"' already\n");
            return 1;
        }
        if vstart < 0 && calls.len() as i64 > 0 {
            let e = diag(c"error", c"refactor.no-default", tcx);
            buf_str(e, c"the calls need a value for ");
            buf_bytes(e, sym_text(pname, pcx));
            buf_str(e, c": --add 'NAME: TYPE = VALUE'\n");
            let out = try_refactor(fqn, tcx, pcx);
            buf_str(out, c" --add");
            let w = text_buf(decl);
            buf_str(w, c" = 0");
            put_word(out, &buf_copy(w));
            buf_str(out, c" --dry-run");
            put_root(out, tcx);
            try_end(out);
            return 2;
        }
        let k = if at != 0 as *mut u8 { crate::tools::query::parse_count(at) }
            else { pcount(f, pcx) };
        if k < 0 || k > pcount(f, pcx) || (k == 0 && self_param) {
            let e = diag(c"error", c"refactor.usage", tcx);
            buf_str(e, c"--at takes a position from ");
            buf_int(e, self_param as i64);
            buf_str(e, c" to ");
            buf_int(e, pcount(f, pcx));
            buf_str(e, c" among ");
            put_params(e, f, pcx);
            buf_byte(e, b'\n');
            return 2;
        }
        // (0.28.0: no parameter has a default value: `= VALUE` is the
        // tool's syntax for the argument written into every call)
        let value = if vstart >= 0 { &text[vstart as usize..] } else { &text[0..0] };
        for g in 0..group.len() as i64 {
            let gd = (group[g as usize]);
            list_of_params(pcx.defs[gd as usize].node, pcx.defs[gd as usize].name_pos, tcx,
                pcx);
            list_insert(k, decl, tcx, pcx);
        }
        for i in 0..calls.len() as i64 {
            let c = (calls[i as usize]);
            list_of_node(c, tcx, pcx);
            let off: i64 = if pk(c, pcx) == NodeKind::MethodCall && self_param { 1 }
                else { 0 };
            insert_argument(f, c, k, off, value, pname, tcx, pcx);
        }
        buf_str(what, c"added parameter ");
        buf_bytes(what, decl);
        buf_str(what, c" to ");
    } else if remove != 0 as *mut u8 {
        let pname = intern(&c_slice(remove), pcx);
        let k = param_index(f, pname, pcx);
        if k < 0 {
            return no_param(d, f, remove, tcx, pcx);
        }
        if k == 0 && self_param {
            return usage_error(
                c"self is not removed: the function would be another kind (refactor move)",
                example, tcx, pcx);
        }
        for g in 0..group.len() as i64 {
            let gf = pcx.defs[(group[g as usize]) as usize].node;
            let gname = pa(pchild(gf, k, pcx), pcx);
            let mut uses: Vec<i64, Comp> = Vec::new_in(Comp {});
            name_uses(gf, gname, &mut uses, tcx, pcx);
            if uses.len() as i64 > 0 {
                let e = diag(c"error", c"refactor.used", tcx);
                buf_str(e, c"parameter ");
                buf_bytes(e, sym_text(gname, pcx));
                buf_str(e, c" is used in ");
                buf_bytes(e,
                    sym_text(pcx.defs[(group[g as usize]) as usize].fqn, pcx));
                buf_str(e, c" at ");
                put_loc(e, pstart((uses[0]), pcx), pcx);
                buf_byte(e, b'\n');
                try_show_at(pstart((uses[0]), pcx), tcx, pcx);
                return 1;
            }
        }
        let mut effects: i64 = -1;
        for g in 0..group.len() as i64 {
            let gd = (group[g as usize]);
            list_of_params(pcx.defs[gd as usize].node, pcx.defs[gd as usize].name_pos, tcx,
                pcx);
            list_remove(k, tcx, pcx);
        }
        for i in 0..calls.len() as i64 {
            let c = (calls[i as usize]);
            list_of_node(c, tcx, pcx);
            let off: i64 = if pk(c, pcx) == NodeKind::MethodCall && self_param { 1 } else { 0 };
            // (0.15: the argument named, or none: left to its default)
            let a = arg_for(f, c, k, off, pcx);
            if a < 0 {
                continue;
            }
            if has_call((tcx.refactor_shape_l_start[a as usize]),
                (tcx.refactor_shape_l_end[a as usize]), pcx)
                && effects < 0 {
                effects = (tcx.refactor_shape_l_start[a as usize]);
            }
            list_remove(a, tcx, pcx);
        }
        if effects >= 0 {
            let e = diag(c"warning", c"refactor.effects", tcx);
            buf_str(e, c"a removed argument calls a function (first: ");
            put_loc(e, effects, pcx);
            buf_str(e, c"); its calls are gone\n");
        }
        buf_str(what, c"removed parameter ");
        buf_bytes(what, sym_text(pname, pcx));
        buf_str(what, c" of ");
    } else if rename != 0 as *mut u8 {
        let old = intern(&c_slice(rename), pcx);
        let new = intern(&c_slice(opt(opts.as_slice(), c"--rename-param", true)), pcx);
        let k = param_index(f, old, pcx);
        if k < 0 {
            return no_param(d, f, rename, tcx, pcx);
        }
        if old == intern_c(c"self", pcx) || new == intern_c(c"self", pcx) {
            return usage_error(c"self keeps its name (a method's first parameter is self)",
                example, tcx, pcx);
        }
        for g in 0..group.len() as i64 {
            let gf = pcx.defs[(group[g as usize]) as usize].node;
            let p = pchild(gf, k, pcx);
            let gold = pa(p, pcx);
            if param_index(gf, new, pcx) >= 0 || bound_in(gf, new, tcx, pcx) >= 0
                || bound_in(gf, gold, tcx, pcx) >= 0
                || has_name(gf, new, tcx, pcx) {
                let e = diag(c"error", c"refactor.clash", tcx);
                buf_bytes(e, sym_text(new, pcx));
                buf_str(e, c" is a name in ");
                buf_bytes(e,
                    sym_text(pcx.defs[(group[g as usize]) as usize].fqn, pcx));
                buf_str(e,
                    if bound_in(gf, gold, tcx, pcx)
                        >= 0 { c" (or the parameter is shadowed there); rename by hand\n" }
                    else { c" already\n" });
                try_query_name(c"show",
                    sym_text(pcx.defs[(group[g as usize]) as usize].fqn, pcx), tcx,
                    pcx);
                return 1;
            }
            replace_name(name_token(pstart(p, pcx), pend(p, pcx), gold, pcx), gold, new, pcx);
            let mut uses: Vec<i64, Comp> = Vec::new_in(Comp {});
            name_uses(gf, gold, &mut uses, tcx, pcx);
            for u in 0..uses.len() as i64 {
                let at = pstart((uses[u as usize]), pcx);
                if shorthand_at(at, tcx, pcx) {
                    // (0.15: `S { x }` becomes `S { x: y }`)
                    edit_replace(at, at + sym_text(gold, pcx).len() as i64,
                        shorthand_text(sym_text(gold, pcx), sym_text(new, pcx)), pcx);
                } else {
                    replace_name(at, gold, new, pcx);
                }
            }
        }
        // (0.15: and the calls' labels, `old: value`)
        for i in 0..calls.len() as i64 {
            let c = (calls[i as usize]);
            for j in 0..pcount(c, pcx) {
                let a = pchild(c, j, pcx);
                if pk(a, pcx) == NodeKind::NamedArg && pa(a, pcx) == old {
                    replace_name(pstart(a, pcx), old, new, pcx);
                }
            }
        }
        buf_str(what, c"renamed parameter ");
        buf_bytes(what, sym_text(old, pcx));
        buf_str(what, c" to ");
        buf_bytes(what, sym_text(new, pcx));
        buf_str(what, c" of ");
    } else if reorder != 0 as *mut u8 {
        // The new order: the names, self first.
        let first = self_param as i64;
        let mut perm: Vec<i64, Comp> = Vec::new_in(Comp {});
        if self_param {
            perm.push(0);
        }
        let s = c_slice(reorder);
        let mut i: i64 = 0;
        while i <= s.len() as i64 {
            let mut e = i;
            while e < s.len() as i64 && s[e as usize] != b',' {
                e += 1;
            }
            let mut a = i;
            while a < e && s[a as usize] == b' ' {
                a += 1;
            }
            let mut b = e;
            while b > a && s[(b - 1) as usize] == b' ' {
                b -= 1;
            }
            if b > a {
                let k = param_index(f, intern(&s[a as usize..b as usize], pcx), pcx);
                if k < first {
                    let nb = buf_new();
                    buf_bytes(nb, &s[a as usize..b as usize]);
                    buf_byte(nb, 0);
                    return no_param(d, f, crate::tools::proc::buf_cstr(nb), tcx, pcx);
                }
                perm.push(k);
            }
            i = e + 1;
        }
        let mut ok = perm.len() as i64 == pcount(f, pcx);
        for x in 0..perm.len() as i64 {
            for y in 0..x {
                if (perm[x as usize]) == (perm[y as usize]) {
                    ok = false;
                }
            }
        }
        if !ok {
            let e = diag(c"error", c"refactor.usage", tcx);
            buf_str(e, c"--reorder lists each parameter once");
            buf_str(e, if self_param { c" (but self, which stays first): " } else { c": " });
            put_params(e, f, pcx);
            buf_byte(e, b'\n');
            return 2;
        }
        for g in 0..group.len() as i64 {
            let gd = (group[g as usize]);
            list_of_params(pcx.defs[gd as usize].node, pcx.defs[gd as usize].name_pos, tcx,
                pcx);
            list_permute(perm.as_slice(), tcx, pcx);
        }
        let mut moved: i64 = -1;
        for c0 in 0..calls.len() as i64 {
            let c = (calls[c0 as usize]);
            list_of_node(c, tcx, pcx);
            let mut cperm: Vec<i64, Comp> = Vec::new_in(Comp {});
            let off: i64 = if pk(c, pcx) == NodeKind::MethodCall && self_param { 1 } else { 0 };
            if named_or_short(f, c, off, pcx) {
                // (0.15: a call with labels, or leaving parameters to
                // their defaults: written again in the new order)
                if reorder_named(f, c, off, perm.as_slice(), tcx, pcx) && moved < 0 {
                    moved = pstart(c, pcx);
                }
                continue;
            }
            let mut effects: i64 = 0;
            for x in off..perm.len() as i64 {
                cperm.push((perm[x as usize]) - off);
                if has_call((tcx.refactor_shape_l_start[(x - off) as usize]),
                    (tcx.refactor_shape_l_end[(x - off) as usize]), pcx) {
                    effects += 1;
                }
            }
            if effects > 1 && moved < 0 {
                moved = pstart(c, pcx);
            }
            list_permute(cperm.as_slice(), tcx, pcx);
        }
        if moved >= 0 {
            let e = diag(c"warning", c"refactor.effects", tcx);
            buf_str(e,
                c"arguments that call functions are evaluated in another order (first: ");
            put_loc(e, moved, pcx);
            buf_str(e, c")\n");
        }
        buf_str(what, c"reordered the parameters of ");
    } else {
        let pname = intern(&c_slice(retype), pcx);
        let k = param_index(f, pname, pcx);
        if k < 0 {
            return no_param(d, f, retype, tcx, pcx);
        }
        let ty = c_slice(opt(opts.as_slice(), c"--type", true));
        // (0.17: to a reference, without --default: the calls' `&x`
        // become `&mut x`, a value `x` becomes `&x` or `&mut x`, a
        // slice `v.as_slice()` or `a[..]` becomes `v.as_mut_slice()`
        // or `&mut a[..]`)
        let auto = ref_change(pb(pchild(f, k, pcx), pcx), &ty, pcx);
        for g in 0..group.len() as i64 {
            let p = pchild(pcx.defs[(group[g as usize]) as usize].node, k, pcx);
            let t = pb(p, pcx);
            let ts = pstart(t, pcx);
            edit_replace(ts, pend(t, pcx), text_buf(&ty), pcx);
        }
        let mut changed: i64 = 0;
        if default == 0 as *mut u8 && auto != RC_NONE {
            for i in 0..calls.len() as i64 {
                let c = (calls[i as usize]);
                list_of_node(c, tcx, pcx);
                let off: i64 = if pk(c, pcx) == NodeKind::MethodCall && self_param { 1 }
                    else { 0 };
                let i0 = arg_for(f, c, k, off, pcx);
                if i0 < 0 {
                    continue;
                }
                let mut v = pchild(c, i0, pcx);
                if pk(v, pcx) == NodeKind::NamedArg {
                    v = pb(v, pcx);
                }
                let nb = ref_argument(auto,
                    &get_src()[pstart(v, pcx) as usize..pend(v, pcx) as usize]);
                if nb >= 0 {
                    edit_replace(pstart(v, pcx), pend(v, pcx), nb, pcx);
                    changed += 1;
                }
            }
        }
        // (--default: each call's argument becomes EXPR, 0.13)
        if default != 0 as *mut u8 {
            for i in 0..calls.len() as i64 {
                let c = (calls[i as usize]);
                list_of_node(c, tcx, pcx);
                let off: i64 = if pk(c, pcx) == NodeKind::MethodCall && self_param { 1 }
                    else { 0 };
                // (0.15: a named argument's value; none: left to the default)
                let i0 = arg_for(f, c, k, off, pcx);
                if i0 < 0 {
                    continue;
                }
                let mut v = pchild(c, i0, pcx);
                if pk(v, pcx) == NodeKind::NamedArg {
                    v = pb(v, pcx);
                }
                let a = pstart(v, pcx);
                let b = pend(v, pcx);
                edit_replace(a, b,
                    with_argument(&c_slice(default), sym_text(pname, pcx),
                        &get_src()[a as usize..b as usize]), pcx);
            }
        }
        buf_str(what, c"changed parameter ");
        buf_bytes(what, sym_text(pname, pcx));
        buf_str(what, c" to ");
        buf_bytes(what, &ty);
        buf_str(what, c" in ");
        if changed > 0 {
            buf_bytes(what, fqn);
            buf_str(what, c", ");
            put_count(what, changed, c"argument", c"arguments");
            buf_str(what, c" in ");
            put_count(what, calls.len() as i64, c"call", c"calls");
            fqn = b"";
        }
    }
    buf_bytes(what, fqn);
    if group.len() as i64 > 1 {
        buf_str(what, c" and ");
        put_count(what, group.len() as i64 - 1, c"other definition", c"other definitions");
    }
    if rename == 0 as *mut u8
        && (retype == 0 as *mut u8 || default != 0 as *mut u8) {
        buf_str(what, c", ");
        put_count(what, calls.len() as i64, c"call", c"calls");
    }
    if unchecked.len() as i64 > 0 {
        let e = diag(c"warning", c"refactor.unchecked", tcx);
        put_count(e, unchecked.len() as i64, c"call", c"calls");
        buf_str(e, c" named ");
        buf_bytes(e, sym_text(pcx.defs[d as usize].name, pcx));
        buf_str(e, c" in code the checker did not see (a generic function never instantiated) are not changed; first: ");
        put_loc(e, pstart((unchecked[0]), pcx), pcx);
        buf_byte(e, b'\n');
    }
    apply_edit(&buf_copy(what), root, tcx, pcx)
}

// --default EXPR for a call whose argument was `arg`: EXPR with `$NAME`
// (the parameter's name) replaced by the argument, in parentheses unless
// it is a name, a number or a path (0.13). A buffer.
pub fn with_argument(expr: &[u8], name: &[u8], arg: &[u8]) -> i64 {
    let out = buf_new();
    let mut plain = arg.len() > 0;
    for i in 0..arg.len() {
        let c = arg[i];
        if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
            || c == b'_' || c == b'.' || c == b':') {
            plain = false;
        }
    }
    let mut i: i64 = 0;
    while i < expr.len() as i64 {
        let e = i + 1 + name.len() as i64;
        let ends = e >= expr.len() as i64
            || !(expr[e as usize] == b'_' || (expr[e as usize] >= b'a' && expr[e as usize] <= b'z')
                || (expr[e as usize] >= b'A' && expr[e as usize] <= b'Z')
                || (expr[e as usize] >= b'0' && expr[e as usize] <= b'9'));
        if expr[i as usize] == b'$' && e <= expr.len() as i64
            && bytes_eq(&expr[(i + 1) as usize..e as usize], name) && ends {
            // (0.17: `&$x` or `&mut $x` of an argument `&v` is `&v` or
            // `&mut v`, not a reference to a reference)
            let mut a = arg;
            let mut p = plain;
            let had = buf_copy(out);
            if had.len() > 0 && had[(had.len() as i64 - 1) as usize] == b'&' || had.len() >= 5
                && bytes_eq(&had[(had.len() as i64 - 5) as usize..], b"&mut ") {
                if a.len() > 5 && bytes_eq(&a[0..5], b"&mut ") {
                    a = &a[5..a.len()];
                } else if a.len() > 1 && a[0] == b'&' && a[1] != b'&' {
                    a = &a[1..a.len()];
                }
                p = plain_text(a);
            }
            if !p {
                buf_byte(out, b'(');
            }
            buf_bytes(out, a);
            if !p {
                buf_byte(out, b')');
            }
            i = e;
        } else {
            buf_byte(out, expr[i as usize]);
            i += 1;
        }
    }
    out
}

// How the calls' arguments change when a parameter of type `old` (a
// parsed type node) becomes `ty` (0.17): RC_NONE, nothing; RC_MUT, `&x`
// becomes `&mut x`; RC_REF, a value `x` becomes `&x`; RC_REF_MUT, `&mut
// x`; RC_MUT_SLICE, a slice `v.as_slice()` or `a[..]` becomes
// `v.as_mut_slice()` or `&mut a[..]`.
const RC_NONE: i64 = 0;
const RC_MUT: i64 = 1;
const RC_REF: i64 = 2;
const RC_REF_MUT: i64 = 3;
const RC_MUT_SLICE: i64 = 4;

fn ref_change(old: i64, ty: &[u8], pcx: &Ctx<Comp>) -> i64 {
    // (0.20: `inout T` is `&mut T`, and its calls are marked `&x`)
    let to_mut = starts(ty, b"&mut ") || starts(ty, b"inout ");
    let to_ref = !to_mut && ty.len() > 1 && ty[0] == b'&' && ty[1] != b'&';
    if !to_mut && !to_ref {
        return RC_NONE;
    }
    let mut rest: i64 = if ty[0] == b'i' { 6 } else if to_mut { 5 } else { 1 };
    while rest < ty.len() as i64 && ty[rest as usize] == b' ' {
        rest += 1;
    }
    let slice = rest < ty.len() as i64 && ty[rest as usize] == b'['
        && find_byte(&ty[rest as usize..], b';') < 0;
    if pk(old, pcx) == NodeKind::TyPtr {
        return if to_mut { RC_MUT } else { RC_NONE };
    }
    if pk(old, pcx) == NodeKind::TySlice {
        return if to_mut && slice { RC_MUT_SLICE } else { RC_NONE };
    }
    if to_mut { RC_REF_MUT } else { RC_REF }
}

fn starts(s: &[u8], p: &[u8]) -> bool {
    s.len() >= p.len() && bytes_eq(&s[0..p.len()], p)
}

// The argument `arg` changed as `how` says (ref_change), a buffer; -1:
// left as it is.
fn ref_argument(how: i64, arg: &[u8]) -> i64 {
    let out = buf_new();
    // (0.20: the inout marker is `&x`)
    let marker = c"&";
    if how == RC_MUT {
        // (a let argument, `x`, becomes `&x`; `&x` is the marker already)
        if starts(arg, b"&") {
            return -1;
        }
        buf_str(out, c"&");
        if plain_text(arg) {
            buf_bytes(out, arg);
        } else {
            buf_byte(out, b'(');
            buf_bytes(out, arg);
            buf_byte(out, b')');
        }
        return out;
    }
    if how == RC_MUT_SLICE {
        let tail = b".as_slice()";
        if arg.len() > tail.len()
            && bytes_eq(&arg[(arg.len() as i64 - tail.len() as i64) as usize..], tail) {
            buf_bytes(out, &arg[0..(arg.len() as i64 - tail.len() as i64) as usize]);
            buf_str(out, c".as_mut_slice()");
            return out;
        }
        if !starts(arg, b"&") && arg.len() > 2
            && arg[(arg.len() as i64 - 1) as usize] == b']'
            && find_byte(arg, b'.') >= 0 && find_dots(arg) {
            buf_str(out, marker);
            buf_bytes(out, arg);
            return out;
        }
        return -1;
    }
    if how == RC_REF || how == RC_REF_MUT {
        if starts(arg, b"&") {
            return -1;
        }
        buf_str(out, if how == RC_REF { c"&" } else { marker });
        if plain_text(arg) {
            buf_bytes(out, arg);
        } else {
            buf_byte(out, b'(');
            buf_bytes(out, arg);
            buf_byte(out, b')');
        }
        return out;
    }
    -1
}

// Whether arg holds `..` (a range: `a[i..j]`).
fn find_dots(arg: &[u8]) -> bool {
    for i in 0..arg.len() as i64 - 1 {
        if arg[i as usize] == b'.' && arg[(i + 1) as usize] == b'.' {
            return true;
        }
    }
    false
}

// Whether arg needs no parentheses after a prefix: a name, a path, a
// field (`self.items`), a number.
fn plain_text(arg: &[u8]) -> bool {
    if arg.len() == 0 {
        return false;
    }
    for i in 0..arg.len() {
        let c = arg[i];
        if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
            || c == b'_' || c == b'.' || c == b':') {
            return false;
        }
    }
    true
}

// Whether `name` is written as an identifier in the body of f.
fn has_name(f: i64, name: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut uses: Vec<i64, Comp> = Vec::new_in(Comp {});
    name_uses(f, name, &mut uses, tcx, pcx);
    uses.len() as i64 > 0
}

// The calls written with name `name` that the checker never resolved
// (in code it did not check), but `calls`.
fn unchecked_calls(name: i64, calls: &[i64], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> Vec<i64, Comp> {
    let mut out: Vec<i64, Comp> = Vec::new_in(Comp {});
    for n in 1..tcx.program_end {
        if in_group(calls, n) {
            continue;
        }
        let k = pk(n, pcx);
        let named = (k == NodeKind::MethodCall && pb(n, pcx) == name)
            || (k == NodeKind::Call && pk(pa(n, pcx), pcx) == NodeKind::Ident
                && pa(pa(n, pcx), pcx) == name);
        if !named
            || file_made(file_of_pos(pstart(n, pcx), pcx), pcx) {
            continue;
        }
        if pcx.nodes[n as usize].kind == NodeKind::MethodCall
            || (pcx.nodes[n as usize].kind == NodeKind::Call && pcx.nodes[n as usize].x == 0
                && pcx.nodes[pcx.nodes[n as usize].a as usize].res
                == crate::front::check::Res::None) {
            out.push(n);
        }
    }
    out
}
