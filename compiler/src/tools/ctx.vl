// (0.29) n zeros: a table indexed by an id (a definition, a file, a
// line), where a raw `alloc_array::<i64>(n)` stood.
pub fn zeros(n: i64) -> Vec<i64, Comp> {
    let mut v: Vec<i64, Comp> = Vec::new_in(Comp {});
    v.resize(n as usize, 0);
    v
}

// (0.29) n times false: a set of ids, where a raw `alloc_array::<bool>(n)`
// stood.
pub fn falses(n: i64) -> Vec<bool, Comp> {
    let mut v: Vec<bool, Comp> = Vec::new_in(Comp {});
    v.resize(n as usize, false);
    v
}

// (0.29) n null C strings: an argv to fill and hand to exec (the null
// after the last argument is one of them).
pub fn cptrs(n: i64) -> Vec<*const u8, Comp> {
    let mut v: Vec<*const u8, Comp> = Vec::new_in(Comp {});
    // (pushed: std 0.28's resize clones through the pointer)
    for _ in 0..n {
        v.push(0 as *mut u8);
    }
    v
}

// (0.29) A copy of a list: for a call that reads one of the context's
// lists while it changes the context.
pub fn list_copy(v: &[i64]) -> Vec<i64, Comp> {
    let mut c: Vec<i64, Comp> = Vec::new_in(Comp {});
    c.extend_from_slice(v);
    c
}
