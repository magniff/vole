// The tools' context (0.26.4, statics P2): what were the tools' statics,
// one field each, made once per process by main or cli::run::run and
// passed down last as `tcx` (tools/statics/tools-tcx.group, `volec fix
// --only statics`). A field keeps its static's first value and lives as
// long as the process did, so that a batch's or the language server's
// commands see what the earlier ones left. The comment above a field
// names the static it was.

use std::alloc::Allocator;

use crate::base::comp::Comp;
use crate::middle::lower::ssa::HMap;
use crate::tools::query::typeat::TypedIndex;
use crate::tools::testrun::program::Job;

pub struct Tcx<A: Allocator> {
    // (tools::query::OPT_OVER)
    pub opt_over: i64,
    // (tools::query::OPT_MAX_LINES)
    pub opt_max_lines: i64,
    // (tools::query_text::WITH_COMMENTS)
