// A new context: every field at its static's first value.
pub fn tcx_new() -> Tcx<Comp> {
    Tcx {
        opt_over: 1000,
        opt_max_lines: 1000,
        with_comments: false,
        stdin_read: -1,
        new_path: Vec::new_in(Comp {}),
        new_text: Vec::new_in(Comp {}),
