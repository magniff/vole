// `volec --fix-imports FILE...` (0.8): rewrites a program written for
// 0.7 or earlier, in place, into the imports 0.8 allows; and the errors
// for the forms 0.8 removed, which name what replaces them.
//
//   - `use a::b::*;` and `use E::*;` become `use a::b::{x, y};` (or `use
//     a::b::x;`), listing the names the program finds through that `*`
//     (sorted); a `*` nothing is found through is removed.
//   - `import "h.h";` becomes `import "h.h" as c;` (every header's
//     declarations are in one C module, so one name serves them all), and
//     each use of a declaration found through it is written `c::name`.
//
// The program is checked as for compiling it; the module resolution
// records what each `*` brought (modules.vl, LEGACY_IMPORTS). Every
// file of the program (its modules' files too) is rewritten; the rest of
// the text is left as it is.

use crate::base::{
    _setjmp, buf_byte, buf_bytes, buf_copy, buf_new, buf_str, get_src, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_file_line, err_begin, err_end, err_end_soft, err_help, err_str, err_sym, err_try_tool,
    recover_enter, recover_leave,
};
use crate::front::modules::{file_of_pos, within_std};
use crate::front::modules::lookup::{
    B_MODULE, B_NONE, binding, glob_name_qualified, lookup_quiet, use_entry_count, use_entry_glob,
    use_entry_module, use_entry_node,
};
use crate::tools::edit::edit_replace;
use crate::tools::query::refs::ref_in;

// The longest line a rewritten `use` keeps on one line.
const LINE_WIDTH: i64 = 100;

fn sym_less(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let x = sym_text(a, pcx);
    let y = sym_text(b, pcx);
    let n = if x.len() < y.len() { x.len() as i64 } else { y.len() as i64 };
    for i in 0..n {
        if x[i as usize] != y[i as usize] {
            return x[i as usize] < y[i as usize];
        }
    }
    x.len() < y.len()
}

// Whether entry u is a plain `import "h.h";`.
pub fn is_plain_import(u: i64, pcx: &Ctx<Comp>) -> bool {
    use_entry_glob(u, pcx) && pcx.nodes[use_entry_node(u, pcx) as usize].d == 2
}

// The names the program finds through `*` entry u, sorted, into `out`;
// the C declarations written with their path are left out, and `alias`
// (the C module's name) takes their place.
pub fn glob_names(u: i64, alias: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let mut qualified = false;
    let mut i: i64 = 0;
    while i < pcx.glob_uses.len() as i64 {
        if (pcx.glob_uses[i as usize]) == u {
            let name = (pcx.glob_uses[(i + 1) as usize]);
            if glob_name_qualified(u, name, pcx) {
                qualified = true;
            } else {
                out.push(name);
            }
        }
        i += 2;
    }
    if qualified {
        let mut known = false;
        for k in 0..out.len() as i64 {
            if (out[k as usize]) == alias {
                known = true;
            }
        }
        if !known {
            out.push(alias);
        }
    }
    sort_syms(out, pcx);
}

fn sort_syms(v: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for k in 1..v.len() as i64 {
        let mut j = k;
        while j > 0
            && sym_less((v[j as usize]), (v[(j - 1) as usize]), pcx) {
            let t = (v[j as usize]);
            (v[j as usize]) = (v[(j - 1) as usize]);
            (v[(j - 1) as usize]) = t;
            j -= 1;
        }
    }
}

// The name for the C module: `c`, unless a module that needs it already
// has another `c` in scope.
pub fn c_alias(pcx: &mut Ctx<Comp>) -> i64 {
    let candidates: [*mut u8; 3] = [c"c", c"c_", c"cdecl"];
    for k in 0..3 {
        let name = intern_c(candidates[k as usize], pcx);
        let mut free = true;
        for u in 0..use_entry_count(pcx) {
            if !use_entry_glob(u, pcx) {
                continue;
            }
            let m = use_entry_module(u, pcx);
            let b = lookup_quiet(m, name, m, pcx);
            if b != B_NONE && (pcx.c_module < 0 || b != binding(B_MODULE, pcx.c_module)) {
                free = false;
            }
        }
        if free {
            return name;
        }
    }
    intern_c(c"cdecl", pcx)
}

fn line_start(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pos, pcx);
    let mut i = pos;
    while i > pcx.files[f as usize].start && get_src()[(i - 1) as usize] != b'\n' {
        i -= 1;
    }
    i
}

fn line_end(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pos, pcx);
    let mut i = pos;
    while i < pcx.files[f as usize].end && get_src()[i as usize] != b'\n' {
        i += 1;
    }
    i
}

fn blank(from: i64, to: i64) -> bool {
    for i in from..to {
        if get_src()[i as usize] != b' ' && get_src()[i as usize] != b'\t'
            && get_src()[i as usize] != b'\r' {
            return false;
        }
    }
    true
}

fn add_edit(edits: &mut Vec<i64, Comp>, pos: i64, del: i64, text: i64) {
    edits.push(pos);
    edits.push(del);
    edits.push(text);
}

// The edit for `*` entry u: its list of names, or its removal.
fn glob_edit(u: i64, alias: i64, edits: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let n = use_entry_node(u, pcx);
    let star = star_of(n, pcx);
    let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
    glob_names(u, alias, &mut names, pcx);
    let start = line_start(n_start(n, pcx), pcx);
    if names.len() as i64 == 0 {
        let first = n_start(n, pcx);
        let end = line_end(pcx.nodes[n as usize].end, pcx);
        if blank(start, first) && blank(pcx.nodes[n as usize].end, end) {
            let f = file_of_pos(start, pcx);
            add_edit(edits, start,
                if end < pcx.files[f as usize].end { end + 1 - start } else { end - start },
                buf_new());
        } else {
            add_edit(edits, first, pcx.nodes[n as usize].end - first, buf_new());
        }
        return;
    }
    let text = buf_new();
    if names.len() as i64 == 1 {
        // (one name: `use a::b::x;`)
        buf_bytes(text, sym_text((names[0]), pcx));
        add_edit(edits, star, 1, text);
        return;
    }
    buf_byte(text, b'{');
    let mut width: i64 = 1;
    for k in 0..names.len() as i64 {
        if k > 0 {
            buf_str(text, c", ");
        }
        buf_bytes(text, sym_text((names[k as usize]), pcx));
        width += sym_text((names[k as usize]), pcx).len() as i64 + 2;
    }
    buf_byte(text, b'}');
    if (star - start) + width + (line_end(star, pcx) - star - 1) <= LINE_WIDTH {
        add_edit(edits, star, 1, text);
        return;
    }
    // One name after the other, on the lines between the braces.
    let mut indent = start;
    while get_src()[indent as usize] == b' ' || get_src()[indent as usize] == b'\t' {
        indent += 1;
    }
    let long = buf_new();
    buf_byte(long, b'{');
    let mut col = LINE_WIDTH;
    for k in 0..names.len() as i64 {
        let len = sym_text((names[k as usize]), pcx).len() as i64;
        if col + 1 + len + 1 > LINE_WIDTH {
            buf_byte(long, b'\n');
            buf_bytes(long, &get_src()[start as usize..indent as usize]);
            buf_str(long, c"    ");
            col = indent - start + 4;
        } else {
            buf_byte(long, b' ');
            col += 1;
        }
        buf_bytes(long, sym_text((names[k as usize]), pcx));
        buf_byte(long, b',');
        col += len + 1;
    }
    buf_byte(long, b'\n');
    buf_bytes(long, &get_src()[start as usize..indent as usize]);
    buf_byte(long, b'}');
    add_edit(edits, star, 1, long);
}

// The position of the `*` of Use node n.
fn star_of(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut star = pcx.nodes[pcx.nodes[n as usize].c as usize].end;
    while get_src()[star as usize] != b'*' {
        star += 1;
    }
    star
}

// Where the item of Use node n starts (its `pub`, if any).
fn n_start(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let first = pcx.nodes[n as usize].start;
    let mut i = first;
    while i > 0 && (get_src()[(i - 1) as usize] == b' ' || get_src()[(i - 1) as usize] == b'\t') {
        i -= 1;
    }
    if i >= 3 && get_src()[(i - 3) as usize] == b'p' && get_src()[(i - 2) as usize] == b'u'
        && get_src()[(i - 1) as usize] == b'b'
        && (i == 3 || get_src()[(i - 4) as usize] == b' ' || get_src()[(i - 4) as usize] == b'\t'
            || get_src()[(i - 4) as usize] == b'\n') {
        return i - 3;
    }
    first
}

fn alias_text(alias: i64, before: *mut u8, after: *mut u8, pcx: &Ctx<Comp>) -> i64 {
    let text = buf_new();
    buf_str(text, before);
    buf_bytes(text, sym_text(alias, pcx));
    buf_str(text, after);
    text
}

// The edits rewriting the program (to the edit engine, edit.vl);
// returns the number of imports rewritten.
pub fn fix_imports_edits(pcx: &mut Ctx<Comp>) -> i64 {
    let alias = c_alias(pcx);
    let mut edits: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut fixes: i64 = 0;
    for u in 0..use_entry_count(pcx) {
        if !use_entry_glob(u, pcx)
            || !ref_in(pcx.nodes[use_entry_node(u, pcx) as usize].start, pcx) {
            continue;
        }
        fixes += 1;
        if is_plain_import(u, pcx) {
            let n = use_entry_node(u, pcx);
            add_edit(&mut edits, pcx.nodes[n as usize].end - 1, 0,
                alias_text(alias, c" as ", c"", pcx));
        } else {
            glob_edit(u, alias, &mut edits, pcx);
        }
    }
    // The C declarations used in patterns, imported by name after the
    // import (or the `*`) that brought them.
    for u in 0..use_entry_count(pcx) {
        let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut k: i64 = 0;
        while k < pcx.c_by_name.len() as i64 {
            if (pcx.c_by_name[k as usize]) == u {
                names.push((pcx.c_by_name[(k + 1) as usize]));
            }
            k += 2;
        }
        if names.len() as i64 == 0 {
            continue;
        }
        sort_syms(&mut names, pcx);
        let n = use_entry_node(u, pcx);
        let start = line_start(n_start(n, pcx), pcx);
        let mut indent = start;
        while get_src()[indent as usize] == b' ' || get_src()[indent as usize] == b'\t' {
            indent += 1;
        }
        let text = buf_new();
        buf_byte(text, b'\n');
        buf_bytes(text, &get_src()[start as usize..indent as usize]);
        buf_str(text, c"use ");
        buf_bytes(text, sym_text(alias, pcx));
        buf_str(text, if names.len() as i64 > 1 { c"::{" } else { c"::" });
        for j in 0..names.len() as i64 {
            if j > 0 {
                buf_str(text, c", ");
            }
            buf_bytes(text, sym_text((names[j as usize]), pcx));
        }
        buf_str(text, if names.len() as i64 > 1 { c"};" } else { c";" });
        add_edit(&mut edits, pcx.nodes[n as usize].end, 0, text);
    }
    let mut i: i64 = 0;
    while i < pcx.c_quals.len() as i64 {
        add_edit(&mut edits, (pcx.c_quals[i as usize]), 0,
            alias_text(alias, c"", c"::", pcx));
        i += 3;
    }
    // (in order of position: an insertion sort of the triples)
    let n = edits.len() as i64 / 3;
    for k in 1..n {
        let mut j = k;
        while j > 0
            && (edits[(3 * j) as usize]) < (edits[(3 * (j - 1)) as usize]) {
            for x in 0..3 {
                let t = (edits[(3 * j + x) as usize]);
                (edits[(3 * j + x) as usize]) = (edits[(3 * (j - 1) + x) as usize]);
                (edits[(3 * (j - 1) + x) as usize]) = t;
            }
            j -= 1;
        }
    }
    let mut k: i64 = 0;
    while k < edits.len() as i64 {
        let f = file_of_pos((edits[k as usize]), pcx);
        if !within_std(pcx.files[f as usize].module, pcx)
            && pcx.files[f as usize].module != pcx.c_module {
            edit_replace((edits[k as usize]),
                (edits[k as usize]) + (edits[(k + 1) as usize]),
                (edits[(k + 2) as usize]), pcx);
        }
        k += 3;
    }
    fixes
}

// ---- The errors for the removed forms (0.8) ----

// One error for each `*` import and plain header import of the program
// (not under --fix-imports), once. When the function bodies were checked
// (`complete`), the error names what the program uses through it.
pub fn report_legacy_imports(complete: bool, pcx: &mut Ctx<Comp>) {
    if !pcx.legacy_imports || pcx.fix_imports || pcx.legacy_reported {
        return;
    }
    pcx.legacy_reported = true;
    let kind = pcx.err_kind;
    pcx.err_kind = c"module error";
    for u in 0..use_entry_count(pcx) {
        if use_entry_glob(u, pcx) {
            report_recovering(u, complete, pcx);
        }
    }
    pcx.err_kind = kind;
}

fn report_recovering(u: i64, complete: bool, pcx: &mut Ctx<Comp>) {
    let depth = pcx.recover_depth;
    // UNSAFE: the front end's error recovery is setjmp/longjmp (a C call):
    // an error legacy_error reports returns here.
    // SAFETY: recover_enter gives the jmp_buf of this frame's depth, live
    // until recover_leave below; no local of this frame changes between the
    // two returns.
    if unsafe { _setjmp(recover_enter(pcx)) == 0 } {
        legacy_error(u, complete, pcx);
    }
    recover_leave(depth, pcx);
}

// The most names an error lists.
const LISTED_NAMES: i64 = 8;

fn legacy_error(u: i64, complete: bool, pcx: &mut Ctx<Comp>) {
    let alias = intern_c(c"c", pcx);
    let n = use_entry_node(u, pcx);
    // (0.18) `use super::*;`, Rust's test-module habit: a `#[cfg(test)]`
    // module sees its parent's items without it (front/tests)
    if !is_plain_import(u, pcx)
        && get_src()[pcx.nodes[n as usize].start as usize..star_of(n, pcx) as usize]
        == b"use super::" {
        let kind_was = pcx.err_kind;
        pcx.err_kind = c"import.wildcard";
        err_begin(pcx.nodes[n as usize].start, pcx);
        err_str(c"wildcard imports are not allowed: 'use super::*;' is not needed", pcx);
        err_help(
            c"a #[cfg(test)] module sees its parent's items, private ones too, without an import", pcx);
        let t = buf_new();
        buf_str(t, c"edit patch ");
        buf_file_line(t, pcx.nodes[n as usize].start, pcx);
        buf_str(t, c" --old 'use super::*;' --new ''");
        err_try_tool(&buf_copy(t), true, pcx);
        err_end_soft(pcx);
        pcx.err_kind = kind_was;
        return;
    }
    err_begin(pcx.nodes[n as usize].start, pcx);
    if is_plain_import(u, pcx) {
        err_str(c"importing every declaration of a header is not allowed: write '", pcx);
        buf_bytes(pcx.err,
            &get_src()[
                pcx.nodes[n as usize].start as usize..(pcx.nodes[n as usize].end - 1) as usize]);
        err_str(c" as c;' and 'c::", pcx);
        let mut example: i64 = -1;
        let mut i: i64 = 0;
        while i < pcx.c_quals.len() as i64 && example < 0 {
            if (pcx.c_quals[(i + 1) as usize]) == u {
                example = (pcx.c_quals[(i + 2) as usize]);
            }
            i += 3;
        }
        if example >= 0 {
            err_sym(example, pcx);
        } else {
            err_str(c"name", pcx);
        }
        err_str(c"'", pcx);
    } else {
        let mut names: Vec<i64, Comp> = Vec::new_in(Comp {});
        glob_names(u, alias, &mut names, pcx);
        if complete && names.len() as i64 == 0 {
            err_str(
                c"wildcard imports are not allowed, and nothing is used through this one: remove it", pcx);
        } else {
            err_str(c"wildcard imports are not allowed: write '", pcx);
            buf_bytes(pcx.err,
                &get_src()[pcx.nodes[n as usize].start as usize..star_of(n, pcx) as usize]);
            if !complete {
                err_str(c"{...}", pcx);
            } else if names.len() as i64 == 1 {
                err_sym((names[0]), pcx);
            } else {
                err_str(c"{", pcx);
                for k in 0..names.len() as i64 {
                    if k == LISTED_NAMES {
                        err_str(c", ...", pcx);
                        break;
                    }
                    if k > 0 {
                        err_str(c", ", pcx);
                    }
                    err_sym((names[k as usize]), pcx);
                }
                err_str(c"}", pcx);
            }
            err_str(c";'", pcx);
        }
    }
    err_str(c" (volec --fix-imports rewrites a program this way)", pcx);
    err_help(c"every name a file uses is declared in it, imported by name, or written with its path (0.8)", pcx);
    err_end(pcx);
}
