// The explanations of the codes of text blocks and embedding (0.25.3,
// front/lexer/blocks.vl, front/embed.vl; docs/grammar.md, "Text
// blocks").

use crate::tools::explain::Explain;

pub const STRINGS_COUNT: i64 = 6;

pub static STRINGS_TABLE: [Explain; 6] = [
    Explain {
        code: "lex.text-block-open",
        severity: "error",
        means: "Text after the `\"\"\"` that opens a text block, on its line. A text block's \
            text starts on the line after `\"\"\"`; `\"\"\"` with text after it is not a \
            string of one line either.",
        fix: "Break the line after `\"\"\"`, or write a string of one line as `\"...\"`.",
        example: "let s = \"\"\"usage: tool\n\
            \x20   \"\"\";\n\
            \n\
            main.vl:1:12: error[lex.text-block-open] a text block's text starts on the line after its opening '\"\"\"'",
    },
    Explain {
        code: "lex.text-block-indent",
        severity: "error",
        means: "A line of a text block indented less than its closing `\"\"\"`. The closing \
            line's indentation is removed from every line, so every line must begin with it, \
            byte for byte (tabs and spaces are different bytes); a line of blanks only may be \
            shorter.",
        fix: "Indent the line at least as much as the closing `\"\"\"` (`volec fix \
            --suggested` does it), or move the closing `\"\"\"` left: the text keeps the \
            extra indentation of each line.",
        example: "let s = \"\"\"\n\
            \x20       ok\n\
            \x20     short\n\
            \x20       \"\"\";\n\
            \n\
            main.vl:3:1: error[lex.text-block-indent] a text block's line is indented 6 bytes; its closing '\"\"\"' is indented 8\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: "lex.text-block-unterminated",
        severity: "error",
        means: "A text block with no closing line: a line whose first non-blank bytes are \
            `\"\"\"` (and as many `#`s as follow the `r` of a raw block, `r#\"\"\"` .. \
            `\"\"\"#`).",
        fix: "Add the closing line, indented as the text's least indented line: `\"\"\";`.",
        example: "let s = r#\"\"\"\n\
            \x20   text\n\
            \x20   \"\"\";\n\
            \n\
            main.vl:1:9: error[lex.text-block-unterminated] unterminated text block: no line starts with '\"\"\"#' to close it",
    },
    Explain {
        code: "embed.missing",
        severity: "error",
        means: "`include_str` or `include_bytes` names a file that cannot be read. Its path is \
            relative to the directory of the file that holds the call (not to the current \
            directory); the message names the path it tried.",
        fix: "Correct the path, relative to the file holding the call, or create the file.",
        example: "const WGSL: [u8] = include_str(\"shader.wgsl\");\n\
            \n\
            gfx/view.vl:1:20: error[embed.missing] include_str(\"shader.wgsl\"): cannot read gfx/shader.wgsl",
    },
    Explain {
        code: "embed.utf8",
        severity: "error",
        means: "`include_str` of a file that is not UTF-8: its text would be a `str`, which is \
            UTF-8. The message names the first byte that is not.",
        fix: "Embed its bytes, a `[u8]`: `include_bytes(\"...\")` (`volec fix --suggested` \
            writes it), or convert the file to UTF-8.",
        example: "const FONT: [u8] = include_str(\"font.bin\");\n\
            \n\
            main.vl:1:20: error[embed.utf8] include_str(\"font.bin\"): font.bin is not UTF-8 (at byte 2)\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: "embed.path",
        severity: "error",
        means: "`include_str` or `include_bytes` with an argument that is not a string literal. \
            The file is read when the program is compiled, so its path must be known then.",
        fix: "Write the path as a literal: `include_str(\"shader.wgsl\")`; to read a file \
            named at run time, use std's file reading.",
        example: "let p = \"shader.wgsl\";\n\
            let s = include_str(p);\n\
            \n\
            main.vl:2:21: error[embed.path] 'include_str' takes its file's path as a string literal",
    },
];
