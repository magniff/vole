// The explanations of the codes of text blocks and embedding (0.25.3,
// front/lexer/blocks.vl, front/embed; docs/grammar.md, "Text blocks";
// 0.26.0: embedded blocks, front/lexer/embedded.vl, "Embedded blocks").

use crate::tools::explain::Explain;

pub const STRINGS_COUNT: i64 = 9;

pub static STRINGS_TABLE: [Explain<'_>; 9] = [
    Explain {
        code: b"lex.text-block-open",
        severity: b"error",
        means: b"Text after the `\"\"\"` that opens a text block, on its line. A text block's \
            text starts on the line after `\"\"\"`; `\"\"\"` with text after it is not a \
            string of one line either.",
        fix: b"Break the line after `\"\"\"`, or write a string of one line as `\"...\"`.",
        example: b"let s = \"\"\"usage: tool\n\
            \x20   \"\"\";\n\
            \n\
            main.vl:1:12: error[lex.text-block-open] a text block's text starts on the line after its opening '\"\"\"'",
    },
    Explain {
        code: b"lex.text-block-indent",
        severity: b"error",
        means: b"A line of a text block indented less than its closing `\"\"\"`. The closing \
            line's indentation is removed from every line, so every line must begin with it, \
            byte for byte (tabs and spaces are different bytes); a line of blanks only may be \
            shorter.",
        fix: b"Indent the line at least as much as the closing `\"\"\"` (`volec fix \
            --suggested` does it), or move the closing `\"\"\"` left: the text keeps the \
            extra indentation of each line.",
        example: b"let s = \"\"\"\n\
            \x20       ok\n\
            \x20     short\n\
            \x20       \"\"\";\n\
            \n\
            main.vl:3:1: error[lex.text-block-indent] a text block's line is indented 6 bytes; its closing '\"\"\"' is indented 8\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"lex.text-block-unterminated",
        severity: b"error",
        means: b"A text block with no closing line: a line whose first non-blank bytes are \
            `\"\"\"` (and as many `#`s as follow the `r` of a raw block, `r#\"\"\"` .. \
            `\"\"\"#`).",
        fix: b"Add the closing line, indented as the text's least indented line: `\"\"\";`.",
        example: b"let s = r#\"\"\"\n\
            \x20   text\n\
            \x20   \"\"\";\n\
            \n\
            main.vl:1:9: error[lex.text-block-unterminated] unterminated text block: no line starts with '\"\"\"#' to close it",
    },
    Explain {
        code: b"embed.missing",
        severity: b"error",
        means: b"`include_str` or `include_bytes` names a file that cannot be read. Its path is relative \
            to the directory of the file that holds the call (not to the current directory); the \
            message names the path it tried. (0.26.0) So does the file of an embedded block, `embed \
            wgsl K from \"x.wgsl\";`.",
        fix: b"Correct the path, relative to the file holding the call, or create the file.",
        example: b"const WGSL: &str = include_str(\"shader.wgsl\");\n\
            \n\
            fn main() {\n\
            \x20   println(\"{}\", WGSL.len());\n\
            }\n\
            \n\
            main.vl:1:20: error[embed.missing] include_str(\"shader.wgsl\"): cannot read shader.wgsl\n\
            \x20 help: the path is relative to the directory of main.vl, the file that holds the call",
    },
    Explain {
        code: b"embed.utf8",
        severity: b"error",
        means: b"`include_str` of a file that is not UTF-8: its text would be a `&str`, which is UTF-8. \
            The message names the first byte that is not.",
        fix: b"Embed its bytes, a `&[u8]`: `include_bytes(\"...\")` (`volec fix --suggested` writes \
            it), or convert the file to UTF-8.",
        example: b"const FONT: &str = include_str(\"font.bin\");\n\
            \n\
            fn main() {\n\
            \x20   println(\"{}\", FONT.len());\n\
            }\n\
            \n\
            main.vl:1:20: error[embed.utf8] include_str(\"font.bin\"): font.bin is not UTF-8 (at byte 2)\n\
            \x20 help: include_str's text is a str, UTF-8; include_bytes gives any file's bytes, a [u8]\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"embed.path",
        severity: b"error",
        means: b"`include_str` or `include_bytes` with an argument that is not a string literal. \
            The file is read when the program is compiled, so its path must be known then. \
            (0.26.0) So does `embed wgsl K from P;`: its path is a literal too.",
        fix: b"Write the path as a literal: `include_str(\"shader.wgsl\")`; to read a file \
            named at run time, use std's file reading.",
        example: b"let p = \"shader.wgsl\";\n\
            let s = include_str(p);\n\
            \n\
            main.vl:2:21: error[embed.path] 'include_str' takes its file's path as a string literal",
    },
    Explain {
        code: b"embed.language",
        severity: b"error",
        means: b"(0.26.0) An embedded block of a language vole does not have: `embed LANG NAME \
            { .. }` takes one language, `wgsl`. The block's text still ends at the `}` that \
            matches outside `//` and `/* */` comments, and the check goes on after it.",
        fix: b"Write `embed wgsl NAME { .. }`, or keep the other language's text in a string \
            (a text block, `r\"\"\"`).",
        example: b"embed glsl K {\n\
            \x20   void main() {}\n\
            }\n\
            \n\
            main.vl:1:7: error[embed.language] no embedded language 'glsl': the one language is wgsl",
    },
    Explain {
        code: b"embed.unterminated",
        severity: b"error",
        means: b"(0.26.0) An embedded block whose `{` no `}` closes. A block's text ends at the \
            `}` that matches its `{`, counting the braces of its text outside `//` and nested \
            `/* */` comments (WGSL has no strings); the message names the innermost `{` left \
            open. The rest of the file is not read.",
        fix: b"Close the `{` the message names (a `}` inside a comment does not count).",
        example: b"embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            }\n\
            \n\
            main.vl:1:14: error[embed.unterminated] unterminated embedded block: no '}' closes this '{' (the '{' at line 3 is the last left open)",
    },
    Explain {
        code: b"embed.name",
        severity: b"error",
        means: b"(0.26.0) An entry point of an embedded block that cannot be a field of its \
            type: the block `K` is a static whose fields are `src`, its text, and one per \
            entry point named as it is (`K.main`), so an entry point named `src` or a vole \
            keyword makes no field.",
        fix: b"Rename the entry point (and the name the pipeline is made with).",
        example: b"embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn src() {}\n\
            }\n\
            \n\
            main.vl:3:8: error[embed.name] the entry point 'src' would be the block's field 'src', its text",
    },
];
