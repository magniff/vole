// The explanations of 0.26.3's allocator rules (front/check/alloc_rules.vl;
// docs/design/rust-surface-plan.md §2.0; docs/grammar.md, "Allocators"):
// allocation is a capability, visible in the signature.

use crate::tools::explain::Explain;

pub const ALLOC_COUNT: i64 = 1;

pub static ALLOC_TABLE: [Explain; 1] = [
    Explain {
        code: "alloc.default",
        severity: "error",
        means: "(0.26.3) A container of std written without its allocator type, `Vec<u8>`, \
            `Buf`, `HashMap<K, V>`: std's types have no default allocator (until 0.26.3 the \
            default was Gpa), so the allocator a value may grow from is in its type, and a \
            signature says what a function may allocate from. Also a type parameter bounded \
            by Allocator declared with a default (`A: Allocator = Gpa`).",
        fix: "Write the allocator: `Vec<u8, Gpa>` (main's, what the default meant), or the \
            allocator parameter of a generic item (`fn fill<A: Allocator>(v: &mut Vec<u8, A>)`); \
            a function that only reads takes a slice, `[u8]`. `volec fix --only alloc` writes \
            Gpa, except in an item generic over an allocator, where it is yours to choose.",
        example: "fn total(v: Vec<i64>) -> i64 { v.iter().sum() }\n\
            \n\
            main.vl:1:13: error[alloc.default] 'Vec' names no allocator: its 'A' is written (no default allocator type since 0.26.3) | help: the allocator is part of the type: `Gpa` (main's, what the default meant), or a generic `A: Allocator`",
    },
];
