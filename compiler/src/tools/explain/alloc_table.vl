// The explanations of 0.26.3's allocator rules (front/check/alloc_rules.vl;
// docs/design/rust-surface-plan.md §2.0; docs/grammar.md, "Allocators"):
// allocation is a capability, visible in the signature.

use crate::tools::explain::Explain;

pub const ALLOC_COUNT: i64 = 7;

pub static ALLOC_TABLE: [Explain<'_>; 7] = [
    Explain {
        code: b"alloc.default",
        severity: b"error",
        means: b"(0.26.3) A container of std written without its allocator type, `Vec<u8>`, `String`, \
            `Box<T>`: std's types have no default allocator, so \
            the allocator a value may grow from is in its type, and a signature says what a function \
            may allocate from. Also a type parameter bounded by Allocator declared with a default \
            (`A: Allocator = Gpa`).",
        fix: b"Write the allocator: `Vec<u8, Gpa>` (the type of main's `gpa`), or the allocator \
            parameter of a generic item (`fn fill<A: Allocator>(v: &mut Vec<u8, A>)`); a function \
            that only reads takes a slice, `&[u8]`. `volec fix --only alloc` writes Gpa; in an \
            item generic over one allocator it writes that parameter (`Vec<T, A>` in `impl<T, A: \
            Allocator> Ring<T, A>`), and in one generic over two it writes nothing: the help names \
            them, and which one is yours to choose (an impl block without the allocator gets the \
            parameter).",
        example: b"fn total(v: &Vec<i64>) -> i64 { v.iter().sum() }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:1:14: error[alloc.default] 'Vec' names no allocator: its 'A' is written, last\n\
            \x20 help: the allocator is part of the type: `Gpa` (the type of main's `gpa`), or a generic `A: Allocator`\n\
            \x20 try: volec fix --only alloc main.vl\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"hash.default",
        severity: b"error",
        means: b"(0.29.0) A HashMap or HashSet written without its hasher type, `HashMap<K, V, Gpa>`: \
            the hasher is the type's last parameter and, as the allocator, has no default, so a \
            map's type says how its keys are hashed. So for any type whose last parameters are \
            bounded by std's BuildHasher (`struct Cache<K, A: Allocator, S: BuildHasher>`).",
        fix: b"Write the hasher: `HashMap<K, V, Gpa, FixedState>` (in the prelude, as `Gpa`: \
            foldhash with a fixed seed, the default until 0.28.0 and what `HashMap::new_in` and \
            `with_capacity_in` make), another BuildHasher (`SipHashState`, with \
            `HashMap::with_hasher_in(h, gpa)`), or the hasher parameter of a generic item. `volec fix \
            --suggested` writes FixedState; in an item generic over one hasher it \
            writes that parameter, and in one generic over two it writes nothing: the help names \
            them. When the allocator is left out too, its error (alloc.default) is fixed first.",
        example: b"use std::collections::HashMap;\n\
            \n\
            fn keys(m: &HashMap<i64, i64, Gpa>) -> usize { m.len() }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:3:13: error[hash.default] 'HashMap' names no hasher: its 'S' is written, last\n\
            \x20 help: the hasher is part of the type: `FixedState` (in the prelude, the one `HashMap::new_in` makes), or a generic `S: BuildHasher`\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"alloc.no_in",
        severity: b"error",
        means: b"(0.26.3) A constructor or function that allocated from an allocator nobody passed \
            (`Vec::new()`, `Vec::with_capacity(n)`, `thread::spawn(f)`): std has none of them. Every \
            allocation names its allocator, as the last argument of the `_in` form \
            (`Vec::new_in(a)`, `collect_in(a)`, `format_in(\"{x}\", a)`).",
        fix: b"Call the `_in` form with the allocator: a parameter (`gpa: Gpa`, from main's `fn \
            main(gpa: Gpa)`), or a container's (`*v.allocator()`). `volec fix --only alloc` writes \
            it when one allocator value is in scope, and says so when none or several are.",
        example: b"fn main(gpa: Gpa) {\n\
            \x20   let v: Vec<i64, Gpa> = Vec::new();\n\
            \x20   println(\"{}\", v.len());\n\
            }\n\
            \n\
            main.vl:2:28: error[alloc.no_in] 'Vec::new' allocates from nothing: pass the allocator, last, to 'Vec::new_in'\n\
            \x20 help: this function's `gpa` is the allocator to pass\n\
            \x20 try: volec fix --only alloc main.vl\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"alloc.safe_impl",
        severity: b"error",
        means: b"(0.26.3) An impl of std's Allocator written `impl Allocator for T`: Allocator is an \
            `unsafe trait`, as in Rust. Containers' unsafe code relies on an allocator's blocks, and \
            a type made from nothing over malloc is a global allocator, so its impl says so. (Any \
            `unsafe trait`'s impl is `unsafe impl`; `unsafe impl` of a safe trait, or of a type \
            alone, is an error.)",
        fix: b"Write `unsafe impl Allocator for T`, under `// UNSAFE:` (why it cannot be safe) and `// \
            SAFETY:` (where its memory comes from, why its blocks are sound). No tool writes it: the \
            comments are the author's.",
        example: b"use std::alloc::{Allocator, AllocError, Layout};\n\
            use std::ptr::NonNull;\n\
            \n\
            #[derive(Clone, Copy)]\n\
            struct Never {}\n\
            \n\
            impl Allocator for Never {\n\
            \x20   fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> { Err(AllocError) }\n\
            \x20   unsafe fn deallocate(&self, ptr: NonNull<u8>, layout: Layout) {}\n\
            }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:7:1: error[alloc.safe_impl] the trait 'Allocator' is unsafe: its impl is `unsafe impl`\n\
            \x20 help: an allocator says where its memory comes from: `unsafe impl Allocator for T`, under `// UNSAFE:` (why it cannot be safe) and `// SAFETY:` (where its memory comes from, why it is sound)",
    },
    Explain {
        code: b"alloc.static",
        severity: b"error",
        means: b"(0.26.3) A `static`, `static mut` or thread-local whose type holds an allocator \
            (`Option<Vec<u8, Gpa>>`, an Arena, a struct holding one, through a pointer too): any \
            function could allocate through it with nothing in its signature saying so. So a \
            static's type is AllocFree (the auto trait, `T: AllocFree`), and an allocator value \
            inside a function came in through a parameter.",
        fix: b"Keep the container in main, or in the struct the program's work is done on, and pass it \
            (or what it allocated, as a slice) down. A static may hold what holds no allocator: \
            integers, arrays, atomics, text. No tool moves it.",
        example: b"static mut NAMES: Option<Vec<i64, Gpa>> = None;\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:1:1: error[alloc.static] the static 'NAMES' holds an allocator, 'Gpa' (in its type 'Option<Vec<i64, Gpa>>'): a static's type may not hold one\n\
            \x20 help: any function could allocate through it with nothing in its signature saying so: keep the value in main and pass it down (or what it allocates, as a slice)",
    },
    Explain {
        code: b"alloc.field",
        severity: b"error",
        means: b"(0.26.3) A struct's field or an enum variant's payload holds an allocator that the \
            type's parameters do not name (`struct Parser { toks: Vec<Tok, Gpa> }`): `fn f(p: &mut \
            Parser)` could allocate with nothing in its signature saying so. A type that holds an \
            allocator says so in its parameters.",
        fix: b"Make the type generic over the allocator, `struct Parser<A: Allocator> { toks: Vec<Tok, \
            A> }`, and name it at each use, `Parser<Gpa>`: `volec fix --only alloc` does both, in \
            rounds (the parameter, then the uses). A literal infers it from its fields (`Parser { \
            toks: Vec::new_in(gpa) }`).",
        example: b"struct Parser { toks: Vec<i64, Gpa> }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:1:23: error[alloc.field] the struct 'Parser' holds an allocator its parameters do not name: 'Gpa', in field 'toks'\n\
            \x20 help: a type that holds an allocator says so in its parameters: make it generic over it (`struct P<A: Allocator> { v: Vec<u8, A> }`, used as `P<Gpa>`)\n\
            \x20 try: volec fix --only alloc main.vl\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"alloc.last",
        severity: b"error",
        means: b"(0.26.3) A function named `..._in` whose allocator parameter is not its last: an `_in` \
            function takes its allocator last, as Rust's allocator API does \
            (`Vec::with_capacity_in(cap, alloc)`), so that every allocating call reads the same way.",
        fix: b"Move the allocator to the end of the parameters and of every call: `volec refactor \
            signature` does both.",
        example: b"use std::alloc::Allocator;\n\
            \n\
            fn copy_in<A: Allocator>(a: A, s: &[u8]) -> Vec<u8, A> {\n\
            \x20   let mut v = Vec::new_in(a);\n\
            \x20   v.extend_from_slice(s);\n\
            \x20   v\n\
            }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:3:26: error[alloc.last] 'copy_in' takes its allocator 'a' before its last parameter: an `_in` function takes it last\n\
            \x20 help: move the allocator to the end of the parameters (Rust's `with_capacity_in(cap, alloc)`), and at every call: `volec refactor signature` does both\n\
            \x20 try: volec refactor signature --help",
    },
];
