// The explanations of syntax.later and type.ref-value (front/rust,
// front/check/rust.vl; named `edition.*` until 0.29, when the old
// std's two, edition.std_copy and edition.std_by_value, went with their
// sites) and of four of the borrow checker's (places/regions.vl).

use crate::tools::explain::Explain;

pub const SURFACE_COUNT: i64 = 6;

pub static SURFACE_TABLE: [Explain<'_>; 6] = [
    Explain {
        code: b"syntax.later",
        severity: b"error",
        means: b"A construct of Rust's that the parser reads and the language does not have \
            yet; the message names it and the release it comes in: `impl Trait` inside a \
            result's type, in a trait method's result or a `let` (0.29; `-> impl Trait` at \
            the top of a result works). The error is soft: the rest of the program is \
            checked, and every such line is one count of the code. (Named edition.later \
            until 0.29.)",
        fix: b"Write what the language has: a generic parameter (`fn f<F: Fn(i64) -> i64>`) or \
            a named type where the `impl Trait` is nested. `volec guide rust` lists what the \
            language has of Rust's and what it does not.",
        example: b"fn adder(k: i64) -> Option<impl Fn(i64) -> i64> { None }\n\
            \n\
            main.vl:1:28: error[syntax.later] 'impl Fn(i64) -> i64' (impl_trait_nested) is not in the language yet: it comes in 0.29",
    },
    Explain {
        code: b"type.ref-value",
        severity: b"error",
        means: b"A reference given where its value goes, or a place given where a reference \
            goes, in an argument or a `let` with a written type. Neither is converted \
            implicitly, as in Rust (rustc E0308). (Named edition.lenient until 0.29.)",
        fix: b"The `try:` line (`volec fix --suggested` makes it): `*r` to read through a \
            reference, `&x` to lend a place, `x` for a `&x` where x's value goes.",
        example: b"fn takes(x: &i64) -> i64 { *x }\n\
            let c = takes(n);\n\
            \n\
            main.vl:2:15: error[type.ref-value] 'n' is a value where a reference goes\n\
            \x20 try: &n",
    },
    Explain {
        code: b"borrowck.elision",
        severity: b"error",
        means: b"(0.27.1) A function's result holds a reference whose lifetime is not written, and Rust's \
            elision rules give it none: the function has more than one reference region among its \
            parameters (or none) and no `&self`/`&mut self` (the rules E1-E3, \
            docs/design/borrowck.md D4.2; rustc E0106).",
        fix: b"Name the lifetime the result borrows from on that parameter and on the result: `fn \
            f<'a>(x: &'a T, y: &U) -> &'a T`; a result that borrows from nothing is `&'static T` or \
            an owned value.",
        example: b"fn longer(x: &i64, y: &i64) -> &i64 { x }\n\
            \n\
            main.vl:1:32: error[borrowck.elision] the result of 'longer' borrows, but from which parameter is not said: it has no single reference parameter and no `&self`",
    },
    Explain {
        code: b"borrowck.unused_param",
        severity: b"error",
        means: b"(0.27.1) A struct's or enum's lifetime or type parameter that none of its fields uses: \
            its variance is unknown (bivariant, D5.3), so the borrow checker cannot relate its \
            regions (rustc E0392).",
        fix: b"Use it in a field, or add a `PhantomData` field that says how the type uses it: \
            `PhantomData<&'a ()>` for a lifetime, `PhantomData<T>` for a type.",
        example: b"struct Tag<'a> { n: i64 }\n\
            \n\
            main.vl:1:12: error[borrowck.unused_param] the parameter 'a' of 'Tag' is never used in its fields",
    },
    Explain {
        code: b"borrowck.static_mut_ref",
        severity: b"error",
        means: b"(0.27.1) A reference to a `static mut` (`&M`, `&mut M`): any code may write the static \
            at any time, so no reference to it can be checked (D6.2.5; Rust 2024's static_mut_refs).",
        fix: b"Take a raw pointer where you need it, `let p: *mut T = &mut S;`, and read or write \
            through it in `unsafe`.",
        example: b"static mut M: i64 = 1;\n\
            fn main() { let r = unsafe { &mut M }; }\n\
            \n\
            main.vl:2:30: error[borrowck.static_mut_ref] a reference to the `static mut` 'M': only its raw address may be taken",
    },
    Explain {
        code: b"contract.move",
        severity: b"error",
        means: b"(0.27.1) A `requires` or an `ensures` moves a parameter or `result` (C3.2, C3.3): a \
            clause reads in place, and the function still has the value after the check (the body, \
            or the caller its result).",
        fix: b"Read it or a part of it, or borrow it: `&x`, `x.len()`, `x.clone()`; or give the type \
            `#[derive(Clone, Copy)]` when it is plain data.",
        example: b"struct N { v: i64 }\n\
            fn eat(n: N) -> bool { n.v > 0 }\n\
            fn f(n: N) -> i64 requires eat(n) { n.v }\n\
            \n\
            main.vl:3:32: error[contract.move] a clause moves 'n': a `requires` or an `ensures` reads its parameters and `result` in place, and the function still has them",
    },
];
