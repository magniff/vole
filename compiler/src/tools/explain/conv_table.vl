// The explanations of the codes named `conv.*` (front/conv.vl, the
// parser): (0.28.0) what is left of them in the one language. conv.place,
// conv.sink_type and conv.extern, of the parameter conventions that went
// with the old edition, are raised no more: their entries say so, and
// go with their sites in 0.29 (tests/refactor's self_explain wants an
// entry for every code the source names).

use crate::tools::explain::Explain;

pub const CONV_COUNT: i64 = 7;

pub static CONV_TABLE: [Explain<'_>; 7] = [
    Explain {
        code: b"conv.rust",
        severity: b"error",
        means: b"`std::env::var(name)`, Rust's function: it returns a String, which in vole \
            is made on an allocator, so std has it as `env::var_in(name, gpa)`.",
        fix: b"`env::var_in(name, gpa)`, a `Result<String<Gpa>, VarError>`; the try: line \
            renames the call, the allocator is yours to pass (`volec guide io`).",
        example: b"let home = std::env::var(\"HOME\");\n\
            \n\
            main.vl:1:12: error[conv.rust] 'env::var' allocates its result: std's is 'env::var_in(name, gpa)'\n\
            \x20 help: the environment's variables: `env::var_in(name, gpa)`, a `Result<String<Gpa>, VarError>`",
    },
    Explain {
        code: b"conv.set",
        severity: b"error",
        means: b"`x: set T`, a parameter the callee would initialize (an out parameter). Vole \
            has no uninitialized bindings, so it has none: a function returns what it makes.",
        fix: b"Return the value (a tuple or a struct for several); `x: &mut T` changes a value \
            the caller already has.",
        example: b"fn make(out: set Vec<i64, Gpa>) { }\n\
            \n\
            main.vl:1:14: error[conv.set] there is no 'set' parameter: a function returns what it makes\n\
            \x20 help: return the value (a tuple or a struct for several); 'x: &mut T' changes a value the caller has",
    },
    Explain {
        code: b"conv.mode_order",
        severity: b"error",
        means: b"A parameter written with `let` before its name, `let x: T`. A parameter is \
            `x: T` (the value, moved or copied in), `x: &T` (borrowed), `x: &mut T` (the \
            callee may change the caller's, called `f(&mut v)`); `mut x: T` is a by-value \
            parameter the body changes.",
        fix: b"Take the `let` away; the try: line (and `volec fix --suggested`) does it. The \
            function is checked as if so written, so the error is the only one.",
        example: b"fn double(let x: i64) -> i64 { x * 2 }\n\
            \n\
            main.vl:1:11: error[conv.mode_order] a parameter is written 'x: i64', not 'let x: i64'\n\
            \x20 try: volec edit patch main.vl:1 --old 'let x: i64' --new 'x: i64'",
    },
    Explain {
        code: b"syntax.legacy_removed",
        severity: b"error",
        means: b"The root file starts with `// vole-syntax: 0.19`, a pragma of the 0.20 \
            bootstrap for source in an older spelling. There is one language, and no file \
            says which it is written in.",
        fix: b"Delete the line.",
        example: b"// vole-syntax: 0.19\n\
            fn main() {}\n\
            \n\
            main.vl:1:1: error[syntax.legacy_removed] '// vole-syntax: 0.19' was a pragma of the 0.20 bootstrap: there is one language",
    },
    Explain {
        code: b"conv.place",
        severity: b"error (not raised)",
        means: b"Not raised by this compiler: it was about a parameter convention, which went with the old edition in \
            0.28.0. The code's last site in the compiler goes in 0.29.",
        fix: b"Nothing to fix; a build that prints this code is a compiler bug to report.",
        example: b"(none: 0.28.0 does not print it)",
    },
    Explain {
        code: b"conv.sink_type",
        severity: b"error (not raised)",
        means: b"Not raised by this compiler: it was about a parameter convention, which went with the old edition in \
            0.28.0. The code's last site in the compiler goes in 0.29.",
        fix: b"Nothing to fix; a build that prints this code is a compiler bug to report.",
        example: b"(none: 0.28.0 does not print it)",
    },
    Explain {
        code: b"conv.extern",
        severity: b"error (not raised)",
        means: b"Not raised by this compiler: it was about a parameter convention in a C signature, which went with the old edition in \
            0.28.0. The code's last site in the compiler goes in 0.29.",
        fix: b"Nothing to fix; a build that prints this code is a compiler bug to report.",
        example: b"(none: 0.28.0 does not print it)",
    },
];
