// The explanations of the diagnostic codes of query, edit, patch, undo,
// check, fix, lint, fmt, same-output and explain (`volec explain
// CODE`, 0.13): what each means, how to fix it, an example. The codes
// of the refactorings, rewrite and the compiler are in refactor_table.

use crate::tools::explain::Explain;

pub const TOOLS_COUNT: i64 = 116;

pub static TOOLS_TABLE: [Explain<'_>; 116] = [
    Explain {
        code: b"query.alias", severity: b"note, exit 0",
        means: b"NAME is the other name an import gives (`use a::f as g;`), not a definition: the \
            answer is about what it imports.",
        fix: b"Nothing to fix; ask by the imported definition's own path to go without the note.",
        example: b"note query.alias: 'area' is an import alias in crate, for crate::shapes::area_of",
    },
    Explain {
        code: b"query.ambiguous", severity: b"error, exit 1",
        means: b"NAME matches more than 5 definitions (`show`), or several where an edit needs one; \
            their paths are listed.",
        fix: b"Give more of the path (`Type::method`, `module::name`) or the full path printed.",
        example: b"error query.ambiguous: 20 definitions match '.name'; showing paths only\n\
            try: volec query show crate::back::objfile::ASym.name",
    },
    Explain {
        code: b"query.bad-in", severity: b"error, exit 1",
        means: b"`--in` names no file or module of the program (or FILE:LINE is between items).",
        fix: b"Give a file's path (or its end, `gvn.vl`), a module (`crate::middle::gvn`), or \
            drop --in.",
        example: b"error query.bad-in: no file or module 'gnv.vl' in the program\n\
            try: volec query refs run_gvn",
    },
    Explain {
        code: b"query.bad-root", severity: b"error, exit 2",
        means: b"The root given (--root, or a last argument ending in .vl) cannot be read.",
        fix: b"Give the program's root file, or leave it out to use the default root.",
        example: b"error query.bad-root: cannot read 'mian.vl'",
    },
    Explain {
        code: b"query.budget", severity: b"note, exit 0",
        means: b"The answer was over its budget (`--budget TOKENS`; 8000 tokens by default, 2000 for \
            `query context`) and was cut at a line; the note says how much was left out (0.15).",
        fix: b"Run a `try:` line: the same command with the budget it needs, or the narrower query \
            (`show`, `callers`) for the part left out; `--budget 0` prints everything.",
        example: b"note query.budget: cut at about 40 tokens: 4 of 8 lines (about 53 tokens in all)\n\
            try: volec query show report --budget 100",
    },
    Explain {
        code: b"query.derived", severity: b"note, exit 1",
        means: b"The NAME (`Type::m`) is a method that `#[derive(...)]` makes for the struct or enum \
            (0.15: Eq's eq, Ord's cmp, Hash's hash, Debug's fmt_debug, Clone's clone): it has no \
            source of its own; the note gives the position of the trait in the attribute.",
        fix: b"Read the type (the `try:` line); the guide's formatting topic says what each derive \
            makes. To change it, write the impl by hand and take the trait out of the derive.",
        example: b"note query.derived: 'P::cmp' is derived, at main.vl:6:14: #[derive] makes it; it has no source of its own\ntry: volec query show crate::P",
    },
    Explain {
        code: b"query.empty", severity: b"note, exit 0",
        means: b"The answer is empty: no references (after --in), or a module without `use` lines, \
            header comment or extern blocks.",
        fix: b"Nothing to fix; widen --in, or check NAME with `query def`.",
        example: b"note query.empty: 0 refs",
    },
    Explain {
        code: b"query.module", severity: b"note, exit 0",
        means: b"NAME is the root module (`crate`) or `std`, which have no `mod` item to show: \
            their items are listed instead (0.15).",
        fix: b"Nothing to fix; `query items crate` lists them without the note.",
        example: b"note query.module: 'crate' is a module without a `mod` item (the root, or std); its items:",
    },
    Explain {
        code: b"query.no-file", severity: b"error, exit 1",
        means: b"`query text FILE` or `query show FILE.vl`: the file cannot be read.",
        fix: b"Check the path (relative to the current directory).",
        example: b"error query.no-file: cannot read 'tests/run/nope.vl'",
    },
    Explain {
        code: b"query.no-match", severity: b"error, exit 1",
        means: b"No definition answers to NAME (no module, for `items`; no item at FILE:LINE): a \
            typo, or a field asked without its dot (`Inst.op`, `.op`).",
        fix: b"Run a `try:` line: the definitions nearest to NAME, or the items of its module.",
        example: b"$ volec query def run_gnv\nerror query.no-match: no definition 'run_gnv'\n\
            try: volec query def crate::middle::gvn::run_gvn",
    },
    Explain {
        code: b"query.no-kind", severity: b"error, exit 2",
        means: b"(0.17) `query examples KIND` names no kind of example.",
        fix: b"`volec query examples` lists the kinds (std-fn, std-method, peephole, pass, \
            diagnostic, subcommand, test, ...); `volec guide how` the recipes they serve.",
        example: b"error query.no-kind: no kind of example 'rule' (query examples lists them)\n\
            try: volec query examples",
    },
    Explain {
        code: b"query.no-root", severity: b"error, exit 2",
        means: b"No program to read: no ROOT given, no $VOLE_ROOT, no ./main.vl and no \
            ./compiler/src/main.vl.",
        fix: b"Give the root: `--root path/to/main.vl`, or a last argument ending in .vl.",
        example: b"error query.no-root: no root (VOLE_ROOT, ./main.vl, ./compiler/src/main.vl)\n\
            try: volec query def main path/to/main.vl",
    },
    Explain {
        code: b"query.other-root", severity: b"note, exit (the answer's)",
        means: b"(0.25.2) The NAME is not defined by the default program (./main.vl or \
            ./compiler/src/main.vl; no ROOT, no $VOLE_ROOT), and one other program under the current \
            directory defines it: the answer is that program's, asked again with its --root.",
        fix: b"Nothing to fix; give `--root ROOT` (the one the note names) to ask that program directly.",
        example: b"note query.other-root: not in compiler/src/main.vl; answered from \
            examples/gpu/life/main.vl (--root examples/gpu/life/main.vl)",
    },
    Explain {
        code: b"query.programs", severity: b"note, exit 0",
        means: b"(0.25.2.1) `query grep` was given a directory of programs, not one (`--root \
            examples/gpu`, `--in examples/gpu`: a directory with no main.vl): each program under \
            it (each main.vl) was searched in turn, its code, comments and strings, and its hits \
            printed; the note counts them. Another query names one program: `error \
            query.bad-root` with a `try:` line each.",
        fix: b"Nothing to fix; give `--root DIR/NAME/main.vl` to search one of them.",
        example: b"note query.programs: 12 hits in the 5 programs under examples/gpu (each main.vl: \
            its code, comments and strings)",
    },
    Explain {
        code: b"query.reexport", severity: b"note, exit 0",
        means: b"(0.25.2.1) NAME is a name a module re-exports (`pub use types::{Color};` in \
            std::gpu makes `std::gpu::Color`), not where it is defined: the answer is about the \
            definition it names. `query items MODULE` lists a module's re-exports as `use` lines.",
        fix: b"Nothing to fix; ask by the definition's own path to go without the note.",
        example: b"note query.reexport: std::gpu::Color is std::gpu::types::Color, which std::gpu \
            re-exports (`pub use`)",
    },
    Explain {
        code: b"query.over", severity: b"note, exit 0",
        means: b"`query stats`: files over --over lines (1000 by default).",
        fix: b"Split the largest: the `try:` line gives its `query deps` for a plan.",
        example: b"note query.over: 2 files over 1000 lines\n\
            try: volec query deps crate::front::check --max-lines 1000",
    },
    Explain {
        code: b"query.partial", severity: b"note, exit 0",
        means: b"(0.19) `query arch WORDS`: no intrinsic matches every word, so the lines printed \
            are those that match the most of them.",
        fix: b"Use fewer or other words (the table's: `sub`, `eq`, `u8`, a feature, an \
            instruction), `--feature F` to list a feature's, or `volec guide arch#recipes` for \
            the intrinsics by task.",
        example: b"note query.partial: no intrinsic holds every word; these hold 1 of 2",
    },
    Explain {
        code: b"query.program-errors", severity: b"warning (error when nothing parsed)",
        means: b"The program has errors; the answer comes from what the front end got and may be \
            incomplete.",
        fix: b"Run the compilation of the `try:` line to see the errors, one per line.",
        example: b"warning query.program-errors: 4 errors in the program; results may be incomplete\n\
            try: volec --diagnostics=short main.vl -c -o /dev/null",
    },
    Explain {
        code: b"query.too-long", severity: b"error, exit 1",
        means: b"`query show FILE.vl` of a file of more than 200 lines.",
        fix: b"Show items by name, or lines by range with `query text FILE:A-B`.",
        example: b"error query.too-long: compiler/src/main.vl has 459 lines (show prints a file of at \
            most 200)\ntry: volec query text compiler/src/main.vl:1-200",
    },
    Explain {
        code: b"query.truncated", severity: b"note, exit 0",
        means: b"The answer was cut: more than 60 references (a count per file is printed), \
            --limit, or `query text` past 200 lines.",
        fix: b"Narrow with `--in FILE|MODULE`, or ask for more (`--limit N`, `--all`, the next \
            range).",
        example: b"note query.truncated: 645 refs in 44 files\n\
            try: volec query refs IntVec::push --in compiler/src/middle/vectorize.vl",
    },
    Explain {
        code: b"query.usage", severity: b"error, exit 2",
        means: b"The query command line is wrong: no or an unknown command or option, a missing \
            NAME or value, an extra argument.",
        fix: b"Run the corrected command of the `try:` line; `volec query --help` lists them.",
        example: b"error query.usage: unknown command 'deff'\ntry: volec query def main",
    },
    Explain {
        code: b"patch.ambiguous", severity: b"error, exit 1",
        means: b"`edit patch`: an OLD (or an ANCHOR) occurs several times in TARGET; their lines \
            are listed.",
        fix: b"Give more of the text around it: each `try:` line widens OLD and NEW until unique; \
            or `--nth N` patches the Nth (`--all`: every one, 0.16).",
        example: b"error patch.ambiguous: OLD 1 occurs 2 times in crate::calc::clamp, lines 6, 9\n\
            try: volec edit patch clamp --old 'return lo;' --new 'return 0 + lo;'",
    },
    Explain {
        code: b"patch.nth", severity: b"error, exit 1",
        means: b"`edit patch --nth N` (`edit insert --nth N`, 0.16): OLD (the ANCHOR) occurs fewer \
            than N times in TARGET.",
        fix: b"Count again from 1 among the lines patch.ambiguous lists, or give more of the text \
            around OLD; `--all` patches every occurrence.",
        example: b"error patch.nth: OLD 1 occurs 3 times in crate::calc::clamp; --nth 4 is past the last",
    },
    Explain {
        code: b"patch.format", severity: b"error, exit 2",
        means: b"The pairs on stdin are not blocks of `            lines.",
        fix: b"Write each pair as a block: the markers alone on their lines, OLD and NEW between.",
        example: b"error patch.format: stdin line 1: text outside a block; pairs are blocks of lines: \
            <<<<<<< OLD, the old lines, =======, the new lines, >>>>>>> NEW",
    },
    Explain {
        code: b"patch.no-match", severity: b"error, exit 1",
        means: b"`edit patch`: an OLD (or ANCHOR) is not in TARGET's text; the nearest line is \
            named.",
        fix: b"Copy OLD from the nearest line (the `try:` line), or add --loose for other blanks.",
        example: b"error patch.no-match: OLD 1 is not in crate::calc::clamp; nearest, line 5: if v < lo {\n\
            try: volec edit patch clamp --old 'v < lo' --new 'v <= lo'",
    },
    Explain {
        code: b"patch.loose", severity: b"note",
        means: b"(0.25.2) `edit patch`: an OLD of several lines is not in TARGET as written but is, \
            once, with other indentation; it was matched as with --loose, NEW re-indented like the \
            lines it replaced.",
        fix: b"Nothing; look at the diff (--show) when NEW's indentation matters.",
        example: b"note patch.loose: OLD 1 matched with other indentation at line 12; NEW re-indented \
            like it (--loose)",
    },
    Explain {
        code: b"patch.no-region", severity: b"error, exit 1",
        means: b"`edit patch MODULE::use` or `MODULE::header`, and the module has none.",
        fix: b"Add them with `edit replace MODULE::use < uses.vl` (or `::header`).",
        example: b"error patch.no-region: no use lines in crate::tools; edit replace adds them\n\
            try: volec edit replace crate::tools::use < uses.vl",
    },
    Explain {
        code: b"patch.overlap", severity: b"error, exit 1",
        means: b"Two OLDs of one `edit patch` overlap in TARGET's text.",
        fix: b"Merge them into one pair, or make them disjoint.",
        example: b"error patch.overlap: OLD 1 and OLD 2 overlap",
    },
    Explain {
        code: b"edit.format", severity: b"error, exit 2",
        means: b"`edit apply` (0.15): the blocks' file is not blocks: text before the first header, \
            a header naming nothing, a block without text (or a delete block with text).",
        fix: b"Start each block with a header: `@@ NAME` (replace), `@@ new after NAME`, `@@ new \
            before NAME`, `@@ new in MODULE`, `@@ delete NAME`, or a header line of `query show` \
            (`// PATH<TAB>FILE:A-B`).",
        example: b"error edit.format: items.vl line 1: text before the first header; a block starts with `@@ NAME`, ...",
    },
    Explain {
        code: b"edit.no-module", severity: b"error, exit 1",
        means: b"`edit apply` (0.15): a block adds a new item to a module (`@@ new in MODULE`, or \
            a new path) that has no file of its own (or no such module).",
        fix: b"Name an item to put it after (`@@ new after NAME`), or make the module first \
            (`refactor new-module`).",
        example: b"error edit.no-module: no module 'shapez' with a file of its own; name an item to put the text after (`@@ new after NAME`)",
    },
    Explain {
        code: b"edit.breaks", severity: b"error, exit 1 (warning with --dry-run or --no-check)",
        means: b"The edited program has errors the program had not; they are printed, each \
            tagged with the item it is in (`[edited: PATH]` for text the edit changed, `[in \
            PATH]` for an item it does not change; 0.15), and nothing is written.",
        fix: b"Errors in the edited text: change the edit. Errors in other items: change them in \
            the same edit (`edit apply`, or `edit patch` with `@@ NAME` blocks), or run the \
            refactoring the `note edit.refactor` names first. --no-check writes it anyway \
            (`volec check` lists what is left).",
        example: b"main.vl:13:25: error[type error] expected 'i64', got 'bool'  [in crate::total]\n\
            error edit.breaks: 1 new error (1 in crate::total, which the edit does not change); nothing written\n\
            note edit.together: change crate::total in the same edit: ...\ntry: volec query show crate::total",
    },
    Explain {
        code: b"edit.exists", severity: b"error, exit 1",
        means: b"A file the edit makes exists already.",
        fix: b"Choose another name or path, or remove the file first.",
        example: b"error edit.exists: 'geom/shapes.vl' exists already",
    },
    Explain {
        code: b"edit.imports", severity: b"note, exit 0",
        means: b"`edit replace`, `insert` or `patch` (0.14): the new text used names of other \
            modules that its file does not import; the edit adds their `use` lines, as `fix \
            --only imports` does, and is checked with them.",
        fix: b"Nothing to do; `--show` or `query diff` shows the lines added.",
        example: b"note edit.imports: added the imports the new text needs (fix --only imports)",
    },
    Explain {
        code: b"edit.overlap", severity: b"error, exit 1",
        means: b"`edit apply` (0.15): two blocks change one item (or one inside the other).",
        fix: b"Give each item one block, with all of its new text.",
        example: b"error edit.overlap: crate::shapes::area is changed twice in one edit; give each item one block",
    },
    Explain {
        code: b"edit.refactor", severity: b"note (with edit.breaks)",
        means: b"The edit changed an item's shape (a function's name or parameters, a struct's \
            fields, an enum's variants) and its uses no longer fit (0.15): the `try:` lines \
            after it are the refactorings that change the uses with it, computed from the old \
            and the new text.",
        fix: b"Run the refactoring (fill in VALUE, the argument each call gets, or EXPR), then \
            the rest of the edit; or change the uses in the same edit (`edit apply`).",
        example: b"note edit.refactor: the uses of crate::shapes::scale no longer fit its new shape: ...\n\
            try: volec refactor signature crate::shapes::scale --add 'm: i64 = VALUE'",
    },
    Explain {
        code: b"edit.together", severity: b"note (with edit.breaks)",
        means: b"Items the edit does not change have new errors (0.15); their text is the `try:` \
            line's `query show`.",
        fix: b"Change them in the same edit: `edit apply FILE` with a block per item (the edited \
            ones and these), or `edit patch --pairs FILE` with `@@ NAME` blocks.",
        example: b"note edit.together: change crate::main in the same edit: ...\ntry: volec query show crate::main",
    },
    Explain {
        code: b"edit.generated", severity: b"error, exit 1",
        means: b"The edit changes a generated file, one whose first line says `// Generated by \
            SCRIPT` (0.25.5): the script would write it again, and the change would be lost.",
        fix: b"Change what the script makes the file from (its generator, its input) and run \
            the script; or, for a change meant to stay until the next run, the same command \
            with `--force`.",
        example: b"error edit.generated: compiler/src/front/stdsrc.vl is generated by \
            compiler/std/embed.sh (its first line says so): change what the script makes it \
            from and run it; nothing written\ntry: volec edit patch ... --force",
    },
    Explain {
        code: b"edit.journal", severity: b"warning, exit 0",
        means: b"The edit was written, but the journal (.git/vole-edits) could not be: `undo` \
            will not know it.",
        fix: b"Check that the git directory is writable; `git diff` still shows the change.",
        example: b"warning edit.journal: cannot write the journal in .git/vole-edits; undo will not know this edit",
    },
    Explain {
        code: b"edit.layout", severity: b"error, exit 1",
        means: b"An insertion next to an item that shares its line with other code (a field of a \
            one-line struct), or a header next to a header.",
        fix: b"Replace the enclosing item instead (`edit replace`), or `edit replace MODULE::header`.",
        example: b"error edit.layout: crate::P.x shares its line with other code; insert needs an item on lines of its own",
    },
    Explain {
        code: b"edit.no-parent", severity: b"error, exit 1",
        means: b"`edit new-file PATH`: no file of the program would hold PATH as a child module's \
            file (a mod.vl or the root next to it, or the file its directory is named after).",
        fix: b"Make the parent module first (`refactor new-module`), or choose a path next to a \
            file of the program; `query items` lists the modules and their files.",
        example: b"error edit.no-parent: no file of the program has geom/shapes.vl as a child's file \
            (a mod.vl or the root next to it, or the file its directory is named after)\n\
            try: volec query items",
    },
    Explain {
        code: b"edit.no-text", severity: b"error, exit 2",
        means: b"`edit replace` or `insert` without TEXT on stdin; `edit patch` without pairs.",
        fix: b"Give the text on stdin (`< new.vl`), or --old OLD --new NEW.",
        example: b"error edit.no-text: the new text is read from stdin; none was given\n\
            try: volec edit replace clamp < new.vl",
    },
    Explain {
        code: b"edit.not-source", severity: b"error, exit 1",
        means: b"NAME is the standard library's or a C header's, not the program's own source \
            (outside the vole repository: there, a std item is edited in compiler/std, edit.std).",
        fix: b"Edit the program's own items; std is changed in the vole repository \
            (`volec guide how add-std-fn`).",
        example: b"error edit.not-source: std::Vec::push is in <std>, not in a file of the program",
    },
    Explain {
        code: b"edit.std", severity: b"note, exit 0 (warning: embed.sh failed)",
        means: b"(0.17) The edit changed std's files (compiler/std/*.vl, edited by name in the \
            vole repository and checked with them), and compiler/std/embed.sh made \
            compiler/src/front/stdsrc.vl, the std built into the compiler, from them; undo does \
            the same.",
        fix: b"Rebuild the compiler to use the new std (`bootstrap/bootstrap.sh --dev`), then its \
            tests (`tests/run.sh std`); a warning: run compiler/std/embed.sh and read its error.",
        example: b"note edit.std: ran compiler/std/embed.sh: compiler/src/front/stdsrc.vl has \
            std's new text; rebuild to use it (bootstrap/bootstrap.sh --dev)",
    },
    Explain {
        code: b"edit.unchanged", severity: b"note, exit 0",
        means: b"The edit changes nothing (the text is already so).",
        fix: b"Nothing to fix.",
        example: b"note edit.unchanged: nothing to change",
    },
    Explain {
        code: b"edit.unchecked", severity: b"warning",
        means: b"The edited program could not be checked (`volec check` did not run).",
        fix: b"Run `volec check` yourself; the edit was made without the check.",
        example: b"warning edit.unchecked: the edited program could not be checked (volec check did not run)",
    },
    Explain {
        code: b"edit.usage", severity: b"error, exit 2",
        means: b"The edit command line is wrong: an unknown subcommand or option, a missing NAME.",
        fix: b"Run the corrected command of the `try:` line (docs/refactor.md).",
        example: b"error edit.usage: no command (patch, replace, insert, delete)\n\
            try: volec edit replace NAME < new.vl",
    },
    Explain {
        code: b"edit.wrap", severity: b"error, exit 1",
        means: b"`edit wrap`: TARGET is not a function with a body, the lines given are not all in \
            it, or they are blank.",
        fix: b"Name a function, or give --lines A-B inside it (`query show TARGET` prints its lines).",
        example: b"error edit.wrap: lines 3-40 are not all in crate::area (lines 10-18)\n\
            try: volec query show crate::area",
    },
    Explain {
        code: b"edit.write", severity: b"error, exit 1",
        means: b"A file of the edit cannot be written.",
        fix: b"Check the permissions of the file and its directory; nothing else was written.",
        example: b"error edit.write: cannot write 'main.vl'",
    },
    Explain {
        code: b"undo.changed", severity: b"error, exit 1",
        means: b"A file of the last edit changed since: undoing would lose that change.",
        fix: b"Look at `volec query diff`; `undo --force` restores the file anyway.",
        example: b"error undo.changed: main.vl changed since the edit\ntry: volec undo --force",
    },
    Explain {
        code: b"undo.empty", severity: b"error, exit 1",
        means: b"No edit to undo (or to show with `query diff`): the journal is empty.",
        fix: b"Nothing to undo; `git diff` shows changes made otherwise.",
        example: b"error undo.empty: no edit to undo",
    },
    Explain {
        code: b"check.std-files", severity: b"note, exit 0",
        means: b"(0.17) In the vole repository, std's files (compiler/std/*.vl) are not the \
            std built into this compiler (changed since it was built): `check` reads std from \
            them, every function of std checked, as the next build will compile it.",
        fix: b"Nothing to fix; rebuild the compiler (`bootstrap/bootstrap.sh --dev`) to build the \
            new std in.",
        example: b"note check.std-files: std's files differ from this compiler's std: checked \
            with compiler/std (bootstrap/bootstrap.sh --dev builds them in)",
    },
    Explain {
        code: b"check.usage", severity: b"error, exit 2",
        means: b"The check command line is wrong: an unknown option or an extra argument.",
        fix: b"`volec check [ROOT]`.",
        example: b"error check.usage: unknown option '--all'",
    },
    Explain {
        code: b"fix.ambiguous", severity: b"error, exit 1",
        means: b"`fix --only imports` (0.16): a name the module uses is public in several modules, \
            and more than one of them is nearest (the innermost module holding both, then the \
            fewest path segments; std is farther than any of the program's): nothing is imported \
            for it. The other fixes are made.",
        fix: b"Run the `try:` line of the module you mean: `--use PATH::NAME` imports NAME from \
            there (repeat --use for several names).",
        example: b"error fix.ambiguous: crate::back uses 'is_blank', which 2 modules as near have: \
            crate::back::asm, crate::back::obj; nothing is imported for it: name one with --use\n\
            try: volec fix --only imports --use crate::back::asm::is_blank",
    },
    Explain {
        code: b"fix.bad-in", severity: b"error, exit 1",
        means: b"`fix --in` names no file or module of the program.",
        fix: b"Give a file's path (or its end) or a module, or drop --in.",
        example: b"error fix.bad-in: no file or module 'gnv' in the program",
    },
    Explain {
        code: b"fix.none", severity: b"note, exit 0",
        means: b"Nothing to fix: no missing or unused imports, no `pub` or `unsafe` to add; with \
            --suggested, no error has an exact fix (a did-you-mean with two names as near, a \
            missing argument no local gives).",
        fix: b"Nothing to fix by the tool: the errors left need a decision (their help says what).",
        example: b"note fix.none: nothing to fix",
    },
    Explain {
        code: b"fix.conv_left", severity: b"note, exit 0",
        means: "(0.20) `fix --only conventions` rewrote the 0.19 spelling into 0.20's \
            (docs/design/conventions.md §9.2) but for these places, which need a decision: a \
            shared reference local (`let r = &e;`), a reference local that may be re-pointed, an \
            `&e` no let parameter or field takes, `&&`, a by-value owned parameter of a function \
            type or closure, an identifier named `var`, `inout` or `sink`, a by-value parameter \
            of a template the program never instantiates.".as_bytes(),
        fix: b"Run it again with --list-left for each place (FILE:LINE:COL and what to do), then \
            change them by hand: `e` itself for a shared local, `inout r = &e;` for an exclusive \
            one, `x: sink T` for a parameter that is consumed, a new name for a keyword.",
        example: b"note fix.conv_left: 3 left to hand: a shared reference local ('let r = &e;'): use 'e' itself, or a let parameter",
    },
    Explain {
        code: b"fix.edition_left", severity: b"note, exit 0",
        means: b"(0.27.3) `fix --edition rust` translated the MVS program into the rust edition \
            (guide fix#edition) but for these places, which need a decision: a reference to a \
            reference (`&&`), a shared reference local (`let r = &e;`) whose borrow Rust checks, \
            a print of a value that is not a format literal, a std call whose rewrite.tsv row \
            says `!` (its note says how), bytes used both as text and as bytes (kept `&[u8]`); \
            (0.28.0) a write into a part of a static where a copy of it is not proven its only \
            view while it lives (written in place through its raw address, in unsafe code).",
        fix: b"Run it again with --list-left for each place (FILE:LINE:COL and what to do), then \
            change them by hand: the rust check's errors printed after the translation name \
            the lines; `str::from_utf8` where bytes are printed as text.",
        example: b"note fix.edition_left: 2 left to hand (--list-left lists them): 2 a std call rewrite.tsv leaves to hand (its note says how);",
    },
    Explain {
        code: b"fix.edition_none", severity: b"note, exit 0",
        means: b"(0.28.0) `fix --edition rust` was given a program in the rust edition already: \
            its root has the line `// EDITION: rust`. There is nothing to translate, and nothing \
            is written (tests/gate3.sh checks that compiler/src is such a fixed point).",
        fix: b"Nothing: translate an MVS program, one whose root has no such line.",
        example: b"note fix.edition_none: the program is in the rust edition already (its root's `// EDITION: rust`): nothing to translate",
    },
    Explain {
        code: b"fix.left", severity: b"note, exit 0",
        means: b"(0.18) `fix --suggested` made the errors' exact fixes (the edit is written, \
            `volec undo` takes it back); these errors of the edited program are left, printed \
            above it as `check` prints them: those with no exact fix, and those the fixes let the \
            checker reach. An error the edit made on a line it wrote refuses the edit instead \
            (edit.breaks).",
        fix: b"Fix the errors above by hand (their help and try: lines say how); no build is \
            needed to see them.",
        example: b"fixed 1 missing import, 1 pub, 4 suggested fixes\t2 files\t+6 -5 lines\n\
            render.vl:107:9: error[type error] function 'render::pad_cell' expects 4 arguments, \
            got 3 | try: pad_cell(out, Table::cell(row, c), widths[c], VALUE)\n\
            note fix.left: 1 error left (above)",
    },
    Explain {
        code: b"fix.refused", severity: b"note (the other fixes are made)",
        means: b"(0.25.2.1) `fix --suggested` did not make this fix, as it is not safe: a \
            conversion that loses the value (a float to an integer, f64 to f32, to an integer \
            type that does not hold every value) or of what a cast gives; or, on the edited \
            program, an error the program had not in the fix's own text, or at its error's \
            place (the fix changed the type of what is there, or its import brought another \
            item than the name meant). The error is left, with its help.",
        fix: b"Read the error and its help, and make the change that is meant by hand: convert \
            on purpose (`x as i64` when truncating is wanted), change the type of the place, \
            write the missing local or parameter, or name the item to import.",
        example: b"note fix.refused: main.vl:3:13: not applied: `std::abs((a - b))`: the edited \
            program has a new error with it: main.vl:3:23: error[type error] expected 'i64', \
            got 'f64'",
    },
    Explain {
        code: b"fix.casts", severity: b"note, exit 0",
        means: b"(0.26.3) `fix --only casts` took away a usize's `as i64` (`s.len as i64`, \
            `v.len() as i64`) where the value means the same as a usize, and counts every such \
            cast by where its value goes. Removed: an index; a slicing's end (`a[i..a.len as \
            i64]` becomes `a[i..]`, `a` a name or its fields); a comparison with a usize, a \
            literal or another removed cast; the bound of a `for` whose counter is used only so; \
            a `let` (not `var`, no type) used only so. Never touched: a value that reaches `-` \
            (it may go below 0), other arithmetic, an i64 (a field, an argument, a returned \
            value, a comparison with an i64 counter), a sign test (`< 0`, `>= 0`), a closure, a \
            cast the checker copied (a generic instance), and casts of other types.",
        fix: b"Nothing to do: the casts kept are conversions the program needs as written. \
            `fix --only casts-list` lists each one (FILE:LINE, kept or removed, where its value \
            goes) without writing.",
        example: b"note fix.casts: usize to i64 casts: removed index 2 slice-end 1 compare 5 loop 2 \
            let 1; kept sub 1 arith 2 cmp-i64 2 stored 4 other 0 refused 2 copied 3; other \
            casts to i64 noop 0 not-usize 0",
    },
    Explain {
        code: b"fix.rawptr", severity: b"note, exit 0",
        means: b"(0.26.4) `fix --only rawptr` decided the program's raw pointer parameters \
            (`p: *T`, `p: sink *T` of a safe function of its own), and counts each by class. \
            read and write: only read, or written through; both become `p: inout T` when T is a \
            plain value over 16 bytes (a let parameter would copy it), else a read one becomes \
            `p: T`; the calls give `&x` (a parameter passed on: `&p`, a raw pointer: `&*q` in \
            unsafe code), and `*p` becomes `p`. caller: decided, but a call gives a raw pointer \
            (`&*q`). escape: the pointer itself is used and it stays `*T`: stored, returned, \
            cast, compared, indexed, assigned, captured, given null, a C string or a place \
            reached through a raw pointer, passed on to a parameter used as an address, or given \
            to a call nested in the arguments of another call that takes the same place \
            (nested-call: two inout accesses would conflict) where it cannot be taken into a \
            let: (0.27.0) a call at its statement's top (a let's value, an expression \
            statement, an assignment to a name or its fields and indexes, a block's value, a \
            return's, an if's condition) whose argument nests a call given the same local as it \
            is has that argument, and those before it that call or read the local, taken into \
            lets before the statement (`let get_v = get(cx, 1); put(cx, 0, get_v);`); so too an \
            argument nesting such calls, an operator's operands (of `&&` and `||`, the left) and \
            a place's index. Such a run decides no parameter; the next takes the calls nested in \
            the lets' values in turn, and the first that takes none decides. fixed: its \
            signature cannot change (an unsafe fn, C's, a trait's, a receiver, `**T`, `*[T]`).",
        fix: b"Nothing to do. `fix --only rawptr-list` lists each parameter (FILE:LINE, its class, \
            the first reason, the function, the parameter, the kind of T, the callee or caller \
            that decided it, for nested-call `at FILE:LINE`, the call that keeps it) without \
            writing; `fix --only unneeded-unsafe` then takes away the unsafe blocks left with \
            nothing unsafe inside.",
        example: b"note fix.rawptr: raw pointer parameters: read 0 write 2 escape 4 caller 1 fixed \
            0; ...; edits: to inout 3, to let 0, `&p` 5, `&x` to `x` 0, `*p` to `p` 1, `&*q` 1 \
            (in a new unsafe block 0)",
    },
    Explain {
        code: b"fix.statics", severity: b"note, exit 0; error, exit 1",
        means: b"(0.26.4) `fix --only statics --group FILE` moved a group of statics into a \
            context passed down: each function naming one, and its callers up to the group's \
            owners, takes the parameter last (before a parameter with a default), inout where \
            it or a callee writes the context (an assignment, `&X`, a method whose receiver is \
            not a let), let otherwise; each use becomes `NAME.field`, each call gives `&NAME` \
            or `NAME`, and each owner begins with `var NAME = INIT;`. The note counts the \
            statics, the functions using them, those given the parameter and the edits. The \
            error: a function needing the context that no owner reaches (`main`, a C entry, a \
            function used as a value, a trait's method, a generated file's), or one with a local of the \
            parameter's name; nothing is changed. (0.26.5) The same run adds the group file's \
            `use PATH` lines where a function takes the context and its `owner-use PATH` lines \
            where an owner makes it, takes the statics out of the `use` lines and deletes their \
            declarations; a static in a format literal's hole becomes `{field}` and the named \
            argument `field = NAME.field`; the context goes among named arguments named, in its \
            parameter's place; a static lent beside the context (`f(&X, &NAME)`) is taken into a \
            local and put back after the statement when f does not use it through the context \
            (else it is left, and a note says where); a function given the context before (a \
            parameter `NAME: TYPE`) keeps it, made inout where it now changes the context, and \
            an owner with the local keeps it. `--prune PREFIX,...` with `--only statics-list` \
            prints the group without the statics that make a refused function, or one outside \
            the prefixes, take the context (`crate`: refusals only), in rounds. A `view PATH EXPR` \
            line names a function that gives its calls the context as EXPR, let (a thread's task \
            loop reaching it through a pointer): refused (refused-view) when a callee changes \
            the context, and --prune then leaves out what that callee writes.",
        fix: b"The note: nothing to do; `volec fmt` the files it changed. The error: name an \
            owner above the function in the group file (`owner PATH`), another parameter name, \
            or leave out what reaches it: `fix --only statics-list --group FILE --prune crate` \
            prints the group without those statics; `fix --only statics-list --group FILE` lists \
            each function (inout, let, given-let, given-inout, given-let-to-inout, owner or the \
            refusal, an inout one's first write) without writing.",
        example: b"note fix.statics: statics 3; functions using them 4, given the parameter 7 \
            (inout 3), owners 1; edits: uses 9, calls 11, parameters 7, statements given their \
            arguments as lets 1",
    },
    Explain {
        code: b"fix.effects",
        severity: b"note, exit 0",
        means: b"(0.27.2.1) `fix --only effects` wrote `#[effects(..)]` above each undeclared `pub` \
            function and inherent `pub` method: its inferred set, or, for a generic one, the union \
            over the program's instances of what each does itself and through callees not made for a \
            type argument, with the parameters such an edge was made for listed \
            (docs/design/contracts-effects.md E3.3a, E3.6). The note counts the declarations. \
            `--only effects-std` prints std's instead, a line each, `<std>:LINE<TAB>THE LINE`, for \
            tools/std2-effects.py.",
        fix: b"Nothing to do; `volec fmt` the files it changed. `volec query items MODULE --undeclared` \
            counts what is left.",
        example: b"note fix.effects: 12 effect declarations",
    },
    Explain {
        code: b"fix.buf-refused", severity: b"note, exit 1",
        means: b"(0.26.3) `fix --only buf` left a std `Buf` binding as it is: a local, a \
            parameter, a field or a result, with the bindings its value flows between (through \
            an Option or a Vec that holds it, a pattern, an enum variant's field, a closure's \
            capture too). It writes `Vec<u8, A>` when a write says bytes (a non-constant byte, \
            a constant at or above 0x80, a push_str of a [u8], an index) or none does, and \
            `String<A>` when a write says text and none bytes (a push_str of a str and a \
            constant byte below 0x80 are the same bytes in a Vec, and a format write is \
            `extend_from_slice(format_in(.., v.allocator()).as_bytes())` there, so they give \
            way to bytes). Refused: a Buf printed or given to a String, with bytes (mixed), a \
            binding passed to a std function whose \
            parameter is written Buf, one written through a by-value parameter, and a method \
            that has no form on the side decided (fix.buf-table).",
        fix: b"Write the type by hand: `String<A>` for text, `Vec<u8, A>` for bytes (a push of \
            0xC3 is one byte in a Vec, two in a String, which pushes a code point). The note \
            names the writes on each side.",
        example: b"note fix.buf-refused: 'm' at main.vl:41:9: mixed: text (printed \
            as text at main.vl:42:5) and bytes (push of a byte that is not a constant at \
            main.vl:44:5)",
    },
    Explain {
        code: b"fix.buf-table", severity: b"note",
        means: b"(0.26.3) The table `fix --only buf` maps Buf's methods through: each method, \
            its String<A> form and its Vec<u8, A> form (`push_str` is `extend_from_slice` on a \
            Vec; `-`: none, and a binding that calls it on that side is refused).",
        fix: b"Nothing to do: it is printed with every run, so a reader knows what each call \
            became.",
        example: b"note fix.buf-table: Buf's methods, as String<A> (text) and Vec<u8, A> \
            (bytes); '-': none, the binding is refused",
    },
    Explain {
        code: b"fix.usage", severity: b"error, exit 2",
        means: b"The fix command line is wrong: an unknown option, an --only kind that is not one, \
            --at without --suggested or not FILE:LINE.",
        fix: b"--only takes imports, unused, pub, unsafe, suggested (0.18: `--suggested`, the \
