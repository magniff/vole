        example: b"error conflict.none: no conflict region in an item 'nosuch'\ntry: volec query conflicts",
    },
    Explain {
        code: b"conflict.ambiguous", severity: b"error, exit 1",
        means: b"`edit resolve`: several conflict regions match TARGET (a FILE, or a NAME several regions \
