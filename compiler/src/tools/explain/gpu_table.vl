        fix: b"Rename one of them.",
        example: b"embed wgsl K {\n\
            \x20   fn f() {}\n\
            \x20   fn f() {}\n\
            }\n\
            \n\
            main.vl:3:8: error[wgsl.redefined] 'f' is declared twice at module scope",
    },
