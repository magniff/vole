            \x20   let mut enc = dev.encoder();\n\
            \x20   enc.compute_pass(|pass| {\n\
            \x20       pass.set_pipeline(&pipe);\n\
            \x20       pass.set_bind_group(0, &g);\n\
            \x20       pass.dispatch(1);\n\
            \x20   });\n\
            \x20   queue.submit(enc.finish());\n\
            \x20   Ok(())\n\
