        example: "main.vl:52:5: gpu.unwritten: binding 1 of group 0 (a uniform buffer of 16 bytes) was never written: write it (queue.write_buffer) before submitting the first dispatch or draw that reads it",
    },
    Explain {
        code: "gpu.usage",
        severity: "error (run time)",
        means: "A buffer or texture used in a way its usage does not allow: copied from \
