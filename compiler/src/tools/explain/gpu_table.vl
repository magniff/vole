        fix: b"Make the bind group from `pipe.bind_layout(i)`, with one entry for each binding the \
            message lists.",
        example: b"use std::gpu;\n\
            use std::gpu::BufferUsage;\n\
            \n\
            embed wgsl K {\n\
            \x20   @group(0) @binding(0) var<storage, read_write> xs: array<u32>;\n\
            \x20   @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
            \x20       xs[id.x] += 1u;\n\
