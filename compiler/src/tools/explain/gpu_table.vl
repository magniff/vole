// The explanations of the shader compiler's codes, `wgsl.*` (std::gpu::wgsl:
// `volec check` reports them in an `embed wgsl` block, `shader_wgsl` returns
// them at run time), and of std::gpu's, `gpu.*` (0.26.0): the names in the
// `else "gpu.X: .."` texts of std::gpu's `requires` clauses and in its other
// failures. tests/refactor/run.sh (self_explain) collects them from std's text.

use crate::tools::explain::Explain;

pub const GPU_COUNT: i64 = 33;

pub static GPU_TABLE: [Explain; 33] = [
    Explain {
        code: "wgsl.syntax",
        severity: "error",
        means: "The text is not WGSL: a token where another is expected, a declaration WGSL \
            does not have at module scope, mixed operators that need parentheses (`a & b | c`, \
            `a < b < c`, `&&` with `||`).",
        fix: "Write the construct the message names; parenthesize mixed operators.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       let x = 1 & 2 | 3;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:23: error[wgsl.syntax] mixing bitwise operators with other operators needs parentheses",
    },
    Explain {
        code: "wgsl.name",
        severity: "error",
        means: "A name that is neither declared in scope, at module scope, nor a WGSL builtin; \
            or a type name that is not a type.",
        fix: "Declare it, or correct the spelling (WGSL is case-sensitive: `vec3f`, \
            `textureSample`).",
        example: "embed wgsl K {\n\
            \x20   @fragment\n\
            \x20   fn fs() -> @location(0) vec4<f32> {\n\
            \x20       return colour;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:16: error[wgsl.name] unknown name 'colour'",
    },
    Explain {
        code: "wgsl.type",
        severity: "error",
        means: "A value of the wrong type: WGSL converts nothing implicitly but abstract \
            numbers (`1`, `1.0`), so `i32`, `u32` and `f32` do not mix, and a condition is a \
            `bool`.",
        fix: "Convert explicitly: `f32(x)`, `u32(x)`, `i32(x)`; write a literal of the right \
            type: `1u`, `1i`, `1.0`.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       let v = vec3<f32>(1.0);\n\
            \x20       let w = v + 2i;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:5:19: error[wgsl.type] '+' cannot take vec3<f32> and i32\n\
            \x20 help: convert one side: f32(...)",
    },
    Explain {
        code: "wgsl.redefined",
        severity: "error",
        means: "A name declared twice in the same scope (module scope, a struct's members, a \
            function's parameters).",
        fix: "Rename one of them.",
        example: "embed wgsl K {\n\
            \x20   fn f() {}\n\
            \x20   fn f() {}\n\
            }\n\
            \n\
            main.vl:3:8: error[wgsl.redefined] 'f' is declared twice at module scope",
    },
    Explain {
        code: "wgsl.unsupported",
        severity: "error",
        means: "WGSL this release's subset does not have (docs/design/gpu.md §2.10): `f16`, \
            `override`, `const_assert`, extensions, cube, 3D and multisampled textures, pointer \
            parameters beyond function and private ones.",
        fix: "Write it without the feature: `f32` for `f16`, a `const` or a uniform for an \
            `override`.",
        example: "embed wgsl K {\n\
            \x20   override n: u32 = 4u;\n\
            }\n\
            \n\
            main.vl:2:5: error[wgsl.unsupported] 'override' constants are not in the WGSL subset of this release\n\
            \x20 help: use a 'const', or a uniform buffer",
    },
    Explain {
        code: "wgsl.attr",
        severity: "error",
        means: "An attribute that does not exist, or with the wrong arguments: \
            `@workgroup_size` takes 1 to 3 constant integers from 1 to 1024 (1024 in all), \
            `@builtin` a builtin value's name.",
        fix: "Use `@vertex`, `@fragment`, `@compute @workgroup_size(X, Y, Z)`, \
            `@builtin(NAME)`, `@location(N)`, `@interpolate(flat)`.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(2048)\n\
            \x20   fn main() {}\n\
            }\n\
            \n\
            main.vl:2:30: error[wgsl.attr] a workgroup size is 1 to 1024",
    },
    Explain {
        code: "wgsl.binding",
        severity: "error",
        means: "A uniform, storage, texture or sampler variable without `@group(G) \
            @binding(B)`, or two variables at the same group and binding.",
        fix: "Give each resource its own `@group(G) @binding(B)`.",
        example: "embed wgsl K {\n\
            \x20   var<uniform> u: vec4<f32>;\n\
            }\n\
            \n\
            main.vl:2:18: error[wgsl.binding] a resource needs '@group(G) @binding(B)'",
    },
    Explain {
        code: "wgsl.layout",
        severity: "error",
        means: "A uniform buffer's type breaks the uniform address space's alignment rules: \
            array strides and nested structs at multiples of 16 bytes.",
        fix: "Use `vec4` elements (or pad them), or move the data to a storage buffer.",
        example: "embed wgsl K {\n\
            \x20   struct P { a: array<f32, 4> }\n\
            \x20   @group(0) @binding(0) var<uniform> p: P;\n\
            }\n\
            \n\
            main.vl:3:40: error[wgsl.layout] in a uniform buffer an array's stride is a multiple of 16; array<f32, 4> has 4\n\
            \x20 help: use vec4 elements, or a storage buffer",
    },
    Explain {
        code: "wgsl.cycle",
        severity: "error",
        means: "A type or constant defined in terms of itself.",
        fix: "Break the cycle.",
        example: "embed wgsl K {\n\
            \x20   const a: i32 = b;\n\
            \x20   const b: i32 = a;\n\
            }\n\
            \n\
            main.vl:2:5: error[wgsl.cycle] 'a' refers to itself",
    },
    Explain {
        code: "wgsl.const",
        severity: "error",
        means: "A constant expression that overflows its type, divides by zero or shifts by \
            its width or more; a literal out of range.",
        fix: "WGSL evaluates constant expressions at translation: change the values, or \
            compute it at run time.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       let x = 2147483648i;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:17: error[wgsl.const] this i32 literal is above 2147483647\n\
            \x20 help: negate a smaller literal, or use an abstract integer: -2147483648",
    },
    Explain {
        code: "wgsl.index",
        severity: "error",
        means: "A constant index out of a fixed-size array's, vector's or matrix's range.",
        fix: "The index is 0 to length - 1 (run-time indices are clamped instead).",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       var a = array<u32, 4>();\n\
            \x20       a[4] = 1u;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:5:11: error[wgsl.index] index 4 is out of range: the length is 4",
    },
    Explain {
        code: "wgsl.member",
        severity: "error",
        means: "A member a struct does not have, or a swizzle a vector does not have \
            (`.xyzw` or `.rgba`, not mixed, at most 4).",
        fix: "Use one of the members the help lists.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       let v = vec2<f32>(1.0);\n\
            \x20       let z = v.z;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:5:19: error[wgsl.member] '.z' is not a component of a vec2\n\
            \x20 help: components are x y z w (or r g b a), not mixed",
    },
    Explain {
        code: "wgsl.access",
        severity: "error",
        means: "A write to a variable that is read-only: a `var<storage>` (read by default) \
            or a `var<uniform>`.",
        fix: "Declare it `var<storage, read_write>`, or write elsewhere.",
        example: "embed wgsl K {\n\
            \x20   @group(0) @binding(0) var<storage> data: array<u32>;\n\
            \x20   @compute @workgroup_size(64)\n\
            \x20   fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
            \x20       data[id.x] = 1u;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:5:9: error[wgsl.access] cannot write to a read-only storage variable\n\
            \x20 help: declare it 'var<storage, read_write>'",
    },
    Explain {
        code: "wgsl.assign",
        severity: "error",
        means: "An assignment to a value: a `let`, a parameter, a call's result.",
        fix: "Assign to a `var`, a member or element of one, or through a pointer: `*p = x`.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       let x = 1;\n\
            \x20       x = 2;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:5:9: error[wgsl.assign] cannot assign to this: it is a value, not a variable\n\
            \x20 help: assign to a 'var' (a 'let' is immutable), a member or element of one, or '*p'",
    },
    Explain {
        code: "wgsl.call",
        severity: "error",
        means: "A call with the wrong number of arguments, of a name that is not a function, \
            or of an entry point.",
        fix: "Match the function's parameters; move an entry point's body into a function \
            both call.",
        example: "embed wgsl K {\n\
            \x20   fn f(a: i32) -> i32 { return a; }\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       _ = f(1, 2);\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:5:13: error[wgsl.call] 'f' takes 1 argument, got 2",
    },
    Explain {
        code: "wgsl.recursion",
        severity: "error",
        means: "A function calls itself, directly or through others: WGSL has no recursion.",
        fix: "Write it as a loop.",
        example: "embed wgsl K {\n\
            \x20   fn f(x: i32) -> i32 { return f(x - 1); }\n\
            }\n\
            \n\
            main.vl:2:8: error[wgsl.recursion] 'f' calls itself, directly or through other functions\n\
            \x20 help: WGSL has no recursion: write it as a loop",
    },
    Explain {
        code: "wgsl.return",
        severity: "error",
        means: "A function with a result can reach its end without `return`, or a `return` \
            does not match the function.",
        fix: "End every path with `return VALUE;` (`return;` in a function without a result).",
        example: "embed wgsl K {\n\
            \x20   fn f(a: i32) -> i32 {\n\
            \x20       if a > 0 { return a; }\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:5: error[wgsl.return] function 'f' can reach its end without returning a value\n\
            \x20 help: end it with a 'return'",
    },
    Explain {
        code: "wgsl.entry",
        severity: "error",
        means: "An entry point's interface is wrong: a parameter or result without \
            `@location` or `@builtin`, a builtin of another stage or of the wrong type, an \
            integer location without `@interpolate(flat)`, a vertex shader without \
            `@builtin(position)`.",
        fix: "The builtins: position (`vec4<f32>`), vertex_index and instance_index (`u32`), \
            front_facing (`bool`), frag_depth (`f32`), global_invocation_id, \
            local_invocation_id, workgroup_id, num_workgroups (`vec3<u32>`), \
            local_invocation_index (`u32`).",
        example: "embed wgsl K {\n\
            \x20   @vertex\n\
            \x20   fn vs() -> @location(0) vec4<f32> {\n\
            \x20       return vec4<f32>(0.0);\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:3:8: error[wgsl.entry] a vertex shader returns '@builtin(position)' (a vec4<f32>)\n\
            \x20 help: for example: fn vs(...) -> @builtin(position) vec4<f32>",
    },
    Explain {
        code: "wgsl.stage",
        severity: "error",
        means: "An operation of another stage: `discard`, derivatives and implicit-level \
            sampling are for fragment shaders, barriers for compute shaders.",
        fix: "Use `textureSampleLevel` outside fragment shaders; move the barrier into a \
            compute shader.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       discard;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:9: error[wgsl.stage] 'discard' is only for fragment shaders",
    },
    Explain {
        code: "wgsl.switch",
        severity: "error",
        means: "A switch without exactly one `default`, or with a case value twice.",
        fix: "Add `default: {}`; merge the clauses: `case 1, 2: { ... }`.",
        example: "embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       switch 1 {\n\
            \x20           case 1: {}\n\
            \x20       }\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:9: error[wgsl.switch] a switch needs a 'default' clause\n\
            \x20 help: add 'default: {}'",
    },
    Explain {
        code: "wgsl.target",
        severity: "error (run time)",
        means: "The target's compiler (Metal) rejected the translation of WGSL the front end \
            accepted, at the WGSL function its first error is in: a translator bug (a name it \
            should have renamed, an MSL construct it should not write), never the shader's. \
            `volec check` does not translate, so only `shader_wgsl` at run time reports it.",
        fix: "Report it with the shader and Metal's message (after the line); meanwhile \
            rename or rewrite the function it names.",
        example: "let s = dev.shader_wgsl(K.src)?;\n\
            \n\
            12:1: error wgsl.target: Metal rejected the translation of fn blur: use of undeclared identifier 'k' (MSL 40:12)",
    },
    Explain {
        code: "gpu.align",
        severity: "error (run time)",
        means: "An offset, size or stride std::gpu needs aligned is not: buffer copies and \
            vertex buffers at multiples of 4, a texture copy's `bytes_per_row` at a multiple \
            of 256, an index buffer's offset at a multiple of the index size. The failing \
            `requires` names its rule.",
        fix: "Round the value up to the multiple the message names (pad a row to 256 bytes \
            and copy it row by row).",
        example: "enc.copy_buffer(&a, 2, &b, 0, 16);\n\
            \n\
            main.vl:30:9: gpu.align: copy offsets and sizes are multiples of 4",
    },
    Explain {
        code: "gpu.capture",
        severity: "error (run time)",
        means: "A frame could not be captured to a file (`capture`): a format it does not \
            capture, no memory for the frame, the frame's work failed on the GPU, or the file \
            could not be written. The program goes on; the file is not written.",
        fix: "Configure the surface with `Format::Bgra8Unorm`, or check the path the message \
            names.",
        example: "main.vl:41:5: gpu.capture: a frame of this format is not captured; frame.ppm is not written\n\
            \x20 help: configure the surface with Format::Bgra8Unorm",
    },
    Explain {
        code: "gpu.format",
        severity: "error (run time)",
        means: "A texture format that does not fit its use: a storage texture of a format \
            that is not storable, a color target of a depth format, a view of another texel \
            size, a surface format std::gpu does not present, a vertex attribute of another \
            format than the shader's input.",
        fix: "Use the format the message names (guide gpu, \"texture and storable formats\").",
        example: "let t = dev.texture(TextureDesc::new(64, 64, Format::Rgba8UnormSrgb, TextureUsage::STORAGE_BINDING));\n\
            \n\
            main.vl:12:13: gpu.format: STORAGE_BINDING needs a storable format",
    },
    Explain {
        code: "gpu.layout",
        severity: "error (run time)",
        means: "A bind group that does not fit its layout: made for another layout, a binding \
            the pipeline's entry points do not use, a resource of another kind than the \
            shader's at that binding; or a vertex input of the shader with no attribute. A \
            layout holds the bindings the pipeline's own entry points use, through their \
            calls.",
        fix: "Make the bind group from `pipe.bind_layout(i)`, with one entry for each binding \
            the message lists.",
        example: "let g = dev.bind_group(pipe.bind_layout(1), &entries);\n\
            \n\
            main.vl:20:13: gpu.layout: the bind group was made for another layout (make it from pipe.bind_layout(i))",
    },
    Explain {
        code: "gpu.limits",
        severity: "error (run time)",
        means: "A count or size past a limit: bind groups 0..3, 16 bindings a group, 8 color \
            attachments, a buffer larger than the device makes, a dispatch of more workgroups \
            in one dimension than the device takes, a `@workgroup_size` past the device's.",
        fix: "Stay within the limit the message names; ask for a larger `max_buffer_size` \
            when opening the device (`adapter.device(lim)`), or spread a dispatch over y and z.",
        example: "let l = pipe.bind_layout(4);\n\
            \n\
            main.vl:18:13: gpu.limits: bind groups 0..3: i = 4",
    },
    Explain {
        code: "gpu.pipeline",
        severity: "error (run time)",
        means: "A draw or dispatch without what its pipeline reads: no pipeline set, a bind \
            group or a vertex buffer the pipeline uses not set, `draw_indexed` without an \
            index buffer.",
        fix: "Set them on the pass first: `set_pipeline`, `set_bind_group`, \
            `set_vertex_buffer`, `set_index_buffer`.",
        example: "pass.dispatch(4, 1, 1);\n\
            \n\
            main.vl:33:9: gpu.pipeline: set a pipeline before drawing or dispatching",
    },
    Explain {
        code: "gpu.range",
        severity: "error (run time)",
        means: "A range outside its resource: a copy or a write past a buffer's or a \
            texture's end, a draw's vertices or instances, a negative count, attachments of \
            different sizes, a query index outside its set.",
        fix: "Keep offsets and sizes within the resource the message names.",
        example: "queue.write_buffer(&b, 60, &bytes);\n\
            \n\
            main.vl:25:5: gpu.range: write_buffer reaches past the buffer",
    },
    Explain {
        code: "gpu.state",
        severity: "error (run time)",
        means: "An operation on a resource in the wrong state: a mapped buffer bound or \
            copied into, a frame taken before the surface is configured, a render pass with \
