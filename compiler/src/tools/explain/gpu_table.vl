// The explanations of the shader compiler's codes, `wgsl.*` (std::gpu::wgsl:
// `volec check` reports them in an `embed wgsl` block, `shader_wgsl` returns
// them at run time), and of std::gpu's, `gpu.*` (0.26.0): the names in the
// `else "gpu.X: .."` texts of std::gpu's `requires` clauses and in its other
// failures. tests/refactor/run.sh (self_explain) collects them from std's text.

use crate::tools::explain::Explain;

pub const GPU_COUNT: i64 = 37;

pub static GPU_TABLE: [Explain<'_>; 37] = [
    Explain {
        code: b"wgsl.syntax",
        severity: b"error",
        means: b"The text is not WGSL: a token where another is expected, a declaration WGSL \
            does not have at module scope, mixed operators that need parentheses (`a & b | c`, \
            `a < b < c`, `&&` with `||`).",
        fix: b"Write the construct the message names; parenthesize mixed operators.",
        example: b"embed wgsl K {\n\
            \x20   @compute @workgroup_size(1)\n\
            \x20   fn main() {\n\
            \x20       let x = 1 & 2 | 3;\n\
            \x20   }\n\
            }\n\
            \n\
            main.vl:4:23: error[wgsl.syntax] mixing bitwise operators with other operators needs parentheses",
    },
    Explain {
        code: b"wgsl.name",
        severity: b"error",
        means: b"A name that is neither declared in scope, at module scope, nor a WGSL builtin; \
            or a type name that is not a type.",
        fix: b"Declare it, or correct the spelling (WGSL is case-sensitive: `vec3f`, \
            `textureSample`).",
        example: b"embed wgsl K {\n\
            \x20   @fragment\n\
            \x20   fn fs() -> @location(0) vec4<f32> {\n\
