// The explanations of the codes of 0.26.2's text and syntax: `where` and
// argument-position `impl Trait` (front/parser/items/params.vl),
// visibility (`pub(crate)`, front/modules), format literals
// (front/check/format.vl); docs/grammar.md, "Items", "Modules",
// "Formatting".

use crate::tools::explain::Explain;

pub const TEXT_COUNT: i64 = 2;

pub static TEXT_TABLE: [Explain; 2] = [
    Explain {
        code: "where.unsupported", severity: "error",
        means: "(0.26.2) A `where` predicate whose left side is not a type parameter of the item: `where I::Item: Display`, `where Vec<T>: Debug`. In 0.26 `where` is another way to write a parameter's bounds, `fn f<T>(x: T) where T: Display` is `fn f<T: Display>(x: T)`; a bound on any other type comes with the rust edition. The predicate is left out.",
        fix: "Bound a parameter instead: for an iterator's items, a parameter for the item type, `I: Iterator<Item = X>, X: Display`.",
        example: "error[where.unsupported] 'I::Item: Display': a 'where' bound is on a type parameter of the item, and 'I::Item' is not one | help: a bound on a type that is not a parameter comes with the rust edition; bound a parameter instead: 'I: Iterator<Item = X>, X: Display'",
    },
    Explain {
        code: "type.impl-position", severity: "error",
        means: "(0.26.2) `impl Trait` outside a function's parameter: in a result (`-> impl Display`), a field, a `let`, a type alias. A parameter's `x: impl Display` is a hidden type parameter of the function, `fn f<T: Display>(x: T)`, that each call infers; a result's `impl Trait` (a type the function picks and hides) comes with the rust edition.",
        fix: "Name a type parameter, or write the type itself: `fn f() -> i64`; for a closure, a result of a named type (`Vec`, a struct) or a parameter the caller passes.",
        example: "error[type.impl-position] 'impl Display' is a parameter's type only, in this release | help: name a type parameter instead, 'fn f<T: Display>() -> T'; 'impl Trait' in a result, a field or a 'let' comes with the rust edition",
    },
];
