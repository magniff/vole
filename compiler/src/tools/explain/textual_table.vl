// The explanations of the codes of the text edits of a tree (0.21, for
// 0.24's rename): `rewrite --text` and `refactor extension`
// (tools/textual).

use crate::tools::explain::Explain;

pub const TEXTUAL_COUNT: i64 = 21;

pub static TEXTUAL_TABLE: [Explain<'_>; 21] = [
    Explain {
        code: b"extension.check", severity: b"error, exit 1 (note with --dry-run)",
        means: b"`refactor extension`: the programs renamed are compiled before and after the \
            rename (in target/extension-check); that directory could not be made. With \
            --dry-run, a note: how many programs would be compiled.",
        fix: b"Make target/ writable, or rename with --no-check and run the tests.",
        example: b"note extension.check: 1 program would be compiled before and after the rename, and compared",
    },
    Explain {
        code: b"extension.differs", severity: b"error, exit 1",
        means: b"`refactor extension`: a renamed program does not build as it did (its assembly, \
            what the compiler printed or its exit status differ, the renamed paths aside). \
            The rename is undone; both builds are kept in target/extension-check.",
        fix: b"Compare target/extension-check/before/N.s with after/N.s: something reads a file \
            by its name (a `mod` with both extensions, a path in the program). Fix it, then \
            rename again.",
        example: b"error extension.differs: 1 of 12 programs build differently after the rename \
            (tests/run/x.vl: assembly, line 40); the rename is undone, the outputs are in target/extension-check",
    },
    Explain {
        code: b"extension.excluded", severity: b"note",
        means: b"`refactor extension`: files the exclusions keep were not renamed, and mentions in \
            excluded files and lines were left.",
        fix: b"Nothing, when they are history (old releases, past notes); else narrow the exclusions.",
        example: b"note extension.excluded: 158 files kept their name (excluded); 40 mentions left in excluded files and lines",
    },
    Explain {
        code: b"extension.exists", severity: b"error, exit 1",
        means: b"`refactor extension`: a file's new name is taken (`x.vl` next to `x.vl`).",
        fix: b"Remove or rename the one that is in the way, then rename again.",
        example: b"error extension.exists: 'util.vl' exists already: 'util.vl' cannot take its name; nothing renamed",
    },
    Explain {
        code: b"extension.no-files", severity: b"error, exit 1 (note: nothing to rename)",
        means: b"`refactor extension`: no file git tracks under that directory has the old \
            extension; or (a note) every one is excluded.",
        fix: b"Name a directory with such files, a program's root, or --all.",
        example: b"error extension.no-files: no file of git's ends with .vl under 'nowhere'",
    },
    Explain {
        code: b"extension.no-git", severity: b"error, exit 2",
        means: b"`refactor extension` renames the files git tracks, and this is no git checkout.",
        fix: b"Run it in the checkout (or `git init` and add the files first).",
        example: b"error extension.no-git: refactor extension renames the files git tracks: this is no git checkout",
    },
    Explain {
        code: b"extension.no-program", severity: b"error, exit 1",
        means: b"`refactor extension ROOT`: the program of ROOT could not be read.",
        fix: b"`volec check ROOT` says why.",
        example: b"error extension.no-program: cannot read the program of 'main.vl'",
    },
    Explain {
        code: b"extension.strings", severity: b"note",
        means: b"`refactor extension` changes no string literal of a source: a path in a string is \
            what the program does (a compiler looking for `main.vl`), not a mention.",
        fix: b"Change them on purpose, checked: the `try:` line (`rewrite --text OLD NEW --word \
            --strings --check ROOT`).",
        example: b"note extension.strings: 3 mentions in string literals of 2 sources left: changing them changes what the program does\n\
            try: volec rewrite --text .vl .vl --word --strings --dry-run",
    },
    Explain {
        code: b"extension.unresolved", severity: b"note",
        means: b"`refactor extension ROOT|DIR`: mentions of paths with the old extension that name \
            no renamed file (a glob, a file that is not there), or the end of several files' \
            paths (`main.vl`), were left; the first is shown.",
        fix: b"Look at them (`git grep`); with --all every mention changes.",
        example: b"note extension.unresolved: 2 mentions name no file, 0 the end of several files' paths: left (run.sh: *.vl)",
    },
    Explain {
        code: b"extension.untracked", severity: b"note",
        means: b"`refactor extension ROOT`: some of the program's files are not git's: they were \
            renamed without git (`git add` them).",
        fix: b"`git add` the new files if they belong to the checkout.",
        example: b"note extension.untracked: 1 files of the program git does not track: renamed without it",
    },
    Explain {
        code: b"extension.usage", severity: b"error, exit 2",
        means: b"`refactor extension OLD NEW [ROOT|DIR|--all]`: the words or options are not right.",
        fix: b"Follow the `try:` line.",
        example: b"error extension.usage: OLD and NEW are two extensions\n\
            try: volec refactor extension .vl .vl --all --dry-run",
    },
    Explain {
        code: b"rewrite.breaks", severity: b"error, exit 1",
        means: b"`rewrite --text ... --check ROOT`: the program checks with new errors with the new \
            texts read in place of the files (listed above); nothing was written.",
        fix: b"Narrow the rewrite (--comments, --strings, --word, --exclude), or look at the diff \
            (the `try:` line).",
        example: b"main.vl: error[type error] unknown function 'shapes::nope'\n\
            error rewrite.breaks: 1 new error in the --check programs; nothing written\n\
            try: volec rewrite --text shapes::rect shapes::nope --check main.vl --dry-run --diff",
    },
    Explain {
        code: b"rewrite.check", severity: b"error, exit 1",
        means: b"`rewrite --text ... --check ROOT`: the check could not run; nothing was written.",
        fix: b"`volec check ROOT` says why (a root that does not exist).",
        example: b"error rewrite.check: --check could not run the check; nothing written",
    },
    Explain {
        code: b"rewrite.exclude", severity: b"error, exit 2",
        means: b"`--exclude SPEC` (or a line of --exclude-from's file) is malformed: a spec is \
            GLOB (a whole file), GLOB:/RE/ (its lines RE matches) or GLOB:/A/,/B/ (from a line \
            A matches to the line before the next one B matches).",
        fix: b"Close each /RE/ (`\\/` is a / in it); the RE is rewrite's (^ $ . * + ? [a-z] \\d \\w).",
        example: b"error rewrite.exclude: 'x:/[a/' is no exclusion: GLOB, GLOB:/RE/ (its lines) or GLOB:/A/,/B/ (from A to before B)",
    },
    Explain {
        code: b"rewrite.excluded", severity: b"note",
        means: b"`rewrite --text`: matches in files the exclusions keep whole were left.",
        fix: b"Nothing, when they are history; else narrow the exclusions.",
        example: b"note rewrite.excluded: 12 matches left in 3 excluded files",
    },
    Explain {
        code: b"rewrite.exists", severity: b"error, exit 1",
        means: b"`rewrite --text --move-paths`: a file's new path is taken; nothing was written.",
        fix: b"Move the file in the way first.",
        example: b"error rewrite.exists: 'vole-run.sh' exists already; nothing moved",
    },
    Explain {
        code: b"rewrite.git", severity: b"error, exit 1",
        means: b"`rewrite --text --move-paths`, `refactor extension`, `undo` of one: `git \
            update-index` could not move the index's entries; nothing was moved.",
        fix: b"`git status` says why (a lock left by another git: .git/index.lock).",
        example: b"error rewrite.git: git update-index could not move the index's entries; nothing moved",
    },
    Explain {
        code: b"rewrite.kept", severity: b"note",
        means: b"`rewrite --text`: matches were left in kept lines (an exclusion's /RE/ or range), \
            or in a source, in places other than --comments, --strings, --code asked.",
        fix: b"Nothing, when that was meant; `query grep --code OLD` lists a source's in code \
            (identifiers: `refactor rename`).",
        example: b"note rewrite.kept: 2 matches left in 1 file: in kept lines (the exclusions), or in other places than --comments, --strings, --code ask",
    },
    Explain {
        code: b"rewrite.mixed-case", severity: b"note",
        means: b"`rewrite --text --case`: some matches were neither all lower, all upper, nor \
            capitalized (`vole`): NEW was written as it is there.",
        fix: b"Look at them with --dry-run --diff.",
        example: b"note rewrite.mixed-case: 1 matches in a mixed case took NEW as it is",
    },
    Explain {
        code: b"rewrite.no-git", severity: b"error, exit 2",
        means: b"`rewrite --text` edits the files git tracks, and this is no git checkout.",
        fix: b"Run it in the checkout; for a program's code, `rewrite PATTERN REPLACEMENT`.",
        example: b"error rewrite.no-git: --text edits the files git tracks: this is no git checkout",
    },
    Explain {
        code: b"rewrite.not-lexed", severity: b"warning",
        means: b"`rewrite --text --comments|--strings|--code`: some vole sources with a match do \
            not lex (a test of the lexer's errors), so they were read by lines: a match on a \
            line that starts with `//` is in a comment, any other was left.",
        fix: b"Look at them; rewrite the rest without the place options, with --files naming them.",
        example: b"warning rewrite.not-lexed: 1 vole source with a match does not lex: read by lines, only the lines that start with `//` are comments (tests/run/err_quote.vl)",
    },
];
