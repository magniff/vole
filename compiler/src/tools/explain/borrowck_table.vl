// The explanations of the borrow checker's codes (0.27.1, places/borrowck,
// docs/design/borrowck.md section 14): the conflicts of an access with a
// loan in scope, a reference escaping its frame or its region, the
// moves and the match guard's rule; the signature's elision and variance
// errors, the static's rule and the deferred closure body's warning are
// edition_table.vl's (ir271's, 0.27.0's).

use crate::tools::explain::Explain;

pub const BORROWCK_COUNT: i64 = 18;

pub static BORROWCK_TABLE: [Explain<'_>; 18] = [
    Explain {
        code: b"borrowck.mut_twice",
        severity: b"error",
        means: b"A place is borrowed mutably (`&mut x`, a `&mut self` receiver, a `&mut` passed on) while \
            an earlier mutable borrow of it, or of a place overlapping it, is still in scope: its \
            reference is used later, or a value holding it is. Two exclusive references to one place \
            never coexist (borrowck.md D2.5, rustc E0499). A receiver's borrow is two-phase: \
            `v.push(v.len())` is fine, `v.push(v.pop().unwrap())` is not.",
        fix: b"Finish the first borrow's uses before the second; reborrow once (`let r = &mut x;`) and \
            pass `r` on; hoist an argument that changes the receiver into a `let`.",
        example: b"let a = &mut x;\n\
            let b = &mut x;\n\
            *a += 1;\n\
            \n\
            main.vl:2:13: error[borrowck.mut_twice] cannot borrow 'x' as mutable more than once at a time",
    },
    Explain {
        code: b"borrowck.conflict",
        severity: b"error",
        means: b"A place is borrowed mutably while a shared borrow of it is in scope, or borrowed shared \
            while a mutable borrow of it is (aliasing XOR mutation; borrowck.md D2.5, rustc E0502). \
            A two-phase receiver's activation counts as the mutable borrow: \
            `v.push(v.last().unwrap())` fails because the shared borrow `last` returned is still \
            live at the call.",
        fix: b"Use the shared borrow before the mutable one, or take it again after; copy a plain value \
            out first (`let n = v[0];`).",
        example: b"let r = &s;\n\
            s.add(1);\n\
            println(\"{}\", r.x);\n\
            \n\
            main.vl:2:5: error[borrowck.conflict] cannot borrow 's' as mutable because it is also borrowed as immutable",
    },
    Explain {
        code: b"borrowck.use_borrowed",
        severity: b"error",
        means: b"A place is read (copied, compared, printed, passed by value) while a mutable borrow of \
            it is in scope (borrowck.md D2.5, rustc E0503).",
        fix: b"Read it after the mutable borrow's last use, or read through the reference.",
        example: b"let r = &mut x;\n\
            let y = x;\n\
            *r = 2;\n\
            \n\
            main.vl:2:13: error[borrowck.use_borrowed] cannot use 'x' because it is mutably borrowed",
    },
    Explain {
        code: b"borrowck.assign_borrowed",
        severity: b"error",
        means: b"A place is assigned while a borrow of it (shared or mutable) is in scope (borrowck.md \
            D2.5, rustc E0506). A reference variable reassigned keeps its first loan only on a path \
            that may still read the first value (a conditional reassignment, a loop): there the \
            first borrowed place is still borrowed.",
        fix: b"Assign after the borrow's last use; for a reassigned reference, shadow it (`let r = \
            &b;`) instead.",
        example: b"let r = &x;\n\
            x = 5;\n\
            println(\"{}\", *r);\n\
            \n\
            main.vl:2:5: error[borrowck.assign_borrowed] cannot assign to 'x' because it is borrowed",
    },
    Explain {
        code: b"borrowck.move_borrowed",
        severity: b"error",
        means: b"A place is moved out of (into a call, a `let`, a struct, a return) while a borrow of it \
            is in scope (borrowck.md D2.5, rustc E0505).",
        fix: b"Move it after the borrow's last use, or pass a clone where it moves.",
        example: b"let r = &v;\n\
            take(v);\n\
            println(\"{}\", r.len());\n\
            \n\
            main.vl:2:10: error[borrowck.move_borrowed] cannot move out of 'v' because it is borrowed",
    },
    Explain {
        code: b"borrowck.dropped_borrowed",
        severity: b"error",
        means: b"A place is dropped, or its scope ends, while a borrow of it is in scope: the reference \
            would dangle (borrowck.md D2.5 and D9.2, rustc E0597, E0713, E0716 for a temporary). A \
            value whose type has `impl Drop` and holds a reference needs the referent alive at its \
            drop; the compiler-known containers (`Vec`, `String`, `HashMap`, ...) do not.",
        fix: b"Declare the borrowed value before the one holding the reference, so it is dropped after; \
            keep a temporary in a `let`.",
        example: b"let r;\n\
            {\n\
            let x = 1;\n\
            r = &x;\n\
            }\n\
            println(\"{}\", *r);\n\
            \n\
            main.vl:5:5: error[borrowck.dropped_borrowed] 'x' does not live long enough: its scope ends here while it is still borrowed",
    },
    Explain {
        code: b"borrowck.return_local",
        severity: b"error",
        means: b"A reference to a local of the function (a `let`, a temporary, a by-value parameter) \
            escapes it: it is returned, stored through a `&mut` parameter, or put into a value that \
            outlives the call (borrowck.md D6.2.2, rustc E0515).",
        fix: b"Return an owned value; or borrow from a parameter, so the reference lives as long as its \
            referent.",
        example: b"fn first(v: Vec<i64, Gpa>) -> &i64 {\n\
            &v[0]\n\
            }\n\
            \n\
            main.vl:2:1: error[borrowck.return_local] a reference to 'v', a local of this function, escapes it",
    },
    Explain {
        code: b"borrowck.outlives",
        severity: b"error",
        means: b"A reference with one signature region flows where another is required that it is not \
            declared to outlive: returning `y` where the result's region is `x`'s, storing a `&'b T` \
            into a `&'a mut` referent without `'b: 'a` (borrowck.md D6.2.1, rustc E0621, E0623, \
            \"lifetime may not live long enough\").",
        fix: b"Name the lifetime on both (`fn f<'a>(x: &'a T, y: &'a T) -> &'a T`), or add the bound \
            (`'b: 'a`); `fix --suggested` writes the names when the two regions are both elided \
            parameters.",
        example: b"fn pick(x: &i64, y: &i64) -> &i64 {\n\
            y\n\
            }\n\
            \n\
            main.vl:1:5: error[borrowck.outlives] 'y' must outlive the result, whose region is 'x''s",
    },
    Explain {
        code: b"borrowck.use_moved",
        severity: b"error",
        means: b"A place is used after a move of it, or of a part of it, on some path: in a later \
            statement, in a later iteration of a loop, or in a branch after a conditional move \
            (borrowck.md M1, M5, rustc E0382).",
        fix: b"Use it before the move; pass a clone where it moves; take it by reference.",
        example: b"let a = take(v);\n\
            let b = take(v);\n\
            \n\
            main.vl:2:14: error[borrowck.use_moved] 'v' is used here after it moved",
    },
    Explain {
        code: b"borrowck.assign_moved_part",
        severity: b"error",
        means: b"A field of a place is assigned while the place is not initialized on some path (`let p: \
            P; p.a = 1;`): a partial initialization (borrowck.md M2, rustc E0381). Assigning a field \
            after the whole was moved is borrowck.use_moved.",
        fix: b"Initialize the whole value first (`let p = P { .. };`), then its fields.",
        example: b"let p: P;\n\
            p.a = 1;\n\
            \n\
            main.vl:2:5: error[borrowck.assign_moved_part] 'p' is partially assigned: it is not initialized",
    },
    Explain {
        code: b"borrowck.assign_twice",
        severity: b"error",
        means: b"A local declared without `mut` and initialized later (`let x;`, `let x: T;`) is assigned \
            on a path where it may be assigned already: a second assignment in sequence, or one \
            inside a loop (borrowck.md M7, rustc E0384). One assignment on each branch of an `if` or \
            `match` is fine.",
        fix: b"Declare it `let mut x;`, or assign it once on each path.",
        example: b"let x: i64;\n\
            x = 1;\n\
            x = 2;\n\
            \n\
            main.vl:3:5: error[borrowck.assign_twice] cannot assign twice to x, which is not `mut`: it may be assigned already on this path",
    },
    Explain {
        code: b"borrowck.move_out",
        severity: b"error",
        means: b"A value is moved out of a place that cannot give it up: through a reference (`*r`), an \
            element of an array, slice or `Vec` (`v[i]`), a static, a borrowed copy (borrowck.md M3, \
            rustc E0507, E0508). A `Box`'s content cannot be moved out in 0.27.1 either.",
        fix: b"Clone it, borrow it (`&v[i]`), or take it out with \
            `mem::take`/`Option::take`/`swap_remove`.",
        example: b"let s = v[0];\n\
            \n\
            main.vl:1:13: error[borrowck.move_out] cannot move out of 'v[0]', an element of a Vec",
    },
    Explain {
        code: b"borrowck.move_from_drop",
        severity: b"error",
        means: b"A field is moved out of a value whose type has `impl Drop`: the drop would see a hole \
            (borrowck.md M4, rustc E0509).",
        fix: b"Take the field's value out with `mem::take` or `Option::take`, or clone it.",
        example: b"let name = guard.name;\n\
            \n\
            main.vl:1:16: error[borrowck.move_from_drop] cannot move 'guard.name' out of a value with `impl Drop`",
    },
    Explain {
        code: b"borrowck.guard_write",
        severity: b"error",
        means: b"A match guard writes to, or moves out of, the scrutinee or a place a pattern tests, or \
            writes through a `ref mut` binding: the match has tested it and must still trust the \
            test (borrowck.md D2.6, rustc E0510, E0594).",
        fix: b"Write in the arm's body, after the match has decided; read only in the guard.",
        example: b"match x {\n\
            Some(y) if { x = None; true } => y,\n\
            _ => 0,\n\
            }\n\
            \n\
            main.vl:2:18: error[borrowck.guard_write] cannot write to 'x' in a match guard: the match tests it",
    },
    Explain {
        code: b"borrowck.assign_immutable",
        severity: b"error",
        means: b"An assignment writes to a place reached through a shared reference (`&T`), or to a part \
            of a local not declared `mut`: the place is not mutable (borrowck.md D2.7, rustc E0594). \
            Only a path through `&mut`, a raw pointer or a `mut` binding may be written.",
        fix: b"Take the parameter as `&mut T` (and pass `&mut x`), or declare the local `let mut`; for \
            a field that must change behind `&`, use a `Cell`.",
        example: b"fn f(s: &S) {\n\
            s.n = 2;\n\
            }\n\
            \n\
            main.vl:2:5: error[borrowck.assign_immutable] cannot assign to 's.n', which is behind a `&` reference",
    },
    Explain {
        code: b"borrowck.borrow_immutable",
        severity: b"error",
        means: b"A `&mut` borrow, or a `&mut self` method's receiver, takes a place reached through a \
            shared reference (`&T`), or a local not declared `mut`: an exclusive reference cannot \
            come from a shared one (borrowck.md D2.7, rustc E0596).",
        fix: b"Take the parameter as `&mut T` (and pass `&mut x`), or declare the local `let mut`; call \
            a `&self` method instead if one does the job.",
        example: b"fn h(s: &S) {\n\
            s.bump();\n\
            }\n\
            \n\
            main.vl:2:5: error[borrowck.borrow_immutable] cannot borrow 's' as mutable, which is behind a `&` reference",
    },
    Explain {
        code: b"closure.kind",
        severity: b"error",
        means: b"A closure that moves a captured value out of its environment is `FnOnce`: it can be \
            called once. Given where an `Fn` or `FnMut` bound is asked, which calls it again, it \
            does not fit (borrowck.md D19.6, rustc E0525). A closure checked against the bound \
            directly takes the bound's kind instead, and the move is `borrowck.move_out`.",
        fix: b"Make the bound `FnOnce` when the callee calls it once; or move a clone into the closure \
            (`let c = v.clone(); move || use_it(c)`); or borrow the value instead of moving it.",
        example: b"fn call<F: Fn() -> i64>(f: F) -> i64 { f() }\n\
            let f = || eat(s);\n\
            call(f)\n\
            \n\
            main.vl:2:13: error[closure.kind] this closure moves 's' out of its environment, so it is `FnOnce`, not `Fn` as its bound asks",
    },
    Explain {
        code: b"closure.sig",
        severity: b"error",
        means: b"A closure given where a bound `Fn(A..) -> R` is expected takes the bound's parameter \
            types; a parameter written with another type does not fit the bound (borrowck.md D20.3, \
            rustc E0631). A `&T` written for the bound's `&T` is the same type: its lifetime is the \
            bound's, the call's.",
        fix: b"Write the bound's type for the parameter (`|p: &i64|`), or leave the type out and let \
            the bound give it (`|p|`).",
        example: b"fn call<F: Fn(&i64) -> i64>(f: F) -> i64 { let v = 1; f(&v) }\n\
            call(|p: i64| p)\n\
            \n\
            main.vl:1:10: error[closure.sig] type mismatch in closure arguments: this parameter is written 'i64', but the bound of 'F' gives it 'let i64' (rustc E0631)",
    },
];
