// The explanations of the borrow checker's codes (0.27.1, places/borrowck,
// docs/design/borrowck.md section 14): the conflicts of an access with a
// loan in scope, a reference escaping its frame or its region, the
// signature's elision and variance errors (ir271's, at the front), the
// moves (M3), the match guard's and the static's rules, and the warning
// of a closure body the checker defers.

use crate::tools::explain::Explain;

pub const BORROWCK_COUNT: i64 = 17;

pub static BORROWCK_TABLE: [Explain; 17] = [
    Explain {
        code: "borrowck.mut_twice",
        severity: "error",
        means: "A place is borrowed mutably (`&mut x`, a `&mut self` receiver, a `&mut` passed \
            on) while an earlier mutable borrow of it, or of a place overlapping it, is still \
            in scope: its reference is used later, or a value holding it is. Two exclusive \
            references to one place never coexist (borrowck.md D2.5, rustc E0499). A receiver's \
            borrow is two-phase: `v.push(v.len())` is fine, `v.push(v.pop().unwrap())` is not.",
        fix: "Finish the first borrow's uses before the second; reborrow once (`let r = &mut \
            x;`) and pass `r` on; hoist an argument that changes the receiver into a `let`.",
        example: "// EDITION: rust\n\
            let a = &mut x;\n\
            let b = &mut x;\n\
            *a += 1;\n\
            \n\
            main.vl:3:13: error[borrowck.mut_twice] cannot borrow 'x' as mutable more than once at a time",
    },
    Explain {
        code: "borrowck.conflict",
        severity: "error",
        means: "A place is borrowed mutably while a shared borrow of it is in scope, or borrowed \
            shared while a mutable borrow of it is (aliasing XOR mutation; borrowck.md D2.5, \
            rustc E0502). A two-phase receiver's activation counts as the mutable borrow: \
            `v.push(v.last().unwrap())` fails because the shared borrow `last` returned is \
            still live at the call.",
        fix: "Use the shared borrow before the mutable one, or take it again after; copy a \
            plain value out first (`let n = v[0];`).",
        example: "// EDITION: rust\n\
            let r = &s;\n\
            s.add(1);\n\
            println(\"{}\", r.x);\n\
            \n\
            main.vl:3:5: error[borrowck.conflict] cannot borrow 's' as mutable because it is also borrowed as immutable",
    },
    Explain {
        code: "borrowck.use_borrowed",
        severity: "error",
        means: "A place is read (copied, compared, printed, passed by value) while a mutable \
            borrow of it is in scope (borrowck.md D2.5, rustc E0503).",
        fix: "Read it after the mutable borrow's last use, or read through the reference.",
        example: "// EDITION: rust\n\
            let r = &mut x;\n\
            let y = x;\n\
            *r = 2;\n\
            \n\
            main.vl:3:13: error[borrowck.use_borrowed] cannot use 'x' because it is mutably borrowed",
    },
    Explain {
        code: "borrowck.assign_borrowed",
        severity: "error",
        means: "A place is assigned while a borrow of it (shared or mutable) is in scope \
            (borrowck.md D2.5, rustc E0506). A reference variable reassigned keeps its first \
            loan only on a path that may still read the first value (a conditional \
            reassignment, a loop): there the first borrowed place is still borrowed.",
        fix: "Assign after the borrow's last use; for a reassigned reference, shadow it (`let r = \
            &b;`) instead.",
        example: "// EDITION: rust\n\
            let r = &x;\n\
            x = 5;\n\
            println(\"{}\", *r);\n\
            \n\
            main.vl:3:5: error[borrowck.assign_borrowed] cannot assign to 'x' because it is borrowed",
    },
    Explain {
        code: "borrowck.move_borrowed",
        severity: "error",
        means: "A place is moved out of (into a call, a `let`, a struct, a return) while a \
            borrow of it is in scope (borrowck.md D2.5, rustc E0505).",
        fix: "Move it after the borrow's last use, or pass a clone where it moves.",
        example: "// EDITION: rust\n\
            let r = &v;\n\
            take(v);\n\
            println(\"{}\", r.len());\n\
            \n\
            main.vl:3:10: error[borrowck.move_borrowed] cannot move out of 'v' because it is borrowed",
    },
    Explain {
        code: "borrowck.dropped_borrowed",
        severity: "error",
        means: "A place is dropped, or its scope ends, while a borrow of it is in scope: the \
            reference would dangle (borrowck.md D2.5 and D9.2, rustc E0597, E0713, E0716 for \
            a temporary). A value whose type has `impl Drop` and holds a reference needs the \
            referent alive at its drop; the compiler-known containers (`Vec`, `String`, \
            `HashMap`, ...) do not.",
        fix: "Declare the borrowed value before the one holding the reference, so it is dropped \
            after; keep a temporary in a `let`.",
        example: "// EDITION: rust\n\
            let r;\n\
            {\n\
                let x = 1;\n\
                r = &x;\n\
            }\n\
            println(\"{}\", *r);\n\
            \n\
            main.vl:6:5: error[borrowck.dropped_borrowed] 'x' does not live long enough: its scope ends here while it is still borrowed",
    },
    Explain {
        code: "borrowck.return_local",
        severity: "error",
        means: "A reference to a local of the function (a `let`, a temporary, a by-value \
            parameter) escapes it: it is returned, stored through a `&mut` parameter, or put \
            into a value that outlives the call (borrowck.md D6.2.2, rustc E0515).",
        fix: "Return an owned value; or borrow from a parameter, so the reference lives as long \
            as its referent.",
        example: "// EDITION: rust\n\
            fn first(v: Vec<i64, Gpa>) -> &i64 {\n\
                &v[0]\n\
            }\n\
            \n\
            main.vl:3:1: error[borrowck.return_local] a reference to 'v', a local of this function, escapes it",
    },
    Explain {
        code: "borrowck.outlives",
        severity: "error",
        means: "A reference with one signature region flows where another is required that it \
            is not declared to outlive: returning `y` where the result's region is `x`'s, \
            storing a `&'b T` into a `&'a mut` referent without `'b: 'a` (borrowck.md \
            D6.2.1, rustc E0621, E0623, \"lifetime may not live long enough\").",
        fix: "Name the lifetime on both (`fn f<'a>(x: &'a T, y: &'a T) -> &'a T`), or add the \
            bound (`'b: 'a`); `fix --suggested` writes the names when the two regions are \
            both elided parameters.",
        example: "// EDITION: rust\n\
            fn pick(x: &i64, y: &i64) -> &i64 {\n\
                y\n\
            }\n\
            \n\
            main.vl:2:5: error[borrowck.outlives] 'y' must outlive the result, whose region is 'x''s",
    },
    Explain {
        code: "borrowck.elision",
        severity: "error",
        means: "A reference in a return type has no region to take: the parameters hold none, \
            or several and none is `self` (borrowck.md D4.2, rustc E0106).",
        fix: "Name it: `fn f<'a>(x: &'a T, y: &T) -> &'a T`; `fix --suggested` names the only \
            reference parameter when there is one.",
        example: "// EDITION: rust\n\
            fn pick(x: &i64, y: &i64) -> &i64\n\
            \n\
            main.vl:2:30: error[borrowck.elision] the result's reference needs a named lifetime: 'x' and 'y' both carry one",
    },
    Explain {
        code: "borrowck.unused_param",
        severity: "error",
        means: "A struct's or enum's lifetime or type parameter is used by no field, so its \
            variance is undetermined (borrowck.md D5.3, rustc E0392).",
        fix: "Use it in a field, or hold it in a `PhantomData<&'a ()>` / `PhantomData<T>` \
            field; `fix --suggested` adds the field.",
        example: "// EDITION: rust\n\
            struct Tag<'a> { id: i64 }\n\
            \n\
            main.vl:2:12: error[borrowck.unused_param] lifetime 'a is never used",
    },
    Explain {
        code: "borrowck.use_moved",
        severity: "error",
        means: "A place is used after a move of it, or of a part of it, on some path: in a \
            later statement, in a later iteration of a loop, or in a branch after a conditional \
            move (borrowck.md M1, M5, rustc E0382).",
        fix: "Use it before the move; pass a clone where it moves; take it by reference.",
        example: "// EDITION: rust\n\
            let a = take(v);\n\
            let b = take(v);\n\
            \n\
            main.vl:3:14: error[borrowck.use_moved] 'v' is used here after it moved",
    },
    Explain {
        code: "borrowck.assign_moved_part",
        severity: "error",
        means: "A field of a place is assigned while the place is not initialized on some path \
            (`let p: P; p.a = 1;`): a partial initialization (borrowck.md M2, rustc E0381). \
            Assigning a field after the whole was moved is borrowck.use_moved.",
        fix: "Initialize the whole value first (`let p = P { .. };`), then its fields.",
        example: "// EDITION: rust\n\
            let p: P;\n\
            p.a = 1;\n\
            \n\
            main.vl:3:5: error[borrowck.assign_moved_part] 'p' is partially assigned: it is not initialized",
    },
    Explain {
        code: "borrowck.move_out",
        severity: "error",
        means: "A value is moved out of a place that cannot give it up: through a reference \
            (`*r`), an element of an array, slice or `Vec` (`v[i]`), a static, a borrowed copy \
            (borrowck.md M3, rustc E0507, E0508). A `Box`'s content cannot be moved out in \
            0.27.1 either.",
        fix: "Clone it, borrow it (`&v[i]`), or take it out with `mem::take`/`Option::take`/`swap_remove`.",
        example: "// EDITION: rust\n\
            let s = v[0];\n\
            \n\
            main.vl:2:13: error[borrowck.move_out] cannot move out of 'v[0]', an element of a Vec",
    },
    Explain {
        code: "borrowck.move_from_drop",
        severity: "error",
        means: "A field is moved out of a value whose type has `impl Drop`: the drop would see \
            a hole (borrowck.md M4, rustc E0509).",
        fix: "Take the field's value out with `mem::take` or `Option::take`, or clone it.",
        example: "// EDITION: rust\n\
            let name = guard.name;\n\
            \n\
            main.vl:2:16: error[borrowck.move_from_drop] cannot move 'guard.name' out of a value with `impl Drop`",
    },
    Explain {
        code: "borrowck.guard_write",
        severity: "error",
        means: "A match guard writes to, or moves out of, the scrutinee or a place a pattern \
            tests, or writes through a `ref mut` binding: the match has tested it and must \
            still trust the test (borrowck.md D2.6, rustc E0510, E0594).",
        fix: "Write in the arm's body, after the match has decided; read only in the guard.",
        example: "// EDITION: rust\n\
            match x {\n\
                Some(y) if { x = None; true } => y,\n\
                _ => 0,\n\
            }\n\
            \n\
            main.vl:3:18: error[borrowck.guard_write] cannot write to 'x' in a match guard: the match tests it",
    },
    Explain {
        code: "borrowck.static_mut_ref",
        severity: "error",
        means: "A reference (`&S`, `&mut S`) to a `static mut`: Rust 2024's rule, no references \
            to a mutable static, inside or outside `unsafe` (borrowck.md D6.2.5, rustc's \
            static_mut_refs lint).",
        fix: "Take its address instead (`&raw mut S`, `&raw const S`) and use it in `unsafe`; or \
            make the static immutable.",
        example: "// EDITION: rust\n\
            let r = &mut COUNT;\n\
            \n\
            main.vl:2:13: error[borrowck.static_mut_ref] no reference to a `static mut`: take `&raw mut COUNT`",
    },
    Explain {
        code: "borrowck.unchecked",
        severity: "warning",
        means: "A closure body reaches its captured variables through a raw environment in \
            0.27.1, so the borrows inside it are checked only against each other and its own \
            locals; the enclosing body keeps the captures borrowed for the closure's lifetime, \
            which keeps the program sound (borrowck.md D10.4). 0.27.2 checks closure bodies in \
            full.",
        fix: "Nothing to change: the warning counts the bodies the checker defers; \
            `--allow=borrowck.unchecked` hides it.",
        example: "// EDITION: rust\n\
            let mut bump = || c += 10;\n\
            \n\
            main.vl:2:20: warning[borrowck.unchecked] the borrows inside this closure, which captures 'c', are checked in 0.27.2",
    },
];
