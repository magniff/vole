// The `explain` entries of 0.18's codes (docs/design/contracts-verification.md
// §2.14) that phase 0 prints (tools/v018.vl) or names with a prefix
// tests/refactor/run.sh looks for (`test.`, `contract.`, `distinct.`, in
// front/contracts/diag.vl).
// Each task adds the entries of the other codes as it starts reporting
// them: run.sh wants every entry to be a code of the source.

use crate::tools::explain::Explain;

pub const V018_COUNT: i64 = 19;

pub static V018_TABLE: [Explain<'_>; 19] = [
    Explain {
        code: b"attr.obsolete", severity: b"warning",
        means: b"(0.26.0) `#[sealed]` before a struct: from 0.26 every struct's fields not marked `pub` are private to its module (and the modules inside it), and its literals need every field visible, which is what `#[sealed]` asked for. The attribute is accepted and changes nothing.",
        fix: b"Delete it: `volec fix --only obsolete-attr` deletes every one.",
        example: b"warning[attr.obsolete] '#[sealed]' is the default from 0.26: every field not marked 'pub' is private to its module",
    },
    Explain {
        code: b"contract.effect", severity: b"error",
        means: b"(0.18) A `requires`, `ensures` or `invariant` condition does io, allocates or touches a static: a check that passes must not change what the program does, and `debug` clauses are switched on and off.",
        fix: b"Compute the value in the body (or check it there with `assert`); the condition reads parameters, `result`, `old(..)` and calls pure functions. The try: line shows why the call has the effect.",
        example: b"error[contract.effect] the 'requires' of 'push' calls 'log', which does io: a condition may not do io, allocate or touch statics",
    },
    Explain {
        code: b"contract.impl-requires", severity: b"error",
        means: b"(0.18) An impl's method adds a `requires` to a trait's method: callers through the trait would not check it.",
        fix: b"Move the requires to the trait's method, or make it an `assert` in the body.",
        example: b"error[contract.impl-requires] 'Shape::area' of 'impl Shape for Circle' adds a requires",
    },
    Explain {
        code: b"contract.message", severity: b"error",
        means: b"(0.25.4) A hole of a `requires` or `ensures` message (`else \"bad {x}\"`, a format string since 0.26.2) is not an integer, or there are more than three: a failed check prints its message with no allocator, the holes as integers.",
        fix: b"Show a float or text as an operand of the condition (`requires x > 0.0` prints x when it fails), or write it in the message's own words; at most three holes.",
        example: b"error[contract.message] a contract message's hole is an integer, and this is 'str'",
    },
    Explain {
        code: b"contract.old",
        severity: b"error",
        means: b"(0.18) An `ensures` runs after the body, so `old(e)`, e evaluated at entry, takes a Copy \
            value that holds no reference and no raw pointer (C5): `old(x)` of a `&mut T`, `old(&n)` \
            and `old(v.as_slice())` are refused (they would see what the body changes), and a \
            parameter taken by value that is not Copy is gone by then (the body took it).",
        fix: b"Take a plain part at entry (`old(v.len())`), what the reference points to (`old(*x)`), \
            or a copy (`old(v.clone())`).",
        example: b"fn bump(x: &mut i64)\n\
            \x20   ensures *x == old(x) + 1\n\
            {\n\
            \x20   *x += 1;\n\
            }\n\
            \n\
            fn main() {\n\
            \x20   let mut n = 1;\n\
            \x20   bump(&mut n);\n\
            }\n\
            \n\
            main.vl:2:19: error[contract.old] 'old(x)' is not a plain value: the ensures of 'bump' reads it after the body, so `old(..)` takes a Copy value with no reference or raw pointer in it\n\
            \x20 help: take what it refers to at entry, `old(*x)`, or a part of it, `old(v.len())`",
    },
    Explain {
        code: b"contract.result", severity: b"error",
        means: b"(0.18) `result`, the returned value, is used in a `requires` (the function has not returned yet) or in an `ensures` of a function that returns nothing.",
        fix: b"State the requires on the parameters, or move the condition to an `ensures` of a function that returns a value.",
        example: b"error[contract.result] 'result' is the returned value, which a 'requires' does not see",
    },
    Explain {
        code: b"contract.sealed", severity: b"error",
        means: b"(0.18) A field of a type with an `invariant` is written, or a literal of it made, outside its module: only the module's functions keep the invariant.",
        fix: b"Call the type's methods (`volec query items MODULE`).",
        example: b"error[contract.sealed] 's.max = 3' writes a field of 'Stack', which has an invariant",
    },
    Explain {
        code: b"contract.violated", severity: b"error",
        means: b"(0.18) A `requires` is false for the constant arguments of a call (or a literal is outside a distinct type's invariant): the program would fail there every time.",
        fix: b"Change the argument, or the clause.",
        example: b"error[contract.violated] 'get(-1)' violates 'requires 0 <= i' of 'get' (stack.vl:4:14)",
    },
    Explain {
        code: b"distinct.kind",
        severity: b"error",
        means: b"(0.18) `type X = distinct T` makes a new type with T's representation, copied freely as \
            T is; T must be plain: numbers, bool, raw pointers, fn types, and structs, enums, tuples \
            and arrays of them. An owned type (Vec, String, HashMap, or one holding them), a \
            reference or a slice is refused.",
        fix: b"Declare a struct of one field instead, `struct Ids<A: Allocator> { v: Vec<i64, A> }`, \
            with the methods it needs.",
        example: b"type Ids = distinct Vec<i64, Gpa>;\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:1:21: error[distinct.kind] a distinct type is over a plain type: 'Vec<i64, Gpa>' owns memory\n\
            \x20 help: a distinct value is copied freely; for an owned or view type declare a struct of one field instead: 'struct Ids { v: Vec<i64, Gpa> }'",
    },
    Explain {
        code: b"distinct.method",
        severity: b"error",
        means: b"(0.18) A distinct type has none of its underlying type's methods (Go's defined types): \
            only those of its own `impl X { .. }`, and the underlying type's comparisons, Hash, \
            Debug, Display and Clone.",
        fix: b"Convert to call the underlying type's method, `(x as T).m(..)` (the conversion is free; \
            `volec fix --suggested` writes it), or add the method to `impl X`.",
        example: b"#[derive(Clone, Copy)]\n\
            struct Rect { w: i64, h: i64 }\n\
            \n\
            impl Rect {\n\
            \x20   fn area(self) -> i64 { self.w * self.h }\n\
            }\n\
            \n\
            type Tile = distinct Rect;\n\
            \n\
            fn main() {\n\
            \x20   let t = Rect { w: 2, h: 3 } as Tile;\n\
            \x20   println(\"{}\", t.area());\n\
            }\n\
            \n\
            main.vl:12:19: error[distinct.method] 'area' is a method of 'Rect', not of 'Tile'\n\
            \x20 help: a distinct type has only the methods its own impl gives it: convert to call the underlying type's\n\
            \x20 try: (t as Rect).area(..)\n\
            \x20 try: volec fix --suggested main.vl",
    },
    Explain {
        code: b"distinct.mix", severity: b"error",
        means: b"(0.18) A distinct type and its underlying type (or another distinct type) do not mix: an operator takes two values of the same distinct type, or one and a literal, and a value of one where the other goes needs `as`. Literals are the one implicit conversion.",
        fix: b"Convert with `as`, which is free: `d + x as Meters`, `id as i64`, `n as NodeId` (`volec fix --suggested` makes every such conversion).",
        example: b"error[distinct.mix] 'd + x' mixes 'Meters' and 'f64' | try: d + x as Meters",
    },
    Explain {
        code: b"fuzz.unknown", severity: b"error, exit 2",
        means: b"(0.18) `volec fuzz NAME`: the program has no #[fuzz] or #[property] function NAME. The message lists the ones it has.",
        fix: b"Run the try: line (the first target), or name one of the list.",
        example: b"error fuzz.unknown: no #[fuzz] or #[property] function 'nope' in main.vl; its targets: parse_never_crashes | try: volec fuzz parse_never_crashes main.vl",
    },
    Explain {
        code: b"field.literal-private", severity: b"error",
        means: b"(0.26.0) A struct literal outside the struct's module (and the modules inside it) names a field not marked `pub` (Rust's E0451): a struct with a private field is made by its module's functions, which keep what its fields mean. A struct with no fields has its literal anywhere.",
        fix: b"Call a function of the struct's module that returns one (the help names its constructors: `Rect::new`); or, in your own program, mark the fields `pub` (`volec fix --only pub`).",
        example: b"error[field.literal-private] cannot make a 'Rect' here: its field 'w' is private to module 'geometry' | help: make one with its constructor: 'Rect::new'",
    },
    Explain {
        code: b"field.private", severity: b"error",
        means: b"(0.26.0) A field not marked `pub` is read, written or borrowed outside the module that declares its struct (and the modules inside it), Rust's E0616. A field marked `pub` is visible wherever its struct is; until 0.26 every field was.",
        fix: b"Call the struct's method when it has one of that name (`.len()`; the try: line writes the `()`); in your own program, mark the field `pub` where it is declared (`volec fix --only pub`). Std's fields change only through its methods. (0.26.2: a field marked `pub(crate)`, `pub(super)` or `pub(in path)` is visible up to that module; the message says where, and `fix --only pub` widens it to `pub(crate)`.)",
        example: b"error[field.private] field 'w' of 'Rect' is private to module 'geometry' | help: make it public: 'pub w: i64' at geometry.vl:1:19",
    },
    Explain {
        code: b"fuzz.usage", severity: b"error, exit 2",
        means: b"(0.18) `volec fuzz` was given an unknown option, no target, or a bad --time.",
        fix: b"volec fuzz NAME [ROOT.vl] [--time S]: NAME a #[fuzz] function, S seconds (10 by default).",
        example: b"error fuzz.usage: the #[fuzz] function to fuzz is needed; usage: volec fuzz NAME [ROOT.vl] [--time S]",
    },
    Explain {
        code: b"import.wildcard", severity: b"error",
        means: b"(0.18) `use super::*;`, Rust's habit in a test module: wildcard imports are not allowed, and a `#[cfg(test)]` module sees its parent's items (private ones too) without an import.",
        fix: b"Delete the line (the try: line does): the names resolve through the parent.",
        example: b"error[import.wildcard] wildcard imports are not allowed: 'use super::*;' is not needed | help: a #[cfg(test)] module sees its parent's items, private ones too, without an import | try: volec edit patch main.vl:10 --old 'use super::*;' --new '' main.vl",
    },
    Explain {
        code: b"test.generate",
        severity: b"error",
        means: b"(0.18) A `#[property]` parameter has a type with no generator (a raw pointer, a fn \
            value).",
        fix: b"Take a value of a type that has one, or write `impl Arbitrary for T` (`use \
            std::test::Arbitrary;`).",
        example: b"#[property]\n\
            fn reads(p: *const u8) -> bool { p.is_null() }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:2:10: error[test.generate] no generator for '*const u8' (a pointer), parameter 'p' of 'reads'\n\
            \x20 help: parameters are generated from their types: numbers, bool, text, Vec, Option, Result, tuples, the program's structs and enums, a type with an `impl std::Arbitrary`",
    },
    Explain {
        code: b"test.not-yet", severity: b"error, exit 2",
        means: b"(0.18) An option of `volec test` that is named but not implemented yet: --fuzz S (fuzz each target S seconds) and --gen (inputs from a generator, with --against).",
        fix: b"Leave the option out: `volec fuzz NAME --time S` fuzzes one target.",
        example: b"error test.not-yet: '--fuzz' is not implemented yet",
    },
    Explain {
        code: b"test.signature",
        severity: b"error",
        means: b"(0.18) A `#[test]` function takes nothing or `gpa: Gpa`, and returns `()` or a Result.",
        fix: b"For generated arguments make it a `#[property]`.",
        example: b"#[test]\n\
            fn parses(s: &str) {\n\
            \x20   assert(s.len() > 0, \"empty\");\n\
            }\n\
            \n\
            fn main() {}\n\
            \n\
            main.vl:2:4: error[test.signature] 'parses' is a #[test] with parameters: a #[test] takes nothing or `gpa: Gpa`\n\
            \x20 help: a function of generated arguments is a #[property]",
    },
];
