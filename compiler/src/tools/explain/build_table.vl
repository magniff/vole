// The explanations of a build's own codes (0.25.3): a program without
// fn main, a link that failed (back/objfile/linkfail.vl), a first word
// that reads as a command (cli/hint.vl).

use crate::tools::explain::Explain;

pub const BUILD_COUNT: i64 = 10;

pub static BUILD_TABLE: [Explain; 10] = [
    Explain {
        code: "main.missing", severity: "error, exit 1",
        means: "A build of an executable (`-o prog`) whose program has no `fn main`: before 0.25.3 \
            the linker said so in its own words (`Undefined symbols: \"_main\"`). With an object, \
            archive, library or C file on the command line, the link says it, when none of them \
            defines main either.",
        fix: "Add `fn main() -> i32 { 0 }` (or `fn main(gpa: Gpa) -> i32`) to the root file, or \
            build an object with `-c -o NAME.o` when the file is a library.",
        example: "nomain.vl:1:1: error[main.missing] 'nomain.vl' has no fn main | help: a program \
            starts at its fn main, and this one has none; an object (-c) needs none | try: printf \
            '\\nfn main() -> i32 {\\n    0\\n}\\n' >> nomain.vl | try: volec -c -o nomain.o \
            nomain.vl",
    },
    Explain {
        code: "link.undefined", severity: "error, exit 1",
        means: "The link found no definition of a symbol the program (or a C file or object of \
            the command line) uses: a C function or static declared in an extern block whose \
            library is not linked, or misspelled. At the declaration when the program has one; \
            several are named on the line.",
        fix: "Name the library that defines it: `#[link(lib = \"NAME\")]` on the extern block, or \
            `-l NAME` (and `-L DIR`) on the command line; check the symbol's spelling. `--verbose` \
            prints the linker's text.",
        example: "undef.vl:1:14: error[link.undefined] undefined symbol 'nosuchfn' | help: \
            'nosuchfn' is declared in an extern block, and nothing the link is given defines it: \
            name its library, #[link(lib = \"NAME\")] on the block or -l NAME on the command line \
            (--verbose: the linker's text)",
    },
    Explain {
        code: "link.no-library", severity: "error, exit 1",
        means: "A library named by `-l NAME` or by an extern block's `#[link(lib = \"NAME\")]` is \
            in none of the linker's directories.",
        fix: "Install the library, give the directory that has it with `-L DIR`, or correct the \
            name (`-l m` links libm).",
        example: "error[link.no-library] library 'nosuchlib' not found | help: -l nosuchlib on the \
            command line names it; the linker looked in its directories and the -L ones and found \
            none: install it, or give the directory that has it with -L DIR",
    },
    Explain {
        code: "link.no-framework", severity: "error, exit 1",
        means: "A macOS framework named by `-framework NAME` or `#[link(name = \"NAME\", kind = \
            \"framework\")]` is not in the SDK.",
        fix: "Correct the framework's name (`Metal`, `CoreGraphics`), or drop it.",
        example: "error[link.no-framework] framework 'Metl' not found | help: -framework Metl on \
            the command line names it; the linker looked in the SDK's frameworks and found none: \
            check the name",
    },
    Explain {
        code: "link.duplicate", severity: "error, exit 1",
        means: "Two inputs of the link define one symbol: the program's object and a C file, an \
            object or a library of the command line (a C file with its own `main`, an `extern \
            \"C\" fn` a C file defines too).",
        fix: "Rename one of the two definitions, or leave one input out. `--verbose` prints which \
            files the linker found it in.",
        example: "error[link.duplicate] symbol 'main' is defined more than once | help: the \
            program's fn main and a C file, an object or a library of the command line both \
            define main: keep one (--verbose: the linker's text)",
    },
    Explain {
        code: "link.c-file", severity: "error, exit 1",
        means: "A C file of the command line, compiled for the link, has errors: the C \
            compiler's lines follow the error (`cc: ...`).",
        fix: "Fix the C file at the lines the C compiler names.",
        example: "error[link.c-file] the C file 'b.c' does not compile | help: the C files of the \
            command line are compiled for the link; the C compiler's errors follow | cc: \
            b.c:1:24: error: use of undeclared identifier 'nope'",
    },
    Explain {
        code: "link.no-linker", severity: "error, exit 1",
        means: "The C compiler that links the program (`cc`, or $VOLE_CC) cannot be run.",
        fix: "Install a C toolchain (on macOS `xcode-select --install`; on Linux gcc or clang), \
            or set $VOLE_CC to a C compiler, or unset it.",
        example: "error[link.no-linker] cannot run 'vole-no-cc', the C compiler that links the \
            program | help: $VOLE_CC names it: set it to a C compiler, or unset it",
    },
    Explain {
        code: "link.no-input", severity: "error, exit 1",
        means: "An object, archive, shared library or C file of the command line, which goes to \
            the link, cannot be read.",
        fix: "Correct the path, or build the object first.",
        example: "error[link.no-input] cannot read 'nothere.o', an input of the link | help: the \
            objects (.o), archives (.a), shared libraries (.so, .dylib) and C files (.c) of the \
            command line go to the link: check the path",
    },
    Explain {
        code: "link.failed", severity: "error, exit 1",
        means: "The link failed in a way volec does not name: the linker's own lines follow the \
            error (`linker: ...`, at most 20).",
        fix: "Read the linker's lines; `--verbose` adds the link's command.",
        example: "error[link.failed] the link failed (cc exited with status 1) | help: the \
            linker's text follows (--verbose: its command too) | linker: ld: ...",
    },
    Explain {
        code: "cli.not-a-command", severity: "error, exit 2",
        means: "A build's first word names no file and is none of volec's commands (`volec build \
            main.vl`, `volec run`, `volec chek`): a build has no command word, and volec does not \
            run what it builds.",
        fix: "Run the try: line: the build without the word (`volec main.vl -o x`), the build \
            then the program (`volec main.vl -o main && ./main`), or the command meant.",
        example: "error cli.not-a-command: 'build' is not a volec command or a file: a build \
            names its files, with no command word\ntry: volec main.vl -o x",
    },
];
