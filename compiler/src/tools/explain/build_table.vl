// The explanations of a build's own codes (0.25.3): a program without
// fn main, a link that failed (back/objfile/linkfail.vl), a first word
// that reads as a command (cli/hint.vl); 0.25.4: `volec run`'s (cli/run.vl);
// 0.30.2: a stack frame past the target's limit (base/target.vl's
// frame_grow).

use crate::tools::explain::Explain;

pub const BUILD_COUNT: i64 = 16;

pub static BUILD_TABLE: [Explain<'_>; 16] = [
    Explain {
        code: b"main.missing", severity: b"error, exit 1",
        means: b"A build of an executable (`-o prog`) whose program has no `fn main`: before 0.25.3 \
            the linker said so in its own words (`Undefined symbols: \"_main\"`). With an object, \
            archive, library or C file on the command line, the link says it, when none of them \
            defines main either.",
        fix: b"Add `fn main() -> i32 { 0 }` (or `fn main(gpa: Gpa) -> i32`) to the root file, or \
            build an object with `-c -o NAME.o` when the file is a library.",
        example: b"nomain.vl:1:1: error[main.missing] 'nomain.vl' has no fn main | help: a program \
            starts at its fn main, and this one has none; an object (-c) needs none | try: printf \
            '\\nfn main() -> i32 {\\n    0\\n}\\n' >> nomain.vl | try: volec -c -o nomain.o \
            nomain.vl",
    },
    Explain {
        code: b"frame.too_big", severity: b"error, exit 1",
        means: b"(0.30.2) A function's stack frame reaches the target's limit: its locals and \
            temporaries, summed as the code generators lay them out, reach 2^62 bytes on AArch64 \
            (2 GiB less a page on x86-64, which reaches a frame's slots with 32-bit \
            displacements). It is reported at the local that takes the frame there, at every \
            level; the code generators' own slots (gen0's copies, the slots of the callees -O2 \
            inlines) are held to the same check, at the function. Before 0.30.2 the sum wrapped: \
            a frame of 2^63 bytes or more got no room, its slots above sp.",
        fix: b"Put the large value on the heap (`Box::new_in`, `Vec::with_capacity_in(n, gpa)`), \
            or make it smaller. A frame under the limit but larger than the stack is built, and \
            its probes fault as the function is entered.",
        example: b"big.vl:2:9: error[frame.too_big] the stack frame of 'main' reaches 2^62 bytes \
            with this value of type '[u8; 4611686018427387904]': more than the target's stack \
            frames hold | help: put a value this large on the heap (Box::new_in, \
            Vec::with_capacity_in), or make it smaller",
    },
    Explain {
        code: b"link.undefined", severity: b"error, exit 1",
        means: b"The link found no definition of a symbol the program (or a C file or object of \
            the command line) uses: a C function or static declared in an extern block whose \
            library is not linked, or misspelled. At the declaration when the program has one; \
            several are named on the line.",
        fix: b"Name the library that defines it: `#[link(lib = \"NAME\")]` on the extern block, or \
            `-l NAME` (and `-L DIR`) on the command line; check the symbol's spelling. `--verbose` \
            prints the linker's text.",
        example: b"undef.vl:1:14: error[link.undefined] undefined symbol 'nosuchfn' | help: \
            'nosuchfn' is declared in an extern block, and nothing the link is given defines it: \
            name its library, #[link(lib = \"NAME\")] on the block or -l NAME on the command line \
            (--verbose: the linker's text)",
    },
    Explain {
        code: b"link.no-library", severity: b"error, exit 1",
        means: b"A library named by `-l NAME` or by an extern block's `#[link(lib = \"NAME\")]` is \
            in none of the linker's directories.",
        fix: b"Install the library, give the directory that has it with `-L DIR`, or correct the \
            name (`-l m` links libm).",
        example: b"error[link.no-library] library 'nosuchlib' not found | help: -l nosuchlib on the \
            command line names it; the linker looked in its directories and the -L ones and found \
            none: install it, or give the directory that has it with -L DIR",
    },
    Explain {
        code: b"link.no-framework", severity: b"error, exit 1",
        means: b"A macOS framework named by `-framework NAME` or `#[link(name = \"NAME\", kind = \
            \"framework\")]` is not in the SDK.",
        fix: b"Correct the framework's name (`Metal`, `CoreGraphics`), or drop it.",
        example: b"error[link.no-framework] framework 'Metl' not found | help: -framework Metl on \
            the command line names it; the linker looked in the SDK's frameworks and found none: \
            check the name",
    },
    Explain {
        code: b"link.duplicate", severity: b"error, exit 1",
        means: b"Two inputs of the link define one symbol: the program's object and a C file, an \
            object or a library of the command line (a C file with its own `main`, an `extern \
            \"C\" fn` a C file defines too).",
        fix: b"Rename one of the two definitions, or leave one input out. `--verbose` prints which \
            files the linker found it in.",
        example: b"error[link.duplicate] symbol 'main' is defined more than once | help: the \
            program's fn main and a C file, an object or a library of the command line both \
            define main: keep one (--verbose: the linker's text)",
    },
    Explain {
        code: b"link.c-file", severity: b"error, exit 1",
        means: b"A C file of the command line, compiled for the link, has errors: the C \
            compiler's lines follow the error (`cc: ...`).",
        fix: b"Fix the C file at the lines the C compiler names.",
        example: b"error[link.c-file] the C file 'b.c' does not compile | help: the C files of the \
            command line are compiled for the link; the C compiler's errors follow | cc: \
            b.c:1:24: error: use of undeclared identifier 'nope'",
    },
    Explain {
        code: b"link.no-linker", severity: b"error, exit 1",
        means: b"The C compiler that links the program (`cc`, or $VOLE_CC) cannot be run.",
        fix: b"Install a C toolchain (on macOS `xcode-select --install`; on Linux gcc or clang), \
            or set $VOLE_CC to a C compiler, or unset it.",
        example: b"error[link.no-linker] cannot run 'vole-no-cc', the C compiler that links the \
            program | help: $VOLE_CC names it: set it to a C compiler, or unset it",
    },
    Explain {
        code: b"link.no-input", severity: b"error, exit 1",
        means: b"An object, archive, shared library or C file of the command line, which goes to \
            the link, cannot be read.",
        fix: b"Correct the path, or build the object first.",
        example: b"error[link.no-input] cannot read 'nothere.o', an input of the link | help: the \
            objects (.o), archives (.a), shared libraries (.so, .dylib) and C files (.c) of the \
            command line go to the link: check the path",
    },
    Explain {
        code: b"link.failed", severity: b"error, exit 1",
        means: b"The link failed in a way volec does not name: the linker's own lines follow the \
            error (`linker: ...`, at most 20).",
        fix: b"Read the linker's lines; `--verbose` adds the link's command.",
        example: b"error[link.failed] the link failed (cc exited with status 1) | help: the \
            linker's text follows (--verbose: its command too) | linker: ld: ...",
    },
    Explain {
        code: b"cli.not-a-command", severity: b"error, exit 2",
        means: b"A build's first word names no file and is none of volec's commands (`volec build \
            main.vl`, `volec exec`, `volec chek`): a build has no command word.",
        fix: b"Run the try: line: the build without the word (`volec main.vl -o x`), or the \
            command meant (`volec run`: build DIR/main.vl and run it).",
        example: b"error cli.not-a-command: 'build' is not a volec command or a file: a build \
            names its files, with no command word\ntry: volec main.vl -o x",
    },
    Explain {
        code: b"run.no-main", severity: b"error, exit 2",
        means: b"`volec run DIR` builds and runs the program whose root is DIR/main.vl (DIR: the \
            current directory when none is given), and DIR has no main.vl, or is no folder.",
        fix: b"Run the try: line: `volec run DIR/SUB` when a subfolder holds a main.vl, or the \
            plain build of the folder's one .vl file (`volec FILE.vl -o prog && ./prog`); else \
            name the folder that holds main.vl.",
        example: b"error run.no-main: 'examples' has no main.vl\nhelp: `volec run DIR` builds and \
            runs the program whose root is DIR/main.vl (DIR: the current directory when none is \
            given)\ntry: volec run examples/args",
    },
    Explain {
        code: b"run.file", severity: b"error, exit 2",
        means: b"`volec run` was given a file (`volec run main.vl`): it takes the folder that \
            holds main.vl, the program's root.",
        fix: b"Run the try: line: `volec run FOLDER` when the file's folder holds a main.vl, else \
            the file's plain build then the program (`volec x.vl -o x && ./x`).",
        example: b"error run.file: 'app/main.vl' is a file: run takes the folder that holds \
            main.vl\ntry: volec run app",
    },
    Explain {
        code: b"run.args", severity: b"error, exit 2",
        means: b"`volec run` was given two words that are neither options nor files of the link \
            (`volec run app input.txt`): it builds one program, from one folder; the program's \
            arguments go after `--`.",
        fix: b"Run the try: line: the second word after `--` (`volec run app -- input.txt`).",
        example: b"error run.args: 'input.txt' is a second folder, or the program's argument: run \
            builds one program; its arguments go after --\ntry: volec run app -- input.txt",
    },
    Explain {
        code: b"run.option", severity: b"error, exit 2",
        means: b"`volec run` was given an option that makes something else than a program for \
            this machine: an object (`-c`), assembly (`-S`), the IR (`--emit-ir`), a header, the \
            tokens, a test build, or `--target` another machine's.",
        fix: b"Leave the option out to run the program, or build with it: `volec DIR/main.vl \
            OPTIONS -o OUT`.",
        example: b"error run.option: -c makes no program to run\nhelp: run builds a program for \
            this machine and runs it; other outputs are a build's: `volec DIR/main.vl OPTIONS -o \
            OUT`",
    },
    Explain {
        code: b"time.instructions", severity: b"error, exit 1",
        means: b"(0.25.5) `--time-passes=instructions` counts the instructions each phase \
            retires with the system's counter, and this one refused: on Linux \
            perf_event_open, which /proc/sys/kernel/perf_event_paranoid above 2 or a \
            container's seccomp profile forbids ($VOLE_COUNTERS=off refuses it too, for the \
            tests). macOS always counts.",
        fix: b"Allow the counter (`sysctl kernel.perf_event_paranoid=2`, or a container run with \
            perf_event_open permitted), or measure CPU time with `--time-passes`, or the whole \
            build's instructions with `perf stat -e instructions:u volec ...`.",
        example: b"error[time.instructions]: the instructions retired cannot be read here | help: \
            the system's counter refused this process (Linux: perf_event_open, which \
            /proc/sys/kernel/perf_event_paranoid above 2 or a container's seccomp profile \
            forbids); --time-passes counts CPU time | try: volec --time-passes FILE.vl -c -o \
            /dev/null",
    },
];
