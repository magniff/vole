// The explanations of the codes left of the own pass (0.17): what each
// reports, the fix with its replacement text, and an example: the code,
// then the diagnostic as `check` prints it, split at its ` | `.

use crate::tools::explain::Explain;

pub const OWN_COUNT: i64 = 1;

pub static OWN_TABLE: [Explain<'_>; 1] = [
    Explain {
        code: b"own.interior_copy",
        severity: b"error",
        means: b"(0.26.1) A bit copy of a value that is not Freeze (a std::cell Cell or \
            UnsafeCell, or a type that holds one by value) where the program means the place \
            it is kept: std's copying getters (`v.get(i)`, `v.last()`, `m.get(k)`) and a \
            borrowing iterator's items given to a closure (`v.iter().for_each(|c| ..)`). The \
            copy is another cell, so a write through it would be lost.",
        fix: b"Reach the element as a place: index it (`v[i].set(x)`), or loop over it (`for c \
            in v.iter() { c.set(x); }`, whose items are the elements).",
        example: b"let c = v.get(0);\n\
            c.set(9);\n\
            \n\
            main.vl:5:13: error[own.interior_copy] a copy of a 'Cell<i64>' is another cell: a write through it is lost\n\
            \x20 help: reach the element where it is kept, a place: index it (`v[i].set(x)`), or loop over it (`for c in v.iter() { c.set(x); }`)\n\
            \x20 try: volec edit patch main.vl:5 --old 'v.get(0)' --new 'v[0]'",
    },
];
