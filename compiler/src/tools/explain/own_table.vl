// The explanations of the codes left of the own pass (0.17): what each
// reports, the fix with its replacement text, and an example: the code,
// then the diagnostic as `check` prints it, split at its ` | `.

use crate::tools::explain::Explain;

pub const OWN_COUNT: i64 = 2;

pub static OWN_TABLE: [Explain<'_>; 2] = [
    Explain {
        code: b"own.readonly",
        severity: b"error (as own.moved)",
        means: b"A change of something read-only. (0.25) An inout access of a let place: `&x` \
            given to an inout parameter, `inout r = &x`, `match &x`, or an `inout self` method \
            (`x.push(1)`, `x[i] = v` on a Vec) whose root is a let binding, a let parameter \
            (a copy of a plain value), a let receiver (`self` of a `fn m(self)`), or an \
            immutable static (in read-only memory). Also a write through a let access or a \
            let slice (`[T]`): an assignment, an inout method, a let parameter of an owned \
            type changed; a change to an owned copy that borrows (a `match` binding, a \
            `v.get(i)`, a `for` loop's element), whose original keeps pointing at what the \
            change may free; and a let `[T]` given where `inout [T]` is expected, to a callee \
            that writes through it (`sort(v.as_slice())`, a store intrinsic). `&x` given \
            where a raw `*T` is wanted is its address and needs no var.",
        fix: b"A local: declare it `var n = ...`. A parameter: take it `x: inout T` and pass \
            `&x` at the calls (`volec refactor signature F --convention x inout`), or `x: \
            sink T` for a copy of its own. A receiver: `inout self`. A static: `static var \
            N`. A slice: `inout [T]`, passed as `&v`, `&a[..]` or `v.as_mut_slice()`.",
        example: b"let n = 1;\n\
            bump(&n);\n\
            \n\
            main.vl:4:10: error[own.readonly] '&n' changes 'n', a let binding: it is read-only\n\
            \x20 help: declare it `var` to change it\n\
            \x20 try: var n = ...\n\
            \n\
            fn reset(p: P) { p.x.clear(); }\n\
            \n\
            main.vl:2:18: error[own.readonly] writes through 'p', a 'let P', which is read-only (let: borrowed to be read)\n\
            \x20 help: take it inout ('x: inout T', called with '&x') to change it\n\
            \x20 try: volec refactor signature reset --type p 'inout P'",
    },
    Explain {
        code: b"own.interior_copy",
        severity: b"error",
        means: b"(0.26.1) A bit copy of a value that is not Freeze (a std::cell Cell or \
            UnsafeCell, or a type that holds one by value) where the program means the place \
            it is kept: std's copying getters (`v.get(i)`, `v.last()`, `m.get(k)`) and a \
            borrowing iterator's items given to a closure (`v.iter().for_each(|c| ..)`). The \
            copy is another cell, so a write through it would be lost.",
        fix: b"Reach the element as a place: index it (`v[i].set(x)`), or loop over it (`for c \
            in v.iter() { c.set(x); }`, whose items are the elements).",
        example: b"let c = v.get(0);\n\
            c.set(9);\n\
            \n\
            main.vl:5:13: error[own.interior_copy] a copy of a 'Cell<i64>' is another cell: a write through it is lost\n\
            \x20 help: reach the element where it is kept, a place: index it (`v[i].set(x)`), or loop over it (`for c in v.iter() { c.set(x); }`)\n\
            \x20 try: volec edit patch main.vl:5 --old 'v.get(0)' --new 'v[0]'",
    },
];
