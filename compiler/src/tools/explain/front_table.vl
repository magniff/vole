// The explanations of the rust front's codes (0.27.2, front/traits.vl,
// front/coherence.vl, front/check: docs/design/front-rust.md section 8):
// the trait rules an impl, a bound or a call does not meet.

use crate::tools::explain::Explain;

pub const FRONT_COUNT: i64 = 3;

pub static FRONT_TABLE: [Explain; 3] = [
    Explain {
        code: "trait.unmet",
        severity: "error",
        means: "A trait bound the program needs is not met: an impl of a trait with \
            supertraits for a type that lacks one of them (`trait A: B`, `impl A for S` \
            without `impl B for S`), an associated type whose definition lacks a bound the \
            trait declares (`type Item: Clone;`), or a `where` predicate of a function that \
            does not hold where it is used (front-rust.md F2.3, F10.2, F11.1; rustc E0277).",
        fix: "Implement the missing trait for the type (the message names it), choose a type \
            that has it, or drop the bound when the code does not need it.",
        example: "// EDITION: rust\n\
            trait Base {}\n\
            trait Derived: Base {}\n\
            struct U {}\n\
            impl Derived for U {}\n\
            \n\
            main.vl:5:1: error[trait.unmet] 'Derived' requires 'U: Base', which is not implemented",
    },
    Explain {
        code: "trait.overlap",
        severity: "error",
        means: "Two impls of one trait apply to the same type: their headers unify and the \
            bounds of both can hold for it (a blanket `impl<T: Base> Show for T` beside \
            `impl Show for A` when `A: Base`). There is no specialization, so a call could not \
            choose; where the check cannot decide, it counts the pair as overlapping \
            (front-rust.md F4.2; rustc E0119).",
        fix: "Keep one of the impls, or bound them apart so that no type meets both (a bound \
            the other impl's type lacks, different trait arguments).",
        example: "// EDITION: rust\n\
            impl Base for A {}\n\
            impl<T: Base> Show for T { fn show(&self) -> i64 { 1 } }\n\
            impl Show for A { fn show(&self) -> i64 { 2 } }\n\
            \n\
            main.vl:4:1: error[trait.overlap] conflicting impls of trait 'Show': this impl and an earlier one apply to the same type",
    },
    Explain {
        code: "method.ambiguous",
        severity: "error",
        means: "A method call `x.m()` finds no inherent method `m` on x's type but more than \
            one trait's: the call does not say which (front-rust.md F9.3; rustc E0034). An \
            inherent method would win; two traits' never do.",
        fix: "Call it through its trait: `Tr::m(&x)` (the try: lines give one per trait).",
        example: "// EDITION: rust\n\
            impl A for S { fn get(&self) -> i64 { 1 } }\n\
            impl B for S { fn get(&self) -> i64 { 2 } }\n\
            s.get()\n\
            \n\
            main.vl:4:5: error[method.ambiguous] multiple applicable items: 'get' is a method of more than one trait for 'S'",
    },
];
