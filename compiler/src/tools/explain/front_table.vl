// The explanations of the rust front's codes (0.27.2, front/traits.vl,
// front/coherence.vl, front/check: docs/design/front-rust.md section 8):
// the trait rules an impl, a bound or a call does not meet.

use crate::tools::explain::Explain;

pub const FRONT_COUNT: i64 = 21;

pub static FRONT_TABLE: [Explain<'_>; 21] = [
    Explain {
        code: b"trait.impl_lifetimes",
        severity: b"error",
        means: b"An impl's method is less general than its trait's declaration, by its lifetimes: \
            with the trait's lifetimes as any caller may choose them, the impl's signature asks for \
            more (a parameter that must outlive what the trait's may not, a result that may not \
            live as long as the trait's says). A generic caller reads the call through the trait's \
            signature, so such an impl would let a borrow outlive what it borrows (front-rust.md \
            F5.5; rustc E0308, E0195).",
        fix: b"Write the trait's lifetimes in the impl's signature (the trait's `&'static str` is the \
            impl's too), or change the trait's declaration to say what the impl needs.",
        example: b"trait Mk { fn mk(&self) -> &'static str; }\n\
            struct X<'a> { s: &'a str }\n\
            impl<'a> Mk for X<'a> { fn mk(&self) -> &'a str { self.s } }\n\
            \n\
            main.vl:3:25: error[trait.impl_lifetimes] 'mk' does not have the lifetimes trait 'Mk' declares: its result needs 'a to outlive 'static, which neither the trait's signature nor the impl says",
    },
    Explain {
        code: b"trait.impl_generics",
        severity: b"error",
        means: b"An impl's function of a generic trait function does not have the trait's generics: \
            another number of type parameters (rustc E0049), or a bound on one that the trait's \
            does not imply (E0276; an `Fn*` bound with other lifetimes, E0308). A generic caller \
            reads the call through the trait and meets only the trait's bounds, so a stronger one \
            in the impl would let a reference to a local reach a thread (`T: 'static`) or copy a \
            String (`T: Copy`) (front-rust.md F5.5).",
        fix: b"Write the trait's type parameters and bounds in the impl (a weaker bound is fine), or \
            add the bound to the trait's declaration.",
        example: b"trait Tr { fn f<T>(&self, x: T) -> i64; }\n\
            struct S;\n\
            impl Tr for S { fn f<T: Copy>(&self, x: T) -> i64 { 1 } }\n\
            \n\
            main.vl:3:25: error[trait.impl_generics] 'f' has a stricter bound than trait 'Tr' declares: its 'T: Copy' is not the trait's",
    },
    Explain {
        code: b"trait.sealed",
        severity: b"error",
        means: b"The trait is sealed: std writes all its impls, and std's code relies on what they say \
            (a Pattern's match is on char boundaries, a Step moves, a SliceIndex checks its bounds, \
            an Atomic's value is one machine access). An impl of it outside std is refused \
            (front-rust.md F5.6; Rust's sealed traits, and Pattern and Step are unstable there, \
            E0658).",
        fix: b"Use one of std's impls (the trait's documentation lists them): a char, a &str or a \
            closure for a Pattern, an integer range for a Step; or a function of the program's own.",
        example: b"struct Liar;\n\
            impl std::str::Pattern for Liar { .. }\n\
            \n\
            main.vl:2:1: error[trait.sealed] trait 'Pattern' is sealed: only std implements it, and std's code relies on what its impls say",
    },
    Explain {
        code: b"trait.unmet",
        severity: b"error",
        means: b"A trait bound the program needs is not met: an impl of a trait with supertraits for a \
            type that lacks one of them (`trait A: B`, `impl A for S` without `impl B for S`) or has \
            it only under a lifetime bound the impl does not have (`impl<'a, 'b> B for X<'a, 'b> where \
            'a: 'b` beside `impl<'a, 'b> A for X<'a, 'b>`, rustc E0478), an \
            associated type whose definition lacks a bound the trait declares (`type Item: Clone;`), \
            or a `where` predicate of a function that does not hold where it is used (front-rust.md \
            F2.3, F10.2, F11.1; rustc E0277).",
        fix: b"Implement the missing trait for the type (the message names it), choose a type that has \
            it, add the supertrait impl's lifetime bound to the impl, or drop the bound when the code \
            does not need it.",
        example: b"trait Base {}\n\
            trait Derived: Base {}\n\
            struct U {}\n\
            impl Derived for U {}\n\
            \n\
            main.vl:4:1: error[trait.unmet] 'Derived' requires 'U: Base', which is not implemented",
    },
    Explain {
        code: b"trait.overlap",
        severity: b"error",
        means: b"Two impls of one trait apply to the same type: their headers unify and the bounds of \
            both can hold for it (a blanket `impl<T: Base> Show for T` beside `impl Show for A` when \
            `A: Base`). There is no specialization, so a call could not choose; where the check \
            cannot decide, it counts the pair as overlapping (front-rust.md F4.2; rustc E0119).",
        fix: b"Keep one of the impls, or bound them apart so that no type meets both (a bound the other \
            impl's type lacks, different trait arguments).",
        example: b"impl Base for A {}\n\
            impl<T: Base> Show for T { fn show(&self) -> i64 { 1 } }\n\
            impl Show for A { fn show(&self) -> i64 { 2 } }\n\
            \n\
            main.vl:3:1: error[trait.overlap] conflicting impls of trait 'Show': this impl and an earlier one apply to the same type",
    },
    Explain {
        code: b"method.ambiguous",
        severity: b"error",
        means: b"A method call `x.m()` finds no inherent method `m` on x's type but more than one \
            trait's: the call does not say which (front-rust.md F9.3; rustc E0034). An inherent \
            method would win; two traits' never do.",
        fix: b"Call it through its trait: `Tr::m(&x)` (the try: lines give one per trait).",
        example: b"impl A for S { fn get(&self) -> i64 { 1 } }\n\
            impl B for S { fn get(&self) -> i64 { 2 } }\n\
            s.get()\n\
            \n\
            main.vl:3:5: error[method.ambiguous] multiple applicable items: 'get' is a method of more than one trait for 'S'",
    },
    Explain {
        code: b"attr.builtin",
        severity: b"error",
        means: b"`#[builtin_impls(P, ..)]` on a trait asks the compiler for the trait's impls for the \
            primitives listed, made as if written (front-rust.md F15.1). It makes them for std's \
            operator, comparison, `Clone`/`Copy`, `Default`, `Hash`, `Sum`/`Product`, `Step`, \
            `FromStr` and formatting traits, for the numbers and `bool`; another trait, or a name \
            that is not such a primitive, has none.",
        fix: b"Write the impl (`impl Tr for i64 { .. }`) and drop the name from the list, or the \
            attribute.",
        example: b"#[builtin_impls(i64)]\n\
            trait Shape { fn area(&self) -> i64; }\n\
            \n\
            main.vl:1:1: error[attr.builtin] no builtin impl of 'Shape' for 'i64'",
    },
    Explain {
        code: b"type.cast",
        severity: b"error",
        means: b"`as` does not convert between these two types (front-rust.md F1.3, \
            F29.1; rustc E0604, E0605, E0606). A `char` casts to the integers, and only a `u8` casts \
            to a `char`: not every u32 is a Unicode scalar.",
        fix: b"For a u32, `char::from_u32(x)`, which checks; for a char from a byte, `b as char`.",
        example: b"let x: u32 = 65;\n\
            let c = x as char;\n\
            \n\
            main.vl:2:13: error[type.cast] cannot cast 'u32' to 'char'",
    },
    Explain {
        code: b"type.ref_cast",
        severity: b"error",
        means: b"`as` makes a reference only of a reference to the same type (`&mut T as &T`, a \
            reborrow). A reference of another type, `&x as &U` or `&mut x as &mut U`, would be a \
            transmute in safe code: the bytes of a T read or written as a U, which may not be a \
            valid U (a bool that is 100, a char past U+10FFFF, a reference from a number); \
            `&mut s as &mut [u8]` of a `&mut str` would let safe code write bytes that are not \
            UTF-8; a raw pointer cast to a reference would make one of any address; and a `&T` \
            cast to a `&mut T` would alias (front-rust.md F29.4; rustc E0605, E0606).",
        fix: b"Convert the value (`*r as U`, `U::from(*r)`); for the bytes of a str, `s.as_bytes()`; \
            for a reference from a raw pointer, `&*p` in an unsafe block whose SAFETY says why the \
            pointee lives and is valid.",
        example: b"let mut b = false;\n\
            let q = &mut b as &mut u8;\n\
            \n\
            main.vl:2:9: error[type.ref_cast] cannot cast '&mut bool' to the reference '&mut u8': `as` makes no reference of another type",
    },
    Explain {
        code: b"type.widen_i32",
        severity: b"error",
        means: b"An i32 is widened implicitly only when the program writes its type somewhere (a \
            parameter, a field, an annotated `let`, a function's result, a suffix) or when it is \
            a literal or an element, whose value is the same in either type. This one is \
            computed in i32 (an operator, an i32 method) from integer literals nothing gives a \
            type, which default to i32; Rust types such a literal from the use that widens it \
            here, so its arithmetic is i64 there, and widening after it would give another value \
            on overflow (front-rust.md F29.3).",
        fix: b"Write the type where the value is made: `let a: [i64; 2] = [2000000000, 2];`, \
            `let s: i64 = ...`, a suffix `2000000000i64`; or, when i32 is meant, convert the \
            result, `i64::from(s)`.",
        example: b"let a = [2000000000, 2];\n\
            let s = a[0] + a[0];\n\
            let t: i64 = s;\n\
            \n\
            main.vl:3:14: error[type.widen_i32] this 'i32' is not widened to 'i64' implicitly: it is computed in i32, the integer literals' default type, as nothing written gives its operands a type",
    },
    Explain {
        code: b"impl.duplicate",
        severity: b"error",
        means: b"Two inherent impls of one type define a method of the same name: several `impl S { .. }` \
            blocks are allowed, but their method names must differ where both apply (front-rust.md \
            F5.3; rustc E0592). A trait's method may share an inherent method's name: the inherent \
            one is what `x.m()` calls.",
        fix: b"Delete one of the two, or rename one (`volec refactor rename` changes its calls).",
        example: b"impl S { fn f(&self) -> i64 { 1 } }\n\
            impl S { fn f(&self) -> i64 { 2 } }\n\
            \n\
            main.vl:2:10: error[impl.duplicate] duplicate method 'f' for type 'S'",
    },
    Explain {
        code: b"trait.unconstrained",
        severity: b"error",
        means: b"A type parameter of a trait impl occurs neither in the self type nor in the trait's \
            arguments, nor in an associated-type constraint of a bound of a parameter that does \
            (`impl<T> Tr for S`): nothing at a use of the impl could say what T is (front-rust.md \
            F14.1; rustc E0207). A parameter fixed through an associated type's constraint counts \
            (`impl<T, I: Iterator<Item = T>> Tr for W<I>`, and an `Fn*` bound's result, `F: FnMut() \
            -> T`); one written only inside a projection (`W<<T as B>::X>`) or a bound's trait \
            argument (`U: Tr<T>`) does not, as many T give the one type. A lifetime of the impl that \
            an associated type uses is constrained so too (`impl<'a> B for H { type X = &'a str; }`: \
            H::X would be `&'a str` for every 'a, 'static too).",
        fix: b"Use the parameter in the self type or the trait's arguments (`impl<T> Tr<T> for S`, \
            `impl<'a> B for H<'a>`), or drop it.",
        example: b"trait Tr { fn f(&self) -> i64; }\n\
            impl<T> Tr for S { fn f(&self) -> i64 { 1 } }\n\
            \n\
            main.vl:2:6: error[trait.unconstrained] the type parameter 'T' is not constrained by the impl's trait, self type or bounds",
    },
    Explain {
        code: b"type.infer",
        severity: b"error",
        means: b"A generic call's type parameter is fixed by nothing: not by a turbofish, the arguments, \
            nor the type the result goes to (a `let`'s annotation, a parameter, a field, the return \
            type). Vole infers no type from a later use of the variable (front-rust.md F18.1, F18.2; \
            rustc E0282).",
        fix: b"Give the variable a type (`let x: i64 = make();`), or write the type arguments (the try: \
            line: `make::<T>()`, with the type for T).",
        example: b"fn make<T: Zero>() -> T { T::zero() }\n\
            let x = make();\n\
            \n\
            main.vl:2:13: error[type.infer] cannot infer type parameter 'T' of 'make'",
    },
    Explain {
        code: b"derive.default",
        severity: b"error",
        means: b"`#[derive(Default)]` on an enum makes `default()` the variant marked \
            `#[default]`, as Rust's (front-rust.md F17.1): with no variant marked, there is no value \
            to make.",
        fix: b"Mark one variant without fields `#[default]`, or write `impl Default for E`.",
        example: b"#[derive(Default)]\n\
            enum Mode { Fast, Slow }\n\
            \n\
            main.vl:1:10: error[derive.default] cannot derive Default for 'Mode': no variant is marked #[default]",
    },
    Explain {
        code: b"type.unsized",
        severity: b"error",
        means: b"`[T]` and `str` have no size known at compile time: a value of one cannot be a \
            parameter, a result, a field, a local, or a tuple's or an array's element. It lives \
            behind a reference or a pointer (`&[T]`, `&mut str`, `*const [u8]`) (front-rust.md \
            F21.2, Z9; rustc E0277).",
        fix: b"Take it by reference: `&[T]`, `&str` (the try: line), or own it as `Vec<T, A>`, \
            `String<A>`.",
        example: b"fn sum(xs: [i64]) -> i64 { 0 }\n\
            \n\
            main.vl:1:12: error[type.unsized] the size of '[i64]' cannot be known: a parameter holds its value",
    },
    Explain {
        code: b"generic.unbounded_use",
        severity: b"error",
        means: b"In a generic body a value of a type parameter's type admits only what the \
            parameter's bounds give it (front-rust.md D22.3): an operator needs its trait among them \
            (`a < b` needs `T: PartialOrd`, `a + b` `T: Add`, F26.2), even where every instance \
            would have it (rustc E0369).",
        fix: b"Add the bound the message names to the parameter (`T: PartialOrd`), or a `where` clause.",
        example: b"fn largest<T: Copy>(a: T, b: T) -> T { if a < b { b } else { a } }\n\
            \n\
            main.vl:1:43: error[generic.unbounded_use] binary operation '<' cannot be applied to type 'T' | help: add the bound: 'T: PartialOrd'",
    },
    Explain {
        code: b"opaque.mismatch",
        severity: b"error",
        means: b"A function with an `impl Trait` result (borrowck.md D21.2) has one hidden type: the \
            first value that leaves it, a `return`'s or the tail's, fixes it, and every other must \
            be of that type, whatever the bounds say (rustc E0308).",
        fix: b"Return one type on every path: an enum of the cases, or a struct both build; `Box<dyn \
            Trait>` comes with 0.29.",
        example: b"fn f(c: bool) -> impl Copy { if c { return 1u8; } 2u16 }\n\
            \n\
            main.vl:1:51: error[opaque.mismatch] mismatched types: expected 'u8', found 'u16'",
    },
    Explain {
        code: b"opaque.ambiguous",
        severity: b"error",
        means: b"Each lifetime in an `impl Trait` result's hidden type is one of the function's input \
            lifetimes (D21.2's member choice): here one place in it holds loans of two inputs, and \
            neither outlives the other, so it can be neither (rustc E0700).",
        fix: b"Name one lifetime on the references it returns (`x: &'a T, y: &'a T`), or declare the \
            bound between them (`'b: 'a`).",
        example: b"fn pick<'a, 'b>(c: bool, x: &'a u8, y: &'b u8) -> impl Copy { if c { x } else { y } }\n\
            \n\
            main.vl:1:51: error[opaque.ambiguous] the `impl Trait` result captures 'a and 'b in one place, and neither outlives the other: its hidden type's lifetime is ambiguous (rustc E0700)",
    },
    Explain {
        code: b"opaque.cycle",
        severity: b"error",
        means: b"An `impl Trait` result's hidden type is the result itself: the function returns its own \
            call's value, or its body needs its own hidden type (D21.4, rustc E0720).",
        fix: b"Give the recursion a concrete type: return a named type, or end it in a value of the \
            hidden type.",
        example: b"fn f(n: u8) -> impl Copy { f(n) }\n\
            \n\
            main.vl:1:28: error[opaque.cycle] cannot resolve opaque type 'impl Copy': its hidden type is the function's own result",
    },
    Explain {
        code: b"generic.unchecked",
        severity: b"warning",
        means: b"A generic function's check for every type meets a form the opaque model does not \
            cover (a `where` predicate on a compound type, `where Option<T>: Clone`; a generic \
            method of a generic trait called through a bound, std's `RangeBounds::contains`; a type \
            whose declaration bounds a parameter the function leaves unbounded, `&mut HashMap<K, V, \
            A, S>` in an impl with no `S: BuildHasher`, which rustc refuses, E0277), so \
            its errors are found at its instances, each checked whole (D22.2), and it has none: \
            nothing checked it (rustc would, for every type).",
        fix: b"Call it, or write the predicate on the type parameter itself (`T: Clone`), which the \
            opaque model covers; declare the bound a type it names needs (`S: BuildHasher`).",
        example: b"fn go<T>(t: T) -> i64 where Option<T>: Clone { let q: i64 = \"x\"; 1 }\n\
            fn main() {}\n\
            \n\
            main.vl:1:1: warning[generic.unchecked] this generic function is not checked for every type: its generic check meets a form the opaque model does not cover",
    },
    Explain {
        code: b"trait.drop_impl",
        severity: b"error",
        means: b"A `Drop` impl is not as general as its type: it runs for every value of the type, \
            so its header must name the type with a distinct parameter of the impl for each type \
            argument and a distinct (or elided) lifetime for each lifetime, and it may add no \
            predicate the type's declaration does not have (a lifetime bound `'a: 'static` in \
            the header or a `where`, a type parameter's `T: Clone` or `T: 'static`). Its `drop` \
            would assume what a value of the type need not have, and nothing requires it where \
            the value is dropped: a `drop` that pushes a `&'a str` into a `Vec<&'static str>` \
            kept a freed String's text (front-rust.md F2.7; rustc E0366, E0367).",
        fix: b"Write the impl for every value of the type (`impl<'a, T: B> Drop for W<'a, T>`, \
            with the declaration's bounds only), or put the bound on the type's declaration, \
            where every value must meet it.",
        example: b"struct W<'a> { r: &'a str }\n\
            impl<'a: 'static> Drop for W<'a> { fn drop(&mut self) {} }\n\
            fn main() {}\n\
            \n\
            main.vl:2:1: error[trait.drop_impl] this `Drop` impl is not as general as its type: it bounds the lifetime 'a' by 'static', which the type's declaration does not (rustc E0366/E0367)",
    },
];
