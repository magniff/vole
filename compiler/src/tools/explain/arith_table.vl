// The explanations of the codes of 0.26.3's arithmetic (decision 6):
// constants folded with the overflow checks' rule (front/consteval.vl);
// docs/grammar.md, "Arithmetic".

use crate::tools::explain::Explain;

pub const ARITH_COUNT: i64 = 1;

pub static ARITH_TABLE: [Explain; 1] = [
    Explain {
        code: "arith.overflow", severity: "error",
        means: "(0.26.3) A constant expression (a `const` or `static` item, an array length, an enum discriminant) whose integer arithmetic overflows its type. A constant is computed as the program's own arithmetic would be (decision 6, Rust's): with the overflow checks on (-O0's default, or `--overflow-checks=on`), a `+ - *`, unary `-` or shift whose value does not fit, or a shift by at least the type's bits, is this error, where at run time it would panic with `attempt to add with overflow`; with them off (-O1 and -O2's default, or `--overflow-checks=off`) it wraps. `MIN / -1` and `MIN % -1` are an error at every level, as at run time they always panic; `/ 0` is a type error. A negative literal (`-128` as an i8) is no negation. `volec check` checks with the checks off.",
        fix: "Write a value that fits the type (`i32::MAX`, `0 - 9223372036854775807 - 1`), compute in a wider type and cast (`(x as i64 * 3) as i32` wraps by the cast, as Rust's `as` does), or build with `--overflow-checks=off` to wrap.",
        example: "error[arith.overflow] this constant expression overflows 'i32': attempt to add with overflow | help: with the overflow checks on (-O0, or --overflow-checks=on) a constant's arithmetic is checked as the program's: write a value that fits, or wrap it with --overflow-checks=off",
    },
];
