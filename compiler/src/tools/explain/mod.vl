// `volec explain [CODE]` (0.13; docs/query.md): what a diagnostic
// code means, how to fix it, an example, from one table: every code the
// tools print (`error query.no-match: ...`) and the kinds of the
// compiler's errors and warnings (`error[type error]`), in tools_table
// and refactor_table. tests/refactor/run.sh checks that every code in
// the compiler's source has an entry.
//
//   volec explain CODE      the entry (`type-error` for `type error`)
//   volec explain PREFIX    the codes of a tool (`explain fmt`)
//   volec explain           every code, with its severity
//   volec explain --list    every code, one per line

mod tools_table;
mod refactor_table;
mod own_table;
// (0.18: the codes of contracts, distinct types and tests)
mod v018_table;
// (0.19: std::arch's codes)
mod arch_table;
mod conv_table;
mod sync_table;
// (0.21: rewrite --text, refactor extension)
mod textual_table;
// (0.25.3: main.missing, the link's and the command line's codes)
mod build_table;
// (0.25.3: text blocks, include_str and include_bytes)
mod strings_table;
// (0.26.0: the shader compiler's wgsl.* and std::gpu's gpu.*)
mod gpu_table;
// (0.26.2: where, impl Trait, visibility, format literals)
mod text_table;
// (0.26.3: the allocator rules)
mod alloc_table;
// (0.26.3: arithmetic, decision 6)
mod arith_table;
// (0.27.0: the rust edition's codes)
mod edition_table;
mod borrowck_table;
// (0.27.2: the rust front, front-rust.md)
mod front_table;

use crate::base::{STDOUT, buf_byte, buf_bytes, buf_new, buf_str, buf_write_fd};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::edit_distance;
use crate::cli::line::{Call, EV_WORD, Leaf, flag, is_flag, table};
use crate::guide::find::guide_find;
use crate::tools::ctx::Tcx;
use crate::tools::explain::alloc_table::{ALLOC_COUNT, ALLOC_TABLE};
use crate::tools::explain::arch_table::{ARCH_COUNT, ARCH_TABLE};
use crate::tools::explain::arith_table::{ARITH_COUNT, ARITH_TABLE};
use crate::tools::explain::borrowck_table::{BORROWCK_COUNT, BORROWCK_TABLE};
use crate::tools::explain::build_table::{BUILD_COUNT, BUILD_TABLE};
use crate::tools::explain::conv_table::{CONV_COUNT, CONV_TABLE};
use crate::tools::explain::edition_table::{EDITION_COUNT, EDITION_TABLE};
use crate::tools::explain::front_table::{FRONT_COUNT, FRONT_TABLE};
use crate::tools::explain::gpu_table::{GPU_COUNT, GPU_TABLE};
use crate::tools::explain::own_table::{OWN_COUNT, OWN_TABLE};
use crate::tools::explain::refactor_table::{REFACTOR_COUNT, REFACTOR_TABLE};
use crate::tools::explain::strings_table::{STRINGS_COUNT, STRINGS_TABLE};
use crate::tools::explain::sync_table::{SYNC_COUNT, SYNC_TABLE};
use crate::tools::explain::text_table::{TEXT_COUNT, TEXT_TABLE};
use crate::tools::explain::textual_table::{TEXTUAL_COUNT, TEXTUAL_TABLE};
use crate::tools::explain::tools_table::{TOOLS_COUNT, TOOLS_TABLE};
use crate::tools::explain::v018_table::{V018_COUNT, V018_TABLE};
use crate::tools::proc::same_bytes;
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::{diag, put_word, try_begin, try_end, write_diags};

#[derive(Clone, Copy)] pub struct Explain<'a> {
    code: &'a [u8], severity: &'a [u8], means: &'a [u8], fix: &'a [u8], example: &'a [u8],
}

fn count() -> i64 {
    base_count() + TEXT_COUNT + ALLOC_COUNT + ARITH_COUNT + EDITION_COUNT + BORROWCK_COUNT
        + FRONT_COUNT
}

// The codes before 0.26.2's (TEXT_TABLE comes after them).
fn base_count() -> i64 {
    TOOLS_COUNT + REFACTOR_COUNT + OWN_COUNT + V018_COUNT + ARCH_COUNT + CONV_COUNT + SYNC_COUNT
        + TEXTUAL_COUNT + BUILD_COUNT + STRINGS_COUNT + GPU_COUNT
}

fn entry(i: i64) -> *mut Explain<'static> {
    // (0.27.2: the rust front's, the last table; 0.27.1: the borrow
    // checker's; 0.27.0: the edition's)
    if i >= count() - FRONT_COUNT {
        return &mut FRONT_TABLE[(i - (count() - FRONT_COUNT)) as usize] as *mut Explain<'_>;
    }
    let last = count() - FRONT_COUNT;
    if i >= last - BORROWCK_COUNT {
        return &mut BORROWCK_TABLE[(i - (last - BORROWCK_COUNT)) as usize] as *mut Explain<'_>;
    }
    let before = last - BORROWCK_COUNT;
    if i >= before - EDITION_COUNT {
        return &mut EDITION_TABLE[(i - (before - EDITION_COUNT)) as usize] as *mut Explain<'_>;
    }
    if i >= before - EDITION_COUNT - ARITH_COUNT {
        return &mut ARITH_TABLE[(i - (before - EDITION_COUNT - ARITH_COUNT)) as usize] as *mut Explain<'_>;
    }
    if i >= base_count() + TEXT_COUNT {
        return &mut ALLOC_TABLE[(i - base_count() - TEXT_COUNT) as usize] as *mut Explain<'_>;
    }
    if i >= base_count() {
        return &mut TEXT_TABLE[(i - base_count()) as usize] as *mut Explain<'_>;
    }
    let r = TOOLS_COUNT + REFACTOR_COUNT;
    if i < TOOLS_COUNT { &mut TOOLS_TABLE[i as usize] as *mut Explain<'_> }
    else if i < r { &mut REFACTOR_TABLE[(i - TOOLS_COUNT) as usize] as *mut Explain<'_> }
    else if i < r + OWN_COUNT { &mut OWN_TABLE[(i - r) as usize] as *mut Explain<'_> }
    else if i
        < r + OWN_COUNT + V018_COUNT {
        &mut V018_TABLE[(i - r - OWN_COUNT) as usize] as *mut Explain<'_>
    }
    else if i < r + OWN_COUNT + V018_COUNT + ARCH_COUNT {
        &mut ARCH_TABLE[(i - r - OWN_COUNT - V018_COUNT) as usize] as *mut Explain<'_>
    } else if i < r + OWN_COUNT + V018_COUNT + ARCH_COUNT + CONV_COUNT {
        &mut CONV_TABLE[(i - r - OWN_COUNT - V018_COUNT - ARCH_COUNT) as usize] as *mut Explain<'_>
    } else if i < r + OWN_COUNT + V018_COUNT + ARCH_COUNT + CONV_COUNT + SYNC_COUNT {
        &mut SYNC_TABLE[(i - r - OWN_COUNT - V018_COUNT - ARCH_COUNT - CONV_COUNT) as usize] as *mut Explain<'_>
    } else if i < base_count() - BUILD_COUNT - STRINGS_COUNT - GPU_COUNT {
        &mut TEXTUAL_TABLE[
            (i - r - OWN_COUNT - V018_COUNT - ARCH_COUNT - CONV_COUNT - SYNC_COUNT) as usize]
            as *mut Explain<'_>
    } else if i < base_count() - STRINGS_COUNT - GPU_COUNT {
        &mut BUILD_TABLE[(i - (base_count() - BUILD_COUNT - STRINGS_COUNT - GPU_COUNT)) as usize] as *mut Explain<'_>
    } else if i < base_count() - GPU_COUNT {
        &mut STRINGS_TABLE[(i - (base_count() - STRINGS_COUNT - GPU_COUNT)) as usize] as *mut Explain<'_>
    } else {
        &mut GPU_TABLE[(i - (base_count() - GPU_COUNT)) as usize] as *mut Explain<'_>
    }
}

// CODE as the table has it: lower case but for `C import`; without
// `error[...]` around it; `-` and `_` as spaces in a compiler kind (no
// dot).
fn normal(arg: &[u8]) -> i64 {
    let mut s = arg;
    let mut k: i64 = 0;
    while k < s.len() as i64 && s[k as usize] != b'[' {
        k += 1;
    }
    if k < s.len() as i64 && s[(s.len() as i64 - 1) as usize] == b']' {
        s = &s[(k + 1) as usize..(s.len() as i64 - 1) as usize];
    }
    let mut dot = false;
    for i in 0..s.len() {
        if s[i] == b'.' {
            dot = true;
        }
    }
    let out = buf_new();
    for i in 0..s.len() {
        let mut c = s[i];
        if !dot && (c == b'-' || c == b'_') {
            c = b' ';
        }
        if c >= b'A' && c <= b'Z' && !(i == 0 && c == b'C') {
            c = c - b'A' + b'a';
        }
        if i == 0 && c == b'c' && s.len() > 1 && (s[1] == b' ' || s[1] == b'-' || s[1] == b'_') {
            c = b'C';
        }
        buf_byte(out, c);
    }
    out
}

fn put_entry(out: i64, e: Explain<'_>) {
    buf_bytes(out, e.code);
    buf_str(out, c": ");
    buf_bytes(out, e.severity);
    buf_byte(out, b'\n');
    buf_bytes(out, e.means);
    buf_str(out, c"\nfix: ");
    buf_bytes(out, e.fix);
    buf_str(out, c"\nexample:\n    ");
    let x = e.example;
    for i in 0..x.len() {
        buf_byte(out, x[i]);
        if x[i] == b'\n' {
            buf_str(out, c"    ");
        }
    }
    buf_byte(out, b'\n');
}

fn usage(message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"explain.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    try_end(try_begin(c"explain query.no-match", b"", false, tcx, pcx));
    2
}

pub fn run_explain(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let status = explain_inner(c, tcx, pcx);
    write_diags(tcx);
    status
}

// `explain`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn explain_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    // (0.25: on std::cli) CODE, or words (a compiler's
    // message, any text: each argument as given), or --list
    let mut opts = table(gpa);
    opts.push(flag("list", "the codes alone"));
    Leaf::new(opts, "words")
}

fn explain_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let out = buf_new();
    let line = c.evs.clone();
    let listing = line.len() == 0 || (line.len() == 1 && is_flag(line[0], "list"));
    if !listing && (line[0].kind != EV_WORD || line[0].text.starts_with("-")) {
        return usage(c"no options but --list", tcx, pcx);
    }
    if !listing && c.line.len() > line[0].at + 1 {
        // (0.15: words, a compiler's message: the guide about them)
        let q = buf_new();
        for k in line[0].at..c.line.len() {
            if k > line[0].at {
                buf_byte(q, b' ');
            }
            buf_bytes(q, c.word(k).as_bytes());
        }
        if explain_by_guide(&crate::base::buf_copy(q), tcx, pcx) == 0 {
            return 0;
        }
        let d = diag(c"error", c"explain.unknown", tcx);
        buf_str(d, c"no code, and no paragraph of the guide about '");
        crate::base::buf_append(d, q);
        buf_str(d, c"'\n");
        try_end(try_begin(c"explain", b"", false, tcx, pcx));
        return 1;
    }
    unsafe {
        if listing {
            for i in 0..count() {
                buf_bytes(out, (*entry(i)).code);
                if c.line.len() == 2 {
                    buf_byte(out, b'\t');
                    buf_bytes(out, (*entry(i)).severity);
                }
                buf_byte(out, b'\n');
            }
            buf_write_fd(out, STDOUT);
            return 0;
        }
        let first = line[0];
        let want = crate::base::buf_copy(normal(c_slice(first.value)));
        for i in 0..count() {
            if same_bytes((*entry(i)).code, &want) {
                put_entry(out, *entry(i));
                buf_write_fd(out, STDOUT);
                return 0;
            }
        }
        // A tool's name: its codes (0.16: as written too, `same-output`
        // keeps its `-`).
        let raw = c_slice(first.value);
        let mut listed: i64 = 0;
        for i in 0..count() {
            let c = (*entry(i)).code;
            if (c.len() > want.len() && c[want.len()] == b'.'
                && same_bytes(&c[0..want.len()], &want))
                || (c.len() > raw.len() && c[raw.len()] == b'.'
                    && same_bytes(&c[0..raw.len()], raw)) {
                buf_bytes(out, c);
                buf_byte(out, b'\t');
                buf_bytes(out, (*entry(i)).severity);
                buf_byte(out, b'\n');
                listed += 1;
            }
        }
        if listed > 0 {
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if explain_by_guide(c_slice(first.value), tcx, pcx) == 0 {
            return 0;
        }
        let d = diag(c"error", c"explain.unknown", tcx);
        buf_str(d, c"no code '");
        buf_bytes(d, &want);
        buf_str(d, c"'\n");
        // The nearest codes (at most 3, within a third of the length).
        let mut shown: i64 = 0;
        let mut dist: i64 = 1;
        while dist <= want.len() as i64 / 3 + 1 && shown < 3 {
            for i in 0..count() {
                let c = (*entry(i)).code;
                if shown < 3 && edit_distance(c, &want) == dist {
                    let t = try_begin(c"explain", b"", false, tcx, pcx);
                    put_word(t, c);
                    try_end(t);
                    shown += 1;
                }
            }
            dist += 1;
        }
        if shown == 0 {
            try_end(try_begin(c"explain", b"", false, tcx, pcx));
        }
        1
    }
}

// (0.15) WORDS that are no code (`explain type`, a compiler's message):
// the guide's paragraphs about them (guide --find, 600 tokens at most),
// after a note; 0, or 1 when the guide has none or words is spelt like a
// code (nothing printed).
fn explain_by_guide(words: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    let mut left: i64 = 0;
    if find_dot(words) || guide_find(words, 600 * 4, out, &mut left, pcx) == 0 {
        return 1;
    }
    let d = diag(c"note", c"explain.guide", tcx);
    buf_str(d, c"'");
    buf_bytes(d, words);
    buf_str(d, c"' is no code: the guide's paragraphs about it\n");
    if left > 0 {
        let t = try_begin(c"guide", b"", false, tcx, pcx);
        buf_str(t, c" --find");
        put_word(t, words);
        buf_str(t, c" --budget 3000");
        try_end(t);
    }
    buf_write_fd(out, STDOUT);
    0
}

// Whether s has a `.` (a code's spelling, `query.no-match`).
fn find_dot(s: &[u8]) -> bool {
    for i in 0..s.len() {
        if s[i] == b'.' {
            return true;
        }
    }
    false
}
