// The explanations of the diagnostic codes of the refactorings, rewrite
// and the compiler itself (its errors' and warnings' kinds, as in
// `error[type error]`), for `volec explain CODE` (0.13).

use crate::tools::explain::Explain;

pub const REFACTOR_COUNT: i64 = 64;

pub static REFACTOR_TABLE: [Explain<'_>; 64] = [
    Explain {
        code: b"refactor.ambiguous", severity: b"error, exit 1",
        means: b"`refactor inline FN --at FILE:LINE`: that line has several calls of FN.",
        fix: b"Inline every call (no --at), or put the call wanted on a line of its own first.",
        example: b"error refactor.ambiguous: main.vl:12 has 2 calls of crate::sq; inline them all, or put one on a line of its own",
    },
    Explain {
        code: b"refactor.ambiguous-local", severity: b"error, exit 1",
        means: b"`refactor rename FN::x NEW`: FN has several locals named x (one shadows another).",
        fix: b"Name the one wanted by the position of its declaration, as the `try:` lines do.",
        example: b"error refactor.ambiguous-local: crate::total::x is several locals (shadowing); name one by its position\n\
            try: volec refactor rename main.vl:7:9 y\ntry: volec refactor rename main.vl:9:13 y",
    },
    Explain {
        code: b"refactor.anchor", severity: b"error, exit 1",
        means: b"`refactor move --after|--before ITEM`: ITEM is not an item of the target module \
            with lines of its own (or it is one of the items moved).",
        fix: b"Name an item that stays in the target module (`query items MODULE` lists them).",
        example: b"error refactor.anchor: --after area: not an item of crate::geom with lines of its own \
            (a function, type, constant, static)\ntry: volec query items crate::geom",
    },
    Explain {
        code: b"refactor.clash", severity: b"error, exit 1",
        means: b"The new name (of a parameter, field or variant) is taken there.",
        fix: b"Choose another name; `query show` of the item shows the names it has.",
        example: b"error refactor.clash: 'y' is a field of crate::geom::P already",
    },
    Explain {
        code: b"refactor.closure", severity: b"error, exit 1",
        means: b"`extract-function` (0.14): NEW would take or give back a closure (or a value \
            holding one, `Map<I, F>`), whose type has no name to write in its signature.",
        fix: b"Extract the lines that make the closure too (the `try:` line starts at its `let`), \
            or the ones that use it after; or make the closure a named function.",
        example: b"error refactor.closure: lines 6-7 use 'scale', a closure made before them; a \
            closure's type has no name for NEW's signature\n\
            try: volec refactor extract-function crate::main --lines 5-7 --to step",
    },
    Explain {
        code: b"refactor.collision", severity: b"error, exit 1",
        means: b"`rename`, `move`, `new-module`, `move-module`: a name the item would take is \
            already a name in that module (renaming a local: in its scope).",
        fix: b"Rename one of them first (`refactor rename`), or move to another module.",
        example: b"error refactor.collision: 'area' is already a name in crate::shapes (fn crate::shapes::area)\n\
            try: volec query show crate::shapes::area",
    },
    Explain {
        code: b"refactor.constructed", severity: b"error, exit 1",
        means: b"`refactor variant --remove`: the variant is constructed somewhere.",
        fix: b"Change those places first (`query refs ENUM::VARIANT` lists them).",
        example: b"error refactor.constructed: crate::Shape::Dot is constructed at main.vl:12",
    },
    Explain {
        code: b"refactor.discriminant", severity: b"warning, exit 0",
        means: b"A removed variant renumbers the variants after it, and the enum is cast to an \
            integer somewhere.",
        fix: b"Check the casts (`query refs ENUM`), or give the variants explicit values.",
        example: b"warning refactor.discriminant: removing crate::Op::Nop renumbers 4 variants; Op is cast",
    },
    Explain {
        code: b"refactor.effects", severity: b"warning, exit 0",
        means: b"`refactor signature`: an argument that calls a function is removed or moved, so \
            its effects are lost or reordered.",
        fix: b"Look at the calls named; keep the call's effect in a `let` before the call if needed.",
        example: b"warning refactor.effects: an argument removed at main.vl:20 calls a function",
    },
    Explain {
        code: b"refactor.escapes", severity: b"error, exit 1",
        means: b"`extract-function`: a statement of the lines returns, defers, breaks or continues \
            out of them, or has a `?` (0.15: it returns when its operand is None or Err); \
            `inline`: the function returns early, or has a `?`.",
        fix: b"Extract fewer lines (the `try:` line gives the ones before it), or restructure the \
            function so that it ends with its value.",
        example: b"error refactor.escapes: line 14 returns from crate::run: out of lines 12-16, which NEW cannot do for its caller",
    },
    Explain {
        code: b"refactor.exists", severity: b"error, exit 1",
        means: b"`new-module`, `move-module`: the module (or its file) exists already.",
        fix: b"Use the module that is there, or choose another path.",
        example: b"error refactor.exists: crate::geom exists already",
    },
    Explain {
        code: b"refactor.extern", severity: b"error, exit 1",
        means: b"`refactor signature` of a C function (`extern \"C\"`): its signature is C's.",
        fix: b"Change the C side and its declaration by hand (`edit replace`).",
        example: b"error refactor.extern: crate::c::printf is a C function",
    },
    Explain {
        code: b"refactor.fits", severity: b"note, exit 0",
        means: b"`refactor split --plan`: the module has at most N lines already.",
        fix: b"Nothing to split.",
        example: b"note refactor.fits: crate::geom has 120 lines (at most 1000)",
    },
    Explain {
        code: b"refactor.fn-value", severity: b"error, exit 1",
        means: b"`refactor signature`: the function is used as a value (its type would change).",
        fix: b"Change the uses as a value first (`query refs FN`).",
        example: b"error refactor.fn-value: crate::cmp is used as a value at main.vl:30",
    },
    Explain {
        code: b"refactor.generic", severity: b"error, exit 1",
        means: b"`extract-function`, `inline`: the function is generic (its body is checked once \
            per instance), or has no body.",
        fix: b"Make the change by hand (`edit replace`, `edit patch`).",
        example: b"error refactor.generic: crate::max is generic: its body is checked once per instance",
    },
    Explain {
        code: b"refactor.if-let", severity: b"error, exit 1",
        means: b"`refactor variant --remove`: an `if let` or `while let` matches the variant.",
        fix: b"Rewrite that `if let` first (`query refs ENUM::VARIANT`).",
        example: b"error refactor.if-let: crate::Shape::Dot is matched by an if let at main.vl:40",
    },
    Explain {
        code: b"refactor.inline", severity: b"error, exit 1",
        means: b"The module is an inline `mod m { }`, which has no file to move.",
        fix: b"Move its items with `refactor move PATH... --to MODULE` instead.",
        example: b"error refactor.inline: crate::util is an inline module",
    },
    Explain {
        code: b"refactor.internal", severity: b"error, exit 1",
        means: b"The refactoring's edits overlap: a case it does not handle. Nothing was written.",
        fix: b"Make the change in smaller steps (one item at a time), and report the case.",
        example: b"error refactor.internal: the edits overlap (a case the refactoring does not handle); nothing written",
    },
    Explain {
        code: b"refactor.kind", severity: b"error, exit 1",
        means: b"NAME is not of the kind the refactoring changes (`signature`: a function; `field`: \
            a struct; `variant`: an enum).",
        fix: b"Check NAME with `query def`.",
        example: b"error refactor.kind: crate::geom::P is a struct, not a function\ntry: volec query def P",
    },
    Explain {
        code: b"refactor.layout", severity: b"warning, exit 0",
        means: b"`refactor field` changes the layout of a `#[repr(C)]` struct, which C code may rely on.",
        fix: b"Change the C side to match, or leave the struct as it is.",
        example: b"warning refactor.layout: crate::Pt is #[repr(C)]: its layout changes",
    },
    Explain {
        code: b"refactor.nested", severity: b"error, exit 1",
        means: b"`refactor variant --remove`: the variant is matched inside another pattern.",
        fix: b"Rewrite that match first (`query show FILE:LINE`).",
        example: b"error refactor.nested: crate::Shape::Dot is matched inside a pattern at main.vl:44",
    },
    Explain {
        code: b"refactor.no-call", severity: b"error, exit 1",
        means: b"`refactor inline`: the function is not called (or not on the line --at names).",
        fix: b"Check the calls with `query callers FN`; give --at a line that calls it.",
        example: b"error refactor.no-call: crate::sq is not called on main.vl:12",
    },
    Explain {
        code: b"refactor.no-default", severity: b"error, exit 2",
        means: b"`--add` without a value, and calls or struct literals need one.",
        fix: b"Give the value: `--add 'x: i64 = 0'`.",
        example: b"error refactor.no-default: calls need a value for 'x'\n\
            try: volec refactor signature f --add 'x: i64 = 0'",
    },
    Explain {
        code: b"refactor.no-member", severity: b"error, exit 1",
        means: b"No such field or variant (the ones there are listed).",
        fix: b"Use one of the names listed; `query show` of the type shows them.",
        example: b"error refactor.no-member: crate::P has no field 'z' (x, y)",
    },
    Explain {
        code: b"refactor.made-module", severity: b"note, exit 0",
        means: b"`refactor move ... --to MODULE` (0.17): MODULE did not exist; it was made (its file \
            and its `mod` line, as `refactor new-module` makes them) in the same edit as the move.",
        fix: b"Nothing, when that module was meant; else `undo` takes both back.",
        example: b"note refactor.made-module: there was no module crate::util; it was made for the \
            move (refactor new-module)",
    },
    Explain {
        code: b"refactor.no-module", severity: b"error, exit 1",
        means: b"The module to move from (move-module, split) does not exist; `move --to` makes a \
            missing one (0.17).",
        fix: b"Check the path (`query items` lists the modules); `refactor new-module` makes one.",
        example: b"error refactor.no-module: no module crate::geom\ntry: volec refactor new-module crate::geom",
    },
    Explain {
        code: b"refactor.no-param", severity: b"error, exit 1",
        means: b"`refactor signature`: no such parameter (the ones there are listed).",
        fix: b"Use one of the names listed; `query def FN` shows the signature.",
        example: b"error refactor.no-param: crate::f has no parameter 'z' (a, b)",
    },
    Explain {
        code: b"refactor.no-site", severity: b"error, exit 1",
        means: b"`refactor variant --add --arm-in SITE EXPR` (0.14): SITE (a function, or \
            FILE:LINE) holds no match that needs an arm for the new variant (they are listed).",
        fix: b"Name one of the listed matches: the item it is in, or its FILE:LINE.",
        example: b"error refactor.no-site: --arm-in describe names no match on crate::Shape that \
            needs an arm; nothing written",
    },
    Explain {
        code: b"refactor.non-exhaustive", severity: b"error, exit 1",
        means: b"`refactor variant --add` without --arm, and matches need an arm for the new \
            variant (they are listed; with --arm-in, the ones none names).",
        fix: b"Give the arm's value with `--arm 'EXPR'` (every match), `--arm-in SITE 'EXPR'` \
            per match (SITE: the function it is in, or FILE:LINE; 0.14), or add a `_` arm.",
        example: b"error refactor.non-exhaustive: 2 matches on crate::Shape would not cover Ring\n\
            try: volec refactor variant Shape --add 'Ring(i64)' --arm-in area '0' \
            --arm-in name '\"ring\"'",
    },
    Explain {
        code: b"refactor.not-movable", severity: b"error, exit 1",
        means: b"`refactor move` of a method or a field: they move with their type.",
        fix: b"Move the type (its impl blocks go with it).",
        example: b"error refactor.not-movable: crate::geom::V2::len is a method: move crate::geom::V2",
    },
    Explain {
        code: b"refactor.operator", severity: b"error, exit 1",
        means: b"`refactor signature` of a function an operator calls (`a + b` calls \
            `<T as Add>::add`): the operator's signature is fixed.",
        fix: b"Leave it, or replace the operator uses by calls first.",
        example: b"error refactor.operator: <crate::V2 as Add>::add is called by an operator at main.vl:9",
    },
    Explain {
        code: b"refactor.plan", severity: b"note, exit 0",
        means: b"`refactor split --plan` printed a plan; the `try:` line makes it in one edit.",
        fix: b"Run the `try:` line (--auto), or give the parts with --into and --items.",
        example: b"note refactor.plan: the same in one edit: --auto\n\
            try: volec refactor split crate::check --auto --max-lines 1000",
    },
    Explain {
        code: b"refactor.range", severity: b"error, exit 1",
        means: b"`extract-function --lines A-B`: the lines are not inside the function's body, hold \
            no whole statement, or cut a statement.",
        fix: b"Give lines of whole statements of the body (`query show FN` prints the lines).",
        example: b"error refactor.range: line 13 has code outside the statements of lines 12-14",
    },
    Explain {
        code: b"refactor.receiver", severity: b"error, exit 1",
        means: b"`refactor inline` of a method: the receiver is borrowed and the method uses self \
            other than as self.f or self.m(...).",
        fix: b"Bind the receiver to a local first, then inline.",
        example: b"error refactor.receiver: the receiver on line 20 is borrowed, and crate::P::norm uses self other than as self.f or self.m(...): bind it to a local first",
    },
    Explain {
        code: b"refactor.recursive", severity: b"error, exit 1",
        means: b"`refactor inline`: the function calls itself.",
        fix: b"Inline by hand, or not at all.",
        example: b"error refactor.recursive: crate::fact calls itself, on line 5",
    },
    Explain {
        code: b"refactor.results", severity: b"error, exit 1",
        means: b"`extract-function`: the lines set more than one local used after them (or end the \
            block with its value and set one): the new function gives back one value.",
        fix: b"Extract fewer lines, or gather the results in a struct first.",
        example: b"error refactor.results: lines 12-15 set a, b, used after them; NEW gives back one local it assigns, or the ones it declares",
    },
    Explain {
        code: b"refactor.script", severity: b"error, exit 1 or 2",
        means: b"`refactor --script`: a line is no command, or a command failed; nothing was written.",
        fix: b"Fix that line (its number is given) and run the script again.",
        example: b"error refactor.script: line 3: unknown command 'renmae'",
    },
    Explain {
        code: b"refactor.self", severity: b"error, exit 1",
        means: b"`extract-function` in a trait impl's function: the lines use self, and the new \
            function cannot be a method of the trait.",
        fix: b"Extract lines that do not use self, or move the code to an inherent method first.",
        example: b"error refactor.self: lines 8-10 use self in a trait impl's function: NEW cannot be a method there",
    },
    Explain {
        code: b"refactor.trait", severity: b"error, exit 1",
        means: b"`refactor signature` of a trait's function, whose impls' parameters differ.",
        fix: b"Make the impls' parameters the same first, or change each by hand.",
        example: b"error refactor.trait: the impls of crate::Area::area have other parameters",
    },
    Explain {
        code: b"refactor.unchecked", severity: b"warning, exit 0",
        means: b"Calls in code the checker did not see (a generic function never instantiated) are \
            not changed.",
        fix: b"Look at those functions (named) and change their calls by hand.",
        example: b"warning refactor.unchecked: calls in 1 unchecked function are not changed: crate::g",
    },
    Explain {
        code: b"refactor.usage", severity: b"error, exit 2",
        means: b"The refactor command line is wrong: an unknown subcommand or option, a missing \
            NAME or value.",
        fix: b"Run the corrected command of the `try:` line (docs/refactor-shape.md, refactor-modules.md).",
        example: b"error refactor.usage: no command (rename, move, new-module, move-module, split, \
            signature, field, variant, --script)",
    },
    Explain {
        code: b"refactor.used", severity: b"error, exit 1",
        means: b"A parameter or field to remove is used (where is named).",
        fix: b"Remove the uses first (`query show FILE:LINE`, `query refs`).",
        example: b"error refactor.used: parameter 'b' of crate::f is used at main.vl:5\n\
            try: volec query show main.vl:5",
    },
    Explain {
        code: b"rewrite.bad-in", severity: b"error, exit 1",
        means: b"`rewrite --in` names no file or module of the program.",
        fix: b"Give a file's path (or its end) or a module, or drop --in.",
        example: b"error rewrite.bad-in: no file or module 'gnv' in the program",
    },
    Explain {
        code: b"rewrite.nested", severity: b"note, exit 0",
        means: b"Sites inside rewritten ones were left as they are.",
        fix: b"Run the rewrite again: they are rewritten then.",
        example: b"note rewrite.nested: 2 sites inside rewritten ones are left; run it again",
    },
    Explain {
        code: b"rewrite.dropped", severity: b"note, exit 0",
        means: b"Sites match, but the replacement leaves out a hole bound to a name (`for $i in`, \
            `let $x =`) that the code it keeps still uses; they are left as they are.",
        fix: b"Rewrite those sites by hand, or keep the hole in the replacement.",
        example: b"note rewrite.dropped: 1 site is left: the replacement drops $i, which the code \
            it keeps uses; first: main.vl:12:20\ntry: volec query show main.vl:12",
    },
    Explain {
        code: b"rewrite.imports", severity: b"note, exit 0",
        means: b"The rewrite left names of `use` lines unused (0.17: the calls of a helper rewritten \
            away): they were removed in the same edit.",
        fix: b"Nothing; `fix --only unused` would have done the same.",
        example: b"note rewrite.imports: removed 1 import the rewrite left unused",
    },
    Explain {
        code: b"rewrite.none", severity: b"note, exit 0",
        means: b"Nothing matches the pattern.",
        fix: b"Check the pattern (`$x` holes, `$xs...` for lists) and --where's types.",
        example: b"note rewrite.none: nothing matches 'grow($v, $n)'",
    },
    Explain {
        code: b"rewrite.pattern", severity: b"error, exit 2",
        means: b"The pattern or the replacement does not parse, is a hole alone, or has `$x...` \
            outside a list (arguments, a tuple, an array, a block's statements).",
        fix: b"Write an expression or statement with holes (`$v.reserve($n)`).",
        example: b"error rewrite.pattern: the pattern is a hole alone: it would match every expression",
    },
    Explain {
        code: b"rewrite.types",
        severity: b"note, exit 0",
        means: b"Sites match but for --where's types; the type found is given.",
        fix: b"Run the `try:` line with the type found, if it is the one meant.",
        example: b"note rewrite.types: 1 site matches but for --where; first: $v is &mut Vec<i64, Gpa> at main.vl:9:10\n\
            try: volec rewrite 'grow($v, $n)' '$v.reserve($n)' --where '$v: &mut Vec<i64, Gpa>' --dry-run main.vl",
    },
    Explain {
        code: b"rewrite.unbound", severity: b"error, exit 2",
        means: b"A hole of the replacement is not in the pattern, and the replacement does not \
            bind a new name with it (0.16: `for $x in`, `let $x =` make `$x` a new name, `x`, or \
            `x2`... where the item has an `x`); or a --subst replacement's hole is in neither.",
        fix: b"Use the pattern's holes in the replacement, or bind the new name in it.",
        example: b"error rewrite.unbound: the replacement's $d is not in the pattern, and the \
            replacement binds no name with it (`for $x in`, `let $x =`)",
    },
    Explain {
        code: b"rewrite.untyped", severity: b"note, exit 0",
        means: b"Sites in code the checker did not see (never instantiated generics) were not \
            matched.",
        fix: b"Look at those functions and rewrite them by hand if needed.",
        example: b"note rewrite.untyped: 1 unchecked function not searched: crate::g",
    },
    Explain {
        code: b"rewrite.usage", severity: b"error, exit 2",
        means: b"The rewrite command line is wrong: no PATTERN or REPLACEMENT, a bad --where.",
        fix: b"`volec rewrite 'PATTERN' 'REPLACEMENT' [--where '$x: TYPE'] [--in X] [--dry-run]`.",
        example: b"error rewrite.usage: a PATTERN and a REPLACEMENT are needed",
    },
    Explain {
        code: b"rewrite.where",
        severity: b"note (after edit.breaks)",
        means: b"The rewrite was refused (edit.breaks) and a hole has several types at the sites (0.17): \
            the replacement may fit some of them only.",
        fix: b"Run the `try:` line with the --where of the types the replacement fits.",
        example: b"note rewrite.where: $v has 2 types at the sites: Vec<i64,Gpa> (1 site), String<Gpa> (1 site); --where takes the ones the replacement fits\n\
            try: volec rewrite '$v.len() == 0' '$v.as_str().is_empty()' main.vl --where '$v: Vec<i64,Gpa>'\n\
            try: volec rewrite '$v.len() == 0' '$v.as_str().is_empty()' main.vl --where '$v: String<Gpa>'",
    },
    Explain {
        code: b"tokenizer error", severity: b"error (compiler)",
        means: b"The text does not lex: an unterminated string or comment, a newline in a string, \
            an unknown character, a bad escape or number.",
        fix: b"Fix the text at the position given; nothing after it was read.",
        example: b"main.vl:3:17: error[tokenizer error] newline in string literal",
    },
    Explain {
        code: b"parser error", severity: b"error (compiler)",
        means: b"The tokens are not the grammar's (docs/grammar.md): a missing `;` or bracket, a \
            keyword out of place.",
        fix: b"Fix the syntax at the position given; the parser goes on after it, so later errors \
            may follow from it.",
        example: b"main.vl:4:5: error[parser error] expected ';', got 'let'",
    },
    Explain {
        code: b"module error", severity: b"error (compiler)",
        means: b"The module tree cannot be made: a `mod m;` without m.vl or m/mod.vl, a \
            wildcard import, a module cycle.",
        fix: b"Make the file: the error's try: line (0.17) is the `volec edit new-file` that \
            does, its text on stdin; a `mod` line for a file next to a submodule goes in the root. \
            `volec fix --only imports` rewrites wildcards.",
        example: b"main.vl:1:5: error[module error] cannot find the file of module 'nothere' | help: \
            looked for nothere.vl and nothere/mod.vl: write the file (`edit new-file` takes its \
            text on stdin) | try: volec edit new-file nothere.vl main.vl",
    },
    Explain {
        code: b"type error", severity: b"error (compiler)",
        means: b"The program is not well typed, or names something that is not there or not \
            visible: an undefined name, a private item, a wrong type or argument count.",
        fix: b"Read the message and its help, and use its try: lines (0.17) as they are: code to \
            paste (a conversion, the missing match arms, std's function for a method, a `use` \
            line), or a command to run (`volec fix --only imports|pub|alloc016 ROOT`, `volec \
            edit delete FILE:LINE` for a duplicate, `volec query items TYPE` for a type's \
            methods); VALUE in one is yours to fill in.",
        example: b"main.vl:4:5: error[type error] undefined variable 'cout' | help: std's names: \
            `volec guide std`",
    },
    Explain {
        code: b"C import", severity: b"error (compiler)",
        means: b"`import \"h.h\" as c;`: the header cannot be found or read, or has what the C \
            importer does not take.",
        fix: b"Check the header's name and -I directories; declare what is needed in an `extern \
            \"C\" { }` block instead.",
        example: b"main.vl:1:8: error[C import] header not found: nothere.h",
    },
    Explain {
        code: b"unsafe",
        severity: b"error (compiler)",
        means: b"An unsafe operation (a raw pointer's dereference or indexing, a C call, a union field, a \
            `static mut`) outside unsafe code.",
        fix: b"Put it in an `unsafe { }` block, or the function in `unsafe fn`; the try: line, `volec \
            fix --only unsafe ROOT`, wraps every such place (the check hook prints it once, with how \
            many errors it answers). A raw pointer parameter that only reads or writes one value: \
            take a reference, `x: &T`, or `x: &mut T` when written through, and keep `*const T` and \
            `*mut T` for what stays raw (indexed, compared, cast, stored, given to C).",
        example: b"fn first(p: *const i64) -> i64 {\n\
            \x20   *p\n\
            }\n\
            \n\
            fn main() {\n\
