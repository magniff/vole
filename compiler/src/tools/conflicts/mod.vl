// Merge conflicts in a program's files (0.15; docs/refactor.md, "Merge
// conflicts"), read as text, so that they work on a tree that does not
// parse:
//
//   volec query conflicts [FILE|DIR|FILE:LINE...] [--show] [--root R]
//   volec edit resolve FILE:LINE|FILE|NAME --ours|--theirs|--both|--base
//       [--all] [--in FILE] [--dry-run] [--show]
//   volec edit resolve TARGET < TEXT
//
// A region is git's: `<<<<<<< LABEL`, our lines, (diff3: `||||||| LABEL`,
// the base's lines,) `=======`, their lines, `>>>>>>> LABEL`. Its item is
// found from the text: the items whose header lines the region has (`fn
// f`, `struct S`, `use` lines; a method as `T::m`), else the item around
// it (the nearest header above it that is less indented), else, for
// comments at the top level, the item after it; `-` when none.
//
// Without a FILE, the files are the .vl files with conflict markers
// under the root's directory (`grep -rl`). A resolve writes each file
// whole (a copy, renamed onto it), is journaled for `undo`, and, when no
// markers are left, checks the program and prints its errors.

pub mod resolve;

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_bufs, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_WORD, Leaf, flag, is_flag, is_opt, option, table};
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, read_file_if, run_capture, same_bytes};
use crate::tools::query::{c_slice, file_line, find_root};
use crate::tools::query::diagnostics::{diag, diags, put_cword, put_word, try_end};

// ---- Files and regions ----

// File `path` read, its regions found: its index, or -1 after the
// diagnostic.
fn read_source(path0: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut path = path0;
        while (*path.add(0)) == b'.' && (*path.add(1)) == b'/' {
            path = path.add(2);
        }
        for f in 0..tcx.f_path.count {
            if streq((*tcx.f_path.data.add(f as usize)) as *mut u8, path) {
                return f;
            }
        }
        let text = buf_new();
        if !read_file_if(path, text) {
            let d = diag(c"error", c"query.no-file", tcx);
            buf_str(d, c"cannot read '");
            buf_str(d, path);
            buf_str(d, c"'\n");
            return -1;
        }
        tcx.f_path.push(path as i64);
        tcx.f_text.push(text);
        tcx.f_l0.push(tcx.conflicts_ls.count);
        let t = buf_slice(text);
        let mut n: i64 = 0;
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            tcx.conflicts_ls.push(i);
            n += 1;
            while i < t.len() as i64 && t[i as usize] != b'\n' {
                i += 1;
            }
            i += 1;
        }
        tcx.f_nl.push(n);
        tcx.f_scanned.push(0);
        let f = tcx.f_path.count - 1;
        if !scan(f, tcx, pcx) {
            return -1;
        }
        f
    }
}

// The path of a file: its C string's text (`tcx.f_path.get(f)`). A view of
// the string itself, never freed or written, not of tcx (src-buffer.md,
// views of other storage).
fn path_of(p: i64) -> &'static [u8] {
    // UNSAFE: tcx keeps each path as a word, the address of its C string
    // SAFETY: p is a word of tcx.f_path: a NUL-ended path, never freed or
    // written while the tool runs
    unsafe { c_slice(p as *mut u8) }
}

// Line n (from 1) of file f, without its newline.
fn line(f: i64, n: i64, tcx: &Tcx<Comp>) -> &[u8] {
    unsafe {
        let t = buf_slice((*tcx.f_text.data.add(f as usize)));
        let s = (*tcx.conflicts_ls.data.add(((*tcx.f_l0.data.add(f as usize)) + n - 1) as usize));
        let mut e = s;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        if e > s && t[(e - 1) as usize] == b'\r' {
            e -= 1;
        }
        &t[s as usize..e as usize]
    }
}

// Where line n of file f starts (one past its last line: its end).
fn line_pos(f: i64, n: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        if n > (*tcx.f_nl.data.add(f as usize)) {
            return (*get_bufs().add((*tcx.f_text.data.add(f as usize)) as usize)).len;
        }
        (*tcx.conflicts_ls.data.add(((*tcx.f_l0.data.add(f as usize)) + n - 1) as usize))
    }
}

// Whether l is a marker line of byte m (seven of it; `=======` alone).
fn marker(l: &[u8], m: u8) -> bool {
    if l.len() < 7 {
        return false;
    }
    for i in 0..7 {
        if l[i as usize] != m {
            return false;
        }
    }
    if m == b'=' {
        for i in 7..l.len() {
            if l[i] != b' ' && l[i] != b'\t' {
                return false;
            }
        }
        return true;
    }
    l.len() == 7 || l[7] == b' '
}

fn any_marker(l: &[u8]) -> bool {
    marker(l, b'<') || marker(l, b'|') || marker(l, b'=') || marker(l, b'>')
}

// A marker line's label (`HEAD`, a branch).
fn label(l: &[u8]) -> &[u8] {
    if l.len() > 8 { &l[8..l.len()] } else { &l[0..0] }
}

// The regions of file f. False after the diagnostic.
fn scan(f: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if (*tcx.f_scanned.data.add(f as usize)) != 0 {
            return true;
        }
        (*tcx.f_scanned.data.add(f as usize)) = 1;
        let mut state: i64 = 0;
        let mut start: i64 = 0;
        let mut base: i64 = -1;
        let mut sep: i64 = 0;
        for n in 1..(*tcx.f_nl.data.add(f as usize)) + 1 {
            let l = line(f, n, tcx);
            if marker(l, b'<') {
                if state != 0 {
                    return format_error(f, n, c"a <<<<<<< line inside the region of line ", start,
                        tcx, pcx);
                }
                state = 1;
                start = n;
                base = -1;
            } else if marker(l, b'|') && state == 1 {
                state = 2;
                base = n;
            } else if marker(l, b'=') && (state == 1 || state == 2) {
                state = 3;
                sep = n;
            } else if marker(l, b'>') {
                if state != 3 {
                    return format_error(f, n,
                        c"a >>>>>>> line without its <<<<<<< and ======= lines", -1, tcx, pcx);
                }
                tcx.r_file.push(f);
                tcx.conflicts_r_start.push(start);
                tcx.r_base.push(base);
                tcx.r_sep.push(sep);
                tcx.conflicts_r_end.push(n);
                tcx.r_items.push(region_items(tcx.r_file.count - 1, tcx));
                state = 0;
            }
        }
        if state != 0 {
            return format_error(f, start, c"a region without its >>>>>>> line", -1, tcx, pcx);
        }
        true
    }
}

fn format_error(f: i64, n: i64, message: *mut u8, other: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let d = diag(c"error", c"conflict.format", tcx);
    buf_bytes(d, path_of(tcx.f_path.get(f)));
    buf_byte(d, b':');
    buf_int(d, n);
    buf_str(d, c": ");
    buf_str(d, message);
    if other >= 0 {
        buf_int(d, other);
    }
    buf_str(d, c"; fix the markers by hand\n");
    let out = try_start(tcx, pcx);
    buf_str(out, c" query text");
    let w = buf_new();
    buf_bytes(w, path_of(tcx.f_path.get(f)));
    buf_byte(w, b':');
    buf_int(w, if n > 5 { n - 5 } else { 1 });
    buf_byte(w, b'-');
    buf_int(w, n + 5);
    put_word(out, buf_slice(w));
    try_end(out);
    false
}

// `try: PROG`; the words follow, then try_end.
fn try_start(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    out
}

// ---- The items of a region ----

fn indent(l: &[u8]) -> i64 {
    let mut i: i64 = 0;
    while i < l.len() as i64 && (l[i as usize] == b' ' || l[i as usize] == b'\t') {
        i += 1;
    }
    i
}

fn blank(l: &[u8]) -> bool {
    indent(l) == l.len() as i64
}

fn comment(l: &[u8]) -> bool {
    let i = indent(l);
    i + 1 < l.len() as i64
        && ((l[i as usize] == b'/' && l[(i + 1) as usize] == b'/')
            || (l[i as usize] == b'#' && l[(i + 1) as usize] == b'['))
}

fn is_ident(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// Where word w ends when l has it at i (then a blank, `<`, `{` or `(`), or -1.
fn word_at(l: &[u8], i: i64, w: *mut u8) -> i64 {
    unsafe {
        let mut k: i64 = 0;
        while (*w.add(k as usize)) != 0 {
            if i + k >= l.len() as i64 || l[(i + k) as usize] != (*w.add(k as usize)) {
                return -1;
            }
            k += 1;
        }
        let e = i + k;
        if e < l.len() as i64 && l[e as usize] != b' ' && l[e as usize] != b'<'
            && l[e as usize] != b'{' && l[e as usize] != b'(' {
            return -1;
        }
        e
    }
}

// The identifier at or after the blanks at i, into out: whether there is one.
fn ident_into(l: &[u8], i0: i64, out: i64) -> bool {
    let mut i = i0;
    while i < l.len() as i64 && l[i as usize] == b' ' {
        i += 1;
    }
    let s = i;
    while i < l.len() as i64 && is_ident(l[i as usize]) {
        i += 1;
    }
    if i == s {
        return false;
    }
    buf_bytes(out, &l[s as usize..i as usize]);
    true
}

// Whether line l is an item's header: 0 no, 1 an item, 2 an impl or a
// trait (a container of methods), 3 `use` lines; its name into out.
fn header(l: &[u8], out: i64) -> i64 {
    let mut i = indent(l);
    let p = word_at(l, i, c"pub");
    if p >= 0 {
        let mut j = p;
        if j < l.len() as i64 && l[j as usize] == b'(' {
            while j < l.len() as i64 && l[j as usize] != b')' {
                j += 1;
            }
            j += 1;
        }
        while j < l.len() as i64 && l[j as usize] == b' ' {
            j += 1;
        }
        i = j;
    }
    let u = word_at(l, i, c"unsafe");
    if u >= 0 && word_at(l, u + 1, c"fn") >= 0 {
        i = u + 1;
    }
    if word_at(l, i, c"use") >= 0 {
        buf_str(out, c"use");
        return 3;
    }
    let mut e = word_at(l, i, c"impl");
    if e >= 0 {
        // `impl<T> Trait for Type`: Type; `impl Type`: Type
        if e < l.len() as i64 && l[e as usize] == b'<' {
            let mut depth: i64 = 0;
            while e < l.len() as i64 {
                if l[e as usize] == b'<' {
                    depth += 1;
                } else if l[e as usize] == b'>' {
                    depth -= 1;
                    if depth == 0 {
                        e += 1;
                        break;
                    }
                }
                e += 1;
            }
        }
        let mut k = e;
        while k + 5 <= l.len() as i64 {
            if l[k as usize] == b' ' && l[(k + 1) as usize] == b'f' && l[(k + 2) as usize] == b'o'
                && l[(k + 3) as usize] == b'r'
                && l[(k + 4) as usize] == b' ' {
                e = k + 5;
                break;
            }
            k += 1;
        }
        return if ident_into(l, e, out) { 2 } else { 0 };
    }
    e = word_at(l, i, c"trait");
    if e >= 0 {
        return if ident_into(l, e, out) { 2 } else { 0 };
    }
    e = word_at(l, i, c"fn");
    if e < 0 {
        e = word_at(l, i, c"struct");
    }
    if e < 0 {
        e = word_at(l, i, c"enum");
    }
    if e < 0 {
        e = word_at(l, i, c"union");
    }
    if e < 0 {
        e = word_at(l, i, c"type");
    }
    if e < 0 {
        e = word_at(l, i, c"mod");
    }
    if e < 0 {
        e = word_at(l, i, c"const");
    }
    if e < 0 {
        e = word_at(l, i, c"static");
        if e >= 0 {
            while e < l.len() as i64 && l[e as usize] == b' ' {
                e += 1;
            }
            let m = word_at(l, e, c"mut");
            if m >= 0 {
                e = m;
            }
        }
    }
    if e < 0 {
        return 0;
    }
    if ident_into(l, e, out) { 1 } else { 0 }
}

// The name of the item whose header is line n of file f (its name in
// `name`), into out: `T::m` for a method (an impl or trait header less
// indented above it).
fn qualified(f: i64, n: i64, name: i64, out: i64, tcx: &Tcx<Comp>) {
    let ind = indent(line(f, n, tcx));
    if ind > 0 {
        let mut m = n - 1;
        while m >= 1 {
            let l = line(f, m, tcx);
            if !blank(l) && !comment(l) && !any_marker(l) && indent(l) < ind {
                let b = buf_new();
                if header(l, b) == 2 {
                    buf_bytes(out, buf_slice(b));
                    buf_str(out, c"::");
                }
                break;
            }
            m -= 1;
        }
    }
    buf_bytes(out, buf_slice(name));
}

// Name q added to the list in out (`a, b`) unless it is there.
fn add_name(out: i64, q: &[u8]) {
    let t = buf_slice(out);
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        let mut e = i;
        while e < t.len() as i64 && t[e as usize] != b',' {
            e += 1;
        }
        if same_bytes(&t[i as usize..e as usize], q) {
            return;
        }
        i = e + 2;
    }
    if t.len() > 0 {
        buf_str(out, c", ");
    }
    buf_bytes(out, q);
}

// The items of region r (a buffer, `a, b`; `-` when none is found).
fn region_items(r: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let f = (*tcx.r_file.data.add(r as usize));
        let start = (*tcx.conflicts_r_start.data.add(r as usize));
        let end = (*tcx.conflicts_r_end.data.add(r as usize));
        let out = buf_new();
        let mut first: i64 = -1;
        let mut notes = true;
        for n in start + 1..end {
            let l = line(f, n, tcx);
            if any_marker(l) || blank(l) {
                continue;
            }
            if first < 0 {
                first = indent(l);
            }
            if !comment(l) {
                notes = false;
            }
            let b = buf_new();
            if header(l, b) != 0 {
                let q = buf_new();
                qualified(f, n, b, q, tcx);
                add_name(out, buf_slice(q));
            }
        }
        if (*get_bufs().add(out as usize)).len > 0 {
            return out;
        }
        if first > 0 {
            // (the item around it: a less indented header above)
            let mut ind = first;
            let mut m = start - 1;
            while m >= 1 {
                let l = line(f, m, tcx);
                if !blank(l) && !comment(l) && !any_marker(l) && indent(l) < ind {
                    let b = buf_new();
                    if header(l, b) != 0 {
                        qualified(f, m, b, out, tcx);
                        return out;
                    }
                    ind = indent(l);
                    if ind == 0 {
                        break;
                    }
                }
                m -= 1;
            }
        } else if notes {
            // (comments at the top level: the item after them)
            let mut m = end + 1;
            while m <= (*tcx.f_nl.data.add(f as usize)) {
                let l = line(f, m, tcx);
                if !blank(l) && !comment(l) {
                    let b = buf_new();
                    if indent(l) == 0 && header(l, b) != 0 {
                        qualified(f, m, b, out, tcx);
                        return out;
                    }
                    break;
                }
                m += 1;
            }
        }
        buf_byte(out, b'-');
        out
    }
}

// Whether NAME names one of region r's items: the same, or one ends the
// other after `::`.
fn names_item(r: i64, name: &[u8], tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let t = buf_slice((*tcx.r_items.data.add(r as usize)));
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != b',' {
                e += 1;
            }
            let item = &t[i as usize..e as usize];
            if same_bytes(item, name) || ends_path(item, name) || ends_path(name, item) {
                return true;
            }
            i = e + 2;
        }
        false
    }
}

// Whether a is `...::b`.
fn ends_path(a: &[u8], b: &[u8]) -> bool {
    a.len() as i64 > b.len() as i64 + 2
        && same_bytes(&a[(a.len() as i64 - b.len() as i64) as usize..], b)
        && a[(a.len() as i64 - b.len() as i64 - 1) as usize] == b':'
        && a[(a.len() as i64 - b.len() as i64 - 2) as usize] == b':'
}

// ---- Finding the files ----

// The .vl files with a `<<<<<<<` line under dir (C strings), sorted.
fn conflicted_files(dir: *mut u8, out: &mut IntVec) {
    unsafe {
        let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        args.push(c"grep" as i64);
        args.push(c"-rl" as i64);
        args.push(c"--include=*.vl" as i64);
        args.push(c"--include=*.vl" as i64);
        args.push(c"-e" as i64);
        args.push(c"^<<<<<<<" as i64);
        args.push(dir as i64);
        args.push(0);
        let b = buf_new();
        run_capture(args.data as *mut *mut u8, b);
        let t = buf_slice(b);
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            let mut s = i;
            while s + 1 < e && t[s as usize] == b'.' && t[(s + 1) as usize] == b'/' {
                s += 2;
            }
            if crate::base::source_ext_len(&t[s as usize..e as usize]) > 0 {
                let p = buf_new();
                buf_bytes(p, &t[s as usize..e as usize]);
                out.push(buf_cstr(p) as i64);
            }
            i = e + 1;
        }
        // (sorted: grep lists them in the directory's order)
        let v = out.data;
        for k in 1..out.count {
            let mut j = k;
            while j > 0
                && less(c_slice((*v.add(j as usize)) as *mut u8),
                    c_slice((*v.add((j - 1) as usize)) as *mut u8)) {
                let x = (*v.add(j as usize));
                (*v.add(j as usize)) = (*v.add((j - 1) as usize));
                (*v.add((j - 1) as usize)) = x;
                j -= 1;
            }
        }
    }
}

fn less(a: &[u8], b: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < a.len() as i64 && i < b.len() as i64 {
        if a[i as usize] != b[i as usize] {
            return a[i as usize] < b[i as usize];
        }
        i += 1;
    }
    a.len() < b.len()
}

// The directory searched without a FILE: the root's (`.` without one).
fn default_dir(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    let root = find_root(tcx.root_given, pcx);
    if root == 0 as *mut u8 {
        return c".";
    }
    let s = c_slice(root);
    let mut i = s.len() as i64;
    while i > 0 && s[(i - 1) as usize] != b'/' {
        i -= 1;
    }
    if i <= 1 {
        return if i == 1 { c"/" } else { c"." };
    }
    let b = buf_new();
    buf_bytes(b, &s[0..(i - 1) as usize]);
    buf_cstr(b)
}

// The files under dir, read. False after a diagnostic.
fn read_dir(dir: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    conflicted_files(dir, &mut files);
    for k in 0..files.count {
        if unsafe { read_source((*files.data.add(k as usize)) as *mut u8, tcx, pcx) < 0 } {
            return false;
        }
    }
    true
}

// TARGET `FILE` or `FILE:LINE` (a .vl file): its regions (with a line,
// the one holding it) into sel. 1 when it is no file, 2 after a
// diagnostic, 0 done.
fn file_target(arg: *mut u8, sel: &mut IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let a = c_slice(arg);
        let mut ln: i64 = -1;
        let mut n = file_line(a, &mut ln);
        if n < 0 {
            n = a.len() as i64;
            ln = -1;
        }
        if crate::base::source_ext_len(&a[0..n as usize]) == 0 {
            return 1;
        }
        let p = buf_new();
        buf_bytes(p, &a[0..n as usize]);
        let f = read_source(buf_cstr(p), tcx, pcx);
        if f < 0 {
            return 2;
        }
        let mut found = false;
        for r in 0..tcx.r_file.count {
            if (*tcx.r_file.data.add(r as usize)) == f
                && (ln < 0
                    || ((*tcx.conflicts_r_start.data.add(r as usize)) <= ln
                        && ln <= (*tcx.conflicts_r_end.data.add(r as usize)))) {
                add_region(sel, r);
                found = true;
            }
        }
        if !found && ln >= 0 {
            let d = diag(c"error", c"conflict.none", tcx);
            buf_str(d, c"no conflict region holds ");
            buf_bytes(d, path_of(tcx.f_path.get(f)));
            buf_byte(d, b':');
            buf_int(d, ln);
            buf_byte(d, b'\n');
            let out = try_start(tcx, pcx);
            buf_str(out, c" query conflicts");
            put_word(out, path_of(tcx.f_path.get(f)));
            try_end(out);
            return 2;
        }
        0
    }
}

fn add_region(sel: &mut IntVec, r: i64) {
    for k in 0..sel.count {
        if unsafe { (*sel.data.add(k as usize)) == r } {
            return;
        }
    }
    sel.push(r);
}

// ---- query conflicts ----

fn put_lines(out: i64, n: i64) {
    buf_int(out, n);
    buf_str(out, if n == 1 { c" line" } else { c" lines" });
}

fn put_side(out: i64, f: i64, side: *mut u8, marker_line: i64, n: i64, tcx: &Tcx<Comp>) {
    buf_str(out, side);
    buf_byte(out, b' ');
    put_lines(out, n);
    let lab = label(line(f, marker_line, tcx));
    if lab.len() > 0 {
        buf_str(out, c" (");
        buf_bytes(out, lab);
        buf_byte(out, b')');
    }
}

// The lines of the sides of region r: ours [a, b], base, theirs.
fn ours_end(r: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        if (*tcx.r_base.data.add(r as usize)) >= 0 { (*tcx.r_base.data.add(r as usize)) }
        else { (*tcx.r_sep.data.add(r as usize)) }
    }
}

// `FILE:A-B<TAB>ITEMS<TAB>ours N lines (LABEL)[<TAB>base ...]<TAB>theirs ...`
fn put_region(out: i64, r: i64, tcx: &Tcx<Comp>) {
    unsafe {
        let f = (*tcx.r_file.data.add(r as usize));
        let s = (*tcx.conflicts_r_start.data.add(r as usize));
        buf_bytes(out, path_of(tcx.f_path.get(f)));
        buf_byte(out, b':');
        buf_int(out, s);
        buf_byte(out, b'-');
        buf_int(out, (*tcx.conflicts_r_end.data.add(r as usize)));
        buf_byte(out, b'\t');
        buf_bytes(out, buf_slice((*tcx.r_items.data.add(r as usize))));
        buf_byte(out, b'\t');
        put_side(out, f, c"ours", s, ours_end(r, tcx) - s - 1, tcx);
        if (*tcx.r_base.data.add(r as usize)) >= 0 {
            buf_byte(out, b'\t');
            put_side(out, f, c"base", (*tcx.r_base.data.add(r as usize)),
                (*tcx.r_sep.data.add(r as usize)) - (*tcx.r_base.data.add(r as usize)) - 1, tcx);
        }
        buf_byte(out, b'\t');
        put_side(out, f, c"theirs", (*tcx.conflicts_r_end.data.add(r as usize)),
            (*tcx.conflicts_r_end.data.add(r as usize)) - (*tcx.r_sep.data.add(r as usize)) - 1,
            tcx);
        buf_byte(out, b'\n');
    }
}

// One side's lines a..b (excluded) of file f, under `// SIDE (LABEL), lines A-B:`.
fn show_side(out: i64, f: i64, side: *mut u8, marker_line: i64, a: i64, b: i64, tcx: &Tcx<Comp>) {
    buf_str(out, c"// ");
    buf_str(out, side);
    let lab = label(line(f, marker_line, tcx));
    if lab.len() > 0 {
        buf_str(out, c" (");
        buf_bytes(out, lab);
        buf_byte(out, b')');
    }
    if a >= b {
        buf_str(out, c": no lines\n");
        return;
    }
    buf_str(out, if a + 1 == b { c", line " } else { c", lines " });
    buf_int(out, a);
    if a + 1 < b {
        buf_byte(out, b'-');
        buf_int(out, b - 1);
    }
    buf_str(out, c":\n");
    for n in a..b {
        buf_bytes(out, line(f, n, tcx));
        buf_byte(out, b'\n');
    }
}

fn show_region(out: i64, r: i64, tcx: &Tcx<Comp>) {
    unsafe {
        let f = (*tcx.r_file.data.add(r as usize));
        let s = (*tcx.conflicts_r_start.data.add(r as usize));
        buf_str(out, c"// ");
        buf_bytes(out, path_of(tcx.f_path.get(f)));
        buf_byte(out, b':');
        buf_int(out, s);
        buf_byte(out, b'-');
        buf_int(out, (*tcx.conflicts_r_end.data.add(r as usize)));
        buf_byte(out, b'\t');
        buf_bytes(out, buf_slice((*tcx.r_items.data.add(r as usize))));
        buf_byte(out, b'\n');
        show_side(out, f, c"ours", s, s + 1, ours_end(r, tcx), tcx);
        if (*tcx.r_base.data.add(r as usize)) >= 0 {
            show_side(out, f, c"base", (*tcx.r_base.data.add(r as usize)),
                (*tcx.r_base.data.add(r as usize)) + 1, (*tcx.r_sep.data.add(r as usize)), tcx);
        }
        show_side(out, f, c"theirs", (*tcx.conflicts_r_end.data.add(r as usize)),
            (*tcx.r_sep.data.add(r as usize)) + 1, (*tcx.conflicts_r_end.data.add(r as usize)),
            tcx);
    }
}

// `query conflicts`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn conflicts_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(flag("show", "each region's sides"));
    opts.push(option("root", "R", "the program's root file"));
    Leaf::new(opts, "path")
}

// `volec query conflicts [FILE|DIR|FILE:LINE...] [--show] [--root R]`:
// the exit status (the diagnostics are written by run_query).
pub fn run_conflicts(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    tcx.tool = 0 as *mut u8;
    let mut show = false;
    let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if is_flag(ev, "show") {
            show = true;
        } else if is_opt(ev, "root") {
            tcx.root_given = a;
        } else if ev.kind != EV_WORD || ev.text.starts_with("--") {
            let d = diag(c"error", c"query.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, a);
            buf_str(d, c"' of query conflicts (--show, --root)\n");
            let out = try_start(tcx, pcx);
            buf_str(out, c" query conflicts --show");
            try_end(out);
            return 2;
        } else {
            args.push(a as i64);
        }
    }
    unsafe {
        let mut sel = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if args.count == 0 {
            if !read_dir(default_dir(tcx, pcx), tcx, pcx) {
                return 1;
            }
            for r in 0..tcx.r_file.count {
                sel.push(r);
            }
        }
        for k in 0..args.count {
            let a = (*args.data.add(k as usize)) as *mut u8;
            let t = file_target(a, &mut sel, tcx, pcx);
            if t == 2 {
                return 1;
            }
            if t == 1 {
                let before = tcx.r_file.count;
                if !read_dir(a, tcx, pcx) {
                    return 1;
                }
                for r in before..tcx.r_file.count {
                    add_region(&mut sel, r);
                }
            }
        }
        if sel.count == 0 {
            let d = diag(c"note", c"conflict.none", tcx);
            buf_str(d, c"no conflict markers in ");
            if args.count == 0 {
                buf_str(d, c"the .vl files under ");
                buf_str(d, default_dir(tcx, pcx));
            } else {
                for k in 0..args.count {
                    if k > 0 {
                        buf_str(d, c", ");
                    }
                    buf_str(d, (*args.data.add(k as usize)) as *mut u8);
                }
            }
            buf_byte(d, b'\n');
            return 0;
        }
        let out = buf_new();
        for k in 0..sel.count {
            if show {
                show_region(out, (*sel.data.add(k as usize)), tcx);
            } else {
                put_region(out, (*sel.data.add(k as usize)), tcx);
            }
        }
        buf_write_fd(out, STDOUT);
        0
    }
}
