// `volec edit resolve TARGET --ours|--theirs|--both|--base [--all]
// [--in FILE]`, or `< TEXT` (0.15): the conflict regions of TARGET
// replaced by a side, both, the base or TEXT; each file written whole
// (its copy renamed onto it) and journaled for `undo`; then what is left:
// the regions in other files, else the program's errors (`volec check`).

use crate::base::{
    get_bufs, IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{
    Call, EV_FLAG, EV_MISSING, EV_OPTION, EV_UNKNOWN, EV_WORD, Leaf, Line, flag, option,
};
use crate::front::cpp::directives::file_exists;
use crate::tools::conflicts::{
    blank, conflicted_files, default_dir, file_target, indent, line, line_pos, marker, names_item,
    ours_end, path_of, read_dir, read_source, try_start,
};
use crate::tools::ctx::Tcx;
use crate::tools::edit::apply::copy_path;
use crate::tools::edit::cli::{edit_opts, take_edit_event};
use crate::tools::edit::diff::diff_texts;
use crate::tools::edit::undo::journal_texts;
use crate::tools::proc::{
    read_file_if, read_stdin, remove_file, rename_file, run_capture, same_bytes, write_file_if,
};
use crate::tools::query::{c_slice, find_root};
use crate::tools::query::diagnostics::{diag, put_cword, put_root, put_word, try_end};

fn usage(message: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = diag(c"error", c"edit.usage", tcx);
    buf_str(d, message);
    buf_byte(d, b'\n');
    let out = try_start(tcx, pcx);
    buf_str(out, c" edit resolve FILE:LINE --ours");
    put_root(out, tcx);
    try_end(out);
    2
}

// The command as it was run, with TARGET (word t) replaced by region r's
// first line.
fn try_region(line: Line<'_>, t: i64, r: i64, stdin: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let out = try_start(tcx, pcx);
        for i in 1..line.len() {
            if i == t {
                let w = buf_new();
                buf_bytes(w, path_of(tcx.f_path.get((*tcx.r_file.data.add(r as usize)))));
                buf_byte(w, b':');
                buf_int(w, (*tcx.conflicts_r_start.data.add(r as usize)));
                put_word(out, buf_slice(w));
            } else if line.word(i) != "--all" {
                put_word(out, line.word(i).as_bytes());
            }
        }
        if stdin {
            buf_str(out, c" < text.vl");
        }
        try_end(out);
    }
}

// Region r's replacement (side: 'o' ours, 't' theirs, 'b' both, 'a' the
// base, 'x' the text), appended to out; its number of lines.
fn put_resolved(out: i64, r: i64, side: u8, text: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let f = (*tcx.r_file.data.add(r as usize));
        let t = buf_slice((*tcx.f_text.data.add(f as usize)));
        let s = (*tcx.conflicts_r_start.data.add(r as usize));
        let before = (*get_bufs().add(out as usize)).len;
        if side == b'x' {
            let x = buf_slice(text);
            buf_bytes(out, x);
            if x.len() > 0 && x[(x.len() as i64 - 1) as usize] != b'\n' {
                buf_byte(out, b'\n');
            }
        } else {
            if side == b'o' || side == b'b' {
                buf_bytes(out, &t[line_pos(f, s + 1, tcx) as usize..line_pos(f, ours_end(r, tcx), tcx) as usize]);
            }
            if side == b'a' {
                buf_bytes(out,
                    &t[line_pos(f, (*tcx.r_base.data.add(r as usize)) + 1, tcx) as usize..line_pos(f, (*tcx.r_sep.data.add(r as usize)),
                        tcx) as usize]);
            }
            // (both: an item at the top level after another, a blank line apart)
            let ours = ours_end(r, tcx) - s - 1;
            let theirs = (*tcx.conflicts_r_end.data.add(r as usize)) - (*tcx.r_sep.data.add(r as usize)) - 1;
            if side == b'b' && ours > 0 && theirs > 0
                && same_bytes(line(f, ours_end(r, tcx) - 1, tcx), c_slice(c"}"))
                && !blank(line(f, (*tcx.r_sep.data.add(r as usize)) + 1, tcx))
                && indent(line(f, (*tcx.r_sep.data.add(r as usize)) + 1, tcx)) == 0 {
                buf_byte(out, b'\n');
            }
            if side == b't' || side == b'b' {
                buf_bytes(out,
                    &t[line_pos(f, (*tcx.r_sep.data.add(r as usize)) + 1, tcx) as usize..line_pos(f,
                        (*tcx.conflicts_r_end.data.add(r as usize)), tcx) as usize]);
            }
        }
        let mut n: i64 = 0;
        for i in before..(*get_bufs().add(out as usize)).len {
            if (*(*get_bufs().add(out as usize)).data.add(i as usize)) == b'\n' {
                n += 1;
            }
        }
        n
    }
}

fn side_name(side: u8) -> *mut u8 {
    if side == b'o' { c"ours" } else if side == b't' { c"theirs" } else if side == b'b' { c"both" }
    else if side == b'a' { c"base" } else { c"text" }
}

// The marker lines left in the files under the root's directory.
fn regions_left(files: &mut i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut paths = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        conflicted_files(default_dir(tcx, pcx), &mut paths);
        *files = paths.count;
        let mut n: i64 = 0;
        for k in 0..paths.count {
            let b = buf_new();
            if !read_file_if((*paths.data.add(k as usize)) as *mut u8, b) {
                continue;
            }
            let t = buf_slice(b);
            let mut i: i64 = 0;
            while i < t.len() as i64 {
                let mut e = i;
                while e < t.len() as i64 && t[e as usize] != b'\n' {
                    e += 1;
                }
                if marker(&t[i as usize..e as usize], b'<') {
                    n += 1;
                }
                i = e + 1;
            }
        }
        n
    }
}

// `edit resolve`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn resolve_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut table = edit_opts(gpa);
    table.push(flag("ours", "our side"));
    table.push(flag("theirs", "their side"));
    table.push(flag("both", "both sides, ours first"));
    table.push(flag("base", "the base"));
    table.push(flag("all", "every conflict of the file"));
    table.push(option("in", "FILE", "the file of an item's conflicts"));
    Leaf::new(table, "spot")
}

// `volec edit resolve TARGET --ours|--theirs|--both|--base [--all]
// [--in FILE]` (or `< TEXT`): the exit status (the diagnostics are
// written by run_edit).
pub fn run_resolve(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut side = b'x';
    let mut all = false;
    let mut in_file = 0 as *mut u8;
    let mut root = 0 as *mut u8;
    let mut target = 0 as *mut u8;
    let mut target_at: i64 = 0;
    for e in c.evs.iter().copied() {
        let mut ev = e;
        let a = ev.value;
        let f = ev.kind == EV_FLAG;
        let s = if f && ev.name == "ours" { b'o' } else if f && ev.name == "theirs" { b't' }
            else if f && ev.name == "both" { b'b' } else if f && ev.name == "base" { b'a' }
            else { b'x' };
        if ev.kind == EV_MISSING && ev.name == "in" {
            ev.kind = EV_UNKNOWN;
        }
        if s != b'x' {
            if side != b'x' {
                return usage(c"one of --ours, --theirs, --both, --base (or the text on stdin)",
                    tcx, pcx);
            }
            side = s;
        } else if f && ev.name == "all" {
            all = true;
        } else if ev.kind == EV_OPTION && ev.name == "in" {
            in_file = a;
        } else if take_edit_event(&mut ev, &mut root, tcx, pcx) {
        } else if ev.kind != EV_WORD {
            let d = diag(c"error", c"edit.usage", tcx);
            buf_str(d, c"unknown option '");
            buf_str(d, ev.value);
            buf_str(d, c"' of edit resolve\n");
            return usage(
                c"edit resolve TARGET --ours|--theirs|--both|--base [--all] [--in FILE]", tcx,
                pcx);
        } else if target == 0 as *mut u8 {
            target = a;
            target_at = ev.at;
        } else {
            return usage(c"one TARGET at a time (FILE:LINE, FILE or an item's NAME)", tcx, pcx);
        }
    }
    unsafe {
        if target == 0 as *mut u8 {
            return usage(c"a TARGET is needed (FILE:LINE, FILE or an item's NAME)", tcx, pcx);
        }
        tcx.root_given = root;
        let text = buf_new();
        if side == b'x' && (!read_stdin(text, tcx) || (*get_bufs().add(text as usize)).len == 0) {
            let d = diag(c"error", c"edit.no-text", tcx);
            buf_str(d, c"no side (--ours, --theirs, --both, --base), and no text on stdin\n");
            let out = try_start(tcx, pcx);
            buf_str(out, c" edit resolve");
            put_cword(out, target);
            buf_str(out, c" --ours");
            put_root(out, tcx);
            try_end(out);
            return 2;
        }
        // The regions.
        let mut sel = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let t = file_target(target, &mut sel, tcx, pcx);
        if t == 2 {
            return 1;
        }
        let by_name = t == 1;
        if by_name {
            if in_file != 0 as *mut u8 {
                if read_source(in_file, tcx, pcx) < 0 {
                    return 1;
                }
            } else if !read_dir(default_dir(tcx, pcx), tcx, pcx) {
                return 1;
            }
            for r in 0..tcx.r_file.count {
                if names_item(r, c_slice(target), tcx) {
                    sel.push(r);
                }
            }
        }
        if sel.count == 0 {
            let d = diag(c"error", c"conflict.none", tcx);
            if by_name {
                buf_str(d, c"no conflict region in an item '");
            } else {
                buf_str(d, c"no conflict markers in '");
            }
            buf_str(d, target);
            buf_str(d, c"'\n");
            let out = try_start(tcx, pcx);
            buf_str(out, c" query conflicts");
            put_root(out, tcx);
            try_end(out);
            return 1;
        }
        if sel.count > 1 && !all {
            let d = diag(c"error", c"conflict.ambiguous", tcx);
            buf_int(d, sel.count);
            buf_str(d, c" conflict regions match '");
            buf_str(d, target);
            buf_str(d, c"': ");
            for k in 0..sel.count {
                let r = (*sel.data.add(k as usize));
                if k > 0 {
                    buf_str(d, c", ");
                }
                buf_bytes(d, path_of(tcx.f_path.get((*tcx.r_file.data.add(r as usize)))));
                buf_byte(d, b':');
                buf_int(d, (*tcx.conflicts_r_start.data.add(r as usize)));
            }
            buf_str(d, c"; give FILE:LINE, or --all for every one\n");
            let mut k: i64 = 0;
            while k < sel.count && k < 3 {
                try_region(c.line, target_at, (*sel.data.add(k as usize)), side == b'x', tcx, pcx);
                k += 1;
            }
            return 1;
        }
        if side == b'a' {
            for k in 0..sel.count {
                let r = (*sel.data.add(k as usize));
                if (*tcx.r_base.data.add(r as usize)) < 0 {
                    let d = diag(c"error", c"conflict.no-base", tcx);
                    buf_bytes(d, path_of(tcx.f_path.get((*tcx.r_file.data.add(r as usize)))));
                    buf_byte(d, b':');
                    buf_int(d, (*tcx.conflicts_r_start.data.add(r as usize)));
                    buf_str(d,
                        c" has no base side (git writes it with merge.conflictStyle diff3)\n");
                    let out = try_start(tcx, pcx);
                    buf_str(out, c" query conflicts");
                    let w = buf_new();
                    buf_bytes(w, path_of(tcx.f_path.get((*tcx.r_file.data.add(r as usize)))));
                    buf_byte(w, b':');
                    buf_int(w, (*tcx.conflicts_r_start.data.add(r as usize)));
                    put_word(out, buf_slice(w));
                    buf_str(out, c" --show");
                    try_end(out);
                    return 1;
                }
            }
        }
        // (in the order of the files and their lines)
        let v = sel.data;
        for k in 1..sel.count {
            let mut j = k;
            while j > 0 && (*v.add(j as usize)) < (*v.add((j - 1) as usize)) {
                let x = (*v.add(j as usize));
                (*v.add(j as usize)) = (*v.add((j - 1) as usize));
                (*v.add((j - 1) as usize)) = x;
                j -= 1;
            }
        }
        // The new texts, file by file; what --show prints.
        let mut paths = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut befores = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut afters = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let shown = buf_new();
        let diff = buf_new();
        let mut k: i64 = 0;
        while k < sel.count {
            let f = (*tcx.r_file.data.add((*sel.data.add(k as usize)) as usize));
            let old = buf_slice((*tcx.f_text.data.add(f as usize)));
            let new = buf_new();
            let mut cur: i64 = 0;
            let mut delta: i64 = 0;
            while k < sel.count && (*tcx.r_file.data.add((*sel.data.add(k as usize)) as usize)) == f {
                let r = (*sel.data.add(k as usize));
                let s = (*tcx.conflicts_r_start.data.add(r as usize));
                buf_bytes(new, &old[cur as usize..line_pos(f, s, tcx) as usize]);
                let at = (*get_bufs().add(new as usize)).len;
                let n = put_resolved(new, r, side, text, tcx);
                buf_str(shown, c"// ");
                buf_bytes(shown, path_of(tcx.f_path.get(f)));
                buf_byte(shown, b':');
                buf_int(shown, s + delta);
                if n == 0 {
                    buf_str(shown, c": the region removed\n");
                } else {
                    if n > 1 {
                        buf_byte(shown, b'-');
                        buf_int(shown, s + delta + n - 1);
                    }
                    buf_byte(shown, b'\n');
                    let nt = buf_slice(new);
                    let mut p = at;
                    let mut ln = s + delta;
                    while p < nt.len() as i64 {
                        let mut e = p;
                        while e < nt.len() as i64 && nt[e as usize] != b'\n' {
                            e += 1;
                        }
                        buf_int(shown, ln);
                        buf_byte(shown, b'\t');
                        buf_bytes(shown, &nt[p as usize..e as usize]);
                        buf_byte(shown, b'\n');
                        ln += 1;
                        p = e + 1;
                    }
                }
                delta += n - ((*tcx.conflicts_r_end.data.add(r as usize)) - s + 1);
                cur = line_pos(f, (*tcx.conflicts_r_end.data.add(r as usize)) + 1, tcx);
                k += 1;
            }
            buf_bytes(new, &old[cur as usize..]);
            diff_texts(diff, path_of(tcx.f_path.get(f)), old, buf_slice(new), tcx);
            paths.push((*tcx.f_path.data.add(f as usize)));
            befores.push((*tcx.f_text.data.add(f as usize)));
            afters.push(new);
        }
        // Lines added and removed, from the diff.
        let mut added: i64 = 0;
        let mut removed: i64 = 0;
        let d = buf_slice(diff);
        let mut p: i64 = 0;
        while p < d.len() as i64 {
            let mut e = p;
            while e < d.len() as i64 && d[e as usize] != b'\n' {
                e += 1;
            }
            if e > p && d[p as usize] == b'+' && !(e - p >= 3 && d[(p + 1) as usize] == b'+' && d[(p + 2) as usize] == b'+') {
                added += 1;
            }
            if e > p && d[p as usize] == b'-' && !(e - p >= 3 && d[(p + 1) as usize] == b'-' && d[(p + 2) as usize] == b'-') {
                removed += 1;
            }
            p = e + 1;
        }
        if tcx.dry_run {
            buf_write_fd(diff, STDOUT);
            return 0;
        }
        // Written: the copies, then renamed onto the files.
        for j in 0..paths.count {
            let path = (*paths.data.add(j as usize)) as *mut u8;
            if !write_file_if(copy_path(path, pcx), buf_slice((*afters.data.add(j as usize)))) {
                for x in 0..j + 1 {
                    remove_file(copy_path((*paths.data.add(x as usize)) as *mut u8, pcx));
                }
                let e = diag(c"error", c"edit.write", tcx);
                buf_str(e, c"cannot write '");
                buf_str(e, path);
                buf_str(e, c"'\n");
                return 1;
            }
        }
        let summary = buf_new();
        buf_str(summary, c"resolved ");
        if sel.count == 1 {
            let r = (*sel.data.add(0));
            buf_bytes(summary, path_of(tcx.f_path.get((*tcx.r_file.data.add(r as usize)))));
            buf_byte(summary, b':');
            buf_int(summary, (*tcx.conflicts_r_start.data.add(r as usize)));
            buf_byte(summary, b'-');
            buf_int(summary, (*tcx.conflicts_r_end.data.add(r as usize)));
        } else {
            buf_int(summary, sel.count);
            buf_str(summary, c" conflicts");
        }
        buf_str(summary, c" (");
        buf_str(summary, side_name(side));
        buf_str(summary, c")\t");
        if paths.count == 1 {
            buf_str(summary, (*paths.data.add(0)) as *mut u8);
        } else {
            buf_int(summary, paths.count);
            buf_str(summary, c" files");
        }
        buf_str(summary, c"\t+");
        buf_int(summary, added);
        buf_str(summary, c" -");
        buf_int(summary, removed);
        buf_str(summary, c" lines");
        let root_path = find_root(tcx.root_given, pcx);
        journal_texts(if root_path != 0 as *mut u8 { root_path } else { (*paths.data.add(0)) as *mut u8 }, paths,
            befores, afters, buf_slice(summary), tcx, pcx);
        let mut ok = true;
        for j in 0..paths.count {
            let path = (*paths.data.add(j as usize)) as *mut u8;
            if !rename_file(copy_path(path, pcx), path) {
                ok = false;
                let e = diag(c"error", c"edit.write", tcx);
                buf_str(e, c"cannot write '");
                buf_str(e, path);
                buf_str(e, c"'\n");
            }
        }
        buf_byte(summary, b'\n');
        if tcx.show {
            buf_bytes(summary, buf_slice(shown));
        }
        buf_write_fd(summary, STDOUT);
        // What is left: other regions, else the program's errors.
        let mut files: i64 = 0;
        let left = regions_left(&mut files, tcx, pcx);
        if left > 0 {
            let n = diag(c"note", c"conflict.left", tcx);
            buf_int(n, left);
            buf_str(n,
                if left == 1 { c" conflict region left in " }
                else { c" conflict regions left in " });
            buf_int(n, files);
            buf_str(n, if files == 1 { c" file\n" } else { c" files\n" });
            let out = try_start(tcx, pcx);
            buf_str(out, c" query conflicts");
            put_root(out, tcx);
            try_end(out);
        } else if root_path != 0 as *mut u8 && file_exists(root_path, pcx) {
            let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            args.push(pcx.prog as i64);
            args.push(c"check" as i64);
            args.push(c"--diagnostics=short" as i64);
            args.push(root_path as i64);
            args.push(0);
            let out = buf_new();
            let status = run_capture(args.data as *mut *mut u8, out);
            if status != 0 {
                buf_write_fd(out, STDOUT);
                let w = diag(c"warning", c"conflict.check", tcx);
                buf_str(w, c"the resolved program has errors (written; the merge may need more than one side)\n");
                let tr = try_start(tcx, pcx);
                buf_str(tr, c" check");
                put_root(tr, tcx);
                try_end(tr);
            }
        }
        if ok { 0 } else { 1 }
    }
}
