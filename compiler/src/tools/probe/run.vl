// volec probe's run and report (0.17): the program run with its
// arguments, stdin and time limit; then per probe its count and values,
// the exit status, the start of stdout and stderr.

use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd, get_src,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::{Tcx, cptrs, zeros};
use crate::tools::probe::{
    AT_AFTER, AT_BLOCK, AT_BODY, _exit, alarm, close, creat, dup2, execvp, fork, next_line, open,
    probe, starts, waitpid,
};
use crate::tools::probe::code::trim;
use crate::tools::proc::read_file_if;
use crate::tools::query::refs::file_text;

// Runs prog with ARGS, stdin from INPUT (else this one's), stdout and
// stderr into the files: its exit status, 128 + a signal, -1 past the time
// limit.
pub fn run_program(prog: *mut u8, out_path: *mut u8, err_path: *mut u8, tcx: &Tcx<Comp>) -> i64 {
    // UNSAFE: fork, open, creat, dup2, close, alarm, execvp, _exit and
    // waitpid are C's: the program runs in a child with its output on files.
    // SAFETY: prog and the paths are C strings of the caller's; argv is a
    // list of prog, the probe's arguments (C strings) and a null, alive for
    // the call; the child calls only these functions before exec, each
    // descriptor checked before it is used and closed once; status is a
    // local that waitpid writes.
    unsafe {
        let mut argv = cptrs(tcx.probe_args.len() as i64 + 2);
        (argv[0]) = prog;
        for i in 0..tcx.probe_args.len() as i64 {
            (argv[(i + 1) as usize]) = (tcx.probe_args[i as usize]) as *mut u8;
        }
        (argv[(tcx.probe_args.len() as i64 + 1) as usize]) = 0 as *mut u8;
        let pid = fork();
        if pid < 0 {
            return 127;
        }
        if pid == 0 {
            if tcx.probe_input != 0 as *mut u8 {
                let fd = open(tcx.probe_input, 0);
                if fd >= 0 {
                    dup2(fd, 0);
                    close(fd);
                }
            }
            let o = creat(out_path, 420);
            if o >= 0 {
                dup2(o, 1);
                close(o);
            }
            let e = creat(err_path, 420);
            if e >= 0 {
                dup2(e, 2);
                close(e);
            }
            alarm(tcx.probe_timeout as u32);
            execvp(prog, argv.as_mut_ptr());
            _exit(127);
        }
        let mut status = 0 as i32;
        waitpid(pid, &mut status, 0);
        let s = status as i64;
        if (s & 127) == 14 {
            return -1;
        }
        if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
    }
}

// ---- The report ----

fn put_cut(out: i64, s: &[u8], max: i64) {
    if s.len() as i64 > max {
        buf_bytes(out, &s[0..max as usize]);
        buf_bytes(out, b"...");
    } else {
        buf_bytes(out, s);
    }
}

pub fn report(status: i64, out_path: *mut u8, err_path: *mut u8, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let err_b = buf_new();
        read_file_if(err_path, err_b);
        let err = buf_slice(err_b);
        let out_b = buf_new();
        read_file_if(out_path, out_b);
        let got = buf_slice(out_b);
        let out = buf_new();
        // Per probe: its hits (the count at exit, else the lines printed).
        // (exact from the report at exit, else at least the last power of
        // two the probe announced, or the lines it printed)
        let mut counts = zeros(tcx.probes.len() as i64);
        let mut printed = zeros(tcx.probes.len() as i64);
        let mut lower = zeros(tcx.probes.len() as i64);
        for k in 0..tcx.probes.len() as i64 {
            (counts[k as usize]) = -1;
            (printed[k as usize]) = 0;
            (lower[k as usize]) = 0;
        }
        let rest = buf_new();
        let mut rest_lines: i64 = 0;
        let mut i: i64 = 0;
        while i < err.len() as i64 {
            let e = next_line(err, i);
            let l = &err[i as usize..e as usize];
            i = e + 1;
            if starts(l, b"@@probe-count ") || starts(l, b"@@probe-total ") {
                let mut j: i64 = 14;
                let mut k: i64 = 0;
                while j < l.len() as i64 && l[j as usize] != b' ' {
                    k = k * 10 + (l[j as usize] - b'0') as i64;
                    j += 1;
                }
                let mut n: i64 = 0;
                j += 1;
                while j < l.len() as i64 {
                    n = n * 10 + (l[j as usize] - b'0') as i64;
                    j += 1;
                }
                if k < tcx.probes.len() as i64 && starts(l, b"@@probe-total ") {
                    (counts[k as usize]) = n;
                } else if k < tcx.probes.len() as i64 && n > (lower[k as usize]) {
                    (lower[k as usize]) = n;
                }
            } else if starts(l, b"@@probe ") {
                let mut j: i64 = 8;
                let mut k: i64 = 0;
                while j < l.len() as i64 && l[j as usize] >= b'0' && l[j as usize] <= b'9' {
                    k = k * 10 + (l[j as usize] - b'0') as i64;
                    j += 1;
                }
                if k < tcx.probes.len() as i64 {
                    (printed[k as usize]) = (printed[k as usize]) + 1;
                }
            } else if rest_lines < 12 {
                buf_bytes(rest, b"  ");
                put_cut(rest, l, 200);
                buf_byte(rest, b'\n');
                rest_lines += 1;
            } else {
                rest_lines += 1;
            }
        }
        for k in 0..tcx.probes.len() as i64 {
            let p = probe(k, tcx);
            buf_bytes(out, b"probe ");
            buf_bytes(out, file_text(p.file, pcx));
            buf_byte(out, b':');
            buf_int(out, p.line);
            buf_bytes(out, if p.how == AT_AFTER { b" (after `" }
                else if p.how == AT_BODY { b" (each time round `" }
                else if p.how == AT_BLOCK { b" (in the block of `" }
                else { b" (before `" });
            put_cut(out, trim(&get_src()[p.what_at as usize..p.what_end as usize]), 50);
            buf_bytes(out, b"`): ");
            let n = if (counts[k as usize]) >= 0 { (counts[k as usize]) }
                else if (lower[k as usize])
                > (printed[k as usize]) { (lower[k as usize]) }
                else { (printed[k as usize]) };
            if n == 0 {
                buf_bytes(out, if status == 0 || status == 101 { b"never ran\n" }
                    else { b"did not run before it stopped\n" });
                continue;
            }
            if (counts[k as usize]) < 0 {
                buf_bytes(out, b"at least ");
            }
            buf_int(out, n);
            buf_bytes(out, if n == 1 { b" time" } else { b" times" });
            if p.exprs.len() as i64 > 0 && n > (printed[k as usize]) {
                buf_bytes(out, b", the first ");
                buf_int(out, (printed[k as usize]));
                buf_bytes(out, b" (--max N)");
            }
            buf_byte(out, b'\n');
            // The values.
            let mut hit: i64 = 0;
            let mut i: i64 = 0;
            while i < err.len() as i64 {
                let e = next_line(err, i);
                let l = &err[i as usize..e as usize];
                i = e + 1;
                if !starts(l, b"@@probe ") {
                    continue;
                }
                let mut j: i64 = 8;
                let mut kk: i64 = 0;
                while j < l.len() as i64 && l[j as usize] >= b'0' && l[j as usize] <= b'9' {
                    kk = kk * 10 + (l[j as usize] - b'0') as i64;
                    j += 1;
                }
                if kk != k {
                    continue;
                }
                hit += 1;
                let line = buf_new();
                buf_bytes(line, b"  #");
                buf_int(line, hit);
                let mut x: i64 = 0;
                while j < l.len() as i64 && x < p.exprs.len() as i64 {
                    j += 1;
                    let mut v = j;
                    while v < l.len() as i64 && l[v as usize] != b'\t' {
                        v += 1;
                    }
                    buf_bytes(line, b"  ");
                    buf_str(line, (p.exprs[x as usize]) as *mut u8);
                    buf_bytes(line, b" = ");
                    buf_bytes(line, &l[j as usize..v as usize]);
                    j = v;
                    x += 1;
                }
                put_cut(out, buf_slice(line), 300);
                buf_byte(out, b'\n');
            }
        }
        buf_bytes(out, b"run: ");
        if status == -1 {
            buf_bytes(out, b"stopped after ");
            buf_int(out, tcx.probe_timeout);
            buf_bytes(out, b" s (--timeout S)");
        } else {
            buf_bytes(out, b"exit ");
            buf_int(out, status);
        }
        let mut lines: i64 = 0;
        for c in 0..got.len() {
            if got[c] == b'\n' {
                lines += 1;
            }
        }
        if got.len() > 0 && got[(got.len() as i64 - 1) as usize] != b'\n' {
            lines += 1;
        }
        buf_bytes(out, b"; stdout ");
        buf_int(out, lines);
        buf_bytes(out, if lines == 1 { b" line (" } else { b" lines (" });
        buf_str(out, out_path);
        buf_bytes(out, b")\n");
        let mut shown: i64 = 0;
        let mut i: i64 = 0;
        while i < got.len() as i64 && shown < 5 {
            let e = next_line(got, i);
            buf_bytes(out, b"  | ");
            put_cut(out, &got[i as usize..e as usize], 200);
            buf_byte(out, b'\n');
            i = e + 1;
            shown += 1;
        }
        if rest_lines > 0 {
            buf_bytes(out, b"stderr:\n");
            buf_bytes(out, buf_slice(rest));
            if rest_lines > 12 {
                buf_bytes(out, b"  (");
                buf_int(out, rest_lines - 12);
                buf_bytes(out, b" more lines: ");
                buf_str(out, err_path);
                buf_bytes(out, b")\n");
            }
        }
        buf_write_fd(out, STDOUT);
        0
    }
}
