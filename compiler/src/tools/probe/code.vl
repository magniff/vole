// volec probe's code (0.17): what is written into the copies of the
// program's files: the type questions, then each probe's count and the
// printing of its values by type, and the statics at the end.

use crate::base::{buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::buf_type;
use crate::tools::ctx::Tcx;
use crate::tools::probe::{AT_AFTER, Probe, probe};

// ---- The code of the probes ----

// The copy of file f's text with its probes: each probe's code (the type
// questions when `typing`, else the printing), the probes' statics at the
// end; the probes' spans set.
pub fn copy_with_probes(f: i64, text: &[u8], typing: bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        // The probes of f by offset.
        let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
        for k in 0..tcx.probes.len() as i64 {
            if probe(k, tcx).file == f {
                let mut j = order.len() as i64;
                order.push(k);
                while j > 0
                    && probe((order[(j - 1) as usize]), tcx).at > probe(k, tcx).at {
                    (order[j as usize]) = (order[(j - 1) as usize]);
                    j -= 1;
                }
                (order[j as usize]) = k;
            }
        }
        let out = buf_new();
        let mut done: i64 = 0;
        for j in 0..order.len() as i64 {
            let k = (order[j as usize]);
            let p = probe(k, tcx);
            buf_bytes(out, &text[done as usize..p.at as usize]);
            done = p.at;
            if p.how == AT_AFTER {
                buf_byte(out, b' ');
            }
            p.from = buf_slice(out).len() as i64;
            p.spans.clear();
            if typing {
                put_type_questions(out, &mut *p);
            } else {
                put_probe(out, k, &mut *p, tcx, pcx);
            }
            p.to = buf_slice(out).len() as i64;
            buf_byte(out, b' ');
        }
        buf_bytes(out, &text[done as usize..]);
        if !typing {
            // (0.20: `static var` but in the crate read in 0.19's spelling)
            let word: &[u8] = b"mut";
            buf_bytes(out, b"\n// (volec probe)\nstatic ");
            buf_bytes(out, word);
            buf_bytes(out, b" __PROBE_N: [i64; 32] = [0; 32];\nstatic ");
            buf_bytes(out, word);
            put(out, b" __PROBE_ON: bool = false;\nextern \"C\" {\n    #[link_name = \"atexit\"]\n    fn __probe_atexit(f: extern \"C\" fn()) -> i32;\n}\nextern \"C\" fn __probe_report_", pcx);
            // (0.28.0: one report function a probed file, named by the file:
            // an `extern "C"` name is the symbol, and two files defined it twice)
            buf_int(out, f);
            put(out, b"() {\n    unsafe {\n        for k in 0..32 {\n            if __PROBE_N[k] > 0 {\n                std::eprintln(\"@@probe-total {k} {}\", __PROBE_N[k]);\n            }\n        }\n    }\n}\n", pcx);
        }
        out
    }
}

// `{ let _: () = (EXPR); ... }`: check's errors name the types.
fn put_type_questions(out: i64, p: &mut Probe<Comp>) {
    buf_bytes(out, b"{ ");
    for x in 0..p.exprs.len() as i64 {
        buf_bytes(out, b"let __probe_t: () = ");
        p.spans.push(buf_slice(out).len() as i64);
        buf_byte(out, b'(');
        buf_str(out, (p.exprs[x as usize]) as *mut u8);
        buf_bytes(out, b"); ");
    }
    buf_bytes(out, b"}");
}

// The probe: its count, the atexit report once, the values the first
// MAX_HITS times, as one line `@@probe K<TAB>v0<TAB>v1`.
fn put_probe(out: i64, k: i64, p: &mut Probe<Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    buf_bytes(out, b"{ unsafe { __PROBE_N[");
    buf_int(out, k);
    buf_bytes(out, b"] += 1; let __probe_n = __PROBE_N[");
    buf_int(out, k);
    put(out,
        b"]; if (__probe_n & (__probe_n - 1)) == 0 { std::eprintln(\"@@probe-count ", pcx);
    buf_int(out, k);
    buf_bytes(out, b" {__probe_n}\"); } ");
    buf_bytes(out,
        b"if !__PROBE_ON { __PROBE_ON = true; __probe_atexit(__probe_report_");
    buf_int(out, p.file);
    buf_bytes(out, b"); } } ");
    if p.exprs.len() as i64 > 0 {
        buf_bytes(out, b"if unsafe { __PROBE_N[");
        buf_int(out, k);
        buf_bytes(out, b"] } <= ");
        buf_int(out, tcx.max_hits);
        put(out, b" { std::eprint(\"@@probe ", pcx);
        buf_int(out, k);
        buf_bytes(out, b"\"); ");
        for x in 0..p.exprs.len() as i64 {
            p.spans.push(buf_slice(out).len() as i64);
            put(out, b"std::eprint(\"\\t\"); ", pcx);
            let ty = (p.types[x as usize]);
            if ty < 0 {
                put(out, b"std::eprint(\"()\"); ", pcx);
            } else {
                // (0.17) a place is printed through a reference: the
                // probe must not move the value out of the program
                let place = is_place_text((p.exprs[x as usize]) as *mut u8);
                if place {
                    buf_bytes(out, b"{ let __probe_v = &(");
                } else {
                    buf_bytes(out, b"{ let __probe_v = (");
                }
                buf_str(out, (p.exprs[x as usize]) as *mut u8);
                buf_bytes(out, b"); ");
                if place {
                    put_printer(out, b"(*__probe_v)", buf_slice(ty),
                        (p.opaque[x as usize]), 0, pcx);
                } else {
                    put_printer(out, b"__probe_v", buf_slice(ty),
                        (p.opaque[x as usize]), 0, pcx);
                }
                buf_bytes(out, b"} ");
            }
        }
        put(out, b"std::eprintln(\"\"); } ", pcx);
    }
    buf_bytes(out, b"}");
}

// Whether the probed expression `s` is a place (a name, or names and
// field numbers joined by dots), which the probe borrows.
fn is_place_text(s: *mut u8) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while (*s.add(i as usize)) != 0 {
            let c = (*s.add(i as usize));
            let word = c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c == b'_';
            if !(word || c == b'.' && i > 0 || c >= b'0' && c <= b'9' && i > 0) {
                return false;
            }
            i += 1;
        }
        i > 0
    }
}

fn is_int_type(t: &[u8]) -> bool {
    t == b"i8" || t == b"i16" || t == b"i32" || t == b"i64" || t == b"u8" || t == b"u16"
        || t == b"u32" || t == b"u64" || t == b"isize" || t == b"usize"
}

// The end of the type starting at t[i] (at a top-level `,`, `;`, `)`, `]`
// or `>`).
fn type_end(t: &[u8], i0: i64) -> i64 {
    let mut i = i0;
    let mut depth: i64 = 0;
    while i < t.len() as i64 {
        let c = t[i as usize];
        if c == b'(' || c == b'[' || c == b'<' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'>' {
            if depth == 0 {
                return i;
            }
            depth -= 1;
        } else if (c == b',' || c == b';') && depth == 0 {
            return i;
        }
        i += 1;
    }
    i
}

pub fn trim(t: &[u8]) -> &[u8] {
    let mut a: i64 = 0;
    let mut b = t.len() as i64;
    while a < b && t[a as usize] == b' ' {
        a += 1;
    }
    while b > a && t[(b - 1) as usize] == b' ' {
        b -= 1;
    }
    &t[a as usize..b as usize]
}

// Whether v holds x.
pub fn has(v: &[i64], x: i64) -> bool {
    for i in 0..v.len() as i64 {
        if (v[i as usize]) == x {
            return true;
        }
    }
    false
}

// `Name { f: .., g: .. }` of `v`, when t names a struct of the program;
// false when it does not.
fn put_fields(out: i64, v: &[u8], t: &[u8], depth: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut st: i64 = -1;
        for s in 0..pcx.structs.len() as i64 {
            if pcx.structs[s as usize].generic == 0 && pcx.structs[s as usize].closure == 0
                && sym_text(pcx.structs[s as usize].name, pcx) == t {
                st = s;
            }
        }
        if st < 0 {
            return false;
        }
        put(out, b"std::eprint(\"", pcx);
        buf_bytes(out, t);
        buf_bytes(out, b" {{ \"); ");
        for i in 0..pcx.structs[st as usize].field_count {
            let fi = (pcx.fields[(pcx.structs[st as usize].fields + i) as usize]);
            let name = sym_text(fi.name, pcx);
            if i > 0 {
                put(out, b"std::eprint(\", \"); ", pcx);
            }
            put(out, b"std::eprint(\"", pcx);
            buf_bytes(out, name);
            buf_bytes(out, b": \"); { let __probe_f"); // (0.17: by reference)
            buf_int(out, depth);
            buf_bytes(out, b" = &");
            buf_bytes(out, v);
            buf_byte(out, b'.');
            buf_bytes(out, name);
            buf_bytes(out, b"; ");
            let ft = buf_new();
            buf_type(ft, fi.ty, pcx);
            let fv = buf_new();
            buf_bytes(fv, b"(*__probe_f");
            buf_int(fv, depth);
            buf_byte(fv, b')');
            put_printer(out, buf_slice(fv), buf_slice(ft), 0, depth + 1, pcx);
            buf_bytes(out, b"} ");
        }
        put(out, b"std::eprint(\" }}\"); ", pcx);
        true
    }
}

// Statements printing `v` (a name) of type t on stderr; `opaque` 1: a
// struct of the program field by field (else as 2), 2: its type only (Debug
// was missing).
fn put_printer(out: i64, v: &[u8], t: &[u8], opaque: i64, depth: i64, pcx: &Ctx<Comp>) {
    if opaque == 1 && put_fields(out, v, t, depth, pcx) {
        return;
    }
    if opaque > 0 || depth > 3 {
        put(out, b"std::eprint(\"<", pcx);
        buf_bytes(out, t);
        buf_bytes(out, b">\"); ");
        return;
    }
    if is_int_type(t) || t == b"bool" || t == b"f64" || t == b"f32" {
        put(out, b"std::eprint(\"{}\", ", pcx);
        buf_bytes(out, v);
        buf_bytes(out, b"); ");
        return;
    }
    if t == b"[u8]" {
        put(out, b"std::eprint(\"{:?}\", ", pcx);
        buf_bytes(out, v);
        buf_bytes(out, b"); ");
        return;
    }
    if t.len() > 0 && t[0] == b'*' {
        buf_bytes(out, b"{ let __probe_a = ");
        buf_bytes(out, v);
        put(out, b" as u64; std::eprint(\"0x{__probe_a:x}\"); } ", pcx);
        return;
    }
    let s = buf_new();
    buf_bytes(s, b"__probe_s");
    buf_int(s, depth);
    let ix = buf_new();
    buf_bytes(ix, b"__probe_i");
    buf_int(ix, depth);
    let e = buf_new();
    buf_bytes(e, b"__probe_e");
    buf_int(e, depth);
    // (0.17) elements and fields are bound by reference, never moved
    let ed = buf_new();
    buf_bytes(ed, b"(*__probe_e");
    buf_int(ed, depth);
    buf_byte(ed, b')');
    if t.len() > 2 && t[0] == b'[' && t[(t.len() as i64 - 1) as usize] == b']' {
        let end = type_end(t, 1);
        let elem = trim(&t[1..end as usize]);
        buf_bytes(out, b"{ let ");
        buf_bytes(out, buf_slice(s));
        buf_bytes(out, b" = ");
        buf_bytes(out, v);
        if end < t.len() as i64 - 1 {
            buf_bytes(out, b"[..]");
        }
        put(out, b"; std::eprint(\"[\"); for ", pcx);
        buf_bytes(out, buf_slice(ix));
        buf_bytes(out, b" in 0..");
        buf_bytes(out, buf_slice(s));
        put(out, b".len { if ", pcx);
        buf_bytes(out, buf_slice(ix));
        put(out, b" == 16 { std::eprint(\", ... ({} in all)\", ", pcx);
        buf_bytes(out, buf_slice(s));
        put(out, b".len); break; } if ", pcx);
        buf_bytes(out, buf_slice(ix));
        put(out, b" > 0 { std::eprint(\", \"); } let ", pcx);
        buf_bytes(out, buf_slice(e));
        buf_bytes(out, b" = &");
        buf_bytes(out, buf_slice(s));
        buf_byte(out, b'[');
        buf_bytes(out, buf_slice(ix));
        buf_bytes(out, b"]; ");
        put_printer(out, buf_slice(ed), elem, 0, depth + 1, pcx);
        put(out, b"} std::eprint(\"]\"); } ", pcx);
        return;
    }
    if t.len() > 8 && t[0..7] == b"Option<" && t[(t.len() as i64 - 1) as usize] == b'>' {
        let elem = trim(&t[7..(t.len() as i64 - 1) as usize]);
        buf_bytes(out, b"match ");
        buf_bytes(out, v);
        buf_bytes(out, b" { Option::Some(");
        buf_bytes(out, buf_slice(e));
        put(out, b") => { std::eprint(\"Some(\"); ", pcx);
        put_printer(out, buf_slice(e), elem, 0, depth + 1, pcx);
        put(out, b"std::eprint(\")\"); } Option::None => { std::eprint(\"None\"); } } ", pcx);
        return;
    }
    if t.len() > 2 && t[0] == b'(' && t[(t.len() as i64 - 1) as usize] == b')' {
        put(out, b"std::eprint(\"(\"); ", pcx);
        let mut i: i64 = 1;
        let mut n: i64 = 0;
        while i < t.len() as i64 - 1 {
            let end = type_end(t, i);
            let field = buf_new();
            buf_bytes(field, v);
            buf_byte(field, b'.');
            buf_int(field, n);
            if n > 0 {
                put(out, b"std::eprint(\", \"); ", pcx);
            }
            buf_bytes(out, b"{ let ");
            buf_bytes(out, buf_slice(e));
            buf_bytes(out, b" = &");
            buf_bytes(out, buf_slice(field));
            buf_bytes(out, b"; ");
            put_printer(out, buf_slice(ed), trim(&t[i as usize..end as usize]), 0, depth + 1, pcx);
            buf_bytes(out, b"} ");
            n += 1;
            i = end + 1;
        }
        put(out, b"std::eprint(\")\"); ", pcx);
        return;
    }
    put(out, b"std::eprint(\"{:?}\", ", pcx);
    buf_bytes(out, v);
    buf_bytes(out, b"); ");
}

// (0.28.0) Generated text s into out: in a rust-edition program the
// prelude's `eprint`/`eprintln` for std's (std2 has no std::eprint) and a
// slice's `len()` for its `len`.
fn put(out: i64, s: &[u8], pcx: &Ctx<Comp>) {
    let mut i: usize = 0;
    while i < s.len() {
        if s[i..].starts_with(b"std::eprint") {
            i += 5;
            continue;
        }
        if s[i..].starts_with(b".len {") || s[i..].starts_with(b".len)") {
            buf_bytes(out, b".len()");
            i += 4;
            continue;
        }
        buf_byte(out, s[i]);
        i += 1;
    }
}
