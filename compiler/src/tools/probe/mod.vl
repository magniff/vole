// `volec probe` (0.17): a program run with values printed at lines,
// its source unchanged.
//
//     volec probe FILE:LINE [EXPR...] [FILE:LINE [EXPR...]]... [--count FILE:LINE]
//         [--max N] [--input FILE] [--timeout S] [-O N] [--root ROOT] [-- ARGS...]
//
// Each FILE:LINE gets a probe: the statement that begins the line (a
// `let`: after it, its names visible; a loop: at the start of its body,
// each time round; a line opening a block, `} else {`, `X => {`, `fn
// f(..) {`: at the start of that block). Each time the probe runs it
// counts, and the first N times (--max, 10) prints its expressions'
// values. The program is built with the probes written into copies of its
// files (`--overlay`: the files themselves are not changed; lines keep
// their numbers) and with --trace, then run (ARGS, stdin from --input
// FILE or this command's), and the report printed: per probe its count and
// values, then the exit status, the start of stdout and stderr.
//
// The values are printed by their types, found first by `check` of the
// copies with `let _: () = (EXPR);` (the errors name the types): integers,
// floats and bool as Display, [u8] quoted, arrays, slices (the first 16
// elements), Option and tuples element by element, pointers as addresses,
// anything else by Debug, else as `<TYPE>`.

mod code;
mod run;

use std::alloc::Arena;

use crate::base::{
    IntVec, get_src, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_MISSING, EV_WORD, Leaf, is_opt, option, short_option, table};
use crate::front::ast::{NodeKind, child};
use crate::front::cpp::directives::file_exists;
use crate::front::embed::wgsl::WgslCx;
use crate::tools::ctx::Tcx;
use crate::tools::probe::code::{copy_with_probes, has};
use crate::tools::probe::run::{report, run_program};
use crate::tools::proc::{
    buf_cstr, read_file_if, remove_file, run_capture, scratch_dir, write_file_if,
};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::command_line::load_program;
use crate::tools::query::diagnostics::{diag, put_word, try_begin, try_end, write_diags};
use crate::tools::query::names::path_matches;
use crate::tools::query::positions::{line_end, line_index};
use crate::tools::query::refs::file_text;

extern "C" {
    fn fork() -> i32;
    fn execvp(file: *mut u8, argv: *mut *mut u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn open(path: *mut u8, flags: i32) -> i32;
    fn creat(path: *mut u8, mode: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn alarm(seconds: u32) -> u32;
    fn _exit(code: i32) -> !;
}

// Where a probe goes in its line's statement.
const AT_BEFORE: i64 = 0;
const AT_AFTER: i64 = 1;
const AT_BODY: i64 = 2;
const AT_BLOCK: i64 = 3;

// At most this many probes.
const PROBES_MAX: i64 = 32;

#[derive(Clone, Copy)] struct Probe {
    // As given (FILE:LINE), its file (FILES index) and line.
    site: *mut u8, file: i64, line: i64,
    // The expressions (*u8 each), and per expression its type (a buffer;
    // -1: the expression is `()`) and whether it is shown by type only.
    exprs: IntVec, types: IntVec, opaque: IntVec,
    // Where it goes: the offset in its file's text, how, the statement's
    // first line (for the report: SRC[what_at..what_end], offsets, as a
    // view of SRC would not survive SRC growing).
    at: i64, how: i64, what_at: i64, what_end: i64,
    // Its code's span in the copy of its file (offsets), and each
    // expression's.
    from: i64, to: i64, spans: IntVec,
}

impl Probe {
    // FILE of FILE:LINE, as a C string.
    fn site_file(&mut self) -> *mut u8 {
        let s = c_slice(self.site);
        let mut colon = s.len() as i64 - 1;
        while s[colon as usize] != b':' {
            colon -= 1;
        }
        let b = buf_new();
        buf_bytes(b, &s[0..colon as usize]);
        buf_cstr(b)
    }
}

fn probe(k: i64, tcx: &Tcx<Comp>) -> *mut Probe {
    unsafe { (*tcx.probes.data.add(k as usize)) as *mut Probe }
}

pub fn run_probe(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let status = probe_inner(c, tcx, pcx, wgx);
    write_diags(tcx);
    status
}

fn usage(why: *mut u8, word: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    let d = diag(c"error", c"probe.usage", tcx);
    buf_str(d, why);
    if word != 0 as *mut u8 {
        buf_str(d, c" '");
        buf_str(d, word);
        buf_byte(d, b'\'');
    }
    buf_str(d, c"; usage: volec probe FILE:LINE [EXPR...]... [--count FILE:LINE] [--max N] [--input FILE] [--timeout S] [-O N] [--root ROOT] [-- ARGS...]\n");
    2
}

// FILE:LINE, FILE ending in .vl: the line, else -1.
fn site_line(a: *mut u8) -> i64 {
    let s = c_slice(a);
    let mut i = s.len() as i64;
    while i > 0 && s[(i - 1) as usize] >= b'0' && s[(i - 1) as usize] <= b'9' {
        i -= 1;
    }
    if i == s.len() as i64 || i < 2 || s[(i - 1) as usize] != b':'
        || crate::base::source_ext_len(&s[0..(i - 1) as usize]) == 0 {
        return -1;
    }
    let mut n: i64 = 0;
    for k in i..s.len() as i64 {
        n = n * 10 + (s[k as usize] - b'0') as i64;
    }
    n
}

fn new_probe(site: *mut u8, tcx: &mut Tcx<Comp>) -> *mut Probe {
    unsafe {
        let p = alloc_array::<Probe>(1i64);
        (*p.add(0)) = Probe {
            site, file: -1, line: site_line(site),
            exprs: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
            types: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
            opaque: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
            at: 0, how: AT_BEFORE, what_at: 0, what_end: 0,
            from: 0, to: 0, spans: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        };
        tcx.probes.push(p as i64);
        p
    }
}

// `probe`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
// The program's arguments: the words after the first `--` that is no
// option's value, the values of `args` (0.25.3: Arg::last).
pub fn probe_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(option("max", "N", "at most N hits printed per probe"));
    opts.push(option("timeout", "S", "the run stopped after S seconds"));
    opts.push(option("input", "FILE", "the program's stdin"));
    opts.push(option("root", "ROOT", "the program's root file"));
    opts.push(short_option("O", "N", "the level the program is built at"));
    opts.push(option("count", "FILE:LINE", "how many times the line runs"));
    Leaf::new(opts, "probe").with_last("args")
}

fn probe_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    pcx.prog = c.prog();
    tcx.tool = 0 as *mut u8;
    let mut root = 0 as *mut u8;
    let mut last = 0 as *mut Probe;
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if is_opt(ev, "args") {
            tcx.probe_args.push(a as i64);
            continue;
        }
        if ev.kind == EV_MISSING {
            return usage(c"a value is needed after", a, tcx);
        }
        if is_opt(ev, "max") || is_opt(ev, "timeout") {
            let n = parse_count(a);
            if n <= 0 {
                return usage(c"a number is needed after",
                    if ev.name == "max" { c"--max" } else { c"--timeout" }, tcx);
            }
            if ev.name == "max" {
                tcx.max_hits = n;
            } else {
                tcx.probe_timeout = n;
            }
            continue;
        }
        if is_opt(ev, "input") {
            tcx.probe_input = a;
            continue;
        }
        if is_opt(ev, "root") {
            root = a;
            tcx.root_given = root;
            continue;
        }
        if is_opt(ev, "O") {
            let level = ev.text.as_bytes();
            if !(level.len() == 1 && level[0] >= b'0' && level[0] <= b'2') {
                return usage(c"-O takes 0, 1 or 2, not", a, tcx);
            }
            let b = buf_new();
            buf_str(b, c"-O");
            buf_str(b, a);
            tcx.probe_opt = buf_cstr(b);
            continue;
        }
        if is_opt(ev, "count") {
            if site_line(a) < 1 {
                return usage(c"--count takes FILE:LINE, not", a, tcx);
            }
            new_probe(a, tcx);
            last = 0 as *mut Probe;
            continue;
        }
        if ev.kind != EV_WORD
            || (ev.text.starts_with("-") && ev.text.len() > 1 && site_line(a) < 1) {
            return usage(c"unknown option", a, tcx);
        }
        if site_line(a) >= 1 {
            last = new_probe(a, tcx);
        } else if last == 0 as *mut Probe {
            return usage(c"an expression needs a FILE:LINE before it:", a, tcx);
        } else {
            // UNSAFE: a probe is a raw pointer into PROBES (probe.vl keeps
            // them so, for run.vl's C-level table).
            // SAFETY: last is new_probe's result, not null here (checked
            // above), and PROBES' probes live until the program exits.
            unsafe {
                last.exprs.push(a as i64);
            }
        }
    }
    unsafe {
        if tcx.probes.count == 0 {
            return usage(c"no FILE:LINE given", 0 as *mut u8, tcx);
        }
        if tcx.probes.count > PROBES_MAX {
            return usage(c"at most 32 probes", 0 as *mut u8, tcx);
        }
        let mut r = crate::tools::query::roots::program_root(root, tcx, pcx);
        if r == 0 as *mut u8 && file_exists(probe(0, tcx).site_file(), pcx) {
            // (no main.vl: the probed file is the root)
            r = probe(0, tcx).site_file();
        }
        if r == 0 as *mut u8 {
            let d = diag(c"error", c"probe.no-root", tcx);
            buf_str(d, c"no main.vl here: name the program's root (--root ROOT)\n");
            return 2;
        }
        if !load_program(r, 0, tcx, pcx, wgx) {
            let d = diag(c"error", c"probe.build", tcx);
            buf_str(d, c"the program does not parse\n");
            let t = try_begin(c"check", c_slice(c""), false, tcx, pcx);
            put_word(t, c_slice(r));
            try_end(t);
            return 1;
        }
        for k in 0..tcx.probes.count {
            if !locate(&mut *probe(k, tcx), tcx, pcx) {
                return 1;
            }
        }
        run_probes(r, tcx, pcx)
    }
}

// ---- Where a probe goes ----

// The statement beginning probe p's line, or the block that line opens:
// p.at, p.how, p.what; false (a diagnostic) when there is none.
fn locate(p: &mut Probe, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let s = c_slice(p.site);
        let mut colon = s.len() as i64 - 1;
        while s[colon as usize] != b':' {
            colon -= 1;
        }
        let name = &s[0..colon as usize];
        let mut f: i64 = -1;
        for g in 0..pcx.files.len() as i64 {
            let t = file_text(g, pcx);
            if f < 0 && t.len() > 0 && t[0] != b'<'
                && pcx.files[g as usize].kind == crate::base::SOURCE_VOLE
                && path_matches(t, name) {
                f = g;
            }
        }
        if f < 0 {
            let d = diag(c"error", c"probe.no-file", tcx);
            buf_str(d, c"no file '");
            buf_bytes(d, name);
            buf_str(d, c"' in the program (a probe goes in a file of it)\n");
            let t = try_begin(c"items", c_slice(c""), false, tcx, pcx);
            try_end(t);
            return false;
        }
        p.file = f;
        let first_line = line_index(pcx.files[f as usize].start, pcx);
        let idx = first_line + p.line - 1;
        if p.line < 1 || idx >= pcx.lines.count || (*pcx.lines.data.add(idx as usize)) >= pcx.files[f as usize].end {
            let d = diag(c"error", c"probe.no-line", tcx);
            buf_bytes(d, file_text(f, pcx));
            buf_str(d, c" has no line ");
            buf_int(d, p.line);
            buf_byte(d, b'\n');
            return false;
        }
        let ls = (*pcx.lines.data.add(idx as usize));
        let le = line_end(ls, pcx);
        let mut fp = ls;
        while fp < le && (get_src()[fp as usize] == b' ' || get_src()[fp as usize] == b'\t') {
            fp += 1;
        }
        // The statements (and blocks' last expressions) beginning the
        // line: the widest.
        let mut best: i64 = 0;
        let mut tail = false;
        for n in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[n as usize].kind != NodeKind::Block || pcx.nodes[n as usize].start < pcx.files[f as usize].start
                || pcx.nodes[n as usize].end > pcx.files[f as usize].end {
                continue;
            }
            for c in 0..pcx.nodes[n as usize].count + 1 {
                let st = if c < pcx.nodes[n as usize].count { child(n, c, pcx) } else { pcx.nodes[n as usize].a };
                if st <= 0 || pcx.nodes[st as usize].start != fp {
                    continue;
                }
                if best == 0
                    || pcx.nodes[st as usize].end - pcx.nodes[st as usize].start
                    > pcx.nodes[best as usize].end - pcx.nodes[best as usize].start {
                    best = st;
                    tail = c == pcx.nodes[n as usize].count;
                }
            }
        }
        p.what_at = fp;
        p.what_end = le;
        if best != 0 {
            let k = pcx.nodes[best as usize].kind;
            let e: i64 = if k == NodeKind::ExprStmt { pcx.nodes[best as usize].a } else if tail { best }
                else { 0 };
            if k == NodeKind::Let {
                // After it: its names are visible.
                let mut q = pcx.nodes[best as usize].end;
                if get_src()[(q - 1) as usize] != b';' {
                    while q < pcx.files[f as usize].end && (get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t') {
                        q += 1;
                    }
                    if get_src()[q as usize] == b';' {
                        q += 1;
                    } else {
                        q = pcx.nodes[best as usize].end;
                    }
                }
                p.at = q - pcx.files[f as usize].start;
                p.how = AT_AFTER;
                return true;
            }
            if e > 0 && (pcx.nodes[e as usize].kind == NodeKind::While || pcx.nodes[e as usize].kind == NodeKind::For
                || pcx.nodes[e as usize].kind == NodeKind::Loop) {
                // In the body, each time round: the last block opening on
                // this line.
                let body = opening_block(f, ls, le, pcx.nodes[e as usize].start, pcx.nodes[e as usize].end, pcx);
                if body > 0 {
                    p.at = pcx.nodes[body as usize].start + 1 - pcx.files[f as usize].start;
                    p.how = AT_BODY;
                    return true;
                }
            }
            p.at = fp - pcx.files[f as usize].start;
            p.how = AT_BEFORE;
            return true;
        }
        let b = opening_block(f, ls, le, pcx.files[f as usize].start, pcx.files[f as usize].end, pcx);
        if b > 0 {
            p.at = pcx.nodes[b as usize].start + 1 - pcx.files[f as usize].start;
            p.how = AT_BLOCK;
            return true;
        }
        let d = diag(c"error", c"probe.no-statement", tcx);
        buf_bytes(d, file_text(f, pcx));
        buf_byte(d, b':');
        buf_int(d, p.line);
        buf_str(d, c" begins no statement and opens no block; a probe goes at a line that does\n");
        // The nearest lines that do.
        let mut shown: i64 = 0;
        let mut dist: i64 = 1;
        while dist < 20 && shown < 2 {
            let lines: [i64; 2] = [p.line - dist, p.line + dist];
            for j in 0..2 {
                let l = lines[j as usize];
                if shown < 2 && l >= 1 && starts_statement(f, l, pcx) {
                    let t = try_begin(c"probe", c_slice(c""), false, tcx, pcx);
                    let w = buf_new();
                    buf_bytes(w, file_text(f, pcx));
                    buf_byte(w, b':');
                    buf_int(w, l);
                    put_word(t, buf_slice(w));
                    for x in 0..p.exprs.count {
                        put_word(t, c_slice((*p.exprs.data.add(x as usize)) as *mut u8));
                    }
                    put_run_args(t, tcx);
                    try_end(t);
                    shown += 1;
                }
            }
            dist += 1;
        }
        false
    }
}

// (0.25.2) The run's own words, after a `try:` line's probes: `--input
// FILE`, `-- ARGS...`, as given.
fn put_run_args(t: i64, tcx: &mut Tcx<Comp>) {
    if tcx.probe_input != 0 as *mut u8 {
        put_word(t, c_slice(c"--input"));
        put_word(t, c_slice(tcx.probe_input));
    }
    if tcx.probe_args.count > 0 {
        put_word(t, c_slice(c"--"));
    }
    for a in tcx.probe_args.items() {
        // UNSAFE: ARGS keeps the words as i64s; an integer cast to a pointer
        // SAFETY: each is a pointer probe_inner pushed, a word of argv
        let w = unsafe { a as *mut u8 };
        put_word(t, c_slice(w));
    }
}

// The last block of file f whose `{` is on the line [ls, le), within
// [lo, hi); 0: none.
fn opening_block(f: i64, ls: i64, le: i64, lo: i64, hi: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut b: i64 = 0;
    for n in 1..pcx.nodes.len() as i64 {
        let st = pcx.nodes[n as usize].start;
        if pcx.nodes[n as usize].kind == NodeKind::Block && st >= ls && st < le && st >= lo && st < hi
            && get_src()[st as usize] == b'{' && pcx.nodes[n as usize].end <= pcx.files[f as usize].end
            && (b == 0 || st > pcx.nodes[b as usize].start) {
            b = n;
        }
    }
    b
}

// Whether line l of file f begins a statement (for the try: lines).
fn starts_statement(f: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let idx = line_index(pcx.files[f as usize].start, pcx) + l - 1;
        if idx >= pcx.lines.count || (*pcx.lines.data.add(idx as usize)) >= pcx.files[f as usize].end {
            return false;
        }
        let ls = (*pcx.lines.data.add(idx as usize));
        let mut fp = ls;
        while fp < line_end(ls, pcx) && (get_src()[fp as usize] == b' ' || get_src()[fp as usize] == b'\t') {
            fp += 1;
        }
        for n in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[n as usize].kind == NodeKind::Block && pcx.nodes[n as usize].start >= pcx.files[f as usize].start
                && pcx.nodes[n as usize].end <= pcx.files[f as usize].end {
                for c in 0..pcx.nodes[n as usize].count {
                    if pcx.nodes[child(n, c, pcx) as usize].start == fp {
                        return true;
                    }
                }
            }
        }
        false
    }
}

// ---- Building and running ----

// A compiler error line `PATH:LINE:COL: ...` of the copy of file f (text
// `copy`): its offset in the copy and the message (after `] `), or -1.
fn error_offset<'a>(line: &'a [u8], path: &[u8], copy: &[u8], message: *mut &'a [u8]) -> i64 {
    unsafe {
        // (the path as the compiler prints it: `./` left out)
        let mut colon: i64 = 0;
        while colon < line.len() as i64 && line[colon as usize] != b':' {
            colon += 1;
        }
        if colon == 0 || colon >= line.len() as i64 || !path_matches(path, &line[0..colon as usize]) {
            return -1;
        }
        let mut i = colon + 1;
        let mut l: i64 = 0;
        while i < line.len() as i64 && line[i as usize] >= b'0' && line[i as usize] <= b'9' {
            l = l * 10 + (line[i as usize] - b'0') as i64;
            i += 1;
        }
        if i >= line.len() as i64 || line[i as usize] != b':' {
            return -1;
        }
        i += 1;
        let mut c: i64 = 0;
        while i < line.len() as i64 && line[i as usize] >= b'0' && line[i as usize] <= b'9' {
            c = c * 10 + (line[i as usize] - b'0') as i64;
            i += 1;
        }
        let mut m = i;
        while m < line.len() as i64 && line[m as usize] != b']' {
            m += 1;
        }
        let mut text = if m + 2 <= line.len() as i64 { &line[(m + 2) as usize..] }
            else { &line[i as usize..] };
        // (short diagnostics: ` | help: ...` after the message)
        for q in 0..text.len() as i64 {
            if q + 3 <= text.len() as i64 && text[q as usize..(q + 3) as usize] == b" | " {
                text = &text[0..q as usize];
                break;
            }
        }
        *message = text;
        // The offset of line l, column c.
        let mut at: i64 = 0;
        let mut k: i64 = 1;
        while k < l && at < copy.len() as i64 {
            if copy[at as usize] == b'\n' {
                k += 1;
            }
            at += 1;
        }
        at + c - 1
    }
}

// The lines of a compiler's output.
fn next_line(s: &[u8], i: i64) -> i64 {
    let mut e = i;
    while e < s.len() as i64 && s[e as usize] != b'\n' {
        e += 1;
    }
    e
}

// The probe and expression whose code holds offset `at` of file f's copy:
// k * 64 + x, or -1 (x: 63 when the probe's code but no expression's).
fn holder(f: i64, at: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        for k in 0..tcx.probes.count {
            let p = probe(k, tcx);
            if p.file == f && at >= p.from && at < p.to {
                let mut x: i64 = 63;
                for j in 0..p.spans.count {
                    if at >= (*p.spans.data.add(j as usize)) {
                        x = j;
                    }
                }
                return k * 64 + x;
            }
        }
        -1
    }
}

// The files with probes, each once.
fn probe_files(files: &mut IntVec, tcx: &Tcx<Comp>) {
    unsafe {
        for k in 0..tcx.probes.count {
            let f = probe(k, tcx).file;
            let mut seen = false;
            for j in 0..files.count {
                seen = seen || (*files.data.add(j as usize)) == f;
            }
            if !seen {
                files.push(f);
            }
        }
    }
}

// Writes the copies (typing: the type questions) into dir: argv words
// `--overlay PATH COPY` for each, appended to args; the copies' texts in
// copies (buffers, by the order of files).
fn write_copies(dir: *mut u8, files: IntVec, typing: bool, args: &mut IntVec, copies: &mut IntVec,
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        copies.count = 0;
        for j in 0..files.count {
            let f = (*files.data.add(j as usize));
            let original = buf_new();
            if !read_file_if(pcx.files[f as usize].path, original) {
                let d = diag(c"error", c"probe.no-file", tcx);
                buf_str(d, c"cannot read '");
                buf_str(d, pcx.files[f as usize].path);
                buf_str(d, c"'\n");
                return false;
            }
            let copy = copy_with_probes(f, buf_slice(original), typing, tcx, pcx);
            let path = buf_new();
            buf_str(path, dir);
            buf_bytes(path, b"/copy");
            buf_int(path, j);
            // (not .vl: no tool takes them for sources)
            buf_bytes(path, b".probe");
            let p = buf_cstr(path);
            if !write_file_if(p, buf_slice(copy)) {
                let d = diag(c"error", c"probe.no-file", tcx);
                buf_str(d, c"cannot write '");
                buf_str(d, p);
                buf_str(d, c"'\n");
                return false;
            }
            args.push(c"--overlay" as i64);
            args.push(pcx.files[f as usize].path as i64);
            args.push(p as i64);
            copies.push(copy);
        }
        true
    }
}

fn run_words(args: IntVec, out: i64) -> i64 {
    unsafe {
        let argv = alloc_array::<*mut u8>(args.count + 1);
        for i in 0..args.count {
            (*argv.add(i as usize)) = (*args.data.add(i as usize)) as *mut u8;
        }
        (*argv.add(args.count as usize)) = 0 as *mut u8;
        run_capture(argv, out)
    }
}

// The compiler's errors that are not in a probe's code: the program's own
// (printed, with a count); a probe's: per expression, `bad` (the message),
// its type (the "expected '()', got 'T'" of the type questions), or (not
// typing) opaque when a trait is missing. Whether everything is answered
// (no error but the type questions' and missing traits).
fn read_errors(log: &[u8], files: IntVec, copies: IntVec, typing: bool, tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut ok = true;
        // (each expression one level a round)
        let mut bumped = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut i: i64 = 0;
        while i < log.len() as i64 {
            let e = next_line(log, i);
            let line = &log[i as usize..e as usize];
            i = e + 1;
            if !(contains(line, b": error") || contains(line, b": warning")) {
                continue;
            }
            let is_error = contains(line, b": error");
            let mut found: i64 = -1;
            let mut msg = &line[0..0];
            for j in 0..files.count {
                let f = (*files.data.add(j as usize));
                let at = error_offset(line, c_slice(pcx.files[f as usize].path), buf_slice((*copies.data.add(j as usize))),
                    &mut msg);
                if at >= 0 && found < 0 {
                    found = holder(f, at, tcx);
                }
            }
            if !is_error {
                continue;
            }
            if found < 0 {
                ok = false;
                let d = diag(c"error", c"probe.build", tcx);
                buf_str(d, c"the program does not build: ");
                buf_bytes(d, line);
                buf_byte(d, b'\n');
                continue;
            }
            let p = probe(found / 64, tcx);
            let x = found % 64;
            let got = "expected '()', got '";
            if typing && x < 63 && starts(msg, got.as_bytes()) && msg[(msg.len() as i64 - 1) as usize] == b'\'' {
                let t = buf_new();
                buf_bytes(t, &msg[got.len() as i64 as usize..(msg.len() as i64 - 1) as usize]);
                (*p.types.data.add(x as usize)) = t;
                continue;
            }
            if !typing && x < 63 && contains(msg, b"does not implement") {
                if (*p.opaque.data.add(x as usize)) < 2 && !has(bumped, found) {
                    (*p.opaque.data.add(x as usize)) = (*p.opaque.data.add(x as usize)) + 1;
                    bumped.push(found);
                }
                continue;
            }
            ok = false;
            let d = diag(c"error", c"probe.expr", tcx);
            buf_str(d, p.site);
            if x < 63 {
                buf_str(d, c": in '");
                buf_str(d, (*p.exprs.data.add(x as usize)) as *mut u8);
                buf_str(d, c"'");
            }
            buf_str(d, c": ");
            buf_bytes(d, msg);
            buf_byte(d, b'\n');
        }
        ok
    }
}

fn contains(hay: &[u8], needle: &[u8]) -> bool {
    if needle.len() > hay.len() {
        return false;
    }
    for i in 0..hay.len() as i64 - needle.len() as i64 + 1 {
        if &hay[i as usize..(i + needle.len() as i64) as usize] == needle {
            return true;
        }
    }
    false
}

fn starts(s: &[u8], p: &[u8]) -> bool {
    s.len() >= p.len() && s[0..p.len()] == p
}

// The directory of the copies and the build: out of the program's
// source tree (0.25.2, proc::scratch_dir: the checkout's target/, else
// $TMPDIR), by the root.
fn work_dir(root: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    scratch_dir(root, b"probe", pcx)
}

fn path_in(dir: *mut u8, name: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    buf_byte(b, b'/');
    buf_bytes(b, name);
    buf_cstr(b)
}

// The probes run (run_probes_in), then their copies of the sources
// removed: the build and the outputs stay for the report to name.
fn run_probes(root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let status = run_probes_in(root, tcx, pcx);
    let dir = work_dir(root, pcx);
    let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    probe_files(&mut files, tcx);
    for j in 0..files.count {
        let b = buf_new();
        buf_str(b, dir);
        buf_bytes(b, b"/copy");
        buf_int(b, j);
        buf_bytes(b, b".probe");
        remove_file(buf_cstr(b));
    }
    status
}

fn run_probes_in(root: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let dir = work_dir(root, pcx);
        let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        probe_files(&mut files, tcx);
        let mut copies = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..tcx.probes.count {
            let p = probe(k, tcx);
            for _ in 0..p.exprs.count {
                p.types.push(-1);
                p.opaque.push(0);
            }
        }
        // The types, from check.
        let mut typed = false;
        for k in 0..tcx.probes.count {
            typed = typed || probe(k, tcx).exprs.count > 0;
        }
        if typed {
            let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            args.push(pcx.prog as i64);
            args.push(c"check" as i64);
            args.push(root as i64);
            if !write_copies(dir, files, true, &mut args, &mut copies, tcx, pcx) {
                return 1;
            }
            let log = buf_new();
            run_words(args, log);
            if !read_errors(buf_slice(log), files, copies, true, tcx, pcx) {
                return 1;
            }
        }
        // The build (again with opaque values when a trait is missing).
        let bin = path_in(dir, b"prog");
        let mut built = false;
        let mut round: i64 = 0;
        while !built && round < 3 {
            let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            args.push(pcx.prog as i64);
            args.push(root as i64);
            args.push(c"-o" as i64);
            args.push(bin as i64);
            args.push(c"--diagnostics=short" as i64);
            if tcx.probe_opt == 0 as *mut u8 || !streq(tcx.probe_opt, c"-O0") {
                args.push(c"--trace" as i64);
            }
            if tcx.probe_opt != 0 as *mut u8 {
                args.push(tcx.probe_opt as i64);
            }
            if !write_copies(dir, files, false, &mut args, &mut copies, tcx, pcx) {
                return 1;
            }
            let log = buf_new();
            let rc = run_words(args, log);
            if rc == 0 {
                built = true;
            } else {
                let mut opaque_before: i64 = 0;
                for k in 0..tcx.probes.count {
                    for x in 0..probe(k, tcx).opaque.count {
                        opaque_before += (*probe(k, tcx).opaque.data.add(x as usize));
                    }
                }
                let answered = read_errors(buf_slice(log), files, copies, false, tcx, pcx);
                let mut opaque_after: i64 = 0;
                for k in 0..tcx.probes.count {
                    for x in 0..probe(k, tcx).opaque.count {
                        opaque_after += (*probe(k, tcx).opaque.data.add(x as usize));
                    }
                }
                if !answered || opaque_after == opaque_before {
                    if answered {
                        let d = diag(c"error", c"probe.build", tcx);
                        buf_str(d, c"the program with its probes does not build:\n");
                        buf_bytes(d, buf_slice(log));
                    }
                    return 1;
                }
            }
            round += 1;
        }
        if !built {
            return 1;
        }
        let out_path = path_in(dir, b"out");
        let err_path = path_in(dir, b"err");
        let status = run_program(bin, out_path, err_path, tcx);
        report(status, out_path, err_path, tcx, pcx)
    }
}
