// `volec fix --only tidy-imports` (0.12; docs/refactor.md): a
// module's `use` lines in the codebase's style. The `use` items of one
// module with the same path (and the same `pub`) become one, where the
// first of them is; its names are sorted (byte order: capitals first) and
// written `use p::a;` for one, `use p::{a, b};` when the line fits in 100
// columns, else wrapped:
//
//   use p::{
//       a, b, c,
//       d,
//   };
//
// A name imported under another name has a line of its own (`use p::a as
// b;`), after the others. A `use` with a comment on its lines, or sharing
// a line with other code, is left as it is; one with a comment right
// above it is not merged into another.
//
// `refactor move` and `split` tidy the imports of the files they edit
// (tidy_round: a round of `fix --only tidy-imports --tidy-edited` on the
// edited program), and so does `fix --only reexports,tidy-imports`.

use crate::base::{
    IntVec, SRC, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern, streq, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::modules::{child_module, file_of_pos, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::tools::ctx::Tcx;
use crate::tools::edit::edit_replace;
use crate::tools::edit::apply::{copy_rewritten, overlay_args};
use crate::tools::edit::cli::delete_lines;
use crate::tools::edit::items::node_head;
use crate::tools::proc::run_capture;
use crate::tools::query::defs::mod_fqn_text;
use crate::tools::query::diagnostics::sym_less;
use crate::tools::query::positions::{line_end, line_start};
use crate::tools::query::refs::ref_in;

const LINE_WIDTH: i64 = 100;

// Whether file f is tidied: a file of the program (with TIDY_EDITED, one
// the edit changed).
fn file_tidied(f: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if pcx.files[f].path[0] == '<' {
            return false;
        }
        if !tcx.tidy_edited {
            return true;
        }
        var k = 0;
        while k < pcx.overlay.count {
            if streq(pcx.overlay.data[k] as *u8, pcx.files[f].path) {
                return true;
            }
            k += 2;
        }
        false
    }
}

// Whether Use item u imports names (not `*`, not a C header).
fn name_use(u: i64, pcx: Ctx<Comp>) -> bool {
    pcx.nodes[u].kind == NodeKind::Use && pcx.nodes[u].d != 2 && pcx.nodes[u].b != 1
        && pcx.nodes[u].count > 0
}

// Whether Use item u has its lines to itself, without a comment: only
// blanks before it on its first line, and after it on its last.
fn alone(u: i64, pcx: Ctx<Comp>) -> bool {
    let head = node_head(pcx.nodes[u].start, pcx);
    var p = line_start(head, pcx);
    while p < head {
        if SRC[p] != ' ' && SRC[p] != '\t' {
            return false;
        }
        p += 1;
    }
    let e = line_end(pcx.nodes[u].end - 1, pcx);
    for q in head..e {
        if SRC[q] == '/' && SRC[q + 1] == '/' {
            return false;
        }
    }
    for q in pcx.nodes[u].end..e {
        if SRC[q] != ' ' && SRC[q] != '\t' && SRC[q] != '\r' {
            return false;
        }
    }
    true
}

// Whether the line above Use item u is a comment.
fn comment_above(u: i64, pcx: Ctx<Comp>) -> bool {
    let ls = line_start(node_head(pcx.nodes[u].start, pcx), pcx);
    let f = file_of_pos(ls, pcx);
    if ls <= pcx.files[f].start {
        return false;
    }
    var p = line_start(ls - 1, pcx);
    while SRC[p] == ' ' || SRC[p] == '\t' {
        p += 1;
    }
    SRC[p] == '/' && SRC[p + 1] == '/'
}

// The path of Use item u (its segments before the names), as a symbol.
pub fn use_path_sym(u: i64, pcx: inout Ctx<Comp>) -> i64 {
    let path = pcx.nodes[u].c;
    let out = buf_new();
    for i in 0..pcx.nodes[path].count {
        if i > 0 {
            buf_str(out, c"::");
        }
        buf_bytes(out, sym_text(pcx.nodes[child(path, i, pcx)].a, pcx));
    }
    crate::base::intern(buf_slice(out), &pcx)
}

// (0.14) Whether path text p starts with a child module of module m (its
// first segment, before `::`).
fn starts_with_child(p: [u8], m: i64, pcx: inout Ctx<Comp>) -> bool {
    var e = 0;
    while e < p.len as i64 && p[e] != ':' {
        e += 1;
    }
    e > 0 && child_module(m, intern(p[0..e], &pcx), pcx) >= 0
}

// (0.14) The path of Use item u of module m from `crate` (`crate::m::a`)
// when it is written relative to m (`a`: a child module of m first), else
// as written; a symbol.
pub fn use_abs_path(u: i64, m: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let p = use_path_sym(u, &pcx);
    let t = sym_text(p, pcx);
    var e = 0;
    while e < t.len as i64 && t[e] != ':' {
        e += 1;
    }
    if m < 0 || child_module(m, intern(t[0..e], &pcx), pcx) < 0 {
        return p;
    }
    let out = buf_new();
    buf_bytes(out, mod_fqn_text(m, &tcx, &pcx));
    buf_str(out, c"::");
    buf_bytes(out, t);
    intern(buf_slice(out), &pcx)
}

// (0.14) Whether module m writes the paths of its child modules relative
// (`use a::x;`) rather than from `crate` (`use crate::m::a::x;`): as most
// of its `use` items that can be written either way do (a tie: as the
// first); false when none can.
pub fn relative_style(m: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    let known = tcx.styles.get(m + 1);
    if known != 0 {
        return known == 2;
    }
    var rel = 0;
    var abs = 0;
    var first_rel = false;
    for u in 1..pcx.nodes.len() as i64 {
        if !name_use(u, pcx) || module_of(u, &pcx) != m || pcx.nodes[u].c == 0 {
            continue;
        }
        let p = use_path_sym(u, &pcx);
        let a = use_abs_path(u, m, &tcx, &pcx);
        if a != p {
            if rel + abs == 0 {
                first_rel = true;
            }
            rel += 1;
        } else if styled_path(a, m, true, &tcx, &pcx) != a {
            abs += 1;
        }
    }
    let relative = rel > abs || (rel == abs && rel > 0 && first_rel);
    tcx.styles.put(m + 1, if relative { 2 } else { 1 });
    relative
}

// (0.14) Path a (from `crate`) as module m writes it: with `relative`,
// without m's own path when a child module of m follows it.
pub fn styled_path(a: i64, m: i64, relative: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    if !relative || m < 0 {
        return a;
    }
    let t = sym_text(a, pcx);
    let own = mod_fqn_text(m, &tcx, &pcx);
    let n = own.len as i64 + 2;
    if t.len as i64 <= n || !crate::tools::proc::same_bytes(t[0..own.len], own)
        || t[own.len] != ':'
        || t[own.len as i64 + 1] != ':' || !starts_with_child(t[n..], m, &pcx) {
        return a;
    }
    intern(t[n..], &pcx)
}

// The text of the `use` items importing `names` (symbols) and `aliased`
// (pairs: name, its new name) from `path`, indented by `indent`, `pub`
// when public: one line for one name, the names between braces on one
// line when it fits in LINE_WIDTH columns, else wrapped; then a line per
// aliased name. Names are sorted, each once. No newline after the last
// line.
pub fn put_use_text(out: i64, indent: [u8], public: bool, path: [u8], names: *IntVec,
    aliased: *IntVec, pcx: Ctx<Comp>) {
    unsafe {
        var plain = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..(*names).count {
            let n = (*names).data[i];
            var seen = false;
            for j in 0..plain.count {
                if plain.data[j] == n {
                    seen = true;
                }
            }
            if !seen {
                plain.push(n);
            }
        }
        for k in 1..plain.count {
            var j = k;
            while j > 0 && sym_less(plain.data[j], plain.data[j - 1], pcx) {
                let t = plain.data[j];
                plain.data[j] = plain.data[j - 1];
                plain.data[j - 1] = t;
                j -= 1;
            }
        }
        var lines = 0;
        if plain.count > 0 {
            let line = buf_new();
            buf_bytes(line, indent);
            if public {
                buf_str(line, c"pub ");
            }
            buf_str(line, c"use ");
            buf_bytes(line, path);
            buf_str(line, c"::");
            let head = crate::base::BUFS[line].len;
            if plain.count > 1 {
                buf_byte(line, '{');
            }
            for i in 0..plain.count {
                if i > 0 {
                    buf_str(line, c", ");
                }
                buf_bytes(line, sym_text(plain.data[i], pcx));
            }
            if plain.count > 1 {
                buf_byte(line, '}');
            }
            buf_byte(line, ';');
            if crate::base::BUFS[line].len <= LINE_WIDTH || plain.count == 1 {
                buf_bytes(out, buf_slice(line));
            } else {
                let s = buf_slice(line);
                buf_bytes(out, s[0..head]);
                buf_str(out, c"{\n");
                var col = 0;
                for i in 0..plain.count {
                    let w = sym_text(plain.data[i], pcx);
                    if col > 0 && col + 2 + w.len as i64 + 1 > LINE_WIDTH {
                        buf_str(out, c",\n");
                        col = 0;
                    } else if col > 0 {
                        buf_str(out, c", ");
                        col += 2;
                    }
                    if col == 0 {
                        buf_bytes(out, indent);
                        buf_str(out, c"    ");
                        col = indent.len as i64 + 4;
                    }
                    buf_bytes(out, w);
                    col += w.len as i64;
                }
                buf_str(out, c",\n");
                buf_bytes(out, indent);
                buf_str(out, c"};");
            }
            lines += 1;
        }
        var k = 0;
        while k < (*aliased).count {
            let a = (*aliased).data[k];
            let b = (*aliased).data[k + 1];
            var seen = false;
            var j = 0;
            while j < k {
                if (*aliased).data[j] == a && (*aliased).data[j + 1] == b {
                    seen = true;
                }
                j += 2;
            }
            k += 2;
            if seen {
                continue;
            }
            if lines > 0 {
                buf_byte(out, '\n');
            }
            buf_bytes(out, indent);
            if public {
                buf_str(out, c"pub ");
            }
            buf_str(out, c"use ");
            buf_bytes(out, path);
            buf_str(out, c"::");
            buf_bytes(out, sym_text(a, pcx));
            buf_str(out, c" as ");
            buf_bytes(out, sym_text(b, pcx));
            buf_byte(out, ';');
            lines += 1;
        }
    }
}

// The names of Use item u into names, and its renamed ones (name, new
// name) into aliased.
pub fn use_names(u: i64, names: inout IntVec, aliased: inout IntVec, pcx: Ctx<Comp>) {
    for k in 0..pcx.nodes[u].count {
        let id = child(u, k, pcx);
        if pcx.nodes[id].b != 0 {
            aliased.push(pcx.nodes[id].a);
            aliased.push(pcx.nodes[id].b);
        } else {
            names.push(pcx.nodes[id].a);
        }
    }
}

// The edits tidying the imports; how many `use` items they rewrite or
// merge away.
pub fn tidy_import_edits(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var fixes = 0;
        for f in 0..pcx.files.len() as i64 {
            if !file_tidied(f, tcx, pcx) {
                continue;
            }
            var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for u in 1..pcx.nodes.len() as i64 {
                if name_use(u, pcx) && file_of_pos(pcx.nodes[u].start, pcx) == f
                    && ref_in(pcx.nodes[u].start, &pcx)
                    && alone(u, pcx) {
                    uses.push(u);
                }
            }
            var done = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..uses.count {
                done.push(0);
            }
            for i in 0..uses.count {
                if done.data[i] != 0 {
                    continue;
                }
                let u = uses.data[i];
                let public = (pcx.nodes[u].p & ITEM_PUBLIC) != 0;
                let m = module_of(u, &pcx);
                // (0.14: the paths of child modules in the module's style)
                let relative = relative_style(m, &tcx, &pcx);
                let path = styled_path(use_abs_path(u, m, &tcx, &pcx), m, relative, &tcx, &pcx);
                // Its group: the later ones of the module with its path.
                var group = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                group.push(u);
                for j in i + 1..uses.count {
                    let v = uses.data[j];
                    if done.data[j] == 0 && module_of(v, &pcx) == m
                        && ((pcx.nodes[v].p & ITEM_PUBLIC) != 0) == public
                        && styled_path(use_abs_path(v, m, &tcx, &pcx), m, relative, &tcx, &pcx)
                        == path
                        && !comment_above(v, pcx) {
                        group.push(v);
                        done.data[j] = 1;
                    }
                }
                var names = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                var aliased = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                for g in 0..group.count {
                    use_names(group.data[g], &names, &aliased, pcx);
                }
                let from = line_start(node_head(pcx.nodes[u].start, pcx), pcx);
                let text = buf_new();
                put_use_text(text, SRC[from..node_head(pcx.nodes[u].start, pcx)], public,
                    sym_text(path, pcx), &names, &aliased, pcx);
                // (unchanged: the group is on consecutive lines, and is the text)
                var consecutive = true;
                for g in 1..group.count {
                    let v = group.data[g];
                    if line_start(node_head(pcx.nodes[v].start, pcx), pcx)
                        != line_end(pcx.nodes[group.data[g - 1]].end - 1, pcx) + 1 {
                        consecutive = false;
                    }
                }
                let last = group.data[group.count - 1];
                if consecutive
                    && crate::tools::proc::same_bytes(buf_slice(text),
                        SRC[from..pcx.nodes[last].end]) {
                    continue;
                }
                if !edit_replace(from, pcx.nodes[u].end, text, &pcx) {
                    continue;
                }
                for g in 1..group.count {
                    let v = group.data[g];
                    delete_lines(line_start(node_head(pcx.nodes[v].start, pcx), pcx),
                        pcx.nodes[v].end, &pcx);
                }
                fixes += group.count;
            }
        }
        fixes
    }
}

// The round of `fix --only tidy-imports --tidy-edited` an edit runs on
// the program it edited (refactor move, split): the files whose imports
// it tidied have their new texts. False when it could not run (then the
// edit stands as it is).
pub fn tidy_round(root: *u8, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    args.push(pcx.prog as i64);
    args.push(c"fix" as i64);
    args.push(c"--round" as i64);
    args.push(c"--only" as i64);
    args.push(c"tidy-imports" as i64);
    args.push(c"--tidy-edited" as i64);
    if tcx.target_name != 0 as *u8 {
        args.push(c"--target" as i64);
        args.push(tcx.target_name as i64);
    }
    overlay_args(&args, tcx, pcx);
    args.push(root as i64);
    args.push(0);
    let out = buf_new();
    if run_capture(args.data as **u8, out) != 0 {
        return false;
    }
    let t = buf_slice(out);
    var i = 0;
    while i < t.len as i64 {
        var e = i;
        while e < t.len as i64 && t[e] != '\n' {
            e += 1;
        }
        let line = t[i..e];
        if line.len > 5 && line[0] == 'f' && line[4] == '\t' {
            copy_rewritten(line[5..line.len], &tcx, pcx);
        }
        i = e + 1;
    }
    true
}
