// `volec query unsafe [FILE...|std] [--no-std] [--json] [--summary]
// [--unjustified]` and `volec check`'s `unsafe.unjustified` (0.25.3):
// every unsafe site of a program, what it does and whether it says why.
//
// A site is an `unsafe { }` block, an `unsafe fn` or an `extern` block
// (vole has no `unsafe impl`). The sites are found in each file's tokens
// (scan_tokens: a cached program has none of the lexer's), so code
// the checker never reaches (a generic never instantiated) is listed too.
// What a site does is what the checker counted while it read the program
// (front/check/unsafety.vl, AUDIT_OPS): each unsafe operation inside it,
// the innermost site holding it. A site's class is its operations' first
// in this order:
//
//   ffi             a C function called (not one of the allocator's)
//   alloc           malloc, free, realloc, a Gpa's raw functions
//   intrinsic       std::arch, a compiler builtin
//   transmute/cast  an integer made a pointer, an `unsafe fn` as a value,
//                   a `cast`/`transmute`
//   raw-pointer     a raw pointer dereferenced, indexed, sliced; an `unsafe
//                   fn` that takes one called
//   static-mut      the same through a pointer held in a static (the
//                   compiler's tables: `NODES[n]`, `TABLE.data[i]`)
//   other           a union's field read, another `unsafe fn` called, or
//                   nothing (an `unsafe fn` whose contract is the caller's)
//
// An extern block is ffi.
//
// A site is justified when the comments right above it hold `UNSAFE:`
// (why it cannot be safe) and `SAFETY:` (why it is sound): the comment
// lines directly above the statement or item the site starts (no blank
// line between), the comments inside that statement before the site, and
// a comment ending the site's line. `volec check` warns about each site of
// the program (not std's) without both (an error with --deny-warnings),
// and tools/unsafe-diff-check.py, the commit hook's, asks this command.

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_tool_command, report_error_tries};
use crate::base::json::{buf_json_str, get_diag_json};
use crate::front::check::unsafety::{
    U_C_CALL, U_DEREF, U_FIELD, U_FN_VALUE, U_INDEX, U_INT_PTR, U_METHOD, U_SLICE, U_UNION,
    U_UNSAFE_CALL,
};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, is_within, module_at, within_std};
use crate::front::stdtree::std_file_line;
use crate::front::types::TyKind;
use crate::tools::ctx::Tcx;
use crate::tools::query::c_slice;
use crate::tools::query::defs::mod_fqn_text;
use crate::tools::query::diagnostics::{diags, put_cword, put_root, try_end};
use crate::tools::query::positions::enclosing;

// The kinds of site.
const S_BLOCK: i64 = 0;
const S_FN: i64 = 1;
const S_EXTERN: i64 = 2;

// The justification comments found (bits).
const J_UNSAFE: i64 = 1;
const J_SAFETY: i64 = 2;
const J_BOTH: i64 = 3;

// The classes, in the order a site takes the first of its operations'.
const C_FFI: i64 = 0;
const C_ALLOC: i64 = 1;
const C_INTRINSIC: i64 = 2;
const C_CAST: i64 = 3;
const C_RAW: i64 = 4;
const C_STATIC: i64 = 5;
const C_OTHER: i64 = 6;
const N_CLASSES: i64 = 7;

fn class_name(c: i64) -> &'static [u8] {
    if c == C_FFI { b"ffi" } else if c == C_ALLOC { b"alloc" }
    else if c == C_INTRINSIC { b"intrinsic" } else if c == C_CAST { b"transmute/cast" }
    else if c == C_RAW { b"raw-pointer" } else if c == C_STATIC { b"static-mut" } else { b"other" }
}

fn kind_name(k: i64) -> &'static [u8] {
    if k == S_BLOCK { b"block" } else if k == S_FN { b"unsafe fn" } else { b"extern" }
}

// ---- The tables of the front end ----
//
// The front end's tables (SRC, FILES, TOKS, SYMS, FNS, TYPES, DEFS) are
// raw pointers until the compiler moves them to std's Vec (0.25.4): each
// read of them is one of these functions.

fn file_bytes(f: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    &get_src()[pcx.files[f as usize].start as usize..pcx.files[f as usize].end as usize]
}

fn file_start(f: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.files[f as usize].start
}

fn file_path(f: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    // UNSAFE: FILES is the front end's table, a raw pointer.
    // SAFETY: 0 <= f < FILE_COUNT (every caller's loop or a site's file).
    unsafe {
        let mut p = pcx.files[f as usize].path;
        while (*p.add(0)) == b'.' && (*p.add(1)) == b'/' {
            p = p.add(2);
        }
        p
    }
}

fn file_module(f: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.files[f as usize].module
}

// The name of function f as messages write it.
fn fn_name(f: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    sym_text(pcx.fns[f as usize].display, pcx)
}

fn fn_module(f: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.fns[f as usize].module
}

// Whether function f takes a raw pointer (`*T`, not `&T`).
fn takes_raw_pointer(f: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.fns[f as usize].param_count {
        let t = pcx.tlists.get(pcx.fns[f as usize].params + i);
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0 {
            return true;
        }
    }
    false
}

// The path of definition d.
fn def_path(d: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    sym_text(pcx.defs[d as usize].fqn, pcx)
}

// Argument k of the command line (a C string kept as a number).
fn arg_text(args: IntVec, k: i64) -> &'static [u8] {
    c_slice(args.get(k) as *mut u8)
}

// ---- Sites ----

// The tokens of a file as the sites need them (scan_tokens): the words
// `unsafe`, `fn` and `extern`, a string right after `extern`, the
// brackets, `;` and the comments. Other words, numbers, characters,
// strings and operators are not kept.
const K_COMMENT: i64 = 0;
const K_UNSAFE: i64 = 1;
const K_FN: i64 = 2;
const K_EXTERN: i64 = 3;
const K_STR: i64 = 4;
const K_LBRACE: i64 = 5;
const K_RBRACE: i64 = 6;
const K_LPAREN: i64 = 7;
const K_RPAREN: i64 = 8;
const K_LBRACKET: i64 = 9;
const K_RBRACKET: i64 = 10;
const K_SEMI: i64 = 11;

// The tokens of text (a file's), three numbers each (kind, start, end),
// into toks. Not the lexer (a cached program has no tokens, and lexing
// the compiler again cost `check` a tenth of its time): a scan that knows
// comments (nested `/* */` too), strings (an f-string's holes, which hold
// strings of their own), characters and labels.
fn scan_tokens(text: &[u8], from: i64, to: i64, toks: &mut IntVec) {
    let n = text.len() as i64;
    let mut i = from;
    // (the last token was `extern`: a string is kept)
    let mut after_extern = false;
    while i < to {
        let c = text[i as usize];
        if c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' {
            i += 1;
            continue;
        }
        let mut kind: i64 = -1;
        let mut j = i + 1;
        if c == b'/' && i + 1 < n
            && (text[(i + 1) as usize] == b'/' || text[(i + 1) as usize] == b'*') {
            j = comment_end(text, i);
            kind = K_COMMENT;
        } else if c == b'"' {
            // (an f-string: its prefix is the word before)
            let f = i > 0 && text[(i - 1) as usize] == b'f';
            j = string_end(text, i + 1, f);
            if after_extern {
                kind = K_STR;
            }
        } else if c == b'\'' {
            // a character ('a', '\n', '\'') or a label ('outer)
            if i + 1 < n && text[(i + 1) as usize] == b'\\' {
                j = i + 3;
                while j < n && text[j as usize] != b'\'' {
                    j += 1;
                }
                j += 1;
            } else if i + 2 < n && text[(i + 2) as usize] == b'\'' {
                j = i + 3;
            }
        } else if c == b'{' {
            kind = K_LBRACE;
        } else if c == b'}' {
            kind = K_RBRACE;
        } else if c == b'(' {
            kind = K_LPAREN;
        } else if c == b')' {
            kind = K_RPAREN;
        } else if c == b'[' {
            kind = K_LBRACKET;
        } else if c == b']' {
            kind = K_RBRACKET;
        } else if c == b';' {
            kind = K_SEMI;
        } else if is_word_byte(c) {
            // a word: a name, a keyword, a number
            while j < n && is_word_byte(text[j as usize]) {
                j += 1;
            }
            // (the keywords' first bytes, then the words)
            if (c == b'u' || c == b'f' || c == b'e') && j - i <= 6 {
                let w = &text[i as usize..j as usize];
                kind = if w == b"unsafe" { K_UNSAFE } else if w == b"fn" { K_FN }
                    else if w == b"extern" { K_EXTERN } else { -1 };
            }
        }
        // (else an operator's byte: not kept)
        if j > n {
            j = n;
        }
        if kind != K_COMMENT {
            after_extern = kind == K_EXTERN;
        }
        if kind >= 0 {
            toks.push(kind);
            toks.push(i);
            toks.push(j);
        }
        i = j;
    }
}

fn is_word_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// The end of the comment starting at i (`//` to the line's end, `/*` to
// its `*/`, nested).
pub fn comment_end(text: &[u8], i: i64) -> i64 {
    let n = text.len() as i64;
    if text[(i + 1) as usize] == b'/' {
        let mut j = i;
        while j < n && text[j as usize] != b'\n' {
            j += 1;
        }
        return j;
    }
    let mut depth: i64 = 0;
    let mut j = i;
    while j + 1 < n {
        if text[j as usize] == b'/' && text[(j + 1) as usize] == b'*' {
            depth += 1;
            j += 2;
        } else if text[j as usize] == b'*' && text[(j + 1) as usize] == b'/' {
            depth -= 1;
            j += 2;
            if depth == 0 {
                return j;
            }
        } else {
            j += 1;
        }
    }
    n
}

// The end of the string whose text starts at i (after its `"`): after its
// closing quote. In an f-string's holes (`{x}`, not `{{`) a quote starts
// a string of the hole's own.
pub fn string_end(text: &[u8], i: i64, f: bool) -> i64 {
    let n = text.len() as i64;
    let mut j = i;
    let mut hole: i64 = 0;
    while j < n {
        let c = text[j as usize];
        if c == b'\\' {
            j += 2;
            continue;
        }
        if hole > 0 {
            if c == b'"' {
                j = string_end(text, j + 1, false);
                continue;
            }
            if c == b'{' {
                hole += 1;
            } else if c == b'}' {
                hole -= 1;
            }
            j += 1;
            continue;
        }
        if c == b'"' {
            return j + 1;
        }
        if f && c == b'{' {
            if j + 1 < n && text[(j + 1) as usize] == b'{' {
                j += 2;
                continue;
            }
            hole = 1;
        }
        j += 1;
    }
    n
}

fn tk(toks: IntVec, i: i64) -> i64 {
    toks.get(3 * i)
}

fn tstart(toks: IntVec, i: i64) -> i64 {
    toks.get(3 * i + 1)
}

fn tend(toks: IntVec, i: i64) -> i64 {
    toks.get(3 * i + 2)
}

// The J_* bits of text (comments).
fn marks(text: &[u8]) -> i64 {
    let mut bits: i64 = 0;
    let mut i: i64 = 0;
    while i + 7 <= text.len() as i64 {
        if text[i as usize] == b'U' && i + 7 <= text.len() as i64
            && text[i as usize..(i + 7) as usize] == b"UNSAFE:" {
            bits |= J_UNSAFE;
        } else if text[i as usize] == b'S' && text[i as usize..(i + 7) as usize] == b"SAFETY:" {
            bits |= J_SAFETY;
        }
        i += 1;
    }
    bits
}

// The comments right above the site at token i (see the head of the
// file): its J_* bits.
fn justification(text: &[u8], toks: IntVec, i: i64) -> i64 {
    // The first token of the statement or item: back over what the site
    // is inside of on its line, up to a `;`, `{` or `}` outside brackets.
    let j = statement_first(toks, i);
    // the statement's first byte: past blanks and comments
    let gap_from: i64 = if j >= 0 { tend(toks, j) } else { 0 };
    let mut first = gap_from;
    while first < text.len() as i64 {
        let c = text[first as usize];
        if c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' {
            first += 1;
        } else if c == b'/' && first + 1 < text.len() as i64
            && (text[(first + 1) as usize] == b'/' || text[(first + 1) as usize] == b'*') {
            first = comment_end(text, first);
        } else {
            break;
        }
    }
    let mut bits: i64 = 0;
    // The comment lines directly above the first byte: the whole lines of
    // the gap before it, from the last up, to a blank line.
    let gap = &text[gap_from as usize..first as usize];
    let mut e = gap.len() as i64;
    // (the first token's own line: what is before it on it)
    while e > 0 && gap[(e - 1) as usize] != b'\n' {
        e -= 1;
    }
    while e > 0 {
        // the line ending at e - 1
        let mut b = e - 1;
        while b > 0 && gap[(b - 1) as usize] != b'\n' {
            b -= 1;
        }
        if b == 0 && j >= 0 {
            // (the rest of the line of the token before: not above)
            break;
        }
        let line = &gap[b as usize..(e - 1) as usize];
        let mut blank = true;
        for &c in line {
            if c != b' ' && c != b'\t' && c != b'\r' {
                blank = false;
            }
        }
        if blank {
            break;
        }
        bits |= marks(line);
        e = b;
    }
    // The comments inside the statement, before the site.
    for m in j + 1..i {
        if tk(toks, m) == K_COMMENT && tstart(toks, m) >= first {
            bits |= marks(&text[tstart(toks, m) as usize..tend(toks, m) as usize]);
        }
    }
    // A comment ending the site's line.
    let mut eol = tstart(toks, i);
    while eol < text.len() as i64 && text[eol as usize] != b'\n' {
        eol += 1;
    }
    let mut m = i + 1;
    let n = toks.len() as i64 / 3;
    while m < n && tstart(toks, m) < eol {
        if tk(toks, m) == K_COMMENT {
            let to = if tend(toks, m) < eol { tend(toks, m) } else { eol };
            bits |= marks(&text[tstart(toks, m) as usize..to as usize]);
        }
        m += 1;
    }
    bits
}

// The line (from 1) of offset at in text.
fn line_at(text: &[u8], at: i64, from: i64, line: i64) -> i64 {
    let mut n = line;
    for x in from..at {
        if text[x as usize] == b'\n' {
            n += 1;
        }
    }
    n
}

// The sites of file f, appended to the S_* tables.
fn find_sites(f: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let text = file_bytes(f, pcx);
    let mut toks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    scan_tokens(text, 0, text.len() as i64, &mut toks);
    let n = toks.len() as i64 / 3;
    // each `{`'s `}` (-1: unmatched)
    let mut close = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..n {
        close.push(-1);
        let k = tk(toks, i);
        if k == K_LBRACE {
            stack.push(i);
        } else if k == K_RBRACE && stack.len() as i64 > 0 {
            close.set(stack.pop(), i);
        }
    }
    let start = file_start(f, pcx);
    let mut line: i64 = 1;
    let mut line_from: i64 = 0;
    for i in 0..n {
        let k = tk(toks, i);
        let mut kind: i64 = -1;
        let mut body: i64 = -1;
        if k == K_UNSAFE && i + 1 < n && tk(toks, i + 1) == K_LBRACE {
            kind = S_BLOCK;
            body = i + 1;
        } else if k == K_UNSAFE && i + 1 < n && tk(toks, i + 1) == K_FN
            && !fn_pointer_type(text, toks, i) {
            kind = S_FN;
            // its body: the first `{` outside parentheses (none: a trait's
            // declaration, up to its `;`)
            let mut m = i + 2;
            let mut depth: i64 = 0;
            while m < n && body < 0 {
                let km = tk(toks, m);
                if km == K_LPAREN {
                    depth += 1;
                } else if km == K_RPAREN {
                    depth -= 1;
                } else if depth == 0 && km == K_LBRACE {
                    body = m;
                } else if depth == 0 && km == K_SEMI {
                    break;
                }
                m += 1;
            }
            if body < 0 {
                body = -(m + 2);
            }
        } else if k == K_EXTERN && i + 1 < n {
            let mut m = i + 1;
            if tk(toks, m) == K_STR {
                m += 1;
            }
            if m < n && tk(toks, m) == K_LBRACE {
                kind = S_EXTERN;
                body = m;
            }
        }
        if kind < 0 {
            continue;
        }
        line = line_at(text, tstart(toks, i), line_from, line);
        line_from = tstart(toks, i);
        let mut end = tend(toks, i);
        let mut check_at: i64 = -1;
        if body >= 0 {
            let c = close.get(body);
            end = if c >= 0 { tend(toks, c) } else { text.len() as i64 };
            check_at = if kind == S_FN { start + tstart(toks, body) }
                else { start + tstart(toks, i) };
        } else {
            // (an `unsafe fn` without a body: to its `;`)
            let last = -body - 2;
            end = if last < n { tend(toks, last) } else { text.len() as i64 };
        }
        tcx.s_pos.push(start + tstart(toks, i));
        tcx.s_end.push(start + end);
        tcx.s_kind.push(kind);
        tcx.s_file.push(f);
        // (std's built-in text: the path and line of std's file)
        let mut path = file_path(f, pcx);
        let mut at_line = line;
        let mut std_line: i64 = 0;
        if std_file_line(f, start + tstart(toks, i), &mut path, &mut std_line, pcx) {
            at_line = std_line;
        }
        let pb = buf_new();
        buf_bytes(pb, c_slice(path));
        tcx.s_path.push(pb);
        tcx.s_line.push(at_line);
        tcx.s_just.push(justification(text, toks, i));
        tcx.s_check_at.push(check_at);
        // an extern block's functions: its `fn`s at its own level
        let mut fns: i64 = 0;
        if kind == S_EXTERN {
            let c = close.get(body);
            let mut d: i64 = 0;
            for m in body + 1..(if c >= 0 { c } else { n }) {
                let km = tk(toks, m);
                if km == K_LBRACE {
                    d += 1;
                } else if km == K_RBRACE {
                    d -= 1;
                } else if d == 0 && km == K_FN {
                    fns += 1;
                }
            }
        }
        tcx.s_externs.push(fns);
    }
}

// Whether file f is std's (its built-in text, or its files with
// --std-tree), and whether it is a vole file at all (not a C header's).
fn is_std_file(f: i64, pcx: &Ctx<Comp>) -> bool {
    let p = c_slice(file_path(f, pcx));
    p == b"<std>" || within_std(file_module(f, pcx), pcx)
}

fn is_vole_file(f: i64, pcx: &Ctx<Comp>) -> bool {
    let p = c_slice(file_path(f, pcx));
    p == b"<std>" || (p.len() > 3 && p[(p.len() as i64 - 3) as usize..] == b".vl")
}

// The sites of every file of the program (`std`: std's too).
fn find_all_sites(std: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.files.len() as i64 {
        if is_vole_file(f, pcx) && (std || !is_std_file(f, pcx)) {
            find_sites(f, tcx, pcx);
        }
    }
}

// ---- unsafe.unjustified (volec check) ----

// (check's sites, kept cheap: scanning every byte of the compiler cost
// its `check` 8% more instructions) A file's sites from the words
// `unsafe` and `extern` alone, found with std's memchr, each read in the
// lines around it: a line is read alone, as a string spans lines only
// where they end in `\` (line_start goes back to its first). A
// file with a `/*` (a comment that may span lines) is scanned whole.
fn light_sites(f: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let text = file_bytes(f, pcx);
    if has_byte_pair(text, b'/', b'*') {
        find_sites(f, tcx, pcx);
        return;
    }
    let mut words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    find_word(text, b'u', 0, b"unsafe", &mut words);
    let unsafe_words = words.len() as i64;
    find_word(text, b'x', 1, b"extern", &mut words);
    // (in order of position: the two runs merged)
    let mut a: i64 = 0;
    let mut b = unsafe_words;
    while a < unsafe_words || b < words.len() as i64 {
        if b >= words.len() as i64 || (a < unsafe_words && words.get(a) < words.get(b)) {
            light_site(f, text, words.get(a), tcx, pcx);
            a += 1;
        } else {
            light_site(f, text, words.get(b), tcx, pcx);
            b += 1;
        }
    }
}

// Whether text holds byte x followed by byte y.
fn has_byte_pair(text: &[u8], x: u8, y: u8) -> bool {
    let mut from: i64 = 0;
    while from < text.len() as i64 {
        match (&text[from as usize..]).iter().position(|c| *c == y).map(|i| i as i64) {
            Option::Some(k) => {
                let p = from + k;
                if p > 0 && text[(p - 1) as usize] == x {
                    return true;
                }
                from = p + 1;
            },
            Option::None => {
                return false;
            },
        }
    }
    false
}

// The positions of `word` as a whole word in text, into out: found by its
// byte b, at index at in it.
fn find_word(text: &[u8], b: u8, at: i64, word: &[u8], out: &mut IntVec) {
    let mut from: i64 = 0;
    while from < text.len() as i64 {
        match (&text[from as usize..]).iter().position(|c| *c == b).map(|i| i as i64) {
            Option::Some(k) => {
                let p = from + k - at;
                from += k + 1;
                if p >= 0 && p + word.len() as i64 <= text.len() as i64
                    && text[p as usize..(p + word.len() as i64) as usize] == word
                    && (p == 0 || !is_word_byte(text[(p - 1) as usize]))
                    && (p + word.len() as i64 == text.len() as i64
                        || !is_word_byte(text[(p + word.len() as i64) as usize])) {
                    out.push(p);
                }
            },
            Option::None => {
                return;
            },
        }
    }
}

// The start of the line of p; of the first line of its string when the
// lines before end in a `\` (a string continued).
fn line_start(text: &[u8], p: i64) -> i64 {
    let mut s = p;
    while s > 0 && text[(s - 1) as usize] != b'\n' {
        s -= 1;
    }
    if s >= 2 && text[(s - 2) as usize] == b'\\' {
        return line_start(text, s - 1);
    }
    s
}

fn line_end(text: &[u8], p: i64) -> i64 {
    let mut e = p;
    while e < text.len() as i64 && text[e as usize] != b'\n' {
        e += 1;
    }
    e
}

// The site at the word at p (file f's text), if it is one: read from the
// line before it on (more lines while the statement starts above them) to
// the end of its line (of the next while what follows the word is there).
fn light_site(f: i64, text: &[u8], p: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut from = line_start(text, p);
    if from > 0 {
        from = line_start(text, from - 1);
    }
    let mut to = line_end(text, p);
    let mut extended = false;
    let mut more: i64 = 1;
    loop {
        let mut toks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        scan_tokens(text, from, to, &mut toks);
        let mut i: i64 = -1;
        for k in 0..toks.len() as i64 / 3 {
            if tstart(toks, k) == p {
                i = k;
            }
        }
        if i < 0 {
            // (in a string or a comment)
            return;
        }
        let kind = site_kind(text, toks, i);
        if kind < 0 && !extended && to < text.len() as i64 && i + 2 >= toks.len() as i64 / 3 {
            extended = true;
            // (`unsafe` or `extern "C"` ending its line: the next one)
            to = line_end(text, to + 1);
            continue;
        }
        if kind < 0 {
            return;
        }
        if from > 0 && statement_first(toks, i) < 0 {
            // (the statement starts above: more lines)
            for _ in 0..more {
                if from > 0 {
                    from = line_start(text, from - 1);
                }
            }
            more *= 2;
            continue;
        }
        tcx.s_pos.push(file_start(f, pcx) + p);
        tcx.s_end.push(file_start(f, pcx) + p);
        tcx.s_kind.push(kind);
        tcx.s_file.push(f);
        tcx.s_path.push(0);
        tcx.s_line.push(0);
        tcx.s_just.push(justification(text, toks, i));
        tcx.s_check_at.push(-1);
        tcx.s_externs.push(0);
        return;
    }
}

// The kind of site the token i starts (-1: none): `unsafe {`, `unsafe fn`,
// `extern "C" {` (or `extern {`).
fn site_kind(text: &[u8], toks: IntVec, i: i64) -> i64 {
    let n = toks.len() as i64 / 3;
    let k = tk(toks, i);
    if k == K_UNSAFE && i + 1 < n {
        let next = tk(toks, i + 1);
        return if next == K_LBRACE { S_BLOCK }
            else if next == K_FN && !fn_pointer_type(text, toks, i) { S_FN } else { -1 };
    }
    if k == K_EXTERN && i + 1 < n {
        let mut m = i + 1;
        if tk(toks, m) == K_STR {
            m += 1;
        }
        if m < n && tk(toks, m) == K_LBRACE {
            return S_EXTERN;
        }
    }
    -1
}

// Whether `unsafe fn` at token i is a function pointer's type, `unsafe
// fn(...)` with nothing between `fn` and `(` (0.28.0: the rust edition's;
// no site, as in rustc).
fn fn_pointer_type(text: &[u8], toks: IntVec, i: i64) -> bool {
    if i + 2 >= toks.len() as i64 / 3 || tk(toks, i + 2) != K_LPAREN {
        return false;
    }
    for j in tend(toks, i + 1)..tstart(toks, i + 2) {
        if is_word_byte(text[j as usize]) {
            return false;
        }
    }
    true
}

// The token before the statement or item token i is in (a `;`, `{` or `}`
// outside brackets), or -1 when there is none before it.
fn statement_first(toks: IntVec, i: i64) -> i64 {
    let mut j = i - 1;
    let mut depth: i64 = 0;
    while j >= 0 {
        let k = tk(toks, j);
        if k == K_RPAREN || k == K_RBRACKET {
            depth += 1;
        } else if k == K_LPAREN || k == K_LBRACKET {
            if depth > 0 {
                depth -= 1;
            }
        } else if depth == 0 && (k == K_SEMI || k == K_LBRACE || k == K_RBRACE) {
            return j;
        }
        j -= 1;
    }
    -1
}

// The sites of the program's files (not std's), for check. `lexed`: the
// front end has just read the program, and the lexer's tokens say where
// the words `unsafe` and `extern` are (else the files are searched).
fn light_all_sites(lexed: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if !lexed {
        for f in 0..pcx.files.len() as i64 {
            if is_vole_file(f, pcx) && !is_std_file(f, pcx) {
                light_sites(f, tcx, pcx);
            }
        }
        return;
    }
    let mut words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    lexed_words(&mut words, pcx);
    let mut last: i64 = -1;
    let mut whole = false;
    for k in 0..words.len() as i64 {
        let pos = words.get(k);
        let f = file_of_pos(pos, pcx);
        if f != last {
            last = f;
            whole = has_byte_pair(file_bytes(f, pcx), b'/', b'*');
            if whole {
                find_sites(f, tcx, pcx);
            }
        }
        if !whole {
            light_site(f, file_bytes(f, pcx), pos - file_start(f, pcx), tcx, pcx);
        }
    }
}

// The positions of the lexer's `unsafe` and `extern` tokens in the
// program's files (not std's), in order, into out.
fn lexed_words(out: &mut IntVec, pcx: &Ctx<Comp>) {
    for k in 0..pcx.toks.len() as i64 {
        let pos: i64 = if pcx.toks[k as usize].kind == Tok::Unsafe
            || pcx.toks[k as usize].kind == Tok::Extern { pcx.toks[k as usize].start }
            else { -1 };
        if pos >= 0 {
            let f = file_of_pos(pos, pcx);
            if is_vole_file(f, pcx) && !is_std_file(f, pcx) {
                out.push(pos);
            }
        }
    }
    // (the files were lexed in turn, std's sections between them: nearly
    // in order)
    sort_values(out, pcx);
}

// The sites reported one by one; past them, one warning says how many.
const SHOWN_UNJUSTIFIED: i64 = 5;

// `volec check`: a warning for each site of the program (not std's)
// without both comments; past SHOWN_UNJUSTIFIED of them, one warning that
// counts them, at the first (a program of legacy unsafe, the compiler's,
// says so in one line). `lexed`: see light_all_sites.
pub fn report_unjustified(lexed: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    light_all_sites(lexed, tcx, pcx);
    let mut count: i64 = 0;
    let mut first: i64 = -1;
    for s in 0..tcx.s_pos.len() as i64 {
        if tcx.s_just.get(s) != J_BOTH {
            if first < 0 {
                first = s;
            }
            count += 1;
        }
    }
    if count > SHOWN_UNJUSTIFIED {
        let msg = buf_new();
        buf_int(msg, count);
        buf_bytes(msg,
            b" unsafe sites lack `// UNSAFE:` and `// SAFETY:` comments (the first here)");
        buf_byte(msg, 0);
        let tries = buf_new();
        buf_tool_command(tries, b"query unsafe --no-std --unjustified --root", true, pcx);
        report_error_tries(tcx.s_pos.get(first), 7102, c"unsafe.unjustified", buf_slice(msg).ptr,
            c"each unsafe site says right above it why it cannot be safe and why it is sound; the try: line lists them",
            buf_slice(tries), true, pcx);
        return;
    }
    for s in 0..tcx.s_pos.len() as i64 {
        let bits = tcx.s_just.get(s);
        if bits == J_BOTH {
            continue;
        }
        let msg = buf_new();
        buf_bytes(msg, if tcx.s_kind.get(s) == S_BLOCK { b"unsafe block" }
            else if tcx.s_kind.get(s) == S_FN { b"`unsafe fn`" } else { b"extern block" });
        buf_bytes(msg, if bits == J_UNSAFE { b" without a `// SAFETY:` comment" }
            else if bits == J_SAFETY { b" without a `// UNSAFE:` comment" }
            else { b" without `// UNSAFE:` and `// SAFETY:` comments" });
        buf_byte(msg, 0);
        let tries = buf_new();
        let args = buf_new();
        buf_bytes(args, b"query unsafe ");
        buf_bytes(args, c_slice(file_path(tcx.s_file.get(s), pcx)));
        buf_tool_command(tries, buf_slice(args), false, pcx);
        report_error_tries(tcx.s_pos.get(s), 7101, c"unsafe.unjustified", buf_slice(msg).ptr,
            c"say right above it why it cannot be safe (`// UNSAFE: ...`) and why it is sound (`// SAFETY: ...`); the try: line lists the file's sites and what each does",
            buf_slice(tries), true, pcx);
    }
}

// ---- volec query unsafe ----

// The operations recorded (AUDIT_OPS), one per position and kind: their
// index in AUDIT_OPS (a multiple of 4), in order of position.
fn distinct_ops(out: &mut IntVec, pcx: &Ctx<Comp>) {
    let mut all = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut q: i64 = 0;
    while q + 3 < pcx.audit_ops.len() as i64 {
        all.push(q);
        q += 4;
    }
    sort_ops(&mut all, true, pcx);
    for k in 0..all.len() as i64 {
        let a = all.get(k);
        if out.len() as i64 > 0 {
            let b = out.get(out.len() as i64 - 1);
            if pcx.audit_ops.get(a) == pcx.audit_ops.get(b)
                && pcx.audit_ops.get(a + 1) == pcx.audit_ops.get(b + 1) {
                continue;
            }
        }
        out.push(a);
    }
}

// Sorts v: op indices by (position, kind) when `ops`, else numbers; a
// merge sort.
fn sort_ops(v: &mut IntVec, ops: bool, pcx: &Ctx<Comp>) {
    let n = v.len() as i64;
    let mut tmp = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for k in 0..n {
        tmp.push(v.get(k));
    }
    let mut width: i64 = 1;
    while width < n {
        let mut lo: i64 = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut a = lo;
            let mut b = mid;
            let mut k = lo;
            while k < hi {
                if a < mid && (b >= hi || !(if ops { op_before(v.get(b), v.get(a), pcx) }
                    else { v.get(b) < v.get(a) })) {
                    tmp.set(k, v.get(a));
                    a += 1;
                } else {
                    tmp.set(k, v.get(b));
                    b += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        for k in 0..n {
            v.set(k, tmp.get(k));
        }
        width *= 2;
    }
}

fn op_before(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let pa = pcx.audit_ops.get(a);
    let pb = pcx.audit_ops.get(b);
    pa < pb || (pa == pb && pcx.audit_ops.get(a + 1) < pcx.audit_ops.get(b + 1))
}

// The last segment of a function's name, without type arguments.
fn last_name(name: &[u8]) -> &[u8] {
    let mut from: i64 = 0;
    let mut to = name.len() as i64;
    let mut depth: i64 = 0;
    for x in 0..name.len() as i64 {
        let c = name[x as usize];
        if c == b'<' {
            if depth == 0 && x >= from {
                to = x;
            }
            depth += 1;
        } else if c == b'>' {
            depth -= 1;
        }
        else if depth == 0 && c == b':' && x + 1 < name.len() as i64
            && name[(x + 1) as usize] == b':' {
            from = x + 2;
            to = name.len() as i64;
        }
    }
    if to < from { &name[from as usize..] } else { &name[from as usize..to as usize] }
}

fn contains(s: &[u8], part: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + part.len() as i64 <= s.len() as i64 {
        if &s[i as usize..(i + part.len() as i64) as usize] == part {
            return true;
        }
        i += 1;
    }
    false
}

fn is_alloc_name(s: &[u8]) -> bool {
    contains(s, b"alloc") || contains(s, b"free") || contains(s, b"resize")
        || contains(s, b"memalign") || s == b"mmap" || s == b"munmap"
}

fn is_cast_name(s: &[u8]) -> bool {
    s == b"cast" || s == b"transmute" || s == b"bitcast"
}

fn is_intrinsic(f: i64, s: &[u8], pcx: &Ctx<Comp>) -> bool {
    (pcx.arch_module >= 0 && is_within(fn_module(f, pcx), pcx.arch_module, pcx))
        || (s.len() > 10 && s[0..10] == b"__builtin_")
}

// The class of operation q (an index in AUDIT_OPS).
fn op_class(q: i64, pcx: &Ctx<Comp>) -> i64 {
    let kind = pcx.audit_ops.get(q + 1);
    let f = pcx.audit_ops.get(q + 2);
    let held = pcx.audit_ops.get(q + 3) != 0;
    if kind == U_C_CALL {
        if f < 0 {
            return C_FFI;
        }
        let s = last_name(fn_name(f, pcx));
        return if is_alloc_name(s) { C_ALLOC } else if is_intrinsic(f, s, pcx) { C_INTRINSIC }
            else { C_FFI };
    }
    if kind == U_UNSAFE_CALL {
        if f < 0 {
            // (a call through an `unsafe fn` pointer: no function to name)
            return C_OTHER;
        }
        let s = last_name(fn_name(f, pcx));
        return if is_alloc_name(s) { C_ALLOC } else if is_intrinsic(f, s, pcx) { C_INTRINSIC }
            else if is_cast_name(s) { C_CAST } else if takes_raw_pointer(f, pcx) { C_RAW }
            else { C_OTHER };
    }
    if kind == U_INT_PTR || kind == U_FN_VALUE {
        return C_CAST;
    }
    if kind == U_UNION {
        return C_OTHER;
    }
    if held { C_STATIC } else { C_RAW }
}

// Operation q as listed: `index`, `static-index`, `c-call(malloc)`...
fn put_op(out: i64, q: i64, pcx: &Ctx<Comp>) {
    let kind = pcx.audit_ops.get(q + 1);
    let f = pcx.audit_ops.get(q + 2);
    if kind == U_C_CALL || kind == U_UNSAFE_CALL {
        buf_bytes(out, if kind == U_C_CALL { b"c-call(" } else { b"unsafe-call(" });
        buf_bytes(out, if f >= 0 { fn_name(f, pcx) } else { b"fn pointer" });
        buf_byte(out, b')');
        return;
    }
    if pcx.audit_ops.get(q + 3) != 0 {
        buf_bytes(out, b"static-");
    }
    buf_bytes(out, if kind == U_DEREF { b"deref" } else if kind == U_FIELD { b"field" }
        else if kind == U_METHOD { b"method" } else if kind == U_INDEX { b"index" }
        else if kind == U_SLICE { b"slice" } else if kind == U_INT_PTR { b"int-to-ptr" }
        else if kind == U_UNION { b"union-field" } else if kind == U_FN_VALUE { b"fn-value" }
        else { b"other" });
}

// Whether two operations are listed the same.
fn same_op(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.audit_ops.get(a + 1) == pcx.audit_ops.get(b + 1)
        && pcx.audit_ops.get(a + 2) == pcx.audit_ops.get(b + 2)
        && pcx.audit_ops.get(a + 3) == pcx.audit_ops.get(b + 3)
}

// What the answer is about: the sites wanted, their operations.
#[derive(Clone, Copy)] struct Audit {
    // the sites wanted (S_* indices)
    sites: IntVec,
    // per site (by S_* index): its first operation in `ops`, and the end
    first: IntVec,
    last: IntVec,
    // the operations, grouped by site
    ops: IntVec,
    // per site: its class, whether checked
    class: IntVec,
    checked: IntVec,
}

// Whether the site s is one the arguments want: every one when there is
// none; else the sites of a FILE (or under a DIR) named, std's for `std`.
fn wanted(s: i64, args: IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if tcx.opt_unjustified && tcx.s_just.get(s) == J_BOTH {
        return false;
    }
    if args.len() as i64 == 0 {
        return true;
    }
    let path = buf_slice(tcx.s_path.get(s));
    for k in 0..args.len() as i64 {
        let mut a = arg_text(args, k);
        while a.len() > 2 && a[0] == b'.' && a[1] == b'/' {
            a = &a[2..a.len()];
        }
        while a.len() > 1 && a[(a.len() as i64 - 1) as usize] == b'/' {
            a = &a[0..(a.len() as i64 - 1) as usize];
        }
        if a == b"std" && is_std_file(tcx.s_file.get(s), pcx) {
            return true;
        }
        if path == a
            || (path.len() > a.len() && path[0..a.len()] == a
                && path[a.len()] == b'/') {
            return true;
        }
    }
    false
}

fn audit(args: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> Audit {
    let mut a = Audit {
        sites: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        first: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        last: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        ops: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        class: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        checked: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
    };
    let mut std = !tcx.opt_no_std;
    for k in 0..args.len() as i64 {
        if arg_text(args, k) == b"std" {
            std = true;
        }
    }
    find_all_sites(std, tcx, pcx);
    let n = tcx.s_pos.len() as i64;
    // each operation's site: the innermost holding it
    let mut ops = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    distinct_ops(&mut ops, pcx);
    let mut site_of = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut counts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for _ in 0..n {
        counts.push(0);
    }
    for k in 0..ops.len() as i64 {
        let pos = pcx.audit_ops.get(ops.get(k));
        // the last site starting at or before pos, then back to one
        // holding it
        let mut lo: i64 = 0;
        let mut hi = n;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if tcx.s_pos.get(mid) <= pos { lo = mid + 1; } else { hi = mid; }
        }
        let mut s = lo - 1;
        let mut steps: i64 = 0;
        while s >= 0 && tcx.s_end.get(s) <= pos && steps < 256 {
            s -= 1;
            steps += 1;
        }
        if s >= 0 && tcx.s_end.get(s) <= pos {
            s = -1;
        }
        site_of.push(s);
        if s >= 0 {
            { let at_arg2 = counts.get(s) + 1; counts.set(s, at_arg2) };
        }
    }
    let mut at: i64 = 0;
    for s in 0..n {
        a.first.push(at);
        a.last.push(at);
        at += counts.get(s);
    }
    for _ in 0..at {
        a.ops.push(0);
    }
    for k in 0..ops.len() as i64 {
        let s = site_of.get(k);
        if s >= 0 {
            a.ops.set(a.last.get(s), ops.get(k));
            a.last.set(s, a.last.get(s) + 1);
        }
    }
    // checked: the positions the checker marked
    let mut marked = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for p in (&mut pcx.audit_checked).items() {
        marked.push(p);
    }
    sort_values(&mut marked, pcx);
    for s in 0..n {
        let mut c = C_OTHER;
        if tcx.s_kind.get(s) == S_EXTERN {
            c = C_FFI;
        }
        for k in a.first.get(s)..a.last.get(s) {
            let oc = op_class(a.ops.get(k), pcx);
            if oc < c {
                c = oc;
            }
        }
        a.class.push(c);
        let p = tcx.s_check_at.get(s);
        a.checked.push(if tcx.s_kind.get(s) == S_EXTERN || (p >= 0 && has_value(marked, p)) { 1 }
            else { 0 });
        if wanted(s, args, tcx, pcx) {
            a.sites.push(s);
        }
    }
    a
}

fn sort_values(v: &mut IntVec, pcx: &Ctx<Comp>) {
    sort_ops(v, false, pcx);
}

fn has_value(v: IntVec, x: i64) -> bool {
    let mut lo: i64 = 0;
    let mut hi = v.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v.get(mid) < x { lo = mid + 1; } else { hi = mid; }
    }
    lo < v.len() as i64 && v.get(lo) == x
}

// The item a site is in: the function (an `unsafe fn`: itself), else the
// module (an extern block: `MODULE::extern`).
fn put_item(out: i64, s: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let kind = tcx.s_kind.get(s);
    let at = if kind == S_FN && tcx.s_check_at.get(s) >= 0 { tcx.s_check_at.get(s) }
        else { tcx.s_pos.get(s) };
    if kind != S_EXTERN {
        let d = enclosing(at, tcx, pcx);
        if d >= 0 {
            buf_bytes(out, def_path(d, pcx));
            return;
        }
    }
    buf_bytes(out, mod_fqn_text(module_at(at, pcx), tcx, pcx));
    if kind == S_EXTERN {
        buf_bytes(out, b"::extern");
    }
}

// Whether site s is an unsafe block the checker read with nothing unsafe
// inside.
fn is_unneeded(a: Audit, s: i64, tcx: &Tcx<Comp>) -> bool {
    tcx.s_kind.get(s) == S_BLOCK && a.checked.get(s) != 0 && a.first.get(s) == a.last.get(s)
}

// (0.25.4) `volec fix --only unneeded-unsafe` (tools/fix/unneeded.vl): the
// program's unsafe blocks with nothing unsafe inside, in order of position,
// four numbers each: the file, the block's start (its `unsafe`), its end
// (after its `}`), both counted in the file's text (site_text), and 1 when
// the comments above it say `UNSAFE:` or `SAFETY:` (0.25.5: only with
// justified; without it those are left out), else 0.
pub fn unneeded_blocks(out: &mut Vec<i64, Comp>, justified: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    tcx.opt_no_std = true;
    let a = audit(IntVec { data: 0 as *mut i64, count: 0, cap: 0 }, tcx, pcx);
    for k in 0..a.sites.len() as i64 {
        let s = a.sites.get(k);
        if is_unneeded(a, s, tcx) && (justified || tcx.s_just.get(s) == 0) {
            let f = tcx.s_file.get(s);
            out.push(f);
            out.push(tcx.s_pos.get(s) - file_start(f, pcx));
            out.push(tcx.s_end.get(s) - file_start(f, pcx));
            out.push(if tcx.s_just.get(s) == 0 { 0 } else { 1 });
        }
    }
}

// File f's text and where it starts in the program's text: the frame of
// unneeded_blocks' positions.
pub fn site_text(f: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    file_bytes(f, pcx)
}

pub fn site_file_start(f: i64, pcx: &Ctx<Comp>) -> i64 {
    file_start(f, pcx)
}

fn just_text(bits: i64) -> &'static [u8] {
    if bits == J_BOTH { b"justified" } else if bits == J_UNSAFE { b"missing SAFETY:" }
    else if bits == J_SAFETY { b"missing UNSAFE:" } else { b"missing both" }
}

// The operations of site s, as listed: each with ` xN` past one.
fn put_ops(out: i64, a: Audit, s: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.s_kind.get(s) == S_EXTERN {
        buf_int(out, tcx.s_externs.get(s));
        buf_bytes(out, if tcx.s_externs.get(s) == 1 { b" C function" } else { b" C functions" });
        return;
    }
    let from = a.first.get(s);
    let to = a.last.get(s);
    if from == to {
        buf_bytes(out, if is_unneeded(a, s, tcx) { b"none (unneeded)" }
            else if a.checked.get(s) != 0 { b"none" } else { b"not checked" });
        return;
    }
    let mut done = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut listed: i64 = 0;
    for k in from..to {
        let q = a.ops.get(k);
        let mut seen = false;
        for d in (&mut done).items() {
            if same_op(d, q, pcx) {
                seen = true;
            }
        }
        if seen {
            continue;
        }
        done.push(q);
        let mut times: i64 = 0;
        for k2 in k..to {
            if same_op(a.ops.get(k2), q, pcx) {
                times += 1;
            }
        }
        if listed > 0 {
            buf_bytes(out, b", ");
        }
        put_op(out, q, pcx);
        if times > 1 {
            buf_bytes(out, b" x");
            buf_int(out, times);
        }
        listed += 1;
    }
}

fn put_line(out: i64, a: Audit, s: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    buf_bytes(out, buf_slice(tcx.s_path.get(s)));
    buf_byte(out, b':');
    buf_int(out, tcx.s_line.get(s));
    buf_byte(out, b'\t');
    buf_bytes(out, kind_name(tcx.s_kind.get(s)));
    buf_byte(out, b'\t');
    put_item(out, s, tcx, pcx);
    buf_byte(out, b'\t');
    buf_bytes(out, class_name(a.class.get(s)));
    buf_byte(out, b'\t');
    buf_bytes(out, just_text(tcx.s_just.get(s)));
    buf_byte(out, b'\t');
    put_ops(out, a, s, tcx, pcx);
    buf_byte(out, b'\n');
}

fn put_json(out: i64, a: Audit, s: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let bits = tcx.s_just.get(s);
    buf_bytes(out, b"{\"file\":");
    buf_json_str(out, buf_slice(tcx.s_path.get(s)));
    buf_bytes(out, b",\"line\":");
    buf_int(out, tcx.s_line.get(s));
    buf_bytes(out, b",\"kind\":");
    buf_json_str(out, kind_name(tcx.s_kind.get(s)));
    let item = buf_new();
    put_item(item, s, tcx, pcx);
    buf_bytes(out, b",\"item\":");
    buf_json_str(out, buf_slice(item));
    buf_bytes(out, b",\"class\":");
    buf_json_str(out, class_name(a.class.get(s)));
    buf_bytes(out, b",\"unsafe_comment\":");
    buf_bytes(out, if (bits & J_UNSAFE) != 0 { b"true" } else { b"false" });
    buf_bytes(out, b",\"safety_comment\":");
    buf_bytes(out, if (bits & J_SAFETY) != 0 { b"true" } else { b"false" });
    buf_bytes(out, b",\"justified\":");
    buf_bytes(out, if bits == J_BOTH { b"true" } else { b"false" });
    buf_bytes(out, b",\"checked\":");
    buf_bytes(out, if a.checked.get(s) != 0 { b"true" } else { b"false" });
    let ops = buf_new();
    put_ops(ops, a, s, tcx, pcx);
    buf_bytes(out, b",\"ops\":");
    buf_json_str(out, buf_slice(ops));
    buf_bytes(out, b"}\n");
}

// The top-level module of site s: `crate::front`, `std::collections`.
fn top_module(s: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> &'static [u8] {
    let path = mod_fqn_text(module_at(tcx.s_pos.get(s), pcx), tcx, pcx);
    let mut seps: i64 = 0;
    for x in 0..path.len() as i64 {
        if path[x as usize] == b':' && x + 1 < path.len() as i64 && path[(x + 1) as usize] == b':' {
            seps += 1;
            if seps == 2 {
                return &path[0..x as usize];
            }
        }
    }
    path
}

// Counts by key: keys (C strings or symbol texts kept as buffers) with
// their sites and unjustified sites.
#[derive(Clone, Copy)] struct Tally {
    keys: IntVec,
    sites: IntVec,
    bad: IntVec,
}

fn tally_new() -> Tally {
    Tally {
        keys: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        sites: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        bad: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
    }
}

fn tally_add(t: &mut Tally, key: &[u8], bad: bool) {
    for k in 0..t.keys.len() as i64 {
        if buf_slice(t.keys.get(k)) == key {
            t.sites.set(k, t.sites.get(k) + 1);
            if bad {
                t.bad.set(k, t.bad.get(k) + 1);
            }
            return;
        }
    }
    let b = buf_new();
    buf_bytes(b, key);
    t.keys.push(b);
    t.sites.push(1);
    t.bad.push(if bad { 1 } else { 0 });
}

// The rows of t, most sites first (at most `limit`; -1: all).
fn put_tally(out: i64, t: Tally, limit: i64) {
    let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for k in 0..t.keys.len() as i64 {
        order.push(k);
    }
    for i in 1..order.len() as i64 {
        let x = order.get(i);
        let mut j = i;
        while j > 0 && (t.sites.get(order.get(j - 1)) < t.sites.get(x)
            || (t.sites.get(order.get(j - 1)) == t.sites.get(x)
                && buf_slice(t.keys.get(order.get(j - 1))) > buf_slice(t.keys.get(x)))) {
            { let at_arg2 = order.get(j - 1); order.set(j, at_arg2) };
            j -= 1;
        }
        order.set(j, x);
    }
    let n = if limit >= 0 && limit < order.len() as i64 { limit } else { order.len() as i64 };
    for i in 0..n {
        let k = order.get(i);
        buf_bytes(out, buf_slice(t.keys.get(k)));
        buf_byte(out, b'\t');
        buf_int(out, t.sites.get(k));
        buf_byte(out, b'\t');
        buf_int(out, t.bad.get(k));
        buf_byte(out, b'\n');
    }
    if n < order.len() as i64 {
        buf_bytes(out, b"(");
        buf_int(out, order.len() as i64 - n);
        buf_bytes(out, b" more; --all lists every one)\n");
    }
}

// `sites: N (B blocks, F unsafe fns, E extern blocks); unjustified: U;
// unneeded: K` (K: unsafe blocks with nothing unsafe inside)
fn put_total(out: i64, a: Audit, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut by_kind = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for _ in 0..3 {
        by_kind.push(0);
    }
    let mut bad: i64 = 0;
    let mut unneeded: i64 = 0;
    for i in 0..a.sites.len() as i64 {
        let s = a.sites.get(i);
        by_kind.set(tcx.s_kind.get(s), by_kind.get(tcx.s_kind.get(s)) + 1);
        if tcx.s_just.get(s) != J_BOTH {
            bad += 1;
        }
        if is_unneeded(a, s, tcx) {
            unneeded += 1;
        }
    }
    buf_bytes(out, b"sites: ");
    buf_int(out, a.sites.len() as i64);
    buf_bytes(out, b" (");
    buf_int(out, by_kind.get(S_BLOCK));
    buf_bytes(out, b" blocks, ");
    buf_int(out, by_kind.get(S_FN));
    buf_bytes(out, b" unsafe fns, ");
    buf_int(out, by_kind.get(S_EXTERN));
    buf_bytes(out, b" extern blocks); unjustified: ");
    buf_int(out, bad);
    buf_bytes(out, b"; unneeded: ");
    buf_int(out, unneeded);
    buf_byte(out, b'\n');
    // (0.25.5, feedbacks/mod254.md #1: the fix that removes them)
    if unneeded > 0 && !get_diag_json() {
        let t = diags(tcx);
        buf_str(t, c"try:");
        put_cword(t, pcx.prog);
        buf_str(t, c" fix --only unneeded-unsafe");
        put_root(t, tcx);
        try_end(t);
    }
}

fn put_summary(out: i64, a: Audit, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    put_total(out, a, tcx, pcx);
    let mut classes = tally_new();
    let mut modules = tally_new();
    let mut files = tally_new();
    let mut states = tally_new();
    for i in 0..a.sites.len() as i64 {
        let s = a.sites.get(i);
        let bad = tcx.s_just.get(s) != J_BOTH;
        tally_add(&mut classes, class_name(a.class.get(s)), bad);
        tally_add(&mut modules, top_module(s, tcx, pcx), bad);
        tally_add(&mut files, buf_slice(tcx.s_path.get(s)), bad);
        tally_add(&mut states, just_text(tcx.s_just.get(s)), bad);
    }
    buf_bytes(out, b"\nclass\tsites\tunjustified\n");
    put_tally(out, classes, -1);
    buf_bytes(out, b"\nmodule\tsites\tunjustified\n");
    put_tally(out, modules, -1);
    buf_bytes(out, b"\nfile\tsites\tunjustified\n");
    put_tally(out, files, if tcx.opt_all { -1 } else { 20 });
    buf_bytes(out, b"\njustification\tsites\tunjustified\n");
    put_tally(out, states, -1);
}

// `volec query unsafe [FILE...|std]`: the program's unsafe sites (read by
// run_query_inner with AUDIT_UNSAFE set).
pub fn query_unsafe(args: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let a = audit(args, tcx, pcx);
    let out = buf_new();
    if tcx.opt_summary {
        put_summary(out, a, tcx, pcx);
    } else if get_diag_json() {
        // (all of it: a tool reads it)
        tcx.opt_all = true;
        for i in 0..a.sites.len() as i64 {
            let s = a.sites.get(i);
            put_json(out, a, s, tcx, pcx);
        }
    } else {
        for i in 0..a.sites.len() as i64 {
            let s = a.sites.get(i);
            put_line(out, a, s, tcx, pcx);
        }
        put_total(out, a, tcx, pcx);
    }
    buf_write_fd(out, STDOUT);
    0
}
