// The definitions `query` answers about (0.11): every item of the program
// as parsed, a Def (kind, name, module, position, `pub`), collected before
// the checker runs; their paths (`fqn`, the `path` partial names match,
// `owner`, `tr`) once it has; and the matching of a NAME against those
// paths, by whole segments.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern, intern_c, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{FN_CLOSURE, FN_DERIVED, NodeKind, child};
use crate::front::generics::{TPL_DISTINCT, TPL_PATTERN, TPL_SLICE};
use crate::front::modules::{child_module, module_count, module_of};
use crate::front::parser::items::ITEM_PUBLIC;
use crate::front::traits::impl_trait_node;
use crate::front::types::{TyKind, get_enums};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::positions::{collapse, name_position, sort_by_position};

// ---- Definitions ----

pub const K_FN: i64 = 1;
// A function of an impl block (`impl T { ... }`).
pub const K_METHOD: i64 = 2;
// A function of an `impl Trait for T` block.
pub const K_IMPL_METHOD: i64 = 3;
// A function declared by a trait (with or without a default body).
pub const K_TRAIT_FN: i64 = 4;
pub const K_STRUCT: i64 = 5;
pub const K_ENUM: i64 = 6;
pub const K_VARIANT: i64 = 7;
pub const K_FIELD: i64 = 8;
pub const K_TRAIT: i64 = 9;
pub const K_CONST: i64 = 10;
pub const K_STATIC: i64 = 11;
pub const K_ALIAS: i64 = 12;
pub const K_MOD: i64 = 13;

pub fn kind_name(k: i64) -> *mut u8 {
    if k == K_FN { return c"fn"; }
    if k == K_METHOD || k == K_IMPL_METHOD { return c"method"; }
    if k == K_TRAIT_FN { return c"trait-method"; }
    if k == K_STRUCT { return c"struct"; }
    if k == K_ENUM { return c"enum"; }
    if k == K_VARIANT { return c"variant"; }
    if k == K_FIELD { return c"field"; }
    if k == K_TRAIT { return c"trait"; }
    if k == K_CONST { return c"const"; }
    if k == K_STATIC { return c"static"; }
    if k == K_ALIAS { return c"type"; }
    c"mod"
}

// A definition: its item node (as parsed), name, module, the definition
// it belongs to (a field's struct, a variant's enum, a function's trait;
// -1), the position of its name, whether it is `pub`; after the checker,
// its path (`fqn`), the path partial names are matched against (`path`:
// a trait impl's function as `Type::f`), the path of its type (`owner`,
// for functions of impl blocks) and of its trait (`tr`), as symbols.
#[derive(Clone, Copy)] pub struct Def {
    pub node: i64, pub kind: i64, pub name: i64, pub module: i64, pub parent: i64, pub start: i64,
    pub end: i64, pub name_pos: i64, pub public: bool, pub impl_node: i64,
    pub fqn: i64, pub path: i64, pub owner: i64, pub tr: i64,
}

fn add_def(node: i64, kind: i64, name: i64, parent: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let d = pcx.defs.len() as i64;
    let pcx_arg = Def {
        node: node, kind: kind, name: name, module: module_of(node, pcx), parent: parent,
        start: pcx.nodes[node as usize].start, end: pcx.nodes[node as usize].end,
        name_pos: name_position(pcx.nodes[node as usize].start, name, pcx),
        public: (pcx.nodes[node as usize].p & ITEM_PUBLIC) != 0,
        impl_node: 0, fqn: -1, path: -1, owner: -1, tr: -1,
    };
    pcx.defs.push(pcx_arg);
    tcx.def_at.put(pcx.nodes[node as usize].start + 1, d + 1);
    d
}

// A definition as the tools' cache restores it (0.13), after the others.
pub fn restore_def(def: Def, pcx: &mut Ctx<Comp>) {
    pcx.defs.push(def);
}

// The definition whose node is n (or a copy of it), or -1.
pub fn def_of_node(n: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 {
        return -1;
    }
    if tcx.restored {
        // (from the cache: what stands for a node is the definition + 1)
        return n - 1;
    }
    // (0.14: a closure, its function: no item, though they start where
    // the closure is written)
    let k = pcx.nodes[n as usize].kind;
    // (0.15: a derived function, which starts where its #[derive] is,
    // as the struct does: no item)
    if k == NodeKind::Closure
        || (k == NodeKind::Fn && (pcx.nodes[n as usize].p & (FN_CLOSURE | FN_DERIVED)) != 0) {
        return -1;
    }
    tcx.def_at.get(pcx.nodes[n as usize].start + 1) - 1
}

// Whether symbol name is the other name an import gives (0.13).
pub fn is_alias_name(name: i64, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i < tcx.aliases.count {
            if (*tcx.aliases.data.add(i as usize)) == name {
                return true;
            }
            i += 2;
        }
        false
    }
}

// The definitions of the program's items, as parsed.
pub fn collect_defs(program: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.nodes[program as usize].count {
            let item = child(program, i, pcx);
            let kind = pcx.nodes[item as usize].kind;
            let name = pcx.nodes[item as usize].a;
            if kind == NodeKind::Fn {
                add_def(item, if pcx.nodes[item as usize].h != 0 { K_METHOD } else { K_FN }, name,
                    -1, tcx, pcx);
            } else if kind == NodeKind::ExternFn {
                add_def(item, K_FN, name, -1, tcx, pcx);
            }
            else if kind == NodeKind::Struct || kind == NodeKind::Enum || kind == NodeKind::Trait {
                let k = if kind == NodeKind::Struct { K_STRUCT }
                    else if kind == NodeKind::Enum { K_ENUM } else { K_TRAIT };
                let d = add_def(item, k, name, -1, tcx, pcx);
                let sub = if kind == NodeKind::Struct { K_FIELD }
                    else if kind == NodeKind::Enum { K_VARIANT } else { K_TRAIT_FN };
                for j in 0..pcx.nodes[item as usize].count {
                    let c = child(item, j, pcx);
                    add_def(c, sub, pcx.nodes[c as usize].a, d, tcx, pcx);
                }
            } else if kind == NodeKind::Const {
                add_def(item, K_CONST, name, -1, tcx, pcx);
            } else if kind == NodeKind::Static || kind == NodeKind::Embed {
                // (0.26.0: an `embed wgsl K` block is its static K, the
                // block's text)
                add_def(item, K_STATIC, name, -1, tcx, pcx);
            } else if kind == NodeKind::TypeAlias {
                add_def(item, K_ALIAS, name, -1, tcx, pcx);
            } else if kind == NodeKind::Mod {
                add_def(item, K_MOD, name, -1, tcx, pcx);
            }
            else if kind == NodeKind::Use && pcx.nodes[item as usize].d == 2
                && pcx.nodes[item as usize].a != 0
                && tcx.c_alias < 0 {
                tcx.c_alias = pcx.nodes[item as usize].a;
                tcx.c_alias_module = module_of(item, pcx);
            } else if kind == NodeKind::Use && pcx.nodes[item as usize].d != 2 {
                for j in 0..pcx.nodes[item as usize].count {
                    let id = child(item, j, pcx);
                    if pcx.nodes[id as usize].b != 0 {
                        tcx.aliases.push(pcx.nodes[id as usize].b);
                        tcx.aliases.push(pcx.nodes[id as usize].start);
                    }
                }
            }
        }
        // The functions of trait impls (pushed before their Impl node).
        for i in 0..pcx.nodes[program as usize].count {
            let item = child(program, i, pcx);
            if pcx.nodes[item as usize].kind != NodeKind::Impl {
                continue;
            }
            for j in 0..pcx.nodes[item as usize].count {
                let d = def_of_node(child(item, j, pcx), tcx, pcx);
                if d >= 0 {
                    pcx.defs[d as usize].kind = K_IMPL_METHOD;
                    pcx.defs[d as usize].impl_node = item;
                }
            }
        }
        for _ in 0..module_count(pcx) {
            pcx.mod_def.push(-1);
        }
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].kind == K_MOD {
                let m = child_module(pcx.defs[d as usize].module, pcx.defs[d as usize].name, pcx);
                if m >= 0 {
                    (*pcx.mod_def.data.add(m as usize)) = d;
                }
            }
        }
    }
}

// ---- Paths ----

pub fn mod_fqn(m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        while tcx.mod_fqn.count < module_count(pcx) {
            tcx.mod_fqn.push(-1);
        }
        if m < 0 || m >= tcx.mod_fqn.count {
            return intern_c(c"crate", pcx);
        }
        if (*tcx.mod_fqn.data.add(m as usize)) >= 0 {
            return (*tcx.mod_fqn.data.add(m as usize));
        }
        let mut s: i64 = 0;
        if m == 0 {
            s = intern_c(c"crate", pcx);
        } else if m == pcx.std_module {
            s = intern_c(c"std", pcx);
        } else if m == pcx.c_module {
            s = if tcx.c_alias
                >= 0 { join(mod_fqn(tcx.c_alias_module, tcx, pcx), c"::", tcx.c_alias, pcx) }
                else { intern_c(c"c", pcx) };
        } else {
            s = join(mod_fqn(pcx.modules[m as usize].parent, tcx, pcx), c"::",
                pcx.modules[m as usize].name, pcx);
        }
        (*tcx.mod_fqn.data.add(m as usize)) = s;
        s
    }
}

// The text of mod_fqn(m). (Not `SYMS[mod_fqn(m)].text`: that indexes the
// SYMS of before the call, which mod_fqn can grow and move.)
pub fn mod_fqn_text(m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> &'static [u8] {
    let s = mod_fqn(m, tcx, pcx);
    sym_text(s, pcx)
}

fn join(a: i64, sep: *mut u8, b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_bytes(out, sym_text(a, pcx));
    buf_str(out, sep);
    buf_bytes(out, sym_text(b, pcx));
    intern(buf_slice(out), pcx)
}

// The text of node n's source, its whitespace collapsed.
fn node_text(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    collapse(out, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
    intern(buf_slice(out), pcx)
}

// The fields of the types expand_embeds made (front/embed/wgsl.vl), each a
// field of its block's definition (a static: K.src, K.step).
fn embed_field_defs(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let blocks = pcx.block_node;
    let structs = pcx.block_struct;
    for b in 0..blocks.count {
        let parent = def_of_node(blocks.get(b), tcx, pcx);
        if parent < 0 {
            continue;
        }
        let s = structs.get(b);
        for j in 0..pcx.nodes[s as usize].count {
            let f = child(s, j, pcx);
            // (its name is in the block's text, no token: at the node)
            let d = add_def(f, K_FIELD, pcx.nodes[f as usize].a, parent, tcx, pcx);
            pcx.defs[d as usize].name_pos = pcx.nodes[f as usize].start;
        }
    }
}

// The paths of the definitions, once the checker has resolved the types
// of the impl blocks and the traits of the trait impls.
pub fn finish_defs(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    // (0.26.0) the fields of the `embed wgsl` blocks' types, made by the
    // checker: `K.step`'s definition is the WGSL `fn step`
    embed_field_defs(tcx, pcx);
    unsafe {
        // The type of each function of an impl block: its item node.
        let mut owners = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for i in 0..pcx.methods.len() as i64 {
            let t = pcx.methods[i as usize].ty;
            let node: i64 = if pcx.types[t as usize].kind == TyKind::Struct {
                pcx.structs[pcx.types[t as usize].a as usize].node
            } else if pcx.types[t as usize].kind == TyKind::Enum {
                (*get_enums().add(pcx.types[t as usize].a as usize)).node
            } else {
                0
            };
            if node != 0 {
                owners.put(pcx.methods[i as usize].f + 1, node);
            }
        }
        for i in 0..pcx.gmethods.len() as i64 {
            let tpl = pcx.gmethods[i as usize].ty;
            // (0.14: `impl<T> [T]` has no item)
            // (0.27.2: a pattern impl, `impl<T> Tr for &T`, has no item either)
            if tpl == TPL_SLICE || tpl == TPL_PATTERN {
                continue;
            }
            // (0.18: `impl<T> NonNull<T>`: the alias)
            owners.put(pcx.gmethods[i as usize].f + 1,
                if tpl >= TPL_DISTINCT { tpl - TPL_DISTINCT }
                else if tpl > 0 { pcx.structs[(tpl - 1) as usize].node }
                else { (*get_enums().add((-tpl - 1) as usize)).node });
        }
        let mut trait_names = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        // (the struct and enum definitions by name and module, and by
        // name when only one has it: -1 for several)
        let mut type_here = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut type_named = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d as usize].kind;
            if (k == K_STRUCT || k == K_ENUM) && pcx.defs[d as usize].parent < 0 {
                let n = pcx.defs[d as usize].name;
                type_here.put(n * (module_count(pcx) + 1) + pcx.defs[d as usize].module + 1, d + 1);
                type_named.put(n + 1, if type_named.get(n + 1) != 0 { -1 } else { d + 1 });
            }
        }
        for d in 0..pcx.defs.len() {
            let k = pcx.defs[d].kind;
            if k == K_TRAIT {
                let seen = trait_names.get(pcx.defs[d].name + 1);
                trait_names.put(pcx.defs[d].name + 1, seen + 1);
            }
            if pcx.defs[d].parent >= 0 || k == K_METHOD || k == K_IMPL_METHOD {
                continue;
            }
            if k == K_MOD {
                let m = child_module(pcx.defs[d].module, pcx.defs[d].name, pcx);
                pcx.defs[d].fqn = if m >= 0 { mod_fqn(m, tcx, pcx) }
                    else {
                        join(mod_fqn(pcx.defs[d].module, tcx, pcx), c"::", pcx.defs[d].name, pcx)
                    };
            } else {
                pcx.defs[d].fqn = join(mod_fqn(pcx.defs[d].module, tcx, pcx), c"::",
                    pcx.defs[d].name, pcx);
            }
            pcx.defs[d].path = pcx.defs[d].fqn;
        }
        for d in 0..pcx.defs.len() {
            let k = pcx.defs[d].kind;
            if pcx.defs[d].parent >= 0 {
                let p = pcx.defs[d].parent;
                pcx.defs[d].owner = pcx.defs[p as usize].fqn;
                pcx.defs[d].fqn = join(pcx.defs[p as usize].fqn,
                    if k == K_FIELD { c"." } else { c"::" }, pcx.defs[d].name, pcx);
                pcx.defs[d].path = pcx.defs[d].fqn;
                continue;
            }
            if k != K_METHOD && k != K_IMPL_METHOD {
                continue;
            }
            let node = pcx.defs[d].node;
            let f = pcx.nodes[node as usize].x - 1;
            let mut owner: i64 = -1;
            if f >= 0 {
                let od = def_of_node(owners.get(f + 1), tcx, pcx);
                if od >= 0 {
                    owner = pcx.defs[od as usize].fqn;
                }
            }
            if owner < 0 {
                // (a builtin type, or an impl the checker left out: 0.25.2.2,
                // a trait impl's, `impl Render<Metal> for Metal`, the struct
                // or enum of that name in the impl's module, else the one
                // struct or enum of that name)
                let h = pcx.nodes[node as usize].h;
                if pcx.nodes[h as usize].kind == NodeKind::TyName && k == K_IMPL_METHOD {
                    let n = pcx.nodes[h as usize].a;
                    let here = type_here.get(n * (module_count(pcx) + 1) + pcx.defs[d].module + 1);
                    let any = type_named.get(n + 1);
                    owner = if here > 0 { pcx.defs[(here - 1) as usize].fqn }
                        else if any > 0 { pcx.defs[(any - 1) as usize].fqn } else { n };
                } else {
                    owner = if pcx.nodes[h as usize].kind
                        == NodeKind::TyName { pcx.nodes[h as usize].a }
                        else { node_text(h, pcx) };
                }
            }
            pcx.defs[d].owner = owner;
            pcx.defs[d].path = join(owner, c"::", pcx.defs[d].name, pcx);
            if k == K_METHOD {
                pcx.defs[d].fqn = pcx.defs[d].path;
                continue;
            }
            // `<Type as Trait>::f`: the trait by its name, or by its path
            // when two traits have that name.
            let mut tr: i64 = -1;
            let mut shown: i64 = -1;
            let td: i64 = if f >= 0 { def_of_node(impl_trait_node(f, pcx), tcx, pcx) } else { -1 };
            if td >= 0 {
                tr = pcx.defs[td as usize].fqn;
                shown = if trait_names.get(pcx.defs[td as usize].name + 1)
                    > 1 { pcx.defs[td as usize].fqn }
                    else { pcx.defs[td as usize].name };
            } else {
                tr = node_text(pcx.nodes[pcx.defs[d].impl_node as usize].a, pcx);
                shown = tr;
            }
            pcx.defs[d].tr = tr;
            let out = buf_new();
            buf_byte(out, b'<');
            buf_bytes(out, sym_text(owner, pcx));
            buf_str(out, c" as ");
            buf_bytes(out, sym_text(shown, pcx));
            buf_str(out, c">::");
            buf_bytes(out, sym_text(pcx.defs[d].name, pcx));
            pcx.defs[d].fqn = intern(buf_slice(out), pcx);
        }
    }
}

// The trait definition of a trait impl's function, or -1.
pub fn trait_of(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.defs[d as usize].kind != K_IMPL_METHOD {
            return -1;
        }
        if tcx.restored {
            return (*tcx.c_trait.data.add(d as usize));
        }
        let f = pcx.nodes[pcx.defs[d as usize].node as usize].x - 1;
        if f < 0 { -1 } else { def_of_node(impl_trait_node(f, pcx), tcx, pcx) }
    }
}

// ---- Matching names ----

pub fn bytes_eq(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// Whether path p ends with name s, by whole segments (or s is `.field`).
pub fn ends_with(p: &[u8], s: &[u8], exact: bool) -> bool {
    if s.len() == 0 || s.len() > p.len() {
        return false;
    }
    let k = p.len() as i64 - s.len() as i64;
    for i in 0..s.len() as i64 {
        if p[(k + i) as usize] != s[i as usize] {
            return false;
        }
    }
    if k == 0 {
        return true;
    }
    if exact {
        return false;
    }
    s[0] == b'.' || (k >= 2 && p[(k - 1) as usize] == b':' && p[(k - 2) as usize] == b':')
}

// The index of `pat` in s at or after `from`, or -1.
pub fn find_in(s: &[u8], pat: *mut u8, from: i64) -> i64 {
    let n = unsafe { strlen(pat) as i64 };
    let mut i = from;
    while i + n <= s.len() as i64 {
        let mut ok = true;
        for j in 0..n {
            if unsafe { s[(i + j) as usize] != (*pat.add(j as usize)) } {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

// Whether definition d answers to `name`.
fn name_matches(d: i64, name: &[u8], exact: bool, pcx: &Ctx<Comp>) -> bool {
    let fqn = sym_text(pcx.defs[d as usize].fqn, pcx);
    if bytes_eq(fqn, name) {
        return true;
    }
    if name.len() > 0 && name[0] == b'<' {
        // `<Type as Trait>::f`, each part full or partial.
        if pcx.defs[d as usize].kind != K_IMPL_METHOD {
            return false;
        }
        let a = find_in(name, c" as ", 1);
        let b = find_in(name, c">::", 1);
        if a < 0 || b < a {
            return false;
        }
        return ends_with(sym_text(pcx.defs[d as usize].owner, pcx), &name[1..a as usize], exact)
            && (ends_with(sym_text(pcx.defs[d as usize].tr, pcx),
                &name[(a + 4) as usize..b as usize], exact))
            && bytes_eq(sym_text(pcx.defs[d as usize].name, pcx), &name[(b + 3) as usize..]);
    }
    ends_with(sym_text(pcx.defs[d as usize].path, pcx), name, exact)
}

// The definitions answering to `name`, in order of position.
pub fn find_defs(name: &[u8], exact: bool, out: &mut IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    for d in 0..pcx.defs.len() as i64 {
        if (pcx.defs[d as usize].fqn >= 0) && name_matches(d, name, exact, pcx) {
            out.push(d);
        }
    }
    sort_by_position(*out, tcx, pcx);
}

// The last segment of a name (after `::`, `.` or `>::`).
pub fn last_segment(name: &[u8]) -> &[u8] {
    let mut i = name.len() as i64;
    while i > 0 && name[(i - 1) as usize] != b':' && name[(i - 1) as usize] != b'.' {
        i -= 1;
    }
    &name[i as usize..]
}
