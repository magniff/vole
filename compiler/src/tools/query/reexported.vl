// (0.25.2.1) The items a module re-exports (`pub use types::{Color,
// ...};`): `query show std::gpu::Color` is std::gpu::types::Color, and
// `query items std::gpu` lists the names it re-exports, as a program
// names them (`gpu::Color::rgba` compiles; the 0.25.2 eval's `query show
// std::gpu::Color` found nothing). Read from the source text, so the
// tools' cache answers it too.

use crate::base::{SOURCE_VOLE, buf_byte, buf_bytes, buf_copy, buf_int, buf_new, buf_str, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{module_at, within_std};
use crate::tools::ctx::Tcx;
use crate::tools::proc::same_bytes;
use crate::tools::query::defs::{find_defs, kind_name, mod_fqn_text};
use crate::tools::query::positions::line_of;

// The `pub use` statements of module m (and with `private` its `use`
// statements too, 0.25.2.2): their first byte and the byte
// after their `;`, in pairs.
fn pub_uses_of(m: i64, private: bool, out: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) {
    for f in 0..pcx.files.len() {
        if pcx.files[f].kind != SOURCE_VOLE {
            continue;
        }
        let mut p = pcx.files[f].start;
        let end = pcx.files[f].end;
        while p < end {
            let mut q = p;
            while q < end && (get_src()[q as usize] == b' ' || get_src()[q as usize] == b'\t') {
                q += 1;
            }
            if ((q + 8 <= end && same_bytes(&get_src()[q as usize..(q + 8) as usize], b"pub use "))
                || (private && q + 4 <= end
                    && same_bytes(&get_src()[q as usize..(q + 4) as usize], b"use ")))
                && module_at(q, pcx) == m {
                let mut e = q;
                while e < end && get_src()[e as usize] != b';' {
                    e += 1;
                }
                out.push(q);
                out.push(if e < end { e + 1 } else { e });
            }
            while p < end && get_src()[p as usize] != b'\n' {
                p += 1;
            }
            p += 1;
        }
    }
}

// The names one `pub use` (SRC[s..e)) brings, as (the path before the
// names, the name, the name it is seen by) slices of a buffer's text:
// triples of (start, end) pairs into `parts`, over buffer `text`.
fn use_names(s: i64, e: i64, text: i64, parts: &mut Vec<i64, Comp>) {
    // (the statement without `pub use `, its `;` and its blanks)
    let skip: i64 = if get_src()[s as usize] == b'p' { 8 } else { 4 };
    for i in s + skip..e {
        let c = get_src()[i as usize];
        if c != b' ' && c != b'\t' && c != b'\n' && c != b';' {
            buf_byte(text, c);
        }
        else if c == b' ' && i + 3 < e && get_src()[(i + 1) as usize] == b'a'
            && get_src()[(i + 2) as usize] == b's'
            && get_src()[(i + 3) as usize] == b' ' {
            // (`X as Y`: kept as `X@Y`)
            buf_byte(text, b'@');
        }
    }
    let t = buf_copy(text);
    // (`as`'s letters after the `@` dropped: `X@asY` -> X, Y)
    let mut brace: i64 = -1;
    for i in 0..t.len() as i64 {
        if t[i as usize] == b'{' && brace < 0 {
            brace = i;
        }
    }
    let mut ps: i64 = 0;
    let mut pe: i64 = 0;
    let mut ls: i64 = 0;
    let mut le: i64 = 0;
    if brace >= 2 {
        ps = 0;
        pe = brace - 2;
        ls = brace + 1;
        le = t.len() as i64;
        while le > ls && t[(le - 1) as usize] == b'}' {
            le -= 1;
        }
    } else {
        let mut cut: i64 = -1;
        for i in 1..t.len() as i64 {
            if t[i as usize] == b':' && t[(i - 1) as usize] == b':' {
                cut = i;
            }
        }
        if cut < 0 {
            return;
        }
        ps = 0;
        pe = cut - 1;
        ls = cut + 1;
        le = t.len() as i64;
    }
    let mut a = ls;
    for i in ls..le + 1 {
        if i == le || t[i as usize] == b',' {
            if i > a {
                let mut at: i64 = -1;
                for j in a..i {
                    if t[j as usize] == b'@' {
                        at = j;
                    }
                }
                parts.push(ps);
                parts.push(pe);
                if at < 0 {
                    parts.push(a);
                    parts.push(i);
                    parts.push(a);
                    parts.push(i);
                } else {
                    // (`X@asY`)
                    parts.push(a);
                    parts.push(at);
                    parts.push(if at + 3 <= i { at + 3 } else { i });
                    parts.push(i);
                }
            }
            a = i + 1;
        }
    }
}

// The definitions path `prefix::name` (written in module m) names, into
// out: from m, its parent, the root of m's tree (crate or std), as
// written.
fn defs_from(m: i64, prefix: &[u8], name: &[u8], tail: &[u8], out: &mut Vec<i64, Comp>,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    for k in 0..4 {
        let full = buf_new();
        let mut base: i64 = -2;
        if k == 0 {
            base = m;
        } else if k == 1 {
            base = if m > 0 { pcx.modules[m as usize].parent } else { -2 };
        } else if k == 2 {
            base = -1;
        }
        if prefix.len() >= 6 && same_bytes(&prefix[0..6], b"super:") && m > 0 {
            if k > 0 {
                return;
            }
            buf_bytes(full, mod_fqn_text(pcx.modules[m as usize].parent, tcx, pcx));
            buf_bytes(full, &prefix[5..prefix.len()]);
        } else if prefix.len() >= 4 && same_bytes(&prefix[0..4], b"self") {
            if k > 0 {
                return;
            }
            buf_bytes(full, mod_fqn_text(m, tcx, pcx));
            buf_bytes(full, &prefix[4..prefix.len()]);
        } else if base >= 0 {
            buf_bytes(full, mod_fqn_text(base, tcx, pcx));
            buf_str(full, c"::");
            buf_bytes(full, prefix);
        } else if base == -1 {
            buf_str(full, if within_std(m, pcx) { c"std::" } else { c"crate::" });
            buf_bytes(full, prefix);
        } else if k == 3 {
            buf_bytes(full, prefix);
        } else {
            continue;
        }
        buf_str(full, c"::");
        buf_bytes(full, name);
        buf_bytes(full, tail);
        find_defs(&buf_copy(full), true, out, tcx, pcx);
        if out.len() as i64 > 0 {
            return;
        }
    }
}

// NAME (`std::gpu::Color`, `std::gpu::Color::rgba`) through a module's
// re-export: the definitions it names, into out; the module re-exporting
// (-1: none). With `private`, through its `use` too (0.25.2.2:
// `std::gpu::wgsl::expr::Front::unary`, where expr imports Front).
pub fn reexport_defs(name: &[u8], private: bool, out: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    let mut cut = name.len() as i64 - 1;
    while cut > 1 {
        if name[cut as usize] == b':' && name[(cut - 1) as usize] == b':' {
            let mod_name = &name[0..(cut - 1) as usize];
            let rest = &name[(cut + 1) as usize..];
            let mut h: i64 = 0;
            while h + 1 < rest.len() as i64
                && !(rest[h as usize] == b':' && rest[(h + 1) as usize] == b':') {
                h += 1;
            }
            if h + 1 >= rest.len() as i64 {
                h = rest.len() as i64;
            }
            let head = &rest[0..h as usize];
            let tail = &rest[h as usize..];
            for m in 0..crate::front::modules::module_count(pcx) {
                if pcx.modules[m as usize].name < 0 && m != 0 {
                    continue;
                }
                // (a crate module as a program names it: `paint` for crate::paint)
                let fq = mod_fqn_text(m, tcx, pcx);
                let bare = fq.len() > 7 && same_bytes(&fq[0..7], b"crate::")
                    && same_bytes(&fq[7..fq.len()], mod_name);
                if !same_bytes(fq, mod_name) && !bare {
                    continue;
                }
                let mut uses: Vec<i64, Comp> = Vec::new_in(Comp {});
                pub_uses_of(m, private, &mut uses, pcx);
                let mut u: i64 = 0;
                while u + 1 < uses.len() as i64 {
                    let text = buf_new();
                    let mut parts: Vec<i64, Comp> = Vec::new_in(Comp {});
                    use_names((uses[u as usize]), (uses[(u + 1) as usize]),
                        text, &mut parts);
                    let t = buf_copy(text);
                    let mut k: i64 = 0;
                    while k + 5 < parts.len() as i64 {
                        let seen = &t[
                            (parts[(k + 4) as usize]) as usize..(parts[(k + 5) as usize]) as usize];
                        if same_bytes(seen, head) {
                            defs_from(m,
                                &t[
                                    (parts[k as usize]) as usize..(parts[(k + 1) as usize]) as usize],
                                &t[
                                    (parts[(k + 2) as usize]) as usize..(
                                        parts[(k + 3) as usize]) as usize], tail, out,
                                tcx, pcx);
                            if out.len() as i64 > 0 {
                                return m;
                            }
                        }
                        k += 6;
                    }
                    u += 2;
                }
            }
        }
        cut -= 1;
    }
    -1
}

// `query items`' lines of the names module m re-exports: `LINE<TAB>use<TAB>
// pub use NAME = PATH (KIND)`, one a name.
pub fn put_reexports(out: i64, m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut uses: Vec<i64, Comp> = Vec::new_in(Comp {});
    pub_uses_of(m, false, &mut uses, pcx);
    let mut u: i64 = 0;
    while u + 1 < uses.len() as i64 {
        let text = buf_new();
        let mut parts: Vec<i64, Comp> = Vec::new_in(Comp {});
        use_names((uses[u as usize]), (uses[(u + 1) as usize]), text,
            &mut parts);
        let t = buf_copy(text);
        let mut k: i64 = 0;
        while k + 5 < parts.len() as i64 {
            let prefix = &t[
                (parts[k as usize]) as usize..(parts[(k + 1) as usize]) as usize];
            let name = &t[
                (parts[(k + 2) as usize]) as usize..(parts[(k + 3) as usize]) as usize];
            let seen = &t[
                (parts[(k + 4) as usize]) as usize..(parts[(k + 5) as usize]) as usize];
            let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
            defs_from(m, prefix, name, &t[0..0], &mut found, tcx, pcx);
            buf_int(out, line_of((uses[u as usize]), pcx));
            buf_str(out, c"\tuse\tpub use ");
            buf_bytes(out, seen);
            buf_str(out, c" = ");
            if found.len() as i64 > 0 {
                let d = (found[0]);
                buf_bytes(out, crate::base::sym_text(pcx.defs[d as usize].fqn, pcx));
                buf_str(out, c" (");
                buf_str(out, kind_name(pcx.defs[d as usize].kind));
                buf_byte(out, b')');
            } else {
                buf_bytes(out, prefix);
                buf_str(out, c"::");
                buf_bytes(out, name);
            }
            buf_byte(out, b'\n');
            k += 6;
        }
        u += 2;
    }
}
