// `query callees FN [--transitive] [--writes TABLE]` (0.16; docs/query.md):
// the functions FN calls, as the checker resolved its calls, and the
// functions it names as values (they may be called through a pointer);
// with --transitive, every function reachable that way, each with its
// depth and the caller it was first reached from. With --writes TABLE (a
// static or a field): the places in FN and the functions it reaches that
// write TABLE (an assignment to it or into it) or borrow it (`&TABLE`, a
// method taking `self: *T` called on it, as `TABLE.push(x)`), each with
// the chain of calls from FN: whether FN can change TABLE.
//
// The edges are the references the checker recorded (refs.vl), each
// counted for the innermost definition holding it. A call through a
// function pointer is not an edge; the function named where the pointer
// was made is.

use crate::base::{IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::NodeKind;
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{QF_CALL, QF_DEF, QF_USE, QF_WRITE};
use crate::tools::query::defs::{K_FN, K_IMPL_METHOD, K_METHOD, K_TRAIT_FN, trait_of};
use crate::tools::query::diagnostics::{diag, sym_less};
use crate::tools::query::positions::{enclosing, find_name, line_of, line_start, token_at};
use crate::tools::query::refs::{collect_refs, file_text, put_line, put_short, ref_in, try_refs};

// The lines printed before the rest is cut (--limit N, --all).
const CALLEES_BUDGET: i64 = 100;

// Whether definition d is a function (with or without a body).
fn is_fn_def(d: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
}

fn add_edge(from: i64, to: i64, call: bool, seen: &mut HMap, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        // (once per caller and callee: a generic function's instances
        // repeat its calls; a call wins over a mention)
        let key = (from * (pcx.defs.len() as i64 + 1) + to) * 2 + 1;
        let e0 = seen.get(key) - 1;
        if e0 >= 0 {
            if call {
                (*tcx.e_call.data.add(e0 as usize)) = 1;
            }
            return;
        }
        seen.put(key, tcx.callees_e_from.count + 1);
        tcx.callees_e_from.push(from);
        tcx.callees_e_to.push(to);
        tcx.e_call.push(if call { 1 } else { 0 });
        tcx.e_next.push(tcx.e_head.get(from + 1));
        tcx.e_head.put(from + 1, tcx.callees_e_from.count);
    }
}

// Every reference of the program, then the edges of the call graph.
fn build_graph(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        tcx.refs_targets.count = 0;
        tcx.r_pos.count = 0;
        tcx.r_def.count = 0;
        tcx.r_group.count = 0;
        tcx.r_flags.count = 0;
        tcx.refs_group = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for d in 0..pcx.defs.len() as i64 {
            tcx.refs_group.put(d + 1, 1);
        }
        collect_refs(tcx, pcx);
        let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for r in 0..tcx.r_pos.count {
            let fl = (*tcx.r_flags.data.add(r as usize));
            let to = (*tcx.r_def.data.add(r as usize));
            if (fl & (QF_DEF | QF_USE)) != 0 || !is_fn_def(to, pcx) {
                continue;
            }
            let from = enclosing((*tcx.r_pos.data.add(r as usize)), tcx, pcx);
            if from < 0 {
                continue;
            }
            let call = (fl & QF_CALL) != 0;
            add_edge(from, to, call, &mut seen, tcx, pcx);
            // (a trait's function: the functions implementing it too)
            if pcx.defs[to as usize].kind == K_TRAIT_FN {
                for d in 0..pcx.defs.len() as i64 {
                    if pcx.defs[d as usize].kind == K_IMPL_METHOD && pcx.defs[d as usize].name == pcx.defs[to as usize].name
                        && trait_of(d, tcx, pcx) == pcx.defs[to as usize].parent {
                        add_edge(from, d, call, &mut seen, tcx, pcx);
                    }
                }
            }
        }
    }
}

// Where definition d is: `FILE:LINE`.
fn put_def_loc(out: i64, d: i64, pcx: &Ctx<Comp>) {
    let p = pcx.defs[d as usize].name_pos;
    buf_bytes(out, file_text(file_of_pos(p, pcx), pcx));
    buf_byte(out, b':');
    buf_int(out, line_of(p, pcx));
}

// The chain of calls from the start to d: `f > g > d`.
fn put_chain(out: i64, d: i64, via: HMap, pcx: &Ctx<Comp>) {
    unsafe {
        let mut chain = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut x = d;
        while x >= 0 && chain.count < 64 {
            chain.push(x);
            x = via.get(x + 1) - 1;
        }
        let mut i = chain.count - 1;
        while i >= 0 {
            put_short(out, pcx.defs[(*chain.data.add(i as usize)) as usize].fqn, pcx);
            if i > 0 {
                buf_str(out, c" > ");
            }
            i -= 1;
        }
    }
}

// `query callees`: the functions the definitions `matches` call (all of
// them reachable, with --transitive), or with --writes the places in them
// that change TABLE (`table`: its definitions). The status.
pub fn query_callees(matches: IntVec, name: &[u8], table: IntVec, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        build_graph(tcx, pcx);
        // Breadth first from the functions asked about: per definition + 1,
        // its depth + 1 and the caller it was reached from + 1.
        let mut depth = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut via = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut how = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..matches.count {
            let d = (*matches.data.add(i as usize));
            if depth.get(d + 1) == 0 {
                depth.put(d + 1, 1);
                order.push(d);
            }
        }
        let all = tcx.opt_transitive || tcx.opt_writes != 0 as *mut u8;
        let mut k: i64 = 0;
        while k < order.count {
            let d = (*order.data.add(k as usize));
            k += 1;
            let dd = depth.get(d + 1);
            if dd > 1 && !all {
                continue;
            }
            let mut e = tcx.e_head.get(d + 1) - 1;
            while e >= 0 {
                let to = (*tcx.callees_e_to.data.add(e as usize));
                if depth.get(to + 1) == 0 {
                    depth.put(to + 1, dd + 1);
                    via.put(to + 1, d + 1);
                    how.put(to + 1, (*tcx.e_call.data.add(e as usize)) + 1);
                    order.push(to);
                }
                e = (*tcx.e_next.data.add(e as usize)) - 1;
            }
        }
        if tcx.opt_writes != 0 as *mut u8 {
            return writes_of(order, via, table, name, tcx, pcx);
        }
        let first = matches.count;
        let total = order.count - first;
        // (by depth, then by path)
        let v = order.data;
        for a in first + 1..order.count {
            let mut j = a;
            while j > first && (depth.get((*v.add(j as usize)) + 1) < depth.get((*v.add((j - 1) as usize)) + 1)
                || (depth.get((*v.add(j as usize)) + 1) == depth.get((*v.add((j - 1) as usize)) + 1)
                    && sym_less(pcx.defs[(*v.add(j as usize)) as usize].fqn, pcx.defs[(*v.add((j - 1) as usize)) as usize].fqn, pcx))) {
                let t = (*v.add(j as usize));
                (*v.add(j as usize)) = (*v.add((j - 1) as usize));
                (*v.add((j - 1) as usize)) = t;
                j -= 1;
            }
        }
        let out = buf_new();
        if tcx.opt_count {
            buf_int(out, total);
            buf_byte(out, b'\n');
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if total == 0 {
            let d = diag(c"note", c"query.empty", tcx);
            buf_str(d, c"0 callees\n");
            return 0;
        }
        let shown = if tcx.opt_all { total }
            else if tcx.opt_limit >= 0 && tcx.opt_limit < total { tcx.opt_limit }
            else if tcx.opt_limit < 0 && total > CALLEES_BUDGET { CALLEES_BUDGET } else { total };
        for i in 0..shown {
            let d = (*order.data.add((first + i) as usize));
            buf_int(out, depth.get(d + 1) - 1);
            buf_byte(out, b'\t');
            buf_str(out, if how.get(d + 1) == 2 { c"call" } else { c"ref" });
            buf_byte(out, b'\t');
            put_short(out, pcx.defs[d as usize].fqn, pcx);
            buf_byte(out, b'\t');
            put_def_loc(out, d, pcx);
            if depth.get(d + 1) > 2 {
                buf_str(out, c"\tvia ");
                put_short(out, pcx.defs[(via.get(d + 1) - 1) as usize].fqn, pcx);
            }
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        if shown < total {
            let d = diag(c"note", c"query.truncated", tcx);
            buf_str(d, c"showing ");
            buf_int(d, shown);
            buf_str(d, c" of ");
            buf_int(d, total);
            buf_str(d, c" callees\n");
            try_refs(c"callees", name,
                if tcx.opt_transitive { c"--transitive --all" } else { c"--all" }, &name[0..0],
                tcx, pcx);
        }
        0
    }
}

// The positions of the names of the places assignments write (1) and of
// those borrowed (2: `&p`, and a method's `self: *T` receiver), with the
// places they are made of up to a dereference (`A.b[i] = x` writes A and
// b), into out (position + 1).
pub fn changed_places(out: &mut HMap, pcx: &Ctx<Comp>) {
    for n in 1..pcx.nodes.len() {
        let k = pcx.nodes[n].kind;
        let mut t: i64 = 0;
        let mut how: i64 = 0;
        if k == NodeKind::Assign {
            t = pcx.nodes[n].b;
            how = 1;
        } else if k == NodeKind::Unary && pcx.nodes[n].op == Tok::Amp {
            t = pcx.nodes[n].b;
            how = 2;
        }
        while t > 0 {
            let tk = pcx.nodes[t as usize].kind;
            if tk == NodeKind::Ident {
                // (each name of a path: its last is where refs has it)
                let mut i = token_at(pcx.nodes[t as usize].start, pcx);
                while i < pcx.toks.len() as i64 && pcx.toks[i as usize].start < pcx.nodes[t as usize].end {
                    if pcx.toks[i as usize].kind == Tok::Ident && out.get(pcx.toks[i as usize].start + 1) != 1 {
                        out.put(pcx.toks[i as usize].start + 1, how);
                    }
                    i += 1;
                }
                break;
            }
            if tk == NodeKind::FieldAccess {
                let a = pcx.nodes[t as usize].a;
                let p = find_name(pcx.nodes[a as usize].end, pcx.nodes[t as usize].end, pcx.nodes[t as usize].b, false, pcx);
                if p >= 0 && out.get(p + 1) != 1 {
                    out.put(p + 1, how);
                }
                t = a;
            } else if tk == NodeKind::Index || tk == NodeKind::TupleField {
                t = pcx.nodes[t as usize].a;
            } else {
                break;
            }
        }
    }
}

// --writes: the references to TABLE in the functions reached (`order`)
// that change it. The status.
fn writes_of(order: IntVec, via: HMap, table: IntVec, name: &[u8], tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut changed = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        changed_places(&mut changed, pcx);
        let mut reached = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for i in 0..order.count {
            reached.put((*order.data.add(i as usize)) + 1, 1);
        }
        let mut wanted = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for i in 0..table.count {
            wanted.put((*table.data.add(i as usize)) + 1, 1);
        }
        let mut sites = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut kinds = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for r in 0..tcx.r_pos.count {
            let pos = (*tcx.r_pos.data.add(r as usize));
            if wanted.get((*tcx.r_def.data.add(r as usize)) + 1) == 0
                || ((*tcx.r_flags.data.add(r as usize)) & (QF_DEF | QF_USE)) != 0
                || seen.get(pos + 1) != 0 || !ref_in(pos, pcx) {
                continue;
            }
            let e = enclosing(pos, tcx, pcx);
            if e < 0 || reached.get(e + 1) == 0 {
                continue;
            }
            let mut how = changed.get(pos + 1);
            if ((*tcx.r_flags.data.add(r as usize)) & QF_WRITE) != 0 {
                how = 1;
            }
            if how == 0 {
                continue;
            }
            seen.put(pos + 1, 1);
            sites.push(pos);
            kinds.push(how);
        }
        // (by position)
        let v = sites.data;
        let w = kinds.data;
        for a in 1..sites.count {
            let mut j = a;
            while j > 0 && (*v.add(j as usize)) < (*v.add((j - 1) as usize)) {
                let t = (*v.add(j as usize));
                (*v.add(j as usize)) = (*v.add((j - 1) as usize));
                (*v.add((j - 1) as usize)) = t;
                let u = (*w.add(j as usize));
                (*w.add(j as usize)) = (*w.add((j - 1) as usize));
                (*w.add((j - 1) as usize)) = u;
                j -= 1;
            }
        }
        let out = buf_new();
        if tcx.opt_count {
            buf_int(out, sites.count);
            buf_byte(out, b'\n');
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if sites.count == 0 {
            let d = diag(c"note", c"query.empty", tcx);
            buf_bytes(d, name);
            buf_str(d, c" reaches no write or borrow of ");
            put_short(d, pcx.defs[(*table.data.add(0)) as usize].fqn, pcx);
            buf_str(d, c" (");
            buf_int(d, order.count);
            buf_str(d, if order.count == 1 { c" function" } else { c" functions" });
            buf_str(d, c" reached by calls and functions named as values)\n");
            return 0;
        }
        let mut cur: i64 = -1;
        for i in 0..sites.count {
            let pos = (*sites.data.add(i as usize));
            let f = file_of_pos(pos, pcx);
            if f != cur {
                buf_str(out, c"# ");
                buf_bytes(out, file_text(f, pcx));
                buf_byte(out, b'\n');
                cur = f;
            }
            buf_int(out, line_of(pos, pcx));
            buf_byte(out, b':');
            buf_int(out, pos - line_start(pos, pcx) + 1);
            buf_byte(out, b'\t');
            buf_str(out, if (*kinds.data.add(i as usize)) == 1 { c"write" } else { c"borrow" });
            buf_byte(out, b'\t');
            put_chain(out, enclosing(pos, tcx, pcx), via, pcx);
            buf_byte(out, b'\t');
            put_line(out, pos, pcx);
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        0
    }
}
