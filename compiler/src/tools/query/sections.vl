// Section banners and comments as items (0.13; docs/query.md):
//
//   volec query items MODULE --comments    the items, with the banners
//                                              and comments between them
//   volec query show MODULE::section TITLE  a banner's section
//
// A banner is a block of comment lines outside every item whose first
// line is a rule, `// ---- Title ----` (a run of `-`, `=`, `#`, `*` or
// `~`, the title, maybe another run); its section runs to the next
// banner of its file (or the file's end). A comment is any other block of
// comment lines outside every item that is not an item's own (a blank
// line, or nothing, follows it) and not the file's header (code comes
// before it).

use crate::base::{
    SOURCE_VOLE, STDOUT, buf_byte, buf_bytes, buf_copy, buf_int, buf_new, buf_str, buf_write_fd,
    get_src,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{file_made, module_at};
use crate::tools::ctx::Tcx;
use crate::tools::query::defs::mod_fqn_text;
use crate::tools::query::diagnostics::{diag, try_begin, try_end, try_query};
use crate::tools::query::positions::{enclosing, line_end, line_of, put_path, token_at};
use crate::tools::query::show::find_modules;
use crate::tools::query_text::{TEXT_MAX, root_stem};

// ---- Finding banners ----

pub const B_SECTION: i64 = 1;
pub const B_COMMENT: i64 = 2;

// The first byte of the line at pos that is not a space or a tab.
fn indent_end(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let e = line_end(pos, pcx);
    let mut a = pos;
    while a < e && (get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\t') {
        a += 1;
    }
    a
}

fn comment_at(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let a = indent_end(pos, pcx);
    a + 1 < line_end(pos, pcx) && get_src()[a as usize] == b'/'
        && get_src()[(a + 1) as usize] == b'/'
}

fn blank_at(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let a = indent_end(pos, pcx);
    a >= line_end(pos, pcx) || get_src()[a as usize] == b'\r'
}

fn is_rule_byte(c: u8) -> bool {
    c == b'-' || c == b'=' || c == b'#' || c == b'*' || c == b'~'
}

// The title of the rule at line pos (its text between the runs), into *a,
// *b; whether the line is a rule: a run of at least two rule bytes after
// the `//`, then a space; a run of two or three needs another after the
// title.
fn rule_title(pos: i64, a: &mut i64, b: &mut i64, pcx: &Ctx<Comp>) -> bool {
    let e = line_end(pos, pcx);
    let mut i = indent_end(pos, pcx) + 2;
    while i < e && get_src()[i as usize] == b'/' {
        i += 1;
    }
    while i < e && get_src()[i as usize] == b' ' {
        i += 1;
    }
    let run = i;
    while i < e && is_rule_byte(get_src()[i as usize]) {
        i += 1;
    }
    let lead = i - run;
    if lead < 2 || (i < e && get_src()[i as usize] != b' ' && get_src()[i as usize] != b'\r') {
        return false;
    }
    while i < e && get_src()[i as usize] == b' ' {
        i += 1;
    }
    let mut j = e;
    while j > i && (get_src()[(j - 1) as usize] == b' ' || get_src()[(j - 1) as usize] == b'\r') {
        j -= 1;
    }
    let tail = j;
    while j > i && is_rule_byte(get_src()[(j - 1) as usize]) {
        j -= 1;
    }
    // (`// -- a note` is not a rule: a short run needs another after
    // the title)
    if lead < 4 && tail - j < 2 && i < j {
        return false;
    }
    while j > i && get_src()[(j - 1) as usize] == b' ' {
        j -= 1;
    }
    *a = i;
    *b = j;
    true
}

// The text of comment line pos after its `//` and spaces, into *a, *b.
fn comment_text(pos: i64, a: &mut i64, b: &mut i64, pcx: &Ctx<Comp>) {
    let e = line_end(pos, pcx);
    let mut i = indent_end(pos, pcx) + 2;
    while i < e && (get_src()[i as usize] == b'/' || get_src()[i as usize] == b' ') {
        i += 1;
    }
    let mut j = e;
    while j > i && (get_src()[(j - 1) as usize] == b' ' || get_src()[(j - 1) as usize] == b'\r') {
        j -= 1;
    }
    *a = i;
    *b = j;
}

// The start of the line after the one at pos (the file's end: none).
fn next_line(pos: i64, end: i64, pcx: &Ctx<Comp>) -> i64 {
    let e = line_end(pos, pcx);
    if e + 1 < end { e + 1 } else { end }
}

// The banners and comments of every file of the program (once).
pub fn find_banners(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.found {
        return;
    }
    tcx.found = true;
    for f in 0..pcx.files.len() as i64 {
        if !file_made(f, pcx)
            && pcx.files[f as usize].kind == SOURCE_VOLE {
            banners_of_file(f, tcx, pcx);
        }
    }
}

// Where the code of file f starts: its first token, or its end (from the
// tools' cache when the program came from it).
pub fn code_start(f: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if tcx.restored {
        return (tcx.c_code_start[f as usize]);
    }
    let end = pcx.files[f as usize].end;
    let t = token_at(pcx.files[f as usize].start, pcx);
    if t < pcx.toks.len() as i64
        && pcx.toks[t as usize].start < end { pcx.toks[t as usize].start } else { end }
}

fn banners_of_file(f: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let end = pcx.files[f as usize].end;
    let code_start = code_start(f, tcx, pcx);
    let first = tcx.b_kind.len() as i64;
    let mut p = pcx.files[f as usize].start;
    while p < end {
        if !comment_at(p, pcx) || enclosing(p, tcx, pcx) >= 0 {
            p = next_line(p, end, pcx);
            continue;
        }
        let start = p;
        let mut last = p;
        while p < end && comment_at(p, pcx) {
            last = p;
            p = next_line(p, end, pcx);
        }
        let detached = p >= end || blank_at(p, pcx);
        let mut a: i64 = 0;
        let mut b: i64 = 0;
        if rule_title(start, &mut a, &mut b, pcx) {
            if a == b && last != start {
                // (a rule alone: the title is the next line's text)
                comment_text(next_line(start, end, pcx), &mut a, &mut b, pcx);
            }
            add_banner(B_SECTION, start, last, a, b, tcx);
        } else if detached && start >= code_start {
            comment_text(start, &mut a, &mut b, pcx);
            add_banner(B_COMMENT, start, last, a, b, tcx);
        }
    }
    // A section runs to the next banner (its blank lines left out).
    for i in first..tcx.b_kind.len() as i64 {
        if (tcx.b_kind[i as usize]) != B_SECTION {
            continue;
        }
        let mut stop = end;
        for j in i + 1..tcx.b_kind.len() as i64 {
            if (tcx.b_kind[j as usize]) == B_SECTION {
                stop = (tcx.sections_b_start[j as usize]);
                break;
            }
        }
        let mut q = (tcx.b_last[i as usize]);
        let mut r = next_line(q, end, pcx);
        while r < stop {
            if !blank_at(r, pcx) {
                q = r;
            }
            r = next_line(r, end, pcx);
        }
        (tcx.b_last[i as usize]) = q;
    }
}

fn add_banner(kind: i64, start: i64, last: i64, a: i64, b: i64, tcx: &mut Tcx<Comp>) {
    tcx.b_kind.push(kind);
    tcx.sections_b_start.push(start);
    tcx.b_last.push(last);
    tcx.b_title_a.push(a);
    tcx.b_title_b.push(b);
}

// The banners of module m (in its files, not in its inline modules), in
// order, into out.
pub fn banners_of_module(m: i64, out: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    find_banners(tcx, pcx);
    for i in 0..tcx.b_kind.len() as i64 {
        if module_at((tcx.sections_b_start[i as usize]), pcx) == m {
            out.push(i);
        }
    }
}

// The title of banner i, cut to TITLE_MAX bytes (with `…`).
const TITLE_MAX: i64 = 72;

pub fn put_title(out: i64, i: i64, tcx: &Tcx<Comp>) {
    let a = (tcx.b_title_a[i as usize]);
    let b = (tcx.b_title_b[i as usize]);
    if b - a <= TITLE_MAX {
        buf_bytes(out, &get_src()[a as usize..b as usize]);
        return;
    }
    let mut e = a + TITLE_MAX - 1;
    while e > a && (get_src()[e as usize] & 192) == 128 {
        e -= 1;
    }
    buf_bytes(out, &get_src()[a as usize..e as usize]);
    buf_byte(out, 226 as u8);
    buf_byte(out, 128 as u8);
    buf_byte(out, 166 as u8);
}

// `A-B<TAB>section|comment<TAB>TITLE`, a line of `items --comments`.
pub fn put_banner_line(out: i64, i: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    buf_int(out, line_of((tcx.sections_b_start[i as usize]), pcx));
    buf_byte(out, b'-');
    buf_int(out, line_of((tcx.b_last[i as usize]), pcx));
    buf_str(out,
        if (tcx.b_kind[i as usize]) == B_SECTION { c"\tsection\t" }
        else { c"\tcomment\t" });
    put_title(out, i, tcx);
    buf_byte(out, b'\n');
}

// ---- show MODULE::section TITLE ----

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 } else { c }
}

// How title of banner i matches want: 3 the same, 2 the same but for
// case, 1 it contains want (but for case), 0 not.
fn title_match(i: i64, want: &[u8], tcx: &Tcx<Comp>) -> i64 {
    let t = &get_src()[
        (tcx.b_title_a[i as usize]) as usize..(tcx.b_title_b[i as usize]) as usize];
    if want.len() == 0 || want.len() > t.len() {
        return 0;
    }
    let mut k: i64 = 0;
    while k + want.len() as i64 <= t.len() as i64 {
        let mut same = true;
        let mut exact = true;
        for j in 0..want.len() as i64 {
            if lower(t[(k + j) as usize]) != lower(want[j as usize]) {
                same = false;
                break;
            }
            if t[(k + j) as usize] != want[j as usize] {
                exact = false;
            }
        }
        if same {
            if want.len() == t.len() {
                return if exact { 3 } else { 2 };
            }
            return 1;
        }
        k += 1;
    }
    0
}

// More matches than this: their titles only.
const SECTION_SHOW_MAX: i64 = 5;

// `query show MODULE::section TITLE` (name is `MODULE::section`): its exit
// status, or -1 when name is not one (MODULE names no module).
pub fn show_section(name: &[u8], title: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let cut: i64 = 9;
    let module = &name[0..(name.len() as i64 - cut) as usize];
    let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
    find_modules(module, false, &mut modules, tcx, pcx);
    if modules.len() as i64 == 0 && root_stem(module, pcx) {
        modules.push(0);
    }
    if modules.len() as i64 == 0 {
        return -1;
    }
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..modules.len() as i64 {
        banners_of_module((modules[i as usize]), &mut all, tcx, pcx);
    }
    if title.len() == 0 {
        let d = diag(c"error", c"query.usage", tcx);
        buf_str(d, c"show MODULE::section needs a TITLE\n");
        try_list((modules[0]), tcx, pcx);
        return 2;
    }
    // The best kind of match, sections before comments.
    let mut best: i64 = 0;
    let mut best_kind: i64 = 3;
    for k in 0..all.len() as i64 {
        let i = (all[k as usize]);
        let m = title_match(i, title, tcx);
        if m > best || (m == best && m > 0 && (tcx.b_kind[i as usize]) < best_kind) {
            best = m;
            best_kind = (tcx.b_kind[i as usize]);
        }
    }
    let mut sel: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..all.len() as i64 {
        let i = (all[k as usize]);
        if best > 0 && title_match(i, title, tcx) == best
            && (tcx.b_kind[i as usize]) == best_kind {
            sel.push(i);
        }
    }
    if sel.len() as i64 == 0 {
        let d = diag(c"error", c"query.no-match", tcx);
        buf_str(d, c"no section '");
        buf_bytes(d, title);
        buf_str(d, c"' in ");
        buf_bytes(d, module);
        buf_byte(d, b'\n');
        try_list((modules[0]), tcx, pcx);
        return 1;
    }
    let out = buf_new();
    if sel.len() as i64 > SECTION_SHOW_MAX {
        for k in 0..sel.len() as i64 {
            put_banner_line(out, (sel[k as usize]), tcx, pcx);
        }
        buf_write_fd(out, STDOUT);
        let d = diag(c"error", c"query.ambiguous", tcx);
        buf_int(d, sel.len() as i64);
        buf_str(d, c" sections match '");
        buf_bytes(d, title);
        buf_str(d, c"'; showing titles only\n");
        return 1;
    }
    for k in 0..sel.len() as i64 {
        put_section(out, (sel[k as usize]), tcx, pcx);
    }
    buf_write_fd(out, STDOUT);
    0
}

// `try: query items MODULE --comments`.
fn try_list(m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let t = try_begin(c"items", mod_fqn_text(m, tcx, pcx), true, tcx, pcx);
    buf_str(t, c" --comments");
    try_end(t);
}

// Banner i's section: `// MODULE::section TITLE<TAB>FILE:A-B`, then its
// lines (at most TEXT_MAX: then a note, and the rest by `query text`).
fn put_section(out: i64, i: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let from = (tcx.sections_b_start[i as usize]);
    let a = line_of(from, pcx);
    let b = line_of((tcx.b_last[i as usize]), pcx);
    let f = crate::front::modules::file_of_pos(from, pcx);
    buf_str(out, c"// ");
    buf_bytes(out, mod_fqn_text(module_at(from, pcx), tcx, pcx));
    buf_str(out,
        if (tcx.b_kind[i as usize]) == B_SECTION { c"::section " }
        else { c"::comment " });
    put_title(out, i, tcx);
    buf_byte(out, b'\t');
    put_path(out, f, pcx);
    buf_byte(out, b':');
    buf_int(out, a);
    buf_byte(out, b'-');
    buf_int(out, b);
    buf_byte(out, b'\n');
    let shown_b = if b - a + 1 > TEXT_MAX { a + TEXT_MAX - 1 } else { b };
    let mut p = from;
    for _ in a..shown_b + 1 {
        let e = line_end(p, pcx);
        buf_bytes(out, &get_src()[p as usize..e as usize]);
        buf_byte(out, b'\n');
        p = e + 1;
    }
    if shown_b == b {
        return;
    }
    let d = diag(c"note", c"query.truncated", tcx);
    buf_str(d, c"the section has ");
    buf_int(d, b - a + 1);
    buf_str(d, c" lines; showing ");
    buf_int(d, TEXT_MAX);
    buf_byte(d, b'\n');
    let w = buf_new();
    put_path(w, f, pcx);
    buf_byte(w, b':');
    buf_int(w, shown_b + 1);
    buf_byte(w, b'-');
    buf_int(w, if b - shown_b > TEXT_MAX { shown_b + TEXT_MAX } else { b });
    try_query(c"text", &buf_copy(w), tcx, pcx);
}
