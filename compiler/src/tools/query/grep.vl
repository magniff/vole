// `query grep PATTERN...` (0.13; docs/query.md): a literal text search
// over the program's files, for what is not a name (a message, a comment,
// part of an identifier). Each hit is printed as a reference is, under
// `# FILE`: `LINE:COL<TAB>code|comment|string<TAB>ENCLOSING<TAB>SOURCE`,
// where ENCLOSING is the item holding it (else its module) and the second
// field says whether the hit is in code, a comment or a string (or
// character) literal, from the lexer's tokens. The files the compiler
// makes (`<std>`, `<C import>`) are searched only when --in names them.
//
//   --code, --comments, --strings   only hits there (any of them)
//   --word                          only hits that are whole identifiers
//   --in FILE|MODULE|FILE:LINE, --count, --limit N, --all: as for refs

use crate::base::{
    SOURCE_WGSL, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, c_bytes,
    get_src,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::{Tok, is_ident_byte};
use crate::front::modules::{file_made, file_of_pos, module_at};
use crate::tools::ctx::{Tcx, zeros};
use crate::tools::query::defs::mod_fqn;
use crate::tools::query::diagnostics::{diag, put_cword, put_word, try_begin, try_end};
use crate::tools::query::positions::{
    enclosing, line_of, line_start, rank_of, sort_by_keys, token_at,
};
use crate::tools::query::refs::{REFS_BUDGET, file_text, put_line, put_short, ref_in};
use crate::tools::query::show::text_start;

// The options of grep: which places (G_CODE | G_COMMENT | G_STRING; 0:
// all), whole identifiers only.
pub const G_CODE: i64 = 1;
pub const G_COMMENT: i64 = 2;
pub const G_STRING: i64 = 4;

// Where the byte at pos is: G_CODE, G_COMMENT or G_STRING (between the
// tokens is a comment, or space).
fn place_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    // (0.26.2: an embedded block's file, SOURCE_WGSL: by WGSL's rules)
    let file = pcx.files[file_of_pos(pos, pcx) as usize];
    if file.kind == SOURCE_WGSL {
        let text = &crate::base::get_src()[file.start as usize..file.end as usize];
        return if crate::front::lexer::embedded::in_embedded_comment(text, pos - file.start) {
            G_COMMENT } else { G_CODE };
    }
    let mut t = token_at(pos, pcx);
    if t >= pcx.toks.len() as i64 || pcx.toks[t as usize].start != pos {
        t -= 1;
    }
    if t < 0 || pcx.toks[t as usize].kind == Tok::Eof || pos >= pcx.toks[t as usize].end
        || file_of_pos(pcx.toks[t as usize].start, pcx) != file_of_pos(pos, pcx) {
        return G_COMMENT;
    }
    let k = pcx.toks[t as usize].kind;
    // (0.26.0: an embedded block's text by its language's rules)
    if k == Tok::Embedded {
        let text = &crate::base::get_src()[
            pcx.toks[t as usize].start as usize..pcx.toks[t as usize].end as usize];
        return if crate::front::lexer::embedded::in_embedded_comment(text,
            pos - pcx.toks[t as usize].start) {
            G_COMMENT } else { G_CODE };
    }
    // (0.21: an f-string's text pieces are its literal too)
    if k == Tok::Str || k == Tok::CStr || k == Tok::Char || k == Tok::FHead || k == Tok::FMid
        || k == Tok::FTail { G_STRING } else { G_CODE }
}

fn place_name(p: i64) -> *mut u8 {
    if p == G_CODE { c"code" } else if p == G_COMMENT { c"comment" } else { c"string" }
}

// (0.17) The item a comment at pos documents: the definition whose
// comment lines (text_start) reach down from pos to it, or -1.
fn documented(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pos, pcx);
    let mut best: i64 = -1;
    for d in 0..pcx.defs.len() as i64 {
        let s = pcx.defs[d as usize].start;
        if s <= pos || s >= pcx.files[f as usize].end
            || (best >= 0 && s >= pcx.defs[best as usize].start) {
            continue;
        }
        if text_start(d, pcx) <= pos {
            best = d;
        }
    }
    best
}

// Whether pattern pat is at pos (and, --word, a whole identifier).
fn hit_at(pos: i64, end: i64, pat: &[u8], start: i64, tcx: &Tcx<Comp>) -> bool {
    if pos + pat.len() as i64 > end {
        return false;
    }
    for j in 0..pat.len() as i64 {
        if get_src()[(pos + j) as usize] != pat[j as usize]
            && !(tcx.opt_nocase && lower(get_src()[(pos + j) as usize]) == lower(pat[j as usize])) {
            return false;
        }
    }
    if tcx.opt_word {
        if pos > start && is_ident_byte(get_src()[(pos - 1) as usize]) {
            return false;
        }
        if pos + pat.len() as i64 < end
            && is_ident_byte(get_src()[(pos + pat.len() as i64) as usize]) {
            return false;
        }
    }
    true
}

// (0.21) The ASCII lower case of c.
pub fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 } else { c }
}

// The hits of the patterns (C strings in pats), in order, each position
// once, into out.
fn find_hits(pats: &[i64], out: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: strlen is C's; a file's path and the patterns are C strings,
    // read through raw pointers.
    // SAFETY: a path has at least its 0 byte; each pattern is a C string of
    // the command line's words, alive for the process; its slice covers the
    // bytes before the 0.
    unsafe {
        let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
        for f in 0..pcx.files.len() as i64 {
            let generated = file_made(f, pcx);
            let m = pcx.files[f as usize].module;
            let asked = pcx.opt_in != 0 as *mut u8
                && ((pcx.in_file.len() as i64 > f && (pcx.in_file[f as usize]) != 0)
                    || (m >= 0 && pcx.in_module.len() as i64 > m
                        && (pcx.in_module[m as usize]) != 0));
            if generated && !asked {
                continue;
            }
            let start = pcx.files[f as usize].start;
            let end = pcx.files[f as usize].end;
            for k in 0..pats.len() as i64 {
                let p = (pats[k as usize]) as *mut u8;
                let pat = c_bytes(p);
                if pat.len() == 0 {
                    continue;
                }
                let first = pat[0];
                let mut pos = start;
                while pos + pat.len() as i64 <= end {
                    if (get_src()[pos as usize] == first
                        || (tcx.opt_nocase && lower(get_src()[pos as usize]) == lower(first)))
                        && hit_at(pos, end, pat, start, tcx) && ref_in(pos, pcx)
                        && (tcx.opt_where == 0 || (tcx.opt_where & place_of(pos, pcx)) != 0) {
                        all.push(pos);
                    }
                    pos += 1;
                }
            }
        }
        let n = all.len() as i64;
        let mut k1 = zeros(n + 1);
        let mut k2 = zeros(n + 1);
        let mut idx: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..n {
            idx.push(i);
            (k1[i as usize]) = rank_of((all[i as usize]), tcx, pcx);
            (k2[i as usize]) = (all[i as usize]);
        }
        sort_by_keys(&mut idx, &k1, &k2);
        for i in 0..n {
            let pos = (all[(idx[i as usize]) as usize]);
            if out.len() as i64 == 0 || (out[(out.len() as i64 - 1) as usize]) != pos {
                out.push(pos);
            }
        }
    }
}

// A `try:` line: the same grep with one more option (and its value).
fn try_grep(pats: &[i64], option: *mut u8, value: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = try_begin(c"grep", &value[0..0], false, tcx, pcx);
    for k in 0..pats.len() as i64 {
        put_cword(out, (pats[k as usize]) as *mut u8);
    }
    if pcx.opt_in != 0 as *mut u8 && !crate::base::streq(option, c"--in") {
        buf_str(out, c" --in");
        put_cword(out, pcx.opt_in);
    }
    if (tcx.opt_where & G_CODE) != 0 {
        buf_str(out, c" --code");
    }
    if (tcx.opt_where & G_COMMENT) != 0 {
        buf_str(out, c" --comments");
    }
    if (tcx.opt_where & G_STRING) != 0 {
        buf_str(out, c" --strings");
    }
    if tcx.opt_word {
        buf_str(out, c" --word");
    }
    if tcx.opt_nocase {
        buf_str(out, c" --ignore-case");
    }
    buf_byte(out, b' ');
    buf_str(out, option);
    if value.len() > 0 {
        put_word(out, value);
    }
    try_end(out);
}

// `query grep PATTERN...`: the exit status (0, also for no hit).
pub fn query_grep(pats: &[i64], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut hits: Vec<i64, Comp> = Vec::new_in(Comp {});
    find_hits(pats, &mut hits, tcx, pcx);
    let out = buf_new();
    let total = hits.len() as i64;
    if tcx.opt_count {
        buf_int(out, total);
        buf_byte(out, b'\n');
        buf_write_fd(out, STDOUT);
        return 0;
    }
    if total == 0 {
        let d = diag(c"note", c"query.empty", tcx);
        buf_str(d, c"0 hits");
        if pcx.opt_in != 0 as *mut u8 {
            buf_str(d, c" in ");
            buf_str(d, pcx.opt_in);
        }
        buf_byte(d, b'\n');
        return 0;
    }
    // Per file: the number of hits.
    let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut per_file: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut biggest: i64 = -1;
    let mut biggest_n: i64 = 0;
    for i in 0..total {
        let f = file_of_pos((hits[i as usize]), pcx);
        if files.len() as i64 == 0 || (files[(files.len() as i64 - 1) as usize]) != f {
            files.push(f);
            per_file.push(0);
        }
        let last_file = per_file.len() - 1;
        per_file[last_file] += 1;
        if (per_file[(per_file.len() as i64 - 1) as usize]) > biggest_n {
            biggest_n = (per_file[(per_file.len() as i64 - 1) as usize]);
            biggest = f;
        }
    }
    if tcx.opt_limit < 0 && !tcx.opt_all && total > REFS_BUDGET {
        for i in 0..files.len() as i64 {
            buf_bytes(out, file_text((files[i as usize]), pcx));
            buf_byte(out, b'\t');
            buf_int(out, (per_file[i as usize]));
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        let d = diag(c"note", c"query.truncated", tcx);
        buf_int(d, total);
        buf_str(d, c" hits in ");
        buf_int(d, files.len() as i64);
        buf_str(d, if files.len() as i64 == 1 { c" file\n" } else { c" files\n" });
        if files.len() as i64 > 1 {
            try_grep(pats, c"--in", file_text(biggest, pcx), tcx, pcx);
        }
        try_grep(pats, c"--limit 60", &file_text(biggest, pcx)[0..0], tcx, pcx);
        try_grep(pats, c"--all", &file_text(biggest, pcx)[0..0], tcx, pcx);
        return 0;
    }
    let shown = if tcx.opt_limit >= 0 && tcx.opt_limit < total { tcx.opt_limit } else { total };
    let mut cur: i64 = -1;
    for i in 0..shown {
        let pos = (hits[i as usize]);
        let f = file_of_pos(pos, pcx);
        if f != cur {
            buf_str(out, c"# ");
            buf_bytes(out, file_text(f, pcx));
            buf_byte(out, b'\n');
            cur = f;
        }
        buf_int(out, line_of(pos, pcx));
        buf_byte(out, b':');
        buf_int(out, pos - line_start(pos, pcx) + 1);
        buf_byte(out, b'\t');
        buf_str(out, place_name(place_of(pos, pcx)));
        buf_byte(out, b'\t');
        let mut e = enclosing(pos, tcx, pcx);
        if place_of(pos, pcx) == G_COMMENT {
            // (a doc comment: the item below it, 0.17)
            let doc = documented(pos, pcx);
            if doc >= 0
                && (e < 0 || pcx.defs[e as usize].start < pcx.defs[doc as usize].start) {
                e = doc;
            }
        }
        put_short(out,
            if e >= 0 { pcx.defs[e as usize].fqn }
            else { mod_fqn(module_at(pos, pcx), tcx, pcx) },
            pcx);
        buf_byte(out, b'\t');
        put_line(out, pos, pcx);
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
    if shown < total {
        let d = diag(c"note", c"query.truncated", tcx);
        buf_str(d, c"showing ");
        buf_int(d, shown);
        buf_str(d, c" of ");
        buf_int(d, total);
        buf_str(d, c" hits\n");
        if files.len() as i64 > 1 {
            try_grep(pats, c"--in", file_text(biggest, pcx), tcx, pcx);
        }
        try_grep(pats, c"--all", &file_text(biggest, pcx)[0..0], tcx, pcx);
    }
    0
}
