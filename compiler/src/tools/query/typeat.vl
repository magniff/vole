// `query type FILE:LINE[:COL]...` (0.13; docs/query.md): the type the
// checker gave the innermost expression holding that position (without
// COL: the line's first non-blank byte), `TYPE<TAB>EXPRESSION`; one line
// per type when the expression is in a generic function checked once per
// instance.

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NODE_CAPTURE, NODE_IMPLICIT, NodeKind, child};
use crate::front::types::buf_type;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{parse_digits, trailing_number};
use crate::tools::query::diagnostics::{diag, try_begin, try_end, try_query};
use crate::tools::query::names::path_matches;
use crate::tools::query::positions::{collapse, line_end, line_index};
use crate::tools::query::refs::file_text;

// Whether nodes of kind k are expressions (or bindings) the checker types
// (0.14: a closure, its type `closure(i64) -> i64 at FILE:LINE:COL`; a
// closure's parameter).
fn typed_kind(k: NodeKind) -> bool {
    match k {
        NodeKind::Int | NodeKind::Float | NodeKind::Char | NodeKind::Str | NodeKind::CStr
            | NodeKind::Bool | NodeKind::Unit | NodeKind::Ident | NodeKind::Binary | NodeKind::Unary
            | NodeKind::Cast | NodeKind::Call | NodeKind::Index | NodeKind::FieldAccess
            | NodeKind::TupleField | NodeKind::Tuple | NodeKind::Array | NodeKind::Repeat
            | NodeKind::StructLit | NodeKind::Block | NodeKind::If | NodeKind::Loop
            | NodeKind::While | NodeKind::For | NodeKind::Range | NodeKind::Assign
            | NodeKind::Return | NodeKind::Break | NodeKind::Continue | NodeKind::Path
            | NodeKind::Match | NodeKind::MethodCall | NodeKind::VariantLit | NodeKind::EnumPanic
            | NodeKind::VecOp | NodeKind::PatBind | NodeKind::Closure | NodeKind::Param
            | NodeKind::Try | NodeKind::Interp => true,
        _ => false,
    }
}

// The file of the program named `file` (its path, or its end by whole
// components), or -1.
pub fn file_named(file: &[u8], pcx: &Ctx<Comp>) -> i64 {
    for g in 0..pcx.files.len() as i64 {
        let p = file_text(g, pcx);
        if path_matches(p, file) {
            return g;
        }
    }
    -1
}

// Expression text longer than this is cut (with `…`).
const EXPR_MAX: i64 = 100;

// (0.15) Whether typed node n is one the compiler made, which the source
// does not show: a hidden local (`__f0`, `__out`, `__t`) or what takes it
// as its operand (`&__f0`, `__out.str(..)`, also once rewritten as a
// call), a node with a hole's span and another type than its expression
// (`&__f0` of a captured `__f0`), and inside an f-string or a `?` (the
// pairs `fstrings`) anything outside its holes' expressions or its
// operand (the pairs `holes`) but the f-string or `?` itself.
fn made_by_compiler(n: i64, fstrings: IntVec, holes: IntVec, exprs: IntVec, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if hidden_name(n, pcx) {
            return true;
        }
        let k = pcx.nodes[n as usize].kind;
        if (k == NodeKind::Unary && hidden_name(pcx.nodes[n as usize].b, pcx))
            || ((k == NodeKind::MethodCall || k == NodeKind::FieldAccess)
                && hidden_name(pcx.nodes[n as usize].a, pcx)) {
            return true;
        }
        if (k == NodeKind::Call || k == NodeKind::MethodCall) && pcx.nodes[n as usize].count > 0 {
            let r = child(n, 0, pcx);
            if hidden_name(r, pcx)
                || (pcx.nodes[r as usize].kind == NodeKind::Unary
                    && hidden_name(pcx.nodes[r as usize].b, pcx)) {
                return true;
            }
        }
        if k == NodeKind::Interp || k == NodeKind::Try {
            return false;
        }
        let s = pcx.nodes[n as usize].start;
        let e = pcx.nodes[n as usize].end;
        for i in 0..exprs.count {
            let x = (*exprs.data.add(i as usize));
            if x != n && pcx.nodes[x as usize].start == s && pcx.nodes[x as usize].end == e
                && pcx.nodes[x as usize].ty != pcx.nodes[n as usize].ty {
                return true;
            }
        }
        let mut i: i64 = 0;
        while i + 1 < fstrings.count {
            if s >= (*fstrings.data.add(i as usize))
                && e <= (*fstrings.data.add((i + 1) as usize)) {
                let mut j: i64 = 0;
                while j + 1 < holes.count {
                    if s >= (*holes.data.add(j as usize))
                        && e <= (*holes.data.add((j + 1) as usize)) {
                        return false;
                    }
                    j += 2;
                }
                return true;
            }
            i += 2;
        }
        false
    }
}

// Whether node n is an identifier, binding or parameter whose name the
// compiler made (`__` and more).
fn hidden_name(n: i64, pcx: &Ctx<Comp>) -> bool {
    if n <= 0 {
        return false;
    }
    let k = pcx.nodes[n as usize].kind;
    if k != NodeKind::Ident && k != NodeKind::PatBind && k != NodeKind::Param {
        return false;
    }
    let a = pcx.nodes[n as usize].a;
    if a <= 0 {
        return false;
    }
    let name = sym_text(a, pcx);
    name.len() > 2 && name[0] == b'_' && name[1] == b'_'
}

// (0.17) The type of f-string n written straight into std's printing
// (front/check/interp.vl, direct_call), which makes no value: the one it
// has elsewhere, `Interp<closure(*Fmt) -> () at FILE:LINE:COL>`.
fn put_direct_fstring(out: i64, n: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let pos = pcx.nodes[n as usize].start;
        let mut file: i64 = 0;
        while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[(file + 1) as usize].start {
            file += 1;
        }
        let first = line_index(pcx.files[file as usize].start, pcx);
        let mut i = first;
        while i + 1 < pcx.lines.count && (*pcx.lines.data.add((i + 1) as usize)) <= pos {
            i += 1;
        }
        buf_str(out, c"Interp<closure(*Fmt) -> () at ");
        buf_str(out, pcx.files[file as usize].path);
        buf_byte(out, b':');
        crate::base::buf_int(out, i - first + 1);
        buf_byte(out, b':');
        crate::base::buf_int(out, pos - (*pcx.lines.data.add(i as usize)) + 1);
        buf_byte(out, b'>');
    }
}

pub fn query_type(arg: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        // FILE:LINE[:COL]
        let mut line: i64 = -1;
        let mut col: i64 = -1;
        let mut file = &arg[0..0];
        let a = trailing_number(arg);
        if a > 0 && arg[(a - 1) as usize] == b':' {
            line = parse_digits(&arg[a as usize..]);
            file = &arg[0..(a - 1) as usize];
            let b = trailing_number(file);
            if b > 0 && file[(b - 1) as usize] == b':' {
                col = line;
                line = parse_digits(&file[b as usize..]);
                file = &file[0..(b - 1) as usize];
            }
        }
        if line < 1 {
            let d = diag(c"error", c"query.usage", tcx);
            buf_str(d, c"type needs a position, FILE:LINE:COL (not '");
            buf_bytes(d, arg);
            buf_str(d, c"')\n");
            return 2;
        }
        let f = file_named(file, pcx);
        if f < 0 {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", &arg[0..0], false, tcx, pcx));
            return 1;
        }
        let idx = line_index(pcx.files[f as usize].start, pcx) + line - 1;
        if idx >= pcx.lines.count
            || (*pcx.lines.data.add(idx as usize)) >= pcx.files[f as usize].end {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_bytes(d, file_text(f, pcx));
            buf_str(d, c" has no line ");
            buf_int(d, line);
            buf_byte(d, b'\n');
            return 1;
        }
        let ls = (*pcx.lines.data.add(idx as usize));
        let le = line_end(ls, pcx);
        let mut pos = ls;
        if col >= 1 {
            pos = ls + col - 1;
        } else {
            while pos < le
                && (get_src()[pos as usize] == b' ' || get_src()[pos as usize] == b'\t') {
                pos += 1;
            }
        }
        if pos > le {
            pos = le;
        }
        // The innermost typed nodes holding pos (copies of one in each
        // instance of a generic function); without COL, the outermost
        // that starts on the line.
        let (found, mut widened) = typed_nodes_at(col, pos, le, pcx);
        if found.count == 0 {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_str(d, c"no checked expression at ");
            buf_bytes(d, arg);
            buf_byte(d, b'\n');
            let w = buf_new();
            buf_bytes(w, file_text(f, pcx));
            buf_byte(w, b':');
            crate::base::buf_int(w, line);
            try_query(c"show", buf_slice(w), tcx, pcx);
            return 1;
        }
        let out = buf_new();
        let mut types = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..found.count {
            let n = (*found.data.add(i as usize));
            let t = pcx.nodes[n as usize].ty;
            let mut seen = false;
            for j in 0..types.count {
                if (*types.data.add(j as usize)) == t {
                    seen = true;
                }
            }
            if seen {
                continue;
            }
            types.push(t);
            if pcx.nodes[n as usize].kind == NodeKind::Interp && pcx.nodes[n as usize].y < 0 {
                put_direct_fstring(out, n, pcx);
            } else {
                buf_type(out, t, pcx);
            }
            let to = widened.get(n + 1);
            if to > 0 {
                // (0.15)
                buf_str(out, c" (widened to ");
                buf_type(out, to, pcx);
                buf_byte(out, b')');
            }
            buf_byte(out, b'\t');
            let text = buf_new();
            collapse(text, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end);
            let s = buf_slice(text);
            if s.len() as i64 <= EXPR_MAX {
                buf_bytes(out, s);
            } else {
                let mut e = EXPR_MAX - 1;
                while e > 0 && (s[e as usize] & 192) == 128 {
                    e -= 1;
                }
                buf_bytes(out, &s[0..e as usize]);
                buf_byte(out, 226 as u8);
                buf_byte(out, 128 as u8);
                buf_byte(out, 166 as u8);
            }
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        0
    }
}

// (0.24) The innermost typed nodes holding pos (col >= 1), else the
// outermost starting on the line (pos..le), and the widened values: what
// `query type` prints and the language server's hover shows.
pub fn typed_nodes_at(col: i64, pos: i64, le: i64, pcx: &Ctx<Comp>) -> (IntVec, HMap) {
    let ix = typed_index(pcx);
    (typed_nodes_in(ix, col, pos, le, pcx), ix.widened)
}

// (0.24) What the search for typed nodes leaves out or shows otherwise,
// whatever the position (the language server makes it once).
#[derive(Clone, Copy)] pub struct TypedIndex {
    // (0.14: the closure's environment that a captured use reads, written
    // nowhere: not shown)
    pub hidden: HMap,
    // (0.14: what a closure is lowered to, its environment's literal or its
    // function, has the closure's span: not shown)
    pub spans: HMap,
    // (0.15: an f-string's spans, and its holes' expressions; the widened
    // values, the copies an implicit cast holds, by type)
    pub fstrings: IntVec,
    pub holes: IntVec,
    pub exprs: IntVec,
    pub widened: HMap,
}

pub fn typed_index(pcx: &Ctx<Comp>) -> TypedIndex {
    let mut ix = TypedIndex {
        hidden: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        spans: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        fstrings: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        holes: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        exprs: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        widened: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
    };
    for n in 1..pcx.nodes.len() as i64 {
        if (pcx.nodes[n as usize].p & NODE_CAPTURE) == 0 {
            continue;
        }
        let mut q = n;
        while q > 0
            && (pcx.nodes[q as usize].kind == NodeKind::Unary
                || pcx.nodes[q as usize].kind == NodeKind::FieldAccess) {
            if q != n {
                ix.hidden.put(q + 1, 1);
            }
            q = if pcx.nodes[q as usize].kind == NodeKind::Unary { pcx.nodes[q as usize].b }
                else { pcx.nodes[q as usize].a };
        }
        if q > 0 && q != n {
            ix.hidden.put(q + 1, 1);
        }
    }
    for n in 1..pcx.nodes.len() {
        let k = pcx.nodes[n].kind;
        if k == NodeKind::Closure {
            ix.spans.put(pcx.nodes[n].start + 1, pcx.nodes[n].end + 1);
        } else if k == NodeKind::Interp {
            ix.fstrings.push(pcx.nodes[n].start);
            ix.fstrings.push(pcx.nodes[n].end);
        } else if k == NodeKind::InterpHole && pcx.nodes[n].a > 0 {
            ix.holes.push(pcx.nodes[pcx.nodes[n].a as usize].start);
            ix.holes.push(pcx.nodes[pcx.nodes[n].a as usize].end);
            ix.exprs.push(pcx.nodes[n].a);
            // (0.26.2: a format literal's `name$` width and precision)
            for w in [pcx.nodes[n].g, pcx.nodes[n].h] {
                if w > 0 {
                    ix.holes.push(pcx.nodes[w as usize].start);
                    ix.holes.push(pcx.nodes[w as usize].end);
                }
            }
        } else if k == NodeKind::Try && pcx.nodes[n].a > 0 {
            // (a `?`: what it is checked as, but its operand)
            ix.fstrings.push(pcx.nodes[n].start);
            ix.fstrings.push(pcx.nodes[n].end);
            ix.holes.push(pcx.nodes[pcx.nodes[n].a as usize].start);
            ix.holes.push(pcx.nodes[pcx.nodes[n].a as usize].end);
        }
        else if k == NodeKind::Cast && (pcx.nodes[n].p & NODE_IMPLICIT) != 0 && pcx.nodes[n].a > 0 {
            ix.widened.put(pcx.nodes[n].a + 1, pcx.nodes[n].ty);
        }
    }
    ix
}

// The search of typed_nodes_at, with the index made.
pub fn typed_nodes_in(ix: TypedIndex, col: i64, pos: i64, le: i64, pcx: &Ctx<Comp>) -> IntVec {
    let mut best: i64 = 0;
    let mut have = false;
    let mut found = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        // (the position first: the rest looks up tables)
        if col >= 1 && (pcx.nodes[n as usize].start > pos || pcx.nodes[n as usize].end <= pos) {
            continue;
        }
        if col < 1 && (pcx.nodes[n as usize].start < pos || pcx.nodes[n as usize].start >= le) {
            continue;
        }
        if pcx.nodes[n as usize].ty <= 0 || !typed_kind(pcx.nodes[n as usize].kind)
            || ix.hidden.get(n + 1) != 0 {
            continue;
        }
        if pcx.nodes[n as usize].kind != NodeKind::Closure
            && pcx.nodes[n as usize].kind != NodeKind::Interp
            && ix.spans.get(pcx.nodes[n as usize].start + 1) == pcx.nodes[n as usize].end + 1 {
            continue;
        }
        // (0.15: an implicit cast is shown as the value it widens; what
        // the compiler writes for an f-string or a `?` is not shown)
        if (pcx.nodes[n as usize].kind == NodeKind::Cast
            && (pcx.nodes[n as usize].p & NODE_IMPLICIT) != 0)
            || made_by_compiler(n, ix.fstrings, ix.holes, ix.exprs, pcx) {
            continue;
        }
        let size = if col >= 1 { pcx.nodes[n as usize].end - pcx.nodes[n as usize].start }
            else { pcx.nodes[n as usize].start - pcx.nodes[n as usize].end };
        if !have || size < best {
            have = true;
            best = size;
            found.count = 0;
        }
        if size == best {
            found.push(n);
        }
    }
    found
}
