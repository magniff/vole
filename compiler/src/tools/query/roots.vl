// Which program a command means (0.25.2; docs/query.md "ROOT"). Every
// command that reads a program (query, edit, refactor, fix, probe, test,
// check) finds its root here:
//
//   - a ROOT given (`--root R`, a last argument ending in .vl) that is a
//     directory stands for its main.vl, and a file that is a module of a
//     program (a `mod NAME;` of a main.vl above it says so) for that
//     program's main.vl;
//   - with no ROOT, a FILE or FILE:LINE argument of a program other than
//     the default one (VOLE_ROOT, ./main.vl, ./compiler/src/main.vl) names
//     that program (its main.vl, or the file itself when it is a program
//     of its own), and the `try:` lines then say `--root` (ROOT_INFERRED);
//   - a NAME no definition of the default program answers to is looked
//     for in the other programs under the current directory (`git grep`
//     for its definition): `try:` lines with `--root`, and for a question
//     of `query` that one program answers, the answer from there
//     (run_query runs the command again, other_root).
//
// The command line is the one run_command was given (note_command), so a
// command's own option parsing needs no change.

use crate::base::{
    STDERR, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Line, c_word_at, c_words};
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{absolute_path, buf_cstr, exec_words, read_file_if, run_capture};
use crate::tools::query::{c_slice, find_root};
use crate::tools::query::defs::last_segment;
use crate::tools::query::diagnostics::{diag, diags, put_cword, put_word, try_end};
use crate::tools::query::names::is_name_char;

// UNSAFE: C's getenv, realpath and execvp: a root is found from the
// environment and compared by its real path; a command is run again
// with another root.
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
    fn realpath(path: *mut u8, resolved: *mut u8) -> *mut u8;
    fn execvp(file: *mut u8, args: *mut *mut u8) -> i32;
}

pub fn note_command(line: Line<'_>, tcx: &mut Tcx<Comp>) {
    tcx.roots_cmd = c_words(line);
}

// The words of the command being run (C strings, a copy), to run it
// again.
pub fn command_words(tcx: &Tcx<Comp>) -> Vec<i64, Comp> {
    let mut out: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..tcx.roots_cmd.len() as i64 {
        out.push(tcx.roots_cmd[k as usize]);
    }
    out
}

// Word k of the command line ("" past its end).
fn word(k: i64, tcx: &Tcx<Comp>) -> *mut u8 {
    if k < 0 || k >= tcx.roots_cmd.len() as i64 {
        return c"";
    }
    c_word_at(tcx.roots_cmd.as_slice(), k)
}

fn cstr_of(s: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_bytes(b, s);
    buf_cstr(b)
}

// The directory part of p, with its `/` ("" for none).
fn dir_of(p: &[u8]) -> &[u8] {
    let mut i = p.len() as i64;
    while i > 0 && p[(i - 1) as usize] != b'/' {
        i -= 1;
    }
    &p[0..i as usize]
}

// The name of p's last part, less `.vl`.
fn stem_of(p: &[u8]) -> &[u8] {
    let d = dir_of(p).len() as i64;
    let mut e = p.len() as i64;
    if e - d > 3 && p[(e - 3) as usize..e as usize] == b".vl" {
        e -= 3;
    }
    &p[d as usize..e as usize]
}

// Whether the text of file `path` declares module `name` (`mod name;`,
// `pub mod name;`, as written, not in a comment's text).
fn declares(path: &[u8], name: &[u8]) -> bool {
    let b = buf_new();
    if !read_file_if(cstr_of(path), b) {
        return false;
    }
    let t = buf_slice(b);
    let mut i: i64 = 0;
    while i + 4 + name.len() as i64 <= t.len() as i64 {
        if &t[i as usize..(i + 4) as usize] == b"mod "
            && (i == 0 || t[(i - 1) as usize] == b' ' || t[(i - 1) as usize] == b'\n') {
            let mut j = i + 4;
            while j < t.len() as i64 && t[j as usize] == b' ' {
                j += 1;
            }
            if j + name.len() as i64 <= t.len() as i64
                && t[j as usize..(j + name.len() as i64) as usize] == name {
                let mut k = j + name.len() as i64;
                while k < t.len() as i64 && t[k as usize] == b' ' {
                    k += 1;
                }
                if k < t.len() as i64 && (t[k as usize] == b';' || t[k as usize] == b'{') {
                    return true;
                }
            }
        }
        i += 1;
    }
    false
}

// The main.vl of the program file `file` is a module of (walking up the
// `mod` declarations: `a/b.vl` is declared by `a.vl`, `a/mod.vl` or
// `a/main.vl`); `file` itself when it is a main.vl; 0 when no main.vl
// declares it.
pub fn program_of(file: &[u8], pcx: &Ctx<Comp>) -> *mut u8 {
    let mut cur = cstr_of(file);
    for _ in 0..12 {
        let p = c_slice(cur);
        let stem = stem_of(p);
        if stem == b"main" {
            return cur;
        }
        // (the module's name, and the directory its parent is in)
        let mut name = stem;
        let mut dir = dir_of(p);
        if stem == b"mod" {
            if dir.len() < 2 {
                return 0 as *mut u8;
            }
            let up = &dir[0..(dir.len() as i64 - 1) as usize];
            name = stem_of(up);
            dir = dir_of(up);
        }
        let parent = buf_new();
        let mut found = false;
        for c in 0..3 {
            buf_clear(parent);
            if c == 2 {
                // (`a.vl` for the files of `a/`)
                if dir.len() < 2 {
                    break;
                }
                buf_bytes(parent, &dir[0..(dir.len() as i64 - 1) as usize]);
                buf_str(parent, c".vl");
            } else {
                buf_bytes(parent, dir);
                buf_str(parent, if c == 0 { c"main.vl" } else { c"mod.vl" });
            }
            let pp = buf_slice(parent);
            if file_exists(buf_cstr(parent), pcx) && declares(pp, name) {
                found = true;
                break;
            }
        }
        if !found {
            return 0 as *mut u8;
        }
        cur = cstr_of(buf_slice(parent));
    }
    0 as *mut u8
}

// Whether file p is a module of a program (not its root): `items FILE`
// lists that module.
pub fn is_module_file(p: *mut u8, pcx: &Ctx<Comp>) -> bool {
    let r = program_of(c_slice(p), pcx);
    r != 0 as *mut u8 && stem_of(c_slice(p)) != b"main"
}

// The file of argument a: `FILE`, `FILE:LINE`, `FILE:LINE:COL`,
// `FILE:A-B`, `FILE::item`, when it is a source file that exists ("" otherwise).
fn file_of_arg<'a>(a: &'a [u8], pcx: &Ctx<Comp>) -> &'a [u8] {
    let mut end = a.len() as i64;
    // (0.25.2.2: `FILE.vl::item`, the item in that file)
    let fp = file_part(a);
    if fp.len() > 0 {
        end = fp.len() as i64;
    }
    for _ in 0..2 {
        let mut k = end;
        while k > 0
            && ((a[(k - 1) as usize] >= b'0' && a[(k - 1) as usize] <= b'9')
                || a[(k - 1) as usize] == b'-') {
            k -= 1;
        }
        if k > 0 && k < end && a[(k - 1) as usize] == b':' {
            end = k - 1;
        }
    }
    let f = &a[0..end as usize];
    // (0.29: or a shader's file, which names the program that embeds it)
    if f.len() < 4 || (&f[(f.len() as i64 - 3) as usize..] != b".vl" && !is_wgsl(f))
        || !file_exists(cstr_of(f), pcx) {
        return &a[0..0];
    }
    f
}

// Whether paths a and b name the same file.
fn same_file(a: *mut u8, b: *mut u8) -> bool {
    c_slice(absolute_path(a)) == c_slice(absolute_path(b))
}

// Whether std's files hold path p (std is a program's always: stdedit).
fn in_std(p: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + 13 <= p.len() as i64 {
        if &p[i as usize..(i + 13) as usize] == b"compiler/std/" {
            return true;
        }
        i += 1;
    }
    false
}

// (0.29) Whether path p names a shader's file, `x.wgsl`.
fn is_wgsl(p: &[u8]) -> bool {
    p.len() > 5 && &p[p.len() - 5..] == b".wgsl"
}

// (0.29) The nearest main.vl above file p (in its directory, then the
// ones above, to the current directory), or 0: the program a file that
// is no module belongs to (a shader a block embeds, `embed wgsl K from
// "x.wgsl"`).
fn main_above(p: &[u8], pcx: &Ctx<Comp>) -> *mut u8 {
    let mut end = p.len() as i64;
    loop {
        while end > 0 && p[(end - 1) as usize] != b'/' {
            end -= 1;
        }
        let m = buf_new();
        buf_bytes(m, &p[0..end as usize]);
        buf_str(m, c"main.vl");
        if file_exists(buf_cstr(m), pcx) {
            return buf_cstr(m);
        }
        if end == 0 {
            return 0 as *mut u8;
        }
        end -= 1;
    }
}

// A ROOT as given, as a program's root file: DIR is DIR/main.vl, a module
// file its program's main.vl.
pub fn root_named(given: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    let g = c_slice(given);
    if g.len() < 3 || &g[(g.len() as i64 - 3) as usize..] != b".vl" {
        let m = buf_new();
        buf_bytes(m, g);
        if g.len() > 0 && g[(g.len() as i64 - 1) as usize] != b'/' {
            buf_byte(m, b'/');
        }
        buf_str(m, c"main.vl");
        if file_exists(buf_cstr(m), pcx) {
            return buf_cstr(m);
        }
        return given;
    }
    if !file_exists(given, pcx) {
        return given;
    }
    let r = program_of(g, pcx);
    if r == 0 as *mut u8 { given } else { r }
}

// With no ROOT given: the program a FILE argument of the command line
// names, when it is not the default program (ROOT_GIVEN is set to it, for
// the `try:` lines); 0 otherwise.
pub fn root_of_args(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    for k in 2..tcx.roots_cmd.len() as i64 {
        let a = c_slice(word(k, tcx));
        if a == b"--" {
            break;
        }
        if a.len() == 0 || a[0] == b'-' {
            continue;
        }
        let f = file_of_arg(a, pcx);
        if f.len() == 0 && c_slice(word(k - 1, tcx)) == b"--in" && program_dir(a, pcx) {
            // (0.25.2.1: `--in DIR`, a program's directory: its main.vl)
            let m = buf_new();
            buf_bytes(m, a);
            if a[(a.len() as i64 - 1) as usize] != b'/' {
                buf_byte(m, b'/');
            }
            buf_str(m, c"main.vl");
            let r = buf_cstr(m);
            let default = find_root(0 as *mut u8, pcx);
            if default != 0 as *mut u8 && same_file(r, default) {
                return 0 as *mut u8;
            }
            tcx.root_given = r;
            tcx.root_inferred = true;
            return r;
        }
        if f.len() == 0 || in_std(f) {
            continue;
        }
        let mut r = if is_wgsl(f) { main_above(f, pcx) } else { program_of(f, pcx) };
        if r == 0 as *mut u8 {
            if is_wgsl(f) {
                continue;
            }
            // (a program of its own)
            r = cstr_of(f);
        }
        let default = find_root(0 as *mut u8, pcx);
        if default != 0 as *mut u8 && same_file(r, default) {
            return 0 as *mut u8;
        }
        tcx.root_given = r;
        tcx.root_inferred = true;
        return r;
    }
    0 as *mut u8
}

// (0.25.2.1) Whether a is a directory with a main.vl (a program's).
fn program_dir(a: &[u8], pcx: &Ctx<Comp>) -> bool {
    if a.len() == 0 || !crate::tools::fmt::is_dir(cstr_of(a)) {
        return false;
    }
    let m = buf_new();
    buf_bytes(m, a);
    buf_str(m, c"/main.vl");
    file_exists(buf_cstr(m), pcx)
}

// (0.25.2.1) The directory of programs a command names, or 0: its ROOT, a
// directory with no main.vl (`--root examples/gpu`), or with no ROOT an
// `--in` of one; the 0.25.2 eval's `query grep atomic --root examples/gpu`
// read nothing and found 0 hits.
pub fn programs_dir(root: *mut u8, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    if root != 0 as *mut u8 {
        let r = c_slice(root);
        if crate::tools::fmt::is_dir(root) && !program_dir(r, pcx) {
            return root;
        }
        return 0 as *mut u8;
    }
    for k in 2..tcx.roots_cmd.len() as i64 {
        let a = c_slice(word(k, tcx));
        if (a == b"--in" && k + 1 < tcx.roots_cmd.len() as i64)
            || (a.len() > 5 && a[0..5] == b"--in=") {
            let v = if a == b"--in" { c_slice(word(k + 1, tcx)) } else { &a[5..a.len()] };
            if v.len() > 0 && crate::tools::fmt::is_dir(cstr_of(v)) && !program_dir(v, pcx) {
                let l = programs_under(v);
                if l.len() > 0 {
                    return cstr_of(v);
                }
            }
        }
    }
    0 as *mut u8
}

// The main.vl files under directory dir (not in target/ or .git/), a
// buffer's text of lines, sorted; at most 40.
fn programs_under(dir: &[u8]) -> &[u8] {
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    words.push(c"sh" as i64);
    words.push(c"-c" as i64);
    words.push(c"find \"$0\" -name main.vl -not -path '*/target/*' -not -path '*/.git/*' 2>/dev/null | LC_ALL=C sort | head -40" as i64);
    words.push(cstr_of(dir) as i64);
    let listing = buf_new();
    if run_capture(exec_words(words.as_slice()).as_slice(), listing) != 0 {
        return &buf_slice(listing)[0..0];
    }
    buf_slice(listing)
}

// A command on a directory of programs (programs_dir): `grep` asks each
// program under it in turn (its output, then a note naming them), any
// other command says which they are, a `try:` line each. The exit status.
pub fn over_programs(dir: *mut u8, grep: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let list = programs_under(c_slice(dir));
    if list.len() == 0 {
        let d = diag(c"error", c"query.bad-root", tcx);
        buf_str(d, c"'");
        buf_str(d, dir);
        buf_str(d, c"' is a directory with no main.vl, and no program under it\n");
        return 2;
    }
    if !grep {
        let d = diag(c"error", c"query.bad-root", tcx);
        buf_str(d, c"'");
        buf_str(d, dir);
        buf_str(d, c"' is a directory of programs, not one: name one of them\n");
        let mut shown: i64 = 0;
        let mut i: i64 = 0;
        while i < list.len() as i64 && shown < 5 {
            let mut e = i;
            while e < list.len() as i64 && list[e as usize] != b'\n' {
                e += 1;
            }
            try_with_root(&list[i as usize..e as usize], tcx, pcx);
            shown += 1;
            i = e + 1;
        }
        return 2;
    }
    let out = buf_new();
    let mut n: i64 = 0;
    let mut hits: i64 = 0;
    let mut i: i64 = 0;
    while i < list.len() as i64 {
        let mut e = i;
        while e < list.len() as i64 && list[e as usize] != b'\n' {
            e += 1;
        }
        let root = &list[i as usize..e as usize];
        i = e + 1;
        if root.len() == 0 {
            continue;
        }
        n += 1;
        // (the command's words, less its --root and an --in of dir, with
        // `--root ROOT`)
        let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut k: i64 = 0;
        while k < tcx.roots_cmd.len() as i64 {
            let a = c_slice(word(k, tcx));
            if k >= 2 && (a == b"--root" || a == b"--in") && k + 1 < tcx.roots_cmd.len() as i64
                && (a == b"--root" || c_slice(word(k + 1, tcx)) == c_slice(dir)) {
                k += 2;
                continue;
            }
            if k >= 2 && a.len() > 7 && a[0..7] == b"--root=" {
                k += 1;
                continue;
            }
            words.push(word(k, tcx) as i64);
            k += 1;
        }
        words.push(c"--root" as i64);
        words.push(cstr_of(root) as i64);
        let got = buf_new();
        run_capture(exec_words(words.as_slice()).as_slice(), got);
        // (its hits; not its `0 hits` note, nor its warnings)
        let t = buf_slice(got);
        let mut p: i64 = 0;
        while p < t.len() as i64 {
            let mut q = p;
            while q < t.len() as i64 && t[q as usize] != b'\n' {
                q += 1;
            }
            let l = &t[p as usize..q as usize];
            if l.len() > 0
                && !(l.len() > 5 && (&l[0..5] == b"note " || &l[0..5] == b"warni")) {
                buf_bytes(out, l);
                buf_byte(out, b'\n');
                if l[0] != b'#' {
                    hits += 1;
                }
            }
            p = q + 1;
        }
    }
    buf_write_fd(out, crate::base::STDOUT);
    let d = diag(c"note", c"query.programs", tcx);
    buf_int(d, hits);
    buf_str(d, if hits == 1 { c" hit in the " } else { c" hits in the " });
    buf_int(d, n);
    buf_str(d, if n == 1 { c" program under " } else { c" programs under " });
    buf_str(d, dir);
    buf_str(d, c" (each main.vl: its code, comments and strings)\n");
    0
}

// The root of the command's program: ROOT given (root_named), else one a
// FILE argument names (root_of_args), else the default (find_root); 0
// when there is none.
pub fn program_root(given: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    if given != 0 as *mut u8 {
        return root_named(given, pcx);
    }
    let r = root_of_args(tcx, pcx);
    if r != 0 as *mut u8 {
        return r;
    }
    find_root(0 as *mut u8, pcx)
}

// ---- A NAME of another program ----

// Whether the root is the default one, chosen by nobody: no ROOT, no
// VOLE_ROOT (find_root then names ./main.vl, ./compiler/src/main.vl or
// none; a question asked of another program goes to it).
fn default_root_used(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if tcx.root_given != 0 as *mut u8 || tcx.root_inferred {
        return false;
    }
    let d = find_root(0 as *mut u8, pcx);
    d == 0 as *mut u8 || c_slice(d) == b"main.vl" || c_slice(d) == b"compiler/src/main.vl"
        || (c_slice(d).len() > 3 && &c_slice(d)[0..3] == b"../")
}

// The .vl files under the current directory with a match of extended
// regular expression `pattern` as a whole word: a buffer of lines, sorted
// (the same order everywhere). `git grep` (tracked and untracked files,
// less what git ignores), else, out of a checkout or in a directory git
// ignores (a release's tree extracted under target/), `grep -r` less the
// build's and the tools' directories; never of the home directory or /.
fn files_matching(pattern: *mut u8) -> &'static [u8] {
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    words.push(c"sh" as i64);
    words.push(c"-c" as i64);
    words.push(c"{ if git rev-parse --git-dir >/dev/null 2>&1 && ! git check-ignore -q . 2>/dev/null; then git grep -l -w -E --untracked -e \"$0\" -- '*.vl'; elif [ \"$PWD\" != \"$HOME\" ] && [ \"$PWD\" != / ]; then grep -rlwE --include='*.vl' --exclude-dir=.git --exclude-dir=target --exclude-dir=.claude --exclude-dir=.volec --exclude-dir=node_modules -e \"$0\" -- .; fi; } 2>/dev/null | LC_ALL=C sort" as i64);
    words.push(pattern as i64);
    let args = exec_words(words.as_slice());
    let listing = buf_new();
    if run_capture(&args, listing) != 0 {
        return &buf_slice(listing)[0..0];
    }
    buf_slice(listing)
}

// The roots of the programs under the current directory, other than
// `default`, with a file that defines `name` (`fn name`, `struct name`,
// `mod name`, ...) and, when `file` is not empty (`sim.vl::Sim::f`), whose
// path ends with it: a buffer of lines, the program the current directory
// is in first, then the examples', then the rest; never one of a
// directory foreign_program names (0.25.2.2: the 0.25.2.1 eval's `try:`
// lines named other agents' programs under evals/).
fn roots_defining<'a>(name: &'a [u8], default: *mut u8, file: &'a [u8], pcx: &'a Ctx<Comp>) -> &'a [
    u8] {
    let pattern = buf_new();
    buf_str(pattern, c"(fn|struct|enum|trait|const|type|mod|union|var|static)[[:space:]]+");
    buf_bytes(pattern, name);
    let roots = buf_new();
    let up = enclosing_program(pcx);
    if up != 0 as *mut u8 && (default == 0 as *mut u8 || !same_file(up, default))
        && dir_defines(dir_of(c_slice(up)), buf_cstr(pattern)) {
        buf_str(roots, up);
        buf_byte(roots, b'\n');
    }
    let t = files_matching(buf_cstr(pattern));
    let in_evals = has_text(c_slice(absolute_path(c".")), b"/evals/");
    for pass in 0..2 {
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            let mut f = &t[i as usize..e as usize];
            i = e + 1;
            if f.len() > 2 && f[0..2] == b"./" {
                f = &f[2..f.len()];
            }
            if (pass == 0) != has_segment(f, b"examples") || f.len() < 4
                || &f[(f.len() as i64 - 3) as usize..] != b".vl"
                || (f.len() > 9 && f[0..9] == b"compiler/")
                || (f.len() > 5 && f[0..5] == b"seed/") || in_evals || foreign_program(f)
                || !path_ends_with(f, file) {
                continue;
            }
            let mut r = program_of(f, pcx);
            if r == 0 as *mut u8 {
                r = cstr_of(f);
            }
            if default != 0 as *mut u8 && same_file(r, default) {
                continue;
            }
            // (once each)
            let line = buf_new();
            buf_byte(line, b'\n');
            buf_str(line, r);
            buf_byte(line, b'\n');
            let seen = buf_new();
            buf_byte(seen, b'\n');
            buf_bytes(seen, buf_slice(roots));
            if !has_text(buf_slice(seen), buf_slice(line)) {
                buf_str(roots, r);
                buf_byte(roots, b'\n');
            }
        }
    }
    buf_slice(roots)
}

// (0.25.2.2) Whether path p has a directory named seg.
fn has_segment(p: &[u8], seg: &[u8]) -> bool {
    let mut s: i64 = 0;
    for i in 0..p.len() as i64 {
        if p[i as usize] == b'/' {
            if &p[s as usize..i as usize] == seg {
                return true;
            }
            s = i + 1;
        }
    }
    false
}

// (0.25.2.2) Whether path p (relative to the current directory) is in a
// directory whose programs a `try:` line never names: evals' (other
// agents' runs), tests' (the suite's cases), a build's or a tool's
// (target/, .git/, .claude/ and its worktrees).
fn foreign_program(p: &[u8]) -> bool {
    let mut s: i64 = 0;
    for i in 0..p.len() as i64 {
        if p[i as usize] == b'/' {
            let seg = &p[s as usize..i as usize];
            if seg == b"evals" || seg == b"tests" || seg == b"target"
                || (seg.len() > 1 && seg[0] == b'.' && seg != b"..") {
                return true;
            }
            s = i + 1;
        }
    }
    false
}

// (0.25.2.2) Whether path p is file, or ends with `/` and file (true for
// an empty file).
fn path_ends_with(p: &[u8], file: &[u8]) -> bool {
    if file.len() == 0 {
        return true;
    }
    if p.len() < file.len() || &p[(p.len() as i64 - file.len() as i64) as usize..] != file {
        return false;
    }
    p.len() == file.len() || p[(p.len() as i64 - file.len() as i64 - 1) as usize] == b'/'
        || file[0] == b'/'
}

// (0.25.2.2) The main.vl of a directory above the current one (at most 6
// up, not past a checkout's top, the one with .git), or 0: the program
// the current directory is in when it has no main.vl of its own.
pub fn enclosing_program(pcx: &Ctx<Comp>) -> *mut u8 {
    let p = buf_new();
    for _ in 0..6 {
        // (the checkout's top: no program above it)
        let g = buf_new();
        buf_bytes(g, buf_slice(p));
        buf_str(g, c".git");
        if file_exists(buf_cstr(g), pcx) {
            return 0 as *mut u8;
        }
        buf_str(p, c"../");
        let m = buf_new();
        buf_bytes(m, buf_slice(p));
        buf_str(m, c"main.vl");
        if file_exists(buf_cstr(m), pcx) {
            return buf_cstr(m);
        }
    }
    0 as *mut u8
}

// (0.25.2.2) Whether a .vl file under directory dir matches `pattern` (an
// extended regular expression) as a whole word.
fn dir_defines(dir: &[u8], pattern: *mut u8) -> bool {
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    words.push(c"sh" as i64);
    words.push(c"-c" as i64);
    words.push(c"grep -rlqwE --include='*.vl' --exclude-dir=.git --exclude-dir=target -e \"$0\" -- \"$1\" 2>/dev/null" as i64);
    words.push(pattern as i64);
    words.push(cstr_of(dir) as i64);
    let out = buf_new();
    run_capture(exec_words(words.as_slice()).as_slice(), out) == 0
}

fn has_text(t: &[u8], part: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + part.len() as i64 <= t.len() as i64 {
        if &t[i as usize..(i + part.len() as i64) as usize] == part {
            return true;
        }
        i += 1;
    }
    false
}

// The command as it was run, with `--root ROOT`: a `try:` line.
fn try_with_root(root: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    let mut k: i64 = 1;
    while k < tcx.roots_cmd.len() as i64 {
        // (a directory --root it replaces: left out)
        let a = c_slice(word(k, tcx));
        if a == b"--root" && k + 1 < tcx.roots_cmd.len() as i64
            && crate::tools::fmt::is_dir(word(k + 1, tcx))
            && !program_dir(c_slice(word(k + 1, tcx)), pcx) {
            k += 2;
            continue;
        }
        put_word(out, a);
        k += 1;
    }
    buf_str(out, c" --root");
    put_word(out, root);
    try_end(out);
}

// After a diagnostic that NAME is not in the default program: the other
// programs that define it, a `try:` line each (at most 3); true when
// there is one. `ask_again`: a question one program answers is asked of
// it (other_root). (0.25.2.2) Never for a std path: std is every
// program's, and the nearest names answer it (the 0.25.2.1 eval's `show
// std::window::Surface::frame` got other agents' programs, not
// std::gpu::Surface::frame).
pub fn try_other_roots(name: &[u8], ask_again: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let want = last_segment(name);
    if want.len() == 0 || !default_root_used(tcx, pcx)
        || crate::tools::query::stdq::names_std(name) {
        return false;
    }
    for i in 0..want.len() {
        if !is_name_char(want[i]) {
            return false;
        }
    }
    let default = find_root(0 as *mut u8, pcx);
    let roots = roots_defining(want, default, file_part(name), pcx);
    let mut shown: i64 = 0;
    let mut i: i64 = 0;
    while i < roots.len() as i64 && shown < 3 {
        let mut e = i;
        while e < roots.len() as i64 && roots[e as usize] != b'\n' {
            e += 1;
        }
        try_with_root(&roots[i as usize..e as usize], tcx, pcx);
        if shown == 0 && ask_again && e + 1 >= roots.len() as i64 {
            tcx.other_root = cstr_of(&roots[i as usize..e as usize]);
        }
        shown += 1;
        i = e + 1;
    }
    shown > 0
}

// (0.25.2.2) The FILE of a `FILE.vl::item` name (`sim.vl::Sim::f`), or "".
pub fn file_part(name: &[u8]) -> &[u8] {
    let mut i: i64 = 0;
    while i + 5 <= name.len() as i64 {
        if &name[i as usize..(i + 5) as usize] == b".vl::" {
            return &name[0..(i + 3) as usize];
        }
        i += 1;
    }
    &name[0..0]
}

// (run_query) A question no definition of the default program answers
// and one other program's does: asked again of it, with a note saying so
// in place of the diagnostics (never returns when it can run).
pub fn other_root(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.other_root == 0 as *mut u8 {
        return;
    }
    let default = find_root(0 as *mut u8, pcx);
    let out = diags(tcx);
    buf_clear(out);
    let d = diag(c"note", c"query.other-root", tcx);
    buf_str(d, c"not in ");
    buf_str(d, if default == 0 as *mut u8 { c"this directory's program" } else { default });
    buf_str(d, c"; answered from ");
    buf_str(d, tcx.other_root);
    buf_str(d, c" (--root ");
    buf_str(d, tcx.other_root);
    buf_str(d, c")\n");
    buf_write_fd(out, STDERR);
    buf_clear(out);
    // (the command's words, `--root`, the root)
    let mut words = command_words(tcx);
    words.push(c"--root" as i64);
    words.push(tcx.other_root as i64);
    let args = exec_words(words.as_slice());
    // UNSAFE: execvp is C's
    // SAFETY: args is a null-ended array of C strings (exec_words), its
    // first the program as this one was run
    unsafe { execvp(word(0, tcx), args.as_ptr() as *mut *mut u8); }
}
