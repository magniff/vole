// The diagnostics of `query` and of the tools built on it: the command line
// as given (PROG, CMD, ROOT_GIVEN, TOOL), the `<severity> <code>: <message>`
// lines, the `try:` lines that give the command corrected, and the answer
// to a NAME that matches nothing (the nearest definitions, the modules).

use crate::base::{
    IntVec, STDERR, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, streq, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{edit_distance, error_count, first_error_short};
use crate::base::json::{get_diag_json, json_tool_diags};
use crate::front::modules::module_count;
use crate::tools::ctx::Tcx;
use crate::tools::query::{N_COMMANDS, QF_USE, command_name};
use crate::tools::query::defs::{bytes_eq, def_of_node, last_segment, mod_fqn_text};
use crate::tools::query::show::find_modules;

// ---- Diagnostics ----
//
// On stderr, for agents and scripts (docs/query.md):
//   <severity> <code>: <message>
//   try: <command>          (0-3 lines, best first, ready to run)
// The codes are stable: query.no-match, query.alias, query.ambiguous,
// query.no-root, query.bad-root, query.program-errors, query.truncated,
// query.empty, query.bad-in, query.usage.

pub fn diags(tcx: &mut Tcx<Comp>) -> i64 {
    if tcx.diags < 0 {
        tcx.diags = buf_new();
    }
    tcx.diags
}

// Starts a diagnostic: `<severity> <code>: `; its message follows.
pub fn diag(severity: *mut u8, code: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    let out = diags(tcx);
    buf_str(out, severity);
    buf_byte(out, b' ');
    buf_str(out, code);
    buf_str(out, c": ");
    out
}

// Whether s needs quoting for the shell.
fn needs_quotes(s: &[u8]) -> bool {
    if s.len() == 0 {
        return true;
    }
    for i in 0..s.len() {
        let c = s[i];
        let plain = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
            || c == b'_' || c == b':' || c == b'.' || c == b'/' || c == b'-' || c == b'+'
            || c == b'=' || c == b',';
        if !plain {
            return true;
        }
    }
    false
}

// A word of a command: ` s`, quoted when the shell needs it.
pub fn put_word(out: i64, s: &[u8]) {
    buf_byte(out, b' ');
    if needs_quotes(s) {
        buf_byte(out, b'\'');
        buf_bytes(out, s);
        buf_byte(out, b'\'');
    } else {
        buf_bytes(out, s);
    }
}

pub fn put_cword(out: i64, s: *mut u8) {
    unsafe {
        put_word(out,
            std::slice::from_raw_parts(s.add((0) as usize), (strlen(s) as i64 - (0)) as usize));
    }
}

// Whether cmd is a command of `query` (the others, `replace`, `fix`...,
// are commands of their own, or of `edit`: see TOOL).
pub fn is_query_command(cmd: *mut u8) -> bool {
    for i in 0..N_COMMANDS {
        if streq(cmd, command_name(i)) {
            return true;
        }
    }
    false
}

// Starts a `try:` line: `try: PROG query CMD [NAME] [ROOT]` (NAME is a
// full path, or the one asked about: --exact is not needed), or `try:
// PROG [TOOL] CMD ...` for a command that is not query's;
// more words follow (put_word), then try_end.
pub fn try_begin(cmd: *mut u8, name: &[u8], with_name: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = diags(tcx);
    buf_str(out, c"try:");
    put_cword(out, pcx.prog);
    if is_query_command(cmd) {
        buf_str(out, c" query ");
    } else if tcx.tool != 0 as *mut u8 {
        buf_byte(out, b' ');
        buf_str(out, tcx.tool);
        buf_byte(out, b' ');
    } else {
        buf_byte(out, b' ');
    }
    buf_str(out, cmd);
    if with_name {
        put_word(out, name);
    }
    put_root(out, tcx);
    out
}

// ROOT as it was given (` ROOT`, or ` --root ROOT` when it does not end in
// .vl), for a command line.
pub fn put_root(out: i64, tcx: &Tcx<Comp>) {
    if tcx.root_given != 0 as *mut u8 {
        if !crate::base::is_source_path(tcx.root_given)
            || tcx.root_inferred {
            buf_str(out, c" --root");
        }
        put_cword(out, tcx.root_given);
    }
}

pub fn try_end(out: i64) {
    buf_byte(out, b'\n');
}

// `try: PROG query CMD NAME`.
pub fn try_query(cmd: *mut u8, name: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    try_end(try_begin(cmd, name, true, tcx, pcx));
}

pub fn write_diags(tcx: &Tcx<Comp>) {
    if tcx.diags >= 0 {
        if get_diag_json() {
            let j = buf_new();
            json_tool_diags(j, buf_slice(tcx.diags));
            buf_write_fd(j, STDERR);
        } else {
            buf_write_fd(tcx.diags, STDERR);
        }
        buf_clear(tcx.diags);
    }
}

// The program had errors: their number (and, `first`, the first one), and
// how to see them all.
pub fn program_errors(severity: *mut u8, root: *mut u8, first: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    if error_count(pcx) == 0 {
        return;
    }
    let out = diag(severity, c"query.program-errors", tcx);
    buf_int(out, error_count(pcx));
    buf_str(out, if error_count(pcx) == 1 { c" error" } else { c" errors" });
    buf_str(out,
        if tcx.parsed { c" in the program; results may be incomplete" }
        else { c" in the program; nothing to answer with" });
    if first {
        buf_str(out, c"; first: ");
        first_error_short(out, pcx);
    }
    buf_str(out, c"\ntry:");
    put_cword(out, pcx.prog);
    buf_str(out, c" --diagnostics=short");
    put_cword(out, root);
    buf_str(out, c" -c -o /dev/null\n");
}

// The definitions nearest to `want` (its last segment), nearest first:
// at most `max`, in `found`, each path once (std read from its files and
// built in has two definitions of each item). Not std's when `program`
// (a misspelled path of the program's: `utill::bump`).
fn nearest_defs(want: &[u8], found: &mut IntVec, max: i64, program: bool, pcx: &Ctx<Comp>) {
    unsafe {
        let mut limit = want.len() as i64 / 3;
        if limit < 1 {
            limit = 1;
        }
        let mut dist = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut all = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].fqn < 0 {
                continue;
            }
            if program && sym_text(pcx.defs[d as usize].fqn, pcx).len() >= 5
                && sym_text(pcx.defs[d as usize].fqn, pcx)[0..5] == b"std::" {
                continue;
            }
            let k = edit_distance(want, sym_text(pcx.defs[d as usize].name, pcx));
            if k <= limit {
                all.push(d);
                dist.push(k);
            }
        }
        // (nearest first, then by path)
        for i in 1..all.count {
            let mut j = i;
            while j > 0
                && ((*dist.data.add(j as usize)) < (*dist.data.add((j - 1) as usize))
                    || ((*dist.data.add(j as usize)) == (*dist.data.add((j - 1) as usize))
                        && sym_less(pcx.defs[(*all.data.add(j as usize)) as usize].fqn,
                            pcx.defs[(*all.data.add((j - 1) as usize)) as usize].fqn, pcx))) {
                let t = (*all.data.add(j as usize));
                (*all.data.add(j as usize)) = (*all.data.add((j - 1) as usize));
                (*all.data.add((j - 1) as usize)) = t;
                let u = (*dist.data.add(j as usize));
                (*dist.data.add(j as usize)) = (*dist.data.add((j - 1) as usize));
                (*dist.data.add((j - 1) as usize)) = u;
                j -= 1;
            }
        }
        for i in 0..all.count {
            if found.count >= max {
                return;
            }
            let mut seen = false;
            for j in 0..found.count {
                if pcx.defs[(*found.data.add(j as usize)) as usize].fqn
                    == pcx.defs[(*all.data.add(i as usize)) as usize].fqn {
                    seen = true;
                }
            }
            if !seen {
                found.push((*all.data.add(i as usize)));
            }
        }
    }
}

pub fn push_once(v: &mut IntVec, x: i64) {
    unsafe {
        for i in 0..v.count {
            if (*v.data.add(i as usize)) == x {
                return;
            }
        }
        v.push(x);
    }
}

// The `try:` lines of an unanswered NAME: the definitions in `found`,
// else the module listing that could hold it.
fn try_found(cmd: *mut u8, name: &[u8], found: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        for i in 0..found.count {
            try_query(cmd, sym_text(pcx.defs[(*found.data.add(i as usize)) as usize].fqn, pcx), tcx,
                pcx);
        }
        if found.count > 0 {
            return;
        }
        // `m::x`: the items of m, if there is such a module.
        let mut i = name.len() as i64 - 1;
        while i > 0 && !(name[i as usize] == b':' && name[(i - 1) as usize] == b':') {
            i -= 1;
        }
        if i > 1 {
            let mut modules = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            find_modules(&name[0..(i - 1) as usize], false, &mut modules, tcx, pcx);
            if modules.count > 0 {
                try_query(c"items", mod_fqn_text((*modules.data.add(0)), tcx, pcx), tcx, pcx);
                return;
            }
        }
        try_end(try_begin(c"items", name, false, tcx, pcx));
    }
}

// The definitions an import's other name `want` (`use a::f as want;`)
// imports, into found; the position of the first such import, or -1.
pub fn alias_defs(want: &[u8], found: &mut IntVec, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut alias_at: i64 = -1;
        let mut i: i64 = 0;
        while i < tcx.aliases.count {
            if bytes_eq(sym_text((*tcx.aliases.data.add(i as usize)), pcx), want) {
                let mut k: i64 = 0;
                while k < pcx.notes.count {
                    let d = def_of_node((*pcx.notes.data.add((k + 2) as usize)), tcx, pcx);
                    if (*pcx.notes.data.add(k as usize))
                        == (*tcx.aliases.data.add((i + 1) as usize))
                        && ((*pcx.notes.data.add((k + 3) as usize)) & QF_USE) != 0
                        && d >= 0 {
                        push_once(found, d);
                        if alias_at < 0 {
                            alias_at = (*pcx.notes.data.add(k as usize));
                        }
                    }
                    k += 4;
                }
            }
            i += 2;
        }
        alias_at
    }
}

// No definition answers to `name`: the nearest names.
pub fn no_match(cmd: *mut u8, name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let want = last_segment(name);
    let mut found = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let out = diag(c"error", c"query.no-match", tcx);
    buf_str(out, c"no definition '");
    buf_bytes(out, name);
    buf_str(out, c"'\n");
    // (0.25.2: another program defining it, roots.vl)
    if crate::tools::query::roots::try_other_roots(name, is_query_command(cmd), tcx, pcx) {
        return;
    }
    // (a path whose first segment std does not define, `utill::bump`: the
    // program's names only; `Vec::pushh` keeps std's)
    let mut first = name;
    for i in 0..name.len() {
        if name[i] == b':' {
            first = &name[0..i];
            break;
        }
    }
    let program = first.len() < name.len() && first != b"std"
        && !crate::tools::query::stdq::std_defines(first, tcx);
    nearest_defs(want, &mut found, 3, program, pcx);
    try_found(cmd, name, found, tcx, pcx);
}

// No module answers to `name`.
pub fn no_module(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let out = diag(c"error", c"query.no-match", tcx);
    buf_str(out, c"no module '");
    buf_bytes(out, name);
    buf_str(out, c"'\n");
    if crate::tools::query::roots::try_other_roots(name, true, tcx, pcx) {
        return;
    }
    let want = last_segment(name);
    let mut limit = want.len() as i64 / 3;
    if limit < 1 {
        limit = 1;
    }
    let mut shown: i64 = 0;
    for m in 0..module_count(pcx) {
        if pcx.modules[m as usize].name < 0 || shown >= 3 {
            continue;
        }
        if edit_distance(want, last_segment(mod_fqn_text(m, tcx, pcx))) <= limit {
            try_query(c"items", mod_fqn_text(m, tcx, pcx), tcx, pcx);
            shown += 1;
        }
    }
    if shown == 0 {
        try_end(try_begin(c"items", name, false, tcx, pcx));
    }
}

pub fn sym_less(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let x = sym_text(a, pcx);
    let y = sym_text(b, pcx);
    let n = if x.len() < y.len() { x.len() as i64 } else { y.len() as i64 };
    for i in 0..n {
        if x[i as usize] != y[i as usize] {
            return x[i as usize] < y[i as usize];
        }
    }
    x.len() < y.len()
}
