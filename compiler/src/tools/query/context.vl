// `query context NAME... [--budget N]` (0.15): what an agent fetches in
// three to five queries about an item, in one answer sized to a budget
// (CONTEXT_BUDGET tokens by default; 4 bytes a token): the item's source
// with its comments and its section's title, the signatures of what it
// calls and of the types it uses, and its callers with their lines. What
// does not fit is counted in a last note, with the commands that print
// it. For a module: its banners and items with their signatures, then
// the bodies of the items the module uses most, as far as they fit.

use crate::base::{
    IntVec, SRC, STDOUT, STDOUT_CAPTURE, SYMS, alloc_array, buf_byte, buf_bytes, buf_int, buf_new,
    buf_slice, buf_str, buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{MODULES, file_of_pos, module_count};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{QF_DEF, QF_USE};
use crate::tools::query::budget::BYTES_PER_TOKEN;
use crate::tools::query::defs::{
    K_ALIAS, K_ENUM, K_FIELD, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STRUCT, K_TRAIT, K_TRAIT_FN,
    K_VARIANT, find_defs, kind_name, mod_fqn,
};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::effects::put_def_effects;
use crate::tools::query::features::{put_def_features, put_intrinsic_notes};
use crate::tools::query::names::canonical_name;
use crate::tools::query::positions::{
    enclosing, line_end, line_of, put_loc, put_path, rank_of, sort_by_keys,
};
use crate::tools::query::refs::{collect_all_refs, put_line, put_short};
use crate::tools::query::sections::{B_SECTION, banners_of_module, put_title};
use crate::tools::query::show::{find_modules, put_signature, query_items, query_show, text_start};
use crate::tools::query::stdq::put_std_use;
use crate::tools::query::values::put_def_views;

// The budget of an answer without --budget, in tokens.
pub const CONTEXT_BUDGET: i64 = 2000;

// The longest type shown whole (`struct T { a: i64, b: [u8] }`), in bytes.
const TYPE_WHOLE: i64 = 160;

fn budget_bytes(tcx: Tcx<Comp>) -> i64 {
    if tcx.opt_budget == 0 {
        return 1 << 40;
    }
    (if tcx.opt_budget > 0 { tcx.opt_budget } else { CONTEXT_BUDGET }) * BYTES_PER_TOKEN
}

// Every reference, once (collect_all_refs; what it leaves behind is
// dropped, so refs can be collected again).
fn load_refs(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        if tcx.context_all.count > 0 {
            return;
        }
        var all = tcx.context_all;
        collect_all_refs(&all, &tcx, pcx);
        tcx.context_all = all;
        tcx.ref_n = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        var i = 0;
        while i < tcx.context_all.count {
            tcx.ref_n[tcx.context_all.data[i + 1]] += 1;
            i += 3;
        }
        tcx.refs_targets.count = 0;
        tcx.r_pos.count = 0;
        tcx.r_def.count = 0;
        tcx.r_group.count = 0;
        tcx.r_flags.count = 0;
        tcx.refs_group = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    }
}

// `query context` for the NAMEs of args: the exit status.
pub fn query_context(text: [u8], matches: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if matches.count > 5 {
            return query_show(matches, text, &tcx, &pcx);
        }
        load_refs(&tcx, pcx);
        let n = matches.count;
        let per = budget_bytes(tcx) / (if n > 0 { n } else { 1 });
        for i in 0..n {
            let d = matches.data[i];
            if pcx.defs[d].kind == K_MOD {
                let m = module_of_def(d, pcx);
                if m >= 0 {
                    module_context(m, per, &tcx, &pcx);
                    continue;
                }
            }
            item_context(d, per, &tcx, &pcx);
        }
        put_cut_note(text, &tcx, pcx);
        0
    }
}

// The module NAME names when it is a module and no other item (`query
// context crate::tools::query`, `context query`), or -1.
pub fn context_module(name0: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let name = canonical_name(name0);
        var mods = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(name, false, &mods, &tcx, pcx);
        if mods.count != 1 {
            return -1;
        }
        var defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_defs(name, false, &defs, tcx, pcx);
        for i in 0..defs.count {
            if pcx.defs[defs.data[i]].kind != K_MOD {
                return -1;
            }
        }
        mods.data[0]
    }
}

// `query context MODULE`: the exit status.
pub fn query_context_module(m: i64, text: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    load_refs(&tcx, pcx);
    module_context(m, budget_bytes(tcx), &tcx, &pcx);
    put_cut_note(text, &tcx, pcx);
    0
}

fn module_of_def(d: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        for m in 0..module_count(pcx) {
            if m < pcx.mod_def.count && pcx.mod_def.data[m] == d {
                return m;
            }
        }
        -1
    }
}

fn is_fn_kind(k: i64) -> bool {
    k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
}

fn is_type_kind(k: i64) -> bool {
    k == K_STRUCT || k == K_ENUM || k == K_TRAIT || k == K_ALIAS
}

// Whether definition e is inside definition d (a local item, d's fields).
fn inside(e: i64, d: i64, pcx: Ctx<Comp>) -> bool {
    e == d || pcx.defs[e].parent == d
        || (pcx.defs[e].start >= pcx.defs[d].start && pcx.defs[e].start < pcx.defs[d].end)
}

// The section banner above position pos in module m, or -1.
fn section_of(m: i64, pos: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var banners = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        banners_of_module(m, &banners, &tcx, &pcx);
        var best = -1;
        for i in 0..banners.count {
            let b = banners.data[i];
            if tcx.b_kind.data[b] == B_SECTION && tcx.sections_b_start.data[b] < pos
                && file_of_pos(tcx.sections_b_start.data[b]) == file_of_pos(pos) {
                best = b;
            }
        }
        best
    }
}

// `PATH<TAB>FILE:LINE:COL<TAB>KIND<TAB>SIGNATURE` of e (a short struct or
// enum whole).
fn put_def_line(out: i64, e: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    buf_bytes(out, SYMS[pcx.defs[e].fqn].text);
    buf_byte(out, '\t');
    put_loc(out, pcx.defs[e].name_pos, &pcx);
    buf_byte(out, '\t');
    buf_str(out, kind_name(pcx.defs[e].kind));
    buf_byte(out, '\t');
    let k = pcx.defs[e].kind;
    if k == K_STRUCT || k == K_ENUM {
        let whole = buf_new();
        if pcx.defs[e].public {
            buf_str(whole, c"pub ");
        }
        crate::tools::query::positions::collapse(whole, pcx.defs[e].start, pcx.defs[e].end);
        if buf_slice(whole).len as i64 <= TYPE_WHOLE {
            buf_bytes(out, buf_slice(whole));
            buf_byte(out, '\n');
            return;
        }
    }
    put_signature(out, e, tcx, pcx);
    buf_byte(out, '\n');
}

// Lines of `from` (a buffer) appended to out while they fit in *room
// bytes; the number of lines left out.
fn fit_lines(out: i64, from: i64, room: inout i64) -> i64 {
    let s = buf_slice(from);
    var i = 0;
    var cut = 0;
    while i < s.len as i64 {
        var e = i;
        while e < s.len as i64 && s[e] != '\n' {
            e += 1;
        }
        let n = e + 1 - i;
        if cut == 0 && n <= room {
            buf_bytes(out, s[i..e + 1]);
            room = room - n;
        } else {
            cut += 1;
        }
        i = e + 1;
    }
    cut
}

// The context of definition d, in about `budget` bytes.
fn item_context(d: i64, budget: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let head = buf_new();
        let first = text_start(d, pcx);
        let last = line_end(if pcx.defs[d].end > pcx.defs[d].start { pcx.defs[d].end - 1 }
            else { pcx.defs[d].start }, pcx);
        buf_str(head, c"// ");
        buf_bytes(head, SYMS[pcx.defs[d].fqn].text);
        buf_byte(head, '\t');
        put_path(head, file_of_pos(first));
        buf_byte(head, ':');
        buf_int(head, line_of(first, pcx));
        buf_byte(head, '-');
        buf_int(head, line_of(last, pcx));
        let sec = section_of(pcx.defs[d].module, first, &tcx, &pcx);
        if sec >= 0 {
            buf_str(head, c"\tsection: ");
            put_title(head, sec, tcx);
        }
        put_def_effects(head, d, c"\t", tcx, pcx);
        put_def_views(head, d, c"\t", tcx, &pcx);
        put_def_features(head, d, c"\t", tcx, pcx);
        // (0.26.0) a field's visibility
        if pcx.defs[d].kind == K_FIELD {
            let written = crate::front::modules::vis::written_restriction(pcx.defs[d].start);
            if pcx.defs[d].public && written.len > 0 {
                // (0.26.2: `pub(crate) field`)
                buf_byte(head, '\t');
                buf_bytes(head, written);
                buf_str(head, c" field");
            } else if pcx.defs[d].public {
                buf_str(head, c"\tpub field");
            } else if pcx.defs[d].module > 0 && MODULES[pcx.defs[d].module].key >= 0 {
                // (the root's are the whole program's)
                buf_str(head, c"\tprivate to module ");
                buf_bytes(head, SYMS[MODULES[pcx.defs[d].module].key].text);
            }
        }
        buf_byte(head, '\n');
        put_intrinsic_notes(head, d, tcx, pcx);
        put_std_use(head, d, tcx, &pcx);
        let src = buf_new();
        buf_bytes(src, SRC[first..last]);
        buf_byte(src, '\n');
        // What it uses, in order of first use; who uses it.
        var used = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var seen = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        var callers = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var i = 0;
        while i < tcx.context_all.count {
            let pos = tcx.context_all.data[i];
            var e = tcx.context_all.data[i + 1];
            let fl = tcx.context_all.data[i + 2];
            i += 3;
            if (fl & QF_DEF) != 0 {
                continue;
            }
            if pos >= pcx.defs[d].start && pos < pcx.defs[d].end {
                if (pcx.defs[e].kind == K_FIELD || pcx.defs[e].kind == K_VARIANT)
                    && pcx.defs[e].parent >= 0 {
                    e = pcx.defs[e].parent;
                }
                if inside(e, d, pcx) || pcx.defs[e].kind == K_MOD || seen.get(e + 1) != 0 {
                    continue;
                }
                seen.put(e + 1, 1);
                used.push(e);
            } else if e == d && (fl & QF_USE) == 0 {
                callers.push(pos);
            }
        }
        sort_positions(&used, true, tcx, pcx);
        sort_positions(&callers, false, tcx, pcx);
        let calls = buf_new();
        let types = buf_new();
        let others = buf_new();
        var n_calls = 0;
        var n_types = 0;
        var n_others = 0;
        for j in 0..used.count {
            let e = used.data[j];
            let k = pcx.defs[e].kind;
            if is_fn_kind(k) {
                put_def_line(calls, e, tcx, &pcx);
                n_calls += 1;
            } else if is_type_kind(k) {
                put_def_line(types, e, tcx, &pcx);
                n_types += 1;
            } else {
                put_def_line(others, e, tcx, &pcx);
                n_others += 1;
            }
        }
        let who = buf_new();
        for j in 0..callers.count {
            let pos = callers.data[j];
            let enc = enclosing(pos, tcx, pcx);
            put_short(who,
                if enc >= 0 { pcx.defs[enc].fqn } else { mod_fqn(pcx.defs[d].module, &tcx, pcx) });
            buf_byte(who, '\t');
            put_loc(who, pos, &pcx);
            buf_byte(who, '\t');
            put_line(who, pos, pcx);
            buf_byte(who, '\n');
        }
        // Fitting: the header always; the source up to what the lists
        // leave (half the budget at least); then the lists in turn.
        let out = buf_new();
        buf_bytes(out, buf_slice(head));
        var room = budget - buf_slice(head).len as i64;
        let lists = buf_slice(calls).len as i64 + buf_slice(types).len as i64 + buf_slice(others).len as i64
            + buf_slice(who).len as i64 + 64;
        let keep = if lists < room / 2 { lists } else { room / 2 };
        var src_room = room - keep;
        let cut = fit_lines(out, src, &src_room);
        if cut > 0 {
            buf_str(out, c"// (");
            buf_int(out, cut);
            buf_str(out, c" more lines)\n");
            tcx.cut_lines += cut;
        }
        room = keep + src_room;
        put_list(out, c"calls", n_calls, calls, &room, 0, &tcx);
        put_list(out, c"types", n_types, types, &room, 1, &tcx);
        put_list(out, c"uses", n_others, others, &room, 1, &tcx);
        put_list(out, if is_fn_kind(pcx.defs[d].kind) { c"callers" } else { c"used by" },
            callers.count, who, &room, 2, &tcx);
        buf_write_fd(out, STDOUT);
    }
}

// `// TITLE (N)` and the lines of list `from`, as far as they fit (the
// title only with its first line); which counter the lines left out go
// to (0 calls, 1 types, 2 callers).
fn put_list(out: i64, title: *u8, n: i64, from: i64, room: inout i64, which: i64,
    tcx: inout Tcx<Comp>) {
    if n == 0 {
        return;
    }
    let head = buf_new();
    buf_str(head, c"// ");
    buf_str(head, title);
    buf_str(head, c" (");
    buf_int(head, n);
    buf_str(head, c")\n");
    let s = buf_slice(from);
    var first = 0;
    while first < s.len as i64 && s[first] != '\n' {
        first += 1;
    }
    var cut = n;
    if buf_slice(head).len as i64 + first + 1 <= room {
        buf_bytes(out, buf_slice(head));
        room = room - buf_slice(head).len as i64;
        cut = fit_lines(out, from, &room);
    }
    if which == 0 {
        tcx.cut_calls += cut;
    } else if which == 1 {
        tcx.cut_types += cut;
    } else {
        tcx.cut_callers += cut;
    }
}

// Sorts positions (or, `defs`, definitions by their positions).
fn sort_positions(v: inout IntVec, defs: bool, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let n = v.count;
        let k1 = alloc_array::<i64>(n + 1);
        let k2 = alloc_array::<i64>(n + 1);
        var idx = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..n {
            idx.push(i);
            let pos = if defs { pcx.defs[v.data[i]].name_pos } else { v.data[i] };
            k1[i] = rank_of(pos, tcx);
            k2[i] = pos;
        }
        if defs {
            // (what it uses: the least used in the program first, the
            // most specific; then in order of first use)
            for a in 1..n {
                var b = a;
                while b > 0 && tcx.ref_n[v.data[b - 1]] > tcx.ref_n[v.data[b]] {
                    let t = v.data[b];
                    v.data[b] = v.data[b - 1];
                    v.data[b - 1] = t;
                    b -= 1;
                }
            }
            return;
        }
        sort_by_keys(idx, k1, k2);
        let copy = alloc_array::<i64>(n + 1);
        for i in 0..n {
            copy[i] = v.data[idx.data[i]];
        }
        for i in 0..n {
            v.data[i] = copy[i];
        }
    }
}

// The context of module m, in about `budget` bytes: `items --comments`,
// then the bodies of its items that the module's own code uses most.
fn module_context(m: i64, budget: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let saved = STDOUT_CAPTURE;
        let items = buf_new();
        STDOUT_CAPTURE = items;
        let banners = tcx.opt_banners;
        tcx.opt_banners = true;
        var ms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        ms.push(m);
        query_items(ms, &tcx, &pcx);
        tcx.opt_banners = banners;
        STDOUT_CAPTURE = saved;
        let out = buf_new();
        var room = budget;
        tcx.cut_items += fit_lines(out, items, &room);
        // Uses of each item from inside the module.
        let uses = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let outside = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let rank = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        var i = 0;
        while i < tcx.context_all.count {
            let pos = tcx.context_all.data[i];
            let e = tcx.context_all.data[i + 1];
            let fl = tcx.context_all.data[i + 2];
            i += 3;
            if (fl & QF_DEF) == 0 && pcx.defs[e].module == m && is_fn_kind(pcx.defs[e].kind) {
                let enc = enclosing(pos, tcx, pcx);
                if enc >= 0 && enc != e && pcx.defs[enc].module == m {
                    uses[e] += 1;
                } else if enc != e && (fl & QF_USE) == 0 {
                    outside[e] += 1;
                }
            }
        }
        // (what the module uses most first, then what is used from
        // outside it most)
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for e in 0..pcx.defs.len() as i64 {
            if pcx.defs[e].module == m && is_fn_kind(pcx.defs[e].kind)
                && pcx.defs[e].kind != K_TRAIT_FN {
                order.push(e);
                rank[e] = uses[e] * 1000000 + outside[e];
            }
        }
        // (most used first; insertion sort, few items)
        for a in 1..order.count {
            var b = a;
            while b > 0 && rank[order.data[b - 1]] < rank[order.data[b]] {
                let t = order.data[b];
                order.data[b] = order.data[b - 1];
                order.data[b - 1] = t;
                b -= 1;
            }
        }
        var shown = 0;
        for j in 0..order.count {
            let d = order.data[j];
            let first = text_start(d, pcx);
            let last = line_end(pcx.defs[d].end - 1, pcx);
            let body = buf_new();
            buf_str(body, c"// ");
            buf_bytes(body, SYMS[pcx.defs[d].fqn].text);
            buf_byte(body, '\t');
            put_path(body, file_of_pos(first));
            buf_byte(body, ':');
            buf_int(body, line_of(first, pcx));
            buf_byte(body, '-');
            buf_int(body, line_of(last, pcx));
            buf_str(body, c"\tused ");
            buf_int(body, uses[d]);
            buf_str(body, c" times in the module, ");
            buf_int(body, outside[d]);
            buf_str(body, c" outside\n");
            buf_bytes(body, SRC[first..last]);
            buf_byte(body, '\n');
            if buf_slice(body).len as i64 <= room {
                buf_bytes(out, buf_slice(body));
                room -= buf_slice(body).len as i64;
                shown += 1;
            }
        }
        tcx.cut_lines += order.count - shown;
        buf_write_fd(out, STDOUT);
    }
}

// The note saying what the budget left out, and the commands that print
// it.
fn put_cut_note(name: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if tcx.cut_lines + tcx.cut_calls + tcx.cut_types + tcx.cut_callers + tcx.cut_items == 0 {
        return;
    }
    let d = diag(c"note", c"query.budget", &tcx);
    buf_str(d, c"over the budget of ");
    buf_int(d, budget_bytes(tcx) / BYTES_PER_TOKEN);
    buf_str(d, c" tokens, left out:");
    put_count(d, tcx.cut_lines, c"source lines (or bodies)");
    put_count(d, tcx.cut_items, c"items");
    put_count(d, tcx.cut_calls, c"calls");
    put_count(d, tcx.cut_types, c"types or uses");
    put_count(d, tcx.cut_callers, c"callers");
    buf_byte(d, '\n');
    if tcx.cut_lines > 0 {
        try_end(try_begin(c"show", name, true, &tcx, pcx));
    }
    if tcx.cut_callers > 0 {
        try_end(try_begin(c"callers", name, true, &tcx, pcx));
    }
    let t = try_begin(c"context", name, true, &tcx, pcx);
    buf_str(t, c" --budget ");
    buf_int(t, budget_bytes(tcx) / BYTES_PER_TOKEN * 3);
    try_end(t);
}

fn put_count(d: i64, n: i64, what: *u8) {
    if n == 0 {
        return;
    }
    let s = crate::base::buf_slice(d);
    if s[s.len as i64 - 1] != ':' {
        buf_byte(d, ',');
    }
    buf_byte(d, ' ');
    buf_str(d, what);
    buf_byte(d, ' ');
    buf_int(d, n);
}
