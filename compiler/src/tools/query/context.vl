// `query context NAME... [--budget N]` (0.15): what an agent fetches in
// three to five queries about an item, in one answer sized to a budget
// (CONTEXT_BUDGET tokens by default; 4 bytes a token): the item's source
// with its comments and its section's title, the signatures of what it
// calls and of the types it uses, and its callers with their lines. What
// does not fit is counted in a last note, with the commands that print
// it. For a module: its banners and items with their signatures, then
// the bodies of the items the module uses most, as far as they fit.

use crate::base::{
    IntVec, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, get_src, get_stdout_capture, set_stdout_capture, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{file_of_pos, module_count};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{QF_DEF, QF_USE};
use crate::tools::query::budget::BYTES_PER_TOKEN;
use crate::tools::query::defs::{
    K_ALIAS, K_ENUM, K_FIELD, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STRUCT, K_TRAIT, K_TRAIT_FN,
    K_VARIANT, find_defs, kind_name, mod_fqn,
};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::effects::put_def_effects;
use crate::tools::query::features::{put_def_features, put_intrinsic_notes};
use crate::tools::query::names::canonical_name;
use crate::tools::query::positions::{
    enclosing, line_end, line_of, put_loc, put_path, rank_of, sort_by_keys,
};
use crate::tools::query::refs::{collect_all_refs, put_line, put_short};
use crate::tools::query::sections::{B_SECTION, banners_of_module, put_title};
use crate::tools::query::show::{find_modules, put_signature, query_items, query_show, text_start};
use crate::tools::query::stdq::put_std_use;

// The budget of an answer without --budget, in tokens.
pub const CONTEXT_BUDGET: i64 = 2000;

// The longest type shown whole (`struct T { a: i64, b: [u8] }`), in bytes.
const TYPE_WHOLE: i64 = 160;

fn budget_bytes(tcx: &Tcx<Comp>) -> i64 {
    if tcx.opt_budget == 0 {
        return 1 << 40;
    }
    (if tcx.opt_budget > 0 { tcx.opt_budget } else { CONTEXT_BUDGET }) * BYTES_PER_TOKEN
}

// Every reference, once (collect_all_refs; what it leaves behind is
// dropped, so refs can be collected again).
fn load_refs(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        if tcx.context_all.count > 0 {
            return;
        }
        let mut all = tcx.context_all;
        collect_all_refs(&mut all, tcx, pcx);
        tcx.context_all = all;
        tcx.ref_n = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let mut i: i64 = 0;
        while i < tcx.context_all.count {
            (*tcx.ref_n.add((*tcx.context_all.data.add((i + 1) as usize)) as usize)) += 1;
            i += 3;
        }
        tcx.refs_targets.count = 0;
        tcx.r_pos.count = 0;
        tcx.r_def.count = 0;
        tcx.r_group.count = 0;
        tcx.r_flags.count = 0;
        tcx.refs_group = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    }
}

// `query context` for the NAMEs of args: the exit status.
pub fn query_context(text: &[u8], matches: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if matches.count > 5 {
            return query_show(matches, text, tcx, pcx);
        }
        load_refs(tcx, pcx);
        let n = matches.count;
        let per = budget_bytes(tcx) / (if n > 0 { n } else { 1 });
        for i in 0..n {
            let d = (*matches.data.add(i as usize));
            if pcx.defs[d as usize].kind == K_MOD {
                let m = module_of_def(d, pcx);
                if m >= 0 {
                    module_context(m, per, tcx, pcx);
                    continue;
                }
            }
            item_context(d, per, tcx, pcx);
        }
        put_cut_note(text, tcx, pcx);
        0
    }
}

// The module NAME names when it is a module and no other item (`query
// context crate::tools::query`, `context query`), or -1.
pub fn context_module(name0: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let name = canonical_name(name0);
        let mut mods = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_modules(name, false, &mut mods, tcx, pcx);
        if mods.count != 1 {
            return -1;
        }
        let mut defs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_defs(name, false, &mut defs, tcx, pcx);
        for i in 0..defs.count {
            if pcx.defs[(*defs.data.add(i as usize)) as usize].kind != K_MOD {
                return -1;
            }
        }
        (*mods.data.add(0))
    }
}

// `query context MODULE`: the exit status.
pub fn query_context_module(m: i64, text: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    load_refs(tcx, pcx);
    module_context(m, budget_bytes(tcx), tcx, pcx);
    put_cut_note(text, tcx, pcx);
    0
}

fn module_of_def(d: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        for m in 0..module_count(pcx) {
            if m < pcx.mod_def.count && (*pcx.mod_def.data.add(m as usize)) == d {
                return m;
            }
        }
        -1
    }
}

fn is_fn_kind(k: i64) -> bool {
    k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
}

fn is_type_kind(k: i64) -> bool {
    k == K_STRUCT || k == K_ENUM || k == K_TRAIT || k == K_ALIAS
}

// Whether definition e is inside definition d (a local item, d's fields).
fn inside(e: i64, d: i64, pcx: &Ctx<Comp>) -> bool {
    e == d || pcx.defs[e as usize].parent == d
        || (pcx.defs[e as usize].start >= pcx.defs[d as usize].start
            && pcx.defs[e as usize].start < pcx.defs[d as usize].end)
}

// The section banner above position pos in module m, or -1.
fn section_of(m: i64, pos: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut banners = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        banners_of_module(m, &mut banners, tcx, pcx);
        let mut best: i64 = -1;
        for i in 0..banners.count {
            let b = (*banners.data.add(i as usize));
            if (*tcx.b_kind.data.add(b as usize)) == B_SECTION
                && (*tcx.sections_b_start.data.add(b as usize)) < pos
                && file_of_pos((*tcx.sections_b_start.data.add(b as usize)), pcx)
                == file_of_pos(pos, pcx) {
                best = b;
            }
        }
        best
    }
}

// `PATH<TAB>FILE:LINE:COL<TAB>KIND<TAB>SIGNATURE` of e (a short struct or
// enum whole).
fn put_def_line(out: i64, e: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    buf_bytes(out, sym_text(pcx.defs[e as usize].fqn, pcx));
    buf_byte(out, b'\t');
    put_loc(out, pcx.defs[e as usize].name_pos, pcx);
    buf_byte(out, b'\t');
    buf_str(out, kind_name(pcx.defs[e as usize].kind));
    buf_byte(out, b'\t');
    let k = pcx.defs[e as usize].kind;
    if k == K_STRUCT || k == K_ENUM {
        let whole = buf_new();
        if pcx.defs[e as usize].public {
            buf_str(whole, c"pub ");
        }
        crate::tools::query::positions::collapse(whole, pcx.defs[e as usize].start,
            pcx.defs[e as usize].end);
        if buf_slice(whole).len() as i64 <= TYPE_WHOLE {
            buf_bytes(out, buf_slice(whole));
            buf_byte(out, b'\n');
            return;
        }
    }
    put_signature(out, e, tcx, pcx);
    buf_byte(out, b'\n');
}

// Lines of `from` (a buffer) appended to out while they fit in *room
// bytes; the number of lines left out.
fn fit_lines(out: i64, from: i64, room: &mut i64) -> i64 {
    let s = buf_slice(from);
    let mut i: i64 = 0;
    let mut cut: i64 = 0;
    while i < s.len() as i64 {
        let mut e = i;
        while e < s.len() as i64 && s[e as usize] != b'\n' {
            e += 1;
        }
        let n = e + 1 - i;
        if cut == 0 && n <= *room {
            buf_bytes(out, &s[i as usize..(e + 1) as usize]);
            *room = *room - n;
        } else {
            cut += 1;
        }
        i = e + 1;
    }
    cut
}

// The context of definition d, in about `budget` bytes.
fn item_context(d: i64, budget: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let head = buf_new();
        let first = text_start(d, pcx);
        let last = line_end(if pcx.defs[d as usize].end
            > pcx.defs[d as usize].start { pcx.defs[d as usize].end - 1 }
            else { pcx.defs[d as usize].start }, pcx);
        buf_str(head, c"// ");
        buf_bytes(head, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_byte(head, b'\t');
        put_path(head, file_of_pos(first, pcx), pcx);
        buf_byte(head, b':');
        buf_int(head, line_of(first, pcx));
        buf_byte(head, b'-');
        buf_int(head, line_of(last, pcx));
        let sec = section_of(pcx.defs[d as usize].module, first, tcx, pcx);
        if sec >= 0 {
            buf_str(head, c"\tsection: ");
            put_title(head, sec, tcx);
        }
        put_def_effects(head, d, c"\t", tcx, pcx);
        put_def_features(head, d, c"\t", tcx, pcx);
        // (0.26.0) a field's visibility
        if pcx.defs[d as usize].kind == K_FIELD {
            let written = crate::front::modules::vis::written_restriction(
                pcx.defs[d as usize].start);
            if pcx.defs[d as usize].public && written.len() > 0 {
                // (0.26.2: `pub(crate) field`)
                buf_byte(head, b'\t');
                buf_bytes(head, written);
                buf_str(head, c" field");
            } else if pcx.defs[d as usize].public {
                buf_str(head, c"\tpub field");
            }
            else if pcx.defs[d as usize].module > 0
                && pcx.modules[pcx.defs[d as usize].module as usize].key >= 0 {
                // (the root's are the whole program's)
                buf_str(head, c"\tprivate to module ");
                buf_bytes(head,
                    sym_text(pcx.modules[pcx.defs[d as usize].module as usize].key, pcx));
            }
        }
        buf_byte(head, b'\n');
        put_intrinsic_notes(head, d, tcx, pcx);
        put_std_use(head, d, tcx, pcx);
        let src = buf_new();
        buf_bytes(src, &get_src()[first as usize..last as usize]);
        buf_byte(src, b'\n');
        // What it uses, in order of first use; who uses it.
        let mut used = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut seen = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        let mut callers = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut i: i64 = 0;
        while i < tcx.context_all.count {
            let pos = (*tcx.context_all.data.add(i as usize));
            let mut e = (*tcx.context_all.data.add((i + 1) as usize));
            let fl = (*tcx.context_all.data.add((i + 2) as usize));
            i += 3;
            if (fl & QF_DEF) != 0 {
                continue;
            }
            if pos >= pcx.defs[d as usize].start && pos < pcx.defs[d as usize].end {
                if (pcx.defs[e as usize].kind == K_FIELD || pcx.defs[e as usize].kind == K_VARIANT)
                    && pcx.defs[e as usize].parent >= 0 {
                    e = pcx.defs[e as usize].parent;
                }
                if inside(e, d, pcx) || pcx.defs[e as usize].kind == K_MOD || seen.get(e + 1) != 0 {
                    continue;
                }
                seen.put(e + 1, 1);
                used.push(e);
            } else if e == d && (fl & QF_USE) == 0 {
                callers.push(pos);
            }
        }
        sort_positions(&mut used, true, tcx, pcx);
        sort_positions(&mut callers, false, tcx, pcx);
        let calls = buf_new();
        let types = buf_new();
        let others = buf_new();
        let mut n_calls: i64 = 0;
        let mut n_types: i64 = 0;
        let mut n_others: i64 = 0;
        for j in 0..used.count {
            let e = (*used.data.add(j as usize));
            let k = pcx.defs[e as usize].kind;
            if is_fn_kind(k) {
                put_def_line(calls, e, tcx, pcx);
                n_calls += 1;
            } else if is_type_kind(k) {
                put_def_line(types, e, tcx, pcx);
                n_types += 1;
            } else {
                put_def_line(others, e, tcx, pcx);
                n_others += 1;
            }
        }
        let who = buf_new();
        for j in 0..callers.count {
            let pos = (*callers.data.add(j as usize));
            let enc = enclosing(pos, tcx, pcx);
            put_short(who,
                if enc >= 0 { pcx.defs[enc as usize].fqn }
                else { mod_fqn(pcx.defs[d as usize].module, tcx, pcx) },
                pcx);
            buf_byte(who, b'\t');
            put_loc(who, pos, pcx);
            buf_byte(who, b'\t');
            put_line(who, pos, pcx);
            buf_byte(who, b'\n');
        }
        // Fitting: the header always; the source up to what the lists
        // leave (half the budget at least); then the lists in turn.
        let out = buf_new();
        buf_bytes(out, buf_slice(head));
        let mut room = budget - buf_slice(head).len() as i64;
        let lists = buf_slice(calls).len() as i64 + buf_slice(types).len() as i64 + buf_slice(
            others).len() as i64
            + buf_slice(who).len() as i64 + 64;
        let keep = if lists < room / 2 { lists } else { room / 2 };
        let mut src_room = room - keep;
        let cut = fit_lines(out, src, &mut src_room);
        if cut > 0 {
            buf_str(out, c"// (");
            buf_int(out, cut);
            buf_str(out, c" more lines)\n");
            tcx.cut_lines += cut;
        }
        room = keep + src_room;
        put_list(out, c"calls", n_calls, calls, &mut room, 0, tcx);
        put_list(out, c"types", n_types, types, &mut room, 1, tcx);
        put_list(out, c"uses", n_others, others, &mut room, 1, tcx);
        put_list(out, if is_fn_kind(pcx.defs[d as usize].kind) { c"callers" } else { c"used by" },
            callers.count, who, &mut room, 2, tcx);
        buf_write_fd(out, STDOUT);
    }
}

// `// TITLE (N)` and the lines of list `from`, as far as they fit (the
// title only with its first line); which counter the lines left out go
// to (0 calls, 1 types, 2 callers).
fn put_list(out: i64, title: *mut u8, n: i64, from: i64, room: &mut i64, which: i64,
    tcx: &mut Tcx<Comp>) {
    if n == 0 {
        return;
    }
    let head = buf_new();
    buf_str(head, c"// ");
    buf_str(head, title);
    buf_str(head, c" (");
    buf_int(head, n);
    buf_str(head, c")\n");
    let s = buf_slice(from);
    let mut first: i64 = 0;
    while first < s.len() as i64 && s[first as usize] != b'\n' {
        first += 1;
    }
    let mut cut = n;
    if buf_slice(head).len() as i64 + first + 1 <= *room {
        buf_bytes(out, buf_slice(head));
        *room = *room - buf_slice(head).len() as i64;
        cut = fit_lines(out, from, room);
    }
    if which == 0 {
        tcx.cut_calls += cut;
    } else if which == 1 {
        tcx.cut_types += cut;
    } else {
        tcx.cut_callers += cut;
    }
}

// Sorts positions (or, `defs`, definitions by their positions).
fn sort_positions(v: &mut IntVec, defs: bool, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let n = v.count;
        let k1 = alloc_array::<i64>(n + 1);
        let k2 = alloc_array::<i64>(n + 1);
        let mut idx = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..n {
            idx.push(i);
            let pos = if defs { pcx.defs[(*v.data.add(i as usize)) as usize].name_pos }
                else { (*v.data.add(i as usize)) };
            (*k1.add(i as usize)) = rank_of(pos, tcx, pcx);
            (*k2.add(i as usize)) = pos;
        }
        if defs {
            // (what it uses: the least used in the program first, the
            // most specific; then in order of first use)
            for a in 1..n {
                let mut b = a;
                while b > 0
                    && (*tcx.ref_n.add((*v.data.add((b - 1) as usize)) as usize))
                    > (*tcx.ref_n.add((*v.data.add(b as usize)) as usize)) {
                    let t = (*v.data.add(b as usize));
                    (*v.data.add(b as usize)) = (*v.data.add((b - 1) as usize));
                    (*v.data.add((b - 1) as usize)) = t;
                    b -= 1;
                }
            }
            return;
        }
        sort_by_keys(idx, k1, k2);
        let copy = alloc_array::<i64>(n + 1);
        for i in 0..n {
            (*copy.add(i as usize)) = (*v.data.add((*idx.data.add(i as usize)) as usize));
        }
        for i in 0..n {
            (*v.data.add(i as usize)) = (*copy.add(i as usize));
        }
    }
}

// The context of module m, in about `budget` bytes: `items --comments`,
// then the bodies of its items that the module's own code uses most.
fn module_context(m: i64, budget: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let saved = get_stdout_capture();
        let items = buf_new();
        set_stdout_capture(items);
        let banners = tcx.opt_banners;
        tcx.opt_banners = true;
        let mut ms = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        ms.push(m);
        query_items(ms, tcx, pcx);
        tcx.opt_banners = banners;
        set_stdout_capture(saved);
        let out = buf_new();
        let mut room = budget;
        tcx.cut_items += fit_lines(out, items, &mut room);
        // Uses of each item from inside the module.
        let uses = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let outside = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let rank = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let mut i: i64 = 0;
        while i < tcx.context_all.count {
            let pos = (*tcx.context_all.data.add(i as usize));
            let e = (*tcx.context_all.data.add((i + 1) as usize));
            let fl = (*tcx.context_all.data.add((i + 2) as usize));
            i += 3;
            if (fl & QF_DEF) == 0 && pcx.defs[e as usize].module == m
                && is_fn_kind(pcx.defs[e as usize].kind) {
                let enc = enclosing(pos, tcx, pcx);
                if enc >= 0 && enc != e && pcx.defs[enc as usize].module == m {
                    (*uses.add(e as usize)) += 1;
                } else if enc != e && (fl & QF_USE) == 0 {
                    (*outside.add(e as usize)) += 1;
                }
            }
        }
        // (what the module uses most first, then what is used from
        // outside it most)
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for e in 0..pcx.defs.len() as i64 {
            if pcx.defs[e as usize].module == m && is_fn_kind(pcx.defs[e as usize].kind)
                && pcx.defs[e as usize].kind != K_TRAIT_FN {
                order.push(e);
                (*rank.add(e as usize)) = (*uses.add(e as usize)) * 1000000 + (
                    *outside.add(e as usize));
            }
        }
        // (most used first; insertion sort, few items)
        for a in 1..order.count {
            let mut b = a;
            while b > 0
                && (*rank.add((*order.data.add((b - 1) as usize)) as usize))
                < (*rank.add((*order.data.add(b as usize)) as usize)) {
                let t = (*order.data.add(b as usize));
                (*order.data.add(b as usize)) = (*order.data.add((b - 1) as usize));
                (*order.data.add((b - 1) as usize)) = t;
                b -= 1;
            }
        }
        let mut shown: i64 = 0;
        for j in 0..order.count {
            let d = (*order.data.add(j as usize));
            let first = text_start(d, pcx);
            let last = line_end(pcx.defs[d as usize].end - 1, pcx);
            let body = buf_new();
            buf_str(body, c"// ");
            buf_bytes(body, sym_text(pcx.defs[d as usize].fqn, pcx));
            buf_byte(body, b'\t');
            put_path(body, file_of_pos(first, pcx), pcx);
            buf_byte(body, b':');
            buf_int(body, line_of(first, pcx));
            buf_byte(body, b'-');
            buf_int(body, line_of(last, pcx));
            buf_str(body, c"\tused ");
            buf_int(body, (*uses.add(d as usize)));
            buf_str(body, c" times in the module, ");
            buf_int(body, (*outside.add(d as usize)));
            buf_str(body, c" outside\n");
            buf_bytes(body, &get_src()[first as usize..last as usize]);
            buf_byte(body, b'\n');
            if buf_slice(body).len() as i64 <= room {
                buf_bytes(out, buf_slice(body));
                room -= buf_slice(body).len() as i64;
                shown += 1;
            }
        }
        tcx.cut_lines += order.count - shown;
        buf_write_fd(out, STDOUT);
    }
}

// The note saying what the budget left out, and the commands that print
// it.
fn put_cut_note(name: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.cut_lines + tcx.cut_calls + tcx.cut_types + tcx.cut_callers + tcx.cut_items == 0 {
        return;
    }
    let d = diag(c"note", c"query.budget", tcx);
    buf_str(d, c"over the budget of ");
    buf_int(d, budget_bytes(tcx) / BYTES_PER_TOKEN);
    buf_str(d, c" tokens, left out:");
    put_count(d, tcx.cut_lines, c"source lines (or bodies)");
    put_count(d, tcx.cut_items, c"items");
    put_count(d, tcx.cut_calls, c"calls");
    put_count(d, tcx.cut_types, c"types or uses");
    put_count(d, tcx.cut_callers, c"callers");
    buf_byte(d, b'\n');
    if tcx.cut_lines > 0 {
        try_end(try_begin(c"show", name, true, tcx, pcx));
    }
    if tcx.cut_callers > 0 {
        try_end(try_begin(c"callers", name, true, tcx, pcx));
    }
    let t = try_begin(c"context", name, true, tcx, pcx);
    buf_str(t, c" --budget ");
    buf_int(t, budget_bytes(tcx) / BYTES_PER_TOKEN * 3);
    try_end(t);
}

fn put_count(d: i64, n: i64, what: *mut u8) {
    if n == 0 {
        return;
    }
    let s = crate::base::buf_slice(d);
    if s[(s.len() as i64 - 1) as usize] != b':' {
        buf_byte(d, b',');
    }
    buf_byte(d, b' ');
    buf_str(d, what);
    buf_byte(d, b' ');
    buf_int(d, n);
}
