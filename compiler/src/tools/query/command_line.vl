// The query tools' front end: the notes of how names resolved (refs and
// def read them), loading and indexing the program (split from query).

use std::alloc::Arena;

use crate::host_target;
use crate::base::{_setjmp, alloc_zeroed, intern_c, load_sources};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_X86_64_LINUX, set_target};
use crate::base::timer::{T_CHECK, T_INDEX, T_LOAD, T_PARSE, timer_add, timer_now};
use crate::front::ast::{init_ast, keep_parsed};
use crate::front::check::check_program;
use crate::front::cimport::{drop_shadowed_imports, import_c_headers};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::{init_lexer, lex_range};
use crate::front::modules::load_modules;
use crate::front::parser::parse_program;
use crate::front::types::{TyKind, init_declarations, init_types};
use crate::tools::ctx::{Tcx, cptrs};
use crate::tools::query::defs::{collect_defs, finish_defs};
use crate::tools::query::derived::collect_derive_spans;
use crate::tools::query::positions::{init_containers, init_positions};

// The name `name` written at (or just after) `from` stands for the item
// whose node is `def`.
pub fn qnote(from: i64, name: i64, def: i64, flags: i64, pcx: &mut Ctx<Comp>) {
    // (0.26.3: a use of a #[deprecated] item, a warning)
    crate::front::check::deprecated::note_deprecated_use(from, def, pcx);
    if !pcx.query || def <= 0 {
        return;
    }
    pcx.notes.push(from);
    pcx.notes.push(name);
    pcx.notes.push(def);
    pcx.notes.push(flags);
}

// ... for module m.
pub fn qnote_module(from: i64, name: i64, m: i64, flags: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.query || m < 0 || m >= pcx.mod_def.len() as i64
        || (pcx.mod_def[m as usize]) < 0 {
        return;
    }
    qnote(from, name, pcx.defs[(pcx.mod_def[m as usize]) as usize].node, flags, pcx);
}

// `Self` written at pos stands for type t (0.13): a reference to its
// struct or enum.
pub fn qnote_self(pos: i64, name: i64, t: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if !pcx.query || t <= 0 {
            return;
        }
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Struct {
            qnote(pos, name, pcx.structs[pcx.types[t as usize].a as usize].node, 0, pcx);
        } else if k == TyKind::Enum {
            qnote(pos, name, (pcx.enums[pcx.types[t as usize].a as usize]).node, 0, pcx);
        }
    }
}

// The front end, up to the checked program, for `target` (0: the host);
// an error that would end the compilation jumps back to the caller's
// ERR_BAIL.
pub fn front_end(root: *mut u8, target0: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) {
    let mut t = timer_now(pcx);
    pcx.err_kind = c"tokenizer error";
    let mut paths = cptrs(1i64);
    (paths[0]) = root;
    load_sources(paths.as_mut_ptr(), 1, pcx);
    init_lexer(pcx);
    lex_range(pcx.files[0].start, pcx.files[0].end, false, pcx);
    pcx.err_kind = c"module error";
    load_modules(pcx);
    pcx.err_kind = c"tokenizer error";
    let mut target = target0;
    if target == 0 {
        target = host_target();
    }
    if target == 0 {
        target = T_X86_64_LINUX;
    }
    set_target(target, pcx);
    import_c_headers(target, tcx.c_include_dirs.as_slice(), false, c"", pcx);
    lex_range(pcx.files[(pcx.files.len() as i64 - 1) as usize].end,
        pcx.files[(pcx.files.len() as i64 - 1) as usize].end, true, pcx);
    timer_add(T_LOAD, t, pcx);
    t = timer_now(pcx);
    init_ast(pcx);
    pcx.err_kind = c"parser error";
    let program = parse_program(pcx);
    if pcx.keep_parsed {
        keep_parsed(pcx);
    }
    if pcx.imported_start >= 0 {
        drop_shadowed_imports(program, pcx);
    }
    collect_defs(program, tcx, pcx);
    collect_derive_spans(program, tcx, pcx);
    tcx.parsed = true;
    timer_add(T_PARSE, t, pcx);
    t = timer_now(pcx);
    pcx.main_sym = intern_c(c"main", pcx);
    init_types(pcx);
    init_declarations(pcx);
    pcx.err_kind = c"type error";
    check_program(program, pcx, wgx);
    timer_add(T_CHECK, t, pcx);
}

// Reads the program of `root` for a question or a change (0.11): its front
// end, as far as it gets (its errors are recorded, never printed), then
// the paths and positions of its definitions; the hooks note what they
// resolve (refs). Whether the program was parsed: when not, there is
// nothing to answer with.
pub fn load_program(root: *mut u8, target: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> bool {
    // UNSAFE: the front end's fatal errors return through setjmp/longjmp (a
    // C call) to the block pcx.err_bail names.
    // SAFETY: the jmp_buf is a new block of 512 bytes, more than a jmp_buf
    // on the targets vole builds for, set before front_end runs and taken
    // away after; no local of this frame changes between the two returns.
    unsafe {
        pcx.query = true;
        pcx.err_bail = alloc_zeroed(512);
        if _setjmp(pcx.err_bail) == 0 {
            front_end(root, target, tcx, pcx, wgx);
        }
        pcx.recover_depth = 0;
        pcx.err_bail = 0 as *mut u8;
        pcx.query = false;
        if !tcx.parsed {
            return false;
        }
        index_program(tcx, pcx);
        true
    }
}

// The paths and positions of the definitions of the program just read
// (after its front end).
pub fn index_program(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let t = timer_now(pcx);
    init_positions(tcx, pcx);
    finish_defs(tcx, pcx);
    init_containers(tcx, pcx);
    timer_add(T_INDEX, t, pcx);
}
