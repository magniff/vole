// The tools' cache (0.13): what the queries take from a program's front
// end (its files, symbols, modules, definitions, positions, errors and,
// apart, every reference), on disk, so that a question about a program
// that has not changed reads its files and the cache, and neither lexes,
// parses nor checks it.
//
// The cache of a program is target/volec-cache/q-KEY.bin (and
// q-KEY.refs), KEY a hash of the root as given, the current directory,
// the target and the compiler as it was run (0.25.3: the name the errors'
// `try:` lines print); $VOLE_CACHE names another directory, or `off`.
// Without $VOLE_CACHE and a ./target directory there is none.
//
// It holds for the compiler that wrote it (a hash of its executable) and
// for the files it was made from: every file is read again and the hash
// of their text compared, and the module files that were looked for and
// not found must still not exist. Then the program's tables are restored
// as the front end left them (RESTORED), the few things the answers would
// take from the nodes and tokens precomputed (the C_* tables), and the
// answers are the same code as without the cache, byte for byte.
//
// A command that read the program in full writes the cache afterwards (a
// new file, renamed over the old one), when the program was parsed and
// imports no C header (the headers' text is not a file of the program).

use crate::base::{
    BUFS, IntVec, SRC, buf_byte, buf_bytes, buf_new, buf_reserve, buf_slice, buf_str, fclose, fopen,
    fwrite, memcpy, memset, restore_sources, restore_sym, strlen, sym_hash, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{diag_records, diag_restore};
use crate::base::timer::{T_CACHE, timer_add, timer_now};
use crate::front::embed::{embed_count, embed_path_at, read_embedded};
use crate::front::lexer::init_lexer;
use crate::front::modules::{add_module, init_modules, module_count};
use crate::front::modules::lookup::{restore_std_keys, std_item_keys};
use crate::tools::ctx::Tcx;
use crate::tools::edit::items::{item_head, item_tail, keyword_head};
use crate::tools::proc::{
    fork_worker, make_dirs, read_file_if, remove_file, rename_file, worker_exit, write_file_if,
};
use crate::tools::query::QF_USE;
use crate::tools::query::defs::{Def, K_IMPL_METHOD, K_METHOD, def_of_node, restore_def, trait_of};
use crate::tools::query::effects::cache_texts;
use crate::tools::query::refs::collect_all_refs;
use crate::tools::query::sections::code_start;
use crate::tools::query::show::{impl_block, impl_header_span, signature_end};
use crate::tools::query::values::own_cache_texts;

extern "C" {
    fn getenv(name: *u8) -> *u8;
    fn getcwd(buf: *u8, size: u64) -> *u8;
    fn getpid() -> i32;
    fn access(path: *u8, mode: i32) -> i32;
    // (open is variadic in C: called with no mode, so never to create)
    fn open(path: *u8, flags: i32) -> i32;
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
    fn close(fd: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn setsid() -> i32;
}

// "tachyonq", and the version of the format.
const MAGIC: i64 = 8174034211981648244;
// (6, 0.17: the kinds and view summaries; 7, 0.19: the features; 9,
// 0.25.3: std_item_key's answers; 10, 0.26.2: a file's kind)
const VERSION: i64 = 10;

// ---- Words ----

// The cache files are 8-byte words; a string is its length, then its
// bytes and a NUL, padded to a word.

fn put(b: i64, v: i64) {
    unsafe {
        buf_reserve(b, 8);
        let p = (&BUFS[b].data[BUFS[b].len]) as *i64;
        p[0] = v;
        BUFS[b].len += 8;
    }
}

fn put_str(b: i64, s: [u8]) {
    unsafe {
        let n = s.len as i64;
        put(b, n);
        let words = (n + 8) / 8;
        buf_reserve(b, words * 8);
        let dst = &BUFS[b].data[BUFS[b].len];
        memset(dst, 0, (words * 8) as u64);
        if n > 0 {
            memcpy(dst, s.ptr, n as u64);
        }
        BUFS[b].len += words * 8;
    }
}

fn put_cstr(b: i64, s: *u8) {
    unsafe { put_str(b, s[0..strlen(s) as i64]); }
}

fn read_words(b: i64, tcx: inout Tcx<Comp>) {
    unsafe {
        tcx.rd = BUFS[b].data as *i64;
        tcx.rd_at = 0;
        tcx.rd_n = BUFS[b].len / 8;
        tcx.rd_bad = BUFS[b].len % 8 != 0;
    }
}

fn get(tcx: inout Tcx<Comp>) -> i64 {
    unsafe {
        if tcx.rd_at >= tcx.rd_n {
            tcx.rd_bad = true;
            return 0;
        }
        let v = tcx.rd[tcx.rd_at];
        tcx.rd_at += 1;
        v
    }
}

// A count of at most `per`-word records that fit in what is left.
fn get_count(per: i64, tcx: inout Tcx<Comp>) -> i64 {
    let n = get(&tcx);
    if n < 0 || n * per > tcx.rd_n - tcx.rd_at {
        tcx.rd_bad = true;
        return 0;
    }
    n
}

fn get_str(tcx: inout Tcx<Comp>) -> [u8] {
    unsafe {
        let n = get(&tcx);
        let words = (n + 8) / 8;
        if n < 0 || words > tcx.rd_n - tcx.rd_at {
            tcx.rd_bad = true;
            let none = c"";
            return none[0..0];
        }
        let p = (&tcx.rd[tcx.rd_at]) as *u8;
        tcx.rd_at += words;
        p[0..n]
    }
}

fn same(a: [u8], b: [u8]) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// ---- Hashes ----

fn mix(h: u64, x: u64) -> u64 {
    let v = (h ^ x).wrapping_mul(11400714819323198485);
    v ^ (v >> 29)
}

// The hash of n bytes at p (8-aligned): by words, then the last bytes.
fn hash_region(p: *u8, n: i64) -> u64 {
    unsafe {
        let w = p as *u64;
        let k = n / 8;
        var h: u64 = mix(0, n as u64);
        for i in 0..k {
            h = mix(h, w[i]);
        }
        var t: u64 = 0;
        for i in k * 8..n {
            t = (t << 8) | p[i] as u64;
        }
        mix(h, t)
    }
}

// (0.25.3) The hash of embedded file `path`'s bytes (include_str,
// include_bytes; a NUL after the path), -1 when it cannot be read.
fn embedded_hash(path: [u8], pcx: Ctx<Comp>) -> i64 {
    let b = buf_new();
    if !read_embedded(path, b, pcx) {
        return -1;
    }
    let text = buf_slice(b);
    (hash_region(text.ptr, text.len as i64) >> 1) as i64
}

// The hash of buffer b's words from word `from` on (a cache file's body:
// a file that is not as written is not read).
fn body_hash(b: i64, from: i64) -> i64 {
    unsafe {
        if BUFS[b].len < from * 8 {
            return -1;
        }
        (hash_region(&BUFS[b].data[from * 8], BUFS[b].len - from * 8) >> 1) as i64
    }
}

pub fn ident(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.ident >= 0 {
            return pcx.ident;
        }
        pcx.ident = 0;
        var slash = false;
        var i = 0;
        while pcx.prog != 0 as *u8 && pcx.prog[i] != 0 {
            slash = slash || pcx.prog[i] == '/';
            i += 1;
        }
        // (0.25.3: `volec` run from $PATH, without a `/`, is the file the
        // shell found; it had no cache before)
        var exe = pcx.prog;
        if !slash && pcx.prog != 0 as *u8 {
            exe = crate::tools::proc::find_in_path(pcx.prog[0..i], pcx);
        }
        let b = buf_new();
        if exe != 0 as *u8 && read_file_if(exe, b) {
            pcx.ident = (hash_region(BUFS[b].data, BUFS[b].len) >> 1) as i64;
            if pcx.ident == 0 {
                pcx.ident = 1;
            }
        }
        pcx.ident
    }
}

// ---- Where ----

// The cache directory, or 0: none.
pub fn cache_dir(pcx: inout Ctx<Comp>) -> *u8 {
    unsafe {
        if pcx.dir != 0 as *u8 {
            return pcx.dir;
        }
        let env = getenv(c"VOLE_CACHE");
        if env != 0 as *u8 {
            if env[0] == 0 || (env[0] == 'o' && env[1] == 'f' && env[2] == 'f' && env[3] == 0) {
                return 0 as *u8;
            }
            pcx.dir = env;
        } else if access(c"target/.", 0) == 0 {
            pcx.dir = c"target/volec-cache";
        }
        pcx.dir
    }
}

// (0.25.4) Where the cache is when the environment names none ($VOLE_CACHE
// unset, no ./target): `volec run`'s, so that its builds have the code
// cache wherever they run. $VOLE_CACHE=off keeps it off.
pub fn cache_dir_or(dir: *u8, pcx: inout Ctx<Comp>) -> *u8 {
    let have = cache_dir(&pcx);
    if have != 0 as *u8 {
        return have;
    }
    // UNSAFE: getenv is C's (the compiler has no std allocator for env).
    // SAFETY: a NUL-terminated literal's name; only compared to null.
    let env = unsafe { getenv(c"VOLE_CACHE") };
    if env == 0 as *u8 {
        pcx.dir = dir;
    }
    dir
}

fn cwd() -> *u8 {
    unsafe {
        let b = buf_new();
        buf_reserve(b, 4096);
        if getcwd(BUFS[b].data, 4096) == 0 as *u8 {
            BUFS[b].data[0] = 0;
        }
        BUFS[b].data
    }
}

// The cache's file for root and target, with suffix `ext`.
fn cache_file(root: *u8, target: i64, ext: *u8, pcx: inout Ctx<Comp>) -> *u8 {
    unsafe {
        let k = buf_new();
        put_cstr(k, root);
        put_cstr(k, cwd());
        put(k, target);
        // (0.17: the own pass's mode decides the errors: --values)
        put(k, pcx.own_mode);
        // (0.27.0: and the edition given, `--edition rust`)
        put(k, pcx.edition);
        // (0.25.3: and the compiler as it was run, which the errors' `try:`
        // lines kept in the cache name: `target/volec check`, then `volec
        // edit ...` from $PATH, read them as other errors, new ones, and
        // refused the edit; `volec check` printed `try: target/volec ...`)
        put_cstr(k, if pcx.diag_prog == 0 as *u8 { c"volec" } else { pcx.diag_prog });
        let h = hash_region(BUFS[k].data, BUFS[k].len);
        let out = buf_new();
        buf_str(out, cache_dir(&pcx));
        buf_str(out, c"/q-");
        for i in 0..16 {
            let d = ((h >> ((15 - i) * 4) as u64) & 15) as u8;
            buf_byte(out, if d < 10 { '0' + d } else { 'a' + d - 10 });
        }
        buf_str(out, ext);
        buf_byte(out, 0);
        BUFS[out].data
    }
}

// Whether the cache can be used at all: a directory, and the compiler
// found. Not with the places IR's options (0.26.0): what they print and
// check is made by checking, which a cached answer skips.
fn usable(pcx: inout Ctx<Comp>) -> bool {
    cache_dir(&pcx) != 0 as *u8 && ident(&pcx) != 0 && !crate::places::places_enabled(pcx)
}

// Whether a command that reads a program in full should make its cache.
pub fn cache_on(pcx: inout Ctx<Comp>) -> bool {
    usable(&pcx)
}

// ---- Reading ----

// Reads file `path` into dst: exactly n bytes (dst has room for one more),
// or false.
fn read_exact(path: *u8, dst: *u8, n: i64) -> bool {
    unsafe {
        let fd = open(path, 0);
        if fd < 0 {
            return false;
        }
        var got = 0;
        while got <= n {
            let k = read(fd, &dst[got], (n + 1 - got) as u64);
            if k <= 0 {
                break;
            }
            got += k;
        }
        close(fd);
        got == n
    }
}

// The program of root, from the cache, when it holds for it (and, with
// `refs`, its references too): whether it was restored. Nothing is
// changed when it was not.
//
// The cache is q-KEY.bin, or else q-KEY.next.bin: what the check of an
// edit (`check --overlay`) made of the edited program, which holds once
// the edit is written (it is then renamed the cache), and else is removed.
pub fn cache_restore(root: *u8, target: i64, refs: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    let t = timer_now(pcx);
    var ok = restore(root, target, refs, false, &tcx, &pcx);
    if !ok && usable(&pcx) {
        let next_bin = cache_file(root, target, c".next.bin", &pcx);
        let next_refs = cache_file(root, target, c".next.refs", &pcx);
        ok = restore(root, target, refs, true, &tcx, &pcx);
        if ok {
            rename_file(next_refs, cache_file(root, target, c".refs", &pcx));
            rename_file(next_bin, cache_file(root, target, c".bin", &pcx));
        } else {
            remove_file(next_bin);
            remove_file(next_refs);
        }
    }
    if usable(&pcx) {
        trace(if ok { c"hit" } else { c"miss" });
    }
    timer_add(T_CACHE, t, pcx);
    ok
}

// With $VOLE_CACHE_TRACE (a file), a line per use of the cache: `hit`,
// `miss` or `save` (tests/query/run.sh: what saved is then a hit).
fn trace(word: *u8) {
    unsafe {
        let path = getenv(c"VOLE_CACHE_TRACE");
        if path == 0 as *u8 {
            return;
        }
        let file = fopen(path, c"a");
        if file != 0 as *u8 {
            fwrite(word, 1, strlen(word), file);
            fwrite(c"\n", 1, 1, file);
            fclose(file);
        }
    }
}

fn restore(root: *u8, target: i64, refs: bool, next: bool, tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        if !usable(&pcx) || pcx.syms.len() != 0 || pcx.overlay.count > 0
            || pcx.std_tree != 0 as *u8 {
            return false;
        }
        let b = buf_new();
        if !read_file_if(cache_file(root, target, if next { c".next.bin" } else { c".bin" }, &pcx),
            b) {
            return false;
        }
        read_words(b, &tcx);
        if get(&tcx) != MAGIC || get(&tcx) != VERSION || get(&tcx) != ident(&pcx)
            || get(&tcx) != tcx.rd_n
            || get(&tcx) != body_hash(b, 5) {
            return false;
        }
        if !same(get_str(&tcx), root[0..strlen(root) as i64]) || get(&tcx) != target {
            return false;
        }
        let stamp = get(&tcx);
        let src_len = get(&tcx);
        let n_files = get_count(7, &tcx);
        if tcx.rd_bad || src_len < 0 || src_len > 1 << 40 {
            return false;
        }
        // The files, read again where they were.
        let all = buf_new();
        buf_reserve(all, src_len + 16);
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var at = 0;
        for _ in 0..n_files {
            let path = get_str(&tcx);
            let start = get(&tcx);
            let end = get(&tcx);
            let module = get(&tcx);
            let kind = get(&tcx);
            let made = get(&tcx);
            if tcx.rd_bad || start != at || end < start || end >= src_len {
                return false;
            }
            let dst = &BUFS[all].data[start];
            if made != 0 {
                let text = get_str(&tcx);
                if tcx.rd_bad || text.len as i64 != end - start {
                    return false;
                }
                memcpy(dst, text.ptr, text.len as u64);
            } else if !read_exact(path.ptr, dst, end - start) {
                return false;
            }
            BUFS[all].data[end] = '\n';
            at = end + 1;
            files.push(path.ptr as i64);
            files.push(start);
            files.push(end);
            files.push(module);
            files.push(kind);
        }
        if at != src_len {
            return false;
        }
        BUFS[all].data[at] = 0;
        BUFS[all].len = at + 1;
        if (hash_region(BUFS[all].data, src_len) >> 1) as i64 != stamp {
            return false;
        }
        let n_probes = get_count(1, &tcx);
        for _ in 0..n_probes {
            let path = get_str(&tcx);
            if tcx.rd_bad || access(path.ptr, 0) == 0 {
                return false;
            }
        }
        let n_embeds = get_count(2, &tcx);
        for _ in 0..n_embeds {
            let path = get_str(&tcx);
            if tcx.rd_bad || get(&tcx) != embedded_hash(path, pcx) {
                return false;
            }
        }
        var words = 0 as *i64;
        var n_refs = 0;
        if refs {
            let r = buf_new();
            if !read_file_if(cache_file(root, target, if next { c".next.refs" } else { c".refs" },
                &pcx),
                r)
                || BUFS[r].len % 8 != 0 || BUFS[r].len < 40 {
                return false;
            }
            words = BUFS[r].data as *i64;
            n_refs = BUFS[r].len / 8 - 5;
            if words[0] != MAGIC || words[1] != ident(&pcx) || words[2] != stamp
                || words[3] != n_refs
                || words[4] != body_hash(r, 5) {
                return false;
            }
        }
        if tcx.rd_bad {
            return false;
        }
        // It holds: the tables, as the front end left them.
        restore_sources(all, files, &pcx);
        restore_tables(&tcx, &pcx);
        // (the lexer as the front end left it: its keywords, for what
        // lexes a text again, the layout of an edit)
        init_lexer(&pcx);
        if tcx.rd_bad {
            crate::base::die(c"the tools' cache is damaged; remove target/volec-cache");
        }
        if refs {
            tcx.c_refs = &words[5];
            tcx.c_ref_count = n_refs;
        }
        tcx.parsed = true;
        tcx.restored = true;
        true
    }
}

fn get_ints(v: inout IntVec, tcx: inout Tcx<Comp>) {
    let n = get_count(1, &tcx);
    for _ in 0..n {
        v.push(get(&tcx));
    }
}

fn restore_tables(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let n_syms = get_count(2, &tcx);
        for _ in 0..n_syms {
            let h = get(&tcx) as u64;
            restore_sym(get_str(&tcx), h, &pcx);
        }
        let n_modules = get_count(4, &tcx);
        init_modules(&pcx);
        for m in 0..n_modules {
            let name = get(&tcx);
            let parent = get(&tcx);
            let public = get(&tcx) != 0;
            let is_c = get(&tcx) != 0;
            if m > 0 {
                add_module(name, parent, public, &pcx);
            }
            pcx.modules[m].is_c = is_c;
        }
        pcx.std_module = get(&tcx);
        pcx.c_module = get(&tcx);
        get_ints(&pcx.inline_mods, &tcx);
        let n_defs = get_count(26, &tcx);
        tcx.c_eff_buf = buf_new();
        tcx.c_own_buf = buf_new();
        for _ in 0..n_defs {
            let def = Def {
                node: get(&tcx), kind: get(&tcx), name: get(&tcx), module: get(&tcx),
                parent: get(&tcx), start: get(&tcx),
                end: get(&tcx), name_pos: get(&tcx), public: get(&tcx) != 0, impl_node: get(&tcx),
                fqn: get(&tcx),
                path: get(&tcx), owner: get(&tcx), tr: get(&tcx),
            };
            restore_def(def, &pcx);
            let tcx_arg = get(&tcx);
            tcx.c_sig_end.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_trait.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_block.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_hdr_from.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_hdr_to.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_head.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_tail.push(tcx_arg);
            let tcx_arg = get(&tcx);
            tcx.c_keyword.push(tcx_arg);
            for _ in 0..3 {
                let text = get_str(&tcx);
                tcx.c_eff_text.push(buf_slice(tcx.c_eff_buf).len as i64);
                buf_bytes(tcx.c_eff_buf, text);
                tcx.c_eff_text.push(buf_slice(tcx.c_eff_buf).len as i64);
            }
            for _ in 0..2 {
                let text = get_str(&tcx);
                tcx.c_own_text.push(buf_slice(tcx.c_own_buf).len as i64);
                buf_bytes(tcx.c_own_buf, text);
                tcx.c_own_text.push(buf_slice(tcx.c_own_buf).len as i64);
            }
        }
        get_ints(&pcx.mod_def, &tcx);
        var aliases = tcx.aliases;
        get_ints(&aliases, &tcx);
        tcx.aliases = aliases;
        tcx.c_alias = get(&tcx);
        tcx.c_alias_module = get(&tcx);
        get_ints(&pcx.notes, &tcx);
        get_ints(&pcx.lines, &tcx);
        var file_rank = tcx.file_rank;
        get_ints(&file_rank, &tcx);
        tcx.file_rank = file_rank;
        var containers = tcx.containers;
        get_ints(&containers, &tcx);
        tcx.containers = containers;
        var c_code_start = tcx.c_code_start;
        get_ints(&c_code_start, &tcx);
        tcx.c_code_start = c_code_start;
        let error_count = get(&tcx);
        var errors = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var warnings = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let n_errors = get_count(2, &tcx);
        for _ in 0..n_errors {
            errors.push(get(&tcx));
            errors.push(text_buf(get_str(&tcx)));
        }
        let n_warnings = get_count(3, &tcx);
        for _ in 0..n_warnings {
            warnings.push(get(&tcx));
            warnings.push(text_buf(get_str(&tcx)));
            warnings.push(get(&tcx));
        }
        diag_restore(&errors, &warnings, error_count, &pcx);
        // (0.25.3) std_item_key's answers, symbols both (a pair naming no item
        // is none)
        var std_keys = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let n_std = get_count(2, &tcx);
        for _ in 0..n_std {
            let s = get(&tcx);
            let k = get(&tcx);
            if s < 0 || s >= n_syms || k >= n_syms {
                tcx.rd_bad = true;
            } else if k >= 0 {
                std_keys.push(s);
                std_keys.push(k);
            }
        }
        restore_std_keys(std_keys, &pcx);
    }
}

fn text_buf(s: [u8]) -> i64 {
    let b = buf_new();
    crate::base::buf_bytes(b, s);
    b
}

// The references of collect_refs, from the cache: those to the
// definitions of GROUP.
pub fn cached_refs(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let group = crate::base::alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        for d in 0..pcx.defs.len() as i64 {
            group[d] = tcx.refs_group.get(d + 1) - 1;
        }
        for i in 0..tcx.c_ref_count {
            let w = tcx.c_refs[i];
            let d = (w & 4294967295) >> 6;
            if d >= pcx.defs.len() as i64 || group[d] < 0 {
                continue;
            }
            tcx.r_pos.push(w >> 32);
            tcx.r_def.push(d);
            tcx.r_group.push(group[d]);
            tcx.r_flags.push(w & 63);
        }
    }
}

// ---- Writing ----

// Writes the cache of the program just read in full (its front end, the
// paths and positions of its definitions), for root and target. Nothing
// when there is no cache or the program cannot be cached.
//
// The answer is out by then: a copy of the process (fork) writes the cache
// while this one ends, its output to /dev/null. Here instead with
// --time-passes and $VOLE_CACHE_TRACE (the tests: the next command
// must find it).
pub fn cache_save(root: *u8, target: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        if tcx.restored || !tcx.parsed || pcx.imported_start >= 0 || !usable(&pcx) {
            return;
        }
        if !pcx.time_passes && getenv(c"VOLE_CACHE_TRACE") == 0 as *u8 {
            let pid = fork_worker();
            if pid > 0 {
                return;
            }
            if pid == 0 {
                // (a session of its own: not ended with the caller's group)
                setsid();
                let null = open(c"/dev/null", 1);
                if null >= 0 {
                    dup2(null, 1);
                    dup2(null, 2);
                }
                save(root, target, &tcx, &pcx);
                worker_exit(0);
            }
        }
        let t = timer_now(pcx);
        save(root, target, &tcx, &pcx);
        timer_add(T_CACHE, t, pcx);
    }
}

fn put_ints(b: i64, v: IntVec) {
    unsafe {
        put(b, v.count);
        for i in 0..v.count {
            put(b, v.data[i]);
        }
    }
}

// Writes buffer b to `path`, through a new file renamed over it.
fn write_atomic(b: i64, path: *u8) -> bool {
    unsafe {
        let tmp = buf_new();
        buf_str(tmp, path);
        buf_str(tmp, c".tmp");
        crate::base::buf_int(tmp, getpid() as i64);
        buf_byte(tmp, 0);
        if !write_file_if(BUFS[tmp].data, buf_slice(b)) {
            crate::tools::proc::remove_file(BUFS[tmp].data);
            return false;
        }
        rename_file(BUFS[tmp].data, path)
    }
}

fn save(root: *u8, target: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.files.len() == 0 || pcx.std_tree != 0 as *u8
            || !make_dirs(cache_dir(&pcx)) {
            return;
        }
        // (with --overlay, the edited program: its cache for after the edit)
        let next = pcx.overlay.count > 0;
        let src_len = pcx.files[pcx.files.len() as i64 - 1].end + 1;
        let stamp = (hash_region(SRC.ptr, src_len) >> 1) as i64;
        // The references, apart (only refs and callers read them).
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        collect_all_refs(&all, &tcx, pcx);
        let r = buf_new();
        put(r, MAGIC);
        put(r, ident(&pcx));
        put(r, stamp);
        put(r, all.count / 3);
        put(r, 0);
        var i = 0;
        while i < all.count {
            put(r, (all.data[i] << 32) | (all.data[i + 1] << 6) | (all.data[i + 2] & 63));
            i += 3;
        }
        let refs_header = BUFS[r].data as *i64;
        refs_header[4] = body_hash(r, 5);
        if !write_atomic(r,
            cache_file(root, target, if next { c".next.refs" } else { c".refs" }, &pcx)) {
            return;
        }
        let b = buf_new();
        put(b, MAGIC);
        put(b, VERSION);
        put(b, ident(&pcx));
        put(b, 0);
        put(b, 0);
        put_cstr(b, root);
        put(b, target);
        put(b, stamp);
        put(b, src_len);
        put(b, pcx.files.len() as i64);
        for f in 0..pcx.files.len() {
            let path = pcx.files[f].path;
            put_cstr(b, path);
            put(b, pcx.files[f].start);
            put(b, pcx.files[f].end);
            put(b, pcx.files[f].module);
            put(b, pcx.files[f].kind);
            let made = path[0] == '<';
            put(b, if made { 1 } else { 0 });
            if made {
                put_str(b, SRC[pcx.files[f].start..pcx.files[f].end]);
            }
        }
        put(b, pcx.module_probes.count);
        for k in 0..pcx.module_probes.count {
            put_cstr(b, pcx.module_probes.data[k] as *u8);
        }
        // (0.25.3) the embedded files, each with the hash of its bytes
        put(b, embed_count(pcx));
        for k in 0..embed_count(pcx) {
            let path = embed_path_at(k, pcx);
            put_str(b, path);
            put(b, embedded_hash(path, pcx));
        }
        save_tables(b, tcx, &pcx);
        // (the number of words, in the header)
        let header = BUFS[b].data as *i64;
        header[3] = BUFS[b].len / 8;
        header[4] = body_hash(b, 5);
        if write_atomic(b,
            cache_file(root, target, if next { c".next.bin" } else { c".bin" }, &pcx)) {
            trace(c"save");
        }
    }
}

fn save_tables(b: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let n_syms = pcx.syms.len() as i64;
        put(b, n_syms);
        for s in 0..n_syms {
            put(b, sym_hash(s, pcx) as i64);
            put_str(b, sym_text(s, pcx));
        }
        put(b, module_count(pcx));
        for m in 0..module_count(pcx) {
            put(b, pcx.modules[m].name);
            put(b, pcx.modules[m].parent);
            put(b, if pcx.modules[m].public { 1 } else { 0 });
            put(b, if pcx.modules[m].is_c { 1 } else { 0 });
        }
        put(b, pcx.std_module);
        put(b, pcx.c_module);
        put_ints(b, pcx.inline_mods);
        put(b, pcx.defs.len() as i64);
        for d in 0..pcx.defs.len() as i64 {
            let x = pcx.defs[d];
            put(b, d + 1);
            put(b, x.kind);
            put(b, x.name);
            put(b, x.module);
            put(b, x.parent);
            put(b, x.start);
            put(b, x.end);
            put(b, x.name_pos);
            put(b, if x.public { 1 } else { 0 });
            put(b, x.impl_node);
            put(b, x.fqn);
            put(b, x.path);
            put(b, x.owner);
            put(b, x.tr);
            put(b, signature_end(d, tcx, pcx));
            put(b, trait_of(d, tcx, pcx));
            let method = x.kind == K_METHOD || x.kind == K_IMPL_METHOD;
            put(b, if method { impl_block(d, tcx, pcx) } else { 0 });
            var to = 0;
            let from = if method { impl_header_span(d, &to, tcx, pcx) } else { 0 };
            put(b, from);
            put(b, to);
            put(b, item_head(d, tcx, pcx));
            put(b, item_tail(d, tcx, pcx));
            put(b, keyword_head(d, tcx, pcx));
            // (0.16: the effects def, show and `query effects` print)
            let set = buf_new();
            let lines = buf_new();
            cache_texts(d, set, lines, tcx, pcx);
            put_str(b, buf_slice(set));
            put_str(b, buf_slice(lines));
            // (0.19: what it needs beyond the build's features)
            let feats = buf_new();
            crate::tools::query::features::def_features_text(feats, d, tcx, pcx);
            put_str(b, buf_slice(feats));
            // (0.17: the kind and the view summary, tools/query/values)
            let kind = buf_new();
            let views = buf_new();
            own_cache_texts(d, kind, views, tcx, &pcx);
            put_str(b, buf_slice(kind));
            put_str(b, buf_slice(views));
        }
        put_ints(b, pcx.mod_def);
        put_ints(b, tcx.aliases);
        put(b, tcx.c_alias);
        put(b, tcx.c_alias_module);
        // The notes of the imports that give another name (query.alias):
        // the definition + 1 in place of its node (def_of_node).
        var notes = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var k = 0;
        while k < pcx.notes.count {
            if (pcx.notes.data[k + 3] & QF_USE) != 0 && is_alias_at(pcx.notes.data[k], tcx) {
                let d = def_of_node(pcx.notes.data[k + 2], tcx, pcx);
                if d >= 0 {
                    notes.push(pcx.notes.data[k]);
                    notes.push(pcx.notes.data[k + 1]);
                    notes.push(d + 1);
                    notes.push(pcx.notes.data[k + 3]);
                }
            }
            k += 4;
        }
        put_ints(b, notes);
        put_ints(b, pcx.lines);
        put_ints(b, tcx.file_rank);
        put_ints(b, tcx.containers);
        put(b, pcx.files.len() as i64);
        for f in 0..pcx.files.len() as i64 {
            put(b, code_start(f, tcx, pcx));
        }
        var errors = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var warnings = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let error_count = diag_records(&errors, &warnings, &pcx);
        put(b, error_count);
        put(b, errors.count / 2);
        var e = 0;
        while e < errors.count {
            put(b, errors.data[e]);
            put_str(b, buf_slice(errors.data[e + 1]));
            e += 2;
        }
        put(b, warnings.count / 3);
        var w = 0;
        while w < warnings.count {
            put(b, warnings.data[w]);
            put_str(b, buf_slice(warnings.data[w + 1]));
            put(b, warnings.data[w + 2]);
            w += 3;
        }
        // (0.25.3) What `std::NAME` names, for each symbol (std_item_key:
        // the restored program has no scopes to ask). Last: what asking
        // does to the tables is not in what was written above.
        var std_keys = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        std_item_keys(n_syms, &std_keys, &pcx);
        put(b, std_keys.count / 2);
        var p = 0;
        while p + 1 < std_keys.count {
            put(b, std_keys.get(p));
            put(b, if std_keys.get(p + 1) < n_syms { std_keys.get(p + 1) } else { -1 });
            p += 2;
        }
    }
}

fn is_alias_at(pos: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        var i = 0;
        while i < tcx.aliases.count {
            if tcx.aliases.data[i + 1] == pos {
                return true;
            }
            i += 2;
        }
        false
    }
}
