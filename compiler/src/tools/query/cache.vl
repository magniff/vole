// The tools' cache (0.13): what the queries take from a program's front
// end (its files, symbols, modules, definitions, positions, errors and,
// apart, every reference), on disk, so that a question about a program
// that has not changed reads its files and the cache, and neither lexes,
// parses nor checks it.
//
// The cache of a program is target/volec-cache/q-KEY.bin (and
// q-KEY.refs), KEY a hash of the root as given, the current directory,
// the target and the compiler as it was run (0.25.3: the name the errors'
// `try:` lines print); $VOLE_CACHE names another directory, or `off`.
// Without $VOLE_CACHE and a ./target directory there is none.
//
// It holds for the compiler that wrote it (a hash of its executable) and
// for the files it was made from: every file is read again and the hash
// of their text compared, and the module files that were looked for and
// not found must still not exist. Then the program's tables are restored
// as the front end left them (RESTORED), the few things the answers would
// take from the nodes and tokens precomputed (the C_* tables), and the
// answers are the same code as without the cache, byte for byte.
//
// A command that read the program in full writes the cache afterwards (a
// new file, renamed over the old one), when the program was parsed and
// imports no C header (the headers' text is not a file of the program).
//
// (0.28.0) The directory is bounded: a .bin's header has its time of last
// use (a hit writes it), and whoever writes a cache then reads the
// directory and, while its q-KEY.* files pass 1 GB ($VOLE_CACHE_LIMIT, in
// MB), removes the program least recently used (evict, at the end). A
// command that only reads never reads the directory. The code cache's
// packs have the same limit apart (back/codecache/pack.vl); the borrow
// checker's bck-*.bin is one file of a few KB per compiler and std.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_freeze, buf_new, buf_reserve, buf_slice, buf_str, fclose,
    fopen, fwrite, get_bufs, get_src, memcpy, memset, restore_sources, restore_sym, strlen,
    sym_hash, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{diag_records, diag_restore};
use crate::base::timer::{T_CACHE, timer_add, timer_now};
use crate::front::embed::{embed_count, embed_path_at, read_embedded};
use crate::front::lexer::init_lexer;
use crate::front::modules::{add_module, init_modules, module_count};
use crate::front::modules::lookup::{restore_std_keys, std_item_keys};
use crate::tools::ctx::Tcx;
use crate::tools::edit::items::{item_head, item_tail, keyword_head};
use crate::tools::proc::{
    fork_worker, make_dirs, read_file_if, remove_file, rename_file, worker_exit, write_file_if,
};
use crate::tools::query::QF_USE;
use crate::tools::query::defs::{Def, K_IMPL_METHOD, K_METHOD, def_of_node, restore_def, trait_of};
use crate::tools::query::effects::cache_texts;
use crate::tools::query::refs::collect_all_refs;
use crate::tools::query::sections::code_start;
use crate::tools::query::show::{impl_block, impl_header_span, signature_end};

extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
    fn getcwd(buf: *mut u8, size: u64) -> *mut u8;
    fn getpid() -> i32;
    fn access(path: *mut u8, mode: i32) -> i32;
    // (open is variadic in C: called with no mode, so never to create)
    fn open(path: *mut u8, flags: i32) -> i32;
    fn read(fd: i32, buf: *mut u8, n: u64) -> i64;
    fn close(fd: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn setsid() -> i32;
}

// "tachyonq", and the version of the format.
const MAGIC: i64 = 8174034211981648244;
// (6, 0.17: the kinds and view summaries; 7, 0.19: the features; 9,
// 0.25.3: std_item_key's answers; 10, 0.26.2: a file's kind; 11, 0.28.0:
// the time of last use, a header word)
const VERSION: i64 = 11;

// ---- Words ----

// The cache files are 8-byte words; a string is its length, then its
// bytes and a NUL, padded to a word.

fn put(b: i64, v: i64) {
    unsafe {
        buf_reserve(b, 8);
        let p = ((*get_bufs().add(b as usize)).data.add((*get_bufs().add(b as usize)).len as usize)) as *mut i64;
        (*p.add(0)) = v;
        (*get_bufs().add(b as usize)).len += 8;
    }
}

fn put_str(b: i64, s: &[u8]) {
    unsafe {
        let n = s.len() as i64;
        put(b, n);
        let words = (n + 8) / 8;
        buf_reserve(b, words * 8);
        let dst = (*get_bufs().add(b as usize)).data.add(
            (*get_bufs().add(b as usize)).len as usize);
        memset(dst, 0, (words * 8) as u64);
        if n > 0 {
            memcpy(dst, s.ptr, n as u64);
        }
        (*get_bufs().add(b as usize)).len += words * 8;
    }
}

fn put_cstr(b: i64, s: *mut u8) {
    unsafe {
        put_str(b,
            std::slice::from_raw_parts(s.add((0) as usize), (strlen(s) as i64 - (0)) as usize));
    }
}

fn read_words(b: i64, tcx: &mut Tcx<Comp>) {
    unsafe {
        tcx.rd = (*get_bufs().add(b as usize)).data as *mut i64;
        tcx.rd_at = 0;
        tcx.rd_n = (*get_bufs().add(b as usize)).len / 8;
        tcx.rd_bad = (*get_bufs().add(b as usize)).len % 8 != 0;
    }
}

fn get(tcx: &mut Tcx<Comp>) -> i64 {
    unsafe {
        if tcx.rd_at >= tcx.rd_n {
            tcx.rd_bad = true;
            return 0;
        }
        let v = (*tcx.rd.add(tcx.rd_at as usize));
        tcx.rd_at += 1;
        v
    }
}

// A count of at most `per`-word records that fit in what is left.
fn get_count(per: i64, tcx: &mut Tcx<Comp>) -> i64 {
    let n = get(tcx);
    if n < 0 || n * per > tcx.rd_n - tcx.rd_at {
        tcx.rd_bad = true;
        return 0;
    }
    n
}

fn get_str(tcx: &mut Tcx<Comp>) -> &'static [u8] {
    unsafe {
        let n = get(tcx);
        let words = (n + 8) / 8;
        if n < 0 || words > tcx.rd_n - tcx.rd_at {
            tcx.rd_bad = true;
            let none = c"";
            return std::slice::from_raw_parts(none.add((0) as usize), (0 - (0)) as usize);
        }
        let p = (tcx.rd.add(tcx.rd_at as usize)) as *mut u8;
        tcx.rd_at += words;
        std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize)
    }
}

fn same(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// ---- Hashes ----

fn mix(h: u64, x: u64) -> u64 {
    let v = (h ^ x).wrapping_mul(11400714819323198485u64);
    v ^ (v >> 29)
}

// The hash of n bytes at p (8-aligned): by words, then the last bytes.
fn hash_region(p: *mut u8, n: i64) -> u64 {
    unsafe {
        let w = p as *mut u64;
        let k = n / 8;
        let mut h: u64 = mix(0, n as u64);
        for i in 0..k {
            h = mix(h, (*w.add(i as usize)));
        }
        let mut t: u64 = 0;
        for i in k * 8..n {
            t = (t << 8) | (*p.add(i as usize)) as u64;
        }
        mix(h, t)
    }
}

// (0.25.3) The hash of embedded file `path`'s bytes (include_str,
// include_bytes; a NUL after the path), -1 when it cannot be read.
fn embedded_hash(path: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let b = buf_new();
    if !read_embedded(path, b, pcx) {
        return -1;
    }
    let text = buf_slice(b);
    (hash_region(text.ptr, text.len() as i64) >> 1) as i64
}

// The hash of buffer b's words from word `from` on (a cache file's body:
// a file that is not as written is not read).
fn body_hash(b: i64, from: i64) -> i64 {
    unsafe {
        if (*get_bufs().add(b as usize)).len < from * 8 {
            return -1;
        }
        (hash_region((*get_bufs().add(b as usize)).data.add((from * 8) as usize),
            (*get_bufs().add(b as usize)).len - from * 8) >> 1) as i64
    }
}

pub fn ident(pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.ident >= 0 {
            return pcx.ident;
        }
        pcx.ident = 0;
        let mut slash = false;
        let mut i: i64 = 0;
        while pcx.prog != 0 as *mut u8 && (*pcx.prog.add(i as usize)) != 0 {
            slash = slash || (*pcx.prog.add(i as usize)) == b'/';
            i += 1;
        }
        // (0.25.3: `volec` run from $PATH, without a `/`, is the file the
        // shell found; it had no cache before)
        let mut exe = pcx.prog;
        if !slash && pcx.prog != 0 as *mut u8 {
            exe = crate::tools::proc::find_in_path(
                std::slice::from_raw_parts(pcx.prog.add((0) as usize), (i - (0)) as usize), pcx);
        }
        let b = buf_new();
        if exe != 0 as *mut u8 && read_file_if(exe, b) {
            pcx.ident = (hash_region((*get_bufs().add(b as usize)).data,
                (*get_bufs().add(b as usize)).len) >> 1) as i64;
            if pcx.ident == 0 {
                pcx.ident = 1;
            }
        }
        pcx.ident
    }
}

// ---- Where ----

// The cache directory, or 0: none.
pub fn cache_dir(pcx: &mut Ctx<Comp>) -> *mut u8 {
    unsafe {
        if pcx.dir != 0 as *mut u8 {
            return pcx.dir;
        }
        let env = getenv(c"VOLE_CACHE");
        if env != 0 as *mut u8 {
            if (*env.add(0)) == 0
                || ((*env.add(0)) == b'o' && (*env.add(1)) == b'f' && (*env.add(2)) == b'f'
                    && (*env.add(3)) == 0) {
                return 0 as *mut u8;
            }
            pcx.dir = env;
        } else if access(c"target/.", 0) == 0 {
            pcx.dir = c"target/volec-cache";
        }
        pcx.dir
    }
}

// (0.25.4) Where the cache is when the environment names none ($VOLE_CACHE
// unset, no ./target): `volec run`'s, so that its builds have the code
// cache wherever they run. $VOLE_CACHE=off keeps it off.
pub fn cache_dir_or(dir: *mut u8, pcx: &mut Ctx<Comp>) -> *mut u8 {
    let have = cache_dir(pcx);
    if have != 0 as *mut u8 {
        return have;
    }
    // UNSAFE: getenv is C's (the compiler has no std allocator for env).
    // SAFETY: a NUL-terminated literal's name; only compared to null.
    let env = unsafe { getenv(c"VOLE_CACHE") };
    if env == 0 as *mut u8 {
        pcx.dir = dir;
    }
    dir
}

fn cwd() -> *mut u8 {
    unsafe {
        let b = buf_new();
        buf_reserve(b, 4096);
        if getcwd((*get_bufs().add(b as usize)).data, 4096) == 0 as *mut u8 {
            (*(*get_bufs().add(b as usize)).data.add(0)) = 0;
        }
        (*get_bufs().add(b as usize)).data
    }
}

// The KEY of the cache of root and target: the hash its files are named by.
fn cache_key(root: *mut u8, target: i64, pcx: &mut Ctx<Comp>) -> u64 {
    // UNSAFE: hash_region reads the key buffer's bytes by pointer.
    // SAFETY: `k` is this call's buffer; its data and len are the bytes
    // put and put_cstr appended, whole words.
    unsafe {
        let k = buf_new();
        put_cstr(k, root);
        put_cstr(k, cwd());
        put(k, target);

        // (0.25.3: and the compiler as it was run, which the errors' `try:`
        // lines kept in the cache name: `target/volec check`, then `volec
        // edit ...` from $PATH, read them as other errors, new ones, and
        // refused the edit; `volec check` printed `try: target/volec ...`)
        put_cstr(k, if pcx.diag_prog == 0 as *mut u8 { c"volec" } else { pcx.diag_prog });
        hash_region((*get_bufs().add(k as usize)).data, (*get_bufs().add(k as usize)).len)
    }
}

// The cache's file for root and target, with suffix `ext`.
fn cache_file(root: *mut u8, target: i64, ext: *mut u8, pcx: &mut Ctx<Comp>) -> *mut u8 {
    // UNSAFE: the path is a C string for fopen and rename, the bytes of a
    // base buffer (BUFS has no safe view that outlives the call).
    // SAFETY: `out` is this call's buffer, ended with a NUL; BUFS are not
    // freed, so the pointer holds for the run.
    unsafe {
        let h = cache_key(root, target, pcx);
        let out = buf_new();
        buf_str(out, cache_dir(pcx));
        buf_str(out, c"/q-");
        for i in 0..16 {
            let d = ((h >> ((15 - i) * 4) as u64) & 15) as u8;
            buf_byte(out, if d < 10 { b'0' + d } else { b'a' + d - 10 });
        }
        buf_str(out, ext);
        buf_byte(out, 0);
        (*get_bufs().add(out as usize)).data
    }
}

// Whether the cache can be used at all: a directory, and the compiler
// found. Not with the places IR's options (0.26.0): what they print and
// check is made by checking, which a cached answer skips.
fn usable(pcx: &mut Ctx<Comp>) -> bool {
    cache_dir(pcx) != 0 as *mut u8 && ident(pcx) != 0 && !crate::places::places_enabled(pcx)
}

// Whether a command that reads a program in full should make its cache.
pub fn cache_on(pcx: &mut Ctx<Comp>) -> bool {
    usable(pcx)
}

// ---- Reading ----

// Reads file `path` into dst: exactly n bytes (dst has room for one more),
// or false.
fn read_exact(path: *mut u8, dst: *mut u8, n: i64) -> bool {
    unsafe {
        let fd = open(path, 0);
        if fd < 0 {
            return false;
        }
        let mut got: i64 = 0;
        while got <= n {
            let k = read(fd, dst.add(got as usize), (n + 1 - got) as u64);
            if k <= 0 {
                break;
            }
            got += k;
        }
        close(fd);
        got == n
    }
}

// The program of root, from the cache, when it holds for it (and, with
// `refs`, its references too): whether it was restored. Nothing is
// changed when it was not.
//
// The cache is q-KEY.bin, or else q-KEY.next.bin: what the check of an
// edit (`check --overlay`) made of the edited program, which holds once
// the edit is written (it is then renamed the cache), and else is removed.
pub fn cache_restore(root: *mut u8, target: i64, refs: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let t = timer_now(pcx);
    let mut ok = restore(root, target, refs, false, tcx, pcx);
    if !ok && usable(pcx) {
        let next_bin = cache_file(root, target, c".next.bin", pcx);
        let next_refs = cache_file(root, target, c".next.refs", pcx);
        ok = restore(root, target, refs, true, tcx, pcx);
        if ok {
            rename_file(next_refs, cache_file(root, target, c".refs", pcx));
            rename_file(next_bin, cache_file(root, target, c".bin", pcx));
        } else {
            remove_file(next_bin);
            remove_file(next_refs);
        }
    }
    if usable(pcx) {
        trace(if ok { c"hit" } else { c"miss" });
    }
    timer_add(T_CACHE, t, pcx);
    ok
}

// With $VOLE_CACHE_TRACE (a file), a line per use of the cache: `hit`,
// `miss` or `save` (tests/query/run.sh: what saved is then a hit).
fn trace(word: *mut u8) {
    unsafe {
        let path = getenv(c"VOLE_CACHE_TRACE");
        if path == 0 as *mut u8 {
            return;
        }
        let file = fopen(path, c"a");
        if file != 0 as *mut u8 {
            fwrite(word, 1, strlen(word), file);
            fwrite(c"\n", 1, 1, file);
            fclose(file);
        }
    }
}

fn restore(root: *mut u8, target: i64, refs: bool, next: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if !usable(pcx) || pcx.syms.len() != 0 || pcx.overlay.len() as i64 > 0
            || pcx.std_tree != 0 as *mut u8 {
            return false;
        }
        let b = buf_new();
        let bin = cache_file(root, target, if next { c".next.bin" } else { c".bin" }, pcx);
        if !read_file_if(bin, b) {
            return false;
        }
        // (0.27.7: the read buffer is only read from here on; the files'
        // paths and the symbols' texts point into it for the process)
        buf_freeze(b);
        read_words(b, tcx);
        if get(tcx) != MAGIC || get(tcx) != VERSION || get(tcx) != ident(pcx)
            || get(tcx) != tcx.rd_n
            || get(tcx) != body_hash(b, USED_WORD + 1) {
            return false;
        }
        let used = get(tcx);
        if !same(get_str(tcx),
            std::slice::from_raw_parts(root.add((0) as usize),
                (strlen(root) as i64 - (0)) as usize)) || get(tcx) != target {
            return false;
        }
        let stamp = get(tcx);
        let src_len = get(tcx);
        let n_files = get_count(7, tcx);
        if tcx.rd_bad || src_len < 0 || src_len > 1 << 40 {
            return false;
        }
        // The files, read again where they were.
        let all = buf_new();
        buf_reserve(all, src_len + 16);
        let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut at: i64 = 0;
        for _ in 0..n_files {
            let path = get_str(tcx);
            let start = get(tcx);
            let end = get(tcx);
            let module = get(tcx);
            let kind = get(tcx);
            let made = get(tcx);
            // (0.27.6: an added file starts after the NUL that ends the
            // one before it and a newline, add_source)
            if tcx.rd_bad || start != at && start != at + 2 || end < start || end >= src_len {
                return false;
            }
            if start == at + 2 {
                (*(*get_bufs().add(all as usize)).data.add(at as usize)) = 0;
                (*(*get_bufs().add(all as usize)).data.add((at + 1) as usize)) = b'\n';
            }
            let dst = (*get_bufs().add(all as usize)).data.add(start as usize);
            if made != 0 {
                let text = get_str(tcx);
                if tcx.rd_bad || text.len() as i64 != end - start {
                    return false;
                }
                memcpy(dst, text.ptr, text.len() as u64);
            } else if !read_exact(path.ptr, dst, end - start) {
                return false;
            }
            (*(*get_bufs().add(all as usize)).data.add(end as usize)) = b'\n';
            at = end + 1;
            files.push(path.ptr as i64);
            files.push(start);
            files.push(end);
            files.push(module);
            files.push(kind);
        }
        if at != src_len {
            return false;
        }
        (*(*get_bufs().add(all as usize)).data.add(at as usize)) = 0;
        (*get_bufs().add(all as usize)).len = at + 1;
        if (hash_region((*get_bufs().add(all as usize)).data, src_len) >> 1) as i64 != stamp {
            return false;
        }
        let n_probes = get_count(1, tcx);
        for _ in 0..n_probes {
            let path = get_str(tcx);
            if tcx.rd_bad || access(path.ptr, 0) == 0 {
                return false;
            }
        }
        let n_embeds = get_count(2, tcx);
        for _ in 0..n_embeds {
            let path = get_str(tcx);
            if tcx.rd_bad || get(tcx) != embedded_hash(path, pcx) {
                return false;
            }
        }
        let mut words = 0 as *mut i64;
        let mut n_refs: i64 = 0;
        if refs {
            let r = buf_new();
            if !read_file_if(cache_file(root, target, if next { c".next.refs" } else { c".refs" },
                pcx),
                r)
                || (*get_bufs().add(r as usize)).len % 8 != 0
                || (*get_bufs().add(r as usize)).len < 40 {
                return false;
            }
            words = (*get_bufs().add(r as usize)).data as *mut i64;
            n_refs = (*get_bufs().add(r as usize)).len / 8 - 5;
            if (*words.add(0)) != MAGIC || (*words.add(1)) != ident(pcx) || (*words.add(2)) != stamp
                || (*words.add(3)) != n_refs
                || (*words.add(4)) != body_hash(r, 5) {
                return false;
            }
        }
        if tcx.rd_bad {
            return false;
        }
        // It holds: the tables, as the front end left them.
        restore_sources(all, files, pcx);
        restore_tables(tcx, pcx);
        // (the lexer as the front end left it: its keywords, for what
        // lexes a text again, the layout of an edit)
        init_lexer(pcx);
        if tcx.rd_bad {
            crate::base::die(c"the tools' cache is damaged; remove target/volec-cache");
        }
        if refs {
            tcx.c_refs = words.add(5);
            tcx.c_ref_count = n_refs;
        }
        tcx.parsed = true;
        tcx.restored = true;
        touch(bin, used);
        true
    }
}

fn get_ints(v: &mut IntVec, tcx: &mut Tcx<Comp>) {
    let n = get_count(1, tcx);
    for _ in 0..n {
        v.push(get(tcx));
    }
}

fn restore_tables(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let n_syms = get_count(2, tcx);
    for _ in 0..n_syms {
        let h = get(tcx) as u64;
        restore_sym(get_str(tcx), h, pcx);
    }
    let n_modules = get_count(4, tcx);
    init_modules(pcx);
    for m in 0..n_modules {
        let name = get(tcx);
        let parent = get(tcx);
        let public = get(tcx) != 0;
        let is_c = get(tcx) != 0;
        if m > 0 {
            add_module(name, parent, public, pcx);
        }
        pcx.modules[m as usize].is_c = is_c;
    }
    pcx.std_module = get(tcx);
    pcx.c_module = get(tcx);
    get_ints(&mut pcx.inline_mods, tcx);
    let n_defs = get_count(26, tcx);
    tcx.c_eff_buf = buf_new();
    for _ in 0..n_defs {
        let def = Def {
            node: get(tcx), kind: get(tcx), name: get(tcx), module: get(tcx),
            parent: get(tcx), start: get(tcx),
            end: get(tcx), name_pos: get(tcx), public: get(tcx) != 0, impl_node: get(tcx),
            fqn: get(tcx),
            path: get(tcx), owner: get(tcx), tr: get(tcx),
        };
        restore_def(def, pcx);
        let tcx_arg = get(tcx);
        tcx.c_sig_end.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_trait.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_block.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_hdr_from.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_hdr_to.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_head.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_tail.push(tcx_arg);
        let tcx_arg = get(tcx);
        tcx.c_keyword.push(tcx_arg);
        for _ in 0..3 {
            let text = get_str(tcx);
            tcx.c_eff_text.push(buf_slice(tcx.c_eff_buf).len() as i64);
            buf_bytes(tcx.c_eff_buf, text);
            tcx.c_eff_text.push(buf_slice(tcx.c_eff_buf).len() as i64);
        }
    }
    get_ints(&mut pcx.mod_def, tcx);
    let mut aliases = tcx.aliases;
    get_ints(&mut aliases, tcx);
    tcx.aliases = aliases;
    tcx.c_alias = get(tcx);
    tcx.c_alias_module = get(tcx);
    get_ints(&mut pcx.notes, tcx);
    get_ints(&mut pcx.lines, tcx);
    let mut file_rank = tcx.file_rank;
    get_ints(&mut file_rank, tcx);
    tcx.file_rank = file_rank;
    let mut containers = tcx.containers;
    get_ints(&mut containers, tcx);
    tcx.containers = containers;
    let mut c_code_start = tcx.c_code_start;
    get_ints(&mut c_code_start, tcx);
    tcx.c_code_start = c_code_start;
    let error_count = get(tcx);
    let mut errors = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut warnings = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let n_errors = get_count(2, tcx);
    for _ in 0..n_errors {
        errors.push(get(tcx));
        errors.push(text_buf(get_str(tcx)));
    }
    let n_warnings = get_count(3, tcx);
    for _ in 0..n_warnings {
        warnings.push(get(tcx));
        warnings.push(text_buf(get_str(tcx)));
        warnings.push(get(tcx));
    }
    diag_restore(&mut errors, &mut warnings, error_count, pcx);
    // (0.25.3) std_item_key's answers, symbols both (a pair naming no item
    // is none)
    let mut std_keys = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let n_std = get_count(2, tcx);
    for _ in 0..n_std {
        let s = get(tcx);
        let k = get(tcx);
        if s < 0 || s >= n_syms || k >= n_syms {
            tcx.rd_bad = true;
        } else if k >= 0 {
            std_keys.push(s);
            std_keys.push(k);
        }
    }
    restore_std_keys(std_keys, pcx);
}

fn text_buf(s: &[u8]) -> i64 {
    let b = buf_new();
    crate::base::buf_bytes(b, s);
    b
}

// The references of collect_refs, from the cache: those to the
// definitions of GROUP.
pub fn cached_refs(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let group = crate::base::alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        for d in 0..pcx.defs.len() as i64 {
            (*group.add(d as usize)) = tcx.refs_group.get(d + 1) - 1;
        }
        for i in 0..tcx.c_ref_count {
            let w = (*tcx.c_refs.add(i as usize));
            let d = (w & 4294967295) >> 6;
            if d >= pcx.defs.len() as i64 || (*group.add(d as usize)) < 0 {
                continue;
            }
            tcx.r_pos.push(w >> 32);
            tcx.r_def.push(d);
            tcx.r_group.push((*group.add(d as usize)));
            tcx.r_flags.push(w & 63);
        }
    }
}

// ---- Writing ----

// Writes the cache of the program just read in full (its front end, the
// paths and positions of its definitions), for root and target. Nothing
// when there is no cache or the program cannot be cached.
//
// The answer is out by then: a copy of the process (fork) writes the cache
// while this one ends, its output to /dev/null. Here instead with
// --time-passes and $VOLE_CACHE_TRACE (the tests: the next command
// must find it).
pub fn cache_save(root: *mut u8, target: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if tcx.restored || !tcx.parsed || pcx.imported_start >= 0 || !usable(pcx) {
            return;
        }
        if !pcx.time_passes && getenv(c"VOLE_CACHE_TRACE") == 0 as *mut u8 {
            let pid = fork_worker();
            if pid > 0 {
                return;
            }
            if pid == 0 {
                // (a session of its own: not ended with the caller's group)
                setsid();
                let null = open(c"/dev/null", 1);
                if null >= 0 {
                    dup2(null, 1);
                    dup2(null, 2);
                }
                save(root, target, tcx, pcx);
                worker_exit(0);
            }
        }
        let t = timer_now(pcx);
        save(root, target, tcx, pcx);
        timer_add(T_CACHE, t, pcx);
    }
}

fn put_ints(b: i64, v: IntVec) {
    unsafe {
        put(b, v.len() as i64);
        for i in 0..v.len() as i64 {
            put(b, (v[i as usize]));
        }
    }
}

// Writes buffer b to `path`, through a new file renamed over it.
fn write_atomic(b: i64, path: *mut u8) -> bool {
    unsafe {
        let tmp = buf_new();
        buf_str(tmp, path);
        buf_str(tmp, c".tmp");
        crate::base::buf_int(tmp, getpid() as i64);
        buf_byte(tmp, 0);
        if !write_file_if((*get_bufs().add(tmp as usize)).data, buf_slice(b)) {
            crate::tools::proc::remove_file((*get_bufs().add(tmp as usize)).data);
            return false;
        }
        rename_file((*get_bufs().add(tmp as usize)).data, path)
    }
}

fn save(root: *mut u8, target: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.files.len() == 0 || pcx.std_tree != 0 as *mut u8
            || !make_dirs(cache_dir(pcx)) {
            return;
        }
        // (with --overlay, the edited program: its cache for after the edit)
        let next = pcx.overlay.len() as i64 > 0;
        let src_len = pcx.files[(pcx.files.len() as i64 - 1) as usize].end + 1;
        let stamp = (hash_region(get_src().ptr, src_len) >> 1) as i64;
        // The references, apart (only refs and callers read them).
        let mut all = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        collect_all_refs(&mut all, tcx, pcx);
        let r = buf_new();
        put(r, MAGIC);
        put(r, ident(pcx));
        put(r, stamp);
        put(r, all.len() as i64 / 3);
        put(r, 0);
        let mut i: i64 = 0;
        while i < all.len() as i64 {
            put(r,
                ((all[i as usize]) << 32) | ((all[(i + 1) as usize]) << 6)
                    | ((all[(i + 2) as usize]) & 63));
            i += 3;
        }
        let refs_header = (*get_bufs().add(r as usize)).data as *mut i64;
        (*refs_header.add(4)) = body_hash(r, 5);
        let b = buf_new();
        put(b, MAGIC);
        put(b, VERSION);
        put(b, ident(pcx));
        put(b, 0);
        put(b, 0);
        // (0.28.0) the time of last use (USED_WORD; touch writes it at a hit)
        put(b, now());
        put_cstr(b, root);
        put(b, target);
        put(b, stamp);
        put(b, src_len);
        put(b, pcx.files.len() as i64);
        for f in 0..pcx.files.len() {
            let path = pcx.files[f].path;
            put_cstr(b, path);
            put(b, pcx.files[f].start);
            put(b, pcx.files[f].end);
            put(b, pcx.files[f].module);
            put(b, pcx.files[f].kind);
            let made = (*path.add(0)) == b'<';
            put(b, if made { 1 } else { 0 });
            if made {
                put_str(b, &get_src()[pcx.files[f].start as usize..pcx.files[f].end as usize]);
            }
        }
        put(b, pcx.module_probes.len() as i64);
        for k in 0..pcx.module_probes.len() as i64 {
            put_cstr(b, (pcx.module_probes[k as usize]) as *mut u8);
        }
        // (0.25.3) the embedded files, each with the hash of its bytes
        put(b, embed_count(pcx));
        for k in 0..embed_count(pcx) {
            let path = embed_path_at(k, pcx);
            put_str(b, path);
            put(b, embedded_hash(path, pcx));
        }
        save_tables(b, tcx, pcx);
        // (the number of words, in the header)
        let header = (*get_bufs().add(b as usize)).data as *mut i64;
        (*header.add(3)) = (*get_bufs().add(b as usize)).len / 8;
        (*header.add(4)) = body_hash(b, USED_WORD + 1);
        // (0.28.0: the .bin first, then the references: a program in the
        // directory always has a .bin, or one being written, with its time,
        // for another process's evict. A reader between the two has a miss:
        // the references are of another text, restore's stamp)
        if !write_atomic(b,
            cache_file(root, target, if next { c".next.bin" } else { c".bin" }, pcx)) {
            return;
        }
        write_atomic(r, cache_file(root, target, if next { c".next.refs" } else { c".refs" }, pcx));
        evict(cache_key(root, target, pcx), pcx);
        trace(c"save");
    }
}

fn save_tables(b: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let n_syms = pcx.syms.len() as i64;
        put(b, n_syms);
        for s in 0..n_syms {
            put(b, sym_hash(s, pcx) as i64);
            put_str(b, sym_text(s, pcx));
        }
        put(b, module_count(pcx));
        for m in 0..module_count(pcx) {
            put(b, pcx.modules[m as usize].name);
            put(b, pcx.modules[m as usize].parent);
            put(b, if pcx.modules[m as usize].public { 1 } else { 0 });
            put(b, if pcx.modules[m as usize].is_c { 1 } else { 0 });
        }
        put(b, pcx.std_module);
        put(b, pcx.c_module);
        put_ints(b, pcx.inline_mods);
        put(b, pcx.defs.len() as i64);
        for d in 0..pcx.defs.len() as i64 {
            let x = pcx.defs[d as usize];
            put(b, d + 1);
            put(b, x.kind);
            put(b, x.name);
            put(b, x.module);
            put(b, x.parent);
            put(b, x.start);
            put(b, x.end);
            put(b, x.name_pos);
            put(b, if x.public { 1 } else { 0 });
            put(b, x.impl_node);
            put(b, x.fqn);
            put(b, x.path);
            put(b, x.owner);
            put(b, x.tr);
            put(b, signature_end(d, tcx, pcx));
            put(b, trait_of(d, tcx, pcx));
            let method = x.kind == K_METHOD || x.kind == K_IMPL_METHOD;
            put(b, if method { impl_block(d, tcx, pcx) } else { 0 });
            let mut to: i64 = 0;
            let from: i64 = if method { impl_header_span(d, &mut to, tcx, pcx) } else { 0 };
            put(b, from);
            put(b, to);
            put(b, item_head(d, tcx, pcx));
            put(b, item_tail(d, tcx, pcx));
            put(b, keyword_head(d, tcx, pcx));
            // (0.16: the effects def, show and `query effects` print)
            let set = buf_new();
            let lines = buf_new();
            cache_texts(d, set, lines, tcx, pcx);
            put_str(b, buf_slice(set));
            put_str(b, buf_slice(lines));
            // (0.19: what it needs beyond the build's features)
            let feats = buf_new();
            crate::tools::query::features::def_features_text(feats, d, tcx, pcx);
            put_str(b, buf_slice(feats));
        }
        put_ints(b, pcx.mod_def);
        put_ints(b, tcx.aliases);
        put(b, tcx.c_alias);
        put(b, tcx.c_alias_module);
        // The notes of the imports that give another name (query.alias):
        // the definition + 1 in place of its node (def_of_node).
        let mut notes = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut k: i64 = 0;
        while k < pcx.notes.len() as i64 {
            if ((pcx.notes[(k + 3) as usize]) & QF_USE) != 0
                && is_alias_at((pcx.notes[k as usize]), tcx) {
                let d = def_of_node((pcx.notes[(k + 2) as usize]), tcx, pcx);
                if d >= 0 {
                    notes.push((pcx.notes[k as usize]));
                    notes.push((pcx.notes[(k + 1) as usize]));
                    notes.push(d + 1);
                    notes.push((pcx.notes[(k + 3) as usize]));
                }
            }
            k += 4;
        }
        put_ints(b, notes);
        put_ints(b, pcx.lines);
        put_ints(b, tcx.file_rank);
        put_ints(b, tcx.containers);
        put(b, pcx.files.len() as i64);
        for f in 0..pcx.files.len() as i64 {
            put(b, code_start(f, tcx, pcx));
        }
        let mut errors = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut warnings = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let error_count = diag_records(&mut errors, &mut warnings, pcx);
        put(b, error_count);
        put(b, errors.len() as i64 / 2);
        let mut e: i64 = 0;
        while e < errors.len() as i64 {
            put(b, (errors[e as usize]));
            put_str(b, buf_slice((errors[(e + 1) as usize])));
            e += 2;
        }
        put(b, warnings.len() as i64 / 3);
        let mut w: i64 = 0;
        while w < warnings.len() as i64 {
            put(b, (warnings[w as usize]));
            put_str(b, buf_slice((warnings[(w + 1) as usize])));
            put(b, (warnings[(w + 2) as usize]));
            w += 3;
        }
        // (0.25.3) What `std::NAME` names, for each symbol (std_item_key:
        // the restored program has no scopes to ask). Last: what asking
        // does to the tables is not in what was written above.
        let mut std_keys = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        std_item_keys(n_syms, &mut std_keys, pcx);
        put(b, std_keys.len() as i64 / 2);
        let mut p: i64 = 0;
        while p + 1 < std_keys.len() as i64 {
            put(b, std_keys.get(p));
            put(b, if std_keys.get(p + 1) < n_syms { std_keys.get(p + 1) } else { -1 });
            p += 2;
        }
    }
}

fn is_alias_at(pos: i64, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i < tcx.aliases.len() as i64 {
            if (tcx.aliases[(i + 1) as usize]) == pos {
                return true;
            }
            i += 2;
        }
        false
    }
}

// ---- The bound ----

// The directory's tools' caches (every q-KEY.* file), at most (bytes;
// $VOLE_CACHE_LIMIT in MB, the code cache's packs' limit too): about 85
// programs the size of hello (12 MB each, std's tables), 35 the size of
// the compiler.
const LIMIT: i64 = 1024 * 1024 * 1024;
// Where a .bin's header has its time of last use (a word; not in its hash).
const USED_WORD: i64 = 5;

// UNSAFE: the C library's directory, seek, positioned write and clock
// calls (the compiler has no std here).
// SAFETY: opendir's handle goes only to readdir and closedir, once; lseek
// and pwrite get a descriptor this file opened and a buffer of the length
// given; time is given null.
extern "C" {
    fn opendir(path: *mut u8) -> *mut u8;
    fn readdir(dir: *mut u8) -> *mut u8;
    fn closedir(dir: *mut u8) -> i32;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn pwrite(fd: i32, buf: *mut u8, n: u64, offset: i64) -> i64;
    fn time(t: *mut i64) -> i64;
}

fn now() -> i64 {
    // UNSAFE: time is C's.
    // SAFETY: a null argument: the time is only returned.
    unsafe { time(0 as *mut i64) }
}

// The limit in bytes: $VOLE_CACHE_LIMIT's megabytes when it is a number.
fn limit_bytes() -> i64 {
    // UNSAFE: getenv is C's, its value a C string.
    // SAFETY: a literal's name; the value is read up to its NUL (the first
    // byte that is not a digit ends the loop).
    unsafe {
        let env = getenv(c"VOLE_CACHE_LIMIT");
        if env == 0 as *mut u8 || (*env.add(0)) < b'0' || (*env.add(0)) > b'9' {
            return LIMIT;
        }
        let mut mb: i64 = 0;
        let mut i: i64 = 0;
        while (*env.add(i as usize)) >= b'0' && (*env.add(i as usize)) <= b'9' && mb < 1 << 32 {
            mb = mb * 10 + ((*env.add(i as usize)) - b'0') as i64;
            i += 1;
        }
        mb * 1024 * 1024
    }
}

fn starts(name: &[u8], at: i64, word: &[u8]) -> bool {
    if at + word.len() as i64 > name.len() as i64 {
        return false;
    }
    for i in 0..word.len() as i64 {
        if name[(at + i) as usize] != word[i as usize] {
            return false;
        }
    }
    true
}

// What a directory entry is by its name: 0, not a file of this cache; 1,
// one with the header's time of last use (q-KEY.bin, q-KEY.next.bin); 2,
// its references (.refs, .next.refs). Either may end in .tmpPID, the
// file while it is written. KEY is 16 hex digits, `key` its value.
// Nothing else is ever removed: the whole name is matched.
fn cache_name(name: &[u8], key: &mut u64) -> i64 {
    let n = name.len() as i64;
    if n < 18 || name[0] != b'q' || name[1] != b'-' {
        return 0;
    }
    let mut h: u64 = 0;
    for i in 2..18 {
        let c = name[i as usize];
        if c >= b'0' && c <= b'9' {
            h = (h << 4) | (c - b'0') as u64;
        } else if c >= b'a' && c <= b'f' {
            h = (h << 4) | (c - b'a' + 10) as u64;
        } else {
            return 0;
        }
    }
    let mut at: i64 = 18;
    if starts(name, at, b".next") {
        at += 5;
    }
    let mut kind: i64 = 0;
    if starts(name, at, b".bin") {
        kind = 1;
        at += 4;
    } else if starts(name, at, b".refs") {
        kind = 2;
        at += 5;
    } else {
        return 0;
    }
    if at < n {
        if !starts(name, at, b".tmp") || at + 4 == n {
            return 0;
        }
        for i in at + 4..n {
            if name[i as usize] < b'0' || name[i as usize] > b'9' {
                return 0;
            }
        }
    }
    *key = h;
    kind
}

// A hit: now is the cache's time of last use, in its header (evict's
// order). Only into a file of this format: another compiler may have
// written its own over it since it was read.
fn touch(path: *mut u8, used: i64) {
    let mut word: [i64; 1] = [now()];
    if word[0] == used {
        return;
    }
    // UNSAFE: C's open, read, pwrite and close (a write at an offset, into
    // a file that may be gone or read-only: nothing then).
    // SAFETY: path is cache_file's NUL-terminated string; head has the 16
    // bytes read and word the 8 written; the descriptor is closed once.
    unsafe {
        let fd = open(path, 2);
        if fd < 0 {
            return;
        }
        let mut head: [i64; 2] = [0i64; 2];
        if read(fd, (&raw mut head[0]) as *mut u8, 16) == 16 && head[0] == MAGIC
            && head[1] == VERSION {
            pwrite(fd, (&raw mut word[0]) as *mut u8, 8, USED_WORD * 8);
        }
        close(fd);
    }
}

// After a cache was written: when the directory's q-KEY.* files pass the
// limit, the programs least recently used go, each with all its files,
// until they fit; never the one just written (`own`, its KEY). A program's
// time is its .bin's header's (0 for one of another format, or with no
// .bin: those go first). Several processes may do this at once: a file
// already gone is skipped, and a reader whose file goes has a miss.
fn evict(own: u64, pcx: &mut Ctx<Comp>) {
    let limit = limit_bytes();
    let dir = cache_dir(pcx);
    // Per file: where its path is in `paths`, its program (an index in
    // `keys`), its size. Per program: its KEY, its time, its bytes (-1
    // once removed).
    let paths = buf_new();
    let mut files = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut keys = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut total: i64 = 0;
    // UNSAFE: C's directory calls and a struct dirent's name; open, lseek
    // and read for a file's size and header.
    // SAFETY: d is opendir's, not null, closed once; an entry's name is a
    // NUL-terminated string at name_offset() in it, copied before the next
    // readdir; a path is read at its offset in `paths` right after it was
    // appended with its NUL; head has the 48 bytes read.
    unsafe {
        let d = opendir(dir);
        if d == 0 as *mut u8 {
            return;
        }
        let at = crate::back::codecache::pack::name_offset();
        loop {
            let ent = readdir(d);
            if ent == 0 as *mut u8 {
                break;
            }
            let name = ent.add(at as usize);
            let mut key: u64 = 0;
            let kind = cache_name(std::slice::from_raw_parts(name, strlen(name) as usize),
                &mut key);
            if kind == 0 {
                continue;
            }
            let off = (*get_bufs().add(paths as usize)).len;
            buf_str(paths, dir);
            buf_byte(paths, b'/');
            buf_str(paths, name);
            buf_byte(paths, 0);
            let fd = open((*get_bufs().add(paths as usize)).data.add(off as usize), 0);
            if fd < 0 {
                continue;
            }
            let mut size = lseek(fd, 0, 2);
            if size < 0 {
                size = 0;
            }
            let mut used: i64 = 0;
            if kind == 1 {
                let mut head: [i64; 6] = [0i64; 6];
                lseek(fd, 0, 0);
                if read(fd, (&raw mut head[0]) as *mut u8, 48) == 48 && head[0] == MAGIC
                    && head[1] == VERSION {
                    used = head[USED_WORD as usize];
                }
            }
            close(fd);
            let mut k: i64 = 0;
            while k < keys.len() as i64 && keys.get(k) != key as i64 {
                k += 3;
            }
            if k == keys.len() as i64 {
                keys.push(key as i64);
                keys.push(0);
                keys.push(0);
            }
            if used > keys.get(k + 1) {
                keys.set(k + 1, used);
            }
            keys.set(k + 2, keys.get(k + 2) + size);
            files.push(off);
            files.push(k);
            files.push(size);
            total += size;
        }
        closedir(d);
    }
    while total > limit {
        let mut old: i64 = -1;
        let mut k: i64 = 0;
        while k < keys.len() as i64 {
            if keys.get(k + 2) >= 0 && keys.get(k) != own as i64
                && (old < 0 || keys.get(k + 1) < keys.get(old + 1)) {
                old = k;
            }
            k += 3;
        }
        if old < 0 {
            break;
        }
        let mut f: i64 = 0;
        while f < files.len() as i64 {
            if files.get(f + 1) == old {
                // UNSAFE: the path as a C string, from the buffer's bytes.
                // SAFETY: the offset is one evict appended a path at, with
                // its NUL; `paths` is not changed after the directory was
                // read.
                let path = unsafe {
                    (*get_bufs().add(paths as usize)).data.add(files.get(f) as usize)
                };
                remove_file(path);
            }
            f += 3;
        }
        total -= keys.get(old + 2);
        keys.set(old + 2, -1);
    }
}
