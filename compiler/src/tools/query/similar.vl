// `query similar NAME` (0.17): the items to copy when adding one like
// NAME: those of its kind nearest to it, in full, as `query show` prints
// them. A method: the methods of its type (a trait's: the same method of
// the trait's other impls); anything else: the items of its kind in its
// module, those of its file first. With `query examples KIND`
// (examples.vl) and `volec guide how`, the "add an X" support.

use crate::base::{STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::file_of_pos;
use crate::tools::ctx::Tcx;
use crate::tools::query::resolve_name;
use crate::tools::query::defs::{K_IMPL_METHOD, K_METHOD, kind_name};
use crate::tools::query::diagnostics::diag;
use crate::tools::query::show::query_show;

// How many `similar` shows unless --limit says.
const SIMILAR_DEFAULT: i64 = 3;

// Whether definition e is like d (similar's rule above); `loose`, when
// nothing is: a method like the methods of other types of its module.
fn like(d: i64, e: i64, loose: bool, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    let method = k == K_METHOD || k == K_IMPL_METHOD;
    if loose {
        return method
            && (pcx.defs[e as usize].kind == K_METHOD || pcx.defs[e as usize].kind == K_IMPL_METHOD)
            && pcx.defs[e as usize].module == pcx.defs[d as usize].module;
    }
    if pcx.defs[d as usize].tr >= 0 {
        return pcx.defs[e as usize].tr == pcx.defs[d as usize].tr
            && pcx.defs[e as usize].name == pcx.defs[d as usize].name;
    }
    if method {
        return (pcx.defs[e as usize].kind == K_METHOD || pcx.defs[e as usize].kind == K_IMPL_METHOD)
            && pcx.defs[e as usize].owner == pcx.defs[d as usize].owner;
    }
    pcx.defs[e as usize].kind == k && pcx.defs[e as usize].module == pcx.defs[d as usize].module
        && pcx.defs[e as usize].parent == pcx.defs[d as usize].parent
}

// Up to limit definitions like d, nearest first (in its file before the
// others), into out; how many there are in all.
pub fn similar_defs(d: i64, limit: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) -> i64 {
    let f = file_of_pos(pcx.defs[d as usize].start, pcx);
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut keys: Vec<i64, Comp> = Vec::new_in(Comp {});
    for loose in 0..2 {
        if all.len() as i64 > 0 {
            break;
        }
        for e in 0..pcx.defs.len() as i64 {
            if e == d || !like(d, e, loose == 1, pcx) {
                continue;
            }
            let dist = if pcx.defs[e as usize].start
                > pcx.defs[d as usize].start {
                pcx.defs[e as usize].start - pcx.defs[d as usize].start
            }
                else { pcx.defs[d as usize].start - pcx.defs[e as usize].start };
            all.push(e);
            keys.push(if file_of_pos(pcx.defs[e as usize].start, pcx) == f { dist }
                else { (1 << 40) + dist });
        }
    }
    // (the `limit` smallest keys, in order)
    let mut taken: Vec<i64, Comp> = Vec::new_in(Comp {});
    for _ in 0..all.len() as i64 {
        taken.push(0);
    }
    while out.len() as i64 < limit && out.len() as i64 < all.len() as i64 {
        let mut best: i64 = -1;
        for i in 0..all.len() as i64 {
            if (taken[i as usize]) == 0
                && (best < 0 || (keys[i as usize]) < (keys[best as usize])) {
                best = i;
            }
        }
        (taken[best as usize]) = 1;
        out.push((all[best as usize]));
    }
    all.len() as i64
}

// `query similar NAME...`.
pub fn query_similar(args: &[i64], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut status: i64 = 0;
    let limit = if tcx.opt_limit > 0 { tcx.opt_limit } else { SIMILAR_DEFAULT };
    for i in 0..args.len() as i64 {
        let name = crate::base::cstr((args[i as usize]) as *mut u8);
        let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
        if !resolve_name(c"similar", &name, &mut matches, tcx, pcx) {
            status = 1;
            continue;
        }
        let d = (matches[0]);
        let mut picks: Vec<i64, Comp> = Vec::new_in(Comp {});
        let total = similar_defs(d, limit, &mut picks, pcx);
        let out = buf_new();
        buf_str(out, c"// ");
        buf_int(out, picks.len() as i64);
        buf_str(out, c" of ");
        buf_int(out, total);
        buf_byte(out, b' ');
        buf_str(out, kind_name(pcx.defs[d as usize].kind));
        buf_str(out, c"s like ");
        buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(out, c", nearest first; a new one beside it: volec edit insert --after ");
        buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(out, c" < new.vl\n");
        buf_write_fd(out, STDOUT);
        if picks.len() as i64 == 0 {
            let e = diag(c"note", c"query.empty", tcx);
            buf_str(e, c"nothing like ");
            buf_bytes(e, sym_text(pcx.defs[d as usize].fqn, pcx));
            buf_str(e, c" but itself\n");
            continue;
        }
        if query_show(picks.as_slice(), &name, tcx, pcx) != 0 {
            status = 1;
        }
    }
    status
}
