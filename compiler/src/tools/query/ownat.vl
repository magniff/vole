// `volec query own FILE:LINE:COL` (0.17, docs/design/value-semantics.md
// §2.9): the own pass's state at a position. The first line is the
// position and the function; then a line per local in scope: its name,
// type and kind (plain, owned, view), whether it is moved (where, by what)
// and the views it holds (their origins, where they were taken, what
// invalidated them). The state is front/own/observe.vl's
// (`own_state_at`, which walks the function); without it (the function is
// not walked: a template never instantiated) the locals and their kinds
// alone.

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::own::kinds::kind_word;
use crate::front::own::observe::own_state_at;
use crate::front::types::{buf_type, fn_param};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{parse_digits, trailing_number};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::positions::{enclosing, line_end, line_index};
use crate::tools::query::refs::file_text;
use crate::tools::query::typeat::file_named;

pub fn query_own(arg: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut line: i64 = -1;
        let mut col: i64 = -1;
        let mut file = &arg[0..0];
        let a = trailing_number(arg);
        if a > 0 && arg[(a - 1) as usize] == b':' {
            line = parse_digits(&arg[a as usize..]);
            file = &arg[0..(a - 1) as usize];
            let b = trailing_number(file);
            if b > 0 && file[(b - 1) as usize] == b':' {
                col = line;
                line = parse_digits(&file[b as usize..]);
                file = &file[0..(b - 1) as usize];
            }
        }
        if line < 1 {
            let d = diag(c"error", c"query.usage", tcx);
            buf_str(d, c"own needs a position, FILE:LINE:COL (not '");
            buf_bytes(d, arg);
            buf_str(d, c"')\n");
            return 2;
        }
        let f = file_named(file, pcx);
        if f < 0 {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", &arg[0..0], false, tcx, pcx));
            return 1;
        }
        let idx = line_index(pcx.files[f as usize].start, pcx) + line - 1;
        if idx >= pcx.lines.count || (*pcx.lines.data.add(idx as usize)) >= pcx.files[f as usize].end {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_bytes(d, file_text(f, pcx));
            buf_str(d, c" has no line ");
            buf_int(d, line);
            buf_byte(d, b'\n');
            return 1;
        }
        let ls = (*pcx.lines.data.add(idx as usize));
        let le = line_end(ls, pcx);
        let mut pos = ls;
        if col >= 1 {
            pos = ls + col - 1;
        } else {
            while pos < le && (crate::base::get_src()[pos as usize] == b' ' || crate::base::get_src()[pos as usize] == b'\t') {
                pos += 1;
            }
            col = pos - ls + 1;
        }
        if pos > le {
            pos = le;
        }
        let fi = fn_at(pos, pcx);
        if fi < 0 {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_bytes(d, arg);
            buf_str(d, c" is in no function the checker saw\n");
            let w = buf_new();
            buf_bytes(w, file);
            buf_byte(w, b':');
            buf_int(w, line);
            try_end(try_begin(c"show", buf_slice(w), true, tcx, pcx));
            return 1;
        }
        let out = buf_new();
        buf_bytes(out, file_text(f, pcx));
        buf_byte(out, b':');
        buf_int(out, line);
        buf_byte(out, b':');
        buf_int(out, col);
        buf_str(out, c" in ");
        let d = enclosing(pos, tcx, pcx);
        if d >= 0 {
            buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
        } else {
            buf_bytes(out, sym_text(pcx.fns[fi as usize].display, pcx));
        }
        buf_byte(out, b'\n');
        if !own_state_at(out, pos, pcx) {
            put_locals(out, fi, pos, pcx);
        }
        buf_write_fd(out, STDOUT);
        0
    }
}

// The innermost function whose body holds pos (a closure's own function
// inside its parent's), the first instance of a generic one; -1.
fn fn_at(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut best: i64 = -1;
    let mut size: i64 = 0;
    for i in 0..pcx.fns.len() as i64 {
        let n = pcx.fns[i as usize].node;
        if n <= 0 || pcx.fns[i as usize].is_extern || (pcx.fns[i as usize].generic > 0 && pcx.fns[i as usize].tmpl == 0) {
            continue;
        }
        let s = pcx.nodes[n as usize].start;
        let e = pcx.nodes[n as usize].end;
        if s <= pos && pos < e && (best < 0 || e - s < size) {
            best = i;
            size = e - s;
        }
    }
    best
}

// The locals in scope at pos in function fi, each with its type and kind,
// aligned in columns.
fn put_locals(out: i64, fi: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let item = pcx.fns[fi as usize].node;
        let mut ls = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // (the bindings before pos whose scope, the innermost block, loop,
        // arm or closure holding them, holds pos)
        let mut inside = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut scopes = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut lets = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        for n in 1..pcx.nodes.len() as i64 {
            if n == item || pcx.nodes[n as usize].start < pcx.nodes[item as usize].start
                || pcx.nodes[n as usize].end > pcx.nodes[item as usize].end {
                continue;
            }
            let k = pcx.nodes[n as usize].kind;
            if k == NodeKind::PatBind || k == NodeKind::Param {
                inside.push(n);
            }
            else if k == NodeKind::Let && pcx.nodes[n as usize].a > 0
                && pcx.nodes[n as usize].start < pcx.nodes[pcx.nodes[n as usize].a as usize].start
                && crate::base::get_src()[pcx.nodes[n as usize].start as usize] == b'l' {
                // (a `let`'s names from its end on)
                lets.put(pcx.nodes[n as usize].a + 1, pcx.nodes[n as usize].end);
            } else if k == NodeKind::Block || k == NodeKind::For || k == NodeKind::Arm
                || k == NodeKind::Closure || k == NodeKind::While {
                scopes.push(n);
            }
        }
        // (in the order they are declared, once each: a binding the
        // checker copied has its position; `__` names are the checker's)
        sort_nodes(inside, pcx);
        for i in 0..inside.count {
            let n = (*inside.data.add(i as usize));
            if pcx.nodes[n as usize].start >= pos || lets.get(n + 1) > pos || !in_scope(scopes, n, pos, pcx)
                || has_local(starts, pcx.nodes[n as usize].start) {
                continue;
            }
            let name = sym_text(pcx.nodes[n as usize].a, pcx);
            if name.len() >= 2 && name[0] == b'_' && name[1] == b'_'
                || binding_type(fi, n, pcx) <= 0 {
                continue;
            }
            ls.push(n);
            starts.push(pcx.nodes[n as usize].start);
        }
        let mut wn: i64 = 1;
        let mut wt: i64 = 1;
        let types = buf_new();
        let mut ends = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..ls.count {
            let l = (*ls.data.add(i as usize));
            let nl = sym_text(pcx.nodes[l as usize].a, pcx).len() as i64;
            if nl > wn {
                wn = nl;
            }
            let before = buf_slice(types).len() as i64;
            buf_type(types, binding_type(fi, l, pcx), pcx);
            let tl = buf_slice(types).len() as i64 - before;
            ends.push(buf_slice(types).len() as i64);
            if tl > wt {
                wt = tl;
            }
        }
        let mut start: i64 = 0;
        for i in 0..ls.count {
            let l = (*ls.data.add(i as usize));
            let name = sym_text(pcx.nodes[l as usize].a, pcx);
            buf_bytes(out, name);
            pad(out, wn - name.len() as i64 + 2);
            let t = &buf_slice(types)[start as usize..(*ends.data.add(i as usize)) as usize];
            start = (*ends.data.add(i as usize));
            buf_bytes(out, t);
            pad(out, wt - t.len() as i64 + 2);
            buf_str(out, kind_word(binding_type(fi, l, pcx), pcx));
            buf_byte(out, b'\n');
        }
    }
}

// The type of binding node n (a Param or a PatBind) of function fi, as the
// checker gave it; 0 when it has none (code it did not check).
fn binding_type(fi: i64, n: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[n as usize].ty > 0 {
        return pcx.nodes[n as usize].ty;
    }
    let item = pcx.fns[fi as usize].node;
    for i in 0..pcx.nodes[item as usize].count {
        if child(item, i, pcx) == n && i < pcx.fns[fi as usize].param_count {
            return fn_param(fi, i, pcx);
        }
    }
    0
}

fn pad(out: i64, n: i64) {
    for _ in 0..n {
        buf_byte(out, b' ');
    }
}

// Sorts nodes by their position (insertion: a function's bindings).
fn sort_nodes(v: IntVec, pcx: &Ctx<Comp>) {
    unsafe {
        let d = v.data;
        for i in 1..v.count {
            let mut j = i;
            while j > 0 && pcx.nodes[(*d.add(j as usize)) as usize].start < pcx.nodes[(*d.add((j - 1) as usize)) as usize].start {
                let t = (*d.add(j as usize));
                (*d.add(j as usize)) = (*d.add((j - 1) as usize));
                (*d.add((j - 1) as usize)) = t;
                j -= 1;
            }
        }
    }
}

fn has_local(ls: IntVec, l: i64) -> bool {
    for i in 0..ls.count {
        if unsafe { (*ls.data.add(i as usize)) } == l {
            return true;
        }
    }
    false
}

// Whether binding node b is in scope at pos: the innermost of `scopes`
// (the blocks, loops, arms and closures of its function) holding b holds
// pos.
fn in_scope(scopes: IntVec, b: i64, pos: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let at = pcx.nodes[b as usize].start;
        let mut best: i64 = -1;
        let mut size: i64 = 0;
        for i in 0..scopes.count {
            let n = (*scopes.data.add(i as usize));
            if pcx.nodes[n as usize].start <= at && at < pcx.nodes[n as usize].end
                && (best < 0 || pcx.nodes[n as usize].end - pcx.nodes[n as usize].start < size) {
                best = n;
                size = pcx.nodes[n as usize].end - pcx.nodes[n as usize].start;
            }
        }
        best < 0 || (pcx.nodes[best as usize].start <= pos && pos < pcx.nodes[best as usize].end)
    }
}
