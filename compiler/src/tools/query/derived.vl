// What `#[derive(...)]` makes (0.15), for the queries: the derived impls
// have no source of their own (their spans are the attribute's), so
// references from inside them are not the program's, and a derived
// method is answered by the attribute that makes it.

use crate::base::{IntVec, SRC, buf_byte, buf_bytes, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::tools::ctx::Tcx;
use crate::tools::query::defs::{K_ENUM, K_STRUCT, find_defs, last_segment};
use crate::tools::query::diagnostics::{diag, try_query};
use crate::tools::query::positions::put_loc;

// Notes the derive attributes of the parsed program's items.
pub fn collect_derive_spans(program: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    tcx.derive_spans.count = 0;
    for i in 0..pcx.nodes[program].count {
        let item = child(program, i, pcx);
        let kind = pcx.nodes[item].kind;
        let h = pcx.nodes[item].h;
        if (kind == NodeKind::Struct || kind == NodeKind::Enum) && h > 0 {
            tcx.derive_spans.push(pcx.nodes[h].start);
            tcx.derive_spans.push(pcx.nodes[h].end);
        }
    }
}

// Whether source position pos is inside a derive attribute.
pub fn in_derive(pos: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        var i = 0;
        while i + 1 < tcx.derive_spans.count {
            if pos >= tcx.derive_spans.data[i] && pos < tcx.derive_spans.data[i + 1] {
                return true;
            }
            i += 2;
        }
        false
    }
}

// The method that deriving trait `tr` makes ("": none, or not derivable).
fn derived_method(tr: [u8]) -> [u8] {
    if same(tr, "Eq") { "eq" } else if same(tr, "Ord") { "cmp" }
    else if same(tr, "Hash") { "hash" } else if same(tr, "Debug") { "fmt_debug" }
    else if same(tr, "Clone") { "clone" } else { "" }
}

fn same(a: [u8], b: [u8]) -> bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn ident_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
        || c == ':'
}

// The position of the trait whose derive makes method m, in the
// attributes written from..to (`#[derive(A, std::B)]`), or -1.
fn derive_of(from: i64, to: i64, m: [u8]) -> i64 {
    let key = "derive(";
    var p = from;
    while p + key.len as i64 <= to {
        var hit = true;
        for k in 0..key.len as i64 {
            if SRC[p + k] != key[k] {
                hit = false;
                break;
            }
        }
        if !hit || (p > from && ident_byte(SRC[p - 1])) {
            p += 1;
            continue;
        }
        p += key.len as i64;
        while p < to && SRC[p] != ')' {
            while p < to && !ident_byte(SRC[p]) && SRC[p] != ')' {
                p += 1;
            }
            let s = p;
            while p < to && ident_byte(SRC[p]) {
                p += 1;
            }
            if p > s {
                let path = SRC[s..p];
                let name = last_segment(path);
                let mm = derived_method(name);
                if mm.len > 0 && same(mm, m) {
                    return p - name.len as i64;
                }
            }
        }
    }
    -1
}

// The start of the attribute lines (`#[...]`) right above the item that
// starts at pos (pos when there is none): the item's span may leave them
// out.
fn attrs_start(pos: i64) -> i64 {
    var start = pos;
    var p = pos;
    while p > 0 && SRC[p - 1] != '\n' {
        p -= 1;
    }
    while p > 0 {
        // (the line before p)
        var q = p - 1;
        while q > 0 && SRC[q - 1] != '\n' {
            q -= 1;
        }
        var t = q;
        while t < p && (SRC[t] == ' ' || SRC[t] == '\t') {
            t += 1;
        }
        if t + 1 >= p || SRC[t] != '#' || SRC[t + 1] != '[' {
            break;
        }
        start = t;
        p = q;
    }
    start
}

// (0.15) When `name` (`Type::m`) is a method #[derive] makes for a struct
// or enum of the program: `note query.derived` says where, and true.
pub fn derived_note(cmd: u8, name: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let m = last_segment(name);
        if m.len as i64 + 2 > name.len as i64 {
            return false;
        }
        let ty = name[0..name.len as i64 - m.len as i64 - 2];
        var defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_defs(ty, false, &defs, tcx, pcx);
        for i in 0..defs.count {
            let d = defs.data[i];
            if pcx.defs[d].kind != K_STRUCT && pcx.defs[d].kind != K_ENUM {
                continue;
            }
            let at = derive_of(attrs_start(pcx.defs[d].start), pcx.defs[d].name_pos, m);
            if at < 0 {
                continue;
            }
            let out = diag(c"note", c"query.derived", &tcx);
            buf_byte(out, '\'');
            buf_bytes(out, name);
            buf_str(out, c"' is derived, at ");
            put_loc(out, at, &pcx);
            buf_str(out, c": #[derive] makes it; it has no source of its own\n");
            try_query(c"show", sym_text(pcx.defs[d].fqn, pcx), &tcx, pcx);
            return true;
        }
        false
    }
}
