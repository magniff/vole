// What `#[derive(...)]` makes (0.15), for the queries: the derived impls
// have no source of their own (their spans are the attribute's), so
// references from inside them are not the program's, and a derived
// method is answered by the attribute that makes it.

use crate::base::{IntVec, buf_byte, buf_bytes, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::tools::ctx::Tcx;
use crate::tools::query::defs::{K_ENUM, K_STRUCT, find_defs, last_segment};
use crate::tools::query::diagnostics::{diag, try_query};
use crate::tools::query::positions::put_loc;

// Notes the derive attributes of the parsed program's items.
pub fn collect_derive_spans(program: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    tcx.derive_spans.clear();
    for i in 0..pcx.nodes[program as usize].count {
        let item = child(program, i, pcx);
        let kind = pcx.nodes[item as usize].kind;
        let h = pcx.nodes[item as usize].h;
        if (kind == NodeKind::Struct || kind == NodeKind::Enum) && h > 0 {
            tcx.derive_spans.push(pcx.nodes[h as usize].start);
            tcx.derive_spans.push(pcx.nodes[h as usize].end);
        }
    }
}

// Whether source position pos is inside a derive attribute.
pub fn in_derive(pos: i64, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i + 1 < tcx.derive_spans.len() as i64 {
            if pos >= (tcx.derive_spans[i as usize])
                && pos < (tcx.derive_spans[(i + 1) as usize]) {
                return true;
            }
            i += 2;
        }
        false
    }
}

// Whether deriving trait `tr` makes method `m` (0.28.0: the rust
// edition's traits and names too: PartialEq's eq, PartialOrd's
// partial_cmp, Debug's fmt, Default's default).
fn derives(tr: &[u8], m: &[u8]) -> bool {
    if same(tr, b"Eq") || same(tr, b"PartialEq") {
        same(m, b"eq")
    } else if same(tr, b"Ord") {
        same(m, b"cmp")
    } else if same(tr, b"PartialOrd") {
        same(m, b"partial_cmp")
    } else if same(tr, b"Hash") {
        same(m, b"hash")
    } else if same(tr, b"Debug") {
        same(m, b"fmt_debug") || same(m, b"fmt")
    } else if same(tr, b"Clone") {
        same(m, b"clone")
    } else if same(tr, b"Default") {
        same(m, b"default")
    } else {
        false
    }
}

fn same(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn ident_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
        || c == b':'
}

// The position of the trait whose derive makes method m, in the
// attributes written from..to (`#[derive(A, std::B)]`), or -1.
fn derive_of(from: i64, to: i64, m: &[u8]) -> i64 {
    let key = "derive(";
    let mut p = from;
    while p + key.len() as i64 <= to {
        let mut hit = true;
        for k in 0..key.len() as i64 {
            if get_src()[(p + k) as usize] != key[k as usize] {
                hit = false;
                break;
            }
        }
        if !hit || (p > from && ident_byte(get_src()[(p - 1) as usize])) {
            p += 1;
            continue;
        }
        p += key.len() as i64;
        while p < to && get_src()[p as usize] != b')' {
            while p < to && !ident_byte(get_src()[p as usize]) && get_src()[p as usize] != b')' {
                p += 1;
            }
            let s = p;
            while p < to && ident_byte(get_src()[p as usize]) {
                p += 1;
            }
            if p > s {
                let path = &get_src()[s as usize..p as usize];
                let name = last_segment(path);
                if derives(name, m) {
                    return p - name.len() as i64;
                }
            }
        }
    }
    -1
}

// The start of the attribute lines (`#[...]`) right above the item that
// starts at pos (pos when there is none): the item's span may leave them
// out.
fn attrs_start(pos: i64) -> i64 {
    let mut start = pos;
    let mut p = pos;
    while p > 0 && get_src()[(p - 1) as usize] != b'\n' {
        p -= 1;
    }
    while p > 0 {
        // (the line before p)
        let mut q = p - 1;
        while q > 0 && get_src()[(q - 1) as usize] != b'\n' {
            q -= 1;
        }
        let mut t = q;
        while t < p && (get_src()[t as usize] == b' ' || get_src()[t as usize] == b'\t') {
            t += 1;
        }
        if t + 1 >= p || get_src()[t as usize] != b'#' || get_src()[(t + 1) as usize] != b'[' {
            break;
        }
        start = t;
        p = q;
    }
    start
}

// (0.15) When `name` (`Type::m`) is a method #[derive] makes for a struct
// or enum of the program: `note query.derived` says where, and true.
pub fn derived_note(cmd: u8, name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let m = last_segment(name);
        if m.len() as i64 + 2 > name.len() as i64 {
            return false;
        }
        let ty = &name[0..(name.len() as i64 - m.len() as i64 - 2) as usize];
        let mut defs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_defs(ty, false, &mut defs, tcx, pcx);
        for i in 0..defs.len() as i64 {
            let d = (defs[i as usize]);
            if pcx.defs[d as usize].kind != K_STRUCT && pcx.defs[d as usize].kind != K_ENUM {
                continue;
            }
            let at = derive_of(attrs_start(pcx.defs[d as usize].start),
                pcx.defs[d as usize].name_pos, m);
            if at < 0 {
                continue;
            }
            let out = diag(c"note", c"query.derived", tcx);
            buf_byte(out, b'\'');
            buf_bytes(out, name);
            buf_str(out, c"' is derived, at ");
            put_loc(out, at, pcx);
            buf_str(out, c": #[derive] makes it; it has no source of its own\n");
            try_query(c"show", sym_text(pcx.defs[d as usize].fqn, pcx), tcx, pcx);
            return true;
        }
        false
    }
}
