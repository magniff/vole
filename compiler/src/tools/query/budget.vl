// The output budget of `volec query` (0.15): `--budget N` keeps an
// answer to about N tokens (4 bytes a token), cut at a line, with a note
// saying what was left out and the command that prints it all. Without
// --budget, an answer over DEFAULT_BUDGET is cut the same way (not with
// --all; `--budget 0` is no limit). `query context` fits its answer to
// the budget itself (context.vl).

use crate::base::{
    STDOUT, buf_byte, buf_int, buf_new, buf_ptr, buf_slice, buf_str, get_stdout_capture,
    set_stdout_capture, write,
};
use crate::base::comp::Comp;
use crate::cli::line::Line;
use crate::tools::ctx::Tcx;
use crate::tools::query::diagnostics::{diag, diags, put_word};

// The budget of an answer without --budget, in tokens.
pub const DEFAULT_BUDGET: i64 = 8000;

pub const BYTES_PER_TOKEN: i64 = 4;

// Starts keeping stdout, to write it within the budget (end_output).
pub fn begin_output() {
    set_stdout_capture(buf_new());
}

// Writes what was kept of stdout, within the budget (`own`: the answer
// fitted itself, only --budget cuts it); the note and `try:` line when it
// is cut. line is the command's, for the line that prints it all.
pub fn end_output(line: Line<'_>, own: bool, tcx: &mut Tcx<Comp>) {
    // UNSAFE: write is C's, given the buffers' own blocks (BUFS, base's raw
    // table).
    // SAFETY: cap is the capture's buffer (checked not negative) and text
    // its bytes: the counts written are text.len() or end <= limit <
    // text.len(); nl holds the one byte written.
    unsafe {
        let cap = get_stdout_capture();
        if cap < 0 {
            return;
        }
        set_stdout_capture(-1);
        let text = buf_slice(cap);
        let limit: i64 = if tcx.opt_budget > 0 { tcx.opt_budget * BYTES_PER_TOKEN }
            else if tcx.opt_budget == 0 || tcx.opt_all || own { -1 }
            else { DEFAULT_BUDGET * BYTES_PER_TOKEN };
        if limit < 0 || text.len() as i64 <= limit {
            write(STDOUT, buf_ptr(cap), text.len() as u64);
            return;
        }
        let mut end = limit;
        while end > 0 && text[(end - 1) as usize] != b'\n' {
            end -= 1;
        }
        if end == 0 {
            end = limit;
        }
        let shown = count_lines(&text[0..end as usize]);
        let total = count_lines(text);
        write(STDOUT, buf_ptr(cap), end as u64);
        if text[(end - 1) as usize] != b'\n' {
            let nl = buf_new();
            buf_byte(nl, b'\n');
            write(STDOUT, buf_ptr(nl), 1);
        }
        let need = (text.len() as i64 + BYTES_PER_TOKEN - 1) / BYTES_PER_TOKEN;
        let d = diag(c"note", c"query.budget", tcx);
        buf_str(d, c"cut at about ");
        buf_int(d, limit / BYTES_PER_TOKEN);
        buf_str(d, c" tokens: ");
        buf_int(d, shown);
        buf_str(d, c" of ");
        buf_int(d, total);
        buf_str(d, c" lines (about ");
        buf_int(d, need);
        buf_str(d, c" tokens in all)\n");
        try_with_budget(line, (need + 99) / 100 * 100, tcx);
    }
}

fn count_lines(s: &[u8]) -> i64 {
    let mut n: i64 = 0;
    for i in 0..s.len() {
        if s[i] == b'\n' {
            n += 1;
        }
    }
    if s.len() > 0 && s[(s.len() as i64 - 1) as usize] != b'\n' {
        n += 1;
    }
    n
}

// `try: PROG ARGS --budget N`: the command again (its line, without its
// --budget), with budget N.
pub fn try_with_budget(line: Line<'_>, n: i64, tcx: &mut Tcx<Comp>) {
    let out = diags(tcx);
    buf_str(out, c"try:");
    let mut k: i64 = 0;
    while k < line.len() {
        if line.word(k) == "--budget" {
            k += 2;
            continue;
        }
        put_word(out, line.word(k).as_bytes());
        k += 1;
    }
    buf_str(out, c" --budget ");
    buf_int(out, n);
    buf_byte(out, b'\n');
}
