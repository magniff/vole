// `query def`, `query show` and `query items`: a definition's location and
// signature, its source text with the comments above it, the module tree,
// and a module's items with their signatures.

use crate::base::{
    SOURCE_VOLE, STDOUT, buf_append, buf_byte, buf_bytes, buf_copy, buf_int, buf_len, buf_new,
    buf_str, buf_truncate, buf_write_fd, get_src, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::NodeKind;
use crate::front::check::widen::{FLOAT_CONSTS, FLOAT_LIMITS};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_count, within_std};
use crate::tools::ctx::Tcx;
use crate::tools::query::c_slice;
use crate::tools::query::defs::{
    K_CONST, K_ENUM, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STATIC, K_STRUCT, K_TRAIT, K_TRAIT_FN,
    bytes_eq, ends_with, find_in, kind_name, mod_fqn_text,
};
use crate::tools::query::diagnostics::{diag, put_word, try_begin, try_end, try_query};
use crate::tools::query::effects::put_def_effects;
use crate::tools::query::features::{put_def_features, put_intrinsic_notes};
use crate::tools::query::names::{canonical_name, path_matches};
use crate::tools::query::positions::{
    collapse, is_space, line_end, line_of, line_start, put_lines, put_loc, put_path,
    sort_by_position, token_at,
};
use crate::tools::query::refs::{file_text, kind_listed};
use crate::tools::query::sections::{banners_of_module, put_banner_line};
use crate::tools::query::stdq::{is_std_module, put_std_use};
use crate::tools::query_text::section_start;

// ---- def, show, items ----

// The end of definition d's signature (before its body or its value).
pub fn signature_end(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if tcx.restored {
        return (tcx.c_sig_end[d as usize]);
    }
    let node = pcx.defs[d as usize].node;
    let k = pcx.defs[d as usize].kind;
    if (k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN)
        && pcx.nodes[node as usize].kind == NodeKind::Fn && pcx.nodes[node as usize].c != 0 {
        return pcx.nodes[pcx.nodes[node as usize].c as usize].start;
    }
    if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
        let mut i = token_at(pcx.defs[d as usize].name_pos, pcx);
        while i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Tok::LBrace
            && pcx.toks[i as usize].kind != Tok::Semi
            && pcx.toks[i as usize].kind != Tok::Eof {
            i += 1;
        }
        return pcx.toks[i as usize].start;
    }
    // (0.26.0) an embedded block: `embed wgsl K`, before its text
    if k == K_STATIC && pcx.nodes[node as usize].kind == NodeKind::Embed
        && pcx.nodes[node as usize].d >= 0 {
        return pcx.nodes[node as usize].d - 1;
    }
    if k == K_MOD {
        return pcx.defs[d as usize].name_pos + sym_text(pcx.defs[d as usize].name, pcx).len() as i64;
    }
    let mut end = pcx.defs[d as usize].end;
    while end > pcx.defs[d as usize].start
        && (get_src()[(end - 1) as usize] == b';' || get_src()[(end - 1) as usize] == b','
            || is_space(get_src()[(end - 1) as usize])) {
        end -= 1;
    }
    end
}

const LONG_SIGNATURE: i64 = 120;

pub fn put_signature(out: i64, d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    if pcx.defs[d as usize].public && pcx.defs[d as usize].kind != K_IMPL_METHOD {
        buf_str(out, c"pub ");
    }
    let mark = buf_len(out);
    collapse(out, pcx.defs[d as usize].start, signature_end(d, tcx, pcx));
    let k = pcx.defs[d as usize].kind;
    if (k == K_CONST || k == K_STATIC) && buf_len(out) - mark > LONG_SIGNATURE {
        // A long value: cut at its `=`.
        let text = buf_copy(out);
        let eq = find_in(&text, c" = ", mark);
        if eq >= 0 {
            buf_truncate(out, eq);
            buf_str(out, c" = ...");
        }
    }
}

pub fn query_def(matches: &[i64], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    for i in 0..matches.len() as i64 {
        query_def_one(out, (matches[i as usize]), tcx, pcx);
    }
    buf_write_fd(out, STDOUT);
}

// `PATH<TAB>FILE:LINE:COL<TAB>KIND<TAB>SIGNATURE` of definition d.
pub fn query_def_one(out: i64, d: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
    buf_byte(out, b'\t');
    put_loc(out, pcx.defs[d as usize].name_pos, pcx);
    buf_byte(out, b'\t');
    buf_str(out, kind_name(pcx.defs[d as usize].kind));
    buf_byte(out, b'\t');
    put_signature(out, d, tcx, pcx);
    // (0.16: a function's effects, effects.vl)
    put_def_effects(out, d, c"\t", tcx, pcx);
    // (0.17: its view summary, values.vl)
    put_def_features(out, d, c"\t", tcx, pcx);
    buf_byte(out, b'\n');
}

// The start of the first line of definition d's text: the line of its
// start, and the comment and attribute lines right above it.
pub fn text_start(d: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut first = line_start(pcx.defs[d as usize].start, pcx);
    let file_start = pcx.files[file_of_pos(first, pcx) as usize].start;
    while first > file_start {
        let prev = line_start(first - 1, pcx);
        let mut a = prev;
        while a < first - 1 && (get_src()[a as usize] == b' ' || get_src()[a as usize] == b'\t') {
            a += 1;
        }
        let comment = a + 1 < first && get_src()[a as usize] == b'/'
            && get_src()[(a + 1) as usize] == b'/';
        // (0.28.0: a line of attributes alone, ending with `]`, not an
        // item written after its attributes, `#[derive(..)] enum E {`)
        let mut z = first - 1;
        while z > a && (get_src()[(z - 1) as usize] == b' ' || get_src()[(z - 1) as usize] == b'\t'
            || get_src()[(z - 1) as usize] == b'\r') {
            z -= 1;
        }
        let attribute = a + 1 < first && get_src()[a as usize] == b'#'
            && get_src()[(a + 1) as usize] == b'[' && z > a && get_src()[(z - 1) as usize] == b']';
        if !comment && !attribute {
            break;
        }
        first = prev;
    }
    first
}

// More matches than this: `show` lists their paths only.
const SHOW_MAX: i64 = 5;

pub fn query_show(matches: &[i64], name: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    let n = matches.len() as i64;
    if n > SHOW_MAX {
        for i in 0..n {
            buf_bytes(out,
                sym_text(pcx.defs[(matches[i as usize]) as usize].fqn, pcx));
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        let d = diag(c"error", c"query.ambiguous", tcx);
        buf_int(d, n);
        buf_str(d, c" definitions match '");
        buf_bytes(d, name);
        buf_str(d, c"'; showing paths only\n");
        try_query(c"show", sym_text(pcx.defs[(matches[0]) as usize].fqn, pcx), tcx,
            pcx);
        return 1;
    }
    for i in 0..n {
        let d = (matches[i as usize]);
        let first = section_start(text_start(d, pcx), tcx, pcx);
        let last = line_end(if pcx.defs[d as usize].end
            > pcx.defs[d as usize].start { pcx.defs[d as usize].end - 1 }
            else { pcx.defs[d as usize].start }, pcx);
        buf_str(out, c"// ");
        buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_byte(out, b'\t');
        put_lines(out, first, last, pcx);
        put_def_effects(out, d, c"\t", tcx, pcx);
        put_def_features(out, d, c"\t", tcx, pcx);
        buf_byte(out, b'\n');
        put_intrinsic_notes(out, d, tcx, pcx);
        put_std_use(out, d, tcx, pcx);
        buf_bytes(out, &get_src()[first as usize..last as usize]);
        buf_byte(out, b'\n');
        // (0.25.3) a struct's or enum's methods
        put_type_methods(out, d, tcx, pcx);
    }
    buf_write_fd(out, STDOUT);
    0
}

// (0.25.3) More methods than this: `show TYPE` lists these (--all: every
// one) and says how to see the rest.
const SHOW_METHODS: i64 = 50;

// (0.25.3) After a struct's or enum's source in `show`: its methods, one
// signature line each from every impl block (std's: its API), by
// position; a contract cut to its keyword (`query items TYPE` has it
// whole), a trait impl's function marked with its `impl ... for ...`. The
// round 3 eval's agents fell back to `query items`, whose answer was 170
// lines, to find a type's methods.
fn put_type_methods(out: i64, t: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let k0 = pcx.defs[t as usize].kind;
    if k0 != K_STRUCT && k0 != K_ENUM {
        return;
    }
    let std = is_std_module(pcx.defs[t as usize].module, pcx);
    let mut methods: Vec<i64, Comp> = Vec::new_in(Comp {});
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d as usize].owner >= 0
            && pcx.defs[d as usize].owner == pcx.defs[t as usize].fqn
            && !(std && !tcx.opt_all && !pcx.defs[d as usize].public
                && k == K_METHOD) {
            methods.push(d);
        }
    }
    if methods.len() as i64 == 0 {
        return;
    }
    sort_by_position(&mut methods, tcx, pcx);
    let name = sym_text(pcx.defs[t as usize].fqn, pcx);
    buf_str(out, c"// ");
    buf_int(out, methods.len() as i64);
    buf_str(out, if methods.len() as i64 == 1 { c" method" } else { c" methods" });
    buf_str(out, c" (with their lines and whole contracts: query items ");
    buf_bytes(out, name);
    buf_str(out, c")\n");
    let shown = if tcx.opt_all || methods.len() as i64 <= SHOW_METHODS { methods.len() as i64 }
        else { SHOW_METHODS };
    for i in 0..shown {
        let d = (methods[i as usize]);
        put_short_signature(out, d, tcx, pcx);
        if pcx.defs[d as usize].kind == K_IMPL_METHOD {
            buf_str(out, c"  // ");
            let mut to: i64 = 0;
            let from = impl_header_span(d, &mut to, tcx, pcx);
            collapse(out, from, to);
        }
        buf_byte(out, b'\n');
    }
    if shown < methods.len() as i64 {
        let n = diag(c"note", c"query.truncated", tcx);
        buf_bytes(n, name);
        buf_str(n, c" has ");
        buf_int(n, methods.len() as i64);
        buf_str(n, c" methods; showing the first ");
        buf_int(n, shown);
        buf_byte(n, b'\n');
        let tr = try_begin(c"show", name, true, tcx, pcx);
        put_word(tr, b"--all");
        try_end(tr);
        try_query(c"items", name, tcx, pcx);
    }
}

// (0.25.3) Definition d's signature on one line, a contract cut to its
// keyword (`requires ...`): `show TYPE`'s method lines.
fn put_short_signature(out: i64, d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mark = buf_len(out);
    put_signature(out, d, tcx, pcx);
    let text = buf_copy(out);
    let mut cut: i64 = -1;
    for kw in [c" requires ", c" ensures "] {
        let at = find_in(&text, kw, mark);
        if at >= 0 && (cut < 0 || at < cut) {
            cut = at;
        }
    }
    if cut >= 0 {
        let word = if find_in(&text, c" requires ", mark) == cut { c" requires ..." }
            else { c" ensures ..." };
        buf_truncate(out, cut);
        buf_str(out, word);
    }
}

// The modules answering to `name` (all of them for none), in `out`; a
// file's path (`x.vl`, `./x.vl`, `a/b/`) names the modules of its
// files (0.15).
pub fn find_modules(name0: &[u8], exact: bool, out: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let name = canonical_name(name0);
    let is_file = name.len() > 0 && (name[0] == b'<' || find_in(name, c"/", 0) >= 0
        || find_in(name, c".vl", 0) >= 0 || find_in(name, c".vl", 0) >= 0);
    for m in 0..module_count(pcx) {
        if pcx.modules[m as usize].name < 0 && m != 0 {
            continue;
        }
        let fqn = mod_fqn_text(m, tcx, pcx);
        if is_file {
            let f = module_file(m, pcx);
            if f >= 0 && pcx.files[f as usize].module == m
                && path_matches(file_text(f, pcx), name) {
                out.push(m);
            }
        } else if name.len() == 0 || bytes_eq(fqn, name) || ends_with(fqn, name, exact) {
            out.push(m);
        }
    }
}

// The module tree: each module's path, file and number of items.
pub fn query_modules(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    let empty = intern_c(c"", pcx);
    find_modules(sym_text(empty, pcx), false, &mut all, tcx, pcx);
    for i in 0..all.len() as i64 {
        let m = (all[i as usize]);
        // (0.28.0: std's modules are not the program's: std is a
        // tree of them, which MVS's std never listed here; --all lists
        // them)
        if m != pcx.std_module && crate::front::modules::within_std(m, pcx) && !tcx.opt_all {
            continue;
        }
        let mut items: i64 = 0;
        let mut first: i64 = -1;
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].module == m && pcx.defs[d as usize].parent < 0 {
                items += 1;
                if first < 0 {
                    first = d;
                }
            }
        }
        buf_bytes(out, mod_fqn_text(m, tcx, pcx));
        buf_byte(out, b'\t');
        let f = module_file(m, pcx);
        if f >= 0 {
            put_path(out, f, pcx);
        }
        buf_byte(out, b'\t');
        buf_int(out, items);
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
}

// The file of module m (an inline module's is its parent's), or -1.
pub fn module_file(m: i64, pcx: &Ctx<Comp>) -> i64 {
    for f in 0..pcx.files.len() as i64 {
        if pcx.files[f as usize].module == m && pcx.files[f as usize].kind == SOURCE_VOLE {
            return f;
        }
    }
    if m > 0
        && pcx.modules[m as usize].parent >= 0 { module_file(pcx.modules[m as usize].parent, pcx) }
    else { -1 }
}

// The impl block of function definition d (its impl node, or the type
// node the functions of one block share), and the span of its `impl ...`
// header, from its start to its `{` (in *to).
pub fn impl_block(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if tcx.restored {
        return (tcx.c_block[d as usize]);
    }
    if pcx.defs[d as usize].impl_node != 0 { pcx.defs[d as usize].impl_node }
    else { pcx.nodes[pcx.defs[d as usize].node as usize].h }
}

pub fn impl_header_span(d: i64, to: &mut i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if tcx.restored {
        *to = (tcx.c_hdr_to[d as usize]);
        return (tcx.c_hdr_from[d as usize]);
    }
    let node = pcx.defs[d as usize].node;
    let mut from: i64 = 0;
    if pcx.defs[d as usize].impl_node != 0 {
        from = pcx.nodes[pcx.defs[d as usize].impl_node as usize].start;
    } else {
        let mut i = token_at(pcx.nodes[pcx.nodes[node as usize].h as usize].start, pcx) - 1;
        while i > 0 && pcx.toks[i as usize].kind != Tok::Impl {
            i -= 1;
        }
        from = pcx.toks[i as usize].start;
    }
    let mut j = token_at(from, pcx);
    while j < pcx.toks.len() as i64 && pcx.toks[j as usize].kind != Tok::LBrace
        && pcx.toks[j as usize].kind != Tok::Eof {
        j += 1;
    }
    *to = pcx.toks[j as usize].start;
    from
}

// The start of the `impl` of the impl block of function definition d.
fn impl_start(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut to: i64 = 0;
    impl_header_span(d, &mut to, tcx, pcx)
}

// The `impl ... {` header of the impl block of function definition d.
fn put_impl_header(out: i64, d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    let mut to: i64 = 0;
    let from = impl_header_span(d, &mut to, tcx, pcx);
    buf_int(out, line_of(from, pcx));
    buf_str(out, c"\timpl\t");
    collapse(out, from, to);
    buf_byte(out, b'\n');
}

pub fn items_filtered(tcx: &Tcx<Comp>) -> bool {
    tcx.opt_find != 0 as *mut u8 || tcx.opt_kind != 0 as *mut u8
}

// The kinds --kind takes for `items`, as kind_name spells them.
const ITEM_KINDS: [&[u8]; 10] = [b"fn", b"method", b"struct", b"enum", b"trait", b"trait-method",
    b"const", b"static", b"type", b"mod"];

// The first word of --kind's list (`opt_kind`, argv's, or null) that is no
// kind of item, or "": a view of argv, not of tcx (src-buffer.md, views of
// other storage).
pub fn bad_item_kind(opt_kind: *mut u8) -> &'static [u8] {
    if opt_kind == 0 as *mut u8 {
        return b"";
    }
    let list = crate::base::c_kept(opt_kind);
    let mut i: i64 = 0;
    while i < list.len() as i64 {
        let mut j = i;
        while j < list.len() as i64 && list[j as usize] != b',' {
            j += 1;
        }
        let word = &list[i as usize..j as usize];
        let mut known = false;
        for k in ITEM_KINDS {
            if k == word {
                known = true;
            }
        }
        if !known {
            return word;
        }
        i = j + 1;
    }
    b""
}

// Whether name holds --find's word at the start of one of its words (its
// own start, after a `_`, or a capital after a small letter: `clamp` finds
// clamp, set_lod_min_clamp and ClampToEdge; PI finds PI and FRAC_PI_2, not
// EPIPE), in any case when the word has no capital letter (smart case).
pub fn name_found(name: &[u8], tcx: &Tcx<Comp>) -> bool {
    if tcx.opt_find == 0 as *mut u8 {
        return true;
    }
    let w = c_slice(tcx.opt_find);
    let mut any_case = true;
    for x in 0..w.len() {
        if w[x] >= b'A' && w[x] <= b'Z' {
            any_case = false;
        }
    }
    let mut i: i64 = 0;
    while i + w.len() as i64 <= name.len() as i64 {
        let p = if i > 0 { name[(i - 1) as usize] } else { b'_' };
        let small = (p >= b'a' && p <= b'z') || (p >= b'0' && p <= b'9');
        let big = p >= b'A' && p <= b'Z';
        let capital = name[i as usize] >= b'A' && name[i as usize] <= b'Z';
        let starts_word = !(small || big) || (small && capital)
            || (w.len() > 0 && w[0] == b'_');
        let mut same = starts_word;
        let mut x: i64 = 0;
        while same && x < w.len() as i64 {
            let mut c = name[(i + x) as usize];
            if any_case && c >= b'A' && c <= b'Z' {
                c = c + 32;
            }
            same = c == w[x as usize];
            x += 1;
        }
        if same {
            return true;
        }
        i += 1;
    }
    false
}

// (0.28.0) Whether name is one of std's own (`__assert_fmt`, `__IntBits`,
// `__rt`): what the compiler's made text and std's generic impls call,
// which no program is meant to name. An item of std so named is in no
// listing (--all: it is) and no completion (tools/lsp/complete.vl).
pub fn std_own_name(name: &[u8]) -> bool {
    name.len() > 2 && name[0] == b'_' && name[1] == b'_'
}

// Whether an item of kind k named name passes --kind and --find.
fn item_wanted(k: i64, name: &[u8], tcx: &Tcx<Comp>) -> bool {
    (tcx.opt_kind == 0 as *mut u8 || kind_listed(kind_name(k), tcx.opt_kind))
        && name_found(name, tcx)
}

// (0.25.3) With --find (and a --kind that takes `const`), the constants
// the language gives the primitive types (front/check/widen.vl's tables:
// `f64::consts::PI`, `f32::EPSILON`, `i64::MAX`) whose names hold the
// word, under their own header: a line a name (`-`: in no file), or with
// --names a line each; how many.
pub fn put_builtin_consts(out: i64, tcx: &Tcx<Comp>) -> i64 {
    if tcx.opt_find == 0 as *mut u8
        || !(tcx.opt_kind == 0 as *mut u8 || kind_listed(c"const", tcx.opt_kind)) {
        return 0;
    }
    let lines = buf_new();
    let mut n: i64 = 0;
    for (k, _, _) in FLOAT_CONSTS {
        if name_found(k, tcx) {
            put_builtin(lines, true, b"f64::consts::", k, tcx);
            put_builtin(lines, false, b"f32::consts::", k, tcx);
            put_builtin_end(lines, tcx);
            n += 2;
        }
    }
    for (k, _, _) in FLOAT_LIMITS {
        if name_found(k, tcx) {
            put_builtin(lines, true, b"f64::", k, tcx);
            put_builtin(lines, false, b"f32::", k, tcx);
            put_builtin_end(lines, tcx);
            n += 2;
        }
    }
    for k in ["MAX", "MIN"] {
        if name_found(k.as_bytes(), tcx) {
            let mut first = true;
            for t in ["i8::", "i16::", "i32::", "i64::", "u8::", "u16::", "u32::", "u64::"] {
                put_builtin(lines, first, t.as_bytes(), k.as_bytes(), tcx);
                first = false;
                n += 1;
            }
            put_builtin_end(lines, tcx);
        }
    }
    if n > 0 {
        buf_bytes(out, b"# the primitive types' constants\t<built in>\n");
        buf_append(out, lines);
    }
    n
}

// Built-in constant prefix+name: the first of its line (`-` for the line
// number, it is in no file) or after a comma; with --names its own line.
fn put_builtin(out: i64, first: bool, prefix: &[u8], name: &[u8], tcx: &Tcx<Comp>) {
    if tcx.show_opt_names {
        buf_bytes(out, b"const\t");
    } else {
        buf_bytes(out, if first { b"-\tconst\t" } else { b", " });
    }
    buf_bytes(out, prefix);
    buf_bytes(out, name);
    if tcx.show_opt_names {
        buf_byte(out, b'\n');
    }
}

fn put_builtin_end(out: i64, tcx: &Tcx<Comp>) {
    if !tcx.show_opt_names {
        buf_byte(out, b'\n');
    }
}

// (0.27.2.1, contracts-effects.md E3.6) `query items M --undeclared`: the
// functions `fix --only effects` declares (effects::check::declarable) in
// the modules (std: every module of std) that have no declaration, a line
// each (`LINE<TAB>NAME`), then `undeclared: N of M`. RULE: E3.6
fn query_undeclared(modules: &[i64], pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    let mut total: i64 = 0;
    let mut left: i64 = 0;
    for f in 0..pcx.fns.len() as i64 {
        if !crate::front::effects::check::declarable(f, pcx) {
            continue;
        }
        let m = pcx.fns[f as usize].module;
        let mut wanted = false;
        for i in 0..modules.len() as i64 {
            let q = modules[i as usize];
            if q == m || q == pcx.std_module && within_std(m, pcx) {
                wanted = true;
            }
        }
        if !wanted {
            continue;
        }
        total += 1;
        if pcx.fns[f as usize].effect_decl != 0 {
            continue;
        }
        left += 1;
        buf_int(out, line_of(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx));
        buf_byte(out, b'\t');
        buf_bytes(out, sym_text(pcx.fns[f as usize].display, pcx));
        buf_byte(out, b'\n');
    }
    buf_str(out, c"undeclared: ");
    buf_int(out, left);
    buf_str(out, c" of ");
    buf_int(out, total);
    buf_byte(out, b'\n');
    buf_write_fd(out, STDOUT);
}

pub fn query_items(modules: &[i64], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if tcx.opt_undeclared {
        query_undeclared(modules, pcx);
        return;
    }
    let out = buf_new();
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    for d in 0..pcx.defs.len() as i64 {
        all.push(d);
    }
    sort_by_position(&mut all, tcx, pcx);
    // (0.25.3) --find, --kind: the items that pass, a module named
    // above its first; --names: a line an item
    let filtered = items_filtered(tcx);
    tcx.items_shown = 0;
    for i in 0..modules.len() as i64 {
        let m = (modules[i as usize]);
        let header = buf_new();
        buf_str(header, c"# ");
        buf_bytes(header, mod_fqn_text(m, tcx, pcx));
        let f = module_file(m, pcx);
        if f >= 0 {
            buf_byte(header, b'\t');
            put_path(header, f, pcx);
        }
        buf_byte(header, b'\n');
        let mut named = !filtered;
        if named {
            buf_append(out, header);
        }
        let mut impl_of: i64 = -1;
        let std = within_std(m, pcx);
        // (--comments: the banners and comments before each item)
        let mut banners: Vec<i64, Comp> = Vec::new_in(Comp {});
        if tcx.opt_banners && !filtered {
            banners_of_module(m, &mut banners, tcx, pcx);
        }
        let mut bk: i64 = 0;
        for j in 0..all.len() as i64 {
            let d = (all[j as usize]);
            if pcx.defs[d as usize].module != m || pcx.defs[d as usize].parent >= 0 {
                continue;
            }
            let k = pcx.defs[d as usize].kind;
            if std && !tcx.opt_all && !pcx.defs[d as usize].public && k != K_IMPL_METHOD {
                // (0.15: std's API; --all: its private items too)
                continue;
            }
            if std && !tcx.opt_all && std_own_name(sym_text(pcx.defs[d as usize].name, pcx)) {
                continue;
            }
            if filtered && !item_wanted(k, sym_text(pcx.defs[d as usize].name, pcx), tcx) {
                continue;
            }
            if !named {
                buf_append(out, header);
                named = true;
            }
            tcx.items_shown += 1;
            if tcx.show_opt_names {
                buf_str(out, kind_name(k));
                buf_byte(out, b'\t');
                buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
                buf_byte(out, b'\n');
                continue;
            }
            let mut at = text_start(d, pcx);
            if (k == K_METHOD || k == K_IMPL_METHOD) && impl_block(d, tcx, pcx) != impl_of {
                at = impl_start(d, tcx, pcx);
            }
            while bk < banners.len() as i64
                && (tcx.sections_b_start[(banners[bk as usize]) as usize])
                < at {
                put_banner_line(out, (banners[bk as usize]), tcx, pcx);
                bk += 1;
            }
            if k == K_METHOD || k == K_IMPL_METHOD {
                // (the functions of one impl block share its type node)
                let block = impl_block(d, tcx, pcx);
                if block != impl_of {
                    put_impl_header(out, d, tcx, pcx);
                    impl_of = block;
                }
            } else {
                impl_of = -1;
            }
            buf_int(out, line_of(pcx.defs[d as usize].name_pos, pcx));
            buf_byte(out, b'\t');
            buf_str(out, kind_name(k));
            buf_byte(out, b'\t');
            put_signature(out, d, tcx, pcx);
            buf_byte(out, b'\n');
        }
        while bk < banners.len() as i64 {
            put_banner_line(out, (banners[bk as usize]), tcx, pcx);
            bk += 1;
        }
        // (0.25.2.1) the names it re-exports
        if !filtered {
            crate::tools::query::reexported::put_reexports(out, m, tcx, pcx);
        }
    }
    buf_write_fd(out, STDOUT);
}

// (0.17) `query items TYPE`: a struct's, enum's or trait's own line, then
// the functions of its impl blocks (std's: its API), by position; the
// definitions of the types named are in `types`. (0.25.3) --find, --kind
// and --names as for a module.
pub fn query_type_items(types: &[i64], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    for d in 0..pcx.defs.len() as i64 {
        all.push(d);
    }
    sort_by_position(&mut all, tcx, pcx);
    let filtered = items_filtered(tcx);
    for i in 0..types.len() as i64 {
        let t = (types[i as usize]);
        buf_str(out, c"# ");
        buf_bytes(out, sym_text(pcx.defs[t as usize].fqn, pcx));
        buf_byte(out, b'\t');
        put_loc(out, pcx.defs[t as usize].name_pos, pcx);
        buf_byte(out, b'\n');
        if !tcx.show_opt_names && !filtered {
            buf_int(out, line_of(pcx.defs[t as usize].name_pos, pcx));
            buf_byte(out, b'\t');
            buf_str(out, kind_name(pcx.defs[t as usize].kind));
            buf_byte(out, b'\t');
            put_signature(out, t, tcx, pcx);
            buf_byte(out, b'\n');
        }
        let std = is_std_module(pcx.defs[t as usize].module, pcx);
        let mut impl_of: i64 = -1;
        for j in 0..all.len() as i64 {
            let d = (all[j as usize]);
            let k = pcx.defs[d as usize].kind;
            let mine = ((k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d as usize].owner >= 0
                && pcx.defs[d as usize].owner == pcx.defs[t as usize].fqn)
                || (k == K_TRAIT_FN && pcx.defs[d as usize].parent == t);
            if !mine || (std && !tcx.opt_all && !pcx.defs[d as usize].public && k == K_METHOD)
                || (std && !tcx.opt_all
                    && std_own_name(sym_text(pcx.defs[d as usize].name, pcx))) {
                continue;
            }
            if filtered && !item_wanted(k, sym_text(pcx.defs[d as usize].name, pcx), tcx) {
                continue;
            }
            tcx.items_shown += 1;
            if tcx.show_opt_names {
                buf_str(out, kind_name(k));
                buf_byte(out, b'\t');
                buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
                buf_byte(out, b'\n');
                continue;
            }
            if k == K_METHOD || k == K_IMPL_METHOD {
                let block = impl_block(d, tcx, pcx);
                if block != impl_of {
                    put_impl_header(out, d, tcx, pcx);
                    impl_of = block;
                }
            }
            buf_int(out, line_of(pcx.defs[d as usize].name_pos, pcx));
            buf_byte(out, b'\t');
            buf_str(out, kind_name(k));
            buf_byte(out, b'\t');
            put_signature(out, d, tcx, pcx);
            buf_byte(out, b'\n');
        }
    }
    buf_write_fd(out, STDOUT);
}
