// `query def`, `query show` and `query items`: a definition's location and
// signature, its source text with the comments above it, the module tree,
// and a module's items with their signatures.

use crate::base::{
    BUFS, IntVec, SOURCE_VOLE, SRC, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice,
    buf_str, buf_write_fd, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::NodeKind;
use crate::front::check::widen::{FLOAT_CONSTS, FLOAT_LIMITS};
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_count, within_std};
use crate::tools::ctx::Tcx;
use crate::tools::query::c_slice;
use crate::tools::query::defs::{
    K_CONST, K_ENUM, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STATIC, K_STRUCT, K_TRAIT, K_TRAIT_FN,
    bytes_eq, ends_with, find_in, kind_name, mod_fqn_text,
};
use crate::tools::query::diagnostics::{diag, put_word, try_begin, try_end, try_query};
use crate::tools::query::effects::put_def_effects;
use crate::tools::query::features::{put_def_features, put_intrinsic_notes};
use crate::tools::query::names::{canonical_name, path_matches};
use crate::tools::query::positions::{
    collapse, is_space, line_end, line_of, line_start, put_lines, put_loc, put_path,
    sort_by_position, token_at,
};
use crate::tools::query::refs::{file_text, kind_listed};
use crate::tools::query::sections::{banners_of_module, put_banner_line};
use crate::tools::query::stdq::{is_std_module, put_std_use};
use crate::tools::query::values::put_def_views;
use crate::tools::query_text::section_start;

// ---- def, show, items ----

// The end of definition d's signature (before its body or its value).
pub fn signature_end(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.restored {
            return tcx.c_sig_end.data[d];
        }
        let node = pcx.defs[d].node;
        let k = pcx.defs[d].kind;
        if (k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN)
            && pcx.nodes[node].kind == NodeKind::Fn && pcx.nodes[node].c != 0 {
            return pcx.nodes[pcx.nodes[node].c].start;
        }
        if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
            var i = token_at(pcx.defs[d].name_pos, pcx);
            while i < pcx.toks.len() as i64 && pcx.toks[i].kind != Tok::LBrace
                && pcx.toks[i].kind != Tok::Semi
                && pcx.toks[i].kind != Tok::Eof {
                i += 1;
            }
            return pcx.toks[i].start;
        }
        // (0.26.0) an embedded block: `embed wgsl K`, before its text
        if k == K_STATIC && pcx.nodes[node].kind == NodeKind::Embed && pcx.nodes[node].d >= 0 {
            return pcx.nodes[node].d - 1;
        }
        if k == K_MOD {
            return pcx.defs[d].name_pos + sym_text(pcx.defs[d].name, pcx).len as i64;
        }
        var end = pcx.defs[d].end;
        while end > pcx.defs[d].start
            && (SRC[end - 1] == ';' || SRC[end - 1] == ',' || is_space(SRC[end - 1])) {
            end -= 1;
        }
        end
    }
}

const LONG_SIGNATURE: i64 = 120;

pub fn put_signature(out: i64, d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        if pcx.defs[d].public && pcx.defs[d].kind != K_IMPL_METHOD {
            buf_str(out, c"pub ");
        }
        let mark = buf_slice(out).len as i64;
        collapse(out, pcx.defs[d].start, signature_end(d, tcx, pcx));
        let k = pcx.defs[d].kind;
        if (k == K_CONST || k == K_STATIC) && buf_slice(out).len as i64 - mark > LONG_SIGNATURE {
            // A long value: cut at its `=`.
            let text = buf_slice(out);
            let eq = find_in(text, c" = ", mark);
            if eq >= 0 {
                BUFS[out].len = eq;
                buf_str(out, c" = ...");
            }
        }
    }
}

pub fn query_def(matches: IntVec, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        for i in 0..matches.count {
            query_def_one(out, matches.data[i], tcx, &pcx);
        }
        buf_write_fd(out, STDOUT);
    }
}

// `PATH<TAB>FILE:LINE:COL<TAB>KIND<TAB>SIGNATURE` of definition d.
pub fn query_def_one(out: i64, d: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    buf_bytes(out, sym_text(pcx.defs[d].fqn, pcx));
    buf_byte(out, '\t');
    put_loc(out, pcx.defs[d].name_pos, &pcx);
    buf_byte(out, '\t');
    buf_str(out, kind_name(pcx.defs[d].kind));
    buf_byte(out, '\t');
    put_signature(out, d, tcx, pcx);
    // (0.16: a function's effects, effects.vl)
    put_def_effects(out, d, c"\t", tcx, pcx);
    // (0.17: its view summary, values.vl)
    put_def_views(out, d, c"\t", tcx, &pcx);
    put_def_features(out, d, c"\t", tcx, pcx);
    buf_byte(out, '\n');
}

// The start of the first line of definition d's text: the line of its
// start, and the comment and attribute lines right above it.
pub fn text_start(d: i64, pcx: Ctx<Comp>) -> i64 {
    var first = line_start(pcx.defs[d].start, pcx);
    let file_start = pcx.files[file_of_pos(first, pcx)].start;
    while first > file_start {
        let prev = line_start(first - 1, pcx);
        var a = prev;
        while a < first - 1 && (SRC[a] == ' ' || SRC[a] == '\t') {
            a += 1;
        }
        let comment = a + 1 < first && SRC[a] == '/' && SRC[a + 1] == '/';
        let attribute = a + 1 < first && SRC[a] == '#' && SRC[a + 1] == '[';
        if !comment && !attribute {
            break;
        }
        first = prev;
    }
    first
}

// More matches than this: `show` lists their paths only.
const SHOW_MAX: i64 = 5;

pub fn query_show(matches: IntVec, name: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        let n = matches.count;
        if n > SHOW_MAX {
            for i in 0..n {
                buf_bytes(out, sym_text(pcx.defs[matches.data[i]].fqn, pcx));
                buf_byte(out, '\n');
            }
            buf_write_fd(out, STDOUT);
            let d = diag(c"error", c"query.ambiguous", &tcx);
            buf_int(d, n);
            buf_str(d, c" definitions match '");
            buf_bytes(d, name);
            buf_str(d, c"'; showing paths only\n");
            try_query(c"show", sym_text(pcx.defs[matches.data[0]].fqn, pcx), &tcx, pcx);
            return 1;
        }
        for i in 0..n {
            let d = matches.data[i];
            let first = section_start(text_start(d, pcx), tcx, pcx);
            let last = line_end(if pcx.defs[d].end > pcx.defs[d].start { pcx.defs[d].end - 1 }
                else { pcx.defs[d].start }, pcx);
            buf_str(out, c"// ");
            buf_bytes(out, sym_text(pcx.defs[d].fqn, pcx));
            buf_byte(out, '\t');
            put_lines(out, first, last, &pcx);
            put_def_effects(out, d, c"\t", tcx, pcx);
            put_def_views(out, d, c"\t", tcx, &pcx);
            put_def_features(out, d, c"\t", tcx, pcx);
            buf_byte(out, '\n');
            put_intrinsic_notes(out, d, tcx, pcx);
            put_std_use(out, d, tcx, &pcx);
            buf_bytes(out, SRC[first..last]);
            buf_byte(out, '\n');
            // (0.25.3) a struct's or enum's methods
            put_type_methods(out, d, &tcx, pcx);
        }
        buf_write_fd(out, STDOUT);
        0
    }
}

// (0.25.3) More methods than this: `show TYPE` lists these (--all: every
// one) and says how to see the rest.
const SHOW_METHODS: i64 = 50;

// (0.25.3) After a struct's or enum's source in `show`: its methods, one
// signature line each from every impl block (std's: its API), by
// position; a contract cut to its keyword (`query items TYPE` has it
// whole), a trait impl's function marked with its `impl ... for ...`. The
// round 3 eval's agents fell back to `query items`, whose answer was 170
// lines, to find a type's methods.
fn put_type_methods(out: i64, t: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    // UNSAFE: DEFS is the query tables' raw array (defs.vl), read as the
    // rest of show.vl reads it (the tables become Vecs in the 0.25.4 audit)
    // SAFETY: t is a definition (resolve_name's) and d runs below DEF_COUNT:
    // both index DEFS's DEF_COUNT entries, filled by load_program or
    // cache_restore before any answer
    unsafe {
        let k0 = pcx.defs[t].kind;
        if k0 != K_STRUCT && k0 != K_ENUM {
            return;
        }
        let std = is_std_module(pcx.defs[t].module, pcx);
        var methods = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d].kind;
            if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner >= 0
                && pcx.defs[d].owner == pcx.defs[t].fqn
                && !(std && !tcx.opt_all && !pcx.defs[d].public
                    && k == K_METHOD) {
                methods.push(d);
            }
        }
        if methods.count == 0 {
            return;
        }
        sort_by_position(methods, tcx, pcx);
        let name = sym_text(pcx.defs[t].fqn, pcx);
        buf_str(out, c"// ");
        buf_int(out, methods.count);
        buf_str(out, if methods.count == 1 { c" method" } else { c" methods" });
        buf_str(out, c" (with their lines and whole contracts: query items ");
        buf_bytes(out, name);
        buf_str(out, c")\n");
        let shown = if tcx.opt_all || methods.count <= SHOW_METHODS { methods.count }
            else { SHOW_METHODS };
        for i in 0..shown {
            let d = methods.data[i];
            put_short_signature(out, d, tcx, pcx);
            if pcx.defs[d].kind == K_IMPL_METHOD {
                buf_str(out, c"  // ");
                var to = 0;
                let from = impl_header_span(d, &to, tcx, pcx);
                collapse(out, from, to);
            }
            buf_byte(out, '\n');
        }
        if shown < methods.count {
            let n = diag(c"note", c"query.truncated", &tcx);
            buf_bytes(n, name);
            buf_str(n, c" has ");
            buf_int(n, methods.count);
            buf_str(n, c" methods; showing the first ");
            buf_int(n, shown);
            buf_byte(n, '\n');
            let tr = try_begin(c"show", name, true, &tcx, pcx);
            put_word(tr, c_slice(c"--all"));
            try_end(tr);
            try_query(c"items", name, &tcx, pcx);
        }
    }
}

// (0.25.3) Definition d's signature on one line, a contract cut to its
// keyword (`requires ...`): `show TYPE`'s method lines.
fn put_short_signature(out: i64, d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    let mark = buf_slice(out).len as i64;
    put_signature(out, d, tcx, pcx);
    let text = buf_slice(out);
    var cut = -1;
    for kw in [c" requires ", c" ensures "] {
        let at = find_in(text, kw, mark);
        if at >= 0 && (cut < 0 || at < cut) {
            cut = at;
        }
    }
    if cut >= 0 {
        let word = if find_in(text, c" requires ", mark) == cut { c" requires ..." }
            else { c" ensures ..." };
        // UNSAFE: BUFS is base's raw table of buffers; cutting one is
        // setting its len, as put_signature does for a long value
        // SAFETY: out is a live buffer (buf_new's) and cut lies within its
        // text (find_in found it there), so the new len is in bounds
        unsafe {
            BUFS[out].len = cut;
        }
        buf_str(out, word);
    }
}

// The modules answering to `name` (all of them for none), in `out`; a
// file's path (`x.vl`, `./x.vl`, `a/b/`) names the modules of its
// files (0.15).
pub fn find_modules(name0: [u8], exact: bool, out: inout IntVec, tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>) {
    let name = canonical_name(name0);
    let is_file = name.len > 0 && (name[0] == '<' || find_in(name, c"/", 0) >= 0
        || find_in(name, c".vl", 0) >= 0 || find_in(name, c".vl", 0) >= 0);
    for m in 0..module_count(pcx) {
        if pcx.modules[m].name < 0 && m != 0 {
            continue;
        }
        let fqn = mod_fqn_text(m, &tcx, &pcx);
        if is_file {
            let f = module_file(m, pcx);
            if f >= 0 && pcx.files[f].module == m && path_matches(file_text(f, pcx), name) {
                out.push(m);
            }
        } else if name.len == 0 || bytes_eq(fqn, name) || ends_with(fqn, name, exact) {
            out.push(m);
        }
    }
}

// The module tree: each module's path, file and number of items.
pub fn query_modules(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let empty = intern_c(c"", &pcx);
        find_modules(sym_text(empty, pcx), false, &all, &tcx, &pcx);
        for i in 0..all.count {
            let m = all.data[i];
            var items = 0;
            var first = -1;
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d].module == m && pcx.defs[d].parent < 0 {
                    items += 1;
                    if first < 0 {
                        first = d;
                    }
                }
            }
            buf_bytes(out, mod_fqn_text(m, &tcx, &pcx));
            buf_byte(out, '\t');
            let f = module_file(m, pcx);
            if f >= 0 {
                put_path(out, f, pcx);
            }
            buf_byte(out, '\t');
            buf_int(out, items);
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
    }
}

// The file of module m (an inline module's is its parent's), or -1.
pub fn module_file(m: i64, pcx: Ctx<Comp>) -> i64 {
    for f in 0..pcx.files.len() as i64 {
        if pcx.files[f].module == m && pcx.files[f].kind == SOURCE_VOLE {
            return f;
        }
    }
    if m > 0 && pcx.modules[m].parent >= 0 { module_file(pcx.modules[m].parent, pcx) }
    else { -1 }
}

// The impl block of function definition d (its impl node, or the type
// node the functions of one block share), and the span of its `impl ...`
// header, from its start to its `{` (in *to).
pub fn impl_block(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.restored {
            return tcx.c_block.data[d];
        }
        if pcx.defs[d].impl_node != 0 { pcx.defs[d].impl_node }
        else { pcx.nodes[pcx.defs[d].node].h }
    }
}

pub fn impl_header_span(d: i64, to: inout i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.restored {
            to = tcx.c_hdr_to.data[d];
            return tcx.c_hdr_from.data[d];
        }
        let node = pcx.defs[d].node;
        var from = 0;
        if pcx.defs[d].impl_node != 0 {
            from = pcx.nodes[pcx.defs[d].impl_node].start;
        } else {
            var i = token_at(pcx.nodes[pcx.nodes[node].h].start, pcx) - 1;
            while i > 0 && pcx.toks[i].kind != Tok::Impl {
                i -= 1;
            }
            from = pcx.toks[i].start;
        }
        var j = token_at(from, pcx);
        while j < pcx.toks.len() as i64 && pcx.toks[j].kind != Tok::LBrace
            && pcx.toks[j].kind != Tok::Eof {
            j += 1;
        }
        to = pcx.toks[j].start;
        from
    }
}

// The start of the `impl` of the impl block of function definition d.
fn impl_start(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    var to = 0;
    impl_header_span(d, &to, tcx, pcx)
}

// The `impl ... {` header of the impl block of function definition d.
fn put_impl_header(out: i64, d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    var to = 0;
    let from = impl_header_span(d, &to, tcx, pcx);
    buf_int(out, line_of(from, pcx));
    buf_str(out, c"\timpl\t");
    collapse(out, from, to);
    buf_byte(out, '\n');
}

pub fn items_filtered(tcx: Tcx<Comp>) -> bool {
    tcx.opt_find != 0 as *u8 || tcx.opt_kind != 0 as *u8
}

// The kinds --kind takes for `items`, as kind_name spells them.
const ITEM_KINDS: [[u8]; 10] = ["fn", "method", "struct", "enum", "trait", "trait-method", "const",
    "static", "type", "mod"];

// The first word of --kind's list that is no kind of item, or "".
pub fn bad_item_kind(tcx: Tcx<Comp>) -> [u8] {
    if tcx.opt_kind == 0 as *u8 {
        return "";
    }
    let list = c_slice(tcx.opt_kind);
    var i = 0;
    while i < list.len as i64 {
        var j = i;
        while j < list.len as i64 && list[j] != ',' {
            j += 1;
        }
        let word = list[i..j];
        var known = false;
        for k in ITEM_KINDS {
            if k == word {
                known = true;
            }
        }
        if !known {
            return word;
        }
        i = j + 1;
    }
    ""
}

// Whether name holds --find's word at the start of one of its words (its
// own start, after a `_`, or a capital after a small letter: `clamp` finds
// clamp, set_lod_min_clamp and ClampToEdge; PI finds PI and FRAC_PI_2, not
// EPIPE), in any case when the word has no capital letter (smart case).
pub fn name_found(name: [u8], tcx: Tcx<Comp>) -> bool {
    if tcx.opt_find == 0 as *u8 {
        return true;
    }
    let w = c_slice(tcx.opt_find);
    var any_case = true;
    for x in 0..w.len {
        if w[x] >= 'A' && w[x] <= 'Z' {
            any_case = false;
        }
    }
    var i = 0;
    while i + w.len as i64 <= name.len as i64 {
        let p = if i > 0 { name[i - 1] } else { '_' };
        let small = (p >= 'a' && p <= 'z') || (p >= '0' && p <= '9');
        let big = p >= 'A' && p <= 'Z';
        let capital = name[i] >= 'A' && name[i] <= 'Z';
        let starts_word = !(small || big) || (small && capital)
            || (w.len > 0 && w[0] == '_');
        var same = starts_word;
        var x = 0;
        while same && x < w.len as i64 {
            var c = name[i + x];
            if any_case && c >= 'A' && c <= 'Z' {
                c = c + 32;
            }
            same = c == w[x];
            x += 1;
        }
        if same {
            return true;
        }
        i += 1;
    }
    false
}

// Whether an item of kind k named name passes --kind and --find.
fn item_wanted(k: i64, name: [u8], tcx: Tcx<Comp>) -> bool {
    (tcx.opt_kind == 0 as *u8 || kind_listed(kind_name(k), tcx.opt_kind)) && name_found(name, tcx)
}

// (0.25.3) With --find (and a --kind that takes `const`), the constants
// the language gives the primitive types (front/check/widen.vl's tables:
// `f64::consts::PI`, `f32::EPSILON`, `i64::MAX`) whose names hold the
// word, under their own header: a line a name (`-`: in no file), or with
// --names a line each; how many.
pub fn put_builtin_consts(out: i64, tcx: Tcx<Comp>) -> i64 {
    if tcx.opt_find == 0 as *u8
        || !(tcx.opt_kind == 0 as *u8 || kind_listed(c"const", tcx.opt_kind)) {
        return 0;
    }
    let lines = buf_new();
    var n = 0;
    for (k, _, _) in FLOAT_CONSTS {
        if name_found(k, tcx) {
            put_builtin(lines, true, "f64::consts::", k, tcx);
            put_builtin(lines, false, "f32::consts::", k, tcx);
            put_builtin_end(lines, tcx);
            n += 2;
        }
    }
    for (k, _, _) in FLOAT_LIMITS {
        if name_found(k, tcx) {
            put_builtin(lines, true, "f64::", k, tcx);
            put_builtin(lines, false, "f32::", k, tcx);
            put_builtin_end(lines, tcx);
            n += 2;
        }
    }
    for k in ["MAX", "MIN"] {
        if name_found(k, tcx) {
            var first = true;
            for t in ["i8::", "i16::", "i32::", "i64::", "u8::", "u16::", "u32::", "u64::"] {
                put_builtin(lines, first, t, k, tcx);
                first = false;
                n += 1;
            }
            put_builtin_end(lines, tcx);
        }
    }
    if n > 0 {
        buf_bytes(out, "# the primitive types' constants\t<built in>\n");
        buf_bytes(out, buf_slice(lines));
    }
    n
}

// Built-in constant prefix+name: the first of its line (`-` for the line
// number, it is in no file) or after a comma; with --names its own line.
fn put_builtin(out: i64, first: bool, prefix: [u8], name: [u8], tcx: Tcx<Comp>) {
    if tcx.show_opt_names {
        buf_bytes(out, "const\t");
    } else {
        buf_bytes(out, if first { "-\tconst\t" } else { ", " });
    }
    buf_bytes(out, prefix);
    buf_bytes(out, name);
    if tcx.show_opt_names {
        buf_byte(out, '\n');
    }
}

fn put_builtin_end(out: i64, tcx: Tcx<Comp>) {
    if !tcx.show_opt_names {
        buf_byte(out, '\n');
    }
}

pub fn query_items(modules: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            all.push(d);
        }
        sort_by_position(all, tcx, pcx);
        // (0.25.3) --find, --kind: the items that pass, a module named
        // above its first; --names: a line an item
        let filtered = items_filtered(tcx);
        tcx.items_shown = 0;
        for i in 0..modules.count {
            let m = modules.data[i];
            let header = buf_new();
            buf_str(header, c"# ");
            buf_bytes(header, mod_fqn_text(m, &tcx, &pcx));
            let f = module_file(m, pcx);
            if f >= 0 {
                buf_byte(header, '\t');
                put_path(header, f, pcx);
            }
            buf_byte(header, '\n');
            var named = !filtered;
            if named {
                buf_bytes(out, buf_slice(header));
            }
            var impl_of = -1;
            let std = within_std(m, pcx);
            // (--comments: the banners and comments before each item)
            var banners = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if tcx.opt_banners && !filtered {
                banners_of_module(m, &banners, &tcx, &pcx);
            }
            var bk = 0;
            for j in 0..all.count {
                let d = all.data[j];
                if pcx.defs[d].module != m || pcx.defs[d].parent >= 0 {
                    continue;
                }
                let k = pcx.defs[d].kind;
                if std && !tcx.opt_all && !pcx.defs[d].public && k != K_IMPL_METHOD {
                    // (0.15: std's API; --all: its private items too)
                    continue;
                }
                if filtered && !item_wanted(k, sym_text(pcx.defs[d].name, pcx), tcx) {
                    continue;
                }
                if !named {
                    buf_bytes(out, buf_slice(header));
                    named = true;
                }
                tcx.items_shown += 1;
                if tcx.show_opt_names {
                    buf_str(out, kind_name(k));
                    buf_byte(out, '\t');
                    buf_bytes(out, sym_text(pcx.defs[d].fqn, pcx));
                    buf_byte(out, '\n');
                    continue;
                }
                var at = text_start(d, pcx);
                if (k == K_METHOD || k == K_IMPL_METHOD) && impl_block(d, tcx, pcx) != impl_of {
                    at = impl_start(d, tcx, pcx);
                }
                while bk < banners.count && tcx.sections_b_start.data[banners.data[bk]] < at {
                    put_banner_line(out, banners.data[bk], tcx, pcx);
                    bk += 1;
                }
                if k == K_METHOD || k == K_IMPL_METHOD {
                    // (the functions of one impl block share its type node)
                    let block = impl_block(d, tcx, pcx);
                    if block != impl_of {
                        put_impl_header(out, d, tcx, pcx);
                        impl_of = block;
                    }
                } else {
                    impl_of = -1;
                }
                buf_int(out, line_of(pcx.defs[d].name_pos, pcx));
                buf_byte(out, '\t');
                buf_str(out, kind_name(k));
                buf_byte(out, '\t');
                put_signature(out, d, tcx, pcx);
                buf_byte(out, '\n');
            }
            while bk < banners.count {
                put_banner_line(out, banners.data[bk], tcx, pcx);
                bk += 1;
            }
            // (0.25.2.1) the names it re-exports
            if !filtered {
                crate::tools::query::reexported::put_reexports(out, m, &tcx, &pcx);
            }
        }
        buf_write_fd(out, STDOUT);
    }
}

// (0.17) `query items TYPE`: a struct's, enum's or trait's own line, then
// the functions of its impl blocks (std's: its API), by position; the
// definitions of the types named are in `types`. (0.25.3) --find, --kind
// and --names as for a module.
pub fn query_type_items(types: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            all.push(d);
        }
        sort_by_position(all, tcx, pcx);
        let filtered = items_filtered(tcx);
        for i in 0..types.count {
            let t = types.data[i];
            buf_str(out, c"# ");
            buf_bytes(out, sym_text(pcx.defs[t].fqn, pcx));
            buf_byte(out, '\t');
            put_loc(out, pcx.defs[t].name_pos, &pcx);
            buf_byte(out, '\n');
            if !tcx.show_opt_names && !filtered {
                buf_int(out, line_of(pcx.defs[t].name_pos, pcx));
                buf_byte(out, '\t');
                buf_str(out, kind_name(pcx.defs[t].kind));
                buf_byte(out, '\t');
                put_signature(out, t, tcx, pcx);
                buf_byte(out, '\n');
            }
            let std = is_std_module(pcx.defs[t].module, pcx);
            var impl_of = -1;
            for j in 0..all.count {
                let d = all.data[j];
                let k = pcx.defs[d].kind;
                let mine = ((k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner >= 0
                    && pcx.defs[d].owner == pcx.defs[t].fqn)
                    || (k == K_TRAIT_FN && pcx.defs[d].parent == t);
                if !mine || (std && !tcx.opt_all && !pcx.defs[d].public && k == K_METHOD) {
                    continue;
                }
                if filtered && !item_wanted(k, sym_text(pcx.defs[d].name, pcx), tcx) {
                    continue;
                }
                tcx.items_shown += 1;
                if tcx.show_opt_names {
                    buf_str(out, kind_name(k));
                    buf_byte(out, '\t');
                    buf_bytes(out, sym_text(pcx.defs[d].fqn, pcx));
                    buf_byte(out, '\n');
                    continue;
                }
                if k == K_METHOD || k == K_IMPL_METHOD {
                    let block = impl_block(d, tcx, pcx);
                    if block != impl_of {
                        put_impl_header(out, d, tcx, pcx);
                        impl_of = block;
                    }
                }
                buf_int(out, line_of(pcx.defs[d].name_pos, pcx));
                buf_byte(out, '\t');
                buf_str(out, kind_name(k));
                buf_byte(out, '\t');
                put_signature(out, d, tcx, pcx);
                buf_byte(out, '\n');
            }
        }
        buf_write_fd(out, STDOUT);
    }
}
