// Source positions for `query`: the line of a position, `FILE:LINE`, a
// span of source collapsed to one line, the token at a position; the
// definitions sorted by position (files in output order), and the
// definition that encloses a position.

use crate::base::{buf_byte, buf_bytes, buf_int, buf_new, buf_str, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{FIELD_SHORTHAND, NodeKind};
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::stdtree::std_file_line;
use crate::tools::ctx::{Tcx, zeros};
use crate::tools::query::defs::{K_FIELD, K_MOD, K_VARIANT};

// ---- Positions ----

pub fn init_positions(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let end = pcx.files[(pcx.files.len() as i64 - 1) as usize].end;
    pcx.lines.push(0);
    for i in 0..end {
        if get_src()[i as usize] == b'\n' {
            pcx.lines.push(i + 1);
        }
    }
    for f in 0..pcx.files.len() as i64 {
        let mut rank: i64 = 0;
        for g in 0..pcx.files.len() as i64 {
            if file_before(g, f, pcx) {
                rank += 1;
            }
        }
        tcx.file_rank.push(rank);
    }
}

fn file_before(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let x = pcx.files[a as usize].path;
        let y = pcx.files[b as usize].path;
        let xs = (*x.add(0)) == b'<';
        let ys = (*y.add(0)) == b'<';
        if xs != ys {
            return ys;
        }
        let mut i: i64 = 0;
        while (*x.add(i as usize)) != 0 && (*x.add(i as usize)) == (*y.add(i as usize)) {
            i += 1;
        }
        if (*x.add(i as usize)) != (*y.add(i as usize)) {
            return (*x.add(i as usize)) < (*y.add(i as usize));
        }
        a < b
    }
}

// The index in LINES of the line holding pos.
pub fn line_index(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.lines.len() as i64 - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if (pcx.lines[mid as usize]) <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// The line number of pos in its file.
pub fn line_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    line_index(pos, pcx) - line_index(pcx.files[file_of_pos(pos, pcx) as usize].start, pcx) + 1
}

pub fn line_start(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    (pcx.lines[line_index(pos, pcx) as usize])
}

// The end of the line holding pos (its newline).
pub fn line_end(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let i = line_index(pos, pcx);
    if i + 1 < pcx.lines.len() as i64 { (pcx.lines[(i + 1) as usize]) - 1 }
    else { pcx.files[(pcx.files.len() as i64 - 1) as usize].end }
}

pub fn put_path(out: i64, f: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let mut p = pcx.files[f as usize].path;
        while (*p.add(0)) == b'.' && (*p.add(1)) == b'/' {
            p = p.add(2);
        }
        buf_str(out, p);
    }
}

// `file:line:col` (0.17: in std's built-in text, in std's file when the
// vole repository has it: front/stdtree.vl).
pub fn put_loc(out: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let f = file_of_pos(pos, pcx);
    let mut path = 0 as *mut u8;
    let mut line: i64 = 0;
    if std_file_line(f, pos, &mut path, &mut line, pcx) {
        buf_str(out, path);
    } else {
        put_path(out, f, pcx);
        line = line_of(pos, pcx);
    }
    buf_byte(out, b':');
    buf_int(out, line);
    buf_byte(out, b':');
    buf_int(out, pos - line_start(pos, pcx) + 1);
}

// (0.17) `file:A-B`, the lines of first..last (in one file; in std's file
// as put_loc says).
pub fn put_lines(out: i64, first: i64, last: i64, pcx: &mut Ctx<Comp>) {
    let f = file_of_pos(first, pcx);
    let mut path = 0 as *mut u8;
    let mut a: i64 = 0;
    let mut b: i64 = 0;
    if std_file_line(f, first, &mut path, &mut a, pcx)
        && std_file_line(f, last, &mut path, &mut b, pcx) {
        buf_str(out, path);
    } else {
        put_path(out, f, pcx);
        a = line_of(first, pcx);
        b = line_of(last, pcx);
    }
    buf_byte(out, b':');
    buf_int(out, a);
    buf_byte(out, b'-');
    buf_int(out, b);
}

// (0.15) Whether pos is the name of a field shorthand, `S { x }`: both the
// field x and the value x, so a rename of one writes `x: y` or `y: x`.
pub fn shorthand_at(pos: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for n in tcx.shorthands_from..pcx.nodes.len() as i64 {
        if n > 0 && pcx.nodes[n as usize].kind == NodeKind::FieldInit
            && (pcx.nodes[n as usize].p & FIELD_SHORTHAND) != 0 {
            tcx.shorthands.put(pcx.nodes[n as usize].start + 1, 1);
        }
    }
    tcx.shorthands_from = pcx.nodes.len() as i64;
    tcx.shorthands.get(pos + 1) != 0
}

// (0.15) The text a field shorthand's name becomes when the field or the
// value it names is renamed: `field: value`.
pub fn shorthand_text(field: &[u8], value: &[u8]) -> i64 {
    let b = buf_new();
    buf_bytes(b, field);
    buf_bytes(b, b": ");
    buf_bytes(b, value);
    b
}

pub fn is_space(c: u8) -> bool {
    c == b' ' || c == b'\t' || c == b'\r' || c == b'\n'
}

// The text of from..to with each run of whitespace (and `//` comments)
// one space, trimmed.
pub fn collapse(out: i64, from: i64, to: i64) {
    let mut space = false;
    let mut any = false;
    let mut i = from;
    while i < to {
        let c = get_src()[i as usize];
        if c == b'/' && i + 1 < to && get_src()[(i + 1) as usize] == b'/' {
            while i < to && get_src()[i as usize] != b'\n' {
                i += 1;
            }
            space = true;
            continue;
        }
        if is_space(c) {
            space = true;
        } else {
            if space && any {
                buf_byte(out, b' ');
            }
            space = false;
            any = true;
            buf_byte(out, c);
        }
        i += 1;
    }
}

// The first token starting at or after pos.
pub fn token_at(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.toks.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if pcx.toks[mid as usize].start < pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

// Where identifier `name` is written in from..to (to < 0: in the next
// few tokens): its first occurrence, or its last; -1 if nowhere.
pub fn find_name(from: i64, to: i64, name: i64, last: bool, pcx: &Ctx<Comp>) -> i64 {
    let mut i = token_at(from, pcx);
    let mut seen: i64 = 0;
    let mut found: i64 = -1;
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Tok::Eof {
        if to >= 0 && pcx.toks[i as usize].start >= to {
            break;
        }
        if to < 0 && seen > 24 {
            break;
        }
        if pcx.toks[i as usize].kind == Tok::Ident && pcx.toks[i as usize].value as i64 == name {
            found = pcx.toks[i as usize].start;
            if !last {
                return found;
            }
        }
        seen += 1;
        i += 1;
    }
    found
}

// The position of definition name `name` after `start` (its keyword).
pub fn name_position(start: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let p = find_name(start, -1, name, false, pcx);
    if p < 0 { start } else { p }
}

// ---- Sorting ----

// Sorts the indices in v (merge sort) by key1, then key2 (slices indexed
// by the values).
pub fn sort_by_keys(v: &mut Vec<i64, Comp>, key1: &[i64], key2: &[i64]) {
    let n = v.len();
    if n < 2 {
        return;
    }
    let mut tmp: Vec<i64, Comp> = Vec::new_in(Comp {});
    tmp.resize(n, 0);
    let mut width: usize = 1;
    while width < n {
        let mut lo: usize = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            while i < mid || j < hi {
                let take_j = i >= mid
                    || (j < hi
                        && (key1[v[j] as usize] < key1[v[i] as usize]
                            || (key1[v[j] as usize] == key1[v[i] as usize]
                                && key2[v[j] as usize] < key2[v[i] as usize])));
                if take_j {
                    tmp[k] = v[j];
                    j += 1;
                } else {
                    tmp[k] = v[i];
                    i += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        for x in 0..n {
            v[x] = tmp[x];
        }
        width *= 2;
    }
}

// The sort keys of positions: (file rank, position).
pub fn rank_of(pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    (tcx.file_rank[file_of_pos(pos, pcx) as usize])
}

// Sorts definitions by file, then position.
pub fn sort_by_position(v: &mut Vec<i64, Comp>, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let n = pcx.defs.len() as i64;
        let mut k1 = zeros(n + 1);
        let mut k2 = zeros(n + 1);
        for i in 0..v.len() as i64 {
            let d = (v[i as usize]);
            (k1[d as usize]) = rank_of(pcx.defs[d as usize].start, tcx, pcx);
            (k2[d as usize]) = pcx.defs[d as usize].start;
        }
        sort_by_keys(v, &k1, &k2);
    }
}

// ---- Enclosing definitions ----

pub fn init_containers(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d as usize].kind;
            if k != K_FIELD && k != K_VARIANT && k != K_MOD {
                tcx.containers.push(d);
            }
        }
        let mut k1 = zeros(pcx.defs.len() as i64 + 1);
        let mut k2 = zeros(pcx.defs.len() as i64 + 1);
        for d in 0..pcx.defs.len() {
            (k1[d]) = pcx.defs[d].start;
            (k2[d]) = -pcx.defs[d].end;
        }
        sort_by_keys(&mut tcx.containers, &k1, &k2);
    }
}

// The innermost definition holding pos, or -1.
pub fn enclosing(pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = tcx.containers.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if pcx.defs[(tcx.containers[mid as usize]) as usize].start <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    // (items do not overlap, except a trait and its functions: a few
    // steps back at most)
    let mut i = lo - 1;
    let mut steps: i64 = 0;
    while i >= 0 && steps < 64 {
        let d = (tcx.containers[i as usize]);
        if pcx.defs[d as usize].end > pos {
            return d;
        }
        i -= 1;
        steps += 1;
    }
    -1
}
