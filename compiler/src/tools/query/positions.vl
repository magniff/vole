// Source positions for `query`: the line of a position, `FILE:LINE`, a
// span of source collapsed to one line, the token at a position; the
// definitions sorted by position (files in output order), and the
// definition that encloses a position.

use crate::base::{IntVec, SRC, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_str, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{FIELD_SHORTHAND, NodeKind};
use crate::front::lexer::Tok;
use crate::front::modules::file_of_pos;
use crate::front::stdtree::std_file_line;
use crate::tools::ctx::Tcx;
use crate::tools::query::defs::{K_FIELD, K_MOD, K_VARIANT};

// ---- Positions ----

pub fn init_positions(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let end = pcx.files[pcx.files.len() as i64 - 1].end;
    pcx.lines.push(0);
    for i in 0..end {
        if SRC[i] == '\n' {
            pcx.lines.push(i + 1);
        }
    }
    for f in 0..pcx.files.len() as i64 {
        var rank = 0;
        for g in 0..pcx.files.len() as i64 {
            if file_before(g, f, pcx) {
                rank += 1;
            }
        }
        tcx.file_rank.push(rank);
    }
}

fn file_before(a: i64, b: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let x = pcx.files[a].path;
        let y = pcx.files[b].path;
        let xs = x[0] == '<';
        let ys = y[0] == '<';
        if xs != ys {
            return ys;
        }
        var i = 0;
        while x[i] != 0 && x[i] == y[i] {
            i += 1;
        }
        if x[i] != y[i] {
            return x[i] < y[i];
        }
        a < b
    }
}

// The index in LINES of the line holding pos.
pub fn line_index(pos: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var lo = 0;
        var hi = pcx.lines.count - 1;
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if pcx.lines.data[mid] <= pos {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

// The line number of pos in its file.
pub fn line_of(pos: i64, pcx: Ctx<Comp>) -> i64 {
    line_index(pos, pcx) - line_index(pcx.files[file_of_pos(pos, pcx)].start, pcx) + 1
}

pub fn line_start(pos: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe { pcx.lines.data[line_index(pos, pcx)] }
}

// The end of the line holding pos (its newline).
pub fn line_end(pos: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let i = line_index(pos, pcx);
        if i + 1 < pcx.lines.count { pcx.lines.data[i + 1] - 1 }
        else { pcx.files[pcx.files.len() as i64 - 1].end }
    }
}

pub fn put_path(out: i64, f: i64, pcx: Ctx<Comp>) {
    unsafe {
        var p = pcx.files[f].path;
        while p[0] == '.' && p[1] == '/' {
            p = &p[2];
        }
        buf_str(out, p);
    }
}

// `file:line:col` (0.17: in std's built-in text, in std's file when the
// vole repository has it: front/stdtree.vl).
pub fn put_loc(out: i64, pos: i64, pcx: inout Ctx<Comp>) {
    let f = file_of_pos(pos, pcx);
    var path = 0 as *u8;
    var line = 0;
    if std_file_line(f, pos, &path, &line, &pcx) {
        buf_str(out, path);
    } else {
        put_path(out, f, pcx);
        line = line_of(pos, pcx);
    }
    buf_byte(out, ':');
    buf_int(out, line);
    buf_byte(out, ':');
    buf_int(out, pos - line_start(pos, pcx) + 1);
}

// (0.17) `file:A-B`, the lines of first..last (in one file; in std's file
// as put_loc says).
pub fn put_lines(out: i64, first: i64, last: i64, pcx: inout Ctx<Comp>) {
    let f = file_of_pos(first, pcx);
    var path = 0 as *u8;
    var a = 0;
    var b = 0;
    if std_file_line(f, first, &path, &a, &pcx) && std_file_line(f, last, &path, &b, &pcx) {
        buf_str(out, path);
    } else {
        put_path(out, f, pcx);
        a = line_of(first, pcx);
        b = line_of(last, pcx);
    }
    buf_byte(out, ':');
    buf_int(out, a);
    buf_byte(out, '-');
    buf_int(out, b);
}

// (0.15) Whether pos is the name of a field shorthand, `S { x }`: both the
// field x and the value x, so a rename of one writes `x: y` or `y: x`.
pub fn shorthand_at(pos: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    for n in tcx.shorthands_from..pcx.nodes.len() as i64 {
        if n > 0 && pcx.nodes[n].kind == NodeKind::FieldInit
            && (pcx.nodes[n].p & FIELD_SHORTHAND) != 0 {
            tcx.shorthands.put(pcx.nodes[n].start + 1, 1);
        }
    }
    tcx.shorthands_from = pcx.nodes.len() as i64;
    tcx.shorthands.get(pos + 1) != 0
}

// (0.15) The text a field shorthand's name becomes when the field or the
// value it names is renamed: `field: value`.
pub fn shorthand_text(field: [u8], value: [u8]) -> i64 {
    let b = buf_new();
    buf_bytes(b, field);
    buf_bytes(b, ": ");
    buf_bytes(b, value);
    b
}

pub fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

// The text of from..to with each run of whitespace (and `//` comments)
// one space, trimmed.
pub fn collapse(out: i64, from: i64, to: i64) {
    var space = false;
    var any = false;
    var i = from;
    while i < to {
        let c = SRC[i];
        if c == '/' && i + 1 < to && SRC[i + 1] == '/' {
            while i < to && SRC[i] != '\n' {
                i += 1;
            }
            space = true;
            continue;
        }
        if is_space(c) {
            space = true;
        } else {
            if space && any {
                buf_byte(out, ' ');
            }
            space = false;
            any = true;
            buf_byte(out, c);
        }
        i += 1;
    }
}

// The first token starting at or after pos.
pub fn token_at(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var lo = 0;
    var hi = pcx.toks.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if pcx.toks[mid].start < pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

// Where identifier `name` is written in from..to (to < 0: in the next
// few tokens): its first occurrence, or its last; -1 if nowhere.
pub fn find_name(from: i64, to: i64, name: i64, last: bool, pcx: Ctx<Comp>) -> i64 {
    var i = token_at(from, pcx);
    var seen = 0;
    var found = -1;
    while i < pcx.toks.len() as i64 && pcx.toks[i].kind != Tok::Eof {
        if to >= 0 && pcx.toks[i].start >= to {
            break;
        }
        if to < 0 && seen > 24 {
            break;
        }
        if pcx.toks[i].kind == Tok::Ident && pcx.toks[i].value as i64 == name {
            found = pcx.toks[i].start;
            if !last {
                return found;
            }
        }
        seen += 1;
        i += 1;
    }
    found
}

// The position of definition name `name` after `start` (its keyword).
pub fn name_position(start: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    let p = find_name(start, -1, name, false, pcx);
    if p < 0 { start } else { p }
}

// ---- Sorting ----

// Sorts the indices in v (merge sort) by key1, then key2 (arrays indexed
// by the values).
pub fn sort_by_keys(v: IntVec, key1: *i64, key2: *i64) {
    unsafe {
        let n = v.count;
        if n < 2 {
            return;
        }
        let tmp = alloc_array::<i64>(n);
        var width = 1;
        let a = v.data;
        while width < n {
            var lo = 0;
            while lo < n {
                let mid = if lo + width < n { lo + width } else { n };
                let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
                var i = lo;
                var j = mid;
                var k = lo;
                while i < mid || j < hi {
                    let take_j = i >= mid || (j < hi && (key1[a[j]] < key1[a[i]]
                        || (key1[a[j]] == key1[a[i]] && key2[a[j]] < key2[a[i]])));
                    if take_j {
                        tmp[k] = a[j];
                        j += 1;
                    } else {
                        tmp[k] = a[i];
                        i += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            for x in 0..n {
                a[x] = tmp[x];
            }
            width *= 2;
        }
        free(tmp as *u8);
    }
}

// The sort keys of positions: (file rank, position).
pub fn rank_of(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe { tcx.file_rank.data[file_of_pos(pos, pcx)] }
}

// Sorts definitions by file, then position.
pub fn sort_by_position(v: IntVec, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let n = pcx.defs.len() as i64;
        let k1 = alloc_array::<i64>(n + 1);
        let k2 = alloc_array::<i64>(n + 1);
        for i in 0..v.count {
            let d = v.data[i];
            k1[d] = rank_of(pcx.defs[d].start, tcx, pcx);
            k2[d] = pcx.defs[d].start;
        }
        sort_by_keys(v, k1, k2);
    }
}

// ---- Enclosing definitions ----

pub fn init_containers(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d].kind;
            if k != K_FIELD && k != K_VARIANT && k != K_MOD {
                tcx.containers.push(d);
            }
        }
        let k1 = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        let k2 = alloc_array::<i64>(pcx.defs.len() as i64 + 1);
        for d in 0..pcx.defs.len() {
            k1[d] = pcx.defs[d].start;
            k2[d] = -pcx.defs[d].end;
        }
        sort_by_keys(tcx.containers, k1, k2);
    }
}

// The innermost definition holding pos, or -1.
pub fn enclosing(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var lo = 0;
        var hi = tcx.containers.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if pcx.defs[tcx.containers.data[mid]].start <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        // (items do not overlap, except a trait and its functions: a few
        // steps back at most)
        var i = lo - 1;
        var steps = 0;
        while i >= 0 && steps < 64 {
            let d = tcx.containers.data[i];
            if pcx.defs[d].end > pos {
                return d;
            }
            i -= 1;
            steps += 1;
        }
        -1
    }
}
