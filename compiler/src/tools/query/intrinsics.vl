// `query arch WORDS... [--feature F] [--arch A] [--equiv NAME]` (0.19,
// docs/design/arch.md §2.9; `query intrinsics` is the same command): the
// intrinsic tables searched without reading a program. One intrinsic a
// line, `MODULE::NAME<TAB>FEATURES<TAB>INSTRUCTION<TAB>DOC`, the best
// matches first: every WORD (any case) in its name, features, instruction,
// doc, semantics or equivalent; when no intrinsic has them all, those
// with the most. `--feature F` keeps those that need F (alone: lists
// them), `--arch aarch64|x86_64|portable` one table, `--equiv NAME` the
// other architecture's equivalent of NAME and the intrinsics naming NAME
// as theirs. The answer is cut at --budget as any query's (budget.vl).

use crate::arch::{
    ARCH_AARCH64, ARCH_PORTABLE, ARCH_X86_64, F_DOC, F_EQUIV, F_FEATURES, F_INSN, F_SEMANTICS,
    intr_text, intrinsic_count, intrinsic_name,
};
use crate::arch::table::load_table;
use crate::arch::tables::intrinsics_source;
use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, buf_write_fd, streq, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_MISSING, EV_WORD, Leaf, flag, is_flag, is_opt, option, table};
use crate::tools::ctx::{Tcx, zeros};
use crate::tools::query::{c_slice, parse_count};
use crate::tools::query::diagnostics::{diag, put_cword, put_word};

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 } else { c }
}

// Whether text holds word (lower case), ignoring case.
fn holds(text: &[u8], word: &[u8]) -> bool {
    if word.len() == 0 || word.len() > text.len() {
        return false;
    }
    let mut i: i64 = 0;
    while i + word.len() as i64 <= text.len() as i64 {
        let mut k: i64 = 0;
        while k < word.len() as i64 && lower(text[(i + k) as usize]) == word[k as usize] {
            k += 1;
        }
        if k == word.len() as i64 {
            return true;
        }
        i += 1;
    }
    false
}

// Whether the comma-separated list holds the item (any case).
fn lists(list: &[u8], item: &[u8]) -> bool {
    let mut a: i64 = 0;
    while a < list.len() as i64 {
        let mut b = a;
        while b < list.len() as i64 && list[b as usize] != b',' {
            b += 1;
        }
        let mut s = a;
        while s < b && list[s as usize] == b' ' {
            s += 1;
        }
        let mut e = b;
        while e > s && list[(e - 1) as usize] == b' ' {
            e -= 1;
        }
        if e - s == item.len() as i64 {
            let mut k: i64 = 0;
            while k < item.len() as i64
                && lower(list[(s + k) as usize]) == lower(item[k as usize]) {
                k += 1;
            }
            if k == item.len() as i64 {
                return true;
            }
        }
        a = b + 1;
    }
    false
}

// The module an intrinsic is in, below std::arch ("" for std::arch).
fn module_prefix(id: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    unsafe {
        let a = (pcx.intrs[id as usize]).arch;
        if a == ARCH_AARCH64 { b"aarch64::" } else if a == ARCH_X86_64 { b"x86_64::" } else { b"" }
    }
}

// One intrinsic's line.
pub fn put_intrinsic_line(out: i64, id: i64, pcx: &Ctx<Comp>) {
    buf_bytes(out, module_prefix(id, pcx));
    buf_bytes(out, sym_text(intrinsic_name(id, pcx), pcx));
    buf_byte(out, b'\t');
    let f = intr_text(id, F_FEATURES, pcx);
    buf_bytes(out, if f == b"-" { b"-" } else { f });
    buf_byte(out, b'\t');
    buf_bytes(out, intr_text(id, F_INSN, pcx));
    buf_byte(out, b'\t');
    buf_bytes(out, intr_text(id, F_DOC, pcx));
    buf_byte(out, b'\n');
}

// The intrinsic named `name` (with or without its module path), or -1.
pub fn intrinsic_by_text(name0: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let mut a = name0.len() as i64;
    while a > 0 && name0[(a - 1) as usize] != b':' {
        a -= 1;
    }
    let name = &name0[a as usize..];
    for id in 0..intrinsic_count(pcx) {
        if sym_text(intrinsic_name(id, pcx), pcx) == name {
            return id;
        }
    }
    -1
}

// Plain words and the table's spellings of them: a word matches when it
// or one of its spellings does (`subtract`: the names say `sub`).
const SPELLINGS: [&[u8]; 28] = [
    b"subtract", b"sub", b"multiply", b"mul", b"minimum", b"min", b"maximum", b"max",
    b"equal", b"== b", b"compare", b"== b", b"search", b"== b", b"find", b"== b", b"memchr",
    b"== b", b"popcount", b"1 bits", b"popcnt", b"1 bits", b"byte", b"u8", b"bytes", b"u8",
    b"checksum", b"crc"];

// Whether `word` is in text, or a spelling of it.
fn holds_word(text: &[u8], word: &[u8]) -> bool {
    if holds(text, word) {
        return true;
    }
    let mut i: i64 = 0;
    while i + 1 < 28 {
        if SPELLINGS[i as usize] == word && holds(text, SPELLINGS[(i + 1) as usize]) {
            return true;
        }
        i += 2;
    }
    false
}

// Whether a NAME of def, show, context... is an intrinsic (`vqsubq_u8`,
// `_mm_movemask_epi8`, or any `arch::NAME`): each one's id is then in
// QUERY_WANTED, which the loader declares (arch/virtual.vl), and the
// program is read with std.
pub fn query_names_intrinsics(args: &[i64], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut any = false;
    for i in 0..args.len() as i64 {
        let name = c_slice((args[i as usize]) as *mut u8);
        let mut a = name.len() as i64;
        while a > 0 && name[(a - 1) as usize] != b':' {
            a -= 1;
        }
        let last = &name[a as usize..];
        if last.len() < 2 || !(last[0] == b'v' || last[0] == b'_' || holds(name, b"arch::")) {
            continue;
        }
        // (by the table's text: parsing it would intern its names before
        // the program's keywords)
        if tcx.table_text < 0 {
            tcx.table_text = buf_new();
            buf_byte(tcx.table_text, b'\n');
            intrinsics_source(tcx.table_text);
        }
        let line = buf_new();
        buf_byte(line, b'\n');
        buf_bytes(line, last);
        buf_bytes(line, b" | ");
        if holds(buf_slice(tcx.table_text), buf_slice(line)) {
            pcx.query_wanted.push((args[i as usize]) + a);
            any = true;
        }
    }
    any
}

// How well intrinsic id matches the words: 0 when it holds none; *k the
// number it holds.
fn score(id: i64, words: &[i64], k: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    let name = sym_text(intrinsic_name(id, pcx), pcx);
    let feats = intr_text(id, F_FEATURES, pcx);
    let mut s: i64 = 0;
    *k = 0;
    for w in 0..words.len() as i64 {
        let word = buf_slice((words[w as usize]));
        let mut hit: i64 = 0;
        if name.len() == word.len() && holds(name, word) {
            hit = 1000;
        } else if holds_word(name, word) {
            hit = 100;
        } else if lists(feats, word) {
            hit = 60;
        } else if holds_word(intr_text(id, F_INSN, pcx), word) {
            hit = 40;
        } else if holds_word(intr_text(id, F_DOC, pcx), word) {
            hit = 20;
        } else if holds_word(intr_text(id, F_SEMANTICS, pcx), word) {
            hit = 10;
        } else if holds_word(intr_text(id, F_EQUIV, pcx), word) {
            hit = 5;
        }
        if hit > 0 {
            *k = *k + 1;
            s += hit;
        }
    }
    s
}

fn arch_of_text(a: *mut u8) -> i64 {
    if streq(a, c"aarch64") || streq(a, c"arm64") || streq(a, c"neon") {
        ARCH_AARCH64
    } else if streq(a, c"x86_64") || streq(a, c"x86-64") || streq(a, c"x86") {
        ARCH_X86_64
    } else if streq(a, c"portable") || streq(a, c"std::arch") {
        ARCH_PORTABLE
    } else {
        -1
    }
}

fn usage(message: *mut u8, arg: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let e = diag(c"error", c"query.usage", tcx);
    buf_str(e, message);
    if arg != 0 as *mut u8 {
        buf_str(e, c" '");
        buf_str(e, arg);
        buf_str(e, c"'");
    }
    buf_str(e,
        c" (query arch WORDS... [--feature F] [--arch aarch64|x86_64|portable] [--equiv NAME] [--budget N])\n");
    let t = crate::tools::query::diagnostics::diags(tcx);
    buf_str(t, c"try:");
    put_cword(t, pcx.prog);
    buf_str(t, c" query arch 'saturating subtract'\n");
    2
}

// `--equiv NAME`: NAME's line, its equivalent, the intrinsics that one
// names, and those whose equivalent names NAME.
fn equiv(out: i64, id: i64, pcx: &Ctx<Comp>) {
    put_intrinsic_line(out, id, pcx);
    let e = intr_text(id, F_EQUIV, pcx);
    buf_str(out, c"equivalent: ");
    buf_bytes(out, if e == b"-" { b"none recorded" } else { e });
    buf_byte(out, b'\n');
    let mut shown: Vec<i64, Comp> = Vec::new_in(Comp {});
    shown.push(id);
    // (the names in the equivalent's text)
    let mut a: i64 = 0;
    while a < e.len() as i64 {
        while a < e.len() as i64
            && !(e[a as usize] == b'_' || e[a as usize] >= b'a' && e[a as usize] <= b'z'
                || e[a as usize] >= b'0' && e[a as usize] <= b'9') {
            a += 1;
        }
        let mut b = a;
        while b < e.len() as i64
            && (e[b as usize] == b'_' || e[b as usize] >= b'a' && e[b as usize] <= b'z'
                || e[b as usize] >= b'0' && e[b as usize] <= b'9') {
            b += 1;
        }
        if b > a {
            let other = intrinsic_by_text(&e[a as usize..b as usize], pcx);
            let mut seen = false;
            for k in 0..shown.len() as i64 {
                if (shown[k as usize]) == other {
                    seen = true;
                }
            }
            if other >= 0 && !seen {
                shown.push(other);
                put_intrinsic_line(out, other, pcx);
            }
        }
        a = b;
    }
    // (the intrinsics that name it as their equivalent)
    let name = sym_text(intrinsic_name(id, pcx), pcx);
    for other in 0..intrinsic_count(pcx) {
        let mut seen = false;
        for k in 0..shown.len() as i64 {
            if (shown[k as usize]) == other {
                seen = true;
            }
        }
        if !seen && holds(intr_text(other, F_EQUIV, pcx), name) {
            shown.push(other);
            put_intrinsic_line(out, other, pcx);
        }
    }
}

// `query arch`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn arch_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(option("feature", "F", "the intrinsics of feature F"));
    opts.push(option("arch", "A", "the intrinsics of architecture A"));
    opts.push(option("equiv", "NAME", "NAME's equivalents on the other architectures"));
    opts.push(option("budget", "N", "the answer cut to about N tokens"));
    opts.push(flag("all", "everything, no budget"));
    Leaf::new(opts, "words")
}

pub fn run_query_arch(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut words: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut feature = 0 as *mut u8;
    let mut arch: i64 = -1;
    let mut equiv_of = 0 as *mut u8;
    for ev in c.evs.iter().copied() {
        let a = ev.value;
        if ev.kind == EV_MISSING {
            return usage(c"a value is missing after", a, tcx, pcx);
        }
        if is_opt(ev, "feature") {
            feature = a;
        } else if is_opt(ev, "arch") {
            arch = arch_of_text(a);
            if arch < 0 {
                return usage(c"unknown architecture", a, tcx, pcx);
            }
        } else if is_opt(ev, "equiv") {
            equiv_of = a;
        } else if is_opt(ev, "budget") {
            let n = parse_count(a);
            if n < 0 {
                return usage(c"--budget needs a number, not", a, tcx, pcx);
            }
            tcx.opt_budget = n;
        } else if is_flag(ev, "all") {
            tcx.opt_budget = 0;
        } else if ev.kind != EV_WORD || ev.text.starts_with("--") {
            return usage(c"unknown option", a, tcx, pcx);
        } else {
            // (each word of the argument, lower case)
            let s = c_slice(a);
            let mut p: i64 = 0;
            while p < s.len() as i64 {
                while p < s.len() as i64 && s[p as usize] == b' ' {
                    p += 1;
                }
                let w = buf_new();
                while p < s.len() as i64 && s[p as usize] != b' ' {
                    buf_byte(w, lower(s[p as usize]));
                    p += 1;
                }
                if buf_slice(w).len() > 0 {
                    words.push(w);
                }
            }
        }
    }
    unsafe {
        load_table(pcx);
        let out = buf_new();
        if equiv_of != 0 as *mut u8 {
            let id = intrinsic_by_text(c_slice(equiv_of), pcx);
            if id < 0 {
                let e = diag(c"error", c"query.no-match", tcx);
                buf_str(e, c"no intrinsic '");
                buf_str(e, equiv_of);
                buf_str(e, c"'\n");
                let t = crate::tools::query::diagnostics::diags(tcx);
                buf_str(t, c"try:");
                put_cword(t, pcx.prog);
                buf_str(t, c" query arch");
                put_word(t, c_slice(equiv_of));
                buf_byte(t, b'\n');
                return 1;
            }
            equiv(out, id, pcx);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if words.len() as i64 == 0 && feature == 0 as *mut u8 && arch < 0 {
            return usage(c"no words to search for", 0 as *mut u8, tcx, pcx);
        }
        let n = intrinsic_count(pcx);
        let mut scores = zeros(n + 1);
        let mut held = zeros(n + 1);
        let mut best: i64 = 0;
        for id in 0..n {
            (scores[id as usize]) = -1;
            if arch >= 0 && (pcx.intrs[id as usize]).arch != arch {
                continue;
            }
            if feature != 0 as *mut u8 && !lists(intr_text(id, F_FEATURES, pcx), c_slice(feature)) {
                continue;
            }
            let mut k: i64 = 0;
            (scores[id as usize]) = score(id, words.as_slice(), &mut k, pcx);
            (held[id as usize]) = k;
            if k > best {
                best = k;
            }
        }
        // (all the words; else the most any intrinsic holds)
        let mut picked: Vec<i64, Comp> = Vec::new_in(Comp {});
        for id in 0..n {
            if (scores[id as usize]) >= 0
                && (words.len() as i64 == 0 || best > 0 && (held[id as usize]) == best) {
                picked.push(id);
            }
        }
        if picked.len() as i64 == 0 {
            let e = diag(c"error", c"query.no-match", tcx);
            buf_str(e, c"no intrinsic matches");
            for w in 0..words.len() as i64 {
                buf_byte(e, b' ');
                buf_bytes(e, buf_slice((words[w as usize])));
            }
            if feature != 0 as *mut u8 {
                buf_str(e, c" with feature ");
                buf_str(e, feature);
            }
            buf_byte(e, b'\n');
            let t = crate::tools::query::diagnostics::diags(tcx);
            buf_str(t, c"try:");
            put_cword(t, pcx.prog);
            buf_str(t, c" guide arch#recipes\n");
            return 1;
        }
        // (the best first; the tables' order among equals: a stable sort)
        for a in 1..picked.len() as i64 {
            let mut b = a;
            while b > 0
                && (scores[(picked[(b - 1) as usize]) as usize])
                < (scores[(picked[b as usize]) as usize]) {
                let t = (picked[b as usize]);
                (picked[b as usize]) = (picked[(b - 1) as usize]);
                (picked[(b - 1) as usize]) = t;
                b -= 1;
            }
        }
        for k in 0..picked.len() as i64 {
            put_intrinsic_line(out, (picked[k as usize]), pcx);
        }
        buf_write_fd(out, STDOUT);
        if words.len() as i64 > 0 && best < words.len() as i64 {
            let e = diag(c"note", c"query.partial", tcx);
            buf_str(e, c"no intrinsic holds every word; these hold ");
            crate::base::buf_int(e, best);
            buf_str(e, c" of ");
            crate::base::buf_int(e, words.len() as i64);
            buf_byte(e, b'\n');
        }
        0
    }
}
