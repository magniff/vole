// UNSAFE: C's getenv: the environment is the C library's (VOLE_ROOT).
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
}

// Flags of a reference: a call, the definition itself, an import.
pub const QF_CALL: i64 = 1;
pub const QF_DEF: i64 = 2;
pub const QF_USE: i64 = 4;
// (0.13) An assignment's target, a struct literal or a constructed variant,
// a pattern.
pub const QF_WRITE: i64 = 8;
pub const QF_INIT: i64 = 16;
pub const QF_PAT: i64 = 32;

// ---- The command line ----

pub fn ends_with_c(s: *mut u8, suffix: *mut u8) -> bool {
    // UNSAFE: strlen is C's, and the suffix is compared from a raw offset.
    // SAFETY: s and suffix are C strings of the caller's; n >= k is checked
    // before s + (n - k) is made, which is then inside s.
    unsafe {
        let n = strlen(s) as i64;
        let k = strlen(suffix) as i64;
        n >= k && streq(s.add((n - k) as usize), suffix)
    }
}

// The program's root: ROOT, else $VOLE_ROOT, ./main.vl or
// ./compiler/src/main.vl; 0 when there is none.
pub fn find_root(given: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    // UNSAFE: getenv is C's; the variable's first byte is read.
    // SAFETY: the name is a literal; env is checked not null before its
    // first byte is read (a C string has at least its 0).
    unsafe {
        if given != 0 as *mut u8 {
            return given;
        }
        let env = getenv(c"VOLE_ROOT");
        if env != 0 as *mut u8 && (*env.add(0)) != 0 {
            return env;
        }
        if file_exists(c"main.vl", pcx) {
            return c"main.vl";
        }
        // (0.21) a root in vole's extension
        if file_exists(c"main.vl", pcx) {
            return c"main.vl";
        }
        // (0.29) inside a program's directories (an example's
        // subdirectory): that program, for every command, as ./main.vl is
        // in its own directory; not past the checkout's top
        let up = roots::enclosing_program(pcx);
        if up != 0 as *mut u8 {
            return up;
        }
        if file_exists(c"compiler/src/main.vl", pcx) {
            return c"compiler/src/main.vl";
        }
        0 as *mut u8
    }
}

// The root of a command's program (given, or found), or 0 after the
// diagnostic saying why there is none (the command then exits with 2);
// `cmd` and `name` make its `try:` line.
pub fn root_or_diag(given: *mut u8, cmd: *mut u8, name: &[u8], with_name: bool, tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) -> *mut u8 {
    let root = roots::program_root(given, tcx, pcx);
    if root == 0 as *mut u8 {
        let out = diag(c"error", c"query.no-root", tcx);
        buf_str(out, c"no root (VOLE_ROOT, ./main.vl, a main.vl above, ./compiler/src/main.vl)\n");
        // (0.25.2: the programs under the current directory that
        // define it, roots.vl)
        if !(with_name && roots::try_other_roots(name, true, tcx, pcx)) {
            tcx.root_given = c"path/to/main.vl";
            try_end(try_begin(cmd, name, with_name, tcx, pcx));
        }
        return 0 as *mut u8;
    }
    if !file_exists(root, pcx) {
        let out = diag(c"error", c"query.bad-root", tcx);
        buf_str(out, c"cannot read '");
        buf_str(out, root);
        buf_str(out, c"'\n");
        tcx.root_given = 0 as *mut u8;
        if find_root(0 as *mut u8, pcx) != 0 as *mut u8 {
            try_end(try_begin(cmd, name, with_name, tcx, pcx));
        }
        return 0 as *mut u8;
    }
    root
}

// The commands, for `--help` and the nearest command to a misspelt one.
fn put_usage(out: i64) {
    buf_str(out,
        c"usage: volec query def|show NAME... [--root ROOT] [--exact] [--with-comments]\n");
    buf_str(out,
        c"       volec query show FILE.vl | MODULE::use | MODULE::header | MODULE::extern\n");
    buf_str(out, c"       volec query context NAME...|MODULE [--budget TOKENS]   (source, calls, types, callers)\n");
    buf_str(out, c"       volec query text FILE[:A[-B]]...\n");
    buf_str(out, c"       volec query diff\n");
    buf_str(out, c"       volec query refs|callers NAME... [--exact] [--count] [--in FILE|MODULE|ITEM] [--limit N] [--all]\n");
    buf_str(out, c"       volec query callees FN... [--transitive] [--writes TABLE] [--count] [--limit N] [--all]\n");
    buf_str(out, c"       volec query items [MODULE...] [--comments]\n");
    buf_str(out, c"       volec query show MODULE::section TITLE\n");
    buf_str(out, c"       volec query grep PATTERN... [--in FILE|MODULE|ITEM] [--code] [--comments] [--strings] [--word] [--count] [--limit N] [--all]\n");
    buf_str(out, c"       volec query type FILE:LINE[:COL]...\n");
    buf_str(out, c"       volec query contracts NAME...   (0.27.2.1: its requires and ensures; a trait method's, then each impl's: what it adds, the trait's marked)\n");
    buf_str(out, c"       volec query drops FILE:LINE...   (0.26.1: the function's drops as the places IR decides them, each with where it runs)\n");
    buf_str(out, c"       volec query stats [MODULE|FILE] [--over N] [--all]\n");
    buf_str(out, c"       volec query deps MODULE [--max-lines N]\n");
    buf_str(out, c"       volec query unused [MODULE] [--all]\n");
    buf_str(out, c"       volec query impact NAME\n");
    buf_str(out, c"       volec query effects NAME...|MODULE [--has EFFECT] [--why EFFECT]   (alloc(Gpa) io panic diverge unsafe; --why static)\n");
    buf_str(out, c"       volec query features NAME... [--why FEATURE] [-C target-cpu=CPU] [-C target-feature=+x,-y]   (std::arch: what a function needs beyond the build's features)\n");
    buf_str(out, c"       volec query arch WORDS... [--feature F] [--arch aarch64|x86_64|portable] [--equiv NAME]   (std::arch: the intrinsics by name, instruction, feature or doc; also query intrinsics)\n");
    buf_str(out, c"       volec query conflicts [FILE|DIR|FILE:LINE...] [--show]\n");
    buf_str(out, c"       volec query similar NAME... [--limit N]   (items like NAME to copy, nearest first)\n");
    buf_str(out, c"       volec query examples [KIND...]   (items to start from for an \"add an X\" change; volec guide how)\n");
    buf_str(out, c"       volec query unsafe [FILE...|DIR|std] [--no-std] [--summary] [--unjustified] [--json]   (every unsafe block, unsafe fn and extern block: what it does, its class, its UNSAFE:/SAFETY: comments)\n");
    buf_str(out, c"NAME: a path or its end (f, m::f, T::f, T.field), or FILE:LINE; std's too (std::f, Vec::push)\n");
    buf_str(out, c"--budget TOKENS: any answer cut to about TOKENS (default 8000; 0: no limit; context: 2000)\n");
    buf_str(out, c"ROOT: --root ROOT|DIR, a last argument ending in .vl, $VOLE_ROOT, ./main.vl, ./compiler/src/main.vl; a FILE[:LINE] argument names its own program\n");
    buf_str(out, c"see docs/query.md and docs/refactor.md\n");
}

// A usage error: `error query.usage: <message>`; the caller writes the
// message, then its `try:` lines.
fn usage_error(tcx: &mut Tcx<Comp>) -> i64 {
    diag(c"error", c"query.usage", tcx)
}

pub const N_COMMANDS: i64 = 25;

pub fn command_name(i: i64) -> *mut u8 {
    if i == 0 { c"def" } else if i == 1 { c"show" } else if i == 2 { c"refs" }
    else if i == 3 { c"callers" } else if i == 4 { c"items" } else if i == 5 { c"stats" }
    else if i == 6 { c"deps" } else if i == 7 { c"unused" } else if i == 8 { c"impact" }
    else if i == 9 { c"text" } else if i == 10 { c"diff" } else if i == 11 { c"grep" }
    else if i == 12 { c"type" } else if i == 13 { c"context" } else if i == 14 { c"callees" }
    else if i == 15 { c"conflicts" } else if i == 16 { c"effects" }
    else if i == 17 { c"similar" } else if i == 18 { c"examples" }
    else if i == 19 { c"features" } else if i == 20 { c"arch" } else if i == 21 { c"intrinsics" }
    else if i == 22 { c"unsafe" } else if i == 23 { c"drops" } else { c"contracts" }
}

// The command nearest to cmd (edit distance at most 2), or 0.
fn nearest_command(cmd: *mut u8) -> *mut u8 {
    // UNSAFE: strlen is C's, and C strings are seen as slices.
    // SAFETY: cmd is a C string of the caller's (a word of the command
    // line) and c a literal of command_name's table; each slice covers the
    // bytes before its string's 0, and is used within this call.
    unsafe {
        let want = c_bytes(cmd);
        let mut best = 0 as *mut u8;
        let mut best_d: i64 = 3;
        for i in 0..N_COMMANDS {
            let c = command_name(i);
            let d = edit_distance(want,
                c_bytes(c));
            if d < best_d {
                best = c;
                best_d = d;
            }
        }
        best
    }
}

// A copy of C string s's bytes (base::cstr: the caller's own; `&'static`
// before 0.29, which no function can promise of a pointer).
pub fn c_slice(s: *mut u8) -> Vec<u8, Comp> {
    crate::base::cstr(s)
}

// A decimal number (all of s), or -1.
pub fn parse_count(s: *mut u8) -> i64 {
    let t = crate::base::cstr(s);
    let mut n: i64 = 0;
    for &c in t.as_slice() {
        if c < b'0' || c > b'9' {
            return -1;
        }
        n = n * 10 + (c - b'0') as i64;
    }
    if t.len() == 0 { -1 } else { n }
}

pub fn run_query(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    // (0.15: the answer within its budget, budget.vl)
    begin_output();
    let status = run_query_inner(c, tcx, pcx, wgx);
    if status != 0 {
        // (0.25.2: a NAME of one other program, answered from it)
        roots::other_root(tcx, pcx);
    }
    end_output(c.line, c.word(2) == "context", tcx);
    write_diags(tcx);
    timer_report(pcx);
    status
}

fn run_query_inner(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    pcx.prog = c.prog();
    if c.line.len() < 3 {
        let out = usage_error(tcx);
        buf_str(out, c"no command\n");
        try_end(try_begin(c"items", b"", false, tcx, pcx));
        return 2;
    }
    let cmd = c.line.c(2);
    let sub = c.word(2);
    tcx.diagnostics_cmd = cmd;
    tcx.query_running = true;
    // (0.15: merge conflicts, read as text: conflicts.vl)
    if sub == "conflicts" {
        return run_conflicts(c, tcx, pcx);
    }
    if sub == "--help" || sub == "-h" || sub == "help" {
        let out = buf_new();
        put_usage(out);
        buf_write_fd(out, STDOUT);
        return 0;
    }
    // (0.19: the intrinsic tables, intrinsics.vl: no program read;
    // 0.25.2: its own leaf of the tree, before query's options)
    if sub == "arch" || sub == "intrinsics" {
        return crate::tools::query::intrinsics::run_query_arch(c, tcx, pcx);
    }
    // (0.25: the options, on std::cli: cli/query.vl)
    let q = crate::cli::query::read_query(c, tcx, pcx);
    let mut args = q.args;
    let bad = q.bad;
    let bad_value = q.bad_value;
    let mut root = q.root;
    // (0.17: a std file named, `query show compiler/std/io.vl:102`:
    // std from its files)
    if names_std_file(c.line, pcx) {
        pcx.std_tree = find_std_tree(pcx);
    }
    let items = sub == "items";
    // (0.25.3: `query unsafe`'s arguments are FILEs, each of the
    // program, none of them its root)
    let unsafe_sites = sub == "unsafe";
    let is_refs = sub == "refs" || sub == "callers" || sub == "grep"
        || sub == "callees";
    if !is_query_command(cmd) {
        let out = usage_error(tcx);
        buf_str(out, c"unknown command '");
        buf_str(out, cmd);
        buf_str(out, c"'\n");
        let near = nearest_command(cmd);
        if near != 0 as *mut u8 && args.len() as i64 >= 1 {
            try_query(near, &c_slice((args[0]) as *mut u8), tcx, pcx);
        } else if args.len() as i64 >= 1 {
            try_query(c"def", &c_slice((args[0]) as *mut u8), tcx, pcx);
        } else {
            try_end(try_begin(c"items", b"", false, tcx, pcx));
        }
        return 2;
    }
    // Text (0.12, query_text.vl): no program read.
    if sub == "text" {
        return run_text(args.as_slice(), tcx, pcx);
    }
    if sub == "show" && root == 0 as *mut u8 && all_files(args.as_slice(), pcx) {
        return show_files(args.as_slice(), tcx, pcx);
    }
    if sub == "diff" {
        return run_query_diff(root, tcx, pcx);
    }
    // ROOT: --root, else a last argument ending in .vl after the
    // NAMEs (or alone, for items: its MODULE is optional; for stats
    // and unused a lone FILE.vl is a file of the program).
    if root == 0 as *mut u8 && args.len() as i64 >= 1 && !unsafe_sites
        && crate::base::is_source_path((args[(args.len() as i64 - 1) as usize]) as *mut u8)
        && (args.len() as i64 >= 2 || items)
        && !(items && args.len() as i64 == 1
            && roots::is_module_file((args[0]) as *mut u8, pcx)) {
        root = args.pop() as *mut u8;
    }
    tcx.root_given = root;
    // (0.17: examples.vl; the kinds without the program)
    if sub == "examples" {
        if args.len() as i64 == 0 {
            return list_examples();
        }
        if !check_kinds(args.as_slice(), tcx, pcx) {
            return 2;
        }
    }
    let needs_name = !items && sub != "unused" && sub != "stats" && !unsafe_sites;
    let single = sub == "deps" || sub == "impact" || sub == "stats"
        || sub == "unused";
    let first = if args.len() as i64 == 0 { b"" }
        else { crate::base::c_kept((args[0]) as *mut u8) };
    if needs_name && args.len() as i64 == 0 {
        let out = usage_error(tcx);
        buf_str(out, cmd);
        if sub == "deps" {
            buf_str(out, c" needs a MODULE\n");
        } else {
            buf_str(out,
                c" needs a NAME (a path or its end: f, m::f, T::f, T.field; or FILE:LINE)\n");
        }
        try_end(try_begin(c"items", first, false, tcx, pcx));
        return 2;
    }
    let mut extra = if single && args.len() as i64 > 1 { (args[1]) as *mut u8 }
        else { 0 as *mut u8 };
    // (`NAME ROOT EXTRA...`: the old form, with an argument too many)
    for k in 0..args.len() as i64 - 1 {
        if root == 0 as *mut u8 && !unsafe_sites && extra == 0 as *mut u8
            && crate::base::is_source_path((args[k as usize]) as *mut u8) {
            tcx.root_given = (args[k as usize]) as *mut u8;
            extra = (args[(k + 1) as usize]) as *mut u8;
        }
    }
    if bad != 0 as *mut u8 || extra != 0 as *mut u8 {
        let out = usage_error(tcx);
        if bad != 0 as *mut u8 && bad_value {
            buf_str(out, bad);
            buf_str(out,
                if streq(bad, c"--in") { c" needs a FILE or MODULE\n" }
                else if streq(bad, c"--root") { c" needs a root file\n" }
                else if streq(bad, c"--kind") {
                    c" needs a KIND (read, write, call, init, type, use, mod, pat, def)\n"
                } else { c" needs a number\n" });
        } else if bad != 0 as *mut u8 {
            buf_str(out, c"unknown option '");
            buf_str(out, bad);
            buf_str(out, c"'\n");
        } else {
            buf_str(out, c"unexpected argument '");
            buf_str(out, extra);
            buf_str(out, c"'\n");
        }
        if bad != 0 as *mut u8 && bad_value && streq(bad, c"--limit") {
            try_refs(cmd, first, c"--limit 60", b"", tcx, pcx);
        } else {
            try_end(try_begin(cmd, first, args.len() as i64 > 0, tcx, pcx));
        }
        return 2;
    }
    // (0.25.2.1) a directory of programs (`--root examples/gpu`,
    // `--in examples/gpu`): grep asks each of them; another command
    // says which they are
    let dir = roots::programs_dir(root, tcx, pcx);
    if dir != 0 as *mut u8 {
        return roots::over_programs(dir, sub == "grep", tcx, pcx);
    }
    if root == 0 as *mut u8 {
        root = roots::root_of_args(tcx, pcx);
    }
    // (0.15: std's names where there is no program: a program of
    // nothing but std)
    // (0.19: an intrinsic, declared for the question: intrinsics.vl)
    let names_intrinsics = sub != "grep"
        && crate::tools::query::intrinsics::query_names_intrinsics(args.as_slice(), tcx, pcx);
    let mut std_only = false;
    if find_root(root, pcx) == 0 as *mut u8 && sub != "grep"
        && (all_std(args.as_slice(), tcx) || names_intrinsics) {
        root = std_root(pcx);
        std_only = root != 0 as *mut u8;
    }
    root = root_or_diag(root, cmd, first, args.len() as i64 > 0, tcx, pcx);
    if root == 0 as *mut u8 {
        return 2;
    }
    if sub == "effects" && check_effect_options(tcx, pcx) != 0 {
        return 2;
    }
    // (0.13: def, show, refs, callers and items from the tools' cache,
    // when it holds for the program; else read in full, then cached.
    // grep and type need the tokens and nodes, which are not cached:
    // they read the program in full, and leave the cache as it is)
    // (0.15: a question about std reads the program with std, and
    // without the cache, which holds the program as it is)
    let mut with_std = std_only || std_requested() || sub == "examples"
        || (unsafe_sites && !tcx.opt_no_std)
        || (pcx.opt_in != 0 as *mut u8 && names_std(&c_slice(pcx.opt_in)));
    for k in 0..args.len() as i64 {
        if names_std(&c_slice((args[k as usize]) as *mut u8)) {
            with_std = true;
        }
    }
    if names_intrinsics {
        with_std = true;
    }
    pcx.std_always = with_std;
    let context = sub == "context";
    // (0.16: a local, by FILE:LINE:COL or asked again in full, needs
    // the nodes: locals.vl)
    let mut at_column = false;
    for k in 0..args.len() as i64 {
        if sub == "refs" && has_column(&c_slice((args[k as usize]) as *mut u8)) {
            at_column = true;
        }
    }
    // (0.16: effects without --has and --why: the cached lines; 0.27.2.1:
    // items --undeclared needs the effects, which are not cached)
    let plain_effects = sub == "effects" && tcx.opt_has == 0 as *mut u8
        && tcx.opt_why == 0 as *mut u8;
    let cacheable = (sub == "def" || sub == "show" || sub == "refs"
        || sub == "callers" || (items && !tcx.opt_undeclared) || context
        || plain_effects) && !with_std
        && !at_column && !full_requested() && !arch_options_given(pcx);
    let cached = cacheable && cache_restore(root, 0, is_refs || context, tcx, pcx);
    pcx.audit_unsafe = unsafe_sites;
    // (0.25.5, feedbacks/stdunsafe254.md #1: std as the tree has it, when
    // its files differ from this compiler's std, as check reads it)
    if unsafe_sites && with_std {
        crate::tools::edit::cli::std_tree_if_edited(tcx, pcx);
    }
    if sub == "drops" {
        drops_wanted(pcx);
    }
    if !cached && !load_program(root, 0, tcx, pcx, wgx) {
        // (nothing to answer with: the errors say why)
        program_errors(c"error", root, true, tcx, pcx);
        return 1;
    }
    // (0.17: `items TYPE` of a std type, when no module is named so)
    let mut items_of_types = items;
    for k in 0..args.len() as i64 {
        let mut ms: Vec<i64, Comp> = Vec::new_in(Comp {});
        if items {
            find_modules(&c_slice((args[k as usize]) as *mut u8), tcx.opt_exact,
                &mut ms, tcx, pcx);
        }
        if ms.len() as i64 > 0 {
            items_of_types = false;
        }
    }
    if !with_std && pcx.std_module < 0 && (!items || items_of_types) && sub != "grep"
        && sub != "type" && sub != "drops" && wants_std(args.as_slice(), tcx, pcx) {
        // (a NAME std defines and the program does not: asked again
        // with std)
        ask_with_std(tcx);
    }
    let t = timer_now(pcx);
    let status = answer(cmd, sub, args.as_slice(), items, is_refs, tcx, pcx);
    timer_add(T_ANSWER, t, pcx);
    program_errors(c"warning", root, status != 0, tcx, pcx);
    // (the diagnostics after the answer: run_query)
    if cacheable {
        cache_save(root, 0, tcx, pcx);
    }
    status
}

// The definitions answering to NAME, in order of position (none: after
// the diagnostic saying so, for command cmd). NAME is a path, or its end
// (see name_matches), or `FILE:LINE` (`FILE:LINE:COL`, as a compiler's
// error has it): the innermost item whose text holds that line (0.15: on
// a comment or blank line, the item below it; outside every item, as on
// a `use` line, what the name at COL, or the first on the line, names).
// Every spelling the tools print is taken (canonical_name).
pub fn resolve_name(cmd: *mut u8, name0: &[u8], out: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let name = canonical_name(name0);
        // (0.25.2.2) `FILE.vl::item`: the item of that file
        let fp = roots::file_part(name);
        if fp.len() > 0 && fp.len() as i64 + 2 < name.len() as i64 {
            return file_item_defs(cmd, name, fp, out, tcx, pcx);
        }
        let mut line: i64 = -1;
        let mut col: i64 = -1;
        let mut file = &name[0..0];
        let a = trailing_number(name);
        if a > 0 && name[(a - 1) as usize] == b':' && (a < 2 || name[(a - 2) as usize] != b':') {
            line = parse_digits(&name[a as usize..]);
            file = &name[0..(a - 1) as usize];
            let b = trailing_number(file);
            if b > 0 && file[(b - 1) as usize] == b':'
                && (b < 2 || file[(b - 2) as usize] != b':') {
                // (FILE:LINE:COL)
                col = line;
                line = parse_digits(&file[b as usize..]);
                file = &file[0..(b - 1) as usize];
            }
        }
        if line < 0 {
            find_defs(name, tcx.opt_exact, out, tcx, pcx);
            if out.len() as i64 == 0 && !tcx.opt_exact {
                // (0.13: an import's other name, for what it imports)
                let at = alias_defs(last_segment(name), out, tcx, pcx);
                if at >= 0 {
                    let d = diag(c"note", c"query.alias", tcx);
                    buf_byte(d, b'\'');
                    buf_bytes(d, last_segment(name));
                    buf_str(d, c"' is an import alias in ");
                    buf_bytes(d, mod_fqn_text(module_at(at, pcx), tcx, pcx));
                    buf_str(d, c", for ");
                    buf_bytes(d, sym_text(pcx.defs[(out[0]) as usize].fqn, pcx));
                    buf_byte(d, b'\n');
                    sort_by_position(&mut *out, tcx, pcx);
                }
            }
            if out.len() as i64 == 0 && name.len() != name0.len() && is_symbol(name0) {
                // (a symbol of a trait's default function: `T::f` is the
                // trait's `f`)
                find_defs(last_segment(name), tcx.opt_exact, out, tcx, pcx);
            }
            if out.len() as i64 == 0 && name.len() > 5 && name[0..5] == b"std::" {
                // (0.20) `std::NAME` that std re-exports from its modules:
                // the item it names (`std::read_line` is std::io::read_line)
                let rest = &name[5..name.len()];
                let mut cut: i64 = 0;
                while cut + 1 < rest.len() as i64
                    && !(rest[cut as usize] == b':' && rest[(cut + 1) as usize] == b':') {
                    cut += 1;
                }
                let head = if cut + 1 < rest.len() as i64 { &rest[0..cut as usize] } else { rest };
                let key = std_item_key(intern(head, pcx), pcx);
                if key >= 0 {
                    let full = buf_new();
                    buf_bytes(full, sym_text(key, pcx));
                    buf_bytes(full, &rest[head.len()..rest.len()]);
                    find_defs(&buf_copy(full), tcx.opt_exact, out, tcx, pcx);
                }
            }
            if out.len() as i64 == 0 {
                // (0.25.2.1) a name a module re-exports: `std::gpu::Color`
                // is std::gpu::types::Color
                let via = reexported::reexport_defs(name, false, out, tcx, pcx);
                if via >= 0 {
                    let d = diag(c"note", c"query.reexport", tcx);
                    buf_bytes(d, name);
                    buf_str(d, c" is ");
                    buf_bytes(d, sym_text(pcx.defs[(out[0]) as usize].fqn, pcx));
                    buf_str(d, c", which ");
                    buf_bytes(d, mod_fqn_text(via, tcx, pcx));
                    buf_str(d, c" re-exports (`pub use`)\n");
                    sort_by_position(&mut *out, tcx, pcx);
                    return true;
                }
            }
            if out.len() as i64 == 0 {
                // (0.25.2.2) a name a module imports: `wgsl::expr::Front::unary`
                // is wgsl::front::Front::unary when expr has `use super::front::Front`
                let via = reexported::reexport_defs(name, true, out, tcx, pcx);
                if via >= 0 {
                    let d = diag(c"note", c"query.reexport", tcx);
                    buf_bytes(d, name);
                    buf_str(d, c" is ");
                    buf_bytes(d, sym_text(pcx.defs[(out[0]) as usize].fqn, pcx));
                    buf_str(d, c", which ");
                    buf_bytes(d, mod_fqn_text(via, tcx, pcx));
                    buf_str(d, c" imports (`use`)\n");
                    sort_by_position(&mut *out, tcx, pcx);
                    return true;
                }
            }
            if out.len() as i64 == 0 && module_def(name, out, tcx, pcx) {
                return true;
            }
            if out.len() as i64 == 0 && derived_note(crate::base::c_first(cmd), name, tcx, pcx) {
                return false;
            }
            if out.len() as i64 == 0 {
                no_match(cmd, name, tcx, pcx);
                return false;
            }
            return true;
        }
        let mut f: i64 = -1;
        for g in 0..pcx.files.len() as i64 {
            let p = file_text(g, pcx);
            if path_matches(p, file) {
                f = g;
                break;
            }
        }
        // (0.28.0) one of std's files in a vole repository: its line in
        // std's text, `<std>` (front/stdtree.vl)
        let mut line = line;
        if f < 0 {
            let at = crate::front::stdtree::std_text_line(file, line, &mut f, pcx);
            if at > 0 {
                line = at;
            }
        }
        if f < 0 {
            let d = diag(c"error", c"query.no-match", tcx);
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", &name[0..0], false, tcx, pcx));
            return false;
        }
        let mut d = def_at_line(f, line, pcx);
        if d < 0 {
            d = item_below(f, line, pcx);
        }
        if d < 0 && line >= 1 {
            let idx = line_index(pcx.files[f as usize].start, pcx) + line - 1;
            if idx < pcx.lines.len() as i64
                && (pcx.lines[idx as usize]) < pcx.files[f as usize].end {
                let start = (pcx.lines[idx as usize]);
                let end = line_end(start, pcx);
                if col >= 1 && start + col - 1 <= end {
                    // (the name holding COL: it starts at or before it)
                    let mut p = start + col - 1;
                    while p > start && is_name_char(get_src()[(p - 1) as usize]) {
                        p -= 1;
                    }
                    d = def_used_at(p, end, tcx, pcx);
                } else {
                    d = def_used_at(start, end, tcx, pcx);
                }
            }
        }
        if d < 0 {
            let e = diag(c"error", c"query.no-match", tcx);
            buf_str(e, c"no item at ");
            buf_bytes(e, name);
            buf_byte(e, b'\n');
            try_query(c"items", mod_fqn_text(pcx.files[f as usize].module, tcx, pcx), tcx, pcx);
            return false;
        }
        out.push(d);
        true
    }
}

// (0.25.2.2) The definitions `FILE.vl::item` names, into out: the item's
// path in the module of FILE (`sim.vl::Sim::f` is crate::sim::Sim::f),
// else what answers to the item among the definitions written in FILE
// (an impl's methods for a type of another module); false, with the
// diagnostic, for none. (The 0.25.2.1 eval's `show sim.vl::Sim::snapshot_in`
// found nothing.)
fn file_item_defs(cmd: *mut u8, name: &[u8], file: &[u8], out: &mut Vec<i64, Comp>,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let item = &name[(file.len() as i64 + 2) as usize..];
    let mut f: i64 = -1;
    for g in 0..pcx.files.len() as i64 {
        if path_matches(file_text(g, pcx), file) {
            f = g;
            break;
        }
    }
    if f >= 0 {
        let full = buf_new();
        buf_bytes(full, mod_fqn_text(pcx.files[f as usize].module, tcx, pcx));
        buf_str(full, c"::");
        buf_bytes(full, item);
        find_defs(&buf_copy(full), true, out, tcx, pcx);
        if out.len() as i64 == 0 {
            let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
            find_defs(item, tcx.opt_exact, &mut all, tcx, pcx);
            for k in 0..all.len() as i64 {
                let d = (all[k as usize]);
                if pcx.defs[d as usize].start >= pcx.files[f as usize].start
                    && pcx.defs[d as usize].start < pcx.files[f as usize].end {
                    out.push(d);
                }
            }
        }
        if out.len() as i64 > 0 {
            return true;
        }
    }
    no_match(cmd, name, tcx, pcx);
    false
}

// The start of the run of digits that ends s (s.len: none).
pub fn trailing_number(s: &[u8]) -> i64 {
    let mut i = s.len() as i64;
    while i > 0 && s[(i - 1) as usize] >= b'0' && s[(i - 1) as usize] <= b'9' {
        i -= 1;
    }
    if i == s.len() as i64 { -1 } else { i }
}

pub fn parse_digits(s: &[u8]) -> i64 {
    let mut n: i64 = 0;
    for i in 0..s.len() {
        n = n * 10 + (s[i] - b'0') as i64;
    }
    n
}

// The innermost definition (not a field or variant) of file f whose text
// (its comments and attributes included) holds line `line`, or -1.
pub fn def_at_line(f: i64, line: i64, pcx: &Ctx<Comp>) -> i64 {
    let idx = line_index(pcx.files[f as usize].start, pcx) + line - 1;
    if line < 1 || idx >= pcx.lines.len() as i64
        || (pcx.lines[idx as usize]) >= pcx.files[f as usize].end + 1 {
        return -1;
    }
    let mut pos = (pcx.lines[idx as usize]);
    while pos < pcx.files[f as usize].end
        && (get_src()[pos as usize] == b' ' || get_src()[pos as usize] == b'\t') {
        pos += 1;
    }
    let mut best: i64 = -1;
    let mut best_size: i64 = 0;
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if k == K_FIELD || k == K_VARIANT
            || pcx.defs[d as usize].start < pcx.files[f as usize].start
            || pcx.defs[d as usize].start >= pcx.files[f as usize].end {
            continue;
        }
        if pos >= pcx.defs[d as usize].end
            || pos < line_start(pcx.defs[d as usize].start, pcx) {
            continue;
        }
        let from = text_start(d, pcx);
        if pos < from {
            continue;
        }
        if best < 0 || pcx.defs[d as usize].end - from < best_size {
            best = d;
            best_size = pcx.defs[d as usize].end - from;
        }
    }
    best
}

// (0.14) NAME as `FILE:LINE` (or `FILE:LINE:COL`): the length of its FILE
// part, its line in *line; -1 when it is not one.
pub fn file_line(name: &[u8], line: &mut i64) -> i64 {
    let a = trailing_number(name);
    if a < 2 || name[(a - 1) as usize] != b':' || name[(a - 2) as usize] == b':' {
        return -1;
    }
    let mut file = &name[0..(a - 1) as usize];
    *line = parse_digits(&name[a as usize..]);
    let b = trailing_number(file);
    if b >= 2 && file[(b - 1) as usize] == b':' && file[(b - 2) as usize] != b':' {
        *line = parse_digits(&file[b as usize..]);
        file = &file[0..(b - 1) as usize];
    }
    file.len() as i64
}

// (0.14) The file of the program named `file` (its path, or the end of it
// after a `/`), or -1.
pub fn file_named(file: &[u8], pcx: &Ctx<Comp>) -> i64 {
    for g in 0..pcx.files.len() as i64 {
        let p = file_text(g, pcx);
        if p.len() > 0 && p[0] != b'<' && path_matches(p, file) {
            return g;
        }
    }
    -1
}

// The answer to the command, once the program is known; the NAMEs (or
// MODULEs) are `args`.
fn answer(cmd: *mut u8, sub: &str, args: &[i64], items: bool, is_refs: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    let n = args.len() as i64;
    // (0.25.3: unsafe_audit.vl)
    if sub == "unsafe" {
        return crate::tools::query::unsafe_audit::query_unsafe(args, tcx, pcx);
    }
    if items {
        // (0.25.3) --kind, --find, --names (show.vl)
        let bad = bad_item_kind(tcx.opt_kind);
        if bad.len() > 0 {
            let out = usage_error(tcx);
            buf_str(out,
                c"--kind of items takes fn, method, struct, enum, trait, trait-method, const, static, type, mod; not '");
            buf_bytes(out, bad);
            buf_str(out, c"'\n");
            let t = try_begin(c"items",
                if n > 0 { crate::base::c_kept((args[0]) as *mut u8) } else { b"" }, n > 0, tcx,
                pcx);
            put_word(t, b"--kind");
            put_word(t, b"fn,method");
            try_end(t);
            return 2;
        }
        let filtered = items_filtered(tcx);
        if n == 0 && !filtered && !tcx.show_opt_names {
            query_modules(tcx, pcx);
            return 0;
        }
        let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
        if n == 0 {
            // (filtered: every module of the program, not std's)
            let mut every: Vec<i64, Comp> = Vec::new_in(Comp {});
            find_modules(b"", false, &mut every, tcx, pcx);
            for i in 0..every.len() as i64 {
                if !within_std((every[i as usize]), pcx) {
                    modules.push((every[i as usize]));
                }
            }
        }
        let mut types: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut status: i64 = 0;
        for i in 0..n {
            let text = c_slice((args[i as usize]) as *mut u8);
            let before = modules.len() as i64;
            find_modules(&text, tcx.opt_exact, &mut modules, tcx, pcx);
            // (0.20) `items std` is std's whole API: its modules' items
            // too, module by module
            if modules.len() as i64 == before + 1
                && (modules[before as usize]) == pcx.std_module {
                for m in 0..module_count(pcx) {
                    if m != pcx.std_module && within_std(m, pcx)
                        && !is_within(m, pcx.arch_module, pcx) {
                        modules.push(m);
                    }
                }
            }
            if modules.len() as i64 == before {
                // (0.17: a type: its impl blocks' functions)
                let mut defs: Vec<i64, Comp> = Vec::new_in(Comp {});
                find_defs(&text, tcx.opt_exact, &mut defs, tcx, pcx);
                let t0 = types.len() as i64;
                for j in 0..defs.len() as i64 {
                    let k = pcx.defs[(defs[j as usize]) as usize].kind;
                    if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
                        types.push((defs[j as usize]));
                    }
                }
                if types.len() as i64 == t0 {
                    no_module(&text, tcx, pcx);
                    status = 1;
                }
            }
        }
        if modules.len() as i64 > 0 {
            query_items(modules.as_slice(), tcx, pcx);
        }
        if types.len() as i64 > 0 {
            query_type_items(types.as_slice(), tcx, pcx);
        }
        if filtered {
            // (std asked: the primitive types' constants too)
            let mut shown = tcx.items_shown;
            let mut std_asked = false;
            for i in 0..modules.len() as i64 {
                if (modules[i as usize]) == pcx.std_module {
                    std_asked = true;
                }
            }
            if std_asked {
                let out = buf_new();
                shown += put_builtin_consts(out, tcx);
                buf_write_fd(out, STDOUT);
            }
            if shown == 0 && status == 0 {
                let d = diag(c"note", c"query.empty", tcx);
                buf_str(d, c"no item");
                if tcx.opt_find != 0 as *mut u8 {
                    buf_str(d, c" whose name holds '");
                    buf_str(d, tcx.opt_find);
                    buf_str(d, c"'");
                }
                if tcx.opt_kind != 0 as *mut u8 {
                    buf_str(d, c" of kind ");
                    buf_str(d, tcx.opt_kind);
                }
                buf_str(d, c" here\n");
                if tcx.opt_find != 0 as *mut u8 {
                    try_query(c"grep", &c_slice(tcx.opt_find), tcx, pcx);
                }
            }
        }
        return status;
    }
    if sub == "stats" {
        return query_stats(if n == 0 { 0 as *mut u8 } else { (args[0]) as *mut u8 },
            tcx, pcx);
    }
    if sub == "deps" {
        return query_deps(&c_slice((args[0]) as *mut u8), tcx, pcx);
    }
    if sub == "unused" {
        return query_unused(if n == 0 { 0 as *mut u8 } else { (args[0]) as *mut u8 },
            tcx, pcx);
    }
    if is_refs {
        if pcx.opt_in != 0 as *mut u8 && !resolve_in(&c_slice(pcx.opt_in), tcx, pcx) {
            // (0.29) grep in a file that is no file of the program, a
            // README, a script: searched as text (tools/textfile.vl), not
            // refused, and never `0 hits` for a file that was not read
            if sub == "grep" && crate::tools::textfile::plain_file(pcx.opt_in, pcx) {
                return crate::tools::textfile::grep_text(args, pcx.opt_in, tcx);
            }
            let out = diag(c"error", c"query.bad-in", tcx);
            put_bad_in(out, pcx.opt_in, tcx);
            try_end(try_begin(cmd, &c_slice((args[0]) as *mut u8), true, tcx, pcx));
            return 1;
        }
    }
    if sub == "grep" {
        return query_grep(args, tcx, pcx);
    }
    if sub == "callees" {
        // (0.16: callees.vl)
        let mut fns: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..n {
            let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
            if !resolve_name(cmd, &c_slice((args[i as usize]) as *mut u8),
                &mut matches, tcx, pcx) {
                return 1;
            }
            for j in 0..matches.len() as i64 {
                push_once(&mut fns, (matches[j as usize]));
            }
        }
        let mut table: Vec<i64, Comp> = Vec::new_in(Comp {});
        if tcx.opt_writes != 0 as *mut u8
            && !resolve_name(cmd, &c_slice(tcx.opt_writes), &mut table, tcx, pcx) {
            return 1;
        }
        return query_callees(fns.as_slice(), &c_slice((args[0]) as *mut u8), table.as_slice(), tcx,
            pcx);
    }
    // (0.17: similar.vl, examples.vl)
    if sub == "similar" {
        return query_similar(args, tcx, pcx);
    }
    if sub == "examples" {
        return query_examples(args, tcx, pcx);
    }
    if sub == "context" {
        // (0.15: context.vl)
        let mut status: i64 = 0;
        for i in 0..n {
            let text = c_slice((args[i as usize]) as *mut u8);
            let m = context_module(&text, tcx, pcx);
            if m >= 0 {
                query_context_module(m, &text, tcx, pcx);
                continue;
            }
            let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
            if !resolve_name(cmd, &text, &mut matches, tcx, pcx)
                || query_context(&text, matches.as_slice(), tcx, pcx) != 0 {
                status = 1;
            }
        }
        return status;
    }
    let mut status: i64 = 0;
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut title_next = false;
    for i in 0..n {
        let text = c_slice((args[i as usize]) as *mut u8);
        if title_next {
            title_next = false;
            continue;
        }
        if sub == "type" {
            if query_type(&text, tcx, pcx) != 0 {
                status = 1;
            }
            continue;
        }
        // (0.26.1: drops.vl)
        if sub == "drops" {
            if query_drops(&text, tcx, pcx) != 0 {
                status = 1;
            }
            continue;
        }
        if sub == "effects" {
            // (0.16: a module's functions, effects.vl)
            let m = context_module(&text, tcx, pcx);
            if m >= 0 {
                if query_effects_module(m, tcx, pcx) != 0 {
                    status = 1;
                }
                continue;
            }
        }
        if sub == "show" && ends_with_c((args[i as usize]) as *mut u8, c"::section") {
            // (MODULE::section TITLE)
            let title = if i + 1 < n { crate::base::c_kept((args[(i + 1) as usize]) as *mut u8) }
                else { &text[0..0] };
            title_next = true;
            let r = show_section(&text, title, tcx, pcx);
            if r >= 0 {
                if r != 0 {
                    status = r;
                }
                continue;
            }
            title_next = false;
        }
        if sub == "show" {
            // (MODULE::use, ::header, ::extern)
            let r = show_region(&text, tcx, pcx);
            if r >= 0 {
                if r != 0 {
                    status = 1;
                }
                continue;
            }
        }
        if sub == "refs" {
            // (0.16: a local, `FN::x` or FILE:LINE:COL)
            let r = local_refs(&text, tcx, pcx);
            if r >= 0 {
                if r != 0 {
                    status = r;
                }
                continue;
            }
        }
        let mut matches: Vec<i64, Comp> = Vec::new_in(Comp {});
        if !resolve_name(cmd, &text, &mut matches, tcx, pcx) {
            status = 1;
            continue;
        }
        if is_refs {
            for j in 0..matches.len() as i64 {
                push_once(&mut all, (matches[j as usize]));
            }
        } else if sub == "impact" {
            status = query_impact(matches.as_slice(), &text, tcx, pcx);
        } else if sub == "show" {
            if query_show(matches.as_slice(), &text, tcx, pcx) != 0 {
                status = 1;
            }
        } else if sub == "contracts" {
            // (0.27.2.1, contracts.vl)
            if crate::tools::query::contracts::query_contracts(matches.as_slice(), tcx, pcx) != 0 {
                status = 1;
            }
        } else if sub == "effects" {
            // (0.16, effects.vl)
            if query_effects(matches.as_slice(), tcx, pcx) != 0 {
                status = 1;
            }
        } else if sub == "features" {
            // (0.19, features.vl)
            let r = crate::tools::query::features::query_features(matches.as_slice(), tcx, pcx);
            if r != 0 {
                status = r;
            }
        } else {
            query_def(matches.as_slice(), tcx, pcx);
        }
    }
    if is_refs && all.len() as i64 > 0 {
        sort_by_position(&mut all, tcx, pcx);
        let name = c_slice((args[0]) as *mut u8);
        if query_refs(all.as_slice(), cmd, &name, tcx, pcx) != 0 {
            status = 1;
        }
    }
    status
}
