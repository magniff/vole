extern "C" {
    fn getenv(name: *u8) -> *u8;
}

// Flags of a reference: a call, the definition itself, an import.
pub const QF_CALL: i64 = 1;
pub const QF_DEF: i64 = 2;
pub const QF_USE: i64 = 4;
// (0.13) An assignment's target, a struct literal or a constructed variant,
// a pattern.
pub const QF_WRITE: i64 = 8;
pub const QF_INIT: i64 = 16;
pub const QF_PAT: i64 = 32;

// ---- The command line ----

pub fn ends_with_c(s: *u8, suffix: *u8) -> bool {
    unsafe {
        let n = strlen(s) as i64;
        let k = strlen(suffix) as i64;
        n >= k && streq(&s[n - k], suffix)
    }
}

// The program's root: ROOT, else $VOLE_ROOT, ./main.vl or
// ./compiler/src/main.vl; 0 when there is none.
pub fn find_root(given: *u8) -> *u8 {
    unsafe {
        if given != 0 as *u8 {
            return given;
        }
        let env = getenv(c"VOLE_ROOT");
        if env != 0 as *u8 && env[0] != 0 {
            return env;
        }
        if file_exists(c"main.vl") {
            return c"main.vl";
        }
        // (0.21) a root in vole's extension
        if file_exists(c"main.vl") {
            return c"main.vl";
        }
        if file_exists(c"compiler/src/main.vl") {
            return c"compiler/src/main.vl";
        }
        0 as *u8
    }
}

// The root of a command's program (given, or found), or 0 after the
// diagnostic saying why there is none (the command then exits with 2);
// `cmd` and `name` make its `try:` line.
pub fn root_or_diag(given: *u8, cmd: *u8, name: [u8], with_name: bool) -> *u8 {
    let root = roots::program_root(given);
    if root == 0 as *u8 {
        let out = diag(c"error", c"query.no-root");
        buf_str(out, c"no root (VOLE_ROOT, ./main.vl, ./compiler/src/main.vl)\n");
        // (0.25.2: the programs under the current directory that
        // define it, roots.vl)
        if !(with_name && roots::try_other_roots(name, true)) {
            ROOT_GIVEN = c"path/to/main.vl";
            try_end(try_begin(cmd, name, with_name));
        }
        return 0 as *u8;
    }
    if !file_exists(root) {
        let out = diag(c"error", c"query.bad-root");
        buf_str(out, c"cannot read '");
        buf_str(out, root);
        buf_str(out, c"'\n");
        ROOT_GIVEN = 0 as *u8;
        if find_root(0 as *u8) != 0 as *u8 {
            try_end(try_begin(cmd, name, with_name));
        }
        return 0 as *u8;
    }
    root
}

// The commands, for `--help` and the nearest command to a misspelt one.
fn put_usage(out: i64) {
    buf_str(out,
        c"usage: volec query def|show NAME... [--root ROOT] [--exact] [--with-comments]\n");
    buf_str(out,
        c"       volec query show FILE.vl | MODULE::use | MODULE::header | MODULE::extern\n");
    buf_str(out, c"       volec query context NAME...|MODULE [--budget TOKENS]   (source, calls, types, callers)\n");
    buf_str(out, c"       volec query text FILE[:A[-B]]...\n");
    buf_str(out, c"       volec query diff\n");
    buf_str(out, c"       volec query refs|callers NAME... [--exact] [--count] [--in FILE|MODULE|ITEM] [--limit N] [--all]\n");
    buf_str(out, c"       volec query callees FN... [--transitive] [--writes TABLE] [--count] [--limit N] [--all]\n");
    buf_str(out, c"       volec query items [MODULE...] [--comments]\n");
    buf_str(out, c"       volec query show MODULE::section TITLE\n");
    buf_str(out, c"       volec query grep PATTERN... [--in FILE|MODULE|ITEM] [--code] [--comments] [--strings] [--word] [--count] [--limit N] [--all]\n");
    buf_str(out, c"       volec query type FILE:LINE[:COL]...\n");
    buf_str(out, c"       volec query own FILE:LINE:COL...   (0.17: each local's kind, moves and views there)\n");
    buf_str(out, c"       volec query drops FILE:LINE...   (0.26.1: the function's drops as the places IR decides them, each with where it runs)\n");
    buf_str(out, c"       volec query stats [MODULE|FILE] [--over N] [--all]\n");
    buf_str(out, c"       volec query deps MODULE [--max-lines N]\n");
    buf_str(out, c"       volec query unused [MODULE] [--all]\n");
    buf_str(out, c"       volec query impact NAME\n");
    buf_str(out, c"       volec query effects NAME...|MODULE [--has EFFECT] [--why EFFECT]   (alloc(Gpa) io global panic diverge unsafe)\n");
    buf_str(out, c"       volec query features NAME... [--why FEATURE] [-C target-cpu=CPU] [-C target-feature=+x,-y]   (std::arch: what a function needs beyond the build's features)\n");
    buf_str(out, c"       volec query arch WORDS... [--feature F] [--arch aarch64|x86_64|portable] [--equiv NAME]   (std::arch: the intrinsics by name, instruction, feature or doc; also query intrinsics)\n");
    buf_str(out, c"       volec query views NAME...|MODULE [--why]   (what results and `&mut` parameters view: views(self), views(*self), stores(word))\n");
    buf_str(out, c"       volec query conflicts [FILE|DIR|FILE:LINE...] [--show]\n");
    buf_str(out, c"       volec query similar NAME... [--limit N]   (items like NAME to copy, nearest first)\n");
    buf_str(out, c"       volec query examples [KIND...]   (items to start from for an \"add an X\" change; volec guide how)\n");
    buf_str(out, c"       volec query unsafe [FILE...|DIR|std] [--no-std] [--summary] [--unjustified] [--json]   (every unsafe block, unsafe fn and extern block: what it does, its class, its UNSAFE:/SAFETY: comments)\n");
    buf_str(out, c"NAME: a path or its end (f, m::f, T::f, T.field), or FILE:LINE; std's too (std::f, Vec::push)\n");
    buf_str(out, c"--budget TOKENS: any answer cut to about TOKENS (default 8000; 0: no limit; context: 2000)\n");
    buf_str(out, c"ROOT: --root ROOT|DIR, a last argument ending in .vl, $VOLE_ROOT, ./main.vl, ./compiler/src/main.vl; a FILE[:LINE] argument names its own program\n");
    buf_str(out, c"see docs/query.md and docs/refactor.md\n");
}

// A usage error: `error query.usage: <message>`; the caller writes the
// message, then its `try:` lines.
fn usage_error() -> i64 {
    diag(c"error", c"query.usage")
}

pub const N_COMMANDS: i64 = 26;

pub fn command_name(i: i64) -> *u8 {
    if i == 0 { c"def" } else if i == 1 { c"show" } else if i == 2 { c"refs" }
    else if i == 3 { c"callers" } else if i == 4 { c"items" } else if i == 5 { c"stats" }
    else if i == 6 { c"deps" } else if i == 7 { c"unused" } else if i == 8 { c"impact" }
    else if i == 9 { c"text" } else if i == 10 { c"diff" } else if i == 11 { c"grep" }
    else if i == 12 { c"type" } else if i == 13 { c"context" } else if i == 14 { c"callees" }
    else if i == 15 { c"conflicts" } else if i == 16 { c"effects" }
    else if i == 17 { c"similar" } else if i == 18 { c"examples" } else if i == 19 { c"own" }
    else if i == 20 { c"views" } else if i == 21 { c"features" }
    else if i == 22 { c"arch" } else if i == 23 { c"intrinsics" } else if i == 24 { c"unsafe" }
    else { c"drops" }
}

// The command nearest to cmd (edit distance at most 2), or 0.
fn nearest_command(cmd: *u8) -> *u8 {
    unsafe {
        let want = cmd[0..strlen(cmd) as i64];
        var best = 0 as *u8;
        var best_d = 3;
        for i in 0..N_COMMANDS {
            let c = command_name(i);
            let d = edit_distance(want, c[0..strlen(c) as i64]);
            if d < best_d {
                best = c;
                best_d = d;
            }
        }
        best
    }
}

pub fn c_slice(s: *u8) -> [u8] {
    unsafe { s[0..strlen(s) as i64] }
}

// A decimal number (all of s), or -1.
pub fn parse_count(s: *u8) -> i64 {
    unsafe {
        var n = 0;
        var j = 0;
        while s[j] >= '0' && s[j] <= '9' {
            n = n * 10 + (s[j] - '0') as i64;
            j += 1;
        }
        if j == 0 || s[j] != 0 { -1 } else { n }
    }
}

// The options of stats and deps (0.11).
pub static var OPT_OVER: i64 = 1000;
pub static var OPT_MAX_LINES: i64 = 1000;

pub fn run_query(c: Call) -> i64 {
    // (0.15: the answer within its budget, budget.vl)
    begin_output();
    let status = run_query_inner(c);
    if status != 0 {
        // (0.25.2: a NAME of one other program, answered from it)
        roots::other_root();
    }
    end_output(c.line, c.word(2) == "context");
    write_diags();
    timer_report();
    status
}

fn run_query_inner(c: Call) -> i64 {
    unsafe {
        PROG = c.prog();
        if c.line.len() < 3 {
            let out = usage_error();
            buf_str(out, c"no command\n");
            try_end(try_begin(c"items", c_slice(c""), false));
            return 2;
        }
        let cmd = c.line.c(2);
        let sub = c.word(2);
        CMD = cmd;
        QUERY_RUNNING = true;
        // (0.15: merge conflicts, read as text: conflicts.vl)
        if sub == "conflicts" {
            return run_conflicts(c);
        }
        if sub == "--help" || sub == "-h" || sub == "help" {
            let out = buf_new();
            put_usage(out);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        // (0.19: the intrinsic tables, intrinsics.vl: no program read;
        // 0.25.2: its own leaf of the tree, before query's options)
        if sub == "arch" || sub == "intrinsics" {
            return crate::tools::query::intrinsics::run_query_arch(c);
        }
        // (0.25: the options, on std::cli: cli/query.vl)
        let q = crate::cli::query::read_query(c);
        var args = q.args;
        let bad = q.bad;
        let bad_value = q.bad_value;
        var root = q.root;
        // (0.17: a std file named, `query show compiler/std/io.vl:102`:
        // std from its files)
        if names_std_file(c.line) {
            STD_TREE = find_std_tree();
        }
        let items = sub == "items";
        // (0.25.3: `query unsafe`'s arguments are FILEs, each of the
        // program, none of them its root)
        let unsafe_sites = sub == "unsafe";
        let is_refs = sub == "refs" || sub == "callers" || sub == "grep"
            || sub == "callees";
        if !is_query_command(cmd) {
            let out = usage_error();
            buf_str(out, c"unknown command '");
            buf_str(out, cmd);
            buf_str(out, c"'\n");
            let near = nearest_command(cmd);
            if near != 0 as *u8 && args.count >= 1 {
                try_query(near, c_slice(args.data[0] as *u8));
            } else if args.count >= 1 {
                try_query(c"def", c_slice(args.data[0] as *u8));
            } else {
                try_end(try_begin(c"items", c_slice(c""), false));
            }
            return 2;
        }
        // Text (0.12, query_text.vl): no program read.
        if sub == "text" {
            return run_text(args);
        }
        if sub == "show" && root == 0 as *u8 && all_files(args) {
            return show_files(args);
        }
        if sub == "diff" {
            return run_query_diff(root);
        }
        // ROOT: --root, else a last argument ending in .vl after the
        // NAMEs (or alone, for items: its MODULE is optional; for stats
        // and unused a lone FILE.vl is a file of the program).
        if root == 0 as *u8 && args.count >= 1 && !unsafe_sites
            && crate::base::is_source_path(args.data[args.count - 1] as *u8)
            && (args.count >= 2 || items)
            && !(items && args.count == 1 && roots::is_module_file(args.data[0] as *u8)) {
            args.count -= 1;
            root = args.data[args.count] as *u8;
        }
        ROOT_GIVEN = root;
        // (0.17: examples.vl; the kinds without the program)
        if sub == "examples" {
            if args.count == 0 {
                return list_examples();
            }
            if !check_kinds(args) {
                return 2;
            }
        }
        let needs_name = !items && sub != "unused" && sub != "stats" && !unsafe_sites;
        let single = sub == "deps" || sub == "impact" || sub == "stats"
            || sub == "unused";
        let first = if args.count == 0 { c_slice(c"") } else { c_slice(args.data[0] as *u8) };
        if needs_name && args.count == 0 {
            let out = usage_error();
            buf_str(out, cmd);
            if sub == "deps" {
                buf_str(out, c" needs a MODULE\n");
            } else {
                buf_str(out,
                    c" needs a NAME (a path or its end: f, m::f, T::f, T.field; or FILE:LINE)\n");
            }
            try_end(try_begin(c"items", first, false));
            return 2;
        }
        var extra = if single && args.count > 1 { args.data[1] as *u8 } else { 0 as *u8 };
        // (`NAME ROOT EXTRA...`: the old form, with an argument too many)
        for k in 0..args.count - 1 {
            if root == 0 as *u8 && !unsafe_sites && extra == 0 as *u8
                && crate::base::is_source_path(args.data[k] as *u8) {
                ROOT_GIVEN = args.data[k] as *u8;
                extra = args.data[k + 1] as *u8;
            }
        }
        if bad != 0 as *u8 || extra != 0 as *u8 {
            let out = usage_error();
            if bad != 0 as *u8 && bad_value {
                buf_str(out, bad);
                buf_str(out,
                    if streq(bad, c"--in") { c" needs a FILE or MODULE\n" }
                    else if streq(bad, c"--root") { c" needs a root file\n" }
                    else if streq(bad, c"--kind") {
                        c" needs a KIND (read, write, call, init, type, use, mod, pat, def)\n"
                    } else { c" needs a number\n" });
            } else if bad != 0 as *u8 {
                buf_str(out, c"unknown option '");
                buf_str(out, bad);
                buf_str(out, c"'\n");
            } else {
                buf_str(out, c"unexpected argument '");
                buf_str(out, extra);
                buf_str(out, c"'\n");
            }
            if bad != 0 as *u8 && bad_value && streq(bad, c"--limit") {
                try_refs(cmd, first, c"--limit 60", c_slice(c""));
            } else {
                try_end(try_begin(cmd, first, args.count > 0));
            }
            return 2;
        }
        // (0.25.2.1) a directory of programs (`--root examples/gpu`,
        // `--in examples/gpu`): grep asks each of them; another command
        // says which they are
        let dir = roots::programs_dir(root);
        if dir != 0 as *u8 {
            return roots::over_programs(dir, sub == "grep");
        }
        if root == 0 as *u8 {
            root = roots::root_of_args();
        }
        // (0.15: std's names where there is no program: a program of
        // nothing but std)
        // (0.19: an intrinsic, declared for the question: intrinsics.vl)
        let names_intrinsics = sub != "grep"
            && crate::tools::query::intrinsics::query_names_intrinsics(args);
        var std_only = false;
        if find_root(root) == 0 as *u8 && sub != "grep"
            && (all_std(args) || names_intrinsics) {
            root = std_root();
            std_only = root != 0 as *u8;
        }
        root = root_or_diag(root, cmd, first, args.count > 0);
        if root == 0 as *u8 {
            return 2;
        }
        if sub == "effects" && check_effect_options() != 0 {
            return 2;
        }
        // (0.13: def, show, refs, callers and items from the tools' cache,
        // when it holds for the program; else read in full, then cached.
        // grep and type need the tokens and nodes, which are not cached:
        // they read the program in full, and leave the cache as it is)
        // (0.15: a question about std reads the program with std, and
        // without the cache, which holds the program as it is)
        var with_std = std_only || std_requested() || sub == "examples"
            || (unsafe_sites && !crate::tools::query::unsafe_audit::OPT_NO_STD)
            || (OPT_IN != 0 as *u8 && names_std(c_slice(OPT_IN)));
        for k in 0..args.count {
            if names_std(c_slice(args.data[k] as *u8)) {
                with_std = true;
            }
        }
        if names_intrinsics {
            with_std = true;
        }
        STD_ALWAYS = with_std;
        let context = sub == "context";
        // (0.16: a local, by FILE:LINE:COL or asked again in full, needs
        // the nodes: locals.vl)
        var at_column = false;
        for k in 0..args.count {
            if sub == "refs" && has_column(c_slice(args.data[k] as *u8)) {
                at_column = true;
            }
        }
        // (0.16: effects without --has and --why: the cached lines)
        let plain_effects = sub == "effects" && OPT_HAS == 0 as *u8 && OPT_WHY == 0 as *u8;
        let cacheable = (sub == "def" || sub == "show" || sub == "refs"
            || sub == "callers" || items || context || plain_effects) && !with_std
            && !at_column && !full_requested() && !arch_options_given();
        let cached = cacheable && cache_restore(root, 0, is_refs || context);
        crate::front::check::unsafety::AUDIT_UNSAFE = unsafe_sites;
        // (0.25.5, feedbacks/stdunsafe254.md #1: std as the tree has it, when
        // its files differ from this compiler's std, as check reads it)
        if unsafe_sites && with_std {
            crate::tools::edit::cli::std_tree_if_edited();
        }
        if sub == "drops" {
            drops_wanted();
        }
        if !cached && !load_program(root, 0) {
            // (nothing to answer with: the errors say why)
            program_errors(c"error", root, true);
            return 1;
        }
        // (0.17: `items TYPE` of a std type, when no module is named so)
        var items_of_types = items;
        for k in 0..args.count {
            var ms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if items {
                find_modules(c_slice(args.data[k] as *u8), OPT_EXACT, &ms);
            }
            if ms.count > 0 {
                items_of_types = false;
            }
        }
        if !with_std && STD_MODULE < 0 && (!items || items_of_types) && sub != "grep"
            && sub != "type" && sub != "own" && sub != "drops" && wants_std(args) {
            // (a NAME std defines and the program does not: asked again
            // with std)
            ask_with_std();
        }
        let t = timer_now();
        let status = answer(cmd, sub, args, items, is_refs);
        timer_add(T_ANSWER, t);
        program_errors(c"warning", root, status != 0);
        // (the diagnostics after the answer: run_query)
        if cacheable {
            cache_save(root, 0);
        }
        status
    }
}

// The definitions answering to NAME, in order of position (none: after
// the diagnostic saying so, for command cmd). NAME is a path, or its end
// (see name_matches), or `FILE:LINE` (`FILE:LINE:COL`, as a compiler's
// error has it): the innermost item whose text holds that line (0.15: on
// a comment or blank line, the item below it; outside every item, as on
// a `use` line, what the name at COL, or the first on the line, names).
// Every spelling the tools print is taken (canonical_name).
pub fn resolve_name(cmd: *u8, name0: [u8], out: inout IntVec) -> bool {
    unsafe {
        let name = canonical_name(name0);
        // (0.25.2.2) `FILE.vl::item`: the item of that file
        let fp = roots::file_part(name);
        if fp.len > 0 && fp.len + 2 < name.len {
            return file_item_defs(cmd, name, fp, &out);
        }
        var line = -1;
        var col = -1;
        var file = name[0..0];
        let a = trailing_number(name);
        if a > 0 && name[a - 1] == ':' && (a < 2 || name[a - 2] != ':') {
            line = parse_digits(name[a..name.len]);
            file = name[0..a - 1];
            let b = trailing_number(file);
            if b > 0 && file[b - 1] == ':' && (b < 2 || file[b - 2] != ':') {
                // (FILE:LINE:COL)
                col = line;
                line = parse_digits(file[b..file.len]);
                file = file[0..b - 1];
            }
        }
        if line < 0 {
            find_defs(name, OPT_EXACT, &out);
            if out.count == 0 && !OPT_EXACT {
                // (0.13: an import's other name, for what it imports)
                let at = alias_defs(last_segment(name), &out);
                if at >= 0 {
                    let d = diag(c"note", c"query.alias");
                    buf_byte(d, '\'');
                    buf_bytes(d, last_segment(name));
                    buf_str(d, c"' is an import alias in ");
                    buf_bytes(d, mod_fqn_text(module_at(at)));
                    buf_str(d, c", for ");
                    buf_bytes(d, SYMS[DEFS[out.data[0]].fqn].text);
                    buf_byte(d, '\n');
                    sort_by_position(out);
                }
            }
            if out.count == 0 && name.len != name0.len && is_symbol(name0) {
                // (a symbol of a trait's default function: `T::f` is the
                // trait's `f`)
                find_defs(last_segment(name), OPT_EXACT, &out);
            }
            if out.count == 0 && name.len > 5 && name[0..5] == "std::" {
                // (0.20) `std::NAME` that std re-exports from its modules:
                // the item it names (`std::read_line` is std::io::read_line)
                let rest = name[5..name.len];
                var cut = 0;
                while cut + 1 < rest.len && !(rest[cut] == ':' && rest[cut + 1] == ':') {
                    cut += 1;
                }
                let head = if cut + 1 < rest.len { rest[0..cut] } else { rest };
                let key = std_item_key(intern(head));
                if key >= 0 {
                    let full = buf_new();
                    buf_bytes(full, SYMS[key].text);
                    buf_bytes(full, rest[head.len..rest.len]);
                    find_defs(buf_slice(full), OPT_EXACT, &out);
                }
            }
            if out.count == 0 {
                // (0.25.2.1) a name a module re-exports: `std::gpu::Color`
                // is std::gpu::types::Color
                let via = reexported::reexport_defs(name, false, &out);
                if via >= 0 {
                    let d = diag(c"note", c"query.reexport");
                    buf_bytes(d, name);
                    buf_str(d, c" is ");
                    buf_bytes(d, SYMS[DEFS[out.data[0]].fqn].text);
                    buf_str(d, c", which ");
                    buf_bytes(d, mod_fqn_text(via));
                    buf_str(d, c" re-exports (`pub use`)\n");
                    sort_by_position(out);
                    return true;
                }
            }
            if out.count == 0 {
                // (0.25.2.2) a name a module imports: `wgsl::expr::Front::unary`
                // is wgsl::front::Front::unary when expr has `use super::front::Front`
                let via = reexported::reexport_defs(name, true, &out);
                if via >= 0 {
                    let d = diag(c"note", c"query.reexport");
                    buf_bytes(d, name);
                    buf_str(d, c" is ");
                    buf_bytes(d, SYMS[DEFS[out.data[0]].fqn].text);
                    buf_str(d, c", which ");
                    buf_bytes(d, mod_fqn_text(via));
                    buf_str(d, c" imports (`use`)\n");
                    sort_by_position(out);
                    return true;
                }
            }
            if out.count == 0 && module_def(name, &out) {
                return true;
            }
            if out.count == 0 && derived_note(*cmd, name) {
                return false;
            }
            if out.count == 0 {
                no_match(cmd, name);
                return false;
            }
            return true;
        }
        var f = -1;
        for g in 0..FILES.len() {
            let p = file_text(g);
            if path_matches(p, file) {
                f = g;
                break;
            }
        }
        if f < 0 {
            let d = diag(c"error", c"query.no-match");
            buf_str(d, c"no file '");
            buf_bytes(d, file);
            buf_str(d, c"' in the program\n");
            try_end(try_begin(c"items", name[0..0], false));
            return false;
        }
        var d = def_at_line(f, line);
        if d < 0 {
            d = item_below(f, line);
        }
        if d < 0 && line >= 1 {
            let idx = line_index(FILES[f].start) + line - 1;
            if idx < LINES.count && LINES.data[idx] < FILES[f].end {
                let start = LINES.data[idx];
                let end = line_end(start);
                if col >= 1 && start + col - 1 <= end {
                    // (the name holding COL: it starts at or before it)
                    var p = start + col - 1;
                    while p > start && is_name_char(SRC[p - 1]) {
                        p -= 1;
                    }
                    d = def_used_at(p, end);
                } else {
                    d = def_used_at(start, end);
                }
            }
        }
        if d < 0 {
            let e = diag(c"error", c"query.no-match");
            buf_str(e, c"no item at ");
            buf_bytes(e, name);
            buf_byte(e, '\n');
            try_query(c"items", mod_fqn_text(FILES[f].module));
            return false;
        }
        out.push(d);
        true
    }
}

// (0.25.2.2) The definitions `FILE.vl::item` names, into out: the item's
// path in the module of FILE (`sim.vl::Sim::f` is crate::sim::Sim::f),
// else what answers to the item among the definitions written in FILE
// (an impl's methods for a type of another module); false, with the
// diagnostic, for none. (The 0.25.2.1 eval's `show sim.vl::Sim::snapshot_in`
// found nothing.)
fn file_item_defs(cmd: *u8, name: [u8], file: [u8], out: inout IntVec) -> bool {
    // UNSAFE: FILES and DEFS are the compiler's tables, raw pointers.
    // SAFETY: g < FILE_COUNT; d is a definition find_defs gave (< DEF_COUNT).
    unsafe {
        let item = name[file.len + 2..name.len];
        var f = -1;
        for g in 0..FILES.len() {
            if path_matches(file_text(g), file) {
                f = g;
                break;
            }
        }
        if f >= 0 {
            let full = buf_new();
            buf_bytes(full, mod_fqn_text(FILES[f].module));
            buf_str(full, c"::");
            buf_bytes(full, item);
            find_defs(buf_slice(full), true, &out);
            if out.count == 0 {
                var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                find_defs(item, OPT_EXACT, &all);
                for k in 0..all.count {
                    let d = all.data[k];
                    if DEFS[d].start >= FILES[f].start && DEFS[d].start < FILES[f].end {
                        out.push(d);
                    }
                }
            }
            if out.count > 0 {
                return true;
            }
        }
        no_match(cmd, name);
        false
    }
}

// The start of the run of digits that ends s (s.len: none).
pub fn trailing_number(s: [u8]) -> i64 {
    var i = s.len;
    while i > 0 && s[i - 1] >= '0' && s[i - 1] <= '9' {
        i -= 1;
    }
    if i == s.len { -1 } else { i }
}

pub fn parse_digits(s: [u8]) -> i64 {
    var n = 0;
    for i in 0..s.len {
        n = n * 10 + (s[i] - '0') as i64;
    }
    n
}

// The innermost definition (not a field or variant) of file f whose text
// (its comments and attributes included) holds line `line`, or -1.
pub fn def_at_line(f: i64, line: i64) -> i64 {
    unsafe {
        let idx = line_index(FILES[f].start) + line - 1;
        if line < 1 || idx >= LINES.count || LINES.data[idx] >= FILES[f].end + 1 {
            return -1;
        }
        var pos = LINES.data[idx];
        while pos < FILES[f].end && (SRC[pos] == ' ' || SRC[pos] == '\t') {
            pos += 1;
        }
        var best = -1;
        var best_size = 0;
        for d in 0..DEFS.len() {
            let k = DEFS[d].kind;
            if k == K_FIELD || k == K_VARIANT || DEFS[d].start < FILES[f].start
                || DEFS[d].start >= FILES[f].end {
                continue;
            }
            if pos >= DEFS[d].end || pos < line_start(DEFS[d].start) {
                continue;
            }
            let from = text_start(d);
            if pos < from {
                continue;
            }
            if best < 0 || DEFS[d].end - from < best_size {
                best = d;
                best_size = DEFS[d].end - from;
            }
        }
        best
    }
}

// (0.14) NAME as `FILE:LINE` (or `FILE:LINE:COL`): the length of its FILE
// part, its line in *line; -1 when it is not one.
pub fn file_line(name: [u8], line: inout i64) -> i64 {
    let a = trailing_number(name);
    if a < 2 || name[a - 1] != ':' || name[a - 2] == ':' {
        return -1;
    }
    var file = name[0..a - 1];
    line = parse_digits(name[a..name.len]);
    let b = trailing_number(file);
    if b >= 2 && file[b - 1] == ':' && file[b - 2] != ':' {
        line = parse_digits(file[b..file.len]);
        file = file[0..b - 1];
    }
    file.len
}

// (0.14) The file of the program named `file` (its path, or the end of it
// after a `/`), or -1.
pub fn file_named(file: [u8]) -> i64 {
    for g in 0..FILES.len() {
        let p = file_text(g);
        if p.len > 0 && p[0] != '<' && path_matches(p, file) {
            return g;
        }
    }
    -1
}

// The answer to the command, once the program is known; the NAMEs (or
// MODULEs) are `args`.
fn answer(cmd: *u8, sub: str, args: IntVec, items: bool, is_refs: bool) -> i64 {
    unsafe {
        let n = args.count;
        // (0.25.3: unsafe_audit.vl)
        if sub == "unsafe" {
            return crate::tools::query::unsafe_audit::query_unsafe(args);
        }
        if items {
            // (0.25.3) --kind, --find, --names (show.vl)
            let bad = bad_item_kind();
            if bad.len > 0 {
                let out = usage_error();
                buf_str(out,
                    c"--kind of items takes fn, method, struct, enum, trait, trait-method, const, static, type, mod; not '");
                buf_bytes(out, bad);
                buf_str(out, c"'\n");
                let t = try_begin(c"items", if n > 0 { c_slice(args.data[0] as *u8) } else { "" },
                    n > 0);
                put_word(t, "--kind");
                put_word(t, "fn,method");
                try_end(t);
                return 2;
            }
            let filtered = items_filtered();
            if n == 0 && !filtered && !OPT_NAMES {
                query_modules();
                return 0;
            }
            var modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if n == 0 {
                // (filtered: every module of the program, not std's)
                var every = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                find_modules("", false, &every);
                for i in 0..every.count {
                    if !within_std(every.data[i]) {
                        modules.push(every.data[i]);
                    }
                }
            }
            var types = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var status = 0;
            for i in 0..n {
                let text = c_slice(args.data[i] as *u8);
                let before = modules.count;
                find_modules(text, OPT_EXACT, &modules);
                // (0.20) `items std` is std's whole API: its modules' items
                // too, module by module
                if modules.count == before + 1 && modules.data[before] == STD_MODULE {
                    for m in 0..module_count() {
                        if m != STD_MODULE && within_std(m) && !is_within(m, ARCH_MODULE) {
                            modules.push(m);
                        }
                    }
                }
                if modules.count == before {
                    // (0.17: a type: its impl blocks' functions)
                    var defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                    find_defs(text, OPT_EXACT, &defs);
                    let t0 = types.count;
                    for j in 0..defs.count {
                        let k = DEFS[defs.data[j]].kind;
                        if k == K_STRUCT || k == K_ENUM || k == K_TRAIT {
                            types.push(defs.data[j]);
                        }
                    }
                    if types.count == t0 {
                        no_module(text);
                        status = 1;
                    }
                }
            }
            if modules.count > 0 {
                query_items(modules);
            }
            if types.count > 0 {
                query_type_items(types);
            }
            if filtered {
                // (std asked: the primitive types' constants too)
                var shown = ITEMS_SHOWN;
                var std_asked = false;
                for i in 0..modules.count {
                    if modules.data[i] == STD_MODULE {
                        std_asked = true;
                    }
                }
                if std_asked {
                    let out = buf_new();
                    shown += put_builtin_consts(out);
                    buf_write_fd(out, STDOUT);
                }
                if shown == 0 && status == 0 {
                    let d = diag(c"note", c"query.empty");
                    buf_str(d, c"no item");
                    if OPT_FIND != 0 as *u8 {
                        buf_str(d, c" whose name holds '");
                        buf_str(d, OPT_FIND);
                        buf_str(d, c"'");
                    }
                    if OPT_KIND != 0 as *u8 {
                        buf_str(d, c" of kind ");
                        buf_str(d, OPT_KIND);
                    }
                    buf_str(d, c" here\n");
                    if OPT_FIND != 0 as *u8 {
                        try_query(c"grep", c_slice(OPT_FIND));
                    }
                }
            }
            return status;
        }
        if sub == "stats" {
            return query_stats(if n == 0 { 0 as *u8 } else { args.data[0] as *u8 });
        }
        if sub == "deps" {
            return query_deps(c_slice(args.data[0] as *u8));
        }
        if sub == "unused" {
            return query_unused(if n == 0 { 0 as *u8 } else { args.data[0] as *u8 });
        }
        if is_refs {
            if OPT_IN != 0 as *u8 && !resolve_in(c_slice(OPT_IN)) {
                let out = diag(c"error", c"query.bad-in");
                put_bad_in(out, OPT_IN);
                try_end(try_begin(cmd, c_slice(args.data[0] as *u8), true));
                return 1;
            }
        }
        if sub == "grep" {
            return query_grep(args);
        }
        if sub == "callees" {
            // (0.16: callees.vl)
            var fns = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..n {
                var matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                if !resolve_name(cmd, c_slice(args.data[i] as *u8), &matches) {
                    return 1;
                }
                for j in 0..matches.count {
                    push_once(&fns, matches.data[j]);
                }
            }
            var table = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if OPT_WRITES != 0 as *u8 && !resolve_name(cmd, c_slice(OPT_WRITES), &table) {
                return 1;
            }
            return query_callees(fns, c_slice(args.data[0] as *u8), table);
        }
        // (0.17: similar.vl, examples.vl)
        if sub == "similar" {
            return query_similar(args);
        }
        if sub == "examples" {
            return query_examples(args);
        }
        if sub == "context" {
            // (0.15: context.vl)
            var status = 0;
            for i in 0..n {
                let text = c_slice(args.data[i] as *u8);
                let m = context_module(text);
                if m >= 0 {
                    query_context_module(m, text);
                    continue;
                }
                var matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                if !resolve_name(cmd, text, &matches) || query_context(text, matches) != 0 {
                    status = 1;
                }
            }
            return status;
        }
        var status = 0;
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var title_next = false;
        for i in 0..n {
            let text = c_slice(args.data[i] as *u8);
            if title_next {
                title_next = false;
                continue;
            }
            if sub == "type" {
                if query_type(text) != 0 {
                    status = 1;
                }
                continue;
            }
            // (0.26.1: drops.vl)
            if sub == "drops" {
                if query_drops(text) != 0 {
                    status = 1;
                }
                continue;
            }
            // (0.17: ownat.vl)
            if sub == "own" {
                if query_own(text) != 0 {
                    status = 1;
                }
                continue;
            }
            if sub == "views" {
                // (0.17: a module's functions, values.vl)
                let m = context_module(text);
                if m >= 0 {
                    if query_views_module(m) != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            if sub == "effects" {
                // (0.16: a module's functions, effects.vl)
                let m = context_module(text);
                if m >= 0 {
                    if query_effects_module(m) != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            if sub == "show" && ends_with_c(args.data[i] as *u8, c"::section") {
                // (MODULE::section TITLE)
                let title = if i + 1 < n { c_slice(args.data[i + 1] as *u8) }
                    else { text[0..0] };
                title_next = true;
                let r = show_section(text, title);
                if r >= 0 {
                    if r != 0 {
                        status = r;
                    }
                    continue;
                }
                title_next = false;
            }
            if sub == "show" {
                // (MODULE::use, ::header, ::extern)
                let r = show_region(text);
                if r >= 0 {
                    if r != 0 {
                        status = 1;
                    }
                    continue;
                }
            }
            if sub == "refs" {
                // (0.16: a local, `FN::x` or FILE:LINE:COL)
                let r = local_refs(text);
                if r >= 0 {
                    if r != 0 {
                        status = r;
                    }
                    continue;
                }
            }
            var matches = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            if !resolve_name(cmd, text, &matches) {
                status = 1;
                continue;
            }
            if is_refs {
                for j in 0..matches.count {
                    push_once(&all, matches.data[j]);
                }
            } else if sub == "impact" {
                status = query_impact(matches, text);
            } else if sub == "show" {
                if query_show(matches, text) != 0 {
                    status = 1;
                }
            } else if sub == "effects" {
                // (0.16, effects.vl)
                if query_effects(matches) != 0 {
                    status = 1;
                }
            } else if sub == "features" {
                // (0.19, features.vl)
                let r = crate::tools::query::features::query_features(matches);
                if r != 0 {
                    status = r;
                }
            } else if sub == "views" {
                // (0.17, values.vl)
                if query_views(matches) != 0 {
                    status = 1;
                }
            } else {
                query_def(matches);
            }
        }
        if is_refs && all.count > 0 {
            sort_by_position(all);
            let name = c_slice(args.data[0] as *u8);
            if query_refs(all, cmd, name) != 0 {
                status = 1;
            }
        }
        status
    }
}
