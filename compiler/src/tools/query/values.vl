// What the own pass knows per definition, for the query tools and their
// cache (0.17, docs/design/value-semantics.md §2.9, §4 step 7): a type's
// kind (`owned`, `view`, `plain`) and a function's view summary
// (`views(*self) inferred`). cache.vl keeps both texts per definition,
// as it keeps the effects'.
//
// Phase 0: the texts and the cache's slots. T3 prints the summaries
// (`query views`, `views:` on def/show/context), T6 the kinds (`query
// own`); both read them from here.

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, buf_write_fd, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::{module_count, within_std};
use crate::front::own::infer::views_why;
use crate::front::own::kinds::kind_word;
use crate::front::own::summary::{
    ret_parametric, summary_inferred, summary_of, summary_text, view_fn,
};
use crate::front::types::{ENUMS, enum_type, struct_type};
use crate::tools::ctx::Tcx;
use crate::tools::query::defs::{K_ENUM, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STRUCT, K_TRAIT_FN};
use crate::tools::query::diagnostics::diag;

fn cached(out: i64, d: i64, k: i64, tcx: Tcx<Comp>) {
    unsafe {
        let at = 4 * d + 2 * k;
        if tcx.c_own_buf < 0 || at + 1 >= tcx.c_own_text.count {
            return;
        }
        buf_bytes(out,
            buf_slice(tcx.c_own_buf)[tcx.c_own_text.data[at]..tcx.c_own_text.data[at + 1]]);
    }
}

// The type a struct or enum definition d declares (not a template), or -1.
fn type_of_def(d: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let node = pcx.defs[d].node;
        if pcx.defs[d].kind == K_STRUCT {
            for s in 0..pcx.structs.len() as i64 {
                if pcx.structs[s].node == node && pcx.structs[s].generic == 0
                    && pcx.structs[s].tmpl == 0 {
                    return struct_type(s, &pcx);
                }
            }
        } else if pcx.defs[d].kind == K_ENUM {
            for e in 0..pcx.enum_count {
                if ENUMS[e].node == node && ENUMS[e].generic == 0 && ENUMS[e].tmpl == 0 {
                    return enum_type(e, &pcx);
                }
            }
        }
        -1
    }
}

// The kind of type definition d (`owned`, `view`, `owned view`, `plain`),
// into out; nothing for another definition.
pub fn def_kind_text(out: i64, d: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if tcx.restored {
        cached(out, d, 0, tcx);
        return;
    }
    let t = type_of_def(d, &pcx);
    if t > 0 {
        buf_str(out, kind_word(t, &pcx));
    }
}

// The function of definition d (its FNS index), or -1.
fn fn_of_def(d: i64, pcx: Ctx<Comp>) -> i64 {
    let k = pcx.defs[d].kind;
    if !(k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN) {
        return -1;
    }
    let f = pcx.nodes[pcx.defs[d].node].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 { -1 } else { f }
}

// The summary of function f with how it is known: `views(*self)
// inferred`, `views(s) declared`, `views(...) assumed`; `views()` alone
// for a function whose type says it holds none.
fn views_line_text(out: i64, f: i64, pcx: inout Ctx<Comp>) {
    let s = summary_of(f, &pcx);
    summary_text(out, f, s, &pcx);
    if s.declared || s.top || !view_fn(f, &pcx) {
        return;
    }
    if ret_parametric(f, &pcx) != 0 {
        buf_str(out, c" parametric");
    } else if summary_inferred(f, pcx) {
        buf_str(out, c" inferred");
    }
}

// The view summary of function definition d, into out; nothing for a
// function that is not checked, is generic, or whose type says it holds
// no views (def, show and context print it after the effects).
pub fn def_views_text(out: i64, d: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if tcx.restored {
        cached(out, d, 1, tcx);
        return;
    }
    let f = fn_of_def(d, pcx);
    // (views() says nothing, nor does one assumed for a body that did
    // not check: shown by `query views` only)
    if f < 0 || pcx.fns[f].generic != 0 || !shows_views(f, &pcx) || summary_of(f, &pcx).top {
        return;
    }
    views_line_text(out, f, &pcx);
}

// ` views: SUMMARY` of definition d into out, for def, show and context:
// whether it has one to show.
pub fn put_def_views(out: i64, d: i64, sep: *u8, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    let text = buf_new();
    def_views_text(text, d, tcx, &pcx);
    if buf_slice(text).len == 0 {
        return false;
    }
    buf_str(out, sep);
    buf_str(out, c"views: ");
    buf_bytes(out, buf_slice(text));
    true
}

// The texts the cache keeps for definition d (cache.vl).
pub fn own_cache_texts(d: i64, kind: i64, views: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    def_kind_text(kind, d, tcx, &pcx);
    def_views_text(views, d, tcx, &pcx);
}

// ---------------------------------------------------------------------------
// `query views NAME... | MODULE [--why]` (§2.9)

fn views_line(out: i64, name: [u8], f: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    buf_bytes(out, name);
    buf_byte(out, '\t');
    views_line_text(out, f, &pcx);
    buf_byte(out, '\n');
    if tcx.opt_views_why {
        views_why(out, f, &pcx);
    }
}

// Whether instance g is one query mode made to check a template (a type
// argument the error type).
fn error_instance(g: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        for i in 0..pcx.fns[g].targ_count {
            if pcx.tlists.data[pcx.fns[g].targs + i] == pcx.ty_error {
                return true;
            }
        }
        false
    }
}

// Whether function f's summary says something: not views() (it is
// declared, assumed, or has a source).
fn shows_views(f: i64, pcx: inout Ctx<Comp>) -> bool {
    if !view_fn(f, &pcx) {
        return false;
    }
    let s = summary_of(f, &pcx);
    var any = s.declared || s.top;
    for k in 0..4 {
        if (s.ret[k] | s.sto[k]) != 0 {
            any = true;
        }
    }
    any
}

// The lines of definitions defs; with only_views, the functions whose
// summary is not views() (a module's).
fn views_of(defs: IntVec, only_views: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        var shown = 0;
        for i in 0..defs.count {
            let d = defs.data[i];
            if tcx.restored {
                let text = buf_new();
                cached(text, d, 1, tcx);
                let k = pcx.defs[d].kind;
                let is_fn = k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN;
                if buf_slice(text).len == 0 && only_views || !is_fn {
                    continue;
                }
                buf_bytes(out, sym_text(pcx.defs[d].fqn, pcx));
                buf_byte(out, '\t');
                if buf_slice(text).len == 0 {
                    buf_str(out, c"views()");
                } else {
                    buf_bytes(out, buf_slice(text));
                }
                buf_byte(out, '\n');
                shown += 1;
                continue;
            }
            let f = fn_of_def(d, pcx);
            if f < 0 {
                continue;
            }
            if pcx.fns[f].generic == 0 {
                if only_views && !shows_views(f, &pcx) {
                    continue;
                }
                views_line(out, sym_text(pcx.defs[d].fqn, pcx), f, tcx, &pcx);
                shown += 1;
                continue;
            }
            for g in 0..pcx.fns.len() as i64 {
                if pcx.fns[g].tmpl == f + 1 && !error_instance(g, pcx)
                    && (!only_views || shows_views(g, &pcx)) {
                    views_line(out, sym_text(pcx.fns[g].display, pcx), g, tcx, &pcx);
                    shown += 1;
                }
            }
        }
        buf_write_fd(out, STDOUT);
        if shown == 0 {
            let e = diag(c"note", c"query.empty", &tcx);
            if only_views {
                buf_str(e, c"no function returns or stores views (every summary is views())\n");
            } else {
                buf_str(e, c"no function among the names (or a generic one without instances)\n");
            }
        }
        0
    }
}

// `query views NAME...`: the summaries of the functions among `matches`
// (a module's: those of its functions that are not views()).
pub fn query_views(matches: IntVec, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var module = false;
        for i in 0..matches.count {
            let d = matches.data[i];
            if pcx.defs[d].kind == K_MOD {
                for m in 0..module_count(pcx) {
                    if m < pcx.mod_def.count && pcx.mod_def.data[m] == d {
                        module_fns(m, &defs, pcx);
                        module = true;
                    }
                }
            } else if pcx.defs[d].kind == K_STRUCT || pcx.defs[d].kind == K_ENUM {
                // (a type: its methods, `Type::m`)
                type_fns(d, &defs, pcx);
                module = true;
            } else {
                defs.push(d);
            }
        }
        views_of(defs, module, &tcx, &pcx)
    }
}

// The function definitions under type definition d (`PATH::m`, `<PATH as
// Trait>::m`), into out.
fn type_fns(d: i64, out: inout IntVec, pcx: Ctx<Comp>) {
    let base = sym_text(pcx.defs[d].fqn, pcx);
    for g in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[g].kind;
        if !(k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN) {
            continue;
        }
        let p = sym_text(pcx.defs[g].fqn, pcx);
        let at = if p.len > 0 && p[0] == '<' { 1 } else { 0 };
        if p.len as i64 <= at + base.len as i64 + 2 {
            continue;
        }
        var same = true;
        for i in 0..base.len as i64 {
            if p[at + i] != base[i] {
                same = false;
                break;
            }
        }
        let next = p[at + base.len as i64];
        if same && (at == 0 && next == ':' || at == 1 && next == ' ') {
            out.push(g);
        }
    }
}

// `query views MODULE`: the functions of module m and of its modules
// whose summary is not views().
pub fn query_views_module(m: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    var defs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    module_fns(m, &defs, pcx);
    views_of(defs, true, &tcx, &pcx)
}

// The function definitions of module m and of its modules, into out, in
// the order of DEFS.
fn module_fns(m: i64, out: inout IntVec, pcx: Ctx<Comp>) {
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d].kind;
        if !(k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN) {
            continue;
        }
        var x = pcx.defs[d].module;
        if (within_std(x, pcx) && !within_std(m, pcx)) || (x == pcx.c_module && x != m) {
            continue;
        }
        var steps = 0;
        while x >= 0 && x != m && steps < 64 {
            x = pcx.modules[x].parent;
            steps += 1;
        }
        if x == m {
            out.push(d);
        }
    }
}
