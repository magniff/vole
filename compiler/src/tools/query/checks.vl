// `volec query checks FN|MODULE` and `--print-checks[=NAME]` (0.18 T5,
// design §2.14): the run-time checks left in each function once it is
// optimized (-O2 unless a level is given), one line each, `FILE:LINE:COL
// FN KIND left`, and those the optimizer removed (`removed`: the range
// analysis proved them, with the dominating conditions, the loop bounds
// or a clause's check), so that a performance task sees what its loop
// still checks without reading the assembly.
//
// A check is one call of the run-time helper (rt.panic) in the IR: its
// kind (an index, a slice range, an enum value, a contract or assertion)
// and its site (front/contracts/sites.vl). The lowering notes every
// check it makes (note_check); the ones not found after the optimizer
// were removed.

use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_ptr, buf_str, buf_write_fd, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, Leaf, is_opt, option, short_option, table};
use crate::front::contracts::sites::site_count;
use crate::gen0::target::{PANIC_RANGE_UNSIGNED, kind_is_enum, rt_panic_sym};
use crate::middle::ctx::{FnCtx, main_cx};
use crate::middle::ir::{Op, fn_block, fn_block_count, ir_enter};
use crate::tools::ctx::Tcx;

// UNSAFE: C's system: --print-checks runs the compiler again.
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn system(command: *mut u8) -> i32;
}

// A check made in the IR function being lowered (rt_panic_call).
pub fn note_check(fi: i64, site: i64, kind: i64, pcx: &mut Ctx<Comp>) {
    if pcx.print_checks == 0 as *mut u8 {
        return;
    }
    pcx.checks_noted.push(fi);
    pcx.checks_noted.push(site);
    pcx.checks_noted.push(kind);
}

// Block b, a branch's successor that the range analysis found never taken:
// the check failing there, if it is one, noted as removed.
pub fn note_removed(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0 {
        if (cx.insts[v as usize]).op == Op::CallC
            && (cx.insts[v as usize]).imm == rt_panic_sym(pcx)
            && (cx.insts[v as usize]).nargs >= 5 {
            let k = (cx.args[(cx.insts[v as usize]).args as usize]);
            let s = (cx.args[((cx.insts[v as usize]).args + 4) as usize]);
            push_removed(cx.irf, pcx);
            push_removed(front_number(cx, s, 0, pcx), pcx);
            push_removed(front_number(cx, k, -1, pcx), pcx);
            return;
        }
        v = (cx.insts[v as usize]).next;
    }
}

// The front end's kind or site that value v of a panic call is (a
// constant, or an RTID value since 0.18.1), or `none`.
fn front_number(cx: &mut FnCtx<Comp>, v: i64, none: i64, pcx: &Ctx<Comp>) -> i64 {
    if (cx.insts[v as usize]).op == Op::Const {
        return (cx.insts[v as usize]).imm;
    }
    if (cx.insts[v as usize]).op == Op::RtId {
        return crate::middle::ir::rtid_value((cx.insts[v as usize]).imm, pcx);
    }
    none
}

fn kind_name(kind: i64, pcx: &Ctx<Comp>) -> *const u8 {
    if kind < 0 {
        c"check"
    } else if kind < 2 {
        c"index"
    } else if kind <= PANIC_RANGE_UNSIGNED {
        c"slice"
    } else if kind_is_enum(kind, pcx) {
        c"enum"
    } else {
        c"contract"
    }
}

// Whether function f (a FNS index) is one --print-checks asks for.
fn wanted(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: strlen is C's; --print-checks's value is a C string, read
    // through its raw pointer.
    // SAFETY: print_checks is called only when pcx.print_checks is not null
    // (gen0's compile_program); its bytes are read below its strlen, and the
    // first one at least is there (the 0).
    unsafe {
        let want = pcx.print_checks;
        if (*want.add(0)) == 0 {
            return true;
        }
        let name = sym_text(pcx.fns[f as usize].display, pcx);
        let n = strlen(want) as i64;
        if name.len() as i64 < n {
            return false;
        }
        for i in 0..n {
            if name[i as usize] != (*want.add(i as usize)) {
                return false;
            }
        }
        name.len() as i64 == n || name[n as usize] == b':' || name[n as usize] == b'<'
            || name[n as usize] == b'$'
    }
}

fn put_site(out: i64, site: i64, pcx: &Ctx<Comp>) {
    if site <= 0 || site >= site_count(pcx) {
        buf_str(out, c"?");
        return;
    }
    let path = crate::base::source_path((pcx.site_file[site as usize]), pcx);
    buf_bytes(out,
        if path.len() > 2 && path[0] == b'.' && path[1] == b'/' { &path[2..] } else { path });
    buf_byte(out, b':');
    buf_int(out, (pcx.site_line[site as usize]));
    buf_byte(out, b':');
    buf_int(out, (pcx.site_col[site as usize]));
}

// The checks of the optimized program's functions, printed (after
// optimize_program, before the code is emitted).
pub fn print_checks(pcx: &mut Ctx<Comp>) {
    // UNSAFE: the main function context, reached through its raw pointer (main_cx)
    // SAFETY: cx is the main context (main_cx: made once, never freed); --print-checks runs
    // this report on one thread after the passes, and each reference made of cx here is for
    // one call or one read, with no other reference to that context in use
    unsafe {
        let cx = main_cx(pcx);
        let out = buf_new();
        let mut left: i64 = 0;
        let mut removed: i64 = 0;
        let mut seen: Vec<i64, Comp> = Vec::new_in(Comp {});
        for fi in 0..pcx.irfunc_count {
            let f = pcx.ir_fn[fi as usize];
            if (pcx.fn_live[fi as usize]) == 0 || !wanted(f, pcx) {
                continue;
            }
            ir_enter(&mut *cx, fi, pcx);
            seen.clear();
            for i in 0..fn_block_count(&*cx, fi) {
                let b = fn_block(&*cx, fi, i);
                if (cx.blocks[b as usize]).removed != 0 {
                    continue;
                }
                let mut v = (cx.blocks[b as usize]).first;
                while v != 0 {
                    if (cx.insts[v as usize]).op == Op::CallC
                        && (cx.insts[v as usize]).imm == rt_panic_sym(pcx)
                        && (cx.insts[v as usize]).nargs >= 5 {
                        let k = (cx.args[(cx.insts[v as usize]).args as usize]);
                        let s = (cx.args[((cx.insts[v as usize]).args + 4) as usize]);
                        let kind = front_number(&mut *cx, k, -1, pcx);
                        let site = front_number(&mut *cx, s, 0, pcx);
                        put_site(out, site, pcx);
                        buf_fmt_fn(out, f, kind_name(kind, pcx), c"left", pcx);
                        seen.push(site);
                        left += 1;
                    }
                    v = (cx.insts[v as usize]).next;
                }
            }
            // Removed by the range analysis (here, or in a function inlined
            // here), then the others made here and gone.
            let mut j: i64 = 0;
            while j < removed_len(pcx) {
                if (removed_at(j, pcx)) == fi {
                    put_site(out, (removed_at(j + 1, pcx)), pcx);
                    buf_fmt_fn(out, f, kind_name((removed_at(j + 2, pcx)), pcx),
                        c"removed (ranges)", pcx);
                    seen.push((removed_at(j + 1, pcx)));
                    removed += 1;
                }
                j += 3;
            }
            j = 0;
            while j < pcx.checks_noted.len() as i64 {
                if (pcx.checks_noted[j as usize]) == fi
                    && (pcx.checks_noted[(j + 1) as usize]) > 0
                    && !(0i64..seen.len() as i64).any(|q| (seen[q as usize])
                        == (pcx.checks_noted[(j + 1) as usize])) {
                    put_site(out, (pcx.checks_noted[(j + 1) as usize]), pcx);
                    buf_fmt_fn(out, f,
                        kind_name((pcx.checks_noted[(j + 2) as usize]), pcx), c"removed",
                        pcx);
                    removed += 1;
                }
                j += 3;
            }
        }
        buf_str(out, c"checks: ");
        buf_int(out, left);
        buf_str(out, c" left, ");
        buf_int(out, removed);
        buf_str(out, c" removed\n");
        buf_write_fd(out, STDOUT);
    }
}

// `\tFN\tKIND\tSTATE\n`
fn buf_fmt_fn(out: i64, f: i64, kind: *const u8, state: *const u8, pcx: &Ctx<Comp>) {
    buf_byte(out, b'\t');
    buf_bytes(out, sym_text(pcx.fns[f as usize].display, pcx));
    buf_byte(out, b'\t');
    buf_str(out, kind);
    buf_byte(out, b'\t');
    buf_str(out, state);
    buf_byte(out, b'\n');
}

// `query checks`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn checks_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    // (0.25: on std::cli; another option is the NAME
    // when none is given yet, else ignored, as before)
    let mut opts = table(gpa);
    opts.push(short_option("O", "N", "the level (1 or 2)"));
    opts.push(option("root", "ROOT", "the program's root file"));
    Leaf::new(opts, "name")
}

// `volec query checks NAME [-O N] [ROOT]`: the program compiled (not
// written) with --print-checks=NAME. Its exit status.
pub fn run_query_checks(c: &Call<'_, Gpa>, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let cmd = buf_new();
    let mut name = 0 as *const u8;
    let mut root = 0 as *const u8;
    let mut level = c"-O2";
    for ev in c.evs.iter().copied() {
        if is_opt(ev, "O") {
            level = if ev.text == "0" { c"-O0" } else if ev.text == "1" { c"-O1" } else { c"-O2" };
            continue;
        }
        if is_opt(ev, "root") {
            root = ev.value;
            continue;
        }
        let a = ev.value;
        if ev.text.starts_with("-O") {
            level = a;
        } else if crate::base::is_source_path(a) {
            root = a;
        } else if name == 0 as *mut u8 {
            name = a;
        }
    }
    // UNSAFE: system is C's.
    // SAFETY: cmd ends with a 0 byte (buf_byte) and is not written again
    // before its bytes are passed as a C string.
    unsafe {
        root = crate::tools::query::roots::program_root(root, tcx, pcx);
        if name == 0 as *mut u8 || root == 0 as *mut u8 {
            buf_str(cmd, c"error query.usage: volec query checks FN|MODULE [-O N] [ROOT]\n");
            buf_write_fd(cmd, 2);
            return 2;
        }
        quote(cmd, c.prog());
        buf_byte(cmd, b' ');
        buf_str(cmd, level);
        buf_str(cmd, c" --print-checks=");
        quote(cmd, name);
        buf_byte(cmd, b' ');
        quote(cmd, root);
        buf_str(cmd, c" -o /dev/null");
        buf_byte(cmd, 0);
        let status = system(buf_ptr(cmd));
        if status == 0 { 0 } else { 1 }
    }
}

fn quote(out: i64, s: *const u8) {
    buf_byte(out, b'\'');
    for &c in crate::base::cstr(s).as_slice() {
        if c == b'\'' {
            buf_str(out, c"'\\''");
        } else {
            buf_byte(out, c);
        }
    }
    buf_byte(out, b'\'');
}

// (0.29) The removed list is the context's (pcx.checks_removed), behind
// its lock: a copy of entry j, and its length.
fn removed_at(j: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.checks_removed.lock().unwrap()[j as usize]
}

fn removed_len(pcx: &Ctx<Comp>) -> i64 {
    pcx.checks_removed.lock().unwrap().len() as i64
}

fn push_removed(x: i64, pcx: &Ctx<Comp>) {
    pcx.checks_removed.lock().unwrap().push(x);
}
