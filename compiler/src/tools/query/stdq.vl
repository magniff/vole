// std in every program's queries (0.15): `query items std`, `show
// std::read_line`, `def Vec::push`, `grep --in std` answer whether the
// program uses std or not. A question that names std (`std`,
// `std::...`, `<std>`) reads the program with std (STD_ALWAYS); a NAME
// that the program does not define but std does is asked again, by the
// same command run with std (VOLE_QUERY_STD=1).

use crate::base::{buf_append, buf_bytes, buf_copy, buf_done, buf_len, buf_new, intern, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::front::modules::lookup::is_prelude_name;
use crate::front::stdsrc_rust::std2_source;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, write_file_if};
use crate::tools::query::defs::{K_IMPL_METHOD, K_METHOD, find_defs, last_segment};
use crate::tools::query::names::canonical_name;

// UNSAFE: C's getenv, setenv and execvp: the query runs itself again with
// std's program.
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
    fn setenv(name: *mut u8, value: *mut u8, overwrite: i32) -> i32;
    fn execvp(file: *mut u8, args: *mut *mut u8) -> i32;
}

// Whether the query was run again with std (by ask_with_std).
pub fn std_requested() -> bool {
    // UNSAFE: getenv is C's; the variable's first byte is read.
    // SAFETY: the name is a literal; v is checked not null before its first
    // byte is read.
    unsafe {
        let v = getenv(c"VOLE_QUERY_STD");
        v != 0 as *mut u8 && (*v.add(0)) == b'1'
    }
}

// Whether argument a names std: `std`, `std::...`, `<std>...`, `std:...`.
pub fn names_std(a: &[u8]) -> bool {
    let s = canonical_name(a);
    if s == b"std" || s == b"<std>" {
        return true;
    }
    (s.len() > 5 && s[0..5] == b"std::") || (s.len() > 5 && s[0..5] == b"<std>")
        || (s.len() > 4 && s[0..4] == b"std:" && s[4] >= b'0' && s[4] <= b'9')
}

// std's source.
fn std_text(tcx: &mut Tcx<Comp>) -> &'static [u8] {
    if tcx.std_text < 0 {
        tcx.std_text = buf_new();
        std2_source(tcx.std_text);
    }
    // (written once, above)
    buf_done(tcx.std_text)
}

fn is_word(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// Whether std's source defines `word` (an item, a method, a variant), by
// its text: the word after `fn `, `struct `, `enum `, `trait `, `type `,
// `const ` or `static `, or a line's first word (a variant).
pub fn std_defines(word: &[u8], tcx: &mut Tcx<Comp>) -> bool {
    if word.len() == 0 {
        return false;
    }
    let t = std_text(tcx);
    let mut i: i64 = 0;
    while i + word.len() as i64 <= t.len() as i64 {
        if t[i as usize] == word[0] && t[i as usize..(i + word.len() as i64) as usize] == word
            && (i + word.len() as i64 == t.len() as i64
                || !is_word(t[(i + word.len() as i64) as usize]))
            && (i == 0 || !is_word(t[(i - 1) as usize])) {
            // (what comes before it on its line)
            let mut a = i;
            while a > 0 && t[(a - 1) as usize] != b'\n' {
                a -= 1;
            }
            let before = &t[a as usize..i as usize];
            // (not in a comment: `// fn bump(..)` in a doc example)
            let mut commented = false;
            for c in 0..before.len() as i64 {
                if before[c as usize] == b'/' && c + 1 < before.len() as i64
                    && before[(c + 1) as usize] == b'/' {
                    commented = true;
                }
            }
            if commented {
                i += 1;
                continue;
            }
            let mut lead: i64 = 0;
            while lead < before.len() as i64 && before[lead as usize] == b' ' {
                lead += 1;
            }
            if lead == before.len() as i64 && lead > 0 {
                return true;
            }
            let kws = ["fn ", "struct ", "enum ", "trait ", "type ", "const ", "static mut ",
                "static "];
            for k in 0..8 {
                let kw = kws[k as usize];
                if before.len() >= kw.len()
                    && before[(before.len() as i64 - kw.len() as i64) as usize..] == kw.as_bytes() {
                    return true;
                }
            }
        }
        i += 1;
    }
    false
}

// Whether some NAME of the command is one std defines and the program
// does not (after the program is read without std).
pub fn wants_std(args: &[i64], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    for i in 0..args.len() as i64 {
        let name = canonical_name(
            crate::base::c_kept((args[i as usize]) as *mut u8));
        if name.len() == 0
            || name[(name.len() as i64 - 1) as usize] >= b'0'
            && name[(name.len() as i64 - 1) as usize] <= b'9' {
            continue;
        }
        let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
        find_defs(name, false, &mut found, tcx, pcx);
        if found.len() as i64 == 0 && std_defines(last_segment(name), tcx) {
            return true;
        }
    }
    false
}

// Whether every NAME of args is one std defines (a question about std
// asked where there is no program).
pub fn all_std(args: &[i64], tcx: &mut Tcx<Comp>) -> bool {
    if args.len() as i64 == 0 {
        return false;
    }
    for i in 0..args.len() as i64 {
        let a = crate::tools::query::c_slice((args[i as usize]) as *mut u8);
        if !names_std(&a) && !std_defines(last_segment(canonical_name(&a)), tcx) {
            return false;
        }
    }
    true
}

// The root of a program of nothing but `fn main`, for std's questions
// where there is no program (made in $TMPDIR once); 0 when it cannot be
// written.
pub fn std_root(pcx: &Ctx<Comp>) -> *mut u8 {
    // UNSAFE: getenv is C's; the variable's first byte is read.
    // SAFETY: the name is a literal; tmp is checked not null before its
    // first byte is read.
    unsafe {
        let b = buf_new();
        let tmp = getenv(c"TMPDIR");
        if tmp != 0 as *mut u8 && (*tmp.add(0)) != 0 {
            crate::base::buf_str(b, tmp);
        } else {
            buf_bytes(b, b"/tmp");
        }
        let s = buf_copy(b);
        if s.len() > 0 && s[(s.len() as i64 - 1) as usize] != b'/' {
            buf_bytes(b, b"/");
        }
        buf_bytes(b, b"volec-std-query.vl");
        let path = buf_cstr(b);
        if !file_exists(path, pcx)
            && !write_file_if(path,
                b"// std's questions where there is no program (volec query).\nfn main() {}\n") {
            return 0 as *mut u8;
        }
        path
    }
}

// Runs this command again with std (the same arguments; never returns
// when it can run).
pub fn ask_with_std(tcx: &Tcx<Comp>) {
    let words = crate::tools::query::roots::command_words(tcx);
    let args = crate::tools::proc::exec_words(words.as_slice());
    // UNSAFE: setenv and execvp are C's.
    // SAFETY: the names are literals; args is a list of the command's words
    // (C strings) and a null (exec_words), alive until exec replaces the
    // process; its first word is the program as this one was run.
    unsafe {
        setenv(c"VOLE_QUERY_STD", c"1", 1);
        execvp(words[0 as usize] as *mut u8, args.as_ptr() as *mut *mut u8);
    }
}

// The `use` line that brings std's item `name` (a top-level name of std)
// into a program: empty for a name of the prelude.
pub fn std_use_line(out: i64, name: &[u8], pcx: &mut Ctx<Comp>) {
    if is_prelude_name(intern(name, pcx), pcx) {
        return;
    }
    crate::base::buf_bytes(out, b"use std::");
    crate::base::buf_bytes(out, name);
    crate::base::buf_bytes(out, b";");
}

// Whether module m is std (0.20: or one of its modules; `use std::NAME;`
// names their items too).
pub fn is_std_module(m: i64, pcx: &Ctx<Comp>) -> bool {
    crate::front::modules::within_std(m, pcx)
}

// For definition d of std: `// use std::NAME;\n`, the line a program
// needs to name it (its type's, for a method); nothing for the prelude
// and for what is not std's.
pub fn put_std_use(out: i64, d: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    if !is_std_module(pcx.defs[d as usize].module, pcx) {
        return;
    }
    // (an intrinsic's `use` line is its notes', put_intrinsic_notes)
    if crate::tools::query::features::def_intrinsic(d, tcx, pcx) >= 0 {
        return;
    }
    let k = pcx.defs[d as usize].kind;
    let mut name = sym_text(pcx.defs[d as usize].name, pcx);
    if k == K_METHOD && pcx.defs[d as usize].owner >= 0 {
        name = last_segment(sym_text(pcx.defs[d as usize].owner, pcx));
    } else if pcx.defs[d as usize].parent >= 0 || k == K_IMPL_METHOD || k == K_METHOD {
        return;
    }
    // (0.25.2.2: `use std::NAME;` only when std::NAME is this item, else
    // its path: `// use std::Surface;` did not compile, std::gpu::Surface)
    let path = if k == K_METHOD { sym_text(pcx.defs[d as usize].owner, pcx) }
        else { sym_text(pcx.defs[d as usize].fqn, pcx) };
    let key = crate::front::modules::lookup::std_item_key(intern(name, pcx), pcx);
    let line = buf_new();
    if key >= 0 && sym_text(key, pcx) == path {
        std_use_line(line, name, pcx);
    } else if !is_prelude_name(intern(name, pcx), pcx) {
        buf_bytes(line, b"use ");
        buf_bytes(line, path);
        buf_bytes(line, b";");
    }
    if (buf_len(line) as usize) > 0 {
        buf_bytes(out, b"// ");
        buf_append(out, line);
        buf_bytes(out, b"\n");
    }
}
