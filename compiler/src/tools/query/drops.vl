// `volec query drops FILE:LINE` (0.26.1, docs/design/places-ir.md §8 step
// 9): the elaborated drops of the function at that line, as the places IR
// decides them. The first line is the function; then a line per drop, in
// the order of its body: where it runs (a block's `}`, the end of a
// statement, a `return` or `break`), the drop and its decision (kept,
// removed, under a flag, opened into its parts), and what it drops (the
// local's name, or a temporary and where it was made) with its type.
//
// The program is checked with its bodies kept (places/keep.vl), so the
// function's body is the one a code generator reads.

use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::buf_type;
use crate::places::front::{ast_local_name, fn_node};
use crate::places::ir::{Body, LF_FLAG, LF_TEMP, SK_DROP, body_new, full_place_type, has_flag};
use crate::places::keep::{has_kept, load_body};
use crate::places::print::{buf_drop, buf_fn_name, buf_pos, drop_pos};
use crate::tools::ctx::Tcx;
use crate::tools::query::{parse_digits, trailing_number};
use crate::tools::query::diagnostics::{diag, try_begin, try_end};
use crate::tools::query::positions::{line_end, line_index};
use crate::tools::query::refs::file_text;
use crate::tools::query::typeat::file_named;

// Called before the program is loaded: its bodies are kept.
pub fn drops_wanted(pcx: &mut Ctx<Comp>) {
    pcx.keep_bodies = true;
}

pub fn query_drops(arg: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut pbody = body_new();
    let mut line: i64 = -1;
    let mut file = &arg[0..0];
    let a = trailing_number(arg);
    if a > 0 && arg[(a - 1) as usize] == b':' {
        line = parse_digits(&arg[a as usize..]);
        file = &arg[0..(a - 1) as usize];
        // (FILE:LINE:COL: the column is not needed)
        let b = trailing_number(file);
        if b > 0 && file[(b - 1) as usize] == b':' {
            line = parse_digits(&file[b as usize..]);
            file = &file[0..(b - 1) as usize];
        }
    }
    if line < 1 {
        let d = diag(c"error", c"query.usage", tcx);
        buf_str(d, c"drops needs a line, FILE:LINE (not '");
        buf_bytes(d, arg);
        buf_str(d, c"')\n");
        return 2;
    }
    let g = file_named(file, pcx);
    if g < 0 {
        let d = diag(c"error", c"query.no-match", tcx);
        buf_str(d, c"no file '");
        buf_bytes(d, file);
        buf_str(d, c"' in the program\n");
        return 1;
    }
    let idx = line_index(pcx.files[g as usize].start, pcx) + line - 1;
    if idx >= pcx.lines.len() as i64 || line_at(idx, pcx) >= pcx.files[g as usize].end {
        let d = diag(c"error", c"query.no-match", tcx);
        buf_bytes(d, file_text(g, pcx));
        buf_str(d, c" has no line ");
        buf_int(d, line);
        buf_byte(d, b'\n');
        return 1;
    }
    let pos = line_at(idx, pcx);
    let f = body_at(pos, line_end(pos, pcx), pcx);
    if f < 0 {
        let d = diag(c"error", c"query.no-match", tcx);
        buf_bytes(d, arg);
        buf_str(d, c" is in no function with a body in the places IR (a generic one never instantiated, C's, or one with errors)\n");
        try_end(try_begin(c"show", arg, true, tcx, pcx));
        return 1;
    }
    load_body(f, &mut pbody, pcx);
    let out = buf_new();
    buf_bytes(out, file_text(g, pcx));
    buf_byte(out, b':');
    buf_int(out, line);
    buf_str(out, c" in ");
    buf_fn_name(out, f, pcx);
    buf_byte(out, b'\n');
    // (by where they run, then in the body's order)
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    for s in 0..pbody.stmts.len() as i64 {
        if pbody.stmts[s as usize].kind == SK_DROP {
            order.push(s);
        }
    }
    for i in 1..order.len() as i64 {
        let mut j = i;
        while j > 0
            && at_of(order[(j - 1) as usize], &pbody, pcx) > at_of(order[j as usize], &pbody, pcx) {
            order.swap((j - 1) as usize, j as usize);
            j -= 1;
        }
    }
    let n = order.len();
    for s in order.iter().copied() {
        let st = pbody.stmts[s as usize];
        buf_str(out, c"  ");
        if st.node > 0 {
            buf_line_col(out, drop_pos(st.node, pcx), pcx);
        } else {
            buf_str(out, c"-");
        }
        buf_str(out, c"  ");
        buf_drop(out, s, &pbody, pcx);
        buf_str(out, c"  ");
        buf_what(out, st.a, &pbody, pcx);
        buf_str(out, c": ");
        buf_type(out, full_place_type(st.a, st.b, &pbody, pcx), pcx);
        buf_byte(out, b'\n');
    }
    if n == 0 {
        buf_str(out, c"  (no drops: nothing it holds needs one)\n");
    }
    buf_write_fd(out, STDOUT);
    0
}

// Where drop statement s runs (-1: unknown).
fn at_of(s: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let node = pbody.stmts[s as usize].node;
    if node > 0 { drop_pos(node, pcx) } else { -1 }
}

// The start of line idx (LINES).
fn line_at(idx: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.lines.get(idx)
}

// The innermost function with a kept body whose text holds the line
// [start, end): a closure inside its parent, the first instance of a
// generic one; -1.
fn body_at(start: i64, end: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut best: i64 = -1;
    let mut size: i64 = 0;
    for f in 0..pcx.fns.len() as i64 {
        if !has_kept(f, pcx) {
            continue;
        }
        let item = fn_node(f, pcx);
        let s = pcx.nodes[item as usize].start;
        let e = pcx.nodes[item as usize].end;
        if s < end && start < e && (best < 0 || e - s < size) {
            best = f;
            size = e - s;
        }
    }
    best
}

// `LINE:COL` of pos (buf_pos without its file).
fn buf_line_col(out: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_pos(b, pos, pcx);
    let text = buf_slice(b);
    // (FILE:LINE:COL: from the second colon from the end)
    let mut i = text.len() as i64;
    let mut colons: i64 = 0;
    while i > 0 {
        i -= 1;
        if text[i as usize] == b':' {
            colons += 1;
            if colons == 2 {
                buf_bytes(out, &text[(i + 1) as usize..]);
                return;
            }
        }
    }
    buf_bytes(out, text);
}

// What local l is: its name, a temporary and where it was made, a flag.
fn buf_what(out: i64, l: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let src = pbody.locals[l as usize].src;
    if has_flag(l, LF_TEMP, pbody) || src < 0 {
        buf_str(out, if has_flag(l, LF_FLAG, pbody) { c"a flag" } else { c"a temporary" });
        let node = pbody.locals[l as usize].node;
        if node > 0 {
            buf_str(out, c" (");
            buf_line_col(out, pcx.nodes[node as usize].start, pcx);
            buf_str(out, c")");
        }
        return;
    }
    buf_bytes(out, sym_text(ast_local_name(src, pcx), pcx));
}
