// The spellings of a NAME, FILE or MODULE that the tools print, as the
// lookups take them (0.15): what one command prints, another accepts.
//
// - `main.vl:12:5:` (a short diagnostic's position, its colon) and
//   `main.vl:12-30` (a `show` header's lines) are `main.vl:12`;
// - `./main.vl`, `/abs/path/main.vl`: matched to the program's file
//   by whole components (path_matches);
// - `Vec<i64>::push`, `Vec::<i64>::new`, `twice<V2>`: the generic
//   arguments of an instance dropped;
// - `main.0`, `main.0.1` (a closure's symbol: closure k of the function
//   with symbol S is `S.k`): the function;
// - `a::mod`, `crate::a::mod`: the module `a`; `f()`: `f`.

use crate::base::{IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_bufs, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::ctx::Tcx;
use crate::tools::query::def_at_line;
use crate::tools::query::diagnostics::diag;
use crate::tools::query::positions::{line_end, line_index, line_of};
use crate::tools::query::show::{find_modules, query_items};

fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

fn is_name_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || is_digit(c) || c == b'_'
}

// NAME as the lookups take it (see the header); a FILE or a pattern is
// left as it is but for its end.
pub fn canonical_name(name0: &[u8]) -> &[u8] {
    let mut name = name0;
    // (blanks, and the `:` or `,` after a position or a name)
    while name.len() > 0
        && (name[(name.len() as i64 - 1) as usize] == b':'
            || name[(name.len() as i64 - 1) as usize] == b','
            || name[(name.len() as i64 - 1) as usize] == b' '
            || name[(name.len() as i64 - 1) as usize] == b'\t') {
        name = &name[0..(name.len() as i64 - 1) as usize];
    }
    while name.len() > 0 && (name[0] == b' ' || name[0] == b'\t') {
        name = &name[1..name.len()];
    }
    while name.len() > 2 && name[0] == b'.' && name[1] == b'/' {
        name = &name[2..name.len()];
    }
    if name.len() > 2 && name[(name.len() as i64 - 2) as usize] == b'('
        && name[(name.len() as i64 - 1) as usize] == b')' {
        name = &name[0..(name.len() as i64 - 2) as usize];
    }
    // A symbol of the generated code (`_vole.std.Buf.new`, an
    // instance's `vole.apply.GN6main.0`): the path of its function.
    let sym = symbol_path(name);
    if sym.len() > 0 {
        return sym;
    }
    // FILE:A-B: FILE:A.
    let i = digits_before(name, name.len() as i64);
    if i < name.len() as i64 && i >= 2 && name[(i - 1) as usize] == b'-' {
        let j = digits_before(name, i - 1);
        if j < i - 1 && j >= 2 && name[(j - 1) as usize] == b':' && name[(j - 2) as usize] != b':' {
            name = &name[0..(i - 1) as usize];
        }
    }
    // A closure's symbol (`main.0.1`): its function. (A file has `.vl`.)
    loop {
        let k = digits_before(name, name.len() as i64);
        if k < name.len() as i64 && k >= 2 && name[(k - 1) as usize] == b'.'
            && is_name_byte(name[(k - 2) as usize]) {
            name = &name[0..(k - 1) as usize];
        } else {
            break;
        }
    }
    // `a::mod`: the module a.
    if name.len() > 5 && name[(name.len() as i64 - 5) as usize..] == b"::mod" {
        name = &name[0..(name.len() as i64 - 5) as usize];
    }
    // Generic arguments (not a leading `<Type as Trait>`).
    let mut any = false;
    for k in 1..name.len() as i64 {
        if name[k as usize] == b'<'
            && (is_name_byte(name[(k - 1) as usize]) || name[(k - 1) as usize] == b':') {
            any = true;
        }
    }
    if !any {
        return name;
    }
    let out = buf_new();
    let mut k: i64 = 0;
    while k < name.len() as i64 {
        let c = name[k as usize];
        if k > 0 && c == b'<'
            && (is_name_byte(name[(k - 1) as usize]) || name[(k - 1) as usize] == b':') {
            let mut depth: i64 = 0;
            let mut e = k;
            while e < name.len() as i64 {
                if name[e as usize] == b'<' {
                    depth += 1;
                } else if name[e as usize] == b'>' {
                    depth -= 1;
                    if depth == 0 {
                        break;
                    }
                }
                e += 1;
            }
            // (`Vec::<i64>::new`: the `::` before the arguments goes too)
            let b = buf_slice(out);
            if b.len() >= 2 && b[(b.len() as i64 - 1) as usize] == b':'
                && b[(b.len() as i64 - 2) as usize] == b':' {
                unsafe {
                    (*get_bufs().add(out as usize)).len -= 2;
                }
            }
            k = e + 1;
            continue;
        }
        buf_byte(out, c);
        k += 1;
    }
    buf_slice(out)
}

// A symbol of the generated code as a path (gen0's function_prefix and
// static_prefix, generic_symbol's `.G` and a closure's `.k` dropped, `.`
// as `::`); empty when name is no such symbol.
fn symbol_path(name: &[u8]) -> &[u8] {
    let mut s = name;
    // (the prefix's own length: 0.24 renames it, tools/rename-vole.sh)
    let pre = "vole.";
    if s.len() > 1 && s[0] == b'_' && s[1] == pre[0] {
        s = &s[1..s.len()];
    }
    if s.len() <= pre.len() || &s[0..pre.len()] != pre.as_bytes() {
        return &name[0..0];
    }
    s = &s[pre.len()..s.len()];
    if s.len() > 7 && s[0..7] == b"static." {
        s = &s[7..s.len()];
    }
    let out = buf_new();
    let mut k: i64 = 0;
    // (an impl's functions on a type that is no struct: `Tl.cmp` is
    // `i64::cmp`, `TSh.eq` is `[u8]::eq`)
    if s.len() > 1 && s[0] == b'T' {
        let mut at: i64 = 1;
        if demangle_type(s, &mut at, out) && at < s.len() as i64 && s[at as usize] == b'.' {
            k = at;
        } else {
            unsafe {
                (*get_bufs().add(out as usize)).len = 0;
            }
        }
    }
    while k < s.len() as i64 {
        if s[k as usize] == b'.' {
            // (an instance's arguments, a closure's number: the end)
            if k + 1 < s.len() as i64
                && (s[(k + 1) as usize] == b'G' || is_digit(s[(k + 1) as usize])) {
                break;
            }
            // (0.28.0: `.n1`, the suffix of a second function of the same
            // path, as std2's `Formatter.write_str.n1`: the end too)
            if k + 2 < s.len() as i64 && s[(k + 1) as usize] == b'n'
                && is_digit(s[(k + 2) as usize]) {
                break;
            }
            buf_byte(out, b':');
            buf_byte(out, b':');
        } else if s[k as usize] == b'$' && s.len() as i64 - k >= 5
            && &s[k as usize..(k + 5) as usize] == b"$body" {
            // (0.28.0: the body of a function with clauses, `push$body`:
            // the function; then an instance's arguments, or the end)
            break;
        } else {
            buf_byte(out, s[k as usize]);
        }
        k += 1;
    }
    buf_slice(out)
}

// Whether name is a symbol of the generated code (symbol_path).
pub fn is_symbol(name: &[u8]) -> bool {
    symbol_path(name).len() > 0
}

// The type of mangle_type's code at s[*at..] (primitives, pointers,
// slices, structs and enums), written to out; false for another code.
fn demangle_type(s: &[u8], at: &mut i64, out: i64) -> bool {
    let k = *at;
    if k >= s.len() as i64 {
        return false;
    }
    *at = k + 1;
    let c = s[k as usize];
    if c == b'P' || c == b'R' || c == b'M' {
        buf_bytes(out, if c == b'P' { b"*" } else if c == b'R' { b"&" } else { b"&mut " });
        return demangle_type(s, at, out);
    }
    if c == b'S' || c == b'W' {
        if c == b'W' {
            buf_bytes(out, b"&mut ");
        }
        buf_byte(out, b'[');
        let ok = demangle_type(s, at, out);
        buf_byte(out, b']');
        return ok;
    }
    if c == b'N' {
        let mut n: i64 = 0;
        let mut e = k + 1;
        while e < s.len() as i64 && is_digit(s[e as usize]) {
            n = n * 10 + (s[e as usize] - b'0') as i64;
            e += 1;
        }
        if e == k + 1 || e + n > s.len() as i64 {
            return false;
        }
        buf_bytes(out, &s[e as usize..(e + n) as usize]);
        *at = e + n;
        return true;
    }
    // (0.28.0: the unsized place of a view, `Z<v>`: str as `ZD3str0_`)
    if c == b'Z' {
        return demangle_type(s, at, out);
    }
    // (0.28.0: a distinct type, `D<length><symbol><count>_<arguments>`: its
    // symbol; std2's str and char are such)
    if c == b'D' {
        let mut n: i64 = 0;
        let mut e = k + 1;
        while e < s.len() as i64 && is_digit(s[e as usize]) {
            n = n * 10 + (s[e as usize] - b'0') as i64;
            e += 1;
        }
        if e == k + 1 || e + n > s.len() as i64 {
            return false;
        }
        buf_bytes(out, &s[e as usize..(e + n) as usize]);
        e += n;
        let mut count: i64 = 0;
        let digits = e;
        while e < s.len() as i64 && is_digit(s[e as usize]) {
            count = count * 10 + (s[e as usize] - b'0') as i64;
            e += 1;
        }
        if e == digits || e >= s.len() as i64 || s[e as usize] != b'_' {
            return false;
        }
        *at = e + 1;
        let scratch = buf_new();
        for _ in 0..count {
            if !demangle_type(s, at, scratch) {
                return false;
            }
        }
        return true;
    }
    // (0.26.2: usize y, isize x)
    let codes = "asilhtjmfdbyx";
    let types = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool",
        "usize", "isize"];
    for i in 0..codes.len() {
        if codes[i] == c {
            buf_bytes(out, types[i].as_bytes());
            return true;
        }
    }
    false
}

// The start of the run of digits that ends s[0..end] (end: none).
fn digits_before(s: &[u8], end: i64) -> i64 {
    let mut i = end;
    while i > 0 && is_digit(s[(i - 1) as usize]) {
        i -= 1;
    }
    i
}

// Whether the program's file p is the file x names: the same path, or one
// ends with the other by whole components (`gvn.vl`, `./main.vl`,
// `/home/me/prog/main.vl` for `main.vl`).
pub fn path_matches(p: &[u8], x0: &[u8]) -> bool {
    let mut x = x0;
    while x.len() > 2 && x[0] == b'.' && x[1] == b'/' {
        x = &x[2..x.len()];
    }
    if x.len() == 0 || p.len() == 0 {
        return false;
    }
    if p == x {
        return true;
    }
    // (std's source, `<std>`: `std`, or its file in the compiler's tree)
    if p == b"<std>" && (x == b"std" || x == b"std.vl" || x == b"compiler/std/std.vl") {
        return true;
    }
    if p.len() > x.len() {
        return p[(p.len() as i64 - x.len() as i64 - 1) as usize] == b'/'
            && p[(p.len() as i64 - x.len() as i64) as usize..] == x;
    }
    x.len() > p.len() && p[0] != b'<' && x[(x.len() as i64 - p.len() as i64 - 1) as usize] == b'/'
        && x[(x.len() as i64 - p.len() as i64) as usize..] == p
}

pub fn is_name_char(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// (0.15) The item that starts below line `line` of file f, when that line
// is a comment or an attribute, and the ones down to the item are too or
// blank (a `show` header's first line is its comment's); -1 otherwise.
pub fn item_below(f: i64, line: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let first = line_index(pcx.files[f as usize].start, pcx);
        let mut l = line;
        while l >= 1 && first + l - 1 < pcx.lines.len() as i64
            && (pcx.lines[(first + l - 1) as usize]) < pcx.files[f as usize].end {
            let mut p = (pcx.lines[(first + l - 1) as usize]);
            let end = line_end(p, pcx);
            while p < end && (get_src()[p as usize] == b' ' || get_src()[p as usize] == b'\t') {
                p += 1;
            }
            let blank = p >= end;
            let comment = p + 1 < end
                && ((get_src()[p as usize] == b'/' && get_src()[(p + 1) as usize] == b'/')
                    || (get_src()[p as usize] == b'#' && get_src()[(p + 1) as usize] == b'['));
            if blank && l == line {
                return -1;
            }
            if !blank && !comment {
                let d = def_at_line(f, l, pcx);
                return if d >= 0 && line_of(pcx.defs[d as usize].start, pcx) == l { d } else { -1 };
            }
            l += 1;
        }
        -1
    }
}

// (0.15) NAME as a module (`crate`, `a::b`): the definitions of its `mod`
// items, into out; for the root, which has none, a note and its items.
pub fn module_def(name: &[u8], out: &mut IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut modules = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        find_modules(name, true, &mut modules, tcx, pcx);
        if modules.len() as i64 == 0 {
            return false;
        }
        let mut root = false;
        for i in 0..modules.len() as i64 {
            let m = (modules[i as usize]);
            if m < pcx.mod_def.len() as i64 && (pcx.mod_def[m as usize]) >= 0 {
                out.push((pcx.mod_def[m as usize]));
            } else {
                root = true;
            }
        }
        if out.len() as i64 > 0 {
            return true;
        }
        if root {
            let d = diag(c"note", c"query.module", tcx);
            buf_byte(d, b'\'');
            buf_bytes(d, name);
            buf_str(d, c"' is a module without a `mod` item (the root, or std); its items:\n");
            query_items(modules, tcx, pcx);
        }
        root
    }
}
