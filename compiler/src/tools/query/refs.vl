// `query refs` and `query callers`: the references the checker resolved to
// the definitions asked about (the TARGETS, a trait function with its
// impls), collected from the checked nodes and the NOTES, kept to `--in
// FILE|MODULE`, and printed by file, cut to a summary past REFS_BUDGET.

use crate::base::{
    IntVec, SRC, STDOUT, alloc_array, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd,
    streq, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::modules::{file_of_pos, module_at, module_count};
use crate::front::types::{TYPES, TyKind};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::query::{
    QF_CALL, QF_DEF, QF_INIT, QF_PAT, QF_USE, QF_WRITE, def_at_line, parse_digits, trailing_number,
};
use crate::tools::query::cache::cached_refs;
use crate::tools::query::defs::{
    K_ALIAS, K_ENUM, K_IMPL_METHOD, K_MOD, K_STRUCT, K_TRAIT, K_TRAIT_FN, bytes_eq, def_of_node,
    find_defs, find_in, is_alias_name, mod_fqn, trait_of,
};
use crate::tools::query::derived::in_derive;
use crate::tools::query::diagnostics::{diag, put_cword, put_word, try_begin, try_end};
use crate::tools::query::names::{canonical_name, path_matches};
use crate::tools::query::positions::{
    enclosing, find_name, is_space, line_end, line_of, line_start, rank_of, sort_by_keys, token_at,
};
use crate::tools::query::show::{find_modules, text_start};

// ---- References ----

pub fn set_targets(matches: IntVec, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        for i in 0..matches.count {
            let d = matches.data[i];
            tcx.refs_targets.push(d);
            tcx.refs_group.put(d + 1, i + 1);
        }
        for i in 0..matches.count {
            let t = matches.data[i];
            if pcx.defs[t].kind != K_TRAIT_FN {
                continue;
            }
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d].kind == K_IMPL_METHOD && pcx.defs[d].name == pcx.defs[t].name
                    && tcx.refs_group.get(d + 1) == 0
                    && trait_of(d, tcx, pcx) == pcx.defs[t].parent {
                    tcx.refs_group.put(d + 1, i + 1);
                }
            }
        }
    }
}

// A reference to the item of node `def` (or a copy of it), its name
// looked for in from..to (first or last occurrence; at `at` when it is
// not there).
fn add_ref(def: i64, from: i64, to: i64, name: i64, last: bool, at: i64, flags: i64,
    tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let d = def_of_node(def, tcx, pcx);
    if d < 0 {
        return;
    }
    let g = tcx.refs_group.get(d + 1) - 1;
    if g < 0 {
        return;
    }
    var pos = at;
    if name >= 0 {
        let p = find_name(from, to, name, last, pcx);
        if p >= 0 {
            pos = p;
        }
    }
    // (0.15: what a #[derive] makes uses the type, its fields and std:
    // not references of the program; the traits it names are)
    if in_derive(pos, tcx) && pcx.defs[d].kind != K_TRAIT {
        return;
    }
    tcx.r_pos.push(pos);
    tcx.r_def.push(d);
    tcx.r_group.push(g);
    tcx.r_flags.push(flags);
}

// Whether the token at pos is followed by `::` (a path, not a bare name).
fn path_at(pos: i64, pcx: Ctx<Comp>) -> bool {
    let i = token_at(pos, pcx);
    i + 1 < pcx.toks.len() as i64 && pcx.toks[i].start == pos
        && pcx.toks[i + 1].kind == Tok::ColonColon
}

// A reference written as an identifier or a path (node n).
fn add_name_ref(def: i64, n: i64, flags: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let d = def_of_node(def, tcx, pcx);
    if d < 0 {
        return;
    }
    if path_at(pcx.nodes[n].start, pcx) {
        add_ref(def, pcx.nodes[n].start, pcx.nodes[n].end, pcx.defs[d].name, true,
            pcx.nodes[n].start, flags, &tcx, pcx);
    } else {
        add_ref(def, pcx.nodes[n].start, pcx.nodes[n].end, -1, false, pcx.nodes[n].start, flags,
            &tcx, pcx);
    }
}

// (0.17) The string constant (`const S: [u8] = "..."`, `const C: *u8 =
// c"..."`) whose use node n is: the checker replaced the name by the
// literal (synth_name), so the node is a Str or CStr written as a name or
// a path. -1 when n is a literal.
fn string_const_at(n: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let s = pcx.nodes[n].start;
        let e = pcx.nodes[n].end;
        if e <= s || SRC[s] == '"' || (SRC[s] == 'c' && s + 1 < e && SRC[s + 1] == '"')
            || !(SRC[s] == '_' || (SRC[s] >= 'a' && SRC[s] <= 'z')
                || (SRC[s] >= 'A' && SRC[s] <= 'Z')) {
            return -1;
        }
        var from = s;
        for i in s + 1..e {
            if SRC[i - 1] == ':' && SRC[i] == ':' {
                from = i + 1;
            }
        }
        let name = SRC[from..e];
        for c in 0..pcx.const_count {
            let node = pcx.consts[c].node;
            let init = pcx.nodes[node].c;
            if init > 0 && pcx.nodes[init].kind == pcx.nodes[n].kind
                && pcx.nodes[init].a == pcx.nodes[n].a
                && bytes_eq(sym_text(pcx.nodes[node].a), name) {
                return c;
            }
        }
        -1
    }
}

// The struct item of struct type t (through a pointer), or 0.
fn struct_node(t0: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if t0 <= 0 {
            return 0;
        }
        let t = if TYPES[t0].kind == TyKind::Ptr { TYPES[t0].a } else { t0 };
        // (0.14: a closure's environment is no item)
        if t <= 0 || TYPES[t].kind != TyKind::Struct || pcx.structs[TYPES[t].a].closure != 0 {
            return 0;
        }
        pcx.structs[TYPES[t].a].node
    }
}

// The field of struct item s at index i, if it is named `name`; or 0.
fn field_node(s: i64, i: i64, name: i64, pcx: Ctx<Comp>) -> i64 {
    if s == 0 || i < 0 || i >= pcx.nodes[s].count || pcx.nodes[child(s, i, pcx)].a != name {
        return 0;
    }
    child(s, i, pcx)
}

// The places assignments write (0.13): each target, and the fields,
// indexings and statics it is made of up to a dereference (`A.b[i].c =
// x` writes A, b and c), as node + 1 in out.
fn written_places(out: inout HMap, pcx: Ctx<Comp>) {
    for n in 1..pcx.nodes.len() {
        if pcx.nodes[n].kind != NodeKind::Assign {
            continue;
        }
        var t = pcx.nodes[n].b;
        while t > 0 {
            let k = pcx.nodes[t].kind;
            out.put(t + 1, 1);
            if k == NodeKind::FieldAccess || k == NodeKind::Index || k == NodeKind::TupleField {
                t = pcx.nodes[t].a;
            } else {
                break;
            }
        }
    }
}

// The kind of reference r (0.13): def, use (an import), call, init (a
// struct literal, a constructed variant), write (an assignment's target),
// pat (a pattern), mod (a module path), type (a type, a trait), or read.
pub fn ref_kind(r: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> *u8 {
    unsafe {
        let fl = tcx.r_flags.data[r];
        if (fl & QF_DEF) != 0 {
            return c"def";
        }
        if (fl & QF_USE) != 0 {
            return c"use";
        }
        if (fl & QF_CALL) != 0 {
            return c"call";
        }
        if (fl & QF_INIT) != 0 {
            return c"init";
        }
        if (fl & QF_WRITE) != 0 {
            return c"write";
        }
        if (fl & QF_PAT) != 0 {
            return c"pat";
        }
        let k = pcx.defs[tcx.r_def.data[r]].kind;
        if k == K_MOD {
            return c"mod";
        }
        if k == K_STRUCT || k == K_ENUM || k == K_TRAIT || k == K_ALIAS {
            return c"type";
        }
        c"read"
    }
}

// Whether kind k is in the comma-separated list.
pub fn kind_listed(k: *u8, list: *u8) -> bool {
    unsafe {
        let n = strlen(k) as i64;
        var i = 0;
        while list[i] != 0 {
            var j = i;
            while list[j] != 0 && list[j] != ',' {
                j += 1;
            }
            if j - i == n {
                var same = true;
                for x in 0..n {
                    if list[i + x] != k[x] {
                        same = false;
                    }
                }
                if same {
                    return true;
                }
            }
            i = if list[j] == ',' { j + 1 } else { j };
        }
        false
    }
}

// The references the checked nodes record, and the ones the hooks noted.
pub fn collect_refs(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        if tcx.restored {
            cached_refs(&tcx, pcx);
            return;
        }
        var written = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        written_places(&written, pcx);
        for n in 1..pcx.nodes.len() as i64 {
            let kind = pcx.nodes[n].kind;
            let w = if written.get(n + 1) != 0 { QF_WRITE } else { 0 };
            if kind == NodeKind::Ident {
                let y = pcx.nodes[n].y;
                let res = pcx.nodes[n].res;
                if res == Res::Fn {
                    add_name_ref(pcx.fns[y].node, n, 0, &tcx, pcx);
                } else if res == Res::Const {
                    add_name_ref(pcx.consts[y].node, n, 0, &tcx, pcx);
                } else if res == Res::Static {
                    add_name_ref(pcx.statics[y].node, n, w, &tcx, pcx);
                }
            } else if kind == NodeKind::Call {
                if pcx.nodes[n].x <= 0 {
                    continue;
                }
                let f = pcx.nodes[n].x - 1;
                let callee = pcx.nodes[n].a;
                let def = pcx.fns[f].node;
                if callee != 0 {
                    add_name_ref(def, callee, QF_CALL, &tcx, pcx);
                } else if pcx.nodes[n].count > 0 {
                    // A method call: its name after the receiver (an
                    // operator's call: at the operation).
                    let recv = child(n, 0, pcx);
                    add_ref(def, pcx.nodes[recv].end, pcx.nodes[n].end, pcx.nodes[def].a, false,
                        pcx.nodes[n].start, QF_CALL, &tcx, pcx);
                }
            } else if kind == NodeKind::FieldAccess {
                if pcx.nodes[n].y == 2 {
                    continue;
                }
                let s = struct_node(pcx.nodes[pcx.nodes[n].a].ty, pcx);
                let field = field_node(s, pcx.nodes[n].x, pcx.nodes[n].b, pcx);
                if field != 0 {
                    add_ref(field, pcx.nodes[pcx.nodes[n].a].end, pcx.nodes[n].end, pcx.nodes[n].b,
                        false, pcx.nodes[n].start, w, &tcx, pcx);
                }
            } else if kind == NodeKind::StructLit {
                let s = struct_node(pcx.nodes[n].ty, pcx);
                if s == 0 {
                    continue;
                }
                if pcx.nodes[n].a == pcx.nodes[s].a || pcx.nodes[n].a == pcx.self_type_sym
                    || is_alias_name(pcx.nodes[n].a, tcx) {
                    add_ref(s, pcx.nodes[n].start, pcx.nodes[n].end, pcx.nodes[n].a, false,
                        pcx.nodes[n].start, QF_INIT, &tcx, pcx);
                }
                for i in 0..pcx.nodes[n].count {
                    let init = child(n, i, pcx);
                    let field = field_node(s, pcx.nodes[init].x, pcx.nodes[init].a, pcx);
                    if field != 0 {
                        add_ref(field, pcx.nodes[init].start, -1, -1, false, pcx.nodes[init].start,
                            QF_INIT, &tcx, pcx);
                    }
                }
            } else if kind == NodeKind::Str || kind == NodeKind::CStr {
                let c = string_const_at(n, pcx);
                if c >= 0 {
                    add_name_ref(pcx.consts[c].node, n, 0, &tcx, pcx);
                }
            } else if kind == NodeKind::VariantLit {
                let v = pcx.nodes[n].a;
                add_ref(pcx.variants[v].node, pcx.nodes[n].start, pcx.nodes[n].end,
                    pcx.variants[v].name, false, pcx.nodes[n].start, QF_INIT, &tcx, pcx);
            } else if kind == NodeKind::PatVariant {
                let v = pcx.nodes[n].x;
                if pcx.nodes[n].ty != 0 && v >= 0 && pcx.variants[v].name == pcx.nodes[n].b {
                    add_ref(pcx.variants[v].node, pcx.nodes[n].start, pcx.nodes[n].end,
                        pcx.nodes[n].b, false, pcx.nodes[n].start, QF_PAT, &tcx, pcx);
                }
            }
        }
        // (0.26.2) The drops' calls: a function's drop edges (the places
        // IR's), each a call at the first value it drops of them
        for f in 0..pcx.fn_count {
            for e in 0..crate::places::drop_edge_count(f, pcx) {
                let at = crate::places::drop_edge_node(f, e, pcx);
                if at > 0 {
                    let pos = pcx.nodes[at].start;
                    add_ref(pcx.fns[crate::places::drop_edge(f, e, pcx)].node, pos, -1, -1, false,
                        pos, QF_CALL, &tcx, pcx);
                }
            }
        }
        // (0.15: a trait's `Self`, resolved to the type of an impl checked
        // against it, is no use of that type)
        var traits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for t in 1..pcx.nodes.len() {
            if pcx.nodes[t].kind == NodeKind::Trait {
                traits.push(pcx.nodes[t].start);
                traits.push(pcx.nodes[t].end);
            }
        }
        var i = 0;
        while i < pcx.notes.count {
            let at = pcx.notes.data[i];
            var in_trait = false;
            if pcx.notes.data[i + 1] == pcx.self_type_sym {
                var k = 0;
                while k < traits.count {
                    if at >= traits.data[k] && at < traits.data[k + 1] {
                        in_trait = true;
                    }
                    k += 2;
                }
            }
            if !in_trait {
                add_ref(pcx.notes.data[i + 2], at, -1, pcx.notes.data[i + 1], false, at,
                    pcx.notes.data[i + 3], &tcx, pcx);
            }
            i += 4;
        }
        // The definitions themselves.
        for d in 0..pcx.defs.len() as i64 {
            if tcx.refs_group.get(d + 1) != 0 {
                add_ref(pcx.defs[d].node, pcx.defs[d].name_pos, -1, -1, false, pcx.defs[d].name_pos,
                    QF_DEF, &tcx, pcx);
            }
        }
    }
}

// Every reference of the program, to every definition, for the tools'
// cache (0.13): (position, definition, flags) triples, into out. (After
// the answer: TARGETS and the references found for it are dropped.)
pub fn collect_all_refs(out: inout IntVec, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        tcx.refs_targets.count = 0;
        tcx.r_pos.count = 0;
        tcx.r_def.count = 0;
        tcx.r_group.count = 0;
        tcx.r_flags.count = 0;
        tcx.refs_group = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for d in 0..pcx.defs.len() as i64 {
            tcx.refs_group.put(d + 1, 1);
        }
        collect_refs(&tcx, pcx);
        for i in 0..tcx.r_pos.count {
            out.push(tcx.r_pos.data[i]);
            out.push(tcx.r_def.data[i]);
            out.push(tcx.r_flags.data[i]);
        }
    }
}

// (0.15) The definition a reference in from..to names (the first one, an
// import's path or a use outside every item: `query show FILE:LINE:COL`
// on a `use` line), or -1. The references found are dropped after.
pub fn def_used_at(from: i64, to: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        collect_all_refs(&all, &tcx, pcx);
        tcx.refs_targets.count = 0;
        tcx.r_pos.count = 0;
        tcx.r_def.count = 0;
        tcx.r_group.count = 0;
        tcx.r_flags.count = 0;
        tcx.refs_group = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        var best = -1;
        var best_pos = to;
        var i = 0;
        while i < all.count {
            let pos = all.data[i];
            if pos >= from && pos < best_pos && (all.data[i + 2] & QF_DEF) == 0 {
                best = all.data[i + 1];
                best_pos = pos;
            }
            i += 3;
        }
        best
    }
}

// The references in order (file, position, definition), each once: the
// indices into R_*, in `out`.
pub fn sorted_refs(out: inout IntVec, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let n = tcx.r_pos.count;
        let k1 = alloc_array::<i64>(n + 1);
        let k2 = alloc_array::<i64>(n + 1);
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..n {
            all.push(i);
            k1[i] = rank_of(tcx.r_pos.data[i], tcx, pcx) * 4294967296 + tcx.r_pos.data[i];
            k2[i] = tcx.r_def.data[i];
        }
        sort_by_keys(all, k1, k2);
        var i = 0;
        while i < all.count {
            let r = all.data[i];
            var j = i + 1;
            while j < all.count && tcx.r_pos.data[all.data[j]] == tcx.r_pos.data[r]
                && tcx.r_def.data[all.data[j]] == tcx.r_def.data[r] {
                tcx.r_flags.data[r] |= tcx.r_flags.data[all.data[j]];
                j += 1;
            }
            out.push(r);
            i = j;
        }
    }
}

// Source lines longer than this are cut (with `…`).
const LINE_MAX: i64 = 100;

// The line holding pos, trimmed (and cut to LINE_MAX bytes).
pub fn put_line(out: i64, pos: i64, pcx: Ctx<Comp>) {
    var a = line_start(pos, pcx);
    var b = line_end(pos, pcx);
    while a < b && is_space(SRC[a]) {
        a += 1;
    }
    while b > a && is_space(SRC[b - 1]) {
        b -= 1;
    }
    if b - a <= LINE_MAX {
        buf_bytes(out, SRC[a..b]);
        return;
    }
    // (not inside a UTF-8 sequence)
    var e = a + LINE_MAX - 1;
    while e > a && (SRC[e] & 192) == 128 {
        e -= 1;
    }
    buf_bytes(out, SRC[a..e]);
    buf_byte(out, 226 as u8);
    buf_byte(out, 128 as u8);
    buf_byte(out, 166 as u8);
}

// A path without its `crate::` prefixes (`gvn::run_gvn`,
// `<geom::V2 as Add>::add`); `crate` stays.
pub fn put_short(out: i64, sym: i64) {
    let p = sym_text(sym);
    var i = 0;
    while i < p.len as i64 {
        let start = i == 0 || p[i - 1] == '<' || p[i - 1] == ' ';
        if start && i + 7 <= p.len as i64 && p[i] == 'c' && p[i + 1] == 'r' && p[i + 2] == 'a'
            && p[i + 3] == 't'
            && p[i + 4] == 'e' && p[i + 5] == ':' && p[i + 6] == ':' {
            i += 7;
            continue;
        }
        buf_byte(out, p[i]);
        i += 1;
    }
}

// More references than this: refs and callers print a summary per file
// (unless --limit or --all).
pub const REFS_BUDGET: i64 = 60;

// The path of file f as printed.
pub fn file_text(f: i64, pcx: Ctx<Comp>) -> [u8] {
    unsafe {
        var p = pcx.files[f].path;
        while p[0] == '.' && p[1] == '/' {
            p = &p[2];
        }
        p[0..strlen(p) as i64]
    }
}

// Resolves --in X (0.17: called once per --in, the matches adding up): a
// file (X has a `/`, ends in `.vl` or is `<std>`; the path, or its end
// by whole components) or a module (matched like NAME, with its inline
// modules), or FILE:LINE (the item holding that line: ref_in; its file
// for the fixes by module), or an item (a function, type...: its text).
// Whether anything matched.
pub fn resolve_in(x0: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let x = canonical_name(x0);
        var any = false;
        while pcx.in_file.count < pcx.files.len() as i64 {
            pcx.in_file.push(0);
        }
        while pcx.in_module.count < module_count(pcx) {
            pcx.in_module.push(0);
        }
        // (FILE:LINE: the item holding that line; its file for what works by
        // file or module)
        let a = trailing_number(x);
        if a > 0 && x[a - 1] == ':' && (a < 2 || x[a - 2] != ':') {
            let file = x[0..a - 1];
            for f in 0..pcx.files.len() as i64 {
                let p = file_text(f, pcx);
                if path_matches(p, file) {
                    let d = def_at_line(f, parse_digits(x[a..]), pcx);
                    if d < 0 {
                        tcx.in_no_item = true;
                        return false;
                    }
                    in_item(d, &pcx);
                    return true;
                }
            }
            return false;
        }
        let is_file = x.len > 0
            && (x[0] == '<' || find_in(x, c"/", 0) >= 0 || find_in(x, c".vl", 0) >= 0
                || find_in(x, c".wgsl", 0) >= 0);
        if is_file {
            for f in 0..pcx.files.len() as i64 {
                let p = file_text(f, pcx);
                if path_matches(p, x) || dir_holds(p, x) {
                    pcx.in_file.data[f] = 1;
                    any = true;
                }
            }
            return any;
        }
        var modules = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_modules(x, false, &modules, &tcx, pcx);
        for i in 0..modules.count {
            pcx.in_module.data[modules.data[i]] = 1;
            any = true;
        }
        if any {
            return true;
        }
        // (0.17: an item: a function, a method, a type...)
        var found = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        find_defs(x, false, &found, tcx, pcx);
        for i in 0..found.count {
            let d = found.data[i];
            if pcx.defs[d].kind != K_MOD
                && pcx.files[file_of_pos(pcx.defs[d].start, pcx)].path[0] != '<' {
                in_item(d, &pcx);
                any = true;
            }
        }
        any
    }
}

// (0.17) Item d's text is in --in.
fn in_item(d: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.in_ranges.push(text_start(d, pcx));
        pcx.in_ranges.push(pcx.defs[d].end);
        let f = file_of_pos(pcx.defs[d].start, pcx);
        if pcx.in_file.data[f] == 0 {
            pcx.in_file.data[f] = 2;
        }
    }
}

// Whether directory x (whole components, a trailing `/` or not: `front`,
// `compiler/src/front/`) holds file p (0.13).
fn dir_holds(p: [u8], x0: [u8]) -> bool {
    var x = x0;
    while x.len > 0 && x[x.len as i64 - 1] == '/' {
        x = x[0..x.len as i64 - 1];
    }
    if x.len == 0 || x.len as i64 + 1 >= p.len as i64 {
        return false;
    }
    for i in 0..p.len as i64 - x.len as i64 {
        if (i == 0 || p[i - 1] == '/') && p[i + x.len as i64] == '/'
            && bytes_eq(p[i..i + x.len as i64], x) {
            return true;
        }
    }
    false
}

// The message of a --in that resolve_in did not resolve (after `diag`):
// no such file or module, or (FILE:LINE) no item at that line.
pub fn put_bad_in(d: i64, x: *u8, tcx: Tcx<Comp>) {
    if tcx.in_no_item {
        buf_str(d, c"no item at ");
        buf_str(d, x);
        buf_byte(d, '\n');
        return;
    }
    buf_str(d, c"no file, module or item '");
    buf_str(d, x);
    buf_str(d, c"' in the program\n");
}

// Whether the reference at pos passes --in.
pub fn ref_in(pos: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        if pcx.opt_in == 0 as *u8 {
            return true;
        }
        var k = 0;
        while k < pcx.in_ranges.count {
            if pos >= pcx.in_ranges.data[k] && pos < pcx.in_ranges.data[k + 1] {
                return true;
            }
            k += 2;
        }
        if pcx.in_file.data[file_of_pos(pos, pcx)] == 1 {
            return true;
        }
        var m = module_at(pos, &pcx);
        while m >= 0 {
            if pcx.in_module.data[m] != 0 {
                return true;
            }
            m = if m > 0 { pcx.modules[m].parent } else { -1 };
        }
        false
    }
}

// A `try:` line for refs/callers with one more option (and its value),
// keeping --in unless the option is another --in.
pub fn try_refs(cmd: *u8, name: [u8], option: *u8, value: [u8], tcx: inout Tcx<Comp>,
    pcx: Ctx<Comp>) {
    let out = try_begin(cmd, name, true, &tcx, pcx);
    if pcx.opt_in != 0 as *u8 && !streq(option, c"--in") {
        buf_str(out, c" --in");
        put_cword(out, pcx.opt_in);
    }
    buf_byte(out, ' ');
    buf_str(out, option);
    if value.len > 0 {
        put_word(out, value);
    }
    try_end(out);
}

pub fn query_refs(matches: IntVec, cmd: *u8, name: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let calls_only = streq(cmd, c"callers");
        set_targets(matches, &tcx, pcx);
        collect_refs(&tcx, pcx);
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        sorted_refs(&order, &tcx, pcx);
        var sel = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var multi = tcx.refs_targets.count > 1;
        for i in 0..order.count {
            let r = order.data[i];
            if calls_only && (tcx.r_flags.data[r] & QF_CALL) == 0 {
                continue;
            }
            if tcx.opt_kind != 0 as *u8 && !kind_listed(ref_kind(r, tcx, pcx), tcx.opt_kind) {
                continue;
            }
            if !ref_in(tcx.r_pos.data[r], &pcx) {
                continue;
            }
            sel.push(r);
            if tcx.r_def.data[r] != tcx.refs_targets.data[tcx.r_group.data[r]] {
                multi = true;
            }
        }
        let out = buf_new();
        let groups = tcx.refs_targets.count;
        if tcx.opt_count {
            if groups == 1 {
                buf_int(out, sel.count);
                buf_byte(out, '\n');
            } else {
                for g in 0..groups {
                    var n = 0;
                    for i in 0..sel.count {
                        if tcx.r_group.data[sel.data[i]] == g {
                            n += 1;
                        }
                    }
                    buf_int(out, n);
                    buf_byte(out, '\t');
                    buf_bytes(out, sym_text(pcx.defs[tcx.refs_targets.data[g]].fqn));
                    buf_byte(out, '\n');
                }
            }
            buf_write_fd(out, STDOUT);
            return 0;
        }
        let noun = if calls_only { c"calls" } else { c"refs" };
        let total = sel.count;
        if total == 0 {
            let d = diag(c"note", c"query.empty", &tcx);
            buf_str(d, c"0 ");
            buf_str(d, noun);
            if pcx.opt_in != 0 as *u8 {
                buf_str(d, c" in ");
                buf_str(d, pcx.opt_in);
            }
            buf_byte(d, '\n');
            return 0;
        }
        // Per file: the number of references (files in order).
        var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var per_file = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var biggest = -1;
        var biggest_n = 0;
        for i in 0..sel.count {
            let f = file_of_pos(tcx.r_pos.data[sel.data[i]], pcx);
            if files.count == 0 || files.data[files.count - 1] != f {
                files.push(f);
                per_file.push(0);
            }
            per_file.data[per_file.count - 1] += 1;
            if per_file.data[per_file.count - 1] > biggest_n {
                biggest_n = per_file.data[per_file.count - 1];
                biggest = f;
            }
        }
        if tcx.opt_limit < 0 && !tcx.opt_all && total > REFS_BUDGET {
            for i in 0..files.count {
                buf_bytes(out, file_text(files.data[i], pcx));
                buf_byte(out, '\t');
                buf_int(out, per_file.data[i]);
                buf_byte(out, '\n');
            }
            buf_write_fd(out, STDOUT);
            let d = diag(c"note", c"query.truncated", &tcx);
            buf_int(d, total);
            buf_byte(d, ' ');
            buf_str(d, noun);
            buf_str(d, c" in ");
            buf_int(d, files.count);
            buf_str(d, if files.count == 1 { c" file\n" } else { c" files\n" });
            if files.count > 1 {
                try_refs(cmd, name, c"--in", file_text(biggest, pcx), &tcx, pcx);
            }
            try_refs(cmd, name, c"--limit 60", file_text(biggest, pcx)[0..0], &tcx, pcx);
            try_refs(cmd, name, c"--all", file_text(biggest, pcx)[0..0], &tcx, pcx);
            return 0;
        }
        let shown = if tcx.opt_limit >= 0 && tcx.opt_limit < total { tcx.opt_limit } else { total };
        var cur = -1;
        for i in 0..shown {
            let r = sel.data[i];
            let pos = tcx.r_pos.data[r];
            let d = tcx.r_def.data[r];
            let f = file_of_pos(pos, pcx);
            if f != cur {
                buf_str(out, c"# ");
                buf_bytes(out, file_text(f, pcx));
                buf_byte(out, '\n');
                cur = f;
            }
            buf_int(out, line_of(pos, pcx));
            buf_byte(out, ':');
            buf_int(out, pos - line_start(pos, pcx) + 1);
            buf_byte(out, '\t');
            buf_str(out, ref_kind(r, tcx, pcx));
            if (tcx.r_flags.data[r] & QF_DEF) == 0 {
                buf_byte(out, '\t');
                let e = enclosing(pos, tcx, pcx);
                put_short(out,
                    if e >= 0 { pcx.defs[e].fqn }
                    else { mod_fqn(module_at(pos, &pcx), &tcx, pcx) });
            }
            if multi {
                buf_str(out, c"\t->");
                put_short(out, pcx.defs[d].fqn);
            }
            buf_byte(out, '\t');
            put_line(out, pos, pcx);
            buf_byte(out, '\n');
        }
        buf_write_fd(out, STDOUT);
        if shown < total {
            let d = diag(c"note", c"query.truncated", &tcx);
            buf_str(d, c"showing ");
            buf_int(d, shown);
            buf_str(d, c" of ");
            buf_int(d, total);
            buf_byte(d, ' ');
            buf_str(d, noun);
            buf_byte(d, '\n');
            if files.count > 1 {
                try_refs(cmd, name, c"--in", file_text(biggest, pcx), &tcx, pcx);
            }
            try_refs(cmd, name, c"--all", file_text(biggest, pcx)[0..0], &tcx, pcx);
        }
        0
    }
}
