// `query refs` and `query callers`: the references the checker resolved to
// the definitions asked about (the TARGETS, a trait function with its
// impls), collected from the checked nodes and the NOTES, kept to `--in
// FILE|MODULE`, and printed by file, cut to a summary past REFS_BUDGET.

use crate::base::{
    STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, c_bytes, get_src, streq,
    strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::check::Res;
use crate::front::lexer::Tok;
use crate::front::modules::{file_made, file_of_pos, module_at, module_count};
use crate::front::types::TyKind;
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::{Tcx, zeros};
use crate::tools::query::{
    QF_CALL, QF_DEF, QF_INIT, QF_PAT, QF_USE, QF_WRITE, def_at_line, parse_digits, trailing_number,
};
use crate::tools::query::cache::cached_refs;
use crate::tools::query::defs::{
    K_ALIAS, K_ENUM, K_IMPL_METHOD, K_MOD, K_STRUCT, K_TRAIT, K_TRAIT_FN, bytes_eq, def_of_node,
    find_defs, find_in, is_alias_name, mod_fqn, trait_of,
};
use crate::tools::query::derived::in_derive;
use crate::tools::query::diagnostics::{diag, put_cword, put_word, try_begin, try_end};
use crate::tools::query::names::{canonical_name, path_matches};
use crate::tools::query::positions::{
    enclosing, find_name, is_space, line_end, line_of, line_start, rank_of, sort_by_keys, token_at,
};
use crate::tools::query::show::{find_modules, text_start};

// ---- References ----

pub fn set_targets(matches: &[i64], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..matches.len() as i64 {
        let d = (matches[i as usize]);
        tcx.refs_targets.push(d);
        tcx.refs_group.put(d + 1, i + 1);
    }
    for i in 0..matches.len() as i64 {
        let t = (matches[i as usize]);
        if pcx.defs[t as usize].kind != K_TRAIT_FN {
            continue;
        }
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].kind == K_IMPL_METHOD
                && pcx.defs[d as usize].name == pcx.defs[t as usize].name
                && tcx.refs_group.get(d + 1) == 0
                && trait_of(d, tcx, pcx) == pcx.defs[t as usize].parent {
                tcx.refs_group.put(d + 1, i + 1);
            }
        }
    }
}

// A reference to the item of node `def` (or a copy of it), its name
// looked for in from..to (first or last occurrence; at `at` when it is
// not there).
fn add_ref(def: i64, from: i64, to: i64, name: i64, last: bool, at: i64, flags: i64,
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let d = def_of_node(def, tcx, pcx);
    if d < 0 {
        return;
    }
    let g = tcx.refs_group.get(d + 1) - 1;
    if g < 0 {
        return;
    }
    let mut pos = at;
    if name >= 0 {
        let p = find_name(from, to, name, last, pcx);
        if p >= 0 {
            pos = p;
        }
    }
    // (0.15: what a #[derive] makes uses the type, its fields and std:
    // not references of the program; the traits it names are)
    if in_derive(pos, tcx) && pcx.defs[d as usize].kind != K_TRAIT {
        return;
    }
    tcx.r_pos.push(pos);
    tcx.r_def.push(d);
    tcx.r_group.push(g);
    tcx.r_flags.push(flags);
}

// Whether the token at pos is followed by `::` (a path, not a bare name).
fn path_at(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let i = token_at(pos, pcx);
    i + 1 < pcx.toks.len() as i64 && pcx.toks[i as usize].start == pos
        && pcx.toks[(i + 1) as usize].kind == Tok::ColonColon
}

// A reference written as an identifier or a path (node n).
fn add_name_ref(def: i64, n: i64, flags: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let d = def_of_node(def, tcx, pcx);
    if d < 0 {
        return;
    }
    if path_at(pcx.nodes[n as usize].start, pcx) {
        add_ref(def, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
            pcx.defs[d as usize].name, true, pcx.nodes[n as usize].start, flags, tcx, pcx);
    } else {
        add_ref(def, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end, -1, false,
            pcx.nodes[n as usize].start, flags, tcx, pcx);
    }
}

// (0.17) The string constant (`const S: [u8] = "..."`, `const C: *u8 =
// c"..."`) whose use node n is: the checker replaced the name by the
// literal (synth_name), so the node is a Str or CStr written as a name or
// a path. -1 when n is a literal.
fn string_const_at(n: i64, pcx: &Ctx<Comp>) -> i64 {
    let s = pcx.nodes[n as usize].start;
    let e = pcx.nodes[n as usize].end;
    if e <= s || get_src()[s as usize] == b'"'
        || (get_src()[s as usize] == b'c' && s + 1 < e && get_src()[(s + 1) as usize] == b'"')
        || !(get_src()[s as usize] == b'_'
            || (get_src()[s as usize] >= b'a' && get_src()[s as usize] <= b'z')
            || (get_src()[s as usize] >= b'A' && get_src()[s as usize] <= b'Z')) {
        return -1;
    }
    let mut from = s;
    for i in s + 1..e {
        if get_src()[(i - 1) as usize] == b':' && get_src()[i as usize] == b':' {
            from = i + 1;
        }
    }
    let name = &get_src()[from as usize..e as usize];
    for c in 0..pcx.consts.len() as i64 {
        let node = pcx.consts[c as usize].node;
        let init = pcx.nodes[node as usize].c;
        if init > 0 && pcx.nodes[init as usize].kind == pcx.nodes[n as usize].kind
            && pcx.nodes[init as usize].a == pcx.nodes[n as usize].a
            && bytes_eq(sym_text(pcx.nodes[node as usize].a, pcx), name) {
            return c;
        }
    }
    -1
}

// The struct item of struct type t (through a pointer), or 0.
fn struct_node(t0: i64, pcx: &Ctx<Comp>) -> i64 {
    if t0 <= 0 {
        return 0;
    }
    let t = if pcx.types[t0 as usize].kind == TyKind::Ptr { pcx.types[t0 as usize].a } else { t0 };
    // (0.14: a closure's environment is no item)
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct
        || pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        return 0;
    }
    pcx.structs[pcx.types[t as usize].a as usize].node
}

// The field of struct item s at index i, if it is named `name`; or 0.
fn field_node(s: i64, i: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    if s == 0 || i < 0 || i >= pcx.nodes[s as usize].count
        || pcx.nodes[child(s, i, pcx) as usize].a != name {
        return 0;
    }
    child(s, i, pcx)
}

// The places assignments write (0.13): each target, and the fields,
// indexings and statics it is made of up to a dereference (`A.b[i].c =
// x` writes A, b and c), as node + 1 in out.
fn written_places(out: &mut HMap, pcx: &Ctx<Comp>) {
    for n in 1..pcx.nodes.len() {
        if pcx.nodes[n].kind != NodeKind::Assign {
            continue;
        }
        let mut t = pcx.nodes[n].b;
        while t > 0 {
            let k = pcx.nodes[t as usize].kind;
            out.put(t + 1, 1);
            if k == NodeKind::FieldAccess || k == NodeKind::Index || k == NodeKind::TupleField {
                t = pcx.nodes[t as usize].a;
            } else {
                break;
            }
        }
    }
}

// The kind of reference r (0.13): def, use (an import), call, init (a
// struct literal, a constructed variant), write (an assignment's target),
// pat (a pattern), mod (a module path), type (a type, a trait), or read.
pub fn ref_kind(r: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    let fl = (tcx.r_flags[r as usize]);
    if (fl & QF_DEF) != 0 {
        return c"def";
    }
    if (fl & QF_USE) != 0 {
        return c"use";
    }
    if (fl & QF_CALL) != 0 {
        return c"call";
    }
    if (fl & QF_INIT) != 0 {
        return c"init";
    }
    if (fl & QF_WRITE) != 0 {
        return c"write";
    }
    if (fl & QF_PAT) != 0 {
        return c"pat";
    }
    let k = pcx.defs[(tcx.r_def[r as usize]) as usize].kind;
    if k == K_MOD {
        return c"mod";
    }
    if k == K_STRUCT || k == K_ENUM || k == K_TRAIT || k == K_ALIAS {
        return c"type";
    }
    c"read"
}

// Whether kind k is in the comma-separated list.
pub fn kind_listed(k: *mut u8, list: *mut u8) -> bool {
    // UNSAFE: strlen is C's; the list and the kind are C strings, read
    // through raw pointers.
    // SAFETY: both are C strings of the caller's; list is read one byte at
    // a time up to its 0 (j stops at a 0 or a comma, i moves past a comma
    // only); a word of the list is compared only when it is n bytes long,
    // k's strlen.
    unsafe {
        let n = strlen(k) as i64;
        let mut i: i64 = 0;
        while (*list.add(i as usize)) != 0 {
            let mut j = i;
            while (*list.add(j as usize)) != 0 && (*list.add(j as usize)) != b',' {
                j += 1;
            }
            if j - i == n {
                let mut same = true;
                for x in 0..n {
                    if (*list.add((i + x) as usize)) != (*k.add(x as usize)) {
                        same = false;
                    }
                }
                if same {
                    return true;
                }
            }
            i = if (*list.add(j as usize)) == b',' { j + 1 } else { j };
        }
        false
    }
}

// The references the checked nodes record, and the ones the hooks noted.
pub fn collect_refs(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.restored {
        cached_refs(tcx, pcx);
        return;
    }
    let mut written = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    written_places(&mut written, pcx);
    for n in 1..pcx.nodes.len() as i64 {
        let kind = pcx.nodes[n as usize].kind;
        let w: i64 = if written.get(n + 1) != 0 { QF_WRITE } else { 0 };
        if kind == NodeKind::Ident {
            let y = pcx.nodes[n as usize].y;
            let res = pcx.nodes[n as usize].res;
            if res == Res::Fn {
                add_name_ref(pcx.fns[y as usize].node, n, 0, tcx, pcx);
            } else if res == Res::Const {
                add_name_ref(pcx.consts[y as usize].node, n, 0, tcx, pcx);
            } else if res == Res::Static {
                add_name_ref(pcx.statics[y as usize].node, n, w, tcx, pcx);
            }
        } else if kind == NodeKind::Call {
            if pcx.nodes[n as usize].x <= 0 {
                continue;
            }
            let f = pcx.nodes[n as usize].x - 1;
            let callee = pcx.nodes[n as usize].a;
            let def = pcx.fns[f as usize].node;
            if callee != 0 {
                add_name_ref(def, callee, QF_CALL, tcx, pcx);
            } else if pcx.nodes[n as usize].count > 0 {
                // A method call: its name after the receiver (an
                // operator's call: at the operation).
                let recv = child(n, 0, pcx);
                add_ref(def, pcx.nodes[recv as usize].end, pcx.nodes[n as usize].end,
                    pcx.nodes[def as usize].a, false, pcx.nodes[n as usize].start, QF_CALL, tcx,
                    pcx);
            }
        } else if kind == NodeKind::FieldAccess {
            if pcx.nodes[n as usize].y == 2 {
                continue;
            }
            let s = struct_node(pcx.nodes[pcx.nodes[n as usize].a as usize].ty, pcx);
            let field = field_node(s, pcx.nodes[n as usize].x, pcx.nodes[n as usize].b, pcx);
            if field != 0 {
                add_ref(field, pcx.nodes[pcx.nodes[n as usize].a as usize].end,
                    pcx.nodes[n as usize].end, pcx.nodes[n as usize].b, false,
                    pcx.nodes[n as usize].start, w, tcx, pcx);
            }
        } else if kind == NodeKind::StructLit {
            let s = struct_node(pcx.nodes[n as usize].ty, pcx);
            if s == 0 {
                continue;
            }
            if pcx.nodes[n as usize].a == pcx.nodes[s as usize].a
                || pcx.nodes[n as usize].a == pcx.self_type_sym
                || is_alias_name(pcx.nodes[n as usize].a, tcx) {
                add_ref(s, pcx.nodes[n as usize].start, pcx.nodes[n as usize].end,
                    pcx.nodes[n as usize].a, false, pcx.nodes[n as usize].start, QF_INIT, tcx,
                    pcx);
            }
            for i in 0..pcx.nodes[n as usize].count {
                let init = child(n, i, pcx);
                let field = field_node(s, pcx.nodes[init as usize].x,
                    pcx.nodes[init as usize].a, pcx);
                if field != 0 {
                    add_ref(field, pcx.nodes[init as usize].start, -1, -1, false,
                        pcx.nodes[init as usize].start, QF_INIT, tcx, pcx);
                }
            }
        } else if kind == NodeKind::Str || kind == NodeKind::CStr {
            let c = string_const_at(n, pcx);
            if c >= 0 {
                add_name_ref(pcx.consts[c as usize].node, n, 0, tcx, pcx);
            }
        } else if kind == NodeKind::VariantLit {
            let v = pcx.nodes[n as usize].a;
            add_ref(pcx.variants[v as usize].node, pcx.nodes[n as usize].start,
                pcx.nodes[n as usize].end, pcx.variants[v as usize].name, false,
                pcx.nodes[n as usize].start, QF_INIT, tcx, pcx);
        } else if kind == NodeKind::PatVariant {
            let v = pcx.nodes[n as usize].x;
            if pcx.nodes[n as usize].ty != 0 && v >= 0
                && pcx.variants[v as usize].name == pcx.nodes[n as usize].b {
                add_ref(pcx.variants[v as usize].node, pcx.nodes[n as usize].start,
                    pcx.nodes[n as usize].end, pcx.nodes[n as usize].b, false,
                    pcx.nodes[n as usize].start, QF_PAT, tcx, pcx);
            }
        }
    }
    // (0.26.2) The drops' calls: a function's drop edges (the places
    // IR's), each a call at the first value it drops of them
    for f in 0..pcx.fns.len() as i64 {
        for e in 0..crate::places::drop_edge_count(f, pcx) {
            let at = crate::places::drop_edge_node(f, e, pcx);
            if at > 0 {
                let pos = pcx.nodes[at as usize].start;
                add_ref(pcx.fns[crate::places::drop_edge(f, e, pcx) as usize].node, pos, -1, -1,
                    false, pos, QF_CALL, tcx, pcx);
            }
        }
    }
    // (0.15: a trait's `Self`, resolved to the type of an impl checked
    // against it, is no use of that type)
    let mut traits: Vec<i64, Comp> = Vec::new_in(Comp {});
    for t in 1..pcx.nodes.len() {
        if pcx.nodes[t].kind == NodeKind::Trait {
            traits.push(pcx.nodes[t].start);
            traits.push(pcx.nodes[t].end);
        }
    }
    let mut i: i64 = 0;
    while i < pcx.notes.len() as i64 {
        let at = (pcx.notes[i as usize]);
        let mut in_trait = false;
        if (pcx.notes[(i + 1) as usize]) == pcx.self_type_sym {
            let mut k: i64 = 0;
            while k < traits.len() as i64 {
                if at >= (traits[k as usize])
                    && at < (traits[(k + 1) as usize]) {
                    in_trait = true;
                }
                k += 2;
            }
        }
        if !in_trait {
            add_ref((pcx.notes[(i + 2) as usize]), at, -1,
                (pcx.notes[(i + 1) as usize]), false, at,
                (pcx.notes[(i + 3) as usize]), tcx, pcx);
        }
        i += 4;
    }
    // The definitions themselves.
    for d in 0..pcx.defs.len() as i64 {
        if tcx.refs_group.get(d + 1) != 0 {
            add_ref(pcx.defs[d as usize].node, pcx.defs[d as usize].name_pos, -1, -1, false,
                pcx.defs[d as usize].name_pos, QF_DEF, tcx, pcx);
        }
    }
}

// Every reference of the program, to every definition, for the tools'
// cache (0.13): (position, definition, flags) triples, into out. (After
// the answer: TARGETS and the references found for it are dropped.)
pub fn collect_all_refs(out: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    tcx.refs_targets.clear();
    tcx.r_pos.clear();
    tcx.r_def.clear();
    tcx.r_group.clear();
    tcx.r_flags.clear();
    tcx.refs_group = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    for d in 0..pcx.defs.len() as i64 {
        tcx.refs_group.put(d + 1, 1);
    }
    collect_refs(tcx, pcx);
    for i in 0..tcx.r_pos.len() as i64 {
        out.push((tcx.r_pos[i as usize]));
        out.push((tcx.r_def[i as usize]));
        out.push((tcx.r_flags[i as usize]));
    }
}

// (0.15) The definition a reference in from..to names (the first one, an
// import's path or a use outside every item: `query show FILE:LINE:COL`
// on a `use` line), or -1. The references found are dropped after.
pub fn def_used_at(from: i64, to: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
    collect_all_refs(&mut all, tcx, pcx);
    tcx.refs_targets.clear();
    tcx.r_pos.clear();
    tcx.r_def.clear();
    tcx.r_group.clear();
    tcx.r_flags.clear();
    tcx.refs_group = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    let mut best: i64 = -1;
    let mut best_pos = to;
    let mut i: i64 = 0;
    while i < all.len() as i64 {
        let pos = (all[i as usize]);
        if pos >= from && pos < best_pos && ((all[(i + 2) as usize]) & QF_DEF) == 0 {
            best = (all[(i + 1) as usize]);
            best_pos = pos;
        }
        i += 3;
    }
    best
}

// The references in order (file, position, definition), each once: the
// indices into R_*, in `out`.
pub fn sorted_refs(out: &mut Vec<i64, Comp>, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let n = tcx.r_pos.len() as i64;
        let mut k1 = zeros(n + 1);
        let mut k2 = zeros(n + 1);
        let mut all: Vec<i64, Comp> = Vec::new_in(Comp {});
        for i in 0..n {
            all.push(i);
            (k1[i as usize]) = rank_of((tcx.r_pos[i as usize]), tcx, pcx) * 4294967296 + (
                tcx.r_pos[i as usize]);
            (k2[i as usize]) = (tcx.r_def[i as usize]);
        }
        sort_by_keys(&mut all, &k1, &k2);
        let mut i: i64 = 0;
        while i < all.len() as i64 {
            let r = (all[i as usize]);
            let mut j = i + 1;
            while j < all.len() as i64
                && (tcx.r_pos[(all[j as usize]) as usize])
                == (tcx.r_pos[r as usize])
                && (tcx.r_def[(all[j as usize]) as usize])
                == (tcx.r_def[r as usize]) {
                (tcx.r_flags[r as usize]) |= (tcx.r_flags[(all[j as usize]) as usize]);
                j += 1;
            }
            out.push(r);
            i = j;
        }
    }
}

// Source lines longer than this are cut (with `…`).
const LINE_MAX: i64 = 100;

// The line holding pos, trimmed (and cut to LINE_MAX bytes).
pub fn put_line(out: i64, pos: i64, pcx: &Ctx<Comp>) {
    let mut a = line_start(pos, pcx);
    let mut b = line_end(pos, pcx);
    while a < b && is_space(get_src()[a as usize]) {
        a += 1;
    }
    while b > a && is_space(get_src()[(b - 1) as usize]) {
        b -= 1;
    }
    if b - a <= LINE_MAX {
        buf_bytes(out, &get_src()[a as usize..b as usize]);
        return;
    }
    // (not inside a UTF-8 sequence)
    let mut e = a + LINE_MAX - 1;
    while e > a && (get_src()[e as usize] & 192) == 128 {
        e -= 1;
    }
    buf_bytes(out, &get_src()[a as usize..e as usize]);
    buf_byte(out, 226 as u8);
    buf_byte(out, 128 as u8);
    buf_byte(out, 166 as u8);
}

// A path without its `crate::` prefixes (`gvn::run_gvn`,
// `<geom::V2 as Add>::add`); `crate` stays.
pub fn put_short(out: i64, sym: i64, pcx: &Ctx<Comp>) {
    let p = sym_text(sym, pcx);
    let mut i: i64 = 0;
    while i < p.len() as i64 {
        let start = i == 0 || p[(i - 1) as usize] == b'<' || p[(i - 1) as usize] == b' ';
        if start && i + 7 <= p.len() as i64 && p[i as usize] == b'c' && p[(i + 1) as usize] == b'r'
            && p[(i + 2) as usize] == b'a' && p[(i + 3) as usize] == b't'
            && p[(i + 4) as usize] == b'e' && p[(i + 5) as usize] == b':'
            && p[(i + 6) as usize] == b':' {
            i += 7;
            continue;
        }
        buf_byte(out, p[i as usize]);
        i += 1;
    }
}

// More references than this: refs and callers print a summary per file
// (unless --limit or --all).
pub const REFS_BUDGET: i64 = 60;

// The path of file f as printed.
pub fn file_text(f: i64, pcx: &Ctx<Comp>) -> &[u8] {
    // UNSAFE: strlen is C's; a file's path is a C string in the front end's
    // table, read and seen as a slice.
    // SAFETY: the path is a C string that lives as long as the context (its
    // files' paths are not freed); p[1] is read only when p[0] is '.', not
    // the 0, and p moves past `./` only; the slice covers the bytes before
    // the 0 and borrows from pcx.
    unsafe {
        let mut p = pcx.files[f as usize].path;
        while (*p.add(0)) == b'.' && (*p.add(1)) == b'/' {
            p = p.add(2);
        }
        c_bytes(p)
    }
}

// Resolves --in X (0.17: called once per --in, the matches adding up): a
// file (X has a `/`, ends in `.vl` or is `<std>`; the path, or its end
// by whole components) or a module (matched like NAME, with its inline
// modules), or FILE:LINE (the item holding that line: ref_in; its file
// for the fixes by module), or an item (a function, type...: its text).
// Whether anything matched.
pub fn resolve_in(x0: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let x = canonical_name(x0);
        let mut any = false;
        while pcx.in_file.len() as i64 < pcx.files.len() as i64 {
            pcx.in_file.push(0);
        }
        while pcx.in_module.len() as i64 < module_count(pcx) {
            pcx.in_module.push(0);
        }
        // (FILE:LINE: the item holding that line; its file for what works by
        // file or module)
        let a = trailing_number(x);
        if a > 0 && x[(a - 1) as usize] == b':' && (a < 2 || x[(a - 2) as usize] != b':') {
            let file = &x[0..(a - 1) as usize];
            for f in 0..pcx.files.len() as i64 {
                let p = file_text(f, pcx);
                if path_matches(p, file) {
                    let d = def_at_line(f, parse_digits(&x[a as usize..]), pcx);
                    if d < 0 {
                        tcx.in_no_item = true;
                        return false;
                    }
                    in_item(d, pcx);
                    return true;
                }
            }
            return false;
        }
        let is_file = x.len() > 0
            && (x[0] == b'<' || find_in(x, c"/", 0) >= 0 || find_in(x, c".vl", 0) >= 0
                || find_in(x, c".wgsl", 0) >= 0);
        if is_file {
            for f in 0..pcx.files.len() as i64 {
                let p = file_text(f, pcx);
                if path_matches(p, x) || dir_holds(p, x) {
                    (pcx.in_file[f as usize]) = 1;
                    any = true;
                }
            }
            return any;
        }
        let mut modules: Vec<i64, Comp> = Vec::new_in(Comp {});
        find_modules(x, false, &mut modules, tcx, pcx);
        for i in 0..modules.len() as i64 {
            (pcx.in_module[(modules[i as usize]) as usize]) = 1;
            any = true;
        }
        if any {
            return true;
        }
        // (0.17: an item: a function, a method, a type...)
        let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
        find_defs(x, false, &mut found, tcx, pcx);
        for i in 0..found.len() as i64 {
            let d = (found[i as usize]);
            if pcx.defs[d as usize].kind != K_MOD
                && !file_made(file_of_pos(pcx.defs[d as usize].start, pcx), pcx) {
                in_item(d, pcx);
                any = true;
            }
        }
        any
    }
}

// (0.17) Item d's text is in --in.
fn in_item(d: i64, pcx: &mut Ctx<Comp>) {
    pcx.in_ranges.push(text_start(d, pcx));
    pcx.in_ranges.push(pcx.defs[d as usize].end);
    let f = file_of_pos(pcx.defs[d as usize].start, pcx);
    if (pcx.in_file[f as usize]) == 0 {
        (pcx.in_file[f as usize]) = 2;
    }
}

// Whether directory x (whole components, a trailing `/` or not: `front`,
// `compiler/src/front/`) holds file p (0.13).
fn dir_holds(p: &[u8], x0: &[u8]) -> bool {
    let mut x = x0;
    while x.len() > 0 && x[(x.len() as i64 - 1) as usize] == b'/' {
        x = &x[0..(x.len() as i64 - 1) as usize];
    }
    if x.len() == 0 || x.len() as i64 + 1 >= p.len() as i64 {
        return false;
    }
    for i in 0..p.len() as i64 - x.len() as i64 {
        if (i == 0 || p[(i - 1) as usize] == b'/') && p[(i + x.len() as i64) as usize] == b'/'
            && bytes_eq(&p[i as usize..(i + x.len() as i64) as usize], x) {
            return true;
        }
    }
    false
}

// The message of a --in that resolve_in did not resolve (after `diag`):
// no such file or module, or (FILE:LINE) no item at that line.
pub fn put_bad_in(d: i64, x: *mut u8, tcx: &Tcx<Comp>) {
    if tcx.in_no_item {
        buf_str(d, c"no item at ");
        buf_str(d, x);
        buf_byte(d, b'\n');
        return;
    }
    buf_str(d, c"no file, module or item '");
    buf_str(d, x);
    buf_str(d, c"' in the program\n");
}

// Whether the reference at pos passes --in.
pub fn ref_in(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.opt_in == 0 as *mut u8 {
        return true;
    }
    let mut k: i64 = 0;
    while k < pcx.in_ranges.len() as i64 {
        if pos >= (pcx.in_ranges[k as usize])
            && pos < (pcx.in_ranges[(k + 1) as usize]) {
            return true;
        }
        k += 2;
    }
    if (pcx.in_file[file_of_pos(pos, pcx) as usize]) == 1 {
        return true;
    }
    let mut m = module_at(pos, pcx);
    while m >= 0 {
        if (pcx.in_module[m as usize]) != 0 {
            return true;
        }
        m = if m > 0 { pcx.modules[m as usize].parent } else { -1 };
    }
    false
}

// A `try:` line for refs/callers with one more option (and its value),
// keeping --in unless the option is another --in.
pub fn try_refs(cmd: *mut u8, name: &[u8], option: *mut u8, value: &[u8], tcx: &mut Tcx<Comp>,
    pcx: &Ctx<Comp>) {
    let out = try_begin(cmd, name, true, tcx, pcx);
    if pcx.opt_in != 0 as *mut u8 && !streq(option, c"--in") {
        buf_str(out, c" --in");
        put_cword(out, pcx.opt_in);
    }
    buf_byte(out, b' ');
    buf_str(out, option);
    if value.len() > 0 {
        put_word(out, value);
    }
    try_end(out);
}

pub fn query_refs(matches: &[i64], cmd: *mut u8, name: &[u8], tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    let calls_only = streq(cmd, c"callers");
    set_targets(matches, tcx, pcx);
    collect_refs(tcx, pcx);
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    sorted_refs(&mut order, tcx, pcx);
    let mut sel: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut multi = tcx.refs_targets.len() as i64 > 1;
    for i in 0..order.len() as i64 {
        let r = (order[i as usize]);
        if calls_only && ((tcx.r_flags[r as usize]) & QF_CALL) == 0 {
            continue;
        }
        if tcx.opt_kind != 0 as *mut u8 && !kind_listed(ref_kind(r, tcx, pcx), tcx.opt_kind) {
            continue;
        }
        if !ref_in((tcx.r_pos[r as usize]), pcx) {
            continue;
        }
        sel.push(r);
        if (tcx.r_def[r as usize])
            != (tcx.refs_targets[(tcx.r_group[r as usize]) as usize]) {
            multi = true;
        }
    }
    let out = buf_new();
    let groups = tcx.refs_targets.len() as i64;
    if tcx.opt_count {
        if groups == 1 {
            buf_int(out, sel.len() as i64);
            buf_byte(out, b'\n');
        } else {
            for g in 0..groups {
                let mut n: i64 = 0;
                for i in 0..sel.len() as i64 {
                    if (tcx.r_group[(sel[i as usize]) as usize]) == g {
                        n += 1;
                    }
                }
                buf_int(out, n);
                buf_byte(out, b'\t');
                buf_bytes(out,
                    sym_text(pcx.defs[(tcx.refs_targets[g as usize]) as usize].fqn,
                        pcx));
                buf_byte(out, b'\n');
            }
        }
        buf_write_fd(out, STDOUT);
        return 0;
    }
    let noun = if calls_only { c"calls" } else { c"refs" };
    let total = sel.len() as i64;
    if total == 0 {
        let d = diag(c"note", c"query.empty", tcx);
        buf_str(d, c"0 ");
        buf_str(d, noun);
        if pcx.opt_in != 0 as *mut u8 {
            buf_str(d, c" in ");
            buf_str(d, pcx.opt_in);
        }
        buf_byte(d, b'\n');
        return 0;
    }
    // Per file: the number of references (files in order).
    let mut files: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut per_file: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut biggest: i64 = -1;
    let mut biggest_n: i64 = 0;
    for i in 0..sel.len() as i64 {
        let f = file_of_pos((tcx.r_pos[(sel[i as usize]) as usize]), pcx);
        if files.len() as i64 == 0 || (files[(files.len() as i64 - 1) as usize]) != f {
            files.push(f);
            per_file.push(0);
        }
        let last_file = per_file.len() - 1;
        per_file[last_file] += 1;
        if (per_file[(per_file.len() as i64 - 1) as usize]) > biggest_n {
            biggest_n = (per_file[(per_file.len() as i64 - 1) as usize]);
            biggest = f;
        }
    }
    if tcx.opt_limit < 0 && !tcx.opt_all && total > REFS_BUDGET {
        for i in 0..files.len() as i64 {
            buf_bytes(out, file_text((files[i as usize]), pcx));
            buf_byte(out, b'\t');
            buf_int(out, (per_file[i as usize]));
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDOUT);
        let d = diag(c"note", c"query.truncated", tcx);
        buf_int(d, total);
        buf_byte(d, b' ');
        buf_str(d, noun);
        buf_str(d, c" in ");
        buf_int(d, files.len() as i64);
        buf_str(d, if files.len() as i64 == 1 { c" file\n" } else { c" files\n" });
        if files.len() as i64 > 1 {
            try_refs(cmd, name, c"--in", file_text(biggest, pcx), tcx, pcx);
        }
        try_refs(cmd, name, c"--limit 60", &file_text(biggest, pcx)[0..0], tcx, pcx);
        try_refs(cmd, name, c"--all", &file_text(biggest, pcx)[0..0], tcx, pcx);
        return 0;
    }
    let shown = if tcx.opt_limit >= 0 && tcx.opt_limit < total { tcx.opt_limit } else { total };
    let mut cur: i64 = -1;
    for i in 0..shown {
        let r = (sel[i as usize]);
        let pos = (tcx.r_pos[r as usize]);
        let d = (tcx.r_def[r as usize]);
        let f = file_of_pos(pos, pcx);
        if f != cur {
            buf_str(out, c"# ");
            buf_bytes(out, file_text(f, pcx));
            buf_byte(out, b'\n');
            cur = f;
        }
        buf_int(out, line_of(pos, pcx));
        buf_byte(out, b':');
        buf_int(out, pos - line_start(pos, pcx) + 1);
        buf_byte(out, b'\t');
        buf_str(out, ref_kind(r, tcx, pcx));
        if ((tcx.r_flags[r as usize]) & QF_DEF) == 0 {
            buf_byte(out, b'\t');
            let e = enclosing(pos, tcx, pcx);
            put_short(out,
                if e >= 0 { pcx.defs[e as usize].fqn }
                else { mod_fqn(module_at(pos, pcx), tcx, pcx) }, pcx);
        }
        if multi {
            buf_str(out, c"\t->");
            put_short(out, pcx.defs[d as usize].fqn, pcx);
        }
        buf_byte(out, b'\t');
        put_line(out, pos, pcx);
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDOUT);
    if shown < total {
        let d = diag(c"note", c"query.truncated", tcx);
        buf_str(d, c"showing ");
        buf_int(d, shown);
        buf_str(d, c" of ");
        buf_int(d, total);
        buf_byte(d, b' ');
        buf_str(d, noun);
        buf_byte(d, b'\n');
        if files.len() as i64 > 1 {
            try_refs(cmd, name, c"--in", file_text(biggest, pcx), tcx, pcx);
        }
        try_refs(cmd, name, c"--all", &file_text(biggest, pcx)[0..0], tcx, pcx);
    }
    0
}
