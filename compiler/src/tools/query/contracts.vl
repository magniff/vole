// `query contracts NAME` (0.27.2.1, docs/design/contracts-effects.md
// C7.6): a function's `requires` and `ensures`, a line each; for a trait
// method declaration `Tr::m`, its own (req(Tr::m), ens(Tr::m)), then each
// impl's method of the program: what it adds, and its effective lists
// (req_eff, ens_eff: the trait's first, C7.1, C7.2), each clause marked
// `(trait)` when it is the trait's copy (front/contracts/expand.vl:
// copy_trait_clauses).

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_new, buf_str, buf_write_fd, get_src, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::contracts::{CLAUSE_DEBUG, CLAUSE_ENSURES, CLAUSE_REQUIRES};
use crate::tools::ctx::Tcx;
use crate::tools::query::positions::put_loc;

// The answer for the definitions matches; 1 when one is no function.
// RULE: C7.6
pub fn query_contracts(matches: IntVec, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    let mut status: i64 = 0;
    for i in 0..matches.len() as i64 {
        let d = matches.get(i);
        let node = pcx.defs[d as usize].node;
        if node <= 0 || pcx.nodes[node as usize].kind != NodeKind::Fn {
            status = 1;
            continue;
        }
        buf_bytes(out, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_byte(out, b'\t');
        put_loc(out, pcx.defs[d as usize].name_pos, pcx);
        buf_byte(out, b'\n');
        let listed = put_clauses(out, node, node, c"  ", pcx);
        let tr = trait_of_decl(node, pcx);
        if tr == 0 {
            if listed == 0 {
                buf_str(out, c"  (no clauses)\n");
            }
            continue;
        }
        // (a trait's method: each impl's of the program)
        let program = pcx.program;
        for j in 0..pcx.nodes[program as usize].count {
            let im = child(program, j, pcx);
            if pcx.nodes[im as usize].kind != NodeKind::Impl || pcx.nodes[im as usize].a <= 0
                || pcx.nodes[pcx.nodes[im as usize].a as usize].a != pcx.nodes[tr as usize].a {
                continue;
            }
            for k in 0..pcx.nodes[im as usize].count {
                let f = child(im, k, pcx);
                if pcx.nodes[f as usize].kind != NodeKind::Fn
                    || pcx.nodes[f as usize].a != pcx.nodes[node as usize].a {
                    continue;
                }
                buf_str(out, c"impl ");
                buf_bytes(out,
                    &get_src()[
                        pcx.nodes[pcx.nodes[im as usize].a as usize].start as usize..pcx.nodes[
                            pcx.nodes[im as usize].a as usize].end as usize]);
                buf_str(out, c" for ");
                let st = pcx.nodes[im as usize].b;
                buf_bytes(out,
                    &get_src()[
                        pcx.nodes[st as usize].start as usize..pcx.nodes[st as usize].end as usize]);
                buf_byte(out, b'\t');
                put_loc(out, pcx.nodes[f as usize].start, pcx);
                buf_byte(out, b'\n');
                if put_clauses(out, f, node, c"  ", pcx) == 0 {
                    buf_str(out, c"  (no clauses)\n");
                }
            }
        }
    }
    buf_write_fd(out, STDOUT);
    status
}

// The program's trait that declares method node decl, or 0.
fn trait_of_decl(decl: i64, pcx: &Ctx<Comp>) -> i64 {
    let program = pcx.program;
    for j in 0..pcx.nodes[program as usize].count {
        let t = child(program, j, pcx);
        if pcx.nodes[t as usize].kind != NodeKind::Trait {
            continue;
        }
        for k in 0..pcx.nodes[t as usize].count {
            if child(t, k, pcx) == decl {
                return t;
            }
        }
    }
    0
}

// The clauses function node f owns, a line each (`requires COND` or
// `ensures COND`, `debug` before, `(trait)` after a copy of trait method
// decl's), in order; how many.
fn put_clauses(out: i64, f: i64, decl: i64, indent: *mut u8, pcx: &mut Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    // UNSAFE: the clause tables' words (IntVecs), by index.
    // SAFETY: k < their count.
    unsafe {
        for k in 0..pcx.clause_owner.len() as i64 {
            if (pcx.clause_owner[k as usize]) != f {
                continue;
            }
            let kind = (pcx.clause_kind[k as usize]);
            let cond = (pcx.clause_cond[k as usize]);
            buf_str(out, indent);
            if (kind & CLAUSE_DEBUG) != 0 {
                buf_str(out, c"debug ");
            }
            buf_str(out, if (kind & !CLAUSE_DEBUG) == CLAUSE_REQUIRES { c"requires " }
                else if (kind & !CLAUSE_DEBUG) == CLAUSE_ENSURES { c"ensures " }
                else { c"invariant " });
            buf_bytes(out,
                &get_src()[
                    pcx.nodes[cond as usize].start as usize..pcx.nodes[cond as usize].end as usize]);
            let pos = (pcx.clause_pos[k as usize]);
            if f != decl && pos >= pcx.nodes[decl as usize].start
                && pos < pcx.nodes[decl as usize].end {
                buf_str(out, c" (trait)");
            }
            buf_byte(out, b'\t');
            put_loc(out, pos, pcx);
            buf_byte(out, b'\n');
            n += 1;
        }
    }
    n
}
