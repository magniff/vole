// Text edits of a tree's files, vole sources or not (0.21, for 0.24's
// rename; docs/refactor.md "Renaming the language"): `rewrite --text OLD
// NEW` (rewrite) and `refactor extension OLD NEW` (extension). The files
// are git's (`git ls-files`), less an exclusion list: whole files, or the
// lines of a file a regular expression picks, or ranges of lines. In a
// vole source a match can be limited to its comments, strings or code
// (places: the lexer's tokens). The edit is written as the engine writes
// one (a copy next to each file, renamed onto it), files are moved as
// `git mv` moves them (the index's entries, then the files), and it is
// journaled for `undo` (edit/undo: kind 3, a moved file).
//
// This file holds the options, the exclusions, the matching, the files,
// and the writing; the places of a source in places, the build compared
// before and after a rename in samebuild.

pub mod places;
pub mod rewrite;
pub mod extension;
pub mod samebuild;

use crate::base::{
    IntVec, STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_fd,
    get_bufs,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::tools::ctx::Tcx;
use crate::tools::edit::remove_empty_dirs;
use crate::tools::edit::apply::{cannot_write, copy_path, make_parent};
use crate::tools::edit::undo::journal_moves;
use crate::tools::proc::{
    buf_cstr, read_file_if, remove_file, rename_file, run_capture, run_with_stdin, same_bytes,
    write_file_if,
};
use crate::tools::query::c_slice;
use crate::tools::query::diagnostics::diag;
use crate::tools::rewrite::regex::{re_find, re_search, re_valid};

// ---- The options of a match ----

fn is_alnum(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
}

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 } else { c }
}

fn upper(c: u8) -> u8 {
    if c >= b'a' && c <= b'z' { c - 32 } else { c }
}

// Whether text[s..e) is a match of literal old.
fn literal_at(text: &[u8], s: i64, old: &[u8], tcx: &Tcx<Comp>) -> bool {
    if s + old.len() as i64 > text.len() as i64 {
        return false;
    }
    for j in 0..old.len() as i64 {
        let a = text[(s + j) as usize];
        if a != old[j as usize] && !(tcx.t_case && lower(a) == lower(old[j as usize])) {
            return false;
        }
    }
    true
}

// --word: whether the match text[s..e) has a word boundary where its own
// ends are letters or digits.
fn word_ok(text: &[u8], s: i64, e: i64, tcx: &Tcx<Comp>) -> bool {
    if !tcx.t_word || e <= s {
        return true;
    }
    // (an escape before it ends a word too: `\nvole` in a literal)
    if is_alnum(text[s as usize]) && s > 0 && is_alnum(text[(s - 1) as usize])
        && !(s > 1 && text[(s - 2) as usize] == b'\\' && text[(s - 1) as usize] != b'x') {
        return false;
    }
    if is_alnum(text[(e - 1) as usize]) && e < text.len() as i64 && is_alnum(text[e as usize]) {
        return false;
    }
    true
}

// The matches of old in text[from..to), in order and apart: their starts
// and ends.
pub fn find_matches(text: &[u8], from: i64, to: i64, old: &[u8], starts: &mut IntVec,
    ends: &mut IntVec, tcx: &Tcx<Comp>) {
    if old.len() == 0 {
        return;
    }
    if tcx.t_regex {
        // (line by line)
        let mut a = from;
        while a < to {
            let mut b = a;
            while b < to && text[b as usize] != b'\n' {
                b += 1;
            }
            let line = &text[a as usize..b as usize];
            let mut at: i64 = 0;
            while at <= line.len() as i64 {
                let mut end: i64 = 0;
                let s = re_find(old, line, at, &mut end);
                if s < 0 {
                    break;
                }
                if end > s && word_ok(text, a + s, a + end, tcx) {
                    starts.push(a + s);
                    ends.push(a + end);
                    at = end;
                } else {
                    at = s + 1;
                }
            }
            a = b + 1;
        }
        return;
    }
    let mut i = from;
    while i + old.len() as i64 <= to {
        if literal_at(text, i, old, tcx) && word_ok(text, i, i + old.len() as i64, tcx) {
            starts.push(i);
            ends.push(i + old.len() as i64);
            i += old.len() as i64;
        } else {
            i += 1;
        }
    }
}

// The replacement of match m by new, into buffer out: with --case, in the
// case of m.
pub fn put_replacement(out: i64, new: &[u8], m: &[u8], tcx: &mut Tcx<Comp>) {
    if !tcx.t_case {
        buf_bytes(out, new);
        return;
    }
    let mut letters: i64 = 0;
    let mut uppers: i64 = 0;
    for j in 0..m.len() {
        if lower(m[j]) != upper(m[j]) {
            letters += 1;
            if m[j] == upper(m[j]) {
                uppers += 1;
            }
        }
    }
    let first_upper = m.len() > 0 && lower(m[0]) != m[0];
    if letters > 1 && uppers == letters {
        for j in 0..new.len() {
            buf_byte(out, upper(new[j]));
        }
    } else if first_upper && uppers == 1 {
        for j in 0..new.len() {
            buf_byte(out, if j == 0 { upper(new[j]) } else { new[j] });
        }
    } else {
        if uppers > 0 {
            tcx.mixed_case += 1;
        }
        buf_bytes(out, new);
    }
}

// ---- Exclusions ----
//
// A spec is `GLOB` (the whole file), `GLOB:/RE/` (its lines RE matches)
// or `GLOB:/A/,/B/` (each range of lines from one A matches to the line
// before the next one B matches, or to the end). In a GLOB, `*` is any
// bytes (`/` too) and `?` one; a GLOB ending in `/` is everything under
// it. `\/` is a `/` in a RE.

// Whether glob g matches path p.
pub fn glob_match(g: &[u8], p: &[u8]) -> bool {
    if g.len() > 0 && g[(g.len() as i64 - 1) as usize] == b'/' {
        return p.len() >= g.len() && same_bytes(&p[0..g.len()], g);
    }
    glob_at(g, 0, p, 0)
}

fn glob_at(g: &[u8], i: i64, p: &[u8], j: i64) -> bool {
    if i == g.len() as i64 {
        return j == p.len() as i64;
    }
    if g[i as usize] == b'*' {
        let mut k = j;
        while k <= p.len() as i64 {
            if glob_at(g, i + 1, p, k) {
                return true;
            }
            k += 1;
        }
        return false;
    }
    j < p.len() as i64 && (g[i as usize] == b'?' || g[i as usize] == p[j as usize])
        && glob_at(g, i + 1, p, j + 1)
}

// The regular expression of a spec from s[i] (a `/`) to the next
// unescaped `/`: into a buffer; the index after it, or -1.
fn take_re(s: &[u8], i: i64, out: &mut i64) -> i64 {
    if i >= s.len() as i64 || s[i as usize] != b'/' {
        return -1;
    }
    let b = buf_new();
    let mut k = i + 1;
    while k < s.len() as i64 && s[k as usize] != b'/' {
        if s[k as usize] == b'\\' && k + 1 < s.len() as i64 {
            buf_byte(b, s[k as usize]);
            k += 1;
        }
        buf_byte(b, s[k as usize]);
        k += 1;
    }
    if k >= s.len() as i64 || !re_valid(buf_slice(b)) {
        return -1;
    }
    *out = b;
    k + 1
}

// Adds exclusion spec s; false (and the diagnostic) when it is malformed.
pub fn add_exclusion(s: &[u8], tcx: &mut Tcx<Comp>) -> bool {
    let mut colon: i64 = -1;
    for k in 0..s.len() as i64 {
        if s[k as usize] == b':' && k + 1 < s.len() as i64 && s[(k + 1) as usize] == b'/' {
            colon = k;
            break;
        }
    }
    let g = buf_new();
    buf_bytes(g, if colon < 0 { s } else { &s[0..colon as usize] });
    let mut a: i64 = -1;
    let mut b: i64 = -1;
    if colon >= 0 {
        let mut at = take_re(s, colon + 1, &mut a);
        if at > 0 && at < s.len() as i64 {
            if s[at as usize] != b',' {
                at = -1;
            } else {
                at = take_re(s, at + 1, &mut b);
            }
        }
        if at != s.len() as i64 {
            let d = diag(c"error", c"rewrite.exclude", tcx);
            buf_str(d, c"'");
            buf_bytes(d, s);
            buf_str(d,
                c"' is no exclusion: GLOB, GLOB:/RE/ (its lines) or GLOB:/A/,/B/ (from A to before B)\n");
            return false;
        }
    }
    tcx.x_glob.push(g);
    tcx.x_a.push(a);
    tcx.x_b.push(b);
    true
}

// Adds the specs of file path, one a line (`#` starts a comment line);
// false after the diagnostic.
pub fn read_exclusions(path: *mut u8, tcx: &mut Tcx<Comp>) -> bool {
    let text = buf_new();
    if !read_file_if(path, text) {
        let d = diag(c"error", c"rewrite.exclude", tcx);
        buf_str(d, c"cannot read '");
        buf_str(d, path);
        buf_str(d, c"'\n");
        return false;
    }
    let t = buf_slice(text);
    let mut i: i64 = 0;
    while i < t.len() as i64 {
        let mut e = i;
        while e < t.len() as i64 && t[e as usize] != b'\n' {
            e += 1;
        }
        let mut a = i;
        let mut z = e;
        while a < z && (t[a as usize] == b' ' || t[a as usize] == b'\t') {
            a += 1;
        }
        while z > a
            && (t[(z - 1) as usize] == b' ' || t[(z - 1) as usize] == b'\t'
                || t[(z - 1) as usize] == b'\r') {
            z -= 1;
        }
        if z > a && t[a as usize] != b'#' && !add_exclusion(&t[a as usize..z as usize], tcx) {
            return false;
        }
        i = e + 1;
    }
    true
}

// Whether file p is excluded whole.
pub fn excluded(p: &[u8], tcx: &Tcx<Comp>) -> bool {
    unsafe {
        for k in 0..tcx.x_glob.len() as i64 {
            if (tcx.x_a[k as usize]) < 0
                && glob_match(buf_slice((tcx.x_glob[k as usize])), p) {
                return true;
            }
        }
        false
    }
}

// The kept lines of file p with text t: byte ranges (start, end pairs,
// in order, apart) into out; the number of lines kept.
pub fn kept_ranges(p: &[u8], t: &[u8], out: &mut IntVec, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let mut specs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..tcx.x_glob.len() as i64 {
            if (tcx.x_a[k as usize]) >= 0
                && glob_match(buf_slice((tcx.x_glob[k as usize])), p) {
                specs.push(k);
            }
        }
        if specs.len() as i64 == 0 {
            return 0;
        }
        // Per spec: in a range (until its B), or not.
        let open = crate::base::alloc_array::<bool>(specs.len() as i64);
        for k in 0..specs.len() as i64 {
            (*open.add(k as usize)) = false;
        }
        let mut lines: i64 = 0;
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            let line = &t[i as usize..e as usize];
            let mut keep = false;
            for k in 0..specs.len() as i64 {
                let x = (specs[k as usize]);
                if (*open.add(k as usize)) && (tcx.x_b[x as usize]) >= 0
                    && re_search(buf_slice((tcx.x_b[x as usize])), line) {
                    (*open.add(k as usize)) = false;
                }
                if !(*open.add(k as usize))
                    && re_search(buf_slice((tcx.x_a[x as usize])), line) {
                    if (tcx.x_b[x as usize]) >= 0 {
                        (*open.add(k as usize)) = true;
                    }
                    keep = true;
                }
                if (*open.add(k as usize)) {
                    keep = true;
                }
            }
            if keep {
                let end = if e < t.len() as i64 { e + 1 } else { e };
                if out.len() as i64 > 0 && (out[(out.len() as i64 - 1) as usize]) == i {
                    (out[(out.len() as i64 - 1) as usize]) = end;
                } else {
                    out.push(i);
                    out.push(end);
                }
                lines += 1;
            }
            i = e + 1;
        }
        lines
    }
}

// ---- The files ----

// The files git tracks under the current directory (C strings, relative
// to it), into out; false when git cannot tell (no checkout).
pub fn tracked_files(out: &mut IntVec) -> bool {
    unsafe {
        let args = crate::base::alloc_array::<*mut u8>(5i64);
        (*args.add(0)) = c"git";
        (*args.add(1)) = c"ls-files";
        (*args.add(2)) = c"-z";
        (*args.add(3)) = c"--";
        (*args.add(4)) = 0 as *mut u8;
        // (stderr goes with stdout: a path never starts with "fatal: ")
        let listing = buf_new();
        if run_capture(args, listing) != 0 {
            return false;
        }
        let t = buf_slice(listing);
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != 0 {
                e += 1;
            }
            if e > i {
                let b = buf_new();
                buf_bytes(b, &t[i as usize..e as usize]);
                out.push(buf_cstr(b) as i64);
            }
            i = e + 1;
        }
        true
    }
}

// Whether text t is text: no NUL byte.
pub fn is_text(t: &[u8]) -> bool {
    for i in 0..t.len() {
        if t[i] == 0 {
            return false;
        }
    }
    true
}

// ---- Writing an edit ----
//
// The files changed: path (as it is after the moves), text before and
// after (buffers); the files moved: from, to (C strings).

// (0.24) The target a link moved from a to b points at after the move: its
// extension a's replaced by b's when it has a's; 0 when it keeps its own.
fn relinked_target(t: &[u8], a: &[u8], b: &[u8]) -> *mut u8 {
    let ea = crate::base::source_ext_len(a);
    let eb = crate::base::source_ext_len(b);
    if ea == 0 || eb == 0 || t.len() as i64 <= ea
        || !same_bytes(&t[(t.len() as i64 - ea) as usize..], &a[(a.len() as i64 - ea) as usize..])
        || same_bytes(&a[(a.len() as i64 - ea) as usize..], &b[(b.len() as i64 - eb) as usize..]) {
        return 0 as *mut u8;
    }
    let out = buf_new();
    buf_bytes(out, &t[0..(t.len() as i64 - ea) as usize]);
    buf_bytes(out, &b[(b.len() as i64 - eb) as usize..]);
    buf_cstr(out)
}

// Moves files from[k] to to[k], as `git mv` does: the index's entry of a
// tracked file moves (one `git update-index --index-info`), then the file
// (and the directories left empty go). False after the diagnostic; what
// was moved stays moved.
pub fn move_files(from: IntVec, to: IntVec, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // (git names them from here: the journal's absolute paths too)
        let here = crate::tools::proc::absolute_path(c".");
        // The index's entries: `MODE SHA STAGE<TAB>PATH`.
        let args = crate::base::alloc_array::<*mut u8>(6i64);
        (*args.add(0)) = c"git";
        (*args.add(1)) = c"ls-files";
        (*args.add(2)) = c"-s";
        (*args.add(3)) = c"-z";
        (*args.add(4)) = c"--";
        (*args.add(5)) = 0 as *mut u8;
        let listing = buf_new();
        let in_git = run_capture(args, listing) == 0;
        let info = buf_new();
        if in_git {
            let t = buf_slice(listing);
            // (the entries by path, for the moved ones)
            let mut i: i64 = 0;
            while i < t.len() as i64 {
                let mut e = i;
                while e < t.len() as i64 && t[e as usize] != 0 {
                    e += 1;
                }
                let mut tab = i;
                while tab < e && t[tab as usize] != b'\t' {
                    tab += 1;
                }
                if tab < e {
                    let path = &t[(tab + 1) as usize..e as usize];
                    for k in 0..from.len() as i64 {
                        if same_bytes(relative(here, (from[k as usize]) as *mut u8), path) {
                            // `MODE SHA` (the stage dropped), the new path
                            let mut sp = i;
                            let mut spaces: i64 = 0;
                            while sp < tab && spaces < 2 {
                                if t[sp as usize] == b' ' {
                                    spaces += 1;
                                }
                                sp += 1;
                            }
                            buf_str(info, c"0 0000000000000000000000000000000000000000\t");
                            buf_bytes(info, path);
                            buf_byte(info, 0);
                            buf_bytes(info, &t[i as usize..(sp - 1) as usize]);
                            buf_byte(info, b'\t');
                            buf_bytes(info, relative(here, (to[k as usize]) as *mut u8));
                            buf_byte(info, 0);
                            break;
                        }
                    }
                }
                i = e + 1;
            }
        }
        for k in 0..from.len() as i64 {
            let a = (from[k as usize]) as *mut u8;
            let b = (to[k as usize]) as *mut u8;
            if file_exists(b, pcx) {
                let d = diag(c"error", c"rewrite.exists", tcx);
                buf_str(d, c"'");
                buf_str(d, b);
                buf_str(d, c"' exists already; nothing moved\n");
                return false;
            }
        }
        if (*get_bufs().add(info as usize)).len > 0 {
            let u = crate::base::alloc_array::<*mut u8>(5i64);
            (*u.add(0)) = c"git";
            (*u.add(1)) = c"update-index";
            (*u.add(2)) = c"-z";
            (*u.add(3)) = c"--index-info";
            (*u.add(4)) = 0 as *mut u8;
            if run_with_stdin(u, info) != 0 {
                let d = diag(c"error", c"rewrite.git", tcx);
                buf_str(d, c"git update-index could not move the index's entries; nothing moved\n");
                return false;
            }
        }
        let mut ok = true;
        // (0.24) A link to a file of the old extension (`pty.vl ->
        // ../core/pty.vl`) moved to the new one points at the new one too:
        // the file it names moves in the same edit; git adds it again
        let mut relinked = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..from.len() as i64 {
            let a = (from[k as usize]) as *mut u8;
            let b = (to[k as usize]) as *mut u8;
            let target = crate::tools::proc::link_target(a);
            if !make_parent(b) || !rename_file(a, b) {
                cannot_write(b, tcx);
                ok = false;
                continue;
            }
            remove_empty_dirs(a);
            if target >= 0 {
                let re = relinked_target(buf_slice(target), c_slice(a), c_slice(b));
                if re != 0 as *mut u8 {
                    remove_file(b);
                    if !crate::tools::proc::make_link(re, b) {
                        cannot_write(b, tcx);
                        ok = false;
                    }
                    relinked.push(b as i64);
                }
            }
        }
        if in_git && relinked.len() as i64 > 0 {
            let g = crate::base::alloc_array::<*mut u8>(relinked.len() as i64 + 5);
            (*g.add(0)) = c"git";
            (*g.add(1)) = c"add";
            (*g.add(2)) = c"--";
            for k in 0..relinked.len() as i64 {
                (*g.add((3 + k) as usize)) = (relinked[k as usize]) as *mut u8;
            }
            (*g.add((3 + relinked.len() as i64) as usize)) = 0 as *mut u8;
            let out = buf_new();
            run_capture(g, out);
        }
        ok
    }
}

// Path p (a C string) relative to directory `here` (absolute) when it
// is under it, else as it is.
fn relative(here: *mut u8, p: *mut u8) -> &'static [u8] {
    let h = c_slice(here);
    let s = c_slice(p);
    if s.len() as i64 > h.len() as i64 + 1 && s[h.len()] == b'/'
        && same_bytes(&s[0..h.len()], h) {
        return &s[(h.len() as i64 + 1) as usize..];
    }
    s
}

// Writes the edit (W_*, M_*): the moves, then each file's new text (a
// copy, renamed onto it), journaled as one edit with `summary`, from the
// checkout around `from`. False after the diagnostics.
pub fn write_edit(summary: &[u8], from: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // (0.25.5: not a generated file, unless --force)
        for k in 0..tcx.w_path.len() as i64 {
            if !crate::tools::edit::apply::not_generated(
                c_slice((tcx.w_path[k as usize]) as *mut u8),
                buf_slice((tcx.w_before[k as usize])), tcx, pcx) {
                return false;
            }
        }
        if tcx.m_from.len() as i64 > 0 && !move_files(tcx.m_from, tcx.m_to, tcx, pcx) {
            return false;
        }
        for k in 0..tcx.w_path.len() as i64 {
            let p = (tcx.w_path[k as usize]) as *mut u8;
            let written = write_file_if(copy_path(p, pcx),
                buf_slice((tcx.w_after[k as usize])));
            if written {
                let copy_path_v = copy_path(p, pcx);
                crate::tools::proc::keep_mode(p, copy_path_v);
            }
            if !written {
                for x in 0..k + 1 {
                    remove_file(copy_path((tcx.w_path[x as usize]) as *mut u8, pcx));
                }
                cannot_write(p, tcx);
                return false;
            }
        }
        journal_moves(from, tcx.w_path, tcx.w_before, tcx.w_after, tcx.m_from, tcx.m_to, summary,
            tcx, pcx);
        let mut ok = true;
        for k in 0..tcx.w_path.len() as i64 {
            let p = (tcx.w_path[k as usize]) as *mut u8;
            let copy_path_v1 = copy_path(p, pcx);
            let rename_file_v = rename_file(copy_path_v1, p);
            if !rename_file_v {
                cannot_write(p, tcx);
                ok = false;
            }
        }
        ok
    }
}

// `PATH<TAB>N matches` (` <- OLD` when moved; `<TAB>K lines kept`), a
// line of the per-file summary, into out.
pub fn put_file_line(out: i64, path: &[u8], moved_from: &[u8], n: i64, kept: i64) {
    buf_bytes(out, path);
    if moved_from.len() > 0 {
        buf_str(out, c" <- ");
        buf_bytes(out, moved_from);
    }
    buf_byte(out, b'\t');
    buf_int(out, n);
    buf_str(out, if n == 1 { c" match" } else { c" matches" });
    if kept > 0 {
        buf_byte(out, b'\t');
        buf_int(out, kept);
        buf_str(out, if kept == 1 { c" line kept" } else { c" lines kept" });
    }
    buf_byte(out, b'\n');
}

pub fn flush(out: i64) {
    buf_write_fd(out, STDOUT);
}

// Whether path p names an existing file (a C string made of bytes).
pub fn exists(p: &[u8], pcx: &Ctx<Comp>) -> bool {
    let b = buf_new();
    buf_bytes(b, p);
    file_exists(buf_cstr(b), pcx)
}
