// The build before and after a rename of files (0.21, `refactor
// extension`): each program compiled to assembly (-S) before the edit and
// after it, up to N compilations at once, and compared byte for byte:
// the assembly, what the compiler printed, its exit status. The paths of
// the renamed files are the one thing allowed to differ: in what was
// printed, and in the assembly's data strings (the table of source files
// under `Lrt.files`, which panics name their file by; the messages of
// contracts and asserts, `x.vl:15:5`): a data string of the build before
// is the same when it is, or when it is with OLD at the end of a path read
// as NEW. Anything else that differs (a length in code) does.

use crate::base::{IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::tools::proc::{
    buf_cstr, make_dirs, read_file_if, same_bytes, spawn_to_file, wait_any, write_file_if,
};

// `DIR/N.EXT`.
fn job_file(dir: *mut u8, n: i64, ext: *mut u8) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    buf_byte(b, b'/');
    buf_int(b, n);
    buf_str(b, ext);
    buf_cstr(b)
}

// Compiles each of `roots` (C strings) into DIR/N.s, what it printed into
// DIR/N.out and its exit status into DIR/N.status, `jobs` at once; false
// when DIR cannot be made.
pub fn compile_all(roots: IntVec, dir: *mut u8, jobs: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !make_dirs(dir) {
            return false;
        }
        let n = roots.len() as i64;
        let pids = crate::base::alloc_array::<i64>(n + 1);
        let status = crate::base::alloc_array::<i64>(n + 1);
        let mut next: i64 = 0;
        let mut running: i64 = 0;
        while next < n || running > 0 {
            while next < n && running < jobs {
                let args = crate::base::alloc_array::<*mut u8>(7i64);
                (*args.add(0)) = pcx.prog;
                (*args.add(1)) = (roots[next as usize]) as *mut u8;
                (*args.add(2)) = c"-S";
                (*args.add(3)) = c"-o";
                (*args.add(4)) = job_file(dir, next, c".s");
                (*args.add(5)) = c"--diagnostics=human";
                (*args.add(6)) = 0 as *mut u8;
                let pid = spawn_to_file(args, job_file(dir, next, c".out"));
                (*pids.add(next as usize)) = pid;
                (*status.add(next as usize)) = if pid < 0 { 127 } else { -1 };
                if pid >= 0 {
                    running += 1;
                }
                next += 1;
            }
            if running == 0 {
                break;
            }
            let mut st: i64 = 0;
            let pid = wait_any(&mut st);
            if pid < 0 {
                break;
            }
            for j in 0..next {
                if (*pids.add(j as usize)) == pid && (*status.add(j as usize)) < 0 {
                    (*status.add(j as usize)) = st;
                    running -= 1;
                    break;
                }
            }
        }
        for j in 0..n {
            let b = buf_new();
            buf_int(b, (*status.add(j as usize)));
            write_file_if(job_file(dir, j, c".status"), buf_slice(b));
        }
        true
    }
}

fn is_alnum(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')
}

// t with each OLD that ends a word (no letter or digit after it) read as
// NEW, into buffer out.
fn put_renamed(out: i64, t: &[u8], old: &[u8], new: &[u8]) {
    let mut i: i64 = 0;
    let mut at: i64 = 0;
    while i + old.len() as i64 <= t.len() as i64 {
        let e = i + old.len() as i64;
        if t[i as usize] == old[0] && same_bytes(&t[i as usize..e as usize], old)
            && (e == t.len() as i64 || !is_alnum(t[e as usize])) {
            buf_bytes(out, &t[at as usize..i as usize]);
            buf_bytes(out, new);
            i = e;
            at = i;
        } else {
            i += 1;
        }
    }
    buf_bytes(out, &t[at as usize..]);
}

// The bytes of a `.byte A,B,C` line, into buffer out; false when l is
// none.
fn byte_line(l: &[u8], out: i64) -> bool {
    let mut i: i64 = 0;
    while i < l.len() as i64 && (l[i as usize] == b' ' || l[i as usize] == b'\t') {
        i += 1;
    }
    if l.len() as i64 - i < 6 || !same_bytes(&l[i as usize..(i + 6) as usize], b".byte ") {
        return false;
    }
    i += 6;
    let mut v: i64 = 0;
    let mut digits: i64 = 0;
    while i <= l.len() as i64 {
        if i < l.len() as i64 && l[i as usize] >= b'0' && l[i as usize] <= b'9' {
            v = v * 10 + (l[i as usize] - b'0') as i64;
            digits += 1;
        } else if i == l.len() as i64 || l[i as usize] == b',' {
            if digits == 0 {
                return false;
            }
            buf_byte(out, v as u8);
            v = 0;
            digits = 0;
        } else if l[i as usize] != b' ' {
            return false;
        }
        i += 1;
    }
    true
}

// The items of assembly t: each line, but a run of `.byte` lines (a data
// string, in lines of 16) is one item, its bytes; into texts (buffers),
// with whether each is data, and its first line.
fn asm_items(t: &[u8], texts: &mut IntVec, data: &mut IntVec, lines: &mut IntVec) {
    unsafe {
        let mut i: i64 = 0;
        let mut line: i64 = 1;
        let mut run: i64 = -1;
        while i < t.len() as i64 {
            let mut e = i;
            while e < t.len() as i64 && t[e as usize] != b'\n' {
                e += 1;
            }
            let bytes = buf_new();
            if byte_line(&t[i as usize..e as usize], bytes) {
                if run >= 0 {
                    buf_bytes((texts[run as usize]), buf_slice(bytes));
                } else {
                    run = texts.len() as i64;
                    texts.push(bytes);
                    data.push(1);
                    lines.push(line);
                }
            } else {
                run = -1;
                let b = buf_new();
                buf_bytes(b, &t[i as usize..e as usize]);
                texts.push(b);
                data.push(0);
                lines.push(line);
            }
            line += 1;
            i = e + 1;
        }
    }
}

// Whether the assembly before the rename (b) and after it (a) are the
// same, item by item, a data string also when its renamed paths are all
// that differ (OLD at the end of a path read as NEW: the source files'
// table, the places messages name); -1 then, else the line of a where
// they first differ.
fn same_asm(b: &[u8], a: &[u8], old: &[u8], new: &[u8]) -> i64 {
    unsafe {
        let mut bt = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut bd = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut bl = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut at = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ad = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut al = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        asm_items(b, &mut bt, &mut bd, &mut bl);
        asm_items(a, &mut at, &mut ad, &mut al);
        let n = if bt.len() as i64 < at.len() as i64 { bt.len() as i64 } else { at.len() as i64 };
        for k in 0..n {
            let x = buf_slice((bt[k as usize]));
            let y = buf_slice((at[k as usize]));
            if (bd[k as usize]) != (ad[k as usize]) {
                return (al[k as usize]);
            }
            if same_bytes(x, y) {
                continue;
            }
            if (bd[k as usize]) == 1 {
                let r = buf_new();
                put_renamed(r, x, old, new);
                if same_bytes(buf_slice(r), y) {
                    continue;
                }
            }
            return (al[k as usize]);
        }
        if bt.len() as i64 != at.len() as i64 {
            return if n < al.len() as i64 { (al[n as usize]) } else { al.len() as i64 + 1 };
        }
        -1
    }
}

fn read_or_empty(path: *mut u8) -> i64 {
    let b = buf_new();
    read_file_if(path, b);
    b
}

// Compilation n before (in dir `before`) and after (`after`): 0 the same,
// paths aside; else 1, and `why` says what differs (`exit status`,
// `printed`, or `assembly, line L`).
pub fn compare_one(before: *mut u8, after: *mut u8, n: i64, old: &[u8], new: &[u8], why: i64) -> i64 {
    let sb = read_or_empty(job_file(before, n, c".status"));
    let sa = read_or_empty(job_file(after, n, c".status"));
    if !same_bytes(buf_slice(sb), buf_slice(sa)) {
        buf_str(why, c"exit status ");
        buf_bytes(why, buf_slice(sb));
        buf_str(why, c" before, ");
        buf_bytes(why, buf_slice(sa));
        buf_str(why, c" after");
        return 1;
    }
    let ob = read_or_empty(job_file(before, n, c".out"));
    let oa = read_or_empty(job_file(after, n, c".out"));
    let ob2 = buf_new();
    put_renamed(ob2, buf_slice(ob), old, new);
    if !same_bytes(buf_slice(ob2), buf_slice(oa)) {
        buf_str(why, c"what the compiler printed");
        return 1;
    }
    let ab = read_or_empty(job_file(before, n, c".s"));
    let aa = read_or_empty(job_file(after, n, c".s"));
    let line = same_asm(buf_slice(ab), buf_slice(aa), old, new);
    if line < 0 {
        return 0;
    }
    buf_str(why, c"assembly, line ");
    buf_int(why, line);
    1
}

// Whether the text of file p has a `mod` item (a module tree's root).
pub fn has_mod_lines(t: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i + 4 < t.len() as i64 {
        if i == 0 || t[(i - 1) as usize] == b'\n' {
            let mut j = i;
            if j + 4 < t.len() as i64 && t[j as usize] == b'p' && t[(j + 1) as usize] == b'u'
                && t[(j + 2) as usize] == b'b'
                && t[(j + 3) as usize] == b' ' {
                j += 4;
            }
            if j + 4 < t.len() as i64 && t[j as usize] == b'm' && t[(j + 1) as usize] == b'o'
                && t[(j + 2) as usize] == b'd'
                && t[(j + 3) as usize] == b' ' {
                return true;
            }
        }
        i += 1;
    }
    false
}

// The number of processors (4 when it cannot be told).
pub fn processors() -> i64 {
    unsafe {
        let args = crate::base::alloc_array::<*mut u8>(3i64);
        (*args.add(0)) = c"getconf";
        (*args.add(1)) = c"_NPROCESSORS_ONLN";
        (*args.add(2)) = 0 as *mut u8;
        let out = buf_new();
        if crate::tools::proc::run_capture(args, out) != 0 {
            return 4;
        }
        let t = buf_slice(out);
        let mut n: i64 = 0;
        let mut i: i64 = 0;
        while i < t.len() as i64 && t[i as usize] >= b'0' && t[i as usize] <= b'9' {
            n = n * 10 + (t[i as usize] - b'0') as i64;
            i += 1;
        }
        if n < 1 { 4 } else { n }
    }
}

// Removes DIR and its N.s, N.out, N.status files (n of each).
pub fn clean(dir: *mut u8, n: i64) {
    for j in 0..n {
        crate::tools::proc::remove_file(job_file(dir, j, c".s"));
        crate::tools::proc::remove_file(job_file(dir, j, c".out"));
        crate::tools::proc::remove_file(job_file(dir, j, c".status"));
    }
    crate::tools::proc::remove_dir(dir);
}
