// The places of a vole source's bytes (0.21): code, a comment or a string
// (or character) literal, an f-string's text pieces too, as the lexer
// reads the file alone (fmt's pieces: tokens and comments). A file that
// does not lex has no places: its matches are not taken.

use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::{Tok, init_lexer};
use crate::tools::ctx::Tcx;
use crate::tools::fmt::pieces::{BLOCK_COMMENT, LINE_COMMENT, bad_message, read_pieces};
use crate::tools::query::grep::{G_CODE, G_COMMENT, G_STRING};

// Reads the pieces of source text t; false when it does not lex (its
// brackets need not balance).
pub fn read_places(t: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if !tcx.lexer_ready {
        init_lexer(pcx);
        // (a lexer's error names a file: one, when the program has none)
        if pcx.files.len() == 0 {
            crate::base::load_sources(0 as *mut *mut u8, 0, pcx);
            crate::base::add_source(c"<text>", crate::base::buf_new(), pcx, 0);
        }
        tcx.lexer_ready = true;
    }
    tcx.by_lines = false;
    if read_pieces(t, tcx, pcx) {
        return true;
    }
    let m = bad_message(tcx);
    // (the pieces are read when only the brackets are wrong)
    (m == b"unbalanced brackets" || m == b"unclosed bracket") && tcx.p_start.len() as i64 > 0
}

// (0.21) Reads source text t that does not lex (read_places false) by
// its lines: a match on a line that starts with `//` is in a comment.
pub fn read_lines(t: &[u8], tcx: &mut Tcx<Comp>) {
    // (0.27.0: match_in is given t)
    tcx.by_lines = true;
}

// In text t, read by lines: whether [s, e) is on one line after a `//`
// that starts it.
fn in_line_comment(t: &[u8], s: i64, e: i64) -> bool {
    let mut a = s;
    while a > 0 && t[(a - 1) as usize] != b'\n' {
        a -= 1;
    }
    for k in s..e {
        if t[k as usize] == b'\n' {
            return false;
        }
    }
    while a < s && (t[a as usize] == b' ' || t[a as usize] == b'\t') {
        a += 1;
    }
    a + 1 < s && t[a as usize] == b'/' && t[(a + 1) as usize] == b'/'
}

// The piece holding byte pos, or -1 (between pieces).
fn piece_at(pos: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let mut lo: i64 = 0;
        let mut hi = tcx.p_start.len() as i64;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if (tcx.p_start[mid as usize]) <= pos {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let i = lo - 1;
        if i >= 0 && pos < (tcx.p_end[i as usize]) { i } else { -1 }
    }
}

fn place_of_kind(k: i64) -> i64 {
    if k == LINE_COMMENT || k == BLOCK_COMMENT {
        return G_COMMENT;
    }
    if k == Tok::Str as i64 || k == Tok::CStr as i64 || k == Tok::Char as i64
        || k == Tok::FHead as i64 || k == Tok::FMid as i64 || k == Tok::FTail as i64 {
        return G_STRING;
    }
    G_CODE
}

// Whether the match [s, e) of text t, read, is in one of `places` (G_*
// bits): inside one comment or literal, or in code (tokens of code and
// the blanks between them: `a::b`).
pub fn match_in(t: &[u8], s: i64, e: i64, places: i64, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        if tcx.by_lines {
            return (places & G_COMMENT) != 0 && in_line_comment(t, s, e);
        }
        let i = piece_at(s, tcx);
        if i < 0 {
            return false;
        }
        let p = place_of_kind((tcx.p_kind[i as usize]));
        if (p & places) == 0 {
            return false;
        }
        if e <= (tcx.p_end[i as usize]) {
            return true;
        }
        if p != G_CODE {
            return false;
        }
        let mut j = i + 1;
        while j < tcx.p_start.len() as i64 && (tcx.p_start[j as usize]) < e {
            if place_of_kind((tcx.p_kind[j as usize])) != G_CODE {
                return false;
            }
            j += 1;
        }
        true
    }
}

// The places that hold matches (starts, ends) and the ones that do not:
// the number of matches in each of code, comments and strings, into
// counts[0..3].
pub fn count_places(starts: IntVec, ends: IntVec, counts: *mut i64, tcx: &Tcx<Comp>) {
    unsafe {
        for k in 0..starts.len() as i64 {
            let i = piece_at((starts[k as usize]), tcx);
            if i < 0 {
                continue;
            }
            let p = place_of_kind((tcx.p_kind[i as usize]));
            if p == G_CODE {
                (*counts.add(0)) += 1;
            } else if p == G_COMMENT {
                (*counts.add(1)) += 1;
            } else {
                (*counts.add(2)) += 1;
            }
        }
    }
}
