// `volec lsp` (0.24, docs/lsp.md): the language server, JSON-RPC over
// stdin and stdout (LSP's base protocol: `Content-Length` headers). It
// keeps the open documents' texts (full sync); the program is read by a
// worker (answer.vl), a copy of this process (fork) that reads it once,
// with those texts in place of the files, publishes its diagnostics and
// answers definition, references, hover, documentSymbol and (0.25)
// workspace/symbol from the tables the queries answer from; std's
// definitions are in std's text written as files (stdfiles.vl). After a change (debounced, DEBOUNCE_MS)
// or a save the worker is replaced by one that reads the program again;
// a request that comes first replaces it at once.
//
// Requests are answered in order, one at a time: a request is handed to
// the worker and its answer forwarded before the next message is read
// (the worker's diagnostics are forwarded as they come). The root is the
// nearest `main.vl` above the document (ROOT_STEM, SOURCE_EXT; up to a
// repository's top or the home directory), else the document itself
// (0.25.2: root_of): the program the tools ask about; one program at a
// time. A document that cannot be checked gets a note (publish_note).
// (0.25.2) The project's settings (vole.includePaths, vole.cSources)
// come from the client: set_paths.

use std::alloc::Arena;

use crate::base::{
    IntVec, STDERR, STDOUT, alloc_array, alloc_zeroed, buf_byte, buf_bytes, buf_clear, buf_fmt,
    buf_new, buf_slice, buf_str, cstr, get_bufs, getcwd, getenv, write,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::json::buf_json_str;
use crate::front::embed::wgsl::WgslCx;
use crate::front::stdtree::is_std_tree;
use crate::tools::ctx::Tcx;
use crate::tools::lsp::json::{at_path, elements, int_at, is_true, member, raw, str_at, str_into};
use crate::tools::lsp::stdfiles::is_std_path;
use crate::tools::proc::{buf_cstr, read_file_if, write_file_if};
use crate::tools::query::{c_slice, parse_digits};

pub mod json;
mod answer;
mod complete;
mod format;
pub mod stdfiles;
mod words;

// The extension of the language's files, and so of the root every tool
// looks for (ROOT_STEM then it): the one place it is written.
pub const SOURCE_EXT: *mut u8 = c".vl";
const ROOT_STEM: *mut u8 = c"main";
// How long after the last change the program is read again (ms).
const DEBOUNCE_MS: i64 = 150;
const POLLIN: i32 = 1;

extern "C" {
    fn poll(fds: *mut i32, n: u64, timeout: i32) -> i32;
    fn fork() -> i32;
    fn pipe(fds: *mut i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn read(fd: i32, buf: *mut u8, n: u64) -> i64;
    fn kill(pid: i32, sig: i32) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn gettimeofday(tv: *mut i64, tz: *mut u8) -> i32;
    fn getpid() -> i32;
    fn access(path: *mut u8, mode: i32) -> i32;
    fn signal(sig: i32, handler: *mut u8) -> *mut u8;
    fn mkdir(path: *mut u8, mode: i32) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn rmdir(path: *mut u8) -> i32;
}

// ---- the server's state

// The time in microseconds.
pub fn now_us(pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.tv == 0 as *mut i64 {
            pcx.tv = alloc_array::<i64>(2i64);
        }
        (*pcx.tv.add(0)) = 0;
        (*pcx.tv.add(1)) = 0;
        gettimeofday(pcx.tv, 0 as *mut u8);
        (*pcx.tv.add(0)) * 1000000 + ((*pcx.tv.add(1)) & 4294967295)
    }
}

// Writes all of bytes to fd.
pub fn write_all(fd: i32, bytes: &[u8]) {
    unsafe {
        let mut at: i64 = 0;
        while at < bytes.len() as i64 {
            let n = write(fd, bytes.ptr.add(at as usize), (bytes.len() as i64 - at) as u64);
            if n <= 0 {
                return;
            }
            at += n;
        }
    }
}

// A message to the client, with its header.
fn send_message(body: &[u8]) {
    let head = buf_new();
    buf_fmt(head, format_args("Content-Length: {}\r\n\r\n", body.len() as i64));
    write_all(STDOUT, buf_slice(head));
    write_all(STDOUT, body);
}

fn respond(id: &[u8], result: &[u8]) {
    let b = buf_new();
    buf_str(b, c"{\"jsonrpc\":\"2.0\",\"id\":");
    buf_bytes(b, id);
    buf_str(b, c",\"result\":");
    buf_bytes(b, result);
    buf_byte(b, b'}');
    send_message(buf_slice(b));
}

fn respond_error(id: &[u8], code: i64, message: &[u8]) {
    let b = buf_new();
    buf_str(b, c"{\"jsonrpc\":\"2.0\",\"id\":");
    buf_bytes(b, id);
    buf_fmt(b, format_args(",\"error\":{{\"code\":{code},\"message\":"));
    buf_json_str(b, message);
    buf_str(b, c"}}");
    send_message(buf_slice(b));
}

// ---- paths

fn hex_digit(c: u8) -> i64 {
    if c >= b'0' && c <= b'9' { (c - b'0') as i64 }
    else if c >= b'a' && c <= b'f' { (c - b'a') as i64 + 10 }
    else if c >= b'A' && c <= b'F' { (c - b'A') as i64 + 10 } else { -1 }
}

// The path of a file:// URI (percent-decoded), empty for another URI.
fn uri_path(uri: &[u8]) -> &[u8] {
    let b = buf_new();
    if uri.len() < 7 || &uri[0..7] != b"file://" {
        return buf_slice(b);
    }
    let mut i: i64 = 7;
    while i < uri.len() as i64 {
        let c = uri[i as usize];
        if c == b'%' && i + 2 < uri.len() as i64 && hex_digit(uri[(i + 1) as usize]) >= 0
            && hex_digit(uri[(i + 2) as usize]) >= 0 {
            buf_byte(b,
                (hex_digit(uri[(i + 1) as usize]) * 16 + hex_digit(uri[(i + 2) as usize])) as u8);
            i += 3;
        } else {
            buf_byte(b, c);
            i += 1;
        }
    }
    buf_slice(b)
}

// The root of the program file path belongs to (a buffer): the nearest
// ROOT_STEM + SOURCE_EXT (`main.vl`) in its directory or one above, the
// search stopping at the top of a repository (a directory holding `.git`)
// or at the home directory, whichever comes first: a `main.vl` above them
// is another project's. With none, the file itself (0.25.2): a program
// of one file, as `volec check FILE` reads it. -1 for a path with no
// directory, a file neither on disk nor open, or one of std's source
// (in_std_tree).
pub fn root_of(path: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut end = path.len() as i64;
    while end > 0 && path[(end - 1) as usize] != b'/' {
        end -= 1;
    }
    if end == 0 {
        return -1;
    }
    let home = home_dir();
    // path[0..end] is a directory with its `/`
    loop {
        let cand = buf_new();
        buf_bytes(cand, &path[0..end as usize]);
        buf_str(cand, ROOT_STEM);
        buf_str(cand, SOURCE_EXT);
        if path_exists(buf_slice(cand)) {
            return cand;
        }
        if end <= 1 || search_stops_at(&path[0..end as usize], buf_slice(home)) {
            break;
        }
        end -= 1;
        while end > 0 && path[(end - 1) as usize] != b'/' {
            end -= 1;
        }
        if end == 0 {
            break;
        }
    }
    // (a file that is neither on disk nor open, or one of std's source in
    // the vole repository: none)
    if !path_exists(path) && doc_index(path, tcx) < 0 || in_std_tree(path, pcx) {
        return -1;
    }
    let own = buf_new();
    buf_bytes(own, path);
    own
}

// Whether the search for a root stops at directory dir (with its `/`):
// the top of a repository, or the home directory (home: $HOME, empty
// when it is not set).
fn search_stops_at(dir: &[u8], home: &[u8]) -> bool {
    let git = buf_new();
    buf_bytes(git, dir);
    buf_str(git, c".git");
    if path_exists(buf_slice(git)) {
        return true;
    }
    let mut h = home;
    while h.len() > 1 && h[(h.len() as i64 - 1) as usize] == b'/' {
        h = &h[0..(h.len() as i64 - 1) as usize];
    }
    h.len() > 0 && dir.len() as i64 == h.len() as i64 + 1 && dir[0..h.len()] == h
}

// Whether a file or a directory is at path (std::fs: stat).
fn path_exists(path: &[u8]) -> bool {
    std::fs::metadata(str::from_utf8(path).unwrap()).is_ok()
}

// $HOME (a buffer; empty when it is not set).
fn home_dir() -> i64 {
    let b = buf_new();
    // UNSAFE: getenv is C's, through base (std::env reads the environment
    // into an allocator's memory; the compiler has no std allocator).
    // SAFETY: the name is a NUL-terminated literal; getenv returns null or
    // a NUL-terminated string the environment owns, copied at once (the
    // server never changes its environment).
    let home = unsafe { getenv(c"HOME") };
    if home != 0 as *mut u8 {
        buf_bytes(b, cstr(home));
    }
    b
}

// The server's working directory (a buffer; empty when it cannot be
// read).
pub fn cwd_dir() -> i64 {
    let b = buf_new();
    let cwd = alloc_zeroed(4096);
    // UNSAFE: getcwd is C's, through base (std::env::current_dir_in needs a
    // std allocator; the compiler has none).
    // SAFETY: cwd is 4096 zeroed bytes and 4096 is the size given: getcwd
    // writes at most that, NUL-terminated, or returns null (then cwd is
    // not read).
    let got = unsafe { getcwd(cwd, 4096) };
    if got != 0 as *mut u8 {
        buf_bytes(b, cstr(cwd));
    }
    b
}

// Whether the file at path is one of std's source files (in the vole
// repository: under a directory holding std.vl and embed.sh,
// compiler/std): std is no program of its own, but read with one.
fn in_std_tree(path: &[u8], pcx: &Ctx<Comp>) -> bool {
    let mut end = path.len() as i64;
    loop {
        while end > 0 && path[(end - 1) as usize] != b'/' {
            end -= 1;
        }
        if end <= 1 {
            return false;
        }
        let dir = buf_new();
        buf_bytes(dir, &path[0..(end - 1) as usize]);
        if is_std_tree(buf_cstr(dir), pcx) {
            return true;
        }
        end -= 1;
    }
}

// ---- documents

// ---- the project's settings (0.25.2)

// The workspace's directory onto b (the server's own when there is none).
fn put_ws_root(b: i64, tcx: &Tcx<Comp>) {
    if tcx.ws_root >= 0 && buf_slice(tcx.ws_root).len() > 0 {
        buf_bytes(b, buf_slice(tcx.ws_root));
        return;
    }
    buf_bytes(b, buf_slice(cwd_dir()));
}

// The directory a setting's path p names (a buffer, empty for an empty
// p): `${workspaceFolder}` and a relative path from the workspace's
// directory, `~/` from the home directory.
fn setting_path(p: &[u8], tcx: &Tcx<Comp>) -> i64 {
    let b = buf_new();
    let wf = "${workspaceFolder}";
    if p.len() == 0 {
        return b;
    }
    if p.len() >= wf.len() && p[0..wf.len()] == wf.as_bytes() {
        put_ws_root(b, tcx);
        buf_bytes(b, &p[wf.len()..p.len()]);
    } else if p[0] == b'~' && (p.len() == 1 || p[1] == b'/') {
        buf_bytes(b, buf_slice(home_dir()));
        buf_bytes(b, &p[1..p.len()]);
    } else if p[0] == b'/' {
        buf_bytes(b, p);
    } else {
        put_ws_root(b, tcx);
        buf_byte(b, b'/');
        buf_bytes(b, p);
    }
    b
}

// The paths of the JSON array at `at` in msg, a setting of paths (which:
// 0 vole.includePaths, 1 vole.cSources; from initializationOptions or a
// workspace/didChangeConfiguration's settings): the include paths are
// the directories `import "header.h"` searches first, as a build's -I
// (C_INCLUDE_DIRS, C strings), the C sources the C files the program is
// built with (C_SOURCES, buffers: where go to definition finds a C
// function's body); both the worker's when it reads the program, read
// again when they changed. Not an array: no change.
fn set_paths(msg: &[u8], at: i64, which: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut items = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    if !elements(msg, at, &mut items) {
        return;
    }
    let given = buf_new();
    for i in 0..items.count {
        str_into(msg, items.get(i), given);
        buf_byte(given, b'\n');
    }
    let before = if which == 0 { tcx.inc_given } else { tcx.src_given };
    if before >= 0 && buf_slice(before) == buf_slice(given) || before < 0 && items.count == 0 {
        return;
    }
    let mut paths = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..items.count {
        let p = buf_new();
        str_into(msg, items.get(i), p);
        let full = setting_path(buf_slice(p), tcx);
        if buf_slice(full).len() > 0 {
            paths.push(if which == 0 { buf_cstr(full) as i64 } else { full });
        }
    }
    if which == 0 {
        tcx.inc_given = given;
        tcx.c_include_dirs = paths;
    } else {
        tcx.src_given = given;
        tcx.c_sources = paths;
    }
    if tcx.root >= 0 {
        mark_dirty(0, tcx, pcx);
    }
}

fn doc_index(path: &[u8], tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        for i in 0..tcx.doc_path.count {
            if buf_slice((*tcx.doc_path.data.add(i as usize))) == path {
                return i;
            }
        }
        -1
    }
}

// Whether text is not what the file at path holds.
fn differs_from_disk(path: &[u8], text: &[u8], tcx: &mut Tcx<Comp>) -> bool {
    if tcx.disk < 0 {
        tcx.disk = buf_new();
        tcx.disk_path = buf_new();
    }
    buf_clear(tcx.disk_path);
    buf_bytes(tcx.disk_path, path);
    buf_clear(tcx.disk);
    !read_file_if(buf_cstr(tcx.disk_path), tcx.disk) || buf_slice(tcx.disk) != text
}

// The document at path (opened when it is not) gets the text of the JSON
// string at `at` in msg, decoded into its buffer; that text.
fn set_doc<'a>(path: &'a [u8], msg: &'a [u8], at: i64, tcx: &mut Tcx<Comp>) -> &'a [u8] {
    unsafe {
        let mut i = doc_index(path, tcx);
        if i < 0 {
            i = tcx.doc_path.count;
            let p = buf_new();
            buf_bytes(p, path);
            tcx.doc_path.push(p);
            tcx.doc_text.push(buf_new());
            let c = buf_new();
            buf_bytes(c, buf_slice(tcx.tmp_dir));
            buf_fmt(c, format_args("/doc{}", tcx.doc_seq));
            buf_str(c, SOURCE_EXT);
            tcx.doc_seq += 1;
            tcx.doc_copy.push(c);
            tcx.doc_fresh.push(0);
        }
        let t = (*tcx.doc_text.data.add(i as usize));
        buf_clear(t);
        str_into(msg, at, t);
        (*tcx.doc_fresh.data.add(i as usize)) = 0;
        buf_slice(t)
    }
}

fn close_doc(path: &[u8], tcx: &mut Tcx<Comp>) {
    unsafe {
        let i = doc_index(path, tcx);
        if i < 0 {
            return;
        }
        unlink(buf_cstr((*tcx.doc_copy.data.add(i as usize))));
        let last = tcx.doc_path.count - 1;
        (*tcx.doc_path.data.add(i as usize)) = (*tcx.doc_path.data.add(last as usize));
        (*tcx.doc_text.data.add(i as usize)) = (*tcx.doc_text.data.add(last as usize));
        (*tcx.doc_copy.data.add(i as usize)) = (*tcx.doc_copy.data.add(last as usize));
        (*tcx.doc_fresh.data.add(i as usize)) = (*tcx.doc_fresh.data.add(last as usize));
        tcx.doc_path.count = last;
        tcx.doc_text.count = last;
        tcx.doc_copy.count = last;
        tcx.doc_fresh.count = last;
    }
}

// The program changes: read again `after` ms from now (sooner when it
// was already due).
fn mark_dirty(after: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let t = now_us(pcx) + after * 1000;
    if !tcx.dirty || t < tcx.deadline {
        tcx.deadline = t;
    }
    tcx.dirty = true;
}

// The root for path is the program's (another program: the worker
// replaced); false when path is in no program. (0.25.2) A file of std's
// is the program's own: std is read with it, not as a program.
fn use_root(path: &[u8], tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if is_std_path(path) {
        return tcx.root >= 0;
    }
    let r = root_of(path, tcx, pcx);
    if r < 0 {
        return false;
    }
    if tcx.root < 0 || buf_slice(tcx.root) != buf_slice(r) {
        tcx.root = r;
        mark_dirty(0, tcx, pcx);
    }
    true
}

// ---- the worker

fn stop_worker(tcx: &mut Tcx<Comp>) {
    unsafe {
        if tcx.w_pid > 0 {
            kill(tcx.w_pid, 9);
            let mut st = 0 as i32;
            waitpid(tcx.w_pid, &mut st, 0);
            close(tcx.w_in);
            close(tcx.w_out);
        }
        tcx.w_pid = -1;
        buf_clear(tcx.w_buf);
        tcx.w_at = 0;
        // (a batch cut short: its URIs are shown)
        for i in 0..tcx.coming.count {
            tcx.shown.push((*tcx.coming.data.add(i as usize)));
            tcx.shown_root.push(tcx.w_root);
        }
        tcx.coming.count = 0;
    }
}

// The worker kept for completion, stopped.
fn stop_spare(tcx: &mut Tcx<Comp>) {
    unsafe {
        if tcx.g_pid > 0 {
            kill(tcx.g_pid, 9);
            let mut st = 0 as i32;
            waitpid(tcx.g_pid, &mut st, 0);
            close(tcx.g_in);
            close(tcx.g_out);
        }
        tcx.g_pid = -1;
        if tcx.g_buf >= 0 {
            buf_clear(tcx.g_buf);
        }
    }
}

// The worker ended by itself (its pipe closed).
fn worker_gone(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        if tcx.w_pid > 0 && !tcx.w_published && tcx.w_root >= 0 {
            // (0.25.2: it ended before its diagnostics: never silence)
            for i in 0..tcx.coming.count {
                tcx.shown.push(tcx.coming.get(i));
                tcx.shown_root.push(tcx.w_root);
            }
            tcx.coming.count = 0;
            note_stopped(tcx, pcx);
        }
        if tcx.w_pid > 0 {
            let mut st = 0 as i32;
            waitpid(tcx.w_pid, &mut st, 0);
            close(tcx.w_in);
            close(tcx.w_out);
        }
        tcx.w_pid = -1;
        buf_clear(tcx.w_buf);
        tcx.w_at = 0;
    }
}

// A new worker for the program as it is now (the documents' texts in
// their copies).
fn start_worker(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    unsafe {
        if tcx.w_pid > 0 && tcx.w_state == 1 {
            // (0.25.1: kept for completion until the new one is ready)
            stop_spare(tcx);
            tcx.g_pid = tcx.w_pid;
            tcx.g_in = tcx.w_in;
            tcx.g_out = tcx.w_out;
            tcx.g_root = tcx.w_root;
            tcx.w_pid = -1;
        }
        stop_worker(tcx);
        tcx.w_state = 0;
        tcx.w_root = tcx.root;
        tcx.w_published = false;
        tcx.dirty = false;
        if tcx.root < 0 {
            return;
        }
        pcx.overlay.count = 0;
        for i in 0..tcx.doc_path.count {
            if (*tcx.doc_fresh.data.add(i as usize)) == 0 {
                write_file_if(buf_cstr((*tcx.doc_copy.data.add(i as usize))),
                    buf_slice((*tcx.doc_text.data.add(i as usize))));
                (*tcx.doc_fresh.data.add(i as usize)) = 1;
            }
            pcx.overlay.push(buf_cstr((*tcx.doc_path.data.add(i as usize))) as i64);
            pcx.overlay.push(buf_cstr((*tcx.doc_copy.data.add(i as usize))) as i64);
        }
        let a = alloc_array::<i32>(2i64);
        let b = alloc_array::<i32>(2i64);
        if pipe(a) != 0 || pipe(b) != 0 {
            return;
        }
        let pid = fork();
        if pid == 0 {
            close((*a.add(1)));
            close((*b.add(0)));
            // (nothing but the server writes the client's stdout)
            dup2(STDERR, STDOUT);
            crate::tools::lsp::answer::serve(buf_cstr(tcx.root), (*a.add(0)), (*b.add(1)),
                tcx.lsp_utf8, tcx, pcx, wgx);
        }
        close((*a.add(0)));
        close((*b.add(1)));
        if pid < 0 {
            close((*a.add(1)));
            close((*b.add(0)));
            return;
        }
        tcx.w_pid = pid;
        tcx.w_in = (*a.add(1));
        tcx.w_out = (*b.add(0));
    }
}

// Handles the whole frames the worker wrote: notifications forwarded (the
// URIs with diagnostics noted; at the end of a batch, the ones it no
// longer has cleared), responses forwarded. Whether there was a response.
fn worker_frames(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut responded = false;
    loop {
        let s = buf_slice(tcx.w_buf);
        let mut nl = tcx.w_at;
        while nl < s.len() as i64 && s[nl as usize] != b'\n' {
            nl += 1;
        }
        if nl >= s.len() as i64 || nl < tcx.w_at + 3 {
            break;
        }
        let kind = s[tcx.w_at as usize];
        let len = parse_digits(&s[(tcx.w_at + 2) as usize..nl as usize]);
        if nl + 1 + len > s.len() as i64 {
            break;
        }
        let body = &s[(nl + 1) as usize..(nl + 1 + len) as usize];
        tcx.w_at = nl + 1 + len;
        if kind == b'r' {
            send_message(body);
            responded = true;
        } else if kind == b'n' {
            send_message(body);
            let u = buf_new();
            str_into(body, at_path(body, 0, b"params.uri"), u);
            tcx.coming.push(u);
        } else if kind == b'e' {
            clear_stale(tcx);
            // (0.25.2) the open documents the program has no file of
            tcx.w_published = true;
            for i in 0..tcx.doc_path.count {
                note_if_unchecked(buf_slice(tcx.doc_path.get(i)), tcx, pcx);
            }
        } else if kind == b'f' {
            // (0.25.2) the program's files
            tcx.p_files = buf_new();
            buf_bytes(tcx.p_files, body);
            tcx.p_files_root = tcx.w_root;
        } else if kind == b'l' {
            // (ready: the one kept before it is not needed)
            tcx.w_state = 1;
            stop_spare(tcx);
        } else if kind == b'b' {
            tcx.w_state = 2;
        }
    }
    if tcx.w_at > 0 && tcx.w_at == buf_slice(tcx.w_buf).len() as i64 {
        buf_clear(tcx.w_buf);
        tcx.w_at = 0;
    }
    responded
}

// Empty diagnostics for the URIs shown before (from the program of the
// batch just published, W_ROOT) and not in that batch; (0.25.2) the
// ones of another program are kept, until it is read again.
fn clear_stale(tcx: &mut Tcx<Comp>) {
    let mut kept = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let mut kept_root = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..tcx.shown.count {
        let u = buf_slice(tcx.shown.get(i));
        let mut coming = false;
        for j in 0..tcx.coming.count {
            if buf_slice(tcx.coming.get(j)) == u {
                coming = true;
            }
        }
        let mut again = false;
        for j in 0..i {
            if buf_slice(tcx.shown.get(j)) == u {
                again = true;
            }
        }
        if coming || again {
            continue;
        }
        if !same_root(tcx.shown_root.get(i), tcx.w_root) {
            kept.push(tcx.shown.get(i));
            kept_root.push(tcx.shown_root.get(i));
            continue;
        }
        let b = buf_new();
        buf_str(b, c"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":");
        buf_json_str(b, u);
        buf_str(b, c",\"diagnostics\":[]}}");
        send_message(buf_slice(b));
    }
    tcx.shown = kept;
    tcx.shown_root = kept_root;
    for j in 0..tcx.coming.count {
        tcx.shown.push(tcx.coming.get(j));
        tcx.shown_root.push(tcx.w_root);
    }
    tcx.coming.count = 0;
}

// Whether roots a and b (buffers, -1: none) are the same.
fn same_root(a: i64, b: i64) -> bool {
    a >= 0 && b >= 0 && buf_slice(a) == buf_slice(b)
}

// (0.25.2) Never silence: a document that is not checked gets one note
// (an information diagnostic at its start) saying why and what to do;
// its URI (uri: a path when is_path) is then shown, from program root
// (-1: none, not cleared by a batch).
fn publish_note(uri: &[u8], is_path: bool, code: &[u8], text: &[u8], root: i64, tcx: &mut Tcx<Comp>) {
    let u = buf_new();
    if is_path {
        crate::tools::lsp::answer::put_uri(u, uri);
    } else {
        buf_bytes(u, uri);
    }
    let b = buf_new();
    buf_str(b,
        c"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":");
    buf_json_str(b, buf_slice(u));
    buf_str(b, c",\"diagnostics\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}},\"severity\":3,\"code\":");
    buf_json_str(b, code);
    buf_str(b, c",\"source\":\"volec\",\"message\":");
    buf_json_str(b, text);
    buf_str(b, c"}]}}");
    send_message(buf_slice(b));
    if root >= 0 {
        tcx.shown.push(u);
        tcx.shown_root.push(root);
    }
}

// Whether the program the worker read (its files: P_FILES) has the file
// at path.
fn in_program(path: &[u8], tcx: &Tcx<Comp>) -> bool {
    let s = buf_slice(tcx.p_files);
    let mut at: i64 = 0;
    while at < s.len() as i64 {
        let mut e = at;
        while e < s.len() as i64 && s[e as usize] != b'\n' {
            e += 1;
        }
        if &s[at as usize..e as usize] == path {
            return true;
        }
        at = e + 1;
    }
    false
}

// The note of an open document of program W_ROOT that the program has no
// file of (no `mod` item reaches it), if path is one.
fn note_if_unchecked(path: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.p_files < 0 || !same_root(tcx.p_files_root, tcx.w_root) || is_std_path(path)
        || in_program(path, tcx) {
        return;
    }
    if !same_root(root_of(path, tcx, pcx), tcx.w_root) {
        return;
    }
    let mut k = path.len() as i64;
    while k > 0 && path[(k - 1) as usize] != b'/' {
        k -= 1;
    }
    let mut stem = &path[k as usize..];
    if stem.len() > 3 && stem[(stem.len() as i64 - 3) as usize..] == b".vl" {
        stem = &stem[0..(stem.len() as i64 - 3) as usize];
    }
    let t = buf_new();
    buf_str(t, c"not checked: this file is not a module of the program ");
    buf_bytes(t, buf_slice(tcx.w_root));
    buf_fmt(t,
        { let stem = str::from_utf8(stem).unwrap(); format_args(" (no `mod {stem};` reaches it)\nhelp: add `mod {stem};` to the module above it, or check it alone: volec check ") });
    buf_bytes(t, path);
    publish_note(path, true, b"lsp.not-in-program", buf_slice(t), tcx.w_root, tcx);
}

// (0.25.2) The worker ended before it published the diagnostics (it
// crashed reading the program): a note on each open document of its
// program.
fn note_stopped(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..tcx.doc_path.count {
        let p = buf_slice(tcx.doc_path.get(i));
        if is_std_path(p) || !same_root(root_of(p, tcx, pcx), tcx.w_root) {
            continue;
        }
        let t = buf_new();
        buf_str(t, c"not checked: volec stopped while reading the program ");
        buf_bytes(t, buf_slice(tcx.w_root));
        buf_str(t, c" (an internal error)\nhelp: `volec check ");
        buf_bytes(t, buf_slice(tcx.w_root));
        buf_str(t, c"` shows where; the next change reads it again");
        publish_note(p, true, b"lsp.stopped", buf_slice(t), tcx.w_root, tcx);
    }
}

// Reads what the worker wrote; false when it ended.
fn read_worker(chunk: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let got = read(tcx.w_out, chunk, 65536);
        if got <= 0 {
            worker_gone(tcx, pcx);
            return false;
        }
        buf_bytes(tcx.w_buf,
            std::slice::from_raw_parts(chunk.add((0) as usize), (got - (0)) as usize));
        true
    }
}

// A request for the worker: handed to it (a new one when the program
// changed), its response forwarded.
fn ask_worker(method: *mut u8, id: &[u8], msg: &[u8], params: i64, empty: *mut u8, chunk: *mut u8,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
    // (0.25: a file of std's, stdfiles.vl: asked of the program read)
    let of_std = path.len() > 0 && tcx.root >= 0 && is_std_path(path);
    if path.len() == 0 || !of_std && !use_root(path, tcx, pcx) {
        respond(id, c_slice(empty));
        return;
    }
    if superseded(path, chunk, tcx) {
        respond_error(id, -32801, b"content modified");
        return;
    }
    let line = int_at(msg, at_path(msg, params, b"position.line"), 0);
    let ch = int_at(msg, at_path(msg, params, b"position.character"), 0);
    let decl = is_true(msg, at_path(msg, params, b"context.includeDeclaration"));
    let req = buf_new();
    buf_str(req, method);
    buf_byte(req, b'\t');
    buf_bytes(req, path);
    buf_fmt(req, format_args("\t{line}\t{ch}\t{}\t", if decl { 1 } else { 0 }));
    buf_bytes(req, id);
    buf_byte(req, b'\n');
    hand_to_worker(id, buf_slice(req), chunk, tcx, pcx, wgx);
}

// workspace/symbol (0.25): the query asked of the program read (none
// yet: no symbols).
fn ask_symbols(id: &[u8], msg: &[u8], params: i64, chunk: *mut u8, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    if tcx.root < 0 {
        respond(id, b"[]");
        return;
    }
    let q = buf_new();
    str_into(msg, member(msg, params, b"query"), q);
    let req = buf_new();
    buf_str(req, c"workspaceSymbol\t");
    let s = buf_slice(q);
    for i in 0..s.len() {
        buf_byte(req, if s[i] == b'\t' || s[i] == b'\n' || s[i] == b'\r' { b' ' } else { s[i] });
    }
    buf_str(req, c"\t0\t0\t0\t");
    buf_bytes(req, id);
    buf_byte(req, b'\n');
    hand_to_worker(id, buf_slice(req), chunk, tcx, pcx, wgx);
}

// Hands request line req to the worker (a new one when the program
// changed), its response forwarded.
fn hand_to_worker(id: &[u8], req: &[u8], chunk: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) {
    if tcx.dirty || tcx.w_pid < 0 {
        start_worker(tcx, pcx, wgx);
    }
    if tcx.w_pid < 0 {
        respond_error(id, -32603, b"the worker could not start");
        return;
    }
    write_all(tcx.w_in, req);
    loop {
        if worker_frames(tcx, pcx) {
            return;
        }
        if !read_worker(chunk, tcx, pcx) {
            respond_error(id, -32603, b"the worker ended (volec check shows why)");
            return;
        }
    }
}

// textDocument/formatting, rangeFormatting (0.25.1, format.vl): the
// document's text (an open one's as the editor has it) formatted as `volec
// fmt` does; no edits when it does not parse.
fn formatting(id: &[u8], msg: &[u8], params: i64, ranged: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
        let mut text = &path[0..0];
        let i = doc_index(path, tcx);
        if i >= 0 {
            text = buf_slice((*tcx.doc_text.data.add(i as usize)));
        } else if path.len() > 0 && !differs_from_disk(path, b"", tcx) {
            text = &path[0..0];
        } else if path.len() > 0 {
            text = buf_slice(tcx.disk);
        }
        if text.len() == 0 {
            respond(id, b"[]");
            return;
        }
        let mut ranges = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if ranged {
            let r = member(msg, params, b"range");
            ranges.push(crate::tools::lsp::format::text_offset(text,
                int_at(msg, at_path(msg, r, b"start.line"), 0),
                int_at(msg, at_path(msg, r, b"start.character"), 0), tcx.lsp_utf8));
            ranges.push(crate::tools::lsp::format::text_offset(text,
                int_at(msg, at_path(msg, r, b"end.line"), 0),
                int_at(msg, at_path(msg, r, b"end.character"), 0), tcx.lsp_utf8));
        }
        let out = buf_new();
        crate::tools::lsp::format::put_formatting(out, text, &mut ranges, buf_slice(tcx.tmp_dir),
            tcx.lsp_utf8, tcx, pcx);
        respond(id, buf_slice(out));
    }
}

// textDocument/completion (0.25.1, complete.vl), and signatureHelp
// (help): the document's text
// handed to a worker ready to answer: the current one when it is, else
// the one kept from before the last change (its program a change or more
// behind; completion reads the text itself), else the current one, waited
// for. The program is not read again for it.
fn completion(id: &[u8], msg: &[u8], params: i64, chunk: *mut u8, help: bool, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    unsafe {
        let empty = if help { "null" } else { "{\"isIncomplete\":false,\"items\":[]}" };
        let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
        if path.len() == 0 || !use_root(path, tcx, pcx) {
            respond(id, empty.as_bytes());
            return;
        }
        let i = doc_index(path, tcx);
        let mut text = &path[0..0];
        if i >= 0 {
            text = buf_slice((*tcx.doc_text.data.add(i as usize)));
        } else if differs_from_disk(path, b"", tcx) {
            text = buf_slice(tcx.disk);
        }
        let line = int_at(msg, at_path(msg, params, b"position.line"), 0);
        let ch = int_at(msg, at_path(msg, params, b"position.character"), 0);
        let req = buf_new();
        buf_str(req, if help { c"signatureHelp\t" } else if tcx.snippet_ok { c"completion+s\t" }
            else { c"completion\t" });
        buf_bytes(req, path);
        buf_fmt(req, format_args("\t{line}\t{ch}\t{}\t", text.len() as i64));
        buf_bytes(req, id);
        buf_byte(req, b'\n');
        buf_bytes(req, text);
        ask_ready(id, buf_slice(req), -1, chunk, tcx, pcx, wgx);
    }
}

// completionItem/resolve (0.25.1): the item handed to a worker ready to
// answer (as completion's), which adds its documentation: the hover of
// the definition its data names by path.
fn resolve(id: &[u8], msg: &[u8], params: i64, chunk: *mut u8, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    let item = raw(msg, params);
    if tcx.root < 0 || member(msg, params, b"data") < 0 {
        respond(id, item);
        return;
    }
    let req = buf_new();
    buf_fmt(req, format_args("completionResolve\t-\t0\t0\t{}\t", item.len() as i64));
    buf_bytes(req, id);
    buf_byte(req, b'\n');
    buf_bytes(req, item);
    ask_ready(id, buf_slice(req), -1, chunk, tcx, pcx, wgx);
}

// Hands req to the worker ready to answer it (which: 1 the kept one; -1:
// the current one if ready, else the kept one, else the current one).
fn ask_ready(id: &[u8], req: &[u8], which: i64, chunk: *mut u8, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) {
    let current = tcx.w_pid > 0 && tcx.w_state == 1;
    let spare = tcx.g_pid > 0 && tcx.g_root >= 0 && tcx.root >= 0
        && buf_slice(tcx.g_root) == buf_slice(tcx.root);
    if which == 1 || which < 0 && !current && spare {
        ask_spare(id, req, chunk, tcx);
        return;
    }
    if tcx.w_pid < 0 {
        start_worker(tcx, pcx, wgx);
    }
    if tcx.w_pid < 0 {
        respond_error(id, -32603, b"the worker could not start");
        return;
    }
    write_all(tcx.w_in, req);
    loop {
        if worker_frames(tcx, pcx) {
            return;
        }
        if !read_worker(chunk, tcx, pcx) {
            respond_error(id, -32603, b"the worker ended (volec check shows why)");
            return;
        }
    }
}

// Hands req to the kept worker; its response forwarded.
fn ask_spare(id: &[u8], req: &[u8], chunk: *mut u8, tcx: &mut Tcx<Comp>) {
    unsafe {
        if tcx.g_buf < 0 {
            tcx.g_buf = buf_new();
        }
        buf_clear(tcx.g_buf);
        write_all(tcx.g_in, req);
        loop {
            // (only responses: its diagnostics were read before it was kept)
            let s = buf_slice(tcx.g_buf);
            let mut nl: i64 = 0;
            while nl < s.len() as i64 && s[nl as usize] != b'\n' {
                nl += 1;
            }
            if nl < s.len() as i64 && nl >= 3 {
                let len = parse_digits(&s[2..nl as usize]);
                if nl + 1 + len <= s.len() as i64 {
                    if s[0] == b'r' {
                        send_message(&s[(nl + 1) as usize..(nl + 1 + len) as usize]);
                        buf_clear(tcx.g_buf);
                        return;
                    }
                    // (another frame: dropped)
                    let rest = buf_new();
                    buf_bytes(rest, &s[(nl + 1 + len) as usize..]);
                    buf_clear(tcx.g_buf);
                    buf_bytes(tcx.g_buf, buf_slice(rest));
                    continue;
                }
            }
            let got = read(tcx.g_out, chunk, 65536);
            if got <= 0 {
                stop_spare(tcx);
                respond_error(id, -32603, b"the worker ended (volec check shows why)");
                return;
            }
            buf_bytes(tcx.g_buf,
                std::slice::from_raw_parts(chunk.add((0) as usize), (got - (0)) as usize));
        }
    }
}

// ---- messages

fn initialize(id: &[u8], msg: &[u8], params: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut encs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        elements(msg, at_path(msg, params, b"capabilities.general.positionEncodings"), &mut encs);
        for i in 0..encs.count {
            if str_at(msg, (*encs.data.add(i as usize))) == b"utf-8" {
                tcx.lsp_utf8 = true;
            }
        }
        // (0.25.2) the workspace's directory, the include paths
        let mut ws = uri_path(str_at(msg, at_path(msg, params, b"rootUri")));
        if ws.len() == 0 {
            let mut folders = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            if elements(msg, member(msg, params, b"workspaceFolders"), &mut folders)
                && folders.count > 0 {
                ws = uri_path(str_at(msg, member(msg, folders.get(0), b"uri")));
            }
        }
        if ws.len() > 0 {
            tcx.ws_root = buf_new();
            buf_bytes(tcx.ws_root, ws);
        }
        set_paths(msg, at_path(msg, params, b"initializationOptions.includePaths"), 0, tcx, pcx);
        set_paths(msg, at_path(msg, params, b"initializationOptions.cSources"), 1, tcx, pcx);
        tcx.snippet_ok = is_true(msg,
            at_path(msg, params,
                b"capabilities.textDocument.completion.completionItem.snippetSupport"));
        let r = buf_new();
        buf_str(r, c"{\"capabilities\":{\"positionEncoding\":");
        buf_str(r, if tcx.lsp_utf8 { c"\"utf-8\"" } else { c"\"utf-16\"" });
        buf_str(r, c",\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":true}}");
        buf_str(r,
            c",\"definitionProvider\":true,\"referencesProvider\":true,\"hoverProvider\":true");
        buf_str(r, c",\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true");
        buf_str(r,
            c",\"documentFormattingProvider\":true,\"documentRangeFormattingProvider\":true");
        buf_str(r,
            c",\"completionProvider\":{\"triggerCharacters\":[\".\",\":\"],\"resolveProvider\":true}");
        buf_str(r, c",\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}");
        buf_str(r, c"},\"serverInfo\":{\"name\":\"volec\",\"version\":\"");
        buf_str(r, crate::version());
        buf_str(r, c"\"}}");
        respond(id, buf_slice(r));
    }
}

// Handles one message; false after `exit`.
fn handle(msg: &[u8], chunk: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> bool {
    unsafe {
        let method = str_at(msg, member(msg, 0, b"method"));
        let idv = member(msg, 0, b"id");
        let id = raw(msg, idv);
        let params = member(msg, 0, b"params");
        let t0 = now_us(pcx);
        if method == b"initialize" {
            initialize(id, msg, params, tcx, pcx);
        } else if method == b"shutdown" {
            tcx.shut = true;
            respond(id, b"null");
        } else if method == b"exit" {
            return false;
        } else if method == b"textDocument/didOpen" {
            let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
            if path.len() > 0 {
                let text = set_doc(path, msg, at_path(msg, params, b"textDocument.text"), tcx);
                let known = tcx.root >= 0;
                if use_root(path, tcx, pcx)
                    && (known && differs_from_disk(path, text, tcx) || tcx.w_pid < 0) {
                    mark_dirty(0, tcx, pcx);
                }
                if !tcx.dirty && tcx.w_published {
                    // (0.25.2: one the program read has no file of)
                    note_if_unchecked(path, tcx, pcx);
                }
                if in_std_tree(path, pcx) {
                    publish_note(path, true, b"lsp.std-source",
                        b"not checked alone: a file of std's source, read with a program (the vole repository's tools read std from these files when they were edited)\nhelp: open a program that uses it, or check one: volec check ROOT", -1, tcx);
                }
            } else {
                // (0.25.2) an unsaved document (untitled:): never silence
                let uri = str_at(msg, at_path(msg, params, b"textDocument.uri"));
                if uri.len() > 0 {
                    publish_note(uri, false, b"lsp.not-a-file",
                        b"not checked: volec checks files on disk\nhelp: save this document as a .vl file (a program of its own, or a module of one: `mod NAME;` in its main.vl)", -1, tcx);
                }
            }
        } else if method == b"textDocument/didChange" {
            let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
            let mut changes = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            elements(msg, member(msg, params, b"contentChanges"), &mut changes);
            if path.len() > 0 && changes.count > 0 {
                set_doc(path, msg,
                    member(msg, (*changes.data.add((changes.count - 1) as usize)), b"text"), tcx);
                if use_root(path, tcx, pcx) {
                    mark_dirty(DEBOUNCE_MS, tcx, pcx);
                }
            }
        } else if method == b"textDocument/didSave" {
            let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
            let tv = member(msg, params, b"text");
            if path.len() > 0 {
                if tv >= 0 && doc_index(path, tcx) >= 0 {
                    set_doc(path, msg, tv, tcx);
                }
                if use_root(path, tcx, pcx) {
                    mark_dirty(0, tcx, pcx);
                }
            }
        } else if method == b"textDocument/didClose" {
            let path = uri_path(str_at(msg, at_path(msg, params, b"textDocument.uri")));
            let i = doc_index(path, tcx);
            if i >= 0 {
                let unsaved = differs_from_disk(path,
                    buf_slice((*tcx.doc_text.data.add(i as usize))), tcx);
                close_doc(path, tcx);
                if unsaved && use_root(path, tcx, pcx) {
                    mark_dirty(DEBOUNCE_MS, tcx, pcx);
                }
            }
        } else if method == b"workspace/didChangeConfiguration" {
            // (0.25.2) {"settings":{"vole":{"includePaths":[..],"cSources":[..]}}}
            let mut vole = at_path(msg, params, b"settings.vole");
            if vole < 0 {
                vole = member(msg, params, b"settings");
            }
            if vole >= 0 {
                set_paths(msg, member(msg, vole, b"includePaths"), 0, tcx, pcx);
                set_paths(msg, member(msg, vole, b"cSources"), 1, tcx, pcx);
            }
        } else if method == b"textDocument/definition" {
            ask_worker(c"definition", id, msg, params, c"null", chunk, tcx, pcx, wgx);
        } else if method == b"textDocument/references" {
            ask_worker(c"references", id, msg, params, c"[]", chunk, tcx, pcx, wgx);
        } else if method == b"textDocument/hover" {
            ask_worker(c"hover", id, msg, params, c"null", chunk, tcx, pcx, wgx);
        } else if method == b"textDocument/documentSymbol" {
            ask_worker(c"documentSymbol", id, msg, params, c"[]", chunk, tcx, pcx, wgx);
        } else if method == b"workspace/symbol" {
            ask_symbols(id, msg, params, chunk, tcx, pcx, wgx);
        } else if method == b"textDocument/completion" {
            completion(id, msg, params, chunk, false, tcx, pcx, wgx);
        } else if method == b"textDocument/signatureHelp" {
            completion(id, msg, params, chunk, true, tcx, pcx, wgx);
        } else if method == b"completionItem/resolve" {
            resolve(id, msg, params, chunk, tcx, pcx, wgx);
        } else if method == b"textDocument/formatting" {
            formatting(id, msg, params, false, tcx, pcx);
        } else if method == b"textDocument/rangeFormatting" {
            formatting(id, msg, params, true, tcx, pcx);
        } else if idv >= 0 && method.len() > 0 {
            let m = buf_new();
            buf_str(m, c"unknown method ");
            buf_bytes(m, method);
            respond_error(id, -32601, buf_slice(m));
        }
        if tcx.timing && idv >= 0 {
            let us = now_us(pcx) - t0;
            let line = buf_new();
            buf_str(line, c"lsp: ");
            buf_bytes(line, method);
            buf_fmt(line, format_args(" {}.{} ms\n", us / 1000, (us % 1000) / 100));
            write_all(STDERR, buf_slice(line));
        }
        true
    }
}

// The next whole message on stdin, handled: 1, 0 when there is none yet,
// -1 after `exit`.
fn next_message(chunk: *mut u8, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let s = buf_slice(tcx.in_);
    let mut body_at: i64 = 0;
    let mut next: i64 = 0;
    let len = frame_at(s, tcx.in_at, &mut body_at, &mut next);
    if len == -2 {
        return 0;
    }
    tcx.in_at = next;
    if len < 0 {
        // (no length: the header skipped)
        return 1;
    }
    // (a copy: handle may read more of stdin into IN)
    if tcx.msg < 0 {
        tcx.msg = buf_new();
    }
    buf_clear(tcx.msg);
    buf_bytes(tcx.msg, &s[body_at as usize..(body_at + len) as usize]);
    let more = handle(buf_slice(tcx.msg), chunk, tcx, pcx, wgx);
    if tcx.in_at == buf_slice(tcx.in_).len() as i64 {
        buf_clear(tcx.in_);
        tcx.in_at = 0;
    }
    if more { 1 } else { -1 }
}

// The message framed at `at` in s: its body's length (its start into
// *body_at, the next frame's into *next); -1 when the header has no
// length, -2 when the message is not all there yet.
fn frame_at(s: &[u8], at: i64, body_at: &mut i64, next: &mut i64) -> i64 {
    let mut e = at;
    while e + 3 < s.len() as i64
        && !(s[e as usize] == b'\r' && s[(e + 1) as usize] == b'\n' && s[(e + 2) as usize] == b'\r'
            && s[(e + 3) as usize] == b'\n') {
        e += 1;
    }
    if e + 3 >= s.len() as i64 {
        return -2;
    }
    let mut len: i64 = -1;
    let head = &s[at as usize..e as usize];
    let mut i: i64 = 0;
    while i < head.len() as i64 {
        let mut j = i;
        while j < head.len() as i64 && head[j as usize] != b'\r' {
            j += 1;
        }
        let l = &head[i as usize..j as usize];
        if l.len() > 15 && lower_eq(&l[0..15], b"content-length:") {
            len = int_at(l, 15, -1);
        }
        i = j + 2;
    }
    *body_at = e + 4;
    if len < 0 {
        *next = e + 4;
        return -1;
    }
    if e + 4 + len > s.len() as i64 {
        return -2;
    }
    *next = e + 4 + len;
    len
}

// Whether a change of the document at path waits on stdin (what is there
// read first): a request about it is then answered `content modified`
// (LSP's -32801), so that edits made faster than the program is read do
// not each read it.
fn superseded(path: &[u8], chunk: *mut u8, tcx: &mut Tcx<Comp>) -> bool {
    unsafe {
        loop {
            (*tcx.fds.add(0)) = 0;
            (*tcx.fds.add(1)) = POLLIN;
            if poll(tcx.fds, 1, 0) <= 0 || ((*tcx.fds.add(1)) >> 16) == 0 {
                break;
            }
            let got = read(0, chunk, 65536);
            if got <= 0 {
                break;
            }
            buf_bytes(tcx.in_,
                std::slice::from_raw_parts(chunk.add((0) as usize), (got - (0)) as usize));
        }
        let s = buf_slice(tcx.in_);
        let mut at = tcx.in_at;
        loop {
            let mut body_at: i64 = 0;
            let mut next: i64 = 0;
            let len = frame_at(s, at, &mut body_at, &mut next);
            if len == -2 {
                return false;
            }
            if len >= 0 {
                let m = &s[body_at as usize..(body_at + len) as usize];
                if raw(m, member(m, 0, b"method")) == b"\"textDocument/didChange\""
                    && uri_path(str_at(m, at_path(m, member(m, 0, b"params"), b"textDocument.uri")))
                    == path {
                    return true;
                }
            }
            at = next;
        }
    }
}

fn lower_eq(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        let c = if a[i] >= b'A' && a[i] <= b'Z' { a[i] + 32 as u8 } else { a[i] };
        if c != b[i] {
            return false;
        }
    }
    true
}

fn cleanup(tcx: &mut Tcx<Comp>) {
    unsafe {
        stop_spare(tcx);
        stop_worker(tcx);
        for i in 0..tcx.doc_copy.count {
            unlink(buf_cstr((*tcx.doc_copy.data.add(i as usize))));
        }
        rmdir(buf_cstr(tcx.tmp_dir));
    }
}

// `volec lsp`: serves until `exit` or the end of stdin; 0 after a
// shutdown, else 1 (as LSP says).
pub fn run_lsp(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    unsafe {
        // (`lsp --help`: help.vl; no options)
        // (a worker that ended: its pipe's writes fail, not the server)
        signal(13, 1 as *mut u8);
        let t = getenv(c"VOLE_LSP_TIME");
        tcx.timing = t != 0 as *mut u8 && (*t.add(0)) != 0;
        tcx.tmp_dir = buf_new();
        let tmp = getenv(c"TMPDIR");
        if tmp != 0 as *mut u8 && (*tmp.add(0)) != 0 {
            buf_str(tcx.tmp_dir, tmp);
            if buf_slice(tcx.tmp_dir)[(buf_slice(tcx.tmp_dir).len() as i64 - 1) as usize] == b'/' {
                (*get_bufs().add(tcx.tmp_dir as usize)).len -= 1;
            }
        } else {
            buf_str(tcx.tmp_dir, c"/tmp");
        }
        buf_fmt(tcx.tmp_dir, format_args("/volec-lsp-{}", getpid()));
        mkdir(buf_cstr(tcx.tmp_dir), 448);
        tcx.in_ = buf_new();
        tcx.w_buf = buf_new();
        tcx.fds = alloc_array::<i32>(4i64);
        let chunk = alloc_zeroed(65536);
        loop {
            let r = next_message(chunk, tcx, pcx, wgx);
            if r < 0 {
                cleanup(tcx);
                return if tcx.shut { 0 } else { 1 };
            }
            if r > 0 {
                continue;
            }
            let mut timeout: i64 = -1;
            if tcx.dirty && tcx.root >= 0 {
                let left = (tcx.deadline - now_us(pcx)) / 1000;
                timeout = if left < 0 { 0 } else { left };
            }
            (*tcx.fds.add(0)) = 0;
            (*tcx.fds.add(1)) = POLLIN;
            (*tcx.fds.add(2)) = tcx.w_out;
            (*tcx.fds.add(3)) = POLLIN;
            let n: i64 = if tcx.w_pid > 0 { 2 } else { 1 };
            poll(tcx.fds, n as u64, timeout as i32);
            if ((*tcx.fds.add(1)) >> 16) != 0 {
                let got = read(0, chunk, 65536);
                if got <= 0 {
                    cleanup(tcx);
                    return 1;
                }
                buf_bytes(tcx.in_,
                    std::slice::from_raw_parts(chunk.add((0) as usize), (got - (0)) as usize));
            }
            if n == 2 && ((*tcx.fds.add(3)) >> 16) != 0 && read_worker(chunk, tcx, pcx) {
                worker_frames(tcx, pcx);
            }
            if tcx.dirty && tcx.root >= 0 && now_us(pcx) >= tcx.deadline {
                start_worker(tcx, pcx, wgx);
            }
        }
    }
}
