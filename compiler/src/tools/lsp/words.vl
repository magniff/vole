// What a hover says of a word that names no item (0.25, docs/lsp.md): a
// keyword or a parameter's convention, an attribute, a primitive type.
// A line or two each, as the guide has them (`volec guide syntax`,
// `memory`, `contracts`, `effects`); the topic to read for more last.

// The text for keyword w (a convention, `self`, a contract's word), or
// an empty slice.
pub fn keyword_text(w: &[u8]) -> &'static [u8] {
    if w == b"let" {
        b"`let x = e;` binds a value that does not change. As a parameter's convention (the default: `x: T` is `x: let T`) the function only reads the argument: no copy, no `&` at the call. (`volec guide memory`)"
    } else if w == b"var" {
        b"`var x = e;` binds a variable that can change: `x = ..`, `x += ..`, `x.push(..)`. A method that changes its receiver needs a `var`. (`volec guide memory`)"
    } else if w == b"inout" {
        b"`x: inout T`: the function may change the caller's value, which the call marks `&v` (`grow(&v)`); `inout self` changes the receiver (a `var`, no `&`). `inout r = &st;` names an access to pass on. (`volec guide memory`)"
    } else if w == b"sink" {
        b"`x: sink T`: the function takes the value. An owned argument (`Vec`, `Buf`, `String`, a struct holding one) moves in and is dead after the call: pass `v.clone()` to keep it. `sink self` consumes the receiver; `sink || ..` is a closure that takes what it captures. (`volec guide memory`)"
    } else if w == b"fn" {
        b"`fn name(params) -> R { body }`: a function. Each parameter is `let` (read, the default), `inout` (changed: `&x` at the call) or `sink` (taken). (`volec guide language`)"
    } else if w == b"self" {
        b"`self`: the receiver of a method: `self` reads it, `inout self` changes it, `sink self` takes it. (`volec guide language`)"
    } else if w == b"Self" {
        b"`Self`: the type of the impl block or the trait it is written in."
    } else if w == b"requires" {
        b"`requires COND else \"message\"`: a precondition, between the signature and the body, checked at run time at each call: a failure prints `FILE:L:C: message` and exits 101. (`volec guide contracts`)"
    } else if w == b"ensures" {
        b"`ensures COND`: a postcondition, checked when the function returns; `result` is the value it returns. (`volec guide contracts`)"
    } else if w == b"result" {
        b"`result`: in an `ensures` clause, the value the function returns. (`volec guide contracts`)"
    } else if w == b"struct" {
        b"`struct S { x: T }`: a value type of named fields; `S { x: 1 }` makes one. (`volec guide types`)"
    } else if w == b"enum" {
        b"`enum E { A, B(T) }`: a type that is one of its variants, taken apart with `match`. (`volec guide types`)"
    } else if w == b"trait" {
        b"`trait T { fn f(self); }`: functions a type implements (`impl T for S`); a bound `<X: T>` asks for them. No `dyn`. (`volec guide traits`)"
    } else if w == b"impl" {
        b"`impl S { .. }`: the methods of a type; `impl Trait for S { .. }` implements a trait for it. (`volec guide traits`)"
    } else if w == b"use" {
        b"`use path::{a, b};` names items of another module here (never `*`); std's most used names need none. (`volec guide modules`)"
    } else if w == b"mod" {
        b"`mod name;` is the module in `name.vl` (or `name/mod.vl`); `mod name { .. }` one written here. (`volec guide modules`)"
    } else if w == b"pub" {
        b"`pub`: the item is visible outside its module. (`volec guide modules`)"
    } else if w == b"const" {
        b"`const N: T = e;`: a constant, computed at compile time."
    } else if w == b"static" {
        b"`static X: T = e;` a global value; `static var` one that changes (a `global` effect, never on another thread). (`volec guide effects`)"
    } else if w == b"match" {
        b"`match e { P => .., _ => .. }`: the arm of the first pattern that fits; every case must be covered. (`volec guide language`)"
    } else if w == b"unsafe" {
        b"`unsafe { .. }`: raw pointers and C calls, which safe code cannot make undefined; `unsafe fn` needs one at its calls. (`volec guide unsafe`)"
    } else if w == b"defer" {
        b"`defer stmt;` runs the statement when the block it is in ends, however it ends."
    } else if w == b"extern" {
        b"`extern \"C\" { fn f(..); }` declares C functions (called in `unsafe`); `extern \"C\" fn` defines one C can call. (`volec guide c-interop`)"
    } else if w == b"import" {
        b"`import \"h.h\" as c;` reads a C header: its names are `c::name`. (`volec guide c-interop`)"
    } else if w == b"type" {
        b"`type X = T;` another name for T; `type X = distinct T;` a type of its own with T's representation. (`volec guide types`)"
    } else if w == b"union" {
        b"`union U { .. }`: fields sharing their memory; reading one is `unsafe`. (`volec guide c-interop`)"
    } else if w == b"loop" {
        b"`loop { .. }` repeats until a `break` (`break value` gives the loop's value)."
    } else if w == b"while" {
        b"`while cond { .. }` repeats while cond holds; `while let P = e` while e fits P."
    } else if w == b"for" {
        b"`for x in e { .. }`: x takes each element of a range, slice, Vec or iterator. (`volec guide iterators`)"
    } else if w == b"return" {
        b"`return e;` leaves the function with e; a block's last expression is its value without one."
    } else if w == b"as" {
        b"`e as T` converts between numeric types (and a bool or a fieldless enum to an integer); only widening is implicit. (`volec guide conversions`)"
    } else if w == b"if" || w == b"else" {
        b"`if cond { a } else { b }`: an expression; `if let P = e { .. }` when e fits P."
    } else if w == b"in" {
        b"`for x in e`: what the loop goes over."
    } else if w == b"break" || w == b"continue" {
        b"`break` leaves the loop (`break value`, `break 'label`); `continue` goes on with its next turn."
    } else if w == b"move" {
        b"`move` is Rust's spelling: a closure that takes what it captures is `sink || ..`."
    } else {
        b""
    }
}

// The text for attribute a (`#[a]`, `#[a(..)]`), or an empty slice.
pub fn attribute_text(a: &[u8]) -> &'static [u8] {
    if a == b"derive" {
        b"`#[derive(Eq, Debug, ..)]` writes the impls of the traits named for the type: Eq, Ord, Hash, Clone, Debug, Default. (`volec guide traits`)"
    } else if a == b"test" {
        b"`#[test] fn`: a test, run by `volec test` at -O0 and -O2. (`volec guide testing`)"
    } else if a == b"property" {
        b"`#[property] fn p(x: T)`: a property, run on generated inputs (shrunk on a failure) by `volec test`. (`volec guide testing`)"
    } else if a == b"fuzz" {
        b"`#[fuzz] fn f(data: [u8])`: a fuzz target, run by `volec fuzz`. (`volec guide testing`)"
    } else if a == b"pure" {
        b"`#[pure]`: the function has no effect (no allocation, I/O, global, panic...); the checker holds it to that. (`volec guide effects`)"
    } else if a == b"effects" {
        b"`#[effects(io, alloc(A), ..)]`: the effects the function may have, and no other. (`volec guide effects`)"
    } else if a == b"no_alloc" || a == b"no_io" || a == b"no_panic" {
        b"`#[no_alloc]`, `#[no_io]`, `#[no_panic]`: the function has no such effect, checked. (`volec guide effects`)"
    } else if a == b"inline" || a == b"cold" {
        b"`#[inline]`, `#[inline(never)]`, `#[cold]`: hints for the optimizer."
    } else if a == b"repr" {
        b"`#[repr(C)]`: the struct or enum is laid out as C would; `#[repr(u8)]` an enum's tag type. (`volec guide c-interop`)"
    } else if a == b"link" {
        b"`#[link(\"name\")]` on an extern block links the library. (`volec guide c-interop`)"
    } else if a == b"link_name" {
        b"`#[link_name = \"sym\"]`: the C symbol of an extern item. (`volec guide c-interop`)"
    } else if a == b"thread_local" {
        b"`#[thread_local] static var X: T = e;` gives each thread its own X. (`volec guide threads`)"
    } else if a == b"cfg" {
        b"`#[cfg(test)]`: the item (a module's items) exists only in test builds. (`volec guide testing`)"
    } else if a == b"multiversion" || a == b"target_feature" {
        b"`#[target_feature(enable = \"..\")]` declares the CPU features a function needs; `#[multiversion(\"..\")]` compiles it once per feature set, chosen at run time. (`volec guide arch`)"
    } else if a == b"views" || a == b"stores" {
        b"`#[views(a, *b)]`, `#[stores(c)]`: pin a function's view summary (what its result views, what it stores); otherwise inferred. (`volec guide views`)"
    } else if a == b"sealed" {
        b"`#[sealed]`: the struct's fields not marked `pub` are hidden outside its module; no `S { .. }` there."
    } else if a == b"scoped" {
        b"`#[scoped]`: the type's values may not leave the closure that is given them (an arena's `ScopedArena`). (`volec guide allocators`)"
    } else if a == b"ambient" {
        b"`#[ambient]`: a std function that allocates from the program's Gpa without taking it (0.15's forms). (`volec guide allocators`)"
    } else {
        b""
    }
}

// The text for primitive type t, or an empty slice.
pub fn primitive_text(t: &[u8]) -> &'static [u8] {
    if t == b"i8" || t == b"i16" || t == b"i32" || t == b"i64" || t == b"isize" {
        b"A signed integer of that many bits (`isize`: 64). Every operation is defined: it wraps, `x / 0 == 0`; only widening converts implicitly. (`volec guide types`)"
    } else if t == b"u8" || t == b"u16" || t == b"u32" || t == b"u64" || t == b"usize" {
        b"An unsigned integer of that many bits (`usize`: 64; lengths and indices are `i64`). It wraps; `'a'` is a `u8`, text is `[u8]`. (`volec guide types`)"
    } else if t == b"f32" || t == b"f64" {
        b"An IEEE 754 float; literals are `f64`. (`volec guide types`)"
    } else if t == b"bool" {
        b"`true` or `false`; `b as i64` is 0 or 1."
    } else if t == b"str" {
        b"`str`: a parameter that takes text: a literal, a `[u8]` or a String's `&s`. (`volec guide text`)"
    } else {
        b""
    }
}

// The text for a closure bound's name (`F: Fn(i64) -> i64`), or an empty
// slice.
pub fn bound_text(w: &[u8]) -> &'static [u8] {
    if w == b"Fn" {
        b"`F: Fn(A) -> R`: a closure with that signature that assigns no captured variable, or a plain function `fn(A) -> R`. (`volec guide closures`)"
    } else if w == b"FnMut" {
        b"`F: FnMut(A) -> R`: any closure with that signature, or a plain function; called from a `sink F` parameter or a `var`. (`volec guide closures`)"
    } else {
        b""
    }
}
