use crate::tools::query::command_line::load_program;
use crate::tools::query::defs::{
    K_ALIAS, K_CONST, K_ENUM, K_FIELD, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STATIC, K_STRUCT,
    K_TRAIT, K_TRAIT_FN, K_VARIANT, def_of_node, kind_name, last_segment,
};
