    put_segment_path, segment_by_path, segment_from, segment_name, segment_of, segment_to,
    std_files_ready,
};
use crate::tools::lsp::words::{attribute_text, bound_text, keyword_text, primitive_text};
use crate::tools::proc::{buf_cstr, read_file_if};
