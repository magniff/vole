// What a hover shows of the effects' reasons, at most.
const WHY_MAX: i64 = 6;
const WHY_LINE_MAX: i64 = 140;

// The types a hover on a local or an expression shows, at most.
const TYPES_MAX: i64 = 6;

extern "C" {
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
    fn _exit(code: i32) -> !;
}

// ---- the loop

// Reads the program of root and answers on `output` the requests of
// `input` until it is closed; never returns.
pub fn serve(root: *u8, input: i32, output: i32, utf8: bool, tcx: inout Tcx<Comp>,
    pcx: inout Ctx<Comp>, wgx: inout WgslCx<Arena>) -> ! {
    unsafe {
        tcx.answer_utf8 = utf8;
        tcx.out_fd = output;
        pcx.prog = c"volec";
        tcx.root_given = root;
        // (0.25.2) where the declarations imported from C are
        pcx.c_keep_origins = true;
        let t0 = now_us(&pcx);
        tcx.loaded = load_program(root, 0, &tcx, &pcx, &wgx);
        lap("load", t0, tcx, &pcx);
        let t1 = now_us(&pcx);
        index_lines(&tcx, pcx);
        if tcx.loaded {
            // (0.25.2) the program's files, for the server's notes on the
            // documents it has none of
            let files = buf_new();
            for f in 0..pcx.files.len() {
                if pcx.files[f].path[0] != '<' {
                    buf_str(files, pcx.files[f].path);
                    buf_byte(files, '\n');
                }
            }
            send('f', buf_slice(files), tcx);
        }
        publish_diagnostics(tcx, &pcx);
        lap("diagnostics", t1, tcx, &pcx);
        // (what the requests look up, made before the first comes)
        if tcx.loaded {
            let t3 = now_us(&pcx);
            std_files_ready(&tcx, pcx);
            lap("std files", t3, tcx, &pcx);
            let t2 = now_us(&pcx);
            ensure_refs(&tcx, &pcx);
            local_named_at(0, &tcx, pcx);
            tcx.typed = alloc_array::<TypedIndex>(1);
            tcx.typed[0] = typed_index(pcx);
            crate::tools::lsp::complete::index_locals(tcx.local_decl, &tcx, pcx);
            lap("index", t2, tcx, &pcx);
        }
        // (0.25.1) ready: the server may keep this worker for completion
        // after the program changes (`l`; `b`: the program was not read)
        send(if tcx.loaded { 'l' } else { 'b' }, "", tcx);
        let pending = buf_new();
        let chunk = alloc_zeroed(65536);
        var from = 0;
        loop {
            // a whole line: answered (with the bytes after it that a
            // completion or resolve request carries: its FLAG field's count)
            let s = buf_slice(pending);
            var nl = from;
            while nl < s.len as i64 && s[nl] != '\n' {
                nl += 1;
            }
            if nl < s.len as i64 {
                let line = s[from..nl];
                let m = field(line, 0);
                var more = 0;
                if m.len >= 10 && m[0..10] == "completion" || m == "signatureHelp" {
                    more = parse_digits(field(line, 4));
                }
                if nl + 1 + more <= s.len as i64 {
                    answer_line(line, s[nl + 1..nl + 1 + more], &tcx, &pcx);
                    from = nl + 1 + more;
                    continue;
                }
            }
            let got = read(input, chunk, 65536);
            if got <= 0 {
                _exit(0);
            }
            buf_bytes(pending, chunk[0..got]);
        }
    }
}

// Writes a frame: kind, the body's length, the body.
fn send(kind: u8, body: [u8], tcx: Tcx<Comp>) {
    let head = buf_new();
    buf_byte(head, kind);
    buf_byte(head, ' ');
    buf_int(head, body.len as i64);
    buf_byte(head, '\n');
    write_all(tcx.out_fd, buf_slice(head));
    write_all(tcx.out_fd, body);
}

// The fields of a request line, split at its TABs (the last one, the id,
// to the end).
fn field(line: [u8], k: i64) -> [u8] {
    var start = 0;
    var n = 0;
    var i = 0;
    while i < line.len as i64 {
        if line[i] == '\t' && n < 5 {
            if n == k {
                return line[start..i];
            }
            n += 1;
            start = i + 1;
        }
        i += 1;
    }
    if n == k { line[start..] } else { line[0..0] }
}

fn answer_line(line: [u8], payload: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let t0 = now_us(&pcx);
    let method = field(line, 0);
    let path = field(line, 1);
    let ln = parse_digits(field(line, 2));
    let ch = parse_digits(field(line, 3));
    let flag = field(line, 4) == "1";
    let id = field(line, 5);
    let out = buf_new();
    buf_str(out, c"{\"jsonrpc\":\"2.0\",\"id\":");
    buf_bytes(out, id);
    buf_str(out, c",\"result\":");
    let f = if tcx.loaded { file_by_path(path, &tcx, pcx) } else { -1 };
    let pos = if f >= 0 { pos_at(f, ln, ch, tcx, pcx) } else { -1 };
    if method == "definition" {
        if pos >= 0 { put_definition(out, pos, &tcx, &pcx); } else { buf_str(out, c"null"); }
    } else if method == "references" {
        if pos >= 0 { put_references(out, pos, flag, &tcx, &pcx); } else { buf_str(out, c"[]"); }
    } else if method == "hover" {
        if pos >= 0 { put_hover(out, pos, &tcx, &pcx); } else { buf_str(out, c"null"); }
    } else if method == "documentSymbol" {
        if f >= 0 && f == tcx.std_f && tcx.ask_seg >= 0 {
            put_symbols(out, segment_from(tcx.ask_seg, tcx), segment_to(tcx.ask_seg, tcx), tcx,
                pcx);
        } else if f >= 0 {
            put_symbols(out, pcx.files[f].start, pcx.files[f].end, tcx, pcx);
        } else {
            buf_str(out, c"[]");
        }
    } else if method == "workspaceSymbol" {
        if tcx.loaded { put_workspace_symbols(out, path, tcx, pcx); } else { buf_str(out, c"[]"); }
    } else if method == "completion" || method == "completion+s" {
        // (0.25.1) the editor's text in the payload; f: its file, if the
        // program has it
        crate::tools::lsp::complete::put_completion(out, f, payload, ln, ch, tcx.answer_utf8,
            tcx.loaded, method == "completion+s", &tcx, &pcx);
    } else if method == "completionResolve" {
        put_resolve(out, payload, &tcx, &pcx);
    } else if method == "signatureHelp" {
        crate::tools::lsp::complete::put_signature_help(out, f, payload, ln, ch, tcx.answer_utf8,
            tcx.loaded, &tcx, &pcx);
    } else {
        buf_str(out, c"null");
    }
    buf_byte(out, '}');
    send('r', buf_slice(out), tcx);
    lap(method, t0, tcx, &pcx);
}

// completionItem/resolve (0.25.1): the item (JSON) with the hover of the
// definition its data names as its documentation.
fn put_resolve(out: i64, item: [u8], tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let path = buf_new();
    str_into(item, at_path(item, 0, "data.p"), path);
    let d = if tcx.loaded && buf_slice(path).len > 0 {
        crate::tools::lsp::complete::def_by_path(buf_slice(path), &tcx, pcx)
    } else {
        -1
    };
    let md = buf_new();
    if d >= 0 {
        hover_def(md, d, -1, &tcx, &pcx);
    }
    crate::tools::lsp::complete::put_resolved(out, item, d, buf_slice(md));
}

// With $VOLE_LSP_TIME, `lsp worker: WHAT N ms` (since t0) on stderr.
fn lap(what: [u8], t0: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if !tcx.timing {
        return;
    }
    let us = now_us(&pcx) - t0;
    let line = buf_new();
    buf_str(line, c"lsp worker: ");
    buf_bytes(line, what);
    buf_fmt(line, format_args(" {}.{} ms\n", us / 1000, (us % 1000) / 100));
    write_all(STDERR, buf_slice(line));
}

// ---- positions

// The line starts of every file (also of a program that did not parse).
fn index_lines(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    for f in 0..pcx.files.len() {
        tcx.first_line.push(tcx.answer_ls.count);
        tcx.answer_ls.push(pcx.files[f].start);
        for p in pcx.files[f].start..pcx.files[f].end {
            if SRC[p] == '\n' && p + 1 < pcx.files[f].end {
                tcx.answer_ls.push(p + 1);
            }
        }
    }
    tcx.first_line.push(tcx.answer_ls.count);
}

// The file of the program at path (as the front end read it), or -1; a
// file of std's (stdfiles.vl): std's text, ASK_SEG its segment. (0.26.2)
// An embedded block's .wgsl is -1: no vole answers there.
fn file_by_path(path: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    tcx.ask_seg = -1;
    for f in 0..pcx.files.len() as i64 {
        if cstr(pcx.files[f].path) == path {
            return if pcx.files[f].kind == SOURCE_VOLE { f } else { -1 };
        }
    }
    let k = segment_by_path(path, tcx);
    if k >= 0 {
        tcx.ask_seg = k;
        return tcx.std_f;
    }
    -1
}

// The index in LS of the line holding pos.
fn line_index(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let f = file_of_pos(pos, pcx);
        var lo = tcx.first_line.data[f];
        var hi = tcx.first_line.data[f + 1];
        while hi - lo > 1 {
            let mid = (lo + hi) / 2;
            if tcx.answer_ls.data[mid] <= pos { lo = mid; } else { hi = mid; }
        }
        lo
    }
}

// The segment of std's text position pos is shown in, or -1 (a position
// in a file of its own).
fn seg_at(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if tcx.std_f < 0 || pos < pcx.files[tcx.std_f].start || pos >= pcx.files[tcx.std_f].end {
        return -1;
    }
    segment_of(pos, tcx, pcx)
}

// The bytes of the UTF-8 sequence starting with c.
fn seq_len(c: u8) -> i64 {
    if c < 128 as u8 { 1 } else if c < 224 as u8 { 2 } else if c < 240 as u8 { 3 } else { 4 }
}

// The position of (line, character) in file f (from 0, the character in
// the position encoding), or -1; the end of the line when the character
// is past it.
fn pos_at(f: i64, line: i64, ch: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var first = tcx.first_line.data[f];
        var last = tcx.first_line.data[f + 1];
        var end = pcx.files[f].end;
        if f == tcx.std_f && tcx.ask_seg >= 0 {
            // (a file of std's: its segment's lines)
            first = line_index(segment_from(tcx.ask_seg, tcx), tcx, pcx);
            end = segment_to(tcx.ask_seg, tcx);
            if end < pcx.files[f].end {
                last = line_index(end, tcx, pcx);
            }
        }
        if line < 0 || first + line >= last {
            return -1;
        }
        var p = tcx.answer_ls.data[first + line];
        var units = 0;
        while p < end && SRC[p] != '\n' && units < ch {
            let n = seq_len(SRC[p]);
            units += if tcx.answer_utf8 { n } else if n == 4 { 2 } else { 1 };
            p += n;
        }
        if p > end { end } else { p }
    }
}

// `{"line":L,"character":C}` of position pos, its line counted from the
// line `first` (an index in LS).
fn put_position(out: i64, pos: i64, first: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let lo = line_index(pos, tcx, pcx);
        let ls = tcx.answer_ls.data[lo];
        var units = 0;
        var p = ls;
        while p < pos {
            let n = seq_len(SRC[p]);
            units += if tcx.answer_utf8 { n } else if n == 4 { 2 } else { 1 };
            p += n;
        }
        buf_fmt(out, format_args("{{\"line\":{},\"character\":{units}}}", lo - first));
    }
}

// The range from..to; in std's text, in from's segment (its file).
fn put_range(out: i64, from: i64, to: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        var a = from;
        var b = to;
        var first = 0;
        let k = seg_at(from, tcx, pcx);
        if k >= 0 {
            let s = segment_from(k, tcx);
            let e = segment_to(k, tcx) - 1;
            if a < s { a = s; }
            if a > e { a = e; }
            if b > e { b = e; }
            if b < a { b = a; }
            first = line_index(s, tcx, pcx);
        } else {
            first = tcx.first_line.data[file_of_pos(from, pcx)];
        }
        buf_str(out, c"{\"start\":");
        put_position(out, a, first, tcx, pcx);
        buf_str(out, c",\"end\":");
        put_position(out, b, first, tcx, pcx);
        buf_byte(out, '}');
    }
}

// The file:// URI of file f.
pub fn put_uri(out: i64, path: [u8]) {
    let hex = "0123456789ABCDEF";
    buf_str(out, c"file://");
    for i in 0..path.len {
        let c = path[i];
        let plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '/' || c == '.' || c == '_' || c == '-' || c == '~';
        if plain {
            buf_byte(out, c);
        } else {
            buf_byte(out, '%');
            buf_byte(out, hex[(c >> 4) as i64]);
            buf_byte(out, hex[(c & 15) as i64]);
        }
    }
}

// The file:// URI of position pos's file (in std's text: its segment's).
fn put_pos_uri(out: i64, pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    let k = seg_at(pos, tcx, pcx);
    if k >= 0 {
        let p = buf_new();
        put_segment_path(p, k, tcx);
        put_uri(out, buf_slice(p));
    } else {
        put_uri(out, cstr(pcx.files[file_of_pos(pos, pcx)].path));
    }
}

// Whether position pos is in a file of its own (not std's text).
fn in_file(pos: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if pos < 0 {
            return false;
        }
        let f = file_of_pos(pos, pcx);
        f >= 0 && pcx.files[f].path[0] != '<'
    }
}

// Whether position pos has a location: in a file, or in std's text (one
// of its files).
fn located(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    pos >= 0 && (in_file(pos, pcx) || seg_at(pos, tcx, pcx) >= 0)
}

// Whether a reference at pos is shown: in the program's files, and in
// std's when the request is about a file of std's.
fn shown(pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    in_file(pos, pcx) || tcx.ask_seg >= 0 && seg_at(pos, tcx, pcx) >= 0
}

// The end of the token at pos (pos + 1 when none starts there).
fn token_end(pos: i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_at(pos, pcx);
    if t < pcx.toks.len() as i64 && pcx.toks[t].start == pos && pcx.toks[t].end > pos {
        return pcx.toks[t].end;
    }
    let f = file_of_pos(pos, pcx);
    if pos < pcx.files[f].end && SRC[pos] != '\n' { pos + 1 } else { pos }
}

// `{"uri":..,"range":..}` of the token at pos.
fn put_location(out: i64, pos: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    buf_str(out, c"{\"uri\":\"");
    put_pos_uri(out, pos, tcx, pcx);
    buf_str(out, c"\",\"range\":");
    put_range(out, pos, token_end(pos, pcx), tcx, pcx);
    buf_byte(out, '}');
}

// ---- what is at a position

// The start of the token holding pos (or ending at it), or -1.
fn token_start(pos: i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_at(pos, pcx);
    if t < pcx.toks.len() as i64 && pcx.toks[t].start == pos {
        return pos;
    }
    if t > 0 && pcx.toks[t - 1].start <= pos && pos <= pcx.toks[t - 1].end {
        return pcx.toks[t - 1].start;
    }
    -1
}

fn ensure_refs(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    if !tcx.refs_ready {
        let t0 = now_us(&pcx);
        var all = tcx.all_refs;
        collect_all_refs(&all, &tcx, pcx);
        tcx.all_refs = all;
        lap("references collected", t0, tcx, &pcx);
        // (0.25: the program's names, std's and operators' calls)
        let t1 = now_us(&pcx);
        find_operators(&tcx, pcx);
        clean_refs(&tcx, pcx);
        add_unwritten(&tcx, pcx);
        lap("references resolved", t1, tcx, &pcx);
        tcx.refs_ready = true;
    }
}

// The token starting at pos, or -1.
fn token_starting(pos: i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_at(pos, pcx);
    if t < pcx.toks.len() as i64 && pcx.toks[t].start == pos { t } else { -1 }
}

// The text of token t.
fn tok_text(t: i64, pcx: Ctx<Comp>) -> [u8] {
    SRC[pcx.toks[t].start..pcx.toks[t].end]
}

// The kind of token t (Eof past the tokens).
fn tok_kind(t: i64, pcx: Ctx<Comp>) -> Tok {
    if t < 0 || t >= pcx.toks.len() as i64 {
        return Tok::Eof;
    }
    // UNSAFE: the tokens are in TOKS, the lexer's raw array.
    // SAFETY: 0 <= t < TOK_COUNT (checked above): a token the lexer wrote;
    // the worker lexes nothing after it read the program, so TOKS stays.
    unsafe { pcx.toks[t].kind }
}

// Whether token kind k is a keyword (`fn`, `let`, `var`, `inout`...; not
// `true` and `false`, values).
fn is_keyword(k: i64) -> bool {
    k >= 10 && k <= 39 && k != 22 && k != 23 || k == 90 || k == 91 || k >= 95 && k <= 97
}

// The operators that call a function (OP_*): `a + b`, `a == b`, `a < b`,
// `-a` of a type with std's Add, Sub, Mul, Div, Eq, Ord or Neg, which the
// checker made `{ let =+l = a; let =+r = b; =+l.add(=+r) }`
// (traits.vl: operator_call, negation_call), its call at the operator's
// start: the operator is the token between the operands.
fn find_operators(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Block || pcx.nodes[n].count < 1
            || pcx.nodes[n].count > 2 {
            continue;
        }
        let first = child(n, 0, pcx);
        if pcx.nodes[first].kind != NodeKind::Let
            || pcx.nodes[pcx.nodes[first].a].kind != NodeKind::PatBind {
            continue;
        }
        let name = sym_text(pcx.nodes[pcx.nodes[first].a].a, pcx);
        if name.len != 3 || name[0] != '=' || name[2] != 'l' {
            continue;
        }
        // (`!=` negates the call, `<` compares its result)
        var c = pcx.nodes[n].a;
        if c != 0
            && (pcx.nodes[c].kind == NodeKind::Unary || pcx.nodes[c].kind == NodeKind::Binary) {
            c = pcx.nodes[c].b;
        }
        if c == 0 || pcx.nodes[c].kind != NodeKind::Call || pcx.nodes[c].x <= 0 {
            continue;
        }
        let fnode = pcx.fns[pcx.nodes[c].x - 1].node;
        var d = def_of_node(fnode, tcx, pcx);
        if d < 0 {
            // (a #[derive]'s `eq`, `cmp`: std's trait function)
            d = trait_fn_named(pcx.nodes[fnode].a, pcx);
        }
        if d < 0 {
            continue;
        }
        var at = -1;
        if pcx.nodes[n].count == 2 {
            let lhs = pcx.nodes[first].c;
            let rhs = pcx.nodes[child(n, 1, pcx)].c;
            var t = token_at(pcx.nodes[lhs].end, pcx);
            while t < pcx.toks.len() as i64 && pcx.toks[t].kind == Tok::RParen {
                t += 1;
            }
            if t < pcx.toks.len() as i64 && pcx.toks[t].start < pcx.nodes[rhs].start {
                at = pcx.toks[t].start;
            }
        } else {
            let t = token_starting(pcx.nodes[n].start, pcx);
            if t >= 0 && pcx.toks[t].kind == Tok::Minus {
                at = pcx.nodes[n].start;
            }
        }
        if at >= 0 {
            tcx.op_at.push(at);
            tcx.op_def.push(d);
            tcx.op_start.push(pcx.nodes[c].start);
        }
    }
}

// The definition the operator at pos calls, or -1.
fn operator_def(pos: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        for i in 0..tcx.op_at.count {
            if tcx.op_at.data[i] == pos {
                return tcx.op_def.data[i];
            }
        }
        -1
    }
}

// std's trait function named sym (`clone` of Clone, `eq` of Eq): what a
// call of a function #[derive] wrote names (that function has no item);
// -1.
fn trait_fn_named(sym: i64, pcx: Ctx<Comp>) -> i64 {
    var any = -1;
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d].kind == K_TRAIT_FN && pcx.defs[d].name == sym {
            let fqn = sym_text(pcx.defs[d].fqn, pcx);
            if fqn.len > 5 && fqn[0..5] == "std::" {
                return d;
            }
            if any < 0 {
                any = d;
            }
        }
    }
    any
}

// The names written with no reference at them (ALL_REFS, added to): a
// method call of what a #[derive] wrote (`p.clone()`: std's
// Clone::clone), `x.into()` (the checker's `U::from(x)`: that `from`);
// a path's head that the checker resolved through its member only
// (`Token` of `use Token::{Num, Plus};`: the program's type, trait or
// module of that name, else std's). (The candidates' positions in a map,
// then one pass over the references.)
fn add_unwritten(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        // (position, token, call node or 0 for a path's head)
        var cand = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for n in 1..pcx.nodes.len() as i64 {
            if pcx.nodes[n].kind != NodeKind::Call || pcx.nodes[n].x <= 0
                || pcx.nodes[n].count == 0 {
                continue;
            }
            let recv = child(n, 0, pcx);
            if pcx.nodes[recv].end <= pcx.nodes[recv].start {
                continue;
            }
            var t = token_at(pcx.nodes[recv].end, pcx);
            while t < pcx.toks.len() as i64 && pcx.toks[t].kind == Tok::RParen {
                t += 1;
            }
            if t + 1 < pcx.toks.len() as i64 && pcx.toks[t].kind == Tok::Dot
                && pcx.toks[t + 1].kind == Tok::Ident
                && pcx.toks[t + 1].start < pcx.nodes[n].end {
                cand.push(pcx.toks[t + 1].start);
                cand.push(t + 1);
                cand.push(n);
            }
        }
        for t in 0..pcx.toks.len() as i64 - 1 {
            if pcx.toks[t].kind == Tok::Ident && pcx.toks[t + 1].kind == Tok::ColonColon
                && in_file(pcx.toks[t].start, pcx) {
                cand.push(pcx.toks[t].start);
                cand.push(t);
                cand.push(0);
            }
        }
        var at = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        var c = 0;
        while c < cand.count {
            at.put(cand.data[c] + 1, 1);
            c += 3;
        }
        var i = 0;
        while i < tcx.all_refs.count {
            if at.get(tcx.all_refs.data[i] + 1) == 1 {
                at.put(tcx.all_refs.data[i] + 1, 2);
            }
            i += 3;
        }
        var named = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        var named_ready = false;
        c = 0;
        while c < cand.count {
            let p = cand.data[c];
            let t = cand.data[c + 1];
            let n = cand.data[c + 2];
            c += 3;
            if at.get(p + 1) != 1 {
                continue;
            }
            var d = -1;
            if n != 0 {
                let fnode = pcx.fns[pcx.nodes[n].x - 1].node;
                d = def_of_node(fnode, tcx, pcx);
                if d < 0 {
                    d = trait_fn_named(pcx.toks[t].value as i64, pcx);
                }
            } else if local_named_at(p, &tcx, pcx) < 0 {
                if !named_ready {
                    for e in 0..pcx.defs.len() as i64 {
                        let k = pcx.defs[e].kind;
                        if k != K_STRUCT && k != K_ENUM && k != K_TRAIT && k != K_ALIAS
                            && k != K_MOD {
                            continue;
                        }
                        let have = named.get(pcx.defs[e].name + 1) - 1;
                        if have < 0
                            || !in_file(pcx.defs[have].name_pos, pcx)
                            && in_file(pcx.defs[e].name_pos, pcx) {
                            named.put(pcx.defs[e].name + 1, e + 1);
                        }
                    }
                    named_ready = true;
                }
                d = named.get(pcx.toks[t].value as i64 + 1) - 1;
            }
            if d >= 0 {
                tcx.all_refs.push(p);
                tcx.all_refs.push(d);
                tcx.all_refs.push(if n != 0 { QF_CALL } else { QF_USE });
                at.put(p + 1, 2);
            }
        }
    }
}

// The references that are the program's (ALL_REFS, in place): a name is
// the definition it is written as. Dropped: what the checker made at a
// name that is something else (a local's drop at its `let`, an
// f-string's display or a contract's check at a local, a derive's
// function at a field or at a variant's types); an operator's call
// moved to the operator. (A map of the few positions with such a
// reference, not of every reference: the compiler's source has a
// million.)
fn clean_refs(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let n = tcx.all_refs.count / 3;
        // each reference's token when it is not written as its name, else -1
        var odd = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var suspect = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for r in 0..n {
            let p = tcx.all_refs.data[3 * r];
            let d = tcx.all_refs.data[3 * r + 1];
            let t = token_starting(p, pcx);
            if t >= 0 && (tcx.all_refs.data[3 * r + 2] & QF_DEF) == 0
                && !(pcx.toks[t].kind == Tok::Ident && pcx.toks[t].value as i64 == pcx.defs[d].name) {
                odd.push(t);
                suspect.put(p + 1, 1);
            } else {
                odd.push(-1);
            }
        }
        // (2: a name written as what it names, or a definition, is there)
        for r in 0..n {
            let p = tcx.all_refs.data[3 * r];
            if odd.data[r] < 0 && suspect.get(p + 1) != 0 {
                suspect.put(p + 1, 2);
            }
        }
        var ops_at = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        var used = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..tcx.op_start.count {
            ops_at.put(tcx.op_start.data[k] + 1, 1);
            used.push(0);
        }
        var w = 0;
        for r in 0..n {
            let p = tcx.all_refs.data[3 * r];
            let d = tcx.all_refs.data[3 * r + 1];
            let flags = tcx.all_refs.data[3 * r + 2];
            let t = odd.data[r];
            var keep = true;
            var at = p;
            if t >= 0 {
                let text = tok_text(t, pcx);
                keep = false;
                if ops_at.get(p + 1) != 0 {
                    for k in 0..tcx.op_start.count {
                        if !keep && used.data[k] == 0 && tcx.op_start.data[k] == p
                            && tcx.op_def.data[k] == d {
                            used.data[k] = 1;
                            at = tcx.op_at.data[k];
                            keep = true;
                        }
                    }
                }
                if !keep && pcx.toks[t].kind == Tok::Ident {
                    // (`self`, `Self`; an import's other name: `use a::{b as c}`)
                    keep = text == "self" || text == "Self"
                        || suspect.get(p + 1) != 2 && local_named_at(p, &tcx, pcx) < 0
                        && !is_primitive(t, pcx) && text != "result" && text != "requires"
                        && text != "ensures";
                }
            }
            if keep {
                tcx.all_refs.data[w] = at;
                tcx.all_refs.data[w + 1] = d;
                tcx.all_refs.data[w + 2] = flags;
                w += 3;
            }
        }
        tcx.all_refs.count = w;
    }
}

// The definition named at position start (a reference, or a definition's
// name; one written as its name first; an operator's function), or -1.
fn def_named_at(start: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if start < 0 {
            return -1;
        }
        ensure_refs(&tcx, &pcx);
        let t = token_starting(start, pcx);
        if t >= 0 && is_keyword(pcx.toks[t].kind as i64) {
            return -1;
        }
        var other = -1;
        var i = 0;
        while i < tcx.all_refs.count {
            if tcx.all_refs.data[i] == start {
                let d = tcx.all_refs.data[i + 1];
                if t < 0
                    || pcx.toks[t].value as i64 == pcx.defs[d].name
                    && pcx.toks[t].kind == Tok::Ident {
                    return d;
                }
                if other < 0 {
                    other = d;
                }
            }
            i += 3;
        }
        if other < 0 {
            other = operator_def(start, tcx);
        }
        if other < 0 && t >= 0 && pcx.toks[t].kind == Tok::Ident && tok_text(t, pcx) == "Self" {
            // (in a trait: the trait)
            var best = 0;
            for n in 1..pcx.nodes.len() as i64 {
                if pcx.nodes[n].kind == NodeKind::Trait && pcx.nodes[n].start <= start
                    && start < pcx.nodes[n].end
                    && (best == 0 || pcx.nodes[n].start > pcx.nodes[best].start) {
                    best = n;
                }
            }
            if best != 0 {
                other = def_of_node(best, tcx, pcx);
            }
        }
        other
    }
}

// ---- type parameters, std and crate

// The declaration of the type parameter named at start (`T` of `fn f<T>`,
// of the impl, struct, enum or trait around it), or -1; *item: the item
// declaring it.
fn type_param_at(start: i64, item: inout i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_starting(start, pcx);
    if t < 0 || pcx.toks[t].kind != Tok::Ident {
        return -1;
    }
    let sym = pcx.toks[t].value as i64;
    var best = -1;
    var best_start = -1;
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if k != NodeKind::Fn && k != NodeKind::Struct && k != NodeKind::Enum
            && k != NodeKind::Trait && k != NodeKind::Impl && k != NodeKind::TypeAlias {
            continue;
        }
        let g = pcx.nodes[n].g;
        if g == 0 || pcx.nodes[n].start > start || pcx.nodes[n].end <= start
            || pcx.nodes[n].start <= best_start {
            continue;
        }
        for i in 0..pcx.nodes[g].count {
            let p = child(g, i, pcx);
            if pcx.nodes[p].kind == NodeKind::TyName && pcx.nodes[p].a == sym {
                best = pcx.nodes[p].start;
                best_start = pcx.nodes[n].start;
                item = n;
            }
        }
    }
    best
}

// The uses of the name of token t in from..to, into out (in order).
fn same_name_in(t: i64, from: i64, to: i64, out: inout IntVec, pcx: Ctx<Comp>) {
    let a = token_at(from, pcx);
    for u in a..pcx.toks.len() as i64 {
        if pcx.toks[u].start >= to {
            break;
        }
        if pcx.toks[u].kind == pcx.toks[t].kind && pcx.toks[u].value == pcx.toks[t].value {
            out.push(pcx.toks[u].start);
        }
    }
}

// What a path's first segment at start names: 1 `std`, 2 `crate`, 3
// `super`, 4 `self`, else 0.
fn root_named_at(start: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let t = token_starting(start, pcx);
    if t < 0 || t + 1 >= pcx.toks.len() as i64 || pcx.toks[t].kind != Tok::Ident
        || pcx.toks[t + 1].kind != Tok::ColonColon || local_named_at(start, &tcx, pcx) >= 0 {
        return 0;
    }
    let w = tok_text(t, pcx);
    if w == "std" { 1 } else if w == "crate" { 2 } else if w == "super" { 3 }
    else if w == "self" { 4 } else { 0 }
}

// Where the root named by `which` at position at starts: std's first
// file, the program's root file; `self`: the module `mod x { }` around at
// (its name), else at's file; `super`: the module around that one, or
// the file `mod x { }` is in; -1 when it has no place (`super` of a
// file: its parent's `mod x;` is not looked for).
fn root_start(which: i64, at: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if which == 1 {
            return if tcx.std_f >= 0
                && seg_at(pcx.files[tcx.std_f].start, tcx, pcx) >= 0 { pcx.files[tcx.std_f].start }
                else { -1 };
        }
        if which >= 3 {
            // (the braces open before at: a `mod x {` one is its module's,
            // its name's position on the stack, else -1)
            let f = file_of_pos(at, pcx);
            var open = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            var t = token_at(pcx.files[f].start, pcx);
            while t < pcx.toks.len() as i64 && pcx.toks[t].start < at {
                if pcx.toks[t].kind == Tok::LBrace {
                    let m = t >= 2 && pcx.toks[t - 2].kind == Tok::Mod
                        && pcx.toks[t - 1].kind == Tok::Ident;
                    open.push(if m { pcx.toks[t - 1].start } else { -1 });
                } else if pcx.toks[t].kind == Tok::RBrace && open.count > 0 {
                    open.count -= 1;
                }
                t += 1;
            }
            var inner = -1;
            var outer = -1;
            for k in 0..open.count {
                if open.data[k] >= 0 {
                    outer = inner;
                    inner = open.data[k];
                }
            }
            if which == 4 {
                return if inner >= 0 { inner } else { pcx.files[f].start };
            }
            return if inner < 0 { -1 } else if outer >= 0 { outer } else { pcx.files[f].start };
        }
        for f in 0..pcx.files.len() {
            if cstr(pcx.files[f].path) == cstr(tcx.root_given) {
                return pcx.files[f].start;
            }
        }
        -1
    }
}

// The positions of every `std::` (`crate::`) in the shown files, into out.
fn root_uses(which: i64, out: inout IntVec, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    for t in 0..pcx.toks.len() as i64 - 1 {
        if pcx.toks[t].kind == Tok::Ident && pcx.toks[t + 1].kind == Tok::ColonColon
            && shown(pcx.toks[t].start, tcx, pcx)
            && root_named_at(pcx.toks[t].start, &tcx, pcx) == which {
            out.push(pcx.toks[t].start);
        }
    }
}

// Whether token t is a primitive type's name (`i64`, `u8`, `bool`...).
fn is_primitive(t: i64, pcx: Ctx<Comp>) -> bool {
    t >= 0 && pcx.toks[t].kind == Tok::Ident && primitive_text(tok_text(t, pcx)).len > 0
}

// The attribute named at start (`derive` of `#[derive(..)]`): its token,
// or -1.
fn attribute_at(start: i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_starting(start, pcx);
    if t < 2 || pcx.toks[t].kind != Tok::Ident || pcx.toks[t - 1].kind != Tok::LBracket
        || pcx.toks[t - 2].kind != Tok::Hash {
        return -1;
    }
    t
}

// The position of the name sym in node n's tokens (its start when none).
fn name_in_node(n: i64, sym: i64, pcx: Ctx<Comp>) -> i64 {
    var u = token_at(pcx.nodes[n].start, pcx);
    while u < pcx.toks.len() as i64 && pcx.toks[u].start < pcx.nodes[n].end {
        if pcx.toks[u].kind == Tok::Ident && pcx.toks[u].value as i64 == sym {
            return pcx.toks[u].start;
        }
        u += 1;
    }
    pcx.nodes[n].start
}

// The associated type named at start: `type Output = Meters;` of an impl
// or `type Output;` of a trait (itself), `T::Output`, `Self::Item` or a
// bound's `Item = i64` (the trait's `type Item;`): its AssocType node, or
// 0; *decl: where the name is declared.
fn assoc_at(start: i64, decl: inout i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let t = token_starting(start, pcx);
    if t < 1 || pcx.toks[t].kind != Tok::Ident {
        return 0;
    }
    let sym = pcx.toks[t].value as i64;
    let item = pcx.toks[t - 1].kind == Tok::Type;
    let path = pcx.toks[t - 1].kind == Tok::ColonColon;
    var in_trait = 0;
    var in_trait_at = 0;
    var here = 0;
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::AssocType || pcx.nodes[n].a != sym {
            continue;
        }
        let p = name_in_node(n, sym, pcx);
        if p == start {
            here = n;
        }
        // (0.27.0: the nearest trait's before the name, when several
        // traits declare it, std's `Index::Output` and the program's)
        if pcx.nodes[n].b == 0 && located(p, tcx, pcx) && (in_trait == 0
            || p <= start && (in_trait_at > start || p > in_trait_at)) {
            in_trait = n;
            in_trait_at = p;
        }
    }
    if here != 0 && (item || in_trait == 0) {
        decl = start;
        return here;
    }
    if (path || here != 0) && in_trait != 0 {
        decl = name_in_node(in_trait, sym, pcx);
        return in_trait;
    }
    0
}

// The uses of the associated type's name of token t in the shown files
// (its declarations, `X::Name`, `Name = T`), into out.
fn assoc_uses(t: i64, out: inout IntVec, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    for u in 1..pcx.toks.len() as i64 - 1 {
        if pcx.toks[u].kind != Tok::Ident || pcx.toks[u].value != pcx.toks[t].value
            || !shown(pcx.toks[u].start, tcx, pcx) {
            continue;
        }
        let k = pcx.toks[u - 1].kind;
        if k == Tok::Type || k == Tok::ColonColon || pcx.toks[u + 1].kind == Tok::Eq
            && (k == Tok::Lt || k == Tok::Comma) {
            out.push(pcx.toks[u].start);
        }
    }
}

// The parameter named at start that is no local (of a C function, of a
// trait's function without a body): its Param node, or 0.
fn param_at(start: i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_starting(start, pcx);
    if t < 0 || pcx.toks[t].kind != Tok::Ident {
        return 0;
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind == NodeKind::Param && pcx.nodes[n].a == pcx.toks[t].value as i64
            && pcx.nodes[n].start <= start && start < pcx.nodes[n].end
            && name_in_node(n, pcx.nodes[n].a, pcx) == start {
            return n;
        }
    }
    0
}

// The attribute token t is in (`C` of `#[repr(C)]`): its name's token, or
// -1.
fn enclosing_attribute(t: i64, pcx: Ctx<Comp>) -> i64 {
    var depth = 0;
    var u = t - 1;
    while u > 0 && u > t - 64 {
        let k = pcx.toks[u].kind;
        if k == Tok::Semi || k == Tok::LBrace || k == Tok::RBrace {
            return -1;
        }
        if k == Tok::RBracket {
            depth += 1;
        } else if k == Tok::LBracket {
            if depth == 0 {
                return if pcx.toks[u - 1].kind == Tok::Hash && u + 1 < t { u + 1 } else { -1 };
            }
            depth -= 1;
        }
        u -= 1;
    }
    -1
}

// The source text from..to on one line (runs of blanks as one), without
// a last `;`.
fn put_collapsed(md: i64, from: i64, to: i64) {
    var e = to;
    while e > from && (SRC[e - 1] == ';' || SRC[e - 1] == ' ' || SRC[e - 1] == '\n') {
        e -= 1;
    }
    var blank = false;
    for p in from..e {
        let c = SRC[p];
        if c == ' ' || c == '\n' || c == '\t' {
            blank = true;
        } else {
            if blank {
                buf_byte(md, ' ');
            }
            blank = false;
            buf_byte(md, c);
        }
    }
}

// The declaration of the local named at start, or -1 (local_at's answer,
// from a table of every position made once: 0.25).
fn local_named_at(start: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if start < 0 {
        return -1;
    }
    if !tcx.locals_ready {
        load_local_decls(&tcx, pcx);
        for n in 1..pcx.nodes.len() as i64 {
            let p = decl_name_pos(n, pcx);
            if p >= pcx.nodes[n].start && p < pcx.nodes[n].end && tcx.local_at.get(p + 1) == 0
                && tcx.local_decl.get(pcx.nodes[n].x + 1) == p + 1 {
                tcx.local_at.put(p + 1, p + 1);
            }
            let s = pcx.nodes[n].start;
            if s >= 0 && pcx.nodes[n].end > s {
                let d = decl_of_use(n, tcx, pcx);
                if d >= 0 && tcx.local_at.get(s + 1) == 0 {
                    tcx.local_at.put(s + 1, d + 1);
                }
            }
        }
        tcx.locals_ready = true;
    }
    tcx.local_at.get(start + 1) - 1
}

// LOCAL_DECL, made once.
fn load_local_decls(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if tcx.local_decl.count > 0 {
        return;
    }
    var skip = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
    for n in 1..pcx.nodes.len() as i64 {
        let k = pcx.nodes[n].kind;
        if k == NodeKind::ExternFn || k == NodeKind::Fn && pcx.nodes[n].c == 0 {
            for i in 0..pcx.nodes[n].count {
                skip.put(child(n, i, pcx) + 1, 1);
            }
        }
    }
    for n in 1..pcx.nodes.len() as i64 {
        if skip.get(n + 1) != 0 {
            continue;
        }
        let p = decl_name_pos(n, pcx);
        if p >= 0 && tcx.local_decl.get(pcx.nodes[n].x + 1) == 0 {
            tcx.local_decl.put(pcx.nodes[n].x + 1, p + 1);
        }
    }
}

// The position of the declaration of the local node n names, or -1
// (refactor_mod/local's use_decl, on LOCAL_DECL).
fn decl_of_use(n: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if (pcx.nodes[n].p & NODE_CAPTURE) != 0 && pcx.nodes[n].d > 0 {
        return tcx.local_decl.get(pcx.nodes[n].d) - 1;
    }
    if pcx.nodes[n].kind != NodeKind::Ident || pcx.nodes[n].res != Res::Local {
        return -1;
    }
    let l = pcx.nodes[n].y;
    if l < 0 || l >= pcx.locals.len() as i64 || pcx.locals[l].name != pcx.nodes[n].a {
        return -1;
    }
    tcx.local_decl.get(l + 1) - 1
}

// ---- C imports (0.25.2)

// The most lines of a C declaration a hover shows.
const C_LINES_MAX: i64 = 12;

// The text of the header at path (empty when it cannot be read), the
// last one kept.
fn header_text(path: [u8], tcx: inout Tcx<Comp>) -> [u8] {
    if tcx.hdr_path >= 0 && buf_slice(tcx.hdr_path) == path {
        return buf_slice(tcx.hdr_text);
    }
    tcx.hdr_path = buf_new();
    buf_bytes(tcx.hdr_path, path);
    tcx.hdr_text = buf_new();
    let p = buf_new();
    buf_bytes(p, path);
    read_file_if(buf_cstr(p), tcx.hdr_text);
    buf_slice(tcx.hdr_text)
}

// The start of line `line` (from 1) in text, or -1.
fn text_line(text: [u8], line: i64) -> i64 {
    var at = 0;
    var n = 1;
    while n < line && at < text.len as i64 {
        if text[at] == '\n' {
            n += 1;
        }
        at += 1;
    }
    if n == line && at < text.len as i64 { at } else { -1 }
}

// The end of the line starting at `at` in text (its '\n' or the end).
fn text_line_end(text: [u8], at: i64) -> i64 {
    var e = at;
    while e < text.len as i64 && text[e] != '\n' {
        e += 1;
    }
    e
}

// The absolute path of a header's path p (a buffer): relative ones from
// the server's directory; `.` and `..` segments taken out (as the editor
// names the file).
fn header_path(p: [u8]) -> i64 {
    let raw = buf_new();
    if p.len == 0 || p[0] != '/' {
        buf_bytes(raw, buf_slice(cwd_dir()));
        buf_byte(raw, '/');
    }
    buf_bytes(raw, p);
    let s = buf_slice(raw);
    // the segments kept: (start, end) in s, in pairs
    var kept = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var i = 0;
    while i < s.len as i64 {
        while i < s.len as i64 && s[i] == '/' {
            i += 1;
        }
        var j = i;
        while j < s.len as i64 && s[j] != '/' {
            j += 1;
        }
        let seg = s[i..j];
        if seg == ".." {
            if kept.count >= 2 {
                kept.pop();
                kept.pop();
            }
        } else if seg.len > 0 && seg != "." {
            kept.push(i);
            kept.push(j);
        }
        i = j;
    }
    let b = buf_new();
    var k = 0;
    while k + 1 < kept.count {
        buf_byte(b, '/');
        buf_bytes(b, s[kept.get(k)..kept.get(k + 1)]);
        k += 2;
    }
    b
}

// The place (C_ORIGINS) of the declaration imported from C whose vole
// text holds position pos, or -1.
fn c_origin_at(pos: i64, pcx: Ctx<Comp>) -> i64 {
    let n = pcx.c_emit_at.count / 2;
    if pcx.imported_start < 0 || pos < pcx.imported_start || n == 0
        || file_of_pos(pos, pcx) != file_of_pos(pcx.imported_start, pcx) {
        return -1;
    }
    let off = pos - pcx.imported_start;
    if pcx.c_emit_at.get(0) > off {
        return -1;
    }
    // (the last mark at or before off)
    var lo = 0;
    var hi = n;
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if pcx.c_emit_at.get(mid * 2) <= off { lo = mid; } else { hi = mid; }
    }
    pcx.c_emit_at.get(lo * 2 + 1)
}

// Where place o's name is: its header's path, its line (from 1), its
// name; an empty path when it has none.
fn c_place(o: i64, pcx: Ctx<Comp>) -> ([u8], i64, [u8]) {
    let (file, line, text, _) = ctok_place(pcx.c_origins.get(o * 3), pcx);
    if file < 0 {
        return ("", 0, "");
    }
    (cfile_path(file, pcx), line, sym_text(text, pcx))
}

// `{"uri":..,"range":..}` of place o: its name on its line of its header.
fn put_c_location(out: i64, o: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    let (path, line, name) = c_place(o, pcx);
    if path.len == 0 {
        return false;
    }
    // its column: the name as a word on its line
    let text = header_text(path, &tcx);
    let ls = text_line(text, line);
    var col = 0;
    var len = 0;
    if ls >= 0 {
        let le = text_line_end(text, ls);
        var i = ls;
        while i + name.len as i64 <= le {
            let before = i == ls || !is_ident_byte(text[i - 1]);
            let after = i + name.len as i64 == le || !is_ident_byte(text[i + name.len as i64]);
            if before && after && text[i..i + name.len as i64] == name {
                col = i - ls;
                len = name.len as i64;
                break;
            }
            i += 1;
        }
    }
    buf_str(out, c"{\"uri\":\"");
    put_uri(out, buf_slice(header_path(path)));
    buf_fmt(out,
        format_args("\",\"range\":{{\"start\":{{\"line\":{},\"character\":{col}}},\"end\":{{\"line\":{},\"character\":{}}}}}}}", line - 1, line - 1, col + len));
    true
}

// The C files the program is built with, as far as the worker knows (the
// buffers of their paths, into out): vole.cSources (C_SOURCES), and the
// C file beside each header the program imports by a relative path
// (`import "./ring.h"`: ./ring.c, when there is one).
fn c_source_files(out: inout IntVec, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    for i in 0..tcx.c_sources.count {
        out.push(tcx.c_sources.get(i));
    }
    var i = 0;
    while i + 1 < pcx.c_import_paths.count {
        let k = pcx.c_import_paths.get(i);
        let p = sym_text(pcx.c_import_paths.get(i + 1), pcx);
        i += 2;
        let t = token_starting(pcx.c_import_pos.get(k), pcx);
        if t < 0 {
            continue;
        }
        let s = tok_text(t, pcx);
        if s.len < 4 || s[1] != '.' || p.len < 2
            || p[p.len as i64 - 2..] != ".h" {
            continue;
        }
        let c = buf_new();
        buf_bytes(c, p[0..p.len as i64 - 1]);
        buf_byte(c, 'c');
        if std::fs::metadata(buf_slice(c)).is_ok() {
            out.push(c);
        }
    }
}

// Where C function `name` has its body in the C text `text`: the
// offset of its name, or -1. (A scan, not C's preprocessor: `NAME (...)
// {` at the file's level, outside comments, strings and directives.)
fn c_body_at(text: [u8], name: [u8]) -> i64 {
    var i = 0;
    var depth = 0;
    var bol = true;
    let n = text.len as i64;
    while i < n {
        let c = text[i];
        if c == '\n' {
            bol = true;
            i += 1;
        } else if c == ' ' || c == '\t' || c == '\r' {
            i += 1;
        } else if bol && c == '#' {
            // a directive, with its continued lines
            while i < n && text[i] != '\n' {
                if text[i] == '\\' && i + 1 < n && text[i + 1] == '\n' {
                    i += 1;
                }
                i += 1;
            }
        } else if c == '/' && i + 1 < n && text[i + 1] == '/' {
            while i < n && text[i] != '\n' {
                i += 1;
            }
        } else if c == '/' && i + 1 < n && text[i + 1] == '*' {
            i += 2;
            while i + 1 < n && !(text[i] == '*' && text[i + 1] == '/') {
                i += 1;
            }
            i += 2;
        } else if c == '"' || c == '\'' {
            i += 1;
            while i < n && text[i] != c && text[i] != '\n' {
                if text[i] == '\\' {
                    i += 1;
                }
                i += 1;
            }
            i += 1;
            bol = false;
        } else if c == '{' {
            depth += 1;
            i += 1;
            bol = false;
        } else if c == '}' {
            depth -= 1;
            i += 1;
            bol = false;
        } else if is_ident_byte(c) && !(c >= '0' && c <= '9') {
            var j = i;
            while j < n && is_ident_byte(text[j]) {
                j += 1;
            }
            if depth == 0 && text[i..j] == name {
                var k = j;
                while k < n
                    && (text[k] == ' ' || text[k] == '\t' || text[k] == '\n' || text[k] == '\r') {
                    k += 1;
                }
                if k < n && text[k] == '(' {
                    var parens = 0;
                    while k < n {
                        if text[k] == '(' {
                            parens += 1;
                        } else if text[k] == ')' {
                            parens -= 1;
                            if parens == 0 {
                                break;
                            }
                        }
                        k += 1;
                    }
                    k += 1;
                    while k < n
                        && (text[k] == ' ' || text[k] == '\t' || text[k] == '\n' || text[k] == '\r') {
                        k += 1;
                    }
                    if k < n && text[k] == '{' {
                        return i;
                    }
                }
            }
            i = j;
            bol = false;
        } else {
            i += 1;
            bol = false;
        }
    }
    -1
}

// `,{"uri":..,"range":..}` of each body of C function `name` in the C
// files the program is built with, onto out; how many.
fn put_c_bodies(out: i64, name: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    var files = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    c_source_files(&files, tcx, pcx);
    var found = 0;
    for f in 0..files.count {
        let path = buf_slice(files.get(f));
        let text = header_text(path, &tcx);
        let at = c_body_at(text, name);
        if at < 0 {
            continue;
        }
        var line = 0;
        var ls = 0;
        for p in 0..at {
            if text[p] == '\n' {
                line += 1;
                ls = p + 1;
            }
        }
        buf_str(out, c",{\"uri\":\"");
        put_uri(out, buf_slice(header_path(path)));
        buf_fmt(out,
            format_args("\",\"range\":{{\"start\":{{\"line\":{line},\"character\":{}}},\"end\":{{\"line\":{line},\"character\":{}}}}}}}", at - ls, at - ls + name.len as i64));
        found += 1;
    }
    found
}

// The `import` whose header's string starts at start: the header's path,
// else empty.
fn import_header_at(start: i64, pcx: Ctx<Comp>) -> [u8] {
    let t = token_starting(start, pcx);
    if t <= 0 || tok_kind(t, pcx) != Tok::Str || tok_kind(t - 1, pcx) != Tok::Import {
        return "";
    }
    for k in 0..pcx.c_import_pos.count {
        if pcx.c_import_pos.get(k) == start {
            var i = 0;
            while i + 1 < pcx.c_import_paths.count {
                if pcx.c_import_paths.get(i) == k {
                    return sym_text(pcx.c_import_paths.get(i + 1), pcx);
                }
                i += 2;
            }
        }
    }
    ""
}

// (0.25.3) The file of the include_str or include_bytes whose name or
// path string starts at start, else empty.
fn embedded_file_at(start: i64, pcx: Ctx<Comp>) -> [u8] {
    var t = token_starting(start, pcx);
    if t <= 0 {
        return "";
    }
    // (0.26.0) `embed wgsl K from "x.wgsl";`: the string, or `from`
    let s = if tok_kind(t, pcx) == Tok::Str { t } else { t + 1 };
    if s >= 4 && tok_kind(s, pcx) == Tok::Str && tok_word(s - 1, pcx) == "from"
        && tok_word(s - 4, pcx) == "embed" {
        // UNSAFE: the tokens are in TOKS, the lexer's raw array.
        // SAFETY: tok_kind(s) is Str, not Eof, so 0 <= s < TOK_COUNT.
        let (at, path) = unsafe { (pcx.toks[s].start, pcx.toks[s].value as i64) };
        return buf_path(embed_path(at, crate::front::lexer::str_at(path), pcx));
    }
    if tok_kind(t, pcx) == Tok::Ident {
        t += if tok_kind(t + 1, pcx) == Tok::Bang { 3 } else { 2 };
    }
    if tok_kind(t, pcx) != Tok::Str || tok_kind(t - 1, pcx) != Tok::LParen {
        return "";
    }
    var name = t - 2;
    if tok_kind(name, pcx) == Tok::Bang {
        name -= 1;
    }
    if tok_kind(name, pcx) != Tok::Ident {
        return "";
    }
    // UNSAFE: the tokens are in TOKS, the lexer's raw array.
    // SAFETY: tok_kind(name) and tok_kind(t) are not Eof, so 0 <= name < t
    // < TOK_COUNT: tokens the lexer wrote, which stay (as tok_kind's).
    let (sym, at, path) = unsafe {
        (pcx.toks[name].value as i64, pcx.toks[t].start, pcx.toks[t].value as i64)
    };
    let word = sym_text(sym, pcx);
    if word != "include_str" && word != "include_bytes" {
        return "";
    }
    buf_path(embed_path(at, crate::front::lexer::str_at(path), pcx))
}

// The word of identifier token t, or "" for another token.
fn tok_word(t: i64, pcx: Ctx<Comp>) -> [u8] {
    if tok_kind(t, pcx) != Tok::Ident {
        return "";
    }
    // UNSAFE: the tokens are in TOKS, the lexer's raw array.
    // SAFETY: tok_kind(t) is Ident, not Eof, so 0 <= t < TOK_COUNT.
    sym_text(unsafe { pcx.toks[t].value } as i64, pcx)
}

// The C declaration of place o, as its header writes it (at most
// C_LINES_MAX lines; a macro with its continued lines), then where it is.
fn put_c_decl(md: i64, o: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let (path, name_line, _) = c_place(o, pcx);
    if path.len == 0 {
        return;
    }
    var first = pcx.c_origins.get(o * 3 + 1);
    var last = pcx.c_origins.get(o * 3 + 2);
    if first <= 0 {
        first = name_line;
        last = first;
    }
    let text = header_text(path, &tcx);
    var at = text_line(text, first);
    if at < 0 {
        return;
    }
    buf_str(md, c"```c\n");
    var line = first;
    var shown = 0;
    loop {
        let e = text_line_end(text, at);
        var t = e;
        while t > at && (text[t - 1] == ' ' || text[t - 1] == '\t' || text[t - 1] == '\r') {
            t -= 1;
        }
        if shown == C_LINES_MAX {
            buf_str(md, c"...\n");
            break;
        }
        buf_bytes(md, text[at..t]);
        buf_byte(md, '\n');
        shown += 1;
        let continued = t > at && text[t - 1] == '\\';
        if line >= last && !continued || e >= text.len as i64 {
            break;
        }
        line += 1;
        at = e + 1;
    }
    buf_str(md, c"```\n");
    var k = path.len as i64;
    while k > 0 && path[k - 1] != '/' {
        k -= 1;
    }
    buf_str(md, c"declared in `");
    buf_bytes(md, path[k..]);
    buf_fmt(md, format_args(":{name_line}` (C)\n"));
}

// (0.25.2) A definition at a C import: the string of `import "h.h" as c;`
// at start (the header it reads), or the declaration imported from C
// whose name is at name_pos (-1: none; is_fn: a function): where its
// header has it, a function's bodies in the program's C files first.
// False when start is neither.
fn put_c_definition(out: i64, start: i64, name_pos: i64, is_fn: bool, tcx: inout Tcx<Comp>,
    pcx: Ctx<Comp>) -> bool {
    let header = if start >= 0 { import_header_at(start, pcx) } else { "" };
    if header.len > 0 {
        buf_str(out, c"{\"uri\":\"");
        put_uri(out, buf_slice(header_path(header)));
        buf_str(out, c"\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}}");
        return true;
    }
    let o = if name_pos >= 0 { c_origin_at(name_pos, pcx) } else { -1 };
    let loc = buf_new();
    if o < 0 || !put_c_location(loc, o, &tcx, pcx) {
        return false;
    }
    let (_, _, name) = c_place(o, pcx);
    let bodies = buf_new();
    let n = if is_fn { put_c_bodies(bodies, name, &tcx, pcx) } else { 0 };
    if n == 0 {
        buf_bytes(out, buf_slice(loc));
    } else {
        buf_byte(out, '[');
        buf_bytes(out, buf_slice(bodies)[1..buf_slice(bodies).len]);
        buf_byte(out, ',');
        buf_bytes(out, buf_slice(loc));
        buf_byte(out, ']');
    }
    true
}

// (0.26.3) The start of the name at pos: its token's, or in a format
// literal's hole (`{n}`) the name's own, which the checker's references
// carry (what an f-string's hole was, a token of its own, until 0.26.3).
fn name_start(pos: i64, pcx: Ctx<Comp>) -> i64 {
    let start = token_start(pos, pcx);
    let word = if start >= 0 { hole_word(start, pos, pcx) } else { -1 };
    if word >= 0 { word } else { start }
}

// def_named_at(start), but at a name in a format literal's hole only a
// definition of that name (not the Display call the hole's write makes).
fn def_named_here(start: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let d = def_named_at(start, &tcx, &pcx);
    if d < 0 || start < 0 || token_starting(start, pcx) >= 0 {
        return d;
    }
    var end = start;
    while is_ident_byte(SRC[end]) {
        end += 1;
    }
    var i = 0;
    while i + 1 < tcx.all_refs.count {
        let at = tcx.all_refs.get(i + 1);
        if tcx.all_refs.get(i) == start && sym_text(pcx.defs[at].name, pcx) == SRC[start..end] {
            return at;
        }
        i += 3;
    }
    -1
}

fn put_definition(out: i64, pos: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let start = name_start(pos, pcx);
    let d = def_named_here(start, &tcx, &pcx);
    // (0.25.2) at a C import: the header, the declaration in it
    let name_pos = if d >= 0 { pcx.defs[d].name_pos } else { -1 };
    if put_c_definition(out, start, name_pos, d >= 0 && pcx.defs[d].kind == K_FN, &tcx, pcx) {
        return;
    }
    // (0.25.3) at include_str("path") or include_bytes: the file
    let embedded = embedded_file_at(start, pcx);
    if embedded.len > 0 {
        buf_str(out, c"{\"uri\":\"");
        put_uri(out, buf_slice(header_path(embedded)));
        buf_str(out, c"\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}}");
        return;
    }
    if d >= 0 {
        if located(pcx.defs[d].name_pos, tcx, pcx) {
            put_location(out, pcx.defs[d].name_pos, tcx, pcx);
        } else {
            buf_str(out, c"null");
        }
        return;
    }
    let l = local_named_at(start, &tcx, pcx);
    if l >= 0 && located(l, tcx, pcx) {
        put_location(out, l, tcx, pcx);
        return;
    }
    var item = 0;
    let tp = type_param_at(start, &item, pcx);
    if tp >= 0 && located(tp, tcx, pcx) {
        put_location(out, tp, tcx, pcx);
        return;
    }
    let root = root_named_at(start, &tcx, pcx);
    if root > 0 && root_start(root, start, tcx, pcx) >= 0 {
        put_location(out, root_start(root, start, tcx, pcx), tcx, pcx);
        return;
    }
    var decl = -1;
    if assoc_at(start, &decl, tcx, pcx) != 0 && located(decl, tcx, pcx) {
        put_location(out, decl, tcx, pcx);
        return;
    }
    if param_at(start, pcx) != 0 && located(start, tcx, pcx) {
        put_location(out, start, tcx, pcx);
        return;
    }
    buf_str(out, c"null");
}

// The positions of a local's declaration and uses, in order, into out.
fn local_uses(decl: i64, out: inout IntVec, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        out.push(decl);
        let dt = token_at(decl, pcx);
        for n in 1..pcx.nodes.len() as i64 {
            if decl_of_use(n, tcx, pcx) != decl {
                continue;
            }
            let p = pcx.nodes[n].start;
            let t = token_at(p, pcx);
            if pcx.toks[t].start != p || pcx.toks[t].value != pcx.toks[dt].value {
                continue;
            }
            var seen = false;
            for k in 0..out.count {
                if out.data[k] == p {
                    seen = true;
                }
            }
            if !seen {
                out.push(p);
            }
        }
        sort_positions(&out);
    }
}

fn sort_positions(v: inout IntVec) {
    unsafe {
        let a = v.data;
        for i in 1..v.count {
            var j = i;
            while j > 0 && a[j] < a[j - 1] {
                let x = a[j];
                a[j] = a[j - 1];
                a[j - 1] = x;
                j -= 1;
            }
        }
    }
}

fn put_references(out: i64, pos: i64, with_decl: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let start = name_start(pos, pcx);
        let d = def_named_here(start, &tcx, &pcx);
        var at = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var item = 0;
        let l = if d >= 0 { -1 } else { local_named_at(start, &tcx, pcx) };
        let tp = if d >= 0 || l >= 0 { -1 } else { type_param_at(start, &item, pcx) };
        let root = if d >= 0 || l >= 0 || tp >= 0 { 0 } else { root_named_at(start, &tcx, pcx) };
        let t = token_starting(start, pcx);
        var adecl = -1;
        let none = d < 0 && l < 0 && tp < 0 && root == 0;
        let assoc = if none { assoc_at(start, &adecl, tcx, pcx) } else { 0 };
        let param = if none && assoc == 0 { param_at(start, pcx) } else { 0 };
        if d >= 0 {
            var i = 0;
            while i < tcx.all_refs.count {
                let p = tcx.all_refs.data[i];
                let def = (tcx.all_refs.data[i + 2] & QF_DEF) != 0;
                if tcx.all_refs.data[i + 1] == d && (with_decl || !def)
                    && (if def { located(p, tcx, pcx) } else { shown(p, tcx, pcx) }) {
                    at.push(p);
                }
                i += 3;
            }
            sort_positions(&at);
        } else if l >= 0 {
            var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            local_uses(l, &uses, tcx, pcx);
            for k in 0..uses.count {
                if (with_decl || uses.data[k] != l) && located(uses.data[k], tcx, pcx) {
                    at.push(uses.data[k]);
                }
            }
        } else if tp >= 0 {
            // (a type parameter: its name in the item declaring it)
            var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            same_name_in(t, pcx.nodes[item].start, pcx.nodes[item].end, &uses, pcx);
            for k in 0..uses.count {
                if (with_decl || uses.data[k] != tp) && located(uses.data[k], tcx, pcx) {
                    at.push(uses.data[k]);
                }
            }
        } else if root > 0 {
            root_uses(root, &at, &tcx, pcx);
        } else if assoc != 0 {
            assoc_uses(t, &at, tcx, pcx);
        } else if param != 0 {
            if with_decl {
                at.push(start);
            }
        } else if is_primitive(t, pcx) && !is_keyword(pcx.toks[t].kind as i64) {
            // (a primitive type: its name in the shown files)
            for u in 0..pcx.toks.len() as i64 {
                if pcx.toks[u].kind == Tok::Ident && pcx.toks[u].value == pcx.toks[t].value
                    && shown(pcx.toks[u].start, tcx, pcx) {
                    at.push(pcx.toks[u].start);
                }
            }
            sort_positions(&at);
        }
        buf_byte(out, '[');
        var last = -1;
        var first = true;
        for k in 0..at.count {
            if at.data[k] == last {
                continue;
            }
            last = at.data[k];
            if !first {
                buf_byte(out, ',');
            }
            first = false;
            put_location(out, at.data[k], tcx, pcx);
        }
        buf_byte(out, ']');
    }
}

// ---- hover

fn is_fn_kind(k: i64) -> bool {
    k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
}

// The function of definition d (its FNS index), or -1.
fn fn_of(d: i64, pcx: Ctx<Comp>) -> i64 {
    if !is_fn_kind(pcx.defs[d].kind) {
        return -1;
    }
    let f = pcx.nodes[pcx.defs[d].node].x - 1;
    if f < 0 || f >= pcx.fns.len() as i64 { -1 } else { f }
}

// ` (declared #[pure])` or ` (inferred)` after function f's effects, the
// instance named when there is one (`, of Vec<i64>::push`), then the line's
// end.
fn put_decl_note(md: i64, f: i64, instance: [u8], pcx: Ctx<Comp>) {
    let decl = pcx.fns[f].effect_decl;
    if decl != 0 {
        buf_str(md, c" (declared");
        var s = decl;
        while s != 0 {
            buf_byte(md, ' ');
            buf_decl(md, s, pcx);
            s = pcx.nodes[s].b;
        }
    } else {
        buf_str(md, c" (inferred");
    }
    if instance.len > 0 {
        buf_str(md, c", of ");
        buf_bytes(md, instance);
    }
    buf_str(md, c")\n");
}

// The function a call names at position start (the instance, for a
// generic function), or -1.
fn call_at(start: i64, pcx: Ctx<Comp>) -> i64 {
    if start < 0 {
        return -1;
    }
    for n in 1..pcx.nodes.len() as i64 {
        if pcx.nodes[n].kind != NodeKind::Call || pcx.nodes[n].x <= 0 || pcx.nodes[n].start > start
            || pcx.nodes[n].end <= start {
            continue;
        }
        let callee = pcx.nodes[n].a;
        if callee != 0 {
            if pcx.nodes[callee].start <= start && start < pcx.nodes[callee].end
                && token_start(pcx.nodes[callee].end - 1, pcx) == start {
                return pcx.nodes[n].x - 1;
            }
        } else if pcx.nodes[n].count > 0 && pcx.nodes[child(n, 0, pcx)].end <= start {
            return pcx.nodes[n].x - 1;
        }
    }
    -1
}

// Appends text cut to max bytes (at a character), `…` when cut.
fn put_cut(out: i64, s: [u8], max: i64) {
    if s.len as i64 <= max {
        buf_bytes(out, s);
        return;
    }
    var e = max - 1;
    while e > 0 && (s[e] & 192) == 128 {
        e -= 1;
    }
    buf_bytes(out, s[0..e]);
    buf_bytes(out, "…");
}

// Appends text with the root's directory dropped from the paths in it.
fn put_relative(out: i64, text: [u8], tcx: Tcx<Comp>) {
    let root = cstr(tcx.root_given);
    var d = root.len as i64;
    while d > 0 && root[d - 1] != '/' {
        d -= 1;
    }
    let dir = root[0..d];
    var i = 0;
    while i < text.len as i64 {
        if d > 0 && i + d <= text.len as i64 && text[i..i + d] == dir {
            i += d;
        } else {
            buf_byte(out, text[i]);
            i += 1;
        }
    }
}

// Appends text with each `<std>:LINE:COL` in it written as the place in
// std's file (`std.vl:286:37`), when std's files are written.
fn put_std_places(out: i64, text: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let tag = "<std>:";
        var i = 0;
        while i < text.len as i64 {
            if tcx.std_f >= 0 && i + tag.len as i64 < text.len as i64
                && text[i..i + tag.len as i64] == tag {
                var j = i + tag.len as i64;
                var line = 0;
                while j < text.len as i64 && text[j] >= '0' && text[j] <= '9' {
                    line = line * 10 + (text[j] - '0') as i64;
                    j += 1;
                }
                let first = tcx.first_line.data[tcx.std_f];
                if line > 0 && first + line - 1 < tcx.first_line.data[tcx.std_f + 1] {
                    let k = seg_at(tcx.answer_ls.data[first + line - 1], tcx, pcx);
                    if k >= 0 {
                        buf_bytes(out, segment_name(k, tcx));
                        buf_fmt(out,
                            format_args(":{}",
                                first + line - 1 - line_index(segment_from(k, tcx), tcx, pcx) + 1));
                        i = j;
                        continue;
                    }
                }
            }
            buf_byte(out, text[i]);
            i += 1;
        }
    }
}

// The reasons of f's effects, one line each (the first step of `query
// effects --why`), at most WHY_MAX.
fn put_why_lines(md: i64, f: i64, tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let e = fn_effects(f, pcx);
        var bits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var allocs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..pcx.allocators.count {
            if (e.allocs & (1 << i)) != 0 {
                bits.push(0);
                allocs.push(1 << i);
            }
        }
        let order: [i64; 6] = [EFF_ALLOC_EXTERN, EFF_IO, EFF_GLOBAL, EFF_PANIC, EFF_DIVERGE,
            EFF_UNSAFE];
        for k in 0..6 {
            if (e.bits & order[k]) != 0 {
                bits.push(order[k]);
                allocs.push(0);
            }
        }
        let shown = if bits.count < WHY_MAX { bits.count } else { WHY_MAX };
        for k in 0..shown {
            let line = buf_new();
            effect_name(line, bits.data[k], allocs.data[k], pcx);
            buf_str(line, c" ← ");
            let step = buf_new();
            step_text(step, f, bits.data[k], allocs.data[k], true, &pcx);
            let places = buf_new();
            put_std_places(places, buf_slice(step), tcx, pcx);
            put_relative(line, buf_slice(places), tcx);
            buf_str(md, c"- ");
            put_cut(md, buf_slice(line), WHY_LINE_MAX);
            buf_byte(md, '\n');
        }
        if bits.count > shown {
            buf_fmt(md,
                format_args("- ({} more: `volec query effects --why EFFECT`)\n",
                    bits.count - shown));
        }
    }
}

// The hover of definition d: its signature, a function's effects (declared
// or inferred, with their reasons) and features, its path. At a call of a
// generic function (inst: the instance called, else -1), the instance's.
pub fn hover_def(md: i64, d: i64, inst: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    buf_str(md, c"```vole\n");
    put_signature(md, d, tcx, pcx);
    buf_byte(md, '\n');
    let f = fn_of(d, pcx);
    var why = -1;
    if f >= 0 {
        let eff = buf_new();
        def_effects_text(eff, d, tcx, pcx);
        if buf_slice(eff).len > 0 {
            buf_str(md, c"effects: ");
            buf_bytes(md, buf_slice(eff));
            put_decl_note(md, f, "", pcx);
            why = f;
        } else if pcx.fns[f].generic != 0 && inst >= 0 && pcx.fns[inst].tmpl == f + 1
            && (fn_effects(inst, pcx).bits & EFF_UNKNOWN) == 0 {
            buf_str(md, c"effects: ");
            effects_text(md, fn_effects(inst, pcx), pcx);
            put_decl_note(md, f, sym_text(pcx.fns[inst].display, pcx), pcx);
            why = inst;
        } else if pcx.fns[f].generic != 0 {
            // (a generic function: its instances' sets)
            let lines = buf_new();
            def_effect_lines(lines, d, tcx, pcx);
            let t = buf_slice(lines);
            var n = 0;
            var i = 0;
            while i < t.len as i64 && n < 3 {
                var j = i;
                while j < t.len as i64 && t[j] != '\n' {
                    j += 1;
                }
                buf_str(md, c"effects of ");
                var tab = i;
                while tab < j && t[tab] != '\t' {
                    tab += 1;
                }
                put_std_places(md, t[i..tab], tcx, pcx);
                if tab < j {
                    buf_str(md, c": ");
                    buf_bytes(md, t[tab + 1..j]);
                }
                buf_byte(md, '\n');
                n += 1;
                i = j + 1;
            }
            if n == 0 {
                buf_str(md, c"effects: per instance (none checked)\n");
            }
        }
        let feat = buf_new();
        if put_def_features(feat, d, c"\n", tcx, pcx) {
            buf_bytes(md, buf_slice(feat)[1..buf_slice(feat).len]);
            buf_byte(md, '\n');
        } else {
            buf_str(md, c"features: none\n");
        }
    }
    buf_str(md, c"```\n");
    // (0.25.2) imported from C: the declaration in its header (its
    // effects have no reasons in the program)
    let o = c_origin_at(pcx.defs[d].name_pos, pcx);
    if o >= 0 {
        put_c_decl(md, o, &tcx, pcx);
    }
    if why >= 0 && o < 0
        && ((fn_effects(why, pcx).bits & EFF_VISIBLE) != 0 || fn_effects(why, pcx).allocs != 0) {
        put_why_lines(md, why, tcx, &pcx);
    }
    if o < 0 {
        // (an import's comment is volec's, not the header's)
        put_doc(md, d, pcx);
    }
    buf_str(md, c"\n`");
    buf_bytes(md, sym_text(pcx.defs[d].fqn, pcx));
    buf_str(md, c"` (");
    buf_str(md, kind_name(pcx.defs[d].kind));
    // (0.26.0: a field not marked `pub` is its module's)
    // (the root's are the whole program's)
    if pcx.defs[d].kind == K_FIELD && !pcx.defs[d].public && pcx.defs[d].module > 0
        && pcx.modules[pcx.defs[d].module].key >= 0 {
        buf_str(md, c", private to module ");
        buf_bytes(md, sym_text(pcx.modules[pcx.defs[d].module].key, pcx));
    }
    // (0.26.2: `pub(crate)`, `pub(super)`, `pub(in a)`)
    let written = crate::front::modules::vis::written_restriction(pcx.defs[d].start);
    if pcx.defs[d].public && written.len > 0 {
        buf_str(md, c", ");
        buf_bytes(md, written);
    }
    buf_str(md, c")\n");
}

// The comment right above definition d (its `//` lines, without the
// slashes; attribute lines left out), as a paragraph after an empty line.
pub fn put_doc(md: i64, d: i64, pcx: Ctx<Comp>) {
    let parent = pcx.defs[d].parent;
    if parent >= 0
        && line_start(pcx.defs[d].start, pcx) == line_start(pcx.defs[parent].start, pcx) {
        // (a field on its struct's line: the comment is the struct's)
        return;
    }
    let from = text_start(d, pcx);
    let to = line_start(pcx.defs[d].start, pcx);
    var p = from;
    var first = true;
    while p < to {
        var e = p;
        while e < to && SRC[e] != '\n' {
            e += 1;
        }
        var a = p;
        while a < e && (SRC[a] == ' ' || SRC[a] == '\t') {
            a += 1;
        }
        if a + 1 < e && SRC[a] == '/' && SRC[a + 1] == '/' {
            a += 2;
            if a < e && SRC[a] == ' ' {
                a += 1;
            }
            if first {
                buf_byte(md, '\n');
                first = false;
            }
            buf_bytes(md, SRC[a..e]);
            buf_byte(md, '\n');
        }
        p = e + 1;
    }
}

// A hover of a word's text: the word as code, then the text.
fn hover_word(md: i64, word: [u8], text: [u8]) {
    buf_str(md, c"```vole\n");
    buf_bytes(md, word);
    buf_str(md, c"\n```\n");
    buf_bytes(md, text);
    buf_byte(md, '\n');
}

// The hover of a type parameter declared at decl by item: its
// declaration (`T: Ord + Copy`) and the item's name.
fn hover_type_param(md: i64, decl: i64, item: i64, pcx: Ctx<Comp>) {
    buf_str(md, c"```vole\n");
    // (its tokens, to the `,` or `>` that ends it)
    var t = token_starting(decl, pcx);
    var depth = 0;
    var first = true;
    while t >= 0 && t < pcx.toks.len() as i64 {
        let k = pcx.toks[t].kind;
        if depth == 0 && (k == Tok::Comma || k == Tok::Gt) {
            break;
        }
        if k == Tok::Lt || k == Tok::LParen {
            depth += 1;
        } else if k == Tok::Gt || k == Tok::RParen {
            depth -= 1;
        }
        if !first && k != Tok::Comma && k != Tok::Colon && k != Tok::Gt && k != Tok::Lt
            && k != Tok::RParen && pcx.toks[t - 1].kind != Tok::Lt
            && pcx.toks[t - 1].kind != Tok::LParen {
            buf_byte(md, ' ');
        }
        buf_bytes(md, tok_text(t, pcx));
        first = false;
        t += 1;
    }
    buf_str(md, c"\n```\na type parameter");
    let name = pcx.nodes[item].a;
    let k = pcx.nodes[item].kind;
    if name > 0 && k != NodeKind::Impl {
        buf_str(md, c" of `");
        buf_bytes(md, sym_text(name, pcx));
        buf_byte(md, '`');
    } else if k == NodeKind::Impl {
        buf_str(md, c" of the impl block");
    }
    buf_byte(md, '\n');
}

// The hover of a local or an expression: its type (one per instance of a
// generic function).
fn hover_type(md: i64, pos: i64, start: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var at = pos;
        let l = local_named_at(start, &tcx, pcx);
        if l >= 0 && l == start {
            // (a declaration: the type of its first use)
            var uses = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            local_uses(l, &uses, tcx, pcx);
            if uses.count > 1 {
                at = uses.data[1];
            }
        }
        if tcx.typed == 0 as *TypedIndex {
            tcx.typed = alloc_array::<TypedIndex>(1);
            tcx.typed[0] = typed_index(pcx);
        }
        var found = typed_nodes_in(*tcx.typed, 1, at, 0, pcx);
        if l >= 0 {
            // (0.25: a local named there, not what the checker made at it,
            // a drop at its `let`, when it is one)
            var named = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..found.count {
                let n = found.data[i];
                let k = pcx.nodes[n].kind;
                if pcx.nodes[n].start == at
                    && (k == NodeKind::PatBind || k == NodeKind::Ident || k == NodeKind::Param) {
                    named.push(n);
                }
            }
            if named.count > 0 {
                found = named;
            }
        }
        let widened = &tcx.typed[0].widened;
        if found.count == 0 {
            return false;
        }
        buf_str(md, c"```vole\n");
        if l >= 0 {
            buf_bytes(md, SRC[l..token_end(l, pcx)]);
            buf_str(md, c": ");
        }
        var types = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..found.count {
            let n = found.data[i];
            let t = pcx.nodes[n].ty;
            var seen = false;
            for j in 0..types.count {
                if types.data[j] == t {
                    seen = true;
                }
            }
            if seen {
                continue;
            }
            if types.count == TYPES_MAX {
                // (0.25: a generic function of std has an instance per use)
                buf_str(md, c" | …");
                break;
            }
            if types.count > 0 {
                buf_str(md, c" | ");
            }
            types.push(t);
            buf_type(md, t, pcx);
            let to = widened.get(n + 1);
            if to > 0 {
                buf_str(md, c" (widened to ");
                buf_type(md, to, pcx);
                buf_byte(md, ')');
            }
        }
        buf_str(md, c"\n```\n");
        true
    }
}

// The hover at start, into md: false when there is none. In order: an
// attribute, a keyword, a definition (an operator's function), a type
// parameter, `std` or `crate`, a primitive type, a local's or an
// expression's type (`self` and `result` explained after theirs).
fn hover_at(md: i64, pos: i64, start: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    if start < 0 {
        return false;
    }
    let t = token_starting(start, pcx);
    let text = if t >= 0 { tok_text(t, pcx) } else { SRC[start..start] };
    let kind = if t >= 0 { pcx.toks[t].kind as i64 } else { -1 };
    if attribute_at(start, pcx) >= 0 && attribute_text(text).len > 0 {
        hover_word(md, text, attribute_text(text));
        return true;
    }
    let contract_word = text == "requires" || text == "ensures";
    if (is_keyword(kind) || contract_word) && keyword_text(text).len > 0 {
        hover_word(md, text, keyword_text(text));
        return true;
    }
    if is_keyword(kind) {
        return false;
    }
    let header = import_header_at(start, pcx);
    if header.len > 0 {
        // (0.25.2) the string of `import "h.h" as c;`: the header
        let name = text[1..text.len as i64 - 1];
        let relative = name.len > 1 && name[0] == '.'
            && (name[1] == '/' || name[1] == '.');
        buf_str(md, c"```c\n#include ");
        buf_byte(md, if relative { '"' } else { '<' });
        buf_bytes(md, name);
        buf_byte(md, if relative { '"' } else { '>' });
        buf_str(md, c"\n```\n`");
        buf_bytes(md, buf_slice(header_path(header)));
        buf_str(md, c"` (the header this import reads)\n");
        return true;
    }
    let d = def_named_at(start, &tcx, &pcx);
    if d >= 0 {
        hover_def(md, d, call_at(start, pcx), &tcx, &pcx);
        return true;
    }
    if kind == Tok::Ident as i64 && local_named_at(start, &tcx, pcx) < 0 {
        var item = 0;
        let tp = type_param_at(start, &item, pcx);
        if tp >= 0 {
            hover_type_param(md, tp, item, pcx);
            return true;
        }
        let root = root_named_at(start, &tcx, pcx);
        if root == 1 {
            hover_word(md, "mod std",
                "The standard library, built into the compiler; its most used names (the prelude: `Vec`, `println`, `Gpa`...) need no `use`. (`volec guide std`)");
            return true;
        } else if root == 2 {
            hover_word(md, "mod crate",
                "The program's root module: its `main.vl`. (`volec guide modules`)");
            return true;
        } else if root == 3 {
            hover_word(md, "super", "The module this one is in: `use super::name;` names its sibling's or its parent's item. (`volec guide modules`)");
            return true;
        } else if root == 4 {
            hover_word(md, "self", "This module: `use self::name;`. (`volec guide modules`)");
            return true;
        }
        var adecl = -1;
        let an = assoc_at(start, &adecl, tcx, pcx);
        if an != 0 {
            buf_str(md, c"```vole\n");
            let s = pcx.nodes[an].start;
            if !(s + 5 <= pcx.nodes[an].end && SRC[s..s + 5] == "type ") {
                buf_str(md, c"type ");
            }
            put_collapsed(md, s, pcx.nodes[an].end);
            buf_str(md, c"\n```\nan associated type (`volec guide traits`)\n");
            return true;
        }
        let pn = param_at(start, pcx);
        if pn != 0 {
            buf_str(md, c"```vole\n");
            put_collapsed(md, pcx.nodes[pn].start, pcx.nodes[pn].end);
            buf_str(md, c"\n```\na parameter\n");
            return true;
        }
        if bound_text(text).len > 0 {
            hover_word(md, text, bound_text(text));
            return true;
        }
        if text == "size_of" || text == "align_of" {
            hover_word(md, if text == "size_of" { "fn size_of(T) -> i64" } else { "fn align_of(T) -> i64" }, "The size (the alignment) of type T in bytes: a constant (built in; `volec guide c-interop`).");
            return true;
        }
        if t > 0 && pcx.toks[t - 1].kind == Tok::Dot && (text == "len" || text == "ptr") {
            // (a slice's or an array's own, no item)
            if text == "len" {
                hover_word(md, "fn len(self) -> usize",
                    "The length of a slice or an array, a `usize` (built in).");
            } else {
                hover_word(md, "ptr: *T",
                    "The address of a slice's first element, for C (built in; `guide c-interop`).");
            }
            return true;
        }
        if primitive_text(text).len > 0 {
            hover_word(md, text, primitive_text(text));
            return true;
        }
        let attr = enclosing_attribute(t, pcx);
        if attr >= 0 && attribute_text(tok_text(attr, pcx)).len > 0 {
            // (an attribute's argument: `C` of `#[repr(C)]`)
            hover_word(md, tok_text(attr, pcx), attribute_text(tok_text(attr, pcx)));
            return true;
        }
        if text != "self" && text != "Self" && text != "result" {
            return false;
        }
    }
    if kind == Tok::FHead as i64 || kind == Tok::FMid as i64 || kind == Tok::FTail as i64 {
        // (an f-string's text: no name)
        return false;
    }
    let typed = hover_type(md, pos, start, &tcx, pcx);
    if kind == Tok::Ident as i64 && (text == "self" || text == "Self" || text == "result") {
        if !typed {
            buf_str(md, c"```vole\n");
            buf_bytes(md, text);
            buf_str(md, c"\n```\n");
        }
        buf_bytes(md, keyword_text(text));
        buf_byte(md, '\n');
        return true;
    }
    typed
}

// (0.26.2) The start of the name at pos in a format literal's hole (`{n}`,
// `{:w$}`), the literal's token starting at start; -1 when pos is not on
// one (the literal's text, or no literal).
fn hole_word(start: i64, pos: i64, pcx: Ctx<Comp>) -> i64 {
    let t = token_at(start, pcx);
    if t >= pcx.toks.len() as i64 {
        return -1;
    }
    // UNSAFE: TOKS is the lexer's token table, a raw pointer (front/lexer).
    // SAFETY: t is token_at's answer, below TOK_COUNT (checked above).
    let tok = unsafe { pcx.toks[t] };
    if tok.kind != Tok::Str || tok.start != start {
        return -1;
    }
    if pos <= start || !is_ident_byte(SRC[pos]) {
        return -1;
    }
    var a = pos;
    while a > start && is_ident_byte(SRC[a - 1]) {
        a -= 1;
    }
    // Inside a hole: the nearest brace before the name opens one.
    var k = a - 1;
    while k > start && SRC[k] != '{' && SRC[k] != '}' {
        k -= 1;
    }
    if k <= start || SRC[k] != '{' || SRC[k - 1] == '{' { -1 } else { a }
}

fn put_hover(out: i64, pos: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    let start = token_start(pos, pcx);
    let md = buf_new();
    if !hover_at(md, pos, start, &tcx, &pcx) {
        buf_str(out, c"null");
        return;
    }
    buf_str(out, c"{\"contents\":{\"kind\":\"markdown\",\"value\":");
    buf_json_str(out, buf_slice(md));
    buf_byte(out, '}');
    let word = if start >= 0 { hole_word(start, pos, pcx) } else { -1 };
    if word >= 0 {
        var end = word;
        while is_ident_byte(SRC[end]) {
            end += 1;
        }
        buf_str(out, c",\"range\":");
        put_range(out, word, end, tcx, pcx);
    } else if start >= 0 {
        buf_str(out, c",\"range\":");
        put_range(out, start, token_end(start, pcx), tcx, pcx);
    }
    buf_byte(out, '}');
}

// ---- document symbols

// LSP's SymbolKind of a definition kind.
fn symbol_kind(k: i64) -> i64 {
    if k == K_FN { 12 } else if k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN { 6 }
    else if k == K_STRUCT { 23 } else if k == K_ENUM { 10 } else if k == K_VARIANT { 22 }
    else if k == K_FIELD { 8 } else if k == K_TRAIT { 11 } else if k == K_CONST { 14 }
    else if k == K_STATIC { 13 } else if k == K_ALIAS { 26 } else { 2 }
}

fn put_symbol(out: i64, d: i64, children: IntVec, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        buf_str(out, c"{\"name\":");
        let name = buf_new();
        let k = pcx.defs[d].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner > 0 {
            // (a function of an impl block: Type::f)
            buf_bytes(name, last_segment(sym_text(pcx.defs[d].owner, pcx)));
            buf_str(name, c"::");
        }
        buf_bytes(name, sym_text(pcx.defs[d].name, pcx));
        buf_json_str(out, buf_slice(name));
        buf_str(out, c",\"detail\":");
        let sig = buf_new();
        put_signature(sig, d, tcx, pcx);
        let s = buf_slice(sig);
        buf_json_str(out, s[0..if s.len > 200 { 200 } else { s.len as i64 }]);
        buf_fmt(out, format_args(",\"kind\":{},\"range\":", symbol_kind(k)));
        let from = if pcx.defs[d].start < pcx.defs[d].name_pos { pcx.defs[d].start }
            else { pcx.defs[d].name_pos };
        let to = if pcx.defs[d].end > pcx.defs[d].name_pos { pcx.defs[d].end }
            else { token_end(pcx.defs[d].name_pos, pcx) };
        put_range(out, from, to, tcx, pcx);
        buf_str(out, c",\"selectionRange\":");
        put_range(out, pcx.defs[d].name_pos, token_end(pcx.defs[d].name_pos, pcx), tcx, pcx);
        if children.count > 0 {
            buf_str(out, c",\"children\":[");
            let none = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for i in 0..children.count {
                if i > 0 {
                    buf_byte(out, ',');
                }
                put_symbol(out, children.data[i], none, tcx, pcx);
            }
            buf_byte(out, ']');
        }
        buf_byte(out, '}');
    }
}

// The symbols of the definitions named in from..to (a file, or a file of
// std's text).
fn put_symbols(out: i64, from: i64, to: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        var all = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            let p = pcx.defs[d].name_pos;
            if p >= from && p < to {
                all.push(d);
            }
        }
        sort_by_position(all, tcx, pcx);
        buf_byte(out, '[');
        var first = true;
        for i in 0..all.count {
            let d = all.data[i];
            let parent = pcx.defs[d].parent;
            if parent >= 0 && pcx.defs[parent].name_pos >= from && pcx.defs[parent].name_pos < to {
                continue;
            }
            var children = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            for j in 0..all.count {
                if pcx.defs[all.data[j]].parent == d {
                    children.push(all.data[j]);
                }
            }
            if !first {
                buf_byte(out, ',');
            }
            first = false;
            put_symbol(out, d, children, tcx, pcx);
        }
        buf_byte(out, ']');
    }
}

// ---- workspace symbols

// The answers of a workspace/symbol, at most.
const WS_MAX: i64 = 256;

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 as u8 } else { c }
}

// Whether query's characters are in name in order, case ignored (the
// match LSP's clients make).
fn fuzzy_match(query: [u8], name: [u8]) -> bool {
    var i = 0;
    for k in 0..name.len {
        if i < query.len as i64 && lower(query[i]) == lower(name[k]) {
            i += 1;
        }
    }
    i == query.len as i64
}

// Whether query is in name, case ignored (std's names: fewer, closer
// answers than fuzzy_match's).
fn contains_ci(name: [u8], query: [u8]) -> bool {
    var i = 0;
    while i + query.len as i64 <= name.len as i64 {
        var k = 0;
        while k < query.len as i64 && lower(name[i + k]) == lower(query[k]) {
            k += 1;
        }
        if k == query.len as i64 {
            return true;
        }
        i += 1;
    }
    false
}

// workspace/symbol: the definitions whose names match query, the
// program's first (its letters in order), then std's (holding it; not
// for an empty query), WS_MAX at most:
// `[{"name":..,"kind":..,"location":..,"containerName":..}]`.
fn put_workspace_symbols(out: i64, query: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) {
    buf_byte(out, '[');
    var n = 0;
    for pass in 0..2 {
        if pass == 1 && query.len == 0 {
            break;
        }
        for d in 0..pcx.defs.len() {
            if n >= WS_MAX {
                break;
            }
            let p = pcx.defs[d].name_pos;
            let mine = in_file(p, pcx);
            if (pass == 0) != mine || pass == 1 && seg_at(p, tcx, pcx) < 0
                || !(if mine { fuzzy_match(query, sym_text(pcx.defs[d].name, pcx)) }
                    else { contains_ci(sym_text(pcx.defs[d].name, pcx), query) }) {
                continue;
            }
            if n > 0 {
                buf_byte(out, ',');
            }
            n += 1;
            buf_str(out, c"{\"name\":");
            buf_json_str(out, sym_text(pcx.defs[d].name, pcx));
            buf_fmt(out, format_args(",\"kind\":{},\"location\":", symbol_kind(pcx.defs[d].kind)));
            put_location(out, p, tcx, pcx);
            let fqn = sym_text(pcx.defs[d].fqn, pcx);
            var e = fqn.len as i64;
            while e > 1 && !(fqn[e - 1] == ':' && fqn[e - 2] == ':') {
                e -= 1;
            }
            if e > 2 {
                buf_str(out, c",\"containerName\":");
                buf_json_str(out, fqn[0..e - 2]);
            }
            buf_byte(out, '}');
        }
    }
    buf_byte(out, ']');
}

// ---- diagnostics

// The diagnostic of recorded text at pos (`check`'s short form, split):
// `{"range":..,"severity":..,"code":..,"source":"volec","message":..,
// "relatedInformation":[the try: lines]}`, into out; false when it has
// no position in a file.
fn put_diagnostic(out: i64, pos: i64, text: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if !in_file(pos, pcx) {
            return false;
        }
        let short = buf_new();
        short_diagnostic(short, text, true);
        let s = buf_slice(short);
        // `[POSITION: ]SEVERITY[KIND] MESSAGE | help: .. | try: ..`
        var b = 0;
        while b < s.len as i64 && s[b] != '[' {
            b += 1;
        }
        var h = b;
        while h > 0 && s[h - 1] != ' ' {
            h -= 1;
        }
        var k = b;
        while k < s.len as i64 && s[k] != ']' {
            k += 1;
        }
        let severity = if b < s.len as i64 { s[h..b] } else { "error" };
        let code = if k < s.len as i64 { s[b + 1..k] } else { s[0..0] };
        let message = buf_new();
        var tries = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var from = if k + 2 <= s.len as i64 { k + 2 } else { s.len as i64 };
        var first = true;
        var i = from;
        while i <= s.len as i64 {
            if i == s.len as i64
                || (i + 3 <= s.len as i64 && s[i] == ' ' && s[i + 1] == '|' && s[i + 2] == ' ') {
                let part = s[from..i];
                if first {
                    buf_bytes(message, part);
                    first = false;
                } else if part.len > 5 && part[0..5] == "try: " {
                    tries.push(from);
                    tries.push(i);
                } else {
                    buf_byte(message, '\n');
                    buf_bytes(message, part);
                }
                from = i + 3;
                i += 3;
            } else {
                i += 1;
            }
        }
        buf_str(out, c"{\"range\":");
        put_range(out, pos, token_end(pos, pcx), tcx, pcx);
        buf_fmt(out,
            format_args(",\"severity\":{},\"code\":",
                if severity == "warning" { 2 } else if severity == "note" { 3 } else { 1 }));
        buf_json_str(out, code);
        buf_str(out, c",\"source\":\"volec\",\"message\":");
        buf_json_str(out, buf_slice(message));
        if tries.count > 0 {
            buf_str(out, c",\"relatedInformation\":[");
            var t = 0;
            while t < tries.count {
                if t > 0 {
                    buf_byte(out, ',');
                }
                buf_str(out, c"{\"location\":");
                put_location(out, pos, tcx, pcx);
                buf_str(out, c",\"message\":");
                buf_json_str(out, s[tries.data[t]..tries.data[t + 1]]);
                buf_byte(out, '}');
                t += 2;
            }
            buf_byte(out, ']');
        }
        buf_byte(out, '}');
        true
    }
}

// publishDiagnostics for every file with an error or a warning, then the
// end frame.
fn publish_diagnostics(tcx: Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.diag_short = true;
        var errors = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var warnings = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        diag_records(&errors, &warnings, &pcx);
        // (position, text) pairs, errors then warnings
        var recs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var i = 0;
        while i + 1 < errors.count {
            recs.push(errors.data[i]);
            recs.push(errors.data[i + 1]);
            i += 2;
        }
        i = 0;
        while i + 2 < warnings.count {
            recs.push(warnings.data[i]);
            recs.push(warnings.data[i + 1]);
            i += 3;
        }
        for f in 0..pcx.files.len() as i64 {
            let items = buf_new();
            var n = 0;
            var r = 0;
            while r < recs.count {
                let pos = recs.data[r];
                if pos >= pcx.files[f].start && pos <= pcx.files[f].end
                    && file_of_pos(pos, pcx) == f {
                    let one = buf_new();
                    if put_diagnostic(one, pos, buf_slice(recs.data[r + 1]), tcx, pcx) {
                        if n > 0 {
                            buf_byte(items, ',');
                        }
                        buf_bytes(items, buf_slice(one));
                        n += 1;
                    }
                }
                r += 2;
            }
            if n == 0 {
                continue;
            }
            let msg = buf_new();
            buf_str(msg, c"{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"");
            put_uri(msg, cstr(pcx.files[f].path));
            buf_str(msg, c"\",\"diagnostics\":[");
            buf_bytes(msg, buf_slice(items));
            buf_str(msg, c"]}}");
            send('n', buf_slice(msg), tcx);
        }
        send('e', "", tcx);
    }
}
