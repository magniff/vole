    EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_IO, EFF_PANIC, EFF_UNKNOWN, EFF_UNSAFE,
    EFF_VISIBLE, effects_text, fn_effects,
};
use crate::front::effects::check::buf_decl;
use crate::front::effects::why::{effect_name, step_text};
use crate::front::embed::{buf_path, embed_path};
use crate::front::embed::wgsl::WgslCx;
use crate::front::lexer::{Tok, is_ident_byte};
use crate::front::modules::file_of_pos;
use crate::front::types::buf_type;
use crate::middle::lower::ssa::HMap;
