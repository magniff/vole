// JSON read in place (0.24, the language server's messages): a value is
// its position in the text, a member is found by scanning its object, a
// string is decoded when it is asked for. Nothing is built: a message is
// read once, for a few fields. (Written with buf_json_str, base/json.)

use crate::base::{buf_byte, buf_new, buf_slice};
use crate::base::comp::Comp;

fn is_space(c: u8) -> bool {
    c == b' ' || c == b'\n' || c == b'\r' || c == b'\t'
}

// The first position at or after i that is not white space.
pub fn skip_space(s: &[u8], i: i64) -> i64 {
    let mut k = i;
    while k < s.len() as i64 && is_space(s[k as usize]) {
        k += 1;
    }
    k
}

// The end of the value at i (white space before it skipped); -1 when it
// is not one.
pub fn value_end(s: &[u8], i0: i64) -> i64 {
    if i0 < 0 {
        return -1;
    }
    let mut i = skip_space(s, i0);
    if i >= s.len() as i64 {
        return -1;
    }
    let c = s[i as usize];
    if c == b'"' {
        i += 1;
        while i < s.len() as i64 && s[i as usize] != b'"' {
            if s[i as usize] == 92 as u8 {
                i += 1;
            }
            i += 1;
        }
        return if i < s.len() as i64 { i + 1 } else { -1 };
    }
    if c == b'{' || c == b'[' {
        let mut depth: i64 = 0;
        while i < s.len() as i64 {
            let d = s[i as usize];
            if d == b'"' {
                let e = value_end(s, i);
                if e < 0 {
                    return -1;
                }
                i = e;
                continue;
            }
            if d == b'{' || d == b'[' {
                depth += 1;
            } else if d == b'}' || d == b']' {
                depth -= 1;
                if depth == 0 {
                    return i + 1;
                }
            }
            i += 1;
        }
        return -1;
    }
    let start = i;
    while i < s.len() as i64 && !is_space(s[i as usize]) && s[i as usize] != b','
        && s[i as usize] != b'}' && s[i as usize] != b']' {
        i += 1;
    }
    if i == start { -1 } else { i }
}

// The value of member `key` of the object at i, or -1 (also when i is -1
// or no object).
pub fn member(s: &[u8], i0: i64, key: &[u8]) -> i64 {
    if i0 < 0 {
        return -1;
    }
    let mut i = skip_space(s, i0);
    if i >= s.len() as i64 || s[i as usize] != b'{' {
        return -1;
    }
    i += 1;
    loop {
        i = skip_space(s, i);
        if i >= s.len() as i64 || s[i as usize] != b'"' {
            return -1;
        }
        let ke = value_end(s, i);
        if ke < 0 {
            return -1;
        }
        let k = &s[(i + 1) as usize..(ke - 1) as usize];
        i = skip_space(s, ke);
        if i >= s.len() as i64 || s[i as usize] != b':' {
            return -1;
        }
        let v = skip_space(s, i + 1);
        if k == key {
            return v;
        }
        let ve = value_end(s, v);
        if ve < 0 {
            return -1;
        }
        i = skip_space(s, ve);
        if i < s.len() as i64 && s[i as usize] == b',' {
            i += 1;
        }
    }
}

// The member at a path of keys, `a.b.c` (the keys hold no dot).
pub fn at_path(s: &[u8], i0: i64, path: &[u8]) -> i64 {
    let mut v = i0;
    let mut from: i64 = 0;
    for k in 0..path.len() as i64 + 1 {
        if k == path.len() as i64 || path[k as usize] == b'.' {
            v = member(s, v, &path[from as usize..k as usize]);
            from = k + 1;
        }
    }
    v
}

// The positions of the elements of the array at i, into out; false when
// it is no array.
pub fn elements(s: &[u8], i0: i64, out: &mut Vec<i64, Comp>) -> bool {
    if i0 < 0 {
        return false;
    }
    let mut i = skip_space(s, i0);
    if i >= s.len() as i64 || s[i as usize] != b'[' {
        return false;
    }
    i = skip_space(s, i + 1);
    if i < s.len() as i64 && s[i as usize] == b']' {
        return true;
    }
    loop {
        let v = skip_space(s, i);
        let e = value_end(s, v);
        if e < 0 {
            return false;
        }
        out.push(v);
        i = skip_space(s, e);
        if i < s.len() as i64 && s[i as usize] == b',' {
            i += 1;
        } else {
            return i < s.len() as i64 && s[i as usize] == b']';
        }
    }
}

// The text of the value at i, as written.
pub fn raw(s: &[u8], i: i64) -> &[u8] {
    let e = value_end(s, i);
    if e < 0 {
        return &s[0..0];
    }
    &s[skip_space(s, i) as usize..e as usize]
}

// The integer at i, or `none` when there is none.
pub fn int_at(s: &[u8], i0: i64, none: i64) -> i64 {
    if i0 < 0 {
        return none;
    }
    let mut i = skip_space(s, i0);
    let neg = i < s.len() as i64 && s[i as usize] == b'-';
    if neg {
        i += 1;
    }
    if i >= s.len() as i64 || s[i as usize] < b'0' || s[i as usize] > b'9' {
        return none;
    }
    let mut n: i64 = 0;
    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
        n = n * 10 + (s[i as usize] - b'0') as i64;
        i += 1;
    }
    if neg { -n } else { n }
}

// Whether the value at i is `true`.
pub fn is_true(s: &[u8], i: i64) -> bool {
    raw(s, i) == b"true"
}

fn hex_value(c: u8) -> i64 {
    if c >= b'0' && c <= b'9' {
        return (c - b'0') as i64;
    }
    if c >= b'a' && c <= b'f' {
        return (c - b'a') as i64 + 10;
    }
    if c >= b'A' && c <= b'F' {
        return (c - b'A') as i64 + 10;
    }
    -1
}

fn hex4(s: &[u8], i: i64) -> i64 {
    if i + 4 > s.len() as i64 {
        return -1;
    }
    let mut v: i64 = 0;
    for k in 0..4 {
        let h = hex_value(s[(i + k) as usize]);
        if h < 0 {
            return -1;
        }
        v = v * 16 + h;
    }
    v
}

// Code point cp in UTF-8 into out.
pub fn put_utf8(out: i64, cp: i64) {
    if cp < 128 {
        buf_byte(out, cp as u8);
    } else if cp < 2048 {
        buf_byte(out, (192 | (cp >> 6)) as u8);
        buf_byte(out, (128 | (cp & 63)) as u8);
    } else if cp < 65536 {
        buf_byte(out, (224 | (cp >> 12)) as u8);
        buf_byte(out, (128 | ((cp >> 6) & 63)) as u8);
        buf_byte(out, (128 | (cp & 63)) as u8);
    } else {
        buf_byte(out, (240 | (cp >> 18)) as u8);
        buf_byte(out, (128 | ((cp >> 12) & 63)) as u8);
        buf_byte(out, (128 | ((cp >> 6) & 63)) as u8);
        buf_byte(out, (128 | (cp & 63)) as u8);
    }
}

// The string at i, decoded, into out; false when it is no string.
pub fn str_into(s: &[u8], i0: i64, out: i64) -> bool {
    let e = value_end(s, i0);
    if e < 0 {
        return false;
    }
    let i = skip_space(s, i0);
    if s[i as usize] != b'"' {
        return false;
    }
    let mut k = i + 1;
    while k < e - 1 {
        let c = s[k as usize];
        if c != 92 as u8 {
            buf_byte(out, c);
            k += 1;
            continue;
        }
        let x = s[(k + 1) as usize];
        k += 2;
        if x == b'n' {
            buf_byte(out, b'\n');
        } else if x == b't' {
            buf_byte(out, b'\t');
        } else if x == b'r' {
            buf_byte(out, b'\r');
        } else if x == b'b' {
            buf_byte(out, 8 as u8);
        } else if x == b'f' {
            buf_byte(out, 12 as u8);
        } else if x == b'u' {
            let mut cp = hex4(s, k);
            if cp < 0 {
                return false;
            }
            k += 4;
            if cp >= 55296 && cp < 56320 && k + 6 <= e - 1 && s[k as usize] == 92 as u8
                && s[(k + 1) as usize] == b'u' {
                let lo = hex4(s, k + 2);
                if lo >= 56320 && lo < 57344 {
                    cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                    k += 6;
                }
            }
            put_utf8(out, cp);
        } else {
            buf_byte(out, x);
        }
    }
    true
}

// The string at i, decoded, in a new buffer (empty when it is none).
pub fn str_at(s: &[u8], i: i64) -> &[u8] {
    let b = buf_new();
    if !str_into(s, i, b) {
        return buf_slice(b);
    }
    buf_slice(b)
}
