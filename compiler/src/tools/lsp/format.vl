// textDocument/formatting and rangeFormatting (0.25.1, docs/lsp.md): the
// document's text as the editor has it (unsaved edits too), formatted by
// `volec fmt`'s engine (tools/fmt: format_source, the same style), in a
// child process (fork), so that what the engine and the parser leave in
// the tables never reaches the server or the workers it forks. A text
// that does not parse, or that fmt cannot lay out, gets no edits: broken
// code is never rewritten. The answer is one edit: the lines that differ,
// from the first to the last (an editor narrows it further; VS Code
// does).

use crate::base::{
    STDERR, _setjmp, alloc_zeroed, buf_append, buf_byte, buf_bytes, buf_clear, buf_copy, buf_fmt,
    buf_new, buf_str, load_sources,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::errors_mark;
use crate::base::json::buf_json_str;
use crate::front::ast::init_ast;
use crate::front::lexer::{init_lexer, lex_range};
use crate::front::parser::parse_program;
use crate::tools::ctx::{Tcx, cptrs};
use crate::tools::fmt::{format_ranges, format_source, generated};
use crate::tools::fmt::pieces::{bad_message, set_bad_message};
use crate::tools::lsp::{now_us, write_all};
use crate::tools::proc::{buf_cstr, write_file_if};

// UNSAFE: POSIX's fork, pipe, read, waitpid, unlink, getpid and _exit:
// formatting runs in a child, so that a text that does not parse cannot
// end the server.
// SAFETY: each declaration is the function's C prototype on the targets
// vole builds for (64-bit macOS and Linux: int and pid_t are i32, size_t
// u64, ssize_t i64; a mode_t is passed as an int, which both calling
// conventions pass alike); what a call must hold is said at the call.
extern "C" {
    fn fork() -> i32;
    fn pipe(fds: *mut i32) -> i32;
    fn close(fd: i32) -> i32;
    fn read(fd: i32, buf: *mut u8, n: u64) -> i64;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn getpid() -> i32;
    fn _exit(code: i32) -> !;
}

// ---- positions in a text

// The bytes of the UTF-8 sequence starting with c.
fn seq_len(c: u8) -> i64 {
    if c < 128 as u8 { 1 } else if c < 224 as u8 { 2 } else if c < 240 as u8 { 3 } else { 4 }
}

// The byte offset in text of (line, character), the character in UTF-8
// bytes (utf8) or UTF-16 units; the end of the line when the character is
// past it, the end of the text when the line is.
pub fn text_offset(text: &[u8], line: i64, ch: i64, utf8: bool) -> i64 {
    let mut p: i64 = 0;
    let mut l: i64 = 0;
    while l < line && p < text.len() as i64 {
        if text[p as usize] == b'\n' {
            l += 1;
        }
        p += 1;
    }
    if l < line {
        return text.len() as i64;
    }
    let mut units: i64 = 0;
    while p < text.len() as i64 && text[p as usize] != b'\n' && units < ch {
        let n = seq_len(text[p as usize]);
        units += if utf8 { n } else if n == 4 { 2 } else { 1 };
        p += n;
    }
    if p > text.len() as i64 { text.len() as i64 } else { p }
}

// `{"line":L,"character":C}` of byte offset at of text.
pub fn put_text_position(out: i64, text: &[u8], at: i64, utf8: bool) {
    let mut line: i64 = 0;
    let mut ls: i64 = 0;
    for i in 0..at {
        if text[i as usize] == b'\n' {
            line += 1;
            ls = i + 1;
        }
    }
    let mut units: i64 = 0;
    let mut p = ls;
    while p < at {
        let n = seq_len(text[p as usize]);
        units += if utf8 { n } else if n == 4 { 2 } else { 1 };
        p += n;
    }
    buf_fmt(out, format_args("{{\"line\":{line},\"character\":{units}}}"));
}

// ---- the answer

// The edits that make text `old` the text `new`, as a JSON array: one
// edit, from the start of the first line that differs to the end of the
// last (`[]` when they are the same).
pub fn put_edits(out: i64, old: &[u8], new: &[u8], utf8: bool) {
    // the common lines at the start
    let mut a: i64 = 0;
    let mut i: i64 = 0;
    while i < old.len() as i64 && i < new.len() as i64 && old[i as usize] == new[i as usize] {
        if old[i as usize] == b'\n' {
            a = i + 1;
        }
        i += 1;
    }
    if i == old.len() as i64 && i == new.len() as i64 {
        buf_str(out, c"[]");
        return;
    }
    // and at the end: j bytes, of which the last e after a line break
    // they share (whole lines, not into the common start)
    let mut j: i64 = 0;
    while j < old.len() as i64 - a && j < new.len() as i64 - a
        && old[(old.len() as i64 - 1 - j) as usize] == new[(new.len() as i64 - 1 - j) as usize] {
        j += 1;
    }
    let mut e: i64 = 0;
    let mut k = j - 1;
    while k > 0 {
        if old[(old.len() as i64 - k - 1) as usize] == b'\n' {
            e = k;
            break;
        }
        k -= 1;
    }
    buf_str(out, c"[{\"range\":{\"start\":");
    put_text_position(out, old, a, utf8);
    buf_str(out, c",\"end\":");
    put_text_position(out, old, old.len() as i64 - e, utf8);
    buf_str(out, c"},\"newText\":");
    buf_json_str(out, &new[a as usize..(new.len() as i64 - e) as usize]);
    buf_str(out, c"}]");
}

// ---- in the child

// Whether text parses as a file of a program (alone: the modules it
// names are not read), the file at path holding it.
fn parses(path: *mut u8, pcx: &mut Ctx<Comp>) -> bool {
    // UNSAFE: the front end's fatal errors return through setjmp/longjmp (a
    // C call) to the block pcx.err_bail names; load_sources takes the paths
    // as a raw array.
    // SAFETY: the jmp_buf is a new block of 512 bytes, more than a jmp_buf
    // on the targets vole builds for; this runs in the formatter's child,
    // which ends after it; done, the one local written after setjmp, is read
    // as false on the path a jump takes (it is written last); paths is a
    // list of one C string, alive for the call that copies it.
    unsafe {
        pcx.query = true;
        pcx.err_bail = alloc_zeroed(512);
        let mut done = false;
        if _setjmp(pcx.err_bail) == 0 {
            pcx.err_kind = c"tokenizer error";
            let mut paths = cptrs(1i64);
            (paths[0]) = path;
            load_sources(paths.as_mut_ptr(), 1, pcx);
            init_lexer(pcx);
            lex_range(pcx.files[0].start, pcx.files[0].end, false, pcx);
            lex_range(pcx.files[0].end, pcx.files[0].end, true, pcx);
            init_ast(pcx);
            pcx.err_kind = c"parser error";
            parse_program(pcx);
            done = true;
        }
        done && errors_mark(pcx) == 0
    }
}

// The formatted text into out (`1` then the text), or why there is none
// (`0` then the reason); ranges: byte offsets, in pairs (none: all).
// fmt's own entry points: format_source (a whole text), format_ranges.
fn format_in_child(text: &[u8], ranges: &[i64], scratch: &[u8], out: i64, tcx: &mut Tcx<Comp>,
    pcx: &mut Ctx<Comp>) {
    // UNSAFE: getpid and unlink are C's.
    // SAFETY: buf_cstr gives the scratch file's path as a C string.
    unsafe {
        if generated(text) {
            buf_str(out, c"0generated");
            return;
        }
        let path = buf_new();
        buf_bytes(path, scratch);
        buf_fmt(path, format_args("/fmt{}", getpid()));
        buf_str(path, crate::tools::lsp::SOURCE_EXT);
        let ok = write_file_if(buf_cstr(path), text) && parses(buf_cstr(path), pcx);
        unlink(buf_cstr(path));
        if !ok {
            buf_str(out, c"0does not parse");
            return;
        }
        set_bad_message(b"", tcx);
        let whole = ranges.len() == 0;
        let r = if whole { format_source(text, tcx, pcx) }
            else { format_ranges(text, ranges, tcx, pcx) };
        if r < 0 {
            buf_str(out, c"0");
            let m = bad_message(tcx);
            buf_bytes(out, if m.len() > 0 { m } else { b"formatted already" });
            return;
        }
        buf_byte(out, b'1');
        buf_append(out, r);
    }
}

// The edits formatting text (ranges: byte offsets in pairs, none: the
// whole text) into out, a JSON array; `[]` when nothing changes or it
// cannot be formatted. scratch: a directory for the child's file.
pub fn put_formatting(out: i64, text: &[u8], ranges: &[i64], scratch: &[u8], utf8: bool,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: pipe, fork, close, read, waitpid and _exit are C's: the text
    // is formatted in a child that writes the result to a pipe.
    // SAFETY: fds is a local of two i32s that pipe fills; each end is closed
    // once in the process that does not use it; the child ends with _exit;
    // chunk is a new block of 65536 bytes, read writes at most 65536 into
    // it, and from_raw_parts covers the n bytes it wrote (n > 0 there),
    // copied before the next read; st is a local that waitpid writes.
    unsafe {
        let t0 = now_us(pcx);
        let mut fds = [0 as i32, 0 as i32];
        if pipe(&mut fds[0]) != 0 {
            buf_str(out, c"[]");
            return;
        }
        let pid = fork();
        if pid == 0 {
            close((fds[0]));
            let r = buf_new();
            format_in_child(text, ranges, scratch, r, tcx, pcx);
            write_all((fds[1]), &buf_copy(r));
            _exit(0);
        }
        close((fds[1]));
        let got = buf_new();
        if pid > 0 {
            let chunk = alloc_zeroed(65536);
            loop {
                let n = read((fds[0]), chunk, 65536);
                if n <= 0 {
                    break;
                }
                buf_bytes(got,
                    std::slice::from_raw_parts(chunk.add((0) as usize), (n - (0)) as usize));
            }
            let mut st = 0 as i32;
            waitpid(pid, &mut st, 0);
        }
        close((fds[0]));
        let r = buf_copy(got);
        if r.len() > 0 && r[0] == b'1' {
            put_edits(out, text, &r[1..r.len()], utf8);
        } else {
            buf_str(out, c"[]");
        }
        if tcx.timing {
            let us = now_us(pcx) - t0;
            let line = buf_new();
            buf_str(line, c"lsp: format ");
            if r.len() > 0 && r[0] == b'0' {
                buf_str(line, c"(none: ");
                buf_bytes(line, &r[1..r.len()]);
                buf_str(line, c") ");
            }
            buf_fmt(line, format_args("{}.{} ms\n", us / 1000, (us % 1000) / 100));
            write_all(STDERR, &buf_copy(line));
        }
        buf_clear(got);
    }
}
