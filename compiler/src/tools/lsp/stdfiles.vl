// std's built-in text as files on disk (0.25, docs/lsp.md): std is in the
// compiler (front/stdsrc_rust.vl), so a definition in it has no file of the
// user's. The worker writes std's text once per compiler (its version and
// a hash of the text) to a cache directory, each of std's files at its
// path under compiler/std2 (std.vl, vec.vl, collections/mod.vl..., then
// rt/tail.vl, the end std2_tail adds), the files read-only, and answers with their
// file:// URIs: any client opens them. A position in std's text is one in
// such a file (a segment), line for line; the text between them (a
// module's banner and braces, embed.sh's) belongs to the next one.
//
// The directory: $XDG_CACHE_HOME/vole when it is set, else
// ~/Library/Caches/vole on macOS, ~/.cache/vole on Linux; in it
// std-VERSION-HASH/. It is made under another name and renamed, so a
// directory with that name is whole.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, cstr, get_bufs, get_src,
    getenv, realpath, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_elf;
use crate::front::stdtree::built_files_std2;
use crate::tools::ctx::Tcx;
use crate::tools::proc::{buf_cstr, read_file_if, write_file_if};

extern "C" {
    fn mkdir(path: *mut u8, mode: i32) -> i32;
    fn access(path: *mut u8, mode: i32) -> i32;
    fn rename(from: *mut u8, to: *mut u8) -> i32;
    fn chmod(path: *mut u8, mode: i32) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn rmdir(path: *mut u8) -> i32;
    fn getpid() -> i32;
}

// The directory the caches are in (a buffer: $XDG_CACHE_HOME/vole,
// ~/Library/Caches/vole, ~/.cache/vole; made first when `make`), its
// real path when it is there (as a client names the files: no `..`, no
// link); -1 when there is no home.
pub fn cache_base(make: bool) -> i64 {
    unsafe {
        let b = buf_new();
        let xdg = getenv(c"XDG_CACHE_HOME");
        if xdg != 0 as *mut u8 && (*xdg.add(0)) == b'/' {
            buf_str(b, xdg);
            buf_str(b, c"/vole");
        } else {
            let home = getenv(c"HOME");
            if home == 0 as *mut u8 || (*home.add(0)) != b'/' {
                return -1;
            }
            buf_str(b, home);
            buf_str(b, if get_elf() { c"/.cache/vole" } else { c"/Library/Caches/vole" });
        }
        if make {
            make_dirs(buf_slice(b));
        }
        let real = realpath(buf_cstr(b), 0 as *mut u8);
        if real == 0 as *mut u8 {
            return b;
        }
        let r = buf_new();
        buf_str(r, real);
        r
    }
}

// Whether path is a file of a std cache (`BASE/std-.../...`): the server
// asks the program it has about it.
pub fn is_std_path(path: &[u8]) -> bool {
    let base = cache_base(false);
    if base < 0 {
        return false;
    }
    let b = buf_slice(base);
    path.len() as i64 > b.len() as i64 + 5 && path[0..b.len()] == b
        && path[b.len() as i64 as usize..(b.len() as i64 + 5) as usize] == b"/std-"
}

// Makes directory path and the ones above it (errors ignored: the file
// written in it says).
fn make_dirs(path: &[u8]) {
    unsafe {
        for i in 1..path.len() as i64 + 1 {
            if i == path.len() as i64 || path[i as usize] == b'/' {
                let d = buf_new();
                buf_bytes(d, &path[0..i as usize]);
                mkdir(buf_cstr(d), 493);
            }
        }
    }
}

// The directory of path (without its `/`).
fn dir_of(path: &[u8]) -> &[u8] {
    let mut e = path.len() as i64;
    while e > 0 && path[(e - 1) as usize] != b'/' {
        e -= 1;
    }
    if e > 0 { &path[0..(e - 1) as usize] } else { &path[0..0] }
}

// Whether a banner of embed.sh starts at pos (`// ---- mod std::` or
// `// ---- end mod std::`).
fn banner_at(pos: i64, end: i64) -> bool {
    let a = "// ---- mod std::";
    let b = "// ---- end mod std::";
    pos + a.len() as i64 <= end
        && get_src()[pos as usize..(pos + a.len() as i64) as usize] == a.as_bytes()
        || pos + b.len() as i64 <= end
        && get_src()[pos as usize..(pos + b.len() as i64) as usize] == b.as_bytes()
}

fn add_segment(from: i64, to: i64, name: &[u8], tcx: &mut Tcx<Comp>) {
    let n = buf_new();
    buf_bytes(n, name);
    tcx.seg_from.push(from);
    tcx.seg_to.push(to);
    tcx.seg_name.push(n);
}

// std's segments (SEG_*), from std_files and the tail's lengths; false
// when the text is not the one they describe.
fn find_segments(f: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let base = pcx.files[f as usize].start;
        let len = pcx.files[f as usize].end - base;
        let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        built_files_std2(&mut starts, &mut names);
        if names.count == 0 || starts.count != names.count + 1
            || (*starts.data.add(names.count as usize)) > len {
            return false;
        }
        for k in 0..names.count {
            // (a file ends at the first banner after it: its first module's,
            // or its own module's end)
            let next = (*starts.data.add((k + 1) as usize));
            let mut p = (*starts.data.add(k as usize));
            let mut to = next;
            while p < next && to == next {
                if banner_at(base + p, pcx.files[f as usize].end) {
                    to = p;
                }
                while p < next && get_src()[(base + p) as usize] != b'\n' {
                    p += 1;
                }
                p += 1;
            }
            add_segment(base + (*starts.data.add(k as usize)), base + to,
                cstr((*names.data.add(k as usize)) as *mut u8), tcx);
        }
        // the end, what std2_tail adds after the files: std::__rt, the Gpa,
        // the system's module, one file
        let end = (*starts.data.add(names.count as usize));
        add_segment(base + end, pcx.files[f as usize].end, b"rt/tail.vl", tcx);
        true
    }
}

// 64-bit FNV-1a of SRC[from..to], 16 hex digits into b.
fn put_hash(b: i64, from: i64, to: i64) {
    let mut h: i64 = -3750763034362895579;
    for p in from..to {
        h = (h ^ get_src()[p as usize] as i64).wrapping_mul(1099511628211);
    }
    let hex = "0123456789abcdef";
    for k in 0..16 {
        buf_byte(b, hex[((h >> (60 - 4 * k)) & 15) as usize]);
    }
}

// The segments and the directory, std's files written when they are not
// there; false when std is not the built-in text (or no home).
pub fn std_files_ready(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if tcx.std_dir >= 0 {
            return true;
        }
        if tcx.std_f >= 0 {
            return false;
        }
        for f in 0..pcx.files.len() as i64 {
            if streq(pcx.files[f as usize].path, c"<std>") {
                tcx.std_f = f;
            }
        }
        if tcx.std_f < 0 {
            return false;
        }
        let f = tcx.std_f;
        let base = cache_base(true);
        if base < 0 || !find_segments(f, tcx, pcx) {
            tcx.std_f = -1;
            return false;
        }
        let dir = buf_new();
        buf_bytes(dir, buf_slice(base));
        buf_str(dir, c"/std-");
        buf_str(dir, crate::version());
        buf_byte(dir, b'-');
        put_hash(dir, pcx.files[f as usize].start, pcx.files[f as usize].end);
        let there = access(buf_cstr(dir), 0) == 0;
        if !(there && std_files_match(buf_slice(dir), tcx))
            && !write_std_files(buf_slice(dir), there, tcx) {
            tcx.std_f = -1;
            return false;
        }
        tcx.std_dir = dir;
        true
    }
}

// Writes the segments into a new directory, then renames it to dir (a
// directory there that is not std's text, `stale`, renamed away and
// removed first); whether dir then holds std's text.
fn write_std_files(dir: &[u8], stale: bool, tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let tmp = buf_new();
        buf_bytes(tmp, dir);
        buf_fmt(tmp, format_args(".tmp{}", getpid()));
        mkdir(buf_cstr(tmp), 493);
        for k in 0..tcx.seg_name.count {
            let p = segment_file(buf_slice(tmp), k, tcx);
            make_dirs(dir_of(buf_slice(p)));
            write_file_if(buf_cstr(p),
                &get_src()[
                    (*tcx.seg_from.data.add(k as usize)) as usize..(
                        *tcx.seg_to.data.add(k as usize)) as usize]);
            chmod(buf_cstr(p), 292);
        }
        let d = buf_new();
        buf_bytes(d, dir);
        if stale {
            let old = buf_new();
            buf_bytes(old, dir);
            buf_fmt(old, format_args(".stale{}", getpid()));
            if rename(buf_cstr(d), buf_cstr(old)) == 0 {
                remove_segments(buf_slice(old), tcx);
            }
        }
        if rename(buf_cstr(tmp), buf_cstr(d)) != 0 {
            // (another server wrote it first: this copy removed)
            remove_segments(buf_slice(tmp), tcx);
        }
        std_files_match(dir, tcx)
    }
}

// The path of segment k's file in directory dir (a buffer).
fn segment_file(dir: &[u8], k: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        let p = buf_new();
        buf_bytes(p, dir);
        buf_byte(p, b'/');
        buf_bytes(p, buf_slice((*tcx.seg_name.data.add(k as usize))));
        p
    }
}

// Whether directory dir holds std's text: each segment's file, the same
// bytes (a directory of the name that another compiler, or a hand, left
// otherwise is not used: no answer depends on what the cache held).
fn std_files_match(dir: &[u8], tcx: &Tcx<Comp>) -> bool {
    unsafe {
        let text = buf_new();
        for k in 0..tcx.seg_name.count {
            (*get_bufs().add(text as usize)).len = 0;
            if !read_file_if(buf_cstr(segment_file(dir, k, tcx)), text)
                || buf_slice(text)
                != &get_src()[
                    (*tcx.seg_from.data.add(k as usize)) as usize..(
                        *tcx.seg_to.data.add(k as usize)) as usize] {
                return false;
            }
        }
        true
    }
}

// Removes the segments' files from directory dir, then their directories
// and dir (what else is there stays).
fn remove_segments(dir: &[u8], tcx: &Tcx<Comp>) {
    unsafe {
        for k in 0..tcx.seg_name.count {
            unlink(buf_cstr(segment_file(dir, k, tcx)));
        }
        let mut k = tcx.seg_name.count - 1;
        while k >= 0 {
            let mut sub = dir_of(buf_slice(segment_file(dir, k, tcx)));
            while sub.len() > dir.len() {
                let s = buf_new();
                buf_bytes(s, sub);
                rmdir(buf_cstr(s));
                sub = dir_of(sub);
            }
            k -= 1;
        }
        let d = buf_new();
        buf_bytes(d, dir);
        rmdir(buf_cstr(d));
    }
}

// The segment of position pos in std's text (one in a banner: the next
// segment's), or -1 when pos is not in std's text.
pub fn segment_of(pos: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.std_dir < 0 || pos < pcx.files[tcx.std_f as usize].start
            || pos > pcx.files[tcx.std_f as usize].end {
            return -1;
        }
        for k in 0..tcx.seg_from.count {
            if pos < (*tcx.seg_to.data.add(k as usize)) || k + 1 == tcx.seg_from.count {
                return k;
            }
        }
        -1
    }
}

pub fn segment_from(k: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe { (*tcx.seg_from.data.add(k as usize)) }
}

pub fn segment_to(k: i64, tcx: &Tcx<Comp>) -> i64 {
    unsafe { (*tcx.seg_to.data.add(k as usize)) }
}

// The path of segment k's file into b.
pub fn put_segment_path(b: i64, k: i64, tcx: &Tcx<Comp>) {
    unsafe {
        buf_bytes(b, buf_slice(tcx.std_dir));
        buf_byte(b, b'/');
        buf_bytes(b, buf_slice((*tcx.seg_name.data.add(k as usize))));
    }
}

// The path of segment k's file under the directory (`std.vl`,
// `collections/hash_map.vl`).
pub fn segment_name(k: i64, tcx: &Tcx<Comp>) -> &[u8] {
    unsafe { buf_slice((*tcx.seg_name.data.add(k as usize))) }
}

// The segment whose file is at path, or -1.
pub fn segment_by_path(path: &[u8], tcx: &Tcx<Comp>) -> i64 {
    unsafe {
        if tcx.std_dir < 0 {
            return -1;
        }
        let d = buf_slice(tcx.std_dir);
        if path.len() as i64 <= d.len() as i64 + 1 || &path[0..d.len()] != d
            || path[d.len()] != b'/' {
            return -1;
        }
        let rest = &path[(d.len() as i64 + 1) as usize..];
        for k in 0..tcx.seg_name.count {
            if buf_slice((*tcx.seg_name.data.add(k as usize))) == rest {
                return k;
            }
        }
        -1
    }
}

pub fn segment_count(tcx: &Tcx<Comp>) -> i64 {
    tcx.seg_name.count
}
