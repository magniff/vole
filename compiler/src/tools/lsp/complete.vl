// textDocument/completion and completionItem/resolve (0.25.1, docs/lsp.md),
// in the worker (answer.vl). The editor's text is usually not a program
// while it is typed (`v.` with nothing after it), and reading the program
// again for each keystroke costs the front end's time; so completion reads
// the text it is given with a small lexer of its own (the tokens up to the
// cursor: what is typed, and where), and asks the program the worker read
// last (perhaps an edit behind) for the rest: the types of the locals
// (where a local of the text is at a place the edit did not touch, the
// program's local there), the definitions (DEFS), their members.
//
// What is completed:
// - after `.`: the receiver's fields and methods (its impl blocks', its
//   traits' and their default methods, std's: `str`'s for a String, a
//   slice's for an array), the receiver's type found from the program (a
//   local, a field, a method's result, a call's, a literal), or from the
//   text (`let v: T`, `let v = Vec::new_in(gpa)`, `for x in v`);
// - after `::`: a module's items, an enum's variants, a type's associated
//   functions, std's modules and items (`std::`, `Vec::`, `use a::b::{`);
// - a name: the locals and parameters in scope (from the text), the
//   module's items, the names it imports, the prelude, the keywords, and
//   snippets of the common forms.
//
// Ranked: names starting with what is typed first, then those of the type
// the place expects (`let x: T = `, `return `), then locals before members
// before the module's items before imports before std's. Each item's
// `data` names its definition by its path (the same in every worker), so
// that resolve adds the hover's text: the signature, effects (and why),
// the comment above it.

use crate::base::{
    IntVec, SRC, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, find_sym, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::json::buf_json_str;
use crate::front::ast::{NodeKind, child};
use crate::front::check::calls::method_of;
use crate::front::modules::{child_module, module_at, module_count};
use crate::front::modules::lookup::{PRELUDE_COUNT, prelude_name};
use crate::front::types::{
    ENUMS, TLISTS, TYPES, TY_BOOL, TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE, TY_U16,
    TY_U32, TY_U64, TY_U8, TY_USIZE, TyKind, buf_type, find_field, fn_param, struct_field,
    type_elem,
};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::lsp::format::text_offset;
use crate::tools::query::defs::{
    K_ALIAS, K_CONST, K_ENUM, K_FIELD, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STATIC, K_STRUCT,
    K_TRAIT, K_TRAIT_FN, K_VARIANT, def_of_node, mod_fqn,
};
use crate::tools::query::show::put_signature;

// ---- the text's tokens

const T_ID: i64 = 1;
const T_NUM: i64 = 2;
const T_STR: i64 = 3;
const T_CHR: i64 = 4;
const T_P: i64 = 5;

// The text asked about, the cursor in it (a byte offset).
static var TX: [u8] = "";

fn is_id0(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

fn is_id(c: u8) -> bool {
    is_id0(c) || c >= '0' && c <= '9'
}

fn push_tok(kind: i64, s: i64, e: i64, tcx: inout Tcx<Comp>) {
    tcx.tk.push(kind);
    tcx.ts.push(s);
    tcx.te.push(e);
}

// A comment or literal from s to e: whether the cursor is in it (`open`:
// it is not closed, the cursor at its end is in it).
fn note_literal(s: i64, e: i64, open: bool, tcx: inout Tcx<Comp>) {
    if tcx.complete_cur > s && (tcx.complete_cur < e || open && tcx.complete_cur == e) {
        tcx.in_text = true;
    }
}

// Whether t[p..] starts with `"""` (a text block's delimiter, 0.25.3).
fn triple_quote(t: [u8], p: i64) -> bool {
    p >= 0 && p + 2 < t.len as i64 && t[p] == '"' && t[p + 1] == '"' && t[p + 2] == '"'
}

// A string literal from its quote at p (its prefix at s); the end.
fn lex_string(s: i64, p0: i64, tcx: inout Tcx<Comp>) -> i64 {
    let t = TX;
    if triple_quote(t, p0) {
        // (0.25.4) a text block, `"""` to the next `"""`
        var q = p0 + 3;
        while q < t.len as i64 && !triple_quote(t, q) {
            q += 1;
        }
        let e = if q < t.len as i64 { q + 3 } else { t.len as i64 };
        push_tok(T_STR, s, e, &tcx);
        note_literal(s, e, q >= t.len as i64, &tcx);
        return e;
    }
    var p = p0 + 1;
    while p < t.len as i64 && t[p] != '"' {
        p += if t[p] == '\\' { 2 } else { 1 };
    }
    let closed = p < t.len as i64;
    let e = if closed { p + 1 } else { t.len as i64 };
    push_tok(T_STR, s, e, &tcx);
    note_literal(s, e, !closed, &tcx);
    e
}

// An f-string from its `f` at s: its text as T_STR pieces, its holes'
// tokens between them; the end.
fn lex_fstring(s: i64, tcx: inout Tcx<Comp>) -> i64 {
    let t = TX;
    // (0.25.4) `f"""`, a text block: a quote is text in it
    let block = triple_quote(t, s + 1);
    var p = s + if block { 4 } else { 2 };
    var piece = s;
    loop {
        if p >= t.len as i64 {
            push_tok(T_STR, piece, t.len as i64, &tcx);
            note_literal(piece, t.len as i64, true, &tcx);
            return t.len as i64;
        }
        let c = t[p];
        if c == '\\' {
            p += 2;
        } else if (c == '{' || c == '}') && p + 1 < t.len as i64 && t[p + 1] == c {
            p += 2;
        } else if c == '{' {
            push_tok(T_STR, piece, p + 1, &tcx);
            note_literal(piece, p + 1, false, &tcx);
            p = lex_code(p + 1, true, &tcx);
            piece = p - 1;
        } else if c == '"' && (!block || triple_quote(t, p)) {
            let e = p + if block { 3 } else { 1 };
            push_tok(T_STR, piece, e, &tcx);
            note_literal(piece, e, false, &tcx);
            return e;
        } else {
            p += 1;
        }
    }
}

// The length of the operator at p (`::`, `->`, `..=`...).
fn op_len(p: i64) -> i64 {
    let t = TX;
    if p + 1 >= t.len as i64 {
        return 1;
    }
    let a = t[p];
    let b = t[p + 1];
    if p + 2 < t.len as i64 {
        let c = t[p + 2];
        if a == '.' && b == '.' && (c == '=' || c == '.') || a == '<' && b == '<' && c == '='
            || a == '>' && b == '>' && c == '=' {
            return 3;
        }
    }
    if a == ':' && b == ':' || a == '-' && b == '>' || a == '=' && b == '>'
        || a == '.' && b == '.' || a == '|' && b == '|' || a == '&' && b == '&'
        || b == '=' && (a == '=' || a == '!' || a == '<' || a == '>' || a == '+' || a == '-'
            || a == '*' || a == '/' || a == '%' || a == '&' || a == '|' || a == '^')
        || a == '<' && b == '<' || a == '>' && b == '>' {
        return 2;
    }
    1
}

// Lexes code from p0 to the end of the text (in_hole: to the `}` closing
// an f-string's hole; the position after it).
fn lex_code(p0: i64, in_hole: bool, tcx: inout Tcx<Comp>) -> i64 {
    let t = TX;
    var p = p0;
    var depth = 0;
    while p < t.len as i64 {
        let c = t[p];
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            p += 1;
        } else if c == '/' && p + 1 < t.len as i64 && t[p + 1] == '/' {
            let s = p;
            while p < t.len as i64 && t[p] != '\n' {
                p += 1;
            }
            note_literal(s, p, true, &tcx);
        } else if c == '/' && p + 1 < t.len as i64 && t[p + 1] == '*' {
            let s = p;
            p += 2;
            var nest = 1;
            while p < t.len as i64 && nest > 0 {
                if p + 1 < t.len as i64 && t[p] == '/' && t[p + 1] == '*' {
                    nest += 1;
                    p += 2;
                } else if p + 1 < t.len as i64 && t[p] == '*' && t[p + 1] == '/' {
                    nest -= 1;
                    p += 2;
                } else {
                    p += 1;
                }
            }
            note_literal(s, p, nest > 0, &tcx);
        } else if c == 'f' && p + 1 < t.len as i64 && t[p + 1] == '"' {
            p = lex_fstring(p, &tcx);
        } else if (c == 'c' || c == 'b' || c == 'r') && p + 1 < t.len as i64 && t[p + 1] == '"'
            && (p == 0 || !is_id(t[p - 1])) {
            p = lex_string(p, p + 1, &tcx);
        } else if c == '"' {
            p = lex_string(p, p, &tcx);
        } else if c == '\'' && p + 2 < t.len as i64
            && (t[p + 1] == '\\' && p + 3 < t.len as i64 || t[p + 2] == '\'') {
            let s = p;
            p += if t[p + 1] == '\\' { 3 } else { 2 };
            while p < t.len as i64 && t[p] != '\'' && t[p] != '\n' {
                p += 1;
            }
            if p < t.len as i64 && t[p] == '\'' {
                p += 1;
            }
            push_tok(T_CHR, s, p, &tcx);
            note_literal(s, p, false, &tcx);
        } else if is_id0(c) {
            let s = p;
            while p < t.len as i64 && is_id(t[p]) {
                p += 1;
            }
            push_tok(T_ID, s, p, &tcx);
        } else if c >= '0' && c <= '9' {
            let s = p;
            while p < t.len as i64 && (is_id(t[p])
                || t[p] == '.' && p + 1 < t.len as i64 && t[p + 1] >= '0' && t[p + 1] <= '9'
                && (p == s || t[p - 1] != '.')) {
                p += 1;
            }
            push_tok(T_NUM, s, p, &tcx);
        } else {
            if in_hole && c == '{' {
                depth += 1;
            } else if in_hole && c == '}' {
                if depth == 0 {
                    return p + 1;
                }
                depth -= 1;
            }
            let n = op_len(p);
            push_tok(T_P, p, p + n, &tcx);
            p += n;
        }
    }
    p
}

fn tok_text(i: i64, tcx: Tcx<Comp>) -> [u8] {
    TX[tcx.ts.get(i)..tcx.te.get(i)]
}

// Whether token i is `s` (a word or an operator).
fn tok_is(i: i64, s: [u8], tcx: Tcx<Comp>) -> bool {
    i >= 0 && i < tcx.tk.count && tok_text(i, tcx) == s
}

fn is_ident(i: i64, tcx: Tcx<Comp>) -> bool {
    i >= 0 && i < tcx.tk.count && tcx.tk.get(i) == T_ID
}

// The bracket matching the opener at i (searching forward up to `to`),
// or `to` when it is not closed.
fn match_fwd(i: i64, to: i64, tcx: Tcx<Comp>) -> i64 {
    var depth = 0;
    var j = i;
    while j < to {
        let s = tok_text(j, tcx);
        if tcx.tk.get(j) == T_P {
            if s == "(" || s == "[" || s == "{" {
                depth += 1;
            } else if s == ")" || s == "]" || s == "}" {
                depth -= 1;
                if depth == 0 {
                    return j;
                }
            }
        }
        j += 1;
    }
    to
}

// The bracket matching the closer at i, or -1.
fn match_back(i: i64, tcx: Tcx<Comp>) -> i64 {
    var depth = 0;
    var j = i;
    while j >= 0 {
        if tcx.tk.get(j) == T_P {
            let s = tok_text(j, tcx);
            if s == ")" || s == "]" || s == "}" {
                depth += 1;
            } else if s == "(" || s == "[" || s == "{" {
                depth -= 1;
                if depth == 0 {
                    return j;
                }
            }
        }
        j -= 1;
    }
    -1
}

const KEYWORDS: [[u8]; 36] = ["fn", "let", "var", "inout", "sink", "struct", "enum", "trait",
    "impl", "match", "if", "else", "loop", "while", "for", "in", "break", "continue", "return",
    "true", "false", "as", "extern", "const", "static", "type", "use", "pub", "mod", "defer",
    "unsafe", "move", "self", "Self", "requires", "ensures"];

fn is_keyword(s: [u8]) -> bool {
    for i in 0..36 {
        if KEYWORDS[i] == s {
            return true;
        }
    }
    s == "mut" || s == "crate" || s == "super" || s == "import"
}

// ---- the bindings in scope at the cursor (from the text)

fn add_binding(name: i64, depth: i64, ann: i64, ann_end: i64, init: i64, init_end: i64,
    iter: bool, tcx: inout Tcx<Comp>) {
    tcx.complete_b_name.push(name);
    tcx.b_depth.push(depth);
    tcx.b_ann.push(ann);
    tcx.b_ann_end.push(ann_end);
    tcx.b_init.push(init);
    tcx.b_init_end.push(init_end);
    tcx.b_iter.push(if iter { 1 } else { 0 });
}

// Whether token i names a binding in a pattern: a lower-case word that
// is not a keyword, a path's part, a call's or a struct's name.
fn binds(i: i64, tcx: Tcx<Comp>) -> bool {
    if !is_ident(i, tcx) {
        return false;
    }
    let s = tok_text(i, tcx);
    if s[0] >= 'A' && s[0] <= 'Z' || is_keyword(s) || s == "_" {
        return false;
    }
    let next = i + 1;
    if next < tcx.tk.count
        && (tok_is(next, "(", tcx) || tok_is(next, "::", tcx) || tok_is(next, "{", tcx)
            || tok_is(next, "!", tcx)) {
        return false;
    }
    !(i > 0 && (tok_is(i - 1, "::", tcx) || tok_is(i - 1, ".", tcx)))
}

// The end of the tokens from i up to (not with) one of the stops at
// nesting 0, or to: the index of the stop.
fn until_stop(i: i64, to: i64, stops: [[u8]], angles: bool, tcx: Tcx<Comp>) -> i64 {
    var depth = 0;
    var j = i;
    while j < to {
        let s = tok_text(j, tcx);
        if depth == 0 {
            for k in 0..stops.len {
                if s == stops[k] {
                    return j;
                }
            }
        }
        if s == "(" || s == "[" || s == "{" || angles && s == "<" {
            depth += 1;
        } else if s == ")" || s == "]" || s == "}" || angles && s == ">" {
            if depth == 0 {
                return j;
            }
            depth -= 1;
        } else if angles && s == ">>" {
            depth -= 2;
            if depth < 0 {
                return j;
            }
        }
        j += 1;
    }
    to
}

// The pattern's names, from i up to `end`, as bindings at depth.
fn pattern_bindings(i: i64, end: i64, depth: i64, init: i64, init_end: i64, iter: bool,
    tcx: inout Tcx<Comp>) {
    // (a single name: its value and type are known)
    var j = i;
    while j < end && (tok_is(j, "mut", tcx) || tok_is(j, "ref", tcx)) {
        j += 1;
    }
    if j + 1 == end && binds(j, tcx) {
        add_binding(j, depth, -1, -1, init, init_end, iter, &tcx);
        return;
    }
    while j < end {
        if binds(j, tcx) && !tok_is(j + 1, ":", tcx) || binds(j, tcx) && j + 1 == end {
            add_binding(j, depth, -1, -1, -1, -1, false, &tcx);
        }
        j += 1;
    }
}

// A function's header at token i (`fn`): its parameters are bound when
// its body opens; the index of its last token read.
fn fn_header(i: i64, depth: i64, tcx: inout Tcx<Comp>) -> i64 {
    tcx.q_name.count = 0;
    tcx.q_ann.count = 0;
    tcx.q_ann_end.count = 0;
    tcx.q_depth = depth;
    tcx.q_ret = -1;
    tcx.q_ret_end = -1;
    var j = i + 1;
    if is_ident(j, tcx) {
        j += 1;
    }
    if tok_is(j, "<", tcx) {
        j = until_stop(j + 1, tcx.nt, [">"], true, tcx) + 1;
    }
    if !tok_is(j, "(", tcx) {
        return j - 1;
    }
    let close = until_stop(j + 1, tcx.nt, [")"], true, tcx);
    var p = j + 1;
    while p < close {
        let e = until_stop(p, close, [","], true, tcx);
        let colon = until_stop(p, e, [":"], true, tcx);
        if colon < e {
            // `name: [conv] Type`
            var n = colon - 1;
            if binds(n, tcx) || tok_is(n, "self", tcx) {
                var a = colon + 1;
                while a < e
                    && (tok_is(a, "inout", tcx) || tok_is(a, "sink", tcx) || tok_is(a, "let", tcx)
                        || tok_is(a, "var", tcx) || tok_is(a, "mut", tcx)) {
                    a += 1;
                }
                tcx.q_name.push(n);
                tcx.q_ann.push(a);
                tcx.q_ann_end.push(e);
            }
        } else if e > p && tok_is(e - 1, "self", tcx) {
            tcx.q_name.push(e - 1);
            tcx.q_ann.push(-1);
            tcx.q_ann_end.push(-1);
        }
        p = e + 1;
    }
    if close >= tcx.nt {
        return tcx.nt;
    }
    var k = close + 1;
    if tok_is(k, "->", tcx) {
        let e = until_stop(k + 1, tcx.nt, ["{", ";", "requires", "ensures", "where"], true, tcx);
        tcx.q_ret = k + 1;
        tcx.q_ret_end = e;
        k = e;
    }
    k - 1
}

// The bindings in scope at the cursor (B_*), the functions and impls it is
// in (F_*, I_*): the tokens before it read once.
fn scan_bindings(tcx: inout Tcx<Comp>) {
    unsafe {
        tcx.complete_b_name.count = 0;
        tcx.b_depth.count = 0;
        tcx.b_ann.count = 0;
        tcx.b_ann_end.count = 0;
        tcx.b_init.count = 0;
        tcx.b_init_end.count = 0;
        tcx.b_iter.count = 0;
        tcx.f_depth.count = 0;
        tcx.f_ret.count = 0;
        tcx.f_ret_end.count = 0;
        tcx.i_depth.count = 0;
        tcx.i_type.count = 0;
        tcx.q_depth = -1;
        tcx.pending_impl = -1;
        var depth = 0;
        var i = 0;
        while i < tcx.nt {
            let s = tok_text(i, tcx);
            let kind = tcx.tk.data[i];
            if kind == T_P && s == "{" {
                depth += 1;
                if tcx.q_depth >= 0 && tcx.q_depth == depth - 1 {
                    for q in 0..tcx.q_name.count {
                        add_binding(tcx.q_name.data[q], depth, tcx.q_ann.data[q],
                            tcx.q_ann_end.data[q], -1, -1, false, &tcx);
                    }
                    tcx.f_depth.push(depth);
                    tcx.f_ret.push(tcx.q_ret);
                    tcx.f_ret_end.push(tcx.q_ret_end);
                    tcx.q_depth = -1;
                }
                if tcx.pending_impl >= 0 {
                    tcx.i_depth.push(depth);
                    tcx.i_type.push(tcx.pending_impl);
                    tcx.pending_impl = -1;
                }
            } else if kind == T_P && s == "}" {
                while tcx.b_depth.count > 0 && tcx.b_depth.data[tcx.b_depth.count - 1] >= depth {
                    tcx.complete_b_name.count -= 1;
                    tcx.b_depth.count -= 1;
                    tcx.b_ann.count -= 1;
                    tcx.b_ann_end.count -= 1;
                    tcx.b_init.count -= 1;
                    tcx.b_init_end.count -= 1;
                    tcx.b_iter.count -= 1;
                }
                while tcx.f_depth.count > 0 && tcx.f_depth.data[tcx.f_depth.count - 1] >= depth {
                    tcx.f_depth.count -= 1;
                    tcx.f_ret.count -= 1;
                    tcx.f_ret_end.count -= 1;
                }
                while tcx.i_depth.count > 0 && tcx.i_depth.data[tcx.i_depth.count - 1] >= depth {
                    tcx.i_depth.count -= 1;
                    tcx.i_type.count -= 1;
                }
                if depth > 0 {
                    depth -= 1;
                }
            } else if kind == T_P && s == ";" {
                if tcx.q_depth == depth {
                    tcx.q_depth = -1;
                }
            } else if kind == T_ID && s == "fn" {
                i = fn_header(i, depth, &tcx);
            } else if kind == T_ID && s == "impl" {
                // `impl<T> Tr for Ty<T>`: Ty's name
                var j = i + 1;
                if tok_is(j, "<", tcx) {
                    j = until_stop(j + 1, tcx.nt, [">"], true, tcx) + 1;
                }
                let e = until_stop(j, tcx.nt, ["{", ";"], true, tcx);
                var name = -1;
                var k = j;
                while k < e {
                    if tok_is(k, "for", tcx) {
                        name = -1;
                    } else if is_ident(k, tcx) && name < 0 && !tok_is(k, "for", tcx) {
                        name = k;
                        while tok_is(name + 1, "::", tcx) && is_ident(name + 2, tcx) {
                            name += 2;
                        }
                    }
                    k += 1;
                }
                tcx.pending_impl = name;
            } else if kind == T_ID && (s == "let" || s == "var"
                || s == "inout" && i > 0 && (tok_is(i - 1, ";", tcx) || tok_is(i - 1, "{", tcx)
                    || tok_is(i - 1, "}", tcx))) {
                let e = until_stop(i + 1, tcx.nt, [":", "=", ";"], false, tcx);
                var ann = -1;
                var ann_end = -1;
                var init = -1;
                var init_end = -1;
                var k = e;
                if tok_is(k, ":", tcx) {
                    ann = k + 1;
                    ann_end = until_stop(k + 1, tcx.nt, ["=", ";"], true, tcx);
                    k = ann_end;
                }
                if tok_is(k, "=", tcx) {
                    init = k + 1;
                    init_end = until_stop(k + 1, tcx.nt, [";", "else"], false, tcx);
                }
                var j = i + 1;
                while j < e && tok_is(j, "mut", tcx) {
                    j += 1;
                }
                if j + 1 == e && binds(j, tcx) {
                    add_binding(j, depth, ann, ann_end, init, init_end, false, &tcx);
                } else {
                    pattern_bindings(i + 1, e, depth, -1, -1, false, &tcx);
                }
                i = e - 1;
            } else if kind == T_ID && s == "for" {
                let e = until_stop(i + 1, tcx.nt, ["in", "{"], false, tcx);
                if tok_is(e, "in", tcx) {
                    let body = until_stop(e + 1, tcx.nt, ["{"], false, tcx);
                    pattern_bindings(i + 1, e, depth + 1, e + 1, body, true, &tcx);
                    i = e;
                }
            } else if kind == T_ID && (s == "if" || s == "while") && tok_is(i + 1, "let", tcx) {
                let e = until_stop(i + 2, tcx.nt, ["="], false, tcx);
                pattern_bindings(i + 2, e, depth + 1, -1, -1, false, &tcx);
                i = e;
            } else if kind == T_P && s == "=>" {
                // a match arm: its pattern, back to the arm's start
                var a = i - 1;
                var nest = 0;
                while a >= 0 {
                    let t = tok_text(a, tcx);
                    if t == ")" || t == "]" {
                        nest += 1;
                    } else if t == "(" || t == "[" {
                        if nest == 0 {
                            break;
                        }
                        nest -= 1;
                    } else if nest == 0 && (t == "," || t == "{" || t == "}") {
                        break;
                    }
                    a -= 1;
                }
                let guard = until_stop(a + 1, i, ["if"], false, tcx);
                pattern_bindings(a + 1, guard, depth, -1, -1, false, &tcx);
            } else if kind == T_P && s == "|" && i > 0 {
                let before = tok_text(i - 1, tcx);
                if before == "(" || before == "," || before == "=" || before == "{"
                    || before == ";" || before == "move" || before == "return"
                    || before == "=>" || before == "sink" {
                    var j = i + 1;
                    while j < tcx.nt && !tok_is(j, "|", tcx) {
                        if binds(j, tcx) && (tok_is(j + 1, ":", tcx) || tok_is(j + 1, ",", tcx)
                            || tok_is(j + 1, "|", tcx)) {
                            var ann = -1;
                            var ann_end = -1;
                            if tok_is(j + 1, ":", tcx) {
                                ann = j + 2;
                                ann_end = until_stop(j + 2, tcx.nt, [",", "|"], true, tcx);
                            }
                            add_binding(j, depth + 1, ann, ann_end, -1, -1, false, &tcx);
                        }
                        j += 1;
                    }
                    i = j;
                }
            }
            i += 1;
        }
    }
}

// The binding named `name` in scope before token `before` (the last), or -1.
fn binding_named(name: [u8], before: i64, tcx: Tcx<Comp>) -> i64 {
    unsafe {
        var b = tcx.complete_b_name.count - 1;
        while b >= 0 {
            if tcx.complete_b_name.data[b] < before
                && tok_text(tcx.complete_b_name.data[b], tcx) == name {
                return b;
            }
            b -= 1;
        }
        -1
    }
}

// ---- the program read, and the text

fn index_defs(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if tcx.defs_indexed {
        return;
    }
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d].fqn >= 0 && tcx.def_by_fqn.get(pcx.defs[d].fqn + 1) == 0 {
            tcx.def_by_fqn.put(pcx.defs[d].fqn + 1, d + 1);
        }
        if pcx.defs[d].path >= 0 && tcx.def_by_path.get(pcx.defs[d].path + 1) == 0 {
            tcx.def_by_path.put(pcx.defs[d].path + 1, d + 1);
        }
    }
    tcx.defs_indexed = true;
}

// The locals by their declarations' positions, from decl (answer.vl's
// LOCAL_DECL: local + 1 -> its name's position + 1).
pub fn index_locals(decl: HMap, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        if tcx.locals_indexed {
            return;
        }
        for l in 0..pcx.local_count {
            let p = decl.get(l + 1) - 1;
            if p >= 0 && pcx.locals[l].ty > 0 && tcx.local_by_pos.get(p + 1) == 0 {
                tcx.local_by_pos.put(p + 1, l + 1);
            }
        }
        tcx.locals_indexed = true;
    }
}

// The position in the program read of position p of the text, or -1 when
// it is in what the edit changed.
fn old_pos(p: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if tcx.file < 0 {
        return -1;
    }
    let start = pcx.files[tcx.file].start;
    let old_len = pcx.files[tcx.file].end - start;
    if p < tcx.pre {
        return start + p;
    }
    if p >= TX.len as i64 - tcx.post {
        return start + p - TX.len as i64 + old_len;
    }
    -1
}

// The same, a position in what the edit changed taken as where it starts.
fn near_old_pos(p: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let q = old_pos(p, tcx, pcx);
    if q >= 0 || tcx.file < 0 {
        return q;
    }
    pcx.files[tcx.file].start + tcx.pre
}

fn compare_with_program(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    tcx.pre = 0;
    tcx.post = 0;
    if tcx.file < 0 {
        return;
    }
    let old = SRC[pcx.files[tcx.file].start..pcx.files[tcx.file].end];
    let t = TX;
    while tcx.pre < old.len as i64 && tcx.pre < t.len as i64 && old[tcx.pre] == t[tcx.pre] {
        tcx.pre += 1;
    }
    while tcx.post < old.len as i64 - tcx.pre && tcx.post < t.len as i64 - tcx.pre
        && old[old.len as i64 - 1 - tcx.post] == t[t.len as i64 - 1 - tcx.post] {
        tcx.post += 1;
    }
}

// ---- types

// A type: its type (t > 0), else the definition of its item (d >= 0) and
// the type of its first type argument when known (arg), or a slice of an
// unknown element (slice); none of them: unknown.
struct TyRef { t: i64, d: i64, slice: bool, arg: i64 }

fn no_type() -> TyRef {
    TyRef { t: 0, d: -1, slice: false, arg: 0 }
}

fn of_type(t: i64) -> TyRef {
    TyRef { t: if t > 0 { t } else { 0 }, d: -1, slice: false, arg: 0 }
}

fn known(r: TyRef) -> bool {
    r.t > 0 || r.d >= 0 || r.slice
}

// t without the pointers and references to it.
fn deref(t0: i64) -> i64 {
    var t = t0;
    var n = 0;
    while t > 0 && TYPES[t].kind == TyKind::Ptr && n < 8 {
        t = TYPES[t].a;
        n += 1;
    }
    t
}

// The definition of type t's item (an instance's: its template's), or -1.
fn item_of_type(t0: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let t = deref(t0);
        if t <= 0 {
            return -1;
        }
        let k = TYPES[t].kind;
        if k == TyKind::Struct {
            let s = TYPES[t].a;
            let tm = pcx.structs[s].tmpl;
            return def_of_node(if tm != 0 { pcx.structs[tm - 1].node } else { pcx.structs[s].node },
                tcx, pcx);
        }
        if k == TyKind::Enum {
            let e = TYPES[t].a;
            let tm = ENUMS[e].tmpl;
            return def_of_node(if tm != 0 { ENUMS[tm - 1].node } else { ENUMS[e].node }, tcx, pcx);
        }
        -1
    }
}

// The first type argument of an instance (`Vec<i64>`: i64), or 0.
fn first_targ(t0: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let t = deref(t0);
        if t <= 0 {
            return 0;
        }
        let k = TYPES[t].kind;
        if k == TyKind::Struct && pcx.structs[TYPES[t].a].targ_count > 0 {
            return TLISTS.data[pcx.structs[TYPES[t].a].targs];
        }
        if k == TyKind::Enum && ENUMS[TYPES[t].a].targ_count > 0 {
            return TLISTS.data[ENUMS[TYPES[t].a].targs];
        }
        0
    }
}

// What indexing or iterating r gives: a slice's or an array's element,
// an instance's first type argument (Vec, an iterator), a range's i64.
fn element_of(r: TyRef, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    if r.slice {
        return no_type();
    }
    if r.t <= 0 && r.arg > 0 {
        return of_type(r.arg);
    }
    if r.t > 0 && TYPES[r.t].kind == TyKind::Ptr {
        // (a raw pointer's element; a reference's: what it refers to's)
        let to = TYPES[r.t].a;
        if TYPES[r.t].b == 0 || TYPES[to].kind != TyKind::Slice
            && TYPES[to].kind != TyKind::Array && TYPES[to].kind != TyKind::Struct {
            return of_type(to);
        }
    }
    let t = deref(r.t);
    if t <= 0 {
        return no_type();
    }
    let k = TYPES[t].kind;
    if k == TyKind::Slice || k == TyKind::Array {
        return of_type(TYPES[t].a);
    }
    let d = item_of_type(t, tcx, pcx);
    if d >= 0 && (sym_text(pcx.defs[d].name) == "Range"
        || sym_text(pcx.defs[d].name) == "RangeInclusive") {
        return of_type(TY_I64);
    }
    of_type(first_targ(t, pcx))
}

// The definition of the type item named `name` the module sees: its own,
// one it imports, std's, any.
fn type_def_named(name: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let sym = find_sym(name);
    if sym < 0 {
        return -1;
    }
    var best = -1;
    var best_rank = 0;
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d].kind;
        if pcx.defs[d].name != sym
            || !(k == K_STRUCT || k == K_ENUM || k == K_TRAIT || k == K_ALIAS) {
            continue;
        }
        var rank = 1;
        if pcx.defs[d].module == tcx.module {
            rank = 4;
        } else if imported_as(d, tcx) {
            rank = 3;
        } else if pcx.defs[d].public && in_std(pcx.defs[d].module, pcx) {
            rank = 2;
        }
        if rank > best_rank {
            best = d;
            best_rank = rank;
        }
    }
    best
}

fn in_std(m0: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var m = m0;
        var n = 0;
        while m > 0 && n < 64 {
            if m == pcx.std_module {
                return true;
            }
            m = pcx.modules[m].parent;
            n += 1;
        }
        false
    }
}

// Whether `s` (a type as written) is a primitive's name: its type, else 0.
fn primitive_named(s: [u8]) -> i64 {
    let names: [[u8]; 13] = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64",
        "bool", "isize", "usize"];
    let types: [i64; 13] = [TY_I8, TY_I16, TY_I32, TY_I64, TY_U8, TY_U16, TY_U32, TY_U64, TY_F32,
        TY_F64, TY_BOOL, TY_ISIZE, TY_USIZE];
    for i in 0..13 {
        if names[i] == s {
            return types[i];
        }
    }
    0
}

// The definition of ctx's item (an instance's template's).
fn ctx_def(ctx: TyRef, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if ctx.t > 0 { item_of_type(ctx.t, tcx, pcx) } else { ctx.d }
}

fn def_ref(d: i64) -> TyRef {
    TyRef { t: 0, d: d, slice: false, arg: 0 }
}

// The `Self` of the impl block the cursor is in.
fn self_ref(tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    def_ref(self_def(tcx, pcx))
}

// The index of type parameter `name` of definition d (`Vec<T, A>`: T 0,
// A 1), or -1.
fn type_param_index(d: i64, name: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if d < 0 {
        return -1;
    }
    let s = signature(d, tcx, pcx);
    let own = sym_text(pcx.defs[d].name);
    var i = 0;
    while i + own.len as i64 <= s.len as i64 && s[i..i + own.len as i64] != own {
        i += 1;
    }
    i += own.len as i64;
    if i >= s.len as i64 || s[i] != '<' {
        return -1;
    }
    i += 1;
    var k = 0;
    while i < s.len as i64 {
        while i < s.len as i64 && s[i] == ' ' {
            i += 1;
        }
        var e = i;
        while e < s.len as i64 && is_id(s[e]) {
            e += 1;
        }
        if s[i..e] == name {
            return k;
        }
        // to the next parameter
        var depth = 0;
        while e < s.len as i64 {
            let c = s[e];
            if c == '<' || c == '(' || c == '[' {
                depth += 1;
            } else if c == '>' || c == ')' || c == ']' {
                if depth == 0 {
                    return -1;
                }
                depth -= 1;
            } else if c == ',' && depth == 0 {
                break;
            }
            e += 1;
        }
        i = e + 1;
        k += 1;
    }
    -1
}

// The k-th type argument of instance t, or 0.
fn nth_targ(t0: i64, k: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let t = deref(t0);
        if t <= 0 || k < 0 {
            return 0;
        }
        let kind = TYPES[t].kind;
        if kind == TyKind::Struct && pcx.structs[TYPES[t].a].targ_count > k {
            return TLISTS.data[pcx.structs[TYPES[t].a].targs + k];
        }
        if kind == TyKind::Enum && ENUMS[TYPES[t].a].targ_count > k {
            return TLISTS.data[ENUMS[TYPES[t].a].targs + k];
        }
        0
    }
}

// The type written as text `s` (`Vec<i64>`, `inout Buf`, `[u8]`, `Self`,
// `T`), in the context of ctx: what `Self` is, whose type parameters T
// names (an instance's arguments, or ctx's first argument).
fn type_from_text(s: [u8], ctx: TyRef, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    var i = 0;
    loop {
        while i < s.len as i64 && (s[i] == ' ' || s[i] == '&' || s[i] == '*') {
            i += 1;
        }
        var w = i;
        while w < s.len as i64 && is_id(s[w]) {
            w += 1;
        }
        let word = s[i..w];
        if word == "mut" || word == "inout" || word == "sink" || word == "let" || word == "var"
            || word == "const" {
            i = w;
            continue;
        }
        break;
    }
    if i < s.len as i64 && s[i] == '[' {
        // `[T]` (`[T; N]`: an array, as a slice for its methods)
        var e = i + 1;
        while e < s.len as i64 && s[e] != ']' && s[e] != ';' {
            e += 1;
        }
        let elem = type_from_text(s[i + 1..e], ctx, tcx, pcx);
        if elem.t > 0 {
            return of_type(crate::front::types::slice_of(elem.t));
        }
        return TyRef { t: 0, d: -1, slice: true, arg: 0 };
    }
    // the path's last name
    var last = i;
    var e = i;
    while e < s.len as i64 && (is_id(s[e]) || s[e] == ':') {
        if s[e] == ':' {
            last = e + 1;
        }
        e += 1;
    }
    let name = s[last..e];
    if name.len == 0 {
        return no_type();
    }
    // its first type argument
    var arg = 0;
    if e < s.len as i64 && s[e] == '<' {
        var depth = 0;
        var j = e + 1;
        var a_end = s.len as i64;
        while j < s.len as i64 {
            let c = s[j];
            if c == '<' || c == '(' || c == '[' {
                depth += 1;
            } else if c == '>' || c == ')' || c == ']' {
                if depth == 0 {
                    a_end = j;
                    break;
                }
                depth -= 1;
            } else if c == ',' && depth == 0 {
                a_end = j;
                break;
            }
            j += 1;
        }
        arg = type_from_text(s[e + 1..a_end], ctx, tcx, pcx).t;
    }
    if name == "Self" {
        return ctx;
    }
    let k = type_param_index(ctx_def(ctx, tcx, pcx), name, tcx, pcx);
    if k >= 0 {
        let targ = nth_targ(ctx.t, k, pcx);
        if targ > 0 {
            return of_type(targ);
        }
        if k == 0 && ctx.arg > 0 {
            return of_type(ctx.arg);
        }
        return no_type();
    }
    if name == "str" && pcx.str_type > 0 {
        return of_type(pcx.str_type);
    }
    let p = primitive_named(name);
    if p > 0 {
        return of_type(p);
    }
    TyRef { t: 0, d: type_def_named(name, tcx, pcx), slice: false, arg: arg }
}

// The text of definition d's signature (without its contract).
fn signature(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> [u8] {
    let b = buf_new();
    put_signature(b, d, tcx, pcx);
    let s = buf_slice(b);
    let stops: [[u8]; 2] = [" requires ", " ensures "];
    var e = s.len as i64;
    for k in 0..2 {
        var j = 0;
        while j + stops[k].len as i64 <= e {
            if s[j..j + stops[k].len as i64] == stops[k] {
                e = j;
                break;
            }
            j += 1;
        }
    }
    s[0..e]
}

// The result type of function definition d, as written (after `->`), or
// empty.
fn result_text(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> [u8] {
    let s = signature(d, tcx, pcx);
    var depth = 0;
    var i = 0;
    while i + 1 < s.len as i64 {
        let c = s[i];
        if c == '(' || c == '[' || c == '<' && !(i > 0 && s[i - 1] == '-') {
            depth += 1;
        } else if c == ')' || c == ']' || c == '>' && s[i - 1] != '-' {
            depth -= 1;
        } else if c == '-' && s[i + 1] == '>' && depth == 0 {
            var e = s.len as i64;
            let stops: [[u8]; 3] = [" requires", " ensures", " where"];
            for k in 0..3 {
                var j = i;
                while j + stops[k].len as i64 <= e {
                    if s[j..j + stops[k].len as i64] == stops[k] {
                        e = j;
                        break;
                    }
                    j += 1;
                }
            }
            return s[i + 2..e];
        }
        i += 1;
    }
    s[0..0]
}

// The type of field definition d, as written (after `:`).
fn field_text(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> [u8] {
    let s = signature(d, tcx, pcx);
    for i in 0..s.len as i64 {
        if s[i] == ':' && (i + 1 >= s.len as i64 || s[i + 1] != ':')
            && (i == 0 || s[i - 1] != ':') {
            var e = s.len as i64;
            for j in i..s.len as i64 {
                if s[j] == '=' && e == s.len as i64 {
                    e = j;
                }
            }
            return s[i + 1..e];
        }
    }
    s[0..0]
}

// The function definition of type r named `name` (a method of its impl
// blocks or traits), or -1.
fn member_fn(r: TyRef, name: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let sym = find_sym(name);
    let od = if r.t > 0 { item_of_type(r.t, tcx, pcx) } else { r.d };
    if sym < 0 || od < 0 || pcx.defs[od].fqn < 0 {
        return -1;
    }
    let owner = pcx.defs[od].fqn;
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner == owner
            && pcx.defs[d].name == sym {
            return d;
        }
    }
    -1
}

// The result type of function f: `str` where it is written so (the
// checker has its view, `[u8]`).
fn fn_result(f: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let d = def_of_node(pcx.fns[f].node, tcx, pcx);
        if d >= 0 && pcx.str_type > 0 {
            let r = result_text(d, tcx, pcx);
            var a = 0;
            var e = r.len as i64;
            while a < e && r[a] == ' ' {
                a += 1;
            }
            while e > a && r[e - 1] == ' ' {
                e -= 1;
            }
            if r[a..e] == "str" {
                return pcx.str_type;
            }
        }
        pcx.fns[f].ret
    }
}

// The result of calling method `name` on r.
fn method_result(r: TyRef, name: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    unsafe {
        let sym = find_sym(name);
        let t = deref(r.t);
        if sym >= 0 && t > 0 {
            var f = method_of(t, sym, pcx);
            if f < 0 && pcx.str_type > 0 && is_named(t, "String", tcx, pcx) {
                f = method_of(pcx.str_type, sym, pcx);
            }
            if f < 0 && TYPES[t].kind == TyKind::Array {
                f = method_of(crate::front::types::slice_of(TYPES[t].a), sym, pcx);
            }
            if f >= 0 {
                if pcx.fns[f].generic == 0 && pcx.fns[f].ret > 0 {
                    return of_type(fn_result(f, tcx, pcx));
                }
                // (a template: an instance of it the program made for t)
                for g in 0..pcx.fn_count {
                    if pcx.fns[g].tmpl == f + 1 && pcx.fns[g].param_count > 0
                        && deref(fn_param(g, 0, pcx)) == t && pcx.fns[g].ret > 0 {
                        return of_type(pcx.fns[g].ret);
                    }
                }
                let d = def_of_node(pcx.fns[f].node, tcx, pcx);
                if d >= 0 {
                    return type_from_text(result_text(d, tcx, pcx), r, tcx, pcx);
                }
            }
        }
        var d = member_fn(r, name, tcx, pcx);
        if d < 0 && sym >= 0 && (t > 0 || r.slice) {
            // (a type with no item: `str`'s, a slice's, a primitive's impl)
            let o = buf_new();
            if r.slice || TYPES[t].kind == TyKind::Slice || TYPES[t].kind == TyKind::Array {
                buf_str(o, c"[");
            } else if pcx.str_type > 0 && is_named(t, "String", tcx, pcx) {
                buf_str(o, c"str");
            } else {
                buf_type(o, t, pcx);
            }
            let ot = buf_slice(o);
            for e in 0..pcx.defs.len() as i64 {
                let k = pcx.defs[e].kind;
                if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[e].name == sym
                    && pcx.defs[e].owner >= 0 {
                    let own = sym_text(pcx.defs[e].owner);
                    if own == ot || ot == "[" && own.len > 0 && own[0] == '[' {
                        d = e;
                        break;
                    }
                }
            }
        }
        if d >= 0 {
            return type_from_text(result_text(d, tcx, pcx), r, tcx, pcx);
        }
        no_type()
    }
}

// Whether type t is the item named `name` (std's String...).
fn is_named(t: i64, name: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    let d = item_of_type(t, tcx, pcx);
    d >= 0 && sym_text(pcx.defs[d].name) == name
}

// The type of field `name` of r.
fn field_result(r: TyRef, name: [u8], tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    unsafe {
        let t = deref(r.t);
        if t > 0 && TYPES[t].kind == TyKind::Struct {
            let sym = find_sym(name);
            if sym >= 0 {
                let i = find_field(TYPES[t].a, sym, pcx);
                if i >= 0 {
                    return of_type((*struct_field(TYPES[t].a, i, pcx)).ty);
                }
            }
        }
        if t > 0 && TYPES[t].kind == TyKind::Tuple && name.len > 0 && name[0] >= '0'
            && name[0] <= '9' {
            var k = 0;
            for i in 0..name.len {
                k = k * 10 + (name[i] - '0') as i64;
            }
            if k < TYPES[t].count {
                return of_type(type_elem(t, k));
            }
        }
        let od = if t > 0 { item_of_type(t, tcx, pcx) } else { r.d };
        let sym = find_sym(name);
        if od >= 0 && sym >= 0 {
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d].kind == K_FIELD && pcx.defs[d].parent == od
                    && pcx.defs[d].name == sym {
                    return type_from_text(field_text(d, tcx, pcx), r, tcx, pcx);
                }
            }
        }
        no_type()
    }
}

// What `x?` gives of r: an Option's or a Result's first type argument.
fn unwrapped(r: TyRef, pcx: Ctx<Comp>) -> TyRef {
    if r.t <= 0 && r.arg > 0 {
        return of_type(r.arg);
    }
    of_type(first_targ(r.t, pcx))
}

// The impl's type the cursor is in (Self), or -1.
fn self_def(tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.i_type.count == 0 {
            return -1;
        }
        type_def_named(tok_text(tcx.i_type.data[tcx.i_type.count - 1], tcx), tcx, pcx)
    }
}

// The type of binding b.
fn binding_type(b: i64, depth: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    unsafe {
        let name = tcx.complete_b_name.data[b];
        let op = old_pos(tcx.ts.data[name], tcx, pcx);
        if op >= 0 {
            let l = tcx.local_by_pos.get(op + 1) - 1;
            if l >= 0 {
                return of_type(pcx.locals[l].ty);
            }
        }
        if tcx.b_ann.data[b] >= 0 && tcx.b_ann_end.data[b] > tcx.b_ann.data[b] {
            let s = TX[tcx.ts.data[tcx.b_ann.data[b]]..tcx.te.data[tcx.b_ann_end.data[b] - 1]];
            let r = type_from_text(s, self_ref(tcx, pcx), tcx, pcx);
            if known(r) {
                return r;
            }
        }
        if tok_text(name, tcx) == "self" {
            return TyRef { t: 0, d: self_def(tcx, pcx), slice: false, arg: 0 };
        }
        if tcx.b_init.data[b] >= 0 && tcx.b_init_end.data[b] > tcx.b_init.data[b] && depth < 6 {
            let r = expr_type(tcx.b_init.data[b], tcx.b_init_end.data[b] - 1, depth + 1, &tcx, pcx);
            return if tcx.b_iter.data[b] != 0 { element_of(r, tcx, pcx) } else { r };
        }
        no_type()
    }
}

// The type of the name `name` used at token i: a binding, `self`, a
// static or a constant of the module.
fn name_type(name: [u8], i: i64, depth: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    unsafe {
        let b = binding_named(name, i, tcx);
        if b >= 0 {
            return binding_type(b, depth, &tcx, pcx);
        }
        if name == "self" {
            return TyRef { t: 0, d: self_def(tcx, pcx), slice: false, arg: 0 };
        }
        let sym = find_sym(name);
        if sym < 0 {
            return no_type();
        }
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d].kind;
            if (k == K_STATIC || k == K_CONST) && pcx.defs[d].name == sym
                && pcx.defs[d].module == tcx.module {
                return value_type(d, tcx, pcx);
            }
        }
        // (an imported static or constant)
        for u in 0..tcx.u_name.count {
            if tcx.u_def.data[u] >= 0 && tok_text(tcx.u_name.data[u], tcx) == name {
                let k = pcx.defs[tcx.u_def.data[u]].kind;
                if k == K_STATIC || k == K_CONST {
                    return value_type(tcx.u_def.data[u], tcx, pcx);
                }
            }
        }
        no_type()
    }
}

// The path `a::b::c` written from token i: its last name's token (the
// path is i..that), stepping over `::<..>`.
fn path_end(i: i64, to: i64, tcx: Tcx<Comp>) -> i64 {
    var j = i;
    while j + 2 <= to && tok_is(j + 1, "::", tcx)
        && (is_ident(j + 2, tcx) || tok_is(j + 2, "<", tcx)) {
        if tok_is(j + 2, "<", tcx) {
            let e = until_stop(j + 3, to + 1, [">"], true, tcx);
            if !tok_is(e + 1, "::", tcx) {
                return j;
            }
            j = e - 1;
        }
        j += 2;
    }
    j
}

// The definition the path of tokens i..=e names (`Vec::new_in`,
// `shapes::area`, `area`, `Self::f`), or -1.
fn path_def(i: i64, e: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    let name = tok_text(e, tcx);
    let sym = find_sym(name);
    if sym < 0 {
        return -1;
    }
    if e == i {
        // a function the module has, imports, or the prelude's
        var best = -1;
        var best_rank = 0;
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d].name != sym || pcx.defs[d].parent >= 0 || pcx.defs[d].kind == K_METHOD
                || pcx.defs[d].kind == K_IMPL_METHOD || pcx.defs[d].kind == K_FIELD {
                continue;
            }
            var rank = 1;
            if pcx.defs[d].module == tcx.module {
                rank = 4;
            } else if imported_as(d, tcx) {
                rank = 3;
            } else if pcx.defs[d].public && pcx.defs[d].module == pcx.std_module {
                rank = 2;
            }
            if rank > best_rank {
                best = d;
                best_rank = rank;
            }
        }
        return best;
    }
    // `Owner::name`: the owner a type (its functions, its variants) or
    // a module (its items)
    var oe = e - 2;
    while oe > i && tok_is(oe, ">", tcx) {
        oe = match_angle_back(oe, tcx) - 2;
    }
    let owner = if tok_text(oe, tcx) == "Self" { self_def(tcx, pcx) }
        else { type_def_named(tok_text(oe, tcx), tcx, pcx) };
    if owner >= 0 && pcx.defs[owner].fqn >= 0 {
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d].name == sym && (pcx.defs[d].owner == pcx.defs[owner].fqn
                || pcx.defs[d].parent == owner) {
                return d;
            }
        }
    }
    let m = path_module(i, oe, tcx, pcx);
    if m >= 0 {
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d].name == sym && pcx.defs[d].module == m && pcx.defs[d].parent < 0
                && pcx.defs[d].kind != K_METHOD && pcx.defs[d].kind != K_IMPL_METHOD {
                return d;
            }
        }
    }
    -1
}

// The `<` matching the `>` at token i, or i.
fn match_angle_back(i: i64, tcx: Tcx<Comp>) -> i64 {
    var depth = 0;
    var j = i;
    while j >= 0 {
        if tok_is(j, ">", tcx) {
            depth += 1;
        } else if tok_is(j, "<", tcx) {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
        j -= 1;
    }
    i
}

// The type of a value of definition d: a function's result, a constant's
// or static's type, a variant's enum, a struct's.
fn value_type(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    unsafe {
        let k = pcx.defs[d].kind;
        if k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN {
            let f = pcx.nodes[pcx.defs[d].node].x - 1;
            if f >= 0 && f < pcx.fn_count && pcx.fns[f].generic == 0 && pcx.fns[f].ret > 0 {
                return of_type(fn_result(f, tcx, pcx));
            }
            if f >= 0 && f < pcx.fn_count {
                for g in 0..pcx.fn_count {
                    if pcx.fns[g].tmpl == f + 1 && pcx.fns[g].ret > 0 {
                        // (an instance's: an owner's methods are the same)
                        let r = of_type(pcx.fns[g].ret);
                        if item_of_type(r.t, tcx, pcx) >= 0 || deref(r.t) > 0 {
                            return r;
                        }
                    }
                }
            }
            let owner = if pcx.defs[d].parent >= 0 { pcx.defs[d].parent }
                else if pcx.defs[d].owner >= 0 { tcx.def_by_fqn.get(pcx.defs[d].owner + 1) - 1 }
                else { -1 };
            return type_from_text(result_text(d, tcx, pcx), def_ref(owner), tcx, pcx);
        }
        if k == K_CONST || k == K_STATIC {
            let node = pcx.defs[d].node;
            if k == K_STATIC {
                for i in 0..pcx.static_count {
                    if pcx.statics[i].node == node && pcx.statics[i].ty > 0 {
                        return of_type(pcx.statics[i].ty);
                    }
                }
            } else {
                for i in 0..pcx.const_count {
                    if pcx.consts[i].node == node && pcx.consts[i].ty > 0 {
                        return of_type(pcx.consts[i].ty);
                    }
                }
            }
            let ty = pcx.nodes[node].ty;
            if ty > 0 {
                return of_type(ty);
            }
            return type_from_text(field_text(d, tcx, pcx), no_type(), tcx, pcx);
        }
        if k == K_VARIANT {
            return TyRef { t: 0, d: pcx.defs[d].parent, slice: false, arg: 0 };
        }
        if k == K_STRUCT || k == K_ENUM {
            return TyRef { t: 0, d: d, slice: false, arg: 0 };
        }
        no_type()
    }
}

// The type of the expression of tokens a..=b, as far as it can be told.
fn expr_type(a: i64, b: i64, depth: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> TyRef {
    unsafe {
        if a > b || depth > 8 {
            return no_type();
        }
        // (the program's own node there, when the edit left it as it was)
        let oa = old_pos(tcx.ts.data[a], tcx, pcx);
        let ob = old_pos(tcx.te.data[b] - 1, tcx, pcx);
        if oa >= 0 && ob >= 0 {
            let t = typed_at(oa, ob + 1, &tcx, pcx);
            if t > 0 {
                return of_type(t);
            }
        }
        var i = a;
        var r = no_type();
        while i <= b
            && (tok_is(i, "&", tcx) || tok_is(i, "*", tcx) || tok_is(i, "-", tcx)
                || tok_is(i, "!", tcx)) {
            i += 1;
        }
        if i > b {
            return r;
        }
        if tok_is(i, "(", tcx) {
            let m = match_fwd(i, b + 1, tcx);
            r = expr_type(i + 1, m - 1, depth + 1, &tcx, pcx);
            i = m + 1;
        } else if tcx.tk.data[i] == T_STR {
            r = if pcx.str_type > 0 { of_type(pcx.str_type) } else { no_type() };
            i += 1;
        } else if tcx.tk.data[i] == T_NUM {
            r = of_type(TY_I64);
            i += 1;
        } else if tcx.tk.data[i] == T_ID {
            let e = path_end(i, b, tcx);
            if e + 1 <= b && tok_is(e + 1, "(", tcx) {
                let d = path_def(i, e, tcx, pcx);
                if d >= 0 {
                    r = value_type(d, tcx, pcx);
                }
                i = match_fwd(e + 1, b + 1, tcx) + 1;
            } else if e + 1 <= b && tok_is(e + 1, "{", tcx) {
                r = TyRef {
                    t: 0, d: type_def_named(tok_text(e, tcx), tcx, pcx), slice: false, arg: 0,
                };
                i = match_fwd(e + 1, b + 1, tcx) + 1;
            } else if e == i {
                r = name_type(tok_text(i, tcx), i, depth, &tcx, pcx);
                i += 1;
            } else {
                let d = path_def(i, e, tcx, pcx);
                if d >= 0 {
                    r = value_type(d, tcx, pcx);
                }
                i = e + 1;
            }
        } else {
            return no_type();
        }
        while i <= b && known(r) {
            if tok_is(i, ".", tcx) && i + 1 <= b {
                let name = tok_text(i + 1, tcx);
                var j = i + 2;
                if j + 1 <= b && tok_is(j, "::", tcx) && tok_is(j + 1, "<", tcx) {
                    j = until_stop(j + 2, b + 1, [">"], true, tcx) + 1;
                }
                if j <= b && tok_is(j, "(", tcx) {
                    r = method_result(r, name, tcx, pcx);
                    i = match_fwd(j, b + 1, tcx) + 1;
                } else {
                    r = field_result(r, name, tcx, pcx);
                    i += 2;
                }
            } else if tok_is(i, "[", tcx) {
                r = element_of(r, tcx, pcx);
                i = match_fwd(i, b + 1, tcx) + 1;
            } else if tok_is(i, "?", tcx) {
                r = unwrapped(r, pcx);
                i += 1;
            } else if tok_is(i, "as", tcx) && i + 1 <= b {
                r = type_from_text(TX[tcx.ts.data[i + 1]..tcx.te.data[b]], self_ref(tcx, pcx), tcx,
                    pcx);
                i = b + 1;
            } else {
                break;
            }
        }
        r
    }
}

// The type of the program's expression from old position a to b (a node
// spanning exactly that), or 0.
fn typed_at(a: i64, b: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    if !tcx.spans_indexed {
        for n in 1..pcx.nodes.len() {
            let k = pcx.nodes[n].kind;
            if pcx.nodes[n].ty > 0 && pcx.nodes[n].end > pcx.nodes[n].start
                && pcx.nodes[n].end - pcx.nodes[n].start < 1048576
                && (k == NodeKind::Ident || k == NodeKind::FieldAccess || k == NodeKind::Call
                    || k == NodeKind::MethodCall || k == NodeKind::Index
                    || k == NodeKind::Str) {
                let key = span_key(pcx.nodes[n].start, pcx.nodes[n].end);
                if tcx.complete_spans.get(key) == 0 {
                    tcx.complete_spans.put(key, pcx.nodes[n].ty);
                }
            }
        }
        tcx.spans_indexed = true;
    }
    if b <= a || b - a >= 1048576 {
        return 0;
    }
    tcx.complete_spans.get(span_key(a, b))
}

fn span_key(a: i64, b: i64) -> i64 {
    a * 1048576 + (b - a) + 1
}

// Whether no line break is between tokens i and j (i before j): `v.` at
// the end of a line is the line's own (what is typed), not the start of
// the next one's chain.
fn same_line(i: i64, j: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        for p in tcx.te.data[i]..tcx.ts.data[j] {
            if TX[p] == '\n' {
                return false;
            }
        }
        true
    }
}

// The start of the expression ending at token e (`a.b(c)[d]`), walking
// back over its parts.
fn expr_start(e: i64, tcx: Tcx<Comp>) -> i64 {
    var i = e;
    loop {
        if i < 0 {
            return 0;
        }
        if tok_is(i, "?", tcx) {
            i -= 1;
            continue;
        }
        if tok_is(i, ")", tcx) || tok_is(i, "]", tcx) || tok_is(i, "}", tcx) {
            let j = match_back(i, tcx);
            if j < 0 {
                return i + 1;
            }
            if j > 0
                && (is_ident(j - 1, tcx) && !is_keyword(tok_text(j - 1, tcx))
                    || tok_is(j - 1, ")", tcx) || tok_is(j - 1, "]", tcx) || tok_is(j - 1, ">", tcx)
                    || tok_is(j - 1, "?", tcx)) {
                if tok_is(i, "}", tcx) && !is_ident(j - 1, tcx) {
                    return j + 1;
                }
                i = j - 1;
                continue;
            }
            return j;
        }
        if tok_is(i, ">", tcx) {
            // `::<T>` of a call
            let j = match_angle_back(i, tcx);
            if j > 0 && tok_is(j - 1, "::", tcx) {
                i = j - 2;
                continue;
            }
            return i + 1;
        }
        if tcx.tk.get(i) == T_ID || tcx.tk.get(i) == T_STR
            || tcx.tk.get(i) == T_NUM {
            if i >= 2 && (tok_is(i - 1, ".", tcx) || tok_is(i - 1, "::", tcx))
                && same_line(i - 1, i, tcx) {
                i -= 2;
                continue;
            }
            return i;
        }
        return i + 1;
    }
}

// ---- imports (the text's `use` lines)

fn scan_uses(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    tcx.u_name.count = 0;
    tcx.complete_u_first.count = 0;
    tcx.u_last.count = 0;
    tcx.u_def.count = 0;
    var depth = 0;
    var i = 0;
    while i < tcx.tk.count {
        if tok_is(i, "{", tcx) {
            depth += 1;
        } else if tok_is(i, "}", tcx) {
            depth -= 1;
        } else if depth == 0 && tok_is(i, "use", tcx) {
            let e = until_stop(i + 1, tcx.tk.count, [";"], false, tcx);
            use_tree(i + 1, e, i + 1, &tcx);
            i = e;
        }
        i += 1;
    }
    for k in 0..tcx.u_name.count {
        tcx.u_def.push(use_def(k, tcx, pcx));
    }
}

// The names of the use tree of tokens a..e (the path from `first`).
fn use_tree(a: i64, e: i64, first: i64, tcx: inout Tcx<Comp>) {
    var i = a;
    while i < e {
        if tok_is(i, "{", tcx) {
            let close = match_fwd(i, e, tcx);
            var p = i + 1;
            while p < close {
                let q = until_stop(p, close, [","], false, tcx);
                use_tree(p, q, first, &tcx);
                p = q + 1;
            }
            return;
        }
        if is_ident(i, tcx) && !tok_is(i + 1, "::", tcx) {
            var name = i;
            if tok_is(i + 1, "as", tcx) && is_ident(i + 2, tcx) {
                name = i + 2;
            }
            tcx.u_name.push(name);
            tcx.complete_u_first.push(first);
            tcx.u_last.push(i);
            return;
        }
        i += 1;
    }
}

// The definition import k names, or -1: its path's names, from the
// module the path starts at.
fn use_def(k: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let last = tcx.u_last.data[k];
        let sym = find_sym(tok_text(last, tcx));
        if sym < 0 {
            return -1;
        }
        let prev = last - 2;
        if last <= tcx.complete_u_first.data[k] {
            return -1;
        }
        // the path's module: its tokens before the last name, skipping a
        // `{` and the names inside it before ours
        let m = path_module_tokens(tcx.complete_u_first.data[k], last, tcx, pcx);
        if m < 0 {
            if !tok_is(last - 1, "::", tcx) {
                return -1;
            }
            // `use a::Type::Variant`, `use a::Trait::f`
            let td = type_def_named(tok_text(prev, tcx), tcx, pcx);
            if td >= 0 {
                for d in 0..pcx.defs.len() as i64 {
                    if pcx.defs[d].parent == td && pcx.defs[d].name == sym {
                        return d;
                    }
                }
            }
            return -1;
        }
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d].name == sym && pcx.defs[d].module == m && pcx.defs[d].parent < 0
                && pcx.defs[d].kind != K_METHOD && pcx.defs[d].kind != K_IMPL_METHOD {
                return d;
            }
        }
        -1
    }
}

// The module the names of a use path from `first` up to (not with) the
// token `last` lead to (the names of a `{..}` the path is in skipped), or
// -1.
fn path_module_tokens(first: i64, last: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    var segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var i = first;
    while i < last {
        if is_ident(i, tcx) && tok_is(i + 1, "::", tcx) {
            segs.push(i);
            i += 2;
        } else if tok_is(i, "{", tcx) {
            i += 1;
        } else {
            // a sibling's name in the braces: its own path, not ours
            let e = until_stop(i, last, [","], false, tcx);
            if e >= last {
                break;
            }
            i = e + 1;
        }
    }
    modules_of(segs, tcx, pcx)
}

// The module of the path of tokens i..=e (all names), or -1.
fn path_module(i: i64, e: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    var segs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    var j = i;
    while j <= e {
        if is_ident(j, tcx) {
            segs.push(j);
        }
        j += 1;
    }
    modules_of(segs, tcx, pcx)
}

// The module the names (tokens) lead to: `crate`, `std`, `self`,
// `super`, a child of the module, of its parent, of the root, of std.
fn modules_of(segs: IntVec, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if segs.count == 0 {
            return -1;
        }
        let first = tok_text(segs.data[0], tcx);
        var m = -1;
        var k = 1;
        if first == "crate" {
            m = 0;
        } else if first == "std" {
            m = pcx.std_module;
        } else if first == "self" {
            m = tcx.module;
        } else if first == "super" {
            m = if tcx.module > 0 { pcx.modules[tcx.module].parent } else { 0 };
        } else {
            k = 0;
            let sym = find_sym(first);
            if sym < 0 {
                return -1;
            }
            m = child_module(tcx.module, sym, pcx);
            if m < 0 && tcx.module > 0 {
                m = child_module(pcx.modules[tcx.module].parent, sym, pcx);
            }
            if m < 0 {
                m = child_module(0, sym, pcx);
            }
            if m < 0 && pcx.std_module >= 0 {
                m = child_module(pcx.std_module, sym, pcx);
            }
            if m < 0 {
                // an imported module (`use std::collections; collections::`)
                for u in 0..tcx.u_name.count {
                    if tok_text(tcx.u_name.data[u], tcx) == first && tcx.u_def.data[u] >= 0
                        && pcx.defs[tcx.u_def.data[u]].kind == K_MOD {
                        let d = tcx.u_def.data[u];
                        m = child_module(pcx.defs[d].module, pcx.defs[d].name, pcx);
                    }
                }
            }
            if m < 0 {
                return -1;
            }
            k = 1;
        }
        while k < segs.count && m >= 0 {
            let sym = find_sym(tok_text(segs.data[k], tcx));
            if tok_text(segs.data[k], tcx) == "super" {
                m = pcx.modules[m].parent;
            } else {
                m = if sym < 0 { -1 } else { child_module(m, sym, pcx) };
            }
            k += 1;
        }
        m
    }
}

// Whether definition d is a name the text imports.
fn imported_as(d: i64, tcx: Tcx<Comp>) -> bool {
    unsafe {
        for u in 0..tcx.u_def.count {
            if tcx.u_def.data[u] == d {
                return true;
            }
        }
        false
    }
}

// ---- the items

static var PREFIX: [u8] = "";
const ITEMS_MAX: i64 = 400;

fn lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 as u8 } else { c }
}

// How label matches the prefix: 0 it starts with it, 1 so case ignored,
// 2 its letters in order, -1 not.
fn match_rank(label: [u8]) -> i64 {
    let p = PREFIX;
    if p.len == 0 {
        return 0;
    }
    if label.len >= p.len && label[0..p.len] == p {
        return 0;
    }
    var ci = label.len >= p.len;
    if ci {
        for i in 0..p.len {
            if lower(label[i]) != lower(p[i]) {
                ci = false;
            }
        }
    }
    if ci {
        return 1;
    }
    var j = 0;
    for i in 0..label.len {
        if j < p.len as i64 && lower(label[i]) == lower(p[j]) {
            j += 1;
        }
    }
    if j == p.len as i64 && lower(label[0]) == lower(p[0]) { 2 } else { -1 }
}

fn label_hash(s: [u8]) -> i64 {
    var h = 1469598103934665603 as u64;
    for i in 0..s.len {
        h = (h ^ s[i] as u64).wrapping_mul(1099511628211);
    }
    ((h >> 2) as i64) + 1
}

// Adds an item: its label, LSP kind, detail, group (lower first), the
// definition (-1: none), what to insert (empty: the label; snippet: a
// snippet), whether its type is the one expected.
fn add_item(label: [u8], kind: i64, detail: [u8], group: i64, d: i64, insert: [u8],
    snippet: bool, expected: bool, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    if label.len == 0 {
        return;
    }
    let rank = match_rank(label);
    if rank < 0 {
        return;
    }
    let h = label_hash(label);
    if tcx.seen.get(h) != 0 {
        return;
    }
    tcx.seen.put(h, 1);
    if tcx.complete_items >= ITEMS_MAX {
        tcx.cut = true;
        return;
    }
    if tcx.complete_items > 0 {
        buf_byte(tcx.out, ',');
    }
    tcx.complete_items += 1;
    buf_str(tcx.out, c"{\"label\":");
    buf_json_str(tcx.out, label);
    buf_fmt(tcx.out, format_args(",\"kind\":{kind}"));
    if detail.len > 0 {
        buf_str(tcx.out, c",\"detail\":");
        buf_json_str(tcx.out, if detail.len > 160 { detail[0..160] } else { detail });
    }
    let g = if expected { 0 } else { group };
    buf_fmt(tcx.out, format_args(",\"sortText\":\"{rank}{g}"));
    // (the label's own order after: JSON-safe, it is a name)
    for i in 0..label.len {
        if label[i] != '"' && label[i] != '\\' {
            buf_byte(tcx.out, label[i]);
        }
    }
    buf_byte(tcx.out, '"');
    if insert.len > 0 {
        buf_str(tcx.out, c",\"insertText\":");
        buf_json_str(tcx.out, insert);
        if snippet {
            buf_str(tcx.out, c",\"insertTextFormat\":2");
        }
    }
    if d >= 0 && pcx.defs[d].fqn >= 0 {
        // (by its path, not its index: the same in every worker)
        buf_str(tcx.out, c",\"data\":{\"p\":");
        buf_json_str(tcx.out, sym_text(pcx.defs[d].fqn));
        buf_str(tcx.out, c"}");
    }
    buf_byte(tcx.out, '}');
}

// The LSP kind of definition d.
fn item_kind(d: i64, pcx: Ctx<Comp>) -> i64 {
    let k = pcx.defs[d].kind;
    if k == K_FN { 3 }
    else if k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN {
        if has_self(d, pcx) { 2 } else { 3 }
    }
    else if k == K_STRUCT || k == K_ALIAS { 22 }
    else if k == K_ENUM { 13 }
    else if k == K_VARIANT { 20 }
    else if k == K_FIELD { 5 }
    else if k == K_TRAIT { 8 }
    else if k == K_CONST { 21 }
    else if k == K_STATIC { 6 }
    else if k == K_MOD { 9 } else { 1 }
}

fn is_fn_def(d: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.defs[d].kind;
    k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
}

// Whether function definition d takes `self`.
fn has_self(d: i64, pcx: Ctx<Comp>) -> bool {
    let n = pcx.defs[d].node;
    pcx.nodes[n].kind == NodeKind::Fn && pcx.nodes[n].count > 0
        && pcx.nodes[child(n, 0, pcx)].kind == NodeKind::Param
        && pcx.nodes[child(n, 0, pcx)].a == pcx.self_sym
}

// The snippet calling function definition d: `name(${1:a}, ${2:b})`
// (without `self`), or empty.
fn call_snippet(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> [u8] {
    if !tcx.snippets || tcx.call_follows || !is_fn_def(d, pcx) {
        return "";
    }
    let n = pcx.defs[d].node;
    let b = buf_new();
    buf_bytes(b, sym_text(pcx.defs[d].name));
    buf_byte(b, '(');
    var k = 0;
    for i in 0..pcx.nodes[n].count {
        let p = child(n, i, pcx);
        if pcx.nodes[p].kind != NodeKind::Param {
            break;
        }
        if pcx.nodes[p].a == pcx.self_sym {
            continue;
        }
        if k > 0 {
            buf_str(b, c", ");
        }
        k += 1;
        buf_fmt(b, format_args("${{{k}:"));
        buf_bytes(b, sym_text(pcx.nodes[p].a));
        buf_byte(b, '}');
    }
    buf_str(b, c")$0");
    buf_slice(b)
}

// Whether the type of a value of definition d is the expected one.
fn expected_def(d: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if tcx.expect <= 0 && tcx.expect_d < 0 {
        return false;
    }
    let k = pcx.defs[d].kind;
    if !(is_fn_def(d, pcx) || k == K_CONST || k == K_STATIC || k == K_VARIANT) {
        return false;
    }
    same_type(value_type(d, tcx, pcx), tcx, pcx)
}

fn same_type(r: TyRef, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    if tcx.expect > 0 && r.t > 0 {
        return deref(r.t) == deref(tcx.expect)
            || item_of_type(r.t, tcx, pcx) >= 0
            && item_of_type(r.t, tcx, pcx) == item_of_type(tcx.expect, tcx, pcx);
    }
    let d = if r.t > 0 { item_of_type(r.t, tcx, pcx) } else { r.d };
    d >= 0 && (d == tcx.expect_d || tcx.expect > 0 && d == item_of_type(tcx.expect, tcx, pcx))
}

// The item of definition d (its signature the detail).
fn add_def(d: i64, group: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let label = sym_text(pcx.defs[d].name);
    if match_rank(label) < 0 {
        return;
    }
    let k = pcx.defs[d].kind;
    if !pcx.defs[d].public && k != K_IMPL_METHOD && k != K_TRAIT_FN && k != K_VARIANT
        && !sees_inside(pcx.defs[d].module, tcx, pcx) {
        return;
    }
    let snip = call_snippet(d, tcx, pcx);
    add_item(label, item_kind(d, pcx), signature(d, tcx, pcx), group, d, snip, snip.len > 0,
        expected_def(d, tcx, pcx), &tcx, pcx);
}

// ---- the contexts

// After `.`: the fields and methods of r.
fn members(r: TyRef, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let t = deref(r.t);
        if t > 0 && TYPES[t].kind == TyKind::Tuple {
            for i in 0..TYPES[t].count {
                let b = buf_new();
                buf_type(b, type_elem(t, i), pcx);
                let l = buf_new();
                buf_fmt(l, format_args("{i}"));
                add_item(buf_slice(l), 5, buf_slice(b), 1, -1, "", false, false, &tcx, pcx);
            }
            return;
        }
        let od = if t > 0 { item_of_type(t, tcx, pcx) } else { r.d };
        // the fields (another module's: its public ones)
        if od >= 0 && pcx.defs[od].kind == K_STRUCT {
            let mine = sees_inside(pcx.defs[od].module, tcx, pcx);
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d].kind == K_FIELD && pcx.defs[d].parent == od
                    && (mine || pcx.defs[d].public) {
                    var detail = signature(d, tcx, pcx);
                    let sym = pcx.defs[d].name;
                    if t > 0 && TYPES[t].kind == TyKind::Struct {
                        let i = find_field(TYPES[t].a, sym, pcx);
                        if i >= 0 {
                            let b = buf_new();
                            // (0.26.0: a field's visibility)
                            if pcx.defs[d].public {
                                buf_str(b, c"pub ");
                            }
                            buf_bytes(b, sym_text(sym));
                            buf_str(b, c": ");
                            buf_type(b, (*struct_field(TYPES[t].a, i, pcx)).ty, pcx);
                            detail = buf_slice(b);
                        }
                    }
                    let exp = (tcx.expect > 0 || tcx.expect_d >= 0)
                        && same_type(field_result(r, sym_text(sym), tcx, pcx), tcx, pcx);
                    add_item(sym_text(sym), 5, detail, 1, d, "", false, exp, &tcx, pcx);
                }
            }
        }
        if od >= 0 {
            owner_methods(od, 2, &tcx, pcx);
        }
        if t > 0 {
            // the methods the checker knows of t (derived ones too)
            for i in 0..pcx.methods.len() as i64 {
                if pcx.methods[i].ty == t {
                    let d = def_of_node(pcx.fns[pcx.methods[i].f].node, tcx, pcx);
                    if d >= 0 && has_self(d, pcx) {
                        add_def(d, 2, &tcx, pcx);
                    }
                }
            }
            let k = TYPES[t].kind;
            if pcx.str_type > 0 && (t == pcx.str_type || is_named(t, "String", tcx, pcx)) {
                owner_named("str", 3, &tcx, pcx);
                if t != pcx.str_type {
                    let sd = item_of_type(pcx.str_type, tcx, pcx);
                    if sd >= 0 {
                        owner_methods(sd, 3, &tcx, pcx);
                    }
                }
            }
            if is_named(t, "PathBuf", tcx, pcx) {
                let pd = type_def_named("Path", tcx, pcx);
                if pd >= 0 {
                    owner_methods(pd, 3, &tcx, pcx);
                }
            }
            if k == TyKind::Slice || k == TyKind::Array {
                slice_members(&tcx, pcx);
            } else if k == TyKind::Prim || k == TyKind::Distinct {
                let b = buf_new();
                buf_type(b, t, pcx);
                owner_named(buf_slice(b), 2, &tcx, pcx);
            }
        }
        if r.slice {
            slice_members(&tcx, pcx);
        }
    }
}

fn slice_members(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    add_item("len", 2, "fn len(self) -> usize", 1, -1, if tcx.snippets && !tcx.call_follows {
        "len()$0" } else { "" }, true, false, &tcx, pcx);
    owner_named("[T]", 2, &tcx, pcx);
}

// The methods (with self) of the impl blocks of definition od, and of
// the traits it implements (their default ones too).
fn owner_methods(od: i64, group: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let owner = pcx.defs[od].fqn;
        if owner < 0 {
            return;
        }
        var traits = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d].kind;
            if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner == owner {
                if has_self(d, pcx) {
                    add_def(d, if k == K_METHOD { group } else { group + 1 }, &tcx, pcx);
                }
                if k == K_IMPL_METHOD && pcx.defs[d].tr >= 0 {
                    var seen = false;
                    for j in 0..traits.count {
                        if traits.data[j] == pcx.defs[d].tr {
                            seen = true;
                        }
                    }
                    if !seen {
                        traits.push(pcx.defs[d].tr);
                    }
                }
            }
        }
        if pcx.defs[od].kind == K_TRAIT {
            traits.push(pcx.defs[od].fqn);
        }
        for j in 0..traits.count {
            let td = tcx.def_by_fqn.get(traits.data[j] + 1) - 1;
            if td < 0 {
                continue;
            }
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d].kind == K_TRAIT_FN && pcx.defs[d].parent == td && has_self(d, pcx) {
                    add_def(d, group + 1, &tcx, pcx);
                }
            }
        }
    }
}

// The methods of the impl blocks of a type written `name` (`str`, `[T]`,
// `i64`: no item of its own).
fn owner_named(name: [u8], group: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let slice = name.len > 0 && name[0] == '[';
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner >= 0 {
            let o = sym_text(pcx.defs[d].owner);
            if (o == name || slice && o.len > 0 && o[0] == '[') && has_self(d, pcx) {
                add_def(d, group, &tcx, pcx);
            }
        }
    }
}

// After `path::`: the module's items, the type's variants and functions.
fn path_items(first: i64, last: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    // a type (`Vec::`, `Shape::`, `Self::`, `std::Vec::`)
    var td = -1;
    let lt = tok_text(last, tcx);
    if lt == "Self" {
        td = self_def(tcx, pcx);
    } else if first == last {
        td = type_def_named(lt, tcx, pcx);
        if td >= 0 && pcx.defs[td].module != tcx.module && !imported_as(td, tcx)
            && !(pcx.defs[td].public && pcx.defs[td].module == pcx.std_module) {
            // (a type's name the module does not see, or a module's)
            let m = path_module(first, last, tcx, pcx);
            if m >= 0 {
                td = -1;
            }
        }
    } else {
        td = path_def(first, last, tcx, pcx);
        if td >= 0 && !(pcx.defs[td].kind == K_STRUCT || pcx.defs[td].kind == K_ENUM
            || pcx.defs[td].kind == K_TRAIT || pcx.defs[td].kind == K_ALIAS) {
            td = -1;
        }
    }
    if td >= 0 {
        let owner = pcx.defs[td].fqn;
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d].kind;
            if k == K_VARIANT && pcx.defs[d].parent == td {
                add_def(d, 1, &tcx, pcx);
            } else if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d].owner == owner {
                add_def(d, if has_self(d, pcx) { 3 } else { 2 }, &tcx, pcx);
            } else if k == K_TRAIT_FN && pcx.defs[d].parent == td {
                add_def(d, 2, &tcx, pcx);
            }
        }
        return;
    }
    let m = path_module(first, last, tcx, pcx);
    if m >= 0 {
        module_items(m, 2, &tcx, pcx);
    }
}

// Whether the cursor's module is m or one inside it (it sees m's private
// items).
fn sees_inside(m: i64, tcx: Tcx<Comp>, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var c = tcx.module;
        var n = 0;
        while c >= 0 && n < 64 {
            if c == m {
                return true;
            }
            if c == 0 {
                break;
            }
            c = pcx.modules[c].parent;
            n += 1;
        }
        false
    }
}

// The items of module m (its public ones, unless the cursor is in it or
// in one inside it).
fn module_items(m: i64, group: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        let inside = sees_inside(m, tcx, pcx);
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d].kind;
            if pcx.defs[d].module == m && pcx.defs[d].parent < 0 && k != K_METHOD
                && k != K_IMPL_METHOD
                && k != K_FIELD && (inside || pcx.defs[d].public) {
                add_def(d, group, &tcx, pcx);
            }
        }
        // (the modules std's root declares, which have no `mod` item of
        // the program when std is one text)
        for c2 in 1..module_count(pcx) {
            if pcx.modules[c2].parent == m && (inside || pcx.modules[c2].public) {
                add_item(sym_text(pcx.modules[c2].name), 9, mod_detail(c2, &tcx, pcx), group, -1,
                    "", false, false, &tcx, pcx);
            }
        }
    }
}

fn mod_detail(m: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> [u8] {
    let b = buf_new();
    buf_str(b, c"mod ");
    let fqn = mod_fqn(m, &tcx, pcx);
    (buf_bytes(b, sym_text(fqn)));
    buf_slice(b)
}

// After `use ` (or `use a::{`): the roots of paths.
fn path_roots(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        add_item("crate", 9, "the program's root module", 4, -1, "", false, false, &tcx, pcx);
        add_item("std", 9, "the standard library", 4, -1, "", false, false, &tcx, pcx);
        add_item("self", 9, "this module", 4, -1, "", false, false, &tcx, pcx);
        add_item("super", 9, "the module this one is in", 4, -1, "", false, false, &tcx, pcx);
        for c in 1..module_count(pcx) {
            if pcx.modules[c].parent == tcx.module
                || tcx.module > 0 && pcx.modules[c].parent == pcx.modules[tcx.module].parent {
                add_item(sym_text(pcx.modules[c].name), 9, mod_detail(c, &tcx, pcx), 2, -1, "",
                    false, false, &tcx, pcx);
            }
        }
    }
}

// A name: the locals, the module's items, its imports, the prelude, the
// keywords and snippets.
fn names(tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        // the locals, innermost first
        var b = tcx.complete_b_name.count - 1;
        while b >= 0 {
            let name = tok_text(tcx.complete_b_name.data[b], tcx);
            if tcx.ts.data[tcx.complete_b_name.data[b]] < tcx.complete_cur
                && match_rank(name) >= 0 {
                let r = binding_type(b, 0, &tcx, pcx);
                let detail = buf_new();
                if r.t > 0 {
                    buf_type(detail, r.t, pcx);
                } else if r.d >= 0 {
                    buf_bytes(detail, sym_text(pcx.defs[r.d].name));
                } else if tcx.b_ann.data[b] >= 0 && tcx.b_ann_end.data[b] > tcx.b_ann.data[b] {
                    buf_bytes(detail,
                        TX[tcx.ts.data[tcx.b_ann.data[b]]..tcx.te.data[tcx.b_ann_end.data[b] - 1]]);
                }
                add_item(name, 6, buf_slice(detail), 1, -1, "", false,
                    known(r) && same_type(r, tcx, pcx), &tcx, pcx);
            }
            b -= 1;
        }
        if tcx.have_program && tcx.file >= 0 {
            module_items(tcx.module, 2, &tcx, pcx);
        }
        if tcx.have_program {
            // the imports
            for u in 0..tcx.u_name.count {
                let d = tcx.u_def.data[u];
                let name = tok_text(tcx.u_name.data[u], tcx);
                if d >= 0 {
                    let snip = call_snippet(d, tcx, pcx);
                    add_item(name, item_kind(d, pcx), signature(d, tcx, pcx), 3, d, snip,
                        snip.len > 0, expected_def(d, tcx, pcx), &tcx, pcx);
                } else {
                    add_item(name, 18, "", 3, -1, "", false, false, &tcx, pcx);
                }
            }
            // the prelude
            for k in 0..PRELUDE_COUNT {
                let sym = prelude_name(k, &pcx);
                let d = prelude_def_at(k, &tcx, &pcx);
                if d >= 0 && pcx.defs[d].name != sym {
                    // (`panic`: std's panic_str)
                    add_item(sym_text(sym), item_kind(d, pcx), signature(d, tcx, pcx), 4, d,
                        call_snippet(d, tcx, pcx), call_snippet(d, tcx, pcx).len > 0, false, &tcx,
                        pcx);
                } else if d >= 0 {
                    add_def(d, 4, &tcx, pcx);
                } else {
                    add_item(sym_text(sym), 3, "", 4, -1, "", false, false, &tcx, pcx);
                }
            }
        }
        keywords(&tcx, pcx);
    }
}

// The definition in std of the prelude's name k, or -1.
fn prelude_def_at(k: i64, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if tcx.prelude_defs.count == 0 {
            for j in 0..PRELUDE_COUNT {
                let sym = prelude_name(j, &pcx);
                var d = -1;
                if sym_text(sym) == "panic" {
                    let ps = find_sym("panic_str");
                    if ps >= 0 {
                        d = prelude_def(ps, pcx);
                    }
                }
                if d < 0 {
                    d = prelude_def(sym, pcx);
                }
                tcx.prelude_defs.push(d + 1);
            }
        }
        tcx.prelude_defs.data[k] - 1
    }
}

// The definition in std of prelude name sym.
fn prelude_def(sym: i64, pcx: Ctx<Comp>) -> i64 {
    var best = -1;
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d].name == sym && pcx.defs[d].public && in_std(pcx.defs[d].module, pcx)
            && (pcx.defs[d].parent < 0 || pcx.defs[d].kind == K_VARIANT)
            && pcx.defs[d].kind != K_METHOD && pcx.defs[d].kind != K_IMPL_METHOD {
            if best < 0
                || pcx.defs[d].module == pcx.std_module && pcx.defs[best].module != pcx.std_module {
                best = d;
            }
        }
    }
    best
}

fn keywords(tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    let snips: [[u8]; 13] = ["fn", "if", "for", "while", "loop", "match", "struct", "enum",
        "impl", "trait", "let", "var", "test"];
    let bodies: [[u8]; 13] = ["fn ${1:name}(${2}) {\n\t$0\n}", "if ${1:condition} {\n\t$0\n}",
        "for ${1:x} in ${2:iter} {\n\t$0\n}", "while ${1:condition} {\n\t$0\n}",
        "loop {\n\t$0\n}", "match ${1:value} {\n\t${2:pattern} => $0,\n}",
        "struct ${1:Name} {\n\t${2:field}: ${3:i64},\n}",
        "enum ${1:Name} {\n\t${2:Variant},\n}", "impl ${1:Type} {\n\t$0\n}",
        "trait ${1:Name} {\n\t$0\n}", "let ${1:name} = $0;", "var ${1:name} = $0;",
        "#[test]\nfn ${1:name}() {\n\t$0\n}"];
    let details: [[u8]; 13] = ["fn name(..) { .. }", "if cond { .. }", "for x in iter { .. }",
        "while cond { .. }", "loop { .. }", "match value { pattern => .. }",
        "struct Name { field: T }", "enum Name { Variant }", "impl Type { .. }",
        "trait Name { .. }", "let name = value;", "var name = value;",
        "#[test] fn name() { .. }"];
    if tcx.snippets {
        for i in 0..13 {
            add_item(snips[i], 15, details[i], 6, -1, bodies[i], true, false, &tcx, pcx);
        }
    }
    for i in 0..36 {
        add_item(KEYWORDS[i], 14, "", 5, -1, "", false, false, &tcx, pcx);
    }
    add_item("crate", 14, "", 5, -1, "", false, false, &tcx, pcx);
    add_item("super", 14, "", 5, -1, "", false, false, &tcx, pcx);
    add_item("mut", 14, "", 5, -1, "", false, false, &tcx, pcx);
}

// What the place before token i expects: `let x: T = `, `x = ` of a
// known x, `return ` (the function's result). EXPECT, EXPECT_D.
fn find_expected(i: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) {
    unsafe {
        tcx.expect = 0;
        tcx.expect_d = -1;
        if i < 0 || !tcx.have_program {
            return;
        }
        var r = no_type();
        if tok_is(i, "=", tcx) {
            // `let name: T =`, `name =`
            if tok_is(i - 1, ">", tcx) || is_ident(i - 1, tcx) || tok_is(i - 1, "]", tcx) {
                var c = i - 1;
                var nest = 0;
                while c > 0
                    && !(nest == 0
                        && (tok_is(c, ":", tcx) || tok_is(c, ";", tcx) || tok_is(c, "{", tcx)
                            || tok_is(c, "}", tcx) || tok_is(c, "let", tcx)
                            || tok_is(c, "var", tcx))) {
                    if tok_is(c, ">", tcx) || tok_is(c, "]", tcx) {
                        nest += 1;
                    } else if tok_is(c, "<", tcx) || tok_is(c, "[", tcx) {
                        nest -= 1;
                    }
                    c -= 1;
                }
                if tok_is(c, ":", tcx) {
                    r = type_from_text(TX[tcx.ts.data[c + 1]..tcx.te.data[i - 1]],
                        self_ref(tcx, pcx), tcx, pcx);
                }
                else if is_ident(i - 1, tcx) && (tok_is(i - 2, ";", tcx) || tok_is(i - 2, "{", tcx)
                    || tok_is(i - 2, "}", tcx)) {
                    r = name_type(tok_text(i - 1, tcx), i - 1, 0, &tcx, pcx);
                }
            }
        } else if tok_is(i, "return", tcx) && tcx.f_ret.count > 0 {
            let a = tcx.f_ret.data[tcx.f_ret.count - 1];
            let e = tcx.f_ret_end.data[tcx.f_ret_end.count - 1];
            if a >= 0 && e > a {
                r = type_from_text(TX[tcx.ts.data[a]..tcx.te.data[e - 1]], self_ref(tcx, pcx), tcx,
                    pcx);
            }
        }
        tcx.expect = r.t;
        tcx.expect_d = r.d;
    }
}

// ---- the request

// The text and the cursor read: its tokens (TK..), the program's file
// compared with it, the cursor's module, the tokens before it (NT).
fn read_text(f: i64, text: [u8], line: i64, ch: i64, utf8: bool, have_program: bool,
    tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let p = text.ptr;
        TX = p[0..text.len];
        tcx.complete_cur = text_offset(text, line, ch, utf8);
        tcx.have_program = have_program;
        tcx.file = if have_program { f } else { -1 };
        tcx.tk.count = 0;
        tcx.ts.count = 0;
        tcx.te.count = 0;
        tcx.in_text = false;
        lex_code(0, false, &tcx);
        if have_program {
            index_defs(&tcx, pcx);
        }
        compare_with_program(&tcx, pcx);
        tcx.module = if tcx.file >= 0 { module_at(near_old_pos(tcx.complete_cur, tcx, pcx), &pcx) }
            else { 0 };
        if tcx.module < 0 {
            tcx.module = 0;
        }
        tcx.nt = 0;
        while tcx.nt < tcx.tk.count && tcx.ts.data[tcx.nt] < tcx.complete_cur {
            tcx.nt += 1;
        }
    }
}

// The completion list for the text at (line, ch), into out: the
// program's file f (-1: none), its own text; utf8: the position encoding;
// snippets: the client takes them.
pub fn put_completion(out: i64, f: i64, text: [u8], line: i64, ch: i64, utf8: bool,
    have_program: bool, snippets: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        tcx.out = out;
        tcx.seen.clear();
        tcx.complete_items = 0;
        tcx.cut = false;
        tcx.snippets = snippets;
        read_text(f, text, line, ch, utf8, have_program, &tcx, &pcx);
        buf_str(out, c"{\"isIncomplete\":");
        let mark = buf_slice(out).len as i64;
        buf_str(out, c"false,\"items\":[");
        if tcx.in_text {
            buf_str(out, c"]}");
            return;
        }
        var pt = tcx.nt - 1;
        PREFIX = TX[tcx.complete_cur..tcx.complete_cur];
        if pt >= 0 && tcx.tk.data[pt] == T_ID && tcx.te.data[pt] >= tcx.complete_cur {
            PREFIX = TX[tcx.ts.data[pt]..tcx.complete_cur];
            pt -= 1;
        }
        // (a word right after the cursor: the snippet leaves its `(` be)
        var after = tcx.complete_cur;
        while after < TX.len as i64 && is_id(TX[after]) {
            after += 1;
        }
        while after < TX.len as i64 && (TX[after] == ' ') {
            after += 1;
        }
        tcx.call_follows = after < TX.len as i64 && TX[after] == '(';
        scan_bindings(&tcx);
        scan_uses(&tcx, pcx);
        if pt >= 0 && tok_is(pt, ".", tcx) && pt > 0 {
            // a member
            let s = expr_start(pt - 1, tcx);
            find_expected(s - 1, &tcx, pcx);
            let r = if have_program { expr_type(s, pt - 1, 0, &tcx, pcx) } else { no_type() };
            members(r, &tcx, pcx);
        } else if pt >= 1 && tok_is(pt, "::", tcx) && is_ident(pt - 1, tcx) {
            // a path's item
            var first = pt - 1;
            while first >= 2 && tok_is(first - 1, "::", tcx) && is_ident(first - 2, tcx)
                && same_line(first - 1, first, tcx) {
                first -= 2;
            }
            if have_program {
                path_items(first, pt - 1, &tcx, pcx);
            }
        } else if pt >= 0 && in_use_path(pt, tcx) >= 0 {
            // `use a::b::{c, |`: a's b's items
            let open = in_use_path(pt, tcx);
            if have_program {
                var first = open - 2;
                while first >= 2 && tok_is(first - 1, "::", tcx) && is_ident(first - 2, tcx) {
                    first -= 2;
                }
                path_items(first, open - 2, &tcx, pcx);
            }
        }
        else if pt >= 0
            && (tok_is(pt, "fn", tcx) || tok_is(pt, "struct", tcx) || tok_is(pt, "enum", tcx)
                || tok_is(pt, "trait", tcx) || tok_is(pt, "mod", tcx) || tok_is(pt, "let", tcx)
                || tok_is(pt, "var", tcx) || tok_is(pt, "type", tcx) || tok_is(pt, "const", tcx)
                || tok_is(pt, "static", tcx)) {
            // (a new name: nothing to complete)
        } else if pt >= 0 && tok_is(pt, "use", tcx) {
            path_roots(&tcx, pcx);
        } else {
            find_expected(pt, &tcx, pcx);
            names(&tcx, &pcx);
        }
        buf_str(out, c"]}");
        if tcx.cut {
            // (`true,` in place of `false,`: one byte shorter, padded)
            let b = buf_slice(out);
            let q = b.ptr;
            q[mark] = 't';
            q[mark + 1] = 'r';
            q[mark + 2] = 'u';
            q[mark + 3] = 'e';
            q[mark + 4] = ' ';
        }
    }
}

// In `use a::b::{c, ` at token pt (a `{` or a `,` in it): the `{`'s
// index; -1 when pt is not in such braces.
fn in_use_path(pt: i64, tcx: Tcx<Comp>) -> i64 {
    if !(tok_is(pt, "{", tcx) || tok_is(pt, ",", tcx)) {
        return -1;
    }
    // back to the `{` (over names and commas)
    var i = pt;
    while i >= 0 && !tok_is(i, "{", tcx) {
        if !(is_ident(i, tcx) || tok_is(i, ",", tcx) || tok_is(i, "::", tcx)
            || tok_is(i, "as", tcx)) {
            return -1;
        }
        i -= 1;
    }
    if i < 2 || !tok_is(i - 1, "::", tcx) {
        return -1;
    }
    // the path before it, back to `use`
    var j = i - 2;
    while j >= 0 && (is_ident(j, tcx) && !tok_is(j, "use", tcx) || tok_is(j, "::", tcx)) {
        j -= 1;
    }
    if j < 0 || !tok_is(j, "use", tcx) {
        return -1;
    }
    i
}

// The definition whose path is `path` (an item's data), or -1.
pub fn def_by_path(path: [u8], tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    index_defs(&tcx, pcx);
    let sym = find_sym(path);
    if sym < 0 { -1 } else { tcx.def_by_fqn.get(sym + 1) - 1 }
}

// completionItem/resolve: item (its JSON) with its definition's hover as
// its documentation, into out; doc: answer.vl's hover_def of it.
pub fn put_resolved(out: i64, item: [u8], d: i64, doc: [u8]) {
    var end = item.len as i64;
    while end > 0 && item[end - 1] != '}' {
        end -= 1;
    }
    if d < 0 || end == 0 || doc.len == 0 {
        buf_bytes(out, item);
        return;
    }
    buf_bytes(out, item[0..end - 1]);
    buf_str(out, c",\"documentation\":{\"kind\":\"markdown\",\"value\":");
    buf_json_str(out, doc);
    buf_str(out, c"}}");
}

// ---- signature help

// The function definition a call's callee of tokens ..=e names: `f`,
// `a::f`, `x.m` (x's method), or -1.
fn callee_def(e: i64, tcx: inout Tcx<Comp>, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if !is_ident(e, tcx) {
            return -1;
        }
        if e >= 2 && tok_is(e - 1, ".", tcx) {
            let s = expr_start(e - 2, tcx);
            let r = expr_type(s, e - 2, 0, &tcx, pcx);
            let name = tok_text(e, tcx);
            let t = deref(r.t);
            let sym = find_sym(name);
            if t > 0 && sym >= 0 {
                var f = method_of(t, sym, pcx);
                if f < 0 && pcx.str_type > 0 && is_named(t, "String", tcx, pcx) {
                    f = method_of(pcx.str_type, sym, pcx);
                }
                if f >= 0 {
                    let d = def_of_node(pcx.fns[f].node, tcx, pcx);
                    if d >= 0 {
                        return d;
                    }
                }
            }
            return member_fn(r, name, tcx, pcx);
        }
        var s = e;
        while s >= 2 && tok_is(s - 1, "::", tcx) && is_ident(s - 2, tcx) {
            s -= 2;
        }
        path_def(s, e, tcx, pcx)
    }
}

// textDocument/signatureHelp (0.25.1): the signature of the call the
// cursor is in the arguments of, its parameters (their conventions as
// written: `x: sink T`, `v: inout Vec<i64>`) and the one being typed,
// into out (`null`: none).
pub fn put_signature_help(out: i64, f: i64, text: [u8], line: i64, ch: i64, utf8: bool,
    have_program: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        read_text(f, text, line, ch, utf8, have_program, &tcx, &pcx);
        if tcx.in_text || !have_program {
            buf_str(out, c"null");
            return;
        }
        scan_bindings(&tcx);
        scan_uses(&tcx, pcx);
        // the `(` the cursor is in, and the commas before it
        var depth = 0;
        var commas = 0;
        var i = tcx.nt - 1;
        while i >= 0 {
            let t = tok_text(i, tcx);
            if tcx.tk.data[i] == T_P && (t == ")" || t == "]" || t == "}") {
                depth += 1;
            } else if tcx.tk.data[i] == T_P && (t == "(" || t == "[" || t == "{") {
                if depth == 0 {
                    break;
                }
                depth -= 1;
            } else if depth == 0 && tcx.tk.data[i] == T_P && t == "," {
                commas += 1;
            } else if depth == 0 && tcx.tk.data[i] == T_P && t == ";" {
                i = -1;
                break;
            }
            i -= 1;
        }
        if i < 1 || !tok_is(i, "(", tcx) {
            buf_str(out, c"null");
            return;
        }
        let d = callee_def(i - 1, &tcx, pcx);
        if d < 0 || !is_fn_def(d, pcx) {
            buf_str(out, c"null");
            return;
        }
        let sig = signature(d, tcx, pcx);
        // the parameters: in the signature after its name's `(`
        let own = sym_text(pcx.defs[d].name);
        var a = 0;
        while a + own.len as i64 <= sig.len as i64 && sig[a..a + own.len as i64] != own {
            a += 1;
        }
        a += own.len as i64;
        var nest = 0;
        while a < sig.len as i64 && !(sig[a] == '(' && nest == 0) {
            if sig[a] == '<' {
                nest += 1;
            } else if sig[a] == '>' {
                nest -= 1;
            }
            a += 1;
        }
        buf_str(out, c"{\"signatures\":[{\"label\":");
        buf_json_str(out, sig);
        buf_str(out, c",\"parameters\":[");
        var k = 0;
        var p = a + 1;
        // (a method called as `x.m(..)`: its self is not an argument)
        var self_param = !(i >= 3 && tok_is(i - 2, ".", tcx));
        while p < sig.len as i64 && sig[p] != ')' {
            while p < sig.len as i64 && sig[p] == ' ' {
                p += 1;
            }
            var e = p;
            var n = 0;
            while e < sig.len as i64 {
                let c = sig[e];
                if c == '(' || c == '[' || c == '<' && !(e > 0 && sig[e - 1] == '-') {
                    n += 1;
                } else if c == ')' || c == ']' || c == '>' && sig[e - 1] != '-' {
                    if n == 0 {
                        break;
                    }
                    n -= 1;
                } else if c == ',' && n == 0 {
                    break;
                }
                e += 1;
            }
            let param = sig[p..e];
            let is_self = param == "self"
                || param.len > 5 && param[param.len as i64 - 5..] == " self"
                || param.len > 5 && param[0..5] == "self:";
            if is_self && k == 0 && !self_param {
                self_param = true;
            } else {
                if k > 0 {
                    buf_byte(out, ',');
                }
                buf_fmt(out,
                    format_args("{{\"label\":[{},{}]}}", utf16_len(sig[0..p]),
                        utf16_len(sig[0..e])));
                k += 1;
            }
            p = if e < sig.len as i64 && sig[e] == ',' { e + 1 } else { e };
        }
        buf_str(out, c"]");
        let doc = buf_new();
        crate::tools::lsp::answer::put_doc(doc, d, pcx);
        let ds = buf_slice(doc);
        if ds.len > 0 {
            buf_str(out, c",\"documentation\":{\"kind\":\"markdown\",\"value\":");
            buf_json_str(out, ds[1..ds.len]);
            buf_byte(out, '}');
        }
        buf_fmt(out, format_args("}}],\"activeSignature\":0,\"activeParameter\":{commas}}}"));
    }
}

// The length of s in UTF-16 units (a signature's offsets, as LSP has
// them).
fn utf16_len(s: [u8]) -> i64 {
    var n = 0;
    var i = 0;
    while i < s.len as i64 {
        let c = s[i];
        let l = if c < 128 as u8 { 1 } else if c < 224 as u8 { 2 } else if c < 240 as u8 { 3 }
            else { 4 };
        n += if l == 4 { 2 } else { 1 };
        i += l;
    }
    n
}
