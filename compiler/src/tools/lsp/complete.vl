// textDocument/completion and completionItem/resolve (0.25.1, docs/lsp.md),
// in the worker (answer.vl). The editor's text is usually not a program
// while it is typed (`v.` with nothing after it), and reading the program
// again for each keystroke costs the front end's time; so completion reads
// the text it is given with a small lexer of its own (the tokens up to the
// cursor: what is typed, and where), and asks the program the worker read
// last (perhaps an edit behind) for the rest: the types of the locals
// (where a local of the text is at a place the edit did not touch, the
// program's local there), the definitions (DEFS), their members.
//
// What is completed:
// - after `.`: the receiver's fields and methods (its impl blocks', its
//   traits' and their default methods, std's: `str`'s for a String, a
//   slice's for an array), the receiver's type found from the program (a
//   local, a field, a method's result, a call's, a literal), or from the
//   text (`let v: T`, `let v = Vec::new_in(gpa)`, `for x in v`);
// - after `::`: a module's items, an enum's variants, a type's associated
//   functions, std's modules and items (`std::`, `Vec::`, `use a::b::{`);
// - a name: the locals and parameters in scope (from the text), the
//   module's items, the names it imports, the prelude, the keywords, and
//   snippets of the common forms.
//
// Ranked: names starting with what is typed first, then those of the type
// the place expects (`let x: T = `, `return `), then locals before members
// before the module's items before imports before std's. Each item's
// `data` names its definition by its path (the same in every worker), so
// that resolve adds the hover's text: the signature, effects (and why),
// the comment above it.

use crate::base::{
    buf_byte, buf_bytes, buf_done, buf_fmt, buf_new, buf_slice, buf_str, find_sym, get_src,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::json::buf_json_str;
use crate::front::ast::{NodeKind, child};
use crate::front::check::calls::method_of;
use crate::front::modules::{child_module, module_at, module_count};
use crate::front::modules::lookup::{PRELUDE_COUNT, prelude_name};
use crate::front::types::{
    TY_BOOL, TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE, TY_U16, TY_U32, TY_U64, TY_U8,
    TY_USIZE, TyKind, buf_type, find_field, fn_param, get_enums, struct_field, type_elem,
};
use crate::middle::lower::ssa::HMap;
use crate::tools::ctx::Tcx;
use crate::tools::lsp::format::text_offset;
use crate::tools::query::defs::{
    K_ALIAS, K_CONST, K_ENUM, K_FIELD, K_FN, K_IMPL_METHOD, K_METHOD, K_MOD, K_STATIC, K_STRUCT,
    K_TRAIT, K_TRAIT_FN, K_VARIANT, def_of_node, mod_fqn,
};
use crate::tools::query::show::put_signature;

// ---- the text's tokens

const T_ID: i64 = 1;
const T_NUM: i64 = 2;
const T_STR: i64 = 3;
const T_CHR: i64 = 4;
const T_P: i64 = 5;

fn is_id0(c: u8) -> bool {
    c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c == b'_'
}

fn is_id(c: u8) -> bool {
    is_id0(c) || c >= b'0' && c <= b'9'
}

fn push_tok(kind: i64, s: i64, e: i64, tcx: &mut Tcx<Comp>) {
    tcx.tk.push(kind);
    tcx.ts.push(s);
    tcx.te.push(e);
}

// A comment or literal from s to e: whether the cursor is in it (`open`:
// it is not closed, the cursor at its end is in it).
fn note_literal(s: i64, e: i64, open: bool, tcx: &mut Tcx<Comp>) {
    if tcx.complete_cur > s && (tcx.complete_cur < e || open && tcx.complete_cur == e) {
        tcx.in_text = true;
    }
}

// Whether t[p..] starts with `"""` (a text block's delimiter, 0.25.3).
fn triple_quote(t: &[u8], p: i64) -> bool {
    p >= 0 && p + 2 < t.len() as i64 && t[p as usize] == b'"' && t[(p + 1) as usize] == b'"'
        && t[(p + 2) as usize] == b'"'
}

// A string literal from its quote at p (its prefix at s); the end.
fn lex_string(t: &[u8], s: i64, p0: i64, tcx: &mut Tcx<Comp>) -> i64 {
    if triple_quote(t, p0) {
        // (0.25.4) a text block, `"""` to the next `"""`
        let mut q = p0 + 3;
        while q < t.len() as i64 && !triple_quote(t, q) {
            q += 1;
        }
        let e = if q < t.len() as i64 { q + 3 } else { t.len() as i64 };
        push_tok(T_STR, s, e, tcx);
        note_literal(s, e, q >= t.len() as i64, tcx);
        return e;
    }
    let mut p = p0 + 1;
    while p < t.len() as i64 && t[p as usize] != b'"' {
        p += if t[p as usize] == b'\\' { 2 } else { 1 };
    }
    let closed = p < t.len() as i64;
    let e = if closed { p + 1 } else { t.len() as i64 };
    push_tok(T_STR, s, e, tcx);
    note_literal(s, e, !closed, tcx);
    e
}

// An f-string from its `f` at s: its text as T_STR pieces, its holes'
// tokens between them; the end.
fn lex_fstring(t: &[u8], s: i64, tcx: &mut Tcx<Comp>) -> i64 {
    // (0.25.4) `f"""`, a text block: a quote is text in it
    let block = triple_quote(t, s + 1);
    let mut p = s + if block { 4 } else { 2 };
    let mut piece = s;
    loop {
        if p >= t.len() as i64 {
            push_tok(T_STR, piece, t.len() as i64, tcx);
            note_literal(piece, t.len() as i64, true, tcx);
            return t.len() as i64;
        }
        let c = t[p as usize];
        if c == b'\\' {
            p += 2;
        } else if (c == b'{' || c == b'}') && p + 1 < t.len() as i64 && t[(p + 1) as usize] == c {
            p += 2;
        } else if c == b'{' {
            push_tok(T_STR, piece, p + 1, tcx);
            note_literal(piece, p + 1, false, tcx);
            p = lex_code(t, p + 1, true, tcx);
            piece = p - 1;
        } else if c == b'"' && (!block || triple_quote(t, p)) {
            let e = p + if block { 3 } else { 1 };
            push_tok(T_STR, piece, e, tcx);
            note_literal(piece, e, false, tcx);
            return e;
        } else {
            p += 1;
        }
    }
}

// The length of the operator at p of t (`::`, `->`, `..=`...).
fn op_len(t: &[u8], p: i64) -> i64 {
    if p + 1 >= t.len() as i64 {
        return 1;
    }
    let a = t[p as usize];
    let b = t[(p + 1) as usize];
    if p + 2 < t.len() as i64 {
        let c = t[(p + 2) as usize];
        if a == b'.' && b == b'.' && (c == b'=' || c == b'.') || a == b'<' && b == b'<' && c == b'='
            || a == b'>' && b == b'>' && c == b'=' {
            return 3;
        }
    }
    if a == b':' && b == b':' || a == b'-' && b == b'>' || a == b'=' && b == b'>'
        || a == b'.' && b == b'.' || a == b'|' && b == b'|' || a == b'&' && b == b'&'
        || b == b'=' && (a == b'=' || a == b'!' || a == b'<' || a == b'>' || a == b'+' || a == b'-'
            || a == b'*' || a == b'/' || a == b'%' || a == b'&' || a == b'|' || a == b'^')
        || a == b'<' && b == b'<' || a == b'>' && b == b'>' {
        return 2;
    }
    1
}

// Lexes code from p0 to the end of the text (in_hole: to the `}` closing
// an f-string's hole; the position after it).
fn lex_code(t: &[u8], p0: i64, in_hole: bool, tcx: &mut Tcx<Comp>) -> i64 {
    let mut p = p0;
    let mut depth: i64 = 0;
    while p < t.len() as i64 {
        let c = t[p as usize];
        if c == b' ' || c == b'\t' || c == b'\n' || c == b'\r' {
            p += 1;
        } else if c == b'/' && p + 1 < t.len() as i64 && t[(p + 1) as usize] == b'/' {
            let s = p;
            while p < t.len() as i64 && t[p as usize] != b'\n' {
                p += 1;
            }
            note_literal(s, p, true, tcx);
        } else if c == b'/' && p + 1 < t.len() as i64 && t[(p + 1) as usize] == b'*' {
            let s = p;
            p += 2;
            let mut nest: i64 = 1;
            while p < t.len() as i64 && nest > 0 {
                if p + 1 < t.len() as i64 && t[p as usize] == b'/' && t[(p + 1) as usize] == b'*' {
                    nest += 1;
                    p += 2;
                }
                else if p + 1 < t.len() as i64 && t[p as usize] == b'*'
                    && t[(p + 1) as usize] == b'/' {
                    nest -= 1;
                    p += 2;
                } else {
                    p += 1;
                }
            }
            note_literal(s, p, nest > 0, tcx);
        } else if c == b'f' && p + 1 < t.len() as i64 && t[(p + 1) as usize] == b'"' {
            p = lex_fstring(t, p, tcx);
        }
        else if (c == b'c' || c == b'b' || c == b'r') && p + 1 < t.len() as i64
            && t[(p + 1) as usize] == b'"'
            && (p == 0 || !is_id(t[(p - 1) as usize])) {
            p = lex_string(t, p, p + 1, tcx);
        } else if c == b'"' {
            p = lex_string(t, p, p, tcx);
        } else if c == b'\'' && p + 2 < t.len() as i64
            && (t[(p + 1) as usize] == b'\\' && p + 3 < t.len() as i64
                || t[(p + 2) as usize] == b'\'') {
            let s = p;
            p += if t[(p + 1) as usize] == b'\\' { 3 } else { 2 };
            while p < t.len() as i64 && t[p as usize] != b'\'' && t[p as usize] != b'\n' {
                p += 1;
            }
            if p < t.len() as i64 && t[p as usize] == b'\'' {
                p += 1;
            }
            push_tok(T_CHR, s, p, tcx);
            note_literal(s, p, false, tcx);
        } else if is_id0(c) {
            let s = p;
            while p < t.len() as i64 && is_id(t[p as usize]) {
                p += 1;
            }
            push_tok(T_ID, s, p, tcx);
        } else if c >= b'0' && c <= b'9' {
            let s = p;
            while p < t.len() as i64 && (is_id(t[p as usize])
                || t[p as usize] == b'.' && p + 1 < t.len() as i64 && t[(p + 1) as usize] >= b'0'
                && t[(p + 1) as usize] <= b'9' && (p == s || t[(p - 1) as usize] != b'.')) {
                p += 1;
            }
            push_tok(T_NUM, s, p, tcx);
        } else {
            if in_hole && c == b'{' {
                depth += 1;
            } else if in_hole && c == b'}' {
                if depth == 0 {
                    return p + 1;
                }
                depth -= 1;
            }
            let n = op_len(t, p);
            push_tok(T_P, p, p + n, tcx);
            p += n;
        }
    }
    p
}

fn tok_text(i: i64, tcx: &Tcx<Comp>) -> &[u8] {
    &tcx.complete_text[tcx.ts[i as usize] as usize..tcx.te[i as usize] as usize]
}

// Whether token i is `s` (a word or an operator).
fn tok_is(i: i64, s: &[u8], tcx: &Tcx<Comp>) -> bool {
    i >= 0 && i < tcx.tk.len() as i64 && tok_text(i, tcx) == s
}

fn is_ident(i: i64, tcx: &Tcx<Comp>) -> bool {
    i >= 0 && i < tcx.tk.len() as i64 && tcx.tk[i as usize] == T_ID
}

// The bracket matching the opener at i (searching forward up to `to`),
// or `to` when it is not closed.
fn match_fwd(i: i64, to: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = i;
    while j < to {
        let s = tok_text(j, tcx);
        if tcx.tk[j as usize] == T_P {
            if s == b"(" || s == b"[" || s == b"{" {
                depth += 1;
            } else if s == b")" || s == b"]" || s == b"}" {
                depth -= 1;
                if depth == 0 {
                    return j;
                }
            }
        }
        j += 1;
    }
    to
}

// The bracket matching the closer at i, or -1.
fn match_back(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = i;
    while j >= 0 {
        if tcx.tk[j as usize] == T_P {
            let s = tok_text(j, tcx);
            if s == b")" || s == b"]" || s == b"}" {
                depth += 1;
            } else if s == b"(" || s == b"[" || s == b"{" {
                depth -= 1;
                if depth == 0 {
                    return j;
                }
            }
        }
        j -= 1;
    }
    -1
}

const KEYWORDS: [&[u8]; 36] = [b"fn", b"let", b"var", b"inout", b"sink", b"struct", b"enum",
    b"trait", b"impl", b"match", b"if", b"else", b"loop", b"while", b"for", b"in", b"break",
    b"continue", b"return", b"true", b"false", b"as", b"extern", b"const", b"static", b"type",
    b"use", b"pub", b"mod", b"defer", b"unsafe", b"move", b"self", b"Self", b"requires",
    b"ensures"];

fn is_keyword(s: &[u8]) -> bool {
    for i in 0..36 {
        if KEYWORDS[i as usize] == s {
            return true;
        }
    }
    s == b"mut" || s == b"crate" || s == b"super" || s == b"import"
}

// ---- the bindings in scope at the cursor (from the text)

fn add_binding(name: i64, depth: i64, ann: i64, ann_end: i64, init: i64, init_end: i64,
    iter: bool, tcx: &mut Tcx<Comp>) {
    tcx.complete_b_name.push(name);
    tcx.b_depth.push(depth);
    tcx.b_ann.push(ann);
    tcx.b_ann_end.push(ann_end);
    tcx.b_init.push(init);
    tcx.b_init_end.push(init_end);
    tcx.b_iter.push(if iter { 1 } else { 0 });
}

// Whether token i names a binding in a pattern: a lower-case word that
// is not a keyword, a path's part, a call's or a struct's name.
fn binds(i: i64, tcx: &Tcx<Comp>) -> bool {
    if !is_ident(i, tcx) {
        return false;
    }
    let s = tok_text(i, tcx);
    if s[0] >= b'A' && s[0] <= b'Z' || is_keyword(s) || s == b"_" {
        return false;
    }
    let next = i + 1;
    if next < tcx.tk.len() as i64
        && (tok_is(next, b"(", tcx) || tok_is(next, b"::", tcx) || tok_is(next, b"{", tcx)
            || tok_is(next, b"!", tcx)) {
        return false;
    }
    !(i > 0 && (tok_is(i - 1, b"::", tcx) || tok_is(i - 1, b".", tcx)))
}

// The end of the tokens from i up to (not with) one of the stops at
// nesting 0, or to: the index of the stop.
fn until_stop(i: i64, to: i64, stops: &[&[u8]], angles: bool, tcx: &Tcx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = i;
    while j < to {
        let s = tok_text(j, tcx);
        if depth == 0 {
            for k in 0..stops.len() {
                if s == stops[k] {
                    return j;
                }
            }
        }
        if s == b"(" || s == b"[" || s == b"{" || angles && s == b"<" {
            depth += 1;
        } else if s == b")" || s == b"]" || s == b"}" || angles && s == b">" {
            if depth == 0 {
                return j;
            }
            depth -= 1;
        } else if angles && s == b">>" {
            depth -= 2;
            if depth < 0 {
                return j;
            }
        }
        j += 1;
    }
    to
}

// The pattern's names, from i up to `end`, as bindings at depth.
fn pattern_bindings(i: i64, end: i64, depth: i64, init: i64, init_end: i64, iter: bool,
    tcx: &mut Tcx<Comp>) {
    // (a single name: its value and type are known)
    let mut j = i;
    while j < end && (tok_is(j, b"mut", tcx) || tok_is(j, b"ref", tcx)) {
        j += 1;
    }
    if j + 1 == end && binds(j, tcx) {
        add_binding(j, depth, -1, -1, init, init_end, iter, tcx);
        return;
    }
    while j < end {
        if binds(j, tcx) && !tok_is(j + 1, b":", tcx) || binds(j, tcx) && j + 1 == end {
            add_binding(j, depth, -1, -1, -1, -1, false, tcx);
        }
        j += 1;
    }
}

// A function's header at token i (`fn`): its parameters are bound when
// its body opens; the index of its last token read.
fn fn_header(i: i64, depth: i64, tcx: &mut Tcx<Comp>) -> i64 {
    tcx.q_name.clear();
    tcx.q_ann.clear();
    tcx.q_ann_end.clear();
    tcx.q_depth = depth;
    tcx.q_ret = -1;
    tcx.q_ret_end = -1;
    let mut j = i + 1;
    if is_ident(j, tcx) {
        j += 1;
    }
    if tok_is(j, b"<", tcx) {
        j = until_stop(j + 1, tcx.nt, &[b">"], true, tcx) + 1;
    }
    if !tok_is(j, b"(", tcx) {
        return j - 1;
    }
    let close = until_stop(j + 1, tcx.nt, &[b")"], true, tcx);
    let mut p = j + 1;
    while p < close {
        let e = until_stop(p, close, &[b","], true, tcx);
        let colon = until_stop(p, e, &[b":"], true, tcx);
        if colon < e {
            // `name: [conv] Type`
            let mut n = colon - 1;
            if binds(n, tcx) || tok_is(n, b"self", tcx) {
                let mut a = colon + 1;
                while a < e
                    && (tok_is(a, b"inout", tcx) || tok_is(a, b"sink", tcx)
                        || tok_is(a, b"let", tcx) || tok_is(a, b"var", tcx)
                        || tok_is(a, b"mut", tcx)) {
                    a += 1;
                }
                tcx.q_name.push(n);
                tcx.q_ann.push(a);
                tcx.q_ann_end.push(e);
            }
        } else if e > p && tok_is(e - 1, b"self", tcx) {
            tcx.q_name.push(e - 1);
            tcx.q_ann.push(-1);
            tcx.q_ann_end.push(-1);
        }
        p = e + 1;
    }
    if close >= tcx.nt {
        return tcx.nt;
    }
    let mut k = close + 1;
    if tok_is(k, b"->", tcx) {
        let e = until_stop(k + 1, tcx.nt, &[b"{", b";", b"requires", b"ensures", b"where"], true,
            tcx);
        tcx.q_ret = k + 1;
        tcx.q_ret_end = e;
        k = e;
    }
    k - 1
}

// The bindings in scope at the cursor (B_*), the functions and impls it is
// in (F_*, I_*): the tokens before it read once.
fn scan_bindings(tcx: &mut Tcx<Comp>) {
    tcx.complete_b_name.clear();
    tcx.b_depth.clear();
    tcx.b_ann.clear();
    tcx.b_ann_end.clear();
    tcx.b_init.clear();
    tcx.b_init_end.clear();
    tcx.b_iter.clear();
    tcx.f_depth.clear();
    tcx.f_ret.clear();
    tcx.f_ret_end.clear();
    tcx.i_depth.clear();
    tcx.i_type.clear();
    tcx.q_depth = -1;
    tcx.pending_impl = -1;
    let mut depth: i64 = 0;
    let mut i: i64 = 0;
    while i < tcx.nt {
        let s = tok_text(i, tcx);
        let kind = (tcx.tk[i as usize]);
        if kind == T_P && s == b"{" {
            depth += 1;
            if tcx.q_depth >= 0 && tcx.q_depth == depth - 1 {
                for q in 0..tcx.q_name.len() as i64 {
                    add_binding((tcx.q_name[q as usize]), depth,
                        (tcx.q_ann[q as usize]),
                        (tcx.q_ann_end[q as usize]), -1, -1, false, tcx);
                }
                tcx.f_depth.push(depth);
                tcx.f_ret.push(tcx.q_ret);
                tcx.f_ret_end.push(tcx.q_ret_end);
                tcx.q_depth = -1;
            }
            if tcx.pending_impl >= 0 {
                tcx.i_depth.push(depth);
                tcx.i_type.push(tcx.pending_impl);
                tcx.pending_impl = -1;
            }
        } else if kind == T_P && s == b"}" {
            while tcx.b_depth.len() as i64 > 0
                && (tcx.b_depth[(tcx.b_depth.len() as i64 - 1) as usize]) >= depth {
                tcx.complete_b_name.pop().unwrap();
                tcx.b_depth.pop().unwrap();
                tcx.b_ann.pop().unwrap();
                tcx.b_ann_end.pop().unwrap();
                tcx.b_init.pop().unwrap();
                tcx.b_init_end.pop().unwrap();
                tcx.b_iter.pop().unwrap();
            }
            while tcx.f_depth.len() as i64 > 0
                && (tcx.f_depth[(tcx.f_depth.len() as i64 - 1) as usize]) >= depth {
                tcx.f_depth.pop().unwrap();
                tcx.f_ret.pop().unwrap();
                tcx.f_ret_end.pop().unwrap();
            }
            while tcx.i_depth.len() as i64 > 0
                && (tcx.i_depth[(tcx.i_depth.len() as i64 - 1) as usize]) >= depth {
                tcx.i_depth.pop().unwrap();
                tcx.i_type.pop().unwrap();
            }
            if depth > 0 {
                depth -= 1;
            }
        } else if kind == T_P && s == b";" {
            if tcx.q_depth == depth {
                tcx.q_depth = -1;
            }
        } else if kind == T_ID && s == b"fn" {
            i = fn_header(i, depth, tcx);
        } else if kind == T_ID && s == b"impl" {
            // `impl<T> Tr for Ty<T>`: Ty's name
            let mut j = i + 1;
            if tok_is(j, b"<", tcx) {
                j = until_stop(j + 1, tcx.nt, &[b">"], true, tcx) + 1;
            }
            let e = until_stop(j, tcx.nt, &[b"{", b";"], true, tcx);
            let mut name: i64 = -1;
            let mut k = j;
            while k < e {
                if tok_is(k, b"for", tcx) {
                    name = -1;
                } else if is_ident(k, tcx) && name < 0 && !tok_is(k, b"for", tcx) {
                    name = k;
                    while tok_is(name + 1, b"::", tcx) && is_ident(name + 2, tcx) {
                        name += 2;
                    }
                }
                k += 1;
            }
            tcx.pending_impl = name;
        } else if kind == T_ID && (s == b"let" || s == b"var"
            || s == b"inout" && i > 0 && (tok_is(i - 1, b";", tcx) || tok_is(i - 1, b"{", tcx)
                || tok_is(i - 1, b"}", tcx))) {
            let e = until_stop(i + 1, tcx.nt, &[b":", b"=", b";"], false, tcx);
            let mut ann: i64 = -1;
            let mut ann_end: i64 = -1;
            let mut init: i64 = -1;
            let mut init_end: i64 = -1;
            let mut k = e;
            if tok_is(k, b":", tcx) {
                ann = k + 1;
                ann_end = until_stop(k + 1, tcx.nt, &[b"=", b";"], true, tcx);
                k = ann_end;
            }
            if tok_is(k, b"=", tcx) {
                init = k + 1;
                init_end = until_stop(k + 1, tcx.nt, &[b";", b"else"], false, tcx);
            }
            let mut j = i + 1;
            while j < e && tok_is(j, b"mut", tcx) {
                j += 1;
            }
            if j + 1 == e && binds(j, tcx) {
                add_binding(j, depth, ann, ann_end, init, init_end, false, tcx);
            } else {
                pattern_bindings(i + 1, e, depth, -1, -1, false, tcx);
            }
            i = e - 1;
        } else if kind == T_ID && s == b"for" {
            let e = until_stop(i + 1, tcx.nt, &[b"in", b"{"], false, tcx);
            if tok_is(e, b"in", tcx) {
                let body = until_stop(e + 1, tcx.nt, &[b"{"], false, tcx);
                pattern_bindings(i + 1, e, depth + 1, e + 1, body, true, tcx);
                i = e;
            }
        } else if kind == T_ID && (s == b"if" || s == b"while") && tok_is(i + 1, b"let", tcx) {
            let e = until_stop(i + 2, tcx.nt, &[b"="], false, tcx);
            pattern_bindings(i + 2, e, depth + 1, -1, -1, false, tcx);
            i = e;
        } else if kind == T_P && s == b"=>" {
            // a match arm: its pattern, back to the arm's start
            let mut a = i - 1;
            let mut nest: i64 = 0;
            while a >= 0 {
                let t = tok_text(a, tcx);
                if t == b")" || t == b"]" {
                    nest += 1;
                } else if t == b"(" || t == b"[" {
                    if nest == 0 {
                        break;
                    }
                    nest -= 1;
                } else if nest == 0 && (t == b"," || t == b"{" || t == b"}") {
                    break;
                }
                a -= 1;
            }
            let guard = until_stop(a + 1, i, &[b"if"], false, tcx);
            pattern_bindings(a + 1, guard, depth, -1, -1, false, tcx);
        } else if kind == T_P && s == b"|" && i > 0 {
            let before = tok_text(i - 1, tcx);
            if before == b"(" || before == b"," || before == b"=" || before == b"{"
                || before == b";" || before == b"move" || before == b"return"
                || before == b"=>" || before == b"sink" {
                let mut j = i + 1;
                while j < tcx.nt && !tok_is(j, b"|", tcx) {
                    if binds(j, tcx) && (tok_is(j + 1, b":", tcx) || tok_is(j + 1, b",", tcx)
                        || tok_is(j + 1, b"|", tcx)) {
                        let mut ann: i64 = -1;
                        let mut ann_end: i64 = -1;
                        if tok_is(j + 1, b":", tcx) {
                            ann = j + 2;
                            ann_end = until_stop(j + 2, tcx.nt, &[b",", b"|"], true, tcx);
                        }
                        add_binding(j, depth + 1, ann, ann_end, -1, -1, false, tcx);
                    }
                    j += 1;
                }
                i = j;
            }
        }
        i += 1;
    }
}

// The binding named `name` in scope before token `before` (the last), or -1.
fn binding_named(name: &[u8], before: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut b = tcx.complete_b_name.len() as i64 - 1;
    while b >= 0 {
        if (tcx.complete_b_name[b as usize]) < before
            && tok_text((tcx.complete_b_name[b as usize]), tcx) == name {
            return b;
        }
        b -= 1;
    }
    -1
}

// ---- the program read, and the text

fn index_defs(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.defs_indexed {
        return;
    }
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d as usize].fqn >= 0 && tcx.def_by_fqn.get(pcx.defs[d as usize].fqn + 1) == 0 {
            tcx.def_by_fqn.put(pcx.defs[d as usize].fqn + 1, d + 1);
        }
        if pcx.defs[d as usize].path >= 0
            && tcx.def_by_path.get(pcx.defs[d as usize].path + 1) == 0 {
            tcx.def_by_path.put(pcx.defs[d as usize].path + 1, d + 1);
        }
    }
    tcx.defs_indexed = true;
}

// The locals by their declarations' positions, from decl (answer.vl's
// LOCAL_DECL: local + 1 -> its name's position + 1).
pub fn index_locals(decl: HMap, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if tcx.locals_indexed {
        return;
    }
    for l in 0..pcx.locals.len() as i64 {
        let p = decl.get(l + 1) - 1;
        if p >= 0 && pcx.locals[l as usize].ty > 0 && tcx.local_by_pos.get(p + 1) == 0 {
            tcx.local_by_pos.put(p + 1, l + 1);
        }
    }
    tcx.locals_indexed = true;
}

// The position in the program read of position p of the text, or -1 when
// it is in what the edit changed.
fn old_pos(p: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if tcx.file < 0 {
        return -1;
    }
    let start = pcx.files[tcx.file as usize].start;
    let old_len = pcx.files[tcx.file as usize].end - start;
    if p < tcx.pre {
        return start + p;
    }
    if p >= tcx.complete_text.len() as i64 - tcx.post {
        return start + p - tcx.complete_text.len() as i64 + old_len;
    }
    -1
}

// The same, a position in what the edit changed taken as where it starts.
fn near_old_pos(p: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let q = old_pos(p, tcx, pcx);
    if q >= 0 || tcx.file < 0 {
        return q;
    }
    pcx.files[tcx.file as usize].start + tcx.pre
}

fn compare_with_program(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    tcx.pre = 0;
    tcx.post = 0;
    if tcx.file < 0 {
        return;
    }
    let old = &get_src()[
        pcx.files[tcx.file as usize].start as usize..pcx.files[tcx.file as usize].end as usize];
    let t = tcx.complete_text.as_slice();
    while tcx.pre < old.len() as i64 && tcx.pre < t.len() as i64
        && old[tcx.pre as usize] == t[tcx.pre as usize] {
        tcx.pre += 1;
    }
    while tcx.post < old.len() as i64 - tcx.pre && tcx.post < t.len() as i64 - tcx.pre
        && old[(old.len() as i64 - 1 - tcx.post) as usize]
        == t[(t.len() as i64 - 1 - tcx.post) as usize] {
        tcx.post += 1;
    }
}

// ---- types

// A type: its type (t > 0), else the definition of its item (d >= 0) and
// the type of its first type argument when known (arg), or a slice of an
// unknown element (slice); none of them: unknown.
#[derive(Clone, Copy)] struct TyRef { t: i64, d: i64, slice: bool, arg: i64 }

fn no_type() -> TyRef {
    TyRef { t: 0, d: -1, slice: false, arg: 0 }
}

fn of_type(t: i64) -> TyRef {
    TyRef { t: if t > 0 { t } else { 0 }, d: -1, slice: false, arg: 0 }
}

fn known(r: TyRef) -> bool {
    r.t > 0 || r.d >= 0 || r.slice
}

// t without the pointers and references to it.
fn deref(t0: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut t = t0;
    let mut n: i64 = 0;
    while t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && n < 8 {
        t = pcx.types[t as usize].a;
        n += 1;
    }
    t
}

// The definition of type t's item (an instance's: its template's), or -1.
fn item_of_type(t0: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let t = deref(t0, pcx);
        if t <= 0 {
            return -1;
        }
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            let tm = pcx.structs[s as usize].tmpl;
            return def_of_node(if tm != 0 { pcx.structs[(tm - 1) as usize].node }
                else { pcx.structs[s as usize].node },
                tcx, pcx);
        }
        if k == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            let tm = (*get_enums().add(e as usize)).tmpl;
            return def_of_node(if tm != 0 { (*get_enums().add((tm - 1) as usize)).node }
                else { (*get_enums().add(e as usize)).node }, tcx, pcx);
        }
        -1
    }
}

// The first type argument of an instance (`Vec<i64>`: i64), or 0.
fn first_targ(t0: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let t = deref(t0, pcx);
        if t <= 0 {
            return 0;
        }
        let k = pcx.types[t as usize].kind;
        if k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].targ_count > 0 {
            return (pcx.tlists[pcx.structs[pcx.types[t as usize].a as usize].targs as usize]);
        }
        if k == TyKind::Enum
            && (*get_enums().add(pcx.types[t as usize].a as usize)).targ_count > 0 {
            return (
                pcx.tlists[(*get_enums().add(pcx.types[t as usize].a as usize)).targs as usize]);
        }
        0
    }
}

// What indexing or iterating r gives: a slice's or an array's element,
// an instance's first type argument (Vec, an iterator), a range's i64.
fn element_of(r: TyRef, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> TyRef {
    if r.slice {
        return no_type();
    }
    if r.t <= 0 && r.arg > 0 {
        return of_type(r.arg);
    }
    if r.t > 0 && pcx.types[r.t as usize].kind == TyKind::Ptr {
        // (a raw pointer's element; a reference's: what it refers to's)
        let to = pcx.types[r.t as usize].a;
        if pcx.types[r.t as usize].b == 0 || pcx.types[to as usize].kind != TyKind::Slice
            && pcx.types[to as usize].kind != TyKind::Array
            && pcx.types[to as usize].kind != TyKind::Struct {
            return of_type(to);
        }
    }
    let t = deref(r.t, pcx);
    if t <= 0 {
        return no_type();
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Slice || k == TyKind::Array {
        return of_type(pcx.types[t as usize].a);
    }
    let d = item_of_type(t, tcx, pcx);
    if d >= 0 && (sym_text(pcx.defs[d as usize].name, pcx) == b"Range"
        || sym_text(pcx.defs[d as usize].name, pcx) == b"RangeInclusive") {
        return of_type(TY_I64);
    }
    of_type(first_targ(t, pcx))
}

// The definition of the type item named `name` the module sees: its own,
// one it imports, std's, any.
fn type_def_named(name: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let sym = find_sym(name, pcx);
    if sym < 0 {
        return -1;
    }
    let mut best: i64 = -1;
    let mut best_rank: i64 = 0;
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if pcx.defs[d as usize].name != sym
            || !(k == K_STRUCT || k == K_ENUM || k == K_TRAIT || k == K_ALIAS) {
            continue;
        }
        let mut rank: i64 = 1;
        if pcx.defs[d as usize].module == tcx.module {
            rank = 4;
        } else if imported_as(d, tcx) {
            rank = 3;
        } else if pcx.defs[d as usize].public && in_std(pcx.defs[d as usize].module, pcx) {
            rank = 2;
        }
        if rank > best_rank {
            best = d;
            best_rank = rank;
        }
    }
    best
}

fn in_std(m0: i64, pcx: &Ctx<Comp>) -> bool {
    let mut m = m0;
    let mut n: i64 = 0;
    while m > 0 && n < 64 {
        if m == pcx.std_module {
            return true;
        }
        m = pcx.modules[m as usize].parent;
        n += 1;
    }
    false
}

// Whether `s` (a type as written) is a primitive's name: its type, else 0.
fn primitive_named(s: &[u8]) -> i64 {
    let names: [&[u8]; 13] = [b"i8", b"i16", b"i32", b"i64", b"u8", b"u16", b"u32", b"u64", b"f32",
        b"f64", b"bool", b"isize", b"usize"];
    let types: [i64; 13] = [TY_I8, TY_I16, TY_I32, TY_I64, TY_U8, TY_U16, TY_U32, TY_U64, TY_F32,
        TY_F64, TY_BOOL, TY_ISIZE, TY_USIZE];
    for i in 0..13 {
        if names[i as usize] == s {
            return types[i as usize];
        }
    }
    0
}

// The definition of ctx's item (an instance's template's).
fn ctx_def(ctx: TyRef, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if ctx.t > 0 { item_of_type(ctx.t, tcx, pcx) } else { ctx.d }
}

fn def_ref(d: i64) -> TyRef {
    TyRef { t: 0, d: d, slice: false, arg: 0 }
}

// The `Self` of the impl block the cursor is in.
fn self_ref(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> TyRef {
    def_ref(self_def(tcx, pcx))
}

// The index of type parameter `name` of definition d (`Vec<T, A>`: T 0,
// A 1), or -1.
fn type_param_index(d: i64, name: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if d < 0 {
        return -1;
    }
    let s = signature(d, tcx, pcx);
    let own = sym_text(pcx.defs[d as usize].name, pcx);
    let mut i: i64 = 0;
    while i + own.len() as i64 <= s.len() as i64
        && s[i as usize..(i + own.len() as i64) as usize] != own {
        i += 1;
    }
    i += own.len() as i64;
    if i >= s.len() as i64 || s[i as usize] != b'<' {
        return -1;
    }
    i += 1;
    let mut k: i64 = 0;
    while i < s.len() as i64 {
        while i < s.len() as i64 && s[i as usize] == b' ' {
            i += 1;
        }
        let mut e = i;
        while e < s.len() as i64 && is_id(s[e as usize]) {
            e += 1;
        }
        if &s[i as usize..e as usize] == name {
            return k;
        }
        // to the next parameter
        let mut depth: i64 = 0;
        while e < s.len() as i64 {
            let c = s[e as usize];
            if c == b'<' || c == b'(' || c == b'[' {
                depth += 1;
            } else if c == b'>' || c == b')' || c == b']' {
                if depth == 0 {
                    return -1;
                }
                depth -= 1;
            } else if c == b',' && depth == 0 {
                break;
            }
            e += 1;
        }
        i = e + 1;
        k += 1;
    }
    -1
}

// The k-th type argument of instance t, or 0.
fn nth_targ(t0: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let t = deref(t0, pcx);
        if t <= 0 || k < 0 {
            return 0;
        }
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].targ_count > k {
            return (pcx.tlists[(pcx.structs[pcx.types[t as usize].a as usize].targs + k) as usize]);
        }
        if kind == TyKind::Enum
            && (*get_enums().add(pcx.types[t as usize].a as usize)).targ_count > k {
            return (
                pcx.tlists[
                    ((*get_enums().add(pcx.types[t as usize].a as usize)).targs + k) as usize]);
        }
        0
    }
}

// The type written as text `s` (`Vec<i64>`, `inout Buf`, `[u8]`, `Self`,
// `T`), in the context of ctx: what `Self` is, whose type parameters T
// names (an instance's arguments, or ctx's first argument).
fn type_from_text(s: &[u8], ctx: TyRef, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    let mut i: i64 = 0;
    loop {
        while i < s.len() as i64
            && (s[i as usize] == b' ' || s[i as usize] == b'&' || s[i as usize] == b'*') {
            i += 1;
        }
        let mut w = i;
        while w < s.len() as i64 && is_id(s[w as usize]) {
            w += 1;
        }
        let word = &s[i as usize..w as usize];
        if word == b"mut" || word == b"inout" || word == b"sink" || word == b"let" || word == b"var"
            || word == b"const" {
            i = w;
            continue;
        }
        break;
    }
    if i < s.len() as i64 && s[i as usize] == b'[' {
        // `[T]` (`[T; N]`: an array, as a slice for its methods)
        let mut e = i + 1;
        while e < s.len() as i64 && s[e as usize] != b']' && s[e as usize] != b';' {
            e += 1;
        }
        let elem = type_from_text(&s[(i + 1) as usize..e as usize], ctx, tcx, pcx);
        if elem.t > 0 {
            return of_type(crate::front::types::slice_of(elem.t, pcx));
        }
        return TyRef { t: 0, d: -1, slice: true, arg: 0 };
    }
    // the path's last name
    let mut last = i;
    let mut e = i;
    while e < s.len() as i64 && (is_id(s[e as usize]) || s[e as usize] == b':') {
        if s[e as usize] == b':' {
            last = e + 1;
        }
        e += 1;
    }
    let name = &s[last as usize..e as usize];
    if name.len() == 0 {
        return no_type();
    }
    // its first type argument
    let mut arg: i64 = 0;
    if e < s.len() as i64 && s[e as usize] == b'<' {
        let mut depth: i64 = 0;
        let mut j = e + 1;
        let mut a_end = s.len() as i64;
        while j < s.len() as i64 {
            let c = s[j as usize];
            if c == b'<' || c == b'(' || c == b'[' {
                depth += 1;
            } else if c == b'>' || c == b')' || c == b']' {
                if depth == 0 {
                    a_end = j;
                    break;
                }
                depth -= 1;
            } else if c == b',' && depth == 0 {
                a_end = j;
                break;
            }
            j += 1;
        }
        arg = type_from_text(&s[(e + 1) as usize..a_end as usize], ctx, tcx, pcx).t;
    }
    if name == b"Self" {
        return ctx;
    }
    let k = type_param_index(ctx_def(ctx, tcx, pcx), name, tcx, pcx);
    if k >= 0 {
        let targ = nth_targ(ctx.t, k, pcx);
        if targ > 0 {
            return of_type(targ);
        }
        if k == 0 && ctx.arg > 0 {
            return of_type(ctx.arg);
        }
        return no_type();
    }
    if name == b"str" && pcx.str_type > 0 {
        return of_type(pcx.str_type);
    }
    let p = primitive_named(name);
    if p > 0 {
        return of_type(p);
    }
    TyRef { t: 0, d: type_def_named(name, tcx, pcx), slice: false, arg: arg }
}

// The text of definition d's signature (without its contract).
fn signature(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    let b = buf_new();
    put_signature(b, d, tcx, pcx);
    let s = buf_done(b);
    let stops: [&[u8]; 2] = [b" requires ", b" ensures "];
    let mut e = s.len() as i64;
    for k in 0..2 {
        let mut j: i64 = 0;
        while j + stops[k as usize].len() as i64 <= e {
            if &s[j as usize..(j + stops[k as usize].len() as i64) as usize] == stops[k as usize] {
                e = j;
                break;
            }
            j += 1;
        }
    }
    &s[0..e as usize]
}

// The result type of function definition d, as written (after `->`), or
// empty.
fn result_text(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    let s = signature(d, tcx, pcx);
    let mut depth: i64 = 0;
    let mut i: i64 = 0;
    while i + 1 < s.len() as i64 {
        let c = s[i as usize];
        if c == b'(' || c == b'[' || c == b'<' && !(i > 0 && s[(i - 1) as usize] == b'-') {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'>' && s[(i - 1) as usize] != b'-' {
            depth -= 1;
        } else if c == b'-' && s[(i + 1) as usize] == b'>' && depth == 0 {
            let mut e = s.len() as i64;
            let stops: [&[u8]; 3] = [b" requires", b" ensures", b" where"];
            for k in 0..3 {
                let mut j = i;
                while j + stops[k as usize].len() as i64 <= e {
                    if &s[j as usize..(j + stops[k as usize].len() as i64) as usize]
                        == stops[k as usize] {
                        e = j;
                        break;
                    }
                    j += 1;
                }
            }
            return &s[(i + 2) as usize..e as usize];
        }
        i += 1;
    }
    &s[0..0]
}

// The type of field definition d, as written (after `:`).
fn field_text(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    let s = signature(d, tcx, pcx);
    for i in 0..s.len() as i64 {
        if s[i as usize] == b':' && (i + 1 >= s.len() as i64 || s[(i + 1) as usize] != b':')
            && (i == 0 || s[(i - 1) as usize] != b':') {
            let mut e = s.len() as i64;
            for j in i..s.len() as i64 {
                if s[j as usize] == b'=' && e == s.len() as i64 {
                    e = j;
                }
            }
            return &s[(i + 1) as usize..e as usize];
        }
    }
    &s[0..0]
}

// The function definition of type r named `name` (a method of its impl
// blocks or traits), or -1.
fn member_fn(r: TyRef, name: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let sym = find_sym(name, pcx);
    let od = if r.t > 0 { item_of_type(r.t, tcx, pcx) } else { r.d };
    if sym < 0 || od < 0 || pcx.defs[od as usize].fqn < 0 {
        return -1;
    }
    let owner = pcx.defs[od as usize].fqn;
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d as usize].owner == owner
            && pcx.defs[d as usize].name == sym {
            return d;
        }
    }
    -1
}

// The result type of function f: `str` where it is written so (the
// checker has its view, `[u8]`).
fn fn_result(f: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let d = def_of_node(pcx.fns[f as usize].node, tcx, pcx);
    if d >= 0 && pcx.str_type > 0 {
        let r = result_text(d, tcx, pcx);
        let mut a: i64 = 0;
        let mut e = r.len() as i64;
        while a < e && r[a as usize] == b' ' {
            a += 1;
        }
        while e > a && r[(e - 1) as usize] == b' ' {
            e -= 1;
        }
        if &r[a as usize..e as usize] == b"str" {
            return pcx.str_type;
        }
    }
    pcx.fns[f as usize].ret
}

// The result of calling method `name` on r.
fn method_result(r: TyRef, name: &[u8], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    let sym = find_sym(name, pcx);
    let t = deref(r.t, pcx);
    if sym >= 0 && t > 0 {
        let mut f = method_of(t, sym, pcx);
        if f < 0 && pcx.str_type > 0 && is_named(t, b"String", tcx, pcx) {
            f = method_of(pcx.str_type, sym, pcx);
        }
        if f < 0 && pcx.types[t as usize].kind == TyKind::Array {
            f = method_of(crate::front::types::slice_of(pcx.types[t as usize].a, pcx), sym, pcx);
        }
        if f >= 0 {
            if pcx.fns[f as usize].generic == 0 && pcx.fns[f as usize].ret > 0 {
                return of_type(fn_result(f, tcx, pcx));
            }
            // (a template: an instance of it the program made for t)
            for g in 0..pcx.fns.len() as i64 {
                if pcx.fns[g as usize].tmpl == f + 1 && pcx.fns[g as usize].param_count > 0
                    && deref(fn_param(g, 0, pcx), pcx) == t && pcx.fns[g as usize].ret > 0 {
                    return of_type(pcx.fns[g as usize].ret);
                }
            }
            let d = def_of_node(pcx.fns[f as usize].node, tcx, pcx);
            if d >= 0 {
                return type_from_text(result_text(d, tcx, pcx), r, tcx, pcx);
            }
        }
    }
    let mut d = member_fn(r, name, tcx, pcx);
    if d < 0 && sym >= 0 && (t > 0 || r.slice) {
        // (a type with no item: `str`'s, a slice's, a primitive's impl)
        let o = buf_new();
        if r.slice || pcx.types[t as usize].kind == TyKind::Slice
            || pcx.types[t as usize].kind == TyKind::Array {
            buf_str(o, c"[");
        } else if pcx.str_type > 0 && is_named(t, b"String", tcx, pcx) {
            buf_str(o, c"str");
        } else {
            buf_type(o, t, pcx);
        }
        let ot = buf_slice(o);
        for e in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[e as usize].kind;
            if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[e as usize].name == sym
                && pcx.defs[e as usize].owner >= 0 {
                let own = sym_text(pcx.defs[e as usize].owner, pcx);
                if own == ot || ot == b"[" && own.len() > 0 && own[0] == b'[' {
                    d = e;
                    break;
                }
            }
        }
    }
    if d >= 0 {
        return type_from_text(result_text(d, tcx, pcx), r, tcx, pcx);
    }
    no_type()
}

// Whether type t is the item named `name` (std's String...).
fn is_named(t: i64, name: &[u8], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let d = item_of_type(t, tcx, pcx);
    d >= 0 && sym_text(pcx.defs[d as usize].name, pcx) == name
}

// The type of field `name` of r.
fn field_result(r: TyRef, name: &[u8], tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    unsafe {
        let t = deref(r.t, pcx);
        if t > 0 && pcx.types[t as usize].kind == TyKind::Struct {
            let sym = find_sym(name, pcx);
            if sym >= 0 {
                let i = find_field(pcx.types[t as usize].a, sym, pcx);
                if i >= 0 {
                    return of_type((*struct_field(pcx.types[t as usize].a, i, pcx)).ty);
                }
            }
        }
        if t > 0 && pcx.types[t as usize].kind == TyKind::Tuple && name.len() > 0 && name[0] >= b'0'
            && name[0] <= b'9' {
            let mut k: i64 = 0;
            for i in 0..name.len() {
                k = k * 10 + (name[i] - b'0') as i64;
            }
            if k < pcx.types[t as usize].count {
                return of_type(type_elem(t, k, pcx));
            }
        }
        let od = if t > 0 { item_of_type(t, tcx, pcx) } else { r.d };
        let sym = find_sym(name, pcx);
        if od >= 0 && sym >= 0 {
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d as usize].kind == K_FIELD && pcx.defs[d as usize].parent == od
                    && pcx.defs[d as usize].name == sym {
                    return type_from_text(field_text(d, tcx, pcx), r, tcx, pcx);
                }
            }
        }
        no_type()
    }
}

// What `x?` gives of r: an Option's or a Result's first type argument.
fn unwrapped(r: TyRef, pcx: &Ctx<Comp>) -> TyRef {
    if r.t <= 0 && r.arg > 0 {
        return of_type(r.arg);
    }
    of_type(first_targ(r.t, pcx))
}

// The impl's type the cursor is in (Self), or -1.
fn self_def(tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if tcx.i_type.len() as i64 == 0 {
        return -1;
    }
    type_def_named(tok_text((tcx.i_type[(tcx.i_type.len() as i64 - 1) as usize]), tcx), tcx,
        pcx)
}

// The type of binding b.
fn binding_type(b: i64, depth: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    let name = (tcx.complete_b_name[b as usize]);
    let op = old_pos((tcx.ts[name as usize]), tcx, pcx);
    if op >= 0 {
        let l = tcx.local_by_pos.get(op + 1) - 1;
        if l >= 0 {
            return of_type(pcx.locals[l as usize].ty);
        }
    }
    if (tcx.b_ann[b as usize]) >= 0
        && (tcx.b_ann_end[b as usize]) > (tcx.b_ann[b as usize]) {
        let s = &tcx.complete_text[
            (tcx.ts[(tcx.b_ann[b as usize]) as usize]) as usize..(
                tcx.te[((tcx.b_ann_end[b as usize]) - 1) as usize]) as usize];
        let r = type_from_text(s, self_ref(tcx, pcx), tcx, pcx);
        if known(r) {
            return r;
        }
    }
    if tok_text(name, tcx) == b"self" {
        return TyRef { t: 0, d: self_def(tcx, pcx), slice: false, arg: 0 };
    }
    if (tcx.b_init[b as usize]) >= 0
        && (tcx.b_init_end[b as usize]) > (tcx.b_init[b as usize])
        && depth < 6 {
        let r = expr_type((tcx.b_init[b as usize]),
            (tcx.b_init_end[b as usize]) - 1, depth + 1, tcx, pcx);
        return if (tcx.b_iter[b as usize]) != 0 { element_of(r, tcx, pcx) }
            else { r };
    }
    no_type()
}

// The type of the name `name` used at token i: a binding, `self`, a
// static or a constant of the module.
fn name_type(name: &[u8], i: i64, depth: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    let b = binding_named(name, i, tcx);
    if b >= 0 {
        return binding_type(b, depth, tcx, pcx);
    }
    if name == b"self" {
        return TyRef { t: 0, d: self_def(tcx, pcx), slice: false, arg: 0 };
    }
    let sym = find_sym(name, pcx);
    if sym < 0 {
        return no_type();
    }
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if (k == K_STATIC || k == K_CONST) && pcx.defs[d as usize].name == sym
            && pcx.defs[d as usize].module == tcx.module {
            return value_type(d, tcx, pcx);
        }
    }
    // (an imported static or constant)
    for u in 0..tcx.u_name.len() as i64 {
        if (tcx.u_def[u as usize]) >= 0
            && tok_text((tcx.u_name[u as usize]), tcx) == name {
            let k = pcx.defs[(tcx.u_def[u as usize]) as usize].kind;
            if k == K_STATIC || k == K_CONST {
                return value_type((tcx.u_def[u as usize]), tcx, pcx);
            }
        }
    }
    no_type()
}

// The path `a::b::c` written from token i: its last name's token (the
// path is i..that), stepping over `::<..>`.
fn path_end(i: i64, to: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut j = i;
    while j + 2 <= to && tok_is(j + 1, b"::", tcx)
        && (is_ident(j + 2, tcx) || tok_is(j + 2, b"<", tcx)) {
        if tok_is(j + 2, b"<", tcx) {
            let e = until_stop(j + 3, to + 1, &[b">"], true, tcx);
            if !tok_is(e + 1, b"::", tcx) {
                return j;
            }
            j = e - 1;
        }
        j += 2;
    }
    j
}

// The definition the path of tokens i..=e names (`Vec::new_in`,
// `shapes::area`, `area`, `Self::f`), or -1.
fn path_def(i: i64, e: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let name = tok_text(e, tcx);
    let sym = find_sym(name, pcx);
    if sym < 0 {
        return -1;
    }
    if e == i {
        // a function the module has, imports, or the prelude's
        let mut best: i64 = -1;
        let mut best_rank: i64 = 0;
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].name != sym || pcx.defs[d as usize].parent >= 0
                || pcx.defs[d as usize].kind == K_METHOD
                || pcx.defs[d as usize].kind == K_IMPL_METHOD
                || pcx.defs[d as usize].kind == K_FIELD {
                continue;
            }
            let mut rank: i64 = 1;
            if pcx.defs[d as usize].module == tcx.module {
                rank = 4;
            } else if imported_as(d, tcx) {
                rank = 3;
            } else if pcx.defs[d as usize].public && pcx.defs[d as usize].module == pcx.std_module {
                rank = 2;
            }
            if rank > best_rank {
                best = d;
                best_rank = rank;
            }
        }
        return best;
    }
    // `Owner::name`: the owner a type (its functions, its variants) or
    // a module (its items)
    let mut oe = e - 2;
    while oe > i && tok_is(oe, b">", tcx) {
        oe = match_angle_back(oe, tcx) - 2;
    }
    let owner = if tok_text(oe, tcx) == b"Self" { self_def(tcx, pcx) }
        else { type_def_named(tok_text(oe, tcx), tcx, pcx) };
    if owner >= 0 && pcx.defs[owner as usize].fqn >= 0 {
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].name == sym
                && (pcx.defs[d as usize].owner == pcx.defs[owner as usize].fqn
                    || pcx.defs[d as usize].parent == owner) {
                return d;
            }
        }
    }
    let m = path_module(i, oe, tcx, pcx);
    if m >= 0 {
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].name == sym && pcx.defs[d as usize].module == m
                && pcx.defs[d as usize].parent < 0
                && pcx.defs[d as usize].kind != K_METHOD
                && pcx.defs[d as usize].kind != K_IMPL_METHOD {
                return d;
            }
        }
    }
    -1
}

// The `<` matching the `>` at token i, or i.
fn match_angle_back(i: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut depth: i64 = 0;
    let mut j = i;
    while j >= 0 {
        if tok_is(j, b">", tcx) {
            depth += 1;
        } else if tok_is(j, b"<", tcx) {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
        j -= 1;
    }
    i
}

// The type of a value of definition d: a function's result, a constant's
// or static's type, a variant's enum, a struct's.
fn value_type(d: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    let k = pcx.defs[d as usize].kind;
    if k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN {
        let f = pcx.nodes[pcx.defs[d as usize].node as usize].x - 1;
        if f >= 0 && f < pcx.fns.len() as i64 && pcx.fns[f as usize].generic == 0
            && pcx.fns[f as usize].ret > 0 {
            return of_type(fn_result(f, tcx, pcx));
        }
        if f >= 0 && f < pcx.fns.len() as i64 {
            for g in 0..pcx.fns.len() as i64 {
                if pcx.fns[g as usize].tmpl == f + 1 && pcx.fns[g as usize].ret > 0 {
                    // (an instance's: an owner's methods are the same)
                    let r = of_type(pcx.fns[g as usize].ret);
                    if item_of_type(r.t, tcx, pcx) >= 0 || deref(r.t, pcx) > 0 {
                        return r;
                    }
                }
            }
        }
        let owner: i64 = if pcx.defs[d as usize].parent >= 0 { pcx.defs[d as usize].parent }
            else if pcx.defs[d as usize].owner
            >= 0 { tcx.def_by_fqn.get(pcx.defs[d as usize].owner + 1) - 1 }
            else { -1 };
        return type_from_text(result_text(d, tcx, pcx), def_ref(owner), tcx, pcx);
    }
    if k == K_CONST || k == K_STATIC {
        let node = pcx.defs[d as usize].node;
        if k == K_STATIC {
            for i in 0..pcx.statics.len() as i64 {
                if pcx.statics[i as usize].node == node && pcx.statics[i as usize].ty > 0 {
                    return of_type(pcx.statics[i as usize].ty);
                }
            }
        } else {
            for i in 0..pcx.consts.len() as i64 {
                if pcx.consts[i as usize].node == node && pcx.consts[i as usize].ty > 0 {
                    return of_type(pcx.consts[i as usize].ty);
                }
            }
        }
        let ty = pcx.nodes[node as usize].ty;
        if ty > 0 {
            return of_type(ty);
        }
        return type_from_text(field_text(d, tcx, pcx), no_type(), tcx, pcx);
    }
    if k == K_VARIANT {
        return TyRef { t: 0, d: pcx.defs[d as usize].parent, slice: false, arg: 0 };
    }
    if k == K_STRUCT || k == K_ENUM {
        return TyRef { t: 0, d: d, slice: false, arg: 0 };
    }
    no_type()
}

// The type of the expression of tokens a..=b, as far as it can be told.
fn expr_type(a: i64, b: i64, depth: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> TyRef {
    if a > b || depth > 8 {
        return no_type();
    }
    // (the program's own node there, when the edit left it as it was)
    let oa = old_pos((tcx.ts[a as usize]), tcx, pcx);
    let ob = old_pos((tcx.te[b as usize]) - 1, tcx, pcx);
    if oa >= 0 && ob >= 0 {
        let t = typed_at(oa, ob + 1, tcx, pcx);
        if t > 0 {
            return of_type(t);
        }
    }
    let mut i = a;
    let mut r = no_type();
    while i <= b
        && (tok_is(i, b"&", tcx) || tok_is(i, b"*", tcx) || tok_is(i, b"-", tcx)
            || tok_is(i, b"!", tcx)) {
        i += 1;
    }
    if i > b {
        return r;
    }
    if tok_is(i, b"(", tcx) {
        let m = match_fwd(i, b + 1, tcx);
        r = expr_type(i + 1, m - 1, depth + 1, tcx, pcx);
        i = m + 1;
    } else if (tcx.tk[i as usize]) == T_STR {
        r = if pcx.str_type > 0 { of_type(pcx.str_type) } else { no_type() };
        i += 1;
    } else if (tcx.tk[i as usize]) == T_NUM {
        r = of_type(TY_I64);
        i += 1;
    } else if (tcx.tk[i as usize]) == T_ID {
        let e = path_end(i, b, tcx);
        if e + 1 <= b && tok_is(e + 1, b"(", tcx) {
            let d = path_def(i, e, tcx, pcx);
            if d >= 0 {
                r = value_type(d, tcx, pcx);
            }
            i = match_fwd(e + 1, b + 1, tcx) + 1;
        } else if e + 1 <= b && tok_is(e + 1, b"{", tcx) {
            r = TyRef {
                t: 0, d: type_def_named(tok_text(e, tcx), tcx, pcx), slice: false, arg: 0,
            };
            i = match_fwd(e + 1, b + 1, tcx) + 1;
        } else if e == i {
            // (a copy: name_type changes tcx)
            let text = tok_text(i, tcx).to_vec_in(Comp {});
            r = name_type(text.as_slice(), i, depth, tcx, pcx);
            i += 1;
        } else {
            let d = path_def(i, e, tcx, pcx);
            if d >= 0 {
                r = value_type(d, tcx, pcx);
            }
            i = e + 1;
        }
    } else {
        return no_type();
    }
    while i <= b && known(r) {
        if tok_is(i, b".", tcx) && i + 1 <= b {
            let name = tok_text(i + 1, tcx);
            let mut j = i + 2;
            if j + 1 <= b && tok_is(j, b"::", tcx) && tok_is(j + 1, b"<", tcx) {
                j = until_stop(j + 2, b + 1, &[b">"], true, tcx) + 1;
            }
            if j <= b && tok_is(j, b"(", tcx) {
                r = method_result(r, name, tcx, pcx);
                i = match_fwd(j, b + 1, tcx) + 1;
            } else {
                r = field_result(r, name, tcx, pcx);
                i += 2;
            }
        } else if tok_is(i, b"[", tcx) {
            r = element_of(r, tcx, pcx);
            i = match_fwd(i, b + 1, tcx) + 1;
        } else if tok_is(i, b"?", tcx) {
            r = unwrapped(r, pcx);
            i += 1;
        } else if tok_is(i, b"as", tcx) && i + 1 <= b {
            r = type_from_text(
                &tcx.complete_text[
                    (tcx.ts[(i + 1) as usize]) as usize..(tcx.te[b as usize]) as usize],
                self_ref(tcx, pcx), tcx, pcx);
            i = b + 1;
        } else {
            break;
        }
    }
    r
}

// The type of the program's expression from old position a to b (a node
// spanning exactly that), or 0.
fn typed_at(a: i64, b: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if !tcx.spans_indexed {
        for n in 1..pcx.nodes.len() {
            let k = pcx.nodes[n].kind;
            if pcx.nodes[n].ty > 0 && pcx.nodes[n].end > pcx.nodes[n].start
                && pcx.nodes[n].end - pcx.nodes[n].start < 1048576
                && (k == NodeKind::Ident || k == NodeKind::FieldAccess || k == NodeKind::Call
                    || k == NodeKind::MethodCall || k == NodeKind::Index
                    || k == NodeKind::Str) {
                let key = span_key(pcx.nodes[n].start, pcx.nodes[n].end);
                if tcx.complete_spans.get(key) == 0 {
                    tcx.complete_spans.put(key, pcx.nodes[n].ty);
                }
            }
        }
        tcx.spans_indexed = true;
    }
    if b <= a || b - a >= 1048576 {
        return 0;
    }
    tcx.complete_spans.get(span_key(a, b))
}

fn span_key(a: i64, b: i64) -> i64 {
    a * 1048576 + (b - a) + 1
}

// Whether no line break is between tokens i and j (i before j): `v.` at
// the end of a line is the line's own (what is typed), not the start of
// the next one's chain.
fn same_line(i: i64, j: i64, tcx: &Tcx<Comp>) -> bool {
    for p in (tcx.te[i as usize])..(tcx.ts[j as usize]) {
        if tcx.complete_text[p as usize] == b'\n' {
            return false;
        }
    }
    true
}

// The start of the expression ending at token e (`a.b(c)[d]`), walking
// back over its parts.
fn expr_start(e: i64, tcx: &Tcx<Comp>) -> i64 {
    let mut i = e;
    loop {
        if i < 0 {
            return 0;
        }
        if tok_is(i, b"?", tcx) {
            i -= 1;
            continue;
        }
        if tok_is(i, b")", tcx) || tok_is(i, b"]", tcx) || tok_is(i, b"}", tcx) {
            let j = match_back(i, tcx);
            if j < 0 {
                return i + 1;
            }
            if j > 0
                && (is_ident(j - 1, tcx) && !is_keyword(tok_text(j - 1, tcx))
                    || tok_is(j - 1, b")", tcx) || tok_is(j - 1, b"]", tcx)
                    || tok_is(j - 1, b">", tcx) || tok_is(j - 1, b"?", tcx)) {
                if tok_is(i, b"}", tcx) && !is_ident(j - 1, tcx) {
                    return j + 1;
                }
                i = j - 1;
                continue;
            }
            return j;
        }
        if tok_is(i, b">", tcx) {
            // `::<T>` of a call
            let j = match_angle_back(i, tcx);
            if j > 0 && tok_is(j - 1, b"::", tcx) {
                i = j - 2;
                continue;
            }
            return i + 1;
        }
        if tcx.tk[i as usize] == T_ID || tcx.tk[i as usize] == T_STR
            || tcx.tk[i as usize] == T_NUM {
            if i >= 2 && (tok_is(i - 1, b".", tcx) || tok_is(i - 1, b"::", tcx))
                && same_line(i - 1, i, tcx) {
                i -= 2;
                continue;
            }
            return i;
        }
        return i + 1;
    }
}

// ---- imports (the text's `use` lines)

fn scan_uses(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    tcx.u_name.clear();
    tcx.complete_u_first.clear();
    tcx.u_last.clear();
    tcx.u_def.clear();
    let mut depth: i64 = 0;
    let mut i: i64 = 0;
    while i < tcx.tk.len() as i64 {
        if tok_is(i, b"{", tcx) {
            depth += 1;
        } else if tok_is(i, b"}", tcx) {
            depth -= 1;
        } else if depth == 0 && tok_is(i, b"use", tcx) {
            let e = until_stop(i + 1, tcx.tk.len() as i64, &[b";"], false, tcx);
            use_tree(i + 1, e, i + 1, tcx);
            i = e;
        }
        i += 1;
    }
    for k in 0..tcx.u_name.len() as i64 {
        tcx.u_def.push(use_def(k, tcx, pcx));
    }
}

// The names of the use tree of tokens a..e (the path from `first`).
fn use_tree(a: i64, e: i64, first: i64, tcx: &mut Tcx<Comp>) {
    let mut i = a;
    while i < e {
        if tok_is(i, b"{", tcx) {
            let close = match_fwd(i, e, tcx);
            let mut p = i + 1;
            while p < close {
                let q = until_stop(p, close, &[b","], false, tcx);
                use_tree(p, q, first, tcx);
                p = q + 1;
            }
            return;
        }
        if is_ident(i, tcx) && !tok_is(i + 1, b"::", tcx) {
            let mut name = i;
            if tok_is(i + 1, b"as", tcx) && is_ident(i + 2, tcx) {
                name = i + 2;
            }
            tcx.u_name.push(name);
            tcx.complete_u_first.push(first);
            tcx.u_last.push(i);
            return;
        }
        i += 1;
    }
}

// The definition import k names, or -1: its path's names, from the
// module the path starts at.
fn use_def(k: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let last = (tcx.u_last[k as usize]);
    let sym = find_sym(tok_text(last, tcx), pcx);
    if sym < 0 {
        return -1;
    }
    let prev = last - 2;
    if last <= (tcx.complete_u_first[k as usize]) {
        return -1;
    }
    // the path's module: its tokens before the last name, skipping a
    // `{` and the names inside it before ours
    let m = path_module_tokens((tcx.complete_u_first[k as usize]), last, tcx, pcx);
    if m < 0 {
        if !tok_is(last - 1, b"::", tcx) {
            return -1;
        }
        // `use a::Type::Variant`, `use a::Trait::f`
        let td = type_def_named(tok_text(prev, tcx), tcx, pcx);
        if td >= 0 {
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d as usize].parent == td && pcx.defs[d as usize].name == sym {
                    return d;
                }
            }
        }
        return -1;
    }
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d as usize].name == sym && pcx.defs[d as usize].module == m
            && pcx.defs[d as usize].parent < 0
            && pcx.defs[d as usize].kind != K_METHOD
            && pcx.defs[d as usize].kind != K_IMPL_METHOD {
            return d;
        }
    }
    -1
}

// The module the names of a use path from `first` up to (not with) the
// token `last` lead to (the names of a `{..}` the path is in skipped), or
// -1.
fn path_module_tokens(first: i64, last: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut segs: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut i = first;
    while i < last {
        if is_ident(i, tcx) && tok_is(i + 1, b"::", tcx) {
            segs.push(i);
            i += 2;
        } else if tok_is(i, b"{", tcx) {
            i += 1;
        } else {
            // a sibling's name in the braces: its own path, not ours
            let e = until_stop(i, last, &[b","], false, tcx);
            if e >= last {
                break;
            }
            i = e + 1;
        }
    }
    modules_of(segs.as_slice(), tcx, pcx)
}

// The module of the path of tokens i..=e (all names), or -1.
fn path_module(i: i64, e: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut segs: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut j = i;
    while j <= e {
        if is_ident(j, tcx) {
            segs.push(j);
        }
        j += 1;
    }
    modules_of(segs.as_slice(), tcx, pcx)
}

// The module the names (tokens) lead to: `crate`, `std`, `self`,
// `super`, a child of the module, of its parent, of the root, of std.
fn modules_of(segs: &[i64], tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if segs.len() as i64 == 0 {
        return -1;
    }
    let first = tok_text((segs[0]), tcx);
    let mut m: i64 = -1;
    let mut k: i64 = 1;
    if first == b"crate" {
        m = 0;
    } else if first == b"std" {
        m = pcx.std_module;
    } else if first == b"self" {
        m = tcx.module;
    } else if first == b"super" {
        m = if tcx.module > 0 { pcx.modules[tcx.module as usize].parent } else { 0 };
    } else {
        k = 0;
        let sym = find_sym(first, pcx);
        if sym < 0 {
            return -1;
        }
        m = child_module(tcx.module, sym, pcx);
        if m < 0 && tcx.module > 0 {
            m = child_module(pcx.modules[tcx.module as usize].parent, sym, pcx);
        }
        if m < 0 {
            m = child_module(0, sym, pcx);
        }
        if m < 0 && pcx.std_module >= 0 {
            m = child_module(pcx.std_module, sym, pcx);
        }
        if m < 0 {
            // an imported module (`use std::collections; collections::`)
            for u in 0..tcx.u_name.len() as i64 {
                if tok_text((tcx.u_name[u as usize]), tcx) == first
                    && (tcx.u_def[u as usize]) >= 0
                    && pcx.defs[(tcx.u_def[u as usize]) as usize].kind == K_MOD {
                    let d = (tcx.u_def[u as usize]);
                    m = child_module(pcx.defs[d as usize].module, pcx.defs[d as usize].name,
                        pcx);
                }
            }
        }
        if m < 0 {
            return -1;
        }
        k = 1;
    }
    while k < segs.len() as i64 && m >= 0 {
        let sym = find_sym(tok_text((segs[k as usize]), tcx), pcx);
        if tok_text((segs[k as usize]), tcx) == b"super" {
            m = pcx.modules[m as usize].parent;
        } else {
            m = if sym < 0 { -1 } else { child_module(m, sym, pcx) };
        }
        k += 1;
    }
    m
}

// Whether definition d is a name the text imports.
fn imported_as(d: i64, tcx: &Tcx<Comp>) -> bool {
    for u in 0..tcx.u_def.len() as i64 {
        if (tcx.u_def[u as usize]) == d {
            return true;
        }
    }
    false
}

// ---- the items

const ITEMS_MAX: i64 = 400;

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 as u8 } else { c }
}

// How label matches the prefix: 0 it starts with it, 1 so case ignored,
// 2 its letters in order, -1 not.
fn match_rank(label: &[u8], tcx: &Tcx<Comp>) -> i64 {
    let p = &tcx.complete_text[tcx.prefix_start as usize..tcx.prefix_end as usize];
    if p.len() == 0 {
        return 0;
    }
    if label.len() >= p.len() && label[0..p.len()] == p {
        return 0;
    }
    let mut ci = label.len() >= p.len();
    if ci {
        for i in 0..p.len() {
            if lower(label[i]) != lower(p[i]) {
                ci = false;
            }
        }
    }
    if ci {
        return 1;
    }
    let mut j: i64 = 0;
    for i in 0..label.len() {
        if j < p.len() as i64 && lower(label[i]) == lower(p[j as usize]) {
            j += 1;
        }
    }
    if j == p.len() as i64 && lower(label[0]) == lower(p[0]) { 2 } else { -1 }
}

fn label_hash(s: &[u8]) -> i64 {
    let mut h = 1469598103934665603i64 as u64;
    for i in 0..s.len() {
        h = (h ^ s[i] as u64).wrapping_mul(1099511628211u64);
    }
    ((h >> 2) as i64) + 1
}

// Adds an item: its label, LSP kind, detail, group (lower first), the
// definition (-1: none), what to insert (empty: the label; snippet: a
// snippet), whether its type is the one expected.
fn add_item(label: &[u8], kind: i64, detail: &[u8], group: i64, d: i64, insert: &[u8],
    snippet: bool, expected: bool, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    if label.len() == 0 {
        return;
    }
    // (0.28.0) std's own names (`__int_bits`, `__unwrap_at`) are not offered
    if d >= 0 && crate::tools::query::show::std_own_name(label)
        && in_std(pcx.defs[d as usize].module, pcx) {
        return;
    }
    let rank = match_rank(label, tcx);
    if rank < 0 {
        return;
    }
    let h = label_hash(label);
    if tcx.seen.get(h) != 0 {
        return;
    }
    tcx.seen.put(h, 1);
    if tcx.complete_items >= ITEMS_MAX {
        tcx.cut = true;
        return;
    }
    if tcx.complete_items > 0 {
        buf_byte(tcx.out, b',');
    }
    tcx.complete_items += 1;
    buf_str(tcx.out, c"{\"label\":");
    buf_json_str(tcx.out, label);
    buf_fmt(tcx.out, format_args(",\"kind\":{kind}"));
    if detail.len() > 0 {
        buf_str(tcx.out, c",\"detail\":");
        buf_json_str(tcx.out, if detail.len() > 160 { &detail[0..160] } else { detail });
    }
    let g: i64 = if expected { 0 } else { group };
    buf_fmt(tcx.out, format_args(",\"sortText\":\"{rank}{g}"));
    // (the label's own order after: JSON-safe, it is a name)
    for i in 0..label.len() {
        if label[i] != b'"' && label[i] != b'\\' {
            buf_byte(tcx.out, label[i]);
        }
    }
    buf_byte(tcx.out, b'"');
    if insert.len() > 0 {
        buf_str(tcx.out, c",\"insertText\":");
        buf_json_str(tcx.out, insert);
        if snippet {
            buf_str(tcx.out, c",\"insertTextFormat\":2");
        }
    }
    if d >= 0 && pcx.defs[d as usize].fqn >= 0 {
        // (by its path, not its index: the same in every worker)
        buf_str(tcx.out, c",\"data\":{\"p\":");
        buf_json_str(tcx.out, sym_text(pcx.defs[d as usize].fqn, pcx));
        buf_str(tcx.out, c"}");
    }
    buf_byte(tcx.out, b'}');
}

// The LSP kind of definition d.
fn item_kind(d: i64, pcx: &Ctx<Comp>) -> i64 {
    let k = pcx.defs[d as usize].kind;
    if k == K_FN { 3 }
    else if k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN {
        if has_self(d, pcx) { 2 } else { 3 }
    }
    else if k == K_STRUCT || k == K_ALIAS { 22 }
    else if k == K_ENUM { 13 }
    else if k == K_VARIANT { 20 }
    else if k == K_FIELD { 5 }
    else if k == K_TRAIT { 8 }
    else if k == K_CONST { 21 }
    else if k == K_STATIC { 6 }
    else if k == K_MOD { 9 } else { 1 }
}

fn is_fn_def(d: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.defs[d as usize].kind;
    k == K_FN || k == K_METHOD || k == K_IMPL_METHOD || k == K_TRAIT_FN
}

// Whether function definition d takes `self`.
fn has_self(d: i64, pcx: &Ctx<Comp>) -> bool {
    let n = pcx.defs[d as usize].node;
    pcx.nodes[n as usize].kind == NodeKind::Fn && pcx.nodes[n as usize].count > 0
        && pcx.nodes[child(n, 0, pcx) as usize].kind == NodeKind::Param
        && pcx.nodes[child(n, 0, pcx) as usize].a == pcx.self_sym
}

// The snippet calling function definition d: `name(${1:a}, ${2:b})`
// (without `self`), or empty.
fn call_snippet(d: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    if !tcx.snippets || tcx.call_follows || !is_fn_def(d, pcx) {
        return b"";
    }
    let n = pcx.defs[d as usize].node;
    let b = buf_new();
    buf_bytes(b, sym_text(pcx.defs[d as usize].name, pcx));
    buf_byte(b, b'(');
    let mut k: i64 = 0;
    for i in 0..pcx.nodes[n as usize].count {
        let p = child(n, i, pcx);
        if pcx.nodes[p as usize].kind != NodeKind::Param {
            break;
        }
        if pcx.nodes[p as usize].a == pcx.self_sym {
            continue;
        }
        if k > 0 {
            buf_str(b, c", ");
        }
        k += 1;
        buf_fmt(b, format_args("${{{k}:"));
        buf_bytes(b, sym_text(pcx.nodes[p as usize].a, pcx));
        buf_byte(b, b'}');
    }
    buf_str(b, c")$0");
    buf_done(b)
}

// Whether the type of a value of definition d is the expected one.
fn expected_def(d: i64, tcx: &Tcx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if tcx.expect <= 0 && tcx.expect_d < 0 {
        return false;
    }
    let k = pcx.defs[d as usize].kind;
    if !(is_fn_def(d, pcx) || k == K_CONST || k == K_STATIC || k == K_VARIANT) {
        return false;
    }
    same_type(value_type(d, tcx, pcx), tcx, pcx)
}

fn same_type(r: TyRef, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    if tcx.expect > 0 && r.t > 0 {
        return deref(r.t, pcx) == deref(tcx.expect, pcx)
            || item_of_type(r.t, tcx, pcx) >= 0
            && item_of_type(r.t, tcx, pcx) == item_of_type(tcx.expect, tcx, pcx);
    }
    let d = if r.t > 0 { item_of_type(r.t, tcx, pcx) } else { r.d };
    d >= 0 && (d == tcx.expect_d || tcx.expect > 0 && d == item_of_type(tcx.expect, tcx, pcx))
}

// The item of definition d (its signature the detail).
fn add_def(d: i64, group: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let label = sym_text(pcx.defs[d as usize].name, pcx);
    if match_rank(label, tcx) < 0 {
        return;
    }
    let k = pcx.defs[d as usize].kind;
    if !pcx.defs[d as usize].public && k != K_IMPL_METHOD && k != K_TRAIT_FN && k != K_VARIANT
        && !sees_inside(pcx.defs[d as usize].module, tcx, pcx) {
        return;
    }
    let snip = call_snippet(d, tcx, pcx);
    add_item(label, item_kind(d, pcx), signature(d, tcx, pcx), group, d, snip, snip.len() > 0,
        expected_def(d, tcx, pcx), tcx, pcx);
}

// ---- the contexts

// After `.`: the fields and methods of r.
fn members(r: TyRef, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let t = deref(r.t, pcx);
        if t > 0 && pcx.types[t as usize].kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                let b = buf_new();
                buf_type(b, type_elem(t, i, pcx), pcx);
                let l = buf_new();
                buf_fmt(l, format_args("{i}"));
                add_item(buf_slice(l), 5, buf_slice(b), 1, -1, b"", false, false, tcx, pcx);
            }
            return;
        }
        let od = if t > 0 { item_of_type(t, tcx, pcx) } else { r.d };
        // the fields (another module's: its public ones)
        if od >= 0 && pcx.defs[od as usize].kind == K_STRUCT {
            let mine = sees_inside(pcx.defs[od as usize].module, tcx, pcx);
            for d in 0..pcx.defs.len() as i64 {
                if pcx.defs[d as usize].kind == K_FIELD && pcx.defs[d as usize].parent == od
                    && (mine || pcx.defs[d as usize].public) {
                    let mut detail = signature(d, tcx, pcx);
                    let sym = pcx.defs[d as usize].name;
                    if t > 0 && pcx.types[t as usize].kind == TyKind::Struct {
                        let i = find_field(pcx.types[t as usize].a, sym, pcx);
                        if i >= 0 {
                            let b = buf_new();
                            // (0.26.0: a field's visibility)
                            if pcx.defs[d as usize].public {
                                buf_str(b, c"pub ");
                            }
                            buf_bytes(b, sym_text(sym, pcx));
                            buf_str(b, c": ");
                            buf_type(b, (*struct_field(pcx.types[t as usize].a, i, pcx)).ty, pcx);
                            detail = buf_slice(b);
                        }
                    }
                    let exp = (tcx.expect > 0 || tcx.expect_d >= 0)
                        && same_type(field_result(r, sym_text(sym, pcx), tcx, pcx), tcx, pcx);
                    add_item(sym_text(sym, pcx), 5, detail, 1, d, b"", false, exp, tcx, pcx);
                }
            }
        }
        if od >= 0 {
            owner_methods(od, 2, tcx, pcx);
        }
        if t > 0 {
            // the methods the checker knows of t (derived ones too)
            for i in 0..pcx.methods.len() as i64 {
                if pcx.methods[i as usize].ty == t {
                    let d = def_of_node(pcx.fns[pcx.methods[i as usize].f as usize].node, tcx, pcx);
                    if d >= 0 && has_self(d, pcx) {
                        add_def(d, 2, tcx, pcx);
                    }
                }
            }
            let k = pcx.types[t as usize].kind;
            if pcx.str_type > 0 && (t == pcx.str_type || is_named(t, b"String", tcx, pcx)) {
                owner_named(b"str", 3, tcx, pcx);
                if t != pcx.str_type {
                    let sd = item_of_type(pcx.str_type, tcx, pcx);
                    if sd >= 0 {
                        owner_methods(sd, 3, tcx, pcx);
                    }
                }
            }
            if is_named(t, b"PathBuf", tcx, pcx) {
                let pd = type_def_named(b"Path", tcx, pcx);
                if pd >= 0 {
                    owner_methods(pd, 3, tcx, pcx);
                }
            }
            if k == TyKind::Slice || k == TyKind::Array {
                slice_members(tcx, pcx);
            } else if k == TyKind::Prim || k == TyKind::Distinct {
                let b = buf_new();
                buf_type(b, t, pcx);
                owner_named(buf_slice(b), 2, tcx, pcx);
            }
        }
        if r.slice {
            slice_members(tcx, pcx);
        }
    }
}

fn slice_members(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    add_item(b"len", 2, b"fn len(self) -> usize", 1, -1, if tcx.snippets && !tcx.call_follows {
        b"len()$0" } else { b"" }, true, false, tcx, pcx);
    owner_named(b"[T]", 2, tcx, pcx);
}

// The methods (with self) of the impl blocks of definition od, and of
// the traits it implements (their default ones too).
fn owner_methods(od: i64, group: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let owner = pcx.defs[od as usize].fqn;
    if owner < 0 {
        return;
    }
    let mut traits: Vec<i64, Comp> = Vec::new_in(Comp {});
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d as usize].owner == owner {
            if has_self(d, pcx) {
                add_def(d, if k == K_METHOD { group } else { group + 1 }, tcx, pcx);
            }
            if k == K_IMPL_METHOD && pcx.defs[d as usize].tr >= 0 {
                let mut seen = false;
                for j in 0..traits.len() as i64 {
                    if (traits[j as usize]) == pcx.defs[d as usize].tr {
                        seen = true;
                    }
                }
                if !seen {
                    traits.push(pcx.defs[d as usize].tr);
                }
            }
        }
    }
    if pcx.defs[od as usize].kind == K_TRAIT {
        traits.push(pcx.defs[od as usize].fqn);
    }
    for j in 0..traits.len() as i64 {
        let td = tcx.def_by_fqn.get((traits[j as usize]) + 1) - 1;
        if td < 0 {
            continue;
        }
        for d in 0..pcx.defs.len() as i64 {
            if pcx.defs[d as usize].kind == K_TRAIT_FN && pcx.defs[d as usize].parent == td
                && has_self(d, pcx) {
                add_def(d, group + 1, tcx, pcx);
            }
        }
    }
}

// The methods of the impl blocks of a type written `name` (`str`, `[T]`,
// `i64`: no item of its own).
fn owner_named(name: &[u8], group: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let slice = name.len() > 0 && name[0] == b'[';
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d as usize].owner >= 0 {
            let o = sym_text(pcx.defs[d as usize].owner, pcx);
            if (o == name || slice && o.len() > 0 && o[0] == b'[') && has_self(d, pcx) {
                add_def(d, group, tcx, pcx);
            }
        }
    }
}

// After `path::`: the module's items, the type's variants and functions.
fn path_items(first: i64, last: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    // a type (`Vec::`, `Shape::`, `Self::`, `std::Vec::`)
    let mut td: i64 = -1;
    let lt = tok_text(last, tcx);
    if lt == b"Self" {
        td = self_def(tcx, pcx);
    } else if first == last {
        td = type_def_named(lt, tcx, pcx);
        if td >= 0 && pcx.defs[td as usize].module != tcx.module && !imported_as(td, tcx)
            && !(pcx.defs[td as usize].public && pcx.defs[td as usize].module == pcx.std_module) {
            // (a type's name the module does not see, or a module's)
            let m = path_module(first, last, tcx, pcx);
            if m >= 0 {
                td = -1;
            }
        }
    } else {
        td = path_def(first, last, tcx, pcx);
        if td >= 0
            && !(pcx.defs[td as usize].kind == K_STRUCT || pcx.defs[td as usize].kind == K_ENUM
                || pcx.defs[td as usize].kind == K_TRAIT || pcx.defs[td as usize].kind == K_ALIAS) {
            td = -1;
        }
    }
    if td >= 0 {
        let owner = pcx.defs[td as usize].fqn;
        for d in 0..pcx.defs.len() as i64 {
            let k = pcx.defs[d as usize].kind;
            if k == K_VARIANT && pcx.defs[d as usize].parent == td {
                add_def(d, 1, tcx, pcx);
            } else if (k == K_METHOD || k == K_IMPL_METHOD) && pcx.defs[d as usize].owner == owner {
                add_def(d, if has_self(d, pcx) { 3 } else { 2 }, tcx, pcx);
            } else if k == K_TRAIT_FN && pcx.defs[d as usize].parent == td {
                add_def(d, 2, tcx, pcx);
            }
        }
        return;
    }
    let m = path_module(first, last, tcx, pcx);
    if m >= 0 {
        module_items(m, 2, tcx, pcx);
    }
}

// Whether the cursor's module is m or one inside it (it sees m's private
// items).
fn sees_inside(m: i64, tcx: &Tcx<Comp>, pcx: &Ctx<Comp>) -> bool {
    let mut c = tcx.module;
    let mut n: i64 = 0;
    while c >= 0 && n < 64 {
        if c == m {
            return true;
        }
        if c == 0 {
            break;
        }
        c = pcx.modules[c as usize].parent;
        n += 1;
    }
    false
}

// The items of module m (its public ones, unless the cursor is in it or
// in one inside it).
fn module_items(m: i64, group: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    let inside = sees_inside(m, tcx, pcx);
    for d in 0..pcx.defs.len() as i64 {
        let k = pcx.defs[d as usize].kind;
        if pcx.defs[d as usize].module == m && pcx.defs[d as usize].parent < 0 && k != K_METHOD
            && k != K_IMPL_METHOD
            && k != K_FIELD && (inside || pcx.defs[d as usize].public) {
            add_def(d, group, tcx, pcx);
        }
    }
    // (the modules std's root declares, which have no `mod` item of
    // the program when std is one text)
    for c2 in 1..module_count(pcx) {
        if pcx.modules[c2 as usize].parent == m && (inside || pcx.modules[c2 as usize].public) {
            add_item(sym_text(pcx.modules[c2 as usize].name, pcx), 9, mod_detail(c2, tcx, pcx),
                group, -1, b"", false, false, tcx, pcx);
        }
    }
}

fn mod_detail(m: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> &'static [u8] {
    let b = buf_new();
    buf_str(b, c"mod ");
    let fqn = mod_fqn(m, tcx, pcx);
    (buf_bytes(b, sym_text(fqn, pcx)));
    buf_done(b)
}

// After `use ` (or `use a::{`): the roots of paths.
fn path_roots(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    add_item(b"crate", 9, b"the program's root module", 4, -1, b"", false, false, tcx, pcx);
    add_item(b"std", 9, b"the standard library", 4, -1, b"", false, false, tcx, pcx);
    add_item(b"self", 9, b"this module", 4, -1, b"", false, false, tcx, pcx);
    add_item(b"super", 9, b"the module this one is in", 4, -1, b"", false, false, tcx, pcx);
    for c in 1..module_count(pcx) {
        if pcx.modules[c as usize].parent == tcx.module
            || tcx.module > 0
            && pcx.modules[c as usize].parent == pcx.modules[tcx.module as usize].parent {
            add_item(sym_text(pcx.modules[c as usize].name, pcx), 9, mod_detail(c, tcx, pcx), 2, -1,
                b"", false, false, tcx, pcx);
        }
    }
}

// A name: the locals, the module's items, its imports, the prelude, the
// keywords and snippets.
fn names(tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    // the locals, innermost first
    let mut b = tcx.complete_b_name.len() as i64 - 1;
    while b >= 0 {
        // (copies: add_item changes tcx)
        let copy = tok_text((tcx.complete_b_name[b as usize]), tcx).to_vec_in(
            Comp {});
        let name = copy.as_slice();
        if (tcx.ts[(tcx.complete_b_name[b as usize]) as usize])
            < tcx.complete_cur
            && match_rank(name, tcx) >= 0 {
            let r = binding_type(b, 0, tcx, pcx);
            let detail = buf_new();
            if r.t > 0 {
                buf_type(detail, r.t, pcx);
            } else if r.d >= 0 {
                buf_bytes(detail, sym_text(pcx.defs[r.d as usize].name, pcx));
            }
            else if (tcx.b_ann[b as usize]) >= 0
                && (tcx.b_ann_end[b as usize]) > (tcx.b_ann[b as usize]) {
                buf_bytes(detail,
                    &tcx.complete_text[
                        (tcx.ts[(tcx.b_ann[b as usize]) as usize]) as usize..(
                            tcx.te[((tcx.b_ann_end[b as usize]) - 1) as usize]) as usize]);
            }
            add_item(name, 6, buf_slice(detail), 1, -1, b"", false,
                known(r) && same_type(r, tcx, pcx), tcx, pcx);
        }
        b -= 1;
    }
    if tcx.have_program && tcx.file >= 0 {
        module_items(tcx.module, 2, tcx, pcx);
    }
    if tcx.have_program {
        // the imports
        for u in 0..tcx.u_name.len() as i64 {
            let d = (tcx.u_def[u as usize]);
            let copy = tok_text((tcx.u_name[u as usize]), tcx).to_vec_in(Comp {});
            let name = copy.as_slice();
            if d >= 0 {
                let snip = call_snippet(d, tcx, pcx);
                add_item(name, item_kind(d, pcx), signature(d, tcx, pcx), 3, d, snip,
                    snip.len() > 0, expected_def(d, tcx, pcx), tcx, pcx);
            } else {
                add_item(name, 18, b"", 3, -1, b"", false, false, tcx, pcx);
            }
        }
        // the prelude
        for k in 0..PRELUDE_COUNT {
            let sym = prelude_name(k, pcx);
            let d = prelude_def_at(k, tcx, pcx);
            if d >= 0 && pcx.defs[d as usize].name != sym {
                // (`panic`: std's panic_str)
                add_item(sym_text(sym, pcx), item_kind(d, pcx), signature(d, tcx, pcx), 4, d,
                    call_snippet(d, tcx, pcx), call_snippet(d, tcx, pcx).len() > 0, false, tcx,
                    pcx);
            } else if d >= 0 {
                add_def(d, 4, tcx, pcx);
            } else {
                add_item(sym_text(sym, pcx), 3, b"", 4, -1, b"", false, false, tcx, pcx);
            }
        }
    }
    keywords(tcx, pcx);
}

// The definition in std of the prelude's name k, or -1.
fn prelude_def_at(k: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if tcx.prelude_defs.len() as i64 == 0 {
        for j in 0..PRELUDE_COUNT {
            let sym = prelude_name(j, pcx);
            let mut d: i64 = -1;
            if sym_text(sym, pcx) == b"panic" {
                let ps = find_sym(b"panic_str", pcx);
                if ps >= 0 {
                    d = prelude_def(ps, pcx);
                }
            }
            if d < 0 {
                d = prelude_def(sym, pcx);
            }
            tcx.prelude_defs.push(d + 1);
        }
    }
    (tcx.prelude_defs[k as usize]) - 1
}

// The definition in std of prelude name sym.
fn prelude_def(sym: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut best: i64 = -1;
    for d in 0..pcx.defs.len() as i64 {
        if pcx.defs[d as usize].name == sym && pcx.defs[d as usize].public
            && in_std(pcx.defs[d as usize].module, pcx)
            && (pcx.defs[d as usize].parent < 0 || pcx.defs[d as usize].kind == K_VARIANT)
            && pcx.defs[d as usize].kind != K_METHOD && pcx.defs[d as usize].kind != K_IMPL_METHOD {
            if best < 0
                || pcx.defs[d as usize].module == pcx.std_module
                && pcx.defs[best as usize].module != pcx.std_module {
                best = d;
            }
        }
    }
    best
}

fn keywords(tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) {
    let snips: [&[u8]; 13] = [b"fn", b"if", b"for", b"while", b"loop", b"match", b"struct", b"enum",
        b"impl", b"trait", b"let", b"var", b"test"];
    let bodies: [&[u8]; 13] = [b"fn ${1:name}(${2}) {\n\t$0\n}", b"if ${1:condition} {\n\t$0\n}",
        b"for ${1:x} in ${2:iter} {\n\t$0\n}", b"while ${1:condition} {\n\t$0\n}",
        b"loop {\n\t$0\n}", b"match ${1:value} {\n\t${2:pattern} => $0,\n}",
        b"struct ${1:Name} {\n\t${2:field}: ${3:i64},\n}",
        b"enum ${1:Name} {\n\t${2:Variant},\n}", b"impl ${1:Type} {\n\t$0\n}",
        b"trait ${1:Name} {\n\t$0\n}", b"let ${1:name} = $0;", b"var ${1:name} = $0;",
        b"#[test]\nfn ${1:name}() {\n\t$0\n}"];
    let details: [&[u8]; 13] = [b"fn name(..) { .. }", b"if cond { .. }", b"for x in iter { .. }",
        b"while cond { .. }", b"loop { .. }", b"match value { pattern => .. }",
        b"struct Name { field: T }", b"enum Name { Variant }", b"impl Type { .. }",
        b"trait Name { .. }", b"let name = value;", b"var name = value;",
        b"#[test] fn name() { .. }"];
    // (0.28.0: a rust-edition program's mutable binding is `let mut`)
    let mut snips = snips;
    let mut bodies = bodies;
    let mut details = details;
    snips[11] = b"let mut";
    bodies[11] = b"let mut ${1:name} = $0;";
    details[11] = b"let mut name = value;";
    if tcx.snippets {
        for i in 0..13 {
            add_item(snips[i as usize], 15, details[i as usize], 6, -1, bodies[i as usize], true,
                false, tcx, pcx);
        }
    }
    for i in 0..36 {
        add_item(KEYWORDS[i as usize], 14, b"", 5, -1, b"", false, false, tcx, pcx);
    }
    add_item(b"crate", 14, b"", 5, -1, b"", false, false, tcx, pcx);
    add_item(b"super", 14, b"", 5, -1, b"", false, false, tcx, pcx);
    add_item(b"mut", 14, b"", 5, -1, b"", false, false, tcx, pcx);
}

// What the place before token i expects: `let x: T = `, `x = ` of a
// known x, `return ` (the function's result). EXPECT, EXPECT_D.
fn find_expected(i: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    tcx.expect = 0;
    tcx.expect_d = -1;
    if i < 0 || !tcx.have_program {
        return;
    }
    let mut r = no_type();
    if tok_is(i, b"=", tcx) {
        // `let name: T =`, `name =`
        if tok_is(i - 1, b">", tcx) || is_ident(i - 1, tcx) || tok_is(i - 1, b"]", tcx) {
            let mut c = i - 1;
            let mut nest: i64 = 0;
            while c > 0
                && !(nest == 0
                    && (tok_is(c, b":", tcx) || tok_is(c, b";", tcx) || tok_is(c, b"{", tcx)
                        || tok_is(c, b"}", tcx) || tok_is(c, b"let", tcx)
                        || tok_is(c, b"var", tcx))) {
                if tok_is(c, b">", tcx) || tok_is(c, b"]", tcx) {
                    nest += 1;
                } else if tok_is(c, b"<", tcx) || tok_is(c, b"[", tcx) {
                    nest -= 1;
                }
                c -= 1;
            }
            if tok_is(c, b":", tcx) {
                r = type_from_text(
                    &tcx.complete_text[
                        (tcx.ts[(c + 1) as usize]) as usize..(tcx.te[(i - 1) as usize]) as usize],
                    self_ref(tcx, pcx), tcx, pcx);
            }
            else if is_ident(i - 1, tcx)
                && (tok_is(i - 2, b";", tcx) || tok_is(i - 2, b"{", tcx)
                    || tok_is(i - 2, b"}", tcx)) {
                let text = tok_text(i - 1, tcx).to_vec_in(Comp {});
                r = name_type(text.as_slice(), i - 1, 0, tcx, pcx);
            }
        }
    } else if tok_is(i, b"return", tcx) && tcx.f_ret.len() as i64 > 0 {
        let a = (tcx.f_ret[(tcx.f_ret.len() as i64 - 1) as usize]);
        let e = (tcx.f_ret_end[(tcx.f_ret_end.len() as i64 - 1) as usize]);
        if a >= 0 && e > a {
            r = type_from_text(
                &tcx.complete_text[
                    (tcx.ts[a as usize]) as usize..(tcx.te[(e - 1) as usize]) as usize],
                self_ref(tcx, pcx), tcx, pcx);
        }
    }
    tcx.expect = r.t;
    tcx.expect_d = r.d;
}

// ---- the request

// The text and the cursor read: its tokens (TK..), the program's file
// compared with it, the cursor's module, the tokens before it (NT).
fn read_text(f: i64, text: &[u8], line: i64, ch: i64, utf8: bool, have_program: bool,
    tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    // (0.27.0: the tokens are offsets in a copy of the text, tcx's)
    tcx.complete_text.clear();
    tcx.complete_text.extend_from_slice(text);
    tcx.complete_cur = text_offset(text, line, ch, utf8);
    tcx.have_program = have_program;
    tcx.file = if have_program { f } else { -1 };
    tcx.tk.clear();
    tcx.ts.clear();
    tcx.te.clear();
    tcx.in_text = false;
    lex_code(text, 0, false, tcx);
    if have_program {
        index_defs(tcx, pcx);
    }
    compare_with_program(tcx, pcx);
    tcx.module = if tcx.file >= 0 { module_at(near_old_pos(tcx.complete_cur, tcx, pcx), pcx) }
        else { 0 };
    if tcx.module < 0 {
        tcx.module = 0;
    }
    tcx.nt = 0;
    while tcx.nt < tcx.tk.len() as i64 && (tcx.ts[tcx.nt as usize]) < tcx.complete_cur {
        tcx.nt += 1;
    }
}

// The completion list for the text at (line, ch), into out: the
// program's file f (-1: none), its own text; utf8: the position encoding;
// snippets: the client takes them.
pub fn put_completion(out: i64, f: i64, text: &[u8], line: i64, ch: i64, utf8: bool,
    have_program: bool, snippets: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        tcx.out = out;
        tcx.seen.clear();
        tcx.complete_items = 0;
        tcx.cut = false;
        tcx.snippets = snippets;
        read_text(f, text, line, ch, utf8, have_program, tcx, pcx);
        buf_str(out, c"{\"isIncomplete\":");
        let mark = buf_slice(out).len() as i64;
        buf_str(out, c"false,\"items\":[");
        if tcx.in_text {
            buf_str(out, c"]}");
            return;
        }
        let mut pt = tcx.nt - 1;
        tcx.prefix_start = tcx.complete_cur;
        tcx.prefix_end = tcx.complete_cur;
        if pt >= 0 && (tcx.tk[pt as usize]) == T_ID
            && (tcx.te[pt as usize]) >= tcx.complete_cur {
            tcx.prefix_start = (tcx.ts[pt as usize]);
            pt -= 1;
        }
        // (a word right after the cursor: the snippet leaves its `(` be)
        let mut after = tcx.complete_cur;
        while after < tcx.complete_text.len() as i64 && is_id(tcx.complete_text[after as usize]) {
            after += 1;
        }
        while after < tcx.complete_text.len() as i64
            && (tcx.complete_text[after as usize] == b' ') {
            after += 1;
        }
        tcx.call_follows = after < tcx.complete_text.len() as i64
            && tcx.complete_text[after as usize] == b'(';
        scan_bindings(tcx);
        scan_uses(tcx, pcx);
        if pt >= 0 && tok_is(pt, b".", tcx) && pt > 0 {
            // a member
            let s = expr_start(pt - 1, tcx);
            find_expected(s - 1, tcx, pcx);
            let r = if have_program { expr_type(s, pt - 1, 0, tcx, pcx) } else { no_type() };
            members(r, tcx, pcx);
        } else if pt >= 1 && tok_is(pt, b"::", tcx) && is_ident(pt - 1, tcx) {
            // a path's item
            let mut first = pt - 1;
            while first >= 2 && tok_is(first - 1, b"::", tcx) && is_ident(first - 2, tcx)
                && same_line(first - 1, first, tcx) {
                first -= 2;
            }
            if have_program {
                path_items(first, pt - 1, tcx, pcx);
            }
        } else if pt >= 0 && in_use_path(pt, tcx) >= 0 {
            // `use a::b::{c, |`: a's b's items
            let open = in_use_path(pt, tcx);
            if have_program {
                let mut first = open - 2;
                while first >= 2 && tok_is(first - 1, b"::", tcx) && is_ident(first - 2, tcx) {
                    first -= 2;
                }
                path_items(first, open - 2, tcx, pcx);
            }
        }
        else if pt >= 0
            && (tok_is(pt, b"fn", tcx) || tok_is(pt, b"struct", tcx) || tok_is(pt, b"enum", tcx)
                || tok_is(pt, b"trait", tcx) || tok_is(pt, b"mod", tcx) || tok_is(pt, b"let", tcx)
                || tok_is(pt, b"var", tcx) || tok_is(pt, b"type", tcx) || tok_is(pt, b"const", tcx)
                || tok_is(pt, b"static", tcx)) {
            // (a new name: nothing to complete)
        } else if pt >= 0 && tok_is(pt, b"use", tcx) {
            path_roots(tcx, pcx);
        } else {
            find_expected(pt, tcx, pcx);
            names(tcx, pcx);
        }
        buf_str(out, c"]}");
        if tcx.cut {
            // (`true,` in place of `false,`: one byte shorter, padded)
            let b = buf_slice(out);
            let q = b.ptr;
            (*q.add(mark as usize)) = b't';
            (*q.add((mark + 1) as usize)) = b'r';
            (*q.add((mark + 2) as usize)) = b'u';
            (*q.add((mark + 3) as usize)) = b'e';
            (*q.add((mark + 4) as usize)) = b' ';
        }
    }
}

// In `use a::b::{c, ` at token pt (a `{` or a `,` in it): the `{`'s
// index; -1 when pt is not in such braces.
fn in_use_path(pt: i64, tcx: &Tcx<Comp>) -> i64 {
    if !(tok_is(pt, b"{", tcx) || tok_is(pt, b",", tcx)) {
        return -1;
    }
    // back to the `{` (over names and commas)
    let mut i = pt;
    while i >= 0 && !tok_is(i, b"{", tcx) {
        if !(is_ident(i, tcx) || tok_is(i, b",", tcx) || tok_is(i, b"::", tcx)
            || tok_is(i, b"as", tcx)) {
            return -1;
        }
        i -= 1;
    }
    if i < 2 || !tok_is(i - 1, b"::", tcx) {
        return -1;
    }
    // the path before it, back to `use`
    let mut j = i - 2;
    while j >= 0 && (is_ident(j, tcx) && !tok_is(j, b"use", tcx) || tok_is(j, b"::", tcx)) {
        j -= 1;
    }
    if j < 0 || !tok_is(j, b"use", tcx) {
        return -1;
    }
    i
}

// The definition whose path is `path` (an item's data), or -1.
pub fn def_by_path(path: &[u8], tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    index_defs(tcx, pcx);
    let sym = find_sym(path, pcx);
    if sym < 0 { -1 } else { tcx.def_by_fqn.get(sym + 1) - 1 }
}

// completionItem/resolve: item (its JSON) with its definition's hover as
// its documentation, into out; doc: answer.vl's hover_def of it.
pub fn put_resolved(out: i64, item: &[u8], d: i64, doc: &[u8]) {
    let mut end = item.len() as i64;
    while end > 0 && item[(end - 1) as usize] != b'}' {
        end -= 1;
    }
    if d < 0 || end == 0 || doc.len() == 0 {
        buf_bytes(out, item);
        return;
    }
    buf_bytes(out, &item[0..(end - 1) as usize]);
    buf_str(out, c",\"documentation\":{\"kind\":\"markdown\",\"value\":");
    buf_json_str(out, doc);
    buf_str(out, c"}}");
}

// ---- signature help

// The function definition a call's callee of tokens ..=e names: `f`,
// `a::f`, `x.m` (x's method), or -1.
fn callee_def(e: i64, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if !is_ident(e, tcx) {
        return -1;
    }
    if e >= 2 && tok_is(e - 1, b".", tcx) {
        let s = expr_start(e - 2, tcx);
        let r = expr_type(s, e - 2, 0, tcx, pcx);
        let name = tok_text(e, tcx);
        let t = deref(r.t, pcx);
        let sym = find_sym(name, pcx);
        if t > 0 && sym >= 0 {
            let mut f = method_of(t, sym, pcx);
            if f < 0 && pcx.str_type > 0 && is_named(t, b"String", tcx, pcx) {
                f = method_of(pcx.str_type, sym, pcx);
            }
            if f >= 0 {
                let d = def_of_node(pcx.fns[f as usize].node, tcx, pcx);
                if d >= 0 {
                    return d;
                }
            }
        }
        return member_fn(r, name, tcx, pcx);
    }
    let mut s = e;
    while s >= 2 && tok_is(s - 1, b"::", tcx) && is_ident(s - 2, tcx) {
        s -= 2;
    }
    path_def(s, e, tcx, pcx)
}

// textDocument/signatureHelp (0.25.1): the signature of the call the
// cursor is in the arguments of, its parameters (their conventions as
// written: `x: sink T`, `v: inout Vec<i64>`) and the one being typed,
// into out (`null`: none).
pub fn put_signature_help(out: i64, f: i64, text: &[u8], line: i64, ch: i64, utf8: bool,
    have_program: bool, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>) {
    read_text(f, text, line, ch, utf8, have_program, tcx, pcx);
    if tcx.in_text || !have_program {
        buf_str(out, c"null");
        return;
    }
    scan_bindings(tcx);
    scan_uses(tcx, pcx);
    // the `(` the cursor is in, and the commas before it
    let mut depth: i64 = 0;
    let mut commas: i64 = 0;
    let mut i = tcx.nt - 1;
    while i >= 0 {
        let t = tok_text(i, tcx);
        if (tcx.tk[i as usize]) == T_P && (t == b")" || t == b"]" || t == b"}") {
            depth += 1;
        }
        else if (tcx.tk[i as usize]) == T_P && (t == b"(" || t == b"[" || t == b"{") {
            if depth == 0 {
                break;
            }
            depth -= 1;
        } else if depth == 0 && (tcx.tk[i as usize]) == T_P && t == b"," {
            commas += 1;
        } else if depth == 0 && (tcx.tk[i as usize]) == T_P && t == b";" {
            i = -1;
            break;
        }
        i -= 1;
    }
    if i < 1 || !tok_is(i, b"(", tcx) {
        buf_str(out, c"null");
        return;
    }
    let d = callee_def(i - 1, tcx, pcx);
    if d < 0 || !is_fn_def(d, pcx) {
        buf_str(out, c"null");
        return;
    }
    let sig = signature(d, tcx, pcx);
    // the parameters: in the signature after its name's `(`
    let own = sym_text(pcx.defs[d as usize].name, pcx);
    let mut a: i64 = 0;
    while a + own.len() as i64 <= sig.len() as i64
        && sig[a as usize..(a + own.len() as i64) as usize] != own {
        a += 1;
    }
    a += own.len() as i64;
    let mut nest: i64 = 0;
    while a < sig.len() as i64 && !(sig[a as usize] == b'(' && nest == 0) {
        if sig[a as usize] == b'<' {
            nest += 1;
        } else if sig[a as usize] == b'>' {
            nest -= 1;
        }
        a += 1;
    }
    buf_str(out, c"{\"signatures\":[{\"label\":");
    buf_json_str(out, sig);
    buf_str(out, c",\"parameters\":[");
    let mut k: i64 = 0;
    let mut p = a + 1;
    // (a method called as `x.m(..)`: its self is not an argument)
    let mut self_param = !(i >= 3 && tok_is(i - 2, b".", tcx));
    while p < sig.len() as i64 && sig[p as usize] != b')' {
        while p < sig.len() as i64 && sig[p as usize] == b' ' {
            p += 1;
        }
        let mut e = p;
        let mut n: i64 = 0;
        while e < sig.len() as i64 {
            let c = sig[e as usize];
            if c == b'(' || c == b'['
                || c == b'<' && !(e > 0 && sig[(e - 1) as usize] == b'-') {
                n += 1;
            } else if c == b')' || c == b']' || c == b'>' && sig[(e - 1) as usize] != b'-' {
                if n == 0 {
                    break;
                }
                n -= 1;
            } else if c == b',' && n == 0 {
                break;
            }
            e += 1;
        }
        let param = &sig[p as usize..e as usize];
        let is_self = param == b"self"
            || param.len() > 5 && param[(param.len() as i64 - 5) as usize..] == b" self"
            || param.len() > 5 && param[0..5] == b"self:";
        if is_self && k == 0 && !self_param {
            self_param = true;
        } else {
            if k > 0 {
                buf_byte(out, b',');
            }
            buf_fmt(out,
                format_args("{{\"label\":[{},{}]}}", utf16_len(&sig[0..p as usize]),
                    utf16_len(&sig[0..e as usize])));
            k += 1;
        }
        p = if e < sig.len() as i64 && sig[e as usize] == b',' { e + 1 } else { e };
    }
    buf_str(out, c"]");
    let doc = buf_new();
    crate::tools::lsp::answer::put_doc(doc, d, pcx);
    let ds = buf_slice(doc);
    if ds.len() > 0 {
        buf_str(out, c",\"documentation\":{\"kind\":\"markdown\",\"value\":");
        buf_json_str(out, &ds[1..ds.len()]);
        buf_byte(out, b'}');
    }
    buf_fmt(out, format_args("}}],\"activeSignature\":0,\"activeParameter\":{commas}}}"));
}

// The length of s in UTF-16 units (a signature's offsets, as LSP has
// them).
fn utf16_len(s: &[u8]) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let c = s[i as usize];
        let l: i64 = if c < 128 as u8 { 1 } else if c < 224 as u8 { 2 } else if c < 240 as u8 { 3 }
            else { 4 };
        n += if l == 4 { 2 } else { 1 };
        i += l;
    }
    n
}
