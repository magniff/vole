// The terminal (0.25.3): what a build and `check` show a person at a
// terminal, and only there. Colour (`--color=auto|always|never`, and
// NO_COLOR, which only `--color=always` overrides); the phases as they
// go (`Checking main.vl ... ok`, `Compiling`, `Linking`) and a
// `Finished` or `Failed` summary; each diagnostic with its source line
// and a caret under its position (rich_diagnostic).
//
// Off a terminal (an agent, a hook, a pipe, a test) RICH is false and the
// output is what it was, byte for byte; so is it with `--color=never`, and
// in a volec another one runs (VOLEC_NESTED). `--color=always` gives the
// terminal's form anywhere: its tests (tests/refactor/tty253.t) use it.

use crate::base::{
    SRC, STDERR, SourceFile, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str,
    buf_write_fd, cstr,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, errors_in, file_line_col, put_short_positions};
use crate::base::json::DIAG_JSON;
use crate::tools::lsp::now_us;

// UNSAFE: whether stderr is a terminal is C's question (POSIX isatty); std
// has no function that asks it.
// SAFETY: isatty reads nothing but its int argument; any fd is valid (one
// that is not open gives 0, with errno set).
extern "C" {
    fn isatty(fd: i32) -> i32;
}

pub const COLOR_AUTO: i64 = 0;
pub const COLOR_ALWAYS: i64 = 1;
pub const COLOR_NEVER: i64 = 2;

// The width of a status line's verb, right-aligned (`    Checking`).
const VERB_WIDTH: i64 = 12;
// The files a summary lists by name, the ones with errors aside.
const FILES_LISTED: i64 = 10;

// `--color=WHEN`, word w of the command line: its mode, -1 when w is no
// --color option, -2 when WHEN is none of auto, always and never.
pub fn color_mode_of(w: [u8]) -> i64 {
    if w == "--color=auto" {
        return COLOR_AUTO;
    }
    if w == "--color=always" {
        return COLOR_ALWAYS;
    }
    if w == "--color=never" {
        return COLOR_NEVER;
    }
    if w.len >= 8 && w[0..8] == "--color=" { -2 } else { -1 }
}

// Whether stderr is a terminal.
pub fn stderr_is_terminal() -> bool {
    // UNSAFE: a C call (isatty: no std function asks it).
    // SAFETY: STDERR is a plain int; isatty reads nothing else.
    unsafe { isatty(STDERR) != 0 }
}

// Decides the form of stderr, once, at the start (main), after --json and
// --color are read; `no_color`: NO_COLOR is set, and not empty.
pub fn term_setup(mode: i64, no_color: bool, pcx: inout Ctx<Comp>) {
    pcx.started_us = now_us(&pcx);
    if DIAG_JSON || mode == COLOR_NEVER || (pcx.nested && mode != COLOR_ALWAYS) {
        return;
    }
    pcx.rich = mode == COLOR_ALWAYS || stderr_is_terminal();
    pcx.color = pcx.rich && (mode == COLOR_ALWAYS || !no_color);
}

// Starts style sgr (an SGR code: "1;31" is bold red), when coloured.
fn style(out: i64, sgr: *u8, pcx: Ctx<Comp>) {
    if pcx.color {
        buf_byte(out, 27);
        buf_byte(out, '[');
        buf_str(out, sgr);
        buf_byte(out, 'm');
    }
}

// Ends a style.
fn plain(out: i64, pcx: Ctx<Comp>) {
    if pcx.color {
        buf_byte(out, 27);
        buf_str(out, c"[0m");
    }
}

// `text` in style sgr, when coloured.
pub fn paint(out: i64, sgr: *u8, text: [u8], pcx: Ctx<Comp>) {
    style(out, sgr, pcx);
    buf_bytes(out, text);
    plain(out, pcx);
}

// ---- Diagnostics ----

// The byte that ends the line at i of text (its '\n', or text's end).
fn line_end(text: [u8], i: i64) -> i64 {
    var e = i;
    while e < text.len as i64 && text[e] != '\n' {
        e += 1;
    }
    e
}

// Whether s starts with prefix.
fn starts(s: [u8], prefix: [u8]) -> bool {
    s.len >= prefix.len && s[0..prefix.len] == prefix
}

// A byte of a name (the caret spans a name's bytes).
fn name_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn digits(n: i64) -> i64 {
    var d = 1;
    var x = n;
    while x >= 10 {
        x = x / 10;
        d += 1;
    }
    d
}

fn spaces(out: i64, n: i64) {
    for _ in 0..n {
        buf_byte(out, ' ');
    }
}

// Source file f of the program (0 <= f < FILE_COUNT).
pub fn file_info(f: i64, pcx: Ctx<Comp>) -> SourceFile {
    if f < 0 || f >= pcx.files.len() as i64 {
        panic("base::term::file_info: no such file");
    }
    pcx.files[f]
}

// The program's source text: every file, as base::SRC holds it.
fn source(pcx: Ctx<Comp>) -> [u8] {
    if pcx.files.len() == 0 {
        return "";
    }
    SRC[0..pcx.src_len]
}

// The file of position pos (an index in FILES).
fn file_of(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var f = 0;
    while f + 1 < pcx.files.len() as i64 && pos >= file_info(f + 1, pcx).start {
        f += 1;
    }
    f
}

// The head `error[kind]: message`: the severity and kind in its colour,
// the message bold.
fn put_head(out: i64, head: [u8], tone: *u8, pcx: Ctx<Comp>) {
    var k = 0;
    while k + 1 < head.len as i64 && !(head[k] == ':' && head[k + 1] == ' ') {
        k += 1;
    }
    if k + 1 >= head.len as i64 || head[0] == ' ' {
        buf_bytes(out, head);
        return;
    }
    paint(out, tone, head[0..k], pcx);
    paint(out, c"1", head[k..], pcx);
}

// The source line of pos under its position, with a caret under what is
// at pos (a name, a string, else one character); `pad`: the gutter's
// width.
fn put_snippet(out: i64, pos: i64, line: i64, pad: i64, tone: *u8, pcx: Ctx<Comp>) {
    let src = source(pcx);
    let file = file_info(file_of(pos, pcx), pcx);
    let last = if file.end < src.len as i64 { file.end } else { src.len as i64 };
    if pos > last {
        return;
    }
    var ls = pos;
    while ls > file.start && src[ls - 1] != '\n' {
        ls -= 1;
    }
    var le = pos;
    while le < last && src[le] != '\n' {
        le += 1;
    }
    spaces(out, pad + 1);
    paint(out, c"1;34", "|", pcx);
    buf_byte(out, '\n');
    style(out, c"1;34", pcx);
    buf_fmt(out, format_args("{line} |"));
    plain(out, pcx);
    if le > ls {
        buf_byte(out, ' ');
    }
    for i in ls..le {
        if src[i] == '\t' {
            spaces(out, 4);
        } else {
            buf_byte(out, src[i]);
        }
    }
    buf_byte(out, '\n');
    spaces(out, pad + 1);
    paint(out, c"1;34", "|", pcx);
    buf_byte(out, ' ');
    // the caret's column: a tab is 4, a UTF-8 character one
    for i in ls..pos {
        if src[i] == '\t' {
            spaces(out, 4);
        } else if (src[i] & 192) != 128 {
            buf_byte(out, ' ');
        }
    }
    var n = 1;
    if pos < le && name_byte(src[pos]) {
        var e = pos;
        while e < le && name_byte(src[e]) {
            e += 1;
        }
        n = e - pos;
    } else if pos < le && src[pos] == '"' {
        var e = pos + 1;
        while e < le && src[e] != '"' {
            e += if src[e] == '\\' { 2 } else { 1 };
        }
        n = if e < le { e + 1 - pos } else { 1 };
    }
    style(out, tone, pcx);
    for _ in 0..n {
        buf_byte(out, '^');
    }
    plain(out, pcx);
    buf_byte(out, '\n');
}

// Diagnostic `text`, in the human form (`error[kind]: message`, ` -->
// FILE: line L, column C`, `  = help: ...`, `  = try: ...`, notes), at
// pos (-1: none), in the terminal's form: the head coloured, the position
// as FILE:L:C, the source line with a caret under pos (when the position
// is pos's: a C header's is not), then the `= help:` and `= try:` lines
// marked.
pub fn rich_diagnostic(out: i64, pos: i64, text: [u8], pcx: inout Ctx<Comp>) {
    let head_end = line_end(text, 0);
    let head = text[0..head_end];
    let tone = if starts(head, "warning") { c"1;33" } else { c"1;31" };
    put_head(out, head, tone, pcx);
    buf_byte(out, '\n');
    var i = head_end + 1;
    var pad = 1;
    if i < text.len as i64 && starts(text[i..], " --> ") {
        let e = line_end(text, i);
        let at = text[i + 5..e];
        var line = 0;
        if pos >= 0 && pos <= pcx.src_len && pcx.files.len() > 0 {
            let b = buf_new();
            buf_position(b, pos, &pcx);
            if buf_slice(b) == at {
                var col = 1;
                line = file_line_col(file_of(pos, pcx), pos, &col, &pcx);
                pad = digits(line);
            }
        }
        spaces(out, pad);
        paint(out, c"1;34", "-->", pcx);
        buf_byte(out, ' ');
        put_short_positions(out, at);
        buf_byte(out, '\n');
        if line > 0 {
            put_snippet(out, pos, line, pad, tone, pcx);
        }
        i = e + 1;
    }
    while i < text.len as i64 {
        let e = line_end(text, i);
        let l = text[i..e];
        if starts(l, "  = ") {
            // `  = help: X`, `  = try: X`, `  = note: X`
            var k = 4;
            while k < l.len as i64 && l[k] != ':' {
                k += 1;
            }
            spaces(out, pad + 1);
            buf_str(out, c"= ");
            let word = l[4..k];
            if word == "try" {
                paint(out, c"1;32", "try:", pcx);
                let rest = if k + 1 < l.len as i64 { l[k + 1..] } else { "" };
                paint(out, c"1", rest, pcx);
            } else {
                paint(out, c"1", word, pcx);
                buf_bytes(out, l[k..]);
            }
        } else {
            buf_bytes(out, l);
        }
        buf_byte(out, '\n');
        i = e + 1;
    }
}

// ---- Progress and summary ----

// A status line on stderr, now: the verb right-aligned in its colour,
// then `what`.
fn status(verb: [u8], tone: *u8, what: [u8], pcx: Ctx<Comp>) {
    let out = buf_new();
    spaces(out, VERB_WIDTH - verb.len as i64);
    paint(out, tone, verb, pcx);
    buf_byte(out, ' ');
    buf_bytes(out, what);
    buf_byte(out, '\n');
    buf_write_fd(out, STDERR);
}

// A path as positions print it (without `./`).
fn shown_path(p: *u8) -> [u8] {
    let s = cstr(p);
    if s.len > 2 && s[0] == '.' && s[1] == '/' { s[2..s.len] } else { s }
}

// Output p as the build's lines show it.
fn out_shown(p: *u8, pcx: Ctx<Comp>) -> [u8] {
    if pcx.shown_as != 0 as *u8 { cstr(pcx.shown_as) } else { shown_path(p) }
}

// (0.25.4) `volec run`, on a terminal: its program was up to date
// (`Finished prog in 0.01s`, as a build ends), then it runs (`Running
// prog`).
pub fn run_status(fresh: bool, name: [u8], pcx: inout Ctx<Comp>) {
    if !pcx.rich {
        return;
    }
    if fresh {
        let w = buf_new();
        buf_bytes(w, name);
        put_time(w, &pcx);
        status("Finished", c"1;32", buf_slice(w), pcx);
    }
    status("Running", c"1;32", name, pcx);
}

// `N error(s)`.
fn put_errors(out: i64, n: i64) {
    buf_fmt(out, format_args("{n} error{}", if n == 1 { "" } else { "s" }));
}

// `Checking FILE ... ok` (or `... N errors`) for each of the program's
// own files (not std's, not C headers'): the first FILES_LISTED, and every
// one with errors; then one line for the rest.
fn checked_files(pcx: Ctx<Comp>) {
    var listed = 0;
    var rest = 0;
    for f in 0..pcx.files.len() as i64 {
        let file = file_info(f, pcx);
        let path = shown_path(file.path);
        if path.len == 0 || path[0] == '<' {
            continue;
        }
        let to = if f + 1 < pcx.files.len() as i64 { file_info(f + 1, pcx).start }
            else { pcx.src_len + 1 };
        let n = errors_in(file.start, to, pcx);
        if listed >= FILES_LISTED && n == 0 {
            rest += 1;
            continue;
        }
        listed += 1;
        let w = buf_new();
        buf_bytes(w, path);
        buf_str(w, c" ... ");
        if n == 0 {
            paint(w, c"32", "ok", pcx);
        } else {
            let e = buf_new();
            put_errors(e, n);
            paint(w, c"31", buf_slice(e), pcx);
        }
        status("Checking", c"1;32", buf_slice(w), pcx);
    }
    if rest > 0 {
        let w = buf_new();
        buf_fmt(w, format_args("{rest} more file{} ... ", if rest == 1 { "" } else { "s" }));
        paint(w, c"32", "ok", pcx);
        status("Checking", c"1;32", buf_slice(w), pcx);
    }
}

// ` in 0.42s`
fn put_time(out: i64, pcx: inout Ctx<Comp>) {
    let us = now_us(&pcx) - pcx.started_us;
    let cs = (us + 5000) / 10000;
    buf_fmt(out,
        format_args(" in {}.{}{}s", cs / 100, if cs % 100 < 10 { "0" } else { "" }, cs % 100));
}

// `, N warning(s)`, when there were some.
fn put_warnings(out: i64, warnings: i64) {
    if warnings > 0 {
        buf_fmt(out, format_args(", {warnings} warning{}", if warnings == 1 { "" } else { "s" }));
    }
}

// A build starts (main): it makes `out`; `compiling` (a buffer) is its
// Compiling line. Its phases are shown on a terminal.
pub fn term_build(out: *u8, compiling: i64, pcx: inout Ctx<Comp>) {
    pcx.building = pcx.rich;
    pcx.build_out = out;
    pcx.build_compiling = compiling;
}

// The build's front end found no error (gen0::gen::compile_program).
pub fn build_checked(pcx: Ctx<Comp>) {
    if pcx.building {
        checked_files(pcx);
    }
}

// The build's code generation starts.
pub fn build_compiling(pcx: Ctx<Comp>) {
    if pcx.building && pcx.build_compiling >= 0 {
        status("Compiling", c"1;32", buf_slice(pcx.build_compiling), pcx);
    }
}

// The build's link starts.
pub fn build_linking(path: *u8, pcx: Ctx<Comp>) {
    if pcx.building {
        status("Linking", c"1;32", out_shown(path, pcx), pcx);
    }
}

// The build is done (main): `Finished OUT in 0.42s`.
pub fn build_finished(warnings: i64, pcx: inout Ctx<Comp>) {
    if !pcx.building {
        return;
    }
    pcx.building = false;
    let w = buf_new();
    buf_bytes(w, out_shown(pcx.build_out, pcx));
    put_time(w, &pcx);
    put_warnings(w, warnings);
    status("Finished", c"1;32", buf_slice(w), pcx);
}

// The build's front end failed (diag::exit_if_errors, after the errors):
// each file's count, then `Failed OUT: N errors`.
pub fn build_failed_errors(errors: i64, pcx: inout Ctx<Comp>) {
    if !pcx.building {
        return;
    }
    pcx.building = false;
    checked_files(pcx);
    let w = buf_new();
    buf_bytes(w, out_shown(pcx.build_out, pcx));
    buf_str(w, c": ");
    put_errors(w, errors);
    put_time(w, &pcx);
    status("Failed", c"1;31", buf_slice(w), pcx);
}

// The build failed after its front end (die, a link that failed):
// `Failed OUT`.
pub fn build_failed(pcx: inout Ctx<Comp>) {
    if !pcx.building {
        return;
    }
    pcx.building = false;
    let w = buf_new();
    buf_bytes(w, out_shown(pcx.build_out, pcx));
    put_time(w, &pcx);
    status("Failed", c"1;31", buf_slice(w), pcx);
}

// `check`'s summary on a terminal: each file's count, then `Finished
// ROOT: 0 errors` or `Failed ROOT: N errors`.
pub fn check_summary(root: *u8, errors: i64, warnings: i64, pcx: inout Ctx<Comp>) {
    if !pcx.rich {
        return;
    }
    checked_files(pcx);
    let w = buf_new();
    buf_bytes(w, shown_path(root));
    buf_str(w, c": ");
    put_errors(w, errors);
    put_warnings(w, warnings);
    put_time(w, &pcx);
    if errors > 0 {
        status("Failed", c"1;31", buf_slice(w), pcx);
    } else {
        status("Finished", c"1;32", buf_slice(w), pcx);
    }
}
