// The compilation's allocator (0.18 T6; docs/design/contracts-verification.md
// §4.1). Comp holds what lives until the compilation ends (types,
// symbols, file texts, positions, tokens, nodes): `static mut X: Vec<T,
// Comp>` replaces the compiler's raw tables. It is zero-sized, so `Comp
// {}` is a constant a static can hold. (0.26.3: Ast, a second one for the
// tokens and nodes, was never used and is gone.)
//
// (0.26.3) Comp is the one allocator built from nothing. (0.26.4) Its
// impl is `unsafe impl`, as every allocator's. (0.26.5) The tables that
// hold it are fields of the compilation context (base::ctx::Ctx) but for
// base::SYMS and front::types::TYPES, the two statics the exemption of
// front/check/alloc_rules.vl still names (until 0.27).
//
// Phase 0: it takes its memory from C's allocator, block by block; T6
// makes it an arena (and its `free` a no-op, so values in it skip
// destruction).

use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; use crate::base::{free, malloc, realloc};

#[derive(Clone, Copy)] pub struct Comp {}

// size bytes from C's allocator (16-aligned), or null; a larger alignment
// is not served in phase 0.
fn c_alloc(size: i64, align: i64) -> *mut u8 {
    if align > 16 || size < 0 {
        return 0 as *mut u8;
    }
    // UNSAFE: malloc is C's
    // SAFETY: malloc takes any size (at least 1 here) and returns null
    // or a block of its own of that many bytes, 16-aligned; the caller
    // checks for null (NonNull::new)
    unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
}

// Block p (one c_alloc or c_resize gave) made new_size bytes, or null
// (p is then as it was).
fn c_resize(p: *mut u8, new_size: i64, align: i64) -> *mut u8 {
    if align > 16 || new_size < 0 {
        return 0 as *mut u8;
    }
    // UNSAFE: realloc is C's
    // SAFETY: p is a block malloc or realloc made and nothing has freed:
    // the only caller is Comp's grow, whose contract (Allocator's) is
    // that p came from this allocator with the old layout; realloc
    // keeps the bytes up to the smaller size and returns null (p kept)
    // or the block, 16-aligned, which the caller checks
    unsafe { realloc(p, if new_size == 0 { 1 } else { new_size } as u64) }
}

// UNSAFE: Comp is an allocator built from nothing (the compilation's, over
// C's malloc), so its impl of the unsafe trait Allocator is `unsafe impl`.
// SAFETY: its memory is C's: try_alloc and try_resize give a block of at
// least size bytes, 16-aligned (malloc's and realloc's alignment), or null
// for a larger alignment or a negative size; free and try_resize take only
// a block they gave (Allocator's contract), which malloc and realloc made.
unsafe impl Allocator for Comp {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64;
        let align = __layout.align() as i64;
        NonNull::new({
            c_alloc(size, align)
        }).ok_or(AllocError) }

    // UNSAFE: grow is an unsafe fn of the unsafe trait Allocator
    // SAFETY: its caller keeps Allocator's contract: __p is a block this
    // allocator gave with layout __old, so it is malloc's or realloc's
    // and c_resize may pass it to realloc
    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr();
        let old_size = __old.size() as i64;
        let new_size = __new.size() as i64;
        let align = __new.align() as i64;
        NonNull::new({
            c_resize(p, new_size, align)
        }).ok_or(AllocError) }

    // UNSAFE: shrink is an unsafe fn of the unsafe trait Allocator
    // SAFETY: its caller keeps Allocator's contract for p, old and new
    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        // UNSAFE: grow is an unsafe fn of Allocator
        // SAFETY: the caller of shrink keeps the same contract, and
        // realloc makes a block smaller as it makes one larger
        unsafe { self.grow(p, old, new) }
    }

    // UNSAFE: deallocate is an unsafe fn of Allocator, and free is C's
    // SAFETY: its caller keeps Allocator's contract: __p is a block this
    // allocator gave and has not freed, so it is malloc's or realloc's
    // and is freed here once
    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr();
        let size = __layout.size() as i64;
        let align = __layout.align() as i64;
        free(p);
    }
}
