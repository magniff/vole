// The compilation's allocator (0.18 T6; docs/design/contracts-verification.md
// §4.1). Comp holds what lives until the compilation ends (types,
// symbols, file texts, positions, tokens, nodes): `static mut X: Vec<T,
// Comp>` replaces the compiler's raw tables. It is zero-sized, so `Comp
// {}` is a constant a static can hold. (0.26.3: Ast, a second one for the
// tokens and nodes, was never used and is gone.)
//
// (0.26.3) Comp is the one allocator built from nothing. (0.26.4) Its
// impl is `unsafe impl`, as every allocator's. (0.26.5) The tables that
// hold it are fields of the compilation context (base::ctx::Ctx) but for
// base::SYMS and front::types::TYPES, the two statics the exemption of
// front/check/alloc_rules.vl still names (until 0.27).
//
// Phase 0: it takes its memory from C's allocator, block by block; T6
// makes it an arena (and its `free` a no-op, so values in it skip
// destruction).

use crate::base::{free, malloc, realloc};

pub struct Comp {}

// size bytes from C's allocator (16-aligned), or null; a larger alignment
// is not served in phase 0.
fn c_alloc(size: i64, align: i64) -> *u8 {
    if align > 16 || size < 0 {
        return 0 as *u8;
    }
    unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
}

fn c_resize(p: *u8, new_size: i64, align: i64) -> *u8 {
    if align > 16 || new_size < 0 {
        return 0 as *u8;
    }
    unsafe { realloc(p, if new_size == 0 { 1 } else { new_size } as u64) }
}

// UNSAFE: Comp is an allocator built from nothing (the compilation's, over
// C's malloc), so its impl of the unsafe trait Allocator is `unsafe impl`.
// SAFETY: its memory is C's: try_alloc and try_resize give a block of at
// least size bytes, 16-aligned (malloc's and realloc's alignment), or null
// for a larger alignment or a negative size; free and try_resize take only
// a block they gave (Allocator's contract), which malloc and realloc made.
unsafe impl Allocator for Comp {
    fn try_alloc(self: *Comp, size: i64, align: i64) -> *u8 {
        c_alloc(size, align)
    }

    unsafe fn try_resize(self: *Comp, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        c_resize(p, new_size, align)
    }

    unsafe fn free(self: *Comp, p: *u8, size: i64, align: i64) {
        free(p);
    }
}
