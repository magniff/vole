// (0.28.0) CWD's accessors: every use of it is one of them.
fn get_cwd() -> *mut u8 {
    // UNSAFE: the working directory cache, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: a thread other than main reaches its only writer/reader
    // normal_path only through out_path <- back::dwarf::dbg_loc, which a
    // task reaches only under -g (dbg_function_begin and emit_loc are gated
    // by debug_info), and -g makes the compile serial
    // (parallel::serial_only: one thread, no assembler thread); the join
    // and the assembler thread do not reach it
    unsafe { CWD }
}

fn set_cwd(v: *mut u8) {
    // UNSAFE: the working directory cache, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: a thread other than main reaches its only writer/reader
    // normal_path only through out_path <- back::dwarf::dbg_loc, which a
    // task reaches only under -g (dbg_function_begin and emit_loc are gated
    // by debug_info), and -g makes the compile serial
    // (parallel::serial_only: one thread, no assembler thread); the join
    // and the assembler thread do not reach it
    unsafe {
        CWD = v;
    }
}
