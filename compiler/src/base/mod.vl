// The module base: the C library, growable arrays, byte buffers, the
// symbol interner and source files; error reporting (and recovery) is in
// diag.vl, the phase timer in timer.vl. The compiler's root is
// main.vl.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

pub mod timer;
pub mod diag;
// (0.25.3) colour, progress and the summary on a terminal
pub mod term;
pub mod target;
pub mod json;
// (0.18) the compilation's allocators, Comp and Ast (T6)
pub mod comp;
pub mod ctx;

// ---- C library ----

// UNSAFE: the C library's functions the compiler calls: the allocator
// under every raw array, the copies and comparisons of raw blocks,
// stdio and write for the files it reads and makes, the jumps of the
// error recovery, the environment and paths.
// SAFETY: each is declared as <stdlib.h>, <string.h>, <stdio.h>,
// <unistd.h> and <setjmp.h> declare it on macOS and Linux (64-bit:
// size_t is u64, int is i32, every pointer `*mut u8`; `-> !` on exit and
// _longjmp, which do not return). What a call needs (a NUL-terminated
// string, a block of the size given, a stream fopen returned) is the
// calling block's to say.
pub extern "C" {
    // Error recovery (see err_end): the jumps back to a recovery point.
    fn _setjmp(env: *mut u8) -> i32;
    fn _longjmp(env: *mut u8, value: i32) -> !;
    fn malloc(size: u64) -> *mut u8;
    fn realloc(ptr: *mut u8, size: u64) -> *mut u8;
    fn free(ptr: *mut u8);
    fn memcpy(dst: *mut u8, src: *mut u8, n: u64) -> *mut u8;
    fn memset(dst: *mut u8, c: i32, n: u64) -> *mut u8;
    fn memcmp(a: *mut u8, b: *mut u8, n: u64) -> i32;
    fn strlen(s: *mut u8) -> u64;
    fn strtod(s: *mut u8, end: *mut *mut u8) -> f64;
    fn fopen(path: *mut u8, mode: *mut u8) -> *mut u8;
    fn fread(buf: *mut u8, size: u64, count: u64, file: *mut u8) -> u64;
    fn fwrite(buf: *mut u8, size: u64, count: u64, file: *mut u8) -> u64;
    fn fclose(file: *mut u8) -> i32;
    fn write(fd: i32, buf: *mut u8, n: u64) -> i64;
    fn exit(code: i32) -> !;
    fn getenv(name: *mut u8) -> *mut u8;
    fn realpath(path: *mut u8, resolved: *mut u8) -> *mut u8;
    fn getcwd(buf: *mut u8, size: u64) -> *mut u8;
}

pub const STDOUT: i32 = 1;
pub const STDERR: i32 = 2;

// ---- Growable arrays ----

// Makes room for one more element in an array of `count` elements of T
// with capacity `*cap`; returns the (possibly moved) data. The raw
// arrays' own growth (IntVec, the buffer table, the tables that are not
// Vecs yet): the caller holds data as its only pointer to the block.
pub fn grow<T>(data: *mut T, count: i64, cap: &mut i64) -> *mut T {
    if count < *cap {
        return data;
    }
    // UNSAFE: realloc is C's (the allocator under every raw array), and
    // moved_block's contract is the caller's
    // SAFETY: data is null with *cap 0, or a malloc'ed block of *cap
    // elements of T that only the caller points to (the contract of
    // every raw array here: its struct's data and cap fields are set
    // together, from this function's result); realloc and moved_block
    // are given that block and its true size in bytes, the result is
    // checked for null, and *cap is the new block's room
    unsafe {
        if stress_grow() {
            let old = *cap;
            *cap = stress_cap(old, count + 1);
            return moved_block(data as *mut u8, old * size_of(T), *cap * size_of(T)) as *mut T;
        }
        let mut new_cap = *cap * 2;
        if new_cap < 64 {
            new_cap = 64;
        }
        *cap = new_cap;
        let grown = realloc(data as *mut u8, (new_cap * size_of(T)) as u64);
        if grown == 0 as *mut u8 {
            die(c"out of memory");
        }
        grown as *mut T
    }
}

// (0.25) Room for at least `n` elements in one block, for a table whose
// size is known ahead (front::ast's nodes, from the tokens): the doubling
// that a large table crosses copies it, and the copy and the old block
// together raise the peak RSS. Capacity left unused is never touched, so it
// costs address space, not memory.
pub fn reserve<T>(data: *mut T, cap: &mut i64, n: i64) -> *mut T {
    if n <= *cap {
        return data;
    }
    // UNSAFE: realloc is C's, and moved_block's contract is the caller's
    // SAFETY: as grow's: data is null with *cap 0, or a malloc'ed block
    // of *cap elements of T that only the caller points to; realloc and
    // moved_block are given that block and its true size in bytes, the
    // result is checked for null, and *cap is the new block's room
    unsafe {
        if stress_grow() {
            let old = *cap;
            *cap = n;
            return moved_block(data as *mut u8, old * size_of(T), n * size_of(T)) as *mut T;
        }
        let grown = realloc(data as *mut u8, (n * size_of(T)) as u64);
        if grown == 0 as *mut u8 {
            die(c"out of memory");
        }
        *cap = n;
        grown as *mut T
    }
}

// The address of element i of the array of T at data. (0.17) Where T is a
// slice, a Vec or a Buf, `data[i]` indexes the one data points to, not the
// array: such arrays (STRS) are reached through this.
pub fn elem_at<T>(data: *mut T, i: i64) -> *mut T {
    // UNSAFE: pointer arithmetic on a raw array
    // SAFETY: the two callers (front::lexer's str_at and add_string)
    // pass STRS and an id below its room (an id add_string gave, or the
    // count after grow made room for it), so the address is inside the
    // array's block; it is not dereferenced here
    unsafe { ((data as *mut u8).add((i * size_of(T)) as usize)) as *mut T }
}

// The stress-grow mode (0.14), for finding reads through a table's old
// storage (an index whose evaluation grows the table it indexes): with
// VOLE_STRESS_GROW=1 in the environment, every growth of a table
// (`grow`, `buf_reserve`, the symbol tables) moves it, by half its size
// from a capacity of 1, and the old block is filled with 0xAA bytes and
// kept (never freed, never reused), so such a read finds garbage. The
// gate's stress-grow step runs the suite and a self-compile with it.
static STRESS_GROW: Atomic<i64> = Atomic::new(-1);

pub fn stress_grow() -> bool {
    if get_stress_grow() < 0 {
        set_stress_grow(if env_first_byte(c"VOLE_STRESS_GROW") == b'1' { 1 } else { 0 });
    }
    get_stress_grow() == 1
}

// ---- The environment (0.29) ----
//
// getenv returns a pointer into the environment, good until the next
// setenv: no safe function can give it a lifetime. These read it at
// once and give the value back by value (a byte, a number) or copied.

// The first byte of environment variable `name` (a C string), 0 when it
// is unset or empty. It allocates nothing: stress_grow asks before any
// table exists.
pub fn env_first_byte(name: *mut u8) -> u8 {
    // UNSAFE: getenv is C's, and its result a raw pointer
    // SAFETY: name is a NUL-terminated literal of the caller's; the
    // result is null or a NUL-terminated string, so its first byte can
    // be read, and it is read before anything could change the
    // environment (nothing is called between)
    unsafe {
        let value = getenv(name);
        if value == 0 as *mut u8 { 0 } else { *value }
    }
}

// Whether environment variable `name` (a C string) is set.
pub fn env_is_set(name: *mut u8) -> bool {
    // UNSAFE: getenv is C's
    // SAFETY: name is a NUL-terminated literal of the caller's; the
    // result is only compared with null
    unsafe { getenv(name) != 0 as *mut u8 }
}

// The value of environment variable `name` (a C string), copied: empty
// when it is unset (env_is_set tells the two apart).
pub fn env_var(name: *mut u8) -> Vec<u8, Comp> {
    // UNSAFE: getenv is C's, and its result is seen as a slice (c_bytes)
    // SAFETY: name is a NUL-terminated literal of the caller's; the
    // result is null (checked) or a NUL-terminated string that stays
    // until the environment changes, and bytes_vec copies it before
    // anything else runs: the view ends in this block
    unsafe {
        let value = getenv(name);
        if value == 0 as *mut u8 {
            return Vec::new_in(Comp {});
        }
        bytes_vec(c_bytes(value))
    }
}

// Environment variable `name` set to `value` (C strings), for this
// process and the ones it starts.
pub fn env_set(name: *mut u8, value: *mut u8) {
    // UNSAFE: setenv is C's
    // SAFETY: both are NUL-terminated strings of the caller's (literals,
    // or a buffer's block ended with a 0 and not written since); setenv
    // copies them. The compiler sets its environment at start, on the
    // main thread before any other exists
    unsafe { base_setenv(name, value, 1); }
}

// The capacity after `cap` under stress_grow: room for `needed`.
fn stress_cap(cap: i64, needed: i64) -> i64 {
    let mut new_cap = cap + cap / 2 + 1;
    while new_cap < needed {
        new_cap = new_cap + new_cap / 2 + 1;
    }
    new_cap
}

// A new block of new_size bytes holding the first old_size bytes of
// data, which is poisoned and kept (stress_grow).
// UNSAFE: malloc, memcpy and memset are C's, on raw blocks
// SAFETY: the caller's: data is a malloc'ed block of at least old_size
// bytes (or old_size is 0), and new_size >= old_size. Here: the new
// block is checked for null before the copy, which reads old_size
// bytes of data and writes them into the new_size >= old_size bytes of
// the new block; data is then filled, never freed, so a stale pointer
// into it reads 0xAA, not another block's bytes
unsafe fn moved_block(data: *mut u8, old_size: i64, new_size: i64) -> *mut u8 {
    let moved = malloc(new_size as u64);
    if moved == 0 as *mut u8 {
        die(c"out of memory");
    }
    if old_size > 0 {
        memcpy(moved, data, old_size as u64);
        memset(data, 0xAA, old_size as u64);
    }
    moved
}

// An array of `n` elements of T, zeroed.
pub fn alloc_array<T>(n: i64) -> *mut T {
    alloc_zeroed(n * size_of(T)) as *mut T
}

// (0.29) A scratch table of the context made n entries, all `value`,
// its room kept from call to call: what a pass does where it begins,
// in place of a new allocation per function. (The entries it has are
// filled in place and only the growth is pushed: `clear` and `resize`
// push every entry, about ten instructions each, which was 3% of GVN
// for its value table alone.)
pub fn table_reset<T: Copy>(table: &mut Vec<T, Comp>, n: usize, value: T) {
    if table.len() > n {
        table.truncate(n);
    }
    let kept = table.len();
    table[0..kept].fill(value);
    if kept < n {
        table.resize(n, value);
    }
}

// `table` made `n` entries of `init`: a table of a phase, sized once
// where the phase begins (what it held before is given up).
pub fn sized_table<T: Clone>(table: &mut Vec<T, Comp>, n: i64, init: T) {
    table.clear();
    table.resize(n as usize, init);
}

pub fn alloc_zeroed(size: i64) -> *mut u8 {
    let mut bytes = size;
    if bytes < 8 {
        bytes = 8;
    }
    // UNSAFE: malloc and memset are C's
    // SAFETY: the block is checked for null before memset fills exactly
    // the bytes that were asked of malloc; the result is a block of its
    // own, at least `size` zero bytes, aligned for any type
    unsafe {
        let data = malloc(bytes as u64);
        if data == 0 as *mut u8 {
            die(c"out of memory");
        }
        memset(data, 0, bytes as u64);
        data
    }
}

// A growable array of i64, used for node lists and scratch stacks.
#[derive(Clone, Copy)] pub struct IntVec { pub data: *mut i64, pub count: i64, pub cap: i64 }

// (0.29) `v[i]`: item i, checked against the count (not the room): a
// program error past the end, as Vec's. An IntVec is still a Copy header
// over its items; the header goes when its users hold a Vec.
impl std::ops::Index<usize> for IntVec {
    type Output = i64;

    #[inline]
    fn index(&self, i: usize) -> &i64 {
        if i >= self.count as usize {
            index_past_count();
        }
        // UNSAFE: the items are behind a raw pointer (IntVec is the
        // compiler's own growable array, older than std's Vec).
        // SAFETY: i < count (checked above; a negative index is a huge
        // usize), and data holds count items, each written by push before
        // it is counted; the reference lives no longer than the borrow of
        // the header it is read through.
        unsafe { &*self.data.add(i) }
    }
}

impl std::ops::IndexMut<usize> for IntVec {
    #[inline]
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        if i >= self.count as usize {
            index_past_count();
        }
        // UNSAFE: the items are behind a raw pointer, as index's.
        // SAFETY: i < count (checked above): an item push wrote, in the
        // allocation data points to, borrowed as long as the header is.
        unsafe { &mut *self.data.add(i) }
    }
}

// (not inlined: the checks' cold side is one call)
#[inline(never)]
fn index_past_count() -> ! {
    die(c"IntVec: index out of range")
}

// (0.29) What an empty IntVec's as_slice borrows (its data may be null).
static NO_ITEMS: [i64; 1] = [0];

// IntVec::items(): the vector, the next index, the end.
#[derive(Clone, Copy)] pub struct IntVecItems { v: *mut IntVec, i: i64, n: i64 }

impl IntVecItems {
    // (0.27.5) Item k of the vector, for fold: a function of its own, not
    // generic, so that its raw pointer's element has a type where the
    // rust edition's translation reads it (fold, generic, may have no
    // instance).
    #[inline]
    fn item(self, k: i64) -> i64 {
        // UNSAFE: IntVec's items are behind a raw pointer (the compiler's
        // own growable array, older than std's Vec).
        // SAFETY: fold passes i <= k < n, and items() makes n the vector's
        // count, each item written by push before it is counted.
        unsafe { (*self.v.data.add(k as usize)) }
    }
}

impl Iterator for IntVecItems {
    type Item = i64;

    #[inline]
    fn next(&mut self) -> Option<i64> {
        if self.i < self.n {
            // UNSAFE: the vector is behind a raw pointer, and its items
            // behind another (IntVec is the compiler's own growable
            // array, older than std's Vec)
            // SAFETY: items() and items_in() are given a vector that
            // stays where it is for the loop (their contract, above
            // items), so v is live; i < n, the vector's count when the
            // loop began or the caller's range inside it, and a push in
            // the body only adds items, so item i is still one push
            // wrote; data is read anew here, after any growth
            let x = unsafe { (*self.v.data.add(self.i as usize)) };
            self.i += 1;
            Option::Some(x)
        } else {
            Option::None
        }
    }

    #[inline]
    fn fold<B, F: FnMut(&B, i64) -> B>(&self, init: B, mut f: F) -> B {
        let mut g = f;
        let mut acc = init;
        for k in self.i..self.n {
            acc = g(&acc, self.item(k));
        }
        acc
    }
}

impl IntVec {
    // (0.17: with room, no call of grow)
    pub fn push(&mut self, value: i64) {
        let n = self.count;
        if n < self.cap {
            // UNSAFE: an item written through the vector's raw pointer
            // SAFETY: n = count < cap, and data is a block of cap items
            // (grow's result, kept with its cap): item n is inside it
            unsafe { (*self.data.add(n as usize)) = value; }
            self.count = n + 1;
            return;
        }
        // UNSAFE: an item written through the vector's raw pointer
        // SAFETY: grow returned a block of the new cap > n items holding
        // the first n (data and cap are set together, from its result),
        // so item n is inside it
        unsafe {
            self.data = grow(self.data, n, &mut self.cap);
            (*self.data.add(n as usize)) = value;
        }
        self.count = n + 1;
    }

    // The last item, removed: a program error on an empty vector (0.29:
    // it read the item below an empty one's first before).
    pub fn pop(&mut self) -> i64 {
        if self.count <= 0 {
            die(c"IntVec::pop: the vector is empty");
        }
        self.count -= 1;
        // UNSAFE: the items are behind a raw pointer (IntVec is the
        // compiler's own growable array, older than std's Vec).
        // SAFETY: count was at least 1 (checked above), so the new count
        // is the index of an item push wrote, in data's allocation.
        unsafe { (*self.data.add(self.count as usize)) }
    }

    // (0.29) No items; the room is kept.
    pub fn clear(&mut self) {
        self.count = 0;
    }

    // (0.29) The first n items are kept: a program error when n is past
    // the count (the items there were never written, or were given up).
    pub fn truncate(&mut self, n: i64) {
        if n < 0 || n > self.count {
            die(c"IntVec::truncate: past the count");
        }
        self.count = n;
    }

    // (0.29) How many items, as Vec's len.
    #[inline]
    pub fn len(&self) -> usize {
        self.count as usize
    }

    // (0.29) The items, as a slice borrowed from this header: for a
    // function that reads part of a list (`&v.as_slice()[from..to]`).
    pub fn as_slice(&self) -> &[i64] {
        if self.count <= 0 {
            return &NO_ITEMS[0..0];
        }
        // UNSAFE: the items are behind a raw pointer (IntVec is the
        // compiler's own growable array, older than std's Vec).
        // SAFETY: data holds count items (count > 0, so data is an
        // allocation), each written by push before it is counted; the
        // slice lives no longer than the borrow of the header.
        unsafe { std::slice::from_raw_parts(self.data, self.count as usize) }
    }

    // (0.25.2) Item i, checked: a program error past the end.
    pub fn get(self, i: i64) -> i64 {
        if i < 0 || i >= self.count {
            die(c"IntVec::get: index out of range");
        }
        // UNSAFE: the items are behind a raw pointer (IntVec is the
        // compiler's own growable array, older than std's Vec).
        // SAFETY: 0 <= i < count (checked above), and data holds count
        // items, each written by push before it is counted.
        unsafe { (*self.data.add(i as usize)) }
    }

    // (0.25.2) Item i := value, checked as get.
    pub fn set(&mut self, i: i64, value: i64) {
        if i < 0 || i >= self.count {
            die(c"IntVec::set: index out of range");
        }
        // UNSAFE: the items are behind a raw pointer, as get's.
        // SAFETY: 0 <= i < count (checked above): an item push wrote, in
        // the allocation data points to; nothing else holds a reference.
        unsafe { (*self.data.add(i as usize)) = value; }
    }

    // Its items, by value (0.15): `for x in v.items() { .. }` is exactly
    // `for i in 0..v.count { let x = v.data[i]; .. }`. The count is taken
    // when the loop starts and each item is read when it is reached, so a
    // push in the body (which may move the data) is seen as it is there.
    // The IntVec itself must not move meanwhile (an element of a growing
    // array of structs).
    #[inline]
    pub fn items(self: *mut IntVec) -> IntVecItems {
        // UNSAFE: the count read through the raw pointer to the vector
        // SAFETY: the caller's `v.items()` is of a live IntVec (a local,
        // a field, an element of a table that does not grow during the
        // loop: the contract above); only its count is read here
        unsafe { IntVecItems { v: self, i: 0, n: self.count } }
    }

    // Items from..to, likewise (`kids` of a node's list in LISTS).
    #[inline]
    pub fn items_in(self: *mut IntVec, from: i64, to: i64) -> IntVecItems {
        IntVecItems { v: self, i: from, n: to }
    }
}

// ---- Byte buffers ----

// Buffers are referred to by id; `BUFS[id]` holds the bytes.
//
// What every unsafe block below relies on (the buffers' invariants):
// (B1) BUFS points at a malloc'ed table of at least BUF_COUNT headers,
//      and ids 0..BUF_COUNT are the buffers made (buf_new); buf_hdr
//      checks an id against BUF_COUNT, so a header's address is in the
//      table. Buffers are never freed and ids never reused.
// (B2) A header's data is a malloc'ed block of cap bytes (-1 - cap when
//      frozen) whose first len bytes are initialized, 0 <= len <= cap:
//      every writer makes room (buf_reserve) and writes before it adds
//      to len.
// (B3) A growing buffer is one context's: only the thread that runs
//      with that context reads or writes its header and block (a task
//      its cx.asm, cx.code, cx.scratch_buf; the main thread the
//      program's). A frozen buffer is only read.
// (B4) The table moves only in buf_new, and while another thread runs
//      only the main thread calls buf_new, at a time when no other
//      thread is inside a buf_* function: at -O0 the assembler thread
//      never touches BUFS (its one path to it, dwarf_file, needs -g,
//      which starts no thread), and at -O1+ no worker calls buf_new
//      outside the serial-only modes, the joining main thread calls it
//      only via dwarf_file (-g), and between phases the hand-over under
//      the pool's mutex orders the main thread's buf_new before the
//      tasks' reads of the table (tests/threads_writes.sh keeps the
//      lists). So a header's address taken in a buf_* function stays
//      good until that function returns.
#[derive(Clone, Copy)] struct Buf { data: *mut u8, len: i64, cap: i64 }

// (0.29) Atomics, Relaxed (static muts before): the address of the
// table, the number of buffers and the table's room. The order between
// threads is B4's, not the atomics'.
static BUFS: Atomic<*mut Buf> = Atomic::new(0 as *mut Buf);
static BUF_COUNT: Atomic<i64> = Atomic::new(0);
static BUF_CAP: Atomic<i64> = Atomic::new(0);

// The header of buffer b, checked: an id that is no buffer's stops the
// compiler (-1, "no buffer", passed to a writer).
#[inline]
fn buf_hdr(b: i64) -> *mut Buf {
    if b as u64 >= BUF_COUNT.load(Ordering::Relaxed) as u64 {
        buf_bad_id();
    }
    // UNSAFE: the address of an entry of base's raw table of buffers
    // SAFETY: b < BUF_COUNT was checked (as u64: a negative id is out of
    // range too), and the table holds BUF_COUNT headers (B1), so the
    // address is inside its block; nothing is dereferenced here
    unsafe { BUFS.load(Ordering::Relaxed).add(b as usize) }
}

// An id that is no buffer's: an internal error, never an access.
fn buf_bad_id() -> ! {
    die(c"internal: a buffer id out of range")
}

pub fn buf_new() -> i64 {
    let id = BUF_COUNT.load(Ordering::Relaxed);
    let mut cap = BUF_CAP.load(Ordering::Relaxed);
    let table = grow(BUFS.load(Ordering::Relaxed), id, &mut cap);
    BUF_CAP.store(cap, Ordering::Relaxed);
    BUFS.store(table, Ordering::Relaxed);
    // UNSAFE: a header written into base's raw table of buffers
    // SAFETY: grow made room for entry `id` (id < cap) in the table it
    // returned; the entry is written whole before BUF_COUNT covers it,
    // and no other thread uses the table meanwhile (B4)
    unsafe {
        *table.add(id as usize) = Buf { data: alloc_zeroed(256), len: 0, cap: 256 };
    }
    BUF_COUNT.store(id + 1, Ordering::Relaxed);
    id
}

pub fn buf_reserve(b: i64, extra: i64) {
    let h = buf_hdr(b);
    // UNSAFE: b's header read and written through its address; realloc
    // is C's
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3). data is
    // a malloc'ed block of cap bytes holding len initialized ones (B2):
    // realloc (or moved_block, under stress) gives a block of new_cap >=
    // len + extra bytes with the same first len, and the header gets
    // both together; a frozen buffer stops before either
    unsafe {
        let needed = (*h).len + extra;
        if needed <= (*h).cap {
            return;
        }
        // (0.27.7: a frozen buffer, cap stored as -1 - cap, is never written
        // again; every writer comes here when it is: src-buffer.md)
        if (*h).cap < 0 {
            frozen_written(b);
        }
        if stress_grow() {
            let new_cap = stress_cap((*h).cap, needed);
            (*h).data = moved_block((*h).data, (*h).len, new_cap);
            (*h).cap = new_cap;
            return;
        }
        let mut new_cap = (*h).cap * 2;
        while new_cap < needed {
            new_cap *= 2;
        }
        let grown = realloc((*h).data, new_cap as u64);
        if grown == 0 as *mut u8 {
            die(c"out of memory");
        }
        (*h).data = grown;
        (*h).cap = new_cap;
    }
}

pub fn buf_clear(b: i64) {
    let h = buf_hdr(b);
    // UNSAFE: b's header read and written through its address
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3); a frozen
    // buffer stops here, so no view of one sees its length change
    unsafe {
        if (*h).cap < 0 {
            frozen_written(b);
        }
        (*h).len = 0;
    }
}

pub fn buf_byte(b: i64, c: u8) {
    let h = buf_hdr(b);
    // UNSAFE: b's header and block written through raw pointers
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3). After
    // the check len < cap (buf_reserve made room, and stopped at a
    // frozen buffer, whose negative cap comes here too), so data[len] is
    // inside the block (B2); it is written before len covers it
    unsafe {
        if (*h).len >= (*h).cap {
            buf_reserve(b, 1);
        }
        *(*h).data.add((*h).len as usize) = c;
        (*h).len += 1;
    }
}

pub fn buf_bytes(b: i64, bytes: &[u8]) {
    let n = bytes.len() as i64;
    buf_reserve(b, n);
    let h = buf_hdr(b);
    // UNSAFE: memcpy into b's block; its header written through its
    // address
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3);
    // buf_reserve made room for n bytes after len (and stopped at a
    // frozen buffer), so data[len..len + n] is inside the block (B2);
    // bytes is a live slice of n bytes that is not in b's block beyond
    // len (no view of a growing buffer exists outside this file, and
    // base's own readers pass another buffer's: buf_append checks),
    // and len covers the bytes only after they are written
    unsafe {
        memcpy((*h).data.add((*h).len as usize), bytes.ptr, n as u64);
        (*h).len += n;
    }
}

// ---- Reading and cutting a buffer from outside base (0.29) ----
//
// BUFS is touched only in this file. What the rest of the compiler needs
// of a buffer, and what each form promises:
//
// - By value, nothing to outlive: buf_len, buf_at (a byte, checked
//   against the length), buf_set (a byte below the length, checked),
//   buf_truncate (a shorter length, checked), buf_zeros (n zero bytes
//   appended). These read the table and the buffer at the call and keep
//   nothing, so a growth of either before or after cannot be seen.
// - A frozen buffer's bytes: buf_done, `&'static [u8]`, and that is true:
//   a frozen buffer is never written, moved or freed (buf_freeze), and
//   every writer stops the compiler at one (frozen_written).
// - A growing buffer's bytes: there is no borrowed view of them outside
//   this file. A buffer is a number, so there is no owner whose borrow
//   would end a view at the next write (buf_reserve may move the block;
//   buf_clear and every writer change the bytes), and no lifetime a
//   safe function could give such a slice would be true. What a caller
//   gets instead: its own copy (buf_copy, a Vec), or the operation done
//   here on the block, by value: buf_append (into another buffer),
//   intern_buf (its symbol), buf_eq (a comparison), buf_at, buf_len.
//   (Until 0.29 buf_slice returned the block as `&'static [u8]`, good
//   only until the next write to the buffer; about 1380 callers.)
// - The block's address: buf_ptr, a raw pointer for C (a path for
//   fopen, bytes for write, room for read). It promises nothing; the
//   unsafe is at the dereference or the C call, which says why the
//   pointer is still the block's (no write to the buffer since).
//
// None of them checks b against BUF_COUNT: an id comes only from
// buf_new, ids are never reused and buffers never freed, and BUF_COUNT
// is the main thread's (get_buf_count), so a task could not read it.

// The bytes of buffer b for as long as nothing writes b. The one place a
// buffer's block becomes a slice: base's own readers (buf_copy,
// buf_append, buf_done, intern_buf, the writers to a descriptor or a
// file) go through it and end the view before they return or write b.
// UNSAFE: a slice over a block base keeps as a raw pointer and a length
// in BUFS; the lifetime 'a is the caller's to keep
// SAFETY: the caller's: no write to b (which may move or change its
// block) while the result is used, and no other thread writes b
// meanwhile (B3). Here: h is b's header (buf_hdr, B4), and data holds
// len initialized bytes (B2)
unsafe fn buf_raw<'a>(b: i64) -> &'a [u8] {
    let h = buf_hdr(b);
    std::slice::from_raw_parts((*h).data, (*h).len as usize)
}

// A Vec of these bytes, in one block and one copy.
fn bytes_vec(bytes: &[u8]) -> Vec<u8, Comp> {
    let n = bytes.len();
    let mut copy: Vec<u8, Comp> = Vec::with_capacity_in(n, Comp {});
    // UNSAFE: memcpy into the Vec's block and set_len, in place of
    // extend_from_slice, which pushes a byte at a time (14 instructions
    // each: 3% of `volec check`, which copies std's text, measured)
    // SAFETY: with_capacity_in made room for n bytes, memcpy fills
    // exactly those n from a live slice of n bytes in another block,
    // and only then set_len(n) covers them: no byte is read before it
    // is written, and n is the capacity asked for
    unsafe {
        if n > 0 {
            memcpy(copy.as_mut_ptr(), bytes.ptr, n as u64);
        }
        copy.set_len(n);
    }
    copy
}

// A copy of growing buffer b's bytes, the caller's own: `&buf_copy(b)`
// where a `&[u8]` is read in one statement, `let t = buf_copy(b);` for
// more. A write to b after it changes nothing in the copy. (A byte:
// buf_at; the length: buf_len; into another buffer: buf_append; a
// buffer written for the last time: buf_done, no copy.)
pub fn buf_copy(b: i64) -> Vec<u8, Comp> {
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: b is an id buf_new returned; bytes_vec writes the new
    // Vec's block, never a buffer, and the view ends when it returns
    unsafe { bytes_vec(buf_raw(b)) }
}

// Vec `into` made a copy of buffer b's bytes, its room kept: buf_copy
// for a Vec that is filled again and again (a function's text, per
// function).
pub fn buf_copy_into(b: i64, into: &mut Vec<u8, Comp>) {
    into.clear();
    // UNSAFE: the buffer's block read as a slice (buf_raw), and memcpy
    // into the Vec's block with set_len, in place of extend_from_slice,
    // which pushes a byte at a time (bytes_vec's reason)
    // SAFETY: b is an id buf_new returned; reserve made room for n
    // bytes in the cleared Vec, memcpy fills exactly those n from the
    // buffer's n initialized bytes (another block: a Vec's is never a
    // buffer's), and only then set_len(n) covers them; the view ends
    // here and nothing writes b meanwhile
    unsafe {
        let bytes: &[u8] = buf_raw(b);
        let n = bytes.len();
        into.reserve(n);
        if n > 0 {
            memcpy(into.as_mut_ptr(), bytes.ptr, n as u64);
        }
        into.set_len(n);
    }
}

// A copy of bytes from..to of growing buffer b (checked against its
// length): a part of a large buffer, without copying the whole.
pub fn buf_copy_range(b: i64, from: i64, to: i64) -> Vec<u8, Comp> {
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: b is an id buf_new returned; the range is checked by the
    // slice's index; bytes_vec writes the new Vec's block, never a
    // buffer, and the view ends when it returns
    unsafe { bytes_vec(&buf_raw(b)[from as usize..to as usize]) }
}

// Buffer src's bytes appended to buffer dst (src is not dst).
pub fn buf_append(dst: i64, src: i64) {
    if dst == src {
        die(c"internal: a buffer appended to itself");
    }
    // UNSAFE: the source buffer's block read as a slice (buf_raw)
    // SAFETY: both are ids buf_new returned; buf_bytes writes dst only,
    // which is another buffer than src (checked above), so src's block
    // neither moves nor changes under the view, which ends here
    unsafe { buf_bytes(dst, buf_raw(src)); }
}

// The symbol of buffer b's bytes (intern).
pub fn intern_buf(b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: b is an id buf_new returned; intern writes the context's
    // symbols and their own blocks, never a buffer (it copies the bytes
    // of a new symbol), and the view ends when it returns
    unsafe { intern(buf_raw(b), pcx) }
}

// The symbol with buffer b's bytes, or -1 (find_sym).
pub fn find_sym_buf(b: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: b is an id buf_new returned; find_sym only reads the
    // context's symbols, and the view ends when it returns
    unsafe { find_sym(buf_raw(b), pcx) }
}

// True if buffer b holds exactly these bytes.
pub fn buf_eq(b: i64, bytes: &[u8]) -> bool {
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: b is an id buf_new returned; nothing is written between
    // the view and the comparison, which ends it
    unsafe { buf_raw(b) == bytes }
}

// The number of bytes in buffer b.
#[inline]
pub fn buf_len(b: i64) -> i64 {
    let h = buf_hdr(b);
    // UNSAFE: b's header read through its address
    // SAFETY: h is b's header (buf_hdr, B4); the length is read by value
    // on the buffer's thread (B3), nothing is kept
    unsafe { (*h).len }
}

// An index outside a buffer: an internal error, never an access.
fn buf_bad_index() -> ! {
    die(c"internal: a buffer index out of range")
}

// Byte i of buffer b.
#[inline]
pub fn buf_at(b: i64, i: i64) -> u8 {
    let h = buf_hdr(b);
    // UNSAFE: b's header and block read through raw pointers
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3); i is
    // checked against the length (as u64: a negative i is out of range
    // too), and data holds len initialized bytes (B2); the byte is read
    // by value
    unsafe {
        if i as u64 >= (*h).len as u64 {
            buf_bad_index();
        }
        *(*h).data.add(i as usize)
    }
}

// Byte i of buffer b becomes c (i below the length: buf_byte appends).
pub fn buf_set(b: i64, i: i64, c: u8) {
    let h = buf_hdr(b);
    // UNSAFE: b's header read and its block written through raw pointers
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3); a frozen
    // buffer stops here, so no view of one sees a byte change; i is
    // checked against the length, and data holds len bytes (B2)
    unsafe {
        if (*h).cap < 0 {
            frozen_written(b);
        }
        if i as u64 >= (*h).len as u64 {
            buf_bad_index();
        }
        *(*h).data.add(i as usize) = c;
    }
}

// Buffer b cut to its first n bytes (n at most its length).
pub fn buf_truncate(b: i64, n: i64) {
    let h = buf_hdr(b);
    // UNSAFE: b's header read and written through its address
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3); a frozen
    // buffer stops here, so no view of one sees its length change; n is
    // checked against the length, so the length never covers bytes that
    // were not written (B2)
    unsafe {
        if (*h).cap < 0 {
            frozen_written(b);
        }
        if n as u64 > (*h).len as u64 {
            buf_bad_index();
        }
        (*h).len = n;
    }
}

// n zero bytes appended to buffer b: room to fill through buf_set or,
// for C, through buf_ptr (fread, readlink), then cut to what was filled
// (buf_truncate). Returns the offset of the first.
pub fn buf_zeros(b: i64, n: i64) -> i64 {
    if n < 0 {
        buf_bad_index();
    }
    buf_reserve(b, n);
    let h = buf_hdr(b);
    // UNSAFE: memset is C's, into b's block; its header written through
    // its address
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3);
    // buf_reserve made room for n bytes after the length (and stopped at
    // a frozen buffer), which memset fills before the length covers them
    // (B2)
    unsafe {
        let at = (*h).len;
        memset((*h).data.add(at as usize), 0, n as u64);
        (*h).len = at + n;
        at
    }
}

// The address of buffer b's block, for C. A raw pointer: it promises
// nothing, and the next write to b may move the block (buf_reserve), so
// it is taken where it is used.
#[inline]
pub fn buf_ptr(b: i64) -> *mut u8 {
    let h = buf_hdr(b);
    // UNSAFE: b's header read through its address
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3); the
    // pointer is read by value and not dereferenced here
    unsafe { (*h).data }
}

// v's low 16 bits appended to buffer b, little-endian (the object
// writers' w16: the bytes with one check for room, not a call each).
pub fn buf_w16(b: i64, v: i64) {
    buf_reserve(b, 2);
    let h = buf_hdr(b);
    // UNSAFE: b's header and block written through raw pointers
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3);
    // buf_reserve made room for 2 bytes after the length (and stopped at
    // a frozen buffer), written before the length covers them (B2)
    unsafe {
        let at = (*h).len;
        let d = (*h).data;
        (*d.add(at as usize)) = (v & 255) as u8;
        (*d.add((at + 1) as usize)) = ((v >> 8) & 255) as u8;
        (*h).len = at + 2;
    }
}

// v's low 32 bits appended to buffer b, little-endian (0.25: the bytes
// with one check for room, not a call each).
pub fn buf_w32(b: i64, v: i64) {
    buf_reserve(b, 4);
    let h = buf_hdr(b);
    // UNSAFE: b's header and block written through raw pointers
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3);
    // buf_reserve made room for 4 bytes after the length (and stopped at
    // a frozen buffer), written before the length covers them (B2)
    unsafe {
        let at = (*h).len;
        let d = (*h).data;
        (*d.add(at as usize)) = (v & 255) as u8;
        (*d.add((at + 1) as usize)) = ((v >> 8) & 255) as u8;
        (*d.add((at + 2) as usize)) = ((v >> 16) & 255) as u8;
        (*d.add((at + 3) as usize)) = ((v >> 24) & 255) as u8;
        (*h).len = at + 4;
    }
}

// (0.27.7) Freezes buffer b, written for the last time: its cap word is
// stored as -1 - cap, so a later write reaches buf_reserve (or buf_clear)
// and stops the compiler there. Its bytes then never move, change or go
// away (buffers are never freed, ids never reused), so a slice of it is
// valid for the rest of the process (src-buffer.md: frozen buffers).
pub fn buf_freeze(b: i64) {
    let h = buf_hdr(b);
    // UNSAFE: b's header read and written through its address
    // SAFETY: h is b's header (buf_hdr, B4), written by the thread that
    // owns b while it still grows (B3); only the cap word changes,
    // which no view reads
    unsafe {
        if (*h).cap >= 0 {
            (*h).cap = -1 - (*h).cap;
        }
    }
}

// (0.27.7) Buffer b frozen (buf_freeze), and its bytes: the result of a
// function whose buffer is written for the last time.
pub fn buf_done(b: i64) -> &'static [u8] {
    buf_freeze(b);
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: b is an id buf_new returned and is frozen: every writer
    // stops the compiler at a frozen buffer (frozen_written), and a
    // buffer's block is never freed, so its bytes neither move nor
    // change for the rest of the process, which is what 'static says
    unsafe { buf_raw(b) }
}

// A write to frozen buffer b: an internal error, never a write (its id
// written without a buffer: any buffer may be the frozen one).
fn frozen_written(b: i64) -> ! {
    let mut digits: [u8; 24] = [0; 24];
    let mut n: i64 = 22;
    let mut v = b;
    digits[n as usize] = b'0' + (v % 10) as u8;
    v /= 10;
    while v > 0 {
        n -= 1;
        digits[n as usize] = b'0' + (v % 10) as u8;
        v /= 10;
    }
    die2(c"internal: a write to a frozen buffer (buf_done), buffer ", &mut digits[n as usize])
}

// (0.27.7) `volec __selftest freeze`: a write to a frozen buffer must stop
// the compiler with frozen_written's error (tests/selftest.sh).
pub fn freeze_selftest() -> i64 {
    let b = buf_new();
    buf_bytes(b, b"frozen");
    let s = buf_done(b);
    if s.len() as i64 != 6 {
        die(c"internal: selftest freeze: the frozen slice changed");
    }
    buf_byte(b, b'!');
    die(c"internal: selftest freeze: a frozen buffer was written")
}

pub fn buf_str(b: i64, s: *mut u8) {
    let h = buf_hdr(b);
    // UNSAFE: a C string read through its pointer; b's header and block
    // written through raw pointers
    // SAFETY: s is a NUL-terminated string (the callers' literals, names
    // and paths: this function's contract, as C's strlen), read up to
    // its NUL and no further (the loop stops at it; c_bytes measures the
    // rest only when 16 bytes without one were read). h is b's header
    // (buf_hdr, B4), this thread's (B3); after the check there is room
    // for 16 bytes after len (buf_reserve, which stops at a frozen
    // buffer, whose negative cap fails the check), so data[at + i], i <
    // 16, is inside the block (B2), written before len covers it
    unsafe {
        // (0.25) A short string (the code generator's `    `, `, `, `ldr x`)
        // copied byte by byte with one check for room, not by strlen,
        // buf_reserve and memcpy; a longer one's rest by them.
        if (*h).len + 16 > (*h).cap {
            buf_reserve(b, 16);
        }
        let d = (*h).data;
        let at = (*h).len;
        let mut i: i64 = 0;
        while i < 16 {
            let c = (*s.add(i as usize));
            if c == 0 {
                (*h).len = at + i;
                return;
            }
            (*d.add((at + i) as usize)) = c;
            i += 1;
        }
        (*h).len = at + 16;
        buf_bytes(b, c_bytes(s.add(16)));
    }
}

pub fn buf_uint(b: i64, value: u64) {
    // (0.25: the digits counted, then written in place with one check for
    // room; the code generator writes 54 MB of assembly with them)
    let mut n: i64 = 1;
    let mut t = value;
    while t >= 10 {
        t /= 10;
        n += 1;
    }
    let h = buf_hdr(b);
    // UNSAFE: b's header and block written through raw pointers
    // SAFETY: h is b's header (buf_hdr, B4), this thread's (B3); after
    // the check there is room for n bytes after len (buf_reserve, which
    // stops at a frozen buffer, whose negative cap fails the check), so
    // data[at + k], k < n, is inside the block (B2); all n are written
    // before len covers them
    unsafe {
        if (*h).len + n > (*h).cap {
            buf_reserve(b, n);
        }
        let at = (*h).len;
        let d = (*h).data;
        let mut v = value;
        let mut k = n;
        while k > 0 {
            k -= 1;
            let q = v / 10;
            (*d.add((at + k) as usize)) = b'0' + (v - q * 10) as u8;
            v = q;
        }
        (*h).len = at + n;
    }
}

pub fn buf_int(b: i64, value: i64) {
    if value < 0 {
        buf_byte(b, b'-');
        // Also right for the most negative value: its negation wraps to
        // itself, which as u64 is the right magnitude.
        buf_uint(b, value.wrapping_neg() as u64);
    } else {
        buf_uint(b, value as u64);
    }
}

fn hex_digit_char(d: u64) -> u8 {
    if d < 10 { b'0' + d as u8 } else { b'a' + (d - 10) as u8 }
}

// `value` as exactly `digits` lowercase hex digits.
pub fn buf_hex(b: i64, value: u64, digits: i64) {
    let mut i = digits - 1;
    while i >= 0 {
        buf_byte(b, hex_digit_char((value >> (i * 4) as u64) & 15));
        i -= 1;
    }
}

// (0.16) Appends x's Display, an f-string above all:
// `buf_fmt(b, f"v{n}: {sym_text(s)}")`. The text is made in a std String
// of its own (0.26.5: no longer one kept in a static, which two threads
// would share), then copied. Through push_fmt, which 0.15's std and
// 0.16's both have (0.16 has no Fmt::to_buf).
pub fn buf_fmt<T: std::fmt::Display>(b: i64, x: T) {
    let mut s: std::string::String<Comp> = std::string::String::new_in(Comp {});
    std::fmt::write(&mut s, x).unwrap();
    buf_bytes(b, s.as_bytes());
}

// ---- C strings at the boundary (0.29) ----
//
// A C string comes from outside the type system (argv, getenv, a path C
// returned, a buffer's block with a NUL after it: buf_ptr), so no safe
// function can say how long its bytes live. c_bytes is the one place a
// `*u8` becomes a slice, and it is an `unsafe fn`: the lifetime 'a is
// whatever the caller's use needs, and the caller's unsafe block says
// why the string outlives that use. `cstr` (and the tools' `c_slice`)
// are the older safe wrappers with a `'static` result, which is true
// for what they are given today (literals, the command line's words,
// paths kept for the process, blocks of buffers that are never freed)
// and is checked by nothing: new code calls c_bytes, or takes `&[u8]`.

// The bytes of C string s before its NUL.
// UNSAFE: strlen is C's, and a raw pointer is seen as a slice
// SAFETY: the caller's: s points at a NUL-terminated string that is
// neither written nor freed while the result is used
pub unsafe fn c_bytes<'a>(s: *mut u8) -> &'a [u8] {
    std::slice::from_raw_parts(s, strlen(s) as usize)
}

// A copy of C string s's bytes, up to its NUL: `&cstr(s)` where a
// `&[u8]` is read. (0.29: a copy, the caller's own. It returned the
// string's bytes as `&'static [u8]` before, which no function can
// promise of a pointer: a path in a buffer's block lasts until the
// buffer is written.) As buf_str and die, it takes the pointer on
// trust: a NUL-terminated string, the convention of every `*mut u8`
// the compiler passes as text.
pub fn cstr(s: *mut u8) -> Vec<u8, Comp> {
    // UNSAFE: a C string seen as a slice (c_bytes)
    // SAFETY: s is a NUL-terminated string (above); bytes_vec copies it
    // before anything else runs, so the view ends in this statement
    unsafe { bytes_vec(c_bytes(s)) }
}

// True if C string s (a NUL-terminated string, as cstr's) is exactly
// these bytes: a comparison, no copy.
pub fn c_eq(s: *mut u8, bytes: &[u8]) -> bool {
    // UNSAFE: a C string seen as a slice (c_bytes)
    // SAFETY: s is a NUL-terminated string (cstr's convention); nothing
    // runs between the view and the comparison, which ends it
    unsafe { c_bytes(s) == bytes }
}

// The length of C string s (a NUL-terminated string, as cstr's).
pub fn c_len(s: *mut u8) -> i64 {
    // UNSAFE: strlen is C's
    // SAFETY: s is a NUL-terminated string (cstr's convention); strlen
    // reads up to its NUL
    unsafe { strlen(s) as i64 }
}

// The first byte of C string s (as cstr's): 0 for the empty string.
pub fn c_first(s: *mut u8) -> u8 {
    // UNSAFE: a C string's first byte read through its pointer
    // SAFETY: s is a NUL-terminated string (cstr's convention), so it
    // has a first byte, its NUL when it is empty
    unsafe { *s }
}

// C string s after its first n bytes: the same string, further on (n
// at most its length, checked: an internal error otherwise).
pub fn c_tail(s: *mut u8, n: i64) -> *mut u8 {
    if n < 0 || n > c_len(s) {
        die(c"internal: a C string cut past its end");
    }
    // UNSAFE: pointer arithmetic inside a C string
    // SAFETY: s is a NUL-terminated string (cstr's convention) of at
    // least n bytes before its NUL (checked above), so s + n is inside
    // it, at most at the NUL; nothing is dereferenced here
    unsafe { s.add(n as usize) }
}

// True if C string s (as cstr's) starts with these bytes.
pub fn c_starts(s: *mut u8, bytes: &[u8]) -> bool {
    // UNSAFE: a C string seen as a slice (c_bytes)
    // SAFETY: s is a NUL-terminated string (cstr's convention); nothing
    // runs between the view and the comparison, which ends it
    unsafe {
        let have: &[u8] = c_bytes(s);
        have.len() >= bytes.len() && &have[0..bytes.len()] == bytes
    }
}

// True if buffer b's bytes start with C string s (as cstr's).
pub fn buf_starts_c(b: i64, s: *mut u8) -> bool {
    // UNSAFE: the buffer's block and a C string seen as slices (buf_raw,
    // c_bytes)
    // SAFETY: b is an id buf_new returned and s a NUL-terminated string
    // (cstr's convention); nothing is written between the two views
    // and the comparison, which ends them
    unsafe {
        let have: &[u8] = buf_raw(b);
        let want: &[u8] = c_bytes(s);
        have.len() >= want.len() && &have[0..want.len()] == want
    }
}

// A copy of C string s kept for the rest of the process: the bytes of a
// frozen buffer made for it, so `&'static` is true (buf_done). For a
// text that must outlive its statement and is asked for a few times (a
// word of a command line, a path a message shows); cstr's copy is the
// caller's and is freed with it.
pub fn c_kept(s: *mut u8) -> &'static [u8] {
    let b = buf_new();
    buf_str(b, s);
    buf_done(b)
}

// C path p after its leading `./`s: the same string, further on (a
// module next to a root given without a directory is `x.vl`, not
// `./x.vl`).
pub fn c_plain_path(p: *mut u8) -> *mut u8 {
    let mut path = p;
    // UNSAFE: a C string read and stepped through by its pointer
    // SAFETY: p is a NUL-terminated string (cstr's convention). The
    // second byte is read only when the first is `.`, so not past the
    // NUL, and the pointer moves two bytes only over a `.` and a `/`,
    // neither of them the NUL: it stays inside the string
    unsafe {
        while *path == b'.' && *path.add(1) == b'/' {
            path = path.add(2);
        }
    }
    path
}

// Writes the whole buffer to a file descriptor (0.15: what goes to
// stdout while STDOUT_CAPTURE is a buffer goes to that buffer, for the
// output budget of `volec query`).
pub fn buf_write_fd(b: i64, fd: i32) {
    let capture = get_stdout_capture();
    if fd == STDOUT && capture >= 0 && b != capture {
        buf_append(capture, b);
        return;
    }
    // (0.15) --json: what goes to stdout as JSON lines
    if crate::base::json::get_diag_json() && fd == STDOUT {
        let j = buf_new();
        // UNSAFE: the buffer's block read as a slice (buf_raw)
        // SAFETY: b is an id buf_new returned; json_output writes j, a
        // buffer made here and so another than b, and the view ends
        // when it returns
        unsafe { crate::base::json::json_output(j, buf_raw(b)); }
        write_all_fd(fd, j);
        return;
    }
    write_all_fd(fd, b);
}

// Buffer b's bytes written to descriptor fd (one write: what the system
// does not take is dropped, as before).
fn write_all_fd(fd: i32, b: i64) {
    // UNSAFE: write is C's, given the buffer's block (buf_raw)
    // SAFETY: b is an id buf_new returned; the view is the block's len
    // initialized bytes and ends with the call, which writes no buffer
    unsafe {
        let bytes: &[u8] = buf_raw(b);
        write(fd, bytes.ptr, bytes.len() as u64);
    }
}

// (0.15) The buffer stdout's writes go to (buf_write_fd), or -1.
static STDOUT_CAPTURE: Atomic<i64> = Atomic::new(-1);

pub fn buf_write_file(b: i64, path: *mut u8) {
    // UNSAFE: fopen, fwrite and fclose are C's, given the buffer's block
    // (buf_raw)
    // SAFETY: path is a NUL-terminated string (the callers': a path made
    // in a buffer with its NUL, or a word of the command line); the file
    // is checked before it is used and closed once; the view is b's len
    // initialized bytes and ends with fwrite, which writes no buffer
    unsafe {
        let file = fopen(path, c"wb");
        if file == 0 as *mut u8 {
            die2(c"cannot write ", path);
        }
        let bytes: &[u8] = buf_raw(b);
        fwrite(bytes.ptr, 1, bytes.len() as u64, file);
        fclose(file);
    }
}

// ---- Fatal errors without a source position ----

// A C string written to descriptor fd (the fatal errors' texts: no
// buffer, since a buffer's own failure comes here).
fn write_c(fd: i32, text: *mut u8) {
    // UNSAFE: write and strlen are C's
    // SAFETY: text is a NUL-terminated string (a literal, or a message
    // the caller ended with a 0): strlen reads up to its NUL and write
    // is given exactly those bytes
    unsafe { write(fd, text, strlen(text)); }
}

// The process ended with status `code`, C's way (its atexit handlers
// run and its streams are flushed), from safe code.
pub fn exit_now(code: i32) -> ! {
    // UNSAFE: exit is C's
    // SAFETY: exit takes any status and does not return; nothing of
    // this program's memory is used after it
    unsafe { exit(code) }
}

pub fn die(message: *mut u8) -> ! {
    write_c(STDERR, c"error: ");
    write_c(STDERR, message);
    write_c(STDERR, c"\n");
    exit_now(1)
}

pub fn die2(message: *mut u8, detail: *mut u8) -> ! {
    write_c(STDERR, c"error: ");
    write_c(STDERR, message);
    write_c(STDERR, detail);
    write_c(STDERR, c"\n");
    exit_now(1)
}

// ---- Symbols ----

// Every identifier is interned once; a symbol is its index in the
// context's syms (0.27.0; the static SYMS before). Its text is
// ptr[0..len], NUL-terminated (ptr is a C string): a raw pointer and a
// length, not a `[u8]`, so that a Sym views nothing and the compilation
// context can hold the symbols (sym_text makes the slice).
#[derive(Clone, Copy)] pub struct Sym { pub ptr: *mut u8, pub len: i64, pub hash: u64 }

// (0.26.3) True while middle::parallel's tasks run (set by
// middle::threads around a phase, on one thread or many): a task may look
// a symbol up but not make one, since the other threads read the
// context's syms and sym_table meanwhile (a push or a rehash under them
// is a data race). (0.27.0) A task cannot call intern: it takes the
// context inout, and a task is lent it let (find_sym is the lookup); a
// symbol a task needs is made first (parallel's prepare_tasks). This
// stays for the main thread while a phase's tasks run (pool_run_joined's
// join_task): intern dies instead. Written by the main thread only,
// before a phase hands its tasks over and after all are done (ordered by
// the pool's mutex).
static SYMS_FROZEN: Atomic<bool> = Atomic::new(false);

fn hash_bytes(bytes: &[u8]) -> u64 {
    let mut h: u64 = 14695981039346656037;
    for i in 0..bytes.len() {
        h ^= bytes[i] as u64;
        h = h.wrapping_mul(1099511628211u64);
    }
    h
}

fn sym_table_insert(sym: i64, pcx: &mut Ctx<Comp>) {
    let mask = pcx.sym_table.len() - 1;
    let mut slot = pcx.syms[sym as usize].hash as usize & mask;
    while pcx.sym_table[slot] != 0 {
        slot = (slot + 1) & mask;
    }
    pcx.sym_table[slot] = sym + 1;
}

fn sym_table_rehash(pcx: &mut Ctx<Comp>) {
    let mut new_size = pcx.sym_table.len() * 2;
    if new_size < 1024 {
        new_size = 1024;
    }
    pcx.sym_table.clear();
    pcx.sym_table.resize(new_size, 0);
    for sym in 0..pcx.syms.len() as i64 {
        sym_table_insert(sym, pcx);
    }
}

// The symbol with these bytes, or -1 (none is made).
pub fn find_sym(bytes: &[u8], pcx: &Ctx<Comp>) -> i64 {
    if pcx.sym_table.len() == 0 {
        return -1;
    }
    let hash = hash_bytes(bytes);
    let mask = pcx.sym_table.len() - 1;
    let mut slot = hash as usize & mask;
    while pcx.sym_table[slot] != 0 {
        let sym = pcx.sym_table[slot] - 1;
        if pcx.syms[sym as usize].hash == hash && sym_text(sym, pcx) == bytes {
            return sym;
        }
        slot = (slot + 1) & mask;
    }
    -1
}

pub fn intern(bytes: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let n = bytes.len() as i64;
    // (frozen: no rehash, the table has room for the lookup)
    if !get_syms_frozen() && (pcx.syms.len() + 1) * 2 > pcx.sym_table.len() {
        sym_table_rehash(pcx);
    }
    let hash = hash_bytes(bytes);
    let mask = pcx.sym_table.len() - 1;
    let mut slot = hash as usize & mask;
    while pcx.sym_table[slot] != 0 {
        let sym = pcx.sym_table[slot] - 1;
        if pcx.syms[sym as usize].hash == hash && sym_text(sym, pcx) == bytes {
            return sym;
        }
        slot = (slot + 1) & mask;
    }
    if get_syms_frozen() {
        // (one write: the other threads may die the same way)
        let mut line: Vec<u8, Comp> = Vec::new_in(Comp {});
        line.extend_from_slice(b"error: internal: symbol `");
        line.extend_from_slice(bytes);
        line.extend_from_slice(
            b"` made while the code generator's tasks run (make it first: middle::parallel's prepare_tasks)\n");
        line.push(0);
        write_c(STDERR, line.as_mut_ptr());
        exit_now(1);
    }
    let sym = pcx.syms.len() as i64;
    // Symbols keep their own NUL-terminated copy, usable as a C string.
    let copy = alloc_zeroed(n + 1);
    // UNSAFE: memcpy is C's, into the symbol's new block
    // SAFETY: alloc_zeroed returned a block of n + 1 zero bytes, this
    // function's alone; memcpy fills its first n from bytes, a live
    // slice of n bytes in another block, and the last stays 0
    unsafe { memcpy(copy, bytes.ptr, n as u64); }
    pcx.syms.push(Sym { ptr: copy, len: n, hash });
    pcx.sym_table[slot] = sym + 1;
    if pcx.syms.len() as i64 > pcx.sym_tables_cap && pcx.sym_tables_cap > 0 {
        grow_sym_tables(pcx);
    }
    sym
}

// Appends a symbol the table does not hold yet, with its hash (the tools'
// cache, 0.13: the symbols of a program in their order, so that each
// gets its number back). `text` is NUL-terminated and stays.
pub fn restore_sym(text: &[u8], hash: u64, pcx: &mut Ctx<Comp>) -> i64 {
    if (pcx.syms.len() + 1) * 2 > pcx.sym_table.len() {
        sym_table_rehash(pcx);
    }
    let sym = pcx.syms.len() as i64;
    pcx.syms.push(Sym { ptr: text.ptr, len: text.len() as i64, hash });
    sym_table_insert(sym, pcx);
    sym
}

// The hash of symbol sym.
pub fn sym_hash(sym: i64, pcx: &Ctx<Comp>) -> u64 {
    pcx.syms[sym as usize].hash
}

// The length of a table indexed by symbol: room for every symbol and
// the next one. The tables made so far are grown to it first.
pub fn sym_table_len(pcx: &mut Ctx<Comp>) -> usize {
    if pcx.sym_tables_cap < pcx.syms.len() as i64 + 1 {
        if pcx.sym_tables_cap > 0 {
            grow_sym_tables(pcx);
        } else {
            pcx.sym_tables_cap = (pcx.syms.len() as i64 + 1) * 2;
        }
    }
    pcx.sym_tables_cap as usize
}

// `table` made a zeroed table indexed by symbol, of `n` entries
// (sym_table_len); intern keeps it as large as the symbol table.
pub fn sym_table(table: &mut Vec<i64, Comp>, n: usize) {
    table.clear();
    table.resize(n, 0);
}

fn grow_sym_table(table: &mut Vec<i64, Comp>, n: usize) {
    if table.len() > 0 {
        table.resize(n, 0);
    }
}

// Every table indexed by symbol that was made (sym_table), grown with
// the symbol table: the new entries are zero.
fn grow_sym_tables(pcx: &mut Ctx<Comp>) {
    let mut cap = pcx.sym_tables_cap * 2;
    while cap < pcx.syms.len() as i64 + 1 {
        cap *= 2;
    }
    let n = cap as usize;
    grow_sym_table(&mut pcx.intr_by_name, n);
    grow_sym_table(&mut pcx.sym_prelude, n);
    grow_sym_table(&mut pcx.sym_trait, n);
    grow_sym_table(&mut pcx.sym_struct, n);
    grow_sym_table(&mut pcx.sym_enum, n);
    grow_sym_table(&mut pcx.sym_alias, n);
    grow_sym_table(&mut pcx.sym_fn, n);
    grow_sym_table(&mut pcx.sym_const, n);
    grow_sym_table(&mut pcx.sym_static, n);
    grow_sym_table(&mut pcx.sym_primitive, n);
    grow_sym_table(&mut pcx.alias_type, n);
    grow_sym_table(&mut pcx.alias_busy, n);
    grow_sym_table(&mut pcx.sym_item, n);
    pcx.sym_tables_cap = cap;
}

pub fn intern_c(s: *mut u8, pcx: &mut Ctx<Comp>) -> i64 {
    // UNSAFE: a C string seen as a slice (c_bytes)
    // SAFETY: s is a NUL-terminated string (cstr's convention: the
    // callers' literals); intern copies the bytes of a new symbol and
    // keeps no view, which ends when it returns
    unsafe { intern(c_bytes(s), pcx) }
}

// The symbol's name as a C string.
pub fn sym_name(sym: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    sym_text(sym, pcx).ptr
}

// The symbol's name: `{sym_text(s)}` in an f-string. (0.27.0) A symbol
// keeps it as a raw pointer and a length, which views nothing, so that
// the compilation context can hold the symbols; the slice is made here.
pub fn sym_text(sym: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    // UNSAFE: a Sym's text is a raw pointer and a length (a Sym holds no
    // view), made into a slice here.
    // SAFETY: intern and restore_sym keep ptr[0..len] (a NUL after it) for
    // the life of the process: no symbol's text is freed or changed.
    unsafe {
        std::slice::from_raw_parts(pcx.syms[sym as usize].ptr.add((0) as usize),
            (pcx.syms[sym as usize].len - (0)) as usize)
    }
}

// ---- Source files ----

// All files are read into one buffer, SRC; a position is an offset in it.
// `module`: the module the file makes (modules.vl; 0 for the root).
// `kind` (0.26.2): SOURCE_VOLE, or SOURCE_WGSL for the file of an
// `embed wgsl K from "x.wgsl";` (appended by expand_embeds, after every
// vole file: never lexed as vole).
#[derive(Clone, Copy)] pub struct SourceFile {
    pub path: *mut u8, pub start: i64, pub end: i64, pub module: i64, pub kind: i64,
}

pub const SOURCE_VOLE: i64 = 0;
pub const SOURCE_WGSL: i64 = 1;

// (0.25.5) a view of SRC_BUF's bytes, the texts and a 0 after them: read
// with checks (the lexer's loops take its ptr)
static SRC: Atomic<*mut &'static [u8]> = Atomic::new(0 as *mut &'static [u8]);

// The file to read for `path`: its copy in OVERLAY, or itself.
pub fn overlay_of(path: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    let mut i: i64 = 0;
    while i < pcx.overlay.len() as i64 {
        if streq((pcx.overlay[i as usize]) as *mut u8, path) {
            return (pcx.overlay[(i + 1) as usize]) as *mut u8;
        }
        i += 2;
    }
    path
}

pub fn read_file(path: *mut u8, out: i64, pcx: &Ctx<Comp>) {
    // UNSAFE: fopen, fread and fclose are C's; fread fills the buffer's
    // block
    // SAFETY: path is a NUL-terminated string (the callers': a source
    // file's path); the file is checked before it is used and closed
    // once. Each round buf_zeros appends 65536 zero bytes at `at`, so
    // the block (buf_ptr, taken after it, no write between) has that
    // room for fread, which writes at most 65536 bytes there; the
    // buffer is then cut to what was read
    unsafe {
        let file = fopen(overlay_of(path, pcx), c"rb");
        if file == 0 as *mut u8 {
            die2(c"cannot read ", path);
        }
        loop {
            let at = buf_zeros(out, 65536);
            let got = fread(buf_ptr(out).add(at as usize), 1, 65536, file) as i64;
            buf_truncate(out, at + got);
            if got == 0 {
                break;
            }
        }
        fclose(file);
    }
}

// ---- The sources' region (0.27.6, docs/design/src-buffer.md) ----

// The bytes reserved for a source set: address space, committed when
// first written (MAP_NORESERVE); VOLE_SRC_CAP=N in the environment sets
// it for a run.
pub const SRC_CAP: i64 = 1 << 32;

// UNSAFE: C's mmap, the reservation's only maker.
// SAFETY: <sys/mman.h>'s prototype, on macOS and Linux alike.
extern "C" {
    fn mmap(addr: *mut u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut u8;
}

// mmap's PROT_READ | PROT_WRITE.
const SRC_PROT: i32 = 3;

// mmap's MAP_PRIVATE | MAP_ANON | MAP_NORESERVE, whose values differ
// between the C libraries (<sys/mman.h>): Darwin's MAP_ANON 0x1000 and
// MAP_NORESERVE 0x40, Linux's 0x20 and 0x4000. std::TARGET_OS is std's
// per-OS tail (std/sys/macos.vl, std/sys/linux.vl), the system of the
// target this compiler was built for: a compiler built for aarch64-linux
// gets Linux's values by construction. (A std item new in 0.27.6 is
// used here from 0.27.7: the chain rule.)
fn src_map_flags() -> i32 {
    if std::TARGET_OS == 1 { 0x02 | 0x20 | 0x4000 } else { 0x02 | 0x1000 | 0x40 }
}

// The capacity a source set reserves: VOLE_SRC_CAP's, else SRC_CAP.
fn src_cap_wanted() -> i64 {
    let value = env_var(c"VOLE_SRC_CAP");
    let mut n: i64 = 0;
    for &c in value.as_slice() {
        if c < b'0' || c > b'9' || n >= SRC_CAP {
            break;
        }
        n = n * 10 + (c - b'0') as i64;
    }
    if n > 0 && n < SRC_CAP { n } else { SRC_CAP }
}

// A fresh region of cap bytes, never unmapped; the compiler stops when
// mmap refuses it (never a null SRC).
fn src_reserve(cap: i64) -> *mut u8 {
    // UNSAFE: C's mmap.
    // SAFETY: an anonymous private mapping at an address the system
    // chooses, of no file: it aliases no memory of the program; its
    // failure, MAP_FAILED, is checked before the pointer is used.
    let p = unsafe { mmap(0 as *mut u8, cap as u64, SRC_PROT, src_map_flags(), -1, 0) };
    if p as i64 == -1 || p == 0 as *mut u8 {
        let n = buf_new();
        buf_int(n, cap);
        buf_str(n, c" bytes for the sources (mmap)");
        buf_byte(n, 0);
        die2(c"cannot reserve ", buf_ptr(n));
    }
    p
}

// A new source set: a region of the wanted capacity, empty.
fn src_begin(pcx: &mut Ctx<Comp>) {
    pcx.src_cap = src_cap_wanted();
    pcx.src_base = src_reserve(pcx.src_cap);
    pcx.src_used = 0;
}

// bytes appended at the region's end, past every byte SRC was given; the
// compiler stops when they would pass its capacity.
fn src_put(bytes: &[u8], pcx: &mut Ctx<Comp>) {
    let n = bytes.len() as i64;
    if n > pcx.src_cap - pcx.src_used {
        let m = buf_new();
        buf_int(m, pcx.src_cap);
        buf_str(m, c" bytes reserved for them (VOLE_SRC_CAP)");
        buf_byte(m, 0);
        die2(c"the sources pass the ", buf_ptr(m));
    }
    if n > 0 {
        // UNSAFE: a copy into the region through its base pointer.
        // SAFETY: [src_used, src_used + n) is inside the region (checked
        // above against src_cap, the bytes mmap reserved) and past every
        // byte SRC has been given (src_publish: [0, src_used)), so no view
        // of SRC sees it change; bytes is a live view of other memory.
        unsafe { memcpy(pcx.src_base.add(pcx.src_used as usize), bytes.ptr, n as u64); }
    }
    pcx.src_used += n;
}

// One byte appended (src_put's).
fn src_put_byte(b: u8, pcx: &mut Ctx<Comp>) {
    let one = [b];
    src_put(&one[..], pcx);
}

// The n bytes at p, a region's (src_publish, src_copy): a raw pointer and
// a length, which view nothing, made into a slice here.
fn region_bytes(p: *mut u8, n: i64) -> &'static [u8] {
    // UNSAFE: a slice made from a raw pointer and a length.
    // SAFETY: the callers' p is a region's base (src_reserve), never
    // unmapped, and n at most the bytes written in it.
    unsafe { std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize) }
}

// SRC is the region's bytes so far, its last a NUL.
fn src_publish(pcx: &mut Ctx<Comp>) {
    set_src(region_bytes(pcx.src_base, pcx.src_used));
    pcx.src_len = pcx.src_used - 1;
}

// (0.27.6) text copied into a region of its own, never unmapped nor
// written again: read_pieces' SRC while it lexes text.
pub fn src_copy(text: &[u8]) -> &'static [u8] {
    let n = text.len() as i64;
    let p = src_reserve(n + 1);
    // UNSAFE: a copy into the new region, and a view of it.
    // SAFETY: the region holds n + 1 bytes (mmap rounds up to pages), its
    // own: nothing else points into it; it is never unmapped nor written
    // after this, so the view stays valid; text is a live view.
    // (0.28.0) The view lasts the process, and the rust edition's result
    // is 'static (translate/sig.vl static_result: SRC holds it):
    // src_reserve's mapping is never unmapped (the compiler calls no
    // munmap), p is in no other variable, and nothing writes the region
    // after the two writes here (docs/design/src-buffer.md).
    unsafe {
        memcpy(p, text.ptr, n as u64);
        (*p.add(n as usize)) = 0;
        std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize)
    }
}

// Reads all source files into SRC; each file is followed by a newline so
// that tokens never span files. (0.27.6) A new source set: a region of
// its own (src_begin), never moved, freed or written again where SRC has
// been given it. `paths`: the files' paths, C strings kept as numbers
// (a word of the command line, a path made once: they stay, since a
// SourceFile keeps each).
pub fn load_sources(paths: &[i64], pcx: &mut Ctx<Comp>) {
    src_begin(pcx);
    let text = buf_new();
    for &p in paths {
        let path = p as *mut u8;
        buf_clear(text);
        read_file(path, text, pcx);
        let start = pcx.src_used;
        // UNSAFE: the buffer's block read as a slice (buf_raw)
        // SAFETY: text is a buffer made above; src_put copies the bytes
        // into the sources' region and writes no buffer (its messages,
        // in buffers of their own, end the compiler), and the view ends
        // when it returns
        unsafe { src_put(buf_raw(text), pcx); }
        pcx.files.push(SourceFile { path, start, end: pcx.src_used, module: 0, kind: 0 });
        pcx.out_paths.push(Atomic::new(-1));
        src_put_byte(b'\n', pcx);
    }
    src_put_byte(0, pcx);
    src_publish(pcx);
}

// Adds a source file made by the compiler (the declarations of `import`ed
// C headers) after the others, of `kind` (SOURCE_WGSL: an embedded
// block's file, 0.26.2); returns its start in SRC.
pub fn add_source(path: *mut u8, text: i64, pcx: &mut Ctx<Comp>, kind: i64) -> i64 {
    // (no set yet: one, src_begin)
    if pcx.src_base == 0 as *mut u8 {
        src_begin(pcx);
    }
    // (0.27.6: after the last file's NUL, which stays, and a newline:
    // no byte of a SRC already given out is written again, a view of
    // it ending at the NUL included; each file starts after a newline)
    src_put_byte(b'\n', pcx);
    let start = pcx.src_used;
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: text is an id buf_new returned; src_put copies the bytes into
    // the sources' region and writes no buffer (its messages, in buffers
    // of their own, end the compiler), and the view ends when it returns
    unsafe { src_put(buf_raw(text), pcx); }
    pcx.files.push(SourceFile { path, start, end: pcx.src_used, module: 0, kind });
    pcx.out_paths.push(Atomic::new(-1));
    src_put_byte(b'\n', pcx);
    src_put_byte(0, pcx);
    src_publish(pcx);
    start
}

// The path of source file `file`: a C string the context keeps for the
// process (the command line's, a module's made once, the cache's).
pub fn source_path<'a>(file: i64, pcx: &'a Ctx<Comp>) -> &'a [u8] {
    // UNSAFE: a SourceFile's path is a raw C string, seen as a slice
    // SAFETY: load_sources, add_source and restore_sources are given
    // NUL-terminated paths that are never freed or written (a word of
    // the command line, a path made once in a block of its own), and
    // the entry stays in pcx.files, which the result borrows
    unsafe { c_bytes(pcx.files[file as usize].path) }
}

// Buffer b's block as a C string for the rest of the process: a NUL is
// appended and b frozen, so the block never moves or changes again.
fn buf_frozen_cstr(b: i64) -> *mut u8 {
    buf_byte(b, 0);
    buf_freeze(b);
    buf_ptr(b)
}

// The absolute directory of the root file (FILES[0]), resolved once; the
// empty string when it cannot be. (0.29: kept in the context, as the
// number of the frozen buffer that holds it.)
pub fn root_dir(pcx: &Ctx<Comp>) -> *mut u8 {
    let kept = pcx.root_dir.load(Ordering::Relaxed);
    if kept >= 0 {
        return buf_ptr(kept);
    }
    let dir = buf_new();
    if pcx.files.len() > 0 {
        // UNSAFE: realpath and free are C's; realpath's result is seen
        // as a slice (c_bytes)
        // SAFETY: the root's path is a NUL-terminated string
        // (source_path); with a null second argument realpath returns
        // null (checked) or a NUL-terminated string in a malloc'ed block
        // of its own, which is read here, copied into the buffer, and
        // freed once: no view of it is left
        unsafe {
            let abs = realpath(pcx.files[0].path, 0 as *mut u8);
            if abs != 0 as *mut u8 {
                let text: &[u8] = c_bytes(abs);
                let mut cut = text.len();
                while cut > 0 && text[cut - 1] != b'/' {
                    cut -= 1;
                }
                // (the root at "/x.vl": its directory is "/")
                buf_bytes(dir, &text[0..if cut > 1 { cut - 1 } else { cut }]);
                free(abs);
            }
        }
    }
    let made = buf_frozen_cstr(dir);
    pcx.root_dir.store(dir, Ordering::Relaxed);
    made
}

// The current directory, read once (0.29: kept in the context, as the
// number of the frozen buffer that holds it); "/" when it cannot be read.
fn current_dir(pcx: &Ctx<Comp>) -> &'static [u8] {
    let kept = pcx.cwd.load(Ordering::Relaxed);
    if kept >= 0 {
        return buf_done(kept);
    }
    let b = buf_new();
    buf_zeros(b, 4096);
    // UNSAFE: getcwd is C's, given the buffer's block
    // SAFETY: buf_zeros made 4096 zero bytes in b's block, which no
    // write has moved since (buf_ptr is taken here); getcwd writes at
    // most 4096 bytes there, a NUL-terminated path, or returns null
    let ok = unsafe { getcwd(buf_ptr(b), 4096) != 0 as *mut u8 };
    let mut n: i64 = 0;
    while ok && n < 4096 && buf_at(b, n) != 0 {
        n += 1;
    }
    if !ok || n == 0 {
        buf_set(b, 0, b'/');
        n = 1;
    }
    buf_truncate(b, n);
    pcx.cwd.store(b, Ordering::Relaxed);
    buf_done(b)
}

// path normal by its text: empty and "." components dropped, ".."
// taking the component before it away (kept at the start of a relative
// path). With `absolute`, a relative path is first put after the current
// directory (read once). Symbolic links are not followed, so two
// spellings of a file through the same links agree.
fn normal_path(path: &[u8], absolute: bool, pcx: &Ctx<Comp>) -> Vec<u8, Comp> {
    let mut full: Vec<u8, Comp> = Vec::new_in(Comp {});
    if absolute && (path.len() == 0 || path[0] != b'/') {
        full.extend_from_slice(current_dir(pcx));
        full.push(b'/');
    }
    full.extend_from_slice(path);
    let s = full.as_slice();
    let n = s.len();
    let rooted = n > 0 && s[0] == b'/';
    let mut out: Vec<u8, Comp> = Vec::new_in(Comp {});
    // where each kept component starts in out, and whether it is ".."
    let mut starts: Vec<usize, Comp> = Vec::new_in(Comp {});
    let mut ups: Vec<bool, Comp> = Vec::new_in(Comp {});
    let mut i: usize = 0;
    while i < n {
        while i < n && s[i] == b'/' {
            i += 1;
        }
        let a = i;
        while i < n && s[i] != b'/' {
            i += 1;
        }
        let part = &s[a..i];
        if part.len() == 0 || part == b"." {
            continue;
        }
        let up = part == b"..";
        if up && starts.len() > 0 && !ups[ups.len() - 1] {
            out.truncate(starts[starts.len() - 1]);
            starts.pop();
            ups.pop();
            continue;
        }
        if up && rooted {
            continue;
        }
        starts.push(out.len());
        ups.push(up);
        if rooted || out.len() > 0 {
            out.push(b'/');
        }
        out.extend_from_slice(part);
    }
    if rooted && out.len() == 0 {
        out.push(b'/');
    }
    out
}

// The path of file `file` relative to the root's directory (0.18: as
// the compiler writes it into what it makes). Both are made normal by
// their text (normal_path): no call of realpath or getcwd per file,
// which walk the directories above the current one on some systems.
// Each file's is made when first asked and kept in the context
// (pcx.out_paths: the number of the frozen buffer that holds it).
pub fn out_path(file: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    let path = source_path(file, pcx);
    if path.len() > 0 && path[0] == b'<' {
        return pcx.files[file as usize].path;
    }
    let kept = pcx.out_paths[file as usize].load(Ordering::Relaxed);
    if kept >= 0 {
        return buf_ptr(kept);
    }
    // Both relative (the usual case: the modules' paths are made from
    // the root's) need no current directory; else both absolute.
    let root = source_path(0, pcx);
    let absolute = (root.len() > 0 && root[0] == b'/') || (path.len() > 0 && path[0] == b'/');
    // the root's directory: its normal path up to the last '/' ("/" for
    // a root at the top, "" for one in the current directory)
    let r = normal_path(root, absolute, pcx);
    let mut cut = r.len();
    while cut > 0 && r[cut - 1] != b'/' {
        cut -= 1;
    }
    let dir = &r[0..if cut > 1 { cut - 1 } else { cut }];
    let abs = normal_path(path, absolute, pcx);
    // the longest common prefix of whole components
    let mut i: usize = 0;
    let mut last: usize = 0;
    while i < abs.len() && i < dir.len() && abs[i] == dir[i] {
        if abs[i] == b'/' {
            last = i + 1;
        }
        i += 1;
    }
    let out = buf_new();
    if i == dir.len() && i < abs.len() && abs[i] == b'/' {
        // under the root's directory
        last = i + 1;
    } else if last < dir.len() {
        // one "../" for each component of dir after the common prefix
        // (last <= i: within dir)
        buf_str(out, c"../");
        for k in last..dir.len() {
            if dir[k] == b'/' {
                buf_str(out, c"../");
            }
        }
    }
    buf_bytes(out, &abs[last..]);
    let made = buf_frozen_cstr(out);
    pcx.out_paths[file as usize].store(out, Ordering::Relaxed);
    made
}

// The sources as the tools' cache read them (0.13): buffer `all` holds
// the files as load_sources and add_source lay them out (each followed by
// a newline; after load_sources' last and after each added one a NUL,
// then a newline before the next); `files` their paths, starts, ends, modules and
// kinds, in fives.
pub fn restore_sources(all: i64, files: &[i64], pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < files.len() as i64 {
        pcx.files.push(SourceFile {
            path: (files[i as usize]) as *mut u8,
            start: (files[(i + 1) as usize]),
            end: (files[(i + 2) as usize]),
            module: (files[(i + 3) as usize]),
            kind: (files[(i + 4) as usize]),
        });
        pcx.out_paths.push(Atomic::new(-1));
        i += 5;
    }
    // (0.27.6: a new source set, its region's, as load_sources)
    src_begin(pcx);
    // UNSAFE: the buffer's block read as a slice (buf_raw)
    // SAFETY: all is an id buf_new returned; src_put copies the bytes into
    // the sources' region and writes no buffer (its messages, in buffers
    // of their own, end the compiler), and the view ends when it returns
    unsafe { src_put(buf_raw(all), pcx); }
    src_publish(pcx);
}

// ---- C strings ----

pub fn streq(a: *mut u8, b: *mut u8) -> bool {
    // UNSAFE: two C strings seen as slices (c_bytes)
    // SAFETY: both are NUL-terminated strings (cstr's convention);
    // nothing runs between the views and the comparison, which ends them
    unsafe { c_bytes(a) == c_bytes(b) }
}

// (0.21) A source file's extension: `.vl`, or `.vl` (vole, the name of
// 0.24): its length in s, 0 when s names no source file.
pub fn source_ext_len(s: &[u8]) -> i64 {
    if s.len() > 5 && s[(s.len() as i64 - 5) as usize..] == b".vl" {
        return 5;
    }
    if s.len() > 3 && s[(s.len() as i64 - 3) as usize..] == b".vl" {
        return 3;
    }
    0
}

// (0.21) Whether path p (a C string) names a source file, `.vl` or `.vl`.
pub fn is_source_path(p: *mut u8) -> bool {
    // UNSAFE: a C string seen as a slice (c_bytes)
    // SAFETY: p is a NUL-terminated string (cstr's convention);
    // source_ext_len only reads it, and the view ends when it returns
    unsafe { source_ext_len(c_bytes(p)) > 0 }
}

// UNSAFE: C's setenv, for env_set and env_aliases.
// SAFETY: <stdlib.h>'s prototype (two NUL-terminated strings, which it
// copies, and an int), on macOS and Linux alike.
extern "C" {
    #[link_name = "setenv"]
    fn base_setenv(name: *mut u8, value: *mut u8, overwrite: i32) -> i32;
}

// (0.21) The environment variables the compiler reads, VOLE_ + these
// (tests/run.sh checks that every VOLE_ name in compiler/src is here).
const ENV_NAMES: [*mut u8; 25] = [
    c"CACHE", c"CACHE_CHECK", c"CACHE_LIMIT", c"CACHE_STATS", c"CACHE_SYNC", c"CACHE_TRACE",
    c"CACHE_WHY", c"CC", c"CODE_CACHE", c"COUNTERS", c"FRESH_CONTEXTS", c"INLINE_LOG",
    c"LINKER", c"LINK_CACHE", c"LOWER", c"LSP_TIME", c"OK", c"OVF_CENSUS", c"PHASE_TIMES",
    c"PLANT_MISCOMPILE", c"QUERY_FULL", c"QUERY_STD", c"ROOT", c"SRC_CAP", c"STRESS_GROW"];

// (0.21, for 0.24's name) At start (main): each VOLE_X in the environment
// is copied to VOLE_X, so that it is read as that one, and wins over it;
// the children inherit both.
pub fn env_aliases() {
    for k in 0..ENV_NAMES.len() {
        let name = buf_new();
        buf_str(name, c"VOLE_");
        buf_str(name, ENV_NAMES[k as usize]);
        buf_byte(name, 0);
        if !env_is_set(buf_ptr(name)) {
            continue;
        }
        let value = buf_new();
        buf_bytes(value, &env_var(buf_ptr(name)));
        buf_byte(value, 0);
        // UNSAFE: setenv is C's
        // SAFETY: both are NUL-terminated strings in blocks of their own
        // (each buffer ends with the 0 pushed above and is not written
        // after its pointer is taken); setenv copies them, and no other
        // thread exists yet (main calls this first)
        unsafe { base_setenv(buf_ptr(name), buf_ptr(value), 1); }
    }
}

use std::sync::atomic::{Atomic, Ordering};

// (0.28.0) STRESS_GROW's accessors: every use of it is one of them.
// (0.29) An atomic, Relaxed: stress_grow writes it only while it is -1,
// and every thread that finds -1 writes the same value (the
// environment's), so no order between them matters.
fn get_stress_grow() -> i64 {
    STRESS_GROW.load(Ordering::Relaxed)
}

fn set_stress_grow(v: i64) {
    STRESS_GROW.store(v, Ordering::Relaxed);
}

// (0.28.0) STDOUT_CAPTURE's accessors: every use of it is one of them.
// (0.29) An atomic, Relaxed: written only by volec query (run_query's
// begin_output/end_output, module_context), which starts no thread;
// the threads of a build read its initial -1.
pub fn get_stdout_capture() -> i64 {
    STDOUT_CAPTURE.load(Ordering::Relaxed)
}

pub fn set_stdout_capture(v: i64) {
    STDOUT_CAPTURE.store(v, Ordering::Relaxed);
}

// (0.28.0) SYMS_FROZEN's accessors: every use of it is one of them.
// Atomic, Relaxed: only the main thread reads and writes it (no function a
// worker or the assembler thread runs touches it), so Relaxed orders
// nothing else.
pub fn get_syms_frozen() -> bool {
    SYMS_FROZEN.load(Ordering::Relaxed)
}

pub fn set_syms_frozen(v: bool) {
    SYMS_FROZEN.store(v, Ordering::Relaxed);
}

// (0.28.0) SRC's accessors: every use of it is one of them. (0.29) SRC
// is an atomic pointer to the view (a pointer and a length cannot be
// stored together otherwise): set_src writes the view into a block of
// its own, never freed or written again, and publishes its address, so
// a reader gets one whole view, whichever it is.
pub fn get_src() -> &'static [u8] {
    let view = SRC.load(Ordering::Acquire);
    if view == 0 as *mut &'static [u8] {
        return b"";
    }
    // UNSAFE: the published view read through its address
    // SAFETY: view is a block set_src made and filled with one
    // `&'static [u8]` before it stored the address (Release, read with
    // Acquire); the block is never freed or written again, so the read
    // is of an initialized value that no thread changes
    unsafe { *view }
}

pub fn set_src(v: &'static [u8]) {
    let view = alloc_zeroed(size_of(&'static [u8])) as *mut &'static [u8];
    // UNSAFE: the view written into a new block through its address
    // SAFETY: alloc_zeroed returned a malloc'ed block (aligned for any
    // type) of the view's size, this function's alone until it is
    // published; the write fills it whole, and it is never freed
    unsafe { std::ptr::write(view, v); }
    SRC.store(view, Ordering::Release);
}
