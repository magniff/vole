}

// (0.28.0) ROOT_LEX's accessors: every use of it is one of them.
fn get_root_lex() -> *mut u8 {
    // UNSAFE: the lexical root cache of out_path, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: written and read only in out_path, which a task reaches only
