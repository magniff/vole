// The target selection: the machine and object format being compiled for
// (--target, else the host), read by every phase: the C header importer,
// the lowering and the vectorizers, both code generators, the assembler
// and the object writers, and the tools.
//
// Targets:
//   aarch64-macos  AArch64, Apple's arm64 ABI, Mach-O
//   x86_64-linux   x86-64, System V ABI, ELF (position independent)
//   x86_64-macos   x86-64, System V ABI, Mach-O
//   aarch64-linux  AArch64, the standard AAPCS64, ELF (position
//                  independent) (0.11)

use crate::base::streq;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

pub const T_AARCH64_MACOS: i64 = 1;
pub const T_X86_64_LINUX: i64 = 2;
pub const T_X86_64_MACOS: i64 = 3;
pub const T_AARCH64_LINUX: i64 = 4;

static X86: std::sync::atomic::Atomic<bool> = std::sync::atomic::Atomic::new(false);
static ELF: std::sync::atomic::Atomic<bool> = std::sync::atomic::Atomic::new(false);

pub fn target_name(target: i64) -> *const u8 {
    if target == T_AARCH64_MACOS { return c"aarch64-macos"; }
    if target == T_X86_64_LINUX { return c"x86_64-linux"; }
    if target == T_AARCH64_LINUX { return c"aarch64-linux"; }
    c"x86_64-macos"
}

// The target named `name`, or 0.
pub fn target_of_name(name: *const u8) -> i64 {
    for target in T_AARCH64_MACOS..T_AARCH64_LINUX + 1 {
        if streq(name, target_name(target)) {
            return target;
        }
    }
    0
}

pub fn set_target(target: i64, pcx: &mut Ctx<Comp>) {
    pcx.target = target;
    set_x86(target == T_X86_64_LINUX || target == T_X86_64_MACOS);
    set_elf(target == T_X86_64_LINUX || target == T_AARCH64_LINUX);
    pcx.apple_a64 = target == T_AARCH64_MACOS;
}

// Whether a target is Linux (ELF, glibc).
pub fn target_is_linux(target: i64) -> bool {
    target == T_X86_64_LINUX || target == T_AARCH64_LINUX
}

// (0.30.2, RT-466) The size every stack frame the code generators lay
// out stays below: x86-64 reaches a frame's slots with 32-bit
// displacements (the assembler refuses a wider one), 2 GiB less a page;
// AArch64 reaches any offset through a register, and the bound is where
// a frame's 64-bit offsets, a slot's and an alignment's slack added,
// still stay in i64: 2^63 - 2^32. The frame as written, its body's
// locals, has locals_limit.
pub fn frame_limit() -> i64 {
    if get_x86() { 2147483648 - 4096 } else { (1 << 62) + ((1 << 62) - (1 << 32)) }
}

// (0.30.2, RT-466) The size a function's locals (its body's locals and
// temporaries, places' check_frame) stay below: frame_limit on x86-64;
// on AArch64 2^62 bytes, past any address space. rustc bounds an object
// by 2^61 bytes, not a frame: a frame of two such objects, 2^61 bytes,
// is built, as rustc builds it, and its probes fault as it is entered
// (stack_probe_frame_past_limit); the code generators' own frames (gen0
// copies a repeated array through a slot of its own) have room to
// frame_limit.
pub fn locals_limit() -> i64 {
    if get_x86() { frame_limit() } else { 1 << 62 }
}

// (0.30.2, RT-466) The one growth of a frame's size, which every one
// goes through (the body's locals, take_body's check_frame, to
// locals_limit; gen0's alloc_slot and -O2's layout_frame, to
// frame_limit): `offset`, the frame so far, grown by a slot of `size`
// bytes and `pad` bytes of slack, then rounded up to `align` (a power of
// two). None when the result would reach `limit` (at most frame_limit),
// or an operand is out of range (a negative size: a type's size past
// i64). Each bound is checked before its addition, so no sum wraps (a
// check after adding misses 2^62 + 2^62 + 2^62, which wraps first).
// `unchecked`: VOLE_PLANT_LIMIT=frame's fault (tests only), the
// additions as before 0.30.2, wrapping.
pub fn frame_grow(offset: i64, size: i64, pad: i64, align: i64, limit: i64, unchecked: bool)
    -> Option<i64> {
    if unchecked {
        let sum = offset.wrapping_add(size).wrapping_add(pad);
        return Some(sum.wrapping_add(align - 1) & (0 - align));
    }
    if limit > frame_limit() || offset < 0 || offset >= limit || size < 0 || pad < 0 || align < 1
        || align > (1 << 20) || (align & (align - 1)) != 0 {
        return None;
    }
    if size >= limit - offset {
        return None;
    }
    let grown = offset + size;
    if pad >= limit - grown {
        return None;
    }
    // (below frame_limit + 2^20, under 2^63: no wrap)
    let rounded = (grown + pad + align - 1) & (0 - align);
    if rounded >= limit {
        return None;
    }
    Some(rounded)
}

// (0.30.2, RT-466) A limit (frame_limit, locals_limit) as the
// frame.too_big error says it.
pub fn frame_limit_text(limit: i64) -> &'static str {
    if get_x86() {
        "2 GiB less a page (x86-64 reaches a frame's slots with 32-bit displacements)"
    } else if limit == locals_limit() {
        "2^62 bytes"
    } else {
        "2^63 - 2^32 bytes (where a frame's 64-bit offsets end)"
    }
}

// (0.30.2, RT-466 and RT-47, test-only) VOLE_PLANT_LIMIT's fault
// (Ctx.plant_limit): `frame` 1 (frame_grow adds unchecked), `main` 2
// (main's signature is not checked), unset 0; any other value stops the
// compiler.
pub fn plant_limit_from_env() -> i64 {
    match std::env::var_in("VOLE_PLANT_LIMIT", Comp {}) {
        Ok(v) => {
            let w = v.as_bytes();
            if w == b"frame" { PLANT_FRAME } else if w == b"main" { PLANT_MAIN } else {
                crate::base::die(c"VOLE_PLANT_LIMIT is frame or main");
            }
        }
        Err(_) => 0,
    }
}

// Ctx.plant_limit's faults.
pub const PLANT_FRAME: i64 = 1;
pub const PLANT_MAIN: i64 = 2;

// (0.28.0) X86's accessors: every use of it is one of them. (0.29) An
// atomic, Relaxed, as ELF: written only by set_target, in build before
// compile_program starts any thread (and in query and assemble, which
// start none); the threads only read it.
pub fn get_x86() -> bool {
    X86.load(std::sync::atomic::Ordering::Relaxed)
}

pub fn set_x86(v: bool) {
    X86.store(v, std::sync::atomic::Ordering::Relaxed);
}

// (0.28.0) ELF's accessors: every use of it is one of them. (0.29) An
// atomic, Relaxed: written only by set_target, called by build before
// compile_program starts any thread, and by volec query's front_end
// and volec assemble, which start none; the threads only read it.
pub fn get_elf() -> bool {
    ELF.load(std::sync::atomic::Ordering::Relaxed)
}

pub fn set_elf(v: bool) {
    ELF.store(v, std::sync::atomic::Ordering::Relaxed);
}
