// The target selection: the machine and object format being compiled for
// (--target, else the host), read by every phase: the C header importer,
// the lowering and the vectorizers, both code generators, the assembler
// and the object writers, and the tools.
//
// Targets:
//   aarch64-macos  AArch64, Apple's arm64 ABI, Mach-O
//   x86_64-linux   x86-64, System V ABI, ELF (position independent)
//   x86_64-macos   x86-64, System V ABI, Mach-O
//   aarch64-linux  AArch64, the standard AAPCS64, ELF (position
//                  independent) (0.11)

use crate::base::streq;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

pub const T_AARCH64_MACOS: i64 = 1;
pub const T_X86_64_LINUX: i64 = 2;
pub const T_X86_64_MACOS: i64 = 3;
pub const T_AARCH64_LINUX: i64 = 4;

pub static var X86: bool = false;
pub static var ELF: bool = false;

pub fn target_name(target: i64) -> *u8 {
    if target == T_AARCH64_MACOS { return c"aarch64-macos"; }
    if target == T_X86_64_LINUX { return c"x86_64-linux"; }
    if target == T_AARCH64_LINUX { return c"aarch64-linux"; }
    c"x86_64-macos"
}

// The target named `name`, or 0.
pub fn target_of_name(name: *u8) -> i64 {
    for target in T_AARCH64_MACOS..T_AARCH64_LINUX + 1 {
        if streq(name, target_name(target)) {
            return target;
        }
    }
    0
}

pub fn set_target(target: i64, pcx: inout Ctx<Comp>) {
    pcx.target = target;
    X86 = target == T_X86_64_LINUX || target == T_X86_64_MACOS;
    ELF = target == T_X86_64_LINUX || target == T_AARCH64_LINUX;
    pcx.apple_a64 = target == T_AARCH64_MACOS;
}

// Whether a target is Linux (ELF, glibc).
pub fn target_is_linux(target: i64) -> bool {
    target == T_X86_64_LINUX || target == T_AARCH64_LINUX
}
