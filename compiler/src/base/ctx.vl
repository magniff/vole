    // (0: no cap), base::diag::max_errors_option
    pub max_errors: i64,
    // (0.27.1, places::regions) the variance of each struct's and enum's
    // declared parameters (lifetimes, then types), V_* each: per STRUCTS
    // index s at variance_at[s], per ENUMS index e at variance_at[struct
    // count + e], the first of its words in variances (-1: none); made
    // once, for a rust-edition program (regions::variance_table)
    pub variance_at: IntVec,
    pub variances: IntVec,
    // (0.27.1, front::check::check_mode::coerce_ref) the expression being
    // checked against a rust-edition function's parameter or a `let`'s
    // written type: where R5's leniency is edition.lenient (0: none)
    pub rust_arg: i64,
    // (0.27.7, D3.6a) the expression being checked against a written
    // `*mut T` (a parameter's or a `let`'s type): a `&T` there is E0308
    pub raw_mut_at: i64,
    // (0.27.7, D3.6) the expressions coerced to a written `*mut T` (`*mut
    // [T]`): a `&mut` place there is `&raw mut`, a write; to `*const T`,
    // `&raw const`, a read (places::build::operand)
    pub raw_mut_coerced: IntVec,
    // (0.27.1, front::parser::items::params::parse_where) the lifetime
    // predicates of the last `where` (`'a: 'b`), a holder of TyName nodes
    // as a generics list's (0: none), bound to its function by
    // parse_function (rust::where_key)
    pub lt_where: i64,
    // (0.27.1, places::place_body) the body being built is the rust
    // edition's: an operand of a type that is not Copy moves (D8.3)
    pub rust_body: bool,
    // (0.27.1, front::derive::expand_item) the struct and enum nodes with a
    // `#[derive(Copy)]` in rust-edition code (places::front::rust_copy)
    pub rust_copy: IntVec,
    // (0.27.2) The traits of `#[builtin_impls(P, ..)]` (front::builtin_impls,
    // F15.1): per trait, its node, the attribute's start and end, and the
    // offset of its impls in the made source.
    pub builtin_traits: IntVec,
    // (0.27.2) The rust edition's `char` (F1.1): a distinct type over u32
    // named `char` (front::types::init_declarations); 0 in MVS.
    pub char_type: i64,
    // (0.27.2) The constants of inherent impls (`impl char { const MAX: char
    // = ..; }`, F3.1): per constant, its AssocType node, the impl's self
    // type node and its parameters (0: none).
    pub inherent_consts: IntVec,
    // (0.27.1, places::build::bind_pattern) how many of the patterns being
    // bound match through a reference: their bindings are Rust's `ref`
    // ones (default binding modes), never a move of the referent's part
    pub pat_deref: i64,
    // (0.27.1, front::check::body::check_let) the rust edition's deferred
    // lets, `let x: T;` and `let x;`, two words each: the local, assigned
    // without `mut` (the borrow checker checks the assignments, D8), and
    // the let's position
    pub deferred: IntVec,
    // (0.27.2.1, front::effects, E3.1a) per function, a rust-edition
    // declaration: 0 none, else 1 + where FX_DECL_TPS has its parametric
    // items (a count, then their types); its list resolved, its edges made
    // for a listed parameter (E3.3a), its inferred set I(f)
    pub fx_decl: *mut i64,
    pub fx_decl_tps: IntVec,
    pub fx_decl_e: *mut Effects,
    pub fx_decl_px: *mut Effects,
    pub fx_inferred: *mut Effects,
    // (0.27.2.1, E3.3a) per graph node of a rust program, the part of its
    // set that does not come from a fn value's call, and the part that does
    // (the program's, closed world): what a declaration lets through
    pub fx_fixed: *mut Effects,
    pub fx_dyn: *mut Effects,
    // (0.28.0) `--edition` was on this command line (not VOLE_EDITION, which
    // a parent's flag or the user's shell set): `fix --edition rust ROOT`
    // alone is the translation; a rust program's fix under the env is a fix
    pub edition_flag: bool,
}

// A new context: every field at its static's first value.
pub fn ctx_new() -> Ctx<Comp> {
    Ctx {
        p_topic: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        p_buf: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
