// The compilation context (0.26.5, statics P4): what were the statics of
// base, front, places and the tools, one field each, made once per process
// by main and passed down last as `pcx` (tools/statics/p4-ctx.group,
// `volec fix --only statics`). A field keeps its static's first value and
// lives as long as the process did. The comment above a field names the
// static it was.

use std::alloc::Allocator; use crate::back::codecache::hash::H2;
use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::front::effects::Effects;
use crate::front::modules::lookup::PRELUDE_COUNT;
use crate::front::own::summary::ViewSummary;
use crate::front::types::MethodInfo;
use crate::middle::ctx::FnCtx;
use crate::middle::lower::ssa::HMap;
use crate::places::ir::{PBlock, PLocal, PProj, PStmt};

pub struct Ctx<A: Allocator> {
    // (guide::find::P_TOPIC)
    pub p_topic: IntVec,
    // (guide::find::P_BUF)
    pub p_buf: IntVec,
    // (guide::find::P_START)
    pub p_start: IntVec,
    // (guide::find::P_END)
    pub p_end: IntVec,
    // (guide::find::P_SEC)
