    pub edition: i64,
    // (0.27.0) the edition the command line gave (`--edition`, VOLE_EDITION)
    pub edition_opt: i64,
    // (0.27.0, front::rust::syntax) the lifetimes of the generics or type
    // arguments being parsed; the holder of the last list's (0: none); and
    // the pairs (node, holder) each item or type name got
    pub lt_scratch: IntVec,
    pub lt_last: i64,
    pub lt_items: IntVec,
    // (0.27.2.1: lt_items by key, the index + 1 of its first pair:
    // lifetimes_of, once a scan of std2's thousands)
    pub lt_first: HMap,
    // (0.28.0, outlives_of) per pair of lt_items, the index + 1 of the next
    // pair of its key (0: none); by key, the last pair's index + 1
    pub lt_next: IntVec,
    pub lt_key_last: HMap,
    // (0.27.8, places::regions decl_pairs_of) decl_pairs(t, 0, 0) by type,
    // once: t + 1 -> the index + 1 in decl_pair_store of its pairs' count,
    // which its pairs follow
    pub decl_pair_at: HMap,
    pub decl_pair_store: IntVec,
    // (0.28.0, places::regions sig_of) each function's signature regions,
    // once: f + 1 -> its index + 1 in sig_memo, which holds each of Sig's
    // vectors (its length, then its words) and its two words
    pub sig_memo_at: HMap,
    pub sig_memo: IntVec,
    // (0.27.0, base::diag allow_option) `--allow=CODE`: the codes (and
