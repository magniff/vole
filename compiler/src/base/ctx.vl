    pub legacy_reported: bool,
    // (tools::fixunsafe::FIX_UNSAFE)
    pub fix_unsafe: bool,
    // (tools::fixunsafe::SITES)
    pub sites: Vec<i64, A>,
    // (tools::refactor_mod::USE_AT)
    pub use_at: HMap,
    // (tools::refactor_mod::USE_BIND)
    pub use_bind: HMap,
    // (tools::refactor_mod::local::DECL_POS)
    pub decl_pos: HMap,
    // (tools::lsp::TV)
    pub tv: *mut i64,
    // (tools::edit::E_START)
    pub e_start: IntVec,
    // (tools::edit::E_END)
    pub e_end: IntVec,
    // (tools::edit::E_TEXT)
    pub e_text: IntVec,
    // (tools::fix::MISSING)
