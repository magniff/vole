    pub fn_impl: IntVec,
    // (front::traits::IMPL_EXTRA)
    pub impl_extra: IntVec,
    // (0.28.0, convert::impl_fn) impl_extra by impl and name: key (impl
    // << 32) + name + 1 -> its first index + 1, and its last; beside
    // impl_extra, the next index + 1 of the same key (0: none), in order
    pub impl_extra_first: HMap,
    pub impl_extra_last: HMap,
    pub impl_extra_next: IntVec,
    // (0.28.0, convert::impls_naming) by name, the impls that may have a
    // function of that name (their own or a copied default): name + 1 ->
    // the first cell + 1 of name_cells (pairs: impl, next cell + 1), and
    // its last; made for name_impls impls and name_extra copies
    pub name_first: HMap,
    pub name_last: HMap,
    pub name_cells: IntVec,
    pub name_impls: i64,
    pub name_extra: i64,
