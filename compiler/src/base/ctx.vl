    // (front::traits::IMPLS)
    pub traits_impls: Vec<crate::front::traits::ImplInfo, A>,
    // (0.27.2) The `where` predicates on other subjects than a parameter
    // (front-rust.md F10.1), and the item the parser is reading one for.
    pub where_preds: Vec<crate::front::traits::WherePred, A>,
    // (0.27.2.1: WHERE_PREDS by owner, traits::wp_push: the first and last
    // index + 1 of an owner's, each one's next + 1)
    pub wp_first: HMap,
    pub wp_last: HMap,
    pub wp_next: IntVec,
    // (0.27.2.1: TRAITS_IMPLS by trait, traits::collect_impl: the first
