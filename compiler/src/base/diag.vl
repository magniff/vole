// Diagnostics: errors at a source position, as the parser and the checker
// report them; several errors per run, through recovery points; warnings;
// the short one-line form of --diagnostics=short; and the names whose
// declaration failed (their uses are not reported again).

use crate::base::{
    IntVec, STDERR, STDOUT, _longjmp, alloc_zeroed, buf_append, buf_byte, buf_bytes, buf_clear,
    buf_copy, buf_fmt, buf_int, buf_len, buf_new, buf_str, buf_write_fd, cstr, get_src, intern,
    intern_buf, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::json::{get_diag_json, json_diagnostic};
use crate::base::term::{build_failed_errors, rich_diagnostic};
use crate::front::generics::instantiate::instantiation_notes;
use crate::front::modules::file_made;
use crate::front::stdsrc_rust::std2_line_marks;

// ---- Errors at a source position ----

// Starts an error message at `pos`; finish it with err_* and err_end.
pub fn err_begin(pos: i64, pcx: &mut Ctx<Comp>) {
    if pcx.err < 0 {
        pcx.err = buf_new();
        pcx.err_help = buf_new();
        pcx.err_try = buf_new();
        pcx.err_note = buf_new();
    }
    buf_clear(pcx.err);
    buf_clear(pcx.err_help);
    buf_clear(pcx.err_try);
    buf_clear(pcx.err_note);
    pcx.err_pos = pos;
    set_err_poisoned(false);
    pcx.err_fix_start = -1;
    pcx.err_fixable = false;
}

// The position of the error being made.
pub fn err_pos(pcx: &Ctx<Comp>) -> i64 {
    pcx.err_pos
}

// (0.25.3) A note of the error about position pos (the `let` whose
// literals gave a value its type): `  = note: FILE:L:C: text`.
pub fn err_note_at(pos: i64, text: &[u8], pcx: &mut Ctx<Comp>) {
    buf_position(pcx.err_note, pos, pcx);
    buf_bytes(pcx.err_note, b": ");
    buf_bytes(pcx.err_note, text);
    buf_byte(pcx.err_note, b'\n');
}

// ---- Several errors (0.5) ----
//
// The parser and the checker set recovery points (around an item, a
// statement, a function's body): an error is recorded, and the work goes
// on after the innermost recovery point, which skips what failed. At the
// end of a phase that had errors, they are all printed, sorted by
// position, and the compiler exits with 1. An error whose message names
// the error type (the type given to what failed, see TY_ERROR) follows
// from an earlier one and is not reported. (0.10) The phases go on after
// errors (the checker after the parser's); an error whose caller makes do
// without jumping is recorded by err_end_soft.
//
// A recovery point:
//     let depth = RECOVER_DEPTH;
//     if _setjmp(recover_enter()) == 0 {
//         ... work that may fail ...
//     } else {
//         ... clean up after a failure ...
//     }
//     recover_leave(depth);
// (_setjmp must be called by the function that goes on after the jump,
// and that function must not return in between: the work is a call
// followed by more code, never a tail call.)

// Whether the message being made names the error type.
static ERR_POISONED: std::sync::atomic::Atomic<bool> = std::sync::atomic::Atomic::new(false);

pub fn recover_enter(pcx: &mut Ctx<Comp>) -> *mut u8 {
    if pcx.recover_bufs.len() as i64 <= pcx.recover_depth {
        pcx.recover_bufs.push(alloc_zeroed(512) as i64);
    }
    let jb = (pcx.recover_bufs[pcx.recover_depth as usize]) as *mut u8;
    pcx.recover_depth += 1;
    jb
}

pub fn recover_leave(depth: i64, pcx: &mut Ctx<Comp>) {
    pcx.recover_depth = depth;
}

// ---- Warnings (0.9) ----
//
// A warning is printed like an error, `warning[<kind>]: ...`, and does not
// fail the compilation; each (position, message) once, however often the
// checker meets it (a generic function is checked per instance), in
// position order, at most MAX_WARNINGS of them. `--deny-warnings` makes
// every warning an error.

const MAX_WARNINGS: i64 = 50;

// Records a warning (or, with --deny-warnings, an error) at `pos`; `key`
// tells warnings at one position apart.
pub fn report_warning(pos: i64, key: i64, kind: *mut u8, message: *mut u8, help: *mut u8,
    pcx: &mut Ctx<Comp>) {
    if pcx.allowed.len() as i64 > 0 && allowed(kind, pcx) {
        return;
    }
    // (0.29) `--deny=CODE`: an error, as any other
    let listed = !pcx.deny_warnings && pcx.denied.len() as i64 > 0 && denied(&cstr(kind), pcx);
    if listed {
        if error_keyed(pos, key, pcx) || pcx.error_count >= pcx.max_errors {
            return;
        }
    } else {
        let mut i: i64 = 0;
        while i < pcx.warnings.len() as i64 {
            if (pcx.warnings[i as usize]) == pos
                && (pcx.warnings[(i + 2) as usize]) == key {
                return;
            }
            i += 3;
        }
    }
    let out = buf_new();
    buf_str(out, if pcx.deny_warnings || listed { c"error[" } else { c"warning[" });
    buf_fmt(out,
        format_args("{}]: {}\n --> ", str::from_utf8(&cstr(kind)).unwrap(),
            str::from_utf8(&cstr(message)).unwrap()));
    buf_position(out, pos, pcx);
    buf_byte(out, b'\n');
    if help != 0 as *mut u8 {
        buf_fmt(out, format_args("  = help: {}\n", str::from_utf8(&cstr(help)).unwrap()));
    }
    if listed {
        pcx.errors.push(pos);
        pcx.errors.push(out);
        pcx.error_count += 1;
        return;
    }
    pcx.warnings.push(pos);
    pcx.warnings.push(out);
    pcx.warnings.push(key);
    if pcx.deny_warnings && pcx.error_count < pcx.max_errors {
        pcx.errors.push(pos);
        pcx.errors.push(out);
        pcx.error_count += 1;
    }
}

// (0.27.0) `--max-errors=N`: a check stops after N errors, not 50 (0: it
// does not stop). False when arg is not that option.
pub fn max_errors_option(arg: &str, pcx: &mut Ctx<Comp>) -> bool {
    if !arg.starts_with("--max-errors=") {
        return false;
    }
    let mut n: i64 = 0;
    let digits = &arg.as_bytes()["--max-errors=".len()..];
    if digits.len() == 0 {
        crate::base::die2(c"--max-errors=N takes a number: ", c"(none)");
    }
    for &c in digits {
        if c < b'0' || c > b'9' || n > 100000000 {
            crate::base::die2(c"--max-errors=N takes a number: ", crate::cli::c_of(arg));
        }
        n = n * 10 + (c - b'0') as i64;
    }
    pcx.max_errors = if n == 0 { 9223372036854775807 } else { n };
    true
}

// (0.27.0) `--allow=CODE[,CODE...]`, rustc's `-A`, repeatable: a warning
// of that code, or of that family (`--allow=borrowck`: every
// `borrowck.*`), is not reported. False when arg is not that option.
pub fn allow_option(arg: &str, pcx: &mut Ctx<Comp>) -> bool {
    if !arg.starts_with("--allow=") {
        return false;
    }
    let list = &arg.as_bytes()["--allow=".len()..];
    let mut from: usize = 0;
    for i in 0..list.len() + 1 {
        if i == list.len() || list[i] == b',' {
            if i > from {
                let b = buf_new();
                buf_bytes(b, &list[from..i]);
                pcx.allowed.push(b);
            }
            from = i + 1;
        }
    }
    true
}

// (0.29) `--deny=CODE[,CODE...]`, rustc's `-D`, repeatable: a warning of
// that code, or of that family (`--deny=unsafe`: every `unsafe.*`), is an
// error, and `volec check` reports each one where it is (unsafe.unjustified
// is else one line with a count past five sites; unsafe.unneeded is
// reported only when denied). False when arg is not that option.
pub fn deny_option(arg: &str, pcx: &mut Ctx<Comp>) -> bool {
    if !arg.starts_with("--deny=") {
        return false;
    }
    let list = &arg.as_bytes()["--deny=".len()..];
    let mut from: usize = 0;
    for i in 0..list.len() + 1 {
        if i == list.len() || list[i] == b',' {
            if i > from {
                let b = buf_new();
                buf_bytes(b, &list[from..i]);
                pcx.denied.push(b);
            }
            from = i + 1;
        }
    }
    true
}

// Whether a warning of code `kind` is denied (`--deny`): its code or its
// family is listed.
pub fn denied(kind: &[u8], pcx: &Ctx<Comp>) -> bool {
    listed(pcx.denied.as_slice(), kind)
}

// Whether the code `kind`, or its family (what is before its first `.`
// or any later one), is one of `codes`, a buffer each (allow_option's,
// deny_option's).
fn listed(codes: &[i64], kind: &[u8]) -> bool {
    for &b in codes {
        let d = buf_copy(b);
        let n = d.len();
        if kind.len() >= n && &kind[0..n] == d.as_slice()
            && (kind.len() == n || kind[n] == b'.') {
            return true;
        }
    }
    false
}

// Whether a warning of code `kind` is allowed (`--allow`): its code or
// its family is listed.
fn allowed(kind: *mut u8, pcx: &Ctx<Comp>) -> bool {
    listed(pcx.allowed.as_slice(), &cstr(kind))
}

// Whether an error of kind `key` at `pos` was reported; records it if not
// (an unsafe operation is reported once per place).
pub fn error_keyed(pos: i64, key: i64, pcx: &mut Ctx<Comp>) -> bool {
    let mut i: i64 = 0;
    while i < pcx.keyed_errors.len() as i64 {
        if (pcx.keyed_errors[i as usize]) == pos
            && (pcx.keyed_errors[(i + 1) as usize]) == key {
            return true;
        }
        i += 2;
    }
    pcx.keyed_errors.push(pos);
    pcx.keyed_errors.push(key);
    false
}

// An error that does not stop the check (an unsafe operation), once per
// position and key; `fix`, when not empty, is the `volec` command
// (arguments, the root after them) of its `try:` line.
pub fn report_error_once(pos: i64, key: i64, kind: *mut u8, message: *mut u8, help: *mut u8,
    fix: &[u8], pcx: &mut Ctx<Comp>) {
    if error_keyed(pos, key, pcx) {
        return;
    }
    if pcx.error_count >= pcx.max_errors {
        return;
    }
    let out = buf_new();
    buf_fmt(out,
        format_args("error[{}]: {}\n --> ", str::from_utf8(&cstr(kind)).unwrap(),
            str::from_utf8(&cstr(message)).unwrap()));
    buf_position(out, pos, pcx);
    buf_byte(out, b'\n');
    if help != 0 as *mut u8 {
        buf_fmt(out, format_args("  = help: {}\n", str::from_utf8(&cstr(help)).unwrap()));
    }
    if fix.len() > 0 {
        buf_str(out, c"  = try: ");
        buf_tool_command(out, fix, true, pcx);
        buf_byte(out, b'\n');
    }
    pcx.errors.push(pos);
    pcx.errors.push(out);
    pcx.error_count += 1;
}

// report_error_once (or, when `warning`, report_warning) with `tries`:
// `try:` lines, each a whole command, separated by '\n' (the own pass's,
// built before the message is recorded); each is printed as its own
// `  = try:` line.
pub fn report_error_tries(pos: i64, key: i64, kind: *mut u8, message: *mut u8, help: *mut u8,
    tries: &[u8], warning: bool, pcx: &mut Ctx<Comp>) {
    // (0.29) `--deny=CODE`: an error, as any other
    let warning = warning
        && (pcx.deny_warnings || pcx.denied.len() as i64 == 0 || !denied(&cstr(kind), pcx));
    if warning {
        let mut i: i64 = 0;
        while i < pcx.warnings.len() as i64 {
            if (pcx.warnings[i as usize]) == pos
                && (pcx.warnings[(i + 2) as usize]) == key {
                return;
            }
            i += 3;
        }
    } else if error_keyed(pos, key, pcx) || pcx.error_count >= pcx.max_errors {
        return;
    }
    let out = buf_new();
    if warning {
        buf_str(out, if pcx.deny_warnings { c"error[" } else { c"warning[" });
    } else {
        buf_str(out, c"error[");
    }
    buf_fmt(out,
        format_args("{}]: {}\n --> ", str::from_utf8(&cstr(kind)).unwrap(),
            str::from_utf8(&cstr(message)).unwrap()));
    buf_position(out, pos, pcx);
    buf_byte(out, b'\n');
    if help != 0 as *mut u8 {
        buf_fmt(out, format_args("  = help: {}\n", str::from_utf8(&cstr(help)).unwrap()));
    }
    put_try_lines(out, tries);
    if warning {
        pcx.warnings.push(pos);
        pcx.warnings.push(out);
        pcx.warnings.push(key);
        if !pcx.deny_warnings || pcx.error_count >= pcx.max_errors {
            return;
        }
    }
    pcx.errors.push(pos);
    pcx.errors.push(out);
    pcx.error_count += 1;
}

// Each line of `tries` (separated by '\n') as `  = try: LINE`.
pub fn put_try_lines(out: i64, tries: &[u8]) {
    let mut i: i64 = 0;
    while i < tries.len() as i64 {
        let mut e = i;
        while e < tries.len() as i64 && tries[e as usize] != b'\n' {
            e += 1;
        }
        if e > i {
            buf_str(out, c"  = try: ");
            buf_bytes(out, &tries[i as usize..e as usize]);
            buf_byte(out, b'\n');
        }
        i = e + 1;
    }
}

// Prints the recorded warnings (not with --deny-warnings: they are
// errors), sorted by position, and forgets them.
pub fn flush_warnings(pcx: &mut Ctx<Comp>) {
    let n = pcx.warnings.len() as i64 / 3;
    if n == 0 || pcx.deny_warnings {
        return;
    }
    for i in 1..n {
        let mut j = i;
        while j > 0
            && (pcx.warnings[(3 * (j - 1)) as usize])
            > (pcx.warnings[(3 * j) as usize]) {
            for k in 0..3 {
                let t = (pcx.warnings[(3 * j + k) as usize]);
                (pcx.warnings[(3 * j + k) as usize]) = (
                    pcx.warnings[(3 * (j - 1) + k) as usize]);
                (pcx.warnings[(3 * (j - 1) + k) as usize]) = t;
            }
            j -= 1;
        }
    }
    let out = buf_new();
    let shown = if n < MAX_WARNINGS { n } else { MAX_WARNINGS };
    for i in 0..shown {
        put_diagnostic(out, (pcx.warnings[(3 * i) as usize]),
            &buf_copy((pcx.warnings[(3 * i + 1) as usize])), pcx);
        pcx.warnings_shown += 1;
    }
    if n > shown {
        buf_fmt(out, format_args("warning: {} more warnings not shown\n", n - shown));
    }
    buf_write_fd(out, STDERR);
    pcx.warnings.clear();
}

// ---- The success line (0.18.1) ----
//
// `check` and a build that find no error end with one line on stderr,
// `ok: 0 errors in main.vl` or `ok: built prog`: in the 0.18 eval the
// agents could not tell an empty answer from a silent failure (22 of 90
// debriefs) and checked again. Not with --json; not in a volec that
// another one runs (the tools' own checks and builds: VOLEC_NESTED,
// which ok_line_setup sets for the children); not with VOLE_OK=0.

// Reads the environment, once, at the start (main), and marks it for the
// volec processes this one starts.
pub fn ok_line_setup(pcx: &mut Ctx<Comp>) {
    let off = crate::base::env_var(c"VOLE_OK");
    pcx.nested = crate::base::env_is_set(c"VOLEC_NESTED");
    pcx.ok_line = !pcx.nested && !(off.len() == 1 && off[0] == b'0');
    crate::base::env_set(c"VOLEC_NESTED", c"1");
    // (0.25.5) The tag of the edit copies of this process and the
    // volecs it starts (tools/edit/apply.vl, copy_path): the first
    // volec's pid, inherited, so that two edits in one tree at once do
    // not read each other's copies (feedbacks/table254.md #2). Kept in
    // a frozen buffer, a C string for the process.
    let b = crate::base::buf_new();
    let given = crate::base::env_is_set(c"VOLEC_EDIT_TAG");
    if given {
        buf_bytes(b, &crate::base::env_var(c"VOLEC_EDIT_TAG"));
    } else {
        crate::base::buf_int(b, (std::process::id() as i32) as i64);
    }
    crate::base::buf_byte(b, 0);
    crate::base::buf_freeze(b);
    pcx.edit_tag = crate::base::buf_ptr(b);
    if !given {
        crate::base::env_set(c"VOLEC_EDIT_TAG", pcx.edit_tag);
    }
}

// The warnings recorded and not printed yet.
pub fn warning_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.warnings.len() as i64 / 3
}

// `ok: WHAT` on stderr, when the success line is wanted.
pub fn print_ok(what: &[u8], pcx: &Ctx<Comp>) {
    if !pcx.ok_line || get_diag_json() {
        return;
    }
    let out = buf_new();
    buf_bytes(out, b"ok: ");
    buf_bytes(out, what);
    buf_byte(out, b'\n');
    buf_write_fd(out, STDERR);
}

// Back to the recovery point `env` (a block _setjmp filled).
fn jump_back(env: *mut u8) -> ! {
    // UNSAFE: _longjmp is C's: the stack is cut back to the frame that
    // called _setjmp
    // SAFETY: env is a block of 512 bytes (alloc_zeroed: more than a
    // jmp_buf) that _setjmp filled in a frame still on the stack: the
    // callers pass the entry of pcx.recover_bufs at recover_depth - 1,
    // which recover_enter gave to a _setjmp whose function has not
    // returned (it lowers recover_depth, recover_leave, before it
    // does), or pcx.err_bail, set and cleared by the function that
    // calls _setjmp on it (edit's run_check, query's load_program,
    // lsp's parses). The frames
    // cut hold no value whose drop is needed: a buffer or a Vec of
    // theirs is left as it is, never freed twice
    unsafe { _longjmp(env, 1) }
}

// Prints the recorded errors and exits with 1, if there are any.
pub fn exit_if_errors(pcx: &mut Ctx<Comp>) {
    if pcx.error_count == 0 {
        return;
    }
    if pcx.err_bail != 0 as *mut u8 {
        jump_back(pcx.err_bail);
    }
    // (0.27.3: a build that read std2 lazily is made again with it whole,
    // front/modules/std2lazy.vl)
    if crate::front::modules::std2lazy::dropped() > 0 {
        crate::front::modules::std2lazy::rerun_eager(pcx.nested);
    }
    write_errors(pcx);
    build_failed_errors(pcx.error_count, pcx);
    crate::base::exit_now(1);
}

// Prints the recorded errors (and the warnings), sorted by position.
pub fn write_errors(pcx: &mut Ctx<Comp>) {
    flush_warnings(pcx);
    sort_errors(pcx);
    let n = pcx.errors.len() as i64 / 2;
    let out = buf_new();
    for i in 0..n {
        put_diagnostic(out, (pcx.errors[(2 * i) as usize]),
            &buf_copy((pcx.errors[(2 * i + 1) as usize])), pcx);
    }
    if pcx.error_count >= pcx.max_errors {
        buf_fmt(out,
            format_args(
                "error: too many errors; stopping after {} (--max-errors=N: more, 0: all)\n",
                pcx.max_errors));
    }
    buf_write_fd(out, STDERR);
}

// The number of errors recorded.
// The number of errors recorded, and forgetting the errors recorded
// since (0.11: a rewrite's pattern is parsed after the program, and its
// syntax error is not the program's).
pub fn errors_mark(pcx: &Ctx<Comp>) -> i64 {
    pcx.errors.len() as i64
}

pub fn errors_forget(mark: i64, pcx: &mut Ctx<Comp>) {
    pcx.errors.truncate(mark);
    // (0.29: the keys are record_error's, two an error; errors given
    // back or held have none, so there may be fewer keys than errors:
    // those stay, and no key of a forgotten error comes back)
    if mark < pcx.error_keys.len() as i64 {
        pcx.error_keys.truncate(mark);
    }
    pcx.error_count = mark / 2;
}

pub fn error_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.error_count
}

// RULE: D4.4 (e) (0.27.6) The errors recorded since mark (errors_mark;
// count the error count then) moved to held, as (tag, position, text)
// triples: recorded no more until error_give_back.
pub fn errors_hold(mark: i64, count: i64, tag: i64, held: &mut Vec<i64, Comp>,
    pcx: &mut Ctx<Comp>) {
    let mut i = mark;
    while i + 1 < pcx.errors.len() as i64 {
        held.push(tag);
        held.push(pcx.errors.get(i));
        held.push(pcx.errors.get(i + 1));
        i += 2;
    }
    pcx.errors.truncate(mark);
    pcx.error_count = count;
}

// An error errors_hold moved, recorded again (its position and text).
pub fn error_give_back(pos: i64, text: i64, pcx: &mut Ctx<Comp>) {
    pcx.errors.push(pos);
    pcx.errors.push(text);
    pcx.error_count += 1;
}

// (0.25.2) Whether an error at pos is among the ones recorded (not one a
// speculative check forgot: errors_forget).
pub fn error_recorded_at(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let mut i: i64 = 0;
    while i < pcx.errors.len() as i64 {
        if ((pcx.errors[i as usize])) == pos {
            return true;
        }
        i += 2;
    }
    false
}

// The recorded errors and warnings, for the tools' cache (0.13): the
// errors' (position, text) pairs and the warnings' (position, text, key)
// triples, the texts as buffers, into `errors` and `warnings`; returns the
// number of errors.
pub fn diag_records(errors: &mut Vec<i64, Comp>, warnings: &mut Vec<i64, Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    for x in pcx.errors.items() {
        errors.push(x);
    }
    for x in pcx.warnings.items() {
        warnings.push(x);
    }
    pcx.error_count
}

// The errors and warnings diag_records gave, recorded again.
pub fn diag_restore(errors: &[i64], warnings: &[i64], count: i64, pcx: &mut Ctx<Comp>) {
    for &x in errors {
        pcx.errors.push(x);
    }
    for &x in warnings {
        pcx.warnings.push(x);
    }
    pcx.error_count = count;
}

// The first error (by position) in the short form, without its help and
// notes, and without a newline (`volec query`, 0.11).
pub fn first_error_short(out: i64, pcx: &mut Ctx<Comp>) {
    if pcx.errors.len() as i64 == 0 {
        return;
    }
    sort_errors(pcx);
    short_diagnostic(out, &buf_copy((pcx.errors[1])), tails: false);
}

// Every recorded error in the short form, one per line, sorted by
// position (0.11: what an edit is checked against).
pub fn errors_short(out: i64, pcx: &mut Ctx<Comp>) {
    sort_errors(pcx);
    let n = pcx.errors.len() as i64 / 2;
    for i in 0..n {
        short_diagnostic(out, &buf_copy((pcx.errors[(2 * i + 1) as usize])),
            tails: true);
        buf_byte(out, b'\n');
    }
}

// Diagnostic `text` (in the human form) at pos as it is printed (0.25.3:
// on a terminal, base::term's form).
fn put_diagnostic(out: i64, pos: i64, text: &[u8], pcx: &mut Ctx<Comp>) {
    if get_diag_json() {
        json_diagnostic(out, text);
    } else if pcx.diag_short {
        short_diagnostic(out, text, tails: true);
        buf_byte(out, b'\n');
    } else if pcx.rich {
        rich_diagnostic(out, pos, text, pcx);
    } else {
        buf_bytes(out, text);
    }
}

// (0.25.3) One diagnostic (`text`, in the human form, at pos: -1 for
// none) on stderr now, as the recorded ones are printed: a link's error.
pub fn print_diagnostic(pos: i64, text: &[u8], pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    put_diagnostic(out, pos, text, pcx);
    buf_write_fd(out, STDERR);
}

// (0.25.3) The recorded errors at positions from..to (a file's), for the
// summary on a terminal.
pub fn errors_in(from: i64, to: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < pcx.errors.len() as i64 {
        let pos = (pcx.errors[i as usize]);
        if pos >= from && pos < to {
            n += 1;
        }
        i += 2;
    }
    n
}

// The one-line form of diagnostic `text`: its position first, then its
// head (`error[kind] message`), then (with `tails`) its help and notes.
pub fn short_diagnostic(out: i64, text: &[u8], tails: bool) {
    // The lines of text: the head, ` --> position`, `  = help: ...`.
    let mut head_end: i64 = 0;
    while head_end < text.len() as i64 && text[head_end as usize] != b'\n' {
        head_end += 1;
    }
    let mut i = head_end + 1;
    let mut pos_from: i64 = -1;
    let mut pos_to: i64 = -1;
    let mut rest = i;
    if i + 5 <= text.len() as i64 && text[i as usize] == b' ' && text[(i + 1) as usize] == b'-'
        && text[(i + 2) as usize] == b'-'
        && text[(i + 3) as usize] == b'>' {
        pos_from = i + 5;
        while i < text.len() as i64 && text[i as usize] != b'\n' {
            i += 1;
        }
        pos_to = i;
        rest = i + 1;
    }
    if pos_from >= 0 {
        put_short_positions(out, &text[pos_from as usize..pos_to as usize]);
        buf_str(out, c": ");
    }
    // `error[kind]: message` -> `error[kind] message`
    let head = &text[0..head_end as usize];
    let mut k: i64 = 0;
    while k + 2 < head.len() as i64
        && !(head[k as usize] == b']' && head[(k + 1) as usize] == b':'
            && head[(k + 2) as usize] == b' ') {
        k += 1;
    }
    if k + 2 < head.len() as i64 && head[0] != b' ' {
        buf_bytes(out, &head[0..(k + 1) as usize]);
        put_short_positions(out, &head[(k + 2) as usize..]);
    } else {
        put_short_positions(out, head);
    }
    if !tails {
        return;
    }
    i = rest;
    while i < text.len() as i64 {
        let mut e = i;
        while e < text.len() as i64 && text[e as usize] != b'\n' {
            e += 1;
        }
        let mut a = i;
        while a < e && (text[a as usize] == b' ' || text[a as usize] == b'=') {
            a += 1;
        }
        if a < e {
            buf_str(out, c" | ");
            put_short_positions(out, &text[a as usize..e as usize]);
        }
        i = e + 1;
    }
}

// Text s with each `<file>: line <l>, column <c>` as `<file>:<l>:<c>` (and
// `<file>: line <l>` as `<file>:<l>`).
pub fn put_short_positions(out: i64, s: &[u8]) {
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        if i + 7 <= s.len() as i64 && s[i as usize] == b':' && s[(i + 1) as usize] == b' '
            && s[(i + 2) as usize] == b'l' && s[(i + 3) as usize] == b'i'
            && s[(i + 4) as usize] == b'n' && s[(i + 5) as usize] == b'e'
            && s[(i + 6) as usize] == b' ' {
            let mut j = i + 7;
            while j < s.len() as i64 && s[j as usize] >= b'0' && s[j as usize] <= b'9' {
                j += 1;
            }
            if j > i + 7 {
                buf_fmt(out,
                    format_args(":{}", &str::from_utf8(s[(i + 7) as usize..j as usize]).unwrap()));
                // `, column <c>`
                if j + 9 < s.len() as i64 && s[j as usize] == b',' && s[(j + 1) as usize] == b' '
                    && s[(j + 2) as usize] == b'c'
                    && s[(j + 8) as usize] == b' ' {
                    let mut c = j + 9;
                    while c < s.len() as i64 && s[c as usize] >= b'0' && s[c as usize] <= b'9' {
                        c += 1;
                    }
                    if c > j + 9 {
                        buf_fmt(out,
                            format_args(":{}",
                                &str::from_utf8(s[(j + 9) as usize..c as usize]).unwrap()));
                        j = c;
                    }
                }
                i = j;
                continue;
            }
        }
        buf_byte(out, s[i as usize]);
        i += 1;
    }
}

// Edit distance of a and b: insertions, deletions, substitutions and
// transpositions of neighbours (optimal string alignment), each 1.
pub fn edit_distance(a: &[u8], b: &[u8]) -> i64 {
    let n = b.len() + 1;
    let mut before: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut prev: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut cur: Vec<i64, Comp> = Vec::new_in(Comp {});
    before.resize(n, 0);
    cur.resize(n, 0);
    for j in 0..n {
        prev.push(j as i64);
    }
    for i in 1..a.len() + 1 {
        cur[0] = i as i64;
        for j in 1..n {
            let cost: i64 = if a[i - 1] == b[j - 1] { 0 } else { 1 };
            let mut best = prev[j - 1] + cost;
            if prev[j] + 1 < best {
                best = prev[j] + 1;
            }
            if cur[j - 1] + 1 < best {
                best = cur[j - 1] + 1;
            }
            if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]
                && before[j - 2] + 1 < best {
                best = before[j - 2] + 1;
            }
            cur[j] = best;
        }
        for j in 0..n {
            before[j] = prev[j];
            prev[j] = cur[j];
        }
    }
    prev[b.len()]
}

// Sorts the recorded errors by position (stable: an insertion sort of the
// pairs).
fn sort_errors(pcx: &mut Ctx<Comp>) {
    let n = pcx.errors.len() as i64 / 2;
    for i in 1..n {
        let mut j = i;
        while j > 0
            && (pcx.errors[(2 * (j - 1)) as usize])
            > (pcx.errors[(2 * j) as usize]) {
            let pos = (pcx.errors[(2 * j) as usize]);
            let text = (pcx.errors[(2 * j + 1) as usize]);
            (pcx.errors[(2 * j) as usize]) = (pcx.errors[(2 * (j - 1)) as usize]);
            (pcx.errors[(2 * j + 1) as usize]) = (pcx.errors[(2 * (j - 1) + 1) as usize]);
            (pcx.errors[(2 * (j - 1)) as usize]) = pos;
            (pcx.errors[(2 * (j - 1) + 1) as usize]) = text;
            j -= 1;
        }
    }
}

// Text for the error's help line.
pub fn err_help(s: *mut u8, pcx: &Ctx<Comp>) {
    buf_str(pcx.err_help, s);
}

pub fn err_help_sym(sym: i64, pcx: &Ctx<Comp>) {
    buf_bytes(pcx.err_help, sym_text(sym, pcx));
}

pub fn err_str(s: *mut u8, pcx: &Ctx<Comp>) {
    buf_str(pcx.err, s);
}

pub fn err_sym(sym: i64, pcx: &Ctx<Comp>) {
    buf_bytes(pcx.err, sym_text(sym, pcx));
}

pub fn err_int(value: i64, pcx: &Ctx<Comp>) {
    buf_int(pcx.err, value);
}

// (0.16) Appends x's Display to the error, an f-string above all:
// `err_fmt(f"'{sym_text(name)}' takes {n} arguments")`.
pub fn err_fmt<T: std::fmt::Display>(x: T, pcx: &Ctx<Comp>) {
    buf_fmt(pcx.err, x);
}

// The same for the help line.
pub fn err_help_fmt<T: std::fmt::Display>(x: T, pcx: &Ctx<Comp>) {
    buf_fmt(pcx.err_help, x);
}

// (0.17) A `try:` line of the error: code or a command to use as it is.
pub fn err_try(s: *mut u8, pcx: &Ctx<Comp>) {
    if buf_len(pcx.err_try) > 0 {
        buf_byte(pcx.err_try, b'\n');
    }
    buf_str(pcx.err_try, s);
}

// The same, x's Display (an f-string).
pub fn err_try_fmt<T: std::fmt::Display>(x: T, pcx: &Ctx<Comp>) {
    if buf_len(pcx.err_try) > 0 {
        buf_byte(pcx.err_try, b'\n');
    }
    buf_fmt(pcx.err_try, x);
}

// A `try:` line that runs the compiler: `volec ARGS` (the compiler as
// it was run), then ` ROOT` when `with_root` (the program's root file, as
// positions print it).
pub fn err_try_tool(args: &[u8], with_root: bool, pcx: &Ctx<Comp>) {
    if buf_len(pcx.err_try) > 0 {
        buf_byte(pcx.err_try, b'\n');
    }
    buf_tool_command(pcx.err_try, args, with_root, pcx);
}

// `volec ARGS [ROOT]` into out (see err_try_tool).
pub fn buf_tool_command(out: i64, args: &[u8], with_root: bool, pcx: &Ctx<Comp>) {
    if pcx.diag_prog == 0 as *mut u8 {
        buf_str(out, c"volec");
    } else {
        buf_str(out, pcx.diag_prog);
    }
    buf_byte(out, b' ');
    buf_bytes(out, args);
    if with_root {
        // (the first file read that is not std's or a C header's)
        let mut f: i64 = 0;
        while f < pcx.files.len() as i64 && file_made(f, pcx) {
            f += 1;
        }
        if f < pcx.files.len() as i64 {
            buf_byte(out, b' ');
            buf_bytes(out, plain(crate::base::source_path(f, pcx)));
        }
    }
}

// ---- Suggested fixes (0.18) ----
//
// An error whose fix the compiler knows exactly: the text that replaces a
// range of the source (the one name a did-you-mean offers, a conversion,
// a `use` line's path, a Rust label respelled, ...), or the `use` line or
// the `pub` that `volec fix` adds (its own tables: tools/fix). Such an
// error prints `try: volec fix --suggested ROOT`, which makes them all
// in one checked edit.

// The error being made is fixed by replacing SRC[start..end) with text
// (an insertion when start == end). Not in std's or a C header's text.
pub fn err_fix(start: i64, end: i64, text: &[u8], pcx: &mut Ctx<Comp>) {
    if start < 0 || end < start || end > pcx.src_len
        || file_made(file_at(start, pcx), pcx) {
        return;
    }
    if &get_src()[start as usize..end as usize] == text {
        return;
    }
    if pcx.err_fix_text < 0 {
        pcx.err_fix_text = buf_new();
    }
    buf_clear(pcx.err_fix_text);
    buf_bytes(pcx.err_fix_text, text);
    pcx.err_fix_start = start;
    pcx.err_fix_end = end;
    pcx.err_fixable = true;
}

// (0.26.2) Whether the error being made has its fix already.
pub fn err_has_fix(pcx: &Ctx<Comp>) -> bool {
    pcx.err_fixable
}

// The error being made is fixed by renaming the first whole word `old`
// from position `from` on (before the end of its statement) to `new`.
pub fn err_fix_word(from: i64, old: &[u8], new: &[u8], pcx: &mut Ctx<Comp>) {
    if old.len() == 0 || from < 0 {
        return;
    }
    let stop = if from + 1000 < pcx.src_len { from + 1000 } else { pcx.src_len };
    let mut i = from;
    while i + old.len() as i64 <= stop && get_src()[i as usize] != b';' {
        if (i == 0 || !word_byte(get_src()[(i - 1) as usize]))
            && get_src()[i as usize..(i + old.len() as i64) as usize] == old
            && (i + old.len() as i64 == pcx.src_len
                || !word_byte(get_src()[(i + old.len() as i64) as usize])) {
            err_fix(i, i + old.len() as i64, new, pcx);
            return;
        }
        i += 1;
    }
}

// The error being made has a fix that `volec fix` makes from its own
// tables (a missing `use`, a missing `pub`).
pub fn err_fixable(pcx: &mut Ctx<Comp>) {
    pcx.err_fixable = true;
}

fn word_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// The file of position pos.
fn file_at(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut file: i64 = 0;
    while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[(file + 1) as usize].start {
        file += 1;
    }
    file
}

// Whether the error at pos passes `--at FILE:LINE`: its line, in a file
// whose path is FILE's (either may have a directory the other has not).
pub fn fix_at_ok(pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.fix_at_file == 0 as *mut u8 {
        return true;
    }
    if pos_line(pos, pcx) != pcx.fix_at_line {
        return false;
    }
    let a_all = cstr(pcx.fix_at_file);
    let a = plain(&a_all);
    let b = plain(crate::base::source_path(file_at(pos, pcx), pcx));
    a == b
        || (b.len() > a.len() && b[(b.len() as i64 - a.len() as i64 - 1) as usize] == b'/'
            && b[(b.len() as i64 - a.len() as i64) as usize..] == a)
        || (a.len() > b.len() && a[(a.len() as i64 - b.len() as i64 - 1) as usize] == b'/'
            && a[(a.len() as i64 - b.len() as i64) as usize..] == b)
}

// A path without a leading `./`.
fn plain(p: &[u8]) -> &[u8] {
    if p.len() > 2 && p[0] == b'.' && p[1] == b'/' { &p[2..] } else { p }
}

// Prints the error and exits:
//   error[<kind>]: <message>
//    --> <file>: line <line>, column <column>
//     = help: <help>
pub fn err_end(pcx: &mut Ctx<Comp>) -> ! {
    if pcx.errors_as_dump {
        let mut file: i64 = 0;
        while file + 1 < pcx.files.len() as i64
            && pcx.err_pos >= pcx.files[(file + 1) as usize].start {
            file += 1;
        }
        let out = buf_new();
        buf_fmt(out, format_args("error {}\n", pcx.err_pos - pcx.files[file as usize].start));
        buf_write_fd(out, STDOUT);
        crate::base::exit_now(0);
    }
    record_error_text(pcx);
    err_jump(pcx)
}

// On after the innermost recovery point; at none (or after too many
// errors), the errors are printed and the compiler exits.
pub fn err_jump(pcx: &mut Ctx<Comp>) -> ! {
    if pcx.recover_depth > 0 && pcx.error_count < pcx.max_errors {
        jump_back((pcx.recover_bufs[(pcx.recover_depth - 1) as usize]) as *mut u8);
    }
    exit_if_errors(pcx);
    if pcx.err_bail != 0 as *mut u8 {
        jump_back(pcx.err_bail);
    }
    crate::base::exit_now(1)
}

// An error whose text, `out`, is made by the caller (an error in a C
// header, which is not part of the source), sorted as if at pos.
pub fn err_end_text(pos: i64, out: i64, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pos, pcx);
    buf_append(pcx.err, out);
    let key = error_key(pcx);
    if key >= 0 {
        record_error(key, out, pcx);
    }
    err_jump(pcx)
}

// (0.25.4) Whether `fix --suggested` refuses the error being made's fix
// before making it (tools/fix/verify: refusal_of; a conversion that loses
// the value, a cast of a cast, a call made to call itself): then no
// `try:` sends the agent there (its `note fix.refused` still says why).
fn fix_refused(pcx: &Ctx<Comp>) -> bool {
    pcx.err_fix_start >= 0 && pcx.err_fix_text >= 0
        && crate::tools::fix::verify::refusal_of(pcx.err_fix_start, pcx.err_fix_end,
            pcx.err_fix_text, pcx).len() > 0
}

// The error being made, as printed.
fn error_text(pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_fmt(out,
        format_args("error[{}]: {}\n --> ", str::from_utf8(&cstr(pcx.err_kind)).unwrap(),
            str::from_utf8(&buf_copy(pcx.err)).unwrap()));
    buf_position(out, pcx.err_pos, pcx);
    buf_byte(out, b'\n');
    if buf_len(pcx.err_help) > 0 {
        buf_fmt(out,
            format_args("  = help: {}\n", str::from_utf8(&buf_copy(pcx.err_help)).unwrap()));
    }
    let notes = buf_copy(pcx.err_note);
    let mut s: i64 = 0;
    while s < notes.len() as i64 {
        let mut e = s;
        while e < notes.len() as i64 && notes[e as usize] != b'\n' {
            e += 1;
        }
        buf_fmt(out,
            format_args("  = note: {}\n",
                &str::from_utf8(notes[s as usize..e as usize]).unwrap()));
        s = e + 1;
    }
    let tries = buf_copy(pcx.err_try);
    let mut a: i64 = 0;
    while a < tries.len() as i64 {
        let mut e = a;
        while e < tries.len() as i64 && tries[e as usize] != b'\n' {
            e += 1;
        }
        buf_fmt(out,
            format_args("  = try: {}\n",
                &str::from_utf8(tries[a as usize..e as usize]).unwrap()));
        a = e + 1;
    }
    if pcx.err_fixable && !fix_refused(pcx) {
        buf_str(out, c"  = try: ");
        buf_tool_command(out, b"fix --suggested", true, pcx);
        buf_byte(out, b'\n');
    }
    // RULE: D22.2 (an opaque instance's error: at the template, no
    // instance named)
    if !pcx.opaque_phase {
        instantiation_notes(out, pcx);
    }
    out
}

// The key of the error being made, or -1 when it is not to be recorded:
// it names the error type, or it is already recorded (the same message at
// the same position: a generic function is checked per instance; 0.10).
// (0.25) Asked before its text is made: a query checks the generic
// functions no one instantiates, and a repeated error is not formatted.
fn error_key(pcx: &mut Ctx<Comp>) -> i64 {
    if get_err_poisoned() {
        return -1;
    }
    // RULE: D22.2 (0.27.3, FL11: an opaque instance's errors are
    // recorded, and forgotten when the instance meets a gap of the model,
    // opaque_unsure, build_opaque_instances; one made while an instance
    // is made, a bound an Ω does not resolve, is the model's: the
    // instance is unsure)
    if pcx.opaque_phase && !pcx.opaque_sure && pcx.cur_inst < 0 {
        pcx.opaque_unsure = true;
        return -1;
    }
    // RULE: D22.2 (0.27.2.1: an opaque instance's error where one is
    // reported already, a concrete instance's: not again)
    if pcx.opaque_phase {
        let mut j: i64 = 0;
        while j < pcx.error_keys.len() as i64 {
            if (pcx.error_keys[j as usize]) == pcx.err_pos {
                return -1;
            }
            j += 2;
        }
    }
    let key = intern_buf(pcx.err, pcx);
    let mut i: i64 = 0;
    while i < pcx.error_keys.len() as i64 {
        if (pcx.error_keys[i as usize]) == pcx.err_pos
            && (pcx.error_keys[(i + 1) as usize]) == key {
            return -1;
        }
        i += 2;
    }
    key
}

// Records the error being made (its text in `out`), under key (from
// error_key).
fn record_error(key: i64, out: i64, pcx: &mut Ctx<Comp>) {
    pcx.error_keys.push(pcx.err_pos);
    pcx.error_keys.push(key);
    pcx.errors.push(pcx.err_pos);
    pcx.errors.push(out);
    pcx.error_count += 1;
    if pcx.err_fix_start >= 0 && fix_at_ok(pcx.err_pos, pcx) {
        let text = buf_new();
        buf_append(text, pcx.err_fix_text);
        pcx.suggested.push(pcx.err_pos);
        pcx.suggested.push(pcx.err_fix_start);
        pcx.suggested.push(pcx.err_fix_end);
        pcx.suggested.push(text);
        let kind = intern(&cstr(pcx.err_kind), pcx);
        pcx.suggested_kind.push(kind);
    }
}

// Records the error being made, its text made by error_text, unless
// error_key says not to.
fn record_error_text(pcx: &mut Ctx<Comp>) {
    let key = error_key(pcx);
    if key >= 0 {
        record_error(key, error_text(pcx), pcx);
    }
}

// Like err_end, but the work goes on after the error (0.10): for errors
// that leave nothing undone, or whose callers make do (an unknown type is
// the error type, a duplicate is left out...).
pub fn err_end_soft(pcx: &mut Ctx<Comp>) {
    record_error_text(pcx);
    if pcx.error_count >= pcx.max_errors {
        exit_if_errors(pcx);
    }
}

pub fn error_at_soft(pos: i64, message: *mut u8, pcx: &mut Ctx<Comp>) {
    err_begin(pos, pcx);
    err_str(message, pcx);
    err_end_soft(pcx);
}

pub fn fail_name(name: i64, pcx: &mut Ctx<Comp>) {
    pcx.failed_names.push(name);
}

pub fn name_failed(name: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.failed_names.len() as i64 {
        if (pcx.failed_names[i as usize]) == name {
            return true;
        }
    }
    false
}

// The error being made says that `name` is unknown: it is not reported
// when name's declaration failed.
pub fn err_failed_name(name: i64, pcx: &Ctx<Comp>) {
    if name_failed(name, pcx) {
        set_err_poisoned(true);
    }
}

// ---- Lines and columns (0.25) ----

// The line starts of each file, made on first use and read only as far
// as the positions asked for: a position's line is found by halves, not
// counted from its file's start. (A query's errors in std, one file of
// 48k lines, each counted its lines from the start: 37% of a cold query.)
#[derive(Clone, Copy)] pub struct LineIndex {
    src: *mut u8, start: i64, scanned: i64, starts: IntVec,
}

const STD_MARK_LINES: i64 = 64;

// UNSAFE: C's memchr, for the lines of a position (newline_in,
// std_line_col).
// SAFETY: <string.h>'s prototype, on macOS and Linux alike; the callers
// give it a block of at least n bytes.
extern "C" {
    fn memchr(s: *mut u8, c: i32, n: u64) -> *mut u8;
}

// The first newline of SRC[from..to), or -1.
fn newline_in(from: i64, to: i64) -> i64 {
    let part = &get_src()[from as usize..to as usize];
    // UNSAFE: memchr is C's, in place of a loop over the bytes (the
    // lines of a position in std, one file of 48k lines, were 37% of a
    // cold query's errors before the index; it still scans each file
    // once)
    // SAFETY: part is a live slice of to - from bytes (the range was
    // checked by the index above): memchr reads only those and returns
    // null or the address of one of them
    unsafe {
        let found = memchr(part.ptr, b'\n' as i32, part.len() as u64);
        if found == 0 as *mut u8 { -1 } else { from + (found as i64 - part.ptr as i64) }
    }
}

// The line (from 1) of position pos in file `file`, and its column
// (from 1) through `col`: as counted from the file's start up to pos,
// and not past the end of SRC.
pub fn file_line_col(file: i64, pos: i64, col: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.files[file as usize].start;
    let p = if pos < pcx.src_len { pos } else { pcx.src_len };
    if p <= start {
        *col = 1;
        return 1;
    }
    if file == pcx.std_text_file {
        let line = std_line_col(start, p, col, pcx);
        if line > 0 {
            return line;
        }
    }
    while pcx.line_index.len() as i64 <= file {
        pcx.line_index.push(LineIndex {
            src: 0 as *mut u8, start: 0, scanned: 0,
            starts: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        });
    }
    let x = &mut pcx.line_index[file as usize];
    // (the sources are only added to, so a file's text is the same
    // while SRC is; SRC changes when they grow, and while `fmt` lexes
    // a text of its own)
    if x.src != get_src().ptr || x.start != start {
        x.src = get_src().ptr;
        x.start = start;
        x.scanned = start;
        x.starts.clear();
        x.starts.push(start);
    }
    while x.scanned < p {
        let nl = newline_in(x.scanned, p);
        if nl < 0 {
            x.scanned = p;
        } else {
            x.starts.push(nl + 1);
            x.scanned = nl + 1;
        }
    }
    // the last line start at or before p
    let mut lo: i64 = 0;
    let mut hi = x.starts.len() as i64;
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if x.starts[mid as usize] <= p {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    *col = p - x.starts[lo as usize] + 1;
    lo + 1
}

// The line of position p (after start) in std's built-in text, which
// starts at start, and its column through col: counted from the last
// mark at or before p (the marks read on first use); 0 when the marks do
// not fit the text (file_line_col counts then).
fn std_line_col(start: i64, p: i64, col: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.std_marks.len() as i64 == 0 {
        let b = buf_new();
        std2_line_marks(b);
        let s = buf_copy(b);
        let mut n: i64 = 0;
        let mut digits = false;
        for i in 0..s.len() {
            let c = s[i];
            if c >= b'0' && c <= b'9' {
                n = n * 10 + (c - b'0') as i64;
                digits = true;
            } else if digits {
                pcx.std_marks.push(n);
                n = 0;
                digits = false;
            }
        }
        if digits {
            pcx.std_marks.push(n);
        }
        buf_clear(b);
    }
    let mut lo: i64 = 0;
    let mut hi = pcx.std_marks.len() as i64;
    if hi == 0 {
        return 0;
    }
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if pcx.std_marks[mid as usize] <= p - start {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    if lo > 0
        && get_src()[(start + pcx.std_marks[lo as usize] - 1) as usize] != b'\n' {
        return 0;
    }
    let mut line = lo * STD_MARK_LINES + 1;
    let mut at = start + pcx.std_marks[lo as usize];
    while at < p {
        let found = newline_in(at, p);
        if found < 0 {
            break;
        }
        at = found + 1;
        line += 1;
    }
    // (at: the start of p's line)
    *col = p - at + 1;
    line
}

// `<file>: line <line>, column <column>` of position pos.
pub fn buf_position(out: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let file = file_at(pos, pcx);
    let mut col: i64 = 1;
    let line = file_line_col(file, pos, &mut col, pcx);
    // (0.16: a module next to a root given without a directory is
    // `x.vl`, not `./x.vl`)
    buf_bytes(out, plain(crate::base::source_path(file, pcx)));
    buf_fmt(out, format_args(": line {line}, column {col}"));
}

// (0.17) The line of position pos in its file.
pub fn pos_line(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut col: i64 = 1;
    file_line_col(file_at(pos, pcx), pos, &mut col, pcx)
}

// (0.17) `FILE:LINE` of position pos, as the tools take an item's
// position (`volec edit delete main.vl:12`).
pub fn buf_file_line(out: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let mut file: i64 = 0;
    while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[(file + 1) as usize].start {
        file += 1;
    }
    buf_bytes(out, plain(crate::base::source_path(file, pcx)));
    buf_byte(out, b':');
    buf_int(out, pos_line(pos, pcx));
}

pub fn error_at(pos: i64, message: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(pos, pcx);
    err_str(message, pcx);
    err_end(pcx)
}

// (0.28.0) ERR_POISONED's accessors: every use of it is one of them.
// (0.29) An atomic, Relaxed: one flag, read and written by the error
// reports and the IR printers, which run on one thread.
pub fn get_err_poisoned() -> bool {
    ERR_POISONED.load(std::sync::atomic::Ordering::Relaxed)
}

pub fn set_err_poisoned(v: bool) {
    ERR_POISONED.store(v, std::sync::atomic::Ordering::Relaxed);
}
