// Diagnostics: errors at a source position, as the parser and the checker
// report them; several errors per run, through recovery points; warnings;
// the short one-line form of --diagnostics=short; and the names whose
// declaration failed (their uses are not reported again).

use crate::base::{
    BUFS, IntVec, SRC, STDERR, STDOUT, _longjmp, alloc_array, alloc_zeroed, buf_byte, buf_bytes,
    buf_clear, buf_fmt, buf_int, buf_new, buf_slice, buf_str, buf_write_fd, cstr, exit, free,
    intern, memcpy, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::json::{DIAG_JSON, json_diagnostic};
use crate::base::term::{build_failed_errors, rich_diagnostic};
use crate::front::generics::instantiate::instantiation_notes;
use crate::front::stdsrc::std_line_marks;

// ---- Errors at a source position ----

// Starts an error message at `pos`; finish it with err_* and err_end.
pub fn err_begin(pos: i64, pcx: inout Ctx<Comp>) {
    if pcx.err < 0 {
        pcx.err = buf_new();
        pcx.err_help = buf_new();
        pcx.err_try = buf_new();
        pcx.err_note = buf_new();
    }
    buf_clear(pcx.err);
    buf_clear(pcx.err_help);
    buf_clear(pcx.err_try);
    buf_clear(pcx.err_note);
    pcx.err_pos = pos;
    ERR_POISONED = false;
    pcx.err_fix_start = -1;
    pcx.err_fixable = false;
}

// The position of the error being made.
pub fn err_pos(pcx: Ctx<Comp>) -> i64 {
    pcx.err_pos
}

// (0.25.3) A note of the error about position pos (the `let` whose
// literals gave a value its type): `  = note: FILE:L:C: text`.
pub fn err_note_at(pos: i64, text: [u8], pcx: inout Ctx<Comp>) {
    buf_position(pcx.err_note, pos, &pcx);
    buf_bytes(pcx.err_note, ": ");
    buf_bytes(pcx.err_note, text);
    buf_byte(pcx.err_note, '\n');
}

// ---- Several errors (0.5) ----
//
// The parser and the checker set recovery points (around an item, a
// statement, a function's body): an error is recorded, and the work goes
// on after the innermost recovery point, which skips what failed. At the
// end of a phase that had errors, they are all printed, sorted by
// position, and the compiler exits with 1. An error whose message names
// the error type (the type given to what failed, see TY_ERROR) follows
// from an earlier one and is not reported. (0.10) The phases go on after
// errors (the checker after the parser's); an error whose caller makes do
// without jumping is recorded by err_end_soft.
//
// A recovery point:
//     let depth = RECOVER_DEPTH;
//     if _setjmp(recover_enter()) == 0 {
//         ... work that may fail ...
//     } else {
//         ... clean up after a failure ...
//     }
//     recover_leave(depth);
// (_setjmp must be called by the function that goes on after the jump,
// and that function must not return in between: the work is a call
// followed by more code, never a tail call.)

// Whether the message being made names the error type.
pub static var ERR_POISONED: bool = false;

pub fn recover_enter(pcx: inout Ctx<Comp>) -> *u8 {
    if pcx.recover_bufs.count <= pcx.recover_depth {
        pcx.recover_bufs.push(alloc_zeroed(512) as i64);
    }
    let jb = unsafe { pcx.recover_bufs.data[pcx.recover_depth] as *u8 };
    pcx.recover_depth += 1;
    jb
}

pub fn recover_leave(depth: i64, pcx: inout Ctx<Comp>) {
    pcx.recover_depth = depth;
}

// ---- Warnings (0.9) ----
//
// A warning is printed like an error, `warning[<kind>]: ...`, and does not
// fail the compilation; each (position, message) once, however often the
// checker meets it (a generic function is checked per instance), in
// position order, at most MAX_WARNINGS of them. `--deny-warnings` makes
// every warning an error.

const MAX_WARNINGS: i64 = 50;

// Records a warning (or, with --deny-warnings, an error) at `pos`; `key`
// tells warnings at one position apart.
pub fn report_warning(pos: i64, key: i64, kind: *u8, message: *u8, help: *u8, pcx: inout Ctx<Comp>) {
    if pcx.allowed.count > 0 && allowed(kind, pcx) {
        return;
    }
    unsafe {
        var i = 0;
        while i < pcx.warnings.count {
            if pcx.warnings.data[i] == pos && pcx.warnings.data[i + 2] == key {
                return;
            }
            i += 3;
        }
        let out = buf_new();
        buf_str(out, if pcx.deny_warnings { c"error[" } else { c"warning[" });
        buf_fmt(out, format_args("{}]: {}\n --> ", cstr(kind), cstr(message)));
        buf_position(out, pos, &pcx);
        buf_byte(out, '\n');
        if help != 0 as *u8 {
            buf_fmt(out, format_args("  = help: {}\n", cstr(help)));
        }
        pcx.warnings.push(pos);
        pcx.warnings.push(out);
        pcx.warnings.push(key);
        if pcx.deny_warnings && pcx.error_count < pcx.max_errors {
            pcx.errors.push(pos);
            pcx.errors.push(out);
            pcx.error_count += 1;
        }
    }
}

// (0.27.0) `--max-errors=N`: a check stops after N errors, not 50 (0: it
// does not stop). False when arg is not that option.
pub fn max_errors_option(arg: str, pcx: inout Ctx<Comp>) -> bool {
    if !arg.starts_with("--max-errors=") {
        return false;
    }
    var n: i64 = 0;
    let digits = arg.as_bytes()["--max-errors=".len()..];
    if digits.len() == 0 {
        crate::base::die2(c"--max-errors=N takes a number: ", c"(none)");
    }
    for c in digits {
        if c < '0' || c > '9' || n > 100000000 {
            crate::base::die2(c"--max-errors=N takes a number: ", crate::cli::c_of(arg));
        }
        n = n * 10 + (c - '0') as i64;
    }
    pcx.max_errors = if n == 0 { 9223372036854775807 } else { n };
    true
}

// (0.27.0) `--allow=CODE[,CODE...]`, rustc's `-A`, repeatable: a warning
// of that code, or of that family (`--allow=borrowck`: every
// `borrowck.*`), is not reported. False when arg is not that option.
pub fn allow_option(arg: str, pcx: inout Ctx<Comp>) -> bool {
    if !arg.starts_with("--allow=") {
        return false;
    }
    let list = arg.as_bytes()["--allow=".len()..];
    var from: usize = 0;
    for i in 0..list.len() + 1 {
        if i == list.len() || list[i] == ',' {
            if i > from {
                pcx.allowed.push(list[from..i].ptr as i64);
                pcx.allowed.push((i - from) as i64);
            }
            from = i + 1;
        }
    }
    true
}

// Whether a warning of kind `kind` is allowed (`--allow`).
fn allowed(kind: *u8, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: the code is a C string the diagnostic's caller gives, and the
    // allowed codes are pieces of the command line's words, kept as
    // (pointer, length) pairs in an IntVec.
    // SAFETY: kind is NUL-terminated (a literal); each allowed piece points
    // into a word of the command line, which lives as long as the process,
    // and its length is within the word.
    unsafe {
        var i = 0;
        while i + 1 < pcx.allowed.count {
            let p = pcx.allowed.data[i] as *u8;
            let n = pcx.allowed.data[i + 1];
            var j = 0;
            while j < n && kind[j] != 0 && kind[j] == p[j] {
                j += 1;
            }
            if j == n && (kind[j] == 0 || kind[j] == '.') {
                return true;
            }
            i += 2;
        }
        false
    }
}

// Whether an error of kind `key` at `pos` was reported; records it if not
// (an unsafe operation is reported once per place).
pub fn error_keyed(pos: i64, key: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        var i = 0;
        while i < pcx.keyed_errors.count {
            if pcx.keyed_errors.data[i] == pos && pcx.keyed_errors.data[i + 1] == key {
                return true;
            }
            i += 2;
        }
        pcx.keyed_errors.push(pos);
        pcx.keyed_errors.push(key);
        false
    }
}

// An error that does not stop the check (an unsafe operation), once per
// position and key; `fix`, when not empty, is the `volec` command
// (arguments, the root after them) of its `try:` line.
pub fn report_error_once(pos: i64, key: i64, kind: *u8, message: *u8, help: *u8, fix: [u8],
    pcx: inout Ctx<Comp>) {
    if error_keyed(pos, key, &pcx) {
        return;
    }
    if pcx.error_count >= pcx.max_errors {
        return;
    }
    let out = buf_new();
    buf_fmt(out, format_args("error[{}]: {}\n --> ", cstr(kind), cstr(message)));
    buf_position(out, pos, &pcx);
    buf_byte(out, '\n');
    if help != 0 as *u8 {
        buf_fmt(out, format_args("  = help: {}\n", cstr(help)));
    }
    if fix.len > 0 {
        buf_str(out, c"  = try: ");
        buf_tool_command(out, fix, true, pcx);
        buf_byte(out, '\n');
    }
    pcx.errors.push(pos);
    pcx.errors.push(out);
    pcx.error_count += 1;
}

// report_error_once (or, when `warning`, report_warning) with `tries`:
// `try:` lines, each a whole command, separated by '\n' (the own pass's,
// built before the message is recorded); each is printed as its own
// `  = try:` line.
pub fn report_error_tries(pos: i64, key: i64, kind: *u8, message: *u8, help: *u8, tries: [u8],
    warning: bool, pcx: inout Ctx<Comp>) {
    unsafe {
        if warning {
            var i = 0;
            while i < pcx.warnings.count {
                if pcx.warnings.data[i] == pos && pcx.warnings.data[i + 2] == key {
                    return;
                }
                i += 3;
            }
        } else if error_keyed(pos, key, &pcx) || pcx.error_count >= pcx.max_errors {
            return;
        }
        let out = buf_new();
        if warning {
            buf_str(out, if pcx.deny_warnings { c"error[" } else { c"warning[" });
        } else {
            buf_str(out, c"error[");
        }
        buf_fmt(out, format_args("{}]: {}\n --> ", cstr(kind), cstr(message)));
        buf_position(out, pos, &pcx);
        buf_byte(out, '\n');
        if help != 0 as *u8 {
            buf_fmt(out, format_args("  = help: {}\n", cstr(help)));
        }
        put_try_lines(out, tries);
        if warning {
            pcx.warnings.push(pos);
            pcx.warnings.push(out);
            pcx.warnings.push(key);
            if !pcx.deny_warnings || pcx.error_count >= pcx.max_errors {
                return;
            }
        }
        pcx.errors.push(pos);
        pcx.errors.push(out);
        pcx.error_count += 1;
    }
}

// Each line of `tries` (separated by '\n') as `  = try: LINE`.
pub fn put_try_lines(out: i64, tries: [u8]) {
    var i = 0;
    while i < tries.len as i64 {
        var e = i;
        while e < tries.len as i64 && tries[e] != '\n' {
            e += 1;
        }
        if e > i {
            buf_str(out, c"  = try: ");
            buf_bytes(out, tries[i..e]);
            buf_byte(out, '\n');
        }
        i = e + 1;
    }
}

// Prints the recorded warnings (not with --deny-warnings: they are
// errors), sorted by position, and forgets them.
pub fn flush_warnings(pcx: inout Ctx<Comp>) {
    unsafe {
        let n = pcx.warnings.count / 3;
        if n == 0 || pcx.deny_warnings {
            return;
        }
        for i in 1..n {
            var j = i;
            while j > 0 && pcx.warnings.data[3 * (j - 1)] > pcx.warnings.data[3 * j] {
                for k in 0..3 {
                    let t = pcx.warnings.data[3 * j + k];
                    pcx.warnings.data[3 * j + k] = pcx.warnings.data[3 * (j - 1) + k];
                    pcx.warnings.data[3 * (j - 1) + k] = t;
                }
                j -= 1;
            }
        }
        let out = buf_new();
        let shown = if n < MAX_WARNINGS { n } else { MAX_WARNINGS };
        for i in 0..shown {
            put_diagnostic(out, pcx.warnings.data[3 * i], buf_slice(pcx.warnings.data[3 * i + 1]),
                &pcx);
            pcx.warnings_shown += 1;
        }
        if n > shown {
            buf_fmt(out, format_args("warning: {} more warnings not shown\n", n - shown));
        }
        buf_write_fd(out, STDERR);
        pcx.warnings.count = 0;
    }
}

// ---- The success line (0.18.1) ----
//
// `check` and a build that find no error end with one line on stderr,
// `ok: 0 errors in main.vl` or `ok: built prog`: in the 0.18 eval the
// agents could not tell an empty answer from a silent failure (22 of 90
// debriefs) and checked again. Not with --json; not in a volec that
// another one runs (the tools' own checks and builds: VOLEC_NESTED,
// which ok_line_setup sets for the children); not with VOLE_OK=0.

extern "C" {
    fn getenv(name: *u8) -> *u8;
    fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
}

// Reads the environment, once, at the start (main), and marks it for the
// volec processes this one starts.
pub fn ok_line_setup(pcx: inout Ctx<Comp>) {
    unsafe {
        let off = getenv(c"VOLE_OK");
        pcx.nested = getenv(c"VOLEC_NESTED") != 0 as *u8;
        pcx.ok_line = !pcx.nested
            && !(off != 0 as *u8 && off[0] == '0' && off[1] == 0);
        setenv(c"VOLEC_NESTED", c"1", 1);
        // (0.25.5) The tag of the edit copies of this process and the
        // volecs it starts (tools/edit/apply.vl, copy_path): the first
        // volec's pid, inherited, so that two edits in one tree at once do
        // not read each other's copies (feedbacks/table254.md #2).
        pcx.edit_tag = getenv(c"VOLEC_EDIT_TAG");
        if pcx.edit_tag == 0 as *u8 {
            let b = crate::base::buf_new();
            crate::base::buf_int(b, std::process::id() as i64);
            crate::base::buf_byte(b, 0);
            pcx.edit_tag = crate::base::BUFS[b].data;
            setenv(c"VOLEC_EDIT_TAG", pcx.edit_tag, 1);
        }
    }
}

// The warnings recorded and not printed yet.
pub fn warning_count(pcx: Ctx<Comp>) -> i64 {
    pcx.warnings.count / 3
}

// `ok: WHAT` on stderr, when the success line is wanted.
pub fn print_ok(what: [u8], pcx: Ctx<Comp>) {
    if !pcx.ok_line || DIAG_JSON {
        return;
    }
    let out = buf_new();
    buf_bytes(out, "ok: ");
    buf_bytes(out, what);
    buf_byte(out, '\n');
    buf_write_fd(out, STDERR);
}

// Prints the recorded errors and exits with 1, if there are any.
pub fn exit_if_errors(pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.error_count == 0 {
            return;
        }
        if pcx.err_bail != 0 as *u8 {
            _longjmp(pcx.err_bail, 1);
        }
        // (0.27.3: a build that read std2 lazily is made again with it whole,
        // front/modules/std2lazy.vl)
        if crate::front::modules::std2lazy::dropped() > 0 {
            crate::front::modules::std2lazy::rerun_eager();
        }
        write_errors(&pcx);
        build_failed_errors(pcx.error_count, &pcx);
        exit(1);
    }
}

// Prints the recorded errors (and the warnings), sorted by position.
pub fn write_errors(pcx: inout Ctx<Comp>) {
    unsafe {
        flush_warnings(&pcx);
        sort_errors(&pcx);
        let n = pcx.errors.count / 2;
        let out = buf_new();
        for i in 0..n {
            put_diagnostic(out, pcx.errors.data[2 * i], buf_slice(pcx.errors.data[2 * i + 1]),
                &pcx);
        }
        if pcx.error_count >= pcx.max_errors {
            buf_fmt(out,
                format_args(
                    "error: too many errors; stopping after {} (--max-errors=N: more, 0: all)\n",
                    pcx.max_errors));
        }
        buf_write_fd(out, STDERR);
    }
}

// The number of errors recorded.
// The number of errors recorded, and forgetting the errors recorded
// since (0.11: a rewrite's pattern is parsed after the program, and its
// syntax error is not the program's).
pub fn errors_mark(pcx: Ctx<Comp>) -> i64 {
    pcx.errors.count
}

pub fn errors_forget(mark: i64, pcx: inout Ctx<Comp>) {
    pcx.errors.count = mark;
    pcx.error_keys.count = mark;
    pcx.error_count = mark / 2;
}

pub fn error_count(pcx: Ctx<Comp>) -> i64 {
    pcx.error_count
}

// RULE: D4.4 (e) (0.27.6) The errors recorded since mark (errors_mark;
// count the error count then) moved to held, as (tag, position, text)
// triples: recorded no more until error_give_back.
pub fn errors_hold(mark: i64, count: i64, tag: i64, held: inout Vec<i64, Comp>,
    pcx: inout Ctx<Comp>) {
    var i = mark;
    while i + 1 < pcx.errors.count {
        held.push(tag);
        held.push(pcx.errors.get(i));
        held.push(pcx.errors.get(i + 1));
        i += 2;
    }
    pcx.errors.count = mark;
    pcx.error_count = count;
}

// An error errors_hold moved, recorded again (its position and text).
pub fn error_give_back(pos: i64, text: i64, pcx: inout Ctx<Comp>) {
    pcx.errors.push(pos);
    pcx.errors.push(text);
    pcx.error_count += 1;
}

// (0.25.2) Whether an error at pos is among the ones recorded (not one a
// speculative check forgot: errors_forget).
pub fn error_recorded_at(pos: i64, pcx: Ctx<Comp>) -> bool {
    var i = 0;
    while i < pcx.errors.count {
        // UNSAFE: ERRORS's data is a raw buffer (an IntVec of pairs).
        // SAFETY: 0 <= i < ERRORS.count, a pair's position.
        if unsafe { pcx.errors.data[i] } == pos {
            return true;
        }
        i += 2;
    }
    false
}

// The recorded errors and warnings, for the tools' cache (0.13): the
// errors' (position, text) pairs and the warnings' (position, text, key)
// triples, the texts as buffers, into `errors` and `warnings`; returns the
// number of errors.
pub fn diag_records(errors: inout IntVec, warnings: inout IntVec, pcx: inout Ctx<Comp>) -> i64 {
    for x in pcx.errors.items() {
        errors.push(x);
    }
    for x in pcx.warnings.items() {
        warnings.push(x);
    }
    pcx.error_count
}

// The errors and warnings diag_records gave, recorded again.
pub fn diag_restore(errors: inout IntVec, warnings: inout IntVec, count: i64, pcx: inout Ctx<Comp>) {
    for x in errors.items() {
        pcx.errors.push(x);
    }
    for x in warnings.items() {
        pcx.warnings.push(x);
    }
    pcx.error_count = count;
}

// The first error (by position) in the short form, without its help and
// notes, and without a newline (`volec query`, 0.11).
pub fn first_error_short(out: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.errors.count == 0 {
            return;
        }
        sort_errors(&pcx);
        short_diagnostic(out, buf_slice(pcx.errors.data[1]), tails: false);
    }
}

// Every recorded error in the short form, one per line, sorted by
// position (0.11: what an edit is checked against).
pub fn errors_short(out: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        sort_errors(&pcx);
        let n = pcx.errors.count / 2;
        for i in 0..n {
            short_diagnostic(out, buf_slice(pcx.errors.data[2 * i + 1]), tails: true);
            buf_byte(out, '\n');
        }
    }
}

// Diagnostic `text` (in the human form) at pos as it is printed (0.25.3:
// on a terminal, base::term's form).
fn put_diagnostic(out: i64, pos: i64, text: [u8], pcx: inout Ctx<Comp>) {
    if DIAG_JSON {
        json_diagnostic(out, text);
    } else if pcx.diag_short {
        short_diagnostic(out, text, tails: true);
        buf_byte(out, '\n');
    } else if pcx.rich {
        rich_diagnostic(out, pos, text, &pcx);
    } else {
        buf_bytes(out, text);
    }
}

// (0.25.3) One diagnostic (`text`, in the human form, at pos: -1 for
// none) on stderr now, as the recorded ones are printed: a link's error.
pub fn print_diagnostic(pos: i64, text: [u8], pcx: inout Ctx<Comp>) {
    let out = buf_new();
    put_diagnostic(out, pos, text, &pcx);
    buf_write_fd(out, STDERR);
}

// (0.25.3) The recorded errors at positions from..to (a file's), for the
// summary on a terminal.
pub fn errors_in(from: i64, to: i64, pcx: Ctx<Comp>) -> i64 {
    var n = 0;
    var i = 0;
    while i < pcx.errors.count {
        // UNSAFE: ERRORS's data is a raw buffer (an IntVec of pairs).
        // SAFETY: 0 <= i < ERRORS.count, a pair's position.
        let pos = unsafe { pcx.errors.data[i] };
        if pos >= from && pos < to {
            n += 1;
        }
        i += 2;
    }
    n
}

// The one-line form of diagnostic `text`: its position first, then its
// head (`error[kind] message`), then (with `tails`) its help and notes.
pub fn short_diagnostic(out: i64, text: [u8], tails: bool) {
    // The lines of text: the head, ` --> position`, `  = help: ...`.
    var head_end = 0;
    while head_end < text.len as i64 && text[head_end] != '\n' {
        head_end += 1;
    }
    var i = head_end + 1;
    var pos_from = -1;
    var pos_to = -1;
    var rest = i;
    if i + 5 <= text.len as i64 && text[i] == ' ' && text[i + 1] == '-' && text[i + 2] == '-'
        && text[i + 3] == '>' {
        pos_from = i + 5;
        while i < text.len as i64 && text[i] != '\n' {
            i += 1;
        }
        pos_to = i;
        rest = i + 1;
    }
    if pos_from >= 0 {
        put_short_positions(out, text[pos_from..pos_to]);
        buf_str(out, c": ");
    }
    // `error[kind]: message` -> `error[kind] message`
    let head = text[0..head_end];
    var k = 0;
    while k + 2 < head.len as i64 && !(head[k] == ']' && head[k + 1] == ':' && head[k + 2] == ' ') {
        k += 1;
    }
    if k + 2 < head.len as i64 && head[0] != ' ' {
        buf_bytes(out, head[0..k + 1]);
        put_short_positions(out, head[k + 2..]);
    } else {
        put_short_positions(out, head);
    }
    if !tails {
        return;
    }
    i = rest;
    while i < text.len as i64 {
        var e = i;
        while e < text.len as i64 && text[e] != '\n' {
            e += 1;
        }
        var a = i;
        while a < e && (text[a] == ' ' || text[a] == '=') {
            a += 1;
        }
        if a < e {
            buf_str(out, c" | ");
            put_short_positions(out, text[a..e]);
        }
        i = e + 1;
    }
}

// Text s with each `<file>: line <l>, column <c>` as `<file>:<l>:<c>` (and
// `<file>: line <l>` as `<file>:<l>`).
pub fn put_short_positions(out: i64, s: [u8]) {
    var i = 0;
    while i < s.len as i64 {
        if i + 7 <= s.len as i64 && s[i] == ':' && s[i + 1] == ' ' && s[i + 2] == 'l'
            && s[i + 3] == 'i'
            && s[i + 4] == 'n' && s[i + 5] == 'e' && s[i + 6] == ' ' {
            var j = i + 7;
            while j < s.len as i64 && s[j] >= '0' && s[j] <= '9' {
                j += 1;
            }
            if j > i + 7 {
                buf_fmt(out, format_args(":{}", s[i + 7..j]));
                // `, column <c>`
                if j + 9 < s.len as i64 && s[j] == ',' && s[j + 1] == ' ' && s[j + 2] == 'c'
                    && s[j + 8] == ' ' {
                    var c = j + 9;
                    while c < s.len as i64 && s[c] >= '0' && s[c] <= '9' {
                        c += 1;
                    }
                    if c > j + 9 {
                        buf_fmt(out, format_args(":{}", s[j + 9..c]));
                        j = c;
                    }
                }
                i = j;
                continue;
            }
        }
        buf_byte(out, s[i]);
        i += 1;
    }
}

// Edit distance of a and b: insertions, deletions, substitutions and
// transpositions of neighbours (optimal string alignment), each 1.
pub fn edit_distance(a: [u8], b: [u8]) -> i64 {
    unsafe {
        let before = alloc_array::<i64>(b.len as i64 + 1);
        let prev = alloc_array::<i64>(b.len as i64 + 1);
        let cur = alloc_array::<i64>(b.len as i64 + 1);
        for j in 0..b.len as i64 + 1 {
            prev[j] = j;
        }
        for i in 1..a.len as i64 + 1 {
            cur[0] = i;
            for j in 1..b.len as i64 + 1 {
                let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
                var best = prev[j - 1] + cost;
                if prev[j] + 1 < best {
                    best = prev[j] + 1;
                }
                if cur[j - 1] + 1 < best {
                    best = cur[j - 1] + 1;
                }
                if i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1]
                    && before[j - 2] + 1 < best {
                    best = before[j - 2] + 1;
                }
                cur[j] = best;
            }
            for j in 0..b.len as i64 + 1 {
                before[j] = prev[j];
                prev[j] = cur[j];
            }
        }
        let result = prev[b.len];
        free(before as *u8);
        free(prev as *u8);
        free(cur as *u8);
        result
    }
}

// Sorts the recorded errors by position (stable: an insertion sort of the
// pairs).
fn sort_errors(pcx: inout Ctx<Comp>) {
    unsafe {
        let n = pcx.errors.count / 2;
        for i in 1..n {
            var j = i;
            while j > 0 && pcx.errors.data[2 * (j - 1)] > pcx.errors.data[2 * j] {
                let pos = pcx.errors.data[2 * j];
                let text = pcx.errors.data[2 * j + 1];
                pcx.errors.data[2 * j] = pcx.errors.data[2 * (j - 1)];
                pcx.errors.data[2 * j + 1] = pcx.errors.data[2 * (j - 1) + 1];
                pcx.errors.data[2 * (j - 1)] = pos;
                pcx.errors.data[2 * (j - 1) + 1] = text;
                j -= 1;
            }
        }
    }
}

// Text for the error's help line.
pub fn err_help(s: *u8, pcx: Ctx<Comp>) {
    buf_str(pcx.err_help, s);
}

pub fn err_help_sym(sym: i64, pcx: Ctx<Comp>) {
    buf_bytes(pcx.err_help, sym_text(sym, pcx));
}

pub fn err_str(s: *u8, pcx: Ctx<Comp>) {
    buf_str(pcx.err, s);
}

pub fn err_sym(sym: i64, pcx: Ctx<Comp>) {
    buf_bytes(pcx.err, sym_text(sym, pcx));
}

pub fn err_int(value: i64, pcx: Ctx<Comp>) {
    buf_int(pcx.err, value);
}

// (0.16) Appends x's Display to the error, an f-string above all:
// `err_fmt(f"'{sym_text(name)}' takes {n} arguments")`.
pub fn err_fmt<T: std::Display>(x: sink T, pcx: Ctx<Comp>) {
    buf_fmt(pcx.err, x);
}

// The same for the help line.
pub fn err_help_fmt<T: std::Display>(x: sink T, pcx: Ctx<Comp>) {
    buf_fmt(pcx.err_help, x);
}

// (0.17) A `try:` line of the error: code or a command to use as it is.
pub fn err_try(s: *u8, pcx: Ctx<Comp>) {
    unsafe {
        if BUFS[pcx.err_try].len > 0 {
            buf_byte(pcx.err_try, '\n');
        }
        buf_str(pcx.err_try, s);
    }
}

// The same, x's Display (an f-string).
pub fn err_try_fmt<T: std::Display>(x: sink T, pcx: Ctx<Comp>) {
    unsafe {
        if BUFS[pcx.err_try].len > 0 {
            buf_byte(pcx.err_try, '\n');
        }
    }
    buf_fmt(pcx.err_try, x);
}

// A `try:` line that runs the compiler: `volec ARGS` (the compiler as
// it was run), then ` ROOT` when `with_root` (the program's root file, as
// positions print it).
pub fn err_try_tool(args: [u8], with_root: bool, pcx: Ctx<Comp>) {
    unsafe {
        if BUFS[pcx.err_try].len > 0 {
            buf_byte(pcx.err_try, '\n');
        }
        buf_tool_command(pcx.err_try, args, with_root, pcx);
    }
}

// `volec ARGS [ROOT]` into out (see err_try_tool).
pub fn buf_tool_command(out: i64, args: [u8], with_root: bool, pcx: Ctx<Comp>) {
    unsafe {
        if pcx.diag_prog == 0 as *u8 {
            buf_str(out, c"volec");
        } else {
            buf_str(out, pcx.diag_prog);
        }
        buf_byte(out, ' ');
        buf_bytes(out, args);
        if with_root {
            // (the first file read that is not std's or a C header's)
            var f = 0;
            while f < pcx.files.len() as i64 && pcx.files[f].path[0] == '<' {
                f += 1;
            }
            if f < pcx.files.len() as i64 {
                let path = pcx.files[f].path;
                buf_byte(out, ' ');
                buf_str(out, if path[0] == '.' && path[1] == '/' { &path[2] } else { path });
            }
        }
    }
}

// ---- Suggested fixes (0.18) ----
//
// An error whose fix the compiler knows exactly: the text that replaces a
// range of the source (the one name a did-you-mean offers, a conversion,
// a `use` line's path, a Rust label respelled, ...), or the `use` line or
// the `pub` that `volec fix` adds (its own tables: tools/fix). Such an
// error prints `try: volec fix --suggested ROOT`, which makes them all
// in one checked edit.

// The error being made is fixed by replacing SRC[start..end) with text
// (an insertion when start == end). Not in std's or a C header's text.
pub fn err_fix(start: i64, end: i64, text: [u8], pcx: inout Ctx<Comp>) {
    unsafe {
        if start < 0 || end < start || end > pcx.src_len
            || pcx.files[file_at(start, pcx)].path[0] == '<' {
            return;
        }
        if SRC[start..end] == text {
            return;
        }
        if pcx.err_fix_text < 0 {
            pcx.err_fix_text = buf_new();
        }
        buf_clear(pcx.err_fix_text);
        buf_bytes(pcx.err_fix_text, text);
        pcx.err_fix_start = start;
        pcx.err_fix_end = end;
        pcx.err_fixable = true;
    }
}

// (0.26.2) Whether the error being made has its fix already.
pub fn err_has_fix(pcx: Ctx<Comp>) -> bool {
    pcx.err_fixable
}

// The error being made is fixed by renaming the first whole word `old`
// from position `from` on (before the end of its statement) to `new`.
pub fn err_fix_word(from: i64, old: [u8], new: [u8], pcx: inout Ctx<Comp>) {
    if old.len == 0 || from < 0 {
        return;
    }
    let stop = if from + 1000 < pcx.src_len { from + 1000 } else { pcx.src_len };
    var i = from;
    while i + old.len as i64 <= stop && SRC[i] != ';' {
        if (i == 0 || !word_byte(SRC[i - 1])) && SRC[i..i + old.len as i64] == old
            && (i + old.len as i64 == pcx.src_len || !word_byte(SRC[i + old.len as i64])) {
            err_fix(i, i + old.len as i64, new, &pcx);
            return;
        }
        i += 1;
    }
}

// The error being made has a fix that `volec fix` makes from its own
// tables (a missing `use`, a missing `pub`).
pub fn err_fixable(pcx: inout Ctx<Comp>) {
    pcx.err_fixable = true;
}

fn word_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// The file of position pos.
fn file_at(pos: i64, pcx: Ctx<Comp>) -> i64 {
    var file = 0;
    while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[file + 1].start {
        file += 1;
    }
    file
}

// Whether the error at pos passes `--at FILE:LINE`: its line, in a file
// whose path is FILE's (either may have a directory the other has not).
pub fn fix_at_ok(pos: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.fix_at_file == 0 as *u8 {
        return true;
    }
    if pos_line(pos, &pcx) != pcx.fix_at_line {
        return false;
    }
    let a = plain_path(pcx.fix_at_file);
    let b = plain_path(pcx.files[file_at(pos, pcx)].path);
    a == b
        || (b.len > a.len && b[b.len as i64 - a.len as i64 - 1] == '/'
            && b[b.len as i64 - a.len as i64..] == a)
        || (a.len > b.len && a[a.len as i64 - b.len as i64 - 1] == '/'
            && a[a.len as i64 - b.len as i64..] == b)
}

// Path p without a leading `./`.
fn plain_path(p: *u8) -> [u8] {
    unsafe {
        var n = 0;
        while p[n] != 0 {
            n += 1;
        }
        if n > 2 && p[0] == '.' && p[1] == '/' { p[2..n] } else { p[0..n] }
    }
}

// Prints the error and exits:
//   error[<kind>]: <message>
//    --> <file>: line <line>, column <column>
//     = help: <help>
pub fn err_end(pcx: inout Ctx<Comp>) -> ! {
    unsafe {
        if pcx.errors_as_dump {
            var file = 0;
            while file + 1 < pcx.files.len() as i64 && pcx.err_pos >= pcx.files[file + 1].start {
                file += 1;
            }
            let out = buf_new();
            buf_fmt(out, format_args("error {}\n", pcx.err_pos - pcx.files[file].start));
            buf_write_fd(out, STDOUT);
            exit(0);
        }
        record_error_text(&pcx);
        err_jump(&pcx)
    }
}

// On after the innermost recovery point; at none (or after too many
// errors), the errors are printed and the compiler exits.
pub fn err_jump(pcx: inout Ctx<Comp>) -> ! {
    unsafe {
        if pcx.recover_depth > 0 && pcx.error_count < pcx.max_errors {
            _longjmp(pcx.recover_bufs.data[pcx.recover_depth - 1] as *u8, 1);
        }
        exit_if_errors(&pcx);
        if pcx.err_bail != 0 as *u8 {
            _longjmp(pcx.err_bail, 1);
        }
        exit(1)
    }
}

// An error whose text, `out`, is made by the caller (an error in a C
// header, which is not part of the source), sorted as if at pos.
pub fn err_end_text(pos: i64, out: i64, pcx: inout Ctx<Comp>) -> ! {
    err_begin(pos, &pcx);
    buf_bytes(pcx.err, buf_slice(out));
    let key = error_key(&pcx);
    if key >= 0 {
        record_error(key, out, &pcx);
    }
    err_jump(&pcx)
}

// (0.25.4) Whether `fix --suggested` refuses the error being made's fix
// before making it (tools/fix/verify: refusal_of; a conversion that loses
// the value, a cast of a cast, a call made to call itself): then no
// `try:` sends the agent there (its `note fix.refused` still says why).
fn fix_refused(pcx: Ctx<Comp>) -> bool {
    pcx.err_fix_start >= 0 && pcx.err_fix_text >= 0
        && crate::tools::fix::verify::refusal_of(pcx.err_fix_start, pcx.err_fix_end,
            pcx.err_fix_text, pcx).len > 0
}

// The error being made, as printed.
fn error_text(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        buf_fmt(out, format_args("error[{}]: {}\n --> ", cstr(pcx.err_kind), buf_slice(pcx.err)));
        buf_position(out, pcx.err_pos, &pcx);
        buf_byte(out, '\n');
        if BUFS[pcx.err_help].len > 0 {
            buf_fmt(out, format_args("  = help: {}\n", buf_slice(pcx.err_help)));
        }
        let notes = buf_slice(pcx.err_note);
        var s = 0;
        while s < notes.len as i64 {
            var e = s;
            while e < notes.len as i64 && notes[e] != '\n' {
                e += 1;
            }
            buf_fmt(out, format_args("  = note: {}\n", notes[s..e]));
            s = e + 1;
        }
        let tries = buf_slice(pcx.err_try);
        var a = 0;
        while a < tries.len as i64 {
            var e = a;
            while e < tries.len as i64 && tries[e] != '\n' {
                e += 1;
            }
            buf_fmt(out, format_args("  = try: {}\n", tries[a..e]));
            a = e + 1;
        }
        if pcx.err_fixable && !fix_refused(pcx) {
            buf_str(out, c"  = try: ");
            buf_tool_command(out, "fix --suggested", true, pcx);
            buf_byte(out, '\n');
        }
        // RULE: D22.2 (an opaque instance's error: at the template, no
        // instance named)
        if !pcx.opaque_phase {
            instantiation_notes(out, &pcx);
        }
        out
    }
}

// The key of the error being made, or -1 when it is not to be recorded:
// it names the error type, or it is already recorded (the same message at
// the same position: a generic function is checked per instance; 0.10).
// (0.25) Asked before its text is made: a query checks the generic
// functions no one instantiates, and a repeated error is not formatted.
fn error_key(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if ERR_POISONED {
            return -1;
        }
        // RULE: D22.2 (0.27.3, FL11: an opaque instance's errors are
        // recorded, and forgotten when the instance meets a gap of the model,
        // opaque_unsure, build_opaque_instances; one made while an instance
        // is made, a bound an Ω does not resolve, is the model's: the
        // instance is unsure)
        if pcx.opaque_phase && !pcx.opaque_sure && pcx.cur_inst < 0 {
            pcx.opaque_unsure = true;
            return -1;
        }
        // RULE: D22.2 (0.27.2.1: an opaque instance's error where one is
        // reported already, a concrete instance's: not again)
        if pcx.opaque_phase {
            var j = 0;
            while j < pcx.error_keys.count {
                if pcx.error_keys.data[j] == pcx.err_pos {
                    return -1;
                }
                j += 2;
            }
        }
        let key = intern(buf_slice(pcx.err), &pcx);
        var i = 0;
        while i < pcx.error_keys.count {
            if pcx.error_keys.data[i] == pcx.err_pos && pcx.error_keys.data[i + 1] == key {
                return -1;
            }
            i += 2;
        }
        key
    }
}

// Records the error being made (its text in `out`), under key (from
// error_key).
fn record_error(key: i64, out: i64, pcx: inout Ctx<Comp>) {
    pcx.error_keys.push(pcx.err_pos);
    pcx.error_keys.push(key);
    pcx.errors.push(pcx.err_pos);
    pcx.errors.push(out);
    pcx.error_count += 1;
    if pcx.err_fix_start >= 0 && fix_at_ok(pcx.err_pos, &pcx) {
        let text = buf_new();
        buf_bytes(text, buf_slice(pcx.err_fix_text));
        pcx.suggested.push(pcx.err_pos);
        pcx.suggested.push(pcx.err_fix_start);
        pcx.suggested.push(pcx.err_fix_end);
        pcx.suggested.push(text);
        let kind = intern(cstr(pcx.err_kind), &pcx);
        pcx.suggested_kind.push(kind);
    }
}

// Records the error being made, its text made by error_text, unless
// error_key says not to.
fn record_error_text(pcx: inout Ctx<Comp>) {
    let key = error_key(&pcx);
    if key >= 0 {
        record_error(key, error_text(&pcx), &pcx);
    }
}

// Like err_end, but the work goes on after the error (0.10): for errors
// that leave nothing undone, or whose callers make do (an unknown type is
// the error type, a duplicate is left out...).
pub fn err_end_soft(pcx: inout Ctx<Comp>) {
    record_error_text(&pcx);
    if pcx.error_count >= pcx.max_errors {
        exit_if_errors(&pcx);
    }
}

pub fn error_at_soft(pos: i64, message: *u8, pcx: inout Ctx<Comp>) {
    err_begin(pos, &pcx);
    err_str(message, pcx);
    err_end_soft(&pcx);
}

pub fn fail_name(name: i64, pcx: inout Ctx<Comp>) {
    pcx.failed_names.push(name);
}

pub fn name_failed(name: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        for i in 0..pcx.failed_names.count {
            if pcx.failed_names.data[i] == name {
                return true;
            }
        }
        false
    }
}

// The error being made says that `name` is unknown: it is not reported
// when name's declaration failed.
pub fn err_failed_name(name: i64, pcx: Ctx<Comp>) {
    if name_failed(name, pcx) {
        ERR_POISONED = true;
    }
}

// ---- Lines and columns (0.25) ----

// The line starts of each file, made on first use and read only as far
// as the positions asked for: a position's line is found by halves, not
// counted from its file's start. (A query's errors in std, one file of
// 48k lines, each counted its lines from the start: 37% of a cold query.)
pub struct LineIndex { src: *u8, start: i64, scanned: i64, starts: IntVec }

const STD_MARK_LINES: i64 = 64;

extern "C" {
    fn memchr(s: *u8, c: i32, n: u64) -> *u8;
}

// The line (from 1) of position pos in file `file`, and its column
// (from 1) through `col`: as counted from the file's start up to pos,
// and not past the end of SRC.
pub fn file_line_col(file: i64, pos: i64, col: inout i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let start = pcx.files[file].start;
        let p = if pos < pcx.src_len { pos } else { pcx.src_len };
        if p <= start {
            col = 1;
            return 1;
        }
        if file == pcx.std_text_file {
            let line = std_line_col(start, p, &col, &pcx);
            if line > 0 {
                return line;
            }
        }
        if file >= pcx.line_index_cap {
            let cap = if pcx.files.len() as i64 > file { pcx.files.len() as i64 } else { file + 1 };
            let grown = alloc_zeroed(cap * size_of(LineIndex)) as *LineIndex;
            if pcx.line_index_cap > 0 {
                memcpy(grown as *u8, pcx.line_index as *u8,
                    (pcx.line_index_cap * size_of(LineIndex)) as u64);
                free(pcx.line_index as *u8);
            }
            pcx.line_index = grown;
            pcx.line_index_cap = cap;
        }
        let x = &pcx.line_index[file] as *LineIndex;
        // (the sources are only added to, so a file's text is the same
        // while SRC is; SRC changes when they grow, and while `fmt` lexes
        // a text of its own)
        if (*x).src != SRC.ptr || (*x).start != start {
            (*x).src = SRC.ptr;
            (*x).start = start;
            (*x).scanned = start;
            (*x).starts.count = 0;
            (*x).starts.push(start);
        }
        while (*x).scanned < p {
            let at = (*x).scanned;
            let found = memchr(&SRC.ptr[at], '\n' as i32, (p - at) as u64);
            if found == 0 as *u8 {
                (*x).scanned = p;
            } else {
                let nl = at + (found as i64 - &SRC.ptr[at] as i64);
                (*x).starts.push(nl + 1);
                (*x).scanned = nl + 1;
            }
        }
        // the last line start at or before p
        let starts = (*x).starts.data;
        var lo = 0;
        var hi = (*x).starts.count;
        while hi - lo > 1 {
            let mid = (lo + hi) / 2;
            if starts[mid] <= p {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        col = p - starts[lo] + 1;
        lo + 1
    }
}

// The line of position p (after start) in std's built-in text, which
// starts at start, and its column through col: counted from the last
// mark at or before p (the marks read on first use); 0 when the marks do
// not fit the text (file_line_col counts then).
fn std_line_col(start: i64, p: i64, col: inout i64, pcx: inout Ctx<Comp>) -> i64 {
    // UNSAFE: the compiler's static variables (STD_MARKS, SRC) and C's
    // memchr, as in file_line_col.
    // SAFETY: the front end runs on one thread; marks are read below
    // STD_MARKS.count; SRC is read below p (at most SRC_LEN, file_line_col)
    // and at a mark's byte before, a mark at or before p - start.
    unsafe {
        if pcx.std_marks.count == 0 {
            let b = buf_new();
            std_line_marks(b);
            let s = buf_slice(b);
            var n = 0;
            var digits = false;
            for i in 0..s.len {
                let c = s[i];
                if c >= '0' && c <= '9' {
                    n = n * 10 + (c - '0') as i64;
                    digits = true;
                } else if digits {
                    pcx.std_marks.push(n);
                    n = 0;
                    digits = false;
                }
            }
            if digits {
                pcx.std_marks.push(n);
            }
            buf_clear(b);
        }
        let marks = pcx.std_marks.data;
        var lo = 0;
        var hi = pcx.std_marks.count;
        if hi == 0 {
            return 0;
        }
        while hi - lo > 1 {
            let mid = (lo + hi) / 2;
            if marks[mid] <= p - start {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        if lo > 0 && SRC.ptr[start + marks[lo] - 1] != '\n' {
            return 0;
        }
        var line = lo * STD_MARK_LINES + 1;
        var at = start + marks[lo];
        while at < p {
            let found = memchr(&SRC.ptr[at], '\n' as i32, (p - at) as u64);
            if found == 0 as *u8 {
                break;
            }
            at = at + (found as i64 - &SRC.ptr[at] as i64) + 1;
            line += 1;
        }
        // (at: the start of p's line)
        col = p - at + 1;
        line
    }
}

// `<file>: line <line>, column <column>` of position pos.
pub fn buf_position(out: i64, pos: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let file = file_at(pos, pcx);
        var col = 1;
        let line = file_line_col(file, pos, &col, &pcx);
        // (0.16: a module next to a root given without a directory is
        // `x.vl`, not `./x.vl`)
        let path = pcx.files[file].path;
        buf_str(out, if path[0] == '.' && path[1] == '/' { &path[2] } else { path });
        buf_fmt(out, format_args(": line {line}, column {col}"));
    }
}

// (0.17) The line of position pos in its file.
pub fn pos_line(pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    var col = 1;
    file_line_col(file_at(pos, pcx), pos, &col, &pcx)
}

// (0.17) `FILE:LINE` of position pos, as the tools take an item's
// position (`volec edit delete main.vl:12`).
pub fn buf_file_line(out: i64, pos: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var file = 0;
        while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[file + 1].start {
            file += 1;
        }
        let path = pcx.files[file].path;
        buf_str(out, if path[0] == '.' && path[1] == '/' { &path[2] } else { path });
        buf_byte(out, ':');
        buf_int(out, pos_line(pos, &pcx));
    }
}

pub fn error_at(pos: i64, message: *u8, pcx: inout Ctx<Comp>) -> ! {
    err_begin(pos, &pcx);
    err_str(message, pcx);
    err_end(&pcx)
}
