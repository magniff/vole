// Drop shims (0.26.1, request R2 of the code generators' agent;
// docs/design/places-ir.md §3.9): what `drop(P)` of a type T runs, made
// once per type as a body of its own (rustc's `drop_in_place::<T>`), from
// the type: `_1: &mut T`, then
//
// - T's `Drop::drop(&mut *_1)` when it has one;
// - std's containers (Vec, Buf, HashMap, ...): that only;
// - a struct or a tuple: `drop((*_1).k)` of each field with glue, in
//   declaration order; a sink closure's capture under its `__live_` flag
//   field (a switch on it);
// - an enum: a switch on its discriminant, the glue fields of each
//   variant dropped in their block (`drop(((*_1) as V).k)`);
// - an array: a counted loop, `drop((*_1)[_i])`.
//
// Each of its drops is DS_KEPT (a place through `*` has no move path): a
// code generator lowers it as a call of the shim of its type, made on
// demand by shim_of, so the list grows while the bodies (and the shims)
// are lowered. A shim is not a program item: its body is built when asked
// (build_shim), into the P_* tables like any body, B_FN -1 and B_SHIM its
// id. The glue's rules are front/own/glue.vl's (push_glue), which the own
// pass's drops still run until 0.26.1's step 7.

use crate::base::{buf_new, buf_slice, buf_str, intern, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::generics::mangle_type;
use crate::front::kinds::{has_drop_impl, owned_base_type};
use crate::front::types::{REF_MUT, TY_BOOL, TY_I64, TY_UNIT, TyKind, fn_param, ref_to, type_elem};
use crate::places::front::{
    enum_tag_ty, enum_variant_count, enum_variants, fn_name_sym, fn_node, fn_self_ty, fn_template,
    struct_field_name, variant_discr,
};
use crate::places::glue::{flag_field, has_glue};
use crate::places::ir::{
    BK_MUT, BO_ADD, BO_LT, Body, DS_KEPT, LF_MUT, LF_PARAM, LF_RETURN, LF_TEMP, OK_COPY, OK_INT,
    OK_MOVE, OK_PLACE, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_VARIANT, RV_BINARY, RV_DISCR, RV_REF,
    RV_USE, SK_ASSIGN, SK_CALL, SK_DROP, TK_GOTO, TK_RETURN, TK_SWITCH, body_begin, emit,
    enter_block, full_place_type, new_block, new_local, ops_mark, proj, push_op, struct_field_count,
    struct_field_ty, terminate, undistinct, variant_field_count, variant_part_type,
};

// The shim of type t (made now when t has none): what `drop(P)` of a
// place of type t calls with `&mut P`. t must have glue (has_glue).
pub fn shim_of(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let u = undistinct(t, pcx);
    let key = shim_key(u, pcx);
    while pcx.shim_of.len() as i64 <= key {
        pcx.shim_of.push(0);
    }
    if pcx.shim_of[key as usize] > 0 {
        return pcx.shim_of[key as usize] - 1;
    }
    pcx.shim_ty.push(u);
    let id = pcx.shim_ty.len() as i64 - 1;
    pcx.shim_of[key as usize] = id + 1;
    pcx.shim_fn.push(-1);
    id
}

// (0.26.2, R11) The type shims are found by: t with every distinct type
// in it erased (front/distinct.vl erase_type, its whole mode). The IR is
// built before the erasure and the code generators read it after:
// a local keeps its type as built, `(str, Matches)`, while a field's or a
// variant's comes from the tables erase_program_types rewrote,
// `([u8], Matches)`; both must find the one shim.
fn shim_key(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    crate::front::distinct::erase_type(undistinct(t, pcx), pcx)
}

// The number of shims made so far (it grows as shims are asked for).
pub fn shim_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.shim_ty.len() as i64
}

// The type shim `id` drops.
pub fn shim_type(id: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.shim_ty[id as usize]
}

// The symbol of shim id's function: `$drop.G` and its type mangled (the
// type's code, stable from one compilation to the next).
pub fn shim_fn_symbol(id: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    buf_str(out, c"$drop.G");
    mangle_type(out, pcx.shim_ty[id as usize], pcx);
    intern(buf_slice(out), pcx)
}

// ---- The body ----

// Shim id's body built into the P_* tables (ir.vl), as a body's: _0 `()`,
// _1 `&mut T`.
pub fn build_shim(id: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let t = pcx.shim_ty[id as usize];
    body_begin(-1, 0, pbody);
    pbody.shim = id;
    pbody.params = 1;
    pcx.s_t = t;
    new_local(TY_UNIT, LF_RETURN, -1, 0, pbody);
    new_local(ref_to(t, REF_MUT, pcx), LF_PARAM, -1, 0, pbody);
    pcx.s_unit = new_local(TY_UNIT, LF_TEMP, -1, 0, pbody);
    let entry = new_block(pbody);
    let ret = new_block(pbody);
    enter_block(entry, pbody);
    // (the place *_1)
    let root = proj(0, PJ_DEREF, 0, pbody);
    glue(t, root, pbody, pcx);
    goto(ret, pbody);
    enter_block(ret, pbody);
    terminate(TK_RETURN, 0, 0, 0, 0, 0, 0, pbody);
}

fn goto(b: i64, pbody: &mut Body<Comp>) {
    terminate(TK_GOTO, b, 0, 0, 0, 0, 0, pbody);
}

// The glue of a value of type t at place (_1, p): its statements emitted.
fn glue(t: i64, p: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if has_drop_impl(t, pcx) {
        let f = drop_fn(t, pbody, pcx);
        if f < 0 {
            // (the own pass's glue made every instance a drop calls, until
            // 0.26.1's step 7)
            crate::base::die(c"places: a drop shim found no Drop::drop instance for its type");
        }
        // `_r = &mut (*_1)...; drop(move _r)`
        let r = new_local(fn_param(f, 0, pcx), LF_TEMP, -1, 0, pbody);
        let m = ops_mark(pbody);
        push_op(OK_PLACE, 1, p, pbody);
        emit(SK_ASSIGN, r, 0, RV_REF, BK_MUT, 0, m, 1, 0, pbody);
        let m2 = ops_mark(pbody);
        push_op(OK_MOVE, r, 0, pbody);
        emit(SK_CALL, pcx.s_unit, 0, f, 0, 0, m2, 1, 0, pbody);
    }
    if owned_base_type(t, pcx) {
        return;
    }
    let kind = pcx.types[t as usize].kind;
    if kind == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        let closure = crate::places::ir::struct_closure(t, pcx);
        for k in 0..struct_field_count(s, pcx) {
            let ft = struct_field_ty(s, k, pcx);
            if !has_glue(ft, pcx) {
                continue;
            }
            let flag: i64 = if closure { flag_field(s, struct_field_name(s, k, pcx), pcx) }
                else { 0 };
            if flag == 0 {
                drop_part(ft, proj(p, PJ_FIELD, k, pbody), pbody);
                continue;
            }
            // (a sink closure's capture, if it still holds it: `switch copy
            // (*_1).__live_x [0: next, otherwise: then]`)
            let fk = field_index(s, flag, pcx);
            let then = new_block(pbody);
            let next = new_block(pbody);
            let m = ops_mark(pbody);
            push_op(OK_COPY, 1, proj(p, PJ_FIELD, fk, pbody), pbody);
            switch_bool(m, next, then, pbody);
            enter_block(then, pbody);
            drop_part(ft, proj(p, PJ_FIELD, k, pbody), pbody);
            goto(next, pbody);
            enter_block(next, pbody);
        }
    } else if kind == TyKind::Tuple {
        for k in 0..pcx.types[t as usize].count {
            let et = type_elem(t, k, pcx);
            if has_glue(et, pcx) {
                drop_part(et, proj(p, PJ_FIELD, k, pbody), pbody);
            }
        }
    } else if kind == TyKind::Array {
        array_loop(pcx.types[t as usize].a, pcx.types[t as usize].b, p, pbody);
    } else if kind == TyKind::Enum {
        enum_switch(t, p, pbody, pcx);
    }
}

// `drop((_1, p))`, decided: kept (a code generator calls t's shim).
fn drop_part(t: i64, p: i64, pbody: &mut Body<Comp>) {
    emit(SK_DROP, 1, p, DS_KEPT, -1, -1, 0, 0, 0, pbody);
}

// The index of the field of struct s named `name`.
fn field_index(s: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    for k in 0..struct_field_count(s, pcx) {
        if struct_field_name(s, k, pcx) == name {
            return k;
        }
    }
    -1
}

// A switch on the bool operand at m: false to f, true to t.
fn switch_bool(m: i64, f: i64, t: i64, pbody: &mut Body<Comp>) {
    let ti = pbody.targets.len() as i64;
    pbody.targets.push(0);
    pbody.targets.push(f);
    terminate(TK_SWITCH, ti, 1, t, m, 1, 0, pbody);
}

// `_i = 0; head: _c = _i < n; switch _c [0: exit, otherwise: body]; body:
// drop((_1, p)[_i]); _i = _i + 1; goto head; exit:`.
fn array_loop(elem: i64, n: i64, p: i64, pbody: &mut Body<Comp>) {
    let i = new_local(TY_I64, LF_TEMP | LF_MUT, -1, 0, pbody);
    let c = new_local(TY_BOOL, LF_TEMP, -1, 0, pbody);
    let m = ops_mark(pbody);
    push_op(OK_INT, 0, TY_I64, pbody);
    emit(SK_ASSIGN, i, 0, RV_USE, 0, 0, m, 1, 0, pbody);
    let head = new_block(pbody);
    let body = new_block(pbody);
    let exit = new_block(pbody);
    goto(head, pbody);
    enter_block(head, pbody);
    let m2 = ops_mark(pbody);
    push_op(OK_COPY, i, 0, pbody);
    push_op(OK_INT, n, TY_I64, pbody);
    emit(SK_ASSIGN, c, 0, RV_BINARY, BO_LT, 0, m2, 2, 0, pbody);
    let m3 = ops_mark(pbody);
    push_op(OK_COPY, c, 0, pbody);
    switch_bool(m3, exit, body, pbody);
    enter_block(body, pbody);
    drop_part(elem, proj(p, PJ_INDEX, i, pbody), pbody);
    let m4 = ops_mark(pbody);
    push_op(OK_COPY, i, 0, pbody);
    push_op(OK_INT, 1, TY_I64, pbody);
    emit(SK_ASSIGN, i, 0, RV_BINARY, BO_ADD, 0, m4, 2, 0, pbody);
    // (the back edge of an uncounted loop)
    terminate(TK_GOTO, head, 0, 1, 0, 0, 0, pbody);
    enter_block(exit, pbody);
}

// `_d = discriminant((_1, p)); switch _d [discr(V): bbV, ..., otherwise:
// next]`, bbV dropping V's fields that have glue.
fn enum_switch(t: i64, p: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let first = enum_variants(t, pcx);
    let count = enum_variant_count(t, pcx);
    let mut arms: i64 = 0;
    for i in 0..count {
        if variant_glue(first + i, pcx) {
            arms += 1;
        }
    }
    if arms == 0 {
        return;
    }
    let d = new_local(enum_tag_ty(t, pcx), LF_TEMP, -1, 0, pbody);
    let m = ops_mark(pbody);
    push_op(OK_PLACE, 1, p, pbody);
    emit(SK_ASSIGN, d, 0, RV_DISCR, 0, 0, m, 1, 0, pbody);
    let next = new_block(pbody);
    let ti = pbody.targets.len() as i64;
    // (the arms' blocks, made before the switch names them)
    let arm0 = crate::places::ir::block_count(pbody);
    for i in 0..count {
        let v = first + i;
        if variant_glue(v, pcx) {
            pbody.targets.push(variant_discr(v, pcx));
            let pbody_arg = new_block(pbody);
            pbody.targets.push(pbody_arg);
        }
    }
    let m2 = ops_mark(pbody);
    push_op(OK_COPY, d, 0, pbody);
    terminate(TK_SWITCH, ti, arms, next, m2, 1, 0, pbody);
    let mut b = arm0;
    for i in 0..count {
        let v = first + i;
        if !variant_glue(v, pcx) {
            continue;
        }
        enter_block(b, pbody);
        b += 1;
        let vp = proj(p, PJ_VARIANT, v, pbody);
        for k in 0..variant_field_count(v, pcx) {
            let ft = variant_part_type(v, k, pcx);
            if has_glue(ft, pcx) {
                drop_part(ft, proj(vp, PJ_FIELD, k, pbody), pbody);
            }
        }
        goto(next, pbody);
    }
    enter_block(next, pbody);
}

// Whether variant v has a field with glue.
fn variant_glue(v: i64, pcx: &mut Ctx<Comp>) -> bool {
    for k in 0..variant_field_count(v, pcx) {
        if has_glue(variant_part_type(v, k, pcx), pcx) {
            return true;
        }
    }
    false
}

// ---- Drop::drop's instance of a type ----

// The function `t.drop()` calls (t has an `impl Drop`): its method, or
// the instance of its generic impl's method for t. That instance is one
// the checker made already, or one made and checked now (the checker's
// way: instantiate_call on a `drop()` call of no arguments, then the
// instances it queued), so that a shim never lacks one; a method std
// declares and nothing calls is checked now too (check_lazy_drop); -1 only
// when t has no `drop` method.
fn drop_fn(t: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.shim_sym_drop == 0 {
        pcx.shim_sym_drop = intern_c(c"drop", pcx);
    }
    let mut f0 = crate::front::check::calls::method_of(t, pcx.shim_sym_drop, pcx);
    // RULE: F5.1 (0.27.3: the drop of a pattern impl, `impl<T> Drop for
    // IntoIter<T, [T; N]>`: found by its header, as a call finds it)
    if f0 < 0 {
        f0 = crate::front::check::calls::pattern_method_via(t, pcx.shim_sym_drop,
            pcx.drop_trait, pcx);
    }
    if f0 < 0 {
        return f0;
    }
    if !crate::places::front::fn_generic(f0, pcx) {
        check_lazy_drop(f0, pbody, pcx);
        return f0;
    }
    scan_drop_instances(pcx);
    if t < pcx.drop_of.len() as i64 && pcx.drop_of[t as usize] > 0 {
        return pcx.drop_of[t as usize] - 1;
    }
    let f = make_drop_instance(f0, t, pbody, pcx);
    while pcx.drop_of.len() as i64 <= t {
        pcx.drop_of.push(0);
    }
    pcx.drop_of[t as usize] = f + 1;
    f
}

pub fn late_drop_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.late_drops.len() as i64
}

pub fn late_drop(i: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.late_drops[i as usize]
}

// Method f0 (a `drop`, not generic): checked now when it is a lazy std
// function not checked yet, with the instances it queues, as a call of it
// would have (assoc.vl ensure_checked).
fn check_lazy_drop(f0: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let item = fn_node(f0, pcx);
    if item <= 0 || (pcx.nodes[item as usize].p & crate::front::ast::FN_LAZY) == 0 {
        return;
    }
    let at: i64 = if pbody.fn_ >= 0 { pcx.nodes[fn_node(pbody.fn_, pcx) as usize].start }
        else { 0 };
    let n = new_node(NodeKind::MethodCall, at, at, pcx);
    pcx.nodes[n as usize].b = pcx.shim_sym_drop;
    let mark = list_begin(pcx);
    list_end(n, mark, pcx);
    let q = pcx.inst_queue.len() as i64;
    crate::front::assoc::ensure_checked(f0, n, pcx);
    if pcx.inst_queue.len() as i64 == q {
        return;
    }
    check_late(q, pcx);
}

// The functions queued from INST_QUEUE[q..] checked (a drop method and the
// lazy std functions it calls), those run_places has gone past kept for
// it to build (LATE_DROPS).
fn check_late(q: i64, pcx: &mut Ctx<Comp>) {
    crate::front::check::check_queued_instances(q, pcx);
    for i in q..pcx.inst_queue.len() as i64 {
        let g = pcx.inst_queue[i as usize];
        if g < pcx.next_fn {
            pcx.late_drops.push(g);
        }
    }
}

// The `Drop::drop` instances made since the last scan, by their
// receiver's type (DROP_OF).
fn scan_drop_instances(pcx: &mut Ctx<Comp>) {
    while pcx.drop_scanned < pcx.fns.len() as i64 {
        let f = pcx.drop_scanned;
        pcx.drop_scanned += 1;
        let tf = fn_template(f, pcx);
        if tf == f || fn_name_sym(tf, pcx) != pcx.shim_sym_drop
            || crate::places::front::fn_generic(f, pcx) {
            continue;
        }
        let st = fn_self_ty(f, pcx);
        if st <= 0 {
            continue;
        }
        while pcx.drop_of.len() as i64 <= st {
            pcx.drop_of.push(0);
        }
        if pcx.drop_of[st as usize] == 0 {
            pcx.drop_of[st as usize] = f + 1;
        }
    }
}

// The instance of template f0 (a generic impl's `drop`) for receiver type
// t, made as synth_method makes a method's (a `drop()` call node at the
// body's function, for the messages), and checked with what it queues.
fn make_drop_instance(f0: i64, t: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let at: i64 = if pbody.fn_ >= 0 { pcx.nodes[fn_node(pbody.fn_, pcx) as usize].start }
        else { 0 };
    let n = new_node(NodeKind::MethodCall, at, at, pcx);
    pcx.nodes[n as usize].b = pcx.shim_sym_drop;
    let mark = list_begin(pcx);
    list_end(n, mark, pcx);
    let q = pcx.inst_queue.len() as i64;
    let f = crate::front::generics::instantiate::instantiate_call(f0, n, 1, t, 0, pcx);
    crate::front::assoc::ensure_checked(f, n, pcx);
    check_late(q, pcx);
    pcx.drop_made += 1;
    f
}

// The shim's name, for --emit-places: `drop_in_place::<T>`.
pub fn buf_shim_name(out: i64, id: i64, pcx: &Ctx<Comp>) {
    buf_str(out, c"drop_in_place::<");
    crate::front::types::buf_type(out, pcx.shim_ty[id as usize], pcx);
    buf_str(out, c">");
}

// ---- The functions a drop calls (effects' drop edges) ----

// The number of drop functions dropping a value of type t calls (its
// shim, inlined: no shim is a node of the call graph), each drop_fn_at.
pub fn drop_fn_count(t0: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let t = undistinct(t0, pcx);
    make_drop_fns(t, pbody, pcx);
    if t < pcx.df_at.len() as i64 && pcx.df_at[t as usize] > 0 { pcx.df_n[t as usize] } else { 0 }
}

pub fn drop_fn_at(t0: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let t = undistinct(t0, pcx);
    pcx.df_list[(pcx.df_at[t as usize] - 1 + i) as usize]
}

fn make_drop_fns(t: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if t <= 0 || !has_glue(t, pcx) {
        return;
    }
    while pcx.df_at.len() as i64 <= t {
        pcx.df_at.push(0);
        pcx.df_n.push(0);
    }
    if pcx.df_at[t as usize] != 0 {
        return;
    }
    pcx.df_at[t as usize] = -1;
    let mark = pcx.df_tmp.len() as i64;
    if has_drop_impl(t, pcx) {
        let f = drop_fn(t, pbody, pcx);
        if f >= 0 {
            pcx.df_tmp.push(f);
        }
    }
    if !owned_base_type(t, pcx) {
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            for k in 0..struct_field_count(s, pcx) {
                add_part(struct_field_ty(s, k, pcx), mark, pbody, pcx);
            }
        } else if kind == TyKind::Tuple {
            for k in 0..pcx.types[t as usize].count {
                add_part(type_elem(t, k, pcx), mark, pbody, pcx);
            }
        } else if kind == TyKind::Array {
            add_part(pcx.types[t as usize].a, mark, pbody, pcx);
        } else if kind == TyKind::Enum {
            let first = enum_variants(t, pcx);
            for i in 0..enum_variant_count(t, pcx) {
                for k in 0..variant_field_count(first + i, pcx) {
                    add_part(variant_part_type(first + i, k, pcx), mark, pbody, pcx);
                }
            }
        }
    }
    pcx.df_at[t as usize] = pcx.df_list.len() as i64 + 1;
    pcx.df_n[t as usize] = pcx.df_tmp.len() as i64 - mark;
    for i in mark..pcx.df_tmp.len() as i64 {
        let f = pcx.df_tmp[i as usize];
        pcx.df_list.push(f);
    }
    pcx.df_tmp.truncate(mark as usize);
}

// The drop functions of part type pt added to those being collected from
// mark (each once).
fn add_part(pt0: i64, mark: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let pt = undistinct(pt0, pcx);
    if !has_glue(pt, pcx) {
        return;
    }
    make_drop_fns(pt, pbody, pcx);
    if pcx.df_at[pt as usize] <= 0 {
        return;
    }
    for i in 0..pcx.df_n[pt as usize] {
        let f = pcx.df_list[(pcx.df_at[pt as usize] - 1 + i) as usize];
        let mut seen = false;
        for j in mark..pcx.df_tmp.len() as i64 {
            if pcx.df_tmp[j as usize] == f {
                seen = true;
            }
        }
        if !seen {
            pcx.df_tmp.push(f);
        }
    }
}

// ---- Shims as functions (at a build whose code generators read the IR) ----

// Whether function f is a drop shim's (make_shim_functions).
pub fn is_shim_fn(f: i64, pcx: &Ctx<Comp>) -> bool {
    f >= 0 && f < pcx.is_shim.len() as i64 && pcx.is_shim[f as usize]
}

// The function of shim id (-1: not made).
pub fn shim_fn(id: i64, pcx: &Ctx<Comp>) -> i64 {
    if id < pcx.shim_fn.len() as i64 { pcx.shim_fn[id as usize] } else { -1 }
}

// The function `drop(P)` of a place of type t calls with `&mut P` (its
// shim's), -1 when t has none (no glue, or no body kept that drops one).
pub fn drop_shim_fn(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let key = shim_key(t, pcx);
    if key <= 0 || key >= pcx.shim_of.len() as i64 || pcx.shim_of[key as usize] == 0 {
        return -1;
    }
    shim_fn(pcx.shim_of[key as usize] - 1, pcx)
}

// (0.26.2, R11; --verify-places) Whether a drop of type t that runs
// finds its shim as the code generators look for it: t asked for
// (shim_of), then found again by t with its distinct types erased, as a
// field's or a variant's type is when they read it (erase_program_types
// runs between the two).
pub fn shim_found(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    let id = shim_of(t, pcx);
    let key = shim_key(crate::front::distinct::erase_type(t, pcx), pcx);
    key > 0 && key < pcx.shim_of.len() as i64 && pcx.shim_of[key as usize] == id + 1
}

// run_places, every body kept: each shim asked for (and the shims their
// drops ask for) made a function, its body built and kept like a
// function's. A shim is then a function like any (FNS, a Fn node, a
// parameter `_1: &mut T` with an AST local, its symbol shim_fn_symbol),
// made before the code generators size their tables by FN_COUNT, but not
// a program item: a code generator lowers them by shim_count and shim_fn.
pub fn make_shim_functions(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let mut id: i64 = 0;
    while id < shim_count(pcx) {
        build_shim(id, pbody, pcx);
        for s in 0..pbody.stmts.len() {
            let st = pbody.stmts[s];
            if st.kind == SK_DROP && st.c == DS_KEPT {
                shim_of(full_place_type(st.a, st.b, pbody, pcx), pcx);
            }
        }
        let f = shim_function(id, pcx);
        pbody.fn_ = f;
        pbody.node = fn_node(f, pcx);
        crate::places::keep::keep_body(pbody, pcx);
        id += 1;
    }
}

// Shim id's function: a Fn node (no body: the IR is the body) with its
// parameter, an AST local for it, the FNS entry.
fn shim_function(id: i64, pcx: &mut Ctx<Comp>) -> i64 {
    while pcx.shim_fn.len() as i64 <= id {
        pcx.shim_fn.push(-1);
    }
    if pcx.shim_fn[id as usize] >= 0 {
        return pcx.shim_fn[id as usize];
    }
    let t = pcx.shim_ty[id as usize];
    let pt = ref_to(t, REF_MUT, pcx);
    let name = shim_fn_symbol(id, pcx);
    let shown = buf_new();
    buf_shim_name(shown, id, pcx);
    let display = intern(buf_slice(shown), pcx);
    let item = new_node(NodeKind::Fn, 0, 0, pcx);
    pcx.nodes[item as usize].a = name;
    let p = new_node(NodeKind::Param, 0, 0, pcx);
    let self_sym = intern_c(c"self", pcx);
    pcx.nodes[p as usize].a = self_sym;
    pcx.nodes[p as usize].ty = pt;
    // (an AST local for the parameter, as a checked function's: the code
    // generators bind it; not in any scope)
    let l = crate::front::check::define_local(self_sym, pt, false, true, pcx);
    pcx.env.pop().unwrap();
    pcx.nodes[p as usize].x = l;
    let mark = list_begin(pcx);
    list_push(p, pcx);
    list_end(item, mark, pcx);
    crate::front::check::collect::add_fn(item, name, display, pcx);
    let f = pcx.fns.len() as i64 - 1;
    crate::places::front::fn_set_shim_signature(f, pt, pcx);
    pcx.shim_fn[id as usize] = f;
    while pcx.is_shim.len() as i64 <= f {
        pcx.is_shim.push(false);
    }
    pcx.is_shim[f as usize] = true;
    f
}
