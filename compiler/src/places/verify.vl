// `--verify-places` (0.26.0, docs/design/places-ir.md §7.3): the body
// held is checked, and each problem printed on stderr as one line,
// `places.verify: FN bbK[i]: WHAT`:
//
// - its form (§3.6): every block entered ends in one terminator, its
//   statements are not terminators, the ranges do not overlap, every
//   target is a block that was entered, and no block is left open;
// - its places: each operand's local exists and its projections apply to
//   the type they are taken of; an index is a local;
// - the copy rule (§3.3), under --values=error: a `copy` of a place whose
//   type needs drop only as the value of a BORROWED local or of a
//   BORROWED local's place (a borrowed copy of a borrowed copy), and no
//   `move` out of a BORROWED local;
// - each `as V` dominated by a `switch` on the discriminant of the place
//   it is taken of;
// - no use of a local outside its storage: with a StorageLive anywhere in
//   the body, a local is used only where it is live on every path;
// - (0.26.2) each drop that runs (kept, or under a flag) of a type with
//   glue finds its shim as the code generators look for it, the type's
//   distinct types erased (shim.vl shim_found).
//
// The count of problems is VERIFY_ERRORS; the driver (places/mod.vl)
// stops with exit 1 when it is not 0.

use crate::base::{STDERR, buf_int, buf_new, buf_str, buf_write_fd};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::drops::drops_on;
use crate::front::types::{REF_MUT, REF_SHARED, TyKind};
use crate::places::cfg::{compute_idom, compute_preds, compute_rpo, in_graph};
use crate::places::glue::has_glue;
use crate::places::ir::{
    Body, DS_FLAG, DS_KEPT, LF_BORROWED, LF_PARAM, LF_RETURN, LF_STATIC, OK_COPY, OK_MOVE, PJ_INDEX,
    PJ_VARIANT, RV_CAST, RV_DISCR, RV_USE, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC,
    SK_LIVE, SK_MENTION, TK_SWITCH, block_count, block_len, block_start, block_term,
    full_place_type, has_flag, is_terminator, local_count, op_a, op_b, op_is_place, op_kind,
    place_type, proj_kind, proj_parent, proj_val, succ, succ_count, undistinct,
};

fn problem(what: &[u8], pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !pcx.report {
        return;
    }
    pcx.verify_errors += 1;
    let out = buf_new();
    buf_str(out, c"places.verify: ");
    crate::places::print::buf_body_name(out, pbody, pcx);
    buf_str(out, c" bb");
    buf_int(out, pcx.at_block);
    buf_str(out, c"[");
    buf_int(out, pcx.at_stmt);
    buf_str(out, c"]: ");
    crate::base::buf_bytes(out, what);
    buf_str(out, c"\n");
    buf_write_fd(out, STDERR);
}

// Checks the body held.
pub fn verify_body(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    pcx.report = true;
    pcx.at_block = -1;
    pcx.at_stmt = -1;
    if pbody.cur_block >= 0 {
        problem(b"a block is left open (no terminator)", pbody, pcx);
    }
    if !verify_form(pbody, pcx) {
        return;
    }
    compute_preds(pbody);
    compute_rpo(pbody);
    compute_idom(pbody);
    for b in 0..block_count(pbody) {
        if !in_graph(b, pbody) {
            continue;
        }
        pcx.at_block = b;
        let start = block_start(b, pbody);
        for s in start..start + block_len(b, pbody) + 1 {
            pcx.at_stmt = s - start;
            verify_stmt(s, b, pbody, pcx);
        }
    }
    verify_storage(pbody, pcx);
    verify_mut_copies(pbody, pcx);
    // (0.27.1) a rust-edition body's region slots, one variable bound to
    // each slot of each local's type (D3.3)
    let slots = buf_new();
    let bad = crate::places::regions::verify_slots(slots, pbody, pcx);
    if bad > 0 && pcx.report {
        pcx.verify_errors += bad;
        let out = buf_new();
        buf_str(out, c"places.verify: ");
        crate::places::print::buf_body_name(out, pbody, pcx);
        buf_str(out, c": region slots\n");
        crate::base::buf_bytes(out, crate::base::buf_slice(slots));
        buf_write_fd(out, STDERR);
    }
}

// (0.27.1, borrowck.md I7) In a rust-edition body no operand copies a
// whole `&mut T`: it moves or is reborrowed (D3.6); a mutable view given
// to a call, or into a shared view, is copied, which D3.6 reads as its
// reborrow.
fn verify_mut_copies(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if pbody.fn_ < 0 || !crate::places::regions::rust_operands(pbody.fn_, pcx) {
        return;
    }
    for b in 0..block_count(pbody) {
        if !in_graph(b, pbody) {
            continue;
        }
        pcx.at_block = b;
        let start = block_start(b, pbody);
        for s in start..start + block_len(b, pbody) + 1 {
            pcx.at_stmt = s - start;
            let st = pbody.stmts[s as usize];
            for i in 0..st.nops {
                if op_kind(st.ops, i, pbody) != OK_COPY {
                    continue;
                }
                let t = undistinct(place_type(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody),
                    pbody, pcx), pcx);
                if t <= 0 || pcx.types[t as usize].b != REF_MUT {
                    continue;
                }
                let k = pcx.types[t as usize].kind;
                // (a mutable view copied into a shared one is its shared
                // reborrow, `let s: &[T] = s;`)
                let dt: i64 = if st.kind == SK_ASSIGN && st.a >= 0 {
                    undistinct(place_type(st.a, st.b, pbody, pcx), pcx)
                } else { 0 };
                let shared_dest = dt > 0 && pcx.types[dt as usize].kind == TyKind::Slice
                    && pcx.types[dt as usize].b != REF_MUT;
                // RULE: R1 (`w as *mut W`: a cast to a raw pointer reads the
                // reference, as rustc's `&raw mut *w`; no loan, no copy of it
                // lives on as a reference)
                let raw_cast = st.kind == SK_ASSIGN && st.c == RV_CAST && dt > 0
                    && (pcx.types[dt as usize].kind == TyKind::Ptr
                        && pcx.types[dt as usize].b != REF_MUT
                        && pcx.types[dt as usize].b != REF_SHARED
                        || pcx.types[dt as usize].kind == TyKind::Slice
                        && pcx.types[dt as usize].b != REF_MUT
                        && pcx.types[dt as usize].b != REF_SHARED && pcx.types[dt as usize].b != 0);
                if !raw_cast
                    && (k == TyKind::Ptr
                        || k == TyKind::Slice && st.kind != SK_CALL && !shared_dest) {
                    problem(b"a copy of an exclusive reference (I7: it moves or is reborrowed)",
                        pbody, pcx);
                }
            }
        }
    }
}

// The form: ranges, terminators, targets. False when it is broken (the
// rest would read past it).
fn verify_form(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let n = pbody.stmts.len() as i64;
    pcx.owner.clear();
    for _ in 0..n {
        pcx.owner.push(-1);
    }
    let mut ok = true;
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 {
            continue;
        }
        pcx.at_block = b;
        pcx.at_stmt = -1;
        let end = start + block_len(b, pbody);
        if end >= n {
            problem(b"the block has no terminator", pbody, pcx);
            ok = false;
            continue;
        }
        for s in start..end + 1 {
            pcx.at_stmt = s - start;
            if pcx.owner[s as usize] >= 0 {
                problem(b"the statement is in two blocks", pbody, pcx);
                ok = false;
            }
            pcx.owner[s as usize] = b;
            let term = is_terminator(pbody.stmts[s as usize].kind);
            if s < end && term {
                problem(b"a terminator inside the block", pbody, pcx);
                ok = false;
            }
            if s == end && !term {
                problem(b"the block does not end in a terminator", pbody, pcx);
                ok = false;
            }
        }
        if !ok {
            continue;
        }
        for i in 0..succ_count(b, pbody) {
            let t = succ(b, i, pbody);
            if !in_graph(t, pbody) {
                problem(b"a target block that was never entered", pbody, pcx);
                ok = false;
            }
        }
    }
    if block_count(pbody) > 0 && !in_graph(0, pbody) {
        pcx.at_block = 0;
        problem(b"bb0 was never entered", pbody, pcx);
        ok = false;
    }
    ok
}

// Whether place (l, p) is well formed: its local exists, each step applies.
fn check_place(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if l < 0 || l >= local_count(pbody) {
        problem(b"a place of a local that does not exist", pbody, pcx);
        return false;
    }
    if full_place_type(l, p, pbody, pcx) <= 0 {
        problem(b"a projection that does not apply to its type", pbody, pcx);
        return false;
    }
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_INDEX {
            let i = proj_val(q, pbody);
            if i < 0 || i >= local_count(pbody) {
                problem(b"an index that is not a local", pbody, pcx);
                return false;
            }
        }
        q = proj_parent(q, pbody);
    }
    true
}

fn verify_stmt(s: i64, b: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let st = pbody.stmts[s as usize];
    let k = st.kind;
    if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_DROP || k == SK_MENTION {
        let placed = check_place(st.a, st.b, pbody, pcx);
        if placed && k == SK_DROP && (st.c == DS_KEPT || st.c == DS_FLAG) {
            let t = full_place_type(st.a, st.b, pbody, pcx);
            // RULE: D22.2 (an opaque instance's drop of a type that holds
            // an Ω asks for no shim, as ask_shims asks for none: the shim
            // would call a `drop` no instance made)
            if has_glue(t, pcx) && !crate::front::opaque::holds_omega(t, pcx)
                && !crate::places::shim::shim_found(t, pcx) {
                problem(b"a drop that runs whose type, erased, finds no shim (shim.vl shim_key)",
                    pbody, pcx);
            }
        }
    }
    for i in 0..st.nops {
        let ok = op_kind(st.ops, i, pbody);
        if !op_is_place(ok) {
            continue;
        }
        let l = op_a(st.ops, i, pbody);
        let p = op_b(st.ops, i, pbody);
        if !check_place(l, p, pbody, pcx) {
            continue;
        }
        if ok == OK_MOVE && has_flag(l, LF_BORROWED, pbody) {
            problem(b"a move out of a borrowed local", pbody, pcx);
        }
        if ok == OK_COPY && drops_on(pcx) && has_glue(full_place_type(l, p, pbody, pcx), pcx) {
            // (the copy rule: only into a borrowed local or temporary, or
            // of a borrowed local's place, itself a borrowed copy)
            let into_borrowed = k == SK_ASSIGN && st.c == RV_USE && st.b == 0
                && has_flag(st.a, LF_BORROWED, pbody);
            if !into_borrowed && !has_flag(l, LF_BORROWED, pbody) {
                problem(b"a copy of a value that needs drop, not into a borrowed local", pbody,
                    pcx);
            }
        }
        check_variants(l, p, b, pbody, pcx);
    }
}

// Each `as V` step of place (l, p) is dominated by a switch on the
// discriminant of the place it is taken of.
fn check_variants(l: i64, p: i64, b: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_VARIANT
            && !switch_dominates(l, proj_parent(q, pbody), b, pbody) {
            problem(b"an 'as V' not dominated by a switch on its discriminant", pbody, pcx);
        }
        q = proj_parent(q, pbody);
    }
}

// Whether a block that dominates b ends in a switch on `discriminant (l,
// p)` (the switch's operand a local assigned it in that block).
fn switch_dominates(l: i64, p: i64, b: i64, pbody: &Body<Comp>) -> bool {
    if pbody.rpo_index[b as usize] < 0 {
        // (an unreachable block: nothing to dominate it)
        return true;
    }
    let mut d = b;
    while true {
        if discr_switch(d, l, p, pbody) && (d != b) {
            return true;
        }
        let up = pbody.idom[d as usize];
        if up < 0 || up == d {
            return false;
        }
        d = up;
    }
    false
}

fn discr_switch(d: i64, l: i64, p: i64, pbody: &Body<Comp>) -> bool {
    let t = block_term(d, pbody);
    if pbody.stmts[t as usize].kind != TK_SWITCH {
        return false;
    }
    let ops = pbody.stmts[t as usize].ops;
    let k = op_kind(ops, 0, pbody);
    if k != OK_COPY && k != OK_MOVE || op_b(ops, 0, pbody) != 0 {
        return false;
    }
    let dl = op_a(ops, 0, pbody);
    let start = block_start(d, pbody);
    let mut s = t - 1;
    while s >= start {
        let st = pbody.stmts[s as usize];
        if st.kind == SK_ASSIGN && st.a == dl && st.b == 0 {
            return st.c == RV_DISCR && op_a(st.ops, 0, pbody) == l && op_b(st.ops, 0, pbody) == p;
        }
        s -= 1;
    }
    false
}

// ---- Storage ----

fn word_get(v: &Vec<i64, Comp>, at: i64, l: i64) -> bool {
    (v[(at + l / 64) as usize] >> (l % 64) & 1) != 0
}

fn dead_set(l: i64, on: bool, pcx: &mut Ctx<Comp>) {
    let w = l / 64;
    let bit = 1 << (l % 64);
    if on {
        pcx.dead[w as usize] = pcx.dead[w as usize] | bit;
    } else {
        pcx.dead[w as usize] = pcx.dead[w as usize] & ~bit;
    }
}

fn use_local(l: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if l >= 0 && l < local_count(pbody) && word_get(&pcx.tracked, 0, l)
        && word_get(&pcx.dead, 0, l) {
        problem(b"a use of a local outside its storage", pbody, pcx);
    }
}

fn use_place(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    use_local(l, pbody, pcx);
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_INDEX {
            use_local(proj_val(q, pbody), pbody, pcx);
        }
        q = proj_parent(q, pbody);
    }
}

// One block's statements over DEAD (its state at the entry).
fn storage_block(b: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let start = block_start(b, pbody);
    for s in start..start + block_len(b, pbody) + 1 {
        pcx.at_stmt = s - start;
        let st = pbody.stmts[s as usize];
        let k = st.kind;
        if k == SK_LIVE {
            if st.a >= 0 && st.a < local_count(pbody) {
                dead_set(st.a, false, pcx);
            }
            continue;
        }
        if k == SK_DEAD {
            if st.a >= 0 && st.a < local_count(pbody) {
                dead_set(st.a, true, pcx);
            }
            continue;
        }
        for i in 0..st.nops {
            if op_is_place(op_kind(st.ops, i, pbody)) {
                use_place(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), pbody, pcx);
            }
        }
        if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_DROP
            || k == SK_MENTION {
            use_place(st.a, st.b, pbody, pcx);
        }
    }
}

// Maybe-dead, forward, to a fixed point; then reported once.
fn verify_storage(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = local_count(pbody);
    pcx.verify_words = n / 64 + 1;
    pcx.tracked.clear();
    for _ in 0..pcx.verify_words {
        pcx.tracked.push(0);
    }
    let mut any = false;
    for s in 0..pbody.stmts.len() {
        if pbody.stmts[s].kind == SK_LIVE {
            let l = pbody.stmts[s].a;
            if l >= 0 && l < n && !has_flag(l, LF_PARAM, pbody) && !has_flag(l, LF_RETURN, pbody)
                && !has_flag(l, LF_STATIC, pbody) {
                pcx.tracked[(l / 64) as usize] = pcx.tracked[(l / 64) as usize] | 1 << (l % 64);
                any = true;
            }
        }
    }
    if !any {
        return;
    }
    let nb = block_count(pbody);
    pcx.dead_in.clear();
    for b in 0..nb {
        for w in 0..pcx.verify_words {
            // (bb0: every tracked local dead; the others: nothing known yet)
            pcx.dead_in.push(if b == 0 { pcx.tracked[w as usize] } else { 0 });
        }
    }
    pcx.dead.clear();
    for _ in 0..pcx.verify_words {
        pcx.dead.push(0);
    }
    pcx.report = false;
    let mut changed = true;
    let mut rounds: i64 = 0;
    while changed && rounds < 64 {
        changed = false;
        rounds += 1;
        for k in 0..pbody.rpo.len() {
            let b = pbody.rpo[k];
            for w in 0..pcx.verify_words {
                pcx.dead[w as usize] = pcx.dead_in[(b * pcx.verify_words + w) as usize];
            }
            storage_block(b, pbody, pcx);
            for i in 0..succ_count(b, pbody) {
                let t = succ(b, i, pbody);
                for w in 0..pcx.verify_words {
                    let old = pcx.dead_in[(t * pcx.verify_words + w) as usize];
                    let new = old | pcx.dead[w as usize];
                    if new != old {
                        { let at_ix = (t * pcx.verify_words + w) as usize;
                            pcx.dead_in[at_ix] = new };
                        changed = true;
                    }
                }
            }
        }
    }
    pcx.report = true;
    for k in 0..pbody.rpo.len() {
        let b = pbody.rpo[k];
        pcx.at_block = b;
        for w in 0..pcx.verify_words {
            pcx.dead[w as usize] = pcx.dead_in[(b * pcx.verify_words + w) as usize];
        }
        storage_block(b, pbody, pcx);
    }
}
