// (0.30.1) A function item used as a value (borrowck.md D4.7; rustc
// E0308, "one type is more general than the other"). A call through a
// `fn` value, or through a type parameter its bound reads (`F: Fn(&T)`),
// is checked with the value's erased type (constraints::indirect_call,
// R6): its references of any lifetime, the argument's. So the item may
// need nothing of a parameter's lifetime that such a call does not give:
// no `'static` (written, or a named lifetime bounded by it, or a type
// parameter bounded by it whose argument holds a reference). Else a
// reference to a local reaches a thread or a static through the item, a
// use after free (RT-M2-2). Stricter than rustc where the value's type
// says `'static` itself (`fn(&'static T)`), which its erased type cannot.

use crate::base::sym_text;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fmt, err_help};
use crate::front::ast::{NODE_REF, NodeKind, child};
use crate::front::parser::rust::{lifetimes_of, outlives_of, where_key};
use crate::places::front::{fn_node, fn_template};
use crate::places::regions::{B_NAMED, B_STATIC, Sig, lifetime_binding, sig_new, sig_of, slot_count};

// RULE: D4.7 (0.30.1) Function f used as a value at expression e: the
// first parameter whose type needs `'static` (static_param) is the error.
pub fn check_fn_value(f: i64, e: i64, pcx: &mut Ctx<Comp>) {
    if f < 0 {
        return;
    }
    let node = fn_node(fn_template(f, pcx), pcx);
    if node <= 0 || pcx.nodes[node as usize].kind != NodeKind::Fn {
        return;
    }
    let p = static_param(f, pcx);
    if p >= 0 && p < pcx.nodes[node as usize].count {
        report(f, child(node, p, pcx), e, pcx);
        return;
    }
    // RULE: R6 (0.30.2) a function whose signature keeps strict records
    // of a parameter typed by a type parameter (regions::bound_param) has
    // its body checked on the promise that each caller is checked by them
    // where it calls it by its name (check_callables,
    // constraints::indirect_call): a call through it as a value is checked
    // by no one. A `fn(..)` parameter's records ask nothing of the body
    // (it is checked as R6 reads that type), so such a function is a value
    // as any other
    let mut strict = Vec::<i64, Comp>::new_in(Comp {});
    crate::places::regions::strict_records(f, &mut strict, pcx);
    let mut r: usize = 0;
    while r + 5 <= strict.len() {
        if strict[r] >= 0 && crate::places::regions::bound_param(f, strict[r], pcx) {
            report_value_strict(f, e, pcx);
            return;
        }
        r += 5;
    }
}

// RULE: R6 error borrowck.fn_value_bound (its use as a value)
fn report_value_strict(f: i64, e: i64, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.fn_value_bound";
    let name = str::from_utf8(sym_text(pcx.nodes[fn_node(fn_template(f, pcx), pcx) as usize].a,
        pcx)).unwrap();
    err_begin(pcx.nodes[e as usize].start, pcx);
    err_fmt(format_args("'{}' cannot be used as a value: the callable it takes is checked by its bound where '{}' is called by its name, and a call through a `fn` value is not",
        name, name), pcx);
    err_help(c"call it by its name, where the callable given to it is checked (in rustc the bound's `for<'a>` is part of the value's type; a vole `fn` type does not say it)", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// The named lifetimes of function node n (its own, its `where`'s, its
// impl's) that must outlive 'static: bounded by it, or by one that is.
pub fn static_lifetimes(n: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let holders = [lifetimes_of(n, pcx), lifetimes_of(where_key(n), pcx), lifetimes_of(-n, pcx)];
    let mut changed = true;
    while changed {
        changed = false;
        for &h in &holders {
            if h <= 0 {
                continue;
            }
            for k in 0..pcx.nodes[h as usize].count {
                let ln = child(h, k, pcx);
                let a = pcx.nodes[ln as usize].a;
                let bounds = pcx.nodes[ln as usize].h;
                if bounds <= 0 || lifetime_binding(a, pcx) != B_NAMED || out.contains(&a) {
                    continue;
                }
                for j in 0..pcx.nodes[bounds as usize].count {
                    let b = pcx.nodes[child(bounds, j, pcx) as usize].a;
                    if is_static(b, out, pcx) {
                        out.push(a);
                        changed = true;
                        break;
                    }
                }
            }
        }
    }
}

pub fn is_static(sym: i64, statics: &Vec<i64, Comp>, pcx: &Ctx<Comp>) -> bool {
    let b = lifetime_binding(sym, pcx);
    b == B_STATIC || b == B_NAMED && statics.contains(&sym)
}

// Whether type node n, a parameter's type of function node fnode (f its
// instance), needs a lifetime to be 'static. A `fn` type or bound inside
// is not looked into: its references are what the item gives.
fn needs_static(n: i64, f: i64, fnode: i64, self_node: i64, statics: &Vec<i64, Comp>,
    param_ty: i64, depth: i64, pcx: &mut Ctx<Comp>) -> bool {
    // (no depth limit: a type node is a finite tree; a limit would be a
    // yes)
    if n <= 0 {
        return false;
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::TyPtr {
        if (pcx.nodes[n as usize].p & NODE_REF) != 0
            && is_static(pcx.nodes[n as usize].c, statics, pcx) {
            return true;
        }
        return needs_static(pcx.nodes[n as usize].a, f, fnode, self_node, statics, param_ty,
            depth + 1, pcx);
    }
    if k == NodeKind::TySlice {
        return is_static(pcx.nodes[n as usize].c, statics, pcx)
            || needs_static(pcx.nodes[n as usize].a, f, fnode, self_node, statics, param_ty,
                depth + 1, pcx);
    }
    if k == NodeKind::TyArray {
        return needs_static(pcx.nodes[n as usize].a, f, fnode, self_node, statics, param_ty,
            depth + 1, pcx);
    }
    if k == NodeKind::TyTuple {
        for e in 0..pcx.nodes[n as usize].count {
            if needs_static(child(n, e, pcx), f, fnode, self_node, statics, param_ty, depth + 1,
                pcx) {
                return true;
            }
        }
        return false;
    }
    if k != NodeKind::TyName {
        return false;
    }
    let text = sym_text(pcx.nodes[n as usize].a, pcx);
    let bare = pcx.nodes[n as usize].list == 0 && pcx.nodes[n as usize].g == 0
        && pcx.nodes[n as usize].count == 0;
    // (`Self`: the impl's type as its header writes it)
    if bare && text == b"Self" {
        return self_node > 0
            && needs_static(self_node, f, fnode, 0, statics, param_ty, depth + 1, pcx);
    }
    if text == b"str" && is_static(pcx.nodes[n as usize].c, statics, pcx) {
        return true;
    }
    if bare && param_static(n, f, fnode, pcx) {
        return true;
    }
    // (0.30.1, review 7: an alias is read as its definition, `type Si =
    // &'static i64`, its arguments below; a projection, `<X as Tr>::A`,
    // `T::A`, whose text says nothing of what it is, needs one when the
    // parameter's type holds any region: never a yes from the text alone)
    if (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0 {
        return f >= 0 && slot_count(param_ty, pcx) > 0;
    }
    if text != b"str" && !(bare && names_param(n, fnode, pcx)) {
        if depth >= 64 {
            return true;
        }
        // (`T::A`, `Self::A`: a projection of a type parameter, the
        // function's or its impl's, or of Self, tested before any lookup;
        // review 8: a lookup of `T::A` as a path is an error)
        let proj = crate::places::regions::proj_shape(n, pcx);
        if proj {
            let first = child(n, 0, pcx);
            if sym_text(pcx.nodes[first as usize].a, pcx) == b"Self"
                || names_param(first, fnode, pcx) {
                return f >= 0 && slot_count(param_ty, pcx) > 0;
            }
        }
        // (the name looked up quietly: what names nothing is not an error
        // here, the checker reports it where it is written)
        let saved = pcx.cur_mod;
        pcx.cur_mod = crate::front::modules::module_of(n, pcx);
        let mark = crate::base::diag::errors_mark(pcx);
        let saved_help = pcx.help_off;
        pcx.help_off = true;
        let key = crate::front::check::resolve::type_name_key(n, pcx);
        pcx.help_off = saved_help;
        crate::base::diag::errors_forget(mark, pcx);
        pcx.cur_mod = saved;
        let alias = if key >= 0 { pcx.sym_alias[key as usize] } else { 0 };
        if alias > 0 && pcx.nodes[alias as usize].kind == NodeKind::TypeAlias {
            if needs_static(pcx.nodes[alias as usize].b, f, fnode, self_node, statics, param_ty,
                depth + 1, pcx) {
                return true;
            }
        } else if proj && key < 0 {
            // (a one-segment path that names no type: the projection of a
            // parameter not in fnode's generics, its impl's)
            return f >= 0 && slot_count(param_ty, pcx) > 0;
        }
    }
    let lts = lifetimes_of(n, pcx);
    if lts > 0 {
        for e in 0..pcx.nodes[lts as usize].count {
            if is_static(pcx.nodes[child(lts, e, pcx) as usize].a, statics, pcx) {
                return true;
            }
        }
    }
    let g = pcx.nodes[n as usize].g;
    if g > 0 {
        for e in 0..pcx.nodes[g as usize].count {
            if needs_static(child(g, e, pcx), f, fnode, self_node, statics, param_ty, depth + 1,
                pcx) {
                return true;
            }
        }
    }
    false
}

// Whether bare name n is a type parameter of function node fnode bounded
// `'static` whose argument in instance f holds a reference (a lifetime
// the erased type cannot say is 'static).
fn param_static(n: i64, f: i64, fnode: i64, pcx: &Ctx<Comp>) -> bool {
    let g = pcx.nodes[fnode as usize].g;
    if g <= 0 || pcx.fns[f as usize].tmpl == 0 {
        return false;
    }
    for k in 0..pcx.nodes[g as usize].count {
        let p = child(g, k, pcx);
        if pcx.nodes[p as usize].a != pcx.nodes[n as usize].a {
            continue;
        }
        if k >= pcx.fns[f as usize].targ_count {
            return false;
        }
        let t = pcx.tlists[(pcx.fns[f as usize].targs + k) as usize];
        let mut i: i64 = 0;
        loop {
            let lt = outlives_of(p, i, pcx);
            if lt == 0 {
                return false;
            }
            if lifetime_binding(lt, pcx) == B_STATIC && t > 0 && slot_count(t, pcx) > 0 {
                return true;
            }
            i += 1;
        }
    }
    false
}

// Whether bare name n is a type parameter of function node fnode (its
// generics, the impl's with them).
fn names_param(n: i64, fnode: i64, pcx: &Ctx<Comp>) -> bool {
    let g = pcx.nodes[fnode as usize].g;
    for k in 0..(if g > 0 { pcx.nodes[g as usize].count } else { 0 }) {
        if pcx.nodes[child(g, k, pcx) as usize].a == pcx.nodes[n as usize].a {
            return true;
        }
    }
    false
}

// RULE: D4.7 error borrowck.fn_value_static
fn report(f: i64, pn: i64, e: i64, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.fn_value_static";
    let name = str::from_utf8(sym_text(pcx.nodes[fn_node(fn_template(f, pcx), pcx) as usize].a,
        pcx)).unwrap();
    let param = str::from_utf8(sym_text(pcx.nodes[pn as usize].a, pcx)).unwrap();
    err_begin(pcx.nodes[e as usize].start, pcx);
    err_fmt(format_args("'{}' cannot be used as a value: its parameter '{}' needs a 'static lifetime, and a call through a `fn` value or an `Fn` bound gives a reference of any lifetime",
        name, param), pcx);
    err_help(c"call the function by its name, or let it take a reference of any lifetime (`&T`, not `&'static T`): a `fn` type's lifetimes are erased, so `fn(&'static T)` is read as `fn(&T)` (rustc E0308: one type is more general than the other)", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// RULE: R6, D20.1 (0.30.2) At call n of f, the callables given to f's
// parameters that its signature's strict records name
// (regions::callable_ties): a relation R6 reads of a call through the
// value that no region of f can hold, a call's own region outliving
// another (`F: FnMut(&T) -> K` with K a reference: the argument's region
// would reach K). A fn item given there is checked by its own signature:
// the relation holds when its bounds keep that parameter's slot from
// outliving the other position (`fn sc<'a>(st: &mut i64, x: &'a i64) ->
// Option<&'a i64>` for scan's `FnMut(&mut St, Self::Item) -> Option<B>`);
// so is one a local surely holds (items: build::held_callable, `let p =
// st;`). A parameter of the body given on (fwd: its index, -1 for another
// argument), not `mut` and typed by a type parameter, holds it when the
// body's own signature has the record, which its callers checked. Anything else is read as R6 reads its erased type:
// borrowck.fn_value_bound (rustc E0308: one type is more general than the
// other).
pub fn check_callables(f: i64, n: i64, strict: &Vec<i64, Comp>, fwd: &Vec<i64, Comp>,
    items: &Vec<i64, Comp>, body_fn: i64, pcx: &mut Ctx<Comp>) {
    let len = strict.len() as i64;
    if len == 0 {
        return;
    }
    let mut own = Vec::<i64, Comp>::new_in(Comp {});
    let mut own_read = false;
    let mut done = Vec::<i64, Comp>::new_in(Comp {});
    let mut r: i64 = 0;
    while r + 5 <= len {
        let at = r;
        r += 5;
        let p = strict[at as usize];
        if done.contains(&p) {
            continue;
        }
        let arg = if p >= 0 && p < pcx.nodes[n as usize].count { child(n, p, pcx) } else { -1 };
        let mut ok = false;
        if p >= 0 && p < items.len() as i64 && items[p as usize] >= 0 {
            // (an item a parameter of which must be 'static is refused where
            // it is used as a value, borrowck.fn_value_static: not twice)
            ok = static_param(items[p as usize], pcx) >= 0
                || keeps_apart(items[p as usize], &strict, at, pcx);
        } else if p >= 0 && p < fwd.len() as i64 && fwd[p as usize] >= 0 && body_fn >= 0 {
            if !own_read {
                crate::places::regions::strict_records(body_fn, &mut own, pcx);
                own_read = true;
            }
            // (only a parameter typed by a type parameter: a `fn(..)` one
            // may hold any `fn` value, given through the body used as a
            // value too, regions::bound_param)
            ok = crate::places::regions::bound_param(body_fn, fwd[p as usize], pcx)
                && has_record(&own, fwd[p as usize], &strict, at);
        }
        if !ok {
            report_bound(f, if arg > 0 { arg } else { n }, pcx);
            done.push(p);
        }
    }
}

// Whether fn item g's signature keeps record at's first position from
// outliving its second (check_callables).
fn keeps_apart(g: i64, strict: &Vec<i64, Comp>, at: i64, pcx: &mut Ctx<Comp>) -> bool {
    if g < 0 {
        return false;
    }
    let mut gs = sig_new();
    crate::places::regions::sig_fresh(g, &mut gs, pcx);
    let a = sig_position(&gs, strict[(at + 1) as usize], strict[(at + 2) as usize]);
    let b = sig_position(&gs, strict[(at + 3) as usize], strict[(at + 4) as usize]);
    a >= 0 && b >= 0 && !outlives_in(&gs, a, b)
}

// The universal of slot `slot` of parameter o of s (-1: its result), -1
// when it has none.
fn sig_position(s: &Sig<Comp>, o: i64, slot: i64) -> i64 {
    if o < 0 {
        return if slot >= 0 && slot < s.ret.len() as i64 { s.ret[slot as usize] } else { -1 };
    }
    if o + 1 >= s.param_at.len() as i64 {
        return -1;
    }
    let i = s.param_at[o as usize] + slot;
    if slot >= 0 && i < s.param_at[(o + 1) as usize] { s.params[i as usize] } else { -1 }
}

// Whether universal a outlives b by s's bounds (one, 'static, or a chain).
fn outlives_in(s: &Sig<Comp>, a: i64, b: i64) -> bool {
    if a == b || a == 0 {
        return true;
    }
    let mut seen = Vec::<i64, Comp>::new_in(Comp {});
    let mut stack = Vec::<i64, Comp>::new_in(Comp {});
    stack.push(a);
    seen.push(a);
    while stack.len() > 0 {
        let x = stack[stack.len() - 1];
        stack.truncate(stack.len() - 1);
        let mut k: usize = 0;
        while k + 1 < s.bounds.len() {
            if s.bounds[k] == x {
                let y = s.bounds[k + 1];
                if y == b {
                    return true;
                }
                if !seen.contains(&y) {
                    seen.push(y);
                    stack.push(y);
                }
            }
            k += 2;
        }
        // (and the relations of a call through a callable it reads)
        let mut v: usize = 0;
        while v + 7 <= s.vties.len() {
            if s.vties[v + 1] == x {
                let y = s.vties[v + 2];
                if y == b {
                    return true;
                }
                if !seen.contains(&y) {
                    seen.push(y);
                    stack.push(y);
                }
            }
            v += 7;
        }
    }
    false
}

// Whether records own hold one for parameter q with record at's positions.
fn has_record(own: &Vec<i64, Comp>, q: i64, strict: &Vec<i64, Comp>, at: i64) -> bool {
    let mut i: usize = 0;
    while i + 5 <= own.len() {
        if own[i] == q && own[i + 1] == strict[(at + 1) as usize]
            && own[i + 2] == strict[(at + 2) as usize] && own[i + 3] == strict[(at + 3) as usize]
            && own[i + 4] == strict[(at + 4) as usize] {
            return true;
        }
        i += 5;
    }
    false
}

// RULE: R6 error borrowck.fn_value_bound
fn report_bound(f: i64, e: i64, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.fn_value_bound";
    let name = str::from_utf8(sym_text(pcx.nodes[fn_node(fn_template(f, pcx), pcx) as usize].a,
        pcx)).unwrap();
    err_begin(pcx.nodes[e as usize].start, pcx);
    err_fmt(format_args("this value cannot be given to '{}': its bound lets the call's argument end with the call, and the value's result may borrow from it (a `fn` value's result borrows from every argument, unless it is a function whose signature says otherwise)",
        name), pcx);
    err_help(c"pass a closure whose result does not borrow from that argument (`|x| *x`, `|x| x.clone()`), or the function itself by its name (rustc E0308: one type is more general than the other)", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// RULE: R6 (0.30.2) Whether fn item g, given where a call through it makes
// relation k of vties (regions::Sig: a parameter, two universals, two
// positions), relates those positions by its own signature: the first
// outlives the second by its bounds. A position it has not: it does.
pub fn relates(g: i64, vties: &Vec<i64, Comp>, k: i64, pcx: &mut Ctx<Comp>) -> bool {
    if g < 0 {
        return true;
    }
    let mut gs = sig_new();
    sig_of(g, &mut gs, pcx);
    let a = sig_position(&gs, vties[(k + 3) as usize], vties[(k + 4) as usize]);
    let b = sig_position(&gs, vties[(k + 5) as usize], vties[(k + 6) as usize]);
    a < 0 || b < 0 || outlives_in(&gs, a, b)
}

// RULE: D4.7, R6 (0.30.2) The first parameter of f whose type needs
// 'static (-1: none), the one rule for a function used as a value
// (check_fn_value) and given where a bound reads it (check_callables). Its
// written text: a `'static` in it, in an alias's definition (which the
// signature's walk does not read), a lifetime bounded by it (0.30.1). And
// what its bounds bring, as the signature reads them, each through the
// impl select chose and that impl's nested obligations
// (regions::impl_bound_ties, the one reading of a bound: `T: Keep` with
// only `impl Keep for &'static i64`, `T: Into<&'static i64>` through the
// blanket `impl<T, U: From<T>> Into<U> for T`, a supertrait's `'static`;
// RT-308, RT-364, RT-421). Read afresh: the builder asks.
pub fn static_param(f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if f < 0 {
        return -1;
    }
    let node = fn_node(fn_template(f, pcx), pcx);
    if node <= 0 || pcx.nodes[node as usize].kind != NodeKind::Fn {
        return -1;
    }
    let mut statics = Vec::<i64, Comp>::new_in(Comp {});
    static_lifetimes(node, &mut statics, pcx);
    let self_node = pcx.nodes[node as usize].h;
    for p in 0..pcx.nodes[node as usize].count {
        let pn = child(node, p, pcx);
        let param_ty = crate::front::types::fn_param(f, p, pcx);
        if needs_static(pcx.nodes[pn as usize].b, f, node, self_node, &statics, param_ty, 0, pcx) {
            return p;
        }
    }
    let mut sig = sig_new();
    crate::places::regions::sig_fresh(f, &mut sig, pcx);
    for p in 0..sig.param_at.len() as i64 - 1 {
        for j in sig.param_at[p as usize]..sig.param_at[(p + 1) as usize] {
            if outlives_in(&sig, sig.params[j as usize], 0) {
                return p;
            }
        }
    }
    -1
}
