// Drop glue (0.17, docs/design/value-semantics.md §2.2): whether dropping
// a value of a type runs code, has_glue, what `needs_drop::<T>()` folds to
// and what the places IR drops (a type with a `Drop` impl; std's
// containers; a struct, a tuple, an enum or an array with a part that has
// glue; a `move` closure that owns a capture that has), and the names of
// a sink closure's capture flags. (0.26.2: the glue as AST statements went
// with the own pass's drops; the IR's drop shims are made from the types,
// places/shim.vl.)

use crate::base::intern;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{CLOSURE_HOLES, CLOSURE_MOVE};
use crate::front::kinds::{K_NEEDS_DROP, has_drop_impl, owned_base_type, type_kind};
use crate::front::types::{TyKind, enum_variant, struct_field, type_elem, variant_field};

// Whether dropping a value of type t runs code: what `needs_drop::<T>()`
// is.
pub fn has_glue(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t <= 0 || (type_kind(t, pcx) & K_NEEDS_DROP) == 0 {
        return false;
    }
    let known = pcx.glue_memo.get(t + 1);
    if known != 0 {
        return known == 2;
    }
    // (a type reached again while it is computed: none from there)
    pcx.glue_memo.put(t + 1, 1);
    let r = glue_of(t, pcx);
    pcx.glue_memo.put(t + 1, if r { 2 } else { 1 });
    r
}

fn glue_of(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if has_drop_impl(t, pcx) {
            return true;
        }
        if owned_base_type(t, pcx) {
            return false;
        }
        let kind = pcx.types[t as usize].kind;
        if kind == TyKind::Struct {
            let s = pcx.types[t as usize].a;
            if pcx.structs[s as usize].closure != 0 && !moving_closure(s, pcx) {
                return false;
            }
            // RULE: F19.7 (0.27.3: a rust-edition union drops none of its
            // fields, as Rust's: which one holds a value is the program's
            // to know; its own Drop impl, above, runs)
            if (pcx.structs[s as usize].repr & crate::front::ast::REPR_UNION) != 0 {
                return false;
            }
            for i in 0..pcx.structs[s as usize].field_count {
                if has_glue((struct_field(s, i, pcx)).ty, pcx) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Tuple {
            for i in 0..pcx.types[t as usize].count {
                if has_glue(type_elem(t, i, pcx), pcx) {
                    return true;
                }
            }
            return false;
        }
        if kind == TyKind::Array {
            return pcx.types[t as usize].b > 0 && has_glue(pcx.types[t as usize].a, pcx);
        }
        if kind == TyKind::Enum {
            let e = pcx.types[t as usize].a;
            for i in 0..(pcx.enums[e as usize]).variant_count {
                let v = enum_variant(e, i, pcx);
                for j in 0..pcx.variants[v as usize].field_count {
                    if has_glue(variant_field(v, j, pcx), pcx) {
                        return true;
                    }
                }
            }
        }
        false
    }
}

// Whether closure struct s is a `move` closure's (its captures are its
// own).
fn moving_closure(s: i64, pcx: &Ctx<Comp>) -> bool {
    let id = pcx.structs[s as usize].closure - 1;
    let c = pcx.nodes[pcx.closures[id as usize].node as usize].c;
    (c & CLOSURE_MOVE) != 0 && (c & CLOSURE_HOLES) == 0
}

// (0.20) The name of the flag of a sink closure's capture `name`:
// `__live_name`, true while the closure holds it.
pub fn live_flag(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let b = crate::base::buf_new();
    crate::base::buf_str(b, c"__live_");
    crate::base::buf_bytes(b, crate::base::sym_text(name, pcx));
    intern(crate::base::buf_slice(b), pcx)
}

// The flag field of capture `name` in closure struct s (its name), or 0.
pub fn flag_field(s: i64, name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let flag = live_flag(name, pcx);
        for i in 0..pcx.structs[s as usize].field_count {
            if (struct_field(s, i, pcx)).name == flag {
                return flag;
            }
        }
        0
    }
}

