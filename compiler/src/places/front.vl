// What the places IR reads of the checker's raw tables (FNS, LOCALS,
// STATICS, VARIANTS, ENUMS, TLISTS, SYM_STATIC): one accessor each, so
// that the builder and elaboration are safe code. Each index given here is
// one the checker resolved (a call's function, an identifier's local, a
// pattern's variant), below its table's count.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::get_enums;

// ---- Functions (FNS) ----

pub fn fn_node(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].node }
}

pub fn fn_module(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].module }
}

pub fn fn_param_count(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].param_count }
}

pub fn fn_ret(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].ret }
}

pub fn fn_is_extern(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].is_extern }
}

// Whether f is a generic template (its body's types are not concrete).
pub fn fn_generic(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].generic != 0 }
}

// The template of instance f (FNS index), or f itself.
pub fn fn_template(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made; its tmpl is 0 or a
    // function + 1.
    unsafe { if pcx.fns[f as usize].tmpl != 0 { pcx.fns[f as usize].tmpl - 1 } else { f } }
}

// Instance f's type argument i (0 when it has fewer).
pub fn fn_targ(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS and TLISTS' data are the checker's raw tables.
    // SAFETY: i is checked against f's type argument count, whose entries
    // are in TLISTS from targs.
    unsafe {
        if i < 0 || i >= pcx.fns[f as usize].targ_count {
            return 0;
        }
        (*pcx.tlists.data.add((pcx.fns[f as usize].targs + i) as usize))
    }
}

// The symbol of function f's own name (its Fn node's), or 0.
pub fn fn_name_sym(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let node = fn_node(f, pcx);
    if node > 0 { pcx.nodes[node as usize].a } else { 0 }
}

// The type of the impl block function f is a method of (0: none).
pub fn fn_self_ty(f: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { pcx.fns[f as usize].self_ty }
}

// The name (a symbol) of field k of struct s (STRUCTS).
pub fn struct_field_name(s: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: struct_field gives a pointer into the checker's raw FIELDS.
    // SAFETY: 0 <= k < s's field count (the callers loop below it), so it
    // points to one of s's fields.
    unsafe { (*crate::front::types::struct_field(s, k, pcx)).name }
}

// ---- Locals (LOCALS) ----

pub fn ast_local_ty(l: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l is a local the checker defined (below LOCAL_COUNT).
    unsafe { pcx.locals[l as usize].ty }
}

pub fn ast_local_mutable(l: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l is a local the checker defined (below LOCAL_COUNT).
    unsafe { pcx.locals[l as usize].mutable }
}

pub fn ast_local_name(l: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l is a local the checker defined (below LOCAL_COUNT).
    unsafe { pcx.locals[l as usize].name }
}

pub fn ast_local_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.locals.len() as i64
}

// ---- Statics (STATICS, by name) ----

// The type of the static named `name` (a symbol), or 0.
pub fn static_ty(name: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: SYM_STATIC (per symbol) and STATICS are the checker's raw
    // tables.
    // SAFETY: name is a symbol an identifier resolved to a static
    // (Res::Static), so SYM_STATIC[name] is that static + 1.
    unsafe {
        let s = (*pcx.sym_static.add(name as usize)) - 1;
        if s < 0 { 0 } else { pcx.statics[s as usize].ty }
    }
}

// (0.27.1) Whether the static named `name` (a symbol) is a `static mut`.
pub fn static_mutable(name: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: SYM_STATIC (per symbol) and STATICS are the checker's raw
    // tables.
    // SAFETY: name is a symbol an identifier resolved to a static
    // (Res::Static), so SYM_STATIC[name] is that static + 1.
    unsafe {
        let s = (*pcx.sym_static.add(name as usize)) - 1;
        s >= 0 && pcx.statics[s as usize].mutable
    }
}

// ---- Enums and variants ----

// The discriminant of variant v.
pub fn variant_discr(v: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: VARIANTS is the checker's raw table of variants.
    // SAFETY: v is a variant the checker resolved (below VARIANT_COUNT).
    unsafe { pcx.variants[v as usize].discr }
}

// The enum (ENUMS) variant v is of.
pub fn variant_enum(v: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: VARIANTS is the checker's raw table of variants.
    // SAFETY: v is a variant the checker resolved (below VARIANT_COUNT).
    unsafe { pcx.variants[v as usize].enum_id }
}

// The tag type of enum type t.
pub fn enum_tag_ty(t: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: ENUMS is the checker's raw table of enums.
    // SAFETY: t is an enum type, so TYPES[t].a is below ENUM_COUNT.
    unsafe { (*get_enums().add(pcx.types[t as usize].a as usize)).tag }
}

// The first variant (VARIANTS) of enum type t and their count: its
// variants are first..first + count.
pub fn enum_variants(t: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: ENUMS is the checker's raw table of enums.
    // SAFETY: t is an enum type, so TYPES[t].a is below ENUM_COUNT.
    unsafe { (*get_enums().add(pcx.types[t as usize].a as usize)).variants }
}

pub fn enum_variant_count(t: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: ENUMS is the checker's raw table of enums.
    // SAFETY: t is an enum type, so TYPES[t].a is below ENUM_COUNT.
    unsafe { (*get_enums().add(pcx.types[t as usize].a as usize)).variant_count }
}

// (0.27.1) Enum e's (ENUMS index) record: its node, template, type
// arguments (the region slots, places::regions).
pub fn enum_info(e: i64, pcx: &Ctx<Comp>) -> crate::front::types::EnumInfo {
    // UNSAFE: ENUMS is the checker's raw table of enums.
    // SAFETY: the callers give an enum type's a (or a template + 1's
    // index), below ENUM_COUNT.
    unsafe { (*get_enums().add(e as usize)) }
}

// (0.27.1) Entry i of TLISTS (a struct's or enum's type arguments).
pub fn tlist_at(i: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: TLISTS' data is the checker's raw table of type lists.
    // SAFETY: i is targs + k for k below the record's targ_count, whose
    // entries the checker wrote.
    unsafe { (*pcx.tlists.data.add(i as usize)) }
}

// ---- Glue ----

// Whether a value of type t has drop glue (own::glue::has_glue, memoized
// per type here: the builder and elaboration ask for every operand).
pub fn type_glue(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    if t < pcx.glue.len() as i64 {
        let g = pcx.glue[t as usize];
        if g != 0 {
            return g == 2;
        }
    } else {
        while pcx.glue.len() as i64 <= t {
            pcx.glue.push(0);
        }
    }
    let r = crate::places::glue::has_glue(t, pcx);
    pcx.glue[t as usize] = if r { 2 } else { 1 };
    r
}

// ---- Functions made here (drop shims) ----

// Function f's signature set: one parameter of type p, the result `()`
// (a drop shim's, places/shim.vl: add_fn left them empty).
pub fn fn_set_shim_signature(f: i64, p: i64, pcx: &mut Ctx<Comp>) {
    let at = pcx.tlists.count;
    pcx.tlists.push(p);
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f was just made by add_fn (below FN_COUNT); `at` is where p
    // was pushed in TLISTS, so fn_param(f, 0) reads it.
    unsafe {
        pcx.fns[f as usize].params = at;
        pcx.fns[f as usize].param_count = 1;
        pcx.fns[f as usize].ret = crate::front::types::TY_UNIT;
    }
}
