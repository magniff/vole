// What the places IR reads of the checker's raw tables (FNS, LOCALS,
// STATICS, VARIANTS, ENUMS, TLISTS, SYM_STATIC): one accessor each, so
// that the builder and elaboration are safe code. Each index given here is
// one the checker resolved (a call's function, an identifier's local, a
// pattern's variant), below its table's count.

use crate::front::check::LOCALS;
use crate::front::types::{ENUMS, FNS, STATICS, SYM_STATIC, TLISTS, TYPES, VARIANTS};

// ---- Functions (FNS) ----

pub fn fn_node(f: i64) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { FNS[f].node }
}

pub fn fn_module(f: i64) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { FNS[f].module }
}

pub fn fn_param_count(f: i64) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { FNS[f].param_count }
}

pub fn fn_ret(f: i64) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { FNS[f].ret }
}

pub fn fn_is_extern(f: i64) -> bool {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { FNS[f].is_extern }
}

// Whether f is a generic template (its body's types are not concrete).
pub fn fn_generic(f: i64) -> bool {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made (below FN_COUNT).
    unsafe { FNS[f].generic != 0 }
}

// The template of instance f (FNS index), or f itself.
pub fn fn_template(f: i64) -> i64 {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a function the checker made; its tmpl is 0 or a
    // function + 1.
    unsafe { if FNS[f].tmpl != 0 { FNS[f].tmpl - 1 } else { f } }
}

// Instance f's type argument i (0 when it has fewer).
pub fn fn_targ(f: i64, i: i64) -> i64 {
    // UNSAFE: FNS and TLISTS' data are the checker's raw tables.
    // SAFETY: i is checked against f's type argument count, whose entries
    // are in TLISTS from targs.
    unsafe {
        if i < 0 || i >= FNS[f].targ_count {
            return 0;
        }
        TLISTS.data[FNS[f].targs + i]
    }
}

// The symbol of function f's own name (its Fn node's), or 0.
pub fn fn_name_sym(f: i64) -> i64 {
    let node = fn_node(f);
    if node > 0 { crate::front::ast::NODES[node].a } else { 0 }
}

// ---- Locals (LOCALS) ----

pub fn ast_local_ty(l: i64) -> i64 {
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l is a local the checker defined (below LOCAL_COUNT).
    unsafe { LOCALS[l].ty }
}

pub fn ast_local_mutable(l: i64) -> bool {
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l is a local the checker defined (below LOCAL_COUNT).
    unsafe { LOCALS[l].mutable }
}

pub fn ast_local_name(l: i64) -> i64 {
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: l is a local the checker defined (below LOCAL_COUNT).
    unsafe { LOCALS[l].name }
}

pub fn ast_local_count() -> i64 {
    crate::front::check::LOCAL_COUNT
}

// ---- Statics (STATICS, by name) ----

// The type of the static named `name` (a symbol), or 0.
pub fn static_ty(name: i64) -> i64 {
    // UNSAFE: SYM_STATIC (per symbol) and STATICS are the checker's raw
    // tables.
    // SAFETY: name is a symbol an identifier resolved to a static
    // (Res::Static), so SYM_STATIC[name] is that static + 1.
    unsafe {
        let s = SYM_STATIC[name] - 1;
        if s < 0 { 0 } else { STATICS[s].ty }
    }
}

// ---- Enums and variants ----

// The discriminant of variant v.
pub fn variant_discr(v: i64) -> i64 {
    // UNSAFE: VARIANTS is the checker's raw table of variants.
    // SAFETY: v is a variant the checker resolved (below VARIANT_COUNT).
    unsafe { VARIANTS[v].discr }
}

// The enum (ENUMS) variant v is of.
pub fn variant_enum(v: i64) -> i64 {
    // UNSAFE: VARIANTS is the checker's raw table of variants.
    // SAFETY: v is a variant the checker resolved (below VARIANT_COUNT).
    unsafe { VARIANTS[v].enum_id }
}

// The tag type of enum type t.
pub fn enum_tag_ty(t: i64) -> i64 {
    // UNSAFE: ENUMS is the checker's raw table of enums.
    // SAFETY: t is an enum type, so TYPES[t].a is below ENUM_COUNT.
    unsafe { ENUMS[TYPES[t].a].tag }
}
