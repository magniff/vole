// Kept bodies (0.26.1, request R1 of the code generators' agent;
// docs/design/places-ir.md §4): at a build, run_places keeps each
// elaborated body (keep_body, after elaborate), and a code generator puts
// it back into the P_* tables (load_body) when it generates the function,
// then frees it (free_body). One allocation per body, of the exact size:
// its header, then the six tables packed as words.
//
// A kept body is the body as elaboration left it; its types are the
// checker's, distinct ones not erased (ir.vl: undistinct).

use crate::base::comp::Comp;
use crate::places::ir::{
    B_FN, B_NODE, B_PARAMS, CUR_BLOCK, PBlock, PLocal, PProj, PStmt, P_BLOCKS, P_LOCALS, P_OPS,
    P_PROJS, P_STMTS, P_TARGETS,
};

// Whether run_places keeps the bodies (a build whose code generators
// read the IR; `--keep-places` at check, for the tests).
pub static var KEEP_BODIES: bool = false;

// Per function (FNS index): its body packed, or empty.
static var KEPT: Vec<Vec<i64, Comp>, Comp> = Vec::new_in(Comp {});
// The bodies kept and not freed, and the words they hold.
pub static var KEPT_COUNT: i64 = 0;
pub static var KEPT_WORDS: i64 = 0;

// The words of a body's header: its function, node, parameters, then the
// six tables' lengths.
const HEADER: i64 = 9;
const W_LOCAL: i64 = 4;
const W_PROJ: i64 = 5;
const W_STMT: i64 = 9;
const W_BLOCK: i64 = 2;

// The body held (P_* tables), kept for its function B_FN.
pub fn keep_body() {
    let f = B_FN;
    if f < 0 {
        return;
    }
    while KEPT.len() as i64 <= f {
        KEPT.push(Vec::new_in(Comp {}));
    }
    if KEPT[f].len() as i64 > 0 {
        free_body(f);
    }
    let nl = P_LOCALS.len() as i64;
    let np = P_PROJS.len() as i64;
    let ns = P_STMTS.len() as i64;
    let nb = P_BLOCKS.len() as i64;
    let no = P_OPS.len() as i64;
    let nt = P_TARGETS.len() as i64;
    let size = HEADER + W_LOCAL * nl + W_PROJ * np + W_STMT * ns + W_BLOCK * nb + no + nt;
    var w: Vec<i64, Comp> = Vec::with_capacity_in(size, Comp {});
    w.push(f);
    w.push(B_NODE);
    w.push(B_PARAMS);
    w.push(nl);
    w.push(np);
    w.push(ns);
    w.push(nb);
    w.push(no);
    w.push(nt);
    for i in 0..nl {
        let x = P_LOCALS[i];
        w.push(x.ty);
        w.push(x.flags);
        w.push(x.src);
        w.push(x.node);
    }
    for i in 0..np {
        let x = P_PROJS[i];
        w.push(x.parent);
        w.push(x.kind);
        w.push(x.val);
        w.push(x.first);
        w.push(x.next);
    }
    for i in 0..ns {
        let x = P_STMTS[i];
        w.push(x.kind);
        w.push(x.a);
        w.push(x.b);
        w.push(x.c);
        w.push(x.d);
        w.push(x.e);
        w.push(x.ops);
        w.push(x.nops);
        w.push(x.node);
    }
    for i in 0..nb {
        let x = P_BLOCKS[i];
        w.push(x.start);
        w.push(x.len);
    }
    w.extend_from_slice(P_OPS.as_slice());
    w.extend_from_slice(P_TARGETS.as_slice());
    KEPT_COUNT += 1;
    KEPT_WORDS += size;
    KEPT.set(f, w);
}

// Whether function f has a kept body.
pub fn has_kept(f: i64) -> bool {
    f >= 0 && f < KEPT.len() as i64 && KEPT[f].len() as i64 > 0
}

// Function f's kept body put back into the P_* tables (as body_begin and
// the builder left them, with no block open): false when it has none.
pub fn load_body(f: i64) -> bool {
    if !has_kept(f) {
        return false;
    }
    let w = KEPT[f].as_slice();
    crate::places::ir::B_FN = w[0];
    crate::places::ir::B_NODE = w[1];
    crate::places::ir::B_PARAMS = w[2];
    crate::places::ir::B_SHIM = -1;
    let nl = w[3];
    let np = w[4];
    let ns = w[5];
    let nb = w[6];
    let no = w[7];
    let nt = w[8];
    P_LOCALS.clear();
    P_PROJS.clear();
    P_STMTS.clear();
    P_BLOCKS.clear();
    P_OPS.clear();
    P_TARGETS.clear();
    var at = HEADER;
    for _ in 0..nl {
        P_LOCALS.push(PLocal { ty: w[at], flags: w[at + 1], src: w[at + 2], node: w[at + 3] });
        at += W_LOCAL;
    }
    for _ in 0..np {
        P_PROJS.push(PProj {
            parent: w[at], kind: w[at + 1], val: w[at + 2], first: w[at + 3], next: w[at + 4],
        });
        at += W_PROJ;
    }
    for _ in 0..ns {
        P_STMTS.push(PStmt {
            kind: w[at], a: w[at + 1], b: w[at + 2], c: w[at + 3], d: w[at + 4], e: w[at + 5],
            ops: w[at + 6], nops: w[at + 7], node: w[at + 8],
        });
        at += W_STMT;
    }
    for _ in 0..nb {
        P_BLOCKS.push(PBlock { start: w[at], len: w[at + 1] });
        at += W_BLOCK;
    }
    P_OPS.extend_from_slice(w[at..at + no]);
    at += no;
    P_TARGETS.extend_from_slice(w[at..at + nt]);
    crate::places::ir::CUR_BLOCK = -1;
    true
}

// Function f's kept body freed (once its function is generated).
pub fn free_body(f: i64) {
    if !has_kept(f) {
        return;
    }
    KEPT_COUNT -= 1;
    KEPT_WORDS -= KEPT[f].len() as i64;
    KEPT[f].free();
}

// Every kept body freed.
pub fn free_all() {
    for f in 0..KEPT.len() as i64 {
        free_body(f);
    }
}
