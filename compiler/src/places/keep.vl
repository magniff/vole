// Kept bodies (0.26.1, request R1 of the code generators' agent;
// docs/design/places-ir.md §4): at a build, run_places keeps each
// elaborated body (keep_body, after elaborate), and a code generator puts
// it back into the P_* tables (load_body) when it generates the function,
// then frees it (free_body). Each of the six tables is kept as a copy of
// the exact size, made and put back whole (extend_from_slice: no field by
// field packing, 0.26.1 the builder's cost at a build), beside a header of
// three words.
//
// A kept body is the body as elaboration left it; its types are the
// checker's, distinct ones not erased (ir.vl: undistinct).

use crate::base::comp::Comp;
use crate::front::types::{TY_NEVER, is_compound, is_void};
use crate::places::cfg::{RPO, RPO_INDEX, compute_rpo};
use crate::places::ir::{
    B_FN, B_NODE, B_PARAMS, DS_FLAG, LF_BORROWED, LF_FLAG, LF_SSA, LF_STATIC, LF_TEMP, OK_COPY,
    OK_MOVE, OK_PLACE, PBlock, PJ_DEREF, PJ_INDEX, PLocal, PProj, PStmt, P_BLOCKS, P_LOCALS, P_OPS,
    P_PROJS, P_STMTS, P_TARGETS, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC, SK_LIVE,
    SK_MENTION, SK_NOP, proj_kind, proj_parent, proj_val, undistinct,
};

// Whether run_places keeps the bodies (a build whose code generators
// read the IR; `--keep-places` at check, for the tests).
pub static var KEEP_BODIES: bool = false;

// Per function (FNS index): its body's header (B_NODE, B_PARAMS, then 1:
// kept; three words a function), and its tables, empty when it has none.
static var K_HEAD: Vec<i64, Comp> = Vec::new_in(Comp {});
static var K_LOCALS: Vec<Vec<PLocal, Comp>, Comp> = Vec::new_in(Comp {});
static var K_PROJS: Vec<Vec<PProj, Comp>, Comp> = Vec::new_in(Comp {});
static var K_STMTS: Vec<Vec<PStmt, Comp>, Comp> = Vec::new_in(Comp {});
static var K_BLOCKS: Vec<Vec<PBlock, Comp>, Comp> = Vec::new_in(Comp {});
static var K_OPS: Vec<Vec<i64, Comp>, Comp> = Vec::new_in(Comp {});
static var K_TARGETS: Vec<Vec<i64, Comp>, Comp> = Vec::new_in(Comp {});
// The bodies kept and not freed, and the words they hold.
pub static var KEPT_COUNT: i64 = 0;
pub static var KEPT_WORDS: i64 = 0;

// The words of a kept local, projection, statement, block.
const W_LOCAL: i64 = 4;
const W_PROJ: i64 = 5;
const W_STMT: i64 = 9;
const W_BLOCK: i64 = 2;

// The body held (P_* tables), kept for its function B_FN.
pub fn keep_body() {
    let f = B_FN;
    if f < 0 {
        return;
    }
    while K_LOCALS.len() <= f {
        K_HEAD.push(0);
        K_HEAD.push(0);
        K_HEAD.push(0);
        K_LOCALS.push(Vec::new_in(Comp {}));
        K_PROJS.push(Vec::new_in(Comp {}));
        K_STMTS.push(Vec::new_in(Comp {}));
        K_BLOCKS.push(Vec::new_in(Comp {}));
        K_OPS.push(Vec::new_in(Comp {}));
        K_TARGETS.push(Vec::new_in(Comp {}));
        K_SCAN.push(Vec::new_in(Comp {}));
    }
    if has_kept(f) {
        free_body(f);
    }
    K_HEAD[3 * f] = B_NODE;
    K_HEAD[3 * f + 1] = B_PARAMS;
    K_HEAD[3 * f + 2] = 1;
    var l: Vec<PLocal, Comp> = Vec::with_capacity_in(P_LOCALS.len(), Comp {});
    l.extend_from_slice(P_LOCALS.as_slice());
    K_LOCALS.set(f, l);
    var p: Vec<PProj, Comp> = Vec::with_capacity_in(P_PROJS.len(), Comp {});
    p.extend_from_slice(P_PROJS.as_slice());
    K_PROJS.set(f, p);
    var s: Vec<PStmt, Comp> = Vec::with_capacity_in(P_STMTS.len(), Comp {});
    s.extend_from_slice(P_STMTS.as_slice());
    K_STMTS.set(f, s);
    var b: Vec<PBlock, Comp> = Vec::with_capacity_in(P_BLOCKS.len(), Comp {});
    b.extend_from_slice(P_BLOCKS.as_slice());
    K_BLOCKS.set(f, b);
    var o: Vec<i64, Comp> = Vec::with_capacity_in(P_OPS.len(), Comp {});
    o.extend_from_slice(P_OPS.as_slice());
    K_OPS.set(f, o);
    var t: Vec<i64, Comp> = Vec::with_capacity_in(P_TARGETS.len(), Comp {});
    t.extend_from_slice(P_TARGETS.as_slice());
    K_TARGETS.set(f, t);
    var c: Vec<i64, Comp> = Vec::with_capacity_in(P_SCAN.len(), Comp {});
    c.extend_from_slice(P_SCAN.as_slice());
    K_SCAN.set(f, c);
    KEPT_COUNT += 1;
    KEPT_WORDS += words(f);
}

// The words function f's kept tables hold.
fn words(f: i64) -> i64 {
    3 + W_LOCAL * K_LOCALS[f].len() + W_PROJ * K_PROJS[f].len() + W_STMT * K_STMTS[f].len()
        + W_BLOCK * K_BLOCKS[f].len() + K_OPS[f].len() + K_TARGETS[f].len() + K_SCAN[f].len()
}

// Whether function f has a kept body.
pub fn has_kept(f: i64) -> bool {
    f >= 0 && f < K_LOCALS.len() && K_HEAD[3 * f + 2] != 0
}

// Function f's kept body put back into the P_* tables (as body_begin and
// the builder left them, with no block open): false when it has none. The
// tables are taken, not copied: the body is no longer kept (a code
// generator frees it once generated; one that only prints it keeps it
// again, keep_body).
pub fn load_body(f: i64) -> bool {
    if !has_kept(f) {
        return false;
    }
    crate::places::ir::B_FN = f;
    crate::places::ir::B_NODE = K_HEAD[3 * f];
    crate::places::ir::B_PARAMS = K_HEAD[3 * f + 1];
    crate::places::ir::B_SHIM = -1;
    KEPT_COUNT -= 1;
    KEPT_WORDS -= words(f);
    K_HEAD[3 * f + 2] = 0;
    crate::places::ir::set_tables(K_LOCALS[f].take(), K_PROJS[f].take(), K_STMTS[f].take(),
        K_BLOCKS[f].take(), K_OPS[f].take(), K_TARGETS[f].take());
    let _ = std::replace(&P_SCAN, K_SCAN[f].take());
    crate::places::ir::CUR_BLOCK = -1;
    true
}

// Function f's kept body freed (once its function is generated).
pub fn free_body(f: i64) {
    if !has_kept(f) {
        return;
    }
    KEPT_COUNT -= 1;
    KEPT_WORDS -= words(f);
    K_HEAD[3 * f + 2] = 0;
    K_LOCALS[f].free();
    K_PROJS[f].free();
    K_STMTS[f].free();
    K_BLOCKS[f].free();
    K_OPS[f].free();
    K_TARGETS[f].free();
    K_SCAN[f].free();
}

// Every kept body freed.
pub fn free_all() {
    for f in 0..K_LOCALS.len() {
        free_body(f);
    }
}

// Per local, while scan_kept runs: 0 not seen, 4b + 1 written whole in
// block b, 4b + 3 then read whole there, -1 mentioned any other way.
static var SSA_ST: Vec<i64, Comp> = Vec::new_in(Comp {});
// The locals in the order of their first mention, while scan_kept runs.
static var SCAN_ORDER: Vec<i64, Comp> = Vec::new_in(Comp {});
// The held body's scan (scan_kept): its count of locals, of locals
// mentioned, of blocks in reverse postorder; SC_W words a local (its
// mentions, first, last, block, written, its first and last entry in
// the mention list); the order; the postorder; the mention list.
pub static var P_SCAN: Vec<i64, Comp> = Vec::new_in(Comp {});
const SC_HEAD: i64 = 3;
const SC_W: i64 = 7;
// (a mention's statement and slot in one word: at * MP_SLOTS + slot + 2)
const MP_SLOTS: i64 = 65536;
// The mention list while scan_kept runs (two words an entry).
static var SCAN_MP: Vec<i64, Comp> = Vec::new_in(Comp {});
// Per function, its kept scan.
static var K_SCAN: Vec<Vec<i64, Comp>, Comp> = Vec::new_in(Comp {});

// (0.26.1, for gen0) The held body's scan, made once at a build and kept
// with it: its reverse postorder and each local's mentions in it, the
// tables gen0's slot assignment reads (gen0/gen/places.vl), and LF_SSA
// (ir.vl) on its temporaries with one whole write and one whole read, the
// read by a later statement of the write's block. A mention is a
// statement's place, an operand, an index, a drop's flag; the operands of
// a statement come before the place it writes, in their order. Each
// local's mentions are listed too, in walk order: the statement and a
// slot (the operand's number, for an operand that is the local whole; -1
// a whole write; -2 anything else).
pub fn scan_kept() {
    let n = P_LOCALS.len();
    if !crate::places::elab::RPO_CURRENT {
        compute_rpo();
    }
    P_SCAN.clear();
    P_SCAN.push(n);
    P_SCAN.push(0);
    P_SCAN.push(0);
    SSA_ST.clear();
    for _ in 0..n {
        P_SCAN.push(0);
        P_SCAN.push(0);
        P_SCAN.push(0);
        P_SCAN.push(-1);
        P_SCAN.push(0);
        P_SCAN.push(0);
        P_SCAN.push(0);
        SSA_ST.push(0);
    }
    SCAN_ORDER.clear();
    SCAN_MP.clear();
    for i in 0..RPO.len() {
        let b = RPO[i];
        let start = P_BLOCKS[b].start;
        let written = 4 * b + 1;
        for at in start..start + P_BLOCKS[b].len + 1 {
            let k = P_STMTS[at].kind;
            if k == SK_LIVE || k == SK_DEAD || k == SK_NOP {
                continue;
            }
            let s = P_STMTS[at];
            var oi = s.ops;
            let oend = s.ops + 3 * s.nops;
            while oi < oend {
                let ok = P_OPS[oi];
                let l = P_OPS[oi + 1];
                let p = P_OPS[oi + 2];
                let o = (oi - s.ops) / 3;
                oi += 3;
                if ok != OK_COPY && ok != OK_MOVE && ok != OK_PLACE {
                    continue;
                }
                scan_place(l, p, at, b, ok == OK_PLACE, if o < MP_SLOTS - 2 { o } else { -2 });
                if ok != OK_PLACE && p == 0 && SSA_ST[l] == written {
                    SSA_ST[l] = written + 2;
                } else {
                    SSA_ST[l] = -1;
                }
            }
            if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC {
                if s.b == 0 {
                    let first = P_SCAN[SC_HEAD + SC_W * s.a] == 0;
                    scan_mention(s.a, at, b, false, -1);
                    if first {
                        P_SCAN[SC_HEAD + SC_W * s.a + 4] = 1;
                    }
                    SSA_ST[s.a] = if SSA_ST[s.a] == 0 { written } else { -1 };
                } else {
                    scan_place(s.a, s.b, at, b, false, -2);
                    SSA_ST[s.a] = -1;
                }
            } else if k == SK_DROP || k == SK_MENTION {
                scan_place(s.a, s.b, at, b, true, -2);
                SSA_ST[s.a] = -1;
                if k == SK_DROP && s.c == DS_FLAG {
                    scan_mention(s.d, at, b, false, -2);
                }
                if k == SK_DROP && s.d >= 0 {
                    SSA_ST[s.d] = -1;
                }
            }
        }
    }
    P_SCAN[1] = SCAN_ORDER.len();
    P_SCAN.extend_from_slice(SCAN_ORDER.as_slice());
    P_SCAN[2] = RPO.len();
    P_SCAN.extend_from_slice(RPO.as_slice());
    // (the mention list, its entries two words: the mention, the next
    // entry of its local, -1 after the last)
    P_SCAN.extend_from_slice(SCAN_MP.as_slice());
    for l in 0..n {
        if SSA_ST[l] < 0 || (SSA_ST[l] & 3) != 3 {
            continue;
        }
        let flags = P_LOCALS[l].flags;
        if (flags & LF_TEMP) == 0 || (flags & (LF_BORROWED | LF_STATIC | LF_FLAG)) != 0 {
            continue;
        }
        let ty = undistinct(P_LOCALS[l].ty);
        if is_void(ty) || ty == TY_NEVER || is_compound(ty) {
            continue;
        }
        P_LOCALS[l].flags = flags | LF_SSA;
    }
}

// Local l mentioned by statement `at` of block b (`placed`: its storage
// named, its address or a part's taken).
fn scan_mention(l: i64, at: i64, b: i64, placed: bool, slot: i64) {
    let i = SC_HEAD + SC_W * l;
    let e = SCAN_MP.len() / 2;
    SCAN_MP.push(at * MP_SLOTS + slot + 2);
    SCAN_MP.push(-1);
    if P_SCAN[i] == 0 {
        P_SCAN[i + 1] = at;
        P_SCAN[i + 3] = b;
        P_SCAN[i + 5] = e;
        SCAN_ORDER.push(l);
    } else {
        SCAN_MP[2 * P_SCAN[i + 6] + 1] = e;
        if P_SCAN[i + 3] != b {
            P_SCAN[i + 3] = -2;
        }
    }
    P_SCAN[i + 6] = e;
    P_SCAN[i + 2] = at;
    P_SCAN[i] += 1;
    if placed {
        P_SCAN[i + 3] = -2;
    }
}

// Place (l, p) mentioned: placed too when p goes through a reference or
// an index; its index locals mentioned (and not SSA). Slot: the
// mention's when p is 0.
fn scan_place(l: i64, p: i64, at: i64, b: i64, placed: bool, slot: i64) {
    if p == 0 {
        scan_mention(l, at, b, placed, slot);
        return;
    }
    var through = false;
    var q = p;
    while q > 0 {
        let k = proj_kind(q);
        if k == PJ_DEREF || k == PJ_INDEX {
            through = true;
        }
        q = proj_parent(q);
    }
    scan_mention(l, at, b, placed || through, -2);
    q = p;
    while q > 0 {
        if proj_kind(q) == PJ_INDEX {
            let v = proj_val(q);
            scan_mention(v, at, b, false, -2);
            SSA_ST[v] = -1;
        }
        q = proj_parent(q);
    }
}

// The scan of the body loaded (load_body), for gen0: local l's mentions,
// its first and last mention (statement indices), its block (-1: none,
// -2: several, or its storage named), whether its first mention writes
// it whole; the locals in the order of their first mention.
pub fn scan_mentions(l: i64) -> i64 {
    P_SCAN[SC_HEAD + SC_W * l]
}

pub fn scan_first(l: i64) -> i64 {
    P_SCAN[SC_HEAD + SC_W * l + 1]
}

pub fn scan_last(l: i64) -> i64 {
    P_SCAN[SC_HEAD + SC_W * l + 2]
}

pub fn scan_block(l: i64) -> i64 {
    P_SCAN[SC_HEAD + SC_W * l + 3]
}

pub fn scan_written(l: i64) -> bool {
    P_SCAN[SC_HEAD + SC_W * l + 4] != 0
}

// Local l's mentions in walk order, a list: its first entry (-1: none),
// an entry's next (-1 after the last), its statement and its slot (the
// operand's number; -1 a whole write; -2 else).
pub fn scan_mention_head(l: i64) -> i64 {
    if P_SCAN[SC_HEAD + SC_W * l] == 0 { -1 } else { P_SCAN[SC_HEAD + SC_W * l + 5] }
}

pub fn scan_mention_next(e: i64) -> i64 {
    P_SCAN[scan_list() + 2 * e + 1]
}

pub fn scan_mention_at(e: i64) -> i64 {
    P_SCAN[scan_list() + 2 * e] / MP_SLOTS
}

pub fn scan_mention_slot(e: i64) -> i64 {
    P_SCAN[scan_list() + 2 * e] % MP_SLOTS - 2
}

fn scan_list() -> i64 {
    SC_HEAD + SC_W * P_SCAN[0] + P_SCAN[1] + P_SCAN[2]
}

pub fn scan_order_count() -> i64 {
    P_SCAN[1]
}

pub fn scan_order(i: i64) -> i64 {
    P_SCAN[SC_HEAD + SC_W * P_SCAN[0] + i]
}

// The loaded body's reverse postorder into cfg's RPO and RPO_INDEX, as
// compute_rpo makes them.
pub fn load_rpo() {
    let at = SC_HEAD + SC_W * P_SCAN[0] + P_SCAN[1];
    RPO.clear();
    RPO.extend_from_slice(P_SCAN[at..at + P_SCAN[2]]);
    RPO_INDEX.clear();
    for _ in 0..P_BLOCKS.len() {
        RPO_INDEX.push(-1);
    }
    for i in 0..RPO.len() {
        RPO_INDEX[RPO[i]] = i;
    }
}
