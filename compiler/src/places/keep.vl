// Kept bodies (0.26.1, request R1 of the code generators' agent;
// docs/design/places-ir.md §4): at a build, run_places keeps each
// elaborated body (keep_body, after elaborate), and a code generator puts
// it back into the P_* tables (load_body) when it generates the function,
// then frees it (free_body). Each of the six tables is kept as a copy of
// the exact size, made and put back whole (extend_from_slice: no field by
// field packing, 0.26.1 the builder's cost at a build), beside a header of
// three words.
//
// A kept body is the body as elaboration left it; its types are the
// checker's, distinct ones not erased (ir.vl: undistinct).

use crate::base::len_arg;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_NEVER, is_compound, is_void};
use crate::places::ir::{
    Body, LF_BORROWED, LF_FLAG, LF_SSA, LF_STATIC, LF_TEMP, OK_COPY, OK_MOVE, OK_PLACE, PBlock,
    PJ_INDEX, PLocal, PProj, PStmt, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC, SK_LIVE,
    SK_MENTION, SK_NOP, op_a, op_b, op_kind, proj_kind, proj_parent, proj_val, undistinct,
};

// The words of a kept local, projection, statement, block.
const W_LOCAL: i64 = 4;
const W_PROJ: i64 = 5;
const W_STMT: i64 = 9;
const W_BLOCK: i64 = 2;

// The body held (P_* tables), kept for its function B_FN.
pub fn keep_body(pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let f = pbody.fn_;
    if f < 0 {
        return;
    }
    while pcx.k_locals.len() as i64 <= f {
        pcx.k_head.push(0);
        pcx.k_head.push(0);
        pcx.k_head.push(0);
        pcx.k_locals.push(Vec::new_in(Comp {}));
        pcx.k_projs.push(Vec::new_in(Comp {}));
        pcx.k_stmts.push(Vec::new_in(Comp {}));
        pcx.k_blocks.push(Vec::new_in(Comp {}));
        pcx.k_ops.push(Vec::new_in(Comp {}));
        pcx.k_targets.push(Vec::new_in(Comp {}));
    }
    if has_kept(f, pcx) {
        free_body(f, &pcx);
    }
    pcx.k_head[3 * f] = pbody.node;
    pcx.k_head[3 * f + 1] = pbody.params;
    pcx.k_head[3 * f + 2] = 1;
    var l: Vec<PLocal, Comp> = Vec::with_capacity_in(pbody.locals.len(), Comp {});
    l.extend_from_slice(pbody.locals.as_slice());
    pcx.k_locals.set(len_arg(f), l);
    var p: Vec<PProj, Comp> = Vec::with_capacity_in(pbody.projs.len(), Comp {});
    p.extend_from_slice(pbody.projs.as_slice());
    pcx.k_projs.set(len_arg(f), p);
    var s: Vec<PStmt, Comp> = Vec::with_capacity_in(pbody.stmts.len(), Comp {});
    s.extend_from_slice(pbody.stmts.as_slice());
    pcx.k_stmts.set(len_arg(f), s);
    var b: Vec<PBlock, Comp> = Vec::with_capacity_in(pbody.blocks.len(), Comp {});
    b.extend_from_slice(pbody.blocks.as_slice());
    pcx.k_blocks.set(len_arg(f), b);
    var o: Vec<i64, Comp> = Vec::with_capacity_in(pbody.ops.len(), Comp {});
    o.extend_from_slice(pbody.ops.as_slice());
    pcx.k_ops.set(len_arg(f), o);
    var t: Vec<i64, Comp> = Vec::with_capacity_in(pbody.targets.len(), Comp {});
    t.extend_from_slice(pbody.targets.as_slice());
    pcx.k_targets.set(len_arg(f), t);
    pcx.kept_count += 1;
    pcx.kept_words += words(f, pcx);
}

// The words function f's kept tables hold.
fn words(f: i64, pcx: Ctx<Comp>) -> i64 {
    3 + W_LOCAL * pcx.k_locals[f].len() as i64 + W_PROJ * pcx.k_projs[f].len() as i64 + W_STMT * pcx.k_stmts[f].len() as i64
        + W_BLOCK * pcx.k_blocks[f].len() as i64 + pcx.k_ops[f].len() as i64 + pcx.k_targets[f].len() as i64
}

// Whether function f has a kept body.
pub fn has_kept(f: i64, pcx: Ctx<Comp>) -> bool {
    f >= 0 && f < pcx.k_locals.len() as i64 && pcx.k_head[3 * f + 2] != 0
}

// Function f's kept body put back into the P_* tables (as body_begin and
// the builder left them, with no block open): false when it has none. The
// tables are taken, not copied: the body is no longer kept (a code
// generator frees it once generated; one that only prints it keeps it
// again, keep_body).
pub fn load_body(f: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) -> bool {
    if !has_kept(f, pcx) {
        return false;
    }
    pbody.fn_ = f;
    pbody.node = pcx.k_head[3 * f];
    pbody.params = pcx.k_head[3 * f + 1];
    pbody.shim = -1;
    pcx.kept_count -= 1;
    pcx.kept_words -= words(f, pcx);
    pcx.k_head[3 * f + 2] = 0;
    crate::places::ir::set_tables(pcx.k_locals[f].take(), pcx.k_projs[f].take(),
        pcx.k_stmts[f].take(), pcx.k_blocks[f].take(), pcx.k_ops[f].take(), pcx.k_targets[f].take(),
        &pbody);
    // (a kept body keeps no region variables: 0.27.1 checks them first)
    pbody.regions.clear();
    pbody.slot_at.clear();
    pbody.slot_var.clear();
    pbody.ret_var.clear();
    pbody.ubounds.clear();
    pbody.cur_block = -1;
    true
}

// Function f's kept body freed (once its function is generated).
pub fn free_body(f: i64, pcx: inout Ctx<Comp>) {
    if !has_kept(f, pcx) {
        return;
    }
    pcx.kept_count -= 1;
    pcx.kept_words -= words(f, pcx);
    pcx.k_head[3 * f + 2] = 0;
    pcx.k_locals[f].free();
    pcx.k_projs[f].free();
    pcx.k_stmts[f].free();
    pcx.k_blocks[f].free();
    pcx.k_ops[f].free();
    pcx.k_targets[f].free();
}

// Every kept body freed.
pub fn free_all(pcx: inout Ctx<Comp>) {
    for f in 0..pcx.k_locals.len() as i64 {
        free_body(f, &pcx);
    }
}

// (0.26.1, for gen0) Flags LF_SSA the held body's temporaries with one
// whole write and one whole read, the read by a later statement of the
// write's block (ir.vl): a value a code generator can keep out of the
// frame without scanning the body for it.
pub fn mark_ssa(pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let n = pbody.locals.len() as i64;
    pcx.ssa_st.clear();
    for _ in 0..n {
        pcx.ssa_st.push(0);
    }
    for b in 0..pbody.blocks.len() as i64 {
        let start = pbody.blocks[b].start;
        if start < 0 {
            // (a block never entered)
            continue;
        }
        let written = 4 * b + 1;
        for at in start..start + pbody.blocks[b].len + 1 {
            let s = pbody.stmts[at];
            let k = s.kind;
            if k == SK_LIVE || k == SK_DEAD || k == SK_NOP {
                continue;
            }
            // (the operands read first, then the place written)
            for o in 0..s.nops {
                let ok = op_kind(s.ops, o, pbody);
                if ok != OK_COPY && ok != OK_MOVE && ok != OK_PLACE {
                    continue;
                }
                let l = op_a(s.ops, o, pbody);
                let p = op_b(s.ops, o, pbody);
                if ok != OK_PLACE && p == 0 && pcx.ssa_st[l] == written {
                    pcx.ssa_st[l] = written + 2;
                } else {
                    pcx.ssa_st[l] = -1;
                    ssa_bad_indices(p, pbody, &pcx);
                }
            }
            if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC {
                if s.b == 0 && pcx.ssa_st[s.a] == 0 {
                    pcx.ssa_st[s.a] = written;
                } else {
                    pcx.ssa_st[s.a] = -1;
                    ssa_bad_indices(s.b, pbody, &pcx);
                }
            } else if k == SK_DROP || k == SK_MENTION {
                pcx.ssa_st[s.a] = -1;
                ssa_bad_indices(s.b, pbody, &pcx);
                if k == SK_DROP && s.d >= 0 {
                    pcx.ssa_st[s.d] = -1;
                }
            }
        }
    }
    for l in 0..n {
        if pcx.ssa_st[l] < 0 || (pcx.ssa_st[l] & 3) != 3 {
            continue;
        }
        let flags = pbody.locals[l].flags;
        if (flags & LF_TEMP) == 0 || (flags & (LF_BORROWED | LF_STATIC | LF_FLAG)) != 0 {
            continue;
        }
        let ty = undistinct(pbody.locals[l].ty, pcx);
        if is_void(ty) || ty == TY_NEVER || is_compound(ty, pcx) {
            continue;
        }
        pbody.locals[l].flags = flags | LF_SSA;
    }
}

// The locals indexing projection list p: not SSA (a place names them).
fn ssa_bad_indices(p: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    var q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_INDEX {
            pcx.ssa_st[proj_val(q, pbody)] = -1;
        }
        q = proj_parent(q, pbody);
    }
}
