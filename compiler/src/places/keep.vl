// Kept bodies (0.26.1, request R1 of the code generators' agent;
// docs/design/places-ir.md §4): at a build, run_places keeps each
// elaborated body (keep_body, after elaborate), and a code generator puts
// it back into the P_* tables (load_body) when it generates the function,
// then frees it (free_body). Each of the six tables is kept as a copy of
// the exact size, made and put back whole (extend_from_slice: no field by
// field packing, 0.26.1 the builder's cost at a build), beside a header of
// three words.
//
// A kept body is the body as elaboration left it; its types are the
// checker's, distinct ones not erased (ir.vl: undistinct).

use crate::base::comp::Comp;
use crate::places::ir::{
    B_FN, B_NODE, B_PARAMS, PBlock, PLocal, PProj, PStmt, P_BLOCKS, P_LOCALS, P_OPS, P_PROJS,
    P_STMTS, P_TARGETS,
};

// Whether run_places keeps the bodies (a build whose code generators
// read the IR; `--keep-places` at check, for the tests).
pub static var KEEP_BODIES: bool = false;

// Per function (FNS index): its body's header (B_NODE, B_PARAMS, then 1:
// kept; three words a function), and its tables, empty when it has none.
static var K_HEAD: Vec<i64, Comp> = Vec::new_in(Comp {});
static var K_LOCALS: Vec<Vec<PLocal, Comp>, Comp> = Vec::new_in(Comp {});
static var K_PROJS: Vec<Vec<PProj, Comp>, Comp> = Vec::new_in(Comp {});
static var K_STMTS: Vec<Vec<PStmt, Comp>, Comp> = Vec::new_in(Comp {});
static var K_BLOCKS: Vec<Vec<PBlock, Comp>, Comp> = Vec::new_in(Comp {});
static var K_OPS: Vec<Vec<i64, Comp>, Comp> = Vec::new_in(Comp {});
static var K_TARGETS: Vec<Vec<i64, Comp>, Comp> = Vec::new_in(Comp {});
// The bodies kept and not freed, and the words they hold.
pub static var KEPT_COUNT: i64 = 0;
pub static var KEPT_WORDS: i64 = 0;

// The words of a kept local, projection, statement, block.
const W_LOCAL: i64 = 4;
const W_PROJ: i64 = 5;
const W_STMT: i64 = 9;
const W_BLOCK: i64 = 2;

// The body held (P_* tables), kept for its function B_FN.
pub fn keep_body() {
    let f = B_FN;
    if f < 0 {
        return;
    }
    while K_LOCALS.len() <= f {
        K_HEAD.push(0);
        K_HEAD.push(0);
        K_HEAD.push(0);
        K_LOCALS.push(Vec::new_in(Comp {}));
        K_PROJS.push(Vec::new_in(Comp {}));
        K_STMTS.push(Vec::new_in(Comp {}));
        K_BLOCKS.push(Vec::new_in(Comp {}));
        K_OPS.push(Vec::new_in(Comp {}));
        K_TARGETS.push(Vec::new_in(Comp {}));
    }
    if has_kept(f) {
        free_body(f);
    }
    K_HEAD[3 * f] = B_NODE;
    K_HEAD[3 * f + 1] = B_PARAMS;
    K_HEAD[3 * f + 2] = 1;
    var l: Vec<PLocal, Comp> = Vec::with_capacity_in(P_LOCALS.len(), Comp {});
    l.extend_from_slice(P_LOCALS.as_slice());
    K_LOCALS.set(f, l);
    var p: Vec<PProj, Comp> = Vec::with_capacity_in(P_PROJS.len(), Comp {});
    p.extend_from_slice(P_PROJS.as_slice());
    K_PROJS.set(f, p);
    var s: Vec<PStmt, Comp> = Vec::with_capacity_in(P_STMTS.len(), Comp {});
    s.extend_from_slice(P_STMTS.as_slice());
    K_STMTS.set(f, s);
    var b: Vec<PBlock, Comp> = Vec::with_capacity_in(P_BLOCKS.len(), Comp {});
    b.extend_from_slice(P_BLOCKS.as_slice());
    K_BLOCKS.set(f, b);
    var o: Vec<i64, Comp> = Vec::with_capacity_in(P_OPS.len(), Comp {});
    o.extend_from_slice(P_OPS.as_slice());
    K_OPS.set(f, o);
    var t: Vec<i64, Comp> = Vec::with_capacity_in(P_TARGETS.len(), Comp {});
    t.extend_from_slice(P_TARGETS.as_slice());
    K_TARGETS.set(f, t);
    KEPT_COUNT += 1;
    KEPT_WORDS += words(f);
}

// The words function f's kept tables hold.
fn words(f: i64) -> i64 {
    3 + W_LOCAL * K_LOCALS[f].len() + W_PROJ * K_PROJS[f].len() + W_STMT * K_STMTS[f].len()
        + W_BLOCK * K_BLOCKS[f].len() + K_OPS[f].len() + K_TARGETS[f].len()
}

// Whether function f has a kept body.
pub fn has_kept(f: i64) -> bool {
    f >= 0 && f < K_LOCALS.len() && K_HEAD[3 * f + 2] != 0
}

// Function f's kept body put back into the P_* tables (as body_begin and
// the builder left them, with no block open): false when it has none.
pub fn load_body(f: i64) -> bool {
    if !has_kept(f) {
        return false;
    }
    crate::places::ir::B_FN = f;
    crate::places::ir::B_NODE = K_HEAD[3 * f];
    crate::places::ir::B_PARAMS = K_HEAD[3 * f + 1];
    crate::places::ir::B_SHIM = -1;
    P_LOCALS.clear();
    P_LOCALS.extend_from_slice(K_LOCALS[f].as_slice());
    P_PROJS.clear();
    P_PROJS.extend_from_slice(K_PROJS[f].as_slice());
    P_STMTS.clear();
    P_STMTS.extend_from_slice(K_STMTS[f].as_slice());
    P_BLOCKS.clear();
    P_BLOCKS.extend_from_slice(K_BLOCKS[f].as_slice());
    P_OPS.clear();
    P_OPS.extend_from_slice(K_OPS[f].as_slice());
    P_TARGETS.clear();
    P_TARGETS.extend_from_slice(K_TARGETS[f].as_slice());
    crate::places::ir::CUR_BLOCK = -1;
    true
}

// Function f's kept body freed (once its function is generated).
pub fn free_body(f: i64) {
    if !has_kept(f) {
        return;
    }
    KEPT_COUNT -= 1;
    KEPT_WORDS -= words(f);
    K_HEAD[3 * f + 2] = 0;
    K_LOCALS[f].free();
    K_PROJS[f].free();
    K_STMTS[f].free();
    K_BLOCKS[f].free();
    K_OPS[f].free();
    K_TARGETS[f].free();
}

// Every kept body freed.
pub fn free_all() {
    for f in 0..K_LOCALS.len() {
        free_body(f);
    }
}
