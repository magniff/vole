// The places IR (0.26.0, docs/design/places-ir.md): a MIR-like form of
// every checked function body, its drops placed and elaborated per place
// (0.26.2: the own pass places none), which both code generators read.
// places/README.md says what is where.
//
// The driver: check_program calls run_places once the bodies are
// checked (and before the effects), and after_own once the own pass ran.
// A build builds every body; a check the bodies that may drop, for the
// effects' drop edges (by_glue). The options (main's arguments, every
// command that checks):
//
//   --places            nothing more since 0.26.2 (the IR is always built)
//   --emit-places       print the program's bodies (stdout); =all: std's
//                       too
//   --verify-places     check every body (places/verify.vl); a fallback
//                       is reported with the construct it stopped at
//   --places-diff       check where each drop runs and its flag (diff.vl)
//   --keep-places       keep each body (as a build whose code generators
//                       read the IR does: keep.vl), and print the kept
//                       ones (--emit-places) loaded back
//   --places-lean       storage markers only for locals with glue, even
//                       when printing (as a check or a build has them)
//   --emit-shims        with --emit-places: the drop shims the printed
//                       bodies' drops call, and theirs (shim.vl)
//   --borrowck-partial  (0.27.4, informational) the bodies that
//                       type-checked built and borrow-checked though the
//                       program has type errors (the bodies that failed
//                       are left out, wanted): gate 3's borrowck count

pub mod ir;
pub mod cfg;
pub mod front;
pub mod print;
pub mod verify;
pub mod build;
pub mod elab;
pub mod diff;
pub mod keep;
pub mod shim;
// (0.27.0: the rust edition's region variables)
pub mod regions;
pub mod borrowck;

use crate::base::{STDERR, STDOUT, buf_fmt, buf_int, buf_new, buf_str, buf_write_fd, die, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_fmt, err_help, error_count};
use crate::base::timer::{T_CHECK, T_PLACES_BUILD, timer_now, timer_sub};
use crate::front::ast::{FN_BODY_FAILED, FN_SIG_FAILED, NodeKind};
use crate::front::check::has_error_type;
use crate::front::modules::within_std;
use crate::front::own::drops::drops_on;
use crate::places::build::build_body;
use crate::places::diff::{diff_begin, record_body, report_count, report_moves};
use crate::places::elab::elaborate;
use crate::places::front::{fn_generic, fn_is_extern, fn_module, fn_node};
use crate::places::ir::{
    Body, DS_FLAG, DS_KEPT, LF_PARAM, LF_USER, OK_MOVE, SK_ASSIGN, SK_DROP, block_count, block_len,
    block_start, full_place_type, op_a, op_kind,
};
use crate::places::keep::{keep_body, load_body};
use crate::places::print::{buf_fn_name, buf_pos, print_body};
use crate::places::shim::{
    build_shim, drop_fn_at, drop_fn_count, late_drop, late_drop_count, make_shim_functions,
    shim_count, shim_fn, shim_of, shim_type,
};
use crate::places::verify::verify_body;


// `--borrowck-partial`: run_places with type errors left.
static BORROWCK_PARTIAL: Atomic<bool> = Atomic::new(false);

// One of the options above (main's arguments): false when arg is not one.
pub fn places_option(arg: &str, pcx: &mut Ctx<Comp>) -> bool {
    if arg == "--places" {
        pcx.places_on = true;
    } else if arg == "--emit-places" {
        pcx.emit_places = 1;
    } else if arg == "--emit-places=all" {
        pcx.emit_places = 2;
    } else if arg == "--emit-places=regions" {
        // (0.27.1: the bodies and the borrow checker's dump, borrowck/dump.vl)
        pcx.emit_places = 1;
        crate::places::borrowck::set_emit_regions(true);
    } else if arg == "--borrowck-partial" {
        // (0.27.4: tests/gate3.sh's count of the borrow checker's errors)
        set_borrowck_partial(true);
    } else if arg == "--std2-check" {
        // (0.27.2: every std2 body type-checked and solved, borrowck/std2.vl)
        crate::places::borrowck::std2::set_std2_check(true);
    } else if arg == "--verify-places" {
        pcx.verify_places = true;
    } else if arg == "--places-diff" {
        pcx.places_diff = true;
    } else if arg == "--keep-places" {
        pcx.keep_bodies = true;
    } else if arg == "--places-lean" {
        pcx.lean = true;
    } else if arg == "--emit-shims" {
        pcx.emit_shims = true;
    } else if arg == "--places-noglue-check" {
        pcx.skip_check = true;
    } else {
        return false;
    }
    // (the tools' cache is not used with these: tools/query/cache.vl's
    // usable asks places_enabled)
    true
}

// Whether one of the IR's options is on (the tools' cache is not used
// then). The IR is built without one too (run_places): at a check, the
// bodies that may drop; `--places` asks nothing more since 0.26.2.
pub fn places_enabled(pcx: &Ctx<Comp>) -> bool {
    pcx.places_on || pcx.emit_places > 0 || pcx.verify_places || pcx.places_diff
        || pcx.keep_bodies
}

// Whether function f has a checked body to build: not a generic template,
// not C's, its body checked without an error.
fn wanted(f: i64, pcx: &Ctx<Comp>) -> bool {
    let item = fn_node(f, pcx);
    if item <= 0 || pcx.nodes[item as usize].kind != NodeKind::Fn || fn_generic(f, pcx)
        || fn_is_extern(f, pcx) {
        return false;
    }
    // (0.27.2: checked only for a query, front/check: check_unchecked)
    if (pcx.fns[f as usize].attrs & crate::front::ast::FN_QUERY_ONLY) != 0 {
        return false;
    }
    let body = pcx.nodes[item as usize].c;
    if body == 0 || pcx.nodes[body as usize].ty == 0 {
        return false;
    }
    // (an instance the checker made with an error type for an argument, or
    // a closure in one: its body is not checked whole)
    let t = crate::places::front::fn_template(f, pcx);
    if t != f {
        let mut i: i64 = 0;
        while crate::places::front::fn_targ(f, i, pcx) > 0 {
            if has_error_type(crate::places::front::fn_targ(f, i, pcx), pcx) {
                return false;
            }
            i += 1;
        }
    }
    if has_error_type(crate::places::front::fn_ret(f, pcx), pcx) {
        return false;
    }
    for i in 0..crate::places::front::fn_param_count(f, pcx) {
        if has_error_type(crate::front::types::fn_param(f, i, pcx), pcx) {
            return false;
        }
    }
    (pcx.nodes[item as usize].p & (FN_BODY_FAILED | FN_SIG_FAILED)) == 0
}

// Function f, which glue_met says drops nothing, built and elaborated:
// a line on stderr when it has a drop that runs (kept, flagged, open).
fn check_no_glue(f: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !build_body(f, fn_node(f, pcx), pbody, pcx) {
        return;
    }
    elaborate(pbody, pcx);
    let mut drops: i64 = 0;
    for s in 0..pbody.stmts.len() {
        if pbody.stmts[s].kind == crate::places::ir::SK_DROP
            && pbody.stmts[s].c != crate::places::ir::DS_REMOVED {
            drops += 1;
        }
    }
    if drops > 0 {
        let out = buf_new();
        buf_str(out, c"places.noglue: ");
        crate::places::print::buf_fn_name(out, f, pcx);
        buf_str(out, c": ");
        buf_int(out, drops);
        buf_str(out, c" drops\n");
        buf_write_fd(out, STDERR);
    }
}

// Whether run_places builds only the bodies that may drop (glue_met): at
// a check that neither keeps nor prints nor verifies every body.
pub fn by_glue(pcx: &Ctx<Comp>) -> bool {
    !(pcx.keep_bodies || pcx.verify_places || pcx.places_diff || pcx.emit_places > 0)
}

// check_program, the bodies checked: every body built (and verified,
// printed, when asked); at a check, the bodies that may drop (by_glue),
// for the drop edges the effects take (0.26.2: the own pass gives none
// since step 7). Not when the program has errors already: it stops before
// code anyway, and a body that failed is not whole.
pub fn run_places(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    // RULE: Z7 (`--std2-check`: the bodies that type-checked, with others
    // that did not)
    let std2_check = crate::places::borrowck::std2::std2_check(pcx);
    if error_count(pcx) > 0 && !std2_check && !get_borrowck_partial() {
        return;
    }
    let t = timer_now(pcx);
    let out = buf_new();
    let mut bck = crate::places::borrowck::state_new();
    pcx.fallbacks = 0;
    pcx.built = 0;
    pcx.no_glue = 0;
    pcx.all_bodies = pcx.keep_bodies || pcx.verify_places || pcx.places_diff || pcx.emit_places > 0;
    pcx.all_storage = (pcx.verify_places || pcx.emit_places > 0) && !pcx.lean;
    pcx.ran = true;
    diff_begin(pcx);
    if pcx.edition != 0 {
        // (0.27.1: the variance of every user type, before the bodies)
        crate::places::regions::variance_table(pcx);
        // (0.27.2: every closure's kind and env type, before the bodies:
        // D19.2-D19.4, front/closures/kinds.vl)
        crate::front::closures::kinds::infer_kinds(pbody, pcx);
    }
    // (FN_COUNT grows: a `Drop::drop` instance a drop needs is made here,
    // shim.vl: drop_fn, and built in turn; 0.26.2: a std `drop` that
    // nothing called, checked only now, is built before the functions
    // after the one that needs it, shim.vl late_drop)
    // RULE: D19.10 (a closure body is solved before the body that makes it:
    // its requirements are that body's constraints; nested ones innermost
    // first, by their order of creation reversed)
    let mut first = Vec::<i64, Comp>::new_in(Comp {});
    if pcx.edition != 0 {
        let mut id = pcx.closures.len() as i64 - 1;
        while id >= 0 {
            let g = pcx.closures[id as usize].f;
            if pcx.closures[id as usize].xc_at > 0 || pcx.closures[id as usize].kind != 0 {
                pcx.next_fn = g + 1;
                place_body(g, out, &mut bck, pbody, pcx);
                first.push(g);
            }
            id -= 1;
        }
    }
    let mut f: i64 = 0;
    let mut late: i64 = 0;
    while f < pcx.fns.len() as i64 || late < late_drop_count(pcx) {
        if late < late_drop_count(pcx) {
            place_body(late_drop(late, pcx), out, &mut bck, pbody, pcx);
            late += 1;
        } else {
            pcx.next_fn = f + 1;
            if !first.contains(&f) {
                place_body(f, out, &mut bck, pbody, pcx);
            }
            f += 1;
        }
    }
    // RULE: D4.4 (e) (0.27.6: the concrete instances' errors held, every
    // opaque instance solved)
    crate::places::borrowck::release_held(&bck, pcx);
    if pcx.keep_bodies && drops_on(pcx) {
        // (the shims as functions, before the code generators size their
        // tables; their effects: the drop functions they call)
        make_shim_functions(pbody, pcx);
        for id in 0..shim_count(pcx) {
            record_type_edges(shim_fn(id, pcx), shim_type(id, pcx), pbody, pcx);
        }
    }
    if pcx.keep_bodies && pcx.emit_places > 0 {
        // (the kept bodies printed as a code generator would see them)
        for g in 0..pcx.fns.len() as i64 {
            if printed(g, pcx) && load_body(g, pbody, pcx) {
                print_body(out, pbody, pcx);
                // (load_body took it: kept again, for the code generators)
                keep_body(pbody, pcx);
            }
        }
    }
    if pcx.emit_shims && pcx.emit_places > 0 {
        print_shims(out, pbody, pcx);
    }
    if crate::places::borrowck::emit_regions() {
        crate::places::borrowck::dump::print_solved(out, &bck);
        // RULE: D22.2 (0.27.2.1: the templates checked by an opaque instance)
        if pcx.edition != 0 {
            buf_fmt(out, format_args("opaque: {} templates\n", pcx.opaque_count));
        }
    }
    if std2_check {
        crate::places::borrowck::std2::report(pcx);
    }
    crate::places::borrowck::cache::save(&mut bck, pcx);
    buf_write_fd(out, STDOUT);
    pcx.t_places_bodies[0] = pcx.built;
    pcx.t_places_bodies[1] = pcx.fallbacks;
    pcx.t_places_bodies[2] = pcx.no_glue;
    // (the build's time, elaboration's with it)
    timer_sub(T_CHECK, T_PLACES_BUILD, t, pcx);
    if pcx.verify_places && pcx.verify_errors > 0 {
        let msg = buf_new();
        buf_str(msg, c"places.verify: ");
        buf_int(msg, pcx.verify_errors);
        buf_str(msg, c" problems in the places IR (internal)\n");
        buf_write_fd(msg, STDERR);
        die(c"places.verify failed");
    }
}

// RULE: Z7.2 (0.27.4) Whether f's body, std2's and not an instance, is
// left unsolved in this build: std2 the embedded text (its bytes the ones
// the std2-check row solved when the compiler was built), not a query or
// `--std2-check`; f an item of std2 (not a closure, whose captures may be
// an instance's), no template's instance, and, a trait's default copied
// into an impl, the impl std2's own (an impl a program writes for its
// type is solved).
fn std2_settled(f: i64, pcx: &Ctx<Comp>) -> bool {
    if !crate::front::modules::std2lazy::building() || !crate::front::known::on_std2(pcx)
        || pcx.std_tree != 0 as *mut u8 || pcx.std_tree_env != 0 as *mut u8 || pcx.query
        || crate::places::borrowck::std2::std2_check(pcx) || pcx.fns[f as usize].tmpl != 0
        || pcx.fns[f as usize].generic != 0 || !crate::places::borrowck::cache::std_body(f, pcx) {
        return false;
    }
    let node = fn_node(f, pcx);
    if node <= 0 || pcx.nodes[node as usize].kind != NodeKind::Fn {
        return false;
    }
    let i = crate::front::traits::impl_of_fn(f, pcx);
    i < 0 || crate::front::modules::file_of_pos(pcx.nodes[pcx.traits_impls[i as usize].node as usize].start, pcx)
        == pcx.std_file
}

// Function f's body (run_places), when it has one to build: built,
// elaborated, recorded, verified, then kept or printed.
fn place_body(f: i64, out: i64, bck: &mut crate::places::borrowck::Bck<Comp>,
    pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !wanted(f, pcx) {
        return;
    }
    // (0.27.0) a rust-edition function: its body always built, with every
    // local's storage markers and its region variables (regions.vl)
    let rust = pcx.edition != 0 && crate::places::regions::rust_fn(f, pcx);
    if !pcx.all_bodies && !rust && !crate::front::own::fast::glue_met(f, pcx) {
        // (nothing in it has glue: no drop, no flag, no drop edge to
        // build at check; a build, --verify-places and --places-diff
        // build every body)
        pcx.no_glue += 1;
        if pcx.skip_check {
            check_no_glue(f, pbody, pcx);
        }
        return;
    }
    let all_storage = pcx.all_storage;
    pcx.all_storage = all_storage || rust;
    pcx.rust_body = rust && crate::places::regions::rust_operands(f, pcx);
    let errors = error_count(pcx);
    let built = build_body(f, fn_node(f, pcx), pbody, pcx);
    pcx.all_storage = all_storage;
    pcx.rust_body = false;
    if built && rust {
        contract_moves(f, pbody, pcx);
    }
    if !built {
        pcx.fallbacks += 1;
        if pcx.verify_places {
            report_fallback(f, pcx);
        }
        return;
    }
    // (not timed apart from the build: a timer read is a system call,
    // some 30k instructions, as much as a small body costs)
    elaborate(pbody, pcx);
    if rust {
        crate::places::regions::assign_regions(pbody, pcx);
        // (0.27.1) NLL: liveness, constraints, the solve (borrowck/mod.vl);
        // not on a body the builder or the elision rules rejected (D4.2,
        // D6.2.5)
        if error_count(pcx) == errors && std2_settled(f, pcx) {
            // RULE: Z7.2 (std2's own body: the verdict the std2-check row
            // found, clean)
            crate::places::borrowck::set_verdict(f, crate::places::borrowck::VERDICT_CLEAN, pcx);
        } else if error_count(pcx) == errors {
            let verdict = crate::places::borrowck::check_body(f, bck, pbody, pcx);
            crate::places::borrowck::set_verdict(f, verdict, pcx);
        }
    }
    if drops_on(pcx) {
        record_body(pcx.places_diff, pbody, pcx);
        if pcx.runs_drops {
            record_drop_edges(f, pbody, pcx);
        }
    }
    if pcx.verify_places {
        verify_body(pbody, pcx);
    }
    if pcx.keep_bodies {
        if pcx.runs_drops {
            ask_shims(pbody, pcx);
        }
        crate::places::keep::mark_ssa(pbody, pcx);
        keep_body(pbody, pcx);
    } else if printed(f, pcx) {
        print_body(out, pbody, pcx);
        if crate::places::borrowck::emit_regions() {
            crate::places::borrowck::dump::print_regions(out, bck, pbody, pcx);
        }
    }
}

// RULE: C3.2 (0.27.1) A rust-edition clause reads in place: a move of a
// parameter (or of a part of one) in a `requires`, f$pre's body, or of
// `result` in an ensures, the wrapper's but for its return (C3.3), is
// contract.move; reported once per function.
fn contract_moves(f: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let pre = crate::front::contracts::expand::is_pre_fn(f, pcx);
    if !pre && !has_ensures(f, pcx) {
        return;
    }
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 {
            continue;
        }
        for s in start..start + block_len(b, pbody) + 1 {
            let st = pbody.stmts[s as usize];
            for i in 0..st.nops {
                if op_kind(st.ops, i, pbody) != OK_MOVE {
                    continue;
                }
                let lc = pbody.locals[op_a(st.ops, i, pbody) as usize];
                if lc.src < 0 {
                    continue;
                }
                let name = sym_text(pcx.locals[lc.src as usize].name, pcx);
                let bad = if pre { (lc.flags & LF_PARAM) != 0 }
                    else {
                        (lc.flags & LF_USER) != 0 && name == b"result"
                            && !(st.kind == SK_ASSIGN && st.a == 0)
                    };
                if bad && st.node > 0 {
                    err_begin(pcx.nodes[st.node as usize].start, pcx);
                    err_fmt({ let name = str::from_utf8(name).unwrap(); format_args("a clause moves '{name}': a `requires` or an `ensures` reads its parameters and `result` in place, and the function still has them") }, pcx);
                    err_help(c"read it or a part of it, or borrow it: `&x`, `x.len()`, `x.clone()`",
                        pcx);
                    crate::front::contracts::diag::end_with_code(c"contract.move", pcx);
                    return;
                }
            }
        }
    }
}

// Whether function f (an instance's template) has an ensures clause: it
// is the wrapper that calls f$body and checks the result.
pub fn has_ensures(f: i64, pcx: &Ctx<Comp>) -> bool {
    let t = if pcx.fns[f as usize].tmpl > 0 { pcx.fns[f as usize].tmpl - 1 } else { f };
    let node = pcx.fns[t as usize].node;
    for k in 0..pcx.clause_owner.count {
        if pcx.clause_owner.get(k) == node
            && (pcx.clause_kind.get(k) & ~crate::front::contracts::CLAUSE_DEBUG)
            == crate::front::contracts::CLAUSE_ENSURES {
            return true;
        }
    }
    false
}

// RULE: C3.3 (0.27.1, for the borrow checker's use_borrowed) The help of
// an error whose place, rooted at `root`, is borrowed by `result` in
// function f's ensures (the wrapper holds `result`'s loan until it
// returns): added when f has an ensures; returns whether it was.
pub fn result_borrow_help(f: i64, root: &[u8], pcx: &mut Ctx<Comp>) -> bool {
    if f < 0 || !has_ensures(f, pcx) {
        return false;
    }
    crate::base::diag::err_help_fmt(
        { let root = str::from_utf8(root).unwrap(); format_args(
            "'{root}' is borrowed by 'result'; state the promise on '*result' or on 'old(..)'") },
        pcx);
    true
}

// Whether --emit-places prints function f's body.
fn printed(f: i64, pcx: &Ctx<Comp>) -> bool {
    !crate::places::shim::is_shim_fn(f, pcx)
        && (pcx.emit_places == 2 || pcx.emit_places == 1 && !within_std(fn_module(f, pcx), pcx))
}

// --emit-shims: the shims of the types the printed bodies drop (kept or
// under a flag), then of the types their drops drop, each built and
// printed (and verified, with --verify-places).
fn print_shims(out: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.keep_bodies {
        // (every shim, made a function and kept)
        for id in 0..shim_count(pcx) {
            if load_body(shim_fn(id, pcx), pbody, pcx) {
                if pcx.verify_places {
                    verify_body(pbody, pcx);
                }
                print_body(out, pbody, pcx);
                keep_body(pbody, pcx);
            }
        }
        return;
    }
    for f in 0..pcx.fns.len() as i64 {
        if !printed(f, pcx) || !wanted(f, pcx) {
            continue;
        }
        if pcx.keep_bodies {
            if !load_body(f, pbody, pcx) {
                continue;
            }
        } else if !build_body(f, fn_node(f, pcx), pbody, pcx) {
            continue;
        } else {
            elaborate(pbody, pcx);
        }
        ask_shims(pbody, pcx);
    }
    let mut id: i64 = 0;
    while id < shim_count(pcx) {
        build_shim(id, pbody, pcx);
        ask_shims(pbody, pcx);
        if pcx.verify_places {
            verify_body(pbody, pcx);
        }
        print_body(out, pbody, pcx);
        id += 1;
    }
}

// The shims of the body held's drops that run (kept, or under a flag).
fn ask_shims(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    for s in 0..pbody.stmts.len() {
        let st = pbody.stmts[s];
        if st.kind == SK_DROP && (st.c == DS_KEPT || st.c == DS_FLAG) {
            let t = full_place_type(st.a, st.b, pbody, pcx);
            // RULE: D22.2 (0.27.6: an opaque instance's drop of a type that
            // holds an Ω, `Vec<i64, Ω>`, asks for no shim: the shims are
            // lowered, and that one called a `drop` no instance made)
            if !crate::front::opaque::holds_omega(t, pcx) {
                shim_of(t, pcx);
            }
        }
    }
}

// `places.fallback: FN: FILE:LINE:COL`, the construct a body stopped at.
fn report_fallback(f: i64, pcx: &mut Ctx<Comp>) {
    let out = buf_new();
    buf_str(out, c"places.fallback: ");
    buf_fn_name(out, f, pcx);
    buf_str(out, c": ");
    if pcx.fail_node > 0 {
        buf_pos(out, pcx.nodes[pcx.fail_node as usize].start, pcx);
        // (its text, to the end of its first line, at most 40 bytes)
        let start = pcx.nodes[pcx.fail_node as usize].start;
        let mut end = pcx.nodes[pcx.fail_node as usize].end;
        if end > start + 40 {
            end = start + 40;
        }
        buf_str(out, c" `");
        for i in start..end {
            let ch = crate::base::get_src()[i as usize];
            if ch == b'\n' {
                break;
            }
            crate::base::buf_byte(out, ch);
        }
        buf_str(out, c"`");
    }
    buf_str(out, c"\n");
    buf_write_fd(out, STDERR);
}

// check_program, after the own pass (in a program it passed): the
// move-out backstop's errors, then, with --places-diff, the count of
// the drops checked and the differences (places/diff.vl).
pub fn after_own(pcx: &mut Ctx<Comp>) {
    if !pcx.ran || error_count(pcx) > 0 {
        return;
    }
    if drops_on(pcx) {
        report_moves(pcx);
    }
    if pcx.places_diff && error_count(pcx) == 0 {
        report_count(pcx);
    }
}

// ---- Drop edges (0.26.1, places-ir.md §4) ----

// The drop edges of the body held (function f), recorded.
fn record_drop_edges(f: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    while pcx.de_at.len() as i64 <= f {
        pcx.de_at.push(0);
        pcx.de_n.push(0);
    }
    let start = pcx.de_list.len() as i64;
    for s in 0..pbody.stmts.len() {
        let st = pbody.stmts[s];
        if st.kind != SK_DROP || st.c != DS_KEPT && st.c != DS_FLAG {
            continue;
        }
        let t = full_place_type(st.a, st.b, pbody, pcx);
        let local = pbody.locals[st.a as usize].node;
        let node = if local > 0 { local } else { st.node };
        for i in 0..drop_fn_count(t, pbody, pcx) {
            let df = drop_fn_at(t, i, pcx);
            let mut seen = false;
            for j in start..pcx.de_list.len() as i64 {
                if pcx.de_list[j as usize] == df {
                    seen = true;
                }
            }
            if !seen {
                pcx.de_list.push(df);
                pcx.de_node.push(node);
            }
        }
    }
    if pcx.de_list.len() as i64 > start {
        pcx.de_at[f as usize] = start + 1;
        pcx.de_n[f as usize] = pcx.de_list.len() as i64 - start;
    }
}

// The drop edges of function f (a shim's) that dropping a value of type t
// has.
fn record_type_edges(f: i64, t: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    while pcx.de_at.len() as i64 <= f {
        pcx.de_at.push(0);
        pcx.de_n.push(0);
    }
    let start = pcx.de_list.len() as i64;
    for i in 0..drop_fn_count(t, pbody, pcx) {
        pcx.de_list.push(drop_fn_at(t, i, pcx));
        pcx.de_node.push(0);
    }
    if pcx.de_list.len() as i64 > start {
        pcx.de_at[f as usize] = start + 1;
        pcx.de_n[f as usize] = pcx.de_list.len() as i64 - start;
    }
}

// The number of drop edges of function f (0 when the IR was not built).
pub fn drop_edge_count(f: i64, pcx: &Ctx<Comp>) -> i64 {
    if f < pcx.de_at.len() as i64 && pcx.de_at[f as usize] > 0 { pcx.de_n[f as usize] } else { 0 }
}

// Function f's drop edge i: the function it calls.
pub fn drop_edge(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.de_list[(pcx.de_at[f as usize] - 1 + i) as usize]
}

// Function f's drop edge i: the node of the value it drops (0: a shim's).
pub fn drop_edge_node(f: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.de_node[(pcx.de_at[f as usize] - 1 + i) as usize]
}

use std::sync::atomic::{Atomic, Ordering};

// (0.28.0) BORROWCK_PARTIAL's accessors: every use of it is one of them.
// Atomic, Relaxed: only the main thread reads and writes it (no function a
// worker or the assembler thread runs touches it), so Relaxed orders
// nothing else.
fn get_borrowck_partial() -> bool {
    BORROWCK_PARTIAL.load(Ordering::Relaxed)
}

fn set_borrowck_partial(v: bool) {
    BORROWCK_PARTIAL.store(v, Ordering::Relaxed);
}
