// The places IR (0.26.0, docs/design/places-ir.md): a MIR-like form of
// every checked function body, its drops placed and elaborated per place
// (0.26.2: the own pass places none), which both code generators read.
// places/README.md says what is where.
//
// The driver: check_program calls run_places once the bodies are
// checked (and before the effects), and after_own once the own pass ran.
// A build builds every body; a check the bodies that may drop, for the
// effects' drop edges (by_glue). The options (main's arguments, every
// command that checks):
//
//   --places            nothing more since 0.26.2 (the IR is always built)
//   --emit-places       print the program's bodies (stdout); =all: std's
//                       too
//   --verify-places     check every body (places/verify.vl); a fallback
//                       is reported with the construct it stopped at
//   --places-diff       check where each drop runs and its flag (diff.vl)
//   --keep-places       keep each body (as a build whose code generators
//                       read the IR does: keep.vl), and print the kept
//                       ones (--emit-places) loaded back
//   --places-lean       storage markers only for locals with glue, even
//                       when printing (as a check or a build has them)
//   --emit-shims        with --emit-places: the drop shims the printed
//                       bodies' drops call, and theirs (shim.vl)

pub mod ir;
pub mod cfg;
pub mod front;
pub mod print;
pub mod verify;
pub mod build;
pub mod elab;
pub mod diff;
pub mod keep;
pub mod shim;
// (0.27.0: the rust edition's region variables)
pub mod regions;
pub mod borrowck;

use crate::base::{STDERR, STDOUT, buf_int, buf_new, buf_str, buf_write_fd, die};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_count;
use crate::base::timer::{T_CHECK, T_PLACES_BUILD, timer_now, timer_sub};
use crate::front::ast::{FN_BODY_FAILED, FN_SIG_FAILED, NodeKind};
use crate::front::check::has_error_type;
use crate::front::modules::within_std;
use crate::front::own::drops::drops_on;
use crate::places::build::build_body;
use crate::places::diff::{diff_begin, record_body, report_count, report_moves};
use crate::places::elab::elaborate;
use crate::places::front::{fn_generic, fn_is_extern, fn_module, fn_node};
use crate::places::ir::{Body, DS_FLAG, DS_KEPT, SK_DROP, full_place_type};
use crate::places::keep::{keep_body, load_body};
use crate::places::print::{buf_fn_name, buf_pos, print_body};
use crate::places::shim::{
    build_shim, drop_fn_at, drop_fn_count, late_drop, late_drop_count, make_shim_functions,
    shim_count, shim_fn, shim_of, shim_type,
};
use crate::places::verify::verify_body;
use crate::std::string::str;

// One of the options above (main's arguments): false when arg is not one.
pub fn places_option(arg: str, pcx: inout Ctx<Comp>) -> bool {
    if arg == "--places" {
        pcx.places_on = true;
    } else if arg == "--emit-places" {
        pcx.emit_places = 1;
    } else if arg == "--emit-places=all" {
        pcx.emit_places = 2;
    } else if arg == "--emit-places=regions" {
        // (0.27.1: the bodies and the borrow checker's dump, borrowck/dump.vl)
        pcx.emit_places = 1;
        crate::places::borrowck::set_emit_regions(true);
    } else if arg == "--verify-places" {
        pcx.verify_places = true;
    } else if arg == "--places-diff" {
        pcx.places_diff = true;
    } else if arg == "--keep-places" {
        pcx.keep_bodies = true;
    } else if arg == "--places-lean" {
        pcx.lean = true;
    } else if arg == "--emit-shims" {
        pcx.emit_shims = true;
    } else if arg == "--places-noglue-check" {
        pcx.skip_check = true;
    } else {
        return false;
    }
    // (the tools' cache is not used with these: tools/query/cache.vl's
    // usable asks places_enabled)
    true
}

// Whether one of the IR's options is on (the tools' cache is not used
// then). The IR is built without one too (run_places): at a check, the
// bodies that may drop; `--places` asks nothing more since 0.26.2.
pub fn places_enabled(pcx: Ctx<Comp>) -> bool {
    pcx.places_on || pcx.emit_places > 0 || pcx.verify_places || pcx.places_diff
        || pcx.keep_bodies
}

// Whether function f has a checked body to build: not a generic template,
// not C's, its body checked without an error.
fn wanted(f: i64, pcx: Ctx<Comp>) -> bool {
    let item = fn_node(f, pcx);
    if item <= 0 || pcx.nodes[item].kind != NodeKind::Fn || fn_generic(f, pcx)
        || fn_is_extern(f, pcx) {
        return false;
    }
    let body = pcx.nodes[item].c;
    if body == 0 || pcx.nodes[body].ty == 0 {
        return false;
    }
    // (an instance the checker made with an error type for an argument, or
    // a closure in one: its body is not checked whole)
    let t = crate::places::front::fn_template(f, pcx);
    if t != f {
        var i = 0;
        while crate::places::front::fn_targ(f, i, pcx) > 0 {
            if has_error_type(crate::places::front::fn_targ(f, i, pcx), pcx) {
                return false;
            }
            i += 1;
        }
    }
    if has_error_type(crate::places::front::fn_ret(f, pcx), pcx) {
        return false;
    }
    for i in 0..crate::places::front::fn_param_count(f, pcx) {
        if has_error_type(crate::front::types::fn_param(f, i, pcx), pcx) {
            return false;
        }
    }
    (pcx.nodes[item].p & (FN_BODY_FAILED | FN_SIG_FAILED)) == 0
}

// Function f, which glue_met says drops nothing, built and elaborated:
// a line on stderr when it has a drop that runs (kept, flagged, open).
fn check_no_glue(f: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    if !build_body(f, fn_node(f, pcx), &pbody, &pcx) {
        return;
    }
    elaborate(&pbody, &pcx);
    var drops = 0;
    for s in 0..pbody.stmts.len() {
        if pbody.stmts[s].kind == crate::places::ir::SK_DROP
            && pbody.stmts[s].c != crate::places::ir::DS_REMOVED {
            drops += 1;
        }
    }
    if drops > 0 {
        let out = buf_new();
        buf_str(out, c"places.noglue: ");
        crate::places::print::buf_fn_name(out, f, pcx);
        buf_str(out, c": ");
        buf_int(out, drops);
        buf_str(out, c" drops\n");
        buf_write_fd(out, STDERR);
    }
}

// Whether run_places builds only the bodies that may drop (glue_met): at
// a check that neither keeps nor prints nor verifies every body.
pub fn by_glue(pcx: Ctx<Comp>) -> bool {
    !(pcx.keep_bodies || pcx.verify_places || pcx.places_diff || pcx.emit_places > 0)
}

// check_program, the bodies checked: every body built (and verified,
// printed, when asked); at a check, the bodies that may drop (by_glue),
// for the drop edges the effects take (0.26.2: the own pass gives none
// since step 7). Not when the program has errors already: it stops before
// code anyway, and a body that failed is not whole.
pub fn run_places(pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    if error_count(pcx) > 0 {
        return;
    }
    let t = timer_now(pcx);
    let out = buf_new();
    var bck = crate::places::borrowck::state_new();
    pcx.fallbacks = 0;
    pcx.built = 0;
    pcx.no_glue = 0;
    pcx.all_bodies = pcx.keep_bodies || pcx.verify_places || pcx.places_diff || pcx.emit_places > 0;
    pcx.all_storage = (pcx.verify_places || pcx.emit_places > 0) && !pcx.lean;
    pcx.ran = true;
    diff_begin(&pcx);
    if pcx.edition != 0 {
        // (0.27.1: the variance of every user type, before the bodies)
        crate::places::regions::variance_table(&pcx);
    }
    // (FN_COUNT grows: a `Drop::drop` instance a drop needs is made here,
    // shim.vl: drop_fn, and built in turn; 0.26.2: a std `drop` that
    // nothing called, checked only now, is built before the functions
    // after the one that needs it, shim.vl late_drop)
    var f = 0;
    var late = 0;
    while f < pcx.fns.len() as i64 || late < late_drop_count(pcx) {
        if late < late_drop_count(pcx) {
            place_body(late_drop(late, pcx), out, &bck, &pbody, &pcx);
            late += 1;
        } else {
            pcx.next_fn = f + 1;
            place_body(f, out, &bck, &pbody, &pcx);
            f += 1;
        }
    }
    if pcx.keep_bodies && drops_on(pcx) {
        // (the shims as functions, before the code generators size their
        // tables; their effects: the drop functions they call)
        make_shim_functions(&pbody, &pcx);
        for id in 0..shim_count(pcx) {
            record_type_edges(shim_fn(id, pcx), shim_type(id, pcx), pbody, &pcx);
        }
    }
    if pcx.keep_bodies && pcx.emit_places > 0 {
        // (the kept bodies printed as a code generator would see them)
        for g in 0..pcx.fns.len() as i64 {
            if printed(g, pcx) && load_body(g, &pbody, &pcx) {
                print_body(out, pbody, &pcx);
                // (load_body took it: kept again, for the code generators)
                keep_body(pbody, &pcx);
            }
        }
    }
    if pcx.emit_shims && pcx.emit_places > 0 {
        print_shims(out, &pbody, &pcx);
    }
    if crate::places::borrowck::emit_regions() {
        crate::places::borrowck::dump::print_solved(out, bck);
    }
    buf_write_fd(out, STDOUT);
    pcx.t_places_bodies[0] = pcx.built;
    pcx.t_places_bodies[1] = pcx.fallbacks;
    pcx.t_places_bodies[2] = pcx.no_glue;
    // (the build's time, elaboration's with it)
    timer_sub(T_CHECK, T_PLACES_BUILD, t, pcx);
    if pcx.verify_places && pcx.verify_errors > 0 {
        let msg = buf_new();
        buf_str(msg, c"places.verify: ");
        buf_int(msg, pcx.verify_errors);
        buf_str(msg, c" problems in the places IR (internal)\n");
        buf_write_fd(msg, STDERR);
        die(c"places.verify failed");
    }
}

// Function f's body (run_places), when it has one to build: built,
// elaborated, recorded, verified, then kept or printed.
fn place_body(f: i64, out: i64, bck: inout crate::places::borrowck::Bck<Comp>,
    pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    if !wanted(f, pcx) {
        return;
    }
    // (0.27.0) a rust-edition function: its body always built, with every
    // local's storage markers and its region variables (regions.vl)
    let rust = pcx.edition != 0 && crate::places::regions::rust_fn(f, &pcx);
    if !pcx.all_bodies && !rust && !crate::front::own::fast::glue_met(f, &pcx) {
        // (nothing in it has glue: no drop, no flag, no drop edge to
        // build at check; a build, --verify-places and --places-diff
        // build every body)
        pcx.no_glue += 1;
        if pcx.skip_check {
            check_no_glue(f, &pbody, &pcx);
        }
        return;
    }
    let all_storage = pcx.all_storage;
    pcx.all_storage = all_storage || rust;
    pcx.rust_body = rust;
    let built = build_body(f, fn_node(f, pcx), &pbody, &pcx);
    pcx.all_storage = all_storage;
    pcx.rust_body = false;
    if !built {
        pcx.fallbacks += 1;
        if pcx.verify_places {
            report_fallback(f, &pcx);
        }
        return;
    }
    // (not timed apart from the build: a timer read is a system call,
    // some 30k instructions, as much as a small body costs)
    elaborate(&pbody, &pcx);
    if rust {
        crate::places::regions::assign_regions(&pbody, &pcx);
        crate::places::regions::unchecked_warning(f, &pcx);
        // (0.27.1) NLL: liveness, constraints, the solve (borrowck/mod.vl)
        crate::places::borrowck::check_body(f, &bck, &pbody, &pcx);
    }
    if drops_on(pcx) {
        record_body(pcx.places_diff, pbody, &pcx);
        if pcx.runs_drops {
            record_drop_edges(f, pbody, &pcx);
        }
    }
    if pcx.verify_places {
        verify_body(&pbody, &pcx);
    }
    if pcx.keep_bodies {
        if pcx.runs_drops {
            ask_shims(pbody, &pcx);
        }
        crate::places::keep::mark_ssa(&pbody, &pcx);
        keep_body(pbody, &pcx);
    } else if printed(f, pcx) {
        print_body(out, pbody, &pcx);
        if crate::places::borrowck::emit_regions() {
            crate::places::borrowck::dump::print_regions(out, bck, pbody, &pcx);
        }
    }
}

// Whether --emit-places prints function f's body.
fn printed(f: i64, pcx: Ctx<Comp>) -> bool {
    !crate::places::shim::is_shim_fn(f, pcx)
        && (pcx.emit_places == 2 || pcx.emit_places == 1 && !within_std(fn_module(f, pcx), pcx))
}

// --emit-shims: the shims of the types the printed bodies drop (kept or
// under a flag), then of the types their drops drop, each built and
// printed (and verified, with --verify-places).
fn print_shims(out: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    if pcx.keep_bodies {
        // (every shim, made a function and kept)
        for id in 0..shim_count(pcx) {
            if load_body(shim_fn(id, pcx), &pbody, &pcx) {
                if pcx.verify_places {
                    verify_body(&pbody, &pcx);
                }
                print_body(out, pbody, &pcx);
                keep_body(pbody, &pcx);
            }
        }
        return;
    }
    for f in 0..pcx.fns.len() as i64 {
        if !printed(f, pcx) || !wanted(f, pcx) {
            continue;
        }
        if pcx.keep_bodies {
            if !load_body(f, &pbody, &pcx) {
                continue;
            }
        } else if !build_body(f, fn_node(f, pcx), &pbody, &pcx) {
            continue;
        } else {
            elaborate(&pbody, &pcx);
        }
        ask_shims(pbody, &pcx);
    }
    var id = 0;
    while id < shim_count(pcx) {
        build_shim(id, &pbody, &pcx);
        ask_shims(pbody, &pcx);
        if pcx.verify_places {
            verify_body(&pbody, &pcx);
        }
        print_body(out, pbody, &pcx);
        id += 1;
    }
}

// The shims of the body held's drops that run (kept, or under a flag).
fn ask_shims(pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    for s in 0..pbody.stmts.len() {
        let st = pbody.stmts[s];
        if st.kind == SK_DROP && (st.c == DS_KEPT || st.c == DS_FLAG) {
            shim_of(full_place_type(st.a, st.b, pbody, &pcx), &pcx);
        }
    }
}

// `places.fallback: FN: FILE:LINE:COL`, the construct a body stopped at.
fn report_fallback(f: i64, pcx: inout Ctx<Comp>) {
    let out = buf_new();
    buf_str(out, c"places.fallback: ");
    buf_fn_name(out, f, pcx);
    buf_str(out, c": ");
    if pcx.fail_node > 0 {
        buf_pos(out, pcx.nodes[pcx.fail_node].start, &pcx);
        // (its text, to the end of its first line, at most 40 bytes)
        let start = pcx.nodes[pcx.fail_node].start;
        var end = pcx.nodes[pcx.fail_node].end;
        if end > start + 40 {
            end = start + 40;
        }
        buf_str(out, c" `");
        for i in start..end {
            let ch = crate::base::SRC[i];
            if ch == '\n' {
                break;
            }
            crate::base::buf_byte(out, ch);
        }
        buf_str(out, c"`");
    }
    buf_str(out, c"\n");
    buf_write_fd(out, STDERR);
}

// check_program, after the own pass (in a program it passed): the
// move-out backstop's errors, then, with --places-diff, the count of
// the drops checked and the differences (places/diff.vl).
pub fn after_own(pcx: inout Ctx<Comp>) {
    if !pcx.ran || error_count(pcx) > 0 {
        return;
    }
    if drops_on(pcx) {
        report_moves(&pcx);
    }
    if pcx.places_diff && error_count(pcx) == 0 {
        report_count(pcx);
    }
}

// ---- Drop edges (0.26.1, places-ir.md §4) ----

// The drop edges of the body held (function f), recorded.
fn record_drop_edges(f: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    while pcx.de_at.len() as i64 <= f {
        pcx.de_at.push(0);
        pcx.de_n.push(0);
    }
    let start = pcx.de_list.len() as i64;
    for s in 0..pbody.stmts.len() {
        let st = pbody.stmts[s];
        if st.kind != SK_DROP || st.c != DS_KEPT && st.c != DS_FLAG {
            continue;
        }
        let t = full_place_type(st.a, st.b, pbody, &pcx);
        let local = pbody.locals[st.a].node;
        let node = if local > 0 { local } else { st.node };
        for i in 0..drop_fn_count(t, pbody, &pcx) {
            let df = drop_fn_at(t, i, pcx);
            var seen = false;
            for j in start..pcx.de_list.len() as i64 {
                if pcx.de_list[j] == df {
                    seen = true;
                }
            }
            if !seen {
                pcx.de_list.push(df);
                pcx.de_node.push(node);
            }
        }
    }
    if pcx.de_list.len() as i64 > start {
        pcx.de_at[f] = start + 1;
        pcx.de_n[f] = pcx.de_list.len() as i64 - start;
    }
}

// The drop edges of function f (a shim's) that dropping a value of type t
// has.
fn record_type_edges(f: i64, t: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    while pcx.de_at.len() as i64 <= f {
        pcx.de_at.push(0);
        pcx.de_n.push(0);
    }
    let start = pcx.de_list.len() as i64;
    for i in 0..drop_fn_count(t, pbody, &pcx) {
        pcx.de_list.push(drop_fn_at(t, i, pcx));
        pcx.de_node.push(0);
    }
    if pcx.de_list.len() as i64 > start {
        pcx.de_at[f] = start + 1;
        pcx.de_n[f] = pcx.de_list.len() as i64 - start;
    }
}

// The number of drop edges of function f (0 when the IR was not built).
pub fn drop_edge_count(f: i64, pcx: Ctx<Comp>) -> i64 {
    if f < pcx.de_at.len() as i64 && pcx.de_at[f] > 0 { pcx.de_n[f] } else { 0 }
}

// Function f's drop edge i: the function it calls.
pub fn drop_edge(f: i64, i: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.de_list[pcx.de_at[f] - 1 + i]
}

// Function f's drop edge i: the node of the value it drops (0: a shim's).
pub fn drop_edge_node(f: i64, i: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.de_node[pcx.de_at[f] - 1 + i]
}
