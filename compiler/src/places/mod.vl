// The places IR (0.26.0, docs/design/places-ir.md): a MIR-like form of
// every checked function body, built beside the own pass's drops, its
// drops elaborated per place, checked against the own pass's
// (`--places-diff`). places/README.md says what is where.
//
// The driver: check_program calls run_places once the bodies are
// checked (and before the effects), and after_own once the own pass ran.
// The options (main's arguments, every command that checks):
//
//   --places            build the IR (0.26.0, step 2: off by default)
//   --no-places         do not
//   --emit-places       print the program's bodies (stdout); =all: std's
//                       too
//   --verify-places     check every body (places/verify.vl); a fallback
//                       is reported with the construct it stopped at
//   --places-diff       compare the drops with the own pass's

pub mod ir;
pub mod cfg;
pub mod front;
pub mod print;
pub mod verify;
pub mod build;

use crate::base::{STDERR, STDOUT, buf_int, buf_new, buf_str, buf_write_fd, die};
use crate::base::diag::error_count;
use crate::base::timer::{T_CHECK, T_PLACES_BODIES, T_PLACES_BUILD, timer_now, timer_sub};
use crate::front::ast::{FN_BODY_FAILED, FN_SIG_FAILED, NODES, NodeKind};
use crate::front::check::has_error_type;
use crate::front::modules::within_std;
use crate::front::types::FN_COUNT;
use crate::places::build::{BUILT, FAIL_NODE, build_body};
use crate::places::front::{fn_generic, fn_is_extern, fn_module, fn_node};
use crate::places::print::{buf_fn_name, buf_pos, print_body};
use crate::places::verify::{VERIFY_ERRORS, verify_body};
use crate::std::string::str;

pub static var PLACES_ON: bool = false;
pub static var PLACES_OFF: bool = false;
// 0: no; 1: the program's functions; 2: std's too.
pub static var EMIT_PLACES: i64 = 0;
pub static var VERIFY_PLACES: bool = false;
pub static var PLACES_DIFF: bool = false;
// The bodies not built (a construct the builder does not handle yet).
pub static var FALLBACKS: i64 = 0;

// One of the options above (main's arguments): false when arg is not one.
pub fn places_option(arg: str) -> bool {
    if arg == "--places" {
        PLACES_ON = true;
    } else if arg == "--no-places" {
        PLACES_OFF = true;
    } else if arg == "--emit-places" {
        EMIT_PLACES = 1;
    } else if arg == "--emit-places=all" {
        EMIT_PLACES = 2;
    } else if arg == "--verify-places" {
        VERIFY_PLACES = true;
    } else if arg == "--places-diff" {
        PLACES_DIFF = true;
    } else {
        return false;
    }
    if !PLACES_OFF {
        // (what the IR prints and checks is made by checking, which a
        // cached answer skips: no cache, as VOLE_CACHE=off)
        // UNSAFE: set_var changes the process's environment, which no
        // other thread may read meanwhile (std::env).
        // SAFETY: main reads its options before any thread starts, and
        // tools/query/cache.vl reads VOLE_CACHE after this.
        unsafe { crate::std::env::set_var("VOLE_CACHE", "off"); }
    }
    true
}

// Whether the IR is built.
pub fn places_enabled() -> bool {
    !PLACES_OFF && (PLACES_ON || EMIT_PLACES > 0 || VERIFY_PLACES || PLACES_DIFF)
}

// Whether function f has a checked body to build: not a generic template,
// not C's, its body checked without an error.
fn wanted(f: i64) -> bool {
    let item = fn_node(f);
    if item <= 0 || NODES[item].kind != NodeKind::Fn || fn_generic(f) || fn_is_extern(f) {
        return false;
    }
    let body = NODES[item].c;
    if body == 0 || NODES[body].ty == 0 {
        return false;
    }
    // (an instance the checker made with an error type for an argument, or
    // a closure in one: its body is not checked whole)
    let t = crate::places::front::fn_template(f);
    if t != f {
        var i = 0;
        while crate::places::front::fn_targ(f, i) > 0 {
            if has_error_type(crate::places::front::fn_targ(f, i)) {
                return false;
            }
            i += 1;
        }
    }
    if has_error_type(crate::places::front::fn_ret(f)) {
        return false;
    }
    for i in 0..crate::places::front::fn_param_count(f) {
        if has_error_type(crate::front::types::fn_param(f, i)) {
            return false;
        }
    }
    (NODES[item].p & (FN_BODY_FAILED | FN_SIG_FAILED)) == 0
}

// check_program, the bodies checked: every body built (and verified,
// printed, when asked). Not when the program has errors already: it stops
// before code anyway, and a body that failed is not whole.
pub fn run_places() {
    if !places_enabled() || error_count() > 0 {
        return;
    }
    let t = timer_now();
    let out = buf_new();
    FALLBACKS = 0;
    BUILT = 0;
    for f in 0..FN_COUNT {
        if !wanted(f) {
            continue;
        }
        if !build_body(f, fn_node(f)) {
            FALLBACKS += 1;
            if VERIFY_PLACES {
                report_fallback(f);
            }
            continue;
        }
        if VERIFY_PLACES {
            verify_body();
        }
        if EMIT_PLACES == 2 || EMIT_PLACES == 1 && !within_std(fn_module(f)) {
            print_body(out);
        }
    }
    buf_write_fd(out, STDOUT);
    T_PLACES_BODIES[0] = BUILT;
    T_PLACES_BODIES[1] = FALLBACKS;
    timer_sub(T_CHECK, T_PLACES_BUILD, t);
    if VERIFY_PLACES && VERIFY_ERRORS > 0 {
        let msg = buf_new();
        buf_str(msg, c"places.verify: ");
        buf_int(msg, VERIFY_ERRORS);
        buf_str(msg, c" problems in the places IR (internal)\n");
        buf_write_fd(msg, STDERR);
        die(c"places.verify failed");
    }
}

// `places.fallback: FN: FILE:LINE:COL`, the construct a body stopped at.
fn report_fallback(f: i64) {
    let out = buf_new();
    buf_str(out, c"places.fallback: ");
    buf_fn_name(out, f);
    buf_str(out, c": ");
    if FAIL_NODE > 0 {
        buf_pos(out, NODES[FAIL_NODE].start);
        // (its text, to the end of its first line, at most 40 bytes)
        let start = NODES[FAIL_NODE].start;
        var end = NODES[FAIL_NODE].end;
        if end > start + 40 {
            end = start + 40;
        }
        buf_str(out, c" `");
        for i in start..end {
            let ch = crate::base::SRC[i];
            if ch == '\n' {
                break;
            }
            crate::base::buf_byte(out, ch);
        }
        buf_str(out, c"`");
    }
    buf_str(out, c"\n");
    buf_write_fd(out, STDERR);
}
