// What the IR's elaborated bodies leave for after the own pass (0.26.0,
// docs/design/places-ir.md §3.8, §7.3), recorded per body by run_places
// and read by after_own:
//
// - the move-out backstop: a `move` out of an index, through a reference,
//   out of a static or of a BORROWED local is own.move_out, reported for
//   any the own pass let through (a program it passed);
// - `--places-diff` (0.26.1; 0.26.2: the comparison with the own pass's
//   drops gone with them): where each drop runs and its flag, check_drops
//   below, a use after a drop, a flag read before it is written, one line
//   each, `places.diff: FN: FILE:LINE:COL: 'NAME' WHAT`, then the count,
//   `places.diff: N differences in M drops checked`.

use crate::base::{STDERR, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::own::diag::{OWN_MOVE_OUT, own_begin, own_end, own_flush, own_str};
use crate::front::types::TyKind;
use crate::places::front::ast_local_name;
use crate::places::ir::{
    Body, DS_FLAG, DS_KEPT, LF_BORROWED, LF_STATIC, OK_INT, OK_MOVE, PJ_DEREF, PJ_INDEX, PStmt,
    RV_REF, RV_USE, SK_ASSIGN, SK_CALL, SK_DROP, SK_INTRINSIC, SK_LIVE, block_count, block_len,
    block_start, has_flag, op_a, op_b, op_is_place, op_kind, place_type, proj_kind, proj_parent,
    succ, succ_count, undistinct,
};
use crate::places::print::{buf_fn_name, buf_pos};

const W_INDEX: i64 = 1;
const W_REF: i64 = 2;
const W_STATIC: i64 = 3;
const W_BORROWED: i64 = 4;

pub fn diff_begin(pcx: inout Ctx<Comp>) {
    pcx.moves.clear();
    pcx.diffs = 0;
    pcx.compared = 0;
}

// The body held, elaborated: its drops checked (--places-diff, when
// `diff`), its moves out of places the own pass forbids; the statements of
// blocks never reached left out.
pub fn record_body(diff: bool, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    if diff {
        check_drops(pbody, &pcx);
    }
    // (std's containers and iterators copy elements as unsafe code does,
    // as the own pass's move_out: no backstop there)
    let moves = pcx.moves_suspect
        && !crate::front::modules::std_moves_bits(crate::places::front::fn_module(pbody.fn_, pcx),
            pcx);
    if !moves {
        return;
    }
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 || !reached(b, pbody, pcx) {
            continue;
        }
        for s in start..start + block_len(b, pbody) {
            record_moves(pbody.stmts[s], pbody, &pcx);
        }
    }
}

fn record_moves(st: PStmt, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    for i in 0..st.nops {
        if op_kind(st.ops, i, pbody) == OK_MOVE {
            let what = forbidden_move(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), pbody, &pcx);
            if what != 0 {
                pcx.moves.push(st.node);
                pcx.moves.push(what);
                pcx.moves.push(pbody.fn_);
            }
        }
    }
}

// Whether block b is reached from bb0 (elaboration's order, when it made
// one for this body; a block it added is).
fn reached(b: i64, pbody: Body<Comp>, pcx: Ctx<Comp>) -> bool {
    !pcx.rpo_fresh || b >= pbody.rpo_index.len() as i64 || pbody.rpo_index[b] >= 0
}

// Whether a move of place (l, p) is one the own pass forbids: out of an
// index, through a reference, out of a static or a BORROWED local (W_*;
// 0: none).
fn forbidden_move(l: i64, p: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    if has_flag(l, LF_STATIC, pbody) {
        return W_STATIC;
    }
    if has_flag(l, LF_BORROWED, pbody) {
        return W_BORROWED;
    }
    var q = p;
    while q > 0 {
        let k = proj_kind(q, pbody);
        if k == PJ_INDEX {
            // (an array's or a slice's element; a raw pointer's, `p[i]`, is
            // unsafe code's read)
            let t = undistinct(place_type(l, proj_parent(q, pbody), pbody, &pcx), pcx);
            if t > 0 && (pcx.types[t].kind == TyKind::Array || pcx.types[t].kind == TyKind::Slice) {
                return W_INDEX;
            }
        }
        if k == PJ_DEREF {
            let t = place_type(l, proj_parent(q, pbody), pbody, &pcx);
            if t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b != 0 {
                return W_REF;
            }
        }
        q = proj_parent(q, pbody);
    }
    0
}

// After the own pass, in a program it passed: the backstop's errors.
pub fn report_moves(pcx: inout Ctx<Comp>) {
    var i = 0;
    while i < pcx.moves.len() as i64 {
        let node = pcx.moves[i];
        let what = pcx.moves[i + 1];
        i += 3;
        if node <= 0 {
            continue;
        }
        own_begin(node, OWN_MOVE_OUT, &pcx);
        own_str(c"a value moves out of ", pcx);
        own_str(if what == W_INDEX { c"an element reached by index" }
            else if what == W_REF { c"a reference" } else if what == W_STATIC { c"a static" }
            else { c"a borrowed copy" }, pcx);
        own_str(c", which keeps it: the places IR's check, which the own pass missed (an internal error: please report it)", pcx);
        own_end(&pcx);
    }
    own_flush(&pcx);
}

pub fn report_count(pcx: Ctx<Comp>) {
    let out = buf_new();
    buf_str(out, c"places.diff: ");
    buf_int(out, pcx.diffs);
    buf_str(out, c" differences in ");
    buf_int(out, pcx.compared);
    buf_str(out, c" drops checked\n");
    buf_write_fd(out, STDERR);
}

// ---- Where a drop runs, and its flag (0.26.1) ----
//
// A per-local comparison of decisions misses a drop in the wrong place
// and a flag never written (R5, R6: --places-diff found 0 differences on
// both). Two checks of the body held, each difference one line:
//
// - a use after its drop: after a kept or flagged drop of place P, on a
//   path that does not make P again, a statement that reads P, or a
//   borrowed copy or a reference made from P (`_7 = copy _8; drop(_8);
//   eq(&_6, &_7)`): the own pass drops at the end of the statement (or
//   of the block), after its last use, `'NAME' used after its drop`;
// - a flag read before it is written: a flagged drop reached from the
//   entry on a path with no write to its flag, or a flag no statement
//   sets true (its drop never runs), `'NAME' under a flag never set`.

// Whether projection a is b or one of b's parents (0, the whole, is every
// projection's).
fn proj_within(a: i64, b: i64, pbody: Body<Comp>) -> bool {
    var q = b;
    while q > 0 {
        if q == a {
            return true;
        }
        q = proj_parent(q, pbody);
    }
    a == q
}

fn overlaps(a: i64, b: i64, pbody: Body<Comp>) -> bool {
    proj_within(a, b, pbody) || proj_within(b, a, pbody)
}

fn find_aliases(pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    pcx.aliases.clear();
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 {
            continue;
        }
        for s in start..start + block_len(b, pbody) {
            let st = pbody.stmts[s];
            if st.kind != SK_ASSIGN || st.b != 0 || st.a < 0 {
                continue;
            }
            if st.c != RV_REF && !(st.c == RV_USE && has_flag(st.a, LF_BORROWED, pbody)) {
                continue;
            }
            for i in 0..st.nops {
                if op_is_place(op_kind(st.ops, i, pbody)) && op_a(st.ops, i, pbody) != st.a {
                    pcx.aliases.push(st.a);
                    pcx.aliases.push(op_a(st.ops, i, pbody));
                    pcx.aliases.push(op_b(st.ops, i, pbody));
                }
            }
        }
    }
}

// Whether statement st reads place (l, p), or an alias of it.
fn reads(st: PStmt, l: i64, p: i64, pbody: Body<Comp>, pcx: Ctx<Comp>) -> bool {
    for i in 0..st.nops {
        if !op_is_place(op_kind(st.ops, i, pbody)) {
            continue;
        }
        let a = op_a(st.ops, i, pbody);
        if a == l && overlaps(p, op_b(st.ops, i, pbody), pbody) {
            return true;
        }
        var k = 0;
        while k < pcx.aliases.len() as i64 {
            if pcx.aliases[k] == a && pcx.aliases[k + 1] == l
                && overlaps(p, pcx.aliases[k + 2], pbody) {
                return true;
            }
            k += 3;
        }
    }
    if st.kind == SK_DROP && st.a == l && overlaps(p, st.b, pbody)
        && (st.c == DS_KEPT || st.c == DS_FLAG) {
        return true;
    }
    false
}

// Whether statement st makes place (l, p) again (all of it).
fn remakes(st: PStmt, l: i64, p: i64, pbody: Body<Comp>) -> bool {
    if st.kind == SK_LIVE && st.a == l {
        return true;
    }
    (st.kind == SK_ASSIGN || st.kind == SK_CALL || st.kind == SK_INTRINSIC) && st.a == l
        && proj_within(st.b, p, pbody)
}

// From statement s + 1 of block b: the first statement that reads place
// (l, p) before it is made again, or -1.
fn use_after(b: i64, s: i64, l: i64, p: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    pcx.seen.clear();
    pcx.work.clear();
    for _ in 0..block_count(pbody) {
        pcx.seen.push(0);
    }
    let end = block_start(b, pbody) + block_len(b, pbody);
    for t in s + 1..end {
        let st = pbody.stmts[t];
        if reads(st, l, p, pbody, pcx) {
            return t;
        }
        if remakes(st, l, p, pbody) {
            return -1;
        }
    }
    let term = pbody.stmts[end];
    if reads(term, l, p, pbody, pcx) {
        return end;
    }
    for i in 0..succ_count(b, pbody) {
        pcx.work.push(succ(b, i, pbody));
    }
    while pcx.work.len() > 0 {
        let c = pcx.work.pop().unwrap();
        if c < 0 || pcx.seen[c] != 0 || block_start(c, pbody) < 0 || !reached(c, pbody, pcx) {
            continue;
        }
        pcx.seen[c] = 1;
        let start = block_start(c, pbody);
        var made = false;
        for t in start..start + block_len(c, pbody) + 1 {
            let st = pbody.stmts[t];
            if reads(st, l, p, pbody, pcx) {
                return t;
            }
            if remakes(st, l, p, pbody) {
                made = true;
                break;
            }
        }
        if !made {
            for i in 0..succ_count(c, pbody) {
                pcx.work.push(succ(c, i, pbody));
            }
        }
    }
    -1
}

// Whether flag f is written on every path from the entry to statement s
// of block b.
fn flag_written(f: i64, b: i64, s: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> bool {
    pcx.seen.clear();
    pcx.work.clear();
    for _ in 0..block_count(pbody) {
        pcx.seen.push(0);
    }
    pcx.work.push(0);
    while pcx.work.len() > 0 {
        let c = pcx.work.pop().unwrap();
        if c < 0 || pcx.seen[c] != 0 || block_start(c, pbody) < 0 {
            continue;
        }
        pcx.seen[c] = 1;
        let start = block_start(c, pbody);
        var written = false;
        for t in start..start + block_len(c, pbody) {
            if c == b && t == s {
                return false;
            }
            let st = pbody.stmts[t];
            if st.kind == SK_ASSIGN && st.a == f && st.b == 0 {
                written = true;
                break;
            }
        }
        if !written {
            for i in 0..succ_count(c, pbody) {
                pcx.work.push(succ(c, i, pbody));
            }
        }
    }
    true
}

// Whether some statement sets flag f true.
fn flag_ever_set(f: i64, pbody: Body<Comp>) -> bool {
    for s in 0..pbody.stmts.len() {
        let st = pbody.stmts[s];
        if st.kind == SK_ASSIGN && st.a == f && st.b == 0 && st.nops == 1
            && (op_kind(st.ops, 0, pbody) != OK_INT || op_a(st.ops, 0, pbody) != 0) {
            return true;
        }
    }
    false
}

// The body held: its drops' places and flags checked.
fn check_drops(pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    find_aliases(pbody, &pcx);
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 || !reached(b, pbody, pcx) {
            continue;
        }
        for s in start..start + block_len(b, pbody) {
            let st = pbody.stmts[s];
            if st.kind != SK_DROP || st.c != DS_KEPT && st.c != DS_FLAG {
                continue;
            }
            pcx.compared += 1;
            let u = use_after(b, s, st.a, st.b, pbody, &pcx);
            if u >= 0 {
                place_line(st.a, pbody.stmts[u].node, c"used after its drop", pbody, &pcx);
            }
            if st.c == DS_FLAG && st.d >= 0
                && (!flag_written(st.d, b, s, pbody, &pcx) || !flag_ever_set(st.d, pbody)) {
                place_line(st.a, st.node, c"under a flag never set", pbody, &pcx);
            }
        }
    }
}

// `places.diff: FN: FILE:LINE:COL: 'NAME' WHAT`, for IR local l.
fn place_line(l: i64, node: i64, what: *u8, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    pcx.diffs += 1;
    let out = buf_new();
    buf_str(out, c"places.diff: ");
    buf_fn_name(out, pbody.fn_, pcx);
    buf_str(out, c": ");
    if node > 0 {
        buf_pos(out, pcx.nodes[node].start, &pcx);
        buf_str(out, c": ");
    }
    buf_str(out, c"'");
    let a = pbody.locals[l].src;
    let name = if a >= 0 { ast_local_name(a, pcx) } else { 0 };
    if name > 0 {
        buf_bytes(out, sym_text(name, pcx));
    } else {
        buf_str(out, c"_");
        buf_int(out, l);
    }
    buf_str(out, c"' ");
    buf_str(out, what);
    buf_str(out, c"\n");
    buf_write_fd(out, STDERR);
}
