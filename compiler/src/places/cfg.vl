// The control-flow graph of the body held (places/ir.vl): predecessors,
// a reverse postorder from bb0, and the immediate dominators, computed on
// demand by the verifier and by elaboration. Blocks never entered (start
// -1) are not in the graph.

use crate::base::comp::Comp;
use crate::places::ir::{Body, block_count, block_start, succ, succ_count};

// Whether block b is part of the graph (it was entered).
pub fn in_graph(b: i64, pbody: &Body<Comp>) -> bool {
    b >= 0 && b < block_count(pbody) && block_start(b, pbody) >= 0
}

pub fn compute_preds(pbody: &mut Body<Comp>) {
    let n = block_count(pbody);
    pbody.cfg_count.clear();
    for _ in 0..n + 1 {
        pbody.cfg_count.push(0);
    }
    for b in 0..n {
        if !in_graph(b, pbody) {
            continue;
        }
        for i in 0..succ_count(b, pbody) {
            let s = succ(b, i, pbody);
            if in_graph(s, pbody) {
                pbody.cfg_count[(s + 1) as usize] += 1;
            }
        }
    }
    pbody.pred_at.clear();
    let mut total: i64 = 0;
    for b in 0..n + 1 {
        total += pbody.cfg_count[b as usize];
        pbody.pred_at.push(total);
    }
    pbody.preds.clear();
    for _ in 0..total {
        pbody.preds.push(0);
    }
    // (COUNT[b] becomes the next free slot of b's list)
    for b in 0..n {
        pbody.cfg_count[b as usize] = pbody.pred_at[b as usize];
    }
    for b in 0..n {
        if !in_graph(b, pbody) {
            continue;
        }
        for i in 0..succ_count(b, pbody) {
            let s = succ(b, i, pbody);
            if in_graph(s, pbody) {
                { let at_ix = pbody.cfg_count[s as usize] as usize; pbody.preds[at_ix] = b };
                pbody.cfg_count[s as usize] += 1;
            }
        }
    }
}

pub fn pred_count(b: i64, pbody: &Body<Comp>) -> i64 {
    pbody.pred_at[(b + 1) as usize] - pbody.pred_at[b as usize]
}

pub fn pred(b: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    pbody.preds[(pbody.pred_at[b as usize] + i) as usize]
}

// The reverse postorder from bb0 (iterative depth-first search).
pub fn compute_rpo(pbody: &mut Body<Comp>) {
    let n = block_count(pbody);
    pbody.rpo.clear();
    pbody.rpo_index.clear();
    pbody.cfg_next.clear();
    for _ in 0..n {
        pbody.rpo_index.push(-1);
        pbody.cfg_next.push(0);
    }
    if n == 0 || !in_graph(0, pbody) {
        return;
    }
    // (postorder into RPO, reversed at the end; NEXT[b]: b's next
    // successor to visit, -2 once b is done; RPO_INDEX marks visited)
    pbody.cfg_stack.clear();
    pbody.cfg_stack.push(0);
    pbody.rpo_index[0] = 0;
    while pbody.cfg_stack.len() > 0 {
        let b = pbody.cfg_stack[(pbody.cfg_stack.len() as i64 - 1) as usize];
        let i = pbody.cfg_next[b as usize];
        if i < succ_count(b, pbody) {
            pbody.cfg_next[b as usize] = i + 1;
            let s = succ(b, i, pbody);
            if in_graph(s, pbody) && pbody.rpo_index[s as usize] < 0 {
                pbody.rpo_index[s as usize] = 0;
                pbody.cfg_stack.push(s);
            }
            continue;
        }
        pbody.cfg_stack.truncate(pbody.cfg_stack.len() - 1);
        pbody.rpo.push(b);
    }
    let m = pbody.rpo.len() as i64;
    for i in 0..m / 2 {
        let t = pbody.rpo[i as usize];
        pbody.rpo[i as usize] = pbody.rpo[(m - 1 - i) as usize];
        pbody.rpo[(m - 1 - i) as usize] = t;
    }
    for i in 0..m {
        { let at_ix = pbody.rpo[i as usize] as usize; pbody.rpo_index[at_ix] = i };
    }
}

// The immediate dominators (Cooper, Harvey and Kennedy's iteration over
// the reverse postorder); compute_preds and compute_rpo first.
pub fn compute_idom(pbody: &mut Body<Comp>) {
    let n = block_count(pbody);
    pbody.idom.clear();
    for _ in 0..n {
        pbody.idom.push(-1);
    }
    if pbody.rpo.len() == 0 {
        return;
    }
    { let at_ix = pbody.rpo[0] as usize; pbody.idom[at_ix] = pbody.rpo[0] };
    let mut changed = true;
    while changed {
        changed = false;
        for k in 1..pbody.rpo.len() {
            let b = pbody.rpo[k];
            let mut new_idom: i64 = -1;
            for i in 0..pred_count(b, pbody) {
                let p = pred(b, i, pbody);
                if pbody.idom[p as usize] < 0 {
                    continue;
                }
                new_idom = if new_idom < 0 { p } else { intersect(p, new_idom, pbody) };
            }
            if new_idom >= 0 && pbody.idom[b as usize] != new_idom {
                pbody.idom[b as usize] = new_idom;
                changed = true;
            }
        }
    }
}

fn intersect(a: i64, b: i64, pbody: &Body<Comp>) -> i64 {
    let mut x = a;
    let mut y = b;
    while x != y {
        while pbody.rpo_index[x as usize] > pbody.rpo_index[y as usize] {
            x = pbody.idom[x as usize];
        }
        while pbody.rpo_index[y as usize] > pbody.rpo_index[x as usize] {
            y = pbody.idom[y as usize];
        }
    }
    x
}

// Whether block a dominates block b (both reachable).
pub fn dominates(a: i64, b: i64, pbody: &Body<Comp>) -> bool {
    let mut x = b;
    while true {
        if x == a {
            return true;
        }
        let up = pbody.idom[x as usize];
        if up < 0 || up == x {
            return false;
        }
        x = up;
    }
    false
}
