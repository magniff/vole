// The control-flow graph of the body held (places/ir.vl): predecessors,
// a reverse postorder from bb0, and the immediate dominators, computed on
// demand by the verifier and by elaboration. Blocks never entered (start
// -1) are not in the graph.

use crate::base::len_arg;
use crate::base::comp::Comp;
use crate::places::ir::{block_count, block_start, succ, succ_count};

// Per block: its predecessors, PREDS[PRED_AT[b] .. PRED_AT[b + 1]].
pub static var PRED_AT: Vec<i64, Comp> = Vec::new_in(Comp {});
pub static var PREDS: Vec<i64, Comp> = Vec::new_in(Comp {});
// The blocks reachable from bb0 in reverse postorder, and each block's
// index in it (-1: unreachable).
pub static var RPO: Vec<i64, Comp> = Vec::new_in(Comp {});
pub static var RPO_INDEX: Vec<i64, Comp> = Vec::new_in(Comp {});
// The immediate dominator of each reachable block (bb0's is itself; -1
// for the unreachable ones).
pub static var IDOM: Vec<i64, Comp> = Vec::new_in(Comp {});

static var STACK: Vec<i64, Comp> = Vec::new_in(Comp {});
static var NEXT: Vec<i64, Comp> = Vec::new_in(Comp {});
static var COUNT: Vec<i64, Comp> = Vec::new_in(Comp {});

// Whether block b is part of the graph (it was entered).
pub fn in_graph(b: i64) -> bool {
    b >= 0 && b < block_count() && block_start(b) >= 0
}

pub fn compute_preds() {
    let n = block_count();
    COUNT.clear();
    for _ in 0..n + 1 {
        COUNT.push(0);
    }
    for b in 0..n {
        if !in_graph(b) {
            continue;
        }
        for i in 0..succ_count(b) {
            let s = succ(b, i);
            if in_graph(s) {
                COUNT[s + 1] += 1;
            }
        }
    }
    PRED_AT.clear();
    var total = 0;
    for b in 0..n + 1 {
        total += COUNT[b];
        PRED_AT.push(total);
    }
    PREDS.clear();
    for _ in 0..total {
        PREDS.push(0);
    }
    // (COUNT[b] becomes the next free slot of b's list)
    for b in 0..n {
        COUNT[b] = PRED_AT[b];
    }
    for b in 0..n {
        if !in_graph(b) {
            continue;
        }
        for i in 0..succ_count(b) {
            let s = succ(b, i);
            if in_graph(s) {
                PREDS[COUNT[s]] = b;
                COUNT[s] += 1;
            }
        }
    }
}

pub fn pred_count(b: i64) -> i64 {
    PRED_AT[b + 1] - PRED_AT[b]
}

pub fn pred(b: i64, i: i64) -> i64 {
    PREDS[PRED_AT[b] + i]
}

// The reverse postorder from bb0 (iterative depth-first search).
pub fn compute_rpo() {
    let n = block_count();
    RPO.clear();
    RPO_INDEX.clear();
    NEXT.clear();
    for _ in 0..n {
        RPO_INDEX.push(-1);
        NEXT.push(0);
    }
    if n == 0 || !in_graph(0) {
        return;
    }
    // (postorder into RPO, reversed at the end; NEXT[b]: b's next
    // successor to visit, -2 once b is done; RPO_INDEX marks visited)
    STACK.clear();
    STACK.push(0);
    RPO_INDEX[0] = 0;
    while STACK.len() as i64 > 0 {
        let b = STACK[STACK.len() as i64 - 1];
        let i = NEXT[b];
        if i < succ_count(b) {
            NEXT[b] = i + 1;
            let s = succ(b, i);
            if in_graph(s) && RPO_INDEX[s] < 0 {
                RPO_INDEX[s] = 0;
                STACK.push(s);
            }
            continue;
        }
        STACK.truncate(len_arg(STACK.len() as i64 - 1));
        RPO.push(b);
    }
    let m = RPO.len() as i64;
    for i in 0..m / 2 {
        let t = RPO[i];
        RPO[i] = RPO[m - 1 - i];
        RPO[m - 1 - i] = t;
    }
    for i in 0..m {
        RPO_INDEX[RPO[i]] = i;
    }
}

// The immediate dominators (Cooper, Harvey and Kennedy's iteration over
// the reverse postorder); compute_preds and compute_rpo first.
pub fn compute_idom() {
    let n = block_count();
    IDOM.clear();
    for _ in 0..n {
        IDOM.push(-1);
    }
    if RPO.len() as i64 == 0 {
        return;
    }
    IDOM[RPO[0]] = RPO[0];
    var changed = true;
    while changed {
        changed = false;
        for k in 1..RPO.len() as i64 {
            let b = RPO[k];
            var new_idom = -1;
            for i in 0..pred_count(b) {
                let p = pred(b, i);
                if IDOM[p] < 0 {
                    continue;
                }
                new_idom = if new_idom < 0 { p } else { intersect(p, new_idom) };
            }
            if new_idom >= 0 && IDOM[b] != new_idom {
                IDOM[b] = new_idom;
                changed = true;
            }
        }
    }
}

fn intersect(a: i64, b: i64) -> i64 {
    var x = a;
    var y = b;
    while x != y {
        while RPO_INDEX[x] > RPO_INDEX[y] {
            x = IDOM[x];
        }
        while RPO_INDEX[y] > RPO_INDEX[x] {
            y = IDOM[y];
        }
    }
    x
}

// Whether block a dominates block b (both reachable).
pub fn dominates(a: i64, b: i64) -> bool {
    var x = b;
    while true {
        if x == a {
            return true;
        }
        let up = IDOM[x];
        if up < 0 || up == x {
            return false;
        }
        x = up;
    }
    false
}
