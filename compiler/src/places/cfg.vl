// The control-flow graph of the body held (places/ir.vl): predecessors,
// a reverse postorder from bb0, and the immediate dominators, computed on
// demand by the verifier and by elaboration. Blocks never entered (start
// -1) are not in the graph.

use crate::base::comp::Comp;
use crate::places::ir::{Body, block_count, block_start, succ, succ_count};

// Whether block b is part of the graph (it was entered).
pub fn in_graph(b: i64, pbody: Body<Comp>) -> bool {
    b >= 0 && b < block_count(pbody) && block_start(b, pbody) >= 0
}

pub fn compute_preds(pbody: inout Body<Comp>) {
    let n = block_count(pbody);
    pbody.cfg_count.clear();
    for _ in 0..n + 1 {
        pbody.cfg_count.push(0);
    }
    for b in 0..n {
        if !in_graph(b, pbody) {
            continue;
        }
        for i in 0..succ_count(b, pbody) {
            let s = succ(b, i, pbody);
            if in_graph(s, pbody) {
                pbody.cfg_count[s + 1] += 1;
            }
        }
    }
    pbody.pred_at.clear();
    var total = 0;
    for b in 0..n + 1 {
        total += pbody.cfg_count[b];
        pbody.pred_at.push(total);
    }
    pbody.preds.clear();
    for _ in 0..total {
        pbody.preds.push(0);
    }
    // (COUNT[b] becomes the next free slot of b's list)
    for b in 0..n {
        pbody.cfg_count[b] = pbody.pred_at[b];
    }
    for b in 0..n {
        if !in_graph(b, pbody) {
            continue;
        }
        for i in 0..succ_count(b, pbody) {
            let s = succ(b, i, pbody);
            if in_graph(s, pbody) {
                pbody.preds[pbody.cfg_count[s]] = b;
                pbody.cfg_count[s] += 1;
            }
        }
    }
}

pub fn pred_count(b: i64, pbody: Body<Comp>) -> i64 {
    pbody.pred_at[b + 1] - pbody.pred_at[b]
}

pub fn pred(b: i64, i: i64, pbody: Body<Comp>) -> i64 {
    pbody.preds[pbody.pred_at[b] + i]
}

// The reverse postorder from bb0 (iterative depth-first search).
pub fn compute_rpo(pbody: inout Body<Comp>) {
    let n = block_count(pbody);
    pbody.rpo.clear();
    pbody.rpo_index.clear();
    pbody.cfg_next.clear();
    for _ in 0..n {
        pbody.rpo_index.push(-1);
        pbody.cfg_next.push(0);
    }
    if n == 0 || !in_graph(0, pbody) {
        return;
    }
    // (postorder into RPO, reversed at the end; NEXT[b]: b's next
    // successor to visit, -2 once b is done; RPO_INDEX marks visited)
    pbody.cfg_stack.clear();
    pbody.cfg_stack.push(0);
    pbody.rpo_index[0] = 0;
    while pbody.cfg_stack.len() > 0 {
        let b = pbody.cfg_stack[pbody.cfg_stack.len() as i64 - 1];
        let i = pbody.cfg_next[b];
        if i < succ_count(b, pbody) {
            pbody.cfg_next[b] = i + 1;
            let s = succ(b, i, pbody);
            if in_graph(s, pbody) && pbody.rpo_index[s] < 0 {
                pbody.rpo_index[s] = 0;
                pbody.cfg_stack.push(s);
            }
            continue;
        }
        pbody.cfg_stack.truncate(pbody.cfg_stack.len() - 1);
        pbody.rpo.push(b);
    }
    let m = pbody.rpo.len() as i64;
    for i in 0..m / 2 {
        let t = pbody.rpo[i];
        pbody.rpo[i] = pbody.rpo[m - 1 - i];
        pbody.rpo[m - 1 - i] = t;
    }
    for i in 0..m {
        pbody.rpo_index[pbody.rpo[i]] = i;
    }
}

// The immediate dominators (Cooper, Harvey and Kennedy's iteration over
// the reverse postorder); compute_preds and compute_rpo first.
pub fn compute_idom(pbody: inout Body<Comp>) {
    let n = block_count(pbody);
    pbody.idom.clear();
    for _ in 0..n {
        pbody.idom.push(-1);
    }
    if pbody.rpo.len() == 0 {
        return;
    }
    pbody.idom[pbody.rpo[0]] = pbody.rpo[0];
    var changed = true;
    while changed {
        changed = false;
        for k in 1..pbody.rpo.len() {
            let b = pbody.rpo[k];
            var new_idom = -1;
            for i in 0..pred_count(b, pbody) {
                let p = pred(b, i, pbody);
                if pbody.idom[p] < 0 {
                    continue;
                }
                new_idom = if new_idom < 0 { p } else { intersect(p, new_idom, pbody) };
            }
            if new_idom >= 0 && pbody.idom[b] != new_idom {
                pbody.idom[b] = new_idom;
                changed = true;
            }
        }
    }
}

fn intersect(a: i64, b: i64, pbody: Body<Comp>) -> i64 {
    var x = a;
    var y = b;
    while x != y {
        while pbody.rpo_index[x] > pbody.rpo_index[y] {
            x = pbody.idom[x];
        }
        while pbody.rpo_index[y] > pbody.rpo_index[x] {
            y = pbody.idom[y];
        }
    }
    x
}

// Whether block a dominates block b (both reachable).
pub fn dominates(a: i64, b: i64, pbody: Body<Comp>) -> bool {
    var x = b;
    while true {
        if x == a {
            return true;
        }
        let up = pbody.idom[x];
        if up < 0 || up == x {
            return false;
        }
        x = up;
    }
    false
}
