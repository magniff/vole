// Drop elaboration (0.26.0, docs/design/places-ir.md §3.8): each
// `drop(P)` the builder placed, decided from the body's moves.
//
// 1. Move paths: a tree per local of the places moved or dropped (and,
//    once a place has a moved part, all its parts that need drop), with a
//    child per field and per variant payload. A place reached through `*`
//    or an index, a static's, a BORROWED local's has none, and so has a
//    part of a value whose type has a Drop impl (dropped only whole).
// 2. Two forward dataflows over them, maybe-initialized and
//    maybe-uninitialized, one bit per path, iterated over the reverse
//    postorder to a fixed point: an assignment initializes its place's
//    path and the paths under it; a move, a drop and the storage's end
//    uninitialize them.
// 3. Each drop: removed (uninitialized on every path), kept (initialized
//    on every path, no part moved), under a flag (initialized on some
//    paths), or open (some part moved: the parts dropped apart, an enum's
//    by a switch on its discriminant). A drop of a place with no path is
//    kept as written.
// 4. The flags: a bool local per path that needs one, false at entry,
//    true after each initialization, false after each move.
//
// The body is then written again (its blocks in place, an open enum's
// switch splitting its block): the flags' writes after the statements
// that change them, and an open drop followed by its parts' drops.
// DS_FLAG drops stay one statement, `drop(P) [flag _f]`; the code
// generators (0.26.1) branch on the flag.
//
// The fast path: a body with no drop is left as it is.

use crate::base::len_arg;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_BOOL, TyKind, type_elem};
use crate::places::cfg::{compute_preds, compute_rpo, pred, pred_count};
use crate::places::front::{
    enum_tag_ty, enum_variant_count, enum_variants, type_glue, variant_discr,
};
use crate::places::ir::{
    Body, DS_FLAG, DS_KEPT, DS_OPEN, DS_REMOVED, DS_UNDECIDED, LF_BORROWED, LF_FLAG, LF_PARAM,
    LF_STATIC, LF_TEMP, OK_COPY, OK_INT, OK_MOVE, OK_PLACE, PJ_CONST, PJ_FIELD, PJ_VARIANT, PStmt,
    RV_DISCR, RV_USE, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC, SK_LIVE, TK_GOTO,
    TK_SWITCH, block_count, block_len, block_start, emit, enter_block, full_place_type, has_flag,
    is_terminator, local_count, new_block, new_local, op_a, op_b, op_kind, proj, proj_kind,
    proj_parent, proj_val, push_op, struct_field_count, struct_field_ty, undistinct,
    variant_field_count, variant_part_type,
};

// ---- Move paths ----

fn path_count(pcx: Ctx<Comp>) -> i64 {
    pcx.mp_local.len() as i64
}

// Whether local l can have move paths: not a static's, a borrowed copy, a
// flag.
fn trackable(l: i64, pbody: Body<Comp>) -> bool {
    !has_flag(l, LF_STATIC, pbody) && !has_flag(l, LF_BORROWED, pbody)
        && !has_flag(l, LF_FLAG, pbody)
}

// The path of place (l, p), made when `make` (and every path above it);
// -1 when the place has none (a projection through `*`, an index, a
// union's field, a part of a value dropped only whole: whole_only).
fn path_of(l: i64, p: i64, make: bool, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    if p == 0 {
        if l < 0 || l >= pcx.local_path.len() as i64 || !trackable(l, pbody) {
            return -1;
        }
        if pcx.local_path[l] < 0 && make {
            pcx.local_path[l] = new_path(l, 0, -1, &pcx);
        }
        return pcx.local_path[l];
    }
    let k = proj_kind(p, pbody);
    if k != PJ_FIELD && k != PJ_VARIANT && k != PJ_CONST {
        return -1;
    }
    let parent = path_of(l, proj_parent(p, pbody), make, pbody, &pcx);
    if parent < 0 {
        return -1;
    }
    var c = pcx.mp_first[parent];
    while c >= 0 {
        if pcx.mp_proj[c] == p {
            return c;
        }
        c = pcx.mp_next[c];
    }
    if !make || whole_only(l, proj_parent(p, pbody), pbody, &pcx) {
        return -1;
    }
    new_path(l, p, parent, &pcx)
}

// Whether place (l, p) is dropped only whole: its type has a Drop impl,
// whose drop needs all of it (no part of it moves: own.partial). Its
// parts have no paths: a part's drop (an assignment's old value) is
// decided by the whole's state (decide_all: ancestor_path), and a part's
// write leaves the whole as it was. With paths of its own, a part
// written on one branch and the whole moved on another made the whole's
// drop open: its fields dropped, never its `drop` (0.26.1, fuzz-sem seed
// 89).
fn whole_only(l: i64, p: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> bool {
    let t = full_place_type(l, p, pbody, &pcx);
    crate::front::own::kinds::has_drop_impl(t, &pcx)
        || crate::front::own::kinds::has_drop_impl(undistinct(t, pcx), &pcx)
}

fn new_path(l: i64, p: i64, parent: i64, pcx: inout Ctx<Comp>) -> i64 {
    let q = pcx.mp_local.len() as i64;
    pcx.mp_local.push(l);
    pcx.mp_proj.push(p);
    pcx.mp_parent.push(parent);
    pcx.mp_first.push(-1);
    pcx.mp_next.push(-1);
    pcx.mp_flag.push(-1);
    if parent >= 0 {
        pcx.mp_next[q] = pcx.mp_first[parent];
        pcx.mp_first[parent] = q;
    }
    q
}

// The nearest path at or above place (l, p) when the place itself has
// none but its projections are all fields and variants (-1: none).
fn ancestor_path(l: i64, p: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    var q = p;
    while q > 0 {
        let k = proj_kind(q, pbody);
        if k != PJ_FIELD && k != PJ_VARIANT && k != PJ_CONST {
            return -1;
        }
        q = proj_parent(q, pbody);
    }
    var at = p;
    while true {
        let mp = path_of(l, at, false, pbody, &pcx);
        if mp >= 0 || at == 0 {
            return mp;
        }
        at = proj_parent(at, pbody);
    }
    -1
}

// The paths: every place moved or dropped; then, under a path with a
// child, every part that needs drop.
fn collect_paths(pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    pcx.mp_local.clear();
    pcx.mp_proj.clear();
    pcx.mp_parent.clear();
    pcx.mp_first.clear();
    pcx.mp_next.clear();
    pcx.mp_flag.clear();
    pcx.local_path.clear();
    for _ in 0..local_count(pbody) {
        pcx.local_path.push(-1);
    }
    for s in 0..pbody.stmts.len() {
        let st = pbody.stmts[s];
        if st.kind == SK_DROP {
            path_of(st.a, st.b, true, pbody, &pcx);
        }
        if is_terminator(st.kind) {
            continue;
        }
        for i in 0..st.nops {
            if op_kind(st.ops, i, pbody) == OK_MOVE {
                path_of(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), true, pbody, &pcx);
            }
        }
    }
    // (the parts of a place with a moved part: each is decided apart)
    var q = 0;
    let made = path_count(pcx);
    while q < made {
        if pcx.mp_first[q] >= 0 && proj_kind_of(q, pbody, pcx) != PJ_VARIANT {
            complete_parts(q, &pbody, &pcx);
        }
        q += 1;
    }
}

fn proj_kind_of(q: i64, pbody: Body<Comp>, pcx: Ctx<Comp>) -> i64 {
    if pcx.mp_proj[q] == 0 { 0 } else { proj_kind(pcx.mp_proj[q], pbody) }
}

// The paths of path q's parts that need drop: a struct's or a tuple's
// fields; an enum's, the fields of each variant one of its paths is of.
fn complete_parts(q: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let l = pcx.mp_local[q];
    let p = pcx.mp_proj[q];
    let t = undistinct(full_place_type(l, p, pbody, &pcx), pcx);
    if t <= 0 {
        return;
    }
    let tk = pcx.types[t].kind;
    if tk == TyKind::Struct {
        let s = pcx.types[t].a;
        for k in 0..struct_field_count(s, pcx) {
            if type_glue(struct_field_ty(s, k, pcx), &pcx) {
                path_of(l, proj(p, PJ_FIELD, k, &pbody), true, pbody, &pcx);
            }
        }
    } else if tk == TyKind::Tuple {
        for k in 0..pcx.types[t].count {
            if type_glue(type_elem(t, k, pcx), &pcx) {
                path_of(l, proj(p, PJ_FIELD, k, &pbody), true, pbody, &pcx);
            }
        }
    } else if tk == TyKind::Array {
        // (an element moved by a constant index, `a[1]`: each element)
        if type_glue(pcx.types[t].a, &pcx) {
            for k in 0..pcx.types[t].b {
                path_of(l, proj(p, PJ_CONST, k, &pbody), true, pbody, &pcx);
            }
        }
    } else if tk == TyKind::Enum {
        var c = pcx.mp_first[q];
        while c >= 0 {
            if proj_kind_of(c, pbody, pcx) == PJ_VARIANT {
                let v = proj_val(pcx.mp_proj[c], pbody);
                for k in 0..variant_field_count(v, pcx) {
                    if type_glue(variant_part_type(v, k, pcx), &pcx) {
                        path_of(l, proj(pcx.mp_proj[c], PJ_FIELD, k, &pbody), true, pbody, &pcx);
                    }
                }
            }
            c = pcx.mp_next[c];
        }
    }
}

// ---- Sets ----

fn bit_get(set: i64, q: i64, pcx: Ctx<Comp>) -> bool {
    (pcx.cur[set * pcx.nw + q / 64] & (1 << (q % 64))) != 0
}

fn bit_put(set: i64, q: i64, on: bool, pcx: inout Ctx<Comp>) {
    let w = set * pcx.nw + q / 64;
    if on {
        pcx.cur[w] = pcx.cur[w] | (1 << (q % 64));
    } else {
        pcx.cur[w] = pcx.cur[w] & ~(1 << (q % 64));
    }
}

// Path q and the paths under it initialized (init) or not.
fn set_tree(q: i64, init: bool, pcx: inout Ctx<Comp>) {
    bit_put(0, q, init, &pcx);
    bit_put(1, q, !init, &pcx);
    bit_put(2, q, init, &pcx);
    var c = pcx.mp_first[q];
    while c >= 0 {
        set_tree(c, init, &pcx);
        c = pcx.mp_next[c];
    }
}

// What statement st does to the sets.
fn transfer(st: PStmt, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let k = st.kind;
    if is_terminator(k) {
        return;
    }
    for i in 0..st.nops {
        if op_kind(st.ops, i, pbody) == OK_MOVE {
            let q = path_of(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), false, pbody, &pcx);
            if q >= 0 {
                set_tree(q, false, &pcx);
            }
        }
    }
    if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC {
        let q = path_of(st.a, st.b, false, pbody, &pcx);
        if q >= 0 {
            set_tree(q, true, &pcx);
        }
    } else if k == SK_DROP {
        let q = path_of(st.a, st.b, false, pbody, &pcx);
        if q >= 0 {
            set_tree(q, false, &pcx);
        }
    } else if k == SK_DEAD || k == SK_LIVE {
        if st.a >= 0 && st.a < pcx.local_path.len() as i64 && pcx.local_path[st.a] >= 0 {
            set_tree(pcx.local_path[st.a], false, &pcx);
        }
    }
}

// The sets at the entry of bb0: the parameters initialized.
fn entry_state(pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    for w in 0..3 * pcx.nw {
        pcx.cur[w] = 0;
    }
    for q in 0..path_count(pcx) {
        let init = pcx.mp_parent[q] < 0 && has_flag(pcx.mp_local[q], LF_PARAM, pbody)
            || pcx.mp_parent[q] >= 0 && bit_get(0, pcx.mp_parent[q], pcx);
        // (paths are made parent first: a part's parent is set already)
        bit_put(0, q, init, &pcx);
        bit_put(1, q, !init, &pcx);
        bit_put(2, q, init, &pcx);
    }
}

// The fixed point of the two dataflows: IN per block.
fn dataflow(pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let n = block_count(pbody);
    pcx.in_.clear();
    pcx.cur.clear();
    pcx.tmp.clear();
    for _ in 0..3 * pcx.nw * n {
        pcx.in_.push(0);
    }
    for _ in 0..3 * pcx.nw {
        pcx.cur.push(0);
        pcx.tmp.push(0);
    }
    if pbody.rpo.len() == 0 {
        return;
    }
    entry_state(pbody, &pcx);
    for w in 0..3 * pcx.nw {
        pcx.in_[pbody.rpo[0] * 3 * pcx.nw + w] = pcx.cur[w];
    }
    var changed = true;
    while changed {
        changed = false;
        for i in 0..pbody.rpo.len() {
            let b = pbody.rpo[i];
            // (the join: the union of the predecessors' exits, and bb0's
            // entry)
            if b != pbody.rpo[0] {
                for w in 0..3 * pcx.nw {
                    pcx.tmp[w] = 0;
                }
                for j in 0..pred_count(b, pbody) {
                    let pb = pred(b, j, pbody);
                    if pbody.rpo_index[pb] < 0 {
                        continue;
                    }
                    exit_state(pb, pbody, &pcx);
                    edge_effect(pb, b, pbody, &pcx);
                    for w in 0..3 * pcx.nw {
                        pcx.tmp[w] = pcx.tmp[w] | pcx.cur[w];
                    }
                }
                for w in 0..3 * pcx.nw {
                    if pcx.in_[b * 3 * pcx.nw + w] != pcx.tmp[w] {
                        pcx.in_[b * 3 * pcx.nw + w] = pcx.tmp[w];
                        changed = true;
                    }
                }
            }
        }
    }
}

// On the edge from block pb to b: when pb ends in a switch on `_d =
// discriminant P` (P a path with variants' paths) and b is the case of
// variant V, P is V there.
fn edge_effect(pb: i64, b: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let term = pbody.stmts[block_start(pb, pbody) + block_len(pb, pbody)];
    if term.kind != TK_SWITCH || term.nops != 1 || op_kind(term.ops, 0, pbody) != OK_COPY
        || op_b(term.ops, 0, pbody) != 0 {
        return;
    }
    let d = op_a(term.ops, 0, pbody);
    var q = -1;
    let start = block_start(pb, pbody);
    var s = start + block_len(pb, pbody) - 1;
    while s >= start {
        let st = pbody.stmts[s];
        if st.kind == SK_ASSIGN && st.a == d && st.b == 0 {
            if st.c == RV_DISCR && op_kind(st.ops, 0, pbody) == OK_PLACE {
                q = path_of(op_a(st.ops, 0, pbody), op_b(st.ops, 0, pbody), false, pbody, &pcx);
            }
            break;
        }
        s -= 1;
    }
    if q < 0 || pcx.mp_first[q] < 0 {
        return;
    }
    var value = 0;
    var found = false;
    for i in 0..term.b {
        if pbody.targets[term.a + 2 * i + 1] == b {
            value = pbody.targets[term.a + 2 * i];
            found = true;
        }
    }
    if !found {
        return;
    }
    var has_own = false;
    var c = pcx.mp_first[q];
    while c >= 0 {
        if proj_kind_of(c, pbody, pcx) == PJ_VARIANT {
            let mine = variant_discr(proj_val(pcx.mp_proj[c], pbody), pcx) == value;
            has_own = has_own || mine;
            if !mine {
                bit_put(2, c, false, &pcx);
            }
        }
        c = pcx.mp_next[c];
    }
    if has_own {
        bit_put(2, q, false, &pcx);
    }
}

// Whether enum path q may hold, for a variant with no path under q, a
// value with something to drop.
fn others_drop(q: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> bool {
    let t = undistinct(full_place_type(pcx.mp_local[q], pcx.mp_proj[q], pbody, &pcx), pcx);
    let first = enum_variants(t, pcx);
    for v in first..first + enum_variant_count(t, pcx) {
        var pathed = false;
        var c = pcx.mp_first[q];
        while c >= 0 {
            if proj_kind_of(c, pbody, pcx) == PJ_VARIANT && proj_val(pcx.mp_proj[c], pbody) == v {
                pathed = true;
            }
            c = pcx.mp_next[c];
        }
        if pathed {
            continue;
        }
        for k in 0..variant_field_count(v, pcx) {
            if type_glue(variant_part_type(v, k, pcx), &pcx) {
                return true;
            }
        }
    }
    false
}

// The decision for a drop of enum path q with variants' paths: what it may
// hold (the variants set 2 allows) live or dead.
fn decide_enum(q: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    var live = bit_get(0, q, pcx) && bit_get(2, q, pcx) && others_drop(q, pbody, &pcx);
    var dead = bit_get(1, q, pcx);
    var c = pcx.mp_first[q];
    while c >= 0 {
        if proj_kind_of(c, pbody, pcx) == PJ_VARIANT && bit_get(2, c, pcx) {
            var fc = pcx.mp_first[c];
            while fc >= 0 {
                live = live || some_in_tree(0, fc, pcx);
                dead = dead || some_in_tree(1, fc, pcx);
                fc = pcx.mp_next[fc];
            }
        }
        c = pcx.mp_next[c];
    }
    if !live {
        return DS_REMOVED;
    }
    if dead { DS_OPEN } else { DS_KEPT }
}

// CUR = the sets at the exit of block b, from IN.
fn exit_state(b: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    for w in 0..3 * pcx.nw {
        pcx.cur[w] = pcx.in_[b * 3 * pcx.nw + w];
    }
    let start = block_start(b, pbody);
    for s in start..start + block_len(b, pbody) {
        transfer(pbody.stmts[s], pbody, &pcx);
    }
}

// ---- Decisions ----

// Whether some path at or under q is maybe-initialized (set 0) or
// maybe-uninitialized (set 1).
fn some_in_tree(set: i64, q: i64, pcx: Ctx<Comp>) -> bool {
    if bit_get(set, q, pcx) {
        return true;
    }
    var c = pcx.mp_first[q];
    while c >= 0 {
        if some_in_tree(set, c, pcx) {
            return true;
        }
        c = pcx.mp_next[c];
    }
    false
}

// The flag local of path q, made once.
fn flag_of(q: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    if pcx.mp_flag[q] < 0 {
        pcx.mp_flag[q] = new_local(TY_BOOL, LF_FLAG, -1, 0, &pbody);
        pcx.flags_made += 1;
    }
    pcx.mp_flag[q]
}

// The decision for a drop of path q (or, whole, of the place whose
// nearest path is q: `whole`), from CUR.
fn decide(q: i64, whole: bool, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    if whole {
        // (only q's own bit: the place is all of it, or one of its parts
        // with no path of its own)
        if !bit_get(0, q, pcx) {
            return DS_REMOVED;
        }
        if !bit_get(1, q, pcx) {
            return DS_KEPT;
        }
        flag_of(q, &pbody, &pcx);
        return DS_FLAG;
    }
    if pcx.mp_first[q] >= 0 && !is_enum_path(q, pbody, &pcx) {
        // (a struct or a tuple with parts of its own: complete_parts made
        // one per part that needs drop, so they are all of what it drops)
        var live = false;
        var dead = !bit_get(0, q, pcx);
        var c = pcx.mp_first[q];
        while c >= 0 {
            live = live || some_in_tree(0, c, pcx);
            dead = dead || some_in_tree(1, c, pcx);
            c = pcx.mp_next[c];
        }
        if !live {
            return DS_REMOVED;
        }
        return if dead { DS_OPEN } else { DS_KEPT };
    }
    if pcx.mp_first[q] >= 0 {
        return decide_enum(q, pbody, &pcx);
    }
    if !some_in_tree(0, q, pcx) {
        return DS_REMOVED;
    }
    if !some_in_tree(1, q, pcx) {
        return DS_KEPT;
    }
    if pcx.mp_first[q] < 0 {
        flag_of(q, &pbody, &pcx);
        return DS_FLAG;
    }
    DS_OPEN
}

// Whether path q is of an enum (its children: its variants' payloads).
fn is_enum_path(q: i64, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> bool {
    let t = undistinct(full_place_type(pcx.mp_local[q], pcx.mp_proj[q], pbody, &pcx), pcx);
    t > 0 && pcx.types[t].kind == TyKind::Enum
}

// Each drop decided, in block order from its entry state; the state at
// an open drop kept for the rewrite.
fn decide_all(pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    pcx.snap_at.clear();
    pcx.snaps.clear();
    for _ in 0..pbody.stmts.len() as i64 {
        pcx.snap_at.push(-1);
    }
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 {
            continue;
        }
        let reached = pbody.rpo_index[b] >= 0;
        if reached {
            for w in 0..3 * pcx.nw {
                pcx.cur[w] = pcx.in_[b * 3 * pcx.nw + w];
            }
        }
        for s in start..start + block_len(b, pbody) {
            let st = pbody.stmts[s];
            if st.kind == SK_DROP && st.c == DS_UNDECIDED {
                var ds = DS_KEPT;
                var flag = -1;
                if !reached {
                    ds = DS_REMOVED;
                } else {
                    let q = path_of(st.a, st.b, false, pbody, &pcx);
                    if q >= 0 {
                        ds = decide(q, false, &pbody, &pcx);
                        if ds == DS_FLAG {
                            flag = pcx.mp_flag[q];
                        } else if ds == DS_OPEN {
                            pcx.snap_at[s] = pcx.snaps.len() as i64;
                            for w in 0..3 * pcx.nw {
                                pcx.snaps.push(pcx.cur[w]);
                            }
                            // (the flags its parts' drops will read, made
                            // now: the rewrite writes a flag only once
                            // it exists, R6)
                            open_flags(st.a, st.b, q, &pbody, &pcx);
                        }
                    } else if trackable(st.a, pbody) {
                        let anc = ancestor_path(st.a, st.b, pbody, &pcx);
                        if anc >= 0 {
                            ds = decide(anc, true, &pbody, &pcx);
                            if ds == DS_FLAG {
                                flag = pcx.mp_flag[anc];
                            }
                        }
                    }
                }
                pbody.stmts[s].c = ds;
                pcx.runs_drops = pcx.runs_drops || ds != DS_REMOVED;
                pbody.stmts[s].d = flag;
            }
            if reached {
                transfer(pbody.stmts[s], pbody, &pcx);
            }
        }
    }
}

// ---- The rewrite ----

// The flags' writes after statement st (the old one): for each flagged
// path its effects set, the value it leaves.
fn flag_writes(st: PStmt, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let k = st.kind;
    if is_terminator(k) {
        return;
    }
    for i in 0..st.nops {
        if op_kind(st.ops, i, pbody) == OK_MOVE {
            let q = path_of(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), false, pbody, &pcx);
            if q >= 0 {
                write_flags(q, false, &pbody, pcx);
            }
        }
    }
    if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC {
        let q = path_of(st.a, st.b, false, pbody, &pcx);
        if q >= 0 {
            write_flags(q, true, &pbody, pcx);
        }
    } else if k == SK_DROP {
        let q = path_of(st.a, st.b, false, pbody, &pcx);
        if q >= 0 {
            write_flags(q, false, &pbody, pcx);
        }
    } else if k == SK_DEAD {
        if st.a >= 0 && st.a < pcx.local_path.len() as i64 && pcx.local_path[st.a] >= 0 {
            write_flags(pcx.local_path[st.a], false, &pbody, pcx);
        }
    }
}

fn write_flags(q: i64, value: bool, pbody: inout Body<Comp>, pcx: Ctx<Comp>) {
    if pcx.mp_flag[q] >= 0 {
        set_flag(pcx.mp_flag[q], value, &pbody);
    }
    var c = pcx.mp_first[q];
    while c >= 0 {
        write_flags(c, value, &pbody, pcx);
        c = pcx.mp_next[c];
    }
}

fn set_flag(f: i64, value: bool, pbody: inout Body<Comp>) {
    let at = pbody.ops.len() as i64;
    push_op(OK_INT, if value { 1 } else { 0 }, TY_BOOL, &pbody);
    emit(SK_ASSIGN, f, 0, RV_USE, 0, 0, at, 1, 0, &pbody);
}

// The body written again: each block in place, the flags' writes after
// the statements that change them, each open drop followed by its parts'.
fn rewrite(pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    pcx.old.clear();
    for s in 0..pbody.stmts.len() {
        pcx.old.push(pbody.stmts[s]);
    }
    let n = block_count(pbody);
    // (the blocks' old ranges: entering a block resets its start)
    let base = pcx.tmp.len() as i64;
    for b in 0..n {
        pcx.tmp.push(block_start(b, pbody));
        pcx.tmp.push(block_len(b, pbody));
    }
    pbody.stmts.clear();
    for b in 0..n {
        let start = pcx.tmp[base + 2 * b];
        if start < 0 {
            continue;
        }
        let len = pcx.tmp[base + 2 * b + 1];
        enter_block(b, &pbody);
        if b == 0 {
            for q in 0..path_count(pcx) {
                if pcx.mp_flag[q] >= 0 {
                    // (a parameter's flag starts true)
                    let init = has_flag(pcx.mp_local[q], LF_PARAM, pbody);
                    set_flag(pcx.mp_flag[q], init, &pbody);
                }
            }
        }
        for s in start..start + len {
            let st = pcx.old[s];
            pbody.stmts.push(st);
            if st.kind == SK_DROP && st.c == DS_OPEN && pcx.snap_at[s] >= 0 {
                for w in 0..3 * pcx.nw {
                    pcx.cur[w] = pcx.snaps[pcx.snap_at[s] + w];
                }
                let q = path_of(st.a, st.b, false, pbody, &pcx);
                open_parts(st.a, st.b, q, st.node, &pbody, &pcx);
            }
            if pcx.flags_made > 0 {
                flag_writes(st, &pbody, &pcx);
            }
        }
        // (its terminator, as it was)
        crate::places::ir::close_block(&pbody);
        pbody.stmts.push(pcx.old[start + len]);
        pbody.cur_block = -1;
    }
    pcx.tmp.truncate(len_arg(base));
}

// The drops of the parts of place (l, p), path q, some of which moved: a
// struct's or a tuple's fields that need drop, each decided; an enum's by
// a switch on its discriminant, a variant with moved parts its fields
// decided, any other variant the whole value (q's own state).
fn open_parts(l: i64, p: i64, q: i64, node: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let t = undistinct(full_place_type(l, p, pbody, &pcx), pcx);
    if t <= 0 {
        return;
    }
    let tk = pcx.types[t].kind;
    if tk == TyKind::Struct {
        let s = pcx.types[t].a;
        for k in 0..struct_field_count(s, pcx) {
            if type_glue(struct_field_ty(s, k, pcx), &pcx) {
                drop_part(l, proj(p, PJ_FIELD, k, &pbody), node, &pbody, &pcx);
            }
        }
        return;
    }
    if tk == TyKind::Tuple {
        for k in 0..pcx.types[t].count {
            if type_glue(type_elem(t, k, pcx), &pcx) {
                drop_part(l, proj(p, PJ_FIELD, k, &pbody), node, &pbody, &pcx);
            }
        }
        return;
    }
    if tk == TyKind::Array {
        for k in 0..pcx.types[t].b {
            drop_part(l, proj(p, PJ_CONST, k, &pbody), node, &pbody, &pcx);
        }
        return;
    }
    if tk != TyKind::Enum {
        return;
    }
    // _d = discriminant P; switch _d [V: bbV, ..., otherwise: bbAll]
    let d = new_local(enum_tag_ty(t, pcx), LF_TEMP, -1, node, &pbody);
    let at = pbody.ops.len() as i64;
    push_op(OK_PLACE, l, p, &pbody);
    emit(SK_ASSIGN, d, 0, RV_DISCR, 0, 0, at, 1, node, &pbody);
    var cases = 0;
    let ti = pbody.targets.len() as i64;
    var c = pcx.mp_first[q];
    while c >= 0 {
        if proj_kind_of(c, pbody, pcx) == PJ_VARIANT && bit_get(2, c, pcx) {
            pbody.targets.push(variant_discr(proj_val(pcx.mp_proj[c], pbody), pcx));
            let pbody_arg = new_block(&pbody);
            pbody.targets.push(pbody_arg);
            cases += 1;
        }
        c = pcx.mp_next[c];
    }
    let others = new_block(&pbody);
    let join = new_block(&pbody);
    let at2 = pbody.ops.len() as i64;
    push_op(OK_COPY, d, 0, &pbody);
    push_term(TK_SWITCH, ti, cases, others, at2, 1, node, &pbody);
    // (the state is the same in every case: the switch reads it only)
    let mark = pcx.snaps.len() as i64;
    for w in 0..3 * pcx.nw {
        pcx.snaps.push(pcx.cur[w]);
    }
    var i = 0;
    c = pcx.mp_first[q];
    while c >= 0 {
        if proj_kind_of(c, pbody, pcx) == PJ_VARIANT && bit_get(2, c, pcx) {
            for w in 0..3 * pcx.nw {
                pcx.cur[w] = pcx.snaps[mark + w];
            }
            enter_block(pbody.targets[ti + 2 * i + 1], &pbody);
            let v = proj_val(pcx.mp_proj[c], pbody);
            for k in 0..variant_field_count(v, pcx) {
                if type_glue(variant_part_type(v, k, pcx), &pcx) {
                    drop_part(l, proj(pcx.mp_proj[c], PJ_FIELD, k, &pbody), node, &pbody, &pcx);
                }
            }
            push_term(TK_GOTO, join, 0, 0, 0, 0, node, &pbody);
            i += 1;
        }
        c = pcx.mp_next[c];
    }
    for w in 0..3 * pcx.nw {
        pcx.cur[w] = pcx.snaps[mark + w];
    }
    pcx.snaps.truncate(len_arg(mark));
    enter_block(others, &pbody);
    let whole = if bit_get(2, q, pcx)
        && others_drop(q, pbody, &pcx) { decide(q, true, &pbody, &pcx) }
        else { DS_REMOVED };
    if whole != DS_REMOVED {
        emit(SK_DROP, l, p, whole, if whole == DS_FLAG { pcx.mp_flag[q] } else { -1 }, -1, 0, 0,
            node, &pbody);
    }
    push_term(TK_GOTO, join, 0, 0, 0, 0, node, &pbody);
    enter_block(join, &pbody);
}

// The flags the parts' drops of an open drop of place (l, p), path q, will
// read (open_parts, from the same state CUR): made before the rewrite, so
// that the rewrite clears each at entry and writes it wherever its path
// is initialized or moved (0.26.1, R6: a flag made by open_parts itself
// had no write before its drop).
fn open_flags(l: i64, p: i64, q: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let t = undistinct(full_place_type(l, p, pbody, &pcx), pcx);
    if t <= 0 {
        return;
    }
    let tk = pcx.types[t].kind;
    if tk == TyKind::Struct {
        let s = pcx.types[t].a;
        for k in 0..struct_field_count(s, pcx) {
            if type_glue(struct_field_ty(s, k, pcx), &pcx) {
                part_flags(l, proj(p, PJ_FIELD, k, &pbody), &pbody, &pcx);
            }
        }
        return;
    }
    if tk == TyKind::Tuple {
        for k in 0..pcx.types[t].count {
            if type_glue(type_elem(t, k, pcx), &pcx) {
                part_flags(l, proj(p, PJ_FIELD, k, &pbody), &pbody, &pcx);
            }
        }
        return;
    }
    if tk == TyKind::Array {
        for k in 0..pcx.types[t].b {
            part_flags(l, proj(p, PJ_CONST, k, &pbody), &pbody, &pcx);
        }
        return;
    }
    if tk != TyKind::Enum {
        return;
    }
    var c = pcx.mp_first[q];
    while c >= 0 {
        if proj_kind_of(c, pbody, pcx) == PJ_VARIANT && bit_get(2, c, pcx) {
            let v = proj_val(pcx.mp_proj[c], pbody);
            for k in 0..variant_field_count(v, pcx) {
                if type_glue(variant_part_type(v, k, pcx), &pcx) {
                    part_flags(l, proj(pcx.mp_proj[c], PJ_FIELD, k, &pbody), &pbody, &pcx);
                }
            }
        }
        c = pcx.mp_next[c];
    }
    if bit_get(2, q, pcx) && others_drop(q, pbody, &pcx) {
        decide(q, true, &pbody, &pcx);
    }
}

// drop_part's decision, for its flag only.
fn part_flags(l: i64, p: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let q = path_of(l, p, false, pbody, &pcx);
    if q < 0 {
        return;
    }
    if decide(q, false, &pbody, &pcx) == DS_OPEN {
        open_flags(l, p, q, &pbody, &pcx);
    }
}

// A part's drop, decided from CUR (its path made by complete_parts);
// opened again when its own parts moved.
fn drop_part(l: i64, p: i64, node: i64, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    let q = path_of(l, p, false, pbody, &pcx);
    if q < 0 {
        emit(SK_DROP, l, p, DS_KEPT, -1, -1, 0, 0, node, &pbody);
        return;
    }
    let ds = decide(q, false, &pbody, &pcx);
    if ds == DS_REMOVED {
        return;
    }
    emit(SK_DROP, l, p, ds, if ds == DS_FLAG { pcx.mp_flag[q] } else { -1 }, -1, 0, 0, node,
        &pbody);
    if ds == DS_OPEN {
        open_parts(l, p, q, node, &pbody, &pcx);
    }
}

fn push_term(kind: i64, a: i64, b: i64, c: i64, ops: i64, nops: i64, node: i64,
    pbody: inout Body<Comp>) {
    crate::places::ir::close_block(&pbody);
    pbody.stmts.push(PStmt { kind, a, b, c, d: 0, e: 0, ops, nops, node });
    pbody.cur_block = -1;
}

// ---- The driver ----

// Elaborates the body held (after build_body): its drops decided, its
// flags made. Nothing for a body with no drop.
pub fn elaborate(pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) {
    var any = false;
    for s in 0..pbody.stmts.len() {
        if pbody.stmts[s].kind == SK_DROP {
            any = true;
            break;
        }
    }
    pcx.rpo_fresh = false;
    pcx.runs_drops = false;
    if !any {
        return;
    }
    pcx.elaborated += 1;
    pcx.flags_made = 0;
    collect_paths(&pbody, &pcx);
    pcx.nw = (path_count(pcx) + 63) / 64;
    if pcx.nw == 0 {
        pcx.nw = 1;
    }
    compute_preds(&pbody);
    compute_rpo(&pbody);
    pcx.rpo_fresh = true;
    dataflow(pbody, &pcx);
    decide_all(&pbody, &pcx);
    var opened = false;
    for s in 0..pbody.stmts.len() {
        if pbody.stmts[s].kind == SK_DROP && pbody.stmts[s].c == DS_OPEN {
            opened = true;
            break;
        }
    }
    if opened || pcx.flags_made > 0 {
        rewrite(&pbody, &pcx);
    }
}
