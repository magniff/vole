// The builder (0.26.0, docs/design/places-ir.md §3, §4, §8 step 2): one
// checked function body (its AST, with the checker's and the own pass's
// nodes in it) into the IR of places/ir.vl, in evaluation order.
//
// Scopes (§3.7) are a stack: the body, each block, each statement (its
// temporaries), each loop and arm. A scope's entries are "drop local l",
// "storage of l ends" and "run defer d"; leaving a scope by any edge emits
// the entries of every scope it leaves, innermost first, each in reverse
// order of registration. Every needs-drop local and temporary gets a drop
// there, whether it moved or not: elaboration decides each (elab.vl).
//
// Temporaries (0.26.2) are the builder's own: a value where a place is
// needed (`&e`, a field read out of it, a receiver) or an operand gets a
// temporary, whose drop is an entry of its statement's scope (temp_home,
// R5's rule: the end of its statement, or of its block for a tail and a
// `let` that may view it); so is an owned assignment's drop of the old
// value, `tmp = v; drop(p); p = move tmp` (§3.8, lower_assign_at).
//
// The own pass's nodes are read through (§4; 0.26.2: it places no drop):
// - a statement temporary (drops.vl temp_value: a NODE_TEMP block, `{ let
//   __own_tv = e; &__own_tv }`) is read as the `&e` it stands for
//   (own_temp_block);
// - the checker's transparent blocks (BLOCK_TRANSPARENT: `?`'s and a
//   requires call's) are no scope: their `let`s are temporaries of the
//   statement;
// - the bindings it borrows (byref.vl: BYREF, a `for` loop's sequence of
//   a place, the `==` operands of an operator) are BORROWED locals,
//   initialized by a copy.
//
// A construct the builder does not handle yet makes the body a fallback
// (BUILD_FAILED, FAIL_NODE): no body, counted by the driver.

use crate::base::{intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    BLOCK_TRANSPARENT, CLOSURE_MOVE, NODE_IN_BOUNDS, NODE_REF_MUT, NodeKind, child,
};
use crate::front::byref::{MATCH_BYREF, NO_DROP, borrowed_call, indexable_place};
use crate::front::check::Res;
use crate::front::check::temps::NODE_TEMP;
use crate::front::consteval::wrap_int;
use crate::front::contracts::expand::is_pre_fn;
use crate::front::distinct::enum_niche;
use crate::front::kinds::{P_MUT, P_RAW, P_VALUE, is_view_type, param_mode};
use crate::front::lexer::Tok;
use crate::front::patterns::{binding_count, binds_ref, is_irrefutable, pattern_referent};
use crate::front::patterns::usefulness::int_key;
use crate::front::types::{
    REF_MUT, REF_SHARED, TY_BOOL, TY_I64, TY_NEVER, TY_UNIT, TyKind, fn_param, is_compound,
    is_integer, is_void, ref_to, variant_field,
};
use crate::places::front::{
    ast_local_mutable, ast_local_ty, enum_tag_ty, fn_is_extern, fn_module, fn_param_count, fn_ret,
    static_ty, struct_field_name, type_glue, variant_discr,
};
use crate::places::ir::{
    AK_ARRAY, AK_BOUNDS, AK_CLOSURE, AK_STRUCT, AK_TUPLE, AK_VARIANT, AS_CONJUNCT, AS_UNDECIDED,
    BK_FAKE, BK_MUT, BK_MUT2, BK_RAW, BK_RAW_MUT, BK_SHARED, BO_ADD, BO_AND, BO_DIV, BO_EQ, BO_GE,
    BO_GT, BO_LE, BO_LT, BO_MUL, BO_NE, BO_OR, BO_REM, BO_SHL, BO_SHR, BO_SUB, BO_XOR, Body,
    DS_UNDECIDED, IK_ARCH, IK_CONTRACT, IK_PANIC, IK_VECTOR, LF_BORROWED, LF_MUT, LF_PARAM,
    LF_RETURN, LF_STATIC, LF_TEMP, LF_USER, OK_CONST, OK_COPY, OK_CSTR, OK_FLOAT, OK_FN, OK_INT,
    OK_MOVE, OK_PLACE, OK_STR, OK_UNIT, PJ_CONST, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION,
    PJ_VARIANT, PStmt, RV_AGG, RV_BINARY, RV_CAST, RV_CHECKED, RV_DISCR, RV_LEN, RV_REF, RV_REPEAT,
    RV_SLICE, RV_UNARY, RV_USE, SK_ASSERT, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC,
    SK_LIVE, SK_MENTION, TK_GOTO, TK_RETURN, TK_SWITCH, TK_UNREACHABLE, UO_BITNOT, UO_NEG, UO_NOT,
    block_count, block_len, block_start, block_term, body_begin, emit, enter_block, has_flag,
    is_union_type, local_count, new_block, new_local, op_a, op_b, op_kind, ops_mark, place_type,
    proj, proj_indirect, proj_kind, proj_parent, proj_val, push_op, reachable, struct_closure,
    terminate, undistinct,
};

// ---- State ----

// The scope stack: records of SW words (kind, first entry, its node
// (where its drops run, places/print.vl drop_pos; a loop's: the loop),
// break block, continue block, the loop's result local and projection,
// whether `continue` takes a back edge, and whether it is a home of
// statement temporaries: temp_home).
const SW: i64 = 9;
const SC_BODY: i64 = 1;
const SC_BLOCK: i64 = 2;
const SC_STMT: i64 = 3;
const SC_LOOP: i64 = 4;
const SC_ARM: i64 = 5;
// Their entries: (kind, value) pairs.
const EN_DROP: i64 = 1;
const EN_DEAD: i64 = 2;

fn syms(pcx: &mut Ctx<Comp>) {
    if pcx.sym_for_seq == 0 {
        pcx.sym_for_seq = intern_c(c"__for_seq", pcx);
    }
}

fn unsupported(n: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.build_failed {
        pcx.build_failed = true;
        pcx.fail_node = n;
    }
}

// ---- Locals ----

fn map_local(l: i64, ir: i64, p: i64, pcx: &mut Ctx<Comp>) {
    while pcx.map_gen.len() as i64 <= l {
        pcx.map_l.push(0);
        pcx.map_p.push(0);
        pcx.map_gen.push(0);
    }
    pcx.map_l[l as usize] = ir;
    pcx.map_p[l as usize] = p;
    pcx.map_gen[l as usize] = pcx.build_gen;
}

// The IR place of AST local l (PL_L, PL_P); false when it has none.
fn mapped(l: i64, pcx: &mut Ctx<Comp>) -> bool {
    if l < 0 || l >= pcx.map_gen.len() as i64 || pcx.map_gen[l as usize] != pcx.build_gen {
        return false;
    }
    pcx.pl_l = pcx.map_l[l as usize];
    pcx.pl_p = pcx.map_p[l as usize];
    true
}

// Whether AST local l is a borrowed copy (byref.vl's BYREF).
fn ast_borrowed(l: i64, pcx: &Ctx<Comp>) -> bool {
    l >= 0 && pcx.byref.get(l + 1) != 0
}

fn needs_drop(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    t > 0 && t != TY_NEVER && type_glue(t, pcx)
}

// A new IR local for AST local l (bound by a pattern or a `let`).
fn user_local(l: i64, node: i64, borrowed: bool, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let ty = ast_local_ty(l, pcx);
    let mut flags = LF_USER;
    if ast_local_mutable(l, pcx) {
        flags |= LF_MUT;
    }
    if borrowed || ast_borrowed(l, pcx) {
        flags |= LF_BORROWED;
    }
    let ir = new_local(ty, flags, l, node, pbody);
    map_local(l, ir, 0, pcx);
    ir
}

// A temporary of type ty, which the builder writes itself (a result, a
// counter, an assignment's value): its storage begins now, and its storage
// end is an entry of the innermost scope. Its drop, when its type needs one
// and it is not borrowed, is an entry of its statement's scope (temp_home,
// R5): when that is not the innermost, the temporary has no storage markers
// (made on some paths of the scope it drops in, an arm's: its storage is
// the body's).
fn new_temp(ty: i64, node: i64, borrowed: bool, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let l = new_local(ty, LF_TEMP | if borrowed { LF_BORROWED } else { 0 }, -1, node, pbody);
    let drop = !borrowed && needs_drop(ty, pcx);
    let h = if drop { temp_home(pcx) } else { scope_depth(pcx) - 1 };
    if h == scope_depth(pcx) - 1 {
        live(l, pbody, pcx);
        schedule(EN_DEAD, l, pbody, pcx);
        if drop {
            schedule(EN_DROP, l, pbody, pcx);
        }
    } else {
        schedule_in(h, EN_DROP, l, pbody, pcx);
    }
    l
}

// A temporary holding the value of expression e, made into it, dropped at
// the end of scope h (an operand's: new_temp's rule, value_home; a place's,
// `&e` or a part read out of e: its statement's, temp_home, so that what
// the statement makes of it outlives none of it). Its entries are
// registered once it holds the value, so that the temporaries e makes drop
// after it (`r(1).next().show()`: the last made first). Borrowed (no drop)
// for a copy its result is (copied_call).
fn value_temp(e: i64, borrowed: bool, h: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let ty = pcx.nodes[e as usize].ty;
    let l = new_local(ty, LF_TEMP | if borrowed { LF_BORROWED } else { 0 }, -1, e, pbody);
    let drop = !borrowed && needs_drop(ty, pcx);
    let inner = h == scope_depth(pcx) - 1;
    if inner {
        live(l, pbody, pcx);
    }
    expr_into(e, l, 0, pbody, pcx);
    if inner {
        schedule(EN_DEAD, l, pbody, pcx);
        if drop {
            schedule(EN_DROP, l, pbody, pcx);
        }
    } else if drop {
        schedule_in(h, EN_DROP, l, pbody, pcx);
    }
    l
}

// The scope a temporary of type ty drops in by new_temp's rule.
fn value_home(ty: i64, borrowed: bool, pcx: &mut Ctx<Comp>) -> i64 {
    if !borrowed && needs_drop(ty, pcx) { temp_home(pcx) } else { scope_depth(pcx) - 1 }
}

// The temporary holding the value of e where a place is needed (value_temp,
// in its statement's scope).
fn place_temp(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    value_temp(e, copied_call(e, pcx), temp_home(pcx), pbody, pcx)
}

// Whether e, an argument, is a branch's value lent to a let parameter: of
// type `&T`, a match, an if, a block or a `?`.
fn lent_branch(e: i64, pcx: &Ctx<Comp>) -> bool {
    let t = pcx.nodes[e as usize].ty;
    let k = pcx.nodes[e as usize].kind;
    t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == REF_SHARED
        && (k == NodeKind::Match
            || k == NodeKind::If || k == NodeKind::Try || k == NodeKind::Block
            && (pcx.nodes[e as usize].p & NODE_TEMP) == 0)
}

// operand(e, moving) for an argument (a call's, a struct literal's field):
// LENT_HOME set for it.
fn arg_operand(e: i64, moving: bool, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let saved = pcx.lent_home;
    pcx.lent_home = if lent_branch(e, pcx) { temp_home(pcx) } else { -1 };
    operand(e, moving, pbody, pcx);
    pcx.lent_home = saved;
}

fn live(l: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !keeps_storage(l, pbody, pcx) {
        return;
    }
    emit(SK_LIVE, l, 0, 0, 0, 0, 0, 0, 0, pbody);
}

// Whether local l gets its storage markers: every local when they are
// printed or verified (ALL_STORAGE), else only one whose type has glue,
// which elaboration reads them for (a StorageLive or StorageDead makes its
// paths uninitialized). The code generators ignore them in 0.26.1, and
// most locals are scalars: about half the statements.
fn keeps_storage(l: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    pcx.all_storage || type_glue(pbody.locals[l as usize].ty, pcx)
}

// The local `()` values are discarded into.
fn unit_local(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.unit_local < 0 {
        pcx.unit_local = new_local(TY_UNIT, LF_TEMP, -1, 0, pbody);
    }
    pcx.unit_local
}

// The IR local of static `name` (a symbol).
fn static_local(name: i64, node: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut i: i64 = 0;
    while i < pcx.statics_seen.len() as i64 {
        if pcx.statics_seen[i as usize] == name {
            return pcx.statics_seen[(i + 1) as usize];
        }
        i += 2;
    }
    let l = new_local(static_ty(name, pcx), LF_STATIC, name, node, pbody);
    pcx.statics_seen.push(name);
    pcx.statics_seen.push(l);
    l
}

// ---- Scopes ----

// A new innermost scope; `home` when the temporaries made in it (and in the
// scopes inside it that are none) drop at its end (temp_home).
fn push_scope(kind: i64, node: i64, home: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let at = pcx.build_scopes.len() as i64 / SW;
    pcx.build_scopes.push(kind);
    pcx.build_scopes.push(pcx.entries.len() as i64 / 2);
    pcx.build_scopes.push(node);
    pcx.build_scopes.push(-1);
    pcx.build_scopes.push(-1);
    pcx.build_scopes.push(-1);
    pcx.build_scopes.push(0);
    pcx.build_scopes.push(0);
    pcx.build_scopes.push(if home { 1 } else { 0 });
    at
}

// (0.26.2) The scope a statement temporary drops at the end of, R5's rule
// (conventions.md §2.2, "Temporaries"): its statement's (a `let`, an
// expression statement, a `while` condition, a `defer`'s), or its block's
// for a block's tail and a `let` that may keep a view of it (lower_let
// makes no statement scope for one). Not an arm's, a guard's or a loop's,
// nor a checker's desugaring of an expression (desugared_block: an
// operator's `{ let ==l = a; .. }`, an f-string's, a `?`'s): a temporary
// made there is its statement's.
fn temp_home(pcx: &Ctx<Comp>) -> i64 {
    let mut s = scope_depth(pcx) - 1;
    while s > 0 && pcx.build_scopes[(s * SW + 8) as usize] == 0 {
        s -= 1;
    }
    s
}

fn scope_depth(pcx: &Ctx<Comp>) -> i64 {
    pcx.build_scopes.len() as i64 / SW
}

fn schedule(kind: i64, v: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if kind == EN_DEAD && !keeps_storage(v, pbody, pcx) {
        return;
    }
    pcx.entries.push(kind);
    pcx.entries.push(v);
}

// The entries of scope s, emitted (innermost last registered first).
fn emit_scope(s: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let first = pcx.build_scopes[(s * SW + 1) as usize];
    let end = if s + 1 < scope_depth(pcx) { pcx.build_scopes[((s + 1) * SW + 1) as usize] }
        else { pcx.entries.len() as i64 / 2 };
    // (where its drops run: the exit taken, or the scope's own end)
    let at = if pcx.exit_node > 0 { pcx.exit_node }
        else { pcx.build_scopes[(s * SW + 2) as usize] };
    let mut e = end - 1;
    while e >= first {
        let kind = pcx.entries[(2 * e) as usize];
        let v = pcx.entries[(2 * e + 1) as usize];
        if kind == EN_DROP {
            emit(SK_DROP, v, 0, DS_UNDECIDED, -1, pbody.locals[v as usize].src, 0, 0, at, pbody);
        } else if kind == EN_DEAD {
            emit(SK_DEAD, v, 0, 0, 0, 0, 0, 0, 0, pbody);
        }
        e -= 1;
    }
}

// Leaves scopes down to `depth` (they stay on the stack: an edge out of
// them, `break`, `return`).
fn exit_to(depth: i64, node: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let saved = pcx.exit_node;
    pcx.exit_node = node;
    let mut s = scope_depth(pcx) - 1;
    while s >= depth {
        emit_scope(s, pbody, pcx);
        s -= 1;
    }
    pcx.exit_node = saved;
}

// The innermost scope ends: its entries emitted (when the code reaches its
// end), then it is popped.
fn pop_scope(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = scope_depth(pcx) - 1;
    if reachable(pbody) {
        emit_scope(s, pbody, pcx);
    }
    pcx.entries.truncate((2 * pcx.build_scopes[(s * SW + 1) as usize]) as usize);
    pcx.build_scopes.truncate((s * SW) as usize);
}

// The loop scope of loop node lp, or -1.
fn loop_scope(lp: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut s = scope_depth(pcx) - 1;
    while s >= 0 {
        if pcx.build_scopes[(s * SW) as usize] == SC_LOOP
            && pcx.build_scopes[(s * SW + 2) as usize] == lp {
            return s;
        }
        s -= 1;
    }
    -1
}

fn pop_scope_at(s: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    while scope_depth(pcx) > s {
        pop_scope(pbody, pcx);
    }
}

// ---- Operands ----

fn set_op(k: i64, a: i64, b: i64, pcx: &mut Ctx<Comp>) {
    pcx.opk = k;
    pcx.opa = a;
    pcx.opb = b;
}

// The current operand written straight to P_OPS: a statement whose
// operands are all known (nothing is emitted between its ops_mark and its
// emit), so no staging.
fn push_now(pbody: &mut Body<Comp>, pcx: &Ctx<Comp>) {
    push_op(pcx.opk, pcx.opa, pcx.opb, pbody);
}

// The current operand added to a statement's operands being written
// straight to P_OPS from `at` (n there so far), as each is made: when
// making it emitted statements with operands of their own (after ours),
// ours are moved to the end first. The new start of the operands.
fn ops_add(at: i64, n: i64, pbody: &mut Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut start = at;
    if pbody.ops.len() as i64 != at + 3 * n {
        start = pbody.ops.len() as i64;
        for j in 0..3 * n {
            let w = pbody.ops[(at + j) as usize];
            pbody.ops.push(w);
        }
    }
    push_now(pbody, pcx);
    start
}

// The operand that reads place (l, p) of type ty: a move of a value that
// needs drop when `moving`, but out of a borrowed copy (a copy of a
// borrowed copy is one too), else a copy.
fn place_operand(l: i64, p: i64, ty: i64, moving: bool, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // (0.27.1: in the rust edition a value moves unless its type is Copy,
    // glue or not, D8.3)
    // RULE: Z9.6 (`&*p`, `&mut *p` of a fat raw pointer p: the front gives
    // p itself, typed `&[T]` or `&mut [T]`; p is Copy, so it is copied)
    let pt: i64 = if pcx.rust_body && l >= 0 {
        crate::places::ir::full_place_type(l, p, pbody, pcx)
    } else { 0 };
    let raw_fat = pt > 0 && crate::front::types::is_raw_view(pt, pcx);
    let moves = if pcx.rust_body { !raw_fat && !crate::places::regions::rust_copy(ty, pcx) }
        else { type_glue(ty, pcx) };
    // (and in the rust edition out of a borrowed copy's referent or element
    // too: the borrow checker's move_out, which reports what the backstop
    // does here)
    let rust_out = pcx.rust_body && proj_indirect(p, pbody);
    if moving && ty > 0 && moves && (!has_flag(l, LF_BORROWED, pbody) || rust_out) {
        set_op(OK_MOVE, l, p, pcx);
    } else {
        set_op(OK_COPY, l, p, pcx);
    }
}

// RULE: D3.6 (0.27.7) Whether place (l, p), read as a value of type ty,
// is a rust body's `&mut T` coerced to a raw pointer (ty `*T`).
fn raw_from_mut(l: i64, p: i64, ty: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let to = undistinct(ty, pcx);
    if !pcx.rust_body || l < 0 || to <= 0
        || pcx.types[to as usize].kind != TyKind::Ptr || pcx.types[to as usize].b != 0 {
        return false;
    }
    let from = undistinct(place_type(l, p, pbody, pcx), pcx);
    from > 0 && pcx.types[from as usize].kind == TyKind::Ptr
        && pcx.types[from as usize].b == REF_MUT
}

// RULE: D3.6 (0.27.7) Whether expression e was coerced to a written
// `*mut T` (the checker's pcx.raw_mut_coerced): its raw reborrow is a
// write, `&raw mut`; to `*const T` (or a type not written), a read.
pub fn raw_mut_goal(e: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.raw_mut_coerced.len() as i64 {
        if pcx.raw_mut_coerced[i as usize] == e {
            return true;
        }
    }
    false
}

// An operand for the value of expression e (moved when `moving`).
fn operand(e: i64, moving: bool, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[e as usize].kind;
    let ty = pcx.nodes[e as usize].ty;
    if k == NodeKind::Int || k == NodeKind::Char {
        set_op(OK_INT, crate::front::consteval::wrap_int(pcx.nodes[e as usize].a, ty), ty, pcx);
        return;
    }
    if k == NodeKind::Bool {
        set_op(OK_INT, pcx.nodes[e as usize].a, TY_BOOL, pcx);
        return;
    }
    if k == NodeKind::Float {
        set_op(OK_FLOAT, pcx.nodes[e as usize].a, ty, pcx);
        return;
    }
    if k == NodeKind::Unit {
        set_op(OK_UNIT, 0, TY_UNIT, pcx);
        return;
    }
    if k == NodeKind::Str {
        set_op(OK_STR, pcx.nodes[e as usize].a, ty, pcx);
        return;
    }
    if k == NodeKind::CStr {
        set_op(OK_CSTR, pcx.nodes[e as usize].a, ty, pcx);
        return;
    }
    if k == NodeKind::Ident && pcx.nodes[e as usize].res == Res::Const {
        set_op(OK_CONST, pcx.nodes[e as usize].y, ty, pcx);
        return;
    }
    if k == NodeKind::Ident && pcx.nodes[e as usize].res == Res::Fn {
        set_op(OK_FN, pcx.nodes[e as usize].y, ty, pcx);
        return;
    }
    if is_place_expr(e, pcx) {
        if place_of(e, pbody, pcx) {
            let l = pcx.pl_l;
            let p = pcx.pl_p;
            if raw_from_mut(l, p, ty, pbody, pcx) {
                // RULE: D3.6 (0.27.7: a `&mut T` place where a raw pointer
                // goes, a `let`'s value, a result, an assigned value, a
                // field's: reborrowed raw, not copied, I7; `_t = &raw mut
                // (*Q)`, a write, where `*mut T` is written, else `&raw
                // const (*Q)`, a read, as rustc's coercion to `*const T`)
                let t = new_temp(ty, e, false, pbody, pcx);
                let dp = proj(p, PJ_DEREF, 0, pbody);
                emit_ref(t, 0, l, dp, if raw_mut_goal(e, pcx) { BK_RAW_MUT } else { BK_RAW }, e,
                    pbody, pcx);
                set_op(OK_MOVE, t, 0, pcx);
                return;
            }
            place_operand(l, p, ty, moving, pbody, pcx);
            return;
        }
    }
    if is_void(ty) || ty == TY_NEVER {
        // (a `()` value, or none: made, then the unit constant)
        expr_into(e, -1, 0, pbody, pcx);
        set_op(OK_UNIT, 0, TY_UNIT, pcx);
        return;
    }
    let t = value_temp(e, false, value_home(ty, false, pcx), pbody, pcx);
    place_operand(t, 0, ty, true, pbody, pcx);
}

// Whether operand makes e's value without a temporary: a constant, a
// local, a static, a function, a place.
fn is_operand_kind(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Int || k == NodeKind::Char || k == NodeKind::Bool
        || k == NodeKind::Float || k == NodeKind::Unit || k == NodeKind::Str
        || k == NodeKind::CStr {
        return true;
    }
    if k == NodeKind::Ident {
        let r = pcx.nodes[e as usize].res;
        return r == Res::Const || r == Res::Fn || r == Res::Local || r == Res::Static;
    }
    is_place_expr(e, pcx)
}

// ---- Places ----

// Whether e is written as a place: a local, a static, a field or tuple
// part of a place (or through a pointer), `*p`, an index.
fn is_place_expr(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        return pcx.nodes[e as usize].res == Res::Local || pcx.nodes[e as usize].res == Res::Static;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return true;
    }
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op == Tok::Star;
    }
    if k == NodeKind::Index {
        return pcx.nodes[pcx.nodes[e as usize].b as usize].kind != NodeKind::Range;
    }
    false
}

// The place of place expression e (PL_L, PL_P): its base evaluated as it
// must be (a value base into a temporary, a pointer read), the index
// checked. False when e is not one (or its local is unknown).
fn place_of(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        if pcx.nodes[e as usize].res == Res::Static {
            pcx.pl_l = static_local(pcx.nodes[e as usize].a, e, pbody, pcx);
            pcx.pl_p = 0;
            return true;
        }
        if pcx.nodes[e as usize].res != Res::Local {
            return false;
        }
        if !mapped(pcx.nodes[e as usize].y, pcx) {
            unsupported(e, pcx);
            pcx.pl_l = unit_local(pbody, pcx);
            pcx.pl_p = 0;
            return true;
        }
        return true;
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star {
        // `*p`: p's value read (a place holding a pointer, or a temporary)
        deref_place(pcx.nodes[e as usize].b, pbody, pcx);
        return true;
    }
    if k == NodeKind::FieldAccess {
        let base = pcx.nodes[e as usize].a;
        let field = pcx.nodes[e as usize].x;
        if pcx.nodes[e as usize].y == 1 {
            // (through a pointer: `(*p).f`)
            deref_place(base, pbody, pcx);
            pcx.pl_p = proj(pcx.pl_p, PJ_FIELD, field, pbody);
            return true;
        }
        as_place(base, pbody, pcx);
        let bt = pcx.nodes[base as usize].ty;
        pcx.pl_p = proj(pcx.pl_p, if is_union_type(bt, pcx) { PJ_UNION } else { PJ_FIELD }, field,
            pbody);
        return true;
    }
    if k == NodeKind::TupleField {
        as_place(pcx.nodes[e as usize].a, pbody, pcx);
        pcx.pl_p = proj(pcx.pl_p, PJ_FIELD, pcx.nodes[e as usize].b, pbody);
        return true;
    }
    if k == NodeKind::Index && pcx.nodes[pcx.nodes[e as usize].b as usize].kind != NodeKind::Range {
        return index_place(e, pbody, pcx);
    }
    false
}

// The place pointer expression e points to: `*e`, or, when e takes an
// address, the place it takes (`*&x` is x; the own pass's statement
// temporary's block stands for `&e`, so `*{ .. }` is the temporary itself).
fn deref_place(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[e as usize].kind;
    // RULE: D6.2.5 (a raw borrow is not folded: `*&raw mut S` is a place
    // through the raw pointer, so a reborrow of it, `(*&raw mut S).push(2)`,
    // is no reference to the static)
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Amp
        && (pcx.nodes[e as usize].p & crate::front::ast::NODE_RAW_BORROW) == 0
        && is_place_expr(pcx.nodes[e as usize].b, pcx)
        && place_of(pcx.nodes[e as usize].b, pbody, pcx) {
        return;
    }
    if k == NodeKind::Block && own_temp_block(e, pcx) && own_temp_addr(e, pcx) {
        own_temp_place(e, pbody, pcx);
        return;
    }
    as_place(e, pbody, pcx);
    pcx.pl_p = proj(pcx.pl_p, PJ_DEREF, 0, pbody);
}

// `base[i]`: the base's place first (a pointer's location, a slice's or an
// array's), then the index into a local, then the check.
fn index_place(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let base = pcx.nodes[e as usize].a;
    let idx = pcx.nodes[e as usize].b;
    let bt = undistinct(pcx.nodes[base as usize].ty, pcx);
    as_place(base, pbody, pcx);
    let bl = pcx.pl_l;
    let bp = pcx.pl_p;
    let ik = pcx.nodes[idx as usize].kind;
    // RULE: D8.6 (the rust edition: an index of a non-Copy element is a
    // place with no move path, as rustc's `a[0]`, so a move out of it is
    // E0508; a Copy element's constant index stays a path, R7)
    if bt > 0 && pcx.types[bt as usize].kind == TyKind::Array && ik == NodeKind::Int
        && (!pcx.rust_body || crate::places::regions::rust_copy(pcx.types[bt as usize].a, pcx)) {
        let v = pcx.nodes[idx as usize].a;
        if v >= 0 && v < pcx.types[bt as usize].b {
            pcx.pl_l = bl;
            pcx.pl_p = proj(bp, PJ_CONST, v, pbody);
            return true;
        }
    }
    // (the index in a local: one the program names, or a temporary)
    let mut il: i64 = -1;
    if ik == NodeKind::Ident && pcx.nodes[idx as usize].res == Res::Local
        && mapped(pcx.nodes[idx as usize].y, pcx)
        && pcx.pl_p == 0 {
        il = pcx.pl_l;
    } else {
        operand(idx, false, pbody, pcx);
        let it = pcx.nodes[idx as usize].ty;
        il = new_temp(it, idx, false, pbody, pcx);
        emit_use(il, 0, idx, pbody, pcx);
    }
    if bt > 0 && (pcx.nodes[e as usize].p & NODE_IN_BOUNDS) == 0 {
        let tk = pcx.types[bt as usize].kind;
        if tk == TyKind::Array {
            let at = ops_mark(pbody);
            set_op(OK_COPY, il, 0, pcx);
            push_now(pbody, pcx);
            set_op(OK_INT, pcx.types[bt as usize].b, TY_I64, pcx);
            push_now(pbody, pcx);
            emit(SK_ASSERT, 0, 0, AK_BOUNDS, e, 0, at, 2, e, pbody);
        } else if tk == TyKind::Slice {
            let len = new_temp(TY_I64, e, false, pbody, pcx);
            let at = ops_mark(pbody);
            set_op(OK_PLACE, bl, bp, pcx);
            push_now(pbody, pcx);
            emit(SK_ASSIGN, len, 0, RV_LEN, 0, 0, at, 1, e, pbody);
            let at2 = ops_mark(pbody);
            set_op(OK_COPY, il, 0, pcx);
            push_now(pbody, pcx);
            set_op(OK_COPY, len, 0, pcx);
            push_now(pbody, pcx);
            emit(SK_ASSERT, 0, 0, AK_BOUNDS, e, 0, at2, 2, e, pbody);
        }
    }
    pcx.pl_l = bl;
    pcx.pl_p = proj(bp, PJ_INDEX, il, pbody);
    true
}

// Whether the value of call e is a copy that its temporary holds without
// owning it (no drop), as the own pass's fresh: a copy of an element a
// collection keeps (borrowed_call); a block's whose value is one. A call
// temporary's rule, not a scrutinee's (scrutinee_place). (0.29) A generic
// call's result is not one: until then a result made of the callee's type
// parameters, from a callee that consumes no argument, was taken for a
// copy of what the arguments keep (0.26.1 R8, `second<T>(p: *T) -> T {
// p[1] }`), and the temporary of every `dup<X: Clone>(x: &X) -> X` leaked
// when lent or read (`obs(&dup(&t))`, `dup(&t).v`). A call's result is
// the caller's, whatever the callee read it through: code that reads a
// second owner out of a raw pointer forgets it itself (`mem::forget`,
// `ManuallyDrop`).
fn copied_call(e: i64, pcx: &mut Ctx<Comp>) -> bool {
    if borrowed_call(e, pcx) {
        return true;
    }
    // (through a block's value)
    pcx.nodes[e as usize].kind == NodeKind::Block && pcx.nodes[e as usize].a != 0
        && copied_call(pcx.nodes[e as usize].a, pcx)
}

// The place of e, whatever e is: a place expression's, or a temporary's
// holding its value.
fn as_place(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if is_place_expr(e, pcx) && place_of(e, pbody, pcx) {
        return;
    }
    pcx.pl_l = place_temp(e, pbody, pcx);
    pcx.pl_p = 0;
}

// RULE: D2.8 (0.27.5) Whether rvalue e is promotable: a literal, `-` of a
// numeric literal, an array or tuple literal of promotable elements, a
// repeat of one. No name, call, struct or variant literal, other operator.
fn promotable(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Int || k == NodeKind::Float || k == NodeKind::Char || k == NodeKind::Bool
        || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Unit {
        return true;
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Minus {
        let kb = pcx.nodes[pcx.nodes[e as usize].b as usize].kind;
        return kb == NodeKind::Int || kb == NodeKind::Float;
    }
    if k == NodeKind::Array || k == NodeKind::Tuple {
        for j in 0..pcx.nodes[e as usize].count {
            if !promotable(child(e, j, pcx), pcx) {
                return false;
            }
        }
        return true;
    }
    if k == NodeKind::Repeat {
        return promotable(pcx.nodes[e as usize].a, pcx);
    }
    false
}

// RULE: D2.8 (0.27.5) The place of e for a shared borrow: a promotable
// rvalue of a rust body in a temporary of the body's storage (no
// StorageLive, its StorageDead at the body's end: its loan outlives its
// statement and its branch, not the function), else as_place's.
fn shared_place(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !pcx.rust_body || !promotable(e, pcx) {
        as_place(e, pbody, pcx);
        return;
    }
    let l = new_local(pcx.nodes[e as usize].ty, LF_TEMP | crate::places::ir::LF_PROMOTED, -1, e,
        pbody);
    // (its storage ends with the body: D6.2.2 refuses a loan of it that
    // leaves the function)
    schedule_in(0, EN_DEAD, l, pbody, pcx);
    expr_into(e, l, 0, pbody, pcx);
    pcx.pl_l = l;
    pcx.pl_p = 0;
}

// ---- The own pass's statement temporaries, read as what they stand for ----
//
// (0.26.2) drops.vl's temp_value puts a NODE_TEMP block where a statement
// temporary is made, `{ let __own_tv = e; &__own_tv }`, for the own walk's
// view checks. The builder reads the block as `&e` (or, a tail of no `&`,
// `e`) and makes the temporary itself (value_temp, dropped by temp_home's
// rule).

// Whether b is one: a block flagged NODE_TEMP whose first statement is a
// `let` (an Ident flagged NODE_TEMP is the checker's, temps.vl).
fn own_temp_block(b: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[b as usize].kind == NodeKind::Block && (pcx.nodes[b as usize].p & NODE_TEMP) != 0
        && pcx.nodes[b as usize].count > 0
        && pcx.nodes[child(b, 0, pcx) as usize].kind == NodeKind::Let
}

// The value of own_temp_block b, e.
fn own_temp_value(b: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.nodes[child(b, 0, pcx) as usize].c
}

// Whether own_temp_block b gives its temporary's address (`&e`), not its
// value.
fn own_temp_addr(b: i64, pcx: &Ctx<Comp>) -> bool {
    let tail = pcx.nodes[b as usize].a;
    tail != 0 && pcx.nodes[tail as usize].kind == NodeKind::Unary
        && pcx.nodes[tail as usize].op == Tok::Amp
}

// The temporary holding the value of own_temp_block b (an address block):
// e moved into it, even when e is a place (hold_args' `&s` of a local
// declared in the argument: the statement keeps it, not s's scope).
fn own_temp_place(b: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let e = own_temp_value(b, pcx);
    let local = pcx.nodes[e as usize].kind == NodeKind::Ident
        && pcx.nodes[e as usize].res == Res::Local;
    pcx.pl_l = value_temp(e, copied_call(e, pcx),
        if local && pcx.lent_home >= 0 { pcx.lent_home } else { temp_home(pcx) }, pbody, pcx);
    pcx.pl_p = 0;
}

// The borrow kind of `&` node e (or a block standing for one) of type ty.
fn ref_kind(e: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    let t = undistinct(ty, pcx);
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == 0 {
        // (0.27.1: the rust edition's `&mut x` where a `*mut T` goes,
        // D2.2)
        return if (pcx.nodes[e as usize].p & NODE_REF_MUT) != 0 { BK_RAW_MUT }
            else { BK_RAW };
    }
    if (pcx.nodes[e as usize].p & NODE_REF_MUT) != 0
        || t > 0 && pcx.types[t as usize].kind == TyKind::Ptr
        && pcx.types[t as usize].b == REF_MUT {
        return BK_MUT;
    }
    BK_SHARED
}

// ---- Statements of assignment ----

// (l, p) = use of the current operand.
fn emit_use(l: i64, p: i64, node: i64, pbody: &mut Body<Comp>, pcx: &Ctx<Comp>) {
    let at = ops_mark(pbody);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, l, p, RV_USE, 0, 0, at, 1, node, pbody);
}

// ---- Expressions ----

// Evaluates e and writes its value to (dl, dp); dl = -1: the value is
// discarded.
fn expr_into(e: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if e == 0 {
        return;
    }
    pcx.stmts_made += 1;
    let k = pcx.nodes[e as usize].kind;
    let ty = pcx.nodes[e as usize].ty;
    if k == NodeKind::Block {
        lower_block(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::If {
        lower_if(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::Loop || k == NodeKind::While {
        lower_loop(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::For {
        lower_for(e, pbody, pcx);
        return;
    }
    if k == NodeKind::Match {
        lower_match(e, dl, dp, pbody, pcx);
        return;
    }
    // RULE: D3.6 (0.28.0) a `&mut T` reached through a place, given as
    // the function's result: reborrowed, `_0 = &mut *self.v`, as rustc does
    // at a coercion site (`fn deref_mut(&mut self) -> &mut T { self.v }`
    // was a move out of `self.v`). A whole local moves, as before; a
    // `let x = self.v;` is no coercion site and stays the move it is.
    if pcx.rust_body && dl >= 0 && dp == 0 && has_flag(dl, crate::places::ir::LF_RETURN, pbody)
        && (k == NodeKind::FieldAccess || k == NodeKind::Index) && ty > 0
        && pcx.types[undistinct(ty, pcx) as usize].kind == TyKind::Ptr
        && pcx.types[undistinct(ty, pcx) as usize].b == REF_MUT {
        as_place(e, pbody, pcx);
        let sl = pcx.pl_l;
        let sp = pcx.pl_p;
        let d = proj(sp, PJ_DEREF, 0, pbody);
        emit_ref(dl, 0, sl, d, BK_MUT, e, pbody, pcx);
        return;
    }
    if k == NodeKind::Call {
        lower_call(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::Assign {
        lower_assign_at(e, pbody, pcx);
        return;
    }
    if k == NodeKind::Return {
        lower_return(e, pbody, pcx);
        return;
    }
    if k == NodeKind::Break {
        lower_break(e, pbody, pcx);
        return;
    }
    if k == NodeKind::Continue {
        lower_continue(e, pbody, pcx);
        return;
    }
    if k == NodeKind::Try || k == NodeKind::Interp {
        expr_into(pcx.nodes[e as usize].y, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::Closure {
        // (its env, the struct literal the checker made of its captures, or
        // its function when it is coerced to a fn type; its body is a
        // function of its own)
        if pcx.nodes[e as usize].y == 0 {
            unsupported(e, pcx);
            return;
        }
        // (a closure that is not `move` captures by access: its env's
        // values are borrowed copies, the owner keeps them; an f-string's
        // holes too)
        let saved = pcx.agg_borrow;
        // (RULE: D19.2 not a rust-edition closure's, whose by-value
        // captures are moved in, `move` or not)
        let kinded = pcx.rust_body && pcx.nodes[e as usize].x > 0
            && pcx.closures[(pcx.nodes[e as usize].x - 1) as usize].kind != 0
            && (pcx.nodes[e as usize].c & crate::front::ast::CLOSURE_HOLES) == 0;
        pcx.agg_borrow = (pcx.nodes[e as usize].c & CLOSURE_MOVE) == 0
            && pcx.nodes[pcx.nodes[e as usize].y as usize].kind == NodeKind::StructLit && !kinded;
        expr_into(pcx.nodes[e as usize].y, dl, dp, pbody, pcx);
        pcx.agg_borrow = saved;
        return;
    }
    if k == NodeKind::EnumPanic {
        operand(pcx.nodes[e as usize].a, false, pbody, pcx);
        let at = ops_mark(pbody);
        push_now(pbody, pcx);
        emit(SK_INTRINSIC, unit_local(pbody, pcx), 0, IK_PANIC, e, 0, at, 1, e, pbody);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, e, pbody);
        return;
    }
    if k == NodeKind::VecOp {
        lower_vecop(e, dl, dp, pbody, pcx);
        return;
    }
    if dl < 0 {
        // (a value discarded: a place is mentioned, a value made)
        if is_place_expr(e, pcx) {
            if place_of(e, pbody, pcx) {
                emit(SK_MENTION, pcx.pl_l, pcx.pl_p, 0, 0, 0, 0, 0, e, pbody);
            }
            return;
        }
        if k == NodeKind::Unary || k == NodeKind::Binary || k == NodeKind::Cast {
            // (its operands evaluated for what they do)
            value_temp(e, false, value_home(ty, false, pcx), pbody, pcx);
            return;
        }
        if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
            || k == NodeKind::VariantLit || k == NodeKind::Repeat || k == NodeKind::Index {
            value_temp(e, false, value_home(ty, false, pcx), pbody, pcx);
            return;
        }
        if k == NodeKind::Int || k == NodeKind::Bool || k == NodeKind::Unit || k == NodeKind::Char
            || k == NodeKind::Float || k == NodeKind::Str || k == NodeKind::CStr
            || k == NodeKind::Ident {
            return;
        }
        unsupported(e, pcx);
        return;
    }
    if k == NodeKind::Unary {
        lower_unary(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::Binary {
        lower_binary(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::Cast {
        operand(pcx.nodes[e as usize].a, false, pbody, pcx);
        if !reachable(pbody) {
            return;
        }
        let at = ops_mark(pbody);
        push_now(pbody, pcx);
        emit(SK_ASSIGN, dl, dp, RV_CAST, ty, 0, at, 1, e, pbody);
        return;
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
        || k == NodeKind::VariantLit {
        lower_aggregate(e, dl, dp, pbody, pcx);
        return;
    }
    if k == NodeKind::Repeat {
        operand(pcx.nodes[e as usize].a, true, pbody, pcx);
        let at = ops_mark(pbody);
        push_now(pbody, pcx);
        emit(SK_ASSIGN, dl, dp, RV_REPEAT, pcx.types[undistinct(ty, pcx) as usize].b, 0, at, 1, e,
            pbody);
        return;
    }
    if k == NodeKind::Index && pcx.nodes[pcx.nodes[e as usize].b as usize].kind == NodeKind::Range {
        lower_slicing(e, dl, dp, pbody, pcx);
        return;
    }
    // A plain value: an operand, written.
    if !is_operand_kind(e, pcx) {
        unsupported(e, pcx);
        return;
    }
    let moving = !has_flag(dl, LF_BORROWED, pbody);
    operand(e, moving, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    emit_use(dl, dp, e, pbody, pcx);
}

fn lower_unary(e: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let op = pcx.nodes[e as usize].op;
    let ty = undistinct(pcx.nodes[e as usize].ty, pcx);
    if op == Tok::Amp {
        if ref_kind(e, ty, pcx) == BK_SHARED {
            shared_place(pcx.nodes[e as usize].b, pbody, pcx);
        } else {
            as_place(pcx.nodes[e as usize].b, pbody, pcx);
        }
        emit_ref(dl, dp, pcx.pl_l, pcx.pl_p, ref_kind(e, ty, pcx), e, pbody, pcx);
        return;
    }
    if op == Tok::Star {
        let moving = !has_flag(dl, LF_BORROWED, pbody);
        operand(e, moving, pbody, pcx);
        emit_use(dl, dp, e, pbody, pcx);
        return;
    }
    operand(pcx.nodes[e as usize].b, false, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    let at = ops_mark(pbody);
    push_now(pbody, pcx);
    let uo = if op == Tok::Minus { UO_NEG } else if op == Tok::Bang { UO_NOT } else { UO_BITNOT };
    // (0.26.3) a checked negation, but of a literal (`-128i8`, `-5`)
    let checked = uo == UO_NEG && checks_here(pbody, pcx) && is_integer(ty)
        && pcx.nodes[pcx.nodes[e as usize].b as usize].kind != NodeKind::Int;
    emit(SK_ASSIGN, dl, dp, if checked { RV_CHECKED } else { RV_UNARY }, uo, e, at, 1, e, pbody);
}

fn emit_ref(dl: i64, dp: i64, l: i64, p: i64, kind: i64, node: i64, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    // RULE: D6.2.5 (only a raw borrow, `&raw mut S`, takes a `static mut`'s
    // address; a `&mut S` where a `*mut T` goes is a reference to it too)
    let raw = (kind == BK_RAW || kind == BK_RAW_MUT)
        && (node <= 0 || (pcx.nodes[node as usize].p & crate::front::ast::NODE_RAW_BORROW) != 0
            || pcx.nodes[node as usize].kind != NodeKind::Unary);
    // (0.27.7: a place through a `*`, `&mut *P` of a `static mut P: *mut
    // T` or `&mut R[..]` of a `static mut R: &mut [T]`, is the pointee's:
    // the static's value is read, and the reference is not to it, as in
    // rustc's static_mut_refs)
    if !raw && kind != BK_FAKE && l >= 0 && !has_deref(p, pbody)
        && has_flag(l, LF_STATIC, pbody) && node > 0
        && crate::places::front::static_mutable(pbody.locals[l as usize].src, pcx) {
        static_mut_ref_error(l, node, pbody, pcx);
    }
    let at = ops_mark(pbody);
    set_op(OK_PLACE, l, p, pcx);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, dl, dp, RV_REF, kind, 0, at, 1, node, pbody);
}

// Whether projection list p has a `*` in it.
fn has_deref(p: i64, pbody: &Body<Comp>) -> bool {
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_DEREF {
            return true;
        }
        q = proj_parent(q, pbody);
    }
    false
}

// (0.27.1, docs/design/borrowck.md D6.2.5) error borrowck.static_mut_ref:
// a reference (`&S`, `&mut S`, or of a part) to a `static mut` S, in or
// out of `unsafe` (Rust 2024's rule): only its raw address is taken.
// RULE: D6.2.5
fn static_mut_ref_error(l: i64, node: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.static_mut_ref";
    crate::base::diag::err_begin(pcx.nodes[node as usize].start, pcx);
    crate::base::diag::err_fmt(
        format_args("a reference to the `static mut` '{}': only its raw address may be taken",
            str::from_utf8(sym_text(pbody.locals[l as usize].src, pcx)).unwrap()),
        pcx);
    crate::base::diag::err_help(c"take its raw address where you need it, `let p: *mut T = &raw mut S;` (`&raw const S` to read), and read or write through it in `unsafe` (Rust 2024, rustc's static_mut_refs)", pcx);
    crate::base::diag::err_end_soft(pcx);
    pcx.err_kind = saved;
}

fn lower_binary(e: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let op = pcx.nodes[e as usize].op;
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        // `a && b`: dest = a; if a (or !a) then dest = b, both made in
        // the destination itself (no destination is a place the operands
        // can read: an assignment's value goes to a temporary first,
        // lower_assign). RULE: D8.1 (a rust body: `a` in a temporary, the
        // destination assigned once on each path, `dest = copy t` where
        // `a` decides, as rustc builds it: a `let ok = a && b;` is
        // initialized once, not borrowck.assign_twice)
        let once = pcx.rust_body;
        let tl = if once {
            new_temp(pcx.nodes[pcx.nodes[e as usize].b as usize].ty, e, false, pbody, pcx)
        }
            else { dl };
        let tp: i64 = if once { 0 } else { dp };
        // RULE: D8.1 (0.28.0, a rust body) each operand is a terminating
        // scope, as rustc's: its temporaries drop before the other one
        // is evaluated (`a.lock().x && a.lock().y` holds one guard at a
        // time); 0.27.8 dropped them at the statement's end
        let sa: i64 = if once { push_scope(SC_STMT, pcx.nodes[e as usize].b, true, pcx) }
            else { -1 };
        expr_into(pcx.nodes[e as usize].b, tl, tp, pbody, pcx);
        if once {
            pop_scope_at(sa, pbody, pcx);
        }
        if !reachable(pbody) {
            return;
        }
        let rhs = new_block(pbody);
        let done = new_block(pbody);
        let short = if once { new_block(pbody) } else { done };
        let at = ops_mark(pbody);
        set_op(OK_COPY, tl, tp, pcx);
        push_now(pbody, pcx);
        if op == Tok::AmpAmp {
            switch_bool(at, short, rhs, e, pbody);
        } else {
            switch_bool(at, rhs, short, e, pbody);
        }
        if once {
            enter_block(short, pbody);
            set_op(OK_COPY, tl, 0, pcx);
            emit_use(dl, dp, e, pbody, pcx);
            goto(done, pbody);
        }
        enter_block(rhs, pbody);
        let sb: i64 = if once { push_scope(SC_STMT, pcx.nodes[e as usize].c, true, pcx) }
            else { -1 };
        expr_into(pcx.nodes[e as usize].c, dl, dp, pbody, pcx);
        if once {
            pop_scope_at(sb, pbody, pcx);
        }
        if reachable(pbody) {
            goto(done, pbody);
        }
        enter_block(done, pbody);
        return;
    }
    // (the left operand held while the right one is made: it may emit
    // statements of its own, with their operands)
    operand(pcx.nodes[e as usize].b, false, pbody, pcx);
    // RULE: D2.4a (0.27.5) a rust body reads the left side here when the
    // right side may evaluate a statement of its own
    if !quiet_expr(pcx.nodes[e as usize].c, pcx) {
        settle_operand(pcx.nodes[e as usize].b, false, pbody, pcx);
    }
    let k1 = pcx.opk;
    let a1 = pcx.opa;
    let b1 = pcx.opb;
    operand(pcx.nodes[e as usize].c, false, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    let at = ops_mark(pbody);
    push_op(k1, a1, b1, pbody);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, dl, dp,
        binary_rv(bo_of(op), pcx.nodes[pcx.nodes[e as usize].b as usize].ty, pbody, pcx), bo_of(op),
        e, at, 2, e, pbody);
}

// The IR's binary operator of token op (an operator or a compound
// assignment's).
fn bo_of(op: Tok) -> i64 {
    match op {
        Tok::Plus | Tok::PlusEq => BO_ADD,
        Tok::Minus | Tok::MinusEq => BO_SUB,
        Tok::Star | Tok::StarEq => BO_MUL,
        Tok::Slash | Tok::SlashEq => BO_DIV,
        Tok::Percent | Tok::PercentEq => BO_REM,
        Tok::Amp | Tok::AmpEq => BO_AND,
        Tok::Pipe | Tok::PipeEq => BO_OR,
        Tok::Caret | Tok::CaretEq => BO_XOR,
        Tok::Shl | Tok::ShlEq => BO_SHL,
        Tok::Shr | Tok::ShrEq => BO_SHR,
        Tok::EqEq => BO_EQ,
        Tok::BangEq => BO_NE,
        Tok::Lt => BO_LT,
        Tok::LtEq => BO_LE,
        Tok::Gt => BO_GT,
        Tok::GtEq => BO_GE,
        _ => 0,
    }
}

// (0.26.3) The rvalue of binary operator bo on operands of type ty:
// RV_CHECKED for an integer `+`, `-`, `*`, `<<` or `>>` when the overflow
// checks are on (middle::opt::OVERFLOW_CHECKS), but in std::num::wrapping
// (front/modules std_wraps), else RV_BINARY.
fn binary_rv(bo: i64, ty: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if checks_here(pbody, pcx) && (bo == BO_ADD || bo == BO_SUB || bo == BO_MUL || bo == BO_SHL
        || bo == BO_SHR) && is_integer(undistinct(ty, pcx)) {
        RV_CHECKED
    } else {
        RV_BINARY
    }
}

// (0.26.3) Whether the body built checks its arithmetic's overflow: the
// checks are on and it is not std::num::wrapping's (nor a shim's).
fn checks_here(pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> bool {
    pcx.overflow_checks && pbody.fn_ >= 0
        && !crate::front::modules::std_wraps(fn_module(pbody.fn_, pcx), pcx)
}

// A switch on bool operand `at` (in P_OPS): false to `f`, true to `t`.
fn switch_bool(at: i64, f: i64, t: i64, node: i64, pbody: &mut Body<Comp>) {
    let ti = pbody.targets.len() as i64;
    pbody.targets.push(0);
    pbody.targets.push(f);
    terminate(TK_SWITCH, ti, 1, t, at, 1, node, pbody);
}

// (0.28.0) Whether condition `c` of a rust body is a short-circuit, `a &&
// b`, `a || b` or a `!` of one, which cond_into makes control flow. (An
// MVS body keeps its own lowering, `a`'s value and then `b`'s written to
// the destination, which its optimizer if-converts: opt_ord_select's
// branch-free sift loses its `sel` as control flow.)
fn short_circuit(c: i64, pcx: &Ctx<Comp>) -> bool {
    if !pcx.rust_body {
        return false;
    }
    let k = pcx.nodes[c as usize].kind;
    let op = pcx.nodes[c as usize].op;
    if k == NodeKind::Binary {
        return op == Tok::AmpAmp || op == Tok::PipePipe;
    }
    k == NodeKind::Unary && op == Tok::Bang && short_circuit(pcx.nodes[c as usize].b, pcx)
}

// (0.28.0) Condition `c` as control flow: false to `f`, true to `t`. A
// short-circuit branches on each operand in turn (`a && b`: `a` false to
// `f`, else `b`; `!` swaps the targets), as MVS's lowering and rustc's
// MIR build it; any other condition is an operand switched on. 0.27.8
// made `a && b` a bool, assigned on each path, then switched on: a phi
// and a branch the optimizer did not thread, at every `if` and `while`
// with `&&` of the rust edition. The blocks it makes are entered here;
// `f` and `t` are the caller's to enter.
fn cond_into(c: i64, f: i64, t: i64, node: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[c as usize].kind;
    let op = pcx.nodes[c as usize].op;
    if k == NodeKind::Binary && (op == Tok::AmpAmp || op == Tok::PipePipe) {
        let mid = new_block(pbody);
        if op == Tok::AmpAmp {
            cond_into(pcx.nodes[c as usize].b, f, mid, node, pbody, pcx);
        } else {
            cond_into(pcx.nodes[c as usize].b, mid, t, node, pbody, pcx);
        }
        enter_block(mid, pbody);
        cond_into(pcx.nodes[c as usize].c, f, t, node, pbody, pcx);
        return;
    }
    if k == NodeKind::Unary && op == Tok::Bang && short_circuit(pcx.nodes[c as usize].b, pcx) {
        cond_into(pcx.nodes[c as usize].b, t, f, node, pbody, pcx);
        return;
    }
    if pcx.rust_body && !quiet_expr(c, pcx) {
        // RULE: D8.1 (0.28.0) an operand of `&&` or `||` is a terminating
        // scope: its value kept, its temporaries dropped, then the branch
        let tl = new_temp(pcx.nodes[c as usize].ty, c, false, pbody, pcx);
        let s = push_scope(SC_STMT, c, true, pcx);
        expr_into(c, tl, 0, pbody, pcx);
        pop_scope_at(s, pbody, pcx);
        if !reachable(pbody) {
            return;
        }
        let at = ops_mark(pbody);
        set_op(OK_COPY, tl, 0, pcx);
        push_now(pbody, pcx);
        switch_bool(at, f, t, node, pbody);
        return;
    }
    operand(c, false, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    let at = ops_mark(pbody);
    push_now(pbody, pcx);
    switch_bool(at, f, t, node, pbody);
}

fn goto(b: i64, pbody: &mut Body<Comp>) {
    terminate(TK_GOTO, b, 0, 0, 0, 0, 0, pbody);
}

fn goto_back(b: i64, pbody: &mut Body<Comp>) {
    terminate(TK_GOTO, b, 0, 1, 0, 0, 0, pbody);
}

// Struct, tuple, array and variant literals: the parts in the order they
// are written, then the aggregate in declaration order.
fn lower_aggregate(e: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[e as usize].kind;
    let ty = pcx.nodes[e as usize].ty;
    let n = pcx.nodes[e as usize].count;
    // (room for the parts in P_OPS, filled by position: what their values
    // emit goes after it; a union literal names one of its fields, and has
    // a part per field, `()` but the one written)
    let ut = undistinct(ty, pcx);
    let slots = if k == NodeKind::StructLit && is_union_type(ut, pcx) {
        crate::places::ir::struct_field_count(pcx.types[ut as usize].a, pcx)
    } else {
        n
    };
    let at = ops_mark(pbody);
    for _ in 0..slots {
        push_op(OK_UNIT, 0, TY_UNIT, pbody);
    }
    for j in 0..n {
        let mut i = j;
        let mut value = child(e, j, pcx);
        if k == NodeKind::StructLit {
            i = pcx.nodes[value as usize].x;
            value = pcx.nodes[value as usize].b;
        } else if k == NodeKind::VariantLit {
            i = crate::front::ast::field_order(e, j, pcx);
            value = child(e, i, pcx);
        }
        let capture = k == NodeKind::StructLit && pcx.rust_body && struct_closure(ty, pcx)
            && (pcx.nodes[value as usize].kind == NodeKind::Unary
                && pcx.nodes[value as usize].op == Tok::Amp
                && is_place_expr(pcx.nodes[value as usize].b, pcx)
                || pcx.nodes[value as usize].kind == NodeKind::Block && own_temp_block(value, pcx)
                && own_temp_addr(value, pcx));
        if capture {
            capture_loan(value, pbody, pcx);
        } else if pcx.agg_borrow {
            // (only this literal's parts: not those of what they contain)
            pcx.agg_borrow = false;
            operand(value, true, pbody, pcx);
            pcx.agg_borrow = true;
            if pcx.opk == OK_MOVE {
                let t = new_temp(pcx.nodes[value as usize].ty, value, true, pbody, pcx);
                set_op(OK_COPY, pcx.opa, pcx.opb, pcx);
                emit_use(t, 0, value, pbody, pcx);
                set_op(OK_COPY, t, 0, pcx);
            }
        } else if k == NodeKind::StructLit {
            arg_operand(value, true, pbody, pcx);
        } else {
            operand(value, true, pbody, pcx);
        }
        if !capture {
            settle_operand(value, j + 1 == n, pbody, pcx);
        }
        if i >= 0 && i < slots {
            pbody.ops[(at + 3 * i) as usize] = pcx.opk;
            pbody.ops[(at + 3 * i + 1) as usize] = pcx.opa;
            pbody.ops[(at + 3 * i + 2) as usize] = pcx.opb;
        }
    }
    if !reachable(pbody) {
        return;
    }
    let mut ak = AK_TUPLE;
    let mut info: i64 = 0;
    if k == NodeKind::Array {
        ak = AK_ARRAY;
    } else if k == NodeKind::StructLit {
        ak = if struct_closure(ty, pcx) { AK_CLOSURE } else { AK_STRUCT };
        info = ty;
    } else if k == NodeKind::VariantLit {
        ak = AK_VARIANT;
        info = pcx.nodes[e as usize].a;
    }
    emit(SK_ASSIGN, dl, dp, RV_AGG, ak, info, at, slots, e, pbody);
}

// RULE: D10.2 A rust-edition closure's by-reference capture `&x` (`&mut
// x` when the closure writes x), value: a loan into a temporary, `_t =
// &'c x`, moved into the closure (its field a raw pointer; the
// temporary's type `&T`, whose slot the loan's region flows into).
fn capture_loan(value: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    // (or the own pass's statement temporary standing for it, its tail the
    // `&`)
    let temp = pcx.nodes[value as usize].kind == NodeKind::Block;
    let amp = if temp { pcx.nodes[value as usize].a } else { value };
    if temp {
        own_temp_place(value, pbody, pcx);
    } else {
        as_place(pcx.nodes[value as usize].b, pbody, pcx);
    }
    let l = pcx.pl_l;
    let p = pcx.pl_p;
    let excl = (pcx.nodes[amp as usize].p & NODE_REF_MUT) != 0;
    let pointee = pcx.nodes[pcx.nodes[amp as usize].b as usize].ty;
    let t = new_temp(ref_to(pointee, if excl { REF_MUT } else { REF_SHARED }, pcx), value, false,
        pbody, pcx);
    emit_ref(t, 0, l, p, if excl { BK_MUT } else { BK_SHARED }, value, pbody, pcx);
    set_op(OK_MOVE, t, 0, pcx);
}

// `a[lo..hi]`: the base (a place, or a pointer's value), the bounds, then
// the slice.
fn lower_slicing(e: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let base = pcx.nodes[e as usize].a;
    let range = pcx.nodes[e as usize].b;
    let st = undistinct(pcx.nodes[e as usize].ty, pcx);
    if st > 0 && pcx.types[st as usize].kind == TyKind::Slice && pcx.types[st as usize].b != REF_MUT
        && !crate::front::types::is_raw_view(st, pcx) {
        shared_place(base, pbody, pcx);
    } else {
        as_place(base, pbody, pcx);
    }
    set_op(OK_PLACE, pcx.pl_l, pcx.pl_p, pcx);
    let mut at = ops_add(ops_mark(pbody), 0, pbody, pcx);
    if pcx.nodes[range as usize].a != 0 {
        operand(pcx.nodes[range as usize].a, false, pbody, pcx);
    } else {
        set_op(OK_UNIT, 0, TY_UNIT, pcx);
    }
    at = ops_add(at, 1, pbody, pcx);
    if pcx.nodes[range as usize].b != 0 {
        operand(pcx.nodes[range as usize].b, false, pbody, pcx);
    } else {
        set_op(OK_UNIT, 0, TY_UNIT, pcx);
    }
    at = ops_add(at, 2, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    emit(SK_ASSIGN, dl, dp, RV_SLICE, e, 0, at, 3, e, pbody);
}

fn lower_vecop(e: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let mut at = ops_mark(pbody);
    let mut n: i64 = 0;
    if pcx.nodes[e as usize].a != 0 {
        operand(pcx.nodes[e as usize].a, false, pbody, pcx);
        at = ops_add(at, n, pbody, pcx);
        n += 1;
    }
    for i in 0..pcx.nodes[e as usize].count {
        operand(child(e, i, pcx), false, pbody, pcx);
        at = ops_add(at, n, pbody, pcx);
        n += 1;
    }
    if !reachable(pbody) {
        return;
    }
    let mut l = dl;
    let mut p = dp;
    if l < 0 {
        l = if is_void(pcx.nodes[e as usize].ty) { unit_local(pbody, pcx) }
            else { new_temp(pcx.nodes[e as usize].ty, e, false, pbody, pcx) };
        p = 0;
    }
    emit(SK_INTRINSIC, l, p, IK_VECTOR, e, 0, at, n, e, pbody);
}

// ---- Calls ----

// (settle_operand) Whether place expression e evaluates with no statement
// of its own: a name, and `*`, `.f`, `.0` of such (an index evaluates its
// index and checks it; a call's or a block's value is made).
fn plain_place(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Ident {
        return true;
    }
    if k == NodeKind::Unary && pcx.nodes[e as usize].op == Tok::Star
        || k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        let base = if k == NodeKind::Unary { pcx.nodes[e as usize].b }
            else { pcx.nodes[e as usize].a };
        return plain_place(base, pcx);
    }
    false
}

// (lower_binary, D2.4a) Whether expression e evaluates with no statement
// that borrows or writes: a literal, a name, a place of plain_place, and
// a unary, binary or cast operator of such.
fn quiet_expr(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Int || k == NodeKind::Char || k == NodeKind::Bool || k == NodeKind::Float
        || k == NodeKind::Unit || k == NodeKind::Str || k == NodeKind::CStr || k == NodeKind::Path {
        return true;
    }
    if plain_place(e, pcx) {
        return true;
    }
    if k == NodeKind::Unary {
        let op = pcx.nodes[e as usize].op;
        return op != Tok::Amp && op != Tok::Star && quiet_expr(pcx.nodes[e as usize].b, pcx);
    }
    if k == NodeKind::Binary {
        return quiet_expr(pcx.nodes[e as usize].b, pcx) && quiet_expr(pcx.nodes[e as usize].c, pcx);
    }
    if k == NodeKind::Cast {
        return quiet_expr(pcx.nodes[e as usize].a, pcx);
    }
    false
}

// RULE: D2.4a (0.27.5) In a rust body the current operand, of expression
// e, is read where it is evaluated, as rustc's as_operand: a Copy place
// becomes `_t = copy P` here, and the statement reads `copy _t`. So a view
// or reference it reads through is dead after it (its loan ends here), and
// what is evaluated after it sees the old value. Exempt: a whole temporary
// of the builder's (no later operand names it), a whole local of a type
// with a region slot (a reference: the callee holds its loan anyway, and
// D2.7 reads the receiver it names), and, `last`, the final
// operand of its statement when it is a whole local (its value is what the
// statement takes, its region the callee's too) or reads no loan (a
// local's part with no region slot, by field and constant-index steps).
fn settle_operand(e: i64, last: bool, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !pcx.rust_body || pcx.opk != OK_COPY || pcx.opa < 0 || !reachable(pbody) {
        return;
    }
    let l = pcx.opa;
    let p = pcx.opb;
    if p == 0 && (has_flag(l, LF_TEMP, pbody)
        || crate::places::regions::slot_count(pbody.locals[l as usize].ty, pcx) > 0) {
        return;
    }
    if last && (p == 0 || !proj_indirect(p, pbody)
        && crate::places::regions::slot_count(pbody.locals[l as usize].ty, pcx) == 0) {
        return;
    }
    let ty = place_type(l, p, pbody, pcx);
    if ty <= 0 || !crate::places::regions::rust_copy(ty, pcx) {
        return;
    }
    let t = new_temp(ty, e, false, pbody, pcx);
    emit_use(t, 0, e, pbody, pcx);
    set_op(OK_COPY, t, 0, pcx);
}

// Call n: the callee value (a function value), each argument left to
// right (a `&place` a borrow of its parameter's kind: a receiver's
// exclusive borrow two-phase), then the call; a `!` result ends the block.
fn lower_call(n: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[n as usize].x - 1;
    let ty = pcx.nodes[n as usize].ty;
    let mut at = ops_mark(pbody);
    let mut count: i64 = 0;
    if f < 0 {
        operand(pcx.nodes[n as usize].a, false, pbody, pcx);
        settle_operand(pcx.nodes[n as usize].a, pcx.nodes[n as usize].count == 0, pbody, pcx);
        at = ops_add(at, count, pbody, pcx);
        count += 1;
    }
    let c_callee = f >= 0 && fn_is_extern(f, pcx);
    let mut ik: i64 = -1;
    if f >= 0 && f == pcx.check_fn {
        ik = IK_CONTRACT;
        lower_contract(n, pbody, pcx);
        if dl >= 0 && dl != unit_local(pbody, pcx) && reachable(pbody)
            && !is_void_dest(dl, dp, pbody, pcx) {
            set_op(OK_UNIT, 0, TY_UNIT, pcx);
            emit_use(dl, dp, n, pbody, pcx);
        }
        return;
    } else if f >= 0 && crate::arch::intrinsic_of_fn(f, pcx) >= 0 {
        ik = IK_ARCH;
    }
    // (a requires clause's `$pre` companion reads its arguments in place:
    // borrowed copies, the call's after it moves them)
    let pre = f >= 0 && is_pre_fn(f, pcx);
    for i in 0..pcx.nodes[n as usize].count {
        let arg = child(n, i, pcx);
        let mode = if f >= 0 { param_mode(f, i, pcx) } else { arg_mode_of(arg, pcx) };
        // (an argument past a C function's parameters: its `...`)
        let variadic = c_callee && !pre && i >= pcx.fns[f as usize].param_count;
        lower_arg(i, arg, mode, c_callee || pre, variadic, pbody, pcx);
        if pre && pcx.opk == OK_COPY && !has_flag(pcx.opa, LF_BORROWED, pbody)
            && type_glue(pcx.nodes[arg as usize].ty, pcx) {
            let t = new_temp(pcx.nodes[arg as usize].ty, arg, true, pbody, pcx);
            emit_use(t, 0, arg, pbody, pcx);
            set_op(OK_COPY, t, 0, pcx);
        } else if !pre {
            settle_operand(arg, i + 1 == pcx.nodes[n as usize].count, pbody, pcx);
        }
        at = ops_add(at, count, pbody, pcx);
        count += 1;
        if !reachable(pbody) {
            return;
        }
    }
    let mut l = dl;
    let mut p = dp;
    if l < 0 {
        l = if is_void(ty) || ty == TY_NEVER { unit_local(pbody, pcx) }
            else { new_temp(ty, n, copied_call(n, pcx), pbody, pcx) };
        p = 0;
    }
    if ik >= 0 {
        emit(SK_INTRINSIC, l, p, ik, n, 0, at, count, n, pbody);
    } else {
        emit(SK_CALL, l, p, f, 0, 0, at, count, n, pbody);
    }
    if ty == TY_NEVER {
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, n, pbody);
    }
}

// (0.26.2) A contract check, call n, `std::contract_check(COND, SITE,
// CHECK, HOLES..)` (front/contracts): each conjunct of COND (its `&&`
// chain, checks.vl conjuncts) evaluated and branched on in turn, exactly
// once on every path as `&&` evaluates it, its failing path made by
// contract_failure (which names it). The same for an assert's (whose
// condition may change state: `assert(v.pop() == x)`) as for a
// requires', ensures' or invariant's (the form entry facts read,
// middle/entryfacts.vl).
fn lower_contract(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let cmark = pcx.conjs.len() as i64;
    // (the stack taken out while conjuncts, which reads the context, fills it)
    let mut conjs: Vec<i64, Comp> = Vec::new_in(Comp {});
    std::mem::swap(&mut conjs, &mut pcx.conjs);
    crate::front::contracts::checks::conjuncts(child(n, 0, pcx), &mut conjs, pcx);
    std::mem::swap(&mut conjs, &mut pcx.conjs);
    let cend = pcx.conjs.len() as i64;
    for k in cmark..cend {
        let conj = pcx.conjs[k as usize];
        operand(conj, false, pbody, pcx);
        if !reachable(pbody) {
            break;
        }
        let pass = new_block(pbody);
        let fail = new_block(pbody);
        let at = ops_mark(pbody);
        push_now(pbody, pcx);
        let b = pbody.cur_block;
        switch_bool(at, fail, pass, conj, pbody);
        // (0.27.1: its decision, AS_UNDECIDED, reserved for 0.27.4)
        if b >= 0 {
            let term = block_term(b, pbody);
            pbody.stmts[term as usize].d = AS_CONJUNCT;
            pbody.stmts[term as usize].e = AS_UNDECIDED;
        }
        enter_block(fail, pbody);
        contract_failure(n, conj, pbody, pcx);
        enter_block(pass, pbody);
    }
    pcx.conjs.truncate(cmark as usize);
}

// The failing path of conjunct conj of contract check n, in the block
// being made: the values its report shows (the conjunct's operands, or an
// f-string message's holes, checks.vl check_values), made first as they
// may emit statements of their own, then
//     intrinsic contract_check(const false, SITE, VALUE..) [d n, e conj]
//     unreachable
// (the message is check_message's, of n's check and conj; ops[0] is the
// condition's value, false here, as an assert's was before 0.26.2).
fn contract_failure(n: i64, conj: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let smark = pcx.shown.len() as i64;
    let mut pcx_shown: Vec<i64, Comp> = Vec::new_in(Comp {});
    std::mem::swap(&mut pcx_shown, &mut pcx.shown);
    crate::front::contracts::checks::check_values(n, conj, &mut pcx_shown, pcx);
    std::mem::swap(&mut pcx_shown, &mut pcx.shown);
    let send = pcx.shown.len() as i64;
    let vals = pcx.op_hold.len() as i64;
    pcx.op_hold.push(OK_INT);
    pcx.op_hold.push(0);
    pcx.op_hold.push(TY_BOOL);
    operand(child(n, 1, pcx), false, pbody, pcx);
    pcx.op_hold.push(pcx.opk);
    pcx.op_hold.push(pcx.opa);
    pcx.op_hold.push(pcx.opb);
    for i in smark..send {
        operand(pcx.shown[i as usize], false, pbody, pcx);
        pcx.op_hold.push(pcx.opk);
        pcx.op_hold.push(pcx.opa);
        pcx.op_hold.push(pcx.opb);
    }
    pcx.shown.truncate(smark as usize);
    let count = (pcx.op_hold.len() as i64 - vals) / 3;
    let at = ops_mark(pbody);
    for j in 0..count {
        push_op(pcx.op_hold[(vals + 3 * j) as usize], pcx.op_hold[(vals + 3 * j + 1) as usize],
            pcx.op_hold[(vals + 3 * j + 2) as usize], pbody);
    }
    pcx.op_hold.truncate(vals as usize);
    if reachable(pbody) {
        emit(SK_INTRINSIC, unit_local(pbody, pcx), 0, IK_CONTRACT, n, conj, at, count, conj,
            pbody);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, conj, pbody);
    }
}

// The mode of an argument of a call through a function value: by its type.
fn arg_mode_of(arg: i64, pcx: &Ctx<Comp>) -> i64 {
    let t = undistinct(pcx.nodes[arg as usize].ty, pcx);
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        return if pcx.types[t as usize].b == REF_SHARED { crate::front::kinds::P_SHARED }
            else if pcx.types[t as usize].b == REF_MUT { P_MUT } else { P_RAW };
    }
    P_VALUE
}

// Argument i (node arg) of call n: its operand (OPK..).
fn lower_arg(i: i64, arg: i64, mode: i64, c_callee: bool, variadic: bool, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[arg as usize].kind;
    let temp = k == NodeKind::Block && own_temp_block(arg, pcx) && own_temp_addr(arg, pcx);
    if k == NodeKind::Unary && pcx.nodes[arg as usize].op == Tok::Amp || temp {
        // (`&value` lent, the own pass's temporary's block: `&e`)
        let operand_e = if temp { own_temp_value(arg, pcx) } else { pcx.nodes[arg as usize].b };
        let at_ty = undistinct(pcx.nodes[arg as usize].ty, pcx);
        if temp {
            own_temp_place(arg, pbody, pcx);
        } else {
            as_place(operand_e, pbody, pcx);
        }
        let pl = pcx.pl_l;
        let pp = pcx.pl_p;
        let mut kind = BK_SHARED;
        // (0.27.1) a rust-edition call of a closure value: its env is a
        // reborrow of the closure, `&'e c` (Fn) or `&'e mut2 c` (FnMut, a
        // receiver), into a temporary of that reference type (D10.3)
        let env = pcx.rust_body && i == 0 && !c_callee && at_ty > 0
            && pcx.types[at_ty as usize].kind == TyKind::Ptr && pcx.types[at_ty as usize].b == 0
            && struct_closure(pcx.types[at_ty as usize].a, pcx);
        let mut t_ty = at_ty;
        let mut pl = pl;
        let mut pp = pp;
        if env && !crate::places::regions::closure_once(pcx.types[at_ty as usize].a, pcx)
            && pcx.nodes[operand_e as usize].kind == NodeKind::Ident
            && pcx.nodes[operand_e as usize].res == Res::Local
            && crate::front::closures::fn_bounds::param_call_kind(pbody.fn_,
                pcx.nodes[operand_e as usize].y,
                pcx) == crate::front::closures::kinds::KIND_FN_ONCE {
            // RULE: D19.5 (an `Fn`/`FnMut` closure called as the `FnOnce` its
            // parameter is bound by: moved into a temporary of the call,
            // `_t = move Q`, which the env borrows and the statement drops)
            let c_ty = pcx.types[at_ty as usize].a;
            place_operand(pl, pp, c_ty, true, pbody, pcx);
            let tc = new_temp(c_ty, arg, false, pbody, pcx);
            emit_use(tc, 0, arg, pbody, pcx);
            pl = tc;
            pp = 0;
        }
        if env && crate::places::regions::closure_once(pcx.types[at_ty as usize].a, pcx) {
            // RULE: D19.5, D19.7 an `FnOnce` closure's env is the closure
            // itself, moved (copied when it is Copy)
            place_operand(pl, pp, pcx.types[at_ty as usize].a, true, pbody, pcx);
            return;
        }
        if env {
            let fnmut = crate::places::regions::closure_writes(pcx.types[at_ty as usize].a, pcx);
            kind = if fnmut { BK_MUT2 } else { BK_SHARED };
            t_ty = ref_to(pcx.types[at_ty as usize].a, if fnmut { REF_MUT } else { REF_SHARED },
                pcx);
        }
        else if c_callee || mode == P_RAW
            || at_ty > 0 && pcx.types[at_ty as usize].kind == TyKind::Ptr
            && pcx.types[at_ty as usize].b == 0 {
            // (0.27.1: `&mut x` given as a `*mut T`, the rust edition's, D2.2)
            kind = if mode == P_MUT || (pcx.nodes[arg as usize].p & NODE_REF_MUT) != 0 {
                BK_RAW_MUT
            } else { BK_RAW };
        } else if mode == P_MUT || (pcx.nodes[arg as usize].p & NODE_REF_MUT) != 0 {
            let receiver = i == 0
                && pcx.nodes[arg as usize].start == pcx.nodes[operand_e as usize].start;
            kind = if receiver { BK_MUT2 } else { BK_MUT };
        }
        let t = new_temp(t_ty, arg, false, pbody, pcx);
        emit_ref(t, 0, pl, pp, kind, arg, pbody, pcx);
        set_op(OK_MOVE, t, 0, pcx);
        return;
    }
    // (a value: moved into a by-value parameter; read where the callee
    // only reads it: a raw or C parameter, a view)
    let moving = mode == P_VALUE && !c_callee;
    arg_operand(arg, moving, pbody, pcx);
    if variadic && pcx.rust_body && pcx.opk == OK_COPY && is_place_expr(arg, pcx) {
        // RULE: D3.6 (0.28.0) a `&mut T` place given to a C variadic's
        // `...` is moved, as rustc's: no parameter type makes the argument
        // a coercion site, so it is not reborrowed (a later use is
        // borrowck.use_moved, rustc's E0382). 0.27.8 copied it (I7).
        let vt = undistinct(place_type(pcx.opa, pcx.opb, pbody, pcx), pcx);
        if vt > 0 && pcx.types[vt as usize].kind == TyKind::Ptr
            && pcx.types[vt as usize].b == REF_MUT {
            pcx.opk = OK_MOVE;
        }
    }
    // (the place's own type: the argument's is the parameter's after a
    // coercion, `&T` of a `&mut T`)
    let place = pcx.rust_body && !c_callee && is_place_expr(arg, pcx)
        && (pcx.opk == OK_MOVE || pcx.opk == OK_COPY);
    let arg_ty: i64 = if place { undistinct(place_type(pcx.opa, pcx.opb, pbody, pcx), pcx) }
        else { 0 };
    if place && arg_ty > 0
        && pcx.types[arg_ty as usize].kind == TyKind::Ptr
        && pcx.types[arg_ty as usize].b == REF_MUT {
        // RULE: D3.6 (0.27.1) a `&mut T` place given to a call is
        // reborrowed, `_t = &mut2 (*r)`: two-phase as rustc's implicit
        // reborrow (D7.4); `_t = &(*r)` for a `&T` parameter (the
        // coercion); the place is neither moved nor copied (I7)
        // RULE: D3.6 (0.27.6: given where a raw pointer goes, the reborrow
        // is raw, `&raw mut (*r)`: no loan, it ends at the coercion)
        if mode == P_RAW {
            let t = new_temp(pcx.nodes[arg as usize].ty, arg, false, pbody, pcx);
            let p = proj(pcx.opb, PJ_DEREF, 0, pbody);
            emit_ref(t, 0, pcx.opa, p, BK_RAW_MUT, arg, pbody, pcx);
            set_op(OK_MOVE, t, 0, pcx);
            return;
        }
        let exclusive = mode == P_MUT || mode == P_VALUE;
        let t = new_temp(if exclusive { arg_ty }
            else { ref_to(pcx.types[arg_ty as usize].a, REF_SHARED, pcx) },
            arg, false, pbody, pcx);
        let p = proj(pcx.opb, PJ_DEREF, 0, pbody);
        emit_ref(t, 0, pcx.opa, p, if exclusive { BK_MUT2 } else { BK_SHARED }, arg, pbody, pcx);
        set_op(OK_MOVE, t, 0, pcx);
        return;
    }
    if pcx.rust_body && pcx.opk == OK_MOVE && is_place_expr(arg, pcx) {
        // (0.27.1: a place moved into the call gets its own statement at
        // the argument, `_t = move v`, as rustc's MIR: the borrow
        // checker's errors name the argument, not the call)
        let t = new_temp(pcx.nodes[arg as usize].ty, arg, false, pbody, pcx);
        emit_use(t, 0, arg, pbody, pcx);
        set_op(OK_MOVE, t, 0, pcx);
    }
}

// ---- Assignment ----

// `p = v` and `p op= v`: the value first, then the place, then the write
// (the old value is not dropped: the own pass's desugaring is what drops,
// lower_own_assign).
fn lower_assign(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let op = pcx.nodes[n as usize].op;
    let target = pcx.nodes[n as usize].b;
    let value = pcx.nodes[n as usize].c;
    if op == Tok::Eq {
        operand(value, true, pbody, pcx);
        // (the place is evaluated after the value: a plain one emits nothing,
        // and the write meets no loan the value reads through)
        if !plain_place(target, pcx) {
            settle_operand(value, false, pbody, pcx);
        }
        if !reachable(pbody) {
            return;
        }
        let ok = pcx.opk;
        let oa = pcx.opa;
        let ob = pcx.opb;
        if !place_of(target, pbody, pcx) {
            unsupported(target, pcx);
            return;
        }
        set_op(ok, oa, ob, pcx);
        emit_use(pcx.pl_l, pcx.pl_p, n, pbody, pcx);
        return;
    }
    // `p op= v`: p = p op v, the value first
    operand(value, false, pbody, pcx);
    if !plain_place(target, pcx) {
        settle_operand(value, false, pbody, pcx);
    }
    let vk = pcx.opk;
    let va = pcx.opa;
    let vb = pcx.opb;
    if !reachable(pbody) || !place_of(target, pbody, pcx) {
        return;
    }
    let at = ops_mark(pbody);
    set_op(OK_COPY, pcx.pl_l, pcx.pl_p, pcx);
    push_now(pbody, pcx);
    set_op(vk, va, vb, pcx);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, pcx.pl_l, pcx.pl_p,
        binary_rv(bo_of(op), pcx.nodes[target as usize].ty, pbody, pcx), bo_of(op), n, at, 2, n,
        pbody);
}

// (0.26.2) An assignment: `p = v` on an owned place drops p's old value
// wherever it stands (a statement, a block's tail, an arm's value, inside
// an expression: Rust's rule; 0.25's own pass dropped it only at the first
// two, and leaked it elsewhere), `tmp = v; drop(p); p = move tmp` (§3.8:
// the right side, then the place and its index, then the old value's
// drop, then the write; the right side's temporaries at the statement's
// end, ea70255c), elaboration deciding the drop (removed where p is moved,
// under a flag where it may be); drops_old says which.
fn lower_assign_at(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !drops_old(n, pcx) {
        lower_assign(n, pbody, pcx);
        return;
    }
    let target = pcx.nodes[n as usize].b;
    let value = pcx.nodes[n as usize].c;
    let tmp = new_temp(pcx.nodes[value as usize].ty, n, false, pbody, pcx);
    expr_into(value, tmp, 0, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    if !place_of(target, pbody, pcx) {
        unsupported(target, pcx);
        return;
    }
    emit(SK_DROP, pcx.pl_l, pcx.pl_p, DS_UNDECIDED, -1, -1, 0, 0, n, pbody);
    set_op(OK_MOVE, tmp, 0, pcx);
    emit_use(pcx.pl_l, pcx.pl_p, n, pbody, pcx);
}

// Whether assignment n drops the old value: `=` (not one the checker
// writes without a drop, NO_DROP) of a value with glue to a place of names,
// fields, `*` and indexes (not one a call makes, nor a raw access,
// NODE_RAW), with drops on.
fn drops_old(n: i64, pcx: &mut Ctx<Comp>) -> bool {
    if pcx.nodes[n as usize].op != Tok::Eq
        || (pcx.nodes[n as usize].p & NO_DROP) != 0 {
        return false;
    }
    let target = pcx.nodes[n as usize].b;
    target != 0 && pcx.nodes[n as usize].c != 0 && pcx.nodes[target as usize].ty > 0
        && type_glue(pcx.nodes[target as usize].ty, pcx) && indexable_place(target, pcx)
}

// ---- Control flow ----

fn lower_return(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let v = pcx.nodes[n as usize].a;
    if v != 0 {
        expr_into(v, 0, 0, pbody, pcx);
    }
    if !reachable(pbody) {
        return;
    }
    exit_to(0, n, pbody, pcx);
    goto(pcx.ret_block, pbody);
}

fn lower_break(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = loop_scope(pcx.nodes[n as usize].x, pcx);
    if s < 0 {
        unsupported(n, pcx);
        return;
    }
    let v = pcx.nodes[n as usize].b;
    if v != 0 {
        let rl = pcx.build_scopes[(s * SW + 5) as usize];
        if rl >= 0 {
            expr_into(v, rl, pcx.build_scopes[(s * SW + 6) as usize], pbody, pcx);
        } else {
            expr_into(v, -1, 0, pbody, pcx);
        }
    }
    if !reachable(pbody) {
        return;
    }
    exit_to(s + 1, n, pbody, pcx);
    goto(pcx.build_scopes[(s * SW + 3) as usize], pbody);
}

fn lower_continue(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = loop_scope(pcx.nodes[n as usize].x, pcx);
    if s < 0 {
        unsupported(n, pcx);
        return;
    }
    exit_to(s + 1, n, pbody, pcx);
    if pcx.build_scopes[(s * SW + 7) as usize] != 0 {
        goto_back(pcx.build_scopes[(s * SW + 4) as usize], pbody);
    } else {
        goto(pcx.build_scopes[(s * SW + 4) as usize], pbody);
    }
}

fn lower_if(n: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let fixed = crate::front::features::static_condition(pcx.nodes[n as usize].a, pcx);
    if fixed >= 0 {
        let live = if fixed == 1 { pcx.nodes[n as usize].b } else { pcx.nodes[n as usize].c };
        if live != 0 {
            expr_into(live, dl, dp, pbody, pcx);
        }
        return;
    }
    let has_else = pcx.nodes[n as usize].c != 0;
    let mut then_b: i64 = -1;
    let mut else_b: i64 = -1;
    let mut join: i64 = -1;
    if short_circuit(pcx.nodes[n as usize].a, pcx) {
        then_b = new_block(pbody);
        else_b = if has_else { new_block(pbody) } else { -1 };
        join = new_block(pbody);
        cond_into(pcx.nodes[n as usize].a, if has_else { else_b } else { join }, then_b, n, pbody,
            pcx);
    } else {
        operand(pcx.nodes[n as usize].a, false, pbody, pcx);
        if !reachable(pbody) {
            return;
        }
        then_b = new_block(pbody);
        else_b = if has_else { new_block(pbody) } else { -1 };
        join = new_block(pbody);
        let at = ops_mark(pbody);
        push_now(pbody, pcx);
        switch_bool(at, if has_else { else_b } else { join }, then_b, n, pbody);
    }
    enter_block(then_b, pbody);
    expr_into(pcx.nodes[n as usize].b, dl, dp, pbody, pcx);
    if reachable(pbody) {
        goto(join, pbody);
    }
    if has_else {
        enter_block(else_b, pbody);
        expr_into(pcx.nodes[n as usize].c, dl, dp, pbody, pcx);
        if reachable(pbody) {
            goto(join, pbody);
        }
    }
    enter_block(join, pbody);
}

// `loop` and `while`: a header block; the body's scopes; `break` to the
// exit, `continue` to the header (a back edge).
fn lower_loop(n: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let head = new_block(pbody);
    let exit = new_block(pbody);
    goto(head, pbody);
    enter_block(head, pbody);
    let s = push_scope(SC_LOOP, n, false, pcx);
    pcx.build_scopes[(s * SW + 2) as usize] = n;
    pcx.build_scopes[(s * SW + 3) as usize] = exit;
    pcx.build_scopes[(s * SW + 4) as usize] = head;
    pcx.build_scopes[(s * SW + 5) as usize] = dl;
    pcx.build_scopes[(s * SW + 6) as usize] = dp;
    // (`continue` takes the back edge of an uncounted loop)
    pcx.build_scopes[(s * SW + 7) as usize] = 1;
    if pcx.nodes[n as usize].kind == NodeKind::While {
        // (the condition is a unit of its own: its temporaries drop when
        // it is evaluated)
        let c = push_scope(SC_STMT, n, true, pcx);
        let mut body: i64 = -1;
        let mut out: i64 = -1;
        if short_circuit(pcx.nodes[n as usize].b, pcx) {
            body = new_block(pbody);
            out = new_block(pbody);
            cond_into(pcx.nodes[n as usize].b, out, body, n, pbody, pcx);
        } else {
            operand(pcx.nodes[n as usize].b, false, pbody, pcx);
            let at = ops_mark(pbody);
            push_now(pbody, pcx);
            body = new_block(pbody);
            out = new_block(pbody);
            // (the condition's temporaries end on both edges)
            switch_bool(at, out, body, n, pbody);
        }
        enter_block(out, pbody);
        emit_scope(c, pbody, pcx);
        goto(exit, pbody);
        enter_block(body, pbody);
        pop_scope_at(c, pbody, pcx);
        expr_into(pcx.nodes[n as usize].c, -1, 0, pbody, pcx);
    } else {
        expr_into(pcx.nodes[n as usize].b, -1, 0, pbody, pcx);
    }
    if reachable(pbody) {
        goto_back(head, pbody);
    }
    pop_scope_at(s, pbody, pcx);
    enter_block(exit, pbody);
    if pcx.nodes[n as usize].kind == NodeKind::While && dl >= 0 && dl != unit_local(pbody, pcx) {
        // (a `while` is `()`)
        set_op(OK_UNIT, 0, TY_UNIT, pcx);
        emit_use(dl, dp, n, pbody, pcx);
    }
}

// `for p in a..b` (the counted form the checker leaves): the bounds once,
// the counter's copy bound each round; `continue` to the increment.
fn lower_for(n: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let range = pcx.nodes[n as usize].c;
    let rt = pcx.nodes[range as usize].ty;
    let inclusive = pcx.nodes[range as usize].c != 0;
    operand(pcx.nodes[range as usize].a, false, pbody, pcx);
    let counter = new_temp(rt, n, false, pbody, pcx);
    emit_use(counter, 0, n, pbody, pcx);
    operand(pcx.nodes[range as usize].b, false, pbody, pcx);
    let end = new_temp(rt, n, false, pbody, pcx);
    emit_use(end, 0, n, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    let test = new_block(pbody);
    let body = new_block(pbody);
    let next = new_block(pbody);
    let exit = new_block(pbody);
    goto(test, pbody);
    enter_block(test, pbody);
    let cmp = new_temp(TY_BOOL, n, false, pbody, pcx);
    let at = ops_mark(pbody);
    set_op(OK_COPY, counter, 0, pcx);
    push_now(pbody, pcx);
    set_op(OK_COPY, end, 0, pcx);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, cmp, 0, RV_BINARY, if inclusive { BO_LE } else { BO_LT }, n, at, 2, n, pbody);
    let at2 = ops_mark(pbody);
    set_op(OK_COPY, cmp, 0, pcx);
    push_now(pbody, pcx);
    switch_bool(at2, exit, body, n, pbody);
    enter_block(body, pbody);
    let s = push_scope(SC_LOOP, n, false, pcx);
    pcx.build_scopes[(s * SW + 2) as usize] = n;
    pcx.build_scopes[(s * SW + 3) as usize] = exit;
    pcx.build_scopes[(s * SW + 4) as usize] = next;
    let arm = push_scope(SC_ARM, n, false, pcx);
    let pat = pcx.nodes[n as usize].b;
    if pcx.nodes[pat as usize].kind == NodeKind::PatBind && pcx.nodes[pat as usize].x >= 0 {
        let l = user_local(pcx.nodes[pat as usize].x, pat, false, pbody, pcx);
        live(l, pbody, pcx);
        schedule(EN_DEAD, l, pbody, pcx);
        set_op(OK_COPY, counter, 0, pcx);
        emit_use(l, 0, pat, pbody, pcx);
    } else if pcx.nodes[pat as usize].kind != NodeKind::PatWild {
        unsupported(pat, pcx);
    }
    expr_into(pcx.nodes[n as usize].d, -1, 0, pbody, pcx);
    pop_scope_at(arm, pbody, pcx);
    if reachable(pbody) {
        goto(next, pbody);
    }
    pop_scope_at(s, pbody, pcx);
    enter_block(next, pbody);
    if inclusive {
        // (the last round: counter == end)
        let last = new_temp(TY_BOOL, n, false, pbody, pcx);
        let at3 = ops_mark(pbody);
        set_op(OK_COPY, counter, 0, pcx);
        push_now(pbody, pcx);
        set_op(OK_COPY, end, 0, pcx);
        push_now(pbody, pcx);
        emit(SK_ASSIGN, last, 0, RV_BINARY, BO_EQ, n, at3, 2, n, pbody);
        let at4 = ops_mark(pbody);
        set_op(OK_COPY, last, 0, pcx);
        push_now(pbody, pcx);
        let inc = new_block(pbody);
        switch_bool(at4, inc, exit, n, pbody);
        enter_block(inc, pbody);
    }
    let at5 = ops_mark(pbody);
    set_op(OK_COPY, counter, 0, pcx);
    push_now(pbody, pcx);
    set_op(OK_INT, 1, rt, pcx);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, counter, 0, RV_BINARY, BO_ADD, n, at5, 2, n, pbody);
    goto(test, pbody);
    enter_block(exit, pbody);
}

// ---- match and patterns ----

// `match`: the scrutinee's place (a temporary of the statement when it is
// a value), then each arm in order: its pattern tested (a branch to the
// next arm on a mismatch), its guard evaluated with the bindings as
// borrowed copies, then the bindings made (moved out, unless the own pass
// made them borrow) and the body; no arm matching is unreachable.
fn lower_match(n: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let scrut = pcx.nodes[n as usize].a;
    let st = pcx.nodes[scrut as usize].ty;
    let cond = scrutinee_scope(n, pcx);
    let h = if cond != 0 { push_scope(SC_STMT, n, true, pcx) } else { -1 };
    let mut kept: Vec<i64, Comp> = Vec::new_in(Comp {});
    scrutinee_place(scrut, pbody, pcx);
    if !reachable(pbody) || st == TY_NEVER {
        end_scrutinee(h, &mut kept, false, pbody, pcx);
        return;
    }
    let sl = pcx.pl_l;
    let sp = pcx.pl_p;
    if switch_cases(n, st, pcx) {
        lower_match_switch(n, st, sl, sp, dl, dp, h, &mut kept, pbody, pcx);
        keep_scrutinee(&kept, pbody, pcx);
        return;
    }
    let join = new_block(pbody);
    // (0.27.1) a rust-edition match with a guard: its fake loans, made
    // before the first test, mentioned at each arm body's entry (D2.6)
    let mut fakes: Vec<i64, Comp> = Vec::new_in(Comp {});
    if pcx.rust_body
        && (0i64..pcx.nodes[n as usize].count).any(|i| pcx.nodes[child(n, i, pcx) as usize].b != 0) {
        fake_borrows(n, sl, sp, st, &mut fakes, pbody, pcx);
    }
    for i in 0..pcx.nodes[n as usize].count {
        let arm = child(n, i, pcx);
        let pat = pcx.nodes[arm as usize].a;
        let fail = new_block(pbody);
        let s = push_scope(SC_ARM, arm, false, pcx);
        test_pattern(pat, sl, sp, st, fail, pbody, pcx);
        let guard = pcx.nodes[arm as usize].b;
        if guard != 0 && reachable(pbody) {
            phase_begin(-1, pcx);
            bind_pattern(pat, sl, sp, st, true, pbody, pcx);
            let g = push_scope(SC_STMT, guard, false, pcx);
            if short_circuit(guard, pcx) {
                // (0.28.0) a guard `a && b` branches on each operand
                let ok = new_block(pbody);
                let refused = new_block(pbody);
                cond_into(guard, refused, ok, arm, pbody, pcx);
                enter_block(refused, pbody);
                exit_to(s, arm, pbody, pcx);
                goto(fail, pbody);
                enter_block(ok, pbody);
            } else {
                operand(guard, false, pbody, pcx);
            }
            if !short_circuit(guard, pcx) && reachable(pbody) {
                let at = ops_mark(pbody);
                push_now(pbody, pcx);
                let ok = new_block(pbody);
                let refused = new_block(pbody);
                switch_bool(at, refused, ok, arm, pbody);
                enter_block(refused, pbody);
                exit_to(s, arm, pbody, pcx);
                goto(fail, pbody);
                enter_block(ok, pbody);
            }
            pop_scope_at(g, pbody, pcx);
        }
        if reachable(pbody) {
            for f in fakes.iter().copied() {
                emit(SK_MENTION, f, 0, 0, 0, 0, 0, 0, arm, pbody);
            }
            phase_begin(-1, pcx);
            bind_pattern(pat, sl, sp, st, false, pbody, pcx);
            expr_into(pcx.nodes[arm as usize].c, dl, dp, pbody, pcx);
        }
        pop_scope_at(s, pbody, pcx);
        if reachable(pbody) {
            if cond == 1 && i == 0 {
                // (an `if let`: at the end of the matching block)
                exit_to(h, arm, pbody, pcx);
            }
            goto(join, pbody);
        }
        enter_block(fail, pbody);
        if i == 0 {
            end_scrutinee(h, &mut kept, cond == 2, pbody, pcx);
        }
    }
    terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, n, pbody);
    enter_block(join, pbody);
    keep_scrutinee(&kept, pbody, pcx);
}

// RULE: D2.6 The fake loans of a rust-edition match n with a guard, its
// scrutinee at (sl, sp) of type st: `_t = &fake S` for the scrutinee's
// place and for every place a pattern tests, before the first test; the
// temporaries in fakes (mentioned at each arm body's entry).
fn fake_borrows(n: i64, sl: i64, sp: i64, st: i64, fakes: &mut Vec<i64, Comp>,
    pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let mut places: Vec<i64, Comp> = Vec::new_in(Comp {});
    places.push(sp);
    places.push(st);
    for i in 0..pcx.nodes[n as usize].count {
        tested_places(pcx.nodes[child(n, i, pcx) as usize].a, sp, st, &mut places, pbody, pcx);
    }
    let mut i: i64 = 0;
    while i < places.len() as i64 {
        let p = places[i as usize];
        let mut seen = false;
        let mut j: i64 = 0;
        while j < i {
            seen = seen || places[j as usize] == p;
            j += 2;
        }
        if !seen {
            let f = new_temp(ref_to(places[(i + 1) as usize], REF_SHARED, pcx), n, false, pbody,
                pcx);
            emit_ref(f, 0, sl, p, BK_FAKE, n, pbody, pcx);
            fakes.push(f);
        }
        i += 2;
    }
}

// The places pattern pat tests, given a place p of type ty, as
// test_pattern reads them: a literal's or a range's, a variant's (its
// discriminant); pairs (projection, type) pushed to out.
fn tested_places(pat: i64, p: i64, ty: i64, out: &mut Vec<i64, Comp>, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    if ty == TY_NEVER {
        return;
    }
    let mut pp = p;
    let mut t = ty;
    let inner = pattern_referent(pat, t, pcx);
    if inner != 0 {
        pp = proj(pp, PJ_DEREF, 0, pbody);
        t = inner;
    }
    let k = pcx.nodes[pat as usize].kind;
    if k == NodeKind::PatLit || k == NodeKind::PatRange || k == NodeKind::PatVariant {
        out.push(pp);
        out.push(t);
    }
    if k == NodeKind::PatOr {
        for i in 0..pcx.nodes[pat as usize].count {
            tested_places(child(pat, i, pcx), pp, t, out, pbody, pcx);
        }
    } else if k == NodeKind::PatTuple {
        let tt = undistinct(t, pcx);
        for i in 0..pcx.nodes[pat as usize].count {
            tested_places(child(pat, i, pcx), proj(pp, PJ_FIELD, i, pbody),
                crate::front::types::part_type(tt, i, pcx), out, pbody, pcx);
        }
    } else if k == NodeKind::PatVariant {
        let v = pcx.nodes[pat as usize].x;
        let vp = proj(pp, PJ_VARIANT, v, pbody);
        for i in 0..pcx.nodes[pat as usize].count {
            tested_places(child(pat, i, pcx), proj(vp, PJ_FIELD, i, pbody),
                variant_field(v, i, pcx), out, pbody, pcx);
        }
    }
}

// Whether match n on a value of type st is one switch (R4, as
// middle/lower/matching.vl's switch_cases): no guards; an integer
// scrutinee matched against literals, ranges and their alternatives, or
// an enum (not one with the null niche) matched by variant, whose fields
// only bind; a wildcard or binding, if any, the last arm; at least 6
// values, or 4 for an enum with fields. Fills SW_CASES and SW_DEFAULT.
fn switch_cases(n: i64, st: i64, pcx: &mut Ctx<Comp>) -> bool {
    let count = pcx.nodes[n as usize].count;
    pcx.sw_inner = -1;
    for i in 0..count {
        let p = pcx.nodes[child(n, i, pcx) as usize].a;
        let kind = pcx.nodes[p as usize].kind;
        if kind != NodeKind::PatWild && kind != NodeKind::PatBind {
            let r = pattern_referent(p, st, pcx);
            if pcx.sw_inner >= 0 && r != pcx.sw_inner {
                return false;
            }
            pcx.sw_inner = r;
        }
    }
    let t = undistinct(if pcx.sw_inner > 0 { pcx.sw_inner } else { st }, pcx);
    if t <= 0 {
        return false;
    }
    let integer = is_integer(t);
    let is_enum = pcx.types[t as usize].kind == TyKind::Enum;
    if !integer && !is_enum || is_enum && enum_niche(pcx.types[t as usize].a, pcx) {
        return false;
    }
    pcx.sw_cases.clear();
    pcx.sw_default = -1;
    for i in 0..count {
        let arm = child(n, i, pcx);
        let p = pcx.nodes[arm as usize].a;
        if pcx.nodes[arm as usize].b != 0 {
            return false;
        }
        let kind = pcx.nodes[p as usize].kind;
        if kind == NodeKind::PatWild || kind == NodeKind::PatBind {
            if i != count - 1 {
                return false;
            }
            pcx.sw_default = i;
        } else if !add_switch_values(p, i, t, integer, pcx) {
            return false;
        }
    }
    let cases = pcx.sw_cases.len() as i64 / 2;
    cases >= 6 || is_enum && is_compound(t, pcx) && cases >= 4
}

// Adds the values pattern p matches (for arm `arm`, unless an earlier arm
// has them) of the integer or enum type t; false when p is not a set of
// values.
fn add_switch_values(p: i64, arm: i64, t: i64, integer: bool, pcx: &mut Ctx<Comp>) -> bool {
    let kind = pcx.nodes[p as usize].kind;
    if kind == NodeKind::PatLit && integer {
        add_switch_value(pcx.nodes[p as usize].x, arm, pcx);
        return true;
    }
    if kind == NodeKind::PatRange && integer {
        let lo = int_key(pcx.nodes[p as usize].x, t);
        let hi = int_key(pcx.nodes[p as usize].y, t);
        // (wrapped, a range past 2^63 values is at most 0: refused)
        let count: i64 = if hi < lo { 0 } else { hi.wrapping_sub(lo).wrapping_add(1) };
        if count < 1 || count > 256 || pcx.sw_cases.len() as i64 + 2 * count > 2048 {
            return false;
        }
        for k in 0..count {
            add_switch_value(wrap_int(pcx.nodes[p as usize].x + k, t), arm, pcx);
        }
        return true;
    }
    if kind == NodeKind::PatVariant && !integer {
        for i in 0..pcx.nodes[p as usize].count {
            if !is_irrefutable(child(p, i, pcx), pcx) {
                return false;
            }
        }
        add_switch_value(variant_discr(pcx.nodes[p as usize].x, pcx), arm, pcx);
        return true;
    }
    if kind == NodeKind::PatOr && binding_count(p, pcx) == 0 {
        for i in 0..pcx.nodes[p as usize].count {
            if !add_switch_values(child(p, i, pcx), arm, t, integer, pcx) {
                return false;
            }
        }
        return true;
    }
    false
}

fn add_switch_value(value: i64, arm: i64, pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < pcx.sw_cases.len() as i64 {
        if pcx.sw_cases[i as usize] == value {
            return;
        }
        i += 2;
    }
    pcx.sw_cases.push(value);
    pcx.sw_cases.push(arm);
}

// Match n, its scrutinee at (sl, sp) of type st, as one switch (R4; after
// switch_cases said it is one): `switch copy P` for an integer, `_d =
// discriminant P; switch copy _d` for an enum (P is `*(sl, sp)` when the
// arms match through the reference, SW_INNER), a target per value; every
// arm in a block of its own that binds and lowers the body. An enum's arm
// with several values is reached through a block per value (a goto to
// the arm's): elaboration learns the variant of P from the edge of a
// target with one value.
fn lower_match_switch(n: i64, st: i64, sl: i64, sp: i64, dl: i64, dp: i64, h: i64,
    kept: &mut Vec<i64, Comp>, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let inner = pcx.sw_inner;
    let t = undistinct(if inner > 0 { inner } else { st }, pcx);
    let pp = if inner > 0 { proj(sp, PJ_DEREF, 0, pbody) } else { sp };
    let integer = is_integer(t);
    let mut at: i64 = 0;
    if integer {
        at = ops_mark(pbody);
        set_op(OK_COPY, sl, pp, pcx);
        push_now(pbody, pcx);
    } else {
        let d = new_local(enum_tag_ty(t, pcx), LF_TEMP, -1, n, pbody);
        let a0 = ops_mark(pbody);
        set_op(OK_PLACE, sl, pp, pcx);
        push_now(pbody, pcx);
        emit(SK_ASSIGN, d, 0, RV_DISCR, 0, 0, a0, 1, n, pbody);
        at = ops_mark(pbody);
        set_op(OK_COPY, d, 0, pcx);
        push_now(pbody, pcx);
    }
    let join = new_block(pbody);
    let count = pcx.nodes[n as usize].count;
    let first = new_block(pbody);
    for _ in 1..count {
        new_block(pbody);
    }
    let mut default: i64 = -1;
    if pcx.sw_default >= 0 {
        default = first + pcx.sw_default;
    } else {
        default = new_block(pbody);
    }
    let cases = pcx.sw_cases.len() as i64 / 2;
    let ti = pbody.targets.len() as i64;
    for c in 0..cases {
        let arm = pcx.sw_cases[(2 * c + 1) as usize];
        let mut many = false;
        if !integer {
            for o in 0..cases {
                many = many || o != c && pcx.sw_cases[(2 * o + 1) as usize] == arm;
            }
        }
        pbody.targets.push(pcx.sw_cases[(2 * c) as usize]);
        let pbody_arg = if many { new_block(pbody) } else { first + arm };
        pbody.targets.push(pbody_arg);
    }
    terminate(TK_SWITCH, ti, cases, default, at, 1, n, pbody);
    for c in 0..cases {
        let arm = pcx.sw_cases[(2 * c + 1) as usize];
        let target = pbody.targets[(ti + 2 * c + 1) as usize];
        if target != first + arm {
            enter_block(target, pbody);
            goto(first + arm, pbody);
        }
    }
    let catch_all = pcx.sw_default;
    // (the scrutinee's scope h, of an `if let` or a let-else: lower_match)
    let cond = if h >= 0 { scrutinee_scope(n, pcx) } else { 0 };
    for i in 0..count {
        let arm = child(n, i, pcx);
        enter_block(first + i, pbody);
        if i == 1 {
            end_scrutinee(h, kept, cond == 2, pbody, pcx);
        }
        let s = push_scope(SC_ARM, arm, false, pcx);
        phase_begin(-1, pcx);
        bind_pattern(pcx.nodes[arm as usize].a, sl, sp, st, false, pbody, pcx);
        expr_into(pcx.nodes[arm as usize].c, dl, dp, pbody, pcx);
        pop_scope_at(s, pbody, pcx);
        if reachable(pbody) {
            if cond == 1 && i == 0 {
                exit_to(h, arm, pbody, pcx);
            }
            goto(join, pbody);
        }
    }
    if catch_all < 0 {
        enter_block(default, pbody);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, n, pbody);
    }
    enter_block(join, pbody);
}

// (0.29.0; borrowck.md L3) The scope of an `if let`'s or a let-else's
// scrutinee, for match n: 1 for an `if let` (rustc's rule from its 2024
// edition, "if let temporary scope": the scrutinee's temporaries are
// dropped before the else block, and at the end of the matching block,
// not at the end of the statement), 2 for `let P = e else { .. }` (before
// the else block, in every edition; on a match they stay the `let`'s), 0
// for a `match`, a `while let` (its loop body's block ends them at each
// iteration and at its `break`) and the checker's desugarings (`?`, a
// `for`): their temporaries are the statement's.
fn scrutinee_scope(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[n as usize].count != 2 {
        return 0;
    }
    let p = pcx.nodes[child(n, 1, pcx) as usize].p;
    if (p & crate::front::ast::ARM_IF_LET) != 0 {
        1
    } else if (p & crate::front::ast::ARM_LET_ELSE) != 0 {
        2
    } else {
        0
    }
}

// The initializer of a `let` as written: the scrutinee of the match a
// let-else became (scrutinee_scope's 2), else e.
fn let_else_scrutinee(e: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[e as usize].kind == NodeKind::Match && scrutinee_scope(e, pcx) == 2 {
        pcx.nodes[e as usize].a
    } else {
        e
    }
}

// The mismatch edge of such a match, at its else arm's entry: the
// scrutinee's scope h ends here, its temporaries dropped before the else
// block. A let-else's (`kept`) are needed again where the pattern
// matched: its entries are saved, in the order they were registered.
fn end_scrutinee(h: i64, kept: &mut Vec<i64, Comp>, keep: bool, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    if h < 0 {
        return;
    }
    if keep {
        let first = pcx.build_scopes[(h * SW + 1) as usize];
        for e in 2 * first..pcx.entries.len() as i64 {
            kept.push(pcx.entries[e as usize]);
        }
    }
    pop_scope_at(h, pbody, pcx);
}

// ... and at the join of a let-else: where the pattern matched, the
// scrutinee's temporaries are the `let`'s again (their drops in its
// temporaries' home, as if no scope had been made).
fn keep_scrutinee(kept: &Vec<i64, Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let mut i: usize = 0;
    while i + 1 < kept.len() {
        if kept[i] == EN_DROP {
            let home = temp_home(pcx);
            schedule_in(home, EN_DROP, kept[i + 1], pbody, pcx);
        } else {
            schedule(kept[i], kept[i + 1], pbody, pcx);
        }
        i += 2;
    }
}

// The place a scrutinee (or a pattern `let`'s initializer) is matched in
// (PL_L, PL_P): a place expression's, else a temporary of the statement,
// borrowed when the own pass made the match borrow (MATCH_BYREF, a copying
// getter's result).
fn scrutinee_place(e: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if is_place_expr(e, pcx) && place_of(e, pbody, pcx) {
        return;
    }
    let borrowed = borrowed_call(e, pcx) || (pcx.nodes[e as usize].p & MATCH_BYREF) != 0;
    pcx.pl_l = value_temp(e, borrowed, value_home(pcx.nodes[e as usize].ty, borrowed, pcx), pbody,
        pcx);
    pcx.pl_p = 0;
}

// Branches to block `fail` unless place (l, p) of type ty matches pattern
// pat: discriminant switches, comparisons; no binding made.
fn test_pattern(pat: i64, l: i64, p: i64, ty: i64, fail: i64, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    if !reachable(pbody) || ty == TY_NEVER {
        return;
    }
    let mut pp = p;
    let mut t = ty;
    let inner = pattern_referent(pat, t, pcx);
    if inner != 0 {
        pp = proj(pp, PJ_DEREF, 0, pbody);
        t = inner;
    }
    let k = pcx.nodes[pat as usize].kind;
    if k == NodeKind::PatLit {
        compare_const(l, pp, t, BO_EQ, pcx.nodes[pat as usize].x, fail, pat, pbody, pcx);
    } else if k == NodeKind::PatRange {
        compare_const(l, pp, t, BO_GE, pcx.nodes[pat as usize].x, fail, pat, pbody, pcx);
        compare_const(l, pp, t, BO_LE, pcx.nodes[pat as usize].y, fail, pat, pbody, pcx);
    } else if k == NodeKind::PatOr {
        let ok = new_block(pbody);
        let last = pcx.nodes[pat as usize].count - 1;
        for i in 0..last {
            let next = new_block(pbody);
            test_pattern(child(pat, i, pcx), l, pp, t, next, pbody, pcx);
            if reachable(pbody) {
                goto(ok, pbody);
            }
            enter_block(next, pbody);
        }
        test_pattern(child(pat, last, pcx), l, pp, t, fail, pbody, pcx);
        if reachable(pbody) {
            goto(ok, pbody);
        }
        enter_block(ok, pbody);
    } else if k == NodeKind::PatTuple {
        let tt = undistinct(t, pcx);
        for i in 0..pcx.nodes[pat as usize].count {
            test_pattern(child(pat, i, pcx), l, proj(pp, PJ_FIELD, i, pbody),
                crate::front::types::part_type(tt, i, pcx), fail, pbody, pcx);
        }
    } else if k == NodeKind::PatVariant {
        let v = pcx.nodes[pat as usize].x;
        switch_variant(l, pp, t, v, fail, pat, pbody, pcx);
        let vp = proj(pp, PJ_VARIANT, v, pbody);
        for i in 0..pcx.nodes[pat as usize].count {
            test_pattern(child(pat, i, pcx), l, proj(vp, PJ_FIELD, i, pbody),
                variant_field(v, i, pcx), fail, pbody, pcx);
        }
    }
}

// `_c = copy (l, p) OP const value; switch _c [false: fail]`.
fn compare_const(l: i64, p: i64, ty: i64, op: i64, value: i64, fail: i64, node: i64,
    pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let c = new_local(TY_BOOL, LF_TEMP, -1, node, pbody);
    let at = ops_mark(pbody);
    set_op(OK_COPY, l, p, pcx);
    push_now(pbody, pcx);
    set_op(OK_INT, value, ty, pcx);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, c, 0, RV_BINARY, op, 0, at, 2, node, pbody);
    let at2 = ops_mark(pbody);
    set_op(OK_COPY, c, 0, pcx);
    push_now(pbody, pcx);
    let next = new_block(pbody);
    switch_bool(at2, fail, next, node, pbody);
    enter_block(next, pbody);
}

// `_d = discriminant (l, p); switch _d [discr(v): next, otherwise: fail]`:
// what makes `(l, p) as v` valid in the blocks it dominates.
fn switch_variant(l: i64, p: i64, ty: i64, v: i64, fail: i64, node: i64, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let d = new_local(enum_tag_ty(undistinct(ty, pcx), pcx), LF_TEMP, -1, node, pbody);
    let at = ops_mark(pbody);
    set_op(OK_PLACE, l, p, pcx);
    push_now(pbody, pcx);
    emit(SK_ASSIGN, d, 0, RV_DISCR, 0, 0, at, 1, node, pbody);
    let at2 = ops_mark(pbody);
    set_op(OK_COPY, d, 0, pcx);
    push_now(pbody, pcx);
    let next = new_block(pbody);
    let ti = pbody.targets.len() as i64;
    pbody.targets.push(variant_discr(v, pcx));
    pbody.targets.push(next);
    terminate(TK_SWITCH, ti, 1, fail, at2, 1, node, pbody);
    enter_block(next, pbody);
}

fn phase_begin(s: i64, pcx: &mut Ctx<Comp>) {
    pcx.phase.clear();
    pcx.bind_scope = s;
}

// Binds the variables of pattern pat, known to match place (l, p) of type
// ty: each a move of its part (a copy when it borrows: `guard`, the own
// pass's BYREF, a part of a borrowed copy), or a reference to it (PAT_REF).
// An or-pattern's alternatives are tested again, in order, to bind the one
// that matched.
fn bind_pattern(pat: i64, l: i64, p: i64, ty: i64, guard: bool, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    if !reachable(pbody) || ty == TY_NEVER {
        return;
    }
    let mut pp = p;
    let mut t = ty;
    let inner = pattern_referent(pat, t, pcx);
    if inner != 0 {
        pp = proj(pp, PJ_DEREF, 0, pbody);
        t = inner;
        pcx.pat_deref += 1;
    }
    let k = pcx.nodes[pat as usize].kind;
    if k == NodeKind::PatBind {
        bind_one(pat, l, pp, t, guard, pbody, pcx);
    } else if k == NodeKind::PatTuple {
        let tt = undistinct(t, pcx);
        for i in 0..pcx.nodes[pat as usize].count {
            bind_pattern(child(pat, i, pcx), l, proj(pp, PJ_FIELD, i, pbody),
                crate::front::types::part_type(tt, i, pcx), guard, pbody, pcx);
        }
    } else if k == NodeKind::PatVariant {
        let v = pcx.nodes[pat as usize].x;
        let vp = proj(pp, PJ_VARIANT, v, pbody);
        for i in 0..pcx.nodes[pat as usize].count {
            bind_pattern(child(pat, i, pcx), l, proj(vp, PJ_FIELD, i, pbody),
                variant_field(v, i, pcx), guard, pbody, pcx);
        }
    } else if k == NodeKind::PatOr && binding_count(pat, pcx) > 0 {
        let ok = new_block(pbody);
        let last = pcx.nodes[pat as usize].count - 1;
        for i in 0..last {
            let next = new_block(pbody);
            test_pattern(child(pat, i, pcx), l, pp, t, next, pbody, pcx);
            bind_pattern(child(pat, i, pcx), l, pp, t, guard, pbody, pcx);
            if reachable(pbody) {
                goto(ok, pbody);
            }
            enter_block(next, pbody);
        }
        bind_pattern(child(pat, last, pcx), l, pp, t, guard, pbody, pcx);
        if reachable(pbody) {
            goto(ok, pbody);
        }
        enter_block(ok, pbody);
    }
    if inner != 0 {
        pcx.pat_deref -= 1;
    }
}

fn bind_one(pat: i64, l: i64, p: i64, ty: i64, guard: bool, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let al = pcx.nodes[pat as usize].x;
    if al < 0 {
        return;
    }
    let by_ref = binds_ref(pat, pcx);
    let borrowed = !by_ref && (guard || ast_borrowed(al, pcx) || has_flag(l, LF_BORROWED, pbody));
    // (the IR local: the phase's when an earlier alternative made it)
    let mut ir: i64 = -1;
    let mut i: i64 = 0;
    while i < pcx.phase.len() as i64 {
        if pcx.phase[i as usize] == al {
            ir = pcx.phase[(i + 1) as usize];
            break;
        }
        i += 2;
    }
    let first = ir < 0;
    if first {
        ir = user_local(al, pat, borrowed, pbody, pcx);
        pcx.phase.push(al);
        pcx.phase.push(ir);
    }
    live(ir, pbody, pcx);
    if first {
        schedule_outer(pcx.bind_scope, EN_DEAD, ir, pbody, pcx);
    }
    if by_ref {
        let rt = undistinct(ast_local_ty(al, pcx), pcx);
        // (0.27.1: a rust-edition guard sees a `ref mut` binding as `&T`, a
        // shared reborrow, D2.6)
        let kind = if rt > 0 && pcx.types[rt as usize].kind == TyKind::Ptr
            && pcx.types[rt as usize].b == REF_MUT && !(guard && pcx.rust_body) { BK_MUT }
            else { BK_SHARED };
        emit_ref(ir, 0, l, p, kind, pat, pbody, pcx);
    } else {
        // (0.27.1: a rust-edition read of a referent or an element that is
        // not Copy moves it, the borrow checker's move_out, D8.3; so does
        // a `&mut` the own pass would lend, `for x in self`'s, I7)
        let ut = undistinct(ty, pcx);
        let exclusive = ut > 0 && pcx.types[ut as usize].b == REF_MUT
            && (pcx.types[ut as usize].kind == TyKind::Ptr
                || pcx.types[ut as usize].kind == TyKind::Slice);
        // (not under a pattern that matches through a reference: its
        // bindings are `ref` ones, a read of the part)
        let moving = !borrowed
            || pcx.rust_body && pcx.pat_deref == 0 && (proj_indirect(p, pbody) || exclusive);
        place_operand(l, p, ty, moving, pbody, pcx);
        emit_use(ir, 0, pat, pbody, pcx);
    }
    if first && !has_flag(ir, LF_BORROWED, pbody) && needs_drop(pbody.locals[ir as usize].ty, pcx) {
        schedule_outer(pcx.bind_scope, EN_DROP, ir, pbody, pcx);
    }
}

// `let PAT = init;` for a pattern other than a name: the initializer's
// place, its pattern tested (an irrefutable one: a mismatch is
// unreachable), then its parts bound, in the block's scope (s: the
// statement's scope).
fn lower_let_pattern(pat: i64, init: i64, s: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if init == 0 {
        unsupported(pat, pcx);
        return;
    }
    scrutinee_place(init, pbody, pcx);
    if !reachable(pbody) {
        return;
    }
    let l = pcx.pl_l;
    let p = pcx.pl_p;
    let ty = pcx.nodes[init as usize].ty;
    let targets = pbody.targets.len();
    let fail = new_block(pbody);
    test_pattern(pat, l, p, ty, fail, pbody, pcx);
    if pbody.targets.len() != targets && reachable(pbody) {
        let ok = new_block(pbody);
        goto(ok, pbody);
        enter_block(fail, pbody);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, pat, pbody);
        enter_block(ok, pbody);
    }
    phase_begin(s, pcx);
    bind_pattern(pat, l, p, ty, false, pbody, pcx);
    pcx.bind_scope = -1;
}

// ---- Blocks and statements ----

fn lower_block(b: i64, dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let flags = pcx.nodes[b as usize].p;
    if (flags & NODE_TEMP) != 0 && own_temp_block(b, pcx) {
        // (the own pass's statement temporary: `&e`, or `e`)
        let e = own_temp_value(b, pcx);
        if !own_temp_addr(b, pcx) {
            expr_into(e, dl, dp, pbody, pcx);
            return;
        }
        let rk = ref_kind(pcx.nodes[b as usize].a, pcx.nodes[b as usize].ty, pcx);
        if rk == BK_SHARED && pcx.rust_body && promotable(e, pcx) {
            // RULE: D2.8 (0.27.5)
            shared_place(e, pbody, pcx);
        } else {
            own_temp_place(b, pbody, pcx);
        }
        if dl >= 0 && reachable(pbody) {
            emit_ref(dl, dp, pcx.pl_l, pcx.pl_p, rk, b, pbody, pcx);
        }
        return;
    }
    // (a transparent desugaring: no scope of its own; its statements', and
    // a desugared expression's, are no temporaries' homes)
    let scoped = (flags & (NODE_TEMP | BLOCK_TRANSPARENT)) == 0;
    let home = scoped && !desugared_block(b, pcx);
    let s: i64 = if scoped { push_scope(SC_BLOCK, b, home, pcx) } else { -1 };
    let saved_home = pcx.stmt_home;
    let saved_lent = pcx.lent_home;
    pcx.stmt_home = home;
    pcx.lent_home = -1;
    for i in 0..pcx.nodes[b as usize].count {
        if !reachable(pbody) {
            break;
        }
        lower_stmt(child(b, i, pcx), pbody, pcx);
    }
    pcx.stmt_home = saved_home;
    pcx.lent_home = saved_lent;
    let tail = pcx.nodes[b as usize].a;
    if tail != 0 && pcx.nodes[tail as usize].kind == NodeKind::Assign {
        if reachable(pbody) {
            lower_assign_at(tail, pbody, pcx);
        }
        if dl >= 0 && dl != unit_local(pbody, pcx) && reachable(pbody)
            && !is_void_dest(dl, dp, pbody, pcx) {
            set_op(OK_UNIT, 0, TY_UNIT, pcx);
            emit_use(dl, dp, b, pbody, pcx);
        }
        if scoped {
            pop_scope_at(s, pbody, pcx);
        }
        return;
    }
    if tail != 0 && reachable(pbody) {
        expr_into(tail, dl, dp, pbody, pcx);
    } else if tail == 0 && dl >= 0 && reachable(pbody) && !is_void_dest(dl, dp, pbody, pcx) {
        set_op(OK_UNIT, 0, TY_UNIT, pcx);
        emit_use(dl, dp, b, pbody, pcx);
    }
    if scoped {
        pop_scope_at(s, pbody, pcx);
    }
}

fn is_void_dest(dl: i64, dp: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    dl == unit_local(pbody, pcx) || dp == 0 && is_void(pbody.locals[dl as usize].ty)
}

// Whether block b is the checker's desugaring of an expression, whose
// statements' temporaries are the enclosing statement's (temp_home): its
// first `let`s bind its hidden names (`==l`, `=+l`, an f-string's `=fN`,
// `==nn`), which no program can write.
fn desugared_block(b: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.nodes[b as usize].count {
        let s = child(b, i, pcx);
        if pcx.nodes[s as usize].kind != NodeKind::Let {
            return false;
        }
        let pat = pcx.nodes[s as usize].a;
        if pat != 0 && pcx.nodes[pat as usize].kind == NodeKind::PatBind {
            let text = sym_text(pcx.nodes[pat as usize].a, pcx);
            if text.len() > 0 && text[0] == b'=' {
                return true;
            }
        }
    }
    false
}

fn lower_stmt(st: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[st as usize].kind;
    if k == NodeKind::Let {
        lower_let(st, pbody, pcx);
        return;
    }
    if k == NodeKind::ExprStmt {
        let e = pcx.nodes[st as usize].a;
        if e == 0 {
            return;
        }
        let s = push_scope(SC_STMT, st, pcx.stmt_home, pcx);
        if pcx.nodes[e as usize].kind == NodeKind::Assign {
            lower_assign_at(e, pbody, pcx);
        } else {
            expr_into(e, -1, 0, pbody, pcx);
        }
        pop_scope_at(s, pbody, pcx);
        return;
    }
    let s = push_scope(SC_STMT, st, pcx.stmt_home, pcx);
    expr_into(st, -1, 0, pbody, pcx);
    pop_scope_at(s, pbody, pcx);
}

// Schedules an entry at the end of scope s, below the scopes inside it.
fn schedule_in(s: i64, kind: i64, v: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if s + 1 >= scope_depth(pcx) {
        schedule(kind, v, pbody, pcx);
    } else {
        schedule_outer(s + 1, kind, v, pbody, pcx);
    }
}

fn lower_let(st: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    let pat = pcx.nodes[st as usize].a;
    let init = pcx.nodes[st as usize].c;
    if pat == 0 {
        return;
    }
    let pk = pcx.nodes[pat as usize].kind;
    // (its temporaries: to the end of the statement, or of the block when
    // it may keep a view of them)
    // RULE: D8.2 (0.28.0, a rust body's own `let`) rustc's temporary
    // lifetime extension: kept only when the initializer is an extending
    // expression, `&temp` (in a tuple, an array, a braced struct or a
    // cast); `let w = v[0].clone().as_str();` drops its String at the end
    // of the statement, and a later use of w is rustc's E0716. (A hidden
    // binding of a desugaring, `=f0`, `__out`, keeps the view rule.)
    let user = pcx.rust_body && init != 0
        && (pk != NodeKind::PatBind || !desugared_name(pcx.nodes[pat as usize].a, pcx));
    // (0.29.0: a let-else's initializer is its scrutinee, `let Some(x) =
    // &f() else { .. };`; where the pattern matches its temporaries are
    // the `let`'s, keep_scrutinee)
    let keep = if user { extending(let_else_scrutinee(init, pcx), pcx) }
        else {
            init != 0 && pcx.nodes[init as usize].ty > 0
                && is_view_type(pcx.nodes[init as usize].ty, pcx)
        };
    let s: i64 = if keep { -1 } else { push_scope(SC_STMT, st, pcx.stmt_home, pcx) };
    if pk == NodeKind::PatWild {
        if init != 0 {
            expr_into(init, -1, 0, pbody, pcx);
        }
    }
    else if pk == NodeKind::PatBind
        && (pcx.nodes[pat as usize].p & crate::front::ast::PAT_DEREF) == 0 {
        // (a binding through a reference, the rust edition's `&x`:
        // lower_let_pattern's deref)
        let l = pcx.nodes[pat as usize].x;
        if l < 0 {
            if init != 0 {
                expr_into(init, -1, 0, pbody, pcx);
            }
        } else {
            // (0.27.2: a hidden binding of a value, not a place, in a rust
            // body: `=f0` of `println("{}", String::from_in(..))` owns it
            // and drops it with the statement, as rustc's temporaries;
            // places-ir.md §3.7)
            let owns = pcx.rust_body && init != 0 && !is_place_expr(init, pcx)
                && hidden_name(pcx.nodes[pat as usize].a, pcx);
            let borrowed = !owns && let_borrows(pat, init, pcx);
            let ir = user_local(l, pat, borrowed, pbody, pcx);
            if owns && has_flag(ir, LF_BORROWED, pbody) {
                pbody.locals[ir as usize].flags -= LF_BORROWED;
            }
            // (its storage begins first; its drop is registered once it
            // holds its value, in the block's scope)
            live(ir, pbody, pcx);
            schedule_outer(s, EN_DEAD, ir, pbody, pcx);
            if init == 0 {
                pbody.locals[ir as usize].flags |= crate::places::ir::LF_DEFERRED;
            }
            if init != 0 {
                // (a requires check's argument, `let ?aI = argI`: an
                // argument, arg_operand)
                let saved = pcx.lent_home;
                pcx.lent_home = if !pcx.stmt_home && lent_branch(init, pcx) { temp_home(pcx) }
                    else { -1 };
                if pcx.rust_body && writer_reborrow(pat, init, pcx) {
                    // RULE: D7.4 (`write(w, ..)`'s receiver: `__r = &mut2 *w`)
                    as_place(init, pbody, pcx);
                    let rl = pcx.pl_l;
                    let rp = proj(pcx.pl_p, PJ_DEREF, 0, pbody);
                    emit_ref(ir, 0, rl, rp, BK_MUT2, init, pbody, pcx);
                } else if pcx.rust_body && writer_autoref(pat, init, pcx) {
                    // RULE: D7.4 (`write(p, ..)`'s autoref: `__r = &mut2 p`)
                    as_place(pcx.nodes[init as usize].b, pbody, pcx);
                    let rl = pcx.pl_l;
                    let rp = pcx.pl_p;
                    emit_ref(ir, 0, rl, rp, BK_MUT2, init, pbody, pcx);
                } else if borrowed && pcx.rust_body && is_place_expr(init, pcx) {
                    rust_let_place(pat, init, ir, pbody, pcx);
                } else {
                    expr_into(init, ir, 0, pbody, pcx);
                }
                pcx.lent_home = saved;
                // RULE: D3.6 (a user type annotation: kept for the constraints)
                if pcx.rust_body && pcx.nodes[st as usize].b > 0 && pbody.stmts.len() > 0 {
                    pbody.annots.push(ir);
                    pbody.annots.push(pcx.nodes[st as usize].b);
                    pbody.annots.push(pbody.stmts.len() as i64 - 1);
                }
            }
            if !has_flag(ir, LF_BORROWED, pbody) && needs_drop(pbody.locals[ir as usize].ty, pcx) {
                schedule_outer(s, EN_DROP, ir, pbody, pcx);
            }
        }
    } else {
        lower_let_pattern(pat, init, s, pbody, pcx);
    }
    if s >= 0 {
        pop_scope_at(s, pbody, pcx);
    }
}

// (0.27.1) `let pat = init` of a place into a borrowed copy, in a rust
// body: a user binding takes a referent or an element that is not Copy
// (`let s = *r;`, `let s = v[0];`: the borrow checker's move_out, D8.3),
// a `for` loop's sequence a whole `&mut` (`for x in self`, I7); the
// checker's hidden bindings (`=fN`, an f-string's holes) copy, a whole
// `&mut T` reborrowed shared.
fn rust_let_place(pat: i64, init: i64, ir: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !place_of(init, pbody, pcx) {
        return;
    }
    let ty = pcx.nodes[init as usize].ty;
    let name = pcx.nodes[pat as usize].a;
    let text = sym_text(name, pcx);
    let ut = undistinct(ty, pcx);
    let exclusive = ut > 0 && pcx.types[ut as usize].b == REF_MUT
        && (pcx.types[ut as usize].kind == TyKind::Ptr
            || pcx.types[ut as usize].kind == TyKind::Slice);
    let take = if name == pcx.sym_for_seq { exclusive }
        else { (text.len() == 0 || text[0] != b'=') && proj_indirect(pcx.pl_p, pbody) };
    // RULE: D3.6 (a hidden binding of a whole `&mut T`, `=f0` of
    // `println("{}", r)`: its shared reborrow `&*r`, as rustc's
    // format_args takes `&r`; the reference is neither copied, I7, nor
    // moved)
    if !take && exclusive && pcx.types[ut as usize].kind == TyKind::Ptr && text.len() > 0
        && text[0] == b'=' {
        let p = proj(pcx.pl_p, PJ_DEREF, 0, pbody);
        emit_ref(ir, 0, pcx.pl_l, p, BK_SHARED, init, pbody, pcx);
        return;
    }
    // (a `&mut [T]`'s: the binding is typed `&[T]` and copies it, the
    // mutable view's shared reborrow, D3.6, until `*s` of a slice view, Z9.1)
    if !take && exclusive && text.len() > 0 && text[0] == b'=' {
        pbody.locals[ir as usize].ty = crate::front::types::slice_of(pcx.types[ut as usize].a, pcx);
    }
    place_operand(pcx.pl_l, pcx.pl_p, ty, take, pbody, pcx);
    if reachable(pbody) {
        emit_use(ir, 0, init, pbody, pcx);
    }
}

// Registers an entry in the scope that encloses statement scope s (the
// block's), or in the innermost one when s is -1.
fn schedule_outer(s: i64, kind: i64, v: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if kind == EN_DEAD && !keeps_storage(v, pbody, pcx) {
        return;
    }
    if s < 0 {
        schedule(kind, v, pbody, pcx);
        return;
    }
    // (the statement scope is innermost and holds only its temporaries:
    // the entry goes before them, at the end of the enclosing scope)
    let at = pcx.build_scopes[(s * SW + 1) as usize];
    pcx.entries.push(0);
    pcx.entries.push(0);
    let mut e = pcx.entries.len() as i64 / 2 - 1;
    while e > at {
        pcx.entries[(2 * e) as usize] = pcx.entries[(2 * e - 2) as usize];
        pcx.entries[(2 * e + 1) as usize] = pcx.entries[(2 * e - 1) as usize];
        e -= 1;
    }
    pcx.entries[(2 * at) as usize] = kind;
    pcx.entries[(2 * at + 1) as usize] = v;
    // (the statement scope's entries now start one later)
    let mut t = s;
    while t < scope_depth(pcx) {
        pcx.build_scopes[(t * SW + 1) as usize] += 1;
        t += 1;
    }
}

// Whether `let pat = init` binds a borrowed copy: byref.vl's BYREF, a
// `for` loop's sequence when it is a place, an operator's `==` operand.
fn let_borrows(pat: i64, init: i64, pcx: &mut Ctx<Comp>) -> bool {
    let l = pcx.nodes[pat as usize].x;
    if ast_borrowed(l, pcx) {
        return true;
    }
    let name = pcx.nodes[pat as usize].a;
    if name == pcx.sym_for_seq && init != 0 && is_place_expr(init, pcx) {
        // RULE: D8.5 (the rust edition's `for x in v` moves v into
        // `into_iter`: its sequence owns it, but an array's counted loop,
        // which reads the elements in place; 0.27.3: of plain elements
        // only, check_for_iter's array_value: an array of owned ones is
        // moved into std's array IntoIter, F22.1, FL13)
        let t = pcx.nodes[init as usize].ty;
        return !pcx.rust_body || t <= 0 || pcx.types[t as usize].kind == TyKind::Array
            && crate::front::kinds::is_plain_type(pcx.types[t as usize].a, pcx);
    }
    // (`let x = S;` of a static: it borrows, statics are never dropped)
    if init != 0 && pcx.nodes[init as usize].kind == NodeKind::Ident
        && pcx.nodes[init as usize].res == Res::Static {
        return true;
    }
    // (a hidden binding of the checker's, `=fN` an f-string's hole, `==`
    // an operator's operand: a borrowed copy, as the own pass's let_drops)
    let text = sym_text(name, pcx);
    // RULE: D8.5 (an arithmetic operator's operands, `=+l` and `=+r`, are
    // taken by value in the rust edition, `Add::add(a, b)`: moved, not
    // borrowed; a comparison's, `==l`, are borrowed, `PartialEq::eq(&a, &b)`)
    if pcx.rust_body && text.len() == 3 && text[0] == b'=' && text[1] == b'+' {
        return false;
    }
    text.len() > 0 && text[0] == b'='
}

// (0.28.0) Whether a `let`'s name is a desugaring's: a hidden binding
// (`=f0`) or a lowering's own (`__out`, `__s`).
fn desugared_name(name: i64, pcx: &Ctx<Comp>) -> bool {
    let text = sym_text(name, pcx);
    hidden_name(name, pcx) || text.len() > 1 && text[0] == b'_' && text[1] == b'_'
}

// (0.28.0) RULE: D8.2 Whether expression e is extending, rustc's rule for
// a `let`'s initializer: `&x` (its operand's temporaries live to the end
// of the block), and a tuple, an array, a braced struct literal or a cast
// of an extending expression; a block counts as one (its tail's rule,
// left to the block).
fn extending(e: i64, pcx: &Ctx<Comp>) -> bool {
    let k = pcx.nodes[e as usize].kind;
    if k == NodeKind::Unary {
        return pcx.nodes[e as usize].op == Tok::Amp;
    }
    if k == NodeKind::Cast {
        return extending(pcx.nodes[e as usize].a, pcx);
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit {
        for i in 0..pcx.nodes[e as usize].count {
            let c = child(e, i, pcx);
            let v = if pcx.nodes[c as usize].kind == NodeKind::FieldInit { pcx.nodes[c as usize].b }
                else { c };
            if v != 0 && extending(v, pcx) {
                return true;
            }
        }
        return false;
    }
    k == NodeKind::Block
}

// Whether symbol name is one of the checker's hidden bindings (`=fN` an
// f-string's hole, `==` an operator's operand).
fn hidden_name(name: i64, pcx: &Ctx<Comp>) -> bool {
    let text = sym_text(name, pcx);
    text.len() > 0 && text[0] == b'='
}

// RULE: D7.4 Whether `let pat = init` is the receiver binding `__r` of
// std's `write`/`writeln` desugaring with a `&mut` place for its writer.
fn writer_reborrow(pat: i64, init: i64, pcx: &Ctx<Comp>) -> bool {
    if init == 0 || sym_text(pcx.nodes[pat as usize].a, pcx) != b"__r"
        || !is_place_expr(init, pcx) {
        return false;
    }
    let t = pcx.nodes[init as usize].ty;
    t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b == REF_MUT
}

// RULE: D7.4 (0.27.6) Whether `let pat = init` is that binding with the
// writer a place that is no reference, `write(self.emsg, "{}",
// self.name_of(s))`: F16.3 made it `&mut self.emsg`, an autoref (its span
// the place's), as Rust's `write!(self.emsg, ..)` is `self.emsg.
// write_fmt(..)`. It is two-phase, `__r = &mut2 self.emsg`, as rustc's
// autoref'd receiver is. A `&mut P` the program writes is not (rustc's
// `write!(&mut self.emsg, "{}", self.len())` is E0502).
fn writer_autoref(pat: i64, init: i64, pcx: &Ctx<Comp>) -> bool {
    init != 0 && sym_text(pcx.nodes[pat as usize].a, pcx) == b"__r"
        && pcx.nodes[init as usize].kind == NodeKind::Unary
        && pcx.nodes[init as usize].op == Tok::Amp
        && (pcx.nodes[init as usize].p & NODE_REF_MUT) != 0
        && pcx.nodes[init as usize].start == pcx.nodes[pcx.nodes[init as usize].b as usize].start
        && is_place_expr(pcx.nodes[init as usize].b, pcx)
}

// ---- The body ----

// Builds function f's body (Fn node item) into the IR tables; false when
// a construct is not handled (a fallback).
pub fn build_body(f: i64, item: i64, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    syms(pcx);
    pcx.build_failed = false;
    pcx.fail_node = 0;
    pcx.build_gen += 1;
    pcx.cur_f = f;
    body_begin(f, item, pbody);
    pcx.build_scopes.clear();
    pcx.entries.clear();
    pcx.statics_seen.clear();
    pcx.unit_local = -1;
    let ret = fn_ret(f, pcx);
    new_local(ret, LF_RETURN, -1, 0, pbody);
    let count = pcx.nodes[item as usize].count;
    pbody.params = count;
    let entry = new_block(pbody);
    pcx.ret_block = new_block(pbody);
    let body_scope = push_scope(SC_BODY, pcx.nodes[item as usize].c, true, pcx);
    // the parameters: _1.._n
    let keep = keep_params(f, pcx);
    for i in 0..count {
        let p = child(item, i, pcx);
        let l = pcx.nodes[p as usize].x;
        let ty: i64 = if i < fn_param_count(f, pcx) { fn_param(f, i, pcx) } else { 0 };
        let mut flags = LF_PARAM;
        if l >= 0 && ast_local_mutable(l, pcx) {
            flags |= LF_MUT;
        }
        if l >= 0 && ast_borrowed(l, pcx) {
            flags |= LF_BORROWED;
        }
        let ir = new_local(ty, flags, l, p, pbody);
        if l >= 0 {
            map_local(l, ir, 0, pcx);
        }
        if !keep && (flags & LF_BORROWED) == 0 && needs_drop(ty, pcx) {
            schedule(EN_DROP, ir, pbody, pcx);
        }
    }
    enter_block(entry, pbody);
    let body = pcx.nodes[item as usize].c;
    expr_into(body, 0, 0, pbody, pcx);
    if reachable(pbody) {
        exit_to(body_scope, body, pbody, pcx);
        goto(pcx.ret_block, pbody);
    }
    pcx.build_scopes.clear();
    pcx.entries.clear();
    enter_block(pcx.ret_block, pbody);
    terminate(TK_RETURN, 0, 0, 0, 0, 0, 0, pbody);
    live_writes(pbody, pcx);
    pcx.built += 1;
    !pcx.build_failed
}

// Whether function f keeps its by-value parameters undropped: std's
// `forget` (whose point that is), and `iter::pass_over::<I>` of a
// borrowing iterator's item (a copy its container keeps), as the own
// pass's param_drops.
fn keep_params(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    // (a `$pre` companion's parameters are its call's arguments, read in
    // place: contracts::expand::is_pre_fn)
    if is_pre_fn(f, pcx) {
        return true;
    }
    let t = crate::places::front::fn_template(f, pcx);
    if !crate::front::modules::within_std(crate::places::front::fn_module(t, pcx), pcx) {
        return false;
    }
    let name = crate::places::front::fn_name_sym(t, pcx);
    if name == intern_c(c"forget", pcx) {
        return true;
    }
    name == intern_c(c"pass_over", pcx)
        && crate::front::byref::copies_owned_items(crate::places::front::fn_targ(f, 0, pcx), 0,
            pcx)
}

// ---- A sink closure's captures moved (R3) ----

// The flag field index of the capture statement st moves out of the env
// of the closure body held (`move (*_1).k...`, k a capture with a
// `__live_` flag), or -1.
fn moved_capture_flag(st: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    for i in 0..st.nops {
        if op_kind(st.ops, i, pbody) != OK_MOVE || op_a(st.ops, i, pbody) != 1 {
            continue;
        }
        // (the steps from the root: `*`, then field k)
        let mut second: i64 = 0;
        let mut first = op_b(st.ops, i, pbody);
        while first > 0 && proj_parent(first, pbody) > 0 {
            second = first;
            first = proj_parent(first, pbody);
        }
        if first <= 0 || proj_kind(first, pbody) != PJ_DEREF || second <= 0
            || proj_kind(second, pbody) != PJ_FIELD {
            continue;
        }
        let env = undistinct(pbody.locals[1].ty, pcx);
        let pt: i64 = if env > 0
            && pcx.types[env as usize].kind == TyKind::Ptr { pcx.types[env as usize].a } else { 0 };
        if pt <= 0 || !struct_closure(pt, pcx) {
            continue;
        }
        let s = pcx.types[pt as usize].a;
        let flag = crate::places::glue::flag_field(s,
            struct_field_name(s, proj_val(second, pbody), pcx), pcx);
        if flag == 0 {
            continue;
        }
        for k in 0..crate::places::ir::struct_field_count(s, pcx) {
            if struct_field_name(s, k, pcx) == flag {
                return k;
            }
        }
    }
    -1
}

// The checker's node of the stop at a sink closure's second move out of
// its env (R7): `EnumPanic(0)` with the own pass's message, at node n.
fn second_move_panic(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let start = pcx.nodes[n as usize].start;
    let zero = crate::front::ast::new_node(NodeKind::Int, start, start, pcx);
    pcx.nodes[zero as usize].ty = TY_I64;
    pcx.nodes[zero as usize].b = crate::front::lexer::SUF_I64;
    let p = crate::front::ast::new_node(NodeKind::EnumPanic, start, start, pcx);
    pcx.nodes[p as usize].ty = TY_NEVER;
    pcx.nodes[p as usize].a = zero;
    pcx.nodes[p as usize].x = crate::gen0::target::message_kind(
        crate::front::contracts::checks::fixed_message(
            b"a sink closure moved its captured value out a second time: it was called again\n",
            pcx),
        pcx);
    p
}

// Whether parameter _1 of the body held is a closure's env with a capture
// under a `__live_` flag (moved_capture_flag's): else live_writes has
// nothing to look for.
fn env_has_flags(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let env = undistinct(pbody.locals[1].ty, pcx);
    let pt: i64 = if env > 0
        && pcx.types[env as usize].kind == TyKind::Ptr { pcx.types[env as usize].a } else { 0 };
    if pt <= 0 || !struct_closure(pt, pcx) {
        return false;
    }
    let s = pcx.types[pt as usize].a;
    for k in 0..crate::places::ir::struct_field_count(s, pcx) {
        if crate::places::glue::flag_field(s, struct_field_name(s, k, pcx), pcx) != 0 {
            return true;
        }
    }
    false
}

// A closure body that moves a capture of a sink closure out of its env:
// `(*_1).__live_x = const false` after each such move, as the own pass
// writes it, so that the env's shim drops only what it still holds.
fn live_writes(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    if pbody.params < 1 || local_count(pbody) < 2 || !has_flag(1, LF_PARAM, pbody)
        || !env_has_flags(pbody, pcx) {
        return;
    }
    let mut any = false;
    for s in 0..pbody.stmts.len() {
        if moved_capture_flag(pbody.stmts[s], pbody, pcx) >= 0 {
            any = true;
            break;
        }
    }
    if !any {
        return;
    }
    pcx.old_stmts.clear();
    for s in 0..pbody.stmts.len() {
        pcx.old_stmts.push(pbody.stmts[s]);
    }
    let n = block_count(pbody);
    // (the blocks' ranges before: entering a block resets its start)
    let ranges = pcx.tmp_ranges.len() as i64;
    for b in 0..n {
        pcx.tmp_ranges.push(block_start(b, pbody));
        pcx.tmp_ranges.push(block_len(b, pbody));
    }
    pbody.stmts.clear();
    let root = proj(0, PJ_DEREF, 0, pbody);
    for b in 0..n {
        let start = pcx.tmp_ranges[(ranges + 2 * b) as usize];
        if start < 0 {
            continue;
        }
        let len = pcx.tmp_ranges[(ranges + 2 * b + 1) as usize];
        enter_block(b, pbody);
        for s in start..start + len {
            let st = pcx.old_stmts[s as usize];
            let k = moved_capture_flag(st, pbody, pcx);
            if k >= 0 {
                // (R7: moved out already, the closure called again: the
                // program stops, as the own pass's wrap_capture_move)
                let flag = proj(root, PJ_FIELD, k, pbody);
                let c = new_local(TY_BOOL, LF_TEMP, -1, st.node, pbody);
                let a0 = ops_mark(pbody);
                push_op(OK_COPY, 1, flag, pbody);
                emit(SK_ASSIGN, c, 0, RV_USE, 0, 0, a0, 1, st.node, pbody);
                let a1 = ops_mark(pbody);
                push_op(OK_COPY, c, 0, pbody);
                let fail = new_block(pbody);
                let cont = new_block(pbody);
                switch_bool(a1, fail, cont, st.node, pbody);
                enter_block(fail, pbody);
                let p = second_move_panic(st.node, pcx);
                let a2 = ops_mark(pbody);
                push_op(OK_INT, 0, TY_I64, pbody);
                emit(SK_INTRINSIC, unit_local(pbody, pcx), 0, IK_PANIC, p, 0, a2, 1, p, pbody);
                terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, p, pbody);
                enter_block(cont, pbody);
            }
            pbody.stmts.push(st);
            if k >= 0 {
                let at = ops_mark(pbody);
                push_op(OK_INT, 0, TY_BOOL, pbody);
                emit(SK_ASSIGN, 1, proj(root, PJ_FIELD, k, pbody), RV_USE, 0, 0, at, 1, st.node,
                    pbody);
            }
        }
        let term = pcx.old_stmts[(start + len) as usize];
        terminate(term.kind, term.a, term.b, term.c, term.ops, term.nops, term.node, pbody);
    }
    pcx.tmp_ranges.truncate(ranges as usize);
}
