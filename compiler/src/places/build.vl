// The builder (0.26.0, docs/design/places-ir.md §3, §4, §8 step 2): one
// checked function body (its AST, with the checker's and the own pass's
// nodes in it) into the IR of places/ir.vl, in evaluation order.
//
// Scopes (§3.7) are a stack: the body, each block, each statement (its
// temporaries), each loop and arm. A scope's entries are "drop local l",
// "storage of l ends" and "run defer d"; leaving a scope by any edge emits
// the entries of every scope it leaves, innermost first, each in reverse
// order of registration. Every needs-drop local and temporary gets a drop
// there, whether it moved or not: elaboration decides each (elab.vl).
//
// Temporaries (0.26.2) are the builder's own: a value where a place is
// needed (`&e`, a field read out of it, a receiver) or an operand gets a
// temporary, whose drop is an entry of its statement's scope (temp_home,
// R5's rule: the end of its statement, or of its block for a tail and a
// `let` that may view it); so is an owned assignment's drop of the old
// value, `tmp = v; drop(p); p = move tmp` (§3.8, lower_assign_at).
//
// The own pass's nodes are read through (§4), until step 7 deletes them:
// - its implicit defers (DEFER_IMPLICIT) are skipped: the IR places its
//   own drops;
// - a statement temporary (drops.vl temp_make: a NODE_TEMP block, its
//   `__own_tp` and `__own_tf` lets, their defer) is read as the `&e` (or
//   `e`) it stands for, its prelude skipped (own_temp_block);
// - the assignment desugaring `{ let __own_new = rhs; { let =o = p; p =
//   __own_new; } }` is read as the assignment it was made of (byref.vl
//   own_assign_of), which also says whether it drops until then;
// - the checker's transparent blocks (BLOCK_TRANSPARENT: `?`'s and a
//   requires call's) are no scope: their `let`s are temporaries of the
//   statement;
// - the bindings it borrows (byref.vl: BYREF, a `for` loop's sequence of
//   a place, the `==` operands of an operator) are BORROWED locals,
//   initialized by a copy.
//
// A construct the builder does not handle yet makes the body a fallback
// (BUILD_FAILED, FAIL_NODE): no body, counted by the driver.

use crate::base::{IntVec, SYMS, intern_c, len_arg};
use crate::base::comp::Comp;
use crate::front::ast::{
    BLOCK_TRANSPARENT, CLOSURE_MOVE, DEFER_IMPLICIT, NODES, NODE_IN_BOUNDS, NODE_REF_MUT, NodeKind,
    child,
};
use crate::front::check::Res;
use crate::front::check::temps::NODE_TEMP;
use crate::front::consteval::wrap_int;
use crate::front::contracts::expand::is_pre_fn;
use crate::front::distinct::enum_niche;
use crate::front::lexer::Tok;
use crate::front::own::byref::{
    BYREF, MATCH_BYREF, NO_DROP, borrowed_call, indexable_place, own_assign_of, own_assign_old,
};
use crate::front::own::diag::{MODE_ERROR, OWN_MODE};
use crate::front::own::kinds::{P_MUT, P_RAW, P_VALUE, is_view_type, param_mode};
use crate::front::patterns::{binding_count, binds_ref, is_irrefutable, pattern_referent};
use crate::front::patterns::usefulness::int_key;
use crate::front::types::{
    REF_MUT, REF_SHARED, TYPES, TY_BOOL, TY_I64, TY_NEVER, TY_UNIT, TyKind, fn_param, is_compound,
    is_integer, is_void, type_elem, variant_field,
};
use crate::places::front::{
    ast_local_mutable, ast_local_ty, enum_tag_ty, fn_is_extern, fn_param_count, fn_ret, static_ty,
    struct_field_name, type_glue, variant_discr,
};
use crate::places::ir::{
    AK_ARRAY, AK_BOUNDS, AK_CLOSURE, AK_STRUCT, AK_TUPLE, AK_VARIANT, BK_MUT, BK_MUT2, BK_RAW,
    BK_SHARED, BO_ADD, BO_AND, BO_DIV, BO_EQ, BO_GE, BO_GT, BO_LE, BO_LT, BO_MUL, BO_NE, BO_OR,
    BO_REM, BO_SHL, BO_SHR, BO_SUB, BO_XOR, B_PARAMS, DS_UNDECIDED, IK_ARCH, IK_CONTRACT, IK_PANIC,
    IK_VECTOR, LF_BORROWED, LF_MUT, LF_PARAM, LF_RETURN, LF_STATIC, LF_TEMP, LF_USER, OK_CONST,
    OK_COPY, OK_CSTR, OK_FLOAT, OK_FN, OK_INT, OK_MOVE, OK_PLACE, OK_STR, OK_UNIT, PJ_CONST,
    PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION, PJ_VARIANT, PStmt, P_LOCALS, P_OPS, P_STMTS, RV_AGG,
    RV_BINARY, RV_CAST, RV_DISCR, RV_LEN, RV_REF, RV_REPEAT, RV_SLICE, RV_UNARY, RV_USE, SK_ASSERT,
    SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC, SK_LIVE, SK_MENTION, TK_GOTO, TK_RETURN,
    TK_SWITCH, TK_UNREACHABLE, UO_BITNOT, UO_NEG, UO_NOT, block_count, block_len, block_start,
    body_begin, emit, enter_block, has_flag, is_union_type, local_count, new_block, new_local, op_a,
    op_b, op_kind, ops_mark, proj, proj_kind, proj_parent, proj_val, push_op, reachable,
    struct_closure, terminate, undistinct,
};

// ---- State ----

// Set when the body uses a construct not built yet: the node.
pub static var BUILD_FAILED: bool = false;
pub static var FAIL_NODE: i64 = 0;

// AST local -> IR place (local, projection), valid where MAP_GEN is GEN.
static var MAP_L: Vec<i64, Comp> = Vec::new_in(Comp {});
static var MAP_P: Vec<i64, Comp> = Vec::new_in(Comp {});
static var MAP_GEN: Vec<i64, Comp> = Vec::new_in(Comp {});
static var GEN: i64 = 0;
// The statics named so far: (symbol, IR local) pairs.
static var STATICS_SEEN: Vec<i64, Comp> = Vec::new_in(Comp {});
// The scope stack: records of SW words (kind, first entry, its node
// (where its drops run, places/print.vl drop_pos; a loop's: the loop),
// break block, continue block, the loop's result local and projection,
// whether `continue` takes a back edge, and whether it is a home of
// statement temporaries: temp_home).
const SW: i64 = 9;
const SC_BODY: i64 = 1;
const SC_BLOCK: i64 = 2;
const SC_STMT: i64 = 3;
const SC_LOOP: i64 = 4;
const SC_ARM: i64 = 5;
static var SCOPES: Vec<i64, Comp> = Vec::new_in(Comp {});
// Their entries: (kind, value) pairs.
const EN_DROP: i64 = 1;
const EN_DEAD: i64 = 2;
const EN_DEFER: i64 = 3;
static var ENTRIES: Vec<i64, Comp> = Vec::new_in(Comp {});
// The last operand made (operand) and the last place (as_place).
static var OPK: i64 = 0;
static var OPA: i64 = 0;
static var OPB: i64 = 0;
static var PL_L: i64 = 0;
static var PL_P: i64 = 0;
// The return block, the discard local (`()`, no storage), the function.
static var RET_BLOCK: i64 = -1;
static var UNIT_LOCAL: i64 = -1;
static var CUR_F: i64 = -1;

// The exit whose scopes' entries are being emitted (a `return`, `break`,
// `continue`, a refused guard, the body's end): the node of their drops
// (0: a scope's own end, its node's).
static var EXIT_NODE: i64 = 0;
// Whether drops are placed (--values=error, as the own pass's).
static var DROPS: bool = false;
// Whether the struct literal being lowered is a by-access closure's env
// (its values borrowed copies).
static var AGG_BORROW: bool = false;
// The symbols of the own pass's names the builder reads.
static var SYM_TP: i64 = 0;
static var SYM_TF: i64 = 0;
static var SYM_FOR_SEQ: i64 = 0;

// Counts, for --time-passes and the README.
pub static var BUILT: i64 = 0;
pub static var STMTS_MADE: i64 = 0;

// Whether every local gets its storage markers (keeps_storage): set by the
// driver for --emit-places and --verify-places.
pub static var ALL_STORAGE: bool = true;

fn syms() {
    if SYM_TP == 0 {
        SYM_TP = intern_c(c"__own_tp");
        SYM_TF = intern_c(c"__own_tf");
        SYM_FOR_SEQ = intern_c(c"__for_seq");
    }
}

fn unsupported(n: i64) {
    if !BUILD_FAILED {
        BUILD_FAILED = true;
        FAIL_NODE = n;
    }
}

// ---- Locals ----

fn map_local(l: i64, ir: i64, p: i64) {
    while MAP_GEN.len() as i64 <= l {
        MAP_L.push(0);
        MAP_P.push(0);
        MAP_GEN.push(0);
    }
    MAP_L[l] = ir;
    MAP_P[l] = p;
    MAP_GEN[l] = GEN;
}

// The IR place of AST local l (PL_L, PL_P); false when it has none.
fn mapped(l: i64) -> bool {
    if l < 0 || l >= MAP_GEN.len() as i64 || MAP_GEN[l] != GEN {
        return false;
    }
    PL_L = MAP_L[l];
    PL_P = MAP_P[l];
    true
}

// Whether AST local l is a borrowed copy (byref.vl's BYREF).
fn ast_borrowed(l: i64) -> bool {
    l >= 0 && BYREF.get(l + 1) != 0
}

fn needs_drop(t: i64) -> bool {
    DROPS && t > 0 && t != TY_NEVER && type_glue(t)
}

// A new IR local for AST local l (bound by a pattern or a `let`).
fn user_local(l: i64, node: i64, borrowed: bool) -> i64 {
    let ty = ast_local_ty(l);
    var flags = LF_USER;
    if ast_local_mutable(l) {
        flags |= LF_MUT;
    }
    if borrowed || ast_borrowed(l) {
        flags |= LF_BORROWED;
    }
    let ir = new_local(ty, flags, l, node);
    map_local(l, ir, 0);
    ir
}

// A temporary of type ty, which the builder writes itself (a result, a
// counter, an assignment's value): its storage begins now, and its storage
// end is an entry of the innermost scope. Its drop, when its type needs one
// and it is not borrowed, is an entry of its statement's scope (temp_home,
// R5): when that is not the innermost, the temporary has no storage markers
// (made on some paths of the scope it drops in, an arm's: its storage is
// the body's).
fn new_temp(ty: i64, node: i64, borrowed: bool) -> i64 {
    let l = new_local(ty, LF_TEMP | if borrowed { LF_BORROWED } else { 0 }, -1, node);
    let drop = !borrowed && needs_drop(ty);
    let h = if drop { temp_home() } else { scope_depth() - 1 };
    if h == scope_depth() - 1 {
        live(l);
        schedule(EN_DEAD, l);
        if drop {
            schedule(EN_DROP, l);
        }
    } else {
        schedule_in(h, EN_DROP, l);
    }
    l
}

// A temporary holding the value of expression e, made into it, dropped at
// the end of scope h (an operand's: new_temp's rule, value_home; a place's,
// `&e` or a part read out of e: its statement's, temp_home, so that what
// the statement makes of it outlives none of it). Its entries are
// registered once it holds the value, so that the temporaries e makes drop
// after it (`r(1).next().show()`: the last made first). Borrowed (no drop)
// for a copy its result is (copied_call).
fn value_temp(e: i64, borrowed: bool, h: i64) -> i64 {
    let ty = NODES[e].ty;
    let l = new_local(ty, LF_TEMP | if borrowed { LF_BORROWED } else { 0 }, -1, e);
    let drop = !borrowed && needs_drop(ty);
    let inner = h == scope_depth() - 1;
    if inner {
        live(l);
    }
    expr_into(e, l, 0);
    if inner {
        schedule(EN_DEAD, l);
        if drop {
            schedule(EN_DROP, l);
        }
    } else if drop {
        schedule_in(h, EN_DROP, l);
    }
    l
}

// The scope a temporary of type ty drops in by new_temp's rule.
fn value_home(ty: i64, borrowed: bool) -> i64 {
    if !borrowed && needs_drop(ty) { temp_home() } else { scope_depth() - 1 }
}

// The temporary holding the value of e where a place is needed (value_temp,
// in its statement's scope).
fn place_temp(e: i64) -> i64 {
    value_temp(e, copied_call(e), temp_home())
}

// (0.26.2, drops.vl hold_args) The statement scope of the call (or struct
// literal, or requires check) whose argument being lowered is a value lent
// to a let parameter (or a let field) that is a branch's (lent_branch), -1
// outside one: a temporary its branches make of a local declared in it
// (`count(match make() { Ok(s) => s, .. }, 8)` lends `&s`) drops there,
// with the statement, not with the local's arm. A block's statements are
// none of its branches (only its tail is).
static var LENT_HOME: i64 = -1;

// Whether e, an argument, is a branch's value lent to a let parameter: of
// type `&T`, a match, an if, a block or a `?`.
fn lent_branch(e: i64) -> bool {
    let t = NODES[e].ty;
    let k = NODES[e].kind;
    t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b == REF_SHARED && (k == NodeKind::Match
        || k == NodeKind::If || k == NodeKind::Try || k == NodeKind::Block
        && (NODES[e].p & NODE_TEMP) == 0)
}

// operand(e, moving) for an argument (a call's, a struct literal's field):
// LENT_HOME set for it.
fn arg_operand(e: i64, moving: bool) {
    let saved = LENT_HOME;
    LENT_HOME = if lent_branch(e) { temp_home() } else { -1 };
    operand(e, moving);
    LENT_HOME = saved;
}

fn live(l: i64) {
    if !keeps_storage(l) {
        return;
    }
    emit(SK_LIVE, l, 0, 0, 0, 0, 0, 0, 0);
}

// Whether local l gets its storage markers: every local when they are
// printed or verified (ALL_STORAGE), else only one whose type has glue,
// which elaboration reads them for (a StorageLive or StorageDead makes its
// paths uninitialized). The code generators ignore them in 0.26.1, and
// most locals are scalars: about half the statements.
fn keeps_storage(l: i64) -> bool {
    ALL_STORAGE || type_glue(P_LOCALS[l].ty)
}

// The local `()` values are discarded into.
fn unit_local() -> i64 {
    if UNIT_LOCAL < 0 {
        UNIT_LOCAL = new_local(TY_UNIT, LF_TEMP, -1, 0);
    }
    UNIT_LOCAL
}

// The IR local of static `name` (a symbol).
fn static_local(name: i64, node: i64) -> i64 {
    var i = 0;
    while i < STATICS_SEEN.len() as i64 {
        if STATICS_SEEN[i] == name {
            return STATICS_SEEN[i + 1];
        }
        i += 2;
    }
    let l = new_local(static_ty(name), LF_STATIC, name, node);
    STATICS_SEEN.push(name);
    STATICS_SEEN.push(l);
    l
}

// ---- Scopes ----

// A new innermost scope; `home` when the temporaries made in it (and in the
// scopes inside it that are none) drop at its end (temp_home).
fn push_scope(kind: i64, node: i64, home: bool) -> i64 {
    let at = SCOPES.len() as i64 / SW;
    SCOPES.push(kind);
    SCOPES.push(ENTRIES.len() as i64 / 2);
    SCOPES.push(node);
    SCOPES.push(-1);
    SCOPES.push(-1);
    SCOPES.push(-1);
    SCOPES.push(0);
    SCOPES.push(0);
    SCOPES.push(if home { 1 } else { 0 });
    at
}

// (0.26.2) The scope a statement temporary drops at the end of, R5's rule
// (conventions.md §2.2, "Temporaries"): its statement's (a `let`, an
// expression statement, a `while` condition, a `defer`'s), or its block's
// for a block's tail and a `let` that may keep a view of it (lower_let
// makes no statement scope for one). Not an arm's, a guard's or a loop's,
// nor a checker's desugaring of an expression (desugared_block: an
// operator's `{ let ==l = a; .. }`, an f-string's, a `?`'s): a temporary
// made there is its statement's.
fn temp_home() -> i64 {
    var s = scope_depth() - 1;
    while s > 0 && SCOPES[s * SW + 8] == 0 {
        s -= 1;
    }
    s
}

// Whether the statements of the block being lowered are temporaries' homes
// (false in a desugared_block's).
static var STMT_HOME: bool = true;

fn scope_depth() -> i64 {
    SCOPES.len() as i64 / SW
}

fn schedule(kind: i64, v: i64) {
    if kind == EN_DEAD && !keeps_storage(v) {
        return;
    }
    ENTRIES.push(kind);
    ENTRIES.push(v);
}

// The entries of scope s, emitted (innermost last registered first).
fn emit_scope(s: i64) {
    let first = SCOPES[s * SW + 1];
    let end = if s + 1 < scope_depth() { SCOPES[(s + 1) * SW + 1] }
        else { ENTRIES.len() as i64 / 2 };
    // (where its drops run: the exit taken, or the scope's own end)
    let at = if EXIT_NODE > 0 { EXIT_NODE } else { SCOPES[s * SW + 2] };
    var e = end - 1;
    while e >= first {
        let kind = ENTRIES[2 * e];
        let v = ENTRIES[2 * e + 1];
        if kind == EN_DROP {
            emit(SK_DROP, v, 0, DS_UNDECIDED, -1, P_LOCALS[v].src, 0, 0, at);
        } else if kind == EN_DEAD {
            emit(SK_DEAD, v, 0, 0, 0, 0, 0, 0, 0);
        } else if kind == EN_DEFER {
            run_defer(v);
        }
        e -= 1;
    }
}

// Leaves scopes down to `depth` (they stay on the stack: an edge out of
// them, `break`, `return`).
fn exit_to(depth: i64, node: i64) {
    let saved = EXIT_NODE;
    EXIT_NODE = node;
    var s = scope_depth() - 1;
    while s >= depth {
        emit_scope(s);
        s -= 1;
    }
    EXIT_NODE = saved;
}

// The innermost scope ends: its entries emitted (when the code reaches its
// end), then it is popped.
fn pop_scope() {
    let s = scope_depth() - 1;
    if reachable() {
        emit_scope(s);
    }
    ENTRIES.truncate(len_arg(2 * SCOPES[s * SW + 1]));
    SCOPES.truncate(len_arg(s * SW));
}

// The loop scope of loop node lp, or -1.
fn loop_scope(lp: i64) -> i64 {
    var s = scope_depth() - 1;
    while s >= 0 {
        if SCOPES[s * SW] == SC_LOOP && SCOPES[s * SW + 2] == lp {
            return s;
        }
        s -= 1;
    }
    -1
}

// A defer's deferred expression, run on an exit.
fn run_defer(d: i64) {
    let e = NODES[d].a;
    if e == 0 {
        return;
    }
    let s = push_scope(SC_STMT, d, true);
    expr_into(e, -1, 0);
    pop_scope_at(s);
}

fn pop_scope_at(s: i64) {
    while scope_depth() > s {
        pop_scope();
    }
}

// ---- Operands ----

fn set_op(k: i64, a: i64, b: i64) {
    OPK = k;
    OPA = a;
    OPB = b;
}

// The current operand written straight to P_OPS: a statement whose
// operands are all known (nothing is emitted between its ops_mark and its
// emit), so no staging.
fn push_now() {
    push_op(OPK, OPA, OPB);
}

// The current operand added to a statement's operands being written
// straight to P_OPS from `at` (n there so far), as each is made: when
// making it emitted statements with operands of their own (after ours),
// ours are moved to the end first. The new start of the operands.
fn ops_add(at: i64, n: i64) -> i64 {
    var start = at;
    if P_OPS.len() as i64 != at + 3 * n {
        start = P_OPS.len() as i64;
        for j in 0..3 * n {
            let w = P_OPS[at + j];
            P_OPS.push(w);
        }
    }
    push_now();
    start
}

// Whether the body built has a move the backstop (diff.vl record_body)
// may forbid: out of a projection or a static. None: it is not scanned.
pub static var MOVES_SUSPECT: bool = false;

// The operand that reads place (l, p) of type ty: a move of a value that
// needs drop when `moving`, but out of a borrowed copy (a copy of a
// borrowed copy is one too), else a copy.
fn place_operand(l: i64, p: i64, ty: i64, moving: bool) {
    if moving && ty > 0 && type_glue(ty) && !has_flag(l, LF_BORROWED) {
        set_op(OK_MOVE, l, p);
        // (a move the backstop looks at: through a projection, or out of
        // a static; a whole local's never is one)
        MOVES_SUSPECT = MOVES_SUSPECT || p != 0 || has_flag(l, LF_STATIC);
    } else {
        set_op(OK_COPY, l, p);
    }
}

// An operand for the value of expression e (moved when `moving`).
fn operand(e: i64, moving: bool) {
    let k = NODES[e].kind;
    let ty = NODES[e].ty;
    if k == NodeKind::Int || k == NodeKind::Char {
        set_op(OK_INT, crate::front::consteval::wrap_int(NODES[e].a, ty), ty);
        return;
    }
    if k == NodeKind::Bool {
        set_op(OK_INT, NODES[e].a, TY_BOOL);
        return;
    }
    if k == NodeKind::Float {
        set_op(OK_FLOAT, NODES[e].a, ty);
        return;
    }
    if k == NodeKind::Unit {
        set_op(OK_UNIT, 0, TY_UNIT);
        return;
    }
    if k == NodeKind::Str {
        set_op(OK_STR, NODES[e].a, ty);
        return;
    }
    if k == NodeKind::CStr {
        set_op(OK_CSTR, NODES[e].a, ty);
        return;
    }
    if k == NodeKind::Ident && NODES[e].res == Res::Const {
        set_op(OK_CONST, NODES[e].y, ty);
        return;
    }
    if k == NodeKind::Ident && NODES[e].res == Res::Fn {
        set_op(OK_FN, NODES[e].y, ty);
        return;
    }
    if is_place_expr(e) {
        if place_of(e) {
            place_operand(PL_L, PL_P, ty, moving);
            return;
        }
    }
    if is_void(ty) || ty == TY_NEVER {
        // (a `()` value, or none: made, then the unit constant)
        expr_into(e, -1, 0);
        set_op(OK_UNIT, 0, TY_UNIT);
        return;
    }
    let t = value_temp(e, false, value_home(ty, false));
    place_operand(t, 0, ty, true);
}

// Whether operand makes e's value without a temporary: a constant, a
// local, a static, a function, a place.
fn is_operand_kind(e: i64) -> bool {
    let k = NODES[e].kind;
    if k == NodeKind::Int || k == NodeKind::Char || k == NodeKind::Bool
        || k == NodeKind::Float || k == NodeKind::Unit || k == NodeKind::Str
        || k == NodeKind::CStr {
        return true;
    }
    if k == NodeKind::Ident {
        let r = NODES[e].res;
        return r == Res::Const || r == Res::Fn || r == Res::Local || r == Res::Static;
    }
    is_place_expr(e)
}

// ---- Places ----

// Whether e is written as a place: a local, a static, a field or tuple
// part of a place (or through a pointer), `*p`, an index.
fn is_place_expr(e: i64) -> bool {
    let k = NODES[e].kind;
    if k == NodeKind::Ident {
        return NODES[e].res == Res::Local || NODES[e].res == Res::Static;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField {
        return true;
    }
    if k == NodeKind::Unary {
        return NODES[e].op == Tok::Star;
    }
    if k == NodeKind::Index {
        return NODES[NODES[e].b].kind != NodeKind::Range;
    }
    false
}

// The place of place expression e (PL_L, PL_P): its base evaluated as it
// must be (a value base into a temporary, a pointer read), the index
// checked. False when e is not one (or its local is unknown).
fn place_of(e: i64) -> bool {
    let k = NODES[e].kind;
    if k == NodeKind::Ident {
        if NODES[e].res == Res::Static {
            PL_L = static_local(NODES[e].a, e);
            PL_P = 0;
            return true;
        }
        if NODES[e].res != Res::Local {
            return false;
        }
        if !mapped(NODES[e].y) {
            unsupported(e);
            PL_L = unit_local();
            PL_P = 0;
            return true;
        }
        return true;
    }
    if k == NodeKind::Unary && NODES[e].op == Tok::Star {
        // `*p`: p's value read (a place holding a pointer, or a temporary)
        deref_place(NODES[e].b);
        return true;
    }
    if k == NodeKind::FieldAccess {
        let base = NODES[e].a;
        let field = NODES[e].x;
        if NODES[e].y == 1 {
            // (through a pointer: `(*p).f`)
            deref_place(base);
            PL_P = proj(PL_P, PJ_FIELD, field);
            return true;
        }
        as_place(base);
        let bt = NODES[base].ty;
        PL_P = proj(PL_P, if is_union_type(bt) { PJ_UNION } else { PJ_FIELD }, field);
        return true;
    }
    if k == NodeKind::TupleField {
        as_place(NODES[e].a);
        PL_P = proj(PL_P, PJ_FIELD, NODES[e].b);
        return true;
    }
    if k == NodeKind::Index && NODES[NODES[e].b].kind != NodeKind::Range {
        return index_place(e);
    }
    false
}

// The place pointer expression e points to: `*e`, or, when e takes an
// address, the place it takes (`*&x` is x; the own pass's statement
// temporary's block stands for `&e`, so `*{ .. }` is the temporary itself).
fn deref_place(e: i64) {
    let k = NODES[e].kind;
    if k == NodeKind::Unary && NODES[e].op == Tok::Amp && is_place_expr(NODES[e].b)
        && place_of(NODES[e].b) {
        return;
    }
    if k == NodeKind::Block && own_temp_block(e) && own_temp_addr(e) {
        own_temp_place(e);
        return;
    }
    as_place(e);
    PL_P = proj(PL_P, PJ_DEREF, 0);
}

// `base[i]`: the base's place first (a pointer's location, a slice's or an
// array's), then the index into a local, then the check.
fn index_place(e: i64) -> bool {
    let base = NODES[e].a;
    let idx = NODES[e].b;
    let bt = undistinct(NODES[base].ty);
    as_place(base);
    let bl = PL_L;
    let bp = PL_P;
    let ik = NODES[idx].kind;
    if bt > 0 && TYPES[bt].kind == TyKind::Array && ik == NodeKind::Int {
        let v = NODES[idx].a;
        if v >= 0 && v < TYPES[bt].b {
            PL_L = bl;
            PL_P = proj(bp, PJ_CONST, v);
            return true;
        }
    }
    // (the index in a local: one the program names, or a temporary)
    var il = -1;
    if ik == NodeKind::Ident && NODES[idx].res == Res::Local && mapped(NODES[idx].y) && PL_P == 0 {
        il = PL_L;
    } else {
        operand(idx, false);
        let it = NODES[idx].ty;
        il = new_temp(it, idx, false);
        emit_use(il, 0, idx);
    }
    if bt > 0 && (NODES[e].p & NODE_IN_BOUNDS) == 0 {
        let tk = TYPES[bt].kind;
        if tk == TyKind::Array {
            let at = ops_mark();
            set_op(OK_COPY, il, 0);
            push_now();
            set_op(OK_INT, TYPES[bt].b, TY_I64);
            push_now();
            emit(SK_ASSERT, 0, 0, AK_BOUNDS, e, 0, at, 2, e);
        } else if tk == TyKind::Slice {
            let len = new_temp(TY_I64, e, false);
            let at = ops_mark();
            set_op(OK_PLACE, bl, bp);
            push_now();
            emit(SK_ASSIGN, len, 0, RV_LEN, 0, 0, at, 1, e);
            let at2 = ops_mark();
            set_op(OK_COPY, il, 0);
            push_now();
            set_op(OK_COPY, len, 0);
            push_now();
            emit(SK_ASSERT, 0, 0, AK_BOUNDS, e, 0, at2, 2, e);
        }
    }
    PL_L = bl;
    PL_P = proj(bp, PJ_INDEX, il);
    true
}

// Whether the value of call e is a copy that its temporary holds without
// owning it (no drop), as the own pass's fresh: a copy of an element a
// collection keeps (borrowed_call), or a generic result read through what
// its arguments keep (parametric_copy: `second<T>(p: *T) -> T { p[1] }`,
// 0.26.1 R8); a block's whose value is one. A call temporary's rule, not
// a scrutinee's (scrutinee_place).
fn copied_call(e: i64) -> bool {
    if borrowed_call(e) {
        return true;
    }
    // (through a block's value, `unsafe { second_cast::<V>(x) }`)
    if NODES[e].kind == NodeKind::Block && NODES[e].a != 0 {
        return copied_call(NODES[e].a);
    }
    NODES[e].kind == NodeKind::Call && crate::front::own::byref::parametric_copy(e)
}

// The place of e, whatever e is: a place expression's, or a temporary's
// holding its value.
fn as_place(e: i64) {
    if is_place_expr(e) && place_of(e) {
        return;
    }
    PL_L = place_temp(e);
    PL_P = 0;
}

// ---- The own pass's statement temporaries, read as what they stand for ----
//
// (0.26.2, until step 7 deletes them) drops.vl's temp_make, temp_value and
// hold_values put a NODE_TEMP block where a statement temporary is made:
// `{ let __own_tv = e; __own_tp = &__own_tv; __own_tf = true; &__own_tv }`
// (or the value itself, `__own_tv`, moved on), with its prelude, the
// `__own_tp` and `__own_tf` lets and their defer, at its statement. The
// builder reads the block as `&e` (or `e`) and makes the temporary itself
// (value_temp, dropped by temp_home's rule); the prelude it skips
// (own_temp_local, temp_defer, own_flag_write).

// Whether b is one: a block flagged NODE_TEMP whose first statement is a
// `let` (an Ident flagged NODE_TEMP is the checker's, temps.vl).
fn own_temp_block(b: i64) -> bool {
    NODES[b].kind == NodeKind::Block && (NODES[b].p & NODE_TEMP) != 0 && NODES[b].count > 0
        && NODES[child(b, 0)].kind == NodeKind::Let
}

// The value of own_temp_block b, e.
fn own_temp_value(b: i64) -> i64 {
    NODES[child(b, 0)].c
}

// Whether own_temp_block b gives its temporary's address (`&e`), not its
// value.
fn own_temp_addr(b: i64) -> bool {
    let tail = NODES[b].a;
    tail != 0 && NODES[tail].kind == NodeKind::Unary && NODES[tail].op == Tok::Amp
}

// The temporary holding the value of own_temp_block b (an address block):
// e moved into it, even when e is a place (hold_args' `&s` of a local
// declared in the argument: the statement keeps it, not s's scope).
fn own_temp_place(b: i64) {
    let e = own_temp_value(b);
    let local = NODES[e].kind == NodeKind::Ident && NODES[e].res == Res::Local;
    PL_L = value_temp(e, copied_call(e),
        if local && LENT_HOME >= 0 { LENT_HOME } else { temp_home() });
    PL_P = 0;
}

// The borrow kind of `&` node e (or a block standing for one) of type ty.
fn ref_kind(e: i64, ty: i64) -> i64 {
    let t = undistinct(ty);
    if t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b == 0 {
        return BK_RAW;
    }
    if (NODES[e].p & NODE_REF_MUT) != 0 || t > 0 && TYPES[t].kind == TyKind::Ptr
        && TYPES[t].b == REF_MUT {
        return BK_MUT;
    }
    BK_SHARED
}

// ---- Statements of assignment ----

// (l, p) = use of the current operand.
fn emit_use(l: i64, p: i64, node: i64) {
    let at = ops_mark();
    push_now();
    emit(SK_ASSIGN, l, p, RV_USE, 0, 0, at, 1, node);
}

// ---- Expressions ----

// Evaluates e and writes its value to (dl, dp); dl = -1: the value is
// discarded.
fn expr_into(e: i64, dl: i64, dp: i64) {
    if e == 0 {
        return;
    }
    STMTS_MADE += 1;
    let k = NODES[e].kind;
    let ty = NODES[e].ty;
    if k == NodeKind::Block {
        lower_block(e, dl, dp);
        return;
    }
    if k == NodeKind::If {
        lower_if(e, dl, dp);
        return;
    }
    if k == NodeKind::Loop || k == NodeKind::While {
        lower_loop(e, dl, dp);
        return;
    }
    if k == NodeKind::For {
        lower_for(e);
        return;
    }
    if k == NodeKind::Match {
        lower_match(e, dl, dp);
        return;
    }
    if k == NodeKind::Call {
        lower_call(e, dl, dp);
        return;
    }
    if k == NodeKind::Assign {
        lower_assign_at(e, false, false);
        return;
    }
    if k == NodeKind::Return {
        lower_return(e);
        return;
    }
    if k == NodeKind::Break {
        lower_break(e);
        return;
    }
    if k == NodeKind::Continue {
        lower_continue(e);
        return;
    }
    if k == NodeKind::Try || k == NodeKind::Interp {
        expr_into(NODES[e].y, dl, dp);
        return;
    }
    if k == NodeKind::Closure {
        // (its env, the struct literal the checker made of its captures, or
        // its function when it is coerced to a fn type; its body is a
        // function of its own)
        if NODES[e].y == 0 {
            unsupported(e);
            return;
        }
        // (a closure that is not `move` captures by access: its env's
        // values are borrowed copies, the owner keeps them; an f-string's
        // holes too)
        let saved = AGG_BORROW;
        AGG_BORROW = (NODES[e].c & CLOSURE_MOVE) == 0
            && NODES[NODES[e].y].kind == NodeKind::StructLit;
        expr_into(NODES[e].y, dl, dp);
        AGG_BORROW = saved;
        return;
    }
    if k == NodeKind::EnumPanic {
        operand(NODES[e].a, false);
        let at = ops_mark();
        push_now();
        emit(SK_INTRINSIC, unit_local(), 0, IK_PANIC, e, 0, at, 1, e);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, e);
        return;
    }
    if k == NodeKind::VecOp {
        lower_vecop(e, dl, dp);
        return;
    }
    if dl < 0 {
        // (a value discarded: a place is mentioned, a value made)
        if is_place_expr(e) {
            if place_of(e) {
                emit(SK_MENTION, PL_L, PL_P, 0, 0, 0, 0, 0, e);
            }
            return;
        }
        if k == NodeKind::Unary || k == NodeKind::Binary || k == NodeKind::Cast {
            // (its operands evaluated for what they do)
            value_temp(e, false, value_home(ty, false));
            return;
        }
        if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
            || k == NodeKind::VariantLit || k == NodeKind::Repeat || k == NodeKind::Index {
            value_temp(e, false, value_home(ty, false));
            return;
        }
        if k == NodeKind::Int || k == NodeKind::Bool || k == NodeKind::Unit || k == NodeKind::Char
            || k == NodeKind::Float || k == NodeKind::Str || k == NodeKind::CStr
            || k == NodeKind::Ident {
            return;
        }
        unsupported(e);
        return;
    }
    if k == NodeKind::Unary {
        lower_unary(e, dl, dp);
        return;
    }
    if k == NodeKind::Binary {
        lower_binary(e, dl, dp);
        return;
    }
    if k == NodeKind::Cast {
        operand(NODES[e].a, false);
        if !reachable() {
            return;
        }
        let at = ops_mark();
        push_now();
        emit(SK_ASSIGN, dl, dp, RV_CAST, ty, 0, at, 1, e);
        return;
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::StructLit
        || k == NodeKind::VariantLit {
        lower_aggregate(e, dl, dp);
        return;
    }
    if k == NodeKind::Repeat {
        operand(NODES[e].a, true);
        let at = ops_mark();
        push_now();
        emit(SK_ASSIGN, dl, dp, RV_REPEAT, TYPES[undistinct(ty)].b, 0, at, 1, e);
        return;
    }
    if k == NodeKind::Index && NODES[NODES[e].b].kind == NodeKind::Range {
        lower_slicing(e, dl, dp);
        return;
    }
    // A plain value: an operand, written.
    if !is_operand_kind(e) {
        unsupported(e);
        return;
    }
    let moving = !has_flag(dl, LF_BORROWED);
    operand(e, moving);
    if !reachable() {
        return;
    }
    emit_use(dl, dp, e);
}

fn lower_unary(e: i64, dl: i64, dp: i64) {
    let op = NODES[e].op;
    let ty = undistinct(NODES[e].ty);
    if op == Tok::Amp {
        as_place(NODES[e].b);
        emit_ref(dl, dp, PL_L, PL_P, ref_kind(e, ty), e);
        return;
    }
    if op == Tok::Star {
        let moving = !has_flag(dl, LF_BORROWED);
        operand(e, moving);
        emit_use(dl, dp, e);
        return;
    }
    operand(NODES[e].b, false);
    if !reachable() {
        return;
    }
    let at = ops_mark();
    push_now();
    let uo = if op == Tok::Minus { UO_NEG } else if op == Tok::Bang { UO_NOT } else { UO_BITNOT };
    emit(SK_ASSIGN, dl, dp, RV_UNARY, uo, e, at, 1, e);
}

fn emit_ref(dl: i64, dp: i64, l: i64, p: i64, kind: i64, node: i64) {
    let at = ops_mark();
    set_op(OK_PLACE, l, p);
    push_now();
    emit(SK_ASSIGN, dl, dp, RV_REF, kind, 0, at, 1, node);
}

fn lower_binary(e: i64, dl: i64, dp: i64) {
    let op = NODES[e].op;
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        // `a && b`: dest = a; if a (or !a) then dest = b, both made in
        // the destination itself (no destination is a place the operands
        // can read: an assignment's value goes to a temporary first,
        // lower_assign)
        expr_into(NODES[e].b, dl, dp);
        if !reachable() {
            return;
        }
        let rhs = new_block();
        let done = new_block();
        let at = ops_mark();
        set_op(OK_COPY, dl, dp);
        push_now();
        if op == Tok::AmpAmp {
            switch_bool(at, done, rhs, e);
        } else {
            switch_bool(at, rhs, done, e);
        }
        enter_block(rhs);
        expr_into(NODES[e].c, dl, dp);
        if reachable() {
            goto(done);
        }
        enter_block(done);
        return;
    }
    // (the left operand held while the right one is made: it may emit
    // statements of its own, with their operands)
    operand(NODES[e].b, false);
    let k1 = OPK;
    let a1 = OPA;
    let b1 = OPB;
    operand(NODES[e].c, false);
    if !reachable() {
        return;
    }
    let at = ops_mark();
    push_op(k1, a1, b1);
    push_now();
    emit(SK_ASSIGN, dl, dp, RV_BINARY, bo_of(op), e, at, 2, e);
}

// The IR's binary operator of token op (an operator or a compound
// assignment's).
fn bo_of(op: Tok) -> i64 {
    match op {
        Tok::Plus | Tok::PlusEq => BO_ADD,
        Tok::Minus | Tok::MinusEq => BO_SUB,
        Tok::Star | Tok::StarEq => BO_MUL,
        Tok::Slash | Tok::SlashEq => BO_DIV,
        Tok::Percent | Tok::PercentEq => BO_REM,
        Tok::Amp | Tok::AmpEq => BO_AND,
        Tok::Pipe | Tok::PipeEq => BO_OR,
        Tok::Caret | Tok::CaretEq => BO_XOR,
        Tok::Shl | Tok::ShlEq => BO_SHL,
        Tok::Shr | Tok::ShrEq => BO_SHR,
        Tok::EqEq => BO_EQ,
        Tok::BangEq => BO_NE,
        Tok::Lt => BO_LT,
        Tok::LtEq => BO_LE,
        Tok::Gt => BO_GT,
        Tok::GtEq => BO_GE,
        _ => 0,
    }
}

// A switch on bool operand `at` (in P_OPS): false to `f`, true to `t`.
fn switch_bool(at: i64, f: i64, t: i64, node: i64) {
    let ti = crate::places::ir::P_TARGETS.len() as i64;
    crate::places::ir::P_TARGETS.push(0);
    crate::places::ir::P_TARGETS.push(f);
    terminate(TK_SWITCH, ti, 1, t, at, 1, node);
}

fn goto(b: i64) {
    terminate(TK_GOTO, b, 0, 0, 0, 0, 0);
}

fn goto_back(b: i64) {
    terminate(TK_GOTO, b, 0, 1, 0, 0, 0);
}

// Struct, tuple, array and variant literals: the parts in the order they
// are written, then the aggregate in declaration order.
fn lower_aggregate(e: i64, dl: i64, dp: i64) {
    let k = NODES[e].kind;
    let ty = NODES[e].ty;
    let n = NODES[e].count;
    // (room for the parts in P_OPS, filled by position: what their values
    // emit goes after it; a union literal names one of its fields, and has
    // a part per field, `()` but the one written)
    let ut = undistinct(ty);
    let slots = if k == NodeKind::StructLit && is_union_type(ut) {
        crate::places::ir::struct_field_count(TYPES[ut].a)
    } else {
        n
    };
    let at = ops_mark();
    for _ in 0..slots {
        push_op(OK_UNIT, 0, TY_UNIT);
    }
    for j in 0..n {
        var i = j;
        var value = child(e, j);
        if k == NodeKind::StructLit {
            i = NODES[value].x;
            value = NODES[value].b;
        } else if k == NodeKind::VariantLit {
            i = crate::front::ast::field_order(e, j);
            value = child(e, i);
        }
        if AGG_BORROW {
            // (only this literal's parts: not those of what they contain)
            AGG_BORROW = false;
            operand(value, true);
            AGG_BORROW = true;
            if OPK == OK_MOVE {
                let t = new_temp(NODES[value].ty, value, true);
                set_op(OK_COPY, OPA, OPB);
                emit_use(t, 0, value);
                set_op(OK_COPY, t, 0);
            }
        } else if k == NodeKind::StructLit {
            arg_operand(value, true);
        } else {
            operand(value, true);
        }
        if i >= 0 && i < slots {
            P_OPS[at + 3 * i] = OPK;
            P_OPS[at + 3 * i + 1] = OPA;
            P_OPS[at + 3 * i + 2] = OPB;
        }
    }
    if !reachable() {
        return;
    }
    var ak = AK_TUPLE;
    var info = 0;
    if k == NodeKind::Array {
        ak = AK_ARRAY;
    } else if k == NodeKind::StructLit {
        ak = if struct_closure(ty) { AK_CLOSURE } else { AK_STRUCT };
        info = ty;
    } else if k == NodeKind::VariantLit {
        ak = AK_VARIANT;
        info = NODES[e].a;
    }
    emit(SK_ASSIGN, dl, dp, RV_AGG, ak, info, at, slots, e);
}

// `a[lo..hi]`: the base (a place, or a pointer's value), the bounds, then
// the slice.
fn lower_slicing(e: i64, dl: i64, dp: i64) {
    let base = NODES[e].a;
    let range = NODES[e].b;
    as_place(base);
    set_op(OK_PLACE, PL_L, PL_P);
    var at = ops_add(ops_mark(), 0);
    if NODES[range].a != 0 {
        operand(NODES[range].a, false);
    } else {
        set_op(OK_UNIT, 0, TY_UNIT);
    }
    at = ops_add(at, 1);
    if NODES[range].b != 0 {
        operand(NODES[range].b, false);
    } else {
        set_op(OK_UNIT, 0, TY_UNIT);
    }
    at = ops_add(at, 2);
    if !reachable() {
        return;
    }
    emit(SK_ASSIGN, dl, dp, RV_SLICE, e, 0, at, 3, e);
}

fn lower_vecop(e: i64, dl: i64, dp: i64) {
    var at = ops_mark();
    var n = 0;
    if NODES[e].a != 0 {
        operand(NODES[e].a, false);
        at = ops_add(at, n);
        n += 1;
    }
    for i in 0..NODES[e].count {
        operand(child(e, i), false);
        at = ops_add(at, n);
        n += 1;
    }
    if !reachable() {
        return;
    }
    var l = dl;
    var p = dp;
    if l < 0 {
        l = if is_void(NODES[e].ty) { unit_local() } else { new_temp(NODES[e].ty, e, false) };
        p = 0;
    }
    emit(SK_INTRINSIC, l, p, IK_VECTOR, e, 0, at, n, e);
}

// ---- Calls ----

// Call n: the callee value (a function value), each argument left to
// right (a `&place` a borrow of its parameter's kind: a receiver's
// exclusive borrow two-phase), then the call; a `!` result ends the block.
fn lower_call(n: i64, dl: i64, dp: i64) {
    let f = NODES[n].x - 1;
    let ty = NODES[n].ty;
    var at = ops_mark();
    var count = 0;
    if f < 0 {
        operand(NODES[n].a, false);
        at = ops_add(at, count);
        count += 1;
    }
    let c_callee = f >= 0 && fn_is_extern(f);
    var ik = -1;
    if f >= 0 && f == crate::front::contracts::checks::CHECK_FN {
        ik = IK_CONTRACT;
        lower_contract(n);
        if dl >= 0 && dl != unit_local() && reachable() && !is_void_dest(dl, dp) {
            set_op(OK_UNIT, 0, TY_UNIT);
            emit_use(dl, dp, n);
        }
        return;
    } else if f >= 0 && crate::arch::intrinsic_of_fn(f) >= 0 {
        ik = IK_ARCH;
    }
    // (a requires clause's `$pre` companion reads its arguments in place:
    // borrowed copies, the call's after it moves them)
    let pre = f >= 0 && is_pre_fn(f);
    for i in 0..NODES[n].count {
        let arg = child(n, i);
        let mode = if f >= 0 { param_mode(f, i) } else { arg_mode_of(arg) };
        lower_arg(i, arg, mode, c_callee || pre);
        if pre && OPK == OK_COPY && !has_flag(OPA, LF_BORROWED) && type_glue(NODES[arg].ty) {
            let t = new_temp(NODES[arg].ty, arg, true);
            emit_use(t, 0, arg);
            set_op(OK_COPY, t, 0);
        }
        at = ops_add(at, count);
        count += 1;
        if !reachable() {
            return;
        }
    }
    var l = dl;
    var p = dp;
    if l < 0 {
        l = if is_void(ty) || ty == TY_NEVER { unit_local() }
            else { new_temp(ty, n, copied_call(n)) };
        p = 0;
    }
    if ik >= 0 {
        emit(SK_INTRINSIC, l, p, ik, n, 0, at, count, n);
    } else {
        emit(SK_CALL, l, p, f, 0, 0, at, count, n);
    }
    if ty == TY_NEVER {
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, n);
    }
}

// (0.26.2) The conjuncts and the shown values of the contract checks being
// lowered (lower_contract), each check's from its mark on.
static var CONJS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
static var SHOWN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// (0.26.2) A contract check, call n, `std::contract_check(COND, SITE,
// CHECK, HOLES..)` (front/contracts): each conjunct of COND (its `&&`
// chain, checks.vl conjuncts) evaluated and branched on in turn, exactly
// once on every path as `&&` evaluates it, its failing path made by
// contract_failure (which names it). The same for an assert's (whose
// condition may change state: `assert(v.pop() == x)`) as for a
// requires', ensures' or invariant's (the form entry facts read,
// middle/entryfacts.vl).
fn lower_contract(n: i64) {
    let cmark = CONJS.count;
    crate::front::contracts::checks::conjuncts(child(n, 0), &CONJS);
    let cend = CONJS.count;
    for k in cmark..cend {
        let conj = CONJS.get(k);
        operand(conj, false);
        if !reachable() {
            break;
        }
        let pass = new_block();
        let fail = new_block();
        let at = ops_mark();
        push_now();
        switch_bool(at, fail, pass, conj);
        enter_block(fail);
        contract_failure(n, conj);
        enter_block(pass);
    }
    CONJS.count = cmark;
}

// The failing path of conjunct conj of contract check n, in the block
// being made: the values its report shows (the conjunct's operands, or an
// f-string message's holes, checks.vl check_values), made first as they
// may emit statements of their own, then
//     intrinsic contract_check(const false, SITE, VALUE..) [d n, e conj]
//     unreachable
// (the message is check_message's, of n's check and conj; ops[0] is the
// condition's value, false here, as an assert's was before 0.26.2).
fn contract_failure(n: i64, conj: i64) {
    let smark = SHOWN.count;
    crate::front::contracts::checks::check_values(n, conj, &SHOWN);
    let send = SHOWN.count;
    let vals = OP_HOLD.len() as i64;
    OP_HOLD.push(OK_INT);
    OP_HOLD.push(0);
    OP_HOLD.push(TY_BOOL);
    operand(child(n, 1), false);
    OP_HOLD.push(OPK);
    OP_HOLD.push(OPA);
    OP_HOLD.push(OPB);
    for i in smark..send {
        operand(SHOWN.get(i), false);
        OP_HOLD.push(OPK);
        OP_HOLD.push(OPA);
        OP_HOLD.push(OPB);
    }
    SHOWN.count = smark;
    let count = (OP_HOLD.len() as i64 - vals) / 3;
    let at = ops_mark();
    for j in 0..count {
        push_op(OP_HOLD[vals + 3 * j], OP_HOLD[vals + 3 * j + 1], OP_HOLD[vals + 3 * j + 2]);
    }
    OP_HOLD.truncate(len_arg(vals));
    if reachable() {
        emit(SK_INTRINSIC, unit_local(), 0, IK_CONTRACT, n, conj, at, count, conj);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, conj);
    }
}

// Operands held while the ones after them are made (lower_contract).
static var OP_HOLD: Vec<i64, Comp> = Vec::new_in(Comp {});

// The mode of an argument of a call through a function value: by its type.
fn arg_mode_of(arg: i64) -> i64 {
    let t = undistinct(NODES[arg].ty);
    if t > 0 && TYPES[t].kind == TyKind::Ptr {
        return if TYPES[t].b == REF_SHARED { crate::front::own::kinds::P_SHARED }
            else if TYPES[t].b == REF_MUT { P_MUT } else { P_RAW };
    }
    P_VALUE
}

// Argument i (node arg) of call n: its operand (OPK..).
fn lower_arg(i: i64, arg: i64, mode: i64, c_callee: bool) {
    let k = NODES[arg].kind;
    let temp = k == NodeKind::Block && own_temp_block(arg) && own_temp_addr(arg);
    if k == NodeKind::Unary && NODES[arg].op == Tok::Amp || temp {
        // (`&value` lent, the own pass's temporary's block: `&e`)
        let operand_e = if temp { own_temp_value(arg) } else { NODES[arg].b };
        let at_ty = undistinct(NODES[arg].ty);
        if temp {
            own_temp_place(arg);
        } else {
            as_place(operand_e);
        }
        let pl = PL_L;
        let pp = PL_P;
        var kind = BK_SHARED;
        if c_callee || mode == P_RAW || at_ty > 0 && TYPES[at_ty].kind == TyKind::Ptr
            && TYPES[at_ty].b == 0 {
            kind = BK_RAW;
        } else if mode == P_MUT || (NODES[arg].p & NODE_REF_MUT) != 0 {
            let receiver = i == 0 && NODES[arg].start == NODES[operand_e].start;
            kind = if receiver { BK_MUT2 } else { BK_MUT };
        }
        let t = new_temp(at_ty, arg, false);
        emit_ref(t, 0, pl, pp, kind, arg);
        set_op(OK_MOVE, t, 0);
        return;
    }
    // (a value: moved into a by-value parameter; read where the callee
    // only reads it: a raw or C parameter, a view)
    let moving = mode == P_VALUE && !c_callee;
    arg_operand(arg, moving);
}

// ---- Assignment ----

// `p = v` and `p op= v`: the value first, then the place, then the write
// (the old value is not dropped: the own pass's desugaring is what drops,
// lower_own_assign).
fn lower_assign(n: i64) {
    let op = NODES[n].op;
    let target = NODES[n].b;
    let value = NODES[n].c;
    if op == Tok::Eq {
        operand(value, true);
        if !reachable() {
            return;
        }
        let ok = OPK;
        let oa = OPA;
        let ob = OPB;
        if !place_of(target) {
            unsupported(target);
            return;
        }
        set_op(ok, oa, ob);
        emit_use(PL_L, PL_P, n);
        return;
    }
    // `p op= v`: p = p op v, the value first
    operand(value, false);
    let vk = OPK;
    let va = OPA;
    let vb = OPB;
    if !reachable() || !place_of(target) {
        return;
    }
    let at = ops_mark();
    set_op(OK_COPY, PL_L, PL_P);
    push_now();
    set_op(vk, va, vb);
    push_now();
    emit(SK_ASSIGN, PL_L, PL_P, RV_BINARY, bo_of(op), n, at, 2, n);
}

// (0.26.2) An assignment: `p = v` on an owned place drops p's old value
// wherever it stands (a statement, a block's tail, an arm's value, inside
// an expression: Rust's rule; the own pass drops it only at the first
// two, and leaked it elsewhere), `tmp = v;
// drop(p); p = move tmp` (§3.8: the right side, then the place and its
// index, then the old value's drop, then the write; the right side's
// temporaries at the statement's end, ea70255c), elaboration deciding the
// drop (removed where p is moved, under a flag where it may be). `stmt`:
// in a statement's place; `own`: the own pass desugared it (drops.vl
// assign_drops), which decides the drop in a statement's place until step
// 7 deletes it (--places-diff reports where drops_old decides otherwise);
// elsewhere drops_old decides.
fn lower_assign_at(n: i64, stmt: bool, own: bool) {
    if stmt && crate::places::PLACES_DIFF && drops_old(n) != own {
        crate::places::diff::assign_mismatch(n, own);
    }
    if !own && (stmt || !drops_old(n)) {
        lower_assign(n);
        return;
    }
    let target = NODES[n].b;
    let value = NODES[n].c;
    let tmp = new_temp(NODES[value].ty, n, false);
    expr_into(value, tmp, 0);
    if !reachable() {
        return;
    }
    if !place_of(target) {
        unsupported(target);
        return;
    }
    emit(SK_DROP, PL_L, PL_P, DS_UNDECIDED, -1, own_assign_old(n), 0, 0, n);
    set_op(OK_MOVE, tmp, 0);
    emit_use(PL_L, PL_P, n);
}

// Whether assignment n, in a statement's place, drops the old value: `=`
// (not one the checker or the own pass writes without a drop, NO_DROP) of
// a value with glue to a place of names, fields, `*` and indexes (not one
// a call makes, nor a raw access, NODE_RAW), with drops on; as the own
// pass's assign_drops.
fn drops_old(n: i64) -> bool {
    if !DROPS || NODES[n].op != Tok::Eq || (NODES[n].p & NO_DROP) != 0 {
        return false;
    }
    let target = NODES[n].b;
    target != 0 && NODES[n].c != 0 && NODES[target].ty > 0 && type_glue(NODES[target].ty)
        && indexable_place(target)
}

// ---- Control flow ----

fn lower_return(n: i64) {
    let v = NODES[n].a;
    if v != 0 {
        expr_into(v, 0, 0);
    }
    if !reachable() {
        return;
    }
    exit_to(0, n);
    goto(RET_BLOCK);
}

fn lower_break(n: i64) {
    let s = loop_scope(NODES[n].x);
    if s < 0 {
        unsupported(n);
        return;
    }
    let v = NODES[n].b;
    if v != 0 {
        let rl = SCOPES[s * SW + 5];
        if rl >= 0 {
            expr_into(v, rl, SCOPES[s * SW + 6]);
        } else {
            expr_into(v, -1, 0);
        }
    }
    if !reachable() {
        return;
    }
    exit_to(s + 1, n);
    goto(SCOPES[s * SW + 3]);
}

fn lower_continue(n: i64) {
    let s = loop_scope(NODES[n].x);
    if s < 0 {
        unsupported(n);
        return;
    }
    exit_to(s + 1, n);
    if SCOPES[s * SW + 7] != 0 {
        goto_back(SCOPES[s * SW + 4]);
    } else {
        goto(SCOPES[s * SW + 4]);
    }
}

fn lower_if(n: i64, dl: i64, dp: i64) {
    let fixed = crate::front::features::static_condition(NODES[n].a);
    if fixed >= 0 {
        let live = if fixed == 1 { NODES[n].b } else { NODES[n].c };
        if live != 0 {
            expr_into(live, dl, dp);
        }
        return;
    }
    operand(NODES[n].a, false);
    if !reachable() {
        return;
    }
    let then_b = new_block();
    let has_else = NODES[n].c != 0;
    let else_b = if has_else { new_block() } else { -1 };
    let join = new_block();
    let at = ops_mark();
    push_now();
    switch_bool(at, if has_else { else_b } else { join }, then_b, n);
    enter_block(then_b);
    expr_into(NODES[n].b, dl, dp);
    if reachable() {
        goto(join);
    }
    if has_else {
        enter_block(else_b);
        expr_into(NODES[n].c, dl, dp);
        if reachable() {
            goto(join);
        }
    }
    enter_block(join);
}

// `loop` and `while`: a header block; the body's scopes; `break` to the
// exit, `continue` to the header (a back edge).
fn lower_loop(n: i64, dl: i64, dp: i64) {
    let head = new_block();
    let exit = new_block();
    goto(head);
    enter_block(head);
    let s = push_scope(SC_LOOP, n, false);
    SCOPES[s * SW + 2] = n;
    SCOPES[s * SW + 3] = exit;
    SCOPES[s * SW + 4] = head;
    SCOPES[s * SW + 5] = dl;
    SCOPES[s * SW + 6] = dp;
    // (`continue` takes the back edge of an uncounted loop)
    SCOPES[s * SW + 7] = 1;
    if NODES[n].kind == NodeKind::While {
        // (the condition is a unit of its own: its temporaries drop when
        // it is evaluated)
        let c = push_scope(SC_STMT, n, true);
        operand(NODES[n].b, false);
        let at = ops_mark();
        push_now();
        let body = new_block();
        let out = new_block();
        // (the condition's temporaries end on both edges)
        switch_bool(at, out, body, n);
        enter_block(out);
        emit_scope(c);
        goto(exit);
        enter_block(body);
        pop_scope_at(c);
        expr_into(NODES[n].c, -1, 0);
    } else {
        expr_into(NODES[n].b, -1, 0);
    }
    if reachable() {
        goto_back(head);
    }
    pop_scope_at(s);
    enter_block(exit);
    if NODES[n].kind == NodeKind::While && dl >= 0 && dl != unit_local() {
        // (a `while` is `()`)
        set_op(OK_UNIT, 0, TY_UNIT);
        emit_use(dl, dp, n);
    }
}

// `for p in a..b` (the counted form the checker leaves): the bounds once,
// the counter's copy bound each round; `continue` to the increment.
fn lower_for(n: i64) {
    let range = NODES[n].c;
    let rt = NODES[range].ty;
    let inclusive = NODES[range].c != 0;
    operand(NODES[range].a, false);
    let counter = new_temp(rt, n, false);
    emit_use(counter, 0, n);
    operand(NODES[range].b, false);
    let end = new_temp(rt, n, false);
    emit_use(end, 0, n);
    if !reachable() {
        return;
    }
    let test = new_block();
    let body = new_block();
    let next = new_block();
    let exit = new_block();
    goto(test);
    enter_block(test);
    let cmp = new_temp(TY_BOOL, n, false);
    let at = ops_mark();
    set_op(OK_COPY, counter, 0);
    push_now();
    set_op(OK_COPY, end, 0);
    push_now();
    emit(SK_ASSIGN, cmp, 0, RV_BINARY, if inclusive { BO_LE } else { BO_LT }, n, at, 2, n);
    let at2 = ops_mark();
    set_op(OK_COPY, cmp, 0);
    push_now();
    switch_bool(at2, exit, body, n);
    enter_block(body);
    let s = push_scope(SC_LOOP, n, false);
    SCOPES[s * SW + 2] = n;
    SCOPES[s * SW + 3] = exit;
    SCOPES[s * SW + 4] = next;
    let arm = push_scope(SC_ARM, n, false);
    let pat = NODES[n].b;
    if NODES[pat].kind == NodeKind::PatBind && NODES[pat].x >= 0 {
        let l = user_local(NODES[pat].x, pat, false);
        live(l);
        schedule(EN_DEAD, l);
        set_op(OK_COPY, counter, 0);
        emit_use(l, 0, pat);
    } else if NODES[pat].kind != NodeKind::PatWild {
        unsupported(pat);
    }
    expr_into(NODES[n].d, -1, 0);
    pop_scope_at(arm);
    if reachable() {
        goto(next);
    }
    pop_scope_at(s);
    enter_block(next);
    if inclusive {
        // (the last round: counter == end)
        let last = new_temp(TY_BOOL, n, false);
        let at3 = ops_mark();
        set_op(OK_COPY, counter, 0);
        push_now();
        set_op(OK_COPY, end, 0);
        push_now();
        emit(SK_ASSIGN, last, 0, RV_BINARY, BO_EQ, n, at3, 2, n);
        let at4 = ops_mark();
        set_op(OK_COPY, last, 0);
        push_now();
        let inc = new_block();
        switch_bool(at4, inc, exit, n);
        enter_block(inc);
    }
    let at5 = ops_mark();
    set_op(OK_COPY, counter, 0);
    push_now();
    set_op(OK_INT, 1, rt);
    push_now();
    emit(SK_ASSIGN, counter, 0, RV_BINARY, BO_ADD, n, at5, 2, n);
    goto(test);
    enter_block(exit);
}

// ---- match and patterns ----

// `match`: the scrutinee's place (a temporary of the statement when it is
// a value), then each arm in order: its pattern tested (a branch to the
// next arm on a mismatch), its guard evaluated with the bindings as
// borrowed copies, then the bindings made (moved out, unless the own pass
// made them borrow) and the body; no arm matching is unreachable.
fn lower_match(n: i64, dl: i64, dp: i64) {
    let scrut = NODES[n].a;
    let st = NODES[scrut].ty;
    scrutinee_place(scrut);
    if !reachable() || st == TY_NEVER {
        return;
    }
    let sl = PL_L;
    let sp = PL_P;
    if switch_cases(n, st) {
        lower_match_switch(n, st, sl, sp, dl, dp);
        return;
    }
    let join = new_block();
    for i in 0..NODES[n].count {
        let arm = child(n, i);
        let pat = NODES[arm].a;
        let fail = new_block();
        let s = push_scope(SC_ARM, arm, false);
        test_pattern(pat, sl, sp, st, fail);
        let guard = NODES[arm].b;
        if guard != 0 && reachable() {
            phase_begin(-1);
            bind_pattern(pat, sl, sp, st, true);
            let g = push_scope(SC_STMT, guard, false);
            operand(guard, false);
            if reachable() {
                let at = ops_mark();
                push_now();
                let ok = new_block();
                let refused = new_block();
                switch_bool(at, refused, ok, arm);
                enter_block(refused);
                exit_to(s, arm);
                goto(fail);
                enter_block(ok);
            }
            pop_scope_at(g);
        }
        if reachable() {
            phase_begin(-1);
            bind_pattern(pat, sl, sp, st, false);
            expr_into(NODES[arm].c, dl, dp);
        }
        pop_scope_at(s);
        if reachable() {
            goto(join);
        }
        enter_block(fail);
    }
    terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, n);
    enter_block(join);
}

// (0.26.1, R4) A match lowered as one switch: its (value, arm) pairs, each
// value once (for the first arm that has it), and the arm that is the
// default (a wildcard or a binding, the last arm), -1 when none is.
static var SW_CASES: Vec<i64, Comp> = Vec::new_in(Comp {});
static var SW_DEFAULT: i64 = -1;
// The referent type the arms match through (their patterns' PAT_DEREF),
// 0 when they match the value itself.
static var SW_INNER: i64 = 0;

// Whether match n on a value of type st is one switch (R4, as
// middle/lower/matching.vl's switch_cases): no guards; an integer
// scrutinee matched against literals, ranges and their alternatives, or
// an enum (not one with the null niche) matched by variant, whose fields
// only bind; a wildcard or binding, if any, the last arm; at least 6
// values, or 4 for an enum with fields. Fills SW_CASES and SW_DEFAULT.
fn switch_cases(n: i64, st: i64) -> bool {
    let count = NODES[n].count;
    SW_INNER = -1;
    for i in 0..count {
        let p = NODES[child(n, i)].a;
        let kind = NODES[p].kind;
        if kind != NodeKind::PatWild && kind != NodeKind::PatBind {
            let r = pattern_referent(p, st);
            if SW_INNER >= 0 && r != SW_INNER {
                return false;
            }
            SW_INNER = r;
        }
    }
    let t = undistinct(if SW_INNER > 0 { SW_INNER } else { st });
    if t <= 0 {
        return false;
    }
    let integer = is_integer(t);
    let is_enum = TYPES[t].kind == TyKind::Enum;
    if !integer && !is_enum || is_enum && enum_niche(TYPES[t].a) {
        return false;
    }
    SW_CASES.clear();
    SW_DEFAULT = -1;
    for i in 0..count {
        let arm = child(n, i);
        let p = NODES[arm].a;
        if NODES[arm].b != 0 {
            return false;
        }
        let kind = NODES[p].kind;
        if kind == NodeKind::PatWild || kind == NodeKind::PatBind {
            if i != count - 1 {
                return false;
            }
            SW_DEFAULT = i;
        } else if !add_switch_values(p, i, t, integer) {
            return false;
        }
    }
    let cases = SW_CASES.len() as i64 / 2;
    cases >= 6 || is_enum && is_compound(t) && cases >= 4
}

// Adds the values pattern p matches (for arm `arm`, unless an earlier arm
// has them) of the integer or enum type t; false when p is not a set of
// values.
fn add_switch_values(p: i64, arm: i64, t: i64, integer: bool) -> bool {
    let kind = NODES[p].kind;
    if kind == NodeKind::PatLit && integer {
        add_switch_value(NODES[p].x, arm);
        return true;
    }
    if kind == NodeKind::PatRange && integer {
        let count = int_key(NODES[p].y, t) - int_key(NODES[p].x, t) + 1;
        if count < 1 || count > 256 || SW_CASES.len() as i64 + 2 * count > 2048 {
            return false;
        }
        for k in 0..count {
            add_switch_value(wrap_int(NODES[p].x + k, t), arm);
        }
        return true;
    }
    if kind == NodeKind::PatVariant && !integer {
        for i in 0..NODES[p].count {
            if !is_irrefutable(child(p, i)) {
                return false;
            }
        }
        add_switch_value(variant_discr(NODES[p].x), arm);
        return true;
    }
    if kind == NodeKind::PatOr && binding_count(p) == 0 {
        for i in 0..NODES[p].count {
            if !add_switch_values(child(p, i), arm, t, integer) {
                return false;
            }
        }
        return true;
    }
    false
}

fn add_switch_value(value: i64, arm: i64) {
    var i = 0;
    while i < SW_CASES.len() as i64 {
        if SW_CASES[i] == value {
            return;
        }
        i += 2;
    }
    SW_CASES.push(value);
    SW_CASES.push(arm);
}

// Match n, its scrutinee at (sl, sp) of type st, as one switch (R4; after
// switch_cases said it is one): `switch copy P` for an integer, `_d =
// discriminant P; switch copy _d` for an enum (P is `*(sl, sp)` when the
// arms match through the reference, SW_INNER), a target per value; every
// arm in a block of its own that binds and lowers the body. An enum's arm
// with several values is reached through a block per value (a goto to
// the arm's): elaboration learns the variant of P from the edge of a
// target with one value.
fn lower_match_switch(n: i64, st: i64, sl: i64, sp: i64, dl: i64, dp: i64) {
    let inner = SW_INNER;
    let t = undistinct(if inner > 0 { inner } else { st });
    let pp = if inner > 0 { proj(sp, PJ_DEREF, 0) } else { sp };
    let integer = is_integer(t);
    var at = 0;
    if integer {
        at = ops_mark();
        set_op(OK_COPY, sl, pp);
        push_now();
    } else {
        let d = new_local(enum_tag_ty(t), LF_TEMP, -1, n);
        let a0 = ops_mark();
        set_op(OK_PLACE, sl, pp);
        push_now();
        emit(SK_ASSIGN, d, 0, RV_DISCR, 0, 0, a0, 1, n);
        at = ops_mark();
        set_op(OK_COPY, d, 0);
        push_now();
    }
    let join = new_block();
    let count = NODES[n].count;
    let first = new_block();
    for _ in 1..count {
        new_block();
    }
    var default = -1;
    if SW_DEFAULT >= 0 {
        default = first + SW_DEFAULT;
    } else {
        default = new_block();
    }
    let cases = SW_CASES.len() as i64 / 2;
    let ti = crate::places::ir::P_TARGETS.len() as i64;
    for c in 0..cases {
        let arm = SW_CASES[2 * c + 1];
        var many = false;
        if !integer {
            for o in 0..cases {
                many = many || o != c && SW_CASES[2 * o + 1] == arm;
            }
        }
        crate::places::ir::P_TARGETS.push(SW_CASES[2 * c]);
        crate::places::ir::P_TARGETS.push(if many { new_block() } else { first + arm });
    }
    terminate(TK_SWITCH, ti, cases, default, at, 1, n);
    for c in 0..cases {
        let arm = SW_CASES[2 * c + 1];
        let target = crate::places::ir::P_TARGETS[ti + 2 * c + 1];
        if target != first + arm {
            enter_block(target);
            goto(first + arm);
        }
    }
    let catch_all = SW_DEFAULT;
    for i in 0..count {
        let arm = child(n, i);
        enter_block(first + i);
        let s = push_scope(SC_ARM, arm, false);
        phase_begin(-1);
        bind_pattern(NODES[arm].a, sl, sp, st, false);
        expr_into(NODES[arm].c, dl, dp);
        pop_scope_at(s);
        if reachable() {
            goto(join);
        }
    }
    if catch_all < 0 {
        enter_block(default);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, n);
    }
    enter_block(join);
}

// The place a scrutinee (or a pattern `let`'s initializer) is matched in
// (PL_L, PL_P): a place expression's, else a temporary of the statement,
// borrowed when the own pass made the match borrow (MATCH_BYREF, a copying
// getter's result). Not for a parametric copy (copied_call): the own pass
// drops the bindings of `let (s, k) = mk::<R>()` (let_drops looks at
// borrowed_call only), R10.
fn scrutinee_place(e: i64) {
    if is_place_expr(e) && place_of(e) {
        return;
    }
    let borrowed = borrowed_call(e) || (NODES[e].p & MATCH_BYREF) != 0;
    PL_L = value_temp(e, borrowed, value_home(NODES[e].ty, borrowed));
    PL_P = 0;
}

// Branches to block `fail` unless place (l, p) of type ty matches pattern
// pat: discriminant switches, comparisons; no binding made.
fn test_pattern(pat: i64, l: i64, p: i64, ty: i64, fail: i64) {
    if !reachable() || ty == TY_NEVER {
        return;
    }
    var pp = p;
    var t = ty;
    let inner = pattern_referent(pat, t);
    if inner != 0 {
        pp = proj(pp, PJ_DEREF, 0);
        t = inner;
    }
    let k = NODES[pat].kind;
    if k == NodeKind::PatLit {
        compare_const(l, pp, t, BO_EQ, NODES[pat].x, fail, pat);
    } else if k == NodeKind::PatRange {
        compare_const(l, pp, t, BO_GE, NODES[pat].x, fail, pat);
        compare_const(l, pp, t, BO_LE, NODES[pat].y, fail, pat);
    } else if k == NodeKind::PatOr {
        let ok = new_block();
        let last = NODES[pat].count - 1;
        for i in 0..last {
            let next = new_block();
            test_pattern(child(pat, i), l, pp, t, next);
            if reachable() {
                goto(ok);
            }
            enter_block(next);
        }
        test_pattern(child(pat, last), l, pp, t, fail);
        if reachable() {
            goto(ok);
        }
        enter_block(ok);
    } else if k == NodeKind::PatTuple {
        let tt = undistinct(t);
        for i in 0..NODES[pat].count {
            test_pattern(child(pat, i), l, proj(pp, PJ_FIELD, i), type_elem(tt, i), fail);
        }
    } else if k == NodeKind::PatVariant {
        let v = NODES[pat].x;
        switch_variant(l, pp, t, v, fail, pat);
        let vp = proj(pp, PJ_VARIANT, v);
        for i in 0..NODES[pat].count {
            test_pattern(child(pat, i), l, proj(vp, PJ_FIELD, i), variant_field(v, i), fail);
        }
    }
}

// `_c = copy (l, p) OP const value; switch _c [false: fail]`.
fn compare_const(l: i64, p: i64, ty: i64, op: i64, value: i64, fail: i64, node: i64) {
    let c = new_local(TY_BOOL, LF_TEMP, -1, node);
    let at = ops_mark();
    set_op(OK_COPY, l, p);
    push_now();
    set_op(OK_INT, value, ty);
    push_now();
    emit(SK_ASSIGN, c, 0, RV_BINARY, op, 0, at, 2, node);
    let at2 = ops_mark();
    set_op(OK_COPY, c, 0);
    push_now();
    let next = new_block();
    switch_bool(at2, fail, next, node);
    enter_block(next);
}

// `_d = discriminant (l, p); switch _d [discr(v): next, otherwise: fail]`:
// what makes `(l, p) as v` valid in the blocks it dominates.
fn switch_variant(l: i64, p: i64, ty: i64, v: i64, fail: i64, node: i64) {
    let d = new_local(enum_tag_ty(undistinct(ty)), LF_TEMP, -1, node);
    let at = ops_mark();
    set_op(OK_PLACE, l, p);
    push_now();
    emit(SK_ASSIGN, d, 0, RV_DISCR, 0, 0, at, 1, node);
    let at2 = ops_mark();
    set_op(OK_COPY, d, 0);
    push_now();
    let next = new_block();
    let ti = crate::places::ir::P_TARGETS.len() as i64;
    crate::places::ir::P_TARGETS.push(variant_discr(v));
    crate::places::ir::P_TARGETS.push(next);
    terminate(TK_SWITCH, ti, 1, fail, at2, 1, node);
    enter_block(next);
}

// The AST locals bound in this phase of an arm (a guard's borrowed copies,
// then the body's bindings) and their IR locals: pairs. An or-pattern's
// alternatives bind the same locals.
static var PHASE: Vec<i64, Comp> = Vec::new_in(Comp {});
// The statement scope a pattern `let` binds out of (-1: none, the arm's).
static var BIND_SCOPE: i64 = -1;

fn phase_begin(s: i64) {
    PHASE.clear();
    BIND_SCOPE = s;
}

// Binds the variables of pattern pat, known to match place (l, p) of type
// ty: each a move of its part (a copy when it borrows: `guard`, the own
// pass's BYREF, a part of a borrowed copy), or a reference to it (PAT_REF).
// An or-pattern's alternatives are tested again, in order, to bind the one
// that matched.
fn bind_pattern(pat: i64, l: i64, p: i64, ty: i64, guard: bool) {
    if !reachable() || ty == TY_NEVER {
        return;
    }
    var pp = p;
    var t = ty;
    let inner = pattern_referent(pat, t);
    if inner != 0 {
        pp = proj(pp, PJ_DEREF, 0);
        t = inner;
    }
    let k = NODES[pat].kind;
    if k == NodeKind::PatBind {
        bind_one(pat, l, pp, t, guard);
    } else if k == NodeKind::PatTuple {
        let tt = undistinct(t);
        for i in 0..NODES[pat].count {
            bind_pattern(child(pat, i), l, proj(pp, PJ_FIELD, i), type_elem(tt, i), guard);
        }
    } else if k == NodeKind::PatVariant {
        let v = NODES[pat].x;
        let vp = proj(pp, PJ_VARIANT, v);
        for i in 0..NODES[pat].count {
            bind_pattern(child(pat, i), l, proj(vp, PJ_FIELD, i), variant_field(v, i), guard);
        }
    } else if k == NodeKind::PatOr && binding_count(pat) > 0 {
        let ok = new_block();
        let last = NODES[pat].count - 1;
        for i in 0..last {
            let next = new_block();
            test_pattern(child(pat, i), l, pp, t, next);
            bind_pattern(child(pat, i), l, pp, t, guard);
            if reachable() {
                goto(ok);
            }
            enter_block(next);
        }
        bind_pattern(child(pat, last), l, pp, t, guard);
        if reachable() {
            goto(ok);
        }
        enter_block(ok);
    }
}

fn bind_one(pat: i64, l: i64, p: i64, ty: i64, guard: bool) {
    let al = NODES[pat].x;
    if al < 0 {
        return;
    }
    let by_ref = binds_ref(pat);
    let borrowed = !by_ref && (guard || ast_borrowed(al) || has_flag(l, LF_BORROWED));
    // (the IR local: the phase's when an earlier alternative made it)
    var ir = -1;
    var i = 0;
    while i < PHASE.len() as i64 {
        if PHASE[i] == al {
            ir = PHASE[i + 1];
            break;
        }
        i += 2;
    }
    let first = ir < 0;
    if first {
        ir = user_local(al, pat, borrowed);
        PHASE.push(al);
        PHASE.push(ir);
    }
    live(ir);
    if first {
        schedule_outer(BIND_SCOPE, EN_DEAD, ir);
    }
    if by_ref {
        let rt = undistinct(ast_local_ty(al));
        let kind = if rt > 0 && TYPES[rt].kind == TyKind::Ptr && TYPES[rt].b == REF_MUT { BK_MUT }
            else { BK_SHARED };
        emit_ref(ir, 0, l, p, kind, pat);
    } else {
        place_operand(l, p, ty, !borrowed);
        emit_use(ir, 0, pat);
    }
    if first && !has_flag(ir, LF_BORROWED) && needs_drop(P_LOCALS[ir].ty) {
        schedule_outer(BIND_SCOPE, EN_DROP, ir);
    }
}

// `let PAT = init;` for a pattern other than a name: the initializer's
// place, its pattern tested (an irrefutable one: a mismatch is
// unreachable), then its parts bound, in the block's scope (s: the
// statement's scope).
fn lower_let_pattern(pat: i64, init: i64, s: i64) {
    if init == 0 {
        unsupported(pat);
        return;
    }
    scrutinee_place(init);
    if !reachable() {
        return;
    }
    let l = PL_L;
    let p = PL_P;
    let ty = NODES[init].ty;
    let targets = crate::places::ir::P_TARGETS.len() as i64;
    let fail = new_block();
    test_pattern(pat, l, p, ty, fail);
    if crate::places::ir::P_TARGETS.len() as i64 != targets && reachable() {
        let ok = new_block();
        goto(ok);
        enter_block(fail);
        terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, pat);
        enter_block(ok);
    }
    phase_begin(s);
    bind_pattern(pat, l, p, ty, false);
    BIND_SCOPE = -1;
}

// ---- Blocks and statements ----

fn lower_block(b: i64, dl: i64, dp: i64) {
    let flags = NODES[b].p;
    if (flags & NODE_TEMP) != 0 && own_temp_block(b) {
        // (the own pass's statement temporary: `&e`, or `e`)
        let e = own_temp_value(b);
        if !own_temp_addr(b) {
            expr_into(e, dl, dp);
            return;
        }
        own_temp_place(b);
        if dl >= 0 && reachable() {
            emit_ref(dl, dp, PL_L, PL_P, ref_kind(NODES[b].a, NODES[b].ty), b);
        }
        return;
    }
    let asg = own_assign_of(b);
    if asg > 0 {
        // (the own pass's desugaring of an owned assignment: the
        // assignment it was made of, lower_assign_at)
        lower_assign_at(asg, true, true);
        if dl >= 0 && dl != unit_local() && reachable() {
            set_op(OK_UNIT, 0, TY_UNIT);
            emit_use(dl, dp, b);
        }
        return;
    }
    // (a transparent desugaring: no scope of its own; its statements', and
    // a desugared expression's, are no temporaries' homes)
    let scoped = (flags & (NODE_TEMP | BLOCK_TRANSPARENT)) == 0;
    let home = scoped && !desugared_block(b);
    let s = if scoped { push_scope(SC_BLOCK, b, home) } else { -1 };
    let saved_home = STMT_HOME;
    let saved_lent = LENT_HOME;
    STMT_HOME = home;
    LENT_HOME = -1;
    for i in 0..NODES[b].count {
        if !reachable() {
            break;
        }
        lower_stmt(child(b, i));
    }
    STMT_HOME = saved_home;
    LENT_HOME = saved_lent;
    let tail = NODES[b].a;
    if tail != 0 && NODES[tail].kind == NodeKind::Assign {
        if reachable() {
            lower_assign_at(tail, true, false);
        }
        if dl >= 0 && dl != unit_local() && reachable() && !is_void_dest(dl, dp) {
            set_op(OK_UNIT, 0, TY_UNIT);
            emit_use(dl, dp, b);
        }
        if scoped {
            pop_scope_at(s);
        }
        return;
    }
    if tail != 0 && reachable() {
        expr_into(tail, dl, dp);
    } else if tail == 0 && dl >= 0 && reachable() && !is_void_dest(dl, dp) {
        set_op(OK_UNIT, 0, TY_UNIT);
        emit_use(dl, dp, b);
    }
    if scoped {
        pop_scope_at(s);
    }
}

fn is_void_dest(dl: i64, dp: i64) -> bool {
    dl == unit_local() || dp == 0 && is_void(P_LOCALS[dl].ty)
}

// Whether block b is the checker's desugaring of an expression, whose
// statements' temporaries are the enclosing statement's (temp_home): its
// first `let`s bind its hidden names (`==l`, `=+l`, an f-string's `=fN`,
// `==nn`), which no program can write.
fn desugared_block(b: i64) -> bool {
    for i in 0..NODES[b].count {
        let s = child(b, i);
        if NODES[s].kind != NodeKind::Let {
            return false;
        }
        let pat = NODES[s].a;
        if pat != 0 && NODES[pat].kind == NodeKind::PatBind {
            let text = SYMS[NODES[pat].a].text;
            if text.len as i64 > 0 && text[0] == '=' {
                return true;
            }
        }
    }
    false
}

fn lower_stmt(st: i64) {
    let k = NODES[st].kind;
    if k == NodeKind::Defer {
        // (the own pass's: its drops, its statement temporaries';
        // the IR places its own)
        if (NODES[st].p & DEFER_IMPLICIT) != 0 || temp_defer(st) {
            return;
        }
        schedule(EN_DEFER, st);
        return;
    }
    if k == NodeKind::Let {
        lower_let(st);
        return;
    }
    if k == NodeKind::ExprStmt {
        let e = NODES[st].a;
        if e == 0 || own_flag_write(e) {
            return;
        }
        let s = push_scope(SC_STMT, st, STMT_HOME);
        if NODES[e].kind == NodeKind::Assign {
            lower_assign_at(e, true, false);
        } else {
            expr_into(e, -1, 0);
        }
        pop_scope_at(s);
        return;
    }
    let s = push_scope(SC_STMT, st, STMT_HOME);
    expr_into(st, -1, 0);
    pop_scope_at(s);
}

// Whether local l is one of the own pass's temporaries' bookkeeping
// (`__own_tp`, `__own_tf`), which the IR has no use for.
fn own_temp_local(l: i64) -> bool {
    if l < 0 {
        return false;
    }
    let name = crate::places::front::ast_local_name(l);
    name == SYM_TP || name == SYM_TF
}

// Whether expression e writes one (`__own_tp = &__own_tv;`, `__own_tf =
// true;`).
fn own_flag_write(e: i64) -> bool {
    if NODES[e].kind != NodeKind::Assign {
        return false;
    }
    let t = NODES[e].b;
    NODES[t].kind == NodeKind::Ident && NODES[t].res == Res::Local && own_temp_local(NODES[t].y)
}

// Whether defer d is a statement temporary's (`defer { if __own_tf { .. }
// }`, drops.vl temp_make): the IR's drop of the temporary is its own.
fn temp_defer(d: i64) -> bool {
    let body = NODES[d].a;
    if body == 0 || NODES[body].kind != NodeKind::Block || NODES[body].count != 1 {
        return false;
    }
    let s = child(body, 0);
    if NODES[s].kind != NodeKind::ExprStmt {
        return false;
    }
    let f = NODES[s].a;
    if f == 0 || NODES[f].kind != NodeKind::If {
        return false;
    }
    let c = NODES[f].a;
    NODES[c].kind == NodeKind::Ident && NODES[c].res == Res::Local && own_temp_local(NODES[c].y)
}

// Schedules an entry at the end of scope s, below the scopes inside it.
fn schedule_in(s: i64, kind: i64, v: i64) {
    if s + 1 >= scope_depth() {
        schedule(kind, v);
    } else {
        schedule_outer(s + 1, kind, v);
    }
}

fn lower_let(st: i64) {
    let pat = NODES[st].a;
    let init = NODES[st].c;
    if pat == 0 {
        return;
    }
    let pk = NODES[pat].kind;
    if pk == NodeKind::PatBind && own_temp_local(NODES[pat].x) {
        return;
    }
    // (its temporaries: to the end of the statement, or of the block when
    // it may keep a view of them)
    let keep = init != 0 && NODES[init].ty > 0 && is_view_type(NODES[init].ty);
    let s = if keep { -1 } else { push_scope(SC_STMT, st, STMT_HOME) };
    if pk == NodeKind::PatWild {
        if init != 0 {
            expr_into(init, -1, 0);
        }
    } else if pk == NodeKind::PatBind {
        let l = NODES[pat].x;
        if l < 0 {
            if init != 0 {
                expr_into(init, -1, 0);
            }
        } else {
            let borrowed = let_borrows(pat, init);
            let ir = user_local(l, pat, borrowed);
            // (its storage begins first; its drop is registered once it
            // holds its value, in the block's scope)
            live(ir);
            schedule_outer(s, EN_DEAD, ir);
            if init != 0 {
                // (a requires check's argument, `let ?aI = argI`: an
                // argument, arg_operand)
                let saved = LENT_HOME;
                LENT_HOME = if !STMT_HOME && lent_branch(init) { temp_home() } else { -1 };
                expr_into(init, ir, 0);
                LENT_HOME = saved;
            }
            if !has_flag(ir, LF_BORROWED) && needs_drop(P_LOCALS[ir].ty) {
                schedule_outer(s, EN_DROP, ir);
            }
        }
    } else {
        lower_let_pattern(pat, init, s);
    }
    if s >= 0 {
        pop_scope_at(s);
    }
}

// Registers an entry in the scope that encloses statement scope s (the
// block's), or in the innermost one when s is -1.
fn schedule_outer(s: i64, kind: i64, v: i64) {
    if kind == EN_DEAD && !keeps_storage(v) {
        return;
    }
    if s < 0 {
        schedule(kind, v);
        return;
    }
    // (the statement scope is innermost and holds only its temporaries:
    // the entry goes before them, at the end of the enclosing scope)
    let at = SCOPES[s * SW + 1];
    ENTRIES.push(0);
    ENTRIES.push(0);
    var e = ENTRIES.len() as i64 / 2 - 1;
    while e > at {
        ENTRIES[2 * e] = ENTRIES[2 * e - 2];
        ENTRIES[2 * e + 1] = ENTRIES[2 * e - 1];
        e -= 1;
    }
    ENTRIES[2 * at] = kind;
    ENTRIES[2 * at + 1] = v;
    // (the statement scope's entries now start one later)
    var t = s;
    while t < scope_depth() {
        SCOPES[t * SW + 1] += 1;
        t += 1;
    }
}

// Whether `let pat = init` binds a borrowed copy: byref.vl's BYREF, a
// `for` loop's sequence when it is a place, an operator's `==` operand.
fn let_borrows(pat: i64, init: i64) -> bool {
    let l = NODES[pat].x;
    if ast_borrowed(l) {
        return true;
    }
    let name = NODES[pat].a;
    if name == SYM_FOR_SEQ && init != 0 && is_place_expr(init) {
        return true;
    }
    // (`let x = S;` of a static: it borrows, statics are never dropped)
    if init != 0 && NODES[init].kind == NodeKind::Ident && NODES[init].res == Res::Static {
        return true;
    }
    // (a hidden binding of the checker's, `=fN` an f-string's hole, `==`
    // an operator's operand: a borrowed copy, as the own pass's let_drops)
    let text = SYMS[name].text;
    text.len as i64 > 0 && text[0] == '='
}

// ---- The body ----

// Builds function f's body (Fn node item) into the IR tables; false when
// a construct is not handled (a fallback).
pub fn build_body(f: i64, item: i64) -> bool {
    syms();
    BUILD_FAILED = false;
    FAIL_NODE = 0;
    GEN += 1;
    CUR_F = f;
    DROPS = OWN_MODE == MODE_ERROR;
    body_begin(f, item);
    SCOPES.clear();
    ENTRIES.clear();
    STATICS_SEEN.clear();
    MOVES_SUSPECT = false;
    UNIT_LOCAL = -1;
    let ret = fn_ret(f);
    new_local(ret, LF_RETURN, -1, 0);
    let count = NODES[item].count;
    crate::places::ir::B_PARAMS = count;
    let entry = new_block();
    RET_BLOCK = new_block();
    let body_scope = push_scope(SC_BODY, NODES[item].c, true);
    // the parameters: _1.._n
    let keep = keep_params(f);
    for i in 0..count {
        let p = child(item, i);
        let l = NODES[p].x;
        let ty = if i < fn_param_count(f) { fn_param(f, i) } else { 0 };
        var flags = LF_PARAM;
        if l >= 0 && ast_local_mutable(l) {
            flags |= LF_MUT;
        }
        if l >= 0 && ast_borrowed(l) {
            flags |= LF_BORROWED;
        }
        let ir = new_local(ty, flags, l, p);
        if l >= 0 {
            map_local(l, ir, 0);
        }
        if !keep && (flags & LF_BORROWED) == 0 && needs_drop(ty) {
            schedule(EN_DROP, ir);
        }
    }
    enter_block(entry);
    let body = NODES[item].c;
    expr_into(body, 0, 0);
    if reachable() {
        exit_to(body_scope, body);
        goto(RET_BLOCK);
    }
    SCOPES.clear();
    ENTRIES.clear();
    enter_block(RET_BLOCK);
    terminate(TK_RETURN, 0, 0, 0, 0, 0, 0);
    live_writes();
    BUILT += 1;
    !BUILD_FAILED
}

// Whether function f keeps its by-value parameters undropped: std's
// `forget` (whose point that is), and `iter::pass_over::<I>` of a
// borrowing iterator's item (a copy its container keeps), as the own
// pass's param_drops.
fn keep_params(f: i64) -> bool {
    // (a `$pre` companion's parameters are its call's arguments, read in
    // place: contracts::expand::is_pre_fn)
    if is_pre_fn(f) {
        return true;
    }
    let t = crate::places::front::fn_template(f);
    if !crate::front::modules::within_std(crate::places::front::fn_module(t)) {
        return false;
    }
    let name = crate::places::front::fn_name_sym(t);
    if name == intern_c(c"forget") {
        return true;
    }
    name == intern_c(c"pass_over")
        && crate::front::own::byref::copies_owned_items(crate::places::front::fn_targ(f, 0), 0)
}

// ---- A sink closure's captures moved (R3) ----

static var OLD_STMTS: Vec<PStmt, Comp> = Vec::new_in(Comp {});

// The flag field index of the capture statement st moves out of the env
// of the closure body held (`move (*_1).k...`, k a capture with a
// `__live_` flag), or -1.
fn moved_capture_flag(st: PStmt) -> i64 {
    for i in 0..st.nops {
        if op_kind(st.ops, i) != OK_MOVE || op_a(st.ops, i) != 1 {
            continue;
        }
        // (the steps from the root: `*`, then field k)
        var second = 0;
        var first = op_b(st.ops, i);
        while first > 0 && proj_parent(first) > 0 {
            second = first;
            first = proj_parent(first);
        }
        if first <= 0 || proj_kind(first) != PJ_DEREF || second <= 0
            || proj_kind(second) != PJ_FIELD {
            continue;
        }
        let env = undistinct(P_LOCALS[1].ty);
        let pt = if env > 0 && TYPES[env].kind == TyKind::Ptr { TYPES[env].a } else { 0 };
        if pt <= 0 || !struct_closure(pt) {
            continue;
        }
        let s = TYPES[pt].a;
        let flag = crate::front::own::glue::flag_field(s, struct_field_name(s, proj_val(second)));
        if flag == 0 {
            continue;
        }
        for k in 0..crate::places::ir::struct_field_count(s) {
            if struct_field_name(s, k) == flag {
                return k;
            }
        }
    }
    -1
}

// The checker's node of the stop at a sink closure's second move out of
// its env (R7): `EnumPanic(0)` with the own pass's message, at node n.
fn second_move_panic(n: i64) -> i64 {
    let start = NODES[n].start;
    let zero = crate::front::ast::new_node(NodeKind::Int, start, start);
    NODES[zero].ty = TY_I64;
    NODES[zero].b = crate::front::lexer::SUF_I64;
    let p = crate::front::ast::new_node(NodeKind::EnumPanic, start, start);
    NODES[p].ty = TY_NEVER;
    NODES[p].a = zero;
    NODES[p].x = crate::gen0::target::message_kind(crate::front::contracts::checks::fixed_message(
        "a sink closure moved its captured value out a second time: it was called again\n"));
    p
}

// Whether parameter _1 of the body held is a closure's env with a capture
// under a `__live_` flag (moved_capture_flag's): else live_writes has
// nothing to look for.
fn env_has_flags() -> bool {
    let env = undistinct(P_LOCALS[1].ty);
    let pt = if env > 0 && TYPES[env].kind == TyKind::Ptr { TYPES[env].a } else { 0 };
    if pt <= 0 || !struct_closure(pt) {
        return false;
    }
    let s = TYPES[pt].a;
    for k in 0..crate::places::ir::struct_field_count(s) {
        if crate::front::own::glue::flag_field(s, struct_field_name(s, k)) != 0 {
            return true;
        }
    }
    false
}

// A closure body that moves a capture of a sink closure out of its env:
// `(*_1).__live_x = const false` after each such move, as the own pass
// writes it, so that the env's shim drops only what it still holds.
fn live_writes() {
    if B_PARAMS < 1 || local_count() < 2 || !has_flag(1, LF_PARAM) || !env_has_flags() {
        return;
    }
    var any = false;
    for s in 0..P_STMTS.len() as i64 {
        if moved_capture_flag(P_STMTS[s]) >= 0 {
            any = true;
            break;
        }
    }
    if !any {
        return;
    }
    OLD_STMTS.clear();
    for s in 0..P_STMTS.len() as i64 {
        OLD_STMTS.push(P_STMTS[s]);
    }
    let n = block_count();
    // (the blocks' ranges before: entering a block resets its start)
    let ranges = TMP_RANGES.len() as i64;
    for b in 0..n {
        TMP_RANGES.push(block_start(b));
        TMP_RANGES.push(block_len(b));
    }
    P_STMTS.clear();
    let root = proj(0, PJ_DEREF, 0);
    for b in 0..n {
        let start = TMP_RANGES[ranges + 2 * b];
        if start < 0 {
            continue;
        }
        let len = TMP_RANGES[ranges + 2 * b + 1];
        enter_block(b);
        for s in start..start + len {
            let st = OLD_STMTS[s];
            let k = moved_capture_flag(st);
            if k >= 0 {
                // (R7: moved out already, the closure called again: the
                // program stops, as the own pass's wrap_capture_move)
                let flag = proj(root, PJ_FIELD, k);
                let c = new_local(TY_BOOL, LF_TEMP, -1, st.node);
                let a0 = ops_mark();
                push_op(OK_COPY, 1, flag);
                emit(SK_ASSIGN, c, 0, RV_USE, 0, 0, a0, 1, st.node);
                let a1 = ops_mark();
                push_op(OK_COPY, c, 0);
                let fail = new_block();
                let cont = new_block();
                switch_bool(a1, fail, cont, st.node);
                enter_block(fail);
                let p = second_move_panic(st.node);
                let a2 = ops_mark();
                push_op(OK_INT, 0, TY_I64);
                emit(SK_INTRINSIC, unit_local(), 0, IK_PANIC, p, 0, a2, 1, p);
                terminate(TK_UNREACHABLE, 0, 0, 0, 0, 0, p);
                enter_block(cont);
            }
            P_STMTS.push(st);
            if k >= 0 {
                let at = ops_mark();
                push_op(OK_INT, 0, TY_BOOL);
                emit(SK_ASSIGN, 1, proj(root, PJ_FIELD, k), RV_USE, 0, 0, at, 1, st.node);
            }
        }
        let term = OLD_STMTS[start + len];
        terminate(term.kind, term.a, term.b, term.c, term.ops, term.nops, term.node);
    }
    TMP_RANGES.truncate(len_arg(ranges));
}

static var TMP_RANGES: Vec<i64, Comp> = Vec::new_in(Comp {});
