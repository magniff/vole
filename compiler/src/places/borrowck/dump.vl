// (0.27.1) The regions dump (docs/design/borrowck.md section 16): after a
// body's text under `check --emit-places=regions`, the regions the
// checker added, the liveness per local, the constraints, each region's
// value and the loans; at the end of the run `solved: N bodies, M reused
// (key)`. A point set prints as runs per block, `bbK[x..y]` or `bbK[x]`,
// an end a half-name: `i` the start point of location i of the block,
// `i+` its mid point; an `end('rN)` bit by its universal.

use crate::base::{buf_int, buf_str};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::places::borrowck::{Bck, LOAN_WORDS, RO_REBORROW, bit_on};
use crate::places::ir::{BK_MUT, BK_MUT2, BK_SHARED, Body, block_count, block_len, block_start};
use crate::places::regions::{RO_LOCAL, RO_UNIVERSAL};

pub fn print_regions(out: i64, bck: Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    for r in bck.nbase + 1..bck.nreg + 1 {
        buf_str(out, c"    region 'r");
        buf_int(out, r);
        if bck.origin[r - 1] == RO_LOCAL {
            // (a parameter's slot, equal to its universal: mod.vl begin_body)
            buf_str(out, c": param slot _");
            buf_int(out, bck.of[r - 1]);
        } else {
            buf_str(out, if bck.origin[r - 1] == RO_REBORROW { c": reborrow " } else { c": ? " });
            buf_loc(out, bck.of[r - 1], pbody);
        }
        buf_str(out, c"\n");
    }
    for l in 0..bck.nlocal {
        if bck.nslots[l] == 0 {
            continue;
        }
        buf_str(out, c"    live _");
        buf_int(out, l);
        buf_str(out, c":");
        buf_local_points(out, l, false, bck, pbody);
        buf_str(out, c"\n");
        if local_live_any(l, true, bck) {
            buf_str(out, c"    drop-live _");
            buf_int(out, l);
            buf_str(out, c":");
            buf_local_points(out, l, true, bck, pbody);
            buf_str(out, c"\n");
        }
    }
    let ne = bck.edges.len() as i64 / 3;
    for e in 0..ne {
        buf_str(out, c"    constraint 'r");
        buf_int(out, bck.edges[3 * e]);
        buf_str(out, c": 'r");
        buf_int(out, bck.edges[3 * e + 1]);
        buf_str(out, c" @ ");
        buf_loc(out, bck.edges[3 * e + 2], pbody);
        buf_str(out, c"\n");
    }
    for r in 1..bck.nreg + 1 {
        buf_str(out, c"    value 'r");
        buf_int(out, r);
        buf_str(out, c":");
        var any = buf_points(out, r * bck.nw_p, bck.val, bck, pbody);
        for u in 0..bck.nuniv {
            if bit_on(bck.val, r * bck.nw_p, bck.npts + u) {
                buf_str(out, c" end('r");
                buf_int(out, universal_region(u, bck));
                buf_str(out, c")");
                any = true;
            }
        }
        if !any {
            buf_str(out, c" -");
        }
        buf_str(out, c"\n");
    }
    let nl = bck.loans.len() as i64 / LOAN_WORDS;
    for i in 0..nl {
        buf_str(out, c"    loan L");
        buf_int(out, i + 1);
        buf_str(out, c": ");
        let k = bck.loans[LOAN_WORDS * i + 2];
        buf_str(out, if k == BK_SHARED { c"&" } else if k == BK_MUT { c"&mut " }
            else if k == BK_MUT2 { c"&mut2 " } else { c"&fake " });
        if bck.loans[LOAN_WORDS * i + 5] != 0 {
            buf_str(out, c"*");
        }
        crate::places::print::buf_place(out, bck.loans[LOAN_WORDS * i + 3],
            bck.loans[LOAN_WORDS * i + 4], pbody, pcx);
        buf_str(out, c" @ ");
        buf_loc(out, bck.loans[LOAN_WORDS * i], pbody);
        buf_str(out, c" 'r");
        buf_int(out, bck.loans[LOAN_WORDS * i + 1]);
        buf_str(out, c"\n");
    }
    buf_str(out, c"\n");
}

// The run's count line.
pub fn print_solved(out: i64, bck: Bck<Comp>) {
    buf_str(out, c"solved: ");
    buf_int(out, bck.bodies);
    buf_str(out, c" bodies, ");
    buf_int(out, bck.reused);
    buf_str(out, c" reused (key)\n");
}

// The region variable of universal u.
fn universal_region(u: i64, bck: Bck<Comp>) -> i64 {
    for r in 1..bck.nreg + 1 {
        if bck.origin[r - 1] == RO_UNIVERSAL && bck.univ[r - 1] == u {
            return r;
        }
    }
    0
}

// Location loc as `bbK[i]`.
fn buf_loc(out: i64, loc: i64, pbody: Body<Comp>) {
    let b = crate::places::borrowck::loc_block(loc, pbody);
    if b < 0 {
        buf_str(out, c"?");
        return;
    }
    buf_str(out, c"bb");
    buf_int(out, b);
    buf_str(out, c"[");
    buf_int(out, loc - block_start(b, pbody));
    buf_str(out, c"]");
}

fn local_live_any(l: i64, drop_flow: bool, bck: Bck<Comp>) -> bool {
    for p in 0..bck.npts {
        if bit_on(if drop_flow { bck.dlive } else { bck.live }, p * bck.nw_l, l) {
            return true;
        }
    }
    false
}

// The points local l is live at, as runs.
fn buf_local_points(out: i64, l: i64, drop_flow: bool, bck: Bck<Comp>, pbody: Body<Comp>) {
    var any = false;
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 {
            continue;
        }
        var run = -1;
        let last = 2 * (start + block_len(b, pbody)) + 1;
        for pt in 2 * start..last + 1 {
            let on = bit_on(if drop_flow { bck.dlive } else { bck.live }, pt * bck.nw_l, l);
            if on && run < 0 {
                run = pt;
            }
            if (!on || pt == last) && run >= 0 {
                buf_run(out, b, run, if on { pt } else { pt - 1 }, pbody);
                any = true;
                run = -1;
            }
        }
    }
    if !any {
        buf_str(out, c" -");
    }
}

// The points on in the set at words [base..] of v, as runs; whether any.
fn buf_points(out: i64, base: i64, v: Vec<i64, Comp>, bck: Bck<Comp>, pbody: Body<Comp>) -> bool {
    var any = false;
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start < 0 {
            continue;
        }
        var run = -1;
        let last = 2 * (start + block_len(b, pbody)) + 1;
        for pt in 2 * start..last + 1 {
            let on = pt < bck.npts && bit_on(v, base, pt);
            if on && run < 0 {
                run = pt;
            }
            if (!on || pt == last) && run >= 0 {
                buf_run(out, b, run, if on { pt } else { pt - 1 }, pbody);
                any = true;
                run = -1;
            }
        }
    }
    any
}

// ` bbK[x..y]` (or ` bbK[x]`) for the points from .. to, inclusive.
fn buf_run(out: i64, b: i64, from: i64, to: i64, pbody: Body<Comp>) {
    let start = block_start(b, pbody);
    buf_str(out, c" bb");
    buf_int(out, b);
    buf_str(out, c"[");
    buf_half(out, from, start);
    if to != from {
        buf_str(out, c"..");
        buf_half(out, to, start);
    }
    buf_str(out, c"]");
}

fn buf_half(out: i64, pt: i64, start: i64) {
    buf_int(out, pt / 2 - start);
    if pt % 2 == 1 {
        buf_str(out, c"+");
    }
}
