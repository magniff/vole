// (0.27.2) `--std2-check` (RULE: Z7): std2's bodies are checked bodies.
// A rust program on std2 checked with it also instantiates each std2
// template nothing instantiated once, with i64 (Gpa for an allocator) for
// its type parameters (front/check: check_std_generics, the region-free
// instance), and runs the places IR and the borrow checker on every body
// that type-checked even when another one did not (run_places otherwise
// stops at the first error). The run ends with the tally line, which the
// `std2-check` row of the gate reads:
//
//   std2-check: N bodies: C clean, E with borrowck errors, F failed the type check, U not solved; K not checked (no instance)
//
// N counts std2's functions with a body: the non-generic ones and every
// instance this run made (a template is not a body). F: its signature or
// body had a type error; U: it type-checked but its places body was not
// built or solved (an instance with an error type for an argument, the
// builder's fallback, an error in the body's elision). K, apart from N:
// a function the checker never reached (a lazy default no instance uses,
// R3's until D4.4(d)).

use crate::base::{STDOUT, buf_int, buf_new, buf_str, buf_write_fd};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{FN_BODY_FAILED, FN_SIG_FAILED, NodeKind};
use crate::front::modules::file_of_pos;
use crate::places::borrowck::{VERDICT_CLEAN, VERDICT_ERRORS};
use crate::places::front::{fn_generic, fn_is_extern, fn_node};

static var STD2_CHECK: bool = false;

// `--std2-check` (places_option).
pub fn set_std2_check(on: bool) {
    STD2_CHECK = on;
}

// Whether this run is `--std2-check`'s (and the program is on std2).
pub fn std2_check(pcx: Ctx<Comp>) -> bool {
    STD2_CHECK && crate::front::known::on_std2(pcx)
}

// RULE: Z7 The tally line, after run_places's bodies.
pub fn report(pcx: Ctx<Comp>) {
    var total = 0;
    var clean = 0;
    var errors = 0;
    var failed = 0;
    var unsolved = 0;
    var unchecked = 0;
    for f in 0..pcx.fns.len() as i64 {
        let node = fn_node(f, pcx);
        if node <= 0 || pcx.nodes[node].kind != NodeKind::Fn || fn_generic(f, pcx)
            || fn_is_extern(f, pcx) || pcx.nodes[node].c == 0 {
            continue;
        }
        if pcx.std_file < 0 || file_of_pos(pcx.nodes[node].start, pcx) != pcx.std_file {
            continue;
        }
        let v = if f < pcx.borrowck_verdict.len() as i64 { pcx.borrowck_verdict[f] } else { 0 };
        if (pcx.nodes[node].p & (FN_BODY_FAILED | FN_SIG_FAILED)) == 0
            && pcx.nodes[pcx.nodes[node].c].ty == 0 {
            // (not checked: a lazy default nothing used, R3's until D4.4(d))
            unchecked += 1;
            continue;
        }
        total += 1;
        if (pcx.nodes[node].p & (FN_BODY_FAILED | FN_SIG_FAILED)) != 0 {
            failed += 1;
        } else if v == VERDICT_CLEAN {
            clean += 1;
        } else if v == VERDICT_ERRORS {
            errors += 1;
        } else {
            unsolved += 1;
        }
    }
    let out = buf_new();
    buf_str(out, c"std2-check: ");
    buf_int(out, total);
    buf_str(out, c" bodies: ");
    buf_int(out, clean);
    buf_str(out, c" clean, ");
    buf_int(out, errors);
    buf_str(out, c" with borrowck errors, ");
    buf_int(out, failed);
    buf_str(out, c" failed the type check, ");
    buf_int(out, unsolved);
    buf_str(out, c" not solved; ");
    buf_int(out, unchecked);
    buf_str(out, c" not checked (no instance)\n");
    buf_write_fd(out, STDOUT);
}
