// (0.27.1) The borrow checker's diagnostics (docs/design/borrowck.md
// section 14): one error per (loan, access place, code) in a body, at the
// access's statement node, naming the loan's position; the codes'
// `explain` rows are tools/explain/borrowck_table.vl.

use crate::base::{buf_new, buf_slice, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, report_error_tries};
use crate::places::borrowck::{Bck, LOAN_WORDS};
use crate::places::borrowck::access::{
    A_RB, C_ASSIGN_BORROWED, C_CONFLICT, C_DROPPED_BORROWED, C_GUARD_WRITE, C_MOVE_BORROWED,
    C_MUT_TWICE, C_RETURN_LOCAL, C_USE_BORROWED,
};
use crate::places::ir::{BK_MUT, BK_MUT2, Body, LF_PARAM, LF_USER, SK_DEAD};

// The code's name.
pub fn code_name(code: i64) -> *u8 {
    if code == C_MUT_TWICE { c"borrowck.mut_twice" }
    else if code == C_CONFLICT { c"borrowck.conflict" }
    else if code == C_USE_BORROWED { c"borrowck.use_borrowed" }
    else if code == C_ASSIGN_BORROWED { c"borrowck.assign_borrowed" }
    else if code == C_MOVE_BORROWED { c"borrowck.move_borrowed" }
    else if code == C_DROPPED_BORROWED { c"borrowck.dropped_borrowed" }
    else if code == C_RETURN_LOCAL { c"borrowck.return_local" }
    else if code == C_GUARD_WRITE { c"borrowck.guard_write" }
    else if code == C_OUTLIVES { c"borrowck.outlives" }
    else if code == C_ELISION { c"borrowck.elision" }
    else if code == C_UNUSED_PARAM { c"borrowck.unused_param" }
    else { c"borrowck.static_mut_ref" }
}

// The codes the front reports at the signature (ir271: D4.2, D5.3,
// D6.2.5) and the solve's universal violation (D6.2.1), named here with
// the others: the checker's codes are this file's list.
pub const C_OUTLIVES: i64 = 9;
pub const C_ELISION: i64 = 10;
pub const C_UNUSED_PARAM: i64 = 11;
pub const C_STATIC_MUT_REF: i64 = 12;

// A conflict of the access (kind, of place (l, p), `*` of it when deref)
// at location loc with loan j, reported once.
// RULE: section 14.2, 14.3
pub fn report(code: i64, kind: i64, loc: i64, j: i64, l: i64, p: i64, deref: i64,
    bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    var i = 0;
    while i < bck.reported.len() as i64 {
        if bck.reported[i] == j && bck.reported[i + 1] == l && bck.reported[i + 2] == p
            && bck.reported[i + 3] == code {
            return;
        }
        i += 4;
    }
    bck.reported.push(j);
    bck.reported.push(l);
    bck.reported.push(p);
    bck.reported.push(code);
    let st = pbody.stmts[loc];
    let ls = bck.loans[LOAN_WORDS * j];
    let lk = bck.loans[LOAN_WORDS * j + 2];
    var node = st.node;
    if node == 0 {
        node = pbody.stmts[ls].node;
    }
    if node == 0 {
        node = pbody.node;
    }
    let pos = pcx.nodes[node].start;
    let m = buf_new();
    let mutable = lk == BK_MUT || lk == BK_MUT2;
    if code == C_MUT_TWICE {
        buf_str(m, c"cannot borrow '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' as mutable more than once at a time");
    } else if code == C_CONFLICT {
        buf_str(m, c"cannot borrow '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, if kind == A_RB { c"' as immutable because it is also borrowed as mutable" }
            else { c"' as mutable because it is also borrowed as immutable" });
    } else if code == C_USE_BORROWED {
        buf_str(m, c"cannot use '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' because it is mutably borrowed");
    } else if code == C_ASSIGN_BORROWED {
        buf_str(m, c"cannot assign to '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' because it is borrowed");
    } else if code == C_MOVE_BORROWED {
        buf_str(m, c"cannot move out of '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' because it is borrowed");
    } else if code == C_DROPPED_BORROWED {
        buf_str(m, c"'");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m,
            if st.kind
                == SK_DEAD {
                c"' does not live long enough: its scope ends here while it is still borrowed"
            }
            else { c"' is dropped here while it is still borrowed" });
    } else if code == C_RETURN_LOCAL {
        buf_str(m, c"a reference to '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"', a local of this function, escapes it");
    } else {
        buf_str(m, c"cannot write to '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' in a match guard: the match tests it");
    }
    buf_str(m, if mutable { c" (mutably borrowed at " } else { c" (borrowed at " });
    let lnode = pbody.stmts[ls].node;
    if lnode != 0 {
        buf_position(m, pcx.nodes[lnode].start, &pcx);
    } else {
        buf_str(m, c"a borrow the compiler made");
    }
    buf_str(m, c")");
    let help = if code == C_MUT_TWICE {
        c"finish the first borrow's uses before the second, or reborrow once and pass it on"
    } else if code == C_CONFLICT {
        c"use the shared borrow before the mutable one, or take it again after"
    } else if code == C_USE_BORROWED {
        c"use it after the mutable borrow's last use"
    } else if code == C_ASSIGN_BORROWED {
        c"assign after the borrow's last use, or shadow the reference (`let r = ..`) instead of reassigning it"
    } else if code == C_MOVE_BORROWED {
        c"move it after the borrow's last use, or clone it"
    } else if code == C_DROPPED_BORROWED {
        c"declare it before what borrows it, so it is dropped after"
    } else if code == C_RETURN_LOCAL {
        c"return an owned value, or borrow from a parameter"
    } else {
        c"write it in the arm, after the match has decided"
    };
    report_error_tries(pos, 1000 + j * 16 + code, code_name(code), buf_slice(m).ptr, help, "",
        false, &pcx);
}

// The place as the user names it: the root's source name when it has one
// (a user local, a parameter), the IR's form otherwise or beside it when
// the place is projected.
pub fn buf_place(m: i64, l: i64, p: i64, deref: i64, pbody: Body<Comp>, pcx: Ctx<Comp>) {
    if deref != 0 {
        buf_str(m, c"*");
    }
    let lc = pbody.locals[l];
    let named = (lc.flags & (LF_USER | LF_PARAM)) != 0 && lc.src >= 0;
    if named {
        // UNSAFE: LOCALS is the checker's raw table of locals.
        // SAFETY: lc.src is a local the checker defined (a body's src),
        // below LOCAL_COUNT.
        let name = unsafe { pcx.locals[lc.src].name };
        crate::base::buf_bytes(m, sym_text(name, pcx));
        if p == 0 {
            return;
        }
        buf_str(m, c" (");
    }
    crate::places::print::buf_place(m, l, p, pbody, pcx);
    if named {
        buf_str(m, c")");
    }
}
