// (0.27.1) The borrow checker's diagnostics (docs/design/borrowck.md
// section 14): one error per (loan, access place, code) in a body, at the
// access's statement node, naming the loan's position; the codes'
// `explain` rows are tools/explain/borrowck_table.vl.

use crate::base::{buf_new, buf_slice, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, report_error_tries};
use crate::front::types::TyKind;
use crate::places::borrowck::{Bck, LOAN_WORDS};
use crate::places::borrowck::access::{
    A_RB, C_ASSIGN_BORROWED, C_CONFLICT, C_DROPPED_BORROWED, C_GUARD_WRITE, C_MOVE_BORROWED,
    C_MUT_TWICE, C_RETURN_LOCAL, C_USE_BORROWED,
};
use crate::places::ir::{
    BK_MUT, BK_MUT2, Body, LF_PARAM, LF_USER, PJ_CONST, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION,
    PJ_VARIANT, SK_DEAD, proj_kind, proj_parent, proj_val, struct_field_count,
};

// A write through a shared reference at location loc (D2.6, L6: a guard's
// `ref mut` binding), once per place.
pub fn report_shared_write(loc: i64, l: i64, p: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < bck.reported.len() as i64 {
        if bck.reported[i as usize] == -1 && bck.reported[(i + 1) as usize] == l
            && bck.reported[(i + 2) as usize] == p
            && bck.reported[(i + 3) as usize] == C_GUARD_WRITE {
            return;
        }
        i += 4;
    }
    bck.reported.push(-1);
    bck.reported.push(l);
    bck.reported.push(p);
    bck.reported.push(C_GUARD_WRITE);
    let mut node = pbody.stmts[loc as usize].node;
    if node == 0 {
        node = pbody.node;
    }
    let m = buf_new();
    buf_str(m, c"cannot write to '");
    buf_place(m, l, p, 0, pbody, pcx);
    buf_str(m, c"' in a match guard: a `ref mut` binding is shared there");
    report_error_tries(pcx.nodes[node as usize].start, 1000 + C_GUARD_WRITE,
        c"borrowck.guard_write", buf_slice(m).ptr,
        c"write it in the arm, after the match has decided", b"", false, pcx);
}

// A `try:` line that rewrites node n's text t as `pre t post` on its line
// (as the own pass's: `volec edit patch FILE:LINE --old 'LINE' --new 'LINE'`,
// the line without its indentation); the command in a buffer, or -1 for a
// node over several lines or in std.
pub fn try_wrap(n: i64, pre: *mut u8, post: *mut u8, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 {
        return -1;
    }
    let start = pcx.nodes[n as usize].start;
    let end = pcx.nodes[n as usize].end;
    let f = src_file(start, pcx);
    // UNSAFE: FILES' paths and SRC are the lexer's raw text.
    // SAFETY: f is a file index below FILES' count; every position read is
    // within the file's [start, end), which the lexer filled.
    unsafe {
        let path = pcx.files[f as usize].path;
        if (*path.add(0)) == b'<' || end <= start {
            return -1;
        }
        let mut ls = start;
        while ls > pcx.files[f as usize].start && get_src()[(ls - 1) as usize] != b'\n' {
            ls -= 1;
        }
        while ls < start && (get_src()[ls as usize] == b' ' || get_src()[ls as usize] == b'\t') {
            ls += 1;
        }
        let mut le = start;
        while le < pcx.files[f as usize].end && get_src()[le as usize] != b'\n' {
            le += 1;
        }
        if end > le {
            return -1;
        }
        while le > end
            && (get_src()[(le - 1) as usize] == b' ' || get_src()[(le - 1) as usize] == b'\t') {
            le -= 1;
        }
        let args = buf_new();
        buf_str(args, c"edit patch ");
        buf_str(args,
            if (*path.add(0)) == b'.' && (*path.add(1)) == b'/' { path.add(2) } else { path });
        crate::base::buf_byte(args, b':');
        crate::base::buf_int(args, src_line(start, pcx));
        buf_str(args, c" --old ");
        quoted(args, ls, le, -1, -1, c"", c"");
        buf_str(args, c" --new ");
        quoted(args, ls, le, start, end, pre, post);
        let out = buf_new();
        crate::base::diag::buf_tool_command(out, buf_slice(args), false, pcx);
        out
    }
}

// A `try:` line that names one lifetime `'a` on function node n's
// signature line (D6.2.1's and D4.2's try: `fn f<'a>(x: &'a T, y: &'a T) ->
// &'a T`): `<'a>` after the name when it has no generics, `'a` after each
// `&` not named yet; the command in a buffer, or -1 when the signature
// is not on one line or in std.
pub fn try_name_lifetime(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 {
        return -1;
    }
    let start = pcx.nodes[n as usize].start;
    let f = src_file(start, pcx);
    // UNSAFE: FILES' paths and SRC are the lexer's raw text.
    // SAFETY: f is a file index below FILES' count; every position read is
    // within the file's [start, end), which the lexer filled.
    unsafe {
        let path = pcx.files[f as usize].path;
        if (*path.add(0)) == b'<' {
            return -1;
        }
        let mut ls = start;
        while ls > pcx.files[f as usize].start && get_src()[(ls - 1) as usize] != b'\n' {
            ls -= 1;
        }
        while ls < start && (get_src()[ls as usize] == b' ' || get_src()[ls as usize] == b'\t') {
            ls += 1;
        }
        let mut le = start;
        while le < pcx.files[f as usize].end && get_src()[le as usize] != b'\n' {
            le += 1;
        }
        // (the signature: up to the body's `{`; the line must hold it)
        let mut brace = ls;
        while brace < le && get_src()[brace as usize] != b'{' {
            brace += 1;
        }
        if brace == le {
            return -1;
        }
        while brace > ls && get_src()[(brace - 1) as usize] == b' ' {
            brace -= 1;
        }
        let new = buf_new();
        let mut i = ls;
        let mut named = false;
        let mut in_params = false;
        while i < brace {
            let c = get_src()[i as usize];
            if !named && !in_params && (c == b'(' || c == b'<') {
                if c == b'<' {
                    return -1;
                }
                buf_str(new, c"<'a>");
                named = true;
                in_params = true;
            }
            crate::base::buf_byte(new, c);
            if c == b'&' && (i + 1 >= brace || get_src()[(i + 1) as usize] != b'\'') {
                buf_str(new, c"'a ");
            }
            i += 1;
        }
        if !named {
            return -1;
        }
        let args = buf_new();
        buf_str(args, c"edit patch ");
        buf_str(args,
            if (*path.add(0)) == b'.' && (*path.add(1)) == b'/' { path.add(2) } else { path });
        crate::base::buf_byte(args, b':');
        crate::base::buf_int(args, src_line(start, pcx));
        buf_str(args, c" --old ");
        quoted(args, ls, brace, -1, -1, c"", c"");
        buf_str(args, c" --new ");
        quote_slice(args, buf_slice(new));
        let out = buf_new();
        crate::base::diag::buf_tool_command(out, buf_slice(args), false, pcx);
        out
    }
}

// s single-quoted for a shell.
fn quote_slice(out: i64, s: &[u8]) {
    crate::base::buf_byte(out, b'\'');
    for i in 0..s.len() {
        if s[i] == b'\'' {
            buf_str(out, c"'\\''");
        } else {
            crate::base::buf_byte(out, s[i]);
        }
    }
    crate::base::buf_byte(out, b'\'');
}

// SRC[from..to) single-quoted for a shell, `pre` put at `at` and `post` at
// `end` (-1: none).
fn quoted(out: i64, from: i64, to: i64, at: i64, end: i64, pre: *mut u8, post: *mut u8) {
    crate::base::buf_byte(out, b'\'');
    let mut i = from;
    while i <= to {
        if i == at {
            buf_str(out, pre);
        }
        if i == end && at >= 0 {
            buf_str(out, post);
        }
        if i < to {
            // UNSAFE: SRC is the lexer's raw text.
            // SAFETY: i is within a line of a file the lexer read.
            let c = unsafe { get_src()[i as usize] };
            if c == b'\'' {
                buf_str(out, c"'\\''");
            } else {
                crate::base::buf_byte(out, c);
            }
        }
        i += 1;
    }
    crate::base::buf_byte(out, b'\'');
}

// The file of position pos (an index in FILES), and its line from 1.
fn src_file(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut f: i64 = 0;
    while f + 1 < pcx.files.len() as i64 && pos >= pcx.files[(f + 1) as usize].start {
        f += 1;
    }
    f
}

pub fn src_line(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut line: i64 = 1;
    let mut i = pcx.files[src_file(pos, pcx) as usize].start;
    while i < pos {
        // UNSAFE: SRC is the lexer's raw text.
        // SAFETY: i is below pos, a position in a file the lexer read.
        if unsafe { get_src()[i as usize] } == b'\n' {
            line += 1;
        }
        i += 1;
    }
    line
}

// The code's name.
pub fn code_name(code: i64) -> *mut u8 {
    if code == C_MUT_TWICE { c"borrowck.mut_twice" }
    else if code == C_CONFLICT { c"borrowck.conflict" }
    else if code == C_USE_BORROWED { c"borrowck.use_borrowed" }
    else if code == C_ASSIGN_BORROWED { c"borrowck.assign_borrowed" }
    else if code == C_MOVE_BORROWED { c"borrowck.move_borrowed" }
    else if code == C_DROPPED_BORROWED { c"borrowck.dropped_borrowed" }
    else if code == C_RETURN_LOCAL { c"borrowck.return_local" }
    else if code == C_GUARD_WRITE { c"borrowck.guard_write" }
    else if code == C_OUTLIVES { c"borrowck.outlives" }
    else if code == C_ELISION { c"borrowck.elision" }
    else if code == C_UNUSED_PARAM { c"borrowck.unused_param" }
    else { c"borrowck.static_mut_ref" }
}

// The codes the front reports at the signature (ir271: D4.2, D5.3,
// D6.2.5) and the solve's universal violation (D6.2.1), named here with
// the others: the checker's codes are this file's list.
pub const C_OUTLIVES: i64 = 9;
pub const C_ELISION: i64 = 10;
pub const C_UNUSED_PARAM: i64 = 11;
pub const C_STATIC_MUT_REF: i64 = 12;

// A conflict of the access (kind, of place (l, p), `*` of it when deref)
// at location loc with loan j, reported once.
// RULE: section 14.2, 14.3
pub fn report(code: i64, kind: i64, loc: i64, j: i64, l: i64, p: i64, deref: i64,
    bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < bck.reported.len() as i64 {
        if bck.reported[i as usize] == j && bck.reported[(i + 1) as usize] == l
            && bck.reported[(i + 2) as usize] == p
            && bck.reported[(i + 3) as usize] == code {
            return;
        }
        i += 4;
    }
    bck.reported.push(j);
    bck.reported.push(l);
    bck.reported.push(p);
    bck.reported.push(code);
    let st = pbody.stmts[loc as usize];
    let ls = bck.loans[(LOAN_WORDS * j) as usize];
    let lk = bck.loans[(LOAN_WORDS * j + 2) as usize];
    let mut node = st.node;
    // RULE: 14.2 (dropped_borrowed at the borrow, as rustc's E0597, E0713)
    let drop_node: i64 = if code == C_DROPPED_BORROWED && st.kind != SK_DEAD { st.node } else { 0 };
    if node == 0 || code == C_DROPPED_BORROWED && pbody.stmts[ls as usize].node != 0 {
        node = pbody.stmts[ls as usize].node;
    }
    if node == 0 {
        node = pbody.node;
    }
    let pos = pcx.nodes[node as usize].start;
    let m = buf_new();
    let mutable = lk == BK_MUT || lk == BK_MUT2;
    if code == C_MUT_TWICE {
        buf_str(m, c"cannot borrow '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' as mutable more than once at a time");
    } else if code == C_CONFLICT {
        buf_str(m, c"cannot borrow '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, if kind == A_RB { c"' as immutable because it is also borrowed as mutable" }
            else { c"' as mutable because it is also borrowed as immutable" });
    } else if code == C_USE_BORROWED {
        buf_str(m, c"cannot use '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' because it is mutably borrowed");
    } else if code == C_ASSIGN_BORROWED {
        buf_str(m, c"cannot assign to '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' because it is borrowed");
    } else if code == C_MOVE_BORROWED {
        buf_str(m, c"cannot move out of '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' because it is borrowed");
    } else if code == C_DROPPED_BORROWED
        && (pbody.locals[l as usize].flags & crate::places::ir::LF_TEMP) != 0
        && (pbody.locals[l as usize].flags
            & (crate::places::ir::LF_USER | crate::places::ir::LF_PROMOTED))
        == 0 {
        // (0.28.0: a statement's temporary, rustc's E0716)
        buf_str(m, c"a temporary value is dropped at the end of its statement while it is still borrowed (bind it with a `let` to keep it)");
    } else if code == C_DROPPED_BORROWED {
        buf_str(m, c"'");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m,
            if st.kind
                == SK_DEAD {
                c"' does not live long enough: its scope ends here while it is still borrowed"
            }
            else { c"' is dropped while it is still borrowed" });
        if drop_node != 0 {
            buf_str(m, c" (dropped at ");
            buf_position(m, pcx.nodes[drop_node as usize].start, pcx);
            buf_str(m, c")");
        }
    } else if code == C_RETURN_LOCAL {
        buf_str(m, c"a reference to '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"', a local of this function, escapes it");
    } else {
        buf_str(m, c"cannot write to '");
        buf_place(m, l, p, deref, pbody, pcx);
        buf_str(m, c"' in a match guard: the match tests it");
    }
    buf_str(m, if mutable { c" (mutably borrowed at " } else { c" (borrowed at " });
    let lnode = pbody.stmts[ls as usize].node;
    if lnode != 0 {
        buf_position(m, pcx.nodes[lnode as usize].start, pcx);
    } else {
        buf_str(m, c"a borrow the compiler made");
    }
    buf_str(m, c")");
    let help = if code == C_MUT_TWICE {
        c"finish the first borrow's uses before the second, or reborrow once and pass it on"
    } else if code == C_CONFLICT {
        c"use the shared borrow before the mutable one, or take it again after"
    } else if code == C_USE_BORROWED {
        c"use it after the mutable borrow's last use"
    } else if code == C_ASSIGN_BORROWED {
        c"assign after the borrow's last use, or shadow the reference (`let r = ..`) instead of reassigning it"
    } else if code == C_MOVE_BORROWED {
        c"move it after the borrow's last use, or clone it"
    } else if code == C_DROPPED_BORROWED {
        c"declare it before what borrows it, so it is dropped after"
    } else if code == C_RETURN_LOCAL {
        c"return an owned value, or borrow from a parameter"
    } else {
        c"write it in the arm, after the match has decided"
    };
    // RULE: C3.3 (the wrapper's `result` holds the loan until the return:
    // the contract's help, places::result_borrow_help's words)
    if (code == C_USE_BORROWED || code == C_CONFLICT) && pbody.fn_ >= 0
        && crate::places::has_ensures(pbody.fn_, pcx) {
        let h = buf_new();
        buf_str(h, c"'");
        buf_place(h, l, 0, 0, pbody, pcx);
        buf_str(h, c"' is borrowed by 'result'; state the promise on '*result' or on 'old(..)'");
        report_error_tries(pos, 1000 + j * 16 + code, code_name(code), buf_slice(m).ptr,
            buf_slice(h).ptr, b"", false, pcx);
        return;
    }
    // RULE: section 14.1 (move_borrowed's try: `.clone()` where it moves)
    let tr: i64 = if code == C_MOVE_BORROWED { try_wrap(st.node, c"", c".clone()", pcx) }
        else { -1 };
    report_error_tries(pos, 1000 + j * 16 + code, code_name(code), buf_slice(m).ptr, help,
        if tr >= 0 { buf_slice(tr) } else { b"" }, false, pcx);
}

// The place as the user names it, as rustc's messages do: the root's
// source name when it has one (a user local, a parameter) and the path in
// source form (`s.n`, `*r`, `v[_]`, `(o as Some).0`: a deref before a
// field or an index is the auto-deref and not written); the IR's form for
// a temporary's place.
pub fn buf_place(m: i64, l: i64, p: i64, deref: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) {
    if deref != 0 {
        buf_str(m, c"*");
    }
    let lc = pbody.locals[l as usize];
    if (lc.flags & (LF_USER | LF_PARAM)) != 0 && lc.src >= 0 {
        buf_src_place(m, l, p, false, pbody, pcx);
        return;
    }
    crate::places::print::buf_place(m, l, p, pbody, pcx);
}

// Place (l, p) of a named root in source form; `auto` when the step
// outside it is a field or an index (a deref there is not written).
fn buf_src_place(m: i64, l: i64, p: i64, auto: bool, pbody: &Body<Comp>, pcx: &Ctx<Comp>) {
    if p == 0 {
        // UNSAFE: LOCALS is the checker's raw table of locals.
        // SAFETY: buf_place checked pbody.locals[l].src is a local the
        // checker defined (a body's src), below LOCAL_COUNT.
        let name = unsafe { pcx.locals[pbody.locals[l as usize].src as usize].name };
        crate::base::buf_bytes(m, sym_text(name, pcx));
        return;
    }
    let k = proj_kind(p, pbody);
    let parent = proj_parent(p, pbody);
    // (a capture in a closure body is named as the captured variable,
    // rustc's `b.n` for `(*(*_1).0).0`; a by-reference capture's own deref
    // is not written)
    let cap = env_capture(l, p, pbody, pcx);
    if cap >= 0 {
        // UNSAFE: LOCALS is the checker's raw table of locals.
        // SAFETY: a capture's local is one the checker defined, below
        // LOCAL_COUNT.
        let name = unsafe { pcx.locals[pcx.capture_list.get(cap) as usize].name };
        crate::base::buf_bytes(m, sym_text(name, pcx));
        return;
    }
    if k == PJ_DEREF && env_capture(l, parent, pbody, pcx) >= 0
        && pcx.capture_list.get(env_capture(l, parent, pbody, pcx) + 1) != 0 {
        buf_src_place(m, l, parent, auto, pbody, pcx);
        return;
    }
    if k == PJ_DEREF {
        if !auto {
            buf_str(m, c"*");
        }
        buf_src_place(m, l, parent, auto, pbody, pcx);
        return;
    }
    if k == PJ_VARIANT {
        buf_str(m, c"(");
        buf_src_place(m, l, parent, false, pbody, pcx);
        buf_str(m, c" as ");
        // UNSAFE: VARIANTS is the checker's raw table of variants.
        // SAFETY: the projection's value is a variant the checker resolved.
        let name = unsafe { pcx.variants[proj_val(p, pbody) as usize].name };
        crate::base::buf_bytes(m, sym_text(name, pcx));
        buf_str(m, c")");
        return;
    }
    buf_src_place(m, l, parent, true, pbody, pcx);
    let v = proj_val(p, pbody);
    if k == PJ_FIELD || k == PJ_UNION {
        buf_str(m, c".");
        let s = named_struct(l, parent, pbody, pcx);
        if s >= 0 && v >= 0 && v < struct_field_count(s, pcx) {
            crate::base::buf_bytes(m,
                sym_text(crate::places::front::struct_field_name(s, v, pcx), pcx));
        } else {
            crate::base::buf_int(m, v);
        }
    } else if k == PJ_INDEX {
        buf_str(m, c"[_]");
    } else if k == PJ_CONST {
        buf_str(m, c"[");
        crate::base::buf_int(m, v);
        buf_str(m, c"]");
    }
}

// The struct (STRUCTS) place (l, p) is, through its derefs; -1 for any
// other type or one the walk cannot name without making a type.
fn named_struct(l: i64, p: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut t = named_place_ty(l, p, pbody, pcx);
    while t > 0
        && (pcx.types[t as usize].kind == TyKind::Distinct
            || pcx.types[t as usize].kind == TyKind::Ptr) {
        t = pcx.types[t as usize].a;
    }
    if t > 0 && pcx.types[t as usize].kind == TyKind::Struct { pcx.types[t as usize].a } else { -1 }
}

// full_place_type's walk for naming, by value: 0 where a step would need
// a new type (a slice's parts) or does not apply.
fn named_place_ty(l: i64, p: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if p == 0 {
        return pbody.locals[l as usize].ty;
    }
    let k = proj_kind(p, pbody);
    let parent = proj_parent(p, pbody);
    let v = proj_val(p, pbody);
    if k == PJ_FIELD && parent > 0 && proj_kind(parent, pbody) == PJ_VARIANT {
        return crate::places::ir::variant_part_type(proj_val(parent, pbody), v, pcx);
    }
    let mut t = named_place_ty(l, parent, pbody, pcx);
    while t > 0 && pcx.types[t as usize].kind == TyKind::Distinct {
        t = pcx.types[t as usize].a;
    }
    if t <= 0 {
        return 0;
    }
    let tk = pcx.types[t as usize].kind;
    if k == PJ_DEREF || k == PJ_INDEX || k == PJ_CONST {
        return if tk == TyKind::Ptr || tk == TyKind::Array || tk == TyKind::Slice {
            pcx.types[t as usize].a
        } else {
            0
        };
    }
    if k == PJ_VARIANT {
        return t;
    }
    if tk == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        return if v >= 0 && v < struct_field_count(s, pcx) {
            crate::places::ir::struct_field_ty(s, v, pcx)
        } else {
            0
        };
    }
    if tk == TyKind::Tuple && v >= 0 && v < pcx.types[t as usize].count {
        return crate::front::types::type_elem(t, v, pcx);
    }
    0
}

// The CAPTURE_LIST index of the (local, by_ref) pair that place (l, p) of
// a closure body is the env's field for, `(*_1).k` or `_1.k` (a by-value
// env), the env the `{env}` parameter; -1 for any other place.
fn env_capture(l: i64, p: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if p == 0 || proj_kind(p, pbody) != PJ_FIELD || pbody.locals[l as usize].src < 0 {
        return -1;
    }
    // UNSAFE: LOCALS is the checker's raw table of locals.
    // SAFETY: src was checked >= 0 above; it is a local the checker
    // defined (a body's src), below LOCAL_COUNT.
    if unsafe { pcx.locals[pbody.locals[l as usize].src as usize].name } != pcx.env_sym {
        return -1;
    }
    let mut t = pbody.locals[l as usize].ty;
    let q = proj_parent(p, pbody);
    if q != 0 {
        if proj_kind(q, pbody) != PJ_DEREF || proj_parent(q, pbody) != 0 || t <= 0
            || pcx.types[t as usize].kind != TyKind::Ptr {
            return -1;
        }
        t = pcx.types[t as usize].a;
    }
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct
        || !crate::places::ir::struct_closure(t, pcx) {
        return -1;
    }
    let c = pcx.structs[pcx.types[t as usize].a as usize].closure - 1;
    let k = proj_val(p, pbody);
    if c < 0 || k < 0 || k >= pcx.closures[c as usize].capture_count {
        return -1;
    }
    pcx.closures[c as usize].captures + 2 * k
}
