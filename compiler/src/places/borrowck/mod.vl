// (0.27.1) The rust edition's borrow checker: NLL on the places IR, the
// semantics of docs/design/borrowck.md (every rule cited as `RULE: Dn.m`).
// Per rust-edition body, after elaboration and regions.vl's tables:
// liveness (liveness.vl, D3.7), the constraints (constraints.vl, D3.6),
// the solve (solve.vl, D6.1), and the regions dump (dump.vl, section 16:
// `check --emit-places=regions`). M1 reports no errors: the accesses
// (D2.5), moves (S8) and dropck (S9) are M2 and M3.
//
// The state is one Bck, made once per run (run_places) and reused per
// body: the sets are bitsets of i64 words (a local set nw_l words, a
// point set nw_p words: the body's points, D3.1, then one `end` bit per
// universal). Region variables are counted from 1 as regions.vl counts
// them; the table's rows come first, then the reborrows the reading rule
// of D3.6 makes (origin RO_REBORROW, of the statement).

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::timer::{T_BORROWCK, T_PLACES_BUILD, timer_now, timer_sub};
use crate::places::ir::Body;
use crate::places::regions::{
    RO_CALL, RO_UNIVERSAL, Sig, region_count, region_origin, region_word, sig_new, slot_var,
    slots_bound,
};

pub mod liveness;
pub mod constraints;
pub mod solve;
pub mod access;
pub mod moves;
pub mod diag;
pub mod dump;

// A loan record's words (Bck.loans).
pub const LOAN_WORDS: i64 = 6;

// The origin of a region variable the checker adds: an implicit reborrow
// (D3.6's reading of `copy Q` for a `&mut` Q), of the statement.
pub const RO_REBORROW: i64 = 5;

// A slot's variance in its type (D5.1): bivariant, co-, contra-, invariant.
pub const VAR_BI: i64 = 0;
pub const VAR_CO: i64 = 1;
pub const VAR_CONTRA: i64 = 2;
pub const VAR_IN: i64 = 3;

// A deref-like projection's pointee mode (D1.2).
pub const MODE_SHARED: i64 = 1;
pub const MODE_MUT: i64 = 2;
pub const MODE_RAW: i64 = 3;

pub struct Bck<A: Allocator> {
    // The body's sizes: locations, points (2 a location), locals, the
    // table's regions, the regions with the reborrows, universals.
    pub nloc: i64,
    pub npts: i64,
    pub nlocal: i64,
    pub nbase: i64,
    pub nreg: i64,
    pub nuniv: i64,
    pub nw_l: i64,
    pub nw_p: i64,
    // Per local: its first region variable (0: no slot) and its slots.
    pub first: Vec<i64, A>,
    pub nslots: Vec<i64, A>,
    // Per region (index r - 1): its origin, what it is of, its universal
    // index (-1: not a universal).
    pub origin: Vec<i64, A>,
    pub of: Vec<i64, A>,
    pub univ: Vec<i64, A>,
    // Per location: its call region (0: none).
    pub call_region: Vec<i64, A>,
    // Liveness (D3.7): per location its use, def and drop-use sets of
    // locals; per point the use-live and drop-live locals; per block the
    // dataflow's in and out sets, for both flows.
    pub uses: Vec<i64, A>,
    pub defs: Vec<i64, A>,
    pub drops: Vec<i64, A>,
    pub live: Vec<i64, A>,
    pub dlive: Vec<i64, A>,
    pub bin: Vec<i64, A>,
    pub bout: Vec<i64, A>,
    pub tmp: Vec<i64, A>,
    // Per region: whether a drop of its local requires it live (D9.1).
    pub dropck: Vec<i64, A>,
    // The constraints (D3.4): triples (sup, sub, loc), `'sup : 'sub` made
    // at loc; then as adjacency sub -> sups (adj_at, adj).
    pub edges: Vec<i64, A>,
    pub adj_at: Vec<i64, A>,
    pub adj: Vec<i64, A>,
    // The solution (D6.1): per region nw_p words.
    pub val: Vec<i64, A>,
    pub queue: Vec<i64, A>,
    pub inq: Vec<i64, A>,
    // The loans (D2.1): LOAN_WORDS each, the statement, the region, the
    // kind (BK_*), the place's local and projection, and whether the loan
    // is of `*place` (D3.6's reborrow reading: 1) or of the place (0).
    pub loans: Vec<i64, A>,
    // Per loan: its activation location (D7.1; -1: none). The loans in
    // scope (D2.4): per block the set at its entry and exit, the walk's
    // current set, nw_n words each; the conflicts reported (dedupe,
    // section 14.3: loan, place local, projection, code).
    pub act: Vec<i64, A>,
    pub sin: Vec<i64, A>,
    pub sout: Vec<i64, A>,
    pub cur: Vec<i64, A>,
    pub nw_n: i64,
    pub reported: Vec<i64, A>,
    // Two places' projection lists root-first (access.vl rel); per local,
    // the constant it holds when it is assigned once, a constant (an index
    // temporary; -1: none).
    pub pa: Vec<i64, A>,
    pub pb: Vec<i64, A>,
    pub cidx: Vec<i64, A>,
    // A place's regions (regions.vl place_regions: the walk's, a source's
    // kept, a destination's kept, a prefix's), a type's slot variances, a
    // field's map (field_map), a callee's signature (sig_of); the
    // universals' order (D4.5: nuniv words a universal, bit v set when it
    // outlives universal v).
    pub regs: Vec<i64, A>,
    pub regs_a: Vec<i64, A>,
    pub regs_b: Vec<i64, A>,
    pub regs2: Vec<i64, A>,
    pub vars: Vec<i64, A>,
    pub fmap: Vec<i64, A>,
    pub sig: Sig<A>,
    pub outlives: Vec<i64, A>,
    // The instances' dedupe keys (D4.4(b)), with each one's verdict;
    // whether the last body reused one (the dump prints that alone).
    pub keys: Vec<i64, A>,
    pub last_reused: bool,
    // The locations of the moves reported move_borrowed (access.vl): a use
    // after one of them is not reported again (moves.vl).
    pub bad_moves: Vec<i64, A>,
    // A place walk's results (constraints.vl walk_place): the projection
    // list root-first, the slot range reached, the type there, and the
    // deref-like steps passed (a region and a mode each, root-first), then
    // the supporting prefixes' regions (D1.3) made of them.
    pub pscratch: Vec<i64, A>,
    pub vscratch: Vec<i64, A>,
    pub steps: Vec<i64, A>,
    pub supports: Vec<i64, A>,
    pub w_first: i64,
    pub w_count: i64,
    pub w_type: i64,
    // The run's counts, for `solved: N bodies, M reused (key)`.
    pub bodies: i64,
    pub reused: i64,
}

static var EMIT_REGIONS: bool = false;

// `--emit-places=regions`: the dump of section 16 after each body.
pub fn set_emit_regions(on: bool) {
    EMIT_REGIONS = on;
}

pub fn emit_regions() -> bool {
    EMIT_REGIONS
}

pub fn state_new() -> Bck<Comp> {
    Bck {
        nloc: 0, npts: 0, nlocal: 0, nbase: 0, nreg: 0, nuniv: 0, nw_l: 1, nw_p: 1,
        first: Vec::new_in(Comp {}),
        nslots: Vec::new_in(Comp {}),
        origin: Vec::new_in(Comp {}),
        of: Vec::new_in(Comp {}),
        univ: Vec::new_in(Comp {}),
        call_region: Vec::new_in(Comp {}),
        uses: Vec::new_in(Comp {}),
        defs: Vec::new_in(Comp {}),
        drops: Vec::new_in(Comp {}),
        live: Vec::new_in(Comp {}),
        dlive: Vec::new_in(Comp {}),
        bin: Vec::new_in(Comp {}),
        bout: Vec::new_in(Comp {}),
        tmp: Vec::new_in(Comp {}),
        dropck: Vec::new_in(Comp {}),
        edges: Vec::new_in(Comp {}),
        adj_at: Vec::new_in(Comp {}),
        adj: Vec::new_in(Comp {}),
        val: Vec::new_in(Comp {}),
        queue: Vec::new_in(Comp {}),
        inq: Vec::new_in(Comp {}),
        loans: Vec::new_in(Comp {}),
        act: Vec::new_in(Comp {}),
        sin: Vec::new_in(Comp {}),
        sout: Vec::new_in(Comp {}),
        cur: Vec::new_in(Comp {}),
        nw_n: 1,
        reported: Vec::new_in(Comp {}),
        pa: Vec::new_in(Comp {}),
        pb: Vec::new_in(Comp {}),
        cidx: Vec::new_in(Comp {}),
        regs: Vec::new_in(Comp {}),
        regs_a: Vec::new_in(Comp {}),
        regs_b: Vec::new_in(Comp {}),
        regs2: Vec::new_in(Comp {}),
        vars: Vec::new_in(Comp {}),
        fmap: Vec::new_in(Comp {}),
        sig: sig_new(),
        outlives: Vec::new_in(Comp {}),
        keys: Vec::new_in(Comp {}),
        last_reused: false,
        bad_moves: Vec::new_in(Comp {}),
        pscratch: Vec::new_in(Comp {}),
        vscratch: Vec::new_in(Comp {}),
        steps: Vec::new_in(Comp {}),
        supports: Vec::new_in(Comp {}),
        w_first: 0, w_count: 0, w_type: 0,
        bodies: 0, reused: 0,
    }
}

// The body held, a rust-edition function's with its regions assigned:
// its liveness, constraints and solution computed (M1: no error yet).
// Timed apart from the places build, as `borrowck`.
pub fn check_body(f: i64, bck: inout Bck<Comp>, pbody: inout Body<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let t = timer_now(pcx);
    // RULE: D4.4 (an instance whose key was seen reuses the verdict: its
    // errors were reported at the template's position by the first)
    let key = instance_key(f, &bck, &pcx);
    bck.last_reused = key >= 0 && bck.keys[key] != 0;
    if bck.last_reused {
        bck.reused += 1;
        timer_sub(T_PLACES_BUILD, T_BORROWCK, t, pcx);
        return bck.keys[key];
    }
    let e0 = crate::base::diag::error_count(pcx);
    // (the graph: elaboration's fast path leaves the last body's)
    crate::places::cfg::compute_preds(&pbody);
    crate::places::cfg::compute_rpo(&pbody);
    begin_body(&bck, pbody, pcx);
    crate::places::borrowck::liveness::compute(&bck, pbody, &pcx);
    crate::places::borrowck::constraints::generate(&bck, pbody, &pcx);
    crate::places::borrowck::solve::solve(&bck, pbody, &pcx);
    crate::places::borrowck::access::check(&bck, pbody, &pcx);
    crate::places::borrowck::moves::check(&bck, &pbody, &pcx);
    if pcx.verify_places {
        crate::places::borrowck::access::verify_exits(&bck, pbody, &pcx);
    }
    bck.bodies += 1;
    timer_sub(T_PLACES_BUILD, T_BORROWCK, t, pcx);
    let node = crate::places::front::fn_node(f, pcx);
    let closure = node > 0 && pcx.nodes[node].kind == crate::front::ast::NodeKind::Closure;
    let verdict = if crate::base::diag::error_count(pcx) > e0 { VERDICT_ERRORS }
        else if closure { VERDICT_DEFERRED } else { VERDICT_CLEAN };
    if key >= 0 {
        bck.keys[key] = verdict;
    }
    verdict
}

// The dedupe key of instance f (D4.4(b)): its template and, per type
// argument, its slots' count and whether it has drop glue; the index of
// its verdict word in keys (0: not solved yet), or -1 for a function
// that is not an instance.
fn instance_key(f: i64, bck: inout Bck<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let n = pcx.fns[f].targ_count;
    if n <= 0 || pcx.fns[f].tmpl < 0 {
        return -1;
    }
    bck.vscratch.clear();
    bck.vscratch.push(pcx.fns[f].tmpl);
    bck.vscratch.push(n);
    for i in 0..n {
        let t = crate::places::front::tlist_at(pcx.fns[f].targs + i, pcx);
        bck.vscratch.push(crate::places::regions::slot_count(t, pcx));
        bck.vscratch.push(if crate::front::own::glue::has_glue(t, &pcx) { 1 } else { 0 });
    }
    let w = bck.vscratch.len() as i64;
    // (entries: the key's words, then the verdict word)
    var i = 0;
    while i + w < bck.keys.len() as i64 {
        var same = true;
        for j in 0..w {
            if bck.keys[i + j] != bck.vscratch[j] {
                same = false;
            }
        }
        if same {
            return i + w;
        }
        i += bck.keys[i + 1] * 2 + 3;
    }
    for j in 0..w {
        bck.keys.push(bck.vscratch[j]);
    }
    bck.keys.push(0);
    bck.keys.len() as i64 - 1
}

// The sizes and the region tables of the body held, from regions.vl's
// rows: a local's slots are consecutive rows (RO_LOCAL or RO_UNIVERSAL,
// pushed in local order), a call's region is of its statement.
fn begin_body(bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: Ctx<Comp>) {
    bck.nloc = pbody.stmts.len() as i64;
    bck.npts = 2 * bck.nloc;
    bck.nlocal = pbody.locals.len() as i64;
    bck.nbase = region_count(pbody);
    bck.nreg = bck.nbase;
    bck.nw_l = (bck.nlocal + 63) / 64;
    if bck.nw_l < 1 {
        bck.nw_l = 1;
    }
    bck.first.clear();
    bck.nslots.clear();
    for _ in 0..bck.nlocal {
        bck.first.push(0);
        bck.nslots.push(0);
    }
    bck.origin.clear();
    bck.of.clear();
    bck.univ.clear();
    bck.call_region.clear();
    for _ in 0..bck.nloc {
        bck.call_region.push(0);
    }
    bck.nuniv = 0;
    for r in 1..bck.nbase + 1 {
        let o = region_origin(r, pbody);
        let of = region_word(r, 0, pbody);
        bck.origin.push(o);
        bck.of.push(if o == RO_UNIVERSAL { -1 } else { of });
        if o == RO_UNIVERSAL {
            bck.univ.push(bck.nuniv);
            bck.nuniv += 1;
        } else {
            bck.univ.push(-1);
        }
        if o == RO_CALL && of >= 0 && of < bck.nloc && bck.call_region[of] == 0 {
            // (ir271 M1: n call regions a call; the first stands for them here)
            bck.call_region[of] = r;
        }
    }
    // (a local's slots are regions.vl's slot_var, a place's regions
    // place_regions: first names the first slot's variable, nslots the
    // slots bound)
    bck.loans.clear();
    bck.edges.clear();
    for l in 0..bck.nlocal {
        let n = slots_bound(l, pbody);
        bck.nslots[l] = n;
        if n > 0 {
            bck.first[l] = slot_var(l, 0, pbody);
        }
    }
}

// The verdict per function (D17.7): 0 not checked, 1 clean, 2 errors, 3
// deferred (a closure body: its captured places are reached through the
// raw env, D10.4).
pub const VERDICT_CLEAN: i64 = 1;
pub const VERDICT_ERRORS: i64 = 2;
pub const VERDICT_DEFERRED: i64 = 3;

// RULE: D17.7
pub fn set_verdict(f: i64, verdict: i64, pcx: inout Ctx<Comp>) {
    while pcx.borrowck_verdict.len() as i64 <= f {
        pcx.borrowck_verdict.push(0);
    }
    pcx.borrowck_verdict[f] = verdict;
}

// Whether function f's body was checked and found clean (D17.7).
pub fn borrowck_clean(f: i64, pcx: Ctx<Comp>) -> bool {
    f >= 0 && f < pcx.borrowck_verdict.len() as i64 && pcx.borrowck_verdict[f] == VERDICT_CLEAN
}

// A region variable the checker adds (RO_REBORROW of statement s): its
// number.
pub fn new_region(origin: i64, s: i64, bck: inout Bck<Comp>) -> i64 {
    bck.origin.push(origin);
    bck.of.push(s);
    bck.univ.push(-1);
    bck.nreg += 1;
    bck.nreg
}

// Whether bit i is on in the set at words [base..] of v.
pub fn bit_on(v: Vec<i64, Comp>, base: i64, i: i64) -> bool {
    (v[base + (i >> 6)] >> (i & 63)) & 1 != 0
}

// A constraint `'sup : 'sub` (D3.4) made at location loc.
pub fn edge(sup: i64, sub: i64, loc: i64, bck: inout Bck<Comp>) {
    if sup <= 0 || sub <= 0 || sup == sub {
        return;
    }
    bck.edges.push(sup);
    bck.edges.push(sub);
    bck.edges.push(loc);
}

// The block of location loc and its index in it, as `bbK[i]` prints
// (the terminator is the slot after the block's statements).
pub fn loc_block(loc: i64, pbody: Body<Comp>) -> i64 {
    for b in 0..crate::places::ir::block_count(pbody) {
        let start = crate::places::ir::block_start(b, pbody);
        if start >= 0 && loc >= start && loc <= start + crate::places::ir::block_len(b, pbody) {
            return b;
        }
    }
    -1
}
