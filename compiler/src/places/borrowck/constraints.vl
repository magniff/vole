// (0.27.1) Constraint generation (docs/design/borrowck.md D3.3-D3.6): one
// pass over the statements after elaboration, each emitting outlives
// edges `'a : 'b` (mod.vl edge) between the regions of the places it
// moves a reference between, by variance (D3.5), and the supporting-
// prefix constraints of a borrow (D3.6). The slots, a place's regions,
// a signature's universals and a slot's variance are regions.vl's
// (ir271 M1: place_regions, sig_of, slot_variances); a call's regions
// are its RO_CALL rows, one per callee universal (its first in the
// call's PStmt.e, 'static the body's variable 1); the return's
// constraint is against the body's ret_var.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{REF_MUT, REF_SHARED, TyKind, type_elem};
use crate::places::borrowck::{Bck, MODE_MUT, MODE_RAW, MODE_SHARED, edge};
use crate::places::ir::{
    AK_CLOSURE, AK_VARIANT, BK_MUT, BK_RAW, BK_RAW_MUT, BK_SHARED, Body, PJ_CONST, PJ_DEREF,
    PJ_INDEX, RV_AGG, RV_CAST, RV_REF, RV_REPEAT, RV_SLICE, RV_USE, SK_ASSIGN, SK_CALL, TK_RETURN,
    full_place_type, local_ty, op_a, op_b, op_is_place, op_kind, proj_kind, proj_parent, proj_val,
    step_type, undistinct,
};
use crate::places::regions::{
    V_CO, V_CONTRA, V_INV, field_map, place_regions, sig_of, slot_variances, universal_count,
};

// RULE: D3.6
pub fn generate(bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    for loc in 0..bck.nloc {
        let st = pbody.stmts[loc];
        if st.kind == SK_ASSIGN {
            assign(loc, &bck, pbody, &pcx);
        } else if st.kind == SK_CALL {
            call(loc, &bck, pbody, &pcx);
        } else if st.kind == TK_RETURN {
            ret(loc, &bck, pbody, &pcx);
        }
    }
}

// The projection list p, root-first, in pscratch.
fn proj_list(p: i64, bck: inout Bck<Comp>, pbody: Body<Comp>) {
    bck.pscratch.clear();
    var q = p;
    while q > 0 {
        bck.pscratch.push(q);
        q = proj_parent(q, pbody);
    }
    let n = bck.pscratch.len() as i64;
    for i in 0..n / 2 {
        let a = bck.pscratch[i];
        bck.pscratch[i] = bck.pscratch[n - 1 - i];
        bck.pscratch[n - 1 - i] = a;
    }
}

// The pointee mode of a deref-like step on a place of type t (D1.2).
pub fn mode_of(t0: i64, pcx: Ctx<Comp>) -> i64 {
    let t = undistinct(t0, pcx);
    if t <= 0 {
        return MODE_RAW;
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Ptr || k == TyKind::Slice {
        let b = pcx.types[t].b;
        if b == REF_MUT {
            return MODE_MUT;
        }
        if b == REF_SHARED || k == TyKind::Slice {
            return MODE_SHARED;
        }
    }
    MODE_RAW
}

// Whether the type is an exclusive reference (D3.6's reborrow reading
// applies to a `copy` of a place of it).
pub fn is_mut_ref(t0: i64, pcx: Ctx<Comp>) -> bool {
    let t = undistinct(t0, pcx);
    t > 0 && pcx.types[t].kind == TyKind::Ptr && pcx.types[t].b == REF_MUT
}

// Whether a step of kind k on a place of type t is deref-like (D1.2).
fn deref_like(k: i64, t: i64, pcx: Ctx<Comp>) -> bool {
    if k == PJ_DEREF {
        return true;
    }
    if k == PJ_INDEX || k == PJ_CONST {
        let tu = undistinct(t, pcx);
        return tu > 0 && pcx.types[tu].kind == TyKind::Slice;
    }
    false
}

// The place (l, p) walked (D3.3's place regions, D1.2's deref-like
// steps): regs its regions (place_regions: a variable per slot of its
// type, 0 for one without), w_type its type, steps the deref-like steps
// passed (a region and a mode each, root-first: the region of the
// reference or view stepped through, 0 for a raw pointer), and supports
// the supporting prefixes' regions (D1.3: through the mutable steps, up
// to and including the last shared one, none through a raw one).
// RULE: D1.2, D1.3, D3.3
pub fn walk_place(l: i64, p: i64, bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    proj_list(p, &bck, pbody);
    bck.steps.clear();
    bck.supports.clear();
    var t = local_ty(l, pbody);
    let n = bck.pscratch.len() as i64;
    for i in 0..n {
        let q = bck.pscratch[i];
        let k = proj_kind(q, pbody);
        if deref_like(k, t, pcx) {
            let m = mode_of(t, pcx);
            var r = 0;
            if m != MODE_RAW {
                // (the base's own region: the first slot of the prefix)
                let base = if i == 0 { 0 } else { bck.pscratch[i - 1] };
                bck.regs2.clear();
                place_regions(l, base, pbody, &bck.regs2, &pcx);
                if bck.regs2.len() > 0 {
                    r = bck.regs2[0];
                }
            }
            bck.steps.push(r);
            bck.steps.push(m);
        }
        t = step_type(t, k, proj_val(q, pbody), &pcx);
    }
    bck.regs.clear();
    place_regions(l, p, pbody, &bck.regs, &pcx);
    bck.w_type = full_place_type(l, p, pbody, &pcx);
    var i = bck.steps.len() as i64 - 2;
    while i >= 0 {
        let r = bck.steps[i];
        let m = bck.steps[i + 1];
        if m == MODE_RAW {
            break;
        }
        if r > 0 {
            bck.supports.push(r);
        }
        if m == MODE_SHARED {
            break;
        }
        i -= 2;
    }
}

// Whether place (l, p) has a deref-like projection (D1.2).
pub fn deref_like_in(l: i64, p: i64, bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) -> bool {
    walk_place(l, p, &bck, pbody, &pcx);
    bck.steps.len() > 0
}

// regs (the walk's) kept as the source: into regs_a.
fn keep_regs(bck: inout Bck<Comp>) {
    bck.regs_a.clear();
    for i in 0..bck.regs.len() as i64 {
        bck.regs_a.push(bck.regs[i]);
    }
}

// sub(src ≤ dst) (D3.5) over the slots from s_off of regs_a and from
// d_off of regs: the variances of type t under context c, slot by slot.
fn sub(s_off: i64, d_off: i64, t: i64, c: i64, loc: i64, bck: inout Bck<Comp>, pcx: Ctx<Comp>) {
    bck.vars.clear();
    slot_variances(t, c, &bck.vars, pcx);
    var i = 0;
    while s_off + i < bck.regs_a.len() as i64 && d_off + i < bck.regs.len() as i64 {
        let v = if i < bck.vars.len() as i64 { bck.vars[i] } else { V_CO };
        let s = bck.regs_a[s_off + i];
        let d = bck.regs[d_off + i];
        if v == V_CO || v == V_INV {
            edge(s, d, loc, &bck);
        }
        if v == V_CONTRA || v == V_INV {
            edge(d, s, loc, &bck);
        }
        i += 1;
    }
}

fn assign(loc: i64, bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let st = pbody.stmts[loc];
    let rv = st.c;
    if rv == RV_REF {
        if st.d == BK_RAW || st.d == BK_RAW_MUT {
            // RULE: R1 (no loan, no constraint)
            return;
        }
        let r = st.e;
        let l = op_a(st.ops, 0, pbody);
        let p = op_b(st.ops, 0, pbody);
        bck.loans.push(loc);
        bck.loans.push(r);
        bck.loans.push(st.d);
        bck.loans.push(l);
        bck.loans.push(p);
        bck.loans.push(0);
        walk_place(l, p, &bck, pbody, &pcx);
        keep_regs(&bck);
        let p_type = bck.w_type;
        // RULE: D3.6 (the supporting-prefix rule)
        for i in 0..bck.supports.len() as i64 {
            edge(bck.supports[i], r, loc, &bck);
        }
        walk_place(st.a, st.b, &bck, pbody, &pcx);
        if bck.regs.len() > 0 {
            edge(r, bck.regs[0], loc, &bck);
            sub(0, 1, p_type, if st.d == BK_SHARED { V_CO } else { V_INV }, loc, &bck, pcx);
        }
        return;
    }
    if rv == RV_SLICE {
        // (a borrow of the base's elements; a view base's own slot is a
        // supporting prefix, D1.4)
        let r = st.e;
        let l = op_a(st.ops, 0, pbody);
        let p = op_b(st.ops, 0, pbody);
        walk_place(l, p, &bck, pbody, &pcx);
        keep_regs(&bck);
        let bt = undistinct(bck.w_type, pcx);
        var e_off = 0;
        var e_type = 0;
        if bt > 0 && pcx.types[bt].kind == TyKind::Slice {
            // (D1.4: the slicing is a deref through the view: its slot
            // supports the loan, and a shared view stops the walk there)
            bck.regs2.clear();
            for i in 0..bck.supports.len() as i64 {
                bck.regs2.push(bck.supports[i]);
            }
            bck.supports.clear();
            if bck.regs_a.len() > 0 {
                bck.supports.push(bck.regs_a[0]);
            }
            if mode_of(bt, pcx) == MODE_MUT {
                for i in 0..bck.regs2.len() as i64 {
                    bck.supports.push(bck.regs2[i]);
                }
            }
            e_off = 1;
            e_type = pcx.types[bt].a;
        } else if bt > 0 && pcx.types[bt].kind == TyKind::Array {
            e_type = pcx.types[bt].a;
        } else {
            bck.regs_a.clear();
        }
        let dt = undistinct(local_ty(st.a, pbody), pcx);
        let mutable = dt > 0 && pcx.types[dt].kind == TyKind::Slice && pcx.types[dt].b == REF_MUT;
        bck.loans.push(loc);
        bck.loans.push(r);
        bck.loans.push(if mutable { BK_MUT } else { BK_SHARED });
        bck.loans.push(l);
        bck.loans.push(p);
        // RULE: D1.4, Z9.5 (the loan of a view base is of its referent, one
        // deref-like step past the base: `v = &v[a..]` kills it and does not
        // conflict with it)
        bck.loans.push(e_off);
        for i in 0..bck.supports.len() as i64 {
            edge(bck.supports[i], r, loc, &bck);
        }
        walk_place(st.a, st.b, &bck, pbody, &pcx);
        if bck.regs.len() > 0 {
            edge(r, bck.regs[0], loc, &bck);
            sub(e_off, 1, e_type, if mutable { V_INV } else { V_CO }, loc, &bck, pcx);
        }
        return;
    }
    if rv == RV_USE || rv == RV_CAST || rv == RV_REPEAT {
        if !op_is_place(op_kind(st.ops, 0, pbody)) {
            return;
        }
        let l = op_a(st.ops, 0, pbody);
        let p = op_b(st.ops, 0, pbody);
        walk_place(l, p, &bck, pbody, &pcx);
        let s_type = bck.w_type;
        if rv == RV_CAST {
            // (a reference cast to a reference keeps its regions; to a raw
            // pointer: none, R1)
            let dt = undistinct(st.d, pcx);
            if dt <= 0 || pcx.types[dt].kind != TyKind::Ptr || pcx.types[dt].b == 0 {
                return;
            }
        }
        keep_regs(&bck);
        walk_place(st.a, st.b, &bck, pbody, &pcx);
        sub(0, 0, s_type, V_CO, loc, &bck, pcx);
        return;
    }
    if rv == RV_AGG {
        // RULE: D3.6 (each part against the field's slots, mapped from the
        // aggregate's: field_map)
        walk_place(st.a, st.b, &bck, pbody, &pcx);
        let d_type = bck.w_type;
        bck.regs_b.clear();
        for i in 0..bck.regs.len() as i64 {
            bck.regs_b.push(bck.regs[i]);
        }
        if bck.regs_b.len() == 0 {
            return;
        }
        let variant = if st.d == AK_VARIANT { st.e } else { -1 };
        for i in 0..st.nops {
            if !op_is_place(op_kind(st.ops, i, pbody)) {
                continue;
            }
            walk_place(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), &bck, pbody, &pcx);
            keep_regs(&bck);
            let o_type = bck.w_type;
            bck.fmap.clear();
            if st.d == AK_CLOSURE {
                // RULE: D10.2 (a capture's slots fill the closure's from its
                // offset: a by-reference capture's loan slot first)
                let off = crate::places::regions::capture_offset(undistinct(d_type, pcx), i, pcx);
                for j in 0..bck.regs_a.len() as i64 {
                    bck.fmap.push(off + j);
                }
            } else {
                field_map(d_type, i, variant, &bck.fmap, pcx);
            }
            // (the destination's slots of this field, in the field's order)
            bck.regs.clear();
            for j in 0..bck.fmap.len() as i64 {
                let m = bck.fmap[j];
                bck.regs.push(if m >= 0 && m < bck.regs_b.len() as i64 { bck.regs_b[m] }
                    else if m == crate::places::regions::MAP_STATIC { 1 } else { 0 });
            }
            sub(0, 0, o_type, V_CO, loc, &bck, pcx);
        }
        if st.d == AK_CLOSURE {
            // RULE: D19.10 (3) (the closure's requirements, on the value's
            // slots where it is made)
            let id = pcx.structs[pcx.types[undistinct(d_type, pcx)].a].closure - 1;
            for k in 0..(if id >= 0 { pcx.closures[id].req_n } else { 0 }) {
                let i = pcx.capture_list.get(pcx.closures[id].req_at + 2 * k);
                let j = pcx.capture_list.get(pcx.closures[id].req_at + 2 * k + 1);
                if i < bck.regs_b.len() as i64 && j < bck.regs_b.len() as i64 {
                    edge(bck.regs_b[i], if j < 0 { 1 } else { bck.regs_b[j] }, loc, &bck);
                }
            }
        }
        let _ = type_elem(0, 0, pcx);
    }
}

// The call region of callee universal u at a call whose first call
// region is e: 'static (u = 0) is the body's variable 1.
fn cvar(u: i64, e: i64) -> i64 {
    if u == 0 {
        return 1;
    }
    if e <= 0 { 0 } else { e + u - 1 }
}

// RULE: D3.6 (a call: the callee's signature instantiated at its call
// regions; each argument against its parameter's slots, the result
// against the destination's, the callee's bounds between the call
// regions)
fn call(loc: i64, bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let st = pbody.stmts[loc];
    if st.c < 0 {
        // (a closure value's call: D10.3, with ir271 M2)
        return;
    }
    sig_of(st.c, &bck.sig, &pcx);
    let e = st.e;
    let nparams = bck.sig.param_at.len() as i64 - 1;
    for i in 0..st.nops {
        if !op_is_place(op_kind(st.ops, i, pbody)) {
            continue;
        }
        let l = op_a(st.ops, i, pbody);
        let p = op_b(st.ops, i, pbody);
        walk_place(l, p, &bck, pbody, &pcx);
        let a_type = bck.w_type;
        keep_regs(&bck);
        let _ = l;
        let _ = p;
        if i >= nparams {
            continue;
        }
        // (the parameter's slots as call regions, into regs)
        bck.regs.clear();
        let base = bck.sig.param_at[i];
        let bound = bck.sig.param_at[i + 1];
        for j in base..bound {
            bck.regs.push(cvar(bck.sig.params[j], e));
        }
        sub(0, 0, a_type, V_CO, loc, &bck, pcx);
    }
    if st.a >= 0 {
        walk_place(st.a, st.b, &bck, pbody, &pcx);
        let d_type = bck.w_type;
        bck.regs_a.clear();
        for j in 0..bck.sig.ret.len() as i64 {
            bck.regs_a.push(cvar(bck.sig.ret[j], e));
        }
        sub(0, 0, d_type, V_CO, loc, &bck, pcx);
    }
    // RULE: D19.10 (4) (a closure body's requirements, at its call regions)
    let id = bck.sig.closure;
    for q in 0..(if id >= 0 { pcx.closures[id].req_n } else { 0 }) {
        let i = pcx.capture_list.get(pcx.closures[id].req_at + 2 * q);
        let j = pcx.capture_list.get(pcx.closures[id].req_at + 2 * q + 1);
        if i < bck.sig.cslots.len() as i64 && j < bck.sig.cslots.len() as i64 {
            edge(cvar(bck.sig.cslots[i], e), cvar(if j < 0 { 0 } else { bck.sig.cslots[j] }, e),
                loc, &bck);
        }
    }
    // RULE: D4.5 (the callee's bounds, at its call regions)
    var k = 0;
    while k + 1 < bck.sig.bounds.len() as i64 {
        edge(cvar(bck.sig.bounds[k], e), cvar(bck.sig.bounds[k + 1], e), loc, &bck);
        k += 2;
    }
    let _ = universal_count(bck.sig);
}

// RULE: D3.6 (`return`: sub(type(_0) ≤ ret[U]), the body's ret_var)
fn ret(loc: i64, bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    walk_place(0, 0, &bck, pbody, &pcx);
    keep_regs(&bck);
    let t = bck.w_type;
    bck.regs.clear();
    for j in 0..pbody.ret_var.len() as i64 {
        bck.regs.push(pbody.ret_var[j]);
    }
    sub(0, 0, t, V_CO, loc, &bck, pcx);
}
