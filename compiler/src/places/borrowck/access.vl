// (0.27.1) The accesses against the loans in scope (docs/design/borrowck.md
// D2.2-D2.5, D2.4a, D7): the loans in scope by a forward dataflow over
// the points (D2.4: a loan enters at the mid point of its statement,
// leaves at a point its region's value lacks, and at a kill, D2.3), then
// each statement's accesses in D2.4a's order checked against the set at
// its start point by D2.5's relation of places (D1.5), its overlap rules
// and its table; a conflict's code by the loan's kind, D6.2.2 for a drop
// or storage end (return_local when the loan escapes the frame). A
// two-phase loan (D7) is shared until the first use of its temporary in
// its block, mutable from it; the activation is an access of its own.

use crate::back::regalloc::intervals::trailing_zeros;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{REF_MUT, TyKind};
use crate::places::borrowck::{Bck, LOAN_WORDS, MODE_MUT, MODE_RAW, MODE_SHARED, bit_on, zero_fill};
use crate::places::borrowck::constraints::mode_of;
use crate::places::borrowck::diag::report;
use crate::places::cfg::{pred, pred_count};
use crate::places::ir::{
    BK_FAKE, BK_MUT, BK_MUT2, BK_RAW, BK_RAW_MUT, BK_SHARED, Body, DS_REMOVED, LF_PARAM, LF_STATIC,
    OK_COPY, OK_INT, OK_MOVE, PJ_CONST, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION, PJ_VARIANT, RV_CAST,
    RV_DISCR, RV_LEN, RV_REF, RV_SLICE, RV_USE, SK_ASSERT, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP,
    SK_INTRINSIC, SK_LIVE, SK_MENTION, TK_RETURN, TK_SWITCH, block_count, block_start, block_term,
    has_flag, local_ty, op_a, op_b, op_kind, proj_kind, proj_parent, proj_val, step_type,
    undistinct,
};

// Access kinds (D2.2).
pub const A_RC: i64 = 1;
pub const A_RB: i64 = 2;
pub const A_RESERVE: i64 = 3;
pub const A_ACTIVATE: i64 = 4;
pub const A_WB: i64 = 5;
pub const A_WA: i64 = 6;
pub const A_WM: i64 = 7;
pub const A_WD: i64 = 8;

// The codes (section 14.1), as diag.vl names them.
pub const C_MUT_TWICE: i64 = 1;
pub const C_CONFLICT: i64 = 2;
pub const C_USE_BORROWED: i64 = 3;
pub const C_ASSIGN_BORROWED: i64 = 4;
pub const C_MOVE_BORROWED: i64 = 5;
pub const C_DROPPED_BORROWED: i64 = 6;
pub const C_RETURN_LOCAL: i64 = 7;
pub const C_GUARD_WRITE: i64 = 8;

// rel's results (D1.5).
const R_DISJOINT: i64 = 0;
const R_EQUAL: i64 = 1;
const R_PREFIX_OF: i64 = 2;
const R_EXTENDS: i64 = 3;

// RULE: D6.2.2 (the premise, checked under --verify-places: every local
// other than the return place and the parameters has a StorageDead on
// every path from its StorageLive to a return; a forward dataflow of the
// locals whose storage is live, read at each return)
pub fn verify_exits(bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let nw = bck.nw_l;
    let nb = block_count(pbody);
    bck.bin.clear();
    bck.bout.clear();
    bck.tmp.clear();
    for _ in 0..nb * nw {
        bck.bin.push(0);
        bck.bout.push(0);
    }
    for _ in 0..nw {
        bck.tmp.push(0);
    }
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..pbody.rpo.len() as i64 {
            let b = pbody.rpo[i as usize];
            for w in 0..nw {
                bck.tmp[w as usize] = 0;
            }
            for j in 0..pred_count(b, pbody) {
                let pb = pred(b, j, pbody);
                for w in 0..nw {
                    bck.tmp[w as usize] = bck.tmp[w as usize] | bck.bout[(pb * nw + w) as usize];
                }
            }
            for w in 0..nw {
                bck.bin[(b * nw + w) as usize] = bck.tmp[w as usize];
            }
            let start = block_start(b, pbody);
            for loc in start..block_term(b, pbody) {
                let st = pbody.stmts[loc as usize];
                if st.kind == SK_LIVE {
                    bck.tmp[(st.a >> 6) as usize] = bck.tmp[(st.a >> 6) as usize]
                        | (1 << (st.a & 63));
                } else if st.kind == SK_DEAD {
                    bck.tmp[(st.a >> 6) as usize] = bck.tmp[(st.a >> 6) as usize]
                        & !(1 << (st.a & 63));
                }
            }
            for w in 0..nw {
                if bck.bout[(b * nw + w) as usize] != bck.tmp[w as usize] {
                    bck.bout[(b * nw + w) as usize] = bck.tmp[w as usize];
                    changed = true;
                }
            }
        }
    }
    for b in 0..nb {
        if pbody.rpo_index[b as usize] < 0
            || pbody.stmts[block_term(b, pbody) as usize].kind != TK_RETURN {
            continue;
        }
        for l in 1..bck.nlocal {
            // (the lemma needs it of a loan's root: a temporary made live
            // before its initialization may leave by an early return)
            if !has_flag(l, LF_PARAM, pbody) && bit_on(&bck.bout, b * nw, l)
                && loan_rooted(l, b, bck) {
                pcx.verify_errors += 1;
                let out = crate::base::buf_new();
                crate::base::buf_str(out, c"places.verify: ");
                crate::places::print::buf_body_name(out, pbody, pcx);
                crate::base::buf_str(out, c" bb");
                crate::base::buf_int(out, b);
                crate::base::buf_str(out, c": local _");
                crate::base::buf_int(out, l);
                crate::base::buf_str(out,
                    c" reaches the return with its storage live (no StorageDead on the path: borrowck.md D6.2.2)\n");
                crate::base::buf_write_fd(out, crate::base::STDERR);
            }
        }
    }
}

// Whether a loan rooted at local l is in scope at the exit of block b
// (the scope dataflow's sout): then a missing StorageDead would let
// the loan escape unreported.
fn loan_rooted(l: i64, b: i64, bck: &Bck<Comp>) -> bool {
    for j in 0..loan_count(bck) {
        if loan_local(j, bck) == l && bit_on(&bck.sout, b * bck.nw_n, j) {
            return true;
        }
    }
    false
}

// RULE: D2.4
pub fn check(bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let nl = loan_count(bck);
    bck.nw_n = (nl + 63) / 64;
    if bck.nw_n < 1 {
        bck.nw_n = 1;
    }
    let nw = bck.nw_n;
    bck.reported.clear();
    bck.bad_moves.clear();
    activations(bck, pbody);
    constant_indexes(bck, pbody);
    loans_by_stmt(nl, bck, pbody);
    loans_by_act(nl, bck, pbody);
    let nb = block_count(pbody);
    zero_fill(&mut bck.sin, nb * nw);
    zero_fill(&mut bck.sout, nb * nw);
    bck.cur.clear();
    for _ in 0..nw {
        bck.cur.push(0);
    }
    let mut changed = true;
    while changed {
        changed = false;
        for i in 0..pbody.rpo.len() as i64 {
            let b = pbody.rpo[i as usize];
            for w in 0..nw {
                bck.cur[w as usize] = 0;
            }
            for j in 0..pred_count(b, pbody) {
                let pb = pred(b, j, pbody);
                if pbody.rpo_index[pb as usize] >= 0 {
                    for w in 0..nw {
                        bck.cur[w as usize] = bck.cur[w as usize]
                            | bck.sout[(pb * nw + w) as usize];
                    }
                }
            }
            for w in 0..nw {
                bck.sin[(b * nw + w) as usize] = bck.cur[w as usize];
            }
            let start = block_start(b, pbody);
            for loc in start..block_term(b, pbody) + 1 {
                transfer(loc, false, bck, pbody, pcx);
            }
            for w in 0..nw {
                if bck.sout[(b * nw + w) as usize] != bck.cur[w as usize] {
                    bck.sout[(b * nw + w) as usize] = bck.cur[w as usize];
                    changed = true;
                }
            }
        }
    }
    // The checks, each block from its entry set.
    for i in 0..pbody.rpo.len() as i64 {
        let b = pbody.rpo[i as usize];
        for w in 0..nw {
            bck.cur[w as usize] = bck.sin[(b * nw + w) as usize];
        }
        let start = block_start(b, pbody);
        for loc in start..block_term(b, pbody) + 1 {
            transfer(loc, true, bck, pbody, pcx);
        }
    }
}

pub fn loan_count(bck: &Bck<Comp>) -> i64 {
    bck.loans.len() as i64 / LOAN_WORDS
}

fn loan_stmt(j: i64, bck: &Bck<Comp>) -> i64 {
    bck.loans[(LOAN_WORDS * j) as usize]
}

pub fn loan_region(j: i64, bck: &Bck<Comp>) -> i64 {
    bck.loans[(LOAN_WORDS * j + 1) as usize]
}

pub fn loan_kind(j: i64, bck: &Bck<Comp>) -> i64 {
    bck.loans[(LOAN_WORDS * j + 2) as usize]
}

pub fn loan_local(j: i64, bck: &Bck<Comp>) -> i64 {
    bck.loans[(LOAN_WORDS * j + 3) as usize]
}

pub fn loan_proj(j: i64, bck: &Bck<Comp>) -> i64 {
    bck.loans[(LOAN_WORDS * j + 4) as usize]
}

pub fn loan_deref(j: i64, bck: &Bck<Comp>) -> i64 {
    bck.loans[(LOAN_WORDS * j + 5) as usize]
}

fn in_cur(j: i64, bck: &Bck<Comp>) -> bool {
    bit_on(&bck.cur, 0, j)
}

fn cur_remove(j: i64, bck: &mut Bck<Comp>) {
    bck.cur[(j >> 6) as usize] = bck.cur[(j >> 6) as usize] & !(1 << (j & 63));
}

fn cur_add(j: i64, bck: &mut Bck<Comp>) {
    bck.cur[(j >> 6) as usize] = bck.cur[(j >> 6) as usize] | (1 << (j & 63));
}

fn val_has(r: i64, p: i64, bck: &Bck<Comp>) -> bool {
    bit_on(&bck.val, r * bck.nw_p, p)
}

// RULE: D7.1 (the activation location of each two-phase loan: the first
// location after it in its block whose operands mention its temporary)
fn activations(bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    bck.act.clear();
    for j in 0..loan_count(bck) {
        bck.act.push(-1);
        if loan_kind(j, bck) != BK_MUT2 {
            continue;
        }
        let s = loan_stmt(j, bck);
        let st = pbody.stmts[s as usize];
        if st.b != 0 {
            continue;
        }
        let t = st.a;
        let b = crate::places::borrowck::loc_block(s, pbody);
        if b < 0 {
            continue;
        }
        for loc in s + 1..block_term(b, pbody) + 1 {
            let u = pbody.stmts[loc as usize];
            for i in 0..u.nops {
                let k = op_kind(u.ops, i, pbody);
                if (k == OK_COPY || k == OK_MOVE) && op_a(u.ops, i, pbody) == t
                    && op_b(u.ops, i, pbody) == 0 {
                    bck.act[j as usize] = loc;
                }
            }
            if bck.act[j as usize] >= 0 {
                break;
            }
        }
    }
}

// Per local, the constant it holds: assigned exactly once, an integer
// constant (the temporary of a constant index into a view, R7).
fn constant_indexes(bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    bck.cidx.clear();
    bck.tmp.clear();
    for _ in 0..bck.nlocal {
        bck.cidx.push(-1);
        bck.tmp.push(0);
    }
    for loc in 0..bck.nloc {
        let st = pbody.stmts[loc as usize];
        let k = st.kind;
        if (k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC) && st.a >= 0 && st.b == 0 {
            bck.tmp[st.a as usize] += 1;
            if k == SK_ASSIGN && st.c == RV_USE && op_kind(st.ops, 0, pbody) == OK_INT {
                bck.cidx[st.a as usize] = op_a(st.ops, 0, pbody);
            }
        }
    }
    for l in 0..bck.nlocal {
        if bck.tmp[l as usize] != 1 {
            bck.cidx[l as usize] = -1;
        }
    }
}

// bck.loan_at and loan_ids: the nl loans by their statement, each
// statement's in their order (a counting sort), for transfer's gen.
fn loans_by_stmt(nl: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    let ns = pbody.stmts.len() as i64;
    bck.loan_at.clear();
    bck.loan_ids.clear();
    for _ in 0..ns + 2 {
        bck.loan_at.push(0);
    }
    for _ in 0..nl {
        bck.loan_ids.push(0);
    }
    // (counts at s + 2, summed: s's start at s + 1; the fill moves it to
    // s's end, which is s + 1's start)
    for j in 0..nl {
        let s = loan_stmt(j, bck);
        if s >= 0 && s < ns {
            bck.loan_at[(s + 2) as usize] += 1;
        }
    }
    for s in 0..ns {
        bck.loan_at[(s + 2) as usize] += bck.loan_at[(s + 1) as usize];
    }
    for j in 0..nl {
        let s = loan_stmt(j, bck);
        if s >= 0 && s < ns {
            { let at_ix = bck.loan_at[(s + 1) as usize] as usize; bck.loan_ids[at_ix] = j };
            bck.loan_at[(s + 1) as usize] += 1;
        }
    }
}

// bck.act_at and act_ids: the nl loans by their activation location
// (act, -1: none), each location's in their order, as loans_by_stmt.
fn loans_by_act(nl: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    let ns = pbody.stmts.len() as i64;
    bck.act_at.clear();
    bck.act_ids.clear();
    for _ in 0..ns + 2 {
        bck.act_at.push(0);
    }
    for _ in 0..nl {
        bck.act_ids.push(0);
    }
    for j in 0..nl {
        let s = bck.act[j as usize];
        if s >= 0 && s < ns {
            bck.act_at[(s + 2) as usize] += 1;
        }
    }
    for s in 0..ns {
        bck.act_at[(s + 2) as usize] += bck.act_at[(s + 1) as usize];
    }
    for j in 0..nl {
        let s = bck.act[j as usize];
        if s >= 0 && s < ns {
            { let at_ix = bck.act_at[(s + 1) as usize] as usize; bck.act_ids[at_ix] = j };
            bck.act_at[(s + 1) as usize] += 1;
        }
    }
}

// The loans in the current set whose region does not hold point p, taken
// out of it: its set bits only, word by word.
fn cur_drop_outside(p: i64, bck: &mut Bck<Comp>) {
    for w in 0..bck.nw_n {
        let mut x = bck.cur[w as usize] as u64;
        while x != 0 {
            let j = w * 64 + trailing_zeros(x);
            x = x & x.wrapping_sub(1u64);
            if !val_has(loan_region(j, bck), p, bck) {
                cur_remove(j, bck);
            }
        }
    }
}

// The set through location loc (D2.4, D2.4a): the start-point filter,
// the accesses (when checking), the kills, the mid-point filter, the gen.
fn transfer(loc: i64, checking: bool, bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    cur_drop_outside(2 * loc, bck);
    if checking {
        accesses(loc, bck, pbody, pcx);
    }
    kills(loc, bck, pbody, pcx);
    cur_drop_outside(2 * loc + 1, bck);
    // (the loans made here: loans_by_stmt)
    if loc >= 0 && loc + 1 < bck.loan_at.len() as i64 {
        for q in bck.loan_at[loc as usize]..bck.loan_at[(loc + 1) as usize] {
            let j = bck.loan_ids[q as usize];
            if val_has(loan_region(j, bck), 2 * loc + 1, bck) {
                cur_add(j, bck);
            }
        }
    }
}

// RULE: D2.3
fn kills(loc: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let st = pbody.stmts[loc as usize];
    let k = st.kind;
    let mut l: i64 = -1;
    let mut p: i64 = 0;
    if (k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC) && st.a >= 0 {
        l = st.a;
        p = st.b;
    } else if k == SK_DEAD {
        l = st.a;
    }
    if l < 0 {
        return;
    }
    // (the current set's loans, by its set bits: cur_drop_outside)
    for w in 0..bck.nw_n {
        let mut x = bck.cur[w as usize] as u64;
        while x != 0 {
            let j = w * 64 + trailing_zeros(x);
            x = x & x.wrapping_sub(1u64);
            let r = rel(l, p, 0, loan_local(j, bck), loan_proj(j, bck), loan_deref(j, bck), true,
                bck, pbody, pcx);
            if (r == R_EQUAL || r == R_PREFIX_OF) && bck.w_count != 0 {
                cur_remove(j, bck);
            }
        }
    }
}

// RULE: D3.6 (0.27.7) Whether `(a, b) = use ops[0]` (or `cast`) makes a
// `&mut` place a raw pointer the checker made a written `*mut` of: a
// `&mut [T]` coerced or cast to `*mut [T]` (the cast is its operand,
// Z9.3), a `&mut T` cast to `*mut T` (places::build::raw_mut_goal of the
// statement's node; a `&mut T` coerced is build's `&raw mut` already).
fn raw_mut_write(a: i64, b: i64, ops: i64, node: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>)
    -> bool {
    if a < 0 || node <= 0 || !crate::places::ir::op_is_place(op_kind(ops, 0, pbody)) {
        return false;
    }
    let dt = undistinct(crate::places::ir::full_place_type(a, b, pbody, pcx), pcx);
    let raw_thin = dt > 0 && pcx.types[dt as usize].kind == TyKind::Ptr
        && pcx.types[dt as usize].b == 0;
    if !raw_thin && !crate::front::types::is_raw_view(dt, pcx) {
        return false;
    }
    let st = undistinct(crate::places::ir::full_place_type(op_a(ops, 0, pbody), op_b(ops, 0, pbody),
        pbody, pcx), pcx);
    let from_mut = st > 0
        && (pcx.types[st as usize].kind == TyKind::Ptr && pcx.types[st as usize].b == REF_MUT
            || crate::front::types::is_mut_slice(st, pcx));
    from_mut && crate::places::build::raw_mut_goal(node, pcx)
}

// The accesses of the statement at loc, in D2.4a's order.
// RULE: D2.2, D2.4a
fn accesses(loc: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let st = pbody.stmts[loc as usize];
    let k = st.kind;
    if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_ASSERT || k == TK_SWITCH {
        for i in 0..st.nops {
            let ok = op_kind(st.ops, i, pbody);
            if ok != OK_COPY && ok != OK_MOVE {
                continue;
            }
            let l = op_a(st.ops, i, pbody);
            let p = op_b(st.ops, i, pbody);
            if ok == OK_COPY {
                access(true, A_RC, -1, l, p, 0, loc, bck, pbody, pcx);
            } else {
                access(true, A_WM, -1, l, p, 0, loc, bck, pbody, pcx);
            }
        }
        // RULE: D7.3 (the activations of the reservations this location
        // uses, after the operands' own accesses: the arguments are read
        // before the call activates its receiver)
        // (loans_by_act: those activated here, in order)
        if loc >= 0 && loc + 1 < bck.act_at.len() as i64 {
            for q in bck.act_at[loc as usize]..bck.act_at[(loc + 1) as usize] {
                let j = bck.act_ids[q as usize];
                access(true, A_ACTIVATE, j, loan_local(j, bck), loan_proj(j, bck),
                    loan_deref(j, bck), loc, bck, pbody, pcx);
            }
        }
        if k == SK_ASSIGN {
            let rv = st.c;
            if rv == RV_REF || rv == RV_SLICE {
                let l = op_a(st.ops, 0, pbody);
                let p = op_b(st.ops, 0, pbody);
                let mut bk = st.d;
                if rv == RV_SLICE {
                    bk = BK_SHARED;
                    let mut loaned = false;
                    // (the loans made here: loans_by_stmt; the last's kind)
                    if loc + 1 < bck.loan_at.len() as i64 {
                        for q in bck.loan_at[loc as usize]..bck.loan_at[(loc + 1) as usize] {
                            bk = loan_kind(bck.loan_ids[q as usize], bck);
                            loaned = true;
                        }
                    }
                    // RULE: D3.6 (0.27.7: `&mut s[..]` made a fat raw pointer
                    // has no loan, R1; it is `&raw mut`, a write)
                    if !loaned && st.a >= 0 && st.d > 0
                        && (pcx.nodes[st.d as usize].p & crate::front::ast::NODE_REF_MUT) != 0
                        && crate::front::types::is_raw_view(undistinct(
                            crate::places::ir::full_place_type(st.a, st.b, pbody, pcx), pcx),
                            pcx) {
                        bk = BK_RAW_MUT;
                    }
                }
                if bk == BK_SHARED {
                    access(true, A_RB, -1, l, p, 0, loc, bck, pbody, pcx);
                } else if bk == BK_MUT {
                    shared_write(loc, l, p, bck, pbody, pcx);
                    access(true, A_WB, -1, l, p, 0, loc, bck, pbody, pcx);
                } else if bk == BK_MUT2 {
                    access(true, A_RESERVE, -1, l, p, 0, loc, bck, pbody, pcx);
                } else if bk == BK_RAW {
                    // RULE: R1, D2.2 (`&raw const`: a read; `&raw mut`: a write;
                    // no loan either way)
                    access(true, A_RC, -1, l, p, 0, loc, bck, pbody, pcx);
                } else if bk == BK_RAW_MUT {
                    access(true, A_WB, -1, l, p, 0, loc, bck, pbody, pcx);
                }
            } else if (rv == RV_USE || rv == RV_CAST) && st.nops > 0
                && raw_mut_write(st.a, st.b, st.ops, st.node, pbody, pcx) {
                // RULE: D3.6 (0.27.7: a `&mut [T]` made a written `*mut [T]`,
                // `r as *mut T` of a `&mut T` r, is `&raw mut`: a deep write
                // of what it points to, no loan)
                access(true, A_WB, -1, op_a(st.ops, 0, pbody), op_b(st.ops, 0, pbody), 0, loc,
                    bck, pbody, pcx);
            } else if rv == RV_LEN || rv == RV_DISCR {
                access(false, A_RC, -1, op_a(st.ops, 0, pbody), op_b(st.ops, 0, pbody), 0, loc,
                    bck, pbody, pcx);
            }
        }
        if k != SK_ASSERT && k != TK_SWITCH && st.a >= 0 {
            shared_write(loc, st.a, st.b, bck, pbody, pcx);
            access(false, A_WA, -1, st.a, st.b, 0, loc, bck, pbody, pcx);
        }
    } else if k == SK_DROP {
        if st.c != DS_REMOVED {
            access(true, A_WD, -1, st.a, st.b, 0, loc, bck, pbody, pcx);
        }
    } else if k == SK_DEAD {
        access(false, A_WD, -1, st.a, 0, 0, loc, bck, pbody, pcx);
    } else if k == SK_MENTION {
        access(true, A_RC, -1, st.a, st.b, 0, loc, bck, pbody, pcx);
    } else if k == TK_RETURN {
        // (the implicit exit accesses: the parameters have no StorageDead)
        for l in 1..bck.nlocal {
            if has_flag(l, LF_PARAM, pbody) {
                access(false, A_WD, -1, l, 0, 0, loc, bck, pbody, pcx);
            }
        }
        access(true, A_RC, -1, 0, 0, 0, loc, bck, pbody, pcx);
    }
}

// One access (deep or shallow, of kind `kind`, of place (l, p) or of
// `*(l, p)` when deref) at location loc against every loan in scope;
// target is the loan an activation is of (-1 otherwise).
// RULE: D2.5
fn access(deep: bool, kind: i64, target: i64, l: i64, p: i64, deref: i64, loc: i64,
    bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // (the loans in scope, in order: the current set's bits, as
    // cur_drop_outside; nothing here changes the set)
    for w in 0..bck.nw_n {
        let mut x = bck.cur[w as usize] as u64;
        while x != 0 {
            let j = w * 64 + trailing_zeros(x);
            x = x & x.wrapping_sub(1u64);
            if j == target {
                continue;
            }
            let lk = loan_kind(j, bck);
            let r = rel(loan_local(j, bck), loan_proj(j, bck), loan_deref(j, bck), l, p, deref,
                false, bck, pbody, pcx);
            if r == R_DISJOINT {
                continue;
            }
            let mut overlap = false;
            if r == R_EXTENDS {
                // (the first projection of the loan's place beyond the access's)
                let e_deref = bck.w_first != 0;
                let mode = bck.w_type;
                if !deep && bck.w_count != 0 {
                    // RULE: D2.5 (2) (a shallow access: P is behind a deref
                    // past Q's fields)
                    overlap = false;
                } else if !e_deref {
                    overlap = true;
                } else if !deep || mode == MODE_SHARED {
                    overlap = false;
                } else {
                    overlap = true;
                }
            } else {
                overlap = true;
            }
            if lk == BK_FAKE {
                // RULE: D2.5 step 4, R10 (shallow: the place or a prefix, by a write)
                let write = kind == A_WA || kind == A_WB || kind == A_WD;
                overlap = write && (r == R_EQUAL || r == R_EXTENDS && bck.w_first == 0);
            }
            if !overlap {
                continue;
            }
            // The table (step 5): class S or M at this point.
            let mutable = lk == BK_MUT
                || lk == BK_MUT2 && bck.act[j as usize] >= 0 && loc > bck.act[j as usize];
            let conflict = if kind == A_RC || kind == A_RB || kind == A_RESERVE { mutable }
                else { true };
            if !conflict {
                continue;
            }
            // The code (step 6), by the loan's kind.
            let mut_kind = lk == BK_MUT || lk == BK_MUT2;
            let mut code = C_CONFLICT;
            if lk == BK_FAKE {
                code = C_GUARD_WRITE;
            } else if kind == A_RC {
                code = C_USE_BORROWED;
            } else if kind == A_RB {
                code = C_CONFLICT;
            } else if kind == A_RESERVE || kind == A_ACTIVATE || kind == A_WB {
                code = if mut_kind { C_MUT_TWICE } else { C_CONFLICT };
            } else if kind == A_WA {
                code = C_ASSIGN_BORROWED;
            } else if kind == A_WM {
                code = C_MOVE_BORROWED;
            } else if kind == A_WD {
                // RULE: D6.2.2
                code = if escapes(j, bck, pbody, pcx) { C_RETURN_LOCAL }
                    else { C_DROPPED_BORROWED };
            }
            if code == C_MOVE_BORROWED {
                bck.bad_moves.push(loc);
            }
            report(code, kind, loc, j, l, p, deref, bck, pbody, pcx);
        }
    }
}

// RULE: D2.6, L6 (a write through a shared reference: a guard's `ref mut`
// binding, which the guard sees as `&T`; elsewhere the front rejects it)
fn shared_write(loc: i64, l: i64, p: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    if p == 0 {
        return;
    }
    crate::places::borrowck::constraints::walk_place(l, p, bck, pbody, pcx);
    if bck.steps.len() < 2 {
        return;
    }
    // (the guard's binding keeps its `&mut` type but is initialized by a
    // shared borrow: a holder of shared references only)
    // (in a guard: a fake loan of the match is in scope; the wrapper's `&T`
    // view of a `&mut` parameter in an `ensures` is the front's own.readonly)
    if (bck.steps[1] == MODE_SHARED || shared_holder(l, pbody)) && fake_in_scope(bck) {
        crate::places::borrowck::diag::report_shared_write(loc, l, p, bck, pbody, pcx);
    }
}

// Whether a fake loan (D2.6) is in scope: inside a guarded match.
fn fake_in_scope(bck: &Bck<Comp>) -> bool {
    for j in 0..loan_count(bck) {
        if loan_kind(j, bck) == BK_FAKE && in_cur(j, bck) {
            return true;
        }
    }
    false
}

// Whether every initialization of local l is a shared borrow (and there
// is one).
fn shared_holder(l: i64, pbody: &Body<Comp>) -> bool {
    let mut any = false;
    for s in 0..pbody.stmts.len() as i64 {
        let st = pbody.stmts[s as usize];
        if (st.kind == SK_ASSIGN || st.kind == SK_CALL || st.kind == SK_INTRINSIC) && st.a == l
            && st.b == 0 {
            if st.kind != SK_ASSIGN || st.c != RV_REF || st.d != BK_SHARED {
                return false;
            }
            any = true;
        }
    }
    any
}

// Whether D6.2.2 applies to loan j: its place is frame-owned (D1.6) and
// its region's value holds an `end`.
fn escapes(j: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let l = loan_local(j, bck);
    if has_flag(l, LF_STATIC, pbody) || loan_deref(j, bck) != 0 {
        return false;
    }
    // (any deref-like projection: the place is reached through a pointer)
    let mut t = local_ty(l, pbody);
    let mut q = loan_proj(j, bck);
    let mut n: i64 = 0;
    while q > 0 {
        n += 1;
        q = proj_parent(q, pbody);
    }
    q = loan_proj(j, bck);
    // (the list leaf-first is enough: a deref-like step anywhere)
    while q > 0 {
        let k = proj_kind(q, pbody);
        if k == PJ_DEREF {
            return false;
        }
        q = proj_parent(q, pbody);
    }
    // (an index on a view: walked root-first with the types)
    if n > 0 && view_indexed(l, loan_proj(j, bck), bck, pbody, pcx) {
        return false;
    }
    let _ = t;
    // (a body whose result holds no reference returns none: a loan that
    // must outlive a universal there is rustc's E0597, not E0515 — a
    // closure's requirement of 'static, D19.10, an `&mut &'a T` parameter)
    if pbody.ret_var.len() == 0 {
        return false;
    }
    let r = loan_region(j, bck);
    for u in 0..bck.nuniv {
        if bit_on(&bck.val, r * bck.nw_p, bck.npts + u) {
            return true;
        }
    }
    false
}

// Whether place (l, p) has an index step on a view (D1.4).
fn view_indexed(l: i64, p: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    list_into(p, true, bck, pbody);
    let mut t = local_ty(l, pbody);
    for i in 0..bck.pa.len() as i64 {
        let q = bck.pa[i as usize];
        let k = proj_kind(q, pbody);
        let tu = undistinct(t, pcx);
        if (k == PJ_INDEX || k == PJ_CONST) && tu > 0
            && pcx.types[tu as usize].kind == TyKind::Slice {
            return true;
        }
        t = step_type(t, k, proj_val(q, pbody), pcx);
    }
    false
}

// The projection list p root-first into pa (first) or pb.
fn list_into(p: i64, first: bool, bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    if first {
        bck.pa.clear();
    } else {
        bck.pb.clear();
    }
    let mut q = p;
    let mut n: i64 = 0;
    while q > 0 {
        if first {
            bck.pa.push(q);
        } else {
            bck.pb.push(q);
        }
        n += 1;
        q = proj_parent(q, pbody);
    }
    for i in 0..n / 2 {
        if first {
            let a = bck.pa[i as usize];
            bck.pa[i as usize] = bck.pa[(n - 1 - i) as usize];
            bck.pa[(n - 1 - i) as usize] = a;
        } else {
            let a = bck.pb[i as usize];
            bck.pb[i as usize] = bck.pb[(n - 1 - i) as usize];
            bck.pb[(n - 1 - i) as usize] = a;
        }
    }
}

// Whether step (kind on a place of type t) is deref-like (D1.2), and its
// mode in w_type when it is.
fn deref_like(k: i64, t: i64, bck: &mut Bck<Comp>, pcx: &Ctx<Comp>) -> bool {
    if k == PJ_DEREF {
        bck.w_type = mode_of(t, pcx);
        return true;
    }
    if k == PJ_INDEX || k == PJ_CONST {
        // (an index on a view, D1.4, or on a raw pointer, D3.8)
        let tu = undistinct(t, pcx);
        if tu > 0
            && (pcx.types[tu as usize].kind == TyKind::Slice
                || pcx.types[tu as usize].kind == TyKind::Ptr) {
            bck.w_type = mode_of(t, pcx);
            return true;
        }
    }
    false
}

// RULE: D1.5
// rel(P, Q) for P = (la, pa [, *]) and Q = (lb, pb [, *]): R_DISJOINT,
// R_EQUAL, R_PREFIX_OF (P a strict prefix of Q) or R_EXTENDS (Q a strict
// prefix of P). With definite, an index step against anything is
// disjoint (rel_def). On R_EXTENDS, w_first says whether P's first
// projection beyond Q is deref-like (1) and w_type its mode; on
// R_PREFIX_OF, w_count says whether Q's projections beyond P pass a
// deref-like step (1).
fn rel(la: i64, pa: i64, da: i64, lb: i64, pb: i64, db: i64, definite: bool, bck: &mut Bck<Comp>,
    pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    bck.w_first = 0;
    bck.w_count = 0;
    bck.w_type = MODE_RAW;
    if la != lb {
        return R_DISJOINT;
    }
    list_into(pa, true, bck, pbody);
    list_into(pb, false, bck, pbody);
    // (a virtual deref at the end: id 0)
    if da != 0 {
        bck.pa.push(0);
    }
    if db != 0 {
        bck.pb.push(0);
    }
    let na = bck.pa.len() as i64;
    let nb = bck.pb.len() as i64;
    let mut t = local_ty(la, pbody);
    let mut i: i64 = 0;
    while i < na && i < nb {
        let qa = bck.pa[i as usize];
        let qb = bck.pb[i as usize];
        let ka = if qa == 0 { PJ_DEREF } else { proj_kind(qa, pbody) };
        let kb = if qb == 0 { PJ_DEREF } else { proj_kind(qb, pbody) };
        let va: i64 = if qa == 0 { 0 } else { proj_val(qa, pbody) };
        let vb: i64 = if qb == 0 { 0 } else { proj_val(qb, pbody) };
        if ka == PJ_FIELD || ka == PJ_CONST || ka == PJ_VARIANT {
            if kb == ka && va != vb {
                return R_DISJOINT;
            }
            if kb == PJ_INDEX && definite {
                return R_DISJOINT;
            }
        } else if ka == PJ_INDEX {
            if definite {
                return R_DISJOINT;
            }
            // RULE: R7 (two indexes by locals that hold distinct constants,
            // a constant index into a view: disjoint)
            if kb == PJ_INDEX && va != vb {
                let ca = bck.cidx[va as usize];
                let cb = bck.cidx[vb as usize];
                if ca >= 0 && cb >= 0 && ca != cb {
                    return R_DISJOINT;
                }
            }
        } else if ka == PJ_UNION || ka == PJ_DEREF {
            // (a union's fields overlap; a deref against a deref continues)
        }
        t = step_type(t, ka, va, pcx);
        i += 1;
    }
    if na == nb {
        return R_EQUAL;
    }
    if na < nb {
        // (P a prefix of Q: do Q's remaining steps pass a deref-like one?)
        let mut j = na;
        while j < nb {
            let qb = bck.pb[j as usize];
            let kb = if qb == 0 { PJ_DEREF } else { proj_kind(qb, pbody) };
            if deref_like(kb, t, bck, pcx) {
                bck.w_count = 1;
            }
            t = step_type(t, kb, if qb == 0 { 0 } else { proj_val(qb, pbody) }, pcx);
            j += 1;
        }
        return R_PREFIX_OF;
    }
    let qa = bck.pa[nb as usize];
    let ka = if qa == 0 { PJ_DEREF } else { proj_kind(qa, pbody) };
    if deref_like(ka, t, bck, pcx) {
        bck.w_first = 1;
    }
    // RULE: D2.5 (2) (w_count: do P's remaining steps pass a deref-like
    // one? A shallow access of Q does not reach what is behind it, rustc's
    // Shallow(None))
    let mut j = nb;
    let mut tj = t;
    while j < na {
        let q = bck.pa[j as usize];
        let k = if q == 0 { PJ_DEREF } else { proj_kind(q, pbody) };
        if deref_like(k, tj, bck, pcx) {
            bck.w_count = 1;
        }
        tj = step_type(tj, k, if q == 0 { 0 } else { proj_val(q, pbody) }, pcx);
        j += 1;
    }
    let _ = MODE_MUT;
    R_EXTENDS
}
