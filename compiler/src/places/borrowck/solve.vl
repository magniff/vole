// (0.27.1) The solve (docs/design/borrowck.md D6.1): the least assignment
// of point sets to the regions with the liveness facts (a local's slot
// region holds every point its local is use-live at, and drop-live at
// when a drop needs it: D3.7, D9.2), the universals fixed (every point
// and their own `end` bit: D4.5), and the outlives constraints
// propagated along `'sub -> 'sup` edges to a fixpoint, by a worklist
// over bitsets. Nothing is propagated into a universal (its constraints
// are checked, D6.2.1: M2).

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::own::glue::has_glue;
use crate::front::types::{TyKind, type_elem};
use crate::places::borrowck::{Bck, LOAN_WORDS, bit_on};
use crate::places::borrowck::constraints::slots_of;
use crate::places::ir::{Body, LF_STATIC, has_flag, local_ty, undistinct};
use crate::places::regions::{RO_LOAN, RO_LOCAL, RO_UNIVERSAL};

// RULE: D6.1
pub fn solve(bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    let nbits = bck.npts + bck.nuniv;
    bck.nw_p = (nbits + 63) / 64;
    if bck.nw_p < 1 {
        bck.nw_p = 1;
    }
    let nw = bck.nw_p;
    bck.val.clear();
    for _ in 0..(bck.nreg + 1) * nw {
        bck.val.push(0);
    }
    dropck_slots(&bck, pbody, &pcx);
    // (Liveness) and (Universal)
    for r in 1..bck.nreg + 1 {
        let o = bck.origin[r - 1];
        if o == RO_UNIVERSAL {
            for p in 0..bck.npts {
                set_bit(r, p, &bck);
            }
            set_bit(r, bck.npts + bck.univ[r - 1], &bck);
        } else if o == RO_LOAN && static_loan(r, bck, pbody) {
            // RULE: D6.2.5 (a loan of a static: every point and every end)
            for p in 0..bck.npts + bck.nuniv {
                set_bit(r, p, &bck);
            }
        } else if o == RO_LOCAL {
            let l = bck.of[r - 1];
            let needed = bck.dropck[r - 1] != 0;
            for p in 0..bck.npts {
                if bit_on(bck.live, p * bck.nw_l, l)
                    || needed && bit_on(bck.dlive, p * bck.nw_l, l) {
                    set_bit(r, p, &bck);
                }
            }
        }
    }
    // (Outlives): the adjacency sub -> sups, then the worklist
    adjacency(&bck);
    bck.queue.clear();
    bck.inq.clear();
    for _ in 0..bck.nreg + 1 {
        bck.queue.push(0);
        bck.inq.push(0);
    }
    var head = 0;
    var tail = 0;
    let cap = bck.nreg + 1;
    for r in 1..bck.nreg + 1 {
        bck.queue[tail] = r;
        tail = (tail + 1) % cap;
        bck.inq[r] = 1;
    }
    while head != tail {
        let r = bck.queue[head];
        head = (head + 1) % cap;
        bck.inq[r] = 0;
        for i in bck.adj_at[r]..bck.adj_at[r + 1] {
            let sup = bck.adj[i];
            if bck.origin[sup - 1] == RO_UNIVERSAL {
                continue;
            }
            var grew = false;
            for w in 0..nw {
                let nv = bck.val[sup * nw + w] | bck.val[r * nw + w];
                if nv != bck.val[sup * nw + w] {
                    bck.val[sup * nw + w] = nv;
                    grew = true;
                }
            }
            if grew && bck.inq[sup] == 0 {
                bck.queue[tail] = sup;
                tail = (tail + 1) % cap;
                bck.inq[sup] = 1;
            }
        }
    }
}

// Whether region r is the loan of a static's place (an LF_STATIC root).
fn static_loan(r: i64, bck: Bck<Comp>, pbody: Body<Comp>) -> bool {
    for j in 0..bck.loans.len() as i64 / LOAN_WORDS {
        if bck.loans[LOAN_WORDS * j + 1] == r {
            return has_flag(bck.loans[LOAN_WORDS * j + 3], LF_STATIC, pbody);
        }
    }
    false
}

fn set_bit(r: i64, bit: i64, bck: inout Bck<Comp>) {
    let w = r * bck.nw_p + (bit >> 6);
    bck.val[w] = bck.val[w] | (1 << (bit & 63));
}

// The edges as adjacency lists: adj[adj_at[sub] .. adj_at[sub + 1]] the
// sups of sub.
fn adjacency(bck: inout Bck<Comp>) {
    let n = bck.nreg + 2;
    bck.adj_at.clear();
    for _ in 0..n + 1 {
        bck.adj_at.push(0);
    }
    let ne = bck.edges.len() as i64 / 3;
    for e in 0..ne {
        let sub = bck.edges[3 * e + 1];
        bck.adj_at[sub + 1] += 1;
    }
    for i in 0..n {
        bck.adj_at[i + 1] += bck.adj_at[i];
    }
    bck.adj.clear();
    for _ in 0..ne {
        bck.adj.push(0);
    }
    // (the counts become the next free slot of each list, then are
    // restored by shifting)
    bck.tmp.clear();
    for i in 0..n + 1 {
        bck.tmp.push(bck.adj_at[i]);
    }
    for e in 0..ne {
        let sub = bck.edges[3 * e + 1];
        bck.adj[bck.tmp[sub]] = bck.edges[3 * e];
        bck.tmp[sub] += 1;
    }
}

// Per region, whether a drop of its local requires it live (D9.1): a
// reference, a view, a raw pointer and a scalar have no glue; an array's
// and a tuple's elements each by this rule; a struct or enum with glue
// every slot of its (none in the v0.27.0 layout; the container table is
// M3's).
// RULE: D9.1
fn dropck_slots(bck: inout Bck<Comp>, pbody: Body<Comp>, pcx: inout Ctx<Comp>) {
    bck.dropck.clear();
    for _ in 0..bck.nreg {
        bck.dropck.push(0);
    }
    for l in 0..bck.nlocal {
        if bck.nslots[l] == 0 {
            continue;
        }
        let t = local_ty(l, pbody);
        if has_glue(t, &pcx) {
            mark_dropck(t, bck.first[l], &bck, pcx);
        }
    }
}

fn mark_dropck(t0: i64, base: i64, bck: inout Bck<Comp>, pcx: Ctx<Comp>) {
    let t = undistinct(t0, pcx);
    if t <= 0 {
        return;
    }
    let k = pcx.types[t].kind;
    if k == TyKind::Ptr || k == TyKind::Slice {
        return;
    }
    if k == TyKind::Array {
        mark_dropck(pcx.types[t].a, base, &bck, pcx);
        return;
    }
    if k == TyKind::Tuple {
        var off = 0;
        for i in 0..pcx.types[t].count {
            let e = type_elem(t, i, pcx);
            mark_dropck(e, base + off, &bck, pcx);
            off += slots_of(e, pcx);
        }
        return;
    }
    // (a struct, an enum, a closure with glue: every slot of its)
    for i in 0..slots_of(t, pcx) {
        bck.dropck[base + i - 1] = 1;
    }
}
