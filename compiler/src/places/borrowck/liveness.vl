// (0.27.1) Liveness on the places IR (docs/design/borrowck.md D3.7): per
// location the locals a statement uses, defines (writes whole, or ends
// the storage of) and drop-uses (a `drop(L.π)` with no deref-like step,
// decision not removed); a backward dataflow over the blocks in reverse
// RPO, then per point: a local is use-live at the start point of a
// location when it is in live_in, at the mid point when in live_out; the
// same flow with the drop-uses gives drop-liveness.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::places::borrowck::{Bck, zero_fill};
use crate::places::borrowck::constraints::deref_like_in;
use crate::places::ir::{
    Body, DS_REMOVED, SK_ASSERT, SK_ASSIGN, SK_CALL, SK_DEAD, SK_DROP, SK_INTRINSIC, SK_MENTION,
    TK_RETURN, TK_SWITCH, block_count, block_len, block_start, block_term, op_a, op_is_place,
    op_kind, succ, succ_count,
};

// RULE: D3.7
pub fn compute(bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let nw = bck.nw_l;
    zero_fill(&mut bck.uses, bck.nloc * nw);
    zero_fill(&mut bck.defs, bck.nloc * nw);
    zero_fill(&mut bck.drops, bck.nloc * nw);
    for loc in 0..bck.nloc {
        location_sets(loc, bck, pbody, pcx);
    }
    zero_fill(&mut bck.live, bck.npts * nw);
    bck.dlive.clear();
    flow(false, bck, pbody);
    // (the drop-liveness: drop_liveness, when solve finds a region that
    // needs it)
}

// The drop-live locals of each point (bck.dlive, D3.7's drop-uses), for
// solve: only a body with a region whose local's drop needs it (D9.1)
// reads them, or the regions' dump.
pub fn drop_liveness(bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    zero_fill(&mut bck.dlive, bck.npts * bck.nw_l);
    flow(true, bck, pbody);
}

fn mark(set: i64, l: i64, bck: &mut Bck<Comp>, which: i64) {
    let w = set * bck.nw_l + (l >> 6);
    let bit = 1 << (l & 63);
    if which == 0 {
        bck.uses[w as usize] = bck.uses[w as usize] | bit;
    } else if which == 1 {
        bck.defs[w as usize] = bck.defs[w as usize] | bit;
    } else {
        bck.drops[w as usize] = bck.drops[w as usize] | bit;
    }
}

// The use, def and drop-use sets of the statement at loc (D3.7).
fn location_sets(loc: i64, bck: &mut Bck<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let st = pbody.stmts[loc as usize];
    let k = st.kind;
    if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_ASSERT || k == TK_SWITCH {
        // (every place operand: a copy, a move, a borrowed, measured or
        // discriminated place reads its root)
        for i in 0..st.nops {
            if op_is_place(op_kind(st.ops, i, pbody)) {
                mark(loc, op_a(st.ops, i, pbody), bck, 0);
            }
        }
        if k != SK_ASSERT && k != TK_SWITCH && st.a >= 0 {
            // (the destination: a whole local is defined, a projected one
            // reads its root)
            if st.b != 0 {
                mark(loc, st.a, bck, 0);
            } else {
                mark(loc, st.a, bck, 1);
            }
        }
    } else if k == SK_DROP {
        if st.c != DS_REMOVED {
            if deref_like_in(st.a, st.b, bck, pbody, pcx) {
                // (a drop through a reference reads the reference)
                mark(loc, st.a, bck, 0);
            } else {
                mark(loc, st.a, bck, 2);
            }
        }
    } else if k == SK_DEAD {
        mark(loc, st.a, bck, 1);
    } else if k == SK_MENTION {
        mark(loc, st.a, bck, 0);
    } else if k == TK_RETURN {
        mark(loc, 0, bck, 0);
    }
}

// The backward dataflow over the blocks (drop-uses in place of the uses
// when drop_flow), then the per-point sets.
fn flow(drop_flow: bool, bck: &mut Bck<Comp>, pbody: &Body<Comp>) {
    let nw = bck.nw_l;
    let nb = block_count(pbody);
    zero_fill(&mut bck.bin, nb * nw);
    zero_fill(&mut bck.bout, nb * nw);
    bck.tmp.clear();
    for _ in 0..nw {
        bck.tmp.push(0);
    }
    let mut changed = true;
    while changed {
        changed = false;
        let mut i = pbody.rpo.len() as i64 - 1;
        while i >= 0 {
            let b = pbody.rpo[i as usize];
            i -= 1;
            // out(b) = the union of the successors' in
            for w in 0..nw {
                bck.tmp[w as usize] = 0;
            }
            for j in 0..succ_count(b, pbody) {
                let s = succ(b, j, pbody);
                if pbody.rpo_index[s as usize] >= 0 {
                    for w in 0..nw {
                        bck.tmp[w as usize] = bck.tmp[w as usize] | bck.bin[(s * nw + w) as usize];
                    }
                }
            }
            for w in 0..nw {
                bck.bout[(b * nw + w) as usize] = bck.tmp[w as usize];
            }
            // in(b): the transfer backwards through the block
            let start = block_start(b, pbody);
            let mut loc = block_term(b, pbody);
            while loc >= start {
                transfer(loc, drop_flow, bck);
                loc -= 1;
            }
            for w in 0..nw {
                if bck.bin[(b * nw + w) as usize] != bck.tmp[w as usize] {
                    bck.bin[(b * nw + w) as usize] = bck.tmp[w as usize];
                    changed = true;
                }
            }
        }
    }
    // The per-point sets: a block walked backwards from its out.
    for b in 0..nb {
        let start = block_start(b, pbody);
        if start < 0 || pbody.rpo_index[b as usize] < 0 {
            continue;
        }
        for w in 0..nw {
            bck.tmp[w as usize] = bck.bout[(b * nw + w) as usize];
        }
        let mut loc = block_term(b, pbody);
        while loc >= start {
            for w in 0..nw {
                if drop_flow {
                    bck.dlive[((2 * loc + 1) * nw + w) as usize] = bck.tmp[w as usize];
                } else {
                    bck.live[((2 * loc + 1) * nw + w) as usize] = bck.tmp[w as usize];
                }
            }
            transfer(loc, drop_flow, bck);
            for w in 0..nw {
                if drop_flow {
                    bck.dlive[((2 * loc) * nw + w) as usize] = bck.tmp[w as usize];
                } else {
                    bck.live[((2 * loc) * nw + w) as usize] = bck.tmp[w as usize];
                }
            }
            loc -= 1;
        }
    }
    let _ = block_len(0, pbody);
}

// tmp := use(loc) | (tmp \ def(loc)).
fn transfer(loc: i64, drop_flow: bool, bck: &mut Bck<Comp>) {
    let nw = bck.nw_l;
    for w in 0..nw {
        let u = if drop_flow { bck.drops[(loc * nw + w) as usize] } else { bck.uses[(loc * nw + w) as usize] };
        bck.tmp[w as usize] = u | (bck.tmp[w as usize] & ~bck.defs[(loc * nw + w) as usize]);
    }
}
