// (0.27.2, borrowck.md Z7) The verdict cache: a std body's clean verdict,
// kept on disk in the tools' cache directory (tools/query/cache.vl's:
// target/volec-cache, $VOLE_CACHE, `off`), so that a program's run does
// not solve again the std bodies an earlier run found clean. A body's key
// is D4.4(b)'s, (the template, per type argument its slots' count and
// whether it has drop glue), with the template named by its position in
// std's text; the file is named by the compiler and std's text, so a
// key is never read by another compiler or against another std. Only a
// clean verdict is kept: a body with errors is solved again, and its
// messages made as without the cache. Not with the places IR's options
// or `--std2-check` (they print or count what the solve does).

use crate::base::{buf_bytes, buf_new, buf_ptr, buf_slice, buf_str, get_src};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::places::borrowck::Bck;
use crate::places::front::{fn_node, fn_template, tlist_at};

// The cache file's words: MAGIC, then the keys, sorted.
const MAGIC: i64 = 6729085362541905409;

fn mix(h: u64, x: u64) -> u64 {
    let v = (h ^ x).wrapping_mul(11400714819323198485u64);
    v ^ (v >> 29)
}

// Whether function f's body is std's (the file std's text is in).
pub fn std_body(f: i64, pcx: &Ctx<Comp>) -> bool {
    let node = fn_node(fn_template(f, pcx), pcx);
    pcx.std_file >= 0 && node > 0
        && crate::front::modules::file_of_pos(pcx.nodes[node as usize].start, pcx) == pcx.std_file
}

// Reads the cache once, at the first std body: bck.vc_state 1 when it is
// on (its keys in bck.vc_keys), -1 when it is off.
fn load(bck: &mut Bck<Comp>, pcx: &mut Ctx<Comp>) {
    bck.vc_state = -1;
    if !crate::tools::query::cache::cache_on(pcx)
        || crate::places::borrowck::std2::std2_check(pcx) || pcx.std_file < 0 {
        return;
    }
    let dir = crate::tools::query::cache::cache_dir(pcx);
    let id = crate::tools::query::cache::ident(pcx);
    let file = pcx.files[pcx.std_file as usize];
    let mut h: u64 = mix(0, id as u64);
    for i in file.start..file.end {
        h = mix(h, get_src()[i as usize] as u64);
    }
    let path = buf_new();
    buf_str(path, dir);
    buf_str(path, c"/bck-");
    crate::base::buf_int(path, (h >> 1) as i64);
    buf_str(path, c".bin");
    bck.vc_path = path;
    bck.vc_state = 1;
    let b = buf_new();
    let pz = c_path(path, c"");
    if !(crate::tools::proc::read_file_if(buf_ptr(pz), b)) {
        return;
    }
    let bytes = buf_slice(b);
    let n = bytes.len() as i64 / 8;
    if n < 1 || word(bytes, 0) != MAGIC {
        return;
    }
    for i in 1..n {
        bck.vc_keys.push(word(bytes, i));
    }
}

// Word i of bytes, little-endian.
fn word(bytes: &[u8], i: i64) -> i64 {
    let mut w: u64 = 0;
    for j in 0..8 {
        w = w | (bytes[(8 * i + j) as usize] as u64) << (8 * j) as u64;
    }
    w as i64
}

// The key of std body f (D4.4(b)'s, the template by its position), or
// -1 when f is not std's or the cache is off.
pub fn body_key(f: i64, bck: &mut Bck<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if !std_body(f, pcx) {
        return -1;
    }
    if bck.vc_state == 0 {
        load(bck, pcx);
    }
    if bck.vc_state < 0 {
        return -1;
    }
    let tf = fn_template(f, pcx);
    let mut h: u64 = mix(1,
        (pcx.nodes[fn_node(tf, pcx) as usize].start - pcx.files[pcx.std_file as usize].start) as u64);
    let n: i64 = if tf != f { pcx.fns[f as usize].targ_count } else { 0 };
    h = mix(h, n as u64);
    for i in 0..n {
        let t = tlist_at(pcx.fns[f as usize].targs + i, pcx);
        h = mix(h, crate::places::regions::slot_count(t, pcx) as u64);
        h = mix(h, if crate::places::glue::has_glue(t, pcx) { 1 } else { 0 });
    }
    (h >> 1) as i64
}

// Whether key k's verdict is kept clean.
pub fn clean(k: i64, bck: &Bck<Comp>) -> bool {
    let mut lo: i64 = 0;
    let mut hi = bck.vc_keys.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if bck.vc_keys[mid as usize] < k {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo < bck.vc_keys.len() as i64 && bck.vc_keys[lo as usize] == k
}

// Writes the keys with the run's new clean ones, when there are any (a
// new file renamed over the old).
pub fn save(bck: &mut Bck<Comp>, pcx: &mut Ctx<Comp>) {
    if bck.vc_state < 0 || bck.vc_new.len() == 0 {
        return;
    }
    for i in 0..bck.vc_new.len() as i64 {
        bck.vc_keys.push(bck.vc_new[i as usize]);
    }
    bck.vc_keys.as_mut_slice().sort_unstable();
    let out = buf_new();
    put(out, MAGIC);
    let mut last: i64 = 0;
    for i in 0..bck.vc_keys.len() as i64 {
        if i == 0 || bck.vc_keys[i as usize] != last {
            put(out, bck.vc_keys[i as usize]);
        }
        last = bck.vc_keys[i as usize];
    }
    let dir = crate::tools::query::cache::cache_dir(pcx);
    let _ = crate::tools::proc::make_dirs(dir);
    let tmp = c_path(bck.vc_path, c".tmp");
    let to = c_path(bck.vc_path, c"");
    if crate::tools::proc::write_file_if(buf_ptr(tmp), buf_slice(out)) {
        let _ = crate::tools::proc::rename_file(buf_ptr(tmp),
            buf_ptr(to));
    }
}

// A new buffer holding path buffer p, then suffix, then a NUL.
fn c_path(p: i64, suffix: *mut u8) -> i64 {
    let b = buf_new();
    buf_bytes(b, buf_slice(p));
    buf_str(b, suffix);
    crate::base::buf_byte(b, 0);
    b
}

fn put(b: i64, v: i64) {
    for j in 0..8 {
        crate::base::buf_byte(b, ((v as u64 >> (8 * j) as u64) & 255) as u8);
    }
}
