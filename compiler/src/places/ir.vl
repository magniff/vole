// The places IR (0.26.0, docs/design/places-ir.md §3): one Body per
// checked function, a MIR-like form of it: typed locals, places with
// interned projections, operands and rvalues, statements and terminators
// in one array, blocks as ranges of it. This file is the contract: the
// builder (build.vl), elaboration (elab.vl), the printer (print.vl), the
// verifier (verify.vl) and, from 0.26.1, both code generators read the IR
// through the names here, and nothing else. A change to it gets a line in
// places/README.md's change log.
//
// One body is held at a time, in the P_* tables below, cleared and reused
// for the next (no allocation per body once they have grown).
//
// Locals (§3.1): _0 the return place, _1.._n the parameters in order,
// then the user locals, the temporaries and (made by elaboration) the drop
// flags. A static the body names is a local too, flagged LF_STATIC: a
// place root that is never dropped and never moved out of.
//
// Places (§3.2): a local and a projection list (0: none). A projection
// list is interned per body as a chain (parent, kind, value), so a place
// is two words and equal places are equal pairs.
//
//   PJ_FIELD k    field k of a struct, element k of a tuple, part k of a
//                 slice (0 its pointer, 1 its length)
//   PJ_DEREF      through a reference or a raw pointer
//   PJ_INDEX l    an element of an array or a slice, or of the buffer a
//                 raw pointer points to, indexed by local l (after its
//                 bounds check, an `assert`, for an array or a slice)
//   PJ_CONST k    the same with a constant index
//   PJ_VARIANT v  the payload of enum variant v (VARIANTS), then PJ_FIELD
//                 k for its field k; valid only where a `switch` on the
//                 place's discriminant dominates it (the verifier checks)
//   PJ_UNION k    field k of a union: no drop, no move path
//
// Operands (§3.3), three words each in P_OPS (kind, a, b):
//
//   OK_COPY l p   a copy of place (l, p)
//   OK_MOVE l p   a move of place (l, p)
//   OK_PLACE l p  the place itself, not read (a borrow's, a
//                 discriminant's, a length's, a slicing's base)
//   OK_INT v t    an integer, bool or char constant of type t
//   OK_FLOAT b t  a float constant, its bits b, of type t
//   OK_STR s t    a string literal (string id s), `[u8]`
//   OK_CSTR s t   a C string literal, `*u8`
//   OK_FN f t     function f (FNS) as a value
//   OK_CONST c t  named constant c (CONSTS), of type t
//   OK_UNIT       `()`
//
// Statements (§3.4) and terminators (§3.5) are PStmt records; a block is
// a range of P_STMTS whose terminator is the slot after it. Their fields:
//
//   SK_ASSIGN     (a, b) = rvalue c: d, e its words, ops its operands
//   SK_CALL       (a, b) = call: c the function (FNS), or -1 when ops[0]
//                 is the callee value; ops the arguments after it
//   SK_INTRINSIC  (a, b) = intrinsic c (IK_*): d the AST node; ops
//   SK_DROP       drop (a, b): c its decision (DS_*), d its flag local (or
//                 -1), e what --places-diff compares it with (the AST
//                 local it drops, or -1)
//   SK_ASSERT     ops[0] must be true, else exit 101: c the check (AK_*),
//                 d the AST node (its site, its message)
//   SK_LIVE l     StorageLive(a), SK_DEAD: StorageDead(a)
//   SK_MENTION    a place read without a value (a, b)
//   SK_NOP        a removed statement
//   TK_GOTO       to block a; c = 1 on the back edge of an uncounted loop
//   TK_SWITCH     on ops[0]: P_TARGETS[a .. a + 2b] (value, block) pairs,
//                 otherwise block c
//   TK_RETURN     _0 is the result
//   TK_UNREACHABLE after a call that returns `!`, a panic, an exit
//
// Rvalues (§3.3), the c of an SK_ASSIGN:
//
//   RV_USE        ops[0]
//   RV_REF        &ops[0] (an OK_PLACE): d the kind (BK_*), e the region
//                 (0 until 0.27)
//   RV_BINARY     ops[0] OP ops[1]: d the operator (BO_*), e the AST node
//                 (0: one the builder made). (0.26.3) An integer `/` or
//                 `%` panics (exit 101, at e's position) when ops[1] is 0
//                 or, signed, when ops[0] is the type's MIN and ops[1] -1,
//                 at every level
//   RV_CHECKED    (0.26.3) an operation with Rust's overflow check, built
//                 when the checks are on (middle::opt::OVERFLOW_CHECKS): ops[0]
//                 OP ops[1], d BO_ADD, BO_SUB, BO_MUL (the result does not
//                 fit the type), BO_SHL or BO_SHR (the amount, as
//                 unsigned, not below the type's bits); or with one
//                 operand, -ops[0] (d UO_NEG: ops[0] is a signed MIN, or
//                 unsigned and not 0). e the AST node: the panic is Rust's
//                 message (`attempt to add with overflow`) at its position
//   RV_UNARY      OP ops[0]: d the operator (UO_*), e the AST node
//   RV_CAST       ops[0] as type d
//   RV_DISCR      the discriminant of place ops[0]
//   RV_AGG        aggregate d (AK_*): e the struct (STRUCTS), variant
//                 (VARIANTS) or closure type; ops its parts in declaration
//                 order
//   RV_REPEAT     [ops[0]; d]
//   RV_LEN        the length of place ops[0], an array or a slice
//   RV_SLICE      ops[0][ops[1]..ops[2]] (ops[0] an OK_PLACE of an array
//                 or slice, or of a pointer, read; an absent bound
//                 OK_UNIT), its bounds checked (exit 101): d the AST node
//                 (inclusive or not, the site), e the region
//
// An SK_ASSERT of AK_BOUNDS has two operands, the index and the length:
// it holds when the index, as unsigned, is below the length.
//
// Panics do not unwind (§3.10): calls and drops are statements, and
// there are no cleanup edges. Unwinding, when it comes, makes SK_CALL and
// SK_DROP terminators with a cleanup edge.

use std::mem; use std::alloc::Allocator; use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::REPR_UNION;
use crate::front::types::{
    TY_I64, TY_UNIT, TyKind, get_enums, struct_field, type_elem, variant_field,
};

// Projection kinds.
pub const PJ_FIELD: i64 = 1;
pub const PJ_DEREF: i64 = 2;
pub const PJ_INDEX: i64 = 3;
pub const PJ_CONST: i64 = 4;
pub const PJ_VARIANT: i64 = 5;
pub const PJ_UNION: i64 = 6;

// Local flags: MUT (a `var`: may be assigned again), BORROWED (a bit copy
// of a value owned elsewhere, §3.11: never dropped, never moved out of),
// TEMP (a temporary), PARAM (a parameter, _1.._n), RETURN (_0), FLAG (a
// drop flag), STATIC (a static's place root), USER (a local of the
// source). A local's src is its LOCALS index (a USER or PARAM local; a
// temporary the own pass made a local of, too), a STATIC's name (its
// symbol), else -1; node is the AST node it comes from (0: none).
pub const LF_MUT: i64 = 1;
pub const LF_BORROWED: i64 = 2;
pub const LF_TEMP: i64 = 4;
pub const LF_PARAM: i64 = 8;
pub const LF_RETURN: i64 = 16;
pub const LF_FLAG: i64 = 32;
pub const LF_STATIC: i64 = 64;
pub const LF_USER: i64 = 128;
// (0.26.1, set on a kept body only: keep.vl mark_ssa) SSA: a scalar
// temporary, never borrowed, written whole once and read whole once, by a
// later statement of the same block, and mentioned nowhere else.
pub const LF_SSA: i64 = 256;
// (0.28.0) PROMOTED: a promotable rvalue's temporary of the body's storage
// (build.vl shared_place, D2.8), for the borrow checker's messages.
pub const LF_PROMOTED: i64 = 512;
// (0.28.0) A `let` with no value, `let y: i64;`: assigned later
// (borrowck/moves.vl, unassigned_reads).
pub const LF_DEFERRED: i64 = 1024;

// Operand kinds.
pub const OK_COPY: i64 = 1;
pub const OK_MOVE: i64 = 2;
pub const OK_PLACE: i64 = 3;
pub const OK_INT: i64 = 4;
pub const OK_FLOAT: i64 = 5;
pub const OK_STR: i64 = 6;
pub const OK_CSTR: i64 = 7;
pub const OK_FN: i64 = 8;
pub const OK_CONST: i64 = 9;
pub const OK_UNIT: i64 = 10;

// Statement kinds, then terminator kinds (TK_FALSE_EDGE is 0.27's, for
// match guards: reserved).
pub const SK_ASSIGN: i64 = 1;
pub const SK_CALL: i64 = 2;
pub const SK_INTRINSIC: i64 = 3;
pub const SK_DROP: i64 = 4;
pub const SK_ASSERT: i64 = 5;
pub const SK_LIVE: i64 = 6;
pub const SK_DEAD: i64 = 7;
pub const SK_MENTION: i64 = 8;
pub const SK_NOP: i64 = 9;
pub const TK_GOTO: i64 = 16;
pub const TK_SWITCH: i64 = 17;
pub const TK_RETURN: i64 = 18;
pub const TK_UNREACHABLE: i64 = 19;
pub const TK_FALSE_EDGE: i64 = 20;

// Rvalue kinds.
pub const RV_USE: i64 = 1;
pub const RV_REF: i64 = 2;
pub const RV_BINARY: i64 = 3;
pub const RV_UNARY: i64 = 4;
pub const RV_CAST: i64 = 5;
pub const RV_DISCR: i64 = 6;
pub const RV_AGG: i64 = 7;
pub const RV_REPEAT: i64 = 8;
pub const RV_LEN: i64 = 9;
pub const RV_SLICE: i64 = 10;
pub const RV_CHECKED: i64 = 11;

// Binary operators (the operands' types say signed, unsigned or float;
// a comparison gives a bool) and unary ones.
pub const BO_ADD: i64 = 1;
pub const BO_SUB: i64 = 2;
pub const BO_MUL: i64 = 3;
pub const BO_DIV: i64 = 4;
pub const BO_REM: i64 = 5;
pub const BO_AND: i64 = 6;
pub const BO_OR: i64 = 7;
pub const BO_XOR: i64 = 8;
pub const BO_SHL: i64 = 9;
pub const BO_SHR: i64 = 10;
pub const BO_EQ: i64 = 11;
pub const BO_NE: i64 = 12;
pub const BO_LT: i64 = 13;
pub const BO_LE: i64 = 14;
pub const BO_GT: i64 = 15;
pub const BO_GE: i64 = 16;
pub const UO_NEG: i64 = 1;
pub const UO_NOT: i64 = 2;
pub const UO_BITNOT: i64 = 3;

// The text of binary operator op.
pub fn bo_text(op: i64) -> *mut u8 {
    match op {
        1 => c"+",
        2 => c"-",
        3 => c"*",
        4 => c"/",
        5 => c"%",
        6 => c"&",
        7 => c"|",
        8 => c"^",
        9 => c"<<",
        10 => c">>",
        11 => c"==",
        12 => c"!=",
        13 => c"<",
        14 => c"<=",
        15 => c">",
        16 => c">=",
        _ => c"?",
    }
}

pub fn uo_text(op: i64) -> *mut u8 {
    if op == UO_NEG { c"-" } else if op == UO_NOT { c"!" } else if op == UO_BITNOT { c"~" }
    else { c"?" }
}

// Borrow kinds: shared, exclusive, two-phase exclusive (a reservation,
// activated at its first use: a receiver), a raw address.
pub const BK_SHARED: i64 = 1;
pub const BK_MUT: i64 = 2;
pub const BK_MUT2: i64 = 3;
pub const BK_RAW: i64 = 4;
// (0.27.1, docs/design/borrowck.md D2.1, D2.6) a match's fake borrow of
// its scrutinee or a tested place: a shared loan that conflicts with
// writes only (the rust edition's, when an arm has a guard)
pub const BK_FAKE: i64 = 5;
// (0.27.1, D2.2) a raw address of a `*mut T` (`&mut x` where a raw
// pointer goes), BK_RAW being a `*const T`'s: no loan, a write access
// (the rust edition's; an MVS body's raw addresses are all BK_RAW)
pub const BK_RAW_MUT: i64 = 6;

// Aggregate kinds.
pub const AK_TUPLE: i64 = 1;
pub const AK_ARRAY: i64 = 2;
pub const AK_STRUCT: i64 = 3;
pub const AK_VARIANT: i64 = 4;
pub const AK_CLOSURE: i64 = 5;

// Intrinsics: a vector operation (the VecOp node), an atomic or
// std::arch intrinsic call (the Call node), `needs_drop::<T>()`, a
// contract check (std::contract_check's call), a panic of the checker's
// (an EnumPanic: d its node). (0.26.2) A contract check's is the
// failing path of one conjunct, which the IR branched on (build.vl
// lower_contract): d the call, e the conjunct (a node), ops[0] the
// condition's value (const false), ops[1] the site (i64), ops[2..] the
// values its report shows (integers, checks.vl check_values; the message
// is check_message's of the check and e), the block's terminator
// unreachable.
pub const IK_VECTOR: i64 = 1;
pub const IK_ARCH: i64 = 2;
pub const IK_NEEDS_DROP: i64 = 3;
pub const IK_CONTRACT: i64 = 4;
pub const IK_PANIC: i64 = 5;

// Run-time checks: an index against the length, a slicing's bounds, a
// value's variant (`as E`), a requires call's result.
pub const AK_BOUNDS: i64 = 1;
pub const AK_RANGE: i64 = 2;
pub const AK_ENUM: i64 = 3;
pub const AK_REQUIRES: i64 = 4;

// (0.27.1, reserved for 0.27.4's Level 1) A check's decision: the e of
// an SK_ASSERT, and of a contract conjunct's TK_SWITCH (whose d is
// AS_CONJUNCT): not decided (all of them until 0.27.4), kept, discharged
// (proven), refuted. Printed as the `; L1:` slot of the line.
pub const AS_UNDECIDED: i64 = 0;
pub const AS_KEPT: i64 = 1;
pub const AS_DISCHARGED: i64 = 2;
pub const AS_REFUTED: i64 = 3;
pub const AS_CONJUNCT: i64 = 1;

// A drop's decision: not decided yet (the builder's), kept, removed, run
// under flag d, opened (each moved child's siblings dropped instead).
pub const DS_UNDECIDED: i64 = 0;
pub const DS_KEPT: i64 = 1;
pub const DS_REMOVED: i64 = 2;
pub const DS_FLAG: i64 = 3;
pub const DS_OPEN: i64 = 4;

#[derive(Clone, Copy)] pub struct PLocal {
    pub ty: i64, pub flags: i64, pub src: i64, pub node: i64,
}
#[derive(Clone, Copy)] pub struct PProj {
    pub parent: i64, pub kind: i64, pub val: i64, pub first: i64, pub next: i64,
}

#[derive(Clone, Copy)] pub struct PStmt {
    pub kind: i64, pub a: i64, pub b: i64, pub c: i64, pub d: i64, pub e: i64, pub ops: i64,
    pub nops: i64, pub node: i64,
}

#[derive(Clone, Copy)] pub struct PBlock { pub start: i64, pub len: i64 }

// (0.26.4) The body held, and its control-flow graph (cfg.vl): the
// context passed down to every function that reads or builds one, made
// by its owners (front::check::check_program, middle::lower's
// lower_program, gen0's compile_program, `query drops`). One body is held
// at a time, cleared and reused for the next (body_begin).
pub struct Body<A: Allocator> {
    // Its function (FNS), its Fn node, its parameters' count. A drop
    // shim's body (shim.vl) has fn_ -1 and shim its shim (else -1).
    pub fn_: i64,
    pub node: i64,
    pub params: i64,
    pub shim: i64,
    pub locals: Vec<PLocal, A>,
    pub projs: Vec<PProj, A>,
    pub stmts: Vec<PStmt, A>,
    pub blocks: Vec<PBlock, A>,
    pub ops: Vec<i64, A>,
    pub targets: Vec<i64, A>,
    // The block statements are appended to (-1: none, after a terminator).
    pub cur_block: i64,
    // cfg.vl: per block, its predecessors, preds[pred_at[b] ..
    // pred_at[b + 1]]; the blocks reachable from bb0 in reverse postorder,
    // and each block's index in it (-1: unreachable); the immediate
    // dominator of each reachable block (bb0's is itself; -1 for the
    // unreachable ones); the walks' scratch.
    pub pred_at: Vec<i64, A>,
    pub preds: Vec<i64, A>,
    pub rpo: Vec<i64, A>,
    pub rpo_index: Vec<i64, A>,
    pub idom: Vec<i64, A>,
    pub cfg_stack: Vec<i64, A>,
    pub cfg_next: Vec<i64, A>,
    pub cfg_count: Vec<i64, A>,
    // (0.27.0) The rust edition's region variables (regions.vl): four
    // words a variable, its origin and what it is of; empty in an MVS body.
    // (0.27.1) Each local's region slots (D3.3): local l's are the
    // variables slot_var[slot_at[l] .. slot_at[l + 1]] (a parameter's are
    // its signature's universals); the return type's, the universals
    // ret_var; ubounds, pairs (a, b): universal a outlives b (declared and
    // implied, D4.5).
    pub regions: Vec<i64, A>,
    pub slot_at: Vec<i64, A>,
    pub slot_var: Vec<i64, A>,
    pub ret_var: Vec<i64, A>,
    pub ubounds: Vec<i64, A>,
    // (0.27.2) a rust body's `let` type annotations: (local, type node,
    // statement) triples, the statement the one that gave it its value
    pub annots: Vec<i64, A>,
}

// An empty body, its tables in the compilation's allocator.
pub fn body_new() -> Body<Comp> {
    Body {
        fn_: -1,
        node: 0,
        params: 0,
        shim: -1,
        locals: Vec::new_in(Comp {}),
        projs: Vec::new_in(Comp {}),
        stmts: Vec::new_in(Comp {}),
        blocks: Vec::new_in(Comp {}),
        ops: Vec::new_in(Comp {}),
        targets: Vec::new_in(Comp {}),
        cur_block: -1,
        pred_at: Vec::new_in(Comp {}),
        preds: Vec::new_in(Comp {}),
        rpo: Vec::new_in(Comp {}),
        rpo_index: Vec::new_in(Comp {}),
        idom: Vec::new_in(Comp {}),
        cfg_stack: Vec::new_in(Comp {}),
        cfg_next: Vec::new_in(Comp {}),
        cfg_count: Vec::new_in(Comp {}),
        regions: Vec::new_in(Comp {}),
        slot_at: Vec::new_in(Comp {}),
        slot_var: Vec::new_in(Comp {}),
        ret_var: Vec::new_in(Comp {}),
        ubounds: Vec::new_in(Comp {}),
        annots: Vec::new_in(Comp {}),
    }
}

// A new body for function f (node item): the tables emptied, projection 0
// (none) made.
pub fn body_begin(f: i64, item: i64, pbody: &mut Body<Comp>) {
    pbody.fn_ = f;
    pbody.node = item;
    pbody.params = 0;
    pbody.shim = -1;
    pbody.locals.clear();
    pbody.projs.clear();
    pbody.stmts.clear();
    pbody.blocks.clear();
    pbody.ops.clear();
    pbody.targets.clear();
    // (0.27.1: the last body's graph too, which a fast elaboration left)
    pbody.pred_at.clear();
    pbody.preds.clear();
    pbody.rpo.clear();
    pbody.rpo_index.clear();
    pbody.idom.clear();
    pbody.regions.clear();
    pbody.slot_at.clear();
    pbody.slot_var.clear();
    pbody.ret_var.clear();
    pbody.ubounds.clear();
    pbody.annots.clear();
    pbody.projs.push(PProj { parent: -1, kind: 0, val: 0, first: 0, next: 0 });
    pbody.cur_block = -1;
}

// ---- Locals ----

pub fn new_local(ty: i64, flags: i64, src: i64, node: i64, pbody: &mut Body<Comp>) -> i64 {
    pbody.locals.push(PLocal { ty, flags, src, node });
    pbody.locals.len() as i64 - 1
}

pub fn local_count(pbody: &Body<Comp>) -> i64 {
    pbody.locals.len() as i64
}

pub fn local_ty(l: i64, pbody: &Body<Comp>) -> i64 {
    pbody.locals[l as usize].ty
}

pub fn local_flags(l: i64, pbody: &Body<Comp>) -> i64 {
    pbody.locals[l as usize].flags
}

pub fn has_flag(l: i64, flag: i64, pbody: &Body<Comp>) -> bool {
    (pbody.locals[l as usize].flags & flag) != 0
}

// ---- Projections ----

// The projection list `parent` followed by (kind, val), interned: the same
// list is the same number.
pub fn proj(parent: i64, kind: i64, val: i64, pbody: &mut Body<Comp>) -> i64 {
    let mut c = pbody.projs[parent as usize].first;
    while c != 0 {
        if pbody.projs[c as usize].kind == kind && pbody.projs[c as usize].val == val {
            return c;
        }
        c = pbody.projs[c as usize].next;
    }
    let id = pbody.projs.len() as i64;
    pbody.projs.push(PProj {
        parent, kind, val, first: 0, next: pbody.projs[parent as usize].first,
    });
    pbody.projs[parent as usize].first = id;
    id
}

pub fn proj_parent(p: i64, pbody: &Body<Comp>) -> i64 {
    pbody.projs[p as usize].parent
}

pub fn proj_kind(p: i64, pbody: &Body<Comp>) -> i64 {
    pbody.projs[p as usize].kind
}

pub fn proj_val(p: i64, pbody: &Body<Comp>) -> i64 {
    pbody.projs[p as usize].val
}

// The number of steps of projection list p.
pub fn proj_depth(p: i64, pbody: &Body<Comp>) -> i64 {
    let mut n: i64 = 0;
    let mut q = p;
    while q > 0 {
        n += 1;
        q = pbody.projs[q as usize].parent;
    }
    n
}

// Whether list p has a `*` or an index step: such a place has no move path
// (§3.8). (PJ_CONST is made for arrays only, a part of the array itself; a
// constant index into a slice or a buffer is a PJ_INDEX of a temporary.)
pub fn proj_indirect(p: i64, pbody: &Body<Comp>) -> bool {
    let mut q = p;
    while q > 0 {
        let k = pbody.projs[q as usize].kind;
        if k == PJ_DEREF || k == PJ_INDEX {
            return true;
        }
        q = pbody.projs[q as usize].parent;
    }
    false
}

// The type of a place: local l's type through projection list p (0 when a
// step does not apply, which the verifier reports).
pub fn place_type(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if p == 0 {
        return pbody.locals[l as usize].ty;
    }
    let base = place_type(l, pbody.projs[p as usize].parent, pbody, pcx);
    step_type(base, pbody.projs[p as usize].kind, pbody.projs[p as usize].val, pcx)
}

// The type a projection step (kind, val) gives from a place of type t.
pub fn step_type(t0: i64, kind: i64, val: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // (a distinct type is its underlying one: `str` over `[u8]`, until the
    // erasure)
    let mut t = t0;
    while t > 0 && pcx.types[t as usize].kind == TyKind::Distinct {
        t = pcx.types[t as usize].a;
    }
    if t <= 0 {
        return 0;
    }
    let tk = pcx.types[t as usize].kind;
    if kind == PJ_DEREF {
        return if tk == TyKind::Ptr { pcx.types[t as usize].a } else { 0 };
    }
    if kind == PJ_INDEX || kind == PJ_CONST {
        return if tk == TyKind::Array || tk == TyKind::Slice || tk == TyKind::Ptr {
            pcx.types[t as usize].a
        } else {
            0
        };
    }
    if kind == PJ_VARIANT {
        return if tk == TyKind::Enum { t } else { 0 };
    }
    if kind != PJ_FIELD && kind != PJ_UNION {
        return 0;
    }
    if tk == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        return if val >= 0 && val < struct_field_count(s, pcx) { struct_field_ty(s, val, pcx) }
            else { 0 };
    }
    if tk == TyKind::Tuple {
        return if val >= 0 && val < pcx.types[t as usize].count { type_elem(t, val, pcx) }
            else { 0 };
    }
    if tk == TyKind::Slice {
        return if val == 0 {
            crate::front::types::ptr_to(pcx.types[t as usize].a, pcx)
        } else if val == 1 {
            TY_I64
        } else {
            0
        };
    }
    0
}

// Type t, a distinct type's underlying one (`str` is `[u8]`, until the
// erasure).
pub fn undistinct(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut u = t;
    while u > 0 && pcx.types[u as usize].kind == TyKind::Distinct {
        u = pcx.types[u as usize].a;
    }
    u
}

// ---- The checker's tables, read ----

// The number of fields of struct s (STRUCTS).
pub fn struct_field_count(s: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: STRUCTS is the checker's raw table of structs.
    // SAFETY: s is a struct type's struct, below STRUCT_COUNT.
    unsafe { pcx.structs[s as usize].field_count }
}

// The type of field k of struct s.
pub fn struct_field_ty(s: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: struct_field gives a pointer into the checker's raw FIELDS.
    // SAFETY: 0 <= k < s's field count (the callers check), so it points to
    // one of s's fields.
    unsafe { (*struct_field(s, k, pcx)).ty }
}

// The number of fields of variant v (VARIANTS).
pub fn variant_field_count(v: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: VARIANTS is the checker's raw table of enum variants.
    // SAFETY: v is a variant the checker resolved, below VARIANT_COUNT.
    unsafe { pcx.variants[v as usize].field_count }
}

// The type of field k of variant v's payload (PJ_VARIANT v, then PJ_FIELD
// k): place_type gives the enum for the PJ_VARIANT step, and the field's
// type is asked here.
pub fn variant_part_type(v: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    if k < 0 || k >= variant_field_count(v, pcx) {
        return 0;
    }
    variant_field(v, k, pcx)
}

// The type of place (l, p), with variant payloads: a PJ_FIELD after a
// PJ_VARIANT is the variant's field.
pub fn full_place_type(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if p == 0 {
        return pbody.locals[l as usize].ty;
    }
    let parent = pbody.projs[p as usize].parent;
    if pbody.projs[p as usize].kind == PJ_FIELD && parent > 0
        && pbody.projs[parent as usize].kind == PJ_VARIANT {
        return variant_part_type(pbody.projs[parent as usize].val, pbody.projs[p as usize].val,
            pcx);
    }
    step_type(full_place_type(l, parent, pbody, pcx), pbody.projs[p as usize].kind,
        pbody.projs[p as usize].val, pcx)
}

// Whether struct type t is a closure's env.
pub fn struct_closure(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct {
        return false;
    }
    // UNSAFE: STRUCTS is the checker's raw table of structs.
    // SAFETY: t is a struct type, so TYPES[t].a is below STRUCT_COUNT.
    unsafe { pcx.structs[pcx.types[t as usize].a as usize].closure != 0 }
}

// Whether struct type t is a union.
pub fn is_union_type(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct {
        return false;
    }
    // UNSAFE: STRUCTS is the checker's raw table of structs.
    // SAFETY: t is a struct type, so TYPES[t].a is below STRUCT_COUNT.
    unsafe { (pcx.structs[pcx.types[t as usize].a as usize].repr & REPR_UNION) != 0 }
}

// Whether enum type t keeps its payloads in memory (some variant has
// fields).
pub fn enum_has_fields(t: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Enum {
        return false;
    }
    // UNSAFE: ENUMS is the checker's raw table of enums.
    // SAFETY: t is an enum type, so TYPES[t].a is below ENUM_COUNT.
    unsafe { (*get_enums().add(pcx.types[t as usize].a as usize)).has_fields }
}

// ---- Blocks and statements ----

// A new block, not entered yet (its range starts when it is).
pub fn new_block(pbody: &mut Body<Comp>) -> i64 {
    pbody.blocks.push(PBlock { start: -1, len: 0 });
    pbody.blocks.len() as i64 - 1
}

pub fn block_count(pbody: &Body<Comp>) -> i64 {
    pbody.blocks.len() as i64
}

// Statements go to block b from now on; it must not have been entered.
pub fn enter_block(b: i64, pbody: &mut Body<Comp>) {
    pbody.blocks[b as usize].start = pbody.stmts.len() as i64;
    pbody.blocks[b as usize].len = 0;
    pbody.cur_block = b;
}

pub fn block_start(b: i64, pbody: &Body<Comp>) -> i64 {
    pbody.blocks[b as usize].start
}

pub fn block_len(b: i64, pbody: &Body<Comp>) -> i64 {
    pbody.blocks[b as usize].len
}

// The location of block b's terminator.
pub fn block_term(b: i64, pbody: &Body<Comp>) -> i64 {
    pbody.blocks[b as usize].start + pbody.blocks[b as usize].len
}

// Whether a block is open (statements go somewhere).
pub fn reachable(pbody: &Body<Comp>) -> bool {
    pbody.cur_block >= 0
}

// Appends a statement to the current block: its index (-1 when no block
// is open: the code after a `return` or a `break`, never run).
pub fn emit(kind: i64, a: i64, b: i64, c: i64, d: i64, e: i64, ops: i64, nops: i64,
    node: i64, pbody: &mut Body<Comp>) -> i64 {
    if pbody.cur_block < 0 {
        return -1;
    }
    pbody.stmts.push(PStmt { kind, a, b, c, d, e, ops, nops, node });
    pbody.stmts.len() as i64 - 1
}

// The six tables of a body replaced whole (keep.vl load_body: a kept
// body's, taken, not copied).
pub fn set_tables(
    l: Vec<PLocal, Comp>, p: Vec<PProj, Comp>, s: Vec<PStmt, Comp>,
    b: Vec<PBlock, Comp>, o: Vec<i64, Comp>, t: Vec<i64, Comp>,
    pbody: &mut Body<Comp>) {
    let _ = mem::replace(&mut pbody.locals, l);
    let _ = mem::replace(&mut pbody.projs, p);
    let _ = mem::replace(&mut pbody.stmts, s);
    let _ = mem::replace(&mut pbody.blocks, b);
    let _ = mem::replace(&mut pbody.ops, o);
    let _ = mem::replace(&mut pbody.targets, t);
}

// Ends the current block with terminator `kind` (its fields as emit's);
// no block is open after it.
pub fn terminate(kind: i64, a: i64, b: i64, c: i64, ops: i64, nops: i64, node: i64,
    pbody: &mut Body<Comp>) {
    if pbody.cur_block < 0 {
        return;
    }
    close_block(pbody);
    pbody.stmts.push(PStmt { kind, a, b, c, d: 0, e: 0, ops, nops, node });
    pbody.cur_block = -1;
}

// The current block's length set: its statements so far (each terminator
// calls it, before it is pushed). An open block's length is not kept
// while statements are emitted.
pub fn close_block(pbody: &mut Body<Comp>) {
    { let at_ix = pbody.cur_block as usize;
        pbody.blocks[at_ix].len = pbody.stmts.len() as i64 - pbody.blocks[pbody.cur_block as usize].start };
}

// The operand triples of a statement start at the end of P_OPS: push them
// with push_op, then emit with ops = the mark, nops = their count.
pub fn ops_mark(pbody: &Body<Comp>) -> i64 {
    pbody.ops.len() as i64
}

pub fn push_op(kind: i64, a: i64, b: i64, pbody: &mut Body<Comp>) {
    pbody.ops.push(kind);
    pbody.ops.push(a);
    pbody.ops.push(b);
}

pub fn op_kind(at: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    pbody.ops[(at + 3 * i) as usize]
}

pub fn op_a(at: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    pbody.ops[(at + 3 * i + 1) as usize]
}

pub fn op_b(at: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    pbody.ops[(at + 3 * i + 2) as usize]
}

// Whether operand kind k is of a place.
pub fn op_is_place(k: i64) -> bool {
    k == OK_COPY || k == OK_MOVE || k == OK_PLACE
}

pub fn is_terminator(kind: i64) -> bool {
    kind >= TK_GOTO
}

// The successors of block b's terminator: their count, then each.
pub fn succ_count(b: i64, pbody: &Body<Comp>) -> i64 {
    let t = block_term(b, pbody);
    let k = pbody.stmts[t as usize].kind;
    if k == TK_GOTO {
        return 1;
    }
    if k == TK_SWITCH {
        return pbody.stmts[t as usize].b + 1;
    }
    0
}

pub fn succ(b: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    let t = block_term(b, pbody);
    let s = pbody.stmts[t as usize];
    if s.kind == TK_GOTO {
        return s.a;
    }
    if i < s.b { pbody.targets[(s.a + 2 * i + 1) as usize] } else { s.c }
}

// ---- Points (§3.6) ----

// Location loc's start point, and its mid point: dense, so that a set of
// points is a bitset (0.27's liveness and solve).
pub fn point_start(loc: i64) -> i64 {
    2 * loc
}

pub fn point_mid(loc: i64) -> i64 {
    2 * loc + 1
}

// The unit type, for the result of a statement with no value.
pub fn unit_ty() -> i64 {
    TY_UNIT
}
