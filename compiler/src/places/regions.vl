// (0.27.0) The rust edition's region variables (docs/design/places-ir.md,
// "Regions, the side tables"; docs/design/borrowck.md §3-§5, the rules
// cited D3.3 ...). A body of a rust-edition function gets, in
// pbody.regions, a variable for each universal region of its signature
// (RO_UNIVERSAL, D4.1: 'static first, then its named lifetimes, its
// elided input regions, its type parameters' substitutions' regions),
// for each region slot of a local that is not a parameter (RO_LOCAL,
// D3.3), for each borrow (RO_LOAN: its statement) and for each region of
// a callee's signature at each call (RO_CALL, n rows a call). A borrow's
// region word (PStmt.e of an RV_REF or RV_SLICE) names its variable,
// counted from 1 (0: none); so does a call's (PStmt.e of an SK_CALL: its
// first call region; 0: the callee has none). Four words a variable: its
// origin and three words of what it is of.
//
// (0.27.1) The slots (D3.3), the signatures read with their lifetimes
// (D4.1, D4.2: Sig, sig_of), the places' regions (place_regions), the
// variance of each user type (D5.3: variance_table) and of each slot of a
// type (D5.4: slot_variances): what places/borrowck reads.

use std::alloc::Allocator; use crate::base::{buf_int, buf_new, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NODE_REF, NODE_REF_MUT, NodeKind, child};
use crate::front::obligations::obligation_error;
use crate::front::parser::rust::lifetimes_of;
use crate::front::types::{REF_MUT, REF_RAW, REF_SHARED, TyKind, fn_param, type_elem, variant_field};
use crate::places::front::{enum_info, fn_node, fn_param_count, fn_ret, tlist_at};
use crate::places::ir::{
    BK_RAW, BK_RAW_MUT, Body, PJ_CONST, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION, PJ_VARIANT, RV_REF,
    RV_SLICE, SK_ASSIGN, SK_CALL, block_count, block_len, block_start, full_place_type, op_a, op_b,
    op_is_place, op_kind, struct_field_count, struct_field_ty,
};

pub const RO_LOAN: i64 = 1;
pub const RO_LOCAL: i64 = 2;
pub const RO_UNIVERSAL: i64 = 3;
pub const RO_CALL: i64 = 4;

// The kinds of universal regions (D4.1): 'static (always the body's
// variable 1), a named lifetime (x: its symbol), an elided input region
// (x: its parameter's local, y: the slot), a region of a type parameter's
// substitution (x: the parameter's symbol, y: the slot of it, D4.4).
pub const U_STATIC: i64 = 1;
pub const U_NAMED: i64 = 2;
pub const U_ELIDED: i64 = 3;
pub const U_SUBST: i64 = 4;
// (0.27.2) A closure body's (D19.4, D20.3): a bound region of its
// signature (local; x: the parameter's local that introduces it, y: its
// number), its env reference's 'e (local; x: the closure), a slot of its
// type C (external; x: the closure, y: the position in slots(C)).
pub const U_BOUND: i64 = 5;
pub const U_ENV: i64 = 6;
pub const U_CSLOT: i64 = 7;
// (0.27.2.1) An `impl Tr` result's one region (D21.2, D21.3; external):
// every input region outlives it, and the body chooses which it is.
pub const U_OPAQUE: i64 = 8;
// (0.27.5, D4.6 (f)) A region of a projection an Ω's bound defines,
// `Ω::Item` with `Iterator<Item = &'a str>` (external): x the bound's
// lifetime's symbol, the caller's; a call ties it to the caller's
// universal of that name.
pub const U_OUTER: i64 = 9;

// Variances (D5.1), as bits: the meet is their union, `*` (bivariant)
// the identity.
pub const V_BI: i64 = 0;
pub const V_CO: i64 = 1;
pub const V_CONTRA: i64 = 2;
pub const V_INV: i64 = 3;

// What the binding walk says of a slot: its region elided, 'static, a
// named lifetime (x: its symbol), a slot of a type parameter's
// substitution (x: the parameter's index in its list, y: the slot).
pub const B_ELIDED: i64 = 0;
pub const B_STATIC: i64 = 1;
pub const B_NAMED: i64 = 2;
pub const B_PARAM: i64 = 3;
// (0.27.2, D20.3) a slot of a projection read with no instance (bind_walk
// with f = F_MARK: a closure's bound `F: FnMut(B, Self::Item) -> B`), an
// X_C position subst_requirements ties to the instance's resolution
const B_PROJ: i64 = 4;
// (`Self` of a trait's default method: x its symbol, y the slot)
pub const B_SELF: i64 = 5;
// (a type parameter's slot read through a written `&T` that its view
// substitution collapses, `&T` with T = str: B_PARAM's, and an input of
// E2 as the reference is)
pub const B_PARAM_REF: i64 = 6;
// (0.27.5, D4.6 (f)) a slot of a projection of an Ω, `Ω::Item`: the
// lifetime its bound's `Item = X` names there (x: its symbol), or a region
// of its own (B_FREE); never an elided output region
const B_OUTER: i64 = 7;
const B_FREE: i64 = 8;
// (0.30.2, RT-211 review) a slot whose universal is known already (x: it):
// an impl parameter its header does not name, bound by the trait
// arguments (impl_bound_ties, arg_ties)
const B_UNIV: i64 = 9;
// (0.30.2, RT-211 review 2) a slot of a projection no impl normalizes
// (none, two, a limit, an Ω's without its binding): every region of the
// projection's base one region, the slot that one; x: the base's entries,
// a row of Ctx.proj_sel (tied_universal). Never an elided region.
const B_TIED: i64 = 10;
// (bind_walk with f = F_NEST) a slot of projection node x of type y, read
// in an impl's terms, normalized by the caller (norm_value)
const B_NEST: i64 = 11;

// Kind b read as B_PARAM when it is B_PARAM_REF.
pub fn param_kind(b: i64) -> i64 {
    if b == B_PARAM_REF { B_PARAM } else { b }
}

const F_MARK: i64 = -2;
const F_NEST: i64 = -3;

// A field map's entries other than an index of the owner's slots: the
// slot is 'static's; it has no owner slot (an MVS std struct's view, R2).
pub const MAP_STATIC: i64 = -1;
pub const MAP_NONE: i64 = -2;

// Whether function f is the rust edition's (its node in a file read so).
pub fn rust_fn(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    let node = fn_node(f, pcx);
    node > 0
}

// Whether function f's operands follow Rust's rules (D8.3): every
// function with a node, the program's and the ones the compiler made from
// it (a derive's impl, a contract's companion, a multiversion copy:
// FN_DERIVED) alike, so that each is borrow-checked and drop-elaborated
// as itself and none is trusted to inherit what was checked on its
// original (RT-34).
pub fn rust_operands(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    rust_fn(f, pcx)
}

// ---- The region variables of a body ----

// The body held, a rust-edition function's: its region variables made,
// its locals' slots bound to them (D3.2).
pub fn assign_regions(pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) {
    pbody.regions.clear();
    pbody.slot_at.clear();
    pbody.slot_var.clear();
    pbody.ret_var.clear();
    pbody.ubounds.clear();
    let mut sig = sig_new();
    sig_of(pbody.fn_, &mut sig, pcx);
    if sig.elision > 0 {
        elision_error(pbody.fn_, sig.elision, pcx);
    }
    // RULE: D4.1 (the universals first: 'static is variable 1)
    for u in 0..universal_count(&sig) {
        push_row(RO_UNIVERSAL, sig.univ[(3 * u) as usize], sig.univ[(3 * u + 1) as usize],
            sig.univ[(3 * u + 2) as usize], pbody);
    }
    let mut i: i64 = 0;
    while i + 1 < sig.bounds.len() as i64 {
        pbody.ubounds.push(sig.bounds[i as usize] + 1);
        pbody.ubounds.push(sig.bounds[(i + 1) as usize] + 1);
        i += 2;
    }
    // RULE: D3.2 (a parameter's slots are its signature's universals; any
    // other local's, variables of their own)
    for l in 0..pbody.locals.len() as i64 {
        pbody.slot_at.push(pbody.slot_var.len() as i64);
        let n = slot_count(pbody.locals[l as usize].ty, pcx);
        let param = l >= 1 && l <= pbody.params && l < sig.param_at.len() as i64;
        let base: i64 = if param { sig.param_at[(l - 1) as usize] } else { 0 };
        let bound: i64 = if param { sig.param_at[l as usize] - base } else { 0 };
        // RULE: D3.2 (0.28.0) a static's slots are 'static: a value stored
        // in it outlives 'static (rustc's E0597 for `K = s.as_str()`)
        let fixed = (pbody.locals[l as usize].flags & crate::places::ir::LF_STATIC) != 0;
        for j in 0..n {
            if fixed {
                pbody.slot_var.push(1);
            } else if j < bound {
                pbody.slot_var.push(sig.params[(base + j) as usize] + 1);
            } else {
                push_row(RO_LOCAL, l, j, 0, pbody);
                pbody.slot_var.push(region_count(pbody));
            }
        }
    }
    pbody.slot_at.push(pbody.slot_var.len() as i64);
    for j in 0..sig.ret.len() as i64 {
        pbody.ret_var.push(sig.ret[j as usize] + 1);
    }
    // RULE: D3.2 (a loan per borrow; n call regions per call, D3.6)
    let mut csig = sig_new();
    for s in 0..pbody.stmts.len() as i64 {
        let st = pbody.stmts[s as usize];
        if st.kind == SK_ASSIGN
            && (st.c == RV_REF && st.d != BK_RAW && st.d != BK_RAW_MUT || st.c == RV_SLICE) {
            push_row(RO_LOAN, s, 0, 0, pbody);
            pbody.stmts[s as usize].e = region_count(pbody);
        } else if st.kind == SK_CALL && st.c >= 0 {
            // (a closure value's call, c = -1, gets its signature's in
            // 0.27.1's M2: D10.3)
            sig_of(st.c, &mut csig, pcx);
            let n = universal_count(&csig) - 1;
            pbody.stmts[s as usize].e = if n > 0 { region_count(pbody) + 1 } else { 0 };
            for j in 0..n {
                push_row(RO_CALL, s, j, 0, pbody);
            }
        }
    }
}

fn push_row(origin: i64, a: i64, b: i64, c: i64, pbody: &mut Body<Comp>) {
    pbody.regions.push(origin);
    pbody.regions.push(a);
    pbody.regions.push(b);
    pbody.regions.push(c);
}

// The number of region variables of the body held.
pub fn region_count(pbody: &Body<Comp>) -> i64 {
    pbody.regions.len() as i64 / 4
}

// Region variable r's origin (RO_*; r counted from 1).
pub fn region_origin(r: i64, pbody: &Body<Comp>) -> i64 {
    pbody.regions[(4 * (r - 1)) as usize]
}

// Region variable r's words: a universal's kind, x and y (U_*); a local's
// local and slot; a loan's statement; a call's statement and the callee's
// region (counted from 0, 'static left out).
pub fn region_word(r: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    pbody.regions[(4 * (r - 1) + 1 + i) as usize]
}

// The text of region variable r's origin (counted from 1).
pub fn origin_text(r: i64, pbody: &Body<Comp>) -> *const u8 {
    let o = region_origin(r, pbody);
    if o == RO_LOAN { c"loan" } else if o == RO_LOCAL { c"local" }
    else if o == RO_UNIVERSAL { c"universal" } else { c"call" }
}

// The variable of slot i of local l (counted from 1; 0: none).
pub fn slot_var(l: i64, i: i64, pbody: &Body<Comp>) -> i64 {
    if l < 0 || l + 1 >= pbody.slot_at.len() as i64 {
        return 0;
    }
    let at = pbody.slot_at[l as usize] + i;
    if i < 0 || at >= pbody.slot_at[(l + 1) as usize] { 0 } else { pbody.slot_var[at as usize] }
}

// The number of slots bound to local l.
pub fn slots_bound(l: i64, pbody: &Body<Comp>) -> i64 {
    if l < 0 || l + 1 >= pbody.slot_at.len() as i64 { 0 }
    else { pbody.slot_at[(l + 1) as usize] - pbody.slot_at[l as usize] }
}

// Region variable r's line of the dump (docs/design/borrowck.md §16):
// `region 'r2: universal 'a (_1.0, return.0)`, `region 'r5: local _3.0`,
// `region 'r7: loan bb0[4]`, `region 'r9: call bb0[12].1`.
pub fn buf_region(out: i64, r: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) {
    buf_str(out, c"    region 'r");
    buf_int(out, r);
    buf_str(out, c": ");
    buf_str(out, origin_text(r, pbody));
    let o = region_origin(r, pbody);
    let a = region_word(r, 0, pbody);
    let b = region_word(r, 1, pbody);
    let c = region_word(r, 2, pbody);
    if o == RO_UNIVERSAL {
        buf_str(out, c" ");
        if a == U_STATIC {
            buf_str(out, c"'static");
        } else if a == U_NAMED || a == U_OUTER {
            buf_str(out, c"'");
            crate::base::buf_bytes(out, sym_text(b, pcx));
        } else if a == U_SUBST {
            buf_str(out, c"'");
            crate::base::buf_bytes(out, sym_text(b, pcx));
            buf_str(out, c".");
            buf_int(out, c);
        } else {
            buf_str(out, c"'_");
            buf_int(out, b);
            if c > 0 {
                buf_str(out, c".");
                buf_int(out, c);
            }
        }
        let mut first = true;
        for l in 0..pbody.locals.len() as i64 {
            for i in 0..slots_bound(l, pbody) {
                if slot_var(l, i, pbody) == r {
                    buf_str(out, if first { c" (_" } else { c", _" });
                    buf_int(out, l);
                    buf_str(out, c".");
                    buf_int(out, i);
                    first = false;
                }
            }
        }
        for j in 0..pbody.ret_var.len() as i64 {
            if pbody.ret_var[j as usize] == r {
                buf_str(out, if first { c" (return." } else { c", return." });
                buf_int(out, j);
                first = false;
            }
        }
        if !first {
            buf_str(out, c")");
        }
    } else if o == RO_LOCAL {
        buf_str(out, c" _");
        buf_int(out, a);
        buf_str(out, c".");
        buf_int(out, b);
    } else {
        buf_str(out, c" ");
        buf_location(out, a, pbody);
        if o == RO_CALL {
            buf_str(out, c".");
            buf_int(out, b);
        }
    }
    buf_str(out, c"\n");
}

// The universals' bounds of the dump, `bound 'r2: 'r3` ('r2 outlives
// 'r3).
pub fn buf_bounds(out: i64, pbody: &Body<Comp>) {
    let mut i: i64 = 0;
    while i + 1 < pbody.ubounds.len() as i64 {
        buf_str(out, c"    bound 'r");
        buf_int(out, pbody.ubounds[i as usize]);
        buf_str(out, c": 'r");
        buf_int(out, pbody.ubounds[(i + 1) as usize]);
        buf_str(out, c"\n");
        i += 2;
    }
}

// Statement s's location, `bb2[3]`.
fn buf_location(out: i64, s: i64, pbody: &Body<Comp>) {
    for b in 0..block_count(pbody) {
        let start = block_start(b, pbody);
        if start >= 0 && s >= start && s <= start + block_len(b, pbody) {
            buf_str(out, c"bb");
            buf_int(out, b);
            buf_str(out, c"[");
            buf_int(out, s - start);
            buf_str(out, c"]");
            return;
        }
    }
}

// (--verify-places) The body held, a rust-edition one: each local has as
// many variables bound as its type has slots, each a variable of the
// body (D3.3). The problems found, reported to out.
pub fn verify_slots(out: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if pbody.regions.len() == 0 {
        return 0;
    }
    let mut bad: i64 = 0;
    if pbody.slot_at.len() as i64 != pbody.locals.len() as i64 + 1 {
        buf_str(out, c"  the slot table does not cover the locals\n");
        return 1;
    }
    for l in 0..pbody.locals.len() as i64 {
        let want = slot_count(pbody.locals[l as usize].ty, pcx);
        if slots_bound(l, pbody) != want {
            crate::base::buf_fmt(out,
                format_args("  _{l} has {} region slots bound, its type {want}\n",
                    slots_bound(l, pbody)));
            bad += 1;
        }
        for i in 0..slots_bound(l, pbody) {
            let v = slot_var(l, i, pbody);
            if v < 1 || v > region_count(pbody) {
                crate::base::buf_fmt(out,
                    format_args("  _{l}'s slot {i} names no region variable\n"));
                bad += 1;
            }
        }
    }
    // RULE: D3.3 (|regions(P)| = |slots(type(P))|, every place the body
    // names)
    for s in 0..pbody.stmts.len() as i64 {
        let st = pbody.stmts[s as usize];
        if (st.kind == SK_ASSIGN || st.kind == SK_CALL) && st.a >= 0 {
            bad += verify_place(st.a, st.b, out, pbody, pcx);
        }
        for i in 0..st.nops {
            if op_is_place(op_kind(st.ops, i, pbody)) {
                bad += verify_place(op_a(st.ops, i, pbody), op_b(st.ops, i, pbody), out, pbody,
                    pcx);
            }
        }
    }
    bad
}

// (--verify-places) Place (l, p) of the body held: its regions
// (place_regions) as many as its type's slots, each a variable of the
// body or none; the problems, reported to out.
fn verify_place(l: i64, p: i64, out: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if l < 0 || l >= pbody.locals.len() as i64 {
        return 0;
    }
    let mut regs: Vec<i64, Comp> = Vec::new_in(Comp {});
    place_regions(l, p, pbody, &mut regs, pcx);
    let want = slot_count(full_place_type(l, p, pbody, pcx), pcx);
    if regs.len() as i64 != want {
        crate::base::buf_fmt(out, format_args("  a place of _{l} has {} regions, its type {want}\n",
            regs.len()));
        return 1;
    }
    0
}

// ---- Slots (D3.3) ----

// The number of region slots of type t (D3.3): `&T`, `&mut T`, a view
// (`[T]`, `str`) one each and the pointee's; a raw pointer, an array the
// pointee's, the element's; a tuple its elements'; a struct or an enum
// its declared lifetimes and its type arguments'; a closure its captures'
// (as its env's fields; by-reference captures are raw until M2: D10.2).
pub fn slot_count(t: i64, pcx: &Ctx<Comp>) -> i64 {
    slots_in(t, 0, pcx)
}

// RULE: D8.3 Whether a value of type t is copied, not moved, by a
// rust-edition operand (Rust's Copy): a scalar, a fn, `&T`, a raw
// pointer, a shared view; an array or a tuple of Copy; a closure whose
// captures are; a rust-edition struct or enum with `#[derive(Copy)]`
// (its type arguments Copy) or an `impl Copy`; another one (std's) when
// it has no drop glue and its type arguments are Copy.
pub fn rust_copy(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    copy_in(t, 0, pcx)
}

fn copy_in(t: i64, depth: i64, pcx: &mut Ctx<Comp>) -> bool {
    // (0.30.1: no depth cut-off: a type is a finite tree, and the walk
    // follows only its arguments and a closure's captures; past depth 16
    // it answered Copy, and 17 arrays around a String were copied twice)
    if t <= 0 {
        return true;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Slice {
        return pcx.types[t as usize].b != REF_MUT;
    }
    // RULE: D21.3 (0.27.2.1: an `impl Tr` result is Copy iff a bound says so)
    // (0.30.2, review of M1: an Ω by the front's selection, its own
    // predicates first: front::traits::implements)
    if crate::front::opaque::is_opaque(t, pcx) {
        let copy = crate::front::traits::std_trait(c"Copy", pcx);
        return copy >= 0 && crate::front::traits::implements(copy, t, pcx);
    }
    if k == TyKind::Array || k == TyKind::Distinct {
        return copy_in(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            if !copy_in(type_elem(t, i, pcx), depth + 1, pcx) {
                return false;
            }
        }
        return true;
    }
    if k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        let s = pcx.types[t as usize].a;
        for i in 0..struct_field_count(s, pcx) {
            // (a by-`&mut` capture is not Copy, though its field is a raw
            // pointer)
            if capture_mode(s, i, pcx) == 2
                || !copy_in(struct_field_ty(s, i, pcx), depth + 1, pcx) {
                return false;
            }
        }
        return true;
    }
    if k != TyKind::Struct && k != TyKind::Enum {
        return true;
    }
    let node = adt_node(t, pcx);
    let mut derived = false;
    if node > 0 {
        for i in 0..pcx.rust_copy.len() as i64 {
            derived = derived || pcx.rust_copy[i as usize] == node;
        }
        if !derived {
            // (an `impl Copy`, its own bounds checked by has_impl)
            let copy = crate::front::traits::std_trait(c"Copy", pcx);
            return copy >= 0 && crate::front::traits::has_impl(copy, t, pcx);
        }
    } else if crate::places::front::type_glue(t, pcx) {
        return false;
    }
    // (a derive's `T: Copy` bounds; std's own types' arguments)
    for i in 0..adt_targ_count(t, pcx) {
        if !copy_in(adt_targ(t, i, pcx), depth + 1, pcx) {
            return false;
        }
    }
    true
}

// RULE: C5 Whether type t holds a raw pointer, itself or in a part (an
// `old(e)` of such a type is refused).
pub fn holds_raw(t: i64, pcx: &Ctx<Comp>) -> bool {
    raw_in(t, &mut Vec::<i64, Comp>::new_in(Comp {}), pcx)
}

// (0.30.1) seen: the structs and enums walked so far; one walked again
// adds nothing (it is being walked, or it was and holds none), so the walk
// ends on a recursive type and walks a shared one once. Before, past depth
// 16 the answer was "holds a raw pointer", and `old(*p)` of a plain Copy
// struct nested 16 deep was a false contract.old.
fn raw_in(t: i64, seen: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 {
        return false;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr {
        return pcx.types[t as usize].b == 0 || raw_in(pcx.types[t as usize].a, seen, pcx);
    }
    if k == TyKind::Slice || k == TyKind::Array || k == TyKind::Distinct {
        return raw_in(pcx.types[t as usize].a, seen, pcx);
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            if raw_in(type_elem(t, i, pcx), seen, pcx) {
                return true;
            }
        }
        return false;
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        if seen.contains(&t) {
            return false;
        }
        seen.push(t);
    }
    if k == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        for i in 0..struct_field_count(s, pcx) {
            if raw_in(struct_field_ty(s, i, pcx), seen, pcx) {
                return true;
            }
        }
        return false;
    }
    if k == TyKind::Enum {
        for i in 0..adt_targ_count(t, pcx) {
            if raw_in(adt_targ(t, i, pcx), seen, pcx) {
                return true;
            }
        }
    }
    false
}

// RULE: C5 Whether an `old(e)` of type t is accepted in the rust edition:
// t is Copy, holds no region slot and no raw pointer.
pub fn old_plain(t: i64, pcx: &mut Ctx<Comp>) -> bool {
    rust_copy(t, pcx) && slot_count(t, pcx) == 0 && !holds_raw(t, pcx)
}

fn slots_in(t: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    // (0.30.1: no depth cut-off, a type is a finite tree: past 16 it
    // counted no slot, and a reference nested deeper had no region)
    if t <= 0 {
        return 0;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr {
        let own: i64 = if is_ref_kind(pcx.types[t as usize].b) { 1 } else { 0 };
        return own + slots_in(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Slice {
        // RULE: Z9.1 (a fat raw pointer, `*const [T]`, has no region of its
        // own, as a thin one: its pointee's slots)
        let own: i64 = if pcx.types[t as usize].b == REF_RAW { 0 } else { 1 };
        return own + slots_in(pcx.types[t as usize].a, depth + 1, pcx);
    }
    // RULE: Z9.1c (0.27.4: the place `[T]`/`str` has no region of its own,
    // the reference to it supplies one: its element's slots)
    if k == TyKind::Unsized {
        let v = pcx.types[t as usize].a;
        let s = if pcx.types[v as usize].kind == TyKind::Distinct { pcx.types[v as usize].a }
            else { v };
        return slots_in(pcx.types[s as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Array || k == TyKind::Distinct {
        return slots_in(pcx.types[t as usize].a, depth + 1, pcx);
    }
    if k == TyKind::Tuple {
        let mut n: i64 = 0;
        for i in 0..pcx.types[t as usize].count {
            n += slots_in(type_elem(t, i, pcx), depth + 1, pcx);
        }
        return n;
    }
    if k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        let s = pcx.types[t as usize].a;
        let mut n: i64 = 0;
        for i in 0..struct_field_count(s, pcx) {
            n += capture_slots(s, i, depth, pcx);
        }
        // RULE: D19.1 (then X_C, the external signature regions)
        return n + xc_count(s, pcx);
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let mut n = decl_lifetimes(adt_node(t, pcx), pcx);
        for i in 0..adt_targ_count(t, pcx) {
            n += slots_in(adt_targ(t, i, pcx), depth + 1, pcx);
        }
        return n;
    }
    0
}

// RULE: D10.2 Capture i of closure struct s: 0 by value, 1 by `&`, 2 by
// `&mut` (front::closures' capture list); a field after the captures (a
// drop flag): 0.
pub fn capture_mode(s: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let c = pcx.structs[s as usize].closure - 1;
    if c < 0 || i >= pcx.closures[c as usize].capture_count {
        return 0;
    }
    pcx.capture_list[(pcx.closures[c as usize].captures + 2 * i + 1) as usize]
}

// The slots field i of closure struct s holds (D3.3, D10.2): a
// by-reference capture's field is a raw pointer, which holds its loan's
// slot and its pointee's (`&'c T`'s), another field its type's.
fn capture_slots(s: i64, i: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    let ft = struct_field_ty(s, i, pcx);
    if capture_ref(s, i, pcx) {
        return 1 + slots_in(pcx.types[ft as usize].a, depth + 1, pcx);
    }
    slots_in(ft, depth + 1, pcx)
}

// Whether field i of closure struct s is a by-reference capture (its raw
// pointer holds a loan's slot).
fn capture_ref(s: i64, i: i64, pcx: &Ctx<Comp>) -> bool {
    let ft = struct_field_ty(s, i, pcx);
    capture_mode(s, i, pcx) > 0 && ft > 0 && pcx.types[ft as usize].kind == TyKind::Ptr
}

// RULE: D10.2 Where field k's slots begin among those of closure type t:
// the aggregate's operand k (`&'c x` for a by-reference capture, its loan
// slot first) fills the closure's slots from there.
pub fn capture_offset(t: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    let s = pcx.types[t as usize].a;
    let mut off: i64 = 0;
    for i in 0..k {
        off += capture_slots(s, i, 0, pcx);
    }
    off
}

// RULE: D19.3 Whether closure type t is `FnMut`: its kind (front/closures/
// kinds.vl), or, before the kinds are known, a by-`&mut` capture (D10.3).
pub fn closure_writes(t: i64, pcx: &Ctx<Comp>) -> bool {
    let s = pcx.types[t as usize].a;
    let c = pcx.structs[s as usize].closure - 1;
    if c >= 0 && pcx.closures[c as usize].kind != 0 {
        return pcx.closures[c as usize].kind == crate::front::closures::kinds::KIND_FN_MUT;
    }
    for i in 0..struct_field_count(s, pcx) {
        if capture_mode(s, i, pcx) == 2 {
            return true;
        }
    }
    false
}

// RULE: D19.5 Whether closure type t is `FnOnce` (its env a value).
pub fn closure_once(t: i64, pcx: &Ctx<Comp>) -> bool {
    let c = pcx.structs[pcx.types[t as usize].a as usize].closure - 1;
    c >= 0 && pcx.closures[c as usize].kind == crate::front::closures::kinds::KIND_FN_ONCE
}

// ---- A closure's signature regions (D19.1, D19.4, D20.3) ----

// The number of X_C positions of closure struct s (0 before
// closure_sig_slots, and for an MVS closure).
fn xc_count(s: i64, pcx: &Ctx<Comp>) -> i64 {
    let id = pcx.structs[s as usize].closure - 1;
    if id < 0 { 0 } else { pcx.closures[id as usize].xc_n }
}

// The closure whose body is function f (its CLOSURES index), or -1.
pub fn closure_of_fn(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let node = fn_node(f, pcx);
    if node <= 0 || (pcx.nodes[node as usize].p & crate::front::ast::FN_CLOSURE) == 0 {
        return -1;
    }
    for id in 0..pcx.closures.len() as i64 {
        if pcx.closures[id as usize].f == f {
            return id;
        }
    }
    -1
}

// RULE: D20.3 The region positions of closure id's signature (its
// parameters but the env, left to right, then its result; each type's
// slots in D3.3's order): the parallel walk's entries into walk (four
// words each, bind_walk's), read with bound bnode's types (generics btps)
// when it is one, else with the annotations (instance inst and its Self
// node resolving a projection, F_MARK marking one, B_PROJ), and each entry's class into codes:
// an index of X_C (external: an inferred region, a named one, one of the
// bound's instantiation), -1 'static, or -2 - g for bound region g (an
// elided region of an input written, the bound's or the annotation's;
// the result's elided region is the bound's input region when the bound
// has one input region, E2, and else external: a closure's own signature
// has no elision rule). at[i]: where parameter i's entries begin, at[n]
// the result's, at[n + 1] the end. Returns |X_C|.
fn closure_sig_walk(id: i64, bnode: i64, btps: i64, walk: &mut Vec<i64, Comp>,
    at: &mut Vec<i64, Comp>, codes: &mut Vec<i64, Comp>, inst: i64, self_node: i64,
    pcx: &Ctx<Comp>) -> i64 {
    walk.clear();
    at.clear();
    codes.clear();
    let f = pcx.closures[id as usize].f;
    let n = pcx.closures[id as usize].node;
    let e0: i64 = if pcx.closures[id as usize].capture_count > 0 { 1 } else { 0 };
    let tps: i64 = if bnode > 0 { btps } else { 0 };
    let np = fn_param_count(f, pcx);
    let mut xc: i64 = 0;
    let mut groups: i64 = 0;
    for i in e0..np {
        let start = walk.len() as i64 / 4;
        at.push(start);
        let k = i - e0;
        let mut an: i64 = 0;
        if bnode > 0 {
            an = if k < pcx.nodes[bnode as usize].count { child(bnode, k, pcx) } else { 0 };
        } else if k < pcx.nodes[n as usize].count {
            an = pcx.nodes[child(n, k, pcx) as usize].b;
        }
        bind_walk(an, fn_param(f, i, pcx), tps, self_node, -1, walk, 0, pcx, inst);
        for e in start..walk.len() as i64 / 4 {
            let b = walk[(4 * e) as usize];
            if b == B_STATIC {
                codes.push(-1);
            } else if b == B_ELIDED && an > 0 {
                codes.push(-2 - groups);
                groups += 1;
            } else {
                codes.push(xc);
                xc += 1;
            }
        }
    }
    let inputs = walk.len() as i64 / 4;
    at.push(inputs);
    let rn = if bnode > 0 { pcx.nodes[bnode as usize].a } else { pcx.nodes[n as usize].b };
    bind_walk(rn, fn_ret(f, pcx), tps, self_node, -1, walk, 0, pcx, inst);
    for e in inputs..walk.len() as i64 / 4 {
        let b = walk[(4 * e) as usize];
        if b == B_STATIC {
            codes.push(-1);
        } else if b == B_ELIDED && bnode > 0 && rn > 0 && inputs == 1 {
            { let at_arg1 = codes[0]; codes.push(at_arg1) };
        } else {
            codes.push(xc);
            xc += 1;
        }
    }
    at.push(walk.len() as i64 / 4);
    xc
}

// RULE: D19.1 Closure id's X_C, made once before the bodies (kinds.vl): its
// count, and each position's variance (D5.2 through `fn(A..) -> R`: a
// parameter's slot −, the result's +; one position at both: o), kept in
// CAPTURE_LIST from xc_at.
pub fn closure_sig_slots(id: i64, pcx: &mut Ctx<Comp>) {
    let mut walk = Vec::<i64, Comp>::new_in(Comp {});
    let mut at = Vec::<i64, Comp>::new_in(Comp {});
    let mut codes = Vec::<i64, Comp>::new_in(Comp {});
    let xc = closure_sig_walk(id, pcx.closures[id as usize].exp_node,
        pcx.closures[id as usize].exp_tps, &mut walk, &mut at, &mut codes, F_MARK, 0, pcx);
    let f = pcx.closures[id as usize].f;
    let e0: i64 = if pcx.closures[id as usize].capture_count > 0 { 1 } else { 0 };
    let mut vars = Vec::<i64, Comp>::new_in(Comp {});
    for i in e0..fn_param_count(f, pcx) {
        slot_variances(fn_param(f, i, pcx), V_CONTRA, &mut vars, pcx);
    }
    slot_variances(fn_ret(f, pcx), V_CO, &mut vars, pcx);
    let mut vx = Vec::<i64, Comp>::new_in(Comp {});
    for _ in 0..xc {
        vx.push(V_BI);
    }
    for e in 0..codes.len() as i64 {
        let q = codes[e as usize];
        if q >= 0 {
            vx[q as usize] = vx[q as usize]
                | (if e < vars.len() as i64 { vars[e as usize] } else { V_INV });
        }
    }
    pcx.closures[id as usize].xc_at = pcx.capture_list.len() as i64;
    for q in 0..xc {
        pcx.capture_list.push(vx[q as usize]);
    }
    pcx.closures[id as usize].xc_n = xc;
}

// RULE: D19.4, D20.3 Σ_β of closure id's body f: 'static; for a reference
// env its 'e (U_ENV, local); one external universal per slot of C
// (U_CSLOT), bound to the env's slots after 'e and to X_C's positions of
// the signature; a local one per bound region (U_BOUND); the implied
// bounds (D4.5) of the env's and the signature's types. No elision rule
// and no elision error (D20.3).
fn closure_sig(id: i64, f: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    sig.closure = id;
    let nc = slot_count(pcx.closures[id as usize].ty, pcx);
    let nenv = nc - pcx.closures[id as usize].xc_n;
    for j in 0..nc {
        let u = add_universal(U_CSLOT, id, j, sig);
        sig.cslots.push(u);
    }
    let e0: i64 = if pcx.closures[id as usize].capture_count > 0 { 1 } else { 0 };
    if e0 == 1 {
        let t = fn_param(f, 0, pcx);
        sig.param_at.push(0);
        sig.walk.clear();
        bind_walk(0, t, 0, 0, -1, &mut sig.walk, 0, pcx, -1);
        let base: i64 = if pcx.types[t as usize].kind == TyKind::Ptr { 1 } else { 0 };
        let n = sig.walk.len() as i64 / 4;
        for e in 0..n {
            let mut u: i64 = 0;
            if e < base {
                u = add_universal(U_ENV, id, 0, sig);
            } else if e - base < nc {
                u = sig.cslots[(e - base) as usize];
            } else {
                u = add_universal(U_ELIDED, 1, e, sig);
            }
            sig.params.push(u);
        }
        for e in 0..n {
            let up = sig.walk[(4 * e + 3) as usize];
            if up >= 0 {
                sig.bounds.push(sig.params[e as usize]);
                sig.bounds.push(sig.params[up as usize]);
            }
        }
    }
    let mut walk = Vec::<i64, Comp>::new_in(Comp {});
    let mut at = Vec::<i64, Comp>::new_in(Comp {});
    let mut codes = Vec::<i64, Comp>::new_in(Comp {});
    let _ = closure_sig_walk(id, pcx.closures[id as usize].exp_node,
        pcx.closures[id as usize].exp_tps, &mut walk, &mut at, &mut codes, F_MARK, 0, pcx);
    let np = fn_param_count(f, pcx);
    for i in e0..np {
        let k = i - e0;
        let base = sig.params.len() as i64;
        sig.param_at.push(base);
        for e in at[k as usize]..at[(k + 1) as usize] {
            let u = code_universal(codes[e as usize], i + 1, nenv, sig);
            sig.params.push(u);
        }
        push_decl_bounds(fn_param(f, i, pcx), false, base, sig, pcx);
        for e in at[k as usize]..at[(k + 1) as usize] {
            let up = walk[(4 * e + 3) as usize];
            if up >= 0 {
                sig.bounds.push(sig.params[(base + e - at[k as usize]) as usize]);
                sig.bounds.push(sig.params[(base + up - at[k as usize]) as usize]);
            }
        }
    }
    sig.param_at.push(sig.params.len() as i64);
    let r0 = at[(np - e0) as usize];
    let r1 = at[(np - e0 + 1) as usize];
    for e in r0..r1 {
        let u = code_universal(codes[e as usize], 0, nenv, sig);
        sig.ret.push(u);
    }
    push_decl_bounds(fn_ret(f, pcx), true, 0, sig, pcx);
    for e in r0..r1 {
        let up = walk[(4 * e + 3) as usize];
        if up >= 0 {
            sig.bounds.push(sig.ret[(e - r0) as usize]);
            sig.bounds.push(sig.ret[(up - r0) as usize]);
        }
    }
}

// RULE: D4.5 The declared bounds of the structs and enums in type t
// (`Scope<'scope, 'env: 'scope>`: 'env outlives 'scope), as pairs of t's
// slot positions from off (a outlives b; b = -1: 'static), pushed to out.
fn decl_pairs(t: i64, off: i64, depth: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    if t <= 0 {
        return;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr {
        let own: i64 = if is_ref_kind(pcx.types[t as usize].b) { 1 } else { 0 };
        decl_pairs(pcx.types[t as usize].a, off + own, depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Slice {
        let own: i64 = if pcx.types[t as usize].b == REF_RAW { 0 } else { 1 };
        decl_pairs(pcx.types[t as usize].a, off + own, depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Array || k == TyKind::Distinct {
        decl_pairs(pcx.types[t as usize].a, off, depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Tuple {
        let mut o = off;
        for i in 0..pcx.types[t as usize].count {
            let e = type_elem(t, i, pcx);
            decl_pairs(e, o, depth + 1, out, pcx);
            o += slot_count(e, pcx);
        }
        return;
    }
    if k != TyKind::Struct && k != TyKind::Enum
        || k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        return;
    }
    let node = adt_node(t, pcx);
    let lts: i64 = if node > 0 { lifetimes_of(node, pcx) } else { 0 };
    let nl: i64 = if lts > 0 { pcx.nodes[lts as usize].count } else { 0 };
    for i in 0..nl {
        let bounds = pcx.nodes[child(lts, i, pcx) as usize].h;
        for j in 0..(if bounds > 0 { pcx.nodes[bounds as usize].count } else { 0 }) {
            let bs = pcx.nodes[child(bounds, j, pcx) as usize].a;
            if lifetime_binding(bs, pcx) == B_STATIC {
                out.push(off + i);
                out.push(-1);
                continue;
            }
            for m in 0..nl {
                if pcx.nodes[child(lts, m, pcx) as usize].a == bs {
                    out.push(off + i);
                    out.push(off + m);
                }
            }
        }
    }
    let mut o = off + nl;
    let mut offs = Vec::<i64, Comp>::new_in(Comp {});
    for i in 0..adt_targ_count(t, pcx) {
        let a = adt_targ(t, i, pcx);
        offs.push(o);
        decl_pairs(a, o, depth + 1, out, pcx);
        o += slot_count(a, pcx);
    }
    // RULE: D4.6 (the declaration's inferred outlives requirements, a
    // parameter's as each of its substitution's slots)
    let mut reqs = Vec::<i64, Comp>::new_in(Comp {});
    let mut memo = req_memo();
    adt_reqs(t, &mut memo, &mut reqs, pcx);
    let mut r: i64 = 0;
    while r + 1 < reqs.len() as i64 {
        let a = reqs[r as usize];
        let b: i64 = if reqs[(r + 1) as usize] < 0 { -1 } else { off + reqs[(r + 1) as usize] };
        r += 2;
        if a < nl {
            out.push(off + a);
            out.push(b);
        } else if a - nl < offs.len() as i64 {
            for s in 0..slot_count(adt_targ(t, a - nl, pcx), pcx) {
                out.push(offs[(a - nl) as usize] + s);
                out.push(b);
            }
        }
    }
}

// RULE: D4.6 (0.30.1) The declarations' requirements found while one
// type's are (decl_pairs): each declaration's once, and a group of
// declarations that name each other (a strongly connected component of
// "a field names"; Tarjan's order, `index`, `group`) solved as one unit,
// its members walked once per round until a round adds nothing, then all
// final. An entry: its declaration node; its state (0 its fields being
// walked; 1 final; 3 walked, a member of a group still being solved, on
// `group`); its discovery `index`; the `round` it was last walked in; and
// its pairs in `pairs`, (entry, a, b) triples. `low`: the least index of
// a declaration still being solved that the walk read; `adds`: the
// pairs added so far.
struct ReqMemo<A: Allocator> {
    node: Vec<i64, A>,
    state: Vec<i64, A>,
    index: Vec<i64, A>,
    round: Vec<i64, A>,
    pairs: Vec<i64, A>,
    group: Vec<i64, A>,
    low: i64,
    next: i64,
    now: i64,
    adds: i64,
}

// (no stack place read: above any)
const REQ_NONE: i64 = 1 << 40;

fn req_memo() -> ReqMemo<Comp> {
    ReqMemo {
        node: Vec::new_in(Comp {}), state: Vec::new_in(Comp {}), index: Vec::new_in(Comp {}),
        round: Vec::new_in(Comp {}), pairs: Vec::new_in(Comp {}), group: Vec::new_in(Comp {}),
        low: REQ_NONE, next: 0, now: 0, adds: 0,
    }
}

// Entry e's fields walked once (declaration node of type t): the pairs
// found added to it.
fn memo_walk(e: i64, t: i64, node: i64, memo: &mut ReqMemo<Comp>, pcx: &Ctx<Comp>) {
    let mut cur = Vec::<i64, Comp>::new_in(Comp {});
    field_reqs(t, node, memo, &mut cur, pcx);
    let mut r: i64 = 0;
    while r + 1 < cur.len() as i64 {
        let a = cur[r as usize];
        let b = cur[(r + 1) as usize];
        r += 2;
        if !memo_has(memo, e, a, b) {
            memo.pairs.push(e);
            memo.pairs.push(a);
            memo.pairs.push(b);
            memo.adds += 1;
        }
    }
}

// Entry e's pairs, pushed to out.
fn memo_out(memo: &ReqMemo<Comp>, e: i64, out: &mut Vec<i64, Comp>) {
    let mut i: i64 = 0;
    while i + 2 < memo.pairs.len() as i64 {
        if memo.pairs[i as usize] == e {
            out.push(memo.pairs[(i + 1) as usize]);
            out.push(memo.pairs[(i + 2) as usize]);
        }
        i += 3;
    }
}

// Whether entry e has pair (a, b).
fn memo_has(memo: &ReqMemo<Comp>, e: i64, a: i64, b: i64) -> bool {
    let mut i: i64 = 0;
    while i + 2 < memo.pairs.len() as i64 {
        if memo.pairs[i as usize] == e && memo.pairs[(i + 1) as usize] == a
            && memo.pairs[(i + 2) as usize] == b {
            return true;
        }
        i += 3;
    }
    false
}

// RULE: D4.6 The inferred outlives requirements of struct or enum type t's
// declaration (rustc's RFC 2093), from its fields' types: pairs (a, b), a
// the declaration's lifetime index or, from its lifetime count up, its type
// parameter's; b a lifetime index or -1 ('static); a outlives b.
// (0.30.1) Found once per declaration (memo). Declarations that name each
// other (`struct L<'a, 'b, T> { x: &'a T, y: Option<&'a L<'b, 'a, T>> }`,
// or S0 naming S24 with each S_i two of S_(i-1)) are one group, found by
// Tarjan's walk: its first declaration walked (the root) walks the
// group again, each member once a round (one walked this round is read as
// its pairs so far), until a round adds no pair; the pairs are of each
// declaration's finite lifetimes and parameters, so it ends, at the least
// fixpoint. Then every member is final. Before: a depth cut-off at 8
// dropped what lay deeper; then a declaration met again added nothing
// (`T: 'b` of L's swapped use lost), each use walked its declaration
// again (2^depth over S1 { x: S0, y: S0 } ...), and a member of a group
// was walked again at every use (2^depth inside one).
fn adt_reqs(t: i64, memo: &mut ReqMemo<Comp>, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    if t <= 0 {
        return;
    }
    let k = pcx.types[t as usize].kind;
    if k != TyKind::Struct && k != TyKind::Enum
        || k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        return;
    }
    let node = adt_node(t, pcx);
    if node <= 0 {
        return;
    }
    let mut e: i64 = -1;
    for i in 0..memo.node.len() as i64 {
        if memo.node[i as usize] == node {
            e = i;
        }
    }
    if e >= 0 {
        let st = memo.state[e as usize];
        if st != 1 && memo.index[e as usize] < memo.low {
            memo.low = memo.index[e as usize];
        }
        if st == 3 && memo.round[e as usize] != memo.now {
            // (a member of a group in a new round: walked once in it)
            memo.state[e as usize] = 0;
            memo.round[e as usize] = memo.now;
            memo_walk(e, t, node, memo, pcx);
            memo.state[e as usize] = 3;
        }
        memo_out(memo, e, out);
        return;
    }
    e = memo.node.len() as i64;
    memo.node.push(node);
    memo.state.push(0);
    memo.index.push(memo.next);
    memo.round.push(memo.now);
    memo.next += 1;
    let at = memo.group.len();
    memo.group.push(e);
    let saved_low = memo.low;
    memo.low = REQ_NONE;
    memo_walk(e, t, node, memo, pcx);
    let low = memo.low;
    if low < memo.index[e as usize] {
        // (a member of a group whose root is outside it)
        memo.state[e as usize] = 3;
        memo.low = if low < saved_low { low } else { saved_low };
        memo_out(memo, e, out);
        return;
    }
    if low == memo.index[e as usize] {
        // (the root of a group: rounds until one adds nothing)
        loop {
            let before = memo.adds;
            memo.now += 1;
            memo.round[e as usize] = memo.now;
            memo.low = REQ_NONE;
            memo_walk(e, t, node, memo, pcx);
            if memo.adds == before {
                break;
            }
        }
    }
    for i in at..memo.group.len() {
        memo.state[memo.group[i] as usize] = 1;
    }
    memo.group.truncate(at);
    memo.low = saved_low;
    memo_out(memo, e, out);
}

// The requirements of the fields of declaration node of type t, in its
// terms (adt_reqs' pairs), pushed to out.
fn field_reqs(t: i64, node: i64, memo: &mut ReqMemo<Comp>, out: &mut Vec<i64, Comp>,
    pcx: &Ctx<Comp>) {
    if pcx.types[t as usize].kind == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        for i in 0..pcx.nodes[node as usize].count {
            let field = child(node, i, pcx);
            let ft: i64 = if i < struct_field_count(s, pcx) { struct_field_ty(s, i, pcx) }
                else { 0 };
            req_walk(pcx.nodes[field as usize].b, ft, -2, node, memo, out, pcx);
        }
        return;
    }
    let first = enum_info(pcx.types[t as usize].a, pcx).variants;
    for i in 0..pcx.nodes[node as usize].count {
        let vn = child(node, i, pcx);
        for j in 0..pcx.nodes[vn as usize].count {
            let f = child(vn, j, pcx);
            let fast = if is_node(f, NodeKind::Field, pcx) { pcx.nodes[f as usize].b } else { f };
            let ft: i64 = if first >= 0
                && j < crate::places::ir::variant_field_count(first + i, pcx) {
                variant_field(first + i, j, pcx)
            } else { 0 };
            req_walk(fast, ft, -2, node, memo, out, pcx);
        }
    }
}

// A lifetime written as sym in declaration dn's fields, as adt_reqs counts
// it: its index, -1 'static, -2 none (elided, or not the declaration's).
fn req_lifetime(sym: i64, dn: i64, pcx: &Ctx<Comp>) -> i64 {
    let b = lifetime_binding(sym, pcx);
    if b == B_STATIC {
        return -1;
    }
    if b != B_NAMED {
        return -2;
    }
    let i = lifetime_index(lifetimes_of(dn, pcx), sym, pcx);
    if i >= 0 { i } else { -2 }
}

// a outlives b (adt_reqs' pair), when both are known and a is not 'static.
fn req_push(a: i64, b: i64, out: &mut Vec<i64, Comp>) {
    if a >= 0 && b != -2 && a != b {
        out.push(a);
        out.push(b);
    }
}

// RULE: D4.6 The walk of a field's type node n (checker type t, 0:
// unknown) of declaration dn under the lifetime enc (adt_reqs' index, -1
// 'static, -2 none): every lifetime and type parameter n names outlives
// enc; a reference's or view's lifetime is the new enc below it; a struct
// or enum named adds its own requirements, read in dn's terms.
fn req_walk(n: i64, t: i64, enc: i64, dn: i64, memo: &mut ReqMemo<Comp>, out: &mut Vec<i64, Comp>,
    pcx: &Ctx<Comp>) {
    if n <= 0 {
        return;
    }
    let k = pcx.nodes[n as usize].kind;
    let tk = if t > 0 { pcx.types[t as usize].kind } else { TyKind::None };
    if k == NodeKind::TyPtr {
        let inner_t: i64 = if tk == TyKind::Ptr { pcx.types[t as usize].a } else { 0 };
        if (pcx.nodes[n as usize].p & NODE_REF) != 0 {
            let me = req_lifetime(pcx.nodes[n as usize].c, dn, pcx);
            req_push(me, enc, out);
            req_walk(pcx.nodes[n as usize].a, inner_t, if me == -2 { enc } else { me }, dn,
                memo, out, pcx);
        } else {
            req_walk(pcx.nodes[n as usize].a, inner_t, enc, dn, memo, out, pcx);
        }
        return;
    }
    if k == NodeKind::TySlice {
        let me = req_lifetime(pcx.nodes[n as usize].c, dn, pcx);
        req_push(me, enc, out);
        let inner_t: i64 = if tk == TyKind::Slice { pcx.types[t as usize].a } else { 0 };
        req_walk(pcx.nodes[n as usize].a, inner_t, if me == -2 { enc } else { me }, dn, memo,
            out, pcx);
        return;
    }
    if k == NodeKind::TyArray {
        let inner_t: i64 = if tk == TyKind::Array { pcx.types[t as usize].a } else { 0 };
        req_walk(pcx.nodes[n as usize].a, inner_t, enc, dn, memo, out, pcx);
        return;
    }
    if k == NodeKind::TyTuple {
        for i in 0..pcx.nodes[n as usize].count {
            let et: i64 = if tk == TyKind::Tuple
                && i < pcx.types[t as usize].count { type_elem(t, i, pcx) }
                else { 0 };
            req_walk(child(n, i, pcx), et, enc, dn, memo, out, pcx);
        }
        return;
    }
    if k != NodeKind::TyName {
        return;
    }
    let nl = decl_lifetimes(dn, pcx);
    let sym = pcx.nodes[n as usize].a;
    if pcx.nodes[n as usize].list == 0 && pcx.nodes[n as usize].g == 0 {
        let i = param_index(pcx.nodes[dn as usize].g, sym, pcx);
        if i >= 0 {
            if enc != -2 {
                out.push(nl + i);
                out.push(enc);
            }
            return;
        }
        if sym_text(sym, pcx) == b"str" {
            req_push(req_lifetime(pcx.nodes[n as usize].c, dn, pcx), enc, out);
            return;
        }
    }
    if pcx.nodes[n as usize].list != 0 {
        // (a projection, `U::IntoIter`: rustc's `<U as Tr>::A: 'a`, not
        // read here)
        return;
    }
    let lts = lifetimes_of(n, pcx);
    let nlts: i64 = if lts > 0 { pcx.nodes[lts as usize].count } else { 0 };
    for i in 0..nlts {
        req_push(req_lifetime(pcx.nodes[child(lts, i, pcx) as usize].a, dn, pcx), enc, out);
    }
    let adt = t > 0 && (tk == TyKind::Struct || tk == TyKind::Enum);
    let args = pcx.nodes[n as usize].g;
    let nargs: i64 = if args > 0 { pcx.nodes[args as usize].count } else { 0 };
    for i in 0..nargs {
        let at: i64 = if adt && i < adt_targ_count(t, pcx) { adt_targ(t, i, pcx) } else { 0 };
        req_walk(child(args, i, pcx), at, enc, dn, memo, out, pcx);
    }
    if !adt {
        return;
    }
    // (the named type's own requirements, its lifetimes and parameters
    // replaced by what n writes for them)
    let mut sub = Vec::<i64, Comp>::new_in(Comp {});
    adt_reqs(t, memo, &mut sub, pcx);
    let dm = decl_lifetimes(adt_node(t, pcx), pcx);
    let mut r: i64 = 0;
    while r + 1 < sub.len() as i64 {
        let a = sub[r as usize];
        let b0 = sub[(r + 1) as usize];
        r += 2;
        let b: i64 = if b0 < 0 { -1 } else if b0 < nlts {
            req_lifetime(pcx.nodes[child(lts, b0, pcx) as usize].a, dn, pcx)
        } else { -2 };
        if b == -2 {
            continue;
        }
        if a < dm {
            if a < nlts {
                req_push(req_lifetime(pcx.nodes[child(lts, a, pcx) as usize].a, dn, pcx), b, out);
            }
        } else if a - dm < nargs && a - dm < adt_targ_count(t, pcx) {
            req_walk(child(args, a - dm, pcx), adt_targ(t, a - dm, pcx), b, dn, memo, out,
                pcx);
        }
    }
}

// decl_pairs(t, 0, 0) into out, made once per type (pcx.decl_pair_at): a
// signature's types are read again at every call of its function, and a
// type's pairs (its fields' requirements, D4.6, through every struct and
// enum they name) depend on the type alone.
pub fn decl_pairs_of(t: i64, out: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) {
    if t <= 0 {
        return;
    }
    let mut at = pcx.decl_pair_at.get(t + 1) - 1;
    if at < 0 {
        let mut pairs = Vec::<i64, Comp>::new_in(Comp {});
        decl_pairs(t, 0, 0, &mut pairs, pcx);
        at = pcx.decl_pair_store.len() as i64;
        pcx.decl_pair_store.push(pairs.len() as i64);
        for &x in pairs.as_slice() {
            pcx.decl_pair_store.push(x);
        }
        pcx.decl_pair_at.put(t + 1, at + 1);
    }
    let n = pcx.decl_pair_store[at as usize];
    for i in 0..n {
        out.push(pcx.decl_pair_store[(at + 1 + i) as usize]);
    }
}

// The declared bounds of type t (decl_pairs), whose slots are the
// universals sig.params[base..] (sig.ret[base..] when ret), as bounds of
// sig.
fn push_decl_bounds(t: i64, ret: bool, base: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let mut pairs = Vec::<i64, Comp>::new_in(Comp {});
    decl_pairs_of(t, &mut pairs, pcx);
    let n = if ret { sig.ret.len() as i64 } else { sig.params.len() as i64 };
    let mut i: i64 = 0;
    while i + 1 < pairs.len() as i64 {
        let a = base + pairs[i as usize];
        let b: i64 = if pairs[(i + 1) as usize] < 0 { -1 } else { base + pairs[(i + 1) as usize] };
        if a < n && b < n {
            let ua = if ret { sig.ret[a as usize] } else { sig.params[a as usize] };
            let ub: i64 = if b < 0 { 0 } else if ret { sig.ret[b as usize] }
                else { sig.params[b as usize] };
            sig.bounds.push(ua);
            sig.bounds.push(ub);
        }
        i += 2;
    }
}

// The universal of a closure signature position of class q
// (closure_sig_walk's), in parameter local `param` (0: the result).
fn code_universal(q: i64, param: i64, nenv: i64, sig: &mut Sig<Comp>) -> i64 {
    if q >= 0 {
        return sig.cslots[(nenv + q) as usize];
    }
    if q == -1 {
        return 0;
    }
    add_universal(U_BOUND, param, -2 - q, sig)
}

pub fn is_ref_kind(b: i64) -> bool {
    b == REF_SHARED || b == REF_MUT
}

// A struct or enum type's declaration node (its template's), type
// arguments.
pub fn adt_node(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind
        == TyKind::Struct { pcx.structs[pcx.types[t as usize].a as usize].node }
    else { enum_info(pcx.types[t as usize].a, pcx).node }
}

pub fn adt_targ_count(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind
        == TyKind::Struct { pcx.structs[pcx.types[t as usize].a as usize].targ_count }
    else { enum_info(pcx.types[t as usize].a, pcx).targ_count }
}

pub fn adt_targ(t: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let at = if pcx.types[t as usize].kind
        == TyKind::Struct { pcx.structs[pcx.types[t as usize].a as usize].targs }
        else { enum_info(pcx.types[t as usize].a, pcx).targs };
    tlist_at(at + i, pcx)
}

// The number of lifetimes item node n declares (`struct S<'a, 'b>`).
pub fn decl_lifetimes(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 {
        return 0;
    }
    let h = lifetimes_of(n, pcx);
    if h > 0 { pcx.nodes[h as usize].count } else { 0 }
}

// The number of type parameters of item node n.
fn decl_type_params(n: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 || pcx.nodes[n as usize].g <= 0 { 0 }
    else { pcx.nodes[pcx.nodes[n as usize].g as usize].count }
}

fn is_node(n: i64, k: NodeKind, pcx: &Ctx<Comp>) -> bool {
    n > 0 && pcx.nodes[n as usize].kind == k
}

// The index of the type parameter named sym in generics node g (-1).
fn param_index(g: i64, sym: i64, pcx: &Ctx<Comp>) -> i64 {
    if g <= 0 {
        return -1;
    }
    for i in 0..pcx.nodes[g as usize].count {
        if pcx.nodes[child(g, i, pcx) as usize].a == sym {
            return i;
        }
    }
    -1
}

// The index of the lifetime named sym among the lifetimes holder h's (-1).
fn lifetime_index(h: i64, sym: i64, pcx: &Ctx<Comp>) -> i64 {
    if h <= 0 || sym == 0 {
        return -1;
    }
    for i in 0..pcx.nodes[h as usize].count {
        if pcx.nodes[child(h, i, pcx) as usize].a == sym {
            return i;
        }
    }
    -1
}

// What a lifetime written as sym binds: elided (none written, `'_`),
// 'static, or the lifetime named.
pub fn lifetime_binding(sym: i64, pcx: &Ctx<Comp>) -> i64 {
    if sym == 0 {
        return B_ELIDED;
    }
    let text = sym_text(sym, pcx);
    if text == b"'_" || text == b"_" {
        B_ELIDED
    } else if text == b"'static" || text == b"static" {
        B_STATIC
    } else {
        B_NAMED
    }
}

fn push_entry(kind: i64, x: i64, y: i64, up: i64, out: &mut Vec<i64, Comp>) {
    out.push(kind);
    out.push(x);
    out.push(y);
    out.push(up);
}

fn push_lifetime(sym: i64, up: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let b = lifetime_binding(sym, pcx);
    push_entry(b, if b == B_NAMED { sym } else { 0 }, 0, up, out);
}

// RULE: D4.2 (the parallel walk) The slots of type t read with the AST
// type node n (0: none, or a node of another shape: every slot elided),
// four words each pushed to out: the binding (B_*), its x and y, and the
// entry (index of out's) of the reference or view whose pointee holds it
// (-1: none; D4.5's implied bounds). tps is the generics node of the type
// parameters in scope; self_node the type `Self` names (0: none).
pub fn bind_walk(n0: i64, t: i64, tps: i64, self_node: i64, up: i64, out: &mut Vec<i64, Comp>,
    depth: i64, pcx: &Ctx<Comp>, f: i64) {
    // (0.30.1: no depth cut-off, as slots_in has none: the walk is of a
    // finite type and type node, and its entries must be slots_in's)
    if t <= 0 {
        return;
    }
    if f == F_NEST && proj_node(n0, pcx) {
        for _ in 0..slot_count(t, pcx) {
            push_entry(B_NEST, n0, t, up, out);
        }
        return;
    }
    if f >= 0 && omega_proj(n0, t, tps, up, out, depth, f, pcx) {
        return;
    }
    if proj_walk(n0, t, tps, self_node, up, out, depth, f, pcx) {
        return;
    }
    if f == F_MARK && proj_shape(n0, pcx) {
        for j in 0..slot_count(t, pcx) {
            push_entry(B_PROJ, 0, j, up, out);
        }
        return;
    }
    let mut n = n0;
    if is_node(n, NodeKind::TyName, pcx) && pcx.nodes[n as usize].list == 0
        && pcx.nodes[n as usize].g == 0 {
        let k = param_index(tps, pcx.nodes[n as usize].a, pcx);
        if k >= 0 {
            // RULE: D4.4 (a type parameter's substitution: its slots)
            for j in 0..slot_count(t, pcx) {
                push_entry(B_PARAM, k, j, up, out);
            }
            return;
        }
        if f >= 0 && sym_text(pcx.nodes[n as usize].a, pcx) == b"Self"
            && !self_is_type(self_node, pcx) {
            // RULE: D4.6 (c) (`Self` in a trait's default method: a type
            // parameter, its substitution's slots, the U_SUBST of `Self`)
            for j in 0..slot_count(t, pcx) {
                push_entry(B_SELF, pcx.nodes[n as usize].a, j, up, out);
            }
            return;
        }
        if self_node > 0 && sym_text(pcx.nodes[n as usize].a, pcx) == b"Self" {
            n = self_node;
            // RULE: D4.4 (`Self` a type parameter, `impl<I: Iterator>
            // IntoIterator for I`: its substitution's slots, as `I`'s)
            if is_node(n, NodeKind::TyName, pcx) && pcx.nodes[n as usize].list == 0
                && pcx.nodes[n as usize].g == 0 {
                let ks = param_index(tps, pcx.nodes[n as usize].a, pcx);
                if ks >= 0 {
                    for j in 0..slot_count(t, pcx) {
                        push_entry(B_PARAM, ks, j, up, out);
                    }
                    return;
                }
            }
            // RULE: D4.6 (b) (an elided lifetime of the impl's header, `impl Ord
            // for str`, is the impl's own lifetime: the same at every `Self`
            // of the signature, slot j of Self the U_SUBST of `Self`'s j)
            let mut head = Vec::<i64, Comp>::new_in(Comp {});
            bind_walk(n, t, tps, 0, -1, &mut head, depth + 1, pcx, f);
            let at = out.len() as i64 / 4;
            for e in 0..head.len() as i64 / 4 {
                let u = head[(4 * e + 3) as usize];
                let up2 = if u >= 0 { at + u } else { up };
                if head[(4 * e) as usize] == B_ELIDED {
                    push_entry(B_SELF, pcx.nodes[n0 as usize].a, e, up2, out);
                } else {
                    push_entry(head[(4 * e) as usize], head[(4 * e + 1) as usize],
                        head[(4 * e + 2) as usize], up2, out);
                }
            }
            return;
        }
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr {
        let ast: i64 = if is_node(n, NodeKind::TyPtr, pcx) { pcx.nodes[n as usize].a } else { 0 };
        if is_ref_kind(pcx.types[t as usize].b) {
            let me = out.len() as i64 / 4;
            let lt: i64 = if is_node(n, NodeKind::TyPtr, pcx)
                && (pcx.nodes[n as usize].p & NODE_REF) != 0 {
                pcx.nodes[n as usize].c
            } else { 0 };
            push_lifetime(lt, up, out, pcx);
            bind_walk(ast, pcx.types[t as usize].a, tps, self_node, me, out, depth + 1, pcx, f);
        } else {
            bind_walk(ast, pcx.types[t as usize].a, tps, self_node, up, out, depth + 1, pcx, f);
        }
        return;
    }
    if k == TyKind::Slice && pcx.types[t as usize].b == REF_RAW {
        // RULE: Z9.1 (a fat raw pointer: no region of its own)
        // (written `*const [T]`: a TyPtr over the TySlice)
        let sn = if is_node(n, NodeKind::TyPtr, pcx) { pcx.nodes[n as usize].a } else { n };
        let ast: i64 = if is_node(sn, NodeKind::TySlice, pcx) { pcx.nodes[sn as usize].a }
            else { 0 };
        bind_walk(ast, pcx.types[t as usize].a, tps, self_node, up, out, depth + 1, pcx, f);
        return;
    }
    if (k == TyKind::Slice || k == TyKind::Distinct) && is_node(n, NodeKind::TyPtr, pcx)
        && (pcx.nodes[n as usize].p & NODE_REF) != 0
        && (pcx.nodes[n as usize].p & NODE_REF_MUT) == 0 {
        // RULE: D4.6 (b) (`&'a T` with T a view, `str`: the reference to it
        // is the view T copied out, its slots T's)
        let mut a = pcx.nodes[n as usize].a;
        if self_node > 0 && is_node(a, NodeKind::TyName, pcx)
            && sym_text(pcx.nodes[a as usize].a, pcx) == b"Self" {
            a = self_node;
        }
        let pk: i64 = if is_node(a, NodeKind::TyName, pcx) && pcx.nodes[a as usize].list == 0
            && pcx.nodes[a as usize].g == 0 { param_index(tps, pcx.nodes[a as usize].a, pcx) }
            else { -1 };
        let targ: i64 = if pk >= 0 && f >= 0 { crate::places::front::fn_targ(f, pk, pcx) }
            else { 0 };
        if targ > 0 && pcx.types[targ as usize].kind == TyKind::Unsized {
            // RULE: Z9.1c (0.27.5: T the unsized place, `&'a T` the view:
            // its region the reference's, written or elided, and T's
            // slots, the elements', under it; not T's own)
            let me = out.len() as i64 / 4;
            push_lifetime(pcx.nodes[n as usize].c, up, out, pcx);
            for j in 1..slot_count(t, pcx) {
                push_entry(B_PARAM, pk, j - 1, me, out);
            }
            return;
        }
        if pk >= 0 {
            let at = out.len() as i64;
            bind_walk(a, t, tps, self_node, up, out, depth + 1, pcx, f);
            if out.len() as i64 > at && out[at as usize] == B_PARAM {
                out[at as usize] = B_PARAM_REF;
            }
            return;
        }
    }
    if k == TyKind::Slice {
        // RULE: D4.6 (b) (`&self` on `impl<T> [T]`: `&'s Self`, a view whose
        // element is T's slots, under 's)
        let (vn, vlt) = view_node(n, self_node, pcx);
        let me = out.len() as i64 / 4;
        let slice = is_node(vn, NodeKind::TySlice, pcx);
        push_lifetime(if vlt != 0 { vlt } else if slice { pcx.nodes[vn as usize].c } else { 0 }, up,
            out, pcx);
        bind_walk(if slice { pcx.nodes[vn as usize].a } else { 0 }, pcx.types[t as usize].a, tps,
            self_node, me, out, depth + 1, pcx, f);
        return;
    }
    if k == TyKind::Distinct {
        // (`str`: a view of bytes; its lifetime is its TyName's c, the
        // parser's for `&'a str`; `&self` on `impl str` the reference's)
        let u = pcx.types[t as usize].a;
        if u > 0 && pcx.types[u as usize].kind == TyKind::Slice
            && pcx.types[u as usize].b != REF_RAW {
            let (vn, vlt) = view_node(n, self_node, pcx);
            let named = is_node(vn, NodeKind::TyName, pcx)
                && sym_text(pcx.nodes[vn as usize].a, pcx) == b"str";
            let me = out.len() as i64 / 4;
            push_lifetime(if vlt != 0 { vlt } else if named { pcx.nodes[vn as usize].c } else { 0 },
                up, out, pcx);
            bind_walk(0, pcx.types[u as usize].a, tps, self_node, me, out, depth + 1, pcx, f);
        } else {
            bind_walk(0, u, tps, self_node, up, out, depth + 1, pcx, f);
        }
        return;
    }
    if k == TyKind::Array {
        let ast: i64 = if is_node(n, NodeKind::TyArray, pcx) { pcx.nodes[n as usize].a } else { 0 };
        bind_walk(ast, pcx.types[t as usize].a, tps, self_node, up, out, depth + 1, pcx, f);
        return;
    }
    if k == TyKind::Tuple {
        let tuple = is_node(n, NodeKind::TyTuple, pcx);
        for i in 0..pcx.types[t as usize].count {
            let ast: i64 = if tuple && i < pcx.nodes[n as usize].count { child(n, i, pcx) }
                else { 0 };
            bind_walk(ast, type_elem(t, i, pcx), tps, self_node, up, out, depth + 1, pcx, f);
        }
        return;
    }
    if k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        let s = pcx.types[t as usize].a;
        for i in 0..struct_field_count(s, pcx) {
            if capture_ref(s, i, pcx) {
                // (a by-reference capture: its loan's slot, elided, D10.2)
                let me = out.len() as i64 / 4;
                push_lifetime(0, up, out, pcx);
                bind_walk(0, pcx.types[struct_field_ty(s, i, pcx) as usize].a, tps, self_node, me,
                    out, depth + 1, pcx, f);
                continue;
            }
            bind_walk(0, struct_field_ty(s, i, pcx), tps, self_node, up, out, depth + 1, pcx, f);
        }
        // RULE: D19.1 (X_C: no AST; under `&'e C` each outlives 'e, D19.4)
        for _ in 0..xc_count(s, pcx) {
            push_entry(B_ELIDED, 0, 0, up, out);
        }
        return;
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let name = is_node(n, NodeKind::TyName, pcx);
        let lts: i64 = if name { lifetimes_of(n, pcx) } else { 0 };
        for i in 0..decl_lifetimes(adt_node(t, pcx), pcx) {
            let sym: i64 = if lts > 0
                && i < pcx.nodes[lts as usize].count { pcx.nodes[child(lts, i, pcx) as usize].a }
                else { 0 };
            push_lifetime(sym, up, out, pcx);
        }
        let args: i64 = if name { pcx.nodes[n as usize].g } else { 0 };
        for i in 0..adt_targ_count(t, pcx) {
            let ast: i64 = if args > 0 && i < pcx.nodes[args as usize].count { child(args, i, pcx) }
                else { 0 };
            bind_walk(ast, adt_targ(t, i, pcx), tps, self_node, up, out, depth + 1, pcx, f);
        }
    }
}

// A view's type node n as bind_walk reads it: a `&'s Self` (`&self` on
// `impl<T> [T]` or `impl str`) is Self's node, with 's (0: elided) as the
// view's lifetime, a `&'s [T]` or `&'s str` the view's; any other node
// is itself, with 0.
fn view_node(n: i64, self_node: i64, pcx: &Ctx<Comp>) -> (i64, i64) {
    if !is_node(n, NodeKind::TyPtr, pcx) || (pcx.nodes[n as usize].p & NODE_REF) == 0 {
        return (n, 0);
    }
    let a = pcx.nodes[n as usize].a;
    if self_node > 0 && is_node(a, NodeKind::TyName, pcx)
        && sym_text(pcx.nodes[a as usize].a, pcx) == b"Self" {
        return (self_node, pcx.nodes[n as usize].c);
    }
    // (`&'a T` with T a view is that view: T's, not read here)
    if is_node(a, NodeKind::TySlice, pcx)
        || is_node(a, NodeKind::TyName, pcx) && sym_text(pcx.nodes[a as usize].a, pcx) == b"str" {
        return (a, pcx.nodes[n as usize].c);
    }
    (n, 0)
}

// Whether node s, a function's `Self` (its node's h), is a type written in
// an impl's header (not none, a trait, or `Self` again: a trait's default
// method, where Self is a type parameter).
fn self_is_type(s: i64, pcx: &Ctx<Comp>) -> bool {
    if s <= 0 {
        return false;
    }
    let k = pcx.nodes[s as usize].kind;
    if k == NodeKind::TyName {
        return sym_text(pcx.nodes[s as usize].a, pcx) != b"Self";
    }
    k == NodeKind::TyPtr || k == NodeKind::TySlice || k == NodeKind::TyArray
        || k == NodeKind::TyTuple || k == NodeKind::TyFn
}

// RULE: D4.6 (b) (0.30.1, RT-35) Whether region r of the body of function
// f is a universal of an elided lifetime of its impl's header (`impl<'b,
// U> V<'b, &str, U>`): a U_SUBST of `Self` in a function whose `Self` is a
// type (self_is_type). It is the impl's own lifetime, not a region of a
// type argument's substitution, so D4.4 (g) does not leave a flow of it to
// the opaque instance (whose Self holds it too, and which would not check
// it either).
pub fn impl_header_universal(r: i64, f: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> bool {
    if r <= 0 || f < 0 || region_word(r, 0, pbody) != U_SUBST
        || sym_text(region_word(r, 1, pbody), pcx) != b"Self" {
        return false;
    }
    let node = fn_node(crate::places::front::fn_template(f, pcx), pcx);
    node > 0 && self_is_type(pcx.nodes[node as usize].h, pcx)
}

// RULE: D4.4, O-M1 (a projection `I::Item`, `Self::Item`, `<C as
// IntoIterator>::Item` of instance f's signature: the associated type the
// impl front::obligations::select chose for the base's substitution S
// defines, read with that impl's lifetimes and parameters, each of its
// slots the slot of S it names, as rustc's normalization does; true when
// written to out, false: not a projection f's walk reads.) (0.30.2, RT-211
// review 2: the normalization is warm_projections', made before the walk
// with the one chooser, nested projections of the impl's values too; read
// here. A projection it did not normalize is every region of its base one
// (B_TIED), never elided and never an impl picked by the name.)
fn proj_walk(n: i64, t: i64, tps: i64, self_node: i64, up: i64, out: &mut Vec<i64, Comp>,
    depth: i64, f: i64, pcx: &Ctx<Comp>) -> bool {
    if f < 0 || !proj_node(n, pcx) {
        return false;
    }
    let qpath = (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0;
    let first: i64 = if qpath { 0 } else { child(n, 0, pcx) };
    let is_self = !qpath && sym_text(pcx.nodes[first as usize].a, pcx) == b"Self";
    if is_self {
        if self_node <= 0 {
            return false;
        }
        // (0.30.1: `Self::A` in the impl the function is in is its own
        // definition, first, read in this signature's terms; so also for a
        // template, which has no self type: places::impl_regions)
        let c = own_assoc(pcx.nodes[n as usize].a, self_node, pcx);
        if c != 0 {
            bind_walk(pcx.nodes[c as usize].b, t, tps, self_node, up, out, depth + 1, pcx, f);
            return true;
        }
    }
    let count = slot_count(t, pcx);
    let row = pcx.proj_sel_at.get(norm_key(f, n)) - 1;
    if row >= 0 && pcx.proj_sel[row as usize] == count {
        replay(row, up, out, pcx);
        return true;
    }
    // (a projection of a parameter warm_projections did not see: its
    // substitution's regions one)
    let k: i64 = if qpath || is_self { -1 }
        else { param_index(tps, pcx.nodes[first as usize].a, pcx) };
    let g = if k >= 0 { pcx.proj_sel_at.get(norm_key(f, NORM_PARAM + k)) - 1 } else { -1 };
    if g < 0 {
        return false;
    }
    for _ in 0..count {
        push_entry(B_TIED, g, 0, up, out);
    }
    true
}

// Whether type node n is a projection's: `P::A`, `Self::A`, `<X as Tr>::A`.
fn proj_node(n: i64, pcx: &Ctx<Comp>) -> bool {
    proj_shape(n, pcx)
        || is_node(n, NodeKind::TyName, pcx)
        && (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0
}

// (0.30.2, RT-211 review 2) Keys of Ctx.proj_sel_at for instance f
// (warm_projections): its projection at node n; NORM_PARAM + k, the
// entries of its type parameter k's slots; node 0, f warmed.
const NORM_PARAM: i64 = 1 << 31;

fn norm_key(f: i64, n: i64) -> i64 {
    ((f + 1) << 32) + n
}

// Walk entries w kept in Ctx.proj_sel as a row, their count first; its
// index.
fn store_row(w: &Vec<i64, Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let row = pcx.proj_sel.len() as i64;
    pcx.proj_sel.push(w.len() as i64 / 4);
    for x in w.iter() {
        pcx.proj_sel.push(*x);
    }
    row
}

// Row's entries pushed to out, each reference's index moved by where they
// start and the outermost's `up`.
fn replay(row: i64, up: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let at = out.len() as i64 / 4;
    for e in 0..pcx.proj_sel[row as usize] {
        let p = row + 1 + 4 * e;
        let u = pcx.proj_sel[(p + 3) as usize];
        push_entry(pcx.proj_sel[p as usize], pcx.proj_sel[(p + 1) as usize],
            pcx.proj_sel[(p + 2) as usize], if u >= 0 { at + u } else { up }, out);
    }
}

// One B_TIED entry per slot of t: every region of base's entries one.
fn push_tied(base: &Vec<i64, Comp>, t: i64, up: i64, out: &mut Vec<i64, Comp>,
    pcx: &mut Ctx<Comp>) {
    let row = store_row(base, pcx);
    for _ in 0..slot_count(t, pcx) {
        push_entry(B_TIED, row, 0, up, out);
    }
}

// RULE: D4.4 (0.30.2, RT-211 review 2) The universal of a B_TIED entry:
// the regions of row's entries made one, its first; -1 when they name
// none (the base has no region: the slot is one of its own).
fn tied_universal(row: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &Ctx<Comp>) -> i64 {
    // (0.30.2, test-only: VOLE_PLANT_OBLIG=untied, tests/refactor/oblig0302.t)
    if pcx.plant_oblig == 4 {
        return -1;
    }
    let count = pcx.proj_sel[row as usize];
    let mut w = Vec::<i64, Comp>::new_in(Comp {});
    for e in 0..4 * count {
        w.push(pcx.proj_sel[(row + 1 + e) as usize]);
    }
    let mut first: i64 = -1;
    for e in 0..count {
        let u = if w[(4 * e) as usize] == B_OUTER {
            add_universal(U_OUTER, w[(4 * e + 1) as usize], 0, sig)
        } else { walk_universal(&w, e, tps, sig, pcx) };
        if u < 0 {
            continue;
        }
        if first < 0 {
            first = u;
        } else {
            tie_universals(first, u, sig);
        }
    }
    first
}

// RULE: D4.4, O-M1 (0.30.2, RT-211 review 2) Every projection of instance
// f's signature (node: its item; its parameters', its result's, its
// bounds' and its `where` predicates'), inner ones first, normalized
// before the walk by the impl select chose for its whole reference, the
// impl's own projections normalized again the same way (norm_node), kept
// in Ctx.proj_sel for proj_walk, which has no `&mut Ctx`; and the entries
// of each type parameter's slots, the base of a projection not seen here.
fn warm_projections(f: i64, tps: i64, self_node: i64, node: i64, pcx: &mut Ctx<Comp>) {
    if f < 0 || pcx.proj_sel_at.get(norm_key(f, 0)) > 0 {
        return;
    }
    pcx.proj_sel_at.put(norm_key(f, 0), 1);
    for k in 0..instance_arity(f, tps, pcx) {
        let s = tlist_at(pcx.fns[f as usize].targs + k, pcx);
        let mut w = Vec::<i64, Comp>::new_in(Comp {});
        for j in 0..(if s > 0 { slot_count(s, pcx) } else { 0 }) {
            push_entry(B_PARAM, k, j, -1, &mut w);
        }
        let row = store_row(&w, pcx);
        pcx.proj_sel_at.put(norm_key(f, NORM_PARAM + k), row + 1);
    }
    for i in 0..pcx.nodes[node as usize].count {
        let pn = child(node, i, pcx);
        if is_node(pn, NodeKind::Param, pcx) {
            warm_node(pcx.nodes[pn as usize].b, f, tps, self_node, 0, pcx);
        }
    }
    warm_node(pcx.nodes[node as usize].b, f, tps, self_node, 0, pcx);
    for k in 0..(if tps > 0 { pcx.nodes[tps as usize].count } else { 0 }) {
        warm_bounds(pcx.nodes[child(tps, k, pcx) as usize].h, f, tps, self_node, 0, pcx);
    }
    let mut next = crate::front::traits::wp_start(node, pcx);
    while next >= 0 {
        let k = next;
        next = crate::front::traits::wp_after(k, pcx);
        warm_node(pcx.where_preds[k as usize].subject, f, tps, self_node, 0, pcx);
        warm_bounds(pcx.where_preds[k as usize].bounds, f, tps, self_node, 0, pcx);
    }
}

// warm_node of each bound of holder h: its arguments, its associated-type
// constraints' values, a function bound's parts.
fn warm_bounds(h: i64, f: i64, tps: i64, self_node: i64, depth: i64, pcx: &mut Ctx<Comp>) {
    for bi in 0..(if h > 0 { pcx.nodes[h as usize].count } else { 0 }) {
        let b = child(h, bi, pcx);
        if is_node(b, NodeKind::TyName, pcx) {
            warm_args(b, f, tps, self_node, depth, pcx);
        } else {
            warm_node(b, f, tps, self_node, depth, pcx);
        }
    }
}

fn warm_args(b: i64, f: i64, tps: i64, self_node: i64, depth: i64, pcx: &mut Ctx<Comp>) {
    let g = pcx.nodes[b as usize].g;
    for i in 0..(if g > 0 { pcx.nodes[g as usize].count } else { 0 }) {
        warm_node(child(g, i, pcx), f, tps, self_node, depth + 1, pcx);
    }
    let holder = pcx.nodes[b as usize].h;
    for ci in 0..(if holder > 0 { pcx.nodes[holder as usize].count } else { 0 }) {
        let c = child(holder, ci, pcx);
        if is_node(c, NodeKind::AssocType, pcx) {
            warm_node(pcx.nodes[c as usize].b, f, tps, self_node, depth + 1, pcx);
        }
    }
}

// The projections in type node n, inner ones first (warm_projections).
fn warm_node(n: i64, f: i64, tps: i64, self_node: i64, depth: i64, pcx: &mut Ctx<Comp>) {
    if n <= 0 || depth > 64 {
        return;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::TyName {
        if (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0 {
            warm_node(child(n, 0, pcx), f, tps, self_node, depth + 1, pcx);
            let tn = pcx.nodes[n as usize].c;
            if is_node(tn, NodeKind::TyName, pcx) {
                warm_args(tn, f, tps, self_node, depth, pcx);
            }
        } else {
            warm_args(n, f, tps, self_node, depth, pcx);
        }
        if proj_node(n, pcx) {
            warm_one(n, f, tps, self_node, depth, pcx);
        }
        return;
    }
    if kind == NodeKind::TyPtr || kind == NodeKind::TySlice || kind == NodeKind::TyArray {
        warm_node(pcx.nodes[n as usize].a, f, tps, self_node, depth + 1, pcx);
        return;
    }
    if kind == NodeKind::TyTuple || kind == NodeKind::TyFn {
        for i in 0..pcx.nodes[n as usize].count {
            warm_node(child(n, i, pcx), f, tps, self_node, depth + 1, pcx);
        }
        if kind == NodeKind::TyFn {
            warm_node(pcx.nodes[n as usize].a, f, tps, self_node, depth + 1, pcx);
        }
    }
}

// Projection node n of instance f normalized and kept (warm_projections);
// `Self::A` of the impl the function is in is its own value, whose
// projections are warmed instead (proj_walk reads it).
fn warm_one(n: i64, f: i64, tps: i64, self_node: i64, depth: i64, pcx: &mut Ctx<Comp>) {
    let key = norm_key(f, n);
    if pcx.proj_sel_at.get(key) > 0 {
        return;
    }
    if (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) == 0 && self_node > 0
        && sym_text(pcx.nodes[child(n, 0, pcx) as usize].a, pcx) == b"Self" {
        let c = own_assoc(pcx.nodes[n as usize].a, self_node, pcx);
        if c != 0 {
            pcx.proj_sel_at.put(key, 0);
            warm_node(pcx.nodes[c as usize].b, f, tps, self_node, depth + 1, pcx);
            return;
        }
    }
    let t = instance_type(n, f, tps, pcx);
    if t <= 0 {
        return;
    }
    let mut w = Vec::<i64, Comp>::new_in(Comp {});
    if norm_node(n, t, f, tps, self_node, &mut w, pcx) && w.len() as i64 == 4 * slot_count(t, pcx) {
        let row = store_row(&w, pcx);
        pcx.proj_sel_at.put(key, row + 1);
    }
}

// RULE: D4.4, O-M1 (0.30.2, RT-211 review 2) The slots of projection node
// n of instance f (type t): its base's substitution S and S's slots in
// the signature (base: a parameter's, `Self`'s walk, a qualified path's
// type's walk), its trait reference whole (a bound's of the parameter,
// the trait of the impl the function is in, the qualified path's written
// one), normalized through the impl select chose (norm_proj); where none
// is chosen, every region of the base one (B_TIED). False: not one f's
// walk reads (a base that does not resolve).
fn norm_node(n: i64, t: i64, f: i64, tps: i64, self_node: i64, out: &mut Vec<i64, Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let na = instance_arity(f, tps, pcx);
    let ftargs = pcx.fns[f as usize].targs;
    let fself = pcx.fns[f as usize].self_ty;
    let name = pcx.nodes[n as usize].a;
    let mut base = Vec::<i64, Comp>::new_in(Comp {});
    let none = Vec::<i64, Comp>::new_in(Comp {});
    if (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0 {
        let xn = child(n, 0, pcx);
        let s = instance_type(xn, f, tps, pcx);
        if s <= 0 {
            return false;
        }
        bind_walk(xn, s, tps, self_node, -1, &mut base, 0, pcx, f);
        if base.len() as i64 != 4 * slot_count(s, pcx) {
            return false;
        }
        let tn = pcx.nodes[n as usize].c;
        let tr: i64 = if is_node(tn, NodeKind::TyName, pcx) {
            crate::front::traits::bound_trait(tn, pcx) } else { -1 };
        if tr >= 0 {
            let targs = crate::front::obligations::bound_ref_args(tn, tr, s,
                crate::front::modules::module_of(tn, pcx), tps, ftargs, na, fself, pcx);
            let mut argw = Vec::<i64, Comp>::new_in(Comp {});
            sig_args(tn, targs, f, tps, self_node, &mut argw, pcx);
            if norm_proj(tr, targs, name, s, &base, t, &argw, out, 0, pcx) {
                return true;
            }
        }
        push_tied(&base, t, -1, out, pcx);
        return true;
    }
    let first = pcx.nodes[child(n, 0, pcx) as usize].a;
    if sym_text(first, pcx) == b"Self" {
        if self_node <= 0 || fself <= 0 {
            return false;
        }
        bind_walk(self_node, fself, tps, 0, -1, &mut base, 0, pcx, f);
        // (the impl the function is in, by its header node: its trait)
        let mut i: i64 = -1;
        for i2 in 0..pcx.traits_impls.len() as i64 {
            if i < 0 && pcx.nodes[pcx.traits_impls[i2 as usize].node as usize].b == self_node {
                i = i2;
            }
        }
        if i >= 0 {
            let tr = pcx.traits_impls[i as usize].tr;
            let targs = crate::front::traits::impl_targs_for(i, fself, pcx);
            if norm_proj(tr, targs, name, fself, &base, t, &none, out, 0, pcx) {
                return true;
            }
        }
        push_tied(&base, t, -1, out, pcx);
        return true;
    }
    let k = param_index(tps, first, pcx);
    if k < 0 || k >= pcx.fns[f as usize].targ_count {
        return false;
    }
    let s = tlist_at(ftargs + k, pcx);
    if s <= 0 {
        return false;
    }
    for j in 0..slot_count(s, pcx) {
        push_entry(B_PARAM, k, j, -1, &mut base);
    }
    let bounds = pcx.nodes[child(tps, k, pcx) as usize].h;
    for bi in 0..(if bounds > 0 { pcx.nodes[bounds as usize].count } else { 0 }) {
        let b = child(bounds, bi, pcx);
        if !is_node(b, NodeKind::TyName, pcx) {
            continue;
        }
        let tr = crate::front::traits::bound_trait(b, pcx);
        if tr < 0 {
            continue;
        }
        let targs = crate::front::obligations::bound_ref_args(b, tr, s,
            crate::front::modules::module_of(b, pcx), tps, ftargs, na, fself, pcx);
        let mut argw = Vec::<i64, Comp>::new_in(Comp {});
        sig_args(b, targs, f, tps, self_node, &mut argw, pcx);
        if norm_proj(tr, targs, name, s, &base, t, &argw, out, 0, pcx) {
            return true;
        }
    }
    push_tied(&base, t, -1, out, pcx);
    true
}

// The walks of bound (or trait path) b's written arguments in instance f's
// signature (their types TLISTS[targs..]), one after another; none when
// one does not fit.
fn sig_args(b: i64, targs: i64, f: i64, tps: i64, self_node: i64, out: &mut Vec<i64, Comp>,
    pcx: &Ctx<Comp>) {
    let args = pcx.nodes[b as usize].g;
    if args <= 0 || targs < 0 {
        return;
    }
    for a in 0..pcx.nodes[args as usize].count {
        let ta = tlist_at(targs + a, pcx);
        let mut w = Vec::<i64, Comp>::new_in(Comp {});
        bind_walk(child(args, a, pcx), ta, tps, self_node, -1, &mut w, 0, pcx, f);
        if w.len() as i64 != 4 * slot_count(ta, pcx) {
            out.clear();
            return;
        }
        for e in 0..w.len() as i64 / 4 {
            push_entry(w[(4 * e) as usize], w[(4 * e + 1) as usize], w[(4 * e + 2) as usize], -1,
                out);
        }
    }
}

// RULE: D4.4, O-M1 (0.30.2, RT-211 review 2) The slots of `s: tr<targs>`'s
// associated type `name` (type t; s's slots base's entries, the trait
// arguments' argw's, or none), through the impl front::obligations::select
// chose for the whole reference, or for a supertrait's (rustc's
// normalization, the one chooser's); pushed to out. False, nothing pushed,
// when no impl is chosen (none, two, the limit, an Ω's Param candidate) or
// the one chosen does not define it.
fn norm_proj(tr: i64, targs: i64, name: i64, s: i64, base: &Vec<i64, Comp>, t: i64,
    argw: &Vec<i64, Comp>, out: &mut Vec<i64, Comp>, depth: i64, pcx: &mut Ctx<Comp>) -> bool {
    if tr < 0 || s <= 0 || depth > crate::front::assoc::MAX_ASSOC_DEPTH {
        return false;
    }
    let r = crate::front::obligations::select(tr, s, targs, pcx);
    if r >= 0 {
        let c = assoc_named(pcx.nodes[pcx.traits_impls[r as usize].node as usize].c, name, pcx);
        if c != 0 && pcx.nodes[c as usize].b > 0 {
            norm_value(r, pcx.nodes[c as usize].b, t, s, base, targs, argw, out, -1, depth + 1,
                pcx, &Vec::<i64, Comp>::new_in(Comp {}));
            return true;
        }
    }
    let supers = crate::front::traits::trait_supers(tr, pcx);
    let none = Vec::<i64, Comp>::new_in(Comp {});
    for k in 0..(if supers > 0 { pcx.nodes[supers as usize].count } else { 0 }) {
        let b = child(supers, k, pcx);
        if !is_node(b, NodeKind::TyName, pcx) {
            continue;
        }
        let tr2 = crate::front::traits::bound_trait(b, pcx);
        let targs2 = super_args(tr, b, s, targs, pcx);
        if norm_proj(tr2, targs2, name, s, base, t, &none, out, depth + 1, pcx) {
            return true;
        }
    }
    false
}

// RULE: D4.4, D4.6 (g) (h), O-M1 (0.30.2, RT-211 review 2) The slots of
// type node vn (type t), read in the terms of impl i chosen for `s:
// tr<targs>` (an associated type's value, a nested bound's subject or
// argument), in s's: s's slots are base's entries, the trait arguments'
// argw's (or none); pushed to out, one per slot of t (up: the outermost's
// reference). A slot the header names is base's there, 'static itself, a
// lifetime or parameter the trait arguments bind argw's there, a
// parameter only another parameter's bound binds (`type Item = T;` of
// `impl<'a, T: Copy, I: Iterator<Item = &'a T>> Iterator for Copied<I>`)
// that bound's normalized at it; a projection of the impl's (`type Item =
// (A::Item, B::Item);` of Zip's) normalized again through the impl select
// chose for it (norm_nested). The rest, all of base's regions one, never
// elided (proj_map's B_ELIDED, before).
fn norm_value(i: i64, vn: i64, t: i64, s: i64, base: &Vec<i64, Comp>, targs: i64,
    argw: &Vec<i64, Comp>, out: &mut Vec<i64, Comp>, up: i64, depth: i64, pcx: &mut Ctx<Comp>,
    extra: &Vec<i64, Comp>) {
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let header = pcx.nodes[inode as usize].b;
    let mut head = Vec::<i64, Comp>::new_in(Comp {});
    bind_walk(header, s, itps, 0, -1, &mut head, 0, pcx, -1);
    let mut val = Vec::<i64, Comp>::new_in(Comp {});
    bind_walk(vn, t, itps, header, -1, &mut val, 0, pcx, F_NEST);
    let mut iw = Vec::<i64, Comp>::new_in(Comp {});
    impl_arg_walk(i, targs, &mut iw, pcx);
    if iw.len() != argw.len() {
        iw.clear();
    }
    let at = out.len() as i64 / 4;
    let mut row: i64 = -1;
    let n = val.len() as i64 / 4;
    let mut e: i64 = 0;
    while e < n {
        let u = val[(4 * e + 3) as usize];
        let up2 = if u >= 0 { at + u } else { up };
        if val[(4 * e) as usize] == B_NEST {
            let tm = val[(4 * e + 2) as usize];
            let cnt = slot_count(tm, pcx);
            let mut sub = Vec::<i64, Comp>::new_in(Comp {});
            let ok = depth <= crate::front::assoc::MAX_ASSOC_DEPTH
                && norm_nested(i, val[(4 * e + 1) as usize], tm, s, base, &head, targs, argw,
                    &mut sub, depth + 1, pcx, extra)
                && sub.len() as i64 == 4 * cnt;
            for g in 0..cnt {
                if ok {
                    let su = sub[(4 * g + 3) as usize];
                    push_entry(sub[(4 * g) as usize], sub[(4 * g + 1) as usize],
                        sub[(4 * g + 2) as usize], if su >= 0 { at + e + su } else { up2 }, out);
                } else {
                    if row < 0 {
                        row = store_row(base, pcx);
                    }
                    push_entry(B_TIED, row, 0, up2, out);
                }
            }
            e += cnt;
            continue;
        }
        let mut one = Vec::<i64, Comp>::new_in(Comp {});
        impl_slot(i, param_kind(val[(4 * e) as usize]), val[(4 * e + 1) as usize],
            val[(4 * e + 2) as usize], s, base, &head, targs, argw, &iw, &mut one, depth, pcx,
            extra);
        if one.len() == 4 {
            push_entry(one[0], one[1], one[2], up2, out);
        } else {
            if row < 0 {
                row = store_row(base, pcx);
            }
            push_entry(B_TIED, row, 0, up2, out);
        }
        e += 1;
    }
}

// The walk of impl i's trait arguments (their types TLISTS[targs..]) in
// its terms, one after another; none when one does not fit.
fn impl_arg_walk(i: i64, targs: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let inode = pcx.traits_impls[i as usize].node;
    let tn = pcx.nodes[inode as usize].a;
    let iargs = if is_node(tn, NodeKind::TyName, pcx) { pcx.nodes[tn as usize].g } else { 0 };
    if iargs <= 0 || targs < 0 {
        return;
    }
    let itps = pcx.nodes[inode as usize].g;
    for a in 0..pcx.nodes[iargs as usize].count {
        let ta = tlist_at(targs + a, pcx);
        let mut w = Vec::<i64, Comp>::new_in(Comp {});
        bind_walk(child(iargs, a, pcx), ta, itps, pcx.nodes[inode as usize].b, -1, &mut w, 0, pcx,
            -1);
        if w.len() as i64 != 4 * slot_count(ta, pcx) {
            out.clear();
            return;
        }
        for e in 0..w.len() as i64 / 4 {
            push_entry(w[(4 * e) as usize], w[(4 * e + 1) as usize], w[(4 * e + 2) as usize], -1,
                out);
        }
    }
}

// The entry of a slot (kind, x, y) of impl i's terms in s's (norm_value's
// rules), pushed to out; nothing when no rule reads it.
fn impl_slot(i: i64, kind: i64, x: i64, y: i64, s: i64, base: &Vec<i64, Comp>,
    head: &Vec<i64, Comp>, targs: i64, argw: &Vec<i64, Comp>, iw: &Vec<i64, Comp>,
    out: &mut Vec<i64, Comp>, depth: i64, pcx: &mut Ctx<Comp>, extra: &Vec<i64, Comp>) {
    if kind == B_STATIC {
        push_entry(B_STATIC, 0, 0, -1, out);
        return;
    }
    if kind != B_NAMED && kind != B_PARAM {
        return;
    }
    let n = if head.len() < base.len() { head.len() as i64 / 4 } else { base.len() as i64 / 4 };
    for h in 0..n {
        if param_kind(head[(4 * h) as usize]) == kind && head[(4 * h + 1) as usize] == x
            && head[(4 * h + 2) as usize] == y {
            push_entry(base[(4 * h) as usize], base[(4 * h + 1) as usize],
                base[(4 * h + 2) as usize], -1, out);
            return;
        }
    }
    for h in 0..iw.len() as i64 / 4 {
        if param_kind(iw[(4 * h) as usize]) == kind && iw[(4 * h + 1) as usize] == x
            && iw[(4 * h + 2) as usize] == y && argw[(4 * h) as usize] != B_ELIDED {
            push_entry(argw[(4 * h) as usize], argw[(4 * h + 1) as usize],
                argw[(4 * h + 2) as usize], -1, out);
            return;
        }
    }
    // (a lifetime or parameter of the impl only its trait arguments or its
    // own bounds bind, given its region by the confirmation: extra's rows,
    // impl_bound_ties)
    for r in 0..extra.len() as i64 / 4 {
        if extra[(4 * r) as usize] == kind && extra[(4 * r + 1) as usize] == x
            && (kind == B_NAMED || extra[(4 * r + 2) as usize] == y)
            && extra[(4 * r + 3) as usize] >= 0 {
            push_entry(B_UNIV, extra[(4 * r + 3) as usize], 0, -1, out);
            return;
        }
    }
    if kind == B_PARAM && depth <= crate::front::assoc::MAX_ASSOC_DEPTH {
        bound_slot(i, x, y, s, base, head, targs, out, depth + 1, pcx);
    }
}

// RULE: D4.6 (h) (0.27.7; 0.30.2, RT-211 review 2) Slot j of impl i's type
// parameter q that its header does not name, bound by another parameter's
// bound `P: Tr<A = X>` where X has q: the slot of P::A, normalized through
// the impl select chose for it, at q's place in X; else (0.30.2, RT-211
// review 3) an Fn bound's output, `F: FnMut(I::Item) -> B`, read through
// the closure's own signature (fn_output_slot); pushed to out (nothing:
// none binds it).
fn bound_slot(i: i64, q: i64, j: i64, s: i64, base: &Vec<i64, Comp>, head: &Vec<i64, Comp>,
    targs: i64, out: &mut Vec<i64, Comp>, depth: i64, pcx: &mut Ctx<Comp>) {
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let header = pcx.nodes[inode as usize].b;
    let module = pcx.traits_impls[i as usize].module;
    let count: i64 = if itps > 0 { pcx.nodes[itps as usize].count } else { 0 };
    let binds = impl_binds(i, s, targs, pcx);
    let none = Vec::<i64, Comp>::new_in(Comp {});
    for q2 in 0..count {
        let bounds = pcx.nodes[child(itps, q2, pcx) as usize].h;
        if q2 == q || bounds <= 0 {
            continue;
        }
        let mut sq = header_param_type(header, s, itps, q2, 0, pcx);
        if sq <= 0 {
            sq = if binds >= 0 { tlist_at(binds + q2, pcx) } else { 0 };
        }
        if sq <= 0 {
            continue;
        }
        for bi in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, bi, pcx);
            let holder = if is_node(b, NodeKind::TyName, pcx) { pcx.nodes[b as usize].h }
                else { 0 };
            let tr = if holder > 0 { crate::front::traits::bound_trait(b, pcx) } else { -1 };
            if tr < 0 {
                continue;
            }
            for ci in 0..pcx.nodes[holder as usize].count {
                let c = child(holder, ci, pcx);
                let xn = pcx.nodes[c as usize].b;
                if !is_node(c, NodeKind::AssocType, pcx) || xn <= 0 {
                    continue;
                }
                let gt = crate::front::assoc::super_projection(tr, sq, pcx.nodes[c as usize].a,
                    pcx.nodes[c as usize].start, pcx);
                if gt <= 0 {
                    continue;
                }
                let mut xw = Vec::<i64, Comp>::new_in(Comp {});
                bind_walk(xn, gt, itps, header, -1, &mut xw, 0, pcx, -1);
                let mut p: i64 = -1;
                for e in 0..xw.len() as i64 / 4 {
                    if p < 0 && param_kind(xw[(4 * e) as usize]) == B_PARAM
                        && xw[(4 * e + 1) as usize] == q && xw[(4 * e + 2) as usize] == j {
                        p = e;
                    }
                }
                if p < 0 {
                    continue;
                }
                let mut bq = Vec::<i64, Comp>::new_in(Comp {});
                param_base(q2, sq, head, base, &mut bq, pcx);
                let targs2 = crate::front::obligations::bound_ref_args(b, tr, sq, module, itps,
                    binds, count, s, pcx);
                let mut have = Vec::<i64, Comp>::new_in(Comp {});
                if norm_proj(tr, targs2, pcx.nodes[c as usize].a, sq, &bq, gt, &none, &mut have,
                    depth + 1, pcx) && have.len() == xw.len() {
                    push_entry(have[(4 * p) as usize], have[(4 * p + 1) as usize],
                        have[(4 * p + 2) as usize], -1, out);
                    return;
                }
            }
        }
    }
    // (none: an Fn bound's output, `F: FnMut(I::Item) -> B`)
    let _ = fn_output_slot(i, q, j, s, base, head, targs, out, pcx);
}

// RULE: D4.6 (h), D19.10 (4) (0.30.2, RT-211 review 3) Slot j of impl i's
// type parameter q that only another parameter's Fn bound's output binds,
// `B` of `impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for
// Map<I, F>`, for s (its slots base's, head the header's walk of s): that
// parameter's substitution C, a closure, gives it, as rustc's
// `<C as FnOnce>::Output` does: C's signature's result at q's place in the
// bound's output is an X_C position of C (C's slot there, base's at C's
// place), 'static, or a bound region of an input (the bound's input there,
// read in s's terms as impl_fn_ties reads it); pushed to out. Whether
// found. (0.30.2 review 2 read only `P: Tr<A = X>` bounds, so B was every
// region of s one, the closure's captures too: `first(v.iter().map(|x| {
// w.len(); x }))` kept w borrowed.)
fn fn_output_slot(i: i64, q: i64, j: i64, s: i64, base: &Vec<i64, Comp>, head: &Vec<i64, Comp>,
    targs: i64, out: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let header = pcx.nodes[inode as usize].b;
    let count: i64 = if itps > 0 { pcx.nodes[itps as usize].count } else { 0 };
    let binds = impl_binds(i, s, targs, pcx);
    for q2 in 0..count {
        let bnode = if q2 == q { 0 } else { crate::front::closures::fn_bounds::fn_bound_of(itps, q2,
            pcx) };
        if bnode <= 0 {
            continue;
        }
        let mut sq = header_param_type(header, s, itps, q2, 0, pcx);
        if sq <= 0 {
            sq = if binds >= 0 { tlist_at(binds + q2, pcx) } else { 0 };
        }
        if sq <= 0 || pcx.types[sq as usize].kind != TyKind::Struct {
            continue;
        }
        let id = pcx.structs[pcx.types[sq as usize].a as usize].closure - 1;
        if id < 0 {
            continue;
        }
        let mut walk = Vec::<i64, Comp>::new_in(Comp {});
        let mut at = Vec::<i64, Comp>::new_in(Comp {});
        let mut codes = Vec::<i64, Comp>::new_in(Comp {});
        let _ = closure_sig_walk(id, pcx.closures[id as usize].exp_node,
            pcx.closures[id as usize].exp_tps, &mut walk, &mut at, &mut codes, F_MARK, 0, pcx);
        let mut read = Vec::<i64, Comp>::new_in(Comp {});
        let mut at2 = Vec::<i64, Comp>::new_in(Comp {});
        let mut codes2 = Vec::<i64, Comp>::new_in(Comp {});
        let _ = closure_sig_walk(id, bnode, itps, &mut read, &mut at2, &mut codes2, F_MARK, header,
            pcx);
        if read.len() != walk.len() || at2.len() < 2 {
            continue;
        }
        let np = at2.len() as i64 - 2;
        let mut p: i64 = -1;
        for e in at2[np as usize]..at2[(np + 1) as usize] {
            if p < 0 && param_kind(read[(4 * e) as usize]) == B_PARAM
                && read[(4 * e + 1) as usize] == q && read[(4 * e + 2) as usize] == j {
                p = e;
            }
        }
        if p < 0 {
            continue;
        }
        let x = codes[p as usize];
        if x == -1 {
            push_entry(B_STATIC, 0, 0, -1, out);
            return true;
        }
        if x >= 0 {
            let mut bq = Vec::<i64, Comp>::new_in(Comp {});
            param_base(q2, sq, head, base, &mut bq, pcx);
            let nenv = slot_count(sq, pcx) - pcx.closures[id as usize].xc_n;
            let e = nenv + x;
            if nenv < 0 || e >= bq.len() as i64 / 4 || bq[(4 * e) as usize] == B_ELIDED {
                return false;
            }
            push_entry(bq[(4 * e) as usize], bq[(4 * e + 1) as usize], bq[(4 * e + 2) as usize], -1,
                out);
            return true;
        }
        // (a bound region: the input's region the result borrows, E2)
        for e2 in 0..at2[np as usize] {
            if codes[e2 as usize] == x {
                return bound_input_slot(i, bnode, &read, &at2, e2, s, base, head, out, pcx);
            }
        }
        return false;
    }
    false
}

// The slot of entry e of read, the walk of impl i's Fn bound bnode (at:
// where each of its parts begins) in s's terms (base, head): 'static, a
// slot of an impl parameter's substitution, or of a projection of one
// normalized (param_proj); pushed to out. Whether read.
fn bound_input_slot(i: i64, bnode: i64, read: &Vec<i64, Comp>, at: &Vec<i64, Comp>, e: i64,
    s: i64, base: &Vec<i64, Comp>, head: &Vec<i64, Comp>, out: &mut Vec<i64, Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let header = pcx.nodes[inode as usize].b;
    let rb = param_kind(read[(4 * e) as usize]);
    if rb == B_STATIC {
        push_entry(B_STATIC, 0, 0, -1, out);
        return true;
    }
    if rb != B_PARAM && rb != B_PROJ {
        return false;
    }
    let np = at.len() as i64 - 2;
    let mut a: i64 = 0;
    while a + 1 < at.len() as i64 && at[(a + 1) as usize] <= e {
        a += 1;
    }
    let mut an = if a < np { child(bnode, a, pcx) } else { pcx.nodes[bnode as usize].a };
    let mut off: i64 = 0;
    while rb == B_PROJ && is_node(an, NodeKind::TyPtr, pcx)
        && (pcx.nodes[an as usize].p & crate::front::ast::NODE_REF) != 0 {
        off += 1;
        an = pcx.nodes[an as usize].a;
    }
    let mut q2: i64 = -1;
    if rb == B_PARAM {
        q2 = read[(4 * e + 1) as usize];
    } else if an > 0 && proj_shape(an, pcx) {
        q2 = param_index(itps, pcx.nodes[child(an, 0, pcx) as usize].a, pcx);
    }
    let s2: i64 = if q2 >= 0 { header_param_type(header, s, itps, q2, 0, pcx) } else { 0 };
    if s2 <= 0 {
        return false;
    }
    let mut b2 = Vec::<i64, Comp>::new_in(Comp {});
    param_base(q2, s2, head, base, &mut b2, pcx);
    let mut got = Vec::<i64, Comp>::new_in(Comp {});
    if rb == B_PARAM {
        got = b2;
    } else if !param_proj(i, q2, -1, pcx.nodes[an as usize].a, s2, &b2, &mut got, pcx) {
        return false;
    }
    let y = if rb == B_PARAM { read[(4 * e + 2) as usize] } else { e - at[a as usize] - off };
    if y < 0 || y >= got.len() as i64 / 4 || got[(4 * y) as usize] == B_ELIDED {
        return false;
    }
    push_entry(got[(4 * y) as usize], got[(4 * y + 1) as usize], got[(4 * y + 2) as usize], -1,
        out);
    true
}

// RULE: D4.6 (g), O-M1 (0.30.2, RT-211 review 2) The slots of projection
// node m (type tm) in the terms of impl i chosen for `s: tr<targs>`
// (`A::Item` of Zip's `type Item = (A::Item, B::Item)`, `<A as Tr>::K`,
// `Self::K`), in s's: its base's substitution read through the impl's
// header (A's is Zip<Iter<'a, T>, ..>'s Iter<'a, T>), its trait reference
// a bound of the parameter's (or the written one, the impl's own trait),
// normalized through the impl select chose (norm_proj); pushed to out.
// False: none chosen.
fn norm_nested(i: i64, m: i64, tm: i64, s: i64, base: &Vec<i64, Comp>, head: &Vec<i64, Comp>,
    targs: i64, argw: &Vec<i64, Comp>, out: &mut Vec<i64, Comp>, depth: i64,
    pcx: &mut Ctx<Comp>, extra: &Vec<i64, Comp>) -> bool {
    // (0.30.2, test-only: VOLE_PLANT_OBLIG=nonest, tests/refactor/oblig0302.t)
    if pcx.plant_oblig == 3 || pcx.plant_oblig == 4 {
        return false;
    }
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let header = pcx.nodes[inode as usize].b;
    let module = pcx.traits_impls[i as usize].module;
    let count: i64 = if itps > 0 { pcx.nodes[itps as usize].count } else { 0 };
    let name = pcx.nodes[m as usize].a;
    let binds = impl_binds(i, s, targs, pcx);
    if (pcx.nodes[m as usize].p & crate::front::ast::NODE_QPATH) != 0 {
        let xn = child(m, 0, pcx);
        let sx = impl_type(xn, i, s, binds, pcx);
        let tn = pcx.nodes[m as usize].c;
        if sx <= 0 || !is_node(tn, NodeKind::TyName, pcx) {
            return false;
        }
        let mut bx = Vec::<i64, Comp>::new_in(Comp {});
        norm_value(i, xn, sx, s, base, targs, argw, &mut bx, -1, depth + 1, pcx,
            extra);
        let tr = crate::front::traits::bound_trait(tn, pcx);
        let targs2 = crate::front::obligations::bound_ref_args(tn, tr, sx, module, itps, binds,
            count, s, pcx);
        let mut aw = Vec::<i64, Comp>::new_in(Comp {});
        impl_args_in(i, tn, targs2, s, base, targs, argw, &mut aw, depth, pcx,
            extra);
        return norm_proj(tr, targs2, name, sx, &bx, tm, &aw, out, depth + 1, pcx);
    }
    let first = pcx.nodes[child(m, 0, pcx) as usize].a;
    if sym_text(first, pcx) == b"Self" {
        return norm_proj(pcx.traits_impls[i as usize].tr, targs, name, s, base, tm, argw, out,
            depth + 1, pcx);
    }
    let q = param_index(itps, first, pcx);
    if q < 0 {
        return false;
    }
    let mut sq = header_param_type(header, s, itps, q, 0, pcx);
    if sq <= 0 {
        sq = if binds >= 0 { tlist_at(binds + q, pcx) } else { 0 };
    }
    if sq <= 0 {
        return false;
    }
    let mut iw = Vec::<i64, Comp>::new_in(Comp {});
    impl_arg_walk(i, targs, &mut iw, pcx);
    if iw.len() != argw.len() {
        iw.clear();
    }
    let mut bq = Vec::<i64, Comp>::new_in(Comp {});
    let mut row: i64 = -1;
    for j in 0..slot_count(sq, pcx) {
        let mut one = Vec::<i64, Comp>::new_in(Comp {});
        impl_slot(i, B_PARAM, q, j, s, base, head, targs, argw, &iw, &mut one, depth, pcx,
            extra);
        if one.len() == 4 {
            push_entry(one[0], one[1], one[2], -1, &mut bq);
        } else {
            if row < 0 {
                row = store_row(base, pcx);
            }
            push_entry(B_TIED, row, 0, -1, &mut bq);
        }
    }
    let bounds = pcx.nodes[child(itps, q, pcx) as usize].h;
    for bi in 0..(if bounds > 0 { pcx.nodes[bounds as usize].count } else { 0 }) {
        let b = child(bounds, bi, pcx);
        if !is_node(b, NodeKind::TyName, pcx) {
            continue;
        }
        let tr = crate::front::traits::bound_trait(b, pcx);
        if tr < 0 {
            continue;
        }
        let targs2 = crate::front::obligations::bound_ref_args(b, tr, sq, module, itps, binds,
            count, s, pcx);
        let mut aw = Vec::<i64, Comp>::new_in(Comp {});
        impl_args_in(i, b, targs2, s, base, targs, argw, &mut aw, depth, pcx,
            extra);
        if norm_proj(tr, targs2, name, sq, &bq, tm, &aw, out, depth + 1, pcx) {
            return true;
        }
    }
    false
}

// The written arguments of bound (or trait path) b in impl i's terms
// (their types TLISTS[targs2..]), each in s's (norm_value), one after
// another; none when targs2 is -1.
fn impl_args_in(i: i64, b: i64, targs2: i64, s: i64, base: &Vec<i64, Comp>, targs: i64,
    argw: &Vec<i64, Comp>, out: &mut Vec<i64, Comp>, depth: i64, pcx: &mut Ctx<Comp>,
    extra: &Vec<i64, Comp>) {
    let args = pcx.nodes[b as usize].g;
    if args <= 0 || targs2 < 0 {
        return;
    }
    for a in 0..pcx.nodes[args as usize].count {
        let ta = tlist_at(targs2 + a, pcx);
        let mut w = Vec::<i64, Comp>::new_in(Comp {});
        norm_value(i, child(args, a, pcx), ta, s, base, targs, argw, &mut w, -1, depth + 1, pcx,
            extra);
        for e in 0..w.len() as i64 / 4 {
            push_entry(w[(4 * e) as usize], w[(4 * e + 1) as usize], w[(4 * e + 2) as usize], -1,
                out);
        }
    }
}

// (0.30.2, RT-211 review 2) Type node n of impl i's, chosen for s (its
// parameters bound to TLISTS[binds..], `Self` s), resolved quietly: its
// type, 0 when it does not resolve (the errors it raised forgotten).
fn impl_type(n: i64, i: i64, s: i64, binds: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let count: i64 = if itps > 0 && binds >= 0 { pcx.nodes[itps as usize].count } else { 0 };
    for k in 0..count {
        if tlist_at(binds + k, pcx) <= 0 {
            return 0;
        }
    }
    let saved = crate::front::generics::env_enter(itps, binds, count, pcx);
    let saved_self = pcx.self_type;
    let saved_mod = pcx.cur_mod;
    pcx.self_type = s;
    pcx.cur_mod = crate::front::modules::module_of(n, pcx);
    let mark = crate::base::diag::errors_mark(pcx);
    let t = crate::front::check::resolve::resolve_type(n, pcx);
    let failed = crate::base::diag::errors_mark(pcx) > mark;
    crate::base::diag::errors_forget(mark, pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    crate::front::generics::env_leave(saved, pcx);
    if failed || t <= 0 || crate::front::check::has_error_type(t, pcx) { 0 } else { t }
}

// The definition (its AssocType node) of associated type `name` in the
// impl whose header is self_node, the impl a function is in: `Self::A`
// there is it, read in the function's terms; 0: none.
fn own_assoc(name: i64, self_node: i64, pcx: &Ctx<Comp>) -> i64 {
    if self_node <= 0 {
        return 0;
    }
    for i in 0..pcx.traits_impls.len() as i64 {
        let inode = pcx.traits_impls[i as usize].node;
        if pcx.nodes[inode as usize].b == self_node {
            let c = assoc_named(pcx.nodes[inode as usize].c, name, pcx);
            if c != 0 {
                return c;
            }
        }
    }
    0
}

// RULE: D4.6 (f) (a projection `P::A` or `Self::A` of instance f whose base
// is an Ω, which no impl normalizes: each slot the lifetime the Ω's bound
// `A = X` names at it (X read alone: its named lifetimes the caller's,
// B_OUTER), 'static, or a region of its own (B_FREE); true when written
// to out)
fn omega_proj(n: i64, t: i64, tps: i64, up: i64, out: &mut Vec<i64, Comp>, depth: i64, f: i64,
    pcx: &Ctx<Comp>) -> bool {
    if !proj_shape(n, pcx) {
        return false;
    }
    let first = child(n, 0, pcx);
    let mut s: i64 = 0;
    if sym_text(pcx.nodes[first as usize].a, pcx) == b"Self" {
        s = pcx.fns[f as usize].self_ty;
    } else {
        let k = param_index(tps, pcx.nodes[first as usize].a, pcx);
        if k < 0 || k >= pcx.fns[f as usize].targ_count {
            return false;
        }
        s = tlist_at(pcx.fns[f as usize].targs + k, pcx);
    }
    if s <= 0 || !crate::front::opaque::is_omega(s, pcx) {
        return false;
    }
    let x = omega_binding(s, pcx.nodes[n as usize].a, pcx);
    if x <= 0 {
        return false;
    }
    let mut w = Vec::<i64, Comp>::new_in(Comp {});
    bind_walk(x, t, 0, 0, -1, &mut w, depth + 1, pcx, -1);
    let count = slot_count(t, pcx);
    let read = w.len() as i64 == 4 * count;
    let me = out.len() as i64 / 4;
    for j in 0..count {
        let mut kind = B_FREE;
        let mut sym: i64 = 0;
        let mut u = up;
        if read {
            if w[(4 * j) as usize] == B_STATIC {
                kind = B_STATIC;
            } else if w[(4 * j) as usize] == B_NAMED {
                kind = B_OUTER;
                sym = w[(4 * j + 1) as usize];
            }
            if w[(4 * j + 3) as usize] >= 0 {
                u = me + w[(4 * j + 3) as usize];
            }
        }
        push_entry(kind, sym, j, u, out);
    }
    true
}

// The type node X of Ω s's bound `Tr<name = X>` (0: none).
fn omega_binding(s: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    let pn = pcx.types[s as usize].b;
    let bounds: i64 = if pn > 0 { pcx.nodes[pn as usize].h } else { 0 };
    if bounds <= 0 {
        return 0;
    }
    for bi in 0..pcx.nodes[bounds as usize].count {
        let b = child(bounds, bi, pcx);
        let holder: i64 = if is_node(b, NodeKind::TyName, pcx) { pcx.nodes[b as usize].h }
            else { 0 };
        if holder <= 0 {
            continue;
        }
        for ci in 0..pcx.nodes[holder as usize].count {
            let c = child(holder, ci, pcx);
            if is_node(c, NodeKind::AssocType, pcx) && pcx.nodes[c as usize].a == name
                && pcx.nodes[c as usize].b > 0 {
                return pcx.nodes[c as usize].b;
            }
        }
    }
    0
}

// Whether type node n is a projection's, `Self::Item` or `I::Item` (one
// segment before the name, no arguments, not `<T as Tr>::A`).
pub fn proj_shape(n: i64, pcx: &Ctx<Comp>) -> bool {
    is_node(n, NodeKind::TyName, pcx) && pcx.nodes[n as usize].count == 1
        && pcx.nodes[n as usize].g == 0
        && (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) == 0
        && is_node(child(n, 0, pcx), NodeKind::Ident, pcx)
}

// The associated type `name` (an AssocType node with a type) in impl
// items holder h, or 0.
pub fn assoc_named(h: i64, name: i64, pcx: &Ctx<Comp>) -> i64 {
    if h == 0 {
        return 0;
    }
    for i in 0..pcx.nodes[h as usize].count {
        let c = child(h, i, pcx);
        if is_node(c, NodeKind::AssocType, pcx) && pcx.nodes[c as usize].a == name
            && pcx.nodes[c as usize].b != 0
            && (pcx.nodes[c as usize].p & crate::front::ast::NODE_ASSOC_CONST) == 0 {
            return c;
        }
    }
    0
}

// ---- Signatures (D4.1, D4.2) ----

// A function's signature regions, Σ_f: its universals, three words each
// (U_*, x, y), universal 0 being 'static; each parameter's slots bound to
// them (parameter i's are params[param_at[i] .. param_at[i + 1]]), the
// result's (ret); bounds, pairs (a, b): a outlives b (declared, implied:
// D4.5); elision, the position of an output region E1-E3 give none (E4;
// 0: none).
pub struct Sig<A: Allocator> {
    pub univ: Vec<i64, A>,
    pub param_at: Vec<i64, A>,
    pub params: Vec<i64, A>,
    pub ret: Vec<i64, A>,
    pub bounds: Vec<i64, A>,
    pub elision: i64,
    // (0.27.2) a closure body's: its closure (-1: not one), the universal
    // of each position of slots(C) (D19.4)
    pub closure: i64,
    pub cslots: Vec<i64, A>,
    walk: Vec<i64, A>,
    // (0.30.2, RT-404) the references impl_bound_ties met in this signature,
    // rows [key length, key.., the impl found]: each is met once
    met: Vec<i64, A>,
}

pub fn sig_new() -> Sig<Comp> {
    Sig {
        univ: Vec::new_in(Comp {}),
        param_at: Vec::new_in(Comp {}),
        params: Vec::new_in(Comp {}),
        ret: Vec::new_in(Comp {}),
        bounds: Vec::new_in(Comp {}),
        elision: 0,
        closure: -1,
        cslots: Vec::new_in(Comp {}),
        walk: Vec::new_in(Comp {}),
        met: Vec::new_in(Comp {}),
    }
}

// The number of universals of sig ('static counted).
pub fn universal_count(sig: &Sig<Comp>) -> i64 {
    sig.univ.len() as i64 / 3
}

fn add_universal(kind: i64, x: i64, y: i64, sig: &mut Sig<Comp>) -> i64 {
    if kind == U_BOUND {
        // (one per bound region, whatever position names it first)
        for u in 0..universal_count(sig) {
            if sig.univ[(3 * u) as usize] == U_BOUND && sig.univ[(3 * u + 2) as usize] == y {
                return u;
            }
        }
    }
    if kind == U_NAMED || kind == U_SUBST || kind == U_OUTER {
        for u in 0..universal_count(sig) {
            if sig.univ[(3 * u) as usize] == kind && sig.univ[(3 * u + 1) as usize] == x
                && sig.univ[(3 * u + 2) as usize] == y {
                return u;
            }
        }
    }
    sig.univ.push(kind);
    sig.univ.push(x);
    sig.univ.push(y);
    universal_count(sig) - 1
}

// Function f's signature regions, into sig: made once (sig_compute),
// then copied from pcx.sig_memo. The borrow checker reads a callee's at
// every call; a signature depends on the function alone.
pub fn sig_of(f: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let mut at = pcx.sig_memo_at.get(f + 1) - 1;
    if at < 0 {
        sig_compute(f, sig, pcx);
        at = pcx.sig_memo.len() as i64;
        memo_push(&sig.univ, &mut pcx.sig_memo);
        memo_push(&sig.param_at, &mut pcx.sig_memo);
        memo_push(&sig.params, &mut pcx.sig_memo);
        memo_push(&sig.ret, &mut pcx.sig_memo);
        memo_push(&sig.bounds, &mut pcx.sig_memo);
        memo_push(&sig.cslots, &mut pcx.sig_memo);
        pcx.sig_memo.push(sig.elision);
        pcx.sig_memo.push(sig.closure);
        pcx.sig_memo_at.put(f + 1, at + 1);
        return;
    }
    memo_load(&mut sig.univ, &mut at, &pcx.sig_memo);
    memo_load(&mut sig.param_at, &mut at, &pcx.sig_memo);
    memo_load(&mut sig.params, &mut at, &pcx.sig_memo);
    memo_load(&mut sig.ret, &mut at, &pcx.sig_memo);
    memo_load(&mut sig.bounds, &mut at, &pcx.sig_memo);
    memo_load(&mut sig.cslots, &mut at, &pcx.sig_memo);
    sig.elision = pcx.sig_memo[at as usize];
    sig.closure = pcx.sig_memo[(at + 1) as usize];
}

// v's length, then its words, onto out (sig_of's memo).
fn memo_push(v: &Vec<i64, Comp>, out: &mut Vec<i64, Comp>) {
    out.push(v.len() as i64);
    for &x in v.as_slice() {
        out.push(x);
    }
}

// v from the memo's words at `at` (memo_push's), at moved past them.
fn memo_load(v: &mut Vec<i64, Comp>, at: &mut i64, memo: &[i64]) {
    v.clear();
    let n = memo[*at as usize];
    for i in 0..n {
        v.push(memo[(*at + 1 + i) as usize]);
    }
    *at += n + 1;
}

// RULE: D4.1 Function f's signature regions, into sig (sig_of: once). A rust-edition
// function's are read from its signature's lifetimes (the parallel walk,
// D4.2); any other's (std's, a closure body's: D10.5) are a universal
// per slot (E1; §12's bridge relates a std result's).
fn sig_compute(f: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    sig.univ.clear();
    sig.param_at.clear();
    sig.params.clear();
    sig.ret.clear();
    sig.bounds.clear();
    sig.elision = 0;
    sig.closure = -1;
    sig.cslots.clear();
    sig.met.clear();
    let _ = add_universal(U_STATIC, 0, 0, sig);
    // (an instance's node is a clone without its generics and lifetimes:
    // its template's is read, with the instance's types)
    let tf = crate::places::front::fn_template(f, pcx);
    let node = fn_node(tf, pcx);
    let np = fn_param_count(f, pcx);
    let cid = closure_of_fn(f, pcx);
    if cid >= 0 && pcx.closures[cid as usize].env_struct >= 0 {
        closure_sig(cid, f, sig, pcx);
        return;
    }
    if !(is_node(node, NodeKind::Fn, pcx)) {
        for i in 0..np {
            sig.param_at.push(sig.params.len() as i64);
            for j in 0..slot_count(fn_param(f, i, pcx), pcx) {
                let u = add_universal(U_ELIDED, i + 1, j, sig);
                sig.params.push(u);
            }
        }
        sig.param_at.push(sig.params.len() as i64);
        for j in 0..slot_count(fn_ret(f, pcx), pcx) {
            let u = add_universal(U_ELIDED, 0, j, sig);
            sig.ret.push(u);
        }
        return;
    }
    // (the declared lifetimes, the impl's then the function's, in order;
    // their bounds `'b: 'a` declared)
    let holders = [lifetimes_of(-node, pcx), lifetimes_of(node, pcx),
        lifetimes_of(crate::front::parser::rust::where_key(node), pcx)];
    for h in holders {
        if h > 0 {
            for i in 0..pcx.nodes[h as usize].count {
                let sym = pcx.nodes[child(h, i, pcx) as usize].a;
                if lifetime_binding(sym, pcx) == B_NAMED {
                    let _ = add_universal(U_NAMED, sym, 0, sig);
                }
            }
        }
    }
    let tps = pcx.nodes[node as usize].g;
    let self_node = pcx.nodes[node as usize].h;
    warm_projections(f, tps, self_node, node, pcx);
    let mut inputs: i64 = 0;
    let mut only: i64 = -1;
    let mut self_u: i64 = -1;
    for i in 0..np {
        let base = sig.params.len() as i64;
        sig.param_at.push(base);
        let pn: i64 = if i < pcx.nodes[node as usize].count { child(node, i, pcx) } else { 0 };
        let tn: i64 = if is_node(pn, NodeKind::Param, pcx) { pcx.nodes[pn as usize].b } else { 0 };
        let t = fn_param(f, i, pcx);
        sig.walk.clear();
        bind_walk(tn, t, tps, self_node, -1, &mut sig.walk, 0, pcx, f);
        bind_entries(i + 1, tps, sig, pcx);
        push_decl_bounds(t, false, base, sig, pcx);
        let count = sig.params.len() as i64 - base;
        for e in 0..count {
            let up = sig.walk[(4 * e + 3) as usize];
            if up >= 0 {
                // RULE: D4.5 (`&'a τ`: every region of τ outlives 'a)
                sig.bounds.push(sig.params[(base + e) as usize]);
                sig.bounds.push(sig.params[(base + up) as usize]);
            }
        }
        // RULE: D4.2 (E2 counts the lifetimes written in the inputs, elided
        // or not; a type parameter's slots are not one: `fn f<T>(a: &A, x:
        // T) -> &T` borrows from a)
        // (D4.6 (f): an Ω's projection's slots are not one either)
        for e in 0..count {
            let b = sig.walk[(4 * e) as usize];
            if b != B_PARAM && b != B_SELF && b != B_OUTER && b != B_FREE && b != B_TIED {
                if only < 0 {
                    only = sig.params[(base + e) as usize];
                }
                inputs += 1;
            }
        }
        // RULE: D4.2 (E3: `&self`'s, `&mut self`'s reference region)
        if pn > 0 && self_u < 0 && count > 0 && sym_text(pcx.nodes[pn as usize].a, pcx) == b"self"
            && (pcx.types[t as usize].kind == TyKind::Ptr && is_ref_kind(pcx.types[t as usize].b)
                || pcx.types[t as usize].kind == TyKind::Slice
                && pcx.types[t as usize].b != REF_RAW) {
            self_u = sig.params[base as usize];
        }
    }
    sig.param_at.push(sig.params.len() as i64);
    // RULE: D21.3 (0.27.2.1: an `impl Tr` result, front/opaque.vl: each
    // slot a universal that every input region outlives, Rust 2024's
    // capture of them all; no elision)
    if crate::front::opaque::is_opaque_node(pcx.nodes[node as usize].b, pcx) {
        let inputs_end = universal_count(sig);
        let n = slot_count(fn_ret(f, pcx), pcx);
        for e in 0..n {
            let u = add_universal(U_OPAQUE, 0, e, sig);
            sig.ret.push(u);
            for v in 1..inputs_end {
                sig.bounds.push(v);
                sig.bounds.push(u);
            }
        }
        // (the slots one region to the order: a relation between the hidden
        // type's slots, `Filter<Iter<'a, T>, F>`'s, holds; each its own
        // member choice, opaque_choice)
        for i in 0..n {
            for j in 0..n {
                if i != j {
                    sig.bounds.push(sig.ret[i as usize]);
                    sig.bounds.push(sig.ret[j as usize]);
                }
            }
        }
    } else {
        // the result: an elided region is E2's, E3's, else E4's error
        sig.walk.clear();
        bind_walk(pcx.nodes[node as usize].b, fn_ret(f, pcx), tps, self_node, -1, &mut sig.walk, 0,
            pcx, f);
        let n = sig.walk.len() as i64 / 4;
        for e in 0..n {
            let b = sig.walk[(4 * e) as usize];
            let mut u: i64 = 0;
            if b == B_ELIDED {
                // RULE: D4.2 (E2, E3, E4)
                if inputs == 1 {
                    u = only;
                } else if self_u >= 0 {
                    u = self_u;
                } else {
                    if sig.elision == 0 {
                        sig.elision = if pcx.nodes[node as usize].b
                            > 0 { pcx.nodes[pcx.nodes[node as usize].b as usize].start }
                            else { pcx.nodes[node as usize].start };
                    }
                    u = add_universal(U_ELIDED, 0, e, sig);
                }
            } else {
                u = entry_universal(e, -1, tps, sig, pcx);
            }
            sig.ret.push(u);
        }
        for e in 0..n {
            let up = sig.walk[(4 * e + 3) as usize];
            if up >= 0 {
                sig.bounds.push(sig.ret[e as usize]);
                sig.bounds.push(sig.ret[up as usize]);
            }
        }
        push_decl_bounds(fn_ret(f, pcx), true, 0, sig, pcx);
    }
    // RULE: D4.5 (declared: `'b: 'a` in the generics, the impl's and the
    // function's)
    for h in holders {
        if h > 0 {
            for i in 0..pcx.nodes[h as usize].count {
                let ln = child(h, i, pcx);
                let bounds = pcx.nodes[ln as usize].h;
                if bounds > 0 && lifetime_binding(pcx.nodes[ln as usize].a, pcx) == B_NAMED {
                    let a = add_universal(U_NAMED, pcx.nodes[ln as usize].a, 0, sig);
                    for j in 0..pcx.nodes[bounds as usize].count {
                        let bs = pcx.nodes[child(bounds, j, pcx) as usize].a;
                        let kind = lifetime_binding(bs, pcx);
                        if kind != B_ELIDED {
                            let b: i64 = if kind == B_STATIC { 0 }
                                else { add_universal(U_NAMED, bs, 0, sig) };
                            sig.bounds.push(a);
                            sig.bounds.push(b);
                        }
                    }
                }
            }
        }
    }
    // RULE: D4.5, D20.6 (declared `T: 'a`, in the generics or a `where`:
    // every slot of T's substitution outlives 'a; `F: 'scope` of a closure
    // type, each capture's and X_C's)
    for k in 0..(if tps > 0 { pcx.nodes[tps as usize].count } else { 0 }) {
        let p = child(tps, k, pcx);
        let sym = pcx.nodes[p as usize].a;
        let mut i: i64 = 0;
        loop {
            let lt = crate::front::parser::rust::outlives_of(p, i, pcx);
            if lt == 0 {
                break;
            }
            i += 1;
            let kind = lifetime_binding(lt, pcx);
            if kind == B_ELIDED {
                continue;
            }
            let b: i64 = if kind == B_STATIC { 0 } else { add_universal(U_NAMED, lt, 0, sig) };
            for e in 0..universal_count(sig) {
                if sig.univ[(3 * e) as usize] == U_SUBST && sig.univ[(3 * e + 1) as usize] == sym {
                    sig.bounds.push(e);
                    sig.bounds.push(b);
                }
            }
        }
    }
    // (0.30: the ties first: a closure's requirement on a slot the ties
    // name, an impl parameter only a bound gives, `T` of `impl<'a, T, I:
    // Iterator<Item = &'a T>> Iterator for Copied<I>`, finds its universal)
    bound_ties(f, tps, self_node, sig, pcx);
    subst_requirements(f, tps, sig, pcx);
}

// RULE: D19.10 (4) In an instance whose type parameter is a closure type C,
// C's requirements are bounds of the universals of its substitution
// (as a declared `'b: 'a` of a struct's would be).
fn subst_requirements(f: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &Ctx<Comp>) {
    let nt = pcx.fns[f as usize].targ_count;
    if nt <= 0 || pcx.fns[f as usize].tmpl < 0 || tps <= 0 {
        return;
    }
    for k in 0..nt {
        let t = tlist_at(pcx.fns[f as usize].targs + k, pcx);
        if t <= 0 || pcx.types[t as usize].kind != TyKind::Struct
            || k >= pcx.nodes[tps as usize].count {
            continue;
        }
        let id = pcx.structs[pcx.types[t as usize].a as usize].closure - 1;
        if id < 0 {
            continue;
        }
        let sym = pcx.nodes[child(tps, k, pcx) as usize].a;
        // RULE: D4.5 (and C's implied bounds: a capture's `&'c τ` gives
        // `'t ⊒ 'c` for τ's slots, as in the closure's own body)
        sig.walk.clear();
        bind_walk(0, t, 0, 0, -1, &mut sig.walk, 0, pcx, -1);
        for e in 0..sig.walk.len() as i64 / 4 {
            let up = sig.walk[(4 * e + 3) as usize];
            let a = find_universal(U_SUBST, sym, e, sig);
            let b: i64 = if up >= 0 { find_universal(U_SUBST, sym, up, sig) } else { -1 };
            if a >= 0 && b >= 0 {
                sig.bounds.push(a);
                sig.bounds.push(b);
            }
        }
        // RULE: D19.10 (4), D20.3 (C's signature read with this template's
        // bound of the parameter, `F: FnOnce(T) -> U` or `F: FnMut(B,
        // Self::Item) -> B`, whichever bound C was checked against: an X_C
        // position of C the bound gives a type parameter's slot, a named
        // lifetime or 'static, a projection's as this instance resolves it
        // (proj_walk), is that universal, both ways, so a requirement
        // between them, `|x| x`'s, is one between T and U, assumed here and
        // checked at the call)
        let bnode = crate::front::closures::fn_bounds::fn_bound_of(tps, k, pcx);
        if bnode > 0 {
            let mut walk = Vec::<i64, Comp>::new_in(Comp {});
            let mut at = Vec::<i64, Comp>::new_in(Comp {});
            let mut codes = Vec::<i64, Comp>::new_in(Comp {});
            let _ = closure_sig_walk(id, pcx.closures[id as usize].exp_node,
                pcx.closures[id as usize].exp_tps, &mut walk, &mut at, &mut codes, F_MARK, 0, pcx);
            let mut read = Vec::<i64, Comp>::new_in(Comp {});
            let mut at2 = Vec::<i64, Comp>::new_in(Comp {});
            let mut codes2 = Vec::<i64, Comp>::new_in(Comp {});
            let self_node = pcx.nodes[
                fn_node(crate::places::front::fn_template(f, pcx), pcx) as usize].h;
            let _ = closure_sig_walk(id, bnode, tps, &mut read, &mut at2, &mut codes2, f, self_node,
                pcx);
            let nenv = slot_count(t, pcx) - pcx.closures[id as usize].xc_n;
            if read.len() == walk.len() {
                for e in 0..codes.len() as i64 {
                    let q = codes[e as usize];
                    if q < 0 {
                        continue;
                    }
                    let rb = read[(4 * e) as usize];
                    let b: i64 = if rb == B_STATIC { 0 }
                        else if rb
                        == B_NAMED { find_universal(U_NAMED, read[(4 * e + 1) as usize], 0, sig) }
                        else if param_kind(rb) == B_PARAM
                        && read[(4 * e + 1) as usize] < pcx.nodes[tps as usize].count {
                        // (0.30: made when no parameter's type names it:
                        // `B` of `impl<B, I, F: FnMut(I::Item) -> B>
                        // Iterator for Map<I, F>`, whose slots only the
                        // bound's result gives, so map's closure result
                        // and a later closure's `Self::Item` are one)
                        add_universal(U_SUBST,
                            pcx.nodes[child(tps, read[(4 * e + 1) as usize], pcx) as usize].a,
                            read[(4 * e + 2) as usize], sig)
                    } else { -1 };
                    tie_universals(find_universal(U_SUBST, sym, nenv + q, sig), b, sig);
                }
            }
        }
        for q in 0..pcx.closures[id as usize].req_n {
            let i = pcx.capture_list[(pcx.closures[id as usize].req_at + 2 * q) as usize];
            let j = pcx.capture_list[(pcx.closures[id as usize].req_at + 2 * q + 1) as usize];
            let a = find_universal(U_SUBST, sym, i, sig);
            let b: i64 = if j < 0 { 0 } else { find_universal(U_SUBST, sym, j, sig) };
            if a >= 0 && b >= 0 {
                sig.bounds.push(a);
                sig.bounds.push(b);
            }
        }
    }
}

// RULE: D4.6 (e) Type parameter k's substitution s is well-formed, so its
// own implied bounds hold of its slots: `&'m mut Copied<Iter<'x, T>>`
// gives `'x ⊒ 'm`, and its declarations' requirements (D4.6 (a)), each
// slot the U_SUBST of k's.
fn subst_wf(k: i64, s: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    if s <= 0 {
        return;
    }
    let sym = pcx.nodes[child(tps, k, pcx) as usize].a;
    let mut w = Vec::<i64, Comp>::new_in(Comp {});
    bind_walk(0, s, 0, 0, -1, &mut w, 0, pcx, -1);
    for e in 0..w.len() as i64 / 4 {
        let up = w[(4 * e + 3) as usize];
        if up >= 0 {
            let a = add_universal(U_SUBST, sym, e, sig);
            let b = add_universal(U_SUBST, sym, up, sig);
            sig.bounds.push(a);
            sig.bounds.push(b);
        }
    }
    let mut pairs = Vec::<i64, Comp>::new_in(Comp {});
    decl_pairs_of(s, &mut pairs, pcx);
    let mut i: i64 = 0;
    while i + 1 < pairs.len() as i64 {
        let a = add_universal(U_SUBST, sym, pairs[i as usize], sig);
        let b: i64 = if pairs[(i + 1) as usize] < 0 { 0 }
            else { add_universal(U_SUBST, sym, pairs[(i + 1) as usize], sig) };
        sig.bounds.push(a);
        sig.bounds.push(b);
        i += 2;
    }
}

// RULE: D4.6 (d), F10.1, O-M1 In instance f, the predicates of its
// signature relate the regions of their types (generics tps): each type
// parameter's bounds (written inline or in a `where`), and (0.30.2,
// RT-211) every other `where` predicate, one on `Self`, a projection or
// any other type (`Self: Iterator<Item = (X, Y)>` of unzip_in), each
// subject's slots read as the signature's walk reads them, and each by
// the impl select chose for its whole reference (subject_ties). A
// predicate no tie is made of let a call keep no borrow its result holds:
// unzip_in's `FromX: Extend<X>` tied the result to X, and nothing tied X
// to the items, whose `Self: Iterator<Item = (X, Y)>` is such a predicate.
fn bound_ties(f: i64, tps: i64, self_node: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.fns[f as usize].tmpl < 0 {
        return;
    }
    for k in 0..(if tps > 0 { pcx.nodes[tps as usize].count } else { 0 }) {
        if k >= pcx.fns[f as usize].targ_count {
            break;
        }
        subst_wf(k, tlist_at(pcx.fns[f as usize].targs + k, pcx), tps, sig, pcx);
        let bounds = pcx.nodes[child(tps, k, pcx) as usize].h;
        let s = tlist_at(pcx.fns[f as usize].targs + k, pcx);
        if bounds <= 0 || s <= 0 {
            continue;
        }
        let mut base = Vec::<i64, Comp>::new_in(Comp {});
        for j in 0..slot_count(s, pcx) {
            push_entry(B_PARAM, k, j, -1, &mut base);
        }
        subject_ties(s, &base, false, bounds, tps, self_node, f, sig, pcx);
    }
    where_ties(f, tps, self_node, sig, pcx);
}

// RULE: F10.1, D4.6 (d) (0.30.2, RT-211) The `where` predicates of
// instance f's item on a subject that is no type parameter of tps
// (front/traits.vl WherePred: `Self: Iterator<Item = (X, Y)>`, `I::Item:
// Tr<..>`), as a parameter's bounds are: the subject's type in the
// instance (resolved with f's type arguments and its Self, as the front's
// where_preds_hold checks it at the call), its slots the walk of the
// subject's node against it (a `Self` of a trait's default method: the
// U_SUBST of `Self`, the `self` parameter's).
fn where_ties(f: i64, tps: i64, self_node: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let item = fn_node(crate::places::front::fn_template(f, pcx), pcx);
    if item <= 0 {
        return;
    }
    let mut next = crate::front::traits::wp_start(item, pcx);
    while next >= 0 {
        let k = next;
        next = crate::front::traits::wp_after(k, pcx);
        let subject = pcx.where_preds[k as usize].subject;
        let bounds = pcx.where_preds[k as usize].bounds;
        let s = instance_type(subject, f, tps, pcx);
        if s <= 0 {
            continue;
        }
        let mut base = Vec::<i64, Comp>::new_in(Comp {});
        bind_walk(subject, s, tps, self_node, -1, &mut base, 0, pcx, f);
        if base.len() as i64 != 4 * slot_count(s, pcx) {
            continue;
        }
        let self_subject = is_node(subject, NodeKind::TyName, pcx)
            && pcx.nodes[subject as usize].count == 0 && pcx.nodes[subject as usize].g == 0
            && sym_text(pcx.nodes[subject as usize].a, pcx) == b"Self";
        subject_ties(s, &base, self_subject, bounds, tps, self_node, f, sig, pcx);
    }
}

// (0.30.2, RT-211) Type node n of instance f's signature resolved with
// f's type arguments bound to tps and its Self, quietly: its type, 0 when
// it does not resolve (the errors it raised forgotten).
fn instance_type(n: i64, f: i64, tps: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved = crate::front::generics::env_enter(tps, pcx.fns[f as usize].targs,
        instance_arity(f, tps, pcx), pcx);
    let saved_self = pcx.self_type;
    let saved_mod = pcx.cur_mod;
    if pcx.fns[f as usize].self_ty > 0 {
        pcx.self_type = pcx.fns[f as usize].self_ty;
    }
    pcx.cur_mod = crate::front::modules::module_of(n, pcx);
    let mark = crate::base::diag::errors_mark(pcx);
    let t = crate::front::check::resolve::resolve_type(n, pcx);
    let failed = crate::base::diag::errors_mark(pcx) > mark;
    crate::base::diag::errors_forget(mark, pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    crate::front::generics::env_leave(saved, pcx);
    if failed || t <= 0 || crate::front::check::has_error_type(t, pcx) { 0 } else { t }
}

// How many of tps instance f binds.
fn instance_arity(f: i64, tps: i64, pcx: &Ctx<Comp>) -> i64 {
    if tps <= 0 {
        return 0;
    }
    if pcx.nodes[tps as usize].count < pcx.fns[f as usize].targ_count {
        pcx.nodes[tps as usize].count
    } else { pcx.fns[f as usize].targ_count }
}

// RULE: D4.6 (d), L14, O-M1 (0.30.2, RT-211) The bounds node `bounds` of
// a subject whose type in instance f is s, its slots base's entries: for
// each bound `tr<args>`, its whole reference (bound_ref_args) proved by
// the impl select chose (impl_bound_ties: the impl's own predicates, its
// trait arguments against the bound's, slot by slot, and its nested
// obligations, at every depth); and each associated-type constraint
// `Tr<A = X>`: s::A is X, each slot of s::A, normalized through that impl
// (norm_proj, in s's slots), and the same slot of X one region, both ways
// (rustc's `Extend<T>::extend<I: IntoIterator<Item = T>>` pushes an
// I::Item where a T is required). Where no one impl relates a slot, every
// region of the predicate is one (pred_regions: s's, the arguments', and
// those of each parameter a projection in them is of), more than any impl
// relates, never less and never none.
fn subject_ties(s: i64, base: &Vec<i64, Comp>, self_subject: bool, bounds: i64, tps: i64,
    self_node: i64, f: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let n = instance_arity(f, tps, pcx);
    for bi in 0..pcx.nodes[bounds as usize].count {
        let b = child(bounds, bi, pcx);
        if !is_node(b, NodeKind::TyName, pcx) {
            continue;
        }
        let holder = pcx.nodes[b as usize].h;
        let args = pcx.nodes[b as usize].g;
        let tr = crate::front::traits::bound_trait(b, pcx);
        if tr < 0 {
            continue;
        }
        // (0.30.2, obligations M1: the bound's whole reference, its
        // arguments read with the instance's types, `T: Tr<i64>`)
        let m = crate::front::modules::module_of(b, pcx);
        let targs = crate::front::obligations::bound_ref_args(b, tr, s, m, tps,
            pcx.fns[f as usize].targs, n, pcx.fns[f as usize].self_ty, pcx);
        // (a reference no one impl proves is reported at the call that
        // made the instance, else at the bound)
        let origin = pcx.fns[f as usize].origin;
        let pos = if origin > 0 { pcx.nodes[origin as usize].start }
            else { pcx.nodes[b as usize].start };
        // (the bound's written arguments, each slot's universal in f's
        // signature, -1 where the walk names none; and all the regions the
        // predicate names, for a slot no impl relates)
        let mut want = Vec::<i64, Comp>::new_in(Comp {});
        let mut wild = Vec::<i64, Comp>::new_in(Comp {});
        let mut argw = Vec::<i64, Comp>::new_in(Comp {});
        pred_regions(base, b, tps, self_node, f, sig, &mut wild, pcx);
        if args > 0 && targs >= 0 {
            for a in 0..pcx.nodes[args as usize].count {
                let t = tlist_at(targs + a, pcx);
                let mut w = Vec::<i64, Comp>::new_in(Comp {});
                bind_walk(child(args, a, pcx), t, tps, self_node, -1, &mut w, 0, pcx, f);
                if w.len() as i64 != 4 * slot_count(t, pcx) {
                    w.clear();
                    for _ in 0..slot_count(t, pcx) {
                        push_entry(B_ELIDED, 0, 0, -1, &mut w);
                    }
                }
                for e in 0..w.len() as i64 / 4 {
                    want.push(walk_universal(&w, e, tps, sig, pcx));
                    push_entry(w[(4 * e) as usize], w[(4 * e + 1) as usize],
                        w[(4 * e + 2) as usize], -1, &mut argw);
                }
            }
        }
        let _ = impl_bound_ties(s, base, tr, targs, tps, 0, 0, pos, args > 0, &want, &wild,
            sig, pcx);
        if args > 0 && targs < 0 {
            // (arguments that do not resolve here: no impl's are read)
            tie_wild(&wild, sig);
        }
        if holder <= 0 {
            continue;
        }
        for ci in 0..pcx.nodes[holder as usize].count {
            let c = child(holder, ci, pcx);
            if !is_node(c, NodeKind::AssocType, pcx) || pcx.nodes[c as usize].b <= 0 {
                continue;
            }
            let name = pcx.nodes[c as usize].a;
            let gt = crate::front::assoc::super_projection(tr, s, name, pcx.nodes[c as usize].start,
                pcx);
            if gt <= 0 {
                continue;
            }
            let mut have = Vec::<i64, Comp>::new_in(Comp {});
            bind_walk(pcx.nodes[c as usize].b, gt, tps, self_node, -1, &mut have, 0, pcx, f);
            let mut proj = Vec::<i64, Comp>::new_in(Comp {});
            // (`Self: Tr<A = X>` in the impl the function is in: `Self::A`
            // is its own definition, read in the function's terms, as
            // proj_walk reads `Self::A`; unzip_in's `Self: Iterator<Item =
            // (X, Y)>` copied into Map's impl, whose `type Item = B`; else
            // s::A normalized through the impl select chose for the bound
            // or a supertrait of it, its own projections too: Zip's
            // `(A::Item, B::Item)`, 0.30.2 RT-211 review 2)
            let own = if self_subject { own_assoc(name, self_node, pcx) } else { 0 };
            let mut read = own != 0;
            if own != 0 {
                bind_walk(pcx.nodes[own as usize].b, gt, tps, self_node, -1, &mut proj, 0, pcx, f);
            } else {
                read = norm_proj(tr, targs, name, s, base, gt, &argw, &mut proj, 0, pcx);
            }
            if !read || !tie_pairs(&proj, &have, tps, sig, pcx) {
                // (s::A not read here, or a slot of it no region of s's
                // (`type Item = B` of Map, B the closure's result): every
                // region of the predicate one)
                tie_wild(&wild, sig);
            }
        }
    }
}

// RULE: D4.6 (d) (0.30.2, RT-211 review) The universals of every region
// predicate b (a bound of a subject whose slots are base's) names: the
// subject's, its arguments' as the walk reads them, and every slot of each
// type parameter of tps (and of `Self`) its arguments mention, a
// projection's base (`C::Item`, `<C::IntoIter as Iterator>::Item`) too,
// whatever the projection is; pushed to out. The fallback where no impl
// relates a slot: tied one, it is more than any impl relates.
fn pred_regions(base: &Vec<i64, Comp>, b: i64, tps: i64, self_node: i64, f: i64,
    sig: &mut Sig<Comp>, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for e in 0..base.len() as i64 / 4 {
        out.push(walk_universal(base, e, tps, sig, pcx));
    }
    let mut ks = Vec::<i64, Comp>::new_in(Comp {});
    let args = pcx.nodes[b as usize].g;
    for i in 0..(if args > 0 { pcx.nodes[args as usize].count } else { 0 }) {
        mentioned_params(child(args, i, pcx), tps, &mut ks, 0, pcx);
    }
    let holder = pcx.nodes[b as usize].h;
    for ci in 0..(if holder > 0 { pcx.nodes[holder as usize].count } else { 0 }) {
        let c = child(holder, ci, pcx);
        if is_node(c, NodeKind::AssocType, pcx) {
            mentioned_params(pcx.nodes[c as usize].b, tps, &mut ks, 0, pcx);
        }
    }
    for k in ks {
        let mut w = Vec::<i64, Comp>::new_in(Comp {});
        if k == -2 {
            // (`Self`: its walk, as proj_walk reads it)
            let st = pcx.fns[f as usize].self_ty;
            if self_node > 0 && st > 0 {
                bind_walk(self_node, st, tps, 0, -1, &mut w, 0, pcx, f);
            }
        } else if k < pcx.fns[f as usize].targ_count {
            let sk = tlist_at(pcx.fns[f as usize].targs + k, pcx);
            for j in 0..(if sk > 0 { slot_count(sk, pcx) } else { 0 }) {
                push_entry(B_PARAM, k, j, -1, &mut w);
            }
        }
        for e in 0..w.len() as i64 / 4 {
            out.push(walk_universal(&w, e, tps, sig, pcx));
        }
    }
}

// The type parameters of tps (their indices; `Self`: -2) type node n
// mentions anywhere (as front::coherence::mentions_param reads a node): a
// path's first segment (`C::Item`), a qualified path's type, a type
// argument, a pointee, an element, a function type's parts; pushed to ks
// once each.
fn mentioned_params(n: i64, tps: i64, ks: &mut Vec<i64, Comp>, depth: i64, pcx: &Ctx<Comp>) {
    if n <= 0 || depth > 64 {
        return;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::TyName {
        let first = if pcx.nodes[n as usize].count > 0 { pcx.nodes[child(n, 0, pcx) as usize].a }
            else { pcx.nodes[n as usize].a };
        let q = if sym_text(first, pcx) == b"Self" { -2 } else { param_index(tps, first, pcx) };
        if q >= 0 || q == -2 {
            let mut seen = false;
            for k in ks.iter() {
                seen = seen || *k == q;
            }
            if !seen {
                ks.push(q);
            }
        }
        if (pcx.nodes[n as usize].p & crate::front::ast::NODE_QPATH) != 0 {
            mentioned_params(child(n, 0, pcx), tps, ks, depth + 1, pcx);
        }
        let g = pcx.nodes[n as usize].g;
        for i in 0..(if g > 0 { pcx.nodes[g as usize].count } else { 0 }) {
            mentioned_params(child(g, i, pcx), tps, ks, depth + 1, pcx);
        }
        return;
    }
    if kind == NodeKind::TyPtr || kind == NodeKind::TySlice || kind == NodeKind::TyArray {
        mentioned_params(pcx.nodes[n as usize].a, tps, ks, depth + 1, pcx);
        return;
    }
    if kind == NodeKind::TyTuple || kind == NodeKind::TyFn {
        for i in 0..pcx.nodes[n as usize].count {
            mentioned_params(child(n, i, pcx), tps, ks, depth + 1, pcx);
        }
        if kind == NodeKind::TyFn {
            mentioned_params(pcx.nodes[n as usize].a, tps, ks, depth + 1, pcx);
        }
    }
}

// Every universal of w one region (the ones that name none skipped).
fn tie_wild(w: &Vec<i64, Comp>, sig: &mut Sig<Comp>) {
    let mut first: i64 = -1;
    for u in w {
        if *u < 0 {
            continue;
        }
        if first < 0 {
            first = *u;
        } else {
            tie_universals(first, *u, sig);
        }
    }
}

// (0.30.2, RT-211) Walks a and b of one type, slot by slot: when each slot
// names a universal on both sides or on neither, the pairs are made one
// region and true; else false (the caller ties more).
fn tie_pairs(a: &Vec<i64, Comp>, b: &Vec<i64, Comp>, tps: i64, sig: &mut Sig<Comp>,
    pcx: &Ctx<Comp>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let n = a.len() as i64 / 4;
    for e in 0..n {
        let ua = walk_universal(a, e, tps, sig, pcx);
        let ub = walk_universal(b, e, tps, sig, pcx);
        if (ua < 0) != (ub < 0) {
            return false;
        }
    }
    for e in 0..n {
        tie_universals(walk_universal(a, e, tps, sig, pcx), walk_universal(b, e, tps, sig, pcx),
            sig);
    }
    true
}

// RULE: L14 (0.30.2, RT-404) confirm_bound, once per reference in a
// signature: a reference met again with the same inputs (the trait, s, its
// arguments, its slots' entries, the bound's written arguments' universals
// and the predicate's, wild, the type parameters s is read in) gives the same ties, so it is not met again
// and the impl first found is returned (Sig.met). Without it two bounds
// per level, `impl<T: Tr + Tr2> Tr for W<T>`, met W's nested 26 deep 2^26
// times.
fn impl_bound_ties(s: i64, base: &Vec<i64, Comp>, tr: i64, targs: i64, tps: i64, depth: i64,
    sup: i64, pos: i64, written: bool, want: &Vec<i64, Comp>, wild: &Vec<i64, Comp>,
    sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut key = Vec::<i64, Comp>::new_in(Comp {});
    key.push(tr);
    key.push(s);
    key.push(targs);
    key.push(if written { 1 } else { 0 });
    key.push(sup);
    key.push(tps);
    for x in base.iter() {
        key.push(*x);
    }
    key.push(-9);
    for x in want.iter() {
        key.push(*x);
    }
    key.push(-9);
    for x in wild.iter() {
        key.push(*x);
    }
    let mut r: i64 = 0;
    while r < sig.met.len() as i64 {
        let n = sig.met[r as usize];
        if n == key.len() as i64 {
            let mut same = true;
            for k in 0..n {
                if same && sig.met[(r + 1 + k) as usize] != key[k as usize] {
                    same = false;
                }
            }
            if same {
                let got = sig.met[(r + 1 + n) as usize];
                if got == -2 {
                    // (met again while it is being met: the cycle the depth
                    // limit ended before, its error; a limit is never a yes)
                    obligation_error(true, false, tr, s, pos, pcx);
                    return -1;
                }
                return got;
            }
        }
        r += n + 2;
    }
    // (-2 while it is being met)
    let at = sig.met.len() as i64;
    sig.met.push(key.len() as i64);
    for x in key.iter() {
        sig.met.push(*x);
    }
    sig.met.push(-2);
    let found = confirm_bound(s, base, tr, targs, tps, depth, sup, pos, written, want, wild, sig,
        pcx);
    sig.met[(at + 1 + key.len() as i64) as usize] = found;
    found
}

// RULE: L14, D4.6 (d), O-M1 (0.27.3; 0.30.2 obligations M1; 0.30.2, RT-211
// review: rustc's confirmation) A substitution s (its slots base's
// entries) meets a bound's trait reference `tr<targs>` through the impl the
// front's selection chose for it (chosen: by the whole reference, its
// trait arguments too, never again here), returned (-1: none), whose
// instance assumes the impl's own predicates and equality bounds: they
// hold of s's slots too (`impl<A: Iterator, B: Iterator<Item = A::Item>>
// Iterator for Chain<A, B>`: `B::Item`'s and `A::Item`'s slot by slot one
// region, both ways); and so on for the impls its parameters'
// substitutions meet their bounds by (`Rev<Chain<..>>`'s `I:
// DoubleEndedIterator`, Chain's impl of it), each by its own whole
// reference. With `written` (the bound names its arguments), the impl's
// trait arguments and the bound's are one type slot by slot: want holds
// the universal of each slot of the bound's (-1: none named), and each
// slot of the impl's is the region the impl's header gives it, 'static
// (`impl Conv<W<'static>> for i64` met by `T: Conv<W<'a>>`: 'a is
// 'static), or a lifetime of the impl's that its header does not name
// (`impl<'a, T: Copy> Extend<&'a T> for Vec<T>`: bound to the bound's slot,
// for the impl's predicates, and related to nothing else); a slot only one
// side names makes the predicate's regions, wild, one. The impl's nested
// obligations are met the same way, their arguments read in the impl's
// terms (impl_slot_universal). pos: the bound's, where a reference no one
// impl proves is reported.
fn confirm_bound(s: i64, base: &Vec<i64, Comp>, tr: i64, targs: i64, tps: i64, depth: i64,
    sup: i64, pos: i64, written: bool, want: &Vec<i64, Comp>, wild: &Vec<i64, Comp>,
    sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if s <= 0 || tr < 0 {
        return -1;
    }
    // (0.30.2, test-only: VOLE_PLANT_OBLIG=depth lowers the limit to 2, a
    // chain the front proves meets it here)
    let limit = if pcx.plant_oblig == 1 { 2 } else { crate::front::assoc::MAX_ASSOC_DEPTH };
    if depth > limit {
        // (a limit is an error, never a yes)
        obligation_error(true, false, tr, s, pos, pcx);
        return -1;
    }
    // (0.30.1, review 4: a bound's supertraits are met by their own impls
    // for s, whose predicates the instance needs too, `T: Sub` calling
    // Sup's `up`; sup counts the steps, a cycle of supertraits is front's
    // error; 0.30.2: each by its whole reference, `trait Sub: Sup<i32>`'s
    // Sup<i32>, review 4 F3)
    let supers = crate::front::traits::trait_supers(tr, pcx);
    if supers > 0 && sup <= pcx.traits.len() as i64 {
        let none = Vec::<i64, Comp>::new_in(Comp {});
        for k in 0..pcx.nodes[supers as usize].count {
            let b = child(supers, k, pcx);
            if is_node(b, NodeKind::TyName, pcx) {
                let tr2 = crate::front::traits::bound_trait(b, pcx);
                let targs2 = super_args(tr, b, s, targs, pcx);
                let _ = impl_bound_ties(s, base, tr2, targs2, tps, depth, sup + 1, pos, false,
                    &none, wild, sig, pcx);
            }
        }
    }
    let found = chosen(tr, s, targs, base, tps, depth, pos, sig, pcx);
    if found < 0 {
        // (no impl proves the whole reference of a trait that has impls,
        // its arguments known: nothing read relates them to s, so all of
        // the predicate's regions are one; SEL_PARAM is no impl to tie, a
        // builtin trait's (`Fn(&X)`, `Sized`) none either, and the
        // ambiguous and the limit are errors)
        if written && targs >= 0 && trait_has_impls(tr, pcx)
            && crate::front::obligations::select(tr, s, targs, pcx)
            == crate::front::obligations::SEL_NONE {
            tie_wild(wild, sig);
        }
        return -1;
    }
    let inode = pcx.traits_impls[found as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let mut head = Vec::<i64, Comp>::new_in(Comp {});
    bind_walk(pcx.nodes[inode as usize].b, s, itps, 0, -1, &mut head, 0, pcx, -1);
    // (the impl's lifetimes and parameters its header does not name, bound
    // by its trait arguments: (kind, x, y, universal) rows)
    let mut extra = Vec::<i64, Comp>::new_in(Comp {});
    if written {
        arg_ties(found, inode, s, targs, &head, base, tps, want, wild, &mut extra, sig, pcx);
    }
    // (0.30.2, RT-211 review 2: a lifetime of the impl neither its header
    // nor its trait arguments name, `'a` of `impl<'a, T: Copy + 'a, I:
    // Iterator<Item = &'a T>> Iterator for Copied<I>`: a region of its own,
    // one for the whole confirmation, that its nested obligations relate)
    let lts = crate::front::parser::rust::lifetimes_of(inode, pcx);
    for li in 0..(if lts > 0 { pcx.nodes[lts as usize].count } else { 0 }) {
        let sym = pcx.nodes[child(lts, li, pcx) as usize].a;
        if lifetime_binding(sym, pcx) != B_NAMED {
            continue;
        }
        let mut seen = false;
        for h in 0..head.len() as i64 / 4 {
            seen = seen || names_lifetime(&head, h, sym, inode, pcx);
        }
        for r in 0..extra.len() as i64 / 4 {
            seen = seen || extra[(4 * r) as usize] == B_NAMED && extra[(4 * r + 1) as usize] == sym;
        }
        if !seen {
            extra.push(B_NAMED);
            extra.push(sym);
            extra.push(0);
            extra.push(add_universal(U_ELIDED, 0, -1 - li, sig));
        }
    }
    // (0.30.1, review 4: the impl's own predicates, at every depth)
    impl_predicates(found, s, &head, base, tps, sig, pcx);
    extra_predicates(inode, &extra, &head, base, tps, sig, pcx);
    let binds = impl_binds(found, s, targs, pcx);
    // (the bound's arguments' universals as entries, the impl's lifetimes
    // its trait arguments bind read at them: norm_value)
    let mut argw = Vec::<i64, Comp>::new_in(Comp {});
    for u in want.iter() {
        if *u >= 0 {
            push_entry(B_UNIV, *u, 0, -1, &mut argw);
        } else {
            push_entry(B_ELIDED, 0, 0, -1, &mut argw);
        }
    }
    for q in 0..(if itps > 0 { pcx.nodes[itps as usize].count } else { 0 }) {
        let bounds = pcx.nodes[child(itps, q, pcx) as usize].h;
        if bounds <= 0 {
            continue;
        }
        let mut sq = header_param_type(pcx.nodes[inode as usize].b, s, itps, q, 0, pcx);
        if sq <= 0 {
            // (0.30.1, review 4: a header the walk does not read, a
            // tuple's: the binding front made)
            sq = if binds >= 0 { tlist_at(binds + q, pcx) } else { 0 };
        }
        if sq <= 0 {
            continue;
        }
        let mut bq = Vec::<i64, Comp>::new_in(Comp {});
        param_base(q, sq, &head, base, &mut bq, pcx);
        // (a parameter the header does not name, bound by the trait
        // arguments, `U` of `impl<T, U: From<T>> Into<U> for T`: its slots
        // the bound's, extra's)
        for j in 0..bq.len() as i64 / 4 {
            for r in 0..extra.len() as i64 / 4 {
                if bq[(4 * j) as usize] == B_ELIDED && extra[(4 * r) as usize] == B_PARAM
                    && extra[(4 * r + 1) as usize] == q && extra[(4 * r + 2) as usize] == j
                    && extra[(4 * r + 3) as usize] >= 0 {
                    bq[(4 * j) as usize] = B_UNIV;
                    bq[(4 * j + 1) as usize] = extra[(4 * r + 3) as usize];
                }
            }
        }
        // (one only another parameter's bound binds, `T` of Copied's impl: that
        // bound's normalized at it, impl_slot)
        for j in 0..bq.len() as i64 / 4 {
            if bq[(4 * j) as usize] == B_ELIDED {
                let mut one = Vec::<i64, Comp>::new_in(Comp {});
                let none = Vec::<i64, Comp>::new_in(Comp {});
                impl_slot(found, B_PARAM, q, j, s, base, &head, targs, &argw, &none, &mut one,
                    depth, pcx, &extra);
                if one.len() == 4 {
                    for w in 0..3 {
                        bq[(4 * j + w) as usize] = one[w as usize];
                    }
                }
            }
        }
        impl_fn_ties(found, q, sq, &bq, s, &head, base, tps, sig, pcx);
        for bi in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, bi, pcx);
            if is_node(b, NodeKind::TyName, pcx) {
                nested_bound(found, b, sq, &bq, s, base, targs, &argw, binds, tps, depth, pos, wild,
                    sig, pcx, &extra);
            }
        }
    }
    impl_where_ties(found, s, base, targs, &argw, binds, tps, depth, pos, wild, sig, pcx,
        &extra);
    found
}

// RULE: L14, O-M1 (0.30.2, RT-211 review 2) The `where` predicates of impl
// `found` (chosen for `s: tr<targs>`, s's slots base's, the bound's
// arguments' argw's) on a subject that is no parameter of it (`where i64:
// Conv<W<'a>>`, `where i64: Conv<Self>`, `where T::K: Conv<W<'a>>`;
// front::traits::own_impl_where_preds): its subject read in s's terms
// (norm_value), each bound met as a parameter's is (nested_bound).
fn impl_where_ties(found: i64, s: i64, base: &Vec<i64, Comp>, targs: i64, argw: &Vec<i64, Comp>,
    binds: i64, tps: i64, depth: i64, pos: i64, wild: &Vec<i64, Comp>, sig: &mut Sig<Comp>,
    pcx: &mut Ctx<Comp>, extra: &Vec<i64, Comp>) {
    let inode = pcx.traits_impls[found as usize].node;
    let mut next = crate::front::traits::wp_start(-inode, pcx);
    while next >= 0 {
        let k = next;
        next = crate::front::traits::wp_after(k, pcx);
        let subject = pcx.where_preds[k as usize].subject;
        let bounds = pcx.where_preds[k as usize].bounds;
        let sw = impl_type(subject, found, s, binds, pcx);
        if sw <= 0 || bounds <= 0 {
            continue;
        }
        let mut bw = Vec::<i64, Comp>::new_in(Comp {});
        norm_value(found, subject, sw, s, base, targs, argw, &mut bw, -1, depth + 1, pcx,
            extra);
        for bi in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, bi, pcx);
            if is_node(b, NodeKind::TyName, pcx) {
                nested_bound(found, b, sw, &bw, s, base, targs, argw, binds, tps, depth, pos, wild,
                    sig, pcx, extra);
            }
        }
    }
}

// RULE: L14, O-M1 (0.30.1 review 4; 0.30.2, RT-211 review 2) Bound b of
// impl `found` (chosen for `s: tr<targs>`, s's slots base's, the bound's
// arguments' argw's) on a subject of type sq whose slots are bq's: its
// trait reference whole, met by the impl select chose for it, its
// arguments read in s's terms (norm_value: the header's slots base's, the
// impl's lifetimes the trait arguments bind argw's, its projections
// normalized) and the chosen impl's against them (impl_bound_ties,
// recursively); and each associated-type constraint `Tr<A = X>` (`T:
// Get<Out = W<'a>>`, `B: Iterator<Item = A::Item>`): sq::A, normalized
// through the impl select chose, and X read in s's terms one type, slot
// by slot one region. Where one is not read, every region of the
// predicate one (wild, and s's).
fn nested_bound(found: i64, b: i64, sq: i64, bq: &Vec<i64, Comp>, s: i64, base: &Vec<i64, Comp>,
    targs: i64, argw: &Vec<i64, Comp>, binds: i64, tps: i64, depth: i64, pos: i64,
    wild: &Vec<i64, Comp>, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>, extra: &Vec<i64, Comp>) {
    let inode = pcx.traits_impls[found as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let count: i64 = if itps > 0 { pcx.nodes[itps as usize].count } else { 0 };
    let tr2 = crate::front::traits::bound_trait(b, pcx);
    if tr2 < 0 {
        return;
    }
    let targs2 = crate::front::obligations::bound_ref_args(b, tr2, sq,
        pcx.traits_impls[found as usize].module, itps, binds, count, s, pcx);
    let args2 = pcx.nodes[b as usize].g;
    let mut want2 = Vec::<i64, Comp>::new_in(Comp {});
    let mut wild2 = Vec::<i64, Comp>::new_in(Comp {});
    for e in 0..base.len() as i64 / 4 {
        wild2.push(walk_universal(base, e, tps, sig, pcx));
    }
    for e in 0..bq.len() as i64 / 4 {
        wild2.push(walk_universal(bq, e, tps, sig, pcx));
    }
    for u in wild {
        wild2.push(*u);
    }
    if args2 > 0 && targs2 >= 0 {
        for a in 0..pcx.nodes[args2 as usize].count {
            let t2 = tlist_at(targs2 + a, pcx);
            let slots = slot_count(t2, pcx);
            let mut ent = Vec::<i64, Comp>::new_in(Comp {});
            norm_value(found, child(args2, a, pcx), t2, s, base, targs, argw, &mut ent, -1,
                depth + 1, pcx, extra);
            for e in 0..slots {
                want2.push(if ent.len() as i64 == 4 * slots {
                    walk_universal(&ent, e, tps, sig, pcx) } else { -1 });
            }
        }
    } else if args2 > 0 {
        tie_wild(&wild2, sig);
    }
    let _ = impl_bound_ties(sq, bq, tr2, targs2, tps, depth + 1, 0, pos, args2 > 0, &want2,
        &wild2, sig, pcx);
    let holder = pcx.nodes[b as usize].h;
    let mut argw2 = Vec::<i64, Comp>::new_in(Comp {});
    for u in want2.iter() {
        if *u >= 0 {
            push_entry(B_UNIV, *u, 0, -1, &mut argw2);
        } else {
            push_entry(B_ELIDED, 0, 0, -1, &mut argw2);
        }
    }
    for ci in 0..(if holder > 0 { pcx.nodes[holder as usize].count } else { 0 }) {
        let c = child(holder, ci, pcx);
        let x = pcx.nodes[c as usize].b;
        if !is_node(c, NodeKind::AssocType, pcx) || x <= 0 {
            continue;
        }
        let name = pcx.nodes[c as usize].a;
        let gt = crate::front::assoc::super_projection(tr2, sq, name, pcx.nodes[c as usize].start,
            pcx);
        if gt <= 0 {
            continue;
        }
        let mut have = Vec::<i64, Comp>::new_in(Comp {});
        let mut want3 = Vec::<i64, Comp>::new_in(Comp {});
        let read = norm_proj(tr2, targs2, name, sq, bq, gt, &argw2, &mut have, depth + 1, pcx);
        norm_value(found, x, gt, s, base, targs, argw, &mut want3, -1, depth + 1, pcx,
            extra);
        if !read || !tie_pairs(&have, &want3, tps, sig, pcx) {
            tie_wild(&wild2, sig);
        }
    }
}

// Whether trait tr has an impl.
fn trait_has_impls(tr: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.traits_impls.len() as i64 {
        if pcx.traits_impls[i as usize].tr == tr {
            return true;
        }
    }
    false
}

// RULE: O-M1 (0.30.2, RT-211 review) Impl `found` (node inode, its header's
// walk head of s, whose slots are base's) chosen for `s: tr<targs>`: each
// of its trait arguments, read in its terms, is the bound's, whose slots'
// universals are want's, slot by slot (rustc's confirmation equates
// them): a slot the impl names (its header's, 'static) and want's one
// region; a slot of a lifetime or parameter of the impl its header does not
// name, bound to want's (extra); a slot only one side names, or arguments
// whose walk does not fit, all of wild one.
fn arg_ties(found: i64, inode: i64, s: i64, targs: i64, head: &Vec<i64, Comp>,
    base: &Vec<i64, Comp>, tps: i64, want: &Vec<i64, Comp>, wild: &Vec<i64, Comp>,
    extra: &mut Vec<i64, Comp>, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let iargs = pcx.nodes[pcx.nodes[inode as usize].a as usize].g;
    let itps = pcx.nodes[inode as usize].g;
    let params = pcx.traits[pcx.traits_impls[found as usize].tr as usize].params;
    let n: i64 = if params > 0 { pcx.nodes[params as usize].count } else { 0 };
    if iargs <= 0 || targs < 0 || pcx.nodes[iargs as usize].count != n {
        tie_wild(wild, sig);
        return;
    }
    let mut at: i64 = 0;
    for a in 0..n {
        // (the arguments the bound does not write are the trait's defaults,
        // `Self` or a type of no region of the signature's: none to pair)
        if at >= want.len() as i64 {
            break;
        }
        let t = tlist_at(targs + a, pcx);
        let slots = slot_count(t, pcx);
        let mut raw = Vec::<i64, Comp>::new_in(Comp {});
        bind_walk(child(iargs, a, pcx), t, itps, pcx.nodes[inode as usize].b, -1, &mut raw, 0, pcx,
            -1);
        if raw.len() as i64 != 4 * slots || at + slots > want.len() as i64 {
            tie_wild(wild, sig);
            return;
        }
        for e in 0..slots {
            let w = want[(at + e) as usize];
            let kind = raw[(4 * e) as usize];
            let free = free_in_header(&raw, e, inode, head, pcx);
            if free {
                extra.push(param_kind(kind));
                extra.push(raw[(4 * e + 1) as usize]);
                extra.push(raw[(4 * e + 2) as usize]);
                extra.push(w);
                continue;
            }
            let h = impl_slot_universal(&raw, e, inode, head, base, extra, tps, sig, pcx);
            if h >= 0 && w >= 0 {
                tie_universals(h, w, sig);
            } else if h >= 0 || w >= 0 {
                tie_wild(wild, sig);
                let mut one = Vec::<i64, Comp>::new_in(Comp {});
                one.push(if h >= 0 { h } else { w });
                for u in wild {
                    one.push(*u);
                }
                tie_wild(&one, sig);
            }
        }
        at += slots;
    }
}

// Whether slot e of raw, a walk in impl inode's terms, is a lifetime or a
// type parameter's slot of the impl that its header's walk head names
// nowhere (bound only by the trait arguments).
fn free_in_header(raw: &Vec<i64, Comp>, e: i64, inode: i64, head: &Vec<i64, Comp>,
    pcx: &Ctx<Comp>) -> bool {
    let kind = param_kind(raw[(4 * e) as usize]);
    let x = raw[(4 * e + 1) as usize];
    let y = raw[(4 * e + 2) as usize];
    if kind == B_NAMED {
        for h in 0..head.len() as i64 / 4 {
            if names_lifetime(head, h, x, inode, pcx) {
                return false;
            }
        }
        return true;
    }
    if kind == B_PARAM {
        for h in 0..head.len() as i64 / 4 {
            if param_kind(head[(4 * h) as usize]) == B_PARAM && head[(4 * h + 1) as usize] == x
                && head[(4 * h + 2) as usize] == y {
                return false;
            }
        }
        return true;
    }
    false
}

// The universal of slot e of raw, a walk in impl inode's terms (its
// header's walk head of s, whose slots are base's; the rows extra binds
// the rest by): 'static, a lifetime of the impl (the first slot of s its
// header names it at), a slot of an impl parameter, or -1 (elided).
fn impl_slot_universal(raw: &Vec<i64, Comp>, e: i64, inode: i64, head: &Vec<i64, Comp>,
    base: &Vec<i64, Comp>, extra: &Vec<i64, Comp>, tps: i64, sig: &mut Sig<Comp>,
    pcx: &Ctx<Comp>) -> i64 {
    let kind = param_kind(raw[(4 * e) as usize]);
    let x = raw[(4 * e + 1) as usize];
    let y = raw[(4 * e + 2) as usize];
    if kind == B_STATIC {
        return 0;
    }
    let n = if head.len() < base.len() { head.len() as i64 / 4 } else { base.len() as i64 / 4 };
    for h in 0..n {
        let hit = kind == B_NAMED && names_lifetime(head, h, x, inode, pcx)
            || kind == B_PARAM && param_kind(head[(4 * h) as usize]) == B_PARAM
            && head[(4 * h + 1) as usize] == x && head[(4 * h + 2) as usize] == y;
        if hit {
            return walk_universal(base, h, tps, sig, pcx);
        }
    }
    for r in 0..extra.len() as i64 / 4 {
        if extra[(4 * r) as usize] == kind && extra[(4 * r + 1) as usize] == x
            && (kind == B_NAMED || extra[(4 * r + 2) as usize] == y) {
            return extra[(4 * r + 3) as usize];
        }
    }
    -1
}

// RULE: L14 (0.30.2, RT-211 review) The predicates of impl inode's own
// lifetimes its header does not name, bound by its trait arguments
// (extra's rows, arg_ties): each one's bounds (`impl<'a: 'b, 'b>`, a `where
// 'a: 'static`) on its universal, as impl_predicates gives a header
// lifetime's.
fn extra_predicates(inode: i64, extra: &Vec<i64, Comp>, head: &Vec<i64, Comp>,
    base: &Vec<i64, Comp>, tps: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let lts = crate::front::parser::rust::lifetimes_of(inode, pcx);
    let count: i64 = if lts > 0 { pcx.nodes[lts as usize].count } else { 0 };
    let n = if head.len() < base.len() { head.len() as i64 / 4 } else { base.len() as i64 / 4 };
    for r in 0..extra.len() as i64 / 4 {
        let u = extra[(4 * r + 3) as usize];
        if extra[(4 * r) as usize] != B_NAMED || u < 0 {
            continue;
        }
        for li in 0..count {
            let p = child(lts, li, pcx);
            if pcx.nodes[p as usize].a != extra[(4 * r + 1) as usize] {
                continue;
            }
            let pb = pcx.nodes[p as usize].h;
            for bi in 0..(if pb > 0 { pcx.nodes[pb as usize].count } else { 0 }) {
                let to = pcx.nodes[child(pb, bi, pcx) as usize].a;
                outlives_named(u, to, head, base, n, inode, tps, sig, pcx);
                for r2 in 0..extra.len() as i64 / 4 {
                    if extra[(4 * r2) as usize] == B_NAMED && extra[(4 * r2 + 1) as usize] == to {
                        outlives_universal(u, extra[(4 * r2 + 3) as usize], sig);
                    }
                }
            }
        }
    }
}

// RULE: O-M1 (0.30.2, obligations M1) The impl the front's selection chose
// for `s: tr<targs>` (front::obligations::select: its record, read; s's
// slots base's entries), or -1: none (the reference holds without one, an
// Ω's bound, a builtin; or does not, which the front reported). Two impls
// for a reference whose arguments are known: trait.ambiguous; the depth
// limit met: trait.overflow (neither is a yes); so for a trait without
// arguments. A reference whose arguments are not known here (a bound written without them on a trait
// that has some, `T: PartialEq`; or naming what does not resolve here):
// each impl that may be the one is required, its predicates and its
// parameters' bounds', more than the one needs, never less.
fn chosen(tr: i64, s: i64, targs: i64, base: &Vec<i64, Comp>, tps: i64, depth: i64, pos: i64,
    sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let r = crate::front::obligations::select(tr, s, targs, pcx);
    if r >= 0 {
        return r;
    }
    if r == crate::front::obligations::SEL_LIMIT {
        obligation_error(true, false, tr, s, pos, pcx);
        return -1;
    }
    if r != crate::front::obligations::SEL_AMBIG {
        return -1;
    }
    if targs >= 0 || pcx.traits[tr as usize].params == 0 {
        obligation_error(false, false, tr, s, pos, pcx);
        return -1;
    }
    let mut cands = Vec::<i64, Comp>::new_in(Comp {});
    crate::front::obligations::candidates(tr, s, -1, &mut cands, pcx);
    for i in cands {
        let inode = pcx.traits_impls[i as usize].node;
        let itps = pcx.nodes[inode as usize].g;
        let mut head = Vec::<i64, Comp>::new_in(Comp {});
        bind_walk(pcx.nodes[inode as usize].b, s, itps, 0, -1, &mut head, 0, pcx, -1);
        impl_predicates(i, s, &head, base, tps, sig, pcx);
        let binds = impl_binds(i, s, -1, pcx);
        for q in 0..(if itps > 0 { pcx.nodes[itps as usize].count } else { 0 }) {
            let bounds = pcx.nodes[child(itps, q, pcx) as usize].h;
            if bounds <= 0 {
                continue;
            }
            let mut sq = header_param_type(pcx.nodes[inode as usize].b, s, itps, q, 0, pcx);
            if sq <= 0 {
                sq = if binds >= 0 { tlist_at(binds + q, pcx) } else { 0 };
            }
            if sq <= 0 {
                continue;
            }
            let mut bq = Vec::<i64, Comp>::new_in(Comp {});
            param_base(q, sq, &head, base, &mut bq, pcx);
            for bi in 0..pcx.nodes[bounds as usize].count {
                let b = child(bounds, bi, pcx);
                if !is_node(b, NodeKind::TyName, pcx) {
                    continue;
                }
                let tr2 = crate::front::traits::bound_trait(b, pcx);
                let targs2 = crate::front::obligations::bound_ref_args(b, tr2, sq,
                    pcx.traits_impls[i as usize].module, itps, binds,
                    pcx.nodes[itps as usize].count, s, pcx);
                let none = Vec::<i64, Comp>::new_in(Comp {});
                let _ = impl_bound_ties(sq, &bq, tr2, targs2, tps, depth + 1, 0, pos, false,
                    &none, &none, sig, pcx);
            }
        }
    }
    -1
}

// The arguments of supertrait bound b of trait tr (`trait Sub<P>:
// Sup<P>`), for `s: tr<targs>`: resolved with tr's parameters bound to
// targs and `Self` s, or the supertrait's defaults (bound_ref_args); -1
// when one does not resolve.
fn super_args(tr: i64, b: i64, s: i64, targs: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let params = pcx.traits[tr as usize].params;
    let count: i64 = if targs >= 0 && params > 0 { pcx.nodes[params as usize].count } else { 0 };
    let tr2 = crate::front::traits::bound_trait(b, pcx);
    crate::front::obligations::bound_ref_args(b, tr2, s, pcx.traits[tr as usize].module, params,
        if count > 0 { targs } else { -1 }, count, s, pcx)
}

// The types impl i's parameters are for `s: tr<targs>` (a TLISTS index;
// 0 for one neither the header nor the trait arguments bind; -1: the
// impl is not for s): the front's bindings, completed from targs.
fn impl_binds(i: i64, s: i64, targs: i64, pcx: &mut Ctx<Comp>) -> i64 {
    crate::front::obligations::bindings(i, s, targs, pcx)
}

// RULE: L14 (0.30.1, review 4: rustc's impl confirmation, its nested
// obligations) The impl `found` holds of s only under its own predicates,
// so where it is chosen for s (impl_bound_ties, every bound an instance
// meets through an impl, at every depth) they are the instance's bounds,
// required at its call: the header's lifetimes (head, the header's walk
// of s, its slots base's entries) named at slots of s, a `'static` there
// (`impl Tr for X<'static>`), one lifetime at two slots (`X<'a, 'a>`:
// one region), each lifetime's bounds (`impl<'a: 'b, 'b>`, and the
// impl's `where 'a: 'static`, joined to them by the parser,
// rust::join_where_lifetimes), and each type parameter's lifetime bounds
// (`impl<T: 'static>`, `where T: 'a`) of all the slots of its
// substitution.
fn impl_predicates(found: i64, s: i64, head: &Vec<i64, Comp>, base: &Vec<i64, Comp>, tps: i64,
    sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    let inode = pcx.traits_impls[found as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let lts = crate::front::parser::rust::lifetimes_of(inode, pcx);
    let n = if head.len() < base.len() { head.len() as i64 / 4 } else { base.len() as i64 / 4 };
    let count: i64 = if lts > 0 { pcx.nodes[lts as usize].count } else { 0 };
    for e in 0..n {
        let ue = walk_universal(base, e, tps, sig, pcx);
        if names_lifetime(head, e, -1, inode, pcx) {
            outlives_universal(ue, 0, sig);
        }
        for li in 0..count {
            let p = child(lts, li, pcx);
            let sym = pcx.nodes[p as usize].a;
            if !names_lifetime(head, e, sym, inode, pcx) {
                continue;
            }
            for e2 in e + 1..n {
                if names_lifetime(head, e2, sym, inode, pcx) {
                    tie_universals(ue, walk_universal(base, e2, tps, sig, pcx), sig);
                }
            }
            let pb = pcx.nodes[p as usize].h;
            for bi in 0..(if pb > 0 { pcx.nodes[pb as usize].count } else { 0 }) {
                let to = pcx.nodes[child(pb, bi, pcx) as usize].a;
                outlives_named(ue, to, head, base, n, inode, tps, sig, pcx);
            }
        }
    }
    if itps <= 0 {
        return;
    }
    for q in 0..pcx.nodes[itps as usize].count {
        let qn = child(itps, q, pcx);
        if crate::front::parser::rust::outlives_of(qn, 0, pcx) == 0 {
            continue;
        }
        let mut sq = header_param_type(pcx.nodes[inode as usize].b, s, itps, q, 0, pcx);
        if sq <= 0 {
            let binds = crate::front::traits::impl_bindings(found, s, pcx);
            sq = if binds >= 0 { tlist_at(binds + q, pcx) } else { 0 };
        }
        let mut bq = Vec::<i64, Comp>::new_in(Comp {});
        if sq > 0 {
            param_base(q, sq, head, base, &mut bq, pcx);
        }
        let mut i: i64 = 0;
        loop {
            let to = crate::front::parser::rust::outlives_of(qn, i, pcx);
            if to == 0 {
                break;
            }
            for e in 0..bq.len() as i64 / 4 {
                outlives_named(walk_universal(&bq, e, tps, sig, pcx), to, head, base, n, inode,
                    tps, sig, pcx);
            }
            // (and every slot of s the parameter's walk reached, a view
            // `&'a T` collapsed into T's: those slots are T's too)
            for e in 0..n {
                if param_kind(head[(4 * e) as usize]) == B_PARAM
                    && head[(4 * e + 1) as usize] == q {
                    outlives_named(walk_universal(base, e, tps, sig, pcx), to, head, base, n,
                        inode, tps, sig, pcx);
                }
            }
            i += 1;
        }
    }
}

// Universal a outlives lifetime `to` of impl inode's header (its walk
// head, the first n slots base's): 'static, or the universal of each slot
// the header names it at.
fn outlives_named(a: i64, to: i64, head: &Vec<i64, Comp>, base: &Vec<i64, Comp>, n: i64,
    inode: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    if lifetime_binding(to, pcx) == B_STATIC {
        outlives_universal(a, 0, sig);
        return;
    }
    for e in 0..n {
        if names_lifetime(head, e, to, inode, pcx) {
            outlives_universal(a, walk_universal(base, e, tps, sig, pcx), sig);
        }
    }
}

// Whether impl inode's header names lifetime sym (-1: 'static) at slot e
// of its walk head: a lifetime written there, or (a view `&'a T` with T =
// str, whose walk keeps T's slot, B_PARAM_REF) a reference over that
// parameter written with it anywhere in the header (each such reference:
// more than the one the slot is, never less).
pub fn names_lifetime(head: &Vec<i64, Comp>, e: i64, sym: i64, inode: i64, pcx: &Ctx<Comp>) -> bool {
    let k = head[(4 * e) as usize];
    if sym < 0 && k == B_STATIC {
        return true;
    }
    if sym > 0 && k == B_NAMED {
        return head[(4 * e + 1) as usize] == sym;
    }
    let itps = pcx.nodes[inode as usize].g;
    if k != B_PARAM_REF || itps <= 0 || head[(4 * e + 2) as usize] != 0
        || head[(4 * e + 1) as usize] >= pcx.nodes[itps as usize].count {
        return false;
    }
    let q = pcx.nodes[child(itps, head[(4 * e + 1) as usize], pcx) as usize].a;
    ref_over(pcx.nodes[inode as usize].b, q, sym, 0, pcx)
}

// Whether type node n holds a reference `&'l Q` to the bare parameter
// named q with lifetime sym (-1: 'static).
fn ref_over(n: i64, q: i64, sym: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if n <= 0 || depth > 64 {
        return false;
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::TyPtr {
        let a = pcx.nodes[n as usize].a;
        let l = pcx.nodes[n as usize].c;
        if is_node(a, NodeKind::TyName, pcx) && pcx.nodes[a as usize].list == 0
            && pcx.nodes[a as usize].g == 0 && pcx.nodes[a as usize].a == q
            && (if sym < 0 { lifetime_binding(l, pcx) == B_STATIC } else { l == sym }) {
            return true;
        }
        return ref_over(a, q, sym, depth + 1, pcx);
    }
    if k == NodeKind::TySlice || k == NodeKind::TyArray {
        return ref_over(pcx.nodes[n as usize].a, q, sym, depth + 1, pcx);
    }
    let list = if k == NodeKind::TyName { pcx.nodes[n as usize].g }
        else if k == NodeKind::TyTuple { n } else { 0 };
    if list > 0 {
        for i in 0..pcx.nodes[list as usize].count {
            if ref_over(child(list, i, pcx), q, sym, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// Universal a of sig outlives b (0: 'static; -1 either: nothing added).
fn outlives_universal(a: i64, b: i64, sig: &mut Sig<Comp>) {
    if a > 0 && b >= 0 && a != b {
        sig.bounds.push(a);
        sig.bounds.push(b);
    }
}

// RULE: L14, D19.10 (4) (0.27.3) Impl i's type parameter q (substitution
// sq, its slots bq's entries) is a closure type C with the Fn bound of the
// impl, `F: FnMut(I::Item) -> B` of `impl<B, I: Iterator, F: FnMut(I::Item)
// -> B> Iterator for Map<I, F>`: the impl's instance ties each X_C
// position of C to the bound's slot there (an impl parameter's, a
// projection's of one); so does this body, through s's slots (base's
// entries, head the header's walk of s).
fn impl_fn_ties(i: i64, q: i64, sq: i64, bq: &Vec<i64, Comp>, s: i64, head: &Vec<i64, Comp>,
    base: &Vec<i64, Comp>, tps: i64, sig: &mut Sig<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.types[sq as usize].kind != TyKind::Struct {
        return;
    }
    let id = pcx.structs[pcx.types[sq as usize].a as usize].closure - 1;
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let bnode: i64 = if id >= 0 { crate::front::closures::fn_bounds::fn_bound_of(itps, q, pcx) }
        else { 0 };
    if bnode <= 0 {
        return;
    }
    let mut walk = Vec::<i64, Comp>::new_in(Comp {});
    let mut at = Vec::<i64, Comp>::new_in(Comp {});
    let mut codes = Vec::<i64, Comp>::new_in(Comp {});
    let _ = closure_sig_walk(id, pcx.closures[id as usize].exp_node,
        pcx.closures[id as usize].exp_tps, &mut walk, &mut at, &mut codes, F_MARK, 0, pcx);
    let mut read = Vec::<i64, Comp>::new_in(Comp {});
    let mut at2 = Vec::<i64, Comp>::new_in(Comp {});
    let mut codes2 = Vec::<i64, Comp>::new_in(Comp {});
    let _ = closure_sig_walk(id, bnode, itps, &mut read, &mut at2, &mut codes2, F_MARK,
        pcx.nodes[inode as usize].b, pcx);
    let nenv = slot_count(sq, pcx) - pcx.closures[id as usize].xc_n;
    if read.len() != walk.len() || nenv < 0 {
        return;
    }
    let np = at2.len() as i64 - 2;
    for e in 0..codes.len() as i64 {
        let x = codes[e as usize];
        if x < 0 || nenv + x >= bq.len() as i64 / 4 {
            continue;
        }
        let rb = param_kind(read[(4 * e) as usize]);
        let mut u: i64 = -1;
        if rb == B_STATIC {
            u = 0;
        } else if rb == B_PARAM || rb == B_PROJ {
            // (the entry's parameter or result: its node in the bound)
            let mut a: i64 = 0;
            while a + 1 < at2.len() as i64 && at2[(a + 1) as usize] <= e {
                a += 1;
            }
            let mut an = if a < np { child(bnode, a, pcx) } else { pcx.nodes[bnode as usize].a };
            // (`FnMut(&I::Item)`: the projection under the references, each
            // one slot before it)
            let mut off: i64 = 0;
            while rb == B_PROJ && is_node(an, NodeKind::TyPtr, pcx)
                && (pcx.nodes[an as usize].p & crate::front::ast::NODE_REF) != 0 {
                off += 1;
                an = pcx.nodes[an as usize].a;
            }
            let mut got = Vec::<i64, Comp>::new_in(Comp {});
            let mut q2: i64 = -1;
            if rb == B_PARAM {
                q2 = read[(4 * e + 1) as usize];
            } else if an > 0 && proj_shape(an, pcx) {
                q2 = param_index(itps, pcx.nodes[child(an, 0, pcx) as usize].a, pcx);
            }
            let s2: i64 = if q2
                >= 0 { header_param_type(pcx.nodes[inode as usize].b, s, itps, q2, 0, pcx) }
                else { 0 };
            if s2 > 0 {
                let mut b2 = Vec::<i64, Comp>::new_in(Comp {});
                param_base(q2, s2, head, base, &mut b2, pcx);
                if rb == B_PARAM {
                    got = b2;
                } else {
                    let _ = param_proj(i, q2, -1, pcx.nodes[an as usize].a, s2, &b2, &mut got, pcx);
                }
            }
            let j = if rb == B_PARAM { read[(4 * e + 2) as usize] }
                else { e - at2[a as usize] - off };
            if j >= 0 && j < got.len() as i64 / 4 {
                u = walk_universal(&got, j, tps, sig, pcx);
            }
        }
        tie_universals(walk_universal(bq, nenv + x, tps, sig, pcx), u, sig);
    }
}

// The entries of the slots of sq, impl type parameter q's substitution,
// read from the header's walk head of s (whose slots are base's); pushed
// to out, one per slot of sq (elided where the header does not name it).
fn param_base(q: i64, sq: i64, head: &Vec<i64, Comp>, base: &Vec<i64, Comp>,
    out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for j in 0..slot_count(sq, pcx) {
        let mut e: i64 = -1;
        for h in 0..head.len() as i64 / 4 {
            if e < 0 && param_kind(head[(4 * h) as usize]) == B_PARAM
                && head[(4 * h + 1) as usize] == q
                && head[(4 * h + 2) as usize] == j {
                e = h;
            }
        }
        if e >= 0 && e < base.len() as i64 / 4 {
            push_entry(base[(4 * e) as usize], base[(4 * e + 1) as usize],
                base[(4 * e + 2) as usize], -1, out);
        } else {
            push_entry(B_ELIDED, 0, 0, -1, out);
        }
    }
}

// The slots of `Q::name` (Q impl i's type parameter q, substitution sq
// whose slots are bq's entries; tr its trait, -1: the one of Q's bounds
// that defines it, through supertraits), normalized through the impl
// select chose for it (norm_proj; 0.30.2, RT-211 review 2: never the one
// the front's last projection met); pushed to out. Whether found.
fn param_proj(i: i64, q: i64, tr: i64, name: i64, sq: i64, bq: &Vec<i64, Comp>,
    out: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let inode = pcx.traits_impls[i as usize].node;
    let itps = pcx.nodes[inode as usize].g;
    let pos = pcx.nodes[inode as usize].start;
    let none = Vec::<i64, Comp>::new_in(Comp {});
    if tr >= 0 {
        let gt = crate::front::assoc::super_projection(tr, sq, name, pos, pcx);
        return gt > 0 && norm_proj(tr, -1, name, sq, bq, gt, &none, out, 0, pcx);
    }
    let bounds = pcx.nodes[child(itps, q, pcx) as usize].h;
    for bi in 0..(if bounds > 0 { pcx.nodes[bounds as usize].count } else { 0 }) {
        let b = child(bounds, bi, pcx);
        if !is_node(b, NodeKind::TyName, pcx) {
            continue;
        }
        let t = crate::front::traits::bound_trait(b, pcx);
        if t < 0 {
            continue;
        }
        let gt = crate::front::assoc::super_projection(t, sq, name, pos, pcx);
        if gt > 0 && norm_proj(t, -1, name, sq, bq, gt, &none, out, 0, pcx) {
            return true;
        }
    }
    false
}

// The type impl header node n (type t) has at its type parameter q (of
// generics itps), or 0: `Chain<A, B>` at Chain<Iter<i64>, Rev<..>> gives B
// Rev<..>.
fn header_param_type(n: i64, t: i64, itps: i64, q: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 || t <= 0 {
        return 0;
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::TyName && pcx.nodes[n as usize].count == 0 && pcx.nodes[n as usize].g == 0 {
        return if param_index(itps, pcx.nodes[n as usize].a, pcx) == q { t } else { 0 };
    }
    if k == NodeKind::TyName && pcx.nodes[n as usize].g > 0
        && (pcx.types[t as usize].kind == TyKind::Struct
            || pcx.types[t as usize].kind == TyKind::Enum) {
        let g = pcx.nodes[n as usize].g;
        if pcx.nodes[g as usize].count != adt_targ_count(t, pcx) {
            return 0;
        }
        for i in 0..pcx.nodes[g as usize].count {
            let r = header_param_type(child(g, i, pcx), adt_targ(t, i, pcx), itps, q, depth + 1,
                pcx);
            if r > 0 {
                return r;
            }
        }
        return 0;
    }
    if (k == NodeKind::TyPtr || k == NodeKind::TySlice || k == NodeKind::TyArray)
        && (pcx.types[t as usize].kind == TyKind::Ptr || pcx.types[t as usize].kind == TyKind::Slice
            || pcx.types[t as usize].kind == TyKind::Array) {
        return header_param_type(pcx.nodes[n as usize].a, pcx.types[t as usize].a, itps, q,
            depth + 1, pcx);
    }
    0
}

// The universal walk entry e of w binds, when it names one (an elided or
// unresolved entry: -1).
fn walk_universal(w: &Vec<i64, Comp>, e: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &Ctx<Comp>)
    -> i64 {
    let b = w[(4 * e) as usize];
    if b == B_STATIC {
        return 0;
    }
    if b == B_UNIV {
        return w[(4 * e + 1) as usize];
    }
    if b == B_TIED {
        return tied_universal(w[(4 * e + 1) as usize], tps, sig, pcx);
    }
    if b == B_NAMED {
        return add_universal(U_NAMED, w[(4 * e + 1) as usize], 0, sig);
    }
    if b == B_SELF {
        return add_universal(U_SUBST, w[(4 * e + 1) as usize], w[(4 * e + 2) as usize], sig);
    }
    if param_kind(b) == B_PARAM && w[(4 * e + 1) as usize] < pcx.nodes[tps as usize].count {
        return add_universal(U_SUBST,
            pcx.nodes[child(tps, w[(4 * e + 1) as usize], pcx) as usize].a, w[(4 * e + 2) as usize],
            sig);
    }
    -1
}

// Universals a and b of sig outlive each other (-1: none, nothing added).
fn tie_universals(a: i64, b: i64, sig: &mut Sig<Comp>) {
    if a >= 0 && b >= 0 {
        sig.bounds.push(a);
        sig.bounds.push(b);
        sig.bounds.push(b);
        sig.bounds.push(a);
    }
}

// Universal (kind, x, y) of sig, or -1.
fn find_universal(kind: i64, x: i64, y: i64, sig: &Sig<Comp>) -> i64 {
    for u in 0..universal_count(sig) {
        if sig.univ[(3 * u) as usize] == kind && sig.univ[(3 * u + 1) as usize] == x
            && sig.univ[(3 * u + 2) as usize] == y {
            return u;
        }
    }
    -1
}

// The walk's entries (sig.walk) of parameter `param` (its local), bound
// to universals, pushed to sig.params: an elided one a fresh universal
// (E1).
fn bind_entries(param: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &Ctx<Comp>) {
    let n = sig.walk.len() as i64 / 4;
    for e in 0..n {
        let u = entry_universal(e, param, tps, sig, pcx);
        sig.params.push(u);
    }
}

// The universal walk entry e binds (elided: a fresh one of parameter
// `param`'s; -1: of the result, never asked so).
fn entry_universal(e: i64, param: i64, tps: i64, sig: &mut Sig<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let b = sig.walk[(4 * e) as usize];
    if b == B_STATIC {
        return 0;
    }
    if b == B_NAMED {
        return add_universal(U_NAMED, sig.walk[(4 * e + 1) as usize], 0, sig);
    }
    if b == B_SELF {
        return add_universal(U_SUBST, sig.walk[(4 * e + 1) as usize],
            sig.walk[(4 * e + 2) as usize], sig);
    }
    if b == B_OUTER {
        return add_universal(U_OUTER, sig.walk[(4 * e + 1) as usize], 0, sig);
    }
    if b == B_TIED {
        let u = tied_universal(sig.walk[(4 * e + 1) as usize], tps, sig, pcx);
        if u >= 0 {
            return u;
        }
    }
    if param_kind(b) == B_PARAM {
        let sym = pcx.nodes[child(tps, sig.walk[(4 * e + 1) as usize], pcx) as usize].a;
        return add_universal(U_SUBST, sym, sig.walk[(4 * e + 2) as usize], sig);
    }
    add_universal(U_ELIDED, if param >= 0 { param } else { 0 }, e, sig)
}

// RULE: D4.2 (E4) error borrowck.elision at function f's result (at pos):
// an elided output region with no input region to take.
fn elision_error(f: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let node = fn_node(crate::places::front::fn_template(f, pcx), pcx);
    let saved = pcx.err_kind;
    pcx.err_kind = c"borrowck.elision";
    crate::base::diag::err_begin(pos, pcx);
    crate::base::diag::err_fmt(
        format_args("the result of '{}' borrows, but from which parameter is not said: it has no single reference parameter and no `&self`",
            str::from_utf8(sym_text(pcx.nodes[node as usize].a, pcx)).unwrap()),
        pcx);
    crate::base::diag::err_help(c"name the lifetime the result borrows from: `fn f<'a>(x: &'a T, y: &U) -> &'a T` (rustc E0106)", pcx);
    crate::base::diag::err_end_soft(pcx);
    pcx.err_kind = saved;
}

// ---- The regions of a place (D3.3) ----

// RULE: D3.3 The regions of place (l, p): the variables of the slots of
// its type, positionally, pushed to out (0 for a slot with no variable:
// an MVS std struct's view, R2). From l's slots, by its projections: a
// deref (through a reference: its region dropped) and an index of a view
// (D1.4: its region dropped) keep the pointee's, the element's; an index
// of an array or a raw pointer's buffer the element's (all of them); a
// field the field's, mapped from the parent's (field_map).
pub fn place_regions(l: i64, p: i64, pbody: &Body<Comp>, out: &mut Vec<i64, Comp>,
    pcx: &mut Ctx<Comp>) {
    let mut path: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut q = p;
    while q > 0 {
        path.push(q);
        q = pbody.projs[q as usize].parent;
    }
    let mut cur: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..slots_bound(l, pbody) {
        cur.push(slot_var(l, i, pbody));
    }
    let mut next: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut map: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut parent: i64 = 0;
    let mut i = path.len() as i64 - 1;
    while i >= 0 {
        let pj = path[i as usize];
        let kind = pbody.projs[pj as usize].kind;
        let val = pbody.projs[pj as usize].val;
        let bt = full_place_type(l, parent, pbody, pcx);
        let st = full_place_type(l, pj, pbody, pcx);
        next.clear();
        if kind == PJ_DEREF || kind == PJ_INDEX || kind == PJ_CONST {
            // (the pointee's, the element's: the last of them)
            let keep = slot_count(st, pcx);
            let from = cur.len() as i64 - keep;
            for j in 0..keep {
                next.push(if from + j >= 0 { cur[(from + j) as usize] } else { 0 });
            }
        } else if kind == PJ_FIELD || kind == PJ_UNION {
            let variant: i64 = if parent > 0 && pbody.projs[parent as usize].kind == PJ_VARIANT {
                pbody.projs[parent as usize].val
            } else { -1 };
            map.clear();
            field_map(bt, val, variant, &mut map, pcx);
            for j in 0..map.len() as i64 {
                let m = map[j as usize];
                next.push(if m == MAP_STATIC { 1 }
                    else if m >= 0 && m < cur.len() as i64 { cur[m as usize] } else { 0 });
            }
        } else {
            // (PJ_VARIANT: the enum's, for the field after it)
            for j in 0..cur.len() as i64 {
                next.push(cur[j as usize]);
            }
        }
        cur.clear();
        for j in 0..next.len() as i64 {
            cur.push(next[j as usize]);
        }
        parent = pj;
        i -= 1;
    }
    for j in 0..cur.len() as i64 {
        out.push(cur[j as usize]);
    }
}

// RULE: D3.3 Field k of a value of type t (of variant v's payload when v
// >= 0): for each slot of the field's type, the index of the owner's slot
// it is (a declared lifetime 'aᵢ: i; a slot of a type parameter's
// argument: its place among the arguments'), MAP_STATIC or MAP_NONE,
// pushed to out. A tuple's or a closure's field: its range of the owner's
// slots.
pub fn field_map(t0: i64, k: i64, v: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let mut t = t0;
    while t > 0 && pcx.types[t as usize].kind == TyKind::Distinct {
        t = pcx.types[t as usize].a;
    }
    if t <= 0 {
        return;
    }
    let tk = pcx.types[t as usize].kind;
    if tk == TyKind::Tuple
        || tk == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        let count = if tk == TyKind::Tuple { pcx.types[t as usize].count }
            else { struct_field_count(pcx.types[t as usize].a, pcx) };
        let mut off: i64 = 0;
        for i in 0..count {
            let ft = if tk == TyKind::Tuple { type_elem(t, i, pcx) }
                else { struct_field_ty(pcx.types[t as usize].a, i, pcx) };
            // (a by-reference capture: its loan's slot first, which the
            // field's raw pointer type does not hold, D10.2)
            let n = if tk == TyKind::Tuple { slot_count(ft, pcx) }
                else { capture_slots(pcx.types[t as usize].a, i, 0, pcx) };
            let skip = n - slot_count(ft, pcx);
            if i == k {
                for j in skip..n {
                    out.push(off + j);
                }
            }
            off += n;
        }
        return;
    }
    if tk == TyKind::Array {
        // RULE: D3.3 (0.28.0) an element of an array: the array's slots,
        // its element type's (`[s.as_str(), "x"]` holds the loan of s; 0.27.8
        // mapped none, so the loan did not reach the array)
        for j in 0..slot_count(pcx.types[t as usize].a, pcx) {
            out.push(j);
        }
        return;
    }
    if tk == TyKind::Slice {
        // (a view's parts: its data pointer, the element's slots; its length)
        // (Z9.1: a fat raw pointer has no region of its own)
        let own: i64 = if pcx.types[t as usize].b == REF_RAW { 0 } else { 1 };
        if k == 0 {
            for j in 0..slot_count(pcx.types[t as usize].a, pcx) {
                out.push(own + j);
            }
        }
        return;
    }
    if tk != TyKind::Struct && tk != TyKind::Enum {
        return;
    }
    let node = adt_node(t, pcx);
    let mut fty: i64 = 0;
    let mut fast: i64 = 0;
    if tk == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        if k < 0 || k >= struct_field_count(s, pcx) {
            return;
        }
        fty = struct_field_ty(s, k, pcx);
        if is_node(node, NodeKind::Struct, pcx) && k < pcx.nodes[node as usize].count {
            fast = pcx.nodes[child(node, k, pcx) as usize].b;
        }
    } else {
        if v < 0 || k < 0 || k >= crate::places::ir::variant_field_count(v, pcx) {
            return;
        }
        fty = variant_field(v, k, pcx);
        let vn = pcx.variants[v as usize].node;
        if is_node(vn, NodeKind::Variant, pcx) && k < pcx.nodes[vn as usize].count {
            let f = child(vn, k, pcx);
            fast = if is_node(f, NodeKind::Field, pcx) { pcx.nodes[f as usize].b } else { f };
        }
    }
    let lts: i64 = if node > 0 { lifetimes_of(node, pcx) } else { 0 };
    let m = decl_lifetimes(node, pcx);
    let mut walk: Vec<i64, Comp> = Vec::new_in(Comp {});
    bind_walk(fast, fty, if node > 0 { pcx.nodes[node as usize].g } else { 0 }, 0, -1, &mut walk, 0,
        pcx, -1);
    for e in 0..walk.len() as i64 / 4 {
        let b = walk[(4 * e) as usize];
        if b == B_STATIC {
            out.push(MAP_STATIC);
        } else if b == B_NAMED {
            let i = lifetime_index(lts, walk[(4 * e + 1) as usize], pcx);
            out.push(if i >= 0 { i } else { MAP_NONE });
        } else if param_kind(b) == B_PARAM {
            let mut off = m;
            let a = walk[(4 * e + 1) as usize];
            for i in 0..a {
                if i < adt_targ_count(t, pcx) {
                    off += slot_count(adt_targ(t, i, pcx), pcx);
                }
            }
            out.push(off + walk[(4 * e + 2) as usize]);
        } else {
            out.push(MAP_NONE);
        }
    }
}

// RULE: D3.6 (a `let` type annotation, rustc's user type annotation) The
// regions the annotation tn of local l writes: pairs (l's slot variable,
// the variable it must contain: 'static's, 1, or a named lifetime's
// universal) pushed to out. An elided region writes nothing.
pub fn annot_regions(l: i64, tn: i64, pbody: &Body<Comp>, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    let mut walk = Vec::<i64, Comp>::new_in(Comp {});
    bind_walk(tn, pbody.locals[l as usize].ty, 0, 0, -1, &mut walk, 0, pcx, -1);
    let n = walk.len() as i64 / 4;
    if n != slots_bound(l, pbody) {
        return;
    }
    for j in 0..n {
        let b = walk[(4 * j) as usize];
        let mut target: i64 = 0;
        if b == B_STATIC {
            target = 1;
        } else if b == B_NAMED {
            for r in 1..region_count(pbody) + 1 {
                if region_origin(r, pbody) == RO_UNIVERSAL && region_word(r, 0, pbody) == U_NAMED
                    && region_word(r, 1, pbody) == walk[(4 * j + 1) as usize] {
                    target = r;
                }
            }
        }
        if target > 0 {
            out.push(slot_var(l, j, pbody));
            out.push(target);
        }
    }
}

// ---- Variance (D5) ----

// RULE: D5.1 xform(c, w): the variance of a position of variance w under
// a context c.
pub fn xform(c: i64, w: i64) -> i64 {
    if c == V_BI || w == V_BI {
        V_BI
    } else if c == V_CO {
        w
    } else if c == V_INV {
        V_INV
    } else if w == V_CO {
        V_CONTRA
    } else if w == V_CONTRA {
        V_CO
    } else {
        V_INV
    }
}

// The variance table's index of the declaration of struct or enum type t
// (its template's), or -1.
fn decl_index(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        if pcx.structs[s as usize].closure != 0 {
            return -1;
        }
        return if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl - 1 } else { s };
    }
    if pcx.types[t as usize].kind == TyKind::Enum {
        let e = enum_info(pcx.types[t as usize].a, pcx);
        return pcx.structs.len() as i64 + if e.tmpl != 0 { e.tmpl - 1 }
            else { pcx.types[t as usize].a };
    }
    -1
}

// The variance of declared parameter i (lifetimes first, then the type
// parameters) of declaration d (decl_index's): invariant when it has no
// entry (made after the table, or not walked).
pub fn decl_variance(d: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    if d < 0 || d >= pcx.variance_at.len() as i64 {
        return V_INV;
    }
    let at = pcx.variance_at[d as usize];
    if at < 0 { V_INV } else { pcx.variances[(at + i) as usize] }
}

// RULE: D5.4 The variance of each slot of type t under context c, pushed
// to out (parallel to t's slots).
pub fn slot_variances(t: i64, c: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    slot_variances_in(t, c, 0, out, pcx);
}

fn slot_variances_in(t: i64, c: i64, depth: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    if t <= 0 {
        return;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr {
        // RULE: D5.2 (`&'a T`: 'a +, T +; `&'a mut T`: T o; the one raw
        // `*T` of v0.27.0: o)
        if is_ref_kind(pcx.types[t as usize].b) {
            out.push(c);
            let inner = if pcx.types[t as usize].b == REF_MUT { xform(c, V_INV) } else { c };
            slot_variances_in(pcx.types[t as usize].a, inner, depth + 1, out, pcx);
        } else {
            slot_variances_in(pcx.types[t as usize].a, xform(c, V_INV), depth + 1, out, pcx);
        }
        return;
    }
    if k == TyKind::Slice && pcx.types[t as usize].b == REF_RAW {
        // RULE: Z9.1, D5.2 (a fat raw pointer: no region of its own; its
        // pointee o, as a thin raw pointer's)
        slot_variances_in(pcx.types[t as usize].a, xform(c, V_INV), depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Slice {
        out.push(c);
        let inner = if pcx.types[t as usize].b == REF_MUT { xform(c, V_INV) } else { c };
        slot_variances_in(pcx.types[t as usize].a, inner, depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Unsized {
        // RULE: Z9.1c (0.27.4: the place: its element's, as slots_in)
        let v = pcx.types[t as usize].a;
        let s = if pcx.types[v as usize].kind == TyKind::Distinct { pcx.types[v as usize].a }
            else { v };
        slot_variances_in(pcx.types[s as usize].a, c, depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Array || k == TyKind::Distinct {
        slot_variances_in(pcx.types[t as usize].a, c, depth + 1, out, pcx);
        return;
    }
    if k == TyKind::Tuple {
        for i in 0..pcx.types[t as usize].count {
            slot_variances_in(type_elem(t, i, pcx), c, depth + 1, out, pcx);
        }
        return;
    }
    if k == TyKind::Struct && pcx.structs[pcx.types[t as usize].a as usize].closure != 0 {
        let s = pcx.types[t as usize].a;
        for i in 0..struct_field_count(s, pcx) {
            if capture_ref(s, i, pcx) {
                // (a by-reference capture: `&'c T` or `&'c mut T`, D10.2)
                out.push(c);
                let inner = if capture_mode(s, i, pcx) == 2 { xform(c, V_INV) } else { c };
                slot_variances_in(pcx.types[struct_field_ty(s, i, pcx) as usize].a, inner,
                    depth + 1, out, pcx);
                continue;
            }
            slot_variances_in(struct_field_ty(s, i, pcx), c, depth + 1, out, pcx);
        }
        // RULE: D19.1 (X_C: its variance in `fn(A..) -> R`)
        let id = pcx.structs[s as usize].closure - 1;
        for q in 0..xc_count(s, pcx) {
            out.push(xform(c, pcx.capture_list[(pcx.closures[id as usize].xc_at + q) as usize]));
        }
        return;
    }
    if k == TyKind::Struct || k == TyKind::Enum {
        let d = decl_index(t, pcx);
        let m = decl_lifetimes(adt_node(t, pcx), pcx);
        for i in 0..m {
            out.push(xform(c, decl_variance(d, i, pcx)));
        }
        for i in 0..adt_targ_count(t, pcx) {
            slot_variances_in(adt_targ(t, i, pcx), xform(c, decl_variance(d, m + i, pcx)),
                depth + 1, out, pcx);
        }
    }
}

// RULE: D5.3 The variance table: every struct's and enum's declared
// parameters' variance, by walking their fields' types to a fixpoint
// (each starts bivariant); a parameter of a rust-edition type left
// bivariant is error borrowck.unused_param. Once a program, before its
// bodies (run_places, a rust-edition program's).
pub fn variance_table(pcx: &mut Ctx<Comp>) {
    let ns = pcx.structs.len() as i64;
    let total = ns + pcx.enum_count;
    pcx.variance_at.clear();
    pcx.variances.clear();
    // (a generic declaration is walked with an instance's field types, the
    // first one's: they resolve the names of its fields' types)
    let mut inst: Vec<i64, Comp> = Vec::new_in(Comp {});
    for _ in 0..total {
        inst.push(-1);
    }
    for d in 0..total {
        let (_, tmpl, closure) = decl_record(d, pcx);
        if tmpl != 0 && !closure {
            let td = if d < ns { tmpl - 1 } else { ns + tmpl - 1 };
            if td >= 0 && td < total && inst[td as usize] < 0 {
                inst[td as usize] = d;
            }
        }
    }
    // (0.27.2: a generic declaration of std with no instance is no type of
    // any body: not walked, as one made after the table (decl_variance:
    // invariant); a program's own is, for borrowck.unused_param, and every
    // one under --std-check and --emit-places. std has hundreds; a
    // program uses few.)
    let whole = crate::places::borrowck::stdcheck::std_check(pcx) || pcx.emit_places > 0;
    for d in 0..total {
        let (node, tmpl, closure) = decl_record(d, pcx);
        if tmpl != 0 || closure || node <= 0
            || !whole && inst[d as usize] < 0 && decl_type_params(node, pcx) > 0
            && !crate::front::conv::user_at(pcx.nodes[node as usize].start, pcx) {
            pcx.variance_at.push(-1);
            continue;
        }
        let np = decl_lifetimes(node, pcx) + decl_type_params(node, pcx);
        if np == 0 {
            pcx.variance_at.push(-1);
            continue;
        }
        pcx.variance_at.push(pcx.variances.len() as i64);
        for _ in 0..np {
            pcx.variances.push(V_BI);
        }
    }
    let mut changed = true;
    let mut rounds: i64 = 0;
    while changed && rounds < 64 {
        changed = false;
        rounds += 1;
        for d in 0..total {
            if pcx.variance_at[d as usize] >= 0 {
                let typed = if decl_type_params(decl_record(d, pcx).0, pcx) > 0 { inst[d as usize] }
                    else { d };
                if walk_decl(d, typed, pcx) {
                    changed = true;
                }
            }
        }
    }
    let out = buf_new();
    for d in 0..total {
        if pcx.variance_at[d as usize] >= 0 {
            unused_params(d, pcx);
            if pcx.emit_places > 0 {
                buf_variance(out, d, pcx);
            }
        }
    }
    crate::base::buf_write_fd(out, crate::base::STDOUT);
}

// (--emit-places) Declaration d's variances, a rust-edition one's: `variance
// W: 'a +, T o` (D5.1's signs, `*` bivariant).
fn buf_variance(out: i64, d: i64, pcx: &mut Ctx<Comp>) {
    let node = decl_record(d, pcx).0;
    buf_str(out, c"variance ");
    crate::base::buf_bytes(out, sym_text(pcx.nodes[node as usize].a, pcx));
    buf_str(out, c":");
    let lts = lifetimes_of(node, pcx);
    let m = decl_lifetimes(node, pcx);
    for i in 0..m + decl_type_params(node, pcx) {
        let pn = if i < m { child(lts, i, pcx) }
            else { child(pcx.nodes[node as usize].g, i - m, pcx) };
        buf_str(out, if i == 0 { c" " } else { c", " });
        if i < m {
            buf_str(out, c"'");
        }
        crate::base::buf_bytes(out, sym_text(pcx.nodes[pn as usize].a, pcx));
        let v = decl_variance(d, i, pcx);
        buf_str(out, if v == V_CO { c" +" } else if v == V_CONTRA { c" -" }
            else if v == V_INV { c" o" } else { c" *" });
    }
    buf_str(out, c"\n");
}

// Declaration d's (variance table index) node, template (+1) and whether
// it is a closure's env.
fn decl_record(d: i64, pcx: &Ctx<Comp>) -> (i64, i64, bool) {
    let ns = pcx.structs.len() as i64;
    if d < ns {
        return (pcx.structs[d as usize].node, pcx.structs[d as usize].tmpl,
            pcx.structs[d as usize].closure != 0);
    }
    let e = enum_info(d - ns, pcx);
    (e.node, e.tmpl, false)
}

// One round of D5.3 over declaration d's fields (their types read with
// declaration `typed`'s, an instance's, -1: none): whether a variance
// changed.
fn walk_decl(d: i64, typed: i64, pcx: &mut Ctx<Comp>) -> bool {
    let ns = pcx.structs.len() as i64;
    let node = decl_record(d, pcx).0;
    let mut changed = false;
    if d < ns {
        for k in 0..pcx.nodes[node as usize].count {
            let field = child(node, k, pcx);
            let ft: i64 = if typed >= 0
                && k < struct_field_count(typed, pcx) { struct_field_ty(typed, k, pcx) }
                else { 0 };
            if var_walk(pcx.nodes[field as usize].b, ft, V_CO, d, node, 0, pcx) {
                changed = true;
            }
        }
        return changed;
    }
    // (an enum: every variant's fields; the typed instance's variants are
    // in the same order)
    let first: i64 = if typed >= 0 { enum_info(typed - ns, pcx).variants } else { -1 };
    for i in 0..pcx.nodes[node as usize].count {
        let vn = child(node, i, pcx);
        for k in 0..pcx.nodes[vn as usize].count {
            let f = child(vn, k, pcx);
            let fast = if is_node(f, NodeKind::Field, pcx) { pcx.nodes[f as usize].b } else { f };
            let ft: i64 = if first >= 0
                && k < crate::places::ir::variant_field_count(first + i, pcx) {
                variant_field(first + i, k, pcx)
            } else { 0 };
            if var_walk(fast, ft, V_CO, d, node, 0, pcx) {
                changed = true;
            }
        }
    }
    changed
}

// Parameter i of declaration d (node dn) occurs at context c: its
// variance met with c; whether it changed.
fn meet(d: i64, i: i64, c: i64, pcx: &mut Ctx<Comp>) -> bool {
    let at = pcx.variance_at[d as usize] + i;
    let old = pcx.variances[at as usize];
    if (old | c) == old {
        return false;
    }
    (pcx.variances[at as usize]) = old | c;
    true
}

// A lifetime written as sym at context c, in declaration d's (node dn)
// fields.
fn lifetime_at(sym: i64, c: i64, d: i64, dn: i64, pcx: &mut Ctx<Comp>) -> bool {
    let i = lifetime_index(lifetimes_of(dn, pcx), sym, pcx);
    i >= 0 && meet(d, i, c, pcx)
}

// The walk of a field's type node n (with its checker type t, 0: unknown)
// at context c, for declaration d (node dn): D5.2's constructors, D5.3's
// user types (their variance as it is so far).
fn var_walk(n: i64, t: i64, c: i64, d: i64, dn: i64, depth: i64, pcx: &mut Ctx<Comp>) -> bool {
    if n <= 0 || c == V_BI {
        return false;
    }
    let k = pcx.nodes[n as usize].kind;
    let tk = if t > 0 { pcx.types[t as usize].kind } else { TyKind::None };
    let mut changed = false;
    if k == NodeKind::TyPtr {
        let inner_t: i64 = if tk == TyKind::Ptr { pcx.types[t as usize].a } else { 0 };
        let mut inner = c;
        if (pcx.nodes[n as usize].p & NODE_REF) != 0 {
            changed = lifetime_at(pcx.nodes[n as usize].c, c, d, dn, pcx);
            if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0 {
                inner = xform(c, V_INV);
            }
        } else if pcx.nodes[n as usize].c == 2 {
            // (`*mut T`: o; `*const T`, and MVS's `*T`, an owner's pointer
            // in std's containers: +)
            inner = xform(c, V_INV);
        }
        return var_walk(pcx.nodes[n as usize].a, inner_t, inner, d, dn, depth + 1, pcx) || changed;
    }
    if k == NodeKind::TySlice {
        changed = lifetime_at(pcx.nodes[n as usize].c, c, d, dn, pcx);
        let inner = if (pcx.nodes[n as usize].p & NODE_REF_MUT) != 0 { xform(c, V_INV) } else { c };
        let inner_t: i64 = if tk == TyKind::Slice { pcx.types[t as usize].a } else { 0 };
        return var_walk(pcx.nodes[n as usize].a, inner_t, inner, d, dn, depth + 1, pcx) || changed;
    }
    if k == NodeKind::TyArray {
        let inner_t: i64 = if tk == TyKind::Array { pcx.types[t as usize].a } else { 0 };
        return var_walk(pcx.nodes[n as usize].a, inner_t, c, d, dn, depth + 1, pcx);
    }
    if k == NodeKind::TyTuple {
        for i in 0..pcx.nodes[n as usize].count {
            let et: i64 = if tk == TyKind::Tuple
                && i < pcx.types[t as usize].count { type_elem(t, i, pcx) }
                else { 0 };
            if var_walk(child(n, i, pcx), et, c, d, dn, depth + 1, pcx) {
                changed = true;
            }
        }
        return changed;
    }
    if k == NodeKind::TyFn {
        for i in 0..pcx.nodes[n as usize].count {
            if var_walk(child(n, i, pcx), 0, xform(c, V_CONTRA), d, dn, depth + 1, pcx) {
                changed = true;
            }
        }
        return var_walk(pcx.nodes[n as usize].a, 0, c, d, dn, depth + 1, pcx) || changed;
    }
    if k != NodeKind::TyName {
        return false;
    }
    let sym = pcx.nodes[n as usize].a;
    let m = decl_lifetimes(dn, pcx);
    if pcx.nodes[n as usize].list == 0 && pcx.nodes[n as usize].g == 0 {
        let i = param_index(pcx.nodes[dn as usize].g, sym, pcx);
        if i >= 0 {
            return meet(d, m + i, c, pcx);
        }
        if sym_text(sym, pcx) == b"str" {
            return lifetime_at(pcx.nodes[n as usize].c, c, d, dn, pcx);
        }
    }
    // RULE: D5.3 (a projection of a parameter, `U::IntoIter`: U is used,
    // invariant there, as rustc reads it)
    if pcx.nodes[n as usize].list != 0 && pcx.nodes[n as usize].count > 0 {
        let first = child(n, 0, pcx);
        let i: i64 = if pcx.nodes[first as usize].kind == NodeKind::Ident {
            param_index(pcx.nodes[dn as usize].g, pcx.nodes[first as usize].a, pcx)
        } else { -1 };
        if i >= 0 {
            return meet(d, m + i, xform(c, V_INV), pcx);
        }
    }
    // a constructor applied: its parameters' variance, D5.2's or as its
    // declaration's is so far; unknown (no checker type): invariant
    let name = sym_text(sym, pcx);
    let cell = name == b"Cell" || name == b"UnsafeCell" || name == b"RefCell";
    let phantom = name == b"PhantomData";
    let dd: i64 = if t > 0 && (tk == TyKind::Struct || tk == TyKind::Enum) { decl_index(t, pcx) }
        else { -1 };
    let dm: i64 = if dd >= 0 { decl_lifetimes(adt_node(t, pcx), pcx) } else { 0 };
    let lts = lifetimes_of(n, pcx);
    if lts > 0 {
        for i in 0..pcx.nodes[lts as usize].count {
            let w = if dd >= 0 { decl_variance(dd, i, pcx) } else { V_INV };
            if lifetime_at(pcx.nodes[child(lts, i, pcx) as usize].a, xform(c, w), d, dn, pcx) {
                changed = true;
            }
        }
    }
    let args = pcx.nodes[n as usize].g;
    if args > 0 {
        for i in 0..pcx.nodes[args as usize].count {
            let w = if phantom { V_CO } else if cell { V_INV }
                else if dd >= 0 { decl_variance(dd, dm + i, pcx) } else { V_INV };
            let at: i64 = if dd >= 0 && i < adt_targ_count(t, pcx) { adt_targ(t, i, pcx) }
                else { 0 };
            if var_walk(child(args, i, pcx), at, xform(c, w), d, dn, depth + 1, pcx) {
                changed = true;
            }
        }
    }
    changed
}

// RULE: D5.3 error borrowck.unused_param for each parameter of
// declaration d, a rust-edition one, its fields never name (rustc E0392).
fn unused_params(d: i64, pcx: &mut Ctx<Comp>) {
    let node = decl_record(d, pcx).0;
    // (the known item phantom_data, std's PhantomData: built in, its
    // parameter the marker's; rustc's is a lang item)
    if sym_text(pcx.nodes[node as usize].a, pcx) == b"PhantomData" {
        let key = crate::front::known::std_key(pcx.nodes[node as usize].a, pcx);
        if key >= 0 && crate::front::types::item_node_of(key, pcx) == node {
            return;
        }
    }
    let lts = lifetimes_of(node, pcx);
    let m = decl_lifetimes(node, pcx);
    for i in 0..m + decl_type_params(node, pcx) {
        if decl_variance(d, i, pcx) != V_BI {
            continue;
        }
        let pn = if i < m { child(lts, i, pcx) }
            else { child(pcx.nodes[node as usize].g, i - m, pcx) };
        let saved = pcx.err_kind;
        pcx.err_kind = c"borrowck.unused_param";
        crate::base::diag::err_begin(pcx.nodes[pn as usize].start, pcx);
        crate::base::diag::err_fmt(
            format_args("the parameter '{}' of '{}' is never used in its fields",
                str::from_utf8(sym_text(pcx.nodes[pn as usize].a, pcx)).unwrap(),
                str::from_utf8(sym_text(pcx.nodes[node as usize].a, pcx)).unwrap()),
            pcx);
        crate::base::diag::err_help(if i < m {
            c"use it in a field, or add a field `PhantomData<&'a ()>` (rustc E0392)"
        } else {
            c"use it in a field, or add a field `PhantomData<T>` (rustc E0392)"
        }, pcx);
        crate::base::diag::err_end_soft(pcx);
        pcx.err_kind = saved;
    }
}
