// Loop analysis and the canonical form of loops (0.4), with the utilities
// the loop transformations share: an SSA updater and the cloning of a
// region of blocks.
//
// The loop forest: a natural loop per header (every back edge t -> h, where
// h dominates t, adds to h's loop the blocks that reach t without passing
// h); loops with distinct headers are nested or disjoint. A loop in
// canonical form has a preheader (its header's only predecessor outside
// the loop, ending in a jump), a single latch (the header's only
// predecessor inside the loop) and dedicated exits (every block outside
// the loop that a loop block branches to has only predecessors inside the
// loop). LCSSA: a value defined in a loop and used outside it is used
// through a phi in an exit block.

// Per loop: its header, parent loop (-1: outermost), depth (1: outermost)
// and blocks: LP_BLOCKS[LP_START[l]..][..LP_COUNT[l]], the header first.
use crate::base::{IntVec, alloc_array, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_insert_before, ir_make, ir_new_block,
    ir_operand, ir_operand_count, ir_prepend, ir_set_operand,
};
use crate::middle::ir::cfg::{
    case_target, case_value, copy_terminator, pred_index, redirect_succ, succ, succ_count,
    switch_rebuild_succs,
};
use crate::middle::ir::verify::verify_func;
use crate::middle::lower::ssa::{new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{
    compute_dominators, dominates, remove_pred, remove_trivial_phis, resolve_all, simplify_cfg,
};

pub fn loop_count(cx: &mut FnCtx<Comp>) -> i64 {
    cx.lp_header.len() as i64
}

pub fn loop_header(cx: &mut FnCtx<Comp>, l: i64) -> i64 {
    unsafe { (cx.lp_header[l as usize]) }
}

pub fn loop_block(cx: &mut FnCtx<Comp>, l: i64, i: i64) -> i64 {
    (cx.lp_blocks[((cx.lp_start[l as usize]) + i) as usize])
}

pub fn loop_size(cx: &mut FnCtx<Comp>, l: i64) -> i64 {
    (cx.lp_count[l as usize])
}

// Whether block b belongs to loop l (or to a loop nested in it).
pub fn loop_contains(cx: &mut FnCtx<Comp>, l: i64, b: i64) -> bool {
    unsafe {
        if b >= cx.lp_nblocks {
            return false;
        }
        let mut x = (cx.lp_of[b as usize]) - 1;
        while x >= 0 {
            if x == l {
                return true;
            }
            x = (cx.lp_parent[x as usize]);
        }
        false
    }
}

// The innermost loop containing block b, or -1.
pub fn innermost_loop(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    if b >= cx.lp_nblocks { -1 } else { unsafe { (cx.lp_of[b as usize]) - 1 } }
}

// Whether loop l contains no other loop.
pub fn is_innermost(cx: &mut FnCtx<Comp>, l: i64) -> bool {
    for k in 0..loop_count(cx) {
        if (cx.lp_parent[k as usize]) == l {
            return false;
        }
    }
    true
}

// A per-block table (indexed by block id) kept from call to call: all 0,
// with room for twice the function's blocks, so that a block made after
// the call (a preheader, a copy) still has an entry. (The room is kept:
// allocating one per call would cost a malloc per pass.)
pub fn block_array(table: &mut Vec<i64, Comp>, nblocks: usize) {
    table.clear();
    table.resize((nblocks + 1) * 2, 0);
}

fn new_stamp(cx: &mut FnCtx<Comp>) -> i64 {
    cx.lp_stamp += 1;
    cx.lp_stamp
}

// Finds the loops of function fi (and its dominators and block layout).
pub fn analyze_loops(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        compute_dominators(cx, fi);
        cx.lp_header.clear();
        cx.lp_parent.clear();
        cx.lp_depth.clear();
        cx.lp_start.clear();
        cx.lp_count.clear();
        cx.lp_blocks.clear();
        cx.lp_nblocks = cx.blocks.len() as i64;
        block_array(&mut cx.lp_of, cx.blocks.len());
        // (Stamps only grow, so LP_SEEN needs no clearing.)
        block_array(&mut cx.lp_seen, cx.blocks.len());
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.order.len() as i64 {
            let h = (cx.order[i as usize]);
            let start = cx.lp_blocks.len() as i64;
            let stamp = new_stamp(cx);
            for k in 0..(cx.blocks[h as usize]).preds.len() as i64 {
                let t = ((cx.blocks[h as usize]).preds[k as usize]);
                // (h dominates t only when t is not earlier in the
                // order: the walk up t's dominators is for back edges)
                if (cx.blocks[t as usize]).order < (cx.blocks[h as usize]).order
                    || !dominates(cx, h, t) {
                    continue;
                }
                if cx.lp_blocks.len() as i64 == start {
                    (cx.lp_seen[h as usize]) = stamp;
                    cx.lp_blocks.push(h);
                }
                if (cx.lp_seen[t as usize]) != stamp {
                    (cx.lp_seen[t as usize]) = stamp;
                    cx.lp_blocks.push(t);
                    work.push(t);
                }
                while work.len() as i64 > 0 {
                    let x = work.pop();
                    for m in 0..(cx.blocks[x as usize]).preds.len() as i64 {
                        let p = ((cx.blocks[x as usize]).preds[m as usize]);
                        if (cx.blocks[p as usize]).order >= 0
                            && (cx.lp_seen[p as usize]) != stamp {
                            (cx.lp_seen[p as usize]) = stamp;
                            cx.lp_blocks.push(p);
                            work.push(p);
                        }
                    }
                }
            }
            if cx.lp_blocks.len() as i64 > start {
                cx.lp_header.push(h);
                cx.lp_parent.push(-1);
                cx.lp_depth.push(1);
                cx.lp_start.push(start);
                cx.lp_count.push(cx.lp_blocks.len() as i64 - start);
            }
        }
        free(work.data as *mut u8);
        // Nesting: the loops from the largest to the smallest; the innermost
        // loop seen so far that contains a header is its parent.
        let n = loop_count(cx);
        let by_size = alloc_array::<i64>(n + 1);
        for l in 0..n {
            let mut k = l;
            while k > 0
                && (cx.lp_count[(*by_size.add((k - 1) as usize)) as usize])
                < (cx.lp_count[l as usize]) {
                (*by_size.add(k as usize)) = (*by_size.add((k - 1) as usize));
                k -= 1;
            }
            (*by_size.add(k as usize)) = l;
        }
        for i in 0..n {
            let l = (*by_size.add(i as usize));
            let header = loop_header(cx, l);
            let parent = cx.lp_of[header as usize] - 1;
            (cx.lp_parent[l as usize]) = parent;
            (cx.lp_depth[l as usize]) = if parent < 0 { 1 }
                else { (cx.lp_depth[parent as usize]) + 1 };
            for k in 0..loop_size(cx, l) {
                let b = loop_block(cx, l, k);
                cx.lp_of[b as usize] = l + 1;
            }
        }
        free(by_size as *mut u8);
    }
}

// ---- Canonical form ----

// The preheader of loop l (its header's only outside predecessor, which
// jumps to it), or 0.
pub fn loop_preheader(cx: &mut FnCtx<Comp>, l: i64) -> i64 {
    unsafe {
        let h = loop_header(cx, l);
        let mut found: i64 = 0;
        for k in 0..(cx.blocks[h as usize]).preds.len() as i64 {
            let p = ((cx.blocks[h as usize]).preds[k as usize]);
            if !loop_contains(cx, l, p) {
                if found != 0 {
                    return 0;
                }
                found = p;
            }
        }
        if found == 0 || (cx.blocks[found as usize]).term != Term::Jump {
            return 0;
        }
        found
    }
}

// The single latch of loop l, or 0.
pub fn loop_latch(cx: &mut FnCtx<Comp>, l: i64) -> i64 {
    let h = loop_header(cx, l);
    let mut found: i64 = 0;
    unsafe {
        for k in 0..(cx.blocks[h as usize]).preds.len() as i64 {
            let p = ((cx.blocks[h as usize]).preds[k as usize]);
            if loop_contains(cx, l, p) {
                if found != 0 {
                    return 0;
                }
                found = p;
            }
        }
    }
    found
}

// The exit blocks of loop l (outside it, entered from it) into LP_LIST.
pub fn loop_exits(cx: &mut FnCtx<Comp>, l: i64) {
    unsafe {
        cx.lp_list.clear();
        let stamp = new_stamp(cx);
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            for k in 0..succ_count(cx, b) {
                let s = succ(cx, b, k);
                if !loop_contains(cx, l, s) && (cx.lp_seen[s as usize]) != stamp {
                    (cx.lp_seen[s as usize]) = stamp;
                    cx.lp_list.push(s);
                }
            }
        }
    }
}

// Appends predecessor `pred` to block b; its k-th phi gets values[first + k].
pub fn add_pred_values(cx: &mut FnCtx<Comp>, b: i64, pred: i64, values: &[i64], first: i64) {
    unsafe {
        (cx.blocks[b as usize]).preds.push(pred);
        let mut k: i64 = 0;
        let mut phi = (cx.blocks[b as usize]).first;
        while phi != 0 && (cx.insts[phi as usize]).op == Op::Phi {
            let n = (cx.insts[phi as usize]).nargs;
            let start = cx.args.len() as i64;
            for i in 0..n {
                cx.args.push(
                    (cx.args[((cx.insts[phi as usize]).args + i) as usize]));
                cx.argty.push(0);
            }
            cx.args.push((values[(first + k) as usize]));
            cx.argty.push(0);
            (cx.insts[phi as usize]).args = start;
            (cx.insts[phi as usize]).nargs = n + 1;
            k += 1;
            phi = (cx.insts[phi as usize]).next;
        }
    }
}

// add_pred_values with the context's scratch values (LP_VALUES), which are
// taken out for the call (it takes the context, and reads no scratch list).
pub fn add_pred_lp_values(cx: &mut FnCtx<Comp>, b: i64, pred: i64, first: i64) {
    let values = std::mem::replace(&mut cx.lp_values, Vec::new_in(Comp {}));
    add_pred_values(cx, b, pred, &values, first);
    cx.lp_values = values;
}

// A new phi of type ty in block b (after its other phis) over `count`
// operands values[first..].
pub fn new_phi_in(cx: &mut FnCtx<Comp>, b: i64, ty: i64, values: &[i64], first: i64,
    count: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let phi = ir_make(cx, Op::Phi, ty, 0, 0, 0, pcx);
        (cx.insts[phi as usize]).args = cx.args.len() as i64;
        (cx.insts[phi as usize]).nargs = count;
        for i in 0..count {
            cx.args.push((values[(first + i) as usize]));
            cx.argty.push(0);
        }
        let mut last_phi: i64 = 0;
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 && (cx.insts[v as usize]).op == Op::Phi {
            last_phi = v;
            v = (cx.insts[v as usize]).next;
        }
        if last_phi == 0 {
            ir_prepend(cx, b, phi);
        } else if (cx.insts[last_phi as usize]).next == 0 {
            ir_append(cx, b, phi);
        } else {
            ir_insert_before(cx, (cx.insts[last_phi as usize]).next, phi);
        }
        phi
    }
}

// new_phi_in over the context's scratch values (LP_VALUES), taken out for
// the call as add_pred_lp_values does.
pub fn new_phi_in_lp_values(cx: &mut FnCtx<Comp>, b: i64, ty: i64, first: i64, count: i64,
    pcx: &Ctx<Comp>) -> i64 {
    let values = std::mem::replace(&mut cx.lp_values, Vec::new_in(Comp {}));
    let phi = new_phi_in(cx, b, ty, &values, first, count, pcx);
    cx.lp_values = values;
    phi
}

// Moves the predecessors `list` of block b (each once among b's
// predecessors) to a new block that jumps to b: their edges go to the new
// block, and b's phis get, for it, the operand of the one predecessor or a
// new phi in the new block over theirs. Returns the new block.
fn split_preds(cx: &mut FnCtx<Comp>, fi: i64, b: i64, list: IntVec, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        ir_enter(cx, fi, pcx);
        let nb = ir_new_block(cx);
        (cx.blocks[nb as usize]).sealed = 1;
        let n = list.len() as i64;
        let mark = cx.lp_values.len() as i64;
        let mut phi = (cx.blocks[b as usize]).first;
        while phi != 0 && (cx.insts[phi as usize]).op == Op::Phi {
            if n == 1 {
                let pred_index_v = pred_index(cx, b, (list[0]));
                let ir_arg_v = ir_arg(cx, phi, pred_index_v);
                cx.lp_values.push(ir_arg_v);
            } else {
                let first = cx.lp_values.len() as i64;
                for i in 0..n {
                    let pred_index_v1 = pred_index(cx, b, (list[i as usize]));
                    let ir_arg_v1 = ir_arg(cx, phi, pred_index_v1);
                    cx.lp_values.push(ir_arg_v1);
                }
                let np = new_phi_in_lp_values(cx, nb, (cx.insts[phi as usize]).ty, first, n, pcx);
                cx.lp_values.truncate(first as usize);
                cx.lp_values.push(np);
            }
            phi = (cx.insts[phi as usize]).next;
        }
        for i in 0..n {
            let p = (list[i as usize]);
            remove_pred(cx, b, p);
            redirect_succ(cx, p, b, nb);
            (cx.blocks[nb as usize]).preds.push(p);
        }
        add_pred_lp_values(cx, b, nb, mark);
        cx.lp_values.truncate(mark as usize);
        (cx.blocks[nb as usize]).term = Term::Jump;
        (cx.blocks[nb as usize]).s0 = b;
        nb
    }
}

// Puts loop l in canonical form; returns whether anything changed (the
// loop forest must then be found again).
fn canonicalize_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let mut outside = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut inside = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..(cx.blocks[h as usize]).preds.len() as i64 {
            let p = ((cx.blocks[h as usize]).preds[k as usize]);
            if loop_contains(cx, l, p) {
                inside.push(p);
            } else {
                outside.push(p);
            }
        }
        let mut changed = false;
        if outside.len() as i64 > 0
            && (outside.len() as i64 > 1
                || (cx.blocks[(outside[0]) as usize]).term != Term::Jump) {
            split_preds(cx, fi, h, outside, pcx);
            changed = true;
        }
        if inside.len() as i64 > 1 {
            split_preds(cx, fi, h, inside, pcx);
            changed = true;
        }
        free(outside.data as *mut u8);
        free(inside.data as *mut u8);
        if changed {
            return true;
        }
        // Dedicated exits.
        loop_exits(cx, l);
        let mut exits = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list.len() as i64 {
            exits.push((cx.lp_list[i as usize]));
        }
        let mut from = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..exits.len() as i64 {
            let e = (exits[i as usize]);
            let mut shared = false;
            from.clear();
            for k in 0..(cx.blocks[e as usize]).preds.len() as i64 {
                let p = ((cx.blocks[e as usize]).preds[k as usize]);
                if loop_contains(cx, l, p) {
                    from.push(p);
                } else {
                    shared = true;
                }
            }
            if shared {
                split_preds(cx, fi, e, from, pcx);
                changed = true;
            }
        }
        free(exits.data as *mut u8);
        free(from.data as *mut u8);
        changed
    }
}

// Puts every loop of fi in canonical form (finding the loops again after
// each change). Loops whose header is the entry are left alone.
pub fn canonicalize_loops(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut changed = false;
    for _ in 0..1000 {
        analyze_loops(cx, fi);
        let mut did = false;
        for l in 0..loop_count(cx) {
            if unsafe {
                loop_header(cx, l) != (*get_irfuncs().add(fi as usize)).entry
                    && canonicalize_loop(cx, fi, l, pcx)
            } {
                did = true;
                break;
            }
        }
        if !did {
            break;
        }
        changed = true;
    }
    changed
}

// Whether loop l is in canonical form.
pub fn is_canonical(cx: &mut FnCtx<Comp>, l: i64) -> bool {
    unsafe {
        if loop_preheader(cx, l) == 0 || loop_latch(cx, l) == 0 {
            return false;
        }
        loop_exits(cx, l);
        for i in 0..cx.lp_list.len() as i64 {
            let e = (cx.lp_list[i as usize]);
            for k in 0..(cx.blocks[e as usize]).preds.len() as i64 {
                if !loop_contains(cx, l, ((cx.blocks[e as usize]).preds[k as usize])) {
                    return false;
                }
            }
        }
        true
    }
}

// ---- The SSA updater ----

// A value defined in several blocks: ssa_write(var, block, value) for each
// definition, then ssa_read(var, block) gives the value reaching the end of
// a block (phis are placed where definitions meet; lower.vl). Every
// block must be sealed.
fn updater_var(cx: &mut FnCtx<Comp>, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    new_synth_var(cx, ty, pcx)
}

pub fn seal_all(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            (cx.blocks[b as usize]).sealed = 1;
            (cx.blocks[b as usize]).incomplete = 0;
        }
    }
}

// The block where a use of an operand happens: the block of instruction u,
// or for a phi's k-th operand, the k-th predecessor of the phi's block.
fn use_block(cx: &mut FnCtx<Comp>, u: i64, k: i64) -> i64 {
    unsafe {
        if (cx.insts[u as usize]).op == Op::Phi && k >= 3 {
            return (
                (cx.blocks[(cx.insts[u as usize]).block as usize]).preds[
                    (k - 3) as usize]);
        }
        (cx.insts[u as usize]).block
    }
}

// ---- LCSSA ----

// Makes every value defined in loop l and used outside it go through phis
// in the exit blocks. Returns whether anything changed. The dominators
// must be current.
pub fn form_lcssa(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        // Uses outside the loop of values defined inside: (user, operand index)
        // pairs; a terminator's condition is user -block (index 0).
        let mut uses = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 || (cx.blocks[b as usize]).order < 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 && (cx.insts[w as usize]).block != 0
                        && loop_contains(cx, l, (cx.insts[w as usize]).block)
                        && ! { let at_arg2 = use_block(cx, v, k); loop_contains(cx, l, at_arg2) } {
                        uses.push(v);
                        uses.push(k);
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            let c = (cx.blocks[b as usize]).cond;
            if c != 0 && (cx.insts[c as usize]).block != 0
                && loop_contains(cx, l, (cx.insts[c as usize]).block)
                && !loop_contains(cx, l, b) {
                uses.push(0 - b);
                uses.push(0);
            }
        }
        if uses.len() as i64 == 0 {
            free(uses.data as *mut u8);
            return false;
        }
        loop_exits(cx, l);
        let mut exits = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list.len() as i64 {
            exits.push((cx.lp_list[i as usize]));
        }
        // One updater variable per value (INSTS[w].mark = var + 1).
        for i in 0..uses.len() as i64 / 2 {
            let w = lcssa_used(cx, (uses[(2 * i) as usize]),
                (uses[(2 * i + 1) as usize]));
            (cx.insts[w as usize]).mark = 0;
        }
        for i in 0..uses.len() as i64 / 2 {
            let u = (uses[(2 * i) as usize]);
            let k = (uses[(2 * i + 1) as usize]);
            let w = lcssa_used(cx, u, k);
            if (cx.insts[w as usize]).mark == 0 {
                let var_id = updater_var(cx, (cx.insts[w as usize]).ty, pcx);
                (cx.insts[w as usize]).mark = var_id + 1;
                for j in 0..exits.len() as i64 {
                    let e = (exits[j as usize]);
                    if dominates(cx, (cx.insts[w as usize]).block, e) {
                        let first = cx.lp_values.len() as i64;
                        for m in 0..(cx.blocks[e as usize]).preds.len() as i64 {
                            cx.lp_values.push(w);
                        }
                        let phi = new_phi_in_lp_values(cx, e, (cx.insts[w as usize]).ty, first,
                            (cx.blocks[e as usize]).preds.len() as i64, pcx);
                        cx.lp_values.truncate(first as usize);
                        ssa_write(cx, var_id, e, phi);
                    }
                }
            }
            let var_id = (cx.insts[w as usize]).mark - 1;
            if u < 0 {
                (cx.blocks[(0 - u) as usize]).cond = ssa_read(cx, var_id, 0 - u, pcx);
            } else {
                let use_block_v = use_block(cx, u, k);
                let ssa_read_v = ssa_read(cx, var_id, use_block_v, pcx);
                ir_set_operand(cx, u, k, ssa_read_v);
            }
        }
        free(exits.data as *mut u8);
        free(uses.data as *mut u8);
        true
    }
}

fn lcssa_used(cx: &mut FnCtx<Comp>, u: i64, k: i64) -> i64 {
    if u < 0 { unsafe { (cx.blocks[(0 - u) as usize]).cond } } else { ir_operand(cx, u, k) }
}

// ---- Cloning ----

// The copy of value v when v is defined in the region being cloned (blocks
// marked `stamp` in LP_SEEN), else v.
pub fn clone_map(cx: &mut FnCtx<Comp>, v: i64, stamp: i64) -> i64 {
    unsafe {
        if v == 0 || (cx.insts[v as usize]).block == 0 {
            return v;
        }
        let b = (cx.insts[v as usize]).block;
        if b < cx.lp_nblocks
            && (cx.lp_seen[b as usize]) == stamp { (cx.insts[v as usize]).aux } else { v }
    }
}

fn clone_block_map(cx: &mut FnCtx<Comp>, b: i64, stamp: i64) -> i64 {
    unsafe {
        if b != 0 && b < cx.lp_nblocks
            && (cx.lp_seen[b as usize]) == stamp { (cx.blocks[b as usize]).aux }
        else { b }
    }
}

// A copy of instruction v (not in a block; operands as they are).
pub fn clone_inst(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        let nv = ir_make(cx, op, (cx.insts[v as usize]).ty, (cx.insts[v as usize]).a,
            (cx.insts[v as usize]).b, (cx.insts[v as usize]).imm, pcx);
        (cx.insts[nv as usize]).c = (cx.insts[v as usize]).c;
        (cx.insts[nv as usize]).cond = (cx.insts[v as usize]).cond;
        (cx.insts[nv as usize]).imm2 = (cx.insts[v as usize]).imm2;
        if pcx.ir_locs {
            (cx.inst_loc[nv as usize]) = (cx.inst_loc[v as usize]);
        }
        if (cx.insts[v as usize]).nargs > 0 || op == Op::Phi || op.is_call() {
            (cx.insts[nv as usize]).args = cx.args.len() as i64;
            (cx.insts[nv as usize]).nargs = (cx.insts[v as usize]).nargs;
            for a in 0..(cx.insts[v as usize]).nargs {
                let ir_arg_v = ir_arg(cx, v, a);
                cx.args.push(ir_arg_v);
                cx.argty.push(
                    (cx.argty[((cx.insts[v as usize]).args + a) as usize]));
            }
        }
        nv
    }
}

// Clones the blocks `list` (marked `stamp` in LP_SEEN; LP_NBLOCKS must
// cover them): BLOCKS[b].aux is b's copy and INSTS[v].aux v's. Operands
// and successors inside the region are mapped to their copies; a copy's
// predecessors are its original's, mapped, in the same order (those from
// outside the region kept: their terminators still go to the original).
pub fn clone_region(cx: &mut FnCtx<Comp>, fi: i64, list: &[i64], stamp: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let n = list.len() as i64;
        for i in 0..n {
            let b = (list[i as usize]);
            let nb = ir_new_block(cx);
            (cx.blocks[nb as usize]).sealed = 1;
            (cx.blocks[nb as usize]).novec = (cx.blocks[b as usize]).novec;
            (cx.blocks[nb as usize]).count = (cx.blocks[b as usize]).count;
            (cx.blocks[b as usize]).aux = nb;
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let nv = clone_inst(cx, v, pcx);
                ir_append(cx, nb, nv);
                (cx.insts[v as usize]).aux = nv;
                v = (cx.insts[v as usize]).next;
            }
        }
        for i in 0..n {
            let b = (list[i as usize]);
            let nb = (cx.blocks[b as usize]).aux;
            let mut v = (cx.blocks[nb as usize]).first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 {
                        let clone_map_v = clone_map(cx, w, stamp);
                        ir_set_operand(cx, v, k, clone_map_v);
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            copy_terminator(cx, nb, b);
            (cx.blocks[nb as usize]).cond = clone_map(cx,
                (cx.blocks[b as usize]).cond, stamp);
            map_successors(cx, nb, stamp);
            for k in 0..(cx.blocks[b as usize]).preds.len() as i64 {
                let clone_block_map_v = clone_block_map(cx,
                    ((cx.blocks[b as usize]).preds[k as usize]), stamp);
                (cx.blocks[nb as usize]).preds.push(clone_block_map_v);
            }
        }
    }
}

// clone_region for the blocks mark_loop_blocks listed (LP_LIST2), which
// are taken out for the call (it takes the context; cloning reads the
// stamps, not the list).
pub fn clone_lp_list2(cx: &mut FnCtx<Comp>, fi: i64, stamp: i64, pcx: &Ctx<Comp>) {
    let list = std::mem::replace(&mut cx.lp_list2, Vec::new_in(Comp {}));
    clone_region(cx, fi, &list, stamp, pcx);
    cx.lp_list2 = list;
}

// Maps the successors of block b (a copy) through clone_block_map.
fn map_successors(cx: &mut FnCtx<Comp>, b: i64, stamp: i64) {
    unsafe {
        if (cx.blocks[b as usize]).term == Term::Switch {
            let start = cx.swcases.len() as i64;
            for i in 0..(cx.blocks[b as usize]).ncases {
                let case_value_v = case_value(cx, b, i);
                cx.swcases.push(case_value_v);
                let case_target_v = case_target(cx, b, i);
                let clone_block_map_v = clone_block_map(cx, case_target_v, stamp);
                cx.swcases.push(clone_block_map_v);
            }
            (cx.blocks[b as usize]).cases = start;
            (cx.blocks[b as usize]).s0 = clone_block_map(cx, (cx.blocks[b as usize]).s0,
                stamp);
            switch_rebuild_succs(cx, b);
            return;
        }
        (cx.blocks[b as usize]).s0 = clone_block_map(cx, (cx.blocks[b as usize]).s0,
            stamp);
        (cx.blocks[b as usize]).s1 = clone_block_map(cx, (cx.blocks[b as usize]).s1,
            stamp);
    }
}

// Marks the blocks of loop l with a fresh stamp in LP_SEEN and lists them
// in LP_LIST2; returns the stamp.
pub fn mark_loop_blocks(cx: &mut FnCtx<Comp>, l: i64) -> i64 {
    let stamp = new_stamp(cx);
    cx.lp_list2.clear();
    for i in 0..loop_size(cx, l) {
        let b = loop_block(cx, l, i);
        unsafe { (cx.lp_seen[b as usize]) = stamp; }
        cx.lp_list2.push(b);
    }
    stamp
}

// The number of instructions in loop l.
pub fn loop_inst_count(cx: &mut FnCtx<Comp>, l: i64) -> i64 {
    unsafe {
        let mut n: i64 = 0;
        for i in 0..loop_size(cx, l) {
            let mut v = { let at_ix = loop_block(cx, l, i) as usize; cx.blocks[at_ix].first };
            while v != 0 {
                n += 1;
                v = (cx.insts[v as usize]).next;
            }
        }
        n
    }
}

// Whether v is defined outside loop l (constants and the like included).
pub fn invariant_in(cx: &mut FnCtx<Comp>, l: i64, v: i64) -> bool {
    unsafe {
        v == 0 || (cx.insts[v as usize]).block == 0
            || !loop_contains(cx, l, (cx.insts[v as usize]).block)
    }
}

// ---- Rotation ----

// Instructions (other than phis) a header may have to be duplicated.
const ROTATE_MAX: i64 = 16;

fn was_rotated(cx: &mut FnCtx<Comp>, h: i64) -> bool {
    for i in 0..cx.rotated.len() as i64 {
        if (cx.rotated[i as usize]) == h {
            return true;
        }
    }
    false
}

// Turns loop l, when its header tests the exit (a while loop), into a
// guarded do-while: the header's instructions are copied into the
// preheader, which branches to the body or the exit; the header, reached
// from the latch only, becomes part of the latch. Returns whether it did.
fn rotate_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let pre = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        if pre == 0 || latch == 0 || latch == h
            || (cx.blocks[h as usize]).term != Term::Branch {
            return false;
        }
        let s0 = (cx.blocks[h as usize]).s0;
        let s1 = (cx.blocks[h as usize]).s1;
        let in0 = loop_contains(cx, l, s0);
        let in1 = loop_contains(cx, l, s1);
        if in0 == in1 || s0 == s1 {
            return false;
        }
        let body = if in0 { s0 } else { s1 };
        let exit = if in0 { s1 } else { s0 };
        if body == h || was_rotated(cx, h) {
            return false;
        }
        let mut size: i64 = 0;
        let mut v = (cx.blocks[h as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op != Op::Phi {
                size += 1;
            }
            v = (cx.insts[v as usize]).next;
        }
        if size > ROTATE_MAX {
            return false;
        }
        ir_enter(cx, fi, pcx);
        cx.rotated.push(body);
        // The header's values as the preheader sees them: a phi's operand for
        // the preheader, copies of the other instructions (INSTS[v].aux).
        let pre_index = pred_index(cx, h, pre);
        v = (cx.blocks[h as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op == Op::Phi {
                (cx.insts[v as usize]).aux = ir_arg(cx, v, pre_index);
            } else {
                let nv = clone_inst(cx, v, pcx);
                for k in 0..ir_operand_count(cx, nv) {
                    let w = ir_operand(cx, nv, k);
                    if w != 0 && (cx.insts[w as usize]).block == h {
                        ir_set_operand(cx, nv, k, (cx.insts[w as usize]).aux);
                    }
                }
                ir_append(cx, pre, nv);
                (cx.insts[v as usize]).aux = nv;
            }
            v = (cx.insts[v as usize]).next;
        }
        let cond = (cx.blocks[h as usize]).cond;
        let pre_cond = if (cx.insts[cond as usize]).block
            == h { (cx.insts[cond as usize]).aux } else { cond };
        // The preheader branches like the header; the header loses it.
        (cx.blocks[pre as usize]).term = Term::Branch;
        (cx.blocks[pre as usize]).cond = pre_cond;
        (cx.blocks[pre as usize]).s0 = s0;
        (cx.blocks[pre as usize]).s1 = s1;
        remove_pred(cx, h, pre);
        for t in 0..2 {
            let s = if t == 0 { body } else { exit };
            let index = pred_index(cx, s, h);
            let first = cx.lp_values.len() as i64;
            let mut phi = (cx.blocks[s as usize]).first;
            while phi != 0 && (cx.insts[phi as usize]).op == Op::Phi {
                let w = ir_arg(cx, phi, index);
                cx.lp_values.push(if w != 0
                    && (cx.insts[w as usize]).block == h { (cx.insts[w as usize]).aux }
                    else { w });
                phi = (cx.insts[phi as usize]).next;
            }
            add_pred_lp_values(cx, s, pre, first);
            cx.lp_values.truncate(first as usize);
        }
        // Uses of the header's values elsewhere read whichever definition
        // reaches them: the header's or the preheader's.
        v = (cx.blocks[h as usize]).first;
        while v != 0 {
            (cx.insts[v as usize]).mark = 0;
            v = (cx.insts[v as usize]).next;
        }
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            // (The header's own phis use values at the latch.)
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut u = (cx.blocks[b as usize]).first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    let w = ir_operand(cx, u, k);
                    if w != 0 && (cx.insts[w as usize]).block == h {
                        let ub = use_block(cx, u, k);
                        if ub != h {
                            let rotate_var_v1 = rotate_var(cx, w, h, pre, pcx);
                            let ssa_read_v = ssa_read(cx, rotate_var_v1, ub,
                                pcx);
                            ir_set_operand(cx, u, k,
                                ssa_read_v);
                        }
                    }
                }
                u = (cx.insts[u as usize]).next;
            }
            let c = (cx.blocks[b as usize]).cond;
            if c != 0 && (cx.insts[c as usize]).block == h && b != pre && b != h {
                let rotate_var_v = rotate_var(cx, c, h, pre, pcx);
                (cx.blocks[b as usize]).cond = ssa_read(cx, rotate_var_v, b, pcx);
            }
        }
        true
    }
}

// The updater variable of header value w (defined in h, and as
// INSTS[w].aux in the preheader).
fn rotate_var(cx: &mut FnCtx<Comp>, w: i64, h: i64, pre: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (cx.insts[w as usize]).mark == 0 {
            let var_id = updater_var(cx, (cx.insts[w as usize]).ty, pcx);
            (cx.insts[w as usize]).mark = var_id + 1;
            ssa_write(cx, var_id, h, w);
            ssa_write(cx, var_id, pre, (cx.insts[w as usize]).aux);
        }
        (cx.insts[w as usize]).mark - 1
    }
}

// Rotates every loop of fi that can be; returns whether any was. One
// analysis serves them all: rotation makes no blocks and moves none
// between loops (a rotated loop's preheader now branches, which no other
// loop's rotation depends on).
pub fn rotate_loops(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        cx.rotated.clear();
        canonicalize_loops(cx, fi, pcx);
        let mut changed = false;
        // Innermost loops first: an outer loop's rotation then only adds phis
        // to inner loops already rotated. The phis an updater leaves trivial
        // go before the next rotation reads its header's phis.
        let mut depth: i64 = 0;
        for l in 0..loop_count(cx) {
            if (cx.lp_depth[l as usize]) > depth {
                depth = (cx.lp_depth[l as usize]);
            }
        }
        while depth >= 1 {
            for l in 0..loop_count(cx) {
                if (cx.lp_depth[l as usize]) == depth
                    && loop_header(cx, l) != (*get_irfuncs().add(fi as usize)).entry
                    && rotate_loop(cx, fi, l, pcx) {
                    changed = true;
                    resolve_all(cx, fi);
                    remove_trivial_phis(cx, fi, pcx);
                }
            }
            depth -= 1;
        }
        if changed {
            resolve_all(cx, fi);
            verify_func(cx, fi, c"loop rotation", pcx);
            // The old headers now have their latch as only predecessor.
            simplify_cfg(cx, fi, pcx);
        }
        changed
    }
}
