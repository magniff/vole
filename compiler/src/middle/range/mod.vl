// Value ranges and the comparisons they decide (0.4): bounds-check
// elimination, comparison folding, jump threading on implied conditions,
// and comparison chains turned into switches.
//
// A fact is a comparison (or a bool) known to hold, or not, at a block: the
// condition of every branch on the way to it along the dominator tree (when
// the edge into a block on that way is its only way in), the case of a
// switch that leads there, and for the blocks of a counted loop
// (scev.vl) `i < n` and `i >= start` for its induction variable. The
// range of an integer value is an interval (in the signed 64-bit view of
// its canonical value) from its type and its operation (masks, remainders,
// conversions, constants), narrowed by the facts that compare it with a
// constant. A comparison is decided when the facts about the same operands,
// or the ranges, leave only outcomes that agree.
//
// 0.11: phis have ranges (the union of their operands', a loop's found by
// induction: below), while a check's branch is decided; facts comparing a
// value with another bound it by the other's range; shifts and 64-bit
// conversions keep ranges; and a branch on a phi of `&&` or `||` is
// threaded from the predecessor that decided it, so that the facts on the
// way hold where it leads.

mod chains;
mod interval;
mod phi;
mod thread;

use crate::base::{alloc_array, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_BOOL, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::ir::{Cond, Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_make, ir_val};
use crate::middle::ir::Cond::{Eq, Ge, Gt, Le, Lt, Ne};
use crate::middle::ir::cfg::{case_target, case_value};
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{analyze_loops, innermost_loop, loop_count, loop_latch, loop_preheader};
use crate::middle::opt::{remove_trivial_phis, remove_unreachable, resolve_all, simplify_cfg};
use crate::middle::range::chains::chains_to_switches;
use crate::middle::range::interval::{
    MAX_I64, MIN_I64, greater, lesser, range_at, range_with_facts, type_max, type_min,
};
use crate::middle::range::phi::{FACT_RANGE_DEPTH, forget_phi_ranges};
use crate::middle::range::thread::{thread_implied, thread_phi_conditions};
use crate::middle::scev::{counted_loop, iv_start};
use crate::tools::query::checks::note_removed;

// Outcomes of a comparison as a set: 1 less, 2 equal, 4 greater.
fn cond_set(c: Cond) -> i64 {
    match c {
        Lt => 1,
        Le => 3,
        Eq => 2,
        Ne => 5,
        Gt => 4,
        Ge => 6,
    }
}

// The set with less and greater swapped (the operands swapped).
fn mirror_set(s: i64) -> i64 {
    (s & 2) | ((s & 1) << 2) | ((s & 4) >> 2)
}

fn is_order(c: Cond) -> bool {
    c != Eq && c != Ne
}

// A comparison instruction outside any block, for a fact.
fn fact_cmp(cx: &mut FnCtx<Comp>, cond: Cond, ty: i64, a: i64, b: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = ir_make(cx, Op::Cmp, TY_BOOL, a, b, 0, pcx);
    unsafe {
        (*cx.insts.add(v as usize)).cond = cond;
        (*cx.insts.add(v as usize)).imm2 = ty;
    }
    v
}

fn fact_const(cx: &mut FnCtx<Comp>, value: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    ir_make(cx, Op::Const, ty, 0, 0, value, pcx)
}

// The facts of the counted loops of the function (after analyze_loops).
fn make_loop_facts(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    cx.loop_fact_lt.clear();
    cx.loop_fact_ge.clear();
    for l in 0..loop_count(cx) {
        let mut lt: i64 = 0;
        let mut ge: i64 = 0;
        let mut iv: i64 = 0;
        let mut step: i64 = 0;
        let mut n: i64 = 0;
        let mut ne = false;
        if loop_preheader(cx, l) != 0 && loop_latch(cx, l) != 0
            && counted_loop(cx, l, &mut iv, &mut step, &mut n, &mut ne) && !ne {
            let latch = loop_latch(cx, l);
            let ty = unsafe {
                (*cx.insts.add((*cx.blocks.add(latch as usize)).cond as usize)).imm2
            };
            let start = iv_start(cx, l, iv);
            if step == 1 {
                lt = fact_cmp(cx, Lt, ty, iv, n, pcx);
                ge = fact_cmp(cx, Ge, ty, iv, start, pcx);
            } else {
                lt = fact_cmp(cx, Gt, ty, iv, n, pcx);
                ge = fact_cmp(cx, Le, ty, iv, start, pcx);
            }
        }
        cx.loop_fact_lt.push(lt);
        cx.loop_fact_ge.push(ge);
    }
}

// The facts at the start of block b into FACTS.
fn collect_facts(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    unsafe {
        cx.facts_ver += 1;
        cx.facts.clear();
        let mut x = b;
        let mut steps: i64 = 0;
        while steps < 64 {
            steps += 1;
            if (*cx.blocks.add(x as usize)).preds.len() as i64 == 1 {
                let p = ((*cx.blocks.add(x as usize)).preds[0]);
                edge_fact(cx, p, x, pcx);
            }
            let up = (*cx.blocks.add(x as usize)).idom;
            if up == x || up == 0 {
                break;
            }
            x = up;
        }
        let mut l = innermost_loop(cx, b);
        while l >= 0 {
            if l < cx.loop_fact_lt.len() as i64 && (cx.loop_fact_lt[l as usize]) != 0 {
                cx.facts.push((cx.loop_fact_lt[l as usize]));
                cx.facts.push(1);
                cx.facts.push((cx.loop_fact_ge[l as usize]));
                cx.facts.push(1);
            }
            l = (cx.lp_parent[l as usize]);
        }
    }
}

// The fact the edge p -> x gives (x reached by it), if any.
fn edge_fact(cx: &mut FnCtx<Comp>, p: i64, x: i64, pcx: &Ctx<Comp>) {
    unsafe {
        cx.facts_ver += 1;
        if (*cx.blocks.add(p as usize)).term == Term::Branch
            && (*cx.blocks.add(p as usize)).s0 != (*cx.blocks.add(p as usize)).s1 {
            let ir_val_v = ir_val(cx, (*cx.blocks.add(p as usize)).cond);
            cx.facts.push(ir_val_v);
            cx.facts.push(if (*cx.blocks.add(p as usize)).s0 == x { 1 } else { 0 });
        }
        else if (*cx.blocks.add(p as usize)).term == Term::Switch
            && (*cx.blocks.add(p as usize)).s0 != x {
            // x is the target of exactly one case: the value is that case's.
            let mut found: i64 = -1;
            let mut count: i64 = 0;
            for i in 0..(*cx.blocks.add(p as usize)).ncases {
                if case_target(cx, p, i) == x {
                    found = i;
                    count += 1;
                }
            }
            if count == 1 {
                let v = ir_val(cx, (*cx.blocks.add(p as usize)).cond);
                let ty = (*cx.insts.add(v as usize)).ty;
                let case_value_v = case_value(cx, p, found);
                let fact_const_v = fact_const(cx, case_value_v, ty, pcx);
                let fact_cmp_v = fact_cmp(cx, Eq, ty, v,
                    fact_const_v, pcx);
                cx.facts.push(fact_cmp_v);
                cx.facts.push(1);
            }
        }
    }
}

// v with conversions between 64-bit integer types (which change no bits)
// looked through, and (0.18.1) `x + 0` and `x - 0` of 64-bit integer types,
// which instcombine keeps when the type changes (a Vec's length read as a
// slice's, `sub len, 0` in u64): values equal as bits compare equal.
pub fn bits_of_value(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    unsafe {
        let mut x = ir_val(cx, v);
        loop {
            let op = (*cx.insts.add(x as usize)).op;
            if op == Op::Conv && is_integer((*cx.insts.add(x as usize)).ty)
                && is_integer((*cx.insts.add(x as usize)).imm2)
                && int_bits((*cx.insts.add(x as usize)).ty) == 64
                && int_bits((*cx.insts.add(x as usize)).imm2) == 64 {
                x = ir_val(cx, (*cx.insts.add(x as usize)).a);
            } else if (op == Op::Add || op == Op::Sub) && is_integer((*cx.insts.add(x as usize)).ty)
                && int_bits((*cx.insts.add(x as usize)).ty) == 64
                && is_const(cx, (*cx.insts.add(x as usize)).b)
                && (*cx.insts.add((*cx.insts.add(x as usize)).b as usize)).imm == 0
                && is_integer((*cx.insts.add((*cx.insts.add(x as usize)).a as usize)).ty)
                && int_bits((*cx.insts.add((*cx.insts.add(x as usize)).a as usize)).ty) == 64 {
                x = ir_val(cx, (*cx.insts.add(x as usize)).a);
            } else {
                break;
            }
        }
        x
    }
}

// ---- Ranges at a block, and the comparisons they decide ----

// Prepares the range queries of value_range_at for function fi: its
// loops and their facts (again after its control flow changes).
pub fn prepare_ranges(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    analyze_loops(cx, fi);
    make_loop_facts(cx, pcx);
    forget_phi_ranges(cx);
}

// The range of integer value v at block b (the signed 64-bit view of its
// canonical value): from its operations and the facts that hold at b.
pub fn value_range_at(cx: &mut FnCtx<Comp>, v: i64, b: i64, lo: &mut i64, hi: &mut i64,
    pcx: &Ctx<Comp>) {
    collect_facts(cx, b, pcx);
    range_at(cx, v, lo, hi, pcx);
}

// Narrows [*lo, *hi], the range of v, by the facts in FACTS comparing v
// with a constant, or (0.11; while a check's branch is decided, as for
// phis, and not too deep) with a value whose range bounds it: v < w gives
// v < w's upper bound, v > w v > w's lower one, v == w w's range (an
// unsigned comparison only with a non-negative w).
fn narrow_by_facts(cx: &mut FnCtx<Comp>, v: i64, lo: &mut i64, hi: &mut i64, depth: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        if cx.mark_ver != cx.facts_ver {
            mark_facts(cx);
        }
        let x0 = bits_of_value(cx, v);
        if x0 < cx.mark_cap && (*cx.fact_mark.add(x0 as usize)) != cx.mark_stamp {
            return;
        }
        let mut i: i64 = 0;
        while i < cx.facts.len() as i64 {
            let f = (cx.facts[i as usize]);
            let holds = (cx.facts[(i + 1) as usize]) != 0;
            i += 2;
            if (*cx.insts.add(f as usize)).op != Op::Cmp
                || !is_integer((*cx.insts.add(f as usize)).imm2) {
                continue;
            }
            let mut cond = (*cx.insts.add(f as usize)).cond;
            if !holds {
                cond = cond.negate();
            }
            let fa = bits_of_value(cx, (*cx.insts.add(f as usize)).a);
            let fb = bits_of_value(cx, (*cx.insts.add(f as usize)).b);
            let x = bits_of_value(cx, v);
            let mut k: i64 = 0;
            let mut w: i64 = 0;
            if fa == x && fa != fb {
                w = fb;
            } else if fb == x && fa != fb {
                w = fa;
                cond = cond.mirror();
            } else {
                continue;
            }
            let signed = is_signed((*cx.insts.add(f as usize)).imm2);
            let min: i64 = 0 - 9223372036854775807 - 1;
            let max: i64 = 9223372036854775807;
            // The bound w gives: k for a constant; else its range's upper end
            // for < and <=, its lower end for > and >=, both for ==.
            let mut klo: i64 = 0;
            if is_const(cx, w) {
                k = (*cx.insts.add(w as usize)).imm;
                klo = k;
            } else {
                if !cx.phi_ranges || cx.fact_nest >= FACT_RANGE_DEPTH || cond == Ne {
                    continue;
                }
                let mut whi: i64 = 0;
                cx.fact_nest += 1;
                range_with_facts(cx, w, &mut klo, &mut whi, depth + 1, pcx);
                cx.fact_nest -= 1;
                if !signed && klo < 0 {
                    continue;
                }
                k = if cond == Gt || cond == Ge { klo } else { whi };
            }
            match cond {
                Eq => {
                    if is_const(cx, w) {
                        *lo = k;
                        *hi = k;
                    } else if klo <= *hi && k >= *lo {
                        *lo = greater(*lo, klo);
                        *hi = lesser(*hi, k);
                    }
                }
                Ne => {
                    if *lo == k && k != max {
                        *lo = k + 1;
                    } else if *hi == k && k != min {
                        *hi = k - 1;
                    }
                }
                Lt | Le => {
                    let bound = if cond == Lt { if k == min { min } else { k - 1 } } else { k };
                    if signed || (k >= 0 && *lo >= 0) {
                        if bound < *hi {
                            *hi = bound;
                        }
                    } else if k >= 0 {
                        // Unsigned: below a non-negative bound, so non-negative.
                        if *lo < 0 {
                            *lo = 0;
                        }
                        if bound < *hi {
                            *hi = bound;
                        }
                    }
                }
                _ => {
                    let bound = if cond == Gt { if k == max { max } else { k + 1 } } else { k };
                    if signed || (k >= 0 && *lo >= 0) {
                        if bound > *lo {
                            *lo = bound;
                        }
                    }
                }
            }
        }
    }
}

// Whether range [lo, hi] of comparison operand v can help decide it: not
// its type's whole range, and for an unsigned order not of unknown sign.
fn bounds_something(cx: &mut FnCtx<Comp>, v: i64, lo: i64, hi: i64, signed: bool, order: bool) -> bool {
    unsafe {
        let ty = (*cx.insts.add(v as usize)).ty;
        if lo <= type_min(ty) && hi >= type_max(ty) {
            return false;
        }
        signed || !order || lo >= 0
    }
}

// Marks the operands of the comparisons in FACTS (see FACT_MARK).
fn mark_facts(cx: &mut FnCtx<Comp>) {
    unsafe {
        if cx.mark_cap <= cx.inst_count {
            free(cx.fact_mark as *mut u8);
            cx.mark_cap = 2 * cx.inst_count + 1024;
            cx.fact_mark = alloc_array::<i64>(cx.mark_cap);
        }
        cx.mark_stamp += 1;
        let mut i: i64 = 0;
        while i < cx.facts.len() as i64 {
            let f = (cx.facts[i as usize]);
            i += 2;
            if (*cx.insts.add(f as usize)).op != Op::Cmp {
                continue;
            }
            let fa = bits_of_value(cx, (*cx.insts.add(f as usize)).a);
            let fb = bits_of_value(cx, (*cx.insts.add(f as usize)).b);
            if fa < cx.mark_cap {
                (*cx.fact_mark.add(fa as usize)) = cx.mark_stamp;
            }
            if fb < cx.mark_cap {
                (*cx.fact_mark.add(fb as usize)) = cx.mark_stamp;
            }
        }
        cx.mark_ver = cx.facts_ver;
    }
}

// The outcomes possible for intervals a and b.
fn interval_outcomes(alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
    let mut s: i64 = 0;
    if alo < bhi {
        s |= 1;
    }
    if alo <= bhi && blo <= ahi {
        s |= 2;
    }
    if ahi > blo {
        s |= 4;
    }
    s
}

// (0.29) Whether comparison c is a test of its left operand for zero, in
// any spelling: 1 when it holds exactly when the operand is not zero
// (`x != 0`; unsigned, `x > 0` and `x >= 1`), 0 when exactly when it is
// zero (`x == 0`; unsigned, `x <= 0` and `x < 1`), else -1. A slice's
// length is unsigned and of unknown sign to the intervals, so `len > 0`
// (the check of `s[0]`) bounded nothing for `len >= 1` (the check of
// `s[1..]`), nor did `!s.is_empty()` for either: the two checks of every
// step of a slice's iterator.
fn zero_test(cx: &mut FnCtx<Comp>, c: i64) -> i64 {
    // UNSAFE: the IR's instruction table, a raw array read by id.
    // SAFETY: c is a comparison of the current function and its operand an
    // instruction of it (ir_val gives one), both below cx.inst_count.
    unsafe {
        if (*cx.insts.add(c as usize)).op != Op::Cmp
            || !is_integer((*cx.insts.add(c as usize)).imm2) {
            return -1;
        }
        let b = ir_val(cx, (*cx.insts.add(c as usize)).b);
        if !is_const(cx, b) {
            return -1;
        }
        let k = (*cx.insts.add(b as usize)).imm;
        let cond = (*cx.insts.add(c as usize)).cond;
        if k == 0 && cond == Ne {
            return 1;
        }
        if k == 0 && cond == Eq {
            return 0;
        }
        if is_signed((*cx.insts.add(c as usize)).imm2) {
            return -1;
        }
        if (k == 0 && cond == Gt) || (k == 1 && cond == Ge) {
            return 1;
        }
        if (k == 0 && cond == Le) || (k == 1 && cond == Lt) {
            return 0;
        }
        -1
    }
}

// Whether comparison or bool c holds at a block with facts FACTS: 1 true,
// 0 false, -1 unknown.
fn decide(cx: &mut FnCtx<Comp>, c: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut i: i64 = 0;
        while i < cx.facts.len() as i64 {
            if (cx.facts[i as usize]) == c {
                return (cx.facts[(i + 1) as usize]);
            }
            i += 2;
        }
        if (*cx.insts.add(c as usize)).op == Op::Ovf {
            return if overflow_ruled_out(cx, c, pcx) { 0 } else { -1 };
        }
        if (*cx.insts.add(c as usize)).op != Op::Cmp
            || !is_integer((*cx.insts.add(c as usize)).imm2) {
            return -1;
        }
        let a = bits_of_value(cx, (*cx.insts.add(c as usize)).a);
        // (0.29) A test for zero, and a fact that is one of the same value
        // in another spelling.
        let zero = zero_test(cx, c);
        if zero >= 0 {
            i = 0;
            while i < cx.facts.len() as i64 {
                let f = (cx.facts[i as usize]);
                let holds = (cx.facts[(i + 1) as usize]) != 0;
                i += 2;
                let fzero = zero_test(cx, f);
                if fzero >= 0 && bits_of_value(cx, (*cx.insts.add(f as usize)).a) == a {
                    // (the fact: the value is not zero, or is)
                    let not_zero = (fzero == 1) == holds;
                    return if (zero == 1) == not_zero { 1 } else { 0 };
                }
            }
        }
        let b = bits_of_value(cx, (*cx.insts.add(c as usize)).b);
        let q = cond_set((*cx.insts.add(c as usize)).cond);
        let signed = is_signed((*cx.insts.add(c as usize)).imm2);
        // (0.11) The cheaper side first (a phi's range costs most): when its
        // range bounds nothing, the other's cannot decide anything.
        let mut alo = MIN_I64;
        let mut ahi = MAX_I64;
        let mut blo = MIN_I64;
        let mut bhi = MAX_I64;
        let order = is_order((*cx.insts.add(c as usize)).cond);
        if (*cx.insts.add(a as usize)).op == Op::Phi && (*cx.insts.add(b as usize)).op != Op::Phi {
            range_at(cx, b, &mut blo, &mut bhi, pcx);
            if bounds_something(cx, b, blo, bhi, signed, order) {
                range_at(cx, a, &mut alo, &mut ahi, pcx);
            }
        } else {
            range_at(cx, a, &mut alo, &mut ahi, pcx);
            if bounds_something(cx, a, alo, ahi, signed, order) {
                range_at(cx, b, &mut blo, &mut bhi, pcx);
            }
        }
        let nonneg = alo >= 0 && blo >= 0;
        let mut outcomes: i64 = 7;
        if a == b {
            outcomes = 2;
        }
        if signed || nonneg || !is_order((*cx.insts.add(c as usize)).cond) {
            outcomes &= interval_outcomes(alo, ahi, blo, bhi);
        }
        i = 0;
        while i < cx.facts.len() as i64 {
            let f = (cx.facts[i as usize]);
            let holds = (cx.facts[(i + 1) as usize]) != 0;
            i += 2;
            if (*cx.insts.add(f as usize)).op != Op::Cmp
                || !is_integer((*cx.insts.add(f as usize)).imm2) {
                continue;
            }
            let fa = bits_of_value(cx, (*cx.insts.add(f as usize)).a);
            let fb = bits_of_value(cx, (*cx.insts.add(f as usize)).b);
            let mut fs = cond_set((*cx.insts.add(f as usize)).cond);
            if !holds {
                fs = 7 & !fs;
            }
            if fa == b && fb == a {
                fs = mirror_set(fs);
            } else if fa != a || fb != b {
                continue;
            }
            let fsigned = is_signed((*cx.insts.add(f as usize)).imm2);
            if fs == 2 || fs == 5 || fsigned == signed || nonneg {
                outcomes &= fs;
            } else if fsigned && !signed && alo >= 0 && (fs & 4) == 0 {
                // a <s b (or <=) with a >= 0: both are non-negative, and the
                // unsigned order is the same.
                outcomes &= fs;
            }
        }
        // (0.18.1) x % n against n itself, n known positive: below it.
        if order && (outcomes & q) != 0 && (outcomes & !q) != 0 {
            if rem_below(cx, a, b, pcx) {
                outcomes &= 1;
            } else if rem_below(cx, b, a, pcx) {
                outcomes &= 4;
            }
        }
        // (0.18.1) One step of transitivity, when the facts above left c open:
        // facts a R w and w R' b of one signedness, both orders the same way
        // (< or <=; > or >=), give a R'' b, strict when either is. So `i < n` (a
        // counted loop's) and `n <= len` (a requires', a guard's) decide the
        // check `i < len`.
        if order && (outcomes & q) != 0 && (outcomes & !q) != 0 {
            let s = chained(cx, a, b);
            if s != 7 {
                let fsigned = (s & 8) != 0;
                let fs = s & 7;
                if !signed && fsigned && !nonneg && alo < 0 && (fs & 4) == 0 {
                    range_at(cx, a, &mut alo, &mut ahi, pcx);
                }
                if fsigned == signed || nonneg || (fsigned && alo >= 0 && (fs & 4) == 0) {
                    outcomes &= fs;
                }
            }
        }
        if outcomes == 0 {
            return -1;
        }
        if (outcomes & !q) == 0 {
            return 1;
        }
        if (outcomes & q) == 0 {
            return 0;
        }
        -1
    }
}

// (0.26.2, a prototype) Whether OVF c (middle/ir) cannot overflow at a
// block with facts FACTS: by interval arithmetic on its operands' ranges,
// or, for `x + c` (`x - c`), by a fact x < w (x > w): offset_bounded.
fn overflow_ruled_out(cx: &mut FnCtx<Comp>, c: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: the function's IR is FnCtx's raw arrays (insts), as in all of
    // this pass.
    // SAFETY: c and its operands are instructions of the function entered
    // (fold_by_ranges), below cx.insts' count.
    unsafe {
        let imm = (*cx.insts.add(c as usize)).imm;
        let op = (imm & 255) as Op;
        let ty = imm >> 8;
        let signed = is_signed(ty);
        let a = (*cx.insts.add(c as usize)).a;
        let b = (*cx.insts.add(c as usize)).b;
        let mut alo = MIN_I64;
        let mut ahi = MAX_I64;
        range_at(cx, a, &mut alo, &mut ahi, pcx);
        if op == Op::Neg {
            return if signed { alo > type_min(ty) } else { alo == 0 && ahi == 0 };
        }
        // x + c below a bound w; x - c above one (c a small constant).
        let small_c: i64 = 4294967296;
        if (op == Op::Add || op == Op::Sub) && is_const(cx, b)
            && (*cx.insts.add(b as usize)).imm != 0
            && (*cx.insts.add(b as usize)).imm > 0 - small_c
            && (*cx.insts.add(b as usize)).imm < small_c {
            let k = (*cx.insts.add(b as usize)).imm;
            let up = (op == Op::Add) == (k > 0);
            // (an unsigned type's constants are not negative: a large one's bits)
            if (k > 0 || signed)
                && offset_bounded(cx, a, ty, up, if k > 0 { k } else { 0 - k }, pcx) {
                return true;
            }
        }
        if op == Op::Add && is_const(cx, a) && (*cx.insts.add(a as usize)).imm > 0
            && (*cx.insts.add(a as usize)).imm < small_c
            && offset_bounded(cx, b, ty, true, (*cx.insts.add(a as usize)).imm, pcx) {
            return true;
        }
        if !signed && alo < 0 {
            return false;
        }
        let mut blo = MIN_I64;
        let mut bhi = MAX_I64;
        range_at(cx, b, &mut blo, &mut bhi, pcx);
        if !signed && blo < 0 {
            return false;
        }
        let big: i64 = 4611686018427387904;
        let small: i64 = 2147483648;
        let mut rlo: i64 = 0;
        let mut rhi: i64 = 0;
        if op == Op::Add || op == Op::Sub {
            if !(alo > 0 - big && ahi < big && blo > 0 - big && bhi < big) {
                return false;
            }
            if op == Op::Add {
                rlo = alo + blo;
                rhi = ahi + bhi;
            } else {
                rlo = alo - bhi;
                rhi = ahi - blo;
            }
        } else {
            if !(alo > 0 - small && ahi < small && blo > 0 - small && bhi < small) {
                return false;
            }
            let p1 = alo * blo;
            let p2 = alo * bhi;
            let p3 = ahi * blo;
            let p4 = ahi * bhi;
            rlo = lesser(lesser(p1, p2), lesser(p3, p4));
            rhi = greater(greater(p1, p2), greater(p3, p4));
        }
        rlo >= type_min(ty) && rhi <= type_max(ty) && (signed || rlo >= 0)
    }
}

// Whether x + c (`up`) or x - c, c >= 1, stays inside x's type ty (its
// signedness and width) by a fact x < w or x <= w (x > w, x >= w) of its
// type: for c = 1 and x < w always; else when w's range leaves room for c.
// (0.26.2) Or, x signed, by an unsigned fact x < w (x <= w) with w not
// negative: then x is not either (a bounds check's index).
fn offset_bounded(cx: &mut FnCtx<Comp>, v: i64, ty: i64, up: bool, c: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: FnCtx's raw arrays (facts, insts), as in decide.
    // SAFETY: i stays below cx.facts.count (pairs); the facts and their
    // operands are instructions of the function entered.
    unsafe {
        let x = bits_of_value(cx, v);
        let signed = is_signed(ty);
        let mut i: i64 = 0;
        while i < cx.facts.len() as i64 {
            let f = (cx.facts[i as usize]);
            let holds = (cx.facts[(i + 1) as usize]) != 0;
            i += 2;
            let fty = (*cx.insts.add(f as usize)).imm2;
            if (*cx.insts.add(f as usize)).op != Op::Cmp || !is_integer(fty)
                || int_bits(fty) != int_bits(ty) {
                continue;
            }
            let mixed = is_signed(fty) != signed;
            if mixed && !(signed && up) {
                continue;
            }
            let mut fs = cond_set((*cx.insts.add(f as usize)).cond);
            if !holds {
                fs = 7 & !fs;
            }
            let mut w = (*cx.insts.add(f as usize)).b;
            if bits_of_value(cx, (*cx.insts.add(f as usize)).b) == x
                && bits_of_value(cx, (*cx.insts.add(f as usize)).a) != x {
                fs = mirror_set(fs);
                w = (*cx.insts.add(f as usize)).a;
            } else if bits_of_value(cx, (*cx.insts.add(f as usize)).a) != x {
                continue;
            }
            let strict = fs == if up { 1 } else { 4 };
            if !strict && fs != if up { 3 } else { 6 } {
                continue;
            }
            if strict && c == 1 && !mixed {
                return true;
            }
            if !signed {
                continue;
            }
            let mut wlo = MIN_I64;
            let mut whi = MAX_I64;
            range_at(cx, w, &mut wlo, &mut whi, pcx);
            if mixed && wlo < 0 {
                continue;
            }
            let slack: i64 = if strict { 1 } else { 0 };
            if up && whi <= type_max(ty) - c + slack || !up && wlo >= type_min(ty) + c - slack {
                return true;
            }
        }
        false
    }
}

// The order between a and b that two facts give through a third value w
// (see decide): a set of outcomes (1 less, 2 equal, 4 greater), with 8
// when the facts are signed; 7 when no two facts chain.
fn chained(cx: &mut FnCtx<Comp>, a: i64, b: i64) -> i64 {
    unsafe {
        let mut i: i64 = 0;
        while i < cx.facts.len() as i64 {
            let f = (cx.facts[i as usize]);
            let holds = (cx.facts[(i + 1) as usize]) != 0;
            i += 2;
            if (*cx.insts.add(f as usize)).op != Op::Cmp
                || !is_integer((*cx.insts.add(f as usize)).imm2) {
                continue;
            }
            let fa = bits_of_value(cx, (*cx.insts.add(f as usize)).a);
            let fb = bits_of_value(cx, (*cx.insts.add(f as usize)).b);
            let mut s1 = cond_set((*cx.insts.add(f as usize)).cond);
            if !holds {
                s1 = 7 & !s1;
            }
            let mut w = fb;
            if fb == a && fa != a {
                w = fa;
                s1 = mirror_set(s1);
            } else if fa != a || fb == a {
                continue;
            }
            if w == b || ((s1 & 4) != 0 && (s1 & 1) != 0) {
                continue;
            }
            let signed = is_signed((*cx.insts.add(f as usize)).imm2);
            let mut j: i64 = 0;
            while j < cx.facts.len() as i64 {
                let g = (cx.facts[j as usize]);
                let gholds = (cx.facts[(j + 1) as usize]) != 0;
                j += 2;
                if g == f || (*cx.insts.add(g as usize)).op != Op::Cmp
                    || !is_integer((*cx.insts.add(g as usize)).imm2)
                    || is_signed((*cx.insts.add(g as usize)).imm2) != signed {
                    continue;
                }
                let ga = bits_of_value(cx, (*cx.insts.add(g as usize)).a);
                let gb = bits_of_value(cx, (*cx.insts.add(g as usize)).b);
                let mut s2 = cond_set((*cx.insts.add(g as usize)).cond);
                if !gholds {
                    s2 = 7 & !s2;
                }
                if ga == b && gb == w {
                    s2 = mirror_set(s2);
                } else if ga != w || gb != b {
                    continue;
                }
                let strict = (s1 & 2) == 0 || (s2 & 2) == 0;
                let sign: i64 = if signed { 8 } else { 0 };
                if (s1 & 4) == 0 && (s2 & 4) == 0 {
                    return sign | if strict { 1 } else { 3 };
                }
                if (s1 & 1) == 0 && (s2 & 1) == 0 {
                    return sign | if strict { 4 } else { 6 };
                }
            }
        }
        7
    }
}

// (0.18.1) Whether r is `x % n` with n (as bits) the value m, n at least 1
// (its range, with the facts), and r non-negative (an unsigned remainder,
// or a signed one of a non-negative x): then 0 <= r < m, signed or not.
fn rem_below(cx: &mut FnCtx<Comp>, r: i64, m: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if (*cx.insts.add(r as usize)).op != Op::Rem
            || int_bits((*cx.insts.add(r as usize)).ty) != 64
            || bits_of_value(cx, (*cx.insts.add(r as usize)).b) != m {
            return false;
        }
        let mut lo: i64 = 0;
        let mut hi: i64 = 0;
        range_at(cx, m, &mut lo, &mut hi, pcx);
        if lo < 1 {
            return false;
        }
        if !is_signed((*cx.insts.add(r as usize)).ty) {
            return true;
        }
        range_at(cx, (*cx.insts.add(r as usize)).a, &mut lo, &mut hi, pcx);
        lo >= 0
    }
}

// ---- The pass ----

// Decides the branches of fi whose condition the facts and ranges decide,
// threads edges past blocks whose test the edge decides, and turns chains
// of equality tests into switches. Returns whether anything changed.
pub fn fold_by_ranges(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        resolve_all(cx, fi);
        let mut changed = thread_phi_conditions(cx, fi);
        if changed {
            resolve_all(cx, fi);
            remove_unreachable(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
            resolve_all(cx, fi);
        }
        analyze_loops(cx, fi);
        make_loop_facts(cx, pcx);
        for round in 0..3 {
            if round > 0 {
                resolve_all(cx, fi);
                analyze_loops(cx, fi);
                // (0.25) The loops are numbered again: their facts too
                // (a fact of loop l, kept from before a loop went, held
                // in another, whose blocks it does not hold in).
                make_loop_facts(cx, pcx);
            }
            forget_phi_ranges(cx);
            let mut folded = false;
            for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
                let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
                if (*cx.blocks.add(b as usize)).removed != 0
                    || (*cx.blocks.add(b as usize)).order < 0
                    || (*cx.blocks.add(b as usize)).term != Term::Branch {
                    continue;
                }
                let c = ir_val(cx, (*cx.blocks.add(b as usize)).cond);
                if is_const(cx, c) {
                    continue;
                }
                cx.phi_ranges = is_check(cx, (*cx.blocks.add(b as usize)).s0)
                    || is_check(cx, (*cx.blocks.add(b as usize)).s1);
                let d = decide_branch(cx, b, c, pcx);
                cx.phi_ranges = false;
                if d >= 0 {
                    // (0.18: --print-checks names the checks removed here)
                    if pcx.print_checks != 0 as *mut u8 {
                        note_removed(cx,
                            if d == 1 { (*cx.blocks.add(b as usize)).s1 }
                            else { (*cx.blocks.add(b as usize)).s0 }, pcx);
                    }
                    let k = ir_make(cx, Op::Const, TY_BOOL, 0, 0, d, pcx);
                    ir_append(cx, b, k);
                    (*cx.blocks.add(b as usize)).cond = k;
                    folded = true;
                }
            }
            if folded {
                simplify_cfg(cx, fi, pcx);
            }
            let threaded = thread_implied(cx, fi, pcx);
            if !folded && !threaded {
                break;
            }
            changed = true;
        }
        if chains_to_switches(cx, fi) {
            changed = true;
        }
        if changed {
            resolve_all(cx, fi);
            remove_unreachable(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
            verify_func(cx, fi, c"value ranges", pcx);
        }
        changed
    }
}

// Whether block b is where a check fails: it ends the program.
fn is_check(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    unsafe { (*cx.blocks.add(b as usize)).term == Term::Unreach }
}

// Whether the condition c of block b's branch is decided: by the facts at
// b, or, for a phi of b, by the facts on each incoming edge alike.
fn decide_branch(cx: &mut FnCtx<Comp>, b: i64, c: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        collect_facts(cx, b, pcx);
        let d = decide(cx, c, pcx);
        if d >= 0 || (*cx.insts.add(c as usize)).op != Op::Phi
            || (*cx.insts.add(c as usize)).block != b {
            return d;
        }
        let mut all: i64 = -1;
        for k in 0..(*cx.insts.add(c as usize)).nargs {
            let p = ((*cx.blocks.add(b as usize)).preds[k as usize]);
            if (*cx.blocks.add(p as usize)).term == Term::Switch
                || ((*cx.blocks.add(p as usize)).term == Term::Branch
                    && (*cx.blocks.add(p as usize)).s0 == (*cx.blocks.add(p as usize)).s1) {
                return -1;
            }
            collect_facts(cx, p, pcx);
            edge_fact(cx, p, b, pcx);
            let ir_arg_v = ir_arg(cx, c, k);
            let ir_val_v = ir_val(cx, ir_arg_v);
            let dk = decide(cx, ir_val_v, pcx);
            if dk < 0 || (all >= 0 && dk != all) {
                return -1;
            }
            all = dk;
        }
        all
    }
}
