// Jump threading on implied conditions: an edge into a block that only
// tests what the facts on the edge already decide goes on to the outcome
// directly, and a branch on a phi of `&&` or `||` is threaded from the
// predecessor that decided it. EXPORTS marks the blocks with values used
// outside them, which threading cannot skip.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, Term, get_irfuncs, ir_arg, ir_operand, ir_operand_count, ir_val};
use crate::middle::ir::cfg::{is_succ, pred_index, redirect_succ};
use crate::middle::loops::{add_pred_lp_values, block_array};
use crate::middle::opt::{
    add_pred_like, compute_dominators, remove_pred, remove_pred_at, remove_unreachable,
};
use crate::middle::range::{collect_facts, decide, edge_fact};
use crate::middle::range::phi::forget_phi_ranges;

// (0.11) A block holding nothing but a phi and a branch on it (what `&&`
// and `||` leave), the phi used by the branch alone: a predecessor that
// branched on the phi's operand for it decides the branch by the edge it
// takes, and goes on to the outcome directly (as instruction selection
// threads them; here, so that the facts on the way hold where the outcome
// is: in `i < n && s[i] < x`, i < n wherever the whole is true). Returns
// whether any edge was redirected.
pub fn thread_phi_conditions(cx: &mut FnCtx<Comp>, fi: i64) -> bool {
    let mut changed = false;
    compute_exports(cx, fi);
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let j = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[j as usize]).removed != 0
                || (cx.blocks[j as usize]).term != Term::Branch
                || j == (*get_irfuncs().add(fi as usize)).entry {
                continue;
            }
            let phi = (cx.blocks[j as usize]).first;
            let s0 = (cx.blocks[j as usize]).s0;
            let s1 = (cx.blocks[j as usize]).s1;
            if phi == 0 || (cx.insts[phi as usize]).op != Op::Phi
                || (cx.insts[phi as usize]).next != 0
                || ir_val(cx, (cx.blocks[j as usize]).cond) != phi
                || used_outside_block(cx, fi, j) || s0 == s1 || s0 == j || s1 == j
                || (cx.insts[phi as usize]).nargs
                != (cx.blocks[j as usize]).preds.len() as i64 {
                continue;
            }
            let mut k: i64 = 0;
            while k < (cx.blocks[j as usize]).preds.len() as i64 {
                let p = ((cx.blocks[j as usize]).preds[k as usize]);
                let ir_arg_v = ir_arg(cx, phi, k);
                let value = ir_val(cx, ir_arg_v);
                if (cx.blocks[p as usize]).term != Term::Branch || p == j
                    || ir_val(cx, (cx.blocks[p as usize]).cond) != value
                    || ((cx.blocks[p as usize]).s0 == j)
                    == ((cx.blocks[p as usize]).s1 == j) {
                    k += 1;
                    continue;
                }
                let t = if (cx.blocks[p as usize]).s0 == j { s0 } else { s1 };
                let other = if (cx.blocks[p as usize]).s0
                    == j { (cx.blocks[p as usize]).s1 }
                    else { (cx.blocks[p as usize]).s0 };
                if t == other || t == p {
                    k += 1;
                    continue;
                }
                redirect_succ(cx, p, j, t);
                add_pred_like(cx, t, p, j);
                remove_pred_at(cx, j, k);
                changed = true;
            }
        }
    }
    changed
}

// A block that only tests: no phis, its instructions pure (or constants)
// and used by its own branch alone.
fn is_test_block(cx: &mut FnCtx<Comp>, fi: i64, j: i64) -> bool {
    unsafe {
        if (cx.blocks[j as usize]).term != Term::Branch
            || j == (*get_irfuncs().add(fi as usize)).entry
            || (cx.blocks[j as usize]).s0 == (cx.blocks[j as usize]).s1 {
            return false;
        }
        let mut v = (cx.blocks[j as usize]).first;
        let mut n: i64 = 0;
        while v != 0 {
            let op = (cx.insts[v as usize]).op;
            if op != Op::Const && !op.is_pure() {
                return false;
            }
            n += 1;
            v = (cx.insts[v as usize]).next;
        }
        n <= 4 && !used_outside_block(cx, fi, j)
    }
}

pub fn compute_exports(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        block_array(&mut cx.exports, cx.blocks.len());
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 && (cx.insts[w as usize]).block != 0
                        && (cx.insts[w as usize]).block != b {
                        (cx.exports[(cx.insts[w as usize]).block as usize]) = 1;
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            let c = (cx.blocks[b as usize]).cond;
            if c != 0 && (cx.insts[c as usize]).block != 0
                && (cx.insts[c as usize]).block != b {
                (cx.exports[(cx.insts[c as usize]).block as usize]) = 1;
            }
        }
    }
}

// Whether a value defined in block j is used in another block.
pub fn used_outside_block(cx: &mut FnCtx<Comp>, fi: i64, j: i64) -> bool {
    let _ = fi;
    j >= cx.blocks.len() as i64 || (cx.exports[j as usize]) != 0
}

// Jump threading: a predecessor p of a test block j, where the test is
// decided (by p's facts and the edge p -> j), goes to j's outcome directly.
pub fn thread_implied(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut changed = false;
    compute_exports(cx, fi);
    // One edge at a time: the facts need the dominators of the current CFG.
    for _ in 0..1000 {
        let mut did = false;
        compute_dominators(cx, fi);
        unsafe {
            for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
                if did {
                    break;
                }
                let j = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
                if (cx.blocks[j as usize]).removed != 0
                    || (cx.blocks[j as usize]).order < 0
                    || (cx.blocks[j as usize]).preds.len() as i64 < 2 {
                    continue;
                }
                if !is_test_block(cx, fi, j) {
                    continue;
                }
                let c = ir_val(cx, (cx.blocks[j as usize]).cond);
                let mut k: i64 = 0;
                while k < (cx.blocks[j as usize]).preds.len() as i64 {
                    let p = ((cx.blocks[j as usize]).preds[k as usize]);
                    k += 1;
                    if (cx.blocks[p as usize]).term == Term::Switch
                        || (cx.blocks[p as usize]).order < 0
                        || ((cx.blocks[p as usize]).term == Term::Branch
                            && (cx.blocks[p as usize]).s0 == (cx.blocks[p as usize]).s1) {
                        continue;
                    }
                    collect_facts(cx, p, pcx);
                    edge_fact(cx, p, j, pcx);
                    let d = decide(cx, c, pcx);
                    if d < 0 {
                        continue;
                    }
                    let t = if d == 1 { (cx.blocks[j as usize]).s0 }
                        else { (cx.blocks[j as usize]).s1 };
                    if is_succ(cx, p, t) || t == j {
                        continue;
                    }
                    // p -> t: t's phis take their operand for j.
                    let index = pred_index(cx, t, j);
                    let first = cx.lp_values.len() as i64;
                    let mut phi = (cx.blocks[t as usize]).first;
                    while phi != 0 && (cx.insts[phi as usize]).op == Op::Phi {
                        let ir_arg_v = ir_arg(cx, phi, index);
                        cx.lp_values.push(ir_arg_v);
                        phi = (cx.insts[phi as usize]).next;
                    }
                    redirect_succ(cx, p, j, t);
                    add_pred_lp_values(cx, t, p, first);
                    cx.lp_values.truncate(first as usize);
                    remove_pred(cx, j, p);
                    did = true;
                    break;
                }
            }
        }
        if !did {
            break;
        }
        changed = true;
        remove_unreachable(cx, fi);
        forget_phi_ranges(cx);
    }
    changed
}
