// Comparison chains turned into switches: a run of blocks each testing the
// same value for equality with a constant (what a chain of `if x == k`,
// `else if x == k2` leaves) becomes one switch on the value.

use crate::base::comp::Comp;
use crate::front::types::is_integer;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::ir::{Op, Term, fn_block, fn_block_count, fn_entry, ir_val};
use crate::middle::ir::Cond::{Eq, Ne};
use crate::middle::ir::cfg::{ir_switch_no_preds, pred_index};
use crate::middle::opt::{compute_dominators, remove_pred_at, remove_unreachable};
use crate::middle::range::thread::{compute_exports, used_outside_block};

const CHAIN_MIN_CASES: i64 = 4;

// The value block b tests for equality with a constant (its branch's
// condition `x == k` or `x != k`): x, with *k and *equal (the successor
// taken when equal) and *other (taken otherwise); 0 when it is not such a
// test.
fn equality_test(cx: &mut FnCtx<Comp>, b: i64, k: &mut i64, equal: &mut i64, other: &mut i64) -> i64 {
    if (cx.blocks[b as usize]).term != Term::Branch
        || (cx.blocks[b as usize]).s0 == (cx.blocks[b as usize]).s1 {
        return 0;
    }
    let c = ir_val(cx, (cx.blocks[b as usize]).cond);
    if (cx.insts[c as usize]).op != Op::Cmp
        || !is_integer((cx.insts[c as usize]).imm2) {
        return 0;
    }
    let cond = (cx.insts[c as usize]).cond;
    if cond != Eq && cond != Ne {
        return 0;
    }
    let mut x = ir_val(cx, (cx.insts[c as usize]).a);
    let mut kv = ir_val(cx, (cx.insts[c as usize]).b);
    if is_const(cx, x) {
        let t = x;
        x = kv;
        kv = t;
    }
    if !is_const(cx, kv) || is_const(cx, x) {
        return 0;
    }
    *k = (cx.insts[kv as usize]).imm;
    if cond == Eq {
        *equal = (cx.blocks[b as usize]).s0;
        *other = (cx.blocks[b as usize]).s1;
    } else {
        *equal = (cx.blocks[b as usize]).s1;
        *other = (cx.blocks[b as usize]).s0;
    }
    x
}

// Whether block b holds only constants and the comparison of its branch,
// none used elsewhere.
fn only_test(cx: &mut FnCtx<Comp>, fi: i64, b: i64) -> bool {
    let c = ir_val(cx, (cx.blocks[b as usize]).cond);
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0 {
        if v != c && (cx.insts[v as usize]).op != Op::Const {
            return false;
        }
        v = (cx.insts[v as usize]).next;
    }
    !used_outside_block(cx, fi, b)
}

pub fn chains_to_switches(cx: &mut FnCtx<Comp>, fi: i64) -> bool {
    let mut changed = false;
    compute_dominators(cx, fi);
    compute_exports(cx, fi);
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 || (cx.blocks[b as usize]).order < 0
            || ((cx.blocks[b as usize]).preds.len() as i64 == 0
                && b != fn_entry(cx, fi)) {
            continue;
        }
        let mut k: i64 = 0;
        let mut eq: i64 = 0;
        let mut ne: i64 = 0;
        let x = equality_test(cx, b, &mut k, &mut eq, &mut ne);
        if x == 0 {
            continue;
        }
        // The chain: b, then blocks reached when not equal, each with b's
        // chain as its only predecessor, testing x against a constant.
        let mut cases: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut chain: Vec<i64, Comp> = Vec::new_in(Comp {});
        cases.push(k);
        cases.push(eq);
        chain.push(b);
        let mut tail = ne;
        loop {
            let mut k2: i64 = 0;
            let mut eq2: i64 = 0;
            let mut ne2: i64 = 0;
            if (cx.blocks[tail as usize]).preds.len() as i64 != 1 || tail == b
                || equality_test(cx, tail, &mut k2, &mut eq2, &mut ne2) != x
                || !only_test(cx, fi, tail) {
                break;
            }
            let mut dup = false;
            for m in 0..cases.len() as i64 / 2 {
                if (cases[(2 * m) as usize]) == k2 {
                    dup = true;
                }
            }
            if dup {
                break;
            }
            cases.push(k2);
            cases.push(eq2);
            chain.push(tail);
            tail = ne2;
        }
        if cases.len() as i64 / 2 >= CHAIN_MIN_CASES
            && chain_targets_ok(cx, &cases, &chain, tail) {
            make_chain_switch(cx, b, x, &cases, &chain, tail);
            changed = true;
        }
    }
    if changed {
        remove_unreachable(cx, fi);
    }
    changed
}

// Whether the chain's targets can take the switch block as their
// predecessor: a target reached by several edges of the chain must have no
// phis; no target is a block of the chain.
fn chain_targets_ok(cx: &mut FnCtx<Comp>, cases: &[i64], chain: &[i64], default: i64) -> bool {
    let n = cases.len() as i64 / 2;
    for i in 0..n + 1 {
        let t = if i < n { (cases[(2 * i + 1) as usize]) } else { default };
        for m in 0..chain.len() as i64 {
            if (chain[m as usize]) == t {
                return false;
            }
        }
        let mut edges: i64 = 0;
        for m in 0..n + 1 {
            let u = if m < n { (cases[(2 * m + 1) as usize]) } else { default };
            if u == t {
                edges += 1;
            }
        }
        let first = (cx.blocks[t as usize]).first;
        if edges > 1 && first != 0 && (cx.insts[first as usize]).op == Op::Phi {
            return false;
        }
    }
    true
}

fn make_chain_switch(cx: &mut FnCtx<Comp>, b: i64, x: i64, cases: &[i64], chain: &[i64],
    default: i64) {
    let n = cases.len() as i64 / 2;
    // The targets lose the chain blocks as predecessors and get b once.
    for i in 0..n + 1 {
        let t = if i < n { (cases[(2 * i + 1) as usize]) } else { default };
        let from = if i < n { (chain[i as usize]) }
            else { (chain[(chain.len() as i64 - 1) as usize]) };
        let index = pred_index(cx, t, from);
        if index < 0 {
            continue;
        }
        if pred_index(cx, t, b) >= 0 && b != from {
            remove_pred_at(cx, t, index);
        } else {
            ((cx.blocks[t as usize]).preds[index as usize]) = b;
        }
    }
    // The other chain blocks lose their predecessor (they become
    // unreachable).
    for m in 1..chain.len() as i64 {
        (cx.blocks[(chain[m as usize]) as usize]).preds.clear();
    }
    let mark = cx.ssa_stack.len() as i64;
    for i in 0..n {
        cx.ssa_stack.push((cases[(2 * i) as usize]));
        cx.ssa_stack.push((cases[(2 * i + 1) as usize]));
    }
    ir_switch_no_preds(cx, b, x, default, mark);
}
