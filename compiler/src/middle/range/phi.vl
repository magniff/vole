// Ranges of phis (0.11).
//
// A phi's range is the union of its operands' ranges, each at the end of
// its predecessor with the facts there and on the edge: a property of the
// phi wherever it is used, kept per generation (a change of the control
// flow starts a new one).
//
// The phis of a loop header are found together, as the operands coming
// back around the loop (from predecessors the header dominates) may depend
// on them: each phi is assumed in a range H, the operands coming back are
// ranged under those assumptions, and when every one falls in its phi's H,
// every phi is in its H always (by induction over the values they take,
// as H holds the entry operands). H is first the entry operands' range;
// a phi whose operands coming back leave it upward (downward) has that end
// widened to what the facts on those edges allow (an increasing induction
// variable below its loop's bound, with any step; a decreasing one above);
// failing that, its type's range, which proves nothing about it but holds.
// The assumptions are on a stack, as are the phis of other blocks while
// their operands are ranged (assumed to have their type's range if met
// again); a range found under an assumption made outside its own
// finding is not kept. At most PHI_NEST levels.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::is_integer;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, ir_arg, ir_val};
use crate::middle::loops::{innermost_loop, loop_count, loop_header};
use crate::middle::opt::dominates;
use crate::middle::range::{collect_facts, edge_fact, narrow_by_facts};
use crate::middle::range::interval::{
    MAX_I64, MIN_I64, greater, lesser, range_with_facts, type_max, type_min,
};

const PHI_NEST: i64 = 12;
// Phi ranges being found within one another (each may take facts with
// other values afresh: see FACT_NEST), at most PHI_FINDS.
const PHI_FINDS: i64 = 3;
// The phis of a header found together (the others have their type's
// range).
const HEADER_PHIS: i64 = 8;
// How deep facts comparing with a value whose range bounds it are taken
// (within the ranging of such a value), and how deep they are now.
pub const FACT_RANGE_DEPTH: i64 = 3;
const NO_TAINT: i64 = 1000000;

const PR_BUDGET: i64 = 5000;
const PR_STRIDE: i64 = 4;
const HR_FIELDS: i64 = 10;
const HR_PHI: i64 = 0;
const HR_TLO: i64 = 1;
const HR_THI: i64 = 2;
const HR_RLO: i64 = 3;
const HR_RHI: i64 = 4;
const HR_HLO: i64 = 5;
const HR_HHI: i64 = 6;
const HR_BLO: i64 = 7;
const HR_BHI: i64 = 8;
const HR_STAGE: i64 = 9;

pub fn forget_phi_ranges(cx: &mut FnCtx<Comp>) {
    cx.range_gen += 1;
    cx.pr_work = 0;
}

fn facts_save(cx: &mut FnCtx<Comp>) -> i64 {
    let mark = cx.facts_saved.len() as i64;
    for i in 0..cx.facts.len() as i64 {
        cx.facts_saved.push((cx.facts[i as usize]));
    }
    cx.facts_saved.push(cx.facts.len() as i64);
    mark
}

fn facts_restore(cx: &mut FnCtx<Comp>, mark: i64) {
    let n = (cx.facts_saved[(cx.facts_saved.len() as i64 - 1) as usize]);
    cx.facts_ver += 1;
    cx.facts.clear();
    for i in 0..n {
        cx.facts.push((cx.facts_saved[(mark + i) as usize]));
    }
    cx.facts_saved.truncate(mark as usize);
}

// The facts at the end of predecessor p of h, and on the edge, in FACTS.
fn edge_facts(cx: &mut FnCtx<Comp>, p: i64, h: i64, pcx: &Ctx<Comp>) {
    collect_facts(cx, p, pcx);
    edge_fact(cx, p, h, pcx);
}

fn is_back_edge(cx: &mut FnCtx<Comp>, p: i64, h: i64) -> bool {
    dominates(cx, h, p)
}

fn has_back_edge(cx: &mut FnCtx<Comp>, h: i64) -> bool {
    unsafe {
        for i in 0..(cx.blocks[h as usize]).preds.len() as i64 {
            let p = ((cx.blocks[h as usize]).preds[i as usize]);
            if (cx.blocks[p as usize]).order >= 0 && is_back_edge(cx, p, h) {
                return true;
            }
        }
        false
    }
}

// Whether phi v's range is kept, or being found.
fn phi_known(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        if v < cx.pr_gen.len() as i64 && (cx.pr_gen[v as usize]) == cx.range_gen {
            return true;
        }
        let mut k: i64 = 0;
        while k < cx.pr_stack.len() as i64 {
            if (cx.pr_stack[k as usize]) == v {
                return true;
            }
            k += PR_STRIDE;
        }
        false
    }
}

fn pr_push(cx: &mut FnCtx<Comp>, v: i64, lo: i64, hi: i64) {
    cx.pr_stack.push(v);
    cx.pr_stack.push(lo);
    cx.pr_stack.push(hi);
    cx.pr_frames += 1;
    cx.pr_stack.push(cx.pr_frames);
}

// Starts finding ranges at stack level `level`: the taint so far, set
// aside.
fn taint_enter(cx: &mut FnCtx<Comp>) -> i64 {
    let outer = cx.pr_taint;
    cx.pr_taint = NO_TAINT;
    outer
}

// Ends it: the outermost level whose assumption what was found used (at
// least `level`: none from outside, it may be kept).
fn taint_leave(cx: &mut FnCtx<Comp>, level: i64, outer: i64) -> i64 {
    let taint = cx.pr_taint;
    cx.pr_taint = if taint < level { lesser(outer, taint) } else { outer };
    taint
}

fn top_frame(cx: &mut FnCtx<Comp>) -> i64 {
    if cx.pr_stack.len() as i64 == 0 { 0 }
    else { (cx.pr_stack[(cx.pr_stack.len() as i64 - 1) as usize]) }
}

// Keeps phi v's range [lo, hi], found at stack level `level` using the
// assumptions down to level `taint`.
fn pr_keep(cx: &mut FnCtx<Comp>, v: i64, lo: i64, hi: i64, level: i64, taint: i64) {
    unsafe {
        if taint >= level {
            (cx.pr_gen[v as usize]) = cx.range_gen;
            (cx.pr_lo[v as usize]) = lo;
            (cx.pr_hi[v as usize]) = hi;
        } else {
            (cx.pt_gen[v as usize]) = cx.range_gen;
            (cx.pt_frame[v as usize]) = top_frame(cx);
            (cx.pt_lo[v as usize]) = lo;
            (cx.pt_hi[v as usize]) = hi;
            (cx.pt_taint_of[v as usize]) = taint;
        }
    }
}

// The range of phi v (*lo and *hi hold its type's on entry).
pub fn phi_range(cx: &mut FnCtx<Comp>, v: i64, lo: &mut i64, hi: &mut i64, depth: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        if cx.pr_gen.len() as i64 <= cx.insts.len() as i64 {
            // (0.28) The tables grow with what they hold: the instructions
            // made for the facts (edge_fact) may pass their size within a
            // generation, and whether they do depends on the size the
            // thread's earlier functions left. Emptied then, the ranges kept
            // so far were found again within what was left of PR_BUDGET, and
            // the code depended on the schedule.
            // (what they hold is kept; the new entries are 0: no generation)
            let cap = 2 * cx.insts.len() + 1024;
            cx.pr_gen.resize(cap, 0);
            cx.pr_lo.resize(cap, 0);
            cx.pr_hi.resize(cap, 0);
            cx.pt_gen.resize(cap, 0);
            cx.pt_frame.resize(cap, 0);
            cx.pt_lo.resize(cap, 0);
            cx.pt_hi.resize(cap, 0);
            cx.pt_taint_of.resize(cap, 0);
        }
        if (cx.pr_gen[v as usize]) == cx.range_gen {
            *lo = (cx.pr_lo[v as usize]);
            *hi = (cx.pr_hi[v as usize]);
            return;
        }
        if (cx.pt_gen[v as usize]) == cx.range_gen
            && (cx.pt_frame[v as usize]) == top_frame(cx) {
            // (Found under this very stack: under the same assumptions.)
            *lo = (cx.pt_lo[v as usize]);
            *hi = (cx.pt_hi[v as usize]);
            if (cx.pt_taint_of[v as usize]) < cx.pr_taint {
                cx.pr_taint = (cx.pt_taint_of[v as usize]);
            }
            return;
        }
        let mut k: i64 = 0;
        while k < cx.pr_stack.len() as i64 {
            if (cx.pr_stack[k as usize]) == v {
                *lo = (cx.pr_stack[(k + 1) as usize]);
                *hi = (cx.pr_stack[(k + 2) as usize]);
                if k / PR_STRIDE < cx.pr_taint {
                    cx.pr_taint = k / PR_STRIDE;
                }
                return;
            }
            k += PR_STRIDE;
        }
        let h = (cx.insts[v as usize]).block;
        if !cx.phi_ranges || cx.pr_stack.len() as i64 >= PR_STRIDE * PHI_NEST
            || cx.pr_active >= PHI_FINDS || cx.pr_work >= PR_BUDGET || h == 0
            || (cx.blocks[h as usize]).order < 0 || (cx.insts[v as usize]).nargs
            != (cx.blocks[h as usize]).preds.len() as i64 {
            return;
        }
        cx.pr_work += 1;
        if has_back_edge(cx, h) {
            header_ranges(cx, h, v, lo, hi, depth, pcx);
            return;
        }
        // In a loop, its header's phis first (they may be what v's operands
        // come from).
        let l = innermost_loop(cx, h);
        if l >= 0 && l < loop_count(cx) {
            let hh = loop_header(cx, l);
            let first = (cx.blocks[hh as usize]).first;
            if hh != h && (cx.blocks[hh as usize]).order >= 0 && first != 0
                && (cx.insts[first as usize]).op == Op::Phi && !phi_known(cx, first)
                && is_integer((cx.insts[first as usize]).ty)
                && (cx.insts[first as usize]).nargs
                == (cx.blocks[hh as usize]).preds.len() as i64
                && has_back_edge(cx, hh) {
                let mut ilo = type_min((cx.insts[first as usize]).ty);
                let mut ihi = type_max((cx.insts[first as usize]).ty);
                header_ranges(cx, hh, first, &mut ilo, &mut ihi, depth, pcx);
            }
        }
        let tlo = *lo;
        let thi = *hi;
        let level = cx.pr_stack.len() as i64 / PR_STRIDE;
        let outer = taint_enter(cx);
        let mark = facts_save(cx);
        // (A phi's range does not depend on where it is asked for: kept,
        // it must not depend on how deep that was.)
        let fact_nest = cx.fact_nest;
        cx.fact_nest = 0;
        cx.pr_active += 1;
        pr_push(cx, v, tlo, thi);
        let mut rlo = thi;
        let mut rhi = tlo;
        for i in 0..(cx.insts[v as usize]).nargs {
            let p = ((cx.blocks[h as usize]).preds[i as usize]);
            if (cx.blocks[p as usize]).order < 0 {
                continue;
            }
            edge_facts(cx, p, h, pcx);
            let mut alo: i64 = 0;
            let mut ahi: i64 = 0;
            let ir_arg_v = ir_arg(cx, v, i);
            let ir_val_v = ir_val(cx, ir_arg_v);
            range_with_facts(cx, ir_val_v, &mut alo, &mut ahi, 1, pcx);
            rlo = lesser(rlo, alo);
            rhi = greater(rhi, ahi);
        }
        cx.pr_stack.truncate((cx.pr_stack.len() as i64 - PR_STRIDE) as usize);
        facts_restore(cx, mark);
        cx.fact_nest = fact_nest;
        cx.pr_active -= 1;
        if rlo > rhi {
            rlo = tlo;
            rhi = thi;
        }
        rlo = greater(rlo, tlo);
        rhi = lesser(rhi, thi);
        let taint = taint_leave(cx, level, outer);
        pr_keep(cx, v, rlo, rhi, level, taint);
        *lo = rlo;
        *hi = rhi;
    }
}

// The ranges of the integer phis of loop header h (the first HEADER_PHIS),
// found together; *lo and *hi for v among them (its type's range on
// entry).
fn header_ranges(cx: &mut FnCtx<Comp>, h: i64, v: i64, lo: &mut i64, hi: &mut i64, depth: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        let base = cx.hr.len() as i64;
        let mut n: i64 = 0;
        let mut phi = (cx.blocks[h as usize]).first;
        while phi != 0 && (cx.insts[phi as usize]).op == Op::Phi && n < HEADER_PHIS {
            let ty = (cx.insts[phi as usize]).ty;
            if is_integer(ty)
                && (cx.insts[phi as usize]).nargs
                == (cx.blocks[h as usize]).preds.len() as i64
                && !phi_known(cx, phi) {
                cx.hr.push(phi);
                cx.hr.push(type_min(ty));
                cx.hr.push(type_max(ty));
                cx.hr.push(type_max(ty));
                cx.hr.push(type_min(ty));
                for _ in 5..HR_FIELDS {
                    cx.hr.push(0);
                }
                n += 1;
            }
            phi = (cx.insts[phi as usize]).next;
        }
        let level = cx.pr_stack.len() as i64 / PR_STRIDE;
        if n == 0 || cx.pr_stack.len() as i64 + PR_STRIDE * n > PR_STRIDE * PHI_NEST {
            cx.hr.truncate(base as usize);
            return;
        }
        let outer = taint_enter(cx);
        let mark = facts_save(cx);
        let fact_nest = cx.fact_nest;
        cx.fact_nest = 0;
        cx.pr_active += 1;
        // The entry operands.
        let mut entries: i64 = 0;
        for i in 0..(cx.blocks[h as usize]).preds.len() as i64 {
            let p = ((cx.blocks[h as usize]).preds[i as usize]);
            if (cx.blocks[p as usize]).order < 0 || is_back_edge(cx, p, h) {
                continue;
            }
            entries += 1;
            edge_facts(cx, p, h, pcx);
            for m in 0..n {
                let e = base + m * HR_FIELDS;
                let mut alo: i64 = 0;
                let mut ahi: i64 = 0;
                let ir_arg_v = ir_arg(cx, (cx.hr[(e + HR_PHI) as usize]), i);
                let ir_val_v = ir_val(cx, ir_arg_v);
                range_with_facts(cx, ir_val_v, &mut alo,
                    &mut ahi, 1, pcx);
                (cx.hr[(e + HR_RLO) as usize]) = lesser(
                    (cx.hr[(e + HR_RLO) as usize]), alo);
                (cx.hr[(e + HR_RHI) as usize]) = greater(
                    (cx.hr[(e + HR_RHI) as usize]), ahi);
            }
        }
        let mut settled = entries > 0;
        if settled {
            for m in 0..n {
                let e = base + m * HR_FIELDS;
                (cx.hr[(e + HR_HLO) as usize]) = (cx.hr[(e + HR_RLO) as usize]);
                (cx.hr[(e + HR_HHI) as usize]) = (cx.hr[(e + HR_RHI) as usize]);
            }
            // Each round ranges the operands coming back under the
            // assumptions, then widens those they leave (each at most three
            // times).
            settled = false;
            for _ in 0..3 * n + 1 {
                for m in 0..n {
                    let e = base + m * HR_FIELDS;
                    pr_push(cx, (cx.hr[(e + HR_PHI) as usize]),
                        (cx.hr[(e + HR_HLO) as usize]),
                        (cx.hr[(e + HR_HHI) as usize]));
                    (cx.hr[(e + HR_BLO) as usize]) = MAX_I64;
                    (cx.hr[(e + HR_BHI) as usize]) = MIN_I64;
                }
                for i in 0..(cx.blocks[h as usize]).preds.len() as i64 {
                    let p = ((cx.blocks[h as usize]).preds[i as usize]);
                    if (cx.blocks[p as usize]).order < 0 || !is_back_edge(cx, p, h) {
                        continue;
                    }
                    edge_facts(cx, p, h, pcx);
                    for m in 0..n {
                        let e = base + m * HR_FIELDS;
                        let mut blo: i64 = 0;
                        let mut bhi: i64 = 0;
                        let ir_arg_v1 = ir_arg(cx, (cx.hr[(e + HR_PHI) as usize]), i);
                        let ir_val_v1 = ir_val(cx, ir_arg_v1);
                        range_with_facts(cx, ir_val_v1,
                            &mut blo, &mut bhi, 1, pcx);
                        (cx.hr[(e + HR_BLO) as usize]) = lesser(
                            (cx.hr[(e + HR_BLO) as usize]), blo);
                        (cx.hr[(e + HR_BHI) as usize]) = greater(
                            (cx.hr[(e + HR_BHI) as usize]), bhi);
                    }
                }
                cx.pr_stack.truncate((cx.pr_stack.len() as i64 - PR_STRIDE * n) as usize);
                let mut widened = false;
                for m in 0..n {
                    let e = base + m * HR_FIELDS;
                    let blo = (cx.hr[(e + HR_BLO) as usize]);
                    let bhi = (cx.hr[(e + HR_BHI) as usize]);
                    let hlo = (cx.hr[(e + HR_HLO) as usize]);
                    let hhi = (cx.hr[(e + HR_HHI) as usize]);
                    if blo >= hlo && bhi <= hhi {
                        continue;
                    }
                    widened = true;
                    (cx.hr[(e + HR_STAGE) as usize]) += 1;
                    if (cx.hr[(e + HR_STAGE) as usize]) == 1 {
                        (cx.hr[(e + HR_HLO) as usize]) = lesser(hlo, blo);
                        (cx.hr[(e + HR_HHI) as usize]) = greater(hhi, bhi);
                    } else if (cx.hr[(e + HR_STAGE) as usize]) == 2 {
                        let mut flo: i64 = 0;
                        let mut fhi: i64 = 0;
                        back_fact_hull(cx, h, (cx.hr[(e + HR_PHI) as usize]),
                            (cx.hr[(e + HR_TLO) as usize]),
                            (cx.hr[(e + HR_THI) as usize]), &mut flo, &mut fhi, pcx);
                        if blo < hlo {
                            (cx.hr[(e + HR_HLO) as usize]) = lesser(hlo, flo);
                        }
                        if bhi > hhi {
                            (cx.hr[(e + HR_HHI) as usize]) = greater(hhi, fhi);
                        }
                    } else {
                        (cx.hr[(e + HR_HLO) as usize]) = (cx.hr[(e + HR_TLO) as usize]);
                        (cx.hr[(e + HR_HHI) as usize]) = (cx.hr[(e + HR_THI) as usize]);
                    }
                }
                if !widened {
                    settled = true;
                    break;
                }
            }
        }
        facts_restore(cx, mark);
        cx.fact_nest = fact_nest;
        cx.pr_active -= 1;
        let taint = taint_leave(cx, level, outer);
        let keep = taint >= level;
        for m in 0..n {
            let e = base + m * HR_FIELDS;
            let tlo = (cx.hr[(e + HR_TLO) as usize]);
            let thi = (cx.hr[(e + HR_THI) as usize]);
            let mut rlo = tlo;
            let mut rhi = thi;
            if settled {
                rlo = greater(tlo,
                    lesser((cx.hr[(e + HR_RLO) as usize]),
                        (cx.hr[(e + HR_BLO) as usize])));
                rhi = lesser(thi,
                    greater((cx.hr[(e + HR_RHI) as usize]),
                        (cx.hr[(e + HR_BHI) as usize])));
            }
            let p = (cx.hr[(e + HR_PHI) as usize]);
            pr_keep(cx, p, rlo, rhi, level, taint);
            if p == v {
                *lo = rlo;
                *hi = rhi;
            }
        }
        cx.hr.truncate(base as usize);
    }
}

// What the facts on the edges into h coming back say of phi v's operands
// there (of type range [tlo, thi]), alone.
fn back_fact_hull(cx: &mut FnCtx<Comp>, h: i64, v: i64, tlo: i64, thi: i64, lo: &mut i64,
    hi: &mut i64, pcx: &Ctx<Comp>) {
    unsafe {
        let mut rlo = thi;
        let mut rhi = tlo;
        for i in 0..(cx.insts[v as usize]).nargs {
            let p = ((cx.blocks[h as usize]).preds[i as usize]);
            if (cx.blocks[p as usize]).order < 0 || !is_back_edge(cx, p, h) {
                continue;
            }
            edge_facts(cx, p, h, pcx);
            let mut olo = tlo;
            let mut ohi = thi;
            let ir_arg_v = ir_arg(cx, v, i);
            let ir_val_v = ir_val(cx, ir_arg_v);
            narrow_by_facts(cx, ir_val_v, &mut olo, &mut ohi, 1, pcx);
            rlo = lesser(rlo, olo);
            rhi = greater(rhi, ohi);
        }
        *lo = rlo;
        *hi = rhi;
    }
}
