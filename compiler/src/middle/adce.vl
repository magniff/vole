// Aggressive dead code elimination (0.4): liveness over data and control
// dependence. Instructions with effects and returns are live; so are the
// operands of live instructions, and the branches a live block is control
// dependent on (Ferrante, Ottenstein & Warren: block b depends on the
// branch at x when b post-dominates a successor of x but not x itself),
// and the branches of the blocks a live phi comes from. Every other
// instruction is removed, and a branch that is not live becomes a jump to
// its immediate post-dominator. Branches inside loops and in blocks that
// cannot reach a return are kept live: a loop may not terminate, and only
// scev.vl's deletion of finite loops removes loops.

// Per block id: the immediate post-dominator (-1: the virtual exit, 0:
// none: the block cannot reach a return) and the post-order number.
use crate::base::{IntVec, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;
use crate::middle::ipo::has_effect;
use crate::middle::ir::{Op, Term, ir_enter, ir_operand, ir_operand_count, ir_unlink};
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::loops::{analyze_loops, block_array, innermost_loop};
use crate::middle::opt::{remove_pred, remove_trivial_phis, remove_unreachable, resolve_all};

fn is_exit_block(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    unsafe {
        (*cx.blocks.add(b as usize)).term == Term::Ret
            || (*cx.blocks.add(b as usize)).term == Term::Unreach
    }
}

fn pdom_intersect(cx: &mut FnCtx<Comp>, b1: i64, b2: i64) -> i64 {
    unsafe {
        let mut x = b1;
        let mut y = b2;
        while x != y {
            while x != -1
                && (y == -1 || (*cx.porder.add(x as usize)) < (*cx.porder.add(y as usize))) {
                x = (*cx.pdom.add(x as usize));
            }
            while y != -1
                && (x == -1 || (*cx.porder.add(y as usize)) < (*cx.porder.add(x as usize))) {
                y = (*cx.pdom.add(y as usize));
            }
        }
        x
    }
}

// Post-dominators of fi's reachable blocks (layout_blocks done).
fn compute_post_dominators(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        cx.pdom = block_array(cx, cx.pdom, &mut cx.pdom_cap, fi);
        cx.porder = block_array(cx, cx.porder, &mut cx.porder_cap, fi);
        // Post-order of the reverse CFG from the virtual exit (whose number
        // is the largest).
        cx.porder_list.clear();
        cx.ad_seen = block_array(cx, cx.ad_seen, &mut cx.ad_seen_cap, fi);
        let seen = cx.ad_seen;
        let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.order.len() as i64 {
            let r = (cx.order[i as usize]);
            if !is_exit_block(cx, r) || (*seen.add(r as usize)) != 0 {
                continue;
            }
            (*seen.add(r as usize)) = 1;
            stack.push(r);
            stack.push(0);
            while stack.len() as i64 > 0 {
                let b = (stack[(stack.len() as i64 - 2) as usize]);
                let k = (stack[(stack.len() as i64 - 1) as usize]);
                if k < (*cx.blocks.add(b as usize)).preds.len() as i64 {
                    (stack[(stack.len() as i64 - 1) as usize]) = k + 1;
                    let p = ((*cx.blocks.add(b as usize)).preds[k as usize]);
                    if (*cx.blocks.add(p as usize)).order >= 0 && (*seen.add(p as usize)) == 0 {
                        (*seen.add(p as usize)) = 1;
                        stack.push(p);
                        stack.push(0);
                    }
                } else {
                    stack.truncate(stack.len() as i64 - 2);
                    (*cx.porder.add(b as usize)) = cx.porder_list.len() as i64 + 1;
                    cx.porder_list.push(b);
                }
            }
        }
        free(stack.data as *mut u8);
        for i in 0..cx.porder_list.len() as i64 {
            let b = (cx.porder_list[i as usize]);
            (*cx.pdom.add(b as usize)) = if is_exit_block(cx, b) { -1 } else { 0 };
        }
        // The virtual exit's number is above every block's.
        let mut changed = true;
        while changed {
            changed = false;
            let mut i = cx.porder_list.len() as i64;
            while i > 0 {
                i -= 1;
                let b = (cx.porder_list[i as usize]);
                if is_exit_block(cx, b) {
                    continue;
                }
                let mut new_pdom: i64 = 0;
                for k in 0..succ_count(cx, b) {
                    let s = succ(cx, b, k);
                    if (*cx.porder.add(s as usize)) == 0 || (*cx.pdom.add(s as usize)) == 0 {
                        continue;
                    }
                    new_pdom = if new_pdom == 0 { s } else { pdom_intersect(cx, s, new_pdom) };
                }
                if new_pdom != (*cx.pdom.add(b as usize)) {
                    (*cx.pdom.add(b as usize)) = new_pdom;
                    changed = true;
                }
            }
        }
    }
}

fn adce_mark(cx: &mut FnCtx<Comp>, v: i64, work: &mut IntVec) {
    unsafe {
        if v != 0 && (*cx.insts.add(v as usize)).mark == 0 {
            (*cx.insts.add(v as usize)).mark = 1;
            work.push(v);
        }
    }
}

// Marks block b's terminator live (and b itself).
fn adce_mark_branch(cx: &mut FnCtx<Comp>, b: i64, live_term: *mut i64, blocks: &mut IntVec,
    work: &mut IntVec) {
    unsafe {
        if (*live_term.add(b as usize)) == 0 {
            (*live_term.add(b as usize)) = 1;
            blocks.push(b);
            adce_mark(cx, (*cx.blocks.add(b as usize)).cond, work);
        }
    }
}

pub fn aggressive_dce(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        resolve_all(cx, fi);
        analyze_loops(cx, fi);
        compute_post_dominators(cx, fi);
        // Control dependence: the branches each block depends on, as lists
        // (CD_FIRST[b] .. linked through CD_NEXT).
        let mut deps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        cx.ad_first = block_array(cx, cx.ad_first, &mut cx.ad_first_cap, fi);
        let first = cx.ad_first;
        for i in 0..cx.order.len() as i64 {
            let x = (cx.order[i as usize]);
            if succ_count(cx, x) < 2 || (*cx.porder.add(x as usize)) == 0
                || (*cx.pdom.add(x as usize)) == 0 {
                continue;
            }
            for k in 0..succ_count(cx, x) {
                let mut runner = succ(cx, x, k);
                while runner != (*cx.pdom.add(x as usize)) && runner > 0
                    && (*cx.porder.add(runner as usize)) != 0 {
                    deps.push(x);
                    deps.push((*first.add(runner as usize)));
                    (*first.add(runner as usize)) = deps.len() as i64 / 2;
                    runner = (*cx.pdom.add(runner as usize));
                    if runner == 0 {
                        break;
                    }
                }
            }
        }
        cx.ad_term = block_array(cx, cx.ad_term, &mut cx.ad_term_cap, fi);
        cx.ad_block = block_array(cx, cx.ad_block, &mut cx.ad_block_cap, fi);
        let live_term = cx.ad_term;
        let live_block = cx.ad_block;
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut blocks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.order.len() as i64 {
            let b = (cx.order[i as usize]);
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                (*cx.insts.add(v as usize)).mark = 0;
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        for i in 0..cx.order.len() as i64 {
            let b = (cx.order[i as usize]);
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if has_effect(cx, v, pcx) {
                    adce_mark(cx, v, &mut work);
                }
                v = (*cx.insts.add(v as usize)).next;
            }
            // Branches that stay: in loops, unable to reach a return, or
            // without a post-dominator a jump could go to (one with phis).
            let j = (*cx.pdom.add(b as usize));
            let mut keep = is_exit_block(cx, b) || innermost_loop(cx, b) >= 0
                || (*cx.porder.add(b as usize)) == 0 || j <= 0;
            if !keep && (*cx.blocks.add(b as usize)).term != Term::Jump {
                let f = (*cx.blocks.add(j as usize)).first;
                keep = f != 0 && (*cx.insts.add(f as usize)).op == Op::Phi;
            }
            // (0.28.0) And one with a successor that reaches no exit, an
            // endless loop: post-dominance does not see such a block (no
            // control dependence is recorded for it), so the branch into
            // it was dead, and was made a jump to its post-dominator, the
            // other arm: `eprintln(..); loop { c_call(); }` ran the
            // print's panic arm instead of the loop and trapped.
            if !keep && (*cx.blocks.add(b as usize)).term != Term::Jump {
                for k in 0..succ_count(cx, b) {
                    let s = succ(cx, b, k);
                    if s > 0 && (*cx.porder.add(s as usize)) == 0 {
                        keep = true;
                    }
                }
            }
            if keep && (*cx.blocks.add(b as usize)).term != Term::Jump {
                adce_mark_branch(cx, b, live_term, &mut blocks, &mut work);
            } else if is_exit_block(cx, b) {
                adce_mark_branch(cx, b, live_term, &mut blocks, &mut work);
            }
        }
        while work.len() as i64 > 0 || blocks.len() as i64 > 0 {
            if work.len() as i64 > 0 {
                let v = work.pop();
                let b = (*cx.insts.add(v as usize)).block;
                if b != 0 && (*live_block.add(b as usize)) == 0 {
                    (*live_block.add(b as usize)) = 1;
                    blocks.push(b);
                }
                for k in 0..ir_operand_count(cx, v) {
                    let ir_operand_v = ir_operand(cx, v, k);
                    adce_mark(cx, ir_operand_v, &mut work);
                }
                if (*cx.insts.add(v as usize)).op == Op::Phi && b != 0 {
                    for k in 0..(*cx.blocks.add(b as usize)).preds.len() as i64 {
                        adce_mark_branch(cx,
                            ((*cx.blocks.add(b as usize)).preds[k as usize]), live_term,
                            &mut blocks, &mut work);
                    }
                }
                continue;
            }
            let b = blocks.pop();
            (*live_block.add(b as usize)) = 1;
            let mut d = (*first.add(b as usize));
            while d != 0 {
                adce_mark_branch(cx, (deps[(2 * (d - 1)) as usize]), live_term,
                    &mut blocks, &mut work);
                d = (deps[(2 * (d - 1) + 1) as usize]);
            }
        }
        // Sweep.
        let mut changed = false;
        for i in 0..cx.order.len() as i64 {
            let b = (cx.order[i as usize]);
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if (*cx.insts.add(v as usize)).mark == 0 {
                    ir_unlink(cx, v);
                    changed = true;
                }
                v = next;
            }
        }
        for i in 0..cx.order.len() as i64 {
            let b = (cx.order[i as usize]);
            if (*live_term.add(b as usize)) != 0
                || ((*cx.blocks.add(b as usize)).term != Term::Branch
                    && (*cx.blocks.add(b as usize)).term != Term::Switch) {
                continue;
            }
            let j = (*cx.pdom.add(b as usize));
            if j <= 0 {
                continue;
            }
            let first_inst = (*cx.blocks.add(j as usize)).first;
            if first_inst != 0 && (*cx.insts.add(first_inst as usize)).op == Op::Phi {
                continue;
            }
            for k in 0..succ_count(cx, b) {
                let succ_v = succ(cx, b, k);
                remove_pred(cx, succ_v, b);
            }
            (*cx.blocks.add(b as usize)).term = Term::Jump;
            (*cx.blocks.add(b as usize)).cond = 0;
            (*cx.blocks.add(b as usize)).s0 = j;
            (*cx.blocks.add(b as usize)).s1 = 0;
            (*cx.blocks.add(j as usize)).preds.push(b);
            changed = true;
        }
        free(deps.data as *mut u8);
        free(work.data as *mut u8);
        free(blocks.data as *mut u8);
        if changed {
            remove_unreachable(cx, fi);
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
        }
        changed
    }
}
