// Value numbering's regions and calls (split from gvn.vl): whether what
// gvn knows at the end of a dominating block still holds where it is
// inherited (the writes of the blocks between applied), and the numbering
// of calls the effects make pure: readnone calls by callee and arguments,
// readonly ones while nothing is written (0.16).

use crate::base::{IntVec, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::apply_block_kills;
use crate::middle::ipo::{ATTR_READNONE, ATTR_READONLY, call_attrs};
use crate::middle::ir::{Op, get_irfuncs, ir_arg, ir_val};
use crate::middle::ir::Op::CallC;

pub fn inherit_into(cx: &mut FnCtx<Comp>, d: i64, c: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if (*cx.blocks.add(c as usize)).preds.len() as i64 == 1
            && ((*cx.blocks.add(c as usize)).preds[0]) == d {
            return true;
        }
        cx.region_stamp += 1;
        let stamp = cx.region_stamp;
        cx.region.clear();
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..(*cx.blocks.add(c as usize)).preds.len() as i64 {
            work.push(((*cx.blocks.add(c as usize)).preds[i as usize]));
        }
        let mut ok = true;
        while work.len() as i64 > 0 {
            let b = work.pop();
            if b == d || (*cx.blocks.add(b as usize)).mark == stamp {
                continue;
            }
            (*cx.blocks.add(b as usize)).mark = stamp;
            cx.region.push(b);
            if cx.region.len() as i64 > 64 {
                ok = false;
                break;
            }
            for i in 0..(*cx.blocks.add(b as usize)).preds.len() as i64 {
                work.push(((*cx.blocks.add(b as usize)).preds[i as usize]));
            }
        }
        free(work.data as *mut u8);
        if !ok {
            return false;
        }
        for i in 0..cx.region.len() as i64 {
            apply_block_kills(cx, (cx.region[i as usize]), pcx);
        }
        true
    }
}

// How call v may be numbered: 1 when it reads and writes no memory
// (ATTR_READNONE: an equal call dominating it is the same value), 2 when
// it only reads (ATTR_READONLY: the same within a block while nothing is
// written), 0 not at all (an indirect call, a compound result, no
// result).
pub fn call_numbering(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if op != Op::Call && op != CallC || (cx.insts[v as usize]).ty == 0
            || (cx.insts[v as usize]).c != 0 {
            return 0;
        }
        let attrs = call_attrs(cx, v, pcx);
        if (attrs & ATTR_READNONE) != 0 {
            return 1;
        }
        if (attrs & ATTR_READONLY) != 0 {
            return 2;
        }
        0
    }
}

// Whether calls v and w call one function with the same arguments.
fn same_call(cx: &mut FnCtx<Comp>, v: i64, w: i64) -> bool {
    unsafe {
        if (cx.insts[v as usize]).op != (cx.insts[w as usize]).op
            || (cx.insts[v as usize]).imm != (cx.insts[w as usize]).imm
            || (cx.insts[v as usize]).nargs != (cx.insts[w as usize]).nargs {
            return false;
        }
        for i in 0..(cx.insts[v as usize]).nargs {
            let ir_arg_v = ir_arg(cx, v, i);
            let ir_val_v = ir_val(cx, ir_arg_v);
            let ir_arg_v1 = ir_arg(cx, w, i);
            let ir_val_v1 = ir_val(cx, ir_arg_v1);
            if ir_val_v != ir_val_v1 {
                return false;
            }
        }
        true
    }
}

// (0.16) Whether function fi has two calls value numbering may merge (the
// same callee and arguments, READNONE or READONLY): at -O2, its callees' attributes are
// known only once they are optimized, after fi's first value numbering.
pub fn repeated_pure_calls(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut seen = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut found = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 && !found {
                if (cx.insts[v as usize]).op.is_call() && call_numbering(cx, v, pcx) != 0 {
                    for k in 0..seen.len() as i64 {
                        // (a readonly call is merged within its block only)
                        if same_call(cx, (seen[k as usize]), v)
                            && (call_numbering(cx, v, pcx) == 1
                                || (cx.insts[(seen[k as usize]) as usize]).block
                                == (cx.insts[v as usize]).block) {
                            found = true;
                        }
                    }
                    if seen.len() as i64 < 64 {
                        seen.push(v);
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        free(seen.data as *mut u8);
        found
    }
}
