// Facts at a callee's entry from its checked `requires` (0.18.1; design
// §2.5 item 2; docs/optimizer.md, "Contracts and generated code"), for
// the range analysis, value numbering and the bounds checks of a function
// that is not inlined (an inlined copy has the call's checks before it).
//
// A requires is checked at every direct call, before it (desugar.vl:
// `f$pre(SITE, args); f(args)`), so at f's entry its clauses hold: each
// call either passed the checks with these arguments or the program has
// exited. f's body takes them as facts the way an inlined copy takes the
// checks before it, as branches whose failing side is empty and ends the
// function unreachable:
//
// 1. lowering (-O2): f's entry calls `f$pre(ENTRY_SITE, <parameters>)`
//    when front/contracts::desugar::entry_pre allows (cheap clauses,
//    scalar parameters, f not entered from C; 0.26.1: so no fact is ever
//    about memory behind a reference, and a cell, which changes through
//    one, needs nothing here);
// 2. strip_taken, before the program's cleanup: a function whose address
//    the program takes may be called indirectly, which does not check:
//    its entry call goes, it assumes nothing; so does one a caller may
//    inline (inline::never_inlined), whose loops are better left to the
//    caller as they would be without the facts;
// 3. entry_assumes, after inlining into f: the companion's checks, inlined
//    with ENTRY_SITE as their site, lose their failure (the block made
//    empty); the companion if not inlined goes;
// 4. drop_assumes, before code generation: the branches into such blocks
//    (and into an exhaustive match's empty end, as never reached) become
//    jumps and the conditions, unused, go.
//
// The clauses are evaluated again only between 3 and 4, in the IR; the
// code emitted has nothing of them.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child, list_begin, list_end, list_push, new_node};
use crate::front::check::Res;
use crate::front::contracts::desugar::entry_pre;
use crate::front::types::{TY_BOOL, TY_I64, TY_UNIT, fn_param};
use crate::gen0::target::rt_panic_sym;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::inline::never_inlined;
use crate::middle::ir::{IRFUNCS, Op, Term, ir_append, ir_arg, ir_enter, ir_make, ir_unlink, ir_val};
use crate::middle::ir::verify::verify_func;
use crate::middle::lower::calls::lower_call;
use crate::middle::lower::ssa::HMap;
use crate::middle::opt::{eliminate_dead_code, remove_unreachable, resolve_all, simplify_cfg};

// The site an entry's call of its companion passes: no check's.
pub const ENTRY_SITE: i64 = 0 - 6066930334832433271;

// (1) At the entry of function f (item, its node), its parameters bound:
// `f$pre(ENTRY_SITE, <parameters>)`, when f may take its requires as facts.
pub fn lower_entry_facts(cx: inout FnCtx, item: i64, f: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let pre = entry_pre(f, pcx);
        if pre < 0 {
            return;
        }
        for i in 0..pcx.fns[f].param_count {
            if pcx.nodes[child(item, i, pcx)].x < 0 {
                return;
            }
        }
        let pos = pcx.nodes[item].start;
        let call = new_node(NodeKind::Call, pos, pos, &pcx);
        pcx.nodes[call].x = pre + 1;
        pcx.nodes[call].ty = TY_UNIT;
        let site = new_node(NodeKind::Int, pos, pos, &pcx);
        pcx.nodes[site].a = ENTRY_SITE;
        pcx.nodes[site].ty = TY_I64;
        let mark = list_begin(pcx);
        list_push(site, &pcx);
        for i in 0..pcx.fns[f].param_count {
            let p = child(item, i, pcx);
            let id = new_node(NodeKind::Ident, pos, pos, &pcx);
            pcx.nodes[id].a = pcx.nodes[p].a;
            pcx.nodes[id].res = Res::Local;
            pcx.nodes[id].y = pcx.nodes[p].x;
            pcx.nodes[id].ty = fn_param(f, i, pcx);
            list_push(id, &pcx);
        }
        list_end(call, mark, &pcx);
        lower_call(&cx, call, &pcx);
        pcx.entry_calls += 1;
    }
}

fn is_entry_site(cx: inout FnCtx, v: i64) -> bool {
    unsafe {
        let x = ir_val(&cx, v);
        is_const(&cx, x) && cx.insts[x].imm == ENTRY_SITE
    }
}

// Whether v is a call of a companion from an entry (its first argument
// ENTRY_SITE).
fn is_entry_call(cx: inout FnCtx, v: i64) -> bool {
    unsafe {
        cx.insts[v].op == Op::Call && cx.insts[v].nargs >= 1
            && is_entry_site(&cx, ir_arg(&cx, v, 0))
    }
}

// (2) The entry calls of the functions whose address the program takes,
// and of those a caller may inline, removed before any pass (and the code
// cache's keys) sees them.
pub fn strip_taken(cx: inout FnCtx, pcx: Ctx<Comp>) {
    unsafe {
        if pcx.entry_calls == 0 {
            return;
        }
        var taken = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        for fi in 0..pcx.irfunc_count {
            ir_enter(&cx, fi, pcx);
            for i in 0..IRFUNCS[fi].blocks.count {
                let b = IRFUNCS[fi].blocks.data[i];
                var v = cx.blocks[b].first;
                while v != 0 {
                    if cx.insts[v].op == Op::FAddr {
                        taken.put(cx.insts[v].imm + 1, 1);
                    }
                    v = cx.insts[v].next;
                }
            }
        }
        for fi in 0..pcx.irfunc_count {
            ir_enter(&cx, fi, pcx);
            if taken.get(IRFUNCS[fi].f + 1) == 0 && never_inlined(&cx, fi, pcx) {
                continue;
            }
            ir_enter(&cx, fi, pcx);
            let entry = IRFUNCS[fi].entry;
            var v = cx.blocks[entry].first;
            while v != 0 {
                let next = cx.insts[v].next;
                if is_entry_call(&cx, v) {
                    ir_unlink(&cx, v);
                }
                v = next;
            }
        }
        crate::base::free(taken.keys as *u8);
        crate::base::free(taken.vals as *u8);
    }
}

// (3) After inlining into fi: each failure of a check whose site is
// ENTRY_SITE (a companion inlined at an entry) emptied, its branch kept as
// the fact; a companion's call left in the entry block (not inlined)
// removed. From the IR alone, as the code cache's keys are, and cheap: the
// entry block and the last instruction of each block that ends the
// function unreachable. Returns whether anything changed.
pub fn entry_assumes(cx: inout FnCtx, fi: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var changed = false;
        let entry = IRFUNCS[fi].entry;
        var v = cx.blocks[entry].first;
        while v != 0 {
            let next = cx.insts[v].next;
            if is_entry_call(&cx, v) {
                ir_unlink(&cx, v);
                changed = true;
            }
            v = next;
        }
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            let last = cx.blocks[b].last;
            if cx.blocks[b].removed != 0 || cx.blocks[b].term != Term::Unreach || last == 0
                || cx.insts[last].op != Op::CallC || cx.insts[last].imm != rt_panic_sym()
                || cx.insts[last].nargs < 5 || !is_entry_site(&cx, ir_arg(&cx, last, 4)) {
                continue;
            }
            // (nothing defined in a block that ends the function is used
            // outside it)
            var w = cx.blocks[b].first;
            while w != 0 {
                let after = cx.insts[w].next;
                ir_unlink(&cx, w);
                w = after;
            }
            changed = true;
        }
        if changed {
            resolve_all(&cx, fi);
            eliminate_dead_code(&cx, fi, pcx);
            verify_func(&cx, fi, c"entry facts", pcx);
        }
        changed
    }
}

// An empty block that ends the function unreachable: an assumption's
// failing side (or a match's, exhaustive): never reached.
fn is_assumed_away(cx: inout FnCtx, b: i64) -> bool {
    unsafe { cx.blocks[b].term == Term::Unreach && cx.blocks[b].first == 0 }
}

// (4) Before code generation: each branch into an empty unreachable block
// made a jump to its other side, and what computed its condition removed.
pub fn drop_assumes(cx: inout FnCtx, fi: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        var changed = false;
        for i in 0..IRFUNCS[fi].blocks.count {
            let b = IRFUNCS[fi].blocks.data[i];
            if cx.blocks[b].removed != 0 || cx.blocks[b].term != Term::Branch
                || cx.blocks[b].s0 == cx.blocks[b].s1
                || is_const(&cx, ir_val(&cx, cx.blocks[b].cond)) {
                continue;
            }
            var d = -1;
            if is_assumed_away(&cx, cx.blocks[b].s1) {
                d = 1;
            } else if is_assumed_away(&cx, cx.blocks[b].s0) {
                d = 0;
            }
            if d >= 0 {
                let k = ir_make(&cx, Op::Const, TY_BOOL, 0, 0, d, pcx);
                ir_append(&cx, b, k);
                cx.blocks[b].cond = k;
                changed = true;
            }
        }
        if changed {
            simplify_cfg(&cx, fi, pcx);
            resolve_all(&cx, fi);
            remove_unreachable(&cx, fi);
            eliminate_dead_code(&cx, fi, pcx);
            verify_func(&cx, fi, c"assumptions dropped", pcx);
        }
        changed
    }
}
