// Copy elision (0.14): a whole frame slot copied into another (all of it,
// or a part at a constant offset: a field), by a copy that runs once (in
// no loop), where the source is only used before the copy, and the part
// of the destination only after it, is that part: the source's uses use
// it, and the copy goes. Adapters taking `self: Self` make these chains:
// each level of an iterator chain copies the level below into its own
// struct (memcpy calls above INLINE_COPY_MAX bytes, which scalar
// replacement does not look through). Neither slot's address may escape
// (gvn.vl's find_escaping_slots).

use crate::back::abi::fn_uses_c;
use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_U64, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{address_base, copy_dst, copy_src, find_escaping_slots, is_copy, root_of};
use crate::middle::ir::{
    Op, Term, get_irfuncs, ir_arg, ir_enter, ir_insert_before, ir_make, ir_operand,
    ir_operand_count, ir_replace, ir_unlink, ir_val,
};
use crate::middle::loops::{analyze_loops, innermost_loop};
use crate::middle::opt::{dominates, resolve_all};

// Notes the copies the lowering made since instruction `first` of the
// current function as moves.
pub fn note_move_copies(cx: &mut FnCtx<Comp>, first: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        for v in first..cx.inst_count {
            if (*cx.insts.add(v as usize)).block != 0 && is_copy(cx, v, pcx) {
                pcx.move_copies.push(cx.irf);
                pcx.move_copies.push(v);
            }
        }
    }
}

fn is_move_copy(fi: i64, c: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..pcx.move_copies.len() as i64 / 2 {
        if (pcx.move_copies[(2 * i) as usize]) == fi
            && (pcx.move_copies[(2 * i + 1) as usize]) == c {
            return true;
        }
    }
    false
}

// (0.18.1, back::codecache) The copies noted as moves: (IR function,
// instruction) pairs.
pub fn move_copies(pcx: &mut Ctx<Comp>) -> *mut IntVec {
    &mut pcx.move_copies
}

// The slot that address v is the start of (a SLOT instruction), or -1.
fn whole_slot(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if (*cx.insts.add(x as usize)).op == Op::Slot { (*cx.insts.add(x as usize)).imm }
        else { -1 }
    }
}

// The slot address v points into at a constant offset (in *offset), or -1.
fn slot_at(cx: &mut FnCtx<Comp>, v: i64, offset: &mut i64) -> i64 {
    unsafe {
        let ir_val_v = ir_val(cx, v);
        let base = address_base(cx, ir_val_v, offset);
        if (*cx.insts.add(base as usize)).op == Op::Slot { (*cx.insts.add(base as usize)).imm }
        else { -1 }
    }
}

// The size copy v moves (a constant).
fn copy_size(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    unsafe {
        if (*cx.insts.add(v as usize)).op == Op::Copy { (*cx.insts.add(v as usize)).imm }
        else {
            let ir_arg_v = ir_arg(cx, v, 2); let ir_val_v = ir_val(cx, ir_arg_v);
            (*cx.insts.add(ir_val_v as usize)).imm
        }
    }
}

// Whether instruction u comes strictly before instruction v (u's block
// dominates v's; INSTS[].aux numbers each block's instructions).
fn before(cx: &mut FnCtx<Comp>, u: i64, v: i64) -> bool {
    unsafe {
        let bu = (*cx.insts.add(u as usize)).block;
        let bv = (*cx.insts.add(v as usize)).block;
        if bu == bv { (*cx.insts.add(u as usize)).aux < (*cx.insts.add(v as usize)).aux }
        else { dominates(cx, bu, bv) }
    }
}

// Whether instruction u accesses no byte of slot d in [lo, hi): a load,
// store or copy at constant offsets elsewhere (an address computation is
// not an access: its own uses are).
fn misses(cx: &mut FnCtx<Comp>, u: i64, d: i64, lo: i64, hi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(u as usize)).op;
        if op == Op::Add {
            return true;
        }
        let mut addrs: i64 = 0;
        let mut size: i64 = 0;
        if op == Op::Load {
            addrs = 1;
            size = type_size((*cx.insts.add(u as usize)).ty, pcx);
        } else if op == Op::Store {
            addrs = 1;
            size = type_size((*cx.insts.add(u as usize)).imm2, pcx);
        } else if is_copy(cx, u, pcx) {
            addrs = 2;
            size = copy_size(cx, u);
        } else {
            return false;
        }
        for k in 0..addrs {
            let a = if op == Op::Load || op == Op::Store { (*cx.insts.add(u as usize)).a }
                else if k == 0 { copy_dst(cx, u) } else { copy_src(cx, u) };
            let ir_val_v = ir_val(cx, a);
            let root = root_of(cx, ir_val_v);
            if root == 0 || (*cx.insts.add(root as usize)).op != Op::Slot
                || (*cx.insts.add(root as usize)).imm != d {
                continue;
            }
            let mut offset: i64 = 0;
            if slot_at(cx, a, &mut offset) != d {
                return false;
            }
            if op == Op::Load || op == Op::Store {
                offset += (*cx.insts.add(u as usize)).imm;
            }
            if offset < hi && offset + size > lo {
                return false;
            }
        }
        true
    }
}

// Whether copy c of slot s to slot d at `offset` can be elided: every
// other use of s comes before it, every use of d's part after it (or
// before, elsewhere in d).
fn elidable(cx: &mut FnCtx<Comp>, c: i64, s: i64, d: i64, offset: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let n = (*cx.slots.add(s as usize)).size;
        for k in 0..cx.copies_uses.len() as i64 / 2 {
            let slot = (cx.copies_uses[(2 * k) as usize]);
            let u = (cx.copies_uses[(2 * k + 1) as usize]);
            if u == c || (*cx.insts.add(u as usize)).block == 0 {
                continue;
            }
            if slot == s && !before(cx, u, c) {
                return false;
            }
            if slot == d && !before(cx, c, u)
                && !(before(cx, u, c) && misses(cx, u, d, offset, offset + n, pcx)) {
                return false;
            }
        }
        true
    }
}

// Slot s becomes the part of slot d at `offset`: its SLOT instructions
// compute that address.
fn place_slot(cx: &mut FnCtx<Comp>, fi: i64, s: i64, d: i64, offset: i64, pcx: &Ctx<Comp>) {
    unsafe {
        for j in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[j as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if (*cx.insts.add(v as usize)).op == Op::Slot
                    && (*cx.insts.add(v as usize)).imm == s {
                    if offset == 0 {
                        (*cx.insts.add(v as usize)).imm = d;
                    } else {
                        let base = ir_make(cx, Op::Slot, TY_U64, 0, 0, d, pcx);
                        let k = ir_make(cx, Op::Const, TY_U64, 0, 0, offset, pcx);
                        ir_insert_before(cx, v, base);
                        ir_insert_before(cx, v, k);
                        (*cx.insts.add(base as usize)).aux = (*cx.insts.add(v as usize)).aux;
                        (*cx.insts.add(k as usize)).aux = (*cx.insts.add(v as usize)).aux;
                        (*cx.insts.add(v as usize)).op = Op::Add;
                        (*cx.insts.add(v as usize)).a = base;
                        (*cx.insts.add(v as usize)).b = k;
                        (*cx.insts.add(v as usize)).imm = 0;
                    }
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        for k in 0..cx.copies_uses.len() as i64 / 2 {
            if (cx.copies_uses[(2 * k) as usize]) == s {
                (cx.copies_uses[(2 * k) as usize]) = d;
            }
        }
        if (*cx.slots.add(s as usize)).align > (*cx.slots.add(d as usize)).align {
            (*cx.slots.add(d as usize)).align = (*cx.slots.add(s as usize)).align;
        }
    }
}

// (0.17) The returned local is the result (NRVO): in a function returning a
// compound value through the result pointer, a local slot s that every
// return copies into it (and nothing else touches the result's memory)
// becomes that memory, and the copies go. The caller's result is a fresh
// slot of its own (lower/calls.vl), which nothing else the function
// sees can reach. Only for copies that are memcpy calls (over
// INLINE_COPY_MAX bytes): smaller locals are scalar replacement's, which
// the result's memory would stop. A copy must end its block, which returns,
// so that nothing reads or writes s after it (a defer after the copy).
fn elide_result_copy(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let f = (*get_irfuncs().add(fi as usize)).f;
        let result = (*get_irfuncs().add(fi as usize)).result_ptr;
        if result == 0 || f < 0 || fn_uses_c(f, pcx) {
            return false;
        }
        let r = ir_val(cx, result);
        cx.candidates.clear();
        let mut s: i64 = -1;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w == 0 || ir_val(cx, w) != r {
                        continue;
                    }
                    // The destination of a memcpy (its first argument).
                    if !(is_copy(cx, v, pcx) && (*cx.insts.add(v as usize)).op != Op::Copy
                        && k == 3) {
                        return false;
                    }
                    let copy_src_v = copy_src(cx, v);
                    let src = whole_slot(cx, copy_src_v);
                    if src < 0 || s >= 0 && src != s
                        || (*cx.slots.add(src as usize)).size != copy_size(cx, v)
                        || (*cx.insts.add(v as usize)).next != 0
                        || (*cx.blocks.add(b as usize)).term != Term::Ret {
                        return false;
                    }
                    s = src;
                    cx.candidates.push(v);
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        if s < 0 || (*cx.slots.add(s as usize)).align > 8 {
            return false;
        }
        find_escaping_slots(cx, fi, pcx);
        if (*cx.slots.add(s as usize)).escapes != 0 {
            return false;
        }
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if (*cx.insts.add(v as usize)).op == Op::Slot
                    && (*cx.insts.add(v as usize)).imm == s {
                    ir_replace(cx, v, r);
                }
                v = next;
            }
        }
        for i in 0..cx.candidates.len() as i64 {
            ir_unlink(cx, (cx.candidates[i as usize]));
        }
        cx.candidates.clear();
        resolve_all(cx, fi);
        true
    }
}

// Elides the copies of function fi that can be. Returns whether any was.
pub fn elide_copies(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        let nrvo = elide_result_copy(cx, fi, pcx);
        cx.candidates.clear();
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if is_copy(cx, v, pcx) {
                    let mut offset: i64 = 0;
                    let copy_dst_v = copy_dst(cx, v);
                    let d = slot_at(cx, copy_dst_v, &mut offset);
                    let copy_src_v = copy_src(cx, v);
                    let s = whole_slot(cx, copy_src_v);
                    let n = copy_size(cx, v);
                    if d >= 0 && s >= 0 && d != s && (*cx.slots.add(s as usize)).size == n
                        && offset >= 0 && offset + n <= (*cx.slots.add(d as usize)).size {
                        cx.candidates.push(v);
                    }
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        if cx.candidates.len() as i64 == 0 {
            return nrvo;
        }
        resolve_all(cx, fi);
        find_escaping_slots(cx, fi, pcx);
        analyze_loops(cx, fi);
        // The uses of the slots' addresses; the instructions numbered.
        cx.copies_uses.clear();
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut n: i64 = 0;
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                (*cx.insts.add(v as usize)).aux = n;
                n += 1;
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w == 0 {
                        continue;
                    }
                    let ir_val_v = ir_val(cx, w);
                    let root = root_of(cx, ir_val_v);
                    if root != 0 && (*cx.insts.add(root as usize)).op == Op::Slot {
                        cx.copies_uses.push((*cx.insts.add(root as usize)).imm);
                        cx.copies_uses.push(v);
                    }
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        let mut changed = false;
        for i in 0..cx.candidates.len() as i64 {
            let c = (cx.candidates[i as usize]);
            let mut offset: i64 = 0;
            let copy_dst_v1 = copy_dst(cx, c);
            let d = slot_at(cx, copy_dst_v1, &mut offset);
            let copy_src_v1 = copy_src(cx, c);
            let s = whole_slot(cx, copy_src_v1);
            let b = (*cx.insts.add(c as usize)).block;
            if d < 0 || s < 0 || d == s || (*cx.slots.add(d as usize)).escapes != 0
                || (*cx.slots.add(s as usize)).escapes != 0
                || offset % (*cx.slots.add(s as usize)).align != 0
                || (*cx.blocks.add(b as usize)).order < 0
                || innermost_loop(cx, b) >= 0 && !is_move_copy(fi, c, pcx)
                || !elidable(cx, c, s, d, offset, pcx) {
                continue;
            }
            place_slot(cx, fi, s, d, offset, pcx);
            ir_unlink(cx, c);
            changed = true;
        }
        if changed {
            resolve_all(cx, fi);
        }
        changed || nrvo
    }
}
