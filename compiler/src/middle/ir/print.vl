// Printing the IR as text (--print-ir, --print-after-all, the verifier's
// failures): values, instructions, blocks and whole functions.

use crate::arch::intrinsic_name;
use crate::arch::features::feature_name;
use crate::base::{buf_byte, buf_bytes, buf_hex, buf_int, buf_str, sym_name, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{buf_type, is_float};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, Term, get_irfuncs, ir_operand, ir_operand_count, ir_val};
use crate::middle::ir::Op::{
    Call, CallC, Cmp, Const, Conv, Copy, FAddr, GAddr, Load, Param, Piece, SAddr, Select, Store,
    Test, VBin, VCmp, VExt, VIns,
};
use crate::middle::ir::atomic::{kind_name, order_name};
use crate::middle::ir::cfg::{case_target, case_value};
use crate::middle::parallel::const_data_id;

pub fn buf_value(out: i64, v: i64) {
    if v == 0 {
        buf_str(out, c"_");
        return;
    }
    buf_byte(out, b'v');
    buf_int(out, v);
}

fn buf_ir_type(out: i64, t: i64, pcx: &Ctx<Comp>) {
    if t == 0 {
        buf_str(out, c"void");
    } else {
        buf_type(out, t, pcx);
    }
}

fn print_inst(cx: &mut FnCtx<Comp>, out: i64, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        buf_str(out, c"    ");
        if (*cx.insts.add(v as usize)).ty != 0 {
            buf_value(out, v);
            buf_str(out, c": ");
            buf_ir_type(out, (*cx.insts.add(v as usize)).ty, pcx);
            buf_str(out, c" = ");
        }
        buf_str(out, op.name());
        if op == Cmp || op == Test || op == Select || op == VCmp {
            buf_byte(out, b'.');
            buf_str(out, (*cx.insts.add(v as usize)).cond.name());
        }
        if op == Op::Bits {
            buf_str(out,
                if (*cx.insts.add(v as usize)).imm == 0 { c".ones" }
                else if (*cx.insts.add(v as usize)).imm == 1 { c".leading" } else { c".trailing" });
        }
        if op == Op::Intr || op == Op::IntrMem {
            // (0.19) `intr.vqsubq_u8`
            buf_byte(out, b'.');
            buf_bytes(out, sym_text(intrinsic_name((*cx.insts.add(v as usize)).imm, pcx), pcx));
        }
        if op == Op::CpuFeat {
            buf_byte(out, b' ');
            buf_bytes(out, feature_name((*cx.insts.add(v as usize)).imm));
        }
        if op == Op::VConst || op == Op::Hint {
            buf_byte(out, b' ');
            buf_int(out, (*cx.insts.add(v as usize)).imm);
        }
        if op == Op::Atomic {
            buf_byte(out, b'.');
            buf_str(out, kind_name((*cx.insts.add(v as usize)).imm & 255));
            buf_byte(out, b'.');
            buf_str(out, order_name(((*cx.insts.add(v as usize)).imm >> 8) & 15));
        }
        if op == Op::Fence {
            buf_byte(out, b'.');
            buf_str(out, order_name((*cx.insts.add(v as usize)).imm & 15));
            if ((*cx.insts.add(v as usize)).imm & 256) != 0 {
                buf_str(out, c".compiler");
            }
        }
        if op == VBin {
            buf_byte(out, b'.');
            let raw = (*cx.insts.add(v as usize)).imm;
            let bop = raw as Op;
            buf_str(out, bop.name());
        }
        if op == Const {
            buf_byte(out, b' ');
            if is_float((*cx.insts.add(v as usize)).ty) {
                buf_str(out, c"0x");
                buf_hex(out, (*cx.insts.add(v as usize)).imm as u64, 16);
            } else {
                buf_int(out, (*cx.insts.add(v as usize)).imm);
            }
        } else if op == GAddr || op == CallC {
            buf_byte(out, b' ');
            buf_str(out, sym_name((*cx.insts.add(v as usize)).imm, pcx));
        } else if op == Call || op == FAddr {
            buf_byte(out, b' ');
            buf_str(out, sym_name(pcx.fns[(*cx.insts.add(v as usize)).imm as usize].name, pcx));
        } else if op == SAddr {
            buf_byte(out, b' ');
            buf_int(out, const_data_id((*cx.insts.add(v as usize)).imm));
        } else if op == Param || op == Op::Slot || op == Piece {
            buf_byte(out, b' ');
            buf_int(out, (*cx.insts.add(v as usize)).imm);
        }
        let mut first = true;
        for i in 0..ir_operand_count(cx, v) {
            let operand = ir_operand(cx, v, i);
            if operand == 0 && i < 3 {
                continue;
            }
            buf_str(out, if first { c" " } else { c", " });
            first = false;
            buf_value(out, ir_val(cx, operand));
        }
        if op == Load || op == Store {
            if (*cx.insts.add(v as usize)).imm != 0 {
                buf_str(out, c" +");
                buf_int(out, (*cx.insts.add(v as usize)).imm);
            }
            if op == Store {
                buf_byte(out, b' ');
                buf_ir_type(out, (*cx.insts.add(v as usize)).imm2, pcx);
            }
        } else if op == Copy {
            buf_str(out, c" size ");
            buf_int(out, (*cx.insts.add(v as usize)).imm);
        } else if op == Conv || op == Cmp || op == VCmp {
            buf_str(out, c" from ");
            buf_ir_type(out, (*cx.insts.add(v as usize)).imm2, pcx);
        } else if op == VExt || op == VIns {
            buf_str(out, c" lane ");
            buf_int(out, (*cx.insts.add(v as usize)).imm);
        } else if op.is_machine() {
            // imm, imm2 and scale as they are (see isel.vl).
            buf_str(out, c" [");
            buf_int(out, (*cx.insts.add(v as usize)).imm);
            buf_str(out, c", ");
            buf_int(out, (*cx.insts.add(v as usize)).imm2);
            buf_str(out, c", ");
            buf_int(out, (*cx.insts.add(v as usize)).scale);
            buf_byte(out, b']');
        }
        buf_byte(out, b'\n');
    }
}

pub fn buf_block(out: i64, b: i64) {
    buf_byte(out, b'b');
    buf_int(out, b);
}

fn print_block(cx: &mut FnCtx<Comp>, out: i64, b: i64, pcx: &Ctx<Comp>) {
    unsafe {
        buf_block(out, b);
        if (*cx.blocks.add(b as usize)).preds.len() as i64 > 0 {
            buf_str(out, c" <-");
            for i in 0..(*cx.blocks.add(b as usize)).preds.len() as i64 {
                buf_byte(out, b' ');
                buf_block(out, ((*cx.blocks.add(b as usize)).preds[i as usize]));
            }
        }
        buf_str(out, c":\n");
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            print_inst(cx, out, v, pcx);
            v = (*cx.insts.add(v as usize)).next;
        }
        let term = (*cx.blocks.add(b as usize)).term;
        buf_str(out, c"    ");
        if term == Term::Jump {
            buf_str(out, c"jump ");
            buf_block(out, (*cx.blocks.add(b as usize)).s0);
        } else if term == Term::Branch {
            buf_str(out, c"branch ");
            buf_value(out, ir_val(cx, (*cx.blocks.add(b as usize)).cond));
            buf_str(out, c", ");
            buf_block(out, (*cx.blocks.add(b as usize)).s0);
            buf_str(out, c", ");
            buf_block(out, (*cx.blocks.add(b as usize)).s1);
        } else if term == Term::Ret {
            buf_str(out, c"ret");
            if (*cx.blocks.add(b as usize)).cond != 0 {
                buf_byte(out, b' ');
                buf_value(out, ir_val(cx, (*cx.blocks.add(b as usize)).cond));
            }
        } else if term == Term::Unreach {
            buf_str(out, c"unreachable");
        } else if term == Term::Switch {
            buf_str(out, c"switch ");
            buf_value(out, ir_val(cx, (*cx.blocks.add(b as usize)).cond));
            buf_str(out, c", default ");
            buf_block(out, (*cx.blocks.add(b as usize)).s0);
            for i in 0..(*cx.blocks.add(b as usize)).ncases {
                buf_str(out, c", ");
                buf_int(out, case_value(cx, b, i));
                buf_str(out, c" -> ");
                buf_block(out, case_target(cx, b, i));
            }
        } else {
            buf_str(out, c"(no terminator)");
        }
        buf_byte(out, b'\n');
    }
}

pub fn print_ir_func(cx: &mut FnCtx<Comp>, out: i64, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        buf_str(out, c"fn ");
        buf_str(out, sym_name(pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].name, pcx));
        buf_str(out, c":\n");
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed == 0 {
                print_block(cx, out, b, pcx);
            }
        }
        buf_byte(out, b'\n');
    }
}
