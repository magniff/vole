// The middle-end IR (used from -O1 on): every function is a control flow
// graph of basic blocks; instructions compute typed scalar values in SSA
// form; memory is explicit (loads, stores and copies through addresses).
//
// A value is the id of the instruction that defines it (an index in
// INSTS; 0 is "no value"). Types are the checker's scalar types: the
// integers, f32, f64 and bool; pointers, function values and the
// addresses of compound values (structs, tuples, arrays) are TY_U64.
// Integer values are kept canonical, as in the 0.1 code generator: sign-
// or zero-extended to 64 bits, so every operation is a 64-bit operation
// followed by a normalization to the result type.
//
// Instructions (operands a, b, c are values; imm and imm2 immediates):
//   CONST   imm = the value (a float as the bits of an f64, rounded to f32
//           first for f32, as in consteval.vl)
//   PARAM   imm = the index of the parameter (-1: the result pointer of a
//           function returning a compound value)
//   SLOT    imm = a frame slot (SLOTS): its address
//   GADDR   imm = the name of a static: its address
//   SADDR   imm = a string literal: its address
//   FADDR   imm = a function (FNS): its address
//   PHI     one operand per predecessor of its block, in order (ARGS)
//   ADD SUB MUL DIV REM AND OR XOR SHL SHR   a <op> b, of type ty (floats
//           for ADD..DIV; SHL/SHR: a of type ty, b any integer)
//   NEG     -a;  NOT  !a (a bool);  BNOT  ~a
//   CMP     a <cond> b, operands of type imm2;
//           the result is a bool
//   CONV    a converted from type imm2 to ty
//   LOAD    the value of type ty at a + imm
//   STORE   stores b (of type imm2) at a + imm
//   COPY    copies imm bytes from b to a (small sizes; larger copies are
//           calls to memcpy)
//   CALL    calls function imm (FNS) with the operands in ARGS
//   CALLI   calls the function value a, of function type imm
//   CALLC   calls the C library function named by symbol imm
//           For calls: ty is the result type (0: none); c is the result
//           pointer for a compound result; ARGTY holds the type of each
//           argument as the callee sees it (negated for the `...` of a
//           variadic function: an aggregate passed in pieces there has its
//           negated type on the first, VARIADIC_PIECE on the others).
//   Vectors (0.10; ty or imm2 a vector type, a value of 16 bytes in a
//   float register; LOAD and STORE move them too):
//   VBIN    a <imm> b lanewise, imm = ADD SUB MUL DIV (floats) AND OR XOR
//   VCMP    a <cond> b lanewise, operands of vector type imm2; ty is the
//           mask type (each lane -1 or 0)
//   VSPLAT  every lane = a;  VNEG  -a lanewise
//   VEXT    lane imm of a (ty: the lane type, canonical)
//   VINS    a with lane imm = b
//   VSUM    the sum of a's lanes (floats: pairwise)
//   VSEL    (b & a) | (c & ~a) on the bits: a is a mask, b and c of type ty
//   SEL     a ? b : c (0.15): a a bool, b and c of the integer type ty
//
// Block terminators: JUMP s0; BRANCH cond ? s0 : s1; RET cond (0: no
// value; for an aggregate returned in registers, its address); UNREACH;
// SWITCH on the integer cond: its cases (value, block) are pairs in
// SWCASES (`cases`, `ncases` pairs), s0 is the default; its distinct
// successors (the default first) are listed in SWCASES at `succs`
// (`nsucc` of them), and each has the block once among its predecessors.
// Instructions of a block form a doubly linked list (phis first).

use std::sync::atomic::Atomic; pub mod cfg;
pub mod print;
pub mod verify;
pub mod atomic;

// (The numbering is the 0.3 one: GVN hashes the opcode.)
use std::alloc::Allocator;
use std::sync::{RwLock, RwLockReadGuard};

use crate::back::codecache::{R_IR, cc_note};
use crate::base::{die, sized_table};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::Tok;
use crate::front::types::{
    TY_BOOL, TY_U64, is_fieldless_enum, is_float, is_integer, is_vector, is_void, machine_int,
    scalar_type,
};
use crate::middle::ctx::FnCtx;

use Op::{
    Add, And, BNot, Call, CallC, CallI, Cmp, Const, Conv, Copy, Div, FAddr, FMath, GAddr, Lea, Load,
    LoadX, MAdd, MSub, Mul, MulH, Neg, Not, Or, Pack, Param, Phi, Piece, Rem, SAddr, Select, ShOp,
    Shl, Shr, Store, StoreX, Sub, Test, Ubfx, VBin, VCmp, VExt, VIns, VNeg, VSel, VSplat, VSum, Xor,
};

#[derive(Clone, Copy, PartialEq, Eq)] pub enum Op {
    None = 0,
    Const = 1, Param = 2, Slot = 3, GAddr = 4, SAddr = 5, FAddr = 6, Phi = 7,
    Add = 10, Sub = 11, Mul = 12, Div = 13, Rem = 14, And = 15, Or = 16, Xor = 17,
    Shl = 18, Shr = 19,
    Neg = 20, Not = 21, BNot = 22, Cmp = 23, Conv = 24,
    Load = 25, Store = 26, Copy = 27, Call = 28, CallI = 29, CallC = 30,
    // An aggregate result in registers (0.5): PIECE k of call `a` (defined
    // by the call, in the block after it); PACK, the operand of a RET, the
    // pieces returned (its operands).
    Piece = 31, Pack = 32,
    // Machine operations, made by instruction selection (isel.vl)
    // just before register allocation; nothing else sees them.
    LoadX = 33, StoreX = 34, Lea = 35, MAdd = 36, MSub = 37, ShOp = 38, Ubfx = 39,
    Test = 40, Select = 41, FMath = 42,
    // Vectors (0.10), not machine operations.
    VBin = 43, VCmp = 44, VSplat = 45, VExt = 46, VIns = 47, VSum = 48, VNeg = 49, VSel = 50,
    // (0.11) A machine operation of instruction selection: the high 64 bits
    // of the 128-bit product of a and b (signed when imm is 1), for
    // divisions by constants.
    MulH = 51,
    // (0.15) SEL: a ? b : c, a a bool, b and c integers of type ty (made
    // by if-conversion in loops, ifconv.vl; isel.vl makes it a SELECT).
    Sel = 52,
    // (0.16) Bit counts of a (a u64), an i64: imm BITS_ONES the 1 bits,
    // BITS_LEADING the zeros above the highest 1, BITS_TRAILING those below
    // the lowest (64 for 0). std's count_ones, leading_zeros and
    // trailing_zeros on AArch64 (cnt, clz, rbit and clz); elsewhere the
    // calls stay (their bodies count by halves).
    Bits = 53,
    // (0.16) VMACW: a + b * c lanewise for a vector a of two u64 lanes, b
    // the two u32 of an 8-byte value (an f64 load of them: memory is read
    // by an ordinary load) widened, and c's lanes below 2^32 (the low 32
    // bits of its first lane are used for both). AArch64's umlal; made by
    // the vectorizer for `out[j] += k * (b[j] as u64)` (bigint kernels).
    VMacW = 54,
    // (0.18.1) RTID: a number only the run-time helper reads (a check's
    // site, or its kind past the fixed ones), the program's numbering of
    // which is made at the join, in the order of the code (code generation's
    // own). imm: (function << 20) | k, the function's k-th (FN_RTIDS): the
    // same in every build of the function, whatever was added elsewhere.
    RtId = 55,
    // (0.19, std::arch: docs/design/arch.md §5) INTR: intrinsic imm (its
    // table id, arch/mod.vl) on a, b, c (its register parameters, in
    // order), imm2 its immediates (16 bits each, in parameter order); pure,
    // its one instruction (the table's template). INTRMEM: the same reading
    // or writing memory: address a, the bytes it touches in aux. VCONST: a
    // constant vector, imm the index of its bytes in the program's pool.
    // CPUFEAT: whether the running CPU has feature imm (a bool; pure, the
    // value never changes in a run), expanded late into a load and a bit
    // test. HINT: a hint imm (prefetch, spin_loop) on a, kept but no write.
    Intr = 56, IntrMem = 57, VConst = 58, CpuFeat = 59, Hint = 60,
    // (0.26.2; 0.26.3: the overflow checks, decision 6) OVF: whether a <op> b
    // overflows its operands' type, a bool; imm = op | type << 8, op Add,
    // Sub, Mul or Neg (b 0). Pure; the wrapping operation is a separate
    // instruction on the same operands.
    Ovf = 61,
    // (0.21) Concurrency (ir/atomic.vl; docs/design/concurrency.md §4.1),
    // numbered apart from 0.19's operations. ATOMIC: an atomic access of
    // the ty-sized value at address a (b the value or the new one, c the
    // expected one of a CAS); imm = kind | order << 8; the result is the
    // old value (LOAD: the value; STORE: none). FENCE: imm = order |
    // FENCE_COMPILER. TLSADDR: the address of thread-local static imm in
    // the running thread.
    Atomic = 70, Fence = 71, TlsAddr = 72,
}

// The comparison of a CMP instruction (and of the -O0 code generator's
// compare-and-branch).
#[derive(Clone, Copy, PartialEq, Eq)] pub enum Cond { Eq, Ne, Lt, Le, Gt, Ge }

// Block terminators; None while a block is being built.
#[derive(Clone, Copy, PartialEq, Eq)] pub enum Term { None, Jump, Branch, Ret, Unreach, Switch }

pub const VARIADIC_PIECE: i64 = -1073741824;

// The counts of a BITS instruction (its imm).
pub const BITS_ONES: i64 = 0;
pub const BITS_LEADING: i64 = 1;
pub const BITS_TRAILING: i64 = 2;

// Copies up to this many bytes are inline loads and stores; larger ones
// call memcpy.
pub const INLINE_COPY_MAX: i64 = 128;

#[derive(Clone, Copy)] pub struct Inst {
    pub op: Op, pub cond: Cond, pub ty: i64,
    pub a: i64, pub b: i64, pub c: i64,
    pub imm: i64, pub imm2: i64,
    pub args: i64, pub nargs: i64,
    pub block: i64, pub prev: i64, pub next: i64,
    // The value this one was replaced by (0: none); see ir_val.
    pub repl: i64,
    // Scratch fields for the passes.
    pub mark: i64, pub aux: i64,
    // Machine operations: the shift of an index (LOADX, STOREX, LEA), the
    // kind of comparison (SELECT: 0 compare, 1 test).
    pub scale: i64,
}

pub struct Block<A: Allocator> {
    pub first: i64, pub last: i64,
    pub preds: Vec<i64, A>,
    pub term: Term, pub cond: i64, pub s0: i64, pub s1: i64,
    // SSA construction: whether every predecessor is known, and the
    // incomplete phis (see lower.vl).
    pub sealed: i64, pub incomplete: i64,
    pub func: i64, pub removed: i64,
    // Scratch fields for the passes and the back end.
    pub order: i64, pub idom: i64, pub mark: i64, pub aux: i64, pub loop_depth: i64,
    // The header of a loop the vectorizer made a scalar remainder of (or
    // one copied from such): not vectorized again (0.10).
    pub novec: i64,
    // How often the block ran in the profile (--profile-use, 0.10; see
    // profile.vl), or -1.
    pub count: i64,
    // SWITCH terminators.
    pub cases: i64, pub ncases: i64, pub succs: i64, pub nsucc: i64,
}

// (0.29) A function's IR while it is not the current one of a context:
// the program's table of them is the compilation context's (Ctx.irfuncs,
// one entry per IR function, made by ir_new_func on the main thread; the
// FNS entry and the item of each are Ctx.ir_fn and Ctx.ir_item, which
// never change). A function is worked on by one context at a time:
// ir_enter exchanges the entry's parts with the context's (cx.insts,
// cx.blocks, ..., cx.fn_blocks, cx.fn_slots, cx.fn_entry,
// cx.fn_result_ptr), which hold nothing while no function is current, and
// ir_release exchanges them back; `lent` says which side has them.
pub struct IRFunc<A: Allocator> {
    pub entry: i64,
    // Its blocks and frame slots, in the order they were made.
    pub blocks: Vec<i64, A>,
    pub slots: Vec<i64, A>,
    // The PARAM holding the result pointer (functions returning a compound
    // value), or 0.
    pub result_ptr: i64,
    pub t: IRTables<A>,
    // Whether a context has the function current: the parts above are the
    // context's then, and the entry's are empty.
    pub lent: bool,
}

// (0.17) The IR tables of one function: its instructions, blocks, frame
// slots, operand lists, switch cases and (-g) source positions. Ids are
// local to the function (0 is "none" in each table), so a function's IR
// can be built, optimized, emitted and freed on its own, and, from 0.18,
// on a thread of its own. The current function's tables are the context's
// insts, blocks, slots, args, argty, swcases and inst_loc, where every
// pass reads them; ir_enter switches to another function's, and the
// inliner reads a callee's through ir_view.
pub struct IRTables<A: Allocator> {
    pub insts: Vec<Inst, A>,
    pub blocks: Vec<Block<A>, A>,
    pub slots: Vec<Slot, A>,
    pub args: Vec<i64, A>, pub argty: Vec<i64, A>, pub swcases: Vec<i64, A>,
    pub inst_loc: Vec<i64, A>,
}

// A frame slot: memory in the function's frame; `ty` is the checker type
// of the value it holds (0 when unknown), for scalar replacement.
#[derive(Clone, Copy)] pub struct Slot {
    pub size: i64, pub align: i64, pub offset: i64, pub escapes: i64, pub ty: i64,
}

pub fn init_ir(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    cx.ir_cur = -1;
    sized_table(&mut pcx.fn_ir, pcx.fns.len() as i64 + 1, 0);
}

// (0.17) Makes function fi's tables the current ones (cx.insts,
// cx.blocks, ...), and fi the function being built (cx.irf).
pub fn ir_enter(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    if cx.ir_cur != fi {
        // (0.18.1: another function's IR, read by a task: for the code
        // cache, back::codecache)
        cc_note(cx, R_IR, fi, pcx);
        ir_release(cx, pcx);
        ir_exchange(cx, fi, true, pcx);
        cx.ir_cur = fi;
        cx.fn_f = pcx.ir_fn[fi as usize];
        cx.fn_item = pcx.ir_item[fi as usize];
    }
    cx.irf = fi;
}

// (0.29) Function fi's parts and the context's change places: into the
// context (`lend`) when it becomes current there, back when it is
// released. Each side's parts are whole Vecs, so nothing is copied and
// nothing is freed. The entry is written with its lock held: the tasks of
// a phase share the compilation context, and each enters only functions
// of its own (middle::parallel's task lists), so the lock is free; were
// the plan broken, a second context would wait here, find the function
// lent, and stop the compiler.
fn ir_exchange(cx: &mut FnCtx<Comp>, fi: i64, lend: bool, pcx: &Ctx<Comp>) {
    let mut home = pcx.irfuncs[fi as usize].write().unwrap();
    if home.lent == lend {
        die(c"internal error: a function's IR is entered twice, or released when not entered");
    }
    home.lent = lend;
    std::mem::swap(&mut cx.insts, &mut home.t.insts);
    std::mem::swap(&mut cx.blocks, &mut home.t.blocks);
    std::mem::swap(&mut cx.slots, &mut home.t.slots);
    std::mem::swap(&mut cx.args, &mut home.t.args);
    std::mem::swap(&mut cx.argty, &mut home.t.argty);
    std::mem::swap(&mut cx.swcases, &mut home.t.swcases);
    std::mem::swap(&mut cx.inst_loc, &mut home.t.inst_loc);
    std::mem::swap(&mut cx.fn_blocks, &mut home.blocks);
    std::mem::swap(&mut cx.fn_slots, &mut home.slots);
    std::mem::swap(&mut cx.fn_entry, &mut home.entry);
    std::mem::swap(&mut cx.fn_result_ptr, &mut home.result_ptr);
}

// (0.29) Function g's stored IR, to read while the guard lives: g is not
// current in any context (the compiler stops otherwise: its parts would
// be the context's). Several tasks may read one function at once (the
// inliner's copies of a callee); none enters it meanwhile: (a) -O2's
// inline_call comes after should_inline's fn_facts_ready(g), i.e. g's
// component is of a lower level, finished in an earlier pool_run and not
// entered since; (b) -O1's inline_leaf_calls reads a small leaf, and
// every small leaf is emitted in emit_functions' second range, which
// starts after the first range's pool_run_joined returned; (c) the main
// thread reads between phases, when every task's context has released
// its function. The lock holds whatever the plan: a context that entered
// g meanwhile would wait for the readers.
pub fn ir_stored(g: i64, pcx: &Ctx<Comp>) -> RwLockReadGuard<'_, IRFunc<Comp>> {
    let home = pcx.irfuncs[g as usize].read().unwrap();
    if home.lent {
        die(c"internal error: the IR of a function that is current in a context is read from the table");
    }
    home
}

fn not_current(cx: &FnCtx<Comp>, fi: i64) {
    if fi != cx.ir_cur {
        die(c"internal error: the IR of a function that is not the current one is used as the current one's");
    }
}

// (0.29) The current function's blocks, frame slots, entry block and
// result pointer (the context's while it is current: ir_enter); fi names
// it, and is checked.
pub fn fn_block_count(cx: &FnCtx<Comp>, fi: i64) -> i64 {
    not_current(cx, fi);
    cx.fn_blocks.len() as i64
}

pub fn fn_block(cx: &FnCtx<Comp>, fi: i64, i: i64) -> i64 {
    not_current(cx, fi);
    cx.fn_blocks[i as usize]
}

pub fn fn_slot_count(cx: &FnCtx<Comp>, fi: i64) -> i64 {
    not_current(cx, fi);
    cx.fn_slots.len() as i64
}

pub fn fn_slot(cx: &FnCtx<Comp>, fi: i64, i: i64) -> i64 {
    not_current(cx, fi);
    cx.fn_slots[i as usize]
}

pub fn fn_entry(cx: &FnCtx<Comp>, fi: i64) -> i64 {
    not_current(cx, fi);
    cx.fn_entry
}

pub fn fn_result_ptr(cx: &FnCtx<Comp>, fi: i64) -> i64 {
    not_current(cx, fi);
    cx.fn_result_ptr
}

// (0.17) Gives back the room a table has beyond what it uses, when the
// room left is worth it (never all of it: an empty table keeps one entry).
fn shrink_table<T>(v: &mut Vec<T, Comp>) {
    let n = v.len();
    if v.capacity() > n + n / 4 + 4 {
        v.shrink_to(if n < 1 { 1 } else { n });
    }
}

// (0.17) Gives back the room the current function's tables have beyond
// what it uses (each table starts at 64 entries and doubles; a block's
// predecessor list too): after the function is lowered, and at -O2 once
// its component is optimized, the IR kept for later is its size.
pub fn ir_shrink(cx: &mut FnCtx<Comp>) {
    shrink_table(&mut cx.insts);
    shrink_table(&mut cx.blocks);
    shrink_table(&mut cx.slots);
    shrink_table(&mut cx.args);
    shrink_table(&mut cx.argty);
    shrink_table(&mut cx.swcases);
    shrink_table(&mut cx.inst_loc);
    for b in 0..cx.blocks.len() {
        shrink_table(&mut cx.blocks[b].preds);
    }
    if cx.fn_blocks.capacity() > 0 {
        shrink_table(&mut cx.fn_blocks);
    }
    if cx.fn_slots.capacity() > 0 {
        shrink_table(&mut cx.fn_slots);
    }
}

// The room one function's tables take, in bytes.
fn tables_bytes(insts: &Vec<Inst, Comp>, blocks: &Vec<Block<Comp>, Comp>, slots: &Vec<Slot, Comp>,
    lists: i64) -> i64 {
    let mut total = insts.capacity() as i64 * size_of(Inst)
        + blocks.capacity() as i64 * size_of(Block<Comp>)
        + slots.capacity() as i64 * size_of(Slot) + lists * 8;
    for b in blocks.iter() {
        total += b.preds.capacity() as i64 * 8;
    }
    total
}

// (0.17) The room the IR's tables take (every function's, in bytes): for
// --time-passes.
pub fn ir_tables_bytes(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    ir_release(cx, pcx);
    let mut total: i64 = 0;
    for fi in 0..pcx.irfunc_count {
        let h = ir_stored(fi, pcx);
        total += tables_bytes(&h.t.insts, &h.t.blocks, &h.t.slots,
            (h.t.args.capacity() + h.t.argty.capacity() + h.t.swcases.capacity()
                + h.t.inst_loc.capacity() + h.blocks.capacity() + h.slots.capacity()) as i64);
    }
    total
}

// (0.18.1) The current function's tables back into its IRFunc, and none
// current: what a task does when it ends (middle::parallel), and the main
// thread before a phase, so that no context keeps a function another is
// to enter.
pub fn ir_release(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if cx.ir_cur >= 0 {
        ir_exchange(cx, cx.ir_cur, false, pcx);
        cx.ir_cur = -1;
    }
}

// (0.27.7) The marks of function fi's instructions and blocks, zeroed as
// a task on it begins (fi is current in no context: it is entered for
// this and released, without the code cache's note of a read). Passes
// compare marks with their context's stamps (tags_stamp, capture_stamp,
// sim_stamp, vstamp), which every context counts from the same base: a
// mark left by the function's task in another context, or installed by
// the code cache from another run, could equal this context's next stamp,
// and the code made would depend on which thread ran what before. (A
// pass's aux is read only where its mark is the pass's stamp.)
pub fn ir_clear_marks(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    ir_release(cx, pcx);
    ir_exchange(cx, fi, true, pcx);
    for v in cx.insts.iter_mut() {
        v.mark = 0;
    }
    for b in cx.blocks.iter_mut() {
        b.mark = 0;
    }
    ir_exchange(cx, fi, false, pcx);
}

// (0.17) Frees function fi's IR (once it is emitted, or dropped); fi is
// not current afterwards.
pub fn ir_free_func(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    ir_enter(cx, fi, pcx);
    cx.fn_blocks = Vec::new_in(Comp {});
    cx.fn_slots = Vec::new_in(Comp {});
    cx.insts = Vec::new_in(Comp {});
    cx.blocks = Vec::new_in(Comp {});
    cx.slots = Vec::new_in(Comp {});
    cx.args = Vec::new_in(Comp {});
    cx.argty = Vec::new_in(Comp {});
    cx.swcases = Vec::new_in(Comp {});
    cx.inst_loc = Vec::new_in(Comp {});
    ir_release(cx, pcx);
}

fn empty_tables() -> IRTables<Comp> {
    IRTables {
        insts: Vec::new_in(Comp {}), blocks: Vec::new_in(Comp {}), slots: Vec::new_in(Comp {}),
        args: Vec::new_in(Comp {}), argty: Vec::new_in(Comp {}), swcases: Vec::new_in(Comp {}),
        inst_loc: Vec::new_in(Comp {}),
    }
}

fn empty_block(func: i64) -> Block<Comp> {
    Block {
        first: 0, last: 0, preds: Vec::new_in(Comp {}),
        term: Term::None, cond: 0, s0: 0, s1: 0, sealed: 0, incomplete: 0, func: func, removed: 0,
        order: 0, idom: 0, mark: 0, aux: 0, loop_depth: 0, novec: 0, count: -1,
        cases: 0, ncases: 0, succs: 0, nsucc: 0,
    }
}

// The IR type of a value of checker type `t` (0 for unit and `!`).
pub fn ir_type(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if is_void(t) {
        return 0;
    }
    if is_integer(t) {
        return machine_int(t);
    }
    if is_float(t) || t == TY_BOOL || is_vector(t, pcx) {
        return t;
    }
    if is_fieldless_enum(t, pcx) {
        return machine_int(scalar_type(t, pcx));
    }
    TY_U64
}

// ---- Functions, blocks and slots ----

// A new IR function for FNS entry f (its item: the Fn node), current from
// now on, with its tables' "none" entries (instruction, block and slot 0).
pub fn ir_new_func(cx: &mut FnCtx<Comp>, f: i64, item: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let id = pcx.irfunc_count;
    pcx.ir_fn.push(f);
    pcx.ir_item.push(item);
    pcx.irfuncs.push(RwLock::new(IRFunc {
        entry: 0, blocks: Vec::new_in(Comp {}), slots: Vec::new_in(Comp {}), result_ptr: 0,
        t: empty_tables(), lent: false,
    }));
    pcx.irfunc_count += 1;
    (pcx.fn_ir[f as usize]) = id + 1;
    ir_enter(cx, id, pcx);
    cx.insts.push(Inst {
        op: Op::None, cond: Cond::Eq, ty: 0, a: 0, b: 0, c: 0, imm: 0, imm2: 0, args: 0,
        nargs: 0,
        block: 0, prev: 0, next: 0, repl: 0, mark: 0, aux: 0, scale: 0,
    });
    if pcx.ir_locs {
        cx.inst_loc.push(0);
    }
    cx.blocks.push(empty_block(0));
    cx.slots.push(Slot { size: 0, align: 1, offset: 0, escapes: 0, ty: 0 });
    cx.args.push(0);
    cx.argty.push(0);
    id
}

pub fn ir_new_block(cx: &mut FnCtx<Comp>) -> i64 {
    unsafe {
        let b = cx.blocks.len() as i64;
        let block = empty_block(cx.irf);
        cx.blocks.push(block);
        not_current(cx, cx.irf);
        cx.fn_blocks.push(b);
        b
    }
}

pub fn ir_new_slot(cx: &mut FnCtx<Comp>, size: i64, align: i64) -> i64 {
    unsafe {
        let s = cx.slots.len() as i64;
        let mut a = align;
        if a < 1 {
            a = 1;
        }
        cx.slots.push(Slot { size: size, align: a, offset: 0, escapes: 0, ty: 0 });
        not_current(cx, cx.irf);
        cx.fn_slots.push(s);
        s
    }
}

// ---- Instructions ----

// A new instruction, not yet in a block.
pub fn ir_make(cx: &mut FnCtx<Comp>, op: Op, ty: i64, a: i64, b: i64, imm: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = cx.insts.len() as i64;
    cx.insts.push(Inst {
        op: op, cond: Cond::Eq, ty: ty, a: a, b: b, c: 0, imm: imm, imm2: 0, args: 0, nargs: 0,
        block: 0, prev: 0, next: 0, repl: 0, mark: 0, aux: 0, scale: 0,
    });
    if pcx.ir_locs {
        let fine = pcx.ir_call_locs && pcx.ir_expr_loc > 0 && op.is_call();
        cx.inst_loc.push(if fine { pcx.ir_expr_loc } else { pcx.ir_loc });
    }
    v
}

// Appends instruction `v` to block `b`.
pub fn ir_append(cx: &mut FnCtx<Comp>, b: i64, v: i64) {
    let last = (cx.blocks[b as usize]).last;
    (cx.insts[v as usize]).block = b;
    (cx.insts[v as usize]).prev = last;
    (cx.insts[v as usize]).next = 0;
    if last == 0 {
        (cx.blocks[b as usize]).first = v;
    } else {
        (cx.insts[last as usize]).next = v;
    }
    (cx.blocks[b as usize]).last = v;
}

// Inserts instruction `v` at the start of block `b`.
pub fn ir_prepend(cx: &mut FnCtx<Comp>, b: i64, v: i64) {
    let first = (cx.blocks[b as usize]).first;
    (cx.insts[v as usize]).block = b;
    (cx.insts[v as usize]).prev = 0;
    (cx.insts[v as usize]).next = first;
    if first == 0 {
        (cx.blocks[b as usize]).last = v;
    } else {
        (cx.insts[first as usize]).prev = v;
    }
    (cx.blocks[b as usize]).first = v;
}

// Inserts instruction `v` before instruction `at` (in the same block).
pub fn ir_insert_before(cx: &mut FnCtx<Comp>, at: i64, v: i64) {
    let b = (cx.insts[at as usize]).block;
    let prev = (cx.insts[at as usize]).prev;
    (cx.insts[v as usize]).block = b;
    (cx.insts[v as usize]).prev = prev;
    (cx.insts[v as usize]).next = at;
    (cx.insts[at as usize]).prev = v;
    if prev == 0 {
        (cx.blocks[b as usize]).first = v;
    } else {
        (cx.insts[prev as usize]).next = v;
    }
}

// Removes instruction `v` from its block (it stays in INSTS).
pub fn ir_unlink(cx: &mut FnCtx<Comp>, v: i64) {
    let b = (cx.insts[v as usize]).block;
    let prev = (cx.insts[v as usize]).prev;
    let next = (cx.insts[v as usize]).next;
    if prev == 0 {
        (cx.blocks[b as usize]).first = next;
    } else {
        (cx.insts[prev as usize]).next = next;
    }
    if next == 0 {
        (cx.blocks[b as usize]).last = prev;
    } else {
        (cx.insts[next as usize]).prev = prev;
    }
    (cx.insts[v as usize]).block = 0;
    (cx.insts[v as usize]).prev = 0;
    (cx.insts[v as usize]).next = 0;
}

// The value `v` stands for now (following replacements). (0.29) Most
// values were never replaced: that is one read here, and the walk is a
// function of its own.
pub fn ir_val(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    if v == 0 || cx.insts[v as usize].repl == 0 {
        return v;
    }
    ir_val_chain(cx, v)
}

// ir_val for a replaced value: the end of its chain of replacements,
// which every value on the chain then names directly.
fn ir_val_chain(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let mut r = v;
    while r != 0 && (cx.insts[r as usize]).repl != 0 {
        r = (cx.insts[r as usize]).repl;
    }
    // Path compression.
    let mut w = v;
    while w != 0 && (cx.insts[w as usize]).repl != 0
        && (cx.insts[w as usize]).repl != r {
        let next = (cx.insts[w as usize]).repl;
        (cx.insts[w as usize]).repl = r;
        w = next;
    }
    r
}

// Replaces every use of `v` by `by` (and removes `v` from its block).
pub fn ir_replace(cx: &mut FnCtx<Comp>, v: i64, by: i64) {
    if v == by {
        return;
    }
    (cx.insts[v as usize]).repl = by;
    if (cx.insts[v as usize]).block != 0 {
        ir_unlink(cx, v);
    }
}

// Appends an instruction to the current block.
pub fn emit_ir(cx: &mut FnCtx<Comp>, op: Op, ty: i64, a: i64, b: i64, imm: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = ir_make(cx, op, ty, a, b, imm, pcx);
    ir_append(cx, pcx.ir_cur, v);
    v
}

pub fn ir_const(cx: &mut FnCtx<Comp>, value: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    emit_ir(cx, Const, ty, 0, 0, value, pcx)
}

pub fn ir_binary(cx: &mut FnCtx<Comp>, op: Op, ty: i64, a: i64, b: i64, pcx: &Ctx<Comp>) -> i64 {
    emit_ir(cx, op, ty, a, b, 0, pcx)
}

pub fn ir_cmp(cx: &mut FnCtx<Comp>, cond: Cond, operand_ty: i64, a: i64, b: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = emit_ir(cx, Cmp, TY_BOOL, a, b, 0, pcx);
    (cx.insts[v as usize]).cond = cond;
    (cx.insts[v as usize]).imm2 = operand_ty;
    v
}

pub fn ir_load(cx: &mut FnCtx<Comp>, ty: i64, addr: i64, offset: i64, pcx: &Ctx<Comp>) -> i64 {
    emit_ir(cx, Load, ty, addr, 0, offset, pcx)
}

pub fn ir_store(cx: &mut FnCtx<Comp>, ty: i64, addr: i64, value: i64, offset: i64, pcx: &Ctx<Comp>) {
    let v = emit_ir(cx, Store, 0, addr, value, offset, pcx);
    (cx.insts[v as usize]).imm2 = ty;
}

pub fn ir_slot_addr(cx: &mut FnCtx<Comp>, slot: i64, pcx: &Ctx<Comp>) -> i64 {
    emit_ir(cx, Op::Slot, TY_U64, 0, 0, slot, pcx)
}

// addr + offset (no instruction for 0).
pub fn ir_offset(cx: &mut FnCtx<Comp>, addr: i64, offset: i64, pcx: &Ctx<Comp>) -> i64 {
    if offset == 0 {
        return addr;
    }
    let ir_const_v = ir_const(cx, offset, TY_U64, pcx);
    ir_binary(cx, Add, TY_U64, addr, ir_const_v, pcx)
}

// (0.18.1) The classes of RTID values: a check's site, a check's kind.
pub const RT_SITE: i64 = 1;
pub const RT_KIND: i64 = 2;

// A value of class `class` and number `value` for the function being
// lowered (an RTID instruction of type ty).
pub fn ir_rtid(cx: &mut FnCtx<Comp>, class: i64, value: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let fi = cx.irf;
    while pcx.fn_rtids.len() as i64 <= fi {
        pcx.fn_rtids.push(Vec::new_in(Comp {}));
    }
    let tagged = (class << 56) | value;
    let list = &mut pcx.fn_rtids[fi as usize];
    let mut k: i64 = 0;
    while k < list.len() as i64 && list[k as usize] != tagged {
        k += 1;
    }
    if k == list.len() as i64 {
        list.push(tagged);
    }
    emit_ir(cx, Op::RtId, ty, 0, 0, (fi << 20) | k, pcx)
}

// The class and the front end's number of RTID imm `imm`.
pub fn rtid_class(imm: i64, pcx: &Ctx<Comp>) -> i64 {
    ((pcx.fn_rtids[(imm >> 20) as usize])[(imm & 1048575) as usize]) >> 56
}

pub fn rtid_value(imm: i64, pcx: &Ctx<Comp>) -> i64 {
    ((pcx.fn_rtids[(imm >> 20) as usize])[(imm & 1048575) as usize])
        & ((1 << 56) - 1)
}

impl Op {
    #[inline]
    pub fn is_call(self) -> bool {
        self == Call || self == CallI || self == CallC
    }

    // Whether an instruction may be removed when its value is unused (and
    // moved or merged with an equal one, for those that read no memory).
    pub fn has_side_effect(self) -> bool {
        self == Store || self == StoreX || self == Copy || self.is_call() || self == Param
            || self == Piece || self == Pack || self == Op::IntrMem || self == Op::Hint
            || self == Op::Atomic || self == Op::Fence
    }

    // Instructions whose value is recomputed at each use by the back end
    // instead of being kept in a register.
    pub fn is_remat(self) -> bool {
        self == Const || self == Op::Slot || self == GAddr || self == SAddr || self == FAddr
            || self == Op::RtId
    }

    // The operations computed from their operands alone (no memory, no
    // effects): arithmetic, comparisons, conversions.
    pub fn is_pure(self) -> bool {
        match self {
            Add | Sub | Mul | Div | Rem | And | Or | Xor
                | Shl | Shr | Neg | Not | BNot | Cmp | Conv | Op::Bits | Op::Ovf => true,
            _ => false,
        }
    }

    // The machine operations of instruction selection.
    fn is_machine(self) -> bool {
        (self as i64 >= LoadX as i64 && self as i64 <= FMath as i64) || self == MulH
    }

    // The vector operations (0.10): pure, computed from their operands
    // alone, never trapping. (0.19) Also the intrinsics' INTR, VCONST and
    // CPUFEAT, scalar ones included: GVN numbers them, LICM moves them, the
    // vectorizer leaves their loops alone (explicit SIMD), emission goes
    // through emit_vector. (Not is_pure: the scalar passes that evaluate or
    // speculate pure operations do not know them.)
    pub fn is_vector(self) -> bool {
        self as i64 >= VBin as i64 && self as i64 <= VSel as i64 || self == Op::VMacW
            || self == Op::Intr || self == Op::VConst || self == Op::CpuFeat
    }

    // The binary arithmetic and bitwise operations.
    pub fn is_binary(self) -> bool {
        match self {
            Add | Sub | Mul | Div | Rem | And | Or | Xor
                | Shl | Shr => true,
            _ => false,
        }
    }
}

// Operand list `args` of a phi or call.
pub fn ir_arg(cx: &FnCtx<Comp>, v: i64, i: i64) -> i64 {
    (cx.args[((cx.insts[v as usize]).args + i) as usize])
}

pub fn ir_set_arg(cx: &mut FnCtx<Comp>, v: i64, i: i64, value: i64) {
    (cx.args[((cx.insts[v as usize]).args + i) as usize]) = value;
}

// The operands of `v` are ir_operand(v, i) for i below ir_operand_count(v)
// (some may be 0): a, b, c, then the ARGS of phis and calls.
#[inline]
pub fn ir_operand_count(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let op = (cx.insts[v as usize]).op;
    if op == Phi || op.is_call() || op == Pack || op == Select {
        return (cx.insts[v as usize]).nargs + 3;
    }
    3
}

// Operand `i` of `v` (0 when there is none): a, b, c, then the ARGS.
#[inline]
pub fn ir_operand(cx: &FnCtx<Comp>, v: i64, i: i64) -> i64 {
    if i == 0 { return (cx.insts[v as usize]).a; }
    if i == 1 { return (cx.insts[v as usize]).b; }
    if i == 2 { return (cx.insts[v as usize]).c; }
    ir_arg(cx, v, i - 3)
}

pub fn ir_set_operand(cx: &mut FnCtx<Comp>, v: i64, i: i64, value: i64) {
    if i == 0 { (cx.insts[v as usize]).a = value; }
    else if i == 1 { (cx.insts[v as usize]).b = value; }
    else if i == 2 { (cx.insts[v as usize]).c = value; }
    else { ir_set_arg(cx, v, i - 3, value); }
}

// Resolves every operand of `v` (and of the block's terminator).
// (0.17: an operand not replaced is left as it is, without a write; the
// passes resolve every instruction of a function many times over)
pub fn ir_resolve_operands(cx: &mut FnCtx<Comp>, v: i64) {
    let a = (cx.insts[v as usize]).a;
    if a != 0 && (cx.insts[a as usize]).repl != 0 {
        (cx.insts[v as usize]).a = ir_val(cx, a);
    }
    let b = (cx.insts[v as usize]).b;
    if b != 0 && (cx.insts[b as usize]).repl != 0 {
        (cx.insts[v as usize]).b = ir_val(cx, b);
    }
    let c = (cx.insts[v as usize]).c;
    if c != 0 && (cx.insts[c as usize]).repl != 0 {
        (cx.insts[v as usize]).c = ir_val(cx, c);
    }
    let op = (cx.insts[v as usize]).op;
    if op == Phi || op.is_call() || op == Pack || op == Select {
        let base = (cx.insts[v as usize]).args;
        for i in 0..(cx.insts[v as usize]).nargs {
            let w = (cx.args[(base + i) as usize]);
            if w != 0 && (cx.insts[w as usize]).repl != 0 {
                (cx.args[(base + i) as usize]) = ir_val(cx, w);
            }
        }
    }
}

// ---- Printing (--emit ir) ----

impl Op {
    pub fn name(self) -> *mut u8 {
        match self {
            Op::None => c"none",
            Const => c"const",
            Param => c"param",
            Op::Slot => c"slot",
            GAddr => c"gaddr",
            SAddr => c"saddr",
            FAddr => c"faddr",
            Op::RtId => c"rtid",
            Phi => c"phi",
            Add => c"add",
            Sub => c"sub",
            Mul => c"mul",
            Div => c"div",
            Rem => c"rem",
            And => c"and",
            Or => c"or",
            Xor => c"xor",
            Shl => c"shl",
            Shr => c"shr",
            Neg => c"neg",
            Not => c"not",
            BNot => c"bnot",
            Cmp => c"cmp",
            Conv => c"conv",
            Load => c"load",
            Store => c"store",
            Copy => c"copy",
            Call => c"call",
            CallI => c"calli",
            CallC => c"callc",
            Piece => c"piece",
            Pack => c"pack",
            LoadX => c"loadx",
            StoreX => c"storex",
            Lea => c"lea",
            MAdd => c"madd",
            MSub => c"msub",
            ShOp => c"shop",
            Ubfx => c"ubfx",
            Test => c"test",
            Select => c"select",
            FMath => c"fmath",
            VBin => c"vbin",
            VCmp => c"vcmp",
            VSplat => c"vsplat",
            VExt => c"vext",
            VIns => c"vins",
            VSum => c"vsum",
            VNeg => c"vneg",
            VSel => c"vsel",
            MulH => c"mulh",
            Op::Sel => c"sel",
            Op::Bits => c"bits",
            Op::VMacW => c"vmacw",
            Op::Intr => c"intr",
            Op::IntrMem => c"intrmem",
            Op::VConst => c"vconst",
            Op::CpuFeat => c"cpufeat",
            Op::Hint => c"hint",
            Op::Ovf => c"ovf",
            Op::Atomic => c"atomic",
            Op::Fence => c"fence",
            Op::TlsAddr => c"tlsaddr",
        }
    }
}

impl Cond {
    pub fn name(self) -> *mut u8 {
        match self {
            Cond::Eq => c"eq",
            Cond::Ne => c"ne",
            Cond::Lt => c"lt",
            Cond::Le => c"le",
            Cond::Gt => c"gt",
            Cond::Ge => c"ge",
        }
    }

    // The opposite comparison: !(a < b) is a >= b (for integers).
    pub fn negate(self) -> Cond {
        match self {
            Cond::Eq => Cond::Ne,
            Cond::Ne => Cond::Eq,
            Cond::Lt => Cond::Ge,
            Cond::Ge => Cond::Lt,
            Cond::Gt => Cond::Le,
            Cond::Le => Cond::Gt,
        }
    }

    // The comparison with its operands swapped: a < b is b > a.
    pub fn mirror(self) -> Cond {
        match self {
            Cond::Lt => Cond::Gt,
            Cond::Gt => Cond::Lt,
            Cond::Le => Cond::Ge,
            Cond::Ge => Cond::Le,
            _ => self,
        }
    }
}

// The comparison a comparison operator stands for.
pub fn cond_of_token(op: Tok) -> Cond {
    match op {
        Tok::EqEq => Cond::Eq,
        Tok::BangEq => Cond::Ne,
        Tok::Lt => Cond::Lt,
        Tok::LtEq => Cond::Le,
        Tok::Gt => Cond::Gt,
        _ => Cond::Ge,
    }
}
