// Block terminators and the edges of the control flow graph: ending a
// block (jump, branch, return, switch), walking and redirecting its
// successors, the cases of a switch, and the index of a predecessor.

use crate::base::comp::Comp;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Term;

// ---- Terminators ----

// (0.26.1) A block's first predecessor makes its list with room for 4,
// not grow's 64: most blocks have one or two, and ir_shrink then leaves
// the list as it is instead of reallocating it.
fn ir_add_pred(cx: &mut FnCtx<Comp>, b: i64, pred: i64) {
    let preds = &mut cx.blocks[b as usize].preds;
    if preds.capacity() == 0 {
        preds.reserve_exact(4);
    }
    preds.push(pred);
}

// Ends block `b`.
pub fn ir_terminate(cx: &mut FnCtx<Comp>, b: i64, term: Term, cond: i64, s0: i64, s1: i64) {
    unsafe {
        (cx.blocks[b as usize]).term = term;
        (cx.blocks[b as usize]).cond = cond;
        (cx.blocks[b as usize]).s0 = s0;
        (cx.blocks[b as usize]).s1 = s1;
    }
    if s0 != 0 {
        ir_add_pred(cx, s0, b);
    }
    if s1 != 0 {
        ir_add_pred(cx, s1, b);
    }
}

pub fn succ_count(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    unsafe {
        let term = (cx.blocks[b as usize]).term;
        if term == Term::Jump { return 1; }
        if term == Term::Branch { return 2; }
        if term == Term::Switch { return (cx.blocks[b as usize]).nsucc; }
        0
    }
}

pub fn succ(cx: &mut FnCtx<Comp>, b: i64, i: i64) -> i64 {
    unsafe {
        if (cx.blocks[b as usize]).term == Term::Switch {
            return (cx.swcases[((cx.blocks[b as usize]).succs + i) as usize]);
        }
        if i == 0 { (cx.blocks[b as usize]).s0 } else { (cx.blocks[b as usize]).s1 }
    }
}

// Whether s is a successor of b.
pub fn is_succ(cx: &mut FnCtx<Comp>, b: i64, s: i64) -> bool {
    for i in 0..succ_count(cx, b) {
        if succ(cx, b, i) == s {
            return true;
        }
    }
    false
}

pub fn case_value(cx: &mut FnCtx<Comp>, b: i64, i: i64) -> i64 {
    unsafe { (cx.swcases[((cx.blocks[b as usize]).cases + 2 * i) as usize]) }
}

pub fn case_target(cx: &mut FnCtx<Comp>, b: i64, i: i64) -> i64 {
    unsafe { (cx.swcases[((cx.blocks[b as usize]).cases + 2 * i + 1) as usize]) }
}

// Ends block b with a switch on `value`: `count` cases as (value, block)
// pairs at SSA_STACK[mark..], popped, and the default block.
pub fn ir_switch(cx: &mut FnCtx<Comp>, b: i64, value: i64, default: i64, mark: i64) {
    ir_switch_no_preds(cx, b, value, default, mark);
    unsafe {
        for i in 0..(cx.blocks[b as usize]).nsucc {
            let succ_v = succ(cx, b, i);
            ir_add_pred(cx, succ_v, b);
        }
    }
}

// The same, without adding b to the predecessors of its successors.
pub fn ir_switch_no_preds(cx: &mut FnCtx<Comp>, b: i64, value: i64, default: i64, mark: i64) {
    unsafe {
        let count = (cx.ssa_stack.len() as i64 - mark) / 2;
        (cx.blocks[b as usize]).term = Term::Switch;
        (cx.blocks[b as usize]).cond = value;
        (cx.blocks[b as usize]).s0 = default;
        (cx.blocks[b as usize]).s1 = 0;
        (cx.blocks[b as usize]).cases = cx.swcases.len() as i64;
        (cx.blocks[b as usize]).ncases = count;
        for i in 0..2 * count {
            cx.swcases.push((cx.ssa_stack[(mark + i) as usize]));
        }
        cx.ssa_stack.truncate(mark as usize);
        switch_rebuild_succs(cx, b);
    }
}

// Rebuilds the list of distinct successors of switch b (the default
// first, then in case order).
pub fn switch_rebuild_succs(cx: &mut FnCtx<Comp>, b: i64) {
    unsafe {
        let start = cx.swcases.len() as i64;
        cx.swcases.push((cx.blocks[b as usize]).s0);
        for i in 0..(cx.blocks[b as usize]).ncases {
            let t = case_target(cx, b, i);
            let mut seen = false;
            for k in start..cx.swcases.len() as i64 {
                if (cx.swcases[k as usize]) == t {
                    seen = true;
                }
            }
            if !seen {
                cx.swcases.push(t);
            }
        }
        (cx.blocks[b as usize]).succs = start;
        (cx.blocks[b as usize]).nsucc = cx.swcases.len() as i64 - start;
    }
}

// The block switch b goes to for the constant `value`.
pub fn switch_target(cx: &mut FnCtx<Comp>, b: i64, value: i64) -> i64 {
    unsafe {
        for i in 0..(cx.blocks[b as usize]).ncases {
            if case_value(cx, b, i) == value {
                return case_target(cx, b, i);
            }
        }
        (cx.blocks[b as usize]).s0
    }
}

// Makes the edge from b to `from` go to `to` (the predecessor lists are
// the caller's business). A switch whose cases already reach `to` is not
// changed (that would make two edges into `to`): returns false.
pub fn redirect_succ(cx: &mut FnCtx<Comp>, b: i64, from: i64, to: i64) -> bool {
    unsafe {
        let term = (cx.blocks[b as usize]).term;
        if term == Term::Switch {
            if is_succ(cx, b, to) {
                return false;
            }
            let start = cx.swcases.len() as i64;
            for i in 0..(cx.blocks[b as usize]).ncases {
                let case_value_v = case_value(cx, b, i);
                cx.swcases.push(case_value_v);
                let t = case_target(cx, b, i);
                cx.swcases.push(if t == from { to } else { t });
            }
            (cx.blocks[b as usize]).cases = start;
            if (cx.blocks[b as usize]).s0 == from {
                (cx.blocks[b as usize]).s0 = to;
            }
            switch_rebuild_succs(cx, b);
            return true;
        }
        if (cx.blocks[b as usize]).s0 == from {
            (cx.blocks[b as usize]).s0 = to;
        }
        if term == Term::Branch && (cx.blocks[b as usize]).s1 == from {
            (cx.blocks[b as usize]).s1 = to;
        }
        true
    }
}

// Copies the terminator of block `from` to block `to` (successors as they
// are; the predecessor lists are the caller's business).
pub fn copy_terminator(cx: &mut FnCtx<Comp>, to: i64, from: i64) {
    unsafe {
        (cx.blocks[to as usize]).term = (cx.blocks[from as usize]).term;
        (cx.blocks[to as usize]).cond = (cx.blocks[from as usize]).cond;
        (cx.blocks[to as usize]).s0 = (cx.blocks[from as usize]).s0;
        (cx.blocks[to as usize]).s1 = (cx.blocks[from as usize]).s1;
        (cx.blocks[to as usize]).cases = (cx.blocks[from as usize]).cases;
        (cx.blocks[to as usize]).ncases = (cx.blocks[from as usize]).ncases;
        (cx.blocks[to as usize]).succs = (cx.blocks[from as usize]).succs;
        (cx.blocks[to as usize]).nsucc = (cx.blocks[from as usize]).nsucc;
    }
}

// The index of `pred` among the predecessors of `b`, or -1.
pub fn pred_index(cx: &mut FnCtx<Comp>, b: i64, pred: i64) -> i64 {
    let preds = cx.blocks[b as usize].preds.as_slice();
    for i in 0..preds.len() {
        if preds[i] == pred {
            return i as i64;
        }
    }
    -1
}
