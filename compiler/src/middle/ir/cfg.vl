// Block terminators and the edges of the control flow graph: ending a
// block (jump, branch, return, switch), walking and redirecting its
// successors, the cases of a switch, and the index of a predecessor.

use crate::middle::ctx::FnCtx;
use crate::middle::ir::Term;

// ---- Terminators ----

// (0.26.1) A block's first predecessor makes its list with room for 4,
// not grow's 64: most blocks have one or two, and ir_shrink then leaves
// the list as it is instead of reallocating it.
fn ir_add_pred(cx: &mut FnCtx, b: i64, pred: i64) {
    // UNSAFE: cx's block table is the IR's raw array, and a list's first room
    // is C memory, as base::grow's (which reallocates it past 4).
    // SAFETY: b is a block of the function (below block_count); a list of
    // capacity 0 holds nothing; the 4 words allocated are its capacity.
    unsafe {
        if (*cx.blocks.add(b as usize)).preds.cap == 0 {
            let p = crate::base::realloc((*cx.blocks.add(b as usize)).preds.data as *mut u8, 32);
            if p == 0 as *mut u8 {
                crate::base::die(c"out of memory");
            }
            (*cx.blocks.add(b as usize)).preds.data = p as *mut i64;
            (*cx.blocks.add(b as usize)).preds.cap = 4;
        }
        (*cx.blocks.add(b as usize)).preds.push(pred);
    }
}

// Ends block `b`.
pub fn ir_terminate(cx: &mut FnCtx, b: i64, term: Term, cond: i64, s0: i64, s1: i64) {
    unsafe {
        (*cx.blocks.add(b as usize)).term = term;
        (*cx.blocks.add(b as usize)).cond = cond;
        (*cx.blocks.add(b as usize)).s0 = s0;
        (*cx.blocks.add(b as usize)).s1 = s1;
    }
    if s0 != 0 {
        ir_add_pred(cx, s0, b);
    }
    if s1 != 0 {
        ir_add_pred(cx, s1, b);
    }
}

pub fn succ_count(cx: &mut FnCtx, b: i64) -> i64 {
    unsafe {
        let term = (*cx.blocks.add(b as usize)).term;
        if term == Term::Jump { return 1; }
        if term == Term::Branch { return 2; }
        if term == Term::Switch { return (*cx.blocks.add(b as usize)).nsucc; }
        0
    }
}

pub fn succ(cx: &mut FnCtx, b: i64, i: i64) -> i64 {
    unsafe {
        if (*cx.blocks.add(b as usize)).term == Term::Switch {
            return (*cx.swcases.data.add(((*cx.blocks.add(b as usize)).succs + i) as usize));
        }
        if i == 0 { (*cx.blocks.add(b as usize)).s0 } else { (*cx.blocks.add(b as usize)).s1 }
    }
}

// Whether s is a successor of b.
pub fn is_succ(cx: &mut FnCtx, b: i64, s: i64) -> bool {
    for i in 0..succ_count(cx, b) {
        if succ(cx, b, i) == s {
            return true;
        }
    }
    false
}

pub fn case_value(cx: &mut FnCtx, b: i64, i: i64) -> i64 {
    unsafe { (*cx.swcases.data.add(((*cx.blocks.add(b as usize)).cases + 2 * i) as usize)) }
}

pub fn case_target(cx: &mut FnCtx, b: i64, i: i64) -> i64 {
    unsafe { (*cx.swcases.data.add(((*cx.blocks.add(b as usize)).cases + 2 * i + 1) as usize)) }
}

// Ends block b with a switch on `value`: `count` cases as (value, block)
// pairs at SSA_STACK[mark..], popped, and the default block.
pub fn ir_switch(cx: &mut FnCtx, b: i64, value: i64, default: i64, mark: i64) {
    ir_switch_no_preds(cx, b, value, default, mark);
    unsafe {
        for i in 0..(*cx.blocks.add(b as usize)).nsucc {
            let succ_v = succ(cx, b, i);
            ir_add_pred(cx, succ_v, b);
        }
    }
}

// The same, without adding b to the predecessors of its successors.
pub fn ir_switch_no_preds(cx: &mut FnCtx, b: i64, value: i64, default: i64, mark: i64) {
    unsafe {
        let count = (cx.ssa_stack.count - mark) / 2;
        (*cx.blocks.add(b as usize)).term = Term::Switch;
        (*cx.blocks.add(b as usize)).cond = value;
        (*cx.blocks.add(b as usize)).s0 = default;
        (*cx.blocks.add(b as usize)).s1 = 0;
        (*cx.blocks.add(b as usize)).cases = cx.swcases.count;
        (*cx.blocks.add(b as usize)).ncases = count;
        for i in 0..2 * count {
            cx.swcases.push((*cx.ssa_stack.data.add((mark + i) as usize)));
        }
        cx.ssa_stack.count = mark;
        switch_rebuild_succs(cx, b);
    }
}

// Rebuilds the list of distinct successors of switch b (the default
// first, then in case order).
pub fn switch_rebuild_succs(cx: &mut FnCtx, b: i64) {
    unsafe {
        let start = cx.swcases.count;
        cx.swcases.push((*cx.blocks.add(b as usize)).s0);
        for i in 0..(*cx.blocks.add(b as usize)).ncases {
            let t = case_target(cx, b, i);
            let mut seen = false;
            for k in start..cx.swcases.count {
                if (*cx.swcases.data.add(k as usize)) == t {
                    seen = true;
                }
            }
            if !seen {
                cx.swcases.push(t);
            }
        }
        (*cx.blocks.add(b as usize)).succs = start;
        (*cx.blocks.add(b as usize)).nsucc = cx.swcases.count - start;
    }
}

// The block switch b goes to for the constant `value`.
pub fn switch_target(cx: &mut FnCtx, b: i64, value: i64) -> i64 {
    unsafe {
        for i in 0..(*cx.blocks.add(b as usize)).ncases {
            if case_value(cx, b, i) == value {
                return case_target(cx, b, i);
            }
        }
        (*cx.blocks.add(b as usize)).s0
    }
}

// Makes the edge from b to `from` go to `to` (the predecessor lists are
// the caller's business). A switch whose cases already reach `to` is not
// changed (that would make two edges into `to`): returns false.
pub fn redirect_succ(cx: &mut FnCtx, b: i64, from: i64, to: i64) -> bool {
    unsafe {
        let term = (*cx.blocks.add(b as usize)).term;
        if term == Term::Switch {
            if is_succ(cx, b, to) {
                return false;
            }
            let start = cx.swcases.count;
            for i in 0..(*cx.blocks.add(b as usize)).ncases {
                let case_value_v = case_value(cx, b, i);
                cx.swcases.push(case_value_v);
                let t = case_target(cx, b, i);
                cx.swcases.push(if t == from { to } else { t });
            }
            (*cx.blocks.add(b as usize)).cases = start;
            if (*cx.blocks.add(b as usize)).s0 == from {
                (*cx.blocks.add(b as usize)).s0 = to;
            }
            switch_rebuild_succs(cx, b);
            return true;
        }
        if (*cx.blocks.add(b as usize)).s0 == from {
            (*cx.blocks.add(b as usize)).s0 = to;
        }
        if term == Term::Branch && (*cx.blocks.add(b as usize)).s1 == from {
            (*cx.blocks.add(b as usize)).s1 = to;
        }
        true
    }
}

// Copies the terminator of block `from` to block `to` (successors as they
// are; the predecessor lists are the caller's business).
pub fn copy_terminator(cx: &mut FnCtx, to: i64, from: i64) {
    unsafe {
        (*cx.blocks.add(to as usize)).term = (*cx.blocks.add(from as usize)).term;
        (*cx.blocks.add(to as usize)).cond = (*cx.blocks.add(from as usize)).cond;
        (*cx.blocks.add(to as usize)).s0 = (*cx.blocks.add(from as usize)).s0;
        (*cx.blocks.add(to as usize)).s1 = (*cx.blocks.add(from as usize)).s1;
        (*cx.blocks.add(to as usize)).cases = (*cx.blocks.add(from as usize)).cases;
        (*cx.blocks.add(to as usize)).ncases = (*cx.blocks.add(from as usize)).ncases;
        (*cx.blocks.add(to as usize)).succs = (*cx.blocks.add(from as usize)).succs;
        (*cx.blocks.add(to as usize)).nsucc = (*cx.blocks.add(from as usize)).nsucc;
    }
}

// The index of `pred` among the predecessors of `b`, or -1.
pub fn pred_index(cx: &mut FnCtx, b: i64, pred: i64) -> i64 {
    unsafe {
        for i in 0..(*cx.blocks.add(b as usize)).preds.count {
            if (*(*cx.blocks.add(b as usize)).preds.data.add(i as usize)) == pred {
                return i;
            }
        }
    }
    -1
}
