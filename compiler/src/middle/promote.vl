// Scalar promotion (0.6): a memory location that a loop reads and writes
// lives in a register for the loop. The location is one type at one
// loop-invariant address in a frame slot or a static, accessed in the loop
// only by loads and stores of that address, where no other access in the
// loop may overlap it and no call may reach it. It is loaded in the
// preheader; its loads and stores in the loop become SSA values (the SSA
// updater places the phis); when the loop stores to it, it is stored back
// in each exit. Accesses to the same object at variable offsets are kept
// apart by the value ranges at their blocks (bounds checks, loop counters):
// `vm.stack[vm.sp]` does not overlap `vm.sp`.

use crate::back::regalloc::prepare::layout_order;
use crate::base::{IntVec, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_BOOL, TY_U64, is_float, is_integer, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{
    address_base, copy_dst, copy_size, copy_src, find_escaping_slots, is_copy, is_private_root,
    object_size, root_of,
};
use crate::middle::ipo::{call_reads, call_writes};
use crate::middle::ir::{
    Op, ir_append, ir_enter, ir_insert_before, ir_make, ir_prepend, ir_replace, ir_set_arg,
    ir_unlink, ir_val,
};
use crate::middle::ir::Op::{Add, GAddr, Load, Phi, SAddr, Store};
use crate::middle::ir::atomic::is_barrier;
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{
    canonicalize_loops, is_canonical, loop_block, loop_contains, loop_count, loop_exits,
    loop_preheader, loop_size, seal_all,
};
use crate::middle::lower::ssa::{new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{dominates, remove_trivial_phis, resolve_all};
use crate::middle::range::{prepare_ranges, value_range_at};

const MAX_ACCESSES: i64 = 2000;

// Promotes the memory locations of function fi's loops that can be.
// Returns whether any was.
pub fn promote_loop_memory(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        // Most functions have no loop with memory in it: the loop analysis is
        // not worth starting for them.
        if !has_loop_with_memory(cx, fi) {
            return false;
        }
        resolve_all(cx, fi);
        seal_all(cx, fi);
        canonicalize_loops(cx, fi, pcx);
        resolve_all(cx, fi);
        find_escaping_slots(cx, fi, pcx);
        prepare_ranges(cx, fi, pcx);
        let mut changed = false;
        // Inner loops first (deeper), so an outer loop sees what they made.
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for depth in 0..16 {
            let d = 16 - depth;
            for l in 0..loop_count(cx) {
                if (*cx.lp_depth.data.add(l as usize)) == d {
                    order.push(l);
                }
            }
        }
        for i in 0..order.count {
            let l = (*order.data.add(i as usize));
            if !is_canonical(cx, l) {
                continue;
            }
            if promote_in_loop(cx, fi, l, pcx) {
                changed = true;
                // The control flow is unchanged; the values are new.
                resolve_all(cx, fi);
            }
        }
        free(order.data as *mut u8);
        if changed {
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
            verify_func(cx, fi, c"scalar promotion", pcx);
        }
        changed
    }
}

// Whether function fi has a cycle (an edge to a block not later in
// reverse post-order) with a store to a frame slot or a static in a block
// on it: a quick filter (a location only loaded in a loop is LICM's).
fn has_loop_with_memory(cx: &mut FnCtx<Comp>, fi: i64) -> bool {
    unsafe {
        layout_order(cx, fi);
        for i in 0..cx.order.count {
            let b = (*cx.order.data.add(i as usize));
            for k in 0..succ_count(cx, b) {
                let s = succ(cx, b, k);
                if (*cx.blocks.add(s as usize)).order >= 0
                    && (*cx.blocks.add(s as usize)).order <= (*cx.blocks.add(b as usize)).order {
                    // A back edge s <- b: the blocks from s to b in the order
                    // hold the loop (and maybe more).
                    for j in (*cx.blocks.add(s as usize)).order..(*cx.blocks.add(b as usize)).order + 1 {
                        let mut v = (*cx.blocks.add((*cx.order.data.add(j as usize)) as usize)).first;
                        while v != 0 {
                            if (*cx.insts.add(v as usize)).op == Store {
                                let mut offset: i64 = 0;
                                let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).a);
                                let base = address_base(cx, ir_val_v, &mut offset);
                                let op = (*cx.insts.add(base as usize)).op;
                                if op == Op::Slot || op == GAddr {
                                    return true;
                                }
                            }
                            v = (*cx.insts.add(v as usize)).next;
                        }
                    }
                }
            }
        }
        false
    }
}

fn collect_accesses(cx: &mut FnCtx<Comp>, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        cx.accesses.clear();
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let op = (*cx.insts.add(v as usize)).op;
                if op == Load || op == Store {
                    let mut offset = (*cx.insts.add(v as usize)).imm;
                    let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).a);
                    let base = address_base(cx, ir_val_v, &mut offset);
                    cx.accesses.push(v);
                    cx.accesses.push(base);
                    cx.accesses.push(offset);
                    let ty = if op == Load { (*cx.insts.add(v as usize)).ty }
                        else { (*cx.insts.add(v as usize)).imm2 };
                    cx.accesses.push(type_size(ty, pcx));
                    cx.accesses.push(ty);
                } else if is_copy(cx, v, pcx) || op.is_call() || is_barrier(cx, v) {
                    cx.accesses.push(v);
                    cx.accesses.push(0);
                    cx.accesses.push(0);
                    cx.accesses.push(0);
                    cx.accesses.push(0);
                }
                if cx.accesses.count > MAX_ACCESSES * 5 {
                    return false;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        true
    }
}

fn promote_in_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !collect_accesses(cx, l, pcx) {
            return false;
        }
        let mut changed = false;
        let n = cx.accesses.count / 5;
        for i in 0..n {
            let v = (*cx.accesses.data.add((5 * i) as usize));
            let base = (*cx.accesses.data.add((5 * i + 1) as usize));
            let ty = (*cx.accesses.data.add((5 * i + 4) as usize));
            if base == 0 || (*cx.insts.add(v as usize)).block == 0 || ty == 0
                || !is_integer_like(ty) {
                continue;
            }
            // The address is computed outside the loop, or is an address
            // constant (remade where it is needed).
            if (*cx.insts.add(base as usize)).block != 0
                && loop_contains(cx, l, (*cx.insts.add(base as usize)).block)
                && !is_address_constant(cx, base) {
                continue;
            }
            let root = root_of(cx, base);
            if root == 0
                || ((*cx.insts.add(root as usize)).op != Op::Slot
                    && (*cx.insts.add(root as usize)).op != GAddr) {
                continue;
            }
            let offset = (*cx.accesses.data.add((5 * i + 2) as usize));
            // Done already (an earlier access of the same location)?
            let mut first = true;
            for j in 0..i {
                if (*cx.accesses.data.add((5 * j + 1) as usize)) == base
                    && (*cx.accesses.data.add((5 * j + 2) as usize)) == offset
                    && (*cx.insts.add((*cx.accesses.data.add((5 * j) as usize)) as usize)).block
                    != 0 {
                    first = false;
                }
            }
            if !first {
                continue;
            }
            if can_promote(cx, l, root, base, offset, ty, pcx) {
                promote(cx, fi, l, base, offset, ty, pcx);
                changed = true;
            }
        }
        changed
    }
}

// The scalar types a location can be promoted with.
fn is_integer_like(ty: i64) -> bool {
    is_integer(ty) || is_float(ty) || ty == TY_BOOL
}

// Whether the location [base + offset, + size of ty) of object `root` can
// be promoted in loop l: every access of it is a load or store of type
// ty at base + offset, and nothing else in the loop may reach it.
fn can_promote(cx: &mut FnCtx<Comp>, l: i64, root: i64, base: i64, offset: i64, ty: i64,
    pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let size = type_size(ty, pcx);
        let private = is_private_root(cx, root);
        let mut loc_lo: i64 = 0;
        let mut loc_hi: i64 = 0;
        if !relative_range(cx, base, root,
            (*cx.insts.add((*cx.accesses.data.add(0)) as usize)).block, &mut loc_lo, &mut loc_hi, 0,
            pcx)
            || loc_lo != loc_hi {
            return false;
        }
        let loc = loc_lo + offset;
        // (0.25) It is loaded in the preheader, where the loop may not have
        // accessed it: only a location inside its object by what holds
        // there (the facts in the loop, a bounds check's, hold only past it).
        let object = object_size(cx, root, pcx);
        let mut pre_lo: i64 = 0;
        let mut pre_hi: i64 = 0;
        let loop_preheader_v = loop_preheader(cx, l);
        let relative_range_v = relative_range(cx, base, root, loop_preheader_v, &mut pre_lo,
            &mut pre_hi, 0, pcx);
        let arg_v = !relative_range_v
            || pre_lo + offset < 0;
        if arg_v || pre_hi + offset + size > object {
            return false;
        }
        let mut uses: i64 = 0;
        for i in 0..cx.accesses.count / 5 {
            let v = (*cx.accesses.data.add((5 * i) as usize));
            if (*cx.insts.add(v as usize)).block == 0 {
                continue;
            }
            let b2 = (*cx.accesses.data.add((5 * i + 1) as usize));
            let o2 = (*cx.accesses.data.add((5 * i + 2) as usize));
            let s2 = (*cx.accesses.data.add((5 * i + 3) as usize));
            let t2 = (*cx.accesses.data.add((5 * i + 4) as usize));
            let op = (*cx.insts.add(v as usize)).op;
            if b2 == base && o2 == offset && t2 != 0 {
                if t2 != ty {
                    return false;
                }
                uses += 1;
                continue;
            }
            // (0.21) An atomic or a fence: only private memory moves across.
            if is_barrier(cx, v) {
                if !private {
                    return false;
                }
                continue;
            }
            if op.is_call() && !is_copy(cx, v, pcx) {
                if !private && (call_reads(cx, v, pcx) || call_writes(cx, v, pcx)) {
                    return false;
                }
                continue;
            }
            if is_copy(cx, v, pcx) {
                let mut dst_offset: i64 = 0;
                let copy_dst_v = copy_dst(cx, v);
                let ir_val_v = ir_val(cx, copy_dst_v);
                let dst = address_base(cx, ir_val_v, &mut dst_offset);
                let mut src_offset: i64 = 0;
                let copy_src_v = copy_src(cx, v);
                let ir_val_v1 = ir_val(cx, copy_src_v);
                let src = address_base(cx, ir_val_v1, &mut src_offset);
                let n = copy_size(cx, v);
                if !disjoint(cx, l, root, private, loc, size, dst, dst_offset, n,
                    (*cx.insts.add(v as usize)).block, pcx)
                    || !disjoint(cx, l, root, private, loc, size, src, src_offset, n,
                        (*cx.insts.add(v as usize)).block, pcx) {
                    return false;
                }
                continue;
            }
            if !disjoint(cx, l, root, private, loc, size, b2, o2, s2,
                (*cx.insts.add(v as usize)).block, pcx) {
                return false;
            }
        }
        // (0.21, docs/design/concurrency.md §4.2, O3) The value is stored back
        // at the loop's exits: for memory another thread may see (a slot
        // whose address escapes), only when the loop stored it on the way to
        // every exit, so that no store is invented on a path that made none.
        // A static is main-thread memory (§2.5).
        if uses >= 2 && !private && (*cx.insts.add(root as usize)).op == Op::Slot
            && !stores_before_exits(cx, l, base, offset) {
            return false;
        }
        uses >= 2
    }
}

// (0.21) Whether loop l stores to [base + offset] before it can leave: each
// block that exits the loop is dominated by a block of the loop that
// stores there (or the loop does not store there at all).
fn stores_before_exits(cx: &mut FnCtx<Comp>, l: i64, base: i64, offset: i64) -> bool {
    unsafe {
        let mut any = false;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if is_location(cx, v, Store, base, offset) {
                    any = true;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        if !any {
            return true;
        }
        for i in 0..loop_size(cx, l) {
            let x = loop_block(cx, l, i);
            let mut exits = false;
            for k in 0..succ_count(cx, x) {
                let succ_v = succ(cx, x, k);
                let loop_contains_v = loop_contains(cx, l, succ_v);
                if !loop_contains_v {
                    exits = true;
                }
            }
            if !exits {
                continue;
            }
            let mut covered = false;
            for j in 0..loop_size(cx, l) {
                let s = loop_block(cx, l, j);
                if covered || !dominates(cx, s, x) {
                    continue;
                }
                let mut v = (*cx.blocks.add(s as usize)).first;
                while v != 0 {
                    if is_location(cx, v, Store, base, offset) {
                        covered = true;
                    }
                    v = (*cx.insts.add(v as usize)).next;
                }
            }
            if !covered {
                return false;
            }
        }
        true
    }
}

// Whether the access [b2 + o2, + s2) at block `at` cannot overlap the
// location [loc, + size) of object `root`.
fn disjoint(cx: &mut FnCtx<Comp>, l: i64, root: i64, private: bool, loc: i64, size: i64, b2: i64,
    o2: i64, s2: i64, at: i64, pcx: &Ctx<Comp>) -> bool {
    let r2 = root_of(cx, b2);
    if r2 == 0 {
        // An unknown pointer reaches no private slot.
        return private;
    }
    if r2 != root {
        // Another object, or constant data.
        unsafe {
            return (*cx.insts.add(r2 as usize)).op == SAddr
                || (*cx.insts.add(r2 as usize)).op != (*cx.insts.add(root as usize)).op
                || (*cx.insts.add(r2 as usize)).imm != (*cx.insts.add(root as usize)).imm;
        }
    }
    let mut lo: i64 = 0;
    let mut hi: i64 = 0;
    if !relative_range(cx, b2, root, at, &mut lo, &mut hi, 0, pcx) {
        return false;
    }
    let limit: i64 = 1152921504606846976;
    if lo < 0 - limit || hi > limit || s2 < 0 || s2 > limit {
        return false;
    }
    hi + o2 + s2 <= loc || lo + o2 >= loc + size
}

// The range of x - root (x an address computed from `root` by additions)
// at block `at`, in *lo and *hi. Returns false when x is not such an
// address or its range is unknown.
fn relative_range(cx: &mut FnCtx<Comp>, x: i64, root: i64, at: i64, lo: &mut i64, hi: &mut i64,
    depth: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let v = ir_val(cx, x);
        if v == root {
            *lo = 0;
            *hi = 0;
            return true;
        }
        if depth > 8 || (*cx.insts.add(v as usize)).op != Add
            || (*cx.insts.add(v as usize)).ty != TY_U64 {
            return false;
        }
        let a = ir_val(cx, (*cx.insts.add(v as usize)).a);
        let c = ir_val(cx, (*cx.insts.add(v as usize)).b);
        let mut blo: i64 = 0;
        let mut bhi: i64 = 0;
        let mut other: i64 = 0;
        if relative_range(cx, a, root, at, lo, hi, depth + 1, pcx) {
            other = c;
        } else if relative_range(cx, c, root, at, lo, hi, depth + 1, pcx) {
            other = a;
        } else {
            return false;
        }
        value_range_at(cx, other, at, &mut blo, &mut bhi, pcx);
        let limit: i64 = 1152921504606846976;
        if blo < 0 - limit || bhi > limit || *lo < 0 - limit || *hi > limit {
            return false;
        }
        *lo = *lo + blo;
        *hi = *hi + bhi;
        true
    }
}

// The address of a frame slot or a static, which has no operands.
fn is_address_constant(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe { (*cx.insts.add(v as usize)).op == Op::Slot || (*cx.insts.add(v as usize)).op == GAddr }
}

// `base` for a use in block b, outside loop l: base itself, or for an
// address constant defined in the loop, a copy of it placed before `at`
// (or at the end of b when at is 0).
fn address_outside(cx: &mut FnCtx<Comp>, l: i64, base: i64, b: i64, at: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (*cx.insts.add(base as usize)).block == 0
            || !loop_contains(cx, l, (*cx.insts.add(base as usize)).block) {
            return base;
        }
        let copy = ir_make(cx, (*cx.insts.add(base as usize)).op, (*cx.insts.add(base as usize)).ty,
            0, 0, (*cx.insts.add(base as usize)).imm, pcx);
        if at == 0 {
            ir_append(cx, b, copy);
        } else {
            ir_insert_before(cx, at, copy);
        }
        copy
    }
}

// Promotes [base + offset] (type ty) in loop l.
fn promote(cx: &mut FnCtx<Comp>, fi: i64, l: i64, base: i64, offset: i64, ty: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let pre = loop_preheader(cx, l);
        let address_outside_v = address_outside(cx, l, base, pre, 0, pcx);
        let initial = ir_make(cx, Load, ty, address_outside_v, 0, offset,
            pcx);
        ir_append(cx, pre, initial);
        let var_id = new_synth_var(cx, ty, pcx);
        ssa_write(cx, var_id, pre, initial);
        // The value each block leaves in the location: its last store.
        let mut stores = false;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            let mut last: i64 = 0;
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if is_location(cx, v, Store, base, offset) {
                    last = v;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
            if last != 0 {
                let ir_val_v = ir_val(cx, (*cx.insts.add(last as usize)).b);
                ssa_write(cx, var_id, b, ir_val_v);
                (*cx.blocks.add(b as usize)).aux = 1;
                stores = true;
            } else {
                (*cx.blocks.add(b as usize)).aux = 0;
            }
        }
        // Loads and stores become values.
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            let mut current: i64 = 0;
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if is_location(cx, v, Load, base, offset) {
                    if current == 0 {
                        current = value_at_start(cx, var_id, b, ty, pcx);
                    }
                    ir_replace(cx, v, current);
                } else if is_location(cx, v, Store, base, offset) {
                    current = ir_val(cx, (*cx.insts.add(v as usize)).b);
                    ir_unlink(cx, v);
                }
                v = next;
            }
        }
        // Stored back in the exits.
        if stores {
            loop_exits(cx, l);
            let mut exits = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            for i in 0..cx.lp_list.count {
                exits.push((*cx.lp_list.data.add(i as usize)));
            }
            for i in 0..exits.count {
                let e = (*exits.data.add(i as usize));
                let value = ssa_read(cx, var_id, e, pcx);
                let mut at = (*cx.blocks.add(e as usize)).first;
                while at != 0 && (*cx.insts.add(at as usize)).op == Phi {
                    at = (*cx.insts.add(at as usize)).next;
                }
                let address = address_outside(cx, l, base, e, at, pcx);
                let st = ir_make(cx, Store, 0, address, value, offset, pcx);
                (*cx.insts.add(st as usize)).imm2 = ty;
                if at == 0 {
                    ir_append(cx, e, st);
                } else {
                    ir_insert_before(cx, at, st);
                }
            }
            free(exits.data as *mut u8);
        }
    }
}

fn is_location(cx: &mut FnCtx<Comp>, v: i64, op: Op, base: i64, offset: i64) -> bool {
    unsafe {
        if (*cx.insts.add(v as usize)).op != op {
            return false;
        }
        let mut o = (*cx.insts.add(v as usize)).imm;
        let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).a);
        let b = address_base(cx, ir_val_v, &mut o);
        b == base && o == offset
    }
}

// The value of the location at the start of loop block b: with no store
// in b, what reaches its end; else what its predecessors leave (a phi
// when they differ).
fn value_at_start(cx: &mut FnCtx<Comp>, var_id: i64, b: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (*cx.blocks.add(b as usize)).aux == 0 {
            return ssa_read(cx, var_id, b, pcx);
        }
        let n = (*cx.blocks.add(b as usize)).preds.count;
        if n == 1 {
            return ssa_read(cx, var_id, (*(*cx.blocks.add(b as usize)).preds.data.add(0)), pcx);
        }
        let phi = ir_make(cx, Phi, ty, 0, 0, 0, pcx);
        ir_prepend(cx, b, phi);
        (*cx.insts.add(phi as usize)).args = cx.args.count;
        (*cx.insts.add(phi as usize)).nargs = n;
        for k in 0..n {
            cx.args.push(0);
            cx.argty.push(0);
        }
        for k in 0..n {
            let ssa_read_v = ssa_read(cx, var_id,
                (*(*cx.blocks.add(b as usize)).preds.data.add(k as usize)), pcx);
            ir_set_arg(cx, phi, k, ssa_read_v);
        }
        phi
    }
}
