// Scalar replacement of aggregates: a frame slot whose address is only
// used by loads, stores and copies at constant offsets (it does not escape)
// becomes one SSA variable per scalar leaf of its type, built with the
// construction of lower.vl (Braun et al.) over the existing CFG:
// blocks in reverse post-order, each sealed once its predecessors are all
// filled. Stores become definitions, loads uses; a copy moves leaf by leaf
// (to or from memory when the other side stays in memory). Loads and
// stores must hit a leaf exactly (same offset and type) and copies whole
// leaves; the leaves of the variants of an enum may coincide but not
// overlap otherwise. Bytes outside the leaves (padding) are not kept.

use crate::back::abi::abi_leaves;
use crate::back::regalloc::prepare::layout_order;
use crate::base::{IntVec, alloc_array, buf_clear, buf_slice, buf_zeros, free, table_reset};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::consteval::{bits_of, wrap_int, write_scalar};
use crate::front::types::{
    TY_BOOL, TY_F32, TY_F64, TY_U64, int_bits, is_integer, is_void, type_size,
};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{is_const, op_before};
use crate::middle::gvn::{
    address_base, copy_dst, copy_src, find_escaping_slots, is_copy, is_private_root, root_of,
};
use crate::middle::ir::{
    fn_block, fn_block_count, fn_entry, fn_slot, fn_slot_count, ir_enter, ir_insert_before, ir_make,
    ir_operand, ir_operand_count, ir_prepend, ir_replace, ir_type, ir_unlink, ir_val,
};
use crate::middle::ir::Op::{Add, Const, Conv, Copy, Load, SAddr, Slot, Store};
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::lower::ssa::{ir_seal, new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{compute_dominators, dominates, remove_trivial_phis, resolve_all};
use crate::middle::parallel::{const_data, const_data_bytes};

const SROA_MAX_LEAVES: i64 = 32;

const SROA_ROUNDS: i64 = 4;

fn leaf_offset(cx: &mut FnCtx<Comp>, s: i64, i: i64) -> i64 {
    (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + i)) as usize])
}

fn leaf_type(cx: &mut FnCtx<Comp>, s: i64, i: i64) -> i64 {
    (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + i) + 1) as usize])
}

// The leaves of slot s from its type; false when they cannot be variables.
fn slot_leaves(cx: &mut FnCtx<Comp>, s: i64, pcx: &Ctx<Comp>) -> bool {
    let ty = (cx.slots[s as usize]).ty;
    if ty == 0 || is_void(ty) {
        return false;
    }
    cx.abi_leaves.clear();
    cx.leaves_whole_vectors = true;
    // (0.26.2: more than SROA_MAX_LEAVES * 4 are refused below)
    cx.leaves_cap = SROA_MAX_LEAVES * 4;
    abi_leaves(cx, ty, 0, pcx);
    cx.leaves_whole_vectors = false;
    cx.leaves_cap = 0;
    let n = cx.abi_leaves.len() as i64 / 2;
    if n == 0 || n > SROA_MAX_LEAVES * 4 {
        return false;
    }
    (cx.sr_first[s as usize]) = cx.sr_leaves.len() as i64 / 2;
    let mut count: i64 = 0;
    for i in 0..n {
        let offset = (cx.abi_leaves[(2 * i) as usize]);
        let leaf = ir_type((cx.abi_leaves[(2 * i + 1) as usize]), pcx);
        // Inserted by offset; a repeated (offset, type) once.
        let mut at = count;
        let mut repeat = false;
        for k in 0..count {
            let o = (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + k)) as usize]);
            let t = (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + k) + 1) as usize]);
            if o == offset && t == leaf {
                repeat = true;
            }
            if o > offset && at == count {
                at = k;
            }
        }
        if repeat {
            continue;
        }
        cx.sr_leaves.push(0);
        cx.sr_leaves.push(0);
        let mut k = count;
        while k > at {
            (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + k)) as usize]) = (
                cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + k - 1)) as usize]);
            (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + k) + 1) as usize]) = (
                cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + k - 1) + 1) as usize]);
            k -= 1;
        }
        (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + at)) as usize]) = offset;
        (cx.sr_leaves[(2 * ((cx.sr_first[s as usize]) + at) + 1) as usize]) = leaf;
        count += 1;
    }
    (cx.sr_count[s as usize]) = count;
    if count > SROA_MAX_LEAVES {
        return false;
    }
    // No two leaves overlap.
    for i in 1..count {
        if leaf_offset(cx, s, i - 1) + type_size(leaf_type(cx, s, i - 1), pcx)
            > leaf_offset(cx, s, i) {
            return false;
        }
    }
    true
}

// The leaf of slot s at `offset` of IR type `ty`, or -1.
fn find_leaf(cx: &mut FnCtx<Comp>, s: i64, offset: i64, ty: i64) -> i64 {
    for i in 0..(cx.sr_count[s as usize]) {
        if leaf_offset(cx, s, i) == offset && leaf_type(cx, s, i) == ty {
            return i;
        }
    }
    -1
}

// The same for a load or a store: a 64-bit integer leaf also takes the
// other 64-bit integer type (i64 and u64 have the same canonical bits; a
// slice's length is an i64 leaf that a parameter's piece fills as u64).
fn find_access_leaf(cx: &mut FnCtx<Comp>, s: i64, offset: i64, ty: i64) -> i64 {
    for i in 0..(cx.sr_count[s as usize]) {
        let lt = leaf_type(cx, s, i);
        if leaf_offset(cx, s, i) == offset
            && (lt == ty
                || (is_integer(lt) && is_integer(ty) && int_bits(lt) == 64
                    && int_bits(ty) == 64)) {
            return i;
        }
    }
    -1
}

// v as type ty: v, or a conversion before instruction `at` between 64-bit
// integer types (which changes no bits).
fn as_leaf_type(cx: &mut FnCtx<Comp>, v: i64, ty: i64, at: i64, pcx: &Ctx<Comp>) -> i64 {
    if (cx.insts[v as usize]).ty == ty {
        return v;
    }
    let c = op_before(cx, at, Conv, ty, v, 0, pcx);
    (cx.insts[c as usize]).imm2 = (cx.insts[v as usize]).ty;
    c
}

// Whether [offset, + size) holds whole leaves of slot s only.
fn whole_leaves(cx: &mut FnCtx<Comp>, s: i64, offset: i64, size: i64, pcx: &Ctx<Comp>) -> bool {
    for i in 0..(cx.sr_count[s as usize]) {
        let start = leaf_offset(cx, s, i);
        let end = start + type_size(leaf_type(cx, s, i), pcx);
        if start < offset + size && end > offset && (start < offset || end > offset + size) {
            return false;
        }
    }
    true
}

// The candidate slot of address `v` (and its offset), or 0.
fn sroa_slot(cx: &mut FnCtx<Comp>, v: i64, offset: &mut i64) -> i64 {
    *offset = 0;
    let base = address_base(cx, v, offset);
    if (cx.insts[base as usize]).op != Slot
        || (cx.sr_state[(cx.insts[base as usize]).imm as usize]) == 0 {
        return 0;
    }
    (cx.insts[base as usize]).imm
}

// Whether a copy of `size` bytes between slots d (at d_off) and s (at
// s_off) moves leaves to leaves of the same types.
fn leaves_match(cx: &mut FnCtx<Comp>, d: i64, d_off: i64, s: i64, s_off: i64, size: i64) -> bool {
    let mut count: i64 = 0;
    for i in 0..(cx.sr_count[s as usize]) {
        let o = leaf_offset(cx, s, i);
        if o >= s_off && o < s_off + size {
            let leaf_type_v = leaf_type(cx, s, i);
            let find_leaf_v = find_leaf(cx, d, d_off + o - s_off, leaf_type_v);
            if find_leaf_v < 0 {
                return false;
            }
            count += 1;
        }
    }
    for i in 0..(cx.sr_count[d as usize]) {
        let o = leaf_offset(cx, d, i);
        if o >= d_off && o < d_off + size {
            count -= 1;
        }
    }
    count == 0
}

// Rules out the slots used other than as plain memory.
fn sroa_scan(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        for i in 0..fn_block_count(cx, fi) {
            let b = (fn_block(cx, fi, i));
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                for k in 0..ir_operand_count(cx, v) {
                    let operand = ir_operand(cx, v, k);
                    if operand == 0 {
                        continue;
                    }
                    let mut offset: i64 = 0;
                    let s = sroa_slot(cx, operand, &mut offset);
                    if s == 0 {
                        continue;
                    }
                    let mut ok = false;
                    if op == Load && k == 0 {
                        ok = find_access_leaf(cx, s, offset + (cx.insts[v as usize]).imm,
                            (cx.insts[v as usize]).ty)
                            >= 0;
                    } else if op == Store && k == 0 {
                        ok = find_access_leaf(cx, s, offset + (cx.insts[v as usize]).imm,
                            (cx.insts[v as usize]).imm2)
                            >= 0;
                    } else if op == Copy && k <= 1 {
                        ok = whole_leaves(cx, s, offset, (cx.insts[v as usize]).imm, pcx);
                    }
                    else if op == Add && k == 0 && (cx.insts[v as usize]).ty == TY_U64
                        && is_const(cx, (cx.insts[v as usize]).b) {
                        ok = true;
                    }
                    if !ok {
                        (cx.sr_state[s as usize]) = 0;
                        // (an address stored into a candidate: see run_sroa)
                        if op == Store && k == 1 {
                            let mut d_off: i64 = 0;
                            let d = sroa_slot(cx, (cx.insts[v as usize]).a, &mut d_off);
                            if d != 0 {
                                cx.sr_held.push(d);
                            }
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            if (cx.blocks[b as usize]).cond != 0 {
                let mut offset: i64 = 0;
                let s = sroa_slot(cx, (cx.blocks[b as usize]).cond, &mut offset);
                if s != 0 {
                    (cx.sr_state[s as usize]) = 0;
                }
            }
        }
        // Copies between two candidates must match leaf for leaf.
        let mut changed = true;
        while changed {
            changed = false;
            for i in 0..fn_block_count(cx, fi) {
                let b = (fn_block(cx, fi, i));
                if (cx.blocks[b as usize]).removed != 0 {
                    continue;
                }
                let mut v = (cx.blocks[b as usize]).first;
                while v != 0 {
                    if (cx.insts[v as usize]).op == Copy {
                        let mut d_off: i64 = 0;
                        let mut s_off: i64 = 0;
                        let d = sroa_slot(cx, (cx.insts[v as usize]).a, &mut d_off);
                        let s = sroa_slot(cx, (cx.insts[v as usize]).b, &mut s_off);
                        if d != 0 && s != 0
                            && !leaves_match(cx, d, d_off, s, s_off,
                                (cx.insts[v as usize]).imm) {
                            (cx.sr_state[d as usize]) = 0;
                            (cx.sr_state[s as usize]) = 0;
                            changed = true;
                        }
                    }
                    v = (cx.insts[v as usize]).next;
                }
            }
        }
    }
}

// The replacement of the slots: loads, stores and copies in block b.
fn sroa_block(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0 {
        let next = (cx.insts[v as usize]).next;
        let op = (cx.insts[v as usize]).op;
        let mut offset: i64 = 0;
        if op == Load {
            let s = sroa_slot(cx, (cx.insts[v as usize]).a, &mut offset);
            if s != 0 {
                let leaf = find_access_leaf(cx, s, offset + (cx.insts[v as usize]).imm,
                    (cx.insts[v as usize]).ty);
                let value = ssa_read(cx, (cx.sr_var[s as usize]) + leaf, b, pcx);
                let as_leaf_type_v = as_leaf_type(cx, value, (cx.insts[v as usize]).ty, v,
                    pcx);
                ir_replace(cx, v, as_leaf_type_v);
            }
        } else if op == Store {
            let s = sroa_slot(cx, (cx.insts[v as usize]).a, &mut offset);
            if s != 0 {
                let leaf = find_access_leaf(cx, s, offset + (cx.insts[v as usize]).imm,
                    (cx.insts[v as usize]).imm2);
                let arg_v = (cx.sr_var[s as usize]) + leaf;
                let ir_val_v = ir_val(cx, (cx.insts[v as usize]).b);
                let leaf_type_v = leaf_type(cx, s, leaf);
                let as_leaf_type_v1 = as_leaf_type(cx, ir_val_v,
                    leaf_type_v, v, pcx);
                ssa_write(cx, arg_v, b,
                    as_leaf_type_v1);
                ir_unlink(cx, v);
            }
        } else if op == Copy {
            sroa_copy(cx, b, v, pcx);
        }
        v = next;
    }
}

fn sroa_copy(cx: &mut FnCtx<Comp>, b: i64, v: i64, pcx: &Ctx<Comp>) {
    let size = (cx.insts[v as usize]).imm;
    let mut d_off: i64 = 0;
    let mut s_off: i64 = 0;
    let d = sroa_slot(cx, (cx.insts[v as usize]).a, &mut d_off);
    let s = sroa_slot(cx, (cx.insts[v as usize]).b, &mut s_off);
    if d == 0 && s == 0 {
        return;
    }
    // The leaves of the source: (offset in the copy, type, value).
    cx.sr_values.clear();
    if s != 0 {
        for i in 0..(cx.sr_count[s as usize]) {
            let o = leaf_offset(cx, s, i);
            if o >= s_off && o < s_off + size {
                cx.sr_values.push(o - s_off);
                let leaf_type_v = leaf_type(cx, s, i);
                cx.sr_values.push(leaf_type_v);
                let ssa_read_v = ssa_read(cx, (cx.sr_var[s as usize]) + i, b, pcx);
                cx.sr_values.push(ssa_read_v);
            }
        }
    } else {
        for i in 0..(cx.sr_count[d as usize]) {
            let o = leaf_offset(cx, d, i);
            if o >= d_off && o < d_off + size {
                let leaf_type_v1 = leaf_type(cx, d, i);
                let load = ir_make(cx, Load, leaf_type_v1, (cx.insts[v as usize]).b, 0,
                    o - d_off, pcx);
                ir_insert_before(cx, v, load);
                cx.sr_values.push(o - d_off);
                let leaf_type_v2 = leaf_type(cx, d, i);
                cx.sr_values.push(leaf_type_v2);
                cx.sr_values.push(load);
            }
        }
    }
    let mut i: i64 = 0;
    while i < cx.sr_values.len() as i64 {
        let at = (cx.sr_values[i as usize]);
        let ty = (cx.sr_values[(i + 1) as usize]);
        let value = (cx.sr_values[(i + 2) as usize]);
        if d != 0 {
            let arg_v = (cx.sr_var[d as usize]) + find_leaf(cx, d, d_off + at, ty);
            ssa_write(cx, arg_v, b, value);
        } else {
            let store = ir_make(cx, Store, 0, (cx.insts[v as usize]).a, value, at, pcx);
            (cx.insts[store as usize]).imm2 = ty;
            ir_insert_before(cx, v, store);
        }
        i += 3;
    }
    ir_unlink(cx, v);
}

// Scalar replacement, to a fixpoint: again while a slot replaced held the
// address of another (at most SROA_ROUNDS times). Returns whether any slot
// was replaced.
pub fn run_sroa(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut any = false;
    for _ in 0..SROA_ROUNDS {
        cx.sr_held.clear();
        if !sroa_once(cx, fi, pcx) {
            break;
        }
        any = true;
        let mut again = false;
        for i in 0..cx.sr_held.len() as i64 {
            if (cx.sr_state[(cx.sr_held[i as usize]) as usize]) != 0 {
                again = true;
            }
        }
        if !again {
            break;
        }
    }
    any
}

fn sroa_once(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        resolve_all(cx, fi);
        let n = cx.slots.len() as i64 + 1;
        // (per slot, all 0; the room is kept from call to call)
        table_reset(&mut cx.sr_state, n as usize, 0);
        table_reset(&mut cx.sr_first, n as usize, 0);
        table_reset(&mut cx.sr_count, n as usize, 0);
        table_reset(&mut cx.sr_var, n as usize, 0);
        cx.sr_leaves.clear();
        let mut any = false;
        for i in 0..fn_slot_count(cx, fi) {
            let s = (fn_slot(cx, fi, i));
            if slot_leaves(cx, s, pcx) {
                (cx.sr_state[s as usize]) = 1;
                any = true;
            }
        }
        if !any {
            return false;
        }
        sroa_scan(cx, fi, pcx);
        any = false;
        for i in 0..fn_slot_count(cx, fi) {
            let s = (fn_slot(cx, fi, i));
            if (cx.sr_state[s as usize]) != 0 {
                any = true;
                let leaf_type_v = leaf_type(cx, s, 0);
                (cx.sr_var[s as usize]) = new_synth_var(cx, leaf_type_v, pcx);
                for k in 1..(cx.sr_count[s as usize]) {
                    let leaf_type_v1 = leaf_type(cx, s, k);
                    new_synth_var(cx, leaf_type_v1, pcx);
                }
            }
        }
        if !any {
            return false;
        }
        // SSA construction: blocks in reverse post-order; BLOCKS[b].mark counts
        // the filled predecessors.
        cx.defs.clear();
        layout_order(cx, fi);
        for i in 0..fn_block_count(cx, fi) {
            let b = (fn_block(cx, fi, i));
            (cx.blocks[b as usize]).sealed = 0;
            (cx.blocks[b as usize]).incomplete = 0;
            (cx.blocks[b as usize]).mark = 0;
        }
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..cx.order.len() as i64 {
            order.push((cx.order[k as usize]));
        }
        for k in 0..order.len() as i64 {
            let b = (order[k as usize]);
            if (cx.blocks[b as usize]).mark
                == (cx.blocks[b as usize]).preds.len() as i64 {
                ir_seal(cx, b, pcx);
            }
            sroa_block(cx, b, pcx);
            for i in 0..succ_count(cx, b) {
                let s = succ(cx, b, i);
                (cx.blocks[s as usize]).mark += 1;
                if (cx.blocks[s as usize]).sealed == 0
                    && (cx.blocks[s as usize]).order <= k
                    && (cx.blocks[s as usize]).mark
                    == (cx.blocks[s as usize]).preds.len() as i64 {
                    ir_seal(cx, s, pcx);
                }
            }
        }
        for k in 0..order.len() as i64 {
            if (cx.blocks[(order[k as usize]) as usize]).sealed == 0 {
                ir_seal(cx, (order[k as usize]), pcx);
            }
        }
        free(order.data as *mut u8);
        resolve_all(cx, fi);
        remove_trivial_phis(cx, fi, pcx);
        true
    }
}

// ---- Constant slots ----

// A private slot written only by stores of constants at known offsets, all
// in one block that comes before every read of it (in that block, or in
// blocks it dominates), always holds the same bytes: it becomes read-only
// data (a local table, like md5's shift amounts).
pub fn promote_constant_slots(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        resolve_all(cx, fi);
        find_escaping_slots(cx, fi, pcx);
        compute_dominators(cx, fi);
        let n = cx.slots.len() as i64 + 1;
        // Per slot: the block of its stores (0: none, -1: not constant), the
        // stores not yet passed (during the second walk).
        let block_of = alloc_array::<i64>(n);
        let stores = alloc_array::<i64>(n);
        let reads = alloc_array::<i64>(n);
        for i in 0..cx.order.len() as i64 {
            let b = (cx.order[i as usize]);
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                if op == Store || is_copy(cx, v, pcx) {
                    let arg_v = if op == Store { (cx.insts[v as usize]).a }
                        else { copy_dst(cx, v) };
                    let root = root_of(cx,
                        arg_v);
                    if is_private_root(cx, root) {
                        let s = (cx.insts[root as usize]).imm;
                        let mut offset: i64 = 0;
                        let base = address_base(cx, (cx.insts[v as usize]).a, &mut offset);
                        if op != Store || base != root
                            || (cx.insts[(cx.insts[v as usize]).b as usize]).op != Const {
                            (*block_of.add(s as usize)) = -1;
                        } else if (*block_of.add(s as usize)) == 0 {
                            (*block_of.add(s as usize)) = b;
                        } else if (*block_of.add(s as usize)) != b {
                            (*block_of.add(s as usize)) = -1;
                        }
                        if (*block_of.add(s as usize)) > 0 {
                            (*stores.add(s as usize)) += 1;
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        // Every read after the stores.
        for i in 0..cx.order.len() as i64 {
            let b = (cx.order[i as usize]);
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                let mut from: i64 = 0;
                if op == Load {
                    from = root_of(cx, (cx.insts[v as usize]).a);
                } else if is_copy(cx, v, pcx) {
                    let copy_src_v = copy_src(cx, v);
                    from = root_of(cx, copy_src_v);
                }
                if from != 0 && (cx.insts[from as usize]).op == Slot {
                    let s = (cx.insts[from as usize]).imm;
                    (*reads.add(s as usize)) = 1;
                    if (*block_of.add(s as usize)) > 0 {
                        if (*block_of.add(s as usize)) == b {
                            if (*stores.add(s as usize)) > 0 {
                                (*block_of.add(s as usize)) = -1;
                            }
                        } else if !dominates(cx, (*block_of.add(s as usize)), b) {
                            (*block_of.add(s as usize)) = -1;
                        }
                    }
                }
                if op == Store {
                    let root = root_of(cx, (cx.insts[v as usize]).a);
                    if is_private_root(cx, root)
                        && (*block_of.add((cx.insts[root as usize]).imm as usize)) > 0 {
                        (*stores.add((cx.insts[root as usize]).imm as usize)) -= 1;
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        let mut changed = false;
        // (0.18.1: the context's buffer: a task makes none)
        let scratch = cx.scratch_buf;
        for k in 0..fn_slot_count(cx, fi) {
            let s = (fn_slot(cx, fi, k));
            if (*block_of.add(s as usize)) <= 0 || (*reads.add(s as usize)) == 0 {
                continue;
            }
            // The bytes, from the stores (which are removed).
            let size = (cx.slots[s as usize]).size;
            buf_clear(scratch);
            buf_zeros(scratch, size);
            let b = (*block_of.add(s as usize));
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let next = (cx.insts[v as usize]).next;
                if (cx.insts[v as usize]).op == Store {
                    let root = root_of(cx, (cx.insts[v as usize]).a);
                    if root != 0 && (cx.insts[root as usize]).op == Slot
                        && (cx.insts[root as usize]).imm == s {
                        let mut offset: i64 = 0;
                        address_base(cx, (cx.insts[v as usize]).a, &mut offset);
                        write_scalar(scratch, offset + (cx.insts[v as usize]).imm,
                            (cx.insts[(cx.insts[v as usize]).b as usize]).imm,
                            (cx.insts[v as usize]).imm2, pcx);
                        ir_unlink(cx, v);
                    }
                }
                v = next;
            }
            let id = const_data(cx, fi,
                buf_slice(scratch), (cx.slots[s as usize]).align, pcx);
            let data = ir_make(cx, SAddr, TY_U64, 0, 0, id, pcx);
            ir_prepend(cx, fn_entry(cx, fi), data);
            for i in 0..cx.order.len() as i64 {
                let mut w = (cx.blocks[(cx.order[i as usize]) as usize]).first;
                while w != 0 {
                    let next = (cx.insts[w as usize]).next;
                    if (cx.insts[w as usize]).op == Slot
                        && (cx.insts[w as usize]).imm == s {
                        ir_replace(cx, w, data);
                    }
                    w = next;
                }
            }
            (cx.slots[s as usize]).size = 0;
            changed = true;
        }
        free(block_of as *mut u8);
        free(stores as *mut u8);
        free(reads as *mut u8);
        if changed {
            resolve_all(cx, fi);
        }
        changed
    }
}

// The value of a load of type `ty` from constant data `id` at `offset`
// (canonical), when it lies within the data; sets *ok.
pub fn constant_load(id: i64, offset: i64, ty: i64, ok: &mut bool, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let size = type_size(ty, pcx);
        *ok = false;
        // (A vector, 0.10, is no constant.)
        let bytes = const_data_bytes(id, pcx);
        if size > 8 || offset < 0 || offset + size > bytes.len() as i64 {
            return 0;
        }
        let mut bits: u64 = 0;
        for i in 0..size {
            bits |= ((*bytes.ptr.add((offset + i) as usize)) as u64) << (8 * i) as u64;
        }
        *ok = true;
        if ty == TY_F32 {
            let narrow = bits as u32;
            return bits_of(*(&raw const narrow as *mut f32) as f64);
        }
        if ty == TY_F64 {
            return bits as i64;
        }
        if ty == TY_BOOL {
            return (bits != 0) as i64;
        }
        wrap_int(bits as i64, ty)
    }
}
