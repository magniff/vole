// --verify-effects (0.16; docs/design/effects-allocation.md §4 T1): the
// front end's effects checked against the IR, right after lowering (before
// inlining moves calls between functions). Each IR function's calls of C
// functions that do io or allocate (their effects: a declaration or the
// builtin table), and its stores and copies into statics, must be in its
// function's inferred set (io, alloc(extern), global). Anything else is an
// internal error of the inference, reported for every function, then exit
// 1. A function whose effects are unknown is not checked.

use crate::base::{STDERR, buf_bytes, buf_new, buf_str, buf_write_fd, exit, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::effects::{
    EFF_ALLOC_EXTERN, EFF_GLOBAL, EFF_IO, EFF_UNKNOWN, Effects, effects_text, fn_effects,
};
use crate::front::effects::builtin::{C_ALLOC, C_EXIT, C_IO, c_class};
use crate::front::stdalloc::get_check_alloc_mode;
use crate::middle::checkalloc::site_static;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{get_irfuncs, Op, ir_enter};

// Checks every IR function (after lower_program); exits 1 when one does
// what its effects do not say.
pub fn verify_effects(cx: &mut FnCtx, pcx: &mut Ctx<Comp>) {
    unsafe {
        // (0.27.0: the C library's table, which needs reads)
        crate::front::effects::builtin::fill_c_table(pcx);
        let out = buf_new();
        let mut bad: i64 = 0;
        for fi in 0..pcx.irfunc_count {
            let f = (*get_irfuncs().add(fi as usize)).f;
            let e = fn_effects(f, pcx);
            if (e.bits & EFF_UNKNOWN) != 0 {
                continue;
            }
            ir_enter(cx, fi, pcx);
            let blocks = (*get_irfuncs().add(fi as usize)).blocks;
            for k in 0..blocks.count {
                let mut v = (*cx.blocks.add((*blocks.data.add(k as usize)) as usize)).first;
                while v != 0 {
                    let need = needs(cx, v, pcx);
                    if need != 0 && (e.bits & need) == 0 {
                        report(cx, out, f, e, v, need, pcx);
                        bad += 1;
                    }
                    v = (*cx.insts.add(v as usize)).next;
                }
            }
        }
        if bad > 0 {
            buf_write_fd(out, STDERR);
            exit(1);
        }
    }
}

// The effect bit instruction v needs (0: none it checks).
fn needs(cx: &mut FnCtx, v: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op == Op::Call {
            let g = (*cx.insts.add(v as usize)).imm;
            if !pcx.fns[g as usize].is_extern {
                return 0;
            }
            let ce = fn_effects(g, pcx);
            if (ce.bits & EFF_IO) != 0 {
                return EFF_IO;
            }
            if (ce.bits & EFF_ALLOC_EXTERN) != 0 {
                return EFF_ALLOC_EXTERN;
            }
            return 0;
        }
        if op == Op::CallC {
            let class = c_class((*cx.insts.add(v as usize)).imm);
            if class == C_IO || class == C_EXIT {
                return EFF_IO;
            }
            return if class == C_ALLOC { EFF_ALLOC_EXTERN } else { 0 };
        }
        if (op == Op::Store || op == Op::Copy) && into_static(cx, (*cx.insts.add(v as usize)).a, pcx) {
            return EFF_GLOBAL;
        }
        0
    }
}

// Whether address value a is a static's (its address, plus offsets).
fn into_static(cx: &mut FnCtx, a: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let mut v = a;
        while v != 0 {
            let op = (*cx.insts.add(v as usize)).op;
            if op == Op::GAddr {
                // (not --check-alloc's site, which the program does not see)
                return !get_check_alloc_mode() || (*cx.insts.add(v as usize)).imm != site_static(pcx);
            }
            if op != Op::Add {
                return false;
            }
            v = if (*cx.insts.add((*cx.insts.add(v as usize)).b as usize)).op == Op::Const { (*cx.insts.add(v as usize)).a } else { 0 };
        }
        false
    }
}

fn report(cx: &mut FnCtx, out: i64, f: i64, e: Effects, v: i64, need: i64, pcx: &Ctx<Comp>) {
    unsafe {
        buf_str(out, c"internal error: --verify-effects: '");
        buf_bytes(out, sym_text(pcx.fns[f as usize].display, pcx));
        buf_str(out, if need == EFF_IO { c"' calls C that does io" }
            else if need == EFF_GLOBAL { c"' stores into a static" }
            else { c"' calls C that allocates" });
        if (*cx.insts.add(v as usize)).op == Op::Call {
            buf_str(out, c" ('");
            buf_bytes(out, sym_text(pcx.fns[(*cx.insts.add(v as usize)).imm as usize].name, pcx));
            buf_str(out, c"')");
        }
        buf_str(out, c", but its effects are '");
        effects_text(out, e, pcx);
        buf_str(out, c"'\n");
    }
}
