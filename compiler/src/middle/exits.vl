// Counted loops out of loops with several exits, and equal induction
// variables merged (0.14), before rotation (opt.vl's optimize_loops).
//
// A loop whose header, and the blocks that follow it alone, test several
// exits to one block, each a comparison of an induction variable with an
// invariant, runs as many times as the smallest of their trip counts:
// `loop { match it.next() { .. } }` over `take(n)` of a slice iterator
// becomes, once threaded (tags.vl), a header testing n != 0, then
// pos < len. The trip counts are computed in the preheader (as unsigned
// numbers), their minimum T, and the loop gets a new induction variable c
// from 0: the first test becomes c != T, the others are always true. The
// loop then has one exit, which rotation and SCEV count and the
// vectorizer takes. The blocks between the first test and the last have
// no effects (the last iteration skips them), and the exit block's phis
// take one value from all the tests.
//
// Two header phis with the same start and the same constant step are one
// induction variable (an index counted twice, as enumerate and zip over
// `next` do, or the counter above beside the slice position).

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_BOOL, TY_I64, TY_U64, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::ipo::has_effect;
use crate::middle::ir::{
    Cond, Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_make, ir_prepend, ir_replace,
    ir_val,
};
use crate::middle::ir::cfg::pred_index;
use crate::middle::loops::{
    canonicalize_loops, invariant_in, loop_contains, loop_count, loop_header, loop_latch,
    loop_preheader,
};
use crate::middle::opt::resolve_all;
use crate::middle::range::bits_of_value;
use crate::middle::scev::{append_const, append_inst, iv_start, iv_step};

const COUNT_STRIDE: i64 = 5;
// At most this many tests in a chain.
const MAX_TESTS: i64 = 8;

// The induction variable value x is (a header phi of loop l, plus a
// constant): the phi in *phi, the constant in *offset; false when x is not
// one with a step of 1 or -1 (in *step) and 64 bits.
fn affine_iv(cx: &mut FnCtx<Comp>, l: i64, x: i64, phi: &mut i64, offset: &mut i64, step: &mut i64) -> bool {
    unsafe {
        let mut v = bits_of_value(cx, x);
        let mut c: i64 = 0;
        for _ in 0..4 {
            if (*cx.insts.add(v as usize)).op == Op::Phi {
                break;
            }
            let op = (*cx.insts.add(v as usize)).op;
            if op != Op::Add && op != Op::Sub {
                return false;
            }
            let a = bits_of_value(cx, (*cx.insts.add(v as usize)).a);
            let b = bits_of_value(cx, (*cx.insts.add(v as usize)).b);
            if is_const(cx, b) {
                c = if op == Op::Add { c + (*cx.insts.add(b as usize)).imm }
                    else { c - (*cx.insts.add(b as usize)).imm };
                v = a;
            } else if op == Op::Add && is_const(cx, a) {
                c += (*cx.insts.add(a as usize)).imm;
                v = b;
            } else {
                return false;
            }
        }
        let mut s: i64 = 0;
        if (*cx.insts.add(v as usize)).op != Op::Phi
            || (*cx.insts.add(v as usize)).block != loop_header(cx, l)
            || !is_integer((*cx.insts.add(v as usize)).ty)
            || int_bits((*cx.insts.add(v as usize)).ty) != 64 || !iv_step(cx, l, v, &mut s)
            || (s != 1 && s != -1) {
            return false;
        }
        *phi = v;
        *offset = c;
        *step = s;
        true
    }
}

// Records the test of block b's branch (`stay` is true when the loop goes
// on along s0): x <cond> bound, x an induction variable. False when it is
// not a test that has a trip count.
fn record_test(cx: &mut FnCtx<Comp>, l: i64, b: i64, stay_s0: bool) -> bool {
    unsafe {
        let c = ir_val(cx, (*cx.blocks.add(b as usize)).cond);
        if (*cx.insts.add(c as usize)).op != Op::Cmp
            || !is_integer((*cx.insts.add(c as usize)).imm2)
            || int_bits((*cx.insts.add(c as usize)).imm2) != 64 {
            return false;
        }
        let mut cond = (*cx.insts.add(c as usize)).cond;
        let mut x = ir_val(cx, (*cx.insts.add(c as usize)).a);
        let mut n = bits_of_value(cx, (*cx.insts.add(c as usize)).b);
        if !invariant_in(cx, l, n) {
            n = bits_of_value(cx, (*cx.insts.add(c as usize)).a);
            x = ir_val(cx, (*cx.insts.add(c as usize)).b);
            cond = cond.mirror();
        }
        if !invariant_in(cx, l, n) {
            return false;
        }
        if !stay_s0 {
            cond = cond.negate();
        }
        let mut phi: i64 = 0;
        let mut offset: i64 = 0;
        let mut step: i64 = 0;
        if !affine_iv(cx, l, x, &mut phi, &mut offset, &mut step) {
            return false;
        }
        // (the condition to stay: x != n either way; x < n going up; x > n
        // going down; signedness from the comparison)
        let ok = cond == Cond::Ne || (cond == Cond::Lt && step == 1)
            || (cond == Cond::Gt && step == -1);
        if !ok {
            return false;
        }
        cx.tests.push(b);
        cx.tests.push(phi);
        cx.tests.push(offset);
        cx.tests.push(n);
        // cond, and the comparison's signedness
        cx.tests.push(cond as i64 * 2 + if is_signed((*cx.insts.add(c as usize)).imm2) { 1 }
            else { 0 });
        true
    }
}

// The number of iterations test k lets the loop run (an unsigned 64-bit
// value), computed at the end of block pre.
fn trip_count(cx: &mut FnCtx<Comp>, l: i64, k: i64, pre: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let phi = (cx.tests[(COUNT_STRIDE * k + 1) as usize]);
        let offset = (cx.tests[(COUNT_STRIDE * k + 2) as usize]);
        let n = (cx.tests[(COUNT_STRIDE * k + 3) as usize]);
        let code = (cx.tests[(COUNT_STRIDE * k + 4) as usize]);
        let signed = (code & 1) != 0;
        let cond = code / 2;
        let mut start = iv_start(cx, l, phi);
        if offset != 0 {
            let append_const_v = append_const(cx, pre, offset, TY_I64, pcx);
            start = append_inst(cx, pre, Op::Add, TY_I64, start,
                append_const_v, pcx);
        }
        if cond == Cond::Ne as i64 {
            let mut step: i64 = 0;
            iv_step(cx, l, phi, &mut step);
            return if step == 1 { append_inst(cx, pre, Op::Sub, TY_I64, n, start, pcx) }
                else { append_inst(cx, pre, Op::Sub, TY_I64, start, n, pcx) };
        }
        // x < n going up: n - start when start < n, else 0 (x > n down: the
        // mirror).
        let lt = cond == Cond::Lt as i64;
        let a = if lt { start } else { n };
        let b = if lt { n } else { start };
        let diff = append_inst(cx, pre, Op::Sub, TY_I64, b, a, pcx);
        let enter = append_cmp(cx, pre, Cond::Lt, if signed { TY_I64 } else { TY_U64 }, a, b,
            pcx);
        and_mask(cx, pre, diff, enter, pcx)
    }
}

// v when bool `keep` holds, else 0 (no branch: v & -keep).
fn and_mask(cx: &mut FnCtx<Comp>, b: i64, v: i64, keep: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let wide = ir_make(cx, Op::Conv, TY_I64, keep, 0, 0, pcx);
        (*cx.insts.add(wide as usize)).imm2 = TY_BOOL;
        ir_append(cx, b, wide);
        let mask = append_inst(cx, b, Op::Neg, TY_I64, wide, 0, pcx);
        append_inst(cx, b, Op::And, TY_I64, v, mask, pcx)
    }
}

// The smaller of unsigned x and y: y ^ ((x ^ y) & -(x < y)).
fn umin(cx: &mut FnCtx<Comp>, b: i64, x: i64, y: i64, pcx: &Ctx<Comp>) -> i64 {
    let less = append_cmp(cx, b, Cond::Lt, TY_U64, x, y, pcx);
    let diff = append_inst(cx, b, Op::Xor, TY_I64, x, y, pcx);
    let and_mask_v = and_mask(cx, b, diff, less, pcx);
    append_inst(cx, b, Op::Xor, TY_I64, y, and_mask_v, pcx)
}

fn append_cmp(cx: &mut FnCtx<Comp>, b: i64, cond: Cond, ty: i64, x: i64, y: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let v = ir_make(cx, Op::Cmp, TY_BOOL, x, y, 0, pcx);
        (*cx.insts.add(v as usize)).cond = cond;
        (*cx.insts.add(v as usize)).imm2 = ty;
        ir_append(cx, b, v);
        v
    }
}

// The block an exit edge leads to: past an exit block of the loop's own
// (canonical form gives each exiting edge one) holding only phis of one
// operand and a jump.
fn forward(cx: &mut FnCtx<Comp>, out: i64) -> i64 {
    unsafe {
        if (*cx.blocks.add(out as usize)).term != Term::Jump
            || (*cx.blocks.add(out as usize)).preds.len() as i64 != 1 {
            return out;
        }
        let mut v = (*cx.blocks.add(out as usize)).first;
        while v != 0 {
            if (*cx.insts.add(v as usize)).op != Op::Phi || (*cx.insts.add(v as usize)).nargs != 1 {
                return out;
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        (*cx.blocks.add(out as usize)).s0
    }
}

// The value phi x (of the exit) takes when the loop leaves from test block
// t through its exit block `out`.
fn value_from(cx: &mut FnCtx<Comp>, x: i64, t: i64, out: i64) -> i64 {
    unsafe {
        let exit = (*cx.insts.add(x as usize)).block;
        if out == exit {
            let pred_index_v = pred_index(cx, exit, t);
            let ir_arg_v = ir_arg(cx, x, pred_index_v);
            return ir_val(cx, ir_arg_v);
        }
        let pred_index_v1 = pred_index(cx, exit, out);
        let ir_arg_v1 = ir_arg(cx, x, pred_index_v1);
        let w = ir_val(cx, ir_arg_v1);
        if (*cx.insts.add(w as usize)).op == Op::Phi
            && (*cx.insts.add(w as usize)).block
            == out { let ir_arg_v2 = ir_arg(cx, w, 0); ir_val(cx, ir_arg_v2) }
        else { w }
    }
}

// Loop l with several counted exits at its top made a counted loop (see
// the header). Returns whether it was.
fn merge_exits(cx: &mut FnCtx<Comp>, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let pre = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        if pre == 0 || latch == 0 {
            return false;
        }
        cx.tests.clear();
        cx.outs.clear();
        let mut exit: i64 = 0;
        let mut b = h;
        for _ in 0..MAX_TESTS {
            if (*cx.blocks.add(b as usize)).term != Term::Branch {
                break;
            }
            let s0 = (*cx.blocks.add(b as usize)).s0;
            let s1 = (*cx.blocks.add(b as usize)).s1;
            let in0 = loop_contains(cx, l, s0);
            if in0 == loop_contains(cx, l, s1) {
                break;
            }
            let out = if in0 { s1 } else { s0 };
            let next = if in0 { s0 } else { s1 };
            if exit != 0 && forward(cx, out) != exit {
                break;
            }
            if b != h && !no_effects(cx, b, pcx) {
                break;
            }
            if !record_test(cx, l, b, in0) {
                break;
            }
            exit = forward(cx, out);
            cx.outs.push(out);
            if next == h || (*cx.blocks.add(next as usize)).preds.len() as i64 != 1 {
                break;
            }
            b = next;
        }
        let count = cx.tests.len() as i64 / COUNT_STRIDE;
        if count < 2 {
            return false;
        }
        // The exit's phis take one value from every test.
        let mut x = (*cx.blocks.add(exit as usize)).first;
        while x != 0 && (*cx.insts.add(x as usize)).op == Op::Phi {
            let first = value_from(cx, x, h, (cx.outs[0]));
            for k in 1..count {
                if value_from(cx, x, (cx.tests[(COUNT_STRIDE * k) as usize]),
                    (cx.outs[k as usize])) != first {
                    return false;
                }
            }
            x = (*cx.insts.add(x as usize)).next;
        }
        // T, the smallest trip count.
        let mut trips = trip_count(cx, l, 0, pre, pcx);
        for k in 1..count {
            let trip_count_v = trip_count(cx, l, k, pre, pcx);
            trips = umin(cx, pre, trips, trip_count_v, pcx);
        }
        // c: 0, 1, ... with c != T the first test, the others true.
        let zero = append_const(cx, pre, 0, TY_I64, pcx);
        let c = ir_make(cx, Op::Phi, TY_I64, 0, 0, 0, pcx);
        (*cx.insts.add(c as usize)).args = cx.args.len() as i64;
        (*cx.insts.add(c as usize)).nargs = (*cx.blocks.add(h as usize)).preds.len() as i64;
        let one = append_const(cx, latch, 1, TY_I64, pcx);
        let next = append_inst(cx, latch, Op::Add, TY_I64, c, one, pcx);
        for k in 0..(*cx.blocks.add(h as usize)).preds.len() as i64 {
            cx.args.push(if ((*cx.blocks.add(h as usize)).preds[k as usize])
                == pre { zero } else { next });
            cx.argty.push(0);
        }
        ir_prepend(cx, h, c);
        let stay_s0 = loop_contains(cx, l, (*cx.blocks.add(h as usize)).s0);
        (*cx.blocks.add(h as usize)).cond = append_cmp(cx, h,
            if stay_s0 { Cond::Ne } else { Cond::Eq }, TY_I64, c, trips, pcx);
        for k in 1..count {
            let t = (cx.tests[(COUNT_STRIDE * k) as usize]);
            let stay = loop_contains(cx, l, (*cx.blocks.add(t as usize)).s0);
            (*cx.blocks.add(t as usize)).cond = append_const(cx, t, if stay { 1 } else { 0 },
                TY_BOOL, pcx);
        }
        true
    }
}

// Whether block b's instructions have no effects (they may be skipped).
fn no_effects(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            if has_effect(cx, v, pcx) {
                return false;
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        true
    }
}

// Merges the header phis of loop l that are one induction variable: the
// same start, the same constant step. Returns whether any was.
fn merge_equal_ivs(cx: &mut FnCtx<Comp>, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        if loop_preheader(cx, l) == 0 || loop_latch(cx, l) == 0 {
            return false;
        }
        let mut changed = false;
        let mut p = (*cx.blocks.add(h as usize)).first;
        while p != 0 && (*cx.insts.add(p as usize)).op == Op::Phi {
            let mut s1: i64 = 0;
            if ir_val(cx, p) == p && is_integer((*cx.insts.add(p as usize)).ty)
                && iv_step(cx, l, p, &mut s1) {
                let start = iv_start(cx, l, p);
                let mut q = (*cx.insts.add(p as usize)).next;
                while q != 0 && (*cx.insts.add(q as usize)).op == Op::Phi {
                    let mut s2: i64 = 0;
                    let arg_v = ir_val(cx, q) == q
                        && (*cx.insts.add(q as usize)).ty == (*cx.insts.add(p as usize)).ty
                        && iv_step(cx, l, q, &mut s2) && s1 == s2;
                    if arg_v
                        && { let at_arg1 = iv_start(cx, l, q); same_value(cx, at_arg1, start) } {
                        ir_replace(cx, q, p);
                        changed = true;
                    }
                    q = (*cx.insts.add(q as usize)).next;
                }
            }
            p = (*cx.insts.add(p as usize)).next;
        }
        changed
    }
}

// Whether a and b are one value (or equal constants).
fn same_value(cx: &mut FnCtx<Comp>, a: i64, b: i64) -> bool {
    unsafe {
        a == b
            || (is_const(cx, a) && is_const(cx, b)
                && (*cx.insts.add(a as usize)).imm == (*cx.insts.add(b as usize)).imm
                && (*cx.insts.add(a as usize)).ty == (*cx.insts.add(b as usize)).ty)
    }
}

// Both, on every loop of function fi (canonical form first). Returns
// whether anything changed.
pub fn count_loop_exits(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        canonicalize_loops(cx, fi, pcx);
        let mut changed = false;
        for l in 0..loop_count(cx) {
            if loop_header(cx, l) == (*get_irfuncs().add(fi as usize)).entry {
                continue;
            }
            if merge_equal_ivs(cx, l) {
                changed = true;
                resolve_all(cx, fi);
            }
            if merge_exits(cx, l, pcx) {
                changed = true;
                resolve_all(cx, fi);
                if merge_equal_ivs(cx, l) {
                    resolve_all(cx, fi);
                }
            }
        }
        changed
    }
}
