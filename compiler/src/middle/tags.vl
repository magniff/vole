// Jump threading on constant tags (0.14): a block whose switch decides on
// a phi (a `match` on an enum's tag), or whose branch compares one with a
// constant (`if let`), is copied for each predecessor that gives the phi a
// constant, and the copy goes on to that constant's outcome directly. This
// is what makes `loop { match it.next() { Some(x) => .., None => break } }`
// a plain loop once `next` is inlined: each return of `next` built its tag
// as a constant. A block holding only phis that jumps to such a block, with
// the tag's phi among them, is merged into it first (what the arms of an
// `if` leave). The values the block defines are then read, where they are
// used, through the SSA updater (as rotation does, loops.vl), and a
// block no predecessor is left to is removed. A loop header threaded from
// its latch is peeled: the first iteration keeps the test, the copy is the
// new header.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{fold_compare, is_const};
use crate::middle::ir::{
    Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_make, ir_new_block, ir_operand,
    ir_operand_count, ir_set_arg, ir_set_operand, ir_val,
};
use crate::middle::ir::cfg::{pred_index, redirect_succ, switch_target};
use crate::middle::loops::{clone_inst, seal_all};
use crate::middle::lower::ssa::{new_synth_var, ssa_read, ssa_write};
use crate::middle::opt::{
    add_pred_like, remove_block, remove_pred_at, remove_trivial_phis, remove_unreachable,
    resolve_all,
};

// The blocks copied have at most this many instructions other than phis.
const THREAD_MAX_INSTS: i64 = 12;
// At most this many copies per call (a bound on growth).
const THREAD_MAX_COPIES: i64 = 64;

// At most this many blocks in a chain.
const MAX_CHAIN: i64 = 4;

// The phi that block j's terminator decides on, or 0: the switch's value,
// or an operand of the branch's comparison with a constant. The phi may be
// in an earlier block h, with j reached from h through blocks whose only
// predecessor is the one before (a loop's header testing its exit before
// the match): CHAIN is then h, those blocks, j. (0.16) Or the phi a branch
// is on, a bool (taken when it has a constant operand, see is_tag_phi).
fn decider_phi(cx: &mut FnCtx<Comp>, j: i64) -> i64 {
    let c = ir_val(cx, (cx.blocks[j as usize]).cond);
    if c == 0 || (cx.insts[c as usize]).block == 0 {
        return 0;
    }
    let mut phi: i64 = 0;
    if (cx.blocks[j as usize]).term == Term::Switch {
        if (cx.insts[c as usize]).op == Op::Phi {
            phi = c;
        }
    }
    else if (cx.blocks[j as usize]).term == Term::Branch
        && (cx.insts[c as usize]).op == Op::Cmp
        && (cx.blocks[j as usize]).s0 != (cx.blocks[j as usize]).s1 {
        let a = ir_val(cx, (cx.insts[c as usize]).a);
        let b = ir_val(cx, (cx.insts[c as usize]).b);
        if (cx.insts[a as usize]).op == Op::Phi && is_const(cx, b) {
            phi = a;
        } else if (cx.insts[b as usize]).op == Op::Phi && is_const(cx, a) {
            phi = b;
        }
    }
    else if (cx.blocks[j as usize]).term == Term::Branch
        && (cx.insts[c as usize]).op == Op::Phi
        && (cx.blocks[j as usize]).s0 != (cx.blocks[j as usize]).s1 {
        // (0.16) A branch on a phi of bools (a comparison of a phi of
        // constants with a constant, folded into the phi: fold.vl).
        phi = c;
    }
    if phi == 0 {
        return 0;
    }
    // The chain from the phi's block to j.
    let h = (cx.insts[phi as usize]).block;
    cx.chain.clear();
    let mut x = j;
    let mut size: i64 = 0;
    loop {
        cx.chain.push(x);
        size += body_size(cx, x);
        if x == h {
            break;
        }
        if cx.chain.len() as i64 > MAX_CHAIN
            || (cx.blocks[x as usize]).preds.len() as i64 != 1 {
            return 0;
        }
        x = ((cx.blocks[x as usize]).preds[0]);
        if x == j
            || (x != h && (cx.blocks[x as usize]).term != Term::Jump
                && (cx.blocks[x as usize]).term != Term::Branch)
            || ((cx.blocks[x as usize]).term == Term::Branch
                && (cx.blocks[x as usize]).s0 == (cx.blocks[x as usize]).s1) {
            return 0;
        }
    }
    if size > THREAD_MAX_INSTS || (h != j && (cx.blocks[h as usize]).term != Term::Jump
        && (cx.blocks[h as usize]).term != Term::Branch) {
        return 0;
    }
    // (h first)
    let n = cx.chain.len() as i64;
    for i in 0..n / 2 {
        let t = (cx.chain[i as usize]);
        (cx.chain[i as usize]) = (cx.chain[(n - 1 - i) as usize]);
        (cx.chain[(n - 1 - i) as usize]) = t;
    }
    // The comparison is in the chain.
    cx.tags_stamp += 1;
    for i in 0..n {
        { let at_ix = (cx.chain[i as usize]) as usize;
            (cx.blocks[at_ix]).mark = cx.tags_stamp };
    }
    if (cx.blocks[(cx.insts[c as usize]).block as usize]).mark != cx.tags_stamp {
        return 0;
    }
    phi
}

// The successor of block j when its decider phi is the constant `value`.
fn outcome(cx: &mut FnCtx<Comp>, j: i64, phi: i64, value: i64) -> i64 {
    if (cx.blocks[j as usize]).term == Term::Switch {
        return switch_target(cx, j, (cx.insts[value as usize]).imm);
    }
    let c = ir_val(cx, (cx.blocks[j as usize]).cond);
    if c == phi {
        return if (cx.insts[value as usize]).imm != 0 { (cx.blocks[j as usize]).s0 }
            else { (cx.blocks[j as usize]).s1 };
    }
    let a = ir_val(cx, (cx.insts[c as usize]).a);
    let b = ir_val(cx, (cx.insts[c as usize]).b);
    let x = if a == phi { (cx.insts[value as usize]).imm }
        else { (cx.insts[a as usize]).imm };
    let y = if b == phi { (cx.insts[value as usize]).imm }
        else { (cx.insts[b as usize]).imm };
    if fold_compare((cx.insts[c as usize]).cond, (cx.insts[c as usize]).imm2, x, y) {
        (cx.blocks[j as usize]).s0
    }
    else { (cx.blocks[j as usize]).s1 }
}

// The number of j's instructions other than phis.
fn body_size(cx: &mut FnCtx<Comp>, j: i64) -> i64 {
    let mut n: i64 = 0;
    let mut v = (cx.blocks[j as usize]).first;
    while v != 0 {
        if (cx.insts[v as usize]).op != Op::Phi {
            n += 1;
        }
        v = (cx.insts[v as usize]).next;
    }
    n
}

// Whether value w (a phi of block b) is used only by the phis of block j,
// as their operand for b.
fn used_only_by_phis(cx: &mut FnCtx<Comp>, fi: i64, w: i64, b: i64, j: i64) -> bool {
    unsafe {
        let index = pred_index(cx, j, b);
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let u_block = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[u_block as usize]).removed != 0 {
                continue;
            }
            if ir_val(cx, (cx.blocks[u_block as usize]).cond) == w
                && (cx.blocks[u_block as usize]).cond != 0 {
                return false;
            }
            let mut u = (cx.blocks[u_block as usize]).first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    let ir_operand_v = ir_operand(cx, u, k);
                    let ir_val_v = ir_val(cx, ir_operand_v);
                    if ir_val_v == w {
                        // (a phi's operands are 3.., one per predecessor)
                        if u_block != j || (cx.insts[u as usize]).op != Op::Phi
                            || k - 3 != index {
                            return false;
                        }
                    }
                }
                u = (cx.insts[u as usize]).next;
            }
        }
        true
    }
}

// Merges block b (phis only, then a jump to j) into j: b's predecessors go
// to j, whose phis take, for each, what they took from b (a phi of b: its
// operand for that predecessor). Returns whether it did.
pub fn merge_phi_block(cx: &mut FnCtx<Comp>, fi: i64, b: i64, j: i64) -> bool {
    unsafe {
        if b == j || b == (*get_irfuncs().add(fi as usize)).entry
            || (cx.blocks[b as usize]).term != Term::Jump
            || (cx.blocks[b as usize]).preds.len() as i64 == 0 {
            return false;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op != Op::Phi || !used_only_by_phis(cx, fi, v, b, j) {
                return false;
            }
            v = (cx.insts[v as usize]).next;
        }
        for i in 0..(cx.blocks[b as usize]).preds.len() as i64 {
            let q = ((cx.blocks[b as usize]).preds[i as usize]);
            if q == b || pred_index(cx, j, q) >= 0 {
                return false;
            }
        }
        let index = pred_index(cx, j, b);
        for i in 0..(cx.blocks[b as usize]).preds.len() as i64 {
            let q = ((cx.blocks[b as usize]).preds[i as usize]);
            redirect_succ(cx, q, b, j);
            add_pred_like(cx, j, q, b);
            // The new operands: a phi of b gives its operand for q.
            let at = (cx.blocks[j as usize]).preds.len() as i64 - 1;
            let mut phi = (cx.blocks[j as usize]).first;
            while phi != 0 && (cx.insts[phi as usize]).op == Op::Phi {
                let ir_arg_v = ir_arg(cx, phi, index);
                let w = ir_val(cx, ir_arg_v);
                if (cx.insts[w as usize]).block == b {
                    let ir_arg_v1 = ir_arg(cx, w, i);
                    let ir_val_v = ir_val(cx, ir_arg_v1);
                    ir_set_arg(cx, phi, at, ir_val_v);
                }
                phi = (cx.insts[phi as usize]).next;
            }
        }
        (cx.blocks[b as usize]).preds.clear();
        remove_block(cx, b);
        true
    }
}

// Copies the chain (CHAIN) for the predecessor at `index` of its first
// block, whose operand of the decider phi is a constant: the copies (their
// phis with one operand each, their instructions, their terminators, the
// last a jump to the outcome `target`) take that predecessor's edge. Each
// value of the chain gets its copy's value as a definition in the copy
// (INSTS[v].mark is v's updater variable + 1).
fn copy_chain(cx: &mut FnCtx<Comp>, index: i64, target: i64, pcx: &Ctx<Comp>) {
    let h = (cx.chain[0]);
    let p = ((cx.blocks[h as usize]).preds[index as usize]);
    let first = cx.copy_of.len() as i64;
    for i in 0..cx.chain.len() as i64 {
        let nb = ir_new_block(cx);
        (cx.blocks[nb as usize]).sealed = 1;
        (cx.blocks[nb as usize]).count = -1;
        cx.copy_of.push(nb);
    }
    for i in 0..cx.chain.len() as i64 {
        let x = (cx.chain[i as usize]);
        let nb = (cx.copy_of[(first + i) as usize]);
        let mut v = (cx.blocks[x as usize]).first;
        while v != 0 {
            let mut nv: i64 = 0;
            if (cx.insts[v as usize]).op == Op::Phi {
                nv = ir_make(cx, Op::Phi, (cx.insts[v as usize]).ty, 0, 0, 0, pcx);
                (cx.insts[nv as usize]).args = cx.args.len() as i64;
                (cx.insts[nv as usize]).nargs = 1;
                let ir_arg_v = ir_arg(cx, v, if x == h { index } else { 0 });
                let w = ir_val(cx, ir_arg_v);
                let arg_v = if x != h && in_chain(cx, w) { (cx.insts[w as usize]).aux }
                    else { w };
                cx.args.push(arg_v);
                cx.argty.push(0);
            } else {
                nv = clone_inst(cx, v, pcx);
                for k in 0..ir_operand_count(cx, nv) {
                    let ir_operand_v = ir_operand(cx, nv, k);
                    let w = ir_val(cx, ir_operand_v);
                    if in_chain(cx, w) {
                        ir_set_operand(cx, nv, k, (cx.insts[w as usize]).aux);
                    }
                }
            }
            ir_append(cx, nb, nv);
            (cx.insts[v as usize]).aux = nv;
            ssa_write(cx, (cx.insts[v as usize]).mark - 1, nb, nv);
            v = (cx.insts[v as usize]).next;
        }
        if i + 1 == cx.chain.len() as i64 {
            (cx.blocks[nb as usize]).term = Term::Jump;
            (cx.blocks[nb as usize]).s0 = target;
            add_pred_like(cx, target, nb, x);
        } else {
            // The terminator: to the next block's copy, or out of the
            // chain as x goes.
            let next = (cx.chain[(i + 1) as usize]);
            let c = ir_val(cx, (cx.blocks[x as usize]).cond);
            (cx.blocks[nb as usize]).term = (cx.blocks[x as usize]).term;
            (cx.blocks[nb as usize]).cond = if in_chain(cx, c) {
                (cx.insts[c as usize]).aux
            }
                else { (cx.blocks[x as usize]).cond };
            for e in 0..2 {
                let s = if e == 0 { (cx.blocks[x as usize]).s0 }
                    else { (cx.blocks[x as usize]).s1 };
                if s == 0 {
                    continue;
                }
                let ns = if s == next { (cx.copy_of[(first + i + 1) as usize]) }
                    else { s };
                if e == 0 {
                    (cx.blocks[nb as usize]).s0 = ns;
                } else {
                    (cx.blocks[nb as usize]).s1 = ns;
                }
                if s == next {
                    (cx.blocks[ns as usize]).preds.push(nb);
                } else {
                    add_pred_like(cx, s, nb, x);
                }
            }
        }
    }
    let nh = (cx.copy_of[first as usize]);
    (cx.blocks[nh as usize]).preds.push(p);
    redirect_succ(cx, p, h, nh);
    remove_pred_at(cx, h, index);
    cx.copy_of.truncate(first as usize);
}

// Whether value w is defined in the chain being copied.
fn in_chain(cx: &mut FnCtx<Comp>, w: i64) -> bool {
    w != 0 && (cx.insts[w as usize]).block != 0
        && (cx.blocks[(cx.insts[w as usize]).block as usize]).mark == cx.tags_stamp
}

// Threads the chain ending in block j (see decider_phi): copies it for
// each predecessor of its first block giving the decider phi a constant,
// then repairs the uses of the chain's values. Returns the number of
// copies made.
fn thread_block(cx: &mut FnCtx<Comp>, fi: i64, j: i64, phi: i64, budget: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let h = (cx.chain[0]);
        // A predecessor holding only phis, one of them the tag, is merged
        // into h first.
        let mut k: i64 = 0;
        while k < (cx.blocks[h as usize]).preds.len() as i64 {
            let b = ((cx.blocks[h as usize]).preds[k as usize]);
            let ir_arg_v = ir_arg(cx, phi, k);
            let w = ir_val(cx, ir_arg_v);
            if (cx.insts[w as usize]).op == Op::Phi && (cx.insts[w as usize]).block == b
                && (cx.blocks[b as usize]).first != 0 && has_const_operand(cx, w)
                && (cx.blocks[b as usize]).mark != cx.tags_stamp
                && merge_phi_block(cx, fi, b, h) {
                k = 0;
                continue;
            }
            k += 1;
        }
        // (pred, outcome) pairs to copy for.
        cx.tags_copies.clear();
        for i in 0..(cx.blocks[h as usize]).preds.len() as i64 {
            let p = ((cx.blocks[h as usize]).preds[i as usize]);
            let ir_arg_v1 = ir_arg(cx, phi, i);
            let w = ir_val(cx, ir_arg_v1);
            if !is_const(cx, w) || (cx.blocks[p as usize]).mark == cx.tags_stamp
                || ((cx.blocks[p as usize]).term == Term::Branch
                    && (cx.blocks[p as usize]).s0 == (cx.blocks[p as usize]).s1) {
                continue;
            }
            let t = outcome(cx, j, phi, w);
            if (cx.blocks[t as usize]).mark == cx.tags_stamp {
                continue;
            }
            cx.tags_copies.push(p);
            cx.tags_copies.push(t);
            if cx.tags_copies.len() as i64 / 2 >= budget {
                break;
            }
        }
        if cx.tags_copies.len() as i64 == 0 {
            return 0;
        }
        cx.defs.clear();
        seal_all(cx, fi);
        for i in 0..cx.chain.len() as i64 {
            let x = (cx.chain[i as usize]);
            let mut v = (cx.blocks[x as usize]).first;
            while v != 0 {
                let var_id = new_synth_var(cx, (cx.insts[v as usize]).ty, pcx);
                (cx.insts[v as usize]).mark = var_id + 1;
                ssa_write(cx, var_id, x, v);
                v = (cx.insts[v as usize]).next;
            }
        }
        let n = cx.tags_copies.len() as i64 / 2;
        for c in 0..n {
            let p = (cx.tags_copies[(2 * c) as usize]);
            let t = (cx.tags_copies[(2 * c + 1) as usize]);
            let pred_index_v = pred_index(cx, h, p);
            copy_chain(cx, pred_index_v, t, pcx);
        }
        // Every use of the chain's values reads the definition reaching it
        // (but in the block defining it: that one), phis in their
        // predecessors.
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut u = (cx.blocks[b as usize]).first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    let ir_operand_v = ir_operand(cx, u, k);
                    let w = ir_val(cx, ir_operand_v);
                    if w != 0 && (cx.insts[w as usize]).block != 0
                        && (cx.blocks[(cx.insts[w as usize]).block as usize]).mark
                        == cx.tags_stamp
                        && ((cx.insts[u as usize]).op == Op::Phi
                            || (cx.insts[w as usize]).block != b) {
                        let arg_v = (cx.insts[w as usize]).mark - 1;
                        let use_block_v = use_block(cx, u, k);
                        let ssa_read_v = ssa_read(cx, arg_v, use_block_v,
                            pcx);
                        ir_set_operand(cx, u, k,
                            ssa_read_v);
                    }
                }
                u = (cx.insts[u as usize]).next;
            }
            let c = ir_val(cx, (cx.blocks[b as usize]).cond);
            if (cx.blocks[b as usize]).cond != 0 && (cx.insts[c as usize]).block != 0
                && (cx.blocks[(cx.insts[c as usize]).block as usize]).mark
                == cx.tags_stamp
                && (cx.insts[c as usize]).block != b {
                (cx.blocks[b as usize]).cond = ssa_read(cx,
                    (cx.insts[c as usize]).mark - 1, b, pcx);
            }
        }
        for i in 0..cx.chain.len() as i64 {
            let mut v = (cx.blocks[(cx.chain[i as usize]) as usize]).first;
            while v != 0 {
                (cx.insts[v as usize]).mark = 0;
                v = (cx.insts[v as usize]).next;
            }
        }
        n
    }
}

// Whether phi w has a constant operand.
fn has_const_operand(cx: &mut FnCtx<Comp>, w: i64) -> bool {
    for k in 0..(cx.insts[w as usize]).nargs {
        let ir_arg_v = ir_arg(cx, w, k);
        let ir_val_v = ir_val(cx, ir_arg_v);
        if is_const(cx, ir_val_v) {
            return true;
        }
    }
    false
}

// The block where a use of an operand happens: the block of instruction u,
// or for a phi's k-th operand, the k-th predecessor of the phi's block.
fn use_block(cx: &mut FnCtx<Comp>, u: i64, k: i64) -> i64 {
    if (cx.insts[u as usize]).op == Op::Phi && k >= 3 {
        return (
            (cx.blocks[(cx.insts[u as usize]).block as usize]).preds[
                (k - 3) as usize]);
    }
    (cx.insts[u as usize]).block
}

// Threads the blocks of function fi that decide on constant tags. Returns
// whether any was.
pub fn thread_tags(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        let mut budget = THREAD_MAX_COPIES;
        let mut changed = false;
        let mut i: i64 = 0;
        while i < (*get_irfuncs().add(fi as usize)).blocks.len() as i64 && budget > 0 {
            let j = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            i += 1;
            if (cx.blocks[j as usize]).removed != 0
                || j == (*get_irfuncs().add(fi as usize)).entry
                || body_size(cx, j) > THREAD_MAX_INSTS {
                continue;
            }
            let phi = decider_phi(cx, j);
            if phi == 0 || !is_tag_phi(cx, phi) {
                continue;
            }
            let n = thread_block(cx, fi, j, phi, budget, pcx);
            if n > 0 {
                budget -= n;
                changed = true;
                resolve_all(cx, fi);
                remove_unreachable(cx, fi);
                remove_trivial_phis(cx, fi, pcx);
            }
        }
        changed
    }
}

// Whether phi is a tag: its operands are constants or phis (of the blocks
// merged first, see thread_block), one at least constant or a phi with a
// constant operand. (An induction variable, whose operand from the latch
// is arithmetic, is not one: rotation takes care of its loop.)
fn is_tag_phi(cx: &mut FnCtx<Comp>, phi: i64) -> bool {
    let mut any = false;
    for k in 0..(cx.insts[phi as usize]).nargs {
        let ir_arg_v = ir_arg(cx, phi, k);
        let w = ir_val(cx, ir_arg_v);
        if is_const(cx, w) {
            any = true;
        } else if (cx.insts[w as usize]).op == Op::Phi && w != phi {
            if has_const_operand(cx, w) {
                any = true;
            }
        } else {
            return false;
        }
    }
    any
}
