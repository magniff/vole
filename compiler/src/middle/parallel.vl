// (0.18.1) Code generation on several threads (docs/optimizer.md,
// "0.18.1: threads"). The per-function work of the middle and back end
// runs as tasks, on middle::threads' pool, each thread with its own
// FnCtx:
//
// - -O1 and -O2: each function's cleanup (`K_CLEANUP`); -O2: its scalar
//   pipeline before interprocedural constants (`K_SIMPLIFY`);
// - -O2: the call graph's components, bottom up (`K_COMPONENT`), a level
//   at a time: a component's level is above those of the components it
//   calls, since inlining reads them;
// - each function's emission (`K_EMIT`; -O1 optimizes it there, -O2 runs
//   its waiting loop passes and SLP there), into a text of its own.
//
// The output is the same whatever the number of threads, and the same as
// one thread's: a task reads only what is final when it starts (its own
// function; at -O2 the components of lower levels), and what tasks make
// for the program is joined in program order, between phases:
//
// - each function's text, with labels numbered from 1 (L\x01<n>), is
//   appended in program order with its labels renumbered (join_text);
// - constant data a task makes (SROA's tables) gets a placeholder id,
//   negative, and its id at the end of the phase, in the order one thread
//   would have made them (resolve_consts);
// - -O2's inlining budget and call counts are each component's view (the
//   program's after the lower levels, and what the component itself
//   inlined), not the shared counters of 0.17, which made the decisions
//   depend on the order components were done in.
//
// Modes that keep the program's state in statics or print as they go run
// on one thread (serial_only): -g, --time-passes (its clock is the
// process's), --stats, --verify-ir, the IR printers.

use std::alloc::Allocator;
use std::sync::{Mutex, MutexGuard};
use std::sync::atomic::{AtomicI64, Ordering};

use crate::host_target;
use crate::back::codecache::{
    R_STATIC, cc_component_begin, cc_component_end, cc_emit_begin, cc_emit_end, cc_note, cc_phase,
    cc_scalar_begin, cc_scalar_cleanup_end, cc_scalar_end, cc_scalar_simplify_begin,
};
use crate::back::emit::function::emit_task;
use crate::back::emit::machine::m_load_imm;
use crate::back::objfile::asm_flush;
use crate::base::{buf_append, buf_bytes, buf_clear, buf_int, cstr, die, sized_table};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_AARCH64_MACOS, T_X86_64_MACOS};
use crate::front::distinct::enum_niche;
use crate::front::lexer::{get_str_count, str_at};
use crate::front::types::compute_layout;
use crate::gen0::target::{add_const_data, rt_output};
use crate::middle::ctx::{FnCtx, main_cx};
use crate::middle::inline::{add_program_size, finish_component_function, ir_callee};
use crate::middle::ipo::infer_component_attrs;
use crate::middle::ir::{
    Op, fn_block, fn_block_count, ir_clear_marks, ir_enter, ir_release, ir_stored, rtid_class,
    rtid_value,
};
use crate::middle::opt::{cleanup_function, optimize_component_function, simplify_function};
use crate::middle::threads::{
    pool_context, pool_run, pool_run_joined, pool_start, pool_stop, processors,
};

// ---- Options ----

// The default -j: the processors, at most 8 (more threads than the
// machine's fast cores gain little: docs/optimizer.md, "0.18.1").
pub fn default_jobs() -> i64 {
    let host = host_target();
    let n = processors(host == T_AARCH64_MACOS || host == T_X86_64_MACOS);
    if n > 8 { 8 } else { n }
}

// The number in text s (-j's), or -1.
pub fn parse_jobs(s: &str) -> i64 {
    let mut n: i64 = 0;
    let mut i: usize = 0;
    let b = s.as_bytes();
    while i < b.len() && b[i] >= b'0' && b[i] <= b'9' && n < 100000 {
        n = n * 10 + (b[i] - b'0') as i64;
        i += 1;
    }
    if i == 0 || i < b.len() { -1 } else { n }
}

// Whether this compilation must run on one thread: a mode that keeps the
// program's state in statics or prints as it goes.
fn serial_only(pcx: &Ctx<Comp>) -> bool {
    pcx.debug_info || pcx.time_passes || pcx.stats > 0 || pcx.verify_ir || pcx.print_after_all
        || pcx.print_regalloc || pcx.verify_regalloc || pcx.print_checks != 0 as *mut u8
        || pcx.vec_stats_fn != 0 as *mut u8
}

// The threads for a program of `functions` functions to compile: -j's;
// by default fewer for a small program (a thread costs about as much as
// compiling a few small functions to start).
fn threads_for(functions: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n = if pcx.jobs > 0 { pcx.jobs } else { default_jobs() };
    if serial_only(pcx) {
        n = 1;
    }
    let most = functions / 16 + 1;
    if pcx.jobs == 0 && n > most {
        n = most;
    }
    if n < 1 { 1 } else { n }
}

// (0.18.1) Whether -O0 assembles on a thread of its own, beside code
// generation: when streaming (no -g, not -S) and more than one thread may
// be used.
pub fn assembler_thread_wanted(pcx: &Ctx<Comp>) -> bool {
    pcx.asm_stream && !serial_only(pcx)
        && (if pcx.jobs > 0 { pcx.jobs > 1 } else { default_jobs() > 1 })
}

// Starts the pool for the program's functions (main thread, before the
// first phase): the program's state the tasks only read is made first
// (prepare_tasks).
pub fn parallel_begin(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    prepare_tasks(cx, pcx);
    pcx.fn_consts.reset(pcx.irfunc_count + 1);
    pcx.fn_texts.reset(pcx.irfunc_count + 1);
    pcx.fresh_contexts = env_on("VOLE_FRESH_CONTEXTS");
    pool_start(threads_for(pcx.irfunc_count, pcx), pcx);
}

// The end of code generation: the workers stop.
pub fn parallel_end(pcx: &mut Ctx<Comp>) {
    pool_stop(pcx);
}

// (VOLE_PHASE_TIMES=1) The wall time since the last mark, on stderr,
// for phase `name`: --time-passes runs on one thread (its clock is the
// process's), this measures the threads' phases as they run.
pub fn phase_time(name: *mut u8, pcx: &mut Ctx<Comp>) {
    if pcx.phase_times == 0 {
        pcx.phase_times = if env_on("VOLE_PHASE_TIMES") { 1 } else { -1 };
        pcx.phase_mark = monotonic_ns();
    }
    if pcx.phase_times < 0 || name == 0 as *mut u8 {
        return;
    }
    let now = monotonic_ns();
    let ms = (now - pcx.phase_mark) / 100000;
    pcx.phase_mark = now;
    eprintln("{}.{} ms\t{}", ms / 10, ms % 10, str::from_utf8(&cstr(name)).unwrap());
}

// Whether environment variable `name` is set to a text that begins with 1.
fn env_on(name: &str) -> bool {
    match std::env::var_in(name, Comp {}) {
        Ok(v) => v.as_bytes().len() > 0 && v.as_bytes()[0] == b'1',
        Err(_) => false,
    }
}

// Nanoseconds of the monotonic clock.
fn monotonic_ns() -> i64 {
    std::time::Instant::now().as_nanos() as i64
}

// (0.18.1) --vec-stats's counts (0 vector loops, 1 overlap tests, 2 tests
// the facts dropped), summed over the contexts that made them.
pub fn vec_stat(k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // UNSAFE: the function contexts are kept as raw pointers (the main
    // one in the compilation context, the threads' in the pool: run_task
    // says why).
    // SAFETY: main_cx makes the main context when there is none, and a
    // pool context is checked for null; none is ever freed. The one
    // caller is main.vl's build, on the main thread after compile_program
    // returned: the phases are over and pool_stop has joined the workers,
    // so no task uses a context, and each `&mut` ends with its call.
    unsafe {
        let mut n = vec_stat_of(&mut *main_cx(pcx), k);
        for i in 0..pcx.pool_contexts {
            let cx = pool_context(i, pcx);
            if cx != 0 as *mut FnCtx<Comp> {
                n += vec_stat_of(&mut *cx, k);
            }
        }
        n
    }
}

fn vec_stat_of(cx: &mut FnCtx<Comp>, k: i64) -> i64 {
    if k == 0 { cx.vec_loops } else if k == 1 { cx.vec_tests } else { cx.vec_skipped }
}

// ---- Constant data ----

// Constant data a task made for function `owner` (sroa.vl's constant
// slots): its bytes, alignment, where it was made (phase and rank: the
// order one thread makes them in) and its id once numbered (-1 before).
struct PendingConst<A: Allocator> {
    data: Vec<u8, A>, align: i64, phase: i64, rank: i64, id: i64,
}

// (0.29) Per IR function, the constant data made while it was optimized,
// in the compilation context: each function's list behind a lock of its
// own. List fi is appended by the task that has fi (const_data's callers
// pass the pass's own fi); another function's task reads the entries made
// before its phase (a placeholder of g reaches another function's IR only
// by inlining g's IR: g of a finished lower level, or an -O1 small leaf,
// whose constants are made serially and have real ids); the main thread
// numbers them between phases (resolve_consts) and at the join
// (number_consts, for the joined function, whose task is done). A lock is
// held for one push or one read, so the table is used through `&` in safe
// code.
pub struct ConstLists<A: Allocator> {
    v: Vec<Mutex<Vec<PendingConst<A>, A>>, A>,
}

pub fn const_lists() -> ConstLists<Comp> {
    ConstLists { v: Vec::new_in(Comp {}) }
}

impl ConstLists<Comp> {
    // n lists, each empty (main thread, before the pool starts).
    pub fn reset(&mut self, n: i64) {
        self.v.clear();
        for i in 0..n {
            self.v.push(Mutex::new(Vec::new_in(Comp {})));
        }
    }
}

// The most constant data one function's tasks make.
const MAX_CONSTS: i64 = 65536;

pub const OWNER_SHIFT: i64 = 20;

// The function that made placeholder `id`, and its place in that
// function's list.
fn const_owner(id: i64) -> usize {
    ((-id - 1) >> OWNER_SHIFT) as usize
}

fn const_index(id: i64) -> usize {
    ((-id - 1) & ((1 << OWNER_SHIFT) - 1)) as usize
}

// The id of constant data `bytes` made by function fi's pipeline: in
// serial code its id (gen0::add_const_data); in a task a placeholder,
// -(1 + fi << OWNER_SHIFT + k), numbered at the end of the phase.
pub fn const_data(cx: &mut FnCtx<Comp>, fi: i64, bytes: &[u8], align: i64, pcx: &Ctx<Comp>) -> i64 {
    if cx.task_phase == 0 {
        return add_const_data(bytes, align, pcx);
    }
    let mut list = pcx.fn_consts.v[fi as usize].lock().unwrap();
    let k = list.len() as i64;
    if k == MAX_CONSTS {
        die(c"internal error: a function makes too much constant data");
    }
    let mut data: Vec<u8, Comp> = Vec::new_in(Comp {});
    data.extend_from_slice(bytes);
    list.push(PendingConst { data, align, phase: cx.task_phase, rank: cx.task_rank, id: -1 });
    -(1 + (fi << OWNER_SHIFT) + k)
}

// The id of string or constant data `id` (a placeholder's once numbered;
// -1 before).
pub fn const_data_id(id: i64, pcx: &Ctx<Comp>) -> i64 {
    if id >= 0 {
        return id;
    }
    let list = pcx.fn_consts.v[const_owner(id)].lock().unwrap();
    (*list)[const_index(id)].id
}

// The `size` bytes (at most 8) at `offset` of string or constant data
// `id`, as a little-endian number; None when they are not all within it.
pub fn const_data_word(id: i64, offset: i64, size: i64, pcx: &Ctx<Comp>) -> Option<u64> {
    if id >= 0 {
        return word_at(str_at(id, pcx), offset, size);
    }
    let list = pcx.fn_consts.v[const_owner(id)].lock().unwrap();
    word_at((*list)[const_index(id)].data.as_slice(), offset, size)
}

fn word_at(bytes: &[u8], offset: i64, size: i64) -> Option<u64> {
    if size > 8 || offset < 0 || offset + size > bytes.len() as i64 {
        return Option::None;
    }
    let mut bits: u64 = 0;
    for i in 0..size {
        bits |= (bytes[(offset + i) as usize] as u64) << (8 * i) as u64;
    }
    Option::Some(bits)
}

// (back::codecache) The bytes of constant data `id` a task made (a
// placeholder), added to `out`.
pub fn const_data_copy(id: i64, out: &mut Vec<u8, Comp>, pcx: &Ctx<Comp>) {
    let list = pcx.fn_consts.v[const_owner(id)].lock().unwrap();
    out.extend_from_slice((*list)[const_index(id)].data.as_slice());
}

// (0.18.1, back::codecache) The alignment of constant data `id` a task
// made (a placeholder).
pub fn const_data_align(id: i64, pcx: &Ctx<Comp>) -> i64 {
    let list = pcx.fn_consts.v[const_owner(id)].lock().unwrap();
    (*list)[const_index(id)].align
}

// (back::codecache) The constant data function fi's tasks made so far
// (its own task, or a phase after).
pub fn const_data_count(fi: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.fn_consts.v[fi as usize].lock().unwrap().len() as i64
}

// (back::codecache) Function fi's k-th constant data: its bytes added to
// `out`, and its phase, rank and alignment in *phase, *rank, *align.
pub fn const_data_entry(fi: i64, k: i64, phase: &mut i64, rank: &mut i64, align: &mut i64,
    out: &mut Vec<u8, Comp>, pcx: &Ctx<Comp>) {
    let list = pcx.fn_consts.v[fi as usize].lock().unwrap();
    let p = &(*list)[k as usize];
    *phase = p.phase;
    *rank = p.rank;
    *align = p.align;
    out.extend_from_slice(p.data.as_slice());
}

// Numbers the constant data the phase's tasks made (main thread, between
// phases): in the order of (phase, rank, then each function's order),
// which is the order one thread makes them in.
fn resolve_consts(pcx: &mut Ctx<Comp>) {
    // (phase, rank, placeholder) of each one not numbered yet
    let mut found: Vec<i64, Comp> = Vec::new_in(Comp {});
    for fi in 0..pcx.irfunc_count {
        let list = pcx.fn_consts.v[fi as usize].lock().unwrap();
        for k in 0..list.len() as i64 {
            let p = &(*list)[k as usize];
            if p.id < 0 {
                found.push(p.phase);
                found.push(p.rank);
                found.push(-(1 + (fi << OWNER_SHIFT) + k));
            }
        }
    }
    // (few: insertion sort)
    let n = found.len() / 3;
    for i in 1..n {
        let mut j = i;
        while j > 0 && const_before(&found[3 * j..3 * j + 3], &found[3 * j - 3..3 * j]) {
            for m in 0..3 {
                found.swap(3 * j + m, 3 * j - 3 + m);
            }
            j -= 1;
        }
    }
    for i in 0..n {
        give_id(found[3 * i + 2], pcx);
    }
    register_consts(pcx);
}

fn give_id(id: i64, pcx: &mut Ctx<Comp>) {
    if pcx.to_register.len() as i64 == 0 {
        pcx.next_const_id = get_str_count(pcx);
    }
    {
        let mut list = pcx.fn_consts.v[const_owner(id)].lock().unwrap();
        (*list)[const_index(id)].id = pcx.next_const_id;
    }
    pcx.next_const_id += 1;
    pcx.to_register.push(id);
}

// Adds the constants given ids to the program's strings (main thread,
// between phases).
fn register_consts(pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.to_register.len() as i64 {
        let id = pcx.to_register[i as usize];
        let list = pcx.fn_consts.v[const_owner(id)].lock().unwrap();
        let p = &(*list)[const_index(id)];
        if add_const_data(p.data.as_slice(), p.align, pcx) != p.id {
            die(c"internal error: constant data numbered out of order");
        }
    }
    pcx.to_register.clear();
}

// Whether constant a (its phase, rank and placeholder) is numbered before b.
fn const_before(a: &[i64], b: &[i64]) -> bool {
    if a[0] != b[0] {
        return a[0] < b[0];
    }
    if a[1] != b[1] {
        return a[1] < b[1];
    }
    // (one function's, in its order)
    a[2] > b[2]
}

// ---- Tasks ----

pub const K_CLEANUP: i64 = 1;
pub const K_SIMPLIFY: i64 = 2;
pub const K_COMPONENT: i64 = 3;
pub const K_EMIT: i64 = 4;

// The phases' order for constant data (task_phase).
pub const P_CLEANUP: i64 = 1;
pub const P_SIMPLIFY: i64 = 2;
pub const P_COMPONENT: i64 = 3;
pub const P_DEFERRED: i64 = 4;
pub const P_SLP: i64 = 5;
pub const P_EMIT: i64 = 6;

// (0.29) A table of i64 that the tasks of a phase share by element: per
// function or per component, an entry is written by the one task that has
// the function (or the component) in its plan, and read by others only
// once that task is done (a callee of a lower level, a fact made in an
// earlier phase: tests/threads_writes.sh says which and why). The entries
// are atomics, so the table is read and written through `&` in safe code
// and a read never sees half a value; the order of a write and a later
// read is the pool's (a phase's end, under its lock), so the loads and
// stores are relaxed and cost what a plain one does. The main thread makes
// the table anew between phases (`reset`, with `&mut`).
pub struct TaskInts<A: Allocator> {
    v: Vec<AtomicI64, A>,
}

pub fn task_ints() -> TaskInts<Comp> {
    TaskInts { v: Vec::new_in(Comp {}) }
}

impl<A: Allocator> TaskInts<A> {
    // n entries, each `value`.
    pub fn reset(&mut self, n: i64, value: i64) {
        self.v.clear();
        for i in 0..n {
            self.v.push(AtomicI64::new(value));
        }
    }

    pub fn len(&self) -> i64 {
        self.v.len() as i64
    }

    pub fn get(&self, i: i64) -> i64 {
        self.v[i as usize].load(Ordering::Relaxed)
    }

    pub fn set(&self, i: i64, value: i64) {
        self.v[i as usize].store(value, Ordering::Relaxed);
    }

    // (one writer an entry: a read and a write, not an atomic add)
    pub fn add(&self, i: i64, d: i64) {
        self.set(i, self.get(i) + d);
    }
}

// (0.29) A table of lists of i64 shared by element as a TaskInts is: a
// list is written by the task that has its function (or component) and
// read by others once that task is done. Each list is behind a lock of
// its own, free but for a moment (one push, one read), so the table is
// used through `&` in safe code.
pub struct TaskLists<A: Allocator> {
    v: Vec<Mutex<Vec<i64, A>>, A>,
}

pub fn task_lists() -> TaskLists<Comp> {
    TaskLists { v: Vec::new_in(Comp {}) }
}

impl TaskLists<Comp> {
    // n lists, each empty.
    pub fn reset(&mut self, n: i64) {
        self.v.clear();
        for i in 0..n {
            self.v.push(Mutex::new(Vec::new_in(Comp {})));
        }
    }

    pub fn clear(&self, i: i64) {
        self.v[i as usize].lock().unwrap().clear();
    }

    pub fn push(&self, i: i64, value: i64) {
        self.v[i as usize].lock().unwrap().push(value);
    }

    // The length of list i, and its k-th item.
    pub fn count(&self, i: i64) -> i64 {
        self.v[i as usize].lock().unwrap().len() as i64
    }

    pub fn at(&self, i: i64, k: i64) -> i64 {
        let list = self.v[i as usize].lock().unwrap();
        (*list)[k as usize]
    }
}

// Runs task `task` of a phase of kind `kind` in the context at cx (any
// thread): the pool's entry, where a thread's context is still a raw
// pointer.
pub fn run_task(cx: *mut FnCtx<Comp>, kind: i64, task: i64, pcx: &Ctx<Comp>) {
    // UNSAFE: a thread's function context reaches its tasks as a raw
    // pointer: the pool keeps the contexts (threads.vl's contexts) and each
    // thread takes its own across the thread boundary, where no borrow can
    // be written.
    // SAFETY: cx is the pool's context of the calling thread: contexts[0]
    // for the main thread (pool_run, pool_run_joined), contexts[index] for
    // worker `index` (take_tasks; the index is given once, under the
    // pool's lock). pool_start made each with fnctx_new and none is freed;
    // a thread runs one task at a time and no other thread uses its
    // context while the pool runs (--vec-stats reads them after the
    // phases). So this is the only reference to it during the task.
    let cx = unsafe { &mut *cx };
    if pcx.fresh_contexts {
        // (kept, as before 0.29: what the task leaves may name it; the
        // code cache's state is lent to it, fnctx_new_with, and taken back)
        let fresh = Box::leak(fresh_context(cx));
        run_task_in(fresh, kind, task, pcx);
        cx.cc = fresh.cc.take();
        return;
    }
    run_task_in(cx, kind, task, pcx);
}

// The task, in its context.
fn run_task_in(cx: &mut FnCtx<Comp>, kind: i64, task: i64, pcx: &Ctx<Comp>) {
    begin_task(&mut *cx);
    if kind == K_COMPONENT {
        let c = (pcx.parallel_items[task as usize]);
        for i in (pcx.comp_start[c as usize])..(pcx.comp_end[c as usize]) {
            ir_clear_marks(&mut *cx, (pcx.scc_order[i as usize]), pcx);
        }
        run_component(&mut *cx, c, pcx);
    } else {
        let fi = (pcx.parallel_items[task as usize]);
        ir_clear_marks(&mut *cx, fi, pcx);
        cx.task_rank = task;
        // (0.18.1: -O2's cleanup and scalar pipeline from the code cache;
        // -O1's cleanup alone costs less than its entry)
        let scalar = pcx.cc_on && pcx.opt_level >= 2;
        if kind == K_CLEANUP {
            cx.task_phase = P_CLEANUP;
            if !scalar || !cc_scalar_begin(&mut *cx, fi, task, pcx) {
                ir_enter(&mut *cx, fi, pcx);
                cleanup_function(&mut *cx, fi, pcx);
                if scalar {
                    cc_scalar_cleanup_end(&mut *cx, fi, pcx);
                }
            }
        } else if kind == K_SIMPLIFY {
            cx.task_phase = P_SIMPLIFY;
            if !scalar || !cc_scalar_simplify_begin(&mut *cx, fi, task, pcx) {
                ir_enter(&mut *cx, fi, pcx);
                simplify_function(&mut *cx, fi, pcx);
                if scalar {
                    cc_scalar_end(&mut *cx, fi, pcx);
                }
            }
        } else {
            // (0.18.1: its text from the code cache, back::codecache)
            let cached = pcx.cc_on && (pcx.fn_live[fi as usize]) != 0;
            if !cached || !cc_emit_begin(&mut *cx, fi, task, pcx) {
                cx.text_rtids.clear();
                emit_task(&mut *cx, fi, task, pcx);
                {
                    let mut t = pcx.fn_texts.lock(fi);
                    crate::base::buf_copy_into(cx.asm, &mut t.data);
                    t.labels = cx.label_count;
                    t.rtids.clear();
                    t.rtids.extend_from_slice(cx.text_rtids.as_slice());
                }
                buf_clear(cx.asm);
                if cached {
                    cc_emit_end(&mut *cx, fi, task, pcx);
                }
            }
        }
    }
    ir_release(&mut *cx, pcx);
    cx.task_phase = 0;
    cx.task_rank = 0;
}

// What a task finds in its context: nothing an earlier task left that it
// would use without computing it again. The passes' scratch is made anew
// for each function, or checked by stamps (its functions' marks zeroed
// first, ir_clear_marks); these caches are keyed by the function, which
// another task on this thread may have changed since:
// - gvn's param_written (ro_fn, ro_stamp);
// - vecfacts' vec_header_at (vh_key: by type, and a pool's context outlives
//   a program's types).
fn begin_task(cx: &mut FnCtx<Comp>) {
    cx.ro_fn = -1;
    cx.ro_stamp = -1;
    cx.vh_key = [0; 64];
}

// (VOLE_FRESH_CONTEXTS) A new context with cx's buffers (each thread
// keeps its own).
fn fresh_context(cx: &mut FnCtx<Comp>) -> Box<FnCtx<Comp>, Comp> {
    crate::middle::ctx::fnctx_new_with(cx)
}

// Runs tasks first..end of ITEMS (a phase, or a level of one).
fn run_tasks(cx: &mut FnCtx<Comp>, kind: i64, first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    let mut tasks = task_list(cx, kind, first, end, pcx);
    pool_run(kind, tasks.as_slice(), pcx);
}

// The tasks first..end of ITEMS for the pool, which takes the last first:
// one thread gets them reversed, so it runs them in order; several get
// them by size, the largest last, so that it starts first (a large
// function started last would keep the others waiting), but emission's in
// order (its texts are joined in order as they are done). What the tasks
// read is made first (ir_release, prepare_layouts).
fn task_list(cx: &mut FnCtx<Comp>, kind: i64, first: i64, end: i64, pcx: &mut Ctx<Comp>) -> Vec<i64,
    Comp> {
    ir_release(cx, pcx);
    prepare_layouts(pcx);
    let mut tasks: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut i = end;
    while i > first {
        i -= 1;
        tasks.push(i);
    }
    if pcx.pool_threads > 1 && kind != K_EMIT {
        let mut weight: Vec<i64, Comp> = Vec::new_in(Comp {});
        weight.resize((end + 1) as usize, 0);
        for k in first..end {
            weight[k as usize] = task_weight(kind, (pcx.parallel_items[k as usize]), pcx);
        }
        sort_tasks(&mut tasks, &weight);
    }
    tasks
}

// An estimate of a task's work: its function's instructions, or its
// component's.
fn task_weight(kind: i64, item: i64, pcx: &Ctx<Comp>) -> i64 {
    if kind != K_COMPONENT {
        return ir_stored(item, pcx).t.insts.len() as i64;
    }
    let mut w: i64 = 0;
    for k in (pcx.comp_start[item as usize])..(pcx.comp_end[item as usize]) {
        w += ir_stored((pcx.scc_order[k as usize]), pcx).t.insts.len() as i64;
    }
    w
}

// Sorts the task list by weight[task], ascending, stably (a merge sort).
fn sort_tasks(tasks: &mut [i64], weight: &[i64]) {
    let n = tasks.len();
    let mut b: Vec<i64, Comp> = Vec::new_in(Comp {});
    b.resize(n, 0);
    let mut width: usize = 1;
    while width < n {
        let mut lo: usize = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            while k < hi {
                if i < mid
                    && (j >= hi || weight[tasks[i] as usize] <= weight[tasks[j] as usize]) {
                    b[k] = tasks[i];
                    i += 1;
                } else {
                    b[k] = tasks[j];
                    j += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        for k in 0..n {
            tasks[k] = b[k];
        }
        width *= 2;
    }
}

// A per-function phase over ITEMS[first..end], then its constant data
// numbered.
fn run_functions(cx: &mut FnCtx<Comp>, kind: i64, first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    run_tasks(cx, kind, first, end, pcx);
    resolve_consts(pcx);
}

// Every live function's cleanup (-O1, -O2).
pub fn cleanup_all(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    cc_phase(K_CLEANUP, pcx);
    pcx.parallel_items.clear();
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) != 0 {
            pcx.parallel_items.push(fi);
        }
    }
    run_functions(cx, K_CLEANUP, 0, pcx.parallel_items.len() as i64, pcx);
}

// Every live function's scalar pipeline (-O2, before interprocedural
// constants).
pub fn simplify_all(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    pcx.parallel_items.clear();
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) != 0 {
            pcx.parallel_items.push(fi);
        }
    }
    run_functions(cx, K_SIMPLIFY, 0, pcx.parallel_items.len() as i64, pcx);
}

// ---- -O2: the components, bottom up ----

// Builds the components and their levels (main thread).
fn build_components(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    let n = pcx.scc_order.len() as i64;
    sized_table(&mut pcx.comp_start, n + 1, 0);
    sized_table(&mut pcx.comp_end, n + 1, 0);
    sized_table(&mut pcx.comp_of, pcx.irfunc_count + 1, -1);
    pcx.comp_count = 0;
    let mut i: i64 = 0;
    while i < n {
        let mut j = i + 1;
        while j < n
            && (pcx.fn_scc[(pcx.scc_order[j as usize]) as usize])
            == (pcx.fn_scc[(pcx.scc_order[i as usize]) as usize]) {
            j += 1;
        }
        // (a component's functions reach each other: all live or none)
        if (pcx.fn_live[(pcx.scc_order[i as usize]) as usize]) != 0 {
            (pcx.comp_start[pcx.comp_count as usize]) = i;
            (pcx.comp_end[pcx.comp_count as usize]) = j;
            for k in i..j {
                (pcx.comp_of[(pcx.scc_order[k as usize]) as usize]) = pcx.comp_count;
            }
            pcx.comp_count += 1;
        }
        i = j;
    }
    // Levels: SCC_ORDER has a component after the components it calls.
    // A function whose address it takes counts as one it calls (a call
    // through the address may be made direct, and the function inlined)
    // when it comes before it in SCC_ORDER (0.17 had it done then).
    sized_table(&mut pcx.comp_level, pcx.comp_count + 1, 0);
    pcx.comp_growth.reset(pcx.comp_count + 1, 0);
    pcx.comp_inlined.reset((pcx.comp_count + 1));
    pcx.level_count = 0;
    let mut calls: Vec<i64, Comp> = Vec::new_in(Comp {});
    for c in 0..pcx.comp_count {
        let mut level: i64 = 0;
        for k in (pcx.comp_start[c as usize])..(pcx.comp_end[c as usize]) {
            callees_and_addresses(cx, (pcx.scc_order[k as usize]), &mut calls, pcx);
            for m in 0..calls.len() as i64 {
                let d = (pcx.comp_of[(calls[m as usize]) as usize]);
                if d >= 0 && d < c && (pcx.comp_level[d as usize]) + 1 > level {
                    level = (pcx.comp_level[d as usize]) + 1;
                }
            }
        }
        (pcx.comp_level[c as usize]) = level;
        if level + 1 > pcx.level_count {
            pcx.level_count = level + 1;
        }
    }
    ir_release(cx, pcx);
}

// The IR functions fi calls directly or takes the address of (with
// repeats), in `out`.
fn callees_and_addresses(cx: &mut FnCtx<Comp>, fi: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    out.clear();
    ir_enter(cx, fi, pcx);
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let g = ir_callee(cx, v, pcx);
            if g >= 0 {
                out.push(g);
            }
            else if (cx.insts[v as usize]).op == Op::FAddr
                && (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) != 0 {
                out.push((pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1);
            }
            v = (cx.insts[v as usize]).next;
        }
    }
}

// Runs the -O2 bottom-up phase, a level at a time.
pub fn optimize_components(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    build_components(cx, pcx);
    cc_phase(K_COMPONENT, pcx);
    // The components of each level, in SCC_ORDER.
    let mut by_level: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut start: Vec<i64, Comp> = Vec::new_in(Comp {});
    start.resize((pcx.level_count + 2) as usize, 0);
    for c in 0..pcx.comp_count {
        (start[((pcx.comp_level[c as usize]) + 1) as usize]) += 1;
    }
    for l in 0..pcx.level_count {
        (start[(l + 1) as usize]) += (start[l as usize]);
    }
    let mut fill: Vec<i64, Comp> = Vec::new_in(Comp {});
    fill.resize((pcx.level_count + 1) as usize, 0);
    for c in 0..pcx.comp_count {
        by_level.push(0);
    }
    for c in 0..pcx.comp_count {
        let l = (pcx.comp_level[c as usize]);
        (by_level[((start[l as usize]) + (fill[l as usize])) as usize]) = c;
        (fill[l as usize]) += 1;
    }
    for l in 0..pcx.level_count {
        pcx.parallel_items.clear();
        for k in (start[l as usize])..(start[(l + 1) as usize]) {
            pcx.parallel_items.push((by_level[k as usize]));
        }
        run_tasks(cx, K_COMPONENT, 0, pcx.parallel_items.len() as i64, pcx);
        // The barrier: the level's growth and inlined calls, for the
        // next levels.
        for k in (start[l as usize])..(start[(l + 1) as usize]) {
            let c = (by_level[k as usize]);
            add_program_size((pcx.comp_growth.get(c)), pcx);
            for m in 0..pcx.comp_inlined.count(c) {
                (pcx.fn_calls[(pcx.comp_inlined.at(c, m)) as usize]) -= 1;
            }
        }
    }
    resolve_consts(pcx);
}

// Component c's task: its functions in SCC_ORDER, their attributes, then
// what its callers will read of them.
fn run_component(cx: &mut FnCtx<Comp>, c: i64, pcx: &Ctx<Comp>) {
    cx.cur_comp = c;
    cx.comp_dec.clear();
    cx.comp_growth = 0;
    cx.task_phase = P_COMPONENT;
    let start = (pcx.comp_start[c as usize]);
    let end = (pcx.comp_end[c as usize]);
    // (0.18.1: its outputs from the code cache, back::codecache)
    if pcx.cc_on && cc_component_begin(cx, c, start, end, pcx) {
        cx.cur_comp = -1;
        return;
    }
    for i in start..end {
        cx.task_rank = i;
        optimize_component_function(cx, (pcx.scc_order[i as usize]), pcx);
    }
    infer_component_attrs(cx, start, end, pcx);
    for i in start..end {
        finish_component_function(cx, (pcx.scc_order[i as usize]), pcx);
    }
    pcx.comp_growth.set(c, cx.comp_growth);
    for m in 0..cx.comp_dec.len() as i64 {
        pcx.comp_inlined.push(c, (cx.comp_dec[m as usize]));
    }
    if pcx.cc_on {
        cc_component_end(cx, c, start, end, pcx);
    }
    cx.cur_comp = -1;
}

// Whether function g's facts (attributes, size, optimized IR) may be read
// by the code cx runs: in the -O2 bottom-up phase, a function of a lower
// level (done before this level began); elsewhere `done`, as before
// (FN_ATTRS_DONE, which in the phase says only which happen to be done;
// 0.27.8: and a caller reads it only outside the phase, where it is
// written by no other thread).
pub fn fn_facts_ready(cx: &mut FnCtx<Comp>, g: i64, done: bool, pcx: &Ctx<Comp>) -> bool {
    // (0.18.1: what the task saw of g, for the code cache)
    cc_note(cx, R_STATIC, g, pcx);
    if cx.cur_comp < 0 {
        return done;
    }
    let d = (pcx.comp_of[g as usize]);
    d >= 0 && (pcx.comp_level[d as usize]) < (pcx.comp_level[cx.cur_comp as usize])
}

// (back::codecache) The component of IR function g in the bottom-up
// phase (-1: none, or another phase).
pub fn comp_of(g: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.comp_of.is_empty() {
        return -1;
    }
    (pcx.comp_of[g as usize])
}

// ---- Emission ----

// A function's text (emit_task's), its local labels, (with the code
// cache) the strings and constants its text names by index (str.\x03<i>)
// and its RTID values, by index (join_text).
pub struct FnText<A: Allocator> {
    pub data: Vec<u8, A>, pub labels: i64, pub relocs: Vec<i64, A>, pub rtids: Vec<i64, A>,
}

fn no_text() -> FnText<Comp> {
    FnText {
        data: Vec::new_in(Comp {}), labels: 0, relocs: Vec::new_in(Comp {}),
        rtids: Vec::new_in(Comp {}),
    }
}

// (0.29) Per IR function, its text, in the compilation context: each
// behind a lock of its own. Entry fi is written by fi's emission task
// (run_task's K_EMIT, cc_emit_end, emit_install: fi is
// parallel_items[task], one task per function) and taken by the main
// thread at the join (join_task), once the pool marked the task done or
// the phase's tasks are all done.
pub struct FnTexts<A: Allocator> {
    v: Vec<Mutex<FnText<A>>, A>,
}

pub fn fn_texts() -> FnTexts<Comp> {
    FnTexts { v: Vec::new_in(Comp {}) }
}

impl FnTexts<Comp> {
    // n entries, each empty (main thread, before the pool starts).
    pub fn reset(&mut self, n: i64) {
        self.v.clear();
        for i in 0..n {
            self.v.push(Mutex::new(no_text()));
        }
    }

    // Entry fi, to read or write while the guard lives.
    pub fn lock(&self, fi: i64) -> MutexGuard<'_, FnText<Comp>> {
        self.v[fi as usize].lock().unwrap()
    }

    // Entry fi, an empty one left in its place.
    pub fn take(&self, fi: i64) -> FnText<Comp> {
        let mut t = self.v[fi as usize].lock().unwrap();
        std::mem::replace(&mut *t, no_text())
    }
}

// Emits the functions in `order` (IR functions, program order): those
// before `split` first, then the rest (-O1's small leaves, which the
// others inline as the middle end left them), and joins their texts into
// cx's (the program's) in that order: as they are done, beside the
// emission (pool_run_joined); with one thread, after it.
pub fn emit_functions(cx: &mut FnCtx<Comp>, order: &[i64], split: i64, pcx: &mut Ctx<Comp>) {
    pcx.parallel_items.clear();
    for i in 0..order.len() as i64 {
        pcx.parallel_items.push((order[i as usize]));
    }
    pcx.rt_renumbered = true;
    if pcx.rt_cx == 0 as *mut FnCtx<Comp> {
        pcx.rt_cx = crate::middle::ctx::fnctx_new();
    }
    cc_phase(K_EMIT, pcx);
    emit_range(cx, 0, split, pcx);
    emit_range(cx, split, pcx.parallel_items.len() as i64, pcx);
    phase_time(c"emission, join and assembly", pcx);
}

fn emit_range(cx: &mut FnCtx<Comp>, first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    let tasks = task_list(cx, K_EMIT, first, end, pcx);
    let mut next = first;
    if pcx.pool_threads > 1 {
        next = pool_run_joined(K_EMIT, tasks.as_slice(), first, end, cx, pcx);
    } else {
        pool_run(K_EMIT, tasks.as_slice(), pcx);
    }
    resolve_consts(pcx);
    while next < end {
        join_task(next, cx, pcx);
        next += 1;
    }
}

// Joins the text of task i (ITEMS' position i) to the program's, cx's
// (main thread): false when it names constant data its phase has not
// numbered yet (that waits for the phase's end, resolve_consts).
pub fn join_task(i: i64, cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let fi = (pcx.parallel_items[i as usize]);
    // -O1 optimizes each function in its emission task, the only
    // constant data made then: one thread numbers it in the emission's
    // order, which is the join's, so it is numbered here.
    if pcx.per_function {
        number_consts(fi, pcx);
    }
    let t = pcx.fn_texts.take(fi);
    if t.data.len() > 0 {
        if !consts_numbered(&t, pcx) {
            let mut slot = pcx.fn_texts.lock(fi);
            *slot = t;
            return false;
        }
        // UNSAFE: the context whose code buffer takes the loads of run-time
        // numbers (rt_cx) is kept in the compilation context as a raw
        // pointer, as every function context is (ctx.vl's fnctx_new).
        // SAFETY: emit_functions made it with fnctx_new before the first
        // join and it is never freed; only the join uses it (this function,
        // on the main thread, one call at a time), so the `&mut` is the
        // only reference to it while join_text runs.
        let rt = unsafe { &mut *pcx.rt_cx };
        join_text(cx, rt, &t, pcx);
        cx.label_count += t.labels;
        asm_flush(cx, pcx);
    }
    true
}

// Numbers function fi's constant data not numbered yet, in its order.
fn number_consts(fi: i64, pcx: &mut Ctx<Comp>) {
    for k in 0..const_data_count(fi, pcx) {
        let id = -(1 + (fi << OWNER_SHIFT) + k);
        if const_data_id(id, pcx) < 0 {
            give_id(id, pcx);
        }
    }
}

// Whether every constant a text names (str.\x02<n>, or str.\x03<i> with
// the code cache: its relocs[i]) has its id.
fn consts_numbered(t: &FnText<Comp>, pcx: &Ctx<Comp>) -> bool {
    let text = t.data.as_slice();
    let len = text.len() as i64;
    let mut at: i64 = 0;
    while at < len {
        if text[at as usize] != 2 {
            at += 1;
            continue;
        }
        let mut j = at + 1;
        let mut n: i64 = 0;
        while j < len && text[j as usize] >= b'0' && text[j as usize] <= b'9' {
            n = n * 10 + (text[j as usize] - b'0') as i64;
            j += 1;
        }
        if const_data_id(-(n + 1), pcx) < 0 {
            return false;
        }
        at = j;
    }
    for &id in t.relocs.as_slice() {
        if const_data_id(id, pcx) < 0 {
            return false;
        }
    }
    true
}

// Appends a task's text to cx's assembly: L\x01<n> becomes L<n + the
// labels before>, str.\x02<n> the constant's id, str.\x03<i> (with the
// code cache) the id of the text's string or constant i, the line
// \x04<r>,<i> (0.18.1) the load into register r of the program's number
// for the text's RTID value i (gen0::target::rt_output), made in rt's
// code buffer. (A text without strings by index, or without RTID values,
// has no \x03, or no \x04: such a byte is text.)
fn join_text(cx: &mut FnCtx<Comp>, rt: &mut FnCtx<Comp>, t: &FnText<Comp>, pcx: &mut Ctx<Comp>) {
    let text = t.data.as_slice();
    let len = text.len() as i64;
    let base = cx.label_count;
    let nrelocs = t.relocs.len() as i64;
    let nrtids = t.rtids.len() as i64;
    // (text[i..at] is not copied yet)
    let mut i: i64 = 0;
    let mut at: i64 = 0;
    while at < len {
        let mark = text[at as usize];
        if mark == 0 || mark > 4 || (mark == 3 && nrelocs == 0) || (mark == 4 && nrtids == 0) {
            at += 1;
            continue;
        }
        buf_bytes(cx.asm, &text[i as usize..at as usize]);
        let mut j = at + 1;
        let mut n: i64 = 0;
        while j < len && text[j as usize] >= b'0' && text[j as usize] <= b'9' {
            n = n * 10 + (text[j as usize] - b'0') as i64;
            j += 1;
        }
        if mark == 1 {
            buf_int(cx.asm, base + n);
        } else if mark == 4 {
            // (\x04<r>,<i> and its newline: the load, its own line)
            let mut k: i64 = 0;
            j += 1;
            while j < len && text[j as usize] >= b'0' && text[j as usize] <= b'9' {
                k = k * 10 + (text[j as usize] - b'0') as i64;
                j += 1;
            }
            if k >= nrtids || j >= len || text[j as usize] != b'\n' {
                die(c"internal error: a text names a run-time number it has not");
            }
            j += 1;
            let v = t.rtids[k as usize];
            m_load_imm(rt, n, rt_output(rtid_class(v, pcx), rtid_value(v, pcx), pcx) as u64);
            buf_append(cx.asm, rt.code);
            buf_clear(rt.code);
        } else if mark == 3 {
            if n >= nrelocs {
                die(c"internal error: a text names a string it has not");
            }
            let id = const_data_id(t.relocs[n as usize], pcx);
            if id < 0 {
                die(c"internal error: constant data without an id");
            }
            buf_int(cx.asm, id);
        } else {
            let id = const_data_id(-(n + 1), pcx);
            if id < 0 {
                die(c"internal error: constant data without an id");
            }
            buf_int(cx.asm, id);
        }
        i = j;
        at = j;
    }
    buf_bytes(cx.asm, &text[i as usize..]);
}

// ---- What the tasks read, made first ----

// The program's state that the tasks only read, made before they run:
// what the passes would otherwise make the first time they need it, on
// whichever thread (the symbols they compare with, the e-graph's rules,
// the C library's table, every type's layout, the growth mode).
fn prepare_tasks(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    crate::base::stress_grow();
    crate::gen0::target::make_rt_panic_sym(pcx);
    // (emission compares a CallC with both: interned here, as a task
    // would race the other threads on the symbol table)
    crate::gen0::target::make_rt_note_sym(pcx);
    crate::middle::gvn::init_syms(pcx);
    crate::middle::ipo::init_syms(pcx);
    crate::front::cells::find_cell_sym(pcx);
    crate::front::effects::builtin::fill_c_table(pcx);
    prepare_layouts(pcx);
}

// Every type's layout, Freeze fact and every enum's niche, made before
// a phase's tasks run: compute_layout, is_freeze and enum_niche make one
// the first time it is asked (is_freeze in a shared map), and a task may
// ask: GVN asks is_freeze of a parameter's type (the types a serial phase
// made since the last are prepared here too).
fn prepare_layouts(pcx: &mut Ctx<Comp>) {
    while pcx.laid_out < pcx.types.len() as i64 {
        compute_layout(pcx.laid_out, pcx);
        crate::front::cells::is_freeze(pcx.laid_out, pcx);
        pcx.laid_out += 1;
    }
    for e in 0..pcx.enum_count {
        enum_niche(e, pcx);
    }
}
