// (0.18.1) Code generation on several threads (docs/optimizer.md,
// "0.18.1: threads"). The per-function work of the middle and back end
// runs as tasks, on middle::threads' pool, each thread with its own
// FnCtx:
//
// - -O1 and -O2: each function's cleanup (`K_CLEANUP`); -O2: its scalar
//   pipeline before interprocedural constants (`K_SIMPLIFY`);
// - -O2: the call graph's components, bottom up (`K_COMPONENT`), a level
//   at a time: a component's level is above those of the components it
//   calls, since inlining reads them;
// - each function's emission (`K_EMIT`; -O1 optimizes it there, -O2 runs
//   its waiting loop passes and SLP there), into a text of its own.
//
// The output is the same whatever the number of threads, and the same as
// one thread's: a task reads only what is final when it starts (its own
// function; at -O2 the components of lower levels), and what tasks make
// for the program is joined in program order, between phases:
//
// - each function's text, with labels numbered from 1 (L\x01<n>), is
//   appended in program order with its labels renumbered (join_text);
// - constant data a task makes (SROA's tables) gets a placeholder id,
//   negative, and its id at the end of the phase, in the order one thread
//   would have made them (resolve_consts);
// - -O2's inlining budget and call counts are each component's view (the
//   program's after the lower levels, and what the component itself
//   inlined), not the shared counters of 0.17, which made the decisions
//   depend on the order components were done in.
//
// Modes that keep the program's state in statics or print as they go run
// on one thread (serial_only): -g, --time-passes (its clock is the
// process's), --stats, --verify-ir, the IR printers.

use crate::host_target;
use crate::back::codecache::{
    R_STATIC, cc_component_begin, cc_component_end, cc_emit_begin, cc_emit_end, cc_note, cc_of,
    cc_phase, cc_scalar_begin, cc_scalar_cleanup_end, cc_scalar_end, cc_scalar_simplify_begin,
};
use crate::back::emit::function::emit_task;
use crate::back::emit::machine::m_load_imm;
use crate::back::objfile::asm_flush;
use crate::base::{
    IntVec, alloc_array, alloc_zeroed, buf_bytes, buf_clear, buf_int, buf_slice, cstr, die, free,
    memcpy,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_AARCH64_MACOS, T_X86_64_MACOS};
use crate::front::distinct::enum_niche;
use crate::front::lexer::{get_str_count, str_at};
use crate::front::types::compute_layout;
use crate::gen0::target::{add_const_data, rt_output};
use crate::middle::ctx::{FnCtx, main_cx};
use crate::middle::inline::{add_program_size, finish_component_function, ir_callee};
use crate::middle::ipo::infer_component_attrs;
use crate::middle::ir::{Op, get_irfuncs, ir_enter, ir_release, rtid_class, rtid_value};
use crate::middle::opt::{cleanup_function, optimize_component_function, simplify_function};
use crate::middle::threads::{
    get_pool_ctx, pool_run, pool_run_joined, pool_start, pool_stop, processors,
};

extern "C" {
    fn memchr(s: *mut u8, c: i32, n: u64) -> *mut u8;
    fn clock_gettime(clock: i32, ts: *mut i64) -> i32;
}

// ---- Options ----

// The default -j: the processors, at most 8 (more threads than the
// machine's fast cores gain little: docs/optimizer.md, "0.18.1").
pub fn default_jobs() -> i64 {
    let host = host_target();
    let n = processors(host == T_AARCH64_MACOS || host == T_X86_64_MACOS);
    if n > 8 { 8 } else { n }
}

// The number in text s (-j's), or -1.
pub fn parse_jobs(s: *mut u8) -> i64 {
    unsafe {
        let mut n: i64 = 0;
        let mut i: i64 = 0;
        while (*s.add(i as usize)) >= b'0' && (*s.add(i as usize)) <= b'9' && n < 100000 {
            n = n * 10 + ((*s.add(i as usize)) - b'0') as i64;
            i += 1;
        }
        if i == 0 || (*s.add(i as usize)) != 0 { -1 } else { n }
    }
}

// Whether this compilation must run on one thread: a mode that keeps the
// program's state in statics or prints as it goes.
fn serial_only(pcx: &Ctx<Comp>) -> bool {
    pcx.debug_info || pcx.time_passes || pcx.stats > 0 || pcx.verify_ir || pcx.print_after_all
        || pcx.print_regalloc || pcx.verify_regalloc || pcx.print_checks != 0 as *mut u8
        || pcx.vec_stats_fn != 0 as *mut u8
}

// The threads for a program of `functions` functions to compile: -j's;
// by default fewer for a small program (a thread costs about as much as
// compiling a few small functions to start).
fn threads_for(functions: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n = if pcx.jobs > 0 { pcx.jobs } else { default_jobs() };
    if serial_only(pcx) {
        n = 1;
    }
    let most = functions / 16 + 1;
    if pcx.jobs == 0 && n > most {
        n = most;
    }
    if n < 1 { 1 } else { n }
}

// (0.18.1) Whether -O0 assembles on a thread of its own, beside code
// generation: when streaming (no -g, not -S) and more than one thread may
// be used.
pub fn assembler_thread_wanted(pcx: &Ctx<Comp>) -> bool {
    pcx.asm_stream && !serial_only(pcx)
        && (if pcx.jobs > 0 { pcx.jobs > 1 } else { default_jobs() > 1 })
}

// Starts the pool for the program's functions (main thread, before the
// first phase): the program's state the tasks only read is made first
// (prepare_tasks).
pub fn parallel_begin(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        prepare_tasks(cx, pcx);
        set_fn_consts(alloc_zeroed((pcx.irfunc_count + 1) * size_of(ConstList)) as *mut ConstList);
        set_fn_text(alloc_zeroed((pcx.irfunc_count + 1) * size_of(FnText)) as *mut FnText);
        let fresh = crate::base::getenv(c"VOLE_FRESH_CONTEXTS");
        pcx.fresh_contexts = fresh != 0 as *mut u8 && *fresh == b'1';
        pool_start(threads_for(pcx.irfunc_count, pcx), pcx);
    }
}

// The end of code generation: the workers stop.
pub fn parallel_end(pcx: &mut Ctx<Comp>) {
    pool_stop(pcx);
}

// (VOLE_PHASE_TIMES=1) The wall time since the last mark, on stderr,
// for phase `name`: --time-passes runs on one thread (its clock is the
// process's), this measures the threads' phases as they run.
pub fn phase_time(name: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.phase_times == 0 {
            let on = crate::base::getenv(c"VOLE_PHASE_TIMES");
            pcx.phase_times = if on != 0 as *mut u8 && *on == b'1' { 1 } else { -1 };
            pcx.phase_mark = monotonic_ns();
        }
        if pcx.phase_times < 0 || name == 0 as *mut u8 {
            return;
        }
        let now = monotonic_ns();
        let ms = (now - pcx.phase_mark) / 100000;
        pcx.phase_mark = now;
        eprintln("{}.{} ms\t{}", ms / 10, ms % 10, str::from_utf8(cstr(name)).unwrap());
    }
}

// Nanoseconds of the monotonic clock.
fn monotonic_ns() -> i64 {
    unsafe {
        let mut ts: [i64; 2] = [0i64; 2];
        let host = host_target();
        let clock: i64 = if host == T_AARCH64_MACOS || host == T_X86_64_MACOS { 6 } else { 1 };
        clock_gettime(clock as i32, &mut ts[0]);
        ts[0] * 1000000000 + ts[1]
    }
}

// (0.18.1) --vec-stats's counts (0 vector loops, 1 overlap tests, 2 tests
// the facts dropped), summed over the contexts that made them.
pub fn vec_stat(k: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut n = vec_stat_of(&mut *main_cx(pcx), k);
        if get_pool_ctx() != 0 as *mut *mut FnCtx<Comp> {
            for i in 0..pcx.pool_contexts {
                n += vec_stat_of(&mut *(*get_pool_ctx().add(i as usize)), k);
            }
        }
        n
    }
}

fn vec_stat_of(cx: &mut FnCtx<Comp>, k: i64) -> i64 {
    if k == 0 { cx.vec_loops } else if k == 1 { cx.vec_tests } else { cx.vec_skipped }
}

// ---- Constant data ----

// Constant data a task made for function `owner` (sroa.vl's constant
// slots): its bytes, alignment, where it was made (phase and rank: the
// order one thread makes them in) and its id once numbered (-1 before).
#[derive(Clone, Copy)] struct PendingConst {
    data: *mut u8, len: i64, align: i64, phase: i64, rank: i64, id: i64,
}
// A function's: in chunks of CHUNK entries that never move (another
// function's task reads the entries made before its phase while this one
// adds more), through a table of CHUNKS chunks made with the first.
#[derive(Clone, Copy)] struct ConstList { chunks: *mut *mut PendingConst, count: i64 }
const CHUNK: i64 = 64;
const CHUNKS: i64 = 1024;

// Per IR function: the constant data made while it was optimized (its
// own task writes it).
static mut FN_CONSTS: *mut ConstList = 0 as *mut ConstList;
pub const OWNER_SHIFT: i64 = 20;

// The id of constant data `bytes` made by function fi's pipeline: in
// serial code its id (gen0::add_const_data); in a task a placeholder,
// -(1 + fi << OWNER_SHIFT + k), numbered at the end of the phase.
pub fn const_data(cx: &mut FnCtx<Comp>, fi: i64, bytes: &[u8], align: i64) -> i64 {
    unsafe {
        if cx.task_phase == 0 {
            return add_const_data(bytes, align);
        }
        let list = get_fn_consts().add(fi as usize) as *mut ConstList;
        let k = (*list).count;
        if k == 0 {
            (*list).chunks = alloc_zeroed(CHUNKS * 8) as *mut *mut PendingConst;
        }
        if k == CHUNK * CHUNKS {
            die(c"internal error: a function makes too much constant data");
        }
        if k % CHUNK == 0 {
            (*(*list).chunks.add((k / CHUNK) as usize)) = alloc_zeroed(
                CHUNK * size_of(PendingConst))
                as *mut PendingConst;
        }
        let n = bytes.len() as i64;
        let copy = alloc_zeroed(n + 1);
        memcpy(copy, bytes.ptr, n as u64);
        (*(*(*list).chunks.add((k / CHUNK) as usize)).add((k % CHUNK) as usize)) = PendingConst {
            data: copy, len: n, align, phase: cx.task_phase, rank: cx.task_rank, id: -1,
        };
        (*list).count = k + 1;
        -(1 + (fi << OWNER_SHIFT) + k)
    }
}

fn pending(id: i64) -> *mut PendingConst {
    unsafe {
        let m = -id - 1;
        let k = m & ((1 << OWNER_SHIFT) - 1);
        (*(*get_fn_consts().add((m >> OWNER_SHIFT) as usize)).chunks.add((k / CHUNK) as usize)).add(
            (k % CHUNK) as usize)
    }
}

// The id of string or constant data `id` (a placeholder's once numbered;
// -1 before).
pub fn const_data_id(id: i64) -> i64 {
    unsafe {
        if id >= 0 { id } else { (*pending(id)).id }
    }
}

// The bytes of string or constant data `id`.
pub fn const_data_bytes(id: i64) -> &'static [u8] {
    unsafe {
        if id >= 0 {
            return str_at(id);
        }
        let p = pending(id);
        std::slice::from_raw_parts((*p).data.add((0) as usize), ((*p).len - (0)) as usize)
    }
}

// (0.18.1, back::codecache) The alignment of constant data `id` a task
// made (a placeholder).
pub fn const_data_align(id: i64) -> i64 {
    unsafe { (*pending(id)).align }
}

// (back::codecache) The constant data function fi's tasks made so far
// (its own task, or a phase after).
pub fn const_data_count(fi: i64) -> i64 {
    unsafe { (*get_fn_consts().add(fi as usize)).count }
}

// (back::codecache) Function fi's k-th constant data: its bytes, and its
// phase, rank and alignment in *phase, *rank, *align.
pub fn const_data_entry(fi: i64, k: i64, phase: &mut i64, rank: &mut i64, align: &mut i64) -> &'static [
    u8] {
    unsafe {
        let p = (*(*get_fn_consts().add(fi as usize)).chunks.add((k / CHUNK) as usize)).add(
            (k % CHUNK) as usize);
        *phase = (*p).phase;
        *rank = (*p).rank;
        *align = (*p).align;
        std::slice::from_raw_parts((*p).data.add((0) as usize), ((*p).len - (0)) as usize)
    }
}

// Numbers the constant data the phase's tasks made (main thread, between
// phases): in the order of (phase, rank, then each function's order),
// which is the order one thread makes them in.
fn resolve_consts(pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut found = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for fi in 0..pcx.irfunc_count {
            for k in 0..(*get_fn_consts().add(fi as usize)).count {
                let id = -(1 + (fi << OWNER_SHIFT) + k);
                if (*pending(id)).id < 0 {
                    found.push(id);
                }
            }
        }
        // (few: insertion sort)
        for i in 1..found.len() as i64 {
            let mut j = i;
            while j > 0
                && const_before((found[j as usize]), (found[(j - 1) as usize])) {
                let t = (found[j as usize]);
                (found[j as usize]) = (found[(j - 1) as usize]);
                (found[(j - 1) as usize]) = t;
                j -= 1;
            }
        }
        for i in 0..found.len() as i64 {
            give_id(pending((found[i as usize])), pcx);
        }
        free(found.data as *mut u8);
        register_consts(pcx);
    }
}

fn give_id(p: *mut PendingConst, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.to_register.len() as i64 == 0 {
            pcx.next_const_id = get_str_count();
        }
        (*p).id = pcx.next_const_id;
        pcx.next_const_id += 1;
        pcx.to_register.push(p as i64);
    }
}

// Adds the constants given ids to the program's strings (main thread,
// between phases).
fn register_consts(pcx: &mut Ctx<Comp>) {
    unsafe {
        for i in 0..pcx.to_register.len() as i64 {
            let p = (pcx.to_register[i as usize]) as *mut PendingConst;
            if add_const_data(std::slice::from_raw_parts((*p).data.add((0) as usize),
                ((*p).len - (0)) as usize), (*p).align) != (*p).id {
                die(c"internal error: constant data numbered out of order");
            }
        }
        pcx.to_register.clear();
    }
}

fn const_before(a: i64, b: i64) -> bool {
    unsafe {
        let p = pending(a);
        let q = pending(b);
        if (*p).phase != (*q).phase {
            return (*p).phase < (*q).phase;
        }
        if (*p).rank != (*q).rank {
            return (*p).rank < (*q).rank;
        }
        // (one function's, in its order)
        a > b
    }
}

// ---- Tasks ----

pub const K_CLEANUP: i64 = 1;
pub const K_SIMPLIFY: i64 = 2;
pub const K_COMPONENT: i64 = 3;
pub const K_EMIT: i64 = 4;

// The phases' order for constant data (task_phase).
pub const P_CLEANUP: i64 = 1;
pub const P_SIMPLIFY: i64 = 2;
pub const P_COMPONENT: i64 = 3;
pub const P_DEFERRED: i64 = 4;
pub const P_SLP: i64 = 5;
pub const P_EMIT: i64 = 6;

// Runs task `task` of a phase of kind `kind` in context cx (any thread).
pub fn run_task(mut cx: *mut FnCtx<Comp>, kind: i64, task: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.fresh_contexts {
            // (the code cache's state, kept: fnctx_new_with)
            if pcx.cc_on {
                cc_of(&mut *cx);
            }
            cx = fresh_context(&mut *cx);
        }
        begin_task(&mut *cx);
        if kind == K_COMPONENT {
            let c = (pcx.parallel_items[task as usize]);
            for i in (*pcx.comp_start.add(c as usize))..(*pcx.comp_end.add(c as usize)) {
                clear_marks((pcx.scc_order[i as usize]));
            }
            run_component(&mut *cx, c, pcx);
        } else {
            let fi = (pcx.parallel_items[task as usize]);
            clear_marks(fi);
            cx.task_rank = task;
            // (0.18.1: -O2's cleanup and scalar pipeline from the code cache;
            // -O1's cleanup alone costs less than its entry)
            let scalar = pcx.cc_on && pcx.opt_level >= 2;
            if kind == K_CLEANUP {
                cx.task_phase = P_CLEANUP;
                if !scalar || !cc_scalar_begin(&mut *cx, fi, task, pcx) {
                    ir_enter(&mut *cx, fi, pcx);
                    cleanup_function(&mut *cx, fi, pcx);
                    if scalar {
                        cc_scalar_cleanup_end(&mut *cx, fi);
                    }
                }
            } else if kind == K_SIMPLIFY {
                cx.task_phase = P_SIMPLIFY;
                if !scalar || !cc_scalar_simplify_begin(&mut *cx, fi, task, pcx) {
                    ir_enter(&mut *cx, fi, pcx);
                    simplify_function(&mut *cx, fi, pcx);
                    if scalar {
                        cc_scalar_end(&mut *cx, fi, pcx);
                    }
                }
            } else {
                // (0.18.1: its text from the code cache, back::codecache)
                let cached = pcx.cc_on && (pcx.fn_live[fi as usize]) != 0;
                if !cached || !cc_emit_begin(&mut *cx, fi, task, pcx) {
                    cx.text_rtids.clear();
                    emit_task(&mut *cx, fi, task, pcx);
                    let t = get_fn_text().add(fi as usize) as *mut FnText;
                    let out = buf_slice(cx.asm);
                    (*t).len = out.len() as i64;
                    (*t).data = alloc_zeroed((*t).len + 1);
                    memcpy((*t).data, out.ptr, out.len() as u64);
                    (*t).labels = cx.label_count;
                    let nr = cx.text_rtids.len() as i64;
                    (*t).rtids = alloc_array::<i64>(nr + 1);
                    for k in 0..nr {
                        (*(*t).rtids.add(k as usize)) = (cx.text_rtids[k as usize]);
                    }
                    (*t).nrtids = nr;
                    buf_clear(cx.asm);
                    if cached {
                        cc_emit_end(&mut *cx, fi, task, pcx);
                    }
                }
            }
        }
        ir_release(&mut *cx);
        cx.task_phase = 0;
        cx.task_rank = 0;
    }
}

// What a task finds in its context: nothing an earlier task left that it
// would use without computing it again. The passes' scratch is made anew
// for each function, or checked by stamps (its functions' marks zeroed
// first, clear_marks); these caches are keyed by the function, which
// another task on this thread may have changed since:
// - gvn's param_written (ro_fn, ro_stamp).
fn begin_task(cx: &mut FnCtx<Comp>) {
    cx.ro_fn = -1;
    cx.ro_stamp = -1;
}

// (0.27.7) The marks of function fi's instructions and blocks, zeroed as
// a task on it begins. Passes compare marks with their context's stamps
// (tags_stamp, capture_stamp, sim_stamp, vstamp), which every context
// counts from the same base: a mark left by the function's task in another
// context, or installed by the code cache from another run, could equal
// this context's next stamp, and the code made would depend on which
// thread ran what before. (A pass's aux is read only where its mark is the
// pass's stamp.)
fn clear_marks(fi: i64) {
    // UNSAFE: IRFUNCS' tables are raw arrays (the IR's own representation).
    // SAFETY: v and b are below the tables' counts; fi is this task's own
    // function, current in no context (every task ends with ir_release, the
    // main thread releases before a phase), so no other thread writes them.
    unsafe {
        let t = (*get_irfuncs().add(fi as usize)).t;
        for v in 0..t.inst_count {
            (*t.insts.add(v as usize)).mark = 0;
        }
        for b in 0..t.block_count {
            (*t.blocks.add(b as usize)).mark = 0;
        }
    }
}

// (VOLE_FRESH_CONTEXTS) A new context with cx's buffers (each thread
// keeps its own).
fn fresh_context(cx: &mut FnCtx<Comp>) -> *mut FnCtx<Comp> {
    let n = crate::middle::ctx::fnctx_new_with(cx);
    n
}

// Runs tasks first..end of ITEMS (a phase, or a level of one).
fn run_tasks(cx: &mut FnCtx<Comp>, kind: i64, first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut tasks = task_list(cx, kind, first, end, pcx);
        pool_run(kind, tasks, pcx);
        free(tasks.data as *mut u8);
    }
}

// The tasks first..end of ITEMS for the pool, which takes the last first:
// one thread gets them reversed, so it runs them in order; several get
// them by size, the largest last, so that it starts first (a large
// function started last would keep the others waiting), but emission's in
// order (its texts are joined in order as they are done). What the tasks
// read is made first (ir_release, prepare_layouts).
fn task_list(cx: &mut FnCtx<Comp>, kind: i64, first: i64, end: i64, pcx: &mut Ctx<Comp>) -> IntVec {
    unsafe {
        ir_release(cx);
        prepare_layouts(pcx);
        let mut tasks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut i = end;
        while i > first {
            i -= 1;
            tasks.push(i);
        }
        if pcx.pool_threads > 1 && kind != K_EMIT {
            let weight = alloc_array::<i64>(end + 1);
            for k in first..end {
                (*weight.add(k as usize)) = task_weight(kind,
                    (pcx.parallel_items[k as usize]), pcx);
            }
            sort_tasks(tasks, weight);
            free(weight as *mut u8);
        }
        tasks
    }
}

// An estimate of a task's work: its function's instructions, or its
// component's.
fn task_weight(kind: i64, item: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if kind != K_COMPONENT {
            return (*get_irfuncs().add(item as usize)).t.inst_count;
        }
        let mut w: i64 = 0;
        for k in (*pcx.comp_start.add(item as usize))..(*pcx.comp_end.add(item as usize)) {
            w += (*get_irfuncs().add((pcx.scc_order[k as usize]) as usize)).t.inst_count;
        }
        w
    }
}

// Sorts the task list by weight[task], ascending, stably (a merge sort).
fn sort_tasks(tasks: IntVec, weight: *mut i64) {
    unsafe {
        let n = tasks.len() as i64;
        let a = tasks.data;
        let b = alloc_array::<i64>(n + 1);
        let mut width: i64 = 1;
        while width < n {
            let mut lo: i64 = 0;
            while lo < n {
                let mid = if lo + width < n { lo + width } else { n };
                let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
                let mut i = lo;
                let mut j = mid;
                let mut k = lo;
                while k < hi {
                    if i < mid
                        && (j >= hi
                            || (*weight.add((*a.add(i as usize)) as usize))
                            <= (*weight.add((*a.add(j as usize)) as usize))) {
                        (*b.add(k as usize)) = (*a.add(i as usize));
                        i += 1;
                    } else {
                        (*b.add(k as usize)) = (*a.add(j as usize));
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            for k in 0..n {
                (*a.add(k as usize)) = (*b.add(k as usize));
            }
            width *= 2;
        }
        free(b as *mut u8);
    }
}

// A per-function phase over ITEMS[first..end], then its constant data
// numbered.
fn run_functions(cx: &mut FnCtx<Comp>, kind: i64, first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    run_tasks(cx, kind, first, end, pcx);
    resolve_consts(pcx);
}

// Every live function's cleanup (-O1, -O2).
pub fn cleanup_all(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        cc_phase(K_CLEANUP, pcx);
        pcx.parallel_items.clear();
        for fi in 0..pcx.irfunc_count {
            if (pcx.fn_live[fi as usize]) != 0 {
                pcx.parallel_items.push(fi);
            }
        }
        run_functions(cx, K_CLEANUP, 0, pcx.parallel_items.len() as i64, pcx);
    }
}

// Every live function's scalar pipeline (-O2, before interprocedural
// constants).
pub fn simplify_all(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.parallel_items.clear();
        for fi in 0..pcx.irfunc_count {
            if (pcx.fn_live[fi as usize]) != 0 {
                pcx.parallel_items.push(fi);
            }
        }
        run_functions(cx, K_SIMPLIFY, 0, pcx.parallel_items.len() as i64, pcx);
    }
}

// ---- -O2: the components, bottom up ----

// Per component: what its inlining added to the program's size, and the
// callees it inlined (one entry per call); its task writes them.
static mut COMP_GROWTH: *mut i64 = 0 as *mut i64;
static mut COMP_INLINED: *mut IntVec = 0 as *mut IntVec;

// Builds the components and their levels (main thread).
fn build_components(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let n = pcx.scc_order.len() as i64;
        pcx.comp_start = alloc_array::<i64>(n + 1);
        pcx.comp_end = alloc_array::<i64>(n + 1);
        pcx.comp_of = alloc_array::<i64>(pcx.irfunc_count + 1);
        for fi in 0..pcx.irfunc_count {
            (*pcx.comp_of.add(fi as usize)) = -1;
        }
        pcx.comp_count = 0;
        let mut i: i64 = 0;
        while i < n {
            let mut j = i + 1;
            while j < n
                && (*pcx.fn_scc.add((pcx.scc_order[j as usize]) as usize))
                == (*pcx.fn_scc.add((pcx.scc_order[i as usize]) as usize)) {
                j += 1;
            }
            // (a component's functions reach each other: all live or none)
            if (pcx.fn_live[(pcx.scc_order[i as usize]) as usize]) != 0 {
                (*pcx.comp_start.add(pcx.comp_count as usize)) = i;
                (*pcx.comp_end.add(pcx.comp_count as usize)) = j;
                for k in i..j {
                    (*pcx.comp_of.add((pcx.scc_order[k as usize]) as usize)) = pcx.comp_count;
                }
                pcx.comp_count += 1;
            }
            i = j;
        }
        // Levels: SCC_ORDER has a component after the components it calls.
        // A function whose address it takes counts as one it calls (a call
        // through the address may be made direct, and the function inlined)
        // when it comes before it in SCC_ORDER (0.17 had it done then).
        pcx.comp_level = alloc_array::<i64>(pcx.comp_count + 1);
        set_comp_growth(alloc_array::<i64>(pcx.comp_count + 1));
        set_comp_inlined(alloc_zeroed((pcx.comp_count + 1) * size_of(IntVec)) as *mut IntVec);
        pcx.level_count = 0;
        let mut calls = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for c in 0..pcx.comp_count {
            let mut level: i64 = 0;
            for k in (*pcx.comp_start.add(c as usize))..(*pcx.comp_end.add(c as usize)) {
                callees_and_addresses(cx, (pcx.scc_order[k as usize]), &mut calls, pcx);
                for m in 0..calls.len() as i64 {
                    let d = (*pcx.comp_of.add((calls[m as usize]) as usize));
                    if d >= 0 && d < c && (*pcx.comp_level.add(d as usize)) + 1 > level {
                        level = (*pcx.comp_level.add(d as usize)) + 1;
                    }
                }
            }
            (*pcx.comp_level.add(c as usize)) = level;
            if level + 1 > pcx.level_count {
                pcx.level_count = level + 1;
            }
        }
        ir_release(cx);
        free(calls.data as *mut u8);
    }
}

// The IR functions fi calls directly or takes the address of (with
// repeats), in `out`.
fn callees_and_addresses(cx: &mut FnCtx<Comp>, fi: i64, out: &mut IntVec, pcx: &Ctx<Comp>) {
    unsafe {
        out.clear();
        ir_enter(cx, fi, pcx);
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let g = ir_callee(cx, v, pcx);
                if g >= 0 {
                    out.push(g);
                }
                else if (*cx.insts.add(v as usize)).op == Op::FAddr
                    && (*pcx.fn_ir.add((*cx.insts.add(v as usize)).imm as usize)) != 0 {
                    out.push((*pcx.fn_ir.add((*cx.insts.add(v as usize)).imm as usize)) - 1);
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
    }
}

// Runs the -O2 bottom-up phase, a level at a time.
pub fn optimize_components(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        build_components(cx, pcx);
        cc_phase(K_COMPONENT, pcx);
        // The components of each level, in SCC_ORDER.
        let mut by_level = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let start = alloc_array::<i64>(pcx.level_count + 2);
        for c in 0..pcx.comp_count {
            (*start.add(((*pcx.comp_level.add(c as usize)) + 1) as usize)) += 1;
        }
        for l in 0..pcx.level_count {
            (*start.add((l + 1) as usize)) += (*start.add(l as usize));
        }
        let fill = alloc_array::<i64>(pcx.level_count + 1);
        for c in 0..pcx.comp_count {
            by_level.push(0);
        }
        for c in 0..pcx.comp_count {
            let l = (*pcx.comp_level.add(c as usize));
            (by_level[((*start.add(l as usize)) + (*fill.add(l as usize))) as usize]) = c;
            (*fill.add(l as usize)) += 1;
        }
        for l in 0..pcx.level_count {
            pcx.parallel_items.clear();
            for k in (*start.add(l as usize))..(*start.add((l + 1) as usize)) {
                pcx.parallel_items.push((by_level[k as usize]));
            }
            run_tasks(cx, K_COMPONENT, 0, pcx.parallel_items.len() as i64, pcx);
            // The barrier: the level's growth and inlined calls, for the
            // next levels.
            for k in (*start.add(l as usize))..(*start.add((l + 1) as usize)) {
                let c = (by_level[k as usize]);
                add_program_size((*get_comp_growth().add(c as usize)), pcx);
                for m in 0..(*get_comp_inlined().add(c as usize)).len() as i64 {
                    (*pcx.fn_calls.add(
                        ((*get_comp_inlined().add(c as usize))[m as usize]) as usize)) -= 1;
                }
            }
        }
        free(start as *mut u8);
        free(fill as *mut u8);
        free(by_level.data as *mut u8);
        resolve_consts(pcx);
    }
}

// Component c's task: its functions in SCC_ORDER, their attributes, then
// what its callers will read of them.
fn run_component(cx: &mut FnCtx<Comp>, c: i64, pcx: &Ctx<Comp>) {
    unsafe {
        cx.cur_comp = c;
        cx.comp_dec.clear();
        cx.comp_growth = 0;
        cx.task_phase = P_COMPONENT;
        let start = (*pcx.comp_start.add(c as usize));
        let end = (*pcx.comp_end.add(c as usize));
        // (0.18.1: its outputs from the code cache, back::codecache)
        if pcx.cc_on && cc_component_begin(cx, c, start, end, pcx) {
            cx.cur_comp = -1;
            return;
        }
        for i in start..end {
            cx.task_rank = i;
            optimize_component_function(cx, (pcx.scc_order[i as usize]), pcx);
        }
        infer_component_attrs(cx, start, end, pcx);
        for i in start..end {
            finish_component_function(cx, (pcx.scc_order[i as usize]), pcx);
        }
        (*get_comp_growth().add(c as usize)) = cx.comp_growth;
        for m in 0..cx.comp_dec.len() as i64 {
            (*get_comp_inlined().add(c as usize)).push((cx.comp_dec[m as usize]));
        }
        if pcx.cc_on {
            cc_component_end(cx, c, start, end, pcx);
        }
        cx.cur_comp = -1;
    }
}

// Whether function g's facts (attributes, size, optimized IR) may be read
// by the code cx runs: in the -O2 bottom-up phase, a function of a lower
// level (done before this level began); elsewhere `done`, as before
// (FN_ATTRS_DONE, which in the phase says only which happen to be done;
// 0.27.8: and a caller reads it only outside the phase, where it is
// written by no other thread).
pub fn fn_facts_ready(cx: &mut FnCtx<Comp>, g: i64, done: bool, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // (0.18.1: what the task saw of g, for the code cache)
        cc_note(cx, R_STATIC, g, pcx);
        if cx.cur_comp < 0 {
            return done;
        }
        let d = (*pcx.comp_of.add(g as usize));
        d >= 0 && (*pcx.comp_level.add(d as usize)) < (*pcx.comp_level.add(cx.cur_comp as usize))
    }
}

// (back::codecache) The component of IR function g in the bottom-up
// phase (-1: none, or another phase).
pub fn comp_of(g: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.comp_of == 0 as *mut i64 {
            return -1;
        }
        (*pcx.comp_of.add(g as usize))
    }
}

// ---- Emission ----

// Per IR function: its text (emit_task's), its local labels.
#[derive(Clone, Copy)] pub struct FnText {
    pub data: *mut u8, pub len: i64, pub labels: i64, pub relocs: *mut i64, pub nrelocs: i64,
    // (0.18.1) its RTID values, by index (join_text)
    pub rtids: *mut i64, pub nrtids: i64,
}

static mut FN_TEXT: *mut FnText = 0 as *mut FnText;

// Emits the functions in `order` (IR functions, program order): those
// before `split` first, then the rest (-O1's small leaves, which the
// others inline as the middle end left them), and joins their texts into
// cx's (the program's) in that order: as they are done, beside the
// emission (pool_run_joined); with one thread, after it.
pub fn emit_functions(cx: *mut FnCtx<Comp>, order: IntVec, split: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.parallel_items.clear();
        for i in 0..order.len() as i64 {
            pcx.parallel_items.push((order[i as usize]));
        }
        pcx.join_cx = cx;
        pcx.rt_renumbered = true;
        if pcx.rt_cx == 0 as *mut FnCtx<Comp> {
            pcx.rt_cx = crate::middle::ctx::fnctx_new();
        }
        cc_phase(K_EMIT, pcx);
        emit_range(&mut *cx, 0, split, pcx);
        emit_range(&mut *cx, split, pcx.parallel_items.len() as i64, pcx);
        phase_time(c"emission, join and assembly", pcx);
    }
}

fn emit_range(cx: &mut FnCtx<Comp>, first: i64, end: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut tasks = task_list(cx, K_EMIT, first, end, pcx);
        let mut next = first;
        if pcx.pool_threads > 1 {
            next = pool_run_joined(K_EMIT, tasks, first, end, pcx);
        } else {
            pool_run(K_EMIT, tasks, pcx);
        }
        free(tasks.data as *mut u8);
        resolve_consts(pcx);
        while next < end {
            join_task(next, pcx);
            next += 1;
        }
    }
}

// Joins the text of task i (ITEMS' position i) to the program's (main
// thread): false when it names constant data its phase has not numbered
// yet (that waits for the phase's end, resolve_consts).
pub fn join_task(i: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let fi = (pcx.parallel_items[i as usize]);
        let t = get_fn_text().add(fi as usize) as *mut FnText;
        // -O1 optimizes each function in its emission task, the only
        // constant data made then: one thread numbers it in the emission's
        // order, which is the join's, so it is numbered here.
        if pcx.per_function {
            number_consts(fi, pcx);
        }
        if (*t).len > 0 {
            if !consts_numbered(*t) {
                return false;
            }
            join_text(&mut *pcx.join_cx, *t, pcx);
            pcx.join_cx.label_count += (*t).labels;
            asm_flush(&mut *pcx.join_cx, pcx);
        }
        free((*t).data);
        free((*t).relocs as *mut u8);
        free((*t).rtids as *mut u8);
        (*t).rtids = 0 as *mut i64;
        (*t).nrtids = 0;
        (*t).data = 0 as *mut u8;
        (*t).len = 0;
        (*t).relocs = 0 as *mut i64;
        (*t).nrelocs = 0;
        true
    }
}

// Numbers function fi's constant data not numbered yet, in its order.
fn number_consts(fi: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        for k in 0..(*get_fn_consts().add(fi as usize)).count {
            let p = pending(-(1 + (fi << OWNER_SHIFT) + k));
            if (*p).id < 0 {
                give_id(p, pcx);
            }
        }
    }
}

// Whether every constant a text names (str.\x02<n>, or str.\x03<i> with
// the code cache: its relocs[i]) has its id.
fn consts_numbered(t: FnText) -> bool {
    unsafe {
        let text = t.data;
        let len = t.len;
        let mut at = next_marker(text, 0, len, 2);
        while at < len {
            let mut j = at + 1;
            let mut n: i64 = 0;
            while j < len && (*text.add(j as usize)) >= b'0' && (*text.add(j as usize)) <= b'9' {
                n = n * 10 + ((*text.add(j as usize)) - b'0') as i64;
                j += 1;
            }
            if const_data_id(-(n + 1)) < 0 {
                return false;
            }
            at = next_marker(text, j, len, 2);
        }
        for i in 0..t.nrelocs {
            if const_data_id((*t.relocs.add(i as usize))) < 0 {
                return false;
            }
        }
        true
    }
}

// Appends a task's text to cx's assembly: L\x01<n> becomes L<n + the
// labels before>, str.\x02<n> the constant's id, str.\x03<i> (with the
// code cache) the id of the text's string or constant i, the line
// \x04<r>,<i> (0.18.1) the load into register r of the program's number
// for the text's RTID value i (gen0::target::rt_output).
fn join_text(cx: &mut FnCtx<Comp>, t: FnText, pcx: &mut Ctx<Comp>) {
    unsafe {
        let text = t.data;
        let len = t.len;
        let base = cx.label_count;
        let mut i: i64 = 0;
        let mut one = next_marker(text, 0, len, 1);
        let mut two = next_marker(text, 0, len, 2);
        let mut three = if t.nrelocs > 0 { next_marker(text, 0, len, 3) } else { len };
        let mut four = if t.nrtids > 0 { next_marker(text, 0, len, 4) } else { len };
        while i < len {
            let mut at = if one < two { one } else { two };
            if three < at {
                at = three;
            }
            if four < at {
                at = four;
            }
            if at >= len {
                buf_bytes(cx.asm,
                    std::slice::from_raw_parts(text.add((i) as usize), (len - (i)) as usize));
                return;
            }
            buf_bytes(cx.asm,
                std::slice::from_raw_parts(text.add((i) as usize), (at - (i)) as usize));
            let mut j = at + 1;
            let mut n: i64 = 0;
            while j < len && (*text.add(j as usize)) >= b'0' && (*text.add(j as usize)) <= b'9' {
                n = n * 10 + ((*text.add(j as usize)) - b'0') as i64;
                j += 1;
            }
            if (*text.add(at as usize)) == 1 {
                buf_int(cx.asm, base + n);
                one = next_marker(text, j, len, 1);
            } else if (*text.add(at as usize)) == 4 {
                // (\x04<r>,<i> and its newline: the load, its own line)
                let mut k: i64 = 0;
                j += 1;
                while j < len && (*text.add(j as usize)) >= b'0'
                    && (*text.add(j as usize)) <= b'9' {
                    k = k * 10 + ((*text.add(j as usize)) - b'0') as i64;
                    j += 1;
                }
                if k >= t.nrtids || j >= len || (*text.add(j as usize)) != b'\n' {
                    die(c"internal error: a text names a run-time number it has not");
                }
                j += 1;
                let v = (*t.rtids.add(k as usize));
                m_load_imm(&mut *pcx.rt_cx, n,
                    rt_output(rtid_class(v, pcx), rtid_value(v, pcx), pcx) as u64);
                buf_bytes(cx.asm, buf_slice(pcx.rt_cx.code));
                buf_clear(pcx.rt_cx.code);
                four = next_marker(text, j, len, 4);
            } else if (*text.add(at as usize)) == 3 {
                if n >= t.nrelocs {
                    die(c"internal error: a text names a string it has not");
                }
                let id = const_data_id((*t.relocs.add(n as usize)));
                if id < 0 {
                    die(c"internal error: constant data without an id");
                }
                buf_int(cx.asm, id);
                three = next_marker(text, j, len, 3);
            } else {
                let id = const_data_id(-(n + 1));
                if id < 0 {
                    die(c"internal error: constant data without an id");
                }
                buf_int(cx.asm, id);
                two = next_marker(text, j, len, 2);
            }
            i = j;
        }
    }
}

fn next_marker(text: *mut u8, from: i64, len: i64, byte: i32) -> i64 {
    unsafe {
        if from >= len {
            return len;
        }
        let p = memchr(text.add(from as usize), byte, (len - from) as u64);
        if p == 0 as *mut u8 { len } else { (p as i64) - (text as i64) }
    }
}

// ---- What the tasks read, made first ----

// The program's state that the tasks only read, made before they run:
// what the passes would otherwise make the first time they need it, on
// whichever thread (the symbols they compare with, the e-graph's rules,
// the C library's table, every type's layout, the growth mode).
fn prepare_tasks(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    crate::base::stress_grow();
    crate::gen0::target::make_rt_panic_sym(pcx);
    // (emission compares a CallC with both: interned here, as a task
    // would race the other threads on the symbol table)
    crate::gen0::target::make_rt_note_sym(pcx);
    crate::middle::gvn::init_syms(pcx);
    crate::middle::ipo::init_syms(pcx);
    crate::front::cells::find_cell_sym(pcx);
    crate::front::effects::builtin::fill_c_table(pcx);
    crate::middle::egraph::init_rules();
    prepare_layouts(pcx);
}

// Every type's layout, Freeze fact and every enum's niche, made before
// a phase's tasks run: compute_layout, is_freeze and enum_niche make one
// the first time it is asked (is_freeze in a shared map), and a task may
// ask: GVN asks is_freeze of a parameter's type (the types a serial phase
// made since the last are prepared here too).
fn prepare_layouts(pcx: &mut Ctx<Comp>) {
    while pcx.laid_out < pcx.types.len() as i64 {
        compute_layout(pcx.laid_out, pcx);
        crate::front::cells::is_freeze(pcx.laid_out, pcx);
        pcx.laid_out += 1;
    }
    for e in 0..pcx.enum_count {
        enum_niche(e, pcx);
    }
}

// (0.28.0) FN_CONSTS's accessors: every use of it is one of them.
fn get_fn_consts() -> *mut ConstList {
    // UNSAFE: the per-function constant data lists, a process-wide static
    // mut every task reads and writes; Rust has no safe access to a static
    // mut
    // SAFETY: allocated by parallel_begin before pool_start; list fi is
    // appended only by the task for fi (const_data's callers pass the
    // pass's own fi), and an entry's fields are written once, before its
    // placeholder exists, in chunks that never move; ids are written only
    // by the main thread (resolve_consts between phases; number_consts in
    // join_task for the joined function, whose task is done); a placeholder
    // of g reaches another function's IR only by inlining g's IR, i.e. g of
    // a finished lower level (-O2) or an -O1 small leaf, whose constants
    // are made serially (simplify_inlining_leaves, task_phase 0, real ids);
    // a reader of an old entry (pending) touches the chunks pointer and
    // that entry, never the count or slots an appending task writes
    unsafe { FN_CONSTS }
}

fn set_fn_consts(v: *mut ConstList) {
    // UNSAFE: the per-function constant data lists, a process-wide static
    // mut every task reads and writes; Rust has no safe access to a static
    // mut
    // SAFETY: allocated by parallel_begin before pool_start; list fi is
    // appended only by the task for fi (const_data's callers pass the
    // pass's own fi), and an entry's fields are written once, before its
    // placeholder exists, in chunks that never move; ids are written only
    // by the main thread (resolve_consts between phases; number_consts in
    // join_task for the joined function, whose task is done); a placeholder
    // of g reaches another function's IR only by inlining g's IR, i.e. g of
    // a finished lower level (-O2) or an -O1 small leaf, whose constants
    // are made serially (simplify_inlining_leaves, task_phase 0, real ids);
    // a reader of an old entry (pending) touches the chunks pointer and
    // that entry, never the count or slots an appending task writes
    unsafe {
        FN_CONSTS = v;
    }
}

// (0.28.0) COMP_GROWTH's accessors: every use of it is one of them.
pub fn get_comp_growth() -> *mut i64 {
    // UNSAFE: the per-component growth, a process-wide static mut; Rust has
    // no safe access to a static mut
    // SAFETY: allocated by build_components on the main thread before the
    // levels; COMP_GROWTH[c] written only by component c's task
    // (run_component, component_install), read by that task
    // (cc_component_end) and by the main thread after the level's pool_run
    // (optimize_components); one task per component per level
    unsafe { COMP_GROWTH }
}

pub fn set_comp_growth(v: *mut i64) {
    // UNSAFE: the per-component growth, a process-wide static mut; Rust has
    // no safe access to a static mut
    // SAFETY: allocated by build_components on the main thread before the
    // levels; COMP_GROWTH[c] written only by component c's task
    // (run_component, component_install), read by that task
    // (cc_component_end) and by the main thread after the level's pool_run
    // (optimize_components); one task per component per level
    unsafe {
        COMP_GROWTH = v;
    }
}

// (0.28.0) COMP_INLINED's accessors: every use of it is one of them.
pub fn get_comp_inlined() -> *mut IntVec {
    // UNSAFE: the per-component inlined-callee lists, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: the pointer is written only by build_components on the main
    // thread before the bottom-up levels run; entry c is pushed only by
    // component c's task (run_component, or component_install on a cache
    // hit) and read by that task (cc_component_end) and by the main thread
    // after the level's pool_run returned (optimize_components' barrier); a
    // level's tasks are distinct components (by_level lists each once;
    // run_task's c = parallel_items[task]), so no two threads touch one
    // entry at once
    unsafe { COMP_INLINED }
}

pub fn set_comp_inlined(v: *mut IntVec) {
    // UNSAFE: the per-component inlined-callee lists, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: the pointer is written only by build_components on the main
    // thread before the bottom-up levels run; entry c is pushed only by
    // component c's task (run_component, or component_install on a cache
    // hit) and read by that task (cc_component_end) and by the main thread
    // after the level's pool_run returned (optimize_components' barrier); a
    // level's tasks are distinct components (by_level lists each once;
    // run_task's c = parallel_items[task]), so no two threads touch one
    // entry at once
    unsafe {
        COMP_INLINED = v;
    }
}

// (0.28.0) FN_TEXT's accessors: every use of it is one of them.
pub fn get_fn_text() -> *mut FnText {
    // UNSAFE: the per-function emitted texts, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: allocated by parallel_begin on the main thread before
    // pool_start; entry fi is written only by fi's emission task (run_task
    // K_EMIT, cc_emit_end, emit_install: fi = parallel_items[task], one
    // task per function), and read and freed by the main thread in
    // join_task only after it saw JOINED[i] set holding MUTEX (set after
    // the task's writes) or after the phase's tasks are all done
    unsafe { FN_TEXT }
}

pub fn set_fn_text(v: *mut FnText) {
    // UNSAFE: the per-function emitted texts, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: allocated by parallel_begin on the main thread before
    // pool_start; entry fi is written only by fi's emission task (run_task
    // K_EMIT, cc_emit_end, emit_install: fi = parallel_items[task], one
    // task per function), and read and freed by the main thread in
    // join_task only after it saw JOINED[i] set holding MUTEX (set after
    // the task's writes) or after the phase's tasks are all done
    unsafe {
        FN_TEXT = v;
    }
}
