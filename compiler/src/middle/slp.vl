// The SLP vectorizer (0.11): straight-line code. In each block, a group of
// stores writing the VF lanes of one 16-byte vector (one base, consecutive
// offsets, one scalar type T, VF = 16 / size(T)) is a seed; the values they
// store are packed bottom-up, lane by lane:
//
// - lanes that are the same value: a splat;
// - loads of consecutive addresses (one base) in the block: a vector load;
// - the same operation in every lane (+ - * & | ^, negation; / on floats)
//   of type T, in the block: that operation on the vectors of its
//   operands' lanes;
// - anything else: gathered into a vector, lane by lane.
//
// Each lane computes exactly what its scalar code does (a float lane is the
// same IEEE operation; nothing is reassociated). The vector code goes just
// before the group's last store, which the vector store replaces; the
// scalar code no longer used goes with dead code elimination. That moves
// the group's loads and stores down to that point, which the memory
// between must allow: no call or other write to memory in between, no
// store in between that may write what a moved load reads, no access in
// between to what a moved store writes, and no load reading a store of the
// group made before it. The group is vectorized when the scalar
// instructions that go outnumber the vector ones it costs.

use crate::base::{IntVec, alloc_array, free, memcpy};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, is_float,
    type_size, vector_type,
};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{address_base, find_escaping_slots, may_alias};
use crate::middle::ir::{
    Op, get_irfuncs, ir_enter, ir_insert_before, ir_make, ir_operand, ir_operand_count, ir_unlink,
    ir_val,
};
use crate::middle::ir::Op::{
    Add, And, Div, Load, Mul, Neg, Or, Store, Sub, VBin, VIns, VNeg, VSplat, Xor,
};

const SLP_MAX_STORES: i64 = 64;
const SLP_MAX_DEPTH: i64 = 8;
const SLP_MAX_NODES: i64 = 32;

// The tree: nodes of VF lanes each (N_LANES, VF per node), their kind and
// their operand nodes. Kinds: a splat of lane 0, a vector load, an
// operation, a gather.
const K_SPLAT: i64 = 1;
const K_LOAD: i64 = 2;
const K_OP: i64 = 3;
const K_GATHER: i64 = 4;

// Whether some lane of node n goes (after scalars_removed).
fn some_lane_goes(cx: &mut FnCtx<Comp>, n: i64) -> bool {
    for k in 0..cx.g_vf {
        let lane_v = lane(cx, n, k);
        if goes(cx, lane_v) {
            return true;
        }
    }
    false
}

// The vector instructions the tree from node n costs; a load or an
// operation whose scalars all stay (used elsewhere) becomes a gather of
// them when that is cheaper.
fn tree_cost(cx: &mut FnCtx<Comp>, n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (cx.n_seen[n as usize]) != 0 {
            return 0;
        }
        (cx.n_seen[n as usize]) = 1;
        let kind = (cx.n_kind[n as usize]);
        if kind != K_OP && kind != K_LOAD {
            return node_cost(cx, n, pcx);
        }
        let mut cost = node_cost(cx, n, pcx);
        if kind == K_OP {
            cost += tree_cost(cx, (cx.n_a[n as usize]), pcx);
            if (cx.n_b[n as usize]) >= 0 {
                cost += tree_cost(cx, (cx.n_b[n as usize]), pcx);
            }
        }
        if cost > cx.g_vf && !some_lane_goes(cx, n) {
            (cx.n_kind[n as usize]) = K_GATHER;
            return cx.g_vf;
        }
        cost
    }
}

// Marks the nodes the vector code of node n uses (N_SEEN 2).
fn reach(cx: &mut FnCtx<Comp>, n: i64) {
    unsafe {
        if (cx.n_seen[n as usize]) == 2 {
            return;
        }
        (cx.n_seen[n as usize]) = 2;
        if (cx.n_kind[n as usize]) == K_OP {
            reach(cx, (cx.n_a[n as usize]));
            if (cx.n_b[n as usize]) >= 0 {
                reach(cx, (cx.n_b[n as usize]));
            }
        }
    }
}

// Whether node n is a vector load of the tree.
fn is_tree_load(cx: &mut FnCtx<Comp>, n: i64) -> bool {
    unsafe { (cx.n_kind[n as usize]) == K_LOAD && (cx.n_seen[n as usize]) == 2 }
}

fn lane_type(t: i64) -> i64 {
    if t == TY_F32 || t == TY_F64 || t == TY_I64 || t == TY_I32 || t == TY_I16 || t == TY_I8 {
        return t;
    }
    if t == TY_U64 { return TY_I64; }
    if t == TY_U32 { return TY_I32; }
    if t == TY_U16 { return TY_I16; }
    if t == TY_U8 { return TY_I8; }
    0
}

fn pos_of(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    unsafe {
        if v < cx.table_size
            && (*cx.pos_stamp.add(v as usize)) == cx.slp_stamp { (*cx.pos.add(v as usize)) }
        else { -1 }
    }
}

fn lane(cx: &mut FnCtx<Comp>, n: i64, k: i64) -> i64 {
    unsafe { (cx.n_lanes[(n * cx.g_vf + k) as usize]) }
}

// Whether instruction v is a scalar of the block being looked at.
fn in_block(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    pos_of(cx, v) >= 0
}

// The node for lanes `lanes` (VF values); -1 when the tree grows too big.
fn build(cx: &mut FnCtx<Comp>, lanes: *mut i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let vf = cx.g_vf;
        // (The same lanes again: the same node.)
        for n in 0..cx.n_kind.len() as i64 {
            let mut same = true;
            for k in 0..vf {
                if lane(cx, n, k) != (*lanes.add(k as usize)) {
                    same = false;
                }
            }
            if same {
                return n;
            }
        }
        if cx.n_kind.len() as i64 >= SLP_MAX_NODES {
            return -1;
        }
        let n = cx.n_kind.len() as i64;
        for k in 0..vf {
            cx.n_lanes.push((*lanes.add(k as usize)));
        }
        cx.n_kind.push(K_GATHER);
        cx.n_a.push(-1);
        cx.n_b.push(-1);
        cx.n_value.push(0);
        let x = (*lanes.add(0));
        let mut all_same = true;
        for k in 1..vf {
            if (*lanes.add(k as usize)) != x {
                all_same = false;
            }
        }
        for k in 0..vf {
            // (Every lane a value of the lane type.)
            if lane_type((*cx.insts.add((*lanes.add(k as usize)) as usize)).ty)
                != lane_type(cx.g_elem) {
                return -1;
            }
        }
        if all_same {
            (cx.n_kind[n as usize]) = K_SPLAT;
            return n;
        }
        // Every lane a scalar of the block, of type T, by one operation.
        let op = (*cx.insts.add(x as usize)).op;
        let mut iso = true;
        for k in 0..vf {
            let v = (*lanes.add(k as usize));
            if !in_block(cx, v) || (*cx.insts.add(v as usize)).op != op
                || lane_type((*cx.insts.add(v as usize)).ty) != lane_type(cx.g_elem)
                || (*cx.insts.add(v as usize)).ty != (*cx.insts.add(x as usize)).ty {
                iso = false;
            }
        }
        if !iso || depth >= SLP_MAX_DEPTH {
            return n;
        }
        if op == Load {
            let size = type_size(cx.g_elem, pcx);
            let mut off0 = (*cx.insts.add(x as usize)).imm;
            let ir_val_v = ir_val(cx, (*cx.insts.add(x as usize)).a);
            let address_base_v = address_base(cx, ir_val_v, &mut off0);
            let base = ir_val(cx, address_base_v);
            for k in 1..vf {
                let mut off = (*cx.insts.add((*lanes.add(k as usize)) as usize)).imm;
                let ir_val_v1 = ir_val(cx, (*cx.insts.add((*lanes.add(k as usize)) as usize)).a);
                let address_base_v1 = address_base(cx, ir_val_v1, &mut off);
                let b = ir_val(cx, address_base_v1);
                if b != base || off != off0 + k * size {
                    return n;
                }
            }
            (cx.n_kind[n as usize]) = K_LOAD;
            return n;
        }
        let float = is_float(cx.g_elem);
        let ok_op = op == Add || op == Sub || op == Mul || op == Neg
            || (!float && (op == And || op == Or || op == Xor)) || (float && op == Div);
        if !ok_op {
            return n;
        }
        let mut sub: [i64; 16] = [0i64; 16];
        for k in 0..vf {
            sub[k as usize] = ir_val(cx, (*cx.insts.add((*lanes.add(k as usize)) as usize)).a);
        }
        let a = build(cx, sub.as_mut_ptr() as *mut i64, depth + 1, pcx);
        if a < 0 {
            return -1;
        }
        let mut b: i64 = -1;
        if op != Neg {
            for k in 0..vf {
                sub[k as usize] = ir_val(cx, (*cx.insts.add((*lanes.add(k as usize)) as usize)).b);
            }
            b = build(cx, sub.as_mut_ptr() as *mut i64, depth + 1, pcx);
            if b < 0 {
                return -1;
            }
        }
        (cx.n_kind[n as usize]) = K_OP;
        (cx.n_a[n as usize]) = a;
        (cx.n_b[n as usize]) = b;
        n
    }
}

// The vector instructions node n costs (an integer multiplication done
// lane by lane: SSE2 has 16-bit lanes only, NEON no 64-bit ones).
fn node_cost(cx: &mut FnCtx<Comp>, n: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let kind = (cx.n_kind[n as usize]);
        if kind == K_GATHER {
            return cx.g_vf;
        }
        if kind == K_OP && { let at_ix = lane(cx, n, 0) as usize; (*cx.insts.add(at_ix)) }.op == Mul
            && !is_float(cx.g_elem) {
            let size = type_size(cx.g_elem, pcx);
            let lanewise = if get_x86() { size != 2 } else { size == 8 };
            if lanewise {
                return 3 * cx.g_vf;
            }
        }
        1
    }
}

fn dead_uses(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    unsafe {
        let mut k: i64 = 0;
        while k < cx.dead.len() as i64 {
            if (cx.dead[k as usize]) == v {
                return (cx.dead[(k + 1) as usize]);
            }
            k += 2;
        }
        0
    }
}

fn add_dead_use(cx: &mut FnCtx<Comp>, v: i64) {
    unsafe {
        let mut k: i64 = 0;
        while k < cx.dead.len() as i64 {
            if (cx.dead[k as usize]) == v {
                (cx.dead[(k + 1) as usize]) += 1;
                return;
            }
            k += 2;
        }
        cx.dead.push(v);
        cx.dead.push(1);
    }
}

// Whether scalar v goes: every use of it by scalars that go. (0.25) One
// made since count_uses has no uses yet.
fn goes(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        let uses: i64 = if v < cx.slp_counted { (*cx.slp_uses.add(v as usize)) } else { 0 };
        dead_uses(cx, v) == uses
    }
}

// The scalar instructions the group's vectorization removes: its stores,
// and the tree's scalars (of its loads and operations) whose every use
// goes, found from the stores down (nodes are numbered from the root).
fn scalars_removed(cx: &mut FnCtx<Comp>) -> i64 {
    unsafe {
        cx.dead.clear();
        let vf = cx.g_vf;
        let mut count = vf;
        for k in 0..vf {
            let ir_val_v = ir_val(cx, (*cx.insts.add(cx.g_stores[k as usize] as usize)).b);
            add_dead_use(cx, ir_val_v);
        }
        for n in 0..cx.n_kind.len() as i64 {
            let kind = (cx.n_kind[n as usize]);
            if kind != K_LOAD && kind != K_OP {
                continue;
            }
            for k in 0..vf {
                let v = lane(cx, n, k);
                if !goes(cx, v) {
                    continue;
                }
                count += 1;
                if kind == K_OP {
                    let ir_val_v1 = ir_val(cx, (*cx.insts.add(v as usize)).a);
                    add_dead_use(cx, ir_val_v1);
                    if (*cx.insts.add(v as usize)).op != Neg {
                        let ir_val_v2 = ir_val(cx, (*cx.insts.add(v as usize)).b);
                        add_dead_use(cx, ir_val_v2);
                    }
                }
            }
        }
        count
    }
}

// The memory an instruction accesses: base, offset, size (for a load or a
// store); false for other instructions.
fn access(cx: &mut FnCtx<Comp>, v: i64, base: &mut i64, off: &mut i64, size: &mut i64,
    pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op != Load && op != Store {
            return false;
        }
        let mut o = (*cx.insts.add(v as usize)).imm;
        let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).a);
        let address_base_v = address_base(cx, ir_val_v, &mut o);
        *base = ir_val(cx, address_base_v);
        *off = o;
        *size = type_size(if op == Load { (*cx.insts.add(v as usize)).ty }
            else { (*cx.insts.add(v as usize)).imm2 }, pcx);
        true
    }
}

fn overlap(cx: &mut FnCtx<Comp>, v: i64, w: i64, pcx: &Ctx<Comp>) -> bool {
    let mut b1: i64 = 0;
    let mut o1: i64 = 0;
    let mut s1: i64 = 0;
    let mut b2: i64 = 0;
    let mut o2: i64 = 0;
    let mut s2: i64 = 0;
    access(cx, v, &mut b1, &mut o1, &mut s1, pcx);
    access(cx, w, &mut b2, &mut o2, &mut s2, pcx);
    may_alias(cx, b1, o1, s1, b2, o2, s2, pcx)
}

fn in_group(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    for k in 0..cx.g_vf {
        if cx.g_stores[k as usize] == v {
            return true;
        }
    }
    false
}

fn in_tree_load(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    for n in 0..cx.n_kind.len() as i64 {
        if is_tree_load(cx, n) {
            for k in 0..cx.g_vf {
                if lane(cx, n, k) == v {
                    return true;
                }
            }
        }
    }
    false
}

// Whether moving the tree's loads and the group's stores down to the last
// store `last` keeps every access's value (see the top).
fn memory_allows(cx: &mut FnCtx<Comp>, last: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let p = pos_of(cx, last);
        // (From the first access moved.)
        let mut first = p;
        for k in 0..cx.g_vf {
            if pos_of(cx, cx.g_stores[k as usize]) < first {
                first = pos_of(cx, cx.g_stores[k as usize]);
            }
        }
        for n in 0..cx.n_kind.len() as i64 {
            if is_tree_load(cx, n) {
                for k in 0..cx.g_vf {
                    let lane_v1 = lane(cx, n, k);
                    let pos_of_v = pos_of(cx, lane_v1);
                    if pos_of_v < first {
                        let lane_v = lane(cx, n, k);
                        first = pos_of(cx, lane_v);
                    }
                }
            }
        }
        let mut x = (*cx.blocks.add(cx.g_block as usize)).first;
        while x != 0 && x != last {
            let q = pos_of(cx, x);
            if q < first {
                x = (*cx.insts.add(x as usize)).next;
                continue;
            }
            let op = (*cx.insts.add(x as usize)).op;
            let group = op == Store && in_group(cx, x);
            let tree = op == Load && in_tree_load(cx, x);
            if op == Load || op == Store {
                for k in 0..cx.g_vf {
                    // A moved store against an access after it (the tree's
                    // loads: below).
                    let s = cx.g_stores[k as usize];
                    if pos_of(cx, s) < q && !group && !tree && overlap(cx, s, x, pcx) {
                        return false;
                    }
                }
                for n in 0..cx.n_kind.len() as i64 {
                    if !is_tree_load(cx, n) {
                        continue;
                    }
                    for k in 0..cx.g_vf {
                        let l = lane(cx, n, k);
                        // A moved load against a store after it, and against a
                        // store of the group before it (whose value it read).
                        if op == Store && !group && pos_of(cx, l) < q && overlap(cx, x, l, pcx) {
                            return false;
                        }
                        if group && q < pos_of(cx, l) && overlap(cx, x, l, pcx) {
                            return false;
                        }
                    }
                }
            } else if (op.has_side_effect() || op.is_call()) && q < p {
                return false;
            }
            x = (*cx.insts.add(x as usize)).next;
        }
        true
    }
}

// The vector of node n, made before instruction `at`.
fn emit_node(cx: &mut FnCtx<Comp>, n: i64, at: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (cx.n_value[n as usize]) != 0 {
            return (cx.n_value[n as usize]);
        }
        let vt = cx.g_vt;
        let kind = (cx.n_kind[n as usize]);
        let x = lane(cx, n, 0);
        let mut v: i64 = 0;
        if kind == K_SPLAT {
            v = ir_make(cx, VSplat, vt, x, 0, 0, pcx);
            ir_insert_before(cx, at, v);
        } else if kind == K_LOAD {
            let ir_val_v = ir_val(cx, (*cx.insts.add(x as usize)).a);
            v = ir_make(cx, Load, vt, ir_val_v, 0, (*cx.insts.add(x as usize)).imm, pcx);
            ir_insert_before(cx, at, v);
        } else if kind == K_OP {
            let a = emit_node(cx, (cx.n_a[n as usize]), at, pcx);
            let op = (*cx.insts.add(x as usize)).op;
            if op == Neg {
                v = ir_make(cx, VNeg, vt, a, 0, 0, pcx);
            } else {
                let b = emit_node(cx, (cx.n_b[n as usize]), at, pcx);
                v = ir_make(cx, VBin, vt, a, b, op as i64, pcx);
            }
            ir_insert_before(cx, at, v);
        } else {
            v = ir_make(cx, VSplat, vt, x, 0, 0, pcx);
            ir_insert_before(cx, at, v);
            for k in 1..cx.g_vf {
                let lane_v = lane(cx, n, k);
                let w = ir_make(cx, VIns, vt, v, lane_v, k, pcx);
                ir_insert_before(cx, at, w);
                v = w;
            }
        }
        (cx.n_value[n as usize]) = v;
        v
    }
}

// Tries the group G_STORES (lanes in order of offset); whether it was
// vectorized.
fn try_group(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        cx.n_lanes.clear();
        cx.n_kind.clear();
        cx.n_a.clear();
        cx.n_b.clear();
        cx.n_value.clear();
        let mut values: [i64; 16] = [0i64; 16];
        let mut last = cx.g_stores[0];
        for k in 0..cx.g_vf {
            values[k as usize] = ir_val(cx, (*cx.insts.add(cx.g_stores[k as usize] as usize)).b);
            if pos_of(cx, cx.g_stores[k as usize]) > pos_of(cx, last) {
                last = cx.g_stores[k as usize];
            }
        }
        let root = build(cx, values.as_mut_ptr() as *mut i64, 0, pcx);
        if root < 0 || (cx.n_kind[root as usize]) == K_GATHER {
            return false;
        }
        let removed = scalars_removed(cx);
        cx.n_seen.clear();
        for _ in 0..cx.n_kind.len() as i64 {
            cx.n_seen.push(0);
        }
        let cost = 1 + tree_cost(cx, root, pcx);
        // (The loads that stay in the tree: N_SEEN 2.)
        reach(cx, root);
        if removed <= cost || !memory_allows(cx, last, pcx) {
            return false;
        }
        let v = emit_node(cx, root, last, pcx);
        let ir_val_v = ir_val(cx, (*cx.insts.add(cx.g_stores[0] as usize)).a);
        let s = ir_make(cx, Store, 0, ir_val_v, v,
            (*cx.insts.add(cx.g_stores[0] as usize)).imm, pcx);
        (*cx.insts.add(s as usize)).imm2 = cx.g_vt;
        ir_insert_before(cx, last, s);
        for k in 0..cx.g_vf {
            ir_unlink(cx, cx.g_stores[k as usize]);
        }
        true
    }
}

// Looks for groups in block b; whether any was vectorized.
fn slp_block(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        grow_tables(cx);
        cx.slp_stamp += 1;
        let mut stores = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut i: i64 = 0;
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            if v < cx.table_size {
                (*cx.pos.add(v as usize)) = i;
                (*cx.pos_stamp.add(v as usize)) = cx.slp_stamp;
            }
            if (*cx.insts.add(v as usize)).op == Store
                && lane_type((*cx.insts.add(v as usize)).imm2) != 0
                && stores.len() as i64 < SLP_MAX_STORES {
                stores.push(v);
            }
            i += 1;
            v = (*cx.insts.add(v as usize)).next;
        }
        let mut changed = false;
        if stores.len() as i64 < 2 {
            free(stores.data as *mut u8);
            return false;
        }
        cx.g_block = b;
        for s in 0..stores.len() as i64 {
            let st = (stores[s as usize]);
            if (*cx.insts.add(st as usize)).block != b {
                continue;
            }
            let ty = (*cx.insts.add(st as usize)).imm2;
            let size = type_size(ty, pcx);
            let vf = 16 / size;
            let mut off0: i64 = 0;
            let mut b0: i64 = 0;
            let mut s0: i64 = 0;
            access(cx, st, &mut b0, &mut off0, &mut s0, pcx);
            // The other lanes, at off0 + k * size.
            let mut found: i64 = 1;
            cx.g_stores[0] = st;
            for k in 1..vf {
                let mut lane_store: i64 = 0;
                for t in 0..stores.len() as i64 {
                    let w = (stores[t as usize]);
                    if w == st || (*cx.insts.add(w as usize)).block != b
                        || (*cx.insts.add(w as usize)).imm2 != ty {
                        continue;
                    }
                    let mut bw: i64 = 0;
                    let mut ow: i64 = 0;
                    let mut sw: i64 = 0;
                    access(cx, w, &mut bw, &mut ow, &mut sw, pcx);
                    if bw == b0 && ow == off0 + k * size {
                        lane_store = w;
                    }
                }
                if lane_store == 0 {
                    break;
                }
                cx.g_stores[k as usize] = lane_store;
                found += 1;
            }
            if found != vf {
                continue;
            }
            cx.g_vf = vf;
            cx.g_elem = ty;
            cx.g_vt = vector_type(lane_type(ty), vf, pcx);
            if cx.g_vt == 0 {
                continue;
            }
            if try_group(cx, pcx) {
                changed = true;
                // (Positions: the new instructions have none, which the
                // later groups' checks treat as outside; renumber.)
                grow_tables(cx);
                cx.slp_stamp += 1;
                let mut j: i64 = 0;
                let mut x = (*cx.blocks.add(b as usize)).first;
                while x != 0 {
                    if x < cx.table_size {
                        (*cx.pos.add(x as usize)) = j;
                        (*cx.pos_stamp.add(x as usize)) = cx.slp_stamp;
                    }
                    j += 1;
                    x = (*cx.insts.add(x as usize)).next;
                }
            }
        }
        free(stores.data as *mut u8);
        changed
    }
}

// USES, POS and POS_STAMP, indexed by instruction, as large as the
// function's instructions are now, with room for a half more, their
// contents kept. (0.25: also grown when slp_block's new instructions pass
// the size, so that every instruction has a position; a size left by an
// earlier function in this context once decided which did, and so the
// code, by the threads' schedule.)
fn grow_tables(cx: &mut FnCtx<Comp>) {
    unsafe {
        if cx.table_size < cx.inst_count {
            let size = cx.inst_count + cx.inst_count / 2;
            let uses = alloc_array::<i64>(size);
            let pos = alloc_array::<i64>(size);
            let stamp = alloc_array::<i64>(size);
            if cx.table_size > 0 {
                memcpy(uses as *mut u8, cx.slp_uses as *mut u8, (cx.table_size * 8) as u64);
                memcpy(pos as *mut u8, cx.pos as *mut u8, (cx.table_size * 8) as u64);
                memcpy(stamp as *mut u8, cx.pos_stamp as *mut u8, (cx.table_size * 8) as u64);
                free(cx.slp_uses as *mut u8);
                free(cx.pos as *mut u8);
                free(cx.pos_stamp as *mut u8);
            }
            cx.table_size = size;
            cx.slp_uses = uses;
            cx.pos = pos;
            cx.pos_stamp = stamp;
        }
    }
}

// Counts the uses of every instruction of fi (the tables grown first).
fn count_uses(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        grow_tables(cx);
        // (0.25: every instruction, not only those in a block: what an
        // earlier function left here is never read)
        for v in 0..cx.inst_count {
            (*cx.slp_uses.add(v as usize)) = 0;
        }
        cx.slp_counted = cx.inst_count;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let w = ir_operand(cx, v, k);
                    if w != 0 {
                        (*cx.slp_uses.add(ir_val(cx, w) as usize)) += 1;
                    }
                }
                v = (*cx.insts.add(v as usize)).next;
            }
            if (*cx.blocks.add(b as usize)).cond != 0 {
                (*cx.slp_uses.add(ir_val(cx, (*cx.blocks.add(b as usize)).cond) as usize)) += 1;
            }
        }
    }
}

// Whether block b has two stores of one lane type, one base and adjacent
// offsets (a cheap first look).
fn has_candidates(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut seen: [i64; 48] = [0i64; 48];
        let mut n: i64 = 0;
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 && n < 16 {
            if (*cx.insts.add(v as usize)).op == Store
                && lane_type((*cx.insts.add(v as usize)).imm2) != 0 {
                let ty = (*cx.insts.add(v as usize)).imm2;
                let mut off = (*cx.insts.add(v as usize)).imm;
                let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).a);
                let address_base_v = address_base(cx, ir_val_v, &mut off);
                let base = ir_val(cx, address_base_v);
                let size = type_size(ty, pcx);
                for k in 0..n {
                    if seen[(3 * k) as usize] == base && seen[(3 * k + 2) as usize] == ty
                        && (seen[(3 * k + 1) as usize] == off + size
                            || seen[(3 * k + 1) as usize] + size == off) {
                        return true;
                    }
                }
                seen[(3 * n) as usize] = base;
                seen[(3 * n + 1) as usize] = off;
                seen[(3 * n + 2) as usize] = ty;
                n += 1;
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        false
    }
}

// Vectorizes the store groups of fi; returns whether any was.
pub fn slp_vectorize(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !pcx.slp {
            return false;
        }
        ir_enter(cx, fi, pcx);
        let mut any = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed == 0 && has_candidates(cx, b, pcx) {
                any = true;
            }
        }
        if !any {
            return false;
        }
        find_escaping_slots(cx, fi, pcx);
        count_uses(cx, fi);
        let mut changed = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).removed == 0 && has_candidates(cx, b, pcx)
                && slp_block(cx, b, pcx) {
                changed = true;
                count_uses(cx, fi);
            }
        }
        changed
    }
}
