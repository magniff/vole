// Inlining, bottom-up over the call graph: functions are processed by
// strongly connected components (Tarjan's algorithm yields them callees
// first), so a callee is already optimized when it is inlined, and calls
// within a component (recursion) are never inlined. Whether a call is
// inlined is a cost model (see should_inline and docs/optimizer.md): the
// callee's size, less a bonus for the constant arguments that decide
// something in it and the cost of the call itself, against a threshold
// that grows with the call site's loop depth and is zero in cold blocks;
// a function's only call site takes up to INLINE_ONCE; and what a caller
// takes in is bounded by its own room (INLINE_ROOM), so that a decision
// depends on the call, the callee and the caller alone. Inlining iterates:
// the inlined copies' calls are considered again once the copies are
// simplified (see inline_rounds).

use crate::back::abi::{AbiClass, conv_classify, conv_returns_through_pointer, fn_uses_c};
use crate::back::codecache::{R_DEC, R_IR, R_RT, R_SIZE, R_STATIC, cc_note, cc_note_calls};
use crate::back::regalloc::intervals::calls_returns_twice;
use crate::base::{buf_byte, buf_int, buf_new, buf_str, sized_table, sym_name, table_reset};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::timer::{P_FN_SIZE, P_INLINE, pass_done};
use crate::front::ast::FN_CLOSURE;
use crate::front::types::{fn_attr_cold, fn_attr_inline, fn_param, is_void, type_size};
use crate::gen0::gen::fn_is_global;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::gvn::has_ref_facts;
use crate::middle::ipo::devirtualize;
use crate::middle::ir::{
    Op, Term, fn_block, fn_block_count, fn_entry, ir_append, ir_arg, ir_enter, ir_make,
    ir_new_block, ir_new_slot, ir_prepend, ir_replace, ir_set_arg, ir_stored, ir_unlink, ir_val,
};
use crate::middle::ir::cfg::{copy_terminator, ir_switch_no_preds, pred_index, succ, succ_count};
use crate::middle::loops::{analyze_loops, block_array, innermost_loop};
use crate::middle::lower::ssa::ssa_undef;
use crate::middle::opt::{optimize_after_inlining, resolve_all, simplify_function};
use crate::middle::parallel::fn_facts_ready;
use crate::middle::profile::{is_cold_block, is_hot_count};

const INLINE_SMALL: i64 = 30;
const INLINE_ONCE: i64 = 400;
const INLINE_BUDGET: i64 = 3000;
const INLINE_ROUNDS: i64 = 3;

// (0.14) The cost of a callee inlined whatever the budgets (see
// should_inline).
const INLINE_TINY: i64 = 2;
// The size a hot call site's callee may have (0.10, profiles).
const INLINE_HOT: i64 = 240;
// The bonus per constant argument whose parameter decides a branch, a
// switch or an arithmetic operation of the callee.
const CONST_ARG_BONUS: i64 = 10;

// ---- Inlining hints ----
//
// `#[inline]`, `#[inline(never)]` and `#[cold]` (the front end's
// fn_attr_inline: 1, -1 or 0; fn_attr_cold; types.vl).

const HINT_ALWAYS: i64 = 1;
const HINT_NEVER: i64 = -1;

// (0.17) The inliner's caches of function information (FN_RT, deciders),
// for IRFUNC_COUNT functions, none known.
pub fn init_fn_caches(pcx: &mut Ctx<Comp>) {
    pcx.fn_rt.reset(pcx.irfunc_count + 1, 0);
    pcx.fn_deciders_start.reset(pcx.irfunc_count + 1, 0);
    pcx.fn_deciders.reset((pcx.irfunc_count + 1));
    for fi in 0..pcx.irfunc_count {
        pcx.fn_rt.set(fi, -1);
        pcx.fn_deciders_start.set(fi, -1);
    }
}

// Forgets what the caches know of fi (it changed).
pub fn forget_fn_caches(fi: i64, pcx: &Ctx<Comp>) {
    pcx.fn_rt.set(fi, -1);
    pcx.fn_deciders_start.set(fi, -1);
}

// The number of instructions that turn into code on the paths that
// return. (0.29) Not the panic blocks' (panic_blocks): a bounds check is
// its compare and branch here, and what reports the failure is code the
// function runs at most once, laid out away from the rest. Counted, it
// made a checked accessor (`t.v[i]`: 8) twice its unchecked form, and a
// table turned into a Vec lost the inlining of every accessor of it.
pub fn func_size(cx: &mut FnCtx<Comp>, fi: i64) -> i64 {
    let mut size: i64 = 0;
    let panics = panic_blocks(cx, fi);
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 || panics[b as usize] {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            if !(cx.insts[v as usize]).op.is_remat()
                && (cx.insts[v as usize]).op != Op::Param {
                size += 1;
            }
            v = (cx.insts[v as usize]).next;
        }
        size += 1;
    }
    size
}

// (0.29) The blocks of function fi (the current one) that only lead to a
// panic, by block id: a block that ends in UNREACH (after a call that does
// not return: a failed check's report, `panic`, `exit`), and a block
// every successor of which is one. They are cold and run at most once:
// the inliner counts neither their instructions (func_size) nor their
// calls (callee_flags, has_calls). Not a loop, nor what leads to one:
// whether a loop with a check in it ever ends is not asked. And none in a
// function that never returns (it has no RET): that one is all report,
// and its size is what a call of it brings (counted as nothing, `panic`
// itself would be inlined into every report).
pub fn panic_blocks(cx: &mut FnCtx<Comp>, fi: i64) -> Vec<bool, Comp> {
    let mut panics: Vec<bool, Comp> = Vec::new_in(Comp {});
    panics.resize(cx.blocks.len() as i64 as usize + 1, false);
    let mut returns = false;
    let mut changed = false;
    for bix in 0..fn_block_count(cx, fi) {
        let b = fn_block(cx, fi, bix);
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        if (cx.blocks[b as usize]).term == Term::Ret {
            returns = true;
        } else if (cx.blocks[b as usize]).term == Term::Unreach {
            panics[b as usize] = true;
            changed = true;
        }
    }
    if !returns {
        panics.clear();
        panics.resize(cx.blocks.len() as i64 as usize + 1, false);
        return panics;
    }
    while changed {
        changed = false;
        let mut i = fn_block_count(cx, fi);
        // (backwards: a block is mostly after the ones that reach it)
        while i > 0 {
            i -= 1;
            let b = (fn_block(cx, fi, i));
            let n = succ_count(cx, b);
            if (cx.blocks[b as usize]).removed != 0 || panics[b as usize] || n == 0 {
                continue;
            }
            let mut all = true;
            for k in 0..n {
                if !panics[succ(cx, b, k) as usize] {
                    all = false;
                    break;
                }
            }
            if all {
                panics[b as usize] = true;
                changed = true;
            }
        }
    }
    panics
}

// The IR function called by direct call v, or -1.
pub fn ir_callee(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    if (cx.insts[v as usize]).op != Op::Call {
        return -1;
    }
    let g = (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1;
    // (0.18.1: what the task saw of g, for the code cache)
    cc_note(cx, R_STATIC, g, pcx);
    g
}

// Counts the call sites and address uses of every function.
pub fn count_call_sites(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    for fi in 0..pcx.irfunc_count {
        (pcx.fn_calls[fi as usize]) = 0;
        (pcx.fn_address[fi as usize]) = 0;
    }
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) == 0 {
            continue;
        }
        ir_enter(cx, fi, pcx);
        for i in 0..fn_block_count(cx, fi) {
            let b = (fn_block(cx, fi, i));
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let g = ir_callee(cx, v, pcx);
                if g >= 0 {
                    (pcx.fn_calls[g as usize]) += 1;
                }
                if (cx.insts[v as usize]).op == Op::FAddr
                    && (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) != 0 {
                    (pcx.fn_address[
                        ((pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1) as usize]) = 1;
                }
                v = (cx.insts[v as usize]).next;
            }
        }
    }
}

// ---- Strongly connected components (Tarjan) ----

// The direct callees of fi (with repeats), in `out`.
pub fn callees(cx: &mut FnCtx<Comp>, fi: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    out.clear();
    ir_enter(cx, fi, pcx);
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let g = ir_callee(cx, v, pcx);
            if g >= 0 {
                out.push(g);
            }
            v = (cx.insts[v as usize]).next;
        }
    }
}

pub fn compute_sccs(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    let n = pcx.irfunc_count;
    let mut index: Vec<i64, Comp> = Vec::new_in(Comp {});
    index.resize((n + 1) as usize, 0);
    let mut low: Vec<i64, Comp> = Vec::new_in(Comp {});
    low.resize((n + 1) as usize, 0);
    let mut on_stack: Vec<i64, Comp> = Vec::new_in(Comp {});
    on_stack.resize((n + 1) as usize, 0);
    // Adjacency, computed once (CSR).
    let mut adj_start: Vec<i64, Comp> = Vec::new_in(Comp {});
    adj_start.resize((n + 2) as usize, 0);
    let mut adj: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut scratch: Vec<i64, Comp> = Vec::new_in(Comp {});
    for fi in 0..n {
        (adj_start[fi as usize]) = adj.len() as i64;
        callees(cx, fi, &mut scratch, pcx);
        for i in 0..scratch.len() as i64 {
            adj.push((scratch[i as usize]));
        }
    }
    (adj_start[n as usize]) = adj.len() as i64;
    let mut stack: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut calls: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut next_index: i64 = 1;
    let mut scc_id: i64 = 0;
    pcx.scc_order.clear();
    for root in 0..n {
        if (index[root as usize]) != 0 {
            continue;
        }
        // (node, next edge) frames.
        calls.push(root);
        calls.push((adj_start[root as usize]));
        (index[root as usize]) = next_index;
        (low[root as usize]) = next_index;
        next_index += 1;
        stack.push(root);
        (on_stack[root as usize]) = 1;
        while calls.len() as i64 > 0 {
            let top = calls.len() as i64 - 2;
            let v = (calls[top as usize]);
            let e = (calls[(top + 1) as usize]);
            if e < (adj_start[(v + 1) as usize]) {
                (calls[(top + 1) as usize]) = e + 1;
                let w = (adj[e as usize]);
                if (index[w as usize]) == 0 {
                    (index[w as usize]) = next_index;
                    (low[w as usize]) = next_index;
                    next_index += 1;
                    stack.push(w);
                    (on_stack[w as usize]) = 1;
                    calls.push(w);
                    calls.push((adj_start[w as usize]));
                }
                else if (on_stack[w as usize]) != 0
                    && (index[w as usize]) < (low[v as usize]) {
                    (low[v as usize]) = (index[w as usize]);
                }
                continue;
            }
            calls.truncate(calls.len() - 2);
            if calls.len() as i64 > 0 {
                let parent = (calls[(calls.len() as i64 - 2) as usize]);
                if (low[v as usize]) < (low[parent as usize]) {
                    (low[parent as usize]) = (low[v as usize]);
                }
            }
            if (low[v as usize]) == (index[v as usize]) {
                loop {
                    let w = stack.pop().unwrap();
                    (on_stack[w as usize]) = 0;
                    (pcx.fn_scc[w as usize]) = scc_id;
                    pcx.scc_order.push(w);
                    if w == v {
                        break;
                    }
                }
                scc_id += 1;
            }
        }
    }
}

// ---- The policy ----

// Whether block b is cold: it leads only to a panic (it ends in UNREACH),
// or it calls a #[cold] function.
fn block_is_cold(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    if (cx.blocks[b as usize]).term == Term::Unreach {
        return true;
    }
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0 {
        if (cx.insts[v as usize]).op == Op::Call
            && fn_attr_cold((cx.insts[v as usize]).imm, pcx) {
            return true;
        }
        v = (cx.insts[v as usize]).next;
    }
    false
}

fn mark_call_sites(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    resolve_all(cx, fi);
    analyze_loops(cx, fi);
    block_array(&mut cx.site_depth, cx.blocks.len());
    block_array(&mut cx.site_cold, cx.blocks.len());
    cx.site_nblocks = cx.blocks.len() as i64;
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let l = innermost_loop(cx, b);
        (cx.site_depth[b as usize]) = if l >= 0 { (cx.lp_depth[l as usize]) }
            else { 0 };
        (cx.site_cold[b as usize]) = if block_is_cold(cx, b, pcx) { 1 } else { 0 };
    }
}

// The operand of a call holding the value of PARAM instruction p of
// callee g (its piece, for an aggregate passed in pieces), or -1.
pub fn param_operand(cx: &mut FnCtx<Comp>, g: i64, p: i64, pcx: &Ctx<Comp>) -> i64 {
    let index = (cx.insts[p as usize]).imm;
    let piece = (cx.insts[p as usize]).imm2;
    if index < 0 {
        return -1;
    }
    let callee_f = pcx.ir_fn[g as usize];
    let mut k: i64 = 0;
    for q in 0..index {
        let ty = fn_param(callee_f, q, pcx);
        if !is_void(ty) {
            k += if conv_classify(cx, fn_uses_c(callee_f, pcx), ty, pcx)
                == AbiClass::Pieces { cx.abi_piece_count } else { 1 };
        }
    }
    k + if piece > 0 { piece - 1 } else { 0 }
}

// Whether value p decides something in function g: it is compared,
// switched on, or an operand of a multiplication, division, shift or mask
// (a constant there folds in the copy).
fn decides(cx: &mut FnCtx<Comp>, g: i64, p: i64) -> bool {
    for i in 0..fn_block_count(cx, g) {
        let b = (fn_block(cx, g, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        if (cx.blocks[b as usize]).term == Term::Switch
            && ir_val(cx, (cx.blocks[b as usize]).cond) == p {
            return true;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let op = (cx.insts[v as usize]).op;
            if op == Op::Cmp || op == Op::Mul || op == Op::Div || op == Op::Rem
                || op == Op::Shl || op == Op::Shr || op == Op::And {
                if ir_val(cx, (cx.insts[v as usize]).a) == p
                    || ir_val(cx, (cx.insts[v as usize]).b) == p {
                    return true;
                }
            }
            v = (cx.insts[v as usize]).next;
        }
    }
    false
}

// The cost of inlining callee g at call `call`: its size, less the bonus
// for constant arguments that decide something in it, less the call's own
// cost (its argument moves, the call and the result). (0.17: which of g's
// parameters decide something is found once g is optimized, deciders.)
fn inline_cost(cx: &mut FnCtx<Comp>, g: i64, call: i64, pcx: &Ctx<Comp>) -> i64 {
    let nargs = (cx.insts[call as usize]).nargs;
    cc_note(cx, R_SIZE, g, pcx);
    let mut cost = (pcx.fn_size.get(g));
    deciders(cx, g, pcx);
    for i in 0..pcx.fn_deciders.count(g) {
        let k = pcx.fn_deciders.at(g, i);
        if k < nargs
            && { let at_arg1 = ir_val(cx, ir_arg(cx, call, k)); is_const(cx, at_arg1) } {
            cost -= CONST_ARG_BONUS;
        }
    }
    cost - 2 - nargs
}

// The call operands of g's parameters that decide something in it (one
// per parameter instruction, in order): FN_DECIDERS[g], found once g is
// optimized (reset with FN_RT; 0.18.1: by g's task, finish_component).
fn deciders(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) {
    if (pcx.fn_deciders_start.get(g)) < 0 {
        let back = cx.ir_cur;
        ir_enter(cx, g, pcx);
        pcx.fn_deciders_start.set(g, 0);
        pcx.fn_deciders.clear(g);
        let entry = fn_entry(cx, g);
        let mut v = (cx.blocks[entry as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op == Op::Param {
                let k = param_operand(cx, g, v, pcx);
                if k >= 0 && decides(cx, g, v) {
                    pcx.fn_deciders.push(g, k);
                }
            }
            v = (cx.insts[v as usize]).next;
        }
        ir_enter(cx, back, pcx);
    }
    cc_note(cx, R_DEC, g, pcx);
}

fn site_depth(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    if b < cx.site_nblocks { (cx.site_depth[b as usize]) } else { 0 }
}

fn site_cold(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    b < cx.site_nblocks && (cx.site_cold[b as usize]) != 0
}

// Whether optimized function g calls a function that returns twice (see
// FN_RT).
fn callee_returns_twice(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    (callee_flags(cx, g, pcx) & RT_RETURNS_TWICE) != 0
}

// Whether optimized function g calls nothing on a path that returns
// (0.17: see should_inline; 0.29: its panic blocks may call).
fn callee_is_leaf(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    (callee_flags(cx, g, pcx) & RT_CALLS) == 0
}

// FN_RT[g], computed once g is optimized.
fn callee_flags(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> i64 {
    if (pcx.fn_rt.get(g)) < 0 {
        let back = cx.ir_cur;
        ir_enter(cx, g, pcx);
        let mut flags: i64 = if calls_returns_twice(cx, g, pcx) { RT_RETURNS_TWICE } else { 0 };
        // (0.29) A call in a panic block does not end leafness: the
        // report of a failed check is not on any path that returns.
        let panics = panic_blocks(cx, g);
        for bix in 0..fn_block_count(cx, g) {
            let b = fn_block(cx, g, bix);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            if panics[b as usize] {
                flags = flags | RT_PANICS;
            } else {
                let mut v = (cx.blocks[b as usize]).first;
                while v != 0 {
                    if (cx.insts[v as usize]).op.is_call() {
                        flags = flags | RT_CALLS;
                    }
                    v = (cx.insts[v as usize]).next;
                }
            }
        }
        pcx.fn_rt.set(g, flags);
        ir_enter(cx, back, pcx);
    }
    cc_note(cx, R_RT, g, pcx);
    (pcx.fn_rt.get(g))
}

const RT_RETURNS_TWICE: i64 = 1;
const RT_CALLS: i64 = 2;
// (0.29) It has panic blocks, which its size leaves out (func_size).
const RT_PANICS: i64 = 4;
// (0.17) A leaf this small is not charged to its caller's room (see
// inline_rule). (0.29: 16, from 6: a checked accessor of a Vec in a
// struct is 8 without its report, one that also tests its argument 12.)
const INLINE_LEAF: i64 = 16;
// (0.29) What a function may grow by through the calls charged to it
// (inline_rule, caller_room): the callees that are neither tiny, nor
// hinted, nor small leaves, nor its only call of a callee of at most
// INLINE_ONCE_FREE. The room is the function's own: what other functions
// inlined, and in which order the program's functions are optimized, does
// not change it. (Until 0.29 the program had one budget, half its size
// again, spent by the components bottom-up: in a large program it was
// gone a fifth of the way up the call graph, and whether a function got
// any inlining depended on its depth there.)
const INLINE_ROOM: i64 = 40;
const INLINE_ONCE_FREE: i64 = 120;

// (0.29) The rules of inline_rule: above 0 the call is inlined, below it
// stays; what VOLE_INLINE_LOG's lines name (rule_name).
const R_HINT: i64 = 1;
const R_TINY: i64 = 2;
const R_CLOSURE_ONCE: i64 = 3;
const R_COLD_FREE: i64 = 4;
const R_ONCE: i64 = 5;
const R_HOT: i64 = 6;
const R_SMALL: i64 = 7;
const R_SAME: i64 = -1;
const R_NOT_READY: i64 = -2;
const R_RETURNS_TWICE: i64 = -3;
const R_NEVER: i64 = -4;
const R_CALLER_BIG: i64 = -5;
const R_ROOM: i64 = -6;
const R_COLD: i64 = -7;
const R_BIG: i64 = -8;

fn rule_name(rule: i64) -> *mut u8 {
    if rule == R_HINT { c"hint" }
    else if rule == R_TINY { c"tiny" }
    else if rule == R_CLOSURE_ONCE { c"closure-once" }
    else if rule == R_COLD_FREE { c"cold-free" }
    else if rule == R_ONCE { c"once" }
    else if rule == R_HOT { c"hot" }
    else if rule == R_SMALL { c"small" }
    else if rule == R_RETURNS_TWICE { c"no:returns-twice" }
    else if rule == R_NEVER { c"no:never-or-cold-fn" }
    else if rule == R_CALLER_BIG { c"no:caller-big" }
    else if rule == R_ROOM { c"no:room" }
    else if rule == R_COLD { c"no:cold-site" }
    else if rule == R_BIG { c"no:big" }
    else { c"no:other" }
}

// The rule that decides whether call `call` of function fi, to g, is
// inlined (one of the R_ constants).
fn inline_rule(cx: &mut FnCtx<Comp>, fi: i64, g: i64, call: i64, pcx: &Ctx<Comp>) -> i64 {
    if g == fi || (pcx.fn_scc[g as usize]) == (pcx.fn_scc[fi as usize])
        || (pcx.fn_live[g as usize]) == 0 {
        return R_SAME;
    }
    // (0.18.1) Only a callee whose component is done (below this one: a
    // call made direct may call any function).
    if !fn_facts_ready(cx, g, true, pcx) {
        return R_NOT_READY;
    }
    cc_note(cx, R_SIZE, g, pcx);
    // A function calling setjmp (or the like) keeps its own frame, and
    // its callers theirs (see regalloc.vl).
    if cx.caller_rt || callee_returns_twice(cx, g, pcx) {
        return R_RETURNS_TWICE;
    }
    let gf = pcx.ir_fn[g as usize];
    let hint = fn_attr_inline(gf, pcx);
    if hint == HINT_NEVER || fn_attr_cold(gf, pcx) {
        return R_NEVER;
    }
    if hint == HINT_ALWAYS {
        return R_HINT;
    }
    // (0.14) A callee about as big as its call is inlined whatever the
    // caller's size: the chain of small closures an iterator chain calls,
    // `as_slice`.
    // (0.17: computed once; it scans the callee for what each constant
    // argument decides)
    let cost = inline_cost(cx, g, call, pcx);
    if cost <= INLINE_TINY {
        return R_TINY;
    }
    let b = (cx.insts[call as usize]).block;
    let once = calls_left(cx, g, pcx) == 1 && (pcx.fn_address[g as usize]) == 0
        && !fn_is_global(gf, pcx);
    // A closure called once is inlined whatever its size: it is moved,
    // not copied, and its size before its environment is known (the
    // loads through it) says little of what it becomes (a closure
    // calling closures, the fold of an iterator chain).
    if once && is_closure_fn(g, pcx) {
        return R_CLOSURE_ONCE;
    }
    // (0.17) A small leaf is not charged to the caller's room: its
    // code is about its call's (the arguments' moves, the call, the
    // caller-saved registers it clobbers). (0.29) Nor a callee as small
    // called in a loop, leaf or not (`gen.push(c)` at each character).
    let small_leaf = (pcx.fn_size.get(g)) <= INLINE_LEAF
        && (callee_is_leaf(cx, g, pcx) || site_depth(cx, b) >= 1);
    if (pcx.fn_size.get(fi)) + (pcx.fn_size.get(g)) > INLINE_BUDGET {
        return R_CALLER_BIG;
    }
    // (0.29) Nor is the only call of a function that is not large: it
    // is moved, not copied.
    if once && (pcx.fn_size.get(g)) <= INLINE_ONCE_FREE {
        return R_ONCE;
    }
    // (0.10: with a profile, a hot call takes a callee up to INLINE_HOT,
    // whatever the caller's room)
    let cold = site_cold(cx, b) || is_cold_block(cx, b, pcx);
    if !cold && is_hot_count((cx.blocks[b as usize]).count, pcx) && cost <= INLINE_HOT {
        return R_HOT;
    }
    // (0.29) The rest is charged to the caller's own room.
    if !small_leaf
        && (pcx.fn_size.get(fi)) + (pcx.fn_size.get(g))
        > cx.inl_size0 + INLINE_ROOM {
        return R_ROOM;
    }
    // (0.10: with a profile, a call that never ran is cold)
    if cold {
        // In a cold block, only when that makes the program no bigger
        // (0.29: so not a callee with panic blocks, whose size says
        // nothing of them: the report of a failed check would take in
        // the functions it calls, and those theirs).
        if once {
            return R_ONCE;
        }
        return if cost <= 0 && (callee_flags(cx, g, pcx) & RT_PANICS) == 0 { R_COLD_FREE }
            else { R_COLD };
    }
    if once && (pcx.fn_size.get(g)) <= INLINE_ONCE {
        return R_ONCE;
    }
    let depth = site_depth(cx, b);
    let mut threshold = INLINE_SMALL;
    if depth >= 1 {
        threshold *= 2;
    }
    if depth >= 2 {
        threshold *= 2;
    }
    if cost <= threshold { R_SMALL } else { R_BIG }
}

// (0.29) VOLE_INLINE_LOG=FILE, with -j1 and no code cache: a line for each
// call the inliner decides at -O2, in the order it decides them (one
// thread: the same in every build of the same program), tab separated:
// the caller, the callee, the callee's size, the rule (rule_name), the
// site's loop depth, the caller's size then, the caller's component's
// level, the program's size as the component sees it, and the budget.
// tools/inline-log-diff.py compares two.
pub fn inline_log_start(pcx: &mut Ctx<Comp>) {
    pcx.inline_log = -1;
    // UNSAFE: C's getenv, and the first byte of its string.
    // SAFETY: the name is a NUL-terminated literal; getenv gives null or a
    // NUL-terminated string, read only when not null, which the program
    // does not change afterwards (the path is kept for inline_log_end).
    let path = unsafe {
        let p = crate::base::getenv(c"VOLE_INLINE_LOG");
        if p == 0 as *mut u8 || *p == 0 { 0 as *mut u8 } else { p }
    };
    if path == 0 as *mut u8 {
        return;
    }
    pcx.inline_log_path = path;
    if pcx.jobs != 1 {
        buf_write_fd_str(c"note: VOLE_INLINE_LOG is written with -j1 only (and --no-cache)\n");
        return;
    }
    pcx.inline_log = buf_new();
}

fn buf_write_fd_str(s: *mut u8) {
    let b = buf_new();
    buf_str(b, s);
    crate::base::buf_write_fd(b, crate::base::STDERR);
}

// Writes the log (after the bottom-up phase).
pub fn inline_log_end(pcx: &Ctx<Comp>) {
    if pcx.inline_log >= 0 {
        crate::base::buf_write_file(pcx.inline_log, pcx.inline_log_path);
    }
}

fn log_decision(cx: &mut FnCtx<Comp>, fi: i64, g: i64, call: i64, rule: i64, pcx: &Ctx<Comp>) {
    let out = pcx.inline_log;
    buf_str(out, sym_name(pcx.fns[pcx.ir_fn[fi as usize] as usize].name, pcx));
    buf_byte(out, b'\t');
    buf_str(out, sym_name(pcx.fns[pcx.ir_fn[g as usize] as usize].name, pcx));
    buf_byte(out, b'\t');
    buf_int(out, (pcx.fn_size.get(g)));
    buf_byte(out, b'\t');
    buf_str(out, rule_name(rule));
    buf_byte(out, b'\t');
    let b = (cx.insts[call as usize]).block;
    buf_int(out, site_depth(cx, b));
    buf_byte(out, b'\t');
    buf_int(out, (pcx.fn_size.get(fi)));
    buf_byte(out, b'\t');
    buf_int(out,
        if cx.cur_comp >= 0 { (pcx.comp_level[cx.cur_comp as usize]) } else { -1 });
    buf_byte(out, b'\t');
    buf_int(out, program_size(cx, pcx));
    buf_byte(out, b'\t');
    buf_int(out, cx.inl_size0 + INLINE_ROOM);
    buf_byte(out, b'\n');
}

// Whether call `call` of function fi, to g, is inlined. (0.29) The rule
// that decided is logged when VOLE_INLINE_LOG is set (inline_log_start).
fn should_inline(cx: &mut FnCtx<Comp>, fi: i64, g: i64, call: i64, pcx: &Ctx<Comp>) -> bool {
    let rule = inline_rule(cx, fi, g, call, pcx);
    if pcx.inline_log >= 0 && rule != R_NOT_READY && rule != R_SAME {
        log_decision(cx, fi, g, call, rule, pcx);
    }
    rule > 0
}

// Whether inlining function g is charged to the budgets only for what it
// adds once simplified (see inline_calls): `#[inline]` functions (the std
// iterator methods are) and closures' functions.
fn counted_after(g: i64, pcx: &Ctx<Comp>) -> bool {
    fn_attr_inline(pcx.ir_fn[g as usize], pcx) == HINT_ALWAYS
        || is_closure_fn(g, pcx)
}

// Whether IR function g is a closure's (FN_CLOSURE, 0.14).
fn is_closure_fn(g: i64, pcx: &Ctx<Comp>) -> bool {
    let node = pcx.fns[pcx.ir_fn[g as usize] as usize].node;
    node != 0 && (pcx.nodes[node as usize].p & FN_CLOSURE) != 0
}

// Inlines the calls of function fi that should be, in one pass over its
// blocks. Returns whether any was.
pub fn inline_calls(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    devirtualize(cx, fi, pcx);
    mark_call_sites(cx, fi, pcx);
    cx.caller_rt = calls_returns_twice(cx, fi, pcx);
    let mut changed = false;
    let mut i: i64 = 0;
    // Blocks appended by inlining are visited too, except the callees'
    // copies (BLOCKS[b].loop_depth == 1): their calls wait for the next
    // round, once the copies are simplified.
    while i < fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        i += 1;
        if (cx.blocks[b as usize]).removed != 0
            || (cx.blocks[b as usize]).loop_depth == 1 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let next = (cx.insts[v as usize]).next;
            let g = ir_callee(cx, v, pcx);
            if g >= 0 && should_inline(cx, fi, g, v, pcx) {
                // (0.14) A function made to be inlined counts for its size
                // once simplified, when inline_rounds measures it: its
                // size alone, before its arguments are known, would use
                // up the budgets in the middle of an iterator chain.
                if !counted_after(g, pcx) {
                    pcx.fn_size.add(fi, (pcx.fn_size.get(g)));
                    program_grows(cx, (pcx.fn_size.get(g)));
                }
                note_inlined(cx, g);
                // The continuation block keeps the call site's loop depth
                // and coldness.
                let depth = site_depth(cx, b);
                let cold = site_cold(cx, b);
                let cont = inline_call(cx, fi, v, g, pcx);
                set_site(cx, cont, depth, cold);
                changed = true;
                // The rest of this block moved to the continuation block,
                // visited later.
                break;
            }
            v = next;
        }
    }
    for k in 0..fn_block_count(cx, fi) {
        { let at_b = fn_block(cx, fi, k) as usize; cx.blocks[at_b].loop_depth = 0; }
    }
    changed
}

// The count of a block of a callee (that ran `count` times, its entry
// `entry` times) inlined at a call site that ran `site` times (0.10), or
// -1.
fn scaled_count(count: i64, site: i64, entry: i64) -> i64 {
    if count < 0 || site < 0 || entry <= 0 {
        return -1;
    }
    let x = count as f64 * site as f64 / entry as f64;
    if x > 1099511627776.0 { 1099511627776 } else { x as i64 }
}

// Records the loop depth and coldness of a block made after
// mark_call_sites. (0.18.1: the tables grow to cover it; 0.17 recorded it
// only when they covered it already, which depended on the largest
// function optimized before, on this thread.)
fn set_site(cx: &mut FnCtx<Comp>, b: i64, depth: i64, cold: bool) {
    let need = (b + 1) as usize;
    if cx.site_depth.len() < need || cx.site_cold.len() < need {
        // (what they hold is kept; the new entries are 0)
        cx.site_depth.resize(need * 2, 0);
        cx.site_cold.resize(need * 2, 0);
    }
    if b >= cx.site_nblocks {
        for x in cx.site_nblocks..b + 1 {
            (cx.site_depth[x as usize]) = 0;
            (cx.site_cold[x as usize]) = 0;
        }
        cx.site_nblocks = b + 1;
    }
    (cx.site_depth[b as usize]) = depth;
    (cx.site_cold[b as usize]) = if cold { 1 } else { 0 };
}

// Inlining in function fi, in rounds: each round inlines, then simplifies
// (so constants reach the copies) and recounts the function's size; the
// copies' own calls are candidates in the next round. Returns whether
// anything was inlined.
pub fn inline_rounds(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut any = false;
    // (0.29) What the function may grow to through the calls charged
    // to it (INLINE_ROOM).
    cx.inl_size0 = (pcx.fn_size.get(fi));
    for round in 0..INLINE_ROUNDS {
        let inlined = inline_calls(cx, fi, pcx);
        pass_done(P_INLINE, pcx);
        if !inlined {
            break;
        }
        any = true;
        let before = (pcx.fn_size.get(fi));
        optimize_after_inlining(cx, fi, pcx);
        let after = func_size(cx, fi);
        // (0.14: not a function that goes once inlined everywhere)
        if !inlined_everywhere(fi, pcx) {
            program_grows(cx, after - before);
        }
        pcx.fn_size.set(fi, after);
        pass_done(P_FN_SIZE, pcx);
    }
    any
}

// The program's size now (for VOLE_INLINE_LOG; until 0.29 its growth
// budget was made from it).
pub fn start_inlining_budget(pcx: &mut Ctx<Comp>) {
    pcx.program_size = 0;
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) != 0 && !inlined_everywhere(fi, pcx) {
            pcx.program_size += (pcx.fn_size.get(fi));
        }
    }
}

// ---- Inlining one call ----

// The copy of value `v` of the callee (cx.inl_imap; its aux until 0.18.1).
fn mapped(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    if v == 0 { 0 } else { (cx.inl_imap[v as usize]) }
}

// Inlines callee g at call `call` of function fi. Returns the continuation
// block (the instructions after the call). (0.17: g's IR is read through
// its own tables, gt, while fi's are current: ids are each function's.)
fn inline_call(cx: &mut FnCtx<Comp>, fi: i64, call: i64, g: i64, pcx: &Ctx<Comp>) -> i64 {
    // (0.18.1: g is resolved already, finish_component_function and
    // simplify_inlining_leaves; its tables are only read: another thread
    // may be copying it too)
    ir_enter(cx, fi, pcx);
    cc_note(cx, R_IR, g, pcx);
    let gf = ir_stored(g, pcx);
    let gt = &gf.t;
    inline_maps(cx, gt.blocks.len() as i64 + 1, gt.insts.len() as i64 + 1);
    let b = (cx.insts[call as usize]).block;
    // The continuation: the instructions after the call, and b's end.
    let cont = ir_new_block(cx);
    (cx.blocks[cont as usize]).sealed = 1;
    (cx.blocks[cont as usize]).count = (cx.blocks[b as usize]).count;
    let mut v = (cx.insts[call as usize]).next;
    while v != 0 {
        let next = (cx.insts[v as usize]).next;
        ir_unlink(cx, v);
        ir_append(cx, cont, v);
        v = next;
    }
    copy_terminator(cx, cont, b);
    for k in 0..succ_count(cx, cont) {
        let s = succ(cx, cont, k);
        let index = pred_index(cx, s, b);
        ((cx.blocks[s as usize]).preds[index as usize]) = cont;
    }
    // The operand of the call holding each parameter (its first piece,
    // for an aggregate passed in pieces).
    let callee_f = pcx.ir_fn[g as usize];
    let mut param_first: [i64; 64] = [0i64; 64];
    let mut k: i64 = 0;
    for p in 0..pcx.fns[callee_f as usize].param_count {
        let ty = fn_param(callee_f, p, pcx);
        if !is_void(ty) {
            param_first[p as usize] = k;
            k += if conv_classify(cx, fn_uses_c(callee_f, pcx), ty, pcx)
                == AbiClass::Pieces { cx.abi_piece_count } else { 1 };
        }
    }
    // Copy the blocks and instructions.
    let gentry = gf.entry;
    for i in 0..gf.blocks.len() as i64 {
        let gb = gf.blocks[i as usize];
        if (gt.blocks[gb as usize]).removed != 0 {
            continue;
        }
        let nb = ir_new_block(cx);
        (cx.blocks[nb as usize]).sealed = 1;
        (cx.blocks[nb as usize]).loop_depth = 1;
        (cx.blocks[nb as usize]).novec = (gt.blocks[gb as usize]).novec;
        (cx.blocks[nb as usize]).count = scaled_count(
            (gt.blocks[gb as usize]).count,
            (cx.blocks[b as usize]).count,
            (gt.blocks[gentry as usize]).count);
        (cx.inl_bmap[gb as usize]) = nb;
        let mut gv = (gt.blocks[gb as usize]).first;
        while gv != 0 {
            let op = (gt.insts[gv as usize]).op;
            if op == Op::Param {
                let index = (gt.insts[gv as usize]).imm;
                let piece = (gt.insts[gv as usize]).imm2;
                if index < 0 {
                    (cx.inl_imap[gv as usize]) = (cx.insts[call as usize]).c;
                } else {
                    (cx.inl_imap[gv as usize]) = ir_arg(cx, call,
                        param_first[index as usize] + if piece > 0 { piece - 1 } else { 0 });
                }
            } else {
                let nv = ir_make(cx, op, (gt.insts[gv as usize]).ty,
                    (gt.insts[gv as usize]).a, (gt.insts[gv as usize]).b,
                    (gt.insts[gv as usize]).imm, pcx);
                (cx.insts[nv as usize]).c = (gt.insts[gv as usize]).c;
                (cx.insts[nv as usize]).cond = (gt.insts[gv as usize]).cond;
                (cx.insts[nv as usize]).imm2 = (gt.insts[gv as usize]).imm2;
                if op == Op::Slot {
                    let s = (gt.insts[gv as usize]).imm;
                    (cx.insts[nv as usize]).imm = ir_new_slot(cx,
                        (gt.slots[s as usize]).size, (gt.slots[s as usize]).align);
                    { let at_ix = (cx.insts[nv as usize]).imm as usize;
                        (cx.slots[at_ix]).ty = (gt.slots[s as usize]).ty };
                }
                if (gt.insts[gv as usize]).nargs > 0 || op == Op::Phi || op.is_call() {
                    let base = (gt.insts[gv as usize]).args;
                    (cx.insts[nv as usize]).args = cx.args.len() as i64;
                    (cx.insts[nv as usize]).nargs = (gt.insts[gv as usize]).nargs;
                    for a in 0..(gt.insts[gv as usize]).nargs {
                        cx.args.push((gt.args[(base + a) as usize]));
                        cx.argty.push((gt.argty[(base + a) as usize]));
                    }
                }
                ir_append(cx, nb, nv);
                (cx.inl_imap[gv as usize]) = nv;
            }
            gv = (gt.insts[gv as usize]).next;
        }
    }
    // Map the operands, the terminators and the predecessors. An aggregate
    // returned in registers is copied from its address to the call's
    // result slot.
    let ret = pcx.fns[callee_f as usize].ret;
    let copy_result = (cx.insts[call as usize]).c != 0
        && !conv_returns_through_pointer(cx, fn_uses_c(callee_f, pcx), ret, pcx);
    let mut returns: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..gf.blocks.len() as i64 {
        let gb = gf.blocks[i as usize];
        if (gt.blocks[gb as usize]).removed != 0 {
            continue;
        }
        let nb = (cx.inl_bmap[gb as usize]);
        let mut nv = (cx.blocks[nb as usize]).first;
        while nv != 0 {
            (cx.insts[nv as usize]).a = mapped(cx, (cx.insts[nv as usize]).a);
            (cx.insts[nv as usize]).b = mapped(cx, (cx.insts[nv as usize]).b);
            (cx.insts[nv as usize]).c = mapped(cx, (cx.insts[nv as usize]).c);
            for a in 0..(cx.insts[nv as usize]).nargs {
                let ir_arg_v = ir_arg(cx, nv, a);
                let mapped_v = mapped(cx, ir_arg_v);
                ir_set_arg(cx, nv, a, mapped_v);
            }
            nv = (cx.insts[nv as usize]).next;
        }
        for p in 0..(gt.blocks[gb as usize]).preds.len() as i64 {
            (cx.blocks[nb as usize]).preds.push(
                (cx.inl_bmap[
                    ((gt.blocks[gb as usize]).preds[p as usize]) as usize]));
        }
        let term = (gt.blocks[gb as usize]).term;
        let gcond = (gt.blocks[gb as usize]).cond;
        if term == Term::Ret {
            if copy_result {
                let arg_v = (cx.insts[call as usize]).c;
                let mapped_v1 = mapped(cx, gcond);
                let copy = ir_make(cx, Op::Copy, 0, arg_v, mapped_v1,
                    type_size(ret, pcx), pcx);
                ir_append(cx, nb, copy);
            }
            (cx.blocks[nb as usize]).term = Term::Jump;
            (cx.blocks[nb as usize]).s0 = cont;
            (cx.blocks[cont as usize]).preds.push(nb);
            returns.push(mapped(cx, gcond));
        } else if term == Term::Switch {
            let mark = cx.ssa_stack.len() as i64;
            let cases = (gt.blocks[gb as usize]).cases;
            for c in 0..(gt.blocks[gb as usize]).ncases {
                cx.ssa_stack.push((gt.swcases[(cases + 2 * c) as usize]));
                cx.ssa_stack.push(
                    (cx.inl_bmap[(gt.swcases[(cases + 2 * c + 1) as usize]) as usize]));
            }
            let mapped_v2 = mapped(cx, gcond);
            ir_switch_no_preds(cx, nb, mapped_v2,
                (cx.inl_bmap[(gt.blocks[gb as usize]).s0 as usize]),
                mark);
        } else {
            let s0 = (gt.blocks[gb as usize]).s0;
            let s1 = (gt.blocks[gb as usize]).s1;
            (cx.blocks[nb as usize]).term = term;
            (cx.blocks[nb as usize]).cond = mapped(cx, gcond);
            (cx.blocks[nb as usize]).s0 = if s0 != 0 { (cx.inl_bmap[s0 as usize]) }
                else { 0 };
            (cx.blocks[nb as usize]).s1 = if s1 != 0 { (cx.inl_bmap[s1 as usize]) }
                else { 0 };
        }
    }
    // Enter the copy.
    let entry = (cx.inl_bmap[gentry as usize]);
    (cx.blocks[b as usize]).term = Term::Jump;
    (cx.blocks[b as usize]).cond = 0;
    (cx.blocks[b as usize]).s0 = entry;
    (cx.blocks[b as usize]).s1 = 0;
    (cx.blocks[entry as usize]).preds.push(b);
    // The result.
    let ty = (cx.insts[call as usize]).ty;
    if ty != 0 {
        let mut result: i64 = 0;
        if returns.len() as i64 == 0 {
            result = ssa_undef(cx, ty, pcx);
        } else if returns.len() as i64 == 1 {
            result = (returns[0]);
        } else {
            result = ir_make(cx, Op::Phi, ty, 0, 0, 0, pcx);
            (cx.insts[result as usize]).args = cx.args.len() as i64;
            (cx.insts[result as usize]).nargs = returns.len() as i64;
            for r in 0..returns.len() as i64 {
                cx.args.push((returns[r as usize]));
                cx.argty.push(0);
            }
            ir_prepend(cx, cont, result);
        }
        ir_replace(cx, call, result);
    } else {
        replace_pieces(cx, call, cont, &returns, pcx);
        ir_unlink(cx, call);
    }
    cont
}

// The pieces of an aggregate result in registers (PIECE instructions after
// the call, now in `cont`) become the pieces the inlined returns pack (a
// phi of them when there are several); the packs go.
fn replace_pieces(cx: &mut FnCtx<Comp>, call: i64, cont: i64, returns: &[i64], pcx: &Ctx<Comp>) {
    let mut v = (cx.blocks[cont as usize]).first;
    while v != 0 {
        let next = (cx.insts[v as usize]).next;
        if (cx.insts[v as usize]).op == Op::Piece
            && (cx.insts[v as usize]).a == call {
            let k = (cx.insts[v as usize]).imm;
            let ty = (cx.insts[v as usize]).ty;
            let mut result: i64 = 0;
            if returns.len() as i64 == 0 {
                result = ssa_undef(cx, ty, pcx);
            } else if returns.len() as i64 == 1 {
                result = ir_arg(cx, (returns[0]), k);
            } else {
                result = ir_make(cx, Op::Phi, ty, 0, 0, 0, pcx);
                (cx.insts[result as usize]).args = cx.args.len() as i64;
                (cx.insts[result as usize]).nargs = returns.len() as i64;
                for r in 0..returns.len() as i64 {
                    let ir_arg_v = ir_arg(cx, (returns[r as usize]), k);
                    cx.args.push(ir_arg_v);
                    cx.argty.push(0);
                }
                ir_prepend(cx, cont, result);
            }
            ir_replace(cx, v, result);
        }
        v = next;
    }
    for r in 0..returns.len() as i64 {
        let pack = (returns[r as usize]);
        if pack != 0 && (cx.insts[pack as usize]).op == Op::Pack {
            ir_unlink(cx, pack);
        }
    }
}

// Whether function fi is going to be inlined into each of its callers
// (0.14): `#[inline]`, its address not taken, not visible outside. Its
// loop passes wait (they do better in the callers, where its arguments
// are known: an iterator source's `fold` sees its position is 0 only
// there; opt.vl), and its size does not count in the program's, which
// it leaves once inlined. (0.17) Not one whose reference parameters
// give facts (gvn.vl, has_ref_facts): inlining would lose them, so its
// loops are optimized while they hold.
pub fn inlined_everywhere(fi: i64, pcx: &Ctx<Comp>) -> bool {
    let f = pcx.ir_fn[fi as usize];
    fn_attr_inline(f, pcx) == 1 && (pcx.fn_address[fi as usize]) == 0
        && !fn_is_global(f, pcx) && !has_ref_facts(f, pcx)
}

// (0.18.1) Whether function fi, as lowered, is one no caller inlines:
// `#[inline(never)]`, cold, or bigger than any callee inlined
// (INLINE_ONCE). Only such a function takes its requires as facts at its
// entry (middle::entryfacts): one its callers may inline has the facts of
// their checks there, and its loops are better left to them as they are
// (cleaned by the facts, they would come to the caller unrolled, where it
// would have vectorized them).
pub fn never_inlined(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let f = pcx.ir_fn[fi as usize];
    let hint = fn_attr_inline(f, pcx);
    if hint == HINT_NEVER || fn_attr_cold(f, pcx) {
        return true;
    }
    hint != HINT_ALWAYS && !is_closure_fn(fi, pcx) && func_size(cx, fi) > INLINE_ONCE
}

// (0.18.1) Room in cx's maps from a callee's blocks and instructions to
// their copies for `blocks` and `insts` ids, all 0 (inline_call).
fn inline_maps(cx: &mut FnCtx<Comp>, blocks: i64, insts: i64) {
    table_reset(&mut cx.inl_bmap, blocks as usize, 0);
    table_reset(&mut cx.inl_imap, insts as usize, 0);
}

// (0.18.1) The program's size as the component being optimized sees it:
// the program's before the bottom-up phase, and what the component
// itself added (PROGRAM_SIZE, which every component added to in 0.17,
// made the decisions depend on the order the components were done in).
fn program_size(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    pcx.program_size + cx.comp_growth
}

fn program_grows(cx: &mut FnCtx<Comp>, n: i64) {
    cx.comp_growth += n;
}

// (0.18.1) Between the bottom-up phase's levels (middle::parallel): what
// a level's components added.
pub fn add_program_size(n: i64, pcx: &mut Ctx<Comp>) {
    pcx.program_size += n;
}

// (0.18.1) The calls of g left as the component being optimized sees them:
// those before the bottom-up phase, less the ones it inlined itself.
fn calls_left(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n = (pcx.fn_calls[g as usize]);
    let mut own: i64 = 0;
    for i in 0..cx.comp_dec.len() as i64 {
        if (cx.comp_dec[i as usize]) == g {
            own += 1;
        }
    }
    n -= own;
    // (0.18.1: the code cache keeps whether it is one, not the count)
    cc_note_calls(cx, g, own, n == 1, pcx);
    n
}

fn note_inlined(cx: &mut FnCtx<Comp>, g: i64) {
    cx.comp_dec.push(g);
}

// (0.18.1) What the callers of fi read of it, made by fi's task once its
// component is done (so that no caller's task writes it): its call flags,
// its deciders, and its operands resolved (inline_call copies them).
pub fn finish_component_function(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    ir_enter(cx, fi, pcx);
    callee_flags(cx, fi, pcx);
    deciders(cx, fi, pcx);
    resolve_all(cx, fi);
}

// ---- (0.17) -O1: small leaf functions ----

// The largest leaf -O1 inlines (func_size, once simplified), and one with
// `#[inline]`. (Measured, 0.17: at 6, -O1 has all the gains 8 to 12 give
// on the benchmarks (matmul 2.5 times fewer instructions, iterchain 37%,
// wordcount 10%, json 6% fewer), 5 fewer and 4 nearly none; the -O1
// compile of the compiler costs 2% more at 6, 3% at 8, 4.6% at 10;
// docs/optimizer.md.)
const LEAF_SIZE: i64 = 6;
const LEAF_HINTED: i64 = 40;

// -O1's scalar pipeline with the calls of small leaf functions inlined
// first: a function with no calls, of at most LEAF_SIZE instructions once
// simplified (LEAF_HINTED with `#[inline]`; never with `#[inline(never)]`
// or `#[cold]`), so that Fmt's tiny methods, `len`, `as_slice` and the
// like do not stay calls. The leaves are simplified first (here, for the
// whole program); then each other function has their calls inlined and is
// simplified (optimize_with_leaves: here too, or, per function, when it is
// emitted: PER_FUNCTION). A small leaf every call of which is inlined (no
// caller calls setjmp or the like, its address not taken, not global) is
// not emitted (leaf_dropped). -O2 inlines by its own cost model.
pub fn simplify_inlining_leaves(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    sized_table(&mut pcx.leaf_small, pcx.irfunc_count + 1, 0);
    sized_table(&mut pcx.leaf_done, pcx.irfunc_count + 1, 0);
    sized_table(&mut pcx.leaf_keep, pcx.irfunc_count + 1, 0);
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) == 0 || has_calls(cx, fi, pcx) {
            continue;
        }
        ir_enter(cx, fi, pcx);
        simplify_function(cx, fi, pcx);
        // (0.18.1: resolved now, as inline_call reads it; it was resolved
        // there, which another thread may be doing too)
        resolve_all(cx, fi);
        (pcx.leaf_done[fi as usize]) = 1;
        let f = pcx.ir_fn[fi as usize];
        let hint = fn_attr_inline(f, pcx);
        if hint == HINT_NEVER || fn_attr_cold(f, pcx) || pcx.fns[f as usize].variadic {
            continue;
        }
        let limit = if hint == HINT_ALWAYS { LEAF_HINTED } else { LEAF_SIZE };
        if func_size(cx, fi) <= limit {
            (pcx.leaf_small[fi as usize]) = 1;
        }
    }
    // The small leaves something keeps: an address taken, a call from a
    // function that calls setjmp or the like (which inlines nothing).
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) == 0 {
            continue;
        }
        ir_enter(cx, fi, pcx);
        let rt = (pcx.leaf_done[fi as usize]) == 0 && calls_returns_twice(cx, fi, pcx);
        for i in 0..fn_block_count(cx, fi) {
            let b = (fn_block(cx, fi, i));
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let g = ir_callee(cx, v, pcx);
                if g >= 0 && rt {
                    (pcx.leaf_keep[g as usize]) = 1;
                }
                if (cx.insts[v as usize]).op == Op::FAddr
                    && (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) != 0 {
                    (pcx.leaf_keep[
                        ((pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1) as usize]) = 1;
                }
                v = (cx.insts[v as usize]).next;
            }
        }
    }
    if !pcx.per_function {
        for fi in 0..pcx.irfunc_count {
            if (pcx.fn_live[fi as usize]) != 0 {
                optimize_with_leaves(cx, fi, pcx);
            }
        }
        for fi in 0..pcx.irfunc_count {
            if leaf_dropped(fi, pcx) {
                (pcx.fn_live[fi as usize]) = 0;
            }
        }
    }
}

// Function fi's -O1 pipeline after the leaves (see
// simplify_inlining_leaves): their calls inlined, then the scalar
// pipeline; nothing for a leaf (simplified already).
pub fn optimize_with_leaves(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    if (pcx.leaf_done[fi as usize]) != 0 {
        return;
    }
    ir_enter(cx, fi, pcx);
    let inlined = inline_leaf_calls(cx, fi, pcx);
    pass_done(P_INLINE, pcx);
    if inlined {
        optimize_after_inlining(cx, fi, pcx);
    } else {
        simplify_function(cx, fi, pcx);
    }
}

// Whether fi is a small leaf no call of which is left (not emitted).
pub fn leaf_dropped(fi: i64, pcx: &Ctx<Comp>) -> bool {
    !pcx.leaf_small.is_empty() && (pcx.leaf_small[fi as usize]) != 0
        && (pcx.leaf_keep[fi as usize]) == 0
        && !fn_is_global(pcx.ir_fn[fi as usize], pcx)
}

// Whether fi's IR is still needed after it is emitted: a small leaf, which
// a later function may inline.
pub fn leaf_kept(fi: i64, pcx: &Ctx<Comp>) -> bool {
    !pcx.leaf_small.is_empty() && (pcx.leaf_small[fi as usize]) != 0
}

// Whether function fi makes a call (direct or not) on a path that
// returns. (0.29) A call in a panic block (panic_blocks) is not one when
// it is the runtime's or C's and nothing in fi returns twice: the report
// of a failed check, which left `s[i]` in a small function a call at -O1.
// (An IR function's call there still counts: a leaf's own calls are not
// inlined, and a small leaf called only from one would be dropped with
// its call left, leaf_dropped. And a leaf's copies go into callers that
// looked for setjmp and the like only in themselves, inline_leaf_calls.)
fn has_calls(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    ir_enter(cx, fi, pcx);
    let panics = panic_blocks(cx, fi);
    let mut in_panics = false;
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op.is_call() {
                if !panics[b as usize] || (cx.insts[v as usize]).op != Op::CallC {
                    return true;
                }
                in_panics = true;
            }
            v = (cx.insts[v as usize]).next;
        }
    }
    in_panics && calls_returns_twice(cx, fi, pcx)
}

// Inlines function fi's calls of the functions leaf_small marks (leaves:
// their copies make no calls), in one pass over its blocks; whether any
// was. (None in a function that calls setjmp or the like: it keeps its
// frame, see regalloc.vl.)
fn inline_leaf_calls(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut changed = false;
    let mut i: i64 = 0;
    // (a call's continuation block is appended: visited too)
    while i < fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        i += 1;
        if (cx.blocks[b as usize]).removed != 0
            || (cx.blocks[b as usize]).loop_depth == 1 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let next = (cx.insts[v as usize]).next;
            let g = ir_callee(cx, v, pcx);
            if g >= 0 && g != fi && (pcx.leaf_small[g as usize]) != 0
                && (pcx.fn_live[g as usize]) != 0 {
                if !changed && calls_returns_twice(cx, fi, pcx) {
                    return false;
                }
                inline_call(cx, fi, v, g, pcx);
                changed = true;
                break;
            }
            v = next;
        }
    }
    for k in 0..fn_block_count(cx, fi) {
        { let at_b = fn_block(cx, fi, k) as usize; cx.blocks[at_b].loop_depth = 0; }
    }
    changed
}
