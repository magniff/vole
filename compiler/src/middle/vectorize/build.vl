// Building the vector loop's code: the map from the loop's values to the
// vector loop's (V_MAP), instructions appended to a block, values
// materialized at a given iteration (eval_at), the vector form of a value
// and the body on VF lanes (emit_body), and the identities of reductions.

use crate::front::types::{TY_BOOL, TY_F64, TY_I64, TY_U64, int_bits, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op, ir_append, ir_make, ir_val};
use crate::middle::ir::Op::{
    And, Cmp, Const, Load, Mul, Neg, Phi, Store, VBin, VCmp, VNeg, VSel, VSplat,
};
use crate::middle::loops::invariant_in;
use crate::middle::vectorize::{VC_SKIP, VC_UNIFORM, VC_VECTOR, VC_WIDE, VC_WMUL};
use crate::middle::vectorize::legality::{class_of, lane_type, loads_in};

pub fn map_get(cx: sink *FnCtx, v: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        var k = 0;
        while k < cx.v_map.count {
            if cx.v_map.data[k] == x {
                return cx.v_map.data[k + 1];
            }
            k += 2;
        }
        x
    }
}

pub fn map_put(cx: sink *FnCtx, v: i64, w: i64) {
    unsafe {
        cx.v_map.push(v);
        cx.v_map.push(w);
    }
}

pub fn append(cx: sink *FnCtx, b: i64, op: Op, ty: i64, a: i64, x: i64, imm: i64) -> i64 {
    let v = ir_make(cx, op, ty, a, x, imm);
    ir_append(cx, b, v);
    v
}

pub fn konst(cx: sink *FnCtx, b: i64, value: i64, ty: i64) -> i64 {
    append(cx, b, Const, ty, 0, 0, value)
}

pub fn cmp(cx: sink *FnCtx, b: i64, cond: Cond, ty: i64, a: i64, x: i64) -> i64 {
    let v = append(cx, b, Cmp, TY_BOOL, a, x, 0);
    unsafe {
        cx.insts[v].cond = cond;
        cx.insts[v].imm2 = ty;
    }
    v
}

// The value of uniform (or invariant) v when the induction variable is
// `at`, computed in block b.
pub fn eval_at(cx: sink *FnCtx, l: i64, v: i64, at: i64, b: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if x == cx.v_iv {
            return at;
        }
        if invariant_in(cx, l, x) {
            return x;
        }
        var k = 0;
        while k < cx.v_eval.count {
            if cx.v_eval.data[k] == x && cx.v_eval.data[k + 1] == at {
                return cx.v_eval.data[k + 2];
            }
            k += 3;
        }
        let a = if cx.insts[x].a != 0 { eval_at(cx, l, cx.insts[x].a, at, b) } else { 0 };
        let y = if cx.insts[x].b != 0 { eval_at(cx, l, cx.insts[x].b, at, b) } else { 0 };
        let nv = ir_make(cx, cx.insts[x].op, cx.insts[x].ty, a, y, cx.insts[x].imm);
        cx.insts[nv].imm2 = cx.insts[x].imm2;
        cx.insts[nv].cond = cx.insts[x].cond;
        ir_append(cx, b, nv);
        cx.v_eval.push(x);
        cx.v_eval.push(at);
        cx.v_eval.push(nv);
        nv
    }
}

// ok = ok && c (as branches would cost blocks: and of bools, 0 or 1).
pub fn and_into(cx: sink *FnCtx, b: i64, ok: i64, c: i64) -> i64 {
    if ok == 0 {
        return c;
    }
    append(cx, b, And, TY_BOOL, ok, c, 0)
}

// The value of v for the vector loop: a vector (splat when v is the same
// for all lanes; invariant ones in the vector preheader `vp`).
fn vector_of(cx: sink *FnCtx, v: i64, vh: i64, vp: i64, l: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if class_of(cx, x) == VC_VECTOR {
            return map_get(cx, x);
        }
        let key = -x - 1;
        var k = 0;
        while k < cx.v_map.count {
            if cx.v_map.data[k] == key {
                return cx.v_map.data[k + 1];
            }
            k += 2;
        }
        if invariant_in(cx, l, x) || !loads_in(cx, l, x) {
            // The same in every iteration (coefficient 0, no load): computed
            // once, before the loop.
            let s = ir_make(cx, VSplat, cx.v_vt, eval_at(cx, l, x, cx.v_start, vp), 0, 0);
            ir_append(cx, vp, s);
            map_put(cx, key, s);
            return s;
        }
        let s = ir_make(cx, VSplat, cx.v_vt, map_get(cx, x), 0, 0);
        ir_append(cx, vh, s);
        s
    }
}

// One copy of the loop's body in block vh (V_MAP maps the induction
// variable and the reductions' phis).
pub fn emit_body(cx: sink *FnCtx, l: i64, vh: i64, vp: i64) {
    unsafe {
        let vt = cx.v_vt;
        for k in 0..cx.v_chain.count {
            var v = cx.blocks[cx.v_chain.data[k]].first;
            while v != 0 {
                let cls = class_of(cx, v);
                let op = cx.insts[v].op;
                if op == Phi || cls == VC_SKIP || cls == VC_WIDE || cls == VC_WMUL {
                    // ((0.16) the widened loads and their products: in the
                    // VMACW of the add they go to)
                    v = cx.insts[v].next;
                    continue;
                }
                if op == Op::Add && cls == VC_VECTOR
                    && (class_of(cx, ir_val(cx, cx.insts[v].a)) == VC_WMUL
                        || class_of(cx, ir_val(cx, cx.insts[v].b)) == VC_WMUL) {
                    map_put(cx, v, multiply_add(cx, l, v, vh, vp));
                    v = cx.insts[v].next;
                    continue;
                }
                if cls == VC_UNIFORM {
                    let nv = ir_make(cx, op, cx.insts[v].ty, map_get(cx, cx.insts[v].a),
                        map_get(cx, cx.insts[v].b), cx.insts[v].imm);
                    cx.insts[nv].imm2 = cx.insts[v].imm2;
                    cx.insts[nv].cond = cx.insts[v].cond;
                    ir_append(cx, vh, nv);
                    map_put(cx, v, nv);
                } else if op == Load {
                    let nv = append(cx, vh, Load, vt, map_get(cx, cx.insts[v].a), 0,
                        cx.insts[v].imm);
                    map_put(cx, v, nv);
                } else if op == Store {
                    let value = vector_of(cx, cx.insts[v].b, vh, vp, l);
                    let nv = append(cx, vh, Store, 0, map_get(cx, cx.insts[v].a), value,
                        cx.insts[v].imm);
                    cx.insts[nv].imm2 = vt;
                } else if op == Cmp {
                    // (0.15) A mask.
                    let a = vector_of(cx, cx.insts[v].a, vh, vp, l);
                    let b = vector_of(cx, cx.insts[v].b, vh, vp, l);
                    let nv = append(cx, vh, VCmp, vt, a, b, 0);
                    cx.insts[nv].cond = cx.insts[v].cond;
                    cx.insts[nv].imm2 = vt;
                    map_put(cx, v, nv);
                } else if op == Op::Sel {
                    let k = map_get(cx, ir_val(cx, cx.insts[v].a));
                    let b = vector_of(cx, cx.insts[v].b, vh, vp, l);
                    let c = vector_of(cx, cx.insts[v].c, vh, vp, l);
                    let nv = append(cx, vh, VSel, vt, k, b, 0);
                    cx.insts[nv].c = c;
                    map_put(cx, v, nv);
                } else if op == Neg {
                    let nv = append(cx, vh, VNeg, vt, vector_of(cx, cx.insts[v].a, vh, vp, l), 0,
                        0);
                    map_put(cx, v, nv);
                } else {
                    let a = vector_of(cx, cx.insts[v].a, vh, vp, l);
                    let b = vector_of(cx, cx.insts[v].b, vh, vp, l);
                    let nv = append(cx, vh, VBin, vt, a, b, op as i64);
                    map_put(cx, v, nv);
                }
                v = cx.insts[v].next;
            }
        }
    }
}

// (0.26.2, a prototype) A vector of `value` in every lane (of type lt),
// made in the vector preheader vp.
fn splat_const(cx: sink *FnCtx, vp: i64, vt: i64, value: i64, lt: i64) -> i64 {
    append(cx, vp, VSplat, vt, konst(cx, vp, value, lt), 0, 0)
}

fn vbin(cx: sink *FnCtx, b: i64, vt: i64, op: Op, x: i64, y: i64) -> i64 {
    append(cx, b, VBin, vt, x, y, op as i64)
}

// (0.26.2, a prototype) The lanes' overflow of check o (OVK_LANE), in
// block vh: a vector whose lanes have the sign bit set where o's operation
// overflows: signed, the result's sign against the operands'; unsigned,
// the carry (borrow) out of the top bit; a negation's operand the minimum
// (unsigned: not 0).
pub fn lane_overflow(cx: sink *FnCtx, l: i64, o: i64, vh: i64, vp: i64) -> i64 {
    // UNSAFE: the function's IR is FnCtx's raw arrays, as in emit_body.
    // SAFETY: o and its operands are instructions of the loop's function.
    unsafe {
        let vt = cx.v_vt;
        let imm = cx.insts[o].imm;
        let op = (imm & 255) as Op;
        let ty = imm >> 8;
        let lt = lane_type(ty);
        let signed = is_signed(ty);
        let a = vector_of(cx, cx.insts[o].a, vh, vp, l);
        if op == Neg {
            let bits = int_bits(ty);
            let edge = if !signed { 0 } else if bits == 64 { 0 - 9223372036854775807 - 1 }
                else { 0 - (1 << (bits - 1) as u64) };
            let m = append(cx, vh, VCmp, vt, a, splat_const(cx, vp, vt, edge, lt), 0);
            cx.insts[m].cond = if signed { Cond::Eq } else { Cond::Ne };
            cx.insts[m].imm2 = vt;
            return m;
        }
        let b = vector_of(cx, cx.insts[o].b, vh, vp, l);
        let r = vbin(cx, vh, vt, op, a, b);
        if signed && op == Op::Add {
            return vbin(cx, vh, vt, And, vbin(cx, vh, vt, Op::Xor, r, a),
                vbin(cx, vh, vt, Op::Xor, r, b));
        }
        if signed {
            return vbin(cx, vh, vt, And, vbin(cx, vh, vt, Op::Xor, a, b),
                vbin(cx, vh, vt, Op::Xor, a, r));
        }
        let ones = splat_const(cx, vp, vt, -1, lt);
        if op == Op::Add {
            // (a & b) | ((a | b) & ~r)
            let nr = vbin(cx, vh, vt, Op::Xor, r, ones);
            return vbin(cx, vh, vt, Op::Or, vbin(cx, vh, vt, And, a, b),
                vbin(cx, vh, vt, And, vbin(cx, vh, vt, Op::Or, a, b), nr));
        }
        // (~a & b) | ((~a | b) & r)
        let na = vbin(cx, vh, vt, Op::Xor, a, ones);
        vbin(cx, vh, vt, Op::Or, vbin(cx, vh, vt, And, na, b),
            vbin(cx, vh, vt, And, vbin(cx, vh, vt, Op::Or, na, b), r))
    }
}

// (0.26.2, a prototype) A bound of the magnitude of the addend of reduction
// check o (OVK_RED) on reduction phi `phi`, in lanes, in block vh: x ^ (x <
// 0), |x| - 1 when x is negative, signed; x itself unsigned.
pub fn addend_bound(cx: sink *FnCtx, l: i64, o: i64, phi: i64, vh: i64, vp: i64) -> i64 {
    // UNSAFE: the function's IR is FnCtx's raw arrays, as in emit_body.
    // SAFETY: o and its operands are instructions of the loop's function.
    unsafe {
        let x = if ir_val(cx, cx.insts[o].a) == phi { cx.insts[o].b } else { cx.insts[o].a };
        let xv = vector_of(cx, x, vh, vp, l);
        let ty = cx.insts[o].imm >> 8;
        if !is_signed(ty) {
            return xv;
        }
        let neg = append(cx, vh, VCmp, cx.v_vt, xv, splat_const(cx, vp, cx.v_vt, 0, lane_type(ty)),
            0);
        cx.insts[neg].cond = Cond::Lt;
        cx.insts[neg].imm2 = cx.v_vt;
        vbin(cx, vh, cx.v_vt, Op::Xor, xv, neg)
    }
}

// (0.26.2, a prototype) Whether a reduction checked by OVF imm (OVK_RED),
// from `init`, may have overflowed in `count` iterations of `steps` steps
// each, in block b, from u, its addends' bounds or'ed (a scalar of the lane
// type): unless every partial sum, in any order, stays inside the type:
// |init| + count * steps * (u + 1) at most its maximum, signed; init +
// count * steps * u, unsigned (a difference's, at most init).
pub fn reduction_may_overflow(cx: sink *FnCtx, b: i64, imm: i64, init: i64, u: i64, count: i64,
    steps: i64) -> i64 {
    // UNSAFE: the function's IR is FnCtx's raw arrays, as in emit_body.
    // SAFETY: the instructions made are of the function entered.
    unsafe {
        let op = (imm & 255) as Op;
        let ty = imm >> 8;
        let lt = lane_type(ty);
        let bits = int_bits(ty);
        if is_signed(ty) {
            let wide_u = if lt == TY_I64 { u } else { widen(cx, b, TY_I64, u, lt) };
            let wide_init = if ty == TY_I64 { init } else { widen(cx, b, TY_I64, init, ty) };
            let sign = append(cx, b, Op::Shr, TY_I64, wide_init, konst(cx, b, 63, TY_I64), 0);
            let magnitude = append(cx, b, Op::Xor, TY_I64, wide_init, sign, 0);
            let max = if bits == 64 { 9223372036854775807 } else { (1 << (bits - 1) as u64) - 1 };
            // count * (u + 1) <= max - (magnitude + 1): u < (max - 1 - magnitude) / count
            let room = append(cx, b, Op::Sub, TY_I64, konst(cx, b, max - 1, TY_I64), magnitude, 0);
            var q = append(cx, b, Op::Div, TY_I64, room, count, 0);
            if steps > 1 {
                q = append(cx, b, Op::Div, TY_I64, q, konst(cx, b, steps, TY_I64), 0);
            }
            return cmp(cx, b, Cond::Ge, TY_I64, wide_u, q);
        }
        let wide_u = if bits == 64 { u } else {
            append(cx, b, And, TY_U64, widen(cx, b, TY_I64, u, lt),
                konst(cx, b, (1 << bits as u64) - 1, TY_U64), 0)
        };
        let wide_init = if bits == 64 { init } else { widen(cx, b, TY_U64, init, ty) };
        let max = if bits == 64 { -1 } else { (1 << bits as u64) - 1 };
        let room = if op == Op::Add {
            append(cx, b, Op::Sub, TY_U64, konst(cx, b, max, TY_U64), wide_init, 0)
        } else {
            wide_init
        };
        var q = append(cx, b, Op::Div, TY_U64, room, count, 0);
        if steps > 1 {
            q = append(cx, b, Op::Div, TY_U64, q, konst(cx, b, steps, TY_U64), 0);
        }
        cmp(cx, b, Cond::Gt, TY_U64, wide_u, q)
    }
}

// x of type `from` as type ty, in block b.
fn widen(cx: sink *FnCtx, b: i64, ty: i64, x: i64, from: i64) -> i64 {
    let v = append(cx, b, Op::Conv, ty, x, 0, 0);
    // UNSAFE: the function's IR is FnCtx's raw arrays.
    // SAFETY: v was just made, an instruction of the function entered.
    unsafe {
        cx.insts[v].imm2 = from;
    }
    v
}

// (0.16) The vector loop's value of v = x + k * (load as u64) (VC_WMUL's
// product, either order): a VMACW of x's vector, the load's 8 bytes (two
// u32, an f64 load) and k's splat.
fn multiply_add(cx: sink *FnCtx, l: i64, v: i64, vh: i64, vp: i64) -> i64 {
    unsafe {
        let a = ir_val(cx, cx.insts[v].a);
        let m = if class_of(cx, a) == VC_WMUL { a } else { ir_val(cx, cx.insts[v].b) };
        let x = if m == a { cx.insts[v].b } else { cx.insts[v].a };
        let w = if class_of(cx, ir_val(cx, cx.insts[m].a)) == VC_WIDE { ir_val(cx, cx.insts[m].a) }
            else { ir_val(cx, cx.insts[m].b) };
        let k = if w == ir_val(cx, cx.insts[m].a) { cx.insts[m].b } else { cx.insts[m].a };
        let ld = if cx.insts[w].op == Op::Conv { ir_val(cx, cx.insts[w].a) } else { w };
        let acc = vector_of(cx, x, vh, vp, l);
        let pair = append(cx, vh, Load, TY_F64, map_get(cx, cx.insts[ld].a), 0, cx.insts[ld].imm);
        let kv = vector_of(cx, k, vh, vp, l);
        let nv = append(cx, vh, Op::VMacW, cx.v_vt, acc, pair, 0);
        cx.insts[nv].c = kv;
        nv
    }
}

// The identity of reduction operation op.
pub fn identity(op: Op) -> i64 {
    if op == And { return -1; }
    if op == Mul { return 1; }
    0
}

// (0.15) The minimum or maximum of a and b in block blk, as reduction phi
// r's next value nx (k ? z : r, or k ? r : z) picks it: a for r, b for z;
// vectors of type ty, or scalars of type ty.
pub fn minmax_of(cx: sink *FnCtx, blk: i64, r: i64, nx: i64, a: i64, b: i64, vector: bool, ty: i64) -> i64 {
    unsafe {
        let k = ir_val(cx, cx.insts[nx].a);
        let x = if ir_val(cx, cx.insts[k].a) == r { a } else { b };
        let y = if ir_val(cx, cx.insts[k].b) == r { a } else { b };
        let p = if ir_val(cx, cx.insts[nx].b) == r { a } else { b };
        let q = if ir_val(cx, cx.insts[nx].c) == r { a } else { b };
        let m = if vector { append(cx, blk, VCmp, ty, x, y, 0) }
            else { cmp(cx, blk, cx.insts[k].cond, ty, x, y) };
        cx.insts[m].cond = cx.insts[k].cond;
        cx.insts[m].imm2 = ty;
        let s = append(cx, blk, if vector { VSel } else { Op::Sel }, ty, m, p, 0);
        cx.insts[s].c = q;
        s
    }
}
