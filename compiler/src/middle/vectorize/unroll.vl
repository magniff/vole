// Unrolling with run-time trip counts (0.11).
//
// An innermost counted loop (i from start, step 1, to n; any body, its only
// exits the latch's and failing checks) whose trip count is not a constant
// gets U copies of its body run per iteration, U = 4 or 2 within a size
// budget, in the vectorizer's frame (the original loop is the remainder):
//
//     C:  trips = n - start; ok = trips >= U && no check fails
//         branch ok, UP, SP
//     UP: uend = start + (trips & -U)
//     U0 .. U(U-1): the copies, chained; the checks dropped; the last
//         latch: branch i' != uend, U0, UX
//     UX: branch uend == n, E, SP
//     SP: i and the header's other phis from C or UX; the scalar loop
//
// The checks are proved before the loop as the vectorizer's are (indices
// of coefficient +1 or -1 in i), so the copies go without them; a loop
// with another kind of check, or a call, is left alone. Each copy computes
// exactly what the scalar iteration does, in order.

use crate::base::{IntVec, free};
use crate::front::types::{TY_BOOL, TY_I64, TY_U64, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::all_ones;
use crate::middle::ir::{
    Cond, IRFUNCS, Op, Term, ir_arg, ir_enter, ir_new_block, ir_operand, ir_operand_count,
    ir_replace, ir_set_arg, ir_val,
};
use crate::middle::ir::Op::{Add, And, Cmp, Const, Phi, Sub};
use crate::middle::ir::cfg::{ir_terminate, pred_index};
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{
    add_pred_values, canonicalize_loops, clone_map, clone_region, form_lcssa, innermost_loop,
    is_canonical, is_innermost, loop_block, loop_contains, loop_count, loop_header, loop_latch,
    loop_preheader, loop_size, mark_loop_blocks, new_phi_in,
};
use crate::middle::opt::resolve_all;
use crate::middle::profile::{is_cold_block, is_hot_count};
use crate::middle::scev::counted_loop;
use crate::middle::vectorize::{VC_UNIFORM, expected_trips};
use crate::middle::vectorize::build::{append, cmp, konst, reduction_may_overflow};
use crate::middle::vectorize::checks::{
    OVK_KEEP, OVK_STEP, OVK_UNIFORM, check_tests, ovf_index, ovf_tests, ovf_uniform, record_check,
    record_ovf,
};
use crate::middle::vectorize::legality::{coef, is_unreachable_exit, loads_in, set_class};

const UNROLL_RT_SIZE: i64 = 64;

const UNROLL_RT_TINY: i64 = 12;

// (0.15) A loop with a reduction kept on several accumulators is unrolled
// up to this size even without checks: the copies then run side by side.
const UNROLL_RT_REDUCTION: i64 = 32;

// (0.18) Whether value v is read inside loop l (an operand or a branch
// condition of its blocks). A constant only the loop's exits read (a
// check's site and kind, passed to the failure on its cold path) costs
// the loop nothing, so the unroller does not count it.
fn read_in_loop(cx: sink *FnCtx, l: i64, v: i64) -> bool {
    unsafe {
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            if cx.blocks[b].cond != 0 && ir_val(cx, cx.blocks[b].cond) == v {
                return true;
            }
            var w = cx.blocks[b].first;
            while w != 0 {
                for k in 0..ir_operand_count(cx, w) {
                    let o = ir_operand(cx, w, k);
                    if o != 0 && ir_val(cx, o) == v {
                        return true;
                    }
                }
                w = cx.insts[w].next;
            }
        }
        false
    }
}

// The unrolling factor for loop l (canonical, innermost), or 0; sets V_IV,
// V_N, V_CHECKS and the classes coef needs.
fn runtime_factor(cx: sink *FnCtx, l: i64) -> i64 {
    unsafe {
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        if cx.blocks[h].novec != 0 || is_cold_block(cx, h) || latch == 0
            || loop_preheader(cx, l) == 0
            || cx.blocks[latch].term != Term::Branch {
            return 0;
        }
        var iv = 0;
        var step = 0;
        var n = 0;
        var ne = false;
        if !counted_loop(cx, l, &iv, &step, &n, &ne) || step != 1
            || int_bits(cx.insts[iv].ty) != 64 {
            return 0;
        }
        cx.vstamp += 1;
        cx.v_iv = iv;
        cx.v_n = n;
        cx.v_ne = ne;
        cx.v_iv2 = 0;
        cx.v_checks.count = 0;
        cx.v_ovfs.count = 0;
        cx.v_eval.count = 0;
        let s0 = cx.blocks[latch].s0;
        let s1 = cx.blocks[latch].s1;
        let e = if s0 == h { s1 } else { s0 };
        if loop_contains(cx, l, e) || cx.blocks[e].preds.count != 1 {
            return 0;
        }
        var size = 0;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            var v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op.is_call() || op == Op::Copy {
                    return 0;
                }
                if (op.is_pure() && op != Cmp) || op == Const {
                    set_class(cx, v, VC_UNIFORM);
                }
                if op != Const || read_in_loop(cx, l, v) {
                    size += 1;
                }
                v = cx.insts[v].next;
            }
            if b == latch {
                continue;
            }
            let t = cx.blocks[b].term;
            if t == Term::Branch {
                let a = cx.blocks[b].s0;
                let c = cx.blocks[b].s1;
                if !loop_contains(cx, l, a) || !loop_contains(cx, l, c) {
                    let next = if loop_contains(cx, l, a) { a } else { c };
                    let out = if next == a { c } else { a };
                    if !loop_contains(cx, l, next) || !is_unreachable_exit(cx, l, out)
                        || !record_check(cx, l, b, next) && !record_ovf(cx, l, b, next) {
                        return 0;
                    }
                }
            } else if t != Term::Jump || !loop_contains(cx, l, cx.blocks[b].s0) {
                return 0;
            }
        }
        set_class(cx, iv, VC_UNIFORM);
        for k in 0..cx.v_checks.count / 3 {
            let c = coef(cx, l, cx.v_checks.data[3 * k + 1]);
            if (c != 1 && c != -1) || loads_in(cx, l, cx.v_checks.data[3 * k + 1]) {
                return 0;
            }
        }
        // (0.26.2, a prototype) Overflow checks of values exactly affine in
        // the counter go too (tested before the loop); the others stay in
        // every copy.
        var going = cx.v_checks.count / 3;
        var kept = 0;
        for k in 0..cx.v_ovfs.count / 3 {
            if ovf_uniform(cx, l, cx.v_ovfs.data[3 * k]) {
                cx.v_ovfs.data[3 * k + 1] = OVK_UNIFORM;
                going += 1;
            } else {
                cx.v_ovfs.data[3 * k + 1] = OVK_KEEP;
                kept += 1;
            }
        }
        // (Copies that keep checks are big: only where a reduction splits.)
        if kept > 0 && !has_split_reduction(cx, l) {
            return 0;
        }
        // It pays where checks go, or where the loop's own instructions (the
        // induction variable, its test and branch) are a good part of it.
        // (0.15) Or where reductions run on several accumulators.
        if going == 0 && size > UNROLL_RT_TINY
            && (size > UNROLL_RT_REDUCTION || !has_split_reduction(cx, l)) {
            return 0;
        }
        let budget = if is_hot_count(cx.blocks[h].count) { 2 * UNROLL_RT_SIZE }
            else { UNROLL_RT_SIZE };
        var u = if 4 * size <= budget { 4 } else if 2 * size <= budget { 2 } else { 0 };
        // (With a profile: enough iterations an entry for a few rounds.)
        let t = expected_trips(cx, l);
        while u > 1 && t >= 0 && t < 2 * u {
            u = u / 2;
        }
        if u < 2 { 0 } else { u }
    }
}

// (0.15) Whether v is one of the set's values.
fn in_set(set: IntVec, v: i64) -> bool {
    for i in 0..set.count {
        if unsafe { set.data[i] } == v {
            return true;
        }
    }
    false
}

// (0.15) Whether header phi r of loop l (next value nx) is a reduction the
// copies may each keep apart, combined after the unrolled loop: an
// accumulator only ever combined with values that do not depend on it, by
// one associative and commutative operation (+ and -, ^, |, &, *, of
// integers), through phis and selects of such values; or a minimum or
// maximum, `k ? x : r` with k comparing x and r (an integer order). Only
// nx may be used outside the loop (outs: the exit block's values). Returns
// the operation (as i64; ADD for + and -), -1 for a minimum or maximum (its
// select nx), or 0. (0.26.2, a prototype) When `spec`, a sum whose steps
// are each overflow-checked is one too: its steps and addends into `steps`.
fn split_reduction(cx: sink *FnCtx, l: i64, r: i64, nx: i64, outs: IntVec, spec: bool,
    steps: inout IntVec) -> i64 {
    unsafe {
        let ty = cx.insts[r].ty;
        if !is_integer(ty) || r == cx.v_iv || nx == r || cx.insts[nx].block == 0
            || !loop_contains(cx, l, cx.insts[nx].block) {
            return 0;
        }
        let h = loop_header(cx, l);
        var set = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        set.push(r);
        var family = 0;
        var minmax = false;
        let k = cx.insts[nx].a;
        if cx.insts[nx].op == Op::Sel && cx.insts[k].op == Cmp && is_integer(cx.insts[k].imm2)
            && cx.insts[k].cond != Cond::Eq && cx.insts[k].cond != Cond::Ne
            && (cx.insts[k].a == r) != (cx.insts[k].b == r) {
            let z = if cx.insts[k].a == r { cx.insts[k].b } else { cx.insts[k].a };
            if (cx.insts[nx].b == r && cx.insts[nx].c == z)
                || (cx.insts[nx].b == z && cx.insts[nx].c == r) {
                minmax = true;
                set.push(k);
                set.push(nx);
            }
        }
        var ok = true;
        var grew = true;
        var checks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        while ok && grew && !minmax {
            grew = false;
            for i in 0..loop_size(cx, l) {
                var w = cx.blocks[loop_block(cx, l, i)].first;
                while w != 0 && ok {
                    if w != r && !in_set(set, w) && uses_set(cx, w, set) {
                        let op = cx.insts[w].op;
                        var member = true;
                        if op == Phi {
                            ok = cx.insts[w].block != h;
                            for a in 0..cx.insts[w].nargs {
                                ok = ok && in_set(set, ir_val(cx, ir_arg(cx, w, a)));
                            }
                        } else if op == Op::Sel {
                            ok = !in_set(set, cx.insts[w].a) && in_set(set, cx.insts[w].b)
                                && in_set(set, cx.insts[w].c);
                        } else if (op == Add || op == Sub || op == Op::Xor || op == Op::Or
                            || op == And || op == Op::Mul) && cx.insts[w].ty == ty {
                            let f = if op == Sub { Add as i64 } else { op as i64 };
                            ok = in_set(set, cx.insts[w].a) != in_set(set, cx.insts[w].b)
                                && (op != Sub || in_set(set, cx.insts[w].a))
                                && (family == 0 || family == f);
                            family = f;
                        } else if op == Op::Ovf && spec && ovf_index(cx, w) >= 0 {
                            // (0.26.2) A step's overflow check (see
                            // checked_steps): not one of the set.
                            if !in_set(checks, w) {
                                checks.push(w);
                            }
                            member = false;
                        } else {
                            ok = false;
                        }
                        if ok && member {
                            set.push(w);
                            grew = true;
                        }
                    }
                    w = cx.insts[w].next;
                }
            }
        }
        // Nothing else uses the set inside the loop (a minimum's compare
        // and select only each other and r), nor outside but nx, nor a
        // terminator.
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            if cx.blocks[b].term != Term::Jump && in_set(set, ir_val(cx, cx.blocks[b].cond)) {
                ok = false;
            }
            if minmax {
                var w = cx.blocks[b].first;
                while w != 0 && ok {
                    if w != r && w != k && w != nx && uses_set(cx, w, set) {
                        ok = false;
                    }
                    w = cx.insts[w].next;
                }
            }
        }
        ok = ok && in_set(set, nx) && (minmax || family != 0);
        for i in 0..outs.count {
            let x = outs.data[i];
            if x != nx && in_set(set, x) {
                ok = false;
            }
        }
        // (0.26.2) Checked steps: split when spec, the loop redone from its
        // start when the sums may overflow (unroll_runtime).
        if ok && checks.count > 0 {
            ok = !minmax && family == Add as i64 && checked_steps(cx, set, checks, ty, &steps);
        }
        free(checks.data as *u8);
        free(set.data as *u8);
        if !ok { 0 } else if minmax { -1 } else { family }
    }
}

// (0.26.2, a prototype) Whether `checks`, overflow checks on values of
// `set` (a reduction's, of type ty), check its steps: each the + or - of a
// step of the set on its operands, every step checked, all of one sign when
// unsigned. The steps and their addends, pairs, into `steps`.
fn checked_steps(cx: sink *FnCtx, set: IntVec, checks: IntVec, ty: i64, steps: inout IntVec) -> bool {
    // UNSAFE: the function's IR is FnCtx's raw arrays, as in split_reduction.
    // SAFETY: the set's values and the checks are instructions of the loop's
    // function; i and j stay below their counts.
    unsafe {
        var count = 0;
        var adds = 0;
        for i in 0..set.count {
            let w = set.data[i];
            let op = cx.insts[w].op;
            if op != Add && op != Sub {
                continue;
            }
            count += 1;
            if op == Add {
                adds += 1;
            }
            let a = ir_val(cx, cx.insts[w].a);
            let b = ir_val(cx, cx.insts[w].b);
            var found = false;
            for j in 0..checks.count {
                let c = checks.data[j];
                let imm = cx.insts[c].imm;
                let ca = ir_val(cx, cx.insts[c].a);
                let cb = ir_val(cx, cx.insts[c].b);
                if (imm & 255) == op as i64 && (imm >> 8) == ty
                    && (ca == a && cb == b || op == Add && ca == b && cb == a) {
                    found = true;
                }
            }
            if !found {
                return false;
            }
            steps.push(w);
            steps.push(if in_set(set, a) { b } else { a });
        }
        count == checks.count && (is_signed(ty) || adds == 0 || adds == count)
    }
}

// (0.26.2, a prototype) Whether loop l may be redone from its start when a
// check of its unrolled copies fails (see unroll_runtime): it stores
// nothing, and its body is a chain, its only branches checks and its latch.
fn speculable(cx: sink *FnCtx, l: i64) -> bool {
    // UNSAFE: the function's IR is FnCtx's raw arrays (blocks, insts).
    // SAFETY: the blocks are loop l's, their instructions the function's.
    unsafe {
        let latch = loop_latch(cx, l);
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            var v = cx.blocks[b].first;
            while v != 0 {
                let op = cx.insts[v].op;
                if op == Op::Store || op == Op::Copy || op == Op::Atomic || op == Op::Fence
                    || op.is_call() {
                    return false;
                }
                v = cx.insts[v].next;
            }
            if b != latch && cx.blocks[b].term == Term::Branch
                && loop_contains(cx, l, cx.blocks[b].s0) && loop_contains(cx, l, cx.blocks[b].s1) {
                return false;
            }
        }
        true
    }
}

// (0.26.2) Marks the overflow check of step w (one of the same operation
// and operands) in V_OVFS as OVK_STEP.
fn mark_step_check(cx: sink *FnCtx, w: i64) {
    // UNSAFE: FnCtx's raw arrays (insts, V_OVFS).
    // SAFETY: k stays below V_OVFS' count; its checks and w are
    // instructions of the function entered.
    unsafe {
        let a = ir_val(cx, cx.insts[w].a);
        let b = ir_val(cx, cx.insts[w].b);
        for k in 0..cx.v_ovfs.count / 3 {
            let c = cx.v_ovfs.data[3 * k];
            let ca = ir_val(cx, cx.insts[c].a);
            let cb = ir_val(cx, cx.insts[c].b);
            if (cx.insts[c].imm & 255) == cx.insts[w].op as i64
                && (ca == a && cb == b || cx.insts[w].op == Add && ca == b && cb == a) {
                cx.v_ovfs.data[3 * k + 1] = OVK_STEP;
            }
        }
    }
}

fn uses_set(cx: sink *FnCtx, w: i64, set: IntVec) -> bool {
    for i in 0..ir_operand_count(cx, w) {
        let x = ir_operand(cx, w, i);
        if x != 0 && in_set(set, ir_val(cx, x)) {
            return true;
        }
    }
    false
}

// (0.15) The identity of reduction operation `kind` at type ty.
fn reduction_identity(kind: i64, ty: i64) -> i64 {
    if kind == Op::Mul as i64 {
        1
    } else if kind == And as i64 {
        all_ones(ty)
    } else {
        0
    }
}

// (0.15) The value of header phi r (reduction `kind`, next value nx in the
// loop as it is) after the unrolled loop, in block b: the copies'
// accumulators (their next values, next[k * np + i]) combined in order;
// a phi that is no split reduction has the last copy's.
fn combine_accumulators(cx: sink *FnCtx, b: i64, kind: i64, r: i64, nx: i64, next: IntVec, np: i64,
    i: i64, u: i64) -> i64 {
    unsafe {
        if kind == 0 {
            return next.data[(u - 1) * np + i];
        }
        let ty = cx.insts[r].ty;
        var acc = next.data[i];
        for k in 1..u {
            let m = next.data[k * np + i];
            if kind > 0 {
                acc = append(cx, b, kind as Op, ty, acc, m, 0);
            } else {
                // The select of the loop on (acc, m) for (r, the other).
                let kc = cx.insts[nx].a;
                let x = if cx.insts[kc].a == r { acc } else { m };
                let y = if cx.insts[kc].b == r { acc } else { m };
                let c = cmp(cx, b, cx.insts[kc].cond, cx.insts[kc].imm2, x, y);
                let s = append(cx, b, Op::Sel, ty, c, if cx.insts[nx].b == r { acc } else { m }, 0);
                cx.insts[s].c = if cx.insts[nx].c == r { acc } else { m };
                acc = s;
            }
        }
        acc
    }
}

// (0.15) Whether a header phi of loop l is a reduction split_reduction
// takes (the exit's values not known yet: as by LCSSA).
fn has_split_reduction(cx: sink *FnCtx, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let li = pred_index(cx, h, loop_latch(cx, l));
        let outs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let spec = speculable(cx, l);
        var steps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var found = false;
        var x = cx.blocks[h].first;
        while x != 0 && cx.insts[x].op == Phi && !found {
            found = split_reduction(cx, l, x, ir_val(cx, ir_arg(cx, x, li)), outs, spec, &steps)
                != 0;
            x = cx.insts[x].next;
        }
        free(steps.data as *u8);
        found
    }
}

// Unrolls loop l by `u` (see above).
fn unroll_runtime(cx: sink *FnCtx, fi: i64, l: i64, u: i64) {
    unsafe {
        ir_enter(cx, fi);
        let h = loop_header(cx, l);
        let p = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        let hp = pred_index(cx, h, p);
        let li = pred_index(cx, h, latch);
        let e = if cx.blocks[latch].s0 == h { cx.blocks[latch].s1 } else { cx.blocks[latch].s0 };
        let start = ir_val(cx, ir_arg(cx, cx.v_iv, hp));
        let n = cx.v_n;
        let stamp = mark_loop_blocks(cx, l);
        var region = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list2.count {
            region.push(cx.lp_list2.data[i]);
        }
        let nb = region.count;
        var phis = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var x = cx.blocks[h].first;
        while x != 0 && cx.insts[x].op == Phi {
            phis.push(x);
            x = cx.insts[x].next;
        }
        var outs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        x = cx.blocks[e].first;
        while x != 0 && cx.insts[x].op == Phi {
            outs.push(ir_val(cx, ir_arg(cx, x, 0)));
            x = cx.insts[x].next;
        }
        let np = phis.count;
        let ne = outs.count;
        // (0.15) The reductions each copy keeps apart (see split_reduction):
        // their kinds, next values and starts in the loop as it is.
        var kinds = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var onext = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var ostart = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        // (0.26.2, a prototype) Sums whose steps are overflow-checked, split
        // when the loop can be redone (speculable): their (phi index, step,
        // addend) triples. Each copy or's its addends' bounds; after the
        // unrolled loop, R (the scalar loop from the start) unless they bound
        // the sums inside their type; the copies' other checks go to R too.
        let spec = speculable(cx, l);
        var spec_steps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var steps = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..np {
            let nx = ir_val(cx, ir_arg(cx, phis.data[i], li));
            onext.push(nx);
            ostart.push(ir_val(cx, ir_arg(cx, phis.data[i], hp)));
            steps.count = 0;
            kinds.push(split_reduction(cx, l, phis.data[i], nx, outs, spec, &steps));
            if kinds.data[i] != 0 {
                var s = 0;
                while s < steps.count {
                    mark_step_check(cx, steps.data[s]);
                    spec_steps.push(i);
                    spec_steps.push(steps.data[s]);
                    spec_steps.push(steps.data[s + 1]);
                    s += 2;
                }
            }
        }
        free(steps.data as *u8);
        let speculating = spec_steps.count > 0;
        let nsteps = spec_steps.count / 3;
        let restart = if speculating { ir_new_block(cx) } else { 0 };
        if speculating {
            cx.blocks[restart].sealed = 1;
        }
        var absv = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        // Per copy: its blocks (nb), header phis (np), next values (np), exit
        // values (ne), and the induction variable's next value.
        var blocks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var cphi = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var next = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var outv = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var ivn = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for _ in 0..u {
            clone_region(cx, fi, &region, stamp);
            for i in 0..nb {
                blocks.push(cx.blocks[region.data[i]].aux);
            }
            for i in 0..np {
                cphi.push(cx.insts[phis.data[i]].aux);
                next.push(clone_map(cx, ir_val(cx, ir_arg(cx, phis.data[i], li)), stamp));
            }
            for i in 0..ne {
                outv.push(clone_map(cx, outs.data[i], stamp));
            }
            ivn.push(clone_map(cx, ir_val(cx, ir_arg(cx, cx.v_iv, li)), stamp));
            // (0.26.2) A kept overflow check's copy branches to its exit too
            // (with its values for the exit's phis), or to R, speculating.
            for i in 0..nb {
                let bo = region.data[i];
                let o = ovf_index(cx, cx.blocks[bo].cond);
                if speculating || o < 0 || cx.v_ovfs.data[3 * o + 1] != OVK_KEEP {
                    continue;
                }
                let out = cx.blocks[bo].s0;
                let pi = pred_index(cx, out, bo);
                var exit_vals = IntVec { data: 0 as *i64, count: 0, cap: 0 };
                var x = cx.blocks[out].first;
                while x != 0 && cx.insts[x].op == Phi {
                    exit_vals.push(clone_map(cx, ir_val(cx, ir_arg(cx, x, pi)), stamp));
                    x = cx.insts[x].next;
                }
                add_pred_values(cx, out, cx.blocks[bo].aux, &exit_vals, 0);
                free(exit_vals.data as *u8);
            }
            // (0.26.2) The copy's addends' bounds, x ^ (x >> bits - 1) (or x,
            // unsigned), in its steps' blocks.
            for s in 0..nsteps {
                let w = clone_map(cx, spec_steps.data[3 * s + 1], stamp);
                let x = clone_map(cx, spec_steps.data[3 * s + 2], stamp);
                let ty = cx.insts[w].ty;
                let wb = cx.insts[w].block;
                if is_signed(ty) {
                    let sign = append(cx, wb, Op::Shr, ty, x, konst(cx, wb, int_bits(ty) - 1, ty),
                        0);
                    absv.push(append(cx, wb, Op::Xor, ty, x, sign, 0));
                } else {
                    absv.push(x);
                }
            }
        }
        // The copies' checks go: each branch to an unreachable exit jumps on.
        // (0.26.2) But for overflow checks of kind OVK_KEEP.
        for k in 0..u * nb {
            let b = blocks.data[k];
            let o = ovf_index(cx, cx.blocks[region.data[k % nb]].cond);
            if cx.blocks[b].term == Term::Branch
                && (o < 0 || cx.v_ovfs.data[3 * o + 1] != OVK_KEEP) {
                let a = cx.blocks[b].s0;
                let c = cx.blocks[b].s1;
                let out_a = is_unreachable_exit(cx, l, a) && !is_copy_block(blocks, a);
                let out_c = is_unreachable_exit(cx, l, c) && !is_copy_block(blocks, c);
                if out_a != out_c {
                    cx.blocks[b].term = Term::Jump;
                    cx.blocks[b].cond = 0;
                    cx.blocks[b].s0 = if out_a { c } else { a };
                    cx.blocks[b].s1 = 0;
                }
            } else if cx.blocks[b].term == Term::Branch && speculating {
                // (a kept overflow check's copy, speculating: to R)
                cx.blocks[b].s0 = restart;
                cx.blocks[restart].preds.push(b);
            }
        }
        let hi = region_index(region, h);
        let lati = region_index(region, latch);
        let h0 = blocks.data[hi];
        // Chained: copy k's header phis are copy k-1's next values.
        for k in 1..u {
            for i in 0..np {
                if kinds.data[i] == 0 {
                    ir_replace(cx, cphi.data[k * np + i], next.data[(k - 1) * np + i]);
                }
            }
            let ch = blocks.data[k * nb + hi];
            cx.blocks[ch].preds.count = 0;
            cx.blocks[ch].preds.push(blocks.data[(k - 1) * nb + lati]);
            let pl = blocks.data[(k - 1) * nb + lati];
            cx.blocks[pl].term = Term::Jump;
            cx.blocks[pl].cond = 0;
            cx.blocks[pl].s0 = ch;
            cx.blocks[pl].s1 = 0;
        }
        let last = blocks.data[(u - 1) * nb + lati];
        // C: the decision.
        let c = ir_new_block(cx);
        let up = ir_new_block(cx);
        let ux = ir_new_block(cx);
        let sp = ir_new_block(cx);
        cx.blocks[c].sealed = 1;
        cx.blocks[up].sealed = 1;
        cx.blocks[ux].sealed = 1;
        cx.blocks[sp].sealed = 1;
        cx.blocks[p].s0 = c;
        cx.blocks[c].preds.push(p);
        let trips = append(cx, c, Sub, TY_I64, n, start, 0);
        var ok = cmp(cx, c, Cond::Ge, TY_U64, trips, konst(cx, c, u, TY_I64));
        let lastv = append(cx, c, Sub, TY_I64, n, konst(cx, c, 1, TY_I64), 0);
        ok = check_tests(cx, l, c, ok, start, lastv);
        ok = ovf_tests(cx, l, c, ok, start, lastv);
        ir_terminate(cx, c, Term::Branch, ok, up, sp);
        // UP: the end of the unrolled iterations.
        let mask = konst(cx, up, 0 - u, TY_I64);
        let uend = append(cx, up, Add, TY_I64, start, append(cx, up, And, TY_I64, trips, mask, 0),
            0);
        cx.blocks[up].term = Term::Jump;
        cx.blocks[up].s0 = h0;
        cx.blocks[h0].preds.data[hp] = up;
        cx.blocks[h0].preds.data[li] = last;
        for i in 0..np {
            let back = if kinds.data[i] != 0 { next.data[i] } else { next.data[(u - 1) * np + i] };
            ir_set_arg(cx, cphi.data[i], li, back);
        }
        // (0.15) Copy k's accumulators: phis of the first copy's header,
        // from the identity (a minimum's: the start).
        var vals = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 1..u {
            for i in 0..np {
                let kind = kinds.data[i];
                if kind == 0 {
                    continue;
                }
                let ty = cx.insts[phis.data[i]].ty;
                let init = if kind < 0 { ostart.data[i] } else {
                    konst(cx, up, reduction_identity(kind, ty), ty)
                };
                vals.count = 0;
                vals.push(0);
                vals.push(0);
                vals.data[hp] = init;
                vals.data[li] = next.data[k * np + i];
                let acc = new_phi_in(cx, h0, ty, &vals, 0, 2);
                ir_replace(cx, cphi.data[k * np + i], acc);
            }
        }
        cx.blocks[h0].novec = 1;
        // (0.26.2) Each copy's bounds of a sum's addends, or'ed: a phi of
        // the first copy's header from 0, or'ed on in the last copy's latch.
        var bnext = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for k in 0..u {
            for i in 0..np {
                var acc = 0;
                for s in 0..nsteps {
                    if spec_steps.data[3 * s] != i {
                        continue;
                    }
                    let ty = cx.insts[phis.data[i]].ty;
                    if acc == 0 {
                        vals.count = 0;
                        vals.push(0);
                        vals.push(0);
                        vals.data[hp] = konst(cx, up, 0, ty);
                        acc = new_phi_in(cx, h0, ty, &vals, 0, 2);
                        bnext.push(acc);
                    }
                    acc = append(cx, last, Op::Or, ty, acc, absv.data[k * nsteps + s], 0);
                }
                if acc != 0 {
                    ir_set_arg(cx, bnext.data[bnext.count - 1], li, acc);
                    bnext.push(acc);
                } else {
                    bnext.push(0);
                    bnext.push(0);
                }
            }
        }
        // The last copy's latch.
        let more = cmp(cx, last, Cond::Ne, TY_I64, ivn.data[u - 1], uend);
        cx.blocks[last].term = Term::Branch;
        cx.blocks[last].cond = more;
        cx.blocks[last].s0 = h0;
        cx.blocks[last].s1 = ux;
        cx.blocks[ux].preds.push(last);
        // UX: done, or the rest in the scalar loop. (0.26.2) When
        // speculating, UX2 is that, UX going to R when the sums may overflow.
        var ux2 = ux;
        if speculating {
            ux2 = ir_new_block(cx);
            cx.blocks[ux2].sealed = 1;
        }
        let done = cmp(cx, ux2, Cond::Eq, TY_I64, uend, n);
        ir_terminate(cx, ux2, Term::Branch, done, e, sp);
        cx.blocks[e].preds.count -= 1;
        // (0.15) The reductions' accumulators combined.
        var comb = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in 0..np {
            comb.push(combine_accumulators(cx, ux, kinds.data[i], phis.data[i], onext.data[i],
                next, np, i, u));
        }
        vals.count = 0;
        for i in 0..ne {
            var x = outv.data[(u - 1) * ne + i];
            for j in 0..np {
                if kinds.data[j] != 0 && outs.data[i] == onext.data[j] {
                    x = comb.data[j];
                }
            }
            vals.push(x);
        }
        if speculating {
            var bad = 0;
            let count = append(cx, ux, Sub, TY_I64, uend, start, 0);
            for i in 0..np {
                var nsum = 0;
                var op = Add;
                for s in 0..nsteps {
                    if spec_steps.data[3 * s] == i {
                        nsum += 1;
                        op = cx.insts[spec_steps.data[3 * s + 1]].op;
                    }
                }
                if nsum == 0 {
                    continue;
                }
                let ty = cx.insts[phis.data[i]].ty;
                var all = bnext.data[2 * i + 1];
                for k in 1..u {
                    all = append(cx, ux, Op::Or, ty, all, bnext.data[2 * (k * np + i) + 1], 0);
                }
                let this = reduction_may_overflow(cx, ux, (op as i64) | (ty << 8), ostart.data[i],
                    all, count, nsum);
                bad = if bad == 0 { this } else { append(cx, ux, Op::Or, TY_BOOL, bad, this, 0) };
            }
            ir_terminate(cx, ux, Term::Branch, bad, restart, ux2);
            ir_terminate(cx, restart, Term::Jump, 0, sp, 0);
        }
        add_pred_values(cx, e, ux2, &vals, 0);
        // SP: the scalar loop's preheader, from C or UX.
        for i in 0..np {
            vals.count = 0;
            vals.push(ir_val(cx, ir_arg(cx, phis.data[i], hp)));
            vals.push(comb.data[i]);
            // (R's: the start again)
            vals.push(ir_val(cx, ir_arg(cx, phis.data[i], hp)));
            let r = new_phi_in(cx, sp, cx.insts[phis.data[i]].ty, &vals, 0,
                if speculating { 3 } else { 2 });
            ir_set_arg(cx, phis.data[i], hp, r);
        }
        ir_terminate(cx, sp, Term::Jump, 0, h, 0);
        cx.blocks[h].preds.count -= 1;
        cx.blocks[h].preds.data[hp] = sp;
        cx.blocks[h].novec = 1;
        free(vals.data as *u8);
        free(region.data as *u8);
        free(phis.data as *u8);
        free(outs.data as *u8);
        free(blocks.data as *u8);
        free(cphi.data as *u8);
        free(next.data as *u8);
        free(outv.data as *u8);
        free(ivn.data as *u8);
        free(kinds.data as *u8);
        free(onext.data as *u8);
        free(ostart.data as *u8);
        free(comb.data as *u8);
        free(spec_steps.data as *u8);
        free(absv.data as *u8);
        free(bnext.data as *u8);
    }
}

fn is_copy_block(blocks: IntVec, b: i64) -> bool {
    for i in 0..blocks.count {
        if unsafe { blocks.data[i] } == b {
            return true;
        }
    }
    false
}

fn region_index(region: IntVec, b: i64) -> i64 {
    for i in 0..region.count {
        if unsafe { region.data[i] } == b {
            return i;
        }
    }
    -1
}

// --no-unroll-runtime turns it off (to compare).
pub static var UNROLL_RUNTIME: bool = true;

// Unrolls the innermost counted loops of fi whose trip count is known at
// run time only; returns whether any was (fresh: the loop forest is current).
pub fn unroll_runtime_loops(cx: sink *FnCtx, fi: i64, fresh: bool) -> bool {
    unsafe {
        if !UNROLL_RUNTIME {
            return false;
        }
        if !fresh {
            canonicalize_loops(cx, fi);
        }
        var headers = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for l in 0..loop_count(cx) {
            if loop_header(cx, l) != IRFUNCS[fi].entry && is_innermost(cx, l)
                && cx.blocks[loop_header(cx, l)].novec == 0 {
                headers.push(loop_header(cx, l));
            }
        }
        var changed = false;
        var stale = false;
        for i in 0..headers.count {
            if stale {
                canonicalize_loops(cx, fi);
                stale = false;
            }
            let l = innermost_loop(cx, headers.data[i]);
            if l < 0 || loop_header(cx, l) != headers.data[i] || !is_canonical(cx, l) {
                continue;
            }
            if runtime_factor(cx, l) == 0 {
                continue;
            }
            if form_lcssa(cx, fi, l) {
                resolve_all(cx, fi);
            }
            let u = runtime_factor(cx, l);
            if u > 0 {
                unroll_runtime(cx, fi, l, u);
                changed = true;
                stale = true;
                resolve_all(cx, fi);
                verify_func(cx, fi, c"unrolling (run-time trip count)");
            }
        }
        free(headers.data as *u8);
        changed
    }
}
