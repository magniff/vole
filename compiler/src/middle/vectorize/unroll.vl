// Unrolling with run-time trip counts (0.11).
//
// An innermost counted loop (i from start, step 1, to n; any body, its only
// exits the latch's and failing checks) whose trip count is not a constant
// gets U copies of its body run per iteration, U = 4 or 2 within a size
// budget, in the vectorizer's frame (the original loop is the remainder):
//
//     C:  trips = n - start; ok = trips >= U && no check fails
//         branch ok, UP, SP
//     UP: uend = start + (trips & -U)
//     U0 .. U(U-1): the copies, chained; the checks dropped; the last
//         latch: branch i' != uend, U0, UX
//     UX: branch uend == n, E, SP
//     SP: i and the header's other phis from C or UX; the scalar loop
//
// The checks are proved before the loop as the vectorizer's are (indices
// of coefficient +1 or -1 in i), so the copies go without them; a loop
// with another kind of check, or a call, is left alone. Each copy computes
// exactly what the scalar iteration does, in order.

use crate::base::{IntVec, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_BOOL, TY_I64, TY_U64, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::all_ones;
use crate::middle::ir::{
    Cond, Op, Term, fn_entry, ir_arg, ir_enter, ir_new_block, ir_operand, ir_operand_count,
    ir_replace, ir_set_arg, ir_val,
};
use crate::middle::ir::Op::{Add, And, Cmp, Const, Phi, Sub};
use crate::middle::ir::cfg::{ir_terminate, pred_index};
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{
    add_pred_values, canonicalize_loops, clone_map, clone_region, form_lcssa, innermost_loop,
    is_canonical, is_innermost, loop_block, loop_contains, loop_count, loop_header, loop_latch,
    loop_preheader, loop_size, mark_loop_blocks, new_phi_in,
};
use crate::middle::opt::resolve_all;
use crate::middle::profile::{is_cold_block, is_hot_count};
use crate::middle::scev::counted_loop;
use crate::middle::vectorize::{VC_UNIFORM, expected_trips};
use crate::middle::vectorize::build::{append, cmp, konst, reduction_may_overflow};
use crate::middle::vectorize::checks::{
    OVK_KEEP, OVK_STEP, OVK_UNIFORM, check_tests, ovf_index, ovf_tests, ovf_uniform, record_check,
    record_ovf,
};
use crate::middle::vectorize::legality::{coef, is_unreachable_exit, loads_in, set_class};

const UNROLL_RT_SIZE: i64 = 64;

const UNROLL_RT_TINY: i64 = 12;

// (0.15) A loop with a reduction kept on several accumulators is unrolled
// up to this size even without checks: the copies then run side by side.
const UNROLL_RT_REDUCTION: i64 = 32;

// (0.18) Whether value v is read inside loop l (an operand or a branch
// condition of its blocks). A constant only the loop's exits read (a
// check's site and kind, passed to the failure on its cold path) costs
// the loop nothing, so the unroller does not count it.
fn read_in_loop(cx: &mut FnCtx<Comp>, l: i64, v: i64) -> bool {
    for i in 0..loop_size(cx, l) {
        let b = loop_block(cx, l, i);
        if (cx.blocks[b as usize]).cond != 0
            && ir_val(cx, (cx.blocks[b as usize]).cond) == v {
            return true;
        }
        let mut w = (cx.blocks[b as usize]).first;
        while w != 0 {
            for k in 0..ir_operand_count(cx, w) {
                let o = ir_operand(cx, w, k);
                if o != 0 && ir_val(cx, o) == v {
                    return true;
                }
            }
            w = (cx.insts[w as usize]).next;
        }
    }
    false
}

// (0.26.2) Whether constant v repeats the bits of a constant of loop l
// before it that the loop reads (an i64 1 and a u64 1: an i64's step and
// a usize counter's): one register holds both, so the unroller counts
// them once.
fn repeats_const(cx: &mut FnCtx<Comp>, l: i64, v: i64) -> bool {
    let ty = (cx.insts[v as usize]).ty;
    if !is_integer(ty) {
        return false;
    }
    for i in 0..loop_size(cx, l) {
        let b = loop_block(cx, l, i);
        let mut w = (cx.blocks[b as usize]).first;
        while w != 0 {
            if w == v {
                return false;
            }
            if (cx.insts[w as usize]).op == Const
                && (cx.insts[w as usize]).imm == (cx.insts[v as usize]).imm
                && is_integer((cx.insts[w as usize]).ty)
                && int_bits((cx.insts[w as usize]).ty) == int_bits(ty)
                && read_in_loop(cx, l, w) {
                return true;
            }
            w = (cx.insts[w as usize]).next;
        }
    }
    false
}

// The unrolling factor for loop l (canonical, innermost), or 0; sets V_IV,
// V_N, V_CHECKS and the classes coef needs.
fn runtime_factor(cx: &mut FnCtx<Comp>, l: i64, pcx: &Ctx<Comp>) -> i64 {
    let h = loop_header(cx, l);
    let latch = loop_latch(cx, l);
    if (cx.blocks[h as usize]).novec != 0 || is_cold_block(cx, h, pcx) || latch == 0
        || loop_preheader(cx, l) == 0
        || (cx.blocks[latch as usize]).term != Term::Branch {
        return 0;
    }
    let mut iv: i64 = 0;
    let mut step: i64 = 0;
    let mut n: i64 = 0;
    let mut ne = false;
    if !counted_loop(cx, l, &mut iv, &mut step, &mut n, &mut ne) || step != 1
        || int_bits((cx.insts[iv as usize]).ty) != 64 {
        return 0;
    }
    cx.vstamp += 1;
    cx.v_iv = iv;
    cx.v_n = n;
    cx.v_ne = ne;
    cx.v_iv2 = 0;
    cx.v_checks.clear();
    cx.v_ovfs.clear();
    cx.v_eval.clear();
    let s0 = (cx.blocks[latch as usize]).s0;
    let s1 = (cx.blocks[latch as usize]).s1;
    let e = if s0 == h { s1 } else { s0 };
    if loop_contains(cx, l, e) || (cx.blocks[e as usize]).preds.len() as i64 != 1 {
        return 0;
    }
    let mut size: i64 = 0;
    for i in 0..loop_size(cx, l) {
        let b = loop_block(cx, l, i);
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let op = (cx.insts[v as usize]).op;
            if op.is_call() || op == Op::Copy {
                return 0;
            }
            if (op.is_pure() && op != Cmp) || op == Const {
                set_class(cx, v, VC_UNIFORM);
            }
            if op != Const || read_in_loop(cx, l, v) && !repeats_const(cx, l, v) {
                size += 1;
            }
            v = (cx.insts[v as usize]).next;
        }
        if b == latch {
            continue;
        }
        let t = (cx.blocks[b as usize]).term;
        if t == Term::Branch {
            let a = (cx.blocks[b as usize]).s0;
            let c = (cx.blocks[b as usize]).s1;
            if !loop_contains(cx, l, a) || !loop_contains(cx, l, c) {
                let next = if loop_contains(cx, l, a) { a } else { c };
                let out = if next == a { c } else { a };
                if !loop_contains(cx, l, next) || !is_unreachable_exit(cx, l, out)
                    || !record_check(cx, l, b, next) && !record_ovf(cx, l, b, next) {
                    return 0;
                }
            }
        } else if t != Term::Jump || !loop_contains(cx, l, (cx.blocks[b as usize]).s0) {
            return 0;
        }
    }
    set_class(cx, iv, VC_UNIFORM);
    for k in 0..cx.v_checks.len() as i64 / 3 {
        let c = coef(cx, l, (cx.v_checks[(3 * k + 1) as usize]));
        if (c != 1 && c != -1)
            || loads_in(cx, l, (cx.v_checks[(3 * k + 1) as usize])) {
            return 0;
        }
    }
    // (0.26.2, a prototype) Overflow checks of values exactly affine in
    // the counter go too (tested before the loop); the others stay in
    // every copy.
    let mut going = cx.v_checks.len() as i64 / 3;
    for k in 0..cx.v_ovfs.len() as i64 / 3 {
        if ovf_uniform(cx, l, (cx.v_ovfs[(3 * k) as usize])) {
            (cx.v_ovfs[(3 * k + 1) as usize]) = OVK_UNIFORM;
            going += 1;
        } else {
            (cx.v_ovfs[(3 * k + 1) as usize]) = OVK_KEEP;
        }
    }
    // It pays where checks go, or where the loop's own instructions (the
    // induction variable, its test and branch) are a good part of it.
    // (0.15) Or where reductions run on several accumulators.
    if going == 0 && size > UNROLL_RT_TINY
        && (size > UNROLL_RT_REDUCTION || !has_split_reduction(cx, l)) {
        return 0;
    }
    let budget = if is_hot_count((cx.blocks[h as usize]).count, pcx) { 2 * UNROLL_RT_SIZE }
        else { UNROLL_RT_SIZE };
    let mut u: i64 = if 4 * size <= budget { 4 } else if 2 * size <= budget { 2 } else { 0 };
    // (With a profile: enough iterations an entry for a few rounds.)
    let t = expected_trips(cx, l, pcx);
    while u > 1 && t >= 0 && t < 2 * u {
        u = u / 2;
    }
    if u < 2 { 0 } else { u }
}

// (0.15) Whether v is one of the set's values.
fn in_set(set: IntVec, v: i64) -> bool {
    for i in 0..set.len() as i64 {
        if ((set[i as usize])) == v {
            return true;
        }
    }
    false
}

// (0.15) Whether header phi r of loop l (next value nx) is a reduction the
// copies may each keep apart, combined after the unrolled loop: an
// accumulator only ever combined with values that do not depend on it, by
// one associative and commutative operation (+ and -, ^, |, &, *, of
// integers), through phis and selects of such values; or a minimum or
// maximum, `k ? x : r` with k comparing x and r (an integer order). Only
// nx may be used outside the loop (outs: the exit block's values). Returns
// the operation (as i64; ADD for + and -), -1 for a minimum or maximum (its
// select nx), or 0. (0.26.2, a prototype) When `spec`, a sum whose steps
// are each overflow-checked is one too: its steps and addends into `steps`.
fn split_reduction(cx: &mut FnCtx<Comp>, l: i64, r: i64, nx: i64, outs: IntVec, spec: bool,
    steps: &mut IntVec) -> i64 {
    unsafe {
        let ty = (cx.insts[r as usize]).ty;
        if !is_integer(ty) || r == cx.v_iv || nx == r || (cx.insts[nx as usize]).block == 0
            || !loop_contains(cx, l, (cx.insts[nx as usize]).block) {
            return 0;
        }
        let h = loop_header(cx, l);
        let mut set = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        set.push(r);
        let mut family: i64 = 0;
        let mut minmax = false;
        let k = (cx.insts[nx as usize]).a;
        if (cx.insts[nx as usize]).op == Op::Sel && (cx.insts[k as usize]).op == Cmp
            && is_integer((cx.insts[k as usize]).imm2)
            && (cx.insts[k as usize]).cond != Cond::Eq
            && (cx.insts[k as usize]).cond != Cond::Ne
            && ((cx.insts[k as usize]).a == r) != ((cx.insts[k as usize]).b == r) {
            let z = if (cx.insts[k as usize]).a == r { (cx.insts[k as usize]).b }
                else { (cx.insts[k as usize]).a };
            if ((cx.insts[nx as usize]).b == r && (cx.insts[nx as usize]).c == z)
                || ((cx.insts[nx as usize]).b == z && (cx.insts[nx as usize]).c == r) {
                minmax = true;
                set.push(k);
                set.push(nx);
            }
        }
        let mut ok = true;
        let mut grew = true;
        let mut checks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        while ok && grew && !minmax {
            grew = false;
            for i in 0..loop_size(cx, l) {
                let mut w = { let at_ix = loop_block(cx, l, i) as usize; cx.blocks[at_ix].first };
                while w != 0 && ok {
                    if w != r && !in_set(set, w) && uses_set(cx, w, set) {
                        let op = (cx.insts[w as usize]).op;
                        let mut member = true;
                        if op == Phi {
                            ok = (cx.insts[w as usize]).block != h;
                            for a in 0..(cx.insts[w as usize]).nargs {
                                ok = ok && in_set(set, ir_val(cx, ir_arg(cx, w, a)));
                            }
                        } else if op == Op::Sel {
                            ok = !in_set(set, (cx.insts[w as usize]).a)
                                && in_set(set, (cx.insts[w as usize]).b)
                                && in_set(set, (cx.insts[w as usize]).c);
                        } else if (op == Add || op == Sub || op == Op::Xor || op == Op::Or
                            || op == And || op == Op::Mul) && (cx.insts[w as usize]).ty == ty {
                            let f = if op == Sub { Add as i64 } else { op as i64 };
                            ok = in_set(set, (cx.insts[w as usize]).a)
                                != in_set(set, (cx.insts[w as usize]).b)
                                && (op != Sub || in_set(set, (cx.insts[w as usize]).a))
                                && (family == 0 || family == f);
                            family = f;
                        } else if op == Op::Ovf && spec && ovf_index(cx, w) >= 0 {
                            // (0.26.2) A step's overflow check (see
                            // checked_steps): not one of the set.
                            if !in_set(checks, w) {
                                checks.push(w);
                            }
                            member = false;
                        } else {
                            ok = false;
                        }
                        if ok && member {
                            set.push(w);
                            grew = true;
                        }
                    }
                    w = (cx.insts[w as usize]).next;
                }
            }
        }
        // Nothing else uses the set inside the loop (a minimum's compare
        // and select only each other and r), nor outside but nx, nor a
        // terminator.
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            if (cx.blocks[b as usize]).term != Term::Jump
                && in_set(set, ir_val(cx, (cx.blocks[b as usize]).cond)) {
                ok = false;
            }
            if minmax {
                let mut w = (cx.blocks[b as usize]).first;
                while w != 0 && ok {
                    if w != r && w != k && w != nx && uses_set(cx, w, set) {
                        ok = false;
                    }
                    w = (cx.insts[w as usize]).next;
                }
            }
        }
        ok = ok && in_set(set, nx) && (minmax || family != 0);
        for i in 0..outs.len() as i64 {
            let x = (outs[i as usize]);
            if x != nx && in_set(set, x) {
                ok = false;
            }
        }
        // (0.26.2) Checked steps: split when spec, the loop redone from its
        // start when the sums may overflow (unroll_runtime).
        if ok && checks.len() as i64 > 0 {
            ok = !minmax && family == Add as i64 && checked_steps(cx, set, checks, ty, steps);
        }
        free(checks.data as *mut u8);
        free(set.data as *mut u8);
        if !ok { 0 } else if minmax { -1 } else { family }
    }
}

// (0.26.2, a prototype) Whether `checks`, overflow checks on values of
// `set` (a reduction's, of type ty), check its steps: each the + or - of a
// step of the set on its operands, every step checked, all of one sign when
// unsigned. The steps and their addends, pairs, into `steps`.
fn checked_steps(cx: &mut FnCtx<Comp>, set: IntVec, checks: IntVec, ty: i64, steps: &mut IntVec) -> bool {
    let mut count: i64 = 0;
    let mut adds: i64 = 0;
    for i in 0..set.len() as i64 {
        let w = (set[i as usize]);
        let op = (cx.insts[w as usize]).op;
        if op != Add && op != Sub {
            continue;
        }
        count += 1;
        if op == Add {
            adds += 1;
        }
        let a = ir_val(cx, (cx.insts[w as usize]).a);
        let b = ir_val(cx, (cx.insts[w as usize]).b);
        let mut found = false;
        for j in 0..checks.len() as i64 {
            let c = (checks[j as usize]);
            let imm = (cx.insts[c as usize]).imm;
            let ca = ir_val(cx, (cx.insts[c as usize]).a);
            let cb = ir_val(cx, (cx.insts[c as usize]).b);
            if (imm & 255) == op as i64 && (imm >> 8) == ty
                && (ca == a && cb == b || op == Add && ca == b && cb == a) {
                found = true;
            }
        }
        if !found {
            return false;
        }
        steps.push(w);
        steps.push(if in_set(set, a) { b } else { a });
    }
    count == checks.len() as i64 && (is_signed(ty) || adds == 0 || adds == count)
}

// (0.26.2, a prototype) Whether loop l may be redone from its start when a
// check of its unrolled copies fails (see unroll_runtime): it stores
// nothing, and its body is a chain, its only branches checks and its latch.
fn speculable(cx: &mut FnCtx<Comp>, l: i64) -> bool {
    let latch = loop_latch(cx, l);
    for i in 0..loop_size(cx, l) {
        let b = loop_block(cx, l, i);
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let op = (cx.insts[v as usize]).op;
            if op == Op::Store || op == Op::Copy || op == Op::Atomic || op == Op::Fence
                || op.is_call() {
                return false;
            }
            v = (cx.insts[v as usize]).next;
        }
        if b != latch && (cx.blocks[b as usize]).term == Term::Branch
            && loop_contains(cx, l, (cx.blocks[b as usize]).s0)
            && loop_contains(cx, l, (cx.blocks[b as usize]).s1) {
            return false;
        }
    }
    true
}

// (0.26.2) Marks the overflow check of step w (one of the same operation
// and operands) in V_OVFS as OVK_STEP.
fn mark_step_check(cx: &mut FnCtx<Comp>, w: i64) {
    let a = ir_val(cx, (cx.insts[w as usize]).a);
    let b = ir_val(cx, (cx.insts[w as usize]).b);
    for k in 0..cx.v_ovfs.len() as i64 / 3 {
        let c = (cx.v_ovfs[(3 * k) as usize]);
        let ca = ir_val(cx, (cx.insts[c as usize]).a);
        let cb = ir_val(cx, (cx.insts[c as usize]).b);
        if ((cx.insts[c as usize]).imm & 255) == (cx.insts[w as usize]).op as i64
            && (ca == a && cb == b
                || (cx.insts[w as usize]).op == Add && ca == b && cb == a) {
            (cx.v_ovfs[(3 * k + 1) as usize]) = OVK_STEP;
        }
    }
}

fn uses_set(cx: &mut FnCtx<Comp>, w: i64, set: IntVec) -> bool {
    for i in 0..ir_operand_count(cx, w) {
        let x = ir_operand(cx, w, i);
        if x != 0 && in_set(set, ir_val(cx, x)) {
            return true;
        }
    }
    false
}

// (0.15) The identity of reduction operation `kind` at type ty.
fn reduction_identity(kind: i64, ty: i64) -> i64 {
    if kind == Op::Mul as i64 {
        1
    } else if kind == And as i64 {
        all_ones(ty)
    } else {
        0
    }
}

// (0.15) The value of header phi r (reduction `kind`, next value nx in the
// loop as it is) after the unrolled loop, in block b: the copies'
// accumulators (their next values, next[k * np + i]) combined in order;
// a phi that is no split reduction has the last copy's.
fn combine_accumulators(cx: &mut FnCtx<Comp>, b: i64, kind: i64, r: i64, nx: i64, next: IntVec,
    np: i64, i: i64, u: i64, pcx: &Ctx<Comp>) -> i64 {
    if kind == 0 {
        return (next[((u - 1) * np + i) as usize]);
    }
    let ty = (cx.insts[r as usize]).ty;
    let mut acc = (next[i as usize]);
    for k in 1..u {
        let m = (next[(k * np + i) as usize]);
        if kind > 0 {
            acc = append(cx, b, kind as Op, ty, acc, m, 0, pcx);
        } else {
            // The select of the loop on (acc, m) for (r, the other).
            let kc = (cx.insts[nx as usize]).a;
            let x = if (cx.insts[kc as usize]).a == r { acc } else { m };
            let y = if (cx.insts[kc as usize]).b == r { acc } else { m };
            let c = cmp(cx, b, (cx.insts[kc as usize]).cond,
                (cx.insts[kc as usize]).imm2, x, y, pcx);
            let s = append(cx, b, Op::Sel, ty, c,
                if (cx.insts[nx as usize]).b == r { acc } else { m }, 0, pcx);
            (cx.insts[s as usize]).c = if (cx.insts[nx as usize]).c == r { acc }
                else { m };
            acc = s;
        }
    }
    acc
}

// (0.15) Whether a header phi of loop l is a reduction split_reduction
// takes (the exit's values not known yet: as by LCSSA).
fn has_split_reduction(cx: &mut FnCtx<Comp>, l: i64) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let loop_latch_v = loop_latch(cx, l);
        let li = pred_index(cx, h, loop_latch_v);
        let outs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let spec = speculable(cx, l);
        let mut steps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut found = false;
        let mut x = (cx.blocks[h as usize]).first;
        while x != 0 && (cx.insts[x as usize]).op == Phi && !found {
            let ir_arg_v = ir_arg(cx, x, li);
            let ir_val_v = ir_val(cx, ir_arg_v);
            let split_reduction_v = split_reduction(cx, l, x, ir_val_v,
                outs, spec, &mut steps);
            found = split_reduction_v
                != 0;
            x = (cx.insts[x as usize]).next;
        }
        free(steps.data as *mut u8);
        found
    }
}

// Unrolls loop l by `u` (see above).
fn unroll_runtime(cx: &mut FnCtx<Comp>, fi: i64, l: i64, u: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let h = loop_header(cx, l);
        let p = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        let hp = pred_index(cx, h, p);
        let li = pred_index(cx, h, latch);
        let e = if (cx.blocks[latch as usize]).s0 == h { (cx.blocks[latch as usize]).s1 }
            else { (cx.blocks[latch as usize]).s0 };
        let ir_arg_v = ir_arg(cx, cx.v_iv, hp);
        let start = ir_val(cx, ir_arg_v);
        let n = cx.v_n;
        let stamp = mark_loop_blocks(cx, l);
        let mut region = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list2.len() as i64 {
            region.push((cx.lp_list2[i as usize]));
        }
        let nb = region.len() as i64;
        let mut phis = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut x = (cx.blocks[h as usize]).first;
        while x != 0 && (cx.insts[x as usize]).op == Phi {
            phis.push(x);
            x = (cx.insts[x as usize]).next;
        }
        let mut outs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        x = (cx.blocks[e as usize]).first;
        while x != 0 && (cx.insts[x as usize]).op == Phi {
            let ir_arg_v2 = ir_arg(cx, x, 0);
            let ir_val_v = ir_val(cx, ir_arg_v2);
            outs.push(ir_val_v);
            x = (cx.insts[x as usize]).next;
        }
        let np = phis.len() as i64;
        let ne = outs.len() as i64;
        // (0.15) The reductions each copy keeps apart (see split_reduction):
        // their kinds, next values and starts in the loop as it is.
        let mut kinds = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut onext = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ostart = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // (0.26.2, a prototype) Sums whose steps are overflow-checked, split
        // when the loop can be redone (speculable): their (phi index, step,
        // addend) triples. Each copy or's its addends' bounds; after the
        // unrolled loop, R (the scalar loop from the start) unless they bound
        // the sums inside their type; the copies' other checks go to R too.
        let spec = speculable(cx, l);
        let mut spec_steps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut steps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..np {
            let ir_arg_v1 = ir_arg(cx, (phis[i as usize]), li);
            let nx = ir_val(cx, ir_arg_v1);
            onext.push(nx);
            let ir_arg_v3 = ir_arg(cx, (phis[i as usize]), hp);
            let ir_val_v1 = ir_val(cx, ir_arg_v3);
            ostart.push(ir_val_v1);
            steps.clear();
            kinds.push(split_reduction(cx, l, (phis[i as usize]), nx, outs, spec,
                &mut steps));
            if (kinds[i as usize]) != 0 {
                let mut s: i64 = 0;
                while s < steps.len() as i64 {
                    mark_step_check(cx, (steps[s as usize]));
                    spec_steps.push(i);
                    spec_steps.push((steps[s as usize]));
                    spec_steps.push((steps[(s + 1) as usize]));
                    s += 2;
                }
            }
        }
        free(steps.data as *mut u8);
        let speculating = spec_steps.len() as i64 > 0;
        let nsteps = spec_steps.len() as i64 / 3;
        let restart: i64 = if speculating { ir_new_block(cx) } else { 0 };
        if speculating {
            (cx.blocks[restart as usize]).sealed = 1;
        }
        let mut absv = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // Per copy: its blocks (nb), header phis (np), next values (np), exit
        // values (ne), and the induction variable's next value.
        let mut blocks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut cphi = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut next = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut outv = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ivn = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for _ in 0..u {
            clone_region(cx, fi, region.as_slice(), stamp, pcx);
            for i in 0..nb {
                blocks.push((cx.blocks[(region[i as usize]) as usize]).aux);
            }
            for i in 0..np {
                cphi.push((cx.insts[(phis[i as usize]) as usize]).aux);
                let ir_arg_v6 = ir_arg(cx, (phis[i as usize]), li);
                let ir_val_v4 = ir_val(cx, ir_arg_v6);
                let clone_map_v = clone_map(cx, ir_val_v4, stamp);
                next.push(clone_map_v);
            }
            for i in 0..ne {
                outv.push(clone_map(cx, (outs[i as usize]), stamp));
            }
            let ir_arg_v7 = ir_arg(cx, cx.v_iv, li);
            let ir_val_v5 = ir_val(cx, ir_arg_v7);
            let clone_map_v1 = clone_map(cx, ir_val_v5, stamp);
            ivn.push(clone_map_v1);
            // (0.26.2) A kept overflow check's copy branches to its exit too
            // (with its values for the exit's phis), or to R, speculating.
            for i in 0..nb {
                let bo = (region[i as usize]);
                let o = ovf_index(cx, (cx.blocks[bo as usize]).cond);
                if speculating || o < 0 || (cx.v_ovfs[(3 * o + 1) as usize]) != OVK_KEEP {
                    continue;
                }
                let out = (cx.blocks[bo as usize]).s0;
                let pi = pred_index(cx, out, bo);
                let mut exit_vals = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
                let mut x = (cx.blocks[out as usize]).first;
                while x != 0 && (cx.insts[x as usize]).op == Phi {
                    let ir_arg_v8 = ir_arg(cx, x, pi);
                    let ir_val_v6 = ir_val(cx, ir_arg_v8);
                    let clone_map_v2 = clone_map(cx, ir_val_v6, stamp);
                    exit_vals.push(clone_map_v2);
                    x = (cx.insts[x as usize]).next;
                }
                add_pred_values(cx, out, (cx.blocks[bo as usize]).aux, exit_vals.as_slice(), 0);
                free(exit_vals.data as *mut u8);
            }
            // (0.26.2) The copy's addends' bounds, x ^ (x >> bits - 1) (or x,
            // unsigned), in its steps' blocks.
            for s in 0..nsteps {
                let w = clone_map(cx, (spec_steps[(3 * s + 1) as usize]), stamp);
                let x = clone_map(cx, (spec_steps[(3 * s + 2) as usize]), stamp);
                let ty = (cx.insts[w as usize]).ty;
                let wb = (cx.insts[w as usize]).block;
                if is_signed(ty) {
                    let konst_v = konst(cx, wb, int_bits(ty) - 1, ty, pcx);
                    let sign = append(cx, wb, Op::Shr, ty, x,
                        konst_v, 0, pcx);
                    absv.push(append(cx, wb, Op::Xor, ty, x, sign, 0, pcx));
                } else {
                    absv.push(x);
                }
            }
        }
        // The copies' checks go: each branch to an unreachable exit jumps on.
        // (0.26.2) But for overflow checks of kind OVK_KEEP.
        for k in 0..u * nb {
            let b = (blocks[k as usize]);
            let o = ovf_index(cx,
                (cx.blocks[(region[(k % nb) as usize]) as usize]).cond);
            if (cx.blocks[b as usize]).term == Term::Branch
                && (o < 0 || (cx.v_ovfs[(3 * o + 1) as usize]) != OVK_KEEP) {
                let a = (cx.blocks[b as usize]).s0;
                let c = (cx.blocks[b as usize]).s1;
                let out_a = is_unreachable_exit(cx, l, a) && !is_copy_block(blocks, a);
                let out_c = is_unreachable_exit(cx, l, c) && !is_copy_block(blocks, c);
                if out_a != out_c {
                    (cx.blocks[b as usize]).term = Term::Jump;
                    (cx.blocks[b as usize]).cond = 0;
                    (cx.blocks[b as usize]).s0 = if out_a { c } else { a };
                    (cx.blocks[b as usize]).s1 = 0;
                }
            } else if (cx.blocks[b as usize]).term == Term::Branch && speculating {
                // (a kept overflow check's copy, speculating: to R)
                (cx.blocks[b as usize]).s0 = restart;
                (cx.blocks[restart as usize]).preds.push(b);
            }
        }
        let hi = region_index(region, h);
        let lati = region_index(region, latch);
        let h0 = (blocks[hi as usize]);
        // Chained: copy k's header phis are copy k-1's next values.
        for k in 1..u {
            for i in 0..np {
                if (kinds[i as usize]) == 0 {
                    ir_replace(cx, (cphi[(k * np + i) as usize]),
                        (next[((k - 1) * np + i) as usize]));
                }
            }
            let ch = (blocks[(k * nb + hi) as usize]);
            (cx.blocks[ch as usize]).preds.clear();
            (cx.blocks[ch as usize]).preds.push(
                (blocks[((k - 1) * nb + lati) as usize]));
            let pl = (blocks[((k - 1) * nb + lati) as usize]);
            (cx.blocks[pl as usize]).term = Term::Jump;
            (cx.blocks[pl as usize]).cond = 0;
            (cx.blocks[pl as usize]).s0 = ch;
            (cx.blocks[pl as usize]).s1 = 0;
        }
        let last = (blocks[((u - 1) * nb + lati) as usize]);
        // C: the decision.
        let c = ir_new_block(cx);
        let up = ir_new_block(cx);
        let ux = ir_new_block(cx);
        let sp = ir_new_block(cx);
        (cx.blocks[c as usize]).sealed = 1;
        (cx.blocks[up as usize]).sealed = 1;
        (cx.blocks[ux as usize]).sealed = 1;
        (cx.blocks[sp as usize]).sealed = 1;
        (cx.blocks[p as usize]).s0 = c;
        (cx.blocks[c as usize]).preds.push(p);
        let trips = append(cx, c, Sub, TY_I64, n, start, 0, pcx);
        let konst_v1 = konst(cx, c, u, TY_I64, pcx);
        let mut ok = cmp(cx, c, Cond::Ge, TY_U64, trips, konst_v1, pcx);
        let konst_v2 = konst(cx, c, 1, TY_I64, pcx);
        let lastv = append(cx, c, Sub, TY_I64, n, konst_v2, 0, pcx);
        ok = check_tests(cx, l, c, ok, start, lastv, pcx);
        ok = ovf_tests(cx, l, c, ok, start, lastv, pcx);
        ir_terminate(cx, c, Term::Branch, ok, up, sp);
        // UP: the end of the unrolled iterations.
        let mask = konst(cx, up, 0 - u, TY_I64, pcx);
        let append_v = append(cx, up, And, TY_I64, trips, mask, 0, pcx);
        let uend = append(cx, up, Add, TY_I64, start,
            append_v, 0, pcx);
        (cx.blocks[up as usize]).term = Term::Jump;
        (cx.blocks[up as usize]).s0 = h0;
        ((cx.blocks[h0 as usize]).preds[hp as usize]) = up;
        ((cx.blocks[h0 as usize]).preds[li as usize]) = last;
        for i in 0..np {
            let back = if (kinds[i as usize]) != 0 { (next[i as usize]) }
                else { (next[((u - 1) * np + i) as usize]) };
            ir_set_arg(cx, (cphi[i as usize]), li, back);
        }
        // (0.15) Copy k's accumulators: phis of the first copy's header,
        // from the identity (a minimum's: the start).
        let mut vals = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 1..u {
            for i in 0..np {
                let kind = (kinds[i as usize]);
                if kind == 0 {
                    continue;
                }
                let ty = (cx.insts[(phis[i as usize]) as usize]).ty;
                let init = if kind < 0 { (ostart[i as usize]) } else {
                    konst(cx, up, reduction_identity(kind, ty), ty, pcx)
                };
                vals.clear();
                vals.push(0);
                vals.push(0);
                (vals[hp as usize]) = init;
                (vals[li as usize]) = (next[(k * np + i) as usize]);
                let acc = new_phi_in(cx, h0, ty, vals.as_slice(), 0, 2, pcx);
                ir_replace(cx, (cphi[(k * np + i) as usize]), acc);
            }
        }
        (cx.blocks[h0 as usize]).novec = 1;
        // (0.26.2) Each copy's bounds of a sum's addends, or'ed: a phi of
        // the first copy's header from 0, or'ed on in the last copy's latch.
        let mut bnext = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for k in 0..u {
            for i in 0..np {
                let mut acc: i64 = 0;
                for s in 0..nsteps {
                    if (spec_steps[(3 * s) as usize]) != i {
                        continue;
                    }
                    let ty = (cx.insts[(phis[i as usize]) as usize]).ty;
                    if acc == 0 {
                        vals.clear();
                        vals.push(0);
                        vals.push(0);
                        (vals[hp as usize]) = konst(cx, up, 0, ty, pcx);
                        acc = new_phi_in(cx, h0, ty, vals.as_slice(), 0, 2, pcx);
                        bnext.push(acc);
                    }
                    acc = append(cx, last, Op::Or, ty, acc,
                        (absv[(k * nsteps + s) as usize]), 0, pcx);
                }
                if acc != 0 {
                    ir_set_arg(cx, (bnext[(bnext.len() as i64 - 1) as usize]), li, acc);
                    bnext.push(acc);
                } else {
                    bnext.push(0);
                    bnext.push(0);
                }
            }
        }
        // The last copy's latch.
        let more = cmp(cx, last, Cond::Ne, TY_I64, (ivn[(u - 1) as usize]), uend, pcx);
        (cx.blocks[last as usize]).term = Term::Branch;
        (cx.blocks[last as usize]).cond = more;
        (cx.blocks[last as usize]).s0 = h0;
        (cx.blocks[last as usize]).s1 = ux;
        (cx.blocks[ux as usize]).preds.push(last);
        // UX: done, or the rest in the scalar loop. (0.26.2) When
        // speculating, UX2 is that, UX going to R when the sums may overflow.
        let mut ux2 = ux;
        if speculating {
            ux2 = ir_new_block(cx);
            (cx.blocks[ux2 as usize]).sealed = 1;
        }
        let done = cmp(cx, ux2, Cond::Eq, TY_I64, uend, n, pcx);
        ir_terminate(cx, ux2, Term::Branch, done, e, sp);
        (cx.blocks[e as usize]).preds.pop();
        // (0.15) The reductions' accumulators combined.
        let mut comb = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..np {
            comb.push(combine_accumulators(cx, ux, (kinds[i as usize]),
                (phis[i as usize]), (onext[i as usize]), next, np, i, u, pcx));
        }
        vals.clear();
        for i in 0..ne {
            let mut x = (outv[((u - 1) * ne + i) as usize]);
            for j in 0..np {
                if (kinds[j as usize]) != 0
                    && (outs[i as usize]) == (onext[j as usize]) {
                    x = (comb[j as usize]);
                }
            }
            vals.push(x);
        }
        if speculating {
            let mut bad: i64 = 0;
            let count = append(cx, ux, Sub, TY_I64, uend, start, 0, pcx);
            for i in 0..np {
                let mut nsum: i64 = 0;
                let mut op = Add;
                for s in 0..nsteps {
                    if (spec_steps[(3 * s) as usize]) == i {
                        nsum += 1;
                        op = (cx.insts[(spec_steps[(3 * s + 1) as usize]) as usize]).op;
                    }
                }
                if nsum == 0 {
                    continue;
                }
                let ty = (cx.insts[(phis[i as usize]) as usize]).ty;
                let mut all = (bnext[(2 * i + 1) as usize]);
                for k in 1..u {
                    all = append(cx, ux, Op::Or, ty, all,
                        (bnext[(2 * (k * np + i) + 1) as usize]), 0, pcx);
                }
                let this = reduction_may_overflow(cx, ux, (op as i64) | (ty << 8),
                    (ostart[i as usize]), all, count, nsum, pcx);
                bad = if bad == 0 { this }
                    else { append(cx, ux, Op::Or, TY_BOOL, bad, this, 0, pcx) };
            }
            ir_terminate(cx, ux, Term::Branch, bad, restart, ux2);
            ir_terminate(cx, restart, Term::Jump, 0, sp, 0);
        }
        add_pred_values(cx, e, ux2, vals.as_slice(), 0);
        // SP: the scalar loop's preheader, from C or UX.
        for i in 0..np {
            vals.clear();
            let ir_arg_v4 = ir_arg(cx, (phis[i as usize]), hp);
            let ir_val_v2 = ir_val(cx, ir_arg_v4);
            vals.push(ir_val_v2);
            vals.push((comb[i as usize]));
            let ir_arg_v5 = ir_arg(cx, (phis[i as usize]), hp);
            let ir_val_v3 = ir_val(cx, ir_arg_v5);
            // (R's: the start again)
            vals.push(ir_val_v3);
            let r = new_phi_in(cx, sp, (cx.insts[(phis[i as usize]) as usize]).ty, vals.as_slice(),
                0, if speculating { 3 } else { 2 }, pcx);
            ir_set_arg(cx, (phis[i as usize]), hp, r);
        }
        ir_terminate(cx, sp, Term::Jump, 0, h, 0);
        (cx.blocks[h as usize]).preds.pop();
        ((cx.blocks[h as usize]).preds[hp as usize]) = sp;
        (cx.blocks[h as usize]).novec = 1;
        free(vals.data as *mut u8);
        free(region.data as *mut u8);
        free(phis.data as *mut u8);
        free(outs.data as *mut u8);
        free(blocks.data as *mut u8);
        free(cphi.data as *mut u8);
        free(next.data as *mut u8);
        free(outv.data as *mut u8);
        free(ivn.data as *mut u8);
        free(kinds.data as *mut u8);
        free(onext.data as *mut u8);
        free(ostart.data as *mut u8);
        free(comb.data as *mut u8);
        free(spec_steps.data as *mut u8);
        free(absv.data as *mut u8);
        free(bnext.data as *mut u8);
    }
}

fn is_copy_block(blocks: IntVec, b: i64) -> bool {
    for i in 0..blocks.len() as i64 {
        if ((blocks[i as usize])) == b {
            return true;
        }
    }
    false
}

fn region_index(region: IntVec, b: i64) -> i64 {
    for i in 0..region.len() as i64 {
        if ((region[i as usize])) == b {
            return i;
        }
    }
    -1
}

// Unrolls the innermost counted loops of fi whose trip count is known at
// run time only; returns whether any was (fresh: the loop forest is current).
pub fn unroll_runtime_loops(cx: &mut FnCtx<Comp>, fi: i64, fresh: bool, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !pcx.unroll_runtime {
            return false;
        }
        if !fresh {
            canonicalize_loops(cx, fi, pcx);
        }
        let mut headers = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for l in 0..loop_count(cx) {
            if loop_header(cx, l) != fn_entry(cx, fi) && is_innermost(cx, l)
                && { let at_ix = loop_header(cx, l) as usize; cx.blocks[at_ix].novec } == 0 {
                headers.push(loop_header(cx, l));
            }
        }
        let mut changed = false;
        let mut stale = false;
        for i in 0..headers.len() as i64 {
            if stale {
                canonicalize_loops(cx, fi, pcx);
                stale = false;
            }
            let l = innermost_loop(cx, (headers[i as usize]));
            if l < 0 || loop_header(cx, l) != (headers[i as usize])
                || !is_canonical(cx, l) {
                continue;
            }
            if runtime_factor(cx, l, pcx) == 0 {
                continue;
            }
            if form_lcssa(cx, fi, l, pcx) {
                resolve_all(cx, fi);
            }
            let u = runtime_factor(cx, l, pcx);
            if u > 0 {
                unroll_runtime(cx, fi, l, u, pcx);
                changed = true;
                stale = true;
                resolve_all(cx, fi);
                verify_func(cx, fi, c"unrolling (run-time trip count)", pcx);
            }
        }
        free(headers.data as *mut u8);
        changed
    }
}
