// Whether an innermost loop can be vectorized (analyze): its shape (a
// chain of blocks, branching out only to checks that fail), its memory
// accesses (unit-stride, of one element type), its reductions, and the
// class of each of its instructions (uniform, vector or skipped), with the
// affine coefficients of values in the induction variables (coef).

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{
    TY_BOOL, TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, int_bits,
    is_float, is_integer, is_signed, type_size, vector_type,
};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::ir::{Cond, Op, Term, ir_arg, ir_operand, ir_operand_count, ir_val};
use crate::middle::ir::Op::{
    Add, And, Const, Conv, Div, Load, Mul, Neg, Or, Phi, Shl, Store, Sub, Xor,
};
use crate::middle::ir::cfg::pred_index;
use crate::middle::loops::{
    invariant_in, loop_contains, loop_header, loop_latch, loop_preheader, loop_size,
};
use crate::middle::profile::is_cold_block;
use crate::middle::scev::counted_loop;
use crate::middle::vectorize::{
    VC_SKIP, VC_UNIFORM, VC_VECTOR, VC_WIDE, VC_WMUL, VEC_MAX_INSTS, VEC_MAX_OVERLAPS,
};
use crate::middle::vectorize::checks::{
    OVK_LANE, OVK_RED, OVK_UNIFORM, has_ovf_kind, overlap_pairs, ovf_index, ovf_uniform,
    record_check, record_ovf,
};

pub fn class_of(cx: &mut FnCtx, v: i64) -> i64 {
    unsafe {
        if v != 0
            && (*cx.insts.add(v as usize)).mark == cx.vstamp { (*cx.insts.add(v as usize)).aux }
        else { 0 }
    }
}

pub fn set_class(cx: &mut FnCtx, v: i64, c: i64) {
    unsafe {
        (*cx.insts.add(v as usize)).mark = cx.vstamp;
        (*cx.insts.add(v as usize)).aux = c;
    }
}

// The coefficient of the induction variable in v (a uniform value or an
// invariant one): v = coef * i + (something invariant). NONAFFINE when v
// is not such a value.
pub const NONAFFINE: i64 = 9223372036854775807;

pub fn coef(cx: &mut FnCtx, l: i64, v: i64) -> i64 {
    coef_wrt(cx, l, v, cx.v_iv, cx.v_iv2)
}

// The coefficient of induction variable `iv` in v, where `other` (another
// induction variable, of an inner loop, or 0) counts as invariant.
pub fn coef_wrt(cx: &mut FnCtx, l: i64, v: i64, iv: i64, other: i64) -> i64 {
    unsafe {
        let x = ir_val(cx, v);
        if x == iv {
            return 1;
        }
        if x == other && other != 0 {
            return 0;
        }
        if invariant_in(cx, l, x) {
            return 0;
        }
        if class_of(cx, x) != VC_UNIFORM {
            return NONAFFINE;
        }
        let op = (*cx.insts.add(x as usize)).op;
        let a: i64 = if (*cx.insts.add(x as usize)).a
            != 0 { coef_wrt(cx, l, (*cx.insts.add(x as usize)).a, iv, other) } else { 0 };
        let b: i64 = if (*cx.insts.add(x as usize)).b
            != 0 { coef_wrt(cx, l, (*cx.insts.add(x as usize)).b, iv, other) } else { 0 };
        if a == NONAFFINE || b == NONAFFINE {
            return NONAFFINE;
        }
        if a == 0 && b == 0 {
            // Computed from invariants alone (it would be hoisted).
            return 0;
        }
        let wide = is_integer((*cx.insts.add(x as usize)).ty)
            && int_bits((*cx.insts.add(x as usize)).ty) == 64;
        if !wide {
            return NONAFFINE;
        }
        if op == Add {
            return a + b;
        }
        if op == Sub {
            return a - b;
        }
        let arg_v = op == Mul
            && { let at_arg1 = ir_val(cx, (*cx.insts.add(x as usize)).b); is_const(cx, at_arg1) };
        if arg_v && b == 0 {
            return a * (*cx.insts.add(ir_val(cx, (*cx.insts.add(x as usize)).b) as usize)).imm;
        }
        let arg_v1 = op == Mul
            && { let at_arg1 = ir_val(cx, (*cx.insts.add(x as usize)).a); is_const(cx, at_arg1) };
        if arg_v1 && a == 0 {
            return b * (*cx.insts.add(ir_val(cx, (*cx.insts.add(x as usize)).a) as usize)).imm;
        }
        let arg_v2 = op == Shl
            && { let at_arg1 = ir_val(cx, (*cx.insts.add(x as usize)).b); is_const(cx, at_arg1) };
        if arg_v2 && b == 0 {
            let k = (*cx.insts.add(ir_val(cx, (*cx.insts.add(x as usize)).b) as usize)).imm;
            if k >= 0 && k < 16 {
                return a << k as u64;
            }
        }
        if op == Conv && is_integer((*cx.insts.add(x as usize)).imm2)
            && int_bits((*cx.insts.add(x as usize)).imm2) == 64 {
            return a;
        }
        NONAFFINE
    }
}

// The lane type of IR type t when it can be one (integers by their signed
// type), else 0.
pub fn lane_type(t: i64) -> i64 {
    if t == TY_F32 || t == TY_F64 || t == TY_I64 || t == TY_I32 || t == TY_I16 || t == TY_I8 {
        return t;
    }
    if t == TY_U64 { return TY_I64; }
    if t == TY_U32 { return TY_I32; }
    if t == TY_U16 { return TY_I16; }
    if t == TY_U8 { return TY_I8; }
    0
}

// Records T, the type of the loop's vectorized values; false when another
// one was seen.
pub fn use_elem(cx: &mut FnCtx, t: i64) -> bool {
    let lt = lane_type(t);
    if lt == 0 {
        return false;
    }
    if cx.v_elem == 0 {
        cx.v_elem = t;
        return true;
    }
    // (0.26.2) Integers of one width share their lanes, whatever their
    // sign: a usize count (u64) of i64 elements is one vector type; a
    // comparison or a minimum that depends on the sign checks it itself.
    cx.v_elem == t || lane_type(cx.v_elem) == lt
}

// Whether v (an operand of a vector operation) has a value: a vector, or
// one value for all lanes (invariant, or uniform without the induction
// variable).
pub fn vector_operand_ok(cx: &mut FnCtx, l: i64, v: i64) -> bool {
    let x = ir_val(cx, v);
    let c = class_of(cx, x);
    if c == VC_VECTOR {
        return true;
    }
    if c == VC_WIDE || c == VC_WMUL {
        return false;
    }
    coef(cx, l, x) == 0
}

pub fn is_unreachable_exit(cx: &mut FnCtx, l: i64, b: i64) -> bool {
    unsafe { !loop_contains(cx, l, b) && (*cx.blocks.add(b as usize)).term == Term::Unreach }
}

// (0.25.5) --vec-stats=FN: says why the loop is not vectorized (the first
// reason found), and returns false.
pub fn why(cx: &mut FnCtx, reason: *mut u8) -> bool {
    cx.v_why = reason;
    cx.v_why_inst = 0;
    false
}

// The same, at instruction v.
fn why_at(cx: &mut FnCtx, reason: *mut u8, v: i64) -> bool {
    cx.v_why = reason;
    cx.v_why_inst = v;
    false
}

// Classifies the instructions of loop l; false when it cannot be
// vectorized (0.25.5: the reason in cx.v_why, for --vec-stats=FN).
pub fn analyze(cx: &mut FnCtx, l: i64, exit: &mut i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        cx.vstamp += 1;
        cx.v_elem = 0;
        cx.v_has_store = false;
        cx.v_has_uload = false;
        cx.v_iv2 = 0;
        cx.v_chain.count = 0;
        cx.v_checks.count = 0;
        cx.v_ovfs.count = 0;
        cx.v_access.count = 0;
        cx.v_reds.count = 0;
        cx.v_why = 0 as *mut u8;
        cx.v_why_inst = 0;
        let h = loop_header(cx, l);
        let latch = loop_latch(cx, l);
        if (*cx.blocks.add(h as usize)).novec != 0 {
            return why(cx, c"a vector loop's scalar rest");
        }
        if is_cold_block(cx, h, pcx) {
            return why(cx, c"cold (on a path to a panic or marked #[cold])");
        }
        if latch == 0 || loop_preheader(cx, l) == 0
            || (*cx.blocks.add(latch as usize)).term != Term::Branch {
            return why(cx, c"not in canonical form: no preheader, or no one latch that branches");
        }
        let mut iv: i64 = 0;
        let mut step: i64 = 0;
        let mut n: i64 = 0;
        let mut ne = false;
        if !counted_loop(cx, l, &mut iv, &mut step, &mut n, &mut ne) {
            return why(cx, c"an unknown trip count: not a loop over a counter to a bound");
        }
        if step != 1 || int_bits((*cx.insts.add(iv as usize)).ty) != 64 {
            return why(cx, c"its counter steps by other than 1, or is not 64 bits wide");
        }
        cx.v_iv = iv;
        cx.v_n = n;
        cx.v_ne = ne;
        // The chain of blocks.
        let mut b = h;
        let mut count: i64 = 0;
        loop {
            cx.v_chain.push(b);
            if b == latch {
                break;
            }
            if (*cx.blocks.add(b as usize)).term == Term::Jump
                && loop_contains(cx, l, (*cx.blocks.add(b as usize)).s0)
                && (*cx.blocks.add((*cx.blocks.add(b as usize)).s0 as usize)).preds.count == 1 {
                b = (*cx.blocks.add(b as usize)).s0;
            } else if (*cx.blocks.add(b as usize)).term == Term::Branch {
                let s0 = (*cx.blocks.add(b as usize)).s0;
                let s1 = (*cx.blocks.add(b as usize)).s1;
                let mut next: i64 = 0;
                if loop_contains(cx, l, s0) && is_unreachable_exit(cx, l, s1) {
                    next = s0;
                } else if loop_contains(cx, l, s1) && is_unreachable_exit(cx, l, s0) {
                    next = s1;
                }
                if next == 0 || (*cx.blocks.add(next as usize)).preds.count != 1
                    || !record_check(cx, l, b, next) && !record_ovf(cx, l, b, next) {
                    return why(cx,
                        c"a branch in its body that is no bounds check (an if, a break)");
                }
                b = next;
            } else {
                return why(cx, c"a branch in its body that is no bounds check (an if, a break)");
            }
            count += 1;
            if count > 32 {
                return why(cx, c"more than 32 blocks in its body");
            }
        }
        if cx.v_chain.count != loop_size(cx, l) {
            return why(cx, c"a branch in its body that is no bounds check (an if, a break)");
        }
        // The exit at the latch.
        let s0 = (*cx.blocks.add(latch as usize)).s0;
        let s1 = (*cx.blocks.add(latch as usize)).s1;
        let e = if s0 == h { s1 } else { s0 };
        if loop_contains(cx, l, e) || (*cx.blocks.add(e as usize)).preds.count != 1 {
            return why(cx, c"its exit is reached from elsewhere too");
        }
        *exit = e;
        let latch_cond = ir_val(cx, (*cx.blocks.add(latch as usize)).cond);
        // The header's phis: the induction variable and reductions.
        let mut phi = (*cx.blocks.add(h as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Phi {
            if phi != iv {
                let pred_index_v = pred_index(cx, h, latch);
                let ir_arg_v = ir_arg(cx, phi, pred_index_v);
                let next = ir_val(cx, ir_arg_v);
                if !is_integer((*cx.insts.add(phi as usize)).ty) {
                    return why_at(cx,
                        c"a float carried from one iteration to the next (a float sum: lanes would add in another order)",
                        phi);
                }
                if class_of(cx, next) != 0
                    || (*cx.insts.add(next as usize)).block == 0
                    || !loop_contains(cx, l, (*cx.insts.add(next as usize)).block) {
                    return why_at(cx,
                        c"a value carried from one iteration to the next that is no integer reduction",
                        phi);
                }
                let op = (*cx.insts.add(next as usize)).op;
                // (0.15) A minimum or maximum: k ? z : r (or k ? r : z), k an
                // ordered comparison of r and z, signed (vector comparisons
                // are).
                if op == Op::Sel {
                    if !is_minmax(cx, phi, next)
                        || !use_elem(cx, (*cx.insts.add(phi as usize)).ty) {
                        return why_at(cx,
                            c"a value carried from one iteration to the next that is no minimum or maximum it can vectorize",
                            next);
                    }
                    set_class(cx, phi, VC_VECTOR);
                    cx.v_reds.push(phi);
                    cx.v_reds.push(next);
                    cx.v_reds.push(op as i64);
                    phi = (*cx.insts.add(phi as usize)).next;
                    continue;
                }
                if op != Add && op != Sub && op != Mul && op != And && op != Or && op != Xor {
                    return why_at(cx,
                        c"a value carried from one iteration to the next that is no sum, product, and, or, xor, minimum or maximum",
                        next);
                }
                let a = ir_val(cx, (*cx.insts.add(next as usize)).a);
                let bb = ir_val(cx, (*cx.insts.add(next as usize)).b);
                if !(a == phi || (bb == phi && op != Sub)) || a == bb
                    || (*cx.insts.add(next as usize)).ty != (*cx.insts.add(phi as usize)).ty {
                    return why_at(cx,
                        c"a value carried from one iteration to the next that is no sum, product, and, or, xor, minimum or maximum",
                        next);
                }
                if !use_elem(cx, (*cx.insts.add(phi as usize)).ty) {
                    return why_at(cx,
                        c"a reduction of a type of another width than the loop's elements", phi);
                }
                set_class(cx, phi, VC_VECTOR);
                cx.v_reds.push(phi);
                cx.v_reds.push(next);
                cx.v_reds.push(op as i64);
            } else {
                set_class(cx, phi, VC_UNIFORM);
            }
            phi = (*cx.insts.add(phi as usize)).next;
        }
        // Every instruction, in order.
        let mut total: i64 = 0;
        for k in 0..cx.v_chain.count {
            let mut v = (*cx.blocks.add((*cx.v_chain.data.add(k as usize)) as usize)).first;
            while v != 0 {
                total += 1;
                if total > VEC_MAX_INSTS {
                    return why(cx, c"too big: more than 160 instructions");
                }
                if !classify(cx, l, v, latch_cond, pcx) {
                    if cx.v_why == 0 as *mut u8 {
                        why_at(cx, c"an operation it has no vector form for", v);
                    }
                    return false;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        cx.v_size = total;
        if cx.v_elem == 0 {
            return why(cx, c"no load or store of consecutive elements");
        }
        cx.v_vf = 16 / type_size(cx.v_elem, pcx);
        cx.v_vt = vector_type(lane_type(cx.v_elem), cx.v_vf, pcx);
        if cx.v_vt == 0 {
            return why(cx, c"no vector type for its elements");
        }
        // The reductions' phis are used by their next values alone, and the
        // loop's values used after it are reductions' (LCSSA: the exit's
        // phis).
        for r in 0..cx.v_reds.count / 3 {
            let p = (*cx.v_reds.data.add((3 * r) as usize));
            let next = (*cx.v_reds.data.add((3 * r + 1) as usize));
            // (a minimum's phi is compared too)
            let also = if (*cx.insts.add(next as usize)).op
                == Op::Sel { ir_val(cx, (*cx.insts.add(next as usize)).a) }
                else { reduction_ovf(cx, r, next) };
            if !uses_only(cx, l, p, next, also) {
                return why_at(cx, c"a reduction's running value used inside the loop", p);
            }
        }
        let mut x = (*cx.blocks.add(e as usize)).first;
        while x != 0 && (*cx.insts.add(x as usize)).op == Phi {
            let ir_arg_v1 = ir_arg(cx, x, 0);
            let w = ir_val(cx, ir_arg_v1);
            // (A uniform value: its value at the last iteration, computed
            // after the vector loop.)
            if !invariant_in(cx, l, w) && reduction_of_next(cx, w) < 0
                && (class_of(cx, w) != VC_UNIFORM || coef(cx, l, w) == NONAFFINE
                    || loads_in(cx, l, w)) {
                return why_at(cx,
                    c"a value used after the loop that is no reduction and no step of the counter",
                    w);
            }
            x = (*cx.insts.add(x as usize)).next;
        }
        // Checks: on an index with coefficient 1. What is computed before the
        // loop (indices and addresses at its first and last iterations)
        // loads nothing.
        for k in 0..cx.v_checks.count / 3 {
            if coef(cx, l, (*cx.v_checks.data.add((3 * k + 1) as usize))) != 1
                || loads_in(cx, l, (*cx.v_checks.data.add((3 * k + 1) as usize))) {
                return why(cx,
                    c"a bounds check on an index that is not the counter plus a constant, or depends on a load in the loop");
            }
        }
        for k in 0..cx.v_access.count / 3 {
            if loads_in(cx, l, (*cx.v_access.data.add((3 * k + 1) as usize))) {
                return why_at(cx, c"an access address that depends on a load in the loop",
                    (*cx.v_access.data.add((3 * k) as usize)));
            }
        }
        if cx.v_has_store && (has_ovf_kind(cx, OVK_LANE) || has_ovf_kind(cx, OVK_RED)) {
            return why(cx,
                c"an overflow check on lanes in a loop that stores (the scalar loop that redoes it would see its stores)");
        }
        if overlap_pairs(cx, pcx) > VEC_MAX_OVERLAPS {
            return why(cx, c"too many pairs of accesses to test for overlap (more than 16)");
        }
        true
    }
}

// Whether uniform value v depends on a load in loop l.
pub fn loads_in(cx: &mut FnCtx, l: i64, v: i64) -> bool {
    unsafe {
        let x = ir_val(cx, v);
        if x == 0 || x == cx.v_iv || invariant_in(cx, l, x) {
            return false;
        }
        if (*cx.insts.add(x as usize)).op == Load {
            return true;
        }
        loads_in(cx, l, (*cx.insts.add(x as usize)).a)
            || loads_in(cx, l, (*cx.insts.add(x as usize)).b)
    }
}

// The reduction (index) whose next value is w, or -1.
pub fn reduction_of_next(cx: &mut FnCtx, w: i64) -> i64 {
    unsafe {
        for r in 0..cx.v_reds.count / 3 {
            if (*cx.v_reds.data.add((3 * r + 1) as usize)) == w {
                return r;
            }
        }
        -1
    }
}

fn is_check(cx: &mut FnCtx, c: i64) -> bool {
    unsafe {
        let mut k: i64 = 0;
        while k < cx.v_checks.count {
            if (*cx.v_checks.data.add(k as usize)) == c {
                return true;
            }
            k += 3;
        }
        false
    }
}

// (0.15) Whether next, the next value of header phi r, is k ? z : r or
// k ? r : z with k a signed ordered comparison of r and z (either way):
// a maximum or a minimum.
pub fn is_minmax(cx: &mut FnCtx, r: i64, next: i64) -> bool {
    unsafe {
        if (*cx.insts.add(next as usize)).op != Op::Sel {
            return false;
        }
        let k = ir_val(cx, (*cx.insts.add(next as usize)).a);
        if (*cx.insts.add(k as usize)).op != Op::Cmp || (*cx.insts.add(k as usize)).cond == Cond::Eq
            || (*cx.insts.add(k as usize)).cond == Cond::Ne
            || !is_integer((*cx.insts.add(k as usize)).imm2)
            || !is_signed((*cx.insts.add(k as usize)).imm2)
            || (*cx.insts.add(k as usize)).imm2 != (*cx.insts.add(r as usize)).ty {
            return false;
        }
        let x = ir_val(cx, (*cx.insts.add(k as usize)).a);
        let y = ir_val(cx, (*cx.insts.add(k as usize)).b);
        if (x == r) == (y == r) {
            return false;
        }
        let z = if x == r { y } else { x };
        let p = ir_val(cx, (*cx.insts.add(next as usize)).b);
        let q = ir_val(cx, (*cx.insts.add(next as usize)).c);
        (p == r && q == z) || (p == z && q == r)
    }
}

// (0.15) Whether every use of v inside loop l is instruction u or w (no
// terminator's).
fn uses_only(cx: &mut FnCtx, l: i64, v: i64, u: i64, w: i64) -> bool {
    unsafe {
        for k in 0..cx.v_chain.count {
            let b = (*cx.v_chain.data.add(k as usize));
            let mut x = (*cx.blocks.add(b as usize)).first;
            while x != 0 {
                if x != u && x != w {
                    for i in 0..ir_operand_count(cx, x) {
                        let o = ir_operand(cx, x, i);
                        if o != 0 && ir_val(cx, o) == v {
                            return false;
                        }
                    }
                }
                x = (*cx.insts.add(x as usize)).next;
            }
            if (*cx.blocks.add(b as usize)).cond != 0
                && ir_val(cx, (*cx.blocks.add(b as usize)).cond) == v {
                return false;
            }
        }
        true
    }
}

// (0.15) Whether comparison v is used inside loop l only as the condition
// of selects (a mask).
fn only_select_conditions(cx: &mut FnCtx, l: i64, v: i64) -> bool {
    unsafe {
        for k in 0..cx.v_chain.count {
            let b = (*cx.v_chain.data.add(k as usize));
            let mut x = (*cx.blocks.add(b as usize)).first;
            while x != 0 {
                for i in 0..ir_operand_count(cx, x) {
                    let o = ir_operand(cx, x, i);
                    if o != 0 && ir_val(cx, o) == v
                        && ((*cx.insts.add(x as usize)).op != Op::Sel || i != 0) {
                        return false;
                    }
                }
                x = (*cx.insts.add(x as usize)).next;
            }
            if (*cx.blocks.add(b as usize)).cond != 0
                && ir_val(cx, (*cx.blocks.add(b as usize)).cond) == v {
                return false;
            }
        }
        true
    }
}

fn classify(cx: &mut FnCtx, l: i64, v: i64, latch_cond: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op == Phi {
            return class_of(cx, v) != 0;
        }
        if v == latch_cond || is_check(cx, v) {
            set_class(cx, v, VC_SKIP);
            return true;
        }
        if op == Op::Ovf {
            return classify_ovf(cx, l, v);
        }
        if op == Load {
            let ty = (*cx.insts.add(v as usize)).ty;
            let addr = ir_val(cx, (*cx.insts.add(v as usize)).a);
            let c = coef(cx, l, addr);
            // (0.16) Two u32 a lane of u64 each: VC_WIDE (AArch64)
            if ty == TY_U32 && c == 4 && !get_x86() && only_widened(cx, l, v) {
                cx.v_access.push(v);
                cx.v_access.push(addr);
                cx.v_access.push(4);
                set_class(cx, v, VC_WIDE);
                return true;
            }
            if c == 0 && (class_of(cx, addr) == VC_UNIFORM || invariant_in(cx, l, addr)) {
                // An invariant address: the same value in every iteration (a
                // store reaching it is ruled out by the overlap test).
                cx.v_has_uload = true;
                cx.v_access.push(v);
                cx.v_access.push(addr);
                cx.v_access.push(type_size(ty, pcx));
                set_class(cx, v, VC_UNIFORM);
                return true;
            }
            if c != type_size(ty, pcx) {
                return why_at(cx,
                    c"a load whose address does not step by its size each iteration (a stride, or an index loaded or computed)",
                    v);
            }
            if !use_elem(cx, ty) {
                return why_at(cx, c"elements of two widths (one vector type per loop)", v);
            }
            cx.v_access.push(v);
            cx.v_access.push(addr);
            cx.v_access.push(type_size(ty, pcx));
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        if op == Store {
            let ty = (*cx.insts.add(v as usize)).imm2;
            let addr = ir_val(cx, (*cx.insts.add(v as usize)).a);
            if coef(cx, l, addr) != type_size(ty, pcx) {
                return why_at(cx,
                    c"a store whose address does not step by its size each iteration (a stride, or an index loaded or computed)",
                    v);
            }
            if !use_elem(cx, ty) {
                return why_at(cx, c"elements of two widths (one vector type per loop)", v);
            }
            if !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).b) {
                return why_at(cx, c"a stored value it cannot compute in vector lanes", v);
            }
            cx.v_has_store = true;
            cx.v_access.push(v);
            cx.v_access.push(addr);
            cx.v_access.push(type_size(ty, pcx));
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        let a: i64 = if (*cx.insts.add(v as usize)).a
            != 0 {
            let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).a); class_of(cx, ir_val_v)
        } else { 0 };
        let b: i64 = if (*cx.insts.add(v as usize)).b
            != 0 {
            let ir_val_v1 = ir_val(cx, (*cx.insts.add(v as usize)).b); class_of(cx, ir_val_v1)
        }
            else { 0 };
        if a == VC_WIDE || b == VC_WIDE || a == VC_WMUL || b == VC_WMUL {
            return classify_wide(cx, l, v, a, b);
        }
        // (0.15) A comparison of vectors used only by selects: a mask
        // (signed when ordered: the vector comparisons are).
        if op == Op::Cmp && (a == VC_VECTOR || b == VC_VECTOR) {
            let t = (*cx.insts.add(v as usize)).imm2;
            let cond = (*cx.insts.add(v as usize)).cond;
            if !is_integer(t) || (cond != Cond::Eq && cond != Cond::Ne && !is_signed(t))
                || !use_elem(cx, t) || !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).a)
                || !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).b)
                || !only_select_conditions(cx, l, v) {
                return false;
            }
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        // (0.15) A select on a mask.
        if op == Op::Sel {
            let k = ir_val(cx, (*cx.insts.add(v as usize)).a);
            if a != VC_VECTOR || (*cx.insts.add(k as usize)).op != Op::Cmp
                || !use_elem(cx, (*cx.insts.add(v as usize)).ty)
                || !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).b)
                || !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).c) {
                return false;
            }
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        if a == VC_VECTOR || b == VC_VECTOR {
            let ty = (*cx.insts.add(v as usize)).ty;
            let ok_op = op == Add || op == Sub || op == Mul || op == And || op == Or || op == Xor
                || op == Neg || (op == Div && is_float(ty));
            if op == Op::Shl {
                // (an index scaled to an address: a[idx[i]])
                return why_at(cx,
                    c"an address computed from a value loaded in the loop (a gather, a[idx[i]])",
                    v);
            }
            if !ok_op || (is_float(ty) && (op == And || op == Or || op == Xor))
                || !use_elem(cx, ty) {
                return false;
            }
            if !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).a)
                || ((*cx.insts.add(v as usize)).b != 0
                    && !vector_operand_ok(cx, l, (*cx.insts.add(v as usize)).b)) {
                return false;
            }
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        if a == VC_SKIP || b == VC_SKIP {
            return false;
        }
        if op.is_pure() || op == Const {
            if op == Op::Cmp || (*cx.insts.add(v as usize)).ty == TY_BOOL {
                // (A comparison that is no check: control flow, or a value.)
                return why_at(cx, c"a comparison that is no bounds check and selects nothing", v);
            }
            set_class(cx, v, VC_UNIFORM);
            return true;
        }
        // (0.25.5: a call, an atomic, a division of integers...)
        why_at(cx, c"an operation it has no vector form for", v)
    }
}

// (0.26.2, a prototype) Classifies overflow check v (VC_SKIP: its branch
// goes) and gives it its kind in V_OVFS; false when it is no recorded
// check (a value) or the vector loop cannot keep it: a product's on lanes,
// or one on a reduction's running value that is not its step.
fn classify_ovf(cx: &mut FnCtx, l: i64, v: i64) -> bool {
    // UNSAFE: the function's IR is FnCtx's raw arrays, as in classify.
    // SAFETY: v and its operands are instructions of the loop's function;
    // k indexes V_OVFS' triples, r V_REDS'.
    unsafe {
        let k = ovf_index(cx, v);
        if k < 0 {
            return why_at(cx, c"an overflow check used as a value", v);
        }
        let imm = (*cx.insts.add(v as usize)).imm;
        let op = (imm & 255) as Op;
        let ty = imm >> 8;
        let a = ir_val(cx, (*cx.insts.add(v as usize)).a);
        let b: i64 = if (*cx.insts.add(v as usize)).b
            != 0 { ir_val(cx, (*cx.insts.add(v as usize)).b) } else { 0 };
        let lanes = class_of(cx, a) == VC_VECTOR || b != 0 && class_of(cx, b) == VC_VECTOR;
        set_class(cx, v, VC_SKIP);
        if !lanes {
            if !ovf_uniform(cx, l, v) {
                return why_at(cx,
                    c"an overflow check of values not exactly affine in the counter", v);
            }
            (*cx.v_ovfs.data.add((3 * k + 1) as usize)) = OVK_UNIFORM;
            return true;
        }
        if !use_elem(cx, ty) {
            return why_at(cx, c"elements of two widths (one vector type per loop)", v);
        }
        for r in 0..cx.v_reds.count / 3 {
            let phi = (*cx.v_reds.data.add((3 * r) as usize));
            if a != phi && b != phi {
                continue;
            }
            let next = (*cx.v_reds.data.add((3 * r + 1) as usize));
            let na = ir_val(cx, (*cx.insts.add(next as usize)).a);
            let nb = ir_val(cx, (*cx.insts.add(next as usize)).b);
            if (op == Add || op == Sub) && (*cx.insts.add(next as usize)).op == op
                && (*cx.insts.add(next as usize)).ty == ty
                && (a == na && b == nb || op == Add && a == nb && b == na) {
                (*cx.v_ovfs.data.add((3 * k + 1) as usize)) = OVK_RED;
                (*cx.v_ovfs.data.add((3 * k + 2) as usize)) = r;
                return true;
            }
            return why_at(cx,
                c"an overflow check on a reduction's running value that is not its step", v);
        }
        if op == Mul {
            return why_at(cx, c"an overflow check of a product in vector lanes", v);
        }
        (*cx.v_ovfs.data.add((3 * k + 1) as usize)) = OVK_LANE;
        true
    }
}

// (0.26.2) The overflow check of reduction r's step (OVK_RED), or
// `otherwise`.
fn reduction_ovf(cx: &mut FnCtx, r: i64, otherwise: i64) -> i64 {
    // UNSAFE: V_OVFS is one of FnCtx's raw arrays.
    // SAFETY: k stays below its count.
    unsafe {
        for k in 0..cx.v_ovfs.count / 3 {
            if (*cx.v_ovfs.data.add((3 * k + 1) as usize)) == OVK_RED
                && (*cx.v_ovfs.data.add((3 * k + 2) as usize)) == r {
                return (*cx.v_ovfs.data.add((3 * k) as usize));
            }
        }
        otherwise
    }
}

// (0.16) Classifies v, an instruction of loop l with a VC_WIDE or VC_WMUL
// operand (a and b: its operands' classes): the widening of a u32 load,
// the product of one with an invariant below 2^32, or an add of such a
// product to a vector (a VMACW). Anything else of theirs: false.
fn classify_wide(cx: &mut FnCtx, l: i64, v: i64, a: i64, b: i64) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        let ty = (*cx.insts.add(v as usize)).ty;
        if ty != TY_U64 && ty != TY_I64 {
            return false;
        }
        if op == Conv && a == VC_WIDE && (*cx.insts.add(v as usize)).imm2 == TY_U32 {
            set_class(cx, v, VC_WIDE);
            return true;
        }
        if op == Mul && (a == VC_WIDE) != (b == VC_WIDE) {
            let k = ir_val(cx,
                if a == VC_WIDE { (*cx.insts.add(v as usize)).b }
                else { (*cx.insts.add(v as usize)).a });
            let w = ir_val(cx,
                if a == VC_WIDE { (*cx.insts.add(v as usize)).a }
                else { (*cx.insts.add(v as usize)).b });
            if class_of(cx, k) == VC_VECTOR || !vector_operand_ok(cx, l, k)
                || !below_2_32(cx, k) || !use_elem(cx, ty) {
                return false;
            }
            set_class(cx, v, VC_WMUL);
            return true;
        }
        if op == Add && (a == VC_WMUL) != (b == VC_WMUL) {
            let other = if a == VC_WMUL { (*cx.insts.add(v as usize)).b }
                else { (*cx.insts.add(v as usize)).a };
            if !vector_operand_ok(cx, l, other) || !use_elem(cx, ty) {
                return false;
            }
            set_class(cx, v, VC_VECTOR);
            return true;
        }
        false
    }
}

// Whether value k is below 2^32: a value of an unsigned type of at most
// 32 bits (canonical: its u64 is the same; a load, a parameter, what
// widening left), or such a constant.
fn below_2_32(cx: &mut FnCtx, k: i64) -> bool {
    unsafe {
        if is_const(cx, k) {
            return (*cx.insts.add(k as usize)).imm >= 0
                && (*cx.insts.add(k as usize)).imm < 1 << 32;
        }
        let t = (*cx.insts.add(k as usize)).ty;
        if (*cx.insts.add(k as usize)).op == Conv {
            let from = (*cx.insts.add(k as usize)).imm2;
            return from == TY_U32 || from == TY_U16 || from == TY_U8;
        }
        t == TY_U32 || t == TY_U16 || t == TY_U8
    }
}

// Whether every use of u32 load v in loop l is its widening to 64 bits,
// or a 64-bit product (a canonical u32 is its u64 already).
fn only_widened(cx: &mut FnCtx, l: i64, v: i64) -> bool {
    unsafe {
        for k in 0..cx.v_chain.count {
            let b = (*cx.v_chain.data.add(k as usize));
            let mut x = (*cx.blocks.add(b as usize)).first;
            while x != 0 {
                for i in 0..ir_operand_count(cx, x) {
                    let o = ir_operand(cx, x, i);
                    if o != 0 && ir_val(cx, o) == v
                        && !(i == 0 && (*cx.insts.add(x as usize)).op == Conv
                            && (*cx.insts.add(x as usize)).imm2 == TY_U32
                            && ((*cx.insts.add(x as usize)).ty == TY_U64
                                || (*cx.insts.add(x as usize)).ty == TY_I64)
                            || i <= 1 && (*cx.insts.add(x as usize)).op == Mul
                            && ((*cx.insts.add(x as usize)).ty == TY_U64
                                || (*cx.insts.add(x as usize)).ty == TY_I64)) {
                        return false;
                    }
                }
                x = (*cx.insts.add(x as usize)).next;
            }
            if (*cx.blocks.add(b as usize)).cond != 0
                && ir_val(cx, (*cx.blocks.add(b as usize)).cond) == v {
                return false;
            }
        }
        true
    }
}
