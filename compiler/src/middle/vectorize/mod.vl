// Whether function f (a FNS index) is FN: its whole name (`Vec::push`), a
// prefix of it before `<` or `$` (an instance), or its last part (`push`).
pub fn vec_stats_wanted(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: VEC_STATS_FN is a C string (from the command line), read by
    // its bytes; FNS and SYMS are the compiler's raw tables.
    // SAFETY: want is NUL-terminated and only its strlen bytes are read; f
    // is a FNS index and its display a SYMS index, both checked.
    unsafe {
        let want = pcx.vec_stats_fn;
        if want == 0 as *mut u8 {
            return false;
        }
        let name = sym_text(pcx.fns[f as usize].display, pcx);
        let n = strlen(want) as i64;
        let mut start: i64 = 0;
        for i in 0..name.len() as i64 {
            if i + 1 < name.len() as i64 && name[i as usize] == b':'
                && name[(i + 1) as usize] == b':' {
                start = i + 2;
            }
            if name[i as usize] == b'<' || name[i as usize] == b'$' {
                break;
            }
        }
        for s in [0i64, start] {
            if s + n <= name.len() as i64
                && (0i64..n).all(|i| name[(s + i) as usize] == (*want.add(i as usize)))
                && (s + n == name.len() as i64 || name[(s + n) as usize] == b'<'
                    || name[(s + n) as usize] == b'$') {
                return true;
            }
        }
        false
    }
}

// The source line of loop l (its first instruction with a position), or
// 0.
fn loop_line(cx: &mut FnCtx, l: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: cx is the pass's raw *FnCtx.
    // SAFETY: cx points at the function's live context for the whole pass;
    // the blocks and instructions read are its own (checked indexes), and
    // inst_loc is read below its count.
    unsafe {
        for i in 0..loop_size(cx, l) {
            let mut v = { let at_ix = loop_block(cx, l, i) as usize; (*cx.blocks.add(at_ix)) }.first;
            while v != 0 {
                if v < cx.inst_loc.count && (*cx.inst_loc.data.add(v as usize)) > 0 {
                    return file_and_line((*cx.inst_loc.data.add(v as usize)) - 1, pcx) & 0xffffffff;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        0
    }
}

// One line of --vec-stats=FN on stderr: loop l of function fi, vectorized
// (reason 0: VF lanes, the body `unroll` times) or not and why.
fn vec_report(cx: &mut FnCtx, fi: i64, l: i64, reason: *mut u8, inst: i64, pcx: &Ctx<Comp>) {
    let loop_line_v = loop_line(cx, l, pcx);
    let loop_header_v = loop_header(cx, l);
    vec_report_at(cx, fi, loop_line_v, loop_header_v, reason, inst, pcx);
}

// The same, for the loop at line `line` (0: unknown) whose header is block
// `header`.
fn vec_report_at(cx: &mut FnCtx, fi: i64, line: i64, header: i64, reason: *mut u8, inst: i64,
    pcx: &Ctx<Comp>) {
    // UNSAFE: the compiler's raw tables (SYMS, FNS, IRFUNCS) and the
    // reason, a C string.
    // SAFETY: fi is an IRFUNCS index and the others follow from it (checked
    // indexes); reason is a constant NUL-terminated string.
    unsafe {
        let out = buf_new();
        buf_fmt(out,
            format_args("vec-stats: {}",
                str::from_utf8(
                    sym_text(pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].display, pcx)).unwrap()));
        if line > 0 {
            buf_fmt(out, format_args(", loop at line {line}"));
        } else {
            buf_fmt(out, format_args(", loop at block {header}"));
        }
        if reason == 0 as *mut u8 {
            buf_fmt(out,
                format_args(": vectorized, {} lanes, the body {} times an iteration\n", cx.v_vf,
                    cx.v_unroll));
        } else {
            buf_fmt(out,
                format_args(": not vectorized: {}", str::from_utf8(cstr(reason)).unwrap()));
            if inst > 0 {
                buf_fmt(out,
                    format_args(" ({})",
                        str::from_utf8(cstr((*cx.insts.add(inst as usize)).op.name())).unwrap()));
            }
            buf_byte(out, b'\n');
        }
        buf_write_fd(out, STDERR);
    }
}

const VEC_MAX_INSTS: i64 = 160;
const VEC_MAX_CHECKS: i64 = 8;
const VEC_MAX_OVERLAPS: i64 = 16;
const VEC_UNROLL_SIZE: i64 = 40;

// (0.15) Bodies of up to this many instructions: 4 copies.
const VEC_UNROLL4_SIZE: i64 = 16;

// The classes of the loop's instructions (INSTS[v].aux, while INSTS[v].mark
// is the analysis' stamp).
const VC_UNIFORM: i64 = 1;
const VC_VECTOR: i64 = 2;
const VC_SKIP: i64 = 3;

// (0.16) A u32 load only widened to u64, its widening (VC_WIDE), and their
// product with an invariant below 2^32 (VC_WMUL): what an add of a vector
// and the product makes one VMACW of (AArch64's umlal).
const VC_WIDE: i64 = 4;
const VC_WMUL: i64 = 5;

// ---- The cost model (0.11) ----
//
// After the analysis, whether the vector loop pays, and how many copies of
// the body it runs (U): costs are rough cycles of throughput. A scalar
// iteration costs S (its instructions, a check two, a float division
// four); a vector iteration, U * VF scalar ones, costs U * B + 3 (the
// vector body: an instruction one, a lane-by-lane multiplication
// 3 * VF; the induction variable, its test and branch); the decision
// before the loop, the reductions' setup and their combination after it
// cost G. With T iterations expected (exact for constant bounds, else
// the profile's average: the header's count over the entries'), the
// vector version costs G + (T / (U*VF)) * (U*B + 3) + (T % (U*VF)) * S
// against T * S; U = 2 is tried for small bodies, then U = 1. Without an
// expected T a vector iteration must only be cheaper than the scalar ones
// it replaces, and U is 2 for small bodies, as in 0.10.

// Whether integer multiplication of the loop's lanes is done lane by lane
// (SSE2 has 16-bit lanes only; NEON lacks 64-bit lanes).
fn lanewise_mul(cx: &mut FnCtx, pcx: &Ctx<Comp>) -> bool {
    let size = type_size(cx.v_elem, pcx);
    if is_float(cx.v_elem) {
        return false;
    }
    if get_x86() { size != 2 } else { size == 8 }
}

// v as x + c: returns x (0 for a constant) and adds c to *offset.
fn const_base(cx: &mut FnCtx, v: i64, offset: &mut i64) -> i64 {
    unsafe {
        let mut x = ir_val(cx, v);
        for _ in 0..8 {
            if is_const(cx, x) {
                *offset += (*cx.insts.add(x as usize)).imm;
                return 0;
            }
            if (*cx.insts.add(x as usize)).op != Add
                || ! {
                let at_arg1 = ir_val(cx, (*cx.insts.add(x as usize)).b); is_const(cx, at_arg1)
            } {
                return x;
            }
            *offset += (*cx.insts.add(ir_val(cx, (*cx.insts.add(x as usize)).b) as usize)).imm;
            x = ir_val(cx, (*cx.insts.add(x as usize)).a);
        }
        x
    }
}

// The expected number of iterations of loop l (analyzed) per entry, or -1.
fn expected_trips(cx: &mut FnCtx, l: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let h = loop_header(cx, l);
        let p = loop_preheader(cx, l);
        let arg_v = cx.v_iv;
        let pred_index_v = pred_index(cx, h, p);
        let ir_arg_v = ir_arg(cx, arg_v, pred_index_v);
        let start = ir_val(cx, ir_arg_v);
        // (Constants, or one value plus two constants: an array's end.)
        let mut off_n: i64 = 0;
        let mut off_s: i64 = 0;
        let n = const_base(cx, cx.v_n, &mut off_n);
        let s = const_base(cx, start, &mut off_s);
        if n == s {
            let t = off_n - off_s;
            return if t > 0 { t } else { -1 };
        }
        let hc = (*cx.blocks.add(h as usize)).count;
        if pcx.profile_max <= 0 || hc < 0 {
            return -1;
        }
        // The entries: the preheader's count, or the nearest one above it
        // through single predecessors (blocks made after the profile was
        // read have none).
        let mut b = p;
        for _ in 0..8 {
            if (*cx.blocks.add(b as usize)).count > 0 {
                return hc / (*cx.blocks.add(b as usize)).count;
            }
            if (*cx.blocks.add(b as usize)).count == 0
                || (*cx.blocks.add(b as usize)).preds.count != 1 {
                return -1;
            }
            b = (*(*cx.blocks.add(b as usize)).preds.data.add(0));
        }
        -1
    }
}

// Whether v is computed from the induction variable and constants alone
// (a constant in each copy of the loop fully unrolled from a constant
// start), looking depth operations deep.
fn constant_affine(cx: &mut FnCtx, v: i64, depth: i64) -> bool {
    unsafe {
        let x = ir_val(cx, v);
        if x == cx.v_iv || is_const(cx, x) {
            return true;
        }
        let op = (*cx.insts.add(x as usize)).op;
        if depth == 0 || !(op == Add || op == Sub || op == Mul || op == Shl || op == Conv) {
            return false;
        }
        constant_affine(cx, (*cx.insts.add(x as usize)).a, depth - 1)
            && ((*cx.insts.add(x as usize)).b == 0
                || constant_affine(cx, (*cx.insts.add(x as usize)).b, depth - 1))
    }
}

// How many vector bodies an iteration of the vector loop of l (analyzed)
// runs, 1, 2 or 4 (a power of two); 0 when vectorizing does not pay. unrolled > 0: the scalar
// alternative is the loop fully unrolled, that many times (the unroller
// asks), whose copies keep only the work on each element: the induction
// variable, the latch's test and the addresses affine in it become
// constants and offsets, what is invariant leaves the loop, and a check
// of a constant length on an index made of the induction variable and
// constants (from a constant start) is decided.
fn vector_unroll(cx: &mut FnCtx, l: i64, unrolled: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let vf = cx.v_vf;
        let mut s: i64 = 2;
        let mut su: i64 = 0;
        let mut body: i64 = 0;
        // (0.15) A multiplication done lane by lane: the scalar loop the
        // run-time unroller would make instead, without its checks and its
        // own instructions (as su), is what the vector loop must beat.
        let mut lanewise = false;
        let mut srt: i64 = 1;
        for k in 0..cx.v_chain.count {
            let mut v = (*cx.blocks.add((*cx.v_chain.data.add(k as usize)) as usize)).first;
            while v != 0 {
                let op = (*cx.insts.add(v as usize)).op;
                let cls = class_of(cx, v);
                let div = op == Div;
                if op != Phi {
                    let cost: i64 = if cls == VC_SKIP { 2 } else if div { 4 } else { 1 };
                    s += cost;
                    if cls != VC_SKIP
                        && (cls != VC_UNIFORM
                            || (!invariant_in(cx, l, v) && coef(cx, l, v) == NONAFFINE)) {
                        if unrolled > 0 {
                            su += cost;
                        }
                        srt += cost;
                    }
                }
                if cls == VC_UNIFORM {
                    body += 1;
                } else if cls == VC_VECTOR && op != Phi {
                    // (two lanes out, the product, one lane in, per lane)
                    if op == Mul && lanewise_mul(cx, pcx) {
                        lanewise = true;
                        body += 4 * vf + 1;
                    } else if op == Op::Cmp && get_x86() && type_size(cx.v_elem, pcx) == 8 {
                        // (SSE2 compares 64-bit lanes one by one)
                        body += 4 * vf + 1;
                    } else {
                        body += if div { 4 } else { 1 };
                    }
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        if unrolled > 0 {
            let h = loop_header(cx, l);
            let arg_v1 = cx.v_iv;
            let loop_preheader_v = loop_preheader(cx, l);
            let pred_index_v = pred_index(cx, h, loop_preheader_v);
            let ir_arg_v = ir_arg(cx, arg_v1, pred_index_v);
            let start = ir_val(cx,
                ir_arg_v);
            for k in 0..cx.v_checks.count / 3 {
                let is_const_v = is_const(cx, start);
                let arg_v = !is_const_v
                    || ! {
                    let at_arg1 = ir_val(cx, (*cx.v_checks.data.add((3 * k + 2) as usize)));
                    is_const(cx, at_arg1)
                };
                if arg_v
                    || !constant_affine(cx, (*cx.v_checks.data.add((3 * k + 1) as usize)), 8) {
                    su += 2;
                }
            }
        }
        let nreds = cx.v_reds.count / 3;
        let mut setup = 6 + 8 * (cx.v_checks.count / 3) + 10 * overlap_pairs(cx, pcx);
        for r in 0..nreds {
            let raw = (*cx.v_reds.data.add((3 * r + 2) as usize));
            let op = raw as Op;
            setup += if op == Add || op == Sub { 4 } else { 2 + 2 * vf };
        }
        if lanewise && unrolled == 0 && srt < s {
            s = srt;
        }
        // (0.15: 4 copies of a tiny body of wide lanes, whose loads and
        // accumulators then fill the machine as cc's do)
        let most: i64 = if cx.v_size <= VEC_UNROLL4_SIZE && vf <= 4 { 4 }
            else if cx.v_size <= VEC_UNROLL_SIZE { 2 } else { 1 };
        let t = if unrolled > 0 { unrolled } else { expected_trips(cx, l, pcx) };
        if t < 0 {
            let u = most;
            return if u * body + 3 < u * vf * s { u } else { 0 };
        }
        let scalar = if unrolled > 0 { t * su } else { t * s };
        let mut best: i64 = 0;
        let mut best_cost = scalar;
        let mut u = most;
        while u >= 1 {
            let w = u * vf;
            if t >= w {
                let cost = setup + nreds * (u - 1) + (t / w) * (u * body + 3) + (t % w) * s;
                if cost < best_cost {
                    best = u;
                    best_cost = cost;
                }
            }
            // (powers of two only: the vector loop's trip count is rounded
            // down to u * vf with a mask, `trips & -(u * vf)`, see
            // vectorize_loop; 3 copies of 4 lanes rounded 510 to 500, not 504)
            u = u / 2;
        }
        best
    }
}

fn vectorize_loop(cx: &mut FnCtx, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // (before the analysis, whose marks the trip count's evaluation
        // would overwrite)
        let whole = full_unroll_trips(cx, l, pcx);
        let mut e: i64 = 0;
        if !analyze(cx, l, &mut e, pcx) {
            return false;
        }
        let unroll = vector_unroll(cx, l, 0, pcx);
        if unroll == 0 {
            return why(cx, c"the cost model: the vector loop would not be cheaper");
        }
        cx.v_unroll = unroll;
        // (0.11: a loop of a few constant trips whose checks kept
        // transform_loops from unrolling it whole, until the ranges removed
        // them, is better unrolled whole when that is cheaper: then each
        // copy keeps only its loads, stores and operations, which SLP may
        // pack, and no test of the trip count or overlap is made)
        if whole > 0 && vector_unroll(cx, l, whole, pcx) == 0 {
            cx.unroll_whole = true;
            return why(cx, c"unrolled whole instead: a few constant trips, cheaper so");
        }
        ir_enter(cx, fi, pcx);
        let h = loop_header(cx, l);
        let p = loop_preheader(cx, l);
        let arg_v2 = cx.v_iv;
        let pred_index_v = pred_index(cx, h, p);
        let ir_arg_v = ir_arg(cx, arg_v2, pred_index_v);
        let start = ir_val(cx, ir_arg_v);
        cx.v_start = start;
        let vf = cx.v_vf;
        let elem = cx.v_elem;
        let vt = cx.v_vt;
        let lt = lane_type(elem);
        cx.v_map.count = 0;
        cx.v_eval.count = 0;
        // C: the decision.
        let c = ir_new_block(cx);
        let vp = ir_new_block(cx);
        let vh = ir_new_block(cx);
        let vx = ir_new_block(cx);
        let sp = ir_new_block(cx);
        (*cx.blocks.add(c as usize)).sealed = 1;
        (*cx.blocks.add(vp as usize)).sealed = 1;
        (*cx.blocks.add(vh as usize)).sealed = 1;
        (*cx.blocks.add(vx as usize)).sealed = 1;
        (*cx.blocks.add(sp as usize)).sealed = 1;
        (*cx.blocks.add(p as usize)).s0 = c;
        (*cx.blocks.add(c as usize)).preds.push(p);
        let n = cx.v_n;
        let trips = append(cx, c, Sub, TY_I64, n, start, 0, pcx);
        let konst_v = konst(cx, c, unroll * vf, TY_I64, pcx);
        let mut ok = cmp(cx, c, Cond::Ge, TY_U64, trips, konst_v, pcx);
        let konst_v1 = konst(cx, c, 1, TY_I64, pcx);
        let last = append(cx, c, Sub, TY_I64, n, konst_v1, 0, pcx);
        ok = check_tests(cx, l, c, ok, start, last, pcx);
        ok = ovf_tests(cx, l, c, ok, start, last, pcx);
        build_groups(cx);
        ok = overlap_tests(cx, l, c, ok, start, last, 0, 0, pcx);
        ir_terminate(cx, c, Term::Branch, ok, vp, sp);
        // VP: the vector preheader. (unroll * vf is a power of two, see
        // vector_unroll: the mask rounds the trip count down to a multiple.)
        let mask = konst(cx, vp, 0 - unroll * vf, TY_I64, pcx);
        let vtrips = append(cx, vp, And, TY_I64, trips, mask, 0, pcx);
        let vend = append(cx, vp, Add, TY_I64, start, vtrips, 0, pcx);
        let mut red_init = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut red_id = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut red_start = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for r in 0..cx.v_reds.count / 3 {
            let phi = (*cx.v_reds.data.add((3 * r) as usize));
            let raw = (*cx.v_reds.data.add((3 * r + 2) as usize));
            let op = raw as Op;
            let pred_index_v1 = pred_index(cx, h, p);
            let ir_arg_v1 = ir_arg(cx, phi, pred_index_v1);
            let init = ir_val(cx, ir_arg_v1);
            red_start.push(init);
            // (0.15: a minimum starts every lane at the start)
            let id = if op == Op::Sel { append(cx, vp, VSplat, vt, init, 0, 0, pcx) }
                else {
                    let konst_v2 = konst(cx, vp, identity(op), lt, pcx);
                    append(cx, vp, VSplat, vt, konst_v2, 0, 0, pcx)
                };
            let first = if op == Op::Sel { id }
                else { append(cx, vp, VIns, vt, id, init, 0, pcx) };
            red_init.push(first);
            red_id.push(id);
        }
        ir_terminate(cx, vp, Term::Jump, 0, vh, 0);
        // VH: the vector loop, `unroll` copies of the body (each with its
        // own accumulators, combined after the loop).
        let viv = ir_make(cx, Phi, (*cx.insts.add(cx.v_iv as usize)).ty, 0, 0, 0, pcx);
        (*cx.insts.add(viv as usize)).args = cx.args.count;
        (*cx.insts.add(viv as usize)).nargs = 2;
        cx.args.push(start);
        cx.argty.push(0);
        cx.args.push(0);
        cx.argty.push(0);
        ir_append(cx, vh, viv);
        let mut red_phis = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut red_nexts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for u in 0..unroll {
            for r in 0..cx.v_reds.count / 3 {
                let rp = ir_make(cx, Phi, vt, 0, 0, 0, pcx);
                (*cx.insts.add(rp as usize)).args = cx.args.count;
                (*cx.insts.add(rp as usize)).nargs = 2;
                cx.args.push(if u == 0 { (*red_init.data.add(r as usize)) }
                    else { (*red_id.data.add(r as usize)) });
                cx.argty.push(0);
                cx.args.push(0);
                cx.argty.push(0);
                ir_append(cx, vh, rp);
                red_phis.push(rp);
            }
        }
        // (0.26.2, a prototype) The overflow checks on lanes (OVK_LANE,
        // OVK_RED) are accumulated, one vector each a copy, from 0: the
        // lanes' overflow or'ed, or the addends' bounds; tested after the
        // vector loop, which the scalar loop redoes from the start when they
        // fail (it has no store).
        let spec = has_ovf_kind(cx, OVK_LANE) || has_ovf_kind(cx, OVK_RED);
        let mut nspec: i64 = 0;
        for k in 0..cx.v_ovfs.count / 3 {
            if (*cx.v_ovfs.data.add((3 * k + 1) as usize)) == OVK_LANE
                || (*cx.v_ovfs.data.add((3 * k + 1) as usize)) == OVK_RED {
                nspec += 1;
            }
        }
        let mut spec_phis = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut spec_nexts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        if spec {
            let konst_v3 = konst(cx, vp, 0, lt, pcx);
            let zero = append(cx, vp, VSplat, vt, konst_v3, 0, 0, pcx);
            for _ in 0..unroll * nspec {
                let sp_phi = ir_make(cx, Phi, vt, 0, 0, 0, pcx);
                (*cx.insts.add(sp_phi as usize)).args = cx.args.count;
                (*cx.insts.add(sp_phi as usize)).nargs = 2;
                cx.args.push(zero);
                cx.argty.push(0);
                cx.args.push(0);
                cx.argty.push(0);
                ir_append(cx, vh, sp_phi);
                spec_phis.push(sp_phi);
            }
        }
        for u in 0..unroll {
            // A fresh map per copy (the splats of invariants stay).
            let mut k: i64 = 0;
            let mut kept: i64 = 0;
            while k < cx.v_map.count {
                if (*cx.v_map.data.add(k as usize)) < 0 {
                    (*cx.v_map.data.add(kept as usize)) = (*cx.v_map.data.add(k as usize));
                    (*cx.v_map.data.add((kept + 1) as usize)) = (
                        *cx.v_map.data.add((k + 1) as usize));
                    kept += 2;
                }
                k += 2;
            }
            cx.v_map.count = kept;
            if u == 0 {
                map_put(cx, cx.v_iv, viv);
            } else {
                let arg_v = cx.v_iv;
                let arg_v3 = (*cx.insts.add(cx.v_iv as usize)).ty;
                let konst_v6 = konst(cx, vh, u * vf, (*cx.insts.add(cx.v_iv as usize)).ty, pcx);
                let append_v = append(cx, vh, Add, arg_v3, viv,
                    konst_v6, 0, pcx);
                map_put(cx, arg_v,
                    append_v);
            }
            for r in 0..cx.v_reds.count / 3 {
                map_put(cx, (*cx.v_reds.data.add((3 * r) as usize)),
                    (*red_phis.data.add((u * (cx.v_reds.count / 3) + r) as usize)));
            }
            emit_body(cx, l, vh, vp, pcx);
            for r in 0..cx.v_reds.count / 3 {
                red_nexts.push(map_get(cx, (*cx.v_reds.data.add((3 * r + 1) as usize))));
            }
            let mut j: i64 = 0;
            for k in 0..cx.v_ovfs.count / 3 {
                let kind = (*cx.v_ovfs.data.add((3 * k + 1) as usize));
                if kind != OVK_LANE && kind != OVK_RED {
                    continue;
                }
                let o = (*cx.v_ovfs.data.add((3 * k) as usize));
                let x = if kind == OVK_LANE { lane_overflow(cx, l, o, vh, vp, pcx) } else {
                    addend_bound(cx, l, o,
                        (*cx.v_reds.data.add(
                            (3 * (*cx.v_ovfs.data.add((3 * k + 2) as usize))) as usize)), vh, vp,
                        pcx)
                };
                spec_nexts.push(append(cx, vh, VBin, vt,
                    (*spec_phis.data.add((u * nspec + j) as usize)), x, Op::Or as i64, pcx));
                j += 1;
            }
        }
        let arg_v1 = (*cx.insts.add(cx.v_iv as usize)).ty;
        let konst_v4 = konst(cx, vh, unroll * vf, (*cx.insts.add(cx.v_iv as usize)).ty, pcx);
        let vnext = append(cx, vh, Add, arg_v1, viv,
            konst_v4, 0, pcx);
        ir_set_arg(cx, viv, 1, vnext);
        for i in 0..red_phis.count {
            ir_set_arg(cx, (*red_phis.data.add(i as usize)), 1, (*red_nexts.data.add(i as usize)));
        }
        for i in 0..spec_phis.count {
            ir_set_arg(cx, (*spec_phis.data.add(i as usize)), 1,
                (*spec_nexts.data.add(i as usize)));
        }
        let more = cmp(cx, vh, Cond::Ne, TY_I64, vnext, vend, pcx);
        // (Its predecessors: vp, then vh, the phis' operand order.)
        ir_terminate(cx, vh, Term::Branch, more, vh, vx);
        // VX: the reductions summed.
        let mut red_final = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let nr = cx.v_reds.count / 3;
        for r in 0..nr {
            let phi = (*cx.v_reds.data.add((3 * r) as usize));
            let raw = (*cx.v_reds.data.add((3 * r + 2) as usize));
            let op = raw as Op;
            let ty = (*cx.insts.add(phi as usize)).ty;
            let mut vec = (*red_nexts.data.add(r as usize));
            let nx = (*cx.v_reds.data.add((3 * r + 1) as usize));
            for u in 1..unroll {
                let comb = if op == Sub { Add } else { op };
                vec = if op == Op::Sel {
                    minmax_of(cx, vx, phi, nx, vec, (*red_nexts.data.add((u * nr + r) as usize)),
                        true, vt, pcx)
                } else {
                    append(cx, vx, VBin, vt, vec, (*red_nexts.data.add((u * nr + r) as usize)),
                        comb as i64, pcx)
                };
            }
            let mut s: i64 = 0;
            if op == Add || op == Sub {
                s = append(cx, vx, VSum, lt, vec, 0, 0, pcx);
            } else if op == Op::Sel {
                s = append(cx, vx, VExt, lt, vec, 0, 0, pcx);
                for k in 1..vf {
                    let x = append(cx, vx, VExt, lt, vec, 0, k, pcx);
                    s = minmax_of(cx, vx, phi, nx, s, x, false, lt, pcx);
                }
            } else {
                s = append(cx, vx, VExt, lt, vec, 0, 0, pcx);
                for k in 1..vf {
                    let x = append(cx, vx, VExt, lt, vec, 0, k, pcx);
                    s = append(cx, vx, op, lt, s, x, 0, pcx);
                }
            }
            if ty != lt {
                s = append(cx, vx, Conv, ty, s, 0, 0, pcx);
                (*cx.insts.add(s as usize)).imm2 = lt;
            }
            red_final.push(s);
        }
        // (0.26.2) VX2: on when the overflow checks on lanes pass, to R,
        // the scalar loop from the start, when they fail.
        let mut vx2 = vx;
        let mut restart: i64 = 0;
        if spec {
            let mut bad: i64 = 0;
            let mut j: i64 = 0;
            for k in 0..cx.v_ovfs.count / 3 {
                let kind = (*cx.v_ovfs.data.add((3 * k + 1) as usize));
                if kind != OVK_LANE && kind != OVK_RED {
                    continue;
                }
                let mut acc = (*spec_nexts.data.add(j as usize));
                for u in 1..unroll {
                    acc = append(cx, vx, VBin, vt, acc,
                        (*spec_nexts.data.add((u * nspec + j) as usize)), Op::Or as i64, pcx);
                }
                let mut s = append(cx, vx, VExt, lt, acc, 0, 0, pcx);
                for q in 1..vf {
                    let append_v1 = append(cx, vx, VExt, lt, acc, 0, q, pcx);
                    s = append(cx, vx, Op::Or, lt, s, append_v1, 0,
                        pcx);
                }
                let o = (*cx.v_ovfs.data.add((3 * k) as usize));
                let this = if kind == OVK_LANE {
                    let konst_v5 = konst(cx, vx, 0, lt, pcx);
                    cmp(cx, vx, Cond::Lt, lt, s, konst_v5, pcx)
                } else {
                    reduction_may_overflow(cx, vx, (*cx.insts.add(o as usize)).imm,
                        (*red_start.data.add((*cx.v_ovfs.data.add((3 * k + 2) as usize)) as usize)),
                        s, vtrips, 1, pcx)
                };
                bad = if bad == 0 { this }
                    else { append(cx, vx, Op::Or, TY_BOOL, bad, this, 0, pcx) };
                j += 1;
            }
            vx2 = ir_new_block(cx);
            restart = ir_new_block(cx);
            (*cx.blocks.add(vx2 as usize)).sealed = 1;
            (*cx.blocks.add(restart as usize)).sealed = 1;
            ir_terminate(cx, vx, Term::Branch, bad, restart, vx2);
        }
        let done = cmp(cx, vx2, Cond::Eq, TY_I64, vend, n, pcx);
        ir_terminate(cx, vx2, Term::Branch, done, e, sp);
        if spec {
            ir_terminate(cx, restart, Term::Jump, 0, sp, 0);
        }
        // SP: the scalar loop's preheader, from C or VX (its predecessors, in
        // that order).
        let mut vals = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        vals.push(start);
        vals.push(vend);
        // (R's: the start again)
        vals.push(start);
        let ways: i64 = if spec { 3 } else { 2 };
        let iv0 = new_phi_in(cx, sp, (*cx.insts.add(cx.v_iv as usize)).ty, &mut vals, 0, ways, pcx);
        let hp = pred_index(cx, h, p);
        ir_set_arg(cx, cx.v_iv, hp, iv0);
        for r in 0..cx.v_reds.count / 3 {
            let phi = (*cx.v_reds.data.add((3 * r) as usize));
            vals.count = 0;
            let ir_arg_v3 = ir_arg(cx, phi, hp);
            let ir_val_v = ir_val(cx, ir_arg_v3);
            vals.push(ir_val_v);
            vals.push((*red_final.data.add(r as usize)));
            let ir_arg_v4 = ir_arg(cx, phi, hp);
            let ir_val_v1 = ir_val(cx, ir_arg_v4);
            vals.push(ir_val_v1);
            let r0 = new_phi_in(cx, sp, (*cx.insts.add(phi as usize)).ty, &mut vals, 0, ways, pcx);
            ir_set_arg(cx, phi, hp, r0);
        }
        ir_terminate(cx, sp, Term::Jump, 0, h, 0);
        // (ir_terminate added sp to h's predecessors: it replaces p.)
        (*cx.blocks.add(h as usize)).preds.count -= 1;
        (*(*cx.blocks.add(h as usize)).preds.data.add(hp as usize)) = sp;
        // E: from VX too, with the reductions' results.
        vals.count = 0;
        let mut x = (*cx.blocks.add(e as usize)).first;
        while x != 0 && (*cx.insts.add(x as usize)).op == Phi {
            let ir_arg_v2 = ir_arg(cx, x, 0);
            let w = ir_val(cx, ir_arg_v2);
            let r = reduction_of_next(cx, w);
            if r >= 0 {
                vals.push((*red_final.data.add(r as usize)));
            } else {
                // (Uniform values at the last iteration.)
                vals.push(eval_at(cx, l, w, last, vx, pcx));
            }
            x = (*cx.insts.add(x as usize)).next;
        }
        (*cx.blocks.add(e as usize)).preds.count -= 1;
        add_pred_values(cx, e, vx2, &mut vals, 0);
        (*cx.blocks.add(h as usize)).novec = 1;
        free(vals.data as *mut u8);
        free(red_init.data as *mut u8);
        free(red_id.data as *mut u8);
        free(red_start.data as *mut u8);
        free(spec_phis.data as *mut u8);
        free(spec_nexts.data as *mut u8);
        free(red_nexts.data as *mut u8);
        free(red_phis.data as *mut u8);
        free(red_final.data as *mut u8);
        true
    }
}

// Why loop l is no candidate at a glance (0: it may be): a call, a copy,
// no memory access, or too big (before the costlier analysis).
fn quick_reject(cx: &mut FnCtx, l: i64) -> *mut u8 {
    unsafe {
        let mut n: i64 = 0;
        let mut memory = false;
        for i in 0..loop_size(cx, l) {
            let mut v = { let at_ix = loop_block(cx, l, i) as usize; (*cx.blocks.add(at_ix)) }.first;
            while v != 0 {
                let op = (*cx.insts.add(v as usize)).op;
                // (0.21: an atomic or a fence keeps the loop scalar)
                if op.is_call() {
                    return c"a call in the loop";
                }
                if op == Op::Copy {
                    return c"a copy of memory (an aggregate's) in the loop";
                }
                if op.is_vector() {
                    return c"vector operations already";
                }
                if op == Op::Atomic || op == Op::Fence {
                    return c"an atomic operation or a fence in the loop";
                }
                if op == Load || op == Store {
                    memory = true;
                }
                n += 1;
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        if !memory {
            return c"no load or store";
        }
        if n > VEC_MAX_INSTS { c"too big: more than 160 instructions" } else { 0 as *mut u8 }
    }
}

// Vectorizes the innermost loops of fi that can be; returns whether any
// was. (0.25.5) With --vec-stats=FN and fi FN, a line for each loop.
pub fn vectorize_loops(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        cx.unroll_whole = false;
        if !pcx.vectorize {
            return false;
        }
        let report = pcx.vec_stats_fn != 0 as *mut u8
            && vec_stats_wanted((*get_irfuncs().add(fi as usize)).f, pcx);
        canonicalize_loops(cx, fi, pcx);
        let mut headers = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut outer = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for l in 0..loop_count(cx) {
            if loop_header(cx, l) == (*get_irfuncs().add(fi as usize)).entry {
                if report {
                    vec_report(cx, fi, l, c"its header is the function's entry", 0, pcx);
                }
                continue;
            }
            if (*cx.blocks.add(loop_header(cx, l) as usize)).novec != 0 {
                if report {
                    vec_report(cx, fi, l, c"a vector loop's scalar rest", 0, pcx);
                }
                continue;
            }
            let loop_header_v = loop_header(cx, l);
            if is_cold_block(cx, loop_header_v, pcx) {
                if report {
                    vec_report(cx, fi, l, c"cold (on a path to a panic or marked #[cold])", 0,
                        pcx);
                }
                continue;
            }
            let quick = quick_reject(cx, l);
            if quick != 0 as *mut u8 {
                if report {
                    vec_report(cx, fi, l, quick, 0, pcx);
                }
                continue;
            }
            if is_innermost(cx, l) {
                headers.push(loop_header(cx, l));
                continue;
            }
            // (A loop holding one innermost loop.)
            let mut child: i64 = -1;
            let mut children: i64 = 0;
            for x in 0..loop_count(cx) {
                if (*cx.lp_parent.data.add(x as usize)) == l {
                    child = x;
                    children += 1;
                }
            }
            if children == 1 && is_innermost(cx, child) {
                outer.push(loop_header(cx, l));
                outer.push(loop_header(cx, child));
            } else if report {
                vec_report(cx, fi, l,
                    c"not innermost, and not an outer loop of one innermost loop", 0, pcx);
            }
        }
        let mut changed = false;
        let mut k: i64 = 0;
        while k < outer.count {
            canonicalize_loops(cx, fi, pcx);
            let l = innermost_loop(cx, (*outer.data.add(k as usize)));
            let l2 = innermost_loop(cx, (*outer.data.add((k + 1) as usize)));
            k += 2;
            if l < 0 || l2 < 0 || loop_header(cx, l) != (*outer.data.add((k - 2) as usize))
                || loop_header(cx, l2) != (*outer.data.add((k - 1) as usize))
                || !is_canonical(cx, l) || !is_canonical(cx, l2)
                || (*cx.lp_parent.data.add(l2 as usize)) != l {
                continue;
            }
            if form_lcssa(cx, fi, l, pcx) {
                resolve_all(cx, fi);
            }
            let line: i64 = if report { loop_line(cx, l, pcx) } else { 0 };
            if vectorize_outer(cx, fi, l, l2, pcx) {
                if report {
                    let out = buf_new();
                    buf_fmt(out,
                        format_args("vec-stats: {}, loop at line {line}: vectorized as an outer loop (its inner loop's iterations in lanes)\n", str::from_utf8(sym_text(pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].display, pcx)).unwrap()));
                    buf_write_fd(out, STDERR);
                }
                changed = true;
                resolve_all(cx, fi);
                verify_func(cx, fi, c"vectorization (outer loop)", pcx);
            } else if report {
                vec_report(cx, fi, l,
                    c"not innermost, and the outer vectorizer did not take it (outer.vl)", 0, pcx);
            }
        }
        free(outer.data as *mut u8);
        if changed {
            canonicalize_loops(cx, fi, pcx);
        }
        // (The loops are found again after a change only.)
        let mut stale = false;
        let mut escapes_stale = true;
        for i in 0..headers.count {
            if stale {
                canonicalize_loops(cx, fi, pcx);
                stale = false;
            }
            let l = innermost_loop(cx, (*headers.data.add(i as usize)));
            if l < 0 || loop_header(cx, l) != (*headers.data.add(i as usize))
                || !is_canonical(cx, l) {
                if report && l >= 0 {
                    vec_report(cx, fi, l, c"not in canonical form", 0, pcx);
                }
                continue;
            }
            if form_lcssa(cx, fi, l, pcx) {
                resolve_all(cx, fi);
            }
            // (0.25.4) Invariant loads out first (a Vec's ptr and len:
            // middle::vecfacts), as LICM would after the loop passes: an
            // access at an address made from a load in the loop is not
            // vectorized. (Doing it only for the loops whose analysis fails
            // so costs more: LICM then moves them, at a higher price.)
            if escapes_stale {
                find_escaping_slots(cx, fi, pcx);
                escapes_stale = false;
            }
            if hoist_invariant_loads(cx, l, pcx) {
                changed = true;
            }
            // (the line before the change, which renumbers the loops)
            let line: i64 = if report { loop_line(cx, l, pcx) } else { 0 };
            if vectorize_loop(cx, fi, l, pcx) {
                if report {
                    vec_report_at(cx, fi, line, (*headers.data.add(i as usize)), 0 as *mut u8, 0,
                        pcx);
                }
                changed = true;
                stale = true;
                escapes_stale = true;
                resolve_all(cx, fi);
                verify_func(cx, fi, c"vectorization", pcx);
            } else if report {
                vec_report(cx, fi, l,
                    if cx.v_why == 0 as *mut u8 { c"(no reason recorded)" } else { cx.v_why },
                    cx.v_why_inst, pcx);
            }
        }
        free(headers.data as *mut u8);
        changed
    }
}

// ---- For the unroller (scev.vl) ----

// Whether the vectorizer would take loop l instead of unrolling it.
// Returns the lanes (0: not vectorizable). unrolled: the trip count when
// the alternative is the loop fully unrolled (0: the loop as it is).
pub fn vectorizable_lanes(cx: &mut FnCtx, l: i64, unrolled: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e: i64 = 0;
    if pcx.vectorize && analyze(cx, l, &mut e, pcx)
        && vector_unroll(cx, l, unrolled, pcx) > 0 { cx.v_vf }
    else { 0 }
}
