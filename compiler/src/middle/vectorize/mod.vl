use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{TY_BOOL, TY_I64, TY_U64, is_float, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::gvn::find_escaping_slots;
use crate::middle::ir::{
    Cond, Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_make, ir_new_block, ir_set_arg,
    ir_val,
};
use crate::middle::ir::Op::{
    Add, And, Conv, Div, Load, Mul, Phi, Shl, Store, Sub, VBin, VExt, VIns, VSplat, VSum,
};
use crate::middle::ir::cfg::{ir_terminate, pred_index};
use crate::middle::ir::verify::verify_func;
use crate::middle::licm::hoist_invariant_loads;
use crate::middle::loops::{
    add_pred_values, canonicalize_loops, form_lcssa, innermost_loop, invariant_in, is_canonical,
    is_innermost, loop_block, loop_count, loop_header, loop_preheader, loop_size, new_phi_in,
};
