// The run-time test that lets the vector loop run: the loop's checks
// (`idx <u len`) proved for every iteration from the first and last index,
// and no store overlapping another access at another address (accesses
// grouped by base, their ranges over the whole loop compared).

use crate::front::types::{TY_BOOL, TY_I64, TY_U64, int_bits, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{address_base, params_disjoint};
use crate::middle::ir::{Cond, Op, ir_val};
use crate::middle::ir::Op::{Add, Cmp, Or, Store};
use crate::middle::loops::{invariant_in, loop_contains};
use crate::middle::vectorize::VEC_MAX_CHECKS;
use crate::middle::vectorize::build::{and_into, append, cmp, eval_at, konst};
use crate::middle::vectorize::legality::{NONAFFINE, coef, coef_wrt};
use crate::middle::vectorize::outer::eval_at2;

// Records the check ending block b of loop l (into V_CHECKS), whose way on
// is `next`, the other way an unreachable exit: false unless the way on
// is `idx <u len` (64 bits, len invariant).
pub fn record_check(cx: sink *FnCtx, l: i64, b: i64, next: i64) -> bool {
    unsafe {
        let c = ir_val(cx, cx.blocks[b].cond);
        if cx.insts[c].op != Cmp || cx.insts[c].block != b {
            return false;
        }
        var cond = cx.insts[c].cond;
        if next != cx.blocks[b].s0 {
            cond = cond.negate();
        }
        var idx = ir_val(cx, cx.insts[c].a);
        var len = ir_val(cx, cx.insts[c].b);
        if cond == Cond::Gt {
            idx = ir_val(cx, cx.insts[c].b);
            len = ir_val(cx, cx.insts[c].a);
            cond = Cond::Lt;
        }
        if cond != Cond::Lt || is_signed(cx.insts[c].imm2) || int_bits(cx.insts[c].imm2) != 64
            || !invariant_in(cx, l, len) {
            return false;
        }
        if cx.v_checks.count >= 3 * VEC_MAX_CHECKS {
            return false;
        }
        cx.v_checks.push(c);
        cx.v_checks.push(idx);
        cx.v_checks.push(len);
        true
    }
}

// (0.26.2, a prototype) The kinds of the overflow checks in V_OVFS: not yet
// known; of values every lane shares, exactly affine in the counter (tested
// at the first and the last iteration, before the loop: ovf_tests); of
// lanes (their overflow accumulated, tested after the vector loop); of a
// reduction's own step (its addends' magnitudes accumulated, bounded after
// the vector loop); kept in every copy (the unroller's).
pub const OVK_NEW: i64 = 0;
pub const OVK_UNIFORM: i64 = 1;
pub const OVK_LANE: i64 = 2;
pub const OVK_RED: i64 = 3;
pub const OVK_KEEP: i64 = 4;
// (the unroller's: a step of a reduction split speculatively)
pub const OVK_STEP: i64 = 5;
const VEC_MAX_OVFS: i64 = 16;

// (0.26.2, a prototype) Records the overflow check ending block b of loop
// l (into V_OVFS, of kind OVK_NEW), whose way on is `next`, the other way
// an unreachable exit (its first way): false unless the check is an OVF whose holding
// leaves the loop.
pub fn record_ovf(cx: sink *FnCtx, l: i64, b: i64, next: i64) -> bool {
    // UNSAFE: the function's IR is FnCtx's raw arrays, as in record_check.
    // SAFETY: b is a block of loop l and its condition an instruction of the
    // function entered.
    unsafe {
        let c = ir_val(cx, cx.blocks[b].cond);
        if c == 0 || cx.insts[c].op != Op::Ovf || next != cx.blocks[b].s1
            || cx.v_ovfs.count >= 3 * VEC_MAX_OVFS || !loop_contains(cx, l, cx.insts[c].block) {
            return false;
        }
        cx.v_ovfs.push(c);
        cx.v_ovfs.push(OVK_NEW);
        // (the block, until a reduction's index replaces it: classify_ovf)
        cx.v_ovfs.push(b);
        true
    }
}

// The index in V_OVFS (of its triple) of overflow check c, or -1.
pub fn ovf_index(cx: sink *FnCtx, c: i64) -> i64 {
    // UNSAFE: V_OVFS is one of FnCtx's raw arrays.
    // SAFETY: k stays below its count.
    unsafe {
        if c == 0 {
            return -1;
        }
        let x = ir_val(cx, c);
        for k in 0..cx.v_ovfs.count / 3 {
            if cx.v_ovfs.data[3 * k] == x {
                return k;
            }
        }
        -1
    }
}

// Whether instruction x (+, -, * or negation) has its overflow check in
// V_OVFS: one of the same operation, type and operands.
fn has_ovf(cx: sink *FnCtx, x: i64) -> bool {
    // UNSAFE: FnCtx's raw arrays (insts, V_OVFS).
    // SAFETY: k stays below V_OVFS' count; its checks and x are
    // instructions of the function entered.
    unsafe {
        for k in 0..cx.v_ovfs.count / 3 {
            let c = cx.v_ovfs.data[3 * k];
            let imm = cx.insts[c].imm;
            if (imm & 255) == cx.insts[x].op as i64 && (imm >> 8) == cx.insts[x].ty
                && ir_val(cx, cx.insts[c].a) == ir_val(cx, cx.insts[x].a)
                && (cx.insts[x].b == 0 && cx.insts[c].b == 0
                    || cx.insts[x].b != 0 && cx.insts[c].b != 0
                    && ir_val(cx, cx.insts[c].b) == ir_val(cx, cx.insts[x].b)) {
                return true;
            }
        }
        false
    }
}

// Whether the exact value of x is affine in the counter of loop l: the
// counter, an invariant, or a checked +, - or negation of such values, or a
// checked product of one and an invariant (so that between the first and
// the last iteration it lies between its values at them).
fn exact_affine(cx: sink *FnCtx, l: i64, v: i64, depth: i64) -> bool {
    // UNSAFE: FnCtx's raw arrays (insts).
    // SAFETY: x is an instruction of the function entered.
    unsafe {
        let x = ir_val(cx, v);
        if x == cx.v_iv || invariant_in(cx, l, x) {
            return true;
        }
        let op = cx.insts[x].op;
        if depth > 8 || op != Add && op != Op::Sub && op != Op::Mul && op != Op::Neg
            || !has_ovf(cx, x) {
            return false;
        }
        operands_affine(cx, l, x, op, depth + 1)
    }
}

// Whether the operands of x (an operation op, or op's overflow check) are
// exact_affine, a product's one of them invariant.
fn operands_affine(cx: sink *FnCtx, l: i64, x: i64, op: Op, depth: i64) -> bool {
    // UNSAFE: FnCtx's raw arrays (insts).
    // SAFETY: x and its operands are instructions of the function entered.
    unsafe {
        let a = cx.insts[x].a;
        let b = cx.insts[x].b;
        if !exact_affine(cx, l, a, depth) || b != 0 && !exact_affine(cx, l, b, depth) {
            return false;
        }
        op != Op::Mul || invariant_in(cx, l, ir_val(cx, a)) || invariant_in(cx, l, ir_val(cx, b))
    }
}

// Whether overflow check c of loop l can be tested before the loop, at its
// first and last iteration (OVK_UNIFORM).
pub fn ovf_uniform(cx: sink *FnCtx, l: i64, c: i64) -> bool {
    // UNSAFE: FnCtx's raw arrays (insts).
    // SAFETY: c is an instruction of the function entered.
    unsafe { operands_affine(cx, l, c, (cx.insts[c].imm & 255) as Op, 0) }
}

// The run-time test, and'ed into ok in block c, that no overflow check of
// kind OVK_UNIFORM overflows from iteration `start` to `last`: their
// values are exactly affine, so it overflows at neither end.
pub fn ovf_tests(cx: sink *FnCtx, l: i64, c: i64, ok0: i64, start: i64, last: i64) -> i64 {
    // UNSAFE: V_OVFS is one of FnCtx's raw arrays.
    // SAFETY: k stays below its count.
    unsafe {
        var ok = ok0;
        for k in 0..cx.v_ovfs.count / 3 {
            if cx.v_ovfs.data[3 * k + 1] != OVK_UNIFORM {
                continue;
            }
            let o = cx.v_ovfs.data[3 * k];
            let bad = append(cx, c, Or, TY_BOOL, eval_at(cx, l, o, start, c),
                eval_at(cx, l, o, last, c), 0);
            ok = and_into(cx, c, ok,
                append(cx, c, Op::Xor, TY_BOOL, bad, konst(cx, c, 1, TY_BOOL), 0));
        }
        ok
    }
}

// Whether some overflow check of V_OVFS is of kind `kind`.
pub fn has_ovf_kind(cx: sink *FnCtx, kind: i64) -> bool {
    // UNSAFE: V_OVFS is one of FnCtx's raw arrays.
    // SAFETY: k stays below its count.
    unsafe {
        for k in 0..cx.v_ovfs.count / 3 {
            if cx.v_ovfs.data[3 * k + 1] == kind {
                return true;
            }
        }
        false
    }
}

// The run-time test, and'ed into ok in block c, that no check of
// V_CHECKS fails from iteration `start` to `last`: each index (of
// coefficient 1 or -1) at both ends, the lower at least 0 and the higher
// below the length; `hi >= lo` rules out an index that wraps.
pub fn check_tests(cx: sink *FnCtx, l: i64, c: i64, ok0: i64, start: i64, last: i64) -> i64 {
    unsafe {
        var ok = ok0;
        for k in 0..cx.v_checks.count / 3 {
            let idx = cx.v_checks.data[3 * k + 1];
            let len = cx.v_checks.data[3 * k + 2];
            let first = eval_at(cx, l, idx, start, c);
            let final = eval_at(cx, l, idx, last, c);
            let down = coef(cx, l, idx) < 0;
            let lo = if down { final } else { first };
            let hi = if down { first } else { final };
            ok = and_into(cx, c, ok, cmp(cx, c, Cond::Ge, TY_I64, lo, konst(cx, c, 0, TY_I64)));
            ok = and_into(cx, c, ok, cmp(cx, c, Cond::Ge, TY_I64, hi, lo));
            ok = and_into(cx, c, ok, cmp(cx, c, Cond::Lt, TY_I64, hi, len));
        }
        ok
    }
}

// Groups the accesses; false when a group stores and holds accesses at
// different offsets (a dependence the overlap test would always find).
pub fn build_groups(cx: sink *FnCtx) -> bool {
    unsafe {
        cx.v_groups.count = 0;
        for i in 0..cx.v_access.count / 3 {
            let a = cx.v_access.data[3 * i];
            var off = cx.insts[a].imm;
            let base = ir_val(cx, address_base(cx, cx.v_access.data[3 * i + 1], &off));
            let end = off + cx.v_access.data[3 * i + 2];
            let store = cx.insts[a].op == Store;
            var g = 0;
            while g < cx.v_groups.count && cx.v_groups.data[g] != base {
                g += 4;
            }
            if g == cx.v_groups.count {
                cx.v_groups.push(base);
                cx.v_groups.push(off);
                cx.v_groups.push(end);
                cx.v_groups.push(if store { 1 } else { 0 });
                continue;
            }
            let same = cx.v_groups.data[g + 1] == off && cx.v_groups.data[g + 2] == end;
            if !same && (store || cx.v_groups.data[g + 3] != 0) {
                return false;
            }
            if off < cx.v_groups.data[g + 1] { cx.v_groups.data[g + 1] = off; }
            if end > cx.v_groups.data[g + 2] { cx.v_groups.data[g + 2] = end; }
            if store { cx.v_groups.data[g + 3] = 1; }
        }
        true
    }
}

fn needs_test(cx: sink *FnCtx, i: i64, j: i64) -> bool {
    unsafe { !params_disjoint(cx, cx.v_groups.data[4 * i], cx.v_groups.data[4 * j]) }
}

// The number of runtime overlap tests the groups need (each storing group
// against every other); a large number when they cannot be.
pub fn overlap_pairs(cx: sink *FnCtx) -> i64 {
    unsafe {
        if !build_groups(cx) {
            return 1000000;
        }
        let n = cx.v_groups.count / 4;
        var count = 0;
        for i in 0..n {
            if cx.v_groups.data[4 * i + 3] == 0 {
                continue;
            }
            for j in 0..n {
                if j != i && (cx.v_groups.data[4 * j + 3] == 0 || j > i) && needs_test(cx, i, j) {
                    count += 1;
                }
            }
        }
        count
    }
}

// Appends to block c the test that groups i and j do not overlap (over
// all iterations: one wholly below the other) to *ok.
fn group_test(cx: sink *FnCtx, l: i64, c: i64, i: i64, j: i64, ok: i64, start: i64, last: i64,
    start2: i64, last2: i64) -> i64 {
    let below = group_below(cx, l, c, i, j, start, last, start2, last2);
    let above = group_below(cx, l, c, j, i, start, last, start2, last2);
    and_into(cx, c, ok, append(cx, c, Or, TY_BOOL, below, above, 0))
}

// Whether group g's bytes all come before group h's: every highest
// corner of g (its end) at most every lowest corner of h.
fn group_below(cx: sink *FnCtx, l: i64, c: i64, g: i64, h: i64, start: i64, last: i64, start2: i64,
    last2: i64) -> i64 {
    unsafe {
        var his: [i64; 2] = [0; 2];
        var los: [i64; 2] = [0; 2];
        let nh = group_corners(cx, l, c, g, true, start, last, start2, last2, &his as *i64);
        let nl = group_corners(cx, l, c, h, false, start, last, start2, last2, &los as *i64);
        var ok = 0;
        for a in 0..nh {
            let end = append(cx, c, Add, TY_U64, his[a],
                konst(cx, c, cx.v_groups.data[4 * g + 2], TY_U64), 0);
            for b in 0..nl {
                let begin = append(cx, c, Add, TY_U64, los[b],
                    konst(cx, c, cx.v_groups.data[4 * h + 1], TY_U64), 0);
                ok = and_into(cx, c, ok, cmp(cx, c, Cond::Le, TY_U64, end, begin));
            }
        }
        ok
    }
}

// The base of group g at its highest (or lowest) iterations, into out:
// one value, or two when its coefficient of k has an unknown sign (k's
// first and last value; j's coefficient is a constant).
fn group_corners(cx: sink *FnCtx, l: i64, c: i64, g: i64, high: bool, start: i64, last: i64,
    start2: i64, last2: i64, out: *i64) -> i64 {
    unsafe {
        let base = cx.v_groups.data[4 * g];
        let cj = coef_wrt(cx, l, base, cx.v_iv, cx.v_iv2);
        let jv = if (cj >= 0) == high { last } else { start };
        if cx.v_iv2 == 0 {
            out[0] = eval_at(cx, l, base, jv, c);
            return 1;
        }
        let ck = coef_wrt(cx, l, base, cx.v_iv2, cx.v_iv);
        if ck != NONAFFINE {
            let kv = if (ck >= 0) == high { last2 } else { start2 };
            out[0] = eval_at2(cx, l, base, jv, kv, c);
            return 1;
        }
        out[0] = eval_at2(cx, l, base, jv, start2, c);
        out[1] = eval_at2(cx, l, base, jv, last2, c);
        2
    }
}

// The overlap tests of all the groups, and'ed into ok.
pub fn overlap_tests(cx: sink *FnCtx, l: i64, c: i64, ok0: i64, start: i64, last: i64, start2: i64,
    last2: i64) -> i64 {
    unsafe {
        var ok = ok0;
        cx.vec_loops += 1;
        let n = cx.v_groups.count / 4;
        for i in 0..n {
            if cx.v_groups.data[4 * i + 3] == 0 {
                continue;
            }
            for j in 0..n {
                if j != i && (cx.v_groups.data[4 * j + 3] == 0 || j > i) {
                    if needs_test(cx, i, j) {
                        ok = group_test(cx, l, c, i, j, ok, start, last, start2, last2);
                        cx.vec_tests += 1;
                    } else {
                        cx.vec_skipped += 1;
                    }
                }
            }
        }
        ok
    }
}
