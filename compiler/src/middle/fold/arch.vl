// Vector constant folding (0.19 T6, docs/design/arch.md §5.2): 0.10's
// vector operations and std::arch's intrinsics (INTR, by the table's
// `fold` column) on constant operands, computing what the instruction
// computes. A constant vector is a VSPLAT of a constant (seen through
// CONVs between vector types of the same lane width); a fold whose result
// is one is a VSPLAT again, a scalar one a constant. Integer lanes only:
// float lanes are left to the instructions (NaNs, rounding). x86-64's
// intrinsics (opaque types) are not folded.
//
// The folds are tested against the tables' references with constant
// arguments by tests/arch/gen.sh, at -O2.

use crate::arch::{ARCH_X86_64, F_FOLD, intr_imm, intr_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::consteval::wrap_int;
use crate::front::types::{int_bits, is_integer, is_signed, is_vector, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{const_before, fold_compare};
use crate::middle::ir::{Cond, Op, ir_replace};

// The constant every lane of vector value x holds, as a value of lane type
// `elem`; false when x is not such a splat (or its lanes are floats, or
// of another width).
pub fn splat_constant(cx: &mut FnCtx<Comp>, x: i64, elem: i64, value: &mut i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !is_integer(elem) {
            return false;
        }
        let mut w = x;
        let mut depth: i64 = 0;
        while (cx.insts[w as usize]).op == Op::Conv && depth < 4 {
            let from = (cx.insts[w as usize]).imm2;
            let to = (cx.insts[w as usize]).ty;
            if !is_vector(from, pcx) || !is_vector(to, pcx) {
                return false;
            }
            if type_size(pcx.types[from as usize].a, pcx)
                != type_size(pcx.types[to as usize].a, pcx) {
                return false;
            }
            w = (cx.insts[w as usize]).a;
            depth += 1;
        }
        if (cx.insts[w as usize]).op != Op::VSplat
            || !is_vector((cx.insts[w as usize]).ty, pcx) {
            return false;
        }
        let e = pcx.types[(cx.insts[w as usize]).ty as usize].a;
        let s = (cx.insts[w as usize]).a;
        if !is_integer(e) || type_size(e, pcx) != type_size(elem, pcx)
            || (cx.insts[s as usize]).op != Op::Const {
            return false;
        }
        *value = wrap_int((cx.insts[s as usize]).imm, elem);
        true
    }
}

// Makes v (of a vector type) the splat of `value`.
fn become_splat(cx: &mut FnCtx<Comp>, v: i64, value: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let elem = pcx.types[(cx.insts[v as usize]).ty as usize].a;
        let c = const_before(cx, v, wrap_int(value, elem), elem, pcx);
        (cx.insts[v as usize]).op = Op::VSplat;
        (cx.insts[v as usize]).cond = Cond::Eq;
        (cx.insts[v as usize]).a = c;
        (cx.insts[v as usize]).b = 0;
        (cx.insts[v as usize]).c = 0;
        (cx.insts[v as usize]).imm = 0;
        (cx.insts[v as usize]).imm2 = 0;
    }
    true
}

// Makes v (of a scalar type) the constant `value`.
fn become_const(cx: &mut FnCtx<Comp>, v: i64, value: i64) -> bool {
    unsafe {
        if !is_integer((cx.insts[v as usize]).ty) {
            return false;
        }
        (cx.insts[v as usize]).op = Op::Const;
        (cx.insts[v as usize]).cond = Cond::Eq;
        (cx.insts[v as usize]).imm = wrap_int(value, (cx.insts[v as usize]).ty);
        (cx.insts[v as usize]).a = 0;
        (cx.insts[v as usize]).b = 0;
        (cx.insts[v as usize]).c = 0;
        (cx.insts[v as usize]).imm2 = 0;
    }
    true
}

// A lane whose bits are all ones (a mask's true), of lane type elem.
fn ones(elem: i64) -> i64 {
    wrap_int(-1, elem)
}

// x's bits within `bits` bits, as an unsigned value.
fn lane_bits(x: i64, bits: i64) -> u64 {
    if bits == 64 { x as u64 } else { (x as u64) & ((1 << bits as u64) - 1) }
}

fn count_leading_zeros(x: i64, bits: i64) -> i64 {
    let u = lane_bits(x, bits);
    let mut n: i64 = 0;
    let mut k = bits - 1;
    while k >= 0 && ((u >> k as u64) & 1) == 0 {
        n += 1;
        k -= 1;
    }
    n
}

// The bits after the top one equal to it.
fn count_leading_signs(x: i64, bits: i64) -> i64 {
    let u = lane_bits(x, bits);
    let top = (u >> (bits - 1) as u64) & 1;
    let mut n: i64 = 0;
    let mut k = bits - 2;
    while k >= 0 && ((u >> k as u64) & 1) == top {
        n += 1;
        k -= 1;
    }
    n
}

fn count_ones(x: i64, bits: i64) -> i64 {
    let u = lane_bits(x, bits);
    let mut n: i64 = 0;
    for k in 0..bits {
        n += ((u >> k as u64) & 1) as i64;
    }
    n
}

fn reverse_bits(x: i64, bits: i64) -> i64 {
    let u = lane_bits(x, bits);
    let mut r: u64 = 0;
    for k in 0..bits {
        r |= ((u >> k as u64) & 1) << (bits - 1 - k) as u64;
    }
    r as i64
}

// x >> n as the lane type's shift does (an arithmetic shift for a signed
// lane; n up to the lane's width).
fn shift_right(x: i64, n: i64, bits: i64, signed: bool) -> i64 {
    if signed {
        return x >> (if n > 63 { 63 } else { n }) as u64;
    }
    if n >= 64 {
        return 0;
    }
    (lane_bits(x, bits) >> n as u64) as i64
}

// CRC-32 (reflected, no inversion) of crc and the `bytes` low bytes of
// data, little-endian, with polynomial poly (reflected).
fn crc32(crc: i64, data: i64, bytes: i64, poly: u64) -> i64 {
    let mut c = lane_bits(crc, 32);
    for k in 0..bytes {
        c ^= ((data as u64) >> (8 * k) as u64) & 255;
        for _ in 0..8 {
            c = if (c & 1) != 0 { (c >> 1) ^ poly } else { c >> 1 };
        }
    }
    c as i64
}

// Folds vector operation (or INTR) v when its operands are constant;
// whether it changed. From instcombine.
pub fn fold_vector(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if op == Op::Intr {
            return fold_intr(cx, v, pcx);
        }
        let ty = (cx.insts[v as usize]).ty;
        let a = (cx.insts[v as usize]).a;
        if op == Op::VExt || op == Op::VSum {
            let vt = (cx.insts[a as usize]).ty;
            let mut x: i64 = 0;
            if !is_vector(vt, pcx)
                || !splat_constant(cx, a, pcx.types[vt as usize].a, &mut x, pcx) {
                return false;
            }
            return become_const(cx, v,
                if op == Op::VExt { x } else { x.wrapping_mul(pcx.types[vt as usize].b) });
        }
        if !is_vector(ty, pcx) {
            return false;
        }
        let elem = pcx.types[ty as usize].a;
        if op == Op::VSel {
            // (a bitwise select: an all-zeros or all-ones mask picks one)
            let mt = (cx.insts[a as usize]).ty;
            let mut m: i64 = 0;
            if !is_vector(mt, pcx)
                || !splat_constant(cx, a, pcx.types[mt as usize].a, &mut m, pcx) {
                return false;
            }
            if m == 0 && (cx.insts[(cx.insts[v as usize]).c as usize]).ty == ty {
                ir_replace(cx, v, (cx.insts[v as usize]).c);
                return true;
            }
            if m == ones(pcx.types[mt as usize].a)
                && (cx.insts[(cx.insts[v as usize]).b as usize]).ty == ty {
                ir_replace(cx, v, (cx.insts[v as usize]).b);
                return true;
            }
            let mut x: i64 = 0;
            let mut y: i64 = 0;
            if type_size(pcx.types[mt as usize].a, pcx) == type_size(elem, pcx)
                && splat_constant(cx, (cx.insts[v as usize]).b, elem, &mut x, pcx)
                && splat_constant(cx, (cx.insts[v as usize]).c, elem, &mut y, pcx) {
                return become_splat(cx, v, (x & m) | (y & !m), pcx);
            }
            return false;
        }
        let mut x: i64 = 0;
        if !splat_constant(cx, a, elem, &mut x, pcx) {
            return false;
        }
        if op == Op::VNeg {
            return become_splat(cx, v, x.wrapping_neg(), pcx);
        }
        if op == Op::VIns {
            let b = (cx.insts[v as usize]).b;
            if (cx.insts[b as usize]).op == Op::Const
                && wrap_int((cx.insts[b as usize]).imm, elem) == x {
                return become_splat(cx, v, x, pcx);
            }
            return false;
        }
        let mut y: i64 = 0;
        if (cx.insts[v as usize]).b == 0
            || !splat_constant(cx, (cx.insts[v as usize]).b, elem, &mut y, pcx) {
            return false;
        }
        if op == Op::VCmp {
            let t = fold_compare((cx.insts[v as usize]).cond, elem, x, y);
            return become_splat(cx, v, if t { ones(elem) } else { 0 }, pcx);
        }
        if op == Op::VBin {
            let raw = (cx.insts[v as usize]).imm;
            let bop = raw as Op;
            return match bop {
                Op::Add => become_splat(cx, v, x.wrapping_add(y), pcx),
                Op::Sub => become_splat(cx, v, x.wrapping_sub(y), pcx),
                Op::Mul => become_splat(cx, v, x.wrapping_mul(y), pcx),
                Op::And => become_splat(cx, v, x & y, pcx),
                Op::Or => become_splat(cx, v, x | y, pcx),
                Op::Xor => become_splat(cx, v, x ^ y, pcx),
                _ => false,
            };
        }
        false
    }
}

// An INTR on constant operands, by its fold class.
fn fold_intr(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let id = (cx.insts[v as usize]).imm;
        if (*pcx.intrs.add(id as usize)).arch == ARCH_X86_64 {
            return false;
        }
        let cls = intr_text(id, F_FOLD, pcx);
        let ty = (cx.insts[v as usize]).ty;
        let a = (cx.insts[v as usize]).a;
        let b = (cx.insts[v as usize]).b;
        let c = (cx.insts[v as usize]).c;
        if cls.len() >= 4 && cls[0..4] == b"crc." {
            if a == 0 || b == 0 || (cx.insts[a as usize]).op != Op::Const
                || (cx.insts[b as usize]).op != Op::Const {
                return false;
            }
            let poly: u64 = if cls[4] == b'c' { 0x82f63b78 } else { 0xedb88320 };
            let bytes = type_size((cx.insts[b as usize]).ty, pcx);
            return become_const(cx, v,
                crc32((cx.insts[a as usize]).imm, (cx.insts[b as usize]).imm, bytes,
                    poly));
        }
        if a == 0 || !is_vector((cx.insts[a as usize]).ty, pcx) {
            return false;
        }
        let ein = pcx.types[(cx.insts[a as usize]).ty as usize].a;
        let mut x: i64 = 0;
        if !splat_constant(cx, a, ein, &mut x, pcx) {
            return false;
        }
        let n = intr_imm((cx.insts[v as usize]).imm2, 0);
        // Lanes moved, not changed.
        if cls == b"across.max" || cls == b"across.min" || cls == b"lane" {
            return become_const(cx, v, x);
        }
        if !is_vector(ty, pcx) || !is_integer(pcx.types[ty as usize].a) {
            return false;
        }
        let same_width = type_size(pcx.types[ty as usize].a, pcx) == type_size(ein, pcx);
        if cls == b"splat.lane" || cls == b"perm.rev" || cls == b"perm.low" || cls == b"perm.high" {
            return same_width && become_splat(cx, v, x, pcx);
        }
        if !same_width {
            return false;
        }
        let bits = int_bits(ein);
        let signed = is_signed(ein);
        let narrow = bits < 64;
        // (the saturating bounds, read for narrow lanes only)
        let lo: i64 = if signed && narrow { 0 - (1 << (bits - 1) as u64) } else { 0 };
        let hi: i64 = if !narrow { -1 } else if signed { (1 << (bits - 1) as u64) - 1 }
            else { (1 << bits as u64) - 1 };
        let mask = ones(pcx.types[ty as usize].a);
        // One operand.
        if cls == b"lanes.not" { return become_splat(cx, v, !x, pcx); }
        if cls == b"lanes.neg" { return become_splat(cx, v, x.wrapping_neg(), pcx); }
        if cls == b"lanes.abs" { return become_splat(cx, v, x.wrapping_abs(), pcx); }
        if cls == b"lanes.qabs" && narrow {
            let r = if x < 0 { 0 - x } else { x };
            return become_splat(cx, v, if r > hi { hi } else { r }, pcx);
        }
        if cls == b"lanes.qneg" && narrow {
            let r = 0 - x;
            return become_splat(cx, v, if r > hi { hi } else { r }, pcx);
        }
        if cls == b"lanes.eqz" { return become_splat(cx, v, if x == 0 { mask } else { 0 }, pcx); }
        if cls == b"lanes.gez" { return become_splat(cx, v, if x >= 0 { mask } else { 0 }, pcx); }
        if cls == b"lanes.gtz" { return become_splat(cx, v, if x > 0 { mask } else { 0 }, pcx); }
        if cls == b"lanes.lez" { return become_splat(cx, v, if x <= 0 { mask } else { 0 }, pcx); }
        if cls == b"lanes.ltz" { return become_splat(cx, v, if x < 0 { mask } else { 0 }, pcx); }
        if cls == b"lanes.clz" { return become_splat(cx, v, count_leading_zeros(x, bits), pcx); }
        if cls == b"lanes.cls" { return become_splat(cx, v, count_leading_signs(x, bits), pcx); }
        if cls == b"lanes.cnt" { return become_splat(cx, v, count_ones(x, bits), pcx); }
        if cls == b"lanes.rbit" { return become_splat(cx, v, reverse_bits(x, bits), pcx); }
        if cls == b"lanes.shl" { return become_splat(cx, v, x << n as u64, pcx); }
        if cls == b"lanes.shr" { return become_splat(cx, v, shift_right(x, n, bits, signed), pcx); }
        if cls == b"lanes.rshr" && narrow {
            return become_splat(cx, v, (x + (1 << (n - 1) as u64)) >> n as u64, pcx);
        }
        // Two operands of the same lane width.
        let mut y: i64 = 0;
        if b == 0 || !is_vector((cx.insts[b as usize]).ty, pcx)
            || !splat_constant(cx, b, ein, &mut y, pcx) {
            return false;
        }
        if cls == b"perm.zip1" || cls == b"perm.zip2" || cls == b"perm.uzp1" || cls == b"perm.uzp2"
            || cls == b"perm.trn1" || cls == b"perm.trn2" || cls == b"perm.ext"
            || cls == b"perm.combine" {
            return x == y && become_splat(cx, v, x, pcx);
        }
        if cls == b"lanes.bic" { return become_splat(cx, v, x & !y, pcx); }
        if cls == b"lanes.orn" { return become_splat(cx, v, x | !y, pcx); }
        if cls
            == b"lanes.tst" {
            return become_splat(cx, v, if (x & y) != 0 { mask } else { 0 }, pcx);
        }
        if cls
            == b"lanes.sra" {
            return become_splat(cx, v, x.wrapping_add(shift_right(y, n, bits, signed)), pcx);
        }
        if narrow {
            if cls == b"lanes.qadd_u" || cls == b"lanes.qadd_s" || cls == b"lanes.qsub_u"
                || cls == b"lanes.qsub_s" {
                let add = cls == b"lanes.qadd_u" || cls == b"lanes.qadd_s";
                let r = if add { x + y } else { x - y };
                return become_splat(cx, v, if r < lo { lo } else if r > hi { hi } else { r }, pcx);
            }
            if cls == b"lanes.min" { return become_splat(cx, v, if x < y { x } else { y }, pcx); }
            if cls == b"lanes.max" { return become_splat(cx, v, if x > y { x } else { y }, pcx); }
            if cls
                == b"lanes.abd" {
                return become_splat(cx, v, if x > y { x - y } else { y - x }, pcx);
            }
            if cls == b"lanes.hadd" { return become_splat(cx, v, (x + y) >> 1, pcx); }
            if cls == b"lanes.rhadd" { return become_splat(cx, v, (x + y + 1) >> 1, pcx); }
            if cls == b"lanes.hsub" { return become_splat(cx, v, (x - y) >> 1, pcx); }
        }
        // Three.
        let mut z: i64 = 0;
        if c == 0 || !is_vector((cx.insts[c as usize]).ty, pcx)
            || !splat_constant(cx, c, ein, &mut z, pcx) {
            return false;
        }
        if cls
            == b"lanes.mla" { return become_splat(cx, v, x.wrapping_add(y.wrapping_mul(z)), pcx); }
        if cls
            == b"lanes.mls" { return become_splat(cx, v, x.wrapping_sub(y.wrapping_mul(z)), pcx); }
        false
    }
}
