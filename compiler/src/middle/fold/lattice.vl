// Sparse conditional constant propagation (split from fold): the users
// of each value, a lattice value per SSA value, the executable edges, and
// the rewrite of what became constant.

use crate::base::{alloc_array, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::consteval::f64_of_bits;
use crate::front::types::is_float;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::fold_value;
use crate::middle::ir::{
    Cond, Op, Term, get_irfuncs, ir_arg, ir_enter, ir_make, ir_operand, ir_operand_count,
    ir_prepend, ir_replace,
};
use crate::middle::ir::Op::{Const, Phi};
use crate::middle::ir::cfg::{succ, succ_count, switch_target};
use crate::middle::opt::{
    remove_pred, remove_trivial_phis, remove_unreachable, resolve_all, switch_to_jump,
};

fn is_foldable_op(op: Op) -> bool {
    op.is_pure() || op == Const
}

// ---- Users ----

// Numbers the instructions of function `fi` (INSTS[v].aux = index + 1).
fn number_values(cx: &mut FnCtx, fi: i64) {
    cx.fn_values.count = 0;
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                cx.fn_values.push(v);
                (*cx.insts.add(v as usize)).aux = cx.fn_values.count;
                v = (*cx.insts.add(v as usize)).next;
            }
        }
    }
}

fn build_users(cx: &mut FnCtx, fi: i64) {
    unsafe {
        number_values(cx, fi);
        let n = cx.fn_values.count;
        free(cx.user_start as *mut u8);
        cx.user_start = alloc_array::<i64>(n + 2);
        // Count, then fill.
        for pass in 0..2 {
            let mut fill: *mut i64 = 0 as *mut i64;
            if pass == 1 {
                let mut total: i64 = 0;
                for i in 0..n + 1 {
                    let count = (*cx.user_start.add(i as usize));
                    (*cx.user_start.add(i as usize)) = total;
                    total += count;
                }
                (*cx.user_start.add((n + 1) as usize)) = total;
                free(cx.user_list as *mut u8);
                cx.user_list = alloc_array::<i64>(total + 1);
                fill = alloc_array::<i64>(n + 1);
            }
            for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
                let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
                if (*cx.blocks.add(b as usize)).removed != 0 {
                    continue;
                }
                let mut v = (*cx.blocks.add(b as usize)).first;
                while v != 0 {
                    for k in 0..ir_operand_count(cx, v) {
                        let ir_operand_v = ir_operand(cx, v, k);
                        add_user(cx, ir_operand_v, v, pass, fill);
                    }
                    v = (*cx.insts.add(v as usize)).next;
                }
                add_user(cx, (*cx.blocks.add(b as usize)).cond, 0 - b, pass, fill);
            }
            if pass == 1 {
                free(fill as *mut u8);
            }
        }
    }
}

fn add_user(cx: &mut FnCtx, operand: i64, user: i64, pass: i64, fill: *mut i64) {
    unsafe {
        if operand == 0 || (*cx.insts.add(operand as usize)).aux == 0 {
            return;
        }
        let t = (*cx.insts.add(operand as usize)).aux - 1;
        if pass == 0 {
            (*cx.user_start.add(t as usize)) += 1;
        } else {
            (*cx.user_list.add(
                ((*cx.user_start.add(t as usize)) + (*fill.add(t as usize))) as usize)) = user;
            (*fill.add(t as usize)) += 1;
        }
    }
}

// ---- SCCP ----

// The lattice of a value: not known yet (Top), a constant, or not a
// constant (Bottom).
#[derive(Clone, Copy, PartialEq, Eq)] pub enum Lattice { Top, Const, Bottom }

fn lat_of(cx: &mut FnCtx, v: i64) -> Lattice {
    unsafe { (*cx.lat.add(((*cx.insts.add(v as usize)).aux - 1) as usize)) }
}

fn lat_value(cx: &mut FnCtx, v: i64) -> i64 {
    unsafe { (*cx.lat_value.add(((*cx.insts.add(v as usize)).aux - 1) as usize)) }
}

// Lowers the state of v; queues its users when it changed.
fn lat_set(cx: &mut FnCtx, v: i64, state: Lattice, value: i64) {
    unsafe {
        let t = (*cx.insts.add(v as usize)).aux - 1;
        let old = (*cx.lat.add(t as usize));
        if old == Lattice::Bottom || state == Lattice::Top {
            return;
        }
        if old == Lattice::Const {
            if state == Lattice::Const && value == (*cx.lat_value.add(t as usize)) {
                return;
            }
            // Two different constants, or more than a constant.
            (*cx.lat.add(t as usize)) = Lattice::Bottom;
        } else {
            (*cx.lat.add(t as usize)) = state;
            (*cx.lat_value.add(t as usize)) = value;
        }
        cx.ssa_work.push(v);
    }
}

// Whether the edge from `p` to `b` is executable (BLOCKS[p].aux bit k for
// successor k).
// (Edges past the 62nd successor of a switch share bit 62.)
fn edge_bit(k: i64) -> u64 {
    (if k < 62 { k } else { 62 }) as u64
}

fn edge_executable(cx: &mut FnCtx, p: i64, b: i64) -> bool {
    for k in 0..succ_count(cx, p) {
        if unsafe {
            succ(cx, p, k) == b && ((*cx.blocks.add(p as usize)).aux >> edge_bit(k)) & 1 != 0
        } {
            return true;
        }
    }
    false
}

fn mark_edge(cx: &mut FnCtx, p: i64, k: i64) {
    unsafe {
        if k < 62 && ((*cx.blocks.add(p as usize)).aux >> edge_bit(k)) & 1 != 0 {
            return;
        }
        (*cx.blocks.add(p as usize)).aux |= 1 << edge_bit(k);
        let succ_v = succ(cx, p, k);
        cx.cfg_work.push(succ_v);
    }
}

fn sccp_eval(cx: &mut FnCtx, v: i64) {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if (*cx.insts.add(v as usize)).ty == 0 {
            return;
        }
        if op == Phi {
            let b = (*cx.insts.add(v as usize)).block;
            let mut state = Lattice::Top;
            let mut value: i64 = 0;
            for i in 0..(*cx.insts.add(v as usize)).nargs {
                let p = (*(*cx.blocks.add(b as usize)).preds.data.add(i as usize));
                if !edge_executable(cx, p, b) {
                    continue;
                }
                let operand = ir_arg(cx, v, i);
                let s = lat_of(cx, operand);
                if s == Lattice::Bottom {
                    state = Lattice::Bottom;
                    break;
                }
                if s == Lattice::Const {
                    if state == Lattice::Const && value != lat_value(cx, operand) {
                        state = Lattice::Bottom;
                        break;
                    }
                    state = Lattice::Const;
                    value = lat_value(cx, operand);
                }
            }
            lat_set(cx, v, state, value);
            return;
        }
        if !is_foldable_op(op) {
            lat_set(cx, v, Lattice::Bottom, 0);
            return;
        }
        if op == Const {
            lat_set(cx, v, Lattice::Const, (*cx.insts.add(v as usize)).imm);
            return;
        }
        let a = (*cx.insts.add(v as usize)).a;
        let b = (*cx.insts.add(v as usize)).b;
        let sa = lat_of(cx, a);
        let sb = if b != 0 { lat_of(cx, b) } else { Lattice::Const };
        if sa == Lattice::Bottom || sb == Lattice::Bottom {
            lat_set(cx, v, Lattice::Bottom, 0);
        } else if sa == Lattice::Const && sb == Lattice::Const {
            let lat_value_v = lat_value(cx, a);
            let arg_v: i64 = if b != 0 { lat_value(cx, b) } else { 0 };
            let fold_value_v = fold_value(cx, v, lat_value_v,
                arg_v);
            lat_set(cx, v, Lattice::Const,
                fold_value_v);
        }
    }
}

fn sccp_terminator(cx: &mut FnCtx, b: i64) {
    unsafe {
        let term = (*cx.blocks.add(b as usize)).term;
        if term == Term::Jump {
            mark_edge(cx, b, 0);
        } else if term == Term::Switch {
            let cond = (*cx.blocks.add(b as usize)).cond;
            let s = lat_of(cx, cond);
            if s == Lattice::Bottom {
                for k in 0..(*cx.blocks.add(b as usize)).nsucc {
                    mark_edge(cx, b, k);
                }
            } else if s == Lattice::Const {
                let lat_value_v = lat_value(cx, cond);
                let target = switch_target(cx, b, lat_value_v);
                for k in 0..(*cx.blocks.add(b as usize)).nsucc {
                    if succ(cx, b, k) == target {
                        mark_edge(cx, b, k);
                    }
                }
            }
        } else if term == Term::Branch {
            let cond = (*cx.blocks.add(b as usize)).cond;
            let s = lat_of(cx, cond);
            if s == Lattice::Bottom {
                mark_edge(cx, b, 0);
                mark_edge(cx, b, 1);
            } else if s == Lattice::Const {
                let arg_v: i64 = if lat_value(cx, cond) != 0 { 0 } else { 1 };
                mark_edge(cx, b, arg_v);
            }
        }
    }
}

pub fn sccp(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        build_users(cx, fi);
        let n = cx.fn_values.count;
        free(cx.lat as *mut u8);
        free(cx.lat_value as *mut u8);
        cx.lat = alloc_array::<Lattice>(n + 1);
        cx.lat_value = alloc_array::<i64>(n + 1);
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            (*cx.blocks.add(b as usize)).aux = 0;
            (*cx.blocks.add(b as usize)).mark = 0;
        }
        cx.ssa_work.count = 0;
        cx.cfg_work.count = 0;
        cx.cfg_work.push((*get_irfuncs().add(fi as usize)).entry);
        while cx.cfg_work.count > 0 || cx.ssa_work.count > 0 {
            if cx.cfg_work.count > 0 {
                let b = cx.cfg_work.pop();
                if (*cx.blocks.add(b as usize)).mark == 0 {
                    (*cx.blocks.add(b as usize)).mark = 1;
                    let mut v = (*cx.blocks.add(b as usize)).first;
                    while v != 0 {
                        sccp_eval(cx, v);
                        v = (*cx.insts.add(v as usize)).next;
                    }
                    sccp_terminator(cx, b);
                } else {
                    // A new edge into a visited block: its phis may change.
                    let mut v = (*cx.blocks.add(b as usize)).first;
                    while v != 0 && (*cx.insts.add(v as usize)).op == Phi {
                        sccp_eval(cx, v);
                        v = (*cx.insts.add(v as usize)).next;
                    }
                }
                continue;
            }
            let v = cx.ssa_work.pop();
            let t = (*cx.insts.add(v as usize)).aux - 1;
            for i in (*cx.user_start.add(t as usize))..(*cx.user_start.add((t + 1) as usize)) {
                let user = (*cx.user_list.add(i as usize));
                if user < 0 {
                    if (*cx.blocks.add((0 - user) as usize)).mark != 0 {
                        sccp_terminator(cx, 0 - user);
                    }
                }
                else if (*cx.blocks.add((*cx.insts.add(user as usize)).block as usize)).mark != 0 {
                    sccp_eval(cx, user);
                }
            }
        }
        sccp_rewrite(cx, fi, pcx)
    }
}

// Replaces the values found constant, and the branches decided.
fn sccp_rewrite(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut changed = false;
        ir_enter(cx, fi, pcx);
        for i in 0..cx.fn_values.count {
            let v = (*cx.fn_values.data.add(i as usize));
            let op = (*cx.insts.add(v as usize)).op;
            if (*cx.lat.add(i as usize)) != Lattice::Const || op == Const
                || (*cx.insts.add(v as usize)).block == 0 {
                continue;
            }
            if (*cx.blocks.add((*cx.insts.add(v as usize)).block as usize)).mark == 0 {
                continue;
            }
            let value = (*cx.lat_value.add(i as usize));
            // A NaN made by float arithmetic stays computed at run time (see
            // fold_makes_nan); what depends on it alone (its comparisons, its
            // conversions to integers) is folded all the same.
            if is_float((*cx.insts.add(v as usize)).ty)
                && f64_of_bits(value) != f64_of_bits(value) {
                continue;
            }
            if op == Phi {
                let c = ir_make(cx, Const, (*cx.insts.add(v as usize)).ty, 0, 0, value, pcx);
                ir_prepend(cx, (*get_irfuncs().add(fi as usize)).entry, c);
                ir_replace(cx, v, c);
            } else {
                (*cx.insts.add(v as usize)).op = Const;
                (*cx.insts.add(v as usize)).cond = Cond::Eq;
                (*cx.insts.add(v as usize)).imm = value;
                (*cx.insts.add(v as usize)).a = 0;
                (*cx.insts.add(v as usize)).b = 0;
                (*cx.insts.add(v as usize)).imm2 = 0;
            }
            changed = true;
        }
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 || (*cx.blocks.add(b as usize)).mark == 0 {
                continue;
            }
            if (*cx.blocks.add(b as usize)).term == Term::Switch
                && (*cx.blocks.add(b as usize)).nsucc < 62 {
                // One successor reached only: a jump.
                let mut taken: i64 = 0;
                let mut reached: i64 = 0;
                for k in 0..(*cx.blocks.add(b as usize)).nsucc {
                    if ((*cx.blocks.add(b as usize)).aux >> k as u64) & 1 != 0 {
                        taken = succ(cx, b, k);
                        reached += 1;
                    }
                }
                if reached == 1 {
                    switch_to_jump(cx, b, taken);
                    changed = true;
                }
                continue;
            }
            if (*cx.blocks.add(b as usize)).term != Term::Branch {
                continue;
            }
            let bits = (*cx.blocks.add(b as usize)).aux;
            if bits == 1 || bits == 2 {
                // One edge is never taken.
                let taken = if bits == 1 { (*cx.blocks.add(b as usize)).s0 }
                    else { (*cx.blocks.add(b as usize)).s1 };
                let dropped = if bits == 1 { (*cx.blocks.add(b as usize)).s1 }
                    else { (*cx.blocks.add(b as usize)).s0 };
                // One edge goes (even when both lead to the same block).
                remove_pred(cx, dropped, b);
                (*cx.blocks.add(b as usize)).term = Term::Jump;
                (*cx.blocks.add(b as usize)).cond = 0;
                (*cx.blocks.add(b as usize)).s0 = taken;
                (*cx.blocks.add(b as usize)).s1 = 0;
                changed = true;
            }
        }
        if changed {
            resolve_all(cx, fi);
            remove_unreachable(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
        }
        changed
    }
}
