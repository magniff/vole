// Profile-guided optimization (0.10): instrumentation (`--profile-generate
// FILE`) and its use (`--profile-use FILE`).
//
// Both work on the IR just after lowering, where a function's blocks are
// exactly what its source makes of them (the same in both compilations):
// its blocks in order (IRFUNCS[fi].blocks) are numbered, and the function
// is identified by its symbol and a checksum of that IR's shape (the
// blocks' instructions' operations and successors).
//
// Instrumentation: a counter per block, incremented where the block
// starts; the counters are an array the runtime (the module __profile,
// whose source is built in below and added to the program) allocates
// when main starts, and writes at exit (atexit) to FILE:
//
//     vole-profile 1
//     fn <symbol> <checksum> <blocks>
//     <count of block 0>
//     ...
//
// Use: the counts of a function whose symbol and checksum match are its
// blocks' BLOCKS[b].count (-1: unknown, for blocks without a profile and
// those made later); a function whose checksum differs (its source
// changed since) keeps no counts, with a warning. The passes read the
// counts as hints (layout.vl, inline.vl, scev.vl); those that copy
// blocks keep them (scaled when inlining).

use crate::base::{
    IntVec, buf_byte, buf_int, buf_len, buf_new, buf_ptr, buf_slice, buf_str, buf_truncate,
    buf_uint, buf_zeros, intern_c, sym_name,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::report_warning;
use crate::front::lexer::add_string;
use crate::front::types::{TY_I64, TY_U64, TY_U8, ptr_to};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, get_irfuncs, ir_append, ir_enter, ir_insert_before, ir_make};
use crate::middle::ir::cfg::{succ, succ_count};

extern "C" {
    fn fopen(path: *mut u8, mode: *mut u8) -> *mut u8;
    fn fread(buf: *mut u8, size: u64, count: u64, file: *mut u8) -> u64;
    fn fclose(file: *mut u8) -> i32;
}

// The runtime: started first in main, it writes the profile at exit.
pub fn profile_runtime_source(out: i64) {
    buf_str(out, c"// The profile runtime (0.10): see compiler/src/profile.vl.\n");
    buf_str(out, c"extern \"C\" {\n");
    buf_str(out, c"    fn calloc(count: u64, size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn fopen(path: *const u8, mode: *const u8) -> *mut u8;\n");
    buf_str(out, c"    fn fprintf(file: *mut u8, format: *const u8, ...) -> i32;\n");
    buf_str(out, c"    fn fclose(file: *mut u8) -> i32;\n");
    buf_str(out, c"    fn atexit(f: extern \"C\" fn()) -> i32;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub static mut COUNTERS: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut PATH: *const u8 = 0 as *const u8;\n");
    buf_str(out, c"static mut META: *const u8 = 0 as *const u8;\n");
    buf_str(out, c"pub unsafe fn start(n: i64, path: *const u8, meta: *const u8) {\n");
    buf_str(out, c"    COUNTERS = calloc(n as u64 + 1, 8) as *mut u64;\n");
    buf_str(out, c"    PATH = path;\n");
    buf_str(out, c"    META = meta;\n");
    buf_str(out, c"    atexit(dump);\n");
    buf_str(out, c"}\n");
    buf_str(out, c"extern \"C\" fn dump() {\n");
    buf_str(out, c"    unsafe {\n");
    buf_str(out, c"        let f = fopen(PATH, c\"w\");\n");
    buf_str(out, c"        if f == 0 as *mut u8 {\n");
    buf_str(out, c"            return;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        fprintf(f, c\"vole-profile 1\\n\");\n");
    buf_str(out, c"        let mut at: usize = 0;\n");
    buf_str(out, c"        let mut k: usize = 0;\n");
    buf_str(out, c"        while *META.add(at) != 0 {\n");
    buf_str(out, c"            let line = at;\n");
    buf_str(out, c"            while *META.add(at) != b'\\n' {\n");
    buf_str(out, c"                at += 1;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            let mut j = at;\n");
    buf_str(out, c"            while *META.add(j - 1) != b' ' {\n");
    buf_str(out, c"                j -= 1;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            let mut blocks = 0;\n");
    buf_str(out, c"            for q in j..at {\n");
    buf_str(out, c"                blocks = blocks * 10 + (*META.add(q) - b'0') as i64;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            fprintf(f, c\"%.*s\\n\", (at - line) as i32, META.add(line));\n");
    buf_str(out, c"            for _ in 0..blocks {\n");
    buf_str(out, c"                fprintf(f, c\"%llu\\n\", *COUNTERS.add(k));\n");
    buf_str(out, c"                k += 1;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            at += 1;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        fclose(f);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
}

// Whether IR function fi takes part (the runtimes' own functions do not:
// --check-unsafe's run before the counters are made).
fn profiled(fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let m = pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].module;
        (m != pcx.profile_module || pcx.profile_module < 0)
            && (m != pcx.check_module || m < 0)
    }
}

// The checksum of IR function fi's shape: per block (in order), its
// instructions' operations, its terminator and its successors' positions.
fn checksum(cx: &mut FnCtx<Comp>, fi: i64) -> u64 {
    unsafe {
        let n = (*get_irfuncs().add(fi as usize)).blocks.len() as i64;
        for i in 0..n {
            (cx.blocks[((*get_irfuncs().add(fi as usize)).blocks[i as usize]) as usize]).aux = i;
        }
        let mut h: u64 = 1469598103934665603;
        h = (h ^ n as u64).wrapping_mul(1099511628211u64);
        for i in 0..n {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                h = (h ^ (cx.insts[v as usize]).op as u64).wrapping_mul(1099511628211u64);
                v = (cx.insts[v as usize]).next;
            }
            h = (h ^ (100 + (cx.blocks[b as usize]).term as i64) as u64).wrapping_mul(
                1099511628211u64);
            for k in 0..succ_count(cx, b) {
                h = (h
                    ^ (1000 + { let at_ix = succ(cx, b, k) as usize; cx.blocks[at_ix].aux }) as u64).wrapping_mul(
                        1099511628211u64);
            }
        }
        h
    }
}

// The first instruction of block b after its phis and parameters (0: none).
fn body_start(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    unsafe {
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0
            && ((cx.insts[v as usize]).op == Op::Phi
                || (cx.insts[v as usize]).op == Op::Param) {
            v = (cx.insts[v as usize]).next;
        }
        v
    }
}

fn make(cx: &mut FnCtx<Comp>, op: Op, ty: i64, a: i64, x: i64, imm: i64, pcx: &Ctx<Comp>) -> i64 {
    ir_make(cx, op, ty, a, x, imm, pcx)
}

// Counter `k`'s increment, at the start of block b.
fn count_block(cx: &mut FnCtx<Comp>, b: i64, k: i64, counters: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let g = make(cx, Op::GAddr, TY_U64, 0, 0, counters, pcx);
        let p = make(cx, Op::Load, TY_U64, g, 0, 0, pcx);
        let off = make(cx, Op::Const, TY_U64, 0, 0, 8 * k, pcx);
        let a = make(cx, Op::Add, TY_U64, p, off, 0, pcx);
        let c = make(cx, Op::Load, TY_U64, a, 0, 0, pcx);
        let one = make(cx, Op::Const, TY_U64, 0, 0, 1, pcx);
        let c1 = make(cx, Op::Add, TY_U64, c, one, 0, pcx);
        let s = make(cx, Op::Store, 0, a, c1, 0, pcx);
        (cx.insts[s as usize]).imm2 = TY_U64;
        let list: [i64; 8] = [g, p, off, a, c, one, c1, s];
        let at = body_start(cx, b);
        for i in 0..8 {
            if at == 0 {
                ir_append(cx, b, list[i as usize]);
            } else {
                ir_insert_before(cx, at, list[i as usize]);
            }
        }
    }
}

fn function_name(fi: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    unsafe { sym_name(pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].name, pcx) }
}

// A function's name in a profile: its spaces (a generic instance's tuple
// types have some) written as `~`.
fn name_char(c: u8) -> u8 {
    if c == b' ' { b'~' } else { c }
}

fn buf_name(out: i64, name: *mut u8) {
    unsafe {
        let mut i: i64 = 0;
        while (*name.add(i as usize)) != 0 {
            buf_byte(out, name_char((*name.add(i as usize))));
            i += 1;
        }
    }
}

// --profile-generate: the counters, and the runtime's start in main.
fn instrument(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let counters = intern_c(c"__profile.COUNTERS", pcx);
        let start = ({ let at_ix = intern_c(c"__profile::start", pcx) as usize; pcx.sym_fn[at_ix] }) - 1;
        if (pcx.sym_static[counters as usize]) == 0 || start < 0 {
            return;
        }
        // (Without main, nothing would start the runtime: no counters.)
        let mut main: i64 = -1;
        for fi in 0..pcx.irfunc_count {
            if profiled(fi, pcx)
                && pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].name == pcx.main_sym {
                main = fi;
            }
        }
        if main < 0 {
            return;
        }
        let meta = buf_new();
        let mut total: i64 = 0;
        for fi in 0..pcx.irfunc_count {
            if !profiled(fi, pcx) {
                continue;
            }
            ir_enter(cx, fi, pcx);
            let n = (*get_irfuncs().add(fi as usize)).blocks.len() as i64;
            buf_str(meta, c"fn ");
            buf_name(meta, function_name(fi, pcx));
            buf_byte(meta, b' ');
            buf_uint(meta, checksum(cx, fi));
            buf_byte(meta, b' ');
            buf_int(meta, n);
            buf_byte(meta, b'\n');
            for i in 0..n {
                count_block(cx, ((*get_irfuncs().add(fi as usize)).blocks[i as usize]),
                    total + i, counters, pcx);
            }
            total += n;
        }
        let meta_id = add_string(
            buf_slice(meta));
        let path = buf_new();
        buf_str(path, pcx.profile_generate);
        let path_id = add_string(
            buf_slice(path));
        // start(total, path, meta), before the entry's counter.
        ir_enter(cx, main, pcx);
        let entry = (*get_irfuncs().add(main as usize)).entry;
        let n = make(cx, Op::Const, TY_I64, 0, 0, total, pcx);
        let p = make(cx, Op::SAddr, TY_U64, 0, 0, path_id, pcx);
        let m = make(cx, Op::SAddr, TY_U64, 0, 0, meta_id, pcx);
        let call = make(cx, Op::Call, 0, 0, 0, start, pcx);
        (cx.insts[call as usize]).args = cx.args.len() as i64;
        (cx.insts[call as usize]).nargs = 3;
        let str_ty = ptr_to(TY_U8, pcx);
        cx.args.push(n);
        cx.argty.push(TY_I64);
        cx.args.push(p);
        cx.argty.push(str_ty);
        cx.args.push(m);
        cx.argty.push(str_ty);
        let list: [i64; 4] = [n, p, m, call];
        let at = body_start(cx, entry);
        for i in 0..4 {
            if at == 0 {
                ir_append(cx, entry, list[i as usize]);
            } else {
                ir_insert_before(cx, at, list[i as usize]);
            }
        }
    }
}

// ---- Reading a profile ----

fn pf_char(pcx: &Ctx<Comp>) -> u8 {
    unsafe { if pcx.pf_at < pcx.pf_len { (*pcx.pf_text.add(pcx.pf_at as usize)) } else { 0 } }
}

// The next word of the line (up to a space or the end of the line).
fn pf_word(start: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    while pf_char(pcx) == b' ' {
        pcx.pf_at += 1;
    }
    *start = pcx.pf_at;
    while pcx.pf_at < pcx.pf_len && pf_char(pcx) != b' ' && pf_char(pcx) != b'\n' {
        pcx.pf_at += 1;
    }
    pcx.pf_at - *start
}

fn pf_number(pcx: &mut Ctx<Comp>) -> u64 {
    let mut s: i64 = 0;
    let n = pf_word(&mut s, pcx);
    let mut x: u64 = 0;
    for i in 0..n {
        let c = unsafe { (*pcx.pf_text.add((s + i) as usize)) };
        if c >= b'0' && c <= b'9' {
            x = x * 10 + (c - b'0') as u64;
        }
    }
    x
}

fn pf_next_line(pcx: &mut Ctx<Comp>) {
    while pcx.pf_at < pcx.pf_len && pf_char(pcx) != b'\n' {
        pcx.pf_at += 1;
    }
    pcx.pf_at += 1;
}

// Whether the word at [s, s + n) is the C string `name` (as buf_name
// writes it).
fn word_is(s: i64, n: i64, name: *mut u8, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        for i in 0..n {
            if (*name.add(i as usize)) == 0
                || (*pcx.pf_text.add((s + i) as usize)) != name_char((*name.add(i as usize))) {
                return false;
            }
        }
        (*name.add(n as usize)) == 0
    }
}

// --profile-use: the counts of the functions whose profile matches.
fn annotate(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let file = fopen(pcx.profile_use, c"rb");
        if file == 0 as *mut u8 {
            report_warning(0, 1, c"profile", c"cannot read the profile: no counts used",
                0 as *mut u8, pcx);
            return;
        }
        let text = buf_new();
        loop {
            let at = buf_zeros(text, 65536);
            let got = fread(buf_ptr(text).add(at as usize), 1, 65536, file);
            buf_truncate(text, at + got as i64);
            if got == 0 {
                break;
            }
        }
        fclose(file);
        pcx.pf_text = buf_ptr(text);
        pcx.pf_len = buf_len(text);
        pcx.pf_at = 0;
        let mut s: i64 = 0;
        let n = pf_word(&mut s, pcx);
        if !word_is(s, n, c"vole-profile", pcx) || pf_number(pcx) != 1 {
            report_warning(0, 2, c"profile", c"not a vole profile (version 1): no counts used",
                0 as *mut u8, pcx);
            return;
        }
        pf_next_line(pcx);
        // The functions, by name: (name start, length, checksum, blocks, first
        // count's position) per function.
        let mut fns = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        while pcx.pf_at < pcx.pf_len {
            let mut ws: i64 = 0;
            let wn = pf_word(&mut ws, pcx);
            if !word_is(ws, wn, c"fn", pcx) {
                pf_next_line(pcx);
                continue;
            }
            let mut ns: i64 = 0;
            let nn = pf_word(&mut ns, pcx);
            let sum = pf_number(pcx);
            let blocks = pf_number(pcx) as i64;
            pf_next_line(pcx);
            fns.push(ns);
            fns.push(nn);
            fns.push(sum as i64);
            fns.push(blocks);
            fns.push(pcx.pf_at);
            for _ in 0..blocks {
                pf_next_line(pcx);
            }
        }
        for fi in 0..pcx.irfunc_count {
            ir_enter(cx, fi, pcx);
            let name = function_name(fi, pcx);
            let mut k: i64 = 0;
            while k < fns.len() as i64 {
                if word_is((fns[k as usize]), (fns[(k + 1) as usize]), name,
                    pcx) {
                    break;
                }
                k += 5;
            }
            if k >= fns.len() as i64 {
                continue;
            }
            let n = (*get_irfuncs().add(fi as usize)).blocks.len() as i64;
            if (fns[(k + 2) as usize]) as u64 != checksum(cx, fi)
                || (fns[(k + 3) as usize]) != n {
                let message = buf_new();
                buf_str(message, c"the profile of '");
                buf_str(message, name);
                buf_str(message, c"' is stale (the function changed since it was made): ignored");
                buf_byte(message, 0);
                report_warning(
                    pcx.nodes[pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].node as usize].start, 3, c"profile",
                    buf_ptr(message),
                    c"make the profile again with --profile-generate", pcx);
                continue;
            }
            pcx.pf_at = (fns[(k + 4) as usize]);
            for i in 0..n {
                let count = pf_number(pcx);
                pf_next_line(pcx);
                let c: i64 = if count > 1099511627776 { 1099511627776 } else { count as i64 };
                (cx.blocks[((*get_irfuncs().add(fi as usize)).blocks[i as usize]) as usize]).count = c;
                if c > pcx.profile_max {
                    pcx.profile_max = c;
                }
            }
        }
    }
}

// After lowering: instruments the functions, or reads their counts.
pub fn profile_after_lowering(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.profile_generate != 0 as *mut u8 {
        instrument(cx, pcx);
    }
    if pcx.profile_use != 0 as *mut u8 {
        annotate(cx, pcx);
    }
}

// Whether a block that ran `count` times is hot: a 32nd of the most run
// block, and 64 times at least.
pub fn is_hot_count(count: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.profile_max > 0 && count >= 64 && count >= pcx.profile_max / 32
}

// Whether block b never ran (in a function with a profile).
pub fn is_cold_block(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { pcx.profile_max > 0 && (cx.blocks[b as usize]).count == 0 }
}
