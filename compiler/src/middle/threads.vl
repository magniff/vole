// (0.18.1) The code generator's threads: the compiler's one binding of
// pthreads, and its only code that runs on more than one thread without
// a context of its own (docs/optimizer.md, "0.18.1: threads"). std's
// concurrency is 0.21's; this is the smallest island that runs
// middle::parallel's tasks.
//
// A pool of POOL_THREADS - 1 workers beside the main thread, made at the
// first parallel phase and kept to the end of code generation. Each
// thread has its own FnCtx (POOL_CTX[i], made by the main thread before
// the workers start; index 0 is the main thread's). A phase hands the
// pool its tasks, which can all start; the threads, the main thread too,
// take them and run them (parallel::run_task) until all are done; in a
// joined phase (pool_run_joined) the main thread also hands each done
// task, in order, to parallel::join_task. Everything the threads share
// here is read and written with MUTEX held: READY, REMAINING, PHASE_KIND,
// STOP, JOINED. A task's results (its function's IR, its text, its facts)
// are written before its thread takes MUTEX to count it done, and read by
// the main thread after it saw, holding MUTEX, the count reach 0 or the
// task marked joined; the next phase's tasks are handed over under MUTEX
// too; so they are ordered (the mutex's release and acquire). -j1, or a
// program with few functions, makes no thread: the main thread runs every
// task, in order.

use crate::back::objfile::assemble_bytes;
use crate::base::{IntVec, set_syms_frozen, alloc_zeroed, die, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::{FnCtx, fnctx_new};
use crate::middle::parallel::{join_task, run_task};

extern "C" {
    fn pthread_create(thread: *mut u64, attr: *mut u8, start: extern "C" fn(*mut u8) -> *mut u8, arg: *mut u8) -> i32;
    fn pthread_join(thread: u64, result: *mut u8) -> i32;
    fn pthread_attr_init(attr: *mut u8) -> i32;
    fn pthread_attr_setstacksize(attr: *mut u8, size: u64) -> i32;
    fn pthread_mutex_init(mutex: *mut u8, attr: *mut u8) -> i32;
    fn pthread_mutex_lock(mutex: *mut u8) -> i32;
    fn pthread_mutex_unlock(mutex: *mut u8) -> i32;
    fn pthread_cond_init(cond: *mut u8, attr: *mut u8) -> i32;
    fn pthread_cond_wait(cond: *mut u8, mutex: *mut u8) -> i32;
    fn pthread_cond_broadcast(cond: *mut u8) -> i32;
    fn sysconf(name: i32) -> i64;
}

// Room for a pthread_mutex_t, pthread_cond_t or pthread_attr_t (64, 48
// and 64 bytes on macOS; 48, 48 and 64 on Linux, aarch64).
const PTHREAD_ROOM: i64 = 256;
// A worker's stack (the main thread's is 8 MB by default; the passes
// recurse over dominator trees and expressions).
const STACK_SIZE: i64 = 64 * 1024 * 1024;

// Each thread's context, by index (0: the main thread's tasks').
static mut POOL_CTX: *mut *mut FnCtx = 0 as *mut *mut FnCtx;
// (0.26.5) The compilation context the pool's tasks read, as C's void *
// (a static holds no pointer to a type with an allocator): run_pooled
// lends it to a task let (a view, tools/statics/p5b-ctx.group). pool_run
// and pool_run_joined set it to their own context before the tasks start
// and clear it after the last is done; 0 otherwise.
static mut POOL_PCX: *mut u8 = 0 as *mut u8;

static mut MUTEX: *mut u8 = 0 as *mut u8;
// Broadcast when tasks become ready, when a phase ends and at the stop.
static mut WAKE: *mut u8 = 0 as *mut u8;
static mut READY: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut REMAINING: i64 = 0;
static mut PHASE_KIND: i64 = 0;
static mut STOP: bool = false;

// While a joined phase runs (pool_run_joined): per task, whether it is
// done.
static mut JOINED: *mut bool = 0 as *mut bool;

// The number of processors online (sysconf), at least 1.
pub fn processors(macos: bool) -> i64 {
    // _SC_NPROCESSORS_ONLN
    let n = unsafe { sysconf(if macos { 58 } else { 84 }) };
    if n < 1 { 1 } else { n }
}

// Makes the contexts of `threads` threads and starts the workers (none
// for 1). Main thread only, before the first phase.
pub fn pool_start(threads: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.pool_threads = threads;
        pcx.pool_contexts = threads;
        set_stop(false);
        set_pool_ctx(alloc_zeroed(threads * 8) as *mut *mut FnCtx);
        for i in 0..threads {
            (*get_pool_ctx().add(i as usize)) = fnctx_new();
        }
        if threads == 1 {
            return;
        }
        set_mutex(alloc_zeroed(PTHREAD_ROOM));
        set_wake(alloc_zeroed(PTHREAD_ROOM));
        pthread_mutex_init(get_mutex(), 0 as *mut u8);
        pthread_cond_init(get_wake(), 0 as *mut u8);
        let attr = alloc_zeroed(PTHREAD_ROOM);
        pthread_attr_init(attr);
        pthread_attr_setstacksize(attr, STACK_SIZE as u64);
        pcx.threads = alloc_zeroed(threads * 8) as *mut u64;
        for i in 1..threads {
            if pthread_create(pcx.threads.add(i as usize), attr, worker_main, i as *mut u8) != 0 {
                die(c"cannot start a code generation thread (try -j1)");
            }
        }
    }
}

// Stops the workers and waits for them. Main thread only, between phases.
pub fn pool_stop(pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.pool_threads <= 1 {
            return;
        }
        pthread_mutex_lock(get_mutex());
        set_stop(true);
        pthread_cond_broadcast(get_wake());
        pthread_mutex_unlock(get_mutex());
        for i in 1..pcx.pool_threads {
            pthread_join((*pcx.threads.add(i as usize)), 0 as *mut u8);
        }
        pcx.pool_threads = 1;
    }
}

// Runs a phase's tasks (all can start), the last of `tasks` first;
// returns when all are done. With one thread the main thread runs them.
pub fn pool_run(kind: i64, tasks: IntVec, pcx: &Ctx<Comp>) {
    unsafe {
        set_syms_frozen(true);
        // (the tasks' view of the context, run_pooled's: cleared below,
        // when they are all done)
        set_pool_pcx(pcx as *mut Ctx<Comp> as *mut u8);
        if pcx.pool_threads == 1 {
            let mut i = tasks.count;
            while i > 0 {
                i -= 1;
                run_task((*get_pool_ctx().add(0)), kind, (*tasks.data.add(i as usize)), pcx);
            }
            set_syms_frozen(false);
            set_pool_pcx(0 as *mut u8);
            return;
        }
        pthread_mutex_lock(get_mutex());
        set_phase_kind(kind);
        { let mut ready_copy = get_ready(); ready_copy.count = 0; set_ready(ready_copy); }
        for i in 0..tasks.count {
            { let mut ready_copy = get_ready(); ready_copy.push((*tasks.data.add(i as usize))); set_ready(ready_copy); }
        }
        set_remaining(tasks.count);
        pthread_cond_broadcast(get_wake());
        take_tasks(0);
        pthread_mutex_unlock(get_mutex());
        set_syms_frozen(false);
        set_pool_pcx(0 as *mut u8);
    }
}

// Runs a phase's tasks as pool_run does, task i being ITEMS' position i
// in first..end, while the main thread hands each done task to
// parallel::join_task in the order first, first + 1, ..., as soon as it
// and those before it are done (the join of emission, which assembles the
// texts in program order); while the next is not done it runs a task
// itself, if one is left. Returns the first task not joined: join_task
// may refuse one (it must wait for the phase's end), and the rest are the
// caller's to join after.
pub fn pool_run_joined(kind: i64, tasks: IntVec, first: i64, end: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        set_syms_frozen(true);
        // (the tasks' view of the context, run_pooled's: cleared below,
        // when they are all done)
        set_pool_pcx(pcx as *mut Ctx<Comp> as *mut u8);
        pthread_mutex_lock(get_mutex());
        set_phase_kind(kind);
        { let mut ready_copy = get_ready(); ready_copy.count = 0; set_ready(ready_copy); }
        for i in 0..tasks.count {
            { let mut ready_copy = get_ready(); ready_copy.push((*tasks.data.add(i as usize))); set_ready(ready_copy); }
        }
        set_remaining(tasks.count);
        set_joined(alloc_zeroed(end + 1) as *mut bool);
        pthread_cond_broadcast(get_wake());
        let mut next = first;
        let mut joining = true;
        while joining && next < end {
            if (*get_joined().add(next as usize)) {
                // (its task wrote its results before it took MUTEX to mark it)
                pthread_mutex_unlock(get_mutex());
                joining = join_task(next, pcx);
                pthread_mutex_lock(get_mutex());
                if joining {
                    next += 1;
                }
            } else if get_ready().count > 0 {
                let task = { let mut ready_copy = get_ready(); let r_copy = ready_copy.pop(); set_ready(ready_copy); r_copy };
                pthread_mutex_unlock(get_mutex());
                run_task((*get_pool_ctx().add(0)), kind, task, pcx);
                pthread_mutex_lock(get_mutex());
                set_remaining(get_remaining() - (1));
                (*get_joined().add(task as usize)) = true;
                pthread_cond_broadcast(get_wake());
            } else {
                pthread_cond_wait(get_wake(), get_mutex());
            }
        }
        // (the tasks left, refused by the join: done by every thread)
        pthread_mutex_unlock(get_mutex());
        loop {
            pthread_mutex_lock(get_mutex());
            if get_ready().count == 0 {
                break;
            }
            let task = { let mut ready_copy = get_ready(); let r_copy = ready_copy.pop(); set_ready(ready_copy); r_copy };
            pthread_mutex_unlock(get_mutex());
            run_task((*get_pool_ctx().add(0)), kind, task, pcx);
            pthread_mutex_lock(get_mutex());
            set_remaining(get_remaining() - (1));
            (*get_joined().add(task as usize)) = true;
            pthread_cond_broadcast(get_wake());
            pthread_mutex_unlock(get_mutex());
        }
        while get_remaining() > 0 {
            pthread_cond_wait(get_wake(), get_mutex());
        }
        free(get_joined() as *mut u8);
        set_joined(0 as *mut bool);
        pthread_mutex_unlock(get_mutex());
        set_syms_frozen(false);
        set_pool_pcx(0 as *mut u8);
        next
    }
}

// Task `task` of a phase of kind `kind`, on the pool's thread context
// cx, given the pool's view of the compilation context.
fn run_pooled(cx: *mut FnCtx, kind: i64, task: i64) {
    // UNSAFE: a worker thread has no parameter to be lent the compilation
    // context through: pthread_create passes only a void *, and the pool's
    // threads outlive one phase, so the context of the phase that runs is
    // reached through POOL_PCX.
    // SAFETY: POOL_PCX is set while a phase's tasks run, to the context of
    // the pool_run or pool_run_joined that started them, which waits for
    // all of them before it clears it and returns: it points to a live
    // Ctx<Comp>. The task takes it let and writes nothing through it; the
    // main thread does not change it while the tasks run either: pool_run
    // holds it let, and pool_run_joined changes it only in join_task, whose
    // writes are of fields no running task touches (tests/threads_writes.sh,
    // JOINED). So no task reads a field while it changes.
    unsafe {
        run_task(cx, kind, task, &*(get_pool_pcx() as *mut Ctx<Comp>));
    }
}

// A thread's loop over the ready tasks, MUTEX held (released while a
// task runs). The main thread (index 0) returns when the phase is done;
// a worker when the pool stops.
fn take_tasks(index: i64) {
    unsafe {
        let cx = (*get_pool_ctx().add(index as usize));
        loop {
            while get_ready().count == 0 && !(index == 0 && get_remaining() == 0) && !get_stop() {
                pthread_cond_wait(get_wake(), get_mutex());
            }
            if get_ready().count == 0 {
                return;
            }
            let task = { let mut ready_copy = get_ready(); let r_copy = ready_copy.pop(); set_ready(ready_copy); r_copy };
            let kind = get_phase_kind();
            pthread_mutex_unlock(get_mutex());
            run_pooled(cx, kind, task);
            pthread_mutex_lock(get_mutex());
            set_remaining(get_remaining() - (1));
            if get_joined() != 0 as *mut bool {
                (*get_joined().add(task as usize)) = true;
                pthread_cond_broadcast(get_wake());
            } else if get_remaining() == 0 {
                pthread_cond_broadcast(get_wake());
            }
        }
    }
}

// A worker thread: its index is its argument.
extern "C" fn worker_main(arg: *mut u8) -> *mut u8 {
    unsafe {
        pthread_mutex_lock(get_mutex());
        take_tasks(arg as i64);
        pthread_mutex_unlock(get_mutex());
    }
    0 as *mut u8
}

// ---- The assembler's thread ----

static mut A_MUTEX: *mut u8 = 0 as *mut u8;
static mut A_WAKE: *mut u8 = 0 as *mut u8;
static mut A_QUEUE: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut A_HEAD: i64 = 0;
static mut A_STOP: bool = false;
static mut A_CTX: *mut FnCtx = 0 as *mut FnCtx;

pub fn asm_thread_start(pcx: &mut Ctx<Comp>) {
    unsafe {
        set_a_ctx(fnctx_new());
        // (the growth mode, read once, before the thread reads it)
        crate::base::stress_grow();
        set_a_mutex(alloc_zeroed(PTHREAD_ROOM));
        set_a_wake(alloc_zeroed(PTHREAD_ROOM));
        pthread_mutex_init(get_a_mutex(), 0 as *mut u8);
        pthread_cond_init(get_a_wake(), 0 as *mut u8);
        { let mut a_queue_copy = get_a_queue(); a_queue_copy.count = 0; set_a_queue(a_queue_copy); }
        set_a_head(0);
        set_a_stop(false);
        let attr = alloc_zeroed(PTHREAD_ROOM);
        pthread_attr_init(attr);
        pthread_attr_setstacksize(attr, STACK_SIZE as u64);
        if pthread_create(&mut pcx.a_thread, attr, asm_thread_main, 0 as *mut u8) != 0 {
            die(c"cannot start the assembler's thread (try -j1)");
        }
    }
}

// Hands text[0..n] (malloc'd; the thread frees it) to the assembler.
pub fn asm_thread_push(text: *mut u8, n: i64) {
    unsafe {
        pthread_mutex_lock(get_a_mutex());
        { let mut a_queue_copy = get_a_queue(); a_queue_copy.push(text as i64); set_a_queue(a_queue_copy); }
        { let mut a_queue_copy = get_a_queue(); a_queue_copy.push(n); set_a_queue(a_queue_copy); }
        pthread_cond_broadcast(get_a_wake());
        pthread_mutex_unlock(get_a_mutex());
    }
}

// Waits until the assembler has taken every text, and stops it.
pub fn asm_thread_finish(pcx: &Ctx<Comp>) {
    unsafe {
        pthread_mutex_lock(get_a_mutex());
        set_a_stop(true);
        pthread_cond_broadcast(get_a_wake());
        pthread_mutex_unlock(get_a_mutex());
        pthread_join(pcx.a_thread, 0 as *mut u8);
    }
}

extern "C" fn asm_thread_main(arg: *mut u8) -> *mut u8 {
    unsafe {
        pthread_mutex_lock(get_a_mutex());
        loop {
            while get_a_head() == get_a_queue().count && !get_a_stop() {
                pthread_cond_wait(get_a_wake(), get_a_mutex());
            }
            if get_a_head() == get_a_queue().count {
                break;
            }
            let text = (*get_a_queue().data.add(get_a_head() as usize)) as *mut u8;
            let n = (*get_a_queue().data.add((get_a_head() + 1) as usize));
            set_a_head(get_a_head() + (2));
            pthread_mutex_unlock(get_a_mutex());
            assemble_bytes(&mut *get_a_ctx(), text, n);
            free(text);
            pthread_mutex_lock(get_a_mutex());
        }
        pthread_mutex_unlock(get_a_mutex());
    }
    0 as *mut u8
}

// (0.28.0) POOL_CTX's accessors: every use of it is one of them.
pub fn get_pool_ctx() -> *mut *mut FnCtx {
    // UNSAFE: the per-thread context table, a process-wide static mut the
    // main thread and the workers read; Rust has no safe access to a static
    // mut
    // SAFETY: the pointer and its elements are written only by pool_start
    // on the main thread before pthread_create starts the workers (create
    // orders them before the workers' reads); after that the table is only
    // read: worker i reads POOL_CTX[i], the main thread POOL_CTX[0]
    // (pool_run, pool_run_joined) and every entry in vec_stat after the
    // phases; each thread uses only its own FnCtx, so no two threads hold
    // the same context mutably
    unsafe { POOL_CTX }
}

pub fn set_pool_ctx(v: *mut *mut FnCtx) {
    // UNSAFE: the per-thread context table, a process-wide static mut the
    // main thread and the workers read; Rust has no safe access to a static
    // mut
    // SAFETY: the pointer and its elements are written only by pool_start
    // on the main thread before pthread_create starts the workers (create
    // orders them before the workers' reads); after that the table is only
    // read: worker i reads POOL_CTX[i], the main thread POOL_CTX[0]
    // (pool_run, pool_run_joined) and every entry in vec_stat after the
    // phases; each thread uses only its own FnCtx, so no two threads hold
    // the same context mutably
    unsafe {
        POOL_CTX = v;
    }
}

// (0.28.0) POOL_PCX's accessors: every use of it is one of them.
fn get_pool_pcx() -> *mut u8 {
    // UNSAFE: the phase's compilation context, published to the workers
    // through a process-wide static mut; Rust has no safe access to a
    // static mut
    // SAFETY: written only by the main thread: set by
    // pool_run/pool_run_joined before it takes MUTEX to fill READY, cleared
    // after it saw REMAINING reach 0 holding MUTEX; a worker reads it only
    // in run_pooled for a task it popped from READY holding MUTEX, so the
    // set happens-before (mutex release/acquire) every read, and every read
    // happens-before the main thread's acquire that sees the count 0, which
    // precedes the clear
    unsafe { POOL_PCX }
}

fn set_pool_pcx(v: *mut u8) {
    // UNSAFE: the phase's compilation context, published to the workers
    // through a process-wide static mut; Rust has no safe access to a
    // static mut
    // SAFETY: written only by the main thread: set by
    // pool_run/pool_run_joined before it takes MUTEX to fill READY, cleared
    // after it saw REMAINING reach 0 holding MUTEX; a worker reads it only
    // in run_pooled for a task it popped from READY holding MUTEX, so the
    // set happens-before (mutex release/acquire) every read, and every read
    // happens-before the main thread's acquire that sees the count 0, which
    // precedes the clear
    unsafe {
        POOL_PCX = v;
    }
}

// (0.28.0) MUTEX's accessors: every use of it is one of them.
fn get_mutex() -> *mut u8 {
    // UNSAFE: the pool's mutex handle, a process-wide static mut the main
    // thread and the workers read; Rust has no safe access to a static mut
    // SAFETY: written once, by pool_start on the main thread
    // (parallel_begin, once per process from optimize_program) before it
    // starts any worker with pthread_create, which orders the write before
    // every worker's read; never written again, so every later access is a
    // read of a value no thread changes; no &mut to it is kept
    unsafe { MUTEX }
}

fn set_mutex(v: *mut u8) {
    // UNSAFE: the pool's mutex handle, a process-wide static mut the main
    // thread and the workers read; Rust has no safe access to a static mut
    // SAFETY: written once, by pool_start on the main thread
    // (parallel_begin, once per process from optimize_program) before it
    // starts any worker with pthread_create, which orders the write before
    // every worker's read; never written again, so every later access is a
    // read of a value no thread changes; no &mut to it is kept
    unsafe {
        MUTEX = v;
    }
}

// (0.28.0) WAKE's accessors: every use of it is one of them.
fn get_wake() -> *mut u8 {
    // UNSAFE: the pool's condition variable handle, a process-wide static
    // mut the main thread and the workers read; Rust has no safe access to
    // a static mut
    // SAFETY: written once, by pool_start on the main thread before the
    // workers' pthread_create (which orders it before their reads); never
    // written after, only read; no &mut kept
    unsafe { WAKE }
}

fn set_wake(v: *mut u8) {
    // UNSAFE: the pool's condition variable handle, a process-wide static
    // mut the main thread and the workers read; Rust has no safe access to
    // a static mut
    // SAFETY: written once, by pool_start on the main thread before the
    // workers' pthread_create (which orders it before their reads); never
    // written after, only read; no &mut kept
    unsafe {
        WAKE = v;
    }
}

// (0.28.0) READY's accessors: every use of it is one of them.
fn get_ready() -> IntVec {
    // UNSAFE: shared pool state (the ready task list), a process-wide
    // static mut; Rust has no safe access to a static mut
    // SAFETY: every access (count reset, push, pop, count test) is made
    // holding MUTEX: pool_run and pool_run_joined fill it after
    // pthread_mutex_lock, take_tasks and pool_run_joined pop it holding
    // MUTEX; no reference to it is kept across an unlock (the popped task
    // is copied out)
    unsafe { READY }
}

fn set_ready(v: IntVec) {
    // UNSAFE: shared pool state (the ready task list), a process-wide
    // static mut; Rust has no safe access to a static mut
    // SAFETY: every access (count reset, push, pop, count test) is made
    // holding MUTEX: pool_run and pool_run_joined fill it after
    // pthread_mutex_lock, take_tasks and pool_run_joined pop it holding
    // MUTEX; no reference to it is kept across an unlock (the popped task
    // is copied out)
    unsafe {
        READY = v;
    }
}

// (0.28.0) REMAINING's accessors: every use of it is one of them.
fn get_remaining() -> i64 {
    // UNSAFE: shared pool state (the phase's undone count), a process-wide
    // static mut; Rust has no safe access to a static mut
    // SAFETY: every read and write holds MUTEX (pool_run, pool_run_joined,
    // take_tasks); the decrement follows the task's run, so the task's
    // writes happen-before the main thread's read of 0
    unsafe { REMAINING }
}

fn set_remaining(v: i64) {
    // UNSAFE: shared pool state (the phase's undone count), a process-wide
    // static mut; Rust has no safe access to a static mut
    // SAFETY: every read and write holds MUTEX (pool_run, pool_run_joined,
    // take_tasks); the decrement follows the task's run, so the task's
    // writes happen-before the main thread's read of 0
    unsafe {
        REMAINING = v;
    }
}

// (0.28.0) PHASE_KIND's accessors: every use of it is one of them.
fn get_phase_kind() -> i64 {
    // UNSAFE: shared pool state, a process-wide static mut; Rust has no
    // safe access to a static mut
    // SAFETY: written by the main thread in pool_run/pool_run_joined only
    // while it holds MUTEX, read by take_tasks only while MUTEX is held:
    // every access is under MUTEX
    unsafe { PHASE_KIND }
}

fn set_phase_kind(v: i64) {
    // UNSAFE: shared pool state, a process-wide static mut; Rust has no
    // safe access to a static mut
    // SAFETY: written by the main thread in pool_run/pool_run_joined only
    // while it holds MUTEX, read by take_tasks only while MUTEX is held:
    // every access is under MUTEX
    unsafe {
        PHASE_KIND = v;
    }
}

// (0.28.0) STOP's accessors: every use of it is one of them.
fn get_stop() -> bool {
    // UNSAFE: shared pool state, a process-wide static mut; Rust has no
    // safe access to a static mut
    // SAFETY: written by pool_start before pthread_create starts the
    // workers and by pool_stop holding MUTEX; read only in take_tasks
    // holding MUTEX
    unsafe { STOP }
}

fn set_stop(v: bool) {
    // UNSAFE: shared pool state, a process-wide static mut; Rust has no
    // safe access to a static mut
    // SAFETY: written by pool_start before pthread_create starts the
    // workers and by pool_stop holding MUTEX; read only in take_tasks
    // holding MUTEX
    unsafe {
        STOP = v;
    }
}

// (0.28.0) JOINED's accessors: every use of it is one of them.
fn get_joined() -> *mut bool {
    // UNSAFE: shared pool state (per task, done), a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: allocated, read, written (JOINED[task] = true) and
    // freed/reset only holding MUTEX: pool_run_joined allocates it before
    // the broadcast and frees it after REMAINING reached 0, both under
    // MUTEX; take_tasks tests and writes it after relocking MUTEX
    unsafe { JOINED }
}

fn set_joined(v: *mut bool) {
    // UNSAFE: shared pool state (per task, done), a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: allocated, read, written (JOINED[task] = true) and
    // freed/reset only holding MUTEX: pool_run_joined allocates it before
    // the broadcast and frees it after REMAINING reached 0, both under
    // MUTEX; take_tasks tests and writes it after relocking MUTEX
    unsafe {
        JOINED = v;
    }
}

// (0.28.0) A_MUTEX's accessors: every use of it is one of them.
fn get_a_mutex() -> *mut u8 {
    // UNSAFE: the assembler queue's mutex handle, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: written once by asm_thread_start before pthread_create;
    // afterwards only read (asm_thread_push, asm_thread_finish on the main
    // thread, asm_thread_main)
    unsafe { A_MUTEX }
}

fn set_a_mutex(v: *mut u8) {
    // UNSAFE: the assembler queue's mutex handle, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: written once by asm_thread_start before pthread_create;
    // afterwards only read (asm_thread_push, asm_thread_finish on the main
    // thread, asm_thread_main)
    unsafe {
        A_MUTEX = v;
    }
}

// (0.28.0) A_WAKE's accessors: every use of it is one of them.
fn get_a_wake() -> *mut u8 {
    // UNSAFE: the assembler queue's condition variable handle, a
    // process-wide static mut; Rust has no safe access to a static mut
    // SAFETY: written once by asm_thread_start before pthread_create;
    // afterwards only read
    unsafe { A_WAKE }
}

fn set_a_wake(v: *mut u8) {
    // UNSAFE: the assembler queue's condition variable handle, a
    // process-wide static mut; Rust has no safe access to a static mut
    // SAFETY: written once by asm_thread_start before pthread_create;
    // afterwards only read
    unsafe {
        A_WAKE = v;
    }
}

// (0.28.0) A_QUEUE's accessors: every use of it is one of them.
fn get_a_queue() -> IntVec {
    // UNSAFE: the assembler's text queue, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: reset by asm_thread_start before pthread_create; afterwards
    // pushed by asm_thread_push (main) and read by asm_thread_main only
    // while A_MUTEX is held; the entries read (text pointer, length) are
    // copied out before the unlock, so no reference into it lives across a
    // push's growth
    unsafe { A_QUEUE }
}

fn set_a_queue(v: IntVec) {
    // UNSAFE: the assembler's text queue, a process-wide static mut; Rust
    // has no safe access to a static mut
    // SAFETY: reset by asm_thread_start before pthread_create; afterwards
    // pushed by asm_thread_push (main) and read by asm_thread_main only
    // while A_MUTEX is held; the entries read (text pointer, length) are
    // copied out before the unlock, so no reference into it lives across a
    // push's growth
    unsafe {
        A_QUEUE = v;
    }
}

// (0.28.0) A_HEAD's accessors: every use of it is one of them.
fn get_a_head() -> i64 {
    // UNSAFE: the assembler queue's read position, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: set by asm_thread_start before pthread_create; afterwards
    // read and advanced only by asm_thread_main holding A_MUTEX
    unsafe { A_HEAD }
}

fn set_a_head(v: i64) {
    // UNSAFE: the assembler queue's read position, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: set by asm_thread_start before pthread_create; afterwards
    // read and advanced only by asm_thread_main holding A_MUTEX
    unsafe {
        A_HEAD = v;
    }
}

// (0.28.0) A_STOP's accessors: every use of it is one of them.
fn get_a_stop() -> bool {
    // UNSAFE: the assembler thread's stop flag, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: set false by asm_thread_start before pthread_create, set true
    // by asm_thread_finish holding A_MUTEX; read only by asm_thread_main
    // holding A_MUTEX
    unsafe { A_STOP }
}

fn set_a_stop(v: bool) {
    // UNSAFE: the assembler thread's stop flag, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: set false by asm_thread_start before pthread_create, set true
    // by asm_thread_finish holding A_MUTEX; read only by asm_thread_main
    // holding A_MUTEX
    unsafe {
        A_STOP = v;
    }
}

// (0.28.0) A_CTX's accessors: every use of it is one of them.
fn get_a_ctx() -> *mut FnCtx {
    // UNSAFE: the assembler thread's context, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: written only by asm_thread_start on the main thread before
    // pthread_create starts the assembler thread (create orders the write
    // before the thread's read); read only by asm_thread_main;
    // asm_thread_start runs once per process (compile_program's -O0
    // branch); only the assembler thread uses the FnCtx it points to
    unsafe { A_CTX }
}

fn set_a_ctx(v: *mut FnCtx) {
    // UNSAFE: the assembler thread's context, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: written only by asm_thread_start on the main thread before
    // pthread_create starts the assembler thread (create orders the write
    // before the thread's read); read only by asm_thread_main;
    // asm_thread_start runs once per process (compile_program's -O0
    // branch); only the assembler thread uses the FnCtx it points to
    unsafe {
        A_CTX = v;
    }
}
