// --check-alloc's allocation sites (0.16): with the flag, lowering stores a
// site string (`main.vl:14:9`) in std::CHECK_ALLOC_SITE before each call
// from code outside std to a function whose effects allocate from an
// allocator (`alloc(Gpa)`, `alloc(Arena)`, ...; not `alloc(extern)` alone),
// for the checking allocator's reports, where a block was allocated and
// freed (compiler/std/alloc_check.vl; docs/design/effects-allocation.md
// §2.5). A call through a fn value stores too. gen0 does the same
// (gen0/gen/checkalloc.vl).

use crate::base::{buf_byte, buf_copy, buf_int, buf_new, buf_str, get_src, intern_c, out_path};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::effects::fn_effects;
use crate::front::effects::infer::is_allocator_method;
use crate::front::lexer::add_string;
use crate::front::modules::within_std;
use crate::front::stdalloc::get_check_alloc_mode;
use crate::front::types::TY_U64;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, emit_ir, ir_store};

// The symbol of the static the sites are stored in, or -1.
pub fn site_static(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.site_static == 0 {
        let sym = intern_c(c"std.CHECK_ALLOC_SITE", pcx);
        pcx.site_static = if pcx.std_module >= 0
            && (pcx.sym_static[sym as usize]) != 0 { sym }
            else { -1 };
    }
    pcx.site_static
}

// Whether call n, in function `caller`, stores its site: with --check-alloc,
// from the program (not std, nor a runtime of another checking mode, nor a
// drop shim: it has no site of its own, the drop's caller's holds), to a
// function that may allocate from an allocator (an Allocator method itself:
// its own set is C allocation, the caller's is the allocator's; a method
// of an allocator type), or through a fn value.
pub fn needs_site(n: i64, caller: i64, pcx: &mut Ctx<Comp>) -> bool {
    // (no node: a call the lowering made, a drop's shim: its site is the
    // drop's, site_before_drop)
    if !get_check_alloc_mode() || site_static(pcx) < 0 || n <= 0 {
        return false;
    }
    let m = pcx.fns[caller as usize].module;
    if within_std(m, pcx) || m == pcx.check_module || m == pcx.profile_module
        || crate::places::shim::is_shim_fn(caller, pcx) {
        return false;
    }
    let f = pcx.nodes[n as usize].x - 1;
    f < 0 || fn_effects(f, pcx).allocs != 0 || is_allocator_method(f, pcx)
        || of_allocator_type(f, pcx)
}

// (0.26.1) Whether a drop in function `caller`, run by its type's drop
// shim (the places IR's `drop(P)`), stores its site: as a call's, from the
// program; every kept drop, as the AST walk's drop calls did.
pub fn drop_needs_site(caller: i64, pcx: &mut Ctx<Comp>) -> bool {
    if !get_check_alloc_mode() || site_static(pcx) < 0 {
        return false;
    }
    let m = pcx.fns[caller as usize].module;
    !(within_std(m, pcx) || m == pcx.check_module || m == pcx.profile_module
        || crate::places::shim::is_shim_fn(caller, pcx))
}

// Right before a drop's shim call: its site, source position pos (where
// the drop runs, places::print::drop_pos), when it needs one.
pub fn site_before_drop(cx: &mut FnCtx<Comp>, pos: i64, pcx: &mut Ctx<Comp>) {
    if !drop_needs_site(pcx.ir_fn[cx.irf as usize], pcx) {
        return;
    }
    let at = emit_ir(cx, Op::GAddr, TY_U64, 0, 0, site_static(pcx), pcx);
    let site = emit_ir(cx, Op::SAddr, TY_U64, 0, 0, site_text(pos, pcx), pcx);
    ir_store(cx, TY_U64, at, site, 0, pcx);
}

// Whether f is a method of a type that implements std's Allocator (an
// arena's reset, free_all or scope: they give blocks back, and the
// checking Gpa reports where).
fn of_allocator_type(f: i64, pcx: &Ctx<Comp>) -> bool {
    let t = pcx.fns[f as usize].self_ty;
    if t == 0 || pcx.infer_allocator_trait < 0 {
        return false;
    }
    for j in 0..pcx.traits_impls.len() as i64 {
        if pcx.traits_impls[j as usize].tr == pcx.infer_allocator_trait
            && pcx.traits_impls[j as usize].ty == t {
            return true;
        }
    }
    false
}

// The index of the last line starting at or before pos.
fn line_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.checkalloc_lines.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if (pcx.checkalloc_lines[mid as usize]) <= pos { lo = mid + 1; }
        else { hi = mid; }
    }
    lo - 1
}

// The C string `path:line:column` of source position pos, a string
// literal's id.
pub fn site_text(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.checkalloc_lines.len() as i64 == 0 {
        pcx.checkalloc_lines.push(0);
        for i in 0..pcx.files[(pcx.files.len() as i64 - 1) as usize].end {
            if get_src()[i as usize] == b'\n' {
                pcx.checkalloc_lines.push(i + 1);
            }
        }
    }
    let mut file: i64 = 0;
    while file + 1 < pcx.files.len() as i64 && pos >= pcx.files[(file + 1) as usize].start {
        file += 1;
    }
    let line = line_of(pos, pcx);
    let out = buf_new();
    buf_str(out, out_path(file, pcx));
    buf_byte(out, b':');
    buf_int(out, line - line_of(pcx.files[file as usize].start, pcx) + 1);
    buf_byte(out, b':');
    buf_int(out, pos - (pcx.checkalloc_lines[line as usize]) + 1);
    add_string(
        &buf_copy(out), pcx)
}

// Right before lowering call n's Call instruction (its arguments are
// lowered): its site, when it needs one.
pub fn site_before_call(cx: &mut FnCtx<Comp>, n: i64, pcx: &mut Ctx<Comp>) {
    if !needs_site(n, pcx.ir_fn[cx.irf as usize], pcx) {
        return;
    }
    let at = emit_ir(cx, Op::GAddr, TY_U64, 0, 0, site_static(pcx), pcx);
    let site = emit_ir(cx, Op::SAddr, TY_U64, 0, 0, site_text(pcx.nodes[n as usize].start, pcx),
        pcx);
    ir_store(cx, TY_U64, at, site, 0, pcx);
}
