// Tail recursion elimination, with accumulators (0.4). A function whose
// returns are `return f(args)` or `return f(args) op y` / `y op f(args)`
// (op one associative and commutative integer operation: + * & | ^, the
// call to itself last before the return) becomes a loop: the entry block
// is the loop's header, with a phi per parameter and one for the
// accumulator; a recursive return jumps back with the new arguments and
// `acc op y`; any other return gives `acc op value`. Fibonacci's
// `fib(n - 1) + fib(n - 2)` becomes a loop adding fib(n - 1) and going on
// with n - 2: half the calls.
//
// The function must return a scalar, take scalar parameters only, and have
// no frame slots (each activation's memory would be one).

// Moves a return through a phi block into the blocks before it: a block
// holding only a phi that its `ret` returns, entered by jumps, becomes a
// `ret` of the phi's operand in each predecessor.
use crate::base::{IntVec, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::is_integer;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::all_ones;
use crate::middle::inline::ir_callee;
use crate::middle::ir::{
    Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_make, ir_new_block, ir_operand,
    ir_operand_count, ir_prepend, ir_set_arg, ir_type, ir_unlink, ir_val,
};
use crate::middle::ir::Op::{Add, And, Const, Mul, Or, Param, Phi, Slot, Xor};
use crate::middle::loops::clone_inst;
use crate::middle::opt::{remove_unreachable, resolve_all};
use crate::middle::scev::{append_const, append_inst};

fn split_returns(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let r = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[r as usize]).removed != 0
                || (cx.blocks[r as usize]).term != Term::Ret
                || (cx.blocks[r as usize]).preds.len() as i64 < 2 {
                continue;
            }
            let phi = ir_val(cx, (cx.blocks[r as usize]).cond);
            if phi == 0 || (cx.insts[phi as usize]).op != Phi
                || (cx.insts[phi as usize]).block != r
                || (cx.blocks[r as usize]).first != phi
                || (cx.blocks[r as usize]).last != phi {
                continue;
            }
            let mut jumps = true;
            for k in 0..(cx.blocks[r as usize]).preds.len() as i64 {
                if (cx.blocks[((cx.blocks[r as usize]).preds[k as usize]) as usize]).term
                    != Term::Jump {
                    jumps = false;
                }
            }
            if !jumps {
                continue;
            }
            for k in 0..(cx.blocks[r as usize]).preds.len() as i64 {
                let p = ((cx.blocks[r as usize]).preds[k as usize]);
                (cx.blocks[p as usize]).term = Term::Ret;
                let ir_arg_v = ir_arg(cx, phi, k);
                (cx.blocks[p as usize]).cond = ir_val(cx, ir_arg_v);
                (cx.blocks[p as usize]).s0 = 0;
            }
            (cx.blocks[r as usize]).preds.clear();
        }
    }
    remove_unreachable(cx, fi);
}

// The number of uses of v in function fi (operands and conditions).
fn use_count(cx: &mut FnCtx<Comp>, fi: i64, v: i64) -> i64 {
    let mut n: i64 = 0;
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut u = (cx.blocks[b as usize]).first;
            while u != 0 {
                for k in 0..ir_operand_count(cx, u) {
                    let ir_operand_v = ir_operand(cx, u, k);
                    let ir_val_v = ir_val(cx, ir_operand_v);
                    if ir_val_v == v {
                        n += 1;
                    }
                }
                u = (cx.insts[u as usize]).next;
            }
            if (cx.blocks[b as usize]).cond != 0
                && ir_val(cx, (cx.blocks[b as usize]).cond) == v {
                n += 1;
            }
        }
    }
    n
}

// The recursive call of a tail site: block b returns `call` or `call op y`;
// *y is the other operand (0 for a plain tail call), *op its operation.
// Returns the call, or 0.
fn tail_site(cx: &mut FnCtx<Comp>, fi: i64, b: i64, op: &mut Op, y: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (cx.blocks[b as usize]).term != Term::Ret {
            return 0;
        }
        let r = ir_val(cx, (cx.blocks[b as usize]).cond);
        if r == 0 || (cx.insts[r as usize]).block != b {
            return 0;
        }
        let mut call: i64 = 0;
        if ir_callee(cx, r, pcx) == fi {
            call = r;
            *y = 0;
        } else {
            let o = (cx.insts[r as usize]).op;
            if !(o == Add || o == Mul || o == And || o == Or || o == Xor)
                || !is_integer((cx.insts[r as usize]).ty) {
                return 0;
            }
            let a = ir_val(cx, (cx.insts[r as usize]).a);
            let c = ir_val(cx, (cx.insts[r as usize]).b);
            // (When both are calls to itself, the later one.)
            if ir_callee(cx, c, pcx) == fi && (cx.insts[c as usize]).block == b && a != c
                && only_pure_after(cx, c, r) {
                call = c;
                *y = a;
            }
            else if ir_callee(cx, a, pcx) == fi && (cx.insts[a as usize]).block == b
                && a != c {
                call = a;
                *y = c;
            } else {
                return 0;
            }
            *op = o;
            if use_count(cx, fi, call) != 1 || use_count(cx, fi, r) != 1 {
                return 0;
            }
        }
        if !only_pure_after(cx, call, r) {
            return 0;
        }
        call
    }
}

// Whether nothing with an effect follows instruction `call` in its block
// (the operation r and pure instructions only).
fn only_pure_after(cx: &mut FnCtx<Comp>, call: i64, r: i64) -> bool {
    unsafe {
        let mut v = (cx.insts[call as usize]).next;
        while v != 0 {
            if v != r && !(cx.insts[v as usize]).op.is_pure()
                && (cx.insts[v as usize]).op != Const {
                return false;
            }
            v = (cx.insts[v as usize]).next;
        }
        true
    }
}

pub fn eliminate_tail_recursion(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        let f = (*get_irfuncs().add(fi as usize)).f;
        if (*get_irfuncs().add(fi as usize)).result_ptr != 0
            || !is_integer(ir_type(pcx.fns[f as usize].ret, pcx)) {
            return false;
        }
        let entry = (*get_irfuncs().add(fi as usize)).entry;
        // Scalar parameters only, no frame slots, and a self call somewhere.
        let mut any_call = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                if op == Slot
                    || (op == Param
                        && ((cx.insts[v as usize]).imm < 0
                            || (cx.insts[v as usize]).imm2 != 0)) {
                    return false;
                }
                if op == Param && b != entry {
                    return false;
                }
                if ir_callee(cx, v, pcx) == fi {
                    any_call = true;
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        if !any_call {
            return false;
        }
        resolve_all(cx, fi);
        split_returns(cx, fi);
        // The tail sites, all with one operation.
        let mut sites = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut acc_op = Op::None;
        let mut ok = true;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut op = Op::None;
            let mut y: i64 = 0;
            let call = tail_site(cx, fi, b, &mut op, &mut y, pcx);
            if call == 0 {
                continue;
            }
            if y != 0 {
                if acc_op != Op::None && acc_op != op {
                    ok = false;
                }
                acc_op = op;
            }
            sites.push(b);
            sites.push(call);
            sites.push(y);
        }
        if !ok || sites.len() as i64 == 0 {
            free(sites.data as *mut u8);
            return false;
        }
        let ty = ir_type(pcx.fns[f as usize].ret, pcx);
        // A new entry holds the parameters and jumps to the old one, the loop's
        // header. Each parameter becomes a phi there (its uses follow).
        let e2 = ir_new_block(cx);
        (cx.blocks[e2 as usize]).sealed = 1;
        let old_preds = (cx.blocks[entry as usize]).preds.len() as i64;
        let mut params = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut v = (cx.blocks[entry as usize]).first;
        while v != 0 {
            let next = (cx.insts[v as usize]).next;
            if (cx.insts[v as usize]).op == Param {
                params.push(v);
            }
            v = next;
        }
        let nsites = sites.len() as i64 / 3;
        let npreds = old_preds + 1 + nsites;
        for i in 0..params.len() as i64 {
            let p = (params[i as usize]);
            let fresh = clone_inst(cx, p, pcx);
            ir_append(cx, e2, fresh);
            ir_unlink(cx, p);
            (cx.insts[p as usize]).op = Phi;
            (cx.insts[p as usize]).a = 0;
            (cx.insts[p as usize]).b = 0;
            (cx.insts[p as usize]).imm = 0;
            (cx.insts[p as usize]).imm2 = 0;
            (cx.insts[p as usize]).args = cx.args.len() as i64;
            (cx.insts[p as usize]).nargs = npreds;
            let index = (cx.insts[fresh as usize]).imm;
            for k in 0..old_preds {
                cx.args.push(p);
                cx.argty.push(0);
            }
            cx.args.push(fresh);
            cx.argty.push(0);
            for s in 0..nsites {
                let ir_arg_v = ir_arg(cx, (sites[(3 * s + 1) as usize]), index);
                cx.args.push(ir_arg_v);
                cx.argty.push(0);
            }
            ir_prepend(cx, entry, p);
        }
        let mut acc: i64 = 0;
        if acc_op != Op::None {
            let identity: i64 = if acc_op == Mul { 1 } else if acc_op == And { all_ones(ty) }
                else { 0 };
            let start = append_const(cx, e2, identity, ty, pcx);
            acc = ir_make(cx, Phi, ty, 0, 0, 0, pcx);
            (cx.insts[acc as usize]).args = cx.args.len() as i64;
            (cx.insts[acc as usize]).nargs = npreds;
            for k in 0..old_preds {
                cx.args.push(acc);
                cx.argty.push(0);
            }
            cx.args.push(start);
            cx.argty.push(0);
            for s in 0..nsites {
                cx.args.push(0);
                cx.argty.push(0);
            }
            ir_prepend(cx, entry, acc);
        }
        (cx.blocks[e2 as usize]).term = Term::Jump;
        (cx.blocks[e2 as usize]).s0 = entry;
        (cx.blocks[entry as usize]).preds.push(e2);
        (*get_irfuncs().add(fi as usize)).entry = e2;
        // The tail sites jump back.
        for s in 0..nsites {
            let b = (sites[(3 * s) as usize]);
            let call = (sites[(3 * s + 1) as usize]);
            let y = (sites[(3 * s + 2) as usize]);
            let r = ir_val(cx, (cx.blocks[b as usize]).cond);
            let mut next_acc = acc;
            if r != call {
                ir_unlink(cx, r);
            }
            ir_unlink(cx, call);
            if acc != 0 {
                if y != 0 {
                    next_acc = append_inst(cx, b, acc_op, ty, acc, y, pcx);
                }
                ir_set_arg(cx, acc, old_preds + 1 + s, next_acc);
            }
            (cx.blocks[b as usize]).term = Term::Jump;
            (cx.blocks[b as usize]).cond = 0;
            (cx.blocks[b as usize]).s0 = entry;
            (cx.blocks[entry as usize]).preds.push(b);
        }
        // The other returns combine their value with the accumulator.
        if acc != 0 {
            for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
                let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
                if (cx.blocks[b as usize]).removed != 0
                    || (cx.blocks[b as usize]).term != Term::Ret
                    || (cx.blocks[b as usize]).cond == 0 {
                    continue;
                }
                let ir_val_v = ir_val(cx, (cx.blocks[b as usize]).cond);
                (cx.blocks[b as usize]).cond = append_inst(cx, b, acc_op, ty, acc,
                    ir_val_v, pcx);
            }
        }
        free(params.data as *mut u8);
        free(sites.data as *mut u8);
        resolve_all(cx, fi);
        true
    }
}
