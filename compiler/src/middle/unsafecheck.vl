// The checking mode for unsafe code (0.10): `volec --check-unsafe`.
//
// Unsafe code's raw-pointer accesses (a dereference, an index, a field
// through a raw pointer, a slice made from one) are checked at run time
// against the heap blocks the program has allocated: the calls of C's
// malloc, calloc, realloc and free made by vole code (std's included)
// go to wrappers in the runtime (the module __check, whose source is built
// in below and added to the program), which record the live blocks and
// the last freed ones. An access is an error, reported with its place in
// the source and exit code 101, when it
//
// - starts in a live block and runs past its end (out of bounds),
// - starts before a live block and runs into it,
// - falls in a block freed since (use after free), or frees a freed one.
//
// Memory the program did not allocate itself (the stack, statics, what C
// allocates) is not checked: the check knows the heap blocks only.

use crate::base::{buf_str, intern_c, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::stdalloc::get_check_alloc_mode;

// The runtime, as vole source.
pub fn check_runtime_source(out: i64, pcx: &Ctx<Comp>) {
    buf_str(out, c"// The checking mode's runtime (0.10): see compiler/src/unsafecheck.vl.\n");
    buf_str(out, c"extern \"C\" {\n");
    buf_str(out, c"    fn malloc(size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn calloc(count: u64, size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn realloc(p: *mut u8, size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn free(p: *mut u8);\n");
    buf_str(out, c"    fn memmove(dst: *mut u8, src: *const u8, n: u64) -> *mut u8;\n");
    buf_str(out, c"    fn dprintf(fd: i32, format: *const u8, ...) -> i32;\n");
    buf_str(out, c"    fn exit(code: i32) -> !;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The live blocks: [STARTS[i], ENDS[i]), sorted.\n");
    buf_str(out, c"// The freed ones: the last FREED freed, in a ring, with the range they\n");
    buf_str(out, c"// span (FLO, FHI) to pass most addresses by at once.\n");
    buf_str(out, c"static mut STARTS: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut ENDS: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut COUNT: i64 = 0;\n");
    buf_str(out, c"static mut CAP: i64 = 0;\n");
    buf_str(out, c"const FREED: i64 = 4096;\n");
    buf_str(out, c"static mut FSTARTS: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut FENDS: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut FNEXT: i64 = 0;\n");
    buf_str(out, c"static mut FLO: u64 = 18446744073709551615;\n");
    buf_str(out, c"static mut FHI: u64 = 0;\n");
    buf_str(out,
        c"unsafe fn fail(what: *const u8, p: u64, size: u64, start: u64, end: u64, site: *const u8) -> ! {\n");
    buf_str(out,
        c"    dprintf(2, c\"unsafe access %s: %llu bytes at offset %lld of a block of %llu bytes\\n --> %s\\n\", what, size, p as i64 - start as i64, end - start, site);\n");
    buf_str(out, c"    exit(101)\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The index of the last live block starting at or before p, or -1.\n");
    buf_str(out, c"unsafe fn find(p: u64) -> i64 {\n");
    buf_str(out, c"    let mut lo = 0;\n");
    buf_str(out, c"    let mut hi = COUNT;\n");
    buf_str(out, c"    while lo < hi {\n");
    buf_str(out, c"        let mid = (lo + hi) / 2;\n");
    buf_str(out, c"        if *STARTS.add(mid as usize) <= p {\n");
    buf_str(out, c"            lo = mid + 1;\n");
    buf_str(out, c"        } else {\n");
    buf_str(out, c"            hi = mid;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    lo - 1\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The freed block holding p, or -1.\n");
    buf_str(out, c"unsafe fn find_freed(p: u64) -> i64 {\n");
    buf_str(out, c"    if p < FLO || p >= FHI {\n");
    buf_str(out, c"        return -1;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    for k in 0..FREED {\n");
    buf_str(out, c"        if p >= *FSTARTS.add(k as usize) && p < *FENDS.add(k as usize) {\n");
    buf_str(out, c"            return k;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    -1\n");
    buf_str(out, c"}\n");
    buf_str(out, c"unsafe fn record(p: *mut u8, size: u64) {\n");
    buf_str(out, c"    if p == 0 as *mut u8 {\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let s = p as u64;\n");
    buf_str(out, c"    let e = s + (if size == 0 { 1 } else { size });\n");
    buf_str(out, c"    // Freed blocks the new one reuses are forgotten.\n");
    buf_str(out, c"    if FSTARTS != 0 as *mut u64 && s < FHI && e > FLO {\n");
    buf_str(out, c"        for k in 0..FREED {\n");
    buf_str(out, c"            if *FSTARTS.add(k as usize) < e && s < *FENDS.add(k as usize) {\n");
    buf_str(out, c"                *FSTARTS.add(k as usize) = 0;\n");
    buf_str(out, c"                *FENDS.add(k as usize) = 0;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if COUNT == CAP {\n");
    buf_str(out, c"        CAP = if CAP == 0 { 256 } else { CAP * 2 };\n");
    buf_str(out, c"        STARTS = realloc(STARTS as *mut u8, (CAP * 8) as u64) as *mut u64;\n");
    buf_str(out, c"        ENDS = realloc(ENDS as *mut u8, (CAP * 8) as u64) as *mut u64;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let at = (find(s) + 1) as usize;\n");
    buf_str(out,
        c"    memmove(STARTS.add(at + 1) as *mut u8, STARTS.add(at) as *const u8, ((COUNT - at as i64) * 8) as u64);\n");
    buf_str(out,
        c"    memmove(ENDS.add(at + 1) as *mut u8, ENDS.add(at) as *const u8, ((COUNT - at as i64) * 8) as u64);\n");
    buf_str(out, c"    *STARTS.add(at) = s;\n");
    buf_str(out, c"    *ENDS.add(at) = e;\n");
    buf_str(out, c"    COUNT += 1;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// Forgets block p (when it is one), into the freed ring.\n");
    buf_str(out, c"unsafe fn unrecord(p: *mut u8, site: *const u8) {\n");
    buf_str(out, c"    if p == 0 as *mut u8 {\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let s = p as u64;\n");
    buf_str(out, c"    let found = find(s);\n");
    buf_str(out, c"    if found < 0 || *STARTS.add(found as usize) != s {\n");
    buf_str(out, c"        let k = find_freed(s);\n");
    buf_str(out, c"        if k >= 0 && *FSTARTS.add(k as usize) == s {\n");
    buf_str(out,
        c"            fail(c\"(a block freed twice)\", s, 0, *FSTARTS.add(k as usize), *FENDS.add(k as usize), site);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let i = found as usize;\n");
    buf_str(out, c"    if FSTARTS == 0 as *mut u64 {\n");
    buf_str(out, c"        FSTARTS = calloc(FREED as u64, 8) as *mut u64;\n");
    buf_str(out, c"        FENDS = calloc(FREED as u64, 8) as *mut u64;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    *FSTARTS.add(FNEXT as usize) = s;\n");
    buf_str(out, c"    *FENDS.add(FNEXT as usize) = *ENDS.add(i);\n");
    buf_str(out, c"    FNEXT = (FNEXT + 1) % FREED;\n");
    buf_str(out, c"    if s < FLO {\n");
    buf_str(out, c"        FLO = s;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if *ENDS.add(i) > FHI {\n");
    buf_str(out, c"        FHI = *ENDS.add(i);\n");
    buf_str(out, c"    }\n");
    buf_str(out,
        c"    memmove(STARTS.add(i) as *mut u8, STARTS.add(i + 1) as *const u8, ((COUNT - found - 1) * 8) as u64);\n");
    buf_str(out,
        c"    memmove(ENDS.add(i) as *mut u8, ENDS.add(i + 1) as *const u8, ((COUNT - found - 1) * 8) as u64);\n");
    buf_str(out, c"    COUNT -= 1;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn malloc_(size: u64) -> *mut u8 {\n");
    buf_str(out, c"    let p = malloc(size);\n");
    buf_str(out, c"    record(p, size);\n");
    buf_str(out, c"    p\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn calloc_(count: u64, size: u64) -> *mut u8 {\n");
    buf_str(out, c"    let p = calloc(count, size);\n");
    buf_str(out, c"    record(p, count * size);\n");
    buf_str(out, c"    p\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn realloc_(old: *mut u8, size: u64) -> *mut u8 {\n");
    buf_str(out, c"    unrecord(old, c\"realloc\");\n");
    buf_str(out, c"    let p = realloc(old, size);\n");
    buf_str(out, c"    record(p, size);\n");
    buf_str(out, c"    p\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn free_(p: *mut u8) {\n");
    buf_str(out, c"    unrecord(p, c\"free\");\n");
    buf_str(out, c"    free(p);\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The access of `size` bytes at p.\n");
    buf_str(out, c"pub unsafe fn check(p: u64, size: u64, site: *const u8) {\n");
    buf_str(out, c"    if size == 0 {\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    if get_check_alloc_mode() && pcx.std_module >= 0 {
        // (0.16, with --check-alloc: the checking Gpa's blocks, known
        // exactly, freed ones included)
        buf_str(out, c"    if std::check_alloc_access(p, size, site) {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
    }
    buf_str(out, c"    let found = find(p);\n");
    buf_str(out, c"    if found >= 0 && p < *ENDS.add(found as usize) {\n");
    buf_str(out, c"        let i = found as usize;\n");
    buf_str(out, c"        if size > *ENDS.add(i) - p {\n");
    buf_str(out,
        c"            fail(c\"out of bounds\", p, size, *STARTS.add(i), *ENDS.add(i), site);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if found >= 0 && p == *ENDS.add(found as usize) {\n");
    buf_str(out, c"        let i = found as usize;\n");
    buf_str(out,
        c"        fail(c\"out of bounds (just past the end)\", p, size, *STARTS.add(i), *ENDS.add(i), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if found + 1 < COUNT && *STARTS.add((found + 1) as usize) - p < size {\n");
    buf_str(out, c"        let n = (found + 1) as usize;\n");
    buf_str(out,
        c"        fail(c\"out of bounds (into the next block)\", p, size, *STARTS.add(n), *ENDS.add(n), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let k = find_freed(p);\n");
    buf_str(out, c"    if k >= 0 {\n");
    buf_str(out,
        c"        fail(c\"after free\", p, size, *FSTARTS.add(k as usize), *FENDS.add(k as usize), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
}

// The runtime's check function, or -1.
pub fn check_function(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.unsafecheck_check_fn == -2 {
        pcx.unsafecheck_check_fn = check_fn(c"check", pcx);
    }
    pcx.unsafecheck_check_fn
}

// The runtime function `name` (an item of __check), or -1.
pub fn check_fn(name: *mut u8, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let out = crate::base::buf_new();
        buf_str(out, c"__check::");
        buf_str(out, name);
        crate::base::buf_byte(out, 0);
        (*pcx.sym_fn.add(intern_c((*crate::base::get_bufs().add(out as usize)).data, pcx) as usize)) - 1
    }
}

// The wrapper a call of C function f, from a function of module `from`,
// goes to instead (malloc, calloc, realloc and free), or f. (The runtimes'
// own calls are not redirected.)
pub fn redirect_alloc(f: i64, from: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !pcx.check_unsafe || f < 0 || !pcx.fns[f as usize].is_extern || from == pcx.check_module
        || from == pcx.profile_module {
        return f;
    }
    let name = sym_name(pcx.fns[f as usize].name, pcx);
    let names: [*mut u8; 4] = [c"malloc", c"calloc", c"realloc", c"free"];
    let wrappers: [*mut u8; 4] = [c"malloc_", c"calloc_", c"realloc_", c"free_"];
    for i in 0..4 {
        if crate::base::streq(name, names[i as usize]) {
            let w = check_fn(wrappers[i as usize], pcx);
            return if w >= 0 { w } else { f };
        }
    }
    f
}

// ---- Sites ----

// The index of the last line starting at or before pos.
fn line_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut lo: i64 = 0;
        let mut hi = pcx.unsafecheck_lines.count;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if (*pcx.unsafecheck_lines.data.add(mid as usize)) <= pos { lo = mid + 1; }
            else { hi = mid; }
        }
        lo - 1
    }
}

// A C string `path: line L, column C` for source position pos, as a
// string literal's id.
pub fn site_string(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let count = pcx.files.len() as i64;
        if pcx.unsafecheck_lines.count == 0 {
            pcx.unsafecheck_lines.push(0);
            for i in 0..pcx.files[(count - 1) as usize].end {
                if crate::base::get_src()[i as usize] == b'\n' {
                    pcx.unsafecheck_lines.push(i + 1);
                }
            }
        }
        let mut file: i64 = 0;
        while file + 1 < count && pos >= pcx.files[(file + 1) as usize].start {
            file += 1;
        }
        let line = line_of(pos, pcx);
        let out = crate::base::buf_new();
        buf_str(out, crate::base::out_path(file, pcx));
        buf_str(out, c": line ");
        crate::base::buf_int(out, line - line_of(pcx.files[file as usize].start, pcx) + 1);
        buf_str(out, c", column ");
        crate::base::buf_int(out, pos - (*pcx.unsafecheck_lines.data.add(line as usize)) + 1);
        crate::front::lexer::add_string(
            std::slice::from_raw_parts(
                (*crate::base::get_bufs().add(out as usize)).data.add((0) as usize),
                ((*crate::base::get_bufs().add(out as usize)).len - (0)) as usize))
    }
}
