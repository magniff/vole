// The checking mode for unsafe code (0.10): `volec --check-unsafe`.
//
// Unsafe code's raw-pointer accesses (a dereference, an index, a field
// through a raw pointer, a slice made from one) are checked at run time
// against the heap blocks the program has allocated: the calls of C's
// malloc, calloc, realloc, posix_memalign and free made by vole code
// (std's included: Gpa's) go to wrappers in the runtime (the module
// __check, whose source is built in below and added to the program),
// which record the live blocks and the last freed ones. (0.30.1) A C
// function is the symbol it links to: std's `#[link_name = "malloc"] fn
// gpa_c_malloc` is malloc, and a program's extern named malloc that links
// to its own allocator is not. An access is an error, reported with its
// place in the source and exit code 101, when it
//
// - starts in a live block and runs past its end (out of bounds),
// - starts before a live block and runs into it,
// - falls in a block freed since (use after free), or frees a freed one.
//
// (0.30.1) An address computed from a raw pointer (`&p[i]`, std's
// ptr::add and sub) is not an access: when the pointer is in a live
// block, the address must be in it or one past its end (Rust's add), and
// only a read or write through it is checked as an access; its offset in
// bytes must fit an isize. The runtime's tables are behind a lock: a
// program's threads (the compiler's own) can be checked.
//
// Memory the program did not allocate itself (the stack, statics, what C
// allocates) is not checked: the check knows the heap blocks only, and
// (0.30.1) never reports memory it did not see allocated. So a block the
// program frees is held back from C's allocator while the check counts it
// freed (the last 4096, at most 64 MB: a quarantine), and every block has
// 16 bytes after its end that no one is given (a red zone): C's own
// mallocs (strdup's, opendir's) can neither reuse a freed block nor start
// where a block ends.

use crate::base::{buf_str, intern_c, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::stdalloc::get_check_alloc_mode;

// The runtime, as vole source. (0.30.1) Its tables are behind a lock
// when the program has std (and so threads).
pub fn check_runtime_source(out: i64, pcx: &Ctx<Comp>) {
    buf_str(out,
        c"// The checking mode's runtime (0.10): see compiler/src/middle/unsafecheck.vl.\n");
    buf_str(out, c"extern \"C\" {\n");
    buf_str(out, c"    fn malloc(size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn calloc(count: u64, size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn realloc(p: *mut u8, size: u64) -> *mut u8;\n");
    buf_str(out, c"    fn free(p: *mut u8);\n");
    buf_str(out, c"    fn posix_memalign(out: *mut *mut u8, align: u64, size: u64) -> i32;\n");
    buf_str(out, c"    fn memcpy(dst: *mut u8, src: *const u8, n: u64) -> *mut u8;\n");
    buf_str(out, c"    fn dprintf(fd: i32, format: *const u8, ...) -> i32;\n");
    buf_str(out, c"    fn sched_yield() -> i32;\n");
    buf_str(out, c"    fn exit(code: i32) -> !;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// (0.30.1) The blocks, in two trees (treaps on their starts, the nodes in\n");
    buf_str(out, c"// arrays grown by C's realloc): LIVE, the program's live blocks, and\n");
    buf_str(out, c"// FREED, the last ones it freed, held back from C's allocator (RING\n");
    buf_str(out, c"// holds their starts, oldest first: the oldest is freed when RING is full\n");
    buf_str(out, c"// or the blocks held pass QUARANTINE bytes). So no block of FREED is\n");
    buf_str(out, c"// memory C can hand out again, to the program or to C itself (strdup's\n");
    buf_str(out, c"// malloc, opendir's): a block is reported freed only while it is. A node\n");
    buf_str(out,
        c"// n is the block [KEY[n], END[n]); 0 is no node. Every table is read and written holding LOCK: the program's\n");
    buf_str(out, c"// threads allocate, free and check at once. O(log n) a call, the\n");
    buf_str(out, c"// compiler's own hundreds of thousands of blocks included.\n");
    buf_str(out, c"static mut KEY: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut END: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut LEFT: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut RIGHT: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut PRIO: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut NODES: u64 = 0;\n");
    buf_str(out, c"static mut CAP: u64 = 0;\n");
    buf_str(out, c"static mut SPARE: u64 = 0;\n");
    buf_str(out, c"static mut SEED: u64 = 88172645463325252;\n");
    buf_str(out, c"static mut LIVE: u64 = 0;\n");
    buf_str(out, c"static mut FREED_ROOT: u64 = 0;\n");
    buf_str(out, c"const FREED: u64 = 4096;\n");
    buf_str(out, c"const QUARANTINE: u64 = 67108864;\n");
    buf_str(out, c"// (0.30.1) Each block the check allocates has REDZONE bytes more than it\n");
    buf_str(out, c"// was asked for, after its end, which no one is given: so no memory of C's\n");
    buf_str(out, c"// (a block the check never saw) starts at a block's end, and an access\n");
    buf_str(out, c"// there is past the block's end.\n");
    buf_str(out, c"const REDZONE: u64 = 16;\n");
    buf_str(out, c"static mut RING: *mut u64 = 0 as *mut u64;\n");
    buf_str(out, c"static mut RING_OLD: u64 = 0;\n");
    buf_str(out, c"static mut HELD: u64 = 0;\n");
    buf_str(out, c"static mut HELD_BYTES: u64 = 0;\n");
    buf_str(out, c"static mut LOCK: i64 = 0;\n");
    buf_str(out, c"// The live block check found last, [HIT_S, HIT_E) (none: 0, 0): checked\n");
    buf_str(out, c"// first; forgotten whenever a live block is.\n");
    buf_str(out, c"static mut HIT_S: u64 = 0;\n");
    buf_str(out, c"static mut HIT_E: u64 = 0;\n");
    buf_str(out, c"// Element i of a table. (Arithmetic on the address, not std's ptr::add:\n");
    buf_str(out, c"// the runtime's own code is not checked, and add's is.)\n");
    buf_str(out, c"unsafe fn slot(p: *mut u64, i: u64) -> *mut u64 {\n");
    buf_str(out, c"    (p as u64 + i * 8) as *mut u64\n");
    buf_str(out, c"}\n");
    buf_str(out, c"unsafe fn get(t: *mut u64, n: u64) -> u64 {\n");
    buf_str(out, c"    *slot(t, n)\n");
    buf_str(out, c"}\n");
    buf_str(out, c"unsafe fn set(t: *mut u64, n: u64, v: u64) {\n");
    buf_str(out, c"    *slot(t, n) = v;\n");
    buf_str(out, c"}\n");
    if pcx.std_module >= 0 {
        buf_str(out,
            c"// The tables' lock: a spin lock on LOCK, as an atomic (test and test and\n");
        buf_str(out, c"// set: a waiting thread reads it, and yields now and then).\n");
        buf_str(out, c"unsafe fn lock() {\n");
        buf_str(out, c"    let a = &*(&raw mut LOCK as *const std::sync::atomic::Atomic<i64>);\n");
        buf_str(out, c"    loop {\n");
        buf_str(out, c"        if a.swap(1, std::sync::atomic::Ordering::Acquire) == 0 {\n");
        buf_str(out, c"            return;\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"        let mut n = 0;\n");
        buf_str(out, c"        while a.load(std::sync::atomic::Ordering::Relaxed) != 0 {\n");
        buf_str(out, c"            n += 1;\n");
        buf_str(out, c"            if n > 256 {\n");
        buf_str(out, c"                sched_yield();\n");
        buf_str(out, c"                n = 0;\n");
        buf_str(out, c"            }\n");
        buf_str(out, c"        }\n");
        buf_str(out, c"    }\n");
        buf_str(out, c"}\n");
        buf_str(out, c"unsafe fn unlock() {\n");
        buf_str(out, c"    let a = &*(&raw mut LOCK as *const std::sync::atomic::Atomic<i64>);\n");
        buf_str(out, c"    a.store(0, std::sync::atomic::Ordering::Release);\n");
        buf_str(out, c"}\n");
    } else {
        buf_str(out, c"// The tables' lock: none without std (no threads).\n");
        buf_str(out, c"unsafe fn lock() {\n");
        buf_str(out, c"}\n");
        buf_str(out, c"unsafe fn unlock() {\n");
        buf_str(out, c"}\n");
    }
    buf_str(out, c"// (Called holding the lock, which it gives up: exit's handlers free.)\n");
    buf_str(out,
        c"unsafe fn fail(what: *const u8, p: u64, size: u64, start: u64, end: u64, site: *const u8) -> ! {\n");
    buf_str(out, c"    unlock();\n");
    buf_str(out,
        c"    dprintf(2, c\"unsafe access %s: %llu bytes at offset %lld of a block of %llu bytes\\n --> %s\\n\", what, size, p as i64 - start as i64, end - start, site);\n");
    buf_str(out, c"    exit(101)\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// A node for block [s, e).\n");
    buf_str(out, c"unsafe fn node(s: u64, e: u64) -> u64 {\n");
    buf_str(out, c"    let mut n = SPARE;\n");
    buf_str(out, c"    if n != 0 {\n");
    buf_str(out, c"        SPARE = get(LEFT, n);\n");
    buf_str(out, c"    } else {\n");
    buf_str(out, c"        if NODES + 1 >= CAP {\n");
    buf_str(out, c"            CAP = if CAP == 0 { 4096 } else { CAP * 2 };\n");
    buf_str(out, c"            KEY = realloc(KEY as *mut u8, CAP * 8) as *mut u64;\n");
    buf_str(out, c"            END = realloc(END as *mut u8, CAP * 8) as *mut u64;\n");
    buf_str(out, c"            LEFT = realloc(LEFT as *mut u8, CAP * 8) as *mut u64;\n");
    buf_str(out, c"            RIGHT = realloc(RIGHT as *mut u8, CAP * 8) as *mut u64;\n");
    buf_str(out, c"            PRIO = realloc(PRIO as *mut u8, CAP * 8) as *mut u64;\n");
    buf_str(out,
        c"            if KEY == 0 as *mut u64 || END == 0 as *mut u64 || LEFT == 0 as *mut u64\n");
    buf_str(out, c"                || RIGHT == 0 as *mut u64 || PRIO == 0 as *mut u64 {\n");
    buf_str(out, c"                unlock();\n");
    buf_str(out,
        c"                dprintf(2, c\"--check-unsafe: out of memory for its tables\\n\");\n");
    buf_str(out, c"                exit(101);\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        NODES += 1;\n");
    buf_str(out, c"        n = NODES;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    SEED ^= SEED << 13;\n");
    buf_str(out, c"    SEED ^= SEED >> 7;\n");
    buf_str(out, c"    SEED ^= SEED << 17;\n");
    buf_str(out, c"    set(KEY, n, s);\n");
    buf_str(out, c"    set(END, n, e);\n");
    buf_str(out, c"    set(LEFT, n, 0);\n");
    buf_str(out, c"    set(RIGHT, n, 0);\n");
    buf_str(out, c"    set(PRIO, n, SEED);\n");
    buf_str(out, c"    n\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// Tree t with node n in it: its root.\n");
    buf_str(out, c"unsafe fn insert(t: u64, n: u64) -> u64 {\n");
    buf_str(out, c"    if t == 0 {\n");
    buf_str(out, c"        return n;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if get(KEY, n) < get(KEY, t) {\n");
    buf_str(out, c"        let l = insert(get(LEFT, t), n);\n");
    buf_str(out, c"        set(LEFT, t, l);\n");
    buf_str(out, c"        if get(PRIO, l) > get(PRIO, t) {\n");
    buf_str(out, c"            set(LEFT, t, get(RIGHT, l));\n");
    buf_str(out, c"            set(RIGHT, l, t);\n");
    buf_str(out, c"            return l;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    } else {\n");
    buf_str(out, c"        let r = insert(get(RIGHT, t), n);\n");
    buf_str(out, c"        set(RIGHT, t, r);\n");
    buf_str(out, c"        if get(PRIO, r) > get(PRIO, t) {\n");
    buf_str(out, c"            set(RIGHT, t, get(LEFT, r));\n");
    buf_str(out, c"            set(LEFT, r, t);\n");
    buf_str(out, c"            return r;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    t\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// Trees a and b as one (a's starts all below b's): its root.\n");
    buf_str(out, c"unsafe fn merge(a: u64, b: u64) -> u64 {\n");
    buf_str(out, c"    if a == 0 {\n");
    buf_str(out, c"        return b;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if b == 0 {\n");
    buf_str(out, c"        return a;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if get(PRIO, a) > get(PRIO, b) {\n");
    buf_str(out, c"        set(RIGHT, a, merge(get(RIGHT, a), b));\n");
    buf_str(out, c"        a\n");
    buf_str(out, c"    } else {\n");
    buf_str(out, c"        set(LEFT, b, merge(a, get(LEFT, b)));\n");
    buf_str(out, c"        b\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// Tree t without its node starting at s (made spare): its root.\n");
    buf_str(out, c"unsafe fn remove(t: u64, s: u64) -> u64 {\n");
    buf_str(out, c"    if t == 0 {\n");
    buf_str(out, c"        return 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if s < get(KEY, t) {\n");
    buf_str(out, c"        set(LEFT, t, remove(get(LEFT, t), s));\n");
    buf_str(out, c"        return t;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if s > get(KEY, t) {\n");
    buf_str(out, c"        set(RIGHT, t, remove(get(RIGHT, t), s));\n");
    buf_str(out, c"        return t;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let m = merge(get(LEFT, t), get(RIGHT, t));\n");
    buf_str(out, c"    set(LEFT, t, SPARE);\n");
    buf_str(out, c"    SPARE = t;\n");
    buf_str(out, c"    m\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The node of tree t's last block starting at or before p, or 0.\n");
    buf_str(out, c"unsafe fn find(t: u64, p: u64) -> u64 {\n");
    buf_str(out, c"    let mut at = t;\n");
    buf_str(out, c"    let mut best: u64 = 0;\n");
    buf_str(out, c"    while at != 0 {\n");
    buf_str(out, c"        if get(KEY, at) <= p {\n");
    buf_str(out, c"            best = at;\n");
    buf_str(out, c"            at = get(RIGHT, at);\n");
    buf_str(out, c"        } else {\n");
    buf_str(out, c"            at = get(LEFT, at);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    best\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The node of tree t's first block starting after p, or 0.\n");
    buf_str(out, c"unsafe fn find_after(t: u64, p: u64) -> u64 {\n");
    buf_str(out, c"    let mut at = t;\n");
    buf_str(out, c"    let mut best: u64 = 0;\n");
    buf_str(out, c"    while at != 0 {\n");
    buf_str(out, c"        if get(KEY, at) > p {\n");
    buf_str(out, c"            best = at;\n");
    buf_str(out, c"            at = get(LEFT, at);\n");
    buf_str(out, c"        } else {\n");
    buf_str(out, c"            at = get(RIGHT, at);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    best\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// Tree t without the blocks [s, e) overlaps: its root.\n");
    buf_str(out, c"unsafe fn forget_overlapping(t: u64, s: u64, e: u64) -> u64 {\n");
    buf_str(out, c"    let mut root = t;\n");
    buf_str(out, c"    loop {\n");
    buf_str(out, c"        let n = find(root, e - 1);\n");
    buf_str(out, c"        if n == 0 || get(END, n) <= s {\n");
    buf_str(out, c"            return root;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        root = remove(root, get(KEY, n));\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"unsafe fn record(p: *mut u8, size: u64) {\n");
    buf_str(out, c"    if p == 0 as *mut u8 {\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let s = p as u64;\n");
    buf_str(out, c"    let e = s + (if size == 0 { 1 } else { size });\n");
    buf_str(out, c"    lock();\n");
    buf_str(out, c"    // Blocks the new one overlaps are forgotten, live or freed (0.30.1): C\n");
    buf_str(out, c"    // freed them without a call the check saw (a block passed to C, which\n");
    buf_str(out, c"    // freed it), since the allocator returns no memory that is in use.\n");
    buf_str(out, c"    forget_freed(s, e);\n");
    buf_str(out, c"    LIVE = forget_overlapping(LIVE, s, e);\n");
    buf_str(out, c"    if s < HIT_E && HIT_S < e {\n");
    buf_str(out, c"        HIT_S = 0;\n");
    buf_str(out, c"        HIT_E = 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    LIVE = insert(LIVE, node(s, e));\n");
    buf_str(out, c"    unlock();\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// FREED without the blocks [s, e) overlaps (no longer held).\n");
    buf_str(out, c"unsafe fn forget_freed(s: u64, e: u64) {\n");
    buf_str(out, c"    loop {\n");
    buf_str(out, c"        let n = find(FREED_ROOT, e - 1);\n");
    buf_str(out, c"        if n == 0 || get(END, n) <= s {\n");
    buf_str(out, c"            return;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        HELD_BYTES -= get(END, n) - get(KEY, n);\n");
    buf_str(out, c"        FREED_ROOT = remove(FREED_ROOT, get(KEY, n));\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The oldest block held, given back to C (when it is still in FREED: the\n");
    buf_str(out, c"// one record forgot is not the check's to free).\n");
    buf_str(out, c"unsafe fn release_oldest() {\n");
    buf_str(out, c"    let s = get(RING, RING_OLD);\n");
    buf_str(out, c"    set(RING, RING_OLD, 0);\n");
    buf_str(out, c"    RING_OLD = (RING_OLD + 1) % FREED;\n");
    buf_str(out, c"    HELD -= 1;\n");
    buf_str(out, c"    let n = find(FREED_ROOT, s);\n");
    buf_str(out, c"    if s != 0 && n != 0 && get(KEY, n) == s {\n");
    buf_str(out, c"        HELD_BYTES -= get(END, n) - s;\n");
    buf_str(out, c"        FREED_ROOT = remove(FREED_ROOT, s);\n");
    buf_str(out, c"        free(s as *mut u8);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// Block p freed by the program: when it is live, held in FREED (not given\n");
    buf_str(out, c"// back to C yet) and its size returned; a block of FREED fails (freed\n");
    buf_str(out, c"// twice); any other (C's own, or null) returns 0, for C to free.\n");
    buf_str(out, c"unsafe fn hold(p: *mut u8, site: *const u8) -> u64 {\n");
    buf_str(out, c"    if p == 0 as *mut u8 {\n");
    buf_str(out, c"        return 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let s = p as u64;\n");
    buf_str(out, c"    lock();\n");
    buf_str(out, c"    let n = find(LIVE, s);\n");
    buf_str(out, c"    if n == 0 || get(KEY, n) != s {\n");
    buf_str(out, c"        let k = find(FREED_ROOT, s);\n");
    buf_str(out, c"        if k != 0 && get(KEY, k) == s {\n");
    buf_str(out, c"            fail(c\"(a block freed twice)\", s, 0, s, get(END, k), site);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        unlock();\n");
    buf_str(out, c"        return 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let e = get(END, n);\n");
    buf_str(out, c"    LIVE = remove(LIVE, s);\n");
    buf_str(out, c"    HIT_S = 0;\n");
    buf_str(out, c"    HIT_E = 0;\n");
    buf_str(out, c"    if RING == 0 as *mut u64 {\n");
    buf_str(out, c"        RING = calloc(FREED, 8) as *mut u64;\n");
    buf_str(out, c"        if RING == 0 as *mut u64 {\n");
    buf_str(out, c"            unlock();\n");
    buf_str(out,
        c"            dprintf(2, c\"--check-unsafe: out of memory for its tables\\n\");\n");
    buf_str(out, c"            exit(101);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if HELD == FREED {\n");
    buf_str(out, c"        release_oldest();\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    set(RING, (RING_OLD + HELD) % FREED, s);\n");
    buf_str(out, c"    HELD += 1;\n");
    buf_str(out, c"    HELD_BYTES += e - s;\n");
    buf_str(out, c"    FREED_ROOT = insert(FREED_ROOT, node(s, e));\n");
    buf_str(out, c"    while HELD_BYTES > QUARANTINE && HELD > 1 {\n");
    buf_str(out, c"        release_oldest();\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    unlock();\n");
    buf_str(out, c"    e - s\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The size of live block p, or 0.\n");
    buf_str(out, c"unsafe fn live_size(p: *mut u8) -> u64 {\n");
    buf_str(out, c"    let s = p as u64;\n");
    buf_str(out, c"    lock();\n");
    buf_str(out, c"    let n = find(LIVE, s);\n");
    buf_str(out, c"    let size = if n != 0 && get(KEY, n) == s { get(END, n) - s } else { 0 };\n");
    buf_str(out, c"    unlock();\n");
    buf_str(out, c"    size\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The bytes to allocate for a block of size bytes: its own (at least the\n");
    buf_str(out, c"// one a block of 0 is recorded with) and its red zone; 0 when that is more\n");
    buf_str(out, c"// than there is.\n");
    buf_str(out, c"unsafe fn room(size: u64) -> u64 {\n");
    buf_str(out, c"    if size > 18446744073709551615 - REDZONE - 1 {\n");
    buf_str(out, c"        return 0;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    (if size == 0 { 1 } else { size }) + REDZONE\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn malloc_(size: u64) -> *mut u8 {\n");
    buf_str(out, c"    if room(size) == 0 {\n");
    buf_str(out, c"        return 0 as *mut u8;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let p = malloc(room(size));\n");
    buf_str(out, c"    record(p, size);\n");
    buf_str(out, c"    p\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn calloc_(count: u64, size: u64) -> *mut u8 {\n");
    buf_str(out, c"    if size != 0 && count > (18446744073709551615 - REDZONE - 1) / size {\n");
    buf_str(out, c"        return 0 as *mut u8;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let p = calloc(1, room(count * size));\n");
    buf_str(out, c"    record(p, count * size);\n");
    buf_str(out, c"    p\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// (0.30.1) A live block moves: a new block, the bytes copied, the old one\n");
    buf_str(out, c"// held as free_ holds it (C's realloc would give it back at once). Any\n");
    buf_str(out, c"// other block is C's realloc's, and stays C's (not recorded).\n");
    buf_str(out, c"pub unsafe fn realloc_(old: *mut u8, size: u64) -> *mut u8 {\n");
    buf_str(out, c"    let have = if old == 0 as *mut u8 { 0 } else { live_size(old) };\n");
    buf_str(out, c"    if have == 0 {\n");
    buf_str(out, c"        // (a block of FREED fails here; C's own is not held)\n");
    buf_str(out, c"        hold(old, c\"realloc\");\n");
    buf_str(out, c"        return realloc(old, size);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if room(size) == 0 {\n");
    buf_str(out, c"        return 0 as *mut u8;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let p = malloc(room(size));\n");
    buf_str(out, c"    if p == 0 as *mut u8 {\n");
    buf_str(out, c"        return p;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    memcpy(p, old as *const u8, if have < size { have } else { size });\n");
    buf_str(out, c"    hold(old, c\"realloc\");\n");
    buf_str(out, c"    record(p, size);\n");
    buf_str(out, c"    p\n");
    buf_str(out, c"}\n");
    buf_str(out,
        c"pub unsafe fn posix_memalign_(out: *mut *mut u8, align: u64, size: u64) -> i32 {\n");
    buf_str(out, c"    if room(size) == 0 {\n");
    buf_str(out, c"        return 12;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let r = posix_memalign(out, align, room(size));\n");
    buf_str(out, c"    if r == 0 {\n");
    buf_str(out, c"        record(*out, size);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    r\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub unsafe fn free_(p: *mut u8) {\n");
    buf_str(out, c"    if hold(p, c\"free\") == 0 {\n");
    buf_str(out, c"        free(p);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// (0.30.1) An address computed from base (`&p[i]`, std's ptr::add): the\n");
    buf_str(out, c"// offset, index elements of size bytes, fits an isize (as Rust's add\n");
    buf_str(out, c"// requires; std's sub's index is the negative count); and when base is in\n");
    buf_str(out, c"// a live block (or one past its end), at is in it or one past its end. An\n");
    buf_str(out, c"// address is no access: at may be its end.\n");
    buf_str(out,
        c"pub unsafe fn check_addr(base: u64, at: u64, index: u64, size: u64, site: *const u8) {\n");
    buf_str(out, c"    let i = index as i64;\n");
    buf_str(out,
        c"    if size > 1 && (i > 9223372036854775807 / size as i64 || i < -9223372036854775807 / size as i64) {\n");
    buf_str(out,
        c"        dprintf(2, c\"unsafe address out of bounds: an offset of %lld elements of %llu bytes overflows\\n --> %s\\n\", i, size, site);\n");
    buf_str(out, c"        exit(101);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    lock();\n");
    buf_str(out, c"    let n = find(LIVE, base);\n");
    buf_str(out, c"    if n != 0 && base <= get(END, n) {\n");
    buf_str(out, c"        let s = get(KEY, n);\n");
    buf_str(out, c"        let e = get(END, n);\n");
    buf_str(out, c"        // (a base one past a block's end that is the next block's start\n");
    buf_str(out, c"        // too: either block's)\n");
    buf_str(out, c"        let b = if base == s { find(LIVE, s - 1) } else { 0 };\n");
    buf_str(out,
        c"        let before = b != 0 && get(END, b) == base && at >= get(KEY, b) && at <= base;\n");
    buf_str(out, c"        if (at < s || at > e) && !before {\n");
    buf_str(out, c"            unlock();\n");
    buf_str(out,
        c"            dprintf(2, c\"unsafe address out of bounds: offset %lld of a block of %llu bytes (an address from offset %lld)\\n --> %s\\n\", at as i64 - s as i64, e - s, base as i64 - s as i64, site);\n");
    buf_str(out, c"            exit(101);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    unlock();\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// The access of `size` bytes at p.\n");
    buf_str(out, c"pub unsafe fn check(p: u64, size: u64, site: *const u8) {\n");
    buf_str(out, c"    if size == 0 {\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    if get_check_alloc_mode() && pcx.std_module >= 0 {
        // (0.16, with --check-alloc: the checking Gpa's blocks, known
        // exactly, freed ones included)
        buf_str(out, c"    if std::check_alloc_access(p, size, site) {\n");
        buf_str(out, c"        return;\n");
        buf_str(out, c"    }\n");
    }
    buf_str(out, c"    lock();\n");
    buf_str(out, c"    if p >= HIT_S && p < HIT_E && size <= HIT_E - p {\n");
    buf_str(out, c"        unlock();\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let n = find(LIVE, p);\n");
    buf_str(out, c"    if n != 0 && p < get(END, n) {\n");
    buf_str(out, c"        if size > get(END, n) - p {\n");
    buf_str(out,
        c"            fail(c\"out of bounds\", p, size, get(KEY, n), get(END, n), site);\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        HIT_S = get(KEY, n);\n");
    buf_str(out, c"        HIT_E = get(END, n);\n");
    buf_str(out, c"        unlock();\n");
    buf_str(out, c"        return;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if n != 0 && p == get(END, n) {\n");
    buf_str(out,
        c"        fail(c\"out of bounds (just past the end)\", p, size, get(KEY, n), get(END, n), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    if n != 0 && p < get(END, n) + REDZONE {\n");
    buf_str(out,
        c"        fail(c\"out of bounds (past the end)\", p, size, get(KEY, n), get(END, n), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let m = find_after(LIVE, p);\n");
    buf_str(out, c"    if m != 0 && get(KEY, m) - p < size {\n");
    buf_str(out,
        c"        fail(c\"out of bounds (into the next block)\", p, size, get(KEY, m), get(END, m), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    let k = find(FREED_ROOT, p);\n");
    buf_str(out, c"    if k != 0 && p < get(END, k) {\n");
    buf_str(out, c"        fail(c\"after free\", p, size, get(KEY, k), get(END, k), site);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    unlock();\n");
    buf_str(out, c"}\n");
}

// The runtime's check function, or -1.
pub fn check_function(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.unsafecheck_check_fn == -2 {
        pcx.unsafecheck_check_fn = check_fn(c"check", pcx);
    }
    pcx.unsafecheck_check_fn
}

// The runtime function `name` (an item of __check), or -1.
pub fn check_fn(name: *const u8, pcx: &mut Ctx<Comp>) -> i64 {
    let out = crate::base::buf_new();
    buf_str(out, c"__check::");
    buf_str(out, name);
    crate::base::buf_byte(out, 0);
    ({
        let at_ix = intern_c(crate::base::buf_ptr(out), pcx) as usize;
        pcx.sym_fn[at_ix]
    }) - 1
}

// The wrapper a call of C function f, from a function of module `from`,
// goes to instead (malloc, calloc, realloc, posix_memalign and free), or f.
// (The runtimes' own calls are not redirected.) (0.30.1) A C function is
// the symbol it links to (its FNS name, its #[link_name] when it has one):
// std's Gpa calls `#[link_name = "malloc"] fn gpa_c_malloc`, which is
// malloc, and an extern named malloc that links elsewhere is not.
pub fn redirect_alloc(f: i64, from: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !pcx.check_unsafe || f < 0 || !pcx.fns[f as usize].is_extern || from == pcx.check_module
        || from == pcx.profile_module {
        return f;
    }
    let name = sym_name(crate::front::effects::builtin::c_symbol(f, pcx), pcx);
    let names: [*const u8; 5] = [c"malloc", c"calloc", c"realloc", c"posix_memalign", c"free"];
    let wrappers: [*const u8; 5] = [c"malloc_", c"calloc_", c"realloc_", c"posix_memalign_",
        c"free_"];
    for i in 0..5 {
        if crate::base::streq(name, names[i as usize]) {
            let w = check_fn(wrappers[i as usize], pcx);
            return if w >= 0 { w } else { f };
        }
    }
    f
}

// ---- Sites ----

// The index of the last line starting at or before pos.
fn line_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.unsafecheck_lines.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if (pcx.unsafecheck_lines[mid as usize]) <= pos { lo = mid + 1; }
        else { hi = mid; }
    }
    lo - 1
}

// A C string `path: line L, column C` for source position pos, as a
// string literal's id.
pub fn site_string(pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let count = pcx.files.len() as i64;
    if pcx.unsafecheck_lines.len() as i64 == 0 {
        pcx.unsafecheck_lines.push(0);
        for i in 0..pcx.files[(count - 1) as usize].end {
            if crate::base::get_src()[i as usize] == b'\n' {
                pcx.unsafecheck_lines.push(i + 1);
            }
        }
    }
    let mut file: i64 = 0;
    while file + 1 < count && pos >= pcx.files[(file + 1) as usize].start {
        file += 1;
    }
    let line = line_of(pos, pcx);
    let out = crate::base::buf_new();
    buf_str(out, crate::base::out_path(file, pcx));
    buf_str(out, c": line ");
    crate::base::buf_int(out, line - line_of(pcx.files[file as usize].start, pcx) + 1);
    buf_str(out, c", column ");
    crate::base::buf_int(out, pos - (pcx.unsafecheck_lines[line as usize]) + 1);
    crate::front::lexer::add_string(
        &crate::base::buf_copy(out), pcx)
}
