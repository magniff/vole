    // static mut the tasks read; Rust has no safe access to a static mut
    // SAFETY: written only by ipo::init_syms (under MALLOC_SYM == 0), sole
    // caller prepare_tasks on the main thread before pool_start; tasks only
    // read it
    unsafe {
        CALLOC_SYM = v;
    }
}

// (0.28.0) FREE_SYM's accessors: every use of it is one of them.
fn get_free_sym() -> i64 {
    // UNSAFE: the free symbol heap_to_stack compares with, a process-wide
